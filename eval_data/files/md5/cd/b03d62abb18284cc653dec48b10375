r**0.5) + 1):\n            if number % i == 0:\n                return False\n        return True\n\n    def calculate_intersection_interval(interval1: tuple[int, int], interval2: tuple[int, int]) -> tuple[int, int] | None:\n        \"\"\"Calculates the intersection of two intervals.\n        Returns (start_i, end_i) or None if no intersection.\"\"\"\n        start1, end1 = interval1\n        start2, end2 = interval2\n\n        intersection_start = max(start1, start2)\n        intersection_end = min(end1, end2)\n\n        if intersection_start > intersection_end:\n            return None\n        else:\n            return (intersection_start, intersection_end)\n\n    def calculate_interval_length(interval: tuple[int, int]) -> int:\n        \"\"\"Calculates the length of a given interval.\n        Length is defined as (end - start + 1).\"\"\"\n        start, end = interval\n        return end - start + 1\n\n    intersection_interval = calculate_intersection_interval(interval1, interval2)\n\n    if intersection_interval is None:\n        return \"NO\"\n\n    length = calculate_interval_length(intersection_interval)\n\n    if is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\"", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[-1, 1], [0, 4]]], "plus_fail_tests": [[[10, 20], [15, 25]]]}, {"task_id": "HumanEval/127", "solution": "class Interval:\n    \"\"\"Represents a closed integer interval [start, end].\"\"\"\n    def __init__(self, start: int, end: int):\n        self.start = start\n        self.end = end\n\n    def calculate_length(self) -> int:\n        \"\"\"Calculates the length of the interval.\"\"\"\n        return self.end - self.start + 1\n\n    def get_intersection(self, other: 'Interval') -> 'Interval' | None:\n        \"\"\"Determines the intersection with another interval. Returns None if no intersection.\"\"\"\n        intersection_start = max(self.start, other.start)\n        intersection_end = min(self.end, other.end)\n\n        if intersection_start > intersection_end:\n            return None\n        else:\n            return Interval(intersection_start, intersection_end)\ndef is_prime(number: int) -> bool:\n    \"\"\"Checks if a number is prime.\"\"\"\n    if number < 2:\n        return False\n    # Only need to check divisors up to the square root of the number.\n    i = 2\n    while i * i <= number:\n        if number % i == 0:\n            return False\n        i += 1\n    return True\ndef intersection(interval1: tuple[int, int], interval2: tuple[int, int]) -> str:\n    \"\"\"Determines if the length of the intersection of two intervals is a prime number.\"\"\"\n    # Create Interval objects from the input tuples.\n    int1_obj = Interval(interval1[0], interval1[1])\n    int2_obj = Interval(interval2[0], interval2[1])\n\n    # Get the intersection interval.\n    intersected_interval = int1_obj.get_intersection(int2_obj)\n\n    # If there is no intersection, return \"NO\".\n    if intersected_interval is None:\n        return \"NO\"\n\n    # Calculate the length of the intersection.\n    length = intersected_interval.calculate_length()\n\n    # Check if the length is a prime number.\n    if is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\"", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/128": [{"task_id": "HumanEval/128", "solution": "class Integer:\n    \"\"\"Represents an integer, providing methods to get its magnitude and sign.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def getMagnitude(self) -> int:\n        \"\"\"Returns the absolute value (magnitude) of the integer.\"\"\"\n        return abs(self._value)\n\n    def getSign(self) -> int:\n        \"\"\"Returns the sign of the integer (1 for positive, -1 for negative, 0 for zero).\"\"\"\n        if self._value > 0:\n            return 1\n        elif self._value < 0:\n            return -1\n        else:\n            return 0\nclass IntegerArray:\n    \"\"\"Manages a collection of Integer objects to calculate their sign product and magnitude sum.\"\"\"\n    def __init__(self, arr: list[int]):\n        self._integers: list[Integer] = [Integer(num) for num in arr]\n\n    def calculateSignProduct(self) -> int:\n        \"\"\"Calculates and returns the product of signs of all integers in the array.\"\"\"\n        product = 1\n        for integer_obj in self._integers:\n            # If any sign is 0, the entire product becomes 0. We can optimize by returning early.\n            sign = integer_obj.getSign()\n            if sign == 0:\n                return 0\n            product *= sign\n        return product\n\n    def calculateMagnitudeSum(self) -> int:\n        \"\"\"Calculates and returns the sum of magnitudes of all integers in the array.\"\"\"\n        total_magnitude = 0\n        for integer_obj in self._integers:\n            total_magnitude += integer_obj.getMagnitude()\n        return total_magnitude\n\n    def calculateResult(self) -> int:\n        \"\"\"Orchestrates the calculation of the final result by combining sign product and magnitude sum.\"\"\"\n        sign_product = self.calculateSignProduct()\n        magnitude_sum = self.calculateMagnitudeSum()\n        return sign_product * magnitude_sum\ndef prod_signs(arr: list[int]) -> int | None:\n    \"\"\"\n    You are given an array arr of integers and you need to return\n    sum of magnitudes of integers multiplied by product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    Note: return None for empty arr.\n\n    Example:\n    >>> prod_signs([1, 2, 2, -4]) == -9\n    >>> prod_signs([0, 1]) == 0\n    >>> prod_signs([]) == None\n    \"\"\"\n    if not arr:\n        return None\n\n    integer_array_manager = IntegerArray(arr)\n    return integer_array_manager.calculateResult()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests"