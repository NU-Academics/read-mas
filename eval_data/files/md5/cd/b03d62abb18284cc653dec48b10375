not is_vowel(char)\ndef get_closest_vowel(word: str) -> str:\n    \"\"\"Finds the closest qualifying vowel from the right side of a word.\"\"\"\n    # Iterate from the second-to-last character down to the second character.\n    for i in range(len(word) - 2, 0, -1):\n        current_char = word[i]\n        if is_vowel(current_char):\n            # Check if the character is preceded and followed by a consonant.\n            if is_consonant(word[i-1]) and is_consonant(word[i+1]):\n                return current_char\n    return \"\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/120": [{"task_id": "HumanEval/120", "solution": "```python", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/120", "solution": "def maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list\n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    if k == 0:\n        return []\n\n    # Sort the input array in descending order to find the largest elements.\n    arr.sort(reverse=True)\n\n    # Select the first k elements, which are the k largest.\n    k_largest = arr[:k]\n\n    # Sort the selected k elements in ascending order as per requirement.\n    k_largest.sort()\n\n    return k_largest", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/121": [{"task_id": "HumanEval/121", "solution": "def solution(lst: list[int]) -> int:\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\"\"\"\n    total_sum = 0\n    for i in range(len(lst)):\n        if i % 2 == 0:  # Check if the position (index) is even.\n            if lst[i] % 2 != 0:  # Check if the element at this even position is odd.\n                total_sum += lst[i]\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/121", "solution": "def solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\n\n\n    Examples\n    solution([5, 8, 7, 1]) ==> 12\n    solution([3, 3, 3, 3, 3]) ==> 9\n    solution([30, 13, 24, 321]) ==>0\n    \"\"\"\n    calculated_sum = 0\n\n    # Iterate through the list using both index and element.\n    for i, element in enumerate(lst):\n        # Add element to sum if it's odd and at an even 0-indexed position.\n        if element % 2 != 0 and i % 2 == 0:\n            calculated_sum += element\n\n    return calculated_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/122": [{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    \"\"\"\n    current_sum = 0\n    for i in range(k):\n        element = arr[i]\n        if abs(element) < 100:\n            current_sum += element\n    return current_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Calculates the sum of elements with at most two digits from the first k elements of arr.\n    This function processes the specified initial portion of the array, filters based on digit count, and sums eligible numbers.\n    \"\"\"\n    # Nested helper function to check if a number has at most two digits\n    def _is_two_digit(number: int) -> bool:\n        \"\"\"Checks if the absolute value of a number is less than 100.\"\"\"\n        return -99 <= number <= 99\n\n    total_sum = 0\n    # Iterate through the first k elements of the array\n    for i in range(k):\n        element = arr[i]\n        # If the e