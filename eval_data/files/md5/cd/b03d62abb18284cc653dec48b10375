n        return s[num_digits - effective_shift:] + s[:num_digits - effective_shift]\n\n    string_x = _get_digits_as_string(x)\n    num_digits = len(string_x)\n\n    if shift > num_digits:\n        return _reverse_string(string_x)\n    else:\n        return _circular_right_shift_string(string_x, shift)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/65", "solution": "def _get_digits_as_string(x: int) -> str:\n    \"\"\"Converts an integer to its string representation, handling negative inputs by taking the absolute value.\"\"\"\n    return str(abs(x))\ndef _reverse_string(s: str) -> str:\n    \"\"\"Reverses the order of characters in the given string.\"\"\"\n    return s[::-1]\ndef _perform_circular_shift_logic(digits_str: str, shift: int) -> str:\n    \"\"\"Executes a circular right shift on a string of digits by the specified amount.\"\"\"\n    n = len(digits_str)\n    effective_shift = shift % n\n    return digits_str[-effective_shift:] + digits_str[:-effective_shift]\ndef circular_shift(x: int, shift: int) -> str:\n    \"\"\"Circular shift the digits of the integer x, shifting digits right by `shift` positions.\n    If `shift` is greater than the number of digits, the digits are reversed.\n    \"\"\"\n    digits_str = _get_digits_as_string(x)\n    digit_count = len(digits_str)\n\n    if shift > digit_count:\n        return _reverse_string(digits_str)\n    else:\n        return _perform_circular_shift_logic(digits_str, shift)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/66": [{"task_id": "HumanEval/66", "solution": "def digitSum(s: str) -> int:\n    \"\"\"Calculates the sum of ASCII codes of uppercase characters in the input string.\n    Returns the total sum, or 0 if the string is empty.\"\"\"\n    if not s:\n        return 0\n\n    total_sum = 0\n    for char_val in s:\n        if char_val.isupper():\n            total_sum += ord(char_val)\n\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"\n    Calculates the sum of ASCII codes for only the uppercase characters in the input string.\n    Iterates through the string, summing ASCII values of uppercase letters.\n    \"\"\"\n    total_sum = 0\n    for char_val in s:\n        if 'A' <= char_val <= 'Z':\n            total_sum += ord(char_val)\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/67": [{"task_id": "HumanEval/67", "solution": "class InputStringParser:\n    \"\"\"\n    Parses an input string to extract counts of apples and oranges.\n    Assumes the string format \"X apples and Y oranges\".\n    \"\"\"\n    def __init__(self, raw_string: str):\n        self.raw_string = raw_string\n\n    def parse_apples(self) -> int:\n        \"\"\"Extracts the number of apples from the raw string.\"\"\"\n        # Splits the string by \"apples\", takes the part before it,\n        # strips whitespace, splits by space, and converts the last part to an integer.\n        return int(self.raw_string.split(\"apples\")[0].strip().split(\" \")[-1])\n\n    def parse_oranges(self) -> int:\n        \"\"\"Extracts the number of oranges from the raw string.\"\"\"\n        # Splits the string by \"oranges\", takes the part before it,\n        # splits by \"and\", takes the part after \"and\", strips whitespace,\n        # splits by space, and converts the last part to an integer.\n        return int(self.raw_string.split(\"oranges\")[0].split(\"and\")[-1].strip().split(\" \")[-1])\nclass FruitBasket:\n    \"\"\"\n    Holds the counts of different fruits and calculates the number of mangoes.\n    It ensures all counts are stored for calculation.\n    \"\"\"\n    def __init__(self, total_fruits: int, apples_count: int, oranges_count: int):\n        self.total_fruits = total_fruits\n        self.apples_count = apples_count\n        self.oranges_count = oranges_count\n        self.mangoes_count = 0 # Initialize mangoes count\n\n    def calculate_mangoes(self) -> int:\n        \"\"\"Calculates the number of mangoes based on total fruits, apples, and oranges.\"\"\"\n        self.mangoes_count = self.total_fruits - self.apples_count - self.oranges_count\n        return self.mangoes_count\n\n    def get_mangoes_count(self) -> int:\n        \"\"\"Returns the calculated number of mangoes.\"\"\"\n        return self.mangoes_count\ndef fruit_distribution(s, n):\n    \"\"\"\n    Calculates the number of mango fruits in a basket given a string of apple and orange counts\n    and the total number of fruits.\n    \"\"\"\n    parser = InputStringParser(s)\n    apples = parser.parse_apples()\n    oranges = parser.parse_oranges()\n\n    basket = FruitBasket(n, apples, oranges)\n    mangoes = basket.calculate_mangoes()\n\n    return mangoes", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/67", "solution": "def _extract_fruit_count(text: str, fruit_name: str) -> int:\n    \"\"\"\n    Extracts the numerical count for a specific fruit from the input string.\n    It parses the string based on the fruit's name and retrieves the preceding number.\n    \"\"\"\n    # Split the text by the fruit_name to isolate the part containing its count.\n    # For \"5 apples and 6 oranges\" and \"apples\", this yields [\"5\", \" and 6 oranges\"].\n    # For \"5 apples and 6 oranges\" and \"oranges\", this yields [\"5 apples and 6\", \"\"].\n    parts = text.split(f\" {fruit_name}\")\n\n    # The count is the last number in the first part of the split string.\n    # For apples, `parts[0]` is \"5\". For oranges, `parts[0]` is \"5 apples and 6\".\n    pre_fruit_part = parts[0]\n    num_str = pre_fruit_part.strip().split(' ')[-1]\n\n    return int(num_str)\ndef fruit_distribution(s: str, n: int) -> int:\n    \"\"\"\n    In this task, you will be given a string that represents a number of apples and oranges\n    that are distributed in a basket of fruit this basket contains\n    apples, oranges, and mango fruits. Given the string that represents the total number of\n    the oranges and apples and an integer that represent the total number of the fruits\n    in the basket return the number of the mango fruits in the basket.\n    for examble:\n    fruit_distribution(\"5 apples and 6 oranges\", 19) ->19 - 5 - 6 = 8\n    fruit_distribution(\"0 apples and 1 oranges\",3) -> 3 - 0 - 1 = 2\n    fruit_distribution(\"2 apples and 3 oranges\", 100) -> 100 - 2 - 3 = 95\n    fruit_distribution(\"100 apples and 1 oranges\",120) -> 120 - 100 - 1 = 19\n    \"\"\"\n    # Extract the number of apples from the input string.\n    apples_count = _extract_fruit_count(s, \"apples\")\n\n    # Extract the number of oranges from the input string.\n    oranges_count = _extract_fruit_count(s, \"oranges\")\n\n    # Calculate the number of mango fruits.\n    # The final mango count is ensured to be non-negative.\n    mango_count = n - apples_count - oranges_count\n\n    # Return the calculated number of mango fruits.\n    return max(0, mango_count)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/69": [{"task_id": "HumanEval/69", "solution": "def _calculate_frequencies(lst: list) -> dict:\n    # Calculates the frequency of each integer in the given list.\n    frequencies = {}\n    for num in lst:\n        frequencies[num] = frequencies.get(num, 0) + 1\n    return frequencies\ndef _find_candidates(frequencies: dict) -> list:\n    # Identifies integers where their frequency is greater than or equal to their value.\n    candidates = []\n    for num, freq in frequencies.items():\n        if num > 0 and freq >= num:\n            candidates.append(num)\n    return candidates\ndef search(lst: list) -> int:\n    # Orchestrates the search for the greatest integer satisfying the frequency-value criteria.\n    _validate_input(lst)\n    frequencies = _calculate_frequencies(lst)\n    candidate_integers = _find_candidates(frequencies)\n\n    if not candidate_integers:\n        return -1\n    else:\n        return max(candidate_integers)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[5, 5, 5, 5, 1]]], "plus_fail_tests": [[[3, 2, 1, 1, 1, 1, 1]]]}, {"task_id": "HumanEval/69", "solution": "def search(lst):\n    '''\n    Orchestrates the frequency-value search process.\n    Delegates tasks to helper functions for validation, frequency calculation, identification, and final result determination.\n    '''\n    def _validate_input(lst_to_validate):\n        '''\n        Validates the input list: ensures it's non-empty and contains only positive integers.\n        Raises ValueError if validation fails according to design specifications.\n        '''\n        if not lst_to_validate:\n            raise ValueError(\"Input list cannot be empty.\")\n        if any(x <= 0 for x in lst_to_validate):\n            raise ValueError(\"All integers in the list must be positive.\")\n\n    def _calculate_frequencies(lst_to_count):\n        '''\n        Calculates the frequency of each integer in the list.\n        Returns a dictionary mapping each unique integer to its count.\n        '''\n        frequencies = {}\n        for x in lst_to_count:\n            frequencies[x] = frequencies.get(x, 0) + 1\n        return frequencies\n\n    def _identify_qualifying_integers(frequencies_map):\n        '''\n        Identifies integers 'x' where 'x > 0' and 'frequency(x) >= x'.\n        Returns a list of all such qualifying integers.\n        '''\n        qualifying_integers = []\n        for x, freq in frequencies_map.items():\n            if x > 0 and freq >= x:\n                qualifying_integers.append(x)\n        return qualifying_integers\n\n    def _find_max_qualifying_integer(qualifying_integers_list):\n        '''\n        Finds the maximum integer from the list of qualifying integers.\n        Returns -1 if the list is empty, otherwise returns the maximum value.\n        '''\n        if not qualifying_integers_list:\n            return -1\n        return max(qualifying_integers_list)\n\n    _validate_input(lst)\n    frequencies_map = _calculate_frequencies(lst)\n    qualifying_integers_list = _identify_qualifying_integers(frequencies_map)\n    result = _find_max_qualifying_integer(qualifying_integers_list)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[5, 5, 5, 5, 1]]], "plus_fail_tests": [[[3, 2, 1, 1, 1, 1, 1]]]}], "HumanEval/68": [{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Identifies and returns the node with the smallest even value from an array.\n    Prioritizes the node with the smallest index if even values are tied.\n    \"\"\"\n    if not arr:\n        return []\n\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for current_index, node_value in enumerate(arr):\n        if node_value % 2 == 0:  # Check if the node_value is even\n            if node_value < smallest_even_value:\n                # Found a new smallest even value\n                smallest_even_value = node_value\n                smallest_even_index = current_index\n            elif node_value == smallest_even_value and current_index < smallest_even_index:\n                # Same smallest even value, but current_index is smaller (tie-breaking)\n                smallest_even_index = current_index\n\n    # If smallest_even_index is still -1, no even values were found in the array\n    if smallest_even_index == -1:\n        return []\n    else:\n        return [smallest_even_value, smallest_even_index]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/68", "solution": "def pluck(arr: list[int]) -> list[int] | list[int, int]:\n    \"\"\"\n    Fin