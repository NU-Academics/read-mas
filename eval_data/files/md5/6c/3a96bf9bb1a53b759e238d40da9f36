{"task_id": "Mbpp/428", "solution": "from typing import List\nimport time\nfrom abc import ABC, abstractmethod\n\nclass SortError(Exception):\n    \"\"\"Custom exception for sorting-related errors.\"\"\"\n    pass\n\nclass SortedResult:\n    \"\"\"Data transfer object for sorting results.\"\"\"\n    def __init__(self, original: List[int], sorted: List[int], duration_ms: float) -> None:\n        self.original = original\n        self.sorted = sorted\n        self.duration_ms = duration_ms\n\n    def to_dict(self) -> dict:\n        return {\"original\": self.original, \"sorted\": self.sorted, \"duration_ms\": self.duration_ms}\n\nclass Sorter(ABC):\n    \"\"\"Abstract base class for sorting algorithms.\"\"\"\n    @abstractmethod\n    def sort(self, values: List[int]) -> List[int]:\n        ...\n\nclass ShellSorter(Sorter):\n    \"\"\"Implements the Shell Sort algorithm.\"\"\"\n    def sort(self, values: List[int]) -> List[int]:\n        arr = list(values)\n        n = len(arr)\n        gap = 1\n        while gap < n // 3:\n            gap = 3 * gap + 1\n        while gap > 0:\n            for i in range(gap, n):\n                temp = arr[i]\n                j = i\n                while j >= gap and arr[j-gap] > temp:\n                    arr[j] = arr[j-gap]\n                    j -= gap\n                arr[j] = temp\n            gap //= 3\n        return arr\n\nclass SortService:\n    \"\"\"Orchestrates sorting operations and measures performance.\"\"\"\n    def __init__(self, sorter: Sorter) -> None:\n        self.sorter = sorter\n\n    def sort(self, values: List[int]) -> SortedResult:\n        start = time.perf_counter()\n        sorted_list = self.sorter.sort(values)\n        duration_ms = (time.perf_counter() - start) * 1000.0\n        result = SortedResult(original=list(values), sorted=sorted_list, duration_ms=duration_ms)\n        return result\n\ndef shell_sort(values: List[int]) -> List[int]:\n    \"\"\"Sorts a list of integers using the Shell Sort algorithm.\n    It assumes the input is a valid list of integers.\n    \"\"\"\n    sorter = ShellSorter()\n    service = SortService(sorter)\n    result = service.sort(values)\n    return result.sorted"}
