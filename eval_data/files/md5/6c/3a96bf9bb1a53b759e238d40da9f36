{"task_id": "Mbpp/554", "solution": "def Split(input_list):\n    \"\"\"\n    Filters a list of integers, returning only the odd ones while preserving order.\n    Assumes input_list contains only integers.\n    \"\"\"\n    odd_numbers = [num for num in input_list if num % 2 != 0]\n    return odd_numbers"}
{"task_id": "Mbpp/555", "solution": "def difference(n: int) -> int:\n    \"\"\"\n    Calculates the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers using closed-form formulas.\n    \"\"\"\n    sum_of_n = n * (n + 1) // 2\n    sum_of_cubes_n = sum_of_n * sum_of_n\n    return sum_of_cubes_n - sum_of_n"}
{"task_id": "Mbpp/476", "solution": "def big_sum(arr):\n    \"\"\"\n    Finds the sum of the largest and smallest value in a given array.\n    Assumes the input array is non-empty and contains numeric values.\n    \"\"\"\n    smallest = min(arr)\n    largest = max(arr)\n    return smallest + largest"}
{"task_id": "Mbpp/479", "solution": "def first_Digit(num):\n    \"\"\"\n    Finds the first (most significant) digit of a given number.\n    Handles positive, negative, and zero inputs.\n    \"\"\"\n    num = abs(num) # Use absolute value as per design context.\n\n    if num == 0:\n        return 0\n\n    while num >= 10:\n        num //= 10\n        \n    return num"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(numbers, n):\n    \"\"\"\n    Counts the number of unordered pairs in the input list whose XOR value is odd.\n    A pair's XOR is odd if one number is even and the other is odd.\n    \"\"\"\n    evens = 0\n    odds = 0\n    for x in numbers:\n        if x & 1:  # Check if the number is odd\n            odds += 1\n        else:  # The number is even\n            evens += 1\n    return evens * odds"}
