{"task_id": "Mbpp/410", "solution": "from typing import Any, Sequence, List, Optional, Iterable, Dict\nfrom numbers import Number\nfrom decimal import Decimal\n\nclass InvalidInputError(Exception):\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(message)\n\n    def __str__(self) -> str:\n        return self.message\n\nclass NoNumericValueError(Exception):\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(message)\n\n    def __str__(self) -> str:\n        return self.message\n\nclass ResultDTO:\n    def __init__(self, value: Any, original_items: Sequence[Any]):\n        self.value = value\n        self.original_items = original_items\n\n    def to_dict(self) -> Dict[str, Any]:\n        return {\"value\": self.value, \"original_items\": list(self.original_items)}\n\nclass TypeComparator:\n    def is_numeric(self, value: Any) -> bool:\n        if isinstance(value, (int, float, Decimal)):\n            return True\n        if isinstance(value, str):\n            try:\n                int(value)\n                return True\n            except ValueError:\n                try:\n                    float(value)\n                    return True\n                except ValueError:\n                    return False\n        return False\n\n    def to_numeric(self, value: Any) -> Optional[Number]:\n        if isinstance(value, int):\n            return value\n        if isinstance(value, float):\n            return value\n        if isinstance(value, Decimal):\n            return float(value)\n        if isinstance(value, str):\n            try:\n                i = int(value)\n                return i\n            except ValueError:\n                try:\n                    return float(value)\n                except ValueError:\n                    return None\n        return None\n\nclass InputNormalizer:\n    def normalize(self, items: Any) -> List[Any]:\n        if items is None:\n            raise InvalidInputError(\"Input cannot be None.\")\n        if isinstance(items, str):\n            return [items]\n        try:\n            if isinstance(items, Iterable):\n                return list(items)\n        except TypeError:\n            pass\n        return [items]\n\nclass MinFinder:\n    def __init__(self):\n        self._type_comparator = TypeComparator()\n        self._normalizer = InputNormalizer()\n\n    def find_min(self, items: Sequence[Any]) -> ResultDTO:\n        \"\"\"Core algorithm to compute the minimum numeric value from items.\"\"\"\n        normalized = self._normalizer.normalize(items)\n        numeric_vals: List[Number] = []\n        for v in normalized:\n            n = self._type_comparator.to_numeric(v)\n            if n is not None:\n                numeric_vals.append(n)\n\n        if not numeric_vals:\n            raise NoNumericValueError(\"No numeric values found in input.\")\n\n        min_value = min(numeric_vals)\n        target_type = self._choose_return_type(numeric_vals)\n\n        if target_type == int:\n            min_value = int(min_value)\n        else:\n            min_value = float(min_value)\n\n        return ResultDTO(value=min_value, original_items=normalized)\n\n    def _choose_return_type(self, values: List[Number]) -> type:\n        \"\"\"Decide whether to return int or float to preserve integer-ness when possible.\"\"\"\n        for val in values:\n            if isinstance(val, float):\n                return float\n        return int\n\nDEFAULT_ERROR_MSG = \"Failed to compute minimum value.\"\n\ndef min_val(items: Sequence[Any]) -> Any:\n    \"\"\"Finds the minimum numeric value in a given heterogeneous list.\"\"\"\n    try:\n        finder = MinFinder()\n        result = finder.find_min(items)\n        return result.value\n    except (InvalidInputError, NoNumericValueError):\n        raise\n    except Exception as exc:\n        raise InvalidInputError(f\"{DEFAULT_ERROR_MSG}: {exc}\")"}
{"task_id": "Mbpp/414", "solution": "def overlapping(seq1, seq2):\n    \"\"\"\n    Checks if any value in seq1 exists in seq2.\n    It attempts a set-based comparison for performance, falling back to nested loops if elements are unhashable.\n    \"\"\"\n    list1 = list(seq1)\n    list2 = list(seq2)\n\n    # Optimize by converting the shorter list to a set for faster lookups\n    # or iterating over the shorter one in the fallback scenario.\n    if len(list1) > len(list2):\n        list1, list2 = list2, list1\n\n    try:\n        # Attempt the efficient set-based approach\n        set1 = set(list1)\n        for item in list2:\n            if item in set1:\n                return True\n        return False\n    except TypeError:\n        # Fallback to nested loops if elements are unhashable\n        for item1 in list1:\n            for item2 in list2:\n                if item1 == item2:\n                    return True\n        return False"}
{"task_id": "Mbpp/415", "solution": "import math\n\ndef max_Product(nums):\n    # Finds the two largest and two smallest numbers in a single pass.\n    max1 = max2 = float('-inf')\n    min1 = min2 = float('inf')\n\n    for x in nums:\n        # Update the two largest numbers\n        if x > max1:\n            max2 = max1\n            max1 = x\n        elif x > max2:\n            max2 = x\n\n        # Update the two smallest numbers\n        if x < min1:\n            min2 = min1\n            min1 = x\n        elif x < min2:\n            min2 = x\n\n    # The highest product can come from either the two largest positives\n    # or the two smallest (most negative) numbers.\n    product_of_largest_pair = max1 * max2\n    product_of_smallest_pair = min1 * min2\n\n    if product_of_largest_pair >= product_of_smallest_pair:\n        return tuple(sorted((max1, max2)))\n    else:\n        return tuple(sorted((min1, min2)))"}
{"task_id": "Mbpp/418", "solution": "def Find_Max(input_list):\n    \"\"\"\n    Finds the element in a list that has the maximum length.\n    Returns the first such element encountered in case of a tie.\n    \"\"\"\n    if not input_list:\n        return None  # Or raise an error, but the prompt implies no error checks.\n\n    max_elem = None\n    max_len = -1\n\n    for element in input_list:\n        current_len = len(element)\n        if max_elem is None or current_len > max_len:\n            max_elem = element\n            max_len = current_len\n\n    return max_elem"}
{"task_id": "Mbpp/420", "solution": "def cube_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of cubes of the first n even natural numbers using a closed-form formula.\n    The formula is 8 * (n * (n + 1) / 2)^2.\n    \"\"\"\n    # The sum of the first n cubes (1^3 + 2^3 + ... + n^3) is (n * (n + 1) / 2)^2.\n    # The cubes of the first n even numbers are (2*1)^3, (2*2)^3, ..., (2*n)^3.\n    # This simplifies to 8 * (1^3 + 2^3 + ... + n^3).\n    sum_of_first_n_integers = n * (n + 1) // 2\n    return 8 * (sum_of_first_n_integers * sum_of_first_n_integers)"}
{"task_id": "Mbpp/419", "solution": "def round_and_sum(numbers: list[float]) -> int:\n    \"\"\"\n    Rounds each number in the list, sums them, and multiplies the sum by the list's length.\n    Returns the integer result, adhering to Python's built-in rounding semantics.\n    \"\"\"\n    rounded_numbers_sum = sum(int(round(num)) for num in numbers)\n    result = rounded_numbers_sum * len(numbers)\n    return result"}
