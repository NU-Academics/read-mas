{"task_id": "Mbpp/11", "solution": "def remove_Occ(s: str, ch: str) -> str:\n    \"\"\"Removes the first and last occurrence of a given character from the string.\n    If the character appears once, it removes that single occurrence.\n    \"\"\"\n    first_index = -1\n    last_index = -1\n\n    try:\n        first_index = s.index(ch)\n        last_index = s.rindex(ch)\n    except ValueError:\n        # Character not found, or only one occurrence if first_index == last_index\n        pass\n\n    if first_index == -1:\n        # Character not found at all\n        return s\n    elif first_index == last_index:\n        # Only one occurrence\n        return s[:first_index] + s[first_index + 1:]\n    else:\n        # Multiple occurrences, remove first and last\n        # Remove the last occurrence first to avoid index shifting issues with the first_index\n        s_without_last = s[:last_index] + s[last_index + 1:]\n        \n        # Now find the first occurrence in the new string (it might be at the same index or shifted)\n        # We need to re-find it because the string length changed, but we can reuse the original first_index\n        # if the last_index was greater than first_index.\n        # This implementation simply rebuilds to avoid complex index logic for robustness.\n        \n        # Original string: s\n        # Remove character at first_index\n        # Remove character at last_index\n        \n        # Example: \"abcad\", 'a'\n        # first_index = 0, last_index = 3\n        # s_part1 = s[0:0] -> \"\"\n        # s_part2 = s[0+1:3] -> \"bc\"\n        # s_part3 = s[3+1:] -> \"d\"\n        # Result: \"bcd\"\n\n        return s[:first_index] + s[first_index+1:last_index] + s[last_index+1:]"}
{"task_id": "Mbpp/16", "solution": "import re\n\ndef text_lowercase_underscore(text: str) -> bool:\n    \"\"\"\n    Checks if the input string contains sequences of lowercase letters\n    joined with a single underscore. It validates that the entire string\n    conforms to this pattern, requiring at least one underscore.\n    \"\"\"\n    pattern = r'^[a-z]+(_[a-z]+)+$'\n    return re.fullmatch(pattern, text) is not None"}
{"task_id": "Mbpp/14", "solution": "def find_Volume(base: float, height: float, depth: float) -> float:\n    \"\"\"Calculate the volume of a triangular prism.\n    The volume is derived from the area of the triangular base multiplied by the prism's depth.\n    \"\"\"\n    triangle_area = 0.5 * base * height\n    volume = triangle_area * depth\n    return volume"}
{"task_id": "Mbpp/12", "solution": "from typing import List\n\ndef sort_matrix(matrix: List[List[float]]) -> List[List[float]]:\n    \"\"\"\n    Sorts a matrix (list of rows) in ascending order based on the sum of its rows.\n    The original matrix is not modified, and the sort is stable.\n    \"\"\"\n    copied_matrix = [list(row) for row in matrix]\n    row_sums = [sum(row) for row in copied_matrix]\n    rows_with_sums = list(zip(copied_matrix, row_sums))\n    sorted_rows_with_sums = sorted(rows_with_sums, key=lambda item: item[1])\n    sorted_matrix = [row for row, _ in sorted_rows_with_sums]\n    return sorted_matrix"}
{"task_id": "Mbpp/18", "solution": "```python\ndef remove_dirty_chars(s: str, remove: str) -> str:\n    \"\"\"Removes characters from the first string that are present in the second string.\n\n    This function is case-sensitive.\n    \"\"\"\n    remove_set = set(remove)\n    return ''.join(ch for ch in s if ch not in remove_set)\n```"}
{"task_id": "Mbpp/17", "solution": "DEFAULT_PRECISION = 6\n\nclass Square:\n    \"\"\"Represents a square with a given side length.\"\"\"\n    def __init__(self, side: float) -> None:\n        self._side: float = side\n\n    def side(self) -> float:\n        \"\"\"Returns the side length of the square.\"\"\"\n        return self._side\n\n    def perimeter(self) -> float:\n        \"\"\"Calculates and returns the perimeter of the square.\"\"\"\n        return 4 * self._side\n\nclass GeometryService:\n    \"\"\"Provides business logic for geometric computations.\"\"\"\n    def __init__(self, precision: int = DEFAULT_PRECISION) -> None:\n        self._precision = precision\n\n    def perimeter_from_side(self, side: float) -> float:\n        \"\"\"Computes the perimeter of a square given its side length, rounded to configured precision.\"\"\"\n        sq = Square(side)\n        raw = sq.perimeter()\n        return round(raw, self._precision)\n\ndef square_perimeter(side: float) -> float:\n    \"\"\"\n    Returns the perimeter of a square given its side length.\n    This is a convenience function that delegates to GeometryService.\n    \"\"\"\n    service = GeometryService()\n    return service.perimeter_from_side(side)"}
{"task_id": "Mbpp/56", "solution": "def check(num):\n    \"\"\"\n    Checks if a given number is one less than twice its reverse.\n    Handles negative numbers by preserving the sign.\n    \"\"\"\n    sign = -1 if num < 0 else 1\n    abs_num = abs(num)\n    reversed_abs = 0\n    while abs_num > 0:\n        reversed_abs = reversed_abs * 10 + (abs_num % 10)\n        abs_num //= 10\n    \n    reversed_num = sign * reversed_abs\n    return num == (2 * reversed_num) - 1"}
{"task_id": "Mbpp/19", "solution": "def test_duplicate(arr):\n    \"\"\"\n    Checks if an array of integers contains any duplicate element using a set.\n    Returns True if a duplicate is found, False otherwise.\n    \"\"\"\n    seen = set()\n    for num in arr:\n        if num in seen:\n            return True\n        seen.add(num)\n    return False"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(number: int) -> bool:\n    \"\"\"\n    Checks if a given number is a Woodall number (n * 2^n - 1) for n >= 1.\n    \"\"\"\n\n    def _pow2(n: int) -> int:\n        \"\"\"Computes 2 raised to the power of n efficiently.\"\"\"\n        return 1 << n\n\n    def _compute_woodall_value(n: int) -> int:\n        \"\"\"Calculates the Woodall number for a given index n.\"\"\"\n        return n * _pow2(n) - 1\n\n    # Woodall numbers are positive for n >= 1.\n    if number <= 0:\n        return False\n\n    # Determine an upper bound for n to search.\n    # This prevents infinite loops and limits the search space for large numbers.\n    \n    n_search_candidate = 1\n    # A safety cap for the maximum n to check, similar to DEFAULT_MAX_ITERATIONS.\n    MAX_N_ITERATIONS = 1024 \n\n    # Exponentially increase n_search_candidate until its Woodall value roughly exceeds 'number'.\n    # This quickly finds a reasonable starting point for the linear search range.\n    while _compute_woodall_value(n_search_candidate) < number and n_search_candidate < MAX_N_ITERATIONS:\n        n_search_candidate *= 2\n    \n    # The final upper bound for the linear search is a conservative estimate,\n    # ensuring we cover potential 'n' values while staying within the safety limit.\n    upper_bound = min(n_search_candidate * 2, MAX_N_ITERATIONS)\n\n    # Perform a linear search for n from 1 up to the determined upper_bound.\n    for n in range(1, upper_bound + 1):\n        woodall_val = _compute_woodall_value(n)\n        if woodall_val == number:\n            return True\n        # Since n * 2^n - 1 is monotonically increasing for n >= 1,\n        # if the current value exceeds the target number, no larger n will match.\n        if woodall_val > number:\n            return False\n            \n    # If the loop completes without finding a match, the number is not a Woodall number\n    # within the search range or if it exceeds the maximum n considered.\n    return False"}
{"task_id": "Mbpp/57", "solution": "def find_Max_Num(digits):\n    \"\"\"\n    Finds the largest number that can be formed by arranging the given list of digits.\n    The digits are sorted in descending order and concatenated to form an integer.\n    \"\"\"\n    sorted_digits = sorted(digits, reverse=True)\n    num_str = \"\".join(str(d) for d in sorted_digits)\n    return int(num_str)"}
{"task_id": "Mbpp/61", "solution": "def count_Substrings(s: str) -> int:\n    \"\"\"\n    Counts the number of substrings in a digit string where the sum of digits equals the substring length.\n    Uses a prefix-sum frequency map for O(n) time complexity.\n    \"\"\"\n    from collections import defaultdict\n\n    ps: int = 0  # Current prefix sum of (digit_value - 1)\n    # Frequencies of prefix sums encountered so far. Initialize freq[0] = 1\n    # to account for substrings starting from index 0.\n    freq: dict[int, int] = defaultdict(int)\n    freq[0] = 1\n    result: int = 0\n\n    for char_digit in s:\n        # Transform digit char to its value minus 1\n        val = (ord(char_digit) - ord('0')) - 1\n        ps += val\n        # If ps has been seen before, all substrings between the current index\n        # and previous occurrences of this ps sum to 0 (meaning digit_sum == length).\n        result += freq[ps]\n        freq[ps] += 1\n    return result"}
