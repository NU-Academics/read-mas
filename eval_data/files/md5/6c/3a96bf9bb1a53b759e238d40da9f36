{"task_id": "Mbpp/454", "solution": "import re\nimport unicodedata\nfrom typing import List, Optional, Dict, Any\n\nDEFAULT_PATTERN = r\"\\b\\w*z\\w*\\b\"\nDEFAULT_FLAGS = re.IGNORECASE\n\nclass Config:\n    def __init__(self, pattern: str = DEFAULT_PATTERN, flags: int = DEFAULT_FLAGS, log_scan_results: bool = False) -> None:\n        self.pattern: str = pattern\n        self.flags: int = flags\n        self.log_scan_results: bool = log_scan_results\n\nclass WordMatchResult:\n    def __init__(self, matches: bool, matched_tokens: Optional[List[str]] = None) -> None:\n        self.matches: bool = matches\n        self.matched_tokens: List[str] = matched_tokens or []\n\n    def to_dict(self) -> Dict[str, Any]:\n        return {\"matches\": self.matches, \"matched_tokens\": self.matched_tokens}\n\ndef normalize_text(text: str) -> str:\n    \"\"\"Normalizes text using NFKC and converts to lowercase.\"\"\"\n    return unicodedata.normalize(\"NFKC\", text).lower()\n\nclass RegexMatcher:\n    def __init__(self, pattern: str, flags: int) -> None:\n        self._pattern_str: str = pattern\n        self._flags: int = flags\n        self._compiled = re.compile(self._pattern_str, self._flags)\n\n    def match_text(self, text: str) -> WordMatchResult:\n        \"\"\"Matches the pattern against the normalized input text.\"\"\"\n        norm = normalize_text(text)\n        tokens = self.findall(norm)\n        return WordMatchResult(matches=bool(tokens), matched_tokens=tokens)\n\n    def findall(self, text: str) -> List[str]:\n        \"\"\"Finds all non-overlapping matches in the text.\"\"\"\n        return list(dict.fromkeys(self._compiled.findall(text)))\n\n    def get_pattern(self) -> str:\n        return self._pattern_str\n\nclass MatcherService:\n    def __init__(self, matcher: RegexMatcher, config: Config) -> None:\n        self._matcher = matcher\n        self._config = config\n\n    def match_text(self, text: str) -> WordMatchResult:\n        \"\"\"Performs the text matching using the internal regex matcher.\"\"\"\n        return self._matcher.match_text(text)\n\ndef get_default_service() -> MatcherService:\n    \"\"\"Initializes and returns a MatcherService with default configuration.\"\"\"\n    cfg = Config()\n    matcher = RegexMatcher(cfg.pattern, cfg.flags)\n    return MatcherService(matcher, cfg)\n\ndef text_match_wordz(text: str) -> bool:\n    \"\"\"\n    Public convenience function: returns True if any word contains 'z'.\n    \"\"\"\n    svc = get_default_service()\n    result = svc.match_text(text)\n    return result.matches"}
{"task_id": "Mbpp/457", "solution": "def Find_Min(list_: list[list]) -> list:\n    \"\"\"\n    Finds the sublist with the minimum length from a list of lists.\n    If multiple sublists have the same minimum length, the first one encountered is returned.\n    \"\"\"\n    if not list_:\n        # As per design context and problem constraints, no exceptions or checks here.\n        # However, for a fully functional solution without external validation,\n        # an empty input would typically raise an error or return a specific value.\n        # Given the example `[[1],[1,2],[1,2,3]]` implies non-empty input.\n        return [] \n\n    min_len = float('inf')\n    min_sublist = None\n\n    for sublist in list_:\n        current_len = len(sublist)\n        if current_len < min_len:\n            min_len = current_len\n            min_sublist = sublist\n            \n    # Return a shallow copy as per design context\n    return list(min_sublist) if min_sublist is not None else []"}
