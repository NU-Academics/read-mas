{"task_id": "Mbpp/84", "solution": "import collections\n\nclass ComputationError(Exception):\n    \"\"\"Custom exception for computation failures.\"\"\"\n    pass\n\nclass CacheRepository:\n    \"\"\"Abstract interface for a cache repository.\"\"\"\n    def get(self, n: int) -> int | None:\n        raise NotImplementedError\n    def set(self, n: int, value: int) -> None:\n        raise NotImplementedError\n\nclass InMemoryCacheRepository(CacheRepository):\n    \"\"\"In-memory dictionary-backed cache implementation.\"\"\"\n    def __init__(self, initial: dict[int, int] | None = None) -> None:\n        self._store = dict(initial or {})\n\n    def get(self, n: int) -> int | None:\n        return self._store.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        self._store[n] = value\n\n    def bulk_set(self, mapping: dict[int, int]) -> None:\n        self._store.update(mapping)\n\nclass SequenceService:\n    \"\"\"Core algorithm for Newman\u2013Conway sequence with memoization and cache integration.\"\"\"\n    def __init__(self, cache: CacheRepository, max_n: int = 100000) -> None:\n        self._cache = cache\n        self._max_n = max_n\n\n    def compute(self, n: int) -> int:\n        \"\"\"Computes the nth Newman\u2013Conway sequence number using dynamic programming and caching.\"\"\"\n        if n < 1 or n > self._max_n:\n            raise ComputationError(f\"n out of allowed range 1..{self._max_n}\")\n\n        cached_n = self._cache.get(n)\n        if cached_n is not None:\n            return cached_n\n\n        # Local memoization for current computation to avoid redundant lookups.\n        a: dict[int, int] = {}\n        \n        def get_a_val(k_idx: int) -> int:\n            \"\"\"Helper to retrieve or compute a value, prioritizing local memo, then persistent cache.\"\"\"\n            if k_idx in a:\n                return a[k_idx]\n            \n            cached_k_val = self._cache.get(k_idx)\n            if cached_k_val is not None:\n                a[k_idx] = cached_k_val\n                return cached_k_val\n            \n            if k_idx == 1 or k_idx == 2:\n                a[k_idx] = 1\n                self._cache.set(k_idx, 1)\n                return 1\n            \n            raise ComputationError(f\"Required intermediate value a[{k_idx}] was not found or computed.\")\n\n        # Ensure base cases are in local memo and cache\n        get_a_val(1)\n        get_a_val(2)\n\n        for i in range(3, n + 1):\n            cached_i_val = self._cache.get(i)\n            if cached_i_val is not None:\n                a[i] = cached_i_val\n                continue\n            \n            val_a_i_minus_1 = get_a_val(i - 1)\n            a[i] = get_a_val(val_a_i_minus_1) + get_a_val(i - val_a_i_minus_1)\n            self._cache.set(i, a[i])\n\n        return a[n]\n\n_default_cache = InMemoryCacheRepository(initial={1:1, 2:1})\n_default_service = SequenceService(cache=_default_cache)\n\ndef sequence(n: int) -> int:\n    \"\"\"Finds the nth number in the Newman-Conway sequence.\"\"\"\n    return _default_service.compute(n)"}
