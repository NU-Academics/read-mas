{"task_id": "Mbpp/284", "solution": "def check_element(list, element):\n    \"\"\"\n    Checks whether all items in the given list are equal to the specified element.\n    Returns False for an empty list or if any comparison raises an exception.\n    \"\"\"\n    item_count = 0\n    for item in list:\n        item_count += 1\n        try:\n            if item != element:\n                return False\n        except Exception:\n            return False\n            \n    return False if item_count == 0 else True"}
{"task_id": "Mbpp/287", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of squares of the first n even natural numbers.\n    Uses the mathematical formula 4 * n * (n + 1) * (2 * n + 1) / 6 for O(1) performance.\n    \"\"\"\n    if n == 0:\n        return 0\n    # The sum of squares of first n even natural numbers (2k)^2 for k=1 to n\n    # is 4 * sum(k^2) for k=1 to n.\n    # The sum of first n squares is n * (n + 1) * (2 * n + 1) / 6.\n    # Thus, the required sum is 4 * n * (n + 1) * (2 * n + 1) // 6.\n    return 4 * n * (n + 1) * (2 * n + 1) // 6"}
{"task_id": "Mbpp/283", "solution": "def validate(n: int) -> bool:\n    \"\"\"\n    Checks if the frequency of each digit in the integer is less than or equal to the digit itself.\n    For the digit 0, its frequency must be 0 to be valid.\n    \"\"\"\n    s = str(abs(n))\n    frequencies = {}\n    for char_digit in s:\n        digit = int(char_digit)\n        frequencies[digit] = frequencies.get(digit, 0) + 1\n\n    for digit, count in frequencies.items():\n        if digit == 0:\n            # According to the rule, count(0) <= 0. So, if 0 appears, it's a violation.\n            if count > 0:\n                return False\n        else:\n            if count > digit:\n                return False\n    return True"}
