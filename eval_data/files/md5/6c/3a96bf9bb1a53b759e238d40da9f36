{"task_id": "Mbpp/87", "solution": "def merge_dictionaries_three(a: dict, b: dict, c: dict) -> dict:\n    \"\"\"\n    Merges three dictionaries into a single dictionary following left-to-right precedence (a > b > c).\n    A new dictionary is returned without modifying the input dictionaries.\n    \"\"\"\n    result = {}\n\n    # Add items from 'a'. If a key exists, 'a's value is taken.\n    result.update(a)\n\n    # Add items from 'b'. Keys already in 'result' (from 'a') are not overwritten.\n    for k, v in b.items():\n        if k not in result:\n            result[k] = v\n\n    # Add items from 'c'. Keys already in 'result' (from 'a' or 'b') are not overwritten.\n    for k, v in c.items():\n        if k not in result:\n            result[k] = v\n\n    return result"}
{"task_id": "Mbpp/85", "solution": "import math\nimport json\nimport logging\nfrom pathlib import Path\nfrom datetime import datetime\nfrom typing import Any, Optional\n\n# Set up a logger, as described in design context for cache errors.\n_logger = logging.getLogger(__name__)\n\nclass InvalidRadiusError(ValueError):\n    \"\"\"Custom exception for invalid radius inputs.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass ValidationUtils:\n    \"\"\"Utility class for validating sphere radius inputs.\"\"\"\n    @staticmethod\n    def validate_radius(value: Any) -> float:\n        try:\n            r = float(value)\n        except (TypeError, ValueError):\n            raise InvalidRadiusError(f\"Radius must be a number, got: {value!r}\")\n        if not math.isfinite(r):\n            raise InvalidRadiusError(\"Radius must be finite.\")\n        if r < 0:\n            raise InvalidRadiusError(\"Radius must be non-negative.\")\n        return r\n\nclass SurfaceAreaCalculator:\n    \"\"\"Calculates the surface area of a sphere.\"\"\"\n    def compute_area(self, radius: float) -> float:\n        return 4.0 * math.pi * (radius ** 2)\n\nDEFAULT_CACHE_DIR = Path(\"~/.cache/sphere_area\").expanduser()\nDEFAULT_CACHE_FILENAME = \"cache.json\"\n\nclass CacheRepository:\n    \"\"\"Manages a simple JSON file-based cache for sphere surface areas.\"\"\"\n    def __init__(self, cache_path: Optional[Path] = None) -> None:\n        self.cache_path = (cache_path or DEFAULT_CACHE_DIR / DEFAULT_CACHE_FILENAME)\n        self.cache_path.parent.mkdir(parents=True, exist_ok=True)\n        self.data = self._load()\n\n    def get(self, radius_key: str) -> Optional[float]:\n        entry = self.data.get(radius_key)\n        return float(entry.get(\"area\")) if entry and \"area\" in entry else None\n\n    def set(self, radius_key: str, area: float) -> None:\n        self.data[radius_key] = {\"radius\": float(radius_key), \"area\": float(area), \"computed_at\": datetime.utcnow().isoformat() + \"Z\"}\n        self._save(self.data)\n\n    def _load(self) -> dict:\n        \"\"\"Loads cache data from the JSON file.\"\"\"\n        try:\n            if self.cache_path.exists():\n                return json.loads(self.cache_path.read_text())\n        except Exception as e:\n            _logger.warning(\"Failed to load cache from %s: %s\", self.cache_path, e)\n        return {}\n\n    def _save(self, data: dict) -> None:\n        \"\"\"Saves cache data to the JSON file atomically.\"\"\"\n        try:\n            tmp_path = self.cache_path.with_suffix(\".tmp\")\n            tmp_path.write_text(json.dumps(data, indent=2))\n            tmp_path.rename(self.cache_path)\n        except Exception as e:\n            _logger.warning(\"Failed to save cache to %s: %s\", self.cache_path, e)\n\nclass APIController:\n    \"\"\"Orchestrates validation, computation, and caching for the surface area API.\"\"\"\n    def __init__(self, calculator: SurfaceAreaCalculator, cache: Optional[CacheRepository] = None) -> None:\n        self.calculator = calculator\n        self.cache = cache\n\n    def surfacearea_sphere(self, radius: Any) -> float:\n        \"\"\"Calculates the surface area of a sphere, using cache if available.\"\"\"\n        r = ValidationUtils.validate_radius(radius)\n        key = repr(float(r)) # Use repr for consistent key generation\n\n        if self.cache:\n            cached = self.cache.get(key)\n            if cached is not None:\n                return float(cached) # Ensure float type from cache\n\n        area = self.calculator.compute_area(r)\n\n        if self.cache:\n            try:\n                self.cache.set(key, area)\n            except Exception as e:\n                _logger.warning(\"Failed to update cache for radius %s: %s\", key, e)\n        return area\n\n# Global instances for the default API entry point, as per design.\n_default_calculator = SurfaceAreaCalculator()\n_default_cache = CacheRepository()\n_default_controller = APIController(_default_calculator, _default_cache)\n\ndef surfacearea_sphere(radius: float) -> float:\n    \"\"\"Calculates the surface area of a sphere given its radius.\"\"\"\n    return _default_controller.surfacearea_sphere(radius)"}
