{"task_id": "Mbpp/123", "solution": "import os\nimport sqlite3\nimport datetime\nimport logging\n\n# Configure a basic logger for warnings, ensuring it's not repeatedly added\n_logger = logging.getLogger(__name__)\nif not _logger.handlers:\n    _logger.setLevel(logging.INFO)\n    _handler = logging.StreamHandler()\n    _handler.setFormatter(logging.Formatter('%(levelname)s: %(message)s'))\n    _logger.addHandler(_handler)\n\nclass InvalidParameterError(Exception):\n    pass\n\nclass CacheError(Exception):\n    pass\n\ndef validate_limit(limit: int) -> None:\n    \"\"\"Validates that the limit is an integer greater than or equal to 1.\"\"\"\n    if not isinstance(limit, int) or limit < 1:\n        raise InvalidParameterError(\"Limit must be an integer greater than or equal to 1.\")\n\ndef warn(msg: str) -> None:\n    \"\"\"Emits a warning message.\"\"\"\n    _logger.warning(msg)\n\nDEFAULT_CACHE_PATH = os.path.join(os.path.expanduser(\"~\"), \".cache\", \"amicable_sum\", \"cache.sqlite\")\n\nSQLITE_SCHEMA = \"\"\"\nCREATE TABLE IF NOT EXISTS divisor_sums (\n    n INTEGER PRIMARY KEY NOT NULL,\n    sum INTEGER NOT NULL,\n    computed_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n);\n\"\"\"\n\nclass CacheRepository:\n    \"\"\"Provides persistence for sum-of-divisors values via SQLite.\"\"\"\n    def __init__(self, db_path: str | None = None) -> None:\n        self._db_path = db_path if db_path is not None else DEFAULT_CACHE_PATH\n        self._conn = None\n        self._initialize_db()\n\n    def _initialize_db(self) -> None:\n        \"\"\"Opens or creates the SQLite DB and ensures the table exists.\"\"\"\n        try:\n            os.makedirs(os.path.dirname(self._db_path), exist_ok=True)\n            self._conn = sqlite3.connect(self._db_path)\n            self._conn.execute(SQLITE_SCHEMA)\n            self._conn.commit()\n        except sqlite3.Error as e:\n            raise CacheError(f\"Failed to initialize cache database at {self._db_path}: {e}\") from e\n\n    def get(self, n: int) -> int | None:\n        \"\"\"Returns cached sum-of-divisors for n, or None if not present.\"\"\"\n        if not self._conn: return None\n        try:\n            cur = self._conn.execute(\"SELECT sum FROM divisor_sums WHERE n = ?\", (n,))\n            row = cur.fetchone()\n            return row[0] if row else None\n        except sqlite3.Error as e:\n            warn(f\"Cache read error for n={n}: {e}\")\n            return None\n\n    def bulk_get(self, start: int, end: int) -> dict[int, int]:\n        \"\"\"Returns mapping of available cached results for the range.\"\"\"\n        if not self._conn: return {}\n        results = {}\n        try:\n            cur = self._conn.execute(\"SELECT n, sum FROM divisor_sums WHERE n BETWEEN ? AND ?\", (start, end))\n            for n, s in cur.fetchall():\n                results[n] = s\n            return results\n        except sqlite3.Error as e:\n            warn(f\"Cache bulk read error for range {start}-{end}: {e}\")\n            return {}\n\n    def set(self, n: int, s: int) -> None:\n        \"\"\"Inserts or replaces cache entry for n.\"\"\"\n        if not self._conn: return\n        try:\n            self._conn.execute(\n                \"INSERT OR REPLACE INTO divisor_sums (n, sum, computed_at) VALUES (?, ?, ?)\",\n                (n, s, datetime.datetime.now())\n            )\n            self._conn.commit()\n        except sqlite3.Error as e:\n            warn(f\"Cache write error for n={n}, sum={s}: {e}\")\n\n    def close(self) -> None:\n        \"\"\"Closes the database connection.\"\"\"\n        if self._conn:\n            self._conn.close()\n            self._conn = None\n\nclass DivisorService:\n    \"\"\"Computes sum of proper divisors for numbers, using an optional cache.\"\"\"\n    def __init__(self, cache_repo: CacheRepository | None = None) -> None:\n        self._cache_repo = cache_repo\n        self.in_memory_cache: dict[int, int] = {}\n\n    def sum_proper_divisors(self, n: int) -> int:\n        \"\"\"Computes sum of proper divisors for single n efficiently.\"\"\"\n        if n <= 1:\n            return 0\n        \n        if n in self.in_memory_cache:\n            return self.in_memory_cache[n]\n        \n        if self._cache_repo:\n            cached_sum = self._cache_repo.get(n)\n            if cached_sum is not None:\n                self.in_memory_cache[n] = cached_sum\n                return cached_sum\n\n        total = 1\n        p = 2\n        temp = n\n        while p * p <= temp:\n            if temp % p == 0:\n                s = 1\n                q = 1\n                while temp % p == 0:\n                    temp //= p\n                    q *= p\n                    s += q\n                total *= s\n            p += 1 if p == 2 else 2\n        if temp > 1:\n            total *= (1 + temp)\n            \n        sum_div = total - n\n        self.in_memory_cache[n] = sum_div\n        if self._cache_repo:\n            self._cache_repo.set(n, sum_div)\n        return sum_div\n\n    def compute_sum_of_divisors(self, limit: int) -> dict[int, int]:\n        \"\"\"Returns mapping for all n in 1..limit, using a sieve and caching.\"\"\"\n        sum_map: dict[int, int] = {}\n        \n        if self._cache_repo:\n            sum_map.update(self._cache_repo.bulk_get(1, limit))\n        \n        self.in_memory_cache.update(sum_map)\n\n        sum_all_divisors = [0] * (limit + 1)\n        \n        for i in range(1, limit + 1):\n            for multiple in range(i, limit + 1, i):\n                sum_all_divisors[multiple] += i\n        \n        for n_val in range(1, limit + 1):\n            if n_val not in sum_map:\n                proper_sum = sum_all_divisors[n_val] - n_val\n                sum_map[n_val] = proper_sum\n                self.in_memory_cache[n_val] = proper_sum\n                if self._cache_repo:\n                    self._cache_repo.set(n_val, proper_sum)\n\n        return sum_map\n\nclass AmicableService:\n    \"\"\"Orchestrates discovery of amicable numbers and summation.\"\"\"\n    def __init__(self, divisor_service: DivisorService) -> None:\n        self.divisor_service = divisor_service\n\n    def _is_amicable(self, a: int, b: int) -> bool:\n        \"\"\"Helper to check the amicable condition using precomputed sums.\"\"\"\n        if a == b or b <= 0:\n            return False\n        \n        sum_of_div_a = self.divisor_service.in_memory_cache.get(a)\n        sum_of_div_b = self.divisor_service.in_memory_cache.get(b)\n\n        return sum_of_div_a == b and sum_of_div_b == a\n\n    def sum_amicable_numbers(self, limit: int, use_cache: bool = True, cache_path: str | None = None) -> int:\n        \"\"\"Computes and returns the sum of all amicable numbers up to limit.\"\"\"\n        validate_limit(limit)\n\n        self.divisor_service.compute_sum_of_divisors(limit)\n\n        amicable_set = set()\n        for a in range(1, limit + 1):\n            b = self.divisor_service.in_memory_cache.get(a)\n            \n            if b is not None and b <= limit:\n                if self._is_amicable(a, b):\n                    amicable_set.add(a)\n                    amicable_set.add(b)\n        \n        return sum(amicable_set)\n\ndef amicable_numbers_sum(limit: int, use_cache: bool = True, cache_path: str | None = None) -> int:\n    \"\"\"Sums all amicable numbers from 1 to a specified number.\"\"\"\n    validate_limit(limit)\n    \n    cache = None\n    if use_cache:\n        try:\n            cache = CacheRepository(cache_path)\n        except CacheError as e:\n            warn(f\"Failed to initialize cache: {e}. Running without persistent cache.\")\n            cache = None\n\n    try:\n        divisor_service = DivisorService(cache_repo=cache)\n        service = AmicableService(divisor_service=divisor_service)\n        return service.sum_amicable_numbers(limit=limit, use_cache=use_cache, cache_path=cache_path)\n    finally:\n        if cache:\n            cache.close()"}
{"task_id": "Mbpp/120", "solution": "def max_product_tuple(pairs):\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples.\n    Assumes input `pairs` is a list of at least two 2-element integer tuples.\n    \"\"\"\n    max_val = 0\n    n = len(pairs)\n    \n    for i in range(n):\n        a1, b1 = pairs[i]\n        for j in range(i + 1, n):\n            a2, b2 = pairs[j]\n            \n            # Compute all four possible cross products and their absolute values\n            products = [\n                abs(a1 * a2),\n                abs(a1 * b2),\n                abs(b1 * a2),\n                abs(b1 * b2)\n            ]\n            \n            # Update max_val if a larger absolute product is found\n            current_max_product = max(products)\n            if current_max_product > max_val:\n                max_val = current_max_product\n                \n    return max_val"}
{"task_id": "Mbpp/129", "solution": "def magic_square_test(matrix: list[list[int]], allow_duplicates: bool = False) -> bool:\n    \"\"\"\n    Checks if a given square matrix is a magic square.\n\n    A magic square is a square matrix where the sum of each row, each column,\n    and both main diagonals is the same. By default, all elements must also be unique.\n    \"\"\"\n    n = len(matrix)\n\n    if n == 0:  # An empty matrix cannot be a magic square.\n        return False\n\n    all_elements = []\n    # Collect all elements and check if the matrix is square\n    for row in matrix:\n        # Check for ragged rows; assumes 'row' is a list\n        if len(row) != n:\n            return False\n        # Collect elements to check uniqueness later\n        for x in row:\n            all_elements.append(x)\n\n    # If duplicates are not allowed, check if all elements are unique\n    if not allow_duplicates:\n        if len(set(all_elements)) != n * n:\n            return False\n\n    # Calculate the target sum from the first row\n    target_sum = sum(matrix[0])\n\n    # Check row sums\n    for i in range(n):\n        if sum(matrix[i]) != target_sum:\n            return False\n\n    # Check column sums\n    for j in range(n):\n        col_sum = 0\n        for i in range(n):\n            col_sum += matrix[i][j]\n        if col_sum != target_sum:\n            return False\n\n    # Check main diagonal sum\n    main_diag_sum = 0\n    for i in range(n):\n        main_diag_sum += matrix[i][i]\n    if main_diag_sum != target_sum:\n        return False\n\n    # Check secondary diagonal sum\n    sec_diag_sum = 0\n    for i in range(n):\n        sec_diag_sum += matrix[i][n - 1 - i]\n    if sec_diag_sum != target_sum:\n        return False\n\n    return True"}
{"task_id": "Mbpp/131", "solution": "def reverse_vowels(s: str) -> str:\n    \"\"\"Reverses only the vowels in the input string s.\"\"\"\n    VOWELS = frozenset({\"a\", \"e\", \"i\", \"o\", \"u\", \"A\", \"E\", \"I\", \"O\", \"U\"})\n    \n    chars = list(s)\n    i, j = 0, len(chars) - 1\n    \n    while i < j:\n        if chars[i] not in VOWELS:\n            i += 1\n            continue\n        \n        if chars[j] not in VOWELS:\n            j -= 1\n            continue\n        \n        # Both pointers are at vowels, swap them\n        chars[i], chars[j] = chars[j], chars[i]\n        i += 1\n        j -= 1\n        \n    return ''.join(chars)"}
