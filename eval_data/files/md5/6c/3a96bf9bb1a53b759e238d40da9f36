{"task_id": "Mbpp/141", "solution": "def pancake_sort(elements: list) -> list:\n    \"\"\"\n    Sorts a list of elements using the pancake sort algorithm in ascending order.\n    \"\"\"\n    class PancakeSorter:\n        def __init__(self, descending: bool = False, verbose: bool = False) -> None:\n            self.descending = descending\n            self.verbose = verbose\n\n        def _flip(self, arr: list, k: int) -> None:\n            \"\"\"Reverses elements from index 0 up to k-1 in the given list.\"\"\"\n            left = 0\n            right = k - 1\n            while left < right:\n                arr[left], arr[right] = arr[right], arr[left]\n                left += 1\n                right -= 1\n\n        def _find_max_index(self, arr: list, n: int) -> int:\n            \"\"\"Finds the index of the maximum element in the sub-array arr[0...n-1].\"\"\"\n            max_val = arr[0]\n            max_idx = 0\n            for i in range(1, n):\n                if arr[i] > max_val:\n                    max_val = arr[i]\n                    max_idx = i\n            return max_idx\n\n        def sort(self, elements: list) -> tuple[list, list[int]]:\n            \"\"\"Performs the pancake sort on a copy of the input list.\"\"\"\n            arr = list(elements)\n            n = len(arr)\n            flips: list[int] = []\n\n            for current_size in range(n, 1, -1):\n                max_idx = self._find_max_index(arr, current_size)\n\n                if max_idx != current_size - 1:\n                    if max_idx != 0:\n                        self._flip(arr, max_idx + 1)\n                        if self.verbose:\n                            flips.append(max_idx + 1)\n                    \n                    self._flip(arr, current_size)\n                    if self.verbose:\n                        flips.append(current_size)\n\n            if self.descending:\n                arr.reverse()\n\n            return arr, flips\n\n    sorter = PancakeSorter(descending=False, verbose=False)\n    sorted_list, _ = sorter.sort(elements)\n    return sorted_list"}
{"task_id": "Mbpp/140", "solution": "from typing import Iterable, Set, Any, Optional\n\nclass ExtractError(Exception):\n    \"\"\"Unified exception type for library-specific errors.\"\"\"\n    def __init__(self, message: str, cause: Optional[Exception] = None):\n        super().__init__(message)\n        self.message = message\n        self.cause = cause\n\n    def __str__(self) -> str:\n        if self.cause:\n            return f\"{self.message} (caused by {type(self.cause).__name__}: {self.cause})\"\n        return self.message\n\ndef is_iterable(obj: Any) -> bool:\n    \"\"\"Checks if an object is iterable, excluding strings and bytes.\"\"\"\n    if isinstance(obj, (str, bytes)):\n        return False\n    try:\n        iter(obj)\n        return True\n    except TypeError:\n        return False\n\ndef to_int_safe(value: Any) -> int:\n    \"\"\"Converts a value to an integer, allowing integral floats.\"\"\"\n    if isinstance(value, int):\n        return value\n    if isinstance(value, float) and value.is_integer():\n        return int(value)\n    raise ValueError(\"Value is not an integer\")\n\nclass InputValidator:\n    \"\"\"Validates input shapes and element types.\"\"\"\n    def __init__(self):\n        pass\n\n    def validate_top_level(self, data: Any) -> None:\n        \"\"\"Ensures the top-level data is an iterable (not string/bytes).\"\"\"\n        if not is_iterable(data):\n            raise ExtractError(\"Top-level input must be an iterable of iterables\")\n\n    def validate_inner(self, item: Any) -> None:\n        \"\"\"Reserved for future rules, currently no-op.\"\"\"\n        pass\n\n    def validate_and_cast_item(self, raw: Any) -> int:\n        \"\"\"Ensures an atomic element is int-compatible and returns its integer value.\"\"\"\n        try:\n            return to_int_safe(raw)\n        except ValueError as e:\n            raise ExtractError(f\"Invalid item for integer conversion: {raw}\", cause=e)\n\nclass InputAdapter:\n    \"\"\"Normalizes various input shapes to consistent iterables.\"\"\"\n    def __init__(self):\n        pass\n\n    def adapt_top_level(self, data: Any) -> Iterable[Any]:\n        \"\"\"Yields sub-iterables from the top-level input.\"\"\"\n        # This check is also in validate_top_level, but included for robustness.\n        if not is_iterable(data):\n            raise ExtractError(\"Top-level input is not iterable\")\n        return data\n\n    def adapt_inner(self, item: Any) -> Iterable[Any]:\n        \"\"\"Returns an item as an iterable, wrapping scalars.\"\"\"\n        if is_iterable(item):\n            return item\n        return (item,) # wrap scalars\n\nclass Extractor:\n    \"\"\"Core business logic for flattening and deduplicating iterables.\"\"\"\n    def __init__(self, validator: InputValidator, adapter: InputAdapter, repository: Any = None):\n        self._validator = validator\n        self._adapter = adapter\n        self._repository = repository # Placeholder for optional persistence\n\n    def extract(self, data: Iterable[Iterable[Any]]) -> Set[int]:\n        \"\"\"Flattens nested iterables and extracts unique integers into a set.\"\"\"\n        self._validator.validate_top_level(data)\n        result = set()\n        for inner in self._adapter.adapt_top_level(data):\n            for raw in self._adapter.adapt_inner(inner):\n                val = self._validator.validate_and_cast_item(raw)\n                result.add(val)\n        return result\n\ndef extract_singly(data: Iterable[Iterable[Any]]) -> Set[int]:\n    \"\"\"Flattens a list of lists into a single set of numbers.\"\"\"\n    validator = InputValidator()\n    adapter = InputAdapter()\n    extractor = Extractor(validator=validator, adapter=adapter, repository=None)\n    return extractor.extract(data)"}
{"task_id": "Mbpp/145", "solution": "def max_Abs_Diff(arr):\n    \"\"\"\n    Finds the maximum difference between any two elements in a given array.\n    Assumes the input `arr` is a non-empty iterable of numeric values.\n    \"\"\"\n    it = iter(arr)\n    first_element = next(it)\n\n    min_val = first_element\n    max_val = first_element\n\n    for val in it:\n        if val < min_val:\n            min_val = val\n        if val > max_val:\n            max_val = val\n\n    return max_val - min_val"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(list1, list2, list3):\n    \"\"\"\n    Counts the number of items that are identical in the same position of three given lists.\n    Compares elements up to the length of the shortest list.\n    \"\"\"\n    min_len = min(len(list1), len(list2), len(list3))\n    count = 0\n    for i in range(min_len):\n        if list1[i] == list2[i] == list3[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/161", "solution": "from typing import List, Any, Set\n\ndef remove_elements(source: List[Any], to_remove: List[Any]) -> List[Any]:\n    \"\"\"\n    Removes all elements from the source list that are present in the to_remove list.\n    The order of the remaining elements in the source list is preserved.\n    \"\"\"\n\n    def _is_hashable(obj: Any) -> bool:\n        \"\"\"Checks if an object is hashable.\"\"\"\n        try:\n            hash(obj)\n            return True\n        except TypeError:\n            return False\n\n    # If the list of elements to remove is empty, no elements need to be removed.\n    # Return a shallow copy of the source list.\n    if not to_remove:\n        return list(source)\n\n    # Use a heuristic: check if the first element in `to_remove` is hashable.\n    # If so, assume all elements are hashable and use a set for O(N+M) performance.\n    # Otherwise, fall back to O(N*M) comparison for potentially unhashable elements.\n    sample_element = to_remove[0]\n\n    if _is_hashable(sample_element):\n        to_remove_set: Set[Any] = set(to_remove)\n        return [element for element in source if element not in to_remove_set]\n    else:\n        return [element for element in source if all(element != item for item in to_remove)]"}
{"task_id": "Mbpp/160", "solution": "def find_solution(a: int, b: int, n: int) -> Optional[Tuple[int, int]]:\n    \"\"\"\n    Finds integer solutions (x, y) to the linear Diophantine equation ax + by = n.\n    Returns (x, y) as a tuple if a solution exists, otherwise returns None.\n    \"\"\"\n\n    def _extended_gcd(val_a: int, val_b: int) -> tuple[int, int, int]:\n        # Computes (g, x, y) such that g = gcd(val_a, val_b) and val_a*x + val_b*y = g.\n        old_r, r = abs(val_a), abs(val_b)\n        old_s, s = 1, 0\n        old_t, t = 0, 1\n\n        while r != 0:\n            q = old_r // r\n            old_r, r = r, old_r - q * r\n            old_s, s = s, old_s - q * s\n            old_t, t = t, old_t - q * t\n        \n        # Adjust signs of Bezout coefficients to match the original input signs of val_a and val_b.\n        return old_r, old_s if val_a >= 0 else -old_s, old_t if val_b >= 0 else -old_t\n\n    # Handle the special case where both 'a' and 'b' are zero.\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n\n    # Use the Extended Euclidean Algorithm to find gcd(a, b) and initial Bezout coefficients (x0, y0).\n    g, x0, y0 = _extended_gcd(a, b)\n\n    # If 'n' is not divisible by 'g' (gcd(a, b)), no integer solution exists.\n    if n % g != 0:\n        return None\n\n    # Calculate the scaling factor to adjust coefficients from g to n.\n    k_scale = n // g\n\n    # Obtain a particular solution (x_p, y_p) by scaling the Bezout coefficients.\n    x_p = x0 * k_scale\n    y_p = y0 * k_scale\n\n    # Normalize the solution to a canonical form, typically by bringing x into the range [0, abs(b/g)).\n    # This ensures a consistent result when multiple solutions exist.\n    if b != 0:\n        b_prime = b // g  # The coefficient for the 't' parameter in x's general solution.\n        \n        # Calculate the target x-value in the range [0, abs(b_prime)) using modular arithmetic.\n        x_normalized = (x_p % b_prime + b_prime) % b_prime\n        \n        # Determine the integer 't' value needed to shift x_p to x_normalized.\n        t = (x_normalized - x_p) // b_prime\n\n        # Apply the same shift 't' to y_p.\n        y_p = y_p - t * (a // g)\n        x_p = x_normalized # Update x_p to the normalized value.\n    \n    return (x_p, y_p)"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(text: str) -> int:\n    \"\"\"Counts characters matching their 1-based alphabet position (case-insensitive).\"\"\"\n    matches = 0\n    lower_text = text.lower()\n\n    for i, char in enumerate(lower_text, start=1):\n        if 'a' <= char <= 'z':\n            alphabet_position = ord(char) - ord('a') + 1\n            if alphabet_position == i:\n                matches += 1\n    return matches"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the series n + (n-2) + (n-4) + ... down to the last positive term.\n    The summation uses a closed-form formula for arithmetic progression.\n    \"\"\"\n    # Calculate the number of positive terms in the series.\n    # For n=0, k=0. For n=1, k=1. For n=2, k=1 (term is 2). For n=6, k=3 (terms 6,4,2).\n    k = (n + 1) // 2\n\n    if k == 0:\n        return 0\n\n    first_term = n\n    # The last positive term is the k-th term in the sequence: n, n-2, n-4, ...\n    last_term = n - 2 * (k - 1)\n\n    # Sum of an arithmetic series = number_of_terms * (first_term + last_term) / 2\n    return k * (first_term + last_term) // 2"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the smallest power of 2 greater than or equal to n.\n    Handles n <= 1 by returning 1.\n    \"\"\"\n    if n <= 1:\n        return 1\n\n    # Decrement n to handle cases where n is already a power of 2.\n    # Then, apply bit-filling to set all bits from the most significant bit downwards.\n    v = n - 1\n    v |= v >> 1\n    v |= v >> 2\n    v |= v >> 4\n    v |= v >> 8\n    v |= v >> 16\n    v |= v >> 32\n    # Increment by 1 to get the next power of 2.\n    return v + 1"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(nums: list[int]) -> int:\n    \"\"\"Counts pairs of integers in a list that XOR to an even number.\"\"\"\n    evens = 0\n    odds = 0\n    for x in nums:\n        if (x & 1) == 0:  # Check if the number is even\n            evens += 1\n        else:\n            odds += 1\n\n    # The number of pairs of even numbers, C(evens, 2)\n    count_even_parity_pairs = evens * (evens - 1) // 2\n    # The number of pairs of odd numbers, C(odds, 2)\n    count_odd_parity_pairs = odds * (odds - 1) // 2\n\n    return count_even_parity_pairs + count_odd_parity_pairs"}
{"task_id": "Mbpp/170", "solution": "from typing import List, Sequence\n\nclass InvalidRangeError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass InvalidElementError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass RangeRequest:\n    def __init__(self, numbers: list, start: int, end: int) -> None:\n        self.numbers = numbers\n        self.start = start\n        self.end = end\n\nclass SumResult:\n    def __init__(self, total: float) -> None:\n        self.total = total\n\nclass ListRepository:\n    def get_slice(self, numbers: Sequence[float], start: int, end: int) -> List[float]:\n        # Returns a new list with elements numbers[start:end+1] (inclusive end).\n        return list(numbers[start:end+1])\n\nclass RangeValidator:\n    ALLOWED_NUMERIC_TYPES = (int, float)\n\n    def validate(self, req: RangeRequest) -> None:\n        # Validates request parameters and list elements, raising exceptions for invalid inputs.\n        if not isinstance(req.start, int) or not isinstance(req.end, int):\n            raise InvalidRangeError(\"start and end must be integers\")\n        if not isinstance(req.numbers, (list, tuple)):\n            raise InvalidRangeError(\"numbers must be a list or tuple\")\n        n = len(req.numbers)\n        if n == 0:\n            raise InvalidRangeError(\"numbers must not be empty\")\n        if req.start < 0 or req.end < 0 or req.start > req.end or req.end >= n:\n            raise InvalidRangeError(f\"invalid range: start={req.start}, end={req.end}, len={n}\")\n        for i, v in enumerate(req.numbers):\n            if not isinstance(v, self.ALLOWED_NUMERIC_TYPES):\n                raise InvalidElementError(f\"element at index {i} is not numeric: {v}\")\n\nclass SumService:\n    def __init__(self, repository: ListRepository) -> None:\n        self._repository = repository\n\n    def sum_range(self, numbers: Sequence[float], start: int, end: int) -> float:\n        # Computes the sum of a sub-list obtained from the repository.\n        sub = self._repository.get_slice(numbers, start, end)\n        total = sum(sub)\n        return float(total)\n\nclass SumController:\n    def __init__(self, service: SumService, validator: RangeValidator) -> None:\n        self._service = service\n        self._validator = validator\n\n    def handle_request(self, req: RangeRequest) -> SumResult:\n        # Orchestrates validation and sum calculation for a given request.\n        self._validator.validate(req)\n        total = self._service.sum_range(req.numbers, req.start, req.end)\n        return SumResult(total)\n\ndef sum_range_list(numbers: list, start: int, end: int) -> float:\n    \"\"\"\n    Finds the sum of numbers in a list within a specified inclusive range.\n    \"\"\"\n    req = RangeRequest(numbers=numbers, start=start, end=end)\n    validator = RangeValidator()\n    repository = ListRepository()\n    service = SumService(repository)\n    controller = SumController(service=service, validator=validator)\n    result = controller.handle_request(req)\n    return result.total"}
