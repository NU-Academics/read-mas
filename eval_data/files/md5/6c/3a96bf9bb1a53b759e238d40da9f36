{"task_id": "Mbpp/427", "solution": "import re\nfrom datetime import datetime\n\ndef change_date_format(date_str: str) -> str:\n    \"\"\"\n    Converts a date string from 'YYYY-MM-DD' format to 'DD-MM-YYYY' format.\n    Ensures robust validation and consistent error handling using a modular design.\n    \"\"\"\n    class DateFormatError(ValueError):\n        \"\"\"Custom exception for date format or value errors.\"\"\"\n        def __init__(self, message: str):\n            super().__init__(message)\n            self.message = message\n\n        def __str__(self) -> str:\n            return self.message\n\n    class DateInput:\n        \"\"\"Data Transfer Object for validated date components.\"\"\"\n        def __init__(self, year: int, month: int, day: int):\n            self.year = year\n            self.month = month\n            self.day = day\n\n        @classmethod\n        def from_components(cls, year: int, month: int, day: int) -> \"DateInput\":\n            \"\"\"Factory method to create a DateInput instance.\"\"\"\n            return cls(year, month, day)\n\n    class DateValidator:\n        \"\"\"Validates date strings and converts them to DateInput.\"\"\"\n        DATE_INPUT_PATTERN = r\"^\\d{4}-\\d{2}-\\d{2}$\"\n\n        def validate(self, date_str: str) -> DateInput:\n            \"\"\"Validates the input date string and returns a DateInput object.\"\"\"\n            if not isinstance(date_str, str) or not re.match(self.DATE_INPUT_PATTERN, date_str):\n                raise DateFormatError(\"Input must be YYYY-MM-DD\")\n            try:\n                dt = datetime.strptime(date_str, \"%Y-%m-%d\")\n                return DateInput(dt.year, dt.month, dt.day)\n            except ValueError as exc:\n                raise DateFormatError(str(exc))\n\n    class DateConverter:\n        \"\"\"Converts a DateInput object into a formatted string (DD-MM-YYYY).\"\"\"\n        def convert(self, date_input: DateInput) -> str:\n            \"\"\"Converts a DateInput object to dd-mm-yyyy string.\"\"\"\n            return f\"{date_input.day:02d}-{date_input.month:02d}-{date_input.year:04d}\"\n\n    class ChangeDateController:\n        \"\"\"Orchestrates date validation and conversion.\"\"\"\n        def __init__(self, validator=None, converter=None):\n            self.validator = validator or DateValidator()\n            self.converter = converter or DateConverter()\n\n        def convert(self, date_str: str) -> str:\n            \"\"\"Validates and converts the date string.\"\"\"\n            date_input = self.validator.validate(date_str)\n            return self.converter.convert(date_input)\n\n    class DateFormatterAPI:\n        \"\"\"Provides the public API interface for date formatting.\"\"\"\n        def change_date_format(self, date_str: str) -> str:\n            \"\"\"Converts date string using the controller.\"\"\"\n            controller = ChangeDateController()\n            return controller.convert(date_str)\n\n    return DateFormatterAPI().change_date_format(date_str)"}
