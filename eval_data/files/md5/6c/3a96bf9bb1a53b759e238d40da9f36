{"task_id": "Mbpp/391", "solution": "def convert_list_dictionary(*lists):\n    \"\"\"\n    Converts multiple parallel lists into a list of nested dictionaries.\n\n    The first list provides the outermost keys, and subsequent lists provide\n    nested keys/values, with the last list providing the innermost values.\n    \"\"\"\n    if not lists:\n        return []\n\n    list_length = len(lists[0])\n\n    # If the first list is empty, the result will be an empty list.\n    if list_length == 0:\n        return []\n\n    result = []\n\n    def _build_nested_value(items):\n        \"\"\"Recursively builds a nested dictionary from a sequence of items.\"\"\"\n        if len(items) == 1:\n            return items[0]\n        return {items[0]: _build_nested_value(items[1:])}\n\n    for i in range(list_length):\n        outer_key = lists[0][i]\n        \n        # Collect items for the nested structure from the second list onwards.\n        inner_value_items = [lst[i] for lst in lists[1:]]\n        \n        # Determine if direct value assignment or further nesting is needed.\n        if len(inner_value_items) == 1:\n            # For two input lists, the innermost value is directly available.\n            nested_structure = inner_value_items[0]\n        else:\n            # For three or more input lists, build a nested dictionary.\n            nested_structure = _build_nested_value(inner_value_items)\n        \n        result.append({outer_key: nested_structure})\n        \n    return result"}
{"task_id": "Mbpp/392", "solution": "def get_max_sum(n):\n    \"\"\"\n    Computes the maximum sum for n using the given recurrence relation with memoization.\n    The function f(n) = max((f(n/2) + f(n/3) + f(n/4) + f(n/5)), n) is applied recursively.\n    \"\"\"\n    memo = {}\n\n    def _calculate(k):\n        if k <= 1:\n            return k\n        if k in memo:\n            return memo[k]\n\n        sum_of_children = (\n            _calculate(k // 2) +\n            _calculate(k // 3) +\n            _calculate(k // 4) +\n            _calculate(k // 5)\n        )\n\n        result = max(sum_of_children, k)\n        memo[k] = result\n        return result\n\n    return _calculate(n)"}
{"task_id": "Mbpp/395", "solution": "def first_non_repeating_character(s: str) -> str | None:\n    \"\"\"\n    Finds the first non-repeated character in a string using a two-pass approach.\n    Returns the character or None if no non-repeated character is found.\n    \"\"\"\n    if not s:\n        return None\n\n    from collections import Counter\n    counts = Counter(s)\n\n    for char in s:\n        if counts[char] == 1:\n            return char\n            \n    return None"}
