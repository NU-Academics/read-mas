{"task_id": "Mbpp/296", "solution": "def get_Inv_Count(arr):\n    \"\"\"Counts inversions in an array using a merge-sort based approach.\"\"\"\n\n    def _merge(left, right):\n        \"\"\"Merges two sorted lists and counts inversions between them.\"\"\"\n        i = j = 0\n        merged = []\n        inv_count = 0\n        while i < len(left) and j < len(right):\n            if left[i] <= right[j]:\n                merged.append(left[i])\n                i += 1\n            else:\n                merged.append(right[j])\n                j += 1\n                inv_count += len(left) - i\n        merged.extend(left[i:])\n        merged.extend(right[j:])\n        return merged, inv_count\n\n    def _merge_sort_and_count(arr_segment):\n        \"\"\"Recursively sorts array segments and accumulates inversion counts.\"\"\"\n        n = len(arr_segment)\n        if n <= 1:\n            return arr_segment, 0\n\n        mid = n // 2\n        left_sorted, left_inversions = _merge_sort_and_count(arr_segment[:mid])\n        right_sorted, right_inversions = _merge_sort_and_count(arr_segment[mid:])\n\n        merged_sorted, split_inversions = _merge(left_sorted, right_sorted)\n        return merged_sorted, left_inversions + right_inversions + split_inversions\n\n    # Create a copy of the input array to avoid modifying the original.\n    _, total_inversions = _merge_sort_and_count(list(arr))\n    return total_inversions"}
{"task_id": "Mbpp/294", "solution": "from typing import Any, Sequence, Union\nfrom decimal import Decimal\n\ndef max_val(values: Sequence[Any]) -> Union[int, float, Decimal]:\n    \"\"\"\n    Finds the maximum numeric value in a given heterogeneous list.\n    Non-numeric items are ignored, and booleans are not considered numeric.\n    \"\"\"\n    numeric_items = []\n    for item in values:\n        if isinstance(item, (int, float, Decimal)) and not isinstance(item, bool):\n            numeric_items.append(item)\n    return max(numeric_items)"}
{"task_id": "Mbpp/299", "solution": "def max_aggregate(records: list[tuple[str, int]]) -> tuple[str, int]:\n    \"\"\"\n    Calculates the maximum aggregate sum from a list of (name, value) tuples.\n    If multiple names have the same maximum sum, the first encountered name\n    in the input list is returned.\n    \"\"\"\n    if not records:\n        return ('', 0)\n\n    # Aggregate sums for each name\n    totals: dict[str, float] = {}\n    for name, value in records:\n        totals[name] = totals.get(name, 0.0) + value\n\n    if not totals: # Should not happen if records is not empty, but as a safeguard\n        return ('', 0)\n\n    # Find the maximum total value\n    max_total = max(totals.values())\n\n    # Find the name corresponding to the max_total,\n    # prioritizing the first encountered name in the original list if there's a tie\n    for name, _ in records:\n        if totals[name] == max_total:\n            return (name, int(max_total)) # Return as int as per example output type hint\n\n    # This part should ideally not be reached if totals is not empty,\n    # but added for completeness/safety, although assert implies valid input always.\n    return ('', 0)"}
{"task_id": "Mbpp/300", "solution": "import math\n\ndef count_binary_seq(n: int) -> int:\n    \"\"\"\n    Calculates the number of binary sequences of length 2n such that the sum of the first n bits\n    is the same as the sum of the last n bits. This is combinatorially equivalent to C(2n, n).\n    \"\"\"\n    N = 2 * n\n    K = n\n\n    if hasattr(math, 'comb'):\n        return math.comb(N, K)\n    else:\n        # Fallback for Python versions older than 3.8 without math.comb.\n        # Implements C(N, K) using the multiplicative formula C(N, K) = N! / (K! * (N-K)!).\n        K_eff = min(K, N - K)\n        if K_eff == 0:\n            return 1\n\n        res = 1\n        for i in range(K_eff):\n            res = res * (N - i) // (i + 1)\n        return res"}
{"task_id": "Mbpp/297", "solution": "from typing import Any, List, Iterator, Set\nfrom collections.abc import Iterable\n\nclass FlattenError(Exception):\n    pass\n\nclass InvalidInputError(FlattenError):\n    def __init__(self, message: str, invalid_value: Any = None):\n        super().__init__(message)\n        self.invalid_value = invalid_value\n\ndef _is_string_like(v: Any) -> bool:\n    return isinstance(v, (str, bytes))\n\nclass ListAdapter:\n    @staticmethod\n    def is_list_like(value: Any) -> bool:\n        return isinstance(value, (list, tuple))\n\n    @staticmethod\n    def to_iter(value: Any) -> Iterator[Any]:\n        return iter(value)\n\nclass IterableAdapter:\n    @staticmethod\n    def is_iterable(value: Any) -> bool:\n        # Treats non-list/tuple iterables, but excludes strings, bytes, and dicts as atomic.\n        return isinstance(value, Iterable) and not _is_string_like(value) and not isinstance(value, dict)\n\n    @staticmethod\n    def to_iter(value: Any) -> Iterator[Any]:\n        return iter(value)\n\nclass InputValidator:\n    def validate(self, value: Any) -> None:\n        # Validates top-level input as a list/tuple or general iterable.\n        if not (ListAdapter.is_list_like(value) or IterableAdapter.is_iterable(value)):\n            raise InvalidInputError(\"Top-level input must be list/tuple or iterable\", value)\n\nclass FlattenService:\n    def __init__(self) -> None:\n        self.list_adapter = ListAdapter()\n        self.iter_adapter = IterableAdapter()\n        self.validator = InputValidator()\n\n    def flatten(self, value: Any) -> List[Any]:\n        \"\"\"\n        Flattens a nested list-like structure into a single list.\n        Performs input validation and cycle detection.\n        \"\"\"\n        self.validator.validate(value)\n\n        seen_ids: Set[int] = set()\n        result: List[Any] = []\n        for item in self._iterative_flatten(value, seen_ids):\n            result.append(item)\n        return result\n\n    def _iterative_flatten(self, value: Any, seen_ids: Set[int]) -> Iterator[Any]:\n        stack = [value]\n        while stack:\n            cur = stack.pop()\n\n            is_container_list_like = self.list_adapter.is_list_like(cur)\n            is_container_iterable = self.iter_adapter.is_iterable(cur)\n\n            if is_container_list_like or is_container_iterable:\n                if id(cur) in seen_ids:\n                    raise InvalidInputError(\"Cycle detected\", cur)\n                seen_ids.add(id(cur))\n\n                # Push elements onto the stack in reverse order to maintain left-to-right processing.\n                if is_container_list_like:\n                    for elem in reversed(list(self.list_adapter.to_iter(cur))):\n                        stack.append(elem)\n                else: # Must be is_container_iterable\n                    for elem in reversed(list(self.iter_adapter.to_iter(cur))):\n                        stack.append(elem)\n            else:\n                yield cur\n\n_service = FlattenService()\n\ndef flatten_list(value: object) -> list:\n    \"\"\"\n    Flattens a given nested list structure.\n    \"\"\"\n    return _service.flatten(value)"}
{"task_id": "Mbpp/305", "solution": "class InvalidInputError(ValueError):\n    pass\n\nclass NotEnoughMatchesError(ValueError):\n    pass\n\nfrom typing import List, Tuple, Optional\nimport string\n\nclass WordPair:\n    def __init__(self, first: str, second: str):\n        # Initializes a WordPair with two words.\n        if not first or not second:\n            raise InvalidInputError(\"Words in WordPair cannot be empty\")\n        self.first = first\n        self.second = second\n\n    def to_tuple(self) -> Tuple[str, str]:\n        # Returns the word pair as a tuple.\n        return (self.first, self.second)\n\nclass Tokenizer:\n    PUNCTUATION_CHARS = '.,;:!?()\"\\'[]{}<>'\n\n    def tokenize(self, line: str) -> List[str]:\n        # Splits a line into words and strips surrounding punctuation from each.\n        raw_tokens = line.split()\n        out = []\n        for t in raw_tokens:\n            stripped = t.strip(self.PUNCTUATION_CHARS)\n            if stripped:\n                out.append(stripped)\n        return out\n\nclass Validator:\n    def is_word_starting(self, word: str, letter: str) -> bool:\n        # Checks if a word starts with the given letter, ignoring case.\n        if not word or not letter:\n            return False\n        return word[0].lower() == letter.lower()\n\nclass WordRepository:\n    def __init__(self):\n        # Initializes an in-memory repository for the last WordPair.\n        self._last: Optional[WordPair] = None\n\n    def save(self, pair: WordPair) -> None:\n        # Saves the given WordPair as the last result.\n        self._last = pair\n\n    def get_last(self) -> Optional[WordPair]:\n        # Retrieves the last saved WordPair.\n        return self._last\n\nclass WordService:\n    def __init__(self, tokenizer: Tokenizer, validator: Validator, repository: Optional[WordRepository] = None):\n        # Initializes the service with tokenizer, validator, and an optional repository.\n        self._tokenizer = tokenizer\n        self._validator = validator\n        self._repo = repository\n\n    def find_two_starting_with(self, lines: List[str], letter: str = \"p\") -> Tuple[str, str]:\n        # Finds the first two words from the input lines that start with the specified letter.\n        if not isinstance(lines, list) or not all(isinstance(l, str) for l in lines):\n            raise InvalidInputError(\"lines must be a list of strings\")\n        \n        candidates: List[str] = self._collect_candidates(lines, letter)\n        \n        if len(candidates) < 2:\n            raise NotEnoughMatchesError(f\"expected 2 matches for letter '{letter}', found {len(candidates)}\")\n        \n        pair = WordPair(candidates[0], candidates[1])\n        if self._repo:\n            self._repo.save(pair)\n        return pair.to_tuple()\n\n    def _collect_candidates(self, lines: List[str], letter: str) -> List[str]:\n        # Internal helper to collect up to two matching words.\n        matches: List[str] = []\n        for line in lines:\n            for token in self._tokenizer.tokenize(line):\n                if self._validator.is_word_starting(token, letter):\n                    matches.append(token)\n                    if len(matches) >= 2:\n                        return matches\n        return matches\n\ndef start_withp(lines: List[str]) -> Tuple[str, str]:\n    \"\"\"\n    Returns the first two words from a list of lines that start with 'p'.\n    Raises InvalidInputError or NotEnoughMatchesError on failure.\n    \"\"\"\n    svc = WordService(Tokenizer(), Validator())\n    return svc.find_two_starting_with(lines, \"p\")"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(d: dict) -> int:\n    \"\"\"\n    Calculates the maximum nesting depth of a dictionary.\n    The top-level dictionary itself has a depth of 1.\n    \"\"\"\n    max_current_depth = 1\n\n    for value in d.values():\n        if isinstance(value, dict):\n            # Recursively find the depth of the nested dictionary\n            # and add 1 for the current level.\n            depth_through_child = 1 + dict_depth(value)\n            if depth_through_child > max_current_depth:\n                max_current_depth = depth_through_child\n\n    return max_current_depth"}
{"task_id": "Mbpp/306", "solution": "from typing import List\n\ndef max_sum_increasing_subseq(arr: List[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence from arr[0...i] that includes arr[k].\n    The subsequence must be strictly increasing.\n    \"\"\"\n    # Step 1: Compute MSIS for the prefix arr[0...i]\n    # msis[j] will store the maximum sum of an increasing subsequence ending at index j within the prefix.\n    msis = [0] * (i + 1)\n\n    for j in range(i + 1):\n        msis[j] = arr[j]  # Initialize with the element itself\n        for l in range(j):\n            if arr[l] < arr[j] and msis[l] + arr[j] > msis[j]:\n                msis[j] = msis[l] + arr[j]\n\n    # Step 2: Combine with arr[k]\n    # Initialize max_sum with arr[k] itself, in case no prefix elements can precede it.\n    target_k_value = arr[k]\n    max_sum = target_k_value\n\n    for j in range(i + 1):\n        # If arr[j] can precede arr[k] in an increasing subsequence\n        if arr[j] < target_k_value:\n            max_sum = max(max_sum, msis[j] + target_k_value)\n\n    return max_sum"}
{"task_id": "Mbpp/309", "solution": "def maximum(a, b):\n    # Convert inputs to float for consistent comparison and return type.\n    # This implicitly handles integers and raises ValueError for non-numeric types\n    # that cannot be converted, without explicitly adding isinstance checks or\n    # custom exception raising as per constraints.\n    val_a = float(a)\n    val_b = float(b)\n\n    # Return the larger of the two values. If equal, return the first for determinism.\n    if val_a >= val_b:\n        return val_a\n    else:\n        return val_b"}
