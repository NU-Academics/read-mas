{"task_id": "Mbpp/3", "solution": "import math\n\ndef is_not_prime(n: int) -> bool:\n    \"\"\"\n    Identifies if a number is not prime.\n    Returns True for non-prime numbers (composites, 0, 1, negatives) and False for prime numbers.\n    \"\"\"\n    if n <= 1:\n        return True\n\n    if n == 2 or n == 3:\n        return False\n\n    if n % 2 == 0 or n % 3 == 0:\n        return True\n\n    r = math.isqrt(n)\n    i = 5\n    while i <= r:\n        if n % i == 0 or n % (i + 2) == 0:\n            return True\n        i += 6\n    return False"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(a, b):\n    \"\"\"\n    Checks if two integers differ at exactly one bit position.\n    This is true if their XOR result is a power of two and not zero.\n    \"\"\"\n    xor_result = a ^ b\n    # A number is a power of two if it's greater than 0 and has only one bit set.\n    # The trick (x & (x - 1)) == 0 checks if only one bit is set.\n    return xor_result > 0 and (xor_result & (xor_result - 1)) == 0"}
{"task_id": "Mbpp/7", "solution": "import re\nfrom typing import List\n\ndef find_char_long(text: str, min_length: int = 4) -> List[str]:\n    \"\"\"\n    Finds words in a string that are at least `min_length` characters long, normalizing punctuation and ensuring uniqueness.\n    \"\"\"\n    # Regex for allowed word characters, including letters, digits, apostrophes, and hyphens.\n    ALLOWED_WORD_RE = r\"[A-Za-z0-9'\u2019-]+\"\n\n    # Tokenize the text using the allowed word regex.\n    raw_tokens = re.findall(ALLOWED_WORD_RE, text)\n    \n    normalized_tokens = []\n    for t in raw_tokens:\n        # Normalize smart apostrophes to ASCII and strip common bounding punctuation.\n        cleaned_token = t.replace(\"\u2019\", \"'\").strip(\".,;:!?\\\"()[]{}\")\n        if cleaned_token: # Only add non-empty tokens after stripping\n            normalized_tokens.append(cleaned_token)\n\n    # Filter words based on the minimum length requirement.\n    filtered_by_length = [word for word in normalized_tokens if len(word) >= min_length]\n\n    # Ensure uniqueness while preserving the order of first appearance.\n    unique_words = list(dict.fromkeys(filtered_by_length))\n\n    return unique_words"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(s: str) -> int:\n    \"\"\"\n    Finds the minimum number of rotations (greater than 0) required to get the same string.\n    This uses the KMP LPS array algorithm to determine the smallest repeating unit.\n    \"\"\"\n    n = len(s)\n\n    if n == 1:\n        return 1\n\n    def _compute_lps(text: str) -> list[int]:\n        \"\"\"Computes the Longest Proper Prefix which is also a Suffix (LPS) array for KMP.\"\"\"\n        m = len(text)\n        lps = [0] * m\n        length = 0  # Length of the previous longest prefix suffix\n        i = 1\n        while i < m:\n            if text[i] == text[length]:\n                length += 1\n                lps[i] = length\n                i += 1\n            else:\n                if length != 0:\n                    length = lps[length - 1]\n                else:\n                    lps[i] = 0\n                    i += 1\n        return lps\n\n    lps = _compute_lps(s)\n\n    # The period (smallest repeating unit length) is derived from the LPS array.\n    period = n - lps[-1]\n\n    # If the string length is perfectly divisible by the period, return the period.\n    # Otherwise, the string is not formed by repeating a smaller unit, so the rotation is its own length.\n    if n % period == 0:\n        return period\n    else:\n        return n"}
{"task_id": "Mbpp/2", "solution": "from collections import Counter\n\ndef similar_elements(a, b, multiset: bool=False, preserve_order: bool=False):\n    \"\"\"\n    Finds the shared elements between two iterables, supporting unique or multiset semantics\n    and optional order preservation based on the first input.\n    \"\"\"\n\n    def is_hashable(x):\n        \"\"\"Checks if an object is hashable.\"\"\"\n        try:\n            hash(x)\n        except TypeError:\n            return False\n        return True\n\n    # Convert inputs to lists for internal processing, assuming they are iterables.\n    a_list = list(a)\n    b_list = list(b)\n\n    # Determine if all elements in both lists are hashable\n    hashable_all = True\n    for x in a_list:\n        if not is_hashable(x):\n            hashable_all = False\n            break\n    if hashable_all:\n        for x in b_list:\n            if not is_hashable(x):\n                hashable_all = False\n                break\n\n    result = []\n    if hashable_all:\n        # Efficient path using sets/Counters for hashable elements\n        if multiset:\n            ca, cb = Counter(a_list), Counter(b_list)\n            for k in (ca.keys() & cb.keys()):\n                result.extend([k] * min(ca[k], cb[k]))\n        else:\n            sa, sb = set(a_list), set(b_list)\n            result = list(sa & sb)\n    else:\n        # Fallback path for unhashable elements\n        if multiset:\n            # Create a mutable copy of b_list elements for matching\n            temp_b = list(b_list)\n            for ai in a_list:\n                for i, bj in enumerate(temp_b):\n                    if ai == bj:\n                        result.append(ai)\n                        temp_b.pop(i) # Remove matched element to handle counts\n                        break\n        else:\n            # Store unique elements found so far\n            temp_result = []\n            for ai in a_list:\n                found = False\n                for bj in b_list:\n                    if ai == bj:\n                        found = True\n                        break\n                if found and ai not in temp_result:\n                    temp_result.append(ai)\n            result = temp_result\n\n    if preserve_order:\n        # Preserve order according to the first argument (a_list), ensuring unique elements.\n        # This implementation follows the design document's explicit example for `preserve_order`\n        # which effectively filters for unique items from `a_list` that are in the computed `result`.\n        shared_set = set(result)\n        ordered = []\n        seen_in_order = set()\n        for x in a_list:\n            if x in shared_set and x not in seen_in_order:\n                ordered.append(x)\n                seen_in_order.add(x)\n        return ordered\n    \n    return result"}
{"task_id": "Mbpp/4", "solution": "import heapq\n\ndef heap_queue_largest(numbers: list, n: int) -> list:\n    \"\"\"Finds the n largest integers from a list and returns them in descending order using a heap.\"\"\"\n    if n <= 0:\n        return []\n    # heapq.nlargest efficiently retrieves the n largest elements, which are already in descending order.\n    return heapq.nlargest(n, numbers)"}
