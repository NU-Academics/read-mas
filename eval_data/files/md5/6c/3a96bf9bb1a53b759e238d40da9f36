{"task_id": "Mbpp/96", "solution": "def divisor(n: int) -> int:\n    \"\"\"\n    Calculates the number of positive divisors for a given integer n.\n    \"\"\"\n    if n == 1:\n        return 1\n\n    factors = {}\n    \n    # Handle factor 2\n    while n % 2 == 0:\n        factors[2] = factors.get(2, 0) + 1\n        n //= 2\n\n    # Handle factor 3\n    while n % 3 == 0:\n        factors[3] = factors.get(3, 0) + 1\n        n //= 3\n\n    # Handle factors from 5 onwards using 6k \u00b1 1 optimization\n    # Check numbers of the form 6k-1 and 6k+1\n    i = 5\n    while i * i <= n:\n        while n % i == 0:\n            factors[i] = factors.get(i, 0) + 1\n            n //= i\n        while n % (i + 2) == 0:\n            factors[i + 2] = factors.get(i + 2, 0) + 1\n            n //= (i + 2)\n        i += 6\n    \n    # If n is still greater than 1, it must be a prime factor itself\n    if n > 1:\n        factors[n] = factors.get(n, 0) + 1\n            \n    # Calculate the number of divisors from prime factors and their exponents\n    num_divisors = 1\n    for exponent in factors.values():\n        num_divisors *= (exponent + 1)\n        \n    return num_divisors"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(n: int) -> str:\n    \"\"\"Converts a non-negative decimal integer to its binary string representation.\"\"\"\n    if n == 0:\n        return \"0\"\n\n    bits = []\n    while n > 0:\n        bits.append(\"1\" if (n & 1) else \"0\")\n        n >>= 1\n    return \"\".join(reversed(bits))"}
{"task_id": "Mbpp/98", "solution": "from typing import Sequence, Union\n\ndef multiply_num(numbers: Sequence[Union[int, float]]) -> float:\n    \"\"\"\n    Multiplies all numbers in a sequence and divides the product by the sequence's length.\n    Non-numeric items or an empty sequence will raise standard Python exceptions.\n    \"\"\"\n    product = 1.0\n    for n in numbers:\n        product *= float(n)\n\n    length = len(numbers)\n    return product / float(length)"}
{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome strictly greater than the given integer n.\n    \"\"\"\n    s = str(n)\n    l = len(s)\n\n    def _build_palindrome(prefix: str, middle: str = '') -> str:\n        \"\"\"Helper to construct a palindrome string from its left half and optional middle digit.\"\"\"\n        return prefix + middle + prefix[::-1]\n\n    # Calculate the left half of the number string and the middle character (if any)\n    left_part = s[:l // 2]\n    middle_char = s[l // 2] if l % 2 == 1 else ''\n\n    # First candidate: mirror the left part (and middle) to create a palindrome\n    # Example: n=123 -> left=\"1\", middle=\"2\" -> p1_str=\"121\"\n    # Example: n=1991 -> left=\"19\", middle=\"\" -> p1_str=\"1991\"\n    p1_str = _build_palindrome(left_part, middle_char)\n\n    # Convert to int for comparison\n    p1_int = int(p1_str)\n\n    # If this candidate palindrome is strictly greater than n, it's the answer.\n    if p1_int > n:\n        return p1_int\n    \n    # If p1_int is not strictly greater than n (i.e., p1_int <= n),\n    # we need to \"increment the middle\" part of the number and then mirror.\n    # This involves incrementing the numeric value of the left part plus the middle digit.\n    \n    # The 'prefix to increment' is the left half plus the middle digit if length is odd.\n    # Example: s=\"12345\" -> prefix_to_inc_str=\"123\"\n    # Example: s=\"1234\" -> prefix_to_inc_str=\"12\"\n    prefix_to_inc_str = s[: (l + 1) // 2]\n    \n    # Increment its numeric value\n    incremented_prefix_int = int(prefix_to_inc_str) + 1\n    incremented_prefix_str = str(incremented_prefix_int)\n\n    # Check if incrementing caused the prefix to gain a digit (e.g., \"9\" -> \"10\", \"99\" -> \"100\")\n    # This typically happens when the number (or its relevant half) consists of all nines.\n    if len(incremented_prefix_str) > len(prefix_to_inc_str):\n        # In this special case, the next palindrome is '1' followed by (l-1) zeros, then '1'.\n        # Example: n=9 -> result=11 (1 + 0*0 + 1)\n        # Example: n=99 -> result=101 (1 + 0*1 + 1)\n        # Example: n=999 -> result=1001 (1 + 0*2 + 1)\n        return int('1' + '0' * (l - 1) + '1')\n    \n    # Normal case: The incremented prefix has the same length.\n    # Split the incremented prefix into its new left part and (optional) new middle character.\n    # Example: n=123 -> prefix_to_inc=\"12\", inc_prefix=\"13\".\n    # new_left_part = \"1\" (from \"13\"[:1]), new_middle_char = \"3\" (from \"13\"[1])\n    new_left_part = incremented_prefix_str[:l // 2]\n    new_middle_char = incremented_prefix_str[l // 2] if l % 2 == 1 else ''\n\n    # Construct the final palindrome from these new parts\n    p2_str = _build_palindrome(new_left_part, new_middle_char)\n    return int(p2_str)"}
{"task_id": "Mbpp/101", "solution": "from collections.abc import Sequence\nfrom typing import TypeVar\n\n# Define custom exceptions as per design\nclass KthError(Exception):\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\nclass InvalidInputError(KthError):\n    pass\n\nclass IndexOutOfBoundsError(KthError):\n    pass\n\n# Define generic type for array elements\nT = TypeVar(\"T\")\n\n# Define Data Transfer Objects (DTOs)\nclass KthRequest:\n    def __init__(self, array: Sequence[T], k: int) -> None:\n        self.array = array\n        self.k = k\n\nclass KthResponse:\n    def __init__(self, value: T) -> None:\n        self.value = value\n\n# Define KthValidator for input validation\nclass KthValidator:\n    def validate_array(self, array: Sequence) -> None:\n        \"\"\"Ensures the input array is a sequence.\"\"\"\n        if not isinstance(array, Sequence):\n            raise InvalidInputError(\"array must be a sequence\")\n\n    def validate_k(self, k: int, length: int) -> None:\n        \"\"\"Ensures k is an integer and within the valid 1-based index range.\"\"\"\n        if not isinstance(k, int):\n            raise InvalidInputError(\"k must be an integer\")\n        if k < 1 or k > length:\n            raise IndexOutOfBoundsError(f\"k={k} is outside the valid range [1, {length}] for an array of length {length}.\")\n\n# Define KthElementService for core business logic\nclass KthElementService:\n    def __init__(self) -> None:\n        pass\n\n    def get_kth_element(self, array: Sequence[T], k: int) -> T:\n        \"\"\"Retrieves the k-th element from the array using 1-based indexing.\"\"\"\n        index = k - 1  # Convert 1-based k to 0-based index\n        try:\n            return array[index]\n        except IndexError as e:\n            # Wrap built-in IndexError with a custom domain-specific error\n            raise IndexOutOfBoundsError(f\"Index access failed for k={k} (0-based index {index}). Array length is {len(array)}.\") from e\n\n# Define KthController to orchestrate validation and service calls\nclass KthController:\n    def __init__(self, service: KthElementService, validator: KthValidator) -> None:\n        self.service = service\n        self.validator = validator\n\n    def handle_get_kth(self, request: KthRequest) -> KthResponse:\n        \"\"\"Handles a request to find the k-th element, performing validation and calling the service.\"\"\"\n        self.validator.validate_array(request.array)\n        self.validator.validate_k(request.k, len(request.array))\n        value = self.service.get_kth_element(request.array, request.k)\n        return KthResponse(value)\n\n# Initialize global instances for the top-level kth_element function\n_service = KthElementService()\n_validator = KthValidator()\n_controller = KthController(_service, _validator)\n\ndef kth_element(array: Sequence[T], k: int) -> T:\n    \"\"\"\n    Finds the kth element in the given array using 1-based indexing.\n    This function delegates to a controller that handles input validation and element retrieval.\n    \"\"\"\n    req = KthRequest(array, k)\n    return _controller.handle_get_kth(req).value"}
{"task_id": "Mbpp/102", "solution": "def snake_to_camel(s: str) -> str:\n    \"\"\"\n    Converts a snake_case string to CamelCase (PascalCase).\n    Handles multiple underscores and non-alphabetic characters within segments.\n    \"\"\"\n    parts = [seg for seg in s.split(\"_\") if seg]\n    if not parts:\n        return \"\"\n    caps = [part[0].upper() + part[1:] for part in parts]\n    return \"\".join(caps)"}
{"task_id": "Mbpp/105", "solution": "def count(items: list) -> int:\n    \"\"\"Counts the number of True boolean values in the given list.\"\"\"\n    return sum(1 for item in items if item is True)"}
{"task_id": "Mbpp/103", "solution": "def eulerian_num(n: int, m: int) -> int:\n    \"\"\"Computes the Eulerian number a(n,m) using dynamic programming.\n    Assumes n and m are valid according to problem constraints.\n    \"\"\"\n    if n == 0:\n        return 1 if m == 0 else 0\n\n    # dp_row[k] will store a(current_n, k) values.\n    # Initialize for n=1: a(1,0)=1, and a(1,k)=0 for k>0.\n    dp_row = [0] * n\n    dp_row[0] = 1\n\n    # Iterate from current_n = 2 up to the target n.\n    # 'i' represents the current value of n we are calculating for.\n    for i in range(2, n + 1):\n        next_dp_row = [0] * i  # next_dp_row will store a(i, k) values.\n        # 'k' represents 'm' for a(i, k).\n        for k in range(i):\n            # Apply recurrence: a(n,m) = (n-m)*a(n-1,m-1) + (m+1)*a(n-1,m)\n            # (m+1)*a(n-1,m) term: (k+1)*a(i-1,k)\n            # a(i-1,k) is dp_row[k]. This is valid if k < i-1 (i.e., m < n-1 in previous row).\n            if k < i - 1:\n                next_dp_row[k] += (k + 1) * dp_row[k]\n\n            # (n-m)*a(n-1,m-1) term: (i-k)*a(i-1,k-1)\n            # a(i-1,k-1) is dp_row[k-1]. This is valid if k-1 >= 0 (i.e., m-1 >= 0 in previous row).\n            if k > 0:\n                next_dp_row[k] += (i - k) * dp_row[k - 1]\n        dp_row = next_dp_row  # The calculated row becomes the previous row for the next iteration.\n\n    # After iterating up to 'n', dp_row contains a(n, k) values.\n    return dp_row[m]"}
{"task_id": "Mbpp/104", "solution": "def sort_sublists(sublists):\n    \"\"\"\n    Sorts each sublist of strings in a given list of lists lexicographically.\n    Each sublist is sorted in ascending order, preserving the top-level order.\n    \"\"\"\n    return [sorted(sublist) for sublist in sublists]"}
{"task_id": "Mbpp/109", "solution": "def odd_Equivalent(s: str, k: int) -> int:\n    \"\"\"\n    Counts the number of odd-valued rotations among the first k left-cyclic rotations of a binary string.\n    A rotation is considered odd if its least significant bit (rightmost character) is '1'.\n    \"\"\"\n    n = len(s)\n    if k == 0:\n        return 0\n\n    # Calculate the number of odd rotations in one full cycle of n rotations.\n    odd_in_full_cycle = 0\n    for i in range(n):\n        # Generate the i-th left cyclic rotation\n        rotated_s = s[i:] + s[:i]\n        # Check if the rotated string represents an odd number (last digit is '1')\n        if rotated_s[-1] == '1':\n            odd_in_full_cycle += 1\n\n    # Calculate how many full cycles are covered by k rotations\n    full_cycles = k // n\n    # Calculate the remaining rotations that do not form a full cycle\n    remainder = k % n\n\n    # Calculate the number of odd rotations in the remainder part\n    odd_in_remainder = 0\n    for i in range(remainder):\n        # Generate the i-th left cyclic rotation for the remainder\n        rotated_s = s[i:] + s[:i]\n        if rotated_s[-1] == '1':\n            odd_in_remainder += 1\n\n    # Total count is (full cycles * odd count per cycle) + odd count in remainder\n    return full_cycles * odd_in_full_cycle + odd_in_remainder"}
{"task_id": "Mbpp/106", "solution": "from typing import Any, Iterable, Tuple, Optional\n\ndef add_lists(list_items: list, base_tuple: tuple) -> tuple:\n    \"\"\"Appends elements of a list to a tuple, returning a new tuple.\n\n    This function defines all necessary helper classes inline to satisfy\n    the constraint of not calling external helpers.\n    \"\"\"\n\n    class InvalidInputError(Exception):\n        \"\"\"Exception raised for invalid input parameters.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    class AppendError(Exception):\n        \"\"\"Exception raised for errors during the append operation.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    class AppendRequest:\n        \"\"\"Data Transfer Object for an append request.\"\"\"\n        def __init__(self, list_items: list[Any], base_tuple: Tuple[Any, ...]) -> None:\n            self.list_items = list_items\n            self.base_tuple = base_tuple\n\n        def validate(self) -> None:\n            \"\"\"Validates that base_tuple is a tuple and list_items is a list.\"\"\"\n            if not isinstance(self.base_tuple, tuple):\n                raise InvalidInputError(\"base_tuple must be a tuple\")\n            if not isinstance(self.list_items, list):\n                raise InvalidInputError(\"list_items must be a list\")\n\n    class ListToTupleAdapter:\n        \"\"\"Adapter for converting iterables to tuples with safeguards.\"\"\"\n        DEFAULT_MAX_LEN = 100_000\n\n        def convert(self, list_items: Iterable[Any]) -> Tuple[Any, ...]:\n            \"\"\"Converts an iterable to a tuple, checking for type and size.\"\"\"\n            try:\n                lst = list(list_items)\n            except TypeError:\n                raise InvalidInputError(\"list_items not iterable\")\n            if len(lst) > self.DEFAULT_MAX_LEN:\n                raise AppendError(\"list_items too large\")\n            return tuple(lst)\n\n        def safe_convert(self, list_items: Any) -> Tuple[Any, ...]:\n            \"\"\"Converts input to a tuple, handling None values gracefully.\"\"\"\n            if list_items is None:\n                return tuple()\n            return self.convert(list_items)\n\n    class TupleRepository:\n        \"\"\"Optional repository for logging append operations.\"\"\"\n        def __init__(self, file_path: str) -> None:\n            self._file_path = file_path\n\n        def log_operation(self, base_tuple: Tuple[Any, ...], list_items: list[Any], result: Tuple[Any, ...]) -> None:\n            \"\"\"Logs an operation (implementation omitted for inline context).\"\"\"\n            pass # Logging is optional and not active when repository=None.\n\n    class AddListService:\n        \"\"\"Core business logic for appending list items to a tuple.\"\"\"\n        def __init__(self, adapter: ListToTupleAdapter, repository: Optional[TupleRepository] = None) -> None:\n            self.adapter = adapter\n            self.repository = repository\n\n        def add(self, request: AppendRequest) -> Tuple[Any, ...]:\n            \"\"\"Executes the append operation, including validation and optional logging.\"\"\"\n            request.validate()\n            converted = self.adapter.safe_convert(request.list_items)\n            result = request.base_tuple + converted\n            if self.repository:\n                try:\n                    self.repository.log_operation(request.base_tuple, request.list_items, result)\n                except Exception:\n                    pass # Logging failures should not disrupt the primary operation.\n            return result\n\n    class APIController:\n        \"\"\"API layer that bridges callers to the service.\"\"\"\n        def __init__(self, service: AddListService) -> None:\n            self.service = service\n\n        def add_list(self, list_items: list[Any], base_tuple: Tuple[Any, ...]) -> Tuple[Any, ...]:\n            \"\"\"Constructs a request and delegates to the service for appending.\"\"\"\n            request = AppendRequest(list_items, base_tuple)\n            return self.service.add(request)\n\n    adapter = ListToTupleAdapter()\n    service = AddListService(adapter, repository=None)\n    ctrl = APIController(service)\n    return ctrl.add_list(list_items, base_tuple)"}
{"task_id": "Mbpp/108", "solution": "import uuid\nimport datetime\nfrom typing import Sequence, List, Optional, Any\n\nclass MergeError(Exception):\n    \"\"\"Exception raised for merge operation errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nMAX_LIST_LENGTH: int = 100000\n\nclass Validator:\n    \"\"\"Validates input lists according to business rules.\"\"\"\n    def validate_lists(self, l1: Sequence[Any], l2: Sequence[Any], l3: Sequence[Any]) -> None:\n        for idx, l in enumerate((l1, l2, l3), start=1):\n            if not hasattr(l, \"__iter__\"):\n                raise MergeError(f\"list{idx} is not iterable\")\n            if len(l) > MAX_LIST_LENGTH:\n                raise MergeError(f\"list{idx} exceeds max length {MAX_LIST_LENGTH}\")\n            for i, item in enumerate(l):\n                if not isinstance(item, int):\n                    raise MergeError(f\"list{idx}[{i}] is not int\")\n\nclass Sorter:\n    \"\"\"Provides sorting and merging algorithms.\"\"\"\n    def merge_and_sort(self, l1: Sequence[int], l2: Sequence[int], l3: Sequence[int]) -> List[int]:\n        \"\"\"Merges three lists and returns a single sorted list.\"\"\"\n        return sorted(list(l1) + list(l2) + list(l3))\n\nclass MergeResult:\n    \"\"\"Data transfer object for merge operation results.\"\"\"\n    def __init__(self, result: List[int], record_id: Optional[str] = None) -> None:\n        self.result = result\n        self.record_id = record_id\n\nclass MergeCacheRepository:\n    \"\"\"In-memory repository for storing merge operation records.\"\"\"\n    def __init__(self):\n        self._store: dict[str, dict[str, Any]] = {}\n\n    def save(self, inputs: List[List[int]], result: List[int]) -> str:\n        \"\"\"Saves a merge record and returns its ID.\"\"\"\n        record_id = str(uuid.uuid4())\n        rec = {\"id\": record_id, \"inputs\": inputs, \"result\": result, \"created_at\": datetime.datetime.utcnow().isoformat()}\n        self._store[record_id] = rec\n        return record_id\n\n    def get(self, record_id: str) -> Optional[dict[str, Any]]:\n        \"\"\"Retrieves a merge record by its ID.\"\"\"\n        return self._store.get(record_id)\n\n    def all(self) -> List[dict[str, Any]]:\n        \"\"\"Returns all stored merge records.\"\"\"\n        return list(self._store.values())\n\nclass MergeService:\n    \"\"\"Orchestrates validation, sorting, and persistence of merge operations.\"\"\"\n    def __init__(self, repository: MergeCacheRepository, sorter: Sorter, validator: Validator = None):\n        self._repo = repository\n        self._sorter = sorter\n        self._validator = validator or Validator()\n\n    def merge(self, list1: Sequence[int], list2: Sequence[int], list3: Sequence[int]) -> MergeResult:\n        \"\"\"Performs the merge operation including validation and persistence.\"\"\"\n        self._validator.validate_lists(list1, list2, list3)\n        sorted_list = self._sorter.merge_and_sort(list1, list2, list3)\n        record_id = None\n        try:\n            record_id = self._repo.save([list(list1), list(list2), list(list3)], sorted_list)\n        except Exception:\n            # Persistence is best-effort, log the error but do not re-raise\n            pass # In a real app, this would log to a logger\n        return MergeResult(result=sorted_list, record_id=record_id)\n\nclass MergeController:\n    \"\"\"Handles requests for merging lists and delegates to the service.\"\"\"\n    def __init__(self, service: MergeService):\n        self.service = service\n\n    def handle_merge(self, list1: Sequence[int], list2: Sequence[int], list3: Sequence[int]) -> List[int]:\n        \"\"\"Calls the merge service and returns the sorted list result.\"\"\"\n        result = self.service.merge(list1, list2, list3)\n        return result.result\n\n_repo = MergeCacheRepository()\n_sorter = Sorter()\n_validator = Validator()\n_service = MergeService(repository=_repo, sorter=_sorter, validator=_validator)\n_controller = MergeController(service=_service)\n\ndef merge_sorted_list(list1: Sequence[int], list2: Sequence[int], list3: Sequence[int]) -> List[int]:\n    \"\"\"\n    Merges three input lists into a single sorted list, preserving duplicates.\n    Delegates to an internal controller for validation, merging, and persistence.\n    \"\"\"\n    return _controller.handle_merge(list1, list2, list3)"}
{"task_id": "Mbpp/113", "solution": "import re\n\ndef check_integer(text: str) -> bool:\n    \"\"\"Checks if a string represents an integer, ignoring leading/trailing whitespace.\"\"\"\n    trimmed_text = text.strip()\n    return bool(re.fullmatch(r'^[+-]?\\d+$', trimmed_text))"}
{"task_id": "Mbpp/116", "solution": "def tuple_to_int(t: tuple[int, ...]) -> int:\n    \"\"\"\n    Converts a tuple of positive integers into a single integer by concatenation.\n    Assumes input validation (non-empty tuple, positive integers) has already occurred.\n    \"\"\"\n    return int(\"\".join(str(x) for x in t))"}
{"task_id": "Mbpp/111", "solution": "from typing import Iterable, List, Any\nimport json\n\nclass InvalidInputError(Exception):\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\n\nclass NestedListsInput:\n    def __init__(self, lists: Iterable[Iterable[Any]]) -> None:\n        self.lists = [list(sub_list) for sub_list in lists]\n\n    def as_list(self) -> List[List[Any]]:\n        return self.lists\n\nclass Validator:\n    MAX_SUBLISTS: int = 10_000\n    MAX_TOTAL_ELEMENTS: int = 1_000_000\n\n    def __init__(self, max_sublists: int = None, max_total_elements: int = None) -> None:\n        self._max_sublists = max_sublists if max_sublists is not None else self.MAX_SUBLISTS\n        self._max_total_elements = max_total_elements if max_total_elements is not None else self.MAX_TOTAL_ELEMENTS\n\n    def ensure_hashable(self, item: Any) -> Any:\n        try:\n            hash(item)\n            return item\n        except TypeError:\n            if isinstance(item, list):\n                return tuple(self.ensure_hashable(x) for x in item)\n            if isinstance(item, dict):\n                return frozenset((self.ensure_hashable(k), self.ensure_hashable(v)) for k, v in item.items())\n            raise InvalidInputError(f\"Unhashable and unconvertible item: {item!r}\")\n\n    def validate_nested_lists(self, lists: Iterable[Iterable[Any]]) -> List[List[Any]]:\n        \"\"\"Validates the input structure and converts elements to hashable types.\"\"\"\n        if not isinstance(lists, Iterable):\n            raise InvalidInputError(\"Input must be an iterable of iterables.\")\n        \n        normalized_lists = []\n        total_elements = 0\n        \n        for i, sub_list_iterable in enumerate(lists):\n            if i >= self._max_sublists:\n                raise InvalidInputError(f\"Input exceeds maximum allowed sub-lists ({self._max_sublists}).\")\n\n            if not isinstance(sub_list_iterable, Iterable):\n                raise InvalidInputError(f\"Sub-list at index {i} is not an iterable.\")\n            \n            normalized_sub_list = []\n            for item in sub_list_iterable:\n                if total_elements >= self._max_total_elements:\n                    raise InvalidInputError(f\"Input exceeds maximum allowed total elements ({self._max_total_elements}).\")\n                normalized_sub_list.append(self.ensure_hashable(item))\n                total_elements += 1\n            normalized_lists.append(normalized_sub_list)\n        \n        return normalized_lists\n\nclass CommonElementsService:\n    def __init__(self, validator: Validator) -> None:\n        self._validator = validator\n\n    def find_common_elements(self, lists: Iterable[Iterable[Any]]) -> List[Any]:\n        \"\"\"Finds elements common to all nested lists after validating and normalizing input.\"\"\"\n        normalized = self._validator.validate_nested_lists(lists)\n        if not normalized:\n            return []\n        \n        it = iter(normalized)\n        common_elements_set = set(next(it))\n        \n        for sub_list in it:\n            common_elements_set &= set(sub_list)\n            if not common_elements_set:\n                break\n                \n        return list(common_elements_set)\n\nclass ListRepository:\n    def from_json_file(self, file_path: str) -> NestedListsInput:\n        \"\"\"Loads nested lists from a JSON file.\"\"\"\n        try:\n            with open(file_path, 'r') as f:\n                data = json.load(f)\n            if not isinstance(data, list) or not all(isinstance(x, list) for x in data):\n                raise InvalidInputError(\"JSON file must contain a list of lists.\")\n            return NestedListsInput(data)\n        except FileNotFoundError:\n            raise InvalidInputError(f\"File not found: {file_path}\")\n        except json.JSONDecodeError:\n            raise InvalidInputError(f\"Invalid JSON in file: {file_path}\")\n        except Exception as e:\n            raise InvalidInputError(f\"Error reading JSON file: {e}\")\n\n    def from_inline(self, lists_literal: Any) -> NestedListsInput:\n        \"\"\"Loads nested lists from an inline literal.\"\"\"\n        if not isinstance(lists_literal, list) or not all(isinstance(x, list) for x in lists_literal):\n            raise InvalidInputError(\"Inline literal must be a list of lists.\")\n        return NestedListsInput(lists_literal)\n\nclass CommonElementsController:\n    def __init__(self, service: CommonElementsService, repo: ListRepository) -> None:\n        self._service = service\n        self._repo = repo\n\n    def common_in_nested_lists(self, lists: Iterable[Iterable[Any]]) -> List[Any]:\n        \"\"\"Public API to find common elements from an iterable of iterables.\"\"\"\n        return self._service.find_common_elements(lists)\n\n    def common_in_nested_lists_from_file(self, file_path: str) -> List[Any]:\n        \"\"\"Loads lists from a JSON file and finds common elements.\"\"\"\n        nested_lists_input = self._repo.from_json_file(file_path)\n        return self._service.find_common_elements(nested_lists_input.as_list())\n\n_validator = Validator()\n_service = CommonElementsService(_validator)\n_repo = ListRepository()\n_controller = CommonElementsController(_service, _repo)\n\ndef common_in_nested_lists(lists: Iterable[Iterable[Any]]) -> List[Any]:\n    \"\"\"\n    Finds the common elements in given nested lists.\n    assert set(common_in_nested_lists([[12, 18, 23, 25, 45], [7, 12, 18, 24, 28], [1, 5, 8, 12, 15, 16, 18]]))==set([18, 12])\n    \"\"\"\n    return _controller.common_in_nested_lists(lists)"}
{"task_id": "Mbpp/119", "solution": "def search(nums: list) -> int:\n    \"\"\"\n    Finds the element that appears only once in a sorted array where every other element appears twice.\n    Assumes the input array is sorted and contains exactly one unique element.\n    \"\"\"\n    low, high = 0, len(nums) - 1\n\n    while low < high:\n        mid = (low + high) // 2\n\n        # Adjust mid to be the start of a potential pair\n        # If mid is odd, make it even to compare with mid+1 or mid-1 properly\n        if mid % 2 == 1:\n            mid -= 1\n\n        # Check if the pair at mid and mid+1 are identical\n        if nums[mid] == nums[mid + 1]:\n            # If they are identical, the single element must be to the right\n            # Skip both elements of the pair\n            low = mid + 2\n        else:\n            # If they are different, the single element must be at or before mid\n            high = mid\n    \n    # When low == high, this index points to the single element\n    return nums[low]"}
{"task_id": "Mbpp/118", "solution": "from typing import List, Optional, Any\n\nclass SplitError(Exception):\n    \"\"\"Custom exception for string splitting and validation errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n    def __str__(self) -> str:\n        return self.message\n\nclass Validator:\n    \"\"\"Provides utility methods for input validation and token filtering.\"\"\"\n    @staticmethod\n    def validate_input(text: Any) -> None:\n        # Per explicit prompt constraint, no type checks or exceptions are added here.\n        pass\n\n    @staticmethod\n    def filter_empty(tokens: List[str], keep_empty: bool) -> List[str]:\n        if keep_empty:\n            return tokens\n        return [t for t in tokens if t != \"\"]\n\nclass StringSplitter:\n    \"\"\"Implements the core logic for splitting strings on space characters.\"\"\"\n    def __init__(self, validator: Optional[Validator] = None) -> None:\n        self._validator = validator or Validator()\n\n    def split_on_space(self, text: str, keep_empty: bool = False) -> List[str]:\n        self._validator.validate_input(text)\n        tokens = self._raw_split(text)\n        return self._validator.filter_empty(tokens, keep_empty)\n\n    def _raw_split(self, text: str) -> List[str]:\n        return text.split(\" \")\n\ndef string_to_list(text: str, keep_empty: bool = False) -> List[str]:\n    \"\"\"Converts a string to a list of strings by splitting on the space character.\n\n    Filters out empty tokens by default unless `keep_empty` is True.\n    \"\"\"\n    splitter = StringSplitter()\n    return splitter.split_on_space(text, keep_empty=keep_empty)"}
{"task_id": "Mbpp/125", "solution": "def find_length(s: str) -> int:\n    \"\"\"\n    Finds the maximum difference (count of 0s - count of 1s) in any contiguous substring.\n    Uses Kadane's algorithm by mapping '0' to +1 and '1' to -1.\n    \"\"\"\n    max_so_far = 0\n    current_max = 0\n\n    for char in s:\n        value = 1 if char == '0' else -1\n        current_max += value\n        if current_max < 0:\n            current_max = 0\n        max_so_far = max(max_so_far, current_max)\n            \n    return max_so_far"}
{"task_id": "Mbpp/124", "solution": "import math\n\ndef angle_complex(arg1, arg2=None):\n    \"\"\"\n    Computes the angle (argument) of a complex number in radians.\n    It accepts either a single complex number or two numeric arguments (real, imag).\n    \"\"\"\n    real_part = 0.0\n    imag_part = 0.0\n\n    if arg2 is None:\n        # Assume arg1 is a complex number or an object with real/imag attributes\n        real_part = float(arg1.real)\n        imag_part = float(arg1.imag)\n    else:\n        # Assume arg1 is the real part, and arg2 is the imaginary part\n        real_part = float(arg1)\n        try:\n            # If arg2 is a complex number (e.g., 1j), extract its imaginary component\n            imag_part = float(arg2.imag)\n        except AttributeError:\n            # Otherwise, assume arg2 is a direct numeric imaginary value\n            imag_part = float(arg2)\n\n    # Business rule: For 0+0j, the angle is defined as 0.0\n    if real_part == 0.0 and imag_part == 0.0:\n        return 0.0\n    \n    return math.atan2(imag_part, real_part)"}
{"task_id": "Mbpp/126", "solution": "import math\n\ndef sum_common_divisors(a, b):\n    # Use absolute values for calculations as specified.\n    a_abs = abs(a)\n    b_abs = abs(b)\n\n    # Compute the greatest common divisor of the absolute values.\n    gcd_val = math.gcd(a_abs, b_abs)\n\n    # If the GCD is zero (e.g., both inputs were zero), the sum of common divisors is zero.\n    if gcd_val == 0:\n        return 0\n\n    total_sum = 0\n    # Iterate up to the integer square root of the GCD to find its divisors efficiently.\n    limit = int(math.isqrt(gcd_val))\n\n    for d in range(1, limit + 1):\n        if gcd_val % d == 0:\n            total_sum += d\n            other_divisor = gcd_val // d\n            if other_divisor != d:\n                total_sum += other_divisor\n\n    return total_sum"}
