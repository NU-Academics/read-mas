{"task_id": "Mbpp/65", "solution": "from dataclasses import dataclass\nfrom typing import Any, Iterator, Optional\n\n\n@dataclass\nclass SumResult:\n    total: float\n    count: int\n\n    def to_dict(self) -> dict:\n        return {\"total\": self.total, \"count\": self.count}\n\n\nclass InvalidElementError(Exception):\n    def __init__(self, element: Any, message: Optional[str] = None) -> None:\n        self.element = element\n        self.message = message or f\"Invalid element encountered: {repr(element)}\"\n        super().__init__(self.message)\n\n\nclass ListFlattener:\n    SUPPORTED_NUMERIC = (int, float)\n\n    def __init__(self) -> None:\n        self._visited_ids = set()\n\n    def _is_number(self, obj: Any) -> bool:\n        \"\"\"Checks if an object is a numeric type (int or float, but not bool).\"\"\"\n        return isinstance(obj, self.SUPPORTED_NUMERIC) and not isinstance(obj, bool)\n\n    def _is_iterable(self, obj: Any) -> bool:\n        \"\"\"Checks if an object is an iterable, excluding strings and bytes.\"\"\"\n        return hasattr(obj, '__iter__') and not isinstance(obj, (str, bytes))\n\n    def flatten(self, items: Any) -> Iterator[float]:\n        \"\"\"Flattens nested iterables and yields numeric elements as floats.\"\"\"\n        if self._is_number(items):\n            yield float(items)\n            return\n        \n        if not self._is_iterable(items):\n            raise InvalidElementError(items)\n        \n        obj_id = id(items)\n        if obj_id in self._visited_ids:\n            raise InvalidElementError(items, \"Cyclic structure detected\")\n        \n        self._visited_ids.add(obj_id)\n        \n        for elem in items:\n            if self._is_number(elem):\n                yield float(elem)\n            elif self._is_iterable(elem):\n                yield from self.flatten(elem)\n            else:\n                raise InvalidElementError(elem)\n        \n        self._visited_ids.remove(obj_id)\n\n\nclass RecursiveSumService:\n    def __init__(self, flattener: Optional[ListFlattener] = None) -> None:\n        self.flattener = flattener or ListFlattener()\n\n    def _accumulate(self, nums: Iterator[float]) -> SumResult:\n        \"\"\"Sums numbers from an iterator and counts them.\"\"\"\n        total = 0.0\n        count = 0\n        for n in nums:\n            total += n\n            count += 1\n        return SumResult(total=total, count=count)\n\n    def recursive_list_sum(self, items: Any) -> SumResult:\n        \"\"\"Computes the sum and count of numeric elements in nested items.\"\"\"\n        nums = self.flattener.flatten(items)\n        return self._accumulate(nums)\n\n\ndef recursive_list_sum(items: Any) -> float:\n    \"\"\"Flattens a list and sums all of its numeric elements.\"\"\"\n    svc = RecursiveSumService()\n    result = svc.recursive_list_sum(items)\n    return float(result.total)"}
