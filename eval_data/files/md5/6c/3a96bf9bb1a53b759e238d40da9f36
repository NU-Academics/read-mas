{"task_id": "Mbpp/286", "solution": "from typing import List\n\n# Helper function for Kadane's algorithm.\ndef _kadane_algorithm(arr: List[int]) -> int:\n    if not arr:\n        return 0\n    max_ending_here = arr[0]\n    max_so_far = arr[0]\n    for x in arr[1:]:\n        max_ending_here = max(x, max_ending_here + x)\n        max_so_far = max(max_so_far, max_ending_here)\n    return max_so_far\n\n# Helper function to run Kadane's algorithm on two conceptual concatenations of the array.\ndef _kadane_on_two_concatenations(arr: List[int]) -> int:\n    if not arr:\n        return 0\n    n = len(arr)\n    max_ending_here = arr[0]\n    max_so_far = arr[0]\n    for i in range(1, 2 * n):\n        x = arr[i % n]\n        max_ending_here = max(x, max_ending_here + x)\n        max_so_far = max(max_so_far, max_ending_here)\n    return max_so_far\n\n# Helper function to calculate the total sum of the array.\ndef _calculate_total_sum(arr: List[int]) -> int:\n    return sum(arr)\n\ndef max_sub_array_sum_repeated(nums: List[int], n: int, k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous subarray in an array formed by repeating\n    the given array `k` times. The parameter `n` is for design context but not used here.\n    \"\"\"\n    if not nums:\n        return 0\n\n    if k == 1:\n        return _kadane_algorithm(nums)\n\n    max_sum_two_copies = _kadane_on_two_concatenations(nums)\n    total_sum_single_copy = _calculate_total_sum(nums)\n\n    if total_sum_single_copy > 0 and k > 2:\n        # If the total sum is positive and k is greater than 2,\n        # we can add (k-2) times the total sum to the max sum of two copies.\n        return max_sum_two_copies + (k - 2) * total_sum_single_copy\n    else:\n        # If total sum is non-positive or k is 2, the maximum sum will be\n        # found within the first two concatenations.\n        return max_sum_two_copies"}
