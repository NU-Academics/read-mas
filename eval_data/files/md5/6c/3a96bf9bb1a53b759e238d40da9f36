{"task_id": "Mbpp/68", "solution": "def is_Monotonic(arr):\n    \"\"\"Checks if the given array is monotonic (non-decreasing or non-increasing).\"\"\"\n    if len(arr) < 2:\n        return True\n\n    non_decreasing = True\n    non_increasing = True\n\n    for i in range(len(arr) - 1):\n        if arr[i] < arr[i + 1]:\n            non_increasing = False\n        if arr[i] > arr[i + 1]:\n            non_decreasing = False\n        \n        # If it's neither non-decreasing nor non-increasing, it's not monotonic\n        if not non_decreasing and not non_increasing:\n            return False\n\n    return True"}
{"task_id": "Mbpp/67", "solution": "class InvalidInputError(Exception):\n    def __init__(self, message: str):\n        self.message = message\n    def __str__(self) -> str:\n        return self.message\n\ndef validate_non_negative_int(n):\n    if isinstance(n, int):\n        if n < 0:\n            raise InvalidInputError(\"n must be non-negative\")\n        return n\n    if isinstance(n, float) and n.is_integer():\n        n_int = int(n)\n        if n_int < 0:\n            raise InvalidInputError(\"n must be non-negative\")\n        return n_int\n    raise InvalidInputError(\"n must be an integer >= 0\")\n\nfrom typing import Iterable\ndef sum_bigints(values: Iterable[int]) -> int:\n    return sum(values)\n\nclass StirlingRepository:\n    def __init__(self, max_cache_rows: int = 1000):\n        self._row_cache: dict[int, list[int]] = {0: [1]}\n        self.MAX_CACHE_ROWS = max_cache_rows\n        self._highest_n_cached = 0\n\n    def compute_stirling_row(self, n: int) -> list[int]:\n        n = validate_non_negative_int(n)\n\n        if n in self._row_cache:\n            return self._row_cache[n]\n\n        for i in range(self._highest_n_cached + 1, n + 1):\n            current_row = [0] * (i + 1)\n            if i == 0: # S(0,0) = 1, handled by initial cache\n                pass\n            else:\n                current_row[0] = 0\n                current_row[i] = 1\n\n            prev_row = self._row_cache[i - 1]\n\n            for k in range(1, i):\n                current_row[k] = k * prev_row[k] + prev_row[k-1]\n            \n            self._row_cache[i] = current_row\n            self._highest_n_cached = i\n            \n        return self._row_cache[n]\n\nclass BellCalculator:\n    def __init__(self, stirling_repo: StirlingRepository=None):\n        self.stirling_repo = stirling_repo or StirlingRepository()\n\n    def bell_number(self, n) -> int:\n        n_validated = validate_non_negative_int(n)\n        row = self.stirling_repo.compute_stirling_row(n_validated)\n        return sum_bigints(row)\n\ndef bell_number(n):\n    calc = BellCalculator()\n    return calc.bell_number(n)"}
{"task_id": "Mbpp/70", "solution": "def get_equal(items: Sequence[Sequence[Any]]) -> bool:\n    \"\"\"\n    Checks if all given tuples have equal length.\n    Returns True if the collection is empty.\n    \"\"\"\n    if not items:\n        return True\n\n    first_length = len(items[0])\n    for item in items:\n        if len(item) != first_length:\n            return False\n    return True"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list, sub_list):\n    \"\"\"\n    Checks if a sub_list is a contiguous subsequence of main_list.\n    \"\"\"\n    def _sliding_window(seq, n):\n        \"\"\"Yields contiguous windows of length n from a sequence.\"\"\"\n        if n <= 0:\n            return\n        for i in range(len(seq) - n + 1):\n            yield seq[i:i + n]\n\n    if not sub_list:\n        return True\n    if len(sub_list) > len(main_list):\n        return False\n\n    for window in _sliding_window(main_list, len(sub_list)):\n        if window == sub_list:\n            return True\n    return False"}
{"task_id": "Mbpp/71", "solution": "def comb_sort(items: list) -> list:\n    \"\"\"\n    Sorts a list of elements using the Comb Sort algorithm.\n    Returns a new sorted list without modifying the original.\n    \"\"\"\n    n = len(items)\n\n    # Return a copy if the list is empty or has one element, as it's already sorted.\n    if n <= 1:\n        return list(items)\n\n    # Create a shallow copy to avoid modifying the original list\n    arr = list(items)\n\n    SHRINK_FACTOR = 1.3\n    gap = n\n    swapped = True  # Flag to track if any swaps occurred in a pass\n\n    while gap > 1 or swapped:\n        # Calculate the next gap value\n        gap = int(gap / SHRINK_FACTOR)\n        if gap < 1:\n            gap = 1\n\n        swapped = False  # Reset swapped flag for the current pass\n\n        # Perform a single pass of bubble sort with the current gap\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True\n\n    return arr"}
