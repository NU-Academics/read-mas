{"task_id": "Mbpp/409", "solution": "def min_product_tuple(pairs: Iterable[Tuple[Union[int, float], Union[int, float]]]) -> float:\n    \"\"\"\n    Calculates the minimum product from pairs of tuples within a given list.\n    Validates input and handles edge cases like empty lists or invalid pairs according to design specifications.\n    \"\"\"\n    from typing import Union, Iterable, Tuple, Iterator, Optional\n\n    # --- 1. Define Exceptions ---\n    class MinProductError(Exception):\n        \"\"\"Base exception for min_product_tuple operations.\"\"\"\n        def __init__(self, message: str = \"\") -> None:\n            self.message = message\n            super().__init__(self.message)\n\n    class InvalidInputError(MinProductError):\n        \"\"\"Raised when the top-level input is not a valid iterable.\"\"\"\n        pass\n\n    class EmptyInputError(MinProductError):\n        \"\"\"Raised when the input iterable contains no valid pairs.\"\"\"\n        pass\n\n    class PairValidationError(MinProductError):\n        \"\"\"Raised when an individual item is not a valid 2-element numeric pair.\"\"\"\n        pass\n\n    # --- 2. Define Model (Pair) ---\n    Number = Union[int, float]\n\n    class Pair:\n        def __init__(self, a: float, b: float) -> None:\n            self._a: float = a\n            self._b: float = b\n\n        def a(self) -> float:\n            return self._a\n\n        def b(self) -> float:\n            return self._b\n\n        def product(self) -> float:\n            return self._a * self._b\n\n    # --- 3. Define Utilities (Validator) ---\n    class Validator:\n        def is_number(self, x: object) -> bool:\n            \"\"\"Checks if an object is a number (int or float) and not a boolean.\"\"\"\n            return isinstance(x, (int, float)) and not isinstance(x, bool)\n\n        def to_number(self, x: object) -> float:\n            \"\"\"Converts an object to a float, raising an error if it's not a valid number.\"\"\"\n            if not self.is_number(x):\n                raise PairValidationError(f\"Invalid numeric value in pair: {x!r}\")\n            return float(x)\n\n        def validate_and_normalize_pair(self, item: object) -> Tuple[float, float]:\n            \"\"\"Validates if an item is a 2-length sequence of numbers and normalizes them to floats.\"\"\"\n            if not hasattr(item, '__len__') or len(item) != 2:\n                raise PairValidationError(f\"Each pair must be a sequence of length 2, but got: {item!r}\")\n            \n            try:\n                a, b = item[0], item[1]\n            except (TypeError, IndexError):\n                raise PairValidationError(f\"Could not access elements of pair as sequence: {item!r}\")\n\n            return self.to_number(a), self.to_number(b)\n\n    # --- 4. Define Repository (IterableRepository) ---\n    class IterableRepository:\n        def to_pairs(self, iterable: Iterable[object], validator: Validator) -> Iterator[Pair]:\n            \"\"\"Converts an iterable of raw items into an iterator of validated Pair objects.\"\"\"\n            if not hasattr(iterable, '__iter__'):\n                raise InvalidInputError(\"Input for min_product_tuple must be an iterable.\")\n            \n            for item in iterable:\n                a, b = validator.validate_and_normalize_pair(item)\n                yield Pair(a, b)\n\n    # --- 5. Define Service (MinProductService) ---\n    class MinProductService:\n        def __init__(self, repository: IterableRepository, validator: Validator) -> None:\n            self._repository = repository\n            self._validator = validator\n\n        def min_product(self, pairs_raw_input: Iterable[object]) -> float:\n            \"\"\"Finds the minimum product from an iterable of raw input pairs.\"\"\"\n            iterator = self._repository.to_pairs(pairs_raw_input, self._validator)\n            try:\n                return self._compute_min(iterator)\n            except StopIteration:\n                # This catches if the iterator was empty from the start or exhausted by validate_and_normalize_pair\n                raise EmptyInputError(\"The input iterable contains no valid pairs or all pairs were invalid.\")\n\n        def _compute_min(self, pairs_iter: Iterator[Pair]) -> float:\n            \"\"\"Helper to iterate through Pair objects and compute the minimum product.\"\"\"\n            current_min: Optional[float] = None\n            \n            # Initialize current_min with the first product to avoid issues with initial `None` comparisons\n            try:\n                first_pair = next(pairs_iter)\n                current_min = first_pair.product()\n            except StopIteration:\n                # If no elements, re-raise StopIteration for the calling method to catch as EmptyInputError\n                raise \n\n            for pair in pairs_iter:\n                prod = pair.product()\n                if prod < current_min: # current_min is guaranteed to be a float here\n                    current_min = prod\n            \n            # This check acts as a safeguard; ideally, it should not be reached if the\n            # initial StopIteration check in `min_product` is robust.\n            if current_min is None:\n                raise EmptyInputError(\"No valid pairs were processed to find a minimum product.\")\n                 \n            return current_min\n\n    # --- 6. Instantiate and Execute (Controller logic as per design) ---\n    # As per design, the module-level function `min_product_tuple`\n    # creates default instances of Validator, IterableRepository, and MinProductService.\n    _default_validator = Validator()\n    _default_repository = IterableRepository()\n    _default_service = MinProductService(_default_repository, _default_validator)\n\n    return _default_service.min_product(pairs)"}
