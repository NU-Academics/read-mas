{"task_id": "Mbpp/462", "solution": "def combinations_list(items: list) -> list:\n    \"\"\"\n    Finds all possible combinations (subsets) of elements from a given list\n    using a bitmask approach to ensure deterministic ordering.\n    \"\"\"\n    n = len(items)\n    result = []\n    for i in range(1 << n):  # Iterate from 0 to 2^n - 1\n        current_combination = []\n        # Construct combination by checking bits from highest index to lowest\n        for j in range(n - 1, -1, -1):\n            if (i >> j) & 1:  # If the j-th bit is set\n                current_combination.append(items[j])\n        result.append(current_combination)\n    return result"}
{"task_id": "Mbpp/468", "solution": "def max_product(arr: list[int]) -> int:\n    \"\"\"\n    Finds the maximum product formed by multiplying numbers of a strictly increasing subsequence.\n    The algorithm uses dynamic programming with O(n^2) time complexity and O(n) space.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return 0\n\n    # dp[i] stores the maximum product of a strictly increasing subsequence ending with arr[i].\n    # Each element arr[i] itself is an increasing subsequence of length 1, so initialize dp[i] = arr[i].\n    dp = list(arr)\n\n    # Iterate through the array to build up the dp table.\n    for i in range(n):\n        # For each element arr[i], check all previous elements arr[j].\n        for j in range(i):\n            # If arr[j] is smaller than arr[i], it can precede arr[i] in an increasing subsequence.\n            if arr[j] < arr[i]:\n                # Update dp[i] if a larger product is found by appending arr[i] to the subsequence ending at arr[j].\n                dp[i] = max(dp[i], dp[j] * arr[i])\n    \n    # The maximum value in the dp array is the overall maximum product.\n    return max(dp)"}
{"task_id": "Mbpp/465", "solution": "import copy\nfrom typing import Dict, Any, Optional, Iterable, Set, List\n\ndef drop_empty(data: Dict[str, Any], drop_values: Optional[Iterable[Any]] = None, recursive: bool = True, inplace: bool = False) -> Dict[str, Any]:\n    \"\"\"\n    Drops empty items from a dictionary, optionally recursing into nested structures.\n    The function modifies the dictionary in-place if `inplace` is True, otherwise returns a new dictionary.\n    \"\"\"\n\n    # Default values considered empty, as specified in design context.\n    DEFAULT_DROP_VALUES = {None, \"\", (), [], {}, set()}\n\n    def _is_empty(value: Any, current_drop_values_set: Set[Any]) -> bool:\n        \"\"\"\n        Determines if a given value is considered empty based on a set of drop values or if it's a zero-length collection.\n        \"\"\"\n        if value in current_drop_values_set:\n            return True\n        try:\n            # Check for zero-length collections/sequences (e.g., empty string, list, dict, set)\n            return hasattr(value, '__len__') and len(value) == 0\n        except TypeError: # Handle cases where len() might raise TypeError for certain objects.\n            return False\n\n    def _deep_copy_dict(d: Dict[str, Any]) -> Dict[str, Any]:\n        \"\"\"\n        Performs a deep copy of a dictionary, ensuring all nested structures are also copied.\n        \"\"\"\n        return copy.deepcopy(d)\n\n    # Combine default drop values with any user-provided ones for the current operation.\n    combined_drop_values_set: Set[Any] = DEFAULT_DROP_VALUES\n    if drop_values is not None:\n        combined_drop_values_set = combined_drop_values_set.union(set(drop_values))\n\n    def _drop_from_dict(d: Dict[str, Any]) -> Dict[str, Any]:\n        \"\"\"\n        Recursively removes empty items from the input dictionary `d`, modifying it in-place.\n        \"\"\"\n        keys_to_delete = []\n        for key, value in d.items():\n            processed_value = value\n            if recursive:\n                if isinstance(value, dict):\n                    processed_value = _drop_from_dict(value) # Recurse into nested dict\n                elif isinstance(value, list):\n                    processed_value = _drop_from_list(value) # Recurse into nested list\n            \n            # After processing (or if not recursive), check if the value is empty.\n            if _is_empty(processed_value, combined_drop_values_set):\n                keys_to_delete.append(key)\n            elif recursive and isinstance(value, list) and processed_value is not value:\n                # If a nested list was cleaned and resulted in a new list object, update the reference.\n                d[key] = processed_value\n        \n        # Delete all marked keys from the dictionary.\n        for key in keys_to_delete:\n            del d[key]\n        return d\n\n    def _drop_from_list(lst: List[Any]) -> List[Any]:\n        \"\"\"\n        Recursively processes and removes empty items from the input list `lst`.\n        Returns a new list with empty items removed.\n        \"\"\"\n        cleaned_list = []\n        for item in lst:\n            processed_item = item\n            if recursive:\n                if isinstance(item, dict):\n                    processed_item = _drop_from_dict(item) # Recurse into nested dict\n                elif isinstance(item, list):\n                    processed_item = _drop_from_list(item) # Recurse into nested list\n            \n            # Add item to cleaned_list only if it's not empty.\n            if not _is_empty(processed_item, combined_drop_values_set):\n                cleaned_list.append(processed_item)\n        return cleaned_list\n\n    # Determine the working dictionary: original if inplace, or a deep copy otherwise.\n    working_data = data if inplace else _deep_copy_dict(data)\n    \n    # Start the recursive cleaning process from the top-level dictionary.\n    return _drop_from_dict(working_data)"}
{"task_id": "Mbpp/463", "solution": "def max_subarray_product(arr):\n    \"\"\"\n    Finds the maximum product of any contiguous subarray in the given array.\n    Handles positive, negative, and zero values efficiently.\n    \"\"\"\n    if not arr:\n        return 0\n\n    max_so_far = arr[0]\n    max_ending_here = arr[0]\n    min_ending_here = arr[0]\n\n    for i in range(1, len(arr)):\n        num = arr[i]\n\n        # If current number is negative, swap max_ending_here and min_ending_here\n        # because multiplying by a negative number reverses their roles.\n        if num < 0:\n            max_ending_here, min_ending_here = min_ending_here, max_ending_here\n\n        # Update max_ending_here and min_ending_here for the current number\n        max_ending_here = max(num, max_ending_here * num)\n        min_ending_here = min(num, min_ending_here * num)\n\n        # Update the overall maximum product found so far\n        max_so_far = max(max_so_far, max_ending_here)\n\n    return max_so_far"}
{"task_id": "Mbpp/470", "solution": "def add_pairwise(values: tuple[int, ...]) -> tuple[int, ...]:\n    \"\"\"\n    Finds the pairwise addition of neighboring elements of the given tuple.\n    Returns an empty tuple if the input has fewer than two elements.\n    \"\"\"\n    n = len(values)\n    if n < 2:\n        return ()\n    return tuple(values[i] + values[i+1] for i in range(n-1))"}
{"task_id": "Mbpp/471", "solution": "def find_remainder(arr, n):\n    \"\"\"\n    Computes the product of all elements in the array modulo n, ensuring intermediate results are reduced to prevent overflow.\n    If the array is empty, it returns 1 % n.\n    \"\"\"\n    product = 1\n    for x in arr:\n        product = (product * (x % n)) % n\n    return product"}
{"task_id": "Mbpp/472", "solution": "def check_Consecutive(lst: List[int]) -> bool:\n    \"\"\"\n    Checks if the given list contains consecutive numbers, considering only unique values.\n    Returns True if the unique numbers form an unbroken sequence, False otherwise.\n    \"\"\"\n    if not lst:\n        return False\n\n    unique_numbers = set(lst)\n    \n    min_val = min(unique_numbers)\n    max_val = max(unique_numbers)\n\n    return (max_val - min_val + 1) == len(unique_numbers)"}
{"task_id": "Mbpp/474", "solution": "def replace_char(source, old_char, new_char):\n    \"\"\"\n    Replaces all occurrences of old_char with new_char in the source string.\n    If old_char and new_char are the same, the original string is returned.\n    \"\"\"\n    if old_char == new_char:\n        return source\n    return source.replace(old_char, new_char)"}
{"task_id": "Mbpp/473", "solution": "def _normalize_tuple(t):\n    \"\"\"\n    Normalizes a 2-element tuple to a canonical form (sorted elements).\n    Falls back to string comparison for uncomparable types.\n    \"\"\"\n    try:\n        return tuple(sorted(t))\n    except TypeError:\n        return tuple(sorted(t, key=str))\n\ndef _to_canonical_set(seq):\n    \"\"\"Converts an iterable of tuples into a set of their canonical forms.\"\"\"\n    s = set()\n    for t_item in seq:\n        ct = _normalize_tuple(tuple(t_item))\n        s.add(ct)\n    return s\n\ndef tuple_intersection(list1, list2):\n    \"\"\"\n    Finds the intersection of elements in two tuple lists,\n    treating (a, b) as equal to (b, a).\n    \"\"\"\n    s1 = _to_canonical_set(list1)\n    s2 = _to_canonical_set(list2)\n    return s1 & s2"}
{"task_id": "Mbpp/475", "solution": "def sort_counter(counter):\n    \"\"\"Sorts a dictionary by its values in descending order, then by keys ascending for ties.\"\"\"\n    return sorted(counter.items(), key=lambda kv: (-kv[1], kv[0]))"}
{"task_id": "Mbpp/478", "solution": "def remove_lowercase(s: str) -> str:\n    \"\"\"\n    Removes all individual lowercase ASCII characters from the input string.\n    Other characters, including uppercase, digits, and symbols, are preserved.\n    \"\"\"\n    \n    # Helper function to check if a character is a lowercase ASCII letter.\n    def is_lower_ascii(ch: str) -> bool:\n        return 'a' <= ch <= 'z'\n\n    result_chars = []\n    for char in s:\n        if not is_lower_ascii(char):\n            result_chars.append(char)\n    \n    return \"\".join(result_chars)"}
