{"task_id": "Mbpp/62", "solution": "def smallest_num(numbers: Sequence[Any]) -> float | int:\n    \"\"\"Finds the smallest number in a list, validating inputs and handling edge cases.\"\"\"\n\n    class InvalidInputError(ValueError):\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    class Validator:\n        @staticmethod\n        def is_numeric(value: Any) -> bool:\n            return isinstance(value, (int, float)) and not isinstance(value, bool)\n\n        @staticmethod\n        def validate_numbers(seq: Sequence[Any]) -> None:\n            if not hasattr(seq, \"__iter__\"):\n                raise InvalidInputError(\"Input must be a sequence.\")\n            numbers_list = list(seq)\n            if len(numbers_list) == 0:\n                raise InvalidInputError(\"Input sequence must not be empty.\")\n            for i, v in enumerate(numbers_list):\n                if not Validator.is_numeric(v):\n                    raise InvalidInputError(f\"Element at index {i} is not numeric: {v!r}\")\n\n    class SmallestFinder:\n        def find_smallest(self, numbers: Sequence[float | int]) -> float | int:\n            it = iter(numbers)\n            try:\n                smallest = next(it)\n            except StopIteration:\n                raise InvalidInputError(\"Cannot find smallest of empty sequence.\")\n            for v in it:\n                if v < smallest:\n                    smallest = v\n            return smallest\n\n    class ResultRepository:\n        def __init__(self):\n            self._last_result = None\n\n        def save(self, result: float | int) -> None:\n            self._last_result = result\n\n        def get_last(self) -> float | int | None:\n            return self._last_result\n\n    class SmallestController:\n        def __init__(self, service: SmallestFinder = None, repository: ResultRepository = None):\n            self.service = service if service is not None else SmallestFinder()\n            self.repository = repository\n\n        def get_smallest(self, numbers: Sequence[Any]) -> float | int:\n            Validator.validate_numbers(numbers)\n            result = self.service.find_smallest(numbers)\n            if self.repository:\n                self.repository.save(result)\n            return result\n\n    controller = SmallestController(service=SmallestFinder(), repository=ResultRepository())\n    return controller.get_smallest(numbers)"}
