{"task_id": "Mbpp/59", "solution": "import collections\nfrom typing import Optional, Any\n\nclass InMemoryCache:\n    \"\"\"A simple in-memory LRU-like cache for computed values.\"\"\"\n    DEFAULT_MAX_SIZE = 256\n\n    def __init__(self, max_size: int = DEFAULT_MAX_SIZE) -> None:\n        self.max_size = max_size\n        self._store: dict[Any, Any] = {}\n        self._order: collections.deque[Any] = collections.deque()\n\n    def get(self, key: Any) -> Optional[Any]:\n        if key in self._store:\n            self._order.remove(key)\n            self._order.append(key)\n            return self._store[key]\n        return None\n\n    def set(self, key: Any, value: Any) -> None:\n        if key in self._store:\n            self._order.remove(key)\n        elif len(self._store) >= self.max_size:\n            lru_key = self._order.popleft()\n            del self._store[lru_key]\n        self._order.append(key)\n        self._store[key] = value\n\n    def clear(self) -> None:\n        \"\"\"Clears all entries from the cache.\"\"\"\n        self._store.clear()\n        self._order.clear()\n\nclass OctagonalNumber:\n    \"\"\"Handles the pure mathematical computation of octagonal numbers.\"\"\"\n    FORMULA_DESCRIPTION = \"O(n) = n * (3n - 2)\"\n\n    @classmethod\n    def compute(cls, n: int) -> int:\n        \"\"\"Computes the nth octagonal number using its formula.\"\"\"\n        return n * (3 * n - 2)\n\nclass OctagonalService:\n    \"\"\"Manages the computation and caching of octagonal numbers.\"\"\"\n    DEFAULT_CACHE_SIZE: int = 256\n\n    def __init__(self, cache: Optional[InMemoryCache]=None, cache_size: int=256) -> None:\n        self._cache = cache if cache is not None else InMemoryCache(max_size=cache_size)\n\n    def compute(self, n: int) -> int:\n        \"\"\"Calculates the nth octagonal number, utilizing the cache to avoid recomputation.\"\"\"\n        cached = self._cache.get(n)\n        if cached is not None:\n            return cached\n        \n        value = OctagonalNumber.compute(n)\n        try:\n            self._cache.set(n, value)\n        except Exception:\n            # Swallow cache errors to ensure computation proceeds without disruption.\n            pass\n        return value\n\n    def clear_cache(self) -> None:\n        \"\"\"Clears the internal computation cache.\"\"\"\n        self._cache.clear()\n\n_service: Optional[OctagonalService] = None\n\ndef _get_service() -> OctagonalService:\n    \"\"\"Provides a lazily initialized singleton instance of OctagonalService.\"\"\"\n    global _service\n    if _service is None:\n        _service = OctagonalService()\n    return _service\n\ndef is_octagonal(n: int) -> int:\n    \"\"\"\n    Calculates the nth octagonal number using the formula n * (3n - 2).\n    It uses an internal service for caching to optimize repeated calls.\n    \"\"\"\n    return _get_service().compute(n)"}
