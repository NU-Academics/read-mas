{"task_id": "Mbpp/448", "solution": "from typing import Any, Optional, Dict\n\ndef cal_sum(n: int) -> int:\n    \"\"\"Calculates the sum of Perrin numbers from P(0) to P(n) inclusive.\"\"\"\n\n    class PerrinError(Exception):\n        pass\n\n    class InvalidInputError(PerrinError):\n        pass\n\n    def validate_index(idx: Any) -> int:\n        if not isinstance(idx, int) or idx < 0:\n            raise InvalidInputError(\"n must be a non-negative integer.\")\n        return idx\n\n    class PerrinAlgorithm:\n        def compute(self, idx: int) -> int:\n            raise NotImplementedError\n\n    class IterativePerrinAlgorithm(PerrinAlgorithm):\n        BASES = (3, 0, 2)\n\n        def compute(self, idx: int) -> int:\n            if idx < 3:\n                return self.BASES[idx]\n            a, b, c = self.BASES\n            for _ in range(3, idx + 1):\n                a, b, c = b, c, a + b\n            return c\n\n    class CacheRepository:\n        def get(self, key: str) -> Optional[int]:\n            raise NotImplementedError\n        def set(self, key: str, value: int) -> None:\n            raise NotImplementedError\n        def clear(self) -> None:\n            raise NotImplementedError\n\n    class InMemoryCacheRepository(CacheRepository):\n        def __init__(self):\n            self._store: Dict[str, int] = {}\n\n        def get(self, key: str) -> Optional[int]:\n            return self._store.get(key)\n\n        def set(self, key: str, value: int) -> None:\n            self._store[key] = value\n\n        def clear(self) -> None:\n            self._store.clear()\n\n    class PerrinService:\n        def __init__(self, algorithm: PerrinAlgorithm, cache: CacheRepository):\n            self._algorithm = algorithm\n            self._cache = cache\n\n        def get_value(self, idx: int) -> int:\n            key = f\"perrin:{idx}\"\n            cached = self._cache.get(key)\n            if cached is not None:\n                return cached\n            val = self._algorithm.compute(idx)\n            self._cache.set(key, val)\n            return val\n\n        def sum_values(self, idx: int) -> int:\n            total = 0\n            for i in range(0, idx + 1):\n                total += self.get_value(i)\n            return total\n\n    class PerrinController:\n        def __init__(self, service: PerrinService):\n            self._service = service\n\n        def calc_value(self, idx: int) -> int:\n            validate_index(idx)\n            return self._service.get_value(idx)\n\n        def calc_sum(self, idx: int) -> int:\n            validate_index(idx)\n            return self._service.sum_values(idx)\n\n    service = PerrinService(\n        algorithm=IterativePerrinAlgorithm(),\n        cache=InMemoryCacheRepository()\n    )\n    controller = PerrinController(service=service)\n\n    return controller.calc_sum(n)"}
