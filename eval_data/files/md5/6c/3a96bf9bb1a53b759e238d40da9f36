{"task_id": "Mbpp/460", "solution": "from typing import List, Any, Iterable\n\nclass InvalidInputError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass EmptySublistError(Exception):\n    def __init__(self, index: int, message: str) -> None:\n        super().__init__(message)\n        self.index = index\n        self.message = message\n\nclass Utils:\n    @staticmethod\n    def is_iterable(obj: Any) -> bool:\n        \"\"\"Checks if an object is iterable.\"\"\"\n        try:\n            iter(obj)\n            return True\n        except TypeError:\n            return False\n\n    @staticmethod\n    def safe_get_first(sublist: Iterable[Any]) -> Any:\n        \"\"\"Returns the first element of an iterable or raises IndexError if empty.\"\"\"\n        for x in sublist:\n            return x\n        raise IndexError(\"Sublist empty\")\n\nclass ExtractRequest:\n    \"\"\"DTO for extraction request.\"\"\"\n    def __init__(self, items: List[List[Any]]) -> None:\n        self.items: List[List[Any]] = items\n\nclass ExtractResponse:\n    \"\"\"DTO for extraction response.\"\"\"\n    def __init__(self, items: List[Any]) -> None:\n        self.items: List[Any] = items\n\nclass ListValidator:\n    \"\"\"Validates input lists and sublists.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def validate(self, items: Any) -> None:\n        \"\"\"Ensures input is an iterable of non-empty iterables.\"\"\"\n        if not Utils.is_iterable(items):\n            raise InvalidInputError(\"Top-level input must be an iterable of iterables.\")\n        for idx, sub in enumerate(items):\n            if not Utils.is_iterable(sub):\n                raise InvalidInputError(f\"Sublist at index {idx} is not iterable.\")\n            if len(list(sub)) == 0:\n                raise EmptySublistError(idx, f\"Sublist at index {idx} is empty.\")\n\nclass ExtractorService:\n    \"\"\"Core business logic for extracting first elements.\"\"\"\n    def __init__(self, validator: ListValidator) -> None:\n        self.validator = validator\n\n    def extract_first_elements(self, request: ExtractRequest) -> ExtractResponse:\n        \"\"\"Validates input and extracts the first element from each sublist.\"\"\"\n        items = request.items\n        self.validator.validate(items)\n        result: List[Any] = []\n        for idx, sub in enumerate(items):\n            try:\n                first = Utils.safe_get_first(sub)\n            except IndexError:\n                raise EmptySublistError(idx, f\"Sublist at index {idx} is empty.\")\n            result.append(first)\n        return ExtractResponse(result)\n\ndef Extract(items):\n    \"\"\"\n    Public fa\u00e7ade function: Extract(items: List[List[Any]]) -> List[Any]\n    Returns a list containing the first element of each sublist in the input.\n    \"\"\"\n    request = ExtractRequest(items)\n    service = ExtractorService(ListValidator())\n    response = service.extract_first_elements(request)\n    return response.items"}
