{"task_id": "Mbpp/597", "solution": "def find_kth(a: list[int], b: list[int], k: int) -> int:\n    # Find the k-th smallest element from two sorted arrays using binary search.\n    # This algorithm works by partitioning the arrays to find the correct split point efficiently.\n\n    # Ensure 'a' is the shorter array to optimize the binary search range.\n    if len(a) > len(b):\n        a, b = b, a\n\n    len_a = len(a)\n    len_b = len(b)\n\n    # 'low' is the minimum possible number of elements to take from 'a'.\n    # 'high' is the maximum possible number of elements to take from 'a'.\n    low = max(0, k - len_b)\n    high = min(k, len_a)\n\n    NEG_INF = float(\"-inf\")\n    POS_INF = float(\"inf\")\n\n    while low <= high:\n        i = (low + high) // 2  # Number of elements taken from array 'a'\n        j = k - i              # Number of elements taken from array 'b'\n\n        # Determine the four boundary elements for the current partition.\n        # Use negative/positive infinity for elements that are outside array bounds.\n        left_a = a[i - 1] if i > 0 else NEG_INF\n        right_a = a[i] if i < len_a else POS_INF\n\n        left_b = b[j - 1] if j > 0 else NEG_INF\n        right_b = b[j] if j < len_b else POS_INF\n\n        # Check if the partition is valid: elements on the left are less than or equal to elements on the right.\n        if left_a <= right_b and left_b <= right_a:\n            return max(left_a, left_b)\n        elif left_a > right_b:\n            # Partition is too far right in 'a', reduce 'high'.\n            high = i - 1\n        else:  # left_b > right_a\n            # Partition is too far left in 'a', increase 'low'.\n            low = i + 1"}
{"task_id": "Mbpp/599", "solution": "from dataclasses import dataclass\nfrom typing import Any\n\nclass InvalidInputError(ValueError):\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\n    def __str__(self) -> str:\n        return self.message\n\n@dataclass(frozen=True)\nclass NumberResult:\n    sum: int\n    average: float\n\n    def to_tuple(self) -> tuple[int, float]:\n        return (self.sum, self.average)\n\nMIN_N = 1\n\nclass InputValidator:\n    def validate_n(self, value: Any) -> int:\n        if isinstance(value, int):\n            if value >= MIN_N:\n                return value\n            raise InvalidInputError(f\"n must be >= {MIN_N}, got {value}\")\n        try:\n            parsed = int(value)\n        except (ValueError, TypeError):\n            raise InvalidInputError(f\"n must be an integer >= {MIN_N}, got {value!r}\")\n        if parsed < MIN_N:\n            raise InvalidInputError(f\"n must be >= {MIN_N}, got {parsed}\")\n        return parsed\n\nclass SumAverageService:\n    def __init__(self, validator: InputValidator):\n        self._validator = validator\n\n    def sum_average(self, n: int) -> NumberResult:\n        valid_n = self._validator.validate_n(n)\n        total = self._compute_sum(valid_n)\n        avg = self._compute_average(total, valid_n)\n        return NumberResult(total, avg)\n\n    def _compute_sum(self, n: int) -> int:\n        return n * (n + 1) // 2\n\n    def _compute_average(self, total: int, n: int) -> float:\n        return total / n\n\ndef sum_average(n: int) -> tuple[int, float]:\n    \"\"\"\n    Calculates the sum and average of the first n natural numbers.\n    Raises InvalidInputError if n is not a positive integer.\n    \"\"\"\n    _validator = InputValidator()\n    _service = SumAverageService(_validator)\n    result = _service.sum_average(n)\n    return result.to_tuple()"}
{"task_id": "Mbpp/600", "solution": "def is_Even(number):\n    \"\"\"Checks if the given number is even.\n    Returns True if even, False otherwise.\"\"\"\n    return number % 2 == 0"}
{"task_id": "Mbpp/598", "solution": "def armstrong_number(n: int) -> bool:\n    \"\"\"Checks if a given number is an Armstrong number.\"\"\"\n    if n < 0:\n        return False\n    if n == 0:\n        return True\n\n    # Calculate the number of digits (p)\n    p = len(str(n))\n\n    original_n = n\n    sum_of_powers = 0\n    temp_n = n\n\n    # Extract digits and sum each to the power of p\n    while temp_n > 0:\n        digit = temp_n % 10\n        sum_of_powers += digit ** p\n        temp_n //= 10\n\n    return sum_of_powers == original_n"}
{"task_id": "Mbpp/602", "solution": "def first_repeated_char(s: str) -> str:\n    \"\"\"Finds the first character that repeats in the string, returning it or None if no character repeats.\"\"\"\n    seen_chars = set()\n    for char in s:\n        if char in seen_chars:\n            return char\n        seen_chars.add(char)\n    return None"}
