{"task_id": "Mbpp/308", "solution": "import heapq\n\ndef large_product(list_a, list_b, k):\n    \"\"\"\n    Finds the specified number of largest products from two given lists,\n    selecting one factor from each list.\n    \"\"\"\n    \n    if not list_a or not list_b:\n        return []\n\n    # Sort lists in descending order\n    list_a_sorted = sorted(list_a, reverse=True)\n    list_b_sorted = sorted(list_b, reverse=True)\n\n    n = len(list_a_sorted)\n    m = len(list_b_sorted)\n    \n    # Define threshold for switching to brute-force, as per design context\n    MAX_TOTAL_PAIRS_FOR_BRUTE_FORCE = 2000\n\n    total_possible_products = n * m\n\n    # Adjust k if it's larger than the total possible products\n    k_effective = min(k, total_possible_products)\n    \n    if total_possible_products <= MAX_TOTAL_PAIRS_FOR_BRUTE_FORCE:\n        # Brute-force approach for small lists: calculate all products, sort, and take top k.\n        all_products = []\n        for val_a in list_a_sorted:\n            for val_b in list_b_sorted:\n                all_products.append(val_a * val_b)\n        \n        all_products.sort(reverse=True)\n        return all_products[:k_effective]\n    else:\n        # Heap-based approach for larger lists to efficiently find top k products.\n        # Heap stores tuples: (-product, index_a, index_b) to simulate a max-heap.\n        \n        heap = []\n        visited = set() # Stores (index_a, index_b) pairs to avoid duplicate pushes to the heap.\n\n        # Push the largest initial product (from the first elements of the sorted lists)\n        initial_product = list_a_sorted[0] * list_b_sorted[0]\n        heapq.heappush(heap, (-initial_product, 0, 0))\n        visited.add((0, 0))\n\n        results = []\n        \n        while len(results) < k_effective and heap:\n            neg_prod, i, j = heapq.heappop(heap)\n            results.append(-neg_prod)\n\n            # Consider the product with the next element from list_a\n            if i + 1 < n and (i + 1, j) not in visited:\n                next_product_a = list_a_sorted[i + 1] * list_b_sorted[j]\n                heapq.heappush(heap, (-next_product_a, i + 1, j))\n                visited.add((i + 1, j))\n\n            # Consider the product with the next element from list_b\n            if j + 1 < m and (i, j + 1) not in visited:\n                next_product_b = list_a_sorted[i] * list_b_sorted[j + 1]\n                heapq.heappush(heap, (-next_product_b, i, j + 1))\n                visited.add((i, j + 1))\n        \n        return results"}
{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(n: int) -> int:\n    \"\"\"Sets the left-most unset bit in a non-negative integer.\n    If all bits up to the MSB are set, the next higher bit is set.\"\"\"\n\n    def _msb_pos(val: int) -> int:\n        \"\"\"Returns the position of the most significant bit (0-indexed).\"\"\"\n        return (val.bit_length() - 1) if val > 0 else 0\n\n    def _is_bit_set(val: int, pos: int) -> bool:\n        \"\"\"Checks if the bit at a given position is set.\"\"\"\n        return bool(val & (1 << pos))\n\n    def _bit_mask(pos: int) -> int:\n        \"\"\"Returns an integer with only the bit at 'pos' set.\"\"\"\n        return 1 << pos\n\n    msb = _msb_pos(n)\n\n    # Iterate from MSB down to 0 to find the left-most unset bit.\n    for pos in range(msb, -1, -1):\n        if not _is_bit_set(n, pos):\n            return n | _bit_mask(pos)\n\n    # If all bits are set up to the MSB, set the next higher bit.\n    return n | _bit_mask(msb + 1)"}
{"task_id": "Mbpp/312", "solution": "import math\n\ndef volume_cone(radius: float, height: float) -> float:\n    \"\"\"Calculates the volume of a cone using the formula V = (1/3) * \u03c0 * r^2 * h.\"\"\"\n    return (1/3) * math.pi * (radius ** 2) * height"}
{"task_id": "Mbpp/389", "solution": "def find_lucas(n: int) -> int:\n    \"\"\"\n    Computes the n'th Lucas number using an iterative approach.\n    L(0) = 2, L(1) = 1, L(n) = L(n-1) + L(n-2) for n >= 2.\n    \"\"\"\n    if n == 0:\n        return 2\n    if n == 1:\n        return 1\n\n    a, b = 2, 1  # L(0) and L(1)\n    for _ in range(2, n + 1):\n        a, b = b, a + b\n    return b"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n):\n    \"\"\"\n    Finds the highest power of 2 that is less than or equal to n.\n    Returns 0 if n is 0.\n    \"\"\"\n    if n == 0:\n        return 0\n\n    # Fill all bits to the right of the most significant bit with ones.\n    v = n\n    v |= (v >> 1)\n    v |= (v >> 2)\n    v |= (v >> 4)\n    v |= (v >> 8)\n    v |= (v >> 16)\n    v |= (v >> 32) # For 64-bit integers; Python handles arbitrary precision.\n\n    # Increment to get the next power of 2, then shift right by 1.\n    return (v + 1) >> 1"}
