{"task_id": "Mbpp/262", "solution": "def split_two_parts(input_list, L):\n    \"\"\"\n    Splits a list into two parts: the first part has length L, and the second part contains the remaining elements.\n    Slicing creates new lists, ensuring the returned parts are copies.\n    \"\"\"\n    if L >= len(input_list):\n        # If L is greater than or equal to the list length, the first part is the whole list, second is empty.\n        return (input_list[:], [])\n    else:\n        # Otherwise, split the list using standard Python slicing.\n        first_part = input_list[:L]\n        second_part = input_list[L:]\n        return (first_part, second_part)"}
{"task_id": "Mbpp/261", "solution": "def division_elements(a: tuple, b: tuple) -> tuple[int, ...]:\n    \"\"\"\n    Performs element-wise integer division on two input tuples.\n    Validates inputs and handles division by zero or type mismatches.\n    \"\"\"\n\n    class TupleLengthMismatchError(Exception):\n        \"\"\"Raised when input tuples have different lengths.\"\"\"\n        pass\n\n    class DivisionByZeroError(Exception):\n        \"\"\"Raised when an element in the divisor tuple is zero.\"\"\"\n        pass\n\n    class InvalidElementError(Exception):\n        \"\"\"Raised when an element in an input tuple is not a valid number.\"\"\"\n        pass\n\n    def safe_divide_inline(numerator: float, denominator: float) -> int:\n        \"\"\"Performs integer division, raising an error if the denominator is zero.\"\"\"\n        if denominator == 0:\n            raise DivisionByZeroError(\"Division by zero encountered.\")\n        # Python's // operator for integer division handles floor division.\n        # For mixed types, int(float_division) truncates towards zero.\n        if isinstance(numerator, int) and isinstance(denominator, int):\n            return numerator // denominator\n        return int(numerator / denominator)\n\n    if not isinstance(a, tuple) or not isinstance(b, tuple):\n        raise InvalidElementError(\"Inputs must be tuples.\")\n\n    if len(a) != len(b):\n        raise TupleLengthMismatchError(\"Input tuples must have the same length.\")\n\n    result_elements = []\n    for i in range(len(a)):\n        val_a = a[i]\n        val_b = b[i]\n\n        if not isinstance(val_a, (int, float)):\n            raise InvalidElementError(f\"Element at index {i} in the first tuple is not numeric.\")\n        if not isinstance(val_b, (int, float)):\n            raise InvalidElementError(f\"Element at index {i} in the second tuple is not numeric.\")\n\n        result_elements.append(safe_divide_inline(float(val_a), float(val_b)))\n\n    return tuple(result_elements)"}
{"task_id": "Mbpp/265", "solution": "def list_split(items, n):\n    \"\"\"\n    Splits a list into n sublists, where each sublist contains every nth element from the original list.\n    Elements are distributed column-wise into the resulting sublists.\n    \"\"\"\n    result = [[] for _ in range(n)]\n    for idx, item in enumerate(items):\n        result[idx % n].append(item)\n    return result"}
{"task_id": "Mbpp/260", "solution": "def newman_prime(n: int) -> int:\n    \"\"\"\n    Finds the first Newman\u2013Shanks\u2013Williams prime S(k) where k >= n,\n    following the recurrence S(0)=1, S(1)=1, S(k) = 2*S(k-1) + S(k-2).\n    \"\"\"\n\n    def _is_prime(num: int) -> bool:\n        \"\"\"\n        Determines if a number is prime using trial division for small numbers\n        and a deterministic Miller-Rabin test for larger values.\n        \"\"\"\n        if num < 2:\n            return False\n        if num == 2 or num == 3:\n            return True\n        if num % 2 == 0 or num % 3 == 0:\n            return False\n\n        # Fixed set of bases for Miller-Rabin, sufficient for values in this problem's scope.\n        # This provides a deterministic test for numbers up to a certain range.\n        miller_rabin_bases = [2, 3, 5, 7, 11, 13, 17] \n        \n        d = num - 1\n        s = 0\n        while d % 2 == 0:\n            d //= 2\n            s += 1\n        \n        for a in miller_rabin_bases:\n            if a >= num: # Base 'a' must be less than 'num' for Miller-Rabin\n                break\n            \n            x = pow(a, d, num)\n            if x == 1 or x == num - 1:\n                continue\n\n            for _ in range(s - 1):\n                x = pow(x, 2, num)\n                if x == num - 1:\n                    break\n            else: # If loop completes without finding num-1, num is composite\n                return False\n        return True\n\n    s_k_minus_2 = 1  # Corresponds to S(0) initially\n    s_k_minus_1 = 1  # Corresponds to S(1) initially\n\n    current_k_idx = 0 \n    current_nsw_value = 0 # Placeholder for calculated NSW term\n\n    # Iterate through NSW sequence terms until the nth prime is found.\n    # The max_iterations value is a safety limit from the design context.\n    max_iterations = 10000 \n    num_iterations = 0\n\n    while num_iterations < max_iterations:\n        if current_k_idx == 0:\n            current_nsw_value = 1 \n        elif current_k_idx == 1:\n            current_nsw_value = 1\n        else:\n            current_nsw_value = 2 * s_k_minus_1 + s_k_minus_2\n            s_k_minus_2 = s_k_minus_1\n            s_k_minus_1 = current_nsw_value\n        \n        # Check primality if the current index k is greater than or equal to n.\n        if current_k_idx >= n and _is_prime(current_nsw_value):\n            return current_nsw_value\n        \n        current_k_idx += 1\n        num_iterations += 1"}
{"task_id": "Mbpp/267", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"Calculates the sum of the squares of the first n odd natural numbers.\n    For n=0, the sum is 0.\n    \"\"\"\n    total_sum = 0\n    for i in range(n):\n        odd_number = 1 + 2 * i\n        total_sum += odd_number * odd_number\n    return total_sum"}
