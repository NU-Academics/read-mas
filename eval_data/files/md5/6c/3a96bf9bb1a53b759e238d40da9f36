{"task_id": "Mbpp/82", "solution": "import math\nfrom typing import Any\n\nclass ValidationError(Exception):\n    \"\"\"Custom exception for validation errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass Sphere:\n    \"\"\"Represents a sphere domain entity and encapsulates radius validation.\"\"\"\n    def __init__(self, radius: float) -> None:\n        try:\n            r = float(radius)\n        except (TypeError, ValueError):\n            raise ValidationError(f\"Radius must be numeric, got {radius!r}\")\n        if r < 0:\n            raise ValidationError(\"Radius must be non-negative\")\n        self._radius: float = r\n\n    @property\n    def radius(self) -> float:\n        return self._radius\n\n    def validate(self) -> None:\n        if self._radius < 0:\n            raise ValidationError(\"Radius must be non-negative\")\n\nclass VolumeCalculator:\n    \"\"\"Encapsulates the formula for sphere volume.\"\"\"\n    PI: float = math.pi\n\n    def compute_volume(self, sphere: Sphere) -> float:\n        r = sphere.radius\n        return (4.0 / 3.0) * self.PI * (r ** 3)\n\ndef parse_radius(value: Any) -> float:\n    \"\"\"Parses and validates radius value, ensuring it's a non-negative float.\"\"\"\n    try:\n        r = float(value)\n    except (TypeError, ValueError):\n        raise ValidationError(f\"Radius must be numeric, got {value!r}\")\n    if r < 0:\n        raise ValidationError(\"Radius must be non-negative\")\n    return r\n\nclass SphereController:\n    \"\"\"Orchestrates input parsing/validation and calls the volume calculator.\"\"\"\n    def __init__(self, calculator: VolumeCalculator) -> None:\n        self._calculator = calculator\n\n    def compute_volume_radius(self, radius: float) -> float:\n        r = parse_radius(radius)\n        sphere = Sphere(r)\n        return self._calculator.compute_volume(sphere)\n\ndef volume_sphere(radius: float) -> float:\n    \"\"\"Calculates the volume of a sphere given its radius.\"\"\"\n    calculator = VolumeCalculator()\n    controller = SphereController(calculator)\n    return controller.compute_volume_radius(radius)"}
