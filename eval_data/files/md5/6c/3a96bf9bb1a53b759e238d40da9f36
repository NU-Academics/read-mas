{"task_id": "Mbpp/560", "solution": "def union_elements(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Finds the union of elements from two tuples and returns them in a new sorted tuple.\n    Duplicates are removed as part of the union operation.\n    \"\"\"\n    combined_set = set(a) | set(b)\n    sorted_list = sorted(list(combined_set))\n    return tuple(sorted_list)"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(nums, length):\n    \"\"\"\n    Finds the sum of the largest contiguous sublist using Kadane's algorithm.\n    Assumes `nums` is a non-empty list of integers.\n    \"\"\"\n    max_so_far = nums[0]\n    current_max = nums[0]\n    \n    # The 'length' parameter is redundant as len(nums) can be used,\n    # but it is kept in the signature as per the prompt.\n    for i in range(1, len(nums)):\n        # Calculate current_max: either extend the previous subarray or start a new one\n        current_max = max(nums[i], current_max + nums[i])\n        \n        # Update max_so_far if current_max is greater\n        max_so_far = max(max_so_far, current_max)\n        \n    return max_so_far"}
{"task_id": "Mbpp/562", "solution": "from typing import Sequence, Any, Optional\nfrom collections.abc import Sequence as ABCSequence\n\nclass ValidationError(Exception):\n    def __init__(self, message: str, code: Optional[str] = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.code = code\n\ndef is_sequence_but_not_str(obj: Any) -> bool:\n    \"\"\"Checks if an object is a sequence but not a string, bytes, or bytearray.\"\"\"\n    return isinstance(obj, ABCSequence) and not isinstance(obj, (str, bytes, bytearray))\n\nclass Validator:\n    def __init__(self) -> None:\n        pass\n\n    def validate_outer(self, items: Any) -> None:\n        \"\"\"Validates that the outer input is a sequence.\"\"\"\n        if not is_sequence_but_not_str(items):\n            raise ValidationError(\"Outer input must be a sequence (list or tuple)\", code=\"INVALID_OUTER\")\n\n    def validate_inner_items(self, items: Sequence[Any]) -> None:\n        \"\"\"Validates that all inner elements are sequences.\"\"\"\n        for i, inner in enumerate(items):\n            if not is_sequence_but_not_str(inner):\n                raise ValidationError(f\"Inner element at index {i} is not a valid sequence\", code=\"INVALID_INNER\")\n\nDEFAULT_EMPTY_RESULT: int = 0\n\nclass ListAnalyzer:\n    def __init__(self) -> None:\n        pass\n\n    def find_max_length(self, items: Sequence[Sequence[Any]]) -> int:\n        \"\"\"Computes the maximum length among inner sequences.\"\"\"\n        return max((len(inner) for inner in items), default=DEFAULT_EMPTY_RESULT)\n\nclass CLIController:\n    def __init__(self, validator: Validator, analyzer: ListAnalyzer) -> None:\n        self.validator = validator\n        self.analyzer = analyzer\n\n    def compute(self, items: Sequence[Sequence[Any]]) -> int:\n        \"\"\"Validates input, then computes and returns the maximum sublist length.\"\"\"\n        self.validator.validate_outer(items)\n        self.validator.validate_inner_items(items)\n        return self.analyzer.find_max_length(items)\n\n_default_validator = Validator()\n_default_analyzer = ListAnalyzer()\n\ndef Find_Max_Length(items: Sequence[Sequence[Any]]) -> int:\n    \"\"\"\n    Finds the length of the longest sublist in a list of lists.\n    Validates input and computes the maximum length.\n    \"\"\"\n    controller = CLIController(_default_validator, _default_analyzer)\n    return controller.compute(items)"}
{"task_id": "Mbpp/558", "solution": "import datetime\nfrom dataclasses import dataclass\nfrom typing import Optional, Protocol\n\n\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input conditions.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\n\nMAX_DIGITS: int = 1000\nDEFAULT_PAD_DIRECTION: str = \"left\"  # allowed: \"left\" or \"right\"\n\n\n@dataclass\nclass DigitDistanceResult:\n    \"\"\"Represents the result of a digit distance computation.\"\"\"\n    a: int\n    b: int\n    digits_a: list[int]\n    digits_b: list[int]\n    per_digit_diffs: list[int]\n    sum_diff: int\n    pad_direction: str\n    timestamp: str\n\n    def to_dict(self) -> dict:\n        \"\"\"Converts the result object to a dictionary.\"\"\"\n        return self.__dict__\n\n    @classmethod\n    def from_dict(cls, data: dict) -> 'DigitDistanceResult':\n        \"\"\"Creates a result object from a dictionary.\"\"\"\n        return cls(**data)\n\n\nclass InputNormalizer:\n    \"\"\"Utility class for normalizing integers to digit lists and padding.\"\"\"\n\n    @staticmethod\n    def normalize_to_digits(n: int) -> list[int]:\n        \"\"\"Converts an integer to a list of its absolute decimal digits.\"\"\"\n        if not isinstance(n, int):\n            raise InvalidInputError(\"Input must be int\")\n        n_abs = abs(n)\n        if n_abs == 0:\n            return [0]\n        digits = []\n        while n_abs:\n            digits.append(n_abs % 10)\n            n_abs //= 10\n        return list(reversed(digits))\n\n    @staticmethod\n    def pad_digits(d1: list[int], d2: list[int], direction: str = \"left\") -> tuple[list[int], list[int]]:\n        \"\"\"Pads the shorter digit list with zeros to match the length of the longer list.\"\"\"\n        ld1, ld2 = len(d1), len(d2)\n        if direction not in (\"left\", \"right\"):\n            raise InvalidInputError(\"pad direction must be 'left' or 'right'\")\n        if ld1 == ld2:\n            return d1, d2\n        diff = abs(ld1 - ld2)\n        pad = [0] * diff\n        if ld1 < ld2:\n            d1 = (pad + d1) if direction == \"left\" else (d1 + pad)\n        else:\n            d2 = (pad + d2) if direction == \"left\" else (d2 + pad)\n        return d1, d2\n\n\nclass HistoryRepository(Protocol):\n    \"\"\"Abstract interface for storing and retrieving computation results.\"\"\"\n    def save(self, result: DigitDistanceResult) -> None:\n        ...\n\n    def list_all(self) -> list[DigitDistanceResult]:\n        ...\n\n\nclass DigitDistanceCalculator:\n    \"\"\"Calculates the per-digit differences and their sum between two integers.\"\"\"\n    def __init__(self, repo: Optional[HistoryRepository] = None, max_digits: int = MAX_DIGITS, pad_direction: str = DEFAULT_PAD_DIRECTION):\n        \"\"\"Initializes the calculator with an optional repository and configuration.\"\"\"\n        self._repo = repo\n        self._max_digits = max_digits\n        self._pad_direction = pad_direction\n\n    def compute(self, a: int, b: int) -> DigitDistanceResult:\n        \"\"\"Computes the full DigitDistanceResult for two integers.\"\"\"\n        self._validate_inputs(a, b)\n        da = InputNormalizer.normalize_to_digits(a)\n        db = InputNormalizer.normalize_to_digits(b)\n        da_p, db_p = InputNormalizer.pad_digits(da, db, self._pad_direction)\n        diffs = [abs(x - y) for x, y in zip(da_p, db_p)]\n        \n        timestamp = datetime.datetime.utcnow().isoformat()\n        \n        result = DigitDistanceResult(\n            a=a, b=b, digits_a=da_p, digits_b=db_p,\n            per_digit_diffs=diffs, sum_diff=sum(diffs),\n            pad_direction=self._pad_direction, timestamp=timestamp\n        )\n        if self._repo:\n            self._repo.save(result)\n        return result\n\n    def compute_sum(self, a: int, b: int) -> int:\n        \"\"\"Returns only the sum of per-digit differences for two integers.\"\"\"\n        return self.compute(a, b).sum_diff\n\n    def _validate_inputs(self, a: int, b: int) -> None:\n        \"\"\"Validates that inputs are integers and do not exceed max_digits.\"\"\"\n        if not isinstance(a, int) or not isinstance(b, int):\n            raise InvalidInputError(\"Inputs must be integers\")\n        max_len = max(len(InputNormalizer.normalize_to_digits(a)), len(InputNormalizer.normalize_to_digits(b)))\n        if max_len > self._max_digits:\n            raise InvalidInputError(f\"Inputs exceed maximum supported digits ({self._max_digits})\")\n\n\ndef digit_distance_nums(a: int, b: int) -> int:\n    \"\"\"Calculates the sum of per-digit absolute differences between two integers.\"\"\"\n    calc = DigitDistanceCalculator(repo=None)\n    return calc.compute_sum(a, b)"}
{"task_id": "Mbpp/564", "solution": "def count_Pairs(arr: list, n: int) -> int:\n    \"\"\"\n    Counts the number of possible unordered pairs where both elements are unequal.\n    Uses frequency counting for O(n) performance.\n    \"\"\"\n    if n <= 1:\n        return 0\n\n    # Calculate frequencies of each element\n    frequencies = {}\n    for x in arr:\n        frequencies[x] = frequencies.get(x, 0) + 1\n\n    # Total possible unordered pairs in a list of length n\n    total_pairs = n * (n - 1) // 2\n\n    # Calculate pairs where elements are equal\n    equal_pairs = 0\n    for count in frequencies.values():\n        if count > 1:\n            equal_pairs += count * (count - 1) // 2\n\n    # Number of unequal pairs is total pairs minus equal pairs\n    unequal_pairs = total_pairs - equal_pairs\n    return unequal_pairs"}
{"task_id": "Mbpp/563", "solution": "import re\nimport json\n\ndef extract_values(s: str) -> list[str]:\n    \"\"\"\n    Extracts values between quotation marks from a string, handling escaped quotes.\n    \"\"\"\n    class ExtractionError(Exception):\n        \"\"\"Custom exception for parsing errors.\"\"\"\n        def __init__(self, message: str, position: int = None) -> None:\n            super().__init__(message)\n            self.message = message\n            self.position = position\n\n    class ExtractionResult:\n        \"\"\"Data transfer object for parsing results.\"\"\"\n        def __init__(self, values: list[str], raw: str) -> None:\n            self.values = values\n            self.raw = raw\n        def to_list(self) -> list[str]:\n            return list(self.values)\n\n    class RegexUtils:\n        \"\"\"Utility class for regex-based extraction and validation.\"\"\"\n        def simple_regex_extract(self, input_str: str) -> list[str]:\n            pattern = r'\"((?:\\\\.|[^\"\\\\])*)\"'\n            matches = re.findall(pattern, input_str)\n            return [m.replace('\\\\\"', '\"').replace('\\\\\\\\', '\\\\') for m in matches]\n        \n        def validate_input(self, input_val: any) -> bool:\n            return isinstance(input_val, str)\n\n    class Parser:\n        \"\"\"\n        Parses quoted tokens from an input string using a state machine.\n        \"\"\"\n        def __init__(self, delimiter: str = '\"', escape_char: str = \"\\\\\"):\n            self.delimiter = delimiter\n            self.escape_char = escape_char\n            self._regex_util = RegexUtils() # Not directly used in primary parse path, but part of design.\n\n        def _is_escape(self, input_str: str, pos: int) -> bool:\n            # Counts preceding backslashes to determine if char at pos is escaped.\n            i = pos - 1\n            backslashes = 0\n            while i >= 0 and input_str[i] == self.escape_char:\n                backslashes += 1\n                i -= 1\n            return (backslashes % 2) == 1\n\n        def parse(self, input_str: str) -> ExtractionResult:\n            if not isinstance(input_str, str):\n                raise ExtractionError(\"Input must be a string\")\n\n            vals = []\n            buf = []\n            in_quote = False\n            start_pos = None\n\n            for i, ch in enumerate(input_str):\n                if ch == self.delimiter:\n                    if not in_quote:\n                        in_quote = True\n                        start_pos = i\n                        buf = []\n                    else:\n                        if not self._is_escape(input_str, i):\n                            in_quote = False\n                            # Unescape sequences like \\\" -> \" and \\\\ -> \\\n                            vals.append(''.join(buf).replace('\\\\\"', '\"').replace('\\\\\\\\', '\\\\'))\n                            buf = []\n                        else:\n                            # Escaped delimiter, append literally\n                            buf.append(ch)\n                else:\n                    if in_quote:\n                        # Append characters inside quotes literally, including backslashes.\n                        buf.append(ch)\n            \n            if in_quote:\n                raise ExtractionError(\"Unterminated quoted string\", position=start_pos)\n            \n            return ExtractionResult(vals, input_str)\n\n    class ExtractorService:\n        \"\"\"Public-facing orchestration and validation layer.\"\"\"\n        def __init__(self, parser: Parser = None):\n            self.parser = parser or Parser()\n\n        def extract(self, input_str: str) -> list[str]:\n            if not isinstance(input_str, str):\n                raise ExtractionError(\"Input must be a string\")\n            result = self.parser.parse(input_str)\n            return result.to_list()\n\n    class LibController:\n        \"\"\"Controller for programmatic library API access.\"\"\"\n        def __init__(self, service: ExtractorService = None):\n            self.service = service or ExtractorService()\n\n        def extract_values(self, input_str: str) -> list[str]:\n            return self.service.extract(input_str)\n\n    # The top-level function instantiates LibController and calls its method.\n    return LibController().extract_values(s)"}
