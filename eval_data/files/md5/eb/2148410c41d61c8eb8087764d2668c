{"task_id": "Mbpp/68", "solution": "def is_Monotonic(arr):\n    \"\"\"\n    Checks if an array is monotonic (either non-increasing or non-decreasing).\n    An empty array or an array with one element is considered monotonic.\n    \"\"\"\n    if len(arr) <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(1, len(arr)):\n        if arr[i] < arr[i - 1]:\n            is_increasing = False\n        if arr[i] > arr[i - 1]:\n            is_decreasing = False\n\n        if not is_increasing and not is_decreasing:\n            return False\n\n    return True"}
{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    \"\"\"\n    Computes the nth Bell number, which represents the number of partitions of a set with n elements.\n    It uses the Bell triangle (or Aitken's array) method for dynamic programming.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    # Initialize the first row of the Bell triangle.\n    # The Bell triangle is constructed such that the first element of each row 'i' is B(i).\n    prev_row = [1]\n\n    for i in range(1, n + 1):\n        current_row = [prev_row[-1]]  # The first element of the current row is the last of the previous row.\n        for j in range(1, i + 1):\n            # Subsequent elements are the sum of the element to their left in the current row\n            # and the element above them in the previous row.\n            current_row.append(current_row[j - 1] + prev_row[j - 1])\n        prev_row = current_row\n\n    # The first element of the final `prev_row` (which corresponds to row `n`) is the nth Bell number.\n    return prev_row[0]"}
{"task_id": "Mbpp/70", "solution": "from typing import Iterable, List, Any, Optional\nclass TupleEqualError(Exception):\n    def __init__(self, message: str, code: int = 1) -> None:\n        self.message = message\n        self.code = code\n        super().__init__(self.message)\n\n    def __str__(self) -> str:\n        return f\"Error {self.code}: {self.message}\"\nDEFAULT_ALLOW_EMPTY: bool = True\nDEFAULT_ALLOW_ITERABLES: bool = False\nclass Validators:\n    @staticmethod\n    def is_tuple(obj: Any) -> bool:\n        return isinstance(obj, tuple)\n\n    @staticmethod\n    def ensure_iterable(obj: Any) -> Iterable[Any]:\n        if hasattr(obj, '__iter__') and not isinstance(obj, (str, bytes)):\n            return obj\n        raise TupleEqualError(f\"Input must be an iterable, not {type(obj).__name__!r}\")\nclass TupleCollection:\n    def __init__(self, items: Iterable[Any], allow_iterables: bool = False) -> None:\n        self._allow_iterables = allow_iterables\n        self._items: List[tuple] = []\n        self._raw = items\n        self.validate()\n\n    def validate(self) -> None:\n        validated = []\n        for i, item in enumerate(self._raw):\n            if Validators.is_tuple(item):\n                validated.append(tuple(item))\n            elif self._allow_iterables and hasattr(item, '__iter__') and not isinstance(item, (str, bytes)):\n                validated.append(tuple(item))\n            else:\n                raise TupleEqualError(f\"Item at index {i} is not a tuple: {item!r}\")\n        self._items = validated\n\n    def __len__(self) -> int:\n        return len(self._items)\n\n    def get_lengths(self) -> List[int]:\n        return [len(t) for t in self._items]\nclass TupleAnalysisService:\n    def are_lengths_equal(self, collection: TupleCollection, allow_empty: bool = True) -> bool:\n        lengths = collection.get_lengths()\n        if not lengths:\n            return bool(allow_empty)\n        first = lengths[0]\n        for l in lengths[1:]:\n            if l != first:\n                return False\n        return True\nclass TupleController:\n    def __init__(self, service: 'TupleAnalysisService' = None) -> None:\n        self.service = service if service else TupleAnalysisService()\n\n    def get_equal(self, iterable_input: Iterable[Any], allow_empty: bool = DEFAULT_ALLOW_EMPTY, allow_iterables: bool = DEFAULT_ALLOW_ITERABLES) -> bool:\n        \"\"\"\n        Processes an iterable of items to determine if all valid tuples/iterables have equal length.\n        Handles input validation and delegates to service for core logic.\n        \"\"\"\n        try:\n            validated_iterable = Validators.ensure_iterable(iterable_input)\n            collection = TupleCollection(validated_iterable, allow_iterables=allow_iterables)\n            return self.service.are_lengths_equal(collection, allow_empty=allow_empty)\n        except TupleEqualError:\n            raise\n        except Exception as e:\n            raise TupleEqualError(f\"An unexpected error occurred: {e}\", code=2)\ndef get_equal(iterable_input: Iterable[Any], *, allow_empty: bool = DEFAULT_ALLOW_EMPTY, allow_iterables: bool = DEFAULT_ALLOW_ITERABLES) -> bool:\n    \"\"\"\n    Checks if all tuples in the given iterable have equal length.\n    Delegates to internal components for validation and logic.\n    \"\"\"\n    controller = TupleController()\n    return controller.get_equal(iterable_input, allow_empty=allow_empty, allow_iterables=allow_iterables)"}
{"task_id": "Mbpp/71", "solution": "def comb_sort(lst):\n    \"\"\"Sorts and returns a new list using the comb sort algorithm.\"\"\"\n    arr = list(lst)\n    n = len(arr)\n    if n < 2:\n        return arr\n    gap = n\n    shrink = 1.3\n    swapped = True\n    while gap > 1 or swapped:\n        gap = max(1, int(gap / shrink))\n        swapped = False\n        for i in range(0, n - gap):\n            try:\n                if arr[i] > arr[i + gap]:\n                    arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                    swapped = True\n            except TypeError as e:\n                raise TypeError(f\"Incomparable elements at indices {i} and {i+gap}\") from e\n    return arr"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(lst, sublist):\n    \"\"\"Checks if a sublist is a contiguous subsequence of a list.\n\n    An empty sublist is considered contained in any list.\n    \"\"\"\n    n = len(lst)\n    m = len(sublist)\n\n    if m == 0:\n        return True\n\n    if m > n:\n        return False\n\n    for i in range(n - m + 1):\n        if lst[i : i + m] == sublist:\n            return True\n\n    return False"}
{"task_id": "Mbpp/72", "solution": "def dif_Square(n: int) -> bool:\n    \"\"\"\n    Checks if an integer can be represented as the difference of two squares.\n    This function implements the mathematical rule n % 4 != 2 within a layered architecture.\n    \"\"\"\n\n    class Validator:\n        \"\"\"Handles validation of input values, converting them to integers.\"\"\"\n        def validate_int(self, value) -> int:\n            if isinstance(value, int):\n                return value\n            if isinstance(value, str):\n                try:\n                    return int(value.strip())\n                except ValueError:\n                    raise ValueError(f\"Invalid integer string: {value!r}\")\n            raise ValueError(f\"Unsupported type for integer conversion: {type(value)}\")\n\n    class FactorRepository:\n        \"\"\"Provides an in-memory cache for previously computed results.\"\"\"\n        def __init__(self):\n            self._cache = {}\n\n        def get_cached(self, n: int) -> bool | None:\n            return self._cache.get(n)\n\n        def store(self, n: int, result: bool) -> None:\n            self._cache[n] = result\n\n        def clear(self) -> None:\n            self._cache.clear()\n\n    class DiffSquaresService:\n        \"\"\"Encapsulates the core business logic for checking difference of squares.\"\"\"\n        def can_be_difference(self, n: int) -> bool:\n            # Mathematical rule: n is a difference of two squares iff n % 4 != 2\n            return not (n % 4 == 2)\n\n    class DiffSquaresController:\n        \"\"\"Orchestrates validation, caching, and business logic execution.\"\"\"\n        def __init__(self, service: DiffSquaresService, repository: FactorRepository, validator: Validator):\n            self.service = service\n            self.repository = repository\n            self.validator = validator\n\n        def check(self, n: int) -> bool:\n            val = self.validator.validate_int(n)\n            cached = self.repository.get_cached(val)\n            if cached is not None:\n                return cached\n            result = self.service.can_be_difference(val)\n            self.repository.store(val, result)\n            return result\n\n    # Instantiate the components and execute the check through the controller\n    controller = DiffSquaresController(\n        service=DiffSquaresService(),\n        repository=FactorRepository(),\n        validator=Validator(),\n    )\n    return controller.check(n)"}
{"task_id": "Mbpp/75", "solution": "def find_tuples(tuples, k):\n    \"\"\"\n    Finds tuples where all elements are divisible by k from a list of tuples.\n    Assumes k is a non-zero integer and all tuple elements are integers.\n    \"\"\"\n    result = []\n    for t in tuples:\n        if all(x % k == 0 for x in t):\n            result.append(t)\n    return result"}
{"task_id": "Mbpp/74", "solution": "def is_samepatterns(patterns, sequence):\n    \"\"\"\n    Checks if two sequences follow the same pattern mapping, ensuring a bijective relationship.\n    Returns True if a one-to-one consistent mapping exists, False otherwise.\n    \"\"\"\n    if len(patterns) != len(sequence):\n        return False\n\n    pattern_to_value = {}\n    value_to_pattern = {}\n\n    for p, v in zip(patterns, sequence):\n        # Check consistency for pattern -> value mapping\n        if p in pattern_to_value:\n            if pattern_to_value[p] != v:\n                return False\n        else:\n            pattern_to_value[p] = v\n\n        # Check consistency for value -> pattern mapping\n        if v in value_to_pattern:\n            if value_to_pattern[v] != p:\n                return False\n        else:\n            value_to_pattern[v] = p\n\n    return True"}
{"task_id": "Mbpp/77", "solution": "def is_Diff(value: int | str) -> bool:\n    \"\"\"\n    Determines if a number is divisible by 11 using the alternating sum rule.\n    The input can be an integer or a string representation of an integer,\n    and any leading sign (+/-) is ignored.\n    \"\"\"\n    s = str(value)\n    # Remove leading/trailing whitespace and any leading sign\n    s = s.strip()\n    if not s:\n        raise ValueError(\"Empty input\")\n\n    if s[0] in \"+-\":\n        s = s[1:]\n\n    if not s.isdigit():\n        raise ValueError(f\"Invalid integer input: {value}\")\n\n    alternating_sum = 0\n    # Iterate through digits from right to left to apply the alternating sum rule\n    for i, digit_char in enumerate(reversed(s), start=1):\n        digit = ord(digit_char) - 48  # faster than int()\n        # Add for odd positions (rightmost is position 1), subtract for even\n        if i % 2 == 1:\n            alternating_sum += digit\n        else:\n            alternating_sum -= digit\n\n    # A number is divisible by 11 if its alternating sum is divisible by 11\n    return alternating_sum % 11 == 0"}
