{"task_id": "Mbpp/771", "solution": "def check_expression(expression: str) -> bool:\n    \"\"\"Checks if the given expression has balanced brackets using a stack.\"\"\"\n    stack = []\n    pairs = {')': '(', ']': '[', '}': '{'}\n    opens = set(pairs.values())\n\n    for char in expression:\n        if char in opens:\n            stack.append(char)\n        elif char in pairs:\n            if not stack or stack.pop() != pairs[char]:\n                return False\n    return not stack"}
{"task_id": "Mbpp/772", "solution": "def remove_length(text: str, k: int) -> str:\n    \"\"\"\n    Removes all words with a specified alphabetic length k from the given string.\n    Word length is determined by counting only alphabetic characters.\n    \"\"\"\n    words = text.split()\n    kept_words = []\n    for word in words:\n        alpha_len = sum(1 for char in word if char.isalpha())\n        if alpha_len != k:\n            kept_words.append(word)\n    return ' '.join(kept_words)"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(text, pattern):\n    \"\"\"\n    Finds the first occurrence of a substring within a string.\n    Returns (pattern, start_index, end_index) or None if no match.\n    \"\"\"\n    start_index = text.find(pattern)\n    if start_index == -1:\n        return None\n    end_index = start_index + len(pattern)\n    return (pattern, start_index, end_index)"}
{"task_id": "Mbpp/777", "solution": "def find_sum(lst: list) -> int:\n    \"\"\"\n    Calculates the sum of elements that appear exactly once in the list.\n    \"\"\"\n    from collections import Counter\n\n    if not lst:\n        return 0\n\n    counts = Counter(lst)\n    total_sum = sum(val for val, count in counts.items() if count == 1)\n    return total_sum"}
{"task_id": "Mbpp/780", "solution": "from typing import Union, Tuple, List, Iterable, Any\nclass InvalidTupleError(ValueError):\n    \"\"\"Custom exception raised for invalid tuple inputs.\"\"\"\n    pass\nNumeric = Union[int, float]\nPair = Tuple[Numeric, Numeric]\nclass TupleValidator:\n    \"\"\"Provides static methods for validating tuple lists and their elements.\"\"\"\n\n    @staticmethod\n    def _is_number(value: Any) -> bool:\n        \"\"\"Checks if a value is an int or float, excluding boolean.\"\"\"\n        return isinstance(value, (int, float)) and not isinstance(value, bool)\n\n    @staticmethod\n    def validate_tuple(value: Any, index: int) -> Pair:\n        \"\"\"Validates a single element to be a 2-element tuple of numbers.\"\"\"\n        try:\n            a, b = value\n        except Exception:\n            raise InvalidTupleError(f\"Element at index {index} is not a 2-element iterable: {value!r}\")\n        if not TupleValidator._is_number(a) or not TupleValidator._is_number(b):\n            raise InvalidTupleError(f\"Element at index {index} must contain numbers (int/float): {value!r}\")\n        return (a, b)\n\n    @staticmethod\n    def validate_list(tuple_list: Iterable[Any]) -> List[Pair]:\n        \"\"\"Validates an iterable of elements, ensuring each is a valid numeric pair.\"\"\"\n        validated = []\n        for idx, item in enumerate(tuple_list):\n            validated.append(TupleValidator.validate_tuple(item, idx))\n        return validated\nclass CombinationService:\n    \"\"\"Handles the core logic of computing pairwise sums of tuples.\"\"\"\n\n    def __init__(self) -> None:\n        \"\"\"Initializes the CombinationService.\"\"\"\n        pass\n\n    def compute_pairs(self, tuple_list: List[Pair]) -> List[Pair]:\n        \"\"\"Computes all unique unordered pairwise sums from a list of 2-element numeric tuples.\"\"\"\n        n = len(tuple_list)\n        result: List[Pair] = []\n        for i in range(n - 1):\n            ai, bi = tuple_list[i]\n            for j in range(i + 1, n):\n                aj, bj = tuple_list[j]\n                result.append((ai + aj, bi + bj))\n        return result\ndef find_combinations(tuple_list: Iterable[Tuple[Union[int,float], Union[int,float]]]) -> List[Tuple[Union[int,float], Union[int,float]]]:\n    \"\"\"\n    Finds all unordered pairwise combinations of sums from a given list of 2-element tuples.\n\n    Each tuple in the input list must contain two numbers (int or float).\n    The function returns a list of new tuples, where each new tuple is the element-wise sum\n    of two distinct tuples from the input list.\n    \"\"\"\n    validated = TupleValidator.validate_list(tuple_list)\n    if len(validated) < 2:\n        return []\n    svc = CombinationService()\n    return svc.compute_pairs(validated)"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(items: list) -> list:\n    \"\"\"\n    Packs consecutive duplicate elements of a list into sublists.\n    This function processes the list in a single pass, using O(n) time and O(n) space complexity.\n    \"\"\"\n    if not items:\n        return []\n\n    packed_list: list = []\n    current_group: list = [items[0]]\n\n    for i in range(1, len(items)):\n        if items[i] == items[i-1]:\n            current_group.append(items[i])\n        else:\n            packed_list.append(current_group)\n            current_group = [items[i]]\n\n    # Append the last group after the loop finishes\n    packed_list.append(current_group)\n\n    return packed_list"}
{"task_id": "Mbpp/781", "solution": "def count_divisors(n: int) -> bool:\n    \"\"\"\n    Return True if the number of positive divisors of n is even.\n\n    Uses the mathematical property: a positive integer has an odd number of divisors\n    iff it is a perfect square. For valid positive integers, return True when\n    divisor count is even, False when odd.\n\n    Raises:\n        TypeError: if n is not an int.\n        ValueError: if n <= 0.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n\n    # Use math.isqrt for exact integer sqrt handling without floating point errors\n    import math\n    r = math.isqrt(n)\n    return r * r != n"}
{"task_id": "Mbpp/782", "solution": "from .services import OddSubarrayService\nfrom .utils import Validator\n_default_service = OddSubarrayService(Validator())\ndef odd_length_sum(nums: list) -> int:\n    \"\"\"\n    Computes the sum of all odd-length contiguous subarrays for a given list of integers.\n    Delegates the computation to an internal service for validation and core logic.\n    \"\"\"\n    return _default_service.odd_length_sum(nums)"}
{"task_id": "Mbpp/785", "solution": "class ParserError(Exception):\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\n    def __str__(self) -> str:\n        return self.message\nclass TupleDTO:\n    def __init__(self, values: tuple[int, ...]) -> None:\n        self.values = values\n    def as_tuple(self) -> tuple[int, ...]:\n        return self.values\ndef _tokenize(s: str) -> list[str]:\n    content = s.strip()[1:-1]\n    if content == \"\":\n        return []\n    tokens = [t.strip() for t in content.split(\",\")]\n    tokens = [t for t in tokens if t != \"\"]\n    return tokens\ndef _is_int_literal(token: str) -> bool:\n    if token == \"\":\n        return False\n    if token[0] in \"+-\":\n        return token[1:].isdigit()\n    return token.isdigit()\nclass TupleValidator:\n    def validate_format(self, s: str) -> None:\n        if not isinstance(s, str):\n            raise ParserError(\"Input must be a string\")\n        s = s.strip()\n        if not s.startswith(\"(\") or not s.endswith(\")\"):\n            raise ParserError(\"Tuple must start with '(' and end with ')'\")\nclass TupleParser:\n    def __init__(self, validator: TupleValidator | None = None) -> None:\n        self._validator = validator or TupleValidator()\n\n    def parse(self, s: str) -> tuple[int, ...]:\n        if not isinstance(s, str):\n            raise ParserError(\"Input must be a string\")\n        self._validator.validate_format(s)\n        tokens = _tokenize(s)\n        ints = self._parse_elements(tokens)\n        dto = TupleDTO(tuple(ints))\n        return dto.as_tuple()\n\n    def _parse_elements(self, tokens: list[str]) -> list[int]:\n        result: list[int] = []\n        for t in tokens:\n            if not _is_int_literal(t):\n                raise ParserError(f\"Invalid integer literal: {t!r}\")\n            try:\n                result.append(int(t))\n            except ValueError as e:\n                raise ParserError(f\"Cannot parse integer: {t!r}\") from e\n        return result\ndef tuple_str_int(s: str) -> tuple[int, ...]:\n    \"\"\"Converts a string representation of an integer tuple to an actual tuple of integers.\"\"\"\n    parser = TupleParser()\n    return parser.parse(s)"}
{"task_id": "Mbpp/784", "solution": "def mul_even_odd(numbers):\n    \"\"\"\n    Return the product of the first odd and the first even number found in the iterable `numbers`.\n\n    Raises:\n        TypeError: if `numbers` is not iterable or contains unsupported element types.\n        ValueError: if an element is a non-integral float or if no odd/even number is found.\n    \"\"\"\n    try:\n        iterator = iter(numbers)\n    except TypeError:\n        raise TypeError(\"numbers must be an iterable\")\n\n    first_odd = None\n    first_even = None\n\n    for x in iterator:\n        # Coerce/validate element to an int where sensible\n        if isinstance(x, int):\n            num = x\n        elif isinstance(x, float):\n            if x.is_integer():\n                num = int(x)\n            else:\n                raise ValueError(f\"Non-integral float encountered: {x}\")\n        elif isinstance(x, str):\n            try:\n                num = int(x)\n            except ValueError:\n                raise ValueError(f\"String element is not an integer representation: {x!r}\")\n        else:\n            raise TypeError(f\"Unsupported element type: {type(x)}\")\n\n        if first_odd is None and (num % 2 != 0):\n            first_odd = num\n        if first_even is None and (num % 2 == 0):\n            first_even = num\n\n        if first_odd is not None and first_even is not None:\n            return first_odd * first_even\n\n    raise ValueError(\"Input must contain at least one odd and one even number\")"}
{"task_id": "Mbpp/788", "solution": "class TupleInput:\n    \"\"\"DTO for tuple creation inputs.\"\"\"\n    def __init__(self, items: list[str], extra: str) -> None:\n        self.items = items\n        self.extra = extra\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input parameters.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass InputValidator:\n    \"\"\"Validates inputs for tuple creation.\"\"\"\n    def validate_items(self, items: list[str]) -> None:\n        if not isinstance(items, (list, tuple)):\n            raise InvalidInputError(\"items must be a list or tuple of strings\")\n        for i, el in enumerate(items):\n            if not isinstance(el, str):\n                raise InvalidInputError(f\"items[{i}] is not a string: {el!r}\")\n\n    def validate_extra(self, extra: str, allow_empty: bool = True) -> None:\n        if not isinstance(extra, str):\n            raise InvalidInputError(\"extra must be a string\")\n        if not allow_empty and extra == \"\":\n            raise InvalidInputError(\"extra must be non-empty\")\n\n    def validate(self, input: TupleInput, allow_empty_extra: bool = True) -> None:\n        self.validate_items(input.items)\n        self.validate_extra(input.extra, allow_empty=allow_empty_extra)\ndef to_tuple(items: list[str], extra: str) -> tuple[str, ...]:\n    \"\"\"Converts a list and an extra string into a single tuple.\"\"\"\n    return tuple(items) + (extra,)\nclass TupleService:\n    \"\"\"Provides business logic for creating a tuple.\"\"\"\n    def __init__(self, validator: InputValidator) -> None:\n        self._validator = validator\n\n    def create_tuple(self, input: TupleInput, allow_empty_extra: bool = True) -> tuple[str, ...]:\n        self._validator.validate(input, allow_empty_extra)\n        return to_tuple(input.items, input.extra)\ndef new_tuple(items: list[str], extra: str) -> tuple[str, ...]:\n    \"\"\"\n    Creates a new tuple from the given list of strings and an additional string.\n    Inputs are validated before tuple creation.\n    \"\"\"\n    validator = InputValidator()\n    service = TupleService(validator)\n    input_dto = TupleInput(items, extra)\n    return service.create_tuple(input_dto)"}
{"task_id": "Mbpp/787", "solution": "import re\nfrom typing import Dict, Optional\nclass TextMatchError(Exception):\n    \"\"\"Base exception for text matching errors.\"\"\"\n    pass\nclass PatternNotFoundError(TextMatchError):\n    \"\"\"Raised when a requested pattern is not found in the repository.\"\"\"\n    pass\nclass Utils:\n    \"\"\"Utility methods for text validation and pattern compilation.\"\"\"\n    @staticmethod\n    def validate_text(text: str) -> None:\n        \"\"\"Validates that the input is a string.\"\"\"\n        if not isinstance(text, str):\n            raise TextMatchError(\"Input must be a str\")\n\n    @staticmethod\n    def compile_pattern(pattern_str: str, flags: int = 0) -> re.Pattern:\n        \"\"\"Compiles a regex pattern string into a re.Pattern object.\"\"\"\n        try:\n            return re.compile(pattern_str, flags)\n        except re.error as e:\n            raise TextMatchError(f\"Invalid regex: {e}\") from e\nclass RegexRepository:\n    \"\"\"Manages compiled regex patterns in memory.\"\"\"\n    def __init__(self) -> None:\n        self._patterns: Dict[str, re.Pattern] = {}\n\n    def add_pattern(self, name: str, pattern_str: str, flags: int = 0) -> None:\n        \"\"\"Adds a compiled pattern to the repository.\"\"\"\n        compiled = Utils.compile_pattern(pattern_str, flags)\n        self._patterns[name] = compiled\n\n    def get_pattern(self, name: str) -> re.Pattern:\n        \"\"\"Retrieves a compiled pattern by name.\"\"\"\n        if name not in self._patterns:\n            raise PatternNotFoundError(f\"Pattern '{name}' not found\")\n        return self._patterns[name]\n\n    def has_pattern(self, name: str) -> bool:\n        \"\"\"Checks if a pattern exists in the repository.\"\"\"\n        return name in self._patterns\nclass Matcher:\n    \"\"\"Performs regex match operations on text.\"\"\"\n    def matches(self, pattern: re.Pattern, text: str, full_match: bool = False) -> bool:\n        \"\"\"Performs either a fullmatch or search operation with the given pattern.\"\"\"\n        Utils.validate_text(text)\n        if full_match:\n            return bool(pattern.fullmatch(text))\n        return bool(pattern.search(text))\nDEFAULT_PATTERN_NAME: str = \"abbb_pattern\"\nPATTERN_ABBB: str = r\"ab{3}\"\nFULL_MATCH_FLAG: bool = False\nclass MatcherService:\n    \"\"\"Orchestrates pattern matching using a repository and matcher.\"\"\"\n    def __init__(self, repo: Optional[RegexRepository] = None, matcher: Optional[Matcher] = None) -> None:\n        \"\"\"Initializes the service with optional injected dependencies.\"\"\"\n        self.repo = repo or RegexRepository()\n        self.matcher = matcher or Matcher()\n\n    def register_default_patterns(self) -> None:\n        \"\"\"Registers default patterns into the repository if they don't exist.\"\"\"\n        if not self.repo.has_pattern(DEFAULT_PATTERN_NAME):\n            self.repo.add_pattern(DEFAULT_PATTERN_NAME, PATTERN_ABBB)\n\n    def match(self, pattern_name: str, text: str, full_match: bool = False) -> bool:\n        \"\"\"Matches text against a named pattern from the repository.\"\"\"\n        pattern = self.repo.get_pattern(pattern_name)\n        return self.matcher.matches(pattern, text, full_match)\ndef create_default_service() -> MatcherService:\n    \"\"\"Creates and initializes a MatcherService with default patterns.\"\"\"\n    svc = MatcherService()\n    svc.register_default_patterns()\n    return svc\ndef text_match_three(text: str) -> bool:\n    \"\"\"\n    Checks if the input string contains the sequence 'a' followed by exactly three 'b' characters.\n    This function acts as a convenience wrapper around a default matching service.\n    \"\"\"\n    svc = create_default_service()\n    return svc.match(DEFAULT_PATTERN_NAME, text, full_match=FULL_MATCH_FLAG)"}
{"task_id": "Mbpp/786", "solution": "from typing import Sequence, TypeVar\nT = TypeVar(\"T\")\ndef right_insertion(seq: Sequence[T], value: T) -> int:\n    \"\"\"\n    Locate the right insertion point for a specified value in sorted order.\n    The index returned is such that all elements up to `index-1` are less than or equal to `value`.\n    \"\"\"\n    lo, hi = 0, len(seq)\n    while lo < hi:\n        mid = (lo + hi) // 2\n        if seq[mid] <= value:\n            lo = mid + 1\n        else:\n            hi = mid\n    return lo"}
