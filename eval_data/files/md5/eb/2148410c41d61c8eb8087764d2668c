{"task_id": "Mbpp/80", "solution": "def tetrahedral_number(n: int) -> int:\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be >= 0\")\n    return n * (n + 1) * (n + 2) // 6"}
{"task_id": "Mbpp/82", "solution": "import math\nfrom typing import Any\nclass InvalidRadiusError(Exception):\n    \"\"\"Exception raised for invalid radius values.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass SphereModel:\n    \"\"\"Represents a sphere with a given radius.\"\"\"\n    def __init__(self, radius: float) -> None:\n        self._radius: float = float(radius)\n\n    def get_radius(self) -> float:\n        return self._radius\nclass Validator:\n    \"\"\"Validates and normalizes radius inputs.\"\"\"\n    def validate_radius(self, value: Any) -> float:\n        try:\n            r = float(value)\n        except (TypeError, ValueError):\n            raise InvalidRadiusError(f\"Radius must be numeric; got {value!r}\")\n        if math.isnan(r) or math.isinf(r):\n            raise InvalidRadiusError(\"Radius must be a finite number\")\n        if r < 0:\n            raise InvalidRadiusError(\"Radius must be non-negative\")\n        return r\nPI: float = math.pi\nclass VolumeService:\n    \"\"\"Calculates the volume of a sphere.\"\"\"\n    def __init__(self, pi: float = PI) -> None:\n        self._pi = pi\n\n    def calculate(self, sphere: SphereModel) -> float:\n        \"\"\"Computes the volume given a SphereModel.\"\"\"\n        r = sphere.get_radius()\n        return (4.0/3.0) * self._pi * (r ** 3)\ndef volume_sphere(radius: float) -> float:\n    \"\"\"\n    Calculates the volume of a sphere given its radius.\n    It validates the radius and computes the volume.\n    \"\"\"\n    validator = Validator()\n    r = validator.validate_radius(radius)\n    sphere = SphereModel(r)\n    service = VolumeService()\n    return service.calculate(sphere)"}
{"task_id": "Mbpp/84", "solution": "_newman_conway_cache = {1: 1, 2: 1}\ndef sequence(n: int) -> int:\n    \"\"\"\n    Calculates the nth number in the Newman-Conway sequence using dynamic programming with caching.\n    The sequence is defined as P(1)=1, P(2)=1, P(n) = P(P(n-1)) + P(n-P(n-1)) for n > 2.\n    \"\"\"\n    if n in _newman_conway_cache:\n        return _newman_conway_cache[n]\n\n    for i in range(3, n + 1):\n        if i not in _newman_conway_cache:\n            p_n_minus_1_val = _newman_conway_cache[i - 1]\n            term1_index = p_n_minus_1_val\n            term2_index = i - p_n_minus_1_val\n            _newman_conway_cache[i] = _newman_conway_cache[term1_index] + _newman_conway_cache[term2_index]\n\n    return _newman_conway_cache[n]"}
{"task_id": "Mbpp/85", "solution": "import math\nclass InvalidRadiusError(ValueError):\n    \"\"\"Custom exception for invalid sphere radius.\"\"\"\n    pass\ndef surfacearea_sphere(radius: float) -> float:\n    \"\"\"Computes the surface area of a sphere given its radius.\n    Raises InvalidRadiusError if the radius is not a non-negative, finite number.\n    \"\"\"\n    try:\n        r = float(radius)\n    except (TypeError, ValueError):\n        raise InvalidRadiusError(\"radius must be a number\")\n\n    if not math.isfinite(r):\n        raise InvalidRadiusError(\"radius must be finite\")\n\n    if r < 0:\n        raise InvalidRadiusError(\"radius must be >= 0\")\n\n    return 4.0 * math.pi * (r ** 2)"}
