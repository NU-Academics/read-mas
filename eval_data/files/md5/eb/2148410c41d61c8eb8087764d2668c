{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(arr, n, i, k):\n    \"\"\"\n    Compute the maximum sum of an increasing subsequence taken entirely from the prefix arr[0..i]\n    (inclusive) and that also includes arr[k] (with k > i). Returns an int.\n\n    Parameters:\n      - arr: list of integers\n      - n: expected length of arr (must equal len(arr))\n      - i: prefix end index (0-based, 0 <= i < n)\n      - k: index of element that must be included (0-based, 0 <= k < n, k > i)\n\n    Behavior:\n      - Find the maximum-sum strictly increasing subsequence that ends at some index j <= i\n        with arr[j] < arr[k], then add arr[k].\n      - If there is no such predecessor (or using any predecessor would decrease the sum),\n        return arr[k].\n    \"\"\"\n    # Basic validation\n    if not isinstance(arr, list):\n        raise TypeError(\"arr must be a list\")\n    if not isinstance(n, int) or n != len(arr):\n        raise ValueError(\"n must be an int equal to len(arr)\")\n    if not isinstance(i, int) or not isinstance(k, int):\n        raise TypeError(\"i and k must be ints\")\n    if not (0 <= i < n):\n        raise IndexError(\"i out of bounds\")\n    if not (0 <= k < n):\n        raise IndexError(\"k out of bounds\")\n    if k <= i:\n        raise ValueError(\"k must be greater than i\")\n    for idx, v in enumerate(arr):\n        if not isinstance(v, int):\n            raise TypeError(f\"arr[{idx}] must be an int\")\n\n    val_k = arr[k]\n\n    # DP: dp[j] = max sum of an increasing subsequence that ends exactly at j (for j in 0..i)\n    dp = [0] * (i + 1)\n    for j in range(i + 1):\n        dp[j] = arr[j]\n        aj = arr[j]\n        for t in range(j):\n            if arr[t] < aj:\n                candidate = dp[t] + aj\n                if candidate > dp[j]:\n                    dp[j] = candidate\n\n    # Find best predecessor sum among indices j where arr[j] < arr[k]\n    max_pre = 0  # treat negative sums as worse than taking no predecessor\n    for j in range(i + 1):\n        if arr[j] < val_k and dp[j] > max_pre:\n            max_pre = dp[j]\n\n    return val_k + max_pre"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the highest power of 2 that is less than or equal to n.\n    Returns 0 for n less than or equal to 0.\n    \"\"\"\n    if n <= 0:\n        return 0\n    # For n > 0, the highest power of 2 <= n is 1 << (n.bit_length() - 1)\n    return 1 << (n.bit_length() - 1)"}
{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(n: int) -> int:\n    \"\"\"\n    Sets the left-most unset bit in a non-negative integer.\n    If all existing bits are set, it sets the next most significant bit.\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n\n    def msb_pos(num: int) -> int:\n        \"\"\"Returns the 0-based position of the most significant bit.\"\"\"\n        return num.bit_length() - 1 if num > 0 else 0\n\n    def find_left_most_unset_bit_pos(num: int) -> int:\n        \"\"\"Finds the 0-based position of the left-most unset bit.\"\"\"\n        msb = msb_pos(num)\n        for pos in range(msb, -1, -1):\n            if not (num >> pos) & 1:  # Check if bit at 'pos' is 0\n                return pos\n        # If all bits from MSB down to 0 are 1, return MSB + 1\n        return msb + 1\n\n    def set_bit_at_pos(num: int, pos: int) -> int:\n        \"\"\"Sets the bit at the given 0-based position.\"\"\"\n        return num | (1 << pos)\n\n    pos = find_left_most_unset_bit_pos(n)\n    result = set_bit_at_pos(n, pos)\n    return result"}
{"task_id": "Mbpp/389", "solution": "def find_lucas(n: int) -> int:\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    if n == 0:\n        return 2\n    if n == 1:\n        return 1\n    a, b = 2, 1\n    for _ in range(2, n + 1):\n        a, b = b, a + b\n    return b"}
{"task_id": "Mbpp/312", "solution": "import math\ndef volume_cone(radius: float, height: float) -> float:\n    \"\"\"\n    Calculates the volume of a cone given its radius and height.\n    The formula used is (1/3) * pi * radius^2 * height.\n    \"\"\"\n    return (1.0 / 3.0) * math.pi * (radius ** 2) * height"}
{"task_id": "Mbpp/395", "solution": "def first_non_repeating_character(s: str) -> str | None:\n    \"\"\"\n    Finds the first non-repeated character in the given string.\n    Returns None if no such character exists.\n    \"\"\"\n    char_counts = {}\n    for char in s:\n        char_counts[char] = char_counts.get(char, 0) + 1\n\n    for char in s:\n        if char_counts[char] == 1:\n            return char\n\n    return None"}
{"task_id": "Mbpp/390", "solution": "import re\nfrom typing import Any, Iterable, List, Pattern\ndef add_string(input_list: Iterable[Any], format_str: str) -> List[str]:\n    \"\"\"Applies a format string to each element in a list, handling validation and safe formatting.\"\"\"\n\n    class FormatValidationError(Exception):\n        def __init__(self, message: str):\n            self.message = message\n            super().__init__(message)\n\n    class FormatApplicationError(Exception):\n        def __init__(self, message: str, index: int = None, original: Any = None):\n            self.message = message\n            self.index = index\n            self.original = original\n            super().__init__(message)\n\n    class FormatValidator:\n        ALLOWED_PLACEHOLDER_PATTERN: str = r\"\\{(\\d+)\\}\"\n        def __init__(self) -> None:\n            self._pattern: Pattern = re.compile(self.ALLOWED_PLACEHOLDER_PATTERN)\n\n        def validate(self, fmt: str) -> None:\n            if \"{\" in fmt and \"}\" not in fmt:\n                raise FormatValidationError(\"Unbalanced braces in format\")\n            for match in re.finditer(r\"\\{([^}]*)\\}\", fmt):\n                inner = match.group(1)\n                if not inner.isdigit():\n                    raise FormatValidationError(f\"Only numeric positional placeholders allowed; found: {inner}\")\n            try:\n                fmt.format(\"X\")\n            except Exception as e:\n                raise FormatValidationError(f\"Format syntax invalid: {e}\")\n\n    class SafeFormatter:\n        UNREPRESENTABLE_PLACEHOLDER: str = \"<unrepresentable>\"\n\n        def __init__(self) -> None:\n            pass\n\n        def _safe_repr(self, element: Any) -> str:\n            try:\n                return str(element)\n            except Exception:\n                return self.UNREPRESENTABLE_PLACEHOLDER\n\n        def format_element(self, fmt: str, element: Any) -> str:\n            value = self._safe_repr(element)\n            try:\n                return fmt.format(value)\n            except Exception as e:\n                raise FormatApplicationError(f\"Formatting failed: {e}\", original=element)\n\n    validator = FormatValidator()\n    formatter = SafeFormatter()\n\n    validator.validate(format_str)\n\n    result: List[str] = []\n    for idx, el in enumerate(input_list):\n        try:\n            formatted = formatter.format_element(format_str, el)\n        except FormatApplicationError as e:\n            raise FormatApplicationError(f\"Failed at index {idx}: {e.message}\", index=idx, original=el)\n        result.append(formatted)\n\n    return result"}
{"task_id": "Mbpp/392", "solution": "def get_max_sum(n: int) -> int:\n    memo = {}\n\n    def _compute(k: int) -> int:\n        \"\"\"Computes the maximum sum for k using memoization.\"\"\"\n        if k in memo:\n            return memo[k]\n\n        if k == 0:\n            memo[k] = 0\n            return 0\n\n        val_div_2 = _compute(k // 2)\n        val_div_3 = _compute(k // 3)\n        val_div_4 = _compute(k // 4)\n        val_div_5 = _compute(k // 5)\n\n        current_sum = val_div_2 + val_div_3 + val_div_4 + val_div_5\n        result = max(current_sum, k)\n\n        memo[k] = result\n        return result\n\n    return _compute(n)"}
