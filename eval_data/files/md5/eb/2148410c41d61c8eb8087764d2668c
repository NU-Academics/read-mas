{"task_id": "Mbpp/479", "solution": "from decimal import Decimal, InvalidOperation\ndef first_Digit(value):\n    \"\"\"\n    Finds the first significant digit of a given number, handling various input types.\n    It supports integers, floats, and numeric strings, including negative values and scientific notation.\n    \"\"\"\n    class FirstDigitError(Exception):\n        \"\"\"Base exception for first_Digit function errors.\"\"\"\n        pass\n\n    class InvalidInputError(FirstDigitError):\n        \"\"\"Raised when input cannot be interpreted as a number.\"\"\"\n        pass\n\n    class NoDigitsError(FirstDigitError):\n        \"\"\"Raised when a numeric input contains no significant digits.\"\"\"\n        pass\n\n    try:\n        # Convert input to a string and strip whitespace for robust Decimal parsing\n        # across different types and string formats.\n        dec_value = Decimal(str(value).strip())\n    except InvalidOperation:\n        # Catch errors from Decimal conversion for non-numeric or malformed inputs.\n        raise InvalidInputError(f\"Input '{value}' cannot be interpreted as a number.\")\n    except TypeError:\n        # Catch cases where str() or Decimal() might fail due to incompatible types.\n        raise InvalidInputError(f\"Input type {type(value).__name__} is not supported.\")\n\n    # Handle zero explicitly as per requirements (FR3).\n    if dec_value == Decimal(0):\n        return 0\n\n    # Get the absolute value and convert it to an engineering string representation.\n    # This avoids scientific notation and simplifies digit extraction (e.g., '0.00123', '12300').\n    abs_str = dec_value.copy_abs().to_eng_string()\n\n    # Iterate through the string representation to find the first digit.\n    for char_digit in abs_str:\n        if char_digit.isdigit():\n            return int(char_digit)\n\n    # This case should be rare if Decimal conversion was successful and not zero,\n    # but provides robustness for any unexpected string content after conversion.\n    raise NoDigitsError(f\"No digits found in the numerical representation of '{value}'.\")"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(arr, n):\n    \"\"\"\n    Counts the number of pairs in a list whose XOR value is odd.\n    A pair's XOR is odd iff one number is odd and the other is even.\n    \"\"\"\n    if not isinstance(arr, (list, tuple)):\n        raise TypeError(\"arr must be a list or tuple of integers\")\n    if not isinstance(n, int):\n        raise TypeError(\"n must be provided as an integer\")\n    if n != len(arr):\n        raise ValueError(\"n does not match length of arr\")\n\n    odd_count = 0\n    even_count = 0\n    for i, num in enumerate(arr):\n        if not isinstance(num, int):\n            raise TypeError(f\"element at index {i} is not an int\")\n        if num & 1:  # odd\n            odd_count += 1\n        else:\n            even_count += 1\n    return odd_count * even_count"}
