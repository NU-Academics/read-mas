{"task_id": "Mbpp/410", "solution": "from decimal import Decimal, InvalidOperation\nfrom collections.abc import Sequence, Iterator\nfrom typing import Any, Optional, Union\nclass ValidationError(ValueError):\n    \"\"\"Exception raised for invalid input types.\"\"\"\n    pass\nclass NoNumericElementsError(ValueError):\n    \"\"\"Exception raised when no numeric elements are found in the input.\"\"\"\n    pass\ndef is_sequence(obj: Any) -> bool:\n    \"\"\"Checks if an object is a sequence, excluding strings and bytes.\"\"\"\n    return isinstance(obj, Sequence) and not isinstance(obj, (str, bytes))\nclass MinResult:\n    \"\"\"Data transfer object for the minimum value, with conversion to native types.\"\"\"\n    def __init__(self, value: Decimal):\n        self.value = value\n\n    def as_native(self) -> Union[int, float]:\n        \"\"\"Converts the Decimal value to a native int or float.\"\"\"\n        if self.value == self.value.to_integral_value():\n            return int(self.value)\n        return float(self.value)\nclass TypeCoercion:\n    \"\"\"Converts heterogeneous items to Decimal if numeric or parsable.\"\"\"\n    def __init__(self):\n        pass\n\n    def to_number(self, value: Any) -> Optional[Decimal]:\n        \"\"\"Returns Decimal(value) for numeric types, parses string numbers, returns None otherwise.\"\"\"\n        if isinstance(value, (int, float, Decimal)):\n            return Decimal(str(value))\n        if isinstance(value, str):\n            s = value.strip()\n            try:\n                return Decimal(s)\n            except InvalidOperation:\n                return None\n        return None\nclass ListAdapter:\n    \"\"\"Normalizes incoming sequence to an iterator.\"\"\"\n    def __init__(self):\n        pass\n\n    def iterate(self, source: Any) -> Iterator[Any]:\n        \"\"\"Yields elements from the source sequence.\"\"\"\n        yield from source\nclass MinFinderService:\n    \"\"\"Core algorithm for computing the minimum numeric value.\"\"\"\n    def __init__(self, coercion: \"TypeCoercion\"):\n        self.coercion = coercion\n\n    def find_min(self, iterable: Iterator[Any]) -> Decimal:\n        \"\"\"Iterates elements, coerces to Decimal, tracks and returns minimum.\"\"\"\n        current_min: Optional[Decimal] = None\n        for v in iterable:\n            candidate = self.coercion.to_number(v)\n            if candidate is None:\n                continue\n            if current_min is None:\n                current_min = candidate\n            else:\n                if candidate < current_min:\n                    current_min = candidate\n        if current_min is None:\n            raise NoNumericElementsError(\"No numeric elements found.\")\n        return current_min\nclass MinFinderController:\n    \"\"\"Coordinates input validation, adaptation, and service invocation.\"\"\"\n    def __init__(self, service: \"MinFinderService\", adapter: \"ListAdapter\"):\n        self.service = service\n        self.adapter = adapter\n\n    def min_val(self, items: Any) -> Union[int, float]:\n        \"\"\"Validates input, orchestrates finding the minimum, and converts result.\"\"\"\n        if not is_sequence(items):\n            raise ValidationError(\"Expected a sequence (list/tuple), not str/bytes or other types.\")\n        iterator = self.adapter.iterate(items)\n        decimal_min = self.service.find_min(iterator)\n        return MinResult(decimal_min).as_native()\n_default_controller = MinFinderController(\n    service=MinFinderService(coercion=TypeCoercion()),\n    adapter=ListAdapter(),\n)\ndef min_val(items: Sequence[Any]) -> Union[int, float]:\n    \"\"\"Finds the minimum numeric value in a heterogeneous list.\"\"\"\n    return _default_controller.min_val(items)"}
