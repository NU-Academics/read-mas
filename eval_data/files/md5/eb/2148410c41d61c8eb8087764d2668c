{"task_id": "Mbpp/440", "solution": "import re\nfrom dataclasses import dataclass\nfrom typing import List, Optional, Set, Tuple\nTOKEN_RE = r\"[A-Za-z]+(?:['-][A-Za-z]+)*\"\ndef alphabetic_subspan(sentence: str, start: int, end: int) -> Tuple[int,int,str]:\n    \"\"\"\n    Extracts the contiguous alphabetic substring within a given span, handling attached punctuation.\n    \"\"\"\n    sub = sentence[start:end]\n    m = re.search(TOKEN_RE, sub)\n    if not m:\n        return start, start, \"\"\n    a_start = start + m.start()\n    a_end = start + m.end()\n    return a_start, a_end, sentence[a_start:a_end]\nclass Tokenizer:\n    \"\"\"Tokenizes a sentence into a list of Token objects based on a regex pattern.\"\"\"\n    TOKEN_RE = TOKEN_RE\n\n    def tokenize(self, sentence: str) -> List[Token]:\n        tokens = []\n        for m in re.finditer(self.TOKEN_RE, sentence):\n            tokens.append(Token(m.group(0), m.start(), m.end()))\n        return tokens\nclass FindAdverbService:\n    \"\"\"Provides the core logic for finding the first adverb in a sentence using heuristic rules.\"\"\"\n    DEFAULT_EXCEPTION_WORDS: Set[str] = {\"family\", \"sly\"}\n\n    def __init__(self, tokenizer: Optional[Tokenizer] = None, exceptions: Optional[Set[str]] = None) -> None:\n        self.tokenizer = tokenizer or Tokenizer()\n        self.exceptions = {w.lower() for w in (exceptions or self.DEFAULT_EXCEPTION_WORDS)}\n\n    def find_adverb_match(self, sentence: str) -> Optional[AdverbMatch]:\n        \"\"\"\n        Finds the first adverb-like token based on heuristic rules and returns an AdverbMatch.\n        \"\"\"\n        for tok in self.tokenizer.tokenize(sentence):\n            a_start, a_end, a_text = alphabetic_subspan(sentence, tok.start, tok.end)\n            if a_text and a_text.lower().endswith(\"ly\") and len(a_text) >= 3 and a_text.lower() not in self.exceptions:\n                return AdverbMatch(a_start, a_end, a_text)\n        return None\ndef find_adverb_position(sentence: str) -> Optional[Tuple[int,int,str]]:\n    \"\"\"\n    Finds the first adverb and its position in a given sentence.\n\n    Returns a tuple (start_index, end_index, adverb_text) or None if no adverb is found.\n    \"\"\"\n    svc = FindAdverbService()\n    match = svc.find_adverb_match(sentence)\n    return (match.start, match.end, match.text) if match else None"}
{"task_id": "Mbpp/441", "solution": "from typing import Any\nclass InvalidDimensionError(Exception):\n    \"\"\"Custom exception for invalid dimension inputs.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\ndef parse_float(text: Any) -> float:\n    \"\"\"Attempts to parse input as a float, raising InvalidDimensionError on failure.\"\"\"\n    try:\n        return float(text)\n    except (TypeError, ValueError):\n        raise InvalidDimensionError(f\"Cannot parse size from {text!r}\")\nclass DimensionValidator:\n    \"\"\"Validates and normalizes edge length inputs.\"\"\"\n    def validate_size(self, size: Any) -> float:\n        # Converts numeric-like inputs to float and ensures > 0.\n        f = parse_float(size)\n        if f <= 0:\n            raise InvalidDimensionError(f\"size must be > 0, got {f}\")\n        return f\nclass Cube:\n    \"\"\"Represents a cube with an edge size.\"\"\"\n    def __init__(self, size: float) -> None:\n        self.size: float = float(size)\nclass SurfaceAreaCalculator:\n    \"\"\"Calculates the surface area of a cube.\"\"\"\n    def calculate(self, cube: Cube) -> float:\n        return self.formula_static(cube.size)\n\n    @staticmethod\n    def formula_static(size: float) -> float:\n        return 6.0 * (size ** 2)\ndef surfacearea_cube(size: float) -> float:\n    \"\"\"Calculates the surface area of a cube of a given size.\"\"\"\n    validator = DimensionValidator()\n    valid_size = validator.validate_size(size)\n    cube = Cube(valid_size)\n    calc = SurfaceAreaCalculator()\n    return calc.calculate(cube)"}
{"task_id": "Mbpp/445", "solution": "def index_multiplication(tuple_a, tuple_b):\n    \"\"\"\n    Performs index-wise multiplication of elements from two tuples of tuples.\n    Elements are promoted to float if any operand is float, otherwise they remain int.\n    \"\"\"\n    result_outer_tuple = []\n    for inner_tuple_a, inner_tuple_b in zip(tuple_a, tuple_b):\n        result_inner_tuple = []\n        for x, y in zip(inner_tuple_a, inner_tuple_b):\n            product = x * y\n            # Promote to float if either x or y is float; otherwise keep as int\n            result_inner_tuple.append(int(product) if isinstance(x, int) and isinstance(y, int) else float(product))\n        result_outer_tuple.append(tuple(result_inner_tuple))\n    return tuple(result_outer_tuple)"}
{"task_id": "Mbpp/446", "solution": "def count_Occurrence(source: tuple, targets: list) -> int:\n    \"\"\"\n    Count total occurrences of all elements in `targets` within the `source` tuple.\n    By default, targets are treated as unique (duplicates in `targets` are ignored).\n    \"\"\"\n    from collections import Counter\n\n    # Normalize source to a tuple if possible\n    if not isinstance(source, tuple):\n        try:\n            source = tuple(source)\n        except TypeError as exc:\n            raise TypeError(\"`source` must be an iterable convertible to a tuple\") from exc\n\n    # Normalize targets to a sequence\n    try:\n        targets_seq = tuple(targets)\n    except TypeError as exc:\n        raise TypeError(\"`targets` must be an iterable\") from exc\n\n    if not source or not targets_seq:\n        return 0\n\n    # Prefer deduplicated targets for counting (as in the example)\n    try:\n        unique_targets = set(targets_seq)\n    except TypeError:\n        # Some target items may be unhashable; fall back to counting each target individually\n        total = 0\n        for t in targets_seq:\n            total += sum(1 for s in source if s == t)\n        return total\n\n    counts = Counter(source)\n    return sum(counts.get(t, 0) for t in unique_targets)"}
