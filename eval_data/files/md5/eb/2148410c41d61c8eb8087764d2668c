{"task_id": "Mbpp/638", "solution": "from decimal import Decimal, ROUND_HALF_UP\ndef wind_chill(velocity_kmh: float, temperature_c: float) -> int:\n    \"\"\"\n    Calculates the wind chill index using the standard formula.\n    The result is rounded to the nearest integer, with ties rounding half-up.\n    \"\"\"\n    # WCI formula coefficients\n    WCI_A = 13.12\n    WCI_B = 0.6215\n    WCI_C = 11.37\n    WCI_D = 0.3965\n\n    # v^0.16 term (handle zero velocity explicitly)\n    v_power_016 = velocity_kmh ** 0.16 if velocity_kmh > 0 else 0.0\n\n    # Compute raw wind chill index\n    raw_wci = WCI_A + (WCI_B * temperature_c) - (WCI_C * v_power_016) + (WCI_D * temperature_c * v_power_016)\n\n    # Round half-up to nearest integer\n    rounded_wci_decimal = Decimal(str(raw_wci)).quantize(Decimal('1'), rounding=ROUND_HALF_UP)\n\n    return int(rounded_wci_decimal)"}
{"task_id": "Mbpp/641", "solution": "import math\ndef is_nonagonal(value: int) -> bool:\n    \"\"\"\n    Determines if a given integer is a nonagonal number.\n    Uses the inverse nonagonal number formula to check for an integer 'n'.\n    \"\"\"\n    # The formula for the nth nonagonal number is P(9, n) = (7*n^2 - 5*n) / 2\n    # To check if 'value' is a nonagonal number, solve 7n^2 - 5n - 2*value = 0\n    # Positive root: n = (5 + sqrt(25 + 56*value)) / 14\n\n    discriminant = 25 + 56 * value\n    if discriminant < 0:\n        return False\n\n    root = math.isqrt(discriminant)\n    if root * root != discriminant:\n        return False\n\n    n_numerator = 5 + root\n    return n_numerator % 14 == 0"}
{"task_id": "Mbpp/639", "solution": "def sample_nam(names: list[str]) -> int:\n    \"\"\"\n    Sums the length of names after removing those that start with a lowercase letter.\n    Names are trimmed, and empty strings or those becoming empty after trimming are excluded.\n    \"\"\"\n    total_length = 0\n    for name in names:\n        stripped_name = name.strip()\n\n        # Exclude empty strings or strings that become empty after trimming\n        if not stripped_name:\n            continue\n\n        first_char = stripped_name[0]\n        should_keep = False\n\n        if first_char.isalpha():\n            # If it's an alphabetic character, keep only if it's uppercase\n            if first_char.isupper():\n                should_keep = True\n        else:\n            # Keep names that do not start with a letter (e.g., digits, punctuation)\n            should_keep = True\n\n        if should_keep:\n            total_length += len(stripped_name)\n\n    return total_length"}
{"task_id": "Mbpp/643", "solution": "import re\ndef text_match_wordz_middle(text: str) -> bool:\n    \"\"\"\n    Checks if the string contains a lowercase 'z' that is preceded and followed by a word character.\n    This effectively means 'z' appears in the middle of a word.\n    \"\"\"\n    # The pattern matches 'z' only if it has a word character (\\w) immediately before and after it.\n    pattern = r\"(?<=\\w)z(?=\\w)\"\n    return re.search(pattern, text) is not None"}
{"task_id": "Mbpp/720", "solution": "import copy\nfrom typing import Any, Dict, Tuple\ndef add_dict_to_tuple(t: Tuple[Any, ...], d: Dict[str, Any]) -> Tuple[Any, ...]:\n    \"\"\"Appends a deep copy of a dictionary as a single element to a tuple.\n\n    Ensures the original dictionary is not mutated.\n    \"\"\"\n    copied_d = copy.deepcopy(d)\n    return t + (copied_d,)"}
{"task_id": "Mbpp/644", "solution": "from typing import Sequence, Any, List\nfrom collections import deque\nimport uuid\nfrom datetime import datetime\nclass InvalidPositionError(ValueError):\n    \"\"\"Custom exception raised for invalid K positions.\"\"\"\n    pass\nclass Validator:\n    \"\"\"Utility class for validating array and k inputs.\"\"\"\n    def validate_array(self, arr: Any) -> List[Any]:\n        if isinstance(arr, list):\n            return list(arr)  # shallow copy\n        if isinstance(arr, tuple):\n            return list(arr)\n        if hasattr(arr, '__iter__') and not isinstance(arr, (str, bytes)):\n             try:\n                 return list(arr)\n             except TypeError:\n                 raise TypeError(\"arr must be an iterable that can be converted to a list\")\n        raise TypeError(\"arr must be a list, tuple, or other iterable\")\n\n    def validate_k(self, k: Any, n: int) -> int:\n        try:\n            k_int = int(k)\n        except (TypeError, ValueError):\n            raise InvalidPositionError(\"k must be an integer\")\n        if not (0 <= k_int <= n):\n            raise InvalidPositionError(f\"k must be between 0 and {n} (inclusive)\")\n        return k_int\nclass OperationRecord:\n    \"\"\"Data transfer object for recording operations.\"\"\"\n    def __init__(self, id: str, input_list: List[Any], k: int, result_list: List[Any], timestamp: datetime) -> None:\n        self.id = id\n        self.input_list = input_list\n        self.k = k\n        self.result_list = result_list\n        self.timestamp = timestamp\nclass OperationRepository:\n    \"\"\"In-memory repository for storing operation records with a bounded history.\"\"\"\n    def __init__(self, max_size: int = 100):\n        self._max_size = max_size\n        self._store = deque()\n\n    def add(self, record: OperationRecord) -> None:\n        self._store.append(record)\n        if len(self._store) > self._max_size:\n            self._store.popleft()\n\n    def list_recent(self, limit: int = 10) -> List[OperationRecord]:\n        return list(self._store)[-limit:]\nclass ArrayReverserService:\n    \"\"\"Core business logic for reversing arrays and orchestrating validation and recording.\"\"\"\n    def __init__(self, repository: OperationRepository, validator: Validator) -> None:\n        self._repo = repository\n        self._validator = validator\n\n    def reverse_upto(self, arr: Sequence[Any], k: int, in_place: bool = False) -> List[Any]:\n        validated_list = self._validator.validate_array(arr)\n        n = len(validated_list)\n        validated_k = self._validator.validate_k(k, n)\n\n        if validated_k == 0:\n            result = validated_list.copy()\n        elif in_place:\n            # Perform in-place reversal on a mutable list\n            i, j = 0, validated_k - 1\n            while i < j:\n                validated_list[i], validated_list[j] = validated_list[j], validated_list[i]\n                i += 1\n                j -= 1\n            result = validated_list\n        else:\n            # Create a new list with reversed prefix\n            result = validated_list[:validated_k][::-1] + validated_list[validated_k:]\n\n        record = OperationRecord(\n            id=str(uuid.uuid4()),\n            input_list=list(arr), # Store a copy of original input for record\n            k=validated_k,\n            result_list=list(result), # Store a copy of the result\n            timestamp=datetime.utcnow()\n        )\n        self._repo.add(record)\n        return result\nDEFAULT_HISTORY_SIZE: int = 100\ndef reverse_Array_Upto_K(arr: Sequence[Any], k: int) -> List[Any]:\n    repo = OperationRepository(max_size=DEFAULT_HISTORY_SIZE)\n    validator = Validator()\n    svc = ArrayReverserService(repo, validator)\n    return svc.reverse_upto(arr, k, in_place=False)"}
{"task_id": "Mbpp/724", "solution": "def power_base_sum(base, power):\n    \"\"\"Calculates the sum of all digits of the base raised to the specified power.\"\"\"\n    result = base ** power\n    digit_sum = 0\n    for digit_char in str(result):\n        digit_sum += int(digit_char)\n    return digit_sum"}
