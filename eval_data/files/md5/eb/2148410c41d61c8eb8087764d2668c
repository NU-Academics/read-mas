{"task_id": "Mbpp/554", "solution": "import datetime\nfrom abc import ABC, abstractmethod\nfrom typing import Any, Dict, List, Optional\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass Validator:\n    \"\"\"Validates input lists to ensure they contain only integers.\"\"\"\n    def validate_int_list(self, numbers: Any) -> List[int]:\n        if numbers is None:\n            raise InvalidInputError(\"Input cannot be None\")\n        if not isinstance(numbers, (list, tuple)):\n            raise InvalidInputError(\"Input must be a list or tuple\")\n        result: List[int] = []\n        for i, v in enumerate(numbers):\n            if not isinstance(v, int):\n                raise InvalidInputError(f\"Element at index {i} is not int: {v!r}\")\n            result.append(v)\n        return result\nclass ResultRepository(ABC):\n    \"\"\"Abstract base class for persistence repositories.\"\"\"\n    @abstractmethod\n    def save(self, record: Dict) -> None:\n        raise NotImplementedError\nclass PersistenceRecord:\n    \"\"\"Data transfer object for logging input/output.\"\"\"\n    def __init__(self, input: List[int], output: List[int], ts: str) -> None:\n        self.input = input\n        self.output = output\n        self.ts = ts\n\n    def to_dict(self) -> Dict:\n        return {\"input\": self.input, \"output\": self.output, \"ts\": self.ts}\nclass OddFilterService:\n    \"\"\"Provides business logic for filtering odd integers and optional persistence.\"\"\"\n    def __init__(self, validator: Validator, repository: Optional[ResultRepository] = None) -> None:\n        self._validator = validator\n        self._repository = repository\n\n    def filter_odds(self, numbers: List[int]) -> List[int]:\n        nums = self._validator.validate_int_list(numbers)\n        odds = [n for n in nums if n % 2 != 0]\n        if self._repository is not None:\n            record = PersistenceRecord(input=nums, output=odds, ts=datetime.datetime.utcnow().isoformat() + \"Z\")\n            try:\n                self._repository.save(record.to_dict())\n            except Exception:\n                pass # Swallow to avoid failing core functionality; could log\n        return odds\ndef Split(numbers: List[int]) -> List[int]:\n    \"\"\"Public API that returns odd integers from a list of numbers.\"\"\"\n    validator = Validator()\n    service = OddFilterService(validator, repository=None)\n    return service.filter_odds(numbers)"}
