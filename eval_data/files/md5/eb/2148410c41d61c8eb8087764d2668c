{"task_id": "Mbpp/252", "solution": "import math\nfrom dataclasses import dataclass\nfrom typing import Union, Tuple\nclass ConversionError(Exception):\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\n    def __str__(self) -> str:\n        return self.message\nclass AngleUtils:\n    @staticmethod\n    def normalize(theta: float) -> float:\n        \"\"\"Normalize angle to [-pi, pi) and handle non-finite values.\"\"\"\n        if not math.isfinite(theta):\n            raise ConversionError(\"angle is not finite\")\n\n        pi = math.pi\n        while theta >= pi:\n            theta -= 2 * pi\n        while theta < -pi:\n            theta += 2 * pi\n\n        if theta == -0.0: # Normalize -0.0 to 0.0 for consistency\n            theta = 0.0\n        return theta\nclass ComplexParser:\n    def parse(self, value: Union[int, float, complex, tuple, list, str]) -> complex:\n        \"\"\"Parse various inputs into a complex number.\"\"\"\n        if isinstance(value, complex):\n            return value\n        if isinstance(value, (int, float)):\n            return complex(float(value), 0.0)\n        if isinstance(value, (tuple, list)):\n            if len(value) != 2:\n                raise ConversionError(\"sequence must have length 2\")\n            try:\n                return complex(float(value[0]), float(value[1]))\n            except (TypeError, ValueError) as e:\n                raise ConversionError(f\"invalid sequence elements for complex number: {e}\") from e\n        if isinstance(value, str):\n            try:\n                return complex(value.strip())\n            except Exception as e:\n                raise ConversionError(f\"cannot parse complex from string: {e}\") from e\n        raise ConversionError(f\"unsupported input type: {type(value).__name__}\")\nclass ConverterService:\n    def to_polar(self, z: complex) -> PolarCoordinate:\n        \"\"\"Convert a complex number to polar coordinates (r, theta).\"\"\"\n        if not isinstance(z, complex):\n            raise ConversionError(\"to_polar expects a complex number\")\n\n        r = math.hypot(z.real, z.imag)\n        theta = math.atan2(z.imag, z.real) if r != 0.0 else 0.0\n        theta = AngleUtils.normalize(theta)\n\n        return PolarCoordinate(r=float(r), theta=float(theta))\ndef convert(value: Union[int, float, complex, tuple, list, str]) -> Tuple[float, float]:\n    \"\"\"\n    Converts various representations of complex numbers to polar coordinates (radius r, angle theta).\n    The angle theta is normalized to the interval [-pi, pi).\n    \"\"\"\n    _parser = ComplexParser()\n    _service = ConverterService()\n\n    z = _parser.parse(value)\n    polar = _service.to_polar(z)\n\n    return (float(polar.r), float(polar.theta))"}
{"task_id": "Mbpp/253", "solution": "from typing import Sequence, Any\ndef count_integer(items: Sequence[Any]) -> int:\n    \"\"\"\n    Counts the number of integer elements in a given list, adhering to specific type rules.\n    Booleans are explicitly treated as non-integers for counting purposes.\n    \"\"\"\n    total = 0\n    for item in items:\n        # An item is counted as an integer if its type is exactly 'int'\n        # and it is not a boolean, as per the design's strict integer rule.\n        if type(item) is int and not isinstance(item, bool):\n            total += 1\n    return total"}
