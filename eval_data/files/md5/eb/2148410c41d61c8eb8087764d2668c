{"task_id": "Mbpp/391", "solution": "import os\nimport time\nimport json\nfrom typing import Sequence, Any, Optional, Dict, List\nclass RepositoryError(Exception):\n    \"\"\"Exception raised when persistence fails.\"\"\"\n    pass\nDEFAULT_PERSIST_DIR = \"./.list2dict_store\"\nDEFAULT_TIME_FMT = \"%Y%m%dT%H%M%S\"\nclass ConversionResult:\n    \"\"\"Represents conversion output and metadata.\"\"\"\n    def __init__(self, items: List[Dict], meta: Dict):\n        self.items = items\n        self.meta = meta\n\n    def to_json(self) -> str:\n        \"\"\"Returns JSON string of the result.\"\"\"\n        return to_json(self.to_dict())\n\n    def to_dict(self) -> Dict:\n        \"\"\"Returns dictionary representation of the result.\"\"\"\n        return {\"items\": self.items, \"meta\": self.meta}\ndef to_json(obj: Any) -> str:\n    \"\"\"JSON serialize an object with specific formatting.\"\"\"\n    return json.dumps(obj, ensure_ascii=False, sort_keys=True)\ndef build_nested_dict(keys: Sequence[Any], lists: Sequence[Sequence[Any]], field_names: Optional[Sequence[str]] = None) -> List[Dict]:\n    \"\"\"Produces a list of nested dictionaries from parallel lists.\"\"\"\n    results = []\n    num_lists = len(lists)\n    num_items = len(keys)\n\n    for i in range(num_items):\n        top_key = keys[i]\n        nested_dict = {}\n\n        if num_lists == 2 and field_names is None:\n            # Special case for the assertion example: key -> {second_list_item: third_list_item}\n            # Here `lists` would contain [names_list, values_list]\n            nested_dict[lists[0][i]] = lists[1][i]\n        else:\n            # General case: uses field_names if provided, otherwise 'field_j'\n            for j in range(num_lists):\n                field_name = field_names[j] if field_names and j < len(field_names) else f\"field_{j}\"\n                field_value = lists[j][i]\n                nested_dict[field_name] = field_value\n\n        results.append({top_key: nested_dict})\n    return results\nclass FileRepository:\n    \"\"\"Manages persistent storage of conversion results to JSON files.\"\"\"\n    def __init__(self, base_dir: str = DEFAULT_PERSIST_DIR):\n        self._base_dir = base_dir\n        os.makedirs(self._base_dir, exist_ok=True)\n\n    def save(self, result: ConversionResult) -> str:\n        \"\"\"Saves a ConversionResult object to a timestamped JSON file.\"\"\"\n        ts = result.meta.get(\"timestamp\", \"unknown\")\n        fname = f\"conversion_{ts}.json\"\n        path = os.path.join(self._base_dir, fname)\n        try:\n            with open(path, \"w\", encoding=\"utf-8\") as fh:\n                fh.write(result.to_json())\n        except OSError as e:\n            raise RepositoryError(str(e))\n        return path\n\n    def list_saved(self) -> List[str]:\n        \"\"\"Lists paths of all saved conversion result files, newest first.\"\"\"\n        paths = []\n        for f in os.listdir(self._base_dir):\n            if f.startswith(\"conversion_\") and f.endswith(\".json\"):\n                paths.append(os.path.join(self._base_dir, f))\n        paths.sort(key=os.path.getmtime, reverse=True)\n        return paths\nclass ConverterService:\n    \"\"\"Orchestrates validation, conversion logic, and optional persistence.\"\"\"\n    def __init__(self, repository: Optional[FileRepository] = None):\n        self._repo = repository\n\n    def convert(self, keys: Sequence[str], *lists: Sequence[Any], field_names: Optional[Sequence[str]] = None, persist: bool = False) -> ConversionResult:\n        \"\"\"Performs the main conversion from lists to nested dictionaries.\"\"\"\n        validate_lists(keys, list(lists))\n        items = build_nested_dict(keys, list(lists), field_names)\n        meta = {\"count\": len(items), \"timestamp\": time.strftime(DEFAULT_TIME_FMT)}\n        result = ConversionResult(items=items, meta=meta)\n        if persist and self._repo:\n            try:\n                self._repo.save(result)\n            except Exception as e:\n                raise RepositoryError(str(e))\n        return result\ndef convert_list_dictionary(keys: Sequence[str], *lists: Sequence[Any], field_names: Optional[Sequence[str]] = None, persist: bool = False) -> List[Dict]:\n    \"\"\"\n    Convenience wrapper to convert multiple parallel lists into a nested dictionary structure.\n    It calls the ConverterService and returns the list of converted dictionaries.\n    \"\"\"\n    repo = FileRepository() if persist else None\n    svc = ConverterService(repository=repo)\n    result = svc.convert(keys, *lists, field_names=field_names, persist=persist)\n    return result.items"}
{"task_id": "Mbpp/394", "solution": "def check_distinct(values: tuple) -> bool:\n    \"\"\"\n    Checks if the given tuple contains no duplicate elements, handling both hashable and unhashable types.\n    Returns True if all elements are unique, False otherwise.\n    \"\"\"\n    seen = set()\n    try:\n        for item in values:\n            if item in seen:\n                return False\n            seen.add(item)\n        return True\n    except TypeError:\n        # Fallback to O(n^2) comparison for unhashable elements\n        n = len(values)\n        for i in range(n):\n            for j in range(i + 1, n):\n                if values[i] == values[j]:\n                    return False\n        return True"}
