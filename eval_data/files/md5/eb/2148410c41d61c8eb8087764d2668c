{"task_id": "Mbpp/427", "solution": "import re\nfrom calendar import monthrange\nclass DateFormatError(ValueError):\n    \"\"\"Custom exception for date formatting errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass DateDTO:\n    \"\"\"Data transfer object for date components.\"\"\"\n    def __init__(self, year: int, month: int, day: int) -> None:\n        self.year = year\n        self.month = month\n        self.day = day\n\n    def to_dmy(self) -> str:\n        \"\"\"Returns the date in 'dd-mm-yyyy' format.\"\"\"\n        return f\"{self.day:02d}-{self.month:02d}-{self.year:04d}\"\nclass DateConverter:\n    \"\"\"Converts a DateDTO object to a formatted string.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def convert(self, dto: DateDTO) -> str:\n        \"\"\"Converts DateDTO to 'dd-mm-yyyy' format.\"\"\"\n        return self.format_dd_mm_yyyy(dto.day, dto.month, dto.year)\n\n    def format_dd_mm_yyyy(self, day: int, month: int, year: int) -> str:\n        \"\"\"Formats day, month, year integers into 'dd-mm-yyyy' string.\"\"\"\n        return f\"{day:02d}-{month:02d}-{year:04d}\"\nclass DateValidator:\n    \"\"\"Validates date strings and creates DateDTOs.\"\"\"\n    ISO_PATTERN = r\"^\\d{4}-\\d{2}-\\d{2}$\"\n\n    def __init__(self) -> None:\n        self._regex = re.compile(self.ISO_PATTERN)\n\n    def validate(self, date_str: str) -> DateDTO:\n        \"\"\"Validates the date string and returns a DateDTO.\"\"\"\n        if not isinstance(date_str, str):\n            raise DateFormatError(\"input must be a string\")\n        if not self._regex.match(date_str):\n            raise DateFormatError(\"invalid format, expected YYYY-MM-DD\")\n\n        year_s, month_s, day_s = date_str.split(\"-\")\n        year, month, day = int(year_s), int(month_s), int(day_s)\n\n        if year < 1:\n            raise DateFormatError(f\"invalid year {year}\")\n        if not (1 <= month <= 12):\n            raise DateFormatError(f\"invalid month {month}\")\n\n        max_day = monthrange(year, month)[1]\n        if not (1 <= day <= max_day):\n            raise DateFormatError(f\"invalid day {day} for month {month}\")\n\n        return DateDTO(year, month, day)\nclass DateController:\n    \"\"\"Orchestrates date validation and conversion.\"\"\"\n    def __init__(self, validator: DateValidator, converter: DateConverter) -> None:\n        self.validator = validator\n        self.converter = converter\n\n    def change_date_format(self, date_str: str) -> str:\n        \"\"\"Validates and converts a date string from YYYY-MM-DD to DD-MM-YYYY.\"\"\"\n        dto = self.validator.validate(date_str)\n        return self.converter.convert(dto)\n_validator = DateValidator()\n_converter = DateConverter()\n_controller = DateController(_validator, _converter)\ndef change_date_format(date_str: str) -> str:\n    \"\"\"Converts a date of yyyy-mm-dd format to dd-mm-yyyy format.\"\"\"\n    return _controller.change_date_format(date_str)"}
{"task_id": "Mbpp/428", "solution": "def shell_sort(arr):\n    \"\"\"Sorts a list of numbers using the Shell sort algorithm with Knuth's gap sequence.\"\"\"\n    n = len(arr)\n    # Create a defensive copy to avoid modifying the original list in place\n    data = list(arr)\n\n    # Generate Knuth's gap sequence: 1, 4, 13, 40, ...\n    gaps = []\n    h = 1\n    while h < n // 3:\n        h = 3 * h + 1\n    while h >= 1:\n        gaps.append(h)\n        h //= 3\n\n    # Perform gapped insertion sort for each gap\n    for gap in gaps:\n        for i in range(gap, n):\n            temp = data[i]\n            j = i\n            while j >= gap and data[j - gap] > temp:\n                data[j] = data[j - gap]\n                j -= gap\n            data[j] = temp\n    return data"}
{"task_id": "Mbpp/433", "solution": "def check_greater(values, number):\n    \"\"\"\n    Return True if `number` is strictly greater than every element in `values`.\n    Returns False for an empty `values`.\n    Raises TypeError for non-iterable `values` or non-numeric elements/number.\n    \"\"\"\n    if values is None:\n        raise TypeError(\"values must be an iterable, not None\")\n    try:\n        iterator = iter(values)\n    except TypeError:\n        raise TypeError(\"values must be an iterable\")\n\n    try:\n        num = float(number)\n    except (TypeError, ValueError):\n        raise TypeError(f\"number must be numeric, got {number!r}\")\n\n    found = False\n    for v in values:\n        found = True\n        try:\n            val = float(v)\n        except (TypeError, ValueError):\n            raise TypeError(f\"array contains non-numeric element: {v!r}\")\n        if not (num > val):\n            return False\n\n    return False if not found else True"}
