{"task_id": "Mbpp/108", "solution": "def merge_sorted_list(a: Sequence[int], b: Sequence[int], c: Sequence[int]) -> List[int]:\n    \"\"\"\n    Merges three input sequences into a single sorted list.\n    \"\"\"\n    from abc import ABC, abstractmethod\n    from typing import Any, List, Sequence\n\n    class MergeError(Exception):\n        \"\"\"Custom exception for merging related errors.\"\"\"\n        def __init__(self, message: str):\n            super().__init__(message)\n            self.message = message\n\n    class ListNormalizer:\n        \"\"\"Validates inputs are iterable and converts them to lists.\"\"\"\n        def normalize(self, seq: Sequence[Any]) -> List[Any]:\n            if seq is None:\n                return []\n            try:\n                return list(seq)\n            except TypeError:\n                raise MergeError(f\"Input {seq!r} is not iterable\")\n\n    class SortStrategy(ABC):\n        \"\"\"Abstract base class for merge sorting strategies.\"\"\"\n        @abstractmethod\n        def merge(self, a: List[Any], b: List[Any], c: List[Any]) -> List[Any]:\n            pass\n\n    class PythonSortStrategy(SortStrategy):\n        \"\"\"A SortStrategy implementation using Python's built-in sort.\"\"\"\n        def merge(self, a: List[Any], b: List[Any], c: List[Any]) -> List[Any]:\n            combined = a + b + c\n            return sorted(combined)\n\n    class MergeService:\n        \"\"\"Orchestrates the merging process, delegating to a SortStrategy.\"\"\"\n        def __init__(self, strategy: SortStrategy, normalizer: ListNormalizer):\n            self._strategy = strategy\n            self._normalizer = normalizer\n\n        def merge(self, a: Sequence[Any], b: Sequence[Any], c: Sequence[Any]) -> List[Any]:\n            a_list = self._normalizer.normalize(a)\n            b_list = self._normalizer.normalize(b)\n            c_list = self._normalizer.normalize(c)\n            try:\n                return self._strategy.merge(a_list, b_list, c_list)\n            except Exception as e:\n                raise MergeError(f\"Failed to merge lists: {e}\") from e\n\n    class MergeController:\n        \"\"\"Provides a simple facade for the merge functionality.\"\"\"\n        def __init__(self, service: MergeService):\n            self._service = service\n\n        def merge(self, a: Sequence[Any], b: Sequence[Any], c: Sequence[Any]) -> List[Any]:\n            return self._service.merge(a, b, c)\n\n    _default_service = MergeService(PythonSortStrategy(), ListNormalizer())\n    _default_controller = MergeController(_default_service)\n\n    return _default_controller.merge(a, b, c)"}
{"task_id": "Mbpp/116", "solution": "def tuple_to_int(values: tuple) -> int:\n    \"\"\"\n    Convert a tuple (or list) of non-negative integers into a single integer\n    by concatenating their decimal representations. An empty sequence returns 0.\n\n    Example:\n        tuple_to_int((1, 2, 3)) -> 123\n    \"\"\"\n    if not isinstance(values, (tuple, list)):\n        raise TypeError(\"Input must be a tuple or list of non-negative integers.\")\n    if not values:\n        return 0\n    for i, v in enumerate(values):\n        if not isinstance(v, int):\n            raise TypeError(f\"Element at index {i} is not an int: {v!r}\")\n        if v < 0:\n            raise ValueError(f\"Element at index {i} is negative: {v}\")\n    s = ''.join(str(v) for v in values)\n    try:\n        return int(s)\n    except ValueError as e:\n        raise ValueError(f\"Failed to convert concatenated string '{s}' to int.\") from e"}
{"task_id": "Mbpp/109", "solution": "def odd_Equivalent(s, k):\n    \"\"\"Counts how many of the first k left-rotations of a binary string are odd.\n    An odd binary number ends with '1'. Rotations are cyclic with period n = len(s).\n    \"\"\"\n    n = len(s)\n    if n == 0:\n        return 0\n\n    # Total '1's in the string: each full cycle contributes this many odd rotations.\n    ones_total = s.count(\"1\")\n\n    # Number of full cycles and remaining rotations\n    full_cycles_count = k // n\n    remainder_rotations = k % n\n\n    # Count '1's that appear at the last position for the remainder rotations.\n    # These correspond to positions: n-1, 0, 1, ..., remainder_rotations-2 (total remainder_rotations positions)\n    tail_ones_count = 0\n    if remainder_rotations > 0:\n        if s[n - 1] == \"1\":\n            tail_ones_count += 1\n        for i in range(remainder_rotations - 1):\n            if s[i] == \"1\":\n                tail_ones_count += 1\n\n    return full_cycles_count * ones_total + tail_ones_count"}
{"task_id": "Mbpp/111", "solution": "def common_in_nested_lists(nested):\n    \"\"\"\n    Find common elements in given nested lists.\n\n    Returns a list of unique elements that appear in every sub-list.\n    By default, the result preserves the order of appearance from the first sub-list.\n    \"\"\"\n    preserve_order = True\n\n    def _preserve_order_intersection(first_list, common_set):\n        result = []\n        seen = set()\n        for item in first_list:\n            if item in common_set and item not in seen:\n                result.append(item)\n                seen.add(item)\n        return result\n\n    def _compute_intersection_for_non_hashable(nested_lists):\n        if not nested_lists:\n            return []\n        lists_as_lists = [list(sub) for sub in nested_lists]\n        result = []\n        first_list = lists_as_lists[0]\n        for item in first_list:\n            if item in result:  # ensure uniqueness\n                continue\n            present_in_all = True\n            for other in lists_as_lists[1:]:\n                if item not in other:\n                    present_in_all = False\n                    break\n            if present_in_all:\n                result.append(item)\n        return result\n\n    if not nested:\n        return []\n\n    # If there's only one list, return its unique elements (preserving order).\n    if len(nested) == 1:\n        seen = set()\n        unique = []\n        for item in nested[0]:\n            if item not in seen:\n                unique.append(item)\n                seen.add(item)\n        return unique\n\n    try:\n        sets = [set(sub) for sub in nested]\n        if not sets:\n            return []\n        common_set = sets[0].copy()\n        for s in sets[1:]:\n            common_set &= s\n            if not common_set:\n                break\n        if preserve_order:\n            return _preserve_order_intersection(nested[0], common_set)\n        return list(common_set)\n    except TypeError:\n        # Fallback for unhashable items\n        return _compute_intersection_for_non_hashable(nested)"}
{"task_id": "Mbpp/118", "solution": "def string_to_list(text: str) -> list[str]:\n    \"\"\"\n    Converts a string into a list of strings, splitting on space characters.\n    It normalizes whitespace, treating multiple spaces as one separator and trimming leading/trailing spaces.\n    \"\"\"\n    # Normalize whitespace: split by space, filter out empty parts, join with a single space, then strip.\n    # This process handles consecutive spaces and leading/trailing whitespace efficiently.\n    parts = text.split(' ')\n    filtered_parts = [p for p in parts if p != '']\n    normalized_text = ' '.join(filtered_parts).strip()\n\n    # If the normalized string is empty (e.g., original was \"\", \"   \"), return an empty list.\n    if not normalized_text:\n        return []\n\n    # Split the fully normalized string by a single space to get the final tokens.\n    return normalized_text.split(' ')"}
{"task_id": "Mbpp/113", "solution": "import re\ndef check_integer(s: str) -> bool:\n    \"\"\"\n    Checks if a string represents a decimal integer, allowing optional leading sign and whitespace.\n    The input is normalized by stripping whitespace before validation.\n    \"\"\"\n    INT_PATTERN = re.compile(r\"^[+-]?\\d+$\")\n\n    # Normalize the input: convert to string, handle None, and strip whitespace.\n    if s is None:\n        normalized_s = \"\"\n    else:\n        normalized_s = str(s).strip()\n\n    # An empty string after normalization is not considered an integer.\n    if not normalized_s:\n        return False\n\n    # Use the regex pattern to check if the normalized string is a decimal integer.\n    return bool(INT_PATTERN.match(normalized_s))"}
{"task_id": "Mbpp/119", "solution": "def search(nums):\n    left, right = 0, len(nums) - 1\n    while left < right:\n        mid = (left + right) // 2\n        if mid % 2 == 1:\n            mid -= 1\n        if nums[mid] == nums[mid + 1]:\n            left = mid + 2\n        else:\n            right = mid\n    return nums[left]"}
{"task_id": "Mbpp/120", "solution": "def max_product_tuple(list_of_pairs):\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples.\n\n    Args:\n        list_of_pairs: iterable of 2-element tuples/lists containing numeric values.\n\n    Returns:\n        The maximum absolute product (int or float). Returns 0 for empty input.\n\n    Note:\n        This implementation assumes items are iterable of length 2 and contain numeric types.\n    \"\"\"\n    max_absolute_product = 0\n    for a, b in list_of_pairs:\n        current_absolute_product = abs(a * b)\n        if current_absolute_product > max_absolute_product:\n            max_absolute_product = current_absolute_product\n    return max_absolute_product"}
{"task_id": "Mbpp/123", "solution": "import math\nfrom typing import Dict, Optional, Set\nclass MathUtils:\n    @staticmethod\n    def proper_divisors_sum(n: int) -> int:\n        if n <= 1:\n            return 0\n        s = 1\n        i = 2\n        root = int(math.isqrt(n))\n        while i <= root:\n            if n % i == 0:\n                s += i\n                other = n // i\n                if other != i:\n                    s += other\n            i += 1\n        return s\n\n    @staticmethod\n    def sieve_divisor_sums(limit: int) -> Dict[int, int]:\n        if limit < 1:\n            return {}\n        proper_sums = [0] * (limit + 1)\n        if limit >= 1:\n            proper_sums[1] = 0\n        for i in range(1, limit + 1):\n            for multiple in range(2 * i, limit + 1, i):\n                proper_sums[multiple] += i\n        return {i: proper_sums[i] for i in range(1, limit + 1)}\nclass DivisorSumRepository:\n    def __init__(self, persist_path: Optional[str] = None, preload: bool = False) -> None:\n        self._cache: Dict[int, int] = {}\n        self._persist_path = persist_path\n\n    def get_divisor_sum(self, n: int) -> int:\n        if n in self._cache:\n            return self._cache[n]\n        sum_val = MathUtils.proper_divisors_sum(n)\n        self._cache[n] = sum_val\n        return sum_val\n\n    def bulk_divisor_sums(self, limit: int) -> Dict[int, int]:\n        max_cached_val = max(self._cache.keys()) if self._cache else 0\n        if limit > max_cached_val:\n            sieve_results = MathUtils.sieve_divisor_sums(limit)\n            self._cache.update(sieve_results)\n        return {num: self._cache[num] for num in range(1, limit + 1) if num in self._cache}\nclass AmicableService:\n    def __init__(self, repo: DivisorSumRepository) -> None:\n        self.repo = repo\n\n    def amicable_numbers_sum(self, n: int) -> int:\n        if not isinstance(n, int) or n < 1:\n            raise ValueError(\"n must be a positive integer\")\n        sums = self.repo.bulk_divisor_sums(n)\n        total = 0\n        seen_amicable_numbers: Set[int] = set()\n        for a in range(1, n + 1):\n            s_a = sums.get(a)\n            if s_a is None:\n                continue\n            b = s_a\n            if a == b:\n                continue\n            if b > n:\n                continue\n            s_b = sums.get(b)\n            if s_b is None or s_b != a:\n                continue\n            if a not in seen_amicable_numbers:\n                total += a\n                seen_amicable_numbers.add(a)\n            if b not in seen_amicable_numbers:\n                total += b\n                seen_amicable_numbers.add(b)\n        return total\n_repo = DivisorSumRepository()\n_service = AmicableService(_repo)\ndef amicable_numbers_sum(n: int) -> int:\n    \"\"\"\n    Sums all amicable numbers from 1 to a specified number.\n    assert amicable_numbers_sum(999)==504\n    \"\"\"\n    return _service.amicable_numbers_sum(n)"}
{"task_id": "Mbpp/124", "solution": "import math\ndef angle_complex(a, b=None) -> float:\n    \"\"\"Calculates the angle (argument) of a complex number.\n    Inputs 'a' and 'b' are combined into a single complex number for calculation.\n    \"\"\"\n    if b is None:\n        z = complex(a)\n    else:\n        # As per design, combine two arguments by summing their complex representations.\n        z = complex(a) + complex(b)\n\n    return math.atan2(z.imag, z.real)"}
