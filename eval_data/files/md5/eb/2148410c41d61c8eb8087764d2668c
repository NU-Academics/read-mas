{"task_id": "Mbpp/414", "solution": "from typing import Iterable, Any, Callable, Optional\nfrom .controllers import OverlapController\nfrom .checker import OverlapChecker\nfrom .adapters import DefaultHashingStrategy\ndef overlapping(seq1: Iterable[Any], seq2: Iterable[Any], key: Optional[Callable[[Any], Any]] = None, max_buffer: Optional[int] = None) -> bool:\n    \"\"\"\n    Checks if any value in the first sequence exists in the second sequence.\n    It uses an OverlapController for the core logic, allowing for a key function\n    and a maximum buffer size for performance optimization.\n    \"\"\"\n    hashing_strategy = DefaultHashingStrategy()\n\n    # Initialize OverlapChecker with the hashing strategy.\n    # The max_buffer for the specific check is passed at the handle_check level,\n    # so the checker's initial max_buffer can be None here.\n    checker = OverlapChecker(hashing_strategy=hashing_strategy, max_buffer=None)\n\n    # Initialize the OverlapController with the checker instance.\n    controller = OverlapController(checker=checker)\n\n    # Delegate the actual overlap check to the controller, passing all parameters.\n    return controller.handle_check(seq1, seq2, key=key, max_buffer=max_buffer)"}
{"task_id": "Mbpp/418", "solution": "def Find_Max(items):\n    \"\"\"\n    Finds the element with the maximum length in a list of sequences.\n    Returns the first such element if multiple have the same maximum length, or None if the input list is empty.\n    \"\"\"\n    if not items:\n        return None\n    return max(items, key=len)"}
{"task_id": "Mbpp/415", "solution": "def max_Product(array: list) -> tuple:\n    \"\"\"\n    Find a pair of integers from `array` that produces the highest product.\n    Returns a tuple (min_value, max_value) with the pair sorted ascending.\n\n    Raises:\n        TypeError: if array is not a list/tuple or contains non-int elements.\n        ValueError: if array contains fewer than 2 elements.\n    \"\"\"\n    if not isinstance(array, (list, tuple)):\n        raise TypeError(\"array must be a list or tuple of integers\")\n    if len(array) < 2:\n        raise ValueError(\"array must contain at least two integers\")\n\n    top1 = top2 = float(\"-inf\")  # two largest values\n    low1 = low2 = float(\"inf\")   # two smallest values\n\n    for x in array:\n        if not isinstance(x, int):\n            raise TypeError(\"all elements of array must be integers\")\n\n        # update largest values\n        if x > top1:\n            top2 = top1\n            top1 = x\n        elif x > top2:\n            top2 = x\n\n        # update smallest values\n        if x < low1:\n            low2 = low1\n            low1 = x\n        elif x < low2:\n            low2 = x\n\n    product_top = top1 * top2\n    product_low = low1 * low2\n\n    top_a, top_b = (min(top1, top2), max(top1, top2))\n    low_a, low_b = (min(low1, low2), max(low1, low2))\n\n    if product_top > product_low:\n        chosen = (top_a, top_b)\n    elif product_low > product_top:\n        chosen = (low_a, low_b)\n    else:\n        # Tie-breaker: prefer pair with larger maximum element, then larger minimum element\n        if top_b > low_b:\n            chosen = (top_a, top_b)\n        elif low_b > top_b:\n            chosen = (low_a, low_b)\n        else:\n            if top_a >= low_a:\n                chosen = (top_a, top_b)\n            else:\n                chosen = (low_a, low_b)\n\n    return (int(chosen[0]), int(chosen[1]))"}
