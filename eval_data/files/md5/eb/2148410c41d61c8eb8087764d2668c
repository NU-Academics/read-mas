{"task_id": "Mbpp/759", "solution": "import re\n_DECIMAL_2_REGEX = re.compile(r'^[+-]?\\d+\\.\\d{2}$')\ndef is_decimal(value: str) -> bool:\n    \"\"\"\n    Checks if the given string is a decimal number with a precision of 2.\n    Leading/trailing whitespace is trimmed before validation.\n    \"\"\"\n    normalized_value = value.strip()\n    return bool(_DECIMAL_2_REGEX.fullmatch(normalized_value))"}
{"task_id": "Mbpp/764", "solution": "def number_ctr(s: str) -> int:\n    \"\"\"\n    Count the number of ASCII digit characters (0-9) in the given string.\n\n    Args:\n        s: Input string to examine.\n\n    Returns:\n        The count of digit characters in the string.\n\n    Raises:\n        TypeError: If s is not a str.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"s must be a string\")\n    return sum(1 for c in s if '0' <= c <= '9')"}
{"task_id": "Mbpp/766", "solution": "def pair_wise(items):\n    \"\"\"\n    Returns a list of all pairs of consecutive items in the given list.\n    If the list has fewer than two items, an empty list is returned.\n    \"\"\"\n    n = len(items)\n    if n < 2:\n        return []\n    return [(items[i], items[i + 1]) for i in range(n - 1)]"}
{"task_id": "Mbpp/765", "solution": "def nth_polite(n: int) -> int:\n    \"\"\"\n    Return the nth polite number (1-based).\n    Polite numbers are positive integers that can be expressed as a sum of\n    two or more consecutive positive integers \u2014 equivalently, integers that\n    are NOT powers of two.\n    Example: nth_polite(7) == 11\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 1:\n        raise ValueError(\"n must be a positive integer (>= 1)\")\n\n    count = 0\n    num = 1\n    while True:\n        # A positive integer is a power of two iff (num & (num - 1)) == 0.\n        # Treat 1 (2^0) as a power of two (impolite).\n        if num > 0 and (num & (num - 1)) != 0:\n            count += 1\n            if count == n:\n                return num\n        num += 1"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the fourth power of the first n odd natural numbers.\n    Assumes n is a non-negative integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    if n == 0:\n        return 0\n\n    total_sum = 0\n    # The k-th odd number is 2*k - 1\n    for i in range(1, n + 1):\n        odd_num = 2 * i - 1\n        total_sum += odd_num ** 4\n    return total_sum"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers, target):\n    \"\"\"\n    Counts the number of unordered pairs in 'numbers' whose sum equals 'target'.\n    Handles duplicate numbers combinatorially.\n    \"\"\"\n    freq = {}\n    for num in numbers:\n        freq[num] = freq.get(num, 0) + 1\n\n    total_pairs = 0\n    # Iterate through unique numbers to find pairs efficiently\n    for num in freq:\n        complement = target - num\n        if complement in freq:\n            if num == complement:\n                # If a number pairs with itself, use combination formula nC2\n                count = freq[num]\n                total_pairs += count * (count - 1) // 2\n            elif num < complement:\n                # Avoid double counting pairs (e.g., (1,4) and (4,1)) by checking num < complement\n                total_pairs += freq[num] * freq[complement]\n\n    return total_pairs"}
{"task_id": "Mbpp/769", "solution": "def Diff(list_a, list_b):\n    \"\"\"\n    Computes the difference between two lists, returning elements in list_a that are not in list_b,\n    preserving the original order of list_a. It optimizes for hashable elements using sets.\n    \"\"\"\n    result = []\n\n    try:\n        # Attempt to use a set for efficient O(1) average time lookup if elements are hashable.\n        b_set = set(list_b)\n        for item in list_a:\n            if item not in b_set:\n                result.append(item)\n    except TypeError:\n        # Fallback for lists containing unhashable elements (e.g., lists, dictionaries).\n        # This will result in an O(N*M) worst-case time complexity.\n        for item in list_a:\n            if item not in list_b:\n                result.append(item)\n\n    return result"}
