{"task_id": "Mbpp/171", "solution": "def perimeter_pentagon(side: float) -> float:\n    \"\"\"Calculates the perimeter of a regular pentagon.\n\n    The perimeter is simply 5 times the length of one side.\n    \"\"\"\n    return 5 * side"}
{"task_id": "Mbpp/172", "solution": "def count_occurance(text, sub='std'):\n    \"\"\"Counts the number of overlapping occurrences of a substring in a given text.\"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"text must be a string\")\n    if not isinstance(sub, str):\n        raise TypeError(\"sub must be a string\")\n    if len(sub) == 0:\n        raise ValueError(\"sub must be a non-empty string\")\n\n    count = 0\n    start_index = 0\n    while True:\n        idx = text.find(sub, start_index)\n        if idx == -1:\n            break\n        count += 1\n        start_index = idx + 1\n    return count"}
{"task_id": "Mbpp/222", "solution": "def check_type(data):\n    \"\"\"\n    Checks if all elements in the input iterable (typically a tuple) have the same data type.\n    An empty iterable is considered homogeneous (returns True).\n    \"\"\"\n    if data is None:\n        raise TypeError(\"Input cannot be None\")\n\n    try:\n        iterator = iter(data)\n    except TypeError:\n        raise TypeError(\"Input is not iterable\")\n\n    # Convert to sequence to support indexing/slicing if it's not already a sequence\n    items = list(iterator)\n    if not items:\n        return True\n\n    first_type = type(items[0])\n    for element in items[1:]:\n        if type(element) != first_type:\n            return False\n    return True"}
{"task_id": "Mbpp/223", "solution": "def is_majority(array, n, x):\n    \"\"\"\n    Checks if an element is the majority element in a sorted array.\n    A majority element occurs more than n/2 times.\n    \"\"\"\n    def _first_occurrence(arr, length, target):\n        \"\"\"Finds the index of the first occurrence of target in arr[0:length], or -1 if not found.\"\"\"\n        low, high = 0, length - 1\n        result = -1\n        while low <= high:\n            mid = (low + high) // 2\n            if arr[mid] == target:\n                result = mid\n                high = mid - 1  # Look for an earlier occurrence\n            elif arr[mid] < target:\n                low = mid + 1\n            else:\n                high = mid - 1\n        return result\n\n    def _last_occurrence(arr, length, target):\n        \"\"\"Finds the index of the last occurrence of target in arr[0:length], or -1 if not found.\"\"\"\n        low, high = 0, length - 1\n        result = -1\n        while low <= high:\n            mid = (low + high) // 2\n            if arr[mid] == target:\n                result = mid\n                low = mid + 1  # Look for a later occurrence\n            elif arr[mid] < target:\n                low = mid + 1\n            else:\n                high = mid - 1\n        return result\n\n    first_idx = _first_occurrence(array, n, x)\n    if first_idx == -1:\n        return False\n\n    last_idx = _last_occurrence(array, n, x)\n\n    count = last_idx - first_idx + 1\n    return count > (n // 2)"}
{"task_id": "Mbpp/224", "solution": "def count_Set_Bits(n):\n    \"\"\"\n    Counts the number of set bits (1s) in a non-negative integer using Brian Kernighan's algorithm.\n    This method efficiently clears the least significant set bit in each iteration.\n    \"\"\"\n    count = 0\n    while n > 0:\n        n &= (n - 1)  # Clear the least significant set bit\n        count += 1\n    return count"}
