{"task_id": "Mbpp/598", "solution": "def armstrong_number(n: int) -> bool:\n    \"\"\"\n    Checks if a given integer is an Armstrong number.\n    An Armstrong number is one where the sum of its own digits,\n    each raised to the power of the number of digits, equals the number itself.\n    \"\"\"\n    if not isinstance(n, int):\n        # Attempt to convert numeric-like inputs (e.g., \"153\") to int\n        try:\n            n = int(n)\n        except Exception:\n            return False\n\n    if n < 0:\n        # Negative numbers are not considered Armstrong numbers\n        return False\n\n    s_n = str(n)\n    num_digits = len(s_n)\n    armstrong_sum = sum(int(d) ** num_digits for d in s_n)\n    return armstrong_sum == n"}
{"task_id": "Mbpp/597", "solution": "def find_kth(a: list[int], b: list[int], k: int) -> int:\n    \"\"\"\n    Finds the k-th smallest element from two sorted arrays.\n    Assumes arrays 'a' and 'b' are sorted and 'k' is a valid 1-based index within the combined length.\n    \"\"\"\n    # Validate k quickly\n    total = len(a) + len(b)\n    if k < 1 or k > total:\n        raise IndexError(\"k is out of range\")\n\n    # Ensure array 'a' is the smaller one to optimize binary search range.\n    if len(a) > len(b):\n        return find_kth(b, a, k)\n\n    m, n = len(a), len(b)\n\n    # Define the search range for the partition in array 'a'.\n    # partition_a indicates the number of elements taken from 'a' for the left part.\n    low = max(0, k - n)\n    high = min(k, m)\n\n    while low <= high:\n        partition_a = (low + high) // 2\n        partition_b = k - partition_a\n\n        # Get the elements at the partition boundaries.\n        # Use float('-inf') and float('inf') for boundary conditions to simplify comparisons.\n        max_left_a = a[partition_a - 1] if partition_a > 0 else float(\"-inf\")\n        min_right_a = a[partition_a] if partition_a < m else float(\"inf\")\n\n        max_left_b = b[partition_b - 1] if partition_b > 0 else float(\"-inf\")\n        min_right_b = b[partition_b] if partition_b < n else float(\"inf\")\n\n        if max_left_a <= min_right_b and max_left_b <= min_right_a:\n            # The partitions are correct. The k-th element is the maximum of the left halves.\n            return int(max(max_left_a, max_left_b))\n        elif max_left_a > min_right_b:\n            # Elements from 'a' in the left partition are too large; reduce partition_a.\n            high = partition_a - 1\n        else:\n            # Elements from 'a' in the left partition are too small; increase partition_a.\n            low = partition_a + 1\n\n    # If we exit the loop without returning, something went wrong.\n    raise RuntimeError(\"Unable to find the k-th element\")"}
{"task_id": "Mbpp/599", "solution": "def sum_average(n):\n    \"\"\"\n    Calculates the sum and average of the first n natural numbers.\n    Assumes n is a positive integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n    total = n * (n + 1) // 2\n    average = total / n\n    return (total, average)"}
