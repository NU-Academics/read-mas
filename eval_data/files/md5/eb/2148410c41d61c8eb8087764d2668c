{"task_id": "Mbpp/95", "solution": "def Find_Min_Length(list_of_lists):\n    \"\"\"\n    Finds the length of the smallest list in a list of lists.\n    Assumes valid input: a non-empty list of lists where all inner items support len().\n    \"\"\"\n    if not list_of_lists:\n        # Return 0 for empty outer list (could alternatively raise an error)\n        return 0\n\n    min_length = float('inf')\n    for inner_list in list_of_lists:\n        current_length = len(inner_list)\n        if current_length < min_length:\n            min_length = current_length\n\n    return min_length"}
{"task_id": "Mbpp/96", "solution": "def divisor(n: int) -> int:\n    \"\"\"\n    Calculates the number of positive divisors for a given integer n.\n    \"\"\"\n    if n == 1:\n        return 1\n\n    factors = {}\n    temp_n = n\n    d = 2\n\n    # Perform trial division to find prime factors and their exponents.\n    # We only need to check for divisors up to the square root of temp_n.\n    while d * d <= temp_n:\n        while temp_n % d == 0:\n            factors[d] = factors.get(d, 0) + 1\n            temp_n //= d\n        d += 1\n\n    # If, after the loop, temp_n is still greater than 1,\n    # it means temp_n itself is a prime factor.\n    if temp_n > 1:\n        factors[temp_n] = factors.get(temp_n, 0) + 1\n\n    # The number of divisors is found by multiplying (exponent + 1)\n    # for each prime factor's exponent.\n    count = 1\n    for exponent in factors.values():\n        count *= (exponent + 1)\n\n    return count"}
{"task_id": "Mbpp/97", "solution": "from typing import Sequence, Any, Dict\ndef frequency_lists(lists: Sequence[Sequence[Any]]) -> Dict[Any, int]:\n    \"\"\"\n    Calculates the frequency of each element in a flattened list of lists.\n    \"\"\"\n    frequencies: Dict[Any, int] = {}\n    for inner_list in lists:\n        for item in inner_list:\n            frequencies[item] = frequencies.get(item, 0) + 1\n    return frequencies"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(n):\n    \"\"\"\n    Converts a non-negative decimal integer to its binary string representation.\n    The string will not have leading zeros, except for the number 0 itself.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer\")\n    if n < 0:\n        raise ValueError(\"Negative numbers are not supported\")\n\n    if n == 0:\n        return \"0\"\n\n    binary_digits = []\n    while n > 0:\n        n, remainder = divmod(n, 2)\n        binary_digits.append(str(remainder))\n\n    # The digits are collected in reverse order (least significant first).\n    # Reverse the list to get the correct binary representation (most significant first).\n    return \"\".join(reversed(binary_digits))"}
{"task_id": "Mbpp/98", "solution": "import math\nfrom typing import Iterable, Tuple, Iterator, Union\nfrom decimal import Decimal\nNumber = Union[int, float, Decimal]\nclass NumberSequence:\n    \"\"\"\n    Encapsulates a sequence of numbers, making it immutable and providing length.\n    \"\"\"\n    def __init__(self, seq: Iterable[Number]) -> None:\n        self._seq: Tuple[Number, ...] = tuple(seq)\n\n    def __iter__(self) -> Iterator[Number]:\n        return iter(self._seq)\n\n    def __len__(self) -> int:\n        return len(self._seq)\nclass SequenceValidator:\n    \"\"\"\n    A validator class (methods are no-ops due to strict prompt constraints).\n    \"\"\"\n    def __init__(self, allowed_types=(int, float, Decimal)):\n        self.allowed_types = allowed_types\n\n    def validate_non_empty(self, seq: NumberSequence) -> None:\n        # Constraint: Do NOT add isinstance() checks or raise exceptions.\n        pass\n\n    def validate_elements_numeric(self, seq: NumberSequence) -> None:\n        # Constraint: Do NOT add isinstance() checks or raise exceptions.\n        pass\nclass MathUtils:\n    \"\"\"\n    Provides static utility methods for mathematical operations.\n    \"\"\"\n    @staticmethod\n    def safe_product(seq: Iterable[Number]) -> Union[float, Decimal]:\n        # Determines if Decimal arithmetic is needed based on sequence content.\n        # Calculates product, preserving Decimal precision if any Decimal is present.\n        use_decimal = False\n        for x in seq:\n            if isinstance(x, Decimal):\n                use_decimal = True\n                break\n\n        if use_decimal:\n            product: Union[float, Decimal] = Decimal(1)\n            for x in seq:\n                product *= Decimal(x)\n        else:\n            product = 1.0\n            for x in seq:\n                product *= float(x)\n\n        return product\nclass MultiplicationService:\n    \"\"\"\n    Business logic to multiply sequence elements and divide by length.\n    \"\"\"\n    def __init__(self, validator: SequenceValidator) -> None:\n        self.validator = validator\n\n    def multiply_and_divide(self, seq: Iterable[Number]) -> Union[float, Decimal]:\n        ns = NumberSequence(seq)\n        # Validation calls are removed due to strict prompt constraints.\n        # self.validator.validate_non_empty(ns)\n        # self.validator.validate_elements_numeric(ns)\n\n        product = MathUtils.safe_product(ns)\n        length = len(ns)\n\n        # Handle division by zero for an empty list scenario (if validation didn't prevent it).\n        if length == 0:\n            # If length is 0, product will be 1 (initialized)\n            # The prompt's example implies non-empty lists. If it were empty,\n            # len(ns) would be 0, leading to ZeroDivisionError.\n            # However, the constraint \"Do NOT add isinstance() checks or raise exceptions\"\n            # means we cannot explicitly check for length == 0 here and raise.\n            # Python will raise ZeroDivisionError naturally if len is 0.\n            pass\n\n        return product / length\ndef multiply_num(seq: Iterable[Number]) -> Union[float, Decimal]:\n    \"\"\"\n    Multiplies all numbers in a sequence and divides the product by the sequence's length.\n    \"\"\"\n    validator = SequenceValidator()\n    service = MultiplicationService(validator)\n    return service.multiply_and_divide(seq)"}
{"task_id": "Mbpp/101", "solution": "def kth_element(arr, k):\n    \"\"\"\n    Find the k-th element in arr using 1-based indexing.\n\n    Raises:\n        TypeError: if arr is not a list or k is not an int.\n        IndexError: if k is out of range.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"arr must be a list\")\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an int\")\n    if k < 1 or k > len(arr):\n        raise IndexError(\"k is out of range\")\n    return arr[k - 1]"}
{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome strictly greater than n.\n    Handles negative numbers by returning 0, and constructs palindromes using string manipulation.\n    \"\"\"\n    if n < 0:\n        return 0\n\n    # Start by considering the number immediately after n.\n    # We will derive a palindrome based on its string representation.\n    s_target = str(n + 1)\n    L = len(s_target)\n\n    # Separate the left half and potential middle character of s_target.\n    left_half_str = s_target[0 : L // 2]\n\n    if L % 2 == 1:\n        middle_char = s_target[L // 2]\n    else:\n        middle_char = \"\"\n\n    # Construct the first candidate palindrome by mirroring the left half.\n    # This palindrome will have the same number of digits as s_target.\n    candidate_palindrome_str = left_half_str + middle_char + left_half_str[::-1]\n    candidate_palindrome_val = int(candidate_palindrome_str)\n\n    # If this candidate palindrome is already greater than or equal to `n + 1`,\n    # then it is the smallest palindrome strictly greater than `n`.\n    if candidate_palindrome_val >= int(s_target):\n        return candidate_palindrome_val\n    else:\n        # The first candidate palindrome is smaller than `n + 1`.\n        # This implies we need to \"increment the base\" (left part + middle if odd length)\n        # and then construct a new palindrome. This new palindrome will always be larger.\n\n        # Form the numeric value to be incremented.\n        if L % 2 == 1:\n            # For odd length, the \"base\" to increment includes the middle character.\n            increment_base_str = left_half_str + middle_char\n        else:\n            # For even length, the \"base\" to increment is just the left half.\n            increment_base_str = left_half_str\n\n        incremented_base_val = int(increment_base_str) + 1\n        incremented_base_str = str(incremented_base_val)\n\n        # Now, construct the final palindrome using the `incremented_base_str`.\n        # If incrementing the base resulted in a longer string (e.g., \"9\" -> \"10\"),\n        # the structure of the palindrome needs to adjust to account for the new length.\n        if len(incremented_base_str) > len(increment_base_str):\n            # This handles cases like 9 -> 11, 99 -> 101, 999 -> 1001.\n            # The new palindrome will have an odd number of digits:\n            # `incremented_base_str` forms the left half and middle, and `incremented_base_str[:-1]` mirrored forms the right.\n            final_palindrome_str = incremented_base_str + incremented_base_str[:-1][::-1]\n        else:\n            # The length of the `incremented_base_str` is the same as before.\n            # Reconstruct the palindrome respecting the original length's parity.\n            final_left_half_str = incremented_base_str[0 : L // 2]\n            if L % 2 == 1:\n                final_middle_char = incremented_base_str[L // 2]\n            else:\n                final_middle_char = \"\"\n\n            final_palindrome_str = final_left_half_str + final_middle_char + final_left_half_str[::-1]\n\n        return int(final_palindrome_str)"}
