{"task_id": "Mbpp/448", "solution": "def cal_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of Perrin numbers up to index n (inclusive).\n    Uses caching for efficiency.\n    \"\"\"\n    _value_cache: dict[int, int] = {0: 3, 1: 0, 2: 2}\n    _prefix_sum_cache: dict[int, int] = {0: 3, 1: 3, 2: 5}\n\n    def _get_value(index: int) -> int:\n        \"\"\"Retrieves a Perrin number from cache or computes it.\"\"\"\n        if index in _value_cache:\n            return _value_cache[index]\n\n        # Compute missing values iteratively and store in cache\n        current_max_idx = max(_value_cache.keys())\n        for i in range(current_max_idx + 1, index + 1):\n            _value_cache[i] = _value_cache[i - 2] + _value_cache[i - 3]\n        return _value_cache[index]\n\n    if n < 0:\n        # Based on design context, an InvalidParameterError would be raised,\n        # but the prompt requests no exception handling or isinstance checks.\n        # Returning 0 or handling based on implicit requirement is\n        # problematic given \"no exception handling\" constraint.\n        # Assuming for completion that valid 'n' is passed for this specific function.\n        # If n < 0 is allowed input and requires specific return, it's not defined.\n        # Following typical mathematical sequence behavior for n=0 for consistency.\n        return 0\n\n    if n in _prefix_sum_cache:\n        return _prefix_sum_cache[n]\n\n    # Compute missing prefix sums and cache them\n    current_max_prefix_idx = max(_prefix_sum_cache.keys())\n    for i in range(current_max_prefix_idx + 1, n + 1):\n        perrin_val = _get_value(i)\n        previous_sum = _prefix_sum_cache[i - 1]\n        _prefix_sum_cache[i] = previous_sum + perrin_val\n\n    return _prefix_sum_cache[n]"}
{"task_id": "Mbpp/450", "solution": "from typing import List, Any\nclass InvalidInputError(ValueError):\n    \"\"\"Exception raised for invalid input values.\n    It carries a descriptive message about the validation failure.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass Validator:\n    \"\"\"Provides static methods for validating various input types and values.\"\"\"\n    @staticmethod\n    def is_str_list(values: Any) -> bool:\n        \"\"\"Checks if the input is a list or tuple containing only string elements.\"\"\"\n        return isinstance(values, (list, tuple)) and all(isinstance(v, str) for v in values)\n\n    @staticmethod\n    def is_non_negative_int(n: Any) -> bool:\n        \"\"\"Checks if the input is an integer and is not negative.\"\"\"\n        return isinstance(n, int) and n >= 0\n\n    @staticmethod\n    def validate_values_list(values: Any) -> None:\n        \"\"\"Raises InvalidInputError if values is not a list or tuple of strings.\"\"\"\n        if not Validator.is_str_list(values):\n            raise InvalidInputError(\"values must be a list or tuple of strings\")\n\n    @staticmethod\n    def validate_size(n: Any) -> None:\n        \"\"\"Raises InvalidInputError if size is not a non-negative integer.\"\"\"\n        if not isinstance(n, int):\n            raise InvalidInputError(\"size must be an integer\")\n        if n < 0:\n            raise InvalidInputError(\"size must be non-negative\")\nclass StringRepository:\n    \"\"\"Manages low-level string operations, specifically filtering by length.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def filter_by_length(self, values: List[str], size: int) -> List[str]:\n        \"\"\"Filters a list of strings, returning those whose length exactly matches the specified size.\"\"\"\n        return [s for s in values if len(s) == size]\nclass ExtractService:\n    \"\"\"Encapsulates the business logic for extracting strings, including validation and delegation.\"\"\"\n    def __init__(self, repo: StringRepository, validator: Validator) -> None:\n        self.repo = repo\n        self.validator = validator\n\n    def extract(self, values: List[str], size: int) -> List[str]:\n        \"\"\"Performs input validation and then delegates the filtering operation to the repository.\"\"\"\n        self.validator.validate_values_list(values)\n        self.validator.validate_size(size)\n        return self.repo.filter_by_length(values, size)\n_default_controller = None\nclass ExtractController:\n    \"\"\"Provides the public API interface, delegating requests to the service layer.\"\"\"\n    def __init__(self, service: ExtractService) -> None:\n        self.service = service\n\n    def extract(self, values: List[str], size: int) -> List[str]:\n        \"\"\"Orchestrates the string extraction by calling the underlying service.\"\"\"\n        return self.service.extract(values, size)\ndef _default():\n    \"\"\"Lazily initializes and returns a default ExtractController instance with its dependencies.\"\"\"\n    global _default_controller\n    if _default_controller is None:\n        _default_controller = ExtractController(ExtractService(StringRepository(), Validator()))\n    return _default_controller\ndef extract_string(values: List[str], size: int) -> List[str]:\n    \"\"\"\n    Extracts strings of a specified size from a list of string values.\n    This function delegates to an internal controller for validation and processing.\n    \"\"\"\n    return _default().extract(values, size)"}
{"task_id": "Mbpp/453", "solution": "def sumofFactors(n: int) -> int:\n    \"\"\"Calculates the sum of even factors of a given number n.\n    Handles n=0 by returning 0, as it has no positive divisors.\n    \"\"\"\n    if not isinstance(n, int):\n        # allow integer-like floats\n        if isinstance(n, float) and n.is_integer():\n            n = int(n)\n        else:\n            raise TypeError(\"Input must be an integer\")\n\n    if isinstance(n, bool):\n        raise TypeError(\"Boolean is not an allowed input\")\n\n    if n < 0:\n        raise ValueError(\"Negative numbers not supported\")\n\n    if n == 0:\n        return 0\n\n    total_sum = 0\n    i = 1\n    while i * i <= n:\n        if n % i == 0:\n            if i % 2 == 0:\n                total_sum += i\n\n            # Add the paired divisor if different and even\n            j = n // i\n            if j != i and j % 2 == 0:\n                total_sum += j\n        i += 1\n    return total_sum"}
