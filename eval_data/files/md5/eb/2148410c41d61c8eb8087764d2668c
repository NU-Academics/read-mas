{"task_id": "Mbpp/588", "solution": "def big_diff(values):\n    \"\"\"\n    Calculates the difference between the largest and smallest value in a single pass.\n    This assumes `values` is a non-empty sequence of numeric types.\n    \"\"\"\n    it = iter(values)\n    current_min = current_max = float(next(it))\n\n    for v in it:\n        v_float = float(v)\n        if v_float < current_min:\n            current_min = v_float\n        if v_float > current_max:\n            current_max = v_float\n\n    return current_max - current_min"}
{"task_id": "Mbpp/589", "solution": "import math\nimport pathlib\nimport json\nimport threading\nfrom typing import Optional, List, Dict\nclass InvalidRangeError(ValueError):\n    \"\"\"Raised when an invalid range is provided.\"\"\"\n    pass\nclass CacheError(Exception):\n    \"\"\"Raised when there's an error with the cache operation.\"\"\"\n    pass\nDEFAULT_CACHE_ENABLED: bool = False\nCACHE_FILENAME: str = \"squares_cache.json\"\nclass Config:\n    @staticmethod\n    def get_cache_path() -> pathlib.Path:\n        \"\"\"Computes the OS-appropriate cache path.\"\"\"\n        cache_dir = pathlib.Path.home() / \".cache\" / \"squares\"\n        cache_dir.mkdir(parents=True, exist_ok=True)\n        return cache_dir / CACHE_FILENAME\nclass Range:\n    \"\"\"A data transfer object for numeric ranges.\"\"\"\n    def __init__(self, start: int, end: int):\n        if not isinstance(start, int) or not isinstance(end, int):\n            raise TypeError(\"start and end must be integers\")\n        self.start = start\n        self.end = end\n\n    def validate(self) -> None:\n        \"\"\"Validates the range, raising InvalidRangeError if start > end.\"\"\"\n        if self.start > self.end:\n            raise InvalidRangeError(f\"Start ({self.start}) cannot be greater than end ({self.end})\")\nclass MathUtils:\n    \"\"\"Utility methods for mathematical operations.\"\"\"\n    @staticmethod\n    def floor_sqrt(n: int) -> int:\n        \"\"\"Returns the floor of the square root of n using integer math.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"n must be int\")\n        if n < 0:\n            raise ValueError(\"n must be non-negative\")\n        return math.isqrt(n)\n\n    @staticmethod\n    def is_perfect_square(n: int) -> bool:\n        \"\"\"Returns True if n is a perfect square.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"n must be int\")\n        if n < 0:\n            return False\n        r = MathUtils.floor_sqrt(n)\n        return r * r == n\nclass SquareCacheRepository:\n    \"\"\"Handles persistent caching of computed square lists to a JSON file.\"\"\"\n    def __init__(self, cache_path: pathlib.Path, enabled: bool = False) -> None:\n        self._cache_path = cache_path\n        self._enabled = enabled\n        self._lock = threading.Lock()\n        if self._enabled and not self._cache_path.parent.exists():\n            self._cache_path.parent.mkdir(parents=True, exist_ok=True)\n\n    def _load(self) -> Dict[str, List[int]]:\n        \"\"\"Loads cache data from the JSON file.\"\"\"\n        if not self._enabled or not self._cache_path.exists():\n            return {}\n        with self._lock:\n            try:\n                with open(self._cache_path, 'r', encoding='utf-8') as f:\n                    return json.load(f)\n            except (IOError, json.JSONDecodeError) as e:\n                raise CacheError(f\"Failed to load cache from {self._cache_path}: {e}\") from e\n\n    def _save(self, data: Dict[str, List[int]]) -> None:\n        \"\"\"Saves cache data to the JSON file using atomic write.\"\"\"\n        if not self._enabled:\n            return\n        with self._lock:\n            try:\n                temp_path = self._cache_path.with_suffix('.tmp')\n                with open(temp_path, 'w', encoding='utf-8') as f:\n                    json.dump(data, f, indent=2)\n                temp_path.replace(self._cache_path)\n            except IOError as e:\n                raise CacheError(f\"Failed to save cache to {self._cache_path}: {e}\") from e\n\n    def get(self, start: int, end: int) -> Optional[List[int]]:\n        \"\"\"Retrieves a cached list of perfect squares for the given range.\"\"\"\n        if not self._enabled:\n            return None\n        key = f\"{start}:{end}\"\n        try:\n            cache_data = self._load()\n            return cache_data.get(key)\n        except CacheError:\n            return None\n\n    def set(self, start: int, end: int, squares: List[int]) -> None:\n        \"\"\"Stores a list of perfect squares in the cache.\"\"\"\n        if not self._enabled:\n            return\n        key = f\"{start}:{end}\"\n        try:\n            cache_data = self._load()\n            cache_data[key] = squares\n            self._save(cache_data)\n        except CacheError:\n            pass # Log warning, but don't prevent function from returning result\nclass PerfectSquareService:\n    \"\"\"Core business logic to compute perfect squares, optionally using a cache.\"\"\"\n    def __init__(self, cache_repo: Optional[SquareCacheRepository] = None) -> None:\n        self._cache_repo = cache_repo\n\n    def compute(self, start: int, end: int) -> List[int]:\n        \"\"\"Computes all perfect squares within the given inclusive range.\"\"\"\n        rng = Range(start, end)\n        rng.validate()\n\n        if self._cache_repo and self._cache_repo._enabled:\n            cached = self._cache_repo.get(start, end)\n            if cached is not None:\n                return cached\n\n        result = self._compute_without_cache(start, end)\n\n        if self._cache_repo and self._cache_repo._enabled:\n            try:\n                self._cache_repo.set(start, end, result)\n            except CacheError:\n                pass # Log warning, but don't prevent function from returning result\n        return result\n\n    def _compute_without_cache(self, start: int, end: int) -> List[int]:\n        \"\"\"Computes perfect squares directly without using the cache.\"\"\"\n        if end < 0:\n            return []\n\n        effective_start = max(0, start)\n\n        r1 = MathUtils.floor_sqrt(effective_start)\n        if r1 * r1 < effective_start:\n            r1 += 1\n\n        r2 = MathUtils.floor_sqrt(end)\n\n        if r1 > r2:\n            return []\n\n        return [i * i for i in range(r1, r2 + 1)]\ndef perfect_squares(start: int, end: int) -> List[int]:\n    \"\"\"\n    Finds perfect squares between two given numbers (inclusive).\n    The function uses an optional, configurable cache.\n    \"\"\"\n    cache_path = Config.get_cache_path()\n    repo = SquareCacheRepository(cache_path=cache_path, enabled=DEFAULT_CACHE_ENABLED)\n    svc = PerfectSquareService(cache_repo=repo if DEFAULT_CACHE_ENABLED else None)\n    return svc.compute(start, end)"}
{"task_id": "Mbpp/591", "solution": "def swap_List(lst):\n    \"\"\"Interchanges the first and last elements of a list, returning a new list.\n    For lists with less than two elements, a shallow copy is returned without changes.\n    \"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"swap_List expects a list\")\n\n    if len(lst) < 2:\n        return list(lst)\n\n    new_list = list(lst)\n    new_list[0], new_list[-1] = new_list[-1], new_list[0]\n    return new_list"}
{"task_id": "Mbpp/592", "solution": "def sum_Of_product(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the product of consecutive binomial coefficients using the identity C(2n, n-1).\n    This computes sum_{k=0}^{n-1} C(n,k) * C(n,k+1).\n    \"\"\"\n    import math\n    # Validate input\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 1:\n        raise ValueError(\"n must be >= 1\")\n    # The sum of products of consecutive binomial coefficients C(n,k) * C(n,k+1)\n    # for k from 0 to n-1 is mathematically equivalent to C(2n, n-1).\n    return math.comb(2 * n, n - 1)"}
{"task_id": "Mbpp/593", "solution": "from typing import List, Optional\nclass InvalidIPAddressError(Exception):\n    \"\"\"Custom exception for invalid IPv4 address formats or values.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass IPAddress:\n    \"\"\"Represents an IPv4 address with integer octets and provides normalized string representation.\"\"\"\n    def __init__(self, octets: List[int]) -> None:\n        if len(octets) != 4:\n            raise InvalidIPAddressError(\"IP must have exactly 4 octets.\")\n        for o in octets:\n            if not (0 <= o <= 255):\n                raise InvalidIPAddressError(f\"Octet {o} out of range (0-255).\")\n        self.octets: List[int] = octets\n\n    @classmethod\n    def from_ints(cls, octets: List[int]) -> \"IPAddress\":\n        \"\"\"Factory method to create an IPAddress from a list of integers.\"\"\"\n        return cls(octets)\n\n    def to_normalized_str(self) -> str:\n        \"\"\"Returns the IPv4 address as a normalized string, without leading zeros.\"\"\"\n        return \".\".join(str(o) for o in self.octets)\n\n    def __str__(self) -> str:\n        return self.to_normalized_str()\nclass IPParser:\n    \"\"\"Parses an IP string into a list of raw octet strings.\"\"\"\n    def parse(self, ip: str) -> List[str]:\n        \"\"\"Splits the IP string by dots and validates the number of segments.\"\"\"\n        if not isinstance(ip, str) or not ip:\n            raise InvalidIPAddressError(\"IP must be a non-empty string.\")\n        parts = [p.strip() for p in ip.split('.')]\n        if len(parts) != 4:\n            raise InvalidIPAddressError(\"IP must have 4 octets separated by '.'.\")\n        return parts\nclass IPValidator:\n    \"\"\"Validates individual octet strings and converts them to integers.\"\"\"\n    def validate_octets(self, octet_strs: List[str]) -> List[int]:\n        \"\"\"Ensures each octet is numeric and within the valid IPv4 range [0, 255].\"\"\"\n        ints = []\n        for seg in octet_strs:\n            if seg == \"\":\n                raise InvalidIPAddressError(\"Empty octet found.\")\n            if not seg.isdigit():\n                raise InvalidIPAddressError(f\"Non-numeric octet: '{seg}'.\")\n            val = int(seg)\n            if not (0 <= val <= 255):\n                raise InvalidIPAddressError(f\"Octet out of range (0-255): {val}.\")\n            ints.append(val)\n        return ints\nclass IPCleanerService:\n    \"\"\"Orchestrates the parsing, validation, and normalization of an IPv4 address.\"\"\"\n    def __init__(self, parser: Optional[IPParser] = None, validator: Optional[IPValidator] = None) -> None:\n        self._parser = parser if parser is not None else IPParser()\n        self._validator = validator if validator is not None else IPValidator()\n\n    def normalize(self, ip: str) -> str:\n        \"\"\"Performs the full normalization process on the given IP string.\"\"\"\n        parts = self._parser.parse(ip)\n        ints = self._validator.validate_octets(parts)\n        addr = IPAddress.from_ints(ints)\n        return addr.to_normalized_str()\n_service = IPCleanerService()\ndef removezero_ip(ip: str) -> str:\n    \"\"\"Removes leading zeros from each octet of an IPv4 address string.\"\"\"\n    return _service.normalize(ip)"}
{"task_id": "Mbpp/590", "solution": "import math\nclass Polar:\n    \"\"\"Represents polar coordinates (r, theta).\"\"\"\n    def __init__(self, r: float, theta: float) -> None:\n        self.r = float(r)\n        self.theta = float(theta)\n\n    def as_tuple(self) -> tuple[float, float]:\n        \"\"\"Returns the polar coordinates as a tuple (r, theta).\"\"\"\n        return (self.r, self.theta)\nEPSILON = 1e-15\ndef rect_to_polar(x: float, y: float) -> Polar:\n    \"\"\"Converts rectangular coordinates (x, y) to polar coordinates (r, theta).\"\"\"\n    r = math.hypot(x, y)\n    theta = math.atan2(y, x)\n    return Polar(r, theta)\ndef polar_to_rect(r: float, theta: float) -> complex:\n    \"\"\"Converts polar coordinates (r, theta) to rectangular complex number (x + yj).\"\"\"\n    x = r * math.cos(theta)\n    y = r * math.sin(theta)\n    if abs(x) < EPSILON:\n        x = 0.0\n    if abs(y) < EPSILON:\n        y = 0.0\n    return complex(x, y)\ndef polar_rect(a: float, b: float) -> tuple[tuple[float, float], complex]:\n    \"\"\"\n    Converts (a,b) interpreted as rectangular to polar, and (a,b) interpreted\n    as polar to rectangular (complex).\n    \"\"\"\n    polar_coords = rect_to_polar(a, b)\n    rectangular_complex = polar_to_rect(a, b)\n    return (polar_coords.as_tuple(), rectangular_complex)"}
{"task_id": "Mbpp/594", "solution": "def diff_even_odd(nums: list) -> int:\n    \"\"\"Finds the difference of the first even and first odd number in the list.\n\n    Returns first_even - first_odd.\n\n    Raises:\n        ValueError: if nums is not iterable, contains non-int elements, or if first odd/even not found.\n    \"\"\"\n    if nums is None:\n        raise ValueError(\"Input must be a non-empty iterable of integers.\")\n\n    try:\n        iterator = iter(nums)\n    except TypeError:\n        raise ValueError(\"Input must be an iterable.\") from None\n\n    first_even = None\n    first_odd = None\n\n    for idx, num in enumerate(iterator):\n        if not isinstance(num, int) or isinstance(num, bool):\n            raise ValueError(f\"All elements must be integers (bools not allowed). Invalid element at index {idx}: {num!r}\")\n\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n\n        if first_even is None and num % 2 == 0:\n            first_even = num\n\n        if first_even is not None and first_odd is not None:\n            break\n\n    if first_odd is None:\n        raise ValueError(\"No odd number found in the input.\")\n    if first_even is None:\n        raise ValueError(\"No even number found in the input.\")\n\n    return first_even - first_odd"}
