{"task_id": "Mbpp/294", "solution": "from typing import Any, Iterable, List, Optional, Union\nclass MaxFinderError(Exception):\n    def __init__(self, message: str = None) -> None:\n        super().__init__(message)\n        self.message = message\nclass NoNumericValuesError(MaxFinderError):\n    \"\"\"Raised when no numeric values are found in the input.\"\"\"\n    pass\nclass InvalidInputError(MaxFinderError):\n    \"\"\"Raised when the input is not a valid iterable.\"\"\"\n    pass\ndef safe_cast_to_number(value: Any) -> Optional[Union[int, float]]:\n    \"\"\"Tries converting value to int/float; returns None if not convertible or is a bool.\"\"\"\n    if isinstance(value, bool):\n        return None\n    if isinstance(value, (int, float)):\n        return value\n    if isinstance(value, str):\n        s = value.strip()\n        try:\n            return int(s)\n        except ValueError:\n            try:\n                return float(s)\n            except ValueError:\n                return None\n    return None\ndef preserve_int_if_whole(n: float) -> Union[int, float]:\n    \"\"\"Returns int if the float is a whole number within a small tolerance, else returns the float.\"\"\"\n    if isinstance(n, float) and abs(n - int(n)) < 1e-9:\n        return int(n)\n    return n\nclass Validator:\n    def is_iterable(self, obj: Any) -> bool:\n        \"\"\"Returns True if the object is iterable, but not a string.\"\"\"\n        return hasattr(obj, '__iter__') and not isinstance(obj, str)\n\n    def is_strict_numeric(self, obj: Any) -> bool:\n        \"\"\"Returns True if the object is an int or float, but not a bool.\"\"\"\n        return isinstance(obj, (int, float)) and not isinstance(obj, bool)\n\n    def is_numeric_string(self, s: str) -> bool:\n        \"\"\"Returns True if the string can be converted to a number.\"\"\"\n        try:\n            float(s)\n            return True\n        except ValueError:\n            return False\nclass ListAdapter:\n    def __init__(self, validator: Validator) -> None:\n        self._validator = validator\n\n    def get_numeric_candidates(self, items: Iterable[Any], convert_strings: bool = False) -> List[Union[int, float]]:\n        \"\"\"Validates input and extracts numeric candidates, optionally converting numeric strings.\"\"\"\n        if not self._validator.is_iterable(items):\n            raise InvalidInputError(\"Input must be an iterable (e.g., list or tuple).\")\n\n        candidates = []\n        for item in items:\n            if self._validator.is_strict_numeric(item):\n                candidates.append(item)\n            elif convert_strings and isinstance(item, str):\n                num = safe_cast_to_number(item)\n                if num is not None:\n                    candidates.append(num)\n        return candidates\nclass MaxFinderService:\n    def __init__(self, adapter: ListAdapter) -> None:\n        self._adapter = adapter\n\n    def find_max(self, items: Iterable[Any], convert_strings: bool = False) -> Union[int, float]:\n        \"\"\"Finds the maximum numeric value from the given items.\"\"\"\n        candidates = self._adapter.get_numeric_candidates(items, convert_strings=convert_strings)\n        if not candidates:\n            raise NoNumericValuesError(\"No numeric values found in input.\")\n\n        max_val_result = max(candidates)\n        return preserve_int_if_whole(float(max_val_result))\nclass MaxController:\n    def __init__(self, service: MaxFinderService) -> None:\n        self._service = service\n\n    def max_val(self, items: Iterable[Any], convert_strings: bool = False) -> Union[int, float]:\n        \"\"\"Public API function to find the maximum numeric value.\"\"\"\n        return self._service.find_max(items, convert_strings=convert_strings)\n_default_controller: Optional[MaxController] = None\ndef max_val(items: Iterable[Any], convert_strings: bool = False) -> Union[int, float]:\n    \"\"\"\n    Finds the maximum numeric value in a given heterogeneous list.\n    Non-numeric elements (including booleans by default) are ignored.\n    \"\"\"\n    global _default_controller\n    if _default_controller is None:\n        validator = Validator()\n        adapter = ListAdapter(validator=validator)\n        service = MaxFinderService(adapter=adapter)\n        _default_controller = MaxController(service=service)\n    return _default_controller.max_val(items, convert_strings=convert_strings)"}
{"task_id": "Mbpp/297", "solution": "from collections import deque\nfrom typing import Any, List\ndef flatten_list(input_data: Any) -> List[Any]:\n    \"\"\"Flattens a given nested list structure into a single list.\n    Only list and tuple types are expanded; other iterables are treated as atomic.\n    \"\"\"\n    result: List[Any] = []\n    stack = deque([input_data])\n    allowed_iter_types = (list, tuple)\n\n    while stack:\n        current = stack.popleft()\n        if isinstance(current, allowed_iter_types):\n            # Iterate in reverse and append to left to maintain original order\n            for item in reversed(current):\n                stack.appendleft(item)\n        else:\n            result.append(current)\n    return result"}
{"task_id": "Mbpp/296", "solution": "from collections.abc import Iterable, Sequence\nimport abc\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to inversion counting functions.\"\"\"\n    pass\nclass AlgorithmNotFoundError(Exception):\n    \"\"\"Custom exception for when a specified algorithm is not found.\"\"\"\n    pass\ndef validate_iterable(obj):\n    \"\"\"Checks if an object is iterable and not a string/bytes type.\"\"\"\n    return isinstance(obj, Iterable) and not isinstance(obj, (str, bytes))\ndef ensure_comparable(items):\n    \"\"\"Ensures all elements in a sequence are mutually comparable.\"\"\"\n    if not items:\n        return True\n    try:\n        # Test a few pairs for comparability.\n        for i in range(min(len(items), 10)):\n            if i + 1 < len(items):\n                _ = items[i] < items[i+1]\n                _ = items[i] > items[i+1]\n        return True\n    except TypeError:\n        return False\nDEFAULT_ALGORITHM = \"merge\"\nclass ArrayModel:\n    \"\"\"Encapsulates an array, ensuring elements are handled as a list.\"\"\"\n    def __init__(self, items):\n        self.items = items\n\n    @classmethod\n    def from_iterable(cls, iterable):\n        \"\"\"Creates an ArrayModel instance from any iterable.\"\"\"\n        if iterable is None:\n            raise InvalidInputError(\"Input iterable cannot be None.\")\n        return cls(list(iterable))\n\n    def __len__(self):\n        return len(self.items)\n\n    def __getitem__(self, index):\n        return self.items[index]\nclass IInversionCounter(abc.ABC):\n    \"\"\"Interface for inversion counting algorithms.\"\"\"\n    @abc.abstractmethod\n    def count(self, arr: ArrayModel) -> int:\n        pass\nclass MergeSortInversionCounter(IInversionCounter):\n    \"\"\"Counts inversions using a modified merge sort algorithm.\"\"\"\n    def count(self, arr: ArrayModel) -> int:\n        if not ensure_comparable(arr.items):\n            raise InvalidInputError(\"Elements in the array are not mutually comparable.\")\n        _, inv = self._sort_count(list(arr.items))\n        return inv\n\n    def _sort_count(self, items: list) -> tuple:\n        n = len(items)\n        if n <= 1:\n            return items, 0\n        mid = n // 2\n        left_half, left_inversions = self._sort_count(items[:mid])\n        right_half, right_inversions = self._sort_count(items[mid:])\n\n        merged_list, merge_inversions = self._merge_count(left_half, right_half)\n        return merged_list, left_inversions + right_inversions + merge_inversions\n\n    def _merge_count(self, left: list, right: list) -> tuple:\n        i = j = 0\n        merged = []\n        inversions = 0\n\n        while i < len(left) and j < len(right):\n            if left[i] <= right[j]:\n                merged.append(left[i])\n                i += 1\n            else:\n                # An inversion occurs: right[j] is smaller than all remaining elements in left[i:]\n                merged.append(right[j])\n                j += 1\n                inversions += len(left) - i\n\n        merged.extend(left[i:])\n        merged.extend(right[j:])\n        return merged, inversions\nclass BruteForceInversionCounter(IInversionCounter):\n    \"\"\"Counts inversions using a brute-force O(n^2) approach.\"\"\"\n    def count(self, arr: ArrayModel) -> int:\n        if not ensure_comparable(arr.items):\n            raise InvalidInputError(\"Elements in the array are not mutually comparable.\")\n        inversions = 0\n        n = len(arr.items)\n        for i in range(n):\n            for j in range(i + 1, n):\n                if arr.items[i] > arr.items[j]:\n                    inversions += 1\n        return inversions\nclass AlgorithmFactory:\n    \"\"\"Factory for creating inversion counter algorithm instances.\"\"\"\n    def get(self, name: str) -> IInversionCounter:\n        if name == \"merge\":\n            return MergeSortInversionCounter()\n        elif name == \"brute\":\n            return BruteForceInversionCounter()\n        else:\n            raise AlgorithmNotFoundError(f\"Algorithm '{name}' not found.\")\nclass InversionCounterService:\n    \"\"\"Orchestrates inversion counting: validates input and selects algorithm.\"\"\"\n    def __init__(self, factory: AlgorithmFactory = None) -> None:\n        self._factory = factory if factory is not None else AlgorithmFactory()\n\n    def get_inv_count(self, iterable, algorithm: str = None) -> int:\n        \"\"\"Computes the inversion count for an iterable using a specified algorithm.\"\"\"\n        if not validate_iterable(iterable):\n            raise InvalidInputError(\"Input must be an iterable (e.g., list, tuple) and not a string.\")\n\n        array_model = ArrayModel.from_iterable(iterable)\n\n        selected_algorithm = algorithm if algorithm is not None else DEFAULT_ALGORITHM\n\n        counter = self._factory.get(selected_algorithm)\n        return counter.count(array_model)\ndef get_Inv_Count(arr):\n    \"\"\"Counts inversions in an array using the default merge-sort algorithm.\"\"\"\n    service = InversionCounterService()\n    return service.get_inv_count(arr)"}
{"task_id": "Mbpp/299", "solution": "from typing import Iterable, Tuple, Dict, List, Union\ndef max_aggregate(records: Iterable[Tuple[str, Union[int, float]]]) -> Tuple[str, Union[int, float]]:\n    \"\"\"\n    Computes the name with the highest aggregate total from a list of records,\n    breaking ties by the first encountered name.\n    \"\"\"\n    aggregates: Dict[str, Union[int, float]] = {}\n    first_seen_order: List[str] = []\n\n    for name, value in records:\n        # If the name is seen for the first time, add it to the ordered list\n        if name not in aggregates:\n            first_seen_order.append(name)\n            aggregates[name] = value\n        else:\n            # If name already exists, just add to its total\n            aggregates[name] += value\n\n    # If no records were processed (e.g., empty input), return a default neutral tuple.\n    if not aggregates:\n        return (\"\", 0)\n\n    # Find the maximum aggregate total, respecting the first_seen_order for tie-breaking.\n    max_name: str = \"\"\n    max_total: Union[int, float] = float('-inf')\n\n    for name in first_seen_order:\n        current_total = aggregates[name]\n        if current_total > max_total:\n            max_total = current_total\n            max_name = name\n\n    return (max_name, max_total)"}
{"task_id": "Mbpp/300", "solution": "def count_binary_seq(n: int) -> int:\n    \"\"\"\n    Computes the count of binary sequences of length 2n where the sum of the first n bits\n    equals the sum of the last n bits, using a mathematical identity C(2n, n).\n    \"\"\"\n    from .binomial import BinomialCalculator\n    from .validator import InputValidator\n    from .service import CountService\n\n    # Instantiate the core components\n    calculator = BinomialCalculator()\n    validator = InputValidator()\n    service = CountService(calculator, validator)\n\n    # Delegate the actual calculation and validation to the service layer\n    return service.count_binary_seq(n)"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(d: dict) -> int:\n    \"\"\"\n    Calculates the maximum nesting depth of a dictionary.\n    An empty dictionary has a depth of 0; a non-empty dictionary with no nested dictionaries has a depth of 1.\n    \"\"\"\n    if not isinstance(d, dict):\n        raise TypeError(\"Input must be a dict\")\n\n    if not d:\n        return 0\n\n    def _get_max_depth(current_dict: dict, current_level: int) -> int:\n        max_depth = current_level\n        for value in current_dict.values():\n            if isinstance(value, dict):\n                max_depth = max(max_depth, _get_max_depth(value, current_level + 1))\n        return max_depth\n\n    return _get_max_depth(d, 1)"}
{"task_id": "Mbpp/308", "solution": "import heapq\nfrom typing import List, Union\ndef large_product(list_a: List[Union[int, float]], list_b: List[Union[int, float]], k: int) -> List[Union[int, float]]:\n    \"\"\"\n    Finds the specified number of largest products from two given lists,\n    selecting one factor from each list using a heap-based approach.\n    \"\"\"\n    if not isinstance(k, int) or k <= 0:\n        raise ValueError(\"k must be a positive integer\")\n    if not list_a or not list_b:\n        return []\n\n    # Sort lists in descending order to easily access largest elements\n    sorted_a = sorted(list_a, reverse=True)\n    sorted_b = sorted(list_b, reverse=True)\n\n    # Use a min-heap to effectively find the 'k' largest products.\n    # We store (-product, index_a, index_b) to use min-heap as max-heap.\n    heap = []\n    visited = set()\n\n    def _push_pair_to_heap(i: int, j: int) -> None:\n        if 0 <= i < len(sorted_a) and 0 <= j < len(sorted_b) and (i, j) not in visited:\n            visited.add((i, j))\n            product = sorted_a[i] * sorted_b[j]\n            heapq.heappush(heap, (-product, i, j))\n\n    # Start with the product of the two largest elements (first elements after sorting).\n    _push_pair_to_heap(0, 0)\n\n    results = []\n    while heap and len(results) < k:\n        neg_product, i, j = heapq.heappop(heap)\n        results.append(-neg_product)\n\n        # Explore next candidates\n        _push_pair_to_heap(i + 1, j)\n        _push_pair_to_heap(i, j + 1)\n\n    return results"}
{"task_id": "Mbpp/305", "solution": "def start_withp(words: list) -> tuple:\n    \"\"\"\n    Returns the first two words from a list of strings that start with 'p' (case-insensitive).\n    Raises NotEnoughMatchesError if fewer than two such words are found.\n    \"\"\"\n    TRIM_CHARS = '.,;:!?\\\"\\'()[]{}'\n    found = []\n\n    class NotEnoughMatchesError(ValueError):\n        pass\n\n    def normalize(token: str) -> str:\n        return token.strip(TRIM_CHARS)\n\n    def starts_with_p(token: str, letter: str = 'p') -> bool:\n        return bool(token) and token[0].lower() == letter.lower()\n\n    for line in words:\n        for token in str(line).split():\n            cleaned_token = normalize(token)\n            if cleaned_token and starts_with_p(cleaned_token):\n                found.append(cleaned_token)\n                if len(found) == 2:\n                    return (found[0], found[1])\n\n    raise NotEnoughMatchesError(\"Need at least two words starting with 'p'\")"}
