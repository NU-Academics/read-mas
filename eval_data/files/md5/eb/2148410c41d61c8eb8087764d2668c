{"task_id": "Mbpp/63", "solution": "from typing import Iterable, List, Any, Union, Tuple\nSUPPORTED_NUMBER_TYPES = (int, float)\nclass TupleDiffError(Exception):\n    \"\"\"\n    Domain-specific exception type for validation and service errors.\n    \"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\n    def __str__(self) -> str:\n        return self.message\nclass Pair:\n    \"\"\"\n    Represents a validated 2-element numeric pair.\n    \"\"\"\n    def __init__(self, a: Union[int, float], b: Union[int, float]) -> None:\n        self._a = a\n        self._b = b\n\n    @property\n    def a(self) -> Union[int, float]:\n        return self._a\n\n    @property\n    def b(self) -> Union[int, float]:\n        return self._b\n\n    def difference(self) -> float:\n        \"\"\"\n        Returns the absolute difference between the two elements.\n        \"\"\"\n        return abs(self._a - self._b)\nclass PairValidator:\n    \"\"\"\n    Validates raw input and converts to List[Pair].\n    \"\"\"\n    def validate_pairs(self, pairs: Iterable, allow_iterables: bool = True) -> List[Pair]:\n        if pairs is None:\n            raise TupleDiffError(\"pairs is None\")\n\n        if isinstance(pairs, str):\n            raise TupleDiffError(\"Input 'pairs' cannot be a string. Expected an iterable of pairs.\")\n\n        validated: List[Pair] = []\n        for idx, item in enumerate(pairs):\n            if not (isinstance(item, (list, tuple)) and len(item) == 2):\n                raise TupleDiffError(f\"item at index {idx} is not a 2-element sequence: {item}. Expected a list or tuple of length 2.\")\n\n            a, b = item\n            if not isinstance(a, SUPPORTED_NUMBER_TYPES) or not isinstance(b, SUPPORTED_NUMBER_TYPES):\n                raise TupleDiffError(f\"non-numeric element at index {idx}: {item}. Expected int or float.\")\n\n            validated.append(Pair(a, b))\n\n        if not validated: # Equivalent to len(validated) == 0\n            raise TupleDiffError(\"no pairs provided\")\n\n        return validated\nclass MaxDifferenceService:\n    \"\"\"\n    Computes the maximum absolute difference across provided pairs.\n    \"\"\"\n    def __init__(self, validator: PairValidator = None) -> None:\n        self._validator = validator or PairValidator()\n\n    def compute_max_difference(self, pairs: Iterable[Tuple[Union[int,float],Union[int,float]]]) -> Union[int, float]:\n        \"\"\"\n        Validates input and computes the maximum absolute difference.\n        \"\"\"\n        validated_pairs = self._validator.validate_pairs(pairs)\n\n        max_diff = validated_pairs[0].difference()\n\n        for pair in validated_pairs[1:]:\n            diff = pair.difference()\n            if diff > max_diff:\n                max_diff = diff\n\n        if isinstance(max_diff, float) and max_diff.is_integer():\n            return int(max_diff)\n        return max_diff\ndef max_difference(pairs: Iterable[Tuple[Union[int, float], Union[int, float]]]) -> Union[int, float]:\n    \"\"\"\n    Finds the maximum absolute difference between available pairs in the given tuple list.\n    \"\"\"\n    service = MaxDifferenceService()\n    return service.compute_max_difference(pairs)"}
