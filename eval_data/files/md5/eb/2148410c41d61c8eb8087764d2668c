{"task_id": "Mbpp/287", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of squares of the first n even natural numbers using a closed-form formula.\n    Assumes n is a non-negative integer.\n    \"\"\"\n    # The formula is S(n) = sum_{k=1..n} (2k)^2 = 4 * sum_{k=1..n} k^2 = 4 * n(n+1)(2n+1) / 6\n    # Simplified integer form: (2 * n * (n + 1) * (2 * n + 1)) // 3\n    return (2 * n * (n + 1) * (2 * n + 1)) // 3"}
{"task_id": "Mbpp/285", "solution": "def text_match_two_three(text):\n    \"\"\"Checks if a string contains 'a' followed by two or three 'b' characters using regex.\"\"\"\n    import re\n    if not isinstance(text, str):\n        raise TypeError(\"text must be a str\")\n    pattern = r\"a(?:bb|bbb)\"\n    return bool(re.search(pattern, text))"}
{"task_id": "Mbpp/286", "solution": "def max_sub_array_sum_repeated(arr: list[int], n: int, k: int) -> int:\n    \"\"\"Calculates the largest sum of a contiguous subarray in the given array repeated k times.\n    Assumes arr is a list of ints, n == len(arr), and k >= 1.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"arr must be a list of integers\")\n    if n != len(arr):\n        raise ValueError(\"n must be equal to len(arr)\")\n    if n == 0:\n        raise ValueError(\"arr must be non-empty\")\n    if not isinstance(k, int) or k < 1:\n        raise ValueError(\"k must be an integer >= 1\")\n\n    def kadane(current_arr: list[int]) -> int:\n        \"\"\"Kadane's algorithm: max contiguous subarray sum for current_arr.\"\"\"\n        max_current = max_global = current_arr[0]\n        for x in current_arr[1:]:\n            max_current = max(x, max_current + x)\n            max_global = max(max_global, max_current)\n        return max_global\n\n    def max_prefix_sum(current_arr: list[int]) -> int:\n        \"\"\"Maximum prefix sum (from start up to any index).\"\"\"\n        current_sum = 0\n        max_p_sum = current_arr[0]\n        for x in current_arr:\n            current_sum += x\n            if current_sum > max_p_sum:\n                max_p_sum = current_sum\n        return max_p_sum\n\n    def max_suffix_sum(current_arr: list[int]) -> int:\n        \"\"\"Maximum suffix sum (from any index to the end).\"\"\"\n        current_sum = 0\n        max_s_sum = current_arr[-1]\n        for x in reversed(current_arr):\n            current_sum += x\n            if current_sum > max_s_sum:\n                max_s_sum = current_sum\n        return max_s_sum\n\n    # Base computations\n    base_max = kadane(arr)\n    if k == 1:\n        return base_max\n\n    prefix_sum = max_prefix_sum(arr)\n    suffix_sum = max_suffix_sum(arr)\n    total_array_sum = sum(arr)\n\n    # Consider best among:\n    # - best within one array (base_max)\n    # - best spanning two concatenated arrays (suffix + prefix)\n    overall_max = max(base_max, suffix_sum + prefix_sum)\n\n    # If total sum positive, spanning many arrays could be best\n    if total_array_sum > 0:\n        overall_max = max(overall_max, suffix_sum + (k - 2) * total_array_sum + prefix_sum)\n\n    return overall_max"}
{"task_id": "Mbpp/290", "solution": "def max_length(list_of_lists):\n    \"\"\"\n    Finds the list of maximum length in a list of lists.\n    Returns a tuple containing the maximum length and one list having that maximum length.\n    \"\"\"\n    if not list_of_lists:\n        return (0, [])\n\n    max_len = 0\n    chosen_list = []\n\n    for sublist in list_of_lists:\n        current_len = len(sublist)\n        if current_len >= max_len:\n            max_len = current_len\n            chosen_list = sublist\n\n    return (max_len, chosen_list)"}
