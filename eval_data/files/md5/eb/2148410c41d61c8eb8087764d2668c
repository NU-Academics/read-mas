{"task_id": "Mbpp/745", "solution": "def divisible_by_digits(startnum: int, endnum: int) -> list[int]:\n    \"\"\"\n    Finds numbers within a given range where every number is divisible by every non-zero digit it contains.\n    Numbers containing the digit 0 are excluded.\n    \"\"\"\n    def _get_digits(n: int) -> list[int]:\n        \"\"\"Extracts the digits of an integer as a list.\"\"\"\n        s = str(abs(n))\n        return [int(ch) for ch in s]\n\n    def _is_divisible_by_all_its_digits(n: int) -> bool:\n        \"\"\"Checks if a number is divisible by all its non-zero digits.\"\"\"\n        digits = _get_digits(n)\n        for digit in digits:\n            if digit == 0:\n                return False  # Exclude numbers containing the digit 0\n            if abs(n) % digit != 0:\n                return False  # Not divisible by this digit\n        return True\n\n    result_numbers = []\n    for num in range(startnum, endnum + 1):\n        if _is_divisible_by_all_its_digits(num):\n            result_numbers.append(num)\n\n    return result_numbers"}
{"task_id": "Mbpp/749", "solution": "from typing import List, Tuple\ndef sort_numeric_strings(values: List[str]) -> List[int]:\n    \"\"\"\n    Sorts a list of strings of numbers numerically, returning a list of integers.\n    Raises ParsingError if any string cannot be converted to an integer.\n    \"\"\"\n    class SortingError(Exception):\n        \"\"\"Base exception for sorting-related errors.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n\n    class ParsingError(SortingError):\n        \"\"\"Raised when one or more strings cannot be parsed as integers, detailing invalid items.\"\"\"\n        def __init__(self, message: str, invalid_items: List[Tuple[int, str]]) -> None:\n            super().__init__(message)\n            self.invalid_items = invalid_items\n\n    parsed_numbers: List[int] = []\n    invalid_items_found: List[Tuple[int, str]] = []\n\n    for index, s in enumerate(values):\n        try:\n            parsed_numbers.append(int(s))\n        except ValueError:\n            # Catches errors for non-integer strings like '12a', '3.14', or empty strings.\n            invalid_items_found.append((index, s))\n\n    if invalid_items_found:\n        raise ParsingError(\"One or more input strings could not be parsed as integers.\", invalid_items_found)\n\n    parsed_numbers.sort()\n    return parsed_numbers"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(arr):\n    \"\"\"\n    Checks if the given array represents a min-heap.\n    An empty array or single-element array is considered a valid min-heap.\n    \"\"\"\n    n = len(arr)\n\n    # Empty array or single-element array is a valid min-heap\n    if n <= 1:\n        return True\n\n    # Iterate through internal nodes (parents)\n    # The last parent node is at index (n // 2) - 1\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child\n        if left_child_idx < n and arr[left_child_idx] < arr[i]:\n            return False\n\n        # Check right child\n        if right_child_idx < n and arr[right_child_idx] < arr[i]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/748", "solution": "import re\nimport sqlite3\nimport datetime\nfrom typing import Optional, List, Tuple\nfrom dataclasses import dataclass\nclass ValidationError(ValueError):\n    pass\nclass PersistenceError(RuntimeError):\n    pass\nclass RegexTransformer:\n    \"\"\"Handles core text transformation using regular expressions.\"\"\"\n    RE_LOWER_TO_UPPER = r'([a-z0-9])([A-Z])'\n    RE_UPPER_TO_UPPER_LOWER = r'([A-Z])([A-Z][a-z])'\n\n    def transform(self, text: str) -> str:\n        # First pass: insert space between lower/digit and uppercase letters.\n        s = re.sub(self.RE_LOWER_TO_UPPER, r'\\1 \\2', text)\n        # Second pass: insert space between an uppercase letter and a capitalized word (e.g., 'HTTP Server').\n        s = re.sub(self.RE_UPPER_TO_UPPER_LOWER, r'\\1 \\2', s)\n        return s\nclass TransformationRepository:\n    \"\"\"Manages optional persistence of transformations in an SQLite database.\"\"\"\n    CREATE_TABLE_SQL = \"\"\"\n    CREATE TABLE IF NOT EXISTS transformations (\n      id INTEGER PRIMARY KEY AUTOINCREMENT,\n      input_text TEXT NOT NULL,\n      output_text TEXT NOT NULL,\n      created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n    );\n    \"\"\"\n    CREATE_INDEX_SQL = \"CREATE INDEX IF NOT EXISTS idx_transformations_created_at ON transformations(created_at DESC);\"\n\n    def __init__(self, db_path: str = ':memory:') -> None:\n        self._db_path = db_path\n        self._conn: Optional[sqlite3.Connection] = None\n\n    def _get_conn(self) -> sqlite3.Connection:\n        \"\"\"Establishes and returns a database connection.\"\"\"\n        if self._conn is None:\n            try:\n                self._conn = sqlite3.connect(self._db_path)\n                self._conn.row_factory = sqlite3.Row\n            except sqlite3.Error as e:\n                raise PersistenceError(f\"Failed to connect to database at {self._db_path}\") from e\n        return self._conn\n\n    def init_schema(self) -> None:\n        \"\"\"Creates the necessary database table and index if they do not exist.\"\"\"\n        conn = self._get_conn()\n        try:\n            cursor = conn.cursor()\n            cursor.execute(self.CREATE_TABLE_SQL)\n            cursor.execute(self.CREATE_INDEX_SQL)\n            conn.commit()\n        except sqlite3.Error as e:\n            raise PersistenceError(\"Failed to initialize database schema\") from e\n\n    def save(self, input_text: str, output_text: str) -> int:\n        \"\"\"Saves an input-output transformation pair to the database.\"\"\"\n        conn = self._get_conn()\n        try:\n            cursor = conn.cursor()\n            cursor.execute(\n                \"INSERT INTO transformations (input_text, output_text) VALUES (?, ?)\",\n                (input_text, output_text)\n            )\n            conn.commit()\n            return cursor.lastrowid if cursor.lastrowid is not None else -1\n        except sqlite3.Error as e:\n            raise PersistenceError(\"Failed to save transformation\") from e\n\n    def get_recent(self, limit: int = 10) -> List[Tuple[int, str, str, datetime.datetime]]:\n        \"\"\"Retrieves a list of recent transformations.\"\"\"\n        conn = self._get_conn()\n        try:\n            cursor = conn.cursor()\n            cursor.execute(\n                \"SELECT id, input_text, output_text, created_at FROM transformations ORDER BY created_at DESC LIMIT ?\",\n                (limit,)\n            )\n            results = []\n            for row in cursor.fetchall():\n                created_at_dt = datetime.datetime.strptime(row['created_at'], '%Y-%m-%d %H:%M:%S')\n                results.append((row['id'], row['input_text'], row['output_text'], created_at_dt))\n            return results\n        except sqlite3.Error as e:\n            raise PersistenceError(\"Failed to retrieve recent transformations\") from e\n\n    def __enter__(self):\n        self._get_conn()\n        return self\n\n    def __exit__(self, exc_type, exc_val, exc_tb):\n        if self._conn:\n            self._conn.close()\n            self._conn = None\nclass CapitalWordsService:\n    \"\"\"Orchestrates validation, transformation, and optional persistence.\"\"\"\n    DEFAULT_MAX_INPUT_LENGTH = 10000\n\n    def __init__(self, transformer: RegexTransformer, repository: Optional[TransformationRepository] = None):\n        self.transformer = transformer\n        self.repository = repository\n\n    def transform_text(self, text: str) -> str:\n        \"\"\"Transforms the given text after validation and optionally persists the result.\"\"\"\n        if not isinstance(text, str):\n            raise ValidationError(\"text must be a str\")\n        if len(text) > self.DEFAULT_MAX_INPUT_LENGTH:\n            raise ValidationError(f\"text too long, max {self.DEFAULT_MAX_INPUT_LENGTH} characters\")\n\n        out = self.transformer.transform(text)\n\n        if self.repository is not None:\n            try:\n                self.repository.save(text, out)\n            except Exception as e:\n                raise PersistenceError(\"Failed to persist transformation\") from e\n        return out\nclass CapitalWordsController:\n    \"\"\"Provides a thin adapter for the transformation service.\"\"\"\n    def __init__(self, service: CapitalWordsService) -> None:\n        self.service = service\n\n    def transform(self, text: str) -> str:\n        \"\"\"Validates input type and delegates transformation to the service.\"\"\"\n        return self.service.transform_text(text)\n_repository: Optional[TransformationRepository] = None\n_service = CapitalWordsService(RegexTransformer(), repository=_repository)\n_controller = CapitalWordsController(_service)\ndef capital_words_spaces(text: str) -> str:\n    \"\"\"\n    Inserts spaces between words in a string that are joined by capital letters (CamelCase / PascalCase).\n    Preserves acronyms and handles digits as lowercase characters for boundary detection.\n    \"\"\"\n    return _controller.transform(text)"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1, l2, l3):\n    \"\"\"\n    Finds elements that are common for lists l1, l2, l3 by appearing in all three\n    under the same index. Returns a list of these common elements.\n    \"\"\"\n    min_len = min(len(l1), len(l2), len(l3))\n    common_elements = []\n    for i in range(min_len):\n        if l1[i] == l2[i] and l2[i] == l3[i]:\n            common_elements.append(l1[i])\n    return common_elements"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Calculates the nth Jacobsthal number iteratively.\n    The sequence is defined as J(0)=0, J(1)=1, and J(n) = J(n-1) + 2*J(n-2) for n > 1.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n\n    a, b = 0, 1  # a = J(k-2), b = J(k-1)\n    for _ in range(2, n + 1):\n        a, b = b, b + 2 * a  # compute J(k) = J(k-1) + 2*J(k-2)\n    return b"}
{"task_id": "Mbpp/753", "solution": "import heapq\nfrom typing import List, Tuple, Any, Iterable\ndef min_k(records: Iterable[Tuple[str, Any]], k: int) -> List[Tuple[str, float]]:\n    \"\"\"\n    Finds the k minimum records from a list of tuples, sorted by numeric value then by name.\n    \"\"\"\n\n    # Normalize records into a comparable format: (numeric_value, name_string, original_name_string, original_numeric_value_float)\n    # The first two elements form the primary sorting key, ensuring correct order and tie-breaking.\n    processed_records = []\n    for name, value in records:\n        numeric_value = float(value) # Coerce value to float as per design\n        processed_records.append((numeric_value, name, name, numeric_value))\n\n    n = len(processed_records)\n\n    if k == 0:\n        return []\n\n    if k >= n:\n        # If k is greater than or equal to the number of records, return all records sorted.\n        # Python's `sorted` on tuples naturally sorts by the first element, then the second, etc.\n        # This matches the (value, name) tie-breaking requirement.\n        sorted_all = sorted(processed_records)\n        return [(orig_name, orig_value) for _, _, orig_name, orig_value in sorted_all]\n\n    HEAP_THRESHOLD_RATIO = 0.25\n\n    if k / n <= HEAP_THRESHOLD_RATIO:\n        # Use a min-heap to efficiently find the k smallest elements (simulating a max-heap for inverted keys).\n        # The heap will store elements in the format (inverted_sort_key_tuple, original_output_tuple_content).\n        # inverted_sort_key_tuple is (-value, name) so that a min-heap stores the k largest (value, name) at its root (smallest negative value is largest positive value).\n        # Thus, `heap[0]` will always be the largest among the k elements currently considered smallest.\n        max_heap = [] # Stores ((-value, name), (original_name, original_float_value))\n\n        for current_value, current_name, orig_name, orig_float_value in processed_records:\n            current_sort_key = (-current_value, current_name)\n            output_content = (orig_name, orig_float_value)\n\n            if len(max_heap) < k:\n                heapq.heappush(max_heap, (current_sort_key, output_content))\n            else:\n                # If the current item is smaller than the largest item currently in the heap (heap[0]),\n                # replace the largest with the current item.\n                # `current_sort_key > max_heap[0][0]` means (-current_value, current_name) > (-largest_value_in_heap, largest_name_in_heap),\n                # which implies `current_value` is smaller than `largest_value_in_heap`.\n                if current_sort_key > max_heap[0][0]:\n                    heapq.heapreplace(max_heap, (current_sort_key, output_content))\n\n        # Extract the original output tuples from the heap.\n        result_output_tuples = [item[1] for item in max_heap]\n\n        # The elements in the heap are not necessarily sorted relative to each other.\n        # Sort the final k elements by value then name to meet the output requirement.\n        return sorted(result_output_tuples, key=lambda x: (x[1], x[0]))\n\n    else:\n        # For k values close to n, sorting the entire list and slicing is simpler and often faster.\n        sorted_records = sorted(processed_records)\n\n        # Take the first k elements and convert them to the final output format.\n        return [(orig_name, orig_value) for _, _, orig_name, orig_value in sorted_records[:k]]"}
{"task_id": "Mbpp/757", "solution": "from typing import List, Dict\ndef count_reverse_pairs(strings: List[str]) -> int:\n    \"\"\"\n    Counts pairs of strings where one is the reverse of the other.\n    The algorithm uses a hash map for efficient lookups.\n    \"\"\"\n    def reverse_string(s: str) -> str:\n        \"\"\"Reverses a given string.\"\"\"\n        return s[::-1]\n\n    seen: Dict[str, int] = {}\n    total_pairs = 0\n    for s in strings:\n        r = reverse_string(s)\n        total_pairs += seen.get(r, 0)\n        seen[s] = seen.get(s, 0) + 1\n    return total_pairs"}
{"task_id": "Mbpp/755", "solution": "import math\ndef second_smallest(values):\n    \"\"\"\n    Finds the second smallest number in a list, considering duplicates.\n    Returns an int if all input elements are integral and the result is integral, else a float.\n    \"\"\"\n    first = float(math.inf)\n    second = float(math.inf)\n\n    for v in values:\n        n = float(v)\n        if n <= first:\n            second = first\n            first = n\n        elif n <= second:\n            second = n\n\n    # Determine the return type based on input types and second smallest value\n    if all(isinstance(x, int) or (isinstance(x, float) and x.is_integer()) for x in values):\n        if second.is_integer():\n            return int(second)\n\n    return second"}
{"task_id": "Mbpp/760", "solution": "def unique_Element(values: list[float | int]) -> bool:\n    \"\"\"Checks if a list of numbers contains only one distinct element.\"\"\"\n    seen_elements = set()\n    for value in values:\n        seen_elements.add(value)\n        if len(seen_elements) > 1:\n            return False\n    return len(seen_elements) == 1"}
{"task_id": "Mbpp/763", "solution": "def find_min_diff(arr, n):\n    \"\"\"\n    Finds the minimum absolute difference between any two elements in the given array.\n    The algorithm sorts the array and then finds the minimum difference between adjacent elements.\n    \"\"\"\n    # Sort the array to bring elements with minimum difference close to each other\n    sorted_arr = sorted(arr)\n\n    # Initialize min_diff with a very large value\n    min_diff = float('inf')\n\n    # Iterate through the sorted array to find the minimum difference between adjacent elements\n    for i in range(len(sorted_arr) - 1):\n        min_diff = min(min_diff, sorted_arr[i+1] - sorted_arr[i])\n\n    return min_diff"}
{"task_id": "Mbpp/758", "solution": "def unique_sublists(list_of_lists):\n    \"\"\"\n    Counts occurrences of unique sublists within a list of lists.\n    Each sublist is converted to a tuple; elements must be hashable.\n    \"\"\"\n    # Validate top-level input as an iterable but not a string/bytes\n    if not hasattr(list_of_lists, \"__iter__\") or isinstance(list_of_lists, (str, bytes)):\n        raise TypeError(\"Top-level value must be an iterable of sublists\")\n\n    tuple_list = []\n    for idx, sub_item in enumerate(list_of_lists):\n        # Each sub_item must be iterable (but not string/bytes)\n        if not hasattr(sub_item, \"__iter__\") or isinstance(sub_item, (str, bytes)):\n            raise TypeError(f\"Error at sublist index {idx}: Sublist is not an iterable\")\n\n        try:\n            current_sub_tuple = tuple(sub_item)\n        except TypeError as e:\n            raise TypeError(f\"Error at sublist index {idx}: Sublist is not iterable. Original error: {e}\") from e\n\n        # Ensure each element in the sub-tuple is hashable\n        for el_idx, el in enumerate(current_sub_tuple):\n            try:\n                hash(el)\n            except TypeError as e:\n                raise ValueError(f\"Error at sublist index {idx}, element index {el_idx}: Unhashable element {el}.\") from e\n\n        tuple_list.append(current_sub_tuple)\n\n    # Count occurrences\n    counts = {}\n    for tpl in tuple_list:\n        counts[tpl] = counts.get(tpl, 0) + 1\n\n    return counts"}
