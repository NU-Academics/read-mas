{"task_id": "Mbpp/563", "solution": "import re\nfrom typing import List, Pattern, Any\nclass ExtractRequest:\n    \"\"\"Data transfer object for extraction requests.\"\"\"\n    def __init__(self, input: str, allow_single_quotes: bool = False) -> None:\n        self.input = input\n        self.allow_single_quotes = allow_single_quotes\nclass ExtractionResult:\n    \"\"\"Data transfer object for extraction results.\"\"\"\n    def __init__(self, values: List[str]) -> None:\n        self.values = values\nclass StringUtils:\n    \"\"\"Utility methods for string operations.\"\"\"\n    @staticmethod\n    def validate_input(s: Any) -> None:\n        if not isinstance(s, str):\n            raise TypeError(\"input must be a string\")\n\n    @staticmethod\n    def unescape(s: str) -> str:\n        # Resolves common backslash escapes within a string.\n        return s.replace(r'\\\\\\\"', '\\\"').replace(r\"\\\\'\", \"'\").replace(r\"\\\\\\\\\", \"\\\\\")\nclass RegexParser:\n    \"\"\"Parses quoted substrings using regular expressions.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def _build_pattern(self, allow_single_quotes: bool) -> Pattern:\n        # Builds and compiles the regex pattern based on quote type allowance.\n        dq_pattern = r'\\\"((?:\\\\\\\\.|[^\\\"\\\\\\\\])*)\\\"'\n        if allow_single_quotes:\n            sq_pattern = r\"'((?:\\\\\\\\.|[^'\\\\\\\\])*)'\"\n            pattern = rf'{dq_pattern}|{sq_pattern}'\n        else:\n            pattern = dq_pattern\n        return re.compile(pattern)\n\n    def parse(self, input: str, allow_single_quotes: bool = False) -> List[str]:\n        # Extracts raw quoted content, potentially with escape sequences.\n        StringUtils.validate_input(input)\n        pat = self._build_pattern(allow_single_quotes)\n        matches = []\n        for m in pat.finditer(input):\n            # group(1) captures content for double quotes, group(2) for single when enabled.\n            g1 = m.group(1)\n            g2 = None\n            try:\n                g2 = m.group(2)\n            except IndexError:\n                g2 = None\n            matches.append(g1 if g1 is not None else g2)\n        return matches\nclass QuoteExtractorService:\n    \"\"\"Business logic for extracting and processing quoted values.\"\"\"\n    def __init__(self, parser: RegexParser) -> None:\n        self._parser = parser\n\n    def extract_values(self, input: str, allow_single_quotes: bool = False) -> List[str]:\n        # Orchestrates parsing and post-processing of extracted values.\n        raw_values = self._parser.parse(input, allow_single_quotes)\n        processed_values = self._post_process(raw_values)\n        return processed_values\n\n    def _post_process(self, raw_values: List[str]) -> List[str]:\n        # Unescapes and strips whitespace from raw extracted values.\n        processed = [StringUtils.unescape(value).strip() for value in raw_values]\n        return processed\nclass ExtractorController:\n    \"\"\"Handles requests, delegates to service, and formats results.\"\"\"\n    def __init__(self, service: QuoteExtractorService) -> None:\n        self._service = service\n\n    def extract(self, request: ExtractRequest) -> ExtractionResult:\n        # Processes an extraction request and returns an ExtractionResult.\n        values = self._service.extract_values(request.input, request.allow_single_quotes)\n        return ExtractionResult(values)\n_parser = RegexParser()\n_service = QuoteExtractorService(_parser)\n_controller = ExtractorController(_service)\ndef extract_values(s: str) -> List[str]:\n    \"\"\"\n    Extracts values between quotation marks from a string.\n    Supports double quotes by default.\n    \"\"\"\n    req = ExtractRequest(input=s, allow_single_quotes=False)\n    return _controller.extract(req).values"}
{"task_id": "Mbpp/564", "solution": "from collections import Counter\nfrom typing import List\ndef count_Pairs(nums: List[int], n: int) -> int:\n    \"\"\"\n    Counts the number of unordered pairs of unequal elements in a list of integers.\n    The parameter `n` is expected to be `len(nums)` and is not directly used in the calculation.\n    \"\"\"\n    counts = Counter(nums)\n    total_elements = len(nums)\n\n    # Calculate total possible pairs (nC2) from all elements, regardless of value\n    total_pairs = total_elements * (total_elements - 1) // 2\n\n    # Calculate pairs where both elements are equal\n    equal_pairs = sum(c * (c - 1) // 2 for c in counts.values())\n\n    # Subtract equal pairs from total pairs to get unequal pairs\n    return total_pairs - equal_pairs"}
