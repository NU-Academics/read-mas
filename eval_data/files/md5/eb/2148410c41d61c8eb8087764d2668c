{"task_id": "Mbpp/92", "solution": "def is_undulating(number: int | str) -> bool:\n    \"\"\"Checks if a given number is undulating (alternating two distinct digits).\"\"\"\n\n    class InvalidInputError(ValueError):\n        \"\"\"Custom exception for invalid input formats.\"\"\"\n        def __init__(self, message: str):\n            super().__init__(message)\n            self.message = message\n\n    class InputValidator:\n        \"\"\"Validates and normalizes raw input into a digit string.\"\"\"\n        ALLOWED_CHARS = set(\"0123456789+-\")\n\n        def validate_and_normalize(self, raw: int | str) -> str:\n            if isinstance(raw, int):\n                s = str(raw)\n            elif isinstance(raw, str):\n                s = raw\n            else:\n                raise InvalidInputError(\"Input must be int or str\")\n\n            if not s:\n                raise InvalidInputError(\"Empty input\")\n\n            # Strip leading sign if present\n            if s[0] in \"+-\":\n                s = s[1:]\n\n            # After stripping sign, remaining string must be digits and not empty\n            if not s or not s.isdigit():\n                raise InvalidInputError(f\"Invalid numeric input: {raw!r}\")\n            return s\n\n    class UndulatingService:\n        \"\"\"Contains the core logic to determine if a digit string is undulating.\"\"\"\n        def is_undulating(self, digits: str) -> bool:\n            n = len(digits)\n            if n < 2:\n                return False\n\n            d0, d1 = digits[0], digits[1]\n            if d0 == d1:\n                return False\n\n            for i, ch in enumerate(digits):\n                expected = d0 if i % 2 == 0 else d1\n                if ch != expected:\n                    return False\n            return True\n\n    class APIController:\n        \"\"\"Orchestrates input validation and the undulating check for the library API.\"\"\"\n        def __init__(self):\n            self._service = UndulatingService()\n            self._validator = InputValidator()\n\n        def is_undulating(self, raw: int | str) -> bool:\n            digits = self._validator.validate_and_normalize(raw)\n            return self._service.is_undulating(digits)\n\n    return APIController().is_undulating(number)"}
{"task_id": "Mbpp/91", "solution": "import re\nfrom typing import List\ndef find_substring(values: List[str], query: str, case_sensitive: bool = True, use_regex: bool = False) -> bool:\n    \"\"\"\n    Checks if a query string is present as a substring in any of the given list of string values.\n    Supports case-sensitive/insensitive and regex matching.\n    \"\"\"\n    for value in values:\n        if use_regex:\n            flags = 0 if case_sensitive else re.IGNORECASE\n            if re.search(query, value, flags) is not None:\n                return True\n        else:\n            if not case_sensitive:\n                if query.casefold() in value.casefold():\n                    return True\n            else:\n                if query in value:\n                    return True\n    return False"}
{"task_id": "Mbpp/93", "solution": "def power(a, b):\n    \"\"\"\n    Calculates 'a' raised to the power 'b'.\n    Handles integer and float exponents, including negative and zero cases.\n    \"\"\"\n    import math\n\n    class PowerError(Exception):\n        def __init__(self, message: str):\n            super().__init__(message)\n            self.message = message\n        def __str__(self):\n            return self.message\n\n    class InputValidator:\n        def parse_numeric(self, value):\n            if isinstance(value, (int, float)):\n                return value\n            try:\n                if '.' in str(value) or 'e' in str(value).lower():\n                    return float(value)\n                return int(value)\n            except ValueError:\n                raise PowerError(f\"Unable to parse numeric value: {value!r}\")\n\n        def ensure_valid_operands(self, a_val, b_val):\n            if isinstance(a_val, str):\n                a_val = self.parse_numeric(a_val)\n            if isinstance(b_val, str):\n                b_val = self.parse_numeric(b_val)\n            if not isinstance(a_val, (int, float)) or not isinstance(b_val, (int, float)):\n                raise PowerError(\"Operands must be numeric\")\n            if isinstance(b_val, float) and b_val.is_integer():\n                b_val = int(b_val)\n            return a_val, b_val\n\n    class FastPower:\n        def pow_int(self, base: int, exp: int) -> int:\n            result = 1\n            b = base\n            e = exp\n            while e > 0:\n                if e & 1:\n                    result *= b\n                b *= b\n                e >>= 1\n            return result\n\n    class FloatPower:\n        def pow_float(self, base: float, exp: float) -> float:\n            return math.pow(base, exp)\n\n    class PowerCalculator:\n        def __init__(self, validator: 'InputValidator'=None, int_algo: 'FastPower'=None, float_algo: 'FloatPower'=None) -> None:\n            self.validator = validator or InputValidator()\n            self.int_algo = int_algo or FastPower()\n            self.float_algo = float_algo or FloatPower()\n\n        def power(self, base_val, exp_val):\n            base_val, exp_val = self.validator.ensure_valid_operands(base_val, exp_val)\n\n            if base_val == 0 and exp_val == 0:\n                raise PowerError(\"0 raised to the power of 0 is undefined\")\n\n            if isinstance(exp_val, int):\n                if exp_val < 0:\n                    if base_val == 0:\n                        raise PowerError(\"0 raised to negative exponent is undefined\")\n                    pos_exp_result = self.int_algo.pow_int(int(base_val), -exp_val)\n                    return 1 / pos_exp_result\n                else:\n                    return self.int_algo.pow_int(int(base_val), exp_val)\n            else:\n                return self.float_algo.pow_float(float(base_val), float(exp_val))\n\n    _default_validator = InputValidator()\n    _default_calc = PowerCalculator(validator=_default_validator)\n    return _default_calc.power(a, b)"}
