{"task_id": "Mbpp/256", "solution": "def count_Primes_nums(n: int) -> int:\n    \"\"\"\n    Counts the number of prime numbers strictly less than the given non-negative number n\n    using the Sieve of Eratosthenes algorithm.\n    \"\"\"\n    if n <= 2:\n        return 0\n\n    # Initialize a bytearray where sieve[i] is 1 if i is potentially prime, 0 otherwise.\n    sieve = bytearray(b\"\\x01\") * n\n    # 0 and 1 are not prime numbers, so mark them as 0.\n    sieve[0:2] = b\"\\x00\\x00\"\n\n    p = 2\n    # Iterate up to sqrt(n) because any composite number n must have a prime factor\n    # less than or equal to sqrt(n).\n    while p * p < n:\n        # If sieve[p] is 1, then p is a prime number.\n        if sieve[p]:\n            # Mark all multiples of p (starting from p*p) as not prime (0).\n            # Multiples less than p*p would have already been marked by smaller primes.\n            start_multiple = p * p\n            sieve[start_multiple:n:p] = b\"\\x00\" * ((n - 1 - start_multiple) // p + 1)\n        p += 1\n\n    # The sum of the bytearray (where 1 represents a prime and 0 represents non-prime)\n    # gives the total count of primes less than n.\n    return sum(sieve)"}
{"task_id": "Mbpp/255", "solution": "def combinations_colors(items, n):\n    \"\"\"\n    Generate all combinations with repetition of length n from the given iterable `items`.\n    Returns a list of tuples, each tuple representing one combination.\n\n    Example:\n        combinations_colors([\"Red\", \"Green\", \"Blue\"], 1)\n        -> [('Red',), ('Green',), ('Blue',)]\n    \"\"\"\n    from itertools import combinations_with_replacement\n\n    # Validate n\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n\n    # Convert items to a list (will raise TypeError if not iterable)\n    items_list = list(items)\n\n    # For n == 0, by convention return a list with a single empty tuple\n    if n == 0:\n        return [()]\n\n    # If items is empty and n > 0, there are no combinations\n    if len(items_list) == 0:\n        return []\n\n    return [tuple(comb) for comb in combinations_with_replacement(items_list, n)]"}
{"task_id": "Mbpp/259", "solution": "from typing import Sequence, Tuple, Union\ndef maximize_elements(a: Sequence[Tuple[Union[int, float], ...]], b: Sequence[Tuple[Union[int, float], ...]]) -> Tuple[Tuple[Union[int, float], ...], ...]:\n    \"\"\"\n    Computes the element-wise maximums of two sequences of tuples.\n\n    Returns a tuple of tuples where each inner tuple contains the element-wise maxima\n    of the corresponding inner tuples from `a` and `b`.\n\n    Note: This function assumes inputs are sequences of tuples and that corresponding\n    inner tuples have the same length. It will iterate up to the shortest outer length.\n    \"\"\"\n    return tuple(\n        tuple(max(elem_a, elem_b) for elem_a, elem_b in zip(inner_tuple_a, inner_tuple_b))\n        for inner_tuple_a, inner_tuple_b in zip(a, b)\n    )"}
{"task_id": "Mbpp/261", "solution": "def division_elements(lhs, rhs):\n    \"\"\"\n    Performs element-wise division on two tuples of numbers.\n    Converts results to integers if they are exact whole numbers.\n    \"\"\"\n    if not isinstance(lhs, tuple) or not isinstance(rhs, tuple):\n        raise TypeError(\"Both inputs must be tuples\")\n    if len(lhs) != len(rhs):\n        raise ValueError(\"Tuples must be of the same length\")\n    results = []\n    for a, b in zip(lhs, rhs):\n        if not isinstance(a, (int, float)) or not isinstance(b, (int, float)):\n            raise TypeError(\"All elements must be int or float\")\n        if b == 0:\n            raise ZeroDivisionError(\"Division by zero encountered\")\n        result = a / b\n        if float(result).is_integer():\n            results.append(int(result))\n        else:\n            results.append(result)\n    return tuple(results)"}
{"task_id": "Mbpp/262", "solution": "def split_two_parts(list_to_split: list, L: int) -> tuple[list, list]:\n    \"\"\"\n    Splits a list into two parts: the first of length L, and the remainder.\n    Returns the two resulting lists as a tuple.\n    \"\"\"\n    return list_to_split[:L], list_to_split[L:]"}
{"task_id": "Mbpp/267", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"\n    Computes the sum of the squares of the first n odd natural numbers.\n\n    Example:\n        square_Sum(2) == 1^2 + 3^2 == 1 + 9 == 10\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(f\"n must be an integer, got {type(n).__name__}\")\n    if n < 0:\n        raise ValueError(f\"n must be >= 0, got {n}\")\n\n    # Use closed-form formula for efficiency:\n    # sum_{k=1..n} (2k-1)^2 = 4 * sum k^2 - 4 * sum k + n\n    # sum k = n(n+1)/2\n    # sum k^2 = n(n+1)(2n+1)/6\n    s_k2 = n * (n + 1) * (2 * n + 1) // 6\n    s_k = n * (n + 1) // 2\n    return 4 * s_k2 - 4 * s_k + n"}
