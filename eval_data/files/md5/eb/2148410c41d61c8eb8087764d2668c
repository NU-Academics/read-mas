{"task_id": "Mbpp/608", "solution": "def bell_Number(n: int) -> int:\n    \"\"\"\n    Compute the n-th Bell number (number of partitions of a set with n elements).\n    Bell(0) == 1.\n\n    Args:\n        n: non-negative integer\n\n    Returns:\n        The n-th Bell number as an int.\n\n    Raises:\n        TypeError: if n is not an int.\n        ValueError: if n is negative.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    if n == 0:\n        return 1\n\n    # Use Bell triangle (Aitken's array) - O(n^2) time, O(n^2) memory worst-case\n    prev = [1]  # row 0\n    for i in range(1, n + 1):\n        row = [prev[-1]]\n        # build row elements: row[j] = row[j-1] + prev[j-1]\n        for j in range(1, i + 1):\n            row.append(row[j - 1] + (prev[j - 1] if j - 1 < len(prev) else 0))\n        prev = row\n    return prev[0]"}
{"task_id": "Mbpp/611", "solution": "def max_of_nth(matrix, n):\n    if not isinstance(matrix, list) or len(matrix) == 0:\n        raise ValueError(\"matrix must be a non-empty list of rows\")\n\n    first_len = None\n    for i, row in enumerate(matrix):\n        if not isinstance(row, list):\n            raise ValueError(f\"Row {i} is not a list\")\n        if first_len is None:\n            first_len = len(row)\n            if first_len == 0:\n                raise ValueError(\"rows must be non-empty\")\n        elif len(row) != first_len:\n            raise ValueError(\"all rows must have the same length\")\n\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0 or n >= first_len:\n        raise IndexError(f\"column index {n} out of range\")\n\n    max_val = None\n    for row in matrix:\n        try:\n            val = float(row[n])\n        except Exception:\n            raise ValueError(f\"Non-numeric value in column {n}: {row[n]!r}\")\n        if max_val is None or val > max_val:\n            max_val = val\n\n    return max_val"}
{"task_id": "Mbpp/612", "solution": "def merge(pairs):\n    \"\"\"\n    Transforms a list of 2-element sublists into a list of two lists,\n    where the first contains all first elements and the second all second elements.\n    \"\"\"\n    if not pairs:\n        return [[], []]\n\n    first_elements, second_elements = zip(*pairs)\n    return [list(first_elements), list(second_elements)]"}
{"task_id": "Mbpp/614", "solution": "def cummulative_sum(seq):\n    \"\"\"Calculates the cumulative sum of all numeric values in a list of tuples.\"\"\"\n    from typing import Any, Callable, Iterable, Iterator\n\n    # Exceptions\n    class CumulativeSumError(Exception):\n        pass\n\n    class InputValidationError(CumulativeSumError):\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    class ElementTypeError(CumulativeSumError):\n        def __init__(self, index: tuple, element: Any, message: str = None) -> None:\n            if message is None:\n                message = f\"Non-numeric element '{element}' at index {index}\"\n            super().__init__(message)\n            self.index = index\n            self.element = element\n            self.message = message\n\n    # Validator\n    class InputValidator:\n        def validate_sequence(self, s: Any) -> Iterable[tuple]:\n            if s is None:\n                raise InputValidationError(\"Input must not be None\")\n            try:\n                iter(s)\n            except TypeError:\n                raise InputValidationError(\"Top-level input must be an iterable of tuples\")\n            for i, item in enumerate(s):\n                if not isinstance(item, tuple):\n                    raise InputValidationError(f\"Element at index {i} is not a tuple\")\n            return s\n\n        def is_numeric(self, value: Any) -> bool:\n            return isinstance(value, (int, float))\n\n    # Adapter\n    class TupleIteratorAdapter:\n        def __init__(self, tuple_seq: Iterable[tuple]):\n            self._tuple_seq = tuple_seq\n            self._validator = InputValidator()\n\n        def flatten(self) -> Iterator[float]:\n            for t_idx, tpl in enumerate(self._tuple_seq):\n                for e_idx, element in enumerate(tpl):\n                    if not self._validator.is_numeric(element):\n                        raise ElementTypeError(index=(t_idx, e_idx), element=element, message=\"Non-numeric element\")\n                    yield float(element)\n\n    # Service\n    class CumulativeSumService:\n        def __init__(self, validator: InputValidator, adapter_factory: Callable[[Iterable[tuple]], TupleIteratorAdapter]):\n            self._validator = validator\n            self._adapter_factory = adapter_factory\n\n        def sum_all(self, raw_seq: Any) -> float:\n            validated = self._validator.validate_sequence(raw_seq)\n            adapter = self._adapter_factory(validated)\n            total = 0.0\n            for value in adapter.flatten():\n                total += value\n            return total\n\n    # Controller and execution\n    validator = InputValidator()\n    service = CumulativeSumService(validator, lambda s: TupleIteratorAdapter(s))\n    return service.sum_all(seq)"}
{"task_id": "Mbpp/615", "solution": "def average_tuple(data: tuple) -> list:\n    \"\"\"\n    Calculates the average value for each inner tuple in a tuple of tuples.\n    Assumes valid input structure where inner tuples contain numeric values and are not empty.\n    \"\"\"\n    averages = []\n    for inner_tuple in data:\n        # Assuming inner_tuple is non-empty and contains only numbers (int or float).\n        total = sum(inner_tuple)\n        count = len(inner_tuple)\n        average = total / count\n        averages.append(average)\n    return averages"}
{"task_id": "Mbpp/616", "solution": "from typing import Tuple, Any, Optional\nclass TupleModuloError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass LengthMismatchError(TupleModuloError):\n    def __init__(self, len_a: int, len_b: int) -> None:\n        super().__init__(f\"Length mismatch: {len_a} != {len_b}\")\n        self.len_a = len_a\n        self.len_b = len_b\nclass InvalidElementError(TupleModuloError):\n    def __init__(self, index: int, value: Any) -> None:\n        super().__init__(f\"Invalid element at index {index}: {value!r}\")\n        self.index = index\n        self.value = value\nclass DivisionByZeroError(TupleModuloError):\n    def __init__(self, index: int) -> None:\n        super().__init__(f\"Division by zero at index {index}\")\n        self.index = index\nclass TupleValidator:\n    \"\"\"Validates the lengths and element types of input tuples.\"\"\"\n    def validate_lengths(self, a: Tuple[Any, ...], b: Tuple[Any, ...]) -> None:\n        if len(a) != len(b):\n            raise LengthMismatchError(len(a), len(b))\n\n    def validate_elements(self, a: Tuple[Any, ...], b: Tuple[Any, ...]) -> None:\n        for i, (x, y) in enumerate(zip(a, b)):\n            if not isinstance(x, int):\n                raise InvalidElementError(i, x)\n            if not isinstance(y, int):\n                raise InvalidElementError(i, y)\ndef safe_mod(a: int, b: int, index: Optional[int] = None) -> int:\n    \"\"\"Performs modulo, raising DivisionByZeroError if divisor is zero.\"\"\"\n    if b == 0:\n        raise DivisionByZeroError(index if index is not None else -1)\n    return a % b\ndef tuple_modulo(a: tuple, b: tuple) -> tuple:\n    \"\"\"Performs element-wise modulo on two tuples of integers.\"\"\"\n    validator = TupleValidator()\n\n    validator.validate_lengths(a, b)\n    validator.validate_elements(a, b)\n\n    result = []\n    for i in range(len(a)):\n        res = safe_mod(a[i], b[i], index=i)\n        result.append(res)\n    return tuple(result)"}
{"task_id": "Mbpp/618", "solution": "def div_list(a, b):\n    \"\"\"Divides two lists element-wise, returning a list of float results.\"\"\"\n    result = []\n    for i in range(len(a)):\n        result.append(float(a[i]) / float(b[i]))\n    return result"}
{"task_id": "Mbpp/619", "solution": "def move_num(s: str) -> str:\n    \"\"\"\n    Moves all numeric sequences to the end of the string, preserving relative order.\n    Non-digit characters appear first, followed by all digit sequences.\n    \"\"\"\n    non_digit_chars = []\n    digit_sequences = []\n    current_digit_sequence = []\n\n    for char in s:\n        if char.isdigit():\n            current_digit_sequence.append(char)\n        else:\n            # If a digit sequence was being collected, it ends here.\n            if current_digit_sequence:\n                digit_sequences.append(\"\".join(current_digit_sequence))\n                current_digit_sequence = []\n            non_digit_chars.append(char)\n\n    # Append any remaining digit sequence after the loop finishes.\n    if current_digit_sequence:\n        digit_sequences.append(\"\".join(current_digit_sequence))\n\n    return \"\".join(non_digit_chars) + \"\".join(digit_sequences)"}
