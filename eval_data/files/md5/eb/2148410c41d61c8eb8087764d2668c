{"task_id": "Mbpp/602", "solution": "def first_repeated_char(s: str) -> str | None:\n    \"\"\"\n    Finds the first character that appears more than once in the given string.\n    Returns the character as a string, or None if no character repeats.\n    \"\"\"\n    seen = set()\n    for char in s:\n        if char in seen:\n            return char\n        seen.add(char)\n    return None"}
{"task_id": "Mbpp/604", "solution": "import re\nfrom typing import Any, List\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\n    def __str__(self) -> str:\n        return f\"InvalidInputError: {self.message}\"\nclass WordReversalResult:\n    \"\"\"Encapsulates the result of word reversal.\"\"\"\n    def __init__(self, result: str) -> None:\n        self.result = result\n\n    def to_str(self) -> str:\n        return self.result\nclass StringValidator:\n    \"\"\"Validates string inputs.\"\"\"\n    def validate(self, s: Any) -> None:\n        self.validate_not_none(s)\n        self.validate_is_string(s)\n\n    def validate_not_none(self, s: Any) -> None:\n        if s is None:\n            raise InvalidInputError(\"Input may not be None\")\n\n    def validate_is_string(self, s: Any) -> None:\n        if not isinstance(s, str):\n            raise InvalidInputError(f\"Input must be a string, got {type(s).__name__}\")\nclass WhitespaceNormalizer:\n    \"\"\"Normalizes whitespace and splits words.\"\"\"\n    _WS_RE = re.compile(r'\\s+')\n\n    def normalize_whitespace(self, s: str) -> str:\n        # Replace all runs of whitespace with a single space and trim\n        return self._WS_RE.sub(' ', s).strip()\n\n    def split_words(self, s: str) -> List[str]:\n        if s == \"\":\n            return []\n        return s.split(' ')\nclass ReverseWordsService:\n    \"\"\"Core service for reversing words in a string.\"\"\"\n    def __init__(self, validator: StringValidator, normalizer: WhitespaceNormalizer) -> None:\n        self._validator = validator\n        self._normalizer = normalizer\n\n    def reverse(self, s: str) -> WordReversalResult:\n        self._validator.validate(s)\n        normalized = self._normalizer.normalize_whitespace(s)\n        words = self._normalizer.split_words(normalized)\n        reversed_words = self._reverse_words_list(words)\n        result = \" \".join(reversed_words)\n        return WordReversalResult(result=result)\n\n    def reverse_to_str(self, s: str) -> str:\n        return self.reverse(s).to_str()\n\n    def _reverse_words_list(self, words: List[str]) -> List[str]:\n        return list(reversed(words))\n_validator = StringValidator()\n_normalizer = WhitespaceNormalizer()\n_service = ReverseWordsService(_validator, _normalizer)\ndef reverse_words(s: str) -> str:\n    \"\"\"Convenience wrapper returning the reversed words string.\"\"\"\n    return _service.reverse_to_str(s)"}
{"task_id": "Mbpp/603", "solution": "def get_ludic(limit: int) -> list[int]:\n    \"\"\"\n    Computes all ludic numbers less than or equal to a given integer using a sieve algorithm.\n    This implementation assumes `limit` is an integer greater than or equal to 1.\n    \"\"\"\n    if not isinstance(limit, int):\n        raise ValueError(\"limit must be an integer\")\n    if limit < 1:\n        raise ValueError(\"limit must be >= 1\")\n\n    # Initialize a list of candidate numbers from 1 up to the limit.\n    candidates = list(range(1, limit + 1))\n    ludic_numbers = []\n\n    # 'k' is the index pointing to the current ludic number in the 'candidates' list\n    # that will be used for sieving subsequent numbers.\n    k = 0\n\n    while k < len(candidates):\n        p = candidates[k]\n\n        # Add the current number 'p' to the list of ludic numbers found.\n        ludic_numbers.append(p)\n\n        # The number 1 is a special case; include it but it doesn't remove elements\n        # from the remaining list in the usual way (removing every 1st would remove all).\n        if p == 1:\n            k += 1\n            continue\n\n        # For p > 1, remove every p-th element among the elements after the current position.\n        # count_for_p_removal counts positions 1-based among elements after index k.\n        to_delete_indices = []\n        count_for_p_removal = 0\n\n        for i_candidate in range(k + 1, len(candidates)):\n            count_for_p_removal += 1\n            if count_for_p_removal % p == 0:\n                to_delete_indices.append(i_candidate)\n\n        # Rebuild the candidates list excluding marked indices.\n        if to_delete_indices:\n            delete_set = set(to_delete_indices)\n            candidates = [candidates[i] for i in range(len(candidates)) if i not in delete_set]\n\n        # Move to next index in the (possibly) shortened candidates list.\n        k += 1\n\n    # Filter to ensure all returned ludic numbers are <= limit (they should be).\n    return [num for num in ludic_numbers if num <= limit]"}
{"task_id": "Mbpp/605", "solution": "def prime_num(n: int) -> bool:\n    \"\"\"\n    Checks if an integer is a prime number.\n    It returns True for prime numbers and False otherwise.\n    \"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n\n    # Check for odd divisors from 3 up to the integer square root of n.\n    # This optimization reduces the number of division checks significantly.\n    root = int(n**0.5)\n    for d in range(3, root + 1, 2):\n        if n % d == 0:\n            return False\n    return True"}
