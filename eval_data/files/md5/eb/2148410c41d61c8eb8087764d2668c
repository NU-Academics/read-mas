{"task_id": "Mbpp/620", "solution": "def largest_subset(numbers: list) -> int:\n    \"\"\"\n    Return the size of the largest subset of integers where every pair is divisible.\n    For any two elements a, b in the subset, either a divides b or b divides a.\n    \"\"\"\n    # Validate input and collect unique integers (design decision: deduplicate).\n    try:\n        iterator = iter(numbers)\n    except TypeError:\n        raise TypeError(\"numbers must be an iterable of integers\")\n\n    unique_nums = set()\n    for x in numbers:\n        if not isinstance(x, int):\n            raise TypeError(\"all elements must be integers\")\n        unique_nums.add(x)\n\n    # Deterministic ordering: sort by absolute value then by value\n    nums = sorted(unique_nums, key=lambda v: (abs(v), v))\n    n = len(nums)\n    if n == 0:\n        return 0\n\n    def divides(a: int, b: int) -> bool:\n        # a divides b: if a == 0 then only true when b == 0; otherwise b % a == 0\n        if a == 0:\n            return b == 0\n        return b % a == 0\n\n    dp = [1] * n  # dp[i] = length of longest divisible chain ending at nums[i]\n    best = 1\n\n    for i in range(n):\n        for j in range(i):\n            if divides(nums[j], nums[i]) and dp[j] + 1 > dp[i]:\n                dp[i] = dp[j] + 1\n        if dp[i] > best:\n            best = dp[i]\n\n    return best"}
{"task_id": "Mbpp/624", "solution": "def is_upper(s):\n    \"\"\"Converts a given input to its uppercase string representation.\n\n    Behavior:\n    - If s is a str, returns s.upper().\n    - If s is an int, float, or bool, coerces to str and returns the uppercased string.\n    - If s is None or an unsupported type, raises InvalidInputError.\n    \"\"\"\n    class InvalidInputError(Exception):\n        \"\"\"Raised when the input is invalid or cannot be coerced to a string.\"\"\"\n        def __init__(self, message: str):\n            super().__init__(message)\n            self.message = message\n\n    if s is None:\n        raise InvalidInputError(\"input must not be None\")\n    if isinstance(s, str):\n        coerced_input = s\n    elif isinstance(s, (int, float, bool)):\n        coerced_input = str(s)\n    else:\n        raise InvalidInputError(f\"unsupported input type: {type(s).__name__}\")\n\n    return coerced_input.upper()"}
{"task_id": "Mbpp/622", "solution": "def get_median(a: list[int], b: list[int], n: int) -> float:\n    \"\"\"\n    Finds the median of two sorted lists of the same size using a recursive divide-and-conquer approach.\n    Assumes lists are sorted and of equal length n, with n >= 1.\n    \"\"\"\n\n    def _get_median_recursive(arr1, arr2, start_a, end_a, start_b, end_b):\n        # Current length of segments\n        current_len = end_a - start_a + 1\n\n        # Base case: If segments contain only one element each.\n        if current_len == 1:\n            return (float(arr1[start_a]) + float(arr2[start_b])) / 2.0\n\n        # Base case: If segments contain two elements each.\n        # The median is the average of the maximum of the first elements\n        # and the minimum of the last elements of the combined four elements.\n        if current_len == 2:\n            return (max(float(arr1[start_a]), float(arr2[start_b])) +\n                    min(float(arr1[end_a]), float(arr2[end_b]))) / 2.0\n\n        # Calculate midpoints of the current segments.\n        mid_a_idx = start_a + (current_len - 1) // 2\n        mid_b_idx = start_b + (current_len - 1) // 2\n\n        val_a_mid = arr1[mid_a_idx]\n        val_b_mid = arr2[mid_b_idx]\n\n        # If mid-elements are equal, that's the median.\n        if val_a_mid == val_b_mid:\n            return float(val_a_mid)\n\n        # If median of arr1 segment is less than median of arr2 segment,\n        # the median must lie in arr1's upper half and arr2's lower half.\n        if val_a_mid < val_b_mid:\n            return _get_median_recursive(arr1, arr2, mid_a_idx, end_a, start_b, mid_b_idx)\n        # If median of arr1 segment is greater than median of arr2 segment,\n        # the median must lie in arr1's lower half and arr2's upper half.\n        else: # val_a_mid > val_b_mid\n            return _get_median_recursive(arr1, arr2, start_a, mid_a_idx, mid_b_idx, end_b)\n\n    # Initial call to the recursive helper function with full array ranges.\n    return _get_median_recursive(a, b, 0, n - 1, 0, n - 1)"}
{"task_id": "Mbpp/626", "solution": "def triangle_area(radius):\n    \"\"\"\n    Calculates the area of the largest triangle inscribed in a semicircle.\n    Returns None for negative radii, otherwise returns radius squared.\n    \"\"\"\n    if radius < 0:\n        return None\n    return float(radius * radius)"}
{"task_id": "Mbpp/630", "solution": "def get_coordinates(coord: tuple[int, int]) -> list[list[int]]:\n    \"\"\"\n    Extracts all adjacent coordinates of a given 2D coordinate, including itself.\n    The coordinates are returned in row-major order.\n    \"\"\"\n    center_row, center_col = coord\n    adjacent_coords = []\n    for r in range(center_row - 1, center_row + 2):\n        for c in range(center_col - 1, center_col + 2):\n            adjacent_coords.append([r, c])\n    return adjacent_coords"}
{"task_id": "Mbpp/631", "solution": "import re\ndef replace_spaces(text: str) -> str:\n    \"\"\"Replaces one or more contiguous whitespace characters with a single underscore.\"\"\"\n    # Normalize whitespace: replace any sequence of unicode whitespace characters with a single ASCII space, then strip leading/trailing spaces.\n    normalized = re.sub(r'\\s+', ' ', text).strip()\n    # Replace the single ASCII spaces with underscores.\n    return normalized.replace(' ', '_')"}
{"task_id": "Mbpp/629", "solution": "import collections.abc\nimport numbers\nfrom decimal import Decimal\nfrom typing import Any, Iterable, List, Optional, Tuple\nclass InvalidInputError(TypeError):\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass TypeHelpers:\n    def is_integer_value(self, value: Any) -> Tuple[bool, Optional[int]]:\n        if isinstance(value, numbers.Integral):\n            return True, int(value)\n        if isinstance(value, float):\n            if value.is_integer():\n                return True, int(value)\n            return False, None\n        if isinstance(value, Decimal):\n            if value == value.to_integral_value():\n                return True, int(value)\n            return False, None\n        return False, None\nclass InputValidator:\n    def validate_iterable(self, obj: Any) -> None:\n        if not isinstance(obj, collections.abc.Iterable):\n            raise InvalidInputError(\"Expected an iterable of numbers\")\nclass SplitService:\n    def __init__(self, type_helper: Optional[TypeHelpers] = None) -> None:\n        self.type_helper = type_helper or TypeHelpers()\n\n    def filter_even(self, items: Iterable[Any]) -> List[int]:\n        result: List[int] = []\n        for item in items:\n            is_int, int_val = self.type_helper.is_integer_value(item)\n            if is_int and (int_val % 2 == 0):\n                result.append(int_val)\n        return result\ndef Split(items: Iterable[Any]) -> List[int]:\n    \"\"\"\n    Returns a list of even integers from the input iterable, preserving order.\n    Non-iterable inputs raise InvalidInputError (TypeError).\n    \"\"\"\n    validator = InputValidator()\n    validator.validate_iterable(items)\n    service = SplitService(type_helper=TypeHelpers())\n    return service.filter_even(items)"}
{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(arr, n):\n    \"\"\"\n    Computes the sum of XOR of all unique pairs of numbers in the first 'n' elements of the list.\n    Optimized approach using bit counting: O(n * B) time where B is the bit width (at least 32).\n    Assumes arr contains non-negative integers and n <= len(arr).\n    \"\"\"\n    if n < 2:\n        return 0\n\n    working_arr = arr[:n]\n\n    max_val = max(working_arr) if working_arr else 0\n\n    DEFAULT_BIT_WIDTH = 32\n    B = max(1, max_val.bit_length())\n    B = max(B, DEFAULT_BIT_WIDTH)\n\n    bit_counts = [0] * B\n    for x in working_arr:\n        for b in range(B):\n            if (x >> b) & 1:\n                bit_counts[b] += 1\n\n    total_xor_sum = 0\n    for b in range(B):\n        ones = bit_counts[b]\n        zeros = n - ones\n        total_xor_sum += ones * zeros * (1 << b)\n\n    return total_xor_sum"}
{"task_id": "Mbpp/632", "solution": "def move_zero(nums):\n    \"\"\"\n    Move all zeros in the given list to the end while preserving the order\n    of non-zero elements. Returns a new list.\n    \"\"\"\n    non_zeros = [x for x in nums if x != 0]\n    zero_count = len(nums) - len(non_zeros)\n    return non_zeros + [0] * zero_count"}
{"task_id": "Mbpp/635", "solution": "from typing import List, Any\nclass HeapUtils:\n    \"\"\"Provides utility methods for heap operations, such as index calculations and element swapping.\"\"\"\n    def left(self, i: int) -> int:\n        \"\"\"Calculates the left child index.\"\"\"\n        return 2 * i + 1\n\n    def right(self, i: int) -> int:\n        \"\"\"Calculates the right child index.\"\"\"\n        return 2 * i + 2\n\n    def parent(self, i: int) -> int:\n        \"\"\"Calculates the parent index.\"\"\"\n        return (i - 1) // 2\n\n    def swap(self, arr: List[Any], i: int, j: int) -> None:\n        \"\"\"Swaps elements at two given indices in the list.\"\"\"\n        arr[i], arr[j] = arr[j], arr[i]\nclass HeapSorter:\n    \"\"\"Implements the heap sort algorithm using a max-heap.\"\"\"\n    def __init__(self, utils: HeapUtils = None):\n        \"\"\"Initializes the HeapSorter with an optional HeapUtils instance.\"\"\"\n        self.utils = utils or HeapUtils()\n\n    def heapify(self, arr: List[Any], n: int, i: int) -> None:\n        \"\"\"Ensures the subtree rooted at index i is a max-heap.\"\"\"\n        largest = i\n        l = self.utils.left(i)\n        r = self.utils.right(i)\n\n        if l < n and arr[l] > arr[largest]:\n            largest = l\n\n        if r < n and arr[r] > arr[largest]:\n            largest = r\n\n        if largest != i:\n            self.utils.swap(arr, i, largest)\n            self.heapify(arr, n, largest)\n\n    def build_max_heap(self, arr: List[Any]) -> None:\n        \"\"\"Builds a max-heap from the given list in-place.\"\"\"\n        n = len(arr)\n        for i in range(n // 2 - 1, -1, -1):\n            self.heapify(arr, n, i)\n\n    def sort(self, arr: List[Any]) -> List[Any]:\n        \"\"\"Sorts a copy of the given list using heap sort and returns the new sorted list.\"\"\"\n        copy = list(arr)\n        self.sort_inplace(copy)\n        return copy\n\n    def sort_inplace(self, arr: List[Any]) -> None:\n        \"\"\"Sorts the given list in-place using the heap sort algorithm.\"\"\"\n        n = len(arr)\n        if n <= 1:\n            return\n\n        self.build_max_heap(arr)\n\n        for i in range(n - 1, 0, -1):\n            self.utils.swap(arr, 0, i)\n            self.heapify(arr, i, 0)\ndef heap_sort(input_list: List[int]) -> List[int]:\n    \"\"\"Sorts the given list of integers using the heap sort algorithm.\"\"\"\n    sorter = HeapSorter()\n    return sorter.sort(input_list)"}
