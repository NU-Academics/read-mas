{"task_id": "Mbpp/2", "solution": "def similar_elements(seq1: Iterable[Any], seq2: Iterable[Any]) -> Tuple[Any, ...]:\n    \"\"\"\n    Finds common elements between two iterables and returns them as a tuple.\n    Duplicates are removed, and the order of elements in the output is not guaranteed.\n    \"\"\"\n    set1 = set(seq1)\n    set2 = set(seq2)\n    intersection_set = set1.intersection(set2)\n    return tuple(intersection_set)"}
{"task_id": "Mbpp/7", "solution": "import re\ndef find_char_long(text: str, min_length: int = 4) -> set[str]:\n    \"\"\"\n    Finds all words in a string that are at least `min_length` characters long.\n    Words are defined by the regex pattern r\"\\b[\\w']+\\b\".\n    \"\"\"\n    word_pattern = re.compile(r\"\\b[\\w']+\\b\")\n    tokens = word_pattern.findall(text)\n    return {word for word in tokens if len(word) >= min_length}"}
{"task_id": "Mbpp/3", "solution": "def is_not_prime(n: int) -> bool:\n    \"\"\"\n    Identifies if a given integer is a non-prime number.\n    Non-prime numbers include all integers less than 2, and composite numbers.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer\")\n\n    if n <= 1:\n        return True\n    if n == 2:\n        return False\n    if n % 2 == 0:\n        return True\n\n    # Check for odd divisors from 3 up to the square root of n\n    limit = int(n**0.5)\n    d = 3\n    while d <= limit:\n        if n % d == 0:\n            return True\n        d += 2\n    return False"}
{"task_id": "Mbpp/4", "solution": "import heapq\nfrom typing import List, Sequence\ndef heap_queue_largest(numbers: Sequence[int], n: int) -> List[int]:\n    \"\"\"\n    Finds the n largest integers from a list, returned in descending order.\n    Uses a min-heap of size n for efficient computation.\n    \"\"\"\n    if n <= 0:\n        return []\n\n    num_count = len(numbers)\n    if n >= num_count:\n        return sorted(numbers, reverse=True)\n\n    min_heap = []\n    for number in numbers:\n        if len(min_heap) < n:\n            heapq.heappush(min_heap, number)\n        else:\n            if number > min_heap[0]:\n                heapq.heapreplace(min_heap, number)\n\n    return sorted(min_heap, reverse=True)"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(a, b):\n    \"\"\"\n    Checks if two integers differ at exactly one bit position.\n    This is true if their XOR is a power of two and not zero.\n    \"\"\"\n    xor_val = a ^ b\n    return xor_val != 0 and (xor_val & (xor_val - 1)) == 0"}
{"task_id": "Mbpp/8", "solution": "def square_nums(nums):\n    \"\"\"\n    Calculates the square of each element in a list of numbers.\n    Floats that are integer-valued will be converted to integers in the result.\n    \"\"\"\n    squared_list = []\n    for num in nums:\n        square = num * num\n        if isinstance(square, float) and square.is_integer():\n            squared_list.append(int(square))\n        else:\n            squared_list.append(square)\n    return squared_list"}
{"task_id": "Mbpp/16", "solution": "import re\ndef text_lowercase_underscore(text: str) -> bool:\n    \"\"\"\n    Checks if the input string consists of two sequences of lowercase letters\n    joined by a single underscore.\n    \"\"\"\n    pattern = r\"^[a-z]+_[a-z]+$\"\n    return re.fullmatch(pattern, text) is not None"}
{"task_id": "Mbpp/17", "solution": "def square_perimeter(side):\n    \"\"\"\n    Calculates the perimeter of a square given its side length.\n    Returns the perimeter as a float.\n    \"\"\"\n    return 4 * side"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(s: str, ch: str) -> str:\n    \"\"\"Removes the first and last occurrence of a given character from the string.\"\"\"\n    first = s.find(ch)\n    if first == -1:\n        return s\n\n    last = s.rfind(ch)\n\n    if first == last:\n        return s[:first] + s[first+1:]\n    else:\n        return s[:first] + s[first+1:last] + s[last+1:]"}
{"task_id": "Mbpp/12", "solution": "def sort_matrix(matrix):\n    if not isinstance(matrix, list):\n        raise ValueError(\"Matrix must be a list of lists.\")\n    if not matrix:\n        return []\n    if not all(isinstance(row, list) for row in matrix):\n        raise ValueError(\"Matrix must be a list of lists.\")\n    row_len = len(matrix[0])\n    for row in matrix:\n        if len(row) != row_len:\n            raise ValueError(\"All rows must have the same length (rectangular matrix).\")\n        for x in row:\n            if not isinstance(x, (int, float)):\n                raise ValueError(\"Matrix elements must be ints or floats.\")\n    indexed = [(sum(row), idx, row.copy()) for idx, row in enumerate(matrix)]\n    indexed.sort(key=lambda t: (t[0], t[1]))\n    return [row for (_s, _i, row) in indexed]"}
{"task_id": "Mbpp/14", "solution": "def find_Volume(base: float, height: float, length: float) -> float:\n    \"\"\"\n    Calculates the volume of a triangular prism.\n    Volume = (1/2 * base * height) * length\n    \"\"\"\n    triangle_area = 0.5 * base * height\n    volume = triangle_area * length\n    return volume"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(s: str) -> int:\n    \"\"\"\n    Finds the minimum positive number of rotations required to obtain the same string.\n    This uses the KMP prefix function to determine the string's smallest period.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"input must be a string\")\n    if s == \"\":\n        raise ValueError(\"input string must be non-empty\")\n\n    n = len(s)\n    # Compute the KMP prefix function (pi array)\n    pi = [0] * n\n    for i in range(1, n):\n        j = pi[i - 1]\n        while j > 0 and s[i] != s[j]:\n            j = pi[j - 1]\n        if s[i] == s[j]:\n            j += 1\n        pi[i] = j\n\n    period_length = n - pi[-1]\n    if period_length != 0 and n % period_length == 0:\n        return period_length\n    else:\n        return n"}
{"task_id": "Mbpp/18", "solution": "def remove_dirty_chars(src: str, mask: str) -> str:\n    \"\"\"\n    Removes characters from the source string that are present in the mask string.\n    The mask is treated as a set of characters for efficient lookups.\n    \"\"\"\n    chars_to_remove = set(mask)\n    return ''.join(ch for ch in src if ch not in chars_to_remove)"}
{"task_id": "Mbpp/57", "solution": "def find_Max_Num(digits):\n    \"\"\"\n    Finds the largest number that can be formed by arranging the given list of digits.\n    The digits are sorted in descending order and then joined to form the number.\n    \"\"\"\n    digit_strings = [str(d) for d in digits]\n    digit_strings.sort(reverse=True)\n    largest_num_str = \"\".join(digit_strings)\n    return int(largest_num_str)"}
{"task_id": "Mbpp/19", "solution": "from typing import Iterable, Any, List, Set\nfrom abc import ABC, abstractmethod\nimport collections.abc\nclass DuplicateError(Exception):\n    \"\"\"Custom exception for duplicate detection related errors, especially invalid input.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass Validator:\n    \"\"\"Helper class for various input validations.\"\"\"\n    @staticmethod\n    def is_iterable(obj: Any) -> bool:\n        \"\"\"Checks if an object is an iterable (excluding strings).\"\"\"\n        return isinstance(obj, collections.abc.Iterable) and not isinstance(obj, str)\n\n    @staticmethod\n    def ensure_int_iterable(items: Iterable[Any]) -> None:\n        \"\"\"Validates that all elements in an iterable are integers, raising DuplicateError if not.\"\"\"\n        if not Validator.is_iterable(items):\n            raise DuplicateError(\"Input must be an iterable.\")\n        for x in items:\n            if not isinstance(x, int):\n                raise DuplicateError(\"All elements must be integers.\")\nclass ArrayDTO:\n    \"\"\"Data Transfer Object for array input, handles initial list conversion and basic validation.\"\"\"\n    def __init__(self, items: Iterable[Any]) -> None:\n        try:\n            # Convert to a list immediately to handle single-pass iterators\n            # and ensure it can be iterated multiple times (for validation and detection).\n            self.items: List[Any] = list(items)\n        except TypeError:\n            # If `items` is not iterable, list() will raise TypeError.\n            raise DuplicateError(\"Input must be an iterable.\")\n\n    def validated_items(self) -> Iterable[int]:\n        \"\"\"Validates elements are integers and returns the list of items.\"\"\"\n        Validator.ensure_int_iterable(self.items)\n        # We've validated that all elements are integers.\n        return self.items\nclass DuplicateRepository(ABC):\n    \"\"\"Abstract base class defining the contract for a duplicate tracking repository.\"\"\"\n    @abstractmethod\n    def add(self, item: int) -> None:\n        pass\n\n    @abstractmethod\n    def contains(self, item: int) -> bool:\n        pass\n\n    @abstractmethod\n    def reset(self) -> None:\n        pass\nclass HashSetRepository(DuplicateRepository):\n    \"\"\"An in-memory repository implementation using a hash set for efficient duplicate tracking.\"\"\"\n    def __init__(self) -> None:\n        self._set: Set[int] = set()\n\n    def add(self, item: int) -> None:\n        self._set.add(item)\n\n    def contains(self, item: int) -> bool:\n        return item in self._set\n\n    def reset(self) -> None:\n        self._set.clear()\nclass DuplicateService:\n    \"\"\"Business logic for detecting duplicate elements in an iterable.\"\"\"\n    def __init__(self, repository: DuplicateRepository) -> None:\n        self.repository = repository\n\n    def detect(self, items: Iterable[int]) -> bool:\n        \"\"\"Detects if any duplicate element exists in the iterable.\"\"\"\n        self.repository.reset()\n        for item in items:\n            if self.repository.contains(item):\n                return True\n            self.repository.add(item)\n        return False\nclass DuplicateController:\n    \"\"\"Handles the public API interface, orchestrating input validation and service calls.\"\"\"\n    def __init__(self, service: DuplicateService) -> None:\n        self.service = service\n\n    def test_duplicate(self, items: Iterable[Any]) -> bool:\n        \"\"\"Public API method to test for duplicates after input validation.\"\"\"\n        dto = ArrayDTO(items)\n        # validated_items() performs type validation and returns the list.\n        validated_items = dto.validated_items()\n        result = self.service.detect(validated_items)\n        return result\ndef test_duplicate(array: Iterable[int]) -> bool:\n    \"\"\"\n    Checks if an iterable of integers contains any duplicate elements.\n    Raises DuplicateError for invalid input types or non-integer elements.\n    \"\"\"\n    # Instantiate the default dependency graph:\n    # HashSetRepository -> DuplicateService -> DuplicateController\n    repository = HashSetRepository()\n    service = DuplicateService(repository)\n    controller = DuplicateController(service)\n\n    # The controller handles input validation via ArrayDTO and then calls the service.\n    # We pass 'array' to the controller's method, leveraging its internal validation.\n    return controller.test_duplicate(array)"}
{"task_id": "Mbpp/56", "solution": "def _reverse_integer(n: int) -> int:\n    \"\"\"Reverses the digits of a non-negative integer, dropping leading zeros in the reversed value.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    return int(str(n)[::-1]) if n != 0 else 0\ndef check(n: int) -> bool:\n    \"\"\"Checks if a given number is one less than twice its reverse based on digit reversal.\"\"\"\n    reversed_val = _reverse_integer(n)\n    return n == (2 * reversed_val - 1)"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(number: int) -> bool:\n    \"\"\"Checks if the given number is a Woodall number (n * 2^n - 1).\"\"\"\n    if not isinstance(number, int):\n        raise TypeError(\"number must be an int\")\n    if number <= 0:\n        return False\n\n    # Safety cap to avoid unbounded work for extremely large inputs.\n    MAX_N_LIMIT = 1024\n    for n in range(1, MAX_N_LIMIT + 1):\n        candidate = (n * (2 ** n)) - 1\n        if candidate == number:\n            return True\n        if candidate > number:\n            return False\n    return False"}
{"task_id": "Mbpp/58", "solution": "def opposite_Signs(a: int, b: int) -> bool:\n    \"\"\"\n    Checks if two integers have opposite signs.\n    Zero is considered neither positive nor negative.\n    \"\"\"\n    return (a * b) < 0"}
{"task_id": "Mbpp/59", "solution": "def is_octagonal(n: int) -> int:\n    \"\"\"\n    Computes the nth octagonal number using the formula O(n) = n * (3n - 2).\n    This function acts as an alias for nth_octagonal to match the assertion.\n    \"\"\"\n    return n * (3 * n - 2)"}
{"task_id": "Mbpp/62", "solution": "def smallest_num(numbers):\n    \"\"\"\n    Finds the smallest number in a list of numbers.\n    Assumes the input list is non-empty and contains only numeric types.\n    \"\"\"\n    minimum = numbers[0]\n    for num in numbers[1:]:\n        if num < minimum:\n            minimum = num\n    return minimum"}
{"task_id": "Mbpp/61", "solution": "import time\nfrom collections import defaultdict\nfrom typing import List, Dict, Optional\nclass InvalidInputError(ValueError):\n    \"\"\"Exception raised for invalid input to the substring counter.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass CountRequest:\n    \"\"\"Data Transfer Object for input string.\"\"\"\n    def __init__(self, input_str: str) -> None:\n        self.input_str = input_str\nclass CountResult:\n    \"\"\"Data Transfer Object for the counting result and duration.\"\"\"\n    def __init__(self, count: int, duration_ms: float) -> None:\n        self.count = count\n        self.duration_ms = duration_ms\nclass InputValidator:\n    \"\"\"Validates the input string for numeric content and length.\"\"\"\n    def __init__(self, max_length: int = 10_000_000) -> None:\n        self.max_length = max_length\n\n    def validate_numeric(self, s: str) -> None:\n        \"\"\"Raises InvalidInputError if string contains non-digits or exceeds max_length.\"\"\"\n        if not s.isdigit() and len(s) > 0:\n            raise InvalidInputError(\"Input contains non-digit characters.\")\n        if len(s) > self.max_length:\n            raise InvalidInputError(f\"Input length ({len(s)}) exceeds maximum allowed length ({self.max_length}).\")\nclass SlidingWindowCalculator:\n    \"\"\"Provides core algorithm for digit transformation and zero-sum subarray counting.\"\"\"\n    def digits_to_offsets(self, s: str) -> List[int]:\n        \"\"\"Converts each digit character in the string to an integer offset (digit - 1).\"\"\"\n        return [ord(c) - ord('0') - 1 for c in s]\n\n    def count_zero_sum_subarrays(self, values: List[int]) -> int:\n        \"\"\"Counts subarrays with a sum of zero using a prefix sum map for O(N) complexity.\"\"\"\n        counts: Dict[int, int] = defaultdict(int)\n        prefix = 0\n        counts[0] = 1 # Initialize with 0 to account for subarrays starting from index 0\n        total = 0\n        for v in values:\n            prefix += v\n            total += counts[prefix]\n            counts[prefix] += 1\n        return total\nclass MetricsRepository:\n    \"\"\"A placeholder for optional metrics persistence, performing no actual I/O in this context.\"\"\"\n    def __init__(self, path: str = \"metrics.jsonl\") -> None:\n        self.path = path\n\n    def append_metric(self, metric: dict) -> None:\n        \"\"\"Appends a metric record. This implementation is a no-op as per completion constraints.\"\"\"\n        pass\nclass SubstringCounter:\n    \"\"\"Orchestrates the counting process, timing the operation and handling optional metrics.\"\"\"\n    def __init__(self, calculator: SlidingWindowCalculator, repo: Optional[MetricsRepository] = None) -> None:\n        self.calculator = calculator\n        self.repo = repo\n\n    def count(self, request: CountRequest) -> CountResult:\n        \"\"\"Computes the count of valid substrings and records the duration.\"\"\"\n        start = time.perf_counter()\n        values = self.calculator.digits_to_offsets(request.input_str)\n        cnt = self.calculator.count_zero_sum_subarrays(values)\n        duration_ms = (time.perf_counter() - start) * 1000.0\n        if self.repo:\n            metric = {\"timestamp\": \"TODO_ISO\", \"input_length\": len(request.input_str), \"result\": cnt, \"duration_ms\": duration_ms}\n            try:\n                self.repo.append_metric(metric)\n            except Exception:\n                # Log (implicitly ignored here) any exceptions during metrics appending as it's non-critical\n                pass\n        return CountResult(cnt, duration_ms)\nclass APIFacade:\n    \"\"\"Public API facade, coordinating input validation, service invocation, and optional metrics.\"\"\"\n    def __init__(self, validator: InputValidator, service: SubstringCounter, repo: Optional[MetricsRepository] = None) -> None:\n        self.validator = validator\n        self.service = service\n        self.repo = repo\n\n    def count_substrings(self, request: CountRequest) -> CountResult:\n        \"\"\"Validates input, then delegates to the service to count substrings.\"\"\"\n        self.validator.validate_numeric(request.input_str)\n        return self.service.count(request)\ndef count_Substrings(s: str) -> int:\n    \"\"\"\n    Counts the number of substrings where the sum of digits equals the substring length.\n    It delegates to a structured set of components for validation, core logic, and optional metrics.\n    \"\"\"\n    validator = InputValidator()\n    calculator = SlidingWindowCalculator()\n    repo = MetricsRepository() # Metrics will not be persisted in this inline context.\n    service = SubstringCounter(calculator, repo)\n    facade = APIFacade(validator, service, repo)\n\n    request = CountRequest(s)\n    result = facade.count_substrings(request)\n    return result.count"}
