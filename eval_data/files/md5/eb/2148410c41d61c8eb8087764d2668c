{"task_id": "Mbpp/422", "solution": "def find_Average_Of_Cube(n):\n    \"\"\"\n    Calculates the average of the cubes of the first n natural numbers using a closed-form formula.\n    \"\"\"\n    # Input validation\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer (>= 1)\")\n    # The sum of cubes = (n * (n + 1) / 2) ** 2\n    # Average = sum_of_cubes / n = n * (n + 1)^2 / 4\n    return (n * (n + 1) * (n + 1)) / 4.0"}
{"task_id": "Mbpp/419", "solution": "def round_and_sum(numbers: list) -> int:\n    \"\"\"\n    Rounds each number in a list, sums the rounded values, and multiplies the sum by the list's length.\n    Returns 0 for an empty list.\n    \"\"\"\n    rounded_values = [int(round(x)) for x in numbers]\n    total_sum = sum(rounded_values)\n    length = len(numbers)\n    return total_sum * length"}
{"task_id": "Mbpp/420", "solution": "def cube_Sum(n):\n    \"\"\"\n    Calculates the cube sum of the first n even natural numbers using a mathematical formula.\n    The formula: Sum_{k=1..n} (2k)^3 = 8 * (n*(n+1)/2)^2\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    s = n * (n + 1) // 2\n    return 8 * (s ** 2)"}
{"task_id": "Mbpp/424", "solution": "from typing import Tuple, List, Optional, Any\nclass InvalidInputError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass TupleValidator:\n    def validate(self, input_tuple: Any) -> None:\n        if not isinstance(input_tuple, tuple):\n            raise InvalidInputError(\"Input must be a tuple of strings.\")\n        for i, el in enumerate(input_tuple):\n            if not isinstance(el, str):\n                raise InvalidInputError(f\"Element at index {i} is not a string.\")\n            if len(el) == 0:\n                raise InvalidInputError(f\"Element at index {i} is an empty string.\")\nclass StringHelpers:\n    def last_char(self, s: str) -> str:\n        if not s:\n            raise ValueError(\"Cannot get last character of empty string.\")\n        return s[-1]\nclass RearExtractorService:\n    def __init__(self,\n                 validator: Optional[TupleValidator] = None,\n                 helpers: Optional[StringHelpers] = None) -> None:\n        self._validator = validator or TupleValidator()\n        self._helpers = helpers or StringHelpers()\n\n    def extract(self, input_tuple: Tuple[str, ...]) -> List[str]:\n        self._validator.validate(input_tuple)\n        result: List[str] = [self._helpers.last_char(s) for s in input_tuple]\n        return result\n_default_service = RearExtractorService()\ndef extract_rear(input_tuple: Tuple[str, ...]) -> List[str]:\n    \"\"\"Extracts the rear index element (last character) of each string in the input tuple.\"\"\"\n    return _default_service.extract(input_tuple)"}
{"task_id": "Mbpp/425", "solution": "def count_element_in_list(lists, element):\n    \"\"\"Count the number of sublists containing a particular element.\"\"\"\n    count = 0\n    for sublist in lists:\n        if element in sublist:\n            count += 1\n    return count"}
