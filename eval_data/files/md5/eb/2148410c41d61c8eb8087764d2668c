{"task_id": "Mbpp/731", "solution": "def lateralsurface_cone(r, h):\n    import math\n\n    # The slant height (s) of a cone is calculated as the hypotenuse of a right triangle\n    # formed by the radius (r) and height (h).\n    s = math.hypot(r, h)\n\n    # The lateral surface area of a cone is given by the formula pi * r * s.\n    area = math.pi * r * s\n\n    return area"}
{"task_id": "Mbpp/732", "solution": "class InvalidInputError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass ReplaceDTO:\n    def __init__(self, original: str, transformed: str) -> None:\n        self.original = original\n        self.transformed = transformed\n\n    def to_dict(self) -> dict:\n        return {\"original\": self.original, \"transformed\": self.transformed}\nclass CharValidator:\n    def validate_text(self, text: any) -> None:\n        if not isinstance(text, str):\n            raise InvalidInputError(\"text must be a str\")\nclass InMemoryRepository:\n    def __init__(self) -> None:\n        self._storage = []\n\n    def save(self, record: ReplaceDTO) -> None:\n        self._storage.append(record)\n\n    def list_all(self) -> list:\n        return self._storage[:]\n\n    def clear(self) -> None:\n        self._storage = []\nclass ReplaceService:\n    def __init__(self, validator: CharValidator, repository: InMemoryRepository=None) -> None:\n        self.validator = validator\n        self.repository = repository\n        self._mapping = {' ': ':', ',': ':', '.': ':'}\n\n    def replace(self, text: str) -> str:\n        self.validator.validate_text(text)\n        # Replaces occurrences of spaces, commas, or dots with a colon.\n        trans_table = str.maketrans(self._mapping)\n        result = text.translate(trans_table)\n        if self.repository is not None:\n            self.repository.save(ReplaceDTO(original=text, transformed=result))\n        return result\n_default_repository = InMemoryRepository()\n_default_service = ReplaceService(CharValidator(), repository=_default_repository)\ndef replace_specialchar(text: str) -> str:\n    \"\"\"\n    Replaces all occurrences of spaces, commas, or dots with a colon.\n    \"\"\"\n    return _default_service.replace(text)"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(nums):\n    \"\"\"\n    Calculates the sum of products of all contiguous sublists using an O(N) dynamic programming approach.\n    \"\"\"\n    total_sum_of_all_subarrays_products = 0\n    # This variable stores the sum of products for all sublists ending at the current number.\n    # It gets updated for each number based on the previous number's 'sum_products_ending_here'.\n    sum_products_ending_here = 0\n\n    for num in nums:\n        # The new 'sum_products_ending_here' is `num` itself (for the sublist `[num]`)\n        # plus `num` multiplied by the 'sum_products_ending_here' from the previous step.\n        # This extends all sublists ending previously by multiplying them with the current `num`.\n        sum_products_ending_here = num + (num * sum_products_ending_here)\n\n        # Add the sum of products for all sublists ending at the current position\n        # to the running total sum.\n        total_sum_of_all_subarrays_products += sum_products_ending_here\n\n    return total_sum_of_all_subarrays_products"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(n: int) -> int:\n    \"\"\"Toggles bits of the number except the first (MSB) and the last (LSB) bit.\"\"\"\n\n    def _get_bit_length(num: int) -> int:\n        \"\"\"Returns the bit length of a non-negative integer.\"\"\"\n        return 0 if num == 0 else num.bit_length()\n\n    def _build_middle_mask(length: int) -> int:\n        \"\"\"Constructs a mask with 1s for middle bits (excluding MSB and LSB).\"\"\"\n        if length <= 2:\n            return 0\n        # Create a mask by setting all bits up to MSB-1, then clearing the LSB.\n        return (((1 << (length - 1)) - 1) ^ 1)\n\n    bit_length = _get_bit_length(n)\n    mask = _build_middle_mask(bit_length)\n\n    return n ^ mask"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(arr: list[int], target: int) -> int:\n    \"\"\"\n    Finds the 0-based index of the first occurrence of target in a sorted list `arr`.\n    Returns -1 if target is not present.\n    \"\"\"\n    left, right = 0, len(arr) - 1\n    result = -1\n\n    while left <= right:\n        mid = (left + right) // 2\n        if arr[mid] == target:\n            result = mid\n            right = mid - 1  # continue searching left half for earlier occurrence\n        elif arr[mid] < target:\n            left = mid + 1\n        else:\n            right = mid - 1\n\n    return result"}
{"task_id": "Mbpp/737", "solution": "def check_str(s: str) -> bool:\n    \"\"\"\n    Return True if the given string starts with a vowel (a, e, i, o, u), case-insensitive.\n    Leading whitespace is ignored. Raises TypeError if input is not a string.\n    \"\"\"\n    import re\n\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string\")\n\n    s = s.lstrip()\n    if not s:\n        return False\n\n    return bool(re.match(r'^[aeiou]', s, re.IGNORECASE))"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(lst, value):\n    \"\"\"\n    Locate the left insertion point for a specified value in sorted order using binary search.\n    Equivalent to bisect_left from the standard library.\n    \"\"\"\n    lo = 0\n    hi = len(lst)\n    while lo < hi:\n        mid = (lo + hi) // 2\n        if lst[mid] < value:\n            lo = mid + 1\n        else:\n            hi = mid\n    return lo"}
{"task_id": "Mbpp/739", "solution": "def find_Index(n: int) -> int:\n    import math\n\n    # Helper function to compute the k-th triangular number.\n    def _triangular_value(k: int) -> int:\n        return k * (k + 1) // 2\n\n    # Helper function to count the number of decimal digits in an integer.\n    def _digits_count(num: int) -> int:\n        if num == 0:\n            return 1\n        return len(str(num))\n\n    # Validate input\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"n must be an integer >= 1\")\n\n    # Calculate the minimum value a triangular number must have to contain n digits.\n    target_min_value = 10 ** (n - 1)\n\n    # Estimate k using the quadratic formula for k^2 + k - 2 * target_min_value >= 0.\n    # We use integer square root for precision with large numbers.\n    discriminant = 1 + 8 * target_min_value\n    s = math.isqrt(discriminant)\n\n    k_candidate = (-1 + s) // 2\n\n    # Adjust k_candidate upwards until its triangular value has at least n digits.\n    while _digits_count(_triangular_value(k_candidate)) < n:\n        k_candidate += 1\n\n    # Adjust k_candidate downwards to ensure it's the smallest such index.\n    while k_candidate > 1 and _digits_count(_triangular_value(k_candidate - 1)) >= n:\n        k_candidate -= 1\n\n    return k_candidate"}
{"task_id": "Mbpp/740", "solution": "def tuple_to_dict(data: tuple) -> dict:\n    \"\"\"Converts a tuple of adjacent key-value pairs into a dictionary.\n    Keys are at even indices, values at odd indices.\n    \"\"\"\n    result = {}\n    for i in range(0, len(data), 2):\n        key = data[i]\n        value = data[i + 1]\n        result[key] = value\n    return result"}
{"task_id": "Mbpp/741", "solution": "def all_Characters_Same(s: str) -> bool:\n    \"\"\"Return True if all characters in the input string are the same.\n    Empty string returns True. Raises TypeError for non-str inputs.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a str\")\n    if s == \"\":\n        return True\n    first = s[0]\n    for ch in s:\n        if ch != first:\n            return False\n    return True"}
{"task_id": "Mbpp/742", "solution": "import math\ndef area_tetrahedron(edge_length: float) -> float:\n    \"\"\"\n    Calculates the surface area of a regular tetrahedron given its edge length.\n    The formula used is A = sqrt(3) * a^2, where 'a' is the edge length.\n    \"\"\"\n    return math.sqrt(3) * (edge_length ** 2)"}
