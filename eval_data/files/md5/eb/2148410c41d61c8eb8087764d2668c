{"task_id": "Mbpp/281", "solution": "def all_unique(items: list[Any]) -> bool:\n    \"\"\"\n    Checks if all elements in a list are unique, handling both hashable and unhashable items.\n    Returns True if all elements are unique, False otherwise.\n    \"\"\"\n    from typing import Any\n\n    def _is_hashable(obj: Any) -> bool:\n        \"\"\"Determines if an object is hashable.\"\"\"\n        try:\n            hash(obj)\n            return True\n        except TypeError:\n            return False\n\n    seen_hashable = set()\n    seen_unhashable = []\n\n    for item in items:\n        if _is_hashable(item):\n            if item in seen_hashable:\n                return False\n            seen_hashable.add(item)\n        else:\n            if item in seen_unhashable:\n                return False\n            seen_unhashable.append(item)\n\n    return True"}
