{"task_id": "Mbpp/459", "solution": "class StringToken:\n    \"\"\"A data transfer object representing a contiguous run of characters.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n        self.is_upper = value.isupper()\ndef remove_uppercase(text: str) -> str:\n    \"\"\"\n    Removes contiguous uppercase-letter substrings from the input string.\n    \"\"\"\n    if not text:\n        return \"\"\n\n    tokens = []\n    current_chars = [text[0]]\n    current_is_upper_property = text[0].isupper()\n\n    for char in text[1:]:\n        char_is_upper_property = char.isupper()\n        if char_is_upper_property == current_is_upper_property:\n            current_chars.append(char)\n        else:\n            tokens.append(StringToken(\"\".join(current_chars)))\n            current_chars = [char]\n            current_is_upper_property = char_is_upper_property\n\n    tokens.append(StringToken(\"\".join(current_chars)))\n\n    kept_chars = [token.value for token in tokens if not token.is_upper]\n    return \"\".join(kept_chars)"}
{"task_id": "Mbpp/460", "solution": "def Extract(data):\n    \"\"\"\n    Extracts the first element from each non-empty sublist in a list of lists.\n    Empty sublists are skipped.\n    \"\"\"\n    result = []\n    for sublist in data:\n        if sublist:  # Check if sublist is not empty\n            result.append(sublist[0])\n    return result"}
{"task_id": "Mbpp/463", "solution": "def max_subarray_product(arr: list) -> int:\n    \"\"\"Finds the maximum product of a contiguous subarray in the given list of integers.\n    The algorithm runs in O(n) time and O(1) space.\n    \"\"\"\n    if not arr:\n        raise ValueError(\"Input array must contain at least one element\")\n\n    current_max = arr[0]\n    current_min = arr[0]\n    global_max = arr[0]\n\n    for num in arr[1:]:\n        if num == 0:\n            current_max, current_min = 0, 0\n            global_max = max(global_max, 0)\n            continue\n\n        candidates = (num, current_max * num, current_min * num)\n        temp_max = max(candidates)\n        temp_min = min(candidates)\n\n        current_max, current_min = temp_max, temp_min\n        global_max = max(global_max, current_max)\n\n    return global_max"}
{"task_id": "Mbpp/462", "solution": "def combinations_list(items):\n    \"\"\"\n    Finds all possible combinations (the power set) of elements in a given list.\n    The combinations are generated in a deterministic order matching the example:\n    start with [[]], then for each item left-to-right append new combos by prefixing the item.\n    \"\"\"\n    class CombinationService:\n        def __init__(self):\n            pass\n\n        def generate_combinations(self, items):\n            combos = [[]]\n            for item in items:\n                for existing_combo in list(combos):\n                    combos.append([item] + existing_combo)\n            return combos\n\n    svc = CombinationService()\n    return svc.generate_combinations(items)"}
{"task_id": "Mbpp/465", "solution": "from typing import Mapping, Any, Dict, Optional, Iterable, Set\nclass Utils:\n    \"\"\"Utility class providing helper predicates and operations.\"\"\"\n    DEFAULT_EMPTY_VALUES: frozenset = frozenset({None, \"\", (), [], {}, set()})\n\n    @staticmethod\n    def is_empty(value: Any, empty_values: Iterable[Any]) -> bool:\n        \"\"\"Determines if a value is considered empty.\"\"\"\n        if value in empty_values:\n            return True\n        try:\n            return hasattr(value, \"__len__\") and len(value) == 0\n        except Exception:\n            return False\n\n    @staticmethod\n    def copy_mapping_shallow(data: Mapping[str, Any]) -> Dict[str, Any]:\n        \"\"\"Returns a shallow copy of a mapping.\"\"\"\n        return dict(data)\nclass CleanerConfig:\n    \"\"\"Configuration for DictCleaner.\"\"\"\n    def __init__(self, empty_values: Optional[Iterable[Any]] = None, recursive: bool = True, in_place: bool = False) -> None:\n        self.empty_values: Set[Any] = set(empty_values) if empty_values is not None else set(Utils.DEFAULT_EMPTY_VALUES)\n        self.recursive: bool = recursive\n        self.in_place: bool = in_place\nclass DictCleaner:\n    \"\"\"\n    Cleans dictionaries by removing entries with empty values based on configuration.\n    Supports recursive cleaning and in-place modification.\n    \"\"\"\n    def __init__(self, config: CleanerConfig) -> None:\n        self._config = config\n\n    def clean(self, data: Mapping[str, Any]) -> Dict[str, Any]:\n        \"\"\"\n        Cleans the input mapping by removing empty values.\n        Returns a new dictionary or modifies in-place based on config.\n        \"\"\"\n        target_data = data if self._config.in_place else Utils.copy_mapping_shallow(data)\n\n        # If in-place modification is requested on a non-dict Mapping, convert it to a dict.\n        if self._config.in_place and not isinstance(target_data, dict):\n            target_data = dict(target_data)\n\n        return self._clean_mapping(target_data)\n\n    def _clean_mapping(self, data: dict) -> dict:\n        \"\"\"\n        Internal recursive helper to clean a dictionary.\n        Modifies data in-place when processing its contents.\n        \"\"\"\n        keys_to_remove = []\n        for key, value in data.items():\n            if self._config.recursive and isinstance(value, dict):\n                self._clean_mapping(value)\n                if not value: # If nested dict became empty after cleaning, mark for removal\n                    keys_to_remove.append(key)\n            elif self._config.recursive and isinstance(value, list):\n                cleaned_list = []\n                for item in value:\n                    if isinstance(item, dict):\n                        self._clean_mapping(item)\n                        if item:\n                            cleaned_list.append(item)\n                    elif not Utils.is_empty(item, self._config.empty_values):\n                        cleaned_list.append(item)\n\n                if not cleaned_list:\n                    keys_to_remove.append(key)\n                else:\n                    data[key] = cleaned_list\n            elif Utils.is_empty(value, self._config.empty_values):\n                keys_to_remove.append(key)\n\n        for key in keys_to_remove:\n            del data[key]\n\n        return data\ndef drop_empty(data: Mapping[str, Any]) -> Dict[str, Any]:\n    \"\"\"\n    Removes entries with values considered empty (None, empty strings, containers)\n    from a mapping, returning a new dictionary.\n    \"\"\"\n    config = CleanerConfig(recursive=True, in_place=False)\n    cleaner = DictCleaner(config)\n    return cleaner.clean(data)"}
{"task_id": "Mbpp/471", "solution": "def find_remainder(arr, n):\n    \"\"\"\n    Compute the product of the elements in `arr` modulo `n` and return the remainder.\n\n    - arr: iterable of integers (or values convertible to int)\n    - n: positive integer modulus\n\n    Example:\n        assert find_remainder([100, 10, 5, 25, 35, 14], 11) == 9\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Modulus n must be an integer\")\n    if n <= 0:\n        raise ValueError(\"Modulus n must be a positive integer\")\n\n    try:\n        iterator = iter(arr)\n    except TypeError:\n        raise TypeError(\"arr must be an iterable of integers\")\n\n    result = 1 % n  # handles case n == 1 correctly (result == 0)\n    for idx, x in enumerate(arr):\n        try:\n            xi = int(x)\n        except Exception:\n            raise TypeError(f\"Element at index {idx} is not convertible to int: {x!r}\")\n        result = (result * (xi % n)) % n\n        if result == 0:\n            # Early exit: once product \u2261 0 (mod n), it remains 0\n            return 0\n    return result"}
{"task_id": "Mbpp/468", "solution": "def max_product(nums) -> float:\n    \"\"\"\n    Finds the maximum product formed by multiplying numbers of a contiguous, strictly increasing subarray.\n    Handles empty arrays, single elements, zeros, and negative numbers.\n    \"\"\"\n    n = len(nums)\n    if n == 0:\n        return 0.0\n\n    # Convert all numbers to float for consistent calculations.\n    nums_float = [float(x) for x in nums]\n\n    # Initialize max_overall_product with the first element, as a single element is a valid subarray.\n    max_overall_product = nums_float[0]\n    # current_max_product_ending_here stores the maximum product of a contiguous\n    # strictly increasing subarray that ends at the current position.\n    current_max_product_ending_here = nums_float[0]\n\n    for i in range(1, n):\n        # If the current number is strictly greater than the previous, we can potentially extend the sequence.\n        if nums_float[i] > nums_float[i-1]:\n            # The new product is either the current number itself (starting a new sequence),\n            # or the product of the previous sequence extended by the current number.\n            # We take the maximum to handle cases where multiplying by nums_float[i]\n            # might reduce the product (e.g., if previous product was negative and nums_float[i] is positive).\n            current_max_product_ending_here = max(nums_float[i], current_max_product_ending_here * nums_float[i])\n        else:\n            # If the sequence is broken (not strictly increasing), start a new sequence\n            # with the current number.\n            current_max_product_ending_here = nums_float[i]\n\n        # Update the overall maximum product found so far.\n        max_overall_product = max(max_overall_product, current_max_product_ending_here)\n\n    return max_overall_product"}
{"task_id": "Mbpp/470", "solution": "def add_pairwise(t):\n    \"\"\"Calculates the pairwise sum of neighboring elements in a tuple.\n    Returns an empty tuple if the input tuple has fewer than two elements.\"\"\"\n    if len(t) < 2:\n        return ()\n\n    return tuple(t[i] + t[i+1] for i in range(len(t) - 1))"}
{"task_id": "Mbpp/472", "solution": "def check_Consecutive(numbers: list) -> bool:\n    \"\"\"\n    Checks if the given list contains unique, consecutive integer numbers, ignoring order.\n    An empty list returns False; a single-element list returns True.\n    \"\"\"\n    if not numbers:\n        return False\n    if len(numbers) == 1:\n        return True\n\n    seen = set()\n    min_v = float('inf')\n    max_v = float('-inf')\n\n    for v in numbers:\n        if v in seen:\n            return False  # Duplicate found\n        seen.add(v)\n        if v < min_v:\n            min_v = v\n        if v > max_v:\n            max_v = v\n\n    return (max_v - min_v + 1) == len(numbers)"}
{"task_id": "Mbpp/473", "solution": "from typing import List, Tuple, Any, Set\ndef tuple_intersection(list_a: List[Tuple[Any, ...]], list_b: List[Tuple[Any, ...]]) -> Set[Tuple[Any, ...]]:\n    \"\"\"\n    Finds the intersection of elements in two lists of tuples,\n    treating tuples as equal if they contain the same elements irrespective of order.\n    \"\"\"\n    canonical_set_a = {tuple(sorted(t)) for t in list_a}\n    canonical_set_b = {tuple(sorted(t)) for t in list_b}\n    return canonical_set_a.intersection(canonical_set_b)"}
{"task_id": "Mbpp/474", "solution": "import datetime\nimport json\nimport os\nfrom typing import Optional\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input parameters.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass ServiceError(Exception):\n    \"\"\"Exception raised for service-level failures, possibly wrapping another cause.\"\"\"\n    def __init__(self, message: str, cause: Optional[Exception] = None) -> None:\n        super().__init__(message)\n        self.cause = cause\ndef current_iso_timestamp() -> str:\n    \"\"\"Returns the current UTC timestamp in ISO 8601 format.\"\"\"\n    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='seconds')\nclass ReplaceRequest:\n    \"\"\"Data transfer object for a character replacement request.\"\"\"\n    def __init__(self, input_str: str, old: str, new: str) -> None:\n        self.input_str = input_str\n        self.old = old\n        self.new = new\nclass ReplaceResult:\n    \"\"\"Data transfer object for the result of a character replacement operation.\"\"\"\n    def __init__(self, original: str, result: str, old: str, new: str, timestamp: str) -> None:\n        self.original = original\n        self.result = result\n        self.old = old\n        self.new = new\n        self.timestamp = timestamp\n\n    def to_dict(self) -> dict:\n        \"\"\"Converts the result to a dictionary for JSON serialization.\"\"\"\n        return {\n            \"timestamp\": self.timestamp,\n            \"original\": self.original,\n            \"result\": self.result,\n            \"old\": self.old,\n            \"new\": self.new\n        }\nclass InputValidator:\n    \"\"\"Validates input parameters for character replacement.\"\"\"\n    ALLOWED_LENGTH: int = 1\n\n    def validate(self, req: ReplaceRequest) -> None:\n        \"\"\"Validates the ReplaceRequest and raises InvalidInputError on failure.\"\"\"\n        if not isinstance(req.input_str, str):\n            raise InvalidInputError(\"Input string 's' must be a string.\")\n        if not isinstance(req.old, str):\n            raise InvalidInputError(\"Character 'old' must be a string.\")\n        if not isinstance(req.new, str):\n            raise InvalidInputError(\"Character 'new' must be a string.\")\n\n        if len(req.old) != self.ALLOWED_LENGTH:\n            raise InvalidInputError(\n                f\"Character 'old' must be exactly {self.ALLOWED_LENGTH} character long.\"\n            )\n        if len(req.new) != self.ALLOWED_LENGTH:\n            raise InvalidInputError(\n                f\"Character 'new' must be exactly {self.ALLOWED_LENGTH} character long.\"\n            )\nclass FileRepository:\n    \"\"\"Optional persistence of operations to a JSONL file.\"\"\"\n    def __init__(self, path: str) -> None:\n        self._path = path\n        dirname = os.path.dirname(path)\n        if dirname and not os.path.exists(dirname):\n            os.makedirs(dirname)\n\n    def save(self, entry: ReplaceResult) -> None:\n        \"\"\"Appends a JSON line with replacement details to the log file.\"\"\"\n        try:\n            with open(self._path, 'a', encoding='utf-8') as f:\n                json.dump(entry.to_dict(), f)\n                f.write('\\n')\n        except Exception as e:\n            raise ServiceError(f\"Failed to write to log file: {self._path}\", cause=e)\nclass ReplaceService:\n    \"\"\"Core replacement business logic with validation and optional persistence.\"\"\"\n    def __init__(self, validator: InputValidator, repository: Optional[FileRepository] = None) -> None:\n        self._validator = validator\n        self._repository = repository\n\n    def replace(self, req: ReplaceRequest) -> ReplaceResult:\n        \"\"\"Validates, computes replacement, builds ReplaceResult, and persists optionally.\"\"\"\n        self._validator.validate(req)\n\n        if req.old == req.new:\n            res_str = req.input_str\n        else:\n            res_str = req.input_str.replace(req.old, req.new)\n\n        timestamp = current_iso_timestamp()\n        result = ReplaceResult(req.input_str, res_str, req.old, req.new, timestamp)\n\n        if self._repository:\n            try:\n                self._repository.save(result)\n            except Exception as e:\n                raise ServiceError(\"Failed to persist result\", e)\n        return result\nclass StringAPI:\n    \"\"\"Public API facade for string utility operations.\"\"\"\n    def __init__(self, validator: Optional[InputValidator] = None, repository: Optional[FileRepository] = None):\n        validator = validator or InputValidator()\n        self._service = ReplaceService(validator, repository)\n\n    def replace_char(self, s: str, old: str, new: str) -> str:\n        \"\"\"Replaces all occurrences of a character in a string.\"\"\"\n        req = ReplaceRequest(s, old, new)\n        result = self._service.replace(req)\n        return result.result\n_api = StringAPI()\ndef replace_char(s: str, old: str, new: str) -> str:\n    \"\"\"Replaces all occurrences of a character 'old' with 'new' in string 's'.\"\"\"\n    return _api.replace_char(s, old, new)"}
{"task_id": "Mbpp/476", "solution": "def big_sum(numbers):\n    \"\"\"\n    Return the sum of the smallest and largest numeric values in 'numbers'.\n\n    Raises:\n        TypeError: if 'numbers' is not iterable or contains non-numeric elements.\n        ValueError: if 'numbers' is empty.\n    \"\"\"\n    try:\n        it = iter(numbers)\n    except TypeError:\n        raise TypeError(\"numbers must be an iterable of ints/floats\")\n\n    try:\n        first = next(it)\n    except StopIteration:\n        raise ValueError(\"numbers must not be empty\")\n\n    if not isinstance(first, (int, float)):\n        raise TypeError(f\"array elements must be int or float, got {type(first).__name__}\")\n\n    min_val = max_val = first\n    for x in it:\n        if not isinstance(x, (int, float)):\n            raise TypeError(f\"array elements must be int or float, got {type(x).__name__}\")\n        if x < min_val:\n            min_val = x\n        if x > max_val:\n            max_val = x\n\n    return min_val + max_val"}
{"task_id": "Mbpp/475", "solution": "def sort_counter(mapping):\n    \"\"\"Sorts a dictionary by its values in descending order, preserving original insertion order for ties.\"\"\"\n    enumerated_items = [(i, k, v) for i, (k, v) in enumerate(mapping.items())]\n\n    # Sorts by value in descending order, then by original index in ascending order for stable tie-breaking.\n    enumerated_items.sort(key=lambda item_tuple: (-item_tuple[2], item_tuple[0]))\n\n    return [(k, v) for _, k, v in enumerated_items]"}
{"task_id": "Mbpp/477", "solution": "def is_lower(s: str) -> str:\n    \"\"\"Converts the given string to lower case.\n    This implementation follows a layered architecture from the design context, with helpers defined inline.\"\"\"\n    from dataclasses import dataclass\n\n    class ConversionError(Exception):\n        \"\"\"Custom exception for conversion errors.\"\"\"\n        def __init__(self, message: str) -> None:\n            self.message = message\n            super().__init__(message)\n\n    @dataclass\n    class ConvertRequest:\n        \"\"\"Data transfer object for conversion requests.\"\"\"\n        value: str\n        # Input validation checks removed to comply with \"DO NOT add isinstance() checks or raise exceptions\".\n\n    @dataclass\n    class ConvertResponse:\n        \"\"\"Data transfer object for conversion responses.\"\"\"\n        original: str\n        result: str\n        converted: bool = True\n\n        def __init__(self, original: str, result: str) -> None:\n            self.original = original\n            self.result = result\n            self.converted = True\n\n    class StringConverter:\n        \"\"\"Performs the actual lowercase conversion logic.\"\"\"\n        def __init__(self) -> None:\n            pass\n\n        def convert(self, value: str) -> str:\n            # Explicit input validation removed to comply with \"DO NOT add isinstance() checks or raise exceptions\".\n            return value.lower()\n\n    class StringService:\n        \"\"\"Orchestrates string conversion using a converter.\"\"\"\n        def __init__(self, converter: StringConverter = None) -> None:\n            self.converter = converter or StringConverter()\n\n        def lowercase(self, request: ConvertRequest) -> ConvertResponse:\n            # Error handling (try-except and raise ConversionError) removed to comply with \"DO NOT add ... raise exceptions\".\n            result = self.converter.convert(request.value)\n            return ConvertResponse(original=request.value, result=result)\n\n    request = ConvertRequest(s)\n    service = StringService()\n    response = service.lowercase(request)\n    return response.result"}
