{"task_id": "Mbpp/409", "solution": "class ValidationError(Exception):\n    pass\nclass InvalidTupleError(ValidationError):\n    def __init__(self, index, item):\n        self.index = index\n        self.item = item\n        super().__init__(f\"Item at index {index} is not a 2-element tuple/list: {item}\")\nclass NonNumericElementError(ValidationError):\n    def __init__(self, index, item, element_index):\n        self.index = index\n        self.item = item\n        self.element_index = element_index\n        super().__init__(f\"Element {element_index} of item at index {index} is not numeric: {item}\")\nclass EmptyInputError(ValidationError):\n    def __init__(self):\n        super().__init__(\"Input sequence is empty\")\ndef to_number(value):\n    if isinstance(value, (int, float)):\n        return float(value)\n    if isinstance(value, str):\n        try:\n            return float(value)\n        except ValueError:\n            raise ValueError(\"string not convertible to float\")\n    raise ValueError(\"value is not numeric\")\nclass Validator:\n    def validate_items(self, items):\n        # Convert to list to ensure single iteration for length check and subsequent processing\n        # This will raise TypeError if 'items' is not iterable.\n        items_list = list(items)\n\n        if len(items_list) == 0:\n            raise EmptyInputError()\n\n        for idx, item in enumerate(items_list):\n            if not isinstance(item, (list, tuple)) or len(item) != 2:\n                raise InvalidTupleError(index=idx, item=item)\n            try:\n                to_number(item[0])\n            except ValueError:\n                raise NonNumericElementError(index=idx, item=item, element_index=0)\n            try:\n                to_number(item[1])\n            except ValueError:\n                raise NonNumericElementError(index=idx, item=item, element_index=1)\nclass ProductCalculator:\n    def compute_product(self, pair):\n        try:\n            a = to_number(pair[0])\n        except ValueError as e:\n            raise NonNumericElementError(index=None, item=pair, element_index=0) from e\n        try:\n            b = to_number(pair[1])\n        except ValueError as e:\n            raise NonNumericElementError(index=None, item=pair, element_index=1) from e\n        return a * b\nclass MinProductService:\n    def __init__(self, validator=None, calculator=None):\n        self.validator = validator or Validator()\n        self.calculator = calculator or ProductCalculator()\n\n    def min_product(self, items, allow_empty=False):\n        # Convert to list to ensure consistent length check and iteration.\n        items_list = list(items)\n\n        if len(items_list) == 0:\n            if allow_empty:\n                return None\n            raise EmptyInputError()\n\n        # Validate all items before starting product calculation.\n        self.validator.validate_items(items_list)\n\n        min_val = None\n        for pair in items_list:\n            prod = self.calculator.compute_product(pair)\n            if min_val is None or prod < min_val:\n                min_val = prod\n        return float(min_val)\ndef min_product_tuple(items, allow_empty=False):\n    \"\"\"\n    Finds the minimum product from pairs of tuples within a given list.\n    Validates input and computes the minimum product.\n    \"\"\"\n    _default_service = MinProductService(validator=Validator(), calculator=ProductCalculator())\n    return _default_service.min_product(items, allow_empty=allow_empty)"}
