{"task_id": "Mbpp/125", "solution": "def find_length(s: str) -> int:\n    \"\"\"\n    Computes the maximum difference between the number of 0s and 1s in any substring.\n    Uses Kadane's algorithm by mapping '0' to +1 and '1' to -1, finding the maximum subarray sum.\n    \"\"\"\n    max_so_far = 0  # Stores the maximum difference found in any substring.\n    current_max = 0 # Stores the maximum difference ending at the current position.\n\n    for char in s:\n        # Map '0' to +1 (for count_0s) and '1' to -1 (for -count_1s)\n        value = 1 if char == '0' else -1\n\n        # Kadane's algorithm:\n        # If adding the current value makes the sum negative, it's better to start a new subarray.\n        current_max = max(0, current_max + value)\n\n        # Update the overall maximum difference found.\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
{"task_id": "Mbpp/127", "solution": "from typing import Any\ndef multiply_int(a: int, b: int) -> int:\n    \"\"\"\n    Multiplies two integers, validating their types before computation.\n    Raises InvalidTypeError if inputs are not integers.\n    \"\"\"\n\n    class MultiplyError(Exception):\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n\n    class InvalidTypeError(MultiplyError):\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n\n    class InputDTO:\n        def __init__(self, a: int, b: int) -> None:\n            self.a: int = a\n            self.b: int = b\n\n    class ResultDTO:\n        def __init__(self, result: int) -> None:\n            self.result: int = result\n\n    class IntegerValidator:\n        def validate_int(self, value: Any, name: str) -> int:\n            if not isinstance(value, int):\n                raise InvalidTypeError(f\"'{name}' must be int, got {type(value).__name__}\")\n            return value\n\n    class MultiplierService:\n        def __init__(self, validator: IntegerValidator) -> None:\n            self._validator = validator\n\n        def multiply(self, input_dto: InputDTO) -> ResultDTO:\n            a_validated = self._validator.validate_int(input_dto.a, \"a\")\n            b_validated = self._validator.validate_int(input_dto.b, \"b\")\n            try:\n                result = a_validated * b_validated\n            except Exception as e:\n                raise MultiplyError(\"Unexpected error during multiplication\") from e\n            return ResultDTO(result)\n\n    class MultiplierController:\n        def __init__(self, service: MultiplierService) -> None:\n            self._service = service\n\n        def multiply_int(self, a: int, b: int) -> int:\n            input_dto = InputDTO(a, b)\n            return self._service.multiply(input_dto).result\n\n    service = MultiplierService(IntegerValidator())\n    controller = MultiplierController(service)\n    return controller.multiply_int(a, b)"}
{"task_id": "Mbpp/128", "solution": "import string\nfrom typing import Iterator\nclass TokenizationConfig:\n    \"\"\"Configuration for word tokenization and normalization.\"\"\"\n    def __init__(self, strip_punctuation: bool = True) -> None:\n        self.strip_punctuation = strip_punctuation\nclass WordFilterService:\n    \"\"\"Service to filter words based on their length.\"\"\"\n    def __init__(self, repo=None):\n        self._repo = repo\n\n    def filter_long_words(self, min_length: int, words, cfg: TokenizationConfig | None = None) -> list[str]:\n        \"\"\"Filters an iterable of words, returning those longer than min_length.\"\"\"\n        result: list[str] = []\n        for w in words:\n            if not isinstance(w, str):\n                w = str(w)\n            if len(w) > min_length:\n                result.append(w)\n        return result\n\n    def filter_from_text(self, min_length: int, text: str, cfg: TokenizationConfig | None = None) -> list[str]:\n        \"\"\"Tokenizes text and filters the resulting words by length.\"\"\"\n        tokens = tokenize(text, cfg)\n        return self.filter_long_words(min_length, tokens, cfg)\ndef long_words(n: int, text_or_list, normalize: bool = True) -> list[str]:\n    \"\"\"\n    Finds words that are longer than n characters from a given text or list of words.\n    Applies tokenization and optional punctuation normalization.\n    \"\"\"\n    cfg = TokenizationConfig(strip_punctuation=normalize)\n    service = WordFilterService()\n\n    if isinstance(text_or_list, str):\n        return service.filter_from_text(n, text_or_list, cfg)\n    else:\n        return service.filter_long_words(n, text_or_list, cfg)"}
{"task_id": "Mbpp/129", "solution": "from typing import List, Any\ndef magic_square_test(matrix_data: List[List[int]]) -> bool:\n    \"\"\"\n    Checks if a given square matrix is a magic square.\n    A magic square has equal sums across all its rows, columns, and both main diagonals.\n    \"\"\"\n\n    class MagicSquareError(Exception):\n        \"\"\"Custom exception for magic square validation errors.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n\n    class Matrix:\n        \"\"\"Represents a square matrix and provides methods for sum calculations.\"\"\"\n        def __init__(self, data: List[List[int]]) -> None:\n            self._data = data\n\n        @property\n        def n(self) -> int:\n            \"\"\"Returns the dimension of the matrix.\"\"\"\n            return len(self._data)\n\n        def row_sum(self, i: int) -> int:\n            \"\"\"Calculates the sum of the specified row.\"\"\"\n            return sum(self._data[i])\n\n        def col_sum(self, j: int) -> int:\n            \"\"\"Calculates the sum of the specified column.\"\"\"\n            return sum(row[j] for row in self._data)\n\n        def main_diagonal_sum(self) -> int:\n            \"\"\"Calculates the sum of the main diagonal.\"\"\"\n            return sum(self._data[i][i] for i in range(self.n))\n\n        def anti_diagonal_sum(self) -> int:\n            \"\"\"Calculates the sum of the anti-diagonal.\"\"\"\n            return sum(self._data[i][self.n - 1 - i] for i in range(self.n))\n\n    class MatrixValidator:\n        \"\"\"Validates if input data forms a non-empty square matrix of integers.\"\"\"\n        MIN_SIZE = 1\n\n        def validate(self, data: Any) -> List[List[int]]:\n            \"\"\"Validates the input data and returns it as a list of lists of integers.\"\"\"\n            matrix = self._ensure_is_list_of_lists(data)\n            self._ensure_square(matrix)\n            self._ensure_integers(matrix)\n            return matrix\n\n        def _ensure_is_list_of_lists(self, data: Any) -> List[List[Any]]:\n            \"\"\"Ensures the data is a list of lists.\"\"\"\n            if not isinstance(data, list) or not data:\n                raise MagicSquareError(\"Input must be a non-empty list of lists.\")\n            for row in data:\n                if not isinstance(row, list):\n                    raise MagicSquareError(\"Input must be a list of lists.\")\n            return data\n\n        def _ensure_square(self, data: List[List[Any]]) -> None:\n            \"\"\"Ensures the matrix is square and non-empty.\"\"\"\n            n = len(data)\n            if n < self.MIN_SIZE:\n                raise MagicSquareError(\"Matrix must be non-empty and square (n x n).\")\n            for row in data:\n                if len(row) != n:\n                    raise MagicSquareError(\"Matrix must be non-empty and square (n x n).\")\n\n        def _ensure_integers(self, data: List[List[Any]]) -> None:\n            \"\"\"Ensures all matrix elements are integers.\"\"\"\n            for row in data:\n                for item in row:\n                    if not isinstance(item, int):\n                        raise MagicSquareError(\"Matrix elements must be integers.\")\n\n    class MagicSquareService:\n        \"\"\"Provides the core logic to determine if a matrix is a magic square.\"\"\"\n        def __init__(self, validator: MatrixValidator) -> None:\n            self._validator = validator\n\n        def is_magic(self, matrix_data: List[List[int]]) -> bool:\n            \"\"\"Checks if the given matrix data represents a magic square.\"\"\"\n            validated = self._validator.validate(matrix_data)\n            matrix = Matrix(validated)\n\n            target = self._compute_target_sum(matrix)\n            return self._check_rows_columns_diagonals(matrix, target)\n\n        def _compute_target_sum(self, matrix: Matrix) -> int:\n            \"\"\"Computes the target sum from the first row of the matrix.\"\"\"\n            return matrix.row_sum(0)\n\n        def _check_rows_columns_diagonals(self, matrix: Matrix, target: int) -> bool:\n            \"\"\"Verifies if all row, column, and diagonal sums match the target.\"\"\"\n            n = matrix.n\n\n            if matrix.main_diagonal_sum() != target:\n                return False\n            if matrix.anti_diagonal_sum() != target:\n                return False\n\n            for i in range(n):\n                if matrix.row_sum(i) != target:\n                    return False\n                if matrix.col_sum(i) != target:\n                    return False\n            return True\n\n    svc = MagicSquareService(MatrixValidator())\n    return svc.is_magic(matrix_data)"}
{"task_id": "Mbpp/130", "solution": "def max_occurrences(items):\n    \"\"\"\n    Finds the item with the maximum frequency in a list, using a stable tie-breaker.\n    Raises ValueError for empty input or TypeError for unhashable items.\n    \"\"\"\n    if not items:\n        raise ValueError(\"items must be non-empty\")\n\n    # Using collections.Counter handles frequency counting efficiently and raises TypeError for unhashable items.\n    # The TypeError propagates as required by the design context.\n    import collections\n    counts = collections.Counter(items)\n\n    max_count = 0\n    if counts: # Ensure counts is not empty before calling max, though it should not be if items is non-empty.\n        max_count = max(counts.values())\n\n    # Iterate through the original list to ensure stable tie-breaking:\n    # return the first item encountered that has the maximum frequency.\n    for item in items:\n        if counts.get(item) == max_count:\n            return item\n\n    # This part should theoretically be unreachable if the input list was non-empty\n    # and counts were successfully generated.\n    raise RuntimeError(\"Unexpected state: no item found with maximum frequency.\")"}
{"task_id": "Mbpp/131", "solution": "def reverse_vowels(s: str) -> str:\n    \"\"\"\n    Reverses only the vowels in a given string.\n    'y' is not considered a vowel.\n    \"\"\"\n    vowels = \"aeiouAEIOU\"\n    s_list = list(s)\n\n    vowel_indices = []\n    vowel_chars = []\n\n    for i, char in enumerate(s_list):\n        if char in vowels:\n            vowel_indices.append(i)\n            vowel_chars.append(char)\n\n    vowel_chars.reverse()\n\n    for i, char in zip(vowel_indices, vowel_chars):\n        s_list[i] = char\n\n    return \"\".join(s_list)"}
