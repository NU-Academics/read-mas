{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(s: str) -> int:\n    \"\"\"\n    Calculates the maximum consecutive run of uppercase ASCII characters in a string.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"input must be a str\")\n\n    def _is_ascii_upper(ch: str) -> bool:\n        return len(ch) == 1 and 'A' <= ch <= 'Z'\n\n    max_run = 0\n    current_run = 0\n    for char in s:\n        if _is_ascii_upper(char):\n            current_run += 1\n            if current_run > max_run:\n                max_run = current_run\n        else:\n            current_run = 0\n    return max_run"}
{"task_id": "Mbpp/804", "solution": "def is_product_even(nums):\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    The product is even if any number in the list is zero or an even number.\n    \"\"\"\n    for n in nums:\n        if n % 2 == 0:\n            return True\n    return False"}
{"task_id": "Mbpp/807", "solution": "def first_odd(numbers):\n    \"\"\"\n    Finds the first odd number in a list of numbers.\n    Integral float values are converted to int for the oddness check.\n    \"\"\"\n    for num in numbers:\n        try:\n            # For float numbers, check if they are integral and then their parity.\n            if num.is_integer():\n                if int(num) % 2 != 0:\n                    return int(num)\n        except AttributeError:\n            # If not a float (e.g., an int), check its parity directly.\n            if num % 2 != 0:\n                return num\n    return None"}
