{"task_id": "Mbpp/567", "solution": "from typing import Sequence, Optional, Callable, Any\ndef issort_list(seq: Sequence[Any], ascending: bool = True, key: Optional[Callable[[Any], Any]] = None) -> bool:\n    \"\"\"Checks if a sequence is sorted in the specified order.\"\"\"\n    def _compare_elements(a: Any, b: Any, is_ascending: bool) -> bool:\n        if is_ascending:\n            return a <= b\n        return a >= b\n\n    if key is None:\n        _key = lambda x: x\n    else:\n        _key = key\n\n    it = iter(seq)\n    try:\n        prev_raw = next(it)\n    except StopIteration:\n        return True\n\n    prev_val = _key(prev_raw)\n\n    for current_raw in it:\n        current_val = _key(current_raw)\n        if not _compare_elements(prev_val, current_val, ascending):\n            return False\n        prev_val = current_val\n    return True"}
{"task_id": "Mbpp/572", "solution": "import collections\ndef two_unique_nums(numbers):\n    \"\"\"\n    Returns a new list containing only the numbers that appear exactly once in the input list,\n    preserving their original first-seen order.\n    \"\"\"\n    counts = collections.Counter(numbers)\n    result = []\n    for num in numbers:\n        if counts[num] == 1:\n            result.append(num)\n    return result"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(list1, list2):\n    \"\"\"\n    Checks if list2 is a contiguous sublist (sub-array) of list1.\n    An empty list2 is considered a sublist of any list1.\n    \"\"\"\n    if list2 is None or list1 is None:\n        raise ValueError(\"Both list1 and list2 must be provided (not None).\")\n\n    if not isinstance(list1, list) or not isinstance(list2, list):\n        raise TypeError(\"Both list1 and list2 must be lists.\")\n\n    # Empty needle is a sublist by convention\n    if len(list2) == 0:\n        return True\n\n    n = len(list1)\n    m = len(list2)\n    if m > n:\n        return False\n\n    # Simple sliding window comparison (O(n*m) worst-case), appropriate for typical sizes.\n    # For large inputs, a KMP-based approach could be used for O(n + m).\n    for i in range(n - m + 1):\n        if list1[i:i + m] == list2:\n            return True\n    return False"}
