{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n: int) -> int:\n    \"\"\"\n    Computes the last digit of n! (n factorial).\n    For n >= 5, n! always ends in 0.\n    \"\"\"\n    def _small_factorial(k: int) -> int:\n        \"\"\"Computes the exact factorial for small non-negative integers.\"\"\"\n        result = 1\n        for i in range(2, k + 1):\n            result *= i\n        return result\n\n    # The core business rule: for any integer n >= 5, n! ends with 0.\n    if n >= 5:\n        return 0\n    else:\n        # For n < 5 (i.e., 0, 1, 2, 3, 4), compute factorial and find its last digit.\n        # We assume n is a non-negative integer based on the function signature and design context.\n        fact = _small_factorial(n)\n        return fact % 10"}
{"task_id": "Mbpp/573", "solution": "from typing import List, Iterable, Set, Any, Iterator, Optional\nclass ValidationError(ValueError):\n    \"\"\"Exception raised for invalid input data.\"\"\"\n    pass\nclass CalculationError(RuntimeError):\n    \"\"\"Exception raised for unexpected calculation failures.\"\"\"\n    pass\nclass NumbersCollection:\n    \"\"\"Represents a validated collection of integer values.\"\"\"\n    def __init__(self, values: List[int]) -> None:\n        self.values: List[int] = list(values)\n\n    def unique_values(self) -> Set[int]:\n        \"\"\"Returns a set of unique integer values from the collection.\"\"\"\n        return set(self.values)\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the collection of numbers is empty.\"\"\"\n        return len(self.values) == 0\n\n    def __iter__(self) -> Iterator[int]:\n        \"\"\"Returns an iterator over the original list of values.\"\"\"\n        return iter(self.values)\ndef validate_numbers(items: Iterable[Any]) -> List[int]:\n    \"\"\"Validates an iterable, ensuring all items are integers or convertible to integers.\"\"\"\n    result: List[int] = []\n    for i, v in enumerate(items):\n        if isinstance(v, int):\n            result.append(v)\n        elif isinstance(v, str):\n            s = v.strip()\n            if s == '':\n                raise ValidationError(f\"Empty string at position {i}\")\n            try:\n                result.append(int(s))\n            except ValueError:\n                raise ValidationError(f\"Invalid integer string at position {i}: {v!r}\")\n        else:\n            raise ValidationError(f\"Invalid type at position {i}: {type(v).__name__}\")\n    return result\nclass ListAdapter:\n    \"\"\"Adapts raw input iterables to a NumbersCollection, performing validation.\"\"\"\n    DEFAULT_SEPARATOR = ','\n\n    def adapt(self, iterable: Iterable[Any]) -> NumbersCollection:\n        \"\"\"Converts an iterable of any type into a validated NumbersCollection.\"\"\"\n        validated_list = validate_numbers(iterable)\n        return NumbersCollection(validated_list)\nclass UniqueProductService:\n    \"\"\"Provides the business logic for computing the product of unique numbers.\"\"\"\n    IDENTITY_PRODUCT = 1\n\n    def compute_product(self, collection: NumbersCollection) -> int:\n        \"\"\"Computes the multiplicative product of unique values in a NumbersCollection.\"\"\"\n        try:\n            unique_set = collection.unique_values()\n            if not unique_set:\n                return self.IDENTITY_PRODUCT\n            prod = 1\n            for v in unique_set:\n                prod *= v\n            return prod\n        except Exception as exc:\n            raise CalculationError(f\"Failed to compute product: {exc}\") from exc\nclass UniqueProductController:\n    \"\"\"Orchestrates input adaptation, product computation, and optional result storage.\"\"\"\n    def __init__(self, service: UniqueProductService, adapter: ListAdapter, repository: Optional[Any] = None) -> None:\n        self._service = service\n        self._adapter = adapter\n        self._repo = repository\n\n    def compute_from_list(self, values: Iterable[Any]) -> int:\n        \"\"\"Main entrypoint to compute the product of unique numbers from an iterable.\"\"\"\n        collection = self._adapter.adapt(values)\n        result = self._service.compute_product(collection)\n        if self._repo:\n            # Key generation based on sorted unique values for caching\n            key = ','.join(map(str, sorted(collection.unique_values())))\n            self._repo.save(key, result)\n        return result\ndef unique_product(numbers: List[int]) -> int:\n    \"\"\"\n    Computes the product of unique integer numbers in the provided list.\n    This function acts as a high-level facade to the core library components.\n    \"\"\"\n    service = UniqueProductService()\n    adapter = ListAdapter()\n    controller = UniqueProductController(service=service, adapter=adapter, repository=None)\n    result = controller.compute_from_list(numbers)\n    return result"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(a, b):\n    \"\"\"Finds elements present in only one of the two input tuples, preserving order and uniqueness.\"\"\"\n    set_a = set(a)\n    set_b = set(b)\n\n    left_items = []\n    seen_in_left_part = set()\n    for item in a:\n        if item not in set_b:\n            if item not in seen_in_left_part:\n                seen_in_left_part.add(item)\n                left_items.append(item)\n\n    right_items = []\n    seen_in_right_part = set()\n    for item in b:\n        if item not in set_a:\n            if item not in seen_in_right_part:\n                seen_in_right_part.add(item)\n                right_items.append(item)\n\n    return tuple(left_items + right_items)"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(a, b, c):\n    \"\"\"Interleave three sequences of equal length into a single flat list.\"\"\"\n    a_list = list(a)\n    b_list = list(b)\n    c_list = list(c)\n    if len(a_list) != len(b_list) or len(a_list) != len(c_list):\n        raise ValueError(\"All input lists must have the same length.\")\n    result = []\n    for i in range(len(a_list)):\n        result.append(a_list[i])\n        result.append(b_list[i])\n        result.append(c_list[i])\n    return result"}
{"task_id": "Mbpp/580", "solution": "from typing import Tuple, Any\ndef extract_even(data: Tuple[Any, ...]) -> Tuple[Any, ...]:\n    \"\"\"\n    Recursively extracts even integers from a nested tuple,\n    removing odd integers and any nested tuples that become empty.\n    \"\"\"\n    result = []\n    for el in data:\n        if isinstance(el, int):\n            if el % 2 == 0:\n                result.append(el)\n        elif isinstance(el, tuple):\n            nested_result = extract_even(el)\n            if nested_result:  # Only append if the nested tuple is not empty\n                result.append(nested_result)\n        # Other types are implicitly ignored as per prompt constraints\n        # \"Do NOT add isinstance() checks or raise exceptions for edge cases\"\n        # and the example implies only int and tuple elements.\n    return tuple(result)"}
{"task_id": "Mbpp/581", "solution": "def surface_Area(base_edge, height):\n    \"\"\"\n    Calculate the surface area of a square pyramid.\n    By default, 'height' is interpreted as the slant height.\n    Surface area = base area + lateral area = a^2 + 2*a*l\n    \"\"\"\n    base_area = base_edge * base_edge\n    lateral_area = 2.0 * base_edge * height\n    return base_area + lateral_area"}
{"task_id": "Mbpp/583", "solution": "def catalan_number(n: int, method: str = 'binomial') -> int:\n    \"\"\"\n    Computes the nth Catalan number using either dynamic programming or the binomial formula.\n\n    Args:\n        n: non-negative integer index of the Catalan number.\n        method: 'binomial' (default) or 'dp' to select the algorithm.\n\n    Returns:\n        The nth Catalan number as an int.\n\n    Raises:\n        TypeError if n is not an int.\n        ValueError if n is negative or method is unsupported.\n    \"\"\"\n\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    if method not in ('binomial', 'dp'):\n        raise ValueError(\"method must be 'binomial' or 'dp'\")\n\n    def _safe_comb(n_val: int, k_val: int) -> int:\n        \"\"\"\n        Calculates the binomial coefficient C(n_val, k_val) using an iterative multiplicative method.\n        This avoids large intermediate factorials and works for arbitrary precision.\n        \"\"\"\n        if k_val < 0 or k_val > n_val:\n            return 0\n        if k_val == 0 or k_val == n_val:\n            return 1\n        # Take advantage of symmetry C(n, k) = C(n, n-k)\n        if k_val > n_val // 2:\n            k_val = n_val - k_val\n\n        res = 1\n        for i in range(1, k_val + 1):\n            res = res * (n_val - k_val + i) // i\n        return res\n\n    def _catalan_dp(n_val: int) -> int:\n        \"\"\"\n        Computes the nth Catalan number using dynamic programming (O(n^2) time, O(n) space).\n        \"\"\"\n        if n_val == 0:\n            return 1\n        C = [0] * (n_val + 1)\n        C[0] = 1\n        for i in range(1, n_val + 1):\n            total = 0\n            for j in range(i):\n                total += C[j] * C[i - 1 - j]\n            C[i] = total\n        return C[n_val]\n\n    def _catalan_binomial(n_val: int) -> int:\n        \"\"\"\n        Computes the nth Catalan number using the binomial formula:\n            Catalan(n) = C(2n, n) // (n + 1)\n        \"\"\"\n        return _safe_comb(2 * n_val, n_val) // (n_val + 1)\n\n    if method == 'dp':\n        return _catalan_dp(n)\n    return _catalan_binomial(n)"}
{"task_id": "Mbpp/586", "solution": "def split_Arr(lst, n):\n    \"\"\"Splits a list at the nth element and moves the first part to the end.\n    This rotates the list such that elements from index n become the new start.\"\"\"\n    return lst[n:] + lst[:n]"}
{"task_id": "Mbpp/585", "solution": "def expensive_items(items, n):\n    \"\"\"\n    Return the n most expensive items from a list of dicts with 'price' keys.\n\n    Args:\n        items (list[dict]): Iterable of dicts, each containing a 'price' key with a numeric value.\n        n (int): Number of top items to return (must be >= 1).\n\n    Returns:\n        list[dict]: Up to n items sorted by price descending. Stable for ties (preserves input order).\n\n    Raises:\n        ValueError: If n < 1 or if an item is missing a numeric 'price'.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"n must be an integer >= 1\")\n\n    if not items:\n        return []\n\n    try:\n        # Use float(...) to accept ints and numeric strings; Python's sort is stable so ties preserve input order.\n        sorted_items = sorted(items, key=lambda it: float(it['price']), reverse=True)\n    except (KeyError, TypeError, ValueError) as e:\n        raise ValueError(\"Each item must have a numeric 'price' field\") from e\n\n    return sorted_items[:n]"}
