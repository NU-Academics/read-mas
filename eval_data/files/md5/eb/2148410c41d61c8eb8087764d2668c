{"task_id": "Mbpp/140", "solution": "def extract_singly(list_of_lists):\n    \"\"\"\n    Flattens a list of lists into a single set of numbers.\n    Each number from the inner iterables is added to a set, ensuring uniqueness.\n    \"\"\"\n    result_set = set()\n    for inner_iterable in list_of_lists:\n        for number in inner_iterable:\n            result_set.add(number)\n    return result_set"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(list1, list2, list3):\n    \"\"\"\n    Counts items that are identical in the same position across three lists.\n    The comparison is done up to the length of the shortest list.\n    \"\"\"\n    count = 0\n    min_len = min(len(list1), len(list2), len(list3))\n    for i in range(min_len):\n        if list1[i] == list2[i] == list3[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/138", "solution": "def is_Sum_Of_Powers_Of_Two(n: int) -> bool:\n    \"\"\"\n    Checks if a number can be represented as the sum of distinct non-zero powers of two.\n    This is true if n > 0 and its binary representation does not include 2^0 (i.e., n is even).\n    \"\"\"\n    return n > 0 and (n & 1) == 0"}
{"task_id": "Mbpp/145", "solution": "def max_Abs_Diff(data):\n    \"\"\"\n    Finds the maximum difference between any two elements in a given array.\n    This implementation assumes a non-empty sequence of numeric values.\n    \"\"\"\n    if data is None:\n        raise ValueError(\"Input is None\")\n    try:\n        if len(data) == 0:\n            raise ValueError(\"Input sequence is empty\")\n    except TypeError:\n        raise ValueError(\"Input is not a sized sequence\")\n\n    min_val = float(data[0])\n    max_val = float(data[0])\n\n    for x in data[1:]:\n        try:\n            val = float(x)\n        except (TypeError, ValueError):\n            raise ValueError(f\"Non-numeric element encountered: {x!r}\")\n        if val < min_val:\n            min_val = val\n        elif val > max_val:\n            max_val = val\n\n    return max_val - min_val"}
{"task_id": "Mbpp/141", "solution": "from typing import List, Any\ndef pancake_sort(data: List[Any]) -> List[Any]:\n    \"\"\"\n    Sorts a list of elements using the pancake sort algorithm.\n    \"\"\"\n    class SortError(Exception):\n        pass\n\n    class ValidationError(SortError):\n        pass\n\n    DEFAULT_MAX_FLIPS = 1000000\n    MIN_K = 1\n\n    def _flip(arr: List[Any], k: int) -> None:\n        if k < MIN_K or k > len(arr):\n            raise ValidationError(\"Invalid flip size for reverse operation.\")\n        arr[:k] = reversed(arr[:k])\n\n    def _find_max_index(arr: List[Any], n: int) -> int:\n        return max(range(n), key=lambda i: arr[i])\n\n    def _is_mutually_comparable(arr: List[Any]) -> bool:\n        try:\n            for i in range(min(5, len(arr)) - 1):\n                _ = arr[i] < arr[i+1]\n            return True\n        except Exception:\n            return False\n\n    arr = list(data)\n    n = len(arr)\n\n    if not _is_mutually_comparable(arr):\n        raise ValidationError(\"Elements in the list are not mutually comparable.\")\n\n    flips = 0\n    for curr_size in range(n, 1, -1):\n        max_idx = _find_max_index(arr, curr_size)\n        if max_idx != curr_size - 1:\n            _flip(arr, max_idx + 1)\n            flips += 1\n            _flip(arr, curr_size)\n            flips += 1\n        if flips > DEFAULT_MAX_FLIPS:\n            raise SortError(\"Exceeded flip limit during sorting, possibly due to comparator issues or data scale.\")\n\n    return arr"}
{"task_id": "Mbpp/161", "solution": "def remove_elements(source, remove):\n    \"\"\"\n    Removes all elements from the source list that are present in the remove list.\n    Preserves the relative order of the remaining elements.\n    \"\"\"\n    remove_set = set(remove)\n    result = []\n    for item in source:\n        if item not in remove_set:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(s: str) -> int:\n    \"\"\"\n    Counts characters in a string that match their 1-based English alphabet position (case-insensitive).\n    \"\"\"\n    count = 0\n    for i, char in enumerate(s):\n        # Convert character to lowercase for case-insensitive comparison\n        lower_char = char.lower()\n\n        # Check if the character is an English alphabet letter\n        if 'a' <= lower_char <= 'z':\n            # Calculate the 1-based alphabetical position (a=1, b=2, ...)\n            alphabet_pos = ord(lower_char) - ord('a') + 1\n\n            # Compare with the 1-based string position\n            string_pos = i + 1\n\n            if alphabet_pos == string_pos:\n                count += 1\n    return count"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the series (n - 2*i) for i from 0 to n // 2.\n    Example: for n=6, terms are 6, 4, 2, 0, sum is 12.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    # Number of terms in the series (including zero when present)\n    num_terms = n // 2 + 1\n\n    # First term is n, last term is n - 2 * (num_terms - 1) which simplifies to n - 2*(n//2)\n    first_term = n\n    last_term = n - 2 * (num_terms - 1)\n\n    # Sum of arithmetic progression: num_terms * (first + last) // 2\n    return num_terms * (first_term + last_term) // 2"}
{"task_id": "Mbpp/160", "solution": "def find_solution(a: int, b: int, n: int):\n    \"\"\"\n    Return a pair of integers (x, y) satisfying a*x + b*y = n, or None if no integer solution exists.\n    \"\"\"\n    import math\n\n    if not isinstance(a, int) or not isinstance(b, int) or not isinstance(n, int):\n        raise TypeError(\"a, b, and n must be integers\")\n\n    # trivial cases\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n    if a == 0:\n        return (0, n // b) if b != 0 and n % b == 0 else None\n    if b == 0:\n        return (n // a, 0) if a != 0 and n % a == 0 else None\n\n    def _egcd(x: int, y: int):\n        # returns (g, u, v) such that x*u + y*v = g where g = gcd(x, y)\n        old_r, r = x, y\n        old_s, s = 1, 0\n        old_t, t = 0, 1\n        while r != 0:\n            q = old_r // r\n            old_r, r = r, old_r - q * r\n            old_s, s = s, old_s - q * s\n            old_t, t = t, old_t - q * t\n        return old_r, old_s, old_t\n\n    def _modinv(x: int, m: int):\n        g, u, _ = _egcd(x, m)\n        if g != 1:\n            raise ValueError(\"modular inverse does not exist\")\n        return u % m\n\n    g = math.gcd(a, b)\n    if n % g != 0:\n        return None\n\n    a1 = a // g\n    b1 = b // g\n    n1 = n // g\n\n    # Find particular solution with x in 0..|b1|-1:\n    m = abs(b1)\n    # b1 != 0 here (handled earlier), so m > 0\n    inv_a = _modinv(a1 % m, m)\n    x0 = (n1 * inv_a) % m\n    # compute corresponding y exactly\n    y0 = (n - a * x0) // b\n\n    return (x0, y0)"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(numbers: list) -> int:\n    \"\"\"\n    Counts the number of pairs of integers in a list that XOR to an even number.\n    A pair XORs to an even number iff both integers have the same parity.\n    \"\"\"\n    n_even = 0\n    n_odd = 0\n\n    for num in numbers:\n        if (num & 1) == 0:\n            n_even += 1\n        else:\n            n_odd += 1\n\n    return (n_even * (n_even - 1) // 2) + (n_odd * (n_odd - 1) // 2)"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"Finds the smallest power of 2 greater than or equal to n.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    if n <= 1:\n        return 1\n    # For n > 1, the next power of 2 is 1 shifted left by bit_length(n - 1)\n    return 1 << (n - 1).bit_length()"}
{"task_id": "Mbpp/168", "solution": "def frequency(items, target):\n    \"\"\"\n    Counts the number of occurrences of a number in a given list, handling numeric string conversions.\n    Values like 2 and 2.0 are considered equal.\n    \"\"\"\n    def _normalize_numeric_value(value):\n        \"\"\"Normalizes a value to an int or float if it's numeric, handling string representations.\n        If conversion fails, the original value is returned to avoid raising exceptions.\"\"\"\n        if isinstance(value, (int, float)):\n            return value\n        if isinstance(value, str):\n            try:\n                # Prioritize float conversion if it looks like a float, otherwise int\n                if '.' in value or 'e' in value.lower():\n                    return float(value)\n                else:\n                    return int(value)\n            except (ValueError, TypeError):\n                # If string conversion fails, return original value.\n                return value\n        return value\n\n    normalized_target = _normalize_numeric_value(target)\n    count = 0\n    for item in items:\n        normalized_item = _normalize_numeric_value(item)\n        if normalized_item == normalized_target:\n            count += 1\n    return count"}
