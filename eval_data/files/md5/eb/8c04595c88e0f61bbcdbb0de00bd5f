ers.append(x)\n        elif x > 0:\n            positive_numbers.append(x)\n\n    if negative_numbers:\n        largest_neg = max(negative_numbers)\n\n    if positive_numbers:\n        smallest_pos = min(positive_numbers)\n\n    return (largest_neg, smallest_pos)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/138": [{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers.\n    Example\n    is_equal_to_sum_even(4) == False\n    is_equal_to_sum_even(6) == False\n    is_equal_to_sum_even(8) == True\n    \"\"\"\n    # A sum of four positive even numbers must be at least 2 + 2 + 2 + 2 = 8.\n    if n < 8:\n        return False\n\n    # The sum of four even numbers must always be an even number.\n    if n % 2 != 0:\n        return False\n\n    # If n is even and greater than or equal to 8, it can always be expressed as 2 + 2 + 2 + (n-6).\n    # Since n is even and >= 8, (n-6) will be a positive even number (>= 2).\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/137": [{"task_id": "HumanEval/137", "solution": "from typing import Union, Any, Type, Tuple\ndef compare_one(a: Union[int, float, str], b: Union[int, float, str]) -> Union[int, float, str, None]:\n    \"\"\"\n    Compares two input values (integers, floats, or strings representing real numbers)\n    and returns the larger variable in its given variable type. Returns None if the values are equal.\n    \"\"\"\n    def _convert_to_numeric(value: Union[int, float, str]) -> Tuple[float, Any, Type]:\n        \"\"\"\n        Converts an input value to a float for comparison, returning the float,\n        the original value, and its original type.\n        \"\"\"\n        original_type = type(value)\n        original_value = value\n\n        if isinstance(value, str):\n            s_value = value.replace(',', '.')\n            numeric_value = float(s_value)\n        else:\n            numeric_value = float(value)\n\n        return numeric_value, original_value, original_type\n\n    numeric_a, original_a, type_a = _convert_to_numeric(a)\n    numeric_b, original_b, type_b = _convert_to_numeric(b)\n\n    if numeric_a > numeric_b:\n        return original_a\n    elif numeric_b > numeric_a:\n        return original_b\n    else:\n        return None", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/140": [{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores, \n    and if a string has more than 2 consecutive spaces, \n    then replace all consecutive spaces with - \n    \n    fix_spaces(\"Example\") == \"Example\"\n    fix_spaces(\"Example 1\") == \"Example_1\"\n    fix_spaces(\" Example 2\") == \"_Example_2\"\n    fix_spaces(\" Example   3\") == \"_Example-3\"\n    \"\"\"\n    # Replace sequences of more than two spaces with a single hyphen first.\n    # This ensures longer sequences are processed before individual spaces.\n    processed_text = re.sub(r' {3,}', '-', text)\n\n    # Replace any remaining single spaces (including '  ' becoming '__') with underscores.\n    processed_text = processed_text.replace(' ', '_')\n\n    return processed_text", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/142": [{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a \n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not \n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries. \n    \n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    total_sum = 0\n    for i, num in enumerate(lst):\n        if i % 3 == 0:\n            total_sum += num * num\n        elif i % 4 == 0:  # This condition ensures it's a multiple of 4 and not 3, due to the 'elif'.\n            total_sum += num * num * num\n        else:\n            total_sum += num\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/141": [{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions \n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n    - The file's name contains exactly one dot '.'\n    - The substring before the dot should not be empty, and it starts with a letter from \n    the latin alphapet ('a'-'z' and 'A'-'Z').\n    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    Examples:\n    file_name_check(\"example.txt\") # => 'Yes'\n    file_name_check(\"1example.dll\") # => 'No' (the name should start with a latin alphapet letter)\n    \"\"\"\n\n    class FileName:\n        \"\"\"Encapsulates a file name string and provides access to its parsed components.\"\"\"\n        def __init__(self, full_name: str):\n            self._full_name = full_name\n            parts = full_name.rsplit('.', 1)\n            if len(parts) == 2:\n                self._name_part = parts[0]\n                self._extension_part = parts[1]\n            else:\n                self._name_part = full_name\n                self._extension_part = \"\"\n\n        def get_full_name(self) -> str:\n            return self._full_name\n\n        def get_name_part(self) -> str:\n            return self._name_part\n\n        def get_extension_part(self) -> str:\n            return self._extension_part\n\n    class FileNameValidator:\n        \"\"\"Contains all specific validation logic for a FileName object.\"\"\"\n        @staticmethod\n        def _check_digit_count(full_name: str) -> bool:\n            digit_count = sum(1 for char in full_name if '0' <= char <= '9')\n            return digit_count <= 3\n\n        @staticmethod\n        def _check_single_dot(full_name: str) -> bool:\n            return full_name.count('.') == 1\n\n        @staticmethod\n        def _check_non_empty_name_part(name_part: str) -> bool:\n            return bool(name_part)\n\n        @staticmethod\n        def _check_name_part_starts_with_letter(name_part: str) -> bool:\n            if not name_part:\n                return False\n            first_char = name_part[0]\n            return ('a' <= first_char <= 'z') or ('A' <= first_char <= 'Z')\n\n        @staticmethod\n        def _check_valid_extension(extension_part: str) -> bool:\n            return extension_part in ['txt', 'exe', 'dll']\n\n        @staticmethod\n        def is_valid(file_name_obj: FileName) -> bool:\n            full_name = file_name_obj.get_full_name()\n            name_part = file_name_obj.get_name_part()\n            extension_part = file_name_obj.get_extension_part()\n\n            if not FileNameValidator._check_digit_count(full_name):\n                return False\n            if not FileNameValidator._check_single_dot(full_name):\n                return False\n            if not FileNameValidator._check_non_empty_name_part(name_part):\n                return False\n            if not FileNameValidator._check_name_part_starts_with_letter(name_part):\n                return False\n            if not FileNameValidator._check_valid_extension(extension_part):\n                return False\n            return True\n\n    file_name_obj = FileName(file_name)\n    if FileNameValidator.is_valid(file_name_obj):\n        return 'Yes'\n    else:\n        return 'No'", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["\u00e9xample.exe"]]}], "HumanEval/143": [{"task_id": "HumanEval/143", "solution": "def _is_prime(n):\n    \"\"\"\n    Checks if a given integer is a prime number.\n    A prime number is a natural number greater than 1 that has no positive divisors other than 1 and itself.\n    \"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\ndef words_in_sentence(sentence):\n    \"\"\"\n    Filters words from a sentence, returning those whose lengths are prime numbers.\n    The order of the words in the new string is preserved.\n    \"\"\"\n    words = sentence.split()\n    filtered_words = []\n    \n    for word in words:\n        if _is_prime(len(word)):\n            filtered_words.append(word)\n            \n    return \" \".join(filtered_words)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/145": [{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts the given list of integers in ascending order according to the sum of their digits.\n    If sums are equal, order them based on their original index in the input list.\n    \"\"\"\n\n    class _IntegerWrapper:\n        \"\"\"Helper class to encapsulate an integer's value, original index, and calculated sum of digits.\"\"\"\n        def __init__(self, value: int, original_index: int):\n            self.value = value\n            self.original_index = original_index\n            self.sum_of_digits = self._calculate_sum_of_digits(value)\n\n        def _calculate_sum_of_digits(self, number: int) -> int:\n            \"\"\"Calculates the sum of the absolute values of a number's digits.\"\"\"\n            s = 0\n            number = abs(number)\n            if number == 0:\n                return 0\n            while number > 0:\n                s += number % 10\n                number //= 10\n            return s\n\n        def __lt__(self, other) -> bool:\n            \"\"\"Compares based on sum of digits (ascending) then original index (ascending) for ties.\"\"\"\n            if self.sum_of_digits != other.sum_of_digits:\n                return self.sum_of_digits < other.sum_of_digits\n            return self.original_index < other.original_index\n\n        def get_value(self) -> int:\n            \"\"\"Returns the original integer value stored in the wrapper.\"\"\"\n            return self.value\n\n    if not nums:\n        return []\n\n    wrapped_nums = []\n    for i, num in enumerate(nums):\n        wrapped_nums.append(_IntegerWrapper(num, i))\n\n    wrapped_nums.sort()\n\n    return [wrapper.get_value() for wrapper in wrapped_nums]", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, 11, -1, -11, -12]]], "plus_fail_tests": [[[-5, -12, 9, 15]]]}], "HumanEval/144": [{"task_id": "HumanEval/144", "solution": "class Fraction:\n    \"\"\"\n    Represents a fraction with a numerator and a denominator.\n    \"\"\"\n    def __init__(self, numerator: int, denominator: int):\n        self._numerator = numerator\n        self._denominator = denominator\n\n    @property\n    def numerator(self) -> int:\n        return self._numerator\n\n    @property\n    def denominator(self) -> int:\n        return self._denominator\n\n    @classmethod\n    def from_string(cls, fraction_string: str) -> 'Fraction':\n        \"\"\"\n        Parses a string in \"<numerator>/<denominator>\" format into a Fraction object.\n        \"\"\"\n        parts = fraction_string.split('/')\n        numerator = int(parts[0])\n        denominator = int(parts[1])\n        return cls(numerator, denominator)\n\n    def multiply(self, other: 'Fraction') -> 'Fraction':\n        \"\"\"\n        Multiplies this fraction by another fraction and returns a new Fraction object.\n        \"\"\"\n        new_numerator = self.numerator * other.numerator\n        new_denominator = self.denominator * other.denominator\n        return Fraction(new_numerator, new_denominator)\n\n    def is_whole_number(self) -> bool:\n        \"\"\"\n        Determines if the fraction represents a whole number.\n        \"\"\"\n        return self.numerator % self.denominator == 0\ndef simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n    \"\"\"\n    fraction_x = Fraction.from_string(x)\n    fraction_n = Fraction.from_string(n)\n\n    product_fraction = fraction_x.multiply(fraction_n)\n\n    return product_fraction.is_whole_number()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/39": [{"task_id": "HumanEval/39", "solution": "import math\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    def is_prime(num: int) -> bool:\n        \"\"\"\n        Checks if a number is prime.\n        \"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        # Check for odd divisors up to the square root of num.\n        for i in range(3, int(math.sqrt(num)) + 1, 2):\n            if num % i == 0:\n                return False\n        return True\n\n    a, b = 0, 1\n    prime_fib_count = 0\n\n    while True:\n        fib_num = a + b\n        a = b\n        b = fib_num\n\n        if is_prime(fib_num):\n            prime_fib_count += 1\n            if prime_fib_count == n:\n                return fib_num", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[12]]}], "HumanEval/146": [{"task_id": "HumanEval/146", "solution": "def _is_odd(digit: int) -> bool:\n    \"\"\"Checks if a single digit is odd.\"\"\"\n    return digit in (1, 3, 5, 7, 9)\ndef _is_greater_than_ten(num: int) -> bool:\n    \"\"\"Checks if a number is strictly greater than 10.\"\"\"\n    return num > 10\ndef _has_odd_first_digit(num: int) -> bool:\n    \"\"\"Extracts the first digit (absolute value) of a number and checks if it's odd.\"\"\"\n    abs_num_str = str(abs(num))\n    first_digit = int(abs_num_str[0])\n    return _is_odd(first_digit)\ndef _has_odd_last_digit(num: int) -> bool:\n    \"\"\"Extracts the last digit (absolute value) of a number and checks if it's odd.\"\"\"\n    abs_num_str = str(abs(num))\n    last_digit = int(abs_num_str[-1])\n    return _is_odd(last_digit)\ndef specialFilter(nums):\n    \"\"\"Write a function that takes an array of numbers as input and returns \n    the number of elements in the array that are greater than 10 and both \n    first and last digits of a number are odd (1, 3, 5, 7, 9).\n    For example:\n    specialFilter([15, -73, 14, -15]) => 1 \n    specialFilter([33, -2, -3, 45, 21, 109]) => 2\n    \"\"\"\n    special_count = 0\n    for num in nums:\n        if _is_greater_than_ten(num) and \\\n           _has_odd_first_digit(num) and \\\n           _has_odd_last_digit(num):\n            special_count += 1\n    return special_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/150": [{"task_id": "HumanEval/150", "solution": "def x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n\n    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n    \n    \"\"\"\n    def is_prime(num):\n        \"\"\"Checks if a number is prime.\"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    if is_prime(n):\n        return x\n    else:\n        return y", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/149": [{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Filters a list of strings to remove odd-length strings and then sorts\n    the remaining strings by length (ascending) and alphabetically (ascending)\n    for strings of the same length.\n    \"\"\"\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n    sorted_result = sorted(even_length_strings, key=lambda s: (len(s), s))\n    return sorted_result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/148": [{"task_id": "HumanEval/148", "solution": "from typing import List, Dict, Optional, Tuple\nclass Planet:\n    def __init__(self, name: str, orbital_order: int):\n        self.name = name\n        self.orbital_order = orbital_order\n\n    def __repr__(self) -> str:\n        return f\"Planet('{self.name}', {self.orbital_order})\"\nclass SolarSystem:\n    _planets_data = [\n        (\"Mercury\", 1),\n        (\"Venus\", 2),\n        (\"Earth\", 3),\n        (\"Mars\", 4),\n        (\"Jupiter\", 5),\n        (\"Saturn\", 6),\n        (\"Uranus\", 7),\n        (\"Neptune\", 8),\n    ]\n\n    def __init__(self):\n        self._planets_by_name: Dict[str, Planet] = {}\n        self._planets_by_order: List[Planet] = []\n        for name, order in self._planets_data:\n            planet = Planet(name, order)\n            self._planets_by_name[name] = planet\n            self._planets_by_order.append(planet)\n        self._planets_by_order.sort(key=lambda p: p.orbital_order)\n\n    def get_planet_by_name(self, name: str) -> Optional[Planet]:\n        return self._planets_by_name.get(name)\n\n    def get_planets_between_orders(self, start_order: int, end_order: int) -> Tuple[Planet, ...]:\n        if start_order > end_order:\n            start_order, end_order = end_order, start_order\n\n        between_planets: List[Planet] = []\n        for planet in self._planets_by_order:\n            if start_order < planet.orbital_order < end_order:\n                between_planets.append(planet)\n        return tuple(between_planets)\n_solar_system = SolarSystem()\ndef bf(planet1, planet2):\n    '''\n    Finds planets whose orbits are located between the orbit of planet1 and planet2.\n    Returns a tuple of planet names, sorted by proximity to the Sun.\n    Returns an empty tuple if planet1 or planet2 are not correct planet names.\n    '''\n    p1 = _solar_system.get_planet_by_name(planet1)\n    p2 = _solar_system.get_planet_by_name(planet2)\n\n    if p1 is None or p2 is None:\n        return ()\n\n    intermediate_planets = _solar_system.get_planets_between_orders(p1.orbital_order, p2.orbital_order)\n\n    return tuple(p.name for p in intermediate_planets)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/153": [{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"\n    Finds the strongest extension based on the number of uppercase and lowercase letters.\n    Returns the class name concatenated with the strongest extension name.\n    \"\"\"\n\n    class Extension:\n        \"\"\"Helper class to encapsulate extension name and calculate its strength.\"\"\"\n        def __init__(self, name: str):\n            self.name = name\n            self._strength = self._calculate_strength()\n\n        def get_strength(self) -> int:\n            \"\"\"Returns the pre-calculated strength of the extension.\"\"\"\n            return self._strength\n\n        def _calculate_strength(self) -> int:\n            \"\"\"Calculates strength as (CAP - SM) where CAP is uppercase and SM is lowercase count.\"\"\"\n            cap_count = sum(1 for char in self.name if 'A' <= char <= 'Z')\n            sm_count = sum(1 for char in self.name if 'a' <= char <= 'z')\n            return cap_count - sm_count\n\n    if not extensions:\n        return \"\"\n\n    max_strength = float('-inf')\n    strongest_extension_name = \"\"\n\n    for ext_name in extensions:\n        current_extension = Extension(ext_name)\n        current_strength = current_extension.get_strength()\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = ext_name\n\n    return f\"{class_name}.{strongest_extension_name}\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/152": [{"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"I think we all remember that feeling when the result of some long-awaited\n    event is finally known. The feelings and thoughts you have at that moment are\n    definitely worth noting down and comparing.\n    Your task is to determine if a person correctly guessed the results of a number of matches.\n    You are given two arrays of scores and guesses of equal length, where each index shows a match. \n    Return an array of the same length denoting how far off each guess was. If they have guessed correctly,\n    the value is 0, and if not, the value is the absolute difference between the guess and the score.\n    \n    \n    example:\n\n    compare([1,2,3,4,5,1],[1,2,3,4,2,-2]) -> [0,0,0,0,3,3]\n    compare([0,5,0,0,0,4],[4,1,1,0,0,-2]) -> [4,4,1,0,0,6]\n    \"\"\"\n    differences = []\n    # Iterate through each match to calculate the difference.\n    for i in range(len(game)):\n        game_score = game[i]\n        player_guess = guess[i]\n        if game_score == player_guess:\n            differences.append(0)\n        else:\n            differences.append(abs(game_score - player_guess))\n    return differences", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/151": [{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    \"\"\"\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    \"\"\"\n    total_sum_of_squares = 0\n    for x in lst:\n        # Check if the number is non-negative and integer-valued (e.g., 3.0 is integer-valued, 3.5 is not).\n        # This handles filtering non-integers without using isinstance or explicit exception handling.\n        if x >= 0 and x % 1 == 0:\n            int_val = int(x)\n            # Check if the integer value is odd.\n            if int_val % 2 != 0:\n                total_sum_of_squares += int_val * int_val\n    return total_sum_of_squares", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[1.0, 3.5, -4.6]]]}], "HumanEval/154": [{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"Checks if the second word or any of its rotations is a substring in the first word.\"\"\"\n    if not b: # An empty string is a substring of any string.\n        return True\n    \n    # Concatenate b with itself to easily generate all cyclic rotations by taking slices.\n    b_double = b + b\n    \n    # Iterate through all possible starting points for a rotation.\n    for i in range(len(b)):\