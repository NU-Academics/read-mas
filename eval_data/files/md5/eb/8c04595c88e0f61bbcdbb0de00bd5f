 \"\"\"Represents a word segment, providing functionality to sort its characters.\"\"\"\n    def __init__(self, value: str):\n        super().__init__(value, True)\n\n    def get_sorted_value(self) -> str:\n        return ''.join(sorted(self.value))\nclass SpaceToken(Token):\n    \"\"\"Represents a sequence of space characters, preserving its original form.\"\"\"\n    def __init__(self, value: str):\n        super().__init__(value, False)\n\n    def get_value(self) -> str:\n        return self.value\ndef _split_into_tokens(s: str) -> list[Token]:\n    \"\"\"Splits the input string into a list of WordToken and SpaceToken objects.\"\"\"\n    tokens = []\n    i = 0\n    n = len(s)\n    while i < n:\n        if s[i].isspace():\n            j = i\n            while j < n and s[j].isspace():\n                j += 1\n            tokens.append(SpaceToken(s[i:j]))\n            i = j\n        else: # not a space\n            j = i\n            while j < n and not s[j].isspace():\n                j += 1\n            tokens.append(WordToken(s[i:j]))\n            i = j\n    return tokens\ndef _reconstruct_from_tokens(parts: list[str]) -> str:\n    \"\"\"Concatenates a list of string parts back into a single string.\"\"\"\n    return ''.join(parts)\ndef anti_shuffle(s):\n    \"\"\"\n    Write a function that takes a string and returns an ordered version of it.\n    Ordered version of string, is a string where all words (separated by space)\n    are replaced by a new word where all the characters arranged in\n    ascending order based on ascii value.\n    Note: You should keep the order of words and blank spaces in the sentence.\n\n    For example:\n    anti_shuffle('Hi') returns 'Hi'\n    anti_shuffle('hello') returns 'ehllo'\n    anti_shuffle('Hello World!!!') returns 'Hello !!!Wdlor'\n    \"\"\"\n    tokens = _split_into_tokens(s)\n    processed_parts = []\n    for token in tokens:\n        if token.is_word:\n            processed_parts.append(token.get_sorted_value())\n       