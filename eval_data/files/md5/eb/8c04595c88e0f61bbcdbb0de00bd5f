              return False\n            i += 2\n        return True\n\n    # Helper function to get all prime factors of a number, including duplicates.\n    # This implementation efficiently finds all prime factors without needing to call _is_prime on 'd'.\n    def _get_prime_factors(n):\n        factors = []\n        d = 2\n        temp_n = n\n        while d * d <= temp_n:\n            while temp_n % d == 0:\n                factors.append(d)\n                temp_n //= d\n            d += 1 if d == 2 else 2 # Increment d: 2 -> 3, then 3 -> 5, 5 -> 7 etc.\n        if temp_n > 1: # If temp_n is still greater than 1, it's the remaining prime factor\n            factors.append(temp_n)\n        return factors\n\n    # The smallest product of 3 prime numbers (e.g., 2*2*2 = 8).\n    # Any number less than 8 cannot be a product of three primes.\n    if a < 2: \n        return False\n\n    prime_factors = _get_prime_factors(a)\n    return len(prime_factors) == 3", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/77": [{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    '''\n    Write a function that takes an integer a and returns True\n    if this ingeger is a cube of some integer number.\n    '''\n    import math\n\n    if a == 0:\n        return True\n\n    # Calculate the cube root using math.cbrt, which handles negative numbers correctly.\n    cbrt_val = math.cbrt(a)\n    \n    # Round the float cube root to the nearest integer.\n    rounded_cbrt = round(cbrt_val)\n    \n    # Check if the cube of the rounded integer equals the original number.\n    # int() is used to ensure comparison is between integers, mitigating float precision issues.\n    return int(rounded_cbrt**3) == a", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/74": [{"task_id": "HumanEval/74", "solution": "def total_match(lst1, lst2):\n    '''\n    Calculates the total number of c