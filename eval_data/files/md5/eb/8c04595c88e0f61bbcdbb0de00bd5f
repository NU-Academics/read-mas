 numeral in sorted(roman_map.items(), reverse=True):\n        # Append the numeral repeatedly as long as the number is greater than or equal to its value.\n        while number >= value:\n            result.append(numeral)\n            number -= value\n            \n    # Join the collected numerals and convert the final string to lowercase.\n    return \"\".join(result).lower()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/157": [{"task_id": "HumanEval/157", "solution": "import math\nclass Triangle:\n    \"\"\"\n    Represents a triangle with three side lengths and provides functionality\n    to determine if it is a right-angled triangle.\n    \"\"\"\n    def __init__(self, a: float, b: float, c: float):\n        \"\"\"\n        Initializes a Triangle object with three side lengths.\n        These lengths are stored for later right-angle validation.\n        \"\"\"\n        self._sideA = a\n        self._sideB = b\n        self._sideC = c\n\n    def isRightAngled(self) -> bool:\n        \"\"\"\n        Determines if the triangle is a right-angled triangle using the\n        Pythagorean theorem (a^2 + b^2 = c^2), considering float precision.\n        \"\"\"\n        sides = sorted([self._sideA, self._sideB, self._sideC])\n        a_sq = sides[0] ** 2\n        b_sq = sides[1] ** 2\n        c_sq = sides[2] ** 2\n\n        return math.isclose(a_sq + b_sq, c_sq, rel_tol=1e-9, abs_tol=0.0)\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or \n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    triangle = Triangle(a, b, c)\n    return triangle.isRightAngled()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/161": [{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa, \n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    Examples\n    solve(\"1234\") = \"4321\"\n    solve(\"ab\") = \"AB\"\n    solve(\"#a@C\") = \"#A@c\"\n    \"\"\"\n    def _is_letter(char):\n        return char.isalpha()\n\n    def _reverse_case(char):\n        if char.islower():\n            return char.upper()\n        elif char.isupper():\n            return char.lower()\n        return char\n\n    def _has_letters(s):\n        return any(_is_letter(char) for char in s)\n\n    def _reverse_string(s):\n        return s[::-1]\n\n    def _process_characters(s):\n        processed_chars = []\n        for char in s:\n            if _is_letter(char):\n                processed_chars.append(_reverse_case(char))\n            else:\n                processed_chars.append(char)\n        return \"\".join(processed_chars)\n\n    if _has_letters(s):\n        return _process_characters(s)\n    else:\n        return _reverse_string(s)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/158": [{"task_id": "HumanEval/158", "solution": "from typing import List\nclass Word:\n    \"\"\"\n    Represents a single word, calculates and stores its unique character count,\n    and provides comparison logic for lexicographical order.\n    \"\"\"\n    def __init__(self, value: str):\n        self._value = value\n        self._unique_char_count = self._calculate_unique_char_count()\n\n    def _calculate_unique_char_count(self) -> int:\n        \"\"\"Calculates the number of unique characters in the word.\"\"\"\n        return len(set(self._value))\n\n    def get_value(self) -> str:\n        \"\"\"Returns the string value of the word.\"\"\"\n        return self._value\n\n    def get_unique_char_count(self) -> int:\n        \"\"\"Returns the pre-calculated unique character count.\"\"\"\n        return self._unique_char_count\n\n    def __lt__(self, other: 'Word') -> bool:\n        \"\"\"Compares two Word objects for lexicographical order.\"\"\"\n        return self._value < other._value\n\n    def __eq__(self, other: object) -> bool:\n        \"\"\"Checks for equality based on value.\"\"\"\n        if not isinstance(other, Word):\n            return NotImplemented\n        return self._value == other._value\n\n    def __hash__(self) -> int:\n        \"\"\"Returns hash for set/dict usage.\"\"\"\n        return hash(self._value)\nclass WordList:\n    \"\"\"\n    Manages a collection of Word objects and orchestrates the process of finding\n    the word with the maximum unique characters, handling ties.\n    \"\"\"\n    def __init__(self, raw_words: List[str]):\n        self._words: List[Word] = [Word(word) for word in raw_words]\n\n    def find_max_unique_char_word(self) -> str:\n        \"\"\"\n        Identifies the word with the maximum number of unique characters,\n        resolving ties by selecting the lexicographically smallest word.\n        \"\"\"\n        if not self._words:\n            return \"\"\n\n        max_word: Word = self._words[0]\n\n        for i in range(1, len(self._words)):\n            current_word = self._words[i]\n\n            if current_word.get_unique_char_count() > max_word.get_unique_char_count():\n                max_word = current_word\n            elif current_word.get_unique_char_count() == max_word.get_unique_char_count():\n                if current_word < max_word:\n                    max_word = current_word\n\n        return max_word.get_value()\ndef find_max(words: List[str]) -> str:\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n    \"\"\"\n    word_list_processor = WordList(words)\n    return word_list_processor.find_max_unique_char_word()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/15": [{"task_id": "HumanEval/15", "solution": "def string_sequence(n: int) -> str:\n    \"\"\" Return a string containing space-delimited numbers starting from 0 upto n inclusive.\n    The numbers are converted to strings and then joined by a single space.\n    \"\"\"\n    numbers_as_strings = [str(i) for i in range(n + 1)]\n    return ' '.join(numbers_as_strings)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/159": [{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    You're a hungry rabbit, and you already have eaten a certain number of carrots,\n    but now you need to eat more carrots to complete the day's meals.\n    you should return an array of [ total number of eaten carrots after your meals,\n                                    the number of carrots left after your meals ]\n    if there are not enough remaining carrots, you will eat all remaining carrots, but will still be hungry.\n    \n    Example:\n    * eat(5, 6, 10) -> [11, 4]\n    * eat(4, 8, 9) -> [12, 1]\n    * eat(1, 10, 10) -> [11, 0]\n    * eat(2, 11, 5) -> [7, 0]\n    \n    Variables:\n    @number : integer\n        the number of carrots that you have eaten.\n    @need : integer\n        the number of carrots that you need to eat.\n    @remaining : integer\n        the number of remaining carrots thet exist in stock\n    \n    Constrain:\n    * 0 <= number <= 1000\n    * 0 <= need <= 1000\n    * 0 <= remaining <= 1000\n\n    Have fun :)\n    \"\"\"\n    carrots_eaten_this_meal = min(need, remaining)\n    total_carrots_eaten = number + carrots_eaten_this_meal\n    carrots_left_in_stock = remaining - carrots_eaten_this_meal\n    \n    return [total_carrots_eaten, carrots_left_in_stock]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/160": [{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and \n    the second list is a list of integers. Use the two given lists to build the algebric \n    expression and return the evaluation of this expression.\n    \"\"\"\n    # Build the algebraic expression string by interleaving operands and operators.\n    expression_parts = []\n    expression_parts.append(str(operand[0]))\n    for i in range(len(operator)):\n        expression_parts.append(operator[i])\n        expression_parts.append(str(operand[i + 1]))\n    \n    expression_string = \" \".join(expression_parts)\n    \n    # Evaluate the expression string.\n    result = eval(expression_string)\n    \n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/162": [{"task_id": "HumanEval/162", "solution": "def string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    import hashlib\n\n    if not text:\n        return None\n    \n    # Encode the string to bytes before hashing, typically using 'utf-8'.\n    md5_hash = hashlib.md5(text.encode('utf-8')).hexdigest()\n    return md5_hash", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/123": [{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    \"\"\"\n\n    def _is_odd(num):\n        \"\"\"Helper to check if a number is odd.\"\"\"\n        return num % 2 != 0\n\n    def _calculate_next_collatz_term(num):\n        \"\"\"Helper to calculate the next term in the Collatz sequence.\"\"\"\n        if num % 2 == 0:\n            return num // 2\n        else:\n            return 3 * num + 1\n\n    odd_numbers_set = set()\n    current_number = n\n\n    while current_number != 1:\n        if _is_odd(current_number):\n            odd_numbers_set.add(current_number)\n        current_number = _calculate_next_collatz_term(current_number)\n\n    odd_numbers_set.add(1) # Ensure 1 is always included as it's the sequence end and is odd.\n\n    result = list(odd_numbers_set)\n    result.sort()\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/94": [{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"Finds the largest prime in a list and returns the sum of its digits, or 0 if no prime is found.\"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if a number is prime.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    def sum_digits(n: int) -> int:\n        \"\"\"Calculates the sum of the absolute value of a number's digits.\"\"\"\n        s = 0\n        # For prime numbers, n will always be positive.\n        for digit_char in str(n):\n            s += int(digit_char)\n        return s\n\n    def find_largest_prime(numbers: list[int]) -> int | None:\n        \"\"\"Identifies the largest prime number in a list.\"\"\"\n        largest_p = None\n        for num in numbers:\n            if is_prime(num):\n                if largest_p is None or num > largest_p:\n                    largest_p = num\n        return largest_p\n\n    largest_prime_found = find_largest_prime(lst)\n\n    if largest_prime_found is not None:\n        return sum_digits(largest_prime_found)\n    else:\n        return 0", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/147": [{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) of a where i < j < k, \n    and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n\n    def _generate_array_elements(length):\n        \"\"\"Generates the array a where a[i] = i * i - i + 1 for 1-based index i.\"\"\"\n        arr = []\n        for i in range(1, length + 1):\n            arr.append(i * i - i + 1)\n        return arr\n\n    def _count_valid_triples(arr_elements):\n        \"\"\"Counts triples (arr[i], arr[j], arr[k]) where i < j < k and their sum is a multiple of 3.\"\"\"\n        count = 0\n        arr_len = len(arr_elements)\n        # Iterate through all possible combinations of three distinct indices\n        for i in range(arr_len):\n            for j in range(i + 1, arr_len):\n                for k in range(j + 1, arr_len):\n                    # Check if the sum of elements at these indices is a multiple of 3\n                    if (arr_elements[i] + arr_elements[j] + arr_elements[k]) % 3 == 0:\n                        count += 1\n        return count\n\n    # Orchestrate the process: generate array and then count valid triples\n    a = _generate_array_elements(n)\n    result = _count_valid_triples(a)\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/129": [{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k, \n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n\n    Examples:\n\n        Input: grid = [ [1,2,3], [4,5,6], [7,8,9]], k = 3\n        Output: [1, 2, 1]\n\n        Input: grid = [ [5,9,3], [4,1,6], [7,8,2]], k = 1\n        Output: [1]\n    \"\"\"\n\n    class Cell:\n        \"\"\"Represents a single cell in the grid with its coordinates and value.\"\"\"\n        def __init__(self, row: int, col: int, value: int):\n            self.row = row\n            self.col = col\n            self.value = value\n\n    class Grid:\n        \"\"\"Manages the 2D grid of cells, provides access, and finds neighbors.\"\"\"\n        def __init__(self, grid_data: list[list[int]]):\n            self._N = len(grid_data)\n            self._cells = [[None for _ in range(self._N)] for _ in range(self._N)]\n            for r in range(self._N):\n                for c in range(self._N):\n                    self._cells[r][c] = Cell(r, c, grid_data[r][c])\n\n        def get_cell(self, row: int, col: int) -> Cell:\n            return self._cells[row][col]\n\n        def is_valid_coordinate(self, row: int, col: int) -> bool:\n            return 0 <= row < self._N and 0 <= col < self._N\n\n        def get_neighbors(self, cell: Cell) -> list[Cell]:\n            neighbors = []\n            directions = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Up, Down, Left, Right\n            for dr, dc in directions:\n                new_row, new_col = cell.row + dr, cell.col + dc\n                if self.is_valid_coordinate(new_row, new_col):\n                    neighbors.append(self._cells[new_row][new_col])\n            return neighbors\n\n    class Path:\n        \"\"\"Stores an ordered sequence of cell values forming a path and provides comparison.\"\"\"\n        def __init__(self, initial_cells: list[Cell] | None = None):\n            self._cells = []\n            self._values = []\n            if initial_cells:\n                for cell in initial_cells:\n                    self.add_cell(cell)\n\n        def add_cell(self, cell: Cell) -> None:\n            self._cells.append(cell)\n            self._values.append(cell.value)\n\n        def get_values(self) -> list[int]:\n            return self._values\n\n    N = len(grid)\n    grid_obj = Grid(grid)\n\n    max_val_plus_one = N * N + 1\n    min_found_path_values = [max_val_plus_one] * k\n\n    def _find_paths_recursive(current_cell: Cell, current_path: Path, remaining_k: int):\n        \"\"\"Recursively explores paths to find the lexicographically smallest one.\"\"\"\n        nonlocal min_found_path_values\n\n        if remaining_k == 0:\n            if current_path.get_values() < min_found_path_values:\n                min_found_path_values[:] = current_path.get_values()\n            return\n\n        for neighbor_cell in grid_obj.get_neighbors(current_cell):\n            new_path_cells = current_path._cells + [neighbor_cell]\n            new_path = Path(new_path_cells)\n            _find_paths_recursive(neighbor_cell, new_path, remaining_k - 1)\n\n    for r in range(N):\n        for c in range(N):\n            start_cell = grid_obj.get_cell(r, c)\n            initial_path = Path([start_cell])\n            _find_paths_recursive(start_cell, initial_path, k - 1)\n            \n    return min_found_path_values", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[[12, 13, 10, 1], [9, 3, 15, 6], [5, 16, 14, 4], [11, 8, 7, 2]], 12]], "plus_fail_tests": [[[[1, 2, 3], [4, 5, 6], [7, 8, 9]], 15]]}], "HumanEval/130": [{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Calculates the first n+1 numbers of the Tribonacci sequence.\n    This sequence is defined by specific recurrence relations for even and odd numbers, with base cases for tri(0) and tri(1).\n    \"\"\"\n    memo = {}\n\n    def _get_tribonacci_value(k):\n        \"\"\"Recursively calculates tri(k) using memoization based on the defined rules.\"\"\"\n        if k in memo:\n            return memo[k]\n\n        if k == 0:\n            result = 1\n        elif k == 1:\n            result = 3\n        elif k % 2 == 0:  # k is even and k > 1\n            # As per examples, results are integers, so explicit cast is used for division outcome.\n            result = int(1 + k / 2)\n        else:  # k is odd and k > 1\n            val_k_minus_1 = _get_tribonacci_value(k - 1)\n            val_k_minus_2 = _get_tribonacci_value(k - 2)\n            # For tri(k+1), k+1 is even, so apply the even rule.\n            # As per examples, results are integers, so explicit cast is used.\n            val_k_plus_1 = int(1 + (k + 1) / 2)\n            \n            result = val_k_minus_1 + val_k_minus_2 + val_k_plus_1\n        \n        memo[k] = result\n        return result\n\n    sequence = []\n    for i in range(n + 1):\n        sequence.append(_get_tribonacci_value(i))\n    \n    return sequence", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/83": [{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    if n == 1:\n        # The only 1-digit number is '1'. It starts with 1 and ends with 1.\n        return 1\n    \n    # For n > 1, we use the Principle of Inclusion-Exclusion: |A U B| = |A| + |B| - |A intersection B|\n    # A = set of n-digit numbers starting with 1.\n    # B = set of n-digit numbers ending with 1.\n\n    # Count of n-digit numbers starting with 1:\n    # The first digit is 1 (1 choice). The remaining n-1 digits can be any of 0-9 (10 choices each).\n    count_starts_one = 10**(n - 1)\n\n    # Count of n-digit numbers ending with 1:\n    # The last digit is 1 (1 choice). The first digit cannot be 0 (9 choices, from 1-9).\n    # The remaining n-2 digits (if n > 1) can be any of 0-9 (10 choices each).\n    count_ends_one = 9 * (10**(n - 2))\n\n    # Count of n-digit numbers starting AND ending with 1:\n    # The first digit is 1 (1 choice). The last digit is 1 (1 choice).\n    # The remaining n-2 digits (if n > 2) can be any of 0-9 (10 choices each).\n    # Note: For n=2, this is 10^(2-2) = 10^0 = 1 (number 11).\n    count_starts_and_ends_one = 10**(n - 2)\n\n    # Apply Inclusion-Exclusion:\n    # total = count_starts_one + count_ends_one - count_starts_and_ends_one\n    # total = 10**(n - 1) + 9 * (10**(n - 2)) - 10**(n - 2)\n    # total = 10**(n - 1) + 8 * (10**(n - 2))\n    # total = 10 * 10**(n - 2) + 8 * 10**(n - 2)\n    # total = (10 + 8) * 10**(n - 2)\n    # total = 18 * 10**(n - 2)\n    return 18 * (10**(n - 2))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/139": [{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n\n    # Helper function to calculate the standard factorial.\n    def _factorial(k):\n        res = 1\n        for x in range(1, k + 1):\n            res *= x\n        return res\n\n    special_fact_result = 1\n    for i in range(n, 0, -1):\n        special_fact_result *= _factorial(i)\n\n    return special_fact_result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/163": [{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n\n    def _get_effective_range(x, y):\n        \"\"\"Determines the canonical start and end of the range.\"\"\"\n        return min(x, y), max(x, y)\n\n    def _get_all_integers_in_range(start, end):\n        \"\"\"Generates all integers inclusively within a given range.\"\"\"\n        return list(range(start, end + 1))\n\n    def _filter_even_numbers(numbers):\n        \"\"\"Filters a list to include only single-digit even numbers.\"\"\"\n        return [num for num in numbers if num % 2 == 0 and num < 10]\n\n    def _sort_numbers(numbers):\n        \"\"\"Sorts a list of integers in ascending order.\"\"\"\n        return sorted(numbers)\n\n    # Determine the actual start and end for the range, handling a > b.\n    start, end = _get_effective_range(a, b)\n\n    # Generate all integers within the determined range.\n    all_integers = _get_all_integers_in_range(start, end)\n\n    # Filter out only the single-digit even numbers from the list.\n    even_digits = _filter_even_numbers(all_integers)\n\n    # Sort the even numbers. This step is redundant if generated in order and filtered to preserve order.\n    sorted_even_digits = _sort_numbers(even_digits)\n\n    return sorted_even_digits", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[987654321, 123456789]]}]}}