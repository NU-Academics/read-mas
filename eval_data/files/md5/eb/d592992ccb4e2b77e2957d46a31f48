 code 2\n\n# Length mismatch error\nbinxor 010 11\n# Output to stderr: error: Length mismatch: string a (3) != string b (2)\n# Exits with code 2\n\n# Usage message for incorrect argument count\nbinxor 010\n# Output to stderr: Usage: binxor <binary_a> <binary_b>\n# Exits with code 2\n```\n\n## Development\n\nTo set up a development environment:\n\n```bash\ngit clone https://github.com/example/binxor.git # Placeholder\ncd binxor\npip install -e .[dev] # Placeholder for dev dependencies or poetry install\npytest\n```\n\n## License\n\nThis project is licensed under the MIT License.\n```\n```python\n# src/binxor/__init__.py\n\"\"\"The binxor package provides binary string XOR functionality.\"\"\"\n\nfrom .services import XorService\nfrom .exceptions import InvalidBinaryStringError, LengthMismatchError, BinXorError\n\n__version__ = \"0.1.0\"\n\ndef string_xor(a: str, b: str) -> str:\n    \"\"\"Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    \"\"\"\n    svc = XorService()\n    return svc.xor_strings(a, b)\n```\n```python\n# src/binxor/models.py\n\"\"\"Domain model for a validated binary string.\"\"\"\n\nfrom .validators import validate_binary_string\nfrom .exceptions import LengthMismatchError\nfrom . import utils\n\nclass BitString:\n    \"\"\"Represents an immutable, validated binary string.\"\"\"\n    def __init__(self, value: str) -> None:\n        validate_binary_string(value)\n        self._value = value\n\n    @property\n    def value(self) -> str:\n        \"\"\"Read-only access to the raw binary string value.\"\"\"\n        return self._value\n\n    @property\n    def length(self) -> int:\n        \"\"\"Returns the length of the binary string.\"\"\"\n        return len(self._value)\n\n    def __xor__(self, other: \"BitString\") -> \"BitString\":\n        \"\"\"Computes the bitwise XOR of this BitString with another.\n        Raises LengthMismatchError if the lengths of the two BitStrings differ.\n        \"\"\"\n        if self.length != other.length:\n            raise LengthMismatchError(self.length, other.length)\n        result_chars = [utils.xor_char(c1, c2) for c1, c2 in zip(self._value, other._value)]\n        return BitString(\"\".join(result_chars))\n\n    def __str__(self) -> str:\n        \"\"\"Returns the string representation of the BitString.\"\"\"\n        return self._value\n\n    def __repr__(self) -> str:\n        return f\"BitString('{self._value}')\"\n\n    def __eq__(self, other: object) -> bool:\n        if not isinstance(other, BitString):\n            return NotImplemented\n        return self._value == other._value\n\n    def __hash__(self) -> int:\n        return hash(self._value)\n```\n```python\n# src/binxor/services.py\n\"\"\"Business logic for performing XOR operations on BitString objects and raw strings.\"\"\"\n\nfrom .models import BitString\nfrom .validators import validate_binary_string, ensure_equal_length\n\nclass XorService:\n    \"\"\"Provides methods to perform XOR operations on binary strings.\"\"\"\n    def __init__(self) -> None:\n        pass # Currently stateless, but allows for future dependency injection.\n\n    def xor(self, bit_a: BitString, bit_b: BitString) -> BitString:\n        \"\"\"Performs XOR on two BitString objects.\n        Ensures equal lengths and returns a new BitString with the result.\n        \"\"\"\n        # BitString.__xor__ already handles length validation\n        return bit_a ^ bit_b # Delegate to BitString's __xor__\n\n    def xor_strings(self, a: str, b: str) -> str:\n        \"\"\"Validates raw strings, converts to BitString, performs XOR, and returns result as string.\n        Raises InvalidBinaryStringError or LengthMismatchError for invalid inputs.\n        \"\"\"\n        validate_binary_string(a)\n        validate_binary_string(b)\n        ensure_equal_length(a, b)\n\n        a_bs = BitString(a)\n        b_bs = BitString(b)\n        result_bs = self.xor(a_bs, b_bs)\n        return result_bs.value\n```\n```python\n# src/binxor/validators.py\n\"\"\"Functions for validating binary strings and their lengths.\"\"\"\n\nfrom frozenset import frozenset\nfrom .exceptions import InvalidBinaryStringError, LengthMismatchError\n\nVALID_BITS: frozenset[str] = frozenset({'0', '1'})\n\ndef validate_binary_string(s: str) -> None:\n    \"\"\"Ensures a string contains only '0' or '1' characters.\n    Raises InvalidBinaryStringError if any invalid character is found.\n    \"\"\"\n    for i, char in enumerate(s):\n        if char not in VALID_BITS:\n            raise InvalidBinaryStringError(s, i)\n\ndef ensure_equal_length(a: str, b: str) -> None:\n    \"\"\"Raises LengthMismatchError if the lengths of two strings differ.\"\"\"\n    if len(a) != len(b):\n        raise LengthMismatchError(len(a), len(b))\n```\n```python\n# src/binxor/exceptions.py\n\"\"\"Domain-specific exceptions for the binxor package.\"\"\"\n\nclass BinXorError(Exception):\n    \"\"\"Base exception for all errors in the binxor package.\"\"\"\n    pass\n\nclass InvalidBinaryStringError(BinXorError):\n    \"\"\"Raised when a string contains characters other than '0' or '1'.\"\"\"\n    def __init__(self, s: str, invalid_pos: int | None = None) -> None:\n        message = f\"Invalid binary string '{s}'\"\n        if invalid_pos is not None:\n            message += f\" at position {invalid_pos}: '{s[invalid_pos]}'\"\n        super().__init__(message)\n        self.string = s\n        self.invalid_pos = invalid_pos\n\nclass LengthMismatchError(BinXorError):\n    \"\"\"Raised when two binary strings have different lengths for XOR operation.\"\"\"\n    def __init__(self, len_a: int, len_b: int) -> None:\n        super().__init__(f\"Length mismatch: string a ({len_a}) != string b ({len_b})\")\n        self.len_a = len_a\n        self.len_b = len_b\n```\n```python\n# src/binxor/cli.py\n\"\"\"Command-line interface for the binxor tool.\"\"\"\n\nimport sys\nfrom typing import List, Optional\n\nfrom .services import XorService\nfrom .exceptions import InvalidBinaryStringError, LengthMismatchError\n\nclass CLIController:\n    \"\"\"Handles command-line argument parsing, error reporting, and delegation to XorService.\"\"\"\n    def __init__(self, service: Optional[XorService] = None) -> None:\n        self.service = service or XorService()\n\n    def run(self, argv: List[str]) -> int:\n        \"\"\"Executes the CLI logic with the given arguments.\n        Returns an exit code (0 for success, >0 for failure).\n        \"\"\"\n        if len(argv) != 2:\n            print(\"Usage: binxor <binary_a> <binary_b>\", file=sys.stderr)\n            return 2 # Standard exit code for incorrect usage\n\n        a, b = argv\n        try:\n            result = self.service.xor_strings(a, b)\n            print(result)\n            return 0\n        except (InvalidBinaryStringError, LengthMismatchError) as e:\n            print(f\"error: {e}\", file=sys.stderr)\n            return 2 # Exit code for invalid input/validation errors\n        except Exception as e:\n            print(f\"unexpected error: {e}\", file=sys.stderr)\n            return 1 # Generic error for unexpected issues\n\ndef main(argv: Optional[List[str]] = None) -> int:\n    \"\"\"Entry point for the binxor command-line tool.\"\"\"\n    if argv is None:\n        argv = sys.argv[1:]\n    return CLIController().run(argv)\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n```\n```python\n# src/binxor/utils.py\n\"\"\"Low-level helper functions for binary string operations.\"\"\"\n\ndef xor_char(c1: str, c2: str) -> str:\n    \"\"\"Performs XOR on two single binary characters ('0' or '1').\n    Assumes validated characters; returns '0' if equal, '1' if different.\n    \"\"\"\n    return '1' if c1 != c2 else '0'\n```"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    return string == string[::-1]\n\n\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    if not string:\n        return \"\"\n\n    # Find the longest postfix of `string` that is a palindrome.\n    longest_pal_suffix_len = 0\n    for i in range(len(string)):\n        suffix = string[i:]\n        if is_palindrome(suffix):\n            longest_pal_suffix_len = len(suffix)\n            break \n\n    # Determine the prefix that precedes this longest palindromic suffix.\n    prefix_to_reverse = string[:len(string) - longest_pal_suffix_len]\n\n    # Append the reversed prefix to the original string to form the shortest palindrome.\n    return string + prefix_to_reverse[::-1]"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    \"\"\"\n    res_chars = ['0'] * len(a)\n    for i, (char_a, char_b) in enumerate(zip(a, b)):\n        res_chars[i] = '1' if char_a != char_b else '0'\n    return ''.join(res_chars)"}
