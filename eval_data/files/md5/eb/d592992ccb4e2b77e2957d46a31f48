e integers\"}\n\ndef test_http_post_will_it_fly_invalid_w_type(app_client):\n    \"\"\"Test invalid w type via HTTP.\"\"\"\n    response = app_client.post(\n        f\"{AppFactory.API_PREFIX}/will_it_fly\",\n        json={\"q\": [1, 2], \"w\": \"not an int\"}\n    )\n    assert response.status_code == 400\n    assert response.json() == {\"detail\": \"w must be an integer\"}\n\ndef test_http_post_will_it_fly_missing_q(app_client):\n    \"\"\"Test missing q parameter via HTTP.\"\"\"\n    response = app_client.post(\n        f\"{AppFactory.API_PREFIX}/will_it_fly\",\n        json={\"w\": 5}\n    )\n    assert response.status_code == 400\n    assert response.json() == {\"detail\": \"q must be a list of integers\"} # payload.get(\"q\") returns None\n\ndef test_http_post_will_it_fly_missing_w(app_client):\n    \"\"\"Test missing w parameter via HTTP.\"\"\"\n    response = app_client.post(\n        f\"{AppFactory.API_PREFIX}/will_it_fly\",\n        json={\"q\": [1,2]}\n    )\n    assert response.status_code == 400\n    assert response.json() == {\"detail\": \"w must be an integer\"} # payload.get(\"w\") returns None\n\n```"}
