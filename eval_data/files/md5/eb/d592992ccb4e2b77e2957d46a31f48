ation Error: Negative numbers are not allowed.\n```\n\n## CLI Usage\n\n```bash\n# Check a space-separated list\nis_sorted-cli 1 2 2 3 4\n# Output: Sorted\n# Exit code: 0\n\nis_sorted-cli 1 3 2 4\n# Output: Not sorted\n# Exit code: 1\n\nis_sorted-cli 1 2 2 2 3\n# Output: Not sorted\n# Exit code: 1\n\n# Check a list provided as a JSON string\nis_sorted-cli '[1, 2, 3, 4, 5]'\n# Output: Sorted\n# Exit code: 0\n\nis_sorted-cli '[1, -2, 3]'\n# Output: Validation error: Negative numbers are not allowed.\n# Exit code: 2\n\nis_sorted-cli 'not a list'\n# Output: Validation error: Invalid JSON format: Expecting value: line 1 column 1 (char 0)\n# Exit code: 2\n```\n\n## HTTP API Usage\n\nFirst, run the Flask application:\n\n```bash\nflask --app src.is_sorted_app.app run\n# Or with gunicorn for production:\n# gunicorn \"is_sorted_app.app:create_app()\" -w 4 -b 0.0.0.0:8000\n```\n\nThen, send POST requests to `/check`:\n\n```bash\n# Example: Valid list\ncurl -X POST -H \"Content-Type: application/json\" -d '{\"list\": [1, 2, 2, 3, 4]}' http://127.0.0.1:5000/check\n# Output: {\"sorted\": true, \"reason\": null}\n\n# Example: Not sorted\ncurl -X POST -H \"Content-Type: application/json\" -d '{\"list\": [1, 3, 2, 4]}' http://127.0.0.1:5000/check\n# Output: {\"sorted\": false, \"reason\": \"not_ascending_order\"}\n\n# Example: Too many duplicates\ncurl -X POST -H \"Content-Type: application/json\" -d '{\"list\": [1, 2, 2, 2, 3]}' http://127.0.0.1:5000/check\n# Output: {\"sorted\": false, \"reason\": \"duplicate_count_exceeded\"}\n\n# Example: Validation error (negative number)\ncurl -X POST -H \"Content-Type: application/json\" -d '{\"list\": [1, -2, 3]}' http://127.0.0.1:5000/check\n# Output: {\"error\": \"Negative numbers are not allowed.\"}, HTTP 400\n\n# Example: Invalid JSON\ncurl -X POST -H \"Content-Type: application/json\" -d '{\"invalid\": \"data\"}' http://127.0.0.1:5000/check\n# Output: {\"error\": \"Invalid request body: 'list' key is missing or body is not JSON object.\"}, HTTP 400\n```\n```"}
{"task_id": "HumanEval/127", "solution": "```python\ndef intersection(interval1, interval2):\n    \"\"\"Determines if the length of the intersection of two closed integer intervals is a prime number.\n    Returns \"YES\" if the length is prime, \"NO\" otherwise, including no intersection.\"\"\"\n\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    overlap_start = max(start1, start2)\n    overlap_end = min(end1, end2)\n\n    length = max(0, overlap_end - overlap_start)\n\n    def is_prime(n):\n        \"\"\"Checks if a non-negative integer is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0:\n            return False\n\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    if is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\"\n```"}
{"task_id": "HumanEval/127", "solution": "import math\n\ndef intersection(interval1, interval2):\n    \"\"\"Determines if the length of the intersection of two closed integer intervals is a prime number.\n    Returns \"YES\" if the length is prime, \"NO\" otherwise or if intervals don't intersect.\n    \"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if a non-negative integer is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0:\n            return False\n        for i in range(3, int(math.isqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\n\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    intersection_start = max(start1, start2)\n    intersection_end = min(end1, end2)\n\n    if intersection_end < intersection_start:\n        return \"NO\"\n\n    length = intersection_end - intersection_start\n    \n    return \"YES\" if is_prime(length) else \"NO\""}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    '''\n    Checks if a list is sorted ascendingly and has at most two occurrences of any number.\n    Assumes non-negative integers as input.\n    '''\n    counts = {}\n    for num in lst:\n        counts[num] = counts.get(num, 0) + 1\n        if counts[num] > 2:\n            return False\n\n    if len(lst) <= 1:\n        return True\n\n    for i in range(1, len(lst)):\n        if lst[i] < lst[i-1]:\n            return False\n\n    return True"}
{"task_id": "HumanEval/128", "solution": "```python\ndef prod_signs(arr):\n    \"\"\"\n    You are given an array arr of integers and you need to return\n    sum of magnitudes of integers multiplied by product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    Note: return None for empty arr.\n\n    Example:\n    >>> prod_signs([1, 2, 2, -4]) == -9\n    >>> prod_signs([0, 1]) == 0\n    >>> prod_signs([]) == None\n    \"\"\"\n    if not arr:\n        return None\n\n    sum_of_magnitudes = 0\n    for x in arr:\n        sum_of_magnitudes += abs(x)\n\n    sign_product = 1\n    has_zero = False\n    for x in arr:\n        if x == 0:\n            has_zero = True\n            break\n        elif x < 0:\n            sign_product *= -1\n        # If x > 0, sign is 1, so sign_product remains unchanged (or *= 1)\n\n    if has_zero:\n        return 0\n    else:\n        return sum_of_magnitudes * sign_product\n```"}
{"task_id": "HumanEval/128", "solution": "```python\ndef prod_signs(arr):\n    \"\"\"\n    Computes the sum of magnitudes of integers multiplied by the product of their signs.\n    Returns None for an empty array.\n    \"\"\"\n    if not arr:\n        return None\n\n    product_of_all_signs = 1\n    sum_of_magnitudes = 0\n    zero_found = False\n\n    for x in arr:\n        if x == 0:\n            zero_found = True\n        elif x < 0:\n            product_of_all_signs *= -1\n\n        sum_of_magnitudes += abs(x)\n\n    if zero_found:\n        return 0\n\n    return product_of_all_signs * sum_of_magnitudes\n```"}
{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Given a grid and k, find the lexicographically minimum path of length k.\n    Moves allowed are to orthogonally adjacent cells; cells can be revisited.\n    \"\"\"\n\n    N = len(grid)\n\n    # Helper function to check if coordinates are within grid bounds.\n    def in_bounds(r, c):\n        return 0 <= r < N and 0 <= c < N\n\n    # Initialize paths for length 1.\n    # dp maps (row, col) to the lexicographically smallest path of current length ending at that cell.\n    dp = {}\n    for r_init in range(N):\n        for c_init in range(N):\n            dp[(r_init, c_init)] = (grid[r_init][c_init],) # Path of length 1 is just the cell's value.\n\n    # If k is 1, the smallest path is simply the minimum value in the grid.\n    if k == 1:\n        return list(min(dp.values()))\n\n    # Dynamic programming loop to build paths of increasing length up to k.\n    # `current_path_length` iterates from 2 up to `k`.\n    for current_path_length in range(2, k + 1):\n        next_dp = {} # Stores paths for the current `current_path_length`.\n\n        # Iterate over every possible destination cell for this step.\n        for dest_r in range(N):\n            for dest_c in range(N):\n                dest_value = grid[dest_r][dest_c]\n                dest_coord = (dest_r, dest_c)\n\n                min_path_to_dest = None\n\n                # Define all possible moves: up, down, left, right, and staying in place (0,0).\n                # These offsets are applied to `dest_coord` to find `prev_coord`.\n                offsets = [(-1, 0), (1, 0), (0, -1), (0, 1), (0, 0)]\n\n                for dr, dc in offsets:\n                    prev_r, prev_c = dest_r + dr, dest_c + dc\n                    prev_coord = (prev_r, prev_c)\n\n                    # Check if the `prev_coord` is valid and had a path of length `current_path_length - 1`.\n                    if in_bounds(prev_r, prev_c) and prev_coord in dp:\n                        # Extend the path to `prev_coord` with `dest_value` to form a candidate.\n                        candidate_path = dp[prev_coord] + (dest_value,)\n\n                        # Update `min_path_to_dest` if this candidate is lexicographically smaller.\n                        if min_path_to_dest is None or candidate_path < min_path_to_dest:\n                            min_path_to_dest = candidate_path\n                \n                if min_path_to_dest is not None:\n                    next_dp[dest_coord] = min_path_to_dest\n        \n        # Update dp for the next iteration with paths of the new length.\n        dp = next_dp\n\n    # After `k` steps, `dp` contains the lexicographically smallest paths of length `k`\n    # ending at each cell. Find the overall minimum among these final paths.\n    final_min_path_tuple = min(dp.values())\n    \n    return list(final_min_path_tuple)"}
{"task_id": "HumanEval/129", "solution": "```python\ndef minPath(grid, k):\n    # Finds the lexicographically minimum path of length k in the grid.\n    # It starts at 1 and iteratively moves to the minimum valued neighbor.\n    N = len(grid)\n\n    value_to_pos = {}\n    for r in range(N):\n        for c in range(N):\n            value_to_pos[grid[r][c]] = (r, c)\n\n    current_r, current_c = value_to_pos[1]\n    path = [grid[current_r][current_c]]\n\n    def get_neighbors_coords(r: int, c: int, n: int) -> list[tuple[int,int]]:\n        possible_neighbors = [(r-1, c), (r+1, c), (r, c-1), (r, c+1)]\n        valid_neighbors = []\n        for nr, nc in possible_neighbors:\n            if 0 <= nr < n and 0 <= nc < n:\n                valid_neighbors.append((nr, nc))\n        return valid_neighbors\n\n    for _ in range(1, k):\n        neighbors = get_neighbors_coords(current_r, current_c, N)\n        \n        min_neighbor_value = float('inf')\n        next_r, next_c = -1, -1\n\n        for nr, nc in neighbors:\n            neighbor_value = grid[nr][nc]\n            if neighbor_value < min_neighbor_value:\n                min_neighbor_value = neighbor_value\n                next_r, next_c = nr, nc\n        \n        path.append(min_neighbor_value)\n        current_r, current_c = next_r, next_c\n\n    return path\n```"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Generates the first n+1 numbers of the Tribonacci sequence.\n    Uses memoization to cache computed terms for efficient lookup.\n    \"\"\"\n    memo = {}\n\n    def _compute_term(k):\n        \"\"\"Computes a single Tribonacci term tri(k) using memoization and recurrence rules.\"\"\"\n        if k in memo:\n            return memo[k]\n\n        val = None\n        if k == 0:\n            val = 1\n        elif k == 1:\n            val = 3\n        elif k % 2 == 0:  # k is even\n            val = 1 + (k // 2)\n        else:  # k is odd (and k >= 3 as 1 is base)\n            val = _compute_term(k - 1) + _compute_term(k - 2) + _compute_term(k + 1)\n        \n        memo[k] = val\n        return val\n\n    result_sequence = []\n    for i in range(n + 1):\n        result_sequence.append(_compute_term(i))\n\n    return result_sequence"}
{"task_id": "HumanEval/130", "solution": "from typing import List\n\n# The memoization cache. This stores computed sequences to avoid redundant work.\n_tribonacci_cache = {}\n\ndef tri(n: int) -> List[int]:\n    \"\"\"Computes the Tribonacci sequence up to index n, using memoization as per design.\"\"\"\n    if n in _tribonacci_cache:\n        return _tribonacci_cache[n]\n\n    sequence = [0] * (n + 1)\n\n    for k in range(n + 1):\n        if k == 0:\n            sequence[k] = 1 + (0 // 2)\n        elif k == 1:\n            sequence[k] = 3\n        elif k % 2 == 0:  # k is even and k > 1\n            sequence[k] = 1 + (k // 2)\n        else:  # k is odd and k > 1\n            # tri(k+1) is even, its value is computed directly from the even rule.\n            tri_k_plus_1 = 1 + ((k + 1) // 2)\n            sequence[k] = sequence[k - 1] + sequence[k - 2] + tri_k_plus_1\n\n    _tribonacci_cache[n] = sequence\n    return sequence"}
{"task_id": "HumanEval/131", "solution": "```python\ndef digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    For example:\n    digits(1)  == 1\n    digits(4)  == 0\n    digits(235) == 15\n    \"\"\"\n    n = abs(n)\n    product = 1\n    has_odd = False\n\n    if n == 0:\n        return 0\n\n    while n > 0:\n        digit = n % 10\n        if digit % 2 == 1:\n            product *= digit\n            has_odd = True\n        n //= 10\n\n    return product if has_odd else 0\n```"}
