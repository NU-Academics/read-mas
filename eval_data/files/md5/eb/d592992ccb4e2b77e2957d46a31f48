{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"It is the last week of the semester and the teacher has to give the grades\n    to students. The teacher has been making her own algorithm for grading.\n    The only problem is, she has lost the code she used for grading.\n    She has given you a list of GPAs for some students and you have to write \n    a function that can output a list of letter grades using the following table:\n             GPA       |    Letter grade\n              4.0                A+\n            > 3.7                A \n            > 3.3                A- \n            > 3.0                B+\n            > 2.7                B \n            > 2.3                B-\n            > 2.0                C+\n            > 1.7                C\n            > 1.3                C-\n            > 1.0                D+ \n            > 0.7                D \n            > 0.0                D-\n              0.0                E\n    \n\n    Example:\n    grade_equation([4.0, 3, 1.7, 2, 3.5]) ==> ['A+', 'B', 'C-', 'C', 'A-']\n    \"\"\"\n    \n    def _map_single_gpa(gpa):\n        \"\"\"Maps a single GPA value to its corresponding letter grade based on the defined rubric.\"\"\"\n        if gpa == 4.0:\n            return \"A+\"\n        if gpa > 3.7:\n            return \"A\"\n        if gpa > 3.3:\n            return \"A-\"\n        if gpa > 3.0:\n            return \"B+\"\n        if gpa > 2.7:\n            return \"B\"\n        if gpa > 2.3:\n            return \"B-\"\n        if gpa > 2.0:\n            return \"C+\"\n        if gpa > 1.7:\n            return \"C\"\n        if gpa > 1.3:\n            return \"C-\"\n        if gpa > 1.0:\n            return \"D+\"\n        if gpa > 0.7:\n            return \"D\"\n        if gpa > 0.0:\n            return \"D-\"\n        return \"E\"\n\n    return [_map_single_gpa(gpa) for gpa in grades]"}
{"task_id": "HumanEval/81", "solution": "```python\ndef numerical_letter_grade(grades):\n    \"\"\"Maps a list of GPAs to letter grades based on a predefined threshold table.\n    It iterates through thresholds in descending order to find the first match.\n    \"\"\"\n    \n    grade_thresholds = [\n        {\"threshold\": 4.0, \"letter\": \"A+\"},\n        {\"threshold\": 3.7, \"letter\": \"A\"},\n        {\"threshold\": 3.3, \"letter\": \"A-\"},\n        {\"threshold\": 3.0, \"letter\": \"B+\"},\n        {\"threshold\": 2.7, \"letter\": \"B\"},\n        {\"threshold\": 2.3, \"letter\": \"B-\"},\n        {\"threshold\": 2.0, \"letter\": \"C+\"},\n        {\"threshold\": 1.7, \"letter\": \"C\"},\n        {\"threshold\": 1.3, \"letter\": \"C-\"},\n        {\"threshold\": 1.0, \"letter\": \"D+\"},\n        {\"threshold\": 0.7, \"letter\": \"D\"},\n        {\"threshold\": 0.0, \"letter\": \"D-\"},\n        {\"threshold\": 0.0, \"letter\": \"E\"}\n    ]\n\n    result_grades = []\n    for gpa in grades:\n        assigned_letter = None\n        for th_entry in grade_thresholds:\n            threshold = th_entry[\"threshold\"]\n            letter = th_entry[\"letter\"]\n\n            if threshold == 4.0:\n                if gpa == 4.0:\n                    assigned_letter = letter\n                    break\n            elif threshold == 0.0 and letter == \"E\":\n                if gpa == 0.0:\n                    assigned_letter = letter\n                    break\n            elif gpa > threshold:\n                assigned_letter = letter\n                break\n        \n        result_grades.append(assigned_letter)\n\n    return result_grades\n```"}
{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"\n    Checks if the length of a string is a prime number.\n    It directly implements primality testing logic for the string's length.\n    \"\"\"\n    n = len(string)\n\n    def _is_prime(num: int) -> bool:\n        \"\"\"Helper to determine if a non-negative integer is prime, used internally.\"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    return _is_prime(n)"}
{"task_id": "HumanEval/82", "solution": "import math\n\ndef prime_length(string):\n    \"\"\"Write a function that takes a string and returns True if the string\n    length is a prime number or False otherwise.\"\"\"\n    n = len(string)\n\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    \n    limit = int(math.isqrt(n))\n    for i in range(3, limit + 1, 2):\n        if n % i == 0:\n            return False\n            \n    return True"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of n-digit positive integers that start or end with 1.\n    This implementation assumes n is a positive integer as per problem statement.\n    \"\"\"\n    def _pow10(exp: int) -> int:\n        # Computes 10 raised to the power of exp.\n        return 10 ** exp\n\n    if n == 1:\n        return 1\n    # For n >= 2, the count follows a specific mathematical pattern.\n    return 18 * _pow10(n - 2)"}
{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Given a non-negative integer N, return the total sum of its decimal digits in binary.\n    The output is a binary string without '0b' prefix, and '0' for a sum of zero.\n    \"\"\"\n    decimal_sum = 0\n    temp_N = N\n    while temp_N > 0:\n        decimal_sum += temp_N % 10\n        temp_N //= 10\n    \n    binary_string = format(decimal_sum, \"b\")\n    return binary_string"}
{"task_id": "HumanEval/83", "solution": "```\n# pyproject.toml\n[project]\nname = \"startoneend1\"\nversion = \"0.1.0\"\ndescription = \"Counts n-digit integers starting or ending with 1.\"\nauthors = [{ name = \"Your Name\", email = \"your.email@example.com\" }]\ndependencies = [\n    \"fastapi>=0.111.0\",\n    \"uvicorn[standard]>=0.30.1\",\n]\nrequires-python = \">=3.9\"\n\n[project.scripts]\nstart-one-ends = \"startoneend1.cli:main\"\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[tool.setuptools.packages.find]\nwhere = [\"src\"]\n\n[tool.pytest.ini_options]\npythonpath = \"src\"\n\n[tool.black]\nline-length = 99\ntarget-version = ['py39']\n\n```python\n# README.md\n# Start One Ends Utility\n\nThis project provides a utility to count n-digit positive integers that start or end with the digit 1. It offers a programmatic API, a command-line interface (CLI), and an HTTP REST API.\n\n## Installation\n\nRequires Python 3.9 or higher.\n\n1.  **Clone the repository:**\n    ```bash\n    git clone https://github.com/your-repo/startoneend1.git\n    cd startoneend1\n    ```\n2.  **Install dependencies:**\n    ```bash\n    pip install -e .\n    ```\n    This command installs the project in editable mode and sets up the CLI command.\n\n## Usage\n\n### Command Line Interface (CLI)\n\nTo compute the count for a given `n`:\n\n```bash\nstart-one-ends <n>\n```\n\nExamples:\n```bash\nstart-one-ends 1\n# Output: n=1 count=1\n\nstart-one-ends 2\n# Output: n=2 count=18\n\nstart-one-ends 10\n# Output: n=10 count=1800000000\n```\n\n### HTTP REST API\n\nThe service can be run as an HTTP server using Uvicorn.\n\n1.  **Run the server:**\n    ```bash\n    uvicorn startoneend1.api:create_app --host 0.0.0.0 --port 8000\n    ```\n2.  **Access the API:**\n    Send a GET request to `/v1/count?n=<n>`.\n\nExamples (using `curl`):\n```bash\ncurl \"http://localhost:8000/v1/count?n=2\"\n# Output: {\"n\":2,\"count\":18}\n\ncurl \"http://localhost:8000/v1/count?n=5\"\n# Output: {\"n\":5,\"count\":18000}\n\ncurl \"http://localhost:8000/v1/count?n=invalid\"\n# Output: {\"detail\":\"n must be an integer >= 1\"}\n\ncurl \"http://localhost:8000/v1/count?n=0\"\n# Output: {\"detail\":\"n must be >= 1\"}\n```\n\n### Programmatic Use (Python Library)\n\nYou can import and use the core calculation function directly.\n\n```python\nfrom startoneend1.services import CalculationService\nfrom startoneend1.validators import InputValidator\nfrom startoneend1.exceptions import ValidationError\n\nservice = CalculationService()\nvalidator = InputValidator()\n\ntry:\n    n_validated = validator.validate_n(5)\n    result = service.starts_one_ends(n_validated)\n    print(f\"Count for n=5: {result}\")\nexcept ValidationError as e:\n    print(f\"Error: {e.message}\")\n\ntry:\n    n_validated = validator.validate_n(\"0\")\n    result = service.starts_one_ends(n_validated)\n    print(f\"Count for n=0: {result}\")\nexcept ValidationError as e:\n    print(f\"Error: {e.message}\")\n```\n\n```python\n# src/startoneend1/__init__.py\n\"\"\"Package initialization for startoneend1.\"\"\"\n\n__version__ = \"0.1.0\"\n\n```python\n# src/startoneend1/models.py\n\"\"\"Data Transfer Objects for requests and responses.\"\"\"\n\nclass CountRequest:\n    \"\"\"Represents a request for counting numbers.\"\"\"\n\n    def __init__(self, n: int) -> None:\n        \"\"\"Initialize with the number of digits.\"\"\"\n        self.n = n\n\n\nclass CountResponse:\n    \"\"\"Represents the response containing the count.\"\"\"\n\n    def __init__(self, n: int, count: int) -> None:\n        \"\"\"Initialize with the input n and the calculated count.\"\"\"\n        self.n = n\n        self.count = count\n\n    def to_dict(self) -> dict:\n        \"\"\"Convert the response object to a dictionary.\"\"\"\n        return {\"n\": self.n, \"count\": self.count}\n\n```python\n# src/startoneend1/exceptions.py\n\"\"\"Custom exception types used in the application.\"\"\"\n\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input data.\"\"\"\n\n    def __init__(self, message: str) -> None:\n        \"\"\"Initialize with a descriptive error message.\"\"\"\n        super().__init__(message)\n        self.message = message\n\n```python\n# src/startoneend1/utils.py\n\"\"\"Utility functions for common operations.\"\"\"\n\nfrom typing import Any\n\ndef parse_int(value: Any) -> int:\n    \"\"\"Safely parse a value into an integer.\"\"\"\n    try:\n        return int(str(value).strip())\n    except (ValueError, TypeError):\n        raise ValueError(\"Cannot parse value to integer.\")\n\ndef safe_pow10(exp: int) -> int:\n    \"\"\"Compute 10 raised to the power of exp.\"\"\"\n    if exp < 0:\n        raise ValueError(\"Exponent must be non-negative for safe_pow10.\")\n    return 10 ** exp\n\n```python\n# src/startoneend1/validators.py\n\"\"\"Input validation logic for the application.\"\"\"\n\nfrom typing import Any\nfrom .exceptions import ValidationError\nfrom .utils import parse_int\n\nclass InputValidator:\n    \"\"\"Validates and coerces input values.\"\"\"\n\n    def validate_n(self, value: Any) -> int:\n        \"\"\"Validate that n is an integer >= 1.\"\"\"\n        try:\n            n = parse_int(value)\n        except ValueError:\n            raise ValidationError(\"n must be an integer >= 1.\")\n\n        if n < 1:\n            raise ValidationError(\"n must be >= 1.\")\n        return n\n\n```python\n# src/startoneend1/services.py\n\"\"\"Core business logic for calculating the count.\"\"\"\n\nfrom .utils import safe_pow10\n\nclass CalculationService:\n    \"\"\"Provides the core calculation for n-digit numbers.\"\"\"\n\n    def starts_one_ends(self, n: int) -> int:\n        \"\"\"\n        Given a positive integer n, return the count of n-digit positive\n        integers that start or end with 1.\n        \"\"\"\n        # For n=1, the only 1-digit number starting or ending with 1 is '1'.\n        if n == 1:\n            return 1\n        # For n >= 2, the count is 18 multiplied by 10 to the power of (n-2).\n        return 18 * safe_pow10(n - 2)\n\n```python\n# src/startoneend1/controllers.py\n\"\"\"Base class for controllers with common utilities.\"\"\"\n\nfrom typing import Callable, Any\nfrom .exceptions import ValidationError\n\nclass ControllerBase:\n    \"\"\"Provides common functionality for handling controller logic.\"\"\"\n\n    def handle_validation(self, fn: Callable, *args, **kwargs) -> Any:\n        \"\"\"Execute a function and catch ValidationError.\"\"\"\n        try:\n            return fn(*args, **kwargs)\n        except ValidationError as e:\n            # Controllers will specifically handle this error type.\n            raise e\n\n```python\n# src/startoneend1/api.py\n\"\"\"FastAPI application for the HTTP REST API.\"\"\"\n\nfrom fastapi import FastAPI, HTTPException\nfrom fastapi.responses import JSONResponse\nfrom .services import CalculationService\nfrom .validators import InputValidator\nfrom .exceptions import ValidationError\nfrom .models import CountResponse\nfrom .controllers import ControllerBase # Not used directly in this specific setup, but part of design\n\nclass APIController(ControllerBase):\n    \"\"\"Controller for handling HTTP requests.\"\"\"\n\n    def __init__(self, service: CalculationService, validator: InputValidator) -> None:\n        \"\"\"Initialize with a calculation service and input validator.\"\"\"\n        self.service = service\n        self.validator = validator\n\n    def get_count(self, n_str: str) -> dict:\n        \"\"\"Handle GET /v1/count?n=<n> request.\"\"\"\n        try:\n            # Use handle_validation from ControllerBase for consistent error handling\n            n_int = self.handle_validation(self.validator.validate_n, n_str)\n        except ValidationError as e:\n            raise HTTPException(status_code=400, detail=e.message)\n\n        result = self.service.starts_one_ends(n_int)\n        response_model = CountResponse(n=n_int, count=result)\n        return response_model.to_dict()\n\ndef create_app() -> FastAPI:\n    \"\"\"Create and configure the FastAPI application.\"\"\"\n    app = FastAPI(\n        title=\"Starts One Ends API\",\n        description=\"API to count n-digit numbers starting or ending with 1.\",\n        version=\"0.1.0\",\n    )\n\n    service = CalculationService()\n    validator = InputValidator()\n    controller = APIController(service, validator)\n\n    @app.get(\"/v1/count\", response_model=dict, summary=\"Get count of n-digit numbers\")\n    async def get_count_endpoint(n: str):\n        \"\"\"\n        Compute the count of n-digit positive integers that start or end with 1.\n        Query parameter 'n' must be a positive integer.\n        \"\"\"\n        return controller.get_count(n)\n\n    return app\n\n```python\n# src/startoneend1/cli.py\n\"\"\"Command-Line Interface (CLI) entrypoint.\"\"\"\n\nimport sys\nfrom typing import List, Optional\nimport argparse\n\nfrom .services import CalculationService\nfrom .validators import InputValidator\nfrom .exceptions import ValidationError\nfrom .controllers import ControllerBase\n\nclass CLIController(ControllerBase):\n    \"\"\"Handles command-line interface interactions.\"\"\"\n\n    def __init__(self, service: CalculationService, validator: InputValidator) -> None:\n        \"\"\"Initialize with a calculation service and input validator.\"\"\"\n        self.service = service\n        self.validator = validator\n\n    def _parse_args(self, argv: Optional[List[str]]) -> int:\n        \"\"\"Parse command-line arguments and validate 'n'.\"\"\"\n        parser = argparse.ArgumentParser(\n            description=\"Count n-digit positive integers that start or end with 1.\"\n        )\n        parser.add_argument(\n            \"n\",\n            type=str,\n            help=\"The number of digits (a positive integer, e.g., '2').\"\n        )\n        args = parser.parse_args(argv)\n        # Use handle_validation from ControllerBase\n        return self.handle_validation(self.validator.validate_n, args.n)\n\n    def run(self, argv: Optional[List[str]] = None) -> int:\n        \"\"\"Execute the CLI command.\"\"\"\n        try:\n            n_int = self._parse_args(argv)\n            count = self.service.starts_one_ends(n_int)\n            print(f\"n={n_int} count={count}\")\n            return 0  # Success exit code\n        except ValidationError as e:\n            print(f\"Error: {e.message}\", file=sys.stderr)\n            return 1  # Validation error exit code\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 2  # General error exit code\n\ndef main() -> None:\n    \"\"\"Main entry point for the CLI application.\"\"\"\n    controller = CLIController(CalculationService(), InputValidator())\n    sys.exit(controller.run(sys.argv[1:]))\n\n```"}
{"task_id": "HumanEval/84", "solution": "```python\ndef solve(N):\n    \"\"\"Given an integer N (0 <= N <= 10000), computes the sum of its decimal digits\n    and returns that sum encoded as a binary string.\n    \"\"\"\n    # Calculate the sum of N's decimal digits by iterating through its string representation.\n    digit_sum = sum(int(digit_char) for digit_char in str(N))\n\n    # Convert the decimal sum to a binary string, removing the \"0b\" prefix.\n    # This also correctly handles a sum of 0, resulting in \"0\".\n    return bin(digit_sum)[2:]\n```"}
