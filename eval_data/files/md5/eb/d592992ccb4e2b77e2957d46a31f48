{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Evaluates an algebraic expression from operator and operand lists.\n    Uses shunting-yard to convert infix to RPN, then evaluates RPN.\n    \"\"\"\n\n    def _interleave_tokens(operators, operands):\n        \"\"\"Builds an interleaved list of operands and operators.\"\"\"\n        tokens = []\n        for i in range(len(operands)):\n            tokens.append(operands[i])\n            if i < len(operators):\n                tokens.append(operators[i])\n        return tokens\n\n    OP_PRECEDENCE = {\n        '**': 4,\n        '*': 3,\n        '//': 3,\n        '+': 2,\n        '-': 2,\n    }\n\n    OP_ASSOCIATIVITY = {\n        '**': 'right',\n        '*': 'left',\n        '//': 'left',\n        '+': 'left',\n        '-': 'left',\n    }\n\n    def _infix_to_rpn(tokens):\n        \"\"\"Converts an infix token list to Reverse Polish Notation using shunting-yard.\"\"\"\n        output_queue = []\n        operator_stack = []\n\n        for token in tokens:\n            if isinstance(token, int):\n                output_queue.append(token)\n            elif token in OP_PRECEDENCE:\n                o1 = token\n                while (operator_stack and operator_stack[-1] in OP_PRECEDENCE and\n                       (OP_PRECEDENCE[operator_stack[-1]] > OP_PRECEDENCE[o1] or\n                        (OP_PRECEDENCE[operator_stack[-1]] == OP_PRECEDENCE[o1] and\n                         OP_ASSOCIATIVITY[o1] == 'left'))):\n                    output_queue.append(operator_stack.pop())\n                operator_stack.append(o1)\n        \n        while operator_stack:\n            output_queue.append(operator_stack.pop())\n\n        return output_queue\n\n    def _eval_rpn(rpn_tokens):\n        \"\"\"Evaluates an expression in Reverse Polish Notation.\"\"\"\n        stack = []\n        for token in rpn_tokens:\n            if isinstance(token, int):\n                stack.append(token)\n            else:\n                operand2 = stack.pop()\n                operand1 = stack.pop()\n\n                if token == '+':\n                    stack.append(operand1 + operand2)\n                elif token == '-':\n                    stack.append(operand1 - operand2)\n                elif token == '*':\n                    stack.append(operand1 * operand2)\n                elif token == '//':\n                    stack.append(operand1 // operand2)\n                elif token == '**':\n                    stack.append(operand1 ** operand2)\n        \n        return stack[0]\n\n    interleaved_tokens = _interleave_tokens(operator, operand)\n    rpn_expression = _infix_to_rpn(interleaved_tokens)\n    result = _eval_rpn(rpn_expression)\n\n    return result"}
{"task_id": "HumanEval/160", "solution": "```python\ndef do_algebra(operator, operand):\n    \"\"\"\n    Evaluates an algebraic expression from operator and operand lists.\n    Uses shunting-yard for precedence and RPN for evaluation.\n    \"\"\"\n\n    PRECEDENCE = {\"**\": 4, \"*\": 3, \"//\": 3, \"+\": 2, \"-\": 2}\n    RIGHT_ASSOC = {\"**\"}\n\n    # Step 1: Build infix token list\n    infix_tokens = []\n    for i in range(len(operand)):\n        infix_tokens.append(operand[i])\n        if i < len(operator):\n            infix_tokens.append(operator[i])\n\n    # Step 2: Shunting-yard algorithm to convert infix to RPN (Reverse Polish Notation)\n    output_queue = []\n    operator_stack = []\n\n    for token in infix_tokens:\n        if isinstance(token, int):  # Operand\n            output_queue.append(token)\n        else:  # Operator\n            while (operator_stack and\n                   operator_stack[-1] in PRECEDENCE and\n                   (PRECEDENCE[operator_stack[-1]] > PRECEDENCE[token] or\n                    (PRECEDENCE[operator_stack[-1]] == PRECEDENCE[token] and token not in RIGHT_ASSOC))):\n                output_queue.append(operator_stack.pop())\n            operator_stack.append(token)\n    \n    while operator_stack:\n        output_queue.append(operator_stack.pop())\n    \n    # Step 3: Evaluate RPN\n    value_stack = []\n    for token in output_queue:\n        if isinstance(token, int):  # Operand\n            value_stack.append(token)\n        else:  # Operator\n            # Pop operands in reverse order (b then a) for binary operations\n            b = value_stack.pop()\n            a = value_stack.pop()\n            \n            if token == \"+\":\n                value_stack.append(a + b)\n            elif token == \"-\":\n                value_stack.append(a - b)\n            elif token == \"*\":\n                value_stack.append(a * b)\n            elif token == \"//\":\n                value_stack.append(a // b)\n            elif token == \"**\":\n                value_stack.append(a ** b)\n    \n    return value_stack[0]\n```"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"Toggles the case of letters in a string or reverses it if no letters are present.\n    Non-letter characters remain unchanged during case toggling.\"\"\"\n\n    if any(c.isalpha() for c in s):\n        return \"\".join(c.swapcase() if c.isalpha() else c for c in s)\n    else:\n        return s[::-1]"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"Reverses case of letters in a string, or reverses the whole string if no letters are present.\n    Non-letter characters are preserved unless the entire string is reversed.\n    \"\"\"\n    has_letters = False\n    for char in s:\n        if char.isalpha():\n            has_letters = True\n            break\n\n    if has_letters:\n        transformed_chars = []\n        for char in s:\n            if char.isalpha():\n                transformed_chars.append(char.swapcase())\n            else:\n                transformed_chars.append(char)\n        return \"\".join(transformed_chars)\n    else:\n        return s[::-1]"}
{"task_id": "HumanEval/162", "solution": "import hashlib\n\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if text == \"\":\n        return None\n    return hashlib.md5(text.encode(\"utf-8\")).hexdigest()"}
{"task_id": "HumanEval/162", "solution": "import hashlib\n\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if text == \"\":\n        return None\n    return hashlib.md5(text.encode(\"utf-8\")).hexdigest().lower()"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Returns single-digit even numbers between a and b, inclusive, in ascending order.\n    The order of a and b does not affect the range.\n    \"\"\"\n    lo, hi = min(a, b), max(a, b)\n    candidates = [0, 2, 4, 6, 8]\n    return [d for d in candidates if lo <= d <= hi]"}
{"task_id": "HumanEval/163", "solution": "```python\ndef generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return numbers within the inclusive range\n    where all of the number's digits are even, in ascending order.\n    \"\"\"\n    result = []\n    start = min(a, b)\n    end = max(a, b)\n\n    for num in range(start, end + 1):\n        has_only_even_digits = True\n        if num == 0:  # Special case: 0 has only one digit, 0, which is even\n            has_only_even_digits = True\n        else:\n            temp_num = num\n            while temp_num > 0:\n                digit = temp_num % 10\n                if digit % 2 != 0:\n                    has_only_even_digits = False\n                    break\n                temp_num //= 10\n        \n        if has_only_even_digits:\n            result.append(num)\n            \n    return result\n```"}
