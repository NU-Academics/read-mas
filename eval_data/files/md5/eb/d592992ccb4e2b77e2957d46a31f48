{"task_id": "HumanEval/4", "solution": "The following code implements the software design specification, structured into the specified files and directories.\n\n```\nsrc/madlib/__init__.py\n```\n```python\n\"\"\"\nA small, reliable Python library and CLI to compute Mean Absolute Deviation (MAD).\n\"\"\"\n\n__version__ = \"0.1.0\"\n\nfrom typing import List, Optional\n\nfrom .exceptions import StatisticsError\nfrom .models import StatResult\nfrom .repositories import InMemoryRepository, JsonFileRepository\nfrom .services import StatisticsService\nfrom .controllers import MadController\n\n# Define a convenient top-level function for simple MAD computation\ndef compute_mad(numbers: List[float], persist_path: Optional[str] = None) -> StatResult:\n    \"\"\"\n    Computes Mean Absolute Deviation (MAD) for a list of numbers.\n\n    :param numbers: A list of numeric values (floats or ints).\n    :param persist_path: Optional path to a JSON file to persist the result.\n    :return: A StatResult object containing the count, mean, and MAD.\n    :raises StatisticsError: If input is invalid (empty, non-numeric, non-finite).\n    \"\"\"\n    repo = JsonFileRepository(persist_path) if persist_path else None\n    controller = MadController(repo=repo)\n    return controller.compute(numbers)\n\n```\n\n```\nsrc/madlib/models.py\n```\n```python\nfrom typing import Dict, Any\n\nclass StatResult:\n    \"\"\"Data model for statistical computation results.\"\"\"\n    def __init__(self, count: int, mean: float, mad: float, sample_summary: Dict[str, Any] = None) -> None:\n        self.count = count\n        self.mean = mean\n        self.mad = mad\n        self.sample_summary = sample_summary or {}\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Serializes the StatResult object to a dictionary.\"\"\"\n        return {\n            \"count\": self.count,\n            \"mean\": self.mean,\n            \"mad\": self.mad,\n            \"sample_summary\": self.sample_summary\n        }\n\n    @classmethod\n    def from_dict(cls, d: Dict[str, Any]) -> \"StatResult\":\n        \"\"\"Constructs a StatResult object from a dictionary.\"\"\"\n        return cls(d[\"count\"], d[\"mean\"], d[\"mad\"], d.get(\"sample_summary\"))\n\nSAMPLE_SUMMARY_MAX = 10\n\n```\n\n```\nsrc/madlib/exceptions.py\n```\n```python\nclass StatisticsError(Exception):\n    \"\"\"Custom exception for statistical computation errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\n```\n\n```\nsrc/madlib/utils.py\n```\n```python\nimport math\nfrom typing import List, Union\nfrom .exceptions import StatisticsError\n\ndef validate_numbers(numbers: List[Union[int, float]]) -> List[float]:\n    \"\"\"\n    Validates if the input is a non-empty list of finite numbers, converting ints to floats.\n    Raises StatisticsError for invalid inputs.\n    \"\"\"\n    if numbers is None or len(numbers) == 0:\n        raise StatisticsError(\"Input must be a non-empty list of numbers.\")\n    \n    cleaned = []\n    for i, v in enumerate(numbers):\n        try:\n            f = float(v)\n        except (TypeError, ValueError) as e:\n            raise StatisticsError(f\"Non-numeric value at index {i}: '{v}'\") from e\n        \n        if math.isinf(f) or math.isnan(f):\n            raise StatisticsError(f\"Non-finite value at index {i}: '{v}'\")\n        cleaned.append(f)\n    return cleaned\n\ndef safe_mean(numbers: List[float]) -> float:\n    \"\"\"\n    Computes the arithmetic mean for a list of numbers after validation.\n    Raises StatisticsError if input is invalid.\n    \"\"\"\n    validated_numbers = validate_numbers(numbers)\n    # validate_numbers already ensures the list is non-empty.\n    return sum(validated_numbers) / len(validated_numbers)\n\ndef average(values: List[float]) -> float:\n    \"\"\"\n    Computes the average of a list of floats.\n    Raises StatisticsError if the list is empty.\n    \"\"\"\n    if not values:\n        raise StatisticsError(\"Cannot compute average for an empty list.\")\n    return sum(values) / len(values)\n\n```\n\n```\nsrc/madlib/services.py\n```\n```python\nfrom typing import List\nfrom .utils import safe_mean, average\nfrom .exceptions import StatisticsError\n\nclass StatisticsService:\n    \"\"\"Provides core statistical computation logic for mean and MAD.\"\"\"\n    def __init__(self) -> None:\n        self.EPSILON = 1e-12  # Constant for numeric comparisons\n\n    def compute_mean(self, numbers: List[float]) -> float:\n        \"\"\"Computes the arithmetic mean of a list of numbers.\"\"\"\n        return safe_mean(numbers)\n\n    def compute_mad(self, numbers: List[float]) -> float:\n        \"\"\"\n        Computes the Mean Absolute Deviation (MAD) around the mean.\n        Internally uses compute_mean which includes input validation.\n        \"\"\"\n        mean = self.compute_mean(numbers)\n        deviations = [abs(float(x) - mean) for x in numbers]\n        return average(deviations)\n\n```\n\n```\nsrc/madlib/repositories.py\n```\n```python\nimport json\nimport os\nfrom typing import List, Protocol, runtime_checkable\nfrom datetime import datetime\nfrom .models import StatResult\n\n@runtime_checkable\nclass Repository(Protocol):\n    \"\"\"Abstract base class/protocol for saving statistical results.\"\"\"\n    def save(self, result: StatResult) -> None:\n        \"\"\"Saves a StatResult object.\"\"\"\n        ...\n\nclass InMemoryRepository(Repository):\n    \"\"\"In-memory repository for storing StatResult objects.\"\"\"\n    def __init__(self) -> None:\n        self._store: List[StatResult] = []\n\n    def save(self, result: StatResult) -> None:\n        \"\"\"Adds a StatResult to the in-memory store.\"\"\"\n        self._store.append(result)\n\n    def all(self) -> List[StatResult]:\n        \"\"\"Retrieves all stored StatResult objects.\"\"\"\n        return list(self._store)\n\nclass JsonFileRepository(Repository):\n    \"\"\"File-based repository saving StatResult objects to a JSON Lines file.\"\"\"\n    def __init__(self, path: str) -> None:\n        self.path = path\n        # Ensure directory exists\n        os.makedirs(os.path.dirname(self.path), exist_ok=True)\n\n    def save(self, result: StatResult) -> None:\n        \"\"\"\n        Appends a StatResult to the JSON file, including a timestamp.\n        Assumes the underlying filesystem handles concurrent appends atomically.\n        \"\"\"\n        record = result.to_dict()\n        record[\"timestamp\"] = datetime.now().isoformat()\n        \n        with open(self.path, \"a\", encoding=\"utf-8\") as f:\n            f.write(json.dumps(record) + \"\\n\")\n\n    def _load_all(self) -> List[StatResult]:\n        \"\"\"Loads all StatResult objects from the JSON file.\"\"\"\n        if not os.path.exists(self.path):\n            return []\n        results = []\n        with open(self.path, \"r\", encoding=\"utf-8\") as f:\n            for line in f:\n                try:\n                    data = json.loads(line.strip())\n                    results.append(StatResult.from_dict(data))\n                except json.JSONDecodeError:\n                    # Log error or skip malformed lines for robustness\n                    pass\n        return results\n\n```\n\n```\nsrc/madlib/controllers.py\n```\n```python\nfrom typing import List, Optional, Dict, Any\nfrom .services import StatisticsService\nfrom .repositories import Repository, InMemoryRepository\nfrom .models import StatResult, SAMPLE_SUMMARY_MAX\nfrom .exceptions import StatisticsError\n\nclass MadController:\n    \"\"\"Orchestrates MAD computation, result structuring, and optional persistence.\"\"\"\n    def __init__(self, repo: Optional[Repository] = None) -> None:\n        self.service = StatisticsService()\n        self.repo = repo if repo is not None else InMemoryRepository()\n\n    def compute(self, numbers: List[float]) -> StatResult:\n        \"\"\"\n        Computes MAD for a list of numbers and returns a structured result.\n        Validates input, calls the statistics service, and persists the result.\n        \"\"\"\n        try:\n            # Service methods handle validation and raise StatisticsError on invalid input\n            mean = self.service.compute_mean(numbers)\n            mad = self.service.compute_mad(numbers)\n            count = len(numbers)\n\n            # Create sample summary, ensuring no more than SAMPLE_SUMMARY_MAX elements\n            sample_summary: Dict[str, Any] = {\n                \"first_n\": numbers[:SAMPLE_SUMMARY_MAX],\n                \"last_n\": numbers[max(0, count - SAMPLE_SUMMARY_MAX):]\n            }\n\n            result = StatResult(count=count, mean=mean, mad=mad, sample_summary=sample_summary)\n            self.repo.save(result)\n            return result\n        except StatisticsError:\n            # Re-raise StatisticsError for programmatic API consumers\n            raise\n        except Exception as e:\n            # Wrap any unexpected errors in StatisticsError\n            raise StatisticsError(f\"An unexpected error occurred during MAD computation: {e}\") from e\n\n```\n\n```\nsrc/madlib/cli.py\n```\n```python\nimport sys\nimport argparse\nimport json\nfrom typing import List, Optional\nfrom .controllers import MadController\nfrom .repositories import JsonFileRepository, InMemoryRepository\nfrom .exceptions import StatisticsError\n\nclass MadCLI:\n    \"\"\"Command-line interface for computing Mean Absolute Deviation.\"\"\"\n    def __init__(self, controller: Optional[MadController] = None) -> None:\n        self.controller = controller\n\n    def _parse_args(self, argv: List[str]) -> argparse.Namespace:\n        \"\"\"Parses command-line arguments using argparse.\"\"\"\n        parser = argparse.ArgumentParser(\n            description=\"Compute Mean Absolute Deviation (MAD) for a list of numbers.\",\n            formatter_class=argparse.RawTextHelpFormatter # For better help message formatting\n        )\n        parser.add_argument(\n            \"numbers\",\n            nargs=\"*\",\n            help=(\n                \"Numbers to compute MAD for, space-separated (e.g., '1 2 3 4').\\n\"\n                \"Comma-separated values are also supported (e.g., '1,2,3,4').\\n\"\n                \"Use '-' to read numbers from standard input (e.g., 'echo 1 2 3 | madlib -').\"\n            ),\n        )\n        parser.add_argument(\n            \"--json-output\",\n            action=\"store_true\",\n            help=\"Output result in JSON format (default if no other output format specified).\",\n        )\n        parser.add_argument(\n            \"--plain-output\",\n            action=\"store_true\",\n            help=\"Output result in plaintext format (count, mean, mad).\",\n        )\n        parser.add_argument(\n            \"--persist-path\",\n            type=str,\n            help=\"Path to a JSON file to append results (e.g., 'mad_results.json').\",\n        )\n        return parser.parse_args(argv)\n\n    def _get_numbers_from_input(self, args: argparse.Namespace) -> List[float]:\n        \"\"\"\n        Extracts numbers from arguments or stdin and converts them to floats.\n        Raises StatisticsError for invalid input formats.\n        \"\"\"\n        input_parts: List[str] = []\n        \n        if not args.numbers:\n            raise StatisticsError(\n                \"No numbers provided. Please supply numbers as arguments \"\n                \"(e.g., 'madlib 1 2 3') or pipe them via stdin with '-' \"\n                \"(e.g., 'echo 1 2 3 | madlib -').\"\n            )\n\n        if args.numbers[0] == \"-\":\n            if not sys.stdin.isatty():  # Check if stdin is being piped\n                raw_input = sys.stdin.read().strip()\n                if not raw_input:\n                    raise StatisticsError(\"Standard input is empty.\")\n                input_parts.extend(raw_input.replace(\",\", \" \").split())\n            else:\n                raise StatisticsError(\"When using '-', numbers must be piped via stdin (e.g., 'echo 1 2 3 | madlib -').\")\n        else:\n            for item in args.numbers:\n                input_parts.extend(item.replace(\",\", \" \").split())\n        \n        # Convert all parts to float, allowing the validate_numbers in service layer to do robust checks\n        parsed_numbers: List[float] = []\n        for s in input_parts:\n            if not s: # Skip empty strings from multiple spaces etc.\n                continue\n            try:\n                parsed_numbers.append(float(s))\n            except ValueError:\n                raise StatisticsError(f\"Invalid numeric input detected: '{s}'. All inputs must be numbers.\")\n        \n        return parsed_numbers\n\n    def run(self, argv: List[str]) -> int:\n        \"\"\"\n        Main entry point for the CLI. Parses arguments, computes MAD, and prints results.\n        Returns an exit code (0 for success, non-zero for errors).\n        \"\"\"\n        args = self._parse_args(argv)\n        \n        try:\n            numbers = self._get_numbers_from_input(args)\n\n            # Determine repository based on arguments\n            repo = None\n            if args.persist_path:\n                repo = JsonFileRepository(args.persist_path)\n            \n            # Initialize or reconfigure controller with the determined repository\n            if self.controller is None:\n                self.controller = MadController(repo=repo)\n            else:\n                # If controller was provided (e.g., for testing), update its repo\n                # If no persist-path, default to InMemoryRepo as defined in MadController's __init__\n                self.controller.repo = repo if repo is not None else InMemoryRepository()\n\n\n            result = self.controller.compute(numbers)\n\n            if args.plain_output:\n                print(f\"Count: {result.count}\")\n                print(f\"Mean: {result.mean}\")\n                print(f\"MAD: {result.mad}\")\n            else: # Default or --json-output\n                output_dict = result.to_dict()\n                # For CLI output, remove sample_summary for brevity as per example output in spec\n                if \"sample_summary\" in output_dict:\n                    del output_dict[\"sample_summary\"]\n                print(json.dumps(output_dict, indent=2))\n            \n            return 0\n        except StatisticsError as e:\n            print(f\"Error: {e.message}\", file=sys.stderr)\n            return 2 # Exit code 2 for input validation/logic errors\n        except Exception as e:\n            print(f\"An unexpected internal error occurred: {e}\", file=sys.stderr)\n            return 1 # Generic unexpected error code\n\ndef main(argv: List[str] = None) -> int:\n    \"\"\"Wrapper function for console_scripts entry point.\"\"\"\n    return MadCLI().run(argv if argv is not None else sys.argv[1:])\n\n```\n\n```\npyproject.toml\n```\n```toml\n[project]\nname = \"madlib\"\nversion = \"0.1.0\"\ndescription = \"A small library and CLI to compute Mean Absolute Deviation (MAD).\"\nauthors = [\n    { name = \"Your Name\", email = \"your.email@example.com\" },\n]\nreadme = \"README.md\"\nrequires-python = \">=3.8\"\nlicense = { text = \"MIT\" }\nkeywords = [\"statistics\", \"mad\", \"mean-absolute-deviation\"]\nclassifiers = [\n    \"Programming Language :: Python :: 3\",\n    \"License :: OSI Approved :: MIT License\",\n    \"Operating System :: OS Independent\",\n    \"Intended Audience :: Developers\",\n    \"Intended Audience :: Science/Research\",\n    \"Topic :: Scientific/Engineering :: Mathematics\",\n]\ndependencies = [\n    # No external dependencies currently required\n]\n\n[project.urls]\nHomepage = \"https://github.com/yourusername/madlib\"\n\"Bug Tracker\" = \"https://github.com/yourusername/madlib/issues\"\n\n[project.scripts]\nmadlib = \"madlib.cli:main\"\n\n[build-system]\n