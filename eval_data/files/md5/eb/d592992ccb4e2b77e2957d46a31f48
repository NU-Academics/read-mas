 import ValidationError\nfrom .models import SortResult\n\nclass SortService:\n    \"\"\"Orchestrates validation and rule checking for list sorting.\"\"\"\n    def __init__(self, order_checker: Optional[OrderChecker] = None, duplicate_checker: Optional[DuplicateChecker] = None):\n        \"\"\"Initializes SortService with optional checker dependencies.\"\"\"\n        self.order_checker = order_checker or OrderChecker()\n        self.duplicate_checker = duplicate_checker or DuplicateChecker()\n\n    def validate(self, lst: List[Any]) -> None:\n        \"\"\"Validates that the input is a list of non-negative integers.\"\"\"\n        if not isinstance(lst, list):\n            raise ValidationError(\"Input must be a list.\")\n        for x in lst:\n            if not isinstance(x, int):\n                raise ValidationError(\"All elements must be integers.\")\n            if x < 0:\n                raise ValidationError(\"Negative numbers are not allowed.\")\n\n    def is_sorted(self, lst: List[int]) -> SortResult:\n        \"\"\"Checks if a list is sorted and has allowed duplicates, returning a SortResult.\"\"\"\n        self.validate(lst) # Validate input types and values\n        \n        # Check duplicate rules first\n        if not self.duplicate_checker.has_allowed_duplicates(lst):\n            # For a more specific reason, could enhance DuplicateChecker to return problematic value\n            return SortResult(sorted=False, reason=\"duplicate_count_exceeded\")\n        \n        # If duplicates are allowed, check order\n        if not self.order_checker.is_non_decreasing(lst):\n            return SortResult(sorted=False, reason=\"not_ascending_order\")\n        \n        return SortResult(sorted=True)\n\n```python\n# src/is_sorted_app/utils.py\nimport json\nfrom typing import List, Any\nfrom .errors import ValidationError\n\ndef parse_list_from_args(args: List[str]) -> List[int]:\n    \"\"\"Parses a list of integers from command-line arguments.\"\"\"\n    if not args:\n        return [] # Empty list if no arguments\n\n    if len(args) == 1 and args[0].startswith('[') and args[0].endswith(']'):\n        # Assume JSON array string\n        try:\n            parsed_list = json.loads(args[0])\n            if not isinstance(parsed_list, list):\n                raise ValidationError(\"JSON input must be a list.\")\n            return parsed_list # Validation of elements will be done by SortService.validate\n        except json.JSONDecodeError as e:\n            raise ValidationError(f\"Invalid JSON format: {e}\")\n    else:\n        # Assume space-separated numbers\n        try:\n            return [int(x) for x in args] # Validation of elements will be done by SortService.validate\n        except ValueError:\n            raise ValidationError(\"All arguments must be integers or a single valid JSON array string.\")\n\ndef is_int_list(lst: List[Any]) -> bool:\n    \"\"\"Checks if all elements in a list are non-negative integers.\"\"\"\n    if not isinstance(lst, list):\n        return False\n    for x in lst:\n        if not isinstance(x, int) or x < 0:\n            return False\n    return True\n\n```python\n# src/is_sorted_app/controllers.py\nimport sys\nfrom typing import List, Dict, Any, Tuple, Optional\nfrom .services import SortService\nfrom .utils import parse_list_from_args\nfrom .errors import ValidationError\nfrom .models import SortResult\n\nclass CLIController:\n    \"\"\"Handles command-line interface interactions.\"\"\"\n    def __init__(self, service: Optional[SortService] = None):\n        \"\"\"Initializes CLIController with an optional SortService instance.\"\"\"\n        self.service = service or SortService()\n\n    def run(self, argv: List[str]) -> int:\n        \"\"\"Executes the CLI logic, parsing arguments and printing results.\"\"\"\n        try:\n            lst = parse_list_from_args(argv)\n            result: SortResult = self.service.is_sorted(lst)\n            print(\"Sorted\" if result.sorted else