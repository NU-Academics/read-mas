{"task_id": "HumanEval/32", "solution": "import math\n\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x using Horner's method.\n    Coefficients are ordered from constant term (xs[0]) to highest degree (xs[n]).\n    \"\"\"\n    result = 0.0\n    for coeff in reversed(xs):\n        result = result * x + coeff\n    return result\n\n# Helper functions for find_zero, defined inline as per critical requirements.\n\nDEFAULT_TOLERANCE = 1e-10\nDEFAULT_MAX_ITER = 100\nDEFAULT_BRACKET_EXPAND = 1000.0\n_EPSILON = 1e-15 # Small value to prevent division by zero in Newton-Raphson\n\ndef _evaluate_derivative(coeffs: list, x: float) -> float:\n    \"\"\"\n    Evaluates the derivative of a polynomial at point x using Horner's method.\n    Coefficients are ordered from constant term (coeffs[0]) to highest degree.\n    \"\"\"\n    result = 0.0\n    # The coefficients for the derivative polynomial P'(x) are i * coeffs[i] for i >= 1.\n    # We apply Horner's method to these derivative coefficients.\n    for i in reversed(range(1, len(coeffs))):\n        result = result * x + i * coeffs[i]\n    return result\n\ndef _find_bracket(eval_func, coeffs: list[float], max_expand: float) -> tuple[float, float] | None:\n    \"\"\"\n    Attempts to find an initial bracket [a, b] where f(a) and f(b) have opposite signs.\n    It expands symmetric bounds around zero until a sign change is found or max_expand is reached.\n    \"\"\"\n    a, b = -1.0, 1.0\n    # Ensure starting points are not identical for immediate sign check if f(0) is a root\n    if eval_func(coeffs, a) == 0.0: return (a, a)\n    if eval_func(coeffs, b) == 0.0: return (b, b)\n    \n    current_span = 1.0\n    while current_span < max_expand:\n        fa = eval_func(coeffs, a)\n        fb = eval_func(coeffs, b)\n        if math.copysign(1, fa) != math.copysign(1, fb):\n            return (a, b)\n        \n        # Expand the bracket symmetrically\n        a *= 2\n        b *= 2\n        current_span *= 2\n        \n    # If no bracket found after max expansion, return None.\n    # The problem statement guarantees a solution for odd-degree polynomials,\n    # so in practice, a bracket should always be found within reasonable bounds.\n    return None\n\ndef _bisection_iterate(eval_func, coeffs: list[float], a: float, b: float, tol: float, max_iter: int) -> float:\n    \"\"\"\n    Performs bisection method to find a root within a given bracket [a, b].\n    Assumes a valid bracket where f(a) and f(b) have opposite signs.\n    \"\"\"\n    fa = eval_func(coeffs, a)\n    fb = eval_func(coeffs, b)\n\n    # Basic check, but robust error handling is forbidden.\n    # We assume fa and fb have opposite signs or one is zero.\n    if fa == 0.0: return a\n    if fb == 0.0: return b\n\n    for _ in range(max_iter):\n        mid = (a + b) / 2\n        fmid = eval_func(coeffs, mid)\n\n        if abs(fmid) <= tol or (b - a) / 2 <= tol:\n            return mid\n\n        if math.copysign(1, fmid) != math.copysign(1, fa):\n            b = mid\n            fb = fmid\n        else:\n            a = mid\n            fa = fmid\n    return (a + b) / 2 # Return best estimate if max_iter is reached\n\ndef _newton_raphson_iterate(eval_func, deriv_eval_func, coeffs: list[float], x0: float, tol: float, max_iter: int) -> float:\n    \"\"\"\n    Performs Newton-Raphson method starting from an initial guess x0.\n    Iterates until convergence within tolerance or max iterations reached.\n    \"\"\"\n    x = x0\n    for _ in range(max_iter):\n        fx = eval_func(coeffs, x)\n        dfx = deriv_eval_func(coeffs, x)\n\n        if abs(fx) <= tol:\n            return x\n\n        # If derivative is near zero, Newton-Raphson may fail.\n        # Since throwing errors is forbidden, we return the current best estimate.\n        if abs(dfx) < _EPSILON:\n            return x # Prevent division by zero\n\n        x_next = x - fx / dfx\n        if abs(x_next - x) <= tol:\n            return x_next\n        x = x_next\n    return x # Return best estimate if max_iter is reached\n\n\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero finds x such that poly(x) = 0.\n    It returns only one zero point for polynomials with an odd number of coefficients.\n    \"\"\"\n    coeffs_floats = [float(c) for c in xs]\n    \n    # Try to find a bracket using symmetric expansion.\n    # The problem guarantees a solution for odd-degree polynomials.\n    bracket = _find_bracket(poly, coeffs_floats, DEFAULT_BRACKET_EXPAND)\n    # If for some reason a bracket isn't found,\n    # the problem spec implies a solution is guaranteed so this path\n    # should not be reached with valid odd-degree polynomial inputs.\n    # To avoid forbidden exceptions or complex error handling, we take a pragmatic approach\n    # and simply return a default or propagate error if no bracket.\n    # For now, we assume a bracket is always found for valid inputs.\n    if bracket is None:\n        # This branch implies an extreme case beyond assumed input validity for find_zero.\n        # Given \"trust the caller's inputs\", we proceed assuming a bracket is found.\n        # If this were allowed to raise, it would be a RootFindingError.\n        # As per instructions, we return a fallback if required, but for guaranteed roots,\n        # find_bracket should succeed. If it fails, we simply return a very large value.\n        # This is an edge case resulting from the no-error-handling constraint.\n        return math.inf # Fallback when no bracket found, despite guarantee\n\n    a, b = bracket\n\n    # Use bisection to narrow down the root to a sufficiently small interval.\n    # The midpoint of this interval serves as a good initial guess for Newton-Raphson.\n    mid_point_from_bisection = _bisection_iterate(poly, coeffs_floats, a, b, DEFAULT_TOLERANCE, DEFAULT_MAX_ITER)\n    \n    # Refine the root using Newton-Raphson for faster convergence.\n    # If Newton-Raphson encounters issues (e.g., derivative near zero),\n    # it will return its best estimate, which is handled gracefully as per `_newton_raphson_iterate` logic.\n    refined_root = _newton_raphson_iterate(poly, _evaluate_derivative, coeffs_floats, mid_point_from_bisection, DEFAULT_TOLERANCE, DEFAULT_MAX_ITER)\n    \n    return refined_root"}
{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    Handles small numbers with trial division and larger numbers with Miller-Rabin.\n    \"\"\"\n    # Business rule: Negative numbers and 0, 1 are not prime.\n    if n < 2:\n        return False\n    # Base cases for small primes\n    if n == 2 or n == 3:\n        return True\n    # Even numbers greater than 2 are not prime\n    if n % 2 == 0:\n        return False\n\n    # NFR1: trial division up to sqrt(n) for n < 10_000_000\n    TRIAL_DIVISION_THRESHOLD = 10_000_000\n\n    if n < TRIAL_DIVISION_THRESHOLD:\n        # Trial division algorithm for small numbers\n        i = 3\n        # Iterate up to the square root of n.\n        limit = int(n**0.5)\n        while i <= limit:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n    else:\n        # Miller-Rabin for larger numbers\n        # Business rule: Miller-Rabin with default 5 rounds.\n        rounds = 5\n\n        # Import random here as per strict interpretation of \"same code block\".\n        import random\n\n        # Miller-Rabin algorithm:\n        # Write n-1 as 2^s * d where d is odd.\n        d = n - 1\n        s = 0\n        while d % 2 == 0:\n            d //= 2\n            s += 1\n\n        # Test with 'rounds' random witnesses.\n        for _ in range(rounds):\n            # Choose a random witness 'a' in range [2, n-2]\n            a = random.randint(2, n - 2)\n            x = pow(a, d, n)\n\n            if x == 1 or x == n - 1:\n                continue\n\n            for _ in range(s - 1):\n                x = pow(x, 2, n)\n                if x == n - 1:\n                    break\n            else:\n                return False  # 'a' is a composite witness\n\n        return True"}
{"task_id": "HumanEval/32", "solution": "```python\nimport math\n\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    Returns xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\n\n\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    Finds one real root for polynomials with even length coefficients and non-zero leading term.\n    Uses analytic solutions for linear, and hybrid numeric methods for higher degrees.\n    \"\"\"\n    tolerance = 1e-9\n    max_iter = 200\n\n    n = len(xs)\n\n    # Degree 1 case: f(x) = a0 + a1*x. Since n is even, this means n=2.\n    if n == 2:\n        return -xs[0] / xs[1]\n\n    # Helper for derivative coefficients, defined inline.\n    def _derivative_coeffs(coeffs: list) -> list:\n        return [i * c for i, c in enumerate(coeffs)][1:]\n\n    # Helper for Newton's method, defined inline.\n    def _newton_method(coeffs: list, x0: float) -> float:\n        x = x0\n        for _ in range(max_iter):\n            fx = poly(coeffs, x)\n            if abs(fx) < tolerance:\n                return x\n            \n            deriv_coeffs = _derivative_coeffs(coeffs)\n            f_prime_x = poly(deriv_coeffs, x)\n\n            # Handle near-zero derivative to avoid division by zero without raising exceptions.\n            if abs(f_prime_x) < 1e-12:\n                x += 0.001 * (x if x != 0 else 1.0) # Nudge x if derivative is too small\n                continue\n\n            x = x - fx / f_prime_x\n        \n        # Return the last computed x if max_iter is reached without convergence.\n        return x\n\n    # Bracketing strategy: Scan a range for a sign change.\n    search_range = 10.0\n    num_intervals = 100\n\n    bracket_found = False\n    a, b = -search_range, search_range\n    \n    for i in range(num_intervals + 1):\n        x1 = -search_range + (2 * search_range / num_intervals) * i\n        x2 = -search_range + (2 * search_range / num_intervals) * (i + 1)\n        \n        fx1 = poly(xs, x1)\n        fx2 = poly(xs, x2)\n\n        if fx1 * fx2 <= 0:\n            a, b = x1, x2\n            bracket_found = True\n            break\n    \n    if bracket_found:\n        # Refine the bracket using bisection, then Newton's method.\n        for _ in range(max_iter):\n            mid = (a + b) / 2.0\n            f_mid = poly(xs, mid)\n            if abs(f_mid) < tolerance:\n                return mid\n            \n            # Re-evaluate f(a) as 'a' might have changed from prior steps.\n            f_a = poly(xs, a)\n            if f_a * f_mid < 0:\n                b = mid\n            else:\n                a = mid\n        \n        # If bisection didn't converge to tolerance, use Newton from the midpoint.\n        return _newton_method(xs, (a + b) / 2.0)\n    else:\n        # Fallback to Newton's method from common initial guesses if no bracket is found.\n        initial_guesses = [0.0, 1.0, -1.0, 0.5, -0.5]\n        \n        for guess in initial_guesses:\n            root = _newton_method(xs, guess)\n            if abs(poly(xs, root)) < tolerance:\n                return root\n            \n        # As a final fallback, return the result of Newton from 0.0.\n        return _newton_method(xs, 0.0)\n```"}
