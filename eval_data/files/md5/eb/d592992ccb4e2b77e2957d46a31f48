{"task_id": "HumanEval/132", "solution": "```\nsrc/bracketnest/exceptions.py\n```python\nclass InvalidBracketStringError(Exception):\n    \"\"\"Exception raised for invalid characters in the bracket string.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n```\n\nsrc/bracketnest/bracket_analysis.py\n```python\nfrom typing import List, Dict, Any\n\nclass BracketAnalysis:\n    \"\"\"DTO for storing the result of a bracket string analysis.\"\"\"\n    def __init__(self, input_str: str, is_nested: bool, nested_indices: List[int] | None = None) -> None:\n        self.input_str = input_str\n        self.is_nested = is_nested\n        self.nested_indices = nested_indices or []\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Returns a dictionary representation for serialization.\"\"\"\n        return {\"input\": self.input_str, \"is_nested\": self.is_nested, \"nested_indices\": self.nested_indices}\n\n    def __repr__(self) -> str:\n        \"\"\"Returns a string representation for debugging.\"\"\"\n        return f\"BracketAnalysis(input={self.input_str!r}, is_nested={self.is_nested}, nested_indices={self.nested_indices})\"\n```\n\nsrc/bracketnest/validator.py\n```python\nfrom .exceptions import InvalidBracketStringError\n\nALLOWED_CHARS = {\"[\", \"]\"}\n\nclass Validator:\n    \"\"\"Utility for validating input bracket strings.\"\"\"\n    @staticmethod\n    def is_valid_chars(s: str) -> bool:\n        \"\"\"Checks if all characters in the string are allowed bracket characters.\"\"\"\n        return all(ch in ALLOWED_CHARS for ch in s)\n\n    @staticmethod\n    def assert_valid(s: str) -> None:\n        \"\"\"Raises InvalidBracketStringError if the string contains invalid characters.\"\"\"\n        if not Validator.is_valid_chars(s):\n            raise InvalidBracketStringError(f\"Invalid characters in input: {s!r}. Only '[' and ']' are allowed.\")\n```\n\nsrc/bracketnest/nesting_service.py\n```python\nfrom typing import List, Tuple\nfrom .bracket_analysis import BracketAnalysis\nfrom .validator import Validator\n\nclass NestingService:\n    \"\"\"Core service for detecting nested bracket subsequences.\"\"\"\n    def analyze(self, input_str: str) -> BracketAnalysis:\n        \"\"\"Analyzes an input string for a nested bracket subsequence after validating.\"\"\"\n        Validator.assert_valid(input_str)\n        found, indices = self._fast_check(input_str)\n        return BracketAnalysis(input_str, found, indices)\n\n    def _fast_check(self, input_str: str) -> Tuple[bool, List[int]]:\n        \"\"\"Efficiently checks for a nested subsequence (i < j < k < l for [[]]) in O(N) time.\"\"\"\n        first_open_idx: int = -1\n        second_open_idx: int = -1\n        first_close_idx: int = -1\n        second_close_idx: int = -1\n\n        for current_idx, char in enumerate(input_str):\n            if char == '[':\n                if first_open_idx == -1:\n                    first_open_idx = current_idx\n                else: # This is a potential second open\n                    second_open_idx = current_idx\n            elif char == ']':\n                if second_open_idx != -1: # We have seen at least `[[`\n                    if first_close_idx == -1:\n                        first_close_idx = current_idx\n                    elif second_close_idx == -1: # This is a potential second close\n                        second_close_idx = current_idx\n\n                        # Check if the nested condition i < j < k < l is met\n                        if (first_open_idx < second_open_idx and\n                            second_open_idx < first_close_idx and\n                            first_close_idx < second_close_idx):\n                            return True, [first_open_idx, second_open_idx, first_close_idx, second_close_idx]\n\n        return False, []\n```\n\nsrc/bracketnest/analysis_repository.py\n```python\nimport json\nfrom pathlib import Path\nfrom typing import List, Optional\nfrom .bracket_analysis import BracketAnalysis\n\nDEFAULT_PERSIST_PATH = Path(\"analyses.json\")\n\nclass AnalysisRepository:\n    \"\"\"Repository for storing and optionally persisting bracket analysis results.\"\"\"\n    def __init__(self, persist_path: Optional[Path] = None) -> None:\n        self.store: List[BracketAnalysis] = []\n        self.persist_path = persist_path\n\n    def save(self, analysis: BracketAnalysis) -> None:\n        \"\"\"Appends an analysis to the store and persists to file if configured.\"\"\"\n        self.store.append(analysis)\n        if self.persist_path:\n            self.persist_to_file()\n\n    def all(self) -> List[BracketAnalysis]:\n        \"\"\"Returns a shallow copy of all stored analyses.\"\"\"\n        return list(self.store)\n\n    def persist_to_file(self) -> None:\n        \"\"\"Writes the current in-memory store to the configured JSON file path.\"\"\"\n        if not self.persist_path:\n            return\n        \n        try:\n            tmp_path = self.persist_path.with_suffix(\".tmp\")\n            with tmp_path.open(\"w\", encoding=\"utf-8\") as f:\n                json.dump([a.to_dict() for a in self.store], f, ensure_ascii=False, indent=2)\n            tmp_path.replace(self.persist_path) # Atomic rename\n        except IOError as e:\n            print(f\"Warning: Could not persist analyses to file {self.persist_path}: {e}\")\n```\n\nsrc/bracketnest/cli_controller.py\n```python\nimport json\nimport sys\nfrom typing import Optional\nfrom .validator import Validator\nfrom .nesting_service import NestingService\nfrom .analysis_repository import AnalysisRepository\nfrom .bracket_analysis import BracketAnalysis\nfrom .exceptions import InvalidBracketStringError\n\nclass CLIController:\n    \"\"\"Controller for command-line interface interactions.\"\"\"\n    def __init__(self, repo: Optional[AnalysisRepository] = None, service: Optional[NestingService] = None) -> None:\n        self.repo = repo\n        self.service = service or NestingService()\n\n    def run(self, input_str: str, json_out: bool = False) -> int:\n        \"\"\"Executes the analysis and prints results, returning an exit code.\"\"\"\n        try:\n            Validator.assert_valid(input_str)\n            analysis = self.service.analyze(input_str)\n            if self.repo:\n                self.repo.save(analysis)\n            output = self._format_output(analysis, json_out)\n            print(output)\n            return 1 if analysis.is_nested else 0\n        except InvalidBracketStringError as e:\n            print(f\"Error: {e}\", file=sys.stderr)\n            return 2\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 2\n\n    def _format_output(self, analysis: BracketAnalysis, json_out: bool = False) -> str:\n        \"\"\"Formats the analysis result into a human-readable or JSON string.\"\"\"\n        if json_out:\n            return json.dumps(analysis.to_dict(), indent=2)\n        \n        indices_str = ', '.join(map(str, analysis.nested_indices)) if analysis.nested_indices else 'None'\n        return (f\"Input: {analysis.input_str!r}\\n\"\n                f\"Nested subsequence found: {analysis.is_nested}\\n\"\n                f\"Indices: {indices_str}\")\n```\n\nsrc/bracketnest/api_controller.py\n```python\nfrom typing import Dict, Any\nfrom .nesting_service import NestingService\nfrom .bracket_analysis import BracketAnalysis\n\nclass APIController:\n    \"\"\"Lightweight controller for programmatic API access.\"\"\"\n    def __init__(self, service: NestingService | None = None) -> None:\n        self.service = service or NestingService()\n\n    def analyze(self, input_str: str) -> Dict[str, Any]:\n        \"\"\"Performs analysis and returns result as a dictionary.\"\"\"\n        analysis: BracketAnalysis = self.service.analyze(input_str)\n        return analysis.to_dict()\n```\n\nsrc/bracketnest/cli.py\n```python\nimport sys\nfrom typing import List\nfrom pathlib import Path\nfrom .cli_controller import CLIController\nfrom .analysis_repository import AnalysisRepository, DEFAULT_PERSIST_PATH\n\ndef main(argv: List[str] | None = None) -> int:\n    \"\"\"Main entry point for the command-line interface.\"\"\"\n    argv = argv if argv is not None else sys.argv[1:]\n\n    if not argv:\n        print(\"Usage: bracketnest <BRACKETS> [--json] [--persist]\", file=sys.stderr)\n        return 2\n\n    json_out = False\n    persist_to_file = False\n    input_str_idx = -1\n\n    # Parse arguments\n    clean_argv = []\n    for i, arg in enumerate(argv):\n        if arg == \"--json\":\n            json_out = True\n        elif arg == \"--persist\":\n            persist_to_file = True\n        elif input_str_idx == -1: # First non-flag argument is the bracket string\n            input_str_idx = i\n            clean_argv.append(arg)\n        else: # Additional positional arguments are not expected\n            print(f\"Error: Unexpected argument '{arg}'\", file=sys.stderr)\n            print(\"Usage: bracketnest <BRACKETS> [--json] [--persist]\", file=sys.stderr)\n            return 2\n    \n    if input_str_idx == -1:\n        print(\"Error: No bracket string provided.\", file=sys.stderr)\n        print(\"Usage: bracketnest <BRACKETS> [--json] [--persist]\", file=sys.stderr)\n        return 2\n\n    input_str = clean_argv[0]\n\n    repo = AnalysisRepository(persist_path=DEFAULT_PERSIST_PATH if persist_to_file else None)\n    controller = CLIController(repo=repo)\n    return controller.run(input_str, json_out=json_out)\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n```\n\nsrc/bracketnest/__init__.py\n```python\nfrom .nesting_service import NestingService\n\ndef is_nested(string: str) -> bool:\n    \"\"\"\n    Convenience function to check if a bracket string contains a nested subsequence.\n    This function wraps the core NestingService logic.\n    \"\"\"\n    service = NestingService()\n    analysis = service.analyze(string)\n    return analysis.is_nested\n```\n\npyproject.toml\n```toml\n[project]\nname = \"bracketnest\"\nversion = \"0.1.0\"\ndescription = \"A library and CLI to detect nested bracket subsequences.\"\nauthors = [\"Your Name <you@example.com>\"]\nlicense = \"MIT\"\nreadme = \"README.md\"\nrequires-python = \">=3.8\"\nkeywords = [\"brackets\", \"nesting\", \"subsequence\", \"cli\", \"library\"]\nclassifiers = [\n    \"Programming Language :: Python :: 3\",\n    \"License :: OSI Approved :: MIT License\",\n    \"Operating System :: OS Independent\",\n    \"Topic :: Software Development :: Libraries :: Python Modules\",\n]\n\n[project.urls]\nHomepage = \"https://github.com/yourusername/bracketnest\"\n\"Bug Tracker\" = \"https://github.com/yourusername/bracketnest/issues\"\n\n[project.scripts]\nbracketnest = \"bracketnest.cli:main\"\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[tool.setuptools]\npackages = [\"bracketnest\"]\npackage-dir = {\"\" = \"src\"}\n\n[tool.setuptools.package-data]\nbracketnest = [\"py.typed\"]\n\n# Add development dependencies if needed, e.g., for testing\n[project.group.dev.dependencies]\npytest = \"^7.0\"\nmypy = \"^1.0\"\nblack = \"^23.0\"\nisort = \"^5.0\"\n```\n\nREADME.md\n```markdown\n# BracketNest\n\nA Python library and command-line interface (CLI) to determine whether a string of square brackets contains a valid subsequence of brackets where at least one bracket in the subsequence is nested (e.g., `[[]]`).\n\n## Features\n\n-   **Reliable Algorithm**: Detects nested bracket subsequences efficiently (O(N) time complexity).\n-   **Programmatic API**: Use the `is_nested()` function in your Python projects.\n-   **CLI Tool**: Analyze bracket strings directly from your terminal.\n-   **Input Validation**: Ensures only valid bracket characters (`[` and `]`) are processed.\n-   **Optional Persistence**: CLI can save analysis results to a local JSON file.\n\n## Installation\n\n```bash\npip install bracketnest # (Replace with actual package name when published)\n```\nOr, if you clone the repository:\n```bash\ngit clone https://github.com/yourusername/bracketnest.git\ncd bracketnest\npip install .\n```\n\n## Usage\n\n### Command-Line Interface (CLI)\n\n```bash\n# Check a string for nested brackets\nbracketnest \"[[]]\"\n# Output:\n# Input: '[[]]'\n# Nested subsequence found: True\n# Indices: 0, 1, 2, 3\n\nbracketnest \"[]]]]]]][[[[[]\"\n# Output:\n# Input: '[]]]]]]][[[[[]'\n# Nested subsequence found: False\n# Indices: None\n\n# Get JSON output\nbracketnest \"[[][]]\" --json\n# Output:\n# {\n#   \"input\": \"[[][]]\",\n#   \"is_nested\": true,\n#   \"nested_indices\": [\n#     0,\n#     1,\n#     2,\n#     4\n#   ]\n# }\n\n# Invalid input\nbracketnest \"[abc]\"\n# Output:\n# Error: Invalid characters in input: '[abc]'. Only '[' and ']' are allowed. (printed to stderr)\n\n# With optional persistence\nbracketnest \"[[]]\" --persist\n# This will save the analysis to 'analyses.json' in the current directory.\n```\n\nExit Codes for CLI:\n- `0`: Analysis successful, no nested subsequence found.\n- `1`: Analysis successful, nested subsequence found.\n- `2`: Invalid input or an unexpected error occurred.\n\n### Programmatic API\n\n```python\nfrom bracketnest import is_nested\nfrom bracketnest.api_controller import APIController\nfrom bracketnest.exceptions import InvalidBracketStringError\n\n# Simple boolean check\nprint(is_nested(\"[[]]\")) # Output: True\nprint(is_nested(\"[]]]]]]][[[[[]\")) # Output: False\nprint(is_nested(\"[][]\")) # Output: False\n\n# Using the APIController for detailed results (dict)\napi = APIController()\ntry:\n    result = api.analyze(\"[[]][[\")\n    print(result)\n    # Output: {'input': '[[]][[', 'is_nested': True, 'nested_indices': [0, 1, 2, 3]}\n\n    result_no_nested = api.analyze(\"[][][][\")\n    print(result_no_nested)\n    # Output: {'input': '[][][][', 'is_nested': False, 'nested_indices': []}\n\nexcept InvalidBracketStringError as e:\n    print(f\"API Error: {e}\")\n\n# Example of an invalid string\ntry:\n    is_nested(\"[a]\")\nexcept InvalidBracketStringError as e:\n    print(f\"Validation Error: {e}\") # Output: Validation Error: Invalid characters in input: '[a]'. Only '[' and ']' are allowed.\n```\n\n## Development\n\n### Running Tests\n\nTo run the (planned) unit and integration tests, you would typically use `pytest`:\n\n```bash\npip install pytest\npytest\n```\n\n### CI/CD\n\nA GitHub Actions workflow is provided in `.github/workflows/ci.yml` for continuous integration.\n\n```yaml\n# .github/workflows/ci.yml\nname: CI\n\non:\n  push:\n    branches: [ main ]\n  pull_request:\n    branches: [ main ]\n\njobs:\n  build:\n    runs-on: ubuntu-latest\n    strategy:\n      matrix:\n        python-version: [\"3.8\", \"3.9\", \"3.10\", \"3.11\"]\n\n    steps:\n    - uses: actions/checkout@v3\n    - name: Set up Python ${{ matrix.python-version }}\n      uses: actions/setup-python@v4\n      with:\n        python-version: ${{ matrix.python-version }}\n    - name: Install dependencies\n      run: |\n        python -m pip install --upgrade pip\n        pip install poetry # Or pip install . if using setuptools\n        poetry install --no-root # For poetry projects, otherwise `pip install .`\n    - name: Test with pytest\n      run: |\n        poetry run pytest # Or pytest directly\n```\n\n### Project Structure\n\n```\n.\n\u251c\u2500\u2500 src/\n\u2502   \u2514\u2500\u2500 bracketnest/\n\u2502       \u251c\u2500\u2500 __init__.py           # Package initializer, exposes `is_nested`\n\u2502       \u251c\u2500\u2500 bracket_analysis.py   # Data model: `BracketAnalysis` DTO\n\u2502       \u251c\u2500\u2500 nesting_service.py    # Core logic: `NestingService` with O(N) algorithm\n\u2502       \u251c\u2500\u2500 analysis_repository.py# Optional persistence: `AnalysisRepository`\n\u2502       \u251c\u2500\u2500 validator.py          # Help