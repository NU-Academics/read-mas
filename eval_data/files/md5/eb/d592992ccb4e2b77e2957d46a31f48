 number.\" in response.json()[\"detail\"]\n\n    def test_post_mad_non_list_input_bad_request(self, client):\n        response = client.post(\"/mad\", json={\"numbers\": \"not a list\"})\n        assert response.status_code == 400\n        assert \"Invalid payload: 'numbers' must be a list.\" in response.json()[\"detail\"]\n\n    def test_post_mad_missing_numbers_bad_request(self, client):\n        response = client.post(\"/mad\", json={})\n        assert response.status_code == 422 # Pydantic validation error for missing field\n        assert \"numbers\" in response.json()[\"detail\"][0][\"loc\"]\n        assert \"Field required\" in response.json()[\"detail\"][0][\"msg\"]\n\n    def test_post_mad_with_persistence(self, client, temp_repo_file):\n        initial_size = os.path.getsize(temp_repo_file) if os.path.exists(temp_repo_file) else 0\n\n        numbers = [10.0, 20.0, 30.0]\n        response = client.post(\"/mad\", json={\"numbers\": numbers, \"persist\": True})\n        assert response.status_code == 200\n        data = response.json()\n        assert abs(data[\"mean\"] - 20.0) < 1e-9\n        assert abs(data[\"mad\"] - (20.0 / 3.0)) < 1e-9\n        assert data[\"count\"] == 3\n\n        # Verify that a record was added to the persistence file\n        current_size = os.path.getsize(temp_repo_file)\n        assert current_size > initial_size\n\n        with open(temp_repo_file, \"r\") as f:\n            lines = f.readlines()\n            assert len(lines) >= 1 # Could be multiple if other tests persisted\n            last_record = json.loads(lines[-1])\n            assert \"id\" in last_record\n            assert \"timestamp\" in last_record\n            assert abs(last_record[\"mean\"] - 20.0) < 1e-9\n            assert abs(last_record[\"mad\"] - (20.0 / 3.0)) < 1e-9\n            assert last_record[\"count\"] == 3\n            assert last_record[\"sample\"] == numbers\n            assert last_record[\"version\"] == 1\n\n    def test_post_mad_api_key_required