sert_not_called() # Should short-circuit\n\ndef test_will_fly_false_too_heavy(flight_service, mock_validators):\n    pal_mock, weight_mock = mock_validators\n    pal_mock.is_palindrome.return_value = True\n    weight_mock.total_weight.return_value = 8\n    \n    payload = Payload([3, 2, 3], 1)\n    will_fly, reason = flight_service.will_it_fly(payload)\n    \n    assert will_fly is False\n    assert reason == \"too heavy: 8 > 1\"\n    pal_mock.is_palindrome.assert_called_once_with([3, 2, 3])\n    weight_mock.total_weight.assert_called_once_with([3, 2, 3])\n\n# --- Test cases with validation errors ---\ndef test_will_it_fly_invalid_q_type():\n    pal_validator = PalindromeValidator()\n    weight_validator = WeightValidator()\n    service = FlightService(pal_validator, weight_validator)\n\n    # q is not a list\n    with pytest.raises(InvalidPayloadError, match=\"q must be a list of integers\"):\n        Payload(\"not a list\", 5).validate() # validate is called internally by service.will_it_fly\n\ndef test_will_it_fly_invalid_q_elements():\n    pal_validator = PalindromeValidator()\n    weight_validator = WeightValidator()\n    service = FlightService(pal_validator, weight_validator)\n\n    # q contains non-integers\n    payload = Payload([1, \"a\"], 5)\n    with pytest.raises(InvalidPayloadError, match=\"all elements of q must be integers\"):\n        service.will_it_fly(payload)\n\ndef test_will_it_fly_invalid_w_type():\n    pal_validator = PalindromeValidator()\n    weight_validator = WeightValidator()\n    service = FlightService(pal_validator, weight_validator)\n\n    # w is not an integer\n    payload = Payload([1, 2], \"not an int\")\n    with pytest.raises(InvalidPayloadError, match=\"w must be an integer\"):\n        service.will_it_fly(payload)\n\n```\n```python\n# tests/integration/test_http_controller.py\nimport pytest\nimport httpx\nfrom fastapi import FastAPI\nfrom will_it_fly.app import AppFactory\n\n@pytest.fixture(scope=\"module\")\ndef app_client():