{"task_id": "HumanEval/54", "solution": "```python\nimport logging\nfrom logging.handlers import RotatingFileHandler\nimport json\nfrom datetime import datetime\nimport os\nimport sys\n\n# --- src/samechars/exceptions.py ---\nclass ComparisonError(Exception):\n    \"\"\"\n    Exception raised for comparison-related errors.\n    Attributes: message -- explanation of the error.\n    \"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\n# --- src/samechars/utils.py ---\nclass CharSetUtils:\n    \"\"\"\n    Utility class for string validation and previewing.\n    Provides methods to ensure string types and truncate long strings for display.\n    \"\"\"\n    @staticmethod\n    def validate_string(s: any) -> str:\n        \"\"\"\n        Validates if the input is a string.\n        Raises TypeError if the input is not a string.\n        \"\"\"\n        if not isinstance(s, str):\n            raise TypeError(f\"Input must be a string, but received {type(s).__name__}\")\n        return s\n\n    @staticmethod\n    def preview(s: str, max_len: int = 200) -> str:\n        \"\"\"\n        Generates a preview of a string, truncating if necessary.\n        Appends \"...\" if the string is longer than max_len.\n        \"\"\"\n        if len(s) > max_len:\n            return s[:max_len] + \"...\"\n        return s\n\n# --- src/samechars/models.py ---\nclass ComparisonRequest:\n    \"\"\"\n    Data Transfer Object for comparison requests.\n    Holds the two strings to be compared.\n    \"\"\"\n    def __init__(self, s0: str, s1: str) -> None:\n        self.s0 = s0\n        self.s1 = s1\n\nclass ComparisonResult:\n    \"\"\"\n    Data Transfer Object for comparison results.\n    Contains the boolean outcome and the character sets of both inputs.\n    \"\"\"\n    def __init__(self, same: bool, lhs_chars: set[str], rhs_chars: set[str]) -> None:\n        self.same = same\n        self.lhs_chars = lhs_chars\n        self.rhs_chars = rhs_chars\n\n    def to_dict(self) -> dict:\n        \"\"\"\n        Converts the comparison result to a serializable dictionary.\n        This is useful for logging or API responses.\n        \"\"\"\n        return {\n            \"same\": self.same,\n            \"lhs_chars\": sorted(list(self.lhs_chars)),\n            \"rhs_chars\": sorted(list(self.rhs_chars))\n        }\n\n# --- src/samechars/comparator.py ---\nclass CharsetComparator:\n    \"\"\"\n    Core component for comparing character sets of two strings.\n    It computes unique character sets and determines their equality.\n    \"\"\"\n    def compare(self, s0: str, s1: str) -> ComparisonResult:\n        \"\"\"\n        Compares two strings for character set equality.\n        Returns a ComparisonResult indicating if they are the same and their character sets.\n        \"\"\"\n        lhs = self._compute_char_set(s0)\n        rhs = self._compute_char_set(s1)\n        same = lhs == rhs\n        return ComparisonResult(same=same, lhs_chars=lhs, rhs_chars=rhs)\n\n    def _compute_char_set(self, s: str) -> set[str]:\n        \"\"\"\n        Helper method to compute the set of unique characters in a string.\n        This method is private to encapsulate the set creation logic.\n        \"\"\"\n        return set(s)\n\n# --- src/samechars/adapters/log_adapter.py ---\nclass FileLogAdapter:\n    \"\"\"\n    Adapter for writing structured comparison logs to a rotating file.\n    Ensures logs are written asynchronously and rotated by size.\n    \"\"\"\n    def __init__(self, path: str = \"./logs/compare.log\", max_bytes: int = 5_000_000, backup_count: int = 5) -> None:\n        self._path = path\n        self._logger = logging.getLogger(f\"samechars.{id(self)}\")\n        self._logger.setLevel(logging.INFO)\n        self._logger.propagate = False # Prevent logs from going to root logger\n        \n        # Ensure log directory exists\n        log_dir = os.path.dirname(path)\n        if log_dir and not os.path.exists(log_dir):\n            try:\n                os.makedirs(log_dir)\n            except OSError as e:\n                logging.error(f\"Could not create log directory {log_dir}: {e}\")\n                self._logger.addHandler(logging.StreamHandler(sys.stderr)) # Fallback\n                return\n\n        # Add handler only if not already present for this specific logger instance\n        if not self._logger.handlers: \n            try:\n                handler = RotatingFileHandler(path, maxBytes=max_bytes, backupCount=backup_count)\n                handler.setFormatter(logging.Formatter('%(message)s')) # Log JSON directly\n                self._logger.addHandler(handler)\n            except Exception as e:\n                logging.error(f\"Failed to set up RotatingFileHandler at {path}: {e}\", exc_info=True)\n                self._logger.addHandler(logging.StreamHandler(sys.stderr)) # Fallback\n\n    def log(self, request: ComparisonRequest, result: ComparisonResult) -> None:\n        \"\"\"\n        Logs a comparison request and its result to the configured file.\n        Input strings are previewed to prevent logging excessively large payloads.\n        \"\"\"\n        try:\n            log_entry = {\n                \"timestamp\": datetime.now().isoformat(timespec='milliseconds') + \"Z\", # ISO8601 with Z for UTC\n                \"lhs_preview\": CharSetUtils.preview(request.s0),\n                \"rhs_preview\": CharSetUtils.preview(request.s1),\n                \"lhs_chars\": sorted(list(result.lhs_chars)),\n                \"rhs_chars\": sorted(list(result.rhs_chars)),\n                \"result\": result.same\n            }\n            self._logger.info(json.dumps(log_entry))\n        except Exception as e:\n            # Best-effort logging; errors are logged to stderr but do not interrupt the main flow.\n            logging.error(f\"Failed to log comparison: {e}\", exc_info=True)\n\n# --- src/samechars/service.py ---\nclass ComparisonService:\n    \"\"\"\n    Coordinates the comparison workflow, handling validation, core comparison, and logging.\n    Acts as the application layer, orchestrating domain and infrastructure components.\n    \"\"\"\n    def __init__(self, comparator: CharsetComparator, logger_adapter: FileLogAdapter) -> None:\n        self._comparator = comparator\n        self._logger = logger_adapter\n\n    def compare(self, request: ComparisonRequest) -> ComparisonResult:\n        \"\"\"\n        Performs a character set comparison based on the request.\n        Validates inputs, executes comparison, logs the outcome, and returns the result.\n        \"\"\"\n        # Validate request parameters as per FR2: \"invalid request raises ComparisonError\"\n        try:\n            CharSetUtils.validate_string(request.s0)\n            CharSetUtils.validate_string(request.s1)\n        except TypeError as e:\n            raise ComparisonError(f\"Service received invalid input type: {e}\") from e\n\n        result = self._comparator.compare(request.s0, request.s1)\n        try:\n            self._logger.log(request, result)\n        except Exception:\n            # Best-effort logging; failures here do not block the comparison result.\n            pass\n        return result\n\n# --- src/samechars/__init__.py convenience function ---\ndef same_chars(s0: str, s1: str) -> bool:\n    \"\"\"\n    Checks if two strings contain the exact same set of characters.\n    This function uses the core library components for robust comparison and logging.\n    \"\"\"\n    # Initialize basic logging to stderr for general errors if not already configured.\n    if not logging.root.handlers:\n        logging.basicConfig(level=logging.WARNING, stream=sys.stderr, format='%(asctime)s - %(levelname)s - %(message)s')\n\n    # FR1: Preconditions: s0 and s1 are provided. Both must be Python strs.\n    # FR1: Error handling: non-str inputs raise TypeError.\n    # This validation directly addresses FR1 for the 'same_chars' function's contract.\n    CharSetUtils.validate_string(s0)\n    CharSetUtils.validate_string(s1)\n\n    comparator = CharsetComparator()\n    # The design specifies a default log file path.\n    logger = FileLogAdapter(path=\"./logs/compare.log\")\n    service = ComparisonService(comparator, logger)\n    \n    req = ComparisonRequest(s0, s1)\n    \n    # The service's compare method will perform its own validation and logging.\n    # It wraps TypeErrors into ComparisonError, aligning with FR2 for service contract.\n    # If the service encounters an issue and raises ComparisonError, it will propagate.\n    result = service.compare(req)\n    return result.same\n```"}
