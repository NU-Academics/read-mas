{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by swapping case and shifting vowels two positions ahead.\n    Non-letter characters are passed through unchanged as per examples.\n    \"\"\"\n    _VOWELS = {'a', 'e', 'i', 'o', 'u'}\n    _SHIFT_AMOUNT = 2\n\n    def _is_letter(char):\n        return 'a' <= char.lower() <= 'z'\n\n    def _swap_case(char):\n        if char.islower():\n            return char.upper()\n        else:  # Assumes char is uppercase if not lowercase, due to outer _is_letter check.\n            return char.lower()\n\n    def _shift_letter(char, shift):\n        if char.islower():\n            start = ord('a')\n        else:  # char.isupper()\n            start = ord('A')\n        \n        shifted_ord = start + (ord(char) - start + shift) % 26\n        return chr(shifted_ord)\n\n    encoded_chars = []\n    for char in message:\n        if _is_letter(char):\n            swapped_char = _swap_case(char)\n            # Check if the swapped character, when lowercased, is a vowel\n            if swapped_char.lower() in _VOWELS:\n                encoded_chars.append(_shift_letter(swapped_char, _SHIFT_AMOUNT))\n            else:\n                encoded_chars.append(swapped_char)\n        else:\n            encoded_chars.append(char) # Pass through non-letters\n\n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/94", "solution": "```python\ndef skjkasdkd(lst):\n    \"\"\"Finds the largest prime in a list and returns the sum of its digits.\n    Returns 0 if no prime is found.\n    \"\"\"\n\n    def _is_prime(n: int) -> bool:\n        \"\"\"Determines if an integer is prime using trial division and Miller-Rabin.\"\"\"\n        if n < 2:\n            return False\n        if n == 2 or n == 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n\n        # Small primes for initial trial division, as suggested by design.\n        _small_primes_for_trial = [5, 7, 11, 13, 17, 19, 23, 29]\n        for p in _small_primes_for_trial:\n            if n == p:\n                return True\n            if n % p == 0:\n                return False\n            if p * p > n: # Optimize: stop trial division if p exceeds sqrt(n).\n                break\n        \n        # Miller-Rabin primality test for larger numbers.\n        # Bases [2, 3, 5, 7, 11, 13] provide deterministic results for N < 341,550,071,728,321 (within 64-bit).\n        s = 0\n        d = n - 1\n        while d % 2 == 0:\n            d //= 2\n            s += 1\n\n        bases = [2, 3, 5, 7, 11, 13]\n        \n        for a in bases:\n            if n == a: # If n itself is one of the test bases, it's prime.\n                return True\n            \n            x = pow(a, d, n)\n            if x == 1 or x == n - 1:\n                continue\n\n            for _ in range(s - 1):\n                x = pow(x, 2, n)\n                if x == n - 1:\n                    break\n            else: # If loop finishes without x == n-1, n is composite.\n                return False\n\n        return True # n is prime (deterministic for numbers within the range of these bases).\n\n    def _sum_digits(num: int) -> int:\n        \"\"\"Calculates the sum of the absolute value of a number's digits.\"\"\"\n        return sum(int(digit) for digit in str(abs(num)))\n\n    largest_prime = None\n    prime_cache = {} # An in-memory cache to store primality results for efficiency.\n\n    # Create a set of unique candidates >= 2 to reduce redundant checks and comply with business rules.\n    unique_candidates = set(x for x in lst if x >= 2)\n\n    for num in unique_candidates:\n        is_p = prime_cache.get(num) # Check if primality result is already cached.\n\n        if is_p is None: # If not in cache, compute primality and store the result.\n            is_p = _is_prime(num)\n            prime_cache[num] = is_p\n\n        if is_p:\n            if largest_prime is None or num > largest_prime:\n                largest_prime = num\n\n    if largest_prime is None:\n        return 0 # As per business rule: return 0 if no primes are found in the list.\n    else:\n        return _sum_digits(largest_prime)\n\n```"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"Finds the largest prime in a list and returns the sum of its digits.\n    Returns 0 if no prime numbers are found.\n    \"\"\"\n\n    def _sum_digits(n: int) -> int:\n        \"\"\"Calculates the sum of the absolute value of a number's digits.\"\"\"\n        return sum(int(d) for d in str(abs(n)))\n\n    def _is_prime(n: int) -> bool:\n        \"\"\"Determines if a number is prime using a deterministic Miller-Rabin test.\"\"\"\n        if n < 2:\n            return False\n        if n == 2 or n == 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        \n        # Optimized trial division for small numbers\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n\n        # Miller-Rabin for larger numbers with deterministic bases for N < 2^64\n        # These bases cover all integers up to 2^64-1 for primality testing.\n        bases = [2, 325, 9375, 28178, 450775, 9780504, 1795265022]\n\n        def _miller_rabin_test(d, s, n, a):\n            x = pow(a, d, n)\n            if x == 1 or x == n - 1:\n                return True\n            for _ in range(s - 1):\n                x = pow(x, 2, n)\n                if x == n - 1:\n                    return True\n            return False\n\n        # Write (n - 1) as d * 2^s + 1\n        s = 0\n        d = n - 1\n        while d % 2 == 0:\n            d //= 2\n            s += 1\n        \n        for a in bases:\n            if a >= n: # Base must be less than n for the test to be valid\n                continue\n            if not _miller_rabin_test(d, s, n, a):\n                return False\n        return True\n\n    largest_prime = None\n\n    for num in lst:\n        if _is_prime(num):\n            if largest_prime is None or num > largest_prime:\n                largest_prime = num\n\n    if largest_prime is None:\n        return 0\n    else:\n        return _sum_digits(largest_prime)"}
