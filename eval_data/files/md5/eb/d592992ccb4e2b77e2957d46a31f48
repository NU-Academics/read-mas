{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"Calculates the Brazilian factorial, defined as the product of k! for k from 1 to n.\n    This function computes factorials incrementally to optimize for large n.\n    \"\"\"\n    current_factorial = 1\n    brazilian_result = 1\n\n    for k in range(1, n + 1):\n        current_factorial *= k\n        brazilian_result *= current_factorial\n        \n    return brazilian_result"}
{"task_id": "HumanEval/139", "solution": "def _factorial(k):\n    \"\"\"Computes the factorial of a non-negative integer k iteratively.\"\"\"\n    res = 1\n    for i in range(1, k + 1):\n        res *= i\n    return res\n\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n    \"\"\"\n    brazilian_fact = 1\n    for k in range(1, n + 1):\n        current_factorial = _factorial(k)\n        brazilian_fact *= current_factorial\n    return brazilian_fact"}
{"task_id": "HumanEval/140", "solution": "```python\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores, \n    and if a string has more than 2 consecutive spaces, \n    then replace all consecutive spaces with - \n    \n    fix_spaces(\"Example\") == \"Example\"\n    fix_spaces(\"Example 1\") == \"Example_1\"\n    fix_spaces(\" Example 2\") == \"_Example_2\"\n    fix_spaces(\" Example   3\") == \"_Example-3\"\n    \"\"\"\n    SPACE_CHAR = \" \"\n    UNDERSCORE = \"_\"\n    HYPHEN = \"-\"\n\n    out = []\n    i = 0\n    n = len(text)\n    while i < n:\n        if text[i] != SPACE_CHAR:\n            out.append(text[i])\n            i += 1\n        else:\n            j = i\n            while j < n and text[j] == SPACE_CHAR:\n                j += 1\n            run_len = j - i\n            if run_len >= 3:\n                out.append(HYPHEN)\n            else:\n                out.append(UNDERSCORE * run_len)\n            i = j\n    return \"\".join(out)\n```"}
{"task_id": "HumanEval/140", "solution": "def fix_spaces(text):\n    \"\"\"\n    Replaces runs of 1 or 2 spaces with '_' and runs of 3 or more spaces with '-'.\n    Other characters remain unchanged.\n    \"\"\"\n    out = []\n    i = 0\n    n = len(text)\n    \n    SPACE = \" \"\n    UNDERSCORE = \"_\"\n    HYPHEN = \"-\"\n    MIN_RUN_FOR_HYPHEN = 3\n\n    while i < n:\n        if text[i] == SPACE:\n            j = i\n            while j < n and text[j] == SPACE:\n                j += 1\n            run_length = j - i\n            if run_length >= MIN_RUN_FOR_HYPHEN:\n                out.append(HYPHEN)\n            else:\n                out.append(UNDERSCORE)\n            i = j\n        else:\n            out.append(text[i])\n            i += 1\n    return \"\".join(out)"}
{"task_id": "HumanEval/141", "solution": "```python\ndef file_name_check(file_name):\n    \"\"\"Checks if a file's name is valid based on specific rules.\n    Returns 'Yes' if valid, 'No' otherwise.\n    \"\"\"\n    \n    # Rule: No more than three digits ('0'-'9') in the file's name.\n    digit_count = 0\n    for char in file_name:\n        if '0' <= char <= '9':\n            digit_count += 1\n    if digit_count > 3:\n        return 'No'\n\n    # Rule: The file's name contains exactly one dot '.'\n    if file_name.count('.') != 1:\n        return 'No'\n\n    # Split into prefix and suffix after ensuring exactly one dot.\n    prefix, suffix = file_name.rsplit('.', 1)\n\n    # Rule: The substring before the dot should not be empty.\n    if not prefix:\n        return 'No'\n\n    # Rule: The substring before the dot starts with a letter from the latin alphabet.\n    first_char_of_prefix = prefix[0]\n    if not ('a' <= first_char_of_prefix <= 'z' or 'A' <= first_char_of_prefix <= 'Z'):\n        return 'No'\n\n    # Rule: The substring after the dot should be one of these: ['txt', 'exe', 'dll'] (case-insensitive).\n    allowed_extensions = ['txt', 'exe', 'dll']\n    if suffix.lower() not in allowed_extensions:\n        return 'No'\n\n    # If all checks pass, the file name is valid.\n    return 'Yes'\n```"}
{"task_id": "HumanEval/141", "solution": "```python\ndef file_name_check(file_name):\n    \"\"\"\n    Checks if a file name is valid based on specific rules.\n    Returns 'Yes' if all conditions are met, otherwise 'No'.\n    \"\"\"\n    \n    # Rule: The file's name contains exactly one dot '.'\n    if file_name.count('.') != 1:\n        return 'No'\n\n    prefix, suffix = file_name.split('.', 1)\n\n    # Rule: The substring before the dot should not be empty\n    if not prefix:\n        return 'No'\n\n    # Rule: The substring before the dot starts with a letter from the latin alphabet\n    first_char_of_prefix = prefix[0]\n    if not ('a' <= first_char_of_prefix <= 'z' or 'A' <= first_char_of_prefix <= 'Z'):\n        return 'No'\n\n    # Rule: The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    allowed_suffixes = ['txt', 'exe', 'dll']\n    if suffix not in allowed_suffixes:\n        return 'No'\n\n    # Rule: There should not be more than three digits ('0'-'9') in the file's name.\n    digit_count = 0\n    for char in file_name:\n        if '0' <= char <= '9':\n            digit_count += 1\n    if digit_count > 3:\n        return 'No'\n\n    return 'Yes'\n```"}
{"task_id": "HumanEval/142", "solution": "```python\ndef sum_squares(lst):\n    \"\"\"\n    Computes a sum over a list of integers with index-based transformations.\n    Squares elements at indices divisible by 3, cubes elements at indices divisible by 4 but not 3.\n    \"\"\"\n    total_sum = 0\n    for i, v in enumerate(lst):\n        if i % 3 == 0:\n            total_sum += v ** 2\n        elif i % 4 == 0:\n            total_sum += v ** 3\n        else:\n            total_sum += v\n    return total_sum\n```"}
{"task_id": "HumanEval/142", "solution": "```python\ndef sum_squares(lst):\n    \"\"\"\n    Computes a specialized sum transformation for a list of integers.\n    Squares entries at indices multiple of 3, cubes entries at indices multiple of 4 (if not multiple of 3).\n    \"\"\"\n    transformed_values = []\n    for i, value in enumerate(lst):\n        if i % 3 == 0:\n            transformed_values.append(value ** 2)\n        elif i % 4 == 0:\n            transformed_values.append(value ** 3)\n        else:\n            transformed_values.append(value)\n    return sum(transformed_values)\n```"}
{"task_id": "HumanEval/143", "solution": "import math\n\ndef words_in_sentence(sentence):\n    \"\"\"\n    Returns words from the sentence whose lengths are prime numbers.\n    Words are separated by spaces; order is preserved.\n    \"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if a number is prime using an optimized basic algorithm.\"\"\"\n        if n < 2:\n            return False\n        if n % 2 == 0:\n            return n == 2\n        r = int(math.sqrt(n))\n        for i in range(3, r + 1, 2):\n            if n % i == 0:\n                return False\n        return True\n\n    words = [w for w in sentence.strip().split() if w]\n    out = [word for word in words if is_prime(len(word))]\n    return \" \".join(out)"}
{"task_id": "HumanEval/143", "solution": "from math import isqrt\n\n# A cache for primality results, as per the design's PrimeChecker concept.\n# Initializes with base cases for numbers relevant to word lengths (>= 1).\n_is_prime_cache = {1: False, 2: True, 3: True}\n\ndef is_prime(n: int) -> bool:\n    \"\"\"\n    Checks if a positive integer is a prime number, using a cache for efficiency.\n    Handles n >= 1; non-positive numbers are not expected as word lengths.\n    \"\"\"\n    if n < 2:  # 0 and 1 are not prime numbers.\n        return False\n    if n in _is_prime_cache:\n        return _is_prime_cache[n]\n    if n % 2 == 0:\n        _is_prime_cache[n] = (n == 2)\n        return _is_prime_cache[n]\n    limit = isqrt(n)\n    for i in range(3, limit + 1, 2):\n        if n % i == 0:\n            _is_prime_cache[n] = False\n            return False\n    _is_prime_cache[n] = True\n    return True\n\ndef words_in_sentence(sentence: str) -> str:\n    \"\"\"\n    Filters words from a sentence, keeping only those with prime lengths.\n    Words in the output maintain their original order.\n    \"\"\"\n    words = sentence.split(' ')\n    \n    filtered_words = []\n    for word in words:\n        if is_prime(len(word)):\n            filtered_words.append(word)\n            \n    return \" \".join(filtered_words)"}
{"task_id": "HumanEval/144", "solution": "import math\n\ndef simplify(x, n):\n    \"\"\"Checks if the product of two fractions is a whole number.\n    Inputs x and n are strings like \"numerator/denominator\" with positive integers.\n    \"\"\"\n\n    def _parse_fraction(s: str) -> tuple[int, int]:\n        \"\"\"Parses a fraction string into its numerator and denominator integers.\"\"\"\n        num_s, den_s = s.split('/')\n        return int(num_s), int(den_s)\n\n    def _multiply_fractions(num1: int, den1: int, num2: int, den2: int) -> tuple[int, int]:\n        \"\"\"Multiplies two fractions and returns the product's numerator and denominator.\"\"\"\n        return num1 * num2, den1 * den2\n\n    def _reduce_fraction(numerator: int, denominator: int) -> tuple[int, int]:\n        \"\"\"Reduces a fraction to its simplest form using the greatest common divisor.\"\"\"\n        common_divisor = math.gcd(numerator, denominator)\n        return numerator // common_divisor, denominator // common_divisor\n\n    # Parse the input fraction strings\n    num_x, den_x = _parse_fraction(x)\n    num_n, den_n = _parse_fraction(n)\n\n    # Compute the product of the two fractions\n    product_num, product_den = _multiply_fractions(num_x, den_x, num_n, den_n)\n\n    # Reduce the product fraction to its simplest form\n    reduced_num, reduced_den = _reduce_fraction(product_num, product_den)\n\n    # Determine if the reduced product is a whole number (denominator is 1)\n    return reduced_den == 1"}
{"task_id": "HumanEval/144", "solution": "```python\ndef simplify(x, n):\n    \"\"\"Checks if the product of two fractions x and n is a whole number.\n    Assumes x and n are valid fraction strings of positive whole numbers.\n    \"\"\"\n    def _gcd(a, b):\n        \"\"\"Calculates the greatest common divisor of two integers.\"\"\"\n        while b:\n            a, b = b, a % b\n        return a\n\n    # Parse the first fraction x\n    x_num_str, x_den_str = x.split('/')\n    x_num = int(x_num_str)\n    x_den = int(x_den_str)\n\n    # Parse the second fraction n\n    n_num_str, n_den_str = n.split('/')\n    n_num = int(n_num_str)\n    n_den = int(n_den_str)\n\n    # Calculate the numerator and denominator of the product\n    product_num = x_num * n_num\n    product_den = x_den * n_den\n\n    # Reduce the product fraction to its lowest terms\n    common_divisor = _gcd(product_num, product_den)\n    reduced_den = product_den // common_divisor\n\n    # A fraction is a whole number if its reduced denominator is 1\n    return reduced_den == 1\n```"}
{"task_id": "HumanEval/145", "solution": "```python\ndef order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers by the sum of their digits, maintaining stability for ties.\n    Digit sums are computed from the absolute value of numbers.\n    \"\"\"\n    def _compute_digit_sum_inline(n):\n        \"\"\"Calculates the sum of digits for the absolute value of an integer.\"\"\"\n        return sum(int(d) for d in str(abs(n)))\n\n    indexed_nums = []\n    for i, num in enumerate(nums):\n        digit_sum = _compute_digit_sum_inline(num)\n        indexed_nums.append((digit_sum, i, num))\n\n    indexed_nums.sort()\n\n    sorted_values = [item[2] for item in indexed_nums]\n\n    return sorted_values\n```"}
{"task_id": "HumanEval/145", "solution": "```python\ndef order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers by the sum of their digits in ascending order.\n    Ties are broken by preserving the original input order (using original index).\n    \"\"\"\n\n    def _compute_digit_sum(n: int) -> int:\n        \"\"\"\n        Computes the sum of the absolute value's digits for an integer.\n        \"\"\"\n        return sum(int(d) for d in str(abs(n)))\n\n    items_with_keys = []\n    for index, value in enumerate(nums):\n        digit_sum = _compute_digit_sum(value)\n        # Store a tuple (digit_sum, original_index, original_value)\n        # Python's default tuple sorting will use digit_sum first, then original_index for ties.\n        items_with_keys.append((digit_sum, index, value))\n\n    # Sort the list of tuples. The sort is stable.\n    items_with_keys.sort()\n\n    # Extract the original values from the sorted list of tuples.\n    return [item[2] for item in items_with_keys]\n```"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"Counts numbers greater than 10 whose first and last digits are odd.\n    Digits are considered for the absolute value of the number.\n    \"\"\"\n    count = 0\n    odd_digits = {1, 3, 5, 7, 9}\n\n    for num in nums:\n        if num <= 10:\n            continue\n\n        s_abs = str(abs(num))\n        first_digit = int(s_abs[0])\n        last_digit = int(s_abs[-1])\n\n        if first_digit in odd_digits and last_digit in odd_digits:\n            count += 1\n\n    return count"}
{"task_id": "HumanEval/146", "solution": "```python\ndef specialFilter(nums):\n    \"\"\"Counts numbers in an array that are > 10 and have odd first and last digits.\"\"\"\n\n    def _get_first_digit(n: int) -> int:\n        \"\"\"Helper to get the first digit of an integer's absolute value.\"\"\"\n        v = abs(n)\n        while v >= 10:\n            v //= 10\n        return v\n\n    def _get_last_digit(n: int) -> int:\n        \"\"\"Helper to get the last digit of an integer's absolute value.\"\"\"\n        return abs(n) % 10\n\n    count = 0\n    for num in nums:\n        if num > 10:\n            first = _get_first_digit(num)\n            last = _get_last_digit(num)\n            if first % 2 == 1 and last % 2 == 1:\n                count += 1\n    return count\n```"}
{"task_id": "HumanEval/147", "solution": "```python\ndef get_max_triples(n: int) -> int:\n    \"\"\"\n    Computes the number of index triples (i < j < k) from the sequence a[i] = i*i - i + 1\n    whose sum is divisible by 3. Uses O(1) combinatorial counting.\n    \"\"\"\n\n    # Helper function for combinations (n choose k).\n    # Since only k=3 is used, optimized for this case.\n    def comb(N, K):\n        if K < 0 or K > N:\n            return 0\n        if K == 0 or K == N:\n            return 1\n        if K == 1:\n            return N\n        if K == 2:\n            return N * (N - 1) // 2\n        if K == 3:\n            return N * (N - 1) * (N - 2) // 6\n        # Fallback for other k, though not strictly needed here.\n        res = 1\n        for i in range(K):\n            res = res * (N - i) // (i + 1)\n        return res\n\n    # Analyze the pattern of a[i] % 3 for i = 1, 2, ..., n.\n    # a[i] = i^2 - i + 1.\n    # If i % 3 == 0, then a[i] % 3 = (0^2 - 0 + 1) % 3 = 1.\n    # If i % 3 == 1, then a[i] % 3 = (1^2 - 1 + 1) % 3 = 1.\n    # If i % 3 == 2, then a[i] % 3 = (2^2 - 2 + 1) % 3 = (4 - 2 + 1) % 3 = 3 % 3 = 0.\n\n    # So, a[i] % 3 is 0 if i % 3 == 2, and 1 if i % 3 == 0 or i % 3 == 1.\n    # a[i] % 3 is never 2.\n\n    # Count how many i in [1, n] fall into each i % 3 category.\n    q = n // 3  # Number of full cycles of 3.\n    r = n % 3   # Remainder elements.\n\n    count_i_mod_1 = q + (1 if r >= 1 else 0)  # Indices 1, 4, 7, ...\n    count_i_mod_2 = q + (1 if r >= 2 else 0)  # Indices 2, 5, 8, ...\n    count_i_mod_0 = q                          # Indices 3, 6, 9, ...\n\n    # Now, calculate the frequencies of a[i] % 3 for 0, 1, and 2.\n    # c0: count of a[i] % 3 == 0 (when i % 3 == 2)\n    c0 = count_i_mod_2\n    # c1: count of a[i] % 3 == 1 (when i % 3 == 0 or i % 3 == 1)\n    c1 = count_i_mod_0 + count_i_mod_1\n    # c2: count of a[i] % 3 == 2 (this never happens)\n    c2 = 0\n\n    # A sum a[i] + a[j] + a[k] is divisible by 3 if (a[i]%3 + a[j]%3 + a[k]%3) % 3 == 0.\n    # Given c2 is 0, the only ways to achieve this are:\n    # 1. (0, 0, 0): All three a values are 0 (mod 3).\n    # 2. (1, 1, 1): All three a values are 1 (mod 3).\n\n    total_triples = 0\n    total_triples += comb(c0, 3)  # Combinations of three a[i] values that are 0 (mod 3).\n    total_triples += comb(c1, 3)  # Combinations of three a[i] values that are 1 (mod 3).\n\n    return total_triples\n```"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Computes the number of index triples (i < j < k) such that a[i] + a[j] + a[k] is divisible by 3.\n    The sequence a[i] is defined as i*i - i + 1 for 1 <= i <= n.\n    \"\"\"\n\n    def choose(n_val, k_val):\n        \"\"\"\n        Calculates the binomial coefficient (n_val choose k_val).\n        Returns 0 if n_val < k_val, and 1 if k_val is 0.\n        \"\"\"\n        if n_val < k_val:\n            return 0\n        if k_val == 0:\n            return 1\n        k_val = min(k_val, n_val - k_val)\n        result = 1\n        for i in range(1, k_val + 1):\n            result = result * (n_val - k_val + i) // i\n        return result\n\n    # Analyze a[i] = i*i - i + 1 modulo 3:\n    # If i % 3 == 0, a[i] % 3 = (0*0 - 0 + 1) % 3 = 1\n    # If i % 3 == 1, a[i] % 3 = (1*1 - 1 + 1) % 3 = 1\n    # If i % 3 == 2, a[i] % 3 = (2*2 - 2 + 1) % 3 = 3 % 3 = 0\n\n    # Count of indices i (1 <= i <= n) where a[i] % 3 == 0.\n    # This corresponds to i % 3 == 2.\n    count_a_mod_0 = (n + 1) // 3\n    \n    # Count of indices i (1 <= i <= n) where a[i] % 3 == 1.\n    # This corresponds to i % 3 == 0 or i % 3 == 1.\n    count_a_mod_1 = n - count_a_mod_0\n    \n    # For a[i] + a[j] + a[k] to be divisible by 3, the sum of their residues modulo 3 must be 0.\n    # Given that residues can only be 0 or 1, valid combinations are (0,0,0) or (1,1,1).\n    triples = choose(count_a_mod_0, 3) + choose(count_a_mod_1, 3)\n    \n    return triples"}
{"task_id": "HumanEval/148", "solution": "```python\nfrom typing import Tuple\n\ndef bf(planet1: str, planet2: str) -> Tuple[str, ...]:\n    \"\"\"\n    Returns planets located between two given planet orbits, ordered by proximity to the Sun.\n    Returns an empty tuple if planet1 or planet2 are not correct planet names.\n    \"\"\"\n    CANONICAL_PLANETS = (\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\")\n    \n    normalized_planet1 = planet1.strip().title()\n    normalized_planet2 = planet2.strip().title()\n\n    try:\n        idx1 = CANONICAL_PLANETS.index(normalized_planet1)\n    except ValueError:\n        return ()\n\n    try:\n        idx2 = CANONICAL_PLANETS.index(normalized_planet2)\n    except ValueError:\n        return ()\n\n    start_idx = min(idx1, idx2) + 1\n    end_idx = max(idx1, idx2)\n\n    if start_idx >= end_idx:\n        return ()\n\n    return tuple(CANONICAL_PLANETS[start_idx:end_idx])\n```"}
{"task_id": "HumanEval/148", "solution": "PLANET_DATA = [\n    (\"Mercury\", 1),\n    (\"Venus\", 2),\n    (\"Earth\", 3),\n    (\"Mars\", 4),\n    (\"Jupiter\", 5),\n    (\"Saturn\", 6),\n    (\"Uranus\", 7),\n    (\"Neptune\", 8),\n]\n\nPLANET_LOOKUP = {name.lower(): (name, order) for name, order in PLANET_DATA}\n\ndef bf(planet1, planet2):\n    \"\"\"\n    Returns a tuple of planets whose orbits lie strictly between the two provided planets.\n    Returns an empty tuple if either planet name is invalid.\n    \"\"\"\n    p1_info = PLANET_LOOKUP.get(planet1.lower())\n    p2_info = PLANET_LOOKUP.get(planet2.lower())\n\n    if p1_info is None or p2_info is None:\n        return ()\n\n    p1_order = p1_info[1]\n    p2_order = p2_info[1]\n\n    min_order = min(p1_order, p2_order)\n    max_order = max(p1_order, p2_order)\n\n    result_planets = []\n    for name, order in PLANET_DATA:\n        if min_order < order < max_order:\n            result_planets.append(name)\n\n    return tuple(result_planets)"}
