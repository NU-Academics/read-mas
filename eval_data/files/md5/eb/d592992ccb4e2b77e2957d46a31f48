es import SortService\nfrom .errors import ValidationError\n\ndef create_app() -> Flask:\n    \"\"\"Creates and configures the Flask application.\"\"\"\n    app = Flask(__name__)\n    \n    service = SortService()\n    api_controller = APIController(service)\n\n    @app.route(\"/check\", methods=[\"POST\"])\n    def check():\n        \"\"\"API endpoint to check if a list is sorted according to rules.\"\"\"\n        try:\n            body = request.get_json()\n            if body is None:\n                return jsonify({\"error\": \"Invalid JSON body.\"}), 400\n            resp, status = api_controller.check(body)\n            return jsonify(resp), status\n        except ValidationError as e:\n            return jsonify({\"error\": e.message}), 400\n        except Exception as e:\n            app.logger.error(f\"Unhandled exception in /check: {e}\")\n            return jsonify({\"error\": \"An unexpected server error occurred.\"}), 500\n\n    return app\n\n```python\n# pyproject.toml\n# This is a minimal pyproject.toml. In a real project, more metadata,\n# build systems (like poetry.core.masonry.api), and dev dependencies\n# would be added.\n\n[project]\nname = \"is-sorted-app\"\nversion = \"0.1.0\"\ndescription = \"A Python library, CLI, and HTTP API to check if a list of non-negative integers is sorted with duplicate rules.\"\nauthors = [{ name = \"Your Name\", email = \"your.email@example.com\" }]\nrequires-python = \">=3.10\"\ndependencies = [\n    \"Flask~=3.0\",\n]\n\n[project.scripts]\nis_sorted-cli = \"is_sorted_app.cli:main\"\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n# [tool.poetry] # If using poetry instead of setuptools directly\n# name = \"is-sorted-app\"\n# version = \"0.1.0\"\n# description = \"A Python library, CLI, and HTTP API to check if a list of non-negative integers is sorted with duplicate rules.\"\n# authors = [\"Your Name <your.email@example.com>\"]\n# readme = \"README.md\"\n# packages