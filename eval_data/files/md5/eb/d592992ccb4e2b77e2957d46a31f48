{"task_id": "HumanEval/153", "solution": "def _count_upper_lower(s):\n    \"\"\"Counts uppercase and lowercase alphabetic characters in a string.\"\"\"\n    cap = sum(1 for ch in s if ch.isalpha() and ch.isupper())\n    sm  = sum(1 for ch in s if ch.isalpha() and ch.islower())\n    return cap, sm\n\ndef _calculate_strength(extension_name):\n    \"\"\"Calculates an extension's strength as (uppercase count) - (lowercase count).\"\"\"\n    cap, sm = _count_upper_lower(extension_name)\n    return cap - sm\n\ndef Strongest_Extension(class_name, extensions):\n    \"\"\"Determines the strongest extension for a class based on character counts.\n    If strengths are equal, the first extension in the list is chosen.\n    \"\"\"\n    max_strength = float('-inf')\n    strongest_extension_name = None\n\n    for ext_name in extensions:\n        current_strength = _calculate_strength(ext_name)\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = ext_name\n\n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a, b):\n    \"\"\"Checks if the second word or any of its rotations is a substring in the first word.\n    Comparisons are case-sensitive.\n    \"\"\"\n    if not b:\n        return False\n    if len(b) > len(a):\n        return False\n\n    # Iterate through all cyclic rotations of string b.\n    # For each rotation, check if it is a substring of string a.\n    for i in range(len(b)):\n        rotation = b[i:] + b[:i]\n        if rotation in a:\n            return True\n            \n    return False"}
{"task_id": "HumanEval/153", "solution": "```python\ndef Strongest_Extension(class_name, extensions):\n    \"\"\"Calculates extension strength (uppercase - lowercase letters) and\n    returns \"ClassName.StrongestExtensionName\", resolving ties by list order.\n    \"\"\"\n\n    def _count_letter_strength(name):\n        \"\"\"Computes strength as (uppercase count - lowercase count) for letters.\"\"\"\n        caps = sum(1 for char in name if 'A' <= char <= 'Z')\n        smalls = sum(1 for char in name if 'a' <= char <= 'z')\n        return caps - smalls\n\n    # Per requirements, assuming 'extensions' is a non-empty list.\n    strongest_extension = extensions[0]\n    max_strength = _count_letter_strength(extensions[0])\n\n    for i in range(1, len(extensions)):\n        current_extension = extensions[i]\n        current_strength = _count_letter_strength(current_extension)\n        \n        # Update if current extension is strictly stronger.\n        # Ties are resolved by keeping the first encountered extension.\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension = current_extension\n            \n    return f\"{class_name}.{strongest_extension}\"\n```"}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a, b):\n    # If the pattern is longer than the text, no rotation can be a substring.\n    if len(b) > len(a):\n        return False\n\n    n = len(b)\n    # Generate all cyclic rotations of pattern 'b'.\n    for i in range(n):\n        rotated_pattern = b[i:] + b[:i]\n        if rotated_pattern in a:\n            return True\n            \n    return False"}
{"task_id": "HumanEval/155", "solution": "```python\n# pyproject.toml\n# This file is for project metadata and dependencies.\n# Install with: pip install poetry && poetry install\n# Or generate requirements.txt with: poetry export -f requirements.txt --output requirements.txt --without-hashes\n\n[tool.poetry]\nname = \"evenodd-counter\"\nversion = \"0.1.0\"\ndescription = \"Utility to count even and odd digits in an integer.\"\nauthors = [\"Your Name <you@example.com>\"]\nreadme = \"README.md\"\npackages = [{include = \"evenodd\", from = \"src\"}]\n\n[tool.poetry.dependencies]\npython = \">=3.8,<4.0\"\nfastapi = {version = \"^0.111.0\", optional = true}\nuvicorn = {version = \"^0.30.1\", optional = true}\npydantic = {version = \"^2.7.3\", optional = true}\npydantic-settings = {version = \"^2.2.1\", optional = true}\n\n[tool.poetry.group.dev.dependencies]\npytest = \"^8.2.1\"\nruff = \"^0.4.7\"\nmypy = \"^1.10.0\"\n\n[tool.poetry.extras]\napi = [\"fastapi\", \"uvicorn\", \"pydantic\", \"pydantic-settings\"]\n\n[tool.poetry.scripts]\nevenodd = \"evenodd.cli:main\"\n\n[build-system]\nrequires = [\"poetry-core\"]\nbuild-backend = \"poetry.core.masonry.api\"\n\n```\n```text\n# requirements.txt\n# Minimal runtime dependencies for the core functionality.\n# Generated from pyproject.toml for pip installations.\n# For API features, `fastapi`, `uvicorn`, `pydantic`, `pydantic-settings` would be added.\n\nfastapi==0.111.0 ; extra == \"api\"\npydantic==2.7.3 ; extra == \"api\"\npydantic-settings==2.2.1 ; extra == \"api\"\nuvicorn==0.30.1 ; extra == \"api\"\n\n```\n```markdown\n# README.md\n# Even/Odd Digit Counter\n\nA Python utility to count even and odd digits in a given integer.\n\n## Features\n\n- Programmatic function `even_odd_count(num)`\n- Command-Line Interface (`evenodd <number> [--persist]`)\n- Optional HTTP API (`POST /count`)\n- Optional persistence of calculation history to a local JSON-lines file.\n\n## Installation\n\n1.  **Clone the repository:**\n    ```bash\n    git clone https://github.com/your-repo/evenodd-counter.git\n    cd evenodd-counter\n    ```\n\n2.  **Install with Poetry (recommended):**\n    ```bash\n    pip install poetry\n    poetry install\n    # For API support:\n    # poetry install --extras \"api\"\n    ```\n\n3.  **Install with pip:**\n    ```bash\n    pip install -e .\n    # For API support:\n    # pip install -e \".[api]\"\n    ```\n\n## Usage\n\n### Programmatic API\n\n```python\nfrom evenodd import even_odd_count\n\neven, odd = even_odd_count(12345)\nprint(f\"Even: {even}, Odd: {odd}\") # Output: Even: 2, Odd: 3\n\neven, odd = even_odd_count(\"-9876\")\nprint(f\"Even: {even}, Odd: {odd}\") # Output: Even: 2, Odd: 2\n```\n\n### Command-Line Interface (CLI)\n\n```bash\n# Basic usage\nevenodd 12345\n# Output: {\"even\": 2, \"odd\": 3}\n\n# With negative numbers\nevenodd -9876\n# Output: {\"even\": 2, \"odd\": 2}\n\n# Persist the result\nevenodd 54321 --persist\n# Output: {\"even\": 2, \"odd\": 3}\n# This will save the record to a file (default: evenodd_results.jsonl)\n\n# Invalid input\nevenodd \"abc\"\n# Output: Error: Invalid integer input: 'abc'\n```\n\n### HTTP API (Optional)\n\nIf installed with API extras, you can run the API server:\n\n```bash\n# With Poetry\npoetry run uvicorn evenodd.controllers:get_app --factory --host 0.0.0.0 --port 8000\n\n# With pip (if `evenodd` package is installed)\nuvicorn evenodd.controllers:get_app --factory --host 0.0.0.0 --port 8000\n```\n\nThen, make a POST request:\n\n```bash\ncurl -X POST http://localhost:8000/count \\\n     -H \"Content-Type: application/json\" \\\n     -d '{\"number\": \"12345\", \"persist\": true}'\n# Output: {\"even\":2,\"odd\":3}\n```\n```python\n# src/evenodd/__init__.py\nimport os\nfrom .services import EvenOddService\nfrom .repositories import ResultRepository\n\n# Default path for the persistence file.\n_DEFAULT_PERSISTENCE_PATH = os.environ.get(\"EVENODD_PERSISTENCE_PATH\", \"evenodd_results.jsonl\")\n\n# Initialize a service instance for general programmatic use.\n# Persistence is off by default for this direct function call.\n_even_odd_service = EvenOddService(repo=None)\n\ndef even_odd_count(num: int | str) -> tuple[int, int]:\n    \"\"\"Given an integer (or its string representation), return a tuple with the number of even and odd digits respectively.\n    This function delegates to the core EvenOddService without persistence.\n    \"\"\"\n    return _even_odd_service.even_odd_count(num, persist=False)\n\n# Export key classes/functions for convenience.\n__all__ = [\"even_odd_count\", \"EvenOddService\", \"ResultRepository\"]\n\n```\n```python\n# src/evenodd/exceptions.py\nclass ValidationError(Exception):\n    \"\"\"Custom exception for validation failures in the domain logic.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\n    def __str__(self) -> str:\n        return self.message\n\n```\n```python\n# src/evenodd/models.py\nfrom dataclasses import dataclass\nimport uuid\nfrom datetime import datetime\n\n@dataclass(frozen=True)\nclass DigitCount:\n    \"\"\"Immutable model representing a single calculation record.\"\"\"\n    id: str\n    input_value: str\n    even: int\n    odd: int\n    timestamp: str\n\n    def to_dict(self) -> dict:\n        \"\"\"Serializes the DigitCount instance to a JSON-serializable dictionary.\"\"\"\n        return {\n            \"id\": self.id,\n            \"input_value\": self.input_value,\n            \"even\": self.even,\n            \"odd\": self.odd,\n            \"timestamp\": self.timestamp,\n        }\n\n    @staticmethod\n    def from_dict(d: dict) -> \"DigitCount\":\n        \"\"\"Constructs a DigitCount instance from a dictionary.\"\"\"\n        return DigitCount(\n            id=d[\"id\"],\n            input_value=d[\"input_value\"],\n            even=d[\"even\"],\n            odd=d[\"odd\"],\n            timestamp=d[\"timestamp\"],\n        )\n\n```\n```python\n# src/evenodd/utils.py\nfrom evenodd.exceptions import ValidationError\n\nclass DigitExtractor:\n    \"\"\"Pure helper functions for input normalization, validation, and digit extraction.\"\"\"\n\n    @staticmethod\n    def is_integer_string(value: str) -> bool:\n        \"\"\"Checks if a string represents a valid integer literal, optionally with a sign.\"\"\"\n        s = value.strip()\n        if not s:\n            return False\n        if s.startswith(('-', '+')):\n            s = s[1:]\n        return s.isdigit() and len(s) > 0\n\n    @staticmethod\n    def extract_digits(value: str) -> list[int]:\n        \"\"\"Normalizes input, validates it as an integer string, and returns a list of integer digits.\"\"\"\n        s = str(value).strip()\n        if not DigitExtractor.is_integer_string(s):\n            raise ValidationError(f\"Invalid integer input: {value!r}\")\n        if s and s[0] in '+-':\n            s = s[1:] # Ignore leading sign\n        return [int(char) for char in s]\n\n```\n```python\n# src/evenodd/repositories.py\nimport json\nimport os\nimport tempfile\nimport fcntl # For Windows-style file locking on Linux/macOS\nimport logging\n\nfrom evenodd.models import DigitCount\n\nlogger = logging.getLogger(__name__)\n\nclass ResultRepository:\n    \"\"\"Append-only persistence to a JSON-lines file with atomic writes.\"\"\"\n    def __init__(self, path: str):\n        self.path = path\n        # Ensure the directory exists\n        os.makedirs(os.path.dirname(self.path) or '.', exist_ok=True)\n\n    def _atomic_write_line(self, path: str, line: str) -> None:\n        \"\"\"Performs an atomic append of a line to a file.\"\"\"\n        dirpath = os.path.dirname(path) or \".\"\n        \n        # Use a temporary file and os.rename for atomic writes on POSIX systems.\n        # Fallback to locked append for better compatibility on other systems (e.g., NFS, or Windows-like behavior).\n        tmp_fd, tmp_path = tempfile.mkstemp(dir=dirpath, suffix=\".tmp\")\n        try:\n            with os.fdopen(tmp_fd, \"w\", encoding=\"utf-8\") as tmp_file:\n                tmp_file.write(line)\n\n            # Atomic append by first writing to a temp file, then appending the temp file's content\n            # to the target file. This prevents partial writes if the process crashes.\n            # Using fcntl lock for the append operation to prevent concurrent writes from corrupting the file.\n            with open(path, \"ab\") as f: # Open in append binary mode\n                # Acquire an exclusive lock (blocking)\n                fcntl.flock(f, fcntl.LOCK_EX)\n                try:\n                    with open(tmp_path, \"rb\") as tmp_read_file:\n                        f.write(tmp_read_file.read())\n                finally:\n                    # Release the lock\n                    fcntl.flock(f, fcntl.LOCK_UN)\n        finally:\n            if os.path.exists(tmp_path):\n                os.remove(tmp_path)\n\n\n    def save(self, record: dict) -> None:\n        \"\"\"Serializes a record as JSON line and appends it atomically.\"\"\"\n        line = json.dumps(record, ensure_ascii=False) + \"\\n\"\n        try:\n            self._atomic_write_line(self.path, line)\n        except Exception as e:\n            logger.error(f\"Failed to atomically save record to {self.path}: {e}\")\n            raise # Re-raise to be caught and logged by the service\n\n    def iter_all(self) -> \"Iterator[DigitCount]\":\n        \"\"\"Iterates over file lines and yields DigitCount instances.\"\"\"\n        if not os.path.exists(self.path):\n            return\n        with open(self.path, \"r\", encoding=\"utf-8\") as f:\n            for line in f:\n                try:\n                    data = json.loads(line.strip())\n                    yield DigitCount.from_dict(data)\n                except json.JSONDecodeError:\n                    logger.warning(f\"Skipping malformed JSON line in {self.path}: {line.strip()}\")\n                except KeyError as e:\n                    logger.warning(f\"Skipping record with missing key {e} in {self.path}: {line.strip()}\")\n\n```\n```python\n# src/evenodd/services.py\nimport uuid\nfrom datetime import datetime\nimport logging\n\nfrom evenodd.utils import DigitExtractor\nfrom evenodd.models import DigitCount\nfrom evenodd.exceptions import ValidationError\nfrom evenodd.repositories import ResultRepository # Import for type hinting\n\nlogger = logging.getLogger(__name__)\n\nclass EvenOddService:\n    \"\"\"Main orchestrator for digit counting and optional persistence.\"\"\"\n    def __init__(self, repo: ResultRepository | None = None):\n        self.repo = repo\n\n    def _classify_digits(self, digits: list[int]) -> tuple[int, int]:\n        \"\"\"Counts the number of even and odd digits in a list.\"\"\"\n        even = sum(1 for d in digits if d % 2 == 0)\n        odd = len(digits) - even\n        return even, odd\n\n    def even_odd_count(self, value: int | str, persist: bool = False) -> tuple[int, int]:\n        \"\"\"Validates input, extracts digits, classifies them, optionally persists, and returns counts.\"\"\"\n        s: str\n        if isinstance(value, int):\n            s = str(value)\n        elif isinstance(value, str):\n            s = value\n        else:\n            raise ValidationError(\"Value must be an integer or a string representing an integer.\")\n\n        digits = DigitExtractor.extract_digits(s)\n        even, odd = self._classify_digits(digits)\n\n        if persist and self.repo:\n            rec = DigitCount(\n                id=str(uuid.uuid4()),\n                input_value=s, # Use the string representation of the input\n                even=even,\n                odd=odd,\n                timestamp=datetime.utcnow().isoformat(timespec=\"milliseconds\") + \"Z\"\n            )\n            try:\n                self.repo.save(rec.to_dict())\n            except Exception:\n                # Fail-open: log and continue, do not prevent returning the result.\n                logger.exception(\"Failed to persist record for input %s\", s)\n\n        return even, odd\n\n```\n```python\n# src/evenodd/schemas.py\nfrom typing import Literal, Annotated\n\ntry:\n    from pydantic import BaseModel, Field\n    from evenodd.models import DigitCount\n    \n    # Define an alias for `Annotated` for pydantic models.\n    # This helps avoid `TypeError` when `get_app` attempts to resolve `Annotated` types\n    # without `from __future__ import annotations` or actual import.\n    PydanticAnnotated = Annotated\n\n    class DigitCountRequest(BaseModel):\n        \"\"\"DTO for API request to count digits.\"\"\"\n        number: str = Field(..., description=\"The integer number as a string.\", examples=[\"12345\", \"-9870\", \"007\"])\n        persist: bool = Field(False, description=\"Whether to persist the calculation result.\")\n\n    class DigitCountResponse(BaseModel):\n        \"\"\"DTO for API response with even/odd counts.\"\"\"\n        even: int = Field(..., description=\"Count of even digits.\")\n        odd: int = Field(..., description=\"Count of odd digits.\")\n\n        @staticmethod\n        def from_digit_count(count: DigitCount) -> \"DigitCountResponse\":\n            \"\"\"Maps a DigitCount domain model to a response DTO.\"\"\"\n            return DigitCountResponse(even=count.even, odd=count.odd)\n\n    # Simplified representation for a JSON schema, for reference in design.\n    # FastAPI/Pydantic handle schema generation automatically.\n    class DigitCountDTO:\n        @staticmethod\n        def request_schema() -> dict:\n            return {\n                \"type\": \"object\",\n                \"properties\": {\n                    \"number\": {\"type\": \"string\", \"description\": \"Integer number to analyze\"},\n                    \"persist\": {\"type\": \"boolean\", \"default\": False, \"description\": \"Whether to persist the result\"}\n                },\n                \"required\": [\"number\"]\n    