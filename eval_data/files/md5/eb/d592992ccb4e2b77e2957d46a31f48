sults_ci = filter_service.filter(strings, \"AP\", case_sensitive=False)\nprint(f\"Filtered (case-insensitive): {results_ci}\")\n# Output: Filtered (case-insensitive): ['apple', 'apricot']\n\n# Example 3: Empty prefix (returns all strings)\nall_strings = filter_service.filter(strings, \"\")\nprint(f\"Empty prefix: {all_strings}\")\n# Output: Empty prefix: ['apple', 'banana', 'apricot', 'grape']\n\n# Example 4: Invalid input handling\ntry:\n    filter_service.filter([123, \"text\"], \"t\")\nexcept ValidationError as e:\n    print(f\"Error: {e}\")\n# Output: Error: element at index 0 is not a str\n```\n\n### CLI Tool\n\nThe `strutils` command provides a `filter` subcommand.\n\n```bash\n# Filter strings provided directly as a comma-separated list\nstrutils filter -s \"apple,banana,apricot,grape\" -p \"ap\"\n# Output: [\"apple\", \"apricot\"]\n\n# Filter strings from a file (one string per line)\n# Assuming you have a file named `fruits.txt` with:\n# apple\n# banana\n# apricot\n# grape\nstrutils filter -f fruits.txt -p \"ap\"\n# Output: [\"apple\", \"apricot\"]\n\n# Case-insensitive filtering\nstrutils filter -s \"Apple,banana,apricot\" -p \"ap\" --case-insensitive\n# Output: [\"Apple\", \"apricot\"]\n\n# Empty prefix (returns all)\nstrutils filter -s \"apple,banana\" -p \"\"\n# Output: [\"apple\", \"banana\"]\n```\n\n### HTTP JSON API (Optional)\n\nIf `fastapi` and `uvicorn` are installed (e.g., `pip install \"strutils[http]\"`), you can run the API server:\n\n```bash\nuvicorn strutils.api:app --host 0.0.0.0 --port 8000\n```\n\nThen, you can make POST requests to the `/filter` endpoint:\n\n```bash\ncurl -X POST \"http://127.0.0.1:8000/filter\" \\\n     -H \"Content-Type: application/json\" \\\n     -d '{\n           \"strings\": [\"apple\", \"banana\", \"apricot\", \"grape\"],\n           \"prefix\": \"ap\"\n         }'\n# Response (JSON):\n# {\"results\":[\"apple\",\"apricot\"]}\n\ncurl -X POST \"http://127.0.0.1:8000/filter\" \\\n     -H \"Content-Type: application/json\" \\\n     -d '{\n           \"strings\": [\"Apple\", \"banana\"],\n           \"prefix\": \"a\",\n           \"case_sensitive\": false\n         }'\n# Response (JSON):\n# {\"results\":[\"Apple\"]}\n\n# Error handling\ncurl -X POST \"http://127.0.0.1:8000/filter\" \\\n     -H \"Content-Type: application/json\" \\\n     -d '{\n           \"strings\": [\"apple\", 123],\n           \"prefix\": \"ap\"\n         }'\n# Response (JSON) with 400 status:\n# {\"detail\":\"element at index 1 is not a str\"}\n```\n\n## Development\n\nClone the repository:\n\n```bash\ngit clone https://github.com/yourusername/strutils.git\ncd strutils\n```\n\nInstall dependencies (including dev and test requirements):\n\n```bash\npip install -e \".[http]\"\n# For development, you might also need pytest, etc.\n```\n\n## License\n\nThis project is licensed under the MIT License - see the [LICENSE](LICENSE) file for details.\n```\n\n---\n\n**LICENSE**\n```\nMIT License\n\nCopyright (c) 2023 Your Name\n\nPermission is hereby granted, free of charge, to any person obtaining a copy\nof this software and associated documentation files (the \"Software\"), to deal\nin the Software without restriction, including without limitation the rights\nto use, copy, modify, merge, publish, distribute, sublicense, and/or sell\ncopies of the Software, and to permit persons to whom the Software is\nfurnished to do so, subject to the following conditions:\n\nThe above copyright notice and this permission notice shall be included in all\ncopies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\nIMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\nFITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\nAUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\nLIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\nOUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\nSOFTWARE.\n```\n\n---\n\n**src/strutils/__init__.py**\n```python\n\"\"\"\nstrutils: A Python library for string utilities, including prefix filtering.\n\"\"\"\n\n__version__ = \"0.1.0\"\n\n# Expose public API from the package\nfrom .services import StringFilterService\nfrom .cli import CLIController\nfrom .exceptions import ValidationError\n\n# Optional: Expose APIController if FastAPI is available\ntry:\n    from .api import APIController\nexcept ImportError:\n    APIController = None\n    # print(\"FastAPI not installed. HTTP API functionality will not be available.\", file=sys.stderr)\n\n__all__ = [\n    \"__version__\",\n    \"StringFilterService\",\n    \"CLIController\",\n    \"ValidationError\",\n    \"APIController\",\n]\n```\n\n---\n\n**src/strutils/config.py**\n```python\n\"\"\"\nApplication-wide configuration constants.\n\"\"\"\n\n# Default behavior for prefix matching\nDEFAULT_CASE_SENSITIVE: bool = True\n\n# CLI exit codes\nCLI_EXIT_SUCCESS: int = 0\nCLI_EXIT_FAILURE: int = 2\n```\n\n---\n\n**src/strutils/models.py**\n```python\n\"\"\"\nData Transfer Objects (DTOs) for request and response payloads.\nUses Pydantic for robust data modeling and validation.\n\"\"\"\nfrom typing import List, Dict, Any\nfrom pydantic import BaseModel, Field\n\nclass FilterRequest(BaseModel):\n    \"\"\"\n    Represents an input request for the string filtering operation.\n    \"\"\"\n    strings: List[str] = Field(..., description=\"List of strings to filter.\")\n    prefix: str = Field(..., description=\"The prefix to filter by.\")\n    case_sensitive: bool = Field(True, description=\"Whether prefix matching should be case-sensitive.\")\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Returns a dictionary representation of the request.\"\"\"\n        return self.model_dump()\n\nclass FilterResponse(BaseModel):\n    \"\"\"\n    Represents the response containing the filtered list of strings.\n    \"\"\"\n    results: List[str] = Field(..., description=\"The list of strings that match the prefix.\")\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Returns a dictionary representation of the response.\"\"\"\n        return self.model_dump()\n```\n\n---\n\n**src/strutils/exceptions.py**\n```python\n\"\"\"\nCustom exception types for domain-specific errors.\n\"\"\"\n\nclass ValidationError(Exception):\n    \"\"\"\n    Exception raised for invalid input data.\n    \"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\n    def __str__(self) -> str:\n        return f\"Validation Error: {self.message}\"\n```\n\n---\n\n**src/strutils/utils.py**\n```python\n\"\"\"\nUtility functions for input validation and normalization.\n\"\"\"\nfrom typing import List\nfrom .exceptions import ValidationError\n\nclass ValidationUtils:\n    \"\"\"\n    Provides static methods for validating various input types.\n    \"\"\"\n    @staticmethod\n    def validate_strings(strings: List[str]) -> None:\n        \"\"\"\n        Validates that the input is a list of strings.\n        Raises ValidationError if the input is not a list or contains non-string elements.\n        \"\"\"\n        if not isinstance(strings, list):\n            raise ValidationError(\"Input 'strings' must be a list.\")\n        for i, s in enumerate(strings):\n            if not isinstance(s, str):\n                raise ValidationError(f\"Element at index {i} of 'strings' is not a string.\")\n\n    @staticmethod\n    def validate_prefix(prefix: str) -> None:\n        \"\"\"\n        Validates that the input prefix is a string.\n        Raises ValidationError if the input is not a string.\n        \"\"\"\n        if not isinstance(prefix, str):\n            raise ValidationError(\"Input 'prefix' must be a string.\")\n```\n\n---\n\n**src/strutils/services.py**\n```python\n\"\"\"\nCore business logic for string filtering.\n\"\"\"\nfrom typing import List\nfrom .utils import ValidationUtils\nfrom .models import FilterRequest, FilterResponse\nfrom .exceptions import ValidationError\n\nclass StringFilterService:\n    \"\"\"\n    Provides the core functionality for filtering lists of strings by a prefix.\n    This service is stateless and can be reused.\n    \"\"\"\n    def filter(self, strings: List[str], prefix: str, case_sensitive: bool = True) -> List[str]:\n        \"\"\"\n        Filters a list of strings, returning only those that start with the given prefix.\n\n        Args:\n            strings: The list of strings to filter.\n            prefix: The prefix to match.\n            case_sensitive: If True, the matching is case-sensitive; otherwise, it's case-insensitive.\n\n        Returns:\n            A new list containing only the strings that start with the prefix,\n            preserving their original order.\n\n        Raises:\n            ValidationError: If 'strings' is not a list of strings or 'prefix' is not a string.\n        \"\"\"\n        ValidationUtils.validate_strings(strings)\n        ValidationUtils.validate_prefix(prefix)\n\n        if not prefix: # Empty prefix matches all strings.\n            return list(strings) # Return a shallow copy to prevent external modification of original.\n\n        results: List[str] = []\n        if not case_sensitive:\n            prefix_lower = prefix.lower()\n            for s in strings:\n                if s.lower().startswith(prefix_lower):\n                    results.append(s)\n        else:\n            for s in strings:\n                if s.startswith(prefix):\n                    results.append(s)\n        return results\n\n    def filter_from_request(self, req: FilterRequest) -> FilterResponse:\n        \"\"\"\n        A convenience method to filter strings using a FilterRequest DTO.\n        \"\"\"\n        results = self.filter(req.strings, req.prefix, case_sensitive=req.case_sensitive)\n        return FilterResponse(results=results)\n```\n\n---\n\n**src/strutils/cli.py**\n```python\n\"\"\"\nCommand-line interface (CLI) controller for strutils.\nHandles argument parsing, input/output, and interacts with the StringFilterService.\n\"\"\"\nimport argparse\nimport json\nimport sys\nfrom typing import List\n\nfrom .config import CLI_EXIT_SUCCESS, CLI_EXIT_FAILURE\nfrom .services import StringFilterService\nfrom .exceptions import ValidationError\n\nclass CLIController:\n    \"\"\"\n    Manages the command-line interface for the strutils application.\n    Parses arguments, orchestrates filtering, and prints results.\n    \"\"\"\n    def __init__(self):\n        self._service = StringFilterService()\n\n    def run(self, argv: List[str]) -> int:\n        \"\"\"\n        Parses command-line arguments and executes the requested operation.\n        \"\"\"\n        parser = argparse.ArgumentParser(\n            prog=\"strutils\",\n            description=\"String utilities for filtering lists of strings by prefix.\"\n        )\n        subparsers = parser.add_subparsers(dest=\"command\", help=\"Available commands\")\n\n        # 'filter' subcommand\n        filter_parser = subparsers.add_parser(\n            \"filter\",\n            help=\"Filter a list of strings by a given prefix.\"\n        )\n        filter_parser.add_argument(\n            \"--prefix\", \"-p\",\n            required=True,\n            help=\"The prefix to filter strings by.\"\n        )\n        filter_parser.add_argument(\n            \"--file\", \"-f\",\n            help=\"Path to a file containing strings (one per line) to filter.\"\n        )\n        filter_parser.add_argument(\n            \"--strings\", \"-s\",\n            help=\"Comma-separated list of strings to filter (e.g., 'a,b,c').\"\n        )\n        filter_parser.add_argument(\n            \"--case-insensitive\",\n            action=\"store_true\",\n            help=\"Perform case-insensitive prefix matching.\"\n        )\n\n        args = parser.parse_args(argv)\n\n        if args.command == \"filter\":\n            try:\n                input_strings: List[str] = []\n                if args.file:\n                    input_strings = self._read_file(args.file)\n                elif args.strings is not None:\n                    # Filter out empty strings if resulting from \"a,,b\" split\n                    input_strings = [s for s in args.strings.split(\",\") if s]\n                else:\n                    # If neither file nor strings are provided, assume empty list or handle as error\n                    pass # An empty list of strings is valid input for the service\n\n                results = self._service.filter(\n                    input_strings,\n                    args.prefix,\n                    case_sensitive=not args.case_insensitive\n                )\n                self._print_json(results)\n                return CLI_EXIT_SUCCESS\n            except (ValidationError, FileNotFoundError) as e:\n                print(f\"Error: {e}\", file=sys.stderr)\n                return CLI_EXIT_FAILURE\n            except Exception as e:\n                print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n                return CLI_EXIT_FAILURE\n        else:\n            parser.print_help(sys.stderr)\n            return CLI_EXIT_FAILURE\n\n    def _read_file(self, path: str) -> List[str]:\n        \"\"\"\n        Reads strings from a file, one string per line.\n        \"\"\"\n        try:\n            with open(path, 'r', encoding='utf-8') as f:\n                return [line.strip() for line in f if line.strip()]\n        except FileNotFoundError:\n            raise FileNotFoundError(f\"File not found: {path}\")\n        except Exception as e:\n            raise IOError(f\"Error reading file '{path}': {e}\") from e\n\n    def _print_json(self, results: List[str]) -> None:\n        \"\"\"\n        Prints the results as a JSON array to standard output.\n        \"\"\"\n        json.dump(results, sys.stdout)\n        sys.stdout.write(\"\\n\") # Ensure a newline at the end\n\n    @staticmethod\n    def run_cli_entrypoint() -> None:\n        \"\"\"\n        Entry point for the console script 'strutils'.\n        \"\"\"\n        controller = CLIController()\n        sys.exit(controller.run(sys.argv[1:]))\n\n# This makes the APIController available for direct import if not using console script\n# if __name__ == \"__main__\":\n#     CLIController.run_cli_entrypoint()\n```\n\n---\n\n**src/strutils/api.py**\n```python\n\"\"\"\nHTTP JSON API controller (optional, based on FastAPI).\n\"\"\"\nimport sys\nfrom typing import Optional, Dict, Any\n\nfrom .config import DEFAULT_CASE_SENSITIVE\nfrom .services import StringFilterService\nfrom .models import FilterRequest, FilterResponse\nfrom .exceptions import ValidationError\n\n# Conditional import for FastAPI\ntry:\n    from fastapi import FastAPI, HTTPException, status\n    from pydantic import ValidationError as PydanticValidationError\nexcept ImportError:\n    FastAPI = None\n    HTTPException = None\n    status = None\n    PydanticValidationError = None\n    # print(\"FastAPI not installed. HTTP API functionality will not be available.\", file=sys.stderr)\n\nclass APIController:\n    \"\"\"\n    Manages the HTTP API endpoints using FastAPI.\n    Provides a factory method to create the FastAPI application.\n    \"\"\"\n    def __init__(self):\n        if FastAPI is None:\n            raise ImportError(\n                \"FastAPI is not installed. \"\n                \"Please install it with 'pip install \\\"strutils[http]\\\"' \"\n                \"to use the HTTP API.\"\n            )\n        self._service = StringFilterService()\n\n    def create_app(self) -> FastAPI:\n        \"\"\"\n        Creates and configures a FastAPI application instance.\n        \"\"\"\n        app = FastAPI(\n            title=\"String Utilities API\",\n            description=\"API for filtering lists of strings by prefix.\",\n            version=\"0.1.0\"\n        )\n\n        @app.post(\"/filter\", response_model=FilterResponse, status_code=status.HTTP_200_OK)\n        async def post_filter_endpoint(request: FilterRequest) -> FilterResponse:\n            \"\"\"\n            Filters a list of strings by a given prefix.\n\n            Accepts a JSON payload with `strings` (List[str]), `prefix` (str),\n            and optionally `case_sensitive` (bool).\n            Returns a JSON object with `results` (List[str]).\n            \"\"\"\n            try:\n                # Use the service with the Pydantic model\n                filter_response = self._service.filter_from_request(request)\n                return filter_response\n            except ValidationError as ve:\n                raise HTTPException(\n                    status_code=status.HTTP_400_BAD_REQUEST,\n                    detail=f\"Validation Error: {ve.message}\"\n                )\n            except Exception as e:\n                # Catch unexpected errors and return a 500\n                raise HTTPException(\n                    status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,\n                    detail=f\"An unexpected server error occurred: {str(e)}\"\n                )\n\n        # Handle Pydantic validation errors for the request body\n        @app.exception_handler(PydanticValidationError)\n        async def pydantic_validation_exception_handler(req, exc):\n            from fastapi.responses import JSONResponse\n            return JSONResponse(\n                status_code=status.HTTP_422_UNPROCESSABLE_ENTITY, # Standard for Pydantic errors\n                content={\"detail\": exc.errors()}\n            )\n\n        return app\n\n# Expose the FastAPI app instance directly for uvicorn to pick up\n# This requires `from strutils.api import app` or similar.\n# The design specifies `create_app()` to be a method, so we instantiate it here.\n# For uvicorn, you would typically run `uvicorn strutils.api:app --reload`\ntry:\n    if FastAPI is not None:\n        app: FastAPI = APIController().create_app()\n    else:\n        app = None # type: ignore\nexcept ImportError:\n    app = None # type: ignore\n```\n\n---\n\n**src/strutils/example_client.py**\n```python\n\"\"\"\nAn example client demonstrating how to use the StringFilterService library API.\n\"\"\"\nfrom typing import List\nfrom .services import StringFilterService\nfrom .exceptions import ValidationError\n\nclass ExampleClient:\n    \"\"\"\n    A simple client that uses the StringFilterService to perform filtering.\n    \"\"\"\n    def __init__(self):\n        self._filter_service = StringFilterService()\n\n    def get_filtered(self, strings: List[str], prefix: str, case_sensitive: bool = True) -> List[str]:\n        \"\"\"\n        Retrieves a filtered list of strings using the StringFilterService.\n        \"\"\"\n        try:\n            return self._filter_service.filter(strings, prefix, case_sensitive)\n        except ValidationError as e:\n            print(f\"Client encountered a validation error: {e}\")\n            raise # Re-raise for the calling application to handle\n\nif __name__ == \"__main__\":\n    # Example usage of the ExampleClient\n    client = ExampleClient()\n\n    test_strings = [\"apple\", \"banana\", \"apricot\", \"grape\", \"blueberry\"]\n    test_prefix_cs = \"ap\"\n    test_prefix_ci = \"b\"\n\n    print(f\"Original strings: {test_strings}\")\n\n    # Case-sensitive filter\n    filtered_cs = client.get_filtered(test_strings, test_prefix_cs, case_sensitive=True)\n    print(f\"Filtered by '{test_prefix_cs}' (case-sensitive): {filtered_cs}\")\n\n    # Case-insensitive filter\n    filtered_ci = client.get_filtered(test_strings, test_prefix_ci, case_sensitive=False)\n    print(f\"Filtered by '{test_prefix_ci}' (case-insensitive): {filtered_ci}\")\n\n    # Empty prefix\n    all_strings = client.get_filtered(test_strings, \"\")\n    print(f\"Filtered by '' (empty prefix): {all_strings}\")\n\n    # Demonstrate error handling\n    try:\n        client.get_filtered([\"valid\", 123, \"invalid\"], \"v\")\n    except ValidationError as e:\n        print(f\"Caught expected error: {e}\")\n```\n\n---\n\n**src/strutils/__main__.py**\n```python\n\"\"\"\nEntry point for the 'python -m strutils' command.\nDelegates to the CLIController.\n\"\"\"\nimport sys\nfrom .cli import CLIController\n\ndef main() -> None:\n    \"\"\"\n    Main entry point for running strutils as a module.\n    \"\"\"\n    CLIController.run_cli_entrypoint()\n\nif __name__ == \"__main__\":\n    main()\n```"}
