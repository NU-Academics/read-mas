{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    Checks if a list of integers contains two distinct elements that sum to zero.\n    This uses a hash set for O(n) average time complexity and O(n) space.\n    \"\"\"\n    seen_numbers = set()\n    zero_count = 0\n\n    for num in l:\n        if num == 0:\n            zero_count += 1\n            if zero_count >= 2:\n                return True\n        elif -num in seen_numbers:\n            return True\n        seen_numbers.add(num)\n\n    return False"}
{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    seen = set()\n    for x in l:\n        if -x in seen:\n            return True\n        seen.add(x)\n    return False"}
{"task_id": "HumanEval/44", "solution": "```python\ndef change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    Returns string representation after conversion.\n    \"\"\"\n    if x == 0:\n        return \"0\"\n    digits = []\n    n = x\n    while n > 0:\n        digits.append(str(n % base))\n        n //= base\n    return ''.join(reversed(digits))\n```"}
{"task_id": "HumanEval/44", "solution": "```python\n# src/numbase/exceptions.py\nclass ConversionError(Exception):\n    \"\"\"Base exception for conversion-related errors.\"\"\"\n    pass\n\nclass InvalidBaseError(ConversionError):\n    \"\"\"Raised when the provided base is out of the allowed range.\"\"\"\n    pass\n\nclass PersistenceError(Exception):\n    \"\"\"Raised for issues during database write or read operations.\"\"\"\n    pass\n\n# src/numbase/dto.py\nclass ConversionRequest:\n    \"\"\"Data transfer object for a conversion request.\"\"\"\n    def __init__(self, x: int, base: int) -> None:\n        self.x = x\n        self.base = base\n\nclass ConversionResult:\n    \"\"\"Data transfer object for a conversion result.\"\"\"\n    def __init__(self, result: str) -> None:\n        self.result = result\n\n# src/numbase/utils.py\nMIN_BASE = 2\nMAX_BASE = 9\n\ndef validate_base(base: int) -> bool:\n    \"\"\"Validates if the base is within the allowed range.\"\"\"\n    return isinstance(base, int) and MIN_BASE <= base <= MAX_BASE\n\ndef validate_input_x(x: int) -> bool:\n    \"\"\"Validates if the input number x is a non-negative integer.\"\"\"\n    return isinstance(x, int) and x >= 0\n\n# src/numbase/converter.py\nfrom .exceptions import InvalidBaseError, ConversionError\nfrom .utils import MIN_BASE, MAX_BASE\n\nclass NumberBaseConverter:\n    \"\"\"Core logic for converting an integer to a string representation in a given base.\"\"\"\n\n    def convert(self, x: int, base: int) -> str:\n        \"\"\"Converts a non-negative integer x to its string representation in base.\"\"\"\n        if not isinstance(x, int) or not isinstance(base, int):\n            raise ConversionError(\"Input x and base must be integers.\")\n        if base < MIN_BASE or base > MAX_BASE:\n            raise InvalidBaseError(f\"Base must be between {MIN_BASE} and {MAX_BASE}.\")\n        if x < 0:\n            raise ConversionError(\"Negative numbers are not supported for conversion.\")\n\n        if x == 0:\n            return \"0\"\n\n        digits = []\n        while x > 0:\n            digits.append(str(x % base))\n            x //= base\n        return ''.join(reversed(digits))\n\n# src/numbase/repository.py\nimport sqlite3\nfrom datetime import datetime\nfrom typing import List, Dict\n\nfrom .exceptions import PersistenceError\n\nDEFAULT_DB_PATH = \"./numbase_conversions.db\"\n\nclass ConversionLogRepository:\n    \"\"\"Handles persistence of conversion logs to an SQLite database.\"\"\"\n\n    def __init__(self, db_path: str = DEFAULT_DB_PATH) -> None:\n        self._db_path = db_path\n\n    def init_db(self) -> None:\n        \"\"\"Initializes the database by creating the conversions table if it doesn't exist.\"\"\"\n        sql = \"\"\"\n        CREATE TABLE IF NOT EXISTS conversions (\n            id INTEGER PRIMARY KEY AUTOINCREMENT,\n            x INTEGER NOT NULL,\n            base INTEGER NOT NULL,\n            result TEXT NOT NULL,\n            ts TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n        );\n        CREATE INDEX IF NOT EXISTS idx_conversions_ts ON conversions(ts DESC);\n        CREATE INDEX IF NOT EXISTS idx_conversions_x ON conversions(x);\n        \"\"\"\n        conn = None\n        try:\n            conn = sqlite3.connect(self._db_path)\n            conn.executescript(sql)\n            conn.commit()\n        except sqlite3.Error as e:\n            raise PersistenceError(f\"Database initialization failed: {e}\")\n        finally:\n            if conn:\n                conn.close()\n\n    def save(self, x: int, base: int, result: str, ts: datetime) -> int:\n        \"\"\"Saves a conversion record to the database and returns the inserted row ID.\"\"\"\n        conn = None\n        try:\n            conn = sqlite3.connect(self._db_path)\n            cur = conn.cursor()\n            cur.execute(\n                \"INSERT INTO conversions (x, base, result, ts) VALUES (?, ?, ?, ?)\",\n                (x, base, result, ts.isoformat()),\n            )\n            conn.commit()\n            return cur.lastrowid\n        except sqlite3.Error as e:\n            raise PersistenceError(f\"Failed to save conversion log: {e}\")\n        finally:\n            if conn:\n                conn.close()\n\n    def query_recent(self, limit: int = 100) -> List[Dict]:\n        \"\"\"Queries and returns a list of recent conversion records.\"\"\"\n        conn = None\n        try:\n            conn = sqlite3.connect(self._db_path)\n            conn.row_factory = sqlite3.Row # Allows access to columns by name\n            cur = conn.cursor()\n            cur.execute(\"SELECT id, x, base, result, ts FROM conversions ORDER BY ts DESC LIMIT ?\", (limit,))\n            return [dict(row) for row in cur.fetchall()]\n        except sqlite3.Error as e:\n            raise PersistenceError(f\"Failed to query recent conversions: {e}\")\n        finally:\n            if conn:\n                conn.close()\n\n# src/numbase/service.py\nimport logging\nfrom datetime import datetime\nfrom typing import Optional\n\nfrom .dto import ConversionRequest, ConversionResult\nfrom .converter import NumberBaseConverter\nfrom .repository import ConversionLogRepository\nfrom .exceptions import ConversionError, InvalidBaseError, PersistenceError\nfrom .utils import validate_base, validate_input_x\n\nlogger = logging.getLogger(__name__)\n\nclass ConversionService:\n    \"\"\"Orchestrates conversion requests, handling validation, actual conversion, and optional logging.\"\"\"\n\n    def __init__(self, converter: NumberBaseConverter, repo: Optional[ConversionLogRepository] = None) -> None:\n        self._converter = converter\n        self._repo = repo\n\n    def convert_request(self, req: ConversionRequest) -> ConversionResult:\n        \"\"\"Processes a conversion request, performing validation, conversion, and logging.\"\"\"\n        if not isinstance(req.x, int) or not isinstance(req.base, int):\n            raise ConversionError(\"Inputs 'x' and 'base' must be integers.\")\n        if not validate_input_x(req.x):\n            raise ConversionError(\"Input 'x' must be a non-negative integer.\")\n        if not validate_base(req.base):\n            raise InvalidBaseError(\n                f\"Input 'base' must be between {self._converter.MIN_BASE} and {self._converter.MAX_BASE}.\"\n            )\n\n        result_str = self._converter.convert(req.x, req.base)\n\n        if self._repo:\n            try:\n                self._repo.save(req.x, req.base, result_str, datetime.utcnow())\n            except PersistenceError as e:\n                logger.error(f\"Failed to persist conversion log for x={req.x}, base={req.base}: {e}\")\n            except Exception as e:\n                logger.error(f\"Unexpected error during persistence for x={req.x}, base={req.base}: {e}\")\n\n        return ConversionResult(result_str)\n\n# src/numbase/controller.py\nimport argparse\nimport sys\nimport os\nfrom typing import List, Optional\n\nfrom fastapi import FastAPI, HTTPException, Header, Depends, status\nfrom pydantic import BaseModel\n\nfrom .dto import ConversionRequest, ConversionResult\nfrom .exceptions import ConversionError, InvalidBaseError\nfrom .service import ConversionService\n\nclass ConvertPayload(BaseModel):\n    \"\"\"Pydantic model for the HTTP conversion request body.\"\"\"\n    x: int\n    base: int\n\nclass CLIController:\n    \"\"\"Handles command-line interface interactions for number base conversion.\"\"\"\n\n    def __init__(self, service: ConversionService) -> None:\n        self._service = service\n\n    def run(self, argv: List[str]) -> int:\n        \"\"\"Parses CLI arguments, performs conversion, prints results, and handles errors.\"\"\"\n        parser = argparse.ArgumentParser(\n            prog=\"numbase cli\",\n            description=\"Convert non-negative integers to a string representation in a specified base (2-9).\"\n        )\n        subparsers = parser.add_subparsers(dest=\"command\", help=\"Available commands\")\n\n        convert_parser = subparsers.add_parser(\"convert\", help=\"Convert a number to a specified base.\")\n        convert_parser.add_argument(\"x\", type=int, help=\"The non-negative integer to convert.\")\n        convert_parser.add_argument(\"base\", type=int, help=\"The target base (2-9).\")\n\n        if not argv:\n            parser.print_help()\n            return 0\n\n        args = parser.parse_args(argv)\n\n        if args.command == \"convert\":\n            try:\n                req = ConversionRequest(args.x, args.base)\n                res = self._service.convert_request(req)\n                print(res.result)\n                return 0\n            except (ConversionError, InvalidBaseError) as e:\n                print(f\"Error: {e}\", file=sys.stderr)\n                return 2\n            except Exception as e:\n                print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n                return 1\n        else:\n            parser.print_help()\n            return 1\n\nclass APIController:\n    \"\"\"Manages the FastAPI application for exposing HTTP conversion endpoints.\"\"\"\n\n    def __init__(self, service: ConversionService, api_key: Optional[str] = None) -> None:\n        self._service = service\n        self._api_key = api_key\n\n    def create_app(self) -> FastAPI:\n        \"\"\"Constructs and returns a FastAPI application instance with conversion and health endpoints.\"\"\"\n        app = FastAPI(\n            title=\"Numbase Converter API\",\n            description=\"API for converting non-negative integers to a specified base (2-9).\",\n            version=\"1.0.0\",\n        )\n\n        def verify_api_key(x_api_key: str = Header(None, alias=\"X-API-Key\")) -> None:\n            \"\"\"Dependency to verify the API key if configured.\"\"\"\n            if self._api_key:\n                if not x_api_key or x_api_key != self._api_key:\n                    raise HTTPException(\n                        status_code=status.HTTP_401_UNAUTHORIZED,\n                        detail=\"Unauthorized: Missing or invalid API key.\"\n                    )\n\n        @app.post(\"/convert\", response_model=ConversionResult, status_code=status.HTTP_200_OK)\n        async def convert_endpoint(\n            payload: ConvertPayload,\n            auth: None = Depends(verify_api_key)\n        ):\n            \"\"\"Converts an integer to a specified base and returns the result.\"\"\"\n            try:\n                req = ConversionRequest(payload.x, payload.base)\n                res = self._service.convert_request(req)\n                return res\n            except InvalidBaseError as e:\n                raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=str(e))\n            except ConversionError as e:\n                raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=str(e))\n            except Exception as e:\n                raise HTTPException(status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=\"Internal server error\")\n\n        @app.get(\"/health\", status_code=status.HTTP_200_OK)\n        async def health_check():\n            \"\"\"Health check endpoint to verify API is running.\"\"\"\n            return {\"status\": \"ok\"}\n\n        return app\n\n# src/numbase/cli.py\nimport sys\nimport os\nimport logging\nimport argparse\nfrom typing import Optional, List\n\nfrom .controller import CLIController, APIController\nfrom .service import ConversionService\nfrom .converter import NumberBaseConverter\nfrom .repository import ConversionLogRepository, DEFAULT_DB_PATH\n\nlogging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')\nlogger = logging.getLogger(__name__)\n\ndef main(argv: Optional[List[str]] = None) -> int:\n    \"\"\"Main entry point for the numbase CLI application, dispatching to CLI or API modes.\"\"\"\n    if argv is None:\n        argv = sys.argv[1:]\n\n    parser = argparse.ArgumentParser(prog=\"numbase\", description=\"Numbase: Convert numbers to different bases.\")\n    parser.add_argument(\"--db-path\", default=DEFAULT_DB_PATH, help=f\"Path to the SQLite database file (default: {DEFAULT_DB_PATH}).\")\n    parser.add_argument(\"--api-key\", default=os.getenv(\"NUMBASE_API_KEY\"), help=\"API key for HTTP server (optional, from NUMBASE_API_KEY env var).\")\n    parser.add_argument(\"--http-port\", type=int, default=8000, help=\"Port for the HTTP API server (default: 8000).\")\n\n    subparsers = parser.add_subparsers(dest=\"app_mode\", help=\"Choose application mode (cli or api)\", required=True)\n\n    cli_parser = subparsers.add_parser(\"cli\", help=\"Run the command-line interface for conversions.\")\n    cli_parser.add_argument(\"command\", nargs=argparse.REMAINDER, help=\"CLI command and its arguments (e.g., 'convert 10 2').\")\n\n    api_parser = subparsers.add_parser(\"api\", help=\"Run the HTTP API server.\")\n\n    args = parser.parse_args(argv)\n\n    converter = NumberBaseConverter()\n    repo = ConversionLogRepository(db_path=args.db_path)\n    try:\n        repo.init_db()\n    except PersistenceError as e:\n        logger.error(f\"Failed to initialize database at {args.db_path}: {e}\")\n        return 1\n\n    service = ConversionService(converter, repo)\n\n    if args.app_mode == \"cli\":\n        cli_controller = CLIController(service)\n        return cli_controller.run(args.command)\n    elif args.app_mode == \"api\":\n        try:\n            from uvicorn import run as uvicorn_run\n        except ImportError:\n            logger.error(\"Uvicorn is not installed. Please install it to run the API: pip install 'uvicorn[standard]'.\")\n            return 1\n        \n        api_controller = APIController(service, api_key=args.api_key)\n        app = api_controller.create_app()\n        logger.info(f\"Starting API server on http://0.0.0.0:{args.http_port}\")\n        uvicorn_run(app, host=\"0.0.0.0\", port=args.http_port)\n        return 0\n    else:\n        # Should not be reached due to required=True on subparsers, but as a safeguard\n        parser.print_help()\n        return 1\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n\n# src/numbase/__init__.py\nimport logging\nfrom .service import ConversionService\nfrom .converter import NumberBaseConverter\nfrom .repository import ConversionLogRepository\nfrom .dto import ConversionRequest\nfrom .exceptions import ConversionError, InvalidBaseError\n\nlogger = logging.getLogger(__name__)\n\n_default_converter = NumberBaseConverter()\n_default_repo = ConversionLogRepository()\ntry:\n    _default_repo.init_db()\nexcept Exception as e:\n    logger.warning(f\"Failed to initialize default database for `numbase` library function: {e}. Persistence will be disabled.\")\n    _default_repo = None # Disable persistence if init fails\n\n_default_service = ConversionService(_default_converter, _default_repo)\n\ndef change_base(x: int, base: int) -> str:\n    \"\"\"Converts a non-negative integer x to its string representation in a specified base (2-9).\"\"\"\n    req = ConversionRequest(x, base)\n    res = _default_service.convert_request(req)\n    return res.result\n\n__all__ = [\"change_base\", \"ConversionError\", \"InvalidBaseError\", \"NumberBaseConverter\"]\n\n# pyproject.toml\n\"\"\"\n[project]\nname = \"numbase\"\nversion = \"0.1.0\"\ndescription = \"A reliable library to convert non-negative integers to a string representation in a specified base (2-9).\"\nreadme = \"README.md\"\nauthors = [{ name = \"Your Name\", email = \"your.email@example.com\" }]\nrequires-python = \">=3.8\"\ndependencies = [\n    \"fastapi>=0.100.0\",\n    \"uvicorn[standard]>=0.22.0\",\n    \"pydantic>=1.8.2,<2.0.0\"\n]\n\n[project.scripts]\nnumbase = \"numbase.cli:main\"\n\n[project.optional-dependencies]\ndev = [\n    \"pytest>=7.0.0\",\n    \"mypy>=1.0.0\",\n    \"flake8>=6.0.0\",\n    \"ruff>=0.0.270\",\n]\n\n[build-system]\nrequires = [\"setuptools>=61.0\", \"wheel\"]\nbuild-backend = \"setuptools.build_meta\"\n\"\"\"\n\n# README.md\n\"\"\"\n# Numbase Converter\n\nA Python library and application for converting non-negative integers to a string representation in a specified base (2-9). It provides a library API, a command-line interface (CLI), and an optional HTTP API. Conversion requests are persisted to a local SQLite database for auditing/analytics.\n\n## Features\n\n- **Library Function**: `numbase.change_base(x, base)`\n- **CLI**: `numbase cli convert <x> <base>`\n- **HTTP API**: `POST /convert` endpoint (requires FastAPI/Uvicorn)\n- **Persistence**: Conversion requests and results are logged to an SQLite database.\n- **Error Handling**: Comprehensive input validation with specific exceptions.\n- **Optional API Key**: Secure the HTTP API with an API key.\n\n## Installation\n\n1.  Clone the repository:\n    ```bash\n    git clone https://github.com/yourusername/numbase.git\n    cd numbase\n    ```\n2.  Install in editable mode with development dependencies:\n    ```bash\n    pip install -e \".[dev]\"\n    ```\n    Or install just the core package:\n    ```bash\n    pip install .\n    ```\n\n## Usage\n\n### Library\n\n```python\nimport numbase\ntry:\n    result = numbase.change_base(8, 3)\n    print(f\"8 in base 3 is: {result}\") # Output: 22\n    result = numbase.change_base(15, 2)\n    print(f\"15 in base 2 is: {result}\") # Output: 1111\nexcept numbase.InvalidBaseError as e:\n    print(f\"Error: {e}\")\nexcept numbase.ConversionError as e:\n    print(f\"Error: {e}\")\n```\n\n### Command Line Interface (CLI)\n\nThe CLI supports `convert` command:\n\n```bash\n# Convert 8 to base 3\nnumbase cli convert 8 3\n# Output: 22\n\n# Get help\nnumbase cli convert --help\nnumbase --help\n```\n\nYou can specify a custom database path:\n```bash\nnumbase --db-path my_conversions.db cli convert 100 8\n```\n\n### HTTP API\n\nTo run the HTTP API server:\n\n```bash\n# Start the API server\nnumbase api\n# The API will be available at http://0.0.0.0:8000\n\n# Set an API key via environment variable (recommended) or --api-key argument\nexport NUMBASE_API_KEY=\"your_secret_api_key\"\nnumbase api --http-port 8080\n```\n\nOnce running, you can send POST requests:\n\n```bash\ncurl -X POST \"http://localhost:8000/convert\" \\\n     -H \"Content-Type: application/json\" \\\n     -H \"X-API-Key: your_secret_api_key\" \\\n     -d '{\"x\": 100, \"base\": 2}'\n# Expected output: {\"result\":\"1100100\"}\n\ncurl \"http://localhost:8000/health\"\n# Expected output: {\"status\":\"ok\"}\n```\n\nIf `NUMBASE_API_KEY` is not set or `--api-key` is not provided, the API will run without authentication.\n\n## Database\n\nConversion logs are stored in an SQLite database file (`numbase_conversions.db` by default). The `conversions` table has the following schema:\n```sql\nCREATE TABLE conversions (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    x INTEGER NOT NULL,\n    base INTEGER NOT NULL,\n    result TEXT NOT NULL,\n    ts TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\nCREATE INDEX idx_conversions_ts ON conversions(ts DESC);\nCREATE INDEX idx_conversions_x ON conversions(x);\n```\nThe database is initialized automatically on application startup.\n\n## Development and Testing\n\nRun tests with pytest:\n```bash\npytest\n```\n\nRun linting and type checking:\n```bash\nmypy src/numbase\nruff check src/numbase\n```\n\"\"\"\n\n# migrations/0001_create_conversions.sql\n\"\"\"\n-- Migration 0001: Create conversions table and indexes\nCREATE TABLE IF NOT EXISTS conversions (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    x INTEGER NOT NULL,\n    base INTEGER NOT NULL,\n    result TEXT NOT NULL,\n    ts TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE INDEX IF NOT EXISTS idx_conversions_ts ON conversions(ts DESC);\nCREATE INDEX IF NOT EXISTS idx_conversions_x ON conversions(x);\n\"\"\"\n```"}
