{"task_id": "HumanEval/123", "solution": "```python\ndef get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    The returned list should contain unique odd numbers from the sequence, sorted in increasing order.\n    \"\"\"\n    current_n = n\n    odd_numbers = set()\n\n    while True:\n        if current_n % 2 != 0:\n            odd_numbers.add(current_n)\n\n        if current_n == 1:\n            break\n\n        if current_n % 2 == 0:\n            current_n = current_n // 2\n        else:\n            current_n = 3 * current_n + 1\n            \n    return sorted(list(odd_numbers))\n```"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    The returned list will be deduplicated and sorted in increasing order.\n    \"\"\"\n    odd_numbers = set()\n    current_n = n\n\n    while True:\n        if current_n % 2 != 0:  # Check if odd\n            odd_numbers.add(current_n)\n\n        if current_n == 1:\n            break\n        elif current_n % 2 == 0:  # Even\n            current_n = current_n // 2\n        else:  # Odd\n            current_n = 3 * current_n + 1\n\n    return sorted(list(odd_numbers))"}
{"task_id": "HumanEval/124", "solution": "```python\ndef valid_date(date):\n    \"\"\"Validates a date string in mm-dd-yyyy format.\n    Returns True if valid, False otherwise, based on specified rules.\n    \"\"\"\n    if not date:\n        return False\n\n    parts = date.split('-')\n\n    # Rule 4: The date should be in the format: mm-dd-yyyy\n    if len(parts) != 3:\n        return False\n\n    try:\n        month = int(parts[0])\n        day = int(parts[1])\n        # Year can be any integer, no specific range validation\n        year = int(parts[2]) \n    except ValueError:\n        # If any part is not a valid integer, it's an invalid date format\n        return False\n\n    # Rule 3: The months should not be less than 1 or higher than 12.\n    if not (1 <= month <= 12):\n        return False\n\n    # Rule 2: Days validation based on month\n    if month in {1, 3, 5, 7, 8, 10, 12}:\n        if not (1 <= day <= 31):\n            return False\n    elif month in {4, 6, 9, 11}:\n        if not (1 <= day <= 30):\n            return False\n    elif month == 2: # February\n        # Per business rules, day <= 29 is allowed for February.\n        if not (1 <= day <= 29):\n            return False\n    else:\n        # Should not be reached if month is already validated between 1 and 12,\n        # but included for robustness if month validation logic changes.\n        return False\n\n    return True\n```"}
{"task_id": "HumanEval/124", "solution": "```python\ndef valid_date(date):\n    \"\"\"\n    Validates a date string in \"mm-dd-yyyy\" format.\n    Returns True for valid dates, False otherwise, without raising exceptions.\n    \"\"\"\n    if not date:\n        return False\n\n    parts = date.split('-')\n    if len(parts) != 3:\n        return False\n\n    m_s, d_s, y_s = parts\n    \n    # Ensure all components are numeric strings.\n    if not (m_s.isdigit() and d_s.isdigit() and y_s.isdigit()):\n        return False\n\n    month, day, year = int(m_s), int(d_s), int(y_s)\n\n    # Validate month range (1-12).\n    if not (1 <= month <= 12):\n        return False\n\n    # Determine maximum allowed day for the month, per business rules.\n    if month in [1, 3, 5, 7, 8, 10, 12]:\n        max_day = 31\n    elif month in [4, 6, 9, 11]:\n        max_day = 30\n    elif month == 2:  # February allows up to 29 days, irrespective of leap year.\n        max_day = 29\n    else: # This case should be covered by month validation but is a safeguard.\n        return False\n\n    # Validate day range (1 to max_day).\n    if not (1 <= day <= max_day):\n        return False\n\n    return True\n```"}
{"task_id": "HumanEval/125", "solution": "```python\ndef split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    Examples\n    split_words(\"Hello world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"Hello,world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"abcdef\") == 3\n    '''\n    if any(c.isspace() for c in txt):\n        return txt.split()\n\n    if \",\" in txt:\n        parts = [p.strip() for p in txt.split(\",\")]\n        return [p for p in parts if p != \"\"]\n\n    count = 0\n    for char in txt:\n        if 'a' <= char <= 'z':\n            alphabet_index = ord(char) - ord('a')\n            if alphabet_index % 2 == 1:\n                count += 1\n    return count\n```"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    \"\"\"\n    Splits text by whitespace, then by commas, or counts lowercase odd-order letters.\n    Applies rules in order: whitespace, then comma, then character count.\n    \"\"\"\n    # Rule 1: If txt contains any whitespace characters, split on any whitespace.\n    if any(ch.isspace() for ch in txt):\n        return txt.split()\n\n    # Rule 2: Else if txt contains one or more commas, split on commas.\n    if ',' in txt:\n        return txt.split(',')\n\n    # Rule 3: Else compute and return the count of lowercase letters whose alphabetical order index is odd.\n    count = 0\n    alphabet_offset = ord('a')\n    for ch in txt:\n        if 'a' <= ch <= 'z':\n            idx = ord(ch) - alphabet_offset\n            if idx % 2 == 1:\n                count += 1\n    return count"}
