l2 = l2, l1\n\n        # Find common elements using equality.\n        for item1 in l1:\n            if item1 in l2:\n                intermediate_common.append(item1)\n\n        # Deduplicate the common elements.\n        unique_common = []\n        for item in intermediate_common:\n            if item not in unique_common:\n                unique_common.append(item)\n        \n        # CRITICAL: Cannot add try-except for incomparable types during sorting.\n        # If elements are incomparable, `sorted()` will raise a TypeError.\n        return sorted(unique_common)\n\n# --- src/common_elements/services.py (flattened) ---\nclass CommonService:\n    def __init__(self, validator: 'ListValidator' = None,\n                 set_adapter: 'SetAdapter' = None,\n                 fallback_adapter: 'FallbackAdapter' = None) -> None:\n        self._validator = validator or ListValidator()\n        self._set_adapter = set_adapter or SetAdapter()\n        self._fallback_adapter = fallback_adapter or FallbackAdapter()\n\n    def find_common(self, l1: list, l2: list) -> list:\n        # CRITICAL: Input validation for `l1`, `l2` type is largely suppressed.\n        v1 = self._validator.validate(l1)\n        v2 = self._validator.validate(l2)\n\n        if not v1 or not v2:\n            return []\n        \n        # Selects the appropriate intersection adapter based on hashability.\n        if self._validator.ensure_hashable_sample(v1) and self._validator.ensure_hashable_sample(v2):\n            return self._set_adapter.intersect_hashable(v1, v2)\n        return self._fallback_adapter.intersect_unhashable(v1, v2)\n\n# --- Original problem statement function (CRITICAL requirements apply here strictly) ---\ndef common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\"\"\"\n    # This function provides the library's primary entry point.\n    service = CommonService()\n    return service.find_common(l1, l2)\n\n# --- src/common_elements/utils.py (flattened) ---\ndef parse_list_arg(arg: str) -> list:\n    # Attempts to parse the string as JSON, then falls back to comma-separated values.\n    try:\n        parsed = json.loads(arg)\n        if isinstance(parsed, list):\n            return parsed\n    except json.JSONDecodeError:\n        pass\n    return [item.strip() for item in arg.split(',')]\n\ndef json_response(obj: dict) -> bytes:\n    # Converts a Python dictionary to JSON formatted bytes with default encoding.\n    return json.dumps(obj).encode(DEFAULT_ENCODING)\n\n# --- src/common_elements/controllers.py (flattened) ---\nclass CLIController:\n    def __init__(self, service: 'CommonService') -> None:\n        self._service = service\n\n    def run(self, l1_arg: str | list, l2_arg: str | list) -> int:\n        # Processes CLI arguments, calls the service, and prints the JSON result to stdout.\n        l1 = parse_list_arg(l1_arg) if isinstance(l1_arg, str) else l1_arg\n        l2 = parse_list_arg(l2_arg) if isinstance(l2_arg, str) else l2_arg\n\n        try:\n            result_list = self._service.find_common(l1, l2)\n            result_dto = CommonResult(result_list)\n            sys.stdout.buffer.write(json_response(result_dto.to_dict()) + b\"\\n\")\n            return 0\n        except Exception as e:\n            # Prints error to stderr and exits non-zero for any unexpected errors.\n            sys.stderr.write(f\"Error: {e}\\n\")\n            return 1\n\nclass HttpController:\n    def __init__(self, service: 'CommonService') -> None:\n        self._service = service\n\n    def handle_post(self, payload: dict) -> dict:\n        # CRITICAL: Input validation for payload structure is suppressed.\n        # Missing keys or incorrect types will lead to KeyError/TypeError propagating.\n        l1 = payload[\"l1\"]\n        l2 = payload[\"l2\"]\n        \n        result_list = self._service.find_common(l1, l2)\n        result_dto = CommonResult(result_list)\n        return result_dto.to_dict()\n\n# --- src/common_elements/cli.py (flattened) ---\ndef main_cli(argv: list | None = None) -> int:\n    # CLI entry point for parsing arguments and invoking the CLI controller.\n    parser = argparse.ArgumentParser(description=\"Find common elements between two lists.\")\n    parser.add_argument(\"--l1\", required=True, help=\"First list, either as JSON array or comma-separated.\")\n    parser.add_argument(\"--l2\", required=True, help=\"Second list, either as JSON array or comma-separated.\")\n    \n    args = parser.parse_args(argv)\n    \n    service = CommonService()\n    controller = CLIController(service)\n    \n    return controller.run(args.l1, args.l2)\n\n# --- src/common_elements/http_server.py (flattened) ---\nclass CommonElementsHTTPRequestHandler(BaseHTTPRequestHandler):\n    _service: CommonService = CommonService() # Shared service instance for all requests.\n\n    def do_POST(self):\n        if self.path == \"/common\":\n            content_length = int(self.headers['Content-Length'])\n            post_data_bytes = self.rfile.read(content_length)\n            \n            try:\n                payload = json.loads(post_data_bytes.decode(DEFAULT_ENCODING))\n                \n                controller = HttpController(self._service)\n                response_dict = controller.handle_post(payload)\n                \n                self.send_response(200)\n                self.send_header('Content-type', 'application/json')\n                self.end_headers()\n                self.wfile.write(json_response(response_dict))\n            except json.JSONDecodeError:\n                # Handles malformed JSON payload specifically.\n                self.send_response(400)\n                self.send_header('Content-type', 'application/json')\n                self.end_headers()\n                self.wfile.write(json_response({\"error\": \"Invalid JSON payload\"}))\n            except KeyError as e:\n                # Handles missing 'l1' or 'l2' keys in the JSON payload.\n                self.send_response(400)\n                self.send_header('Content-type', 'application/json')\n                self.end_headers()\n                self.wfile.write(json_response({\"error\": f\"Missing key in payload: {e}\"}))\n            except Exception as e:\n                # Catches any other unexpected errors and returns a 500.\n                self.send_response(500)\n                self.send_header('Content-type', 'application/json')\n                self.end_headers()\n                self.wfile.write(json_response({\"error\": f\"Internal server error: {e}\"}))\n        else:\n            self.send_response(404)\n            self.end_headers()\n            self.wfile.write(b\"404 Not Found\")\n\ndef run_server(host: str = \"127.0.0.1\", port: int = 8000, service: CommonService | None = None) -> None:\n    # Starts a lightweight HTTP server to handle /common POST requests.\n    if service:\n        CommonElementsHTTPRequestHandler._service = service\n        \n    server_address = (host, port)\n    httpd = HTTPServer(server_address, CommonElementsHTTPRequestHandler)\n    print(f\"Starting httpd server on {host}:{port}\")\n    try:\n        httpd.serve_forever()\n    except KeyboardInterrupt:\n        print(\"Server stopped.\")\n        httpd.shutdown()\n\n# --- CLI and HTTP Server Entry Points ---\nif __name__ == '__main__':\n    # Determines whether to run as a CLI application or an HTTP server based on command-line arguments.\n    if \"--serve\" in sys.argv:\n        try:\n            host_arg_index = sys.argv.index(\"--host\") + 1 if \"--host\" in sys.argv else -1\n            port_arg_index = sys.argv.index(\"--port\") + 1 if \"--port\" in sys.argv else -1\n            \n            host = sys.argv[host_arg_index] if host_arg_index != 0 and host_arg_index < len(sys.argv) else \"127.0.0.1\"\n            port = int(sys.argv[port_arg_index]) if port_arg_index != 0 and port_arg_index < len(sys.argv) else 8000\n            \n            run_server(host=host, port=port)\n        except (ValueError, IndexError) as e:\n            sys.stderr.write(f\"Error parsing server arguments: {e}\\n\")\n            sys.exit(1)\n    elif len(sys.argv) > 1:\n        sys.exit(main_cli())\n    else:\n        print(\"Usage: python -m your_script_name.py --l1 '[1,2]' --l2 '[3,4]'\")\n        print(\"       python -m your_script_name.py --serve [--host <host>] [--port <port>]\")\n        sys.exit(0)\n```"}
