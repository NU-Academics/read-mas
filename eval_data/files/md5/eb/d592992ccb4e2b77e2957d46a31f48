{"task_id": "HumanEval/104", "solution": "def unique_digits(x):\n    \"\"\"Given a list of positive integers x, return a sorted list of all\n    elements that hasn't any even digit.\n    \"\"\"\n\n    even_digits = {'0', '2', '4', '6', '8'}\n\n    result = []\n    for num in x:\n        # Convert the number to a string to check each digit.\n        s_num = str(num)\n        \n        has_even_digit = False\n        for digit_char in s_num:\n            if digit_char in even_digits:\n                has_even_digit = True\n                break\n        \n        if not has_even_digit:\n            result.append(num)\n            \n    result.sort()\n    return result"}
{"task_id": "HumanEval/105", "solution": "```python\ndef by_length(arr):\n    \"\"\"\n    Sorts integers in range [1, 9] from an array, reverses them, and maps to English names.\n    Ignores non-numeric or out-of-range values.\n    \"\"\"\n    number_to_name = {\n        1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n        6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\"\n    }\n\n    # Filter integers to only those in the inclusive range [1, 9]\n    filtered_numbers = [num for num in arr if 1 <= num <= 9]\n\n    # Sort the filtered integers in ascending order, then reverse to descending order\n    filtered_numbers.sort()\n    filtered_numbers.reverse()\n\n    # Map each integer in the descending list to its English name\n    mapped_names = [number_to_name[num] for num in filtered_numbers]\n\n    return mapped_names\n```"}
{"task_id": "HumanEval/106", "solution": "def f(n):\n    \"\"\"Generates a list where elements are factorials for even indices or sums for odd indices.\"\"\"\n    factorial_cache = {0: 1, 1: 1}\n\n    def _get_factorial(k):\n        \"\"\"Computes factorial of k, utilizing a local cache for memoization.\"\"\"\n        if k in factorial_cache:\n            return factorial_cache[k]\n\n        # Find the largest cached factorial less than or equal to k\n        last_known_k = 0\n        for cached_k in factorial_cache:\n            if cached_k < k and cached_k > last_known_k:\n                last_known_k = cached_k\n        \n        res = factorial_cache[last_known_k]\n        for x in range(last_known_k + 1, k + 1):\n            res *= x\n            factorial_cache[x] = res # Cache intermediate results\n        return res\n\n    def _get_sum_to(k):\n        \"\"\"Calculates the sum of integers from 1 to k.\"\"\"\n        return k * (k + 1) // 2\n\n    result = []\n    for i in range(1, n + 1):\n        if i % 2 == 0:  # i is even\n            result.append(_get_factorial(i))\n        else:  # i is odd\n            result.append(_get_sum_to(i))\n    return result"}
{"task_id": "HumanEval/105", "solution": "def by_length(arr):\n    \"\"\"\n    Given an array of integers, sort the integers that are between 1 and 9 inclusive,\n    reverse the resulting array, and then replace each digit by its corresponding name.\n    \"\"\"\n    DIGIT_NAMES = {\n        1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n        6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\"\n    }\n\n    # Filter elements to include only numbers between 1 and 9 inclusive.\n    # Assume input elements are numeric and comparable to integers.\n    filtered_nums = [n for n in arr if 1 <= n <= 9]\n\n    # Sort the filtered elements ascending.\n    sorted_nums = sorted(filtered_nums)\n\n    # Reverse the sorted list.\n    reversed_nums = sorted_nums[::-1]\n\n    # Map each integer to its English name.\n    mapped_names = [DIGIT_NAMES[n] for n in reversed_nums]\n\n    return mapped_names"}
{"task_id": "HumanEval/107", "solution": "```python\ndef even_odd_palindrome(n):\n    \"\"\"\n    Counts even and odd integer palindromes in the range [1, n].\n    Returns a tuple (even_count, odd_count).\n    \"\"\"\n\n    def is_palindrome(s: str) -> bool:\n        \"\"\"Checks if a string is a palindrome.\"\"\"\n        return s == s[::-1]\n\n    even_count = 0\n    odd_count = 0\n\n    for i in range(1, n + 1):\n        if is_palindrome(str(i)):\n            if i % 2 == 0:\n                even_count += 1\n            else:\n                odd_count += 1\n\n    return (even_count, odd_count)\n```"}
{"task_id": "HumanEval/106", "solution": "def _factorial(i):\n    \"\"\"Calculates the factorial of i (product of 1 to i).\n    Assumes i is a positive integer.\n    \"\"\"\n    product = 1\n    for j in range(1, i + 1):\n        product *= j\n    return product\n\ndef _sum_to(i):\n    \"\"\"Calculates the sum of numbers from 1 to i.\n    Assumes i is a positive integer.\n    \"\"\"\n    return i * (i + 1) // 2\n\ndef f(n):\n    \"\"\"Implement the function f that takes n as a parameter, and returns a list of size n,\n    where values are factorial(i) if i is even, or sum(1..i) if i is odd.\n    \"\"\"\n    sequence = []\n    for i in range(1, n + 1):\n        if i % 2 == 0:\n            sequence.append(_factorial(i))\n        else:\n            sequence.append(_sum_to(i))\n    return sequence"}
{"task_id": "HumanEval/107", "solution": "def even_odd_palindrome(n):\n    \"\"\"\n    Given a positive integer n, return a tuple with the number of even and odd\n    integer palindromes in the range [1, n].\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    for i in range(1, n + 1):\n        # Check if i is a palindrome\n        s = str(i)\n        if s == s[::-1]:\n            # Check if the palindrome is even or odd\n            if i % 2 == 0:\n                even_count += 1\n            else:\n                odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/108", "solution": "def count_nums(arr):\n    \"\"\"\n    Counts numbers whose sum of signed digits is greater than zero.\n    Negative numbers' most significant digit is negative.\n    \"\"\"\n    total_count = 0\n    for num in arr:\n        signed_sum = 0\n        if num == 0:\n            signed_sum = 0\n        else:\n            # Convert the absolute value of the number to a string to extract digits.\n            s_num = str(abs(num))\n            digits = [int(d) for d in s_num]\n\n            # Apply the business rule for negative numbers: negate the most significant digit.\n            if num < 0:\n                digits[0] = -digits[0]\n\n            # Sum the processed digits.\n            signed_sum = sum(digits)\n\n        # Increment the total count if the sum of signed digits is positive.\n        if signed_sum > 0:\n            total_count += 1\n    return total_count"}
{"task_id": "HumanEval/108", "solution": "```python\ndef count_nums(arr):\n    \"\"\"\n    Counts numbers in an array where the sum of signed digits is positive.\n    The first digit of a negative number is considered negative.\n    \"\"\"\n    total_count = 0\n    for n in arr:\n        if n == 0:\n            signed_digits = [0]\n        else:\n            sign = -1 if n < 0 else 1\n            abs_str = str(abs(n))\n            digits = [int(ch) for ch in abs_str]\n            if sign < 0:\n                digits[0] = -digits[0]\n            signed_digits = digits\n\n        digit_sum = sum(signed_digits)\n\n        if digit_sum > 0:\n            total_count += 1\n    return total_count\n```"}
{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr):\n    \"\"\"Checks if an array can be sorted non-decreasingly by right circular shifts.\n    Returns True for empty or single-element arrays, or a single 'descent' if ends meet.\n    \"\"\"\n    n = len(arr)\n    if n <= 1:\n        return True\n\n    descents = 0\n    for i in range(n - 1):\n        if arr[i] > arr[i + 1]:\n            descents += 1\n            if descents > 1:\n                return False\n\n    if descents == 0:\n        return True\n    else:  # descents == 1\n        return arr[-1] <= arr[0]"}
{"task_id": "HumanEval/109", "solution": "```python\ndef move_one_ball(arr):\n    \"\"\"We have an array 'arr' of N integers arr[1], arr[2], ..., arr[N].The\n    numbers in the array will be randomly ordered. Your task is to determine if\n    it is possible to get an array sorted in non-decreasing order by performing \n    the following operation on the given array:\n        You are allowed to perform right shift operation any number of times.\n    \n    One right shift operation means shifting all elements of the array by one\n    position in the right direction. The last element of the array will be moved to\n    the starting position in the array i.e. 0th index. \n\n    If it is possible to obtain the sorted array by performing the above operation\n    then return True else return False.\n    If the given array is empty then return True.\n\n    Note: The given list is guaranteed to have unique elements.\n\n    For Example:\n    \n    move_one_ball([3, 4, 5, 1, 2])==>True\n    Explanation: By performin 2 right shift operations, non-decreasing order can\n                 be achieved for the given array.\n    move_one_ball([3, 5, 4, 1, 2])==>False\n    Explanation:It is not possible to get non-decreasing order for the given\n                array by performing any number of right shift operations.\n                \n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return True\n\n    # Count 'decrease points' where arr[i] > arr[i+1]. A rotatable sorted array\n    # will have at most one such point (or zero if already sorted).\n    num_decreases = 0\n    decrease_idx = -1\n    \n    for i in range(n - 1):\n        if arr[i] > arr[i + 1]:\n            num_decreases += 1\n            decrease_idx = i\n            # If more than one decrease point is found, it's impossible.\n            if num_decreases > 1:\n                return False\n\n    # If no decrease points, the array is already sorted.\n    if num_decreases == 0:\n        return True\n    \n    # If exactly one decrease point exists, check the wrap-around condition.\n    # The last element of the array must be less than or equal to the first element\n    # for the rotated array to be sorted.\n    if arr[n - 1] <= arr[0]:\n        return True\n    else:\n        return False\n\n```"}
{"task_id": "HumanEval/110", "solution": "def exchange(lst1, lst2):\n    \"\"\"Determines if elements can be exchanged between lists to make lst1 all even.\n    Returns \"YES\" if possible, otherwise \"NO\".\n    \"\"\"\n    \n    # Count the number of odd elements in the first list.\n    odds_in_lst1 = sum(1 for x in lst1 if x % 2 != 0)\n\n    # Count the number of even elements available in the second list for exchange.\n    evens_in_lst2 = sum(1 for x in lst2 if x % 2 == 0)\n\n    # If there are enough even numbers in lst2 to replace all odd numbers in lst1, it's possible.\n    if evens_in_lst2 >= odds_in_lst1:\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/110", "solution": "def exchange(lst1, lst2):\n    \"\"\"Determines if elements can be exchanged between lst1 and lst2 to make lst1 all even.\n    Returns \"YES\" if possible, \"NO\" otherwise.\"\"\"\n\n    odd_elements_in_lst1 = 0\n    for x in lst1:\n        if x % 2 != 0:\n            odd_elements_in_lst1 += 1\n\n    even_elements_in_lst2 = 0\n    for x in lst2:\n        if x % 2 == 0:\n            even_elements_in_lst2 += 1\n\n    if even_elements_in_lst2 >= odd_elements_in_lst1:\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/111", "solution": "import collections\n\ndef histogram(test):\n    \"\"\"Given a string of space-separated lowercase letters, return a dictionary\n    of the letter(s) with the most repetition and their corresponding count.\n    If the input string is empty, an empty dictionary is returned.\n    \"\"\"\n    tokens = test.split()\n    counts = collections.Counter(tokens)\n    \n    if not counts:\n        return {}\n\n    max_count = max(counts.values())\n    \n    result = {letter: count for letter, count in counts.items() if count == max_count}\n    \n    return result"}
{"task_id": "HumanEval/112", "solution": "def reverse_delete(s,c):\n    \"\"\"\n    Deletes characters from string s that appear in string c, then checks if the resulting string is a palindrome.\n    The deletion is case-sensitive by default, and an empty string is considered a palindrome.\n    \"\"\"\n    chars_to_delete = set(c)\n    \n    result_str_list = []\n    for char_s in s:\n        if char_s not in chars_to_delete:\n            result_str_list.append(char_s)\n    \n    result_str = \"\".join(result_str_list)\n    \n    is_palindrome = (result_str == result_str[::-1])\n    \n    return result_str, is_palindrome"}
{"task_id": "HumanEval/111", "solution": "```python\nimport collections\nimport re\n\ndef histogram(test):\n    \"\"\"Given a string of space-separated lowercase letters, returns a dictionary\n    of the most repeated letters and their counts. Handles ties and returns an empty\n    dictionary for no valid input.\n    \"\"\"\n    valid_letter_regex = re.compile(r'^[a-z]$')\n    tokens = test.split()\n    \n    valid_letters = [token for token in tokens if valid_letter_regex.match(token)]\n\n    if not valid_letters:\n        return {}\n\n    counts = collections.Counter(valid_letters)\n    \n    max_count = max(counts.values())\n\n    result = {letter: count for letter, count in counts.items() if count == max_count}\n\n    return result\n```"}
{"task_id": "HumanEval/112", "solution": "def reverse_delete(s, c):\n    \"\"\"Deletes characters from s found in c, then checks if the resulting string is a palindrome.\n    Returns a tuple: (filtered_string, is_palindrome_boolean).\"\"\"\n    chars_to_remove = set(c)\n    filtered_chars = []\n    for char_s in s:\n        if char_s not in chars_to_remove:\n            filtered_chars.append(char_s)\n    \n    result_string = \"\".join(filtered_chars)\n    is_palindrome = (result_string == result_string[::-1])\n    \n    return (result_string, is_palindrome)"}
{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums):\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty sub-array.\n    Implements a Kadane-like algorithm variant for minimum subarray sum.\n    \"\"\"\n    current_min = nums[0]\n    global_min = nums[0]\n    for n in nums[1:]:\n        current_min = min(n, current_min + n)\n        global_min = min(global_min, current_min)\n    return global_min"}
{"task_id": "HumanEval/113", "solution": "def odd_count(lst):\n    \"\"\"Given a list of strings, where each string consists of only digits, return a list.\n    Each element i of the output should be \"the number of odd elements in the\n    string i of the input.\" where all the i's should be replaced by the number\n    of odd digits in the i'th string of the input.\n    \"\"\"\n    ODD_DIGITS = {'1', '3', '5', '7', '9'}\n    BASE_TEMPLATE = \"the number of odd elements in the string i of the input.\"\n    results = []\n\n    for s in lst:\n        count = sum(1 for ch in s if ch in ODD_DIGITS)\n        c_str = str(count)\n        # Apply specific replacements for 'i' in \"in\", \"string\", and \"input\".\n        formatted_message = BASE_TEMPLATE.replace(\" in \", f\" {c_str}n \")\n        formatted_message = formatted_message.replace(\" string \", f\" str{c_str}ng \")\n        formatted_message = formatted_message.replace(\" input\", f\" {c_str}nput\")\n        results.append(formatted_message)\n        \n    return results"}
{"task_id": "HumanEval/113", "solution": "To implement the software design specification, the following Python code is generated, adhering to the specified file structure, class designs, and critical requirements for the `odd_count` function.\n\n```python\n# src/oddcount_app/__init__.py\n\ndef odd_count(lst):\n    \"\"\"Given a list of strings, where each string consists of only digits, return a list.\n    Each element i of the output should be \"the number of odd elements in the\n    string i of the input.\" where all the i's should be replaced by the number\n    of odd digits in the i'th string of the input.\n    \"\"\"\n    template = \"the number of odd elements in the string i of the input.\"\n    results = []\n    for s in lst:\n        count = 0\n        for ch in s:\n            if ch in \"13579\":\n                count += 1\n        results.append(template.replace(\"i\", str(count)))\n    return results\n\n```\n\n```python\n# src/oddcount_app/config.py\nimport os\nfrom typing import Optional\n\nclass AppConfig:\n    \"\"\"Application configuration with safe defaults and environment variable overrides.\"\"\"\n    def __init__(\n        self,\n        log_level: str = \"INFO\",\n        audit_file_path: str = \"./data/audit.log\",\n        template: str = \"the number of odd elements in the string i of the input.\",\n        api_token: Optional[str] = None,\n        host: str = \"127.0.0.1\",\n        port: int = 8000,\n    ) -> None:\n        self.log_level = log_level\n        self.audit_file_path = audit_file_path\n        self.template = template\n        self.api_token = api_token\n        self.host = host\n        self.port = port\n\n    @classmethod\n    def from_env(cls) -> \"AppConfig\":\n        \"\"\"Read environment variables and return an AppConfig instance.\"\"\"\n        return cls(\n            log_level=os.getenv(\"ODDCOUNT_LOG_LEVEL\", \"INFO\"),\n            audit_file_path=os.getenv(\"ODDCOUNT_AUDIT_PATH\", \"./data/audit.log\"),\n            template=os.getenv(\"ODDCOUNT_TEMPLATE\", \"the number of odd elements in the string i of the input.\"),\n            api_token=os.getenv(\"ODDCOUNT_API_TOKEN\"),\n            host=os.getenv(\"ODDCOUNT_HOST\", \"127.0.0.1\"),\n            port=int(os.getenv(\"ODDCOUNT_PORT\", \"8000\")),\n        )\n\n```\n\n```python\n# src/oddcount_app/exceptions.py\n\nclass InvalidInputError(Exception):\n    \"\"\"Indicate input validation failure; used by Validator and InputModel.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass PersistenceError(Exception):\n    \"\"\"Indicate failure to persist a record.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\n```\n\n```python\n# src/oddcount_app/models/__init__.py\n\n# Marker for Python package\n\n```\n\n```python\n# src/oddcount_app/models/input_model.py\nfrom typing import List\nfrom oddcount_app.exceptions import InvalidInputError\n\nclass InputModel:\n    \"\"\"Wrap input list and validate basic structure.\"\"\"\n    def __init__(self, inputs: List[str]) -> None:\n        self.inputs = inputs\n\n    def validate(self) -> None:\n        \"\"\"Ensures inputs is a list and each element is a string.\"\"\"\n        if not isinstance(self.inputs, list):\n            raise InvalidInputError(\"Input must be a list.\")\n        for item in self.inputs:\n            if not isinstance(item, str):\n                raise InvalidInputError(f\"All elements in input list must be strings, got: {type(item).__name__}\")\n\n```\n\n```python\n# src/oddcount_app/models/result_model.py\nfrom typing import List, Dict\n\nclass ResultModel:\n    \"\"\"Wrap results for response and persistence.\"\"\"\n    def __init__(self, outputs: List[str], request_id: str, timestamp: str) -> None:\n        self.outputs = outputs\n        self.request_id = request_id\n        self.timestamp = timestamp\n\n    def to_dict(self) -> Dict:\n        \"\"\"Return a dictionary representation for API responses.\"\"\"\n        return {\n            \"request_id\": self.request_id,\n            \"timestamp\": self.timestamp,\n            \"outputs\": self.outputs,\n        }\n\n```\n\n```python\n# src/oddcount_app/services/__init__.py\n\n# Marker for Python package\n\n```\n\n```python\n# src/oddcount_app/services/odd_counter_service.py\nfrom typing import List\nfrom uuid import uuid4\nfrom datetime import datetime\nimport logging\n\nfrom oddcount_app.exceptions import InvalidInputError, PersistenceError\nfrom oddcount_app.models.result_model import ResultModel\nfrom oddcount_app.utils.validator import Validator\nfrom oddcount_app.utils.template_renderer import TemplateRenderer\nfrom oddcount_app.repositories.output_repository import OutputRepository\n\nlogger = logging.getLogger(__name__)\n\nclass OddCounterService:\n    \"\"\"Principal business logic orchestrator: validation, counting, rendering, and persistence.\"\"\"\n    def __init__(self, validator: Validator, renderer: TemplateRenderer, repository: OutputRepository) -> None:\n        self._validator = validator\n        self._renderer = renderer\n        self._repository = repository\n\n    def count_odd_digits(self, s: str) -> int:\n        \"\"\"Return count of characters in s that are in {'1','3','5','7','9'}.\"\"\"\n        return sum(1 for ch in s if ch in \"13579\")\n\n    def process(self, inputs: List[str]) -> ResultModel:\n        \"\"\"Validate inputs, compute outputs, persist audit record, and return ResultModel.\"\"\"\n        for s in inputs:\n            if not self._validator.is_digit_string(s):\n                raise InvalidInputError(f\"Non-digit characters found in input string: '{s}'\")\n\n        outputs = [self._renderer.render(self.count_odd_digits(s)) for s in inputs]\n\n        request_id = str(uuid4())\n        timestamp = datetime.utcnow().isoformat(timespec='milliseconds') + \"Z\"\n\n        result = ResultModel(outputs=outputs, request_id=request_id, timestamp=timestamp)\n\n        audit_record = {\n            \"request_id\": request_id,\n            \"timestamp\": timestamp,\n            \"inputs\": inputs,\n            \"outputs\": outputs,\n        }\n\n        try:\n            self._repository.save(audit_record)\n        except PersistenceError as e:\n            logger.error(f\"Failed to persist audit record for request_id {request_id}: {e}\")\n            pass\n            \n        return result\n\n```\n\n```python\n# src/oddcount_app/utils/__init__.py\n\n# Marker for Python package\n\n```\n\n```python\n# src/oddcount_app/utils/validator.py\n\nclass Validator:\n    \"\"\"Low-level validators for digit strings.\"\"\"\n    def is_digit_string(self, s: str) -> bool:\n        \"\"\"Return True if s is composed only of characters '0'..'9'. Empty string returns True.\"\"\"\n        return all(ch.isdigit() for ch in s)\n\n```\n\n```python\n# src/oddcount_app/utils/template_renderer.py\n\nclass TemplateRenderer:\n    \"\"\"Render template by replacing 'i' with count.\"\"\"\n    def __init__(self, template: str) -> None:\n        self._template = template\n\n    def render(self, count: int) -> str:\n        \"\"\"Replace all 'i' characters in template with the decimal representation of count.\"\"\"\n        return self._template.replace(\"i\", str(count))\n\n```\n\n```python\n# src/oddcount_app/repositories/__init__.py\n\n# Marker for Python package\n\n```\n\n```python\n# src/oddcount_app/repositories/adapters/__init__.py\n\n# Marker for Python package\n\n```\n\n```python\n# src/oddcount_app/repositories/adapters/file_storage_adapter.py\nimport json\nimport os\nfrom oddcount_app.exceptions import PersistenceError\n\nclass FileStorageAdapter:\n    \"\"\"Append JSON-lines to disk atomically.\"\"\"\n    def __init__(self, file_path: str) -> None:\n        os.makedirs(os.path.dirname(file_path) or \".\", exist_ok=True)\n        self.file_path = file_path\n\n    def append_json_line(self, record: dict) -> None:\n        \"\"\"Open file in append mode, dump record, append newline, and fsync.\"\"\"\n        try:\n            line = json.dumps(record, ensure_ascii=False)\n            with open(self.file_path, \"a\", encoding=\"utf-8\") as f:\n                f.write(line + \"\\n\")\n                f.flush()\n                os.fsync(f.fileno())\n        except IOError as e:\n            raise PersistenceError(f\"Failed to write to audit file {self.file_path}: {e}\")\n\n```\n\n```python\n# src/oddcount_app/repositories/output_repository.py\nfrom typing import Dict\nfrom oddcount_app.repositories.adapters.file_storage_adapter import FileStorageAdapter\n\nclass OutputRepository:\n    \"\"\"High-level persistence operations for audit records.\"\"\"\n    def __init__(self, storage_adapter: FileStorageAdapter, audit_file_path: str) -> None:\n        self._storage_adapter = storage_adapter\n        self._audit_file_path = audit_file_path\n\n    def save(self, record: Dict) -> None:\n        \"\"\"Append record to audit file by calling storage_adapter.\"\"\"\n        self._storage_adapter.append_json_line(record)\n\n```\n\n```python\n# src/oddcount_app/controllers/__init__.py\n\n# Marker for Python package\n\n```\n\n```python\n# src/oddcount_app/controllers/cli_controller.py\nimport json\nimport sys\nfrom typing import List\n\nfrom oddcount_app.services.odd_counter_service import OddCounterService\nfrom oddcount_app.models.input_model import InputModel\nfrom oddcount_app.exceptions import InvalidInputError\n\nclass CliController:\n    \"\"\"CLI orchestration for processing inputs.\"\"\"\n    def __init__(self, service: OddCounterService) -> None:\n        self._service = service\n\n    def run(self, inputs: List[str]) -> int:\n        \"\"\"Call service.process and print outputs as JSON; returns exit code.\"\"\"\n        try:\n            input_model = InputModel(inputs)\n            input_model.validate()\n            result = self._service.process(inputs)\n            print(json.dumps({\"outputs\": result.outputs}))\n            return 0\n        except InvalidInputError as e:\n            print(f\"Error: {e.message}\", file=sys.stderr)\n            return 2\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1\n\n```\n\n```python\n# src/oddcount_app/controllers/api_controller.py\nfrom typing import List, Optional\nfrom oddcount_app.services.odd_counter_service import OddCounterService\nfrom oddcount_app.models.result_model import ResultModel\nfrom oddcount_app.models.input_model import InputModel\nfrom oddcount_app.exceptions import InvalidInputError\nfrom fastapi import HTTPException # This import is handled by api.py for handlers\n\nclass ApiController:\n    \"\"\"HTTP orchestration for a single request, including auth checks.\"\"\"\n    def __init__(self, service: OddCounterService, api_token: Optional[str]) -> None:\n        self._service = service\n        self._api_token = api_token\n\n    def process(self, inputs: List[str], auth_token: Optional[str] = None) -> ResultModel:\n        \"\"\"Validate token, call service.process, and return ResultModel.\"\"\"\n        if self._api_token and (not auth_token or self._api_token != auth_token):\n            raise HTTPException(status_code=401, detail=\"Unauthorized\")\n\n        input_model = InputModel(inputs)\n        input_model.validate()\n\n        try:\n            return self._service.process(inputs)\n        except InvalidInputError as e:\n            raise HTTPException(status_code=400, detail=e.message)\n        except Exception as e:\n            raise HTTPException(status_code=500, detail=f\"Internal server error: {e}\")\n\n```\n\n```python\n# src/oddcount_app/cli.py\nimport argparse\nimport sys\nimport json\nimport logging\nfrom typing import List\n\nfrom oddcount_app.config import AppConfig\nfrom oddcount_app.exceptions import InvalidInputError, PersistenceError\nfrom oddcount_app.utils.validator import Validator\nfrom oddcount_app.utils.template_renderer import TemplateRenderer\nfrom oddcount_app.repositories.adapters.file_storage_adapter import FileStorageAdapter\nfrom oddcount_app.repositories.output_repository import OutputRepository\nfrom oddcount_app.services.odd_counter_service import OddCounterService\nfrom oddcount_app.controllers.cli_controller import CliController\n\ndef main(argv: List[str] = None) -> int:\n    \"\"\"CLI entrypoint script that parses args and calls CliController.\"\"\"\n    if argv is None:\n        argv = sys.argv[1:]\n\n    config = AppConfig.from_env()\n\n    logging.basicConfig(level=config.log_level, format='%(asctime)s - %(name)s - %(levelname)s - %(message)s')\n    logger = logging.getLogger(__name__)\n\n    parser = argparse.ArgumentParser(description=\"Process digit strings and count odd elements.\")\n    parser.add_argument(\"--file\", \"-f\", help=\"Input file path (JSON-lines or single JSON array).\")\n    parser.add_argument(\"--stdin\", \"-s\", action=\"store_true\", help=\"Read input from stdin (JSON-lines or single JSON array).\")\n    parser.add_argument(\"--audit-file\", help=f\"Override default audit file path (default: {config.audit_file_path}).\")\n\n    args = parser.parse_args(argv)\n\n    if args.audit_file:\n        config.audit_file_path = args.audit_file\n\n    inputs_data = []\n    if args.file:\n        try:\n            with open(args.file, 'r', encoding='utf-8') as f:\n                first_char = f.read(1)\n                f.seek(0)\n                if first_char == '[': # Assume single JSON array if starts with [\n                    inputs_data = json.load(f)\n                else: # Assume JSON-lines otherwise\n                    inputs_data = [json.loads(line.strip()) for line in f if line.strip()]\n        except (FileNotFoundError, json.JSONDecodeError) as e:\n            logger.error(f\"Error reading input file {args.file}: {e}\")\n            print(f\"Error: Could not read or parse input file {args.file}: {e}\", file=sys.stderr)\n            return 1\n    elif args.stdin:\n        try:\n            full_stdin_content = sys.stdin.read().strip()\n            if not full_stdin_content:\n                print(\"Error: No input provided via stdin.\", file=sys.stderr)\n                return 2\n            if full_stdin_content.startswith('['): # Assume single JSON array if starts with [\n                inputs_data = json.loads(full_stdin_content)\n            else: # Assume JSON-lines otherwise\n                inputs_data = [json.loads(line) for line in full_stdin_content.splitlines() if line.strip()]\n        except json.JSONDecodeError as e:\n            logger.error(f\"Error reading input from stdin: {e}\")\n            print(f\"Error: Could not read or parse input from stdin: {e}\", file=sys.stderr)\n            return 1\n    else:\n        parser.print_help(sys.stderr)\n        print(\"\\nError: Either --file or --stdin must be provided.\", file=sys.stderr)\n        return 2\n\n    validator = Validator()\n    renderer = TemplateRenderer(config.template)\n    file_storage_adapter = FileStorageAdapter(config.audit_file_path)\n    output_repository = OutputRepository(file_storage_adapter, config.audit_file_path)\n    odd_counter_service = OddCounterService(validator, renderer, output_repository)\n    cli_controller = CliController(odd_counter_service)\n\n    return cli_controller.run(inputs_data)\n\nif __name__ == '__main__':\n    sys.exit(main())\n\n```\n\n```python\n# src/oddcount_app/api.py\nfrom fastapi import FastAPI, Request, HTTPException, Depends, status\nfrom fastapi.responses import JSONResponse\nfrom typing import List, Dict, Optional\nimport logging\n\nfrom oddcount_app.config import AppConfig\nfrom oddcount_app.exceptions import InvalidInputError, PersistenceError\nfrom oddcount_app.utils.validator import Validator\nfrom oddcount_app.utils.template_renderer import TemplateRenderer\nfrom oddcount_app.repositories.adapters.file_storage_adapter import FileStorageAdapter\nfrom oddcount_app.repositories.output_repository import OutputRepository\nfrom oddcount_app.services.odd_counter_service import OddCounterService\nfrom oddcount_app.controllers.api_controller import ApiController\nfrom oddcount_app.models.result_model import ResultModel\n\nlogger = logging.getLogger(__name__)\n\ndef create_app(config: AppConfig) -> FastAPI:\n    \"\"\"FastAPI app factory that wires ApiController and dependencies.\"\"\"\n    app = FastAPI(\n        title=\"OddCount Transformer\",\n        description=\"API to transform digit-only strings based on odd digit counts.\",\n        version=\"1.0.0\"\n    )\n\n    logging.basicConfig(level=config.log_level, format='%(asctime)s - %(name)s - %(levelname)s - %(message)s')\n    \n    validator = Validator()\n    renderer = TemplateRenderer(config.template)\n    file_storage_adapter = FileStorageAdapter(config.audit_file_path)\n    output_repository = OutputRepository(file_storage_adapter, config.audit_file_path)\n    odd_counter_service = OddCounterService(validator, renderer, output_repository)\n    api_controller = ApiController(odd_counter_service, config.api_token)\n\n    def get_api_token(request: Request) -> Optional[str]:\n        \"\"\"Dependency to extract and validate API token from Authorization header.\"\"\"\n        if config.api_token:\n            auth_header = request.headers.get(\"Authorization\")\n            if not auth_header:\n                raise HTTPException(status_code=status.HTTP_401_UNAUTHORIZED, detail=\"Authorization header missing\")\n            \n            parts = auth_header.split()\n            if len(parts) != 2 or parts[0].lower() != \"bearer\":\n                raise HTTPException(status_code=status.HTTP_401_UNAUTHORIZED, detail=\"Invalid Authorization header format. Expected 'Bearer <token>'\")\n            return parts[1]\n        return None\n\n    @app.post(\"/process\", response_model=Dict[str, List[str]])\n    async def process_endpoint(\n        request_body: Dict[str, List[str]],\n        auth_token: Optional[str] = Depends(get_api_token)\n    ) -> JSONResponse:\n        \"\"\"Endpoint to process a list of digit-only strings.\"\"\"\n        inputs = request_body.get(\"inputs\")\n        if inputs is None: # Check explicitly for None, as empty list is valid\n            raise HTTPException(status_code=400, detail=\"'inputs' field is required.\")\n        if not isinstance(inputs, list):\n            raise HTTPException(status_code=400, detail=\"'inputs' field must be a list of strings.\")\n\n        try:\n            result: ResultModel = api_controller.process(inputs, auth_token)\n            return JSONResponse(status_code=200, content=result.to_dict())\n        except HTTPException as e:\n            raise e\n        except Exception as e:\n            logger.exception(\"Unhandled exception in /process endpoint\")\n            raise HTTPException(status_code=500, detail=\"Internal server error\")\n\n    return app\n\napp_config = AppConfig.from_env()\napp = create_app(app_config)\n\n```"}
{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums):\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty sub-array.\n    This uses a variant of Kadane's algorithm to efficiently track the minimum sum.\n    \"\"\"\n    best_sum = nums[0]\n    current_sum = nums[0]\n\n    for i in range(1, len(nums)):\n        x = nums[i]\n        # If current_sum is positive, it means starting a new subarray from 'x'\n        # would yield a smaller or equal sum than extending the current positive sum.\n        if current_sum > 0:\n            current_sum = x\n        else:\n            current_sum += x\n        \n        # Update the overall minimum sum found so far.\n        if current_sum < best_sum:\n            best_sum = current_sum\n            \n    return best_sum"}
{"task_id": "HumanEval/115", "solution": "import math\n\ndef max_fill(grid, capacity):\n    \"\"\"\n    Computes the number of times buckets must be lowered to empty wells.\n    Each row represents a well, and '1's are units of water.\n    \"\"\"\n    total_lowers = 0\n    for row in grid:\n        ones_in_row = sum(row)\n        lowers_for_row = math.ceil(ones_in_row / capacity)\n        total_lowers += lowers_for_row\n    return total_lowers"}
{"task_id": "HumanEval/115", "solution": "import math\n\ndef max_fill(grid, capacity):\n    \"\"\"Computes the minimum bucket lowerings to empty all wells in a grid.\n    Each 1 in a row is water, and each lowering extracts up to `capacity` units from one well.\n    \"\"\"\n    total_lowers = 0\n    for row in grid:\n        water_units_in_row = sum(row)\n        lowers_for_row = math.ceil(water_units_in_row / capacity)\n        total_lowers += lowers_for_row\n    return total_lowers"}
{"task_id": "HumanEval/116", "solution": "```python\ndef sort_array(arr):\n    \"\"\"\n    Sorts integer arrays by the number of 1 bits (ascending), then by numeric value (ascending).\n    Negative numbers are sorted numerically (ascending) and placed before non-negatives.\n    \"\"\"\n    negatives = []\n    non_negatives = []\n\n    for x in arr:\n        if x < 0:\n            negatives.append(x)\n        else:\n            non_negatives.append(x)\n\n    sorted_negatives = sorted(negatives)\n    sorted_non_negatives = sorted(non_negatives, key=lambda x: (x.bit_count(), x))\n\n    return sorted_negatives + sorted_non_negatives\n```"}
{"task_id": "HumanEval/116", "solution": "def sort_array(arr):\n    \"\"\"\n    Sorts an array of integers by number of 1 bits, using decimal value as tie-breaker.\n    If any negative integers are present, it falls back to a simple numeric ascending sort.\n    \"\"\"\n    \n    if any(n < 0 for n in arr):\n        return sorted(arr)\n    else:\n        # Sorts by bit count (ascending), then by decimal value (ascending)\n        return sorted(arr, key=lambda n: (n.bit_count(), n))"}
{"task_id": "HumanEval/117", "solution": "VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\ndef is_vowel(char: str) -> bool:\n    \"\"\"Checks if a character is a vowel (case-insensitive).\"\"\"\n    return char.lower() in VOWELS\n\ndef count_consonants_in_word(word: str) -> int:\n    \"\"\"Counts consonants in a word. Consonants are alphabetic characters that are not vowels.\"\"\"\n    count = 0\n    for char in word:\n        if char.isalpha() and not is_vowel(char):\n            count += 1\n    return count\n\ndef select_words(s, n):\n    \"\"\"Given a string s and an integer n, returns a list of all words from string s that contain exactly\n    n consonants, in order these words appear in the string s.\n    \"\"\"\n    if not s:\n        return []\n\n    result_words = []\n    words = s.split()\n\n    for word in words:\n        if count_consonants_in_word(word) == n:\n            result_words.append(word)\n\n    return result_words"}
{"task_id": "HumanEval/117", "solution": "import re\n\ndef select_words(s, n):\n    \"\"\"Given a string s and a natural number n, returns a list of words from s\n    that contain exactly n consonants, in their original order.\n    \"\"\"\n\n    VOWELS = frozenset({\"a\", \"e\", \"i\", \"o\", \"u\"})\n\n    def _is_consonant(ch: str) -> bool:\n        \"\"\"Determines if a character is a consonant.\"\"\"\n        c = ch.lower()\n        return c.isalpha() and c not in VOWELS\n\n    def _count_consonants(word: str) -> int:\n        \"\"\"Counts consonants in a word, ignoring non-alphabetic characters.\"\"\"\n        return sum(1 for ch in word if _is_consonant(ch))\n\n    def _normalize_word_for_counting(word: str) -> str:\n        \"\"\"Strips non-alphabetic characters from a word.\"\"\"\n        return re.sub(r'[^A-Za-z]', '', word)\n\n    if not s:\n        return []\n\n    normalized_s = re.sub(r'\\s+', ' ', s).strip()\n    words = [t for t in normalized_s.split(\" \") if t]\n    \n    result = []\n    for original_word in words:\n        clean_word = _normalize_word_for_counting(original_word)\n        \n        if not clean_word:\n            continue\n            \n        consonant_count = _count_consonants(clean_word)\n        \n        if consonant_count == n:\n            result.append(original_word)\n            \n    return result"}
{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"Finds the closest vowel between two consonants from the right side of the word.\n    Vowels at the beginning and end of the word do not count.\"\"\"\n\n    VOWELS = \"AEIOUaeiou\"\n\n    def _is_vowel(char: str) -> bool:\n        return char in VOWELS\n\n    # Assumes input contains only English letters as per problem statement.\n    def _is_consonant(char: str) -> bool:\n        return not _is_vowel(char)\n\n    # Iterate from the second-to-last character down to the second character (index 1).\n    for i in range(len(word) - 2, 0, -1):\n        if _is_vowel(word[i]) and _is_consonant(word[i-1]) and _is_consonant(word[i+1]):\n            return word[i]\n    \n    return \"\""}
{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"Finds the closest vowel that stands between two consonants scanning from the right side of the word.\n    Vowels at the beginning or end do not count.\n    \"\"\"\n    VOWELS = {\"a\", \"e\", \"i\", \"o\", \"u\", \"A\", \"E\", \"I\", \"O\", \"U\"}\n    n = len(word)\n\n    if n < 3:\n        return \"\"\n\n    # Scan from right (index n-2) down to left (index 1)\n    for i in range(n - 2, 0, -1):\n        char = word[i]\n        if char in VOWELS:\n            left_neighbor = word[i - 1]\n            right_neighbor = word[i + 1]\n            # Check if both neighbors are consonants\n            if left_neighbor not in VOWELS and right_neighbor not in VOWELS:\n                return char\n    return \"\""}
{"task_id": "HumanEval/119", "solution": "```python\ndef match_parens(lst):\n    \"\"\"\n    Checks if two parentheses strings can form a balanced string by concatenation.\n    Assumes valid input: a list of two strings containing only '(' and ')'.\n    \"\"\"\n\n    def _is_balanced(s: str) -> bool:\n        \"\"\"Determines if a given string of parentheses is balanced.\"\"\"\n        count = 0\n        for char in s:\n            if char == '(':\n                count += 1\n            else:  # char must be ')' based on problem constraints\n                count -= 1\n            if count < 0:\n                return False\n        return count == 0\n\n    s1 = lst[0]\n    s2 = lst[1]\n\n    # Check the first concatenation order: s1 + s2\n    if _is_balanced(s1 + s2):\n        return 'Yes'\n\n    # Check the second concatenation order: s2 + s1\n    if _is_balanced(s2 + s1):\n        return 'Yes'\n\n    # If neither order results in a balanced string\n    return 'No'\n\n```"}
{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    \"\"\"\n    Checks if concatenating two parenthesis strings in some order forms a balanced string.\n    Returns 'Yes' if possible, 'No' otherwise.\n    \"\"\"\n    s1 = lst[0]\n    s2 = lst[1]\n\n    def _compute_metrics(s):\n        balance = 0\n        min_balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            else: # char == ')'\n                balance -= 1\n            min_balance = min(min_balance, balance)\n        return balance, min_balance\n\n    total1, min_prefix1 = _compute_metrics(s1)\n    total2, min_prefix2 = _compute_metrics(s2)\n\n    if total1 + total2 != 0:\n        return 'No'\n\n    # Check order s1 + s2\n    if min_prefix1 >= 0 and (total1 + min_prefix2) >= 0:\n        return 'Yes'\n\n    # Check order s2 + s1\n    if min_prefix2 >= 0 and (total2 + min_prefix1) >= 0:\n        return 'Yes'\n\n    return 'No'"}
