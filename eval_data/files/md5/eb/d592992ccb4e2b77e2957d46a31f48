{"task_id": "HumanEval/96", "solution": "from collections import OrderedDict\nfrom typing import List, Optional\n\n# Configuration constants as per design specification.\nDEFAULT_MAX_SIEVE = 10_000_000\nCACHE_MAX_ENTRIES = 128\n\nclass PrimeCalculator:\n    \"\"\"Implements primality checks and the Sieve of Eratosthenes algorithm.\n    It computes all primes up to a given limit.\n    \"\"\"\n    def __init__(self, _max_sieve: int = DEFAULT_MAX_SIEVE):\n        self._max_sieve = _max_sieve\n\n    def _sieve_bool_array(self, n: int) -> List[bool]:\n        \"\"\"Internal helper to produce a boolean sieve array for 0..n-1.\n        This method assumes n is at least 3.\n        \"\"\"\n        is_prime_flags = [True] * n\n        is_prime_flags[0] = False # 0 is not prime\n        is_prime_flags[1] = False # 1 is not prime\n        \n        p = 2\n        while p * p < n:\n            if is_prime_flags[p]:\n                for multiple in range(p * p, n, p):\n                    is_prime_flags[multiple] = False\n            p += 1\n        return is_prime_flags\n\n    def sieve(self, n: int) -> List[int]:\n        \"\"\"Returns all primes p where 2 <= p < n using the Sieve of Eratosthenes.\n        Raises ValueError if n exceeds the configured maximum sieve limit.\n        \"\"\"\n        if n <= 2:\n            return []\n        if n > self._max_sieve:\n            raise ValueError(f\"n too large for configured max {self._max_sieve}\")\n        \n        is_prime_flags = self._sieve_bool_array(n)\n        return [i for i, is_prime in enumerate(is_prime_flags) if is_prime]\n\nclass PrimeCacheRepository:\n    \"\"\"An in-memory LRU cache for storing lists of prime numbers.\n    It limits the number of stored entries using an LRU eviction policy.\n    \"\"\"\n    def __init__(self, _max_entries: int = CACHE_MAX_ENTRIES):\n        self._cache: OrderedDict[int, List[int]] = OrderedDict()\n        self._max_entries = _max_entries\n\n    def get(self, n: int) -> Optional[List[int]]:\n        \"\"\"Retrieves a cached list of primes for a given 'n', if available.\n        Moves the accessed entry to the end to mark it as most recently used.\n        \"\"\"\n        if n in self._cache:\n            self._cache.move_to_end(n)\n            return self._cache[n]\n        return None\n\n    def set(self, n: int, primes: List[int]) -> None:\n        \"\"\"Stores a list of primes for 'n' in the cache.\n        Evicts the least recently used entry if the cache size exceeds its maximum.\n        \"\"\"\n        self._cache[n] = primes\n        self._cache.move_to_end(n)\n        if len(self._cache) > self._max_entries:\n            self._cache.popitem(last=False) # Evict oldest\n\n\nclass PrimeService:\n    \"\"\"Orchestrates prime number computation, leveraging a calculator and an optional cache.\n    It retrieves prime lists by checking the cache first, then computing if necessary.\n    \"\"\"\n    def __init__(self, calculator: PrimeCalculator, repository: Optional[PrimeCacheRepository] = None):\n        self._calculator = calculator\n        self._repository = repository\n\n    def get_primes_below(self, n: int) -> List[int]:\n        \"\"\"Returns all primes strictly less than 'n'.\n        It uses the repository for caching and the calculator for actual computation.\n        \"\"\"\n        # Input 'n' is trusted to be a non-negative integer as per forbidden rules.\n        if self._repository:\n            cached_primes = self._repository.get(n)\n            if cached_primes is not None:\n                return cached_primes\n        \n        primes = self._calculator.sieve(n)\n        \n        if self._repository:\n            self._repository.set(n, primes)\n            \n        return primes\n\n\nclass PrimeController:\n    \"\"\"Manages the overall flow for prime number requests.\n    It serves as an entry point, delegating the core logic to the PrimeService.\n    \"\"\"\n    def __init__(self, service: PrimeService):\n        self._service = service\n\n    def count_up_to(self, n: int) -> List[int]:\n        \"\"\"Delegates prime number computation to the service layer.\n        It assumes 'n' is a valid non-negative integer.\n        \"\"\"\n        return self._service.get_primes_below(n)\n\n# Instantiate the core components globally as per the design's __init__.py example.\n_default_calculator = PrimeCalculator(_max_sieve=DEFAULT_MAX_SIEVE)\n_default_repo = PrimeCacheRepository(_max_entries=CACHE_MAX_ENTRIES)\n_default_service = PrimeService(_default_calculator, _default_repo)\n_controller = PrimeController(_default_service)\n\ndef count_up_to(n):\n    \"\"\"Implement a function that takes a non-negative integer and returns an array of the first n\n    integers that are prime numbers and less than n.\n    \"\"\"\n    # The input 'n' is trusted to be a non-negative integer, without additional validation.\n    return _controller.count_up_to(n)"}
