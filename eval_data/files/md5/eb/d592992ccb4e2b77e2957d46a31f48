f http_exception_handler(request: Request, exc: HTTPException):\n                \"\"\"Custom handler for HTTP exceptions to ensure consistent error format.\"\"\"\n                return JSONResponse(\n                    status_code=exc.status_code,\n                    content={\"detail\": exc.detail}\n                )\n\n            return app\n    \n    # Create an instance of APIController and initialize its service here for the factory pattern.\n    _api_repo_instance = ResultRepository(settings.persistence_path) if settings.enable_persistence else None\n    _api_service_instance = EvenOddService(repo=_api_repo_instance)\n    _api_controller_instance = APIController(_api_service_instance)\n\n    # get_app is a factory function for uvicorn.\n    def get_app() -> FastAPI:\n        \"\"\"Factory function to provide the FastAPI application.\"\"\"\n        return _api_controller_instance.get_app()\n\nexcept ImportError:\n    # If FastAPI/Pydantic are not installed, APIController will not be available.\n    class APIController:\n        def __init__(self, service: EvenOddService):\n            self.service = service\n        def get_app(self):\n            raise NotImplementedError(\"FastAPI and Uvicorn are not installed. Install with 'pip install \\\"evenodd-counter[api]\\\"'.\")\n    \n    # Provide a placeholder get_app that raises an error if called.\n    def get_app():\n        raise NotImplementedError(\"FastAPI and Uvicorn are not installed. Install with 'pip install \\\"evenodd-counter[api]\\\"'.\")\n\n```\n```python\n# src/evenodd/cli.py\nimport sys\nimport logging\nimport os\n\nfrom evenodd.services import EvenOddService\nfrom evenodd.repositories import ResultRepository\nfrom evenodd.controllers import CLIController\n\n# Configure basic logging for internal errors.\nlogging.basicConfig(level=os.environ.get(\"EVENODD_LOGLEVEL\", \"INFO\").upper(),\n                    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s')\nlogger = logging.getLogg