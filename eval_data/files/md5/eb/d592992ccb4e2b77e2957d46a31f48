```python\n# src/even_at_odd/even_odd_service.py\n\"\"\"Core algorithm that computes the sum of even elements at odd indices.\"\"\"\n\nclass EvenOddService:\n    \"\"\"\n    Service responsible for the core computation:\n    summing even elements located at odd indices in a list of integers.\n    \"\"\"\n    def __init__(self) -> None:\n        \"\"\"Initializes the EvenOddService. This service is stateless.\"\"\"\n        pass\n\n    def compute(self, numbers: list[int]) -> int:\n        \"\"\"\n        Computes the sum of even elements that are located at odd indices.\n\n        Args:\n            numbers: A non-empty list of integers. Assumed to be validated.\n\n        Returns:\n            The sum of even elements at odd indices.\n        \"\"\"\n        total = 0\n        for idx, val in enumerate(numbers):\n            if idx % 2 == 1 and val % 2 == 0:\n                total += val\n        return total\n\n```\n\n```python\n# src/even_at_odd/utils.py\n\"\"\"Helper functions for parsing input.\"\"\"\nfrom typing import List\n\ndef parse_int_list_str(s: str) -> List[int]:\n    \"\"\"\n    Parses a string containing space or comma-separated integers into a list of integers.\n\n    Args:\n        s: The input string.\n\n    Returns:\n        A list of integers.\n\n    Raises:\n        ValueError: If any part of the string cannot be converted to an integer.\n    \"\"\"\n    if not s:\n        return []\n    \n    # Replace commas with spaces to handle both types of separators\n    cleaned_s = s.replace(',', ' ').strip()\n    if not cleaned_s:\n        return []\n\n    str_numbers = cleaned_s.split()\n    return [int(num_str) for num_str in str_numbers]\n\n```\n\n```python\n# src/even_at_odd/validator.py\n\"\"\"Validates and normalizes various forms of input into a list of integers.\"\"\"\nfrom typing import Any, List\nfrom .validation_error import ValidationError\nfrom .utils import parse_int_list_str\n\nclass Validator:\n    \"\"\"\n    Validates input to ensure it is a non-empty list of integers.\n    Also handles parsing string inputs.\n    \"\"\"\n    MAX_LIST_LENGTH: int = 10_000_000\n\n    def __init__(self) -> None:\n        \"\"\"Initializes the Validator.\"\"\"\n        pass\n\n    def validate_numbers(self, numbers: Any) -> List[int]:\n        \"\"\"\n        Validates and normalizes the input into a list of integers.\n\n        Accepts:\n            - A list of integers.\n            - A string that can be parsed into a list of integers (e.g., \"1 2 3\" or \"1,2,3\").\n\n        Args:\n            numbers: The raw input, expected to be a list or a string.\n\n        Returns:\n            A validated list of integers.\n\n        Raises:\n            ValidationError: If the input is invalid (e.g., empty, wrong type, contains non-integers, too large).\n        \"\"\"\n        if isinstance(numbers, str):\n            try:\n                nums = parse_int_list_str(numbers)\n            except ValueError as e:\n                raise ValidationError(f\"Invalid number format in string input: {e}\")\n        elif isinstance(numbers, list):\n            nums = numbers\n        else:\n            raise ValidationError(\"Input must be a list of integers or an integer list string.\")\n\n        if not nums:\n            raise ValidationError(\"Input list must be non-empty.\")\n\n        if len(nums) > self.MAX_LIST_LENGTH:\n            raise ValidationError(f\"Input list too large. Maximum allowed length is {self.MAX_LIST_LENGTH}.\")\n\n        for i, n in enumerate(nums):\n            if not isinstance(n, int):\n                # Attempt conversion for common cases like float 1.0 -> int 1\n                if isinstance(n, float) and n.is_integer():\n                    nums[i] = int(n)\n                else:\n                    raise ValidationError(f\"All items in the list must be integers. Found non-integer at index {i}: {n}.\")\n        \n        return nums\n\n```\n\n```python\n# src/even_at_odd/metrics_repository.py\n\"\"\"In-memory storage for basic metrics.\"\"\"\nfrom typing import Dict, Optional, Any\n\nclass MetricsRepository:\n    \"\"\"\n    Provides an in-memory repository for storing basic application metrics.\n    Currently tracks invocation count and the last computed result.\n    Note: This basic implementation is not thread-safe.\n    \"\"\"\n    def __init__(self) -> None:\n        \"\"\"Initializes the metrics repository with default values.\"\"\"\n        self._invocation_count: int = 0\n        self._last_result: Optional[int] = None\n\n    def increment(self) -> None:\n        \"\"\"Increments the invocation count.\"\"\"\n        self._invocation_count += 1\n\n    def set_last(self, result: int) -> None:\n        \"\"\"Sets the last computed result.\"\"\"\n        self._last_result = result\n\n    def get_metrics(self) -> Dict[str, Any]:\n        \"\"\"\n        Retrieves the current metrics.\n\n        Returns:\n            A dictionary containing 'invocation_count' and 'last_result'.\n        \"\"\"\n        return {\n            \"invocation_count\": self._invocation_count,\n            \"last_result\": self._last_result\n        }\n\n```\n\n```python\n# src/even_at_odd/config.py\n\"\"\"Holds application configuration values.\"\"\"\nfrom typing import Optional\n\nclass Config:\n    \"\"\"\n    Configuration class for the application, including API key, host, and port settings.\n    \"\"\"\n    DEFAULT_HOST: str = \"127.0.0.1\"\n    DEFAULT_PORT: int = 8000\n\n    def __init__(\n        self,\n        api_key: Optional[str] = None,\n        host: str = DEFAULT_HOST,\n        port: int = DEFAULT_PORT\n    ) -> None:\n        \"\"\"\n        Initializes the configuration.\n\n        Args:\n            api_key: Optional API key for HTTP authentication.\n            host: The host address for the HTTP API.\n            port: The port number for the HTTP API.\n        \"\"\"\n        self.api_key = api_key\n        self.host = host\n        self.port = port\n\n```\n\n```python\n# src/even_at_odd/controller.py\n\"\"\"Orchestrates flow: validate -> compute -> update metrics -> return result/DTO.\"\"\"\nimport logging\nfrom typing import Any, Dict\nfrom .even_odd_service import EvenOddService\nfrom .validator import Validator\nfrom .metrics_repository import MetricsRepository\nfrom .validation_error import ValidationError\n\nlogger = logging.getLogger(__name__)\n\nclass Controller:\n    \"\"\"\n    The Controller orchestrates the main application flow.\n    It takes raw input, validates it, calls the core service for computation,\n    updates metrics, and prepares the result.\n    \"\"\"\n    def __init__(\n        self,\n        service: EvenOddService,\n        validator: Validator,\n        metrics_repo: MetricsRepository\n    ) -> None:\n        \"\"\"\n        Initializes the Controller with its dependencies.\n\n        Args:\n            service: The core EvenOddService for computation.\n            validator: The Validator for input validation.\n            metrics_repo: The MetricsRepository for storing metrics.\n        \"\"\"\n        self._service = service\n        self._validator = validator\n        self._metrics_repo = metrics_repo\n\n    def compute(self, numbers: Any) -> int:\n        \"\"\"\n        Performs the full computation process: validation, core computation, and metrics update.\n\n        Args:\n            numbers: The raw input representing a list of integers (can be list or string).\n\n        Returns:\n            The sum of even elements at odd indices.\n\n        Raises:\n            ValidationError: If the input fails validation.\n        \"\"\"\n        validated_numbers = self._validator.validate_numbers(numbers)\n        result = self._service.compute(validated_numbers)\n        try:\n            self._metrics_repo.increment()\n            self._metrics_repo.set_last(result)\n        except Exception as e:\n            # Log and ignore metrics failures to prevent blocking core functionality\n            logger.error(f\"Failed to update metrics: {e}\")\n        return result\n\n    def get_metrics(self) -> Dict[str, Any]:\n        \"\"\"\n        Retrieves the current metrics from the metrics repository.\n\n        Returns:\n            A dictionary containing 'invocation_count' and 'last_result'.\n        \"\"\"\n        return self._metrics_repo.get_metrics()\n\n```\n\n```python\n# src/even_at_odd/cli.py\n\"\"\"CLI entrypoint for compute operation.\"\"\"\nimport sys\nimport argparse\nimport json\nfrom typing import List, Any\nfrom .controller import Controller\nfrom .validation_error import ValidationError\nfrom .utils import parse_int_list_str\n\nclass CLI:\n    \"\"\"\n    Command Line Interface for the Even at Odd service.\n    Provides a 'compute' command to get the sum.\n    \"\"\"\n    CLI_NAME: str = \"even-at-odd\"\n\n    def __init__(self, controller: Controller) -> None:\n        \"\"\"\n        Initializes the CLI with a controller.\n\n        Args:\n            controller: The application controller to delegate computation to.\n        \"\"\"\n        self._controller = controller\n\n    def _parse_cli_args(self, argv: List[str]) -> argparse.Namespace:\n        \"\"\"Parses command-line arguments.\"\"\"\n        parser = argparse.ArgumentParser(\n            prog=self.CLI_NAME,\n            description=\"Computes the sum of even elements at odd indices.\"\n        )\n        subparsers = parser.add_subparsers(dest=\"command\", required=True)\n\n        compute_parser = subparsers.add_parser(\n            \"compute\",\n            help=\"Compute the sum for a list of integers.\"\n        )\n        compute_parser.add_argument(\n            \"numbers\",\n            nargs=\"*\",\n            help=\"Space-separated integers, or a JSON list string. If empty, reads from STDIN.\"\n        )\n        return parser.parse_args(argv[1:])\n\n    def parse_input(self, args_numbers: List[str]) -> List[int]:\n        \"\"\"\n        Parses input from command-line arguments or STDIN.\n\n        Args:\n            args_numbers: List of strings from CLI arguments representing numbers.\n\n        Returns:\n            A list of integers.\n\n        Raises:\n            ValidationError: If input cannot be parsed or is invalid.\n        \"\"\"\n        if args_numbers:\n            # Try to parse as JSON first (single arg)\n            if len(args_numbers) == 1 and (args_numbers[0].startswith('[') or args_numbers[0].startswith('{')):\n                try:\n                    data = json.loads(args_numbers[0])\n                    if isinstance(data, list):\n                        return data\n                    else:\n                        raise ValidationError(\"JSON input must be an array of numbers.\")\n                except json.JSONDecodeError as e:\n                    # If it's not valid JSON, try parsing as space-separated string\n                    pass # Fall through to space-separated parsing\n            \n            # If not JSON, or JSON failed, treat as space-separated\n            try:\n                return parse_int_list_str(\" \".join(args_numbers))\n            except ValueError as e:\n                raise ValidationError(f\"Invalid number format in CLI arguments: {e}\")\n        else:\n            # Read from stdin\n            try:\n                stdin_input = sys.stdin.read().strip()\n                if not stdin_input:\n                    raise ValidationError(\"No input provided via STDIN.\")\n                \n                # Try parsing STDIN as JSON\n                if stdin_input.startswith('[') or stdin_input.startswith('{'):\n                    try:\n                        data = json.loads(stdin_input)\n                        if isinstance(data, list):\n                            return data\n                        else:\n                            raise ValidationError(\"JSON input from STDIN must be an array of numbers.\")\n                    except json.JSONDecodeError:\n                        # Fall through to space-separated if not valid JSON\n                        pass\n                \n                # If not JSON, or JSON failed, treat as space-separated\n                return parse_int_list_str(stdin_input)\n            except ValueError as e:\n                raise ValidationError(f\"Invalid number format in STDIN input: {e}\")\n\n\n    def run(self, argv: List[str]) -> int:\n        \"\"\"\n        Runs the CLI command.\n\n        Args:\n            argv: List of command-line arguments (sys.argv).\n\n        Returns:\n            An exit code (0 for success, non-zero for error).\n        \"\"\"\n        args = self._parse_cli_args(argv)\n\n        if args.command == \"compute\":\n            try:\n                nums = self.parse_input(args.numbers)\n                result = self._controller.compute(nums)\n                print(result)\n                return 0\n            except ValidationError as e:\n                print(f\"Error: Invalid input - {e.message}\", file=sys.stderr)\n                return 1\n            except Exception as e:\n                print(f\"Error: An unexpected error occurred - {e}\", file=sys.stderr)\n                return 2\n        \n        return 1 # Should not be reached if command is required\n\n```\n\n```python\n# src/even_at_odd/api.py\n\"\"\"FastAPI wrapper exposing POST /compute and GET /metrics.\"\"\"\nimport uvicorn\nfrom fastapi import FastAPI, HTTPException, Header, Depends, status\nfrom fastapi.security import APIKeyHeader\nfrom typing import Optional, Any, Dict\nfrom .controller import Controller\nfrom .config import Config\nfrom .input_dto import InputDTO\nfrom .result_dto import ResultDTO\nfrom .validation_error import ValidationError\n\n# Define API key header for FastAPI security\napi_key_header = APIKeyHeader(name=\"X-API-KEY\", auto_error=False)\n\nclass API:\n    \"\"\"\n    Provides an HTTP API using FastAPI to expose the computation and metrics.\n    \"\"\"\n    ROUTE_COMPUTE = \"/compute\"\n    ROUTE_METRICS = \"/metrics\"\n\n    def __init__(self, controller: Controller, config: Config) -> None:\n        \"\"\"\n        Initializes the API with a controller and configuration.\n\n        Args:\n            controller: The application controller.\n            config: Application configuration, including optional API key.\n        \"\"\"\n        self._controller = controller\n        self._config = config\n\n    async def _verify_api_key(self, x_api_key: Optional[str] = Depends(api_key_header)) -> None:\n        \"\"\"\n        Dependency function to verify the API key if configured.\n        \"\"\"\n        if self._config.api_key:  # If an API key is configured\n            if not x_api_key or x_api_key != self._config.api_key:\n                raise HTTPException(\n                    status_code=status.HTTP_401_UNAUTHORIZED,\n                    detail=\"Unauthorized: Missing or invalid API key.\"\n                )\n\n    def create_app(self) -> FastAPI:\n        \"\"\"\n        Creates and configures the FastAPI application instance.\n\n        Returns:\n            A configured FastAPI application.\n        \"\"\"\n        app = FastAPI(\n            title=\"Even At Odd Sum Service\",\n            description=\"API to compute the sum of even elements at odd indices.\",\n            version=\"1.0.0\",\n        )\n\n        @app.post(\n            self.ROUTE_COMPUTE,\n            response_model=ResultDTO,\n            status_code=status.HTTP_200_OK,\n            summary=\"Compute sum of even elements at odd indices\"\n        )\n        async def compute_endpoint(\n            payload: InputDTO,\n            _: None = Depends(self._verify_api_key) # Apply API key authentication\n        ) -> ResultDTO:\n            \"\"\"\n            Accepts a list of integers and returns the sum of even elements\n            located at odd indices.\n            \"\"\"\n            try:\n                result = self._controlle