{"task_id": "HumanEval/24", "solution": "def largest_divisor(n: int) -> int:\n    \"\"\"Finds the largest proper divisor of n.\n    Returns 0 for n <= 1, and the positive largest proper divisor for negative n.\"\"\"\n    \n    # Handle base cases as per BR1: For n <= 1, return 0.\n    if n <= 1:\n        return 0\n\n    # Handle negative numbers as per BR2: compute for |n|.\n    num = abs(n)\n\n    # Optimized search for largest proper divisor (NFR2).\n    # For even numbers, num // 2 is always the largest proper divisor.\n    if num % 2 == 0:\n        return num // 2\n\n    # For odd numbers, we only need to check odd factors up to sqrt(num).\n    root = int(num**0.5)\n    # Ensure we start checking from an odd number if root is even.\n    if root % 2 == 0:\n        root -= 1\n    \n    # Iterate downwards from root, checking only odd numbers.\n    for i in range(root, 1, -2):\n        if num % i == 0:\n            # If i is a factor, then num // i is also a factor.\n            # Since i is the largest factor <= sqrt(num), num // i is the smallest factor >= sqrt(num).\n            # Thus, num // i is the largest proper divisor.\n            return num // i\n            \n    # If no factors are found (other than 1), the number must be prime.\n    # The largest proper divisor for a prime number greater than 1 is 1.\n    return 1"}
{"task_id": "HumanEval/24", "solution": "def largest_divisor(n: int) -> int:\n    \"\"\" For a given number n, find the largest number that divides n evenly, smaller than n\n    >>> largest_divisor(15)\n    5\n    \"\"\"\n    # Iterate from 2, checking for divisors up to the square root of n.\n    # The first divisor 'd' found will yield 'n // d' as the largest proper divisor.\n    d = 2\n    while d * d <= n:\n        if n % d == 0:\n            return n // d\n        d += 1\n    # If no such divisor 'd' is found, n is prime, so 1 is the largest proper divisor.\n    return 1"}
{"task_id": "HumanEval/25", "solution": "```python\nfrom typing import List\n\n\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in ascending order with multiplicities.\n    Handles n=1 and non-positive n by returning an empty list, as per design decisions.\n    \"\"\"\n    if n <= 1:\n        return []\n\n    factors = []\n    d = 2\n    temp_n = n\n\n    while d * d <= temp_n:\n        while temp_n % d == 0:\n            factors.append(d)\n            temp_n //= d\n        d += 1\n\n    if temp_n > 1:\n        factors.append(temp_n)\n\n    return factors\n```"}
{"task_id": "HumanEval/25", "solution": "```python\nfrom typing import List\n\n\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    \"\"\"\n    num = abs(n)\n    if num <= 1:\n        return []\n\n    factors = []\n    # Calculate the limit for trial division and sieve, up to the square root of the number\n    limit = int(num**0.5)\n\n    # Inline Sieve of Eratosthenes to generate primes up to the limit\n    # Initialize a boolean list where sieve[i] is True if i is potentially prime\n    sieve = [True] * (limit + 1)\n    if limit >= 0:\n        sieve[0] = False  # 0 is not prime\n    if limit >= 1:\n        sieve[1] = False  # 1 is not prime\n    \n    # Iterate from 2 up to the square root of the limit\n    for p in range(2, int(limit**0.5) + 1):\n        if sieve[p]:\n            # Mark multiples of p as not prime\n            for multiple in range(p*p, limit + 1, p):\n                sieve[multiple] = False\n    \n    # Extract the prime numbers found by the sieve\n    primes = [p for p, is_p in enumerate(sieve) if is_p]\n\n    # Perform trial division using the generated primes\n    for p in primes:\n        while num % p == 0:\n            factors.append(p)\n            num //= p\n        # Optimization: if num becomes 1, all factors have been found\n        if num == 1:\n            break\n\n    # If num is still greater than 1, it means the remaining num itself is a prime factor\n    if num > 1:\n        factors.append(num)\n\n    return factors\n```"}
{"task_id": "HumanEval/26", "solution": "from typing import List\n\n\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\"From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    \"\"\"\n    frequency = {}\n    for num in numbers:\n        frequency[num] = frequency.get(num, 0) + 1\n\n    result = []\n    for num in numbers:\n        if frequency[num] == 1:\n            result.append(num)\n            \n    return result"}
{"task_id": "HumanEval/26", "solution": "```python\nfrom typing import List\n\n\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\"From a list of integers, remove all elements that occur more than once.\n    Keep the order of elements the same as in the input for retained items.\n    \"\"\"\n    counts = {}\n    for n in numbers:\n        counts[n] = counts.get(n, 0) + 1\n\n    result = [n for n in numbers if counts[n] == 1]\n    return result\n```"}
