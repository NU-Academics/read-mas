{"task_id": "HumanEval/5", "solution": "def intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    n = len(numbers)\n    if n <= 1:\n        return list(numbers) # Return a shallow copy for single or empty lists\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < n - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/7", "solution": "def filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    return [s for s in strings if substring in s]"}
{"task_id": "HumanEval/6", "solution": "class ParenthesisParseError(Exception):\n    \"\"\"Exception raised for errors in parenthesis parsing.\"\"\"\n    def __init__(self, message: str, group_index: int | None = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.group_index = group_index\n\nclass Tokenizer:\n    \"\"\"Handles splitting input text into individual parenthesis groups.\"\"\"\n    def tokenize(self, text: str) -> List[str]:\n        \"\"\"Splits a string by whitespace into a list of non-empty groups.\"\"\"\n        if not text or text.strip() == \"\":\n            return []\n        return [g for g in text.split() if g != \"\"]\n\nclass ParenthesesParser:\n    \"\"\"Core logic to compute the deepest nesting level of parentheses.\"\"\"\n    def __init__(self, tokenizer: Tokenizer | None = None) -> None:\n        self.tokenizer = tokenizer or Tokenizer()\n\n    def parse(self, text: str) -> List[int]:\n        \"\"\"Parses multiple parenthesis groups and returns the deepest nesting level for each.\"\"\"\n        groups = self.tokenizer.tokenize(text)\n        results: List[int] = []\n        for i, g in enumerate(groups):\n            try:\n                results.append(self.parse_group(g))\n            except ParenthesisParseError as e:\n                raise ParenthesisParseError(str(e), group_index=i) from e\n        return results\n\n    def parse_group(self, group: str) -> int:\n        \"\"\"Calculates the deepest nesting level for a single parenthesis group string.\"\"\"\n        depth = 0\n        max_depth = 0\n        for ch in group:\n            if ch == \"(\":\n                depth += 1\n                if depth > max_depth:\n                    max_depth = depth\n            elif ch == \")\":\n                depth -= 1\n                if depth < 0:\n                    raise ParenthesisParseError(\"Unbalanced: extra ')'\")\n            else:\n                raise ParenthesisParseError(f\"Invalid character '{ch}'\")\n        if depth != 0:\n            raise ParenthesisParseError(\"Unbalanced: missing ')'\")\n        return max_depth\n\n# Instantiate a default parser for the public API function.\n_default_parser = ParenthesesParser()\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n    \"\"\"\n    return _default_parser.parse(paren_string)"}
{"task_id": "HumanEval/1", "solution": "def separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    # Normalize the input string by removing all whitespace characters.\n    normalized = \"\".join(char for char in paren_string if char not in ' \\t\\n\\r\\f\\v')\n\n    if not normalized:\n        return []\n\n    groups = []\n    depth = 0\n    current_group_start_index = 0\n\n    for i, char in enumerate(normalized):\n        if char == '(':\n            if depth == 0:\n                # Mark the beginning of a new top-level group\n                current_group_start_index = i\n            depth += 1\n        elif char == ')':\n            depth -= 1\n            if depth == 0:\n                # The current top-level group has closed\n                groups.append(normalized[current_group_start_index : i + 1])\n    return groups"}
{"task_id": "HumanEval/4", "solution": "def mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    n = len(numbers)\n    # Based on design context preconditions, n is assumed to be > 0.\n    # The 'Do NOT add ... raise exceptions for edge cases' constraint means\n    # we proceed assuming valid input (non-empty list of floats).\n    mean = sum(numbers) / n\n    sum_abs_diff = sum(abs(x - mean) for x in numbers)\n    return sum_abs_diff / n"}
{"task_id": "HumanEval/3", "solution": "def below_zero(operations: List[int]) -> bool:\n    \"\"\"Detects if a bank account balance, starting at zero, ever falls below zero given a list of operations.\n    Returns True if the balance falls below zero at any point, False otherwise.\n    \"\"\"\n    balance = 0\n    for operation in operations:\n        balance += operation\n        if balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/0", "solution": "def has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    # EPSILON is used to handle floating-point precision issues in comparisons.\n    # It ensures strict less-than behavior as required by the design.\n    EPSILON = 1e-12\n\n    n = len(numbers)\n    if n < 2:\n        return False\n\n    # Sort the numbers as the first step of the algorithm for efficiency.\n    # This uses Python's Timsort, which is stable and efficient (O(N log N)).\n    sorted_numbers = sorted(numbers)\n\n    # Iterate through adjacent elements to find if any pair is closer than the threshold.\n    # The comparison includes EPSILON for robust float handling.\n    for i in range(1, n):\n        a, b = sorted_numbers[i - 1], sorted_numbers[i]\n        if (b - a) < (threshold - EPSILON):\n            return True\n\n    return False"}
{"task_id": "HumanEval/2", "solution": "import math\n\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    # Calculate the largest integer smaller than or equal to the number.\n    integer_part = math.floor(number)\n    \n    # Compute the raw decimal part.\n    decimal_part = number - integer_part\n    \n    # Round the decimal part to 12 decimal places, as specified by the design's default precision.\n    rounded_decimal = round(decimal_part, 12)\n    \n    # Ensure the result is non-negative, handling potential -0.0 artifacts or\n    # very small negative values due to floating point arithmetic for exact integers.\n    normalized_decimal = max(0.0, rounded_decimal)\n    \n    # The design explicitly requires the decimal part to be strictly less than 1.\n    # If rounding caused the value to become 1.0 (e.g., from 0.999... due to rounding up),\n    # it implies the number was effectively an integer in context of the specified precision.\n    # In such cases, the decimal part should be 0.0 to adhere to the [0, 1) range.\n    if normalized_decimal >= 1.0:\n        return 0.0\n        \n    return normalized_decimal"}
{"task_id": "HumanEval/8", "solution": "def sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    \"\"\"\n    total_sum = 0\n    total_product = 1\n\n    for number in numbers:\n        total_sum += number\n        total_product *= number\n\n    return (total_sum, total_product)"}
{"task_id": "HumanEval/12", "solution": "def longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    \"\"\"\n    if not strings:\n        return None\n\n    max_idx = 0\n    max_len = len(strings[0])\n\n    for idx, s in enumerate(strings):\n        if len(s) > max_len:\n            max_len = len(s)\n            max_idx = idx\n    \n    return strings[max_idx]"}
{"task_id": "HumanEval/9", "solution": "def rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result: List[int] = []\n    current_max = numbers[0]\n    result.append(current_max)\n\n    for x in numbers[1:]:\n        if x > current_max:\n            current_max = x\n        result.append(current_max)\n    return result"}
{"task_id": "HumanEval/11", "solution": "from typing import List, Optional, Tuple\n\n\nclass InvalidBitStringError(ValueError):\n    \"\"\"Raised when a bit-string fails validation.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\n\nclass BitValidator:\n    \"\"\"Provides static methods to validate and sanitize bit-strings.\"\"\"\n    VALID_CHARS = {'0', '1'}\n\n    @staticmethod\n    def sanitize(bitstr: str) -> str:\n        \"\"\"Strips whitespace from the bit-string.\"\"\"\n        return bitstr.strip()\n\n    @staticmethod\n    def is_valid(bitstr: str) -> bool:\n        \"\"\"Checks if the string is non-empty and contains only '0' or '1'.\"\"\"\n        return bool(bitstr) and all(ch in BitValidator.VALID_CHARS for ch in bitstr)\n\n    @staticmethod\n    def ensure_valid(bitstr: str) -> None:\n        \"\"\"Sanitizes the bit-string and raises an error if it's invalid.\"\"\"\n        s = BitValidator.sanitize(bitstr)\n        if not BitValidator.is_valid(s):\n            raise InvalidBitStringError(f\"Invalid bit-string: {bitstr!r}\")\n\n\nclass BitString:\n    \"\"\"Encapsulates a validated bit-string and provides bitwise operations.\"\"\"\n    def __init__(self, value: str) -> None:\n        \"\"\"Initializes a BitString instance with a validated string.\"\"\"\n        s = BitValidator.sanitize(value)\n        if not BitValidator.is_valid(s):\n            raise InvalidBitStringError(\"Invalid bit-string\")\n        self.value: str = s\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the bit-string.\"\"\"\n        return len(self.value)\n\n    def pad_left(self, target_length: int) -> \"BitString\":\n        \"\"\"Returns a new BitString padded on the left with '0' to match the target length.\"\"\"\n        if target_length <= self.length():\n            return BitString(self.value)\n        padded = self.value.rjust(target_length, '0')\n        return BitString(padded)\n\n    def xor(self, other: \"BitString\") -> \"BitString\":\n        \"\"\"Performs a bitwise XOR operation with another BitString of the same length.\"\"\"\n        if self.length() != other.length():\n            raise ValueError(\"Lengths must match for xor\")\n        res = ''.join('1' if a != b else '0' for a, b in zip(self.value, other.value))\n        return BitString(res)\n\n    def as_str(self) -> str:\n        \"\"\"Returns the raw string value of the BitString.\"\"\"\n        return self.value\n\n\nclass BitwiseService:\n    \"\"\"Provides core business logic for bitwise operations.\"\"\"\n    def __init__(self, repo: Optional[object] = None) -> None:\n        \"\"\"Initializes the service, optionally with a repository for persistence.\"\"\"\n        self._repo = repo\n\n    def _prepare(self, a: str, b: str) -> Tuple[BitString, BitString]:\n        \"\"\"Internal helper to validate, sanitize, and pad bit-strings to equal length.\"\"\"\n        BitValidator.ensure_valid(a)\n        BitValidator.ensure_valid(b)\n        ba = BitString(a)\n        bb = BitString(b)\n        target = max(ba.length(), bb.length())\n        return ba.pad_left(target), bb.pad_left(target)\n\n    def xor(self, a: str, b: str, persist: bool = True) -> str:\n        \"\"\"Computes the bitwise XOR of two bit-strings.\n        It handles validation, padding, XOR calculation, and optional persistence.\"\"\"\n        ba, bb = self._prepare(a, b)\n        res = ba.xor(bb).as_str()\n        if persist and self._repo:\n            # Persistence logic is skipped as string_xor calls with persist=False\n            pass\n        return res\n\n\n_default_service = BitwiseService(repo=None)\n\n\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    return _default_service.xor(a, b, persist=False)"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    return string == string[::-1]\n\n\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    def _prefix_function(s: str) -> list[int]:\n        \"\"\"Compute the KMP prefix-function (pi array) for a string.\"\"\"\n        n = len(s)\n        pi = [0] * n\n        for i in range(1, n):\n            j = pi[i-1]\n            while j > 0 and s[i] != s[j]:\n                j = pi[j-1]\n            if s[i] == s[j]:\n                j += 1\n            pi[i] = j\n        return pi\n\n    def _reverse_str(s: str) -> str:\n        \"\"\"Return the reverse of a string.\"\"\"\n        return s[::-1]\n\n    if not string:\n        return \"\"\n\n    # Reverse the input string\n    rev_s = _reverse_str(string)\n\n    # Concatenate the reversed string, a unique separator, and the original string\n    # This pattern allows us to find the longest palindromic suffix using KMP's prefix function.\n    # The longest prefix of (rev_s) that is also a suffix of (string) is the longest palindromic suffix.\n    concat_str = rev_s + \"#\" + string\n\n    # Compute the KMP prefix function (pi array) for the concatenated string\n    pi_array = _prefix_function(concat_str)\n\n    # The last value in the pi array for `concat_str` gives the length of the longest\n    # prefix of `rev_s` that is also a suffix of `string`. This length `L` is precisely\n    # the length of the longest palindromic suffix of the original `string`.\n    L = pi_array[-1]\n\n    # The part of the original string that is NOT part of the longest palindromic suffix\n    # needs to be reversed and appended to make the full string a palindrome.\n    # This prefix is string[0 : len(string) - L].\n    prefix_to_add = string[:len(string) - L]\n\n    # Construct the shortest palindrome by appending the reversed prefix to the original string.\n    return string + _reverse_str(prefix_to_add)"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    x, y = abs(a), abs(b)\n    while y:\n        x, y = y, x % y\n    return x"}
{"task_id": "HumanEval/14", "solution": "def all_prefixes(string: str) -> List[str]:\n    \"\"\" Return list of all prefixes from shortest to longest of the input string\n    >>> all_prefixes('abc')\n    ['a', 'ab', 'abc']\n    \"\"\"\n    from .prefix_service import PrefixService\n    from .dto import PrefixRequest\n\n    # Instantiate PrefixService. By default, it uses an in-memory cache and optional persistence.\n    service = PrefixService()\n    \n    # Create a PrefixRequest object. By default, it allows empty strings.\n    request = PrefixRequest(input_text=string)\n    \n    # Delegate the computation, validation, and caching logic to the PrefixService.\n    response = service.compute_prefixes(request)\n    \n    # Extract and return the list of prefixes from the service's response.\n    return response.prefixes"}
