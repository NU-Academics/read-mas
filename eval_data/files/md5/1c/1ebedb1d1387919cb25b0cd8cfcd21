{"task_id": "HumanEval/52", "solution": "def below_threshold(l: list, t: int):\n    \"\"\"Return True if all numbers in the list l are below threshold t.\n    >>> below_threshold([1, 2, 4, 10], 100)\n    True\n    >>> below_threshold([1, 20, 4, 10], 5)\n    False\n    \"\"\"\n    for item in l:\n        try:\n            # Attempt to convert each item to a float for numerical comparison.\n            num_item = float(item)\n        except (ValueError, TypeError):\n            # Raise ValueError if an item cannot be converted to a number.\n            raise ValueError(f\"List contains non-numeric item: {item!r}\")\n\n        # If any number is not strictly less than the threshold, return False.\n        if not (num_item < t):\n            return False\n\n    # If the loop completes, all items were numeric and strictly below the threshold, or the list was empty.\n    return True"}
{"task_id": "HumanEval/54", "solution": "import unicodedata\n\ndef same_chars(s0: str, s1: str):\n    \"\"\"\n    Check if two words have the same characters.\n    >>> same_chars('eabcdzzzz', 'dddzzzzzzzddeddabc')\n    True\n    >>> same_chars('abcd', 'dddddddabc')\n    True\n    >>> same_chars('dddddddabc', 'abcd')\n    True\n    >>> same_chars('eabcd', 'dddddddabc')\n    False\n    >>> same_chars('abcd', 'dddddddabce')\n    False\n    >>> same_chars('eabcdzzzz', 'dddzzzzzzzddddabc')\n    False\n    \"\"\"\n    # Apply default behavior: case-insensitive and normalized comparison.\n    case_sensitive = False\n    normalize = True\n\n    # Normalize unicode strings (NFC form).\n    processed_s0 = unicodedata.normalize(\"NFC\", s0) if normalize else s0\n    processed_s1 = unicodedata.normalize(\"NFC\", s1) if normalize else s1\n\n    # Convert to lowercase if not case-sensitive.\n    processed_s0 = processed_s0 if case_sensitive else processed_s0.casefold()\n    processed_s1 = processed_s1 if case_sensitive else processed_s1.casefold()\n\n    # Create sets of unique characters for comparison.\n    set_s0 = set(processed_s0)\n    set_s1 = set(processed_s1)\n\n    return set_s0 == set_s1"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True if list elements are monotonically increasing or decreasing.\n    An empty list or a single-element list is considered monotonic.\n    \"\"\"\n    n = len(l)\n    if n < 2:\n        return True\n\n    saw_increase = False\n    saw_decrease = False\n\n    for i in range(1, n):\n        a = l[i - 1]\n        b = l[i]\n\n        if b > a:\n            saw_increase = True\n        elif b < a:\n            saw_decrease = True\n\n        if saw_increase and saw_decrease:\n            return False\n\n    return True"}
{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '<':\n            balance += 1\n        elif char == '>':\n            balance -= 1\n        if balance < 0:\n            return False\n    return balance == 0"}
{"task_id": "HumanEval/55", "solution": "def fib(n: int):\n    \"\"\"Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    def _fib_fast_doubling_pair(k: int):\n        \"\"\"Returns the pair (F_k, F_{k+1}) using fast doubling.\"\"\"\n        if k == 0:\n            return (0, 1)\n        \n        a, b = _fib_fast_doubling_pair(k >> 1) # (F_{k/2}, F_{k/2 + 1})\n        \n        c = a * ((b << 1) - a) # F_{2k} = F_k * (2 * F_{k+1} - F_k)\n        d = a*a + b*b        # F_{2k+1} = F_k^2 + F_{k+1}^2\n        \n        if k & 1: # If k is odd\n            return (d, c + d) # (F_{2k+1}, F_{2k+2})\n        return (c, d)         # (F_{2k}, F_{2k+1})\n\n    return _fib_fast_doubling_pair(n)[0]"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    largest_prime = 1\n\n    # Handle factor 2\n    while n % 2 == 0:\n        largest_prime = 2\n        n //= 2\n\n    # Iterate through odd divisors from 3 up to sqrt(n)\n    d = 3\n    while d * d <= n:\n        while n % d == 0:\n            largest_prime = d\n            n //= d\n        d += 2\n\n    # If n is still greater than 1, the remaining n is prime and is the largest factor\n    if n > 1:\n        largest_prime = n\n\n    return largest_prime"}
{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int):\n    \"\"\"sum_to_n is a function that sums numbers from 1 to n.\n    >>> sum_to_n(30)\n    465\n    >>> sum_to_n(100)\n    5050\n    >>> sum_to_n(5)\n    15\n    >>> sum_to_n(10)\n    55\n    >>> sum_to_n(1)\n    1\n    \"\"\"\n    return n * (n + 1) // 2"}
