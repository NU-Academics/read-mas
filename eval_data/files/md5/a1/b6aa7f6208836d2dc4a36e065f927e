{"task_id": "HumanEval/25", "solution": "from typing import List\ndef factorize(n: int) -> List[int]:\n    \"\"\"\n    Returns a list of prime factors for a positive integer n, in ascending order.\n    Each factor is included according to its multiplicity.\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n\n    prime_factors = []\n\n    # Handle factor 2\n    while n % 2 == 0:\n        prime_factors.append(2)\n        n //= 2\n\n    # Handle odd factors starting from 3 up to sqrt(n)\n    # We iterate up to i*i <= n to check for factors up to the square root of n.\n    i = 3\n    while i * i <= n:\n        while n % i == 0:\n            prime_factors.append(i)\n            n //= i\n        i += 2\n\n    # If n is still greater than 1, it must be the last prime factor\n    if n > 1:\n        prime_factors.append(n)\n\n    return prime_factors"}
{"task_id": "HumanEval/26", "solution": "from typing import List, Dict, Set\nclass ListOfIntegers:\n    \"\"\"Encapsulates a list of integers for duplicate processing.\"\"\"\n    def __init__(self, input_list: List[int]):\n        \"\"\"Initializes with the input list and computes element frequencies.\"\"\"\n        self.elements = input_list\n        self.element_counts: Dict[int, int] = {}\n        for x in input_list:\n            self.element_counts[x] = self.element_counts.get(x, 0) + 1\n\n    def identify_duplicate_elements(self) -> Set[int]:\n        \"\"\"Identifies and returns a set of elements that occur more than once.\"\"\"\n        duplicates = set()\n        for element, count in self.element_counts.items():\n            if count > 1:\n                duplicates.add(element)\n        return duplicates\n\n    def get_processed_list(self) -> List[int]:\n        \"\"\"Filters the original list, keeping only elements that appeared exactly once.\"\"\"\n        duplicates = self.identify_duplicate_elements()\n        result = [element for element in self.elements if element not in duplicates]\n        return result\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    >>> remove_duplicates([1, 2, 3, 2, 4])\n    [1, 3, 4]\n    \"\"\"\n    list_obj = ListOfIntegers(numbers)\n    return list_obj.get_processed_list()"}
{"task_id": "HumanEval/26", "solution": "from typing import List\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    >>> remove_duplicates([1, 2, 3, 2, 4])\n    [1, 3, 4]\n    \"\"\"\n    counts = {}\n    for num in numbers:\n        counts[num] = counts.get(num, 0) + 1\n\n    result = []\n    for num in numbers:\n        if counts[num] == 1:\n            result.append(num)\n\n    return result"}
