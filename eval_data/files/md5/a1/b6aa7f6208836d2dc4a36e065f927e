{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    # The function calculates the median of a numerical list after sorting it.\n    # It handles both odd and even length lists as specified.\n    sorted_l = sorted(l)\n    length = len(sorted_l)\n\n    if length % 2 == 1:\n        # For odd length lists, the median is the middle element.\n        return sorted_l[length // 2]\n    else:\n        # For even length lists, the median is the average of the two middle elements.\n        mid1 = sorted_l[length // 2 - 1]\n        mid2 = sorted_l[length // 2]\n        return (mid1 + mid2) / 2"}
{"task_id": "HumanEval/47", "solution": "def median(l: list) -> float:\n    \"\"\"Return median of elements in the list l.\n    Handles both odd and even-length lists of numerical elements.\n    \"\"\"\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    if n % 2 == 1:\n        # Odd length list: median is the middle element.\n        median_value = sorted_l[n // 2]\n    else:\n        # Even length list: median is the average of the two middle elements.\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        median_value = (mid1 + mid2) / 2.0\n\n    return float(median_value)"}
{"task_id": "HumanEval/48", "solution": "def is_palindrome(text: str):\n    \"\"\"\n    Checks if given string is a palindrome, ignoring case and non-alphanumeric characters.\n    >>> is_palindrome('')\n    True\n    >>> is_palindrome('aba')\n    True\n    >>> is_palindrome('aaaaa')\n    True\n    >>> is_palindrome('zbcd')\n    False\n    \"\"\"\n    normalized_text_chars = []\n    for char in text:\n        if char.isalnum():\n            normalized_text_chars.append(char.lower())\n\n    normalized_text = \"\".join(normalized_text_chars)\n    reversed_text = normalized_text[::-1]\n\n    return normalized_text == reversed_text"}
{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    >>> pairs_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> pairs_sum_to_zero([1, 3, -2, 1])\n    False\n    >>> pairs_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> pairs_sum_to_zero([2, 4, -5, 3, 5, 7])\n    True\n    >>> pairs_sum_to_zero([1])\n    False\n    \"\"\"\n    seen = set()\n    for num in l:\n        if -num in seen:\n            return True\n        seen.add(num)\n    return False"}
