{"task_id": "HumanEval/54", "solution": "def same_chars(s0: str, s1: str) -> bool:\n    \"\"\"\n    Check if two words have the same characters.\n    >>> same_chars('eabcdzzzz', 'dddzzzzzzzddeddabc')\n    True\n    >>> same_chars('abcd', 'dddddddabc')\n    True\n    >>> same_chars('dddddddabc', 'abcd')\n    True\n    >>> same_chars('eabcd', 'dddddddabc')\n    False\n    >>> same_chars('abcd', 'dddddddabce')\n    False\n    >>> same_chars('eabcdzzzz', 'dddzzzzzzzddddabc')\n    False\n    \"\"\"\n    if len(s0) != len(s1):\n        return False\n\n    freq_map = {}\n    for char in s0:\n        freq_map[char] = freq_map.get(char, 0) + 1\n\n    for char in s1:\n        if char not in freq_map or freq_map[char] == 0:\n            return False\n        freq_map[char] -= 1\n\n    return True"}
{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str) -> bool:\n    \"\"\"\n    Checks if every opening bracket has a corresponding closing bracket\n    and they are correctly nested.\n    \"\"\"\n    stack = []\n    for char in brackets:\n        if char == '<':\n            stack.append(char)\n        elif char == '>':\n            if not stack:\n                return False  # Unmatched closing bracket\n            stack.pop()\n    return not stack  # True if stack is empty, False if not"}
{"task_id": "HumanEval/55", "solution": "def fib(n: int):\n    \"\"\"Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    if n <= 2:\n        return 1\n\n    a, b = 1, 1\n    for _ in range(3, n + 1):\n        a, b = b, a + b\n    return b"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    \"\"\"\n    if len(l) <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(len(l) - 1):\n        if l[i] > l[i+1]:\n            is_increasing = False\n        if l[i] < l[i+1]:\n            is_decreasing = False\n\n    return is_increasing or is_decreasing"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\n    This function leverages set intersection for efficiency and then sorts the result.\n    \"\"\"\n    # Convert lists to sets to efficiently find common elements and ensure uniqueness.\n    set1 = set(l1)\n    set2 = set(l2)\n\n    # Find the intersection of the two sets.\n    common_set = set1.intersection(set2)\n\n    # Convert the common set back to a list and sort it.\n    sorted_common_list = sorted(list(common_set))\n\n    return sorted_common_list"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    This function efficiently finds the largest prime factor by trial division.\n    \"\"\"\n    largest_prime = 1\n\n    # Divide by 2 until n is odd\n    while n % 2 == 0:\n        largest_prime = 2\n        n //= 2\n\n    # Check for odd factors from 3 up to sqrt(n)\n    i = 3\n    while i * i <= n:\n        while n % i == 0:\n            largest_prime = i\n            n //= i\n        i += 2\n\n    # If n is still greater than 1, it must be a prime factor itself, and the largest\n    if n > 1:\n        largest_prime = n\n\n    return largest_prime"}
