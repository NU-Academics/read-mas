{"task_id": "HumanEval/0", "solution": "from typing import List\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\"Check if any two numbers in the list are closer than the given threshold.\n    Returns True if such a pair exists, False otherwise.\"\"\"\n    n = len(numbers)\n    if n < 2:\n        return False\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            if abs(numbers[i] - numbers[j]) < threshold:\n                return True\n    return False"}
{"task_id": "HumanEval/2", "solution": "import math\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    integer_part = math.floor(number)\n    decimal_part = number - integer_part\n    return decimal_part"}
{"task_id": "HumanEval/2", "solution": "def truncate_number(number: float) -> float:\n    \"\"\"Given a positive floating-point number, this function returns its decimal part.\n    It is calculated by subtracting the integer part from the number itself.\n    \"\"\"\n    return number - int(number)"}
{"task_id": "HumanEval/1", "solution": "from typing import List\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Separates distinct, balanced groups of parentheses from the input string.\n    Each group returned is balanced and not nested within other separated groups.\n    \"\"\"\n    cleaned_string = paren_string.replace(' ', '')\n    groups = []\n    balance = 0\n    start_index = -1\n\n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            if balance == 0:\n                start_index = i\n            balance += 1\n        elif char == ')':\n            balance -= 1\n            if balance == 0:\n                groups.append(cleaned_string[start_index : i + 1])\n                start_index = -1 # Reset for next potential group\n    return groups"}
{"task_id": "HumanEval/0", "solution": "from typing import List\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, any two numbers are closer to each other than\n    given threshold. Sorts the list for efficient adjacent-element comparison.\n    \"\"\"\n    if len(numbers) < 2:\n        return False\n\n    # Sort the numbers to enable efficient checking of adjacent elements.\n    sorted_numbers = sorted(numbers)\n\n    # Iterate through the sorted list, comparing adjacent elements.\n    # If any adjacent pair has an absolute difference less than the threshold, return True.\n    for i in range(len(sorted_numbers) - 1):\n        if abs(sorted_numbers[i+1] - sorted_numbers[i]) < threshold:\n            return True\n\n    # If no such pair is found after checking all adjacent elements, return False.\n    return False"}
{"task_id": "HumanEval/3", "solution": "from typing import List\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\" You're given a list of deposit and withdrawal operations on a bank account that starts with\n    zero balance. Your task is to detect if at any point the balance of account fallls below zero, and\n    at that point function should return True. Otherwise it should return False.\n    >>> below_zero([1, 2, 3])\n    False\n    >>> below_zero([1, 2, -4, 5])\n    True\n    \"\"\"\n    current_balance = 0\n    for operation in operations:\n        current_balance += operation\n        if current_balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/3", "solution": "from typing import List\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\"Detects if an account balance, starting at zero, ever falls below zero after a sequence of operations.\n    Returns True if it falls below zero, False otherwise.\"\"\"\n    balance = 0  # FR1: Initialize account balance to zero.\n    for operation_value in operations:  # FR2: Process operations sequentially.\n        balance += operation_value  # FR3: Update balance with operation value.\n        if balance < 0:  # FR4: Detect below zero balance.\n            return True  # FR5: Return True if balance falls below zero.\n    return False  # FR6: Return False if never below zero after all operations."}
{"task_id": "HumanEval/1", "solution": "from typing import List\nclass _ParenStringProcessor:\n    \"\"\"Handles the raw input string, specifically for cleaning it by removing spaces.\"\"\"\n    def __init__(self, raw_string: str):\n        self._raw_content = raw_string\n        self._cleaned_content = raw_string.replace(' ', '')\n\n    def get_cleaned_content(self) -> str:\n        \"\"\"Returns the cleaned content with spaces removed.\"\"\"\n        return self._cleaned_content\nclass _ParenGroup:\n    \"\"\"Represents an individual parenthesis group and checks if it is balanced.\"\"\"\n    def __init__(self, content: str):\n        self._content = content\n\n    def is_balanced(self) -> bool:\n        \"\"\"Checks if the group's content has properly balanced parentheses.\"\"\"\n        balance = 0\n        for char in self._content:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0: # Closing parenthesis without a preceding open one.\n                return False\n        return balance == 0\n\n    def get_content(self) -> str:\n        \"\"\"Returns the string content of the parenthesis group.\"\"\"\n        return self._content\nclass _ResultCollector:\n    \"\"\"Manages the collection of valid _ParenGroup objects.\"\"\"\n    def __init__(self):\n        self._groups: List[_ParenGroup] = []\n\n    def add_group(self, group: _ParenGroup):\n        \"\"\"Adds a balanced and non-nested parenthesis group to the collection.\"\"\"\n        self._groups.append(group)\n\n    def to_string_list(self) -> List[str]:\n        \"\"\"Converts collected _ParenGroup objects into a list of strings.\"\"\"\n        return [group.get_content() for group in self._groups]\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"Separates top-level, balanced, non-nested parenthesis groups from an input string.\n    Ignores spaces and returns a list of these identified groups.\n    \"\"\"\n    processor = _ParenStringProcessor(paren_string)\n    cleaned_string = processor.get_cleaned_content()\n    collector = _ResultCollector()\n\n    balance = 0\n    group_start_index = 0\n\n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n\n        if balance == 0:\n            # A top-level balanced group has been found, potentially non-nested.\n            # Ensure the slice is not empty before creating a group.\n            if i >= group_start_index:\n                potential_group_content = cleaned_string[group_start_index : i + 1]\n                group = _ParenGroup(potential_group_content)\n                if group.is_balanced():\n                    collector.add_group(group)\n            group_start_index = i + 1 # Prepare for the next potential group.\n\n    return collector.to_string_list()"}
{"task_id": "HumanEval/5", "solution": "from typing import List\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\"Inserts a delimiter between every two consecutive elements of an input list of integers.\n    Handles an empty input list by returning an empty list.\n    \"\"\"\n    result = []\n    num_elements = len(numbers)\n\n    if num_elements == 0:\n        return []\n\n    for i, num in enumerate(numbers):\n        result.append(num)\n        # Add delimiter only if it's not the last element\n        if i < num_elements - 1:\n            result.append(delimeter)\n\n    return result"}
{"task_id": "HumanEval/5", "solution": "from typing import List\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:  # Handles the case of an empty input list.\n        return []\n    if len(numbers) == 1:  # Handles the case of a single-element input list.\n        return list(numbers)\n\n    result_list = [numbers[0]]\n    for num in numbers[1:]:\n        result_list.append(delimeter)\n        result_list.append(num)\n    return result_list"}
{"task_id": "HumanEval/4", "solution": "from typing import List\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    n = len(numbers)\n\n    # Handle the edge case of an empty list by returning 0.0, as per design.\n    if n == 0:\n        return 0.0\n\n    # Calculate the mean of the numbers list.\n    mean_val = sum(numbers) / n\n\n    # Calculate the sum of absolute differences from the mean.\n    sum_absolute_diffs = sum(abs(x - mean_val) for x in numbers)\n\n    # Calculate and return the Mean Absolute Deviation.\n    mad = sum_absolute_diffs / n\n    return mad"}
{"task_id": "HumanEval/6", "solution": "from typing import List\ndef _calculate_group_nesting_level(group_string: str) -> int:\n    \"\"\"Calculates the deepest nesting level for a single parentheses group.\n    Returns 0 if the group is empty or whitespace only.\n    \"\"\"\n    if not group_string.strip():\n        return 0\n\n    current_level = 0\n    max_level = 0\n    for char in group_string:\n        if char == '(':\n            current_level += 1\n        elif char == ')':\n            current_level -= 1\n        max_level = max(max_level, current_level)\n    return max_level\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    if not paren_string:\n        return []\n\n    groups = paren_string.split(' ')\n    results = []\n    for group_string in groups:\n        level = _calculate_group_nesting_level(group_string)\n        results.append(level)\n    return results"}
{"task_id": "HumanEval/7", "solution": "from typing import List\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\"Filter an input list of strings, retaining only those that contain the specified substring.\n    This function iterates through the list and adds matching strings to a new result list.\n    \"\"\"\n    filtered_list = []\n    for s in strings:\n        if substring in s:\n            filtered_list.append(s)\n    return filtered_list"}
{"task_id": "HumanEval/4", "solution": "from typing import List\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\"For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    MAD = average | x - x_mean |\n    \"\"\"\n    mean = sum(numbers) / len(numbers)\n    absolute_differences = [abs(x - mean) for x in numbers]\n    mad = sum(absolute_differences) / len(absolute_differences)\n    return mad"}
{"task_id": "HumanEval/6", "solution": "from typing import List\ndef _calculate_group_nesting(group_string: str) -> int:\n    \"\"\"Calculates the deepest nesting level for a single group of parentheses.\n    It iterates through the group, tracking current and maximum depths.\n    \"\"\"\n    current_depth = 0\n    max_depth = 0\n    for char in group_string:\n        if char == '(':\n            current_depth += 1\n            max_depth = max(max_depth, current_depth)\n        elif char == ')':\n            current_depth -= 1\n    return max_depth\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n    \"\"\"\n\n    groups = paren_string.split(' ')\n    nesting_levels = []\n    for group_string in groups:\n        level = _calculate_group_nesting(group_string)\n        nesting_levels.append(level)\n    return nesting_levels"}
{"task_id": "HumanEval/7", "solution": "from typing import List\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    if not strings:\n        return []\n\n    result = []\n    for s in strings:\n        if substring in s:\n            result.append(s)\n    return result"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    \"\"\"\n    total_sum = sum(numbers)\n\n    total_product = 1\n    for number in numbers:\n        total_product *= number\n\n    return (total_sum, total_product)"}
{"task_id": "HumanEval/9", "solution": "from typing import List\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    current_max = float('-inf')\n    for number in numbers:\n        current_max = max(current_max, number)\n        result.append(current_max)\n    return result"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    current_sum = 0\n    current_product = 1\n\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n\n    return (current_sum, current_product)"}
{"task_id": "HumanEval/10", "solution": "def reverse(s: str) -> str:\n    \"\"\"Reverses a given string.\"\"\"\n    return s[::-1]\ndef get_prefix(s: str, length: int) -> str:\n    \"\"\"Extracts a prefix of a specified length.\"\"\"\n    return s[:length]\ndef get_postfix(s: str, length: int) -> str:\n    \"\"\"Extracts a postfix of a specified length.\"\"\"\n    return s[len(s) - length:]\ndef append(s1: str, s2: str) -> str:\n    \"\"\"Concatenates two strings.\"\"\"\n    return s1 + s2\ndef is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    return string == reverse(string)\ndef find_longest_palindromic_postfix(s: str) -> str:\n    \"\"\"Identifies the longest palindromic postfix of a string.\"\"\"\n    for length in range(len(s), -1, -1):\n        postfix = get_postfix(s, length)\n        if is_palindrome(postfix):\n            return postfix\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    longest_pal_postfix = find_longest_palindromic_postfix(string)\n\n    non_pal_prefix_length = len(string) - len(longest_pal_postfix)\n    non_pal_prefix = get_prefix(string, non_pal_prefix_length)\n\n    reversed_prefix = reverse(non_pal_prefix)\n\n    return append(string, reversed_prefix)"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    return string == string[::-1]\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    if not string:\n        return \"\"\n\n    n = len(string)\n    longest_palindromic_suffix_len = 0\n\n    for i in range(n):\n        suffix = string[i:]\n        if is_palindrome(suffix):\n            longest_palindromic_suffix_len = n - i\n            break\n\n    prefix_to_reverse = string[:n - longest_palindromic_suffix_len]\n\n    return string + prefix_to_reverse[::-1]"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\"Return the greatest common divisor of two integers a and b using the Euclidean algorithm.\n    This function iteratively reduces the numbers until one becomes zero.\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    while b:\n        a, b = b, a % b\n    return a"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_so_far = strings[0]\n    for s in strings[1:]:\n        if len(s) > len(longest_so_far):\n            longest_so_far = s\n    return longest_so_far"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    a = abs(a)\n    b = abs(b)\n    while b:\n        a, b = b, a % b\n    return a"}
{"task_id": "HumanEval/14", "solution": "from typing import List\ndef all_prefixes(string: str) -> List[str]:\n    \"\"\" Return list of all prefixes from shortest to longest of the input string.\n    An empty list is returned if the input string is empty.\n    \"\"\"\n    prefixes = []\n    for i in range(1, len(string) + 1):\n        prefixes.append(string[0:i])\n    return prefixes"}
{"task_id": "HumanEval/15", "solution": "def string_sequence(n: int) -> str:\n    \"\"\"Return a string containing space-delimited numbers starting from 0 upto n inclusive.\"\"\"\n    return ' '.join(str(i) for i in range(n + 1))"}
