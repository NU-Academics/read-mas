{"task_id": "HumanEval/25", "solution": "from typing import List\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    \"\"\"\n    factors = []\n\n    # Handle edge case for n <= 1, which has no prime factors\n    if n <= 1:\n        return factors\n\n    # Divide by 2 repeatedly until n is odd\n    while n % 2 == 0:\n        factors.append(2)\n        n //= 2\n\n    # Iterate odd divisors starting from 3 up to the square root of the current n\n    i = 3\n    while i * i <= n:\n        while n % i == 0:\n            factors.append(i)\n            n //= i\n        i += 2  # Increment by 2 to check only odd numbers\n\n    # If n is still greater than 1 after the loop, it must be a prime factor itself\n    if n > 1:\n        factors.append(n)\n\n    return factors"}
{"task_id": "HumanEval/36", "solution": "def _is_divisible(number: int, divisor: int) -> bool:\n    \"\"\"Checks if a number is perfectly divisible by a divisor.\"\"\"\n    return number % divisor == 0\ndef _count_digit_occurrences(number: int, digit: int) -> int:\n    \"\"\"Counts occurrences of a digit in a number.\n    Handles negative numbers by converting to positive for digit counting.\n    \"\"\"\n    count = 0\n    num_str = str(abs(number))\n    digit_str = str(digit)\n    for char in num_str:\n        if char == digit_str:\n            count += 1\n    return count\ndef fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    \"\"\"\n    total_count = 0\n    for i in range(1, n):\n        if _is_divisible(i, 11) or _is_divisible(i, 13):\n            total_count += _count_digit_occurrences(i, 7)\n    return total_count"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    # Create a shallow copy of the input list to build the result.\n    result_list = list(l)\n\n    # Collect all elements from the input list that are at even indices.\n    even_indexed_values = []\n    for i in range(0, len(l), 2):\n        even_indexed_values.append(l[i])\n\n    # Sort the collected even-indexed values in ascending order.\n    even_indexed_values.sort()\n\n    # Iterate through the result list and replace elements at even indices with the sorted values.\n    even_sorted_idx = 0\n    for i in range(0, len(result_list), 2):\n        result_list[i] = even_indexed_values[even_sorted_idx]\n        even_sorted_idx += 1\n\n    return result_list"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    total_sevens_count = 0\n\n    if n <= 1:\n        return 0\n\n    for x in range(1, n):\n        if (x % 11 == 0) or (x % 13 == 0):\n            x_str = str(x)\n            current_sevens = x_str.count('7')\n            total_sevens_count += current_sevens\n\n    return total_sevens_count"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list) -> list:\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    \"\"\"\n    result_list = list(l)  # Create a copy to preserve the original list.\n\n    even_elements = []\n    for i in range(len(l)):\n        if i % 2 == 0:\n            even_elements.append(l[i])\n\n    even_elements.sort()\n\n    sorted_even_idx = 0\n    for i in range(len(result_list)):\n        if i % 2 == 0:\n            result_list[i] = even_elements[sorted_even_idx]\n            sorted_even_idx += 1\n\n    return result_list"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    Decodes a string that was encoded using encode_cyclic by reversing the cycle.\n    Splits the string into groups of three and uncycles them.\n    \"\"\"\n    # Split the encoded string into groups of three characters.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # Uncycle elements in each group if it has three characters.\n    # The original cycling was group[1:] + group[0]. To reverse, take the last character and move it to the front.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(encoded_string: str) -> str:\n    \"\"\"\n    Reverses the cyclic encoding for groups of three characters.\n    Restores the original string from its encoded form.\n    \"\"\"\n    decoded_parts = []\n    # Process the string in chunks of three characters.\n    for i in range(0, len(encoded_string), 3):\n        group = encoded_string[i:i+3]\n        if len(group) == 3:\n            # Apply a right cyclic shift to reverse the encoding (e.g., 'bca' -> 'abc').\n            decoded_parts.append(group[-1] + group[:-1])\n        else:\n            # Preserve the order of characters for partial groups.\n            decoded_parts.append(group)\n    return \"\".join(decoded_parts)"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    Checks if three distinct elements in the list sum to zero.\n    Returns True if such a triple exists, False otherwise.\n    \"\"\"\n    if len(l) < 3:\n        return False\n\n    l.sort()\n\n    n = len(l)\n    for i in range(n - 2):\n        # Skip duplicate elements for the first number\n        if i > 0 and l[i] == l[i - 1]:\n            continue\n\n        left = i + 1\n        right = n - 1\n\n        while left < right:\n            current_sum = l[i] + l[left] + l[right]\n\n            if current_sum == 0:\n                return True\n            elif current_sum < 0:\n                left += 1\n                # Skip duplicate elements for the second number\n                while left < right and l[left] == l[left - 1]:\n                    left += 1\n            else: # current_sum > 0\n                right -= 1\n                # Skip duplicate elements for the third number\n                while left < right and l[right] == l[right + 1]:\n                    right -= 1\n\n    return False"}
