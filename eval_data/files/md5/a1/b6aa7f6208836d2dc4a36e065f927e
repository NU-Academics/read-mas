{"task_id": "HumanEval/57", "solution": "def monotonic(l: list) -> bool:\n    \"\"\"Return True if list elements are monotonically increasing or decreasing.\n    An empty or single-element list is considered monotonic.\n    \"\"\"\n    if len(l) <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(len(l) - 1):\n        if l[i] > l[i+1]:\n            is_increasing = False\n        if l[i] < l[i+1]:\n            is_decreasing = False\n\n        # If neither trend is possible, the list is not monotonic.\n        if not is_increasing and not is_decreasing:\n            return False\n\n    return is_increasing or is_decreasing"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Write a function vowels_count which takes a string representing\n    a word as input and returns the number of vowels in the string.\n    Vowels in this case are 'a', 'e', 'i', 'o', 'u'. Here, 'y' is also a\n    vowel, but only when it is at the end of the given word.\n\n    Example:\n    >>> vowels_count(\"abcde\")\n    2\n    >>> vowels_count(\"ACEDY\")\n    3\n    >>> vowels_count(\"rhythm\")\n    1\n    >>> vowels_count(\"sky\")\n    1\n    >>> vowels_count(\"type\")\n    1\n    >>> vowels_count(\"why\")\n    1\n    >>> vowels_count(\"hello world\")\n    3\n    >>> vowels_count(\"\")\n    0\n    >>> vowels_count(\"bcdfgh\")\n    0\n    >>> vowels_count(\"queue\")\n    3\n    >>> vowels_count(\"SYZYGY\")\n    2\n    \"\"\"\n    s_lower = s.lower()\n    vowel_count = 0\n\n    for i, char in enumerate(s_lower):\n        if char in 'aeiou':\n            vowel_count += 1\n        elif char == 'y' and i == len(s_lower) - 1:\n            vowel_count += 1\n\n    return vowel_count"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s: str) -> int:\n    \"\"\"Write a function vowels_count which takes a string representing\n    a word as input and returns the number of vowels in the string.\n    Vowels in this case are 'a', 'e', 'i', 'o', 'u'. Here, 'y' is also a\n    vowel, but only when it is at the end of the given word.\n\n    Example:\n    >>> vowels_count(\"abcde\")\n    2\n    >>> vowels_count(\"ACEDY\")\n    3\n    >>> vowels_count(\"apple\")\n    2\n    >>> vowels_count(\"rhythm\")\n    1\n    >>> vowels_count(\"hello world\")\n    3\n    >>> vowels_count(\"why\")\n    1\n    >>> vowels_count(\"type\")\n    1\n    >>> vowels_count(\"\")\n    0\n    >>> vowels_count(\"aeiouAEIOU\")\n    10\n    >>> vowels_count(\"MYTH\")\n    1\n    \"\"\"\n    count = 0\n    lowercased_s = s.lower()\n\n    # Define standard vowels for quick lookup.\n    standard_vowels = {'a', 'e', 'i', 'o', 'u'}\n\n    for i, char in enumerate(lowercased_s):\n        if char in standard_vowels:\n            count += 1\n        elif char == 'y' and i == len(lowercased_s) - 1:\n            # 'y' is counted as a vowel only if it's the last character.\n            count += 1\n\n    return count"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int) -> int:\n    \"\"\"Calculates the largest prime factor of an integer n.\n\n    Assumes n > 1 and n is not a prime number.\n    \"\"\"\n    largest_factor = 1\n\n    # Repeatedly divide by 2 until n is odd.\n    while n % 2 == 0:\n        largest_factor = 2\n        n //= 2\n\n    # Check for odd factors from 3 up to the square root of n.\n    d = 3\n    while d * d <= n:\n        while n % d == 0:\n            largest_factor = d\n            n //= d\n        d += 2\n\n    # If n remains greater than 1, it is the largest prime factor.\n    if n > 1:\n        largest_factor = n\n\n    return largest_factor"}
{"task_id": "HumanEval/65", "solution": "import argparse\ndef circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    >>> circular_shift(12, 1)\n    \"21\"\n    >>> circular_shift(12, 2)\n    \"12\"\n    \"\"\"\n    s_x = str(x)\n    n = len(s_x)\n\n    if shift > n:\n        return s_x[::-1]\n    else:\n        # Calculate effective shift for circular right shift.\n        # This handles cases where shift is 0 or a multiple of n, resulting in no net shift.\n        effective_shift = shift % n\n        return s_x[n - effective_shift:] + s_x[:n - effective_shift]"}
