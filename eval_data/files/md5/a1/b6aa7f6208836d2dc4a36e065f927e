{"task_id": "HumanEval/131", "solution": "class Digit:\n    \"\"\"Helper class to represent a single digit and check its oddness.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def is_odd(self) -> bool:\n        \"\"\"Returns True if the digit is odd, False otherwise.\"\"\"\n        return self._value % 2 != 0\ndef digits(n: int) -> int:\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n    odd_digits_list = []\n    # Iterate through digits of n by converting it to a string.\n    for digit_char in str(n):\n        digit_value = int(digit_char)\n        current_digit = Digit(digit_value)\n        if current_digit.is_odd():\n            odd_digits_list.append(digit_value)\n\n    if not odd_digits_list:\n        return 0\n    else:\n        product = 1\n        # Calculate the product of all found odd digits.\n        for d in odd_digits_list:\n            product *= d\n        return product"}
{"task_id": "HumanEval/133", "solution": "import math\ndef sum_squares(lst):\n    \"\"\"Calculates the sum of squared numbers in the given list after rounding each element up to the nearest integer.\n    It returns the total sum of these squared, rounded-up numbers.\n    \"\"\"\n    total_sum = 0\n    for number in lst:\n        rounded_up = math.ceil(number)\n        squared = rounded_up * rounded_up\n        total_sum += squared\n    return total_sum"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    '''\n    Checks if the string contains a [[]] subsequence where indices are strictly increasing.\n    This function processes the input string in a single pass using state tracking.\n    '''\n    # current_state tracks the progress in finding the '[[]]' subsequence.\n    # 0: Looking for the first '[', 1: Found first '[', looking for second '[',\n    # 2: Found two '[', looking for first ']', 3: Found two '[', one ']', looking for second ']'\n    current_state = 0\n\n    for char in string:\n        if current_state == 0:\n            if char == '[':\n                current_state = 1\n        elif current_state == 1:\n            if char == '[':\n                current_state = 2\n        elif current_state == 2:\n            if char == ']':\n                current_state = 3\n        elif current_state == 3:\n            if char == ']':\n                return True  # Found the complete '[[]]' subsequence pattern.\n\n    return False  # No such subsequence was found after checking the entire string."}
{"task_id": "HumanEval/133", "solution": "def sum_squares(lst):\n    \"\"\"You are given a list of numbers.\n    You need to return the sum of squared numbers in the given list,\n    round each element in the list to the upper int(Ceiling) first.\n    \"\"\"\n\n    # Defines a custom ceiling function to avoid external imports.\n    def _custom_ceil(x: float) -> int:\n        if x > 0 and x != int(x):\n            return int(x) + 1\n        else:\n            return int(x)\n\n    class Number:\n        \"\"\"Encapsulates a numerical value and its rounding/squaring behaviors.\"\"\"\n        def __init__(self, value: float):\n            self._value = value # Stores the current value, modified by operations.\n\n        def roundUp(self) -> int:\n            \"\"\"Rounds the internal value up to the nearest integer.\"\"\"\n            self._value = _custom_ceil(self._value)\n            return int(self._value)\n\n        def square(self) -> int:\n            \"\"\"Squares the internal value.\"\"\"\n            self._value = self._value * self._value\n            return int(self._value)\n\n    # The logic here acts as the SumSquaresCalculator's sum_squares method,\n    # orchestrating the transformation and aggregation.\n    total_sum = 0\n    for num_val in lst:\n        number_entity = Number(num_val)\n        number_entity.roundUp()\n        # The `square` method is called after `roundUp`, operating on the already rounded internal value.\n        squared_value = number_entity.square()\n        total_sum += squared_value\n    return total_sum"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt: str) -> bool:\n    \"\"\"Checks if the last character of a string is an isolated alphabetical character.\n    Returns True if isolated, False otherwise.\"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    # A word is a group of characters separated by space.\n    # For the last character to be an isolated alphabetical character,\n    # it must be preceded by a space and the string must have more than one character.\n    # OR, if the string has only one character, and it's alphabetical, it's considered isolated.\n    if len(txt) == 1 and last_char.isalpha():\n        return True\n    elif len(txt) > 1 and txt[-2] == ' ':\n        return True\n    else:\n        # The last character is alphabetical but is either the only character,\n        # or it is preceded by another non-space character, making it part of a word.\n        return False"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    '''\n    Checks if the last character is an isolated alphabetical character.\n    An isolated character is one that is the only character or preceded by a space.\n    '''\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    # Check for isolation: either the string has only one character,\n    # or the character before the last one is a space.\n    if len(txt) == 1 or txt[-2] == ' ':\n        return True\n    else:\n        return False"}
{"task_id": "HumanEval/125", "solution": "from typing import List, Union\ndef _has_whitespace(text: str) -> bool:\n    \"\"\"Checks if the text contains any whitespace characters.\"\"\"\n    return any(c.isspace() for c in text)\ndef _has_comma(text: str) -> bool:\n    \"\"\"Checks if the text contains any comma characters.\"\"\"\n    return ',' in text\ndef _count_odd_order_lowercase_letters(text: str) -> int:\n    \"\"\"Counts lowercase letters with odd alphabetical order (a=0, b=1, ...).\"\"\"\n    count = 0\n    for char in text:\n        if 'a' <= char <= 'z':\n            order = ord(char) - ord('a')\n            if order % 2 != 0:\n                count += 1\n    return count\ndef split_words(txt: str) -> Union[List[str], int]:\n    \"\"\"\n    Splits a string by whitespace, then commas, or counts odd-ordered lowercase letters.\n    Prioritizes splitting based on delimiter presence.\n    \"\"\"\n    if _has_whitespace(txt):\n        return txt.split()\n    elif _has_comma(txt):\n        return txt.split(',')\n    else:\n        return _count_odd_order_lowercase_letters(txt)"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"\n    Finds the largest index where an element is strictly less than its preceding element.\n    Returns -1 if no such element is found.\n    \"\"\"\n    max_index = -1\n    for i in range(1, len(arr)):\n        if arr[i] < arr[i-1]:\n            max_index = i\n    return max_index"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"Create a function which returns the largest index of an element which\n    is not greater than or equal to the element immediately preceding it. If\n    no such element exists then return -1. The given array will not contain\n    duplicate values.\n\n    Examples:\n    can_arrange([1,2,4,3,5]) = 3\n    can_arrange([1,2,3]) = -1\n    \"\"\"\n    # Iterate backward from the second-to-last element to find the largest index.\n    for i in range(len(arr) - 1, 0, -1):\n        if arr[i] < arr[i-1]:\n            return i\n    # If no such index is found after checking all elements, return -1.\n    return -1"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    '''\n    Create a function that returns a tuple (a, b), where 'a' is\n    the largest of negative integers, and 'b' is the smallest\n    of positive integers in a list. If no such integers exist, return None for that category.\n    '''\n    largest_negative = None\n    smallest_positive = None\n\n    if not lst or lst == [0]:\n        return (None, None)\n\n    for number in lst:\n        if number < 0:\n            if largest_negative is None or number > largest_negative:\n                largest_negative = number\n        elif number > 0:\n            if smallest_positive is None or number < smallest_positive:\n                smallest_positive = number\n\n    return (largest_negative, smallest_positive)"}
{"task_id": "HumanEval/137", "solution": "def _convert_to_float(value):\n    \"\"\"\n    Converts a value (int, float, or str) to its float representation.\n    Handles string conversion by replacing commas with dots for decimal separation.\n    \"\"\"\n    if isinstance(value, str):\n        return float(value.replace(',', '.'))\n    return float(value)\ndef compare_one(a, b):\n    \"\"\"\n    Create a function that takes integers, floats, or strings representing\n    real numbers, and returns the larger variable in its given variable type.\n    Return None if the values are equal.\n    Note: If a real number is represented as a string, the floating point might be . or ,\n\n    compare_one(1, 2.5) \u279e 2.5\n    compare_one(1, \"2,3\") \u279e \"2,3\"\n    compare_one(\"5,1\", \"6\") \u279e \"6\"\n    compare_one(\"1\", 1) \u279e None\n    \"\"\"\n    numerical_a = _convert_to_float(a)\n    numerical_b = _convert_to_float(b)\n\n    if numerical_a > numerical_b:\n        return a\n    elif numerical_b > numerical_a:\n        return b\n    else:\n        return None"}
{"task_id": "HumanEval/137", "solution": "class _InputValue:\n    \"\"\"Encapsulates and parses an input value into its original form and a numeric float.\n    Handles string representations of real numbers with '.' or ',' decimal separators.\n    \"\"\"\n    def __init__(self, value):\n        self.original_value = value\n        self.original_type = type(value)\n\n        if isinstance(value, str):\n            self.parsed_numeric_value = float(value.replace(',', '.'))\n        else:\n            self.parsed_numeric_value = float(value)\n\n    def get_original_value(self):\n        \"\"\"Returns the value in its original type.\"\"\"\n        return self.original_value\n\n    def get_parsed_numeric_value(self):\n        \"\"\"Returns the numeric (float) representation of the value.\"\"\"\n        return self.parsed_numeric_value\n\n    def get_original_type(self):\n        \"\"\"Returns the original type of the value.\"\"\"\n        return self.original_type\nclass _ComparisonLogic:\n    \"\"\"Handles the numerical comparison between two _InputValue instances.\n    It determines the larger value or equality based on their parsed numeric forms.\n    \"\"\"\n    def compare(self, val1: _InputValue, val2: _InputValue):\n        \"\"\"Compares two _InputValue objects and returns the larger original value or None.\"\"\"\n        parsed_a = val1.get_parsed_numeric_value()\n        parsed_b = val2.get_parsed_numeric_value()\n\n        if parsed_a == parsed_b:\n            return None\n        elif parsed_a > parsed_b:\n            return val1.get_original_value()\n        else: # parsed_b > parsed_a\n            return val2.get_original_value()\ndef compare_one(a, b):\n    \"\"\"\n    Compares two values (int, float, or string real numbers) and returns the numerically larger\n    value in its original type, or None if they are equal.\n    \"\"\"\n    input_a = _InputValue(a)\n    input_b = _InputValue(b)\n\n    logic = _ComparisonLogic()\n    return logic.compare(input_a, input_b)"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether n can be written as the sum of exactly 4 positive even numbers.\n    This is true if n is even and greater than or equal to 8.\n    \"\"\"\n    if n < 8:\n        return False\n    if n % 2 != 0:\n        return False\n    return True"}
{"task_id": "HumanEval/131", "solution": "def _is_odd(digit: int) -> bool:\n    \"\"\"Determines if a given digit is odd.\n    Checks if the digit modulo 2 is not equal to 0.\n    \"\"\"\n    return digit % 2 != 0\ndef _extract_digits(n: int) -> list[int]:\n    \"\"\"Breaks down a positive integer into a list of its individual digits.\n    Converts the integer to a string and then to a list of integers.\n    \"\"\"\n    return [int(char) for char in str(n)]\ndef digits(n: int) -> int:\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    For example:\n    digits(1)  == 1\n    digits(4)  == 0\n    digits(235) == 15\n    \"\"\"\n    product = 1\n    found_odd_digit = False\n\n    extracted_digits = _extract_digits(n)\n\n    for digit in extracted_digits:\n        if _is_odd(digit):\n            product *= digit\n            found_odd_digit = True\n\n    if not found_odd_digit:\n        return 0\n    else:\n        return product"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n\n    # Helper function to calculate factorial of a single number k.\n    def _calculate_factorial(k):\n        result = 1\n        for i in range(1, k + 1):\n            result *= i\n        return result\n\n    # Validate input n for type and value as per NFR2.\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer (n > 0).\")\n\n    brazilian_factorial_result = 1\n    # Iterate from n down to 1, calculating individual factorials and multiplying them.\n    for k in range(n, 0, -1):\n        k_factorial = _calculate_factorial(k)\n        brazilian_factorial_result *= k_factorial\n\n    return brazilian_factorial_result"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    def _factorial(k):\n        \"\"\"Calculates the factorial of a non-negative integer k.\"\"\"\n        if k == 0:\n            return 1\n        result = 1\n        for i in range(1, k + 1):\n            result *= i\n        return result\n\n    total_special_factorial = 1\n    for i in range(n, 0, -1):\n        total_special_factorial *= _factorial(i)\n    return total_special_factorial"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    '''\n    Finds the largest negative and smallest positive integers in a list.\n    Returns (largest_negative, smallest_positive), or None for missing types.\n    '''\n    largest_neg = None\n    smallest_pos = None\n\n    for number in lst:\n        if number < 0:\n            if largest_neg is None or number > largest_neg:\n                largest_neg = number\n        elif number > 0:\n            if smallest_pos is None or number < smallest_pos:\n                smallest_pos = number\n\n    return (largest_neg, smallest_pos)"}
{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text):\n    \"\"\"\n    This function transforms spaces in a string according to specific rules,\n    ensuring consistent output for various space patterns.\n    \"\"\"\n    # Rule 1: Replace sequences of three or more consecutive spaces with a single hyphen.\n    processed_text = re.sub(r' {3,}', '-', text)\n\n    # Rule 2: Replace sequences of exactly two consecutive spaces with two underscores.\n    processed_text = re.sub(r' {2}', '__', processed_text)\n\n    # Rule 3: Replace single space characters with an underscore.\n    processed_text = re.sub(r' ', '_', processed_text)\n\n    return processed_text"}
{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text):\n    \"\"\"\n    Standardizes space characters within an input string according to specific rules.\n    It replaces sequences of three or more consecutive spaces with a hyphen, and single spaces with an underscore.\n    \"\"\"\n    # First, replace sequences of three or more spaces with a single hyphen.\n    modified_text = re.sub(r' {3,}', '-', text)\n\n    # Then, replace any remaining single spaces with an underscore.\n    final_text = modified_text.replace(' ', '_')\n\n    return final_text"}
{"task_id": "HumanEval/141", "solution": "class FileName:\n    \"\"\"Encapsulates file name components and validation logic.\n    It parses the file name into its name and extension parts during initialization.\n    \"\"\"\n    def __init__(self, full_name: str):\n        self.full_name = full_name\n        self.name_part = \"\"\n        self.extension_part = \"\"\n\n        # Optimistically split by the first dot if present.\n        # The isValid method will later verify if there's exactly one dot.\n        if '.' in full_name:\n            parts = full_name.split('.', 1)\n            self.name_part = parts[0]\n            if len(parts) > 1:\n                self.extension_part = parts[1]\n        else:\n            self.name_part = full_name # If no dot, the entire string is considered the name part.\n\n    def countDigits(self) -> int:\n        \"\"\"Counts the number of digits ('0'-'9') in the full file name.\"\"\"\n        count = 0\n        for char in self.full_name:\n            if '0' <= char <= '9':\n                count += 1\n        return count\n\n    def countDots(self) -> int:\n        \"\"\"Counts the number of dots ('.') in the full file name.\"\"\"\n        count = 0\n        for char in self.full_name:\n            if char == '.':\n                count += 1\n        return count\n\n    def isNamePartEmpty(self) -> bool:\n        \"\"\"Checks if the substring before the dot (name_part) is empty.\"\"\"\n        return len(self.name_part) == 0\n\n    def startsLatinLetter(self) -> bool:\n        \"\"\"Checks if the name_part starts with a letter from the latin alphabet.\"\"\"\n        if not self.name_part:\n            return False\n        first_char = self.name_part[0]\n        return ('a' <= first_char <= 'z') or ('A' <= first_char <= 'Z')\n\n    def isValidExtension(self) -> bool:\n        \"\"\"Checks if the extension part is one of 'txt', 'exe', or 'dll'.\"\"\"\n        return self.extension_part in ['txt', 'exe', 'dll']\n\n    def isValid(self) -> bool:\n        \"\"\"Performs all required validation checks on the file name.\n        Returns True if all conditions are met, False otherwise.\n        \"\"\"\n        # Rule 1: There should not be more than three digits.\n        if self.countDigits() > 3:\n            return False\n\n        # Rule 2: The file's name contains exactly one dot.\n        if self.countDots() != 1:\n            return False\n\n        # Following rules depend on a correctly parsed name_part and extension_part,\n        # which is guaranteed by Rule 2 passing and how __init__ handles splitting.\n\n        # Rule 3: The substring before the dot should not be empty.\n        if self.isNamePartEmpty():\n            return False\n\n        # Rule 4: The substring before the dot starts with a letter from the latin alphabet.\n        if not self.startsLatinLetter():\n            return False\n\n        # Rule 5: The substring after the dot should be one of 'txt', 'exe', or 'dll'.\n        if not self.isValidExtension():\n            return False\n\n        return True\ndef file_name_check(file_name):\n    \"\"\"Checks if a file name is valid based on specific rules.\n    Returns 'Yes' for a valid name, 'No' otherwise.\n    \"\"\"\n    file_obj = FileName(file_name)\n    if file_obj.isValid():\n        return 'Yes'\n    else:\n        return 'No'"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    \"\"\"Checks if the string contains a [[ ]] nested bracket subsequence.\n    The subsequence must have indices i < j < k < l with s[i]='[', s[j]='[', s[k]=']', s[l]=']'.\n    \"\"\"\n    found_first_open = False\n    found_second_open = False\n    found_first_close = False\n\n    for char in string:\n        if char == '[':\n            # If we've found the first open bracket, this one could be the second.\n            if found_first_open:\n                found_second_open = True\n            # Otherwise, this is the first open bracket found.\n            else:\n                found_first_open = True\n        elif char == ']':\n            # If we have two open brackets and a first close bracket, this one completes the [[ ]].\n            if found_second_open and found_first_close:\n                return True\n            # If we have two open brackets but no first close, this is the first close bracket.\n            elif found_second_open and not found_first_close:\n                found_first_close = True\n\n    return False"}
{"task_id": "HumanEval/141", "solution": "class FileNameValidator:\n    def __init__(self, file_name: str):\n        self._file_name = file_name\n        self._prefix = \"\"\n        self._suffix = \"\"\n\n    def _parse_file_name(self) -> None:\n        \"\"\"Attempts to split the file name into prefix and suffix at the first dot.\n        It does not validate the dot count itself.\"\"\"\n        parts = self._file_name.split('.', 1)\n        if len(parts) == 2:\n            self._prefix = parts[0]\n            self._suffix = parts[1]\n        else:\n            self._prefix = parts[0]\n            self._suffix = \"\"\n\n    def _check_digit_count(self) -> bool:\n        \"\"\"Checks if the file name contains no more than three digits.\"\"\"\n        digit_count = sum(1 for char in self._file_name if char.isdigit())\n        return digit_count <= 3\n\n    def _check_exactly_one_dot(self) -> bool:\n        \"\"\"Checks if the file name contains exactly one dot.\"\"\"\n        return self._file_name.count('.') == 1\n\n    def _check_non_empty_prefix(self) -> bool:\n        \"\"\"Checks if the substring before the dot is not empty.\"\"\"\n        return len(self._prefix) > 0\n\n    def _check_prefix_starts_with_latin_letter(self) -> bool:\n        \"\"\"Checks if the prefix starts with a letter from the latin alphabet.\n        Requires the prefix to be non-empty.\"\"\"\n        if not self._prefix:\n            return False\n        return self._prefix[0].isalpha()\n\n    def _check_valid_extension(self) -> bool:\n        \"\"\"Checks if the suffix (extension) is one of 'txt', 'exe', or 'dll'.\"\"\"\n        return self._suffix in ['txt', 'exe', 'dll']\n\n    def is_valid(self) -> bool:\n        \"\"\"Orchestrates the validation process for the file name by calling various checks.\n        Returns True if all checks pass, False otherwise.\"\"\"\n        self._parse_file_name()\n\n        # Perform checks in the specified order, short-circuiting on failure.\n        if not self._check_digit_count():\n            return False\n        if not self._check_exactly_one_dot():\n            return False\n        if not self._check_non_empty_prefix():\n            return False\n        if not self._check_prefix_starts_with_latin_letter():\n            return False\n        if not self._check_valid_extension():\n            return False\n\n        return True\ndef file_name_check(file_name: str) -> str:\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions\n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n    - The file's name contains exactly one dot '.'\n    - The substring before the dot should not be empty, and it starts with a letter from\n    the latin alphapet ('a'-'z' and 'A'-'Z').\n    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    \"\"\"\n    validator = FileNameValidator(file_name)\n    if validator.is_valid():\n        return 'Yes'\n    else:\n        return 'No'"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    Transforms list entries based on index: squares if index is a multiple of 3,\n    cubes if index is a multiple of 4 (but not 3), otherwise leaves unchanged.\n    Then returns the sum of all processed entries.\n    \"\"\"\n    total_sum = 0\n    for i, entry in enumerate(lst):\n        if i % 3 == 0:\n            total_sum += entry * entry\n        elif i % 4 == 0 and i % 3 != 0:\n            total_sum += entry * entry * entry\n        else:\n            total_sum += entry\n    return total_sum"}
{"task_id": "HumanEval/143", "solution": "def is_prime(n: int) -> bool:\n    \"\"\"Checks if a number is prime.\n    Returns True if n is prime, False otherwise.\"\"\"\n    if n < 2:\n        return False\n    i = 2\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 1\n    return True\nclass Word:\n    \"\"\"Represents a single word and checks if its length is a prime number.\"\"\"\n    def __init__(self, text: str):\n        \"\"\"Initializes a Word object with its text and calculates its length.\"\"\"\n        self.text = text\n        self.length = len(text)\n\n    def is_length_prime(self) -> bool:\n        \"\"\"Determines if the word's length is a prime number.\"\"\"\n        return is_prime(self.length)\nclass Sentence:\n    \"\"\"Represents the input sentence, parses it, and filters words by prime length.\"\"\"\n    def __init__(self, text: str):\n        \"\"\"Initializes a Sentence object with the input text.\"\"\"\n        self.text = text\n\n    def get_words(self) -> list[Word]:\n        \"\"\"Splits the sentence into individual words and returns a list of Word objects.\"\"\"\n        word_texts = self.text.split(' ')\n        return [Word(word_text) for word_text in word_texts if word_text]\n\n    def filter_words_by_prime_length(self) -> str:\n        \"\"\"Filters words with prime lengths and returns them as a space-separated string.\"\"\"\n        prime_words = []\n        for word_obj in self.get_words():\n            if word_obj.is_length_prime():\n                prime_words.append(word_obj.text)\n        return ' '.join(prime_words)\ndef words_in_sentence(sentence: str) -> str:\n    \"\"\"\n    You are given a string representing a sentence,\n    the sentence contains some words separated by a space,\n    and you have to return a string that contains the words from the original sentence,\n    whose lengths are prime numbers,\n    the order of the words in the new string should be the same as the original one.\n    \"\"\"\n    sentence_obj = Sentence(sentence)\n    return sentence_obj.filter_words_by_prime_length()"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    This function processes a list of integers, applying transformations (squaring, cubing, or retaining original value) based on their 0-based index.\n    It returns the sum of all processed entries, or 0 if the list is empty.\n    \"\"\"\n    if not lst:\n        return 0\n\n    total_sum = 0\n    for index, value in enumerate(lst):\n        processed_value = value\n        if index % 3 == 0:\n            # Square if index is a multiple of 3.\n            processed_value = value * value\n        elif index % 4 == 0:\n            # Cube if index is a multiple of 4 and not a multiple of 3.\n            processed_value = value * value * value\n        # Otherwise, the entry's value remains unchanged.\n\n        total_sum += processed_value\n\n    return total_sum"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Filters words in a sentence, returning only those with prime lengths.\n    Maintains original word order and joins with spaces.\n    \"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"\n        Checks if a given integer n is a prime number.\n        This helper function is defined inline as per design requirements.\n        \"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    words = sentence.split(' ')\n    filtered_words = []\n\n    for word in words:\n        if is_prime(len(word)):\n            filtered_words.append(word)\n\n    return \" \".join(filtered_words)"}
{"task_id": "HumanEval/144", "solution": "def simplify(x, n):\n    \"\"\"Checks if the product of two fractions is a whole number.\n    Returns True if the product is a whole number, False otherwise.\n    \"\"\"\n\n    class Fraction:\n        \"\"\"Represents a mathematical fraction with numerator and denominator.\"\"\"\n        def __init__(self, numerator, denominator):\n            self.numerator = numerator\n            self.denominator = denominator\n\n        @classmethod\n        def parse(cls, fraction_string):\n            \"\"\"Parses a string in \"num/den\" format into a Fraction object.\"\"\"\n            num_str, den_str = fraction_string.split('/')\n            return cls(int(num_str), int(den_str))\n\n        def multiply(self, other):\n            \"\"\"Multiplies this fraction by another Fraction object.\"\"\"\n            new_numerator = self.numerator * other.numerator\n            new_denominator = self.denominator * other.denominator\n            return Fraction(new_numerator, new_denominator)\n\n    class Expression:\n        \"\"\"Encapsulates two fractions and calculates their product.\"\"\"\n        def __init__(self, fraction1, fraction2):\n            self.fraction1 = fraction1\n            self.fraction2 = fraction2\n            self.product = self.fraction1.multiply(self.fraction2)\n\n        def is_whole_number(self):\n            \"\"\"Determines if the product fraction is a whole number.\"\"\"\n            return self.product.numerator % self.product.denominator == 0\n\n    f1 = Fraction.parse(x)\n    f2 = Fraction.parse(n)\n\n    expr = Expression(f1, f2)\n\n    return expr.is_whole_number()"}
{"task_id": "HumanEval/144", "solution": "class Fraction:\n    \"\"\"Represents a fraction with a numerator and a denominator.\n    Parses fraction strings into Fraction objects.\n    \"\"\"\n    def __init__(self, numerator: int, denominator: int):\n        self.numerator = numerator\n        self.denominator = denominator\n\n    @classmethod\n    def from_string(cls, fraction_str: str) -> 'Fraction':\n        \"\"\"Parses a string in \"numerator/denominator\" format into a Fraction object.\"\"\"\n        parts = fraction_str.split('/')\n        numerator = int(parts[0])\n        denominator = int(parts[1])\n        return cls(numerator, denominator)\ndef simplify(x: str, n: str) -> bool:\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise.\n    \"\"\"\n    fraction_x = Fraction.from_string(x)\n    fraction_n = Fraction.from_string(n)\n\n    product_numerator = fraction_x.numerator * fraction_n.numerator\n    product_denominator = fraction_x.denominator * fraction_n.denominator\n\n    return product_numerator % product_denominator == 0"}
{"task_id": "HumanEval/145", "solution": "from dataclasses import dataclass\ndef _calculate_digit_sum(n: int) -> int:\n    \"\"\"Calculates the sum of the absolute values of the digits of an integer.\n    Negative numbers are treated by their absolute value for digit sum calculation.\"\"\"\n    s = str(abs(n))\n    digit_sum = 0\n    for digit_char in s:\n        digit_sum += int(digit_char)\n    return digit_sum\ndef order_by_points(nums: list[int]) -> list[int]:\n    \"\"\"Sorts a list of integers primarily by ascending digit sum, then by original index.\n    Returns an empty list if the input list is empty.\"\"\"\n    if not nums:\n        return []\n\n    sortable_items = []\n    for i, num in enumerate(nums):\n        digit_sum = _calculate_digit_sum(num)\n        sortable_items.append(_SortableInteger(value=num, digit_sum=digit_sum, original_index=i))\n\n    sortable_items.sort(key=lambda item: (item.digit_sum, item.original_index))\n\n    return [item.value for item in sortable_items]"}
{"task_id": "HumanEval/146", "solution": "def _is_greater_than_10(num):\n    \"\"\"Checks if a number is strictly greater than 10.\n    This helper function supports the main filtering logic.\"\"\"\n    return num > 10\ndef _get_first_digit(num):\n    \"\"\"Extracts the first digit of a number, ignoring its sign.\n    The number is converted to a string to get its leading digit.\"\"\"\n    return int(str(abs(num))[0])\ndef _get_last_digit(num):\n    \"\"\"Extracts the last digit of a number, ignoring its sign.\n    This is achieved using the modulo operator with 10.\"\"\"\n    return abs(num) % 10\ndef _is_digit_odd(digit):\n    \"\"\"Checks if a given digit is odd.\n    This is true if the digit's remainder when divided by 2 is not zero.\"\"\"\n    return digit % 2 != 0\ndef specialFilter(nums):\n    \"\"\"Write a function that takes an array of numbers as input and returns\n    the number of elements in the array that are greater than 10 and both\n    first and last digits of a number are odd (1, 3, 5, 7, 9).\n    For example:\n    specialFilter([15, -73, 14, -15]) => 1\n    specialFilter([33, -2, -3, 45, 21, 109]) => 2\n    \"\"\"\n    count = 0\n    for num in nums:\n        if _is_greater_than_10(num):\n            first_digit = _get_first_digit(num)\n            if _is_digit_odd(first_digit):\n                last_digit = _get_last_digit(num)\n                if _is_digit_odd(last_digit):\n                    count += 1\n    return count"}
{"task_id": "HumanEval/148", "solution": "SOLAR_SYSTEM_PLANETS = (\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\")\ndef bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun\n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn,\n    Uranus, Neptune.\n    The function should return a tuple containing all planets whose orbits are\n    located between the orbit of planet1 and the orbit of planet2, sorted by\n    the proximity to the sun.\n    '''\n    if planet1 not in SOLAR_SYSTEM_PLANETS or planet2 not in SOLAR_SYSTEM_PLANETS:\n        return ()\n\n    index1 = SOLAR_SYSTEM_PLANETS.index(planet1)\n    index2 = SOLAR_SYSTEM_PLANETS.index(planet2)\n\n    start_index = min(index1, index2) + 1\n    end_index = max(index1, index2)\n\n    return SOLAR_SYSTEM_PLANETS[start_index:end_index]"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"\n    Evaluates if n can be written as the sum of exactly four positive even numbers.\n    Returns True if n meets the criteria, False otherwise.\n    \"\"\"\n    if n < 8:\n        return False\n    if n % 2 != 0:  # Check if n is an odd number\n        return False\n    return True"}
{"task_id": "HumanEval/147", "solution": "def _combinations_3(k: int) -> int:\n    \"\"\"Calculates C(k, 3), the number of combinations of choosing 3 items from k. Returns 0 if k < 3.\"\"\"\n    if k < 3:\n        return 0\n    return k * (k - 1) * (k - 2) // 6\ndef get_max_triples(n: int) -> int:\n    \"\"\"\n    You are given a positive integer n. You have to create an integer array a of length n.\n        For each i (1 \u2264 i \u2264 n), the value of a[i] = i * i - i + 1.\n        Return the number of triples (a[i], a[j], a[k]) of a where i < j < k,\n    and a[i] + a[j] + a[k] is a multiple of 3.\n\n    Example :\n        Input: n = 5\n        Output: 1\n        Explanation:\n        a = [1, 3, 7, 13, 21]\n        The only valid triple is (1, 7, 13).\n    \"\"\"\n    # Count elements whose remainder modulo 3 is 0 (i.e., i % 3 == 2)\n    count_mod0 = (n + 1) // 3\n\n    # Count elements whose remainder modulo 3 is 1 (i.e., i % 3 == 0 or i % 3 == 1)\n    count_mod1 = n - count_mod0\n\n    # Calculate combinations of 3 elements where all have remainder 0\n    triples_mod0 = _combinations_3(count_mod0)\n\n    # Calculate combinations of 3 elements where all have remainder 1\n    triples_mod1 = _combinations_3(count_mod1)\n\n    # The total number of valid triples is the sum of these two counts\n    return triples_mod0 + triples_mod1"}
{"task_id": "HumanEval/148", "solution": "_PLANETS_ORDER = (\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\")\ndef bf(planet1, planet2):\n    '''\n    Returns planets between planet1 and planet2, sorted by proximity to the Sun.\n    Returns an empty tuple if either planet name is invalid.\n    '''\n    try:\n        idx1 = _PLANETS_ORDER.index(planet1)\n        idx2 = _PLANETS_ORDER.index(planet2)\n    except ValueError:\n        return ()\n\n    start_idx = min(idx1, idx2) + 1\n    end_idx = max(idx1, idx2)\n\n    return tuple(_PLANETS_ORDER[start_idx:end_idx])"}
{"task_id": "HumanEval/147", "solution": "def _generate_array_a(n: int) -> list[int]:\n    \"\"\"\n    Constructs the integer array 'a' where a[i] = i*i - i + 1 for i from 1 to n.\n    The resulting list is 0-indexed, with element a[k] from the formula at index k-1.\n    \"\"\"\n    # Generate elements for i from 1 to n (inclusive)\n    return [i * i - i + 1 for i in range(1, n + 1)]\ndef get_max_triples(n: int) -> int:\n    \"\"\"\n    You are given a positive integer n. You have to create an integer array a of length n.\n        For each i (1 \u2264 i \u2264 n), the value of a[i] = i * i - i + 1.\n        Return the number of triples (a[i], a[j], a[k]) of a where i < j < k,\n    and a[i] + a[j] + a[k] is a multiple of 3.\n\n    Example :\n        Input: n = 5\n        Output: 1\n        Explanation:\n        a = [1, 3, 7, 13, 21]\n        The only valid triple is (1, 7, 13).\n    \"\"\"\n    if n < 3:\n        return 0\n\n    arr = _generate_array_a(n)\n\n    # Counts elements based on their remainder when divided by 3.\n    # count_rem[0] stores count of elements with remainder 0, etc.\n    count_rem = [0, 0, 0]\n    for val in arr:\n        count_rem[val % 3] += 1\n\n    total_count = 0\n\n    # Combinations (remainder 0, remainder 0, remainder 0)\n    if count_rem[0] >= 3:\n        total_count += (count_rem[0] * (count_rem[0] - 1) * (count_rem[0] - 2)) // 6\n\n    # Combinations (remainder 1, remainder 1, remainder 1)\n    if count_rem[1] >= 3:\n        total_count += (count_rem[1] * (count_rem[1] - 1) * (count_rem[1] - 2)) // 6\n\n    # Combinations (remainder 2, remainder 2, remainder 2)\n    if count_rem[2] >= 3:\n        total_count += (count_rem[2] * (count_rem[2] - 1) * (count_rem[2] - 2)) // 6\n\n    # Combinations (remainder 0, remainder 1, remainder 2)\n    total_count += count_rem[0] * count_rem[1] * count_rem[2]\n\n    return total_count"}
{"task_id": "HumanEval/150", "solution": "def is_prime(n: int) -> bool:\n    \"\"\"Checks if n is a prime number. It iterates through potential divisors up to n/2.\"\"\"\n    if n < 2:\n        return False\n    for i in range(2, n // 2 + 1):\n        if n % i == 0:\n            return False\n    return True\ndef x_or_y(n: int, x: any, y: any) -> any:\n    \"\"\"Returns x if n is prime, y otherwise. It leverages an internal primality check.\"\"\"\n    if is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/150", "solution": "def is_prime(n):\n    \"\"\"Determines if an integer n is a prime number.\n    Returns True if n is prime, False otherwise.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n <= 3: # 2 and 3 are prime\n        return True\n    if n % 2 == 0 or n % 3 == 0: # Eliminate multiples of 2 and 3\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\ndef x_or_y(n, x, y):\n    \"\"\"Returns x if n is prime, otherwise returns y.\n    This function delegates primality testing to a helper.\n    \"\"\"\n    if is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Write a function that accepts a list of strings as a parameter,\n    deletes the strings that have odd lengths from it,\n    and returns the resulted list with a sorted order,\n    The list is always a list of strings and never an array of numbers,\n    and it may contain duplicates.\n    The order of the list should be ascending by length of each word, and you\n    should return the list sorted by that rule.\n    If two words have the same length, sort the list alphabetically.\n    The function should return a list of strings in sorted order.\n    You may assume that all words will have the same length.\n    For example:\n    assert list_sort([\"aa\", \"a\", \"aaa\"]) => [\"aa\"]\n    assert list_sort([\"ab\", \"a\", \"aaa\", \"cd\"]) => [\"ab\", \"cd\"]\n    \"\"\"\n    if not isinstance(lst, list) or not all(isinstance(item, str) for item in lst):\n        raise TypeError(\"Input must be a list of strings.\")\n\n    filtered_list = [s for s in lst if len(s) % 2 == 0]\n\n    sorted_list = sorted(filtered_list, key=lambda s: (len(s), s))\n\n    return sorted_list"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers by the sum of their digits in ascending order.\n    Items with equal digit sums are then ordered by their original index.\n    \"\"\"\n    def calculate_digit_sum(n):\n        # Calculates the sum of the absolute value of digits of a number.\n        s = 0\n        n_abs = abs(n)\n        if n_abs == 0:\n            return 0\n        while n_abs > 0:\n            s += n_abs % 10\n            n_abs //= 10\n        return s\n\n    # Pair each number with its original index to use as a secondary sort key.\n    indexed_nums = [(num, i) for i, num in enumerate(nums)]\n\n    # Sort primarily by the sum of digits, and secondarily by original index.\n    sorted_indexed_nums = sorted(indexed_nums, key=lambda item: (calculate_digit_sum(item[0]), item[1]))\n\n    # Extract only the numbers from the sorted pairs.\n    return [item[0] for item in sorted_indexed_nums]"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n\n    double_the_difference([1, 3, 2, 0]) == 1 + 9 + 0 + 0 = 10\n    double_the_difference([-1, -2, 0]) == 0\n    double_the_difference([9, -2]) == 81\n    double_the_difference([0]) == 0\n\n    If the input list is empty, return 0.\n    '''\n    total_sum = 0\n    for num in lst:\n        if isinstance(num, int) and num > 0 and num % 2 != 0:\n            total_sum += num * num\n    return total_sum"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst: list) -> int:\n    \"\"\"\n    Calculates the sum of squares of odd, non-negative numbers in the list.\n    Ignores negative numbers and those not considered integer-valued.\n    \"\"\"\n    total_sum = 0\n    if not lst:\n        return 0\n\n    for element in lst:\n        # Filter out elements that are not integer-valued without using isinstance().\n        # This relies on 'Trust the caller\\'s inputs' for element to be numeric or convertible.\n        if element == int(element):\n            # Filter out elements that are negative.\n            if element >= 0:\n                # Identify odd numbers among the remaining non-negative integers.\n                if int(element) % 2 != 0:\n                    # Square the identified odd number and add to the running sum.\n                    total_sum += int(element) * int(element)\n    return total_sum"}
{"task_id": "HumanEval/152", "solution": "def compare(game, guess):\n    \"\"\"Compares actual game scores to user guesses, returning an array of differences.\n    If scores are equal, the difference is 0; otherwise, it's the absolute difference.\"\"\"\n    result_list = []\n    for i in range(len(game)):\n        game_score = game[i]\n        guess_score = guess[i]\n        if game_score == guess_score:\n            difference = 0\n        else:\n            difference = abs(game_score - guess_score)\n        result_list.append(difference)\n    return result_list"}
{"task_id": "HumanEval/153", "solution": "def _calculate_strength(extension_name: str) -> int:\n    \"\"\"Calculates the strength of an extension name.\n    Strength is defined as (uppercase count - lowercase count).\"\"\"\n    cap_count = 0\n    sm_count = 0\n    for char in extension_name:\n        if char.isupper():\n            cap_count += 1\n        elif char.islower():\n            sm_count += 1\n    return cap_count - sm_count\ndef Strongest_Extension(class_name: str, extensions: list[str]) -> str:\n    \"\"\"Finds the strongest extension for a class, returning ClassName.StrongestExtensionName.\n    Strength is based on uppercase minus lowercase letters, with ties broken by earliest appearance.\"\"\"\n    max_strength = float('-inf')\n    strongest_extension_name = \"\"\n\n    for extension_name in extensions:\n        current_strength = _calculate_strength(extension_name)\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = extension_name\n        # If current_strength == max_strength, the tie-breaking rule (FR4) means\n        # we keep the `strongest_extension_name` that appeared earliest in the list.\n\n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/152", "solution": "def compare(game, guess):\n    \"\"\"Calculates the absolute difference between game scores and player guesses for each match.\n    Returns an array where 0 indicates a correct guess and a non-zero value is the absolute difference.\n    \"\"\"\n    differences = []\n    for i in range(len(game)):\n        differences.append(abs(game[i] - guess[i]))\n    return differences"}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a, b):\n    \"\"\"Checks if any cyclic rotation of string b is a substring of string a.\n    Returns True if found, False otherwise.\"\"\"\n    len_b = len(b)\n    if len_b == 0:\n        return True if \"\" in a else False # An empty string is always a rotation of itself and found in any string.\n\n    b_double = b + b\n\n    for i in range(len_b):\n        rotation = b_double[i : i + len_b]\n        if rotation in a:\n            return True\n\n    return False"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    # Convert the absolute value of the number to a string to iterate through its digits.\n    abs_num_str = str(abs(num))\n\n    # Iterate through each digit in the string and count even and odd digits.\n    for digit_char in abs_num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/146", "solution": "class Number:\n    \"\"\"\n    Represents an integer number and provides methods to check its properties\n    according to the specialFilter criteria.\n    \"\"\"\n    def __init__(self, value: int):\n        \"\"\"\n        Initializes the Number object.\n        Args:\n            value: The integer value of the number.\n        \"\"\"\n        self._value = value\n\n    @staticmethod\n    def _is_odd(digit: int) -> bool:\n        \"\"\"\n        Helper method to check if a digit is odd.\n        Returns True if the digit is odd, False otherwise.\n        \"\"\"\n        return digit in {1, 3, 5, 7, 9}\n\n    def is_greater_than_ten(self) -> bool:\n        \"\"\"\n        Checks if the number is greater than 10.\n        Returns True if the number is greater than 10, False otherwise.\n        \"\"\"\n        return self._value > 10\n\n    def get_first_digit(self) -> int:\n        \"\"\"\n        Extracts the first digit of the number (absolute value).\n        Handles single-digit, multi-digit, and negative numbers.\n        \"\"\"\n        abs_str_num = str(abs(self._value))\n        return int(abs_str_num[0])\n\n    def get_last_digit(self) -> int:\n        \"\"\"\n        Extracts the last digit of the number (absolute value).\n        Returns the last digit as an integer.\n        \"\"\"\n        return abs(self._value) % 10\n\n    def is_first_digit_odd(self) -> bool:\n        \"\"\"\n        Checks if the first digit of the number is odd.\n        Returns True if the first digit is odd, False otherwise.\n        \"\"\"\n        first_digit = self.get_first_digit()\n        return self._is_odd(first_digit)\n\n    def is_last_digit_odd(self) -> bool:\n        \"\"\"\n        Checks if the last digit of the number is odd.\n        Returns True if the last digit is odd, False otherwise.\n        \"\"\"\n        last_digit = self.get_last_digit()\n        return self._is_odd(last_digit)\ndef specialFilter(nums):\n    \"\"\"\n    Filters a list of numbers based on specific criteria and returns the count\n    of numbers that meet all conditions. The number is greater than 10, and\n    both the first and last digits of the number are odd.\n    \"\"\"\n    count = 0\n    for num in nums:\n        current_number = Number(num)\n\n        if (current_number.is_greater_than_ten() and\n                current_number.is_first_digit_odd() and\n                current_number.is_last_digit_odd()):\n            count += 1\n\n    return count"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num: int) -> tuple[int, int]:\n    \"\"\"Given an integer, return a tuple that has the number of even and odd digits respectively.\n    It considers the absolute value of the input integer for digit counting.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    # Special case: if the number is 0, it has one even digit.\n    if num == 0:\n        return (1, 0)\n\n    # Process the absolute value of the number to count its digits.\n    num_str = str(abs(num))\n\n    for digit_char in num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/156", "solution": "_ROMAN_MAP = [\n    (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n    (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n    (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'), (1, 'I')\n]\ndef _to_roman_numeral(number: int) -> str:\n    \"\"\"\n    Converts an integer to its standard (uppercase) Roman numeral string\n    using a predefined mapping.\n    \"\"\"\n    result = []\n    temp_num = number\n    for value, numeral in _ROMAN_MAP:\n        while temp_num >= value:\n            result.append(numeral)\n            temp_num -= value\n    return \"\".join(result)\ndef int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n\n    Examples:\n    >>> int_to_mini_roman(19) == 'xix'\n    >>> int_to_mini_roman(152) == 'clii'\n    >>> int_to_mini_roman(426) == 'cdxxvi'\n    \"\"\"\n    _validate_input(number)\n    roman_str = _to_roman_numeral(number)\n    return roman_str.lower()"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst: list[str]) -> list[str]:\n    \"\"\"Filters a list of strings, removing odd-length strings.\n    Then, it sorts the remaining strings by length and alphabetically.\"\"\"\n\n    # Filter out strings with odd lengths.\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n\n    # Sort the remaining strings by length, then alphabetically for equal lengths.\n    even_length_strings.sort(key=lambda x: (len(x), x))\n\n    return even_length_strings"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    '''\n    # A default epsilon for floating-point comparisons.\n    DEFAULT_EPSILON = 1e-9\n\n    def is_approximately_equal(val1: float, val2: float, epsilon: float) -> bool:\n        \"\"\"Compares two float values for approximate equality.\"\"\"\n        return abs(val1 - val2) < epsilon\n\n    class Triangle:\n        \"\"\"Represents a triangle with three side lengths.\"\"\"\n        def __init__(self, a: float, b: float, c: float):\n            self._sideA = a\n            self._sideB = b\n            self._sideC = c\n\n        def is_right_angled(self, epsilon: float = DEFAULT_EPSILON) -> bool:\n            \"\"\"Checks if the triangle is right-angled using the Pythagorean theorem.\"\"\"\n            sides = sorted([self._sideA, self._sideB, self._sideC])\n            a_sq = sides[0] ** 2\n            b_sq = sides[1] ** 2\n            c_sq = sides[2] ** 2\n\n            # Check if a^2 + b^2 = c^2 (approximately).\n            return is_approximately_equal(a_sq + b_sq, c_sq, epsilon)\n\n    triangle = Triangle(a, b, c)\n    return triangle.is_right_angled()"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle, determine if they form a right-angled triangle.\n    It applies the Pythagorean theorem (a\u00b2 + b\u00b2 = c\u00b2) where 'c' is the longest side, with a small tolerance for floating-point accuracy.\n    '''\n    # Sort the sides to easily identify the two shorter sides (a_prime, b_prime) and the longest side (c_prime)\n    sides = sorted([a, b, c])\n    a_prime = sides[0]\n    b_prime = sides[1]\n    c_prime = sides[2]\n\n    # Use a small epsilon for floating-point comparison to account for precision issues\n    epsilon = 1e-6\n\n    # Check if a_prime^2 + b_prime^2 is approximately equal to c_prime^2\n    return abs(a_prime**2 + b_prime**2 - c_prime**2) < epsilon"}
{"task_id": "HumanEval/158", "solution": "def _calculate_unique_chars(word: str) -> int:\n    \"\"\"Calculates the number of unique characters in a given word.\n    Uses a set to count distinct characters efficiently.\n    \"\"\"\n    return len(set(word))\ndef find_max(words: list[str]) -> str:\n    \"\"\"Identifies the string with the maximum number of unique characters.\n    In case of ties, the lexicographically smallest string is selected.\n    \"\"\"\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_count = _calculate_unique_chars(word)\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            if result_word == \"\" or word < result_word:  # result_word == \"\" handles the first word if its count is 0\n                result_word = word\n\n    return result_word"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n\n    Examples:\n    >>> int_to_mini_roman(19) == 'xix'\n    >>> int_to_mini_roman(152) == 'clii'\n    >>> int_to_mini_roman(426) == 'cdxxvi'\n    \"\"\"\n    if not (1 <= number <= 1000):\n        raise ValueError(\"Number out of range (1-1000)\")\n\n    roman_map = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'), (1, 'I')\n    ]\n\n    roman_numeral_parts = []\n\n    for value, symbol in roman_map:\n        while number >= value:\n            roman_numeral_parts.append(symbol)\n            number -= value\n\n    return \"\".join(roman_numeral_parts).lower()"}
{"task_id": "HumanEval/158", "solution": "from typing import List, Set, Optional\nclass StringInfo:\n    \"\"\"Encapsulates a string's value and its unique character count.\n    Provides comparison logic for unique count and lexicographical order.\"\"\"\n    def __init__(self, value: str, unique_char_count: int):\n        self.value = value\n        self.unique_char_count = unique_char_count\n\n    def __lt__(self, other: 'StringInfo') -> bool:\n        \"\"\"Compares two StringInfo objects based on unique char count, then lexicographical order.\"\"\"\n        if self.unique_char_count != other.unique_char_count:\n            return self.unique_char_count < other.unique_char_count\n        return self.value < other.value\ndef _count_unique_characters(s: str) -> int:\n    \"\"\"Determines the number of unique characters in a given string.\"\"\"\n    if not s:\n        return 0\n    return len(set(s))\ndef find_max(words: List[str]) -> str:\n    \"\"\"Accepts a list of strings and returns the word with the maximum number of unique characters.\n    If multiple strings have the maximum number of unique characters, returns the one which comes first in lexicographical order.\"\"\"\n    if not words:\n        return \"\"\n\n    max_string_info: Optional[StringInfo] = None\n\n    for current_string_value in words:\n        unique_count = _count_unique_characters(current_string_value)\n        current_string_info = StringInfo(current_string_value, unique_count)\n\n        if max_string_info is None:\n            max_string_info = current_string_info\n        else:\n            if current_string_info.unique_char_count > max_string_info.unique_char_count:\n                max_string_info = current_string_info\n            elif current_string_info.unique_char_count == max_string_info.unique_char_count:\n                if current_string_info.value < max_string_info.value:\n                    max_string_info = current_string_info\n\n    return max_string_info.value if max_string_info else \"\""}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Constructs an algebraic expression from operators and operands, then evaluates it.\n    Assumes valid input lists adhering to length and content constraints.\n    \"\"\"\n    expression_parts = [str(operand[0])]\n    for i in range(len(operator)):\n        expression_parts.append(operator[i])\n        expression_parts.append(str(operand[i+1]))\n\n    expression_string = \" \".join(expression_parts)\n    return eval(expression_string)"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates total eaten carrots and remaining stock after a meal.\n    Handles scenarios where stock is less than needed.\n    \"\"\"\n    carrots_eaten_this_meal = 0\n    carrots_left = 0\n\n    if remaining >= need:\n        carrots_eaten_this_meal = need\n        carrots_left = remaining - need\n    else:\n        carrots_eaten_this_meal = remaining\n        carrots_left = 0\n\n    total_eaten = number + carrots_eaten_this_meal\n\n    return [total_eaten, carrots_left]"}
{"task_id": "HumanEval/161", "solution": "def is_letter(char: str) -> bool:\n    \"\"\"Checks if a character is an alphabetic letter.\"\"\"\n    return char.isalpha()\ndef reverse_case_char(char: str) -> str:\n    \"\"\"Reverses the case of a single letter character.\"\"\"\n    if char.isupper():\n        return char.lower()\n    else:\n        return char.upper()\ndef contains_letters(s: str) -> bool:\n    \"\"\"Checks if the input string contains any alphabetic letters.\"\"\"\n    for char in s:\n        if is_letter(char):\n            return True\n    return False\ndef solve(s: str) -> str:\n    \"\"\"Transforms an input string based on specific character-level and string-level rules.\n    Reverses the case of letter characters or reverses the entire string if it contains no letters.\"\"\"\n    if not contains_letters(s):\n        return s[::-1]\n    else:\n        processed_chars = []\n        for char in s:\n            if is_letter(char):\n                processed_chars.append(reverse_case_char(char))\n            else:\n                processed_chars.append(char)\n        return \"\".join(processed_chars)"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Calculates the strength of extensions (CAP - SM) and returns the class name concatenated\n    with the strongest extension, resolving ties by choosing the first encountered.\n    \"\"\"\n\n    max_strength = float('-inf')\n    strongest_extension_name = \"\"\n    strongest_extension_index = -1\n\n    for i, extension_name in enumerate(extensions):\n        cap_count = 0\n        sm_count = 0\n\n        for char in extension_name:\n            if char.isupper():\n                cap_count += 1\n            elif char.islower():\n                sm_count += 1\n\n        current_strength = cap_count - sm_count\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = extension_name\n            strongest_extension_index = i\n        elif current_strength == max_strength:\n            if i < strongest_extension_index:\n                strongest_extension_name = extension_name\n                strongest_extension_index = i\n\n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/161", "solution": "def _is_letter(char: str) -> bool:\n    \"\"\"Determines if a single character is an alphabetic letter.\"\"\"\n    return char.isalpha()\ndef _is_upper(char: str) -> bool:\n    \"\"\"Determines if a single character is an uppercase letter.\"\"\"\n    return char.isupper()\ndef _is_lower(char: str) -> bool:\n    \"\"\"Determines if a single character is a lowercase letter.\"\"\"\n    return char.islower()\ndef _reverse_case_char(char: str) -> str:\n    \"\"\"Reverses the case of a single alphabetic character.\"\"\"\n    if _is_upper(char):\n        return char.lower()\n    elif _is_lower(char):\n        return char.upper()\n    return char # Should not be reached if called after _is_letter check\ndef _contains_letters(s: str) -> bool:\n    \"\"\"Checks if the input string `s` contains any alphabetic characters.\"\"\"\n    for char in s:\n        if _is_letter(char):\n            return True\n    return False\ndef solve(s):\n    \"\"\"Orchestrates string transformation: reverses case of letters or reverses the whole string if no letters are present.\"\"\"\n    if _contains_letters(s):\n        transformed_chars = []\n        for char in s:\n            if _is_letter(char):\n                transformed_chars.append(_reverse_case_char(char))\n            else:\n                transformed_chars.append(char)\n        return \"\".join(transformed_chars)\n    else:\n        return s[::-1]"}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"\n    Checks if the second word (b) or any of its rotations is a substring in the first word (a).\n    Returns True if a match is found, False otherwise, following standard substring rules.\n    \"\"\"\n    # If 'b' is empty, its only rotation is \"\", which is a substring of any string 'a'.\n    if not b:\n        return True\n\n    # Generate all cyclic rotations of string 'b'.\n    # For each rotation, check if it exists as a substring within 'a'.\n    for i in range(len(b)):\n        rotation = b[i:] + b[:i]\n        if rotation in a:\n            return True # If a rotation is found, return True immediately.\n\n    # If no rotation of 'b' was found in 'a' after checking all possibilities.\n    return False"}
{"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_to_md5(text: str) -> str | None:\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    return hashlib.md5(text.encode('utf-8')).hexdigest()"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n\n    For example:\n    generate_integers(2, 8) => [2, 4, 6, 8]\n    generate_integers(8, 2) => [2, 4, 6, 8]\n    generate_integers(10, 14) => []\n    \"\"\"\n    min_val = min(a, b)\n    max_val = max(a, b)\n\n    result = []\n    # According to examples, only single even digits (2, 4, 6, 8) are considered.\n    # 0 is excluded as 'a' and 'b' are positive, implying the range is positive.\n    for digit in [2, 4, 6, 8]:\n        if min_val <= digit <= max_val:\n            result.append(digit)\n\n    return result"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Returns all even integers within the inclusive range defined by min(a, b) and max(a, b).\n    The output list is always in ascending order.\n    \"\"\"\n    start = min(a, b)\n    end = max(a, b)\n    even_numbers = []\n    for num in range(start, end + 1):\n        if num % 2 == 0:\n            even_numbers.append(num)\n    return even_numbers"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates total carrots eaten and remaining stock after a rabbit's meal.\n    The rabbit eats either its 'need' or all 'remaining' carrots if stock is insufficient.\n    \"\"\"\n\n    if need <= remaining:\n        total_eaten_carrots = number + need\n        carrots_left = remaining - need\n    else:\n        total_eaten_carrots = number + remaining\n        carrots_left = 0\n\n    return [total_eaten_carrots, carrots_left]"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Constructs an algebraic expression from given operators and operands, then evaluates it.\n    The expression respects standard mathematical operator precedence.\n    \"\"\"\n    expression_parts = [str(operand[0])]\n    for i in range(len(operator)):\n        expression_parts.append(operator[i])\n        expression_parts.append(str(operand[i+1]))\n\n    expression_string = \" \".join(expression_parts)\n    result = eval(expression_string)\n\n    return result"}
{"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_to_md5(text: str) -> str | None:\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    md5_hasher = hashlib.md5()\n    md5_hasher.update(text.encode('utf-8'))\n    return md5_hasher.hexdigest()"}
