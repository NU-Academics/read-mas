rn the number of the mango fruits in the basket.\n    for examble:\n    fruit_distribution(\"5 apples and 6 oranges\", 19) ->19 - 5 - 6 = 8\n    fruit_distribution(\"0 apples and 1 oranges\",3) -> 3 - 0 - 1 = 2\n    fruit_distribution(\"2 apples and 3 oranges\", 100) -> 100 - 2 - 3 = 95\n    fruit_distribution(\"100 apples and 1 oranges\",120) -> 120 - 100 - 1 = 19\n    \"\"\"\n    import re\n\n    # Helper function to extract a numeric count preceding a specific keyword.\n    def _extract_count(text: str, keyword: str) -> int:\n        match = re.search(r'(\\d+)\\s+' + re.escape(keyword), text, re.IGNORECASE)\n        if match:\n            return int(match.group(1))\n        return 0\n\n    apples = _extract_count(s, \"apples\")\n    oranges = _extract_count(s, \"oranges\")\n\n    total_known_fruits = apples + oranges\n    mango_count = n - total_known_fruits\n\n    return max(0, mango_count)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/72": [{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    \"\"\"\n    Checks if the object q will fly based on balance (palindrome) and weight.\n    Returns True if q is a palindrome and its sum is less than or equal to w, False otherwise.\n    \"\"\"\n    is_balanced = q == q[::-1]\n    total_weight = sum(q)\n    is_light_enough = total_weight <= w\n    \n    return is_balanced and is_light_enough", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/70": [{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    '''\n    result = []\n    data = list(lst) # Create a mutable copy to avoid modifying the original list\n\n    while data:\n        # Find and append minimum\n        min_val = mi