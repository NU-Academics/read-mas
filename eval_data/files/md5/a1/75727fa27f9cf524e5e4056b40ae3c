          C\n            > 1.3                C-\n            > 1.0                D+\n            > 0.7                D\n            > 0.0                D-\n              0.0                E\n\n\n    Example:\n    grade_equation([4.0, 3, 1.7, 2, 3.5]) ==> ['A+', 'B', 'C-', 'C', 'A-']\n    \"\"\"\n    # The grading scale, ordered from highest GPA threshold to lowest.\n    # Using tuples (gpa_threshold, letter_grade) for simplicity.\n    # This order is crucial for the 'gpa >= threshold' logic to work correctly,\n    # applying the highest applicable grade first.\n    GRADING_SCALE = [\n        (4.0, \"A+\"),\n        (3.7, \"A\"),\n        (3.3, \"A-\"),\n        (3.0, \"B+\"),\n        (2.7, \"B\"),\n        (2.3, \"B-\"),\n        (2.0, \"C+\"),\n        (1.7, \"C\"),\n        (1.3, \"C-\"),\n        (1.0, \"D+\"),\n        (0.7, \"D\"),\n        # The 0.0 threshold here correctly assigns 'D-' for GPAs strictly > 0.0\n        # as the special case for GPA == 0.0 is handled separately.\n        (0.0, \"D-\"),\n    ]\n\n    results = []\n    for gpa in grades:\n        if gpa == 0.0:\n            assigned_grade = \"E\"\n        elif gpa < 0.0:\n            # According to design context, any GPA below 0.0 also falls into 'E'.\n            assigned_grade = \"E\"\n        else:\n            assigned_grade = \"E\" # Default for safety, though scale covers all > 0.0\n            for threshold, letter_grade in GRADING_SCALE:\n                if gpa >= threshold:\n                    assigned_grade = letter_grade\n                    break\n        results.append(assigned_grade)\n    return results", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[4.0, 3, 1.7, 2, 3.5]]], "plus_fail_tests": [[[3.8, 2.5, 3.9, 2.2, 1.0]]]}], "HumanEval/88": [{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting.\n    The sorting order depends on the parity 