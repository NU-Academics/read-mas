to left, excluding the first and last characters\n    # Indices considered are from len(word) - 2 down to 1.\n    for i in range(len(word) - 2, 0, -1):\n        current_char = word[i]\n        left_char = word[i - 1]\n        right_char = word[i + 1]\n\n        if (is_vowel(current_char) and\n                is_consonant(left_char) and\n                is_consonant(right_char)):\n            return current_char\n            \n    return \"\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/117": [{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"Given a string s and a natural number n, returns a list of all words from string s\n    that contain exactly n consonants, in order these words appear in the string s.\n    \"\"\"\n    if not s:\n        return []\n\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    def is_consonant(char: str) -> bool:\n        \"\"\"Checks if a character is a consonant (case-insensitive).\"\"\"\n        lower_char = char.lower()\n        return 'a' <= lower_char <= 'z' and lower_char not in VOWELS\n\n    def count_consonants(word: str) -> int:\n        \"\"\"Counts the number of consonants in a given word.\"\"\"\n        count = 0\n        for char in word:\n            if is_consonant(char):\n                count += 1\n        return count\n\n    words = s.split()\n    result = []\n    for word in words:\n        consonant_count = count_consonants(word)\n        if consonant_count == n:\n            result.append(word)\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/122": [{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    \"\"\"\n    current_sum = 0\n    for i in range(k):\n        element = arr[i]\n        # Check if the absolute value of the element is less than 100 (at most two digits).\n        if abs(element) < 100:\n            current_sum += element\n    return current_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/123": [{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n\n    The Collatz conjecture is a conjecture in mathematics that concerns a sequence defined\n    as follows: start with any positive integer n. Then each term is obtained from the \n    previous term as follows: if the previous term is even, the next term is one half of \n    the previous term. If the previous term is odd, the next term is 3 times the previous\n    term plus 1. The conjecture is that no matter what value of n, the sequence will always reach 1.\n\n    Note: \n        1. Collatz(1) is [1].\n        2. returned list sorted in increasing order.\n\n    For example:\n    get_odd_collatz(5) returns [1, 5] # The collatz sequence for 5 is [5, 16, 8, 4, 2, 1], so the odd numbers are only 1, and 5.\n    \"\"\"\n    \n    sequence = []\n    current = n\n    \n    while True:\n        sequence.append(current)\n        if current == 1:\n            break\n        if current % 2 == 0:\n            current //= 2\n        else:\n            current = 3 * current + 1\n            \n    odd_numbers = set()\n    for num in sequence:\n        if num % 2 != 0:\n            odd_numbers.add(num)\n            \n    return sorted(list(odd_numbers))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/120": [{"task_id": "HumanEval/120", "solution": "import heapq\ndef maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list \n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    if k == 0:\n        return []\n\n    # Use a min-heap to maintain the k largest elements encountered so far.\n    min_heap = []\n    for num in arr:\n        if len(min_heap) < k:\n            heapq.heappush(min_heap, num)\n        else:\n            if num > min_heap[0]:\n                heapq.heapreplace(min_heap, num)\n    \n    # The heap contains the k largest elements; sort them in ascending order for the final output.\n    return sorted(min_heap)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/116": [{"task_id": "HumanEval/116", "solution": "def sort_array(arr):\n    \"\"\"\n    In this Kata, you have to sort an array of non-negative integers according to\n    number of ones in their binary representation in ascending order.\n    For similar number of ones, sort based on decimal value.\n    \"\"\"\n\n    class BitCounter:\n        \"\"\"Utility to count the number of set bits in a non-negative integer.\"\"\"\n        @staticmethod\n        def count_set_bits(n: int) -> int:\n            count = 0\n            if n < 0:\n                # As per design, this utility is primarily for non-negative numbers.\n                return 0\n            while n > 0:\n                n &= (n - 1)  # Brian Kernighan's algorithm\n                count += 1\n            return count\n\n    class BinaryOneSorter:\n        \"\"\"Encapsulates logic for sorting an array of integers based on rules.\"\"\"\n        def sort(self, arr_to_sort: list[int]) -> list[int]:\n            return sorted(arr_to_sort, key=self._get_sort_key)\n\n        def _get_sort_key(self, num: int) -> tuple:\n            \"\"\"Generates a custom sort key for an integer based on its sign.\"\"\"\n            if num < 0:\n                # Negative numbers are sorted purely by their decimal value.\n                # (-1, num) ensures they are grouped and sorted before non-negative numbers.\n                return (-1, num)\n            else:\n                # Non-negative numbers sorted by bit count, then decimal value.\n                bit_count = BitCounter.count_set_bits(num)\n                return (bit_count, num)\n\n    sorter = BinaryOneSorter()\n    return sorter.sort(arr)", "base_status": "fail", "plus_status": "pass", "base_fail_tests": [[[-2, -3, -4, -5, -6]]], "plus_fail_tests": []}], "HumanEval/126": [{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n    '''\n    import collections\n\n    if len(lst) <= 1:\n        return True\n\n    # Check for ascending order\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    # Check for duplicate count (max 2 occurrences per number)\n    MAX_DUPLICATE_COUNT = 2\n    counts = collections.Counter(lst)\n    for count in counts.values():\n        if count > MAX_DUPLICATE_COUNT:\n            return False\n\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/128": [{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Calculates the sum of magnitudes of integers multiplied by the product of all signs.\n    Returns None for an empty array.\n    \"\"\"\n    if not arr:\n        return None\n\n    product_of_signs = 1\n    sum_of_magnitudes = 0\n\n    for num in arr:\n        sum_of_magnitudes += abs(num)\n        if num > 0:\n            product_of_signs *= 1\n        elif num < 0:\n            product_of_signs *= -1\n        else: # num == 0\n            product_of_signs = 0 # If any number is 0, the overall sign product becomes 0.\n\n    return sum_of_magnitudes * product_of_signs", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/119": [{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    '''\n    You are given a list of two strings, both strings consist of open\n    parentheses '(' or close parentheses ')' only.\n    Your job is to check if it is possible to concatenate the two strings in\n    some order, that the resulting string will be good.\n    A string S is considered to be good if and only if all parentheses in S\n    are balanced. For example: the string '(())()' is good, while the string\n    '())' is not.\n    Return 'Yes' if there's a way to make a good string, and return 'No' otherwise.\n\n    Examples:\n    match_parens(['()(', ')']) == 'Yes'\n    match_parens([')', ')']) == 'No'\n    '''\n    def _is_balanced(s: str) -> bool:\n        \"\"\"Determines if a given string of parentheses is balanced.\"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    s1, s2 = lst[0], lst[1]\n\n    # Check s1 + s2 concatenation\n    if _is_balanced(s1 + s2):\n        return 'Yes'\n\n    # Check s2 + s1 concatenation\n    if _is_balanced(s2 + s1):\n        return 'Yes'\n\n    return 'No'", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/127": [{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"Determines if the length of the intersection of two closed intervals is a prime number.\"\"\"\n\n    def _is_prime(n: int) -> bool:\n        \"\"\"Checks if a given integer is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    # Calculate the start and end of the intersection\n    inter_start = max(start1, start2)\n    inter_end = min(end1, end2)\n\n    # If inter_start is greater than inter_end, there is no intersection\n    if inter_start > inter_end:\n        length = 0\n    else:\n        # Calculate the length of the closed intersection interval\n        length = inter_end - inter_start + 1\n\n    if _is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\"", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[-1, 1], [0, 4]]], "plus_fail_tests": [[[10, 20], [15, 25]]]}], "HumanEval/124": [{"task_id": "HumanEval/124", "solution": "import re\nDAYS_IN_MONTH_MAP = {\n    1: 31, 3: 31, 5: 31, 7: 31, 8: 31, 10: 31, 12: 31,\n    4: 30, 6: 30, 9: 30, 11: 30,\n    2: 29\n}\ndef valid_date(date):\n    \"\"\"Validates a given date string according to specific rules.\"\"\"\n\n    def _parse_date_components(date_string):\n        match = re.fullmatch(r\"(\\d{2})-(\\d{2})-(\\d{4})\", date_string)\n        if not match:\n            return None\n        try:\n            month = int(match.group(1))\n            day = int(match.group(2))\n            year = int(match.group(3))\n            return month, day, year\n        except ValueError:\n            return None\n\n    def _is_month_valid(month):\n        return 1 <= month <= 12\n\n    def _is_day_valid(day, month):\n        if not (1 <= day):\n            return False\n        \n        max_days = DAYS_IN_MONTH_MAP.get(month)\n        if max_days is None:\n            return False\n            \n        return day <= max_days\n\n    if not date:\n        return False\n\n    components = _parse_date_components(date)\n    if components is None:\n        return False\n\n    month, day, _ = components\n\n    if not _is_month_valid(month):\n        return False\n\n    if not _is_day_valid(day, month):\n        return False\n\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/131": [{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n    product = 1\n    found_odd = False\n    \n    # Extract digits from n\n    # The design context uses str(n) to extract digits, which is efficient.\n    for char_digit in str(n):\n        digit = int(char_digit)\n        \n        # Check if the digit is odd\n        # The design context defines an _is_odd helper.\n        if digit % 2 != 0:\n            product *= digit\n            found_odd = True\n            \n    return product if found_odd else 0", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/125": [{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    Examples\n    split_words(\"Hello world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"Hello,world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"abcdef\") == 3 \n    '''\n\n    # Helper function to count lowercase letters with odd alphabetical order\n    def _count_odd_ordered_lowercase(s):\n        count = 0\n        alphabet_offset = ord('a')\n        for char in s:\n            if 'a' <= char <= 'z':\n                # Calculate 0-indexed order\n                order = ord(char) - alphabet_offset\n                # Check if the order is odd\n                if order % 2 != 0:\n                    count += 1\n        return count\n\n    # Prioritize splitting by whitespace\n    if any(c.isspace() for c in txt):\n