ime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    import math\n    from typing import Generator\n\n    def is_prime(num: int) -> bool:\n        \"\"\"Determines if a given integer is a prime number.\"\"\"\n        if num < 2:\n            return False\n        for i in range(2, int(math.sqrt(num)) + 1):\n            if num % i == 0:\n                return False\n        return True\n\n    def generate_fibonacci_sequence() -> Generator[int, None, None]:\n        \"\"\"Generates an infinite sequence of Fibonacci numbers, starting from 2.\"\"\"\n        a, b = 0, 1\n        # Skip initial Fibonacci numbers until we reach the first prime Fib (2)\n        while b < 2:\n            a, b = b, a + b\n        \n        # Now start yielding from 2\n        while True:\n            yield b\n            a, b = b, a + b\n\n    prime_fib_count = 0\n    fib_gen = generate_fibonacci_sequence()\n    while True:\n        fib_num = next(fib_gen)\n        if is_prime(fib_num):\n            prime_fib_count += 1\n            if prime_fib_count == n:\n                return fib_num", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[12]]}], "HumanEval/161": [{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"Reverses case of letters or reverses the whole string if no letters are present.\"\"\"\n    has_letters = False\n    for char in s:\n        if char.isalpha():\n            has_letters = True\n            break\n\n    if has_letters:\n        return \"\".join(char.swapcase() if char.isalpha() else char for char in s)\n    else:\n        return s[::-1]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/160": [{"task_id": "HumanEval/160", "solution": "import operator as op_module\ndef do_algebra(operator, operand):\n    \"\"\"\n    Evaluates an algebraic expression from lists of operators and operands,\n    respecting standard operator precedence and associati