n number greater than or equal to 8 can be expressed as the sum of four positive even numbers.\n    return n % 2 == 0 and n >= 8", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/137": [{"task_id": "HumanEval/137", "solution": "def compare_one(a, b):\n    \"\"\"\n    Compares two numerical values (int, float, or string representations)\n    and returns the larger, preserving its original type, or None if equal.\n    \"\"\"\n    # Inline helper to convert any valid input to a float for comparison.\n    # It handles string representations with ',' or '.' as decimal separators.\n    def _to_float_convert(value):\n        s_value = str(value)\n        if ',' in s_value:\n            s_value = s_value.replace(',', '.')\n        return float(s_value)\n\n    # Store original values and convert them to floats for comparison.\n    original_a = a\n    float_a = _to_float_convert(a)\n\n    original_b = b\n    float_b = _to_float_convert(b)\n\n    # Compare the float representations to determine the larger value.\n    if float_a > float_b:\n        return original_a\n    elif float_b > float_a:\n        return original_b\n    else:\n        return None", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/140": [{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores, \n    and if a string has more than 2 consecutive spaces, \n    then replace all consecutive spaces with - \n    \"\"\"\n    # First, replace sequences of 3 or more spaces with a single hyphen\n    processed_text = re.sub(r' {3,}', '-', text)\n    \n    # Then, replace all remaining single spaces with underscores\n    final_text = processed_text.replace(' ', '_')\n    \n    return final_text", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/129": [{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k, \n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n\n    Examples:\n\n        Input: grid = [ [1,2,3], [4,5,6], [7,8,9]], k = 3\n        Output: [1, 2, 1]\n\n        Input: grid = [ [5,9,3], [4,1,6], [7,8,2]], k = 1\n        Output: [1]\n    \"\"\"\n    import heapq\n    from dataclasses import dataclass\n    from typing import List\n\n    @dataclass(frozen=True)\n    class Cell:\n        \"\"\"Represents an immutable coordinate (row, column) within the grid.\"\"\"\n        row: int\n        col: int\n\n    class Path:\n        \"\"\"Encapsulates the state of a path for lexicographical comparison.\"\"\"\n        def __init__(self, current_cell: Cell, values: List[int]):\n            self.current_cell = current_cell\n            self.values = values\n            self.length = len(values)\n\n        def __lt__(self, other: 'Path') -> bool:\n            \"\"\"Compares two paths lexicographically by their values list.\"\"\"\n            return self.values < other.values\n\n        def add_step(self, next_cell: Cell, grid_value: int) -> 'Path':\n            \"\"\"Returns a new Path object extended by one step.\"\"\"\n            new_values = self.values + [grid_value]\n            return Path(next_cell, new_values)\n\n    def get_neighbors(grid_size: int, cell: Cell) -> List[Cell]:\n        \"\"\"Returns a list of valid neighbor cells (up, down, left, right).\"\"\"\n        neighbors = []\n        dr = [-1, 1, 0, 0]  # Row changes for up, down, no change\n        dc = [0, 0, -1, 1]  # Column changes for no change, left, right\n\n        for i in range(4):\n            new_row, new_col = cell.row + dr[i], cell.col + dc[i]\n            if 0 <= new_row < grid_size and 0 <= new_col < grid_size:\n                neighbors.append(Cell(new_row, new_col))\n        return neighbors\n\n    N = len(grid)\n    \n    pq: List[Path] = []\n\n    # Initialize priority queue with all possible starting cells\n    for r in range(N):\n        for c in range(N):\n            start_cell = Cell(r, c)\n            initial_path = Path(start_cell, [grid[r][c]])\n            heapq.heappush(pq, initial_path)\n\n    # Dijkstra-like search for the lexicographically smallest path\n    while pq:\n        current_path = heapq.heappop(pq)\n\n        # If a path of length k is found, it's the lexicographically smallest.\n        if current_path.length == k:\n            return current_path.values\n\n        # Explore neighbors if the path can still be extended\n        if current_path.length < k:\n            for neighbor_cell in get_neighbors(N, current_path.current_cell):\n                new_path = current_path.add_step(\n                    neighbor_cell, grid[neighbor_cell.row][neighbor_cell.col]\n                )\n                heapq.heappush(pq, new_path)\n    \n    # This part should not be reached given the problem constraints (a unique answer is guaranteed).\n    return []", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/143": [{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Returns a string containing words from the original sentence whose lengths are prime numbers.\n    The order of words is maintained.\n    \"\"\"\n    def is_prime(n):\n        \"\"\"Checks if a given integer n is a prime number.\"\"\"\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    words = sentence.split()\n    filtered_words = []\n    for word in words:\n        if is_prime(len(word)):\n            filtered_words.append(word)\n    return \" \".join(filtered_words)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/132": [{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    '''\n    Create a function that takes a string as input which contains only square brackets.\n    The function should return True if and only if there is a valid subsequence of brackets \n    where at least one bracket in the subsequence is nested.\n    '''\n    def _contains_simple_pair(s_sub: str) -> bool:\n        \"\"\"\n        Checks if a substring contains at least one '[' followed by at least one ']'\n        as a subsequence.\n        \"\"\"\n        found_open = False\n        for char in s_sub:\n            if char == '[':\n                found_open = True\n            elif char == ']' and found_open:\n                return True\n        return False\n\n    for i, char_i in enumerate(string):\n        if char_i == '[':\n            # Look for a matching closing bracket ']' after string[i]\n            for j, char_j in enumerate(string[i + 1:], start=i + 1):\n                if char_j == ']':\n                    # Extract the substring between string[i] and string[j]\n                    inner_subsequence_str = string[i + 1:j]\n                    # Check if this inner substring contains a simple '[]' pair\n                    if _contains_simple_pair(inner_subsequence_str):\n                        return True\n    return False", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["[][][]"]]}], "HumanEval/141": [{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Checks if a file name is valid based on specific rules, returning 'Yes' or 'No'.\n    Rules include digit count, dot count, prefix format, and allowed extensions.\n    \"\"\"\n    # Rule 1: There should not be more than three digits ('0'-'9')\n    digit_count = sum(1 for char in file_name if char.isdigit())\n    if digit_count > 3:\n        return 'No'\n\n    # Rule 2: The file's name contains exactly one dot '.'\n    parts = file_name.split('.')\n    if len(parts) != 2:\n        return 'No'\n\n    prefix = parts[0]\n    extension = parts[1]\n\n    # Rule 3: The substring before the dot should not be empty, and it starts with a letter\n    if not prefix:\n        return 'No'\n    if not prefix[0].isalpha():\n        return 'No'\n\n    # Rule 4: The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    if extension not in ['txt', 'exe', 'dll']:\n        return 'No'\n\n    return 'Yes'", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/144": [{"task_id": "HumanEval/144", "solution": "import math\ndef simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n    \"\"\"\n\n    class Fraction:\n        \"\"\"Represents a mathematical fraction with a numerator and a denominator.\"\"\"\n        def __init__(self, numerator: int, denominator: int):\n            self._numerator = numerator\n            self._denominator = denominator\n\n        @property\n        def numerator(self) -> int:\n            return self._numerator\n\n        @property\n        def denominator(self) -> int:\n            return self._denominator\n\n        def __mul__(self, other: 'Fraction') -> 'Fraction':\n            \"\"\"Multiplies this fraction by another fraction.\"\"\"\n            new_numerator = self.numerator * other.numerator\n            new_denominator = self.denominator * other.denominator\n            return Fraction(new_numerator, new_denominator)\n\n        def is_whole_number(self) -> bool:\n            \"\"\"Checks if the fraction represents a whole number.\"\"\"\n            return self.numerator % self.denominator == 0\n\n        def simplify(self) -> 'Fraction':\n            \"\"\"Simplifies the fraction by dividing by their greatest common divisor.\"\"\"\n            common_divisor = math.gcd(self.numerator, self.denominator)\n            return Fraction(self.numerator // common_divisor, self.denominator // common_divisor)\n\n        def __repr__(self) -> str:\n            return f\"Fraction({self.numerator}/{self.denominator})\"\n\n    class FractionService:\n        \"\"\"Provides business logic for parsing fraction strings.\"\"\"\n        FRACTION_SEPARATOR = \"/\"\n\n        @staticmethod\n        def parse_fraction(fraction_str: str) -> Fraction:\n            \"\"\"Parses a string in 'numerator/denominator' format into a Fraction object.\"\"\"\n            parts = fraction_str.split(FractionService.FRACTION_SEPARATOR)\n            numerator = int(parts[0])\n            denominator = int(parts[1])\n            return Fraction(numerator, denominator)\n\n    fraction_x = FractionService.parse_fraction(x)\n    fraction_n = FractionService.parse_fraction(n)\n\n    product_fraction = fraction_x * fraction_n\n\n    return product_fraction.is_whole_number()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/149": [{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"\n    Filters a list of strings to include only even-length strings,\n    then sorts them by length ascending and alphabetically for ties.\n    \"\"\"\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n    sorted_result = sorted(even_length_strings, key=lambda s: (len(s), s))\n    return sorted_result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/146": [{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"Write a function that takes an array of numbers as input and returns \n    the number of elements in the array that are greater than 10 and both \n    first and last digits of a number are odd (1, 3, 5, 7, 9).\n    For example:\n    specialFilter([15, -73, 14, -15]) => 1 \n    specialFilter([33, -2, -3, 45, 21, 109]) => 2\n    \"\"\"\n    ODD_DIGITS = {1, 3, 5, 7, 9}\n\n    def is_digit_odd(digit):\n        return digit in ODD_DIGITS\n\n    def get_first_digit(num):\n        s_num = str(abs(num))\n        return int(s_num[0])\n\n    def get_last_digit(num):\n        s_num = str(abs(num))\n        return int(s_num[-1])\n\n    count = 0\n    for num in nums:\n        if num > 10:\n            first_digit = get_first_digit(num)\n            last_digit = get_last_digit(num)\n            if is_digit_odd(first_digit) and is_digit_odd(last_digit):\n                count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/148": [{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    PLANETS_ORDER = (\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupi