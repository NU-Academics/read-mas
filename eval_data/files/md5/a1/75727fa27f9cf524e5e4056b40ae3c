n memo:\n            return memo[k]\n\n        if k == 0:\n            result = 1\n        elif k == 1:\n            result = 3\n        elif k % 2 == 0:  # k is even\n            result = 1 + k // 2\n        else:  # k is odd\n            result = _calculate_term(k - 1) + _calculate_term(k - 2) + _calculate_term(k + 1)\n        \n        memo[k] = result\n        return result\n\n    sequence = []\n    for i in range(n + 1):\n        sequence.append(_calculate_term(i))\n    \n    return sequence", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/139": [{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n\n    def _factorial(k):\n        \"\"\"Calculates the standard factorial of a non-negative integer k.\"\"\"\n        if k == 0:\n            return 1\n        \n        result = 1\n        for i in range(1, k + 1):\n            result *= i\n        return result\n\n    special_fact_result = 1\n    for i in range(1, n + 1):\n        special_fact_result *= _factorial(i)\n    return special_fact_result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}]}}