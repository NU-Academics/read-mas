{"task_id": "Mbpp/65", "solution": "def recursive_list_sum(input_list: list) -> float:\n    \"\"\"\n    Flattens a list (potentially nested) and sums its numerical elements.\n    \"\"\"\n    total_sum = 0.0\n    for item in input_list:\n        if isinstance(item, list):\n            total_sum += recursive_list_sum(item)\n        elif isinstance(item, (int, float)):\n            total_sum += item\n    return total_sum"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(array: list) -> bool:\n    \"\"\"\n    Checks if the given array is monotonic (either increasing or decreasing).\n    An array with 0 or 1 element is considered monotonic.\n    \"\"\"\n    if len(array) <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(1, len(array)):\n        if array[i] < array[i-1]:\n            is_increasing = False\n        if array[i] > array[i-1]:\n            is_decreasing = False\n\n        # Optimization: If it's neither increasing nor decreasing, we can stop early.\n        if not is_increasing and not is_decreasing:\n            return False\n\n    return is_increasing or is_decreasing"}
{"task_id": "Mbpp/70", "solution": "def get_equal(list_of_tuples: list) -> bool:\n    \"\"\"\n    Checks if all tuples in a given list have identical lengths.\n    Handles empty and single-tuple lists as edge cases by returning True.\n    \"\"\"\n    if not list_of_tuples:\n        return True\n    if len(list_of_tuples) == 1:\n        return True\n\n    first_len = len(list_of_tuples[0])\n    for i in range(1, len(list_of_tuples)):\n        if len(list_of_tuples[i]) != first_len:\n            return False\n    return True"}
{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    \"\"\"Calculates the Bell number for a non-negative integer n.\n    Returns the number of ways to partition a set of n elements.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input n must be a non-negative integer.\")\n\n    if n == 0:\n        return 1\n\n    # dp_stirling[k] will store S(i, k), the Stirling number of the second kind, for the current row i.\n    # It is initialized to represent S(0,k): S(0,0)=1 and S(0,k)=0 for k>0.\n    dp_stirling = [0] * (n + 1)\n    dp_stirling[0] = 1 \n\n    # Iterate to compute S(i, k) for i from 1 to n\n    for i in range(1, n + 1):\n        # prev_s_val stores S(i-1, j-1) from the previous row/iteration.\n        # This is needed because dp_stirling[j-1] is updated before dp_stirling[j] is computed.\n        \n        # S(i, 0) is 0 for i > 0\n        prev_s_val = dp_stirling[0] # Holds S(i-1, 0) for the calculation of S(i,1)\n        dp_stirling[0] = 0\n\n        # Calculate S(i, j) using the recurrence S(i, j) = S(i-1, j-1) + j * S(i-1, j)\n        for j in range(1, i + 1):\n            current_s_val = dp_stirling[j] # This is S(i-1, j)\n            dp_stirling[j] = prev_s_val + j * current_s_val\n            prev_s_val = current_s_val # Store S(i-1, j) for the next iteration (to become S(i-1, (j+1)-1))\n\n    # The Bell number B_n is the sum of S(n, k) for k from 0 to n.\n    return sum(dp_stirling)"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list: list, sub_list: list) -> bool:\n    \"\"\"\n    Checks if a sub_list is present as a contiguous sequence of elements within the main_list.\n    \"\"\"\n    if not sub_list:\n        return True\n    if len(sub_list) > len(main_list):\n        return False\n\n    for i in range(len(main_list) - len(sub_list) + 1):\n        if main_list[i:i+len(sub_list)] == sub_list:\n            return True\n    return False"}
