{"task_id": "Mbpp/92", "solution": "def is_undulating(number: int) -> bool:\n    \"\"\"\n    Checks if the given number's digits strictly alternate between two distinct values.\n    For example, 1212121 is undulating (1 and 2 alternate).\n    \"\"\"\n    num_str = str(number)\n    n = len(num_str)\n\n    if n < 3:\n        return False\n\n    digit1 = num_str[0]\n    digit2 = num_str[1]\n\n    if digit1 == digit2:\n        return False\n\n    for i in range(2, n):\n        current_digit = num_str[i]\n        if i % 2 == 0:\n            if current_digit != digit1:\n                return False\n        else:\n            if current_digit != digit2:\n                return False\n\n    return True"}
{"task_id": "Mbpp/94", "solution": "def index_minimum(list_of_tuples: list[tuple[any, int]]) -> any:\n    \"\"\"\n    Returns the first value of the tuple with the smallest second value from a list of tuples.\n    The input list is assumed to be non-empty and contain valid tuples with comparable second values.\n    \"\"\"\n    min_second_value = list_of_tuples[0][1]\n    result_first_value = list_of_tuples[0][0]\n\n    for item in list_of_tuples[1:]:\n        current_first_value = item[0]\n        current_second_value = item[1]\n\n        if current_second_value < min_second_value:\n            min_second_value = current_second_value\n            result_first_value = current_first_value\n\n    return result_first_value"}
{"task_id": "Mbpp/95", "solution": "def Find_Min_Length(list_of_lists: list[list]) -> int:\n    \"\"\"\n    Calculates the length of the smallest list within a list of lists.\n    Returns 0 if the input list_of_lists is empty.\n    \"\"\"\n    if not list_of_lists:\n        return 0\n    min_len = float('inf')\n    for inner_list in list_of_lists:\n        min_len = min(min_len, len(inner_list))\n    return int(min_len)"}
{"task_id": "Mbpp/96", "solution": "def divisor(number: int) -> int:\n    \"\"\"\n    Calculates the number of positive divisors for a given integer.\n\n    Args:\n        number: The integer for which to find the number of divisors.\n\n    Returns:\n        An integer representing the count of positive divisors.\n\n    Raises:\n        ValueError: If the input 'number' is not an integer.\n    \"\"\"\n    if not isinstance(number, int):\n        raise ValueError(\"Input must be an integer.\")\n\n    if number == 0:\n        return 0\n\n    n = abs(number)\n    count = 0\n\n    for i in range(1, int(n**0.5) + 1):\n        if n % i == 0:\n            if i * i == n:\n                count += 1\n            else:\n                count += 2\n    return count"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(decimal_num: int) -> str:\n    \"\"\"Converts a non-negative decimal integer to its binary string equivalent.\n    The output string will not have leading zeros, except for input 0 which returns '0'.\n    \"\"\"\n    if decimal_num == 0:\n        return '0'\n\n    binary_str = []\n    while decimal_num > 0:\n        remainder = decimal_num % 2\n        binary_str.append(str(remainder))\n        decimal_num //= 2\n    \n    return \"\".join(binary_str[::-1])"}
{"task_id": "Mbpp/97", "solution": "from collections import Counter\nfrom typing import List, Any, Dict\n\ndef frequency_lists(list_of_lists: List[List[Any]]) -> Dict[Any, int]:\n    \"\"\"\n    Calculates the frequency of each element in a flattened list of lists.\n    Returns a dictionary mapping unique elements to their counts.\n    \"\"\"\n    flattened_list = [item for sublist in list_of_lists for item in sublist]\n    frequency_map = Counter(flattened_list)\n    return dict(frequency_map)"}
{"task_id": "Mbpp/98", "solution": "def multiply_num(numbers: list[float]) -> float:\n    \"\"\"\n    Computes the product of all numbers in the input list and divides by its length.\n    Raises ValueError if the input list is empty.\n    \"\"\"\n    if not numbers:\n        raise ValueError(\"Input list cannot be empty\")\n\n    product = 1.0\n    for num in numbers:\n        product *= num\n\n    return product / len(numbers)"}
