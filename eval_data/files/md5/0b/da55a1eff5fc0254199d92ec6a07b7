{"task_id": "Mbpp/71", "solution": "def comb_sort(input_list: list) -> list:\n    \"\"\"Sorts a list of elements using the Comb Sort algorithm.\n    Returns a new list with elements sorted in ascending order, leaving the original input list unchanged.\n    \"\"\"\n    data = list(input_list)\n    n = len(data)\n\n    if n <= 1:\n        return data\n\n    gap = n\n    shrink_factor = 1.3\n    swapped = True\n\n    while gap > 1 or swapped:\n        # Update the gap value using the shrink factor\n        gap = int(gap / shrink_factor)\n        if gap < 1:\n            gap = 1\n\n        swapped = False\n        \n        # Perform a single pass similar to bubble sort with the current gap\n        for i in range(n - gap):\n            if data[i] > data[i + gap]:\n                data[i], data[i + gap] = data[i + gap], data[i]\n                swapped = True\n                \n    return data"}
{"task_id": "Mbpp/74", "solution": "def is_samepatterns(strings, patterns):\n    \"\"\"\n    Checks if two lists follow the same structural pattern based on a bijective mapping.\n    Returns True if a consistent pattern is found, False otherwise.\n    \"\"\"\n    if len(strings) != len(patterns):\n        return False\n\n    string_to_pattern_map = {}\n    pattern_to_string_map = {}\n\n    for s, p in zip(strings, patterns):\n        # Validate string to pattern mapping\n        if s in string_to_pattern_map:\n            if string_to_pattern_map[s] != p:\n                return False\n        else:\n            string_to_pattern_map[s] = p\n\n        # Validate pattern to string mapping (bijective check)\n        if p in pattern_to_string_map:\n            if pattern_to_string_map[p] != s:\n                return False\n        else:\n            pattern_to_string_map[p] = s\n\n    return True"}
{"task_id": "Mbpp/75", "solution": "from typing import List, Tuple\n\ndef _is_tuple_divisible(t: Tuple[int, ...], k: int) -> bool:\n    \"\"\"Checks if all elements in a given tuple are divisible by k.\n    Returns True if all elements in the tuple are divisible by k, False otherwise.\n    \"\"\"\n    for element in t:\n        if element % k != 0:\n            return False\n    return True\n\ndef find_tuples(list_of_tuples: List[Tuple[int, ...]], k: int) -> List[Tuple[int, ...]]:\n    \"\"\"Finds tuples in a list where all elements are divisible by k.\n    Returns a new list containing only those tuples where all elements are divisible by k.\n    \"\"\"\n    if k == 0:\n        raise ZeroDivisionError(\"Divisor 'k' cannot be zero.\")\n\n    result = []\n    for t in list_of_tuples:\n        if _is_tuple_divisible(t, k):\n            result.append(t)\n    return result"}
