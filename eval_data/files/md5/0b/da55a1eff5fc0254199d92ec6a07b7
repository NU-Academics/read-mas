{"task_id": "Mbpp/4", "solution": "import heapq\n\ndef heap_queue_largest(numbers: list[int], n: int) -> list[int]:\n    \"\"\"\n    Finds the n largest integers from a given list of numbers.\n    The function validates inputs and uses heapq.nlargest for efficiency.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer.\")\n    if n > len(numbers):\n        raise ValueError(\"n cannot exceed the length of the numbers list.\")\n\n    return heapq.nlargest(n, numbers)"}
{"task_id": "Mbpp/2", "solution": "```python\nfrom typing import Collection as AbstractCollection, Any, Set\n\ndef similar_elements(collection1: AbstractCollection[Any], collection2: AbstractCollection[Any]) -> Set[Any]:\n    \"\"\"\n    Identifies and returns all unique elements common to two input collections.\n    Returns a new set containing unique elements present in both collection1 and collection2.\n    \"\"\"\n    set1 = set(collection1)\n    set2 = set(collection2)\n    return set1.intersection(set2)\n```"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(input_string: str) -> int:\n    \"\"\"\n    Calculates the minimum number of rotations (greater than 0) required to get the same string.\n    If no such rotation exists until the full length, returns the length of the string.\n    \"\"\"\n    n = len(input_string)\n    if n == 0:\n        return 1  # Or handle as an error/special case, based on problem requirements. For \"aaaa\" -> 1, implies 1 for trivial cases.\n    if n == 1:\n        return 1\n\n    for rotation_count in range(1, n):\n        rotated_string = input_string[rotation_count:] + input_string[:rotation_count]\n        if rotated_string == input_string:\n            return rotation_count\n    \n    # If no rotation (less than n) yields the original string, it means the string\n    # is aperiodic over its length, and 'n' rotations are required.\n    return n"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string: str, target_char: str) -> str:\n    \"\"\"Removes the first and last occurrences of a given character from a string.\n    Returns the original string if the character is not found or if target_char is not length 1.\n    \"\"\"\n    if len(target_char) != 1:\n        return input_string\n\n    first_idx = input_string.find(target_char)\n    last_idx = input_string.rfind(target_char)\n\n    if first_idx == -1:  # Character not found\n        return input_string\n\n    if first_idx == last_idx:  # Only one occurrence\n        return input_string[:first_idx] + input_string[first_idx + 1:]\n\n    # Remove last occurrence first to maintain valid index for the first occurrence\n    result = input_string[:last_idx] + input_string[last_idx + 1:]\n    # Remove first occurrence from the modified string\n    result = result[:first_idx] + result[first_idx + 1:]\n    return result"}
{"task_id": "Mbpp/12", "solution": "def sort_matrix(matrix: list[list[int]]) -> list[list[int]]:\n    \"\"\"\n    Sorts a given matrix in ascending order based on the sum of its rows.\n    \"\"\"\n    def _calculate_row_sum(row: list[int]) -> int:\n        \"\"\"\n        Calculates the sum of all integer elements within a single row.\n        \"\"\"\n        return sum(row)\n\n    # Create a list of (row_sum, original_row) tuples\n    rows_with_sums = []\n    for row in matrix:\n        row_sum = _calculate_row_sum(row)\n        rows_with_sums.append((row_sum, row))\n\n    # Sort the list of tuples based on the row_sum (the first element)\n    rows_with_sums.sort()\n\n    # Extract the sorted rows to form the new matrix\n    sorted_matrix = [row for row_sum, row in rows_with_sums]\n\n    return sorted_matrix"}
