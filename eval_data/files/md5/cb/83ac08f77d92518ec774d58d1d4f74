right move).\n            # We choose the path that gives the maximum sum up to this point.\n            dp_max_sum[r][c] = max(dp_max_sum[r-1][c], dp_max_sum[r][c-1]) + matrix[r][c]\n\n    # The maximum total sum to reach the bottom-right cell (N-1, N-1)\n    max_total_sum = dp_max_sum[N-1][N-1]\n\n    # The number of cells in any valid path\n    num_cells_in_path = (2 * N) - 1\n\n    # Calculate the maximum average\n    max_average = max_total_sum / num_cells_in_path\n\n    return max_average", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/723": [{"task_id": "Mbpp/723", "solution": "def count_same_pair(list_a, list_b):\n    \"\"\"\n    Counts indices where two lists have the same values.\n    Raises ValueError if lists have different lengths.\n    \"\"\"\n    len_a = len(list_a)\n    len_b = len(list_b)\n\n    if len_a != len_b:\n        raise ValueError(f\"List lengths differ: {len_a} != {len_b}\")\n\n    same_count = 0\n    for i in range(len_a):\n        if list_a[i] == list_b[i]:\n            same_count += 1\n            \n    return same_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/724": [{"task_id": "Mbpp/724", "solution": "def power_base_sum(base, power):\n    \"\"\"\n    Calculates the sum of all digits of the base raised to the specified power.\n    \"\"\"\n    result = base ** power\n    digit_sum = 0\n    for digit_char in str(result):\n        digit_sum += int(digit_char)\n    return digit_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/725": [{"task_id": "Mbpp/725", "solution": "import re\nfrom typing import List\ndef extract_quotation(input_string: str) -> List[str]:\n    \"\"\"\n    Extracts values enclosed in double quotation marks from the given string.\n    Returns an ordered list of the extracted substrings.\n    \"\"\"\n    return re.findall(r'\"([^\"]*)\"', input_string)"