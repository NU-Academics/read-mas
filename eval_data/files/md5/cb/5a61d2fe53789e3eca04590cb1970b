rn sorted(arr, key=_custom_sort_key)", "base_status": "fail", "plus_status": "pass", "base_fail_tests": [[[-2, -3, -4, -5, -6]]], "plus_fail_tests": []}], "HumanEval/119": [{"task_id": "HumanEval/119", "solution": "def _is_balanced(s: str) -> bool:\n    \"\"\"Checks if a parentheses string is balanced. It returns True if balanced, False otherwise.\"\"\"\n    balance = 0\n    for char in s:\n        if char == '(':\n            balance += 1\n        else: # Assumed to be ')' due to problem constraints\n            balance -= 1\n        if balance < 0:\n            return False\n    return balance == 0\ndef match_parens(lst):\n    \"\"\"\n    Checks if concatenating two parentheses strings in any order results in a balanced string.\n    Returns 'Yes' if a balanced string can be formed, 'No' otherwise.\n    \"\"\"\n    s1, s2 = lst[0], lst[1]\n\n    # Check s1 + s2 concatenation\n    concat1 = s1 + s2\n    is_balanced1 = _is_balanced(concat1)\n\n    # Check s2 + s1 concatenation\n    concat2 = s2 + s1\n    is_balanced2 = _is_balanced(concat2)\n\n    if is_balanced1 or is_balanced2:\n        return 'Yes'\n    else:\n        return 'No'", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/36": [{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    def _is_divisible_by_11_or_13(number: int) -> bool:\n        \"\"\"Check if a number is divisible by 11 or 13.\"\"\"\n        return (number % 11 == 0) or (number % 13 == 0)\n\n    def _count_digit_7(number: int) -> int:\n        \"\"\"Count occurrences of the digit '7' in a number.\"\"\"\n        return str(number).count('7')\n\n    total_sevens_count = 0\n    for number in range(1, n):\n        if _is_divisible_by_11_or_13(number):\n            total_sevens_count += _count_digit_7(number)\n    return total_sevens_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/123": [{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    \"\"\"\n    odd_numbers = set()\n    current_term = n\n\n    while current_term != 1:\n        if current_term % 2 != 0:\n            odd_numbers.add(current_term)\n            current_term = 3 * current_term + 1\n        else:\n            current_term = current_term // 2\n    \n    odd_numbers.add(1) # Ensure 1 is always included as it's the termination point and an odd number.\n    \n    return sorted(list(odd_numbers))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/122": [{"task_id": "HumanEval/122", "solution": "class IntegerElement:\n    \"\"\"Encapsulates an integer value and determines if it has at most two digits.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def get_value(self) -> int:\n        \"\"\"Returns the integer value.\"\"\"\n        return self._value\n\n    def has_at_most_two_digits(self) -> bool:\n        \"\"\"Checks if the absolute value of the element is less than 100.\"\"\"\n        return abs(self._value) < 100\nclass IntegerArray:\n    \"\"\"Manages a collection of IntegerElements, including length validation and indexed access.\"\"\"\n    def __init__(self, arr: list[int]):\n        self._validate_length(len(arr))\n        self._elements = [IntegerElement(val) for val in arr]\n        self._length = len(self._elements)\n\n    def _validate_length(self, length: int):\n        \"\"\"Validates the array length against NFR1 constraints.\"\"\"\n        if not (1 <= length <= 100):\n            raise ValueError(\"Array length must be between 1 and 100, inclusive.\")\n\n    def get_element(self, index: int) -> IntegerElement:\n        \"\"\"Returns the IntegerElement at the specified index.\"\"\"\n        return self._elements[index]\n\n    def get_length(self) -> int:\n        \"\"\"Returns the total number of elements in the array.\"\"\"\n        return self._length\nclass SumCalculator:\n    \"\"\"Orchestrates the sum calculation, including k validation, iteration, filtering, and aggregation.\"\"\"\n    def __init__(self, arr: list[int], k: int):\n        self._input_array = IntegerArray(arr)\n        self._validate_k(k, self._input_array.get_length())\n        self._k = k\n        self._current_sum = 0\n\n    def _validate_k(self, k: int, array_length: int):\n        \"\"\"Validates k against NFR2 constraints.\"\"\"\n        if not (1 <= k <= array_length):\n            raise ValueError(f\"k must be between 1 and the array length ({array_length}), inclusive.\")\n\n    def calculate_sum(self) -> int:\n        \"\"\"Performs the main calculation logic, iterating, filtering, and summing elements.\"\"\"\n        for i in range(self._k):\n            element = self._input_array.get_element(i)\n            if element.has_at_most_two_digits():\n                self._current_sum += element.get_value()\n        return self._current_sum\ndef add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    \"\"\"\n    calculator = SumCalculator(arr, k)\n    return calculator.calculate_sum()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/120": [{"task_id": "HumanEval/120", "solution": "def maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list \n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    if k == 0:\n        return []\n\n    # Sort the array in descending order to easily pick the largest elements.\n    arr.sort(reverse=True)\n    \n    # Take the first k elements, which are the k largest.\n    k_largest = arr[:k]\n    \n    # Sort the resulting list in ascending order as required.\n    k_largest.sort()\n\n    return k_largest", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/124": [{"task_id": "HumanEval/124", "solution": "def valid_date(date):\n    \"\"\"Validates a given date string based on predefined rules.\"\"\"\n\n    def _is_not_empty(date_string: str) -> bool:\n        \"\"\"Checks if the date string is not empty.\"\"\"\n        return bool(date_string)\n\n    def _parse_and_validate_format(date_string: str) -> tuple[bool, int, int, int]:\n        \"\"\"Validates 'mm-dd-yyyy' format and parses components.\"\"\"\n        if len(date_string) != 10:\n            return False, 0, 0, 0\n        if date_string[2] != '-' or date_string[5] != '-':\n            return False, 0, 0, 0\n        \n        parts = date_string.split('-')\n        if len(parts) != 3:\n            return False, 0, 0, 0\n        \n        # Ensure 'mm', 'dd', 'yyyy' parts have correct string lengths\n        if len(parts[0]) != 2 or len(parts[1]) != 2 or len(parts[2]) != 4:\n            return False, 0, 0, 0\n\n        try:\n            month = int(parts[0])\n            day = int(parts[1])\n            year = int(parts[2])\n        except ValueError:\n            return False, 0, 0, 0\n            \n        return True, month, day, year\n\n    def _is_month_range_valid(month: int) -> bool:\n        \"\"\"Validates if the month is between 1 and 12.\"\"\"\n        return 1 <= month <= 12\n\n    def _is_day_range_valid(day: int, month: int) -> bool:\n        \"\"\"Validates if the day is within the correct range for the given month.\"\"\"\n        if not (1 <= day):\n            return False\n\n        if month in {1, 3, 5, 7, 8, 10, 12}:\n            return day <= 31\n        elif month in {4, 6, 9, 11}:\n            return day <= 30\n        elif month == 2:\n            return day <= 29 # Max 29 days for February, no leap year check required by rules.\n        else:\n            return False # Should not be reached if _is_month_range_valid passed.\n\n    # Apply validation rules in sequence\n    if not _is_not_empty(date):\n        return False\n\n    is_format_valid, month, day, year = _parse_and_validate_format(date)\n    if not is_format_valid:\n        return False\n\n    if not _is_month_range_valid(month):\n        return False\n\n    if not _is_day_range_valid(day, month):\n        return False\n\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/125": [{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    Examples\n    split_words(\"Hello world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"Hello,world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"abcdef\") == 3 \n    '''\n    def _has_whitespace(text: str) -> bool:\n        \"\"\"Checks if the text contains any whitespace characters.\"\"\"\n        return any(c.isspace() for c in text)\n\n    def _has_comma(text: str) -> bool:\n        \"\"\"Checks if the text contains any comma characters.\"\"\"\n        return ',' in text\n\n    def _count_odd_ordered_lowercase_letters(text: str) -> int:\n        \"\"\"Counts lowercase letters with an odd 0-indexed alphabetical order.\"\"\"\n        count = 0\n        for char in text:\n            if 'a' <= char <= 'z':\n                alphabetical_order = ord(char) - ord('a')\n                if alphabetical_order % 2 != 0:\n                    count += 1\n        return count\n