er(value):\n    \"\"\"\n    Returns the closest integer to a number represented by a string,\n    rounding away from zero if equidistant from two integers.\n    \"\"\"\n    num = float(value)\n    if num >= 0:\n        # For positive numbers, add 0.5 and truncate to effectively round half up.\n        # This rounds X.5 to X+1.\n        return int(num + 0.5)\n    else:\n        # For negative numbers, subtract 0.5 and truncate to effectively round half down.\n        # This rounds -X.5 to -(X+1).\n        return int(num - 0.5)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/93": [{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by swapping letter cases and replacing vowels.\n    Non-alphabetic characters are retained as is.\n    \"\"\"\n    _ALPHABET_LOWER = \"abcdefghijklmnopqrstuvwxyz\"\n    _ALPHABET_UPPER = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"\n    _VOWELS_LOWER = \"aeiou\"\n    _VOWELS_UPPER = \"AEIOU\"\n\n    def _is_english_letter(char):\n        \"\"\"Determines if a character is an English alphabet letter.\"\"\"\n        return char.isalpha()\n\n    def _is_vowel(char):\n        \"\"\"Determines if a character is an English alphabet vowel (case-insensitive check).\"\"\"\n        return char in _VOWELS_LOWER or char in _VOWELS_UPPER\n\n    def _get_two_places_ahead(char):\n        \"\"\"Replaces a vowel with the letter two positions forward, preserving case.\"\"\"\n        is_upper = char.isupper()\n        alphabet = _ALPHABET_UPPER if is_upper else _ALPHABET_LOWER\n        index = alphabet.find(char)\n        new_index = (index + 2) % len(alphabet)\n        return alphabet[new_index]\n\n    def _swap_case(char):\n        \"\"\"Swaps the case of an English alphabet letter.\"\"\"\n        return char.swapcase()\n\n    encoded_message_chars = []\n    for char in message:\n        if _is_english_letter(char):\n            processed_char = char\n            if _i