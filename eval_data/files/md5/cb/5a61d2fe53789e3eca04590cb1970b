special cases: x != 0, 1; n != 0, 1.\n    # This implies abs(x) > 0 and abs(n) > 0.\n    # Also abs(n) != 1.\n\n    TOLERANCE = 1e-9  # Tolerance for floating point comparisons\n\n    # Case: n is negative\n    if n < 0:\n        # If n is negative, for n**k = x (where k is an integer),\n        # if x is positive, k must be an even integer.\n        # if x is negative, k must be an odd integer.\n        \n        # We calculate the potential exponent using absolute values.\n        # Both abs(x) and abs(n) are strictly positive and abs(n) != 1 at this point.\n        exponent = math.log(abs(x), abs(n))\n        \n        # Check if the calculated exponent is very close to an integer.\n        if abs(exponent - round(exponent)) < TOLERANCE:\n            k_int = round(exponent)\n            if x > 0: # If x is positive, the exponent k must be even.\n                return k_int % 2 == 0\n            else: # If x is negative, the exponent k must be odd.\n                return k_int % 2 != 0\n        return False # The exponent is not an integer.\n    \n    # Case: n is positive (and n != 1).\n    # Also, x is not 0 or 1.\n    \n    # If x is negative and n is positive, n**k can never be x for any real k.\n    # (Positive base raised to any power results in a positive number).\n    if x < 0:\n        return False\n        \n    # Now: x > 0 (and x != 1); n > 0 (and n != 1).\n    # Use logarithm to find k: k = log_n(x).\n    exponent = math.log(x, n)\n    \n    # Check if the exponent is an integer within a small tolerance.\n    return abs(exponent - round(exponent)) < TOLERANCE", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[4722366482869645213695, 4722366482869645213696]]}], "HumanEval/78": [{"task_id": "HumanEval/78", "solution": "_PRIME_HEX_DIGITS = {'2', '3', '5', '7', 'B', 'D'}\ndef _is_hex_digit_prime(digit_char: str) -> bool:\n    \"\"\"Checks if a given hexadecimal character is one of the predefined prime digits.\"\"