lit on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    Examples\n    split_words(\"Hello world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"Hello,world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"abcdef\") == 3\n    '''\n    if _has_whitespace(txt):\n        return txt.split()\n    elif _has_comma(txt):\n        return txt.split(',')\n    else:\n        return _count_odd_ordered_lowercase(txt)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/124": [{"task_id": "HumanEval/124", "solution": "def valid_date(date):\n    \"\"\"\n    Validates a date string against predefined rules for format (mm-dd-yyyy) and date ranges.\n    Returns True if the date is valid, False otherwise.\n    \"\"\"\n    \n    # FR1: The system shall validate that the input date string is not empty.\n    if not date:\n        return False\n\n    # Define constants for days in months, inlined as per critical requirements.\n    DAYS_IN_MONTH = {\n        1: 31, 2: 29, 3: 31, 4: 30, 5: 31, 6: 30,\n        7: 31, 8: 31, 9: 30, 10: 31, 11: 30, 12: 31\n    }\n\n    # FR2: The system shall validate that the date string adheres to the 'mm-dd-yyyy' format.\n    # This try-except block also handles non-string inputs and non-numeric components implicitly.\n    try:\n        parts = date.split('-')\n        if len(parts) != 3:\n            return False\n        \n        month_str, day_str, year_str = parts\n        \n        # Ensure month and day are exactly two digits, and year is exactly four digits.\n        if not (len(month_str) == 2 and len(day_str) == 2 and len(year_str) == 4):\n            return False\n\n        month = int(month_str)\n        day = int(day_str)\n        year = int(year_str) # The year value is extracted but not fu