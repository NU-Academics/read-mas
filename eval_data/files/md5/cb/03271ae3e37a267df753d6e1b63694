\n    Provides utility methods for processing text.\n    Splits text into sentences and checks if a sentence starts with \"I\".\n    \"\"\"\n    def split_into_sentences(self, text: str) -> list[str]:\n        \"\"\"\n        Splits a given text into a list of individual sentences.\n        Sentences are delimited by '.', '?' or '!'.\n        \"\"\"\n        if not text:\n            return []\n        # Split by '.', '?', '!' followed by optional whitespace\n        sentences = re.split(r'[.?!]\\s*', text)\n        # Filter out empty strings that might result from splitting\n        return [s.strip() for s in sentences if s.strip()]\n\n    def starts_with_i(self, sentence: str) -> bool:\n        \"\"\"\n        Checks if a given sentence starts with the word \"I\".\n        Ignores leading/trailing whitespace and case.\n        \"\"\"\n        if not sentence:\n            return False\n        # Split the sentence into words and check the first word\n        words = sentence.strip().split()\n        if not words:\n            return False\n        return words[0].lower() == \"i\"\nclass BoredomDetector:\n    \"\"\"\n    Orchestrates the process of detecting and counting \"boredoms\" in a text.\n    A boredom is a sentence that starts with the word \"I\".\n    \"\"\"\n    def __init__(self):\n        self.text_processor = TextProcessor()\n\n    def is_bored(self, text: str) -> int:\n        \"\"\"\n        Takes an input string, splits it into sentences, and counts\n        how many of those sentences start with the word \"I\".\n        \"\"\"\n        boredom_count = 0\n        sentences = self.text_processor.split_into_sentences(text)\n        for sentence in sentences:\n            if self.text_processor.starts_with_i(sentence):\n                boredom_count += 1\n        return boredom_count\ndef is_bored(S: str) -> int:\n    \"\"\"\n    Counts \"boredoms\" in a given string `S`.\n    A boredom is a sentence starting with the word \"I\", delimited by '.', '?' or '!'.\n    \"\"\"\n    detector = BoredomDetector()\n    return detector.is_bored(S)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["I"]]}, {"task_id": "HumanEval/91", "solution": "import re\ndef is_bored(S):\n    \"\"\"\n    You'll be given a string of words, and your task is to count the number\n    of boredoms. A boredom is a sentence that starts with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n   \n    For example:\n    >>> is_bored(\"Hello world\")\n    0\n    >>> is_bored(\"The sky is blue. The sun is shining. I love this weather\")\n    1\n    \"\"\"\n    DELIMITERS = ['.', '?', '!']\n\n    def _split_into_sentences(text: str) -> list[str]:\n        # Splits the text into sentences using regex to handle multiple delimiters.\n        # Escapes delimiters to ensure they are treated as literal characters in regex.\n        delimiter_pattern = '[' + ''.join(re.escape(d) for d in DELIMITERS) + ']+'\n        \n        raw_sentences = re.split(delimiter_pattern, text)\n        sentences = [s.strip() for s in raw_sentences if s.strip()]\n        return sentences\n\n    def _starts_with_i(sentence: str) -> bool:\n        # Checks if a sentence starts with \"I\" (case-insensitive) after stripping whitespace.\n        cleaned_sentence = sentence.strip()\n        if not cleaned_sentence:\n            return False\n        \n        match = re.match(r\"^\\s*(\\w+)\", cleaned_sentence)\n        if match:\n            first_word = match.group(1)\n            return first_word.lower() == \"i\"\n        return False\n\n    boredom_count = 0\n    sentences = _split_into_sentences(S)\n    for sentence in sentences:\n        if _starts_with_i(sentence):\n            boredom_count += 1\n    return boredom_count", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["I"]]}], "HumanEval/93": [{"task_id": "HumanEval/93", "solution": "VOWELS = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 