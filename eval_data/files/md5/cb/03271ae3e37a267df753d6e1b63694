umanEval/105": [{"task_id": "HumanEval/105", "solution": "def by_length(arr):\n    \"\"\"\n    Given an array of integers, sort the integers that are between 1 and 9 inclusive,\n    reverse the resulting array, and then replace each digit by its corresponding name.\n    \"\"\"\n\n    # Define constants within the function scope for self-containment.\n    DIGIT_TO_WORD_MAP = {\n        1: \"One\",\n        2: \"Two\",\n        3: \"Three\",\n        4: \"Four\",\n        5: \"Five\",\n        6: \"Six\",\n        7: \"Seven\",\n        8: \"Eight\",\n        9: \"Nine\"\n    }\n    MIN_VALID_DIGIT = 1\n    MAX_VALID_DIGIT = 9\n\n    # Define utility function within the function scope.\n    def is_valid_digit(num: int) -> bool:\n        \"\"\"Checks if a given number is a valid digit (1-9 inclusive).\"\"\"\n        return MIN_VALID_DIGIT <= num <= MAX_VALID_DIGIT\n\n    # Define DigitMapper class within the function scope.\n    class DigitMapper:\n        \"\"\"Maps single-digit integers to their English word names.\"\"\"\n        def __init__(self):\n            self._digit_to_word_map = DIGIT_TO_WORD_MAP\n\n        def get_word(self, digit: int) -> str:\n            \"\"\"Returns the word name for a given digit.\"\"\"\n            return self._digit_to_word_map[digit]\n\n    # Define NumberProcessor class within the function scope.\n    class NumberProcessor:\n        \"\"\"Processes an array of integers through filtering, sorting, reversing, and word conversion.\"\"\"\n        def __init__(self):\n            self._digit_mapper = DigitMapper()\n\n        def process_array(self, arr: list[int]) -> list[str]:\n            \"\"\"Main method to process the input array.\"\"\"\n            if not arr:\n                return []\n\n            filtered_sorted = self._filter_and_sort(arr)\n            if not filtered_sorted:\n                return []\n\n            reversed_array = self._reverse_array(filtered_sorted)\n            word_array = self._map_to_words(reversed_