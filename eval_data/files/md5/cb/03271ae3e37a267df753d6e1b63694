0, -1), (1, 0), (-1, 0)]\n        for dr, dc in directions:\n            n_row, n_col = row + dr, col + dc\n            if 0 <= n_row < self._N and 0 <= n_col < self._N:\n                neighbors.append((n_row, n_col))\n        return neighbors\n\n    def get_N(self) -> int:\n        return self._N\nclass PathFinder:\n    \"\"\"Implements dynamic programming to find the lexicographically smallest path of length k.\"\"\"\n    def __init__(self, grid: Grid, k: int) -> None:\n        self._grid = grid\n        self._k = k\n        self._N = grid.get_N()\n        self._dp_current_layer: dict[tuple[int, int], list[int]] = {}\n        self._dp_prev_layer: dict[tuple[int, int], list[int]] = {}\n\n    def find_min_path(self) -> list[int]:\n        # Initialize paths of length 1 for all cells.\n        for r in range(self._N):\n            for c in range(self._N):\n                self._dp_prev_layer[(r, c)] = [self._grid.get_value(r, c)]\n\n        # Iterate for path lengths from 2 up to k.\n        for length in range(2, self._k + 1):\n            self._dp_current_layer = {}\n            for r in range(self._N):\n                for c in range(self._N):\n                    current_cell_value = self._grid.get_value(r, c)\n                    min_path_for_current_cell: list[int] | None = None\n\n                    for nr, nc in self._grid.get_neighbors(r, c):\n                        if (nr, nc) in self._dp_prev_layer:\n                            prev_path = self._dp_prev_layer[(nr, nc)]\n                            candidate_path = prev_path + [current_cell_value]\n\n                            if min_path_for_current_cell is None or \\\n                               lexicographical_compare(candidate_path, min_path_for_current_cell) == -1:\n                                min_path_for_current_cell = candidate_path\n                    \n                    if min_path_for_current_cell is not None:\n                        self._dp_current_layer[(r, c)] = min_path_for_current_cell\n            \n            # Update previous layer for the next iteration.\n            self._dp_prev_layer = self._dp_current_layer\n\n        # Find the overall lexicographically smallest path among all paths of length k.\n        overall_min_path: list[int] | None = None\n        for path in self._dp_prev_layer.values():\n            if overall_min_path is None or lexicographical_compare(path, overall_min_path) == -1:\n                overall_min_path = path\n        \n        return overall_min_path if overall_min_path is not None else []\ndef minPath(grid: list[list[int]], k: int) -> list[int]:\n    \"\"\"Finds the lexicographically smallest path of specified length k in the grid.\n    Starts from any cell and moves to adjacent neighbors.\"\"\"\n    grid_obj = Grid(grid)\n    path_finder = PathFinder(grid_obj, k)\n    return path_finder.find_min_path()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/129", "solution": "import heapq\ndef minPath(grid: list[list[int]], k: int) -> list[int]:\n    \"\"\"\n    Finds the lexicographically smallest path of length k in a given grid.\n    Movement is restricted to adjacent cells (up, down, left, right).\n    \"\"\"\n\n    class Utils:\n        \"\"\"Provides utility functions for grid operations.\"\"\"\n        @staticmethod\n        def is_valid_coord(N: int, r: int, c: int) -> bool:\n            return 0 <= r < N and 0 <= c < N\n\n        @staticmethod\n        def get_neighbors(N: int, r: int, c: int) -> list[tuple[int, int]]:\n            neighbors = []\n            moves = [(-1, 0), (1, 0), (0, -1), (0, 1)] \n            for dr, dc in moves:\n                nr, nc = r + dr, c + dc\n                if Utils.is_valid_coord(N, nr, nc):\n                    neighbors.append((nr, nc))\n            return neighbors\n\n    class Grid:\n        \"\"\"Encapsulates grid data and provides safe access to its values.\"\"\"\n        def __init__(self, grid_data: list[list[int]]):\n            self._data = grid_data\n            self._N = len(grid_data)\n\n        def get_value(self, row: int, col: int) -> int:\n            return self._data[row][col]\n\n        def get_N(self) -> int:\n            return self._N\n\n    class Path:\n        \"\"\"Represents a sequence of cell values and supports lexicographical comparison.\"\"\"\n        def __init__(self, initial_values: list[int] = None):\n            self._values = list(initial_values) if initial_values is not None else []\n\n        def add_value(self, value: int) -> None:\n            self._values.append(value)\n\n        def get_values(self) -> list[int]:\n            return list(self._values) \n\n        def get_length(self) -> int:\n            return len(self._values)\n\n        def __lt__(self, other: 'Path') -> bool:\n            return self._values < other._values\n\n        def __eq__(self, other: 'Path') -> bool:\n            return self._values == other._values\n\n        def __hash__(self) -> int:\n            return hash(tuple(self._values))\n\n    class PathFinderService:\n        \"\"\"Orchestrates the pathfinding algorithm using a Dijkstra-like approach.\"\"\"\n        def find_min_path(self, grid_data: list[list[int]], k: int) -> list[int]:\n            grid = Grid(grid_data)\n            return self._explore_paths(grid, k)\n\n        def _explore_paths(self, grid: Grid, k: int) -> list[int]:\n            N = grid.get_N()\n            pq = [] # Priority queue: (path_tuple, row, col, length)\n            \n            # Stores the lexicographically smallest Path object found for each state (row, col, length).\n            min_paths_at_cell_length = {} \n\n            for r in range(N):\n                for c in range(N):\n                    initial_path = Path([grid.get_value(r, c)])\n                    heapq.heappush(pq, (tuple(initial_path.get_values()), r, c, 1))\n                    min_paths_at_cell_length[(r, c, 1)] = initial_path\n            \n            min_overall_path: Path = None\n\n            while pq:\n                current_path_values_tuple, r, c, current_length = heapq.heappop(pq)\n                current_path_obj = Path(list(current_path_values_tuple))\n\n                # If a lexicographically smaller path to this state has already been processed, skip.\n                if current_path_obj != min_paths_at_cell_length.get((r, c, current_length)):\n                    continue\n\n                if current_length == k:\n                    if min_overall_path is None or current_path_obj < min_overall_path:\n                        min_overall_path = current_path_obj\n                    continue \n\n                if current_length < k:\n                    for nr, nc in Utils.get_neighbors(N, r, c):\n                        new_path_values = current_path_obj.get_values() + [grid.get_value(nr, nc)]\n                        new_path_obj = Path(new_path_values)\n                        new_length = current_length + 1\n\n                        if (nr, nc, new_length) not in min_paths_at_cell_length or \\\n                           new_path_obj < min_paths_at_cell_length[(nr, nc, new_length)]:\n                            min_paths_at_cell_length[(nr, nc, new_length)] = new_path_obj\n                            heapq.heappush(pq, (tuple(new_path_obj.get_values()), nr, nc, new_length))\n            \n            return min_overall_path.get_values()\n\n    service = PathFinderService()\n    return service.find_min_path(grid, k)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/135": [{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"Returns the largest index of an element which is not greater than or equal\n    to the element immediately preceding it. If no such element exists then return -1.\n    \"\"\"\n    largest_invalid_index = -1\n    if len(arr) < 2:\n        return largest_invalid_index\n\n   