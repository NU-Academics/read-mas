, "solution": "def starts_one_ends(n):\n    \"\"\"\n    Calculates the count of n-digit positive integers that start or end with 1.\n    Assumes n is a positive integer.\n    \"\"\"\n    if n == 1:\n        return 1\n\n    # Count of n-digit numbers that start with 1.\n    # The first digit is fixed as 1. The remaining n-1 digits can be any from 0-9.\n    count_starts_with_1 = 10**(n - 1)\n\n    # Count of n-digit numbers that end with 1.\n    # The first digit cannot be 0 (9 choices), the last digit is fixed as 1.\n    # The n-2 middle digits can be any from 0-9.\n    count_ends_with_1 = 9 * (10**(n - 2))\n\n    # Count of n-digit numbers that start AND end with 1.\n    # The first and last digits are fixed as 1. The n-2 middle digits can be any from 0-9.\n    count_starts_and_ends_with_1 = 10**(n - 2)\n\n    # Apply the principle of inclusion-exclusion: |A U B| = |A| + |B| - |A intersection B|\n    return count_starts_with_1 + count_ends_with_1 - count_starts_and_ends_with_1", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/130": [{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Calculates the Tribonacci sequence up to the nth term.\n    Returns a list of the first n + 1 Tribonacci numbers.\"\"\"\n    \n    memo = {}\n\n    def _get_single_tribonacci(k: int) -> float:\n        \"\"\"Helper to compute an individual Tribonacci number using memoization.\"\"\"\n        if k in memo:\n            return memo[k]\n\n        if k == 0:\n            result = 1.0\n        elif k == 1:\n            result = 3.0\n        elif k % 2 == 0:  # k is even and > 1\n            result = 1.0 + k / 2.0\n        else:  # k is odd and > 1\n            result = (\n                _get_single_tribonacci(k - 1)\n                + _get_single_tribonacci(k - 2)\n                + _get_single_tribonacci(k + 1)\n            )\n        memo[k] = result\n        return result\n\n    sequence = []\n    for i in range(n + 1):