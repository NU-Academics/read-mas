ix'\n    \"\"\"\n    SHIFT_AMOUNT = 4\n    ALPHABET_SIZE = 26\n    encrypted_chars = []\n\n    for char in s:\n        if 'a' <= char <= 'z':\n            # Calculate 0-indexed position, shift, wrap around, then convert back to char\n            start_code = ord('a')\n            shifted_code = start_code + (ord(char) - start_code + SHIFT_AMOUNT) % ALPHABET_SIZE\n            encrypted_chars.append(chr(shifted_code))\n        elif 'A' <= char <= 'Z':\n            # Same logic for uppercase letters\n            start_code = ord('A')\n            shifted_code = start_code + (ord(char) - start_code + SHIFT_AMOUNT) % ALPHABET_SIZE\n            encrypted_chars.append(chr(shifted_code))\n        else:\n            # Non-alphabetic characters remain unchanged\n            encrypted_chars.append(char)\n\n    return \"\".join(encrypted_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string using a rotational cipher, shifting alphabetic characters down by 4 places. Non-alphabetic characters remain unchanged.\"\"\"\n    encrypted_chars = []\n    SHIFT_AMOUNT = 4  # The shift amount is fixed at 4 positions.\n\n    for char in s:\n        if 'a' <= char <= 'z':\n            start = ord('a')\n            shifted_char = chr(start + (ord(char) - start + SHIFT_AMOUNT) % 26)\n        elif 'A' <= char <= 'Z':\n            start = ord('A')\n            shifted_char = chr(start + (ord(char) - start + SHIFT_AMOUNT) % 26)\n        else:\n            shifted_char = char  # Non-alphabetic characters remain unchanged.\n        encrypted_chars.append(shifted_char)\n    return \"\".join(encrypted_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/88": [{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting.\n    Sorts based on the parity of the sum of its first and last elements.\n    \"\"\"\n    if not array:\n        return []\n\n    if len(array) == 1:\n        return list(array)\n\n    copied_array = list(array)\n\n    sum_first_last = copied_array[0] + copied_array[-1]\n    \n    if sum_first_last % 2 != 0:\n        copied_array.sort()\n    else:\n        copied_array.sort(reverse=True)\n            \n    return copied_array", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n\n    Note:\n    * don't change the given array.\n    \"\"\"\n    copied_array = list(array)\n\n    if not copied_array or len(copied_array) == 1:\n        return copied_array\n\n    first_element = copied_array[0]\n    last_element = copied_array[-1]\n    sum_first_last = first_element + last_element\n\n    if sum_first_last % 2 != 0:\n        return sorted(copied_array)\n    else:\n        return sorted(copied_array, reverse=True)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/90": [{"task_id": "HumanEval/90", "solution": "def next_smallest(lst):\n    \"\"\"\n    Returns the 2nd smallest unique element of the list.\n    Returns None if there is no such element.\n    \"\"\"\n    if not lst:\n        return None\n\n    unique_elements = sorted(list(set(lst)))\n\n    if len(unique_elements) < 2:\n        return None\n    else:\n        return unique_elements[1]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/90", "solution": "def next_sm