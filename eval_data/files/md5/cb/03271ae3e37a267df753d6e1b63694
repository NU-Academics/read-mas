 None\ndef _is_prime_helper(n):\n    \"\"\"Checks if a number is prime.\"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\ndef intersection(interval1, interval2):\n    \"\"\"\n    Determines if the length of the intersection of two intervals is a prime number.\n    Returns \"YES\" if prime, \"NO\" otherwise or if no intersection.\n    \"\"\"\n    int1_obj = Interval(interval1[0], interval1[1])\n    int2_obj = Interval(interval2[0], interval2[1])\n\n    intersect_interval = _calculate_intersection_helper(int1_obj, int2_obj)\n\n    if intersect_interval is None:\n        return \"NO\"\n\n    length = intersect_interval.get_length()\n    if _is_prime_helper(length):\n        return \"YES\"\n    else:\n        return \"NO\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/127", "solution": "import math\nfrom typing import Tuple, Optional\ndef is_prime(n: int) -> bool:\n    \"\"\"Determines if a non-negative integer is a prime number.\n    Uses trial division up to the square root of n.\"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        if n % i == 0:\n            return False\n    return True\ndef _calculate_intersection_coords(i1: Tuple[int, int], i2: Tuple[int, int]) -> Optional[Tuple[int, int]]:\n    \"\"\"Calculates the intersection of two closed integer intervals.\n    Returns the intersection as a tuple (start, end) or None if no intersection.\"\"\"\n    start1, end1 = i1\n    start2, end2 = i2\n\n    max_start = max(start1, start2)\n    min_end = min(end1, end2)\n\n    if max_start <= min_end:\n        return (max_start, min_end)\n    return None\n