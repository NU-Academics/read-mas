{"task_id": "HumanEval/25", "solution": "from typing import List\n\n\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    factors = []\n    d = 2\n    temp_n = n\n\n    while d * d <= temp_n:\n        while temp_n % d == 0:\n            factors.append(d)\n            temp_n //= d\n        d += 1\n\n    if temp_n > 1:\n        factors.append(temp_n)\n        \n    return factors"}
{"task_id": "HumanEval/27", "solution": "def flip_case(string: str) -> str:\n    \"\"\" For a given string, flip lowercase characters to uppercase and uppercase to lowercase.\n    >>> flip_case('Hello')\n    'hELLO'\n    \"\"\"\n    flipped_chars = []\n    for char in string:\n        if 'a' <= char <= 'z':  # Check if character is lowercase\n            flipped_chars.append(char.upper())\n        elif 'A' <= char <= 'Z':  # Check if character is uppercase\n            flipped_chars.append(char.lower())\n        else:  # Preserve non-alphabetic characters\n            flipped_chars.append(char)\n    return \"\".join(flipped_chars)"}
{"task_id": "HumanEval/29", "solution": "from typing import List\n\n\ndef filter_by_prefix(strings: List[str], prefix: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that start with a given prefix.\n    >>> filter_by_prefix([], 'a')\n    []\n    >>> filter_by_prefix(['abc', 'bcd', 'cde', 'array'], 'a')\n    ['abc', 'array']\n    \"\"\"\n    filtered_strings = []\n    for s in strings:\n        if s.startswith(prefix):\n            filtered_strings.append(s)\n    return filtered_strings"}
{"task_id": "HumanEval/31", "solution": "import math\n\ndef is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    \n    # Check for odd divisors from 3 up to the square root of n\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        if n % i == 0:\n            return False\n            \n    return True"}
{"task_id": "HumanEval/26", "solution": "from typing import List, Dict\n\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    >>> remove_duplicates([1, 2, 3, 2, 4])\n    [1, 3, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    # Count occurrences of each number.\n    counts: Dict[int, int] = {}\n    for num in numbers:\n        counts[num] = counts.get(num, 0) + 1\n\n    # Build the result list, including only numbers that appeared exactly once.\n    result: List[int] = []\n    for num in numbers:\n        if counts[num] == 1:\n            result.append(num)\n\n    return result"}
{"task_id": "HumanEval/32", "solution": "import math\n\n\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\n\n\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    # Bisection method for root finding. The problem guarantees an odd-degree polynomial,\n    # which always has at least one real root.\n\n    tolerance = 1e-7  # Desired precision for the root.\n    max_bisection_iterations = 200  # Max iterations for the bisection loop.\n\n    # Step 1: Find an initial interval [low, high] that brackets a root.\n    # Start with a small interval and expand it exponentially until poly(low) and poly(high) have opposite signs.\n    low = -1.0\n    high = 1.0\n    f_low = poly(xs, low)\n    f_high = poly(xs, high)\n\n    # Check if initial bounds are roots.\n    if abs(f_low) < tolerance:\n        return low\n    if abs(f_high) < tolerance:\n        return high\n\n    # Expand the interval until a root is bracketed, or maximum expansion attempts are reached.\n    max_expansion_bound = 1e12  # Limit for absolute values of low/high to prevent overflow.\n    expansion_attempts = 0\n    max_expansion_attempts = 100 # Safety against infinite loop for peculiar cases.\n\n    while (f_low * f_high > 0) and (expansion_attempts < max_expansion_attempts):\n        low *= 2.0\n        high *= 2.0\n        \n        f_low = poly(xs, low)\n        f_high = poly(xs, high)\n\n        if abs(f_low) < tolerance:\n            return low\n        if abs(f_high) < tolerance:\n            return high\n\n        # If bounds become too large, break.\n        if abs(low) > max_expansion_bound or abs(high) > max_expansion_bound:\n            break\n        expansion_attempts += 1\n\n\n    # Step 2: Perform bisection once a bracket is found.\n    for _ in range(max_bisection_iterations):\n        mid = (low + high) / 2.0\n        f_mid = poly(xs, mid)\n\n        # Check if mid is the root or interval is sufficiently small.\n        if abs(f_mid) < tolerance or (high - low) < tolerance * 2:\n            return mid\n\n        # Update the interval (low, high) and corresponding function values (f_low, f_high).\n        if f_low * f_mid < 0: # Root is in [low, mid].\n            high = mid\n            f_high = f_mid\n        else: # Root is in [mid, high].\n            low = mid\n            f_low = f_mid\n            \n    # If max_bisection_iterations reached, return the midpoint of the final interval.\n    # This will be sufficiently close to a root.\n    return (low + high) / 2.0"}
