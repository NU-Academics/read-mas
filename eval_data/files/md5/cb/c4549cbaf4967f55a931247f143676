{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    if not l:\n        return []\n\n    # Extract elements from even indices.\n    even_elements = [l[i] for i in range(0, len(l), 2)]\n\n    # Sort the extracted even elements.\n    sorted_even_elements = sorted(even_elements)\n\n    # Reconstruct the list, placing sorted even elements back into their original even indices\n    # and preserving odd-indexed elements.\n    result = list(l) # Create a mutable copy\n    even_idx_counter = 0\n    for i in range(0, len(l), 2):\n        result[i] = sorted_even_elements[even_idx_counter]\n        even_idx_counter += 1\n\n    return result"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    if not l:\n        return []\n\n    # Extract values at indices divisible by three and their indices.\n    values_to_sort = []\n    indices_to_replace = []\n    for i, item in enumerate(l):\n        if i % 3 == 0:\n            values_to_sort.append(item)\n            indices_to_replace.append(i)\n\n    # Sort the extracted values.\n    values_to_sort.sort()\n\n    # Create a new list to store the result.\n    result = list(l)\n\n    # Place the sorted values back into the new list at their original indices.\n    for i, original_index in enumerate(indices_to_replace):\n        result[original_index] = values_to_sort[i]\n\n    return result"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # reverse cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[-1:] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/39", "solution": "import math\n\ndef is_prime(num: int) -> bool:\n    \"\"\"Checks if a number is prime using trial division.\"\"\"\n    if num < 2:\n        return False\n    if num == 2:\n        return True\n    if num % 2 == 0:\n        return False\n    i = 3\n    while i * i <= num:\n        if num % i == 0:\n            return False\n        i += 2\n    return True\n\ndef generate_fibonacci_numbers():\n    \"\"\"Generates an infinite sequence of Fibonacci numbers (0, 1, 1, 2, ...).\"\"\"\n    a, b = 0, 1\n    while True:\n        yield a\n        a, b = b, a + b\n\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    count = 0\n    fib_gen = generate_fibonacci_numbers()\n    \n    while True:\n        fib_num = next(fib_gen)\n        # Fibonacci numbers 0 and 1 are not prime.\n        if fib_num <= 1:\n            continue\n        \n        if is_prime(fib_num):\n            count += 1\n            if count == n:\n                return fib_num"}
{"task_id": "HumanEval/41", "solution": "def car_race_collision(n: int):\n    \"\"\"\n    Imagine a road that's a perfectly straight infinitely long line.\n    n cars are driving left to right;  simultaneously, a different set of n cars\n    are driving right to left.   The two sets of cars start out being very far from\n    each other.  All cars move in the same speed.  Two cars are said to collide\n    when a car that's moving left to right hits a car that's moving right to left.\n    However, the cars are infinitely sturdy and strong; as a result, they continue moving\n    in their trajectory as if they did not collide.\n\n    This function outputs the number of such collisions.\n    \"\"\"\n    return n * n"}
