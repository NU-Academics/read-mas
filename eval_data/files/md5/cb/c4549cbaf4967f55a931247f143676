{"task_id": "HumanEval/5", "solution": "from typing import List\n\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n\n    if len(numbers) == 1:\n        return list(numbers)\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:  # Append delimiter if it's not the last element\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/1", "solution": "from typing import List\n\n\ndef _remove_spaces(input_str: str) -> str:\n    \"\"\"Removes all spaces from the input string.\"\"\"\n    return input_str.replace(\" \", \"\")\n\n\ndef _track_nesting_level(char: str, level: int) -> int:\n    \"\"\"Updates the nesting level based on the current character.\"\"\"\n    if char == '(':\n        return level + 1\n    elif char == ')':\n        return level - 1\n    return level\n\n\ndef _validate_balance(group: str) -> bool:\n    \"\"\"Checks if a parentheses group is properly balanced.\"\"\"\n    balance = 0\n    for char in group:\n        balance = _track_nesting_level(char, balance)\n        if balance < 0:\n            return False\n    return balance == 0\n\n\ndef _parse_groups(cleaned_str: str) -> List[str]:\n    \"\"\"Parses a string without spaces to identify potential parentheses groups.\"\"\"\n    groups = []\n    current_group_chars = []\n    balance = 0\n    \n    for char in cleaned_str:\n        balance = _track_nesting_level(char, balance)\n        current_group_chars.append(char)\n        \n        if balance == 0:\n            # A complete top-level group has been identified\n            if current_group_chars:\n                groups.append(\"\".join(current_group_chars))\n                current_group_chars = [] # Reset for the next group\n    \n    return groups\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    cleaned_str = _remove_spaces(paren_string)\n    raw_groups = _parse_groups(cleaned_str)\n    \n    final_groups = []\n    for group in raw_groups:\n        if _validate_balance(group):\n            final_groups.append(group)\n            \n    return final_groups"}
{"task_id": "HumanEval/7", "solution": "def filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    filtered_strings = []\n    for s in strings:\n        if substring in s:\n            filtered_strings.append(s)\n    return filtered_strings"}
{"task_id": "HumanEval/6", "solution": "from typing import List\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n    \"\"\"\n\n    def split_groups(input_string: str) -> List[str]:\n        \"\"\"Splits the input string into individual parentheses groups by spaces.\"\"\"\n        return [group for group in input_string.split(' ') if group]\n\n    def validate_input(input_string: str) -> bool:\n        \"\"\"Validates that input string is usable for processing.\"\"\"\n        # Type hints guarantee 'str'. This function returns True as per design context for valid string types.\n        return True\n\n    def is_valid_parentheses(group: str) -> bool:\n        \"\"\"Checks if a parentheses group has balanced parentheses and only contains parentheses characters.\"\"\"\n        balance = 0\n        for char in group:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            else:\n                return False  # Group contains non-parentheses characters\n            if balance < 0:\n                return False  # Closing parenthesis without an opening one\n        return balance == 0  # All parentheses must be correctly balanced\n\n    def calculate_max_depth(group: str) -> int:\n        \"\"\"Calculates maximum nesting depth for a single parentheses group.\"\"\"\n        current_depth = 0\n        max_depth = 0\n        for char in group:\n            if char == '(':\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif char == ')':\n                current_depth -= 1\n        return max_depth\n\n    # The validate_input function ensures the overall string is valid for processing.\n    # Per constraints and design, it will return True here.\n    if not validate_input(paren_string):\n        # In a real system, an empty list or specific error handling might be appropriate.\n        # But for this problem, we proceed and let group-level validation handle specifics.\n        pass\n\n    groups = split_groups(paren_string)\n    result = []\n\n    for group in groups:\n        if is_valid_parentheses(group):\n            result.append(calculate_max_depth(group))\n        else:\n            # Handle malformed or invalid groups gracefully by returning 0 depth.\n            result.append(0)\n\n    return result"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\n\n\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    total_sum = 0\n    total_product = 1\n\n    for num in numbers:\n        total_sum += num\n        total_product *= num\n\n    return (total_sum, total_product)"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    result = []\n    for i in range(len(a)):\n        if a[i] != b[i]:\n            result.append('1')\n        else:\n            result.append('0')\n    return \"\".join(result)"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    return string == string[::-1]\n\n\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    if not string:\n        return \"\"\n\n    for i in range(len(string)):\n        postfix = string[i:]\n        if is_palindrome(postfix):\n            prefix_to_reverse = string[:i]\n            return string + prefix_to_reverse[::-1]\n    \n    # This case should theoretically not be reached as a single character (or empty string) is always a palindrome.\n    # But as a fallback, if no palindromic postfix is found (e.g., in a string of length 0 or 1), \n    # the entire string itself will be considered the \"prefix\" to reverse.\n    # However, the loop logic guarantees that 'string[len(string)-1:]' (last char) or '' (empty string) will be a palindrome.\n    return string + string[:-1][::-1]"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    # Use absolute values to ensure the GCD is always non-negative.\n    a = abs(a)\n    b = abs(b)\n\n    # Implement the Euclidean algorithm.\n    while b:\n        a, b = b, a % b\n    return a"}
