{"task_id": "HumanEval/46", "solution": "def fib4(n: int) -> int:\n    \"\"\"\n    Compute the n-th element of the Fib4 sequence iteratively.\n    It uses a sliding window to maintain O(1) space complexity.\n    \"\"\"\n    base_values = [0, 0, 2, 0]\n\n    if n < 4:\n        return base_values[n]\n\n    # Initialize the sliding window with fib4(0), fib4(1), fib4(2), fib4(3)\n    a, b, c, d = base_values[0], base_values[1], base_values[2], base_values[3]\n\n    for _ in range(4, n + 1):\n        next_fib = a + b + c + d\n        # Slide the window: remove 'a', shift 'b', 'c', 'd', add 'next_fib'\n        a, b, c, d = b, c, d, next_fib\n\n    return d"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int) -> int:\n    \"\"\"The Fib4 number sequence computes elements iteratively.\n    It handles base cases and uses a sliding window for efficient summation.\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # Initialize the four preceding terms for n=4\n    # (fib4(0), fib4(1), fib4(2), fib4(3))\n    a, b, c, d = 0, 0, 2, 0\n\n    # Iterate from fib4(4) up to fib4(n)\n    for _ in range(4, n + 1):\n        next_fib = d + c + b + a\n        # Slide the window: (fib4(i-3), fib4(i-2), fib4(i-1), fib4(i))\n        a, b, c, d = b, c, d, next_fib\n\n    return d"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    8.0\n    \"\"\"\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n    if n % 2 == 1:\n        # Odd-length list, return the middle element.\n        return sorted_l[n // 2]\n    else:\n        # Even-length list, return the average of the two middle elements.\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        return (mid1 + mid2) / 2"}
{"task_id": "HumanEval/48", "solution": "def is_palindrome(text: str) -> bool:\n    \"\"\"\n    Checks if given string is a palindrome.\n    >>> is_palindrome('')\n    True\n    >>> is_palindrome('aba')\n    True\n    >>> is_palindrome('aaaaa')\n    True\n    >>> is_palindrome('zbcd')\n    False\n    \"\"\"\n    left = 0\n    right = len(text) - 1\n\n    while left < right:\n        if text[left] != text[right]:\n            return False\n        left += 1\n        right -= 1\n    return True"}
{"task_id": "HumanEval/48", "solution": "```python\ndef is_palindrome(text: str) -> bool:\n    \"\"\"\n    Checks if given string is a palindrome.\n    Performs case-sensitive comparison character by character from both ends.\n    >>> is_palindrome('')\n    True\n    >>> is_palindrome('aba')\n    True\n    >>> is_palindrome('aaaaa')\n    True\n    >>> is_palindrome('zbcd')\n    False\n    >>> is_palindrome('Racecar')\n    False\n    >>> is_palindrome('madam')\n    True\n    \"\"\"\n    left = 0\n    right = len(text) - 1\n    while left < right:\n        if text[left] != text[right]:\n            return False\n        left += 1\n        right -= 1\n    return True\n```"}
{"task_id": "HumanEval/47", "solution": "from typing import Union\n\ndef _sort_list(l: list) -> list:\n    \"\"\"Sorts the input list in ascending order.\n    Returns a new sorted list, leaving the original unchanged.\n    \"\"\"\n    return sorted(l)\n\ndef _get_middle_element(sorted_list: list) -> Union[int, float]:\n    \"\"\"Extracts the middle element from an odd-length sorted list.\n    Returns the element at the calculated middle index.\n    \"\"\"\n    mid_idx = len(sorted_list) // 2\n    return sorted_list[mid_idx]\n\ndef _calculate_average(val1: Union[int, float], val2: Union[int, float]) -> float:\n    \"\"\"Calculates the average of two numeric values.\n    Returns the average as a floating-point number.\n    \"\"\"\n    return (val1 + val2) / 2.0\n\ndef median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    sorted_list = _sort_list(l)\n    n = len(sorted_list)\n\n    if n % 2 == 1:\n        # For odd-length lists, return the single middle element.\n        return _get_middle_element(sorted_list)\n    else:\n        # For even-length lists, average the two middle elements.\n        mid_idx1 = n // 2 - 1\n        mid_idx2 = n // 2\n        val1 = sorted_list[mid_idx1]\n        val2 = sorted_list[mid_idx2]\n        return _calculate_average(val1, val2)"}
