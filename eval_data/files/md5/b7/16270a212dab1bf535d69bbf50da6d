{"task_id": "HumanEval/153", "solution": "def count_uppercase(text: str) -> int:\n    \"\"\"Counts uppercase letters in a string.\"\"\"\n    return sum(1 for char in text if 'A' <= char <= 'Z')\n\ndef count_lowercase(text: str) -> int:\n    \"\"\"Counts lowercase letters in a string.\"\"\"\n    return sum(1 for char in text if 'a' <= char <= 'z')\n\ndef calculate_strength(extension_name: str) -> int:\n    \"\"\"Computes strength using CAP - SM formula.\"\"\"\n    cap = count_uppercase(extension_name)\n    sm = count_lowercase(extension_name)\n    return cap - sm\n\ndef find_strongest_extension(extensions: list[str]) -> str:\n    \"\"\"Identifies extension with highest strength, handling tie-breaking by list order.\"\"\"\n    strongest_ext = extensions[0]\n    max_strength = calculate_strength(extensions[0])\n\n    for ext in extensions[1:]:\n        current_strength = calculate_strength(ext)\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_ext = ext\n    return strongest_ext\n\ndef format_result(class_name: str, extension_name: str) -> str:\n    \"\"\"Formats output string as 'ClassName.ExtensionName'.\"\"\"\n    return f\"{class_name}.{extension_name}\"\n\ndef Strongest_Extension(class_name, extensions):\n    \"\"\"Main entry point for the strongest extension algorithm.\n    It orchestrates strength calculation, selection, and result formatting.\"\"\"\n    strongest_ext_name = find_strongest_extension(extensions)\n    return format_result(class_name, strongest_ext_name)"}
{"task_id": "HumanEval/155", "solution": "```python\ndef even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n    \n    # Process the absolute value of the number to ignore the negative sign.\n    # Convert the number to a string to iterate through its digits.\n    num_str = str(abs(num))\n    \n    for digit_char in num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n            \n    return (even_count, odd_count)\n```"}
{"task_id": "HumanEval/153", "solution": "def count_uppercase(text: str) -> int:\n    \"\"\"Counts uppercase letters in a string.\n    Processes each character to determine if it is an uppercase alphabetic character.\"\"\"\n    count = 0\n    for char in text:\n        if 'A' <= char <= 'Z':\n            count += 1\n    return count\n\ndef count_lowercase(text: str) -> int:\n    \"\"\"Counts lowercase letters in a string.\n    Processes each character to determine if it is a lowercase alphabetic character.\"\"\"\n    count = 0\n    for char in text:\n        if 'a' <= char <= 'z':\n            count += 1\n    return count\n\ndef calculate_extension_strength(extension_name: str) -> int:\n    \"\"\"Calculates extension strength using the CAP - SM formula.\n    It calls character counting utilities to get uppercase and lowercase counts.\"\"\"\n    cap_count = count_uppercase(extension_name)\n    sm_count = count_lowercase(extension_name)\n    return cap_count - sm_count\n\ndef process_extensions(extensions: list) -> list:\n    \"\"\"Processes a list of extension names to calculate their strengths.\n    Returns a list of tuples containing (extension_name, strength).\"\"\"\n    extension_data = []\n    for ext_name in extensions:\n        strength = calculate_extension_strength(ext_name)\n        extension_data.append((ext_name, strength))\n    return extension_data\n\ndef find_strongest_extension(extension_data: list) -> str:\n    \"\"\"Identifies the extension with the highest strength, handling ties.\n    If strengths are equal, the extension appearing first in the input list is chosen.\"\"\"\n    max_strength = float('-inf')\n    strongest_name = \"\"\n\n    for ext_name, strength in extension_data:\n        if strength > max_strength:\n            max_strength = strength\n            strongest_name = ext_name\n        # Tie-breaking: if strength is equal, the first one encountered (already strongest_name) is kept.\n    return strongest_name\n\ndef format_result(class_name: str, extension_name: str) -> str:\n    \"\"\"Formats the final result string.\n    Combines the class name and the strongest extension name into 'ClassName.StrongestExtensionName' format.\"\"\"\n    return f\"{class_name}.{extension_name}\"\n\ndef Strongest_Extension(class_name, extensions):\n    \"\"\"You will be given the name of a class (a string) and a list of extensions.\n    The extensions are to be used to load additional classes to the class. The\n    strength of the extension is as follows: Let CAP be the number of the uppercase\n    letters in the extension's name, and let SM be the number of lowercase letters \n    in the extension's name, the strength is given by the fraction CAP - SM. \n    You should find the strongest extension and return a string in this \n    format: ClassName.StrongestExtensionName.\n    If there are two or more extensions with the same strength, you should\n    choose the one that comes first in the list.\n    For example, if you are given \"Slices\" as the class and a list of the\n    extensions: ['SErviNGSliCes', 'Cheese', 'StuFfed'] then you should\n    return 'Slices.SErviNGSliCes' since 'SErviNGSliCes' is the strongest extension \n    (its strength is -1).\n    Example:\n    for Strongest_Extension('my_class', ['AA', 'Be', 'CC']) == 'my_class.AA'\n    \"\"\"\n    \n    processed_data = process_extensions(extensions)\n    strongest_extension_name = find_strongest_extension(processed_data)\n    final_result = format_result(class_name, strongest_extension_name)\n    \n    return final_result"}
{"task_id": "HumanEval/154", "solution": "def is_substring(main, sub):\n    \"\"\"Checks if sub is a substring of main.\n    Returns True if found, False otherwise.\"\"\"\n    return sub in main\n\ndef generate_rotations(s):\n    \"\"\"Generates all unique rotations of a string.\n    Returns a list of all such rotations.\"\"\"\n    if not s:\n        return [\"\"]\n    \n    rotations = set()\n    doubled_s = s + s\n    n = len(s)\n    for i in range(n):\n        rotation = doubled_s[i : i + n]\n        rotations.add(rotation)\n    return list(rotations)\n\ndef cycpattern_check(a , b):\n    \"\"\"Returns True if the second word or any of its rotations is a substring in the first word.\"\"\"\n    \n    # First, check if b itself is a substring of a\n    if is_substring(a, b):\n        return True\n    \n    # Generate all rotations of b\n    rotations_of_b = generate_rotations(b)\n    \n    # Check if any rotation of b is a substring of a\n    for rotation in rotations_of_b:\n        if is_substring(a, rotation):\n            return True\n            \n    # No matches found\n    return False"}
{"task_id": "HumanEval/155", "solution": "```python\ndef even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    # Convert the absolute value of the number to a string to process each digit.\n    num_str = str(abs(num))\n\n    for digit_char in num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)\n```"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase. Restrictions: 1 <= num <= 1000.\n    \"\"\"\n\n    def _validate_input(num_to_validate):\n        \"\"\"Validates if the input number is within the range [1, 1000].\"\"\"\n        return 1 <= num_to_validate <= 1000\n\n    def _convert_to_roman(num_to_convert):\n        \"\"\"Converts a validated integer to its uppercase Roman numeral string.\"\"\"\n        roman_map = [\n            (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n            (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n            (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'),\n            (1, 'I')\n        ]\n        result = []\n        for value, symbol in roman_map:\n            while num_to_convert >= value:\n                result.append(symbol)\n                num_to_convert -= value\n        return \"\".join(result)\n\n    def _format_lowercase(roman_string):\n        \"\"\"Converts an uppercase Roman numeral string to lowercase.\"\"\"\n        return roman_string.lower()\n\n    if not _validate_input(number):\n        raise ValueError(\"Input must be between 1 and 1000.\")\n\n    roman_numeral = _convert_to_roman(number)\n    mini_roman = _format_lowercase(roman_numeral)\n    return mini_roman"}
{"task_id": "HumanEval/156", "solution": "```python\n# src/validation.py\n\ndef validate_input_range(number: int) -> bool:\n    \"\"\"\n    Validates if the input number is within the acceptable range [1, 1000].\n    Raises ValueError if the number is out of this specified range.\n    \"\"\"\n    if not (1 <= number <= 1000):\n        raise ValueError(\"Input number must be between 1 and 1000, inclusive.\")\n    return True\n\n```\n```python\n# src/conversion_tables.py\n\nROMAN_NUMERALS = [\n    (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n    (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n    (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'),\n    (1, 'I')\n]\n\"\"\"\nLookup table for converting integer values to their Roman numeral symbols.\nOrdered from largest to smallest to facilitate a greedy conversion algorithm.\n\"\"\"\n\ndef convert_to_roman(number: int) -> str:\n    \"\"\"\n    Converts a validated positive integer to its uppercase Roman numeral string.\n    Uses a greedy algorithm with a predefined lookup table for efficiency.\n    \"\"\"\n    roman_numeral = []\n    temp_num = number\n    for value, numeral in ROMAN_NUMERALS:\n        while temp_num >= value:\n            roman_numeral.append(numeral)\n            temp_num -= value\n    return \"\".join(roman_numeral)\n\ndef format_lowercase(roman_str: str) -> str:\n    \"\"\"\n    Converts an uppercase Roman numeral string to its lowercase equivalent.\n    This function directly transforms the string to lowercase.\n    \"\"\"\n    return roman_str.lower()\n\n```\n```python\n# src/roman_converter.py\n\nfrom .validation import validate_input_range\nfrom .conversion_tables import convert_to_roman, format_lowercase\n\ndef int_to_mini_roman(number: int) -> str:\n    \"\"\"\n    Converts a positive integer (1-1000) to its lowercase Roman numeral string.\n    Orchestrates validation, conversion, and formatting for the input number.\n    \"\"\"\n    validate_input_range(number)\n    uppercase_roman = convert_to_roman(number)\n    lowercase_roman = format_lowercase(uppercase_roman)\n    return lowercase_roman\n\n```"}
{"task_id": "HumanEval/157", "solution": "import math\n\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    '''\n    # Sort the sides to easily identify the potential hypotenuse.\n    sides = sorted([a, b, c])\n    \n    # Apply the Pythagorean theorem, comparing the sum of squares of the two shorter sides\n    # with the square of the longest side, handling floating-point precision.\n    return math.isclose(sides[0]**2 + sides[1]**2, sides[2]**2)"}
{"task_id": "HumanEval/157", "solution": "```python\nclass MathematicalCalculator:\n    \"\"\"\n    Handles mathematical operations and floating-point precision.\n    Provides utility for squaring numbers and comparing floats with tolerance.\n    \"\"\"\n    def square(self, value: float) -> float:\n        \"\"\"Returns the square of a given float value.\"\"\"\n        return value * value\n\n    def get_default_tolerance(self) -> float:\n        \"\"\"Returns the default tolerance for floating-point comparisons.\"\"\"\n        return 1e-9\n\n    def compare_floating_point(self, val1: float, val2: float, tolerance: float) -> bool:\n        \"\"\"Compares two float values within a specified tolerance.\"\"\"\n        return abs(val1 - val2) < tolerance\n\nclass GeometricValidator:\n    \"\"\"\n    Implements validation logic for triangle inequality and Pythagorean theorem.\n    Uses MathematicalCalculator for precise floating-point comparisons.\n    \"\"\"\n    def __init__(self):\n        \"\"\"Initializes the GeometricValidator with a MathematicalCalculator instance.\"\"\"\n        self._calculator = MathematicalCalculator()\n\n    def validate_triangle_inequality(self, a: float, b: float, c: float) -> bool:\n        \"\"\"Checks if three sides satisfy the triangle inequality theorem.\n        All sides must be positive and satisfy the sum of any two sides being greater than the third.\n        \"\"\"\n        return (a > 0 and b > 0 and c > 0 and\n                (a + b > c) and\n                (a + c > b) and\n                (b + c > a))\n\n    def check_pythagorean_theorem(self, a: float, b: float, c: float) -> bool:\n        \"\"\"Checks if any permutation of sides satisfies the Pythagorean theorem.\n        It uses the MathematicalCalculator for squaring and floating-point comparison.\n        \"\"\"\n        a_sq = self._calculator.square(a)\n        b_sq = self._calculator.square(b)\n        c_sq = self._calculator.square(c)\n        tolerance = self._calculator.get_default_tolerance()\n\n        # Check all three permutations for a right angle\n        return (self._calculator.compare_floating_point(a_sq + b_sq, c_sq, tolerance) or\n                self._calculator.compare_floating_point(a_sq + c_sq, b_sq, tolerance) or\n                self._calculator.compare_floating_point(b_sq + c_sq, a_sq, tolerance))\n\n    def validate_right_angle_triangle(self, a: float, b: float, c: float) -> bool:\n        \"\"\"Validates if the given sides form a right-angled triangle.\"\"\"\n        if not self.validate_triangle_inequality(a, b, c):\n            return False\n        return self.check_pythagorean_theorem(a, b, c)\n\nclass Triangle:\n    \"\"\"\n    Represents a triangle with three side lengths.\n    Provides methods for side access and basic triangle properties.\n    \"\"\"\n    def __init__(self, a: float, b: float, c: float):\n        \"\"\"Initializes a Triangle with three side lengths.\"\"\"\n        self._sideA = a\n        self._sideB = b\n        self._sideC = c\n        self._validator = GeometricValidator()\n\n    def get_sides(self) -> tuple[float, float, float]:\n        \"\"\"Returns the three side lengths of the triangle.\"\"\"\n        return (self._sideA, self._sideB, self._sideC)\n\n    def is_valid_triangle(self) -> bool:\n        \"\"\"Determines if the current side lengths form a valid triangle.\"\"\"\n        return self._validator.validate_triangle_inequality(self._sideA, self._sideB, self._sideC)\n\n    def get_longest_side(self) -> float:\n        \"\"\"Returns the length of the longest side of the triangle.\"\"\"\n        return max(self._sideA, self._sideB, self._sideC)\n\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or \n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    # Instantiates components and orchestrates the validation process as per the design.\n    triangle_instance = Triangle(a, b, c) \n    validator = GeometricValidator()\n    \n    return validator.validate_right_angle_triangle(a, b, c)\n```"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Return the word with the maximum number of unique characters,\n    using lexicographical order for tie-breaking.\n    \"\"\"\n    def _count_unique_chars(word: str) -> int:\n        \"\"\"Counts the number of unique characters in a given string.\"\"\"\n        return len(set(word))\n\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_count = _count_unique_chars(word)\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            # If counts are equal, use lexicographical order for tie-breaking.\n            if word < result_word:\n                result_word = word\n    \n    return result_word"}
{"task_id": "HumanEval/158", "solution": "```python\ndef _count_unique_chars(word: str) -> int:\n    \"\"\"Calculates the number of distinct characters in a string.\n    Uses a set to efficiently count unique elements.\"\"\"\n    return len(set(word))\n\ndef _find_lexicographically_first(words: list[str]) -> str:\n    \"\"\"Finds the string that comes first in lexicographical order from a list.\n    Utilizes Python's built-in min function for string comparison.\"\"\"\n    if not words:\n        return \"\"\n    return min(words)\n\ndef find_max(words: list[str]) -> str:\n    \"\"\"Finds the string with the maximum number of unique characters.\n    Resolves ties using lexicographical order.\"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    candidates = []\n\n    for word in words:\n        current_unique_count = _count_unique_chars(word)\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            candidates = [word]\n        elif current_unique_count == max_unique_count:\n            candidates.append(word)\n    \n    return _find_lexicographically_first(candidates)\n```"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates carrot consumption outcomes for a rabbit, determining total eaten and remaining stock.\n    It handles scenarios where stock is sufficient or insufficient for the rabbit's needs.\n    \"\"\"\n    \n    # Determine how many carrots are actually consumed from the remaining stock.\n    # The rabbit eats either its 'need' or all 'remaining' carrots, whichever is less.\n    carrots_consumed_this_meal = min(need, remaining)\n    \n    # Calculate the total number of carrots eaten by the rabbit after this meal.\n    total_eaten_carrots = number + carrots_consumed_this_meal\n    \n    # Calculate the number of carrots left in stock after this meal.\n    carrots_left_in_stock = remaining - carrots_consumed_this_meal\n    \n    return [total_eaten_carrots, carrots_left_in_stock]"}
{"task_id": "HumanEval/162", "solution": "import hashlib\n\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    md5_hash = hashlib.md5(text.encode('utf-8')).hexdigest()\n    return md5_hash"}
