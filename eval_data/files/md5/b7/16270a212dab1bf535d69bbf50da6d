{"task_id": "HumanEval/80", "solution": "def is_happy(s):\n    \"\"\"Checks if a string is happy: length at least 3 and every 3 consecutive letters are distinct.\n    Returns True if happy, False otherwise.\n    \"\"\"\n    if len(s) < 3:\n        return False\n\n    # Iterate through the string to check every triplet of consecutive characters for distinctness.\n    # The loop's upper bound ensures s[i+2] is always a valid index.\n    for i in range(len(s) - 2):\n        # If any two characters within the triplet are identical, the triplet is not distinct.\n        if s[i] == s[i+1] or s[i] == s[i+2] or s[i+1] == s[i+2]:\n            return False\n\n    return True"}
{"task_id": "HumanEval/83", "solution": "# src/input_validator.py\ndef validate_positive_integer(n: int) -> bool:\n    \"\"\"Validates that input is a positive integer.\n    Always returns True based on the 'trust the caller' constraint.\n    \"\"\"\n    return True\n\ndef check_range(n: int) -> bool:\n    \"\"\"Checks if input is within acceptable mathematical limits.\n    Always returns True based on the 'trust the caller' constraint.\n    \"\"\"\n    return True\n\n# src/mathematical_calculator.py\ndef power(base: int, exponent: int) -> int:\n    \"\"\"Calculates base raised to exponent power.\n    This function uses Python's built-in power operator.\n    \"\"\"\n    return base ** exponent\n\ndef count_starting_with_1(n: int) -> int:\n    \"\"\"Counts n-digit numbers starting with 1.\n    For an n-digit number, if the first digit is 1, there are 10 choices for each of the remaining n-1 digits.\n    \"\"\"\n    return power(10, n - 1)\n\ndef count_ending_with_1(n: int) -> int:\n    \"\"\"Counts n-digit numbers ending with 1.\n    For an n-digit number (n > 1), the first digit has 9 choices (1-9), and the n-2 middle digits each have 10 choices.\n    \"\"\"\n    return 9 * power(10, n - 2)\n\ndef count_both_start_end_1(n: int) -> int:\n    \"\"\"Counts n-digit numbers both starting and ending with 1.\n    For an n-digit number (n > 1), the first and last digits are 1, leaving 10 choices for each of the n-2 middle digits.\n    \"\"\"\n    return power(10, n - 2)\n\n# src/result_processor.py\ndef format_result(count: int) -> int:\n    \"\"\"Formats the final count result.\n    This function ensures the result is an integer.\n    \"\"\"\n    return count\n\ndef validate_result(result: int) -> bool:\n    \"\"\"Validates the final result.\n    Always returns True based on the 'trust the caller' constraint.\n    \"\"\"\n    return True\n\n# src/main.py\ndef starts_one_ends(n: int) -> int:\n    \"\"\"Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    This function orchestrates input validation, mathematical calculation, and result processing.\n    \"\"\"\n    # Input validation layer (functions effectively return True per constraints)\n    validate_positive_integer(n)\n    check_range(n)\n\n    # Handle special case for single-digit numbers (n=1)\n    if n == 1:\n        return 1\n\n    # Mathematical calculation layer for n > 1\n    starts_count = count_starting_with_1(n)\n    ends_count = count_ending_with_1(n)\n    both_count = count_both_start_end_1(n)\n\n    # Apply inclusion-exclusion principle to avoid double-counting\n    total_count = starts_count + ends_count - both_count\n\n    # Result processing layer\n    formatted_result = format_result(total_count)\n    validate_result(formatted_result)\n\n    return formatted_result"}
{"task_id": "HumanEval/81", "solution": "```python\nfrom typing import List\n\ndef _convert_single_gpa(gpa: float) -> str:\n    \"\"\"Converts a single GPA value to its corresponding letter grade based on a defined scale.\n    It applies grading rules in descending order of GPA thresholds.\n    \"\"\"\n    if gpa == 4.0:\n        return \"A+\"\n    elif gpa > 3.7:\n        return \"A\"\n    elif gpa > 3.3:\n        return \"A-\"\n    elif gpa > 3.0:\n        return \"B+\"\n    elif gpa > 2.7:\n        return \"B\"\n    elif gpa > 2.3:\n        return \"B-\"\n    elif gpa > 2.0:\n        return \"C+\"\n    elif gpa > 1.7:\n        return \"C\"\n    elif gpa > 1.3:\n        return \"C-\"\n    elif gpa > 1.0:\n        return \"D+\"\n    elif gpa > 0.7:\n        return \"D\"\n    elif gpa > 0.0:\n        return \"D-\"\n    elif gpa == 0.0:\n        return \"E\"\n    # Inputs are trusted to be within the 0.0-4.0 scale, so no other cases are explicitly handled.\n\ndef numerical_letter_grade(grades: List[float]) -> List[str]:\n    \"\"\"Converts a list of numerical GPA values to corresponding letter grades.\n    It processes each GPA using _convert_single_gpa and maintains input order.\n    \"\"\"\n    letter_grades = []\n    for gpa in grades:\n        letter_grades.append(_convert_single_gpa(gpa))\n    return letter_grades\n```"}
{"task_id": "HumanEval/84", "solution": "def extract_digits(n: int) -> list[int]:\n    \"\"\"Extracts individual digits from an integer into a list.\"\"\"\n    if n == 0:\n        return [0]\n    return [int(d) for d in str(n)]\n\ndef calculate_sum(digits: list[int]) -> int:\n    \"\"\"Calculates the sum of a list of digits.\"\"\"\n    return sum(digits)\n\ndef to_binary(decimal: int) -> str:\n    \"\"\"Converts a decimal number to its binary string representation.\"\"\"\n    return bin(decimal)[2:]\n\ndef solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    \n    Example\n        For N = 1000, the sum of digits will be 1 the output should be \"1\".\n        For N = 150, the sum of digits will be 6 the output should be \"110\".\n        For N = 147, the sum of digits will be 12 the output should be \"1100\".\n    \n    Variables:\n        @N integer\n             Constraints: 0 \u2264 N \u2264 10000.\n    Output:\n         a string of binary number\n    \"\"\"\n    digits = extract_digits(N)\n    digit_sum = calculate_sum(digits)\n    binary_representation = to_binary(digit_sum)\n    return binary_representation"}
{"task_id": "HumanEval/81", "solution": "from typing import List\n\ndef _convert_single_gpa(gpa: float) -> str:\n    \"\"\"Convert single GPA value to letter grade.\"\"\"\n    if gpa == 4.0:\n        return \"A+\"\n    elif gpa > 3.7:\n        return \"A\"\n    elif gpa > 3.3:\n        return \"A-\"\n    elif gpa > 3.0:\n        return \"B+\"\n    elif gpa > 2.7:\n        return \"B\"\n    elif gpa > 2.3:\n        return \"B-\"\n    elif gpa > 2.0:\n        return \"C+\"\n    elif gpa > 1.7:\n        return \"C\"\n    elif gpa > 1.3:\n        return \"C-\"\n    elif gpa > 1.0:\n        return \"D+\"\n    elif gpa > 0.7:\n        return \"D\"\n    elif gpa > 0.0:\n        return \"D-\"\n    elif gpa == 0.0:\n        return \"E\"\n\ndef numerical_letter_grade(grades: List[float]) -> List[str]:\n    \"\"\"Convert list of GPA values to corresponding letter grades.\"\"\"\n    result_grades = []\n    for gpa_value in grades:\n        result_grades.append(_convert_single_gpa(gpa_value))\n    return result_grades"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n\n    def _validate_input(n_val: int) -> bool:\n        \"\"\"Internal validation function. Assumes input n_val is a positive integer based on problem statement.\"\"\"\n        return True\n\n    def _count_starting_with_1(n_val: int) -> int:\n        \"\"\"Calculates count of n-digit numbers starting with 1.\"\"\"\n        return 10**(n_val - 1)\n\n    def _count_ending_with_1(n_val: int) -> int:\n        \"\"\"Calculates count of n-digit numbers ending with 1.\"\"\"\n        if n_val == 1:\n            return 1\n        return 9 * (10**(n_val - 2))\n\n    def _count_both_start_end(n_val: int) -> int:\n        \"\"\"Calculates count of n-digit numbers both starting and ending with 1.\"\"\"\n        if n_val == 1:\n            return 1\n        return 10**(n_val - 2)\n\n    if not _validate_input(n):\n        return 0\n\n    if n == 1:\n        return 1\n\n    start_count = _count_starting_with_1(n)\n    end_count = _count_ending_with_1(n)\n    both_count = _count_both_start_end(n)\n\n    # Apply inclusion-exclusion principle: P(A or B) = P(A) + P(B) - P(A and B)\n    total_count = start_count + end_count - both_count\n    return total_count"}
{"task_id": "HumanEval/85", "solution": "```python\ndef add(lst):\n    \"\"\"Given a non-empty list of integers lst, add the even elements that are at odd indices.\n    This function coordinates helper methods for index analysis, filtering, and sum calculation.\n    \"\"\"\n\n    def _identify_odd_indices(input_list):\n        \"\"\"Extracts elements from the input list located at odd indices (1, 3, 5, ...).\"\"\"\n        elements_at_odd_indices = []\n        for i, element in enumerate(input_list):\n            if i % 2 != 0:\n                elements_at_odd_indices.append(element)\n        return elements_at_odd_indices\n\n    def _filter_even_elements(elements):\n        \"\"\"Filters a list of numbers to include only those that are even.\"\"\"\n        even_elements = []\n        for element in elements:\n            if element % 2 == 0:\n                even_elements.append(element)\n        return even_elements\n\n    def _calculate_sum(elements):\n        \"\"\"Calculates the sum of all numbers present in the provided list.\"\"\"\n        total_sum = 0\n        for element in elements:\n            total_sum += element\n        return total_sum\n\n    elements_from_odd_indices = _identify_odd_indices(lst)\n    even_elements_from_odd_indices = _filter_even_elements(elements_from_odd_indices)\n    final_sum = _calculate_sum(even_elements_from_odd_indices)\n\n    return final_sum\n```"}
{"task_id": "HumanEval/84", "solution": "def solve(N: int) -> str:\n    \"\"\"Main function for digit sum to binary conversion.\n    It orchestrates validation, digit sum calculation, and binary conversion.\"\"\"\n\n    def _validate_input(N: int) -> bool:\n        \"\"\"Validates input constraints.\n        Due to critical requirements, this function assumes N is within the valid range and type.\"\"\"\n        return True\n\n    def _calculate_digit_sum(N: int) -> int:\n        \"\"\"Calculates the sum of individual digits in the given integer N.\"\"\"\n        s = 0\n        for digit_char in str(N):\n            s += int(digit_char)\n        return s\n\n    def _convert_to_binary(decimal_value: int) -> str:\n        \"\"\"Converts a decimal integer to its binary string representation.\n        It removes the '0b' prefix from Python's built-in bin() function output.\"\"\"\n        return bin(decimal_value)[2:]\n\n    # The solve function orchestrates the operations as per the design.\n    # _validate_input is called, but its return is not used for error propagation per critical requirements.\n    _validate_input(N)\n    \n    digit_sum = _calculate_digit_sum(N)\n    binary_string = _convert_to_binary(digit_sum)\n    \n    return binary_string"}
{"task_id": "HumanEval/85", "solution": "```python\n# src/list_processor.py\n\"\"\"\nInput validation and list operations.\nContains validate_input() function.\n\"\"\"\n\ndef validate_input(lst: list[int]) -> bool:\n    \"\"\"Validates that the input list is not empty.\"\"\"\n    return bool(lst)\n```\n\n```python\n# src/index_validator.py\n\"\"\"\nOdd index identification logic.\nContains is_odd_index() and get_odd_indices() functions.\n\"\"\"\n\ndef is_odd_index(index: int) -> bool:\n    \"\"\"Checks if an index is odd using zero-based indexing.\"\"\"\n    return index % 2 != 0\n\ndef get_odd_indices(lst: list[int]) -> list[int]:\n    \"\"\"Identifies all odd indices within the bounds of the input list.\"\"\"\n    return [i for i in range(len(lst)) if is_odd_index(i)]\n```\n\n```python\n# src/number_filter.py\n\"\"\"\nEven number filtering functionality.\nContains is_even() and filter_even_at_indices() functions.\n\"\"\"\n\ndef is_even(number: int) -> bool:\n    \"\"\"Checks if a given number is even.\"\"\"\n    return number % 2 == 0\n\ndef filter_even_at_indices(lst: list[int], indices: list[int]) -> list[int]:\n    \"\"\"Filters for even numbers found at specified odd indices in the list.\"\"\"\n    filtered_numbers = []\n    for index in indices:\n        element = lst[index]\n        if is_even(element):\n            filtered_numbers.append(element)\n    return filtered_numbers\n```\n\n```python\n# src/sum_calculator.py\n\"\"\"\nSum calculation operations.\nContains calculate_sum() function.\n\"\"\"\n\ndef calculate_sum(numbers: list[int]) -> int:\n    \"\"\"Calculates the sum of all numbers in the provided list.\"\"\"\n    return sum(numbers)\n```\n\n```python\n# src/add_function.py\n\"\"\"\nMain entry point and orchestrator for the Add Function system.\nProcesses integer lists by calculating the sum of even elements at odd indices.\n\"\"\"\n\n# Import components from other modules.\n# These imports assume the files are part of a Python package named 'src'.\nfrom .list_processor import validate_input\nfrom .index_validator import get_odd_indices\nfrom .number_filter import filter_even_at_indices\nfrom .sum_calculator import calculate_sum\n\ndef add(lst: list[int]) -> int:\n    \"\"\"Given a non-empty list of integers lst. add the even elements that are at odd indices.\n    Examples:\n        add([4, 2, 6, 7]) ==> 2\n    \"\"\"\n    # 1. Input validation (per design, but caller inputs are trusted per constraints)\n    validate_input(lst) \n\n    # 2. Odd index identification\n    odd_indices = get_odd_indices(lst)\n\n    # 3. Even number filtering\n    even_numbers_at_odd_indices = filter_even_at_indices(lst, odd_indices)\n\n    # 4. Sum calculation\n    result_sum = calculate_sum(even_numbers_at_odd_indices)\n\n    # 5. Result return\n    return result_sum\n```"}
{"task_id": "HumanEval/86", "solution": "def get_ascii_sorted_chars(word: str) -> list[str]:\n    \"\"\"Get characters sorted by ASCII value.\n    Converts a word into a list of its characters, then sorts them based on their ASCII values.\"\"\"\n    return sorted(list(word), key=ord)\n\ndef sort_word_characters(word: str) -> str:\n    \"\"\"Sort characters within a word by ASCII value and return as a string.\n    Uses get_ascii_sorted_chars to sort characters and then joins them back into a string.\"\"\"\n    return \"\".join(get_ascii_sorted_chars(word))\n\ndef preserve_spaces(input_string: str) -> list[int]:\n    \"\"\"Track space positions in original string.\n    Iterates through the input string and records the indices of all space characters.\"\"\"\n    space_positions = []\n    for i, char in enumerate(input_string):\n        if char == ' ':\n            space_positions.append(i)\n    return space_positions\n\ndef split_into_words(input_string: str) -> list[tuple[str, int]]:\n    \"\"\"Split string into words while tracking positions.\n    Extracts words from the input string, recording each word and its starting index.\"\"\"\n    words_with_positions = []\n    current_word_chars = []\n    word_start_index = -1\n\n    for i, char in enumerate(input_string):\n        if char == ' ':\n            if current_word_chars:\n                words_with_positions.append((\"\".join(current_word_chars), word_start_index))\n                current_word_chars = []\n                word_start_index = -1\n        else:\n            if word_start_index == -1:\n                word_start_index = i\n            current_word_chars.append(char)\n\n    if current_word_chars:\n        words_with_positions.append((\"\".join(current_word_chars), word_start_index))\n\n    return words_with_positions\n\ndef reconstruct_string(words_with_positions: list[tuple[str, int]], original_length: int) -> str:\n    \"\"\"Rebuild string maintaining original spacing.\n    Constructs a new string of the original length, placing processed words at their original positions.\"\"\"\n    result_chars = [' '] * original_length\n    for word, start_pos in words_with_positions:\n        for j, char in enumerate(word):\n            if start_pos + j < original_length:\n                result_chars[start_pos + j] = char\n    return \"\".join(result_chars)\n\ndef anti_shuffle(s):\n    \"\"\"\n    Write a function that takes a string and returns an ordered version of it.\n    Ordered version of string, is a string where all words (separated by space)\n    are replaced by a new word where all the characters arranged in\n    ascending order based on ascii value.\n    Note: You should keep the order of words and blank spaces in the sentence.\n    \"\"\"\n    if not s:\n        return \"\"\n\n    _ = preserve_spaces(s)\n\n    extracted_words_with_positions = split_into_words(s)\n\n    sorted_words_with_positions = []\n    for word, pos in extracted_words_with_positions:\n        sorted_word = sort_word_characters(word)\n        sorted_words_with_positions.append((sorted_word, pos))\n\n    return reconstruct_string(sorted_words_with_positions, len(s))"}
{"task_id": "HumanEval/87", "solution": "```python\nfrom typing import List, Tuple\n\ndef get_row(lst: List[List[int]], x: int) -> List[Tuple[int, int]]:\n    \"\"\"\n    Search for integer x in 2D nested list and return sorted coordinates.\n\n    Returns a list of coordinate tuples (row, column) sorted by row ascending,\n    then by column descending within each row, using zero-based indexing.\n    \"\"\"\n    coordinates = []\n\n    for row_index, row in enumerate(lst):\n        for col_index, element in enumerate(row):\n            if element == x:\n                coordinates.append((row_index, col_index))\n\n    # Sort coordinates primarily by row ascending, secondarily by column descending.\n    # Sorting by -column achieves descending order for columns.\n    coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n\n    return coordinates\n```"}
{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Processes input string by sorting characters within each word in ascending ASCII order\n    while preserving original word sequence and spacing.\n    \"\"\"\n\n    def _parse_words(input_string):\n        \"\"\"Parse input string into words and track space positions.\"\"\"\n        words = []\n        space_positions = []\n        current_word = []\n        for i, char in enumerate(input_string):\n            if char == ' ':\n                if current_word:\n                    words.append(\"\".join(current_word))\n                    current_word = []\n                space_positions.append(i)\n            else:\n                current_word.append(char)\n        if current_word:\n            words.append(\"\".join(current_word))\n        return words, space_positions\n\n    def _sort_word_chars(word):\n        \"\"\"Sort characters within a single word by ASCII value.\"\"\"\n        return \"\".join(sorted(word))\n\n    def _assemble_result(sorted_words, space_positions):\n        \"\"\"Reconstruct string with sorted words and original spacing.\"\"\"\n        total_length = sum(len(word) for word in sorted_words) + len(space_positions)\n        result_chars = [''] * total_length\n\n        for pos in space_positions:\n            result_chars[pos] = ' '\n\n        word_idx = 0\n        char_in_word_idx = 0\n        \n        for i in range(total_length):\n            if result_chars[i] == ' ':\n                continue\n            \n            if word_idx < len(sorted_words):\n                current_word = sorted_words[word_idx]\n                result_chars[i] = current_word[char_in_word_idx]\n                char_in_word_idx += 1\n                \n                if char_in_word_idx == len(current_word):\n                    word_idx += 1\n                    char_in_word_idx = 0\n        \n        return \"\".join(result_chars)\n\n    words, space_positions = _parse_words(s)\n    \n    sorted_words_list = []\n    for word in words:\n        sorted_words_list.append(_sort_word_chars(word))\n        \n    return _assemble_result(sorted_words_list, space_positions)"}
{"task_id": "HumanEval/87", "solution": "```python\nfrom typing import List, Tuple\n\ndef get_row(lst: List[List[int]], x: int) -> List[Tuple[int, int]]:\n    \"\"\"\n    Finds all occurrences of integer x in a 2D nested list and returns their (row, column)\n    coordinates, sorted by row ascending, then column descending.\n    \"\"\"\n    \n    found_coordinates = []\n\n    if not lst:  # Handles empty input list as per design's edge case\n        return []\n\n    for r, row in enumerate(lst):\n        for c, value in enumerate(row):\n            if value == x:\n                found_coordinates.append((r, c))\n\n    # Sort coordinates by row in ascending order, then by column in descending order.\n    found_coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n\n    return found_coordinates\n```"}
{"task_id": "HumanEval/88", "solution": "def _handle_edge_cases(array):\n    \"\"\"\n    Handles empty and single-element arrays according to system requirements.\n    Returns a tuple (bool, list) indicating if an edge case was handled and the result.\n    \"\"\"\n    if not array:\n        return (True, [])\n    if len(array) == 1:\n        return (True, list(array))\n    return (False, None)\n\ndef _calculate_sum(array):\n    \"\"\"\n    Calculates the sum of the first and last elements of the array.\n    This function assumes the array has at least two elements.\n    \"\"\"\n    return array[0] + array[-1]\n\ndef _is_odd_sum(sum_value):\n    \"\"\"\n    Determines if the given sum value is odd.\n    Returns True if the sum is odd, False otherwise.\n    \"\"\"\n    return sum_value % 2 != 0\n\ndef _sort_ascending(array):\n    \"\"\"\n    Sorts a copy of the given array in ascending order.\n    Returns a new list, leaving the original array unchanged.\n    \"\"\"\n    return sorted(array)\n\ndef _sort_descending(array):\n    \"\"\"\n    Sorts a copy of the given array in descending order.\n    Returns a new list, leaving the original array unchanged.\n    \"\"\"\n    return sorted(array, reverse=True)\n\ndef sort_array(array):\n    \"\"\"\n    Conditionally sorts an array of non-negative integers based on the sum of its boundary elements.\n    Returns a sorted copy of the array without modifying the original.\n    \"\"\"\n    handled, result = _handle_edge_cases(array)\n    if handled:\n        return result\n\n    first_last_sum = _calculate_sum(array)\n    if _is_odd_sum(first_last_sum):\n        return _sort_ascending(array)\n    else:\n        return _sort_descending(array)"}
{"task_id": "HumanEval/88", "solution": "def calculate_sum(array):\n    \"\"\"Calculate sum of first and last elements in non-empty array.\"\"\"\n    return array[0] + array[-1]\n\ndef sort_ascending(array):\n    \"\"\"Return ascending sorted copy of array.\"\"\"\n    return sorted(array)\n\ndef sort_descending(array):\n    \"\"\"Return descending sorted copy of array.\"\"\"\n    return sorted(array, reverse=True)\n\ndef sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting.\n    Sort in ascending order if sum(first, last) is odd, descending if even.\n    \"\"\"\n    n = len(array)\n\n    if n == 0:\n        return []\n    elif n == 1:\n        return array[:]\n    \n    first_last_sum = calculate_sum(array)\n\n    if first_last_sum % 2 != 0:\n        return sort_ascending(array)\n    else:\n        return sort_descending(array)"}
{"task_id": "HumanEval/89", "solution": "```python\ndef encrypt(s):\n    \"\"\"\n    Transforms an input string by shifting each lowercase letter down by 4 positions in the alphabet,\n    with wraparound functionality. For example: 'hi' becomes 'lm', and 'et' becomes 'ix'.\n    \"\"\"\n    encrypted_chars = []\n    for char in s:\n        if 'a' <= char <= 'z':\n            shifted_char_code = ((ord(char) - ord('a') + 4) % 26) + ord('a')\n            encrypted_chars.append(chr(shifted_char_code))\n        else:\n            encrypted_chars.append(char)\n    return \"\".join(encrypted_chars)\n```"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s: str) -> str:\n    \"\"\"Encrypts a string by shifting each lowercase letter 4 positions down in alphabet.\n    Non-lowercase letters remain unchanged.\"\"\"\n    encrypted_chars = []\n    SHIFT_VALUE = 4\n\n    for char in s:\n        if 'a' <= char <= 'z':\n            # Calculate 0-indexed position, apply shift, and handle wrap-around\n            initial_position = ord(char) - ord('a')\n            shifted_position = (initial_position + SHIFT_VALUE) % 26\n            encrypted_char = chr(ord('a') + shifted_position)\n            encrypted_chars.append(encrypted_char)\n        else:\n            # Append non-lowercase characters without modification\n            encrypted_chars.append(char)\n\n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/90", "solution": "def _validate_input(lst):\n    \"\"\"\n    Checks if the input list is non-empty.\n    Returns True if the list is non-empty, False otherwise.\n    \"\"\"\n    return len(lst) > 0\n\ndef _remove_duplicates(lst):\n    \"\"\"\n    Creates a new list containing only unique elements from the input list.\n    This operation preserves the order of elements effectively after sorting.\n    \"\"\"\n    return list(set(lst))\n\ndef next_smallest(lst):\n    \"\"\"\n    Finds the second smallest unique element in a list of integers.\n    Returns None if the list is empty or contains fewer than two unique elements.\n    \"\"\"\n    if not _validate_input(lst):\n        return None\n\n    unique_elements = _remove_duplicates(lst)\n    unique_elements.sort()\n\n    if len(unique_elements) < 2:\n        return None\n    else:\n        return unique_elements[1]"}
{"task_id": "HumanEval/92", "solution": "def _is_integer(value) -> bool:\n    \"\"\"\n    Helper function to validate if a value is an integer type.\n    This function adheres to the design specification's requirement for explicit type validation.\n    \"\"\"\n    return isinstance(value, int)\n\ndef _check_sum_conditions(x, y, z) -> bool:\n    \"\"\"\n    Helper function to check if any number equals the sum of the other two.\n    This assumes all provided inputs are already validated as integers.\n    \"\"\"\n    return (x == y + z) or \\\n           (y == x + z) or \\\n           (z == x + y)\n\ndef any_int(x, y, z):\n    '''\n    Create a function that takes 3 numbers.\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns false in any other cases.\n    '''\n    # First, validate that all inputs are integers. This adheres to the \"Fail Fast\" principle.\n    if not (_is_integer(x) and _is_integer(y) and _is_integer(z)):\n        return False\n    \n    # If all inputs are confirmed integers, proceed to check the sum conditions.\n    return _check_sum_conditions(x, y, z)"}
{"task_id": "HumanEval/91", "solution": "```python\ndef is_bored(S: str) -> int:\n    \"\"\"\n    Count the number of boredoms in a string.\n    A boredom is a sentence that starts with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    if not S:\n        return 0\n\n    boredom_count = 0\n    sentences = []\n    current_sentence_chars = []\n    \n    # Manually split the string into sentences based on delimiters\n    for char in S:\n        if char == '.' or char == '?' or char == '!':\n            # Join characters to form the sentence and strip whitespace\n            sentence_text = \"\".join(current_sentence_chars).strip()\n            if sentence_text: # Only add non-empty sentences\n                sentences.append(sentence_text)\n            current_sentence_chars = [] # Reset for the next sentence\n        else:\n            current_sentence_chars.append(char)\n\n    # Add the last sentence if the string does not end with a delimiter\n    last_sentence_text = \"\".join(current_sentence_chars).strip()\n    if last_sentence_text:\n        sentences.append(last_sentence_text)\n\n    # Iterate through extracted sentences to count boredoms\n    for sentence in sentences:\n        # Check if the sentence starts with the word \"I\" (case-sensitive)\n        # \"I \" handles \"I am\", \"I feel\", etc.\n        # \"I\" handles \"I.\" as a complete sentence.\n        if sentence.startswith(\"I \") or sentence == \"I\":\n            boredom_count += 1\n\n    return boredom_count\n```"}
{"task_id": "HumanEval/90", "solution": "def _extract_unique_elements(lst):\n    \"\"\"\n    Converts the input list to a set of unique values.\n    \"\"\"\n    return set(lst)\n\ndef _find_second_minimum(unique_set):\n    \"\"\"\n    Finds the second smallest element from a set of unique values in O(k) time.\n    Assumes unique_set contains at least two elements.\n    \"\"\"\n    smallest = float('inf')\n    second_smallest = float('inf')\n\n    for num in unique_set:\n        if num < smallest:\n            second_smallest = smallest\n            smallest = num\n        elif num < second_smallest:\n            second_smallest = num\n    \n    return second_smallest\n\ndef next_smallest(lst):\n    \"\"\"\n    Returns the second smallest unique element from a list of integers.\n    Returns None for empty lists or lists with fewer than two unique elements.\n    \"\"\"\n    if not lst:\n        return None\n\n    unique_elements = _extract_unique_elements(lst)\n\n    if len(unique_elements) < 2:\n        return None\n    \n    return _find_second_minimum(unique_elements)"}
{"task_id": "HumanEval/91", "solution": "```python\nimport re\nfrom typing import List\n\ndef _get_first_word(sentence: str) -> str:\n    \"\"\"Extracts the first word from a sentence after stripping whitespace.\n    Returns an empty string if the sentence is empty or only whitespace.\"\"\"\n    stripped_sentence = sentence.strip()\n    if not stripped_sentence:\n        return \"\"\n    return stripped_sentence.split(maxsplit=1)[0]\n\ndef _starts_with_i(sentence: str) -> bool:\n    \"\"\"Checks if a sentence starts with the capital word 'I'.\n    Delegates word extraction to _get_first_word.\"\"\"\n    return _get_first_word(sentence) == \"I\"\n\ndef _split_sentences(text: str) -> List[str]:\n    \"\"\"Splits text into sentences using '.', '?', '!' delimiters.\n    Filters out empty strings resulting from the split operation.\"\"\"\n    sentences_raw = re.split(r'[.?!]', text)\n    cleaned_sentences = [s.strip() for s in sentences_raw if s.strip()]\n    return cleaned_sentences\n\ndef is_bored(S: str) -> int:\n    \"\"\"Counts sentences that start with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\"\"\"\n    if not S:\n        return 0\n\n    boredom_count = 0\n    sentences = _split_sentences(S)\n\n    for sentence in sentences:\n        if _starts_with_i(sentence):\n            boredom_count += 1\n            \n    return boredom_count\n```"}
{"task_id": "HumanEval/92", "solution": "def _validate_integers(x, y, z):\n    \"\"\"\n    Checks if all three inputs are strictly integers.\n    Returns True if all are int, False otherwise.\n    \"\"\"\n    return isinstance(x, int) and isinstance(y, int) and isinstance(z, int)\n\ndef _check_sum_condition(x, y, z):\n    \"\"\"\n    Verifies if one number equals the sum of the other two.\n    Returns True if any sum condition is met, False otherwise.\n    \"\"\"\n    return (x == y + z) or (y == x + z) or (z == x + y)\n\ndef any_int(x, y, z):\n    \"\"\"\n    Validates if one number equals the sum of the other two, given all are integers.\n    Returns True only if both conditions are satisfied, False otherwise.\n    \"\"\"\n    if not _validate_integers(x, y, z):\n        return False\n    return _check_sum_condition(x, y, z)"}
{"task_id": "HumanEval/93", "solution": "def encode(message: str) -> str:\n    \"\"\"\n    Encodes a message by replacing vowels and then swapping case of letters.\n    Vowels are replaced by letters two positions ahead in the alphabet.\n    \"\"\"\n    vowel_map = {\n        'a': 'c', 'e': 'g', 'i': 'k', 'o': 'q', 'u': 'w',\n        'A': 'C', 'E': 'G', 'I': 'K', 'O': 'Q', 'U': 'W'\n    }\n\n    # Stage 1: Vowel Replacement\n    vowel_replaced_chars = []\n    for char in message:\n        if char in vowel_map:\n            vowel_replaced_chars.append(vowel_map[char])\n        else:\n            vowel_replaced_chars.append(char)\n    intermediate_message = \"\".join(vowel_replaced_chars)\n\n    # Stage 2: Case Swapping\n    final_chars = []\n    for char in intermediate_message:\n        # Check if the character is an alphabet letter\n        if ('a' <= char <= 'z') or ('A' <= char <= 'Z'):\n            final_chars.append(char.swapcase())\n        else:\n            final_chars.append(char)\n            \n    return \"\".join(final_chars)"}
{"task_id": "HumanEval/93", "solution": "def is_vowel(char: str) -> bool:\n    \"\"\"Checks if a character is a vowel (case-insensitive).\"\"\"\n    return char.lower() in 'aeiou'\n\ndef swap_case(char: str) -> str:\n    \"\"\"Swaps the case of an alphabetic character.\"\"\"\n    return char.swapcase()\n\ndef replace_vowel(vowel: str) -> str:\n    \"\"\"Replaces a vowel with a letter two places ahead, preserving case.\"\"\"\n    vowel_replacements = {'a': 'c', 'e': 'g', 'i': 'k', 'o': 'q', 'u': 'w'}\n    \n    if vowel.lower() in vowel_replacements:\n        replacement_char_lower = vowel_replacements[vowel.lower()]\n        if vowel.isupper():\n            return replacement_char_lower.upper()\n        else:\n            return replacement_char_lower\n    return vowel\n\ndef encode(message: str) -> str:\n    \"\"\"\n    Encodes a message by swapping case of letters and shifting vowels.\n    Non-alphabetic characters are preserved in their original positions.\n    \"\"\"\n    encoded_chars = []\n    \n    for char in message:\n        if char.isalpha():\n            swapped_char = swap_case(char)\n            \n            if is_vowel(swapped_char):\n                final_char = replace_vowel(swapped_char)\n            else:\n                final_char = swapped_char\n        else:\n            final_char = char\n        encoded_chars.append(final_char)\n        \n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/94", "solution": "```python\ndef skjkasdkd(lst):\n    \"\"\"Finds the largest prime in a list and returns the sum of its digits.\n    Processes zero and positive integers to find the largest prime number and calculate its digit sum.\n    \"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if a number is prime.\n        Returns True if prime, False otherwise.\n        \"\"\"\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    def find_primes_in_list(input_list: list[int]) -> list[int]:\n        \"\"\"Identifies all prime numbers within the input list.\n        Returns a new list containing only prime numbers.\n        \"\"\"\n        return [n for n in input_list if is_prime(n)]\n\n    def find_largest_prime(primes: list[int]) -> int:\n        \"\"\"Determines the largest prime number from a list of primes.\n        Returns the largest prime, or 0 if the list is empty.\n        \"\"\"\n        if not primes:\n            return 0\n        return max(primes)\n\n    def extract_digits(number: int) -> list[int]:\n        \"\"\"Extracts individual digits from a number.\n        Returns a list of digits.\n        \"\"\"\n        if number == 0:\n            return [0]\n        digits = []\n        temp_num = number\n        while temp_num > 0:\n            digits.append(temp_num % 10)\n            temp_num //= 10\n        return digits[::-1]\n\n    def sum_of_digits(number: int) -> int:\n        \"\"\"Calculates the sum of digits of a number.\n        Uses the extract_digits helper function.\n        \"\"\"\n        digits = extract_digits(number)\n        return sum(digits)\n\n    primes = find_primes_in_list(lst)\n    largest_prime = find_largest_prime(primes)\n    return sum_of_digits(largest_prime)\n```"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower \n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    \"\"\"\n\n    def _is_empty(d: dict) -> bool:\n        \"\"\"Checks if the dictionary is empty.\"\"\"\n        return len(d) == 0\n\n    def _all_keys_strings(keys_iterable) -> bool:\n        \"\"\"Validates that all keys are string type.\"\"\"\n        for key in keys_iterable:\n            if not isinstance(key, str):\n                return False\n        return True\n\n    def _all_lowercase(keys_iterable) -> bool:\n        \"\"\"Checks if all string keys are lowercase.\"\"\"\n        for key in keys_iterable:\n            if not key.islower():\n                return False\n        return True\n\n    def _all_uppercase(keys_iterable) -> bool:\n        \"\"\"Checks if all string keys are uppercase.\"\"\"\n        for key in keys_iterable:\n            if not key.isupper():\n                return False\n        return True\n\n    # Fail-fast: check for empty dictionary\n    if _is_empty(dict):\n        return False\n\n    keys = dict.keys()\n\n    # Fail-fast: check if all keys are strings\n    if not _all_keys_strings(keys):\n        return False\n\n    # Check for consistent case (all lowercase or all uppercase)\n    all_lower_case_consistent = _all_lowercase(keys)\n    all_upper_case_consistent = _all_uppercase(keys)\n\n    return all_lower_case_consistent or all_upper_case_consistent"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower\n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    \"\"\"\n    if not dict:\n        return False\n\n    all_lowercase = True\n    all_uppercase = True\n\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False\n        \n        if not key.islower():\n            all_lowercase = False\n        if not key.isupper():\n            all_uppercase = False\n            \n    return all_lowercase or all_uppercase"}
{"task_id": "HumanEval/94", "solution": "def is_prime(n):\n    \"\"\"Checks if a number is prime.\n    Returns True if n is prime, False otherwise.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    # Check for odd divisors from 3 up to the square root of n\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n\ndef sum_digits(n):\n    \"\"\"Calculates the sum of the digits of a number.\n    Returns the sum of digits as an integer.\n    \"\"\"\n    total_sum = 0\n    # Primes are positive, so abs is not strictly needed but harmless.\n    while n > 0:\n        total_sum += n % 10\n        n //= 10\n    return total_sum\n\ndef skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n    largest_prime = None\n\n    for number in lst:\n        if is_prime(number):\n            if largest_prime is None or number > largest_prime:\n                largest_prime = number\n    \n    if largest_prime is None:\n        return 0\n    else:\n        return sum_digits(largest_prime)"}
{"task_id": "HumanEval/96", "solution": "def is_prime(number: int) -> bool:\n    \"\"\"Determines if a given number is prime using trial division.\n    It efficiently checks divisibility only up to the square root of the number.\"\"\"\n    if number < 2:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n    # Check for odd divisors from 3 up to sqrt(number).\n    i = 3\n    while i * i <= number:\n        if number % i == 0:\n            return False\n        i += 2\n    return True\n\ndef validate_input(n) -> bool:\n    \"\"\"This function validates the input for prime generation.\n    It always returns True, trusting the caller's input as per critical requirements.\"\"\"\n    return True\n\ndef count_up_to(n):\n    \"\"\"Implement a function that takes a non-negative integer and returns an array of prime numbers\n    less than n.\n    For example:\n    count_up_to(5) => [2,3]\n    count_up_to(11) => [2,3,5,7]\n    count_up_to(0) => []\n    count_up_to(20) => [2,3,5,7,11,13,17,19]\n    count_up_to(1) => []\n    count_up_to(18) => [2,3,5,7,11,13,17]\n    \"\"\"\n    # As per design, call validate_input first, though its return is implicitly trusted.\n    validate_input(n)\n\n    if n <= 1:\n        return []\n\n    primes = []\n    # Iterate from 2 up to n-1 to find all primes less than n.\n    for i in range(2, n):\n        if is_prime(i):\n            primes.append(i)\n\n    # Primes are added in ascending order by nature of the loop.\n    return primes"}
