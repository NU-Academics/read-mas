{"task_id": "HumanEval/2", "solution": "def truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    integer_part = int(number)\n    decimal_part = number - integer_part\n    return decimal_part"}
{"task_id": "HumanEval/3", "solution": "from typing import List\n\n\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\"Detects if a bank account balance, starting at zero, ever falls below zero.\n    Returns True if balance goes negative at any point, False otherwise.\"\"\"\n    balance = 0\n    for op in operations:\n        balance += op\n        if balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/1", "solution": "from typing import List\n\n\ndef _clean_spaces(input_str: str) -> str:\n    \"\"\"Removes all space characters from the input string.\n    It iterates through the string and builds a new one without spaces.\"\"\"\n    return \"\".join(char for char in input_str if char != ' ')\n\n\ndef _track_nesting(char: str, depth: int) -> int:\n    \"\"\"Updates the nesting depth based on the current character.\n    Increments for '(', decrements for ')', and returns current depth for other characters.\"\"\"\n    if char == '(':\n        return depth + 1\n    elif char == ')':\n        return depth - 1\n    return depth\n\n\ndef _validate_balance(group: str) -> bool:\n    \"\"\"Checks if a given parentheses group is balanced.\n    It counts opening and closing parentheses, ensuring balance never drops below zero and ends at zero.\"\"\"\n    balance = 0\n    for char in group:\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n        if balance < 0:\n            return False\n    return balance == 0\n\n\ndef _parse_groups(cleaned_str: str) -> List[str]:\n    \"\"\"Parses the space-free string into individual balanced groups.\n    It tracks nesting depth and extracts groups when the depth returns to zero.\"\"\"\n    result = []\n    current_group_chars = []\n    depth = 0\n    start_index = 0\n\n    for i, char in enumerate(cleaned_str):\n        new_depth = _track_nesting(char, depth)\n        \n        # Only process characters that are part of a group (i.e., depth is not 0 before the first char)\n        if depth == 0 and char == '(':\n            start_index = i\n            current_group_chars = [char]\n            depth = new_depth\n        elif depth > 0:\n            current_group_chars.append(char)\n            depth = new_depth\n\n            if depth == 0: # A group just closed\n                group_string = \"\".join(current_group_chars)\n                if _validate_balance(group_string):\n                    result.append(group_string)\n                current_group_chars = [] # Reset for the next group\n                start_index = i + 1 # Move start index past this group\n    \n    return result\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"Input to this function is a string containing multiple groups of nested parentheses.\n    Your goal is to separate those group into separate strings and return the list of those.\"\"\"\n    cleaned_str = _clean_spaces(paren_string)\n    return _parse_groups(cleaned_str)"}
{"task_id": "HumanEval/3", "solution": "```python\nfrom typing import List\n\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\"\n    You're given a list of deposit and withdrawal operations on a bank account that starts with\n    zero balance. Your task is to detect if at any point the balance of account falls below zero, and\n    at that point function should return True. Otherwise it should return False.\n\n    Args:\n        operations: List of integers representing deposits (positive) and withdrawals (negative)\n\n    Returns:\n        bool: True if balance falls below zero at any point, False otherwise\n\n    Examples:\n        >>> below_zero([1, 2, 3])\n        False\n        >>> below_zero([1, 2, -4, 5])\n        True\n    \"\"\"\n    balance = 0\n    for operation in operations:\n        balance += operation\n        if balance < 0:\n            return True\n    return False\n```"}
{"task_id": "HumanEval/1", "solution": "from typing import List\n\n\ndef _remove_spaces(input_str: str) -> str:\n    \"\"\"Removes all spaces from the input string.\n    This helper preprocesses the input before parsing.\n    \"\"\"\n    return input_str.replace(\" \", \"\")\n\n\ndef _is_balanced(group: str) -> bool:\n    \"\"\"Checks if a string of parentheses is balanced.\n    It ensures that open and close parentheses match correctly.\n    \"\"\"\n    balance = 0\n    for char in group:\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n        if balance < 0:\n            return False\n    return balance == 0\n\n\ndef _parse_groups(cleaned_str: str) -> List[str]:\n    \"\"\"Parses a string to extract individual balanced parentheses groups.\n    It tracks the balance count to identify complete top-level groups.\n    \"\"\"\n    groups: List[str] = []\n    current_group_chars: List[str] = []\n    balance = 0\n\n    for char in cleaned_str:\n        current_group_chars.append(char)\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n\n        if balance == 0 and current_group_chars:\n            group_str = \"\".join(current_group_chars)\n            # Validate the extracted group as per the design's sequence diagram.\n            if _is_balanced(group_str): \n                groups.append(group_str)\n            current_group_chars = []\n    \n    return groups\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    \n    cleaned_string = _remove_spaces(paren_string)\n    return _parse_groups(cleaned_string)"}
{"task_id": "HumanEval/0", "solution": "from typing import List, Iterator, Tuple\n\n\nclass NumberPair:\n    \"\"\"Represents a pair of numbers and calculates their absolute difference.\n    Initializes with two float numbers and computes their difference.\"\"\"\n    def __init__(self, first: float, second: float) -> None:\n        self._first = first\n        self._second = second\n\n    def calculate_difference(self) -> float:\n        \"\"\"Calculates the absolute difference between the two numbers.\"\"\"\n        return abs(self._first - self._second)\n\n\nclass NumberList:\n    \"\"\"Handles list validation and pair generation for numbers.\n    It stores a list of floats and can generate all unique pairs from it.\"\"\"\n    def __init__(self, numbers: List[float]) -> None:\n        self._numbers = numbers\n\n    def validate(self) -> bool:\n        \"\"\"Validates that the list contains at least two elements.\"\"\"\n        return len(self._numbers) >= 2\n\n    def get_pairs(self) -> Iterator[Tuple[float, float]]:\n        \"\"\"Generates all unique pairs of numbers from the list.\"\"\"\n        n = len(self._numbers)\n        for i in range(n):\n            for j in range(i + 1, n):\n                yield self._numbers[i], self._numbers[j]\n\n\nclass Threshold:\n    \"\"\"Manages a threshold value and provides comparison logic.\n    It stores a float value and can compare other float differences against it.\"\"\"\n    def __init__(self, value: float) -> None:\n        self._value = value\n\n    def validate(self) -> bool:\n        \"\"\"Validates that the threshold value is positive.\"\"\"\n        return self._value > 0\n\n    def compare(self, difference: float) -> bool:\n        \"\"\"Compares a given difference against the stored threshold.\"\"\"\n        return difference < self._value\n\n\nclass ProximityChecker:\n    \"\"\"Orchestrates the proximity detection algorithm using domain objects.\n    It checks if any two numbers in a list are closer than a specified threshold.\"\"\"\n    def __init__(self, numbers: List[float], threshold: float) -> None:\n        self._number_list = NumberList(numbers)\n        self._threshold = Threshold(threshold)\n\n    def check_close_elements(self) -> bool:\n        \"\"\"Main algorithm to determine if close elements exist, with early return.\"\"\"\n        if not self._number_list.validate() or not self._threshold.validate():\n            return False\n\n        for num1, num2 in self._number_list.get_pairs():\n            number_pair = NumberPair(num1, num2)\n            difference = number_pair.calculate_difference()\n            if self._threshold.compare(difference):\n                return True\n        return False\n\n\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    checker = ProximityChecker(numbers, threshold)\n    return checker.check_close_elements()"}
{"task_id": "HumanEval/4", "solution": "from typing import List\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    n = len(numbers)\n    # The requirement specifies not to add explicit checks for edge cases like empty lists.\n    # Division by zero will occur naturally if 'numbers' is empty.\n\n    mean = sum(numbers) / n\n    \n    absolute_differences = [abs(x - mean) for x in numbers]\n    \n    mad = sum(absolute_differences) / n\n    \n    return mad"}
{"task_id": "HumanEval/5", "solution": "```python\nfrom typing import List\n\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    n = len(numbers)\n\n    if n <= 1:\n        return list(numbers)\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < n - 1:\n            result.append(delimeter)\n    return result\n```"}
{"task_id": "HumanEval/4", "solution": "from typing import List\n\n\ndef _calculate_mean(numbers: List[float]) -> float:\n    \"\"\"Calculate arithmetic mean of numbers.\n    This function sums all numbers and divides by their count.\n    \"\"\"\n    return sum(numbers) / len(numbers)\n\n\ndef _calculate_absolute_differences(numbers: List[float], mean: float) -> List[float]:\n    \"\"\"Calculate absolute differences between each number and mean.\n    It returns a new list containing these absolute differences.\n    \"\"\"\n    return [abs(number - mean) for number in numbers]\n\n\ndef _calculate_average(values: List[float]) -> float:\n    \"\"\"Calculate average of a list of values.\n    This function is a general utility for finding the mean of any list of floats.\n    \"\"\"\n    return sum(values) / len(values)\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    >>> mean_absolute_deviation([10.0, 20.0, 30.0])\n    6.666666666666667\n    >>> mean_absolute_deviation([5.0])\n    0.0\n    \"\"\"\n    mean_val = _calculate_mean(numbers)\n    abs_differences = _calculate_absolute_differences(numbers, mean_val)\n    mad_val = _calculate_average(abs_differences)\n    return mad_val"}
{"task_id": "HumanEval/5", "solution": "from typing import List\n\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if len(numbers) <= 1:\n        return numbers\n\n    result: List[int] = []\n    result.append(numbers[0])\n    for i in range(1, len(numbers)):\n        result.append(delimeter)\n        result.append(numbers[i])\n    return result"}
{"task_id": "HumanEval/7", "solution": "from typing import List\n\n\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring.\n    This function performs case-sensitive matching and preserves original order.\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    return [s for s in strings if substring in s]"}
{"task_id": "HumanEval/7", "solution": "from typing import List\n\n\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    filtered_strings: List[str] = []\n    for s in strings:\n        if substring in s:\n            filtered_strings.append(s)\n    return filtered_strings"}
{"task_id": "HumanEval/6", "solution": "from typing import List\n\n\ndef _split_groups(input_string: str) -> List[str]:\n    \"\"\"\n    Splits the input string into individual parentheses groups using space as a delimiter.\n    It handles multiple spaces by treating any sequence of whitespace as a single separator.\n    \"\"\"\n    return [group for group in input_string.split() if group]\n\n\ndef _calculate_depth(group: str) -> int:\n    \"\"\"\n    Calculates the maximum nesting depth for a single string of parentheses.\n    It tracks the current and maximum depth by iterating through opening and closing parentheses.\n    \"\"\"\n    current_depth = 0\n    max_depth = 0\n    for char in group:\n        if char == '(':\n            current_depth += 1\n            max_depth = max(max_depth, current_depth)\n        elif char == ')':\n            current_depth -= 1\n    return max_depth\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    groups = _split_groups(paren_string)\n    results = []\n    for group in groups:\n        results.append(_calculate_depth(group))\n    return results"}
{"task_id": "HumanEval/6", "solution": "from typing import List\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n    \"\"\"\n\n    def _calculate_max_depth_for_group(group_str: str) -> int:\n        \"\"\"Calculates the maximum nesting depth for a single parentheses group string.\"\"\"\n        current_depth = 0\n        max_depth = 0\n        for char in group_str:\n            if char == '(':\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif char == ')':\n                current_depth -= 1\n        return max_depth\n\n    # Split input by spaces and filter out any resulting empty strings.\n    groups = [g for g in paren_string.split(' ') if g]\n\n    result_depths: List[int] = []\n\n    for group in groups:\n        depth = _calculate_max_depth_for_group(group)\n        result_depths.append(depth)\n        \n    return result_depths"}
{"task_id": "HumanEval/8", "solution": "```python\nfrom typing import List, Tuple\n\n\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    total_sum = 0\n    total_product = 1\n    for num in numbers:\n        total_sum += num\n        total_product *= num\n    return (total_sum, total_product)\n```"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\n\n\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    total_sum = sum(numbers)  # Calculates the sum of all numbers, returning 0 for an empty list.\n\n    total_product = 1  # Initialize product with the multiplicative identity.\n    for number in numbers:\n        total_product *= number\n\n    return (total_sum, total_product)"}
{"task_id": "HumanEval/9", "solution": "from typing import List, Tuple\n\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    rolling_max_list: List[int] = []\n    current_max: int | None = None\n\n    for number in numbers:\n        if current_max is None or number > current_max:\n            current_max = number\n        rolling_max_list.append(current_max)\n\n    return rolling_max_list"}
{"task_id": "HumanEval/9", "solution": "from typing import List, Tuple\n\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    current_max = float('-inf')\n\n    for num in numbers:\n        if num > current_max:\n            current_max = num\n        result.append(current_max)\n\n    return result"}
{"task_id": "HumanEval/11", "solution": "from typing import List\n\n\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    result_chars: List[str] = []\n    # Assume inputs are of equal length and consist only of '0's and '1's.\n    for i in range(len(a)):\n        if a[i] == b[i]:\n            result_chars.append('0')\n        else:\n            result_chars.append('1')\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome. \"\"\"\n    return string == string[::-1]\n\n\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Find the longest palindromic suffix, then append the reverse of the remaining prefix.\n    \"\"\"\n    if not string:\n        return \"\"\n\n    longest_pal_suffix_start_index = 0\n    for i in range(len(string)):\n        suffix = string[i:]\n        if is_palindrome(suffix):\n            longest_pal_suffix_start_index = i\n            break\n\n    prefix_to_reverse = string[:longest_pal_suffix_start_index]\n    reversed_prefix = prefix_to_reverse[::-1]\n\n    return string + reversed_prefix"}
{"task_id": "HumanEval/11", "solution": "from typing import List\n\n\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    result_chars = []\n    for i in range(len(a)):\n        if a[i] == b[i]:\n            result_chars.append('0')\n        else:\n            result_chars.append('1')\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    return string == string[::-1]\n\n\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    This algorithm finds the longest palindromic postfix and prepends the reverse of the remaining prefix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    if is_palindrome(string):\n        return string\n\n    # Find the starting index of the longest palindromic postfix\n    postfix_start_index = len(string)\n    for i in range(len(string)):\n        if is_palindrome(string[i:]):\n            postfix_start_index = i\n            break\n\n    # Extract the non-palindromic prefix, reverse it, and append to the original string\n    non_palindromic_prefix = string[0:postfix_start_index]\n    return string + non_palindromic_prefix[::-1]"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\n\n\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    >>> longest([])\n\n    >>> longest(['a', 'b', 'c'])\n    'a'\n    >>> longest(['a', 'bb', 'ccc'])\n    'ccc'\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_str: Optional[str] = None\n    max_length: int = -1 # Initialize to -1 to ensure any valid string length (>=0) will be greater\n\n    for s in strings:\n        current_length = len(s)\n        if current_length > max_length:\n            max_length = current_length\n            longest_str = s\n    return longest_str"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\n\n\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\"\n    Returns the longest string from a list, or the first in case of ties.\n    Returns None if the input list is empty.\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_so_far = strings[0]\n    for s in strings[1:]:\n        if len(s) > len(longest_so_far):\n            longest_so_far = s\n\n    return longest_so_far"}
