{"task_id": "HumanEval/143", "solution": "from typing import List\nimport math\n\ndef split_words(sentence: str) -> List[str]:\n    \"\"\"Split sentence into words using space delimiter.\"\"\"\n    return sentence.split(' ')\n\ndef is_prime(n: int) -> bool:\n    \"\"\"Check if number n is prime. Returns False for n < 2.\"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    # Check for factors from 3 up to sqrt(n)\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        if n % i == 0:\n            return False\n    return True\n\ndef filter_prime_words(words: List[str]) -> List[str]:\n    \"\"\"Filter words list to include only those with prime length.\"\"\"\n    prime_length_words = []\n    for word in words:\n        if is_prime(len(word)):\n            prime_length_words.append(word)\n    return prime_length_words\n\ndef format_output(words: List[str]) -> str:\n    \"\"\"Join words with single spaces, return empty string if no words.\"\"\"\n    return ' '.join(words)\n\ndef words_in_sentence(sentence: str) -> str:\n    \"\"\"\n    Main function that filters words with prime-length from sentence.\n    It orchestrates splitting, filtering, and formatting the words.\n    \"\"\"\n    words = split_words(sentence)\n    prime_words = filter_prime_words(words)\n    result = format_output(prime_words)\n    return result"}
{"task_id": "HumanEval/143", "solution": "def _is_prime(number: int) -> bool:\n    \"\"\"Checks if a number is prime (natural number > 1 with exactly two divisors).\"\"\"\n    if number <= 1:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n    i = 3\n    while i * i <= number:\n        if number % i == 0:\n            return False\n        i += 2\n    return True\n\nclass _Word:\n    \"\"\"Represents an individual word, encapsulating its text and length.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n        self.length = len(text)\n\ndef _split_words_to_word_objects(sentence: str) -> list[_Word]:\n    \"\"\"Splits a sentence into a list of _Word objects, handling multiple spaces.\"\"\"\n    string_words = sentence.split()\n    return [_Word(text) for text in string_words]\n\ndef _filter_prime_words_objects(word_objects: list[_Word]) -> list[str]:\n    \"\"\"Filters _Word objects, returning text of those with prime lengths.\"\"\"\n    return [word.text for word in word_objects if _is_prime(word.length)]\n\ndef _join_with_spaces(words: list[str]) -> str:\n    \"\"\"Joins a list of strings into a single space-separated string.\"\"\"\n    return ' '.join(words)\n\ndef words_in_sentence(sentence: str) -> str:\n    \"\"\"\n    Filters words from a sentence, keeping only those whose character lengths are prime numbers.\n    Maintains the original word order in the output.\n    \"\"\"\n    word_objects = _split_words_to_word_objects(sentence)\n    filtered_words = _filter_prime_words_objects(word_objects)\n    result_string = _join_with_spaces(filtered_words)\n    return result_string"}
{"task_id": "HumanEval/144", "solution": "def parse_fraction(fraction_str: str) -> tuple[int, int]:\n    \"\"\"Parses a string fraction into its numerator and denominator.\n    It expects the format \"numerator/denominator\".\n    \"\"\"\n    numerator_str, denominator_str = fraction_str.split('/')\n    return int(numerator_str), int(denominator_str)\n\ndef multiply_fractions(num1: int, den1: int, num2: int, den2: int) -> tuple[int, int]:\n    \"\"\"Multiplies two fractions given their numerators and denominators.\n    Returns the resulting fraction as a (numerator, denominator) tuple.\n    \"\"\"\n    result_numerator = num1 * num2\n    result_denominator = den1 * den2\n    return result_numerator, result_denominator\n\ndef is_whole_number(numerator: int, denominator: int) -> bool:\n    \"\"\"Checks if a fraction represents a whole number.\n    It returns True if the numerator is perfectly divisible by the denominator.\n    \"\"\"\n    return numerator % denominator == 0\n\ndef simplify(x, n):\n    \"\"\"Determines if the multiplication of two string-formatted fractions results in a whole number.\n    It parses fractions, multiplies them, and then checks if the product is a whole number.\n    \"\"\"\n    x_num, x_den = parse_fraction(x)\n    n_num, n_den = parse_fraction(n)\n\n    result_num, result_den = multiply_fractions(x_num, x_den, n_num, n_den)\n\n    return is_whole_number(result_num, result_den)"}
{"task_id": "HumanEval/144", "solution": "def parse_fraction(fraction_str: str) -> tuple[int, int]:\n    \"\"\"Parses a fraction string into its numerator and denominator.\"\"\"\n    numerator_str, denominator_str = fraction_str.split('/')\n    return int(numerator_str), int(denominator_str)\n\ndef multiply_fractions(frac1: tuple[int, int], frac2: tuple[int, int]) -> tuple[int, int]:\n    \"\"\"Multiplies two fractions and returns the resulting fraction.\"\"\"\n    num1, den1 = frac1\n    num2, den2 = frac2\n    return num1 * num2, den1 * den2\n\ndef is_whole_number(fraction: tuple[int, int]) -> bool:\n    \"\"\"Determines if a fraction represents a whole number.\"\"\"\n    numerator, denominator = fraction\n    return numerator % denominator == 0\n\ndef simplify(x, n):\n    \"\"\"Implement a function that will simplify the expression x * n.\n    The function returns True if x * n evaluates to a whole number and False otherwise.\"\"\"\n    parsed_x = parse_fraction(x)\n    parsed_n = parse_fraction(n)\n    result_fraction = multiply_fractions(parsed_x, parsed_n)\n    return is_whole_number(result_fraction)"}
{"task_id": "HumanEval/145", "solution": "```python\ndef calculate_digit_sum(num):\n    \"\"\"\n    Helper function to calculate the sum of digits for a given integer.\n    Uses the absolute value of the number for calculation.\n    \"\"\"\n    s = str(abs(num))\n    digit_sum = 0\n    for digit_char in s:\n        digit_sum += int(digit_char)\n    return digit_sum\n\ndef order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers by the sum of their digits, maintaining original order for ties.\n    Returns a new sorted list based on digit sum and original index for stability.\n    \"\"\"\n    if not nums:\n        return []\n\n    # Pair each number with its calculated digit sum and original index.\n    # This preserves the original order information needed for stable sorting.\n    elements_with_sort_keys = []\n    for index, num in enumerate(nums):\n        current_digit_sum = calculate_digit_sum(num)\n        elements_with_sort_keys.append((num, current_digit_sum, index))\n\n    # Sort the list of tuples. The primary sort key is the digit sum,\n    # and the secondary key for stability is the original index.\n    sorted_elements = sorted(elements_with_sort_keys, key=lambda x: (x[1], x[2]))\n\n    # Extract only the original numbers from the sorted tuples to form the final result list.\n    result = [item[0] for item in sorted_elements]\n\n    return result\n```"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) from a generated array 'a'\n    such that i < j < k and their sum is a multiple of 3.\n    \"\"\"\n    \n    # Generate array 'a' of length n where a[idx] = (idx+1)*(idx+1) - (idx+1) + 1.\n    a = [(i + 1) * (i + 1) - (i + 1) + 1 for i in range(n)]\n\n    valid_triples_count = 0\n\n    # Iterate through all combinations of indices i, j, k such that i < j < k.\n    # This nested loop structure ensures O(n^3) time complexity.\n    for i in range(n):\n        for j in range(i + 1, n):\n            for k in range(j + 1, n):\n                # Calculate the sum of the triple elements.\n                current_sum = a[i] + a[j] + a[k]\n\n                # Check if the sum is a multiple of 3.\n                if current_sum % 3 == 0:\n                    valid_triples_count += 1\n                    \n    return valid_triples_count"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"Counts elements greater than 10 with odd first and last digits.\"\"\"\n\n    def _is_greater_than_10(number: int) -> bool:\n        \"\"\"Checks if a number is greater than 10.\"\"\"\n        return number > 10\n\n    def _extract_first_digit(number: int) -> int:\n        \"\"\"Extracts the first digit of a number's absolute value.\"\"\"\n        return int(str(abs(number))[0])\n\n    def _extract_last_digit(number: int) -> int:\n        \"\"\"Extracts the last digit of a number's absolute value.\"\"\"\n        return abs(number) % 10\n\n    def _is_odd_digit(digit: int) -> bool:\n        \"\"\"Checks if a digit is odd.\"\"\"\n        return digit % 2 != 0\n\n    count = 0\n    for num in nums:\n        if _is_greater_than_10(num):\n            first_digit = _extract_first_digit(num)\n            last_digit = _extract_last_digit(num)\n\n            if _is_odd_digit(first_digit) and _is_odd_digit(last_digit):\n                count += 1\n    return count"}
{"task_id": "HumanEval/146", "solution": "def is_greater_than_10(num):\n    \"\"\"Checks if a number is greater than 10.\n    Handles both integers and floating-point numbers.\n    \"\"\"\n    return num > 10\n\ndef get_first_digit(num):\n    \"\"\"Extracts the first digit from a number's absolute value.\n    Converts the absolute value to a string to get the first character.\n    \"\"\"\n    s = str(abs(num))\n    return int(s[0])\n\ndef get_last_digit(num):\n    \"\"\"Extracts the last digit from a number's absolute value.\n    Converts the absolute value to a string to get the last character.\n    \"\"\"\n    s = str(abs(num))\n    return int(s[-1])\n\ndef is_odd_digit(digit):\n    \"\"\"Checks if a given digit is an odd number (1, 3, 5, 7, 9).\n    This function validates the oddness of a single digit.\n    \"\"\"\n    return digit in [1, 3, 5, 7, 9]\n\ndef specialFilter(nums):\n    \"\"\"Counts numbers in an array that are greater than 10 and have both \n    first and last digits as odd numbers (1, 3, 5, 7, 9).\n    This function orchestrates helper functions for filtering.\n    \"\"\"\n    count = 0\n    for num in nums:\n        if is_greater_than_10(num):\n            first_digit = get_first_digit(num)\n            last_digit = get_last_digit(num)\n            if is_odd_digit(first_digit) and is_odd_digit(last_digit):\n                count += 1\n    return count"}
{"task_id": "HumanEval/145", "solution": "def extract_digits(num: int) -> list[int]:\n    \"\"\"Extracts individual digits from an integer's absolute value.\n    Converts the number to a string to get its digits.\"\"\"\n    return [int(d) for d in str(abs(num))]\n\ndef handle_negative(num: int) -> int:\n    \"\"\"Processes negative numbers by calculating the sum of their absolute digits.\n    This provides the adjusted digit sum as specified by the sequence diagram.\"\"\"\n    return sum(extract_digits(num))\n\ndef digit_sum_calculator(num: int) -> int:\n    \"\"\"Calculates the sum of digits for an integer, handling negative numbers.\n    For negative numbers, it utilizes the handle_negative utility.\"\"\"\n    if num >= 0:\n        return sum(extract_digits(num))\n    else:\n        return handle_negative(num)\n\ndef order_by_points(nums: list[int]) -> list[int]:\n    \"\"\"Sorts a list of integers based on the sum of their digits.\n    Maintains original order for elements with identical digit sums.\"\"\"\n    if not nums:\n        return []\n\n    # Pair each number with its original index to ensure stable sorting\n    indexed_nums = [(num, i) for i, num in enumerate(nums)]\n\n    # Sort the pairs. The key prioritizes digit sum, then the original index for stability.\n    sorted_indexed_nums = sorted(indexed_nums, key=lambda item: (digit_sum_calculator(item[0]), item[1]))\n\n    # Extract only the numbers from the sorted pairs\n    return [item[0] for item in sorted_indexed_nums]"}
{"task_id": "HumanEval/147", "solution": "def is_multiple_of_three(sum_value: int) -> bool:\n    \"\"\"Check if sum is divisible by 3.\"\"\"\n    return sum_value % 3 == 0\n\ndef calculate_element(i: int) -> int:\n    \"\"\"Calculate single array element using formula i*i - i + 1.\"\"\"\n    return i * i - i + 1\n\ndef generate_array(n: int) -> list[int]:\n    \"\"\"Create array of length n with formula-calculated values.\"\"\"\n    a = []\n    for i in range(1, n + 1):\n        a.append(calculate_element(i))\n    return a\n\ndef validate_input(n) -> bool:\n    \"\"\"Validate input parameter.\n    As per critical constraints, this function assumes input is valid.\n    \"\"\"\n    return True\n\ndef find_valid_triples(array: list[int]) -> int:\n    \"\"\"Find and count all valid triples with sum divisible by 3.\"\"\"\n    count = 0\n    array_length = len(array)\n    for i in range(array_length - 2):\n        for j in range(i + 1, array_length - 1):\n            for k in range(j + 1, array_length):\n                current_sum = array[i] + array[j] + array[k]\n                if is_multiple_of_three(current_sum):\n                    count += 1\n    return count\n\ndef get_max_triples(n: int) -> int:\n    \"\"\"Main algorithm entry point and orchestration.\n    Returns the count of valid triples where their sum is a multiple of 3.\n    \"\"\"\n    if not validate_input(n):\n        # This branch will not be taken due to validate_input's current implementation.\n        # It's included to adhere to the design's call structure.\n        return 0 \n    \n    generated_array = generate_array(n)\n    result_count = find_valid_triples(generated_array)\n    return result_count"}
{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    '''\n    Calculates planets located between two specified planets in our solar system.\n    Returns planets sorted by proximity to the sun, or an empty tuple for invalid inputs.\n    '''\n    PLANETS = (\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\")\n\n    if planet1 not in PLANETS or planet2 not in PLANETS:\n        return ()\n\n    idx1 = PLANETS.index(planet1)\n    idx2 = PLANETS.index(planet2)\n\n    start_idx = min(idx1, idx2)\n    end_idx = max(idx1, idx2)\n\n    # Slice the PLANETS tuple to get planets strictly between the two indices.\n    # The slice will be empty if start_idx + 1 >= end_idx.\n    result_planets = PLANETS[start_idx + 1 : end_idx]\n\n    return tuple(result_planets)"}
{"task_id": "HumanEval/149", "solution": "from typing import List\n\ndef _filter_even_length(strings: List[str]) -> List[str]:\n    \"\"\"Filter out strings with odd character lengths.\n    Returns a new list containing only even-length strings.\"\"\"\n    return [s for s in strings if len(s) % 2 == 0]\n\ndef _sort_by_length_and_alpha(strings: List[str]) -> List[str]:\n    \"\"\"Sort strings by length ascending, then alphabetically.\n    This uses a tuple as a sorting key for primary and secondary criteria.\"\"\"\n    return sorted(strings, key=lambda s: (len(s), s))\n\ndef sorted_list_sum(lst: List[str]) -> List[str]:\n    \"\"\"Main entry point for string list processing.\n    It filters for even length strings and then sorts them by length and alphabetically.\"\"\"\n    filtered_strings = _filter_even_length(lst)\n    sorted_strings = _sort_by_length_and_alpha(filtered_strings)\n    return sorted_strings"}
{"task_id": "HumanEval/150", "solution": "def is_prime(n: int) -> bool:\n    \"\"\"Checks if a given integer n is a prime number.\n    It efficiently handles small numbers and iterates up to sqrt(n) for larger ones.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:  # Covers 2 and 3\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n\ndef x_or_y(n, x, y):\n    \"\"\"Returns x if n is a prime number, otherwise returns y.\n    This function delegates prime number checking to a helper function.\n    \"\"\"\n    if is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/148", "solution": "PLANETS = (\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\")\n\ndef validate_planet(planet_name: str) -> bool:\n    \"\"\"Checks if a planet name is valid by comparing it to the known list.\"\"\"\n    return planet_name in PLANETS\n\ndef get_planet_position(planet_name: str) -> int:\n    \"\"\"Retrieves the numerical position of a planet (0-indexed) from the Sun.\"\"\"\n    return PLANETS.index(planet_name)\n\ndef calculate_between_planets(pos1: int, pos2: int) -> tuple:\n    \"\"\"Returns a tuple of planets located between two given orbital positions.\"\"\"\n    start_index = min(pos1, pos2)\n    end_index = max(pos1, pos2)\n    return PLANETS[start_index + 1:end_index]\n\ndef bf(planet1: str, planet2: str) -> tuple:\n    \"\"\"\n    Returns a tuple of planets whose orbits are between planet1 and planet2,\n    sorted by proximity to the Sun. Returns an empty tuple for invalid planet names.\n    \"\"\"\n    if not validate_planet(planet1) or not validate_planet(planet2):\n        return ()\n\n    pos1 = get_planet_position(planet1)\n    pos2 = get_planet_position(planet2)\n\n    return calculate_between_planets(pos1, pos2)"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    \"\"\"\n    Calculates the sum of squares of odd, positive integers from a list.\n    Filters out negative numbers and non-integers.\n    \"\"\"\n\n    def _is_valid_positive_integer(num):\n        # Checks if a number is a positive integer.\n        return isinstance(num, int) and num > 0\n\n    def _is_odd(num):\n        # Checks if an integer is odd.\n        return num % 2 != 0\n\n    def _calculate_square(num):\n        # Calculates the square of a number.\n        return num * num\n\n    total_sum = 0\n    for number in lst:\n        if _is_valid_positive_integer(number):\n            if _is_odd(number):\n                total_sum += _calculate_square(number)\n    return total_sum"}
{"task_id": "HumanEval/149", "solution": "from typing import List\n\ndef sorted_list_sum(lst: List[str]) -> List[str]:\n    \"\"\"\n    Filters odd-length strings and sorts the remaining by length then alphabetically.\n    This function processes a list of strings according to specified criteria.\n    \"\"\"\n    # Filter out strings with odd lengths, keeping only those with even lengths.\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n\n    # Sort the filtered strings first by length (ascending) and then alphabetically.\n    sorted_result = sorted(even_length_strings, key=lambda s: (len(s), s))\n\n    return sorted_result"}
{"task_id": "HumanEval/150", "solution": "```python\ndef is_prime(n):\n    \"\"\"Determines if a number is prime using an optimized trial division algorithm.\n    It efficiently checks for divisors up to the square root of n.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:  # Covers 2 and 3\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n\ndef x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n    \"\"\"\n    if is_prime(n):\n        return x\n    else:\n        return y\n```"}
{"task_id": "HumanEval/154", "solution": "def generate_rotations(s: str) -> list[str]:\n    \"\"\"Generates all possible rotations of the input string s.\n    Returns a list of all rotation variants.\"\"\"\n    if not s:\n        return [\"\"] # An empty string is its own only \"rotation\".\n    \n    rotations = []\n    n = len(s)\n    for i in range(n):\n        rotations.append(s[i:] + s[:i])\n    return rotations\n\ndef check_substring_match(main_str: str, rotations: list[str]) -> bool:\n    \"\"\"Checks if any string in the 'rotations' list exists as a substring in 'main_str'.\n    Returns True if a match is found, False otherwise.\"\"\"\n    for rotation in rotations:\n        if rotation in main_str:\n            return True\n    return False\n\ndef cycpattern_check(a: str, b: str) -> bool:\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word.\n    Performs case-sensitive string matching.\"\"\"\n    \n    # Generate all possible rotations of string b.\n    rotations_of_b = generate_rotations(b)\n    \n    # Check if any of these rotations are substrings of string a.\n    return check_substring_match(a, rotations_of_b)"}
