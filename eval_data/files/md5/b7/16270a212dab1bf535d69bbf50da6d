{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Write a function vowels_count which takes a string representing\n    a word as input and returns the number of vowels in the string.\n    Vowels in this case are 'a', 'e', 'i', 'o', 'u'. Here, 'y' is also a\n    vowel, but only when it is at the end of the given word.\n\n    Example:\n    >>> vowels_count(\"abcde\")\n    2\n    >>> vowels_count(\"ACEDY\")\n    3\n    \"\"\"\n    count = 0\n    standard_vowels = \"aeiou\"\n    \n    s_lower = s.lower()\n    n = len(s_lower)\n\n    for i, char in enumerate(s_lower):\n        if char in standard_vowels:\n            count += 1\n        elif char == 'y':\n            # 'y' is a vowel only when it is at the end of the given word.\n            if i == n - 1:\n                count += 1\n    return count"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s: str) -> int:\n    \"\"\"\n    Calculate sum of ASCII codes for uppercase characters in string.\n    Processes the input string, identifies uppercase characters, and sums their ASCII values.\n    \"\"\"\n    total_sum = 0\n    for char in s:\n        if char.isupper():\n            total_sum += ord(char)\n    return total_sum"}
{"task_id": "HumanEval/67", "solution": "```python\ndef fruit_distribution(s,n):\n    \"\"\"\n    Calculate mango fruits in basket given apple/orange distribution string and total count.\n    This function orchestrates parsing and mathematical computation.\n    \"\"\"\n    # Extract apple count using string parsing.\n    apple_count = _parse_apple_count(s)\n\n    # Extract orange count using string parsing.\n    orange_count = _parse_orange_count(s)\n\n    # Calculate mango count by subtracting known fruit counts from the total.\n    mango_count = n - apple_count - orange_count\n\n    return mango_count\n\ndef _parse_apple_count(s):\n    \"\"\"Extract apple count from the distribution string.\"\"\"\n    # Splits the string at \" apples\" and takes the first part, then converts to int.\n    return int(s.split(\" apples\")[0])\n\ndef _parse_orange_count(s):\n    \"\"\"Extract orange count from the distribution string.\"\"\"\n    # Splits by \" and \" to isolate the orange part, then splits by \" oranges\" and converts to int.\n    return int(s.split(\" and \")[1].split(\" oranges\")[0])\n```"}
{"task_id": "HumanEval/67", "solution": "def _parse_apple_count(s):\n    \"\"\"Extracts the number of apples from the input string.\n    It finds the position of \" apples\" and converts the preceding substring to an integer.\n    \"\"\"\n    end_idx = s.find(\" apples\")\n    apple_str = s[:end_idx].strip()\n    return int(apple_str)\n\ndef _parse_orange_count(s):\n    \"\"\"Extracts the number of oranges from the input string.\n    It locates the number between \" and \" and \" oranges\" and converts it to an integer.\n    \"\"\"\n    start_idx = s.find(\" and \") + len(\" and \")\n    end_idx = s.find(\" oranges\")\n    orange_str = s[start_idx:end_idx].strip()\n    return int(orange_str)\n\ndef fruit_distribution(s,n):\n    \"\"\"\n    Calculates the number of mango fruits in a basket.\n    It parses apple and orange counts from a string and subtracts them from the total.\n    \"\"\"\n    apples = _parse_apple_count(s)\n    oranges = _parse_orange_count(s)\n    mangoes = n - apples - oranges\n    return mangoes"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even value and its index in an array of non-negative integers.\n    If multiple such values exist, the one with the smallest index is chosen.\n    \"\"\"\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for index, value in enumerate(arr):\n        if value % 2 == 0:  # Check if the value is even\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = index\n            # If value == smallest_even_value, we do nothing as the existing\n            # smallest_even_index is already guaranteed to be the smallest index\n            # for that value due to left-to-right iteration.\n\n    if smallest_even_index == -1:\n        return []\n    else:\n        return [smallest_even_value, smallest_even_index]"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even value and its smallest index in an array.\n    Returns [value, index] or an empty list if no even values or the array is empty.\n    \"\"\"\n    smallest_even_value = None\n    smallest_even_index = None\n\n    for i, node in enumerate(arr):\n        if node % 2 == 0:  # Check if the node is even\n            if smallest_even_value is None or node < smallest_even_value:\n                smallest_even_value = node\n                smallest_even_index = i\n            # If node == smallest_even_value, its index `i` is guaranteed to be\n            # greater than or equal to `smallest_even_index` due to left-to-right iteration.\n            # So, we don't update if values are equal (keeping the first occurrence's index).\n\n    if smallest_even_value is not None:\n        return [smallest_even_value, smallest_even_index]\n    else:\n        return []"}
{"task_id": "HumanEval/69", "solution": "def _calculate_frequencies(lst):\n    '''\n    Calculates the frequency of each integer in the list.\n    Returns a dictionary mapping integers to their counts.\n    '''\n    frequencies = {}\n    for num in lst:\n        frequencies[num] = frequencies.get(num, 0) + 1\n    return frequencies\n\ndef _find_qualifying_integers(frequencies):\n    '''\n    Identifies integers where frequency is greater than or equal to the integer's value.\n    Returns a list of these qualifying integers.\n    '''\n    qualifying_candidates = []\n    for num, freq in frequencies.items():\n        if freq >= num:\n            qualifying_candidates.append(num)\n    return qualifying_candidates\n\ndef _get_maximum(candidates):\n    '''\n    Finds the largest integer in a list of candidates, or returns -1 if the list is empty.\n    This function handles the final result selection.\n    '''\n    if not candidates:\n        return -1\n    return max(candidates)\n\ndef search(lst):\n    '''\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than\n    zero, and has a frequency greater than or equal to the value of the integer itself.\n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    Examples:\n        search([4, 1, 2, 2, 3, 1]) == 2\n        search([1, 2, 2, 3, 3, 3, 4, 4, 4]) == 3\n        search([5, 5, 4, 4, 4]) == -1\n    '''\n    frequencies = _calculate_frequencies(lst)\n    qualifying_candidates = _find_qualifying_integers(frequencies)\n    result = _get_maximum(qualifying_candidates)\n    return result"}
{"task_id": "HumanEval/69", "solution": "def search(lst):\n    '''\n    Main algorithm coordinator and entry point.\n    Processes the list to find the greatest qualifying integer.\n    '''\n\n    def _calculate_frequency(lst):\n        '''\n        Calculate frequency of each integer in the list.\n        Returns a mapping of integer to its frequency count.\n        '''\n        frequency_map = {}\n        for num in lst:\n            frequency_map[num] = frequency_map.get(num, 0) + 1\n        return frequency_map\n\n    def _find_qualifying_integers(frequency_map):\n        '''\n        Identify integers where frequency is greater than or equal to the integer value.\n        Returns a list of such qualifying integers.\n        '''\n        qualifying = []\n        for num, freq in frequency_map.items():\n            if freq >= num:\n                qualifying.append(num)\n        return qualifying\n\n    def _get_maximum_qualifying(qualifying_integers):\n        '''\n        Return the maximum qualifying integer or -1 if none exist.\n        This function handles the final result selection.\n        '''\n        if not qualifying_integers:\n            return -1\n        return max(qualifying_integers)\n\n    frequency_map = _calculate_frequency(lst)\n    qualifying_integers = _find_qualifying_integers(frequency_map)\n    result = _get_maximum_qualifying(qualifying_integers)\n    return result"}
{"task_id": "HumanEval/70", "solution": "from typing import List\n\ndef strange_sort_list(lst: List[int]) -> List[int]:\n    \"\"\"\n    Sorts a list of integers using the strange sort algorithm.\n    It alternates between selecting the minimum and maximum remaining values.\n    \"\"\"\n    if not lst:\n        return []\n\n    remaining = lst[:]  # Create a mutable copy of the input list\n    result = []\n    is_min_turn = True\n\n    while remaining:\n        if is_min_turn:\n            # Find and append the minimum value from remaining\n            min_val = min(remaining)\n            result.append(min_val)\n            remaining.remove(min_val)\n        else:\n            # Find and append the maximum value from remaining\n            max_val = max(remaining)\n            result.append(max_val)\n            remaining.remove(max_val)\n\n        is_min_turn = not is_min_turn # Alternate selection for the next iteration\n\n    return result"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Starts with the minimum value, then alternates between maximum and minimum selections from remaining elements.\n    '''\n    if not lst:\n        return []\n\n    result = []\n    remaining_elements = list(lst) # Create a mutable copy to work with\n    is_min_turn = True\n\n    while remaining_elements:\n        if is_min_turn:\n            selected_value = min(remaining_elements)\n        else:\n            selected_value = max(remaining_elements)\n\n        result.append(selected_value)\n        remaining_elements.remove(selected_value)\n        is_min_turn = not is_min_turn\n\n    return result"}
{"task_id": "HumanEval/71", "solution": "import math\n\ndef _validate_triangle(a, b, c):\n    \"\"\"\n    Validates if three sides can form a valid triangle according to inequality rules.\n    Checks if all sides are positive and satisfy the triangle inequality.\n    \"\"\"\n    if a <= 0 or b <= 0 or c <= 0:\n        return False\n    return (a + b > c) and (a + c > b) and (b + c > a)\n\ndef _calculate_area(a, b, c):\n    \"\"\"\n    Calculates the area of a triangle using Heron's formula.\n    It assumes the input sides form a valid triangle.\n    \"\"\"\n    s = (a + b + c) / 2\n    # The term under the square root might be slightly negative due to floating point inaccuracies for degenerate triangles.\n    # We use max(0, ...) to prevent math.sqrt from raising a ValueError.\n    return math.sqrt(max(0, s * (s - a) * (s - b) * (s - c)))\n\ndef _round_to_two_decimals(area):\n    \"\"\"\n    Rounds a given area value to exactly two decimal places.\n    It returns the rounded float value.\n    \"\"\"\n    return round(area, 2)\n\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle.\n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater\n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    '''\n    if not _validate_triangle(a, b, c):\n        return -1\n    \n    raw_area = _calculate_area(a, b, c)\n    rounded_area = _round_to_two_decimals(raw_area)\n    return rounded_area"}
{"task_id": "HumanEval/71", "solution": "import math\n\ndef _validate_triangle_inequality(a, b, c):\n    \"\"\"\n    Checks if three given side lengths can form a valid triangle.\n    This includes ensuring all sides are positive and satisfy the triangle inequality.\n    \"\"\"\n    if a <= 0 or b <= 0 or c <= 0:\n        return False\n    return (a + b > c) and (a + c > b) and (b + c > a)\n\ndef _calculate_area_herons(a, b, c):\n    \"\"\"\n    Calculates the area of a triangle using Heron's formula.\n    It assumes the input side lengths form a valid triangle.\n    \"\"\"\n    s = (a + b + c) / 2\n    # Product can be slightly negative due to floating point precision for nearly degenerate triangles.\n    # Clamping to zero prevents math domain errors.\n    product = s * (s - a) * (s - b) * (s - c)\n    if product < 0:\n        product = 0\n    return math.sqrt(product)\n\ndef _round_to_two_decimals(value):\n    \"\"\"\n    Rounds a floating-point number to exactly two decimal places.\n    \"\"\"\n    return round(value, 2)\n\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    '''\n    if not _validate_triangle_inequality(a, b, c):\n        return -1\n    \n    area = _calculate_area_herons(a, b, c)\n    return _round_to_two_decimals(area)"}
{"task_id": "HumanEval/72", "solution": "def _is_palindromic(lst: list) -> bool:\n    \"\"\"\n    Checks if list is palindromic (reads same forwards and backwards).\n    This includes empty lists and single-element lists.\n    \"\"\"\n    return lst == lst[::-1]\n\ndef _calculate_sum(lst: list) -> float:\n    \"\"\"\n    Calculates sum of all elements in list.\n    Returns 0 for an empty list.\n    \"\"\"\n    return sum(lst)\n\ndef will_it_fly(q: list, w: float) -> bool:\n    \"\"\"\n    Determines if object will fly based on balance and weight.\n    Returns True if object is palindromic and sum <= weight limit, False otherwise.\n    \"\"\"\n    is_balanced = _is_palindromic(q)\n    total_weight = _calculate_sum(q)\n    return is_balanced and (total_weight <= w)"}
{"task_id": "HumanEval/72", "solution": "def _is_palindromic(q):\n    \"\"\"Checks if a list is palindromic with O(n) time and O(1) space.\"\"\"\n    left = 0\n    right = len(q) - 1\n    while left < right:\n        if q[left] != q[right]:\n            return False\n        left += 1\n        right -= 1\n    return True\n\ndef _calculate_sum(q):\n    \"\"\"Calculates the sum of all elements in a list.\"\"\"\n    total = 0\n    for item in q:\n        total += item\n    return total\n\ndef will_it_fly(q,w):\n    \"\"\"Determines if an object q will fly based on balance and weight constraints.\"\"\"\n    is_balanced = _is_palindromic(q)\n    total_weight = _calculate_sum(q)\n    return is_balanced and (total_weight <= w)"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Calculates the minimum changes needed to make an array palindromic using a two-pointer approach.\n    It counts mismatches between elements at symmetric positions.\n    \"\"\"\n    \n    if len(arr) <= 1:\n        return 0\n\n    changes = 0\n    left = 0\n    right = len(arr) - 1\n\n    while left < right:\n        if arr[left] != arr[right]:\n            changes += 1\n        left += 1\n        right -= 1\n\n    return changes"}
