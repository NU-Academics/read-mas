{"task_id": "HumanEval/74", "solution": "```python\ndef total_match(lst1: list[str], lst2: list[str]) -> list[str]:\n    \"\"\"\n    Compare two lists of strings by total character count.\n    Returns the list with fewer total characters, or the first list if counts are equal.\n    \"\"\"\n    chars_lst1 = sum(len(s) for s in lst1)\n    chars_lst2 = sum(len(s) for s in lst2)\n\n    if chars_lst1 <= chars_lst2:\n        return lst1\n    else:\n        return lst2\n```"}
{"task_id": "HumanEval/74", "solution": "def total_match(lst1, lst2):\n    \"\"\"\n    Compares two lists of strings by their total character count.\n    Returns the list with fewer total characters, or the first list if counts are equal.\n    \"\"\"\n    total1 = sum(len(s) for s in lst1)\n    total2 = sum(len(s) for s in lst2)\n\n    if total1 <= total2:\n        return lst1\n    else:\n        return lst2"}
{"task_id": "HumanEval/75", "solution": "def is_prime(number):\n    \"\"\"Checks if a given number is prime.\n    Numbers less than 2 are not considered prime.\"\"\"\n    if number < 2:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n    i = 3\n    while i * i <= number:\n        if number % i == 0:\n            return False\n        i += 2\n    return True\n\ndef get_prime_factors(number):\n    \"\"\"Decomposes a number into its prime factors, including repetitions.\n    It calls is_prime for each potential divisor to ensure primality.\"\"\"\n    factors = []\n    temp_num = number\n    d = 2\n    while d * d <= temp_num:\n        if is_prime(d):\n            while temp_num % d == 0:\n                factors.append(d)\n                temp_num //= d\n        d += 1\n    if temp_num > 1:\n        factors.append(temp_num)\n    return factors\n\ndef count_prime_factors(factors):\n    \"\"\"Counts the total number of prime factors in a given list.\n    This includes factors that are repeated.\"\"\"\n    return len(factors)\n\ndef is_multiply_prime(a):\n    \"\"\"Checks if a given number is the product of exactly three prime numbers.\n    The input number 'a' must be less than 100 and greater than 1.\"\"\"\n    if a >= 100 or a <= 1:\n        return False\n\n    factors = get_prime_factors(a)\n    count = count_prime_factors(factors)\n\n    return count == 3"}
{"task_id": "HumanEval/75", "solution": "```python\nimport math\n\ndef is_valid_range(a: int) -> bool:\n    \"\"\"Checks if input is within valid range (< 100).\"\"\"\n    return a < 100\n\ndef validate_input(a: int) -> bool:\n    \"\"\"Validates input parameter constraints, primarily its range.\"\"\"\n    return is_valid_range(a)\n\ndef is_prime(n: int) -> bool:\n    \"\"\"Determines if a given number is prime. Optimized for small numbers.\"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    # Check for odd divisors up to the square root of n.\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        if n % i == 0:\n            return False\n    return True\n\ndef get_prime_factors(n: int) -> list[int]:\n    \"\"\"Extracts all prime factors from a number, including repetitions.\"\"\"\n    factors = []\n    temp_n = n\n    \n    # Handle factor 2\n    while temp_n % 2 == 0:\n        factors.append(2)\n        temp_n //= 2\n    \n    # Handle odd factors starting from 3\n    d = 3\n    while d * d <= temp_n:\n        while temp_n % d == 0:\n            factors.append(d)\n            temp_n //= d\n        d += 2\n        \n    # If temp_n is still greater than 1, it must be a prime factor itself\n    if temp_n > 1:\n        factors.append(temp_n)\n        \n    return factors\n\ndef count_prime_factors(n: int) -> int:\n    \"\"\"Counts total number of prime factors, including repetitions. Returns 0 for numbers <= 1.\"\"\"\n    if n <= 1:\n        return 0\n    factors = get_prime_factors(n)\n    return len(factors)\n\ndef is_multiply_prime(a: int) -> bool:\n    \"\"\"Determines if the input number is the product of exactly 3 prime numbers.\"\"\"\n    if not validate_input(a):\n        return False\n    \n    # Numbers less than 8 cannot be a product of three primes (smallest is 2*2*2=8).\n    if a < 8:\n        return False\n            \n    num_factors = count_prime_factors(a)\n    return num_factors == 3\n```"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Your task is to write a function that returns true if a number x is a simple\n    power of n and false in other cases. x is a simple power of n if n**int=x\n    \"\"\"\n    if n <= 0:\n        return False\n    if x == 1:\n        return True\n    if x <= 0:\n        return False\n    if n == 1:\n        return False\n\n    current_x = x\n    while current_x % n == 0:\n        current_x //= n\n        if current_x == 1:\n            return True\n    return False"}
{"task_id": "HumanEval/77", "solution": "PRECISION_TOLERANCE = 1e-9\n\ndef _calculate_cube_root(value):\n    \"\"\"\n    Computes the real cube root of an integer, handling negative numbers.\n    It returns a float result.\n    \"\"\"\n    is_negative = value < 0\n    abs_value = abs(value)\n    root = abs_value ** (1/3)\n    return -root if is_negative else root\n\ndef _validate_perfect_cube(original, root):\n    \"\"\"\n    Validates if the given float root, when rounded and cubed, matches the original integer.\n    Floating point precision issues are handled using a tolerance.\n    \"\"\"\n    rounded_root = round(root)\n    cubed_value = rounded_root ** 3\n    return abs(original - cubed_value) < PRECISION_TOLERANCE\n\ndef iscube(a):\n    \"\"\"\n    Checks if an integer 'a' is a perfect cube of some integer number.\n    Handles positive, negative, and zero inputs efficiently.\n    \"\"\"\n    if a == 0:\n        return True\n    \n    cube_root_candidate = _calculate_cube_root(a)\n    return _validate_perfect_cube(a, cube_root_candidate)"}
{"task_id": "HumanEval/78", "solution": "PRIME_HEX_DIGITS = {'2', '3', '5', '7', 'B', 'D'}\n\ndef _is_prime_hex_digit(digit: str) -> bool:\n    \"\"\"Check if hexadecimal digit is prime.\n    \n    Returns True if digit represents prime number.\n    \"\"\"\n    return digit in PRIME_HEX_DIGITS\n\ndef hex_key(num: str) -> int:\n    \"\"\"Count prime hexadecimal digits in input string.\n    \n    Returns integer count of prime digits (2,3,5,7,B,D).\n    \"\"\"\n    if not num:\n        return 0\n\n    prime_count = 0\n    for char in num:\n        if _is_prime_hex_digit(char):\n            prime_count += 1\n    return prime_count"}
{"task_id": "HumanEval/77", "solution": "def _calculate_cube_root(a: int) -> int:\n    \"\"\"\n    Calculates the integer cube root of the absolute value of 'a'.\n    Returns a non-negative integer.\n    \"\"\"\n    abs_a = abs(a)\n    # Uses float conversion and power for cube root calculation as per design.\n    return round(float(abs_a) ** (1.0 / 3.0))\n\ndef _is_perfect_cube(original_a: int, abs_cube_root: int) -> bool:\n    \"\"\"\n    Validates if abs_cube_root, when cubed and signed, equals original_a.\n    'abs_cube_root' is expected to be non-negative.\n    \"\"\"\n    if original_a >= 0:\n        return abs_cube_root ** 3 == original_a\n    else:\n        # For negative original numbers, the cube root must also be negative.\n        return (-abs_cube_root) ** 3 == original_a\n\ndef iscube(a: int) -> bool:\n    \"\"\"\n    Determines if an integer 'a' is a perfect cube.\n    Handles positive, negative, and zero integers using helper functions.\n    \"\"\"\n    if a == 0:\n        return True\n\n    # Calculate the non-negative integer cube root using the helper.\n    calculated_root = _calculate_cube_root(a)\n\n    # Validate if it's a perfect cube using the helper.\n    return _is_perfect_cube(a, calculated_root)"}
{"task_id": "HumanEval/78", "solution": "PRIME_HEX_DIGITS = {'2', '3', '5', '7', 'B', 'D'}\n\ndef hex_key(num: str) -> int:\n    \"\"\"Counts prime hexadecimal digits (2, 3, 5, 7, B, D) in an input string.\n    Returns the total count of such digits.\n    \"\"\"\n    prime_digit_count = 0\n    for char in num:\n        if char in PRIME_HEX_DIGITS:\n            prime_digit_count += 1\n    return prime_digit_count"}
{"task_id": "HumanEval/76", "solution": "import math\n\n# A small tolerance for floating point comparisons to determine if a float is an integer.\n_EPSILON = 1e-9\n\ndef _validate_inputs(x, n):\n    \"\"\"\n    Validates the input parameters for mathematical power evaluation.\n    This helper function assumes valid numerical inputs due to critical constraints.\n    \"\"\"\n    # Per critical requirements, explicit type checks or exceptions are forbidden.\n    # We trust the caller provides numerical inputs suitable for calculations.\n    return True\n\ndef _calculate_power_relationship(x, n):\n    \"\"\"\n    Determines if x is a simple power of n, meaning n raised to an integer power equals x.\n    This function handles various numeric edge cases and uses logarithms for general cases.\n    \"\"\"\n    # Handle x = 1 (n**0 = 1 for any non-zero n)\n    if x == 1:\n        return True\n\n    # Handle n = 0\n    if n == 0:\n        # 0 raised to a positive integer is 0. 0 raised to 0 is 1 (convention).\n        # Since x=1 is handled above, if n=0, x must be 0 for it to be a simple power.\n        return x == 0\n\n    # Handle n = 1\n    if n == 1:\n        # 1 raised to any integer power is 1. Thus, x must be 1.\n        return x == 1\n\n    # Handle x = 0 (n is not 0, so n**k can never be 0)\n    if x == 0:\n        return False\n\n    # Now, x is not 0 or 1, and n is not 0 or 1.\n\n    # Case: n is positive (n > 1, since n=1 already handled)\n    if n > 0:\n        # If x is negative, a positive base cannot produce a negative result.\n        if x < 0:\n            return False\n        \n        # Both x and n are positive; use logarithms to find the exponent.\n        try:\n            exponent_float = math.log(x) / math.log(n)\n        except ValueError: # math.log(arg <= 0) - should be prevented by x>0, n>0\n            return False\n        except ZeroDivisionError: # math.log(1) for n=1 - already handled\n            return False\n\n        # Check if the exponent is an integer within a small tolerance.\n        rounded_exponent = round(exponent_float)\n        if abs(exponent_float - rounded_exponent) < _EPSILON:\n            # Final precision check: verify n raised to the integer exponent exactly equals x.\n            return abs(n**rounded_exponent - x) < _EPSILON\n        return False\n\n    # Case: n is negative (n < 0)\n    else: # n is negative\n        # Work with absolute values for logarithm, then check exponent parity for sign.\n        abs_n = abs(n)\n        abs_x = abs(x)\n\n        # Special sub-case for n = -1. It is critical for accurate handling.\n        if abs_n == 1: # This means n is -1\n            if x == 1:  # (-1)^even_int = 1\n                return True\n            elif x == -1: # (-1)^odd_int = -1\n                return True\n            return False\n\n        # For abs(n) > 1, use logarithms with absolute values.\n        try:\n            exponent_float = math.log(abs_x) / math.log(abs_n)\n        except ValueError: # log(arg <= 0)\n            return False\n        \n        # Check if the exponent is an integer within a small tolerance.\n        rounded_exponent = round(exponent_float)\n        if abs(exponent_float - rounded_exponent) < _EPSILON:\n            # Verify the actual power, taking sign into account for negative n.\n            # n^k must precisely match x.\n            actual_power = n**rounded_exponent\n            return abs(actual_power - x) < _EPSILON\n        return False\n\ndef is_simple_power(x, n):\n    \"\"\"Your task is to write a function that returns true if a number x is a simple\n    power of n and false in other cases.\n    x is a simple power of n if n**int=x\n    For example:\n    is_simple_power(1, 4) => true\n    is_simple_power(2, 2) => true\n    is_simple_power(8, 2) => true\n    is_simple_power(3, 2) => false\n    is_simple_power(3, 1) => false\n    is_simple_power(5, 3) => false\n    \"\"\"\n    # Validate inputs as per design, though minimal checks are performed due to constraints.\n    if not _validate_inputs(x, n):\n        return False\n    \n    # Delegate to the core logic for calculating the power relationship.\n    return _calculate_power_relationship(x, n)"}
{"task_id": "HumanEval/79", "solution": "def decimal_to_binary(decimal):\n    \"\"\"Converts a decimal number to a binary string with 'db' prefix and suffix.\n    Uses Python's built-in bin() function for conversion.\"\"\"\n    binary_representation = bin(decimal)\n    # Remove the '0b' prefix from the built-in bin() output\n    binary_digits = binary_representation[2:]\n    # Add 'db' prefix and suffix to the binary string\n    formatted_binary_string = \"db\" + binary_digits + \"db\"\n    return formatted_binary_string"}
{"task_id": "HumanEval/79", "solution": "```python\n#!/usr/bin/env python3\n\"\"\"\nDecimal to Binary Converter Module\n\nProvides functionality to convert decimal numbers to binary format\nwith 'db' prefix and suffix formatting.\n\"\"\"\n\ndef decimal_to_binary(decimal: int) -> str:\n    \"\"\"\n    Convert decimal number to binary format with 'db' delimiters.\n\n    Args:\n        decimal (int): Positive integer to convert to binary\n\n    Returns:\n        str: Binary representation formatted as 'db{binary_digits}db'\n\n    Examples:\n        >>> decimal_to_binary(15)\n        'db1111db'\n        >>> decimal_to_binary(32)\n        'db100000db'\n    \"\"\"\n    # Convert to binary and remove '0b' prefix\n    binary_str = bin(decimal)[2:]\n\n    # Format with 'db' prefix and suffix\n    return f\"db{binary_str}db\"\n```"}
{"task_id": "HumanEval/80", "solution": "def is_happy(s):\n    \"\"\"\n    Checks if a string is happy: at least 3 characters long and every 3 consecutive letters are distinct.\n    Returns True if happy, False otherwise.\n    \"\"\"\n    if len(s) < 3:\n        return False\n\n    for i in range(len(s) - 2):\n        # Check if the current group of three consecutive characters are all distinct\n        if s[i] == s[i+1] or s[i] == s[i+2] or s[i+1] == s[i+2]:\n            return False\n            \n    return True"}
