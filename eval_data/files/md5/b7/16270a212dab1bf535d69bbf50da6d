{"task_id": "HumanEval/44", "solution": "def _convert_to_base(x: int, base: int) -> str:\n    \"\"\"Performs the mathematical base conversion from decimal.\n    Returns the number as a string in the specified base.\n    \"\"\"\n    if x == 0:\n        return \"0\"\n\n    result = \"\"\n    while x > 0:\n        result = str(x % base) + result\n        x = x // base\n    return result\n\ndef change_base(x: int, base: int) -> str:\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    return _convert_to_base(x, base)"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int) -> str:\n    \"\"\"Converts a decimal integer x to a string representation in the specified base.\n    This function implements a standard division-remainder algorithm for base conversion.\n    \"\"\"\n    if x == 0:\n        return \"0\"\n\n    digits = []\n    while x > 0:\n        remainder = x % base\n        digits.append(str(remainder))\n        x //= base\n\n    return \"\".join(digits[::-1])"}
