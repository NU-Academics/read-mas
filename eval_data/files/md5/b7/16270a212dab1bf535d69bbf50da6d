{"task_id": "HumanEval/160", "solution": "def validate_operators(operator: list[str]) -> bool:\n    \"\"\"Checks if all operators are supported.\"\"\"\n    allowed_operators = {'+', '-', '*', '//', '**'}\n    return all(op in allowed_operators for op in operator)\n\ndef validate_operands(operand: list[int]) -> bool:\n    \"\"\"Checks if all operands are non-negative.\"\"\"\n    return all(op >= 0 for op in operand)\n\ndef validate_inputs(operator: list[str], operand: list[int]) -> bool:\n    \"\"\"Validates overall input constraints and delegates to sub-validators.\"\"\"\n    if not (len(operator) == len(operand) - 1 and len(operator) >= 1 and len(operand) >= 2):\n        return False\n    if not validate_operators(operator):\n        return False\n    if not validate_operands(operand):\n        return False\n    return True\n\ndef build_expression(operator: list[str], operand: list[int]) -> str:\n    \"\"\"Constructs a mathematical expression string from operators and operands.\"\"\"\n    expression_parts = []\n    for i in range(len(operator)):\n        expression_parts.append(str(operand[i]))\n        expression_parts.append(operator[i])\n    expression_parts.append(str(operand[-1]))\n    return \" \".join(expression_parts)\n\ndef evaluate_expression(expression: str) -> int:\n    \"\"\"Evaluates a mathematical expression string.\"\"\"\n    return eval(expression)\n\ndef do_algebra(operator: list[str], operand: list[int]) -> int:\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and \n    the second list is a list of integers. Use the two given lists to build the algebric \n    expression and return the evaluation of this expression.\n    \"\"\"\n    if not validate_inputs(operator, operand):\n        raise ValueError(\"Invalid input parameters provided.\")\n    \n    expression_string = build_expression(operator, operand)\n    result = evaluate_expression(expression_string)\n    return result"}
{"task_id": "HumanEval/161", "solution": "def is_letter(char: str) -> bool:\n    \"\"\"Determines if a character is alphabetic.\"\"\"\n    return char.isalpha()\n\ndef toggle_case(char: str) -> str:\n    \"\"\"Converts a letter's case (upper to lower, lower to upper).\"\"\"\n    return char.swapcase()\n\ndef has_letters(s: str) -> bool:\n    \"\"\"Checks if the string contains any alphabetic characters.\"\"\"\n    for char in s:\n        if is_letter(char):\n            return True\n    return False\n\ndef reverse_string(s: str) -> str:\n    \"\"\"Reverses the order of characters in a string.\"\"\"\n    return s[::-1]\n\ndef solve(s):\n    \"\"\"Processes string input by either converting letter cases or reversing the string.\n    If the string has letters, it converts their case; otherwise, it reverses the string.\n    \"\"\"\n    if has_letters(s):\n        processed_chars = []\n        for char in s:\n            if is_letter(char):\n                processed_chars.append(toggle_case(char))\n            else:\n                processed_chars.append(char)\n        return \"\".join(processed_chars)\n    else:\n        return reverse_string(s)"}
{"task_id": "HumanEval/161", "solution": "def is_letter(char: str) -> bool:\n    \"\"\"Checks if a single character is an alphabetic letter.\"\"\"\n    return char.isalpha()\n\ndef reverse_case(char: str) -> str:\n    \"\"\"Reverses the case of a single letter character.\"\"\"\n    if char.islower():\n        return char.upper()\n    return char.lower()\n\ndef has_letters(s: str) -> bool:\n    \"\"\"Determines if the string contains any letter characters.\"\"\"\n    for char in s:\n        if is_letter(char):\n            return True\n    return False\n\ndef solve(s: str) -> str:\n    \"\"\"Processes input strings by reversing letter case or reversing the entire string.\"\"\"\n    if has_letters(s):\n        result_chars = []\n        for char in s:\n            if is_letter(char):\n                result_chars.append(reverse_case(char))\n            else:\n                result_chars.append(char)\n        return \"\".join(result_chars)\n    else:\n        return s[::-1]"}
{"task_id": "HumanEval/159", "solution": "def eat(number: int, need: int, remaining: int) -> list[int]:\n    \"\"\"\n    Calculates carrot consumption for a hungry rabbit, returning total eaten and carrots left.\n    The rabbit eats the minimum of its need or available stock.\n    \"\"\"\n    \n    consumed_carrots = min(need, remaining)\n    \n    total_eaten = number + consumed_carrots\n    \n    carrots_left = remaining - consumed_carrots\n    \n    return [total_eaten, carrots_left]"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator: list[str], operand: list[int]) -> int:\n    \"\"\"\n    Evaluates an algebraic expression built from operator and operand lists.\n    It orchestrates input validation, expression building, and evaluation.\n    \"\"\"\n\n    # --- Math Operations Handler (Core Operations Layer) ---\n    def _execute_addition(left: int, right: int) -> int:\n        \"\"\"Performs addition.\"\"\"\n        return left + right\n\n    def _execute_subtraction(left: int, right: int) -> int:\n        \"\"\"Performs subtraction.\"\"\"\n        return left - right\n\n    def _execute_multiplication(left: int, right: int) -> int:\n        \"\"\"Performs multiplication.\"\"\"\n        return left * right\n\n    def _execute_floor_division(left: int, right: int) -> int:\n        \"\"\"Performs floor division.\"\"\"\n        return left // right\n\n    def _execute_exponentiation(left: int, right: int) -> int:\n        \"\"\"Performs exponentiation.\"\"\"\n        return left ** right\n\n    _OPERATORS_MAP = {\n        '+': _execute_addition,\n        '-': _execute_subtraction,\n        '*': _execute_multiplication,\n        '//': _execute_floor_division,\n        '**': _execute_exponentiation\n    }\n\n    # --- Input Validator (Validation Layer - No-op due to critical constraints) ---\n    def _validate_operator_list_length(operator: list[str], operand: list[int]) -> None:\n        \"\"\"Performs list length validation; does not raise exceptions due to constraints.\"\"\"\n        pass\n\n    def _validate_minimum_operands(operand: list[int]) -> None:\n        \"\"\"Performs minimum operands validation; does not raise exceptions due to constraints.\"\"\"\n        pass\n\n    def _validate_minimum_operators(operator: list[str]) -> None:\n        \"\"\"Performs minimum operators validation; does not raise exceptions due to constraints.\"\"\"\n        pass\n\n    def _validate_non_negative_operands(operand: list[int]) -> None:\n        \"\"\"Performs non-negative operands validation; does not raise exceptions due to constraints.\"\"\"\n        pass\n\n    def _validate_supported_operators(operator: list[str]) -> None:\n        \"\"\"Performs supported operators validation; does not raise exceptions due to constraints.\"\"\"\n        pass\n\n    # --- Expression Builder (Expression Processing Layer) ---\n    def _interleave_operators_operands(operator_list: list[str], operand_list: list[int]) -> str:\n        \"\"\"Interleaves operators and operands into a space-separated string.\"\"\"\n        expression_parts = []\n        for i in range(len(operator_list)):\n            expression_parts.append(str(operand_list[i]))\n            expression_parts.append(operator_list[i])\n        expression_parts.append(str(operand_list[-1]))\n        return \" \".join(expression_parts)\n\n    def _build_expression_string(operator_list: list[str], operand_list: list[int]) -> str:\n        \"\"\"Constructs an algebraic expression string from lists of operators and operands.\"\"\"\n        return _interleave_operators_operands(operator_list, operand_list)\n\n    # --- Expression Evaluator (Expression Processing Layer) ---\n    def _get_operator_precedence(op_str: str) -> int:\n        \"\"\"Returns the precedence level for a given operator.\"\"\"\n        if op_str == '**': return 3\n        if op_str in ('*', '//'): return 2\n        if op_str in ('+', '-'): return 1\n        return 0\n\n    def _tokenize_expression(expr_str: str) -> list:\n        \"\"\"Tokenizes an algebraic expression string into numbers and operators.\"\"\"\n        tokens = []\n        current_num = \"\"\n        i = 0\n        while i < len(expr_str):\n            char = expr_str[i]\n            if char.isdigit():\n                current_num += char\n            else:\n                if current_num:\n                    tokens.append(int(current_num))\n                    current_num = \"\"\n                \n                if char == '*' and i + 1 < len(expr_str) and expr_str[i+1] == '*':\n                    tokens.append('**')\n                    i += 1\n                elif char == '/' and i + 1 < len(expr_str) and expr_str[i+1] == '/':\n                    tokens.append('//')\n                    i += 1\n                elif char.strip(): # Add single char operator if not a space\n                    tokens.append(char)\n            i += 1\n        \n        if current_num:\n            tokens.append(int(current_num))\n        return tokens\n\n    def _apply_operator_precedence(expression_tokens: list) -> int:\n        \"\"\"Evaluates a list of tokens applying standard operator precedence rules.\"\"\"\n        operands_stack = []\n        operators_stack = []\n\n        for token in expression_tokens:\n            if isinstance(token, int):\n                operands_stack.append(token)\n            elif token in _OPERATORS_MAP:\n                current_op_precedence = _get_operator_precedence(token)\n                while (operators_stack and\n                       _get_operator_precedence(operators_stack[-1]) >= current_op_precedence and\n                       not (token == '**' and operators_stack[-1] == '**')): # Right-associativity for **\n                    op = operators_stack.pop()\n                    right = operands_stack.pop()\n                    left = operands_stack.pop()\n                    operands_stack.append(_OPERATORS_MAP[op](left, right))\n                operators_stack.append(token)\n        \n        while operators_stack:\n            op = operators_stack.pop()\n            right = operands_stack.pop()\n            left = operands_stack.pop()\n            operands_stack.append(_OPERATORS_MAP[op](left, right))\n        \n        return operands_stack[0]\n\n    def _evaluate_with_precedence(expr_str: str) -> int:\n        \"\"\"Tokenizes and evaluates an algebraic expression string considering precedence.\"\"\"\n        tokens = _tokenize_expression(expr_str)\n        return _apply_operator_precedence(tokens)\n\n    # --- Function Interface Layer (do_algebra orchestration) ---\n\n    # 1. Validation Layer (calls to no-op functions)\n    _validate_operator_list_length(operator, operand)\n    _validate_minimum_operands(operand)\n    _validate_minimum_operators(operator)\n    _validate_non_negative_operands(operand)\n    _validate_supported_operators(operator)\n\n    # 2. Expression Processing Layer - Build\n    expression_string = _build_expression_string(operator, operand)\n\n    # 3. Expression Processing Layer - Evaluate\n    result = _evaluate_with_precedence(expression_string)\n    \n    return result"}
{"task_id": "HumanEval/163", "solution": "def _normalize_range(a: int, b: int) -> tuple[int, int]:\n    \"\"\"Normalizes the input range to ensure start is less than or equal to end.\"\"\"\n    return (min(a, b), max(a, b))\n\ndef _extract_even_digits(start: int, end: int) -> list[int]:\n    \"\"\"Extracts even single digits within the given normalized range.\"\"\"\n    even_digits = []\n    # Only consider numbers in the single-digit range for extraction.\n    # The iteration range covers all possible single digits (0-9)\n    # that could fall within the specified start and end.\n    for i in range(max(0, start), min(10, end + 1)):\n        if i % 2 == 0:\n            even_digits.append(i)\n    return even_digits\n\ndef generate_integers(a: int, b: int) -> list[int]:\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n\n    For example:\n    generate_integers(2, 8) => [2, 4, 6, 8]\n    generate_integers(8, 2) => [2, 4, 6, 8]\n    generate_integers(10, 14) => []\n    \"\"\"\n    start, end = _normalize_range(a, b)\n    result = _extract_even_digits(start, end)\n    return result"}
