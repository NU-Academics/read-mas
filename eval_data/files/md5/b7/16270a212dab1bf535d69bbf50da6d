{"task_id": "HumanEval/33", "solution": "def sort_third(l: list) -> list:\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at\n    the indicies that are divisible by three are equal to the values of\n    the corresponding indicies of l, but sorted.\n    \"\"\"\n    n = len(l)\n    if n == 0:\n        return []\n\n    divisible_indices = []\n    extracted_elements = []\n    result = [None] * n\n\n    for i in range(n):\n        if i % 3 == 0:\n            divisible_indices.append(i)\n            extracted_elements.append(l[i])\n        else:\n            result[i] = l[i]\n\n    sorted_extracted_elements = sorted(extracted_elements)\n\n    for i, original_index in enumerate(divisible_indices):\n        result[original_index] = sorted_extracted_elements[i]\n\n    return result"}
{"task_id": "HumanEval/33", "solution": "def _validate_input(l: list) -> bool:\n    \"\"\"Validates input parameter is a proper list.\n    Due to constraints, this function simply returns True.\"\"\"\n    return True\n\ndef _get_divisible_indices(length: int) -> list[int]:\n    \"\"\"Calculates all indices divisible by three from 0 up to length-1.\"\"\"\n    indices = []\n    for i in range(length):\n        if i % 3 == 0:\n            indices.append(i)\n    return indices\n\ndef _extract_elements(l: list, indices: list[int]) -> list:\n    \"\"\"Extracts elements from the list l at the specified indices.\"\"\"\n    elements = []\n    for index in indices:\n        elements.append(l[index])\n    return elements\n\ndef _sort_elements(elements: list) -> list:\n    \"\"\"Sorts elements in ascending order using a stable sort.\"\"\"\n    return sorted(elements)\n\ndef _reconstruct_list(original: list, sorted_elements: list, indices: list[int]) -> list:\n    \"\"\"Rebuilds the list with sorted elements at their original divisible-by-three positions.\"\"\"\n    reconstructed = list(original) # Create a copy to preserve other elements.\n    \n    for i, index in enumerate(indices):\n        reconstructed[index] = sorted_elements[i]\n        \n    return reconstructed\n\ndef sort_third(l: list) -> list:\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    \"\"\"\n    \n    _validate_input(l) # Input validation as per design.\n    \n    if not l: # Handle edge case: empty list.\n        return []\n        \n    length = len(l)\n    \n    divisible_indices = _get_divisible_indices(length)\n    \n    extracted_elements = _extract_elements(l, divisible_indices)\n    \n    sorted_elements = _sort_elements(extracted_elements)\n    \n    result_list = _reconstruct_list(l, sorted_elements, divisible_indices)\n    \n    return result_list"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    total_count = 0\n\n    def _is_divisible_by_11_or_13(number: int) -> bool:\n        \"\"\"Checks if a number is divisible by 11 or 13.\n        This helper function verifies the divisibility condition.\"\"\"\n        return number % 11 == 0 or number % 13 == 0\n\n    def _count_digit_7_in_number(number: int) -> int:\n        \"\"\"Counts occurrences of the digit 7 in a given number.\n        The number is converted to a string to facilitate digit checking.\"\"\"\n        count = 0\n        num_str = str(number)\n        for digit_char in num_str:\n            if digit_char == '7':\n                count += 1\n        return count\n\n    for i in range(n):\n        if _is_divisible_by_11_or_13(i):\n            total_count += _count_digit_7_in_number(i)\n\n    return total_count"}
{"task_id": "HumanEval/36", "solution": "from typing import List\n\ndef _extract_digits(number: int) -> List[int]:\n    \"\"\"Extracts individual digits from a number as a list of integers.\n    This function handles both positive and negative numbers by processing their absolute value.\n    \"\"\"\n    if number == 0:\n        return [0]\n    digits = []\n    # Handle negative numbers by taking the absolute value\n    num_str = str(abs(number))\n    for char_digit in num_str:\n        digits.append(int(char_digit))\n    return digits\n\ndef _count_digit_7_in_number(number: int) -> int:\n    \"\"\"Counts occurrences of the digit 7 in a single number.\n    It utilizes the _extract_digits helper function.\n    \"\"\"\n    digits = _extract_digits(number)\n    return digits.count(7)\n\ndef _is_divisible_by_11_or_13(number: int) -> bool:\n    \"\"\"Determines if a number is divisible by 11 or 13.\n    Returns True if the number is divisible by either 11 or 13.\n    \"\"\"\n    return number % 11 == 0 or number % 13 == 0\n\ndef fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    This function orchestrates the process by iterating through numbers and applying helper functions.\n    \"\"\"\n    total_sevens_count = 0\n    for number in range(1, n):  # Iterate from 1 up to n-1\n        if _is_divisible_by_11_or_13(number):\n            total_sevens_count += _count_digit_7_in_number(number)\n    return total_sevens_count"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list) -> list:\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    def extract_even_elements(l_input: list) -> list:\n        \"\"\"Extracts elements at even indices from a list.\"\"\"\n        even_elements = []\n        for i in range(len(l_input)):\n            if i % 2 == 0:\n                even_elements.append(l_input[i])\n        return even_elements\n\n    def extract_odd_elements(l_input: list) -> list:\n        \"\"\"Extracts elements at odd indices along with their positions from a list.\"\"\"\n        odd_elements = []\n        for i in range(len(l_input)):\n            if i % 2 != 0:\n                odd_elements.append((i, l_input[i]))\n        return odd_elements\n\n    def merge_elements(sorted_even: list, odd_elements: list, original_length: int) -> list:\n        \"\"\"Merges sorted even elements and preserved odd elements into a new list.\"\"\"\n        result = [None] * original_length\n        for index, value in odd_elements:\n            result[index] = value\n\n        even_idx_counter = 0\n        for i in range(original_length):\n            if i % 2 == 0:\n                result[i] = sorted_even[even_idx_counter]\n                even_idx_counter += 1\n        return result\n\n    if not l:\n        return []\n    if len(l) == 1:\n        return list(l) # Return a new list to match expected behavior of creating a new list.\n\n    even_elements_to_sort = extract_even_elements(l)\n    odd_elements_with_indices = extract_odd_elements(l)\n    \n    sorted_even_elements = sorted(even_elements_to_sort)\n    \n    return merge_elements(sorted_even_elements, odd_elements_with_indices, len(l))"}
{"task_id": "HumanEval/37", "solution": "def _validate_input(l: list) -> str:\n    \"\"\"Validates the input list for its length.\n    Returns 'empty', 'single', or 'valid' based on the list's size.\"\"\"\n    if len(l) == 0:\n        return \"empty\"\n    elif len(l) == 1:\n        return \"single\"\n    else:\n        return \"valid\"\n\ndef _extract_even_values(l: list) -> list:\n    \"\"\"Extracts values located at even indices (0, 2, 4, ...) from the input list.\n    These values are collected into a new list and returned.\"\"\"\n    even_values = []\n    for i in range(0, len(l), 2):\n        even_values.append(l[i])\n    return even_values\n\ndef _create_result_list(original: list, sorted_even: list) -> list:\n    \"\"\"Constructs the final list by preserving values from odd indices of the original list.\n    Sorted values are then inserted into the corresponding even indices.\"\"\"\n    result = list(original) # Create a shallow copy to retain odd indexed values\n    sorted_even_idx = 0\n    for i in range(len(original)):\n        if i % 2 == 0:\n            result[i] = sorted_even[sorted_even_idx]\n            sorted_even_idx += 1\n    return result\n\ndef sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    validation_status = _validate_input(l)\n\n    if validation_status == \"empty\":\n        return []\n    elif validation_status == \"single\":\n        return l\n    else: # \"valid\" multi-element list\n        even_values = _extract_even_values(l)\n        sorted_even_values = sorted(even_values)\n        final_list = _create_result_list(l, sorted_even_values)\n        return final_list"}
{"task_id": "HumanEval/38", "solution": "def encode_cyclic(s: str):\n    \"\"\"\n    returns encoded string by cycling groups of three characters.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[1:] + group[0]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)\n\n\ndef decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # reverse cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[2] + group[0] + group[1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/38", "solution": "def _split_into_groups(s: str) -> list:\n    \"\"\"Split string into groups of up to 3 characters.\"\"\"\n    return [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n\ndef _cycle_group_forward(group: str) -> str:\n    \"\"\"Move first character to end if group has exactly 3 characters.\"\"\"\n    return (group[1:] + group[0]) if len(group) == 3 else group\n\ndef _cycle_group_backward(group: str) -> str:\n    \"\"\"Move last character to front if group has exactly 3 characters.\"\"\"\n    return (group[-1] + group[:-1]) if len(group) == 3 else group\n\ndef encode_cyclic(s: str) -> str:\n    \"\"\"\n    returns encoded string by cycling groups of three characters.\n    \"\"\"\n    groups = _split_into_groups(s)\n    cycled_groups = [_cycle_group_forward(group) for group in groups]\n    return \"\".join(cycled_groups)\n\ndef decode_cyclic(s: str) -> str:\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    groups = _split_into_groups(s)\n    decoded_groups = [_cycle_group_backward(group) for group in groups]\n    return \"\".join(decoded_groups)"}
{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n\n    def is_prime(num: int) -> bool:\n        \"\"\"\n        Checks if a given number is prime.\n        Returns True if prime, False otherwise.\n        \"\"\"\n        if num <= 1:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    def fibonacci_generator():\n        \"\"\"\n        Generates Fibonacci numbers indefinitely, starting with 0, 1.\n        Yields each subsequent Fibonacci number.\n        \"\"\"\n        a, b = 0, 1\n        yield a\n        yield b\n        while True:\n            a, b = b, a + b\n            yield b\n\n    found_primes_count = 0\n    fib_gen = fibonacci_generator()\n\n    while True:\n        current_fib = next(fib_gen)\n        # Fibonacci numbers less than 2 (0, 1) are not prime.\n        # We start checking from the number 2 in the sequence.\n        if current_fib < 2:\n            continue\n\n        if is_prime(current_fib):\n            found_primes_count += 1\n            if found_primes_count == n:\n                return current_fib"}
{"task_id": "HumanEval/39", "solution": "import math\n\ndef is_prime(num: int) -> bool:\n    \"\"\"Check if a number is prime.\n    Returns True if the number is prime, False otherwise.\"\"\"\n    if num < 2:\n        return False\n    if num == 2:\n        return True\n    if num % 2 == 0:\n        return False\n    for i in range(3, int(math.sqrt(num)) + 1, 2):\n        if num % i == 0:\n            return False\n    return True\n\ndef fibonacci_generator():\n    \"\"\"Generate Fibonacci numbers in sequence, starting from F_1=1.\"\"\"\n    a, b = 0, 1\n    while True:\n        yield b\n        a, b = b, a + b\n\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    count = 0\n    fib_gen = fibonacci_generator()\n    while True:\n        fib_num = next(fib_gen)\n        if is_prime(fib_num):\n            count += 1\n            if count == n:\n                return fib_num"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list) -> bool:\n    \"\"\"\n    Checks if three distinct elements in the list sum to zero.\n    Distinct elements are identified by their position (index).\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    for i in range(n - 2):\n        for j in range(i + 1, n - 1):\n            for k in range(j + 1, n):\n                if l[i] + l[j] + l[k] == 0:\n                    return True\n    return False"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n\n    >>> triples_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> triples_sum_to_zero([1, 3, -2, 1])\n    True\n    >>> triples_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> triples_sum_to_zero([2, 4, -5, 3, 9, 7])\n    True\n    >>> triples_sum_to_zero([1])\n    False\n    \"\"\"\n    def _validate_input_size(l_param: list) -> bool:\n        \"\"\"Checks if the input list has a minimum of three elements.\n        Returns True if size is sufficient, False otherwise.\n        \"\"\"\n        return len(l_param) >= 3\n\n    def _generate_combinations(l_param: list):\n        \"\"\"Generates all possible combinations of three distinct indices (i, j, k) from the list.\n        Each combination ensures i < j < k for distinct positions.\n        \"\"\"\n        n = len(l_param)\n        for i in range(n):\n            for j in range(i + 1, n):\n                for k in range(j + 1, n):\n                    yield (i, j, k)\n\n    def _calculate_sum(a: int, b: int, c: int) -> int:\n        \"\"\"Calculates the sum of three given integers.\n        Returns the integer sum.\n        \"\"\"\n        return a + b + c\n\n    def _has_zero_sum_triple(l_param: list) -> bool:\n        \"\"\"Iterates through all three-element combinations to check if any sum to zero.\n        Returns True if a zero-sum triple is found, False otherwise.\n        \"\"\"\n        for i, j, k in _generate_combinations(l_param):\n            if _calculate_sum(l_param[i], l_param[j], l_param[k]) == 0:\n                return True\n        return False\n\n    if not _validate_input_size(l):\n        return False\n\n    return _has_zero_sum_triple(l)"}
