{"task_id": "HumanEval/25", "solution": "from typing import List\n\ndef factorize(n: int) -> List[int]:\n    \"\"\"Return an ordered list of prime factors for a positive integer.\n    Each factor is included based on its multiplicity in the factorization.\n    \"\"\"\n    factors: List[int] = []\n    d: int = 2\n    temp_n: int = n\n\n    while d * d <= temp_n:\n        while temp_n % d == 0:\n            factors.append(d)\n            temp_n //= d\n        d += 1\n\n    if temp_n > 1:\n        factors.append(temp_n)\n\n    return factors"}
{"task_id": "HumanEval/27", "solution": "def flip_case(string: str) -> str:\n    \"\"\" For a given string, flip lowercase characters to uppercase and uppercase to lowercase.\n    >>> flip_case('Hello')\n    'hELLO'\n    \"\"\"\n    transformed_chars = []\n    for char in string:\n        if char.islower():\n            transformed_chars.append(char.upper())\n        elif char.isupper():\n            transformed_chars.append(char.lower())\n        else:\n            transformed_chars.append(char)\n    return \"\".join(transformed_chars)"}
{"task_id": "HumanEval/27", "solution": "def flip_case(string: str) -> str:\n    \"\"\" For a given string, flip lowercase characters to uppercase and uppercase to lowercase.\n    >>> flip_case('Hello')\n    'hELLO'\n    \"\"\"\n    flipped_chars = []\n    for char in string:\n        if char.isalpha():\n            if char.islower():\n                flipped_chars.append(char.upper())\n            else:  # char is uppercase\n                flipped_chars.append(char.lower())\n        else:  # char is not alphabetic\n            flipped_chars.append(char)\n    return \"\".join(flipped_chars)"}
{"task_id": "HumanEval/25", "solution": "from typing import List\n\n\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    \"\"\"\n    factors: List[int] = []\n    d = 2\n    temp_n = n\n\n    while temp_n > 1:\n        while temp_n % d == 0:\n            factors.append(d)\n            temp_n //= d\n        d += 1\n        # Optimization: if d*d exceeds temp_n, the remaining temp_n must be prime.\n        if d * d > temp_n and temp_n > 1:\n            factors.append(temp_n)\n            break\n    \n    return factors"}
