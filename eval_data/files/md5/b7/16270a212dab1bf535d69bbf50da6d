{"task_id": "HumanEval/31", "solution": "```python\ndef is_prime(n: int) -> bool:\n    \"\"\"Return true if a given number is prime, and false otherwise.\n\n    Args:\n        n (int): The number to check for primality\n\n    Returns:\n        bool: True if n is prime, False otherwise\n\n    Examples:\n        >>> is_prime(6)\n        False\n        >>> is_prime(101)\n        True\n        >>> is_prime(11)\n        True\n        >>> is_prime(13441)\n        True\n        >>> is_prime(61)\n        True\n        >>> is_prime(4)\n        False\n        >>> is_prime(1)\n        False\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n```"}
{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True"}
{"task_id": "HumanEval/32", "solution": "import math\n\nclass MathEngine:\n    \"\"\"Provides fundamental mathematical operations.\"\"\"\n    def power(self, base: float, exponent: int) -> float:\n        \"\"\"Calculates base raised to the power of exponent.\"\"\"\n        return math.pow(base, exponent)\n\n    def sum_terms(self, terms: list) -> float:\n        \"\"\"Sums a list of numerical terms.\"\"\"\n        return sum(terms)\n\nclass PolynomialEvaluator:\n    \"\"\"Evaluates a polynomial at a given point.\"\"\"\n    def __init__(self, coefficients: list):\n        \"\"\"Initializes with polynomial coefficients.\"\"\"\n        self.coefficients = coefficients\n        self.math_engine = MathEngine()\n\n    def _calculate_term(self, coeff: float, x: float, power: int) -> float:\n        \"\"\"Calculates a single term of the polynomial.\"\"\"\n        return coeff * self.math_engine.power(x, power)\n\n    def evaluate_at(self, x: float) -> float:\n        \"\"\"Evaluates the polynomial at point x.\"\"\"\n        terms = [self._calculate_term(coeff, x, i) for i, coeff in enumerate(self.coefficients)]\n        return self.math_engine.sum_terms(terms)\n\ndef poly(xs: list, x: float) -> float:\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    This function uses the PolynomialEvaluator to perform its calculation.\n    \"\"\"\n    evaluator = PolynomialEvaluator(xs)\n    return evaluator.evaluate_at(x)\n\nclass ZeroFinder:\n    \"\"\"Finds a single zero point for a polynomial.\"\"\"\n    def __init__(self, coefficients: list):\n        \"\"\"Initializes with polynomial coefficients.\"\"\"\n        self.coefficients = coefficients\n        self.evaluator = PolynomialEvaluator(coefficients)\n        self.math_engine = MathEngine()\n\n    def _has_even_coefficient_count(self) -> bool:\n        \"\"\"Checks if the number of coefficients is even.\"\"\"\n        return len(self.coefficients) % 2 == 0\n\n    def _has_nonzero_largest_coefficient(self) -> bool:\n        \"\"\"Checks if the largest coefficient is non-zero.\"\"\"\n        return self.coefficients and self.coefficients[-1] != 0\n\n    def _validate_constraints(self) -> bool:\n        \"\"\"Validates zero-finding constraints.\"\"\"\n        return self._has_even_coefficient_count() and \\\n               self._has_nonzero_largest_coefficient()\n\n    def _get_derivative_coeffs(self) -> list:\n        \"\"\"\n        Calculates coefficients of the polynomial's derivative.\n        The derivative of c_i*x^i is i*c_i*x^(i-1).\n        \"\"\"\n        # Exclude constant term (i=0) as its derivative is 0.\n        derivative_coeffs = [i * coeff for i, coeff in enumerate(self.coefficients) if i > 0]\n        return derivative_coeffs\n\n    def find_single_zero(self) -> float:\n        \"\"\"\n        Applies the Newton-Raphson method to find one zero.\n        It assumes valid inputs as per critical requirements.\n        \"\"\"\n        self._validate_constraints() # Constraints are checked but no exception is raised.\n\n        x_guess = 1.0  # Initial guess for the iterative method.\n        tolerance = 1e-7\n        max_iterations = 100\n\n        derivative_coeffs = self._get_derivative_coeffs()\n        derivative_evaluator = PolynomialEvaluator(derivative_coeffs)\n\n        for _ in range(max_iterations):\n            f_x = self.evaluator.evaluate_at(x_guess)\n            \n            if abs(f_x) < tolerance:\n                return x_guess\n\n            f_prime_x = derivative_evaluator.evaluate_at(x_guess)\n\n            # Safeguard against division by zero for numerical stability.\n            if abs(f_prime_x) < 1e-15:\n                 x_guess += 0.01 # Nudge the guess if derivative is too flat.\n                 continue\n\n            x_guess = x_guess - (f_x / f_prime_x)\n\n        return x_guess # Return the best guess after max iterations.\n\ndef find_zero(xs: list) -> float:\n    \"\"\"\n    Finds a single zero point for a polynomial with coefficients xs.\n    Constraints include an even coefficient count and a non-zero largest coefficient.\n    \"\"\"\n    finder = ZeroFinder(xs)\n    return finder.find_single_zero()"}
{"task_id": "HumanEval/32", "solution": "import math\nfrom typing import List\n\n\ndef power(base: float, exp: int) -> float:\n    \"\"\"Wrapper for math.pow with integer exponents.\n    This function computes base raised to the power of exp.\n    \"\"\"\n    return math.pow(base, exp)\n\n\ndef evaluate_polynomial(coeffs: List[float], x: float) -> float:\n    \"\"\"Core polynomial evaluation using standard formula.\n    It sums up terms of the form coeff * x^i for each coefficient.\n    \"\"\"\n    return sum([coeff * power(x, i) for i, coeff in enumerate(coeffs)])\n\n\ndef derivative_coefficients(coeffs: List[float]) -> List[float]:\n    \"\"\"Calculates derivative coefficients for root finding.\n    Derivative of a_0 + a_1*x + ... + a_n*x^n is a_1 + 2*a_2*x + ... + n*a_n*x^(n-1).\n    \"\"\"\n    if not coeffs or len(coeffs) == 1:\n        return []\n    \n    return [coeffs[i] * i for i in range(1, len(coeffs))]\n\n\ndef poly(xs: List[float], x: float) -> float:\n    \"\"\"Evaluates polynomial with coefficients xs at point x.\n    This function utilizes the core polynomial evaluation logic.\n    \"\"\"\n    return evaluate_polynomial(xs, x)\n\n\ndef _validate_even_coefficients(xs: List[float]) -> bool:\n    \"\"\"Validates that coefficient list has an even number of elements.\n    This is a prerequisite for guaranteed root finding with find_zero.\n    \"\"\"\n    return len(xs) % 2 == 0\n\n\ndef _validate_nonzero_largest(xs: List[float]) -> bool:\n    \"\"\"Validates that the largest coefficient (highest power) is non-zero.\n    This ensures the polynomial is of the stated degree for root finding.\n    \"\"\"\n    return xs[-1] != 0 if xs else False\n\n\ndef _newton_raphson_method(xs: List[float]) -> float:\n    \"\"\"Implements the Newton-Raphson method for finding a polynomial root.\n    It iteratively refines an initial guess using function value and derivative.\n    \"\"\"\n    x_current = 1.0  # Initial guess\n    tolerance = 1e-6\n    max_iterations = 100\n\n    for _ in range(max_iterations):\n        f_x = evaluate_polynomial(xs, x_current)\n        \n        deriv_coeffs = derivative_coefficients(xs)\n        f_prime_x = evaluate_polynomial(deriv_coeffs, x_current)\n\n        if abs(f_prime_x) < 1e-10: \n            # If derivative is near zero, return current estimate as per constraints.\n            return x_current \n        \n        x_next = x_current - f_x / f_prime_x\n        \n        if abs(x_next - x_current) < tolerance:\n            return x_next\n        \n        x_current = x_next\n    \n    return x_current # Return best estimate after max iterations\n\n\ndef find_zero(xs: List[float]) -> float:\n    \"\"\"Finds a zero point of a polynomial, given its coefficients.\n    It first performs implicit validation checks and then applies Newton-Raphson.\n    \"\"\"\n    _validate_even_coefficients(xs)\n    _validate_nonzero_largest(xs)\n    \n    return _newton_raphson_method(xs)"}
