{"task_id": "HumanEval/54", "solution": "def same_chars(s0: str, s1: str) -> bool:\n    \"\"\"\n    Check if two words have the same characters.\n    This function compares the unique character sets of two input strings.\n\n    Args:\n        s0 (str): First input string\n        s1 (str): Second input string\n\n    Returns:\n        bool: True if both strings contain the same unique characters, False otherwise\n\n    Examples:\n        >>> same_chars('eabcdzzzz', 'dddzzzzzzzddeddabc')\n        True\n        >>> same_chars('abcd', 'dddddddabc')\n        True\n        >>> same_chars('dddddddabc', 'abcd')\n        True\n        >>> same_chars('eabcd', 'dddddddabc')\n        False\n        >>> same_chars('abcd', 'dddddddabce')\n        False\n        >>> same_chars('eabcdzzzz', 'dddzzzzzzzddddabc')\n        False\n        >>> same_chars('', '')\n        True\n        >>> same_chars('a', '')\n        False\n        >>> same_chars('hello', 'olleh')\n        True\n        >>> same_chars('r\u00e9sum\u00e9', 'resum\u00e9')\n        False\n        >>> same_chars('hello', 'HELLO')\n        False\n    \"\"\"\n    return set(s0) == set(s1)"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list) -> bool:\n    \"\"\"Return True if list elements are monotonically increasing or decreasing.\n    This function checks if the sequence is non-decreasing or non-increasing.\n\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    >>> monotonic([])\n    True\n    >>> monotonic([5])\n    True\n    >>> monotonic([1, 1, 1])\n    True\n    >>> monotonic([1, 2, 2, 3])\n    True\n    >>> monotonic([3, 2, 2, 1])\n    True\n    \"\"\"\n    if len(l) <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(1, len(l)):\n        if l[i] < l[i - 1]:\n            is_increasing = False\n        if l[i] > l[i - 1]:\n            is_decreasing = False\n        \n        # If it's neither increasing nor decreasing, we can stop early.\n        if not is_increasing and not is_decreasing:\n            return False\n\n    return is_increasing or is_decreasing"}
{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str) -> bool:\n    \"\"\" brackets is a string of \"<\" and \">\".\n    Return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '<':\n            balance += 1\n        elif char == '>':\n            if balance == 0:\n                return False  # Unmatched closing bracket\n            balance -= 1\n    return balance == 0  # True if all brackets are balanced and nested"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True if list elements are monotonically increasing or decreasing.\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    >>> monotonic([])\n    True\n    >>> monotonic([5])\n    True\n    >>> monotonic([1, 1, 1])\n    True\n    >>> monotonic([5, 4, 4, 3])\n    True\n    \"\"\"\n    if len(l) <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(1, len(l)):\n        if l[i] < l[i-1]:\n            is_increasing = False\n        if l[i] > l[i-1]:\n            is_decreasing = False\n            \n    return is_increasing or is_decreasing"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\n    >>> common([1, 4, 3, 34, 653, 2, 5], [5, 7, 1, 5, 9, 653, 121])\n    [1, 5, 653]\n    >>> common([5, 3, 2, 8], [3, 2])\n    [2, 3]\n    \"\"\"\n    # Implementation using set intersection and sorting\n    return sorted(list(set(l1).intersection(set(l2))))"}
{"task_id": "HumanEval/58", "solution": "```python\ndef common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\n    >>> common([1, 4, 3, 34, 653, 2, 5], [5, 7, 1, 5, 9, 653, 121])\n    [1, 5, 653]\n    >>> common([5, 3, 2, 8], [3, 2])\n    [2, 3]\n\n    \"\"\"\n    set1 = set(l1)\n    set2 = set(l2)\n    common_elements = set1.intersection(set2)\n    return sorted(common_elements)\n```"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int) -> int:\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    largest_factor = 1\n\n    # Divide by 2 until n is odd\n    while n % 2 == 0:\n        largest_factor = 2\n        n //= 2\n\n    # Check for odd factors from 3 up to sqrt(n)\n    d = 3\n    while d * d <= n:\n        while n % d == 0:\n            largest_factor = d\n            n //= d\n        d += 2\n\n    # If n is still greater than 1, it must be the largest prime factor\n    if n > 1:\n        largest_factor = n\n\n    return largest_factor"}
{"task_id": "HumanEval/59", "solution": "```python\ndef largest_prime_factor(n: int) -> int:\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    def _is_prime(num: int) -> bool:\n        \"\"\"Checks if a number is prime. This helper function is used for factor validation.\"\"\"\n        if num <= 1:\n            return False\n        if num <= 3:\n            return True\n        if num % 2 == 0 or num % 3 == 0:\n            return False\n        i = 5\n        while i * i <= num:\n            if num % i == 0 or num % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def _find_prime_factors(n: int) -> list[int]:\n        \"\"\"Computes all prime factors of a given number, validating primality with a helper.\"\"\"\n        factors = []\n        current_n = n\n\n        # Handle factor 2, explicitly checking primality as per design.\n        while current_n % 2 == 0:\n            if _is_prime(2):\n                factors.append(2)\n            current_n //= 2\n\n        # Handle odd factors, explicitly checking primality as per design.\n        d = 3\n        while d * d <= current_n:\n            while current_n % d == 0:\n                if _is_prime(d):\n                    factors.append(d)\n                current_n //= d\n            d += 2\n\n        # If current_n is still greater than 1, it must be a prime factor itself.\n        if current_n > 1:\n            if _is_prime(current_n):\n                factors.append(current_n)\n        return factors\n\n    prime_factors = _find_prime_factors(n)\n    return max(prime_factors)\n```"}
{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int) -> int:\n    \"\"\"sum_to_n is a function that sums numbers from 1 to n.\n    >>> sum_to_n(30)\n    465\n    >>> sum_to_n(100)\n    5050\n    >>> sum_to_n(5)\n    15\n    >>> sum_to_n(10)\n    55\n    >>> sum_to_n(1)\n    1\n    \"\"\"\n    # Calculate the sum using the arithmetic series formula.\n    # Integer division (//) is used to ensure an integer result, as per the type hint.\n    return n * (n + 1) // 2"}
{"task_id": "HumanEval/60", "solution": "```python\ndef sum_to_n(n: int) -> int:\n    \"\"\"sum_to_n is a function that sums numbers from 1 to n.\n    >>> sum_to_n(30)\n    465\n    >>> sum_to_n(100)\n    5050\n    >>> sum_to_n(5)\n    15\n    >>> sum_to_n(10)\n    55\n    >>> sum_to_n(1)\n    1\n    \"\"\"\n    return n * (n + 1) // 2\n```"}
{"task_id": "HumanEval/61", "solution": "def correct_bracketing(brackets: str) -> bool:\n    \"\"\" brackets is a string of \"(\" and \")\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n\n    def check_nesting_order_util(s: str) -> bool:\n        \"\"\"Checks if brackets are properly nested, preventing closing an unopen bracket.\"\"\"\n        open_count = 0\n        for char in s:\n            if char == '(':\n                open_count += 1\n            elif char == ')':\n                if open_count == 0:\n                    return False\n                open_count -= 1\n        return True\n\n    def count_brackets_util(s: str) -> tuple:\n        \"\"\"Counts the total number of open and close brackets in a string.\"\"\"\n        open_count = 0\n        close_count = 0\n        for char in s:\n            if char == '(':\n                open_count += 1\n            elif char == ')':\n                close_count += 1\n        return (open_count, close_count)\n\n    def is_balanced_util(open_count: int, close_count: int) -> bool:\n        \"\"\"Checks if the total number of open brackets equals the total close brackets.\"\"\"\n        return open_count == close_count\n\n    if not brackets:\n        return True\n\n    if not check_nesting_order_util(brackets):\n        return False\n\n    open_total, close_total = count_brackets_util(brackets)\n    return is_balanced_util(open_total, close_total)"}
{"task_id": "HumanEval/61", "solution": "def correct_bracketing(brackets: str) -> bool:\n    \"\"\" brackets is a string of \"(\" and \")\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    counter = 0\n    for char in brackets:\n        if char == '(':\n            counter += 1\n        elif char == ')':\n            counter -= 1\n        if counter < 0:\n            return False\n    return counter == 0"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list) -> list:\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\n     Return derivative of this polynomial in the same form.\n    >>> derivative([3, 1, 2, 4, 5])\n    [1, 4, 12, 20]\n    >>> derivative([1, 2, 3])\n    [2, 6]\n    \"\"\"\n    # If the polynomial has one or zero terms, it is a constant or empty; its derivative is an empty polynomial.\n    if len(xs) <= 1:\n        return []\n\n    # Apply the power rule: the derivative of a*x^n is n*a*x^(n-1).\n    # The new coefficient for the x^(i-1) term is i * xs[i], iterating from the x^1 term onwards.\n    derivative_coefficients = [xs[i] * i for i in range(1, len(xs))]\n    return derivative_coefficients"}
{"task_id": "HumanEval/63", "solution": "```python\nfrom typing import Dict\n\n# Module-level cache for memoization, storing computed FibFib values.\n_cache: Dict[int, int] = {}\n\ndef fibfib(n: int) -> int:\n    \"\"\"Computes the n-th FibFib number efficiently using memoization.\n    It handles base cases fibfib(0)=0, fibfib(1)=0, fibfib(2)=1 and uses the triple-recursive formula for n>=3.\n    \"\"\"\n    if n in _cache:\n        return _cache[n]\n\n    if n == 0 or n == 1:\n        result = 0\n    elif n == 2:\n        result = 1\n    else:\n        result = fibfib(n - 1) + fibfib(n - 2) + fibfib(n - 3)\n    \n    _cache[n] = result\n    return result\n```"}
{"task_id": "HumanEval/62", "solution": "```python\ndef derivative(xs: list) -> list:\n    \"\"\"\n    xs represent coefficients of a polynomial: xs[0] + xs[1] * x + xs[2] * x^2 + ....\n    Returns derivative coefficients using the power rule, skipping the constant term.\n    >>> derivative([3, 1, 2, 4, 5])\n    [1, 4, 12, 20]\n    >>> derivative([1, 2, 3])\n    [2, 6]\n    \"\"\"\n    # For each term a*x^n (where 'a' is xs[i] and 'n' is 'i'), the derivative is n*a*x^(n-1).\n    # We iterate from the second coefficient (index 1) as the constant term (index 0) vanishes.\n    return [i * xs[i] for i in range(1, len(xs))]\n\n```"}
{"task_id": "HumanEval/63", "solution": "```python\ndef fibfib(n: int) -> int:\n    \"\"\"The FibFib number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fibfib(0) == 0\n    fibfib(1) == 0\n    fibfib(2) == 1\n    fibfib(n) == fibfib(n-1) + fibfib(n-2) + fibfib(n-3).\n    Please write a function to efficiently compute the n-th element of the fibfib number sequence.\n    >>> fibfib(1)\n    0\n    >>> fibfib(5)\n    4\n    >>> fibfib(8)\n    24\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 1\n    else:\n        # Initialize the base cases for n=0, n=1, n=2.\n        # These will represent fibfib(i-3), fibfib(i-2), fibfib(i-1) respectively.\n        f_n_minus_3 = 0  # Corresponds to fibfib(0) initially\n        f_n_minus_2 = 0  # Corresponds to fibfib(1) initially\n        f_n_minus_1 = 1  # Corresponds to fibfib(2) initially\n\n        # Iterate from the third term up to n, calculating each term iteratively.\n        for _ in range(3, n + 1):\n            current_fibfib = f_n_minus_1 + f_n_minus_2 + f_n_minus_3\n            # Update values for the next iteration by shifting them.\n            f_n_minus_3 = f_n_minus_2\n            f_n_minus_2 = f_n_minus_1\n            f_n_minus_1 = current_fibfib\n        \n        # After the loop, f_n_minus_1 holds the computed fibfib(n).\n        return f_n_minus_1\n```"}
{"task_id": "HumanEval/65", "solution": "```python\ndef circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string. If shift > number of digits, return digits reversed.\n    \"\"\"\n    s_x = str(abs(x))\n    digit_count = len(s_x)\n\n    if shift > digit_count:\n        return s_x[::-1]\n    else:\n        effective_shift = shift % digit_count\n        return s_x[digit_count - effective_shift:] + s_x[:digit_count - effective_shift]\n```"}
{"task_id": "HumanEval/65", "solution": "def validate_integer(x) -> bool:\n    \"\"\"Validates if the input x is an integer.\"\"\"\n    # CRITICAL REQUIREMENT: Trust caller's inputs, no isinstance checks.\n    return True\n\ndef validate_shift(shift) -> bool:\n    \"\"\"Validates if the input shift is an integer.\"\"\"\n    # CRITICAL REQUIREMENT: Trust caller's inputs, no isinstance checks.\n    return True\n\ndef extract_digits(x: int) -> list:\n    \"\"\"Extracts digits from an integer into a list.\"\"\"\n    if x == 0:\n        return [0]\n    s = str(abs(x))\n    return [int(d) for d in s]\n\ndef count_digits(x: int) -> int:\n    \"\"\"Counts the number of digits in an integer.\"\"\"\n    if x == 0:\n        return 1\n    return len(str(abs(x)))\n\ndef shift_right(digits: list, positions: int) -> list:\n    \"\"\"Performs a circular right shift on a list of digits.\"\"\"\n    if not digits:\n        return []\n    n = len(digits)\n    actual_shift = positions % n\n    return digits[-actual_shift:] + digits[:-actual_shift]\n\ndef reverse_digits(digits: list) -> list:\n    \"\"\"Reverses the order of digits in a list.\"\"\"\n    return digits[::-1]\n\ndef format_as_string(digits: list) -> str:\n    \"\"\"Formats a list of digits into a string.\"\"\"\n    return \"\".join(str(d) for d in digits)\n\ndef circular_shift(x: int, shift: int) -> str:\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    >>> circular_shift(12, 1)\n    \"21\"\n    >>> circular_shift(12, 2)\n    \"12\"\n    \"\"\"\n    validate_integer(x)\n    validate_shift(shift)\n\n    digits = extract_digits(x)\n    digit_count = count_digits(x)\n\n    if shift > digit_count:\n        processed_digits = reverse_digits(digits)\n    else:\n        processed_digits = shift_right(digits, shift)\n    \n    return format_as_string(processed_digits)"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Counts vowels in a string, treating 'y' as a vowel only at the end.\n    Vowels are 'a', 'e', 'i', 'o', 'u' (case-insensitive).\n    \"\"\"\n    count = 0\n    s_lower = s.lower()\n    vowels = {'a', 'e', 'i', 'o', 'u'}\n\n    for i, char in enumerate(s_lower):\n        if char in vowels:\n            count += 1\n        elif char == 'y' and i == len(s_lower) - 1:\n            count += 1\n    return count"}
