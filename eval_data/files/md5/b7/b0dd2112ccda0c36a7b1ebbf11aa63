{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '<':\n            balance += 1\n        elif char == '>':\n            balance -= 1\n        \n        # If balance goes negative, it means a closing bracket appeared without a corresponding opening bracket.\n        if balance < 0:\n            return False\n            \n    # For correct bracketing, the final balance must be zero.\n    return balance == 0"}
