{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Checks if a number is the product of exactly three distinct prime numbers.\"\"\"\n    if a < 2:\n        return False\n\n    factors = []\n    temp_a = a\n    d = 2\n    while d * d <= temp_a:\n        if temp_a % d == 0:\n            factors.append(d)\n            temp_a //= d\n        else:\n            d += 1\n    if temp_a > 1:\n        factors.append(temp_a)\n\n    # A number is a \"multiplication of 3 prime numbers\" if it has exactly three\n    # prime factors in its factorization (counting multiplicity) AND these three\n    # factors are distinct, as implied by the example and design context.\n    return len(factors) == 3 and len(set(factors)) == 3"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100.\n    \"\"\"\n\n    def _is_prime(n):\n        # A simple deterministic algorithm (trial division) to check primality.\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    # Input Validation: a must be an integer, 2 <= a < 100.\n    if not isinstance(a, int) or a < 2 or a >= 100:\n        return False\n\n    factors = []\n    temp_a = a\n    i = 2\n\n    # Prime Factorization: Iterate over potential prime divisors up to sqrt(temp_a).\n    while i * i <= temp_a:\n        if _is_prime(i):  # Only attempt division by actual primes\n            while temp_a % i == 0:\n                factors.append(i)\n                temp_a //= i\n        i += 1\n\n    # If temp_a is still greater than 1, it means the remaining temp_a is a prime factor.\n    if temp_a > 1:\n        factors.append(temp_a)\n\n    # Count Factors: Check if the number of prime factors is exactly three.\n    return len(factors) == 3"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"\n    Checks if x is a simple power of n (n**k == x for some non-negative integer k).\n    Handles edge cases for non-positive x or n, and n equals 1.\n    \"\"\"\n    if n <= 0 or x <= 0:\n        return False\n    if n == 1:\n        return x == 1\n    while x % n == 0:\n        x //= n\n    return x == 1"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    '''\n    Checks if an integer is a perfect cube.\n    Handles positive, negative, and zero inputs.\n    '''\n    if a == 0:\n        return True\n    \n    # Calculate the integer cube root of the absolute value.\n    # Using round() helps mitigate floating-point inaccuracies.\n    root = round(abs(a)**(1/3))\n    \n    # Reconstruct the cube and compare with the original number.\n    # Handle the sign correctly.\n    if a < 0:\n        return (-root)**3 == a\n    else:\n        return root**3 == a"}
{"task_id": "HumanEval/76", "solution": "```python\ndef is_simple_power(x, n):\n    \"\"\"Returns true if a number x is a simple power of n (n**k = x for integer k >= 0).\n\n    For example:\n    is_simple_power(1, 4) => true\n    is_simple_power(2, 2) => true\n    is_simple_power(8, 2) => true\n    is_simple_power(3, 2) => false\n    is_simple_power(3, 1) => false\n    is_simple_power(5, 3) => false\n    \"\"\"\n    # Case 1: x is 1. Any non-zero n raised to the power of 0 is 1.\n    # By convention, 0**0 is often 1, so this covers all bases for x=1.\n    if x == 1:\n        return True\n\n    # Case 2: x is not 1. Handle special values for n.\n    # If n is 0: 0^k (for k > 0) is 0. Since x != 1, if x is 0, it's a power (0^1=0). Otherwise, false.\n    if n == 0:\n        return x == 0\n\n    # If n is 1: 1^k is always 1. Since x != 1, x cannot be a power of 1.\n    if n == 1:\n        return False\n\n    # If n is -1: (-1)^k can only be 1 (for even k) or -1 (for odd k).\n    # Since x != 1, if x is -1, it's a power (e.g., (-1)^1 = -1). Otherwise, false.\n    if n == -1:\n        return x == -1\n\n    # At this point: x is not 1, 0. n is not 0, 1, -1.\n    # This implies abs(n) > 1.\n    # We are looking for n**k = x where k >= 1 (since k=0 (x=1) is already handled).\n\n    # If x and n have different signs, and n is positive, it's impossible for n**k = x for k >= 1.\n    # If x is negative and n is positive (n > 1), then n^k (k>=1) will always be positive.\n    if x < 0 and n > 1:\n        return False\n    \n    # Repeatedly divide x by n. If x is a power of n, this process should eventually lead to 1.\n    temp_x = x\n    while temp_x != 1:\n        if temp_x % n != 0:\n            return False\n        temp_x //= n\n    \n    return True\n```"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    \"\"\"\n    Checks if an integer is a perfect cube using binary search.\n    Handles both positive and negative integers, and zero.\n    \"\"\"\n    if a == 0:\n        return True\n\n    is_negative = a < 0\n    abs_a = abs(a)\n\n    low = 0\n    high = 1291  # Max possible cube root for a 32-bit integer is around 1290.\n\n    while low <= high:\n        mid = (low + high) // 2\n        \n        # Avoid overflow for mid * mid * mid if mid is large, though 1290**3 fits in a standard integer.\n        # This check is more robust for larger potential ranges.\n        if mid > abs_a**(1/3) + 2: # Heuristic to prevent unnecessary large calculations, but also be careful with floating point.\n            high = mid - 1\n            continue\n\n        cube = mid * mid * mid\n\n        if cube == abs_a:\n            return True\n        elif cube < abs_a:\n            low = mid + 1\n        else: # cube > abs_a\n            high = mid - 1\n            \n    return False"}
