{"task_id": "HumanEval/137", "solution": "def compare_one(a, b):\n    \"\"\"\n    Compares two numbers (int, float, or numeric string) and returns the larger.\n    Returns None if the values are equal, preserving original types.\n    \"\"\"\n\n    class Number:\n        \"\"\"Abstract base class for numeric representations.\"\"\"\n        def get_comparable_value(self):\n            raise NotImplementedError\n        def get_original(self):\n            raise NotImplementedError\n\n    class Integer(Number):\n        \"\"\"Represents an integer value.\"\"\"\n        def __init__(self, value):\n            self._value = value\n        def get_comparable_value(self):\n            return float(self._value)\n        def get_original(self):\n            return self._value\n\n    class Float(Number):\n        \"\"\"Represents a float value.\"\"\"\n        def __init__(self, value):\n            self._value = value\n        def get_comparable_value(self):\n            return self._value\n        def get_original(self):\n            return self._value\n\n    class NumericString(Number):\n        \"\"\"Represents a string that can be parsed as a number.\"\"\"\n        def __init__(self, value):\n            self._original_str = value\n            # Normalize decimal separator for float conversion\n            normalized_str = value.replace(',', '.')\n            self._comparable_value = float(normalized_str)\n        def get_comparable_value(self):\n            return self._comparable_value\n        def get_original(self):\n            return self._original_str\n\n    class Parser:\n        \"\"\"Parses raw input values into Number objects.\"\"\"\n        def parse(self, value):\n            if isinstance(value, int):\n                return Integer(value)\n            elif isinstance(value, float):\n                return Float(value)\n            elif isinstance(value, str):\n                return NumericString(value)\n\n    class Comparator:\n        \"\"\"Compares two Number objects based on their comparable values.\"\"\"\n        def compare(self, num_a, num_b):\n            val_a = num_a.get_comparable_value()\n            val_b = num_b.get_comparable_value()\n\n            if val_a > val_b:\n                return num_a\n            elif val_b > val_a:\n                return num_b\n            else: # val_a == val_b\n                return None\n\n    parser = Parser()\n    comparator = Comparator()\n\n    parsed_a = parser.parse(a)\n    parsed_b = parser.parse(b)\n\n    result_num = comparator.compare(parsed_a, parsed_b)\n\n    if result_num is None:\n        return None\n    else:\n        return result_num.get_original()"}
{"task_id": "HumanEval/136", "solution": "from typing import List, Optional, Tuple\n\ndef largest_smallest_integers(lst: List[int]) -> Tuple[Optional[int], Optional[int]]:\n    \"\"\"\n    Finds the largest negative and smallest positive integers in a list.\n    Returns (largest_negative, smallest_positive) or (None, None) if not found.\n    \"\"\"\n\n    # --- Domain Layer ---\n    class InputList:\n        def __init__(self, integers: List[int]):\n            self.integers = integers\n\n    class Result:\n        def __init__(self, largest_negative: Optional[int], smallest_positive: Optional[int]):\n            self.largest_negative = largest_negative\n            self.smallest_positive = smallest_positive\n\n    # --- Application Layer ---\n    class LargestSmallestIntegersUseCase:\n        def execute(self, input_list_obj: InputList) -> Result:\n            largest_neg = None\n            smallest_pos = None\n\n            for num in input_list_obj.integers:\n                if num < 0:\n                    if largest_neg is None or num > largest_neg:\n                        largest_neg = num\n                elif num > 0:\n                    if smallest_pos is None or num < smallest_pos:\n                        smallest_pos = num\n\n            return Result(largest_neg, smallest_pos)\n\n    # --- Interface Adapter Layer ---\n    # Convert input list to domain object\n    input_list_domain = InputList(lst)\n\n    # Execute the application use case\n    use_case = LargestSmallestIntegersUseCase()\n    domain_result = use_case.execute(input_list_domain)\n\n    # Convert domain result back to output tuple\n    return (domain_result.largest_negative, domain_result.smallest_positive)"}
