{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Returns an ordered version of the string where characters in each word are sorted.\n    Keeps the order of words and spaces as they appeared in the original string.\n    \"\"\"\n    if not s:\n        return \"\"\n\n    result = []\n    current_word_chars = []\n\n    for char in s:\n        if char == \" \":\n            # If we were building a word, sort it and add to result\n            if current_word_chars:\n                result.append(\"\".join(sorted(current_word_chars)))\n                current_word_chars = []\n            # Add the space itself\n            result.append(\" \")\n        else:\n            # Accumulate characters for the current word\n            current_word_chars.append(char)\n\n    # After the loop, if there's an unsorted word remaining\n    if current_word_chars:\n        result.append(\"\".join(sorted(current_word_chars)))\n\n    return \"\".join(result)"}
{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Sorts characters within each word of a string while preserving word order and spaces.\n    \"\"\"\n\n    class _WordProcessor:\n        \"\"\"Internal helper to sort characters within a single word.\"\"\"\n        def process_word(self, word_text: str) -> str:\n            return ''.join(sorted(word_text))\n\n    word_processor = _WordProcessor()\n    \n    parts = s.split(' ')\n    processed_parts = []\n    for part in parts:\n        if part == '':\n            processed_parts.append('')\n        else:\n            processed_parts.append(word_processor.process_word(part))\n            \n    return ' '.join(processed_parts)"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds integers x in a jagged list and returns their coordinates.\n    Coordinates are sorted by row ascending, then by column descending.\n    \"\"\"\n    coordinates = []\n    for r_idx, row in enumerate(lst):\n        for c_idx, value in enumerate(row):\n            if value == x:\n                coordinates.append((r_idx, c_idx))\n\n    # Sort coordinates: primary by row (ascending), secondary by column (descending)\n    coordinates.sort(key=lambda c: (c[0], -c[1]))\n\n    return coordinates"}
