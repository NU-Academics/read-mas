{"task_id": "HumanEval/79", "solution": "class DecimalNumber:\n    \"\"\"Represents a decimal integer value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass BinaryString:\n    \"\"\"Represents a binary string, including 'db' markers.\"\"\"\n    def __init__(self, raw_binary_value: str):\n        self.raw_binary_value = raw_binary_value\n\n    def __str__(self):\n        return f\"db{self.raw_binary_value}db\"\n\nclass Converter:\n    \"\"\"Converts a DecimalNumber object to a BinaryString object.\"\"\"\n    def __init__(self, decimal_number: DecimalNumber):\n        self.input = decimal_number\n\n    def convert(self) -> BinaryString:\n        decimal_val = self.input.value\n        if decimal_val == 0:\n            return BinaryString(\"0\")\n\n        binary_digits = []\n        temp_decimal = decimal_val\n        while temp_decimal > 0:\n            remainder = temp_decimal % 2\n            binary_digits.append(str(remainder))\n            temp_decimal //= 2\n\n        raw_binary = \"\".join(binary_digits[::-1])\n        return BinaryString(raw_binary)\n\ndef decimal_to_binary(decimal):\n    \"\"\"Converts a decimal number to its binary string representation,\n    prefixed and suffixed with 'db'.\n    \"\"\"\n    decimal_num_obj = DecimalNumber(decimal)\n    converter_obj = Converter(decimal_num_obj)\n    binary_str_obj = converter_obj.convert()\n    return str(binary_str_obj)"}
{"task_id": "HumanEval/78", "solution": "import enum\n\ndef hex_key(num):\n    \"\"\"Counts the number of prime hexadecimal digits in a given hexadecimal string.\"\"\"\n\n    class HexDigit(enum.Enum):\n        TWO = '2'\n        THREE = '3'\n        FIVE = '5'\n        SEVEN = '7'\n        BEE = 'B'  # Decimal 11\n        DEE = 'D'  # Decimal 13\n\n        @classmethod\n        def is_prime(cls, hex_char):\n            \"\"\"Checks if a given hexadecimal character represents a prime number.\"\"\"\n            return hex_char in {member.value for member in cls}\n\n    class HexKeyCounter:\n        def __init__(self, input_string):\n            self.input = input_string\n\n        def countPrimeDigits(self):\n            \"\"\"Counts the prime hexadecimal digits in the stored input string.\"\"\"\n            count = 0\n            for char in self.input:\n                if HexDigit.is_prime(char):\n                    count += 1\n            return count\n\n    counter = HexKeyCounter(num)\n    return counter.countPrimeDigits()"}
{"task_id": "HumanEval/79", "solution": "def decimal_to_binary(decimal):\n    \"\"\"Converts a decimal number to its binary string representation,\n    prefixed and suffixed with 'db'.\n    \"\"\"\n    if decimal == 0:\n        binary_representation = \"0\"\n    else:\n        abs_decimal = abs(decimal)\n        binary_representation = \"\"\n        while abs_decimal > 0:\n            remainder = abs_decimal % 2\n            binary_representation = str(remainder) + binary_representation\n            abs_decimal //= 2\n    \n    return \"db\" + binary_representation + \"db\""}
