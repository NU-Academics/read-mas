{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Sorts a copy of the given array based on the parity of the sum of its first and last elements.\n    Sorts ascending if the sum is odd, and descending if the sum is even.\n    \"\"\"\n    if not array:\n        return []\n\n    # Create a shallow copy to avoid modifying the original array\n    array_copy = list(array)\n\n    first_element = array_copy[0]\n    last_element = array_copy[-1]\n\n    sum_first_last = first_element + last_element\n\n    # Determine sorting order\n    # If sum is even (sum_first_last % 2 == 0), sort in descending order (reverse=True)\n    # If sum is odd (sum_first_last % 2 == 1), sort in ascending order (reverse=False)\n    reverse_sort = (sum_first_last % 2 == 0)\n\n    # Sort the copied array\n    sorted_array = sorted(array_copy, reverse=reverse_sort)\n\n    return sorted_array"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Sorts a copy of the array ascending if sum(first, last) is odd, else descending.\n    Handles empty and single-element arrays by returning a copy.\n    \"\"\"\n    if not array:\n        return []\n    if len(array) == 1:\n        return list(array) # Return a copy for consistency\n\n    first_val = array[0]\n    last_val = array[-1]\n    \n    if (first_val + last_val) % 2 == 1:  # Sum is odd\n        return sorted(array)\n    else:  # Sum is even\n        return sorted(array, reverse=True)"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by rotating alphabetic characters forward by four positions.\n    Non-alphabetic characters remain unchanged.\n    \"\"\"\n    result = []\n    for ch in s:\n        if 'a' <= ch <= 'z':\n            result.append(chr((ord(ch) - ord('a') + 4) % 26 + ord('a')))\n        elif 'A' <= ch <= 'Z':\n            result.append(chr((ord(ch) - ord('A') + 4) % 26 + ord('A')))\n        else:\n            result.append(ch)\n    return ''.join(result)"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by shifting each alphabetic character four positions forward in the alphabet.\n    Non-alphabetic characters remain unchanged, and case is preserved.\n    \"\"\"\n    result = []\n    shift_amount = 4  # Shift down by two multiplied to two places (2 * 2 = 4)\n\n    for char in s:\n        if 'a' <= char <= 'z':\n            # Handle lowercase letters\n            shifted_char_code = ord('a') + (ord(char) - ord('a') + shift_amount) % 26\n            result.append(chr(shifted_char_code))\n        elif 'A' <= char <= 'Z':\n            # Handle uppercase letters\n            shifted_char_code = ord('A') + (ord(char) - ord('A') + shift_amount) % 26\n            result.append(chr(shifted_char_code))\n        else:\n            # Keep non-alphabetic characters as they are\n            result.append(char)\n            \n    return \"\".join(result)"}
{"task_id": "HumanEval/90", "solution": "def next_smallest(lst):\n    \"\"\"\n    Finds the second smallest distinct element in a list of integers.\n    Returns None if there is no such element (e.g., list is empty or has fewer than two distinct elements).\n    \"\"\"\n    smallest = float('inf')\n    second_smallest = float('inf')\n\n    for x in lst:\n        if x < smallest:\n            second_smallest = smallest\n            smallest = x\n        elif x < second_smallest and x != smallest:\n            second_smallest = x\n    \n    if second_smallest == float('inf'):\n        return None\n    else:\n        return second_smallest"}
