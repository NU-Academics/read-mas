{"task_id": "HumanEval/121", "solution": "from typing import List\n\nclass Element:\n    def __init__(self, value: int, position: int):\n        self.value = value\n        self.position = position\n\nclass IntegerList:\n    def __init__(self, elements: List[int]):\n        self.elements = [Element(v, i) for i, v in enumerate(elements)]\n\n    def sumOddEvenPositions(self) -> int:\n        return sum(\n            e.value\n            for e in self.elements\n            if e.position % 2 == 0 and e.value % 2 != 0\n        )\n\ndef solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\"\"\"\n    integer_list = IntegerList(lst)\n    return integer_list.sumOddEvenPositions()"}
{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Calculates the sum of elements with at most two digits from the first k elements of arr.\n    \"\"\"\n    total_sum = 0\n    # Iterate through the first k elements of the array.\n    for i in range(k):\n        element = arr[i]\n        # Check if the absolute value of the element has at most two digits (i.e., less than 100).\n        if abs(element) < 100:\n            total_sum += element\n    return total_sum"}
{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Calculates the sum of elements with at most two digits from the first k elements of arr.\n    It iterates through the specified range and accumulates the sum of qualifying numbers.\n    \"\"\"\n    total_sum = 0\n    # Iterate through the first k elements of the array\n    for i in range(k):\n        element = arr[i]\n        # Check if the absolute value of the element has at most two digits\n        if -100 < element < 100:\n            total_sum += element\n    return total_sum"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    \"\"\"\n    \n    odd_numbers = set()\n    current = n\n\n    while current != 1:\n        if current % 2 != 0:  # current is odd\n            odd_numbers.add(current)\n            current = 3 * current + 1\n        else:  # current is even\n            current = current // 2\n    \n    # Add 1 to the set as it's always the final odd number in the sequence.\n    odd_numbers.add(1)\n    \n    return sorted(list(odd_numbers))"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    \"\"\"\n    odd_numbers = set()\n    current = n\n\n    while current != 1:\n        if current % 2 != 0:  # If current is odd\n            odd_numbers.add(current)\n            current = 3 * current + 1\n        else:  # If current is even\n            current = current // 2\n    \n    odd_numbers.add(1) # 1 is always part of the sequence and is odd\n\n    return sorted(list(odd_numbers))"}
{"task_id": "HumanEval/124", "solution": "import re\n\ndef valid_date(date):\n    \"\"\"Validates a given date string based on specified rules.\"\"\"\n    # Rule 1: The date string is not empty.\n    if not date:\n        return False\n\n    # Rule 4: The date should be in the format: mm-dd-yyyy\n    date_pattern = r\"^\\d{2}-\\d{2}-\\d{4}$\"\n    if not re.match(date_pattern, date):\n        return False\n\n    # Parse components after format validation\n    month_str, day_str, year_str = date.split('-')\n    month = int(month_str)\n    day = int(day_str)\n    # year = int(year_str) # Year component is not used for validation in the given rules\n\n    # Rule 3: The months should not be less than 1 or higher than 12.\n    if not (1 <= month <= 12):\n        return False\n\n    # Rule 2: Validate the number of days based on the month.\n    # Months with 31 days\n    if month in [1, 3, 5, 7, 8, 10, 12]:\n        if not (1 <= day <= 31):\n            return False\n    # Months with 30 days\n    elif month in [4, 6, 9, 11]:\n        if not (1 <= day <= 30):\n            return False\n    # February (month 2), fixed to 29 days as per rules (no leap year check mentioned)\n    elif month == 2:\n        if not (1 <= day <= 29):\n            return False\n    \n    # All rules satisfied if we reach here\n    return True"}
{"task_id": "HumanEval/124", "solution": "import re\n\ndef valid_date(date):\n    \"\"\"Validates a given date string according to specified rules and format.\"\"\"\n    # Rule 1: The date string is not empty.\n    if not date:\n        return False\n\n    # Rule 4: The date should be in the format: mm-dd-yyyy.\n    # Use regex to ensure the format and capture month, day, year.\n    match = re.fullmatch(r'(\\d{2})-(\\d{2})-(\\d{4})', date)\n    if not match:\n        return False\n\n    try:\n        month = int(match.group(1))\n        day = int(match.group(2))\n        # year = int(match.group(3)) # Year is parsed but not further validated by rules.\n    except ValueError:\n        # This catch is mostly for safety, as regex already ensures digits.\n        return False\n\n    # Rule 3: The months should not be less than 1 or higher than 12.\n    if not (1 <= month <= 12):\n        return False\n\n    # Rule 2: Validate the number of days for the given month.\n    max_days = 0\n    if month in [1, 3, 5, 7, 8, 10, 12]:\n        max_days = 31\n    elif month in [4, 6, 9, 11]:\n        max_days = 30\n    elif month == 2: # February\n        max_days = 29 # As per rules, 29 days for Feb, no leap year logic required.\n\n    if not (1 <= day <= max_days):\n        return False\n\n    # If all checks pass, the date is valid.\n    return True"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    \"\"\"\n    Splits a string by whitespace, then by commas, or counts odd-ordered lowercase letters.\n    \"\"\"\n    if any(c.isspace() for c in txt):\n        return txt.split()\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        count = 0\n        for char in txt:\n            if 'a' <= char <= 'z':\n                if (ord(char) - ord('a')) % 2 != 0:\n                    count += 1\n        return count"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    Examples\n    split_words(\"Hello world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"Hello,world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"abcdef\") == 3 \n    '''\n    if any(c.isspace() for c in txt):\n        return txt.split()\n\n    if ',' in txt:\n        return [w for w in txt.split(',') if w]\n\n    count = 0\n    for ch in txt:\n        if 'a' <= ch <= 'z':\n            idx = ord(ch) - ord('a')\n            if idx % 2 == 1:\n                count += 1\n    return count"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    \"\"\"\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False.\n    \"\"\"\n    if len(lst) <= 1:\n        return True\n\n    counts = {}\n    prev_num = lst[0]\n    counts[prev_num] = 1\n\n    for i in range(1, len(lst)):\n        current_num = lst[i]\n\n        # Check for ascending order\n        if current_num < prev_num:\n            return False\n\n        # Update count for current_num and check duplicate constraint\n        counts[current_num] = counts.get(current_num, 0) + 1\n        if counts[current_num] > 2:  # More than two occurrences of the same number\n            return False\n        \n        prev_num = current_num\n            \n    return True"}
{"task_id": "HumanEval/126", "solution": "class NumberList:\n    \"\"\"Encapsulates a list of numbers and provides methods for validation.\"\"\"\n    def __init__(self, numbers):\n        self.numbers = numbers\n\n    def isSorted(self):\n        \"\"\"Checks if the list is sorted in ascending order.\"\"\"\n        for i in range(1, len(self.numbers)):\n            if self.numbers[i] < self.numbers[i-1]:\n                return False\n        return True\n\n    def hasValidDuplicates(self):\n        \"\"\"Checks if each distinct number appears at most twice.\"\"\"\n        counts = {}\n        for num in self.numbers:\n            counts[num] = counts.get(num, 0) + 1\n            if counts[num] > 2:\n                return False\n        return True\n\ndef is_sorted(lst):\n    \"\"\"\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order and contain no more than one duplicate of any number.\n    \"\"\"\n    number_list_entity = NumberList(lst)\n    return number_list_entity.isSorted() and number_list_entity.hasValidDuplicates()"}
{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"\n    Determines if the length of the intersection of two closed intervals is a prime number.\n    Returns \"YES\" if prime, \"NO\" otherwise or if intervals don't intersect.\n    \"\"\"\n    s1, e1 = interval1\n    s2, e2 = interval2\n\n    # Calculate the start and end of the intersection.\n    intersect_start = max(s1, s2)\n    intersect_end = min(e1, e2)\n\n    # If the intervals do not intersect, the calculated end will be less than the start.\n    if intersect_start > intersect_end:\n        return \"NO\"\n\n    # Calculate the length of the intersection for closed intervals.\n    length = intersect_end - intersect_start + 1\n\n    # Inline helper function to check if a number is prime.\n    def is_prime(num):\n        \"\"\"Checks if a number is prime (a natural number greater than 1).\"\"\"\n        if num <= 1:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    # Check if the length of the intersection is a prime number.\n    if is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Returns the sum of magnitudes of integers multiplied by the product of all signs.\n    Returns None for an empty array.\n    \"\"\"\n    if not arr:\n        return None\n\n    sum_of_magnitudes = 0\n    product_of_signs = 1\n\n    for num in arr:\n        sum_of_magnitudes += abs(num)\n        if num > 0:\n            product_of_signs *= 1\n        elif num < 0:\n            product_of_signs *= -1\n        else:  # num == 0\n            product_of_signs *= 0\n\n    return sum_of_magnitudes * product_of_signs"}
{"task_id": "HumanEval/127", "solution": "class Interval:\n    def __init__(self, start: int, end: int):\n        # Assumed start <= end based on problem statement, no explicit validation needed as per \"no isinstance() checks or raise exceptions for edge cases\"\n        self.start = start\n        self.end = end\n\n    def length(self) -> int:\n        return self.end - self.start + 1\n\n    def intersects(self, other: \"Interval\") -> bool:\n        return max(self.start, other.start) <= min(self.end, other.end)\n\n    def intersection(self, other: \"Interval\") -> \"Interval | None\":\n        if not self.intersects(other):\n            return None\n        start = max(self.start, other.start)\n        end = min(self.end, other.end)\n        return Interval(start, end)\n\nclass PrimeChecker:\n    @staticmethod\n    def is_prime(n: int) -> bool:\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\ndef intersection(interval1, interval2):\n    \"\"\"Checks if the length of the intersection of two intervals is a prime number.\"\"\"\n    # Create Interval objects. The problem statement guarantees start <= end for input intervals.\n    int1 = Interval(interval1[0], interval1[1])\n    int2 = Interval(interval2[0], interval2[1])\n\n    inter = int1.intersection(int2)\n    if inter is None:\n        return \"NO\"\n\n    length = inter.length()\n    if PrimeChecker.is_prime(length):\n        return \"YES\"\n    return \"NO\""}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Calculates sum of magnitudes of integers multiplied by product of all signs.\n    Returns None for an empty array.\n    \"\"\"\n    if not arr:\n        return None\n\n    sign_product = 1\n    magnitude_sum = 0\n\n    for x in arr:\n        magnitude_sum += abs(x)\n        if x > 0:\n            sign_product *= 1\n        elif x < 0:\n            sign_product *= -1\n        else:  # x == 0\n            sign_product *= 0\n    \n    return magnitude_sum * sign_product"}
{"task_id": "HumanEval/129", "solution": "```python\ndef minPath(grid, k):\n    \"\"\"\n    Finds the lexicographically smallest path of length k in the grid.\n    Uses DFS with pruning to explore paths and compare them against the best path found so far.\n    \"\"\"\n    N = len(grid)\n\n    class Cell:\n        \"\"\"Represents a cell in the grid with its coordinates, value, and grid size.\"\"\"\n        __slots__ = ('r', 'c', 'value', 'N_grid')\n\n        def __init__(self, r, c, value, N_grid):\n            self.r = r\n            self.c = c\n            self.value = value\n            self.N_grid = N_grid\n\n        def get_neighbors(self):\n            \"\"\"Returns a list of (row, col) tuples for valid adjacent cells.\"\"\"\n            neighbors = []\n            directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # Up, Down, Left, Right\n            for dr, dc in directions:\n                nr, nc = self.r + dr, self.c + dc\n                if 0 <= nr < self.N_grid and 0 <= nc < self.N_grid:\n                    neighbors.append((nr, nc))\n            return neighbors\n\n    # Handle the special case where k is 1\n    if k == 1:\n        min_val = float('inf')\n        for r_idx in range(N):\n            for c_idx in range(N):\n                min_val = min(min_val, grid[r_idx][c_idx])\n        return [min_val]\n\n    # Initialize grid of Cell objects for easier traversal\n    grid_cells = [[None for _ in range(N)] for _ in range(N)]\n    for r_idx in range(N):\n        for c_idx in range(N):\n            grid_cells[r_idx][c_idx] = Cell(r_idx, c_idx, grid[r_idx][c_idx], N)\n\n    # Stores the lexicographically smallest path found so far\n    min_path_values = [float('inf')] * k\n\n    def dfs(current_cell, current_path_values):\n        \"\"\"\n        Performs a Depth First Search to explore paths, updating min_path_values\n        with the lexicographically smallest path found.\n        \"\"\"\n        nonlocal min_path_values\n\n        path_length = len(current_path_values)\n\n        # Pruning: If the current path prefix is already lexicographically\n        # greater than the best path found so far up to this length,\n        # then stop exploring this branch.\n        is_current_prefix_worse = False\n        if path_length > 0:  # Ensure path_length is valid for indexing\n            for i in range(path_length):\n                if current_path_values[i] > min_path_values[i]:\n                    is_current_prefix_worse = True\n                    break\n                if current_path_values[i] < min_path_values[i]:\n                    # Current path prefix is strictly better, so continue exploration.\n                    break\n            if is_current_prefix_worse:\n                return  # Prune this branch as it's already worse\n\n        # Base case: Path of length k is found\n        if path_length == k:\n            # If we reach here, it implies current_path_values is lexicographically\n            # smaller than min_path_values (or min_path_values was initially inf).\n            # Update min_path_values if current_path_values is strictly smaller.\n            # Python's list comparison handles lexicographical order.\n            if current_path_values < min_path_values:\n                min_path_values = list(current_path_values)  # Make a copy\n            return\n\n        # Explore neighbors\n        for nr, nc in current_cell.get_neighbors():\n            neighbor_cell = grid_cells[nr][nc]\n            \n            current_path_values.append(neighbor_cell.value)\n            dfs(neighbor_cell, current_path_values)\n            current_path_values.pop()  # Backtrack\n\n    # Start DFS from every cell in the grid\n    for r_idx in range(N):\n        for c_idx in range(N):\n            start_cell = grid_cells[r_idx][c_idx]\n            dfs(start_cell, [start_cell.value])  # Start with the current cell's value\n\n    return min_path_values\n```"}
{"task_id": "HumanEval/130", "solution": "import functools\n\ndef tri(n):\n    \"\"\"Calculates the first n + 1 Tribonacci numbers and returns them as a list.\"\"\"\n\n    if n == 0:\n        return [1]\n    if n == 1:\n        return [1, 3]\n\n    # Initialize the sequence with the known base values.\n    trib_sequence = [1, 3]\n\n    # Helper function to compute individual Tribonacci values using memoization.\n    @functools.lru_cache(maxsize=None)\n    def _get_trib_value(k):\n        \"\"\"Recursively computes tri(k) using memoization.\"\"\"\n        if k == 0:\n            return 1\n        if k == 1:\n            return 3\n        if k % 2 == 0:  # If k is even\n            return 1 + k // 2\n        else:  # If k is odd\n            return _get_trib_value(k - 1) + _get_trib_value(k - 2) + _get_trib_value(k + 1)\n\n    # Populate the sequence from the third element up to n.\n    for i in range(2, n + 1):\n        trib_sequence.append(_get_trib_value(i))\n\n    return trib_sequence"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"\n    Computes the Tribonacci sequence up to index n and returns the first n + 1 numbers.\n    It uses a memoized recursive helper to calculate individual sequence elements.\n    \"\"\"\n    memo = {}\n    \n    def _calculate_tri_k(k: int) -> int:\n        \"\"\"Calculates the k-th Tribonacci number using memoization based on the rules.\"\"\"\n        if k in memo:\n            return memo[k]\n\n        if k == 1:\n            value = 3\n        elif k % 2 == 0:\n            value = 1 + k // 2\n        else:  # n is odd\n            value = _calculate_tri_k(k - 1) + _calculate_tri_k(k - 2) + _calculate_tri_k(k + 1)\n        \n        memo[k] = value\n        return value\n\n    result_sequence = []\n    for i in range(n + 1):\n        result_sequence.append(_calculate_tri_k(i))\n    \n    return result_sequence"}
{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Finds the lexicographically smallest path of length k in the grid.\n    Uses a depth-first search (DFS) with pruning to explore possible paths efficiently.\n    \"\"\"\n    N = len(grid)\n    \n    # Initialize min_path_found with a lexicographically large list of length k.\n    # This ensures any valid path found will be considered smaller.\n    min_path_found = [float('inf')] * k\n\n    # Directions for moving to neighbors (up, down, left, right)\n    dr = [-1, 1, 0, 0]\n    dc = [0, 0, -1, 1]\n\n    def dfs(r, c, path_so_far):\n        # Add the current cell's value to the path\n        path_so_far.append(grid[r][c])\n        current_len = len(path_so_far)\n\n        # Pruning: If the current path's prefix is already lexicographically\n        # greater than the known minimum path's prefix of the same length,\n        # then this branch cannot lead to a better path.\n        # This check is only relevant if a full path has been found (min_path_found[0] is not inf).\n        # We compare prefixes only if current_len is less than k to avoid redundant full path comparisons before the base case.\n        if min_path_found[0] != float('inf') and current_len < k:\n            if path_so_far[:current_len] > min_path_found[:current_len]:\n                path_so_far.pop() # Backtrack\n                return\n        \n        # Base case: If the path has reached length k\n        if current_len == k:\n            nonlocal min_path_found\n            # Lexicographical comparison for lists:\n            if path_so_far < min_path_found:\n                min_path_found = list(path_so_far) # Store a copy of the path\n            path_so_far.pop() # Backtrack\n            return\n\n        # Explore neighbors\n        for i in range(4):\n            nr, nc = r + dr[i], c + dc[i]\n            # Check if the neighbor is within grid boundaries\n            if 0 <= nr < N and 0 <= nc < N:\n                dfs(nr, nc, path_so_far)\n        \n        # Backtrack: Remove the current cell's value to explore other paths\n        path_so_far.pop()\n\n    # Iterate through all possible starting cells in the grid\n    for r_start in range(N):\n        for c_start in range(N):\n            dfs(r_start, c_start, [])\n            \n    return min_path_found"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n    product = 1\n    found_odd = False\n    temp_n = n\n\n    while temp_n > 0:\n        digit = temp_n % 10\n        if digit % 2 != 0:\n            product *= digit\n            found_odd = True\n        temp_n //= 10\n\n    if found_odd:\n        return product\n    else:\n        return 0"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n    product_of_odds = 1\n    found_odd_digit = False\n\n    for char_digit in str(n):\n        digit = int(char_digit)\n        if digit % 2 != 0:  # Check if the digit is odd\n            product_of_odds *= digit\n            found_odd_digit = True\n\n    if not found_odd_digit:\n        return 0\n    else:\n        return product_of_odds"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    '''\n    Returns True if there exists a valid subsequence of brackets\n    with at least one nested pair, otherwise False.\n    '''\n    # state tracks the progression of finding a '[[]]' subsequence:\n    # 0: initial state, looking for the first '['\n    # 1: found first '[', looking for the second '['\n    # 2: found second '[', looking for the first ']' (to close the inner pair)\n    # 3: found first ']', looking for the second ']' (to close the outer pair)\n    state = 0\n\n    for char in string:\n        if char == '[':\n            # Only advance state if we are looking for the first or second opening bracket.\n            # More '[' beyond the second simply maintain 'state = 2' as we're still waiting for an inner ']'\n            if state < 2:\n                state += 1\n        elif char == ']':\n            if state == 3:\n                # We have found '[[]' and now found the final ']'\n                return True\n            elif state == 2:\n                # We have found '[[' and now found the first ']' for the inner pair, e.g., '[[]'\n                state = 3\n            elif state == 1:\n                # We found an outer '[' (state 1), but then immediately a ']'\n                # without an inner '['. This forms '[]', which is not nested.\n                # Reset state to 0 to look for a new potential nested sequence.\n                state = 0\n            # If state == 0 (unmatched closing bracket), we just ignore it.\n            # The state remains 0 as it doesn't contribute to a nested pattern.\n    \n    return False"}
{"task_id": "HumanEval/132", "solution": "```python\ndef is_nested(string):\n    \"\"\"\n    Checks if there is a valid subsequence of brackets where at least one bracket in the subsequence is nested.\n    \"\"\"\n    open_count = 0  # Tracks the current balance of open brackets for a potential valid subsequence\n    nested_found = False  # True if a depth of 2 or more open brackets has been reached\n\n    for char in string:\n        if char == '[':\n            open_count += 1\n            if open_count >= 2:\n                nested_found = True  # We have seen at least `[[`\n        elif char == ']':\n            if open_count > 0:\n                open_count -= 1\n                # If we've just closed a sequence and found nesting within it, we have our answer\n                if open_count == 0 and nested_found:\n                    return True\n            # If open_count is 0, this ']' is an unmatched closing bracket.\n            # It can't contribute to forming a valid subsequence with preceding opens.\n            # We effectively discard it for the current 'open_count' logic.\n\n    # If the loop finishes, no such subsequence was fully balanced and nested.\n    return False\n\n```"}
