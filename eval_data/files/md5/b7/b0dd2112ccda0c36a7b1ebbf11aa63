{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\"\"\"\n    abs_num_str = str(abs(num))\n    even_count = 0\n    odd_count = 0\n\n    for char_digit in abs_num_str:\n        digit = int(char_digit)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return even_count, odd_count"}
{"task_id": "HumanEval/154", "solution": "class Word:\n    \"\"\"Represents a string value used in pattern checking.\"\"\"\n    def __init__(self, text: str) -> None:\n        self.text = text\n\nclass PatternChecker:\n    \"\"\"Determines if any rotation of the second word is a substring of the first word.\"\"\"\n    def check(self, first: Word, second: Word) -> bool:\n        if not second.text:\n            return False\n        # Generate all cyclic rotations of the second word\n        rotations = {second.text[i:] + second.text[:i] for i in range(len(second.text))}\n        # Check if any rotation is a substring of the first word\n        return any(rot in first.text for rot in rotations)\n\ndef cycpattern_check(a , b):\n    \"\"\"API entry point that converts string inputs to Word objects and delegates to PatternChecker.\"\"\"\n    checker = PatternChecker()\n    return checker.check(Word(a), Word(b))"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\"\"\"\n\n    class IntegerInput:\n        def __init__(self, value):\n            self.value = value\n\n    class ResultTuple:\n        def __init__(self, even_count, odd_count):\n            self.even_count = even_count\n            self.odd_count = odd_count\n\n    class DigitCounter:\n        def countDigits(self, integer_input_obj):\n            n = integer_input_obj.value\n            even_digits = 0\n            odd_digits = 0\n\n            if n == 0:\n                return ResultTuple(1, 0)\n\n            abs_n = abs(n)\n            while abs_n > 0:\n                digit = abs_n % 10\n                if digit % 2 == 0:\n                    even_digits += 1\n                else:\n                    odd_digits += 1\n                abs_n //= 10\n            return ResultTuple(even_digits, odd_digits)\n\n    # Orchestration\n    integer_input = IntegerInput(num)\n    digit_counter = DigitCounter()\n    result_tuple = digit_counter.countDigits(integer_input)\n    return (result_tuple.even_count, result_tuple.odd_count)"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Converts a positive integer (1-1000) to its lowercase Roman numeral equivalent.\n    \"\"\"\n    roman_map = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'),\n        (1, 'I')\n    ]\n\n    result_numerals = []\n    for value, symbol in roman_map:\n        while number >= value:\n            result_numerals.append(symbol)\n            number -= value\n    \n    return \"\".join(result_numerals).lower()"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    '''\n    # Sort the sides to identify the two shorter sides and the potential hypotenuse.\n    sides = sorted([a, b, c])\n    \n    # Check if the square of the longest side equals the sum of the squares of the other two sides.\n    # This applies the Pythagorean theorem to determine if it's a right-angled triangle.\n    return sides[0]**2 + sides[1]**2 == sides[2]**2"}
