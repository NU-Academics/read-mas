{"task_id": "HumanEval/67", "solution": "import re\n\ndef fruit_distribution(s,n):\n    \"\"\"\n    Calculates the number of mangoes in a basket given total fruits and counts of apples and oranges.\n    Parses apple and orange counts from the input string and subtracts them from the total.\n    \"\"\"\n    apple_match = re.search(r'(\\d+)\\s*apples', s, re.IGNORECASE)\n    orange_match = re.search(r'(\\d+)\\s*oranges', s, re.IGNORECASE)\n\n    apples = int(apple_match.group(1)) if apple_match else 0\n    oranges = int(orange_match.group(1)) if orange_match else 0\n\n    return n - apples - oranges"}
{"task_id": "HumanEval/67", "solution": "import re\n\ndef fruit_distribution(s,n):\n    \"\"\"\n    Calculates the number of mango fruits in a basket based on a description string and total fruit count.\n    It extracts apple and orange counts using regular expressions and subtracts them from the total.\n    \"\"\"\n    # Extract the number of apples using a regular expression.\n    apples_match = re.search(r'(\\d+)\\s*apples', s)\n    apples = int(apples_match.group(1)) if apples_match else 0\n\n    # Extract the number of oranges using a regular expression.\n    oranges_match = re.search(r'(\\d+)\\s*oranges', s)\n    oranges = int(oranges_match.group(1)) if oranges_match else 0\n\n    # Calculate the number of mangoes.\n    mangoes = n - apples - oranges\n    return mangoes"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even-valued node and its first index in a tree branch array.\n    Returns [value, index] or an empty list if no even values or the array is empty.\n    \"\"\"\n    min_even_val = float('inf')\n    min_even_idx = -1\n\n    for i, num in enumerate(arr):\n        if num % 2 == 0:  # Check if the number is even\n            if num < min_even_val:\n                min_even_val = num\n                min_even_idx = i\n\n    if min_even_idx != -1:  # An even value was found\n        return [int(min_even_val), min_even_idx]\n    else:  # No even values were found, or the array was empty\n        return []"}
