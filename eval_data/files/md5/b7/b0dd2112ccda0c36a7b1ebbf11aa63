{"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"Compares game scores with guesses, returning an array of absolute differences or 0 for correct guesses.\"\"\"\n    if len(game) != len(guess):\n        raise ValueError(\"Array lengths must match.\")\n\n    result = []\n    for i in range(len(game)):\n        if game[i] == guess[i]:\n            result.append(0)\n        else:\n            result.append(abs(game[i] - guess[i]))\n    return result"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension based on CAP - SM strength, returning ClassName.StrongestExtensionName.\"\"\"\n    \n    max_strength = -float('inf')\n    strongest_ext_name = \"\"\n\n    for extension in extensions:\n        cap = sum(1 for char in extension if 'A' <= char <= 'Z')\n        sm = sum(1 for char in extension if 'a' <= char <= 'z')\n        current_strength = cap - sm\n\n        # If current extension is stronger, or if it's the very first one, update.\n        # Ties are broken by choosing the one that appears first in the list.\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_ext_name = extension\n    \n    return f\"{class_name}.{strongest_ext_name}\""}
{"task_id": "HumanEval/153", "solution": "class _Extension:\n    \"\"\"Represents an extension with its name and calculates its strength.\"\"\"\n    def __init__(self, name: str):\n        self.name = name\n\n    @property\n    def strength(self) -> int:\n        \"\"\"Calculates the strength of the extension (CAP - SM).\"\"\"\n        cap = sum(1 for char in self.name if 'A' <= char <= 'Z')\n        sm = sum(1 for char in self.name if 'a' <= char <= 'z')\n        return cap - sm\n\ndef Strongest_Extension(class_name, extensions):\n    \"\"\"\n    Finds the strongest extension based on CAP - SM strength and returns \n    the class name concatenated with the strongest extension name.\n    \"\"\"\n    max_strength = float('-inf')\n    strongest_extension_name = \"\"\n\n    for ext_name in extensions:\n        current_extension = _Extension(ext_name)\n        current_strength = current_extension.strength\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = ext_name\n\n    return f\"{class_name}.{strongest_extension_name}\""}
