{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand, evaluate the algebraic expression \n    following standard operator precedence.\n    \"\"\"\n    # Define operator precedence values. Higher value means higher precedence.\n    precedence = {\n        '**': 3,\n        '*': 2,\n        '//': 2,\n        '+': 1,\n        '-': 1\n    }\n\n    # Get unique precedence levels and sort them in descending order.\n    # This ensures higher precedence operations are performed first.\n    precedence_levels = sorted(list(set(precedence.values())), reverse=True)\n\n    # Make mutable copies of the input lists to perform in-place modifications.\n    current_operands = list(operand)\n    current_operators = list(operator)\n\n    # Iterate through each precedence level, from highest to lowest.\n    for level in precedence_levels:\n        i = 0\n        # Iterate through the operators list for the current precedence level.\n        while i < len(current_operators):\n            op_symbol = current_operators[i]\n            if precedence[op_symbol] == level:\n                # Retrieve the two operands for the current operation.\n                op1 = current_operands[i]\n                op2 = current_operands[i+1]\n                \n                # Perform the operation based on the operator symbol.\n                result = 0\n                if op_symbol == '+':\n                    result = op1 + op2\n                elif op_symbol == '-':\n                    result = op1 - op2\n                elif op_symbol == '*':\n                    result = op1 * op2\n                elif op_symbol == '//':\n                    result = op1 // op2\n                elif op_symbol == '**':\n                    result = op1 ** op2\n                \n                # Update the operands list: replace the first operand with the result,\n                # and remove the second operand.\n                current_operands[i] = result\n                current_operands.pop(i + 1)\n                \n                # Remove the operator from the operators list.\n                current_operators.pop(i)\n                \n                # Do not increment 'i' because the lists have shrunk,\n                # and the next operator to check is now at the current 'i' position.\n            else:\n                # Move to the next operator if its precedence doesn't match the current level.\n                i += 1\n    \n    # After all operations, there should be exactly one operand left, which is the final result.\n    return current_operands[0]"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"Reverses case of letters or reverses the whole string if no letters are present.\"\"\"\n    has_letters = False\n    for char in s:\n        if char.isalpha():\n            has_letters = True\n            break\n\n    if not has_letters:\n        return s[::-1]\n    else:\n        result_chars = []\n        for char in s:\n            if char.isalpha():\n                if char.islower():\n                    result_chars.append(char.upper())\n                else:\n                    result_chars.append(char.lower())\n            else:\n                result_chars.append(char)\n        return \"\".join(result_chars)"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Evaluates an algebraic expression built from operator and operand lists, respecting operator precedence.\n    Uses the shunting-yard algorithm to convert to RPN and then evaluates it.\n    \"\"\"\n    precedence = {'+': 1, '-': 1, '*': 2, '//': 2, '**': 3}\n    associativity = {'+': 'left', '-': 'left', '*': 'left', '//': 'left', '**': 'right'}\n\n    output_queue = []\n    operator_stack = []\n\n    for i in range(len(operand)):\n        output_queue.append(operand[i])\n\n        if i < len(operator):\n            op_curr = operator[i]\n            while operator_stack:\n                op_stack_top = operator_stack[-1]\n                if (precedence[op_stack_top] > precedence[op_curr]) or \\\n                   (precedence[op_stack_top] == precedence[op_curr] and associativity[op_curr] == 'left'):\n                    output_queue.append(operator_stack.pop())\n                else:\n                    break\n            operator_stack.append(op_curr)\n\n    while operator_stack:\n        output_queue.append(operator_stack.pop())\n\n    operand_eval_stack = []\n\n    for token in output_queue:\n        if isinstance(token, int):\n            operand_eval_stack.append(token)\n        else:\n            operand2 = operand_eval_stack.pop()\n            operand1 = operand_eval_stack.pop()\n\n            if token == '+':\n                result = operand1 + operand2\n            elif token == '-':\n                result = operand1 - operand2\n            elif token == '*':\n                result = operand1 * operand2\n            elif token == '//':\n                result = operand1 // operand2\n            elif token == '**':\n                result = operand1 ** operand2\n            \n            operand_eval_stack.append(result)\n\n    return operand_eval_stack[0]"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"Reverses the case of letters in a string, or reverses the entire string if no letters are present.\"\"\"\n    transformed_chars = []\n    has_letters = False\n    for char in s:\n        if char.isalpha():\n            has_letters = True\n            if char.islower():\n                transformed_chars.append(char.upper())\n            else:\n                transformed_chars.append(char.lower())\n        else:\n            transformed_chars.append(char)\n\n    result_string = \"\".join(transformed_chars)\n\n    if not has_letters:\n        return result_string[::-1]\n    else:\n        return result_string"}
