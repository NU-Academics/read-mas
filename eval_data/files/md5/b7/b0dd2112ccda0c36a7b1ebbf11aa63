{"task_id": "HumanEval/6", "solution": "from typing import List\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    if not paren_string or paren_string.strip() == \"\":\n        return []\n\n    groups = paren_string.split()\n    depths: List[int] = []\n    for group in groups:\n        max_depth = 0\n        current_depth = 0\n        for ch in group:\n            if ch == \"(\":\n                current_depth += 1\n                if current_depth > max_depth:\n                    max_depth = current_depth\n            elif ch == \")\":\n                current_depth -= 1\n        depths.append(max_depth)\n    return depths"}
{"task_id": "HumanEval/6", "solution": "from typing import List\n\n\nclass Group:\n    \"\"\"\n    Encapsulates a group string of parentheses and calculates its maximum nesting depth.\n    \"\"\"\n    def __init__(self, content: str):\n        self.content = content\n\n    def max_depth(self) -> int:\n        \"\"\"\n        Calculates the maximum nesting level of parentheses within this group.\n        \"\"\"\n        current_depth = 0\n        max_seen_depth = 0\n        for char in self.content:\n            if char == '(':\n                current_depth += 1\n                if current_depth > max_seen_depth:\n                    max_seen_depth = current_depth\n            elif char == ')':\n                current_depth -= 1\n        return max_seen_depth\n\n\nclass Parser:\n    \"\"\"\n    Stateless service to parse input string, split into groups,\n    and aggregate maximum depths for each group.\n    \"\"\"\n    def parse(self, input_string: str) -> List[int]:\n        \"\"\"\n        Splits the input string into groups and computes the max depth for each.\n        \"\"\"\n        groups_str = input_string.split(' ')\n        depths = []\n        for group_str in groups_str:\n            if group_str:  # Process only non-empty group strings\n                group_obj = Group(group_str)\n                depths.append(group_obj.max_depth())\n        return depths\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    parser = Parser()\n    return parser.parse(paren_string)"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\nfrom functools import reduce\nimport operator\n\n\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product. \"\"\"\n    total_sum = sum(numbers)\n    total_product = reduce(operator.mul, numbers, 1)\n    return (total_sum, total_product)"}
{"task_id": "HumanEval/9", "solution": "def rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result: List[int] = []\n    current_max: int = -float('inf') # Initialize with a sufficiently small value\n\n    for number in numbers:\n        current_max = max(current_max, number)\n        result.append(current_max)\n\n    return result"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\nfrom functools import reduce\nimport operator\n\n\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    total_sum = sum(numbers) if numbers else 0\n    total_product = reduce(operator.mul, numbers, 1) if numbers else 1\n    return total_sum, total_product"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    return string == string[::-1]\n\n\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    if not string:\n        return \"\"\n\n    n = len(string)\n    for i in range(n):\n        # Check postfix string[i:]\n        if is_palindrome(string[i:]):\n            # Found the longest palindromic postfix\n            # The prefix to reverse is string[:i]\n            prefix_to_reverse = string[:i]\n            return string + prefix_to_reverse[::-1]\n    \n    # This case should ideally not be reached if empty string is handled correctly\n    # and single characters are palindromes, ensuring at least an empty string or last character is a palindrome.\n    # However, as a fallback, if no non-empty palindrome is found, the original string + its reverse is a palindrome.\n    # But the algorithm specifically states finding the longest postfix that is a palindrome.\n    # The loop `for i in range(n)` will eventually get `string[n-1:]` which is a single char (palindrome)\n    # or `string[n:]` which is `''` (palindrome), so a postfix will always be found.\n    return string + string[:-1][::-1] # This line should not be hit by the logic as described, but included for completeness if edge case thinking is off."}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    if not all(c in '01' for c in a):\n        raise ValueError(\"Input string 'a' must contain only '0' or '1'.\")\n    if not all(c in '01' for c in b):\n        raise ValueError(\"Input string 'b' must contain only '0' or '1'.\")\n    if len(a) != len(b):\n        raise ValueError(\"Input strings must be of equal length.\")\n\n    result_chars = [\n        '0' if char_a == char_b else '1'\n        for char_a, char_b in zip(a, b)\n    ]\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/11", "solution": "from typing import List\n\n\nclass BinaryString:\n    def __init__(self, value: str):\n        self.value = value\n        if not self.is_binary():\n            raise ValueError(\"Input must contain only '0' and '1'.\")\n\n    def is_binary(self) -> bool:\n        return all(c in '01' for c in self.value)\n\n\nclass XOROperation:\n    @staticmethod\n    def compute(a: BinaryString, b: BinaryString) -> BinaryString:\n        if len(a.value) != len(b.value):\n            raise ValueError(\"Input strings must be of equal length.\")\n        result = ''.join('1' if x != y else '0' for x, y in zip(a.value, b.value))\n        return BinaryString(result)\n\n\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    a_bin = BinaryString(a)\n    b_bin = BinaryString(b)\n    result_bin = XOROperation.compute(a_bin, b_bin)\n    return result_bin.value"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b.\"\"\"\n    a, b = abs(a), abs(b)\n    while b:\n        a, b = b, a % b\n    return a"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    a, b = abs(a), abs(b)\n    while b != 0:\n        a, b = b, a % b\n    return a"}
{"task_id": "HumanEval/12", "solution": "def longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    >>> longest([])\n\n    >>> longest(['a', 'b', 'c'])\n    'a'\n    >>> longest(['a', 'bb', 'ccc'])\n    'ccc'\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_str_found = strings[0]\n    for s in strings[1:]:\n        if len(s) > len(longest_str_found):\n            longest_str_found = s\n            \n    return longest_str_found"}
