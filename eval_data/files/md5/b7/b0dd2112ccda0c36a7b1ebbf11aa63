{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"Converts a list of numerical GPAs into a list of corresponding letter grades.\"\"\"\n    letter_grades = []\n    for gpa in grades:\n        if gpa == 4.0:\n            letter_grades.append('A+')\n        elif gpa > 3.7:\n            letter_grades.append('A')\n        elif gpa > 3.3:\n            letter_grades.append('A-')\n        elif gpa > 3.0:\n            letter_grades.append('B+')\n        elif gpa > 2.7:\n            letter_grades.append('B')\n        elif gpa > 2.3:\n            letter_grades.append('B-')\n        elif gpa > 2.0:\n            letter_grades.append('C+')\n        elif gpa > 1.7:\n            letter_grades.append('C')\n        elif gpa > 1.3:\n            letter_grades.append('C-')\n        elif gpa > 1.0:\n            letter_grades.append('D+')\n        elif gpa > 0.7:\n            letter_grades.append('D')\n        elif gpa > 0.0:\n            letter_grades.append('D-')\n        else: # gpa == 0.0\n            letter_grades.append('E')\n    return letter_grades"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"Converts a list of numerical GPAs into a list of corresponding letter grades.\"\"\"\n    letter_grades = []\n    for gpa in grades:\n        if gpa == 4.0:\n            letter_grades.append('A+')\n        elif gpa > 3.7:\n            letter_grades.append('A')\n        elif gpa > 3.3:\n            letter_grades.append('A-')\n        elif gpa > 3.0:\n            letter_grades.append('B+')\n        elif gpa > 2.7:\n            letter_grades.append('B')\n        elif gpa > 2.3:\n            letter_grades.append('B-')\n        elif gpa > 2.0:\n            letter_grades.append('C+')\n        elif gpa > 1.7:\n            letter_grades.append('C')\n        elif gpa > 1.3:\n            letter_grades.append('C-')\n        elif gpa > 1.0:\n            letter_grades.append('D+')\n        elif gpa > 0.7:\n            letter_grades.append('D')\n        elif gpa > 0.0:\n            letter_grades.append('D-')\n        else: # gpa == 0.0\n            letter_grades.append('E')\n    return letter_grades"}
{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"Checks if the length of the given string is a prime number.\"\"\"\n    length = len(string)\n\n    def is_prime(n):\n        \"\"\"Determines if a number is prime using an O(sqrt(n)) algorithm.\"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    return is_prime(length)"}
{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"Checks if the length of the given string is a prime number.\n    \"\"\"\n    length = len(string)\n\n    def _is_prime(n):\n        \"\"\"Helper to determine if a number is prime.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    return _is_prime(length)"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    if n == 1:\n        return 1\n    return 18 * (10 ** (n - 2))"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of n-digit positive integers\n    that start or end with 1.\n    \"\"\"\n    if n == 1:\n        return 1\n    else:\n        # Numbers starting with 1: 10^(n-1) options (1 followed by n-1 digits)\n        # Numbers ending with 1: 10^(n-1) options (n-1 digits followed by 1)\n        # Numbers starting AND ending with 1: 10^(n-2) options (1 followed by n-2 digits, then 1)\n        # Using inclusion-exclusion principle: 10^(n-1) + 10^(n-1) - 10^(n-2)\n        # This simplifies to 2 * 10^(n-1) - 10^(n-2)\n        # Which further simplifies to 10^(n-2) * (2*10 - 1) = 19 * 10^(n-2) for n > 1\n        # However, the design specifies: 10**(n-1) + 8 * 10**(n-2)\n        # Let's verify the design's formula:\n        # 10**(n-1) represents numbers starting with 1.\n        # 8 * 10**(n-2) represents numbers ending with 1, but NOT starting with 1.\n        # Total n-digit numbers: 9 * 10^(n-1) (from 10^(n-1) to 9*10^(n-1) - 1)\n        # Numbers starting with 1: 1 * 10^(n-1) (e.g., for n=3, 100-199)\n        # Numbers ending with 1: 9 * 10^(n-2) (e.g., for n=3, 101, 111, ..., 991)\n        # Numbers starting AND ending with 1: 1 * 10^(n-2) (e.g., for n=3, 111)\n        # Total = (starts with 1) + (ends with 1) - (starts and ends with 1)\n        # Total = 10**(n-1) + 9 * 10**(n-2) - 10**(n-2)\n        # Total = 10**(n-1) + 8 * 10**(n-2)\n        # The formula from the design is correct.\n        return 10**(n - 1) + 8 * 10**(n - 2)"}
{"task_id": "HumanEval/84", "solution": "class InputValidator:\n        \"\"\"Validates the input integer N.\"\"\"\n        def is_valid(self, N):\n            return 0 <= N <= 10000\n\n    class NumberProcessor:\n        \"\"\"Processes the number to compute digit sum and convert to binary.\"\"\"\n        def compute_digit_sum(self, N):\n            s_N = str(N)\n            digit_sum = 0\n            for digit_char in s_N:\n                digit_sum += int(digit_char)\n            return digit_sum\n\n        def convert_to_binary(self, s_sum):\n            return bin(s_sum)[2:]\n\n        def process_number(self, N):\n            digit_sum = self.compute_digit_sum(N)\n            binary_sum = self.convert_to_binary(digit_sum)\n            return binary_sum\n\n    validator = InputValidator()\n    processor = NumberProcessor()\n\n    if not validator.is_valid(N):\n        # As per \"System Interfaces\" -> \"Error Handling: Raises ValueError if N is out of range\"\n        raise ValueError(\"N must be between 0 and 10000, inclusive.\")\n\n    return processor.process_number(N)"}
{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    \"\"\"\n    digit_sum = 0\n    # Calculate the sum of the decimal digits of N.\n    # Handle N=0 explicitly as the while loop condition `temp_N > 0` would skip it.\n    if N == 0:\n        digit_sum = 0\n    else:\n        temp_N = N\n        while temp_N > 0:\n            digit_sum += temp_N % 10\n            temp_N //= 10\n\n    # Convert the calculated digit sum to its binary string representation,\n    # removing the \"0b\" prefix from Python's bin() function.\n    return bin(digit_sum)[2:]"}
