{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    def factorial(k):\n        \"\"\"Calculates the factorial of a non-negative integer k.\"\"\"\n        res = 1\n        for i in range(1, k + 1):\n            res *= i\n        return res\n\n    total_product = 1\n    # Iterate from 1 up to n, calculating factorial(i) and multiplying\n    for i in range(1, n + 1):\n        total_product *= factorial(i)\n    \n    return total_product"}
{"task_id": "HumanEval/140", "solution": "import re\n\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores, \n    and if a string has more than 2 consecutive spaces, \n    then replace all consecutive spaces with - \n    \"\"\"\n    # First, replace sequences of 3 or more spaces with a hyphen.\n    # This must be done before replacing single/double spaces to avoid conflicts.\n    text = re.sub(r' {3,}', '-', text)\n    # Then, replace sequences of 1 or 2 spaces with an underscore.\n    text = re.sub(r' {1,2}', '_', text)\n    return text"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    special_fact_result = 1\n    current_factorial = 1\n\n    # Calculate i! and multiply it into the special_fact_result\n    for i in range(1, n + 1):\n        current_factorial *= i  # current_factorial now holds i!\n        special_fact_result *= current_factorial\n\n    return special_fact_result"}
{"task_id": "HumanEval/140", "solution": "import re\n\ndef fix_spaces(text):\n    \"\"\"\n    Replaces all spaces in text with underscores,\n    and replaces sequences of more than 2 consecutive spaces with a hyphen.\n    \"\"\"\n    # First, replace sequences of 3 or more spaces with a single hyphen\n    result = re.sub(r' {3,}', '-', text)\n    # Then, replace any remaining sequences of 1 or 2 spaces with an underscore\n    result = re.sub(r' {1,2}', '_', result)\n    return result"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Checks if a file name is valid based on specific rules.\"\"\"\n    \n    # Rule 2: The file's name contains exactly one dot '.'\n    if file_name.count('.') != 1:\n        return 'No'\n\n    parts = file_name.split('.')\n    base_name = parts[0]\n    extension = parts[1]\n\n    # Rule 3: The substring before the dot should not be empty,\n    # and it starts with a letter from the latin alphabet ('a'-'z' and 'A'-'Z').\n    if not base_name:\n        return 'No'\n    if not base_name[0].isalpha():\n        return 'No'\n\n    # Rule 4: The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    if extension not in ['txt', 'exe', 'dll']:\n        return 'No'\n\n    # Rule 1: There should not be more than three digits ('0'-'9') in the file's name.\n    digit_count = sum(1 for char in file_name if char.isdigit())\n    if digit_count > 3:\n        return 'No'\n\n    # If all conditions are met\n    return 'Yes'"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    Calculates the sum of transformed integers based on their index.\n    Integers are squared if the index is a multiple of 3, or cubed if the index is a multiple of 4 but not 3.\n    \"\"\"\n    total_sum = 0\n    for i, num in enumerate(lst):\n        if i % 3 == 0:\n            total_sum += num ** 2\n        elif i % 4 == 0:\n            total_sum += num ** 3\n        else:\n            total_sum += num\n    return total_sum"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Checks if a file name is valid based on specific rules.\"\"\"\n    \n    # Rule 1: The file's name contains exactly one dot '.'\n    if file_name.count('.') != 1:\n        return 'No'\n\n    parts = file_name.split('.')\n    before_dot = parts[0]\n    after_dot = parts[1]\n\n    # Rule 2: The substring before the dot should not be empty.\n    # Rule 3: It starts with a letter from the latin alphapet ('a'-'z' and 'A'-'Z').\n    if not before_dot or not before_dot[0].isalpha():\n        return 'No'\n\n    # Rule 4: The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    valid_extensions = ['txt', 'exe', 'dll']\n    if after_dot not in valid_extensions:\n        return 'No'\n\n    # Rule 5: There should not be more than three digits ('0'-'9') in the file's name.\n    digit_count = 0\n    for char in file_name:\n        if char.isdigit():\n            digit_count += 1\n    if digit_count > 3:\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    Squares elements at indices that are multiples of 3, cubes elements at indices that are multiples of 4 and not 3,\n    and returns the sum of all transformed elements.\n    \"\"\"\n    total_sum = 0\n    for i, num in enumerate(lst):\n        if i % 3 == 0:\n            total_sum += num ** 2\n        elif i % 4 == 0:  # This condition implies i % 3 != 0 due to the `elif`\n            total_sum += num ** 3\n        else:\n            total_sum += num\n    return total_sum"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Returns a string containing words from the original sentence whose lengths are prime numbers,\n    preserving the original order.\n    \"\"\"\n    def _is_prime(n):\n        \"\"\"Checks if a given number n is a prime number.\"\"\"\n        if n < 2:\n            return False\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 1\n        return True\n\n    words = sentence.split()\n    prime_length_words = []\n\n    for word in words:\n        if _is_prime(len(word)):\n            prime_length_words.append(word)\n\n    return ' '.join(prime_length_words)"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Extracts words from a sentence whose lengths are prime numbers, preserving order.\n    \"\"\"\n    def is_prime(n):\n        \"\"\"Checks if a number is prime.\"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    words = sentence.split()\n    prime_words = []\n    for word in words:\n        if is_prime(len(word)):\n            prime_words.append(word)\n\n    return \" \".join(prime_words)"}
{"task_id": "HumanEval/144", "solution": "class Fraction:\n    def __init__(self, fraction_str):\n        \"\"\"Initializes a Fraction object from a string in 'numerator/denominator' format.\"\"\"\n        parts = fraction_str.split('/')\n        self.numerator = int(parts[0])\n        self.denominator = int(parts[1])\n\ndef parse_fraction(fraction_str: str) -> Fraction:\n    \"\"\"Converts a fraction string into a Fraction object.\"\"\"\n    return Fraction(fraction_str)\n\ndef multiply_fractions(frac1: Fraction, frac2: Fraction) -> Fraction:\n    \"\"\"Multiplies two Fraction objects and returns a new Fraction object representing the product.\"\"\"\n    new_numerator = frac1.numerator * frac2.numerator\n    new_denominator = frac1.denominator * frac2.denominator\n    # Construct a string for the product fraction to use Fraction's string constructor.\n    product_str = f\"{new_numerator}/{new_denominator}\"\n    return Fraction(product_str)\n\ndef simplify(x: str, n: str) -> bool:\n    \"\"\"\n    Checks if the product of two fractions x and n is a whole number.\n    Returns True if the product is a whole number, False otherwise.\n    \"\"\"\n    # Parse the input fraction strings into Fraction objects.\n    frac_x = parse_fraction(x)\n    frac_n = parse_fraction(n)\n\n    # Multiply the two Fraction objects to get the product fraction.\n    product_frac = multiply_fractions(frac_x, frac_n)\n\n    # Determine if the resulting product fraction represents a whole number.\n    # A fraction is a whole number if its numerator is perfectly divisible by its denominator.\n    return product_frac.numerator % product_frac.denominator == 0"}
{"task_id": "HumanEval/144", "solution": "import math\n\ndef simplify(x, n):\n    \"\"\"Checks if the product of two fractions, x and n, is a whole number.\"\"\"\n    # Parse the first fraction x\n    num1_str, den1_str = x.split('/')\n    num1 = int(num1_str)\n    den1 = int(den1_str)\n\n    # Parse the second fraction n\n    num2_str, den2_str = n.split('/')\n    num2 = int(num2_str)\n    den2 = int(den2_str)\n\n    # Calculate the product of the two fractions\n    product_numerator = num1 * num2\n    product_denominator = den1 * den2\n\n    # A fraction is a whole number if its numerator is perfectly divisible by its denominator.\n    # We first simplify the fraction to its lowest terms to handle cases like 10/2.\n    common_divisor = math.gcd(product_numerator, product_denominator)\n    simplified_num = product_numerator // common_divisor\n    simplified_den = product_denominator // common_divisor\n    \n    return simplified_den == 1"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers by the sum of their digits,\n    maintaining original order for items with equal sums.\n    \"\"\"\n\n    def _calculate_digit_sum(n):\n        \"\"\"Calculates the sum of the absolute value's digits.\"\"\"\n        return sum(int(digit) for digit in str(abs(n)))\n\n    if not nums:\n        return []\n\n    # Python's sorted() is stable, preserving original order for equal keys.\n    return sorted(nums, key=_calculate_digit_sum)"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"Counts numbers in an array that are greater than 10 and have\n    odd first and last digits.\n    \"\"\"\n    count = 0\n    for n in nums:\n        if n > 10:\n            # Convert the number to string to easily get the first digit.\n            # Since n > 10, n is positive, so abs(n) is not strictly needed.\n            num_str = str(n)\n            first_digit = int(num_str[0])\n            last_digit = n % 10\n\n            if first_digit % 2 == 1 and last_digit % 2 == 1:\n                count += 1\n    return count"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers by the sum of their digits,\n    then by original index for stable ordering.\n    \"\"\"\n\n    def _compute_digit_sum(n: int) -> int:\n        \"\"\"Calculates the sum of the absolute digits of an integer.\"\"\"\n        return sum(int(d) for d in str(abs(n)))\n\n    # Create a list of tuples: (digit_sum, original_index, value)\n    # This structure facilitates sorting directly by the first two elements.\n    intermediate_items = []\n    for i, num in enumerate(nums):\n        d_sum = _compute_digit_sum(num)\n        intermediate_items.append((d_sum, i, num))\n\n    # Sort the intermediate items based on (digit_sum, original_index)\n    # Python's `sorted` with a tuple key naturally sorts by the first element, then second, etc.\n    sorted_items = sorted(intermediate_items)\n\n    # Extract the original integer values from the sorted items\n    return [item[2] for item in sorted_items]"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"Counts numbers in an array that are greater than 10 and have both first and last digits odd.\"\"\"\n    count = 0\n    for num in nums:\n        if num > 10:\n            # Check first digit\n            str_num = str(num)\n            first_digit = int(str_num[0])\n            \n            # Check last digit\n            last_digit = num % 10\n            \n            if first_digit % 2 != 0 and last_digit % 2 != 0:\n                count += 1\n    return count"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Counts triples (a[i], a[j], a[k]) with i < j < k where a[i] + a[j] + a[k] is a multiple of 3.\n    The values a[i] are calculated as i*i - i + 1.\n    \"\"\"\n    if n < 3:\n        return 0\n\n    # Count numbers in the sequence a[i] based on their remainder modulo 3.\n    # This acts as the combined logic for ArrayGenerator and TripleCounter's initial processing.\n    remainder_counts = [0, 0, 0]  # counts for remainder 0, 1, 2\n\n    for i in range(1, n + 1):\n        # Calculate a[i] = i*i - i + 1\n        # The remainder of (i*i - i + 1) modulo 3 is needed.\n        # (i*i - i + 1) % 3\n        # i % 3 can be 0, 1, 2\n        # If i % 3 == 0: (0 - 0 + 1) % 3 = 1\n        # If i % 3 == 1: (1 - 1 + 1) % 3 = 1\n        # If i % 3 == 2: (4 - 2 + 1) % 3 = 3 % 3 = 0\n        \n        # Optimized calculation for remainder:\n        # Based on the pattern, for a[i] = i*i - i + 1:\n        # If i % 3 == 0, a[i] % 3 == 1\n        # If i % 3 == 1, a[i] % 3 == 1\n        # If i % 3 == 2, a[i] % 3 == 0\n        \n        # Simplified: a[i] % 3 is 0 if i % 3 == 2, else it's 1.\n        \n        remainder_val = 1 if i % 3 != 2 else 0\n        remainder_counts[remainder_val] += 1\n\n    c0 = remainder_counts[0]\n    c1 = remainder_counts[1]\n    c2 = remainder_counts[2] # Not directly used with the simplified calculation, as c2 will always be 0.\n                              # However, including it for completeness if the remainder logic changes or for clarity\n                              # related to (0,1,2) combinations (which will involve c0 and c1 in a specific way).\n                              # For this specific a[i] = i*i - i + 1, no a[i] can have remainder 2.\n                              # So effectively, remainder_counts[2] will always be 0.\n\n    total_triples = 0\n\n    # Case 1: (0, 0, 0) - sum of three numbers with remainder 0 is divisible by 3.\n    # Number of ways to choose 3 from c0 items: C(c0, 3)\n    total_triples += c0 * (c0 - 1) * (c0 - 2) // 6\n\n    # Case 2: (1, 1, 1) - sum of three numbers with remainder 1 is 3 (divisible by 3).\n    # Number of ways to choose 3 from c1 items: C(c1, 3)\n    total_triples += c1 * (c1 - 1) * (c1 - 2) // 6\n\n    # Case 3: (2, 2, 2) - sum of three numbers with remainder 2 is 6 (divisible by 3).\n    # Number of ways to choose 3 from c2 items: C(c2, 3)\n    # Given the pattern of a[i]%3, c2 will always be 0, so this adds 0.\n    total_triples += c2 * (c2 - 1) * (c2 - 2) // 6\n\n    # Case 4: (0, 1, 2) - sum of one number with remainder 0, one with 1, one with 2 is 3 (divisible by 3).\n    # Number of ways to choose 1 from c0, 1 from c1, 1 from c2: C(c0, 1) * C(c1, 1) * C(c2, 1)\n    # Given the pattern of a[i]%3, c2 will always be 0, so this adds 0.\n    total_triples += c0 * c1 * c2\n\n    return total_triples"}
{"task_id": "HumanEval/148", "solution": "```python\ndef bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun \n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn, \n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2. \n    The function should return a tuple containing all planets whose orbits are \n    located between the orbit of planet1 and the orbit of planet2, sorted by \n    the proximity to the sun. \n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names. \n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    _PLANETS = (\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\")\n\n    if planet1 not in _PLANETS or planet2 not in _PLANETS:\n        return ()\n\n    idx1 = _PLANETS.index(planet1)\n    idx2 = _PLANETS.index(planet2)\n\n    if idx1 == idx2:\n        return ()\n    \n    # Ensure correct slicing order\n    start_idx = min(idx1, idx2)\n    end_idx = max(idx1, idx2)\n\n    # Slice between the planets, excluding themselves\n    return _PLANETS[start_idx + 1 : end_idx]\n```"}
{"task_id": "HumanEval/148", "solution": "PLANETS = (\n    \"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n)\n\ndef bf(planet1, planet2):\n    \"\"\"\n    Returns a tuple of planets whose orbits are located between planet1 and planet2,\n    sorted by proximity to the Sun, or an empty tuple if inputs are invalid.\n    \"\"\"\n    try:\n        idx1 = PLANETS.index(planet1.capitalize())\n        idx2 = PLANETS.index(planet2.capitalize())\n    except ValueError:\n        return ()\n\n    start_idx = min(idx1, idx2)\n    end_idx = max(idx1, idx2)\n\n    # Planets strictly between the two input planets\n    return PLANETS[start_idx + 1 : end_idx]"}
{"task_id": "HumanEval/147", "solution": "class IllegalArgumentException(ValueError):\n    \"\"\"Custom exception for invalid arguments.\"\"\"\n    pass\n\ndef get_max_triples(n):\n    \"\"\"\n    You are given a positive integer n. You have to create an integer array a of length n.\n        For each i (1 \u2264 i \u2264 n), the value of a[i] = i * i - i + 1.\n        Return the number of triples (a[i], a[j], a[k]) of a where i < j < k,\n    and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n    if n <= 0:\n        raise IllegalArgumentException(\"n must be a positive integer\")\n\n    # Generate the array a\n    a = [i * i - i + 1 for i in range(1, n + 1)]\n\n    count = 0\n    # Iterate through all possible triples (i, j, k) with i < j < k\n    for i in range(n):\n        for j in range(i + 1, n):\n            for k in range(j + 1, n):\n                # Calculate the sum of the triple\n                s = a[i] + a[j] + a[k]\n                # Check if the sum is a multiple of 3\n                if s % 3 == 0:\n                    count += 1\n    return count"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"\n    Filters a list of strings to remove odd-length strings, then sorts the remainder\n    by length and alphabetically for ties.\n    \"\"\"\n    # Filter out strings that have odd lengths\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n\n    # Sort the remaining strings: first by length (ascending), then alphabetically (ascending)\n    # The tuple (len(s), s) as a key achieves this desired sorting order.\n    sorted_result = sorted(even_length_strings, key=lambda s: (len(s), s))\n\n    return sorted_result"}
{"task_id": "HumanEval/150", "solution": "import math\n\ndef x_or_y(n, x, y):\n    \"\"\"Returns x if n is a prime number, otherwise returns y.\n    \n    Checks primality of n using an optimized trial division method.\n    \"\"\"\n    if n <= 1:\n        is_n_prime = False\n    elif n == 2:\n        is_n_prime = True\n    elif n % 2 == 0:\n        is_n_prime = False\n    else:\n        is_n_prime = True\n        # Check for divisors from 3 up to sqrt(n), only odd numbers\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                is_n_prime = False\n                break\n    \n    if is_n_prime:\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/150", "solution": "import math\n\ndef x_or_y(n, x, y):\n    \"\"\"Returns x if n is prime, otherwise returns y.\"\"\"\n    \n    if n <= 1:\n        return y\n    \n    if n == 2 or n == 3:\n        return x\n    \n    if n % 2 == 0 or n % 3 == 0:\n        return y\n    \n    i = 5\n    # Optimized trial division: check for divisors of the form 6k \u00b1 1\n    # Only need to check up to the square root of n\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return y\n        i += 6\n            \n    return x"}
{"task_id": "HumanEval/149", "solution": "from __future__ import annotations\nfrom dataclasses import dataclass\nfrom typing import List\n\n@dataclass(frozen=True)\nclass StringElement:\n    \"\"\"Represents a single string and its length.\"\"\"\n    value: str\n\n    @property\n    def length(self) -> int:\n        return len(self.value)\n\nclass StringList:\n    \"\"\"Container for a list of StringElement objects with filtering and sorting.\"\"\"\n    def __init__(self, strings: List[str]) -> None:\n        self._elements: List[StringElement] = [StringElement(s) for s in strings]\n\n    def filter_odd_length(self) -> 'StringList':\n        filtered = [e for e in self._elements if e.length % 2 == 0]\n        return StringList([e.value for e in filtered])\n\n    def sort_by_length(self) -> 'StringList':\n        sorted_elements = sorted(self._elements, key=lambda e: e.length)\n        return StringList([e.value for e in sorted_elements])\n\n    def sort_alphabetically(self) -> 'StringList':\n        sorted_elements = sorted(self._elements, key=lambda e: e.value)\n        return StringList([e.value for e in sorted_elements])\n\n    def get_strings(self) -> List[str]:\n        return [e.value for e in self._elements]\n\ndef sorted_list_sum(lst: List[str]) -> List[str]:\n    \"\"\"\n    Accepts a list of strings, removes odd\u2011length strings,\n    sorts by ascending length and then alphabetically, returning a new list.\n    \"\"\"\n    original = StringList(lst)\n    filtered = original.filter_odd_length()\n    sorted_by_len = filtered.sort_by_length()\n    final = sorted_by_len.sort_alphabetically()\n    return final.get_strings()"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    \n    double_the_difference([1, 3, 2, 0]) == 1 + 9 + 0 + 0 = 10\n    double_the_difference([-1, -2, 0]) == 0\n    double_the_difference([9, -2]) == 81\n    double_the_difference([0]) == 0  \n   \n    If the input list is empty, return 0.\n    '''\n    class OddSquareCalculator:\n        \"\"\"\n        Helper class to encapsulate the logic for filtering, squaring, and summing\n        odd, non-negative integers.\n        \"\"\"\n        def calculate(self, numbers):\n            total_sum = 0\n            for num in numbers:\n                # Numbers must be integers and non-negative to be considered.\n                if isinstance(num, int) and num >= 0:\n                    # Only odd numbers are squared and summed.\n                    if num % 2 != 0:\n                        total_sum += num * num\n            return total_sum\n\n    # The `double_the_difference` function orchestrates the call to the calculator.\n    calculator = OddSquareCalculator()\n    return calculator.calculate(lst)"}
