{"task_id": "HumanEval/91", "solution": "import re\n\ndef is_bored(S):\n    \"\"\"\n    Counts sentences starting with \"I\". Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    boredom_count = 0\n    if not S:\n        return 0\n\n    # Split the string into potential sentences using the specified delimiters.\n    potential_sentences = re.split(r'[.?!]', S)\n\n    for sentence_part in potential_sentences:\n        # Trim leading/trailing whitespace from the sentence part.\n        trimmed_sentence = sentence_part.strip()\n\n        # Ignore empty parts resulting from consecutive delimiters or delimiters at string ends.\n        if not trimmed_sentence:\n            continue\n\n        # Check if the first word of the trimmed sentence is exactly \"I\".\n        words = trimmed_sentence.split(maxsplit=1)\n        if words and words[0] == \"I\":\n            boredom_count += 1\n\n    return boredom_count"}
{"task_id": "HumanEval/91", "solution": "import re\n\ndef is_bored(S):\n    \"\"\"\n    Counts sentences starting with \"I\". Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    boredom_count = 0\n    # Split the string by sentence delimiters.\n    # re.split creates a list of strings, potentially including empty strings\n    # if delimiters are at the start/end or consecutive.\n    sentences = re.split(r'[.?!]', S)\n\n    for sentence_part in sentences:\n        # Remove leading and trailing whitespace from each sentence part.\n        trimmed_sentence = sentence_part.strip()\n\n        # A boredom is a sentence that starts with the word \"I\".\n        # This checks for \"I \" (e.g., \"I love pizza\") or exactly \"I\" (e.g., \"I!\").\n        if trimmed_sentence.startswith(\"I \"):\n            boredom_count += 1\n        elif trimmed_sentence == \"I\":\n            boredom_count += 1\n            \n    return boredom_count"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    \"\"\"\n    Checks if one number is the sum of the other two, and all are integers.\n    Returns false if any number is not an integer.\n    \"\"\"\n    if not (isinstance(x, int) and isinstance(y, int) and isinstance(z, int)):\n        return False\n\n    return (x == y + z) or (y == x + z) or (z == x + y)"}
{"task_id": "HumanEval/92", "solution": "class Number:\n        def __init__(self, value):\n            self.value = value\n\n        def is_integer(self):\n            return isinstance(self.value, int) or (isinstance(self.value, float) and self.value == int(self.value))\n\n    class AnyIntFunction:\n        def __init__(self, x_num, y_num, z_num):\n            self.x = x_num\n            self.y = y_num\n            self.z = z_num\n\n        def evaluate(self):\n            # Check if all numbers are integers\n            if not (self.x.is_integer() and self.y.is_integer() and self.z.is_integer()):\n                return False\n\n            # Check if one number is the sum of the other two\n            if (self.x.value == self.y.value + self.z.value or\n                self.y.value == self.x.value + self.z.value or\n                self.z.value == self.x.value + self.y.value):\n                return True\n            \n            return False\n\n    # Instantiate Number objects for each input\n    num_x = Number(x)\n    num_y = Number(y)\n    num_z = Number(z)\n\n    # Create an AnyIntFunction instance and evaluate it\n    func = AnyIntFunction(num_x, num_y, num_z)\n    return func.evaluate()"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by swapping letter cases and replacing vowels.\n    Assume only letters.\n    \"\"\"\n    # Swap the case of all letters\n    swapped_case_message = message.swapcase()\n\n    # Define a local helper to replace vowels\n    def _replace_vowels_local(input_str):\n        vowels = 'aeiouAEIOU'\n        shift_map = {v: chr(ord(v) + 2) for v in vowels}\n        return ''.join(shift_map.get(char, char) for char in input_str)\n\n    # Apply the vowel replacement to the swapped-case message\n    final_encoded_message = _replace_vowels_local(swapped_case_message)\n\n    return final_encoded_message"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by swapping case of letters and replacing vowels\n    with the letter two places ahead in the alphabet, preserving case.\n    Non-alphabetic characters are kept as is.\n    \"\"\"\n    encoded_chars = []\n    vowels = \"aeiou\"\n\n    for char in message:\n        if char.isalpha():\n            swapped_char = char.swapcase()\n            lower_swapped_char = swapped_char.lower()\n\n            if lower_swapped_char in vowels:\n                # Calculate the new character's position in the alphabet (0-25)\n                alpha_index = ord(lower_swapped_char) - ord('a')\n                new_alpha_index = (alpha_index + 2) % 26\n                new_char_lower = chr(ord('a') + new_alpha_index)\n\n                # Preserve the case of the swapped vowel\n                if swapped_char.isupper():\n                    encoded_chars.append(new_char_lower.upper())\n                else:\n                    encoded_chars.append(new_char_lower)\n            else:\n                encoded_chars.append(swapped_char)\n        else:\n            # Non-alphabetic characters are preserved\n            encoded_chars.append(char)\n\n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"\n    You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n    def is_prime(n):\n        \"\"\"Checks if a number is prime.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def sum_digits(n):\n        \"\"\"Calculates the sum of the digits of a number.\"\"\"\n        s = 0\n        for digit_char in str(n):\n            s += int(digit_char)\n        return s\n\n    largest_prime = None\n\n    for num in lst:\n        if is_prime(num):\n            if largest_prime is None or num > largest_prime:\n                largest_prime = num\n\n    if largest_prime is None:\n        return 0\n    else:\n        return sum_digits(largest_prime)"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"\n    Finds the largest prime number in the list and returns the sum of its digits.\n    Returns 0 if no prime numbers are found.\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"Checks if a number is prime using trial division up to sqrt(n).\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def digit_sum(n):\n        \"\"\"Calculates the sum of the decimal digits of a number.\"\"\"\n        s = 0\n        while n > 0:\n            s += n % 10\n            n //= 10\n        return s\n\n    max_prime = None\n    for num in lst:\n        if is_prime(num):\n            if max_prime is None or num > max_prime:\n                max_prime = num\n\n    if max_prime is not None:\n        return digit_sum(max_prime)\n    else:\n        return 0"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower \n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    Examples:\n    check_dict_case({\"a\":\"apple\", \"b\":\"banana\"}) should return True.\n    check_dict_case({\"a\":\"apple\", \"A\":\"banana\", \"B\":\"banana\"}) should return False.\n    check_dict_case({\"a\":\"apple\", 8:\"banana\", \"a\":\"apple\"}) should return False.\n    check_dict_case({\"Name\":\"John\", \"Age\":\"36\", \"City\":\"Houston\"}) should return False.\n    check_dict_case({\"STATE\":\"NC\", \"ZIP\":\"12345\" }) should return True.\n    \"\"\"\n    if not dict:\n        return False\n\n    is_all_lower = True\n    is_all_upper = True\n\n    for key in dict.keys():\n        # Keys must be strings. If not, return False immediately.\n        if not isinstance(key, str):\n            return False\n        \n        # If any key is not entirely lowercase, then the dictionary cannot be all lowercase.\n        if not key.islower():\n            is_all_lower = False\n        \n        # If any key is not entirely uppercase, then the dictionary cannot be all uppercase.\n        if not key.isupper():\n            is_all_upper = False\n            \n        # If at any point it's neither possible to be all lowercase nor all uppercase, return False.\n        if not is_all_lower and not is_all_upper:\n            return False\n\n    # The dictionary keys satisfy the condition if they are all lowercase OR all uppercase.\n    return is_all_lower or is_all_upper"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Return True if all keys are strings and all are either lower-case or all are upper-case.\n    Return False if the dictionary is empty, contains non-string keys, or has mixed case keys.\n    \"\"\"\n    if not dict:\n        return False\n\n    keys = dict.keys()\n\n    if not all(isinstance(k, str) for k in keys):\n        return False\n\n    first_key = next(iter(keys))\n    is_lower = first_key.islower()\n    is_upper = first_key.isupper()\n\n    # If the first key is not purely lower or purely upper (e.g., \"Name\", \"123\"), it cannot satisfy the condition.\n    if not (is_lower or is_upper):\n        return False\n\n    for k in keys:\n        if is_lower and not k.islower():\n            return False\n        if is_upper and not k.isupper():\n            return False\n\n    return True"}
{"task_id": "HumanEval/96", "solution": "def count_up_to(n):\n    \"\"\"Returns an array of prime numbers less than n using the Sieve of Eratosthenes.\"\"\"\n    if n <= 2:\n        return []\n\n    is_prime = [True] * n\n    is_prime[0] = is_prime[1] = False\n\n    for p in range(2, int(n**0.5) + 1):\n        if is_prime[p]:\n            for multiple in range(p * p, n, p):\n                is_prime[multiple] = False\n\n    primes = [i for i, prime_status in enumerate(is_prime) if prime_status]\n    return primes"}
{"task_id": "HumanEval/96", "solution": "def count_up_to(n):\n    \"\"\"Returns a list of prime numbers less than n, following a sieve-like approach within the function.\"\"\"\n    if n <= 2:\n        return []\n\n    primes = []\n    for i in range(2, n):\n        # Optimization: 2 is the only even prime number.\n        if i == 2:\n            primes.append(i)\n            continue\n        if i % 2 == 0:\n            continue\n\n        # Check for odd divisors up to the square root of i.\n        is_current_number_prime = True\n        divisor = 3\n        while divisor * divisor <= i:\n            if i % divisor == 0:\n                is_current_number_prime = False\n                break\n            divisor += 2\n\n        if is_current_number_prime:\n            primes.append(i)\n\n    return primes"}
