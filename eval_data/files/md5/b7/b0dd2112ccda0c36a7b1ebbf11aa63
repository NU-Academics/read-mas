{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n.\n    Assume n > 1 and is not a prime.\n    \"\"\"\n    last_factor = 1\n\n    # Remove factors of 2 first\n    while n % 2 == 0:\n        last_factor = 2\n        n //= 2\n\n    # Check odd factors up to sqrt(n)\n    factor = 3\n    while factor * factor <= n:\n        while n % factor == 0:\n            last_factor = factor\n            n //= factor\n        factor += 2\n\n    # If n is now a prime > 2\n    if n > 1:\n        last_factor = n\n    return last_factor"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\"\"\"\n\n    class Number:\n        \"\"\"Helper class to encapsulate number logic and prime factorization.\"\"\"\n        def __init__(self, value: int):\n            self.value = value\n            self.is_prime = self._check_prime()\n            self.largest_prime_factor = None\n\n        def _check_prime(self) -> bool:\n            \"\"\"Determines if the number is prime.\"\"\"\n            if self.value <= 1:\n                return False\n            if self.value <= 3:\n                return True\n            if self.value % 2 == 0 or self.value % 3 == 0:\n                return False\n            i = 5\n            while i * i <= self.value:\n                if self.value % i == 0 or self.value % (i + 2) == 0:\n                    return False\n                i += 6\n            return True\n\n        def compute_largest_prime_factor(self) -> int:\n            \"\"\"Computes and returns the largest prime factor of the number.\"\"\"\n            num = self.value\n            largest_factor = None\n\n            while num % 2 == 0:\n                largest_factor = 2\n                num //= 2\n\n            i = 3\n            while i * i <= num:\n                while num % i == 0:\n                    largest_factor = i\n                    num //= i\n                i += 2\n\n            if num > 1:\n                largest_factor = num\n\n            self.largest_prime_factor = largest_factor\n            return largest_factor\n\n    number_obj = Number(n)\n    return number_obj.compute_largest_prime_factor()"}
