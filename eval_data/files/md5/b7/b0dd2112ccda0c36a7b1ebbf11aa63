{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\"\"\"\n\n    class DivisibilityChecker:\n        @staticmethod\n        def is_divisible_by_11_or_13(num: int) -> bool:\n            return num % 11 == 0 or num % 13 == 0\n\n    class DigitCounter:\n        @staticmethod\n        def count_digit_7(num: int) -> int:\n            return str(num).count('7')\n\n    class NumberProcessor:\n        def __init__(self):\n            self.div_checker = DivisibilityChecker()\n            self.digit_counter = DigitCounter()\n\n        def process(self, n_value: int) -> int:\n            total = 0\n            for num in range(n_value):\n                if self.div_checker.is_divisible_by_11_or_13(num):\n                    total += self.digit_counter.count_digit_7(num)\n            return total\n\n    if n <= 0:\n        return 0\n    processor = NumberProcessor()\n    return processor.process(n)"}
{"task_id": "HumanEval/37", "solution": "class List:\n    \"\"\"Abstract list interface used by the domain layer.\n    Provides methods for size, getting, and setting elements.\"\"\"\n    def size(self) -> int:\n        raise NotImplementedError\n    def get(self, index: int) -> int:\n        raise NotImplementedError\n    def set(self, index: int, value: int) -> None:\n        raise NotImplementedError\n\n    @classmethod\n    def from_python_list(cls, py_list: list[int]) -> 'List':\n        # Concrete implementation wraps a Python list\n        return PythonList(py_list)\n\n    def to_python_list(self) -> list[int]:\n        # Convert back to a plain Python list\n        return [self.get(i) for i in range(self.size())]\n\nclass PythonList(List):\n    \"\"\"Concrete implementation of the List interface wrapping a Python list.\"\"\"\n    def __init__(self, py_list: list[int]):\n        self._list = list(py_list) # Make a copy to ensure original is not modified\n\n    def size(self) -> int:\n        return len(self._list)\n\n    def get(self, index: int) -> int:\n        return self._list[index]\n\n    def set(self, index: int, value: int) -> None:\n        self._list[index] = value\n\nclass SortEvenFunction:\n    \"\"\"Encapsulates the business rule for sorting even indices.\n    Sorts elements at even indices while preserving odd indices.\"\"\"\n    def sortEven(self, input_list: List) -> List:\n        # Extract even indices and their corresponding values\n        even_indices = [i for i in range(input_list.size()) if i % 2 == 0]\n        even_values = [input_list.get(i) for i in even_indices]\n        \n        # Sort even values in ascending order\n        even_values.sort()\n        \n        # Build a new list for the output by copying the input\n        output = List.from_python_list(input_list.to_python_list())\n        \n        # Place sorted even values back into their original even indices\n        for idx, val in zip(even_indices, even_values):\n            output.set(idx, val)\n            \n        return output\n\ndef sort_even(l: list) -> list:\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    \"\"\"\n    # Convert standard Python list 'l' to the domain-specific List interface\n    domain_list = List.from_python_list(l)\n    \n    # Execute the core business logic using SortEvenFunction\n    result_domain_list = SortEvenFunction().sortEven(domain_list)\n    \n    # Convert the domain-specific List back to a standard Python list\n    return result_domain_list.to_python_list()"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    result = list(l)  # Create a mutable copy of the input list.\n    \n    # Extract elements from even indices and sort them.\n    even_indexed_elements = [l[i] for i in range(0, len(l), 2)]\n    even_indexed_elements.sort()\n    \n    # Place the sorted elements back into their even positions in the result list.\n    for i in range(0, len(l), 2):\n        result[i] = even_indexed_elements[i // 2]\n        \n    return result"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # cycle elements in each group right. Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # reverse cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/39", "solution": "import math\n\ndef _is_prime(num: int) -> bool:\n    \"\"\"Checks if a number is prime. Optimizes for even numbers and checks odd divisors.\"\"\"\n    if num < 2:\n        return False\n    if num == 2:\n        return True\n    if num % 2 == 0:\n        return False\n    # Check for factors from 3 up to sqrt(num) with a step of 2.\n    for i in range(3, int(math.sqrt(num)) + 1, 2):\n        if num % i == 0:\n            return False\n    return True\n\ndef _fibonacci_generator():\n    \"\"\"Generates Fibonacci numbers starting from F_3 = 2.\"\"\"\n    # F_0=0, F_1=1, F_2=1, F_3=2, F_4=3, F_5=5, ...\n    # The examples imply we start counting from 2 as the first prime fib.\n    a, b = 1, 2  # Represents F_2 and F_3\n    yield b      # Yield F_3 = 2\n    while True:\n        a, b = b, a + b\n        yield b\n\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    count = 0\n    fib_gen = _fibonacci_generator()\n    \n    while True:\n        fib_num = next(fib_gen)\n        if _is_prime(fib_num):\n            count += 1\n            if count == n:\n                return fib_num"}
{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n\n    if n < 1:\n        raise ValueError(\"n must be a positive integer\")\n\n    class FibonacciGenerator:\n        \"\"\"Generates Fibonacci numbers.\"\"\"\n        def __init__(self):\n            self.a = 0\n            self.b = 1\n\n        def next_fibonacci(self) -> int:\n            fib_num = self.a\n            self.a, self.b = self.b, self.a + self.b\n            return fib_num\n\n    class PrimeChecker:\n        \"\"\"Checks if a number is prime.\"\"\"\n        def is_prime(self, number: int) -> bool:\n            if number < 2:\n                return False\n            if number == 2:\n                return True\n            if number % 2 == 0:\n                return False\n            i = 3\n            while i * i <= number:\n                if number % i == 0:\n                    return False\n                i += 2\n            return True\n\n    prime_checker = PrimeChecker()\n    fib_generator = FibonacciGenerator()\n    \n    count = 0\n    while True:\n        fib_num = fib_generator.next_fibonacci()\n        if prime_checker.is_prime(fib_num):\n            count += 1\n            if count == n:\n                return fib_num"}
