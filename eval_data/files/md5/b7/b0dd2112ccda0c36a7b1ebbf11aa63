{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"Computes the n-th element of the Fib4 number sequence iteratively.\"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # Initialize a cache to store computed Fib4 numbers up to n.\n    cache = [0] * (n + 1)\n    cache[0] = 0\n    cache[1] = 0\n    cache[2] = 2\n    cache[3] = 0\n\n    # Iteratively compute fib4(i) using the sum of the four preceding values.\n    for i in range(4, n + 1):\n        cache[i] = cache[i-1] + cache[i-2] + cache[i-3] + cache[i-4]\n\n    return cache[n]"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"\n    Computes the n-th element of the fib4 number sequence efficiently using an iterative approach.\n    \"\"\"\n    if n == 0 or n == 1 or n == 3:\n        return 0\n    if n == 2:\n        return 2\n\n    # Initialize the first four values: fib4(0), fib4(1), fib4(2), fib4(3)\n    a, b, c, d = 0, 0, 2, 0\n\n    # Iterate from n=4 up to the desired n\n    for _ in range(4, n + 1):\n        next_fib = a + b + c + d\n        a, b, c, d = b, c, d, next_fib\n    \n    return d"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\"\"\"\n\n    class NumericList:\n        \"\"\"Immutable holder for the input list, converting all values to float.\"\"\"\n        def __init__(self, values: list):\n            self.values = [float(v) for v in values]\n\n    class MedianResult:\n        \"\"\"Data class holding the computed median value and its derived type.\"\"\"\n        def __init__(self, value: float):\n            self.value = value\n            if value == int(value):\n                self.type = \"int\"\n            else:\n                self.type = \"float\"\n\n    class MedianCalculator:\n        \"\"\"Implements the business logic for median calculation.\"\"\"\n        def calculate(self, numeric_list: NumericList) -> MedianResult:\n            sorted_values = sorted(numeric_list.values)\n            n = len(sorted_values)\n\n            if n % 2 == 1:\n                # Odd number of elements: median is the middle element\n                median_value = sorted_values[n // 2]\n            else:\n                # Even number of elements: median is the average of the two middle elements\n                mid1 = sorted_values[n // 2 - 1]\n                mid2 = sorted_values[n // 2]\n                median_value = (mid1 + mid2) / 2.0\n\n            return MedianResult(median_value)\n\n    numeric_list_obj = NumericList(l)\n    calculator = MedianCalculator()\n    median_result_obj = calculator.calculate(numeric_list_obj)\n\n    # Return the value, casting to int if it's a whole number as per design requirements.\n    if median_result_obj.type == \"int\":\n        return int(median_result_obj.value)\n    else:\n        return median_result_obj.value"}
