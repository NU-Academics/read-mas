ol.\"\"\"\n        return self.cells[row][col]\n\n    def get_N(self) -> int:\n        \"\"\"Returns the grid dimension N.\"\"\"\n        return self._N\n\nclass PathFinderService:\n    \"\"\"Implements the core algorithm to find the lexicographically smallest path.\"\"\"\n    def find_min_path(self, grid_values: list[list[int]], k: int) -> list[int]:\n        \"\"\"Initiates pathfinding and returns the values of the minimum path.\"\"\"\n        grid_obj = Grid(grid_values)\n        N_grid = grid_obj.get_N()\n        \n        min_path_container = [None] # Use a list to pass by reference for mutable object\n\n        for r in range(N_grid):\n            for c in range(N_grid):\n                start_cell = grid_obj.get_cell(r, c)\n                initial_path = Path([start_cell])\n                self._explore_paths(grid_obj, k, initial_path, min_path_container)\n        \n        return min_path_container[0].values\n\n    def _explore_paths(self, grid: Grid, k: int, current_path: Path, min_path_container: list[Path]) -> None:\n        \"\"\"Recursively explores paths, pruning branches that cannot lead to a smaller path.\"\"\"\n        if current_path.get_length() == k:\n            if min_path_container[0] is None or current_path.is_lexicographically_smaller(min_path_container[0]):\n                min_path_container[0] = current_path\n            return\n\n        # Pruning logic: If current_path's prefix is already lexicographically greater than\n        # the corresponding prefix of the best path found so far, prune this branch.\n        if min_path_container[0] is not None:\n            current_prefix_values = current_path.values\n            best_path_prefix_values = min_path_container[0].values[:len(current_prefix_values)]\n\n            if current_prefix_values > best_path_prefix_values:\n                return # Prune this branch\n                    \n        last_cell = current_path.cells[-1]\n        N_grid = grid.get_N()\n        \n        for next_r, n