ts according to functional requirements.\"\"\"\n        # FR3: Length of operator list must be one less than operand list.\n        if len(operators) != len(operands) - 1:\n            raise InvalidExpressionError(\n                f\"Length mismatch: operators ({len(operators)}) should be one less than operands ({len(operands)}).\"\n            )\n        \n        # FR4: Operator list must have at least one, operand list at least two elements.\n        if len(operators) < 1 or len(operands) < 2:\n            raise InvalidExpressionError(\n                \"Operator list must have at least one operator, and operand list at least two operands.\"\n            )\n\n        # FR1: Validate operators.\n        for op in operators:\n            if not isinstance(op, str) or op not in AlgebraEvaluator.SUPPORTED_OPERATORS:\n                raise InvalidOperatorError(f\"Unsupported or invalid operator: '{op}'.\")\n\n        # FR2: Validate operands.\n        for operand in operands:\n            if not isinstance(operand, int) or operand < 0:\n                raise InvalidOperandError(f\"Operand '{operand}' is not a non-negative integer.\")\ndef do_algebra(operator: list[str], operand: list[int]) -> int:\n    \"\"\"\n    Given two lists, operator and operand, build an algebraic expression.\n    Evaluate the expression respecting standard operator precedence and return the result.\n    \"\"\"\n    return AlgebraEvaluator.evaluate(operator, operand)", "base_status": "timeout", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[["**", "**", "//"], [9, 2, 5, 3]]]}]}}