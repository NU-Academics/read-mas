tatus": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/147", "solution": "import math\ndef get_max_triples(n):\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) where i < j < k and their sum is a multiple of 3.\n    It efficiently categorizes array elements by their remainder modulo 3.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    # Categorize a[i] values by their remainder when divided by 3.\n    # Based on the pattern: a[i] % 3 is 0 if i % 3 == 2, and 1 otherwise.\n    counts = {0: 0, 1: 0, 2: 0}\n    for i in range(1, n + 1):\n        if i % 3 == 2:\n            counts[0] += 1\n        else:\n            counts[1] += 1\n\n    c0 = counts.get(0, 0)\n    c1 = counts.get(1, 0)\n    c2 = counts.get(2, 0)\n\n    total_triples = 0\n\n    # Count combinations of remainders that sum to a multiple of 3.\n    # Case (0, 0, 0), (1, 1, 1), (2, 2, 2) and (0, 1, 2)\n    total_triples += math.comb(c0, 3)\n    total_triples += math.comb(c1, 3)\n    total_triples += math.comb(c2, 3)\n    total_triples += c0 * c1 * c2\n    \n    return total_triples", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/148": [{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun \n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn, \n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2. \n    The function should return a tuple containing all planets whose orbits are \n    located between the orbit of planet1 and the orbit of planet2, sorted by \n    the proximity to the sun. \n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names. \n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    class PlanetOrder:\n        _SOLAR_SYSTEM_PLANETS: list[str] = [\n            \"Mercury\", \"Venus\", \"Earth\", \"Mars\",\n            \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n        ]\n\n        def get_planet_index(self, planet_name: str) -> int:\n            \"\"\"Returns the 0-based index of a given planet name, or -1 if not found.\"\"\"\n            try:\n                return self._SOLAR_SYSTEM_PLANETS.index(planet_name)\n            except ValueError:\n                return -1\n\n        def get_planet_by_index(self, index: int) -> str:\n            \"\"\"Returns the planet name at the given index.\"\"\"\n            return self._SOLAR_SYSTEM_PLANETS[index]\n\n        def get_all_planets(self) -> list[str]:\n            \"\"\"Returns a copy of the solar system planets list.\"\"\"\n            return list(self._SOLAR_SYSTEM_PLANETS)\n\n    def normalize_planet_name(name: str) -> str:\n        \"\"\"Converts a planet name string to title case for consistent lookup.\"\"\"\n        return name.title()\n\n    class PlanetService:\n        def __init__(self, planet_order: PlanetOrder):\n            \"\"\"Initializes the service with a PlanetOrder instance.\"\"\"\n            self._planet_order = planet_order\n\n        def get_planets_between(self, planet1: str, planet2: str) -> tuple[str, ...]:\n            \"\"\"\n            Finds and returns planets between two given planets, sorted by sun proximity.\n            Returns an empty tuple if any planet name is invalid or no planets are between them.\n            \"\"\"\n            normalized_planet1 = normalize_planet_name(planet1)\n            normalized_planet2 = normalize_planet_name(planet2)\n\n            idx1 = self._planet_order.get_planet_index(normalized_planet1)\n            idx2 = self._planet_order.get_planet_index(normalized_pl