_x)\n\n        try:\n            root = self._root_finder.find_root(\n                poly_func=poly_func,\n                deriv_func=deriv_func,\n                initial_guess=0.0, # DEFAULT_TOLERANCE, MAX_ITERATIONS, INITIAL_GUESS are defined in config.py\n                tolerance=1e-6,\n                max_iterations=1000\n            )\n            return root\n        except RootNotFoundError as e:\n            raise RootNotFoundError(f\"Failed to find root: {e}\")\n        except Exception as e:\n            # Catch unexpected errors from root finder.\n            raise RootNotFoundError(f\"An unexpected error occurred during root finding: {e}\")\nroot_finder_strategy = NewtonRaphsonRootFinder()\npolynomial_service = PolynomialService(root_finder=root_finder_strategy)\ndef find_zero(xs: list) -> float:\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    try:\n        return polynomial_service.find_polynomial_zero(xs)\n    except (InvalidInputError, RootNotFoundError) as e:\n        raise ValueError(f\"Could not find root for find_zero: {e}\")", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/36": [{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int) -> int:\n    \"\"\"Calculates the total count of the digit '7' in numbers less than 'n' that are divisible by 11 or 13.\"\"\"\n    total_seven_count = 0\n    for i in range(1, n):\n        if i % 11 == 0 or i % 13 == 0:\n            total_seven_count += str(i).count('7')\n    return total_seven_count", "b