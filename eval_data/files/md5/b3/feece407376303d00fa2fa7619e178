{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"Computes the n-th element of the fib4 number sequence efficiently without recursion.\n    The sequence is defined by fib4(0)=0, fib4(1)=0, fib4(2)=2, fib4(3)=0,\n    and fib4(n) = fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4) for n >= 4.\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # Initialize the last four fib4 numbers required for the recurrence:\n    # fib4(0), fib4(1), fib4(2), fib4(3)\n    f_n_minus_4 = 0  # Represents fib4(i-4)\n    f_n_minus_3 = 0  # Represents fib4(i-3)\n    f_n_minus_2 = 2  # Represents fib4(i-2)\n    f_n_minus_1 = 0  # Represents fib4(i-1)\n\n    # Iterate from n=4 up to the desired 'n'\n    for _ in range(4, n + 1):\n        current_fib = f_n_minus_1 + f_n_minus_2 + f_n_minus_3 + f_n_minus_4\n        # Update the window for the next iteration\n        f_n_minus_4 = f_n_minus_3\n        f_n_minus_3 = f_n_minus_2\n        f_n_minus_2 = f_n_minus_1\n        f_n_minus_1 = current_fib\n    \n    return f_n_minus_1"}
{"task_id": "HumanEval/45", "solution": "import math\n\ndef triangle_area(a, h):\n    \"\"\"Given length of a side and high return area for a triangle.\n    >>> triangle_area(5, 3)\n    7.5\n    \"\"\"\n    return (a * h) / 2.0"}
{"task_id": "HumanEval/48", "solution": "import unicodedata\n\ndef is_palindrome(text: str) -> bool:\n    \"\"\"\n    Checks if given string is a palindrome after normalizing it.\n    Normalization involves case-folding and keeping only letters and numbers.\n    \"\"\"\n    normalized_chars = [\n        char for char in text.casefold()\n        if unicodedata.category(char).startswith(('L', 'N'))\n    ]\n    normalized_text = \"\".join(normalized_chars)\n    return normalized_text == normalized_text[::-1]"}
{"task_id": "HumanEval/47", "solution": "import math\n\ndef median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n    \n    if n % 2 == 1:\n        return sorted_l[n // 2]\n    else:\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        return (mid1 + mid2) / 2.0"}
