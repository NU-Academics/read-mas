{"task_id": "HumanEval/36", "solution": "import collections\nfrom typing import Iterator, List, Set, Iterable\n\n# --- Exceptions ---\nclass InvalidInputError(ValueError):\n    def __init__(self, message: str):\n        super().__init__(message)\n\n# --- Configuration ---\nDEFAULT_DIVISORS: List[int] = [11, 13]\nDEFAULT_DIGIT: int = 7\n\n# --- Validator ---\nclass InputValidator:\n    def validate_n(self, n: int) -> None:\n        if not isinstance(n, int):\n            raise InvalidInputError(\"n must be an integer\")\n        if n < 0:\n            raise InvalidInputError(\"n must be >= 0\")\n\n# --- Generator ---\nclass NumberGenerator:\n    def generate_multiples_below(self, n: int, divisors: List[int]) -> Iterator[int]:\n        if not divisors:\n            return iter(())\n        \n        # Using a set to ensure deduplication.\n        # For very large N, a priority queue merge might be more memory efficient\n        # but more complex for a small number of divisors.\n        multiples = set()\n        for d in divisors:\n            if d <= 0:\n                raise ValueError(\"divisors must be positive integers\")\n            cur = d\n            while cur < n:\n                multiples.add(cur)\n                cur += d\n        \n        # Yield in sorted order as implied by common multiple generation behavior\n        yield from sorted(list(multiples))\n\n# --- Counter ---\nclass DigitCounter:\n    def count_digit_in_number(self, num: int, digit: int) -> int:\n        \"\"\"Return the number of times a digit appears in the decimal representation of a number.\"\"\"\n        s = str(abs(num))\n        return s.count(str(digit))\n\n    def count_digit_in_iterable(self, nums: Iterable[int], digit: int) -> int:\n        \"\"\"Sum digit occurrences for each number in an iterable.\"\"\"\n        total = 0\n        dch = str(digit) # Convert digit to string once for efficiency\n        for num in nums:\n            total += str(abs(num)).count(dch)\n        return total\n\n# --- Service ---\nclass FizzBuzzService:\n    def __init__(self, generator: NumberGenerator, counter: DigitCounter, validator: InputValidator, divisors: List[int], digit: int):\n        self._generator = generator\n        self._counter = counter\n        self._validator = validator\n        self._divisors = divisors\n        self._digit = digit\n\n    def count_digit_in_multiples(self, n: int) -> int:\n        \"\"\"Validate n, generate multiples, count digit occurrences, and return the total.\"\"\"\n        self._validator.validate_n(n)\n        nums = self._generator.generate_multiples_below(n, self._divisors)\n        return self._counter.count_digit_in_iterable(nums, self._digit)\n\n    def count_digit_in_multiples_with_overrides(self, n: int, divisors: List[int], digit: int) -> int:\n        \"\"\"Allow one-off override of defaults for divisors and digit for testing or specific scenarios.\"\"\"\n        self._validator.validate_n(n)\n        nums = self._generator.generate_multiples_below(n, divisors)\n        return self._counter.count_digit_in_iterable(nums, digit)\n\ndef fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    svc = FizzBuzzService(NumberGenerator(), DigitCounter(), InputValidator(), DEFAULT_DIVISORS, DEFAULT_DIGIT)\n    return svc.count_digit_in_multiples(n)"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    if not l:\n        return []\n\n    indices_to_sort = []\n    values_to_sort = []\n\n    # Extract values and their original indices that are divisible by three\n    for i, item in enumerate(l):\n        if i % 3 == 0:\n            indices_to_sort.append(i)\n            values_to_sort.append(item)\n\n    # Sort the extracted values\n    values_to_sort.sort()\n\n    # Create a new list to store the result, as the original list should not be mutated\n    result_list = l[:]\n\n    # Place the sorted values back into their original positions\n    for i, index in enumerate(indices_to_sort):\n        result_list[index] = values_to_sort[i]\n\n    return result_list"}
{"task_id": "HumanEval/32", "solution": "import math\n\n\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\n\n\ndef _derivative_coeffs(xs: list) -> list:\n    \"\"\"Computes coefficients of the derivative of a polynomial.\"\"\"\n    if not xs or len(xs) == 1:\n        return [0.0]\n    return [i * xs[i] for i in range(1, len(xs))]\n\n\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    # Define tolerances and maximum iterations for numerical methods.\n    TOLERANCE = 1e-9\n    MAX_BISECT_ITER = 100\n    MAX_NEWTON_ITER = 50\n    MAX_BRACKET_SEARCH = 20\n\n    # 1. Find a suitable bracket [a, b] for the root.\n    # An odd-degree polynomial (guaranteed by even len(xs)) always has at least one real root.\n    # Search outwards from 0 in geometrically increasing steps to find a sign change.\n    search_points = [0.0]\n    for i in range(MAX_BRACKET_SEARCH):\n        search_points.append(2.0**i)\n        search_points.append(-(2.0**i))\n    search_points.sort()\n\n    a, b = None, None\n    for i in range(len(search_points) - 1):\n        x1 = search_points[i]\n        x2 = search_points[i+1]\n        f1 = poly(xs, x1)\n        f2 = poly(xs, x2)\n\n        if abs(f1) < TOLERANCE: return x1\n        if abs(f2) < TOLERANCE: return x2\n        \n        if math.copysign(1, f1) != math.copysign(1, f2):\n            a, b = x1, x2\n            break\n    \n    # At this point, a bracket [a, b] must have been found due to problem constraints.\n\n    # 2. Use Bisection method to narrow down the root within the bracket [a, b].\n    # This provides a good initial guess for Newton-Raphson.\n    current_a = a\n    current_b = b\n    f_current_a = poly(xs, current_a)\n\n    for _ in range(MAX_BISECT_ITER):\n        mid = (current_a + current_b) / 2.0\n        f_mid = poly(xs, mid)\n\n        if abs(f_mid) < TOLERANCE:\n            current_a = mid # Root found or very close\n            break\n        \n        if math.copysign(1, f_current_a) != math.copysign(1, f_mid):\n            current_b = mid\n            # f_current_b = f_mid # Not strictly needed if only comparing with f_current_a\n        else:\n            current_a = mid\n            f_current_a = f_mid\n            \n    initial_guess = (current_a + current_b) / 2.0\n\n    # 3. Refine the root using Newton-Raphson method for faster convergence.\n    coeffs_prime = _derivative_coeffs(xs)\n\n    root = initial_guess\n    for _ in range(MAX_NEWTON_ITER):\n        f_root = poly(xs, root)\n        f_prime_root = poly(coeffs_prime, root)\n\n        if abs(f_prime_root) < 1e-12: # Derivative too close to zero, Newton-Raphson may be unstable.\n            return root # Return current best approximation.\n\n        next_root = root - f_root / f_prime_root\n        \n        if abs(next_root - root) < TOLERANCE:\n            return next_root\n        \n        root = next_root\n        \n    return root # Return the best approximation found after max iterations."}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    if not l:\n        return []\n\n    # Create a mutable copy of the input list to preserve the original if needed\n    result = list(l)\n\n    # Extract elements at even indices\n    even_elements = [result[i] for i in range(0, len(result), 2)]\n\n    # Sort the extracted even elements\n    even_elements.sort()\n\n    # Reinsert the sorted even elements back into the result list at their original even positions\n    for i in range(0, len(result), 2):\n        result[i] = even_elements[i // 2]\n\n    return result"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # cycle elements in each group to reverse encoding. Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/43", "solution": "import collections\n\ndef pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    >>> pairs_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> pairs_sum_to_zero([1, 3, -2, 1])\n    False\n    >>> pairs_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> pairs_sum_to_zero([2, 4, -5, 3, 5, 7])\n    True\n    >>> pairs_sum_to_zero([1])\n    False\n    \"\"\"\n    seen = set()\n    for x in l:\n        if -x in seen:\n            # Found a pair (x, -x) where -x was seen earlier.\n            # Since x is currently being processed and -x was \"seen\", they must be distinct elements (at different indices).\n            return True\n        seen.add(x)\n    return False"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    Checks if there are three distinct elements in the list that sum to zero.\n    Uses a two-pointer approach on a sorted copy of the list for O(n^2) complexity.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    arr = sorted(l)\n\n    for i in range(n - 2):\n        a = arr[i]\n        left, right = i + 1, n - 1\n\n        while left < right:\n            b = arr[left]\n            c = arr[right]\n            current_sum = a + b + c\n\n            if current_sum == 0:\n                return True\n            elif current_sum < 0:\n                left += 1\n            else:  # current_sum > 0\n                right -= 1\n    return False"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    if x == 0:\n        return \"0\"\n\n    digits = []\n    current_value = x\n    while current_value > 0:\n        digits.append(current_value % base)\n        current_value //= base\n\n    digits.reverse()\n    return \"\".join(str(d) for d in digits)"}
{"task_id": "HumanEval/39", "solution": "import logging\nimport json\nimport os\nimport tempfile\nimport threading\nfrom pathlib import Path\nfrom datetime import datetime, timezone\nfrom typing import Optional, Iterator, List, Dict, Any\n\nclass PrimeFibError(Exception):\n    \"\"\"Base exception for primefib operations.\"\"\"\n    pass\n\nclass InvalidInputError(PrimeFibError, ValueError):\n    \"\"\"Exception raised for invalid input parameters.\"\"\"\n    pass\n\nclass ResultDTO:\n    \"\"\"Data Transfer Object for cached Fibonacci prime results.\"\"\"\n    def __init__(self, n: int, value: int, computed_at: datetime) -> None:\n        self.n = n\n        self.value = value\n        self.computed_at = computed_at\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Converts the DTO to a dictionary for serialization.\"\"\"\n        return {\n            \"value\": self.value,\n            \"computed_at\": self.computed_at.isoformat()\n        }\n\n    @classmethod\n    def from_dict(cls, n: int, d: Dict[str, Any]) -> \"ResultDTO\":\n        \"\"\"Creates a ResultDTO from a dictionary.\"\"\"\n        computed_at_str = d.get(\"computed_at\")\n        if computed_at_str:\n            try:\n                computed_at = datetime.fromisoformat(computed_at_str)\n            except ValueError:\n                computed_at = datetime.min.replace(tzinfo=timezone.utc)\n        else:\n            computed_at = datetime.min.replace(tzinfo=timezone.utc)\n        return cls(n=n, value=d[\"value\"], computed_at=computed_at)\n\ndef _atomic_write_json(path: Path, data: Dict[str, Any]) -> None:\n    \"\"\"Atomically writes JSON data to a file.\"\"\"\n    temp_file_name = None\n    try:\n        temp_dir = path.parent\n        with tempfile.NamedTemporaryFile(mode='w', delete=False, dir=temp_dir, encoding='utf-8') as temp_file:\n            temp_file_name = temp_file.name\n            json.dump(data, temp_file, indent=2)\n            temp_file.flush()\n            os.fsync(temp_file.fileno())\n        os.replace(temp_file_name, path)\n    except Exception as e:\n        if temp_file_name and os.path.exists(temp_file_name):\n            os.remove(temp_file_name)\n        raise PrimeFibError(f\"Failed to atomically write cache file {path}: {e}\") from e\n\ndef _default_cache_path() -> Path:\n    \"\"\"Determines the default cache file path.\"\"\"\n    xdg_cache_home = os.environ.get(\"XDG_CACHE_HOME\")\n    if xdg_cache_home:\n        return Path(xdg_cache_home) / \"primefib\" / \"cache.json\"\n    return Path(\"./cache.json\")\n\n_LOGGER = logging.getLogger(\"primefib\")\n_LOGGER.setLevel(logging.WARNING)\nif not _LOGGER.handlers:\n    handler = logging.StreamHandler()\n    formatter = logging.Formatter('%(asctime)s - %(name)s - %(levelname)s - %(message)s')\n    handler.setFormatter(formatter)\n    _LOGGER.addHandler(handler)\n\nclass FileCacheAdapter:\n    \"\"\"A file-based persistent cache adapter using JSON.\"\"\"\n    def __init__(self, path: Path) -> None:\n        self._path = path\n        self._lock = threading.Lock()\n        self._path.parent.mkdir(parents=True, exist_ok=True)\n\n    def _load(self) -> Dict[str, Any]:\n        \"\"\"Loads data from the cache file.\"\"\"\n        if not self._path.exists():\n            return {}\n        try:\n            with self._path.open(\"r\", encoding=\"utf-8\") as f:\n                return json.load(f)\n        except json.JSONDecodeError as e:\n            _LOGGER.warning(f\"Malformed cache file {self._path}, ignoring content: {e}\")\n            return {}\n        except Exception as e:\n            _LOGGER.warning(f\"Could not load cache file {self._path}: {e}\")\n            return {}\n\n    def _save(self, data: Dict[str, Any]) -> None:\n        \"\"\"Saves data to the cache file using atomic write.\"\"\"\n        _atomic_write_json(self._path, data)\n\n    def get(self, n: int) -> Optional[int]:\n        \"\"\"Retrieves a cached value for n.\"\"\"\n        with self._lock:\n            data = self._load()\n            entry = data.get(str(n))\n            if entry:\n                try:\n                    return int(entry[\"value\"])\n                except (ValueError, KeyError) as e:\n                    _LOGGER.warning(f\"Malformed cache entry for n={n} in {self._path}, ignoring: {e}\")\n                    return None\n            return None\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Sets a value in the cache for n.\"\"\"\n        with self._lock:\n            data = self._load()\n            dto = ResultDTO(n=n, value=value, computed_at=datetime.now(timezone.utc))\n            data[str(n)] = dto.to_dict()\n            self._save(data)\n\nclass FibonacciGenerator:\n    \"\"\"Generates Fibonacci numbers.\"\"\"\n    def __init__(self) -> None:\n        self._memo: Dict[int, int] = {0: 0, 1: 1}\n\n    def iter_sequence(self) -> Iterator[int]:\n        \"\"\"Returns an iterator yielding Fibonacci numbers indefinitely.\"\"\"\n        a, b = 0, 1\n        while True:\n            yield a\n            a, b = b, a + b\n\nclass PrimeChecker:\n    \"\"\"Checks if a number is prime using optimized trial division and Miller-Rabin.\"\"\"\n    def __init__(self, deterministic_upper: int = 2**64) -> None:\n        self._deterministic_upper = deterministic_upper\n\n    def _miller_rabin(self, n: int, bases: List[int]) -> bool:\n        \"\"\"Internal Miller-Rabin primality test.\"\"\"\n        if n < 2 or n % 2 == 0: return False\n        if n == 2: return True\n\n        s = 0\n        d = n - 1\n        while d % 2 == 0:\n            d //= 2\n            s += 1\n\n        for a in bases:\n            if a >= n: continue\n\n            x = pow(a, d, n)\n            if x == 1 or x == n - 1:\n                continue\n\n            for _ in range(s - 1):\n                x = pow(x, 2, n)\n                if x == n - 1:\n                    break\n            else:\n                return False\n        return True\n\n    def is_prime(self, n: int) -> bool:\n        \"\"\"Determines if a given integer n is prime.\"\"\"\n        if n < 2: return False\n        if n <= 3: return True\n        if n % 2 == 0 or n % 3 == 0: return False\n\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        \n        # Miller-Rabin bases for deterministic primality up to 2^64\n        bases = [2,325,9375,28178,450775,9780504,1795265022]\n        return self._miller_rabin(n, bases)\n\nclass PrimeFibonacciService:\n    \"\"\"Orchestrates finding the n-th Fibonacci prime, utilizing generator, checker, and cache.\"\"\"\n    def __init__(self, generator: FibonacciGenerator, checker: PrimeChecker, repository: FileCacheAdapter, logger: logging.Logger) -> None:\n        self._generator = generator\n        self._checker = checker\n        self._repository = repository\n        self._logger = logger\n        self._known_fib_primes: Dict[int, int] = {}\n\n    def _compute_and_cache(self, n: int) -> int:\n        \"\"\"Computes Fibonacci primes up to n, caching results.\"\"\"\n        fib_iterator = self._generator.iter_sequence()\n        found_primes_count = 0\n        \n        # Skip F(0)=0, F(1)=1, F(2)=1 as they are not prime\n        next(fib_iterator) # 0\n        next(fib_iterator) # 1\n        next(fib_iterator) # 1\n\n        while True:\n            current_fib = next(fib_iterator)\n            if current_fib < 2: # Should not happen after skipping initial non-primes, but for safety\n                continue\n            \n            if self._checker.is_prime(current_fib):\n                found_primes_count += 1\n                self._known_fib_primes[found_primes_count] = current_fib\n                self._repository.set(found_primes_count, current_fib)\n\n                if found_primes_count == n:\n                    self._logger.info(f\"Computed {n}-th Fibonacci prime: {current_fib}\")\n                    return current_fib\n    \n    def get_nth_fib_prime(self, n: int) -> int:\n        \"\"\"Returns the n-th number that is both a Fibonacci number and prime.\"\"\"\n        if n in self._known_fib_primes:\n            return self._known_fib_primes[n]\n\n        cached_value = self._repository.get(n)\n        if cached_value is not None:\n            self._known_fib_primes[n] = cached_value\n            return cached_value\n\n        return self._compute_and_cache(n)\n\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    svc = PrimeFibonacciService(\n        generator=FibonacciGenerator(),\n        checker=PrimeChecker(),\n        repository=FileCacheAdapter(_default_cache_path()),\n        logger=_LOGGER,\n    )\n    return svc.get_nth_fib_prime(n)"}
{"task_id": "HumanEval/41", "solution": "def car_race_collision(n: int):\n    \"\"\"\n    Imagine a road that's a perfectly straight infinitely long line.\n    n cars are driving left to right;  simultaneously, a different set of n cars\n    are driving right to left.   The two sets of cars start out being very far from\n    each other.  All cars move in the same speed.  Two cars are said to collide\n    when a car that's moving left to right hits a car that's moving right to left.\n    However, the cars are infinitely sturdy and strong; as a result, they continue moving\n    in their trajectory as if they did not collide.\n\n    This function outputs the number of such collisions.\n    \"\"\"\n    # In this symmetric scenario, each of the n cars moving left-to-right\n    # will collide with each of the n cars moving right-to-left.\n    # The total number of unique collisions is therefore n * n.\n    return n * n"}
