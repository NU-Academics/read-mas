{"task_id": "HumanEval/5", "solution": "from typing import List\n\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers' \"\"\"\n    if len(numbers) <= 1:\n        return list(numbers)\n\n    result_len = 2 * len(numbers) - 1\n    result: List[int] = [0] * result_len\n    \n    # Place original numbers at even indices\n    result[0::2] = numbers\n    \n    # Place delimeter at odd indices\n    result[1::2] = [delimeter] * (len(numbers) - 1)\n    \n    return result"}
{"task_id": "HumanEval/1", "solution": "from typing import List, Tuple, Iterator, Optional, Set\n\nclass ParsingError(Exception):\n    \"\"\"Domain-specific exception for parsing/validation errors.\"\"\"\n    def __init__(self, message: str, position: Optional[int] = None) -> None:\n        self.message = message\n        self.position = position\n        super().__init__(self.message)\n\nclass ParenthesisGroup:\n    \"\"\"Simple value object representing one balanced parenthesis group.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def __str__(self) -> str:\n        return self.value\n\n    def to_str(self) -> str:\n        return self.value\n\nclass StringCleaner:\n    \"\"\"Utility to clean strings by removing whitespace.\"\"\"\n    @staticmethod\n    def clean(s: str) -> str:\n        return \"\".join(ch for ch in s if not ch.isspace())\n\nVALID_TOKENS: Set[str] = {\"(\", \")\"}\n\nclass Tokenizer:\n    \"\"\"Iterates over characters of interest and validates allowed characters.\"\"\"\n    def tokenize(self, s: str) -> Iterator[Tuple[int, str]]:\n        for i, ch in enumerate(s):\n            yield i, ch\n\n    def validate_tokens(self, s: str) -> None:\n        for i, ch in enumerate(s):\n            if ch not in VALID_TOKENS:\n                raise ParsingError(f\"Illegal character '{ch}'\", position=i)\n\nclass ParenGroupParser:\n    \"\"\"Core single-pass algorithm that extracts top-level balanced parenthesis groups.\"\"\"\n    def __init__(self, tokenizer: Tokenizer = None):\n        self.tokenizer = tokenizer or Tokenizer()\n\n    def parse(self, s: str) -> List[ParenthesisGroup]:\n        clean_s = StringCleaner.clean(s)\n        self.tokenizer.validate_tokens(clean_s)\n        it = self.tokenizer.tokenize(clean_s)\n        \n        groups: List[ParenthesisGroup] = []\n        depth = 0\n        buf: List[str] = []\n        \n        for idx, ch in it:\n            if ch == '(':\n                buf.append(ch)\n                depth += 1\n            elif ch == ')':\n                if depth == 0:\n                    raise ParsingError(\"Unmatched closing parenthesis\", position=idx)\n                buf.append(ch)\n                depth -= 1\n                if depth == 0:\n                    groups.append(ParenthesisGroup(\"\".join(buf)))\n                    buf = []\n        \n        if depth != 0:\n            error_pos = len(clean_s) - 1 if clean_s else 0\n            raise ParsingError(\"Unmatched opening parenthesis\", position=error_pos)\n            \n        return groups\n\nclass ParserService:\n    \"\"\"Thin facade over ParenGroupParser to provide public API and error translation.\"\"\"\n    def __init__(self, parser: ParenGroupParser = None) -> None:\n        self._parser = parser or ParenGroupParser()\n\n    def separate_groups(self, s: str) -> List[str]:\n        parenthesis_groups = self._parser.parse(s)\n        return [g.to_str() for g in parenthesis_groups]\n\n_service = ParserService()\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Separates groups of nested parentheses into a list of balanced strings. \"\"\"\n    return _service.separate_groups(paren_string)"}
{"task_id": "HumanEval/4", "solution": "from typing import List\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    # Calculate the arithmetic mean of the numbers.\n    mean_value = sum(numbers) / len(numbers)\n\n    # Calculate the absolute deviations from the mean for each number.\n    absolute_deviations = [abs(x - mean_value) for x in numbers]\n\n    # Calculate the mean of these absolute deviations to get the MAD.\n    mad = sum(absolute_deviations) / len(absolute_deviations)\n\n    return mad"}
{"task_id": "HumanEval/3", "solution": "def below_zero(operations: List[int]) -> bool:\n    \"\"\" You're given a list of deposit and withdrawal operations on a bank account that starts with\n    zero balance. Your task is to detect if at any point the balance of account fallls below zero, and\n    at that point function should return True. Otherwise it should be False.\n    \"\"\"\n    balance = 0\n    for op in operations:\n        balance += op\n        if balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/6", "solution": "from typing import List\n\n# Helper functions are defined inline as per instructions:\n# - No helper that is not defined inline in your response.\n\nclass InvalidGroupError(Exception):\n    \"\"\"Signal invalid characters in a group.\"\"\"\n    def __init__(self, group: str, message: str = None) -> None:\n        self.group = group\n        self.message = message or f\"Group '{group}' contains invalid characters.\"\n        super().__init__(self.message)\n\nclass UnbalancedParenthesesError(Exception):\n    \"\"\"Signal mismatched parentheses in a group.\"\"\"\n    def __init__(self, group: str, message: str = None) -> None:\n        self.group = group\n        self.message = message or f\"Group '{group}' has unbalanced parentheses.\"\n        super().__init__(self.message)\n\n\ndef _is_group_valid(group: str) -> bool:\n    \"\"\"Return True if group only contains '(' and ')', False otherwise.\"\"\"\n    return all(ch == '(' or ch == ')' for ch in group)\n\n\ndef _compute_depth(group: str) -> int:\n    \"\"\"Compute the maximum nesting depth for a single parenthesis group.\n    Raises UnbalancedParenthesesError if parentheses are mismatched or invalid.\n    \"\"\"\n    counter = 0\n    max_depth = 0\n    for ch in group:\n        if ch == \"(\":\n            counter += 1\n            if counter > max_depth:\n                max_depth = counter\n        elif ch == \")\":\n            counter -= 1\n            if counter < 0:\n                raise UnbalancedParenthesesError(group, \"Found closing parenthesis without matching opening\")\n        # According to design, _is_group_valid should filter other chars, but defensive check remains.\n        else:\n            raise InvalidGroupError(group, \"Unexpected character found in group\")\n    \n    if counter != 0:\n        raise UnbalancedParenthesesError(group, \"Unbalanced parentheses: remaining count != 0\")\n    return max_depth\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    if not paren_string.strip():\n        return []\n\n    groups = paren_string.split()\n    depths = []\n    for group in groups:\n        if not _is_group_valid(group):\n            raise InvalidGroupError(group)\n        depths.append(_compute_depth(group))\n    return depths"}
{"task_id": "HumanEval/2", "solution": "import math\n\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    integer_part = math.floor(number)\n    decimal_part = number - integer_part\n    return decimal_part"}
{"task_id": "HumanEval/7", "solution": "def filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    if not substring:\n        return list(strings)  # Return a copy of the original list if substring is empty\n\n    return [s for s in strings if substring in s]"}
{"task_id": "HumanEval/0", "solution": "from typing import List\n\n\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    if len(numbers) < 2:\n        return False\n\n    sorted_numbers = sorted(numbers)\n\n    for i in range(1, len(sorted_numbers)):\n        if abs(sorted_numbers[i] - sorted_numbers[i - 1]) < threshold:\n            return True\n            \n    return False"}
{"task_id": "HumanEval/12", "solution": "def longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    \"\"\"\n    if not strings:\n        return None\n    \n    max_len = -1\n    result = None\n    \n    for s in strings:\n        if len(s) > max_len:\n            max_len = len(s)\n            result = s\n            \n    return result"}
{"task_id": "HumanEval/9", "solution": "def rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    result: List[int] = []\n    current_max = None\n    for n in numbers:\n        if current_max is None or n > current_max:\n            current_max = n\n        result.append(current_max)\n    return result"}
{"task_id": "HumanEval/8", "solution": "def sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    total_sum = 0\n    total_product = 1\n    for num in numbers:\n        total_sum += num\n        total_product *= num\n    return (total_sum, total_product)"}
{"task_id": "HumanEval/11", "solution": "from typing import List\n\n\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    max_len = max(len(a), len(b))\n\n    # Pad the shorter string with '0's on the left to match the max length.\n    padded_a = a.zfill(max_len)\n    padded_b = b.zfill(max_len)\n\n    result_bits = []\n    for i in range(max_len):\n        bit_a = padded_a[i]\n        bit_b = padded_b[i]\n        # Perform XOR for individual bits based on inequality.\n        if bit_a != bit_b:\n            result_bits.append('1')\n        else:\n            result_bits.append('0')\n\n    return \"\".join(result_bits)"}
