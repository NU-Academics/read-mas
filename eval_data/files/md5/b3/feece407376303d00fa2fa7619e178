{"task_id": "HumanEval/26", "solution": "from typing import List\n\n\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    >>> remove_duplicates([1, 2, 3, 2, 4])\n    [1, 3, 4]\n    \"\"\"\n    counts = {}\n    for num in numbers:\n        counts[num] = counts.get(num, 0) + 1\n\n    result = []\n    for num in numbers:\n        if counts[num] == 1:\n            result.append(num)\n\n    return result"}
{"task_id": "HumanEval/25", "solution": "from typing import List\n\n\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    factors = []\n\n    # Handle factor 2\n    while n % 2 == 0:\n        factors.append(2)\n        n //= 2\n\n    # Handle odd factors\n    d = 3\n    while d * d <= n:\n        while n % d == 0:\n            factors.append(d)\n            n //= d\n        d += 2\n\n    # If n is still greater than 1, it must be a prime factor itself\n    if n > 1:\n        factors.append(n)\n\n    return factors"}
{"task_id": "HumanEval/24", "solution": "import math\n\ndef largest_divisor(n: int) -> int:\n    \"\"\" For a given number n, find the largest number that divides n evenly, smaller than n\n    >>> largest_divisor(15)\n    5\n    \"\"\"\n    largest = 1\n    # Iterate from 2 up to the square root of n\n    # Any divisor greater than sqrt(n) will have a corresponding divisor smaller than sqrt(n)\n    # The largest proper divisor will either be a factor less than or equal to sqrt(n)\n    # or the complement (n // factor) of a factor less than or equal to sqrt(n).\n    \n    root = int(math.isqrt(n))\n    for i in range(2, root + 1):\n        if n % i == 0:\n            # i is a divisor\n            # n // i is its complement divisor\n            \n            # The complement n // i will be the larger divisor if i is small.\n            # We are looking for the largest proper divisor, which is n // smallest_prime_factor.\n            # As we iterate i, n // i will be a potential candidate.\n            complement = n // i\n            if complement > largest:\n                largest = complement\n            \n            # i itself might be the largest divisor in some cases (e.g., if n is a perfect square and i=sqrt(n)).\n            # Or if n is prime, this loop won't find any divisors, and largest remains 1.\n            if i > largest:\n                largest = i\n    \n    # If no divisors were found (n is prime), largest remains 1.\n    return largest"}
{"task_id": "HumanEval/27", "solution": "def flip_case(string: str) -> str:\n    \"\"\" For a given string, flip lowercase characters to uppercase and uppercase to lowercase.\n    >>> flip_case('Hello')\n    'hELLO'\n    \"\"\"\n    flipped_chars = []\n    for char in string:\n        if char.isalpha():\n            if char.islower():\n                flipped_chars.append(char.upper())\n            else:\n                flipped_chars.append(char.lower())\n        else:\n            flipped_chars.append(char)\n    return \"\".join(flipped_chars)"}
{"task_id": "HumanEval/30", "solution": "import warnings\nfrom typing import list\n\ndef get_positive(l: list):\n    \"\"\"Return only positive numbers in the list.\n    >>> get_positive([-1, 2, -4, 5, 6])\n    [2, 5, 6]\n    >>> get_positive([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    [5, 3, 2, 3, 9, 123, 1]\n    \"\"\"\n    return [n for n in l if isinstance(n, (int, float)) and n > 0]"}
{"task_id": "HumanEval/29", "solution": "from typing import List\n\n\ndef filter_by_prefix(strings: List[str], prefix: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that start with a given prefix.\n    >>> filter_by_prefix([], 'a')\n    []\n    >>> filter_by_prefix(['abc', 'bcd', 'cde', 'array'], 'a')\n    ['abc', 'array']\n    \"\"\"\n    return [s for s in strings if s.startswith(prefix)]"}
{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    \"\"\"\n\n    if n < 2:\n        return False\n    if n == 2 or n == 3:\n        return True\n    if n % 2 == 0:\n        return False\n\n    TRIAL_DIVISION_LIMIT = 1_000_000\n\n    if n <= TRIAL_DIVISION_LIMIT:\n        # Trial division algorithm for smaller numbers.\n        r = int(n**0.5)\n        for p in range(3, r + 1, 2):\n            if n % p == 0:\n                return False\n        return True\n    else:\n        # Miller-Rabin algorithm for larger numbers using deterministic bases.\n        MR_DETERMINISTIC_BASES_64 = [2, 325, 9375, 28178, 450775, 9780504, 1795265022]\n\n        # Helper function for a single round of Miller-Rabin test.\n        def _miller_rabin_test_round(round_a, d, s, n_val):\n            x = pow(round_a, d, n_val)\n            if x == 1 or x == n_val - 1:\n                return True\n            for _ in range(s - 1):\n                x = pow(x, 2, n_val)\n                if x == n_val - 1:\n                    return True\n            return False\n\n        # Find s and d such that n - 1 = d * 2^s where d is odd.\n        d = n - 1\n        s = 0\n        while d % 2 == 0:\n            d //= 2\n            s += 1\n\n        for a in MR_DETERMINISTIC_BASES_64:\n            if not _miller_rabin_test_round(a, d, s, n):\n                return False\n\n        return True"}
{"task_id": "HumanEval/35", "solution": "import collections.abc\n\nclass MaxNotFoundError(ValueError):\n    \"\"\"Raised when max_element() is called with an empty list.\"\"\"\n    pass\n\ndef max_element(l: list):\n    \"\"\"Return maximum element in the list.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    if not isinstance(l, collections.abc.Sequence):\n        raise TypeError(\"Argument must be a sequence.\")\n    if len(l) == 0:\n        raise MaxNotFoundError(\"max_element() arg is an empty list\")\n    max_val = l[0]\n    for item in l[1:]:\n        if item > max_val:\n            max_val = item\n    return max_val"}
