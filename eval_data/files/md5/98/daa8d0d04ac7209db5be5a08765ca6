{"task_id": "HumanEval/27", "solution": "def flip_case(string: str) -> str:\n    \"\"\" For a given string, flip lowercase characters to uppercase and uppercase to lowercase.\n    >>> flip_case('Hello')\n    'hELLO'\n    \"\"\"\n    flipped_chars = []\n    for char in string:\n        if char.islower():\n            flipped_chars.append(char.upper())\n        elif char.isupper():\n            flipped_chars.append(char.lower())\n        else:\n            flipped_chars.append(char)\n    return \"\".join(flipped_chars)"}
{"task_id": "HumanEval/19", "solution": "from typing import List, Dict\nclass InvalidNumberWordError(ValueError):\n    \"\"\"Exception raised for an unrecognized number word.\"\"\"\n    def __init__(self, word: str):\n        self.word = word\n        super().__init__(f\"'{word}' is not a valid number word (zero-nine).\")\nclass NumberWordMap:\n    \"\"\"Manages bidirectional mapping between number words and integers.\"\"\"\n    _WORD_TO_INT_MAP: Dict[str, int] = {\n        'zero': 0, 'one': 1, 'two': 2, 'three': 3, 'four': 4,\n        'five': 5, 'six': 6, 'seven': 7, 'eight': 8, 'nine': 9\n    }\n\n    _INT_TO_WORD_MAP: Dict[int, str] = {\n        0: 'zero', 1: 'one', 2: 'two', 3: 'three', 4: 'four',\n        5: 'five', 6: 'six', 7: 'seven', 8: 'eight', 9: 'nine'\n    }\n\n    def get_int(self, word: str) -> int:\n        \"\"\"Converts a number word string to its integer equivalent.\"\"\"\n        lower_word = word.lower()\n        if lower_word not in self._WORD_TO_INT_MAP:\n            raise InvalidNumberWordError(word)\n        return self._WORD_TO_INT_MAP[lower_word]\n\n    def get_word(self, num: int) -> str:\n        \"\"\"Converts an integer to its number word string equivalent.\"\"\"\n        if num not in self._INT_TO_WORD_MAP:\n            raise ValueError(f\"'{num}' is not a valid integer (0-9).\")\n        return self._INT_TO_WORD_MAP[num]\nclass NumberSortingService:\n    \"\"\"Provides the core business logic for sorting number words.\"\"\"\n    def __init__(self, mapper: NumberWordMap):\n        self._mapper = mapper\n\n    def sort_numbers(self, numbers_str: str) -> str:\n        \"\"\"Sorts space-delimited number words from smallest to largest.\"\"\"\n        # The design explicitly includes this check in src/services.py\n        if not isinstance(numbers_str, str):\n            raise TypeError(\"Input must be a string.\")\n\n        words: List[str] = numbers_str.split()\n\n        try:\n            integers: List[int] = [self._mapper.get_int(word) for word in words]\n        except InvalidNumberWordError as e:\n            raise e # Re-raise the specific error for clarity\n\n        integers.sort()\n\n        sorted_words: List[str] = [self._mapper.get_word(num) for num in integers]\n\n        return ' '.join(sorted_words)\n_number_word_map = NumberWordMap()\n_number_sorting_service = NumberSortingService(mapper=_number_word_map)\ndef sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Valid choices are 'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight' and 'nine'.\n    Return the string with numbers sorted from smallest to largest\n    >>> sort_numbers('three one five')\n    'one three five'\n    \"\"\"\n    return _number_sorting_service.sort_numbers(numbers)"}
{"task_id": "HumanEval/29", "solution": "def filter_by_prefix(strings: List[str], prefix: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that start with a given prefix.\n    >>> filter_by_prefix([], 'a')\n    []\n    >>> filter_by_prefix(['abc', 'bcd', 'cde', 'array'], 'a')\n    ['abc', 'array']\n    \"\"\"\n    return [s for s in strings if s.startswith(prefix)]"}
{"task_id": "HumanEval/30", "solution": "def get_positive(l: list):\n    \"\"\"Return only positive numbers in the list.\"\"\"\n    return [num for num in l if num > 0]"}
{"task_id": "HumanEval/25", "solution": "def factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    factors = []\n    divisor = 2\n\n    while n > 1:\n        if n % divisor == 0:\n            factors.append(divisor)\n            n //= divisor\n        else:\n            divisor += 1\n    return factors"}
{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n\n    # Check for divisors from 3 up to sqrt(n)\n    import math\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        if n % i == 0:\n            return False\n    return True"}
{"task_id": "HumanEval/35", "solution": "def max_element(l: list):\n    \"\"\"Return maximum element in the list.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    if not l:\n        raise ValueError(\"Input list cannot be empty.\")\n    \n    max_val = l[0]\n    \n    for element in l[1:]:\n        if element > max_val:\n            max_val = element\n    return max_val"}
{"task_id": "HumanEval/34", "solution": "def unique(l: list):\n    \"\"\"Return sorted unique elements in a list.\"\"\"\n    return sorted(list(set(l)))"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    if not l:\n        return []\n\n    # Collect elements at indices divisible by three and their original indices\n    divisible_elements = []\n    divisible_indices = []\n    for i, x in enumerate(l):\n        if i % 3 == 0:\n            divisible_elements.append(x)\n            divisible_indices.append(i)\n    \n    # Sort the collected elements\n    divisible_elements.sort()\n    \n    # Create a copy of the original list to modify\n    result_list = list(l)\n    \n    # Place the sorted elements back into the result list at their original indices\n    for i, original_index in enumerate(divisible_indices):\n        result_list[original_index] = divisible_elements[i]\n        \n    return result_list"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    decoded_groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(decoded_groups)"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    if not l:\n        return []\n\n    even_elements = [l[i] for i in range(0, len(l), 2)]\n    even_elements.sort()\n\n    result = list(l)\n    even_idx_ptr = 0\n    for i in range(0, len(result), 2):\n        result[i] = even_elements[even_idx_ptr]\n        even_idx_ptr += 1\n    \n    return result"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    total_sevens_count = 0\n\n    for i in range(1, n):\n        if (i % 11 == 0) or (i % 13 == 0):\n            # Count occurrences of the digit '7' in the current number.\n            current_num_str = str(i)\n            sevens_in_current_num = 0\n            for char_digit in current_num_str:\n                if char_digit == '7':\n                    sevens_in_current_num += 1\n            total_sevens_count += sevens_in_current_num\n            \n    return total_sevens_count"}
