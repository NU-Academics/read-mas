{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    \"\"\"\n    def _is_increasing(l: list) -> bool:\n        \"\"\"Checks if the list is monotonically increasing (non-decreasing).\"\"\"\n        if len(l) <= 1:\n            return True\n        for i in range(len(l) - 1):\n            if l[i] > l[i+1]:\n                return False\n        return True\n\n    def _is_decreasing(l: list) -> bool:\n        \"\"\"Checks if the list is monotonically decreasing (non-increasing).\"\"\"\n        if len(l) <= 1:\n            return True\n        for i in range(len(l) - 1):\n            if l[i] < l[i+1]:\n                return False\n        return True\n\n    return _is_increasing(l) or _is_decreasing(l)"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\n     Return derivative of this polynomial in the same form.\n    \"\"\"\n    if not xs:\n        return []\n\n    derivative_coeffs = []\n    for i in range(1, len(xs)):\n        derivative_coeffs.append(i * xs[i])\n\n    return derivative_coeffs"}
{"task_id": "HumanEval/60", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\nclass SumCalculator:\n    \"\"\"Calculates the sum of integers from 1 to n.\"\"\"\n    def calculate(self, n: int) -> int:\n        \"\"\"Calculates the sum of integers from 1 to n using the formula n * (n + 1) / 2.\"\"\"\n        return n * (n + 1) // 2\nclass CalculatorService:\n    \"\"\"Provides business logic for sum calculation, including input validation.\"\"\"\n    def __init__(self, sum_calculator: SumCalculator):\n        self._sum_calculator = sum_calculator\n\n    def get_sum_to_n(self, n: int) -> int:\n        \"\"\"Validates the input n and calculates the sum of integers from 1 to n.\"\"\"\n        if not isinstance(n, int) or n <= 0:\n            raise InvalidInputError(\"Input 'n' must be a positive integer.\")\n        return self._sum_calculator.calculate(n)\n_sum_calculator_instance = SumCalculator()\n_calculator_service_instance = CalculatorService(sum_calculator=_sum_calculator_instance)\ndef sum_to_n(n: int):\n    \"\"\"sum_to_n is a function that sums numbers from 1 to n.\n    >>> sum_to_n(30)\n    465\n    >>> sum_to_n(100)\n    5050\n    >>> sum_to_n(5)\n    15\n    >>> sum_to_n(10)\n    55\n    >>> sum_to_n(1)\n    1\n    \"\"\"\n    try:\n        return _calculator_service_instance.get_sum_to_n(n)\n    except InvalidInputError as e:\n        raise e"}
{"task_id": "HumanEval/63", "solution": "def fibfib(n: int):\n    \"\"\"The FibFib number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fibfib(0) == 0\n    fibfib(1) == 0\n    fibfib(2) == 1\n    fibfib(n) == fibfib(n-1) + fibfib(n-2) + fibfib(n-3).\n    Please write a function to efficiently compute the n-th element of the fibfib number sequence.\n    >>> fibfib(1)\n    0\n    >>> fibfib(5)\n    4\n    >>> fibfib(8)\n    24\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 1\n\n    # Initialize the first three values (f0, f1, f2)\n    # corresponding to fibfib(0), fibfib(1), fibfib(2)\n    f0, f1, f2 = 0, 0, 1\n\n    # Iterate from 3 up to n to compute the sequence iteratively.\n    for _ in range(3, n + 1):\n        next_fib = f0 + f1 + f2\n        f0 = f1\n        f1 = f2\n        f2 = next_fib\n    \n    return f2"}
