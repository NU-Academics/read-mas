{"task_id": "HumanEval/41", "solution": "def car_race_collision(n: int):\n    \"\"\"\n    Imagine a road that's a perfectly straight infinitely long line.\n    n cars are driving left to right;  simultaneously, a different set of n cars\n    are driving right to left.   All cars move in the same speed.  Two cars are said to collide\n    when a car that's moving left to right hits a car that's moving right to left.\n    However, the cars are infinitely sturdy and strong; as a result, they continue moving\n    in their trajectory as if they did not collide.\n\n    This function outputs the number of such collisions.\n    \"\"\"\n    # Each of the 'n' cars moving left-to-right will collide with each of the 'n' cars\n    # moving right-to-left.\n    return n * n"}
{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n\n    class PrimeChecker:\n        \"\"\"Determines if a given integer is a prime number.\"\"\"\n        def is_prime(self, num: int) -> bool:\n            if num <= 1:\n                return False\n            if num == 2:\n                return True\n            if num % 2 == 0:\n                return False\n            i = 3\n            while i * i <= num:\n                if num % i == 0:\n                    return False\n                i += 2\n            return True\n\n    class FibonacciGenerator:\n        \"\"\"Generates Fibonacci numbers sequentially.\"\"\"\n        def __init__(self):\n            self.a = 0\n            self.b = 1\n\n        def next(self) -> int:\n            current_fib = self.a\n            self.a, self.b = self.b, self.a + self.b\n            return current_fib\n\n        def reset(self) -> None:\n            self.a = 0\n            self.b = 1\n\n    class PrimeFibCalculator:\n        \"\"\"Orchestrates finding the n-th prime Fibonacci number.\"\"\"\n        def __init__(self):\n            self.fib_generator = FibonacciGenerator()\n            self.prime_checker = PrimeChecker()\n\n        def prime_fib(self, n: int) -> int:\n            if n < 1:\n                raise ValueError(\"Input 'n' must be a positive integer.\")\n\n            self.fib_generator.reset()\n            prime_count = 0\n            \n            while True:\n                fib_val = self.fib_generator.next()\n                \n                # 0 and 1 are not considered prime numbers.\n                if fib_val <= 1:\n                    continue\n\n                if self.prime_checker.is_prime(fib_val):\n                    prime_count += 1\n                    if prime_count == n:\n                        return fib_val\n\n    calculator = PrimeFibCalculator()\n    return calculator.prime_fib(n)"}
{"task_id": "HumanEval/32", "solution": "class ConvergenceError(Exception):\n    \"\"\"Exception raised when a numerical method fails to converge within specified iterations.\"\"\"\n    pass\nclass InvalidPolynomialError(ValueError):\n    \"\"\"Exception raised for polynomials that do not meet specific criteria for root finding.\"\"\"\n    pass\ndef _get_derivative_coefficients(coeffs: list) -> list:\n    \"\"\"Calculates coefficients of the derivative of a polynomial P(x).\"\"\"\n    if not coeffs or len(coeffs) == 1:  # P(x) = C (constant polynomial)\n        return [0.0]  # P'(x) = 0\n\n    derivative_coeffs = []\n    for i in range(1, len(coeffs)):  # P'(x) = a_1 + 2*a_2*x + ... + n*a_n*x^(n-1)\n        derivative_coeffs.append(coeffs[i] * i)\n    return derivative_coeffs\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    DEFAULT_TOLERANCE: float = 1e-6\n    MAX_ITERATIONS: int = 100\n    DEFAULT_INITIAL_GUESS: float = 0.0\n\n    # Create a mutable copy and remove trailing zeros, mimicking Polynomial model behavior.\n    cleaned_xs = list(xs)\n    while len(cleaned_xs) > 1 and cleaned_xs[-1] == 0.0:\n        cleaned_xs.pop()\n\n    # Validate constraints as per design context.\n    if not cleaned_xs:\n        raise InvalidPolynomialError(\"Cannot find zero for an empty polynomial.\")\n\n    # \"even number of coefficients\" implies an odd-degree polynomial.\n    if len(cleaned_xs) % 2 != 0:\n        raise InvalidPolynomialError(\n            f\"Polynomial must have an even number of coefficients (odd degree) for find_zero. \"\n            f\"Received {len(cleaned_xs)} coefficients (degree {len(cleaned_xs)-1}).\"\n        )\n\n    # \"largest non zero coefficient\" means leading coefficient is not zero.\n    if cleaned_xs[-1] == 0.0:\n        raise InvalidPolynomialError(\"Leading coefficient cannot be zero after cleaning trailing zeros for find_zero.\")\n\n    # Implement Newton-Raphson method.\n    current_x = DEFAULT_INITIAL_GUESS\n    derivative_coeffs = _get_derivative_coefficients(cleaned_xs)\n\n    for _ in range(MAX_ITERATIONS):\n        # 'poly' function is available from the context.\n        f_x = poly(cleaned_xs, current_x)\n        f_prime_x = poly(derivative_coeffs, current_x)\n\n        if abs(f_x) < DEFAULT_TOLERANCE:\n            return current_x\n\n        # Handle cases where derivative is zero or too close to zero.\n        if abs(f_prime_x) < 1e-10:\n            raise ConvergenceError(\"Newton-Raphson: Derivative is too close to zero, cannot converge.\")\n\n        current_x = current_x - (f_x / f_prime_x)\n\n    raise ConvergenceError(f\"Newton-Raphson: Failed to converge after {MAX_ITERATIONS} iterations.\")"}
{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    Checks if there are two distinct elements in the list that sum to zero.\n    Uses a set to track seen numbers for efficient lookup.\n    \"\"\"\n    seen_numbers = set()\n    for number in l:\n        complement = -number\n        if complement in seen_numbers:\n            return True\n        seen_numbers.add(number)\n    return False"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    # Create a sorted copy of the list to apply the two-pointer technique efficiently.\n    nums = sorted(l)\n\n    for i in range(n - 2):\n        # Skip duplicate elements for the first number to avoid redundant checks.\n        if i > 0 and nums[i] == nums[i-1]:\n            continue\n\n        left, right = i + 1, n - 1\n        while left < right:\n            current_sum = nums[i] + nums[left] + nums[right]\n\n            if current_sum == 0:\n                return True\n            elif current_sum < 0:\n                left += 1\n            else:\n                right -= 1\n    return False"}
