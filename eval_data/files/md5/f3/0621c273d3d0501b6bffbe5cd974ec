{"task_id": "HumanEval/44", "solution": "```python\ndef change_base(x: int, base: int) -> str:\n    \"\"\"Converts a decimal integer x to a string representation in the specified base.\n    The base must be between 2 and 9, inclusive, using the repeated division algorithm.\n    \"\"\"\n    if not (2 <= base <= 9):\n        raise ValueError(\"Base must be an integer between 2 and 9, inclusive.\")\n\n    if x == 0:\n        return '0'\n\n    is_negative = False\n    if x < 0:\n        is_negative = True\n        x = abs(x)\n\n    # Collect digits in reverse order using repeated division\n    digits = []\n    while x > 0:\n        remainder = x % base\n        digits.append(str(remainder))\n        x //= base\n\n    # Reverse the collected digits and join them to form the result string\n    converted_str = \"\".join(digits[::-1])\n\n    if is_negative:\n        return '-' + converted_str\n    else:\n        return converted_str\n```"}
{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    >>> pairs_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> pairs_sum_to_zero([1, 3, -2, 1])\n    False\n    >>> pairs_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> pairs_sum_to_zero([2, 4, -5, 3, 5, 7])\n    True\n    >>> pairs_sum_to_zero([1])\n    False\n    \"\"\"\n    if len(l) <= 1:\n        return False\n\n    seen_numbers = set()\n    for num in l:\n        complement = -num\n        if complement in seen_numbers:\n            return True\n        seen_numbers.add(num)\n\n    return False"}
{"task_id": "HumanEval/46", "solution": "```python\ndef fib4(n: int) -> int:\n    \"\"\"Computes the n-th element of the Fib4 number sequence using an iterative approach.\n    It defines fib4(0)=0, fib4(1)=0, fib4(2)=2, fib4(3)=0, and fib4(n)=fib4(n-1)+fib4(n-2)+fib4(n-3)+fib4(n-4) for n > 3.\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 0\n\n    # Initialize the four most recent Fib4 values: fib4(k-1), fib4(k-2), fib4(k-3), fib4(k-4).\n    # These correspond to fib4(3), fib4(2), fib4(1), fib4(0) respectively for the first iteration (k=4).\n    f_n_minus_1, f_n_minus_2, f_n_minus_3, f_n_minus_4 = 0, 2, 0, 0\n\n    # Iterate from the 4th element up to n.\n    for _ in range(4, n + 1):\n        current_fib = f_n_minus_1 + f_n_minus_2 + f_n_minus_3 + f_n_minus_4\n        # Shift values for the next iteration.\n        f_n_minus_4 = f_n_minus_3\n        f_n_minus_3 = f_n_minus_2\n        f_n_minus_2 = f_n_minus_1\n        f_n_minus_1 = current_fib\n\n    return f_n_minus_1\n```"}
{"task_id": "HumanEval/46", "solution": "```python\ndef fib4(n: int):\n    \"\"\"Computes the n-th element of the Fib4 number sequence iteratively.\n    Uses O(n) time and O(1) space complexity.\"\"\"\n\n    # Handle the defined base cases directly.\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 0\n\n    # For n >= 4, initialize the four previous values needed for the recurrence.\n    # These correspond to fib4(0), fib4(1), fib4(2), fib4(3).\n    prev4 = 0\n    prev3 = 0\n    prev2 = 2\n    prev1 = 0\n\n    # Iterate from 4 up to n to compute the sequence iteratively.\n    for _ in range(4, n + 1):\n        current_fib4 = prev1 + prev2 + prev3 + prev4\n\n        # Shift the values to prepare for the next iteration.\n        prev4 = prev3\n        prev3 = prev2\n        prev2 = prev1\n        prev1 = current_fib4\n\n    return prev1\n```"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    if n % 2 == 1:\n        # Odd length: return middle element\n        return sorted_l[n // 2]\n    else:\n        # Even length: return average of two middle elements\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        return (mid1 + mid2) / 2.0"}
{"task_id": "HumanEval/48", "solution": "def _normalize_string(text: str) -> str:\n    \"\"\"\n    Normalize string for palindrome comparison.\n    This converts the string to lowercase to handle case insensitivity.\n    \"\"\"\n    return text.lower()\n\ndef _is_palindrome_recursive(text: str) -> bool:\n    \"\"\"\n    Check if normalized string is a palindrome using recursive comparison.\n    Compares outer characters and recursively checks the inner substring.\n    \"\"\"\n    if len(text) <= 1:\n        return True\n    if text[0] != text[-1]:\n        return False\n    return _is_palindrome_recursive(text[1:-1])\n\ndef is_palindrome(text: str) -> bool:\n    \"\"\"\n    Checks if a given string is a palindrome.\n    An empty string is considered a palindrome.\n    \"\"\"\n    if not text:\n        return True\n    normalized_text = _normalize_string(text)\n    return _is_palindrome_recursive(normalized_text)"}
{"task_id": "HumanEval/48", "solution": "```python\nimport re\n\ndef _remove_non_alphanumeric(text: str) -> str:\n    \"\"\"Removes non-alphanumeric characters from the string.\n    This includes whitespace and punctuation.\n    \"\"\"\n    return re.sub(r'[^a-zA-Z0-9]', '', text)\n\ndef _to_lowercase(text: str) -> str:\n    \"\"\"Converts the input string to its lowercase representation.\"\"\"\n    return text.lower()\n\ndef _normalize_text(text: str) -> str:\n    \"\"\"Normalizes text by stripping non-alphanumeric characters and converting to lowercase.\"\"\"\n    cleaned_text = _remove_non_alphanumeric(text)\n    return _to_lowercase(cleaned_text)\n\ndef _is_empty_or_single(text: str) -> bool:\n    \"\"\"Checks if the string is empty or contains only one character.\"\"\"\n    return len(text) <= 1\n\ndef is_palindrome(text: str) -> bool:\n    \"\"\"\n    Checks if a given string is a palindrome, ignoring case, whitespace, and punctuation.\n    Handles empty strings and single characters as palindromes.\n    \"\"\"\n    # Edge Case Handler: checks original string length\n    if _is_empty_or_single(text):\n        return True\n\n    # Text Normalizer: processes the input string\n    normalized_text = _normalize_text(text)\n\n    # Handles cases where normalization results in an empty or single character string.\n    if _is_empty_or_single(normalized_text):\n        return True\n\n    # Palindrome Validator: compares the normalized string with its reverse\n    return normalized_text == normalized_text[::-1]\n```"}
{"task_id": "HumanEval/47", "solution": "def _sort_list(l: list) -> list:\n    \"\"\"Returns a new list containing all items from the input list in ascending order.\n    The original list remains unchanged.\n    \"\"\"\n    return sorted(l)\n\ndef _get_middle_element(sorted_list: list):\n    \"\"\"Retrieves the middle element from a sorted list of odd length.\n    This element is the median for odd-length lists.\n    \"\"\"\n    return sorted_list[len(sorted_list) // 2]\n\ndef _get_average_middle(sorted_list: list) -> float:\n    \"\"\"Calculates the average of the two middle elements from a sorted list of even length.\n    This average represents the median for even-length lists.\n    \"\"\"\n    mid_idx_1 = len(sorted_list) // 2 - 1\n    mid_idx_2 = len(sorted_list) // 2\n    return (sorted_list[mid_idx_1] + sorted_list[mid_idx_2]) / 2\n\ndef median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    sorted_l = _sort_list(l)\n    n = len(sorted_l)\n\n    if n % 2 == 1:\n        return _get_middle_element(sorted_l)\n    else:\n        return _get_average_middle(sorted_l)"}
{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int):\n    \"\"\"Return 2^n modulo p (be aware of numerics).\n    >>> modp(3, 5)\n    3\n    >>> modp(1101, 101)\n    2\n    >>> modp(0, 101)\n    1\n    >>> modp(3, 11)\n    8\n    >>> modp(100, 101)\n    1\n    \"\"\"\n    # Handle edge case where n = 0\n    if n == 0:\n        return 1\n\n    # Use binary exponentiation to compute 2^n mod p efficiently\n    result = 1\n    base = 2 % p\n    exponent = n\n\n    while exponent > 0:\n        # If exponent is odd, multiply result with current base\n        if exponent % 2 == 1:\n            result = (result * base) % p\n\n        # Square the base and halve the exponent\n        base = (base * base) % p\n        exponent //= 2\n\n    return result"}
{"task_id": "HumanEval/49", "solution": "```python\ndef modp(n: int, p: int):\n    \"\"\"Return 2^n modulo p (be aware of numerics).\n    >>> modp(3, 5)\n    3\n    >>> modp(1101, 101)\n    2\n    >>> modp(0, 101)\n    1\n    >>> modp(3, 11)\n    8\n    >>> modp(100, 101)\n    1\n    \"\"\"\n    # Handle edge case n = 0\n    if n == 0:\n        return 1\n\n    # Use built-in pow function with three arguments for efficient modular exponentiation\n    # pow(base, exp, mod) computes (base^exp) % mod efficiently\n    return pow(2, n, p)\n```"}
