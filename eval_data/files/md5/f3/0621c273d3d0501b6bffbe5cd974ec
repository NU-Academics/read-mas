{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\"\"\"\n\n    def is_divisible_by_11(number: int) -> bool:\n        \"\"\"Checks if a number is divisible by 11 using the modulo operator.\"\"\"\n        return number % 11 == 0\n\n    def is_divisible_by_13(number: int) -> bool:\n        \"\"\"Checks if a number is divisible by 13 using the modulo operator.\"\"\"\n        return number % 13 == 0\n\n    def count_digit_seven(number: int) -> int:\n        \"\"\"Counts occurrences of the digit '7' in a number by converting it to a string.\"\"\"\n        return str(number).count('7')\n\n    divisible_numbers = set()\n    for i in range(1, n):\n        if is_divisible_by_11(i) or is_divisible_by_13(i):\n            divisible_numbers.add(i)\n\n    total_sevens_count = 0\n    for number in divisible_numbers:\n        total_sevens_count += count_digit_seven(number)\n\n    return total_sevens_count"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    if not l:\n        return []\n\n    # Extract values at even indices\n    even_values = [l[i] for i in range(0, len(l), 2)]\n\n    # Sort the even-indexed values\n    sorted_even = sorted(even_values)\n\n    # Create result list\n    result = []\n    even_idx = 0\n\n    for i in range(len(l)):\n        if i % 2 == 0:  # Even index\n            result.append(sorted_even[even_idx])\n            even_idx += 1\n        else:  # Odd index\n            result.append(l[i])\n\n    return result"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    \"\"\"\n    if not l:\n        return []\n\n    even_values = []\n    result = [None] * len(l)\n\n    for i in range(len(l)):\n        if i % 2 == 0:\n            even_values.append(l[i])\n        else:\n            result[i] = l[i]\n\n    sorted_even_values = sorted(even_values)\n\n    even_idx_counter = 0\n    for i in range(len(l)):\n        if i % 2 == 0:\n            result[i] = sorted_even_values[even_idx_counter]\n            even_idx_counter += 1\n\n    return result"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # reverse cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/38", "solution": "```python\ndef decode_cyclic(s: str) -> str:\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # Split string into groups of 3 characters.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n\n    # For each group, reverse the cyclic shift if it has 3 characters, otherwise leave it as is.\n    decoded_groups = []\n    for group in groups:\n        if len(group) == 3:\n            decoded_groups.append(group[2] + group[0] + group[1])\n        else:\n            decoded_groups.append(group)\n\n    # Join all processed groups back into a single decoded string.\n    return \"\".join(decoded_groups)\n```"}
{"task_id": "HumanEval/39", "solution": "```python\ndef prime_fib(n: int):\n    \"\"\"\n    Main entry point for finding nth prime Fibonacci number.\n    Returns the n-th Fibonacci number that is also prime.\n    \"\"\"\n\n    def _validate_input(n: int) -> bool:\n        \"\"\"\n        Validates input parameter.\n        As per critical requirements, input is trusted to be a positive integer.\n        \"\"\"\n        # Critical requirements forbid isinstance checks, type guards, or raising exceptions.\n        # Therefore, this function assumes n is a valid positive integer.\n        return True\n\n    def _generate_fibonacci():\n        \"\"\"\n        Generator function for the Fibonacci sequence.\n        Yields Fibonacci numbers starting from 0, 1, 1, 2, 3, 5...\n        \"\"\"\n        a, b = 0, 1\n        while True:\n            yield a\n            a, b = b, a + b\n\n    def _is_prime(num: int) -> bool:\n        \"\"\"\n        Tests if a number is prime using trial division.\n        Handles numbers less than 2 as non-prime efficiently.\n        \"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    _validate_input(n)\n\n    prime_count = 0\n    fib_gen = _generate_fibonacci()\n\n    for fib_num in fib_gen:\n        if _is_prime(fib_num):\n            prime_count += 1\n            if prime_count == n:\n                return fib_num\n```"}
{"task_id": "HumanEval/39", "solution": "```python\nimport math\n\ndef validate_positive_integer(n: int) -> bool:\n    \"\"\"Validates if n is a positive integer.\"\"\"\n    return n > 0\n\ndef is_prime(number: int) -> bool:\n    \"\"\"Checks if a number is prime. Optimizes by checking divisors up to its square root.\"\"\"\n    if number <= 1:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n    for i in range(3, int(math.sqrt(number)) + 1, 2):\n        if number % i == 0:\n            return False\n    return True\n\ndef get_next_fibonacci(a: int, b: int) -> tuple[int, int]:\n    \"\"\"Computes the next pair in the Fibonacci sequence.\"\"\"\n    return b, a + b\n\ndef generate_fibonacci():\n    \"\"\"Generates an infinite sequence of Fibonacci numbers: 0, 1, 1, 2, 3...\"\"\"\n    a, b = 0, 1\n    yield a\n    while True:\n        yield b\n        a, b = get_next_fibonacci(a, b)\n\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    # Input validation is performed as per design, trusting the caller's input based on requirements.\n    validate_positive_integer(n)\n\n    prime_count = 0\n    fib_gen = generate_fibonacci()\n\n    while True:\n        fib_num = next(fib_gen)\n        if is_prime(fib_num):\n            prime_count += 1\n            if prime_count == n:\n                return fib_num\n```"}
