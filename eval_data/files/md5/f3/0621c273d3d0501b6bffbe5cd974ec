{"task_id": "HumanEval/139", "solution": "```python\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    def factorial(num):\n        \"\"\"Helper function to compute standard factorial.\"\"\"\n        result = 1\n        for i in range(1, num + 1):\n            result *= i\n        return result\n\n    # Compute the Brazilian factorial\n    result = 1\n    for i in range(1, n + 1):\n        result *= factorial(i)\n\n    return result\n```"}
{"task_id": "HumanEval/139", "solution": "```python\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n    \"\"\"\n\n    def factorial(k):\n        \"\"\"Calculates the factorial of a non-negative integer k.\"\"\"\n        if k == 0 or k == 1:\n            return 1\n        res = 1\n        for i in range(2, k + 1):\n            res *= i\n        return res\n\n    overall_result = 1\n    for i in range(n, 0, -1):\n        overall_result *= factorial(i)\n\n    return overall_result\n```"}
{"task_id": "HumanEval/137", "solution": "```python\ndef compare_one(a, b):\n    def normalize_decimal_separator(value: str) -> str:\n        \"\"\"Convert comma decimal separator to dot.\"\"\"\n        return value.replace(',', '.')\n\n    def is_valid_number_string(value: str) -> bool:\n        \"\"\"Check if string represents a valid number using internal try-except.\"\"\"\n        try:\n            float(value)\n            return True\n        except ValueError:\n            return False\n\n    def convert_to_numeric(value) -> float:\n        \"\"\"Convert supported types to float for comparison.\"\"\"\n        if isinstance(value, str):\n            normalized_str = normalize_decimal_separator(value)\n            if is_valid_number_string(normalized_str):\n                return float(normalized_str)\n            else:\n                return float('nan')  # Return NaN for invalid number strings\n        elif isinstance(value, (int, float)):\n            return float(value)\n        else:\n            return float('nan')  # Return NaN for unsupported types\n\n    def perform_comparison(a_numeric: float, b_numeric: float, a_original, b_original):\n        \"\"\"Perform comparison and return result in original type.\"\"\"\n        # Check for NaN values, which cannot be meaningfully compared\n        if a_numeric != a_numeric or b_numeric != b_numeric:\n            return None  # Indicate incomparable values\n\n        if a_numeric > b_numeric:\n            return a_original\n        elif b_numeric > a_numeric:\n            return b_original\n        else:\n            return None  # Values are numerically equal\n\n    a_numeric = convert_to_numeric(a)\n    b_numeric = convert_to_numeric(b)\n\n    return perform_comparison(a_numeric, b_numeric, a, b)\n```"}
{"task_id": "HumanEval/140", "solution": "def fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores,\n    and if a string has more than 2 consecutive spaces,\n    then replace all consecutive spaces with -\n\n    fix_spaces(\"Example\") == \"Example\"\n    fix_spaces(\"Example 1\") == \"Example_1\"\n    fix_spaces(\" Example 2\") == \"_Example_2\"\n    fix_spaces(\" Example   3\") == \"_Example-3\"\n    \"\"\"\n    result_parts = []\n    i = 0\n    n = len(text)\n\n    while i < n:\n        if text[i] != ' ':\n            result_parts.append(text[i])\n            i += 1\n        else:\n            # Found a space, count consecutive spaces\n            space_count = 0\n            while i < n and text[i] == ' ':\n                space_count += 1\n                i += 1\n\n            # Apply replacement rules based on space_count\n            if space_count == 1:\n                result_parts.append('_')\n            elif space_count == 2:\n                result_parts.append('__')\n            else: # space_count > 2\n                result_parts.append('-')\n\n    return \"\".join(result_parts)"}
{"task_id": "HumanEval/140", "solution": "def fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores,\n    and if a string has more than 2 consecutive spaces,\n    then replace all consecutive spaces with -\n\n    fix_spaces(\"Example\") == \"Example\"\n    fix_spaces(\"Example 1\") == \"Example_1\"\n    fix_spaces(\" Example 2\") == \"_Example_2\"\n    fix_spaces(\" Example   3\") == \"_Example-3\"\n    \"\"\"\n    if not text:\n        return \"\"\n\n    result = []\n    i = 0\n\n    while i < len(text):\n        if text[i] == ' ':\n            # Count consecutive spaces\n            space_count = 0\n            start = i\n            while i < len(text) and text[i] == ' ':\n                space_count += 1\n                i += 1\n\n            # Apply replacement rule\n            if space_count > 2:\n                result.append('-')\n            else:\n                result.append('_' * space_count)\n        else:\n            result.append(text[i])\n            i += 1\n\n    return ''.join(result)"}
{"task_id": "HumanEval/141", "solution": "```python\ndef file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions\n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n    - The file's name contains exactly one dot '.'\n    - The substring before the dot should not be empty, and it starts with a letter from\n    the latin alphapet ('a'-'z' and 'A'-'Z').\n    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    \"\"\"\n    # Check if there are more than 3 digits\n    digit_count = 0\n    for char in file_name:\n        if char.isdigit():\n            digit_count += 1\n    if digit_count > 3:\n        return 'No'\n\n    # Check if there is exactly one dot\n    dot_count = file_name.count('.')\n    if dot_count != 1:\n        return 'No'\n\n    # Split the file name into prefix and extension\n    parts = file_name.split('.')\n    prefix = parts[0]\n    extension = parts[1]\n\n    # Check if prefix is not empty and starts with a latin letter\n    if not prefix or not (prefix[0].isalpha() and prefix[0].isascii()):\n        return 'No'\n\n    # Check if extension is one of the allowed extensions\n    allowed_extensions = ['txt', 'exe', 'dll']\n    if extension not in allowed_extensions:\n        return 'No'\n\n    return 'Yes'\n```"}
{"task_id": "HumanEval/141", "solution": "```python\ndef file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions\n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n    - The file's name contains exactly one dot '.'\n    - The substring before the dot should not be empty, and it starts with a letter from\n    the latin alphapet ('a'-'z' and 'A'-'Z').\n    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    Examples:\n    file_name_check(\"example.txt\") # => 'Yes'\n    file_name_check(\"1example.dll\") # => 'No' (the name should start with a latin alphapet letter)\n    \"\"\"\n    # Check if file name contains exactly one dot\n    if file_name.count('.') != 1:\n        return 'No'\n\n    # Split into prefix and extension\n    prefix, extension = file_name.split('.')\n\n    # Check if prefix is empty or doesn't start with a latin letter\n    if not prefix or not (('a' <= prefix[0] <= 'z') or ('A' <= prefix[0] <= 'Z')):\n        return 'No'\n\n    # Check if extension is valid\n    if extension not in ['txt', 'exe', 'dll']:\n        return 'No'\n\n    # Count digits in the entire file name\n    digit_count = sum(1 for char in file_name if '0' <= char <= '9')\n    if digit_count > 3:\n        return 'No'\n\n    return 'Yes'\n```"}
{"task_id": "HumanEval/142", "solution": "```python\ndef sum_squares(lst):\n    \"\"\"\n    This function processes a list of integers, applying transformations based on index.\n    It squares integers at multiples of 3, cubes at multiples of 4 (but not 3), and sums all processed values.\n    \"\"\"\n\n    def square(value: int) -> int:\n        \"\"\"Returns the square of the input value.\"\"\"\n        return value * value\n\n    def cube(value: int) -> int:\n        \"\"\"Returns the cube of the input value.\"\"\"\n        return value * value * value\n\n    def identity(value: int) -> int:\n        \"\"\"Returns the input value unchanged.\"\"\"\n        return value\n\n    def _is_multiple_of_3(index: int) -> bool:\n        \"\"\"Checks if the index is a multiple of 3.\"\"\"\n        return index % 3 == 0\n\n    def _is_multiple_of_4_not_3(index: int) -> bool:\n        \"\"\"Checks if the index is a multiple of 4 but not a multiple of 3.\"\"\"\n        return index % 4 == 0 and not _is_multiple_of_3(index)\n\n    def _process_element(value: int, index: int) -> int:\n        \"\"\"Applies transformation rules to an element based on its index.\"\"\"\n        if _is_multiple_of_3(index):\n            return square(value)\n        elif _is_multiple_of_4_not_3(index):\n            return cube(value)\n        else:\n            return identity(value)\n\n    if not lst:\n        return 0\n\n    total_sum = 0\n    for index, value in enumerate(lst):\n        processed_value = _process_element(value, index)\n        total_sum += processed_value\n\n    return total_sum\n```"}
{"task_id": "HumanEval/142", "solution": "```python\ndef sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a\n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not\n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries.\n\n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    if not lst:\n        return 0\n\n    total_sum = 0\n    for index, value in enumerate(lst):\n        if index % 3 == 0:\n            total_sum += value * value\n        elif index % 4 == 0:\n            total_sum += value * value * value\n        else:\n            total_sum += value\n\n    return total_sum\n```"}
{"task_id": "HumanEval/143", "solution": "```python\ndef words_in_sentence(sentence):\n    \"\"\"Filters words from a sentence whose lengths are prime numbers.\n    Returns filtered words in original order, space-separated.\"\"\"\n\n    def is_prime(n):\n        \"\"\"Checks if a number is prime.\"\"\"\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    if not sentence:\n        return \"\"\n\n    words = sentence.split()\n    filtered_words = []\n\n    for word in words:\n        if is_prime(len(word)):\n            filtered_words.append(word)\n\n    return \" \".join(filtered_words)\n```"}
{"task_id": "HumanEval/143", "solution": "```python\ndef is_prime(n):\n    \"\"\"Checks if a number is prime.\n    Iterates from 2 up to n-1 to find divisors.\"\"\"\n    if n < 2:\n        return False\n    for i in range(2, n):\n        if n % i == 0:\n            return False\n    return True\n\ndef split_words(sentence):\n    \"\"\"Splits a sentence into a list of words using space delimiters.\n    Filters out any empty strings resulting from multiple spaces.\"\"\"\n    return [word for word in sentence.split(' ') if word]\n\ndef filter_prime_words(words):\n    \"\"\"Filters a list of words, keeping only those whose lengths are prime numbers.\n    The original order of words is maintained.\"\"\"\n    filtered_words = []\n    for word in words:\n        if is_prime(len(word)):\n            filtered_words.append(word)\n    return filtered_words\n\ndef format_output(words):\n    \"\"\"Formats a list of words into a single space-separated string.\n    Returns an empty string if the input list is empty.\"\"\"\n    return ' '.join(words)\n\ndef words_in_sentence(sentence):\n    \"\"\"\n    Filters words from a sentence, returning only those whose lengths are prime numbers.\n    Maintains original word order and formats the output as a space-separated string.\n    \"\"\"\n    # Stage 1: Word Extraction\n    words = split_words(sentence)\n\n    # Stage 2: Prime Length Checking and Filtering\n    # The filter_prime_words function orchestrates prime checking internally.\n    prime_length_words = filter_prime_words(words)\n\n    # Stage 3: Output Formatting\n    result = format_output(prime_length_words)\n\n    return result\n```"}
{"task_id": "HumanEval/144", "solution": "Here's the implementation:\n\n```python\ndef simplify(x, n):\n    \"\"\"\n    Determines if the multiplication of two string-represented fractions results in a whole number.\n    It orchestrates parsing, multiplication, and whole number evaluation.\n    \"\"\"\n\n    def parse_fraction(fraction_str):\n        \"\"\"\n        Parses a string fraction into its numerator and denominator integers.\n        Assumes fraction_str is in \"numerator/denominator\" format.\n        \"\"\"\n        parts = fraction_str.split('/')\n        return int(parts[0]), int(parts[1])\n\n    def multiply_fractions(x_num, x_den, n_num, n_den):\n        \"\"\"\n        Multiplies two fractions given their numerators and denominators.\n        Returns a tuple of the resulting numerator and denominator.\n        \"\"\"\n        result_numerator = x_num * n_num\n        result_denominator = x_den * n_den\n        return result_numerator, result_denominator\n\n    def is_whole_number(numerator, denominator):\n        \"\"\"\n        Checks if a fraction represented by its numerator and denominator is a whole number.\n        Returns True if the numerator is perfectly divisible by the denominator.\n        \"\"\"\n        return numerator % denominator == 0\n\n    x_num, x_den = parse_fraction(x)\n    n_num, n_den = parse_fraction(n)\n\n    result_num, result_den = multiply_fractions(x_num, x_den, n_num, n_den)\n\n    return is_whole_number(result_num, result_den)\n```"}
{"task_id": "HumanEval/144", "solution": "```python\nclass Fraction:\n    \"\"\"Represents a mathematical fraction with a numerator and denominator.\"\"\"\n    def __init__(self, numerator: int, denominator: int):\n        self.numerator = numerator\n        self.denominator = denominator\n\ndef gcd(a: int, b: int) -> int:\n    \"\"\"Calculates the greatest common divisor of two integers.\"\"\"\n    while b:\n        a, b = b, a % b\n    return a\n\ndef parse_fraction(fraction_str: str) -> Fraction:\n    \"\"\"Parses a fraction string into a Fraction object.\"\"\"\n    num_str, den_str = fraction_str.split('/')\n    numerator = int(num_str)\n    denominator = int(den_str)\n    return Fraction(numerator, denominator)\n\ndef multiply_fractions(f1: Fraction, f2: Fraction) -> Fraction:\n    \"\"\"Multiplies two fractions and returns the resulting fraction.\"\"\"\n    new_numerator = f1.numerator * f2.numerator\n    new_denominator = f1.denominator * f2.denominator\n    return Fraction(new_numerator, new_denominator)\n\ndef is_whole_number(fraction: Fraction) -> bool:\n    \"\"\"Checks if a fraction represents a whole number after simplification.\"\"\"\n    common_divisor = gcd(fraction.numerator, fraction.denominator)\n    simplified_denominator = fraction.denominator // common_divisor\n    return simplified_denominator == 1\n\ndef simplify(x: str, n: str) -> bool:\n    \"\"\"Determines if the product of two fractions is a whole number.\"\"\"\n    fraction1 = parse_fraction(x)\n    fraction2 = parse_fraction(n)\n    product_fraction = multiply_fractions(fraction1, fraction2)\n    return is_whole_number(product_fraction)\n```"}
{"task_id": "HumanEval/145", "solution": "```python\ndef calculate_digit_sum(number: int) -> int:\n    \"\"\"Calculates the sum of digits for a given integer, using its absolute value.\n    Converts the number to a string to sum its digits.\n    \"\"\"\n    abs_number = abs(number)\n    return sum(int(digit) for digit in str(abs_number))\n\ndef order_by_points(nums: list[int]) -> list[int]:\n    \"\"\"Sorts a list of integers based on the sum of their digits in ascending order.\n    Maintains original order for numbers with identical digit sums.\n    \"\"\"\n    if not nums:\n        return []\n\n    # Create a list of tuples: (digit_sum, original_index, number) for stable sorting.\n    decorated_list = []\n    for i, number in enumerate(nums):\n        digit_sum = calculate_digit_sum(number)\n        decorated_list.append((digit_sum, i, number))\n\n    # Sort the decorated list primarily by digit_sum, then by original_index for stability.\n    sorted_decorated_list = sorted(decorated_list, key=lambda x: (x[0], x[1]))\n\n    # Extract the original numbers from the sorted decorated list.\n    result = [item[2] for item in sorted_decorated_list]\n\n    return result\n```"}
{"task_id": "HumanEval/145", "solution": "```python\ndef order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers based on the sum of their digits in ascending order.\n    Maintains stable sorting for elements with identical digit sums.\n    \"\"\"\n\n    def calculate_digit_sum(num):\n        \"\"\"\n        Calculates the digit sum for a number according to specific rules.\n        Negative numbers are treated as -1 plus the sum of absolute value digits.\n        \"\"\"\n        if num < 0:\n            abs_num_str = str(abs(num))\n            sum_of_abs_digits = sum(int(digit) for digit in abs_num_str)\n            return -1 + sum_of_abs_digits\n        else:\n            num_str = str(num)\n            return sum(int(digit) for digit in num_str)\n\n    return sorted(nums, key=calculate_digit_sum)\n```"}
{"task_id": "HumanEval/146", "solution": "def _get_first_digit(number):\n    \"\"\"Extracts the first digit from the absolute value of a number.\"\"\"\n    return int(str(int(abs(number)))[0])\n\ndef _get_last_digit(number):\n    \"\"\"Extracts the last digit from the absolute value of a number.\"\"\"\n    return int(abs(number)) % 10\n\ndef _is_odd_digit(digit):\n    \"\"\"Checks if a given digit is odd.\"\"\"\n    return digit in {1, 3, 5, 7, 9}\n\ndef _is_greater_than_10(number):\n    \"\"\"Validates if a number is greater than 10.\"\"\"\n    return number > 10\n\ndef _has_odd_first_digit(number):\n    \"\"\"Checks if the first digit of a number (absolute value) is odd.\"\"\"\n    return _is_odd_digit(_get_first_digit(number))\n\ndef _has_odd_last_digit(number):\n    \"\"\"Checks if the last digit of a number (absolute value) is odd.\"\"\"\n    return _is_odd_digit(_get_last_digit(number))\n\ndef _meets_all_criteria(number):\n    \"\"\"Combines all validation checks for a given number.\"\"\"\n    return _is_greater_than_10(number) and \\\n           _has_odd_first_digit(number) and \\\n           _has_odd_last_digit(number)\n\ndef specialFilter(nums):\n    \"\"\"\n    Filters and counts numbers from an array that are greater than 10 and have\n    odd first and last digits (using absolute values for digit analysis).\n    \"\"\"\n    count = 0\n    for number in nums:\n        if _meets_all_criteria(number):\n            count += 1\n    return count"}
{"task_id": "HumanEval/146", "solution": "Here's the implementation of the `specialFilter` function:\n\n```python\ndef specialFilter(nums):\n    \"\"\"Filters array and counts numbers meeting specific criteria.\n    Returns the count of numbers greater than 10 with both first and last digits odd.\n    \"\"\"\n\n    def getFirstDigit(number):\n        \"\"\"Extracts the first digit from a number, ignoring its sign.\n        Converts the number to string and takes the first character.\n        \"\"\"\n        return int(str(abs(number))[0])\n\n    def getLastDigit(number):\n        \"\"\"Extracts the last digit from a number.\n        Uses the modulo operator on the absolute value of the number.\n        \"\"\"\n        return abs(number) % 10\n\n    def isOddDigit(digit):\n        \"\"\"Checks if a given digit is odd.\n        A digit is odd if it is 1, 3, 5, 7, or 9.\n        \"\"\"\n        return digit in (1, 3, 5, 7, 9)\n\n    count = 0\n    for num in nums:\n        # Check if the number meets the basic greater than 10 criterion.\n        if num > 10:\n            first_digit = getFirstDigit(num)\n            last_digit = getLastDigit(num)\n\n            # If both first and last digits are odd, increment count.\n            if isOddDigit(first_digit) and isOddDigit(last_digit):\n                count += 1\n    return count\n```\n\nThis function correctly handles the requirements:\n- Filters numbers greater than 10\n- Checks if both first and last digits are odd (1, 3, 5, 7, 9)\n- Returns the count of numbers meeting all criteria\n- Handles edge cases like negative numbers by using absolute values for digit extraction"}
{"task_id": "HumanEval/147", "solution": "Looking at the generated C++ code, I need to provide a Python implementation that matches the original function signature. Let me convert this to Python:\n\n```python\ndef get_max_triples(n):\n    # If n is less than 3, no triples can be formed\n    if n < 3:\n        return 0\n\n    # Generate the array using the formula a[i] = i * i - i + 1\n    a = []\n    for i in range(1, n + 1):\n        a.append(i * i - i + 1)\n\n    # Count triples where the sum is divisible by 3\n    count = 0\n    for i in range(n):\n        for j in range(i + 1, n):\n            for k in range(j + 1, n):\n                if (a[i] + a[j] + a[k]) % 3 == 0:\n                    count += 1\n\n    return count\n```"}
{"task_id": "HumanEval/147", "solution": "```python\ndef get_max_triples(n):\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) from a generated array where i < j < k and their sum is a multiple of 3.\n    The array a is generated using the formula a[i] = i\u00b2 - i + 1 for each i from 1 to n.\n    \"\"\"\n\n    a = []\n    # Generate the array 'a' based on the formula a[i] = i*i - i + 1 for i from 1 to n.\n    for index in range(n):\n        i_val_for_formula = index + 1\n        a.append(i_val_for_formula * i_val_for_formula - i_val_for_formula + 1)\n\n    valid_triple_count = 0\n    # Iterate through all possible combinations of i < j < k to find valid triples.\n    for i in range(n):\n        for j in range(i + 1, n):\n            for k in range(j + 1, n):\n                current_sum = a[i] + a[j] + a[k]\n                if current_sum % 3 == 0:\n                    valid_triple_count += 1\n\n    return valid_triple_count\n```"}
{"task_id": "HumanEval/148", "solution": "Looking at the generated code, I notice it's quite complex with multiple classes. Let me simplify this to match the straightforward nature of the problem while maintaining the exact function signature:\n\n```python\ndef bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun\n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn,\n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2.\n    The function should return a tuple containing all planets whose orbits are\n    located between the orbit of planet1 and the orbit of planet2, sorted by\n    the proximity to the sun.\n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names.\n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    planets = [\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"]\n\n    # Check if both planets are valid\n    if planet1 not in planets or planet2 not in planets:\n        return ()\n\n    # Get positions of the planets\n    pos1 = planets.index(planet1)\n    pos2 = planets.index(planet2)\n\n    # Ensure pos1 is the smaller position\n    start_pos = min(pos1, pos2)\n    end_pos = max(pos1, pos2)\n\n    # Return planets between the two positions\n    return tuple(planets[start_pos + 1:end_pos])\n```"}
{"task_id": "HumanEval/148", "solution": "```python\ndef bf(planet1, planet2):\n    '''\n    Given two planet names, return a tuple of planets located between their orbits,\n    sorted by proximity to the Sun. Returns an empty tuple if planet names are invalid, adjacent, or identical.\n    '''\n    _PLANETS = (\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\")\n    _PLANET_POSITIONS = {planet: i for i, planet in enumerate(_PLANETS)}\n\n    # Helper function to get the 0-based index of a planet.\n    # Returns -1 if the planet name is not found, indicating an invalid planet.\n    def _get_planet_position(planet_name):\n        return _PLANET_POSITIONS.get(planet_name, -1)\n\n    # Helper function to extract planets between two positions.\n    def _get_planets_between(pos1, pos2):\n        # Ensure order-independent handling by determining min and max positions.\n        start_idx = min(pos1, pos2)\n        end_idx = max(pos1, pos2)\n\n        # Planets between are from start_idx + 1 up to (but not including) end_idx.\n        # If planets are adjacent or identical, this slice will be empty.\n        return _PLANETS[start_idx + 1 : end_idx]\n\n    # Get positions for both input planets.\n    idx1 = _get_planet_position(planet1)\n    idx2 = _get_planet_position(planet2)\n\n    # If either planet name is invalid (position is -1), return an empty tuple.\n    if idx1 == -1 or idx2 == -1:\n        return ()\n\n    # If planets are identical, there are no planets between them.\n    if idx1 == idx2:\n        return ()\n\n    # Calculate and return the tuple of planets located between the two valid planets.\n    return _get_planets_between(idx1, idx2)\n```"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Filters a list of strings by removing odd-length strings.\n    It then sorts the remaining strings by length and alphabetically for equal lengths.\"\"\"\n\n    def is_even_length(s):\n        \"\"\"Checks if a string has an even number of characters.\"\"\"\n        return len(s) % 2 == 0\n\n    def get_length(s):\n        \"\"\"Returns the length of a given string.\"\"\"\n        return len(s)\n\n    def _filter_even_length(strings):\n        \"\"\"Filters a list of strings, keeping only those with even lengths.\"\"\"\n        return [s for s in strings if is_even_length(s)]\n\n    def _sort_by_length_and_alphabet(strings):\n        \"\"\"Sorts strings by length ascending, then alphabetically for equal lengths.\n        This uses a stable sort with O(N log N) complexity.\"\"\"\n        return sorted(strings, key=lambda s: (get_length(s), s))\n\n    if not lst:\n        return []\n\n    filtered_strings = _filter_even_length(lst)\n    sorted_strings = _sort_by_length_and_alphabet(filtered_strings)\n\n    return sorted_strings"}
