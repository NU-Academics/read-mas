{"task_id": "HumanEval/55", "solution": "```python\n# The global cache as defined in the design's PerformanceOptimizer.\n# This ensures the cache persists across calls to fib(n).\n_fib_cache = {}\n\nclass PerformanceOptimizer:\n    \"\"\"Manages memoization cache for Fibonacci numbers.\n    Uses a shared dictionary for persistent caching.\"\"\"\n    def __init__(self):\n        self._cache = _fib_cache\n\n    def get_cached_result(self, position: int) -> int | None:\n        \"\"\"Retrieves a value from the cache if present.\"\"\"\n        return self._cache.get(position)\n\n    def cache_results(self, position: int, value: int) -> None:\n        \"\"\"Stores a calculated value in the cache.\"\"\"\n        self._cache[position] = value\n\n    def clear_cache(self) -> None:\n        \"\"\"Resets the cache for testing purposes.\"\"\"\n        self._cache.clear()\n\nclass InputValidator:\n    \"\"\"Handles input validation and specific edge cases for Fibonacci positions.\n    Validates position n is non-negative and returns edge case values.\"\"\"\n    def is_valid_position(self, n: int) -> bool:\n        \"\"\"Checks if the position n is valid (non-negative).\"\"\"\n        return n >= 0\n\n    def handle_edge_cases(self, n: int) -> int:\n        \"\"\"Returns specific results for edge cases n=0 or n=1.\"\"\"\n        return n\n\nclass FibonacciCalculator:\n    \"\"\"Core logic for calculating Fibonacci numbers.\n    Utilizes caching for efficiency and handles base cases.\"\"\"\n    def __init__(self, optimizer: PerformanceOptimizer, validator: InputValidator):\n        self._optimizer = optimizer\n        self._validator = validator\n\n    def _iterative_fibonacci(self, n: int) -> int:\n        \"\"\"Calculates the n-th Fibonacci number iteratively.\"\"\"\n        a, b = 0, 1\n        for _ in range(2, n + 1):\n            a, b = b, a + b\n        return b\n\n    def calculate_fibonacci(self, n: int) -> int:\n        \"\"\"Calculates the n-th Fibonacci number, using validation and caching.\"\"\"\n        # As per sequence diagram, validate first.\n        # Per problem constraints, assume n is a non-negative integer.\n        self._validator.is_valid_position(n)\n\n        # Handle edge cases n=0, n=1 directly, as per sequence diagram UC-002.\n        if n <= 1:\n            return self._validator.handle_edge_cases(n)\n\n        cached_result = self._optimizer.get_cached_result(n)\n        if cached_result is not None:\n            return cached_result\n\n        result = self._iterative_fibonacci(n)\n        self._optimizer.cache_results(n, result)\n        return result\n\ndef fib(n: int):\n    \"\"\"Return n-th Fibonacci number.\n    Uses a modular design with caching and input handling.\"\"\"\n    optimizer = PerformanceOptimizer()\n    validator = InputValidator()\n    calculator = FibonacciCalculator(optimizer, validator)\n    return calculator.calculate_fibonacci(n)\n```"}
{"task_id": "HumanEval/56", "solution": "```python\ndef correct_bracketing(brackets: str) -> bool:\n    \"\"\"\n    Validates if bracket string is properly balanced and nested.\n    Checks for valid characters, then uses a counter for balance and nesting.\n    \"\"\"\n    balance = 0\n\n    # Validate that input contains only '<' and '>' characters.\n    for char in brackets:\n        if char not in ('<', '>'):\n            return False\n\n    # Perform the balance check using a counter.\n    for char in brackets:\n        if char == '<':\n            balance += 1\n        elif char == '>':\n            balance -= 1\n\n        # If balance ever drops below zero, it means a closing bracket\n        # appeared without a corresponding opening one.\n        if balance < 0:\n            return False\n\n    # For correct bracketing, the final balance must be zero.\n    return balance == 0\n```"}
