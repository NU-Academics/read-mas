{"task_id": "HumanEval/81", "solution": "```python\ndef numerical_letter_grade(grades):\n    \"\"\"Converts a list of GPA values to a list of letter grades based on a predefined scale.\n    Maintains input order and processes floating-point GPA values.\n    \"\"\"\n\n    letter_grades = []\n    for gpa in grades:\n        if gpa == 4.0:\n            letter_grades.append('A+')\n        elif gpa > 3.7:\n            letter_grades.append('A')\n        elif gpa > 3.3:\n            letter_grades.append('A-')\n        elif gpa > 3.0:\n            letter_grades.append('B+')\n        elif gpa > 2.7:\n            letter_grades.append('B')\n        elif gpa > 2.3:\n            letter_grades.append('B-')\n        elif gpa > 2.0:\n            letter_grades.append('C+')\n        elif gpa > 1.7:\n            letter_grades.append('C')\n        elif gpa > 1.3:\n            letter_grades.append('C-')\n        elif gpa > 1.0:\n            letter_grades.append('D+')\n        elif gpa > 0.7:\n            letter_grades.append('D')\n        elif gpa > 0.0:\n            letter_grades.append('D-')\n        elif gpa == 0.0:\n            letter_grades.append('E')\n\n    return letter_grades\n```"}
{"task_id": "HumanEval/82", "solution": "```python\ndef _is_prime(n: int) -> bool:\n    \"\"\"Helper function to check if a number is prime using O(\u221an) complexity.\"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n\ndef prime_length(string: str) -> bool:\n    \"\"\"Determines if the length of a string is a prime number.\"\"\"\n    length = len(string)\n    return _is_prime(length)\n```"}
{"task_id": "HumanEval/82", "solution": "```python\nimport math\n\ndef _calculate_length(s: str) -> int:\n    \"\"\"Calculates the length of the input string.\"\"\"\n    return len(s)\n\ndef _is_prime(n: int) -> bool:\n    \"\"\"Checks if a number is prime using an O(\u221an) algorithm.\"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n\n    i = 3\n    while i * i <= n: # Checks factors up to the square root of n\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n\ndef prime_length(string: str) -> bool:\n    \"\"\"Returns True if the string's length is a prime number, False otherwise.\"\"\"\n    length = _calculate_length(string)\n    return _is_prime(length)\n```"}
{"task_id": "HumanEval/81", "solution": "```python\ndef numerical_letter_grade(grades):\n    \"\"\"Converts a list of numerical GPA values to a list of letter grades.\"\"\"\n\n    def _convert_single_gpa(gpa):\n        \"\"\"Converts a single GPA to its letter grade based on defined thresholds.\"\"\"\n        if gpa == 4.0:\n            return 'A+'\n        elif gpa > 3.7:\n            return 'A'\n        elif gpa > 3.3:\n            return 'A-'\n        elif gpa > 3.0:\n            return 'B+'\n        elif gpa > 2.7:\n            return 'B'\n        elif gpa > 2.3:\n            return 'B-'\n        elif gpa > 2.0:\n            return 'C+'\n        elif gpa > 1.7:\n            return 'C'\n        elif gpa > 1.3:\n            return 'C-'\n        elif gpa > 1.0:\n            return 'D+'\n        elif gpa > 0.7:\n            return 'D'\n        elif gpa > 0.0:\n            return 'D-'\n        elif gpa == 0.0:\n            return 'E'\n\n    return [_convert_single_gpa(gpa) for gpa in grades]\n```"}
{"task_id": "HumanEval/83", "solution": "```python\ndef starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    if n == 1:\n        return 1\n\n    # Count numbers starting with 1: 1xxxxxxx (n-digit)\n    # First digit is 1, remaining (n-1) digits can be 0-9\n    starts_with_1 = 10**(n-1)\n\n    # Count numbers ending with 1: xxxxxxx1 (n-digit)\n    # Last digit is 1, first digit can be 1-9 (can't be 0 for n-digit number)\n    # Remaining (n-2) digits can be 0-9\n    ends_with_1 = 9 * (10**(n-2))\n\n    # Count numbers both starting and ending with 1: 1xxxxx1 (n-digit)\n    # First and last digits are 1, middle (n-2) digits can be 0-9\n    both_start_end_1 = 10**(n-2)\n\n    # Apply inclusion-exclusion principle: |A \u222a B| = |A| + |B| - |A \u2229 B|\n    return starts_with_1 + ends_with_1 - both_start_end_1\n```"}
{"task_id": "HumanEval/83", "solution": "```python\ndef starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    # Special case: for n=1, only the number \"1\" qualifies\n    if n == 1:\n        return 1\n\n    # Numbers starting with 1: 1\u00d7\u00d7\u00d7...\u00d7 (n digits)\n    # First digit is 1, remaining (n-1) digits can be 0-9\n    # Count = 10^(n-1)\n    count_starting_with_1 = 10 ** (n - 1)\n\n    # Numbers ending with 1: \u00d7\u00d7\u00d7...\u00d71 (n digits)\n    # First digit can be 1-9 (9 choices), middle (n-2) digits can be 0-9, last digit is 1\n    # Count = 9 \u00d7 10^(n-2)\n    count_ending_with_1 = 9 * (10 ** (n - 2))\n\n    # Numbers both starting AND ending with 1: 1\u00d7\u00d7...\u00d71 (n digits)\n    # First digit is 1, last digit is 1, middle (n-2) digits can be 0-9\n    # Count = 10^(n-2)\n    count_both = 10 ** (n - 2)\n\n    # Apply inclusion-exclusion principle to avoid double counting\n    total = count_starting_with_1 + count_ending_with_1 - count_both\n\n    return total\n```"}
{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n\n    Example\n        For N = 1000, the sum of digits will be 1 the output should be \"1\".\n        For N = 150, the sum of digits will be 6 the output should be \"110\".\n        For N = 147, the sum of digits will be 12 the output should be \"1100\".\n\n    Variables:\n        @N integer\n             Constraints: 0 \u2264 N \u2264 10000.\n    Output:\n         a string of binary number\n    \"\"\"\n    # Calculate sum of digits\n    digit_sum = sum(int(digit) for digit in str(N))\n\n    # Convert to binary and return as string\n    return bin(digit_sum)[2:]"}
