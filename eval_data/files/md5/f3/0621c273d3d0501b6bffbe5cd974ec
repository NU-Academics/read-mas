{"task_id": "HumanEval/91", "solution": "def is_bored(S):\n    \"\"\"\n    You'll be given a string of words, and your task is to count the number\n    of boredoms. A boredom is a sentence that starts with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n\n    For example:\n    >>> is_bored(\"Hello world\")\n    0\n    >>> is_bored(\"The sky is blue. The sun is shining. I love this weather\")\n    1\n    \"\"\"\n    import re\n\n    # Split the string by sentence delimiters\n    sentences = re.split(r'[.?!]', S)\n\n    count = 0\n    for sentence in sentences:\n        # Strip whitespace and check if sentence starts with \"I\"\n        sentence = sentence.strip()\n        if sentence and sentence.split()[0] == \"I\":\n            count += 1\n\n    return count"}
{"task_id": "HumanEval/91", "solution": "```python\ndef is_bored(S):\n    \"\"\"\n    Counts sentences starting with the word \"I\", delimited by '.', '?' or '!'.\n    Processes text by splitting, trimming, and pattern matching for \"I\".\n    \"\"\"\n    import re\n\n    # SentenceSplitter component logic\n    DELIMITERS_REGEX = r'[.?!]'\n\n    def split_by_delimiters(text):\n        # Splits text into a list of potential sentences using defined delimiters.\n        return re.split(DELIMITERS_REGEX, text)\n\n    # TextProcessor utility for trimming\n    def trim_sentence(sentence):\n        # Removes leading whitespace from a given sentence string.\n        return sentence.lstrip()\n\n    # PatternMatcher component logic\n    def extract_first_word(sentence_content):\n        # Extracts the first word from a sentence string.\n        if not sentence_content:\n            return \"\"\n        # Splits by whitespace, max one split to get only the first word cleanly.\n        parts = sentence_content.split(maxsplit=1)\n        return parts[0] if parts else \"\"\n\n    def is_word_i(word):\n        # Checks if the given word is exactly \"I\" (case-sensitive).\n        return word == \"I\"\n\n    def starts_with_i_check(sentence_content):\n        # Determines if a sentence starts with the exact word \"I\".\n        first_word = extract_first_word(sentence_content)\n        return is_word_i(first_word)\n\n    # Core Algorithm Flow / Text Processing Layer\n    boredom_count = 0\n    sentences = split_by_delimiters(S)\n\n    for sentence_part in sentences:\n        trimmed_sentence = trim_sentence(sentence_part)\n        # Only process non-empty sentences after trimming to avoid false positives from empty splits.\n        if trimmed_sentence:\n            if starts_with_i_check(trimmed_sentence):\n                boredom_count += 1\n\n    return boredom_count\n```"}
{"task_id": "HumanEval/92", "solution": "```python\ndef any_int(x, y, z):\n    \"\"\"\n    Create a function that takes 3 numbers.\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns false in any other cases.\n    \"\"\"\n    # Check if all inputs are integers (not booleans)\n    if not (isinstance(x, int) and isinstance(y, int) and isinstance(z, int) and\n            not isinstance(x, bool) and not isinstance(y, bool) and not isinstance(z, bool)):\n        return False\n\n    # Check if one number equals the sum of the other two\n    return (x == y + z) or (y == x + z) or (z == x + y)\n```"}
{"task_id": "HumanEval/92", "solution": "Looking at the problem, I need to provide just the `any_int` function without the modular structure. Let me generate a simpler, single-function implementation:\n\n```python\ndef any_int(x, y, z):\n    '''\n    Create a function that takes 3 numbers.\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns false in any other cases.\n\n    Examples\n    any_int(5, 2, 7) \u279e True\n\n    any_int(3, 2, 2) \u279e False\n\n    any_int(3, -2, 1) \u279e True\n\n    any_int(3.6, -2.2, 2) \u279e False\n    '''\n    # Check if all inputs are integers\n    if not all(isinstance(num, int) for num in [x, y, z]):\n        return False\n\n    # Check if any number equals the sum of the other two\n    return x == y + z or y == x + z or z == x + y\n```"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by swapping letter cases and replacing vowels.\n    Vowels are replaced with letters two positions ahead, preserving case.\n    \"\"\"\n    _vowel_replacements_lower = {\n        'a': 'c',\n        'e': 'g',\n        'i': 'k',\n        'o': 'q',\n        'u': 'w'\n    }\n\n    encoded_chars = []\n    for char in message:\n        processed_char = char\n\n        if char.isalpha():\n            swapped_char = char.swapcase()\n\n            if swapped_char.lower() in _vowel_replacements_lower:\n                replacement_lower = _vowel_replacements_lower[swapped_char.lower()]\n                if swapped_char.isupper():\n                    processed_char = replacement_lower.upper()\n                else:\n                    processed_char = replacement_lower\n            else:\n                processed_char = swapped_char\n\n        encoded_chars.append(processed_char)\n\n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/94", "solution": "```python\nimport math\n\ndef is_prime(n):\n    \"\"\"Checks if a number is prime using an optimized algorithm.\"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    # Check for odd divisors from 3 up to sqrt(n).\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n\ndef find_largest_prime(lst):\n    \"\"\"Finds the largest prime number in a list of integers.\"\"\"\n    largest_prime = -1\n    for num in lst:\n        if is_prime(num):\n            if num > largest_prime:\n                largest_prime = num\n    return largest_prime\n\ndef sum_digits(n):\n    \"\"\"Calculates the sum of the digits of a number.\"\"\"\n    n = abs(n)  # Use absolute value to handle negative numbers.\n    digit_sum = 0\n    while n > 0:\n        digit_sum += n % 10\n        n //= 10\n    return digit_sum\n\ndef skjkasdkd(lst):\n    \"\"\"Finds the largest prime value in a list and returns the sum of its digits.\"\"\"\n    if not lst:\n        return 0\n\n    largest_prime_val = find_largest_prime(lst)\n\n    if largest_prime_val == -1:  # No prime numbers were found in the list.\n        return 0\n\n    return sum_digits(largest_prime_val)\n```"}
{"task_id": "HumanEval/93", "solution": "```python\ndef encode(message):\n    \"\"\"\n    Write a function that takes a message, and encodes in such a\n    way that it swaps case of all letters, replaces all vowels in\n    the message with the letter that appears 2 places ahead of that\n    vowel in the english alphabet.\n    Assume only letters.\n\n    Examples:\n    >>> encode('test')\n    'TGST'\n    >>> encode('This is a message')\n    'tHKS KS C MGSSCGG'\n    \"\"\"\n    vowel_map = {'a': 'c', 'e': 'g', 'i': 'k', 'o': 'q', 'u': 'w'}\n    result = []\n\n    for char in message:\n        if char.isalpha():\n            if char.lower() in vowel_map:\n                # Replace vowel with letter 2 positions ahead, preserve case\n                replacement = vowel_map[char.lower()]\n                if char.isupper():\n                    result.append(replacement.upper())\n                else:\n                    result.append(replacement)\n            else:\n                # Swap case for consonants\n                result.append(char.swapcase())\n        else:\n            # Preserve non-letter characters\n            result.append(char)\n\n    return ''.join(result)\n```"}
{"task_id": "HumanEval/94", "solution": "```python\ndef is_prime(n):\n    \"\"\"Checks if a number is prime using optimized trial division.\"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:  # Covers 2 and 3\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    # Check for divisors from 5 up to sqrt(n)\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n\ndef sum_digits(n):\n    \"\"\"Calculates the sum of the digits of a non-negative number.\"\"\"\n    total_sum = 0\n    # Ensure n is positive for digit extraction\n    n = abs(n)\n    while n > 0:\n        total_sum += n % 10\n        n //= 10\n    return total_sum\n\ndef skjkasdkd(lst):\n    \"\"\"Finds the largest prime value in a list and returns the sum of its digits.\"\"\"\n    largest_prime = -1  # Sentinel value to track if any prime is found\n\n    for num in lst:\n        if is_prime(num):\n            if num > largest_prime:\n                largest_prime = num\n\n    if largest_prime == -1:  # No prime numbers were found in the list\n        return 0\n    else:\n        return sum_digits(largest_prime)\n```"}
{"task_id": "HumanEval/95", "solution": "```python\ndef check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower\n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    Examples:\n    check_dict_case({\"a\":\"apple\", \"b\":\"banana\"}) should return True.\n    check_dict_case({\"a\":\"apple\", \"A\":\"banana\", \"B\":\"banana\"}) should return False.\n    check_dict_case({\"a\":\"apple\", 8:\"banana\", \"a\":\"apple\"}) should return False.\n    check_dict_case({\"Name\":\"John\", \"Age\":\"36\", \"City\":\"Houston\"}) should return False.\n    check_dict_case({\"STATE\":\"NC\", \"ZIP\":\"12345\" }) should return True.\n    \"\"\"\n    if not dict:\n        return False\n\n    keys = list(dict.keys())\n\n    # Check if all keys are strings\n    for key in keys:\n        if not isinstance(key, str):\n            return False\n\n    # Check if all keys are lowercase or all keys are uppercase\n    all_lower = all(key.islower() for key in keys)\n    all_upper = all(key.isupper() for key in keys)\n\n    return all_lower or all_upper\n```"}
{"task_id": "HumanEval/95", "solution": "```python\ndef check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower\n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    Examples:\n    check_dict_case({\"a\":\"apple\", \"b\":\"banana\"}) should return True.\n    check_dict_case({\"a\":\"apple\", \"A\":\"banana\", \"B\":\"banana\"}) should return False.\n    check_dict_case({\"a\":\"apple\", 8:\"banana\", \"a\":\"apple\"}) should return False.\n    check_dict_case({\"Name\":\"John\", \"Age\":\"36\", \"City\":\"Houston\"}) should return False.\n    check_dict_case({\"STATE\":\"NC\", \"ZIP\":\"12345\" }) should return True.\n    \"\"\"\n    if not dict:\n        return False\n\n    all_lower = True\n    all_upper = True\n\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False\n        if not key.islower():\n            all_lower = False\n        if not key.isupper():\n            all_upper = False\n\n    return all_lower or all_upper\n```"}
{"task_id": "HumanEval/96", "solution": "```python\ndef count_up_to(n):\n    \"\"\"Generates an array of prime numbers strictly less than n.\n    Handles edge cases for n=0 and n=1 by returning an empty list.\"\"\"\n\n    def _handle_edge_cases(num):\n        \"\"\"Checks for edge cases (0 or 1), returning an empty list if matched.\"\"\"\n        if num <= 1:\n            return []\n        return None\n\n    def _sieve_of_eratosthenes(limit):\n        \"\"\"Implements the Sieve of Eratosthenes to find all primes up to a given limit.\"\"\"\n        if limit <= 2:\n            return []\n\n        is_prime = [True] * limit\n        is_prime[0] = is_prime[1] = False\n\n        primes = []\n        for p in range(2, limit):\n            if is_prime[p]:\n                primes.append(p)\n                for multiple in range(p * p, limit, p):\n                    is_prime[multiple] = False\n        return primes\n\n    edge_case_result = _handle_edge_cases(n)\n    if edge_case_result is not None:\n        return edge_case_result\n\n    return _sieve_of_eratosthenes(n)\n```"}
