{"task_id": "HumanEval/6", "solution": "from typing import List\n\n\nclass DepthTracker:\n    \"\"\"Tracks current and maximum nesting depth.\n    Ensures depth never goes below zero for malformed input.\"\"\"\n    def __init__(self):\n        self.current_depth = 0\n        self.max_depth = 0\n\n    def increment(self):\n        \"\"\"Increases current depth and updates maximum depth if necessary.\"\"\"\n        self.current_depth += 1\n        self.max_depth = max(self.max_depth, self.current_depth)\n\n    def decrement(self):\n        \"\"\"Decreases current depth, preventing it from going below zero.\"\"\"\n        self.current_depth = max(0, self.current_depth - 1)\n\n    def get_max_depth(self) -> int:\n        \"\"\"Returns the highest depth recorded.\"\"\"\n        return self.max_depth\n\n    def reset(self):\n        \"\"\"Resets the tracker to its initial state.\"\"\"\n        self.current_depth = 0\n        self.max_depth = 0\n\n\ndef calculate_max_depth(group: str) -> int:\n    \"\"\"Calculates the maximum nesting depth for a single parentheses group.\"\"\"\n    tracker = DepthTracker()\n    for char in group:\n        if char == '(':\n            tracker.increment()\n        elif char == ')':\n            tracker.decrement()\n    return tracker.get_max_depth()\n\n\ndef process_groups(groups: List[str]) -> List[int]:\n    \"\"\"Iterates through a list of groups and calculates the maximum depth for each.\"\"\"\n    depths = []\n    for group in groups:\n        depths.append(calculate_max_depth(group))\n    return depths\n\n\ndef split_into_groups(input_string: str) -> List[str]:\n    \"\"\"Splits an input string into individual parentheses groups using spaces.\"\"\"\n    # Strip leading/trailing whitespace, split by spaces, and filter out any empty strings\n    return [g for g in input_string.strip().split(' ') if g]\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\"\"\"\n    groups = split_into_groups(paren_string)\n    return process_groups(groups)"}
{"task_id": "HumanEval/6", "solution": "```python\nfrom typing import List\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    groups = paren_string.split()\n    results = []\n\n    for group in groups:\n        current_level = 0\n        max_depth = 0\n\n        for char in group:\n            if char == '(':\n                current_level += 1\n                max_depth = max(max_depth, current_level)\n            elif char == ')':\n                current_level -= 1\n\n        results.append(max_depth)\n\n    return results\n```"}
{"task_id": "HumanEval/8", "solution": "```python\nfrom typing import List, Tuple\n\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\"\n    Calculate sum and product of integers in a list.\n    Returns a tuple containing (sum, product), with (0, 1) for an empty list.\n    \"\"\"\n    if not numbers:\n        return (0, 1)\n\n    current_sum = sum(numbers)\n    current_product = 1\n    for number in numbers:\n        current_product *= number\n\n    return (current_sum, current_product)\n```"}
{"task_id": "HumanEval/8", "solution": "```python\nfrom typing import List, Tuple\n\n\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    if not numbers:\n        return 0, 1\n\n    current_sum = sum(numbers)\n    current_product = 1\n    for number in numbers:\n        current_product *= number\n\n    return current_sum, current_product\n```"}
{"task_id": "HumanEval/9", "solution": "```python\nfrom typing import List\n\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\"From a given list of integers, generate a list of rolling maximum element found until given moment in the sequence.\"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    current_max = numbers[0]\n    result.append(current_max)\n\n    for i in range(1, len(numbers)):\n        if numbers[i] > current_max:\n            current_max = numbers[i]\n        result.append(current_max)\n\n    return result\n```"}
{"task_id": "HumanEval/10", "solution": "```python\ndef is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome. \"\"\"\n    return string == string[::-1]\n\ndef find_longest_palindromic_postfix(string: str) -> int:\n    \"\"\" Identifies the start position of the longest palindromic suffix.\n    It iterates from the start to find the first index where the substring from that index is a palindrome.\n    \"\"\"\n    n = len(string)\n    for i in range(n):\n        if is_palindrome(string[i:]):\n            return i\n    # For non-empty strings, a single character is always a palindrome, so this loop will always return.\n    return n # Fallback, though ideally unreachable for valid inputs after empty string check.\n\ndef extract_prefix(string: str, postfix_start: int) -> str:\n    \"\"\" Extracts the prefix portion that comes before the palindromic postfix. \"\"\"\n    return string[:postfix_start]\n\ndef reverse_string(string: str) -> str:\n    \"\"\" Reverses the input string. \"\"\"\n    return string[::-1]\n\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    The algorithm finds the longest palindromic postfix and appends the reverse of the remaining prefix.\n    \"\"\"\n    if not string:\n        return \"\"\n\n    postfix_start_index = find_longest_palindromic_postfix(string)\n    prefix_to_reverse = extract_prefix(string, postfix_start_index)\n    reversed_prefix = reverse_string(prefix_to_reverse)\n\n    return string + reversed_prefix\n```"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    return string == string[::-1]\n\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    if not string:\n        return \"\"\n\n    # Find the longest postfix that is a palindrome\n    for i in range(len(string) + 1):\n        postfix = string[i:]\n        if is_palindrome(postfix):\n            # Found the longest palindromic postfix\n            prefix = string[:i]\n            return string + prefix[::-1]\n\n    # This should never be reached since empty string is always a palindrome\n    return string"}
