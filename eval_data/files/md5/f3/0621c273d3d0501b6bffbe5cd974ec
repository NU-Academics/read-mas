{"task_id": "HumanEval/154", "solution": "```python\ndef cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\n    cycpattern_check(\"abcd\",\"abd\") => False\n    cycpattern_check(\"hello\",\"ell\") => True\n    cycpattern_check(\"whassup\",\"psus\") => False\n    cycpattern_check(\"abab\",\"baa\") => True\n    cycpattern_check(\"efef\",\"eeff\") => False\n    cycpattern_check(\"himenss\",\"simen\") => True\n\n    \"\"\"\n    if not b:\n        return True\n\n    # Generate all rotations of string b\n    for i in range(len(b)):\n        rotation = b[i:] + b[:i]\n        if rotation in a:\n            return True\n\n    return False\n```"}
{"task_id": "HumanEval/155", "solution": "```python\ndef even_odd_count(num):\n    \"\"\"Given an integer, return a tuple with the count of even and odd digits.\n    The function processes the absolute value of the input number.\"\"\"\n\n    def _is_even(digit):\n        \"\"\"Determines if a given digit is even.\n        Returns True for even digits (0, 2, 4, 6, 8), False otherwise.\"\"\"\n        return digit % 2 == 0\n\n    def _extract_digits(num_val):\n        \"\"\"Extracts individual digits from an integer.\n        Returns a list of digits, handling zero correctly.\"\"\"\n        if num_val == 0:\n            return [0]\n\n        digits = []\n        # Process the absolute value of the number to extract digits.\n        current_num = abs(num_val)\n        while current_num > 0:\n            digits.append(current_num % 10)\n            current_num //= 10\n\n        # Digits are extracted in reverse order, so reverse the list.\n        return digits[::-1]\n\n    even_count = 0\n    odd_count = 0\n\n    # Use the absolute value of the input number as specified.\n    abs_num = abs(num)\n\n    # Extract digits using the private helper function.\n    digits_list = _extract_digits(abs_num)\n\n    # Iterate through the digits and classify them as even or odd.\n    for digit in digits_list:\n        if _is_even(digit):\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)\n```"}
{"task_id": "HumanEval/155", "solution": "```python\ndef even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    # Convert input to its absolute value to ignore the negative sign\n    num_abs = abs(num)\n\n    # Handle special case of zero\n    if num_abs == 0:\n        return (1, 0)\n\n    # Extract and classify each digit\n    while num_abs > 0:\n        digit = num_abs % 10\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n        num_abs //= 10\n\n    return (even_count, odd_count)\n```"}
{"task_id": "HumanEval/157", "solution": "```python\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or\n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    # Check if all sides are positive\n    if a <= 0 or b <= 0 or c <= 0:\n        return False\n\n    # Check triangle inequality\n    if not (a + b > c and a + c > b and b + c > a):\n        return False\n\n    # Sort sides to identify potential hypotenuse\n    sides = sorted([a, b, c])\n    side1, side2, hypotenuse = sides[0], sides[1], sides[2]\n\n    # Check Pythagorean theorem with floating-point precision tolerance\n    return abs(side1**2 + side2**2 - hypotenuse**2) < 1e-10\n```"}
{"task_id": "HumanEval/156", "solution": "```python\ndef int_to_mini_roman(number):\n    \"\"\"\n    Converts a positive integer (1-1000) to its lowercase Roman numeral equivalent.\n    Applies standard and subtractive Roman numeral rules for conversion.\n    \"\"\"\n    ROMAN_MAPPINGS = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'),\n        (1, 'I')\n    ]\n\n    roman_numeral_parts = []\n\n    # Iterate through mappings to build the Roman numeral string.\n    for value, symbol in ROMAN_MAPPINGS:\n        while number >= value:\n            roman_numeral_parts.append(symbol)\n            number -= value\n\n    return \"\".join(roman_numeral_parts).lower()\n```"}
{"task_id": "HumanEval/156", "solution": "```python\ndef int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n\n    # Component: RomanNumeralMapping (from src/mapping.py)\n    # Responsibility: Provides Roman numeral symbol mappings.\n    ROMAN_MAPPING = [\n        (1000, 'm'), (900, 'cm'), (500, 'd'), (400, 'cd'),\n        (100, 'c'), (90, 'xc'), (50, 'l'), (40, 'xl'),\n        (10, 'x'), (9, 'ix'), (5, 'v'), (4, 'iv'), (1, 'i')\n    ]\n\n    def get_roman_symbols():\n        \"\"\"Returns the Roman numeral mappings as a list of (value, symbol) tuples.\"\"\"\n        return ROMAN_MAPPING\n\n    # Component: InputValidator (from src/validator.py)\n    # Responsibility: Validates input parameters and range constraints.\n    MIN_VALUE = 1\n    MAX_VALUE = 1000\n\n    def is_valid_range(num_to_check):\n        \"\"\"Checks if a number is within the valid Roman numeral conversion range.\"\"\"\n        return MIN_VALUE <= num_to_check <= MAX_VALUE\n\n    def validate_input(num_to_check):\n        \"\"\"Validates if the input number is within the allowed range.\"\"\"\n        return is_valid_range(num_to_check)\n\n    # Component: RomanNumeralConverter (from src/converter.py)\n    # Responsibility: Orchestrates the conversion process from integer to Roman numeral.\n    def convert_to_roman(num_to_convert):\n        \"\"\"Converts an integer to its lowercase Roman numeral string.\"\"\"\n        roman_numeral = []\n        mappings = get_roman_symbols()\n\n        for value, symbol in mappings:\n            while num_to_convert >= value:\n                roman_numeral.append(symbol)\n                num_to_convert -= value\n        return \"\".join(roman_numeral)\n\n    # Component: MainFunction (from src/main.py)\n    # Responsibility: Provides the required int_to_mini_roman function interface.\n    # As per critical requirements, input validation is not used to raise exceptions\n    # and we trust the caller's input within the specified range.\n    return convert_to_roman(number)\n```"}
{"task_id": "HumanEval/157", "solution": "```python\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or\n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    # MathUtils components adapted as inner functions/constants\n    TOLERANCE = 1e-10  # Defines tolerance for floating-point comparisons.\n\n    def _square(value):\n        \"\"\"Returns the square of a numeric value.\"\"\"\n        return value * value\n\n    def _is_approximately_equal(val1, val2, tolerance_val):\n        \"\"\"Compares two floating-point values within a specified tolerance.\"\"\"\n        return abs(val1 - val2) < tolerance_val\n\n    # TriangleValidator components adapted as inner functions\n    def _validate_positive_inputs(side1, side2, side3):\n        \"\"\"Checks if all side lengths are positive.\"\"\"\n        return side1 > 0 and side2 > 0 and side3 > 0\n\n    def _validate_triangle_inequality(side1, side2, side3):\n        \"\"\"Ensures the sum of any two sides is greater than the third side.\"\"\"\n        return (side1 + side2 > side3) and \\\n               (side1 + side3 > side2) and \\\n               (side2 + side3 > side1)\n\n    def _compare_with_tolerance(val1, val2):\n        \"\"\"Uses the predefined TOLERANCE to compare two values.\"\"\"\n        return _is_approximately_equal(val1, val2, TOLERANCE)\n\n    def _check_pythagorean_theorem(side1, side2, side3):\n        \"\"\"Verifies if any combination of sides satisfies the Pythagorean theorem.\"\"\"\n        sq_side1 = _square(side1)\n        sq_side2 = _square(side2)\n        sq_side3 = _square(side3)\n\n        # Check all three possible hypotenuse combinations\n        return (_compare_with_tolerance(sq_side1 + sq_side2, sq_side3) or\n                _compare_with_tolerance(sq_side1 + sq_side3, sq_side2) or\n                _compare_with_tolerance(sq_side2 + sq_side3, sq_side1))\n\n    # Main logic flow for right_angle_triangle function\n    if not _validate_positive_inputs(a, b, c):\n        return False\n    if not _validate_triangle_inequality(a, b, c):\n        return False\n\n    return _check_pythagorean_theorem(a, b, c)\n```"}
{"task_id": "HumanEval/158", "solution": "```python\ndef find_max(words):\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n\n    find_max([\"name\", \"of\", \"string\"]) == \"string\"\n    find_max([\"name\", \"enam\", \"game\"]) == \"enam\"\n    find_max([\"aaaaaaa\", \"bb\" ,\"cc\"]) == \"\"aaaaaaa\"\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_chars = -1\n    result = \"\"\n\n    for word in words:\n        unique_count = len(set(word))\n\n        if unique_count > max_unique_chars:\n            max_unique_chars = unique_count\n            result = word\n        elif unique_count == max_unique_chars:\n            if word < result:\n                result = word\n\n    return result\n```"}
{"task_id": "HumanEval/158", "solution": "```python\ndef count_unique_characters(word):\n    \"\"\"Count unique characters in a string.\n    Uses a set to identify unique characters.\n    \"\"\"\n    return len(set(word))\n\ndef find_candidates_with_max_count(words, counts):\n    \"\"\"Find all strings with maximum unique character count.\n    Identifies candidate strings for lexicographical selection.\n    \"\"\"\n    if not counts:\n        return []\n\n    max_count = max(counts)\n    candidates = []\n    for i in range(len(words)):\n        if counts[i] == max_count:\n            candidates.append(words[i])\n    return candidates\n\ndef select_lexicographically_first(candidates):\n    \"\"\"Select lexicographically first string from candidates.\n    Uses min() for efficient lexicographical comparison.\n    \"\"\"\n    if not candidates:\n        return \"\"\n    return min(candidates)\n\ndef find_max(words):\n    \"\"\"Main function that finds string with maximum unique characters.\n    Applies lexicographical ordering as a tiebreaker.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    # Count unique characters for each word\n    unique_counts = [count_unique_characters(word) for word in words]\n\n    # Identify strings with the maximum unique character count\n    candidates = find_candidates_with_max_count(words, unique_counts)\n\n    # Apply lexicographical ordering as a tiebreaker\n    return select_lexicographically_first(candidates)\n```"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    You're a hungry rabbit, and you already have eaten a certain number of carrots,\n    but now you need to eat more carrots to complete the day's meals.\n    you should return an array of [ total number of eaten carrots after your meals,\n                                    the number of carrots left after your meals ]\n    if there are not enough remaining carrots, you will eat all remaining carrots, but will still be hungry.\n\n    Example:\n    * eat(5, 6, 10) -> [11, 4]\n    * eat(4, 8, 9) -> [12, 1]\n    * eat(1, 10, 10) -> [11, 0]\n    * eat(2, 11, 5) -> [7, 0]\n\n    Variables:\n    @number : integer\n        the number of carrots that you have eaten.\n    @need : integer\n        the number of carrots that you need to eat.\n    @remaining : integer\n        the number of remaining carrots thet exist in stock\n\n    Constrain:\n    * 0 <= number <= 1000\n    * 0 <= need <= 1000\n    * 0 <= remaining <= 1000\n\n    Have fun :)\n    \"\"\"\n    # Calculate how many carrots can actually be eaten (limited by what's available)\n    actual_consumed = min(need, remaining)\n\n    # Calculate total carrots eaten (already eaten + newly consumed)\n    total_eaten = number + actual_consumed\n\n    # Calculate carrots remaining after consumption\n    carrots_left = remaining - actual_consumed\n\n    return [total_eaten, carrots_left]"}
{"task_id": "HumanEval/159", "solution": "```python\ndef eat(number, need, remaining):\n    \"\"\"\n    Calculates total carrots eaten and remaining stock after a rabbit's meal.\n    It simulates consumption, respecting current stock and hunger, returning a two-element array.\n    \"\"\"\n\n    # Determine the actual number of carrots consumed, limited by what's available.\n    carrots_consumed = min(need, remaining)\n\n    # Calculate the total carrots eaten after this meal.\n    total_eaten = number + carrots_consumed\n\n    # Calculate the remaining carrots in stock.\n    final_remaining = remaining - carrots_consumed\n\n    return [total_eaten, final_remaining]\n```"}
{"task_id": "HumanEval/160", "solution": "```python\ndef do_algebra(operator, operand):\n    \"\"\"\n    Builds and evaluates an algebraic expression from operator and operand lists.\n    Assumes valid inputs as per specification, returning the integer result.\n    \"\"\"\n    expression_parts = [str(operand[0])]\n\n    for i in range(len(operator)):\n        expression_parts.append(operator[i])\n        expression_parts.append(str(operand[i + 1]))\n\n    expression_string = \" \".join(expression_parts)\n    result = eval(expression_string)\n\n    return int(result)\n```"}
{"task_id": "HumanEval/160", "solution": "```python\ndef do_algebra(operator, operand):\n    \"\"\"\n    Builds an algebraic expression from given operators and operands and evaluates it.\n    The expression alternates operands and operators, following standard Python precedence.\n    \"\"\"\n    expression_parts = []\n    expression_parts.append(str(operand[0]))\n\n    for i in range(len(operator)):\n        expression_parts.append(operator[i])\n        expression_parts.append(str(operand[i + 1]))\n\n    expression_string = \" \".join(expression_parts)\n    result = eval(expression_string)\n\n    return int(result)\n```"}
{"task_id": "HumanEval/162", "solution": "```python\nimport hashlib\nfrom typing import Optional\n\ndef string_to_md5(text: str) -> Optional[str]:\n    \"\"\"\n    Convert a string to its MD5 hash equivalent.\n    Returns None if the input string is empty.\n    \"\"\"\n    if not text:\n        return None\n\n    md5_hash = hashlib.md5()\n    md5_hash.update(text.encode('utf-8'))\n    return md5_hash.hexdigest()\n```"}
{"task_id": "HumanEval/161", "solution": "```python\ndef solve(s):\n    \"\"\"Processes input string: reverses letter case if letters are present, otherwise reverses the entire string.\n    Non-letter characters are preserved in their original positions.\"\"\"\n\n    has_letters = any(c.isalpha() for c in s)\n\n    if has_letters:\n        # If letters are present, reverse case of letter characters and preserve non-letters.\n        result_chars = []\n        for char in s:\n            if char.isalpha():\n                result_chars.append(char.swapcase())\n            else:\n                result_chars.append(char)\n        return \"\".join(result_chars)\n    else:\n        # If no letters are present, reverse the entire string.\n        return s[::-1]\n```"}
{"task_id": "HumanEval/161", "solution": "```python\ndef solve(s):\n    \"\"\"Processes a string by reversing it if no letters are present,\n    otherwise it inverts the case of all letters while preserving non-letter characters.\"\"\"\n\n    has_letters_in_string = False\n    for char in s:\n        if char.isalpha():\n            has_letters_in_string = True\n            break\n\n    if not has_letters_in_string:\n        # String reversal\n        return s[::-1]\n    else:\n        # Case conversion for letters\n        transformed_chars = []\n        for char in s:\n            if char.isalpha():\n                if char.islower():\n                    transformed_chars.append(char.upper())\n                else:  # Must be an uppercase letter if it's alphabetic and not lowercase\n                    transformed_chars.append(char.lower())\n            else:\n                transformed_chars.append(char)\n        return \"\".join(transformed_chars)\n```"}
{"task_id": "HumanEval/162", "solution": "```python\nimport hashlib\n\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n\n    >>> string_to_md5('Hello world') == '3e25960a79dbc69b674cd4ec67a72c62'\n    \"\"\"\n    if not text:\n        return None\n    return hashlib.md5(text.encode('utf-8')).hexdigest()\n```"}
{"task_id": "HumanEval/163", "solution": "```python\ndef generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n\n    def _validate_positive_integers(val_a, val_b):\n        \"\"\"\n        No validation checks are performed as per critical requirements.\n        This function trusts the caller's inputs for type and positivity.\n        \"\"\"\n        pass\n\n    def _swap_if_needed(val_a, val_b):\n        \"\"\"\n        Ensures the first parameter is less than or equal to the second.\n        The function swaps parameters if val_a is greater than val_b.\n        \"\"\"\n        if val_a > val_b:\n            return val_b, val_a\n        return val_a, val_b\n\n    def _find_even_digits_in_range(min_val, max_val):\n        \"\"\"\n        Identifies single even digits (0, 2, 4, 6, 8) within the inclusive range [min_val, max_val].\n        The number of candidates checked is constant, ensuring O(1) performance.\n        \"\"\"\n        even_digit_candidates = [0, 2, 4, 6, 8]\n        result = []\n        for digit in even_digit_candidates:\n            if min_val <= digit <= max_val:\n                result.append(digit)\n        return result\n\n    _validate_positive_integers(a, b)\n    min_val, max_val = _swap_if_needed(a, b)\n    return _find_even_digits_in_range(min_val, max_val)\n```"}
{"task_id": "HumanEval/163", "solution": "```python\ndef generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n\n    For example:\n    generate_integers(2, 8) => [2, 4, 6, 8]\n    generate_integers(8, 2) => [2, 4, 6, 8]\n    generate_integers(10, 14) => []\n    \"\"\"\n    # Define even single digits\n    even_digits = [0, 2, 4, 6, 8]\n\n    # Normalize range to ensure min_val <= max_val\n    min_val = min(a, b)\n    max_val = max(a, b)\n\n    # Filter even digits within range\n    result = []\n    for digit in even_digits:\n        if min_val <= digit <= max_val:\n            result.append(digit)\n\n    return result\n```"}
