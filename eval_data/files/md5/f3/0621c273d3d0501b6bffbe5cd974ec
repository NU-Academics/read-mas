arse_date_components(date)\n\n    if not _validate_month(month):\n        return False\n\n    if not _validate_day(month, day):\n        return False\n\n    return True\n```"}
{"task_id": "HumanEval/124", "solution": "```python\ndef valid_date(date):\n    \"\"\"Validates a date string against format and business rules.\n    Returns True for valid dates, False otherwise.\n    \"\"\"\n\n    # --- Constants for month-specific day limits ---\n    MONTHS_31_DAYS = {1, 3, 5, 7, 8, 10, 12}\n    MONTHS_30_DAYS = {4, 6, 9, 11}\n    FEBRUARY = 2\n\n    # --- Helper Functions for ValidationLogic ---\n\n    def is_empty_string(date_str):\n        \"\"\"Checks if the input date string is empty.\"\"\"\n        return not date_str\n\n    def has_correct_separators(date_str):\n        \"\"\"Checks for mm-dd-yyyy format with hyphens and correct length.\"\"\"\n        if len(date_str) != 10:\n            return False\n        return date_str[2] == '-' and date_str[5] == '-'\n\n    def parse_date_components(date_str):\n        \"\"\"Attempts to parse month, day, year as integers. Returns (m, d, y) or (None, None, None) on failure.\"\"\"\n        try:\n            parts = date_str.split('-')\n            if len(parts) != 3:\n                return None, None, None\n            month = int(parts[0])\n            day = int(parts[1])\n            year = int(parts[2])\n            return month, day, year\n        except ValueError: # Catches errors if parts cannot be converted to int\n            return None, None, None\n\n    def is_valid_month_range(month_val):\n        \"\"\"Validates if the month is between 1 and 12.\"\"\"\n        return 1 <= month_val <= 12\n\n    def get_max_days_for_month(month_val):\n        \"\"\"Returns the maximum allowed days for a given month.\"\"\"\n        if month_val in MONTHS_31_DAYS:\n            return 31\n        elif month_val in MONTHS_30_DAYS:\n            return 30\n        elif month_val == FEBRUARY:\n            return 29 # February max days as per requirement\n        return 0 # For invalid month values\n\n    def is_valid_day_range(day_val, month_val):\n        \"\"\"Validates if the day is within the range for its month.\"\"\"\n        if day_val <= 0: # Day value zero is explicitly rejected\n            return False\n\n        max_days = get_max_days_for_month(month_val)\n        return 1 <= day_val <= max_days\n\n    # --- Main Orchestration Logic for valid_date ---\n\n    # 1. Check for empty input string\n    if is_empty_string(date):\n        return False\n\n    # 2. Validate format (separators and length)\n    if not has_correct_separators(date):\n        return False\n\n    # 3. Parse date components\n    month, day, year = parse_date_components(date)\n    # If parsing failed, return False\n    if month is None or day is None or year is None:\n        return False\n\n    # 4. Validate month range\n    if not is_valid_month_range(month):\n        return False\n\n    # 5. Validate day range based on month rules\n    if not is_valid_day_range(day, month):\n        return False\n\n    # All validation checks passed\n    return True\n```"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    Examples\n    split_words(\"Hello world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"Hello,world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"abcdef\") == 3\n    '''\n    # Check if string contains whitespace\n    if any(char.isspace() for char in txt):\n        return txt.split()\n\n    # Check if string contains commas\n    elif ',' in txt:\n        return txt.split(',')\n\n    # Count lowercase letters with odd positions in alphabet\n    else:\n        count = 0\n        for char in txt:\n            if 'a' <= char <= 'z':\n                position = ord(char) - ord('a')\n                if position % 2 == 1:  # Odd positions: 1, 3, 5, ..., 25\n                    count += 1\n        return count"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n\n    Examples\n    is_sorted([5]) \u279e True\n    is_sorted([1, 2, 3, 4, 5]) \u279e True\n    is_sorted([1, 3, 2, 4, 5]) \u279e False\n    is_sorted([1, 2, 3, 4, 5, 6]) \u279e True\n    is_sorted([1, 2, 3, 4, 5, 6, 7]) \u279e True\n    is_sorted([1, 3, 2, 4, 5, 6, 7]) \u279e False\n    is_sorted([1, 2, 2, 3, 3, 4]) \u279e True\n    is_sorted([1, 2, 2, 2, 3, 4]) \u279e False\n    '''\n    # Handle empty list or single element\n    if len(lst) <= 1:\n        return True\n\n    # Check if sorted in ascending order\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i + 1]:\n            return False\n\n    # Check duplicate constraint (no more than 1 duplicate allowed)\n    counts = {}\n    for num in lst:\n        counts[num] = counts.get(num, 0) + 1\n        if counts[num] > 2:\n            return False\n\n    return True"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n    '''\n    if len(lst) <= 1:\n        return True\n\n    # Count occurrences of each number\n    counts = {}\n    for num in lst:\n        counts[num] = counts.get(num, 0) + 1\n\n    # Check if any number appears more than twice (more than 1 duplicate)\n    for count in counts.values():\n        if count > 2:\n            return False\n\n    # Check if list is sorted in ascending order\n    for i in range(1, len(lst)):\n        if lst[i] < lst[i-1]:\n            return False\n\n    return True"}
{"task_id": "HumanEval/125", "solution": "```python\ndef split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    Examples\n    split_words(\"Hello world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"Hello,world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"abcdef\") == 3\n    '''\n    # Check for whitespace first\n    if any(c.isspace() for c in txt):\n        return txt.split()\n\n    # Check for commas if no whitespace\n    elif ',' in txt:\n        return txt.split(',')\n\n    # Count lowercase letters at odd alphabet positions\n    else:\n        count = 0\n        for char in txt:\n            if 'a' <= char <= 'z':\n                position = ord(char) - ord('a')\n                if position % 2 != 0:  # odd position (1, 3, 5, ...)\n                    count += 1\n        return count\n```"}
{"task_id": "HumanEval/127", "solution": "```python\ndef intersection(interval1, interval2):\n    \"\"\"You are given two intervals,\n    where each interval is a pair of integers. For example, interval = (start, end) = (1, 2).\n    The given intervals are closed which means that the interval (start, end)\n    includes both start and end.\n    For each given interval, it is assumed that its start is less or equal its end.\n    Your task is to determine whether the length of intersection of these two\n    intervals is a prime number.\n    Example, the intersection of the intervals (1, 3), (2, 4) is (2, 3)\n    which its length is 1, which not a prime number.\n    If the length of the intersection is a prime number, return \"YES\",\n    otherwise, return \"NO\".\n    If the two intervals don't intersect, return \"NO\".\n\n\n    [input/output] samples:\n    intersection((1, 2), (2, 3)) ==> \"NO\"\n    intersection((-1, 1), (0, 4)) ==> \"NO\"\n    intersection((-3, -1), (-5, 5)) ==> \"YES\"\n    \"\"\"\n    def is_prime(n):\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        for i in range(3, int(n**0.5) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\n\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    # Find intersection\n    intersection_start = max(start1, start2)\n    intersection_end = min(end1, end2)\n\n    # Check if intervals intersect\n    if intersection_start > intersection_end:\n        return \"NO\"\n\n    # Calculate length of intersection (inclusive)\n    length = intersection_end - intersection_start + 1\n\n    # Check if length is prime\n    if is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\"\n```"}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    You are given an array arr of integers and you need to return\n    sum of magnitudes of integers multiplied by product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    Note: return None for empty arr.\n\n    Example:\n    >>> prod_signs([1, 2, 2, -4]) == -9\n    >>> prod_signs([0, 1]) == 0\n    >>> prod_signs([]) == None\n    \"\"\"\n    if not arr:\n        return None\n\n    sum_magnitudes = 0\n    product_signs = 1\n\n    for num in arr:\n        sum_magnitudes += abs(num)\n        if num > 0:\n            product_signs *= 1\n        elif num < 0:\n            product_signs *= -1\n        else:\n            product_signs *= 0\n\n    return sum_magnitudes * product_signs"}
{"task_id": "HumanEval/127", "solution": "```python\ndef _is_prime(n: int) -> bool:\n    \"\"\"Checks if a number is prime using an O(\u221an) algorithm.\n    It returns True for prime numbers and False otherwise.\"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n\ndef intersection(interval1: tuple[int, int], interval2: tuple[int, int]) -> str:\n    \"\"\"Determines if the length of the intersection of two closed intervals is a prime number.\n    Returns \"YES\" if the length is prime, \"NO\" otherwise or if intervals don't intersect.\n    \"\"\"\n    s1, e1 = interval1\n    s2, e2 = interval2\n\n    # Calculate the start and end points of the intersection.\n    intersection_start = max(s1, s2)\n    intersection_end = min(e1, e2)\n\n    # If the calculated intersection start is greater than its end, the intervals do not intersect.\n    if intersection_start > intersection_end:\n        return \"NO\"\n\n    # Calculate the length of the intersection for closed intervals.\n    intersection_length = intersection_end - intersection_start + 1\n\n    # Check if this length is a prime number.\n    if _is_prime(intersection_length):\n        return \"YES\"\n    else:\n        return \"NO\"\n```"}
{"task_id": "HumanEval/128", "solution": "```python\ndef prod_signs(arr):\n    \"\"\"\n    You are given an array arr of integers and you need to return\n    sum of magnitudes of integers multiplied by product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    Note: return None for empty arr.\n\n    Example:\n    >>> prod_signs([1, 2, 2, -4]) == -9\n    >>> prod_signs([0, 1]) == 0\n    >>> prod_signs([]) == None\n    \"\"\"\n    if not arr:\n        return None\n\n    magnitude_sum = 0\n    sign_product = 1\n\n    for num in arr:\n        magnitude_sum += abs(num)\n        if num > 0:\n            sign_product *= 1\n        elif num < 0:\n            sign_product *= -1\n        else:  # num == 0\n            return 0\n\n    return magnitude_sum * sign_product\n```"}
{"task_id": "HumanEval/131", "solution": "```python\ndef digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    For example:\n    digits(1)  == 1\n    digits(4)  == 0\n    digits(235) == 15\n    \"\"\"\n    product = 1\n    has_odd_digit = False\n\n    while n > 0:\n        digit = n % 10\n        if digit % 2 != 0:  # digit is odd\n            product *= digit\n            has_odd_digit = True\n        n //= 10\n\n    return product if has_odd_digit else 0\n```"}
{"task_id": "HumanEval/131", "solution": "```python\ndef digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    For example:\n    digits(1)  == 1\n    digits(4)  == 0\n    digits(235) == 15\n    \"\"\"\n    product = 1\n    has_odd = False\n\n    while n > 0:\n        digit = n % 10\n        if digit % 2 != 0:  # Check if digit is odd\n            product *= digit\n            has_odd = True\n        n //= 10\n\n    return product if has_odd else 0\n```"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Generates the Tribonacci sequence up to n.\"\"\"\n    if n < 0:\n        return []\n\n    # Initialize cache with base cases\n    cache = {}\n\n    def compute_tri(i):\n        if i in cache:\n            return cache[i]\n\n        if i == 0:\n            value = 1\n        elif i == 1:\n            value = 3\n        elif i % 2 == 0:  # even\n            value = 1 + i // 2\n        else:  # odd\n            value = compute_tri(i - 1) + compute_tri(i - 2) + compute_tri(i + 1)\n\n        cache[i] = value\n        return value\n\n    result = []\n    for i in range(n + 1):\n        result.append(compute_tri(i))\n\n    return result"}
