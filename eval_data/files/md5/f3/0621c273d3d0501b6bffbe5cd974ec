{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Orchestrates finding the strongest extension and formats the final result string.\"\"\"\n\n    def _count_uppercase(text: str) -> int:\n        \"\"\"Counts uppercase alphabetic characters in a string.\"\"\"\n        count = 0\n        for char in text:\n            if 'A' <= char <= 'Z':  # Check for uppercase English letters\n                count += 1\n        return count\n\n    def _count_lowercase(text: str) -> int:\n        \"\"\"Counts lowercase alphabetic characters in a string.\"\"\"\n        count = 0\n        for char in text:\n            if 'a' <= char <= 'z':  # Check for lowercase English letters\n                count += 1\n        return count\n\n    def _calculate_strength(extension: str) -> int:\n        \"\"\"Calculates strength as uppercase count minus lowercase count.\"\"\"\n        uppercase_count = _count_uppercase(extension)\n        lowercase_count = _count_lowercase(extension)\n        return uppercase_count - lowercase_count\n\n    def _find_strongest_extension(extensions: list[str]) -> str:\n        \"\"\"Identifies the strongest extension, favoring the first occurrence in ties.\"\"\"\n        if not extensions:\n            return \"\"  # Return empty string if no extensions provided\n\n        max_strength = float('-inf')\n        strongest_ext_name = \"\"\n\n        for extension in extensions:\n            current_strength = _calculate_strength(extension)\n            if current_strength > max_strength:\n                max_strength = current_strength\n                strongest_ext_name = extension\n            # Tie-breaking: if current_strength == max_strength, keep the first occurrence\n        return strongest_ext_name\n\n    def _format_result(class_name: str, extension: str) -> str:\n        \"\"\"Formats the result string as 'ClassName.StrongestExtensionName'.\"\"\"\n        return f\"{class_name}.{extension}\"\n\n    strongest_extension_name = _find_strongest_extension(extensions)\n    return _format_result(class_name, strongest_extension_name)"}
{"task_id": "HumanEval/152", "solution": "```python\ndef compare(game, guess):\n    \"\"\"Calculates absolute differences between corresponding elements of two arrays.\n    Returns 0 for exact matches and absolute difference for non-matches.\"\"\"\n\n    result = []\n\n    for i in range(len(game)):\n        game_score = game[i]\n        guess_score = guess[i]\n\n        if game_score == guess_score:\n            result.append(0)\n        else:\n            diff = abs(game_score - guess_score)\n            result.append(diff)\n\n    return result\n```"}
{"task_id": "HumanEval/153", "solution": "```python\ndef Strongest_Extension(class_name, extensions):\n    \"\"\"\n    Analyzes extension names and selects the strongest one based on a character-counting algorithm.\n    The strength is CAP - SM, where CAP is uppercase count and SM is lowercase count.\n    \"\"\"\n\n    def count_uppercase(text):\n        \"\"\"Counts uppercase letters in a string.\"\"\"\n        return sum(1 for char in text if 'A' <= char <= 'Z')\n\n    def count_lowercase(text):\n        \"\"\"Counts lowercase letters in a string.\"\"\"\n        return sum(1 for char in text if 'a' <= char <= 'z')\n\n    def calculate_strength(extension):\n        \"\"\"Calculates the strength of an extension.\"\"\"\n        cap = count_uppercase(extension)\n        sm = count_lowercase(extension)\n        return cap - sm\n\n    def format_result(class_name_str, extension_name_str):\n        \"\"\"Formats the final result string.\"\"\"\n        return f\"{class_name_str}.{extension_name_str}\"\n\n    max_strength = -float('inf')\n    strongest_extension_name = \"\"\n\n    for extension in extensions:\n        current_strength = calculate_strength(extension)\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = extension\n\n    return format_result(class_name, strongest_extension_name)\n```"}
