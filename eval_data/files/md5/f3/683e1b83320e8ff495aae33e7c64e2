ate objects, providing sorted access.\"\"\"\n    def __init__(self):\n        self._coordinates: List[Coordinate] = []\n\n    def add_coordinate(self, coordinate: Coordinate):\n        \"\"\"Adds a Coordinate object to the list.\"\"\"\n        self._coordinates.append(coordinate)\n\n    def get_sorted_coordinates(self) -> List[List[int]]:\n        \"\"\"Returns the stored coordinates as a sorted list of [x, y] lists.\"\"\"\n        self._coordinates.sort() # Sorts in-place using the __lt__ method of Coordinate\n        return [coord.to_list() for coord in self._coordinates]\ndef get_coordinates(center_coordinate: Tuple[int, int]) -> List[List[int]]:\n    \"\"\"\n    Extracts all adjacent coordinates (3x3 grid including center) for a given coordinate.\n    The returned list is sorted primarily by x-coordinate and secondarily by y-coordinate.\n    \"\"\"\n    if not isinstance(center_coordinate, tuple) or len(center_coordinate) != 2 or \\\n       not all(isinstance(c, int) for c in center_coordinate):\n        raise TypeError(\"Input must be a tuple (x, y) where x and y are integers.\")\n\n    center_x, center_y = center_coordinate\n    coordinate_list = CoordinateList()\n\n    for x_offset in [-1, 0, 1]:\n        for y_offset in [-1, 0, 1]:\n            new_x = center_x + x_offset\n            new_y = center_y + y_offset\n            coordinate_list.add_coordinate(Coordinate(new_x, new_y))\n\n    return coordinate_list.get_sorted_coordinates()", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[1, 1, 1]]]}], "Mbpp/723": [{"task_id": "Mbpp/723", "solution": "def count_same_pair(list1: list, list2: list) -> int:\n    \"\"\"\n    Counts indices where elements in two lists have the same values.\n    Assumes lists are of the same length and contain comparable values.\n    \"\"\"\n    count = 0\n    for i in range(len(list1)):\n        if list1[i] == list2[i]:\n            count += 1\n    return count", "base_status": "pass", "plus_