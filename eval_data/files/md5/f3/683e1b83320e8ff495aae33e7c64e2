t, int] | None:\n    \"\"\"\n    Finds integer solutions (x, y) for the linear Diophantine equation ax + by = n.\n    Returns (x, y) if a solution exists, or None otherwise.\n    \"\"\"\n\n    def _gcd(x: int, y: int) -> int:\n        \"\"\"Calculates the greatest common divisor (GCD) of two integers.\"\"\"\n        while y:\n            x, y = y, x % y\n        return x\n\n    def _extended_gcd(x: int, y: int) -> tuple[int, int, int]:\n        \"\"\"\n        Implements the Extended Euclidean Algorithm to find GCD and coefficients x, y\n        such that ax + by = gcd(a, b). Returns (gcd, x, y).\n        \"\"\"\n        if x == 0:\n            return y, 0, 1\n        gcd, x1, y1 = _extended_gcd(y % x, x)\n        x_val = y1 - (y // x) * x1\n        y_val = x1\n        return gcd, x_val, y_val\n\n    g = _gcd(abs(a), abs(b))\n\n    if n % g != 0:\n        return None\n\n    # Reduce the equation: (a/g)x + (b/g)y = (n/g)\n    a_prime = a // g\n    b_prime = b // g\n    n_prime = n // g\n\n    # Find x0, y0 such that a_prime*x0 + b_prime*y0 = gcd(a_prime, b_prime) which is 1\n    # since a_prime and b_prime are coprime.\n    gcd_prime, x0, y0 = _extended_gcd(a_prime, b_prime)\n\n    # The particular solution for the original equation ax + by = n is\n    # x = x0 * (n/g) and y = y0 * (n/g)\n    x = x0 * n_prime\n    y = y0 * n_prime\n\n    return (x, y)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[2, 3, 7]], "plus_fail_tests": [[25, 10, 500]]}], "Mbpp/139": [{"task_id": "Mbpp/139", "solution": "import math\ndef circle_circumference(radius: float) -> float:\n    \"\"\"\n    Calculates the circumference of a circle.\n    It uses the formula C = 2 * pi * r.\n    \"\"\"\n    return 2 * math.pi * radius", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/138": [{"task_id": "Mbpp/138", "solution": "def is_Sum_Of_Powers_Of_Two(number: int) -> bool:\n    \"\"\"Checks if the given number can be represente