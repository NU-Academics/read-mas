_digits = 1\n            else:\n                self._num_digits = int(math.log10(self._value)) + 1\n        return self._num_digits\n\n    def calculate_sum_of_powers_of_digits(self) -> int:\n        \"\"\"Calculates the sum of each digit raised to the power of the total number of digits.\"\"\"\n        num_digits = self.get_number_of_digits()\n        digits = self.get_digits()\n        total_sum = 0\n        for digit in digits:\n            total_sum += digit ** num_digits\n        return total_sum\n\n    def is_armstrong(self) -> bool:\n        \"\"\"Determines if the number is an Armstrong number.\"\"\"\n        return self._value == self.calculate_sum_of_powers_of_digits()\ndef armstrong_number(num: int) -> bool:\n    \"\"\"Checks if a given number is an Armstrong number.\"\"\"\n    if num < 0:\n        return False\n\n    number_obj = Number(num)\n    return number_obj.is_armstrong()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/239": [{"task_id": "Mbpp/239", "solution": "def _count_sequences_recursive(m: int, n: int, current_length: int, last_element: int) -> int:\n    \"\"\"\n    Recursively counts the number of valid sequences.\n    If the current sequence has reached the desired length n, one valid sequence has been found.\n    \"\"\"\n    if current_length == n:\n        return 1\n\n    count = 0\n    # Iterate through possible next elements for the sequence.\n    # A next element must be at least twice the last_element and not exceed m.\n    for next_element in range(2 * last_element, m + 1):\n        # Recursively find sequences extending from this next_element.\n        count += _count_sequences_recursive(m, n, current_length + 1, next_element)\n    return count\ndef get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Calculates the total number of possible sequences of length n,\n    where each element is a positive integer, >= twice the previous, and <= m.\n    \"\"\"\n    t