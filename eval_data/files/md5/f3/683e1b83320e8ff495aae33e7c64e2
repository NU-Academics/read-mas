: int, cost: int):\n        self.row = row\n        self.col = col\n        self.cost = cost\ndef maxAverageOfPath(matrix: List[List[int]]) -> float:\n    N = len(matrix)\n\n    # Convert the input matrix of integers into a grid of Cell objects.\n    cell_grid: List[List[Cell]] = []\n    for r in range(N):\n        row_cells = []\n        for c in range(N):\n            row_cells.append(Cell(r, c, matrix[r][c]))\n        cell_grid.append(row_cells)\n\n    # Use a list to store the maximum average found, enabling updates across recursive calls.\n    # Initialize with negative infinity to correctly handle cases with negative costs.\n    max_avg_ref: List[float] = [float('-inf')]\n\n    # Start the Depth-First Search from the top-left cell (0,0).\n    # Initial path sum and count are 0, as the _dfs function adds the current cell's value.\n    _dfs(0, 0, 0, 0, N, cell_grid, max_avg_ref)\n\n    return max_avg_ref[0]\ndef _dfs(r: int, c: int, current_path_sum: int, current_path_count: int, N: int, cell_grid: List[List[Cell]], max_avg_ref: List[float]) -> None:\n    # Add the current cell's cost and increment the path count.\n    path_sum_including_current = current_path_sum + cell_grid[r][c].cost\n    path_count_including_current = current_path_count + 1\n\n    # Base case: If the bottom-right cell is reached.\n    if r == N - 1 and c == N - 1:\n        if path_count_including_current > 0:\n            current_average = float(path_sum_including_current) / path_count_including_current\n            max_avg_ref[0] = max(max_avg_ref[0], current_average)\n        return\n\n    # Recursive step: Explore valid moves (right and down).\n    # Move right if within bounds.\n    if c + 1 < N:\n        _dfs(r, c + 1, path_sum_including_current, path_count_including_current, N, cell_grid, max_avg_ref)\n\n    # Move down if within bounds.\n    if r + 1 < N:\n        _dfs(r + 1, c, path_sum_including_current, path_count_including_current, N, cell_grid, max_avg_ref)", "base_status": "pass