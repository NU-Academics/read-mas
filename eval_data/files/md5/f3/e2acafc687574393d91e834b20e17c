{"task_id": "HumanEval/3", "solution": "```python\nimport uvicorn\nfrom fastapi import FastAPI, HTTPException\nfrom pydantic import BaseModel, conlist\nfrom typing import List\n\n# ----------------------------------------------------------------------------\n# 3.2 & 4.3: System Components & Data Models\n# ----------------------------------------------------------------------------\n\n# Data Model for the request body, ensures 'operations' is a list of integers.\nclass TransactionRequest(BaseModel):\n    operations: List[int]\n\n# Data Model for the success response body.\nclass OverdraftResponse(BaseModel):\n    overdraft_detected: bool\n\n# ----------------------------------------------------------------------------\n# 3.2 & 4.2: Core Logic Processor\n# ----------------------------------------------------------------------------\n\ndef has_overdraft(transactions: List[int]) -> bool:\n    \"\"\"\n    Processes a list of transactions to determine if the balance ever goes negative.\n\n    Args:\n        transactions: A list of integers representing deposits (positive) and\n                      withdrawals (negative).\n\n    Returns:\n        True if the balance drops below zero at any point, False otherwise.\n    \"\"\"\n    current_balance = 0\n    for transaction in transactions:\n        current_balance += transaction\n        if current_balance < 0:\n            return True\n    return False\n\n# ----------------------------------------------------------------------------\n# 3.2 & 4.1: API Interface (Controller/View Layer)\n# ----------------------------------------------------------------------------\n\napp = FastAPI(\n    title=\"Account Balance Monitor\",\n    description=\"A service to detect overdraft conditions in a series of financial transactions.\",\n    version=\"1.0\",\n)\n\n@app.post(\n    \"/v1/balance/check-overdraft\",\n    response_model=OverdraftResponse,\n    summary=\"Check for Overdraft\",\n    tags=[\"Balance\"],\n    responses={\n        200: {\n            \"description\": \"Request processed successfully.\",\n            \"content\": {\n                \"application/json\": {\n                    \"examples\": {\n                        \"Overdraft Detected\": {\n                            \"summary\": \"An example where an overdraft occurs.\",\n                            \"value\": {\"overdraft_detected\": True}\n                        },\n                        \"No Overdraft\": {\n                            \"summary\": \"An example where no overdraft occurs.\",\n                            \"value\": {\"overdraft_detected\": False}\n                        }\n                    }\n                }\n            }\n        },\n        422: {\n            \"description\": \"Validation Error (e.g., malformed request, non-integer values).\",\n            \"content\": {\n                \"application/json\": {\n                    \"example\": {\n                        \"detail\": [\n                            {\n                                \"loc\": [\"body\", \"operations\", 1],\n                                \"msg\": \"value is not a valid integer\",\n                                \"type\": \"type_error.integer\"\n                            }\n                        ]\n                    }\n                }\n            }\n        }\n    }\n)\ndef check_overdraft_endpoint(request: TransactionRequest) -> OverdraftResponse:\n    \"\"\"\n    Accepts a list of transactions and checks for an overdraft condition.\n\n    - **operations**: A list of integers representing financial transactions.\n      Positive values are deposits, negative values are withdrawals.\n    \"\"\"\n    # The Pydantic model `TransactionRequest` automatically validates the input.\n    # If the input is invalid (e.g., not a list of integers), FastAPI will\n    # automatically return a 422 Unprocessable Entity response, which is more\n    # specific than the 400 Bad Request suggested in the design but serves the\n    # same purpose of rejecting invalid client data.\n\n    # Delegate the business logic to the core processor.\n    overdraft_status = has_overdraft(request.operations)\n\n    # Format the response according to the specification.\n    return OverdraftResponse(overdraft_detected=overdraft_status)\n\n# To run this application:\n# 1. Save the code as a file (e.g., `main.py`).\n# 2. Install the required libraries: `pip install fastapi uvicorn`\n# 3. Run the server from your terminal: `uvicorn main:app --reload`\n# 4. The API will be available at http://127.0.0.1:8000\n# 5. Interactive documentation will be at http://127.0.0.1:8000/docs\n```"}
