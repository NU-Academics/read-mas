s the character length of the encapsulated string.\"\"\"\n        return len(self.value)\n\n    def isEmpty(self) -> bool:\n        \"\"\"Checks if the encapsulated string is empty.\"\"\"\n        return self.length() == 0\nclass OutputString:\n    \"\"\"Wrapper for the resulting string after whitespace removal.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\nclass RemoveAllSpaces:\n    \"\"\"Encapsulates the core logic for removing specified whitespace characters.\"\"\"\n    def __init__(self):\n        # Defines the minimum set of whitespace characters to be removed.\n        self._whitespace_chars = [' ', '\\t', '\\n', '\\r', '\\f']\n\n    def remove(self, input_str: str) -> str:\n        \"\"\"Processes the input string to remove all defined whitespace characters.\"\"\"\n        cleaned_chars = []\n        for char in input_str:\n            if char not in self._whitespace_chars:\n                cleaned_chars.append(char)\n        return \"\".join(cleaned_chars)\ndef remove_all_spaces(input: str) -> str:\n    \"\"\"\n    Removes all defined whitespace characters from the input string,\n    preserving the order of non-whitespace characters.\n    \"\"\"\n    input_wrapper = InputString(input)\n    \n    remover = RemoveAllSpaces()\n    # The actual removal logic operates on the raw string value from the wrapper.\n    cleaned_value = remover.remove(input_wrapper.value)\n    \n    output_wrapper = OutputString(cleaned_value)\n    return output_wrapper.value", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["python\nprogram"]]}, {"task_id": "Mbpp/800", "solution": "from src.remove_all_spaces import remove_all_spaces", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/799": [{"task_id": "Mbpp/799", "solution": "MASK = 0xFFFFFFFF\nclass InputValue:\n    \"\"\"Encapsulates a raw input value and provides its 32-bit representation.\"\"\"\n    def __init__(self, raw_value: int):\n        self.raw_value = raw_value\n\n    def as32(self) -> int:\n        \"\"\"Returns the raw value masked to 32 bits.\"\"\"\n        return self.raw_value & MASK\nclass RotationParameter:\n    \"\"\"Encapsulates the rotation parameter and normalizes it.\"\"\"\n    def __init__(self, d: int):\n        self.d = d\n\n    def normalizedD(self) -> int:\n        \"\"\"Returns the rotation parameter normalized to the range 0..31.\"\"\"\n        return self.d % 32\nclass BitMask:\n    \"\"\"Provides the 32-bit mask constant and applies it.\"\"\"\n    MASK = MASK # Refers to the module-level MASK\n\n    @staticmethod\n    def apply(v: int) -> int:\n        \"\"\"Applies the 32-bit mask to a given integer.\"\"\"\n        return v & BitMask.MASK\nclass Result:\n    \"\"\"Container for a 32-bit rotated value, ensuring it is masked on construction.\"\"\"\n    def __init__(self, initial_value: int):\n        self.value = BitMask.apply(initial_value)\ndef left_rotate(value: int, d: int) -> int:\n    \"\"\"Performs a 32-bit circular left rotation of 'value' by 'd' bits.\"\"\"\n    value32 = InputValue(value).as32()\n    d_mod = RotationParameter(d).normalizedD()\n\n    # Handle d_mod == 0 explicitly for Python's right shift behavior with 0\n    if d_mod == 0:\n        rotated = value32\n    else:\n        rotated = ((value32 << d_mod) | (value32 >> (32 - d_mod)))\n    \n    masked_result = BitMask.apply(rotated)\n    return Result(masked_result).value", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/799", "solution": "MASK = 0xFFFFFFFF\ndef _normalize_d(d: int) -> int:\n    \"\"\"Normalizes the rotation distance to be within 0-31.\"\"\"\n    return d % 32\ndef _rol(value: int, d: int) -> int:\n    \"\"\"Performs a raw 32-bit circular left shift.\"\"\"\n    return ((value << d) | (value >> (32 - d)))\ndef left_rotate(number: int, d: int) -> int:\n    \"\"\"\n    Performs a 32-bit circular left rotation on 'number' by 'd' bits.\n    The result is always masked to ensure it fits within 32 bits.\n    \"\"\"\n    effective_d = _normalize_d(d)\n    number_masked = number & MASK\n\n    if effective_d == 0:\n        return number_masked\n\n    raw_result = _rol(number_masked, effective_d)\n    result = raw_result & MASK\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/801": [{"task_id": "Mbpp/801", "solution": "def test_three_equal(a, b, c) -> int:\n    \"\"\"\n    Counts how many of the three integer inputs are equal.\n    Returns 3 if all three are equal, 2 if exactly two are equal, and 0 if all are distinct.\n    \"\"\"\n    validate_inputs(a, b, c) # Calls input validation, which is a no-op under current constraints.\n\n    if a == b and b == c:\n        return 3\n    elif a == b or a == c or b == c:\n        return 2\n    else:\n        return 0", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[1, 1, 1]], "plus_fail_tests": [[1, 2, 3]]}, {"task_id": "Mbpp/801", "solution": "def test_three_equal(a, b, c):\n    \"\"\"Counts the number of equal integers among three inputs.\n    Returns 3 if all are equal, 2 if exactly two are equal, and 0 if all are distinct.\n    \"\"\"\n    distinct_count = len({a, b, c})\n    if distinct_count == 1:\n        return 3\n    elif distinct_count == 2:\n        return 2\n    else:  # distinct_count == 3\n        return 0", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/797": [{"task_id": "Mbpp/797", "solution": "def sum_in_range(l, r) -> int:\n    \"\"\"Calculates the sum of all odd natural numbers within the inclusive range [l, r].\n    Assumes valid integer inputs for l and r.\n    \"\"\"\n    total_sum = 0\n    for num in range(l, r + 1):\n        if num >= 1 and num % 2 == 1:\n            total_sum += num\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/797", "solution": "import typing\nclass Range:\n    def __init__(self, l: int, r: int):\n        self.l = l\n        self.r = r\n\n    def is_valid(self) -> bool:\n        \"\"\"Returns True if the lower bound is less than or equal to the upper bound.\n        Assumes l and r are integers as per type hints.\"\"\"\n        return self.l <= self.r\n\n    def iterate(self) -> typing.Iterable[int]:\n        \"\"\"Yields each integer in the inclusive range [l, r] if valid.\"\"\"\n        if self.is_valid():\n            for x in range(self.l, self.r + 1):\n                yield x\nclass Number:\n    def __init__(self, value: int):\n        self.value = value\n\n    def is_natural(self) -> bool:\n        \"\"\"Returns True if the number is a natural number (>= 1).\"\"\"\n        return self.value >= 1\n\n    def is_odd(self) -> bool:\n        \"\"\"Returns True if the number is odd.\"\"\"\n        return self.value % 2 == 1\nclass Result:\n    def __init__(self):\n        self.total = 0\n\n    def add(self, n: Number) -> None:\n        \"\"\"Adds the Number's value to the total.\"\"\"\n        self.total += n.value\n\n    def value(self) -> int:\n        \"\"\"Returns the accumulated total.\"\"\"\n        return self.total\ndef sum_in_range(l: int, r: int) -> int:\n    \"\"\"Computes the sum of all odd natural numbers within the inclusive range [l, r].\n    Returns 0 if the range is invalid or no such numbers exist.\"\"\"\n    current_range = Range(l, r)\n    if not current_range.is_valid():\n        return 0\n\n    result = Result()\n    for x in current_range.iterate():\n        num = Number(x)\n        if num.is_natural() and num.is_odd():\n            result.add(num)\n    return result.value()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/803": [{"task_id": "Mbpp/803", "solution": "class Number:\n    \"\"\"Container for an input numeric value.\"\"\"\n    def __init__(self, value):\n        self.value = value\nclass Result:\n    \"\"\"Container for evaluation result.\"\"\"\n    def __init__(self, isPerfectSquare: bool):\n        self.isPerfectSquare = isPerfectSquare\nclass PerfectSquareChecker:\n    \"\"\"Stateless domain class encapsulating the perfect square check.\n    Implements BR3: a number n is a perfect square iff there exists an integer m such that m * m == n.\n    \"\"\"\n    def is_perfect_square(self, n) -> bool:\n        \"\"\"Return True iff there exists integer m such that m * m == n (BR3).\"\"\"\n        if n < 0:\n            result = Result(False)\n            return result.isPerfectSquare\n\n        # Calculate the square root.\n        sqrt_n = n**0.5\n        \n        # Check if sqrt_n is an integer.\n        is_square = (sqrt_n == int(sqrt_n))\n        \n        result = Result(is_square)\n        return result.isPerfectSquare\ndef is_perfect_square(n) -> bool:\n    \"\"\"\n    Public API that returns True when n is a perfect square per BR3 and False otherwise (satisfies FR1).\n    Delegates to PerfectSquareChecker for the core logic as per design.\n    \"\"\"\n    # Construct Number object for domain representation as per sequence diagram.\n    _ = Number(n) \n    \n    # Delegate the actual check to an instance of PerfectSquareChecker.\n    checker = PerfectSquareChecker()\n    return checker.is_perfect_square(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/803", "solution": "from .domain import Number, Result\nclass PerfectSquareChecker:\n    \"\"\"Performs integer-safe validation and computation for perfect squares.\"\"\"\n\n    @staticmethod\n    def _integer_sqrt_floor(n: int) -> int:\n        \"\"\"Computes floor(sqrt(n)) using integer-only binary search.\n        Handles non-negative inputs as expected by its caller.\n        \"\"\"\n        if n < 0:\n            return 0 # Should not be reached if called correctly from is_perfect_square.\n        if n == 0:\n            return 0\n        \n        low = 1\n        high = n\n        ans = 0\n        \n        while low <= high:\n            mid = (low + high) // 2\n            if mid * mid == n:\n                return mid\n            elif mid * mid < n:\n                ans = mid\n                low = mid + 1\n            else:\n                high = mid - 1\n        return ans\n\n    @staticmethod\n    def is_perfect_square(n: int) -> bool:\n        \"\"\"Return True iff there exists integer m >= 0 such that m*m == n.\"\"\"\n        # BR1: Precondition: input n must be an integer.\n        if not isinstance(n, int):\n            raise TypeError(\"Input must be an integer.\")\n\n        # BR6: Negative values cannot be perfect squares (m >= 0).\n        if n < 0:\n            return False\n\n        # BR5: 0 is a perfect square (0 * 0 = 0).\n        if n == 0:\n            return True\n        \n        # Reflect input as a domain Number object.\n        _ = Number(n)\n\n        # Compute integer square root candidate using integer-only arithmetic.\n        m_candidate = PerfectSquareChecker._integer_sqrt_floor(n)\n\n        # Check if the square of the candidate equals n.\n        is_perfect = (m_candidate * m_candidate == n)\n\n        # Reflect outcome as a domain Result object.\n        _ = Result(is_perfect=is_perfect)\n\n        return is_perfect\ndef is_perfect_square(n: int) -> bool:\n    \"\"\"Public API function that delegates to PerfectSquareChecker.is_perfect_square.\"\"\"\n    return PerfectSquareChecker.is_perfect_square(n)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/804": [{"task_id": "Mbpp/804", "solution": "from typing import List\ndef is_product_even(integers: List[int]) -> bool:\n    \"\"\"\n    Determines if the product of numbers in a list is even.\n    The product is even if at least one integer in the input list is even.\n    \"\"\"\n    for number