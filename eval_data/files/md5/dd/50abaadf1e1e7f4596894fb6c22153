e.fullmatch(r'-?\\d+', token):\n                raise ValueError(f\"Invalid integer token '{token}' in tuple content.\")\n            try:\n                parsed_values.append(int(token))\n            except ValueError:\n                raise ValueError(f\"Could not convert token '{token}' to integer.\")\n        return parsed_values\ndef tuple_str_int(input: str) -> tuple[int, ...]:\n    \"\"\"\n    Public API entrypoint: parses an input string in canonical tuple form\n    \"(n1, n2, ...)\" into a tuple of integers.\n    \"\"\"\n    parser = TupleParser()\n    integer_tuple = parser.tuple_str_int(input)\n    return integer_tuple.values", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["((7, 8, 9)"]]}], "Mbpp/787": [{"task_id": "Mbpp/787", "solution": "def text_match_three(input: str) -> bool:\n    \"\"\"Checks if the input string contains the literal substring 'abbb'.\"\"\"\n    return \"abbb\" in input", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/787", "solution": "from src.domain import TextInput, MatchPattern, MatchResult\ndef text_match_three(text: str) -> bool:\n    \"\"\"\n    Checks if the input string contains the contiguous substring \"abbb\".\n    Returns True if found, False otherwise.\n    \"\"\"\n    text_input = TextInput(text)\n    match_pattern = MatchPattern()\n\n    # Short inputs cannot contain the pattern \"abbb\".\n    if text_input.length < len(match_pattern.pattern):\n        match_result = MatchResult(matched=False)\n    else:\n        # Scan the input string for the literal contiguous pattern.\n        found = match_pattern.pattern in text_input.value\n        match_result = MatchResult(matched=found)\n    \n    return match_result.matched", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/786": [{"task_id": "Mbpp/786", "solution": "from typing import List\ndef _binary_search_right