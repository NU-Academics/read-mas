    \"\"\"Extracts unique numeric values from the list.\n    Uses Python's set semantics for uniqueness.\"\"\"\n    return set(values)\ndef compute_product(values: Set[Number]) -> Number:\n    \"\"\"Computes the product of unique numeric values.\n    Returns 1 if the set of values is empty (multiplicative identity).\"\"\"\n    if not values:\n        return 1\n    product: Number = 1\n    for num in values:\n        product *= num\n    return product\ndef unique_product(values: List[Number]) -> Number:\n    \"\"\"Computes the product of unique numeric values in a list.\n    Orchestrates input validation, unique extraction, and product computation.\"\"\"\n    validate_input(values)\n    unique_values = extract_unique(values)\n    result = compute_product(unique_values)\n    return result", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[10, 20, 30, 40, 20, 50, 60, 40]]], "plus_fail_tests": [[[1000000, 2000000, 3000000, 2000000, 4000000, 5000000]]]}, {"task_id": "Mbpp/573", "solution": "class InputList:\n    \"\"\"Encapsulates caller-supplied list, storing a shallow copy.\"\"\"\n    def __init__(self, values: list) -> None:\n        self.values: list = list(values)\nclass NumericValue:\n    \"\"\"Represents an input element and provides normalization.\"\"\"\n    def __init__(self, raw_value) -> None:\n        self.raw_value = raw_value\n        self.normalized_value: float = self.normalize()\n\n    def normalize(self) -> float:\n        \"\"\"Converts the raw value to a canonical float key.\"\"\"\n        return float(self.raw_value)\nclass UniqueValueSet:\n    \"\"\"Maintains a set of normalized numeric values.\"\"\"\n    def __init__(self) -> None:\n        self.values: set[float] = set()\n\n    def add(self, nv: NumericValue) -> None:\n        \"\"\"Adds a normalized numeric value to the set.\"\"\"\n        self.values.add(nv.normalized_value)\n\n    def contains(self, nv: NumericValue) -> bool:\n        \"\"\"Checks if a normalized numeric value is in the set.\"\"\"\n        return nv.normalized_value in self.values\n\n    def __iter__(self) -> 'Iterator[float]': # Forward reference for Iterator\n        \"\"\"Allows iteration over the unique normalized values.\"\"\"\n        return iter(self.values)\nclass ProductResult:\n    \"\"\"Holds the computed product and presents it in an appropriate type.\"\"\"\n    def __init__(self, value: float) -> None:\n        self.value: float = value\n\n    def as_int_or_float(self) -> float | int:\n        \"\"\"Returns the product as an int if integral, otherwise as a float.\"\"\"\n        if self.value == int(self.value):\n            return int(self.value)\n        return self.value\ndef unique_product(values: list) -> float | int:\n    \"\"\"\n    Computes the product of unique numeric values in a list.\n    Handles duplicates, mixed types, and returns 1 for an empty list.\n    \"\"\"\n    input_list = InputList(values)\n    unique_set = UniqueValueSet()\n\n    for raw_value in input_list.values:\n        num_val = NumericValue(raw_value)\n        unique_set.add(num_val)\n\n    if not unique_set.values:\n        return 1\n\n    product = 1.0\n    for val in unique_set:\n        product *= val\n\n    result = ProductResult(product)\n    return result.as_int_or_float()", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[1000000, 2000000, 3000000, 2000000, 4000000, 5000000]]]}], "Mbpp/577": [{"task_id": "Mbpp/577", "solution": "def computeFactorial(n: int) -> int:\n    \"\"\"Return factorial n! as Python int. Precondition: n is int and n >= 0.\"\"\"\n    if n == 0:\n        return 1\n    result = 1\n    for i in range(1, n + 1):\n        result *= i\n    return result\ndef extractLastDigit(factorial: int) -> int:\n    \"\"\"Return factorial % 10 as int (0..9). Precondition: factorial is int >= 0.\"\"\"\n    return factorial % 10\ndef last_Digit_Factorial(n) -> int:\n    \"\"\"Validate n and return last decimal digit (0..9) of n!. Raises TypeError for non-int, ValueError for negative.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    # Mathematical shortcut: for n >= 5, n! will always end in 0.\n    if n >= 5:\n        return 0\n\n    factorial_value = computeFactorial(n)\n    return extractLastDigit(factorial_value)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[2.5]]}, {"task_id": "Mbpp/577", "solution": "_SMALL_LAST_DIGITS = {0: 1, 1: 1, 2: 2, 3: 6, 4: 4}\ndef last_Digit_Factorial(n):\n    \"\"\"Computes the last decimal digit of n! for a non-negative integer n.\n    For n >= 5, the result is 0, otherwise it's looked up from a precomputed table.\n    \"\"\"\n    if n in _SMALL_LAST_DIGITS:\n        return _SMALL_LAST_DIGITS[n]\n    return 0", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[1.5869584267664152]]}], "Mbpp/576": [{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(source: list, candidate: list) -> bool:\n    \"\"\"Return True iff candidate appears as a contiguous subsequence within source.\n    Uses Python equality (==) for comparisons and does not modify inputs.\"\"\"\n    if len(candidate) == 0:\n        return True\n    if len(candidate) > len(source):\n        return False\n\n    max_start_index = len(source) - len(candidate)\n    for i in range(max_start_index + 1):\n        # Check if the slice source[i : i + len(candidate)] matches candidate\n        match = True\n        for j in range(len(candidate)):\n            if not (source[i + j] == candidate[j]):\n                match = False\n                break\n        if match:\n            return True\n    return False", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[1, 2, 3, 4, 5], [1, 3, 5]]]}, {"task_id": "Mbpp/576", "solution": "def is_Sub_Array(main_list, sub_list):\n    \"\"\"Checks if sub_list is a contiguous subsequence (subarray) of main_list.\n    Elements are compared using Python's == equality semantics.\"\"\"\n\n    # If sub_list is empty, it is considered a subarray of any list.\n    if not sub_list:\n        return True\n\n    # If sub_list is longer than main_list, it cannot be a subarray.\n    if len(sub_list) > len(main_list):\n        return False\n\n    n = len(main_list)\n    m = len(sub_list)\n\n    # Iterate through main_list with a sliding window of size m (length of sub_list).\n    for i in range(n - m + 1):\n        # Compare the current slice of main_list with sub_list.\n        # This operation creates a new slice and does not modify main_list.\n        if main_list[i : i + m] == sub_list:\n            return True\n\n    # If no match is found after checking all possible windows, sub_list is not a subarray.\n    return False", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[1, 2, 3, 4, 5], [1, 3, 5]]]}], "Mbpp/579": [{"task_id": "Mbpp/579", "solution": "def find_dissimilar(a: tuple, b: tuple) -> tuple:\n    \"\"\"Returns a tuple containing elements present in exactly one of the two input tuples, preserving order.\"\"\"\n    \n    # Compute the set of elements common to both tuples.\n    shared_elements = set(a) & set(b)\n    \n    result_list = []\n    \n    # Add qualifying elements from tuple 'a' in their original order.\n    for item in a:\n        if item not in shared_elements:\n            result_list.append(item)\n            \n    # Add qualifying elements from tuple 'b' in their original order.\n    for item in b:\n        if item not in shared_elements:\n            result_list.append(item)\n            \n    return tuple(result_list)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/579", "solution": "import collections.abc\nfrom typing import Any, List, TypeVar, Tuple\n_T = TypeVar('_T')\nclass Validator:\n    \"\"\"Validates that given objects are tuples.\"\"\"\n    def validate_is_tuple(self, obj: Any) -> None:\n        \"\"\"Raises TypeError if obj is not an tuple.\"\"\"\n        if not isinstance(obj, tuple):\n            raise TypeError(f\"Input must be a tuple, but got {type(obj).__name__}.\")\nclass Comparator:\n    \"\"\"Centralizes equality checks.\"\"\"\n    def equals(self, x: Any, y: Any) -> bool:\n        \"\"\"Returns x == y.\"\"\"\n        return x == y\nclass Processor:\n    \"\"\"Computes the ordered symmetric difference between two tuples.\"\"\"\n    def compute_symmetric_ordered(self, a: Tuple[_T, ...], b: Tuple[_T, ...]) -> List[_T]:\n        \"\"\"\n        Computes the ordered symmetric difference.\n        Elements unique to 'a' are listed first, then elements unique to 'b'.\n        \"\"\"\n        result: List[_T] = []\n        comparator = Comparator()\n\n        try:\n            # Attempt efficient set-based approach for hashable elements (average-case O(N+M))\n            b_set = set(b)\n            for item_a in a:\n                if item_a not in b_set:\n                    result.append(item_a)\n\n            a_set = set(a)\n            for item_b in b:\n                if item_b not in a_set:\n                    result.append(item_b)\n\n        except TypeError:\n            # Fallback to O(N*M) equality-only checks for unhashable elements.\n            # Reset result as the previous attempt might have partially populated it.\n            result = []\n\n            # Find elements in 'a' that are not in 'b'\n            for item_a in a:\n                found_in_b = False\n                for item_b_inner in b:\n                    if comparator.equals(item_a, item_b_inner):\n                        found_in_b = True\n                        break\n                if not found_in_b:\n                    result.append(item_a)\n\n            # Find elements in 'b' that are not in 'a'\n            for item_b in b:\n                found_in_a = False\n                for item_a_inner in a:\n                    if comparator.equals(item_b, item_a_inner):\n                        found_in_a = True\n                        break\n                if not found_in_a:\n                    result.append(item_b)\n\n        return result\ndef find_dissimilar(a: Tuple[_T, ...], b: Tuple[_T, ...]) -> Tuple[_T, ...]:\n    \"\"\"\n    Public API: Orchestrates validation and processing to find dissimilar elements.\n    Returns a new tuple with unique elements from 'a' then 'b', in their original relative order.\n    \"\"\"\n    validator = Validator()\n    validator.validate_is_tuple(a)\n    validator.validate_is_tuple(b)\n\n    processor = Processor()\n    dissimilar_list = processor.compute_symmetric_ordered(a, b)\n\n    return tuple(dissimilar_list)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/578": [{"task_id": "Mbpp/578", "solution": "from typing import List, Any\nclass Interleaver:\n    \"\"\"Encapsulates validation and interleaving logic for three lists.\n    This class is stateless and provides methods for core operations.\n    \"\"\"\n\n    def validate_lengths(self, list1: List[Any], list2: List[Any], list3: List[Any]) -> bool:\n        \"\"\"Returns True if the three input lists have equal length, otherwise False.\n        This includes cases where all lists are empty.\n        \"\"\"\n        return len(list1) == len(list2) == len(list3)\n\n    def interleave_lists(self, list1: List[Any], list2: List[Any], list3: List[Any]) -> List[Any]:\n        \"\"\"Interleaves three equal-length lists into a single flat list.\n        If lengths are unequal, a ValueError is raised.\n        \"\"\"\n        if not self.validate_lengths(list1, list2, list3):\n            raise ValueError(\"Input lists must have equal length for interleaving.\")\n\n        num_elements = len(list1)\n        if num_elements == 0:\n     