   for k in range(m + 1):\n            term = ((-1)**k) * math.comb(n + 1, k) * ((m + 1 - k)**n)\n            result += term\n        return result\ndef eulerian_num(n: int, m: int) -> int:\n    \"\"\"Public API function to compute the Eulerian number a(n, m).\n    Orchestrates input validation and delegates computation to EulerianFunction.\n    \"\"\"\n    input_params = InputParameters(n, m)\n    input_params.validate()\n    \n    return EulerianFunction.eulerian_num(n, m)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[1, 1]]}, {"task_id": "Mbpp/103", "solution": "# eulerian_project/eulerian/calculator.py\nclass EulerianCalculator:\n    \"\"\"Computes Eulerian numbers using recurrence with memoization.\"\"\"\n    _memo: dict[tuple[int, int], int] = {}\n\n    @classmethod\n    def compute(cls, n: int, m: int) -> int:\n        \"\"\"Computes A(n, m) using recurrence and memoization.\"\"\"\n        if (n, m) in cls._memo:\n            return cls._memo[(n, m)]\n\n        if n == 0 and m == 0:\n            result = 1\n        elif n > 0 and (m < 0 or m >= n):\n            result = 0\n        else: # n > 0 and 0 <= m < n\n            term1 = (n - m) * cls.compute(n - 1, m - 1)\n            term2 = (m + 1) * cls.compute(n - 1, m)\n            result = term1 + term2\n        \n        cls._memo[(n, m)] = result\n        return result", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/105": [{"task_id": "Mbpp/105", "solution": "def count(lst):\n    \"\"\"Counts the occurrences of the boolean value True in a list.\n    Only counts elements that are explicitly of type bool and have the value True.\n    \"\"\"\n    true_booleans_count = 0\n    for element in lst:\n        if type(element) is bool and element is True:\n            true_booleans_count += 1\n    return true_booleans_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"