\n        if num == 0:\n            return 0\n        while num >= 10:\n            num //= 10\n        return num\n_first_digit_calculator = FirstDigitFunction()\ndef first_Digit(n: int) -> int:\n    \"\"\"Return most significant digit of integer n as int (0..9).\"\"\"\n    return _first_digit_calculator.first_Digit(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/479", "solution": "def first_Digit(number: int) -> int:\n    \"\"\"\n    Computes the most significant (left-most) decimal digit of the absolute value of an integer.\n    Returns an integer in the range 0 to 9.\n    \"\"\"\n    abs_number = abs(number)\n    return int(str(abs_number)[0])", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/555": [{"task_id": "Mbpp/555", "solution": "def difference(n: int) -> int:\n    \"\"\"Computes the difference between the sum of cubes of the first n natural numbers and the sum of the first n natural numbers.\n    The input n is trusted to be a positive integer.\"\"\"\n    # S2 = sum_{i=1..n} i = n*(n+1)//2\n    linear_sum_formula_result = n * (n + 1) // 2\n\n    # S1 = sum_{i=1..n} i^3 = (n*(n+1)//2)**2\n    sum_of_cubes = linear_sum_formula_result * linear_sum_formula_result\n\n    # S2 = n*(n+1)//2\n    linear_sum = linear_sum_formula_result\n\n    return sum_of_cubes - linear_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/555", "solution": "from .natural_number_sequence import NaturalNumberSequence", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/557": [{"task_id": "Mbpp/557", "solution": "from dataclasses import dataclass\ndef _process_character(c: str) -> str:\n    \"\"\"Processes a single character, toggling its case if alphabetic.\"\"\"\n    char_obj = Character(value=c)\n    return char_obj.toggle_case()\ndef toggle_string(input: str) -> str:\n    \"\"\"Inverts the case of alphabetic characters in a string, preserving others.\"\"\"\n    # Per critical requirements, no isinstance check or error handling for non-string input.\n    \n    processed_chars = []\n    for char in input:\n        processed_chars.append(_process_character(char))\n    return \"\".join(processed_chars)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [["Python"]], "plus_fail_tests": [["ABCDEFGHIJKLMNOPQRSTUVWXYZ"]]}, {"task_id": "Mbpp/557", "solution": "def toggle_string(input: str) -> str:\n    \"\"\"Toggles the case of alphabetic characters in a string.\n    Non-alphabetic characters remain unchanged, preserving order and length.\n    \"\"\"\n    toggled_chars = []\n    for char in input:\n        if char.isalpha():\n            if char.islower():\n                toggled_chars.append(char.upper())\n            else:  # Character is alphabetic and not lowercase, so it's uppercase\n                toggled_chars.append(char.lower())\n        else:  # Character is not alphabetic\n            toggled_chars.append(char)\n    return \"\".join(toggled_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/556": [{"task_id": "Mbpp/556", "solution": "def _validate_inputs(arr: list, n: int) -> int:\n    \"\"\"\n    Validates input types and computes the effective number of elements to consider.\n    Raises TypeError if arr is not a list or n is not an int.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input 'arr' must be a list.\")\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    \n    return min(n, len(arr))\ndef _count_parity(arr: list, n_effective: int) -> tuple[int, int]:\n    \"\"\"\n    Counts odd and even integers within the first n_effective elements of arr.\n    Returns a tuple (odds_count, evens_count).\n    \"\"\"\n    odds_count = 0\n    evens_count = 0\n    for i in range(n_effective):\n        element = arr[i]\n        if element % 2 == 0:\n            evens_count += 1\n        else:\n            odds_count += 1\n    return odds_count, evens_count\ndef find_Odd_Pair(arr: list, n: int) -> int:\n    \"\"\"\n    Counts unordered index pairs (i, j) where 0 <= i < j < n_effective such that arr[i] XOR arr[j] is odd.\n    The result is computed as (count of odd numbers) * (count of even numbers).\n    \"\"\"\n    n_effective = _validate_inputs(arr, n)\n\n    if n_effective < 2:\n        return 0\n\n    odds, evens = _count_parity(arr, n_effective)\n    return odds * evens", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(array, n):\n    \"\"\"Counts unordered index pairs (i, j) among the first n elements such that array[i] XOR array[j] is odd.\n    Returns 0 if n is less than or equal to 1, as no pairs can be formed.\n    \"\"\"\n    if n <= 1:\n        return 0\n\n    odd_xor_pairs_count = 0\n    \n    # Iterate through all unique unordered pairs (i, j) where 0 <= i < j < n.\n    for i in range(n):\n        for j in range(i + 1, n):\n            # Check if the XOR value of array[i] and array[j] is odd.\n            # An integer is odd if its least significant bit is 1.\n            if (array[i] ^ array[j]) & 1 == 1:\n                odd_xor_pairs_count += 1\n                \n    return odd_xor_pairs_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/558": [{"task_id": "Mbpp/558", "solution": "from typing import List\nclass IntegerInput:\n    \"\"\"Encapsulates a Python int; validates type; normalizes and extracts digits.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def is_valid_int(self) -> bool:\n        \"\"\"Checks if the encapsulated value is an integer.\"\"\"\n        return isinstance(self.value, int)\n\n    def normalize(self) -> 'IntegerInput':\n        \"\"\"Returns a new IntegerInput with the absolute value.\"\"\"\n        return IntegerInput(abs(self.value))\n\n    def get_digits(self) -> List['Digit']:\n        \"\"\"Extracts decimal digits, with units at index 0.\"\"\"\n        n = abs(self.value)\n        if n == 0:\n            return [Digit(position=0, value=0)]\n        \n        digits = []\n        pos = 0\n        while n > 0:\n            digits.append(Digit(position=pos, value=n % 10))\n            n //= 10\n            pos += 1\n        return digits\nclass Digit:\n    \"\"\"Data holder for a single digit with its position.\"\"\"\n    def __init__(self, position: int, value: int):\n        self.position = position\n        self.value = value\nclass DigitCollection:\n    \"\"\"Ordered container of Digit objects with padding logic.\"\"\"\n    def __init__(self, digits: List[Digit]):\n        self.digits = digits\n\n    def length(self) -> int:\n        \"\"\"Returns the number of digits in the collection.\"\"\"\n        return len(self.digits)\n\n    def pad_to(self, length: int) -> 'DigitCollection':\n        \"\"\"Pads the collection with zeros on the most-significant side to reach a target length.\"\"\"\n        current_len = self.length()\n        if current_len >= length:\n            return self # No padding needed or already longer\n        \n        new_digits = list(self.digits) # Create a new list for padding\n        for i in range(current_len, length):\n            new_digits.append(Digit(position=i, value=0))\n        return DigitCollection(new_digits)\nclass DigitDistanceCalculator:\n    \"\"\"Stateless core algorithm computing the sum of per-digit absolute differences.\"\"\"\n    def compute(self, a: IntegerInput, b: IntegerInput) -> int:\n        \"\"\"\n        Computes the sum of per-digit absolute differences between two IntegerInputs.\n        Expects a and b to be normalized (non-negative).\n        \"\"\"\n        digits_a_list = a.get_digits()\n        digits_b_list = b.get_digits()\n\n        coll_a = DigitCollection(digits_a_list)\n        coll_b = DigitCollection(digits_b_list)\n\n        max_len = max(coll_a.length(), coll_b.length())\n\n        padded_coll_a = coll_a.pad_to(max_len)\n        padded_coll_b = coll_b.pad_to(max_len)\n\n        total_difference = 0\n        for i in range(max_len):\n            val_a = padded_coll_a.digits[i].value\n            val_b = padded_coll_b.digits[i].value\n            total_difference += abs(val_a - val_b)\n\n        return total_difference\ndef digit_distance_nums(a, b) -> int:\n    \"\"\"\n    Computes the sum of absolute per-digit differences between two integers.\n    The function validates inputs, normalizes them, and pads shorter numbers with zeros.\n    \"\"\"\n    a_input = IntegerInput(a)\n    b_input = IntegerInput(b)\n\n    if not a_input.is_valid_int() or not b_input.is_valid_int():\n        raise TypeError(\"Both arguments must be int\")\n\n    normalized_a = a_input.normalize()\n    normalized_b = b_input.normalize()\n\n    calculator = DigitDistanceCalculator()\n    result = calculator.compute(normalized_a, normalized_b)\n    \n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/558", "solution": "class IntegerOperand:\n    \"\"\"Represent an integer input operand and provide accessors for its absolute value and digit sequence.\"\"\"\n\n    def __init__(self, value: int) -> None:\n        \"\"\"Construct operand wrapper; store provided value.\"\"\"\n        self._value = value\n\n    def abs_value(self) -> int:\n        \"\"\"Return absolute integer value abs(self._value).\"\"\"\n        return abs(self._value)\n\n    def digits(self) -> list:\n        \"\"\"Return list[int] digits of abs_value() in least-significant-first order.\"\"\"\n        n = self.abs_value()\n        if n == 0:\n            return [0]\n        digit_list = []\n        while n > 0:\n            digit_list.append(n % 10)\n            n //= 10\n        return digit_list\nclass DigitComparisonResult:\n    \"\"\"Hold list of per-position absolute differences and provide aggregated sum.\"\"\"\n\n    def __init__(self, differences: list) -> None:\n        \"\"\"Construct result holder.\"\"\"\n        self._differences = differences\n\n    def sum(self) -> int:\n        \"\"\"Return integer sum of differences.\"\"\"\n        return sum(self._differences)\nclass DigitDistanceCalculator:\n    \"\"\"Encapsulate algorithm steps for validation, digit extraction, padding, per-digit comparison and aggregation.\"\"\"\n\n    def digit_distance_nums(self, a: int, b: int) -> int:\n        \"\"\"Orchestrates validation, operand wrapping, digit conversion/padding, comparison and sum; returns total int.\"\"\"\n        self._validate_inputs(a, b)\n\n        operand_a = IntegerOperand(a)\n        operand_b = IntegerOperand(b)\n\n        digits_a = operand_a.digits()\n        digits_b = operand_b.digits()\n\n        # Determine required length for padding\n        max_len = max(len(digits_a), len(digits_b))\n\n        padded_digits_a = self._pad_digits(digits_a, max_len)\n        padded_digits_b = self._pad_digits(digits_b, max_len)\n\n        # Compute per-digit absolute differences\n        differences = []\n        for d_a, d_b in zip(padded_digits_a, padded_digits_b):\n            differences.append(abs(d_a - d_b))\n\n        result = DigitComparisonResult(differences)\n        return result.sum()\n\n    def _validate_inputs(self, a, b) -> None:\n        \"\"\"Raises TypeError if either a or b is not an int.\"\"\"\n        if not isinstance(a, int) or not isinstance(b, int):\n            raise TypeError(\"Both inputs 'a' and 'b' must be integers.\")\n\n    def _to_digits(self, n: int) -> list:\n        \"\"\"Convert absolute value abs(n) into list[int] of decimal digits ordered least-significant-first (units at index 0).\"\"\"\n        # This method is provided as per class diagram, though IntegerOperand.digits() handles operand digit extraction.\n        abs_n = abs(n)\n        if abs_n == 0:\n            return [0]\n        digit_list = []\n        while abs_n > 0:\n            digit_list.append(abs_n % 10)\n            abs_n //= 10\n        return digit_list\n\n    def _pad_digits(self, digits: list, length: int) -> list:\n        \"\"\"Given least-significant-first digits, extend the list to specified length by appending zeros.\"\"\"\n        return digits + [0] * (length - len(digits))\n\n    def _compare_and_sum(self, digits_a: list, digits_b: list) -> int:\n        \"\"\"Compute absolute differences for each aligned digit and return the integer sum.\"\"\"\n        # This method is not directly used in the current implementation of digit_distance_nums,\n        # but the logic is embedded within it, following the sequence diagram.\n        total_difference = 0\n        for d_a, d_b in zip(digits_a, digits_b):\n            total_difference += abs(d_a - d_b)\n        return total_difference\ndef digit_distance_nums(a: int, b: int) -> int:\n    \"\"\"Public API that computes and returns the integer sum of per-digit absolute differences.\"\"\"\n    calculator = DigitDistanceCalculator()\n    return calculator.digit_distance_nums(a, b)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/559": [{"task_id": "Mbpp/559", "solution": "from typing import List\nfrom dataclasses import dataclass\nclass ArrayInput:\n    \"\"\"Represents an input array and provides its length.\"\"\"\n    def __init__(self, elements: List[int]):\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the array.\"\"\"\n        return len(self.elements)\nclass ParameterN:\n    \"\"\"Represents the integer n, indicating how many initial elements to consider.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\nclass MaxSubarrayService:\n    \"\"\"Core service computing 