 possible).\n    for i in range(1, N):\n        dp[i][0] = dp[i-1][0] + float(matrix[i][0])\n\n    # Fill the rest of the DP table.\n    for i in range(1, N):\n        for j in range(1, N):\n            dp[i][j] = float(matrix[i][j]) + max(dp[i-1][j], dp[i][j-1])\n\n    # The maximum sum path ends at the bottom-right cell.\n    max_sum = dp[N-1][N-1]\n\n    # All valid paths have the same length (N-1 right moves + N-1 down moves + 1 start cell).\n    path_length = 2 * N - 1\n\n    return max_sum / path_length", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/723": [{"task_id": "Mbpp/723", "solution": "import pytest\nfrom src.count_same_pair import count_same_pair", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/723", "solution": "from src.validator import Validator\nfrom src.comparator import Comparator\nclass CountSamePairService:\n    \"\"\"Orchestrates validation and comparison of two lists.\"\"\"\n    def __init__(self, validator: Validator, comparator: Comparator):\n        self._validator = validator\n        self._comparator = comparator\n\n    def count_same_pair(self, listA: list, listB: list) -> int:\n        \"\"\"\n        Validates inputs and counts indices where elements are equal.\n        Raises InvalidInputError or LengthMismatchError on invalid input.\n        \"\"\"\n        self._validator.validate_is_list(listA)\n        self._validator.validate_is_list(listB)\n        self._validator.validate_equal_length(listA, listB)\n\n        return self._comparator.count_equal_indices(listA, listB)\ndef count_same_pair(listA: list, listB: list) -> int:\n    \"\"\"\n    Public entry point to count indices with identical values.\n    Delegates to the CountSamePairService for orchestration.\n    \"\"\"\n    service = CountSamePairService(Validator(), Comparator())\n    return service.count_same_pair(listA, listB)", "base_status": "fail", "plus_s