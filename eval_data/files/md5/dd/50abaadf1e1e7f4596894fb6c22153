ple2)\n\n    # Compute the element-wise modulo result.\n    # Assumes valid inputs (tuples of equal length, all integers, no zero divisors) as per critical requirements.\n    return tuple(tuple1[i] % tuple2[i] for i in range(len(tuple1)))", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[10, 4, 5, 6], [5, 6, 7, 5]]], "plus_fail_tests": [[[], []]]}], "Mbpp/619": [{"task_id": "Mbpp/619", "solution": "class Character:\n    \"\"\"Represents a single character with its value and position.\"\"\"\n    def __init__(self, value: str, position: int):\n        self.value = value\n        self.position = position\n\n    def is_digit(self) -> bool:\n        \"\"\"Checks if the character's value is a digit ('0'-'9').\"\"\"\n        return '0' <= self.value <= '9'\nclass DigitCollector:\n    \"\"\"Collects digit characters in their encountered order.\"\"\"\n    def __init__(self):\n        self.digits: list[str] = []\n\n    def collect(self, c: Character) -> None:\n        \"\"\"Appends the character's value if it is a digit.\"\"\"\n        if c.is_digit():\n            self.digits.append(c.value)\n\n    def joined(self) -> str:\n        \"\"\"Returns all collected digit characters as a single string.\"\"\"\n        return ''.join(self.digits)\nclass NonDigitCollector:\n    \"\"\"Collects non-digit characters in their encountered order.\"\"\"\n    def __init__(self):\n        self.non_digits: list[str] = []\n\n    def collect(self, c: Character) -> None:\n        \"\"\"Appends the character's value if it is not a digit.\"\"\"\n        if not c.is_digit():\n            self.non_digits.append(c.value)\n\n    def joined(self) -> str:\n        \"\"\"Returns all collected non-digit characters as a single string.\"\"\"\n        return ''.join(self.non_digits)\ndef move_num(input_str: str) -> str:\n    \"\"\"\n    Moves all non-digit characters to the beginning and digit characters to the end\n    of the input string, preserving their relative order.\n    \"\"\"\n    non_digit_collector = NonDigitCollector()\n    digit_collector = DigitCollector()\n\n    for i, char_value in enumerate(input_str):\n        char_obj = Character(char_value, i)\n        non_digit_collector.collect(char_obj)\n        digit_collector.collect(char_obj)\n\n    return non_digit_collector.joined() + digit_collector.joined()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/619", "solution": "def move_num(input: str) -> str:\n    \"\"\"\n    Moves all digit characters to the end of the string, preserving relative order.\n    Non-digit characters appear first, followed by digit characters.\n    \"\"\"\n    non_digits = []\n    digits = []\n    for char in input:\n        if '0' <= char <= '9':\n            digits.append(char)\n        else:\n            non_digits.append(char)\n    return \"\".join(non_digits) + \"\".join(digits)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/620": [{"task_id": "Mbpp/620", "solution": "from typing import List, Dict, Optional\nclass Number:\n    \"\"\"Represents a numeric element with a value and a unique ID.\"\"\"\n    def __init__(self, value: int, id: int):\n        self.value = value\n        self.id = id\nclass InputList:\n    \"\"\"Wraps a list of integers into Number instances with unique IDs.\"\"\"\n    def __init__(self, values: List[int]):\n        self.numbers: List[Number] = [Number(value, i) for i, value in enumerate(values)]\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the input list.\"\"\"\n        return len(self.numbers)\nclass DivisibleSubset:\n    \"\"\"Represents a candidate subset of numbers and provides its size.\"\"\"\n    def __init__(self, members: Optional[List[Number]] = None):\n        self.members: List[Number] = members if members is not None else []\n\n    def size(self) -> int:\n        \"\"\"Returns the number of members in the subset.\"\"\"\n        return len(self.members)\nclass DivisibilityGraph:\n    \"\"\"Builds an adjacency graph for pairwise divisibility and finds the largest subset.\"\"\"\n    def __init__(self, input_list: InputList):\n        self.input_list = input_list\n        self.adjacency: Dict[int, List[int]] = {num.id: [] for num in input_list.numbers}\n        self._max_clique_members: List[Number] = []\n\n    def _are_divisible(self, a: int, b: int) -> bool:\n        \"\"\"Checks if two numbers are divisible by each other, handling zero values.\"\"\"\n        if a == 0 and b == 0:\n            return True\n        if a == 0:\n            return True\n        if b == 0:\n            return True\n        return a % b == 0 or b % a == 0\n\n    def build_graph(self) -> None:\n        \"\"\"Constructs the adjacency graph based on pairwise divisibility for all pairs.\"\"\"\n        numbers = self.input_list.numbers\n        n = len(numbers)\n        for i in range(n):\n            for j in range(i + 1, n): # Iterate over unique pairs (i < j).\n                num_i = numbers[i]\n                num_j = numbers[j]\n                if self._are_divisible(num_i.value, num_j.value):\n                    self.adjacency[num_i.id].append(num_j.id)\n                    self.adjacency[num_j.id].append(num_i.id)\n\n    def find_largest_subset(self) -> DivisibleSubset:\n        \"\"\"Finds the largest pairwise-divisible subset (maximum clique) using backtracking.\"\"\"\n        self._max_clique_members = []\n        nodes_by_id = {num.id: num for num in self.input_list.numbers}\n        all_node_ids = sorted(nodes_by_id.keys()) # Ensures deterministic iteration order.\n\n        def _backtrack_max_clique(current_clique_ids: List[int], candidate_start_index: int) -> None:\n            \"\"\"Recursive backtracking function to find the maximum clique.\"\"\"\n            if len(current_clique_ids) > len(self._max_clique_members):\n                self._max_clique_members = [nodes_by_id[node_id] for node_id in current_clique_ids]\n\n            # Pruning: if remaining candidates cannot form a larger clique, stop exploring this path.\n            if len(current_clique_ids) + (len(all_node_ids) - candidate_start_index) <= len(self._max_clique_members):\n                return\n\n            for i in range(candidate_start_index, len(all_node_ids)):\n                candidate_id = all_node_ids[i]\n                \n                # Check if candidate_id is connected to all nodes already in current_clique_ids.\n                is_connectable = True\n                for existing_node_id in current_clique_ids:\n                    if candidate_id not in self.adjacency[existing_node_id]:\n                        is_connectable = False\n                        break\n                \n                if is_connectable:\n                    current_clique_ids.append(candidate_id)\n                    _backtrack_max_clique(current_clique_ids, i + 1) # Recurse with candidate_id added.\n                    current_clique_ids.pop() # Backtrack: remove candidate_id.\n\n        _backtrack_max_clique([], 0) # Start with an empty clique and consider all nodes.\n\n        return DivisibleSubset(self._max_clique_members)\ndef largest_subset(input_values: List[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset of numbers where every pair is divisible.\n    Handles empty input and uses a graph-based maximum clique algorithm.\n    \"\"\"\n    if not input_values:\n        return 0\n\n    input_list_obj = InputList(input_values)\n    graph = DivisibilityGraph(input_list_obj)\n    graph.build_graph()\n    subset = graph.find_largest_subset()\n    return subset.size()", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[9, 3, 12, 7, 16, 3, 11, 8, 4, 13, 13]]]}, {"task_id": "Mbpp/620", "solution": "from typing import List, Set, Dict, Tuple\nclass DivisibilityRelation:\n    \"\"\"\n    Encapsulates guarded divisibility logic.\n    Checks if one number is divisible by another, handling zero safely.\n    \"\"\"\n    def isDivisible(self, a: int, b: int) -> bool:\n        \"\"\"\n        Returns True if a is divisible by b or b is divisible by a, with zero guards.\n        Follows the rule: (b != 0 and a % b == 0) or (a != 0 and b % a == 0).\n        \"\"\"\n        cond1 = False\n        if b != 0:\n            cond1 = (a % b == 0)\n        \n        cond2 = False\n        if a != 0:\n            cond2 = (b % a == 0)\n            \n        return cond1 or cond2\nclass Validator:\n    \"\"\"\n    Handles input validation and normalization.\n    (Critical requirements prohibit actual validation checks and exceptions.)\n    \"\"\"\n    def validate(self, numbers: List[int]) -> List[int]:\n        \"\"\"\n        Validates the input list of numbers.\n        Returns a shallow copy of the list, omitting actual validation due to constraints.\n        \"\"\"\n        return list(numbers)\nclass LargestSubsetService:\n    \"\"\"\n    Orchestrates the process of finding the largest divisible subset.\n    It integrates validation, divisibility checks, and the clique-finding algorithm.\n    \"\"\"\n    def __init__(self) -> None:\n        self.validator = Validator()\n        self.relation = DivisibilityRelation()\n        self.max_clique_size = 0\n\n    def largest_subset(self, numbers: List[int]) -> int:\n        \"\"\"\n        Computes the size of the largest subset where every pair of integers is divisible.\n        Validates input, constructs a divisibility graph, and applies Bron-Kerbosch.\n        \"\"\"\n        validated_numbers = self.validator.validate(numbers)\n\n        if not validated_numbers:\n            return 0\n\n        # Create unique numbers for graph construction. Duplicates are handled by graph size.\n        unique_numbers = sorted(list(set(validated_numbers)))\n        \n        # Numbers equal to zero cannot form pairs with other numbers or themselves\n        # according to the `isDivisible` logic (isDivisible(X,0)=False, isDivisible(0,0)=False).\n        # Thus, if 0 is present, it can only form a subset of size 1 by itself.\n        # Filter out 0s for graph construction; handle the size 1 case separately.\n        numbers_for_graph = [num for num in unique_numbers if num != 0]\n\n        # If only zeros were in the original list, or no numbers remain after filtering zeros.\n        if not numbers_for_graph:\n            if 0 in unique_numbers: # Original list contained only zeros, e.g., [0,0,0] -> unique={0}\n                return 1 # A subset of a single 0 is a valid (vacuously divisible) subset of size 1.\n            return 0 # No numbers at all, or only numbers that were filtered (e.g., empty initial list).\n\n        # Build an adjacency list for the graph where nodes are indices of numbers_for_graph\n        n = len(numbers_for_graph)\n        adj: Dict[int, Set[int]] = {i: set() for i in range(n)}\n\n        for i in range(n):\n            for j in range(i + 1, n):\n                val_i = numbers_for_graph[i]\n                val_j = numbers_for_graph[j]\n                if self.relation.isDivisible(val_i, val_j):\n                    adj[i].add(j)\n                    adj[j].add(i)\n        \n        # Initialize max_clique_size: A single element always forms a valid subset.\n        self.max_clique_size = 1 if n > 0 else 0\n\n        # Bron-Kerbosch algorithm (P = candidates, X = excluded)\n        # R = current clique (initially empty)\n        initial_P = set(range(n))\n        self._bron_kerbosch(set(), initial_P, set(), adj)\n        \n        return self.max_clique_size\n\n    def _bron_kerbosch(self, R: Set[int], P: Set[int], X: Set[int], adj: Dict[int, Set[int]]) -> None:\n        \"\"\"\n        Bron-Kerbosch algorithm with pivot for finding maximal cliques.\n        Updates self.max_clique_size with the largest clique found.\n        \"\"\"\n        # Base case: if P and X are both empty, R is a maximal clique.\n        if not P and not X:\n            if len(R) > self.max_clique_size:\n                self.max_clique_size = len(R)\n            return\n        \n        # Deterministic pivot selection: Choose `u` from `P union X` that maximizes `|P intersect N(u)|`.\n        # If multiple candidates, pick the smallest node index for determinism.\n        pivot_candidates = sorted(list(P.union(X)))\n        u_pivot = -1\n        max_intersection_size = -1\n\n        for candidate_node in pivot_candidates:\n            current_intersection_size = len(P.intersection(adj.get(candidate_node, set())))\n            if current_intersection_size > max_intersection_size:\n                max_intersection_size = current_intersection_size\n                u_pivot = candidate_node\n        \n        # Iterate over P_prime = P \\ N(u_pivot)\n        # Sort to ensure deterministic iteration order.\n        P_prime_nodes = sorted(list(P.difference(adj.get(u_pivot, set()))))\n\n        for v in P_prime_nodes:\n            # Recursive call with updated R, P, X sets\n            self._bron_kerbosch(R.union({v}), P.intersection(adj.get(v, set())), X.intersection(adj.get(v, set())), adj)\n            \n            # Remove v from P and add to X for the next iteration in the current level\n            P.remove(v)\n            X.add(v)\ndef largest_subset(numbers: List[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset of numbers where every pair is divisible.\n    This function serves as the public API entry point.\n    \"\"\"\n    service = LargestSubsetService()\n    return service.largest_subset(numbers)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[11, 22, 44, 33, 44, 55, 66, 77, 88, 99, 110, 22, 44]]]}], "Mbpp/622": [{"task_id": "Mbpp/622", "solution": "from .api import get_median\nfrom typing import List, Union\nfrom typing import Union\nfrom .models import InputList\nfrom typing import List, Union\nfrom typing import List, Union\nfrom .models import InputList, MedianResult\nfrom .validation import ValidationService, ValidationError\nfrom .median_calculator import MedianCalculator\nNumber = Union[int, float]\nclass InputList:\n    \"\"\"Data model for an input list with elements and size.\"\"\"\n    def __init__(self, elements: List[Number]):\n        self.elements = elements\n        self.size = len(elements)\n\n    def is_sorted(self) -> bool:\n        \"\"\"Checks if elements are in non-decreasing order.\"\"\"\n        for i in range(self.size - 1):\n            if self.elements[i] > self.elements[i+1]:\n                return False\n        return True\nclass MedianResult:\n    \"\"\"Data model for the computed median value.\"\"\"\n    def __init__(self, value: float):\n        self.value = value\nclass ValidationError(Exception):\n    \"\"\"Custom exception for validation failures.\"\"\"\n    def __init__(self, message: str, code: str = None):\n        super().__init__(message)\n        self.message = message\n        self.code = code\nclass ValidationService:\n    \"\"\"Service for validating input lists and parameters.\"\"\"\n\n    def validate_lengths(self, list1: InputList, list2: InputList, n: int) -> None:\n        \"\"\"Ensures n is int and len(list1) == len(list2) == n.\"\"\"\n        if not isinstance(n, int):\n            raise ValidationError(\"Parameter 'n' must be an integer.\", \"N_TYPE_ERROR\")\n        if list1.size != n or list2.size != n:\n            raise ValidationError(\n                f\"List lengths ({list1.size}, {list2.size}) must both be equal to n ({n}).\",\n                \"LEN_MISMATCH\"\n            )\n\n    def validate_sorted(self, lst: InputList) -> None:\n        \"\"\"Ensures lst.is_sorted() is True.\"\"\"\n        if not lst.is_sorted():\n            raise ValidationError(\"Input list is not sorted in non-decreasing order.\", \"UNSORTED\")\nclass MedianCalculator:\n    \"\"\"Calculates the median of two sorted lists of equal size.\"\"\"\n\n    def get_median(self, list1: List[Number], list2: List[Number], n: int) -> float:\n        \"\"\"Computes the median as average of the n-th and (n+1)-th smallest elements.\"\"\"\n        # For an even number of elements (2n), the median is the average of the two middle elements.\n        # If elements are 1-indexed, these are the n-th and (n+1)-th smallest elements.\n        k1_element = self._select_kth(list1, list2, n)\n        k2_element = self._select_kth(list1, list2, n + 1)\n        return float((k1_element + k2_element) / 2)\n\n    def _select_kth(self, a: List[Number], b: List[Number], k: int) -> Number:\n        \"\"\"Returns the k-th smallest element (1-based) across two sorted lists.\"\"\"\n        m, n = len(a), len(b)\n\n        # Ensure a is the shorter list for simpler logic in binary search range.\n        if m > n:\n            return self._select_kth(b, a, k)\n\n        # Binary search for 'i', the number of elements taken from 'a'.\n        # 'j' (elements from 'b') will be k - i.\n        low, high = max(0, k - n), min(k, m)\n\n        while low <= high:\n            i = (low + high) // 2  # Number of elements taken from 'a'.\n            j = k - i              # Number of elements taken from 'b'.\n\n            # Define boundary elements for comparison.\n            # Use negative/positive infinity as sentinels for boundary conditions.\n            A_left = a[i - 1] if i > 0 else float('-inf')\n            B_left = b[j - 1] if j > 0 else float('-inf')\n            A_right = a[i] if i < m else float('inf')\n            B_right = b[j] if j < n else float('inf')\n\n            if A_left <= B_right and B_left <= A_right:\n                # Correct partition found. k-th element is max of the two left elements.\n                return max(A_left, B_left)\n            elif A_left > B_right:\n                # 'i' is too large; too many elements from 'a'. Move 'high' pointer left.\n                high = i - 1\n            else: # B_left > A_right\n                # 'i' is too small; too many elements from 'b'. Move 'low' pointer right.\n                low = i + 1\n        \n        # This point should theoretically not be reached if k is always valid (1 <= k <= m + n).\n        return 0 # Default return to satisfy type checker, though unreachable.\ndef get_median(list1: List[Number], list2: List[Number], n: int) -> float:\n    \"\"\"Public API function to compute the median of two sorted lists.\n    It orchestrates input validation and median computation.\n    \"\"\"\n    \n    # Instantiate services\n    validation_service = ValidationService()\n    median_calculator = MedianCalculator()\n\n    # Wrap inputs in data models for validation\n    input_list1 = InputList(list1)\n    input_list2 = InputList(list2)\n\n    # Perform validation as per design\n    validation_service.validate_lengths(input_list1, input_list2, n)\n    validation_service.validate_sorted(input_list1)\n    validation_service.validate_sorted(input_list2)\n\n    # Compute median using the calculator\n    median_value = median_calculator.get_median(list1, list2, n)\n\n    # Wrap result in MedianResult and return its value\n    median_result = MedianResult(median_value)\n    return median_result.value", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/622", "solution": "from typing import List, Union\nclass Validator:\n    \"\"\"\n    Validates preconditions for input lists: length equality and sortedness.\n    Methods are stateless and perform checks on provided lists.\n    \"\"\"\n    def validateLength(self, list1: List[Union[int, float]], list2: List[Union[int, float]], n: int) -> bool:\n        \"\"\"Checks if both lists have length n, and n is at least 1.\"\"\"\n        return n >= 1 and len(list1) == n and len(list2) == n\n\n    def validateSorted(self, l: List[Union[int, float]]) -> bool:\n        \"\"\"Checks if the list is sorted in non-decreasing order.\"\"\"\n        for i in range(len(l) - 1):\n            if l[i] > l[i+1]:\n                return False\n        return True\nclass MedianCalculator:\n    \"\"\"\n    Computes the median of two sorted lists of equal size n.\n    The median is the average of the n-th and (n+1)-th smallest elements.\n    \"\"\"\n    def computeMedian(self, list1: List[Union[int, float]], list2: List[Union[int, float]], n: int) -> float:\n        \"\"\"\n        Combines and sorts the two lists, then calculates the median.\n        The median is derived from the n-th and (n+1)-th elements of the combined sorted list.\n        \"\"\"\n        combined_list = sorted(list1 + list2)\n        # Median for 2n elements is the average of elements at indices n-1 and n (0-indexed)\n        median = (combined_list[n - 1] + combined_list[n]) / 2.0\n        return median\nclass ErrorHandler:\n    \"\"\"\n    Signals invalid input conditions by raising ValueError.\n    This provides a consistent way to report errors.\n    \"\"\"\n    def raiseInvalidInput(self, errorMsg: str) -> None:\n        \"\"\"Raises a ValueError with the specified error message.\"\"\"\n        raise ValueError(errorMsg)\ndef get_median(list1: List[Union[int, float]], list2: List[Union[int, float]], n: int) -> float:\n    \"\"\"\n    Calculates the median of two sorted lists of equal size n.\n    It validates inputs, and if valid, delegates median computation.\n    \"\"\"\n    validator = Validator()\n    error_handler = ErrorHandler()\n    median_calculator = MedianCalculator()\n\n    if not validator.validateLength(list1, list2, n):\n        error_handler.raiseInvalidInput(\"Input lists must have length n, and n must be at least 1.\")\n\n    if not validator.validateSorted(list1):\n        error_handler.raiseInvalidInput(\"First list is not sorted in non-decreasing order.\")\n\n    if not validator.validateSorted(list2):\n        error_handler.raiseInvalidInput(\"Second list is not sorted in non-decreasing order.\")\n\n    return median_calculator.co