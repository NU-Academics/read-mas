ame, mark) tuples.\"\"\"\n        return [sm.to_tuple() for sm in self._marks]\nclass SubjectMarksService:\n    \"\"\"Provides business logic for sorting SubjectMarks.\"\"\"\n    @staticmethod\n    def subject_marks(marks: List[Tuple[str, int]]) -> List[Tuple[str, int]]:\n        \"\"\"Sorts a list of subject marks by their mark in ascending order.\n        Handles an empty input list by returning an empty list.\"\"\"\n        if not marks:\n            return []\n        \n        # Convert input tuples into SubjectMark objects for sorting.\n        subject_mark_objects = [SubjectMark(s_name, mark) for s_name, mark in marks]\n        \n        # Sort the SubjectMark objects based on their 'mark' attribute.\n        sorted_objects = sorted(subject_mark_objects, key=lambda sm: sm.mark)\n        \n        # Use SubjectMarksCollection to convert the sorted objects back to a list of tuples.\n        sorted_collection = SubjectMarksCollection(sorted_objects)\n        \n        return sorted_collection.to_list()\ndef subject_marks(marks: List[Tuple[str, int]]) -> List[Tuple[str, int]]:\n    \"\"\"Public API function to sort a list of (subject_name, mark) tuples.\"\"\"\n    return SubjectMarksService.subject_marks(marks)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[["Art", 70], ["History", 78], ["Chemistry", 80], ["Music", 82], ["Maths", 85], ["English", 87], ["Physics", 90], ["Geography", 92], ["Computer Science", 94, "Computer Science"], ["Biology", 95]]]]}], "Mbpp/66": [{"task_id": "Mbpp/66", "solution": "def validateInput(items: list) -> bool:\n    \"\"\"\n    Returns True if items is a Python list. Does not enforce element types.\n    \"\"\"\n    return isinstance(items, list)\ndef pos_count(items: list) -> int:\n    \"\"\"\n    Returns the integer count of elements in items strictly greater than 0.\n    Raises TypeError if input is not a list.\n    \"\"\"\n    if not validateInput(items):\n        raise TypeError(\"items must be a list\")\n\n    count = 0\n    for x in items:\n        # Check if the element is numeric (int or float) and strictly greater than 0.\n        if isinstance(x, (int, float)) and x > 0:\n            count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/66", "solution": "from pos_count import pos_count", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/67": [{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    \"\"\"\n    Computes the n-th Bell number using the Bell triangle algorithm (dynamic programming).\n    Assumes n is a non-negative integer and returns an exact integer result.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    # Initialize a 2D list to store the Bell triangle (Aitken's array).\n    # bell_triangle[r][c] stores the value T(r, c).\n    bell_triangle = [[0] * (n + 1) for _ in range(n + 1)]\n\n    # Base case: The first element of the triangle.\n    bell_triangle[0][0] = 1\n\n    # Fill the Bell triangle row by row.\n    for r in range(1, n + 1):\n        # The first element of the current row is the last element of the previous row.\n        bell_triangle[r][0] = bell_triangle[r - 1][r - 1]\n        # Calculate subsequent elements in the current row.\n        for c in range(1, r + 1):\n            # Each element is the sum of the element to its left in the current row\n            # and the element diagonally up-left from the previous row.\n            bell_triangle[r][c] = bell_triangle[r][c - 1] + bell_triangle[r - 1][c - 1]\n\n    # The n-th Bell number is the first element of the n-th row.\n    return bell_triangle[n][0]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/67", "solution": "from typing import Any\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid inputs.\n    Contains an explanatory message about the validation failure.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\nclass InputValidator:\n    \"\"\"Validates that an input 'n' is a non-negative integer.\"\"\"\n    def validate_non_negative_integer(self, n: Any) -> None:\n        \"\"\"Raises InvalidInputError if n is not an int or is negative.\"\"\"\n        if not isinstance(n, int):\n            raise InvalidInputError(f\"Input must be an integer, but got type {type(n).__name__}.\")\n        if n < 0:\n            raise InvalidInputError(f\"Input must be a non-negative integer, but got {n}.\")\nclass BellNumberCalculator:\n    \"\"\"Computes Bell numbers using dynamic programming (Stirling numbers of the second kind).\"\"\"\n    def bell_number(self, n: int) -> int:\n        \"\"\"Delegates computation to an internal DP method.\"\"\"\n        return self._compute_via_dp(n)\n\n    def _compute_via_dp(self, n: int) -> int:\n        \"\"\"Internal method to compute the n-th Bell number using DP.\"\"\"\n        if n == 0:\n            return 1\n\n        # Compute Stirling numbers of the second kind S(i, k)\n        # S(i, k) = S(i-1, k-1) + k * S(i-1, k)\n        stirling = [[0] * (n + 1) for _ in range(n + 1)]\n        stirling[0][0] = 1 # Base case S(0, 0) = 1\n\n        for i in range(1, n + 1):\n            for k in range(1, i + 1):\n                stirling[i][k] = stirling[i-1][k-1] + k * stirling[i-1][k]\n\n        # The n-th Bell number B(n) is the sum of S(n, k) for k from 0 to n.\n        return sum(stirling[n][k] for k in range(n + 1))\ndef bell_number(n: int) -> int:\n    \"\"\"\n    Returns the n-th Bell number.\n    Validates input and delegates computation to BellNumberCalculator.\n    \"\"\"\n    validator = InputValidator()\n    validator.validate_non_negative_integer(n)\n\n    calculator = BellNumberCalculator()\n    return calculator.bell_number(n)", "base_status": "pass", "plus_status": "pass", "b