    for i in range(3, limit, 2):\n            if x % i == 0:\n                self._prime_cache[x] = False\n                return False\n        \n        self._prime_cache[x] = True\n        return True\n\n    def newman_prime(self, n: int) -> int:\n        \"\"\"\n        Calculates the (n-1)-th Newman\u2013Shanks\u2013Williams number S_k and checks its primality.\n        Returns S_k if prime, otherwise raises ValueError as specified by design.\n        \"\"\"\n        # Interpretation: n (input) maps to k=n-1 for S_k, and S_k must be prime.\n        k = n - 1 \n        if k < 0:\n             raise ValueError(f\"Input n={n} maps to an index k={k} less than 0. Must be >=1.\")\n\n        nsw_num = self._compute_nsw_number(k)\n        if self._is_prime(nsw_num):\n            return nsw_num\n        else:\n            raise ValueError(f\"S_{k} (which is {nsw_num}) is not a prime number. Cannot return the {n}th NSW prime with this mapping.\")\n_nsw_prime_instance = NewmanPrimeFunction()\ndef newman_prime(n: int) -> int:\n    \"\"\"\n    Public API to find the nth Newman\u2013Shanks\u2013Williams prime number.\n    Validates input and delegates computation to NewmanPrimeFunction.\n    \"\"\"\n    input_param = InputParameter(n)\n    if not input_param.is_positive():\n        raise ValueError(\"Input 'n' must be a positive 1-based integer index.\")\n    \n    # Delegate computation\n    prime_result = _nsw_prime_instance.newman_prime(n)\n    \n    # Wrap result in OutputValue and return its value\n    output_value = OutputValue(prime_result)\n    return output_value.prime", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[3]], "plus_fail_tests": [[100]]}, {"task_id": "Mbpp/260", "solution": "class PrimeChecker:\n    \"\"\"Provides primality checking for arbitrary-precision integers.\"\"\"\n    def __init__(self) -> None:\n        \"\"\"Initializes the PrimeChecker (no state needed for this implementation).\"\"\"\n        pass\n\n    def is_prime(self