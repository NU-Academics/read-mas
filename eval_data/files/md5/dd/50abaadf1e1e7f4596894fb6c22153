_result: int | None = None\n\n    def max_subarray_product(self, arr: list[int]) -> int:\n        \"\"\"Compute and return maximum contiguous-subarray product.\"\"\"\n        if not arr:\n            # As per design notes, behavior for empty arrays is unspecified.\n            # Given CRITICAL REQUIREMENTS: \"Trust the caller's inputs\",\n            # we assume non-empty array or handle a simple default.\n            # A common default for max product in an empty array context might be 0\n            # if the product can be 0, or raise an error. Given the sample, we assume non-empty.\n            return 0 # Or float('-inf') if an empty product is not 0\n\n        max_so_far = arr[0]\n        min_so_far = arr[0]\n        overall_max_product = arr[0]\n\n        for i in range(1, len(arr)):\n            current_num = arr[i]\n\n            # If current_num is negative, swap max_so_far and min_so_far.\n            if current_num < 0:\n                max_so_far, min_so_far = min_so_far, max_so_far\n\n            # Update max_so_far and min_so_far for the current number\n            max_so_far = max(current_num, max_so_far * current_num)\n            min_so_far = min(current_num, min_so_far * current_num)\n\n            # Update the overall maximum product\n            overall_max_product = max(overall_max_product, max_so_far)\n        \n        self._last_input = arr\n        self._last_result = overall_max_product\n        return overall_max_product\n\n    def computeCandidateProducts(self, arr: list[int]) -> list[Subarray]:\n        \"\"\"Enumerate contiguous subarray candidates and compute their products.\"\"\"\n        candidates = []\n        n = len(arr)\n        for i in range(n):\n            current_product = 1\n            for j in range(i, n):\n                current_product *= arr[j]\n                candidates.append(Subarray(i, j, current_product))\n        return candidates\ndef max_subarray_product(arr: list[int]) -> int:\n    \"\"\"Public API: Finds the maximum product of any contiguous subarray of the given array.\"\"\"\n    calculator = MaxSubarrayCalculator()\n    return calculator.max_subarray_product(arr)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/463", "solution": "from typing import List\nclass MaxProductCalculator:\n    \"\"\"\n    Calculates the maximum product of a contiguous subarray.\n    Handles validation and the core algorithm logic.\n    \"\"\"\n    def __init__(self):\n        self.algorithm = \"Dynamic programming approach tracking current max and min products.\"\n\n    def validateInput(self, arr: List[int]) -> bool:\n        \"\"\"\n        Validates the input array for computation.\n        Returns False if the array is None or empty.\n        \"\"\"\n        return arr is not None and len(arr) > 0\n\n    def compute(self, arr: List[int]) -> int:\n        \"\"\"\n        Computes the maximum contiguous subarray product.\n        Iterates through the array tracking current max/min and global max.\n        \"\"\"\n        # As per BR-09, single-element arrays return that element.\n        result = arr[0]\n        current_max = arr[0]\n        current_min = arr[0]\n\n        for i in range(1, len(arr)):\n            num = arr[i]\n\n            if num == 0:\n                # Zeros are separators (BR-08). Reset current products for new segment.\n                result = max(result, 0)\n                current_max = 1\n                current_min = 1\n                continue\n\n            # Store previous current_max to correctly calculate current_min.\n            temp_current_max = current_max\n\n            # Update current_max and current_min (BR-07: account for sign flips).\n            current_max = max(num, temp_current_max * num, current_min * num)\n            current_min = min(num, temp_current_max * num, current_min * num)\n\n            # Update global max product.\n            result = max(result, current_max)\n            \n        return result\ndef max_subarray_product(arr: List[int]) -> int:\n    \"\"\"\n    Public API to compute the maximum product of a contiguous subarray.\n    Delegates to MaxProductCalculator for validation and core computation.\n    \"\"\"\n    # InputArray(values=arr) is a conceptual construction per design, not requiring assignment here.\n\n    calculator = MaxProductCalculator()\n    \n    # Validate input (FR-001, FR-005, BR-05).\n    # If validateInput returns False, behavior for empty/None array is to return 0.\n    if not calculator.validateInput(arr):\n        return 0 \n    \n    # Compute and return the maximum product (FR-002, BR-07, BR-08, BR-09).\n    # Input array 'arr' is used read-only by the calculator (BR-05).\n    return calculator.compute(arr)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/462": [{"task_id": "Mbpp/462", "solution": "class Combination:\n    \"\"\"A wrapper for a single combination (subset) of elements.\"\"\"\n    def __init__(self, elements: list):\n        # Stores raw element values, consistent with algorithm's direct list manipulation.\n        self._elements = list(elements)\n\n    def to_list(self) -> list:\n        \"\"\"Returns the combination as a list of its raw elements.\"\"\"\n        return list(self._elements)\nclass CombinationList:\n    \"\"\"A wrapper for a list of Combination objects.\"\"\"\n    def __init__(self):\n        self._combinations: list[Combination] = []\n\n    def append_combination(self, combination: Combination):\n        \"\"\"Appends a single Combination object to the list.\"\"\"\n        self._combinations.append(combination)\n\n    def extend_combinations(self, combinations: list[Combination]):\n        \"\"\"Extends the list with multiple Combination objects.\"\"\"\n        self._combinations.extend(combinations)\n\n    def get_combinations(self) -> list[Combination]:\n        \"\"\"Returns a copy of the list of contained Combination objects.\"\"\"\n        return list(self._combinations)\n\n    def to_list(self) -> list:\n        \"\"\"Converts the list of Combination objects to a list of raw Python lists.\"\"\"\n        return [c.to_list() for c in self._combinations]\nclass CombinationsGenerator:\n    \"\"\"Generates all combinations of a list's elements using the iterative-prepend algorithm.\"\"\"\n\n    @staticmethod\n    def combinations_list(lst: list) -> CombinationList:\n        \"\"\"\n        Computes all possible combinations using the iterative-prepend algorithm.\n        Returns a CombinationList object containing the ordered combinations.\n        \"\"\"\n        result_combination_list = CombinationList()\n        result_combination_list.append_combination(Combination([]))\n\n        for element in lst:\n            new_combinations_for_element = []\n            for prev_combination in result_combination_list.get_combinations():\n                new_combination_elements = [element] + prev_combination.to_list()\n                new_combinations_for_element.append(Combination(new_combination_elements))\n            \n            result_combination_list.extend_combinations(new_combinations_for_element)\n            \n        return result_combination_list\ndef combinations_list(lst: list) -> list:\n    \"\"\"\n    Public API to compute all possible combinations (subsets) of the input list.\n    Delegates to CombinationsGenerator and returns a Python list of lists.\n    \"\"\"\n    combination_list_obj = CombinationsGenerator.combinations_list(lst)\n    return combination_list_obj.to_list()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/462", "solution": "from src.combinations_list import combinations_list", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/465": [{"task_id": "Mbpp/465", "solution": "def drop_empty(input: dict) -> dict:\n    \"\"\"Returns a new dictionary with entries whose values are None removed.\n    Does not mutate the input dictionary.\n    \"\"\"\n    return {k: v for k, v in input.items() if v is not None}", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/465", "solution": "from typing import Dict, Any\ndef drop_empty(input_dict: Dict[Any, Any]) -> Dict[Any, Any]:\n    \"\"\"Return a new dict with entries whose value is not None preserved.\n    Preconditions (per SRS): input_dict is a native Python dict.\n    \"\"\"\n    return {k: v for k, v in input_dict.items() if v is not None}", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/468": [{"task_id": "Mbpp/468", "solution": "from typing import List\nfrom typing import List, Optional\nfrom src.increasing_subsequence import IncreasingSubsequence\nfrom src.result import Result\nfrom typing import List\nfrom src.product_calculator import ProductCalculator\nclass IncreasingSubsequence:\n    \"\"\"Encapsulates an increasing subsequence with validation and product computation.\"\"\"\n    def __init__(self, elements: List[float]):\n        self.elements = elements\n\n    def is_strictly_increasing(self) -> bool:\n        \"\"\"Checks if the elements in the subsequence are strictly increasing.\"\"\"\n        for i in range(1, len(self.elements)):\n            if self.elements[i] <= self.elements[i-1]:\n                return False\n        return True\n\n    def product(self) -> float:\n        \"\"\"Computes the multiplicative product of the subsequence elements.\"\"\"\n        res = 1.0\n        for x in self.elements:\n            res *= x\n        return res\nclass Result:\n    \"\"\"A simple result holder representing a numeric outcome.\"\"\"\n    def __init__(self, value: float):\n        self.value = value\nclass ProductCalculator:\n    \"\"\"Implements enumeration and selection algorithms for increasing subsequences.\"\"\"\n\n    def enumerate_subsequences(self, arr: List[float]) -> List[IncreasingSubsequence]:\n        \"\"\"Generates all non-empty subsequences preserving original order.\"\"\"\n        subsequences: List[IncreasingSubsequence] = []\n        n = len(arr)\n\n        # Iterate through all possible bitmasks from 1 to 2^n - 1 to represent non-empty subsequences.\n        for i in range(1, 1 << n):\n            current_sub = []\n            for j in range(n):\n                if (i >> j) & 1:  # If the j-th bit is set, include arr[j].\n                    current_sub.append(arr[j])\n            subsequences.append(IncreasingSubsequence(current_sub))\n        return subsequences\n\n    def max_product(self, arr: List[float]) -> float:\n        \"\"\"Calculates the maximum product from any strictly increasing subsequence.\"\"\"\n        if not arr:\n            return 0.0 # Returns 0.0 for an empty input array as no product can be formed.\n\n        # Handle single-element input as per the design's UC5.\n        if len(arr) == 1:\n            return float(arr[0])\n\n        all_subsequences = self.enumerate_subsequences(arr)\n        \n        max_prod_value: Optional[float] = None\n\n        for sub_obj in all_subsequences:\n            if sub_obj.is_strictly_increasing():\n                current_prod = sub_obj.product()\n                if max_prod_value is None or current_prod > max_prod_value:\n                    max_prod_value = current_prod\n        \n        # max_prod_value will always be set for non-empty `arr` because single-element subsequences are always increasing.\n        return Result(max_prod_value).value # Use Result class as an explicit output holder as per design.\ndef max_product(arr: List[float]) -> float:\n    \"\"\"Top-level API function to compute the maximum product of an increasing subsequence.\"\"\"\n    return ProductCalculator().max_product(arr)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/468", "solution": "from typing import List, Union\nclass InputArray:\n    \"\"\"A lightweight wrapper for input normalization/validation.\n    It stores normalized numeric values as a list of floats.\n    \"\"\"\n    values: List[float]\n\n    def __init__(self, values: List[Union[int, float]]):\n        \"\"\"Initializes an InputArray with its values, normalizing them to floats.\"\"\"\n        self.values = [float(v) for v in values]\nclass Element:\n    \"\"\"Represents a single array element and its original index.\n    It stores the numeric value as a float and its integer index.\n    \"\"\"\n    value: float\n    index: int\n\n    def __init__(self, value: Union[int, float], index: int):\n        \"\"\"Initializes an Element with its numeric value and original index.\"\"\"\n        self.value = float(value)\n        self.index = index\nclass Subsequence:\n    \"\"\"Represents a contiguous subsequence of elements.\n    It can compute the product of its contained elements.\n    \"\"\"\n    startIndex: int\n    endIndex: int\n    elements: List[Element]\n\n    def __init__(self, startIndex: int, endIndex: int, elements: List[Element]):\n        \"\"\"Initializes a Subsequence with its start/end indices and list of Element objects.\"\"\"\n        self.startIndex = startIndex\n        self.endIndex = endIndex\n        self.elements = elements\n\n    def product(self) -> float:\n        \"\"\"Computes and returns the product of its elements' values.\"\"\"\n        current_product = 1.0\n        for element in self.elements:\n            current_product *= element.value\n        return current_product\nclass MaxProductCalculator:\n    \"\"\"Core algorithmic logic to find strictly increasing contiguous subsequences.\n    It computes their products and identifies the maximum product among them.\n    \"\"\"\n\n    def max_product(self, arr: List[Union[int, float]]) -> float:\n        \"\"\"\n        Finds the maximum product from strictly increasing contiguous subsequences in the input array.\n        It normalizes the input, identifies subsequences, and computes the maximum product.\n        \"\"\"\n        input_array = InputArray(arr)\n        normalized_values = input_array.values\n\n        subsequences = self.findIncreasingContiguousSubsequences(normalized_values)\n\n        if not subsequences:\n            # If no subsequences are found (e.g., empty input array), return 0.0.\n            return 0.0\n\n        max_prod = float('-inf')\n        for s in subsequences:\n            current_prod = self.computeProduct(s)\n            if current_prod > max_prod:\n                max_prod = current_prod\n        return max_prod\n\n    def findIncreasingContiguousSubsequences(self, values: List[float]) -> List[Subsequence]:\n        \"\"\"\n        Scans a list of normalized float values to identify all strictly increasing contiguous subsequences.\n        Single-element runs are included by default as valid subsequences.\n        \"\"\"\n        if not values:\n            return []\n\n        result_subsequences: List[Subsequence] = []\n        current_run_elements: List[Element] = []\n        current_run_start_index: int = 0\n\n        for i, value in enumerate(values):\n            if not current_run_elements:\n                # Initialize a new run if current_run_elements is empty.\n                current_run_start_index = i\n                current_run_elements.append(Element(value, i))\n            elif value > current_run_elements[-1].value:\n                # Continue the current strictly increasing run.\n                current_run_elements.append(Element(value, i))\n            else:\n                # The increasing run is broken, so save the completed subsequence.\n                result_subsequences.append(\n                    Subsequence(\n                        current_run_start_index,\n                        current_run_elements[-1].index,\n                        list(current_run_elements)\n                    )\n                )\n                # Start a new run with the current element.\n                current_run_start_index = i\n                current_run_elements = [Element(value, i)]\n        \n        # After the loop, add the last accumulated run as a subsequence.\n        if current_run_elements:\n            result_subsequences.append(\n                Subsequence(\n                    current_run_start_index,\n                    current_run_elements[-1].index,\n                    current_run_elements\n                )\n            )\n        \n        return result_subsequences\n\n    def computeProduct(self, s: Subsequence) -> float:\n        \"\"\"Multiplies the element values within a given Subsequence and returns the numeric product.\"\"\"\n        return s.product()\ndef max_product(arr: List[Union[int, float]]) -> float:\n    \"\"\"\n    Provides a public entry point to find the maximum product of a strictly increasing contiguous subsequence.\n    This function delegates the core logic to an instance of MaxProductCalculator.\n    \"\"\"\n    return MaxProductCalculator().max_product(arr)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[3, -5, 2, 6, -1, 4, -3]]]}], "Mbpp/470": [{"task_id": "Mbpp/470", "solution": "from src.types import TupleInput, ResultTuple\nfrom typing import Tuple\nclass PairwiseAdder:\n    \"\"\"Stateless service to compute pairwise sums.\"\"\"\n    def add_pairwise(self, t: TupleInput) -> ResultTuple:\n        \"\"\"Computes the sum of adjacent elements from a TupleInput.\"\"\"\n        result_elements: List[int] = []\n        # Iterate up to the second-to-last element to form pairs.\n        for i in range(t.length() - 1):\n            result_elements.append(t.elements[i] + t.elements[i+1])\n        return ResultTuple(elements=result_elements)\ndef add_pairwise(input_tuple: Tuple[int, ...]) -> Tuple[int, ...]:\n    \"\"\"\n    Public API to compute pairwise sums of neighboring elements in a tuple.\n    It converts native tuple to TupleInput, delegates to PairwiseAdder, and returns a native tuple.\n    \"\"\"\n    tuple_input = TupleInput(elements=input_tuple)\n    adder = PairwiseAdder()\n    result_tuple_obj = adder.add_pairwise(tuple_input)\n    return result_tuple_obj.as_tuple()", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/470", "solution": "from typing import Tuple, Union\ndef add_pairwise(input_tuple: Tuple[Union[int, float], ...]) -> Tuple[Union[int, float], ...]:\n    \"\"\"Computes pairwise sums of neighboring numeric elements in a tuple.\n    Returns an empty tuple if the input has fewer than two elements.\n    \"\"\"\n    return tuple(input_tuple[i] + input_tuple[i+1] for i in range(len(input_tuple) - 1))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/472": [{"task_id": "Mbpp/472", "solution": "def check_Consecutive(list) -> bool:\n    \"\"\"\n    Checks if elements in a list are consecutive in ascending order (adjacent difference == 1).\n    Returns True for empty or single-element lists, as no non-consecutive pairs exist.\n    \"\"\"\n    for i in range(len(list) - 1):\n        if list[i+1] - list[i] != 1:\n            return False\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/472", "solution": "from typing import List\nclass InputList:\n    \"\"\"A typed container for input elements.\"\"\"\n    def __init__(self, elements: List[int]) -> None:\n        self.elements = elements\nclass Result:\n    \"\"\"Encapsulates the boolean outcome of a check.\"\"\"\n    def __init__(self, is_consecutive: bool) -> None:\n        self.is_consecutive = is_consecutive\nclass CheckConsecutive:\n    \"\"\"Encapsulates the algorithm for checking consecutive integers.\"\"\"\n    def check(self, elements: List[int]) -> bool:\n        \"\"\"\n        Evaluates if elements are consecutive ascending integers.\n        Returns True if consecutive, False otherwise.\n        \"\"\"\n        if len(elements) < 2:\n            return True\n\n        for i in range(1, len(elements)):\n            if elements[i] != elements[i-1] + 1:\n                return False\n        return True\ndef check_Consecutive(elements: List[int]) -> bool:\n    \"\"\"\n    Public API function to check if a list's elements are ascending consecutive integers.\n    It delegates the core logic to the CheckConsecutive class.\n    \"\"\"\n    # Create InputList and Result instances to mirror the SRS domain model.\n    _ = InputList(elements)\n    \n    checker = CheckConsecutive()\n    is_consecutive = checker.check(elements)\n    \n    _ = Result(is_consecutive)\n    \n    return is_consecutive", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/471": [{"task_id": "Mbpp/471", "solution": "def find_remainder(arr, n):\n    \"\"\"Compute product of integers in arr modulo n.\n    Applies per-step modular reduction to avoid overflow.\n    \"\"\"\n    # Per critical requirements: no validation checks or helper functions are included.\n    # Assumes `n` is an integer > 0 and `arr` is an iterable of integers.\n\n    # Handle the empty array case as defined in the design:\n    # the product of an empty set is 1. The result is 1 % n.\n    if not arr:\n        return 1 % n\n\n    running_product = 1\n    for elem in arr:\n        # Apply per-step modular reduction to prevent intermediate results from overflowing.\n        running_product = (running_product * elem) % n\n\n    # The running_product is already within the range [0, n-1] due to the per-step modulo.\n    return running_product", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/471", "solution": "def compute_product_mod(array_of_integers: list[int], n: int) -> int:\n    \"\"\"\n    Com