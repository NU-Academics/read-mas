ems is a list and all elements are ints; False otherwise.\"\"\"\n        if not isinstance(self.items, list):\n            return False\n        for item in self.items:\n            if not isinstance(item, int):\n                return False\n        return True\nclass Subarray:\n    \"\"\"Represents a contiguous subsequence and computes its sum.\"\"\"\n    def __init__(self, items: List[int], start_index: int, end_index: int):\n        self.items: List[int] = items\n        self.start_index: int = start_index\n        self.end_index: int = end_index\n        self.length: int = end_index - start_index + 1\n\n    def sum(self) -> int:\n        \"\"\"Return sum(self.items[self.start_index:self.end_index+1]).\"\"\"\n        return sum(self.items[self.start_index : self.end_index + 1])\nclass OddLengthSum:\n    \"\"\"Computes aggregated total of odd-length contiguous subarrays for a validated InputList.\"\"\"\n    def compute(self, input_list: InputList) -> int:\n        \"\"\"Compute and return aggregated sum of all odd-length contiguous subarrays of input_list.\"\"\"\n        total_sum = 0\n        n = input_list.length\n        for start_index in range(n):\n            for end_index in range(start_index, n):\n                length = end_index - start_index + 1\n                if length % 2 != 0:\n                    subarray = Subarray(input_list.items, start_index, end_index)\n                    total_sum += subarray.sum()\n        return total_sum\ndef odd_length_sum(items: List) -> int:\n    \"\"\"\n    Public API. Accepts items (list of int). Returns int aggregate sum of odd-length contiguous subarrays.\n    Raises TypeError on invalid input.\n    \"\"\"\n    input_list = InputList(items)\n    if not input_list.validate():\n        raise TypeError(\"items must be a list of integers\")\n\n    if input_list.length == 0:\n        return 0\n\n    calculator = OddLengthSum()\n    total_sum_result = calculator.compute(input_list)\n    return total_sum_result", "base