    return x_p, y_p", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/160", "solution": "def _extended_gcd(a, b):\n    \"\"\"\n    Computes (s, t, d) such that a*s + b*t = d, where d is gcd(a, b).\n    d is always non-negative.\n    \"\"\"\n    if a == 0 and b == 0:\n        return 0, 0, 0 # gcd(0,0)=0, and 0*0 + 0*0 = 0\n    \n    s_curr, t_curr = 1, 0\n    s_prev, t_prev = 0, 1\n    \n    orig_a, orig_b = a, b # Store original values for sign adjustment\n    a, b = abs(a), abs(b) # Work with absolute values to get positive gcd\n    \n    while b != 0:\n        q = a // b\n        a, b = b, a % b\n        s_curr, s_prev = s_prev, s_curr - q * s_prev\n        t_curr, t_prev = t_prev, t_curr - q * t_prev\n            \n    d = a # d is the GCD, which is always positive\n    \n    # Adjust s_curr, t_curr for the original signs of a and b\n    # We have abs(orig_a)*s + abs(orig_b)*t = d.\n    # To get orig_a*S + orig_b*T = d, S = s*sign(orig_a), T = t*sign(orig_b).\n    s_final = s_curr\n    t_final = t_curr\n    if orig_a < 0:\n        s_final = -s_final\n    if orig_b < 0:\n        t_final = -t_final\n            \n    return s_final, t_final, d\ndef find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"\n    Finds integer solutions (x, y) for the linear Diophantine equation a*x + b*y = n.\n    Returns (x, y) if a solution exists, otherwise returns None.\n    \"\"\"\n    # Handle the special case where both a and b are zero\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n\n    s, t, d = _extended_gcd(a, b)\n\n    # Check if a solution exists (n must be divisible by d)\n    if n % d != 0:\n        return None\n\n    # Scale Bezout coefficients to find a particular solution (x0, y0)\n    k_factor = n // d\n    x_particular = s * k_factor\n    y_particular = t * k_factor\n\n    # Adjust the particular solution to a canonical form, typically where x is in [0, abs(b/d)-1).\n    # This helps in providing a consistent output for multiple solutions, matching specific test cases.\n    if b == 0:\n        # If b is 0, then a*x = n. x = n/a, y can be anything.\n        # Our extended_gcd already gives a specific x, and y_particular=0.\n        # No further adjustment needed, x_particular is (n // a) and y_particular is 0.\n        pass\n    else:\n        # x_step represents abs(b/d), which is the period of x values in general solution\n        x_step_size = b // d\n        \n        # Calculate a new x (x_shifted) that is congruent to x_particular modulo x_step_size.\n        # Python's % handles negative numbers such that result has same sign as divisor.\n        # We want smallest non-negative x if x_step_size > 0, or largest x in negative range if x_step_size < 0.\n        x_shifted = x_particular % x_step_size\n\n        # Determine the 'k' that transformed x_particular to x_shifted\n        k_transform = (x_shifted - x_particular) // x_step_size\n\n        # Apply the same 'k' to y_particular to get y_shifted\n        y_step_size = a // d\n        y_shifted = y_particular - k_transform * y_step_size\n        \n        x_particular, y_particular = x_shifted, y_shifted\n\n    # Verify the solution before returning (as per design)\n    if a * x_particular + b * y_particular == n:\n        return (x_particular, y_particular)\n    else:\n        # This case should ideally not be reached with correct arithmetic\n        return None", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[25, 123, 7]]}], "Mbpp/161": [{"task_id": "Mbpp/161", "solution": "def remove_elements(source_list, elements_to_remove):\n    \"\"\"\n    Returns a new list with elements from source_list that are not in elements_to_remove.\n    Preserves the original relative order of elements.\n    \"\"\"\n    if not elements_to_remove:\n        return list(source_list) # Return a new list as per design\n    \n    elements_to_remove_set = set(elements_to_remove)\n    result_list = []\n    \n    for element in source_list:\n        if element not in elements_to_remove_set:\n            result_list.append(element)\n            \n    return result_list", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[1, "apple", [1, 2], [3, 4], {"name": "John"}, 5.5], [2, "apple", [3, 4], {"name": "John"}, 5.5]]]}, {"task_id": "Mbpp/161", "solution": "def remove_elements(source_list, removal_list):\n    \"\"\"Return a new list with elements from source_list that are not in removal_list.\n    Preserves order and removes all matching occurrences using standard equality.\n    \"\"\"\n    elements_to_remove = set(removal_list)\n    result_list = []\n    for item in source_list:\n        if item not in elements_to_remove:\n            result_list.append(item)\n    return result_list", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[1, "apple", [1, 2], [3, 4], {"name": "John"}, 5.5], [2, "apple", [3, 4], {"name": "John"}, 5.5]]]}], "Mbpp/165": [{"task_id": "Mbpp/165", "solution": "def _is_alpha(c: str) -> bool:\n    \"\"\"Checks if character is a single English alphabetic letter (A-Z or a-z).\"\"\"\n    return len(c) == 1 and 'a' <= c.lower() <= 'z'\ndef _normalize_char(c: str) -> str:\n    \"\"\"Converts an alphabetic character to its lowercase form.\"\"\"\n    return c.lower()\ndef _map_alpha_position(c: str) -> int:\n    \"\"\"Maps a lowercase English letter to its 1-based alphabet position (a=1, b=2, ...).\"\"\"\n    # This helper assumes its input is a single lowercase English letter.\n    return ord(c) - ord('a') + 1\ndef count_char_position(input: str) -> int:\n    \"\"\"\n    Counts characters in the input string whose English alphabet position equals their 1-based string position.\n    Non-alphabetic characters occupy positions but are ignored for counting.\n    \"\"\"\n    matching_count = 0\n    for position, char_val in enumerate(input, start=1):\n        if _is_alpha(char_val):\n            normalized_char = _normalize_char(char_val)\n            alpha_position = _map_alpha_position(normalized_char)\n            if alpha_position == position:\n                matching_count += 1\n    return matching_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/165", "solution": "class InputString:\n    \"\"\"Encapsulates input string and provides 1-based character access.\n    Raises IndexError for invalid 1-based positions.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the string.\"\"\"\n        return len(self.value)\n\n    def char_at(self, pos: int) -> str:\n        \"\"\"Returns the character at the 1-based position.\n        This method will raise an IndexError if 'pos' is out of bounds.\"\"\"\n        return self.value[pos - 1]\nclass Alphabet:\n    \"\"\"Provides mapping for 1-26 positions to 'a'-'z' letters.\n    Raises ValueError for positions outside this range.\"\"\"\n    def __init__(self):\n        self.letters = [chr(i) for i in range(ord('a'), ord('z') + 1)]\n\n    def letter_at(self, pos: int) -> str:\n        \"\"\"Returns the alphabet letter for a 1-based position.\n        Position must be between 1 and 26 (inclusive).\"\"\"\n        if not (1 <= pos <= 26):\n            raise ValueError(\"Position must be between 1 and 26 for alphabet lookup.\")\n        return self.letters[pos - 1]\nclass PositionMatch:\n    \"\"\"Represents per-position computed information and match evaluation.\n    Determines if a character matches its alphabet position.\"\"\"\n    def __init__(self, position: int, character: str):\n        self.position = position\n        self.character = character\n        self.is_letter = 'a' <= self.character.lower() <= 'z'\n\n    def is_match(self, alphabet: Alphabet) -> bool:\n        \"\"\"Evaluates if the character matches the alphabet letter at its position.\n        Considers position limits, letter status, and case-insensitivity.\"\"\"\n        if self.position > 26:\n            return False\n        if not self.is_letter:\n            return False\n        return self.character.lower() == alphabet.letter_at(self.position)\nclass CountResult:\n    \"\"\"Represents the final aggregated result count.\n    Holds the total number of matching characters.\"\"\"\n    def __init__(self, count: int):\n        self._count = count\n\n    @property\n    def count(self) -> int:\n        \"\"\"The total count of matching characters.\"\"\"\n        return self._count\nclass CountService:\n    \"\"\"Orchestrates counting characters matching their alphabet position.\n    Implements the core algorithm based on business rules.\"\"\"\n    def count_char_position(self, s: str) -> int:\n        \"\"\"Counts characters matching their 1-based alphabet position.\n        Handles empty input, iterates positions, and aggregates matches.\"\"\"\n        input_string = InputString(s)\n        alphabet = Alphabet()\n\n        if input_string.length() == 0:\n            return 0\n\n        match_count = 0\n        for pos in range(1, input_string.length() + 1):\n            char = input_string.char_at(pos)\n            position_match = PositionMatch(position=pos, character=char)\n            \n            if position_match.is_match(alphabet):\n                match_count += 1\n        \n        count_result = CountResult(match_count)\n        return count_result.count\ndef count_char_position(s: str) -> int:\n    \"\"\"Counts characters in a string that match their 1-based alphabet position.\n    This is the top-level API function, delegating to CountService.\"\"\"\n    return CountService().count_char_position(s)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/162": [{"task_id": "Mbpp/162", "solution": "class SumSeriesFunction:\n   