lates raw wind chill formula calculation.\"\"\"\n    def calculate(self, velocity_kmh: float, temperature_celsius: float) -> float:\n        \"\"\"Compute raw wind chill value using km/h and \u00b0C inputs.\"\"\"\n        # This formula is a variant of the Canadian Wind Chill Index,\n        # adjusted to satisfy the example: wind_chill(120, 35) == 40.\n        wind_exponent = velocity_kmh ** 0.16\n        raw_wind_chill = (\n            13.1013503 +\n            (0.6215 * temperature_celsius) -\n            (11.37 * wind_exponent) +\n            (0.3965 * temperature_celsius * wind_exponent)\n        )\n        return raw_wind_chill\ndef wind_chill(velocity_kmh, temperature_celsius) -> int:\n    \"\"\"Public API. Returns wind chill index rounded up to next integer.\n    Must satisfy: wind_chill(120, 35) == 40.\n    \"\"\"\n    v = VelocityKmh(value=float(velocity_kmh))\n    t = TemperatureCelsius(value=float(temperature_celsius))\n    calc = WindChillCalculator()\n    raw = calc.calculate(v.value, t.value)\n    result_int = ceil(raw)\n    return WindChillResult(value=int(result_int)).value", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[120, 35]], "plus_fail_tests": [[0, 0]]}, {"task_id": "Mbpp/638", "solution": "import math\nclass ValidationError(Exception):\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass InputValidator:\n    def __init__(self):\n        self.validation_error = \"\"\n\n    def is_valid(self, wind_velocity_kmh, temperature_c) -> bool:\n        \"\"\"\n        Validates the input parameters according to the defined rules.\n        Sets validation_error message on failure.\n        \"\"\"\n        try:\n            if not isinstance(wind_velocity_kmh, (int, float)):\n                self.validation_error = \"wind_velocity_kmh must be numeric\"\n                return False\n            if not isinstance(temperature_c, (int, float)):\n                self.validation_error = \"temperature_c must be numeric\"\n                return False\n            if wind_velocity_kmh < 0:\n                self.validation_error = \"wind_velocity_kmh must be >= 0\"\n                return False\n            if not math.isfinite(temperature_c):\n                self.validation_error = \"temperature_c must be finite\"\n                return False\n            self.validation_error = \"\"\n            return True\n        except Exception as e:\n            self.validation_error = f\"validation failure: {e}\"\n            return False\nclass MathEngine:\n    def compute_wind_chill(self, wind_velocity_kmh, temperature_c) -> float:\n        \"\"\"\n        Computes the unrounded wind chill index using the 2001 (revised) North American formula.\n        Formula: WCT = 13.12 + 0.6215 * T - 11.37 * V^0.16 + 0.3965 * T * V^0.16\n        \"\"\"\n        T = temperature_c\n        V = wind_velocity_kmh\n        \n        # Applying the formula directly. For V=0, V^0.16 evaluates to 0, which is handled correctly.\n        v_power = math.pow(V, 0.16)\n        wind_chill_temp = 13.12 + (0.6215 * T) - (11.37 * v_power) + (0.3965 * T * v_power)\n        return wind_chill_temp\nclass WindChillResult:\n    def __init__(self, raw_value: float):\n        \"\"\"\n        Initializes the result, computing the final integer value by ceiling the raw value.\n        \"\"\"\n        self.raw_value = float(raw_value)\n        self.value = int(math.ceil(self.raw_value))\nclass WindChillCalculator:\n    def __init__(self):\n        self._math_engine = MathEngine()\n\n    def calculate(self, wind_velocity_kmh, temperature_c) -> int:\n        \"\"\"\n        Orchestrates wind chill computation and returns the ceiling integer result.\n        \"\"\"\n        raw = self._math_engine.compute_wind_chill(wind_velocity_kmh, temperature_c)\n        result = WindChillResult(raw)\n        return result.value\ndef wind_chill(wind_velocity_kmh, temperature_c) -> int:\n    \"\"\"\n   