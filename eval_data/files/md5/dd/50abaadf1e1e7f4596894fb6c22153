ries.\n    Each dictionary in the list is a unique instance.\n    \"\"\"\n    return [dict() for _ in range(n)]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/568", "solution": "def empty_list(n: int) -> list:\n    \"\"\"Create and return a list of n distinct empty dictionaries. Each element will be a unique empty dictionary object.\"\"\"\n    return [{} for _ in range(n)]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/569": [{"task_id": "Mbpp/569", "solution": "def _sorted_sublist(sublist: list) -> list:\n    \"\"\"Return a sorted copy of a single sublist.\n    Uses the runtime's standard string comparison for lexicographical ordering.\n    \"\"\"\n    return sorted(sublist)\ndef sort_sublists(input_list: list) -> list:\n    \"\"\"Sorts each sublist of strings in the given list of lists.\n    The outer list order is preserved, and each inner list is sorted in ascending lexicographical order.\n    \"\"\"\n    return [_sorted_sublist(sublist) for sublist in input_list]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/569", "solution": "from typing import List, Any\nclass ValidationError(Exception):\n    \"\"\"Represents an error during input validation.\"\"\"\n    def __init__(self, message: str) -> None:\n        \"\"\"Initializes the validation error with a message.\"\"\"\n        super().__init__(message)\n        self.message = message\n\n    def __str__(self) -> str:\n        \"\"\"Returns the error message for string representation.\"\"\"\n        return self.message\nclass SortSublistsFunction:\n    \"\"\"Encapsulates business logic for validating and sorting sublists.\"\"\"\n    def validate(self, input: Any) -> None:\n        \"\"\"Validates that input is a list of lists of strings, raising ValidationError on violations.\"\"\"\n        if not isinstance(input, list):\n            raise ValidationError(\"Input must be a list.\")\n\n        for i, sublist in enumerate(input):\n            if not isinstance(sublist, list):\n                raise ValidationError(f\"Element at index {i} must be a list.\")\n            for j, element in enumerate(sublist):\n                if not isinstance(element, str):\n                    raise ValidationError(f\"Element at index [{i}][{j}] must be a string.\")\n\n    def sort(self, input: List[List[str]]) -> List[List[str]]:\n        \"\"\"Sorts each sublist lexicographically while preserving outer order.\"\"\"\n        return [sorted(sublist) for sublist in input]\ndef sort_sublists(input: List[List[str]]) -> List[List[str]]:\n    \"\"\"Public API to sort sublists, performing validation and sorting.\"\"\"\n    processor = SortSublistsFunction()\n    processor.validate(input)\n    return processor.sort(input)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/572": [{"task_id": "Mbpp/572", "solution": "from typing import List, Dict, Any\ndef _build_frequency_map(input_list: List[Any]) -> Dict[Any, int]:\n    \"\"\"\n    Builds a frequency map for elements in the input list.\n    Returns a dictionary mapping each element to its occurrence count.\n    \"\"\"\n    frequency_map: Dict[Any, int] = {}\n    for item in input_list:\n        frequency_map[item] = frequency_map.get(item, 0) + 1\n    return frequency_map\ndef two_unique_nums(input_list: List[Any]) -> List[Any]:\n    \"\"\"\n    Returns a new list containing numbers that occur exactly once in the input, preserving original relative order.\n    The input list is not modified.\n    \"\"\"\n    frequency_map = _build_frequency_map(input_list)\n    output_list: List[Any] = []\n    for item in input_list:\n        if frequency_map[item] == 1:\n            output_list.append(item)\n    return output_list", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_i