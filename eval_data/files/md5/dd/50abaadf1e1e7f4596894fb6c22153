ncatenation process.\n        Accepts a raw input tuple and returns a single integer.\n        \"\"\"\n        # 1. Validate the input and get normalized elements.\n        normalized_elements = self._validator.validate(input_tuple_raw)\n\n        # 2. Concatenate the validated elements.\n        concatenated_int_value = self._concatenator.concatenate(normalized_elements)\n\n        # 3. Create OutputInteger model as per design.\n        output_integer_model = OutputInteger(concatenated_int_value)\n\n        return output_integer_model.value\ndef tuple_to_int(input_tuple):\n    \"\"\"\n    Converts a tuple of positive integers into a single integer by concatenation.\n    This is the public entry point for the library component.\n    \"\"\"\n    validator_instance = Validator()\n    concatenator_instance = Concatenator()\n    adapter = TupleToIntFunction(validator_instance, concatenator_instance)\n    return adapter.tuple_to_int(input_tuple)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/116", "solution": "import pytest\nfrom src.tuple_to_int import tuple_to_int", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/118": [{"task_id": "Mbpp/118", "solution": "def string_to_list(input_string: str) -> list[str]:\n    \"\"\"Splits the input string on the literal space character.\n    Returns a list of substrings preserving order.\n    \"\"\"\n    return input_string.split(' ')", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/118", "solution": "def string_to_list(input: str) -> list[str]:\n    \"\"\"Splits an input string on the ASCII space character.\n    Returns an ordered list of string tokens.\"\"\"\n    return input.split(' ')", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/119": [{"task_id": "Mbpp/119", "solution": "def search(input_list: list) -> int:\n    \"\"\"Return the unique element from a sorted list where all other elements appear twice.\n    This uses an O(log n) binary search approach.\"\"\"\n    low = 0\n    high = len(input_list) - 1\n\n    while low < high:\n        mid = low + (high - low) // 2\n\n        # Ensure 'mid' points to the start of a potential pair (an even index).\n        # If 'mid' is odd, decrement it to make it an even index.\n        if mid % 2 == 1:\n            mid -= 1\n\n        # If elements at 'mid' and 'mid + 1' are equal, they form a pair.\n        # The unique element must be in the array segment after this pair.\n        if input_list[mid] == input_list[mid + 1]:\n            low = mid + 2\n        # Otherwise, the unique element is either at 'mid' or somewhere before it.\n        # The search space is narrowed to the left half including 'mid'.\n        else:\n            high = mid\n\n    # When the loop terminates, 'low' (and 'high') points to the index of the unique element.\n    return input_list[low]", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[]]]}, {"task_id": "Mbpp/119", "solution": "from typing import List\ndef validate_input(nums: List[int]) -> bool:\n    \"\"\"Validate SRS preconditions: nums is a list of ints, sorted non-decreasingly,\n    and exactly one element occurs once while all others occur twice.\n    Returns True if valid, False otherwise.\"\"\"\n    if not isinstance(nums, list):\n        return False\n    if not nums:  # An empty list cannot satisfy the conditions\n        return False\n\n    counts = {}\n    for i, x in enumerate(nums):\n        if not isinstance(x, int):\n            return False\n        if i > 0 and nums[i] < nums[i-1]:  # Check non-decreasing order\n            return False\n        counts[x] = counts.get(x, 0) + 1\n\n    unique_count = 0\n    for count in counts.values():\n        if count == 1:\n            unique_count += 1\n        elif count != 2:\n            return False\n\n    return unique_count == 1\ndef search(nums: List[int]) -> int:\n    \"\"\"Return the integer that appears only once in the sorted list nums.\n    Raises ValueError if nums does not meet SRS preconditions.\n    Signature matches SRS: search(nums: List[int]) -> int.\"\"\"\n    if not validate_input(nums):\n        raise ValueError(\"Input list does not meet preconditions (type, sortedness, or element counts).\")\n\n    # Linear scan approach: iterate with a step of 2.\n    # The unique element breaks the pair pattern.\n    i = 0\n    while i < len(nums) - 1:\n        if nums[i] != nums[i+1]:\n            return nums[i]\n        i += 2\n    \n    # If the loop completes, the unique element is the last one in the list.\n    return nums[len(nums)-1]", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[]]]}], "Mbpp/120": [{"task_id": "Mbpp/120", "solution": "from typing import Union, Iterable\nNumber = Union[int, float]\nclass TuplePair:\n    \"\"\"\n    Encapsulates a pair of numeric values for product calculation.\n    Provides methods to compute the product and its absolute value.\n    \"\"\"\n    def __init__(self, a: Number, b: Number):\n        self.a = a\n        self.b = b\n\n    def product(self) -> Number:\n        \"\"\"Calculates the product of the two elements.\"\"\"\n        return self.a * self.b\n\n    def abs_product(self) -> Number:\n        \"\"\"Calculates the absolute product of the two elements.\"\"\"\n        return abs(self.a * self.b)\ndef max_product_tuple(input_list: Iterable[tuple[Number, Number]]) -> Number:\n    \"\"\"\n    Computes the maximum absolute product from an iterable of 2-element numeric tuples.\n    This function directly processes input, assuming its validity per critical requirements.\n    \"\"\"\n    abs_products = [TuplePair(a, b).abs_product() for a, b in input_list]\n    return max(abs_products)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/120", "solution": "from dataclasses import dataclass\nfrom typing import Iterable, Tuple, List\nimport numbers\nclass ProductComputation:\n    \"\"\"\n    Encapsulates the computation of the absolute product for a pair.\n    This class is stateless and provides a method to compute abs(a*b).\n    \"\"\"\n    def computeAbsProduct(self, pair: TuplePair) -> float:\n        \"\"\"\n        Computes the absolute value of the product of the elements in a TuplePair.\n        Returns a float representing abs(pair.a * pair.b).\n        \"\"\"\n        # Ensure calculations are float to handle potential mixed types (int and float)\n        # and to ensure the return type is consistently float as specified.\n        return abs(float(pair.a) * float(pair.b))\ndef _validate_input(input_iterable: Iterable[Tuple]) -> List[TuplePair]:\n    \"\"\"\n    Validates the input iterable's structure and element types.\n    Converts valid elements into TuplePair instances, raising ValueError for invalid or empty input.\n    \"\"\"\n    # Check if the input is actually an iterable. Using typing.Iterable for runtime check.\n    if not isinstance(input_iterable, Iterable):\n        raise ValueError('Input must be an iterable.')\n\n    validated_pairs: List[TuplePair] = []\n    has_elements = False\n    \n    for i, element in enumerate(input_iterable):\n        has_elements = True\n        # Check if element is a 2-length tuple or list\n        if not isinstance(element, (tuple, list)):\n            raise ValueError(f'Element at index {i} must be a tuple or list, got {type(element).__name__}.')\n        if len(element) != 2:\n            raise ValueError(f'Tuple/list at index {i} must have exactly 2 elements, got {len(element)}.')\n\n        # Check if elements within the tuple are numeric (numbers.Real covers int and float)\n        num1, num2 = element[0], element[1]\n        if not isinstance(num1, numbers.Real):\n            raise ValueError(f'First element of tuple/list at index {i} must be numeric, got {type(num1).__name__}.')\n        if not isinstance(num2, numbers.Real):\n            raise ValueError(f'Second element of tuple/list at index {i} must be numeric, got {type(num2).__name__}.')\n        \n        validated_pairs.append(TuplePair(a=num1, b=num2))\n    \n    if not has_elements:\n        raise ValueError('Input list must be non-empty.')\n            \n    return validated_pairs\ndef max_product_tuple(input_iterable: Iterable[Tuple]) -> float:\n    \"\"\"\n    Computes the maximum absolute product from a list of 2-element numeric tuples.\n    It validates input, computes per-tuple absolute products, and returns the maximum.\n    \"\"\"\n    # Orchestrates validation, computation, and aggregation as per design.\n    validated_pairs = _validate_input(input_iterable)\n\n    product_computation = ProductComputation()\n    \n    # Initialize with negative infinity to ensure any valid absolute product will be greater.\n    max_abs_product_value: float = -float('inf') \n\n    for pair in validated_pairs:\n        current_abs_product = product_computation.computeAbsProduct(pair)\n        if current_abs_product > max_abs_product_value:\n            max_abs_product_value = current_abs_product\n            \n    # The OutputResult DTO is part of the design but the function's public API directly returns a float.\n    return max_abs_product_value", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/125": [{"task_id": "Mbpp/125", "solution": "def find_length(s: str) -> int:\n    \"\"\"\n    Computes the maximum difference between the number of '0' characters and '1' characters\n    across all contiguous non-empty substrings of a binary input string using Kadane's algorithm.\n    Returns 0 for an empty input string.\n    \"\"\"\n    if not s:\n        return 0\n\n    # Map '0' to +1 and '1' to -1\n    mapped_numbers = []\n    for char in s:\n        if char == '0':\n            mapped_numbers.append(1)\n        else:  # char == '1'\n            mapped_numbers.append(-1)\n\n    max_so_far = 0\n    current_max = 0\n\n    # Kadane's algorithm to find the maximum subarray sum\n    for num in mapped_numbers:\n        current_max += num\n        if current_max < 0:\n            current_max = 0\n        if current_max > max_so_far:\n            max_so_far = current_max\n\n    return max_so_far", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/125", "solution": "from typing import List\nfrom src.substring import Substring", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/124": [{"task_id": "Mbpp/124", "solution": "import math\ndef angle_complex(c):\n    # Computes the principal argument (angle) of a complex number in radians.\n    # It converts the input to a complex number and uses math.atan2.\n    z = complex(c)\n    angle = math.atan2(z.imag, z.real)\n    return float(angle)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [["0.0", "1j"]], "plus_fail_tests": [["0.0", "0j"]]}, {"task_id": "Mbpp/124", "solution": "import math\nfrom dataclasses import dataclass\nfrom typing import Union, Any\nclass InputValidator:\n    \"\"\"Validates inputs for numeric or complex types.\n    Raises TypeError or ValueError for invalid inputs as per BR6.\n    \"\"\"\n    @staticmethod\n    def validate(real: Any, imag: Any) -> bool:\n        \"\"\"Checks if inputs are valid numeric types (int, float, complex).\n        Raises TypeError for unsupported types.\n        \"\"\"\n        valid_types = (int, float, complex)\n        if not isinstance(real, valid_types):\n            raise TypeError(f\"Invalid type for real component: {type(real)}. Expected int, float, or complex.\")\n        if not isinstance(imag, valid_types):\n            raise TypeError(f\"Invalid type for imaginary component: {type(imag)}. Expected int, float, or complex.\")\n        return True\nclass MathLibrary:\n    \"\"\"Thin wrapper around Python's math.atan2 to centralize the dependency.\"\"\"\n    @staticmethod\n    def atan2(y: float, x: float) -> float:\n        \"\"\"Computes the arctangent of y/x, handling quadrants correctly.\"\"\"\n        return math.atan2(y, x)\ndef _normalize_to_complex(real: Union[int, float, complex], imag: Union[int, float, complex]) -> ComplexNumber:\n    \"\"\"Normalizes real and imag components into a ComplexNumber instance.\n    Handles Python complex types deterministically by composing real/imag parts.\n    \"\"\"\n    # Design's normalization rule:\n    # real_part = (real.real if isinstance(real, complex) else real) + (imag.real if isinstance(imag, complex) else 0)\n    # imag_part = (imag.imag if isinstance(imag, complex) else imag) + (real.imag if isinstance(real, complex) else 0)\n\n    # Initialize parts based on non-complex values or real/imag parts of complex values.\n    normalized_real_component = real.real if isinstance(real, complex) else float(real)\n    normalized_imag_component = imag.imag if isinstance(imag, complex) else float(imag)\n\n    # Add cross-component real/imaginary parts if applicable.\n    real_sum = normalized_real_component + (imag.real if isinstance(imag, complex) else 0.0)\n    imag_sum = normalized_imag_component + (real.imag if isinstance(real, complex) else 0.0)\n\n    return ComplexNumber(real=real_sum, imag=imag_sum)\ndef angle_complex(real: Union[int, float, complex], imag: Union[int, float, complex]) -> float:\n    \"\"\"Computes the argument (angle) of a complex number and returns it in radians.\n    It validates inputs, normalizes them, and delegates trigonometric computation.\n    \"\"\"\n    InputValidator.validate(real, imag)\n    complex_num = _normalize_to_complex(real, imag)\n    return MathLibrary.atan2(complex_num.imag, complex_num.real)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests":