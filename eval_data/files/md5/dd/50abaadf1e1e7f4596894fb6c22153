  return True\ndef count_element_in_list(list_of_sublists, element) -> int:\n    \"\"\"\n    Counts how many sublists within a list of sublists contain a specific element.\n\n    This function iterates through a main list, and for each sublist, checks if\n    it contains the specified element using equality comparison (==). Each sublist\n    is counted at most once, even if the element appears multiple times within it.\n\n    Parameters:\n        list_of_sublists: An iterable whose elements are themselves iterables.\n                          Examples include lists of lists, tuples of tuples, etc.\n                          Strings are considered iterables.\n        element: Any Python object to search for within the sublists.\n\n    Returns:\n        int: The total count of sublists that contain the element. Returns 0\n             if the input list_of_sublists is empty, or if no sublists contain\n             the element.\n\n    Raises:\n        TypeError: If 'list_of_sublists' is not an iterable of iterables.\n\n    Example Usage:\n        >>> count_element_in_list([[1, 3], [5, 7], [1, 11], [1, 15, 7]], 1)\n        3\n    \"\"\"\n    if not is_iterable_of_iterables(list_of_sublists):\n        raise TypeError(\"list_of_sublists must be an iterable of iterables.\")\n\n    total_count = 0\n    for sublist in list_of_sublists:\n        for item in sublist:\n            if item == element:\n                total_count += 1\n                break\n    return total_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/425", "solution": "from typing import Iterable, Any, Iterator\nclass CountResult:\n    def __init__(self, initial: int = 0) -> None:\n        \"\"\"Initializes the count result to a given initial value.\n        It acts as a value object to hold the integer count.\"\"\"\n        self._value: int = initial\n\n    def increment(self) -> None:\n        \"\"\"Increments the internal count by one.\"\"\"\n        self._value += 1\n\n    def get(self) -> int:\n        \"\"\"Returns the current integer count.\"\"\"\n        return self._value\nclass Sublist:\n    def __init__(self, elements: Iterable[Any]) -> None:\n        \"\"\"Initializes a Sublist with its elements, storing raw values for direct comparison.\n        This design choice aligns with using raw values for comparisons as per spec.\"\"\"\n        self._elements = elements\n\n    def contains(self, target_element: Any) -> bool:\n        \"\"\"Checks if the sublist contains the target element using equality (==).\n        It stops and returns True upon the first match.\"\"\"\n        for element_in_sublist in self._elements:\n            if element_in_sublist == target_element:\n                return True\n        return False\nclass SublistsCollection:\n    def __init__(self, sublists: Iterable[Iterable[Any]]) -> None:\n        \"\"\"Initializes the collection of immediate sublists.\n        It encapsulates the top-level sequence for iteration.\"\"\"\n        self._sublists = sublists\n\n    def get_immediate_sublists(self) -> Iterator[Sublist]:\n        \"\"\"Yields Sublist objects for each immediate sublist in the collection.\n        This method supports iterating over the top-level sublists.\"\"\"\n        for sublist_data in self._sublists:\n            yield Sublist(sublist_data)\nclass CountElementInList:\n    def __init__(self) -> None:\n        \"\"\"Initializes the service with a new CountResult.\n        It orchestrates the counting process.\"\"\"\n        self._result = CountResult()\n\n    def validate_input(self, sublists: Any) -> None:\n        \"\"\"Validates the top-level input is an iterable.\n        This method is a no-op as critical requirements forbid raising exceptions.\"\"\"\n        pass # As per critical requirements, exceptions for validation are forbidden.\n\n    def count(self, sublists: Iterable[Iterable[Any]], element: Any) -> int:\n        \"\"\"Counts immediate sublists containing the element, after input validation.\n        It iterates through the collection and increments count for matching sublists.\"\"\"\n        self.validate_input(sublists)\n\n        collection = SublistsCollection(sublists)\n        for immediate_sublist_obj in collection.get_immediate_sublists():\n            if immediate_sublist_obj.contains(element):\n                self._result.increment()\n        return self._result.get()\ndef count_element_in_list(sublists: Iterable[Iterable[Any]], element: Any) -> int:\n    \"\"\"\n    Counts the number of immediate sublists that contain the given element at least once.\n    This public API function delegates the core logic to a class-based implementation.\n    \"\"\"\n    counter_service = CountElementInList()\n    return counter_service.count(sublists, element)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/427": [{"task_id": "Mbpp/427", "solution": "from dataclasses import dataclass\ndef change_date_format(input: str) -> str:\n    \"\"\"\n    Converts a date string from yyyy-mm-dd to dd-mm-yyyy format.\n    Uses internal data classes for parsing and formatting.\n    \"\"\"\n    input_date = InputDateString(raw=input)\n\n    day = input_date.get_day()\n    month = input_date.get_month()\n    year = input_date.get_year()\n\n    formatted_raw = f\"{day}-{month}-{year}\"\n    formatted_date = FormattedDateString(raw=formatted_raw)\n\n    return formatted_date.to_string()", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [["2026-01-02"]], "plus_fail_tests": [["2021-1-026"]]}, {"task_id": "Mbpp/427", "solution": "from dataclasses import dataclass\ndef change_date_format(raw: str) -> str:\n    \"\"\"Converts a date string from yyyy-mm-dd to dd-mm-yyyy format.\n    Assumes input is valid yyyy-mm-dd and zero-pads month/day as needed.\"\"\"\n    date_obj = DateString.from_raw(raw)\n    month_padded = date_obj.month.zfill(2)\n    day_padded = date_obj.day.zfill(2)\n    return f\"{day_padded}-{month_padded}-{date_obj.year}\"", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [["2026-01-02"]], "plus_fail_tests": [["2021-1-026"]]}], "Mbpp/428": [{"task_id": "Mbpp/428", "solution": "from typing import List\nfrom src.array_model import Array, Element\nclass ShellSortFunction:\n    \"\"\"\n    Encapsulates the Shell sort algorithm.\n    Provides methods for sorting and helper operations.\n    \"\"\"\n    def shell_sort(self, array: Array) -> Array:\n        \"\"\"\n        Sorts the given Array using the Shell sort algorithm.\n        The sorting is done in-place on the Array object.\n        \"\"\"\n        n = array.length()\n        gaps = self._choose_gap_sequence(n)\n\n        for gap in gaps:\n            # Perform a gapped insertion sort for each 'sub-array'\n            # starting at indices 0, 1, ..., gap-1\n            for i in range(gap):\n                self._insert_with_gap(array, i, gap)\n        return array\n\n    def _choose_gap_sequence(self, length: int) -> List[int]:\n        \"\"\"\n        Generates a gap sequence for Shell sort.\n        Uses a common sequence where gap = length // 2, then gap //= 2.\n        \"\"\"\n        gaps: List[int] = []\n        gap = length // 2\n        while gap > 0:\n            gaps.append(gap)\n            gap //= 2\n        return gaps\n\n    def _compare(self, a: Element, b: Element) -> int:\n        \"\"\"\n        Compares two Element objects based on their integer values.\n        Returns -1 if a < b, 0 if a == b, 1 if a > b.\n        \"\"\"\n        if a.value < b.value:\n            return -1\n        elif a.value > b.value:\n            return 1\n        return 0\n\n    def _insert_with_gap(self, array: Array, start: int, gap: int) -> None:\n        \"\"\"\n        Performs a gapped insertion sort on a sub-array.\n        This sorts elements separated by 'gap' starting from 'start' index.\n        \"\"\"\n        n = array.length()\n        for i in range(start + gap, n, gap):\n            temp = array.get(i)\n            j = i\n            # Shift elements of the gapped sub-array until the correct position for temp is found\n            while j >= start + gap and self._compare(array.get(j - gap), temp) > 0:\n                array.set(j, array.get(j - gap))\n                j -= gap\n            array.set(j, temp)\ndef shell_sort(array: list[int]) -> list[int]:\n    \"\"\"\n    Public API: Sorts a Python list of integers using Shell sort.\n    Adapts the input list to the domain model and converts the result back.\n    \"\"\"\n    domain_array = Array(array)\n    sorter = ShellSortFunction()\n    sorted_domain_array = sorter.shell_sort(domain_array)\n    return sorted_domain_array.to_list()", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/428", "solution": "class Number:\n    \"\"\"Value object wrapping numeric values (int/float). Immutable.\"\"\"\n    def __init__(self, value):\n        if not isinstance(value, (int, float)):\n            raise TypeError(\"Number must be initialized with an int or float.\")\n        self._value = float(value)\n\n    @property\n    def value(self) -> float:\n        \"\"\"Returns the wrapped numeric value.\"\"\"\n        return self._value\n\n    def __lt__(self, other):\n        if isinstance(other, Number):\n            return self.value < other.value\n        return self.value < other # Allows comparison with native numeric types\n\n    def __le__(self, other):\n        if isinstance(other, Number):\n            return self.value <= other.value\n        return self.value <= other\n\n    def __gt__(self, other):\n        if isinstance(other, Number):\n            return self.value > other.value\n        return self.value > other\n\n    def __ge__(self, other):\n        if isinstance(other, Number):\n            return self.value >= other.value\n        return self.value >= other\n\n    def __eq__(self, other):\n        if isinstance(other, Number):\n            return self.value == other.value\n        return self.value == other\n\n    def __ne__(self, other):\n        return not self.__eq__(other)\n\n    def __repr__(self):\n        return f\"Number({self._value})\"\n\n    def __hash__(self):\n        return hash(self._value)\nclass Array:\n    \"\"\"Ordered collection abstraction of Number elements.\"\"\"\n    def __init__(self, elements: list[Number]):\n        for element in elements:\n            if not isinstance(element, Number):\n                raise TypeError(\"Array elements must be Number instances.\")\n        self._elements = list(elements) # Store a copy of the list\n\n    @property\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the array.\"\"\"\n        return len(self._elements)\n\n    def clone(self) -> 'Array':\n        \"\"\"Returns a new Array instance with cloned Number wrappers.\"\"\"\n        return Array([Number(n.value) for n in self._elements])\n\n    def __getitem__(self, index):\n        return self._elements[index]\n\n    def __setitem__(self, index, value: Number):\n        if not isinstance(value, Number):\n            raise TypeError(\"Cannot set Array element with non-Number type.\")\n        self._elements[index] = value\n\n    def __len__(self):\n        return self.length\n\n    def __repr__(self):\n        return f\"Array({self._elements})\"\n\n    def __eq__(self, other):\n        if not isinstance(other, Array):\n            return NotImplemented\n        return self._elements == other._elements\nclass ShellSortFunction:\n    \"\"\"Encapsulates Shell sort algorithm and helpers.\"\"\"\n\n    def shell_sort(self, input_array: 'Array') -> 'Array':\n        \"\"\"\n        Performs Shell sort on a cloned Array, returning a new sorted Array.\n        Operates on a clone of input_array to preserve input.\n        \"\"\"\n        n = input_array.length\n        if n == 0:\n            return Array([]) # FR4: empty input returns empty array\n\n        arr = input_array.clone() # Do not mutate input (BR2)\n\n        gaps = self._generate_gaps(n)\n\n        for gap in gaps:\n            self._gap_insertion_sort(arr, gap)\n        return arr\n\n    def _generate_gaps(self, n: int) -> list[int]:\n        \"\"\"\n        Produces a gap sequence for n (e.g., classical n//2 sequence).\n        Example: start with n // 2, then //2 until 0.\n        \"\"\"\n        gaps = []\n        gap = n // 2\n        while gap > 0:\n            gaps.append(gap)\n            gap //= 2\n        return gaps\n\n    def _gap_insertion_sort(self, arr: 'Array', gap: int) -> None:\n        \"\"\"\n        Perform gap-based insertion pass, updating arr in place (on the cloned Array).\n        Standard gap-based insertion sort logic.\n        \"\"\"\n        for i in range(gap, arr.length):\n            temp = arr[i]\n            j = i\n            # Shift elements greater than temp to the right\n            while j >= gap and arr[j - gap] > temp:\n                arr[j] = arr[j - gap]\n                j -= gap\n            arr[j] = temp\ndef shell_sort(input):\n    \"\"\"\n    External API entry point for Shell sort.\n    Validates input, converts to Array, delegates, and returns sorted collection.\n    \"\"\"\n    is_list_input = False\n    array_to_sort: Array\n\n    # Input validation (FR5, BR7)\n    if isinstance(input, list):\n        is_list_input = True\n        elements_for_array = []\n        for item in input:\n            if not isinstance(item, (int, float)):\n                raise TypeError(\"List elements must be numeric (int or float).\")\n            elements_for_array.append(Number(item))\n        array_to_sort = Array(elements_for_array)\n    elif isinstance(input, Array):\n        # The Array constructor already validates its elements are Number instances.\n        array_to_sort = input\n    else:\n        raise TypeError(\"Input must be a list or an Array instance.\")\n\n    # Delegate to ShellSortFunction\n    sorted_array = ShellSortFunction().shell_sort(array_to_sort)\n\n    # Convert back to original input type\n    if is_list_input:\n        return [num.value for num in sorted_array._elements]\n    else:\n        return sorted_array", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/429": [{"task_id": "Mbpp/429", "solution": "from typing import Tuple\ndef and_tuples(a: Tuple[int, ...], b: Tuple[int, ...]) -> Tuple[int, ...]:\n    \"\"\"Computes the elementwise bitwise AND of two integer tuples.\n    Returns a new tuple where result[i] == a[i] & b[i].\n    \"\"\"\n    return tuple(x & y for x, y in zip(a, b))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/429", "solution": "def _bitwise_and(x: int, y: int) -> int:\n    \"\"\"Performs the bitwise AND operation between two integers.\"\"\"\n    return x & y\ndef _compute_elementwise_and(a: tuple, b: tuple) -> tuple:\n    \"\"\"Computes elementwise bitwise AND for two tuples.\n    Assumes inputs are tuples of equal length containing integers.\"\"\"\n    return tuple(_bitwise_and(x, y) for x, y in zip(a, b))\ndef and_tuples(a: tuple, b: tuple) -> tuple:\n    \"\"\"Computes elementwise bitwise AND of two integer tuples.\n    This implementation trusts caller inputs and omits validation as per critical requirements.\"\"\"\n    return _compute_elementwise_and(a, b)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/432": [{"task_id": "Mbpp/432", "solution": "from dataclasses import dataclass\nfrom typing import Union\nNumber = Union[int, float]\ndef median_trapezium(a: Number, b: Number, c: Number) -> Number:\n    \"\"\"Compute median (midline) of trapezium as (a + b) / 2.\n    The third argument 'c' is accepted by signature but ignored in computation.\n    \"\"\"\n    return (a + b) / 2", "base_status": "pass", "p