d with no matching opening symbol on the stack.\n            \n            last_opening_symbol = stack.pop()\n            if last_opening_symbol != PAIR_MAP[char]:\n                return False  # Mismatched opening and closing symbols.\n\n    return not stack  # True if the stack is empty (all symbols matched), False otherwise.", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[""]]}, {"task_id": "Mbpp/771", "solution": "import datetime\nfrom typing import Optional", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/772": [{"task_id": "Mbpp/772", "solution": "from typing import List\ndef _tokenize(input_text: str) -> List[str]:\n    \"\"\"Splits input text into a list of word tokens on runs of whitespace.\"\"\"\n    return input_text.split()\ndef _join_tokens(tokens: List[str]) -> str:\n    \"\"\"Joins tokens into a single string with single spaces between them.\"\"\"\n    return ' '.join(tokens)\ndef remove_length(input_text: str, k: int) -> str:\n    \"\"\"\n    Removes all words of length k from the input text, preserving order.\n    Remaining words are joined by single spaces.\n    \"\"\"\n    tokens = _tokenize(input_text)\n    filtered_tokens = [token for token in tokens if len(token) != k]\n    return _join_tokens(filtered_tokens)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/772", "solution": "class TextInput:\n    \"\"\"Container for the input string content.\"\"\"\n    def __init__(self, content: str):\n        self.content = content\nclass Word:\n    \"\"\"Represents a tokenized word with its value.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the word's value.\"\"\"\n        return len(self.value)\nclass ResultString:\n    \"\"\"Container for the resulting string content.\"\"\"\n    def __init__(self, content: str):\n        self.content = content\nclass RemoveLengthFunction:\n    \"\"\"Processes TextInput to remove words of a specific length.\"\"\"\n    def process(self, text_input: TextInput, k: int) -> ResultString:\n        # Tokenize input content by splitting on one-or-more whitespace.\n        tokens = text_input.content.split()\n        words = [Word(token) for token in tokens]\n\n        # Filter out words whose length equals k, preserving order.\n        retained_words = [word for word in words if word.length() != k]\n\n        # Join the values of remaining words with single spaces.\n        result_content = \" \".join([word.value for word in retained_words])\n\n        return ResultString(result_content)\ndef remove_length(input: str, k: int) -> str:\n    \"\"\"\n    Removes all words of length k from the input string.\n    Tokens are split by whitespace, and retained tokens are joined by single spaces.\n    \"\"\"\n    text_input = TextInput(content=input)\n    processor = RemoveLengthFunction()\n    result_string = processor.process(text_input, k)\n    return result_string.content", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/773": [{"task_id": "Mbpp/773", "solution": "from typing import Optional, Tuple\ndef occurance_substring(source: str, substring: str) -> Optional[Tuple[str, int, int]]:\n    \"\"\"Search source for the first occurrence of substring and return (matched_substring, start_index, end_index) or None.\n\n    The function uses zero-based indexing and end_index is exclusive (end_index = start_index + len(substring)).\n    \"\"\"\n    start_index = source.find(substring)\n\n    if start_index == -1:\n        return None\n    else:\n        end_index = start_index + len(substring)\n        return (substring, start_index, end_index)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/773", "solution": "class SourceString:\n    \