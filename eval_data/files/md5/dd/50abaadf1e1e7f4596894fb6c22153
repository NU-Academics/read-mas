__(self, sum_value: int):\n        self.sum = sum_value\ndef sumofFactors(n: int) -> int:\n    \"\"\"\n    Computes the sum of even positive divisors of an integer n.\n    Returns 0 if no even factors exist.\n    \"\"\"\n    integer_input = IntegerInput(n)\n    factor_set = FactorSet()\n    factor_set.computeFactors(integer_input)\n    even_factors = factor_set.filterEven()\n    total = sum(f.value for f in even_factors)\n    sum_result = SumResult(sum_value=total)\n    return sum_result.sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/453", "solution": "from dataclasses import dataclass\nimport math\ndef sumofFactors(n: int) -> int:\n    \"\"\"Compute and return the sum of even positive divisors of n.\n\n    Precondition (recommended): n is an integer (recommended n >= 1).\n    Returns an int sum of even positive divisors; returns 0 when none exist.\n    \"\"\"\n    input_number_trace = NumberInput(value=n)  # For traceability\n\n    even_factors_sum = 0\n    found_factors = set()\n\n    # Optimized divisor enumeration up to sqrt(n)\n    for i in range(1, int(math.isqrt(input_number_trace.value)) + 1):\n        if input_number_trace.value % i == 0:\n            found_factors.add(i)\n            found_factors.add(input_number_trace.value // i)\n\n    # Filter for even factors and sum them\n    for d in found_factors:\n        factor_obj = Factor(value=d)  # For traceability and isEven check\n        if factor_obj.isEven():\n            even_factors_sum += factor_obj.value\n\n    sum_result_trace = SumResult(value=even_factors_sum)  # For traceability\n    return sum_result_trace.value", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[18]], "plus_fail_tests": [[101]]}], "Mbpp/454": [{"task_id": "Mbpp/454", "solution": "class TextInput:\n    \"\"\"Holds the input string content and provides its length.\"\"\"\n    def __init__(self, content: str):\n        self.content = content\n\n 