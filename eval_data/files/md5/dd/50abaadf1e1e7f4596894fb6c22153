to_string()\n        # Converts each character digit to an integer and collects them.\n        digits = [int(char_digit) for char_digit in abs_str_result]\n        return digits\n\n    def sum_digits(self, digits: List[int]) -> int:\n        \"\"\"Sums a list of integer digits using the DigitSum holder.\"\"\"\n        digit_sum_obj = DigitSum(sum(digits))\n        return digit_sum_obj.sum\n\n    def power_base_sum(self, base: int, power: int) -> int:\n        \"\"\"Orchestrates the computation, digit extraction, and summation.\"\"\"\n        self.validate_inputs(base, power)\n        result = self.compute_power(base, power)\n        digits = self.extract_digits(result)\n        return self.sum_digits(digits)\ndef power_base_sum(base, power) -> int:\n    \"\"\"Public API function to compute base**power, sum its decimal digits.\"\"\"\n    # Delegates the responsibility to an instance of PowerBaseSumFunction.\n    impl = PowerBaseSumFunction()\n    return impl.power_base_sum(base, power)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/724", "solution": "class PowerComputation:\n    \"\"\"Encapsulates exact integer exponentiation logic.\n    It computes base ** power and stores the result.\n    \"\"\"\n    def __init__(self, base: int, power: int) -> None:\n        self.base = base\n        self.power = power\n        self.result: int | None = None\n\n    def compute(self) -> int:\n        \"\"\"Computes and returns base ** power using exact integer arithmetic.\"\"\"\n        self.result = self.base ** self.power\n        return self.result\nclass DigitSum:\n    \"\"\"Encapsulates logic to compute the sum of decimal digits of an integer.\n    It processes an integer value and calculates the sum of its digits.\n    \"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n        self.sum: int | None = None\n\n    def computeSum(self) -> int:\n        \"\"\"Computes and returns the sum of decimal digits of the stored value.\"\"\"\n        self.sum = sum(int(digit) for digit in str(self.value))\n        return self.sum\ndef power_base_sum(base: int, power: int) -> int:\n    \"\"\"\n    Computes base**power using exact integer arithmetic and returns the sum of its decimal digits.\n    This function composes PowerComputation and DigitSum classes internally.\n    \"\"\"\n    # Compute base**power using PowerComputation\n    power_calculator = PowerComputation(base, power)\n    power_result = power_calculator.compute()\n\n    # Calculate the sum of digits using DigitSum\n    digit_sum_calculator = DigitSum(power_result)\n    total_digit_sum = digit_sum_calculator.computeSum()\n\n    return total_digit_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/725": [{"task_id": "Mbpp/725", "solution": "def extract_quotation(input: str) -> list[str]:\n    \"\"\"Extracts substrings between double quotes from the input string.\n    Returns them in a list, preserving order and exact text, without the quotes.\n    \"\"\"\n    extracted_quotes = []\n    in_quote = False\n    quote_start_index = -1\n\n    for i, char in enumerate(input):\n        if char == '\"':\n            if not in_quote:\n                # Found an opening double quote.\n                quote_start_index = i + 1\n                in_quote = True\n            else:\n                # Found a closing double quote.\n                extracted_quotes.append(input[quote_start_index:i])\n                in_quote = False\n    return extracted_quotes", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/725", "solution": "from src.extract_quotation import extract_quotation", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/726": [{"task_id": "Mbpp/726", "solution": "def multiply_elements(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Compute