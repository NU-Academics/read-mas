es as per the combinatorial identity.\n    \"\"\"\n    try:\n        # math.comb is available from Python 3.8+\n        return math.comb(2 * n, n)\n    except AttributeError:\n        # Fallback for older Python versions if math.comb is not available.\n        # It is assumed n is a non-negative integer based on caller's trusted input.\n        return math.factorial(2 * n) // (math.factorial(n) * math.factorial(n))\ndef count_binary_seq(n):\n    \"\"\"\n    Calculates the count of binary sequences of length 2n where the sum of the first n bits\n    equals the sum of the last n bits, using the identity C(2n, n).\n    \"\"\"\n    _validate_input(n)\n    return _compute_count_combination(n)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[1]], "plus_fail_tests": [[4]]}], "Mbpp/299": [{"task_id": "Mbpp/299", "solution": "from typing import Dict, Tuple\nfrom typing import List, Tuple\nfrom max_aggregate_project.src.models import NameValueEntry\nfrom typing import List\nfrom max_aggregate_project.src.models import NameValueEntry, AggregationMap, AggregationResult\nfrom typing import List, Tuple\nfrom max_aggregate_project.src.validator import validate_entries\nfrom max_aggregate_project.src.aggregator import aggregate, get_max_result\nclass NameValueEntry:\n    \"\"\"Represents a name-value pair.\"\"\"\n    def __init__(self, name: str, value: int) -> None:\n        self.name = name\n        self.value = value\n\n    def __repr__(self) -> str:\n        return f\"NameValueEntry(name='{self.name}', value={self.value})\"\nclass AggregationResult:\n    \"\"\"Holds the name and its total aggregate.\"\"\"\n    def __init__(self, name: str, total: int) -> None:\n        self.name = name\n        self.total = total\n\n    def as_tuple(self) -> Tuple[str, int]:\n        \"\"\"Returns the result as a (name, total) tuple.\"\"\"\n        return (self.name, self.total)\nclass AggregationMap:\n    \"\"\"Manages the aggregation of values by name.\"\"\"\n    def __init__(self) -> None:\n        self.totals: Dict[str, int] = {}\n\n    def add_entry(self, entry: NameValueEntry) -> None:\n        \"\"\"Adds or updates an entry's value to its name's total.\"\"\"\n        self.totals[entry.name] = self.totals.get(entry.name, 0) + entry.value\n\n    def get_total(self, name: str) -> int:\n        \"\"\"Returns the current total for a given name.\"\"\"\n        return self.totals.get(name, 0)\n\n    def get_max(self) -> AggregationResult:\n        \"\"\"Determines and returns the AggregationResult with the highest total.\"\"\"\n        if not self.totals:\n            return AggregationResult(\"\", 0) # Default for no entries\n        \n        max_name: str = \"\"\n        max_total: int = -float('inf')\n\n        # Iterates to find the maximum total, picking the first encountered in case of ties.\n        for name, total in self.totals.items():\n            if total > max_total:\n                max_total = total\n                max_name = name\n        \n        return AggregationResult(max_name, max_total)\ndef validate_entry(entry: Tuple) -> NameValueEntry:\n    \"\"\"Validates a single tuple entry and converts it to NameValueEntry.\"\"\"\n    if not isinstance(entry, tuple):\n        raise TypeError(f\"Input entry must be a tuple, got {type(entry).__name__}\")\n    if len(entry) != 2:\n        raise ValueError(f\"Input tuple must have length 2, got {len(entry)}\")\n    \n    name, value = entry\n    if not isinstance(name, str):\n        raise TypeError(f\"First element of tuple must be a string, got {type(name).__name__}\")\n    if not isinstance(value, int):\n        raise TypeError(f\"Second element of tuple must be an integer, got {type(value).__name__}\")\n    \n    return NameValueEntry(name, value)\ndef validate_entries(entries: List[Tuple]) -> List[NameValueEntry]:\n    \"\"\"Validates a list of tuple entries and converts them to NameValueEntry instances.\"\"\"\n    if not isinstance(entries, list):\n        raise TypeError(f\"Input 'entries' must be a list, got {type(entries).__name__}\")\n    \n    validated_entries: List[NameValueEntry] = []\n    for entry in entries:\n        validated_entries.append(validate_entry(entry))\n    return validated_entries\ndef aggregate(entries: List[NameValueEntry]) -> AggregationMap:\n    \"\"\"Aggregates a list of NameValueEntry into an AggregationMap.\"\"\"\n    aggregation_map = AggregationMap()\n    for entry in entries:\n        aggregation_map.add_entry(entry)\n    return aggregation_map\ndef get_max_result(aggregation_map: AggregationMap) -> AggregationResult:\n    \"\"\"Retrieves the maximum aggregated result from an AggregationMap.\"\"\"\n    return aggregation_map.get_max()\ndef max_aggregate(entries: List[Tuple]) -> Tuple[str, int]:\n    \"\"\"\n    Calculates the maximum aggregate from a list of name-value tuples.\n    This function orchestrates validation, aggregation, and result extraction.\n    \"\"\"\n    validated = validate_entries(entries)\n    aggregation_map = aggregate(validated)\n    result = get_max_result(aggregation_map)\n    return result.as_tuple()", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/299", "solution": "from typing import Iterable, Tuple, Optional, List, Dict, Iterator\nimport numbers\nclass AggregatedResult:\n    \"\"\"Immutable-like data carrier for an aggregated name and its total.\"\"\"\n\n    def __init__(self, name: str, total: float):\n        self.name = name\n        self.total = total\n\n    def as_tuple(self) -> Tuple[str, float]:\n        \"\"\"Returns the result as a (name, total) tuple.\"\"\"\n        return (self.name, self.total)\n\n    def __iter__(self) -> Iterator[str | float]:\n        \"\"\"Allows conversion to a tuple, e.g., tuple(result_object).\"\"\"\n        yield self.name\n        yield self.total\n\n    def __repr__(self) -> str:\n        \"\"\"String representation for debugging.\"\"\"\n        return f\"AggregatedResult(name='{self.name}', total={self.total})\"\nclass Validator:\n    \"\"\"Validates the structure and types of input entries.\"\"\"\n\n    def validate(self, entries: Iterable[Tuple]) -> None:\n        \"\"\"\n        Ensures each entry is a 2-element tuple/list, with a string name and a numeric value.\n        Raises TypeError for any validation failure.\n        \"\"\"\n        try:\n            for i, entry in enumerate(entries):\n                if not isinstance(entry, (tuple, list)):\n                    raise TypeError(f\"Entry at index {i} must be a tuple or list, got {type(entry).__name__}.\")\n                if len(entry) != 2:\n                    raise TypeError(f\"Entry at index {i} must have exactly 2 elements, got {len(entry)}.\")\n                if not isinstance(entry[0], str):\n                    raise TypeError(f\"Entry at index {i}, element 0 (name) must be a string, got {type(entry[0]).__name__}.\")\n                if not isinstance(entry[1], numbers.Number):\n                    raise TypeError(f\"Entry at index {i}, element 1 (value) must be numeric, got {type(entry[1]).__name__}.\")\n        except TypeError as e:\n            # This catches TypeErrors from non-iterable 'entries' (e.g. enumerate(None))\n            # or the specific validation checks within the loop.\n            raise e\n        except Exception as e:\n            # Catch any other unexpected errors during iteration or validation.\n            raise TypeError(f\"An unexpected error occurred during input validation: {e}\")\nclass Aggregator:\n    \"\"\"Performs grouping, summation, and selects the maximum aggregated result.\"\"\"\n\n    def aggregate(self, entries: Iterable[Tuple[str, numbers.Number]]) -> List[AggregatedResult]:\n        \"\"\"\n        Aggregates all numeric values per identical name.\n        Returns a list of AggregatedResult instances for all distinct names.\n        \"\"\"\n        totals: Dict[str, float] = {}\n        for name, value in entries:\n            totals[name] = totals.get(name, 0.0) + float(value)\n        \n        return [AggregatedResult(name, total) for name, total in totals.items()]\n\n    def max_aggregate(self, entries: Iterable[Tuple[str, numbers.Number]]) -> Optional[AggregatedResult]:\n        \"\"\"\n        Aggregates values by name and finds the name with the highest total.\n        Applies a first-encountered tie-break.\n        \"\"\"\n        current_totals: Dict[str, float] = {}\n        max_total: float = -float('inf')\n        max_name: Optional[str] = None\n        has_entries = False\n\n        for name, value in entries:\n            has_entries = True\n            current_totals[name] = current_totals.get(name, 0.0) + float(value)\n            current_sum = current_totals[name]\n\n            if current_sum > max_total:\n                max_total = current_sum\n                max_name = name\n            # If current_sum == max_total, we do nothing to preserve the existing max_name,\n            # ensuring the \"first encountered\" tie-break.\n\n        if not has_entries:\n            return None\n        \n        # If has_entries is True, max_name must have been set to the first valid name encountered.\n        # This handles cases where all values might be e.g. NaN if numbers.Number allowed them\n        # to ensure the return type contract.\n        if max_name is None: \n            return None \n\n        return AggregatedResult(max_name, max_total)\ndef max_aggregate(entries: Iterable[Tuple[str, numbers.Number]]) -> Optional[Tuple[str, float]]:\n    \"\"\"\n    Calculates the name with the highest aggregated total from a list of entries.\n    It validates input, aggregates values, and applies a first-encountered tie-break, \n    returning (name, total) or None for empty input.\n    \"\"\"\n    validator = Validator()\n    validator.validate(entries)\n\n    aggregator = Aggregator()\n    result = aggregator.max_aggregate(entries)\n\n    if result is None:\n        return None\n    else:\n        return result.as_tuple()", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[["Alice", 80], ["Bob", -90], ["Charlie", 70], ["Alice", -60], ["Bob", 50]]]]}], "Mbpp/301": [{"task_id": "Mbpp/301", "solution": "from src.dict_depth import dict_depth", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/301", "solution": "def dict_depth(input_dict: dict) -> int:\n    \"\"\"Compute and return the maximum dictionary nesting depth.\n\n    Precondition: input_dict must be a dictionary (per design). Returns an integer >= 1 when precondition is met.\n    \"\"\"\n    current_level_depth = 1 \n    \n    max_nested_dict_depth = 0\n    for value in input_dict.values():\n        if isinstance(value, dict):\n            # Recursively compute the depth of the nested dictionary.\n            nested_depth = dict_depth(value)\n            if nested_depth > max_nested_dict_depth:\n                max_nested_dict_depth = nested_depth\n                \n    return current_level_depth + max_nested_dict_depth", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/305": [{"task_id": "Mbpp/305", "solution": "from typing import List, Tuple\nfrom dataclasses import dataclass\ndef _tokenize(s: str) -> List[str]:\n    \"\"\"Splits a string on any whitespace into tokens, preserving order.\"\"\"\n    return s.split()\ndef _is_p_start(word: str) -> bool:\n    \"\"\"Checks if a non-empty word's first character casefolded is 'p'.\"\"\"\n    return bool(word and word[0].casefold() == 'p')\ndef start_withp(input_list: List[str]) -> Tuple[str, str]:\n    \"\"\"\n    Orchestrates tokenization, matching, and selection to return\n    the first two 'p'-starting words in discovery order.\n    \"\"\"\n    matched_words_found = []\n    for input_string in input_list:\n        tokens = _tokenize(input_string)\n        for token in token