il_tests": [[[1, 1, 1]]]}, {"task_id": "Mbpp/630", "solution": "from typing import List, Tuple\nclass Coordinate:\n    \"\"\"Represents a single coordinate (row, column).\"\"\"\n    def __init__(self, row: int, column: int):\n        self.row = row\n        self.column = column\n\n    def toList(self) -> list:\n        \"\"\"Returns the coordinate as a list [row, column].\"\"\"\n        return [self.row, self.column]\nclass CoordinateList:\n    \"\"\"Contains an ordered collection of Coordinate instances.\"\"\"\n    def __init__(self):\n        self.items: List[Coordinate] = []\n\n    def append(self, coord: Coordinate) -> None:\n        \"\"\"Adds a Coordinate to the list.\"\"\"\n        self.items.append(coord)\n\n    def toNestedList(self) -> list:\n        \"\"\"Returns the contained Coordinates as a nested list [[r,c], ...].\"\"\"\n        return [coord.toList() for coord in self.items]\n\n    def __len__(self) -> int:\n        \"\"\"Returns the number of items in the list.\"\"\"\n        return len(self.items)\nclass CoordinateGenerator:\n    \"\"\"Generates a 3x3 neighborhood of coordinates.\"\"\"\n    def generateNeighborhood(self, center: Coordinate) -> CoordinateList:\n        \"\"\"Generates the 3x3 neighborhood centered on the given Coordinate.\"\"\"\n        neighborhood = CoordinateList()\n        center_row = center.row\n        center_col = center.column\n\n        for dr in [-1, 0, 1]:\n            for dc in [-1, 0, 1]:\n                new_row = center_row + dr\n                new_col = center_col + dc\n                neighborhood.append(Coordinate(new_row, new_col))\n        return neighborhood\nclass InputValidator:\n    \"\"\"Validates if the input is a tuple of two integers.\"\"\"\n    def validateTuple(self, coord_tuple: Tuple) -> bool:\n        \"\"\"Checks if the input is a tuple of exactly two integers.\"\"\"\n        if not isinstance(coord_tuple, tuple):\n            return False\n        if len(coord_tuple) != 2:\n            return False\n        if not isinstance(coord_tuple[0], int) or not isinstance(coord_tuple[1], int):\n            return False\n        return True\ndef get_coordinates(coord_tuple: Tuple[int, int]) -> list:\n    \"\"\"\n    Public API. Accepts a tuple (row, column) where both elements are integers.\n    Returns a list of nine [row, column] lists in row-major order starting at (r-1, c-1).\n    \"\"\"\n    validator = InputValidator()\n    # Validation is performed as per design, but per critical requirements,\n    # no exception is raised and execution proceeds assuming valid input.\n    validator.validateTuple(coord_tuple) \n\n    center_coord = Coordinate(coord_tuple[0], coord_tuple[1])\n    generator = CoordinateGenerator()\n    neighborhood_list = generator.generateNeighborhood(center_coord)\n    \n    return neighborhood_list.toNestedList()", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[1, 1, 1]]]}], "Mbpp/632": [{"task_id": "Mbpp/632", "solution": "def move_zero(input_list):\n    \"\"\"Return a new list containing the same elements as input_list with all elements equal to 0 moved to the end.\n    This preserves relative order of non-zero elements and the count of zeros.\n    \"\"\"\n    non_zero_elements = []\n    zero_count = 0\n    for item in input_list:\n        if item == 0:\n            zero_count += 1\n        else:\n            non_zero_elements.append(item)\n    non_zero_elements.extend([0] * zero_count)\n    return non_zero_elements", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/632", "solution": "from typing import List\nclass Element:\n    \"\"\"Domain abstraction for a list element.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n    def is_zero(self) -> bool:\n        \"\"\"Checks if the element's value is zero.\"\"\"\n        return self.value == 0\nclass ListEntity:\n    \"\"\"Domain abstraction representing a list with metadata.\"\"\"\n    def __init__(self, raw_list: list):\n        self.elements: List[Element] = [Element(item) for item in raw_list]\n        self.length: int = len(raw_list)\n        self.zeroCount: int = self.count_zeros()\n\n    def count_zeros(self) -> int:\n        \"\"\"Calculates the number of zero elements.\"\"\"\n        return sum(1 for e in self.elements if e.is_zero())\nclass MoveZeroService:\n    \"\"\"Service to move zero elements to the end of a list.\"\"\"\n    def validate_input(self, input_list) -> bool:\n        \"\"\"Performs input validation (no-op as per critical requirements).\"\"\"\n        # Critical requirement: Do NOT add isinstance() checks, type guards, or raise exceptions.\n        return True\n\n    def move_zero(self, input_list) -> list:\n        \"\"\"Moves all zero elements to the end of the input list.\"\"\"\n        self.validate_input(input_list)\n        list_entity = ListEntity(input_list)\n\n        non_zeros = [element.value for element in list_entity.elements if not element.is_zero()]\n        zeros = [0] * list_entity.zeroCount\n\n        return non_zeros + zeros\ndef move_zero(input_list) -> list:\n    \"\"\"API function to move all zero elements to the end of a list.\"\"\"\n    service = MoveZeroService()\n    return service.move_zero(input_list)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/631": [{"task_id": "Mbpp/631", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Exception raised for invalid non-string input to the replace_spaces function.\"\"\"\n    pass\nclass InputString:\n    \"\"\"A value object representing the input string.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the string.\"\"\"\n        return len(self.value)\nclass OutputString:\n    \"\"\"A value object representing the transformed output string.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\nclass Character:\n    \"\"\"Helper class for single-character classification.\"\"\"\n    WHITESPACE_CHARS = {' ', '\\t', '\\n'}\n    UNDERSCORE_CHAR = '_'\n\n    def __init__(self, value: str):\n        self.value = value\n\n    def isWhitespace(self) -> bool:\n        \"\"\"Checks if the character is a recognized whitespace (' ', '\\\\t', '\\\\n').\"\"\"\n        return self.value in self.WHITESPACE_CHARS\n\n    def isUnderscore(self) -> bool:\n        \"\"\"Checks if the character is an underscore ('_').\"\"\"\n        return self.value == self.UNDERSCORE_CHAR\nclass ReplacementEngine:\n    \"\"\"Core logic for performing string transformations.\"\"\"\n    def replaceWhitespaceToUnderscore(self, s: str) -> str:\n        \"\"\"Replaces recognized whitespace characters with underscores.\"\"\"\n        result_chars = []\n        for char_val in s:\n            char_obj = Character(char_val)\n            if char_obj.isWhitespace():\n                result_chars.append(Character.UNDERSCORE_CHAR)\n            else:\n                result_chars.append(char_val)\n        return \"\".join(result_chars)\n\n    def replaceUnderscoreToWhitespace(self, s: str) -> str:\n        \"\"\"Replaces underscore characters with single spaces.\"\"\"\n        result_chars = []\n        for char_val in s:\n            char_obj = Character(char_val)\n            if char_obj.isUnderscore():\n                result_chars.append(' ')\n            else:\n                result_chars.append(char_val)\n        return \"\".join(result_chars)\nclass ReplaceSpaces:\n    \"\"\"Orchestrates input validation, operation selection, and delegation to ReplacementEngine.\"\"\"\n    def __init__(self):\n        self._engine = ReplacementEngine()\n\n    def replace_spaces(self, input_str: str) -> str:\n        \"\"\"Validates input, determines transformation, and delegates to the engine.\"\"\"\n        if not isinstance(input_str, str):\n            raise InvalidInputError(\"Inp