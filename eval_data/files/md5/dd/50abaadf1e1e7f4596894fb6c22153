 is_sublist(main_list, sub_list) -> bool:\n    \"\"\"\n    Checks if sub_list appears in main_list as a contiguous subsequence.\n    Does not modify input lists and uses element equality semantics.\n    \"\"\"\n    m = len(main_list)\n    n = len(sub_list)\n\n    # FR4: If len(sub_list) > len(main_list) return False.\n    if n > m:\n        return False\n\n    # Empty-sublist semantics: Treat empty sub_list as True (documented design choice).\n    if n == 0:\n        return True\n\n    # Iterate through possible starting positions in main_list.\n    for i in range(m - n + 1):\n        match = True\n        # Compare corresponding elements of the candidate sublist.\n        for j in range(n):\n            # FR6: Compare elements using equality semantics provided by _compare_elements.\n            if not _compare_elements(main_list[i + j], sub_list[j]):\n                match = False\n                break\n        if match:\n            return True\n\n    return False", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/68": [{"task_id": "Mbpp/68", "solution": "from typing import List, Any, Union\nnumber = Union[int, float]\nclass Result:\n    \"\"\"Internal value object holding the boolean outcome of a check.\"\"\"\n    def __init__(self, is_monotonic: bool):\n        self.is_monotonic = is_monotonic\nclass ErrorHandler:\n    \"\"\"Centralizes raising TypeError with consistent messages for validation failures.\"\"\"\n    def raise_type_error(self, message: str) -> None:\n        \"\"\"Raises a TypeError with the provided message.\"\"\"\n        raise TypeError(message)\nclass TypeValidator:\n    \"\"\"Validates input preconditions, ensuring the input is a list of comparable elements.\"\"\"\n    def __init__(self):\n        self._error_handler = ErrorHandler()\n\n    def validate_list(self, array: Any) -> None:\n        \"\"\"Raises TypeError if the input 'array' is not a list.\"\"\"\n        if not isinstance(array, list):\n            self._error_handler.raise_type_error(\"Input must be a list.\")\n\n    def validate_comparable(self, elements: List[Any]) -> None:\n        \"\"\"Raises TypeError if any element in the list is not numeric (int or float).\"\"\"\n        for i, element in enumerate(elements):\n            if not isinstance(element, (int, float)):\n                self._error_handler.raise_type_error(\n                    f\"Element at index {i} is not numeric (int or float).\"\n                )\nclass MonotonicChecker:\n    \"\"\"Orchestrates the actual monotonic checks on a numeric list.\"\"\"\n\n    def is_Monotonic(self, array: List[number]) -> Result:\n        \"\"\"Determines if the array is monotonic (non-decreasing or non-increasing) and returns a Result object.\"\"\"\n        if len(array) <= 1:\n            return Result(True)\n\n        if self._check_non_decreasing(array):\n            return Result(True)\n        \n        if self._check_non_increasing(array):\n            return Result(True)\n        \n        return Result(False)\n\n    def _check_non_decreasing(self, array: List[number]) -> bool:\n        \"\"\"Checks if the provided array is non-decreasing.\"\"\"\n        for i in range(1, len(array)):\n            if array[i] < array[i - 1]:\n                return False\n        return True\n\n    def _check_non_increasing(self, array: List[number]) -> bool:\n        \"\"\"Checks if the provided array is non-increasing.\"\"\"\n        for i in range(1, len(array)):\n            if array[i] > array[i - 1]:\n                return False\n        return True\ndef is_Monotonic(array: Any) -> bool:\n    \"\"\"\n    Checks if a given array (Python list) is monotonic (non-decreasing or non-increasing).\n    Raises TypeError if the input is not a list or contains non-numeric elements.\n    \"\"\"\n    validator = TypeValidator()\n    validator.validate_list(array)\n    validator.validate_comparable(array) \n\n    checker = MonotonicChecker()\n    result_obj = checker.is_Monotonic(array)\n    return result_obj.is_monotonic", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/68", "solution": "def is_Monotonic(array: list) -> bool:\n    \"\"\"Checks if a list is monotonic (non-decreasing or non-increasing).\n    Adjacent equal elements are considered valid for monotonicity.\n    \"\"\"\n    if len(array) <= 1:\n        return True\n\n    is_non_decreasing = True\n    is_non_increasing = True\n\n    for i in range(len(array) - 1):\n        if array[i] > array[i+1]:\n            is_non_decreasing = False\n        if array[i] < array[i+1]:\n            is_non_increasing = False\n\n        if not is_non_decreasing and not is_non_increasing:\n            return False\n\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/70": [{"task_id": "Mbpp/70", "solution": "def get_equal(tuples: list) -> bool:\n    \"\"\"Return True if all tuples in 'tuples' have equal length; False otherwise.\n    An empty list is treated as True as per design specification.\n    \"\"\"\n    if not tuples:\n        return True\n    first_len = len(tuples[0])\n    return all(len(t) == first_len for t in tuples)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/70", "solution": "from typing import List, Tuple as PyTuple\nclass Tuple:\n    \"\"\"Minimal value object representing a tuple's metadata (length).\"\"\"\n    def __init__(self, length: int) -> None:\n        self.length = length\nclass Result:\n    \"\"\"Wraps the boolean outcome of the equality check.\"\"\"\n    def __init__(self, value: bool) -> None:\n        self.value = value\nclass TupleCollection:\n    \"\"\"Encapsulate the input collection of tuples and compute integer lengths for each tuple.\"\"\"\n    def __init__(self, tuples: List[tuple]) -> None:\n        self.tuples = tuples\n\n    def get_lengths(self) -> List[int]:\n        \"\"\"Computes and returns a list of lengths for each tuple in the collection.\"\"\"\n        lengths = []\n        for t in self.tuples:\n            tuple_metadata = Tuple(len(t))\n            lengths.append(tuple_metadata.length)\n        return lengths\ndef get_equal(collection) -> bool:\n    \"\"\"\n    Accept a single argument 'collection' (expected: sequence of tuples) and return True if\n    all tuples have equal length; otherwise False.\n    \"\"\"\n    tc = TupleCollection(collection)\n    lengths = tc.get_lengths()\n\n    if not lengths:\n        all_equal = True # An empty collection trivially has all tuples of \"equal\" length.\n    else:\n        first_length = lengths[0]\n        all_equal = all(length == first_length for length in lengths)\n\n    result = Result(all_equal)\n    return result.value", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/71": [{"task_id": "Mbpp/71", "solution": "def comb_sort(lst: list) -> list:\n    \"\"\"Return a new list containing the elements of lst sorted in ascending order using comb sort.\n    It uses a gap shrink factor of 1.3.\"\"\"\n    \n    arr = list(lst)  # Create a shallow copy to not mutate the input list.\n    n = len(arr)\n    \n    gap = n\n    shrink_factor = 1.3\n    \n    swapped = True # Initialize swapped flag for the first pass\n    \n    while gap > 1 or swapped:\n        if gap > 1:\n            gap = int(gap / shrink_factor)\n        \n        swapped = False\n        \n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True\n                \n    return arr", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/71", "solution": "from typing import List as TypingList, Any\nclass CombSort:\n    \"\"\"Encapsulates the comb sort algorithm logic.\"\"\"\n\n    def __init__(self, shrinkFactor: float = 1.3):\n        \"\"\"Initializes the CombSort instance with a shrink factor.\"\"\"\n        self.shrinkFactor: float = shrinkFactor\n\n    def comb_sort(self, list: TypingList[Any]) -> TypingList[Any]:\n        \"\"\"Performs comb sort on a copy of the input list and returns the sorted list.\"\"\"\n        n = len(list)\n        if n <= 1:\n            return list[:] # Return a shallow copy for consistency\n\n        arr = list[:] # Work on a copy to avoid modifying original\n\n        gap = n\n        swapped = True\n\n        while gap > 1 or swapped:\n            if gap > 1:\n                gap = self.computeNextGap(gap)\n\n            swapped = False\n            for i in range(n - gap):\n                # The compareAndSwap method performs the comparison and swap if needed.\n                # It returns True if a swap occurred, which updates the 'swapped' flag.\n                if self.compareAndSwap(arr, i, i + gap):\n                    swapped = True\n        return arr\n\n    def computeNextGap(self, currentGap: int) -> int:\n        \"\"\"Computes the next gap size using the shrink factor, ensuring it's at least 1.\"\"\"\n        next_gap = int(currentGap / self.shrinkFactor)\n        return max(1, next_gap) # Gap must be at least 1\n\n    def compareAndSwap(self, list: TypingList[Any], i: int, j: int) -> bool:\n        \"\"\"Compares elements at indices i and j and swaps them if out of order.\n        Returns True if a swap occurred, False otherwise.\n        \"\"\"\n        if list[i] > list[j]:\n            list[i], list[j] = list[j], list[i]\n            return True\n        return False\ndef comb_sort(list: TypingList[Any]) -> TypingList[Any]:\n    \"\"\"Sorts a list of elements using the comb sort algorithm.\n    This public API delegates the sorting operation to an internal CombSort instance.\n    \"\"\"\n    sorter = CombSort()\n    return sorter.comb_sort(list)", "base_status": "pass", "plus_status":