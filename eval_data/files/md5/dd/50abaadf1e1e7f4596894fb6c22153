7", "solution": "from typing import Dict, Any\nclass InputValidator:\n    \"\"\"Provides static methods for validating input types and comparability.\"\"\"\n\n    @staticmethod\n    def validate_types(input_dict: Dict[Any, Any], n: int) -> None:\n        \"\"\"Validates that input_dict is a dict and n is an int.\"\"\"\n        if not isinstance(input_dict, dict):\n            raise TypeError(\"input_dict must be a dict.\")\n        if not isinstance(n, int):\n            raise TypeError(\"n must be an int.\")\n\n    @staticmethod\n    def assert_values_comparable(input_dict: Dict[Any, Any], n: int) -> None:\n        \"\"\"Ensures all dictionary values are comparable to n, raising ValueError if not.\"\"\"\n        for key, value in input_dict.items():\n            try:\n                # Attempt a comparison to check comparability.\n                _ = value >= n\n            except TypeError:\n                raise ValueError(\n                    f\"Dictionary value for key '{key}' ({value}) is not comparable with integer threshold {n}.\"\n                )\n            except Exception as e:\n                raise ValueError(\n                    f\"An unexpected error occurred when comparing value for key '{key}' ({value}) with {n}: {e}\"\n                )\nclass FilterOperation:\n    \"\"\"Encapsulates the logic for filtering dictionary entries based on a threshold.\"\"\"\n\n    def __init__(self, n: int) -> None:\n        \"\"\"Initializes the filter with a given integer threshold.\"\"\"\n        self._n = n\n\n    def apply(self, input_dict: Dict[Any, Any]) -> Dict[Any, Any]:\n        \"\"\"Applies the filter, returning a new dictionary with values greater than or equal to the threshold.\"\"\"\n        filtered_dict = {}\n        for key, value in input_dict.items():\n            if value >= self._n:\n                filtered_dict[key] = value\n        return filtered_dict\ndef dict_filter(input_dict: Dict[Any, Any], n: int) -> Dict[Any, Any]:\n    \"\"\"\n    Filters a dictionary to include only entries where the value is greater than or equal to n.\n    Raises TypeError for invalid input types or ValueError for non-comparable values.\n    \"\"\"\n    InputValidator.validate_types(input_dict, n)\n    InputValidator.assert_values_comparable(input_dict, n)\n\n    filter_op = FilterOperation(n)\n    return filter_op.apply(input_dict)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/279": [{"task_id": "Mbpp/279", "solution": "class InvalidInputError(Exception):\n    \"\"\"\n    Exception raised for invalid input to the decagonal number calculator.\n    This includes non-integer inputs or integers less than 1.\n    \"\"\"\n    pass\nclass InputValidator:\n    \"\"\"\n    Validates input 'n' to ensure it's an integer and non-negative.\n    Raises InvalidInputError for invalid inputs.\n    \"\"\"\n    def validate(self, n: object) -> bool:\n        \"\"\"\n        Checks if n is an integer and n >= 1.\n        Raises InvalidInputError if validation fails.\n        \"\"\"\n        if not isinstance(n, int):\n            raise InvalidInputError(\"Input must be an integer.\")\n        if n < 1:\n            raise InvalidInputError(\"Input must be an integer greater than or equal to 1.\")\n        return True\nclass DecagonalNumber:\n    \"\"\"\n    Represents 'n' and its computed decagonal value.\n    Encapsulates the computation logic for D(n).\n    \"\"\"\n    def __init__(self, n: int):\n        self.n = n\n        self.value: int = 0\n\n    def computeValue(self) -> int:\n        \"\"\"\n        Computes the decagonal number D(n) = n * (4 * n - 3).\n        Stores the result and returns it.\n        \"\"\"\n        self.value = self.n * (4 * self.n - 3)\n        return self.value\nclass DecagonalCalculator:\n    \"\"\"\n    Orchestrates the creation and computation of a DecagonalNumber.\n    It expects 'n' to be an already validated integer.\n    \"\"\"\n    def compute(self, n: int) -> int:\n        \"\"\"\n        Calculates the decagonal number for a given integer n.\n        Assumes n is already validated to be >= 1.\n        \"\"\"\n        dec_num = DecagonalNumber(n)\n        return dec_num.computeValue()\ndef is_num_decagonal(n: object) -> int:\n    \"\"\"\n    Calculates the nth decagonal number D(n) = n * (4 * n - 3).\n    Validates input 'n' to be an integer >= 1, raising InvalidInputError if invalid.\n    \"\"\"\n    validator = InputValidator()\n    # The validate method raises InvalidInputError if 'n' is not valid.\n    # If it returns, 'n' is guaranteed to be a valid integer.\n    validator.validate(n) \n\n    calculator = DecagonalCalculator()\n    return calculator.compute(int(n))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/279", "solution": "from src.api import is_num_decagonal", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/278": [{"task_id": "Mbpp/278", "solution": "def count_first_elements(input_tuple: tuple) -> int:\n    \"\"\"Counts top-level elements before the first top-level element of type tuple.\n    It iterates the input tuple and returns the accumulated count.\n    \"\"\"\n    count = 0\n    for element in input_tuple:\n        if isinstance(element, tuple):\n            return count\n        count += 1\n    return count", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[1, 2, 3, 4, 5, 6]]]}, {"task_id": "Mbpp/278", "solution": "from dataclasses import dataclass\nfrom typing import Any, Tuple", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/280": [{"task_id": "Mbpp/280", "solution": "def sequential_search(array, element):\n    \"\"\"\n    Performs a sequential search for an element in an array.\n    Returns (True, index) if found, or (False, -1) otherwise.\n    \"\"\"\n    for i, item in en