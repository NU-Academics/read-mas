ementation.\n    \"\"\"\n    return ReplaceCharFunction().replace(input_string, old_char, new_char)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/476": [{"task_id": "Mbpp/476", "solution": "def _compute_min_max(input_list):\n    \"\"\"\n    Computes the smallest and largest numeric values from the list.\n    For single-element lists, the element is treated as both min and max.\n    \"\"\"\n    if len(input_list) == 1:\n        value = input_list[0]\n        return (value, value)\n    return (min(input_list), max(input_list))\ndef big_sum(input_list):\n    \"\"\"\n    Calculates the sum of the smallest and largest numeric values in a list.\n    Handles validation for empty or non-numeric inputs as specified.\n    \"\"\"\n    _validate_input(input_list)\n    min_val, max_val = _compute_min_max(input_list)\n    return min_val + max_val", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, 2, 3]]], "plus_fail_tests": [[[-10, -5, -3, -1, -7]]]}, {"task_id": "Mbpp/476", "solution": "def big_sum(numbers):\n    \"\"\"Computes the sum of the smallest and largest values in an iterable.\n    Assumes the input contains only numeric elements.\n    \"\"\"\n    return min(numbers) + max(numbers)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/477": [{"task_id": "Mbpp/477", "solution": "def is_lower(input):\n    \"\"\"Return lower-case form of the input string.\n    This function expects the input to be a string.\n    \"\"\"\n    return input.lower()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/477", "solution": "from is_lower import is_lower", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/478": [{"task_id": "Mbpp/478", "solution": "def remove_lowercase(input: str) -> str:\n    \"\"\"Removes all lowercase characters from the input string.\n    Preserves the order of remaining characters.\"\"\"\n    out_chars = [c for c in input if not c.islower()]\n    return ''.join(out_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/478", "solution": "from dataclasses import dataclass\ndef findLowercaseSubstrings(input_str: str) -> list[LowercaseSubstring]:\n    \"\"\"\n    Scans the input string to find all contiguous ASCII lowercase substrings.\n    Detection uses ord-based ASCII range checks.\n    \"\"\"\n    results: list[LowercaseSubstring] = []\n    n = len(input_str)\n    i = 0\n    while i < n:\n        # Check if the current character is an ASCII lowercase letter\n        if ord('a') <= ord(input_str[i]) <= ord('z'):\n            start_index = i\n            # Extend the lowercase run until a non-lowercase character or end of string\n            while i < n and ord('a') <= ord(input_str[i]) <= ord('z'):\n                i += 1\n            end_index = i  # 'i' is now the exclusive end index of the substring\n            substring_text = input_str[start_index:end_index]\n            results.append(LowercaseSubstring(startIndex=start_index, endIndex=end_index, text=substring_text))\n        else:\n            i += 1\n    return results\ndef buildOutput(input_str: str, substrings: list[LowercaseSubstring]) -> str:\n    \"\"\"\n    Constructs the output string by removing the identified lowercase substrings.\n    Segments before, between, and after substrings are preserved.\n    \"\"\"\n    if not substrings:\n        return input_str\n\n    parts: list[str] = []\n    current_pos = 0\n\n    for sub in substrings:\n        # Append the segment of the input string that comes before the current lowercase substring\n        if sub.startIndex > current_pos:\n            parts.append(input_str[current_pos : sub.startIndex])\n        # Advance current_pos past the removed lowercase substring\n        current_pos = sub.endIndex\n\n    # Append