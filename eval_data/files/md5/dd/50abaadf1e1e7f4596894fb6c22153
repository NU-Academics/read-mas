n False\n\n            right_index = 2 * i + 2\n            if right_index < n:\n                right = heap.get(right_index)\n                if comp.compare(parent, right) > 0: # If parent is greater than right child\n                    return False\n        return True\ndef check_min_heap(array) -> bool:\n    \"\"\"Public API required by FR-1. Creates MinHeapChecker and returns boolean result.\"\"\"\n    checker = MinHeapChecker()\n    return checker.check_min_heap(array)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/751", "solution": "def check_min_heap(arr):\n    \"\"\"\n    Evaluates whether a given zero-indexed array represents a min-heap.\n    Returns True if it's a min-heap, False immediately on first violation.\n    \"\"\"\n    n = len(arr)\n\n    # Empty or single-element arrays are considered valid min-heaps.\n    if n <= 1:\n        return True\n\n    # Iterate through potential parent nodes. The last possible parent is at index (n // 2) - 1.\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check if the parent is greater than its left child (if it exists).\n        if left_child_idx < n:\n            if arr[i] > arr[left_child_idx]:\n                return False\n\n        # Check if the parent is greater than its right child (if it exists).\n        if right_child_idx < n:\n            if arr[i] > arr[right_child_idx]:\n                return False\n\n    # If no violations were found after checking all parents, it's a min-heap.\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/752": [{"task_id": "Mbpp/752", "solution": "from typing import Any\nclass JacobsthalCalculator:\n    \"\"\"Validate input and compute the nth Jacobsthal number using an iterative algorithm.\"\"\"\n\n    def _validate_input(self, n) -> None:\n        \"\"\"Validates if n is a non-negative integer.\"\"\"\n        if not isinstance(n, int) or n < 0:\n            raise ValueError(\"n must be a non-negative integer\")\n\n    def computeIterative(self, n: int) -> int:\n        \"\"\"Computes the nth Jacobsthal number iteratively for n >= 2.\"\"\"\n        # Precondition: n must be >= 2 as base cases are handled externally.\n        a, b = 0, 1  # J(0) and J(1)\n        for _ in range(2, n + 1):\n            next_jacobsthal = b + 2 * a\n            a, b = b, next_jacobsthal\n        return b\n\n    def jacobsthal_num(self, n: int) -> int:\n        \"\"\"Computes the nth Jacobsthal number after validating input.\"\"\"\n        self._validate_input(n)\n\n        if n == 0:\n            return 0\n        if n == 1:\n            return 1\n        \n        return self.computeIterative(n)\ndef jacobsthal_num(n) -> int:\n    \"\"\"Public API: validate and return the nth Jacobsthal number (zero-based).\"\"\"\n    calculator = JacobsthalCalculator()\n    return calculator.jacobsthal_num(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/752", "solution": "class InputValidator:\n    \"\"\"Validates inputs for Jacobsthal number computation.\n    Checks if n is a non-negative integer.\n    \"\"\"\n    def validateIntegerNonNegative(self, n: any) -> None:\n        \"\"\"Checks if n is a non-negative integer, raising errors if not.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"n must be an integer.\")\n        if n < 0:\n            raise ValueError(\"n must be a non-negative integer (n >= 0).\")\nclass JacobsthalDefinition:\n    \"\"\"Holds the definition of Jacobsthal numbers.\n    Includes base cases J(0), J(1) and the recurrence formula.\n    \"\"\"\n    base0: int = 0\n    base1: int = 1\n    recurrence: str = \"J(n) = J(n-1) + 2 * J(n-2)\"\nclass JacobsthalFunction:\n    \"\"\"Computes Jacobsthal numbers using base cases and recurrence.\n    Implements the computation iteratively to avoid recursion limits.\n    \"\"\"\n    def __init__(self):\n        self._def = JacobsthalDefinition()\n\n    def jacobsthal_num(self, n: int) -> int:\n        \"\"\"Returns the nth Jacobsthal number.\"\"\"\n        if n == self._def.base0:\n            return 0\n        if n == self._def.base1:\n            return 1\n        return self.computeRecurrence(n)\n\n    def computeRecurrence(self, n: int) -> int:\n        \"\"\"Computes J(n) for n >= 2 using an iterative approach.\"\"\"\n        prev2 = self._def.base0  # Represents J(i-2)\n        prev1 = self._def.base1  # Represents J(i-1)\n        \n        for _ in range(2, n + 1):\n            current = prev1 + 2 * prev2\n            prev2 = prev1\n            prev1 = current\n        return current\ndef jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Computes the nth Jacobsthal number J(n).\n    This is the public API function, handling validation and delegating computation.\n    \"\"\"\n    InputValidator().validateIntegerNonNegative(n)\n    return JacobsthalFunction().jacobsthal_num(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/745": [{"task_id": "Mbpp/745", "solution": "def divisible_by_digits(startnum, endnum):\n    \"\"\"\n    Finds numbers within a given range where every non-zero digit divides the number.\n    Returns an ascending list of qualifying integers.\n    \"\"\"\n    result = []\n    for num in range(startnum, endnum + 1):\n        s_num = str(num)\n        \n        # Exclude any number that contains the digit 0\n        if '0' in s_num:\n            continue\n            \n        is_divisible_by_all = True\n        # For each candidate number, check if it's divisible by every non-zero digit\n        for char_digit in s_num:\n            digit = int(char_digit)\n            if num % digit != 0:\n                is_divisible_by_all = False\n                break\n        \n        if is_divisible_by_all:\n           