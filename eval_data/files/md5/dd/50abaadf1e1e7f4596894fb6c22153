       \"\"\"Returns the number of items in the list.\"\"\"\n        return len(self.items)\n\n    def to_values(self) -> List[float]:\n        \"\"\"Converts the list of Number objects back to a raw list of values.\"\"\"\n        return [n.value for n in self.items]\nclass Result:\n    \"\"\"Encapsulates a list of Number objects as a function's output.\"\"\"\n    def __init__(self, numbers: List[Number]):\n        # Sorts numbers to ensure output order matches original indices.\n        self.items = sorted(numbers, key=lambda n: n.index)\n\n    def to_values(self) -> List[float]:\n        \"\"\"Converts the list of result Number objects to a raw list of values.\"\"\"\n        return [n.value for n in self.items]\n\n    def __eq__(self, other):\n        if not isinstance(other, Result):\n            return NotImplemented\n        return self.to_values() == other.to_values()\n\n    def __repr__(self):\n        return f\"Result(items={self.items})\"\nclass CubeOperation:\n    \"\"\"Applies the cube (power of 3) operation to a Number.\"\"\"\n    def apply(self, n: Number) -> Number:\n        \"\"\"Computes the cube of a Number's value, preserving its index.\"\"\"\n        return Number(n.value ** 3, n.index)\ndef _cube_numbers_logic(input_numbers: NumberList) -> Result:\n    \"\"\"Applies the cube operation to each number in a NumberList.\"\"\"\n    cube_op = CubeOperation()\n    cubed_numbers = [cube_op.apply(n) for n in input_numbers.items]\n    return Result(cubed_numbers)\ndef cube_nums(input_list: List[float]) -> List[float]:\n    \"\"\"\n    Computes the cube of each element in a list of numbers.\n    Returns a new list with cubed values, preserving order.\n    \"\"\"\n    number_list = NumberList(input_list)\n    result = _cube_numbers_logic(number_list)\n    return result.to_values()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/448": [{"task_id": "Mbpp/448", "solution": "from typing import Optional\nfrom 