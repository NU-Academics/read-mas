ist_of_sets)\n\n    return list(common_elements_set)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/113": [{"task_id": "Mbpp/113", "solution": "class CheckResult:\n    \"\"\"Immutable holder for boolean evaluation result.\n    Encapsulates the outcome of an integer check.\n    \"\"\"\n    def __init__(self, is_integer: bool) -> None:\n        self.is_integer = is_integer\nclass CheckInteger:\n    \"\"\"Encapsulates the algorithm to determine whether a string\n    consists only of ASCII digits '0'..'9'.\n    \"\"\"\n    def check(self, s: str) -> CheckResult:\n        \"\"\"Determines if the string consists only of ASCII digits '0'..'9'.\n        Returns a CheckResult object encapsulating the boolean outcome.\n        \"\"\"\n        # Combines checks for digit characters and ASCII character set.\n        is_digit_and_ascii = s.isdigit() and s.isascii()\n        return CheckResult(is_digit_and_ascii)\ndef check_integer(s: str) -> bool:\n    \"\"\"\n    Public API to check if a string represents an integer composed only of ASCII digits.\n    Returns True if every character in the input string is an ASCII digit '0'..'9'; False otherwise.\n    \"\"\"\n    # Create an instance of the stateless behavior class.\n    checker = CheckInteger()\n    # Delegate the check to the behavior class, receiving a CheckResult object.\n    check_result_obj = checker.check(s)\n    # Extract the boolean value from the CheckResult to return.\n    return check_result_obj.is_integer", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[""]]}, {"task_id": "Mbpp/113", "solution": "import re\n_PATTERN: str = r'^[+-]?[0-9]+$'\ndef check_integer(input: str) -> bool:\n    \"\"\"\n    Checks if the input string represents an integer using a regular expression.\n    Returns True if the string exactly matches the pattern ^[+-]?[0-9]+$, otherwise False.\n    \"\"\"\n    return re.fullmatch(_PATTERN, input) is not None", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[""]]}], "Mbpp/109": [{"task_id": "Mbpp/109", "solution": "from typing import List\nclass ErrorHandler:\n    \"\"\"Centralizes ValueError raising with standardized messages.\"\"\"\n    def raise_value_error(self, msg: str) -> None:\n        \"\"\"Raises a ValueError with the provided message.\"\"\"\n        raise ValueError(msg)\nclass BinaryString:\n    \"\"\"Immutable value object representing a binary string and its operations.\"\"\"\n    def __init__(self, value: str):\n        \"\"\"Initializes a BinaryString with the given string value.\"\"\"\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the binary string.\"\"\"\n        return len(self.value)\n\n    def is_valid_bitstring(self) -> bool:\n        \"\"\"Checks if the string is non-empty and contains only '0' and '1'.\"\"\"\n        return len(self.value) > 0 and all(c in '01' for c in self.value)\n\n    def rotate_right_once(self) -> 'BinaryString':\n        \"\"\"Performs a single cyclic right rotation.\"\"\"\n        if not self.value:\n            return BinaryString(\"\")\n        return BinaryString(self.value[-1] + self.value[:-1])\n\n    def rotate_right(self, k: int) -> 'BinaryString':\n        \"\"\"Performs a cyclic right rotation by k positions.\"\"\"\n        length = self.length()\n        if length == 0:\n            return BinaryString(\"\")\n        effective_k = k % length\n        if effective_k == 0:\n            return BinaryString(self.value)\n        return BinaryString(self.value[-effective_k:] + self.value[:-effective_k])\nclass Validator:\n    \"\"\"Validates inputs s and n.\"\"\"\n    def validate_bitstring(self, s: str) -> bool:\n        \"\"\"Returns True if s is a non-empty bitstring of '0'/'1' characters.\"\"\"\n        return isinstance(s, str) and len(s) > 0 and all(c in '01' for c in s)\n\n    def validate_non_negative_int(self, n: int) -> bool:\n        \"\"\"Returns True if n is a non-negative integer.\"\"\"\n        return isinstance(n, int) and n >= 0\nclass Rotator:\n    \"\"\"Generates exactly n BinaryString rotation instances.\"\"\"\n    def __init__(self, base: BinaryString):\n        \"\"\"Initializes the Rotator with a base BinaryString.\"\"\"\n        self.base = base\n\n    def generate_rotations(self, n: int) -> List['BinaryString']:\n        \"\"\"Generates rotations for indices 0 to n-1.\"\"\"\n        rotations: List[BinaryString] = []\n        for i in range(n):\n            rotations.append(self.base.rotate_right(i))\n        return rotations\nclass OddnessEvaluator:\n    \"\"\"Determines oddness (LSB == '1') of a BinaryString.\"\"\"\n    def is_odd(self, s: 'BinaryString') -> bool:\n        \"\"\"Returns True if the BinaryString's least-significant-bit is '1'.\"\"\"\n        if not s.value:\n            return False\n        return s.value[-1] == '1'\nclass Counter:\n    \"\"\"Counts how many rotations are odd.\"\"\"\n    def count_odd(self, rotations: List['BinaryString']) -> int:\n        \"\"\"Counts the number of odd BinaryString instances in the list.\"\"\"\n        odd_count = 0\n        evaluator = OddnessEvaluator()\n        for rotation in rotations:\n            if evaluator.is_odd(rotation):\n                odd_count += 1\n        return odd_count\ndef odd_Equivalent(s: str, n: int) -> int:\n    \"\"\"\n    Counts how many of the first n cyclic right rotations of a binary string s\n    have a least-significant-bit '1'.\n    \"\"\"\n    validator = Validator()\n    error_handler = ErrorHandler()\n\n    if not validator.validate_bitstring(s):\n        error_handler.raise_value_error(\"s must be a non-empty bitstring containing only '0' and '1'\")\n    if not validator.validate_non_negative_int(n):\n        error_handler.raise_value_error(\"n must be a non-negative integer\")\n\n    base = BinaryString(s)\n    rotator = Rotator(base)\n    rotations = rotator.generate_rotations(n)\n    \n    counter = Counter()\n    return counter.count_odd(rotations)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["10000100110011", 5]]}, {"task_id": "Mbpp/109", "solution": "class Rotation:\n    \"\"\"Holds rotated_value and offset; determines oddness.\"\"\"\n    def __init__(self, offset: int, rotated_value: str):\n        self.offset = offset\n        self.rotated_value = rotated_value\n\n    def is_odd(self) -> bool:\n        \"\"\"Checks if the rotated binary string is odd (rightmost char is '1').\"\"\"\n        return self.rotated_value[-1] == '1'\nclass BinaryString:\n    \"\"\"Represents and produces rotations of a validated binary string.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n        self._length = len(value)\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the binary string.\"\"\"\n        return self._length\n\n    def rotate(self, r: int) -> Rotation:\n        \"\"\"Computes a rotation based on offset r and returns a Rotation object.\"\"\"\n        offset = r % self._length\n        rotated_value = self.value[offset:] + self.value[:offset]\n        return Rotation(offset, rotated_value)\nclass Validator:\n    \"\"\"Validates input types and values for the odd_Equivalent system.\"\"\"\n    def validate_string(self, s):\n        \"\"\"Validates that 's' is a non-empty binary string, raising exceptions on failure.\"\"\"\n        if not isinstance(s, str):\n            raise TypeError(\"Input 's' must be a string.\")\n        if len(s) == 0:\n            raise ValueError(\"Input 's' cannot be an empty string.\")\n        if any(ch not in ('0', '1') for ch in s):\n            raise ValueError(\"Input 's' must contain only '0' or '1' characters.\")\n\n    def validate_n(self, n):\n        \"\"\"Validates that 'n' is a non-negative integer, raising exceptions on failure.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n        if n < 0:\n            raise ValueError(\"Input 'n' cannot be negative.\")\nclass OddCounter:\n    \"\"\"Orchestrates validation, rotation generation, odd-checking, and aggregation.\"\"\"\n    def __init__(self):\n        self._validator = Validator()\n\n    def odd_Equivalent(self, s: str, n: int) -> int:\n        \"\"\"Public API method to count odd rotations.\"\"\"\n        self._validator.validate_string(s)\n        self._validator.validate_n(n)\n\n        if n == 0:\n            return 0\n        \n        return self._count_odd_rotations(s, n)\n\n    def _count_odd_rotations(self, s: str, n: int) -> int:\n        \"\"\"Internal helper to loop through rotations and count odd ones.\"\"\"\n        bs = BinaryString(s)\n        odd_count = 0\n        for r in range(n):\n            rot = bs.rotate(r)\n            if rot.is_odd():\n                odd_count += 1\n        return odd_count\ndef odd_Equivalent(s: str, n: int) -> int:\n    \"\"\"Public API function for odd_Equivalent, delegating to OddCounter.\"\"\"\n    return OddCounter().odd_Equivalent(s, n)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["10000100110011", 5]]}], "Mbpp/116": [{"task_id": "Mbpp/116", "solution": "class InputTuple:\n    \"\"\"Represents the input tuple with its elements.\"\"\"\n    def __init__(self, elements: tuple):\n        self.elements = elements\nclass TupleElement:\n    \"\"\"Represents a single element within the input tuple.\"\"\"\n    def __init__(self, value: int, position: int):\n        self.value = value\n        self.position = position\nclass OutputInteger:\n    \"\"\"Represents the final concatenated integer output.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\nclass Validator:\n    \"\"\"Validates the input tuple and its elements based on business rules.\"\"\"\n    def validate(self, input_tuple_raw) -> list[TupleElement]:\n        \"\"\"\n        Validates