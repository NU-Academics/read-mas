n True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/282": [{"task_id": "Mbpp/282", "solution": "def sub_list(list1, list2):\n    \"\"\"Performs element-wise subtraction of two lists.\n    Trusts inputs are valid and of equal length.\n    \"\"\"\n    result = []\n    for i in range(len(list1)):\n        result.append(list1[i] - list2[i])\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/282", "solution": "import pytest\nfrom src.sub_list import sub_list", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/283": [{"task_id": "Mbpp/283", "solution": "from typing import Dict, Iterable, Tuple\nfrom collections import Counter\nclass IntegerInput:\n    \"\"\"Represents the input integer value as a domain object.\n    Its value is used to extract digits.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def to_abs_str(self) -> str:\n        \"\"\"Returns the decimal string of the absolute value of the integer.\"\"\"\n        return str(abs(self.value))\nclass DigitFrequency:\n    \"\"\"Holds a mapping from digit value to its frequency count.\n    Provides methods to access and iterate over these frequencies.\"\"\"\n    def __init__(self, frequencies: Dict[int, int]) -> None:\n        self.frequencies = frequencies\n\n    def get(self, digit: int) -> int:\n        \"\"\"Returns the frequency of a given digit, defaulting to 0 if not present.\"\"\"\n        return self.frequencies.get(digit, 0)\n\n    def items(self) -> Iterable[Tuple[int, int]]:\n        \"\"\"Returns an iterable of (digit, frequency) pairs for all counted digits.\"\"\"\n        return self.frequencies.items()\ndef compute_frequencies(integer: int) -> DigitFrequency:\n    \"\"\"Converts the integer to its absolute decimal digits and computes their frequencies.\n    It utilizes the IntegerInput class and collections.Counter for efficiency.\"\"\"\n    integer_input = IntegerInput(integer)\n    digits_str = integer_input.to_abs_str()\n    frequencies_map = Counter(int(d) for d in digits_str)\n    return DigitFrequency(dict(frequencies_map))\ndef validate(integer: int) -> bool:\n    \"\"\"Checks whether the frequency of each digit in the integer is less than or equal to the digit itself.\n    The validation ignores the sign of the input integer.\"\"\"\n    digit_frequencies = compute_frequencies(integer)\n    \n    for digit_value, frequency_count in digit_frequencies.items():\n        if frequency_count > digit_value:\n            return False\n            \n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/283", "solution": "from typing import List, Dict\ndef _extract_digits(n: int) -> List[int]:\n    \"\"\"Extracts decimal digits from the absolute value of n.\n    Handles single digit input including zero correctly.\n    \"\"\"\n    s_n = str(abs(n))\n    return [int(d) for d in s_n]\ndef _count_frequencies(digits: List[int]) -> Dict[int, int]:\n    \"\"\"Counts the frequency of each distinct digit in a list.\n    Returns a dictionary mapping each digit to its count.\n    \"\"\"\n    freqs = {}\n    for d in digits:\n        freqs[d] = freqs.get(d, 0) + 1\n    return freqs\ndef _compare_counts(freqs: Dict[int, int]) -> bool:\n    \"\"\"Compares digit frequencies against the digit value itself.\n    Returns True if count(d) <= d for all distinct digits d, otherwise False.\n    \"\"\"\n    for digit, count in freqs.items():\n        if not (count <= digit):\n            return False\n    return True\ndef validate(n: int) -> bool:\n    \"\"\"Checks if for every distinct decimal digit d present in the absolute-value\n    decimal representation of n, its frequency is less than or equal to d.\n    \"\"\"\n    digits = _extract_digits(n)\n    frequencies = _count_frequencies(digits)\n    return _compare_counts(frequencies)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/284": [{"task_id": "Mbpp/284", "solution": "def check_element(list, element) -> bool:\n    \"\"\"\n    Checks if every item in the provided list equals the given element.\n    Returns True if all items match, False otherwise, using the standard equality operator.\n    \"\"\"\n    for item in list:\n        if item != element:\n            return False\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/284", "solution": "import pytest\nfrom src.check_element import check_element, EqualityComparator, BooleanResult, CheckElementFunction", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/285": [{"task_id": "Mbpp/285", "solution": "import re\nclass InputString:\n    \"\"\"Holds the raw input string value.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value: str = value\nclass Pattern:\n    \"\"\"Encapsulates a regex pattern and provides a matching method.\"\"\"\n    def __init__(self, regex: str) -> None:\n        self.regex: str = regex\n        self._compiled = re.compile(regex)\n\n    def matches(self, input_str: str) -> bool:\n        \"\"\"Checks if the compiled regex finds a match anywhere in the given string.\"\"\"\n        return self._compiled.search(input_str) is not None\nclass Result:\n    \"\"\"Holds the boolean outcome of a pattern match.\"\"\"\n    def __init__(self, matches: bool) -> None:\n        self.matches: bool = matches\ndef text_match_two_three(input: str) -> bool:\n    \"\"\"\n    Checks if the input string contains 'abb' (two 'b's) or 'abbb' (three 'b's).\n    This function utilizes helper classes for traceability and pattern matching.\n    \"\"\"\n    input_str_obj = InputString(input)\n    pattern_obj = Pattern(r\"ab{2,3}\")\n    matched = pattern_obj.matches(input_str_obj.value)\n    result_obj = Result(matched)\n    return result_obj.matches", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/285", "solution": "import re\n_PATTERN_RE: str = r\"ab{2,3}\"\ndef text_match_two_three(input_string: str) -> bool:\n    \"\"\"Return True if input_string contains 'abb' or 'abbb' as substring; else False.\"\"\"\n    return re.search(_PATTERN_RE, input_string) is not None", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/286": [{"task_id": "Mbpp/286", "solution": "from dataclasses import dataclass\nfrom src.validator import Validator\nfrom src.repeated_array import RepeatedArray\nfrom src.subarray_calculator import SubarrayCalculator\nfrom src.result import Result\nclass Validator:\n    \"\"\"Input validation helpers enforcing n==len(arr) and k>=1.\"\"\"\n    def validateNEqualsLength(self, arr: list[int], n: int) -> None:\n        \"\"\"Raises ValueError if n does not equal the length of arr.\"\"\"\n        if n != len(arr):\n            raise ValueError(\"n must equal len(arr)\")\n\n    def validateKPositive(self, k: int) -> None:\n        \"\"\"Raises ValueError if k is not a positive integer (k >= 1).\"\"\"\n        if k < 1:\n            raise ValueError(\"k must be a positive integer (k >= 1)\")\nclass SubarrayCalculator:\n    \"\"\"Compute maximum contiguous subarray sums, including repeated-array handling.\"\"\"\n    def kadane(self, arr: list[int]) -> int:\n        \"\"\"Computes maximum contiguous subarray sum for a single array.\n        Handles negative-only arrays by returning the maximum single element.\n        \"\"\"\n        if not arr:\n            return 0\n\n        max_so_far = arr[0]\n        current_max = arr[0]\n\n        for i in range(1, len(arr)):\n            current_max = max(arr[i], current_max + arr[i])\n            max_so_far = max(max_so_far, current_max)\n        return max_so_far\n\n    def maxSubarrayRepeated(self, arr: list[int], k: int) -> int:\n        \"\"\"Computes maximum contiguous subarray sum for arr repeated k times.\"\"\"\n        if not arr:\n            return 0\n\n        # Case 1: k = 1\n        if k == 1:\n            return self.kadane(arr)\n\n        # Case 2: k > 1\n        # Max subarray sum entirely within one block\n        max_in_single_block = self.kadane(arr)\n\n        # Max subarray sum spanning across up to two blocks (arr + arr)\n        # This covers cross-boundary subarrays and is sufficient if total_sum <= 0.\n        max_in_double_block = self.kadane(arr + arr)\n\n        total_sum = sum(arr)\n\n        # If total sum is positive, consider extending with middle blocks\n        if total_sum > 0:\n            # Calculate max prefix sum\n            current_prefix_sum = 0\n            max_prefix_sum = float('-inf')\n            for x in arr:\n                current_prefix_sum += x\n                max_prefix_sum = max(max_prefix_sum, current_prefix_sum)\n\n            # Calculate max suffix sum\n            current_suffix_sum = 0\n            max_suffix_sum = float('-inf')\n            for x in reversed(arr):\n                current_suffix_sum += x\n                max_suffix_sum = max(max_suffix_sum, current_suffix_sum)\n            \n            # Combine max prefix, middle blocks (if k > 2), and max suffix\n            max_with_k_blocks = max_prefix_sum + (k - 2) * total_sum + max_suffix_sum\n            return int(max(max_in_double_block, max_with_k_blocks))\n        else:\n            # If total_sum is not positive, adding more blocks will not increase sum.\n            # The maximum must come from within two blocks.\n            return max_in_double_block\ndef max_sub_array_sum_repeated(arr: list[int], n: int, k: int) -> int:\n    \"\"\"\n    Computes the maximum contiguous subarray sum in arr repeated k times.\n    Validates inputs and orchestrates the calculation components.\n    \"\"\"\n    validator = Validator()\n    validator.validateNEqualsLength(arr, n)\n    validator.validateKPositive(k)\n\n    # RepeatedArray.build(arr, k) is conceptually used but not strictly necessary\n    # for the current SubarrayCalculator.maxSubarrayRepeated implementation.\n    # It demonstrates the architectural decomposition as per design.\n    # repeated_array_meta = RepeatedArray.build(arr, k)\n\n    calculator = SubarrayCalculator()\n    max_sum = calculator.maxSubarrayRepeated(arr, k)\n\n    # Per design, Result is an internal container, but public API returns int.\n    # final_result_obj = Result(maxSum=max_sum, status=\"Success\")\n\n    return max_sum", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/286", "solution": "import math\nclass ArrayInput:\n    \"\"\"Represents the input triple (arr, n, k).\"\"\"\n    def __init__(self, elements: list[int], n: int, k: int) -> None:\n        self.elements = elements\n        self.n = n\n        self.k = k\n\n    def getLength(self) -> int:\n        \"\"\"Returns the length of the elements list.\"\"\"\n        return len(self.elements)\nclass SubarraySumResult:\n    \"\"\"Wraps the integer computation result.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\nclass Validator:\n    \"\"\"Validates arr, n, and k according to business rules.\"\"\"\n    def validateTypes(self, array_input: ArrayInput) -> bool:\n        # Per CRITICAL REQUIREMENTS, avoid isinstance checks and type guards.\n        # Assume types are correct for elements, n, k based on design specification.\n        return True\n\n    def validateNMatchesArr(self, array_input: ArrayInput) -> bool:\n        \"\"\"Validates if n matches the length of arr.\"\"\"\n        if array_input.n != array_input.getLength():\n            raise ValueError(f\"n ({array_input.n}) must equal len(arr) ({array_input.getLength()}).\")\n        return True\n\n    def validateK(self, array_input: ArrayInput) -> bool:\n        \"\"\"Validates if k is an integer >= 1.\"\"\"\n        if array_input.k < 1:\n            raise ValueError(f\"k ({array_input.k}) must be an integer greater than or equal to 1.\")\n        return True\n\n    def validateArrNotEmpty(self, array_input: ArrayInput) -> bool:\n        \"\"\"Validates if arr is a non-empty list.\"\"\"\n        if not array_input.elements:\n            raise ValueError(\"arr must be a non-empty list of integers.\")\n        return True\n\n    def validateAll(self, array_input: ArrayInput) -> None:\n        \"\"\"Performs all input validations, raising ValueError on failure.\"\"\"\n        self.validateTypes(array_input)\n        self.validateNMatchesArr(array_input)\n        self.validateK(array_input)\n        self.validateArrNotEmpty(array_input)\nclass RepeatedArray:\n    \"\"\"Constructs a physically repeated array when k is small.\"\"\"\n    def __init__(self, elements: list[int], k: int) -> None:\n        self.elements = elements\n        self.k = k\n\n    def construct(self) -> list[int]:\n        \"\"\"Returns the elements list repeated k times.\"\"\"\n        return self.elements * self.k\nclass Algorithm:\n    \"\"\"Computes max contiguous subarray sums and optimized repeated-array computation.\"\"\"\n    def computeMaxSubarray(self, arr: list[int]) -> int:\n        \"\"\"Implements Kadane's algorithm, handling all-negative arrays.\"\"\"\n        # Validation ensures arr is non-empty.\n        max_so_far = arr[0]\n        current_max = arr[0]\n\n        for i in range(1, len(arr)):\n            current_max = max(arr[i], current_max + arr[i])\n            max_so_far = max(max_so_far, current_max)\n        \n        return max_so_far\n\n    def computeOptimized(self, arr: list[int], k: int) -> int:\n        \"\"\"Optimized logic for repeated arrays for large k.\"\"\"\n        total_sum = sum(arr)\n        \n        # Calculate max subarray sum for two concatenated arrays to handle wrapping once.\n        max_sum_double_arr = self.computeMaxSubarray(arr + arr)\n\n        if total_sum < 0:\n            # If the total sum of the array is negative, adding more full arrays won't help.\n            # The maximum subarray will be contained within at most two concatenations.\n            return max_sum_double_arr\n        else:\n            # If total sum is non-negative, the max sum can involve full repetitions.\n            # (k-2) accounts for the 'middle' full array copies.\n            return max_sum_double_arr + (k - 2) * total_sum\nclass FunctionCall:\n    \"\"\"Orchestrates validation, optional construction, and computation.\"\"\"\n    def __init__(self, name: str) -> None:\n        self.name = name\n\n    def invoke(self, arr: list[int], n: int, k: int) -> SubarraySumResult:\n        \"\"\"Invokes the max subarray sum computation with validation and path selection.\"\"\"\n        array_input = ArrayInput(elements=arr, n=n, k=k)\n        validator = Validator()\n        validator.validateAll(array_input)\n\n        algorithm = Algorithm()\n\n        # Implementation-chosen threshold for 'small k'\n        SMALL_K_THRESHOLD = 2 \n        # k=1 and k=2 are handled by physical concatenation path.\n        # k >= 3 are handled by optimized path.\n\n        if array_input.k <= SMALL_K_THRESHOLD:\n            repeated_array_builder = RepeatedArray(array_input.elements, array_input.k)\n            full_arr = repeated_array_builder.construct()\n            result_value = algorithm.computeMaxSubarray(full_arr)\n        else:\n            result_value = algorithm.computeOptimized(array_input.elements, array_input.k)\n        \n        return SubarraySumResult(result_value)\ndef max_sub_array_sum_repeated(arr: list[int], n: int, k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous array in the modified array \n    which is formed by repeating the given array k times.\n    \"\"\"\n    function_caller = FunctionCall(\"max_sub_array_sum_repeated\")\n    result 