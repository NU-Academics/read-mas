considers all characters, including whitespace.\n        \"\"\"\n        n = len(s)\n        if n == 0:\n            return 0\n\n        # dp[i][j] stores the length of the LPS of substring s[i...j]\n        dp = [[0] * n for _ in range(n)]\n\n        # Base case: single characters are palindromes of length 1\n        for i in range(n):\n            dp[i][i] = 1\n\n        # Fill the DP table for substrings of length 2 to n\n        # 'current_len' refers to the length of the substring being considered\n        for current_len in range(2, n + 1):\n            for i in range(n - current_len + 1):\n                j = i + current_len - 1\n                if s[i] == s[j]:\n                    # If end characters match, add 2 to LPS of inner substring\n                    dp[i][j] = 2 + dp[i + 1][j - 1]\n                else:\n                    # If end characters don't match, take max of removing one end\n                    dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])\n        \n        return dp[0][n - 1]\ndef lps(s: str) -> int:\n    \"\"\"\n    Computes the length of the longest palindromic subsequence in a string.\n    Validates input type and delegates computation to LPSFunction.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"lps: argument must be a string\")\n    input_obj = InputString(s)\n    lps_fn = LPSFunction()\n    return lps_fn.compute(input_obj.value)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/252": [{"task_id": "Mbpp/252", "solution": "import math\ndef compute_magnitude(real: float, imag: float) -> float:\n    \"\"\"Computes the magnitude (r) from real and imaginary parts.\"\"\"\n    return math.sqrt(real**2 + imag**2)\ndef compute_angle(real: float, imag: float) -> float:\n    \"\"\"Computes the angle (theta) in radians from real and imaginary parts.\"\"\"\n    return math.atan2(imag, real)\ndef convert(z) -> (float, float):\n    \"\"\"Converts a complex number or real numeric value to polar coordinates (r, theta).\"\"\"\n    if isinstance(z, complex):\n        re = z.real\n        im = z.imag\n    else:\n        re = float(z)\n        im = 0.0\n    \n    r = compute_magnitude(re, im)\n    theta = compute_angle(re, im)\n    \n    return (r, theta)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/252", "solution": "import math\nfrom typing import Tuple, Union\nclass ComplexInput:\n    \"\"\"Represents a normalized complex input with real and imaginary parts.\"\"\"\n    def __init__(self, value: Union[int, float, complex]) -> None:\n        # Normalize int/float/complex to floats using the complex() constructor.\n        complex_value = complex(value)\n        self.real: float = complex_value.real\n        self.imag: float = complex_value.imag\nclass PolarCoordinate:\n    \"\"\"Holds computed polar coordinates (r, theta) and provides tuple output.\"\"\"\n    def __init__(self, r: float, theta: float) -> None:\n        self.r: float = r\n        self.theta: float = theta\n\n    def as_tuple(self) -> Tuple[float, float]:\n        \"\"\"Returns the polar coordinates as a tuple (r, theta).\"\"\"\n        return (self.r, self.theta)\nclass Converter:\n    \"\"\"Encapsulates conversion logic from ComplexInput to PolarCoordinate.\"\"\"\n    def convert(self, value: Union[int, float, complex]) -> Tuple[float, float]:\n        \"\"\"Converts an input value to polar coordinates (r, theta).\"\"\"\n        complex_input = ComplexInput(value)\n        r = self._compute_magnitude(complex_input.real, complex_input.imag)\n        theta = self._compute_angle(complex_input.real, complex_input.imag)\n        polar_coord = PolarCoordinate(r, theta)\n        return polar_coord.as_tuple()\n\n    def _compute_magnitude(self, real: float, imag: float) -> float:\n        \"\"\"Computes the magnitude r = sqrt(real^2 + imag^2).\"\"\"\n        return math.sqrt(real**2 + imag**2)\n\n    def _compute_angle(self, real: float, imag: float) -> float:\n        \"\"\"Computes the angle theta = atan2(imag, real).\"\"\"\n        return math.atan2(imag, real)\ndef convert(value: Union[int, float, complex]) -> Tuple[float, float]:\n    \"\"\"\n    Converts a Python complex or real numeric value into polar coordinates.\n    The input can be int, float, or complex.\n    \"\"\"\n    converter = Converter()\n    return converter.convert(value)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/253": [{"task_id": "Mbpp/253", "solution": "def count_integer(lst: list) -> int:\n    \"\"\"Return the number of elements in lst whose runtime type is exactly int.\n    Booleans, floats, and other types are not counted.\n    \"\"\"\n    count = 0\n    for x in lst:\n        if type(x) is int:\n            count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/253", "solution": "from typing import List, Any\ndef count_integer(input_list: List[Any]) -> int:\n    \"\"\"Return the number of elements in input_list whose type is int.\n\n    Args:\n        input_list: list of elements to inspect\n    Returns:\n        int: number of elements whose type is int\n    \"\"\"\n    # Implementation must follow SRS: only count elements whose type is int.\n    count = 0\n    for el in input_list:\n        if type(el) is int:\n            count += 1\n    return int(count)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/237": [{"task_id": "Mbpp/237", "solution": "import pytest\nfrom src.check_occurences import (\n    check_occurences,\n    ValidationError\n)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/237", "solution": "from typing import Any, List, Tuple, Dict\nclass InputList:\n    \"\"\"\n    Lightweight wrapper around the caller-provided list of 2-element tuples.\n    Provides safe, read-only access without modifying the original list.\n    \"\"\"\n    def __init__(self, tuples: List[Tuple[Any, Any]]) -> None:\n        self._tuples = tuples\n\n    def getTuples(self) -> List[Tuple[Any, Any]]:\n        \"\"\"\n        Returns a shallow copy of the list of tuples.\n        This prevents direct modification of the internal list by consumers.\n        \"\"\"\n        return list(self._tuples)\nclass TuplePair:\n    \"\"\"\n    Represents an input ordered pair (a, b).\n    Provides functionality to normalize itself into a NormalizedTuple.\n    \"\"\"\n    def __init__(self, a: Any, b: Any) -> None:\n        self.a = a\n        self.b = b\n\n    def normalize(self) -> 'NormalizedTuple':\n        \"\"\"\n        Normalizes the tuple by ordering its two elements non-decreasingly.\n        Returns a new NormalizedTuple instance with elements (min, max).\n        \"\"\"\n        return NormalizedTuple(min(self.a, self.b), max(self.a, self.b))\nclass NormalizedTuple:\n    \"\"\"\n    Immutable, hashable representation of (first <= second) used as dictionary keys.\n    Provides methods for comparison and hashing.\n    \"\"\"\n    def __init__(self, first: Any, second: Any) -> None:\n        self.first = first\n        self.second = second\n\n    def asTuple(self) -> Tuple[Any, Any]:\n        \"\"\"\n        Returns the normalized elements as a standard Python tuple.\n        This allows for straightforward use as a dictionary key.\n        \"\"\"\n        return (self.first, self.second)\n\n    def __eq__(self, other: object) -> bool:\n        \"\"\"\n        Compares this NormalizedTuple with another object for equality.\n        Equality is based on the values of 'first' and 'second' elements.\n        \"\"\"\n        # CRITICAL requirement: Do NOT add isinstance() checks. Trust caller's inputs.\n        return self.first == other.first and self.second == other.second # type: ignore [attr-defined]\n\n    def __hash__(self) -> int:\n        \"\"\"\n        Computes a hash value for the NormalizedTuple.\n        This enables NormalizedTuple instances to be used in hash-based collections.\n        \"\"\"\n        return hash((self.first, self.second))\nclass OccurrenceCounter:\n    \"\"\"\n    Aggregates counts of NormalizedTuple values from an InputList.\n    It produces a ResultDictionary containing the final counts.\n    \"\"\"\n    def __init__(self) -> None:\n        # Internal counts are keyed by builtin tuple for interop with ResultDictionary.\n        self._counts: Dict[Tuple[Any, Any], int] = {}\n\n    def count(self, input_list: 'InputList') -> 'ResultDictionary':\n        \"\"\"\n        Processes an InputList, normalizes each tuple, and aggregates their occurrences.\n        Returns a ResultDictionary built from the aggregated counts.\n        \"\"\"\n        for item_tuple in input_list.getTuples():\n            pair = TuplePair(item_tuple[0], item_tuple[1])\n            normalized = pair.normalize()\n            normalized_key = normalized.asTuple()\n            self._counts[normalized_key] = self._counts.get(normalized_key, 0) + 1\n        return ResultDictionary(self._counts)\nclass ResultDictionary:\n    \"\"\"\n    Wraps the final mapping of normalized tuples to counts.\n    Exposes methods for accessing specific counts and converting to a plain dictionary.\n    \"\"\"\n    def __init__(self, mapping: Dict[Tuple[Any, Any], int]) -> None:\n        self._map = mapping\n\n    def get(self, key: 'NormalizedTuple') -> int:\n        \"\"\"\n        Returns the count for a given NormalizedTuple key.\n        Returns 0 if the key is not found in the mapping.\n        \"\"\"\n        return self._map.get(key.asTuple(), 0)\n\n    def toDict(self) -> Dict[Tuple[Any, Any], int]:\n        \"\"\"\n        Returns a new plain dictionary mapping normalized builtin tuples to integer counts.\n        This provides a standard dictionary format for the caller.\n        \"\"\"\n        return dict(self._map)\ndef check_occurences(input_list: list) -> dict:\n    \"\"\"\n    Normalizes 2-element tuples in an input list and counts their occurrences.\n    Returns a dictionary where keys are normalized tuples and values are their counts.\n    \"\"\"\n    il = InputList(input_list)\n    oc = OccurrenceCounter()\n    rd = oc.count(il)\n    return rd.toDict()", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[[1], [2, 3], [4, 5, 6], [7, 8], [9], [1], [2, 3]]]]}], "Mbpp/256": [{"task_id": "Mbpp/256", "solution": "def count_Primes_nums(n):\n    # Returns the count of prime numbers strictly less than n.\n    # Implements deterministic trial division for primality testing.\n\n    if n <= 2:\n        return 0\n\n    prime_count = 0\n    for candidate in range(2, n):\n        # Inlined primality test logic.\n        is_prime = True\n        \n        if candidate == 2:\n            is_prime = True\n        elif candidate % 2 == 0:\n            is_prime = False\n        else:\n            # Trial division up to integer square root of the candidate.\n            limit = int(candidate**0.5)\n            for i in range(3, limit + 1, 2):\n                if candidate % i == 0:\n                    is_prime = False\n                    break\n        \n        if is_prime:\n            prime_count += 1\n            \n    return prime_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/256", "solution": "from typing import Optional\nclass InputNumber:\n    \"\"\"Encapsulate numeric input and non-negativity check.\"\"\"\n    def __init__(self, value: float):\n        self.value = value\n\n    def is_non_negative(self) -> bool:\n        \"\"\"Checks if the encapsulated value is non-negative.\"\"\"\n        return self.value >= 0\nclass PrimeNumber:\n    \"\"\"Represent an integer candidate and determine primality.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def is_prime(self) -> bool:\n        \"\"\"Determines if the encapsulated integer is a prime number.\"\"\"\n        if self.value <= 1:\n            return False\n        if self.value <= 3:  # 2 and 3 are prime\n            return True\n        if self.value % 2 == 0 or self.value % 3 == 0:\n            return False\n        # Check for factors from 5 onwards with a step of 6 (6k +/- 1 optimization)\n        i = 5\n        # Loop up to the square root of value (using **0.5 operator)\n        while i * i <= self.value:\n            if self.value % i == 0 or self.value % (i + 2) == 0:\n                return False\n            i += 6\n        return True\nclass PrimeCountResult:\n    \"\"\"Holder for integer count result.\"\"\"\n    def __init__(self, count: int):\n        self.count = count\nclass PrimeCounter:\n    \"\"\"Validate and compute count of primes strictly less than n.\"\"\"\n    def validate_input(self, n) -> bool:\n        \"\"\"Validates if the input number n is non-negative.\"\"\"\n        inp = InputNumber(float(n)) # Cast to float for consistency with InputNumber\n        return inp.is_non_negative()\n\n    def count_primes(self, n) -> int:\n        \"\"\"Computes the count of prime numbers strictly less than n.\"\"\"\n        count = 0\n        # Iterate through integers from 2 up to floor(n - 1)\n        for candidate in range(2, int(n)):\n            prime_candidate = PrimeNumber(candidate)\n            if prime_candidate.is_prime():\n                count += 1\n        return PrimeCountResult(count).count\ndef count_Primes_nums(n) -> int:\n    \"\"\"Public API function required by BR1 / FR1.\n    Behavior: validate input is non-negative, return 0 if n <= 2, else compute and return integer count of primes < n.\n    \"\"\"\n    inp = InputNumber(float(n)) # Ensure n is treated as float for InputNumber\n    pc = PrimeCounter()\n\n    if not pc.validate_input(inp.value):\n        raise ValueError('input must be 