, field\nclass InputValidator:\n    \"\"\"Provides input validation logic for start and end parameters.\"\"\"\n    def validate(self, start: int, end: int) -> bool:\n        \"\"\"Validates that start is less than or equal to end.\"\"\"\n        return start <= end\nclass PerfectSquaresFunction:\n    \"\"\"Orchestrates validation and computation of perfect squares.\"\"\"\n    def __init__(self, validator: InputValidator = None):\n        \"\"\"Initializes with an InputValidator instance.\"\"\"\n        self.validator = validator if validator is not None else InputValidator()\n\n    def perfect_squares(self, start: int, end: int) -> ResultList:\n        \"\"\"Computes all perfect squares within the given range.\"\"\"\n        if not self.validator.validate(start, end):\n            return ResultList([])\n\n        squares = []\n\n        # Determine the smallest integer root whose square is >= start.\n        # If start is negative or zero, 0 is the first possible root.\n        calc_min_root = 0\n        if start > 0:\n            calc_min_root = math.ceil(math.sqrt(start))\n        \n        # Determine the largest integer root whose square is <= end.\n        # If end is negative, no non-negative perfect squares are possible.\n        calc_max_root = -1 \n        if end >= 0:\n            calc_max_root = math.floor(math.sqrt(end))\n\n        # Iterate roots from calc_min_root to calc_max_root (inclusive).\n        # If calc_max_root < calc_min_root, the range will be empty, correctly yielding no squares.\n        for root in range(calc_min_root, calc_max_root + 1):\n            square_value = PerfectSquare(root=root).value\n            squares.append(square_value)\n\n        return ResultList(squares)\ndef perfect_squares(start: int, end: int) -> list[int]:\n    \"\"\"Entry point to find perfect squares within a range. Delegates to PerfectSquaresFunction.\"\"\"\n    return PerfectSquaresFunction(InputValidator()).perfect_squares(start, end).to_list()", "base_statu