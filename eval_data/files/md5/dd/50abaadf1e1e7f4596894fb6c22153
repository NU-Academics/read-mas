lengths and check_mapping to determine if items follow patterns.\n        Returns True if a bijective mapping exists; otherwise False.\n        \"\"\"\n        if not self.validate_lengths(items, patterns):\n            return False\n        return self.check_mapping(items, patterns)\n\n    def validate_lengths(self, items: List[Any], patterns: List[Any]) -> bool:\n        \"\"\"\n        Checks if the lengths of items and patterns lists are equal.\n        Returns False if lengths differ, True otherwise.\n        \"\"\"\n        return len(items) == len(patterns)\n\n    def check_mapping(self, items: List[Any], patterns: List[Any]) -> bool:\n        \"\"\"\n        Iterates through pairs of items and patterns to enforce consistency and uniqueness.\n        It builds a bijective mapping and returns False on any violation.\n        \"\"\"\n        for i in range(len(items)):\n            item = items[i]\n            pattern = patterns[i]\n\n            # Enforce mapping consistency: if item was seen, it must map to the same pattern.\n            if item in self._item_to_pattern:\n                if self._item_to_pattern[item] != pattern:\n                    return False\n            \n            # Enforce mapping uniqueness: if pattern was seen, it must map to the same item.\n            if pattern in self._pattern_to_item:\n                if self._pattern_to_item[pattern] != item:\n                    return False\n\n            # Establish or confirm the bijective mapping.\n            self._item_to_pattern[item] = pattern\n            self._pattern_to_item[pattern] = item\n            \n        return True\ndef is_samepatterns(items: List[Any], patterns: List[Any]) -> bool:\n    \"\"\"\n    Public API to check if a list of items follows a given pattern sequence.\n    It returns a boolean indicating whether a bijective mapping exists across all indices.\n    \"\"\"\n    checker = PatternChecker()\n    return checker.is_samepatterns(items, patterns)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[["red", "red", "red", "red", "red", "red"], ["a", "b", "c", "a", "b", "c"]]]}, {"task_id": "Mbpp/74", "solution": "from typing import Any, Dict, List, Optional\nclass PatternMapping:\n    \"\"\"Manages the mapping from values in sequence1 to values in sequence2, ensuring consistency and injectivity.\"\"\"\n    def __init__(self) -> None:\n        self._map: Dict[Any, Any] = {}\n        self._reverse_map: Dict[Any, Any] = {} # Maps to_value -> from_value for injectivity checks\n\n    def addMapping(self, from_value: Any, to_value: Any) -> bool:\n        \"\"\"\n        Adds a mapping from from_value to to_value, enforcing consistency and injectivity.\n        Returns False if the mapping introduces inconsistency or a non-injective collision.\n        \"\"\"\n        # Check for consistency (FR4): If from_value is already mapped, its mapping must be to_value.\n        if from_value in self._map:\n            return self._map[from_value] == to_value\n        \n        # Check for non-injective collision (FR5): If to_value is already mapped to a DIFFERENT from_value.\n        # If to_value is in _reverse_map and maps to an existing, distinct from_value, it's not injective.\n        if to_value in self._reverse_map and self._reverse_map[to_value] != from_value:\n            return False\n        \n        # Add the new mapping as it's consistent and doesn't violate injectivity so far.\n        self._map[from_value] = to_value\n        self._reverse_map[to_value] = from_value\n        return True\n\n    def getMapping(self, from_value: Any) -> Optional[Any]:\n        \"\"\"Retrieves the mapped 'to_value' for a given 'from_value', or None if not mapped.\"\"\"\n        return self._map.get(from_value)\n\n    def isInjective(self) -> bool:\n        \"\"\"Checks if the overall mapping is injective (one-to-one).\"\"\"\n        # An injective mapping will have an equal number of unique from_values and to_values.\n        return len(self._map) == len(self._reverse_map)\n\n    def isConsistent(self) -> bool:\n        \"\"\"Checks if the mapping has maintained consistency. This is guaranteed if addMapping always returned True.\"\"\"\n        # If addMapping did not return False for any input, then consistency was maintained throughout.\n        return True\ndef is_samepatterns(sequence1: List[Any], sequence2: List[Any]) -> bool:\n    \"\"\"\n    Determines if sequence2 follows the same pattern as sequence1 by constructing and validating a mapping.\n    This function orchestrates input length validation, mapping construction, and injectivity checks.\n    \"\"\"\n    # 1. Validate input lengths (FR2)\n    if len(sequence1) != len(sequence2):\n        return False\n\n    # 2. Instantiate PatternMapping to store and validate the mapping\n    pattern_mapping = PatternMapping()\n\n    # 3. Iterate through sequences to build and validate the mapping element by element (FR3, FR4, FR5)\n    for i in range(len(sequence1)):\n        v1 = sequence1[i]\n        v2 = sequence2[i]\n        # Attempt to add mapping; if it violates consistency or injectivity, return False immediately.\n        if not pattern_mapping.addMapping(v1, v2):\n            return False\n\n    # 4. After processing all elements, perform a final check for overall injectivity (FR5).\n    if not pattern_mapping.isInjective():\n        return False\n\n    # 5. If all checks pass, the sequences follow the same pattern.\n    return True", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[["red", "red", "red", "red", "red", "red"], ["a", "b", "c", "a", "b", "c"]]]}], "Mbpp/79": [{"task_id": "Mbpp/79", "solution": "from src.word_len import word_len", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "Mbpp/79", "solution": "from word_len import word_len", "base_status": "fail", "plus_status": "fail", "base_fail_tests": []