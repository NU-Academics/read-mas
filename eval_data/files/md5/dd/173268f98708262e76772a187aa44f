 List['Cell']:\n            \"\"\"Returns a list of valid adjacent cells (up, down, left, right).\"\"\"\n            neighbors = []\n            directions = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Up, Down, Left, Right\n            for dr, dc in directions:\n                new_row, new_col = self.row + dr, self.column + dc\n                if grid.is_valid_coordinate(new_row, new_col):\n                    neighbors.append(grid.get_cell(new_row, new_col))\n            return neighbors\n\n        def __eq__(self, other):\n            if not isinstance(other, Cell):\n                return NotImplemented\n            return self.row == other.row and self.column == other.column\n\n        def __hash__(self):\n            return hash((self.row, self.column))\n\n    class Grid:\n        \"\"\"Represents the N x N grid, provides access to cells and boundary checks.\"\"\"\n        def __init__(self, grid_data: List[List[int]]):\n            self.N = len(grid_data)\n            self._cells: List[List[Cell]] = []\n            for r in range(self.N):\n                row_cells = []\n                for c in range(self.N):\n                    row_cells.append(Cell(r, c, grid_data[r][c]))\n                self._cells.append(row_cells)\n\n        def get_cell(self, row: int, col: int) -> Cell:\n            \"\"\"Returns the Cell object at the specified (row, col) coordinate.\"\"\"\n            return self._cells[row][col]\n\n        def is_valid_coordinate(self, row: int, col: int) -> bool:\n            \"\"\"Checks if (row, col) is within grid bounds.\"\"\"\n            return 0 <= row < self.N and 0 <= col < self.N\n\n        def get_all_cells(self) -> List[Cell]:\n            \"\"\"Returns a flat list of all cells in the grid.\"\"\"\n            all_cells = []\n            for r in range(self.N):\n                for c in range(self.N):\n                    all_cells.append(self._cells[r][c])\n            return all_cells\n\n    class Path:\n        \"\"\"Represents a path of