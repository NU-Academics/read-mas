                return AlphabetHelper._LOWERCASE_ALPHABET[(idx + 2) % len(AlphabetHelper._LOWERCASE_ALPHABET)]\n            elif 'A' <= char <= 'Z':\n                idx = AlphabetHelper._UPPERCASE_ALPHABET.find(char)\n                if idx != -1:\n                    return AlphabetHelper._UPPERCASE_ALPHABET[(idx + 2) % len(AlphabetHelper._UPPERCASE_ALPHABET)]\n            return char\n\n    def _process_character(char: str, alphabet_helper: AlphabetHelper) -> str:\n        \"\"\"Applies encoding rules to a single character.\"\"\"\n        if alphabet_helper.is_letter(char):\n            swapped_char = alphabet_helper.swap_case(char)\n            if alphabet_helper.is_vowel(swapped_char):\n                return alphabet_helper.get_two_places_ahead(swapped_char)\n            else:\n                return swapped_char\n        else:\n            return char\n\n    encoded_chars = []\n    alphabet_helper = AlphabetHelper()\n    for char in message:\n        encoded_chars.append(_process_character(char, alphabet_helper))\n    return \"\".join(encoded_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/98": [{"task_id": "HumanEval/98", "solution": "def count_upper(s):\n    \"\"\"\n    Given a string s, count the number of uppercase vowels in even indices.\n\n    For example:\n    count_upper('aBCdEf') returns 1\n    count_upper('abcdefg') returns 0\n    count_upper('dBBE') returns 0\n    \"\"\"\n    def _is_uppercase_vowel(char: str) -> bool:\n        \"\"\"\n        Checks if a character is an uppercase vowel.\n        \"\"\"\n        return char in ('A', 'E', 'I', 'O', 'U')\n\n    count = 0\n    for i, char in enumerate(s):\n        if i % 2 == 0:\n            if _is_uppercase_vowel(char):\n                count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/99": [{"task_id": "HumanEval/99", "solution": "import math\ndef cl