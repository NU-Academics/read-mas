r(self):\n        \"\"\"Checks if the prefix starts with a latin alphabet letter.\"\"\"\n        return bool(self._prefix_str) and self._prefix_str[0].isalpha()\nclass FileName:\n    \"\"\"Represents a file name, parses its components, and orchestrates the application of validation rules.\"\"\"\n    def __init__(self, name):\n        self._name = name\n        self._prefix = None\n        self._extension = None\n        self._is_parseable = False\n\n        if self._count_dots() == 1:\n            parts = name.split('.', 1)\n            prefix_str = parts[0]\n            extension_str = parts[1]\n            self._prefix = FileNamePrefix(prefix_str)\n            self._extension = FileExtension(extension_str)\n            self._is_parseable = True\n\n    def _count_dots(self):\n        \"\"\"Counts dots in the full name.\"\"\"\n        return self._name.count('.')\n\n    def _count_digits_in_full_name(self):\n        \"\"\"Counts digits in the full name.\"\"\"\n        return sum(1 for char in self._name if char.isdigit())\n\n    def validate(self):\n        \"\"\"Applies all validation rules and returns True if valid, False otherwise.\"\"\"\n        if not self._is_parseable:\n            return False\n\n        # Rule 1: Not more than three digits\n        if self._count_digits_in_full_name() > 3:\n            return False\n\n        # Rule 2: Exactly one dot (handled by _is_parseable during init)\n\n        # Rule 3: Substring before the dot should not be empty\n        if not self._prefix.is_not_empty():\n            return False\n\n        # Rule 4: Substring before the dot starts with a latin alphabet letter\n        if not self._prefix.starts_with_latin_letter():\n            return False\n\n        # Rule 5: Substring after the dot should be one of ['txt', 'exe', 'dll']\n        if not self._extension.is_valid_type():\n            return False\n\n        return True\ndef file_name_check(file_name):\n    \"\"\"Create a function which takes a string representin