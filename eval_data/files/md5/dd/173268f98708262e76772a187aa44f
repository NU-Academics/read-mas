 else:\n                differences.append(int(math.fabs(game[i] - guess[i])))\n        return differences\ndef compare(game,guess):\n    \"\"\"Determines how far off each guess was from the actual game score.\n    Returns a list of integers representing the absolute differences.\"\"\"\n    InputValidator.validate_lengths(game, guess)\n    return DifferenceCalculator.calculate_differences(game, guess)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/154": [{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\n    cycpattern_check(\"abcd\",\"abd\") => False\n    cycpattern_check(\"hello\",\"ell\") => True\n    cycpattern_check(\"whassup\",\"psus\") => False\n    cycpattern_check(\"abab\",\"baa\") => True\n    cycpattern_check(\"efef\",\"eeff\") => False\n    cycpattern_check(\"himenss\",\"simen\") => True\n\n    \"\"\"\n\n    def _generate_rotations(s):\n        \"\"\"Generates all unique cyclic rotations of a given string.\n        \"\"\"\n        if not s:\n            return [\"\"]\n        rotations = set()\n        n = len(s)\n        for i in range(n):\n            rotated_s = s[i:] + s[:i]\n            rotations.add(rotated_s)\n        return list(rotations)\n\n    def _is_substring(main_string, sub_string):\n        \"\"\"Checks if a sub_string exists within main_string.\n        \"\"\"\n        return sub_string in main_string\n\n    rotations_of_b = _generate_rotations(b)\n\n    for rotation in rotations_of_b:\n        if len(rotation) > len(a):\n            continue\n        if _is_substring(a, rotation):\n            return True\n\n    return False", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/157": [{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or\n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    EPSILON = 1e-9 # A small value for floating-point comparisons\n\n    class Triangle:\n        '''\n        Encapsulates triangle side lengths and determines if it's right-angled.\n        '''\n        def __init__(self, a: float, b: float, c: float):\n            self._side_a = a\n            self._side_b = b\n            self._side_c = c\n\n        def is_right_angled(self) -> bool:\n            '''\n            Determines if the triangle is right-angled using the Pythagorean theorem.\n            '''\n            sides = sorted([self._side_a, self._side_b, self._side_c])\n            s1, s2, s3 = sides[0], sides[1], sides[2]\n            return abs(s1*s1 + s2*s2 - s3*s3) < EPSILON\n\n    triangle_obj = Triangle(a, b, c)\n    return triangle_obj.is_right_angled()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/156": [{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    roman_map = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'), (1, 'I')\n    ]\n    result = []\n    for value, symbol in roman_map:\n        while number >= value:\n            result.append(symbol)\n            number -= value\n    return \"\".join(result).lower()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/159": [{"task_id": "