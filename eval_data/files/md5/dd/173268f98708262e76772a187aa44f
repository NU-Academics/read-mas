output_string(odd_digit_count)\n        results.append(formatted_output)\n    return results", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/114": [{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums):\n    \"\"\"\n    Finds the minimum sum of any non-empty sub-array in the given list of integers.\n    Uses a variation of Kadane's algorithm to track the current minimum sum ending at each position.\n    \"\"\"\n    min_so_far = float('inf')\n    current_min = 0\n\n    for num in nums:\n        current_min = min(num, current_min + num)\n        min_so_far = min(min_so_far, current_min)\n\n    return min_so_far", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/117": [{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"Given a string s and a natural number n, you have been tasked to implement\n    a function that returns a list of all words from string s that contain exactly\n    n consonants, in order these words appear in the string s.\n    If the string s is empty then the function should return an empty list.\n    \"\"\"\n    if not s:\n        return []\n\n    def _is_consonant(char):\n        \"\"\"Determines if a given character is a consonant.\"\"\"\n        char_lower = char.lower()\n        vowels = {'a', 'e', 'i', 'o', 'u'}\n        return char_lower.isalpha() and char_lower not in vowels\n\n    def _count_consonants(word):\n        \"\"\"Counts the number of consonants in a given word.\"\"\"\n        consonant_count = 0\n        for char in word:\n            if _is_consonant(char):\n                consonant_count += 1\n        return consonant_count\n\n    words = s.split()\n    filtered_words = []\n    for word in words:\n        if _count_consonants(word) == n:\n            filtered_words.append(word)\n    return filtered_words", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/116": [{"task_id": "HumanEval/116", "solution": "def sort_array(arr):\n    \"\"\"\n    Sorts an array of integers based on the number of ones in their binary\n    representation (absolute value) and then by their decimal value.\n    \"\"\"\n    def sort_key(n):\n        # Count ones in the binary representation of the absolute value of n.\n        num_ones = bin(abs(n)).count('1')\n        # Return a tuple for sorting: (count of ones, original number).\n        return (num_ones, n)\n\n    return sorted(arr, key=sort_key)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/115": [{"task_id": "HumanEval/115", "solution": "import math", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/118": [{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"Finds the closest vowel between two consonants from the right side of the word.\n    Returns an empty string if no such vowel is found.\n    \"\"\"\n    vowels = \"aeiouAEIOU\"\n\n    def _is_vowel(char):\n        \"\"\"Checks if a character is a vowel.\"\"\"\n        return char in vowels\n\n    def _is_consonant(char):\n        \"\"\"Checks if a character is a consonant.\"\"\"\n        return char.isalpha() and not _is_vowel(char)\n\n    n = len(word)\n    if n < 3:  # A vowel between two consonants requires at least 3 characters\n        return \"\"\n\n    # Search from the right side, excluding the first and last character\n    for i in range(n - 2, 0, -1):\n        current_char = word[i]\n\n        if _is_vowel(current_char):\n            prev_char = word[i - 1]\n            next_char = word[i + 1]\n\n            if _is_consonant(prev_char) and _is_consonant(next_char):\n                return current_char\n\n    return \"\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/120": [{"task_id": "HumanEval/120", "solution": "def maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list\n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    # Input Validation\n    if not (1 <= len(arr) <= 1000):\n        raise ValueError(\"Array length must be between 1 and 1000.\")\n    for x in arr:\n        if not (-1000 <= x <= 1000):\n            raise ValueError(\"Array elements must be between -1000 and 1000.\")\n    if not (0 <= k <= len(arr)):\n        raise ValueError(\"k must be non-negative and not exceed array length.\")\n\n    # Handle k=0 case\n    if k == 0:\n        return []\n\n    # Identify k maximum numbers by sorting in descending order and slicing\n    arr.sort(reverse=True)\n    k_max_numbers = arr[:k]\n\n    # Sort the resulting k elements in ascending order as required\n    k_max_numbers.sort()\n\n    return k_max_numbers", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/119": [{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    \"\"\"\n    Checks if concatenating two parenthesis strings in any order results in a balanced string.\n    Returns 'Yes' if balanced, 'No' otherwise.\n    \"\"\"\n\n    def _is_balanced(s):\n        \"\"\"\n        Determines if a given string of parentheses is balanced.\n        Uses a counter to track balance and checks for negative balance and final zero balance.\n        \"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            else:\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    def _validate_input(input_list):\n        \"\"\"\n        Checks if the input list contains exactly two elements and if each element\n        consists solely of '(' and ')' characters.\n        \"\"\"\n        if len(input_list) != 2:\n            return False\n\n        for s_elem in input_list:\n            for char in s_elem:\n                if char not in ('(', ')'):\n                    return False\n        return True\n\n    if not _validate_input(lst):\n        return 'No'\n\n    s1 = lst[0]\n    s2 = lst[1]\n\n    if _is_balanced(s1 + s2):\n        return 'Yes'\n\n    if _is_balanced(s2 + s1):\n        return 'Yes'\n\n    return 'No'", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/121": [{"task_id": "HumanEval/121", "solution": "def solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\n    \"\"\"\n    total_sum = 0\n    for index, element in enumerate(lst):\n        if index % 2 == 0 and element % 2 != 0:\n            total_sum += element\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/122": [{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    \"\"\"\n    current_sum = 0\n    for i in range(k):\n        element = arr[i]\n        if abs(element) <= 99:  # Check if the absolute value has at most two digits.\n            current_sum += element\n    return current_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/123": [{"task_id": "HumanEval/123", "solution": "class CollatzSequence:\n    \"\"\"Provides static methods for Collatz sequence rules.\"\"\"\n    @staticmethod\n    def generate_next(current_number: int) -> int:\n        if current_number % 2 == 0:\n            return current_number // 2\n        else:\n            return 3 * current_number + 1\n\n    @staticmethod\n    def is_even(number: int) -> bool:\n        return number % 2 == 0\n\n    @staticmethod\n    def is_odd(number: int) -> bool:\n        return number % 2 != 0\n\n    @staticmethod\n    def is_terminating(number: int) -> bool:\n        return number == 1\nclass ResultList:\n    \"\"\"Manages a unique collection of odd integers and provides a sorted output.\"\"\"\n    def __init__(self):\n        self._numbers: set[int] = set()\n\n    def add_unique(self, odd_number: int):\n        self._numbers.add(odd_number)\n\n    def get_sorted_numbers(self) -> list[int]:\n        return sorted(list(self._numbers))\ndef get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n\n    The Collatz conjecture is a conjecture in mathematics that concerns a sequence defined\n    as follows: start with any positive integer n. Then each term is obtained from the\n    previous term as follows: if the previous term is even, the next term is one half of\n    the previous term. If the previous term is odd, the next term is 3 times the previous\n    term plus 1. The conjecture is that no matter what value of n, the sequence will always reach 1.\n\n    Note:\n        1. Collatz(1) is [1].\n        2. returned list sorted in increasing order.\n\n    For example:\n    get_odd_collatz(5) returns [1, 5] # The collatz sequence for 5 is [5, 16, 8, 4, 2, 1], so the odd numbers are only 1, and 5.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    current_number = n\n    odd_numbers_collector = ResultList()\n\n    while not CollatzSequence.is_terminating(current_number):\n        if CollatzSequence.is_odd(current_number):\n            odd_numbers_collector.add_unique(current_number)\n        current_number = CollatzSequence.generate_next(current_number)\n\n    if CollatzSequence.is_odd(current_number):\n        odd_numbers_collector.add_unique(current_number)\n\n    return odd_numbers_collector.get_sorted_numbers()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/127": [{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"\n    Determines whether the length of the intersection of two intervals is a prime number.\n    Returns \"YES\" if prime, \"NO\" otherwise, including when intervals don't intersect.\n    \"\"\"\n\n    def _is_prime(n):\n        \"\"\"Checks if a given integer is a prime number.\"\"\"\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    def _calculate_interval_length(interval):\n        \"\"\"Calculates the length of a given closed interval (start, end).\"\"\"\n        start, end = interval\n        return end - start + 1\n\n    def _calculate_intersection_interval(interval1, interval2):\n        \"\"\"Calculates the intersection of two intervals, returning (start, end) or None.\"\"\"\n        start1, end1 = interval1\n        start2, end2 = interval2\n\n        intersection_start = max(start1, start2)\n        intersection_end = min(end1, end2)\n\n        if intersection_start > intersection_end:\n            return None  # No intersection\n        else:\n            return (intersection_start, intersection_end)\n\n    intersect_interval = _calculate_intersection_interval(interval1, interval2)\n\n    if intersect_interval is None:\n        return \"NO\"\n    else:\n        length = _calculate_interval_length(intersect_interval)\n        if _is_prime(length):\n            return \"YES\"\n        else:\n            return \"NO\"", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[-1, 1], [0, 4]]], "plus_fail_tests": [[[10, 20], [15, 25]]]}], "HumanEval/124": [{"task_id": "HumanEval/124", "solution": "def valid_date(date):\n    \"\"\"You have to write a function which validates a given date string and\n    returns True if the date is valid otherwise False.\n    The date is valid if all of the following rules are satisfied:\n    1. The date string is not empty.\n    2. The number of days is not less than 1 or higher than 31 days for months 1,3,5,7,8,10,12. And the number of days is not less than 1 or higher than 30 days for months 4,6,9,11. And, the number of days is not less than 1 or higher than 29 for the month 2.\n    3. The months should not be less than 1 or higher than 12.\n    4. The date should be in the format: mm-dd-yyyy\n    \"\"\"\n\n    class _DateComponents:\n        \"\"\"Parses and holds month, day, year components, validates format.\"\"\"\n        def __init__(self, date_string: str):\n            if not date_string:\n                raise ValueError(\"Date string cannot be empty.\")\n\n            parts = date_string.split('-')\n            if len(parts) != 3:\n                raise ValueError(\"Invalid date format: missing or extra delimiters.\")\n\n            month_str, day_str, year_str = parts\n\n            if not (len(month_str) == 2 and len(day_str) == 2 and len(year_str) == 4):\n                raise ValueError(\"Invalid date format: incorrect part lengths.\")\n\n            try:\n                self._month = int(month_str)\n                self._day = int(day_str)\n                self._year = int(year_str)\n            except ValueError:\n                raise ValueError(\"Date components must be valid integers.\")\n\n        def get_month(self) -> int:\n            return self._month\n\n        def get_day(self) -> int:\n            return self._day\n\n        def get_year(self) -> int:\n            return self._year\n\n    def _is_valid_month(month: int) -> bool:\n        \"\"\"Validates if a given month integer is within the valid range (1-12).\"\"\"\n        return 1 <= month <= 12\n\n    def _get_max_days_in_month(month: int) -> int:\n        \"\"\"Determines max days for a given month based on rules.\"\"\"\n        if month in [1, 3, 5, 7, 8, 10, 12]:\n            return 31\n        elif month in [4, 6, 9, 11]:\n            return 30\n        elif month == 2:\n            return 29  # As per requirement 2, always 29 for month 2\n        return 0 # Should not happen if month is already validated\n\n    def _is_valid_day(day: int, month: int) -> bool:\n        \"\"\"Validates day range based on month.\"\"\"\n        max_days = _get_max_days_in_month(month)\n        return 1 <= day <= max_days\n\n    # Rule 1: The date string is not empty.\n    if not date:\n        return False\n\n    try:\n        date_components = _DateComponents(date)\n        month = date_components.get_month()\n        day = date_components.get_day()\n        # year = date_components.get_year() # Year not used for validation in current rules\n    except ValueError:\n        return False # Catches empty string, format errors, and non-integer parts\n\n    # Rule 3: The months should not be less than 1 or higher than 12.\n    if not _is_valid_month(month):\n        return False\n\n    # Rule 2: Validate day based on month\n    if not _is_valid_day(day, month):\n        return False\n\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/125": [{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',', if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    '''\n\n    def _contains_whitespace(text):\n        # Checks if the given text contains any whitespace characters.\n        return any(c.isspace() for c in text)\n\n    def _contains_comma(text):\n        # Checks if the given text contains a comma character.\n        return ',' in text\n\n    def _count_odd_ordered_lowercase_letters(text):\n        # Counts lowercase letters with odd 0-indexed alphabetical positions.\n        count = 0\n        for char in text:\n            if 'a' <= char <= 'z':\n                order = ord(char) - ord('a')\n                if order % 2 != 0:\n                    count += 1\n        return count\n\n    if _contains_whitespace(txt):\n        return txt.split()\n    elif _contains_comma(txt):\n        return txt.split(',')\n    else:\n        return _count_odd_ordered_lowercase_letters(txt)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/131": [{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n    product_of_odd_digits = 1\n    found_odd_digit = False\n\n    for char_digit in str(n):\n        digit = int(char_digit)\n        if digit % 2 != 0:\n            product_of_odd_digits *= digit\n            found_odd_digit = True\n\n    if not found_odd_digit:\n        return 0\n    else:\n        return product_of_odd_digits", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/126": [{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n    '''\n    def _check_ascending_order(lst):\n        # Checks if the list is sorted in ascending order.\n        for i in range(1, len(lst)):\n            if lst[i] < lst[i-1]:\n                return False\n        return True\n\n    def _check_duplicates(lst):\n        # Checks if any number appears more than twice in the list.\n        counts = {}\n        for num in lst:\n            counts[num] = counts.get(num, 0) + 1\n            if counts[num] > 2:\n                return False\n        return True\n\n    if n