peration)\n        if bank_account.is_below_zero():\n            return True\n    return False", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/8": [{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    \"\"\"\n    if not numbers:\n        return (0, 1)\n\n    total_sum = 0\n    total_product = 1\n    for number in numbers:\n        total_sum += number\n        total_product *= number\n\n    return (total_sum, total_product)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/7": [{"task_id": "HumanEval/7", "solution": "from typing import List\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring \"\"\"\n    return [s for s in strings if substring in s]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/6": [{"task_id": "HumanEval/6", "solution": "from typing import List\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n\n    class ParenthesesGroup:\n        def __init__(self, group_str: str):\n            self.group_string: str = group_str\n            self.deepest_nesting_level: int = 0\n\n    class ParenthesesString:\n        def __init__(self, input_str: str):\n            self.input_string: str = input_str\n            self.groups: List[ParenthesesGroup] = []\n\n    def split_paren_string_into_groups(paren_string: str, delimiter: str = ' ') -> List[str]:\n        return [group.strip() for group in paren_string.split(delimiter) if group.strip()]\n\n    class NestingLevelCalculator:\n        @staticmethod\n        def calculate_deepest_nesting(group_str: str) -> int:\n            current_max_level = 0\n            current_level = 0\n            for char in group_str:\n                if char == '(':\n                    current_level += 1\n                    current_max_level = max(current_max_level, current_level)\n                elif char == ')':\n                    current_level -= 1\n            return current_max_level\n\n    full_string_obj = ParenthesesString(paren_string)\n\n    # Use default space delimiter as per the problem description and design if not explicitly provided\n    group_strings = split_paren_string_into_groups(full_string_obj.input_string, ' ')\n\n    results: List[int] = []\n    for group_str in group_strings:\n        group_obj = ParenthesesGroup(group_str)\n        group_obj.deepest_nesting_level = NestingLevelCalculator.calculate_deepest_nesting(group_obj.group_string)\n        full_string_obj.groups.append(group_obj)\n        results.append(group_obj.deepest_nesting_level)\n\n    return results", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/11": [{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n\n    def _validate_binary_string(s: str, name: str):\n        \"\"\"Validates if a string contains only '0' or '1' characters.\"\"\"\n        for char in s:\n            if char not in ('0', '1'):\