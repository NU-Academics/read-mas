{"task_id": "Mbpp/130", "solution": "def max_occurrences(items):\n    \"\"\"\n    Return the item with maximum frequency in the given list.\n    If multiple items tie for maximum frequency, return the smallest by natural ordering.\n    Raises ValueError for empty input.\n    \"\"\"\n    if not items:\n        raise ValueError(\"items must not be empty\")\n    from collections import Counter\n\n    counts = Counter(items)\n    max_count = max(counts.values())\n    candidates = [k for k, v in counts.items() if v == max_count]\n    try:\n        return min(candidates)\n    except TypeError:\n        # Incomparable types: fall back to first encountered candidate in input order\n        seen = set(candidates)\n        for x in items:\n            if x in seen:\n                return x"}
{"task_id": "Mbpp/131", "solution": "def reverse_vowels(text: str) -> str:\n    \"\"\"Reverses only the vowels in the given string, where 'y' is not a vowel.\"\"\"\n    VOWELS = frozenset({'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'})\n\n    chars = list(text)\n    i, j = 0, len(chars) - 1\n\n    while i < j:\n        # Move pointer i forward until a vowel is found\n        while i < j and chars[i] not in VOWELS:\n            i += 1\n        # Move pointer j backward until a vowel is found\n        while i < j and chars[j] not in VOWELS:\n            j -= 1\n\n        # If both pointers found vowels and haven't crossed, swap them\n        if i < j:\n            chars[i], chars[j] = chars[j], chars[i]\n            i += 1\n            j -= 1\n\n    return ''.join(chars)"}
{"task_id": "Mbpp/133", "solution": "def sum_negativenum(numbers):\n    \"\"\"\n    Calculates the sum of all negative numbers in a given list.\n    Assumes input is a list of numbers (int or float).\n    \"\"\"\n    total_sum = 0\n    for num in numbers:\n        if num < 0:\n            total_sum += num\n    return total_sum"}
{"task_id": "Mbpp/140", "solution": "def extract_singly(data: 'Iterable[Iterable[int]]') -> 'Set[int]':\n    \"\"\"\n    Flattens an iterable of iterables of numbers into a single set of numbers.\n    Each number encountered is added to the set to ensure uniqueness.\n    \"\"\"\n    result_set = set()\n    for inner_iterable in data:\n        for number in inner_iterable:\n            result_set.add(number)\n    return result_set"}
{"task_id": "Mbpp/135", "solution": "from typing import Optional\n\nclass InvalidInputError(ValueError):\n    \"\"\"Exception raised for invalid input values.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\n\nclass MathUtils:\n    \"\"\"Utility class for mathematical computations and validation.\"\"\"\n    @staticmethod\n    def validate_n(n: object) -> None:\n        \"\"\"Validates if n is an integer and >= 1.\"\"\"\n        if not isinstance(n, int):\n            raise InvalidInputError(f\"n must be an integer, got {type(n).__name__}\")\n        if n < 1:\n            raise InvalidInputError(\"n must be >= 1\")\n\n    @staticmethod\n    def compute_hexagonal(n: int) -> int:\n        \"\"\"Computes the nth hexagonal number.\"\"\"\n        MathUtils.validate_n(n)\n        return n * (2 * n - 1)\n\nclass CacheRepository:\n    \"\"\"In-memory repository for caching hexagonal numbers.\"\"\"\n    def __init__(self) -> None:\n        self._store: dict[str, int] = {}\n\n    def get(self, key: str) -> Optional[int]:\n        \"\"\"Retrieves a value from the cache by key.\"\"\"\n        return self._store.get(key)\n\n    def set(self, key: str, value: int) -> None:\n        \"\"\"Stores a value in the cache under a given key.\"\"\"\n        self._store[key] = value\n\n    def clear(self) -> None:\n        \"\"\"Clears all entries from the cache.\"\"\"\n        self._store.clear()\n\nclass HexagonalService:\n    \"\"\"Business logic service to get hexagonal numbers, including caching.\"\"\"\n    def __init__(self, repo: CacheRepository, utils: MathUtils) -> None:\n        self._repo = repo\n        self._utils = utils\n\n    def _cache_key(self, n: int) -> str:\n        \"\"\"Generates a cache key for a given n.\"\"\"\n        return f\"hexagonal:{n}\"\n\n    def get_hexagonal_number(self, n: int) -> int:\n        \"\"\"Retrieves the nth hexagonal number, using cache or computing it.\"\"\"\n        self._utils.validate_n(n)\n        key = self._cache_key(n)\n        cached = self._repo.get(key)\n        if cached is not None:\n            return cached\n        value = self._utils.compute_hexagonal(n)\n        try:\n            self._repo.set(key, value)\n        except Exception:\n            # Cache errors are non-fatal; continue without caching.\n            pass\n        return value\n\ndef hexagonal_num(n: int) -> int:\n    \"\"\"\n    Computes the nth hexagonal number.\n    This function acts as a convenience entry point.\n    \"\"\"\n    repo = CacheRepository()\n    utils = MathUtils()\n    service = HexagonalService(repo, utils)\n    return service.get_hexagonal_number(n)"}
