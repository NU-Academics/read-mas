{"task_id": "Mbpp/391", "solution": "def convert_list_dictionary(keys, nested_keys, values):\n    \"\"\"\n    Converts three parallel lists into a list of nested dictionaries.\n    Each element combines to form a dictionary of the structure {key: {nested_key: value}}.\n    \"\"\"\n    result = []\n    for key, nested_key, value in zip(keys, nested_keys, values):\n        result.append({key: {nested_key: value}})\n    return result"}
{"task_id": "Mbpp/394", "solution": "def check_distinct(items: tuple) -> bool:\n    \"\"\"\n    Checks if the given tuple contains no duplicate elements.\n    It attempts a hash-based check, falling back to an equality-based check if unhashable elements are present.\n    \"\"\"\n    seen = set()\n    try:\n        for item in items:\n            if item in seen:\n                return False\n            seen.add(item)\n        return True\n    except TypeError:\n        # An unhashable item was encountered. Fallback to an O(N^2) equality check.\n        n = len(items)\n        for i in range(n):\n            for j in range(i + 1, n):\n                if items[i] == items[j]:\n                    return False\n        return True"}
{"task_id": "Mbpp/395", "solution": "def first_non_repeating_character(text: str) -> str | None:\n    \"\"\"\n    Finds the first non-repeated character in a string.\n    Returns the character if found, otherwise returns None.\n    \"\"\"\n    counts = {}\n    for char in text:\n        counts[char] = counts.get(char, 0) + 1\n\n    for char in text:\n        if counts[char] == 1:\n            return char\n\n    return None"}
{"task_id": "Mbpp/392", "solution": "def get_max_sum(n: int) -> int:\n    \"\"\"\n    Calculates the maximum sum for a given non-negative integer n using the recurrence:\n    f(n) = max(f(n//2) + f(n//3) + f(n//4) + f(n//5), n)\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n\n    memo: dict[int, int] = {}\n\n    def _calculate_max_sum(k: int) -> int:\n        if k in memo:\n            return memo[k]\n        if k == 0:\n            memo[k] = 0\n            return 0\n        a = _calculate_max_sum(k // 2)\n        b = _calculate_max_sum(k // 3)\n        c = _calculate_max_sum(k // 4)\n        d = _calculate_max_sum(k // 5)\n        result = max(k, a + b + c + d)\n        memo[k] = result\n        return result\n\n    return _calculate_max_sum(n)"}
{"task_id": "Mbpp/397", "solution": "def median_numbers(a, b, c):\n    \"\"\"\n    Calculates the median of three numbers.\n    The median is the middle value when the numbers are sorted.\n    \"\"\"\n    numbers = [a, b, c]\n    numbers.sort()\n    return float(numbers[1])"}
{"task_id": "Mbpp/398", "solution": "def sum_of_digits(numbers: list) -> int:\n    \"\"\"\n    Computes the sum of digits for each number in a list and returns the total sum.\n    Negative numbers are treated as their absolute value for digit summation.\n    \"\"\"\n    def _compute_single_digit_sum(n: int) -> int:\n        \"\"\"\n        Calculates the sum of the digits of a single integer, treating negative\n        numbers as their absolute value.\n        \"\"\"\n        n = abs(n)\n        total = 0\n        while n:\n            total += n % 10\n            n //= 10\n        return total\n\n    total_sum = 0\n    for number in numbers:\n        total_sum += _compute_single_digit_sum(number)\n    return total_sum"}
