{"task_id": "Mbpp/457", "solution": "def Find_Min(items):\n    \"\"\"\n    Finds the sublist with the minimum length from a list of lists.\n    Returns the first encountered sublist in case of a tie in length.\n    \"\"\"\n    if not hasattr(items, \"__iter__\"):\n        raise TypeError(\"items must be an iterable of iterables\")\n    try:\n        iterator = iter(items)\n    except TypeError:\n        raise TypeError(\"items must be an iterable of iterables\")\n\n    # Convert to list to support len/access and to raise for empty input\n    items_list = list(items)\n    if not items_list:\n        raise ValueError(\"items must not be empty\")\n\n    # Validate first element (and ensure it is iterable)\n    first = items_list[0]\n    if not hasattr(first, \"__iter__\") or isinstance(first, (str, bytes)):\n        raise TypeError(\"each element of items must be a non-string iterable\")\n\n    min_sublist = first\n    try:\n        min_length = len(first)\n    except TypeError:\n        # Fallback: compute length by iteration if len is not available\n        min_length = sum(1 for _ in first)\n\n    for sublist in items_list[1:]:\n        if not hasattr(sublist, \"__iter__\") or isinstance(sublist, (str, bytes)):\n            raise TypeError(\"each element of items must be a non-string iterable\")\n        try:\n            current_length = len(sublist)\n        except TypeError:\n            current_length = sum(1 for _ in sublist)\n        if current_length < min_length:\n            min_length = current_length\n            min_sublist = sublist\n\n    return min_sublist"}
{"task_id": "Mbpp/458", "solution": "from .dtos.rectangle_dto import RectangleDTO\nfrom .services.geometry_service import GeometryService\nfrom .repositories.rectangle_repository import InMemoryRectangleRepository\n\ndef rectangle_area(width: float, height: float) -> float:\n    \"\"\"Calculates the area of a rectangle.\n    It uses the GeometryService for validation and computation as per design.\n    \"\"\"\n    dto = RectangleDTO(width, height)\n    repo = InMemoryRectangleRepository()\n    service = GeometryService(repository=repo)\n    return service.compute_rectangle_area(dto)"}
{"task_id": "Mbpp/462", "solution": "def combinations_list(items: list) -> list:\n    \"\"\"\n    Generates all possible combinations (subsets) of elements from a list\n    in a specific order, prepending new elements to existing subsets.\n    \"\"\"\n    result = [[]]\n    for element in items:\n        new_subsets = [[element] + subset for subset in result]\n        result.extend(new_subsets)\n    return result"}
{"task_id": "Mbpp/460", "solution": "def Extract(lists):\n    \"\"\"\n    Return a list containing the first element of each sublist in `lists`.\n\n    Raises:\n        TypeError: if `lists` is not a list/tuple or any element is not a list/tuple.\n        ValueError: if any sublist is empty.\n    \"\"\"\n    if not isinstance(lists, (list, tuple)):\n        raise TypeError(\"`lists` must be a list or tuple of sublists\")\n\n    result = []\n    for i, sub in enumerate(lists):\n        if not isinstance(sub, (list, tuple)):\n            raise TypeError(f\"Element at index {i} is not a list or tuple\")\n        if len(sub) == 0:\n            raise ValueError(f\"Sublist at index {i} is empty\")\n        result.append(sub[0])\n\n    return result"}
{"task_id": "Mbpp/465", "solution": "from typing import Any, Dict\n\n_DEFAULT_EMPTY_TYPES = (type(None), str, list, tuple, set, dict)\n\ndef _is_empty_value(value: Any) -> bool:\n    if value is None:\n        return True\n    if isinstance(value, _DEFAULT_EMPTY_TYPES) and hasattr(value, '__len__') and len(value) == 0:\n        return True\n    return False\n\ndef _is_mapping(value: Any) -> bool:\n    return isinstance(value, dict)\n\ndef _clean_value_deep(value: Any) -> Any:\n    if _is_mapping(value):\n        cleaned_dict = {}\n        for k, v in value.items():\n            cleaned_v = _clean_value_deep(v)\n            if not _is_empty_value(cleaned_v):\n                cleaned_dict[k] = cleaned_v\n        return cleaned_dict\n    elif isinstance(value, (list, tuple, set)):\n        cleaned_collection = []\n        for item in value:\n            cleaned_item = _clean_value_deep(item)\n            if not _is_empty_value(cleaned_item):\n                cleaned_collection.append(cleaned_item)\n        if isinstance(value, list):\n            return cleaned_collection\n        elif isinstance(value, tuple):\n            return tuple(cleaned_collection)\n        elif isinstance(value, set):\n            return set(cleaned_collection)\n    return value\n\ndef drop_empty(mapping: Dict, deep: bool = False) -> Dict:\n    result = {}\n    for k, v in mapping.items():\n        if deep:\n            cleaned = _clean_value_deep(v)\n            if not _is_empty_value(cleaned):\n                result[k] = cleaned\n        else:\n            if not _is_empty_value(v):\n                result[k] = v\n    return result"}
{"task_id": "Mbpp/463", "solution": "def max_subarray_product(array):\n    \"\"\"\n    Finds the maximum product of a contiguous subarray in the given array.\n    This O(n) algorithm handles positive, negative, and zero numbers correctly.\n    \"\"\"\n    if not array:\n        # As per design context, input validation ensures non-empty arrays.\n        # If an empty array were passed, 0 is a reasonable fallback for max product.\n        return 0.0\n\n    # Initialize global maximum product, and current max/min products ending at the current position.\n    # The global_max is initialized with the first element.\n    global_max = float(array[0])\n    curr_max = 1.0\n    curr_min = 1.0\n\n    # Iterate through the array to find the maximum product subarray.\n    for num in array:\n        current_num_float = float(num)\n\n        if current_num_float == 0.0:\n            # If the current number is 0, any product including it will be 0.\n            # Reset current max/min products to 1 for the next subarray segment.\n            # If 0 is greater than the current global_max (e.g., all previous products were negative), update it.\n            if 0.0 > global_max:\n                global_max = 0.0\n            curr_max, curr_min = 1.0, 1.0\n            continue\n\n        # Store previous max/min to correctly calculate new max/min after multiplying by current_num_float.\n        # This is crucial because if current_num_float is negative, curr_max * current_num_float might become curr_min,\n        # and curr_min * current_num_float might become curr_max.\n        prev_curr_max = curr_max\n        prev_curr_min = curr_min\n\n        # The new current max product can be:\n        # 1. The current number itself.\n        # 2. The current number multiplied by the previous maximum product ending here.\n        # 3. The current number multiplied by the previous minimum product ending here (important for negative numbers).\n        curr_max = max(current_num_float, prev_curr_max * current_num_float, prev_curr_min * current_num_float)\n        curr_min = min(current_num_float, prev_curr_max * current_num_float, prev_curr_min * current_num_float)\n\n        # Update the overall maximum product if the current maximum product is greater.\n        if curr_max > global_max:\n            global_max = curr_max\n\n    return global_max"}
{"task_id": "Mbpp/468", "solution": "def max_product(arr):\n    \"\"\"\n    Finds the maximum product of an increasing subsequence in the given array.\n    Handles negative numbers and zeros correctly using dynamic programming.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return 0.0\n\n    # Initialize max_prod[i] and min_prod[i] with arr[i].\n    # max_prod[i] stores the maximum product of an increasing subsequence ending at arr[i].\n    # min_prod[i] stores the minimum product of an increasing subsequence ending at arr[i],\n    # which is crucial for handling negative numbers (negative * negative = positive).\n    max_prod = [float(x) for x in arr]\n    min_prod = [float(x) for x in arr]\n\n    global_max = max_prod[0]\n\n    for i in range(n):\n        for j in range(i):\n            if arr[j] < arr[i]:  # Ensure strictly increasing subsequence\n                # Candidate products by extending previous subsequences\n                cand1 = max_prod[j] * arr[i]\n                cand2 = min_prod[j] * arr[i]\n\n                # Update max_prod[i]\n                # Consider starting a new subsequence with arr[i] itself (arr[i]),\n                # or extending from j using cand1 or cand2.\n                current_max_at_i = max(cand1, cand2, arr[i])\n                if current_max_at_i > max_prod[i]:\n                    max_prod[i] = current_max_at_i\n\n                # Update min_prod[i]\n                # This keeps track of the smallest product for potential future extensions\n                current_min_at_i = min(cand1, cand2, arr[i])\n                if current_min_at_i < min_prod[i]:\n                    min_prod[i] = current_min_at_i\n\n        # Update the overall maximum product found across all subsequences\n        if max_prod[i] > global_max:\n            global_max = max_prod[i]\n\n    return global_max"}
{"task_id": "Mbpp/472", "solution": "def check_Consecutive(lst):\n    \"\"\"\n    Checks if the given list contains consecutive numbers.\n    Order of elements does not matter, but duplicates invalidate consecutiveness.\n    \"\"\"\n    n = len(lst)\n\n    # An empty list is not considered consecutive.\n    if n == 0:\n        return False\n\n    # A single-element list is always considered consecutive.\n    if n == 1:\n        return True\n\n    # Convert to a set to handle duplicates and get unique elements.\n    unique_elements = set(lst)\n\n    # If the count of unique elements is not equal to the original list length,\n    # it means there were duplicates, which invalidates consecutiveness.\n    if len(unique_elements) != n:\n        return False\n\n    # Find the minimum and maximum values among the unique elements.\n    min_val = min(unique_elements)\n    max_val = max(unique_elements)\n\n    # For consecutive numbers, the count of unique numbers should be equal to\n    # the difference between the maximum and minimum values plus one.\n    return (max_val - min_val + 1) == n"}
{"task_id": "Mbpp/471", "solution": "def find_remainder(arr, n):\n    \"\"\"\n    Finds the product of array elements modulo n using iterative modular multiplication.\n    Assumes n is a positive integer and arr contains only integers.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n    if arr is None:\n        raise ValueError(\"arr must not be None\")\n\n    current_product = 1 % n\n    try:\n        for x in arr:\n            if not isinstance(x, int):\n                raise ValueError(\"all elements of arr must be integers\")\n            # Normalize current element x to be within [0, n-1]\n            x_mod_n = x % n\n            # If any element modulo n is 0, the entire product modulo n will be 0.\n            if x_mod_n == 0:\n                return 0\n            current_product = (current_product * x_mod_n) % n\n    except TypeError:\n        raise ValueError(\"arr must be an iterable of integers\")\n    return current_product"}
