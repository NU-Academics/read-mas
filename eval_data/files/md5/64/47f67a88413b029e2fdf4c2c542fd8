{"task_id": "Mbpp/7", "solution": "import re\n\ndef find_char_long(text: str, min_length: int = 4) -> list[str]:\n    \"\"\"\n    Finds unique words of at least min_length characters in the input text.\n    Uniqueness is case-insensitive, but the output preserves the original casing and order of first appearance.\n    \"\"\"\n    found_words = []\n    seen_normalized_words = set()\n\n    # Extract words from the text, handling punctuation by matching sequences of word characters.\n    words = re.findall(r'\\b\\w+\\b', text)\n\n    for word in words:\n        if len(word) >= min_length:\n            normalized_word = word.lower()\n            if normalized_word not in seen_normalized_words:\n                found_words.append(word)\n                seen_normalized_words.add(normalized_word)\n\n    return found_words"}
{"task_id": "Mbpp/4", "solution": "import heapq\n\ndef heap_queue_largest(numbers: list[int], n: int) -> list[int]:\n    \"\"\"\n    Finds the n largest integers from a list, returned in descending order.\n    This function uses Python's heapq module for efficient computation.\n    \"\"\"\n    # Validate inputs\n    if not isinstance(numbers, list):\n        raise TypeError(\"numbers must be a list of integers\")\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    # Ensure all elements are integers\n    for i, val in enumerate(numbers):\n        if not isinstance(val, int):\n            raise TypeError(f\"element at index {i} is not an int: {val!r}\")\n\n    if n == 0:\n        return []\n\n    # heapq.nlargest returns results in descending order\n    return heapq.nlargest(n, numbers)"}
{"task_id": "Mbpp/6", "solution": "def differ_at_one_bit_pos(a: int, b: int) -> bool:\n    \"\"\"\n    Checks if two integers differ at exactly one bit position.\n    \"\"\"\n    xor_result = a ^ b\n    if xor_result == 0:\n        return False\n    abs_xor_result = abs(xor_result)\n    return (abs_xor_result & (abs_xor_result - 1)) == 0"}
{"task_id": "Mbpp/3", "solution": "def is_not_prime(n: int) -> bool:\n    \"\"\"\n    Identifies if a given integer is a non-prime number.\n    Numbers less than or equal to 1 are considered non-prime.\n    \"\"\"\n    if n <= 1:\n        return True\n    if n <= 3:\n        return False\n    if n % 2 == 0 or n % 3 == 0:\n        return True\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return True\n        i += 6\n    return False"}
{"task_id": "Mbpp/2", "solution": "from typing import Iterable, Any, List, Set\n\nclass SimilarityError(Exception):\n    \"\"\"Custom exception for similarity-related errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass SequenceNormalizer:\n    \"\"\"Normalizes iterables into lists and validates input iterability.\"\"\"\n    def normalize(self, iterable: Iterable[Any]) -> List[Any]:\n        try:\n            return list(iterable)\n        except TypeError:\n            raise SimilarityError(\"Input is not iterable\")\n\nclass HashableSetAdapter:\n    \"\"\"Provides set-based operations for hashable items for fast intersection.\"\"\"\n    def build_set(self, iterable: Iterable[Any]) -> Set[Any]:\n        s = set()\n        for item in iterable:\n            s.add(item)\n        return s\n\n    def intersection_ordered(self, list1: Iterable[Any], set2: Set[Any]) -> List[Any]:\n        seen = set()\n        out = []\n        for item in list1:\n            if item in set2 and item not in seen:\n                out.append(item)\n                seen.add(item)\n        return out\n\nclass UnhashableMatcher:\n    \"\"\"Performs equality-based intersection for sequences, handling unhashable elements.\"\"\"\n    def intersection_ordered(self, list1: Iterable[Any], list2: Iterable[Any]) -> List[Any]:\n        result = []\n        for a in list1:\n            if any(a == existing for existing in result):\n                continue\n            if any(a == b for b in list2):\n                result.append(a)\n        return result\n\nclass SimilarElementsService:\n    \"\"\"Orchestrates intersection computation, choosing the optimal path based on element hashability.\"\"\"\n    def __init__(self, hashable_adapter: HashableSetAdapter, unhashable_matcher: UnhashableMatcher, normalizer: SequenceNormalizer) -> None:\n        self._hashable_adapter = hashable_adapter\n        self._unhashable_matcher = unhashable_matcher\n        self._normalizer = normalizer\n\n    def find_similar(self, list1: Iterable[Any], list2: Iterable[Any]) -> List[Any]:\n        a = self._normalizer.normalize(list1)\n        b = self._normalizer.normalize(list2)\n        try:\n            set_b = self._hashable_adapter.build_set(b)\n            return self._hashable_adapter.intersection_ordered(a, set_b)\n        except TypeError: # Fallback to unhashable path if TypeError occurs\n            return self._unhashable_matcher.intersection_ordered(a, b)\n        except Exception as e: # Catch any other unexpected errors\n            raise SimilarityError(f\"Unexpected error: {e}\")\n\ndef similar_elements(list1: Iterable[Any], list2: Iterable[Any]) -> List[Any]:\n    \"\"\"\n    Finds unique shared elements from two iterables, preserving order from the first.\n    It attempts a fast O(N+M) path for hashable elements and falls back to an O(N*M) path for unhashable ones.\n    \"\"\"\n    service = SimilarElementsService(HashableSetAdapter(), UnhashableMatcher(), SequenceNormalizer())\n    return service.find_similar(list1, list2)"}
{"task_id": "Mbpp/8", "solution": "def square_nums(nums):\n    \"\"\"Calculates the square of each number in the input list.\"\"\"\n    return [num ** 2 for num in nums]"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(s: str) -> int:\n    \"\"\"\n    Finds the minimum number of rotations (greater than 0) required to get the same string.\n    Uses the KMP prefix-function (LPS array) to find the smallest period of the string.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string\")\n    if len(s) == 0:\n        raise ValueError(\"Input string must be non-empty\")\n\n    n = len(s)\n    # compute LPS array\n    lps = [0] * n\n    length = 0\n    i = 1\n    while i < n:\n        if s[i] == s[length]:\n            length += 1\n            lps[i] = length\n            i += 1\n        else:\n            if length != 0:\n                length = lps[length - 1]\n            else:\n                lps[i] = 0\n                i += 1\n\n    period = n - lps[-1]\n    return period if period != 0 and n % period == 0 else n"}
{"task_id": "Mbpp/14", "solution": "def find_Volume(base, triangle_height, length):\n    \"\"\"\n    Calculate the volume of a triangular prism.\n\n    Volume = (0.5 * base * triangle_height) * length\n\n    All dimensions must be numeric and > 0.\n    \"\"\"\n    try:\n        b = float(base)\n        h = float(triangle_height)\n        l = float(length)\n    except (TypeError, ValueError):\n        raise ValueError(\"All dimensions must be numeric\")\n\n    if b <= 0 or h <= 0 or l <= 0:\n        raise ValueError(\"All dimensions must be positive\")\n\n    return 0.5 * b * h * l"}
{"task_id": "Mbpp/12", "solution": "def sort_matrix(matrix):\n    \"\"\"\n    Sorts a matrix by the sum of its rows in ascending order, maintaining stability.\n    \"\"\"\n    decorated_matrix = [(sum(row), idx, row) for idx, row in enumerate(matrix)]\n    decorated_matrix.sort(key=lambda x: (x[0], x[1]))\n    return [row for _, _, row in decorated_matrix]"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(text: str, ch: str) -> str:\n    \"\"\"Removes the first and last occurrence of a given character from the string.\"\"\"\n    first = text.find(ch)\n    if first == -1:\n        return text\n    last = text.rfind(ch)\n    if first == last:\n        # Only one occurrence, remove it\n        return text[:first] + text[first+1:]\n    return text[:first] + text[first+1:last] + text[last+1:]"}
{"task_id": "Mbpp/16", "solution": "import re\nfrom typing import List, Dict\n\n# Configuration constants as per design\nPATTERN_STR: str = r'^[a-z]+(?:_[a-z]+)+$'\nPATTERN_FLAGS: int = 0\n\nclass PatternResult:\n    \"\"\"Represents the outcome of a regex validation.\"\"\"\n    def __init__(self, match: bool, groups: List[str]) -> None:\n        self.match = match\n        self.groups = groups\n\nclass PatternFactory:\n    \"\"\"Creates and caches compiled re.Pattern objects.\"\"\"\n    _cache: Dict[str, re.Pattern] = {}\n\n    def get_compiled_pattern(self, pattern_str: str, flags: int = 0) -> re.Pattern:\n        key = f\"{pattern_str}|{flags}\"\n        if key not in self._cache:\n            self._cache[key] = re.compile(pattern_str, flags)\n        return self._cache[key]\n\n    def clear_cache(self) -> None:\n        self._cache.clear()\n\nclass RegexValidator:\n    \"\"\"Encapsulates regex-based validation logic.\"\"\"\n    def __init__(self, pattern: re.Pattern) -> None:\n        self._pattern = pattern\n\n    def is_match(self, text: str) -> PatternResult:\n        # Removed isinstance check as per \"DO NOT add isinstance() checks\" requirement.\n        m = self._pattern.fullmatch(text)\n        groups: List[str] = list(m.groups()) if m else []\n        return PatternResult(bool(m), groups)\n\nclass TextPatternService:\n    \"\"\"Business logic for determining if text contains lowercase underscore sequences.\"\"\"\n    def __init__(self, validator: RegexValidator) -> None:\n        self._validator = validator\n\n    def contains_lowercase_underscore(self, text: str) -> bool:\n        result = self._validator.is_match(text)\n        return result.match\n\ndef text_lowercase_underscore(text: str) -> bool:\n    \"\"\"Checks if the input string contains sequences of lowercase letters joined with an underscore.\"\"\"\n    factory = PatternFactory()\n    pattern = factory.get_compiled_pattern(PATTERN_STR, PATTERN_FLAGS)\n    validator = RegexValidator(pattern)\n    service = TextPatternService(validator)\n    return service.contains_lowercase_underscore(text)"}
{"task_id": "Mbpp/17", "solution": "def square_perimeter(side):\n    \"\"\"Calculates the perimeter of a square.\n\n    Assumes the side length is a valid non-negative number.\n    \"\"\"\n    return 4 * side"}
{"task_id": "Mbpp/18", "solution": "def remove_dirty_chars(source: str, dirty: str) -> str:\n    \"\"\"\n    Removes characters from the source string that are present in the dirty string.\n    The order of characters in the source string is preserved.\n    \"\"\"\n    if source is None or dirty is None:\n        raise ValueError(\"source and dirty must not be None\")\n    if not isinstance(source, str) or not isinstance(dirty, str):\n        raise TypeError(\"source and dirty must be str\")\n\n    dirty_set = set(dirty)\n    result_chars = [char for char in source if char not in dirty_set]\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/19", "solution": "from typing import Sequence, List, Any, Optional\nfrom abc import ABC, abstractmethod\n\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception raised for invalid input validation failures.\"\"\"\n    def __init__(self, msg: str):\n        super().__init__(msg)\n\ndef validate_int_sequence(nums: Sequence[Any]) -> List[int]:\n    \"\"\"Validates if the input is a sequence of integers and returns a list.\"\"\"\n    if nums is None:\n        raise InvalidInputError(\"Input cannot be None\")\n    if not isinstance(nums, (list, tuple)):\n        raise InvalidInputError(\"Input must be a list or tuple of integers\")\n    result: List[int] = []\n    for i, v in enumerate(nums):\n        if not isinstance(v, int):\n            raise InvalidInputError(f\"Element at index {i} is not int: {v!r}\")\n        result.append(v)\n    return result\n\nclass IntArrayDTO:\n    \"\"\"Data Transfer Object for an array of integers.\"\"\"\n    def __init__(self, values: List[int]) -> None:\n        self._values: List[int] = list(values) # Stores a defensive copy.\n\n    def to_list(self) -> List[int]:\n        \"\"\"Returns a shallow copy of the internal list.\"\"\"\n        return list(self._values)\n\nDEFAULT_ALGORITHM: str = \"set\"\nSUPPORTED_ALGORITHMS = (\"set\", \"sorted\")\n\nclass DuplicateRepository(ABC):\n    \"\"\"Abstract base class for duplicate detection repositories.\"\"\"\n    @abstractmethod\n    def contains_duplicate(self, nums: List[int]) -> bool:\n        \"\"\"Determines if the list of integers contains any duplicate elements.\"\"\"\n        raise NotImplementedError\n\nclass MemoryDuplicateRepository(DuplicateRepository):\n    \"\"\"In-memory implementation of DuplicateRepository using set or sorting algorithms.\"\"\"\n    def __init__(self, algorithm: str = DEFAULT_ALGORITHM) -> None:\n        if algorithm not in SUPPORTED_ALGORITHMS:\n            raise ValueError(f\"Unsupported algorithm: {algorithm}\")\n        self._algorithm = algorithm\n\n    def contains_duplicate(self, nums: List[int]) -> bool:\n        \"\"\"Checks for duplicates using the configured algorithm.\"\"\"\n        if self._algorithm == \"set\":\n            return self._contains_duplicate_set(nums)\n        return self._contains_duplicate_sorted(nums)\n\n    def _contains_duplicate_set(self, nums: List[int]) -> bool:\n        \"\"\"Implements duplicate checking using a hash set (O(n) expected time/space).\"\"\"\n        seen = set()\n        for n in nums:\n            if n in seen:\n                return True\n            seen.add(n)\n        return False\n\n    def _contains_duplicate_sorted(self, nums: List[int]) -> bool:\n        \"\"\"Implements duplicate checking by sorting (O(n log n) time, O(1) additional space).\"\"\"\n        if not nums:\n            return False\n        arr = list(nums) # Creates a shallow copy to avoid modifying the original list.\n        arr.sort()\n        for i in range(1, len(arr)):\n            if arr[i] == arr[i - 1]:\n                return True\n        return False\n\nclass DuplicateCheckerService:\n    \"\"\"Service layer for checking duplicate elements.\"\"\"\n    def __init__(self, repo: DuplicateRepository, algorithm: Optional[str] = None) -> None:\n        self._repo = repo\n        # The algorithm parameter is for repo configuration, not directly used by the service here.\n        pass\n\n    def has_duplicates(self, nums: List[int]) -> bool:\n        \"\"\"Checks the provided list of integers for duplicates using the configured repository.\"\"\"\n        return self._repo.contains_duplicate(nums)\n\ndef test_duplicate(nums: Sequence[Any]) -> bool:\n    \"\"\"Determines if a given array of integers contains any duplicate element.\"\"\"\n    ints = validate_int_sequence(nums)\n    dto = IntArrayDTO(ints)\n    repo = MemoryDuplicateRepository(algorithm=DEFAULT_ALGORITHM)\n    service = DuplicateCheckerService(repo)\n    return service.has_duplicates(dto.to_list())"}
{"task_id": "Mbpp/57", "solution": "def find_Max_Num(digits):\n    \"\"\"\n    Finds the largest number that can be formed by arranging the given list of digits.\n    The digits are sorted in descending order and then concatenated to form an integer.\n    \"\"\"\n    # Convert all digits to strings to enable proper sorting for concatenation\n    str_digits = [str(d) for d in digits]\n    # Sort the digit-strings in reverse order to form the largest number\n    str_digits.sort(reverse=True)\n    # Join the sorted digit-strings and convert to an integer\n    return int(\"\".join(str_digits))"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(value: int) -> bool:\n    \"\"\"Checks if the given number is a Woodall number.\"\"\"\n    if not isinstance(value, int):\n        raise TypeError(\"value must be an int\")\n    if value <= 0:\n        return False\n\n    n = 1\n    while True:\n        woodall_candidate = n * (1 << n) - 1\n        if woodall_candidate == value:\n            return True\n        if woodall_candidate > value:\n            return False\n        n += 1"}
{"task_id": "Mbpp/56", "solution": "def check(n: int) -> bool:\n    \"\"\"\n    Checks if a number is one less than twice its reverse.\n    Assumes n is a non-negative integer.\n    \"\"\"\n    def _reverse_number(num: int) -> int:\n        \"\"\"Computes the integer reverse of a non-negative number.\"\"\"\n        rev = 0\n        temp_num = num\n        while temp_num > 0:\n            rev = rev * 10 + (temp_num % 10)\n            temp_num //= 10\n        return rev\n\n    reversed_n = _reverse_number(n)\n    return n == (2 * reversed_n - 1)"}
