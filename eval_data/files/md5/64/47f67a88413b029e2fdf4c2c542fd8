{"task_id": "Mbpp/74", "solution": "from typing import List, Dict\n\ndef is_samepatterns(items: List[str], tokens: List[str]) -> bool:\n    \"\"\"\n    Checks if a sequence of items follows a given pattern of tokens.\n    It verifies a consistent and bijective mapping between items and tokens preserving order.\n    \"\"\"\n\n    class PatternMatchError(Exception):\n        \"\"\"Custom exception for unexpected errors during pattern matching.\"\"\"\n        def __init__(self, message: str):\n            super().__init__(message)\n            self.message = message\n\n    def normalize_items(items_list: List[str]) -> List[str]:\n        \"\"\"Strips leading/trailing whitespace from each item in a list and returns a new list.\"\"\"\n        return [item.strip() for item in items_list]\n\n    def _map_and_check(inner_items: List[str], inner_tokens: List[str]) -> bool:\n        \"\"\"\n        Internal function to perform the core mapping and consistency check algorithm.\n        It returns True if a consistent bijective mapping is found, False otherwise.\n        \"\"\"\n        if len(inner_items) != len(inner_tokens):\n            return False\n\n        token_to_item: Dict[str, str] = {}\n        item_to_token: Dict[str, str] = {}\n\n        for item, token in zip(inner_items, inner_tokens):\n            if token in token_to_item:\n                # If the token has been seen before, it must map to the exact same item.\n                if token_to_item[token] != item:\n                    return False\n            else:\n                # If the token is new, the current item must not already be mapped to a different token.\n                if item in item_to_token:\n                    return False\n                token_to_item[token] = item\n                item_to_token[item] = token\n        return True\n\n    norm_items = normalize_items(items)\n    norm_tokens = normalize_items(tokens)\n\n    try:\n        return _map_and_check(norm_items, norm_tokens)\n    except Exception as e:\n        # Catch any unexpected errors from the internal logic and re-raise as a PatternMatchError.\n        raise PatternMatchError(f\"Unexpected error during pattern check: {e}\")"}
