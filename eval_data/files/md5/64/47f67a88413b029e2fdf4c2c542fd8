{"task_id": "Mbpp/125", "solution": "def find_length(s: str) -> int:\n    # Convert '0' to 1 and '1' to -1, then apply Kadane's algorithm to find the maximum subarray sum.\n    # This gives the maximum difference (count(0) - count(1)) for any substring.\n    if not s:\n        raise ValueError(\"Input string must be non-empty.\")\n    for i, ch in enumerate(s):\n        if ch not in (\"0\", \"1\"):\n            raise ValueError(f\"Invalid character '{ch}' at position {i}; input must be a binary string.\")\n\n    values = [1 if char == '0' else -1 for char in s]\n\n    max_so_far = values[0]\n    current_max = values[0]\n\n    for v in values[1:]:\n        current_max = v if current_max + v < v else current_max + v\n        if current_max > max_so_far:\n            max_so_far = current_max\n\n    return max_so_far"}
{"task_id": "Mbpp/128", "solution": "def long_words(n, text):\n    \"\"\"\n    Return a list of words longer than n characters from the given text or list of words.\n\n    - If `text` is a str, it is split on whitespace and each token has surrounding\n      punctuation stripped.\n    - If `text` is a list or tuple, each element must be a str; surrounding punctuation\n      is stripped from each element.\n    - Only tokens with length strictly greater than n are returned, in original order.\n    \"\"\"\n    import string\n\n    # Validate n\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    tokens = []\n\n    if isinstance(text, str):\n        raw_tokens = text.split()\n        for t in raw_tokens:\n            token = t.strip(string.punctuation)\n            if token:\n                tokens.append(token)\n    elif isinstance(text, (list, tuple)):\n        for item in text:\n            if not isinstance(item, str):\n                raise TypeError(\"all elements of the input list/tuple must be strings\")\n            token = item.strip(string.punctuation)\n            if token:\n                tokens.append(token)\n    else:\n        raise TypeError(\"text must be a string or a list/tuple of strings\")\n\n    return [w for w in tokens if len(w) > n]"}
{"task_id": "Mbpp/129", "solution": "import ast\nfrom typing import List, Any, Optional, Tuple\n\nclass InvalidMatrixError(Exception):\n    \"\"\"Exception raised for invalid matrix input.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\nclass Utils:\n    \"\"\"Utility methods for matrix operations.\"\"\"\n    @staticmethod\n    def flatten(matrix_values: List[List[int]]) -> List[int]:\n        \"\"\"Flattens a 2D list into a 1D list.\"\"\"\n        return [v for row in matrix_values for v in row]\n\n    @staticmethod\n    def parse_literal(s: str) -> Any:\n        \"\"\"Safely parses a string literal into a Python object.\"\"\"\n        return ast.literal_eval(s)\n\nclass Matrix:\n    \"\"\"Represents a validated square matrix.\"\"\"\n    def __init__(self, values: List[List[int]]) -> None:\n        self.values = values\n        self.n = len(values)\n\n    def flatten(self) -> List[int]:\n        \"\"\"Returns a flattened list of integers from the matrix.\"\"\"\n        return Utils.flatten(self.values)\n\nclass MagicSquareResult:\n    \"\"\"Holds the result of a magic square validation.\"\"\"\n    def __init__(self, is_magic: bool, target_sum: Optional[int] = None, reason: Optional[str] = None) -> None:\n        self.is_magic = is_magic\n        self.target_sum = target_sum\n        self.reason = reason\n\nclass MatrixParser:\n    \"\"\"Parses raw input into a validated Matrix object.\"\"\"\n    def __init__(self, allow_non_int: bool = False) -> None:\n        self.allow_non_int = allow_non_int\n\n    def _validate_shape(self, values: List[List[Any]]) -> None:\n        \"\"\"Validates that the input is a non-empty square matrix of lists containing integers.\"\"\"\n        if not isinstance(values, list) or not values:\n            raise InvalidMatrixError(\"Input must be a non-empty list of lists.\")\n\n        n = len(values)\n        for i, row in enumerate(values):\n            if not isinstance(row, list):\n                raise InvalidMatrixError(f\"Row {i} is not a list.\")\n            if len(row) != n:\n                raise InvalidMatrixError(f\"Row {i} has length {len(row)}, expected {n}. Matrix must be square.\")\n            for j, val in enumerate(row):\n                if not isinstance(val, int):\n                    raise InvalidMatrixError(f\"Element at [{i}][{j}] is not an integer: {val}.\")\n\n    def parse(self, raw: Any) -> Matrix:\n        \"\"\"Parses raw input (list, string literal) into a Matrix object.\"\"\"\n        if isinstance(raw, str):\n            try:\n                raw = Utils.parse_literal(raw)\n            except (ValueError, SyntaxError) as e:\n                raise InvalidMatrixError(f\"Could not parse input literal: {e}\")\n\n        self._validate_shape(raw)\n\n        return Matrix(raw)\n\nclass MagicSquareValidator:\n    \"\"\"Checks if a given matrix is a magic square.\"\"\"\n    def __init__(self, enforce_consecutive: bool = True) -> None:\n        self.enforce_consecutive = enforce_consecutive\n\n    def _compute_target_sum(self, matrix: Matrix) -> int:\n        \"\"\"Computes the target sum for rows, columns, and diagonals.\"\"\"\n        if matrix.n == 0:\n            return 0\n        return sum(matrix.values[0])\n\n    def _check_rows_and_columns(self, matrix: Matrix, target: int) -> Tuple[bool, Optional[str]]:\n        \"\"\"Checks if all rows and columns sum to the target.\"\"\"\n        n = matrix.n\n        for i in range(n):\n            if sum(matrix.values[i]) != target:\n                return False, f\"Row {i} sum is not {target}.\"\n\n        for j in range(n):\n            col_sum = 0\n            for i in range(n):\n                col_sum += matrix.values[i][j]\n            if col_sum != target:\n                return False, f\"Column {j} sum is not {target}.\"\n\n        return True, None\n\n    def _check_diagonals(self, matrix: Matrix, target: int) -> Tuple[bool, Optional[str]]:\n        \"\"\"Checks if both main and anti-diagonals sum to the target.\"\"\"\n        n = matrix.n\n\n        main_diag_sum = 0\n        anti_diag_sum = 0\n        for i in range(n):\n            main_diag_sum += matrix.values[i][i]\n            anti_diag_sum += matrix.values[i][n - 1 - i]\n\n        if main_diag_sum != target:\n            return False, f\"Main diagonal sum is not {target}.\"\n        if anti_diag_sum != target:\n            return False, f\"Anti-diagonal sum is not {target}.\"\n\n        return True, None\n\n    def _check_consecutive(self, matrix: Matrix) -> Tuple[bool, Optional[str]]:\n        \"\"\"Checks if the matrix contains numbers from 1 to N*N exactly once.\"\"\"\n        n_squared = matrix.n * matrix.n\n        expected_set = set(range(1, n_squared + 1))\n        actual_set = set(matrix.flatten())\n\n        if actual_set != expected_set:\n            return False, f\"Numbers are not a permutation of 1 to {n_squared}.\"\n\n        return True, None\n\n    def validate(self, matrix: Matrix) -> MagicSquareResult:\n        \"\"\"Validates if the given Matrix is a magic square.\"\"\"\n        if matrix.n == 0:\n            return MagicSquareResult(False, reason=\"Matrix size must be N >= 1.\")\n\n        target = self._compute_target_sum(matrix)\n\n        ok, reason = self._check_rows_and_columns(matrix, target)\n        if not ok:\n            return MagicSquareResult(False, target, reason)\n\n        ok, reason = self._check_diagonals(matrix, target)\n        if not ok:\n            return MagicSquareResult(False, target, reason)\n\n        if self.enforce_consecutive:\n            ok, reason = self._check_consecutive(matrix)\n            if not ok:\n                return MagicSquareResult(False, target, reason)\n\n        return MagicSquareResult(True, target, None)\n\ndef magic_square_test(matrix: List[List[int]], enforce_consecutive: bool = True) -> bool:\n    \"\"\"\n    Checks if a given square matrix of integers is a magic square.\n    It verifies sums of rows, columns, and both diagonals, and optionally checks for consecutive numbers.\n    \"\"\"\n    parser = MatrixParser(allow_non_int=False)\n    parsed_matrix = parser.parse(matrix)\n\n    validator = MagicSquareValidator(enforce_consecutive=enforce_consecutive)\n    result = validator.validate(parsed_matrix)\n\n    return result.is_magic"}
