{"task_id": "Mbpp/591", "solution": "def swap_List(lst: list) -> list:\n    \"\"\"\n    Returns a new list with its first and last elements swapped.\n    For lists with less than two elements, a shallow copy is returned unchanged.\n    \"\"\"\n    if len(lst) < 2:\n        return list(lst)  # Return a shallow copy for lists length 0 or 1\n\n    # Create a shallow copy to avoid modifying the original list\n    result_list = list(lst)\n\n    # Swap the first and last elements\n    result_list[0], result_list[-1] = result_list[-1], result_list[0]\n\n    return result_list"}
{"task_id": "Mbpp/589", "solution": "import math\nfrom typing import List\n\ndef perfect_squares(start: int, end: int) -> List[int]:\n    \"\"\"\n    Finds perfect squares within a given inclusive range [start, end].\n\n    Returns a list of integers k*k such that start <= k*k <= end.\n    \"\"\"\n    if start is None or end is None:\n        raise ValueError(\"start and end must be provided\")\n    if not (isinstance(start, (int, float)) and isinstance(end, (int, float))):\n        raise TypeError(\"start and end must be numbers\")\n    if math.isnan(start) or math.isnan(end):\n        raise ValueError(\"start and end must be finite numbers\")\n    if start > end:\n        raise ValueError(\"start must be <= end\")\n\n    # If the entire range is below 0, no non-negative perfect squares exist.\n    if end < 0:\n        return []\n\n    # Coerce boundaries: start -> ceil(start), end -> floor(end)\n    s = math.ceil(start)\n    e = math.floor(end)\n\n    # Ensure we consider non-negative roots only\n    s = max(s, 0)\n\n    start_root = math.ceil(math.sqrt(s)) if s > 0 else 0\n    end_root = math.floor(math.sqrt(e))\n\n    if end_root < start_root:\n        return []\n\n    return [i * i for i in range(int(start_root), int(end_root) + 1)]"}
{"task_id": "Mbpp/592", "solution": "import math\n\ndef sum_Of_product(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the product of consecutive binomial coefficients:\n    S(n) = sum_{k=0}^{n-1} C(n,k) * C(n,k+1) = n/(n+1) * C(2n, n)\n\n    Args:\n        n: non-negative integer\n\n    Returns:\n        Integer result of the sum.\n\n    Raises:\n        ValueError: if n is not an int or is negative.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    if n == 0:\n        return 0\n\n    central_binomial_coefficient = math.comb(2 * n, n)\n    return (central_binomial_coefficient * n) // (n + 1)"}
{"task_id": "Mbpp/593", "solution": "def removezero_ip(ip: str) -> str:\n    \"\"\"\n    Removes leading zeros from each octet of an IPv4 address string.\n    Raises InvalidIPAddressError if the input is not a valid IPv4 address.\n    \"\"\"\n\n    class InvalidIPAddressError(Exception):\n        \"\"\"Custom exception for invalid IPv4 addresses.\"\"\"\n        pass\n\n    IPV4_OCTET_COUNT = 4\n    OCTET_MIN = 0\n    OCTET_MAX = 255\n\n    def _strip_leading_zeros(octet_str: str) -> str:\n        \"\"\"Removes leading zeros from an octet string, e.g., '08' -> '8'.\"\"\"\n        if not octet_str.isdigit():\n            raise InvalidIPAddressError(f\"Invalid octet format: '{octet_str}' contains non-digit characters.\")\n        stripped = octet_str.lstrip('0') or '0'\n        return stripped\n\n    def _normalize_octet(octet_str: str) -> str:\n        \"\"\"Validates octet range and returns its normalized string representation.\"\"\"\n        stripped_octet = _strip_leading_zeros(octet_str)\n        try:\n            num = int(stripped_octet)\n            if not (OCTET_MIN <= num <= OCTET_MAX):\n                raise InvalidIPAddressError(f\"Octet value {num} out of range (0-255).\")\n            return str(num)\n        except ValueError:\n            raise InvalidIPAddressError(f\"Failed to convert octet '{stripped_octet}' to integer.\")\n\n    def _split_octets(ip_str: str) -> list[str]:\n        \"\"\"Splits an IPv4 string into octet parts, validating the count.\"\"\"\n        parts = ip_str.split('.')\n        if len(parts) != IPV4_OCTET_COUNT:\n            raise InvalidIPAddressError(f\"IPv4 address must have {IPV4_OCTET_COUNT} octets, found {len(parts)}.\")\n        return parts\n\n    def _is_valid_ipv4_format(ip_str: str) -> bool:\n        \"\"\"Checks if the IP string has a valid IPv4 format and octet ranges.\"\"\"\n        try:\n            parts = _split_octets(ip_str)\n            for p in parts:\n                # _normalize_octet will raise if format or range is incorrect\n                _ = _normalize_octet(p)\n            return True\n        except InvalidIPAddressError:\n            return False\n\n    # Main normalization logic\n    if not _is_valid_ipv4_format(ip):\n        raise InvalidIPAddressError(f\"Invalid IPv4 address: '{ip}'\")\n\n    # If _is_valid_ipv4_format returned True, then _split_octets is guaranteed to succeed\n    octets = _split_octets(ip)\n\n    normalized_octets = []\n    for octet in octets:\n        # _normalize_octet is guaranteed to succeed for each octet if _is_valid_ipv4_format passed\n        normalized_octets.append(_normalize_octet(octet))\n\n    return '.'.join(normalized_octets)"}
{"task_id": "Mbpp/594", "solution": "def diff_even_odd(nums):\n    \"\"\"\n    Finds the difference of the first even and first odd number in the given list.\n    Assumes the list contains at least one even and one odd number.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for x in nums:\n        if first_odd is None and x % 2 != 0:\n            first_odd = x\n        if first_even is None and x % 2 == 0:\n            first_even = x\n\n        if first_even is not None and first_odd is not None:\n            break\n\n    return first_even - first_odd"}
{"task_id": "Mbpp/590", "solution": "import math\nimport cmath\nfrom typing import Optional, Tuple\n\ndef polar_rect(a: float, b: float, mode: Optional[str]=None, normalize_negative_r: bool=False) -> Tuple[Tuple[float,float], complex]:\n    \"\"\"\n    Converts between polar and rectangular coordinates based on the specified mode.\n    If mode is None, it defaults to rectangular input (x, y).\n    \"\"\"\n    if mode is None or mode == 'rect':\n        x_in, y_in = a, b\n\n        r_out = math.hypot(x_in, y_in)\n        theta_out = math.atan2(y_in, x_in)\n\n        return ((r_out, theta_out), complex(x_in, y_in))\n\n    elif mode == 'polar':\n        r_in, theta_in = a, b\n\n        r_polar_output = r_in\n        theta_polar_output = theta_in\n\n        if normalize_negative_r and r_in < 0:\n            r_calc = abs(r_in)\n            theta_calc_unnormalized = theta_in + math.pi\n\n            theta_calc = cmath.phase(complex(math.cos(theta_calc_unnormalized), math.sin(theta_calc_unnormalized)))\n\n            r_polar_output = r_calc\n            theta_polar_output = theta_calc\n        else:\n            r_calc = r_in\n            theta_calc = theta_in\n\n        x_out = r_calc * math.cos(theta_calc)\n        y_out = r_calc * math.sin(theta_calc)\n\n        return ((r_polar_output, theta_polar_output), complex(x_out, y_out))"}
{"task_id": "Mbpp/596", "solution": "import sys\nfrom typing import Any\n\nclass TupleValidationError(Exception):\n    \"\"\"Custom exception for invalid tuple inputs.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass TupleSizeError(Exception):\n    \"\"\"Custom exception for errors during tuple size calculation.\"\"\"\n    def __init__(self, message: str, cause: Exception = None) -> None:\n        super().__init__(message)\n        self.__cause__ = cause\n\nclass TupleModel:\n    \"\"\"Represents a validated tuple value as a domain object.\"\"\"\n    def __init__(self, elements: tuple) -> None:\n        if not isinstance(elements, tuple):\n            raise TupleValidationError(\"TupleModel must be initialized with a tuple.\")\n        self._elements = elements\n\n    def as_tuple(self) -> tuple:\n        \"\"\"Returns the underlying tuple.\"\"\"\n        return self._elements\n\nclass SysAdapter:\n    \"\"\"Encapsulates the system call to compute object size.\"\"\"\n    def get_size(self, obj: Any) -> int:\n        \"\"\"Calls sys.getsizeof to determine the size of an object.\"\"\"\n        try:\n            return sys.getsizeof(obj)\n        except Exception as e:\n            raise TupleSizeError(\"Failed to get size from system\") from e\n\nclass Validator:\n    \"\"\"Provides utility methods for input validation.\"\"\"\n    def validate_tuple(self, value: Any) -> tuple:\n        \"\"\"Validates if the value is a tuple or list, converting lists to tuples.\"\"\"\n        if isinstance(value, tuple):\n            return value\n        if isinstance(value, list):\n            return tuple(value)\n        raise TupleValidationError(\"Value must be a tuple or list.\")\n\nclass SizeCalculator:\n    \"\"\"Orchestrates input validation and delegates size calculation to an adapter.\"\"\"\n    def __init__(self, sys_adapter: SysAdapter, validator: Validator) -> None:\n        self.sys_adapter = sys_adapter\n        self.validator = validator\n\n    def calculate_size(self, value: Any) -> int:\n        \"\"\"Calculates the size of a given tuple (or list converted to tuple).\"\"\"\n        validated = self.validator.validate_tuple(value)\n        model = TupleModel(validated)\n        try:\n            return self.sys_adapter.get_size(model.as_tuple())\n        except Exception as e:\n            raise TupleSizeError(\"Calculation failed\") from e\n\ndef tuple_size(t: tuple) -> int:\n    \"\"\"Calculates the size in bytes of the given tuple.\"\"\"\n    validator = Validator()\n    sys_adapter = SysAdapter()\n    calculator = SizeCalculator(sys_adapter=sys_adapter, validator=validator)\n    return calculator.calculate_size(t)"}
{"task_id": "Mbpp/597", "solution": "def find_kth(arr1, arr2, k):\n    \"\"\"\n    Finds the k-th smallest element from two sorted arrays using a binary search approach.\n    The k-th element is 1-indexed.\n    \"\"\"\n    m, n = len(arr1), len(arr2)\n\n    # Validate k\n    total = m + n\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an integer\")\n    if k < 1 or k > total:\n        raise ValueError(f\"k must be between 1 and {total}\")\n\n    # Ensure arr1 is the shorter array to optimize binary search range\n    if m > n:\n        arr1, arr2 = arr2, arr1\n        m, n = n, m\n\n    # Define the search space for partition point 'i' in arr1.\n    # 'i' represents the number of elements taken from arr1.\n    # 'j' (k - i) represents the number of elements taken from arr2.\n    # The range for 'i' must ensure 'j' is also valid (0 <= j <= n).\n    low = max(0, k - n)\n    high = min(k, m)\n\n    while low <= high:\n        i = low + (high - low) // 2  # Partition point for arr1\n        j = k - i                     # Partition point for arr2\n\n        # Get elements at the partition boundaries, using -infinity and +infinity for edge cases.\n        max_left_a = arr1[i - 1] if i > 0 else float('-inf')\n        min_right_a = arr1[i] if i < m else float('inf')\n\n        max_left_b = arr2[j - 1] if j > 0 else float('-inf')\n        min_right_b = arr2[j] if j < n else float('inf')\n\n        # Check if the partition is correct (elements are correctly ordered)\n        if max_left_a <= min_right_b and max_left_b <= min_right_a:\n            # The correct partition is found. The k-th element is the maximum of the left halves.\n            return max(max_left_a, max_left_b)\n        elif max_left_a > min_right_b:\n            # 'i' is too large; too many elements were taken from arr1.\n            high = i - 1\n        else:\n            # 'i' is too small; too few elements were taken from arr1.\n            low = i + 1\n\n    # If the loop exits without returning, inputs were invalid in some unexpected way.\n    raise ValueError(\"Unable to find k-th element with given input arrays.\")"}
{"task_id": "Mbpp/598", "solution": "def armstrong_number(n: int) -> bool:\n    \"\"\"Checks if a given number is an Armstrong number.\n    An Armstrong number is equal to the sum of its digits each raised to the power\n    of the number of digits, e.g., 153 -> 1^3 + 5^3 + 3^3 == 153.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input must be an integer\")\n    if n < 0:\n        return False\n    s_num = str(n)\n    num_digits = len(s_num)\n    total_sum = 0\n    for digit_char in s_num:\n        digit = int(digit_char)\n        total_sum += digit ** num_digits\n    return total_sum == n"}
{"task_id": "Mbpp/604", "solution": "def reverse_words(s: str) -> str:\n    \"\"\"\n    Reverses the order of words in a string, normalizing spaces.\n    Multiple spaces and leading/trailing spaces are collapsed to single spaces.\n    \"\"\"\n    # Normalize whitespace: split by any whitespace, then join with a single space.\n    # This collapses multiple spaces and removes leading/trailing spaces.\n    normalized_text = \" \".join(s.split())\n\n    # If the string becomes empty after normalization (e.g., input was \"\", \"   \"),\n    # return an empty string immediately.\n    if not normalized_text:\n        return \"\"\n\n    # Split the normalized text into words using a single space as the delimiter.\n    words = normalized_text.split(\" \")\n\n    # Reverse the list of words.\n    reversed_words = words[::-1]\n\n    # Join the reversed words back into a string with single spaces.\n    return \" \".join(reversed_words)"}
