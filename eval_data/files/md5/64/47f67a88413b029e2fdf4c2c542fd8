{"task_id": "Mbpp/608", "solution": "def bell_Number(n):\n    \"\"\"\n    Computes the nth Bell number using the Bell triangle dynamic programming method.\n\n    Bell numbers:\n      B0 = 1, B1 = 1, B2 = 2, ...\n\n    Args:\n        n (int): non-negative integer index of the Bell number to compute.\n\n    Returns:\n        int: the nth Bell number.\n\n    Raises:\n        ValueError: if n is not an int or is negative.\n    \"\"\"\n    if not isinstance(n, int) or isinstance(n, bool) or n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n\n    if n == 0:\n        return 1\n\n    # Initialize the first row of the Bell triangle (row 0)\n    bell = [1]\n\n    # Build rows 1..n\n    for i in range(1, n + 1):\n        # First element of the new row is the last element of the previous row\n        new_row = [bell[-1]]\n        for j in range(1, i + 1):\n            new_row.append(new_row[j - 1] + bell[j - 1])\n        bell = new_row\n\n    return bell[0]"}
{"task_id": "Mbpp/605", "solution": "def prime_num(n: int) -> bool:\n    \"\"\"\n    Checks if an integer is a prime number using trial division up to its square root.\n    Handles special cases for 0, 1, 2, and 3 efficiently.\n    \"\"\"\n    import math\n\n    # Handle cases for numbers less than or equal to 1, which are not prime.\n    if n <= 1:\n        return False\n    # Handle cases for 2 and 3, which are prime.\n    if n <= 3:\n        return True\n    # If the number is even and greater than 2, it's not prime.\n    if n % 2 == 0:\n        return False\n\n    # Check for factors from 3 up to the square root of n, incrementing by 2 (only odd numbers).\n    r = math.isqrt(n)\n    i = 3\n    while i <= r:\n        if n % i == 0:\n            return False\n        i += 2\n    return True"}
{"task_id": "Mbpp/607", "solution": "import re\n\ndef find_literals(text, pattern):\n    \"\"\"\n    Searches a string for a regex pattern and returns the matched substring, start index, and end index.\n    \"\"\"\n    m = re.search(pattern, text)\n    return (m.group(0), m.start(), m.end())"}
{"task_id": "Mbpp/611", "solution": "from typing import List, Union, Any\n\nNumber = Union[int, float]\n\nclass MatrixError(Exception):\n    \"\"\"Base exception for matrix operations.\"\"\"\n    pass\n\nclass EmptyMatrixError(MatrixError):\n    \"\"\"Raised when an operation is performed on an empty matrix.\"\"\"\n    pass\n\nclass MatrixTypeError(MatrixError):\n    \"\"\"Raised when the matrix input is not a list of lists.\"\"\"\n    pass\n\nclass RowTypeError(MatrixError):\n    \"\"\"Raised when a row in the matrix is not a list-like object.\"\"\"\n    pass\n\nclass ColumnIndexError(MatrixError):\n    \"\"\"Raised when the column index is out of bounds or invalid.\"\"\"\n    pass\n\nclass NonNumericElementError(MatrixError):\n    \"\"\"Raised when a non-numeric element is found in the target column.\"\"\"\n    def __init__(self, message: str, rows: list[int] = None):\n        super().__init__(message)\n        self.rows = rows or []\n\ndef is_numeric(value: Any) -> bool:\n    \"\"\"Checks if a value is an int or float, excluding booleans.\"\"\"\n    return isinstance(value, (int, float)) and not isinstance(value, bool)\n\nclass Matrix:\n    \"\"\"Represents a matrix as a list of lists.\"\"\"\n    def __init__(self, rows: List[List[Number]]) -> None:\n        self.rows: List[List[Number]] = rows\n\n    def row_count(self) -> int:\n        \"\"\"Returns the number of rows in the matrix.\"\"\"\n        return len(self.rows)\n\n    def min_row_length(self) -> int:\n        \"\"\"Returns the minimum length among all rows, or 0 if no rows.\"\"\"\n        return min((len(r) for r in self.rows), default=0)\n\n    def get_cell(self, row_idx: int, col_idx: int) -> Number:\n        \"\"\"Returns the value at the specified cell.\"\"\"\n        return self.rows[row_idx][col_idx]\n\nclass MatrixValidator:\n    \"\"\"Validates the structure, indices, and elements of a matrix.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def validate_matrix_structure(self, rows: Any) -> None:\n        \"\"\"Ensures the input is a list of lists and not empty.\"\"\"\n        if not isinstance(rows, list):\n            raise MatrixTypeError(\"Matrix must be a list.\")\n        if not rows:\n            raise EmptyMatrixError(\"Matrix cannot be empty.\")\n        for i, row in enumerate(rows):\n            if not isinstance(row, list):\n                raise RowTypeError(f\"Row {i} must be a list, got {type(row).__name__}.\")\n\n    def validate_column_index(self, matrix: Matrix, n: int) -> None:\n        \"\"\"Validates the column index n against matrix dimensions.\"\"\"\n        if not isinstance(n, int):\n            raise ColumnIndexError(\"Column index 'n' must be an integer.\")\n        if n < 0:\n            raise ColumnIndexError(f\"Column index 'n' cannot be negative, got {n}.\")\n        # row_count == 0 is already handled by EmptyMatrixError from validate_matrix_structure\n        if n >= matrix.min_row_length():\n            raise ColumnIndexError(f\"Column index {n} is out of bounds for matrix with min row length {matrix.min_row_length()}.\")\n\n    def validate_column_values_are_numeric(self, matrix: Matrix, n: int) -> None:\n        \"\"\"Checks if all values in the specified column are numeric.\"\"\"\n        non_numeric_rows = []\n        for i in range(matrix.row_count()):\n            # get_cell might raise IndexError if min_row_length was not sufficiently strict,\n            # but validate_column_index should have prevented this.\n            cell_value = matrix.get_cell(i, n)\n            if not is_numeric(cell_value):\n                non_numeric_rows.append(i)\n        if non_numeric_rows:\n            raise NonNumericElementError(\n                f\"Non-numeric elements found in column {n} at rows: {non_numeric_rows}.\",\n                rows=non_numeric_rows\n            )\n\nclass ColumnMaxService:\n    \"\"\"Provides methods to compute column-wise statistics.\"\"\"\n    def __init__(self, validator: MatrixValidator) -> None:\n        self._validator = validator # Retains validator for potential future use or consistency.\n\n    def compute_max_column(self, matrix: Matrix, n: int) -> Number:\n        \"\"\"Computes the maximum value in the specified column.\"\"\"\n        current_max = matrix.get_cell(0, n)\n        for i in range(1, matrix.row_count()):\n            val = matrix.get_cell(i, n)\n            if val > current_max:\n                current_max = val\n        return current_max\n\ndef max_of_nth(rows: List[List[Number]], n: int) -> Number:\n    \"\"\"\n    Computes the maximum value in the n-th column of a matrix.\n    Performs comprehensive validation before computation.\n    \"\"\"\n    validator = MatrixValidator()\n    validator.validate_matrix_structure(rows)\n    matrix = Matrix(rows)\n    validator.validate_column_index(matrix, n)\n    validator.validate_column_values_are_numeric(matrix, n)\n    service = ColumnMaxService(validator)\n    return service.compute_max_column(matrix, n)"}
{"task_id": "Mbpp/610", "solution": "def remove_kth_element(lst, k):\n    \"\"\"Removes the k'th element from a list and returns a new list.\n    The index k is 1-based, meaning k=1 removes the first element.\n    \"\"\"\n\n    class InvalidIndexError(Exception):\n        \"\"\"Custom exception for invalid index values.\"\"\"\n        pass\n\n    if not isinstance(lst, list):\n        raise TypeError(\"lst must be a list\")\n\n    length = len(lst)\n\n    if not isinstance(k, int):\n        raise InvalidIndexError(\"k must be an integer\")\n    if k <= 0 or k > length:\n        raise InvalidIndexError(f\"k out of range (1..{length}): {k}\")\n\n    # Convert 1-based index k to 0-based index for Python lists\n    idx = k - 1\n\n    # Return a new list with the element at 'idx' removed using slicing\n    return lst[:idx] + lst[idx+1:]"}
{"task_id": "Mbpp/614", "solution": "def cummulative_sum(tuple_list):\n    \"\"\"\n    Calculates the cumulative sum of all numeric values within a list of tuples.\n    \"\"\"\n    total = 0.0\n    for tpl in tuple_list:\n        for item in tpl:\n            total += item\n    return total"}
{"task_id": "Mbpp/612", "solution": "def merge(list_of_lists):\n    \"\"\"\n    Transforms a list of 2-element sublists into two lists.\n    The first returned list contains the first element of each sublist, and the second contains the second.\n    \"\"\"\n    first_elements = []\n    second_elements = []\n    for sublist in list_of_lists:\n        first_elements.append(sublist[0])\n        second_elements.append(sublist[1])\n    return [first_elements, second_elements]"}
{"task_id": "Mbpp/615", "solution": "def average_tuple(data: tuple) -> list:\n    \"\"\"\n    Calculates the average value for each inner tuple in a tuple of tuples.\n    Returns 0.0 for empty inner tuples.\n    \"\"\"\n    results = []\n    for inner_tuple in data:\n        if len(inner_tuple) == 0:\n            results.append(0.0)\n        else:\n            results.append(sum(inner_tuple) / len(inner_tuple))\n    return results"}
{"task_id": "Mbpp/616", "solution": "def tuple_modulo(tuple_a, tuple_b):\n    \"\"\"Performs element-wise modulo of two tuples.\n    Assumes inputs are tuples of the same length with integer elements.\"\"\"\n    return tuple(a % b for a, b in zip(tuple_a, tuple_b))"}
{"task_id": "Mbpp/619", "solution": "def move_num(s: str) -> str:\n    \"\"\"Moves all contiguous number groups to the end of the string, preserving order.\"\"\"\n\n    _DIGITS = set('0123456789')\n\n    def _is_digit_char(ch: str) -> bool:\n        \"\"\"Checks if a character is an ASCII digit.\"\"\"\n        return ch in _DIGITS\n\n    def _split_into_runs(input_string: str) -> tuple[str, list[str]]:\n        \"\"\"Splits the string into a concatenated non-digit part and a list of digit groups.\"\"\"\n        non_digits_chars = []\n        digit_groups = []\n        current_digit_buffer = []\n\n        for char in input_string:\n            if _is_digit_char(char):\n                current_digit_buffer.append(char)\n            else:\n                if current_digit_buffer:\n                    digit_groups.append(''.join(current_digit_buffer))\n                    current_digit_buffer = []\n                non_digits_chars.append(char)\n\n        if current_digit_buffer:\n            digit_groups.append(''.join(current_digit_buffer))\n\n        return ''.join(non_digits_chars), digit_groups\n\n    non_digits_part, numbers_list = _split_into_runs(s)\n    numbers_part = ''.join(numbers_list)\n    return non_digits_part + numbers_part"}
{"task_id": "Mbpp/618", "solution": "def div_list(a, b):\n    \"\"\"\n    Divide two sequences element-wise and return a list of floats.\n\n    Args:\n        a: Sequence of numbers (or strings convertible to float).\n        b: Sequence of numbers (or strings convertible to float).\n\n    Returns:\n        List[float]: element-wise division results.\n\n    Raises:\n        TypeError: if inputs are not sequence-like (no __len__).\n        ValueError: if lengths differ or an element is non-numeric.\n        ZeroDivisionError: if any divisor is zero.\n    \"\"\"\n    if not hasattr(a, \"__len__\") or not hasattr(b, \"__len__\"):\n        raise TypeError(\"Both arguments must be sequences with a length (e.g., list or tuple).\")\n    if len(a) != len(b):\n        raise ValueError(\"Input lists must have the same length.\")\n\n    result = []\n    for i, (x, y) in enumerate(zip(a, b)):\n        try:\n            xf = float(x)\n        except (TypeError, ValueError):\n            raise ValueError(f\"Non-numeric value in first list at index {i}: {x!r}\")\n        try:\n            yf = float(y)\n        except (TypeError, ValueError):\n            raise ValueError(f\"Non-numeric value in second list at index {i}: {y!r}\")\n        if yf == 0.0:\n            raise ZeroDivisionError(f\"Division by zero at index {i}\")\n        result.append(xf / yf)\n\n    return result"}
