{"task_id": "Mbpp/422", "solution": "def find_Average_Of_Cube(n):\n    \"\"\"\n    Calculates the average of the cubes of the first n natural numbers.\n    Uses the closed-form formula for the sum of cubes: (n * (n + 1) / 2)^2.\n    \"\"\"\n    # Input validation\n    if not isinstance(n, int) or isinstance(n, bool):\n        raise TypeError(\"n must be an integer\")\n    if n < 1:\n        raise ValueError(\"n must be a positive integer (>= 1)\")\n\n    # Calculate the sum of cubes using the formula (n * (n + 1) / 2)^2\n    sum_of_cubes = (n * (n + 1) // 2) ** 2\n    # Calculate the average by dividing the sum by n\n    average = sum_of_cubes / n\n    return float(average)"}
{"task_id": "Mbpp/425", "solution": "def count_element_in_list(sublists, element):\n    \"\"\"\n    Count how many sublists contain the specified element.\n    Each sublist is counted at most once, even if the element appears multiple times within it.\n\n    Raises:\n        TypeError: if `sublists` is not a list/tuple or if any sublist is not a list/tuple.\n    \"\"\"\n    if not isinstance(sublists, (list, tuple)):\n        raise TypeError(\"sublists must be a list or tuple of sublists\")\n    count = 0\n    for i, sub in enumerate(sublists):\n        if not isinstance(sub, (list, tuple)):\n            raise TypeError(f\"sublists[{i}] must be a list or tuple\")\n        if element in sub:\n            count += 1\n    return count"}
{"task_id": "Mbpp/426", "solution": "def filter_oddnumbers(nums: list) -> list:\n    \"\"\"\n    Filters a list of numbers, returning only the odd numbers.\n    The order of the odd numbers is preserved from the input list.\n    \"\"\"\n    return [n for n in nums if (n % 2) != 0]"}
{"task_id": "Mbpp/427", "solution": "from dataclasses import dataclass\nimport re\nfrom datetime import date as _datetime_date\n\nclass DateFormatError(Exception):\n    \"\"\"Custom exception for date formatting and validation errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\n@dataclass(frozen=True)\nclass DateModel:\n    \"\"\"Represents a validated date value.\"\"\"\n    year: int\n    month: int\n    day: int\n\n    @staticmethod\n    def from_ymd(year: int, month: int, day: int) -> \"DateModel\":\n        \"\"\"Constructs a DateModel instance from year, month, and day integers.\"\"\"\n        return DateModel(year=year, month=month, day=day)\n\n    def to_dd_mm_yyyy(self) -> str:\n        \"\"\"Returns the date formatted as 'dd-mm-yyyy'.\"\"\"\n        return f\"{self.day:02d}-{self.month:02d}-{self.year:04d}\"\n\n    def __repr__(self) -> str:\n        return f\"DateModel(year={self.year}, month={self.month}, day={self.day})\"\n\nDATE_REGEX = r\"^\\d{4}-\\d{2}-\\d{2}$\"\n\nclass DateValidator:\n    \"\"\"Provides methods for validating date string format and semantic correctness.\"\"\"\n    @staticmethod\n    def validate_format(date_str: str) -> None:\n        \"\"\"Ensures the string matches the YYYY-MM-DD format.\"\"\"\n        if not re.match(DATE_REGEX, date_str):\n            raise DateFormatError(\"Invalid format: expected YYYY-MM-DD\")\n\n    @staticmethod\n    def validate_semantic(year: int, month: int, day: int) -> None:\n        \"\"\"Validates if the given year, month, day constitute a real calendar date.\"\"\"\n        try:\n            _datetime_date(year, month, day)\n        except Exception:\n            raise DateFormatError(\"Invalid date: not a real calendar date\")\n\nclass DateFormatterService:\n    \"\"\"Encapsulates the core logic for parsing and formatting date strings.\"\"\"\n    def parse(self, date_str: str) -> DateModel:\n        \"\"\"Validates, parses, and creates a DateModel from a YYYY-MM-DD string.\"\"\"\n        DateValidator.validate_format(date_str)\n        y_str, m_str, d_str = date_str.split(\"-\")\n        y, m, d = int(y_str), int(m_str), int(d_str)\n        DateValidator.validate_semantic(y, m, d)\n        return DateModel.from_ymd(y, m, d)\n\n    def format(self, date_model: DateModel) -> str:\n        \"\"\"Formats a DateModel into a DD-MM-YYYY string.\"\"\"\n        return date_model.to_dd_mm_yyyy()\n\n    def convert(self, date_str: str) -> str:\n        \"\"\"Converts a YYYY-MM-DD date string to DD-MM-YYYY format.\"\"\"\n        dm = self.parse(date_str)\n        return self.format(dm)\n\nclass FormatterController:\n    \"\"\"Public API controller for date format conversion.\"\"\"\n    def change_date_format(self, date_str: str) -> str:\n        \"\"\"Converts a date string from YYYY-MM-DD to DD-MM-YYYY format.\"\"\"\n        service = DateFormatterService()\n        return service.convert(date_str)\n\ndef change_date_format(date_str: str) -> str:\n    \"\"\"Converts a date string from YYYY-MM-DD format to DD-MM-YYYY format.\"\"\"\n    return FormatterController().change_date_format(date_str)"}
