{"task_id": "Mbpp/743", "solution": "def rotate_right(lst, n):\n    \"\"\"\n    Rotates a list to the right by a specified number of items, returning a new list.\n    Handles negative rotation counts as left rotations and returns a new list.\n    \"\"\"\n    length = len(lst)\n    if length == 0:\n        return []\n\n    # Normalize n to an effective rotation count within [0, length-1]\n    # A negative n results in an equivalent positive right rotation:\n    # e.g., for length=10, -3 is equivalent to 7 right rotations. -3 % 10 = 7.\n    normalized_n = n % length\n\n    if normalized_n == 0:\n        # If normalized_n is 0, no rotation is needed; return a shallow copy\n        return lst.copy()\n\n    # Perform the rotation using slicing\n    return lst[-normalized_n:] + lst[:-normalized_n]"}
{"task_id": "Mbpp/745", "solution": "def divisible_by_digits(startnum, endnum):\n    # Normalize the range to ensure low <= high.\n    low, high = startnum, endnum\n    if low > high:\n        low, high = high, low\n\n    result = []\n    for n in range(low, high + 1):\n        # Extract non-zero digits from the absolute value of n.\n        current_num_str = str(abs(n))\n        digits_to_check = []\n        for char_digit in current_num_str:\n            digit = int(char_digit)\n            if digit != 0:\n                digits_to_check.append(digit)\n\n        # A number is valid if it has no non-zero digits (vacuously true, e.g., for 0),\n        # or if it's divisible by every non-zero digit it contains.\n        is_valid = True\n        if digits_to_check:\n            for d in digits_to_check:\n                # Python's modulo operator handles negative numbers correctly.\n                if n % d != 0:\n                    is_valid = False\n                    break\n\n        if is_valid:\n            result.append(n)\n\n    return result"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(arr):\n    \"\"\"Checks if the given array represents a min heap.\"\"\"\n    n = len(arr)\n    # Iterate through parent nodes only (up to n // 2 - 1)\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child\n        if left_child_idx < n and arr[i] > arr[left_child_idx]:\n            return False\n\n        # Check right child\n        if right_child_idx < n and arr[i] > arr[right_child_idx]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/750", "solution": "from typing import Any, List, Tuple, Optional\nimport datetime\nimport json\n\nclass InvalidInputError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass AddServiceError(Exception):\n    def __init__(self, message: str, inner: Optional[Exception] = None) -> None:\n        super().__init__(message)\n        self.inner = inner\n\nclass ListModel:\n    def __init__(self, items: List[Any]) -> None:\n        self._items = list(items)\n\n    def to_list(self) -> List[Any]:\n        return list(self._items)\n\nclass TupleModel:\n    def __init__(self, items: Tuple[Any, ...]) -> None:\n        self._items = items\n\n    def to_tuple(self) -> Tuple[Any, ...]:\n        return self._items\n\nclass Validator:\n    def is_list(self, obj: Any) -> bool:\n        return isinstance(obj, list)\n\n    def is_tuple(self, obj: Any) -> bool:\n        return isinstance(obj, tuple)\n\n    def validate_inputs(self, list_obj: Any, tuple_obj: Any) -> None:\n        if not self.is_list(list_obj):\n            raise InvalidInputError(f\"Expected list for first argument, got {type(list_obj).__name__}\")\n        if not self.is_tuple(tuple_obj):\n            raise InvalidInputError(f\"Expected tuple for second argument, got {type(tuple_obj).__name__}\")\n\nDEFAULT_EXPORT_PATH = \"addtuple_repo_export.json\"\n\nclass InMemoryRepository:\n    def __init__(self) -> None:\n        self._last_operation: Optional[dict] = None\n\n    def save(self, operation: dict) -> None:\n        self._last_operation = dict(operation)\n\n    def get_last(self) -> Optional[dict]:\n        return dict(self._last_operation) if self._last_operation is not None else None\n\n    def export_json(self, path: str = DEFAULT_EXPORT_PATH) -> None:\n        with open(path, \"w\", encoding=\"utf-8\") as f:\n            json.dump(self._last_operation, f)\n\n    def import_json(self, path: str = DEFAULT_EXPORT_PATH) -> None:\n        with open(path, \"r\", encoding=\"utf-8\") as f:\n            self._last_operation = json.load(f)\n\nclass AddService:\n    def __init__(self, repo: Optional[InMemoryRepository] = None) -> None:\n        self.repo = repo or InMemoryRepository()\n\n    def combine(self, list_model: ListModel, tuple_model: TupleModel) -> List[Any]:\n        try:\n            result = list_model.to_list() + list(tuple_model.to_tuple())\n            op = {\n                \"timestamp\": datetime.datetime.utcnow().isoformat(),\n                \"input_list\": list_model.to_list(),\n                \"input_tuple\": list(tuple_model.to_tuple()),\n                \"result\": result\n            }\n            self.repo.save(op)\n            return result\n        except Exception as e:\n            raise AddServiceError(\"Failed to combine list and tuple\", inner=e)\n\nclass AddController:\n    def __init__(self, service: Optional[AddService] = None, validator: Optional[Validator] = None) -> None:\n        self.validator = validator or Validator()\n        self.service = service or AddService()\n\n    def handle_add(self, list_obj: List[Any], tuple_obj: Tuple[Any, ...]) -> List[Any]:\n        self.validator.validate_inputs(list_obj, tuple_obj)\n        lm = ListModel(list_obj)\n        tm = TupleModel(tuple_obj)\n        return self.service.combine(lm, tm)\n\nclass AddTupleAPI:\n    def add_tuple(self, list_obj: List[Any], tuple_obj: Tuple[Any, ...]) -> List[Any]:\n        controller = self._build_controller()\n        return controller.handle_add(list_obj, tuple_obj)\n\n    def _build_controller(self) -> AddController:\n        return AddController()\n\ndef add_tuple(list_obj: List[Any], tuple_obj: Tuple[Any, ...]) -> List[Any]:\n    \"\"\"Adds all elements of a tuple to a list and returns the resulting list.\n    This function acts as a facade to the underlying application logic.\n    \"\"\"\n    return AddTupleAPI().add_tuple(list_obj, tuple_obj)"}
{"task_id": "Mbpp/749", "solution": "def sort_numeric_strings(values: list[str], allow_float: bool = True) -> list[float | int]:\n    \"\"\"Sorts a list of numeric strings numerically, preferring integers when possible.\n    Invalid numeric strings are silently skipped.\n    \"\"\"\n\n    parsed_numbers = []\n\n    for token_str in values:\n        s = token_str.strip()\n\n        parsed_value = None\n        try:\n            # Attempt integer conversion first to prefer integers.\n            parsed_value = int(s)\n        except ValueError:\n            # If not a pure integer, and floats are allowed, try float conversion.\n            if allow_float:\n                try:\n                    parsed_value = float(s)\n                except ValueError:\n                    # If float conversion also fails, the token is not a valid number; skip it.\n                    pass\n\n        if parsed_value is not None:\n            parsed_numbers.append(parsed_value)\n\n    return sorted(parsed_numbers)"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"Return the nth Jacobsthal number (0-based indexing).\n\n    Sequence: J(0)=0, J(1)=1, J(n)=J(n-1) + 2*J(n-2)\n    \"\"\"\n    # Accept values that can be losslessly converted to int (e.g., numeric strings)\n    if not isinstance(n, int):\n        try:\n            n = int(n)\n        except Exception:\n            raise TypeError(\"n must be an integer\")\n\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n\n    a, b = 0, 1  # J(0), J(1)\n    for _ in range(2, n + 1):\n        a, b = b, b + 2 * a\n    return b"}
{"task_id": "Mbpp/748", "solution": "def capital_words_spaces(text: str) -> str:\n    \"\"\"\n    Inserts spaces between words in a string where a new word starts with a capital letter,\n    a digit, or a specific acronym pattern.\n    \"\"\"\n    if not text:\n        return \"\"\n\n    result_chars = [text[0]]\n\n    for i in range(1, len(text)):\n        prev_char = text[i - 1]\n        current_char = text[i]\n\n        add_space = False\n\n        # Rule 1: Lowercase followed by an uppercase letter (e.g., \"helloWorld\" -> \"hello World\")\n        # Rule 2: Digit followed by an uppercase letter (e.g., \"Version2Beta\" -> \"Version2 Beta\")\n        if (prev_char.islower() or prev_char.isdigit()) and current_char.isupper():\n            add_space = True\n        # Rule 3: Lowercase followed by a digit (e.g., \"Version2Beta\" -> \"Version 2Beta\")\n        elif prev_char.islower() and current_char.isdigit():\n            add_space = True\n        # Rule 4: Acronym handling for cases like \"HTTPServer\" -> \"HTTP Server\"\n        # This applies when there's a sequence like UUU_L (e.g., P S e in HTTPServer).\n        # We want to split before the second 'U' if it's followed by a lowercase, AND\n        # it's preceded by at least two uppercase letters (meaning it's not \"A Bc\").\n        elif prev_char.isupper() and current_char.isupper():\n            if i + 1 < len(text) and text[i+1].islower():\n                # Check if there's an uppercase letter two positions back, ensuring a sequence like X_Y_Z where X, Y, Z are uppercase\n                if i - 2 >= 0 and text[i-2].isupper():\n                    add_space = True\n\n        if add_space:\n            result_chars.append(' ')\n        result_chars.append(current_char)\n\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/753", "solution": "import heapq\nfrom dataclasses import dataclass\nfrom typing import List, Tuple, Any\n\nclass MinKError(Exception):\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass InvalidInputError(MinKError):\n    pass\n\nclass AlgorithmError(MinKError):\n    pass\n\n@dataclass(frozen=True)\nclass Record:\n    name: str\n    value: float\n\n    def to_tuple(self) -> Tuple[str, float]:\n        return (self.name, self.value)\n\nclass InputValidator:\n    @staticmethod\n    def validate_k(k: Any) -> int:\n        try:\n            k_int = int(k)\n        except Exception:\n            raise InvalidInputError(\"k must be convertible to int\")\n        if k_int < 0:\n            raise InvalidInputError(\"k must be >= 0\")\n        return k_int\n\n    @staticmethod\n    def validate_records(records: Any) -> List[Record]:\n        if isinstance(records, list) and all(isinstance(r, Record) for r in records):\n            return records\n        if isinstance(records, list) and all(isinstance(r, (list, tuple)) and len(r) == 2 for r in records):\n            out = []\n            for name, value in records:\n                if not isinstance(name, str):\n                    raise InvalidInputError(\"Record name must be str\")\n                try:\n                    val = float(value)\n                except Exception:\n                    raise InvalidInputError(\"Record value must be numeric\")\n                out.append(Record(name, val))\n            return out\n        raise InvalidInputError(\"Unsupported records format\")\n\nclass MinKRepository:\n    def select_min_k(self, records: List[Record], k: int) -> List[Record]:\n        raise NotImplementedError\n\nclass InMemoryMinKRepository(MinKRepository):\n    HEAP_THRESHOLD = 1000\n\n    def select_min_k(self, records: List[Record], k: int) -> List[Record]:\n        \"\"\"Selects the minimum k records from a list of Record objects.\"\"\"\n        if k == 0:\n            return []\n        n = len(records)\n        if k >= n:\n            return sorted(records, key=lambda r: r.value)\n        return self._heap_select(records, k)\n\n    def _heap_select(self, records: List[Record], k: int) -> List[Record]:\n        \"\"\"Uses a max-heap to find the k smallest records, ensuring stability for ties.\"\"\"\n        heap = [] # Max-heap stores (-value, original_index, record_object).\n        for i, rec in enumerate(records):\n            if len(heap) < k:\n                heapq.heappush(heap, (-rec.value, i, rec))\n            else:\n                if rec.value < -heap[0][0]:\n                    heapq.heapreplace(heap, (-rec.value, i, rec))\n                elif rec.value == -heap[0][0] and i < heap[0][1]:\n                    heapq.heapreplace(heap, (-rec.value, i, rec))\n\n        result = [t[2] for t in heap]\n        return sorted(result, key=lambda r: r.value)\n\nclass MinKService:\n    def __init__(self, repo: MinKRepository):\n        self._repo = repo\n\n    def find_min_k(self, records: List[Tuple[str,float] | Record], k: int) -> List[Tuple[str,float]]:\n        \"\"\"Finds the k smallest records from a list, validating inputs and using the repository.\"\"\"\n        k_int = InputValidator.validate_k(k)\n        record_objs = InputValidator.validate_records(records)\n        selected = self._repo.select_min_k(record_objs, k_int)\n        return [r.to_tuple() for r in selected]\n\nclass MinKController:\n    def __init__(self, service: MinKService):\n        self._service = service\n\n    def handle_min_k(self, records: List[Tuple[str,float] | Record], k: int) -> List[Tuple[str,float]]:\n        \"\"\"Handles the request to find k minimum records by delegating to the service.\"\"\"\n        return self._service.find_min_k(records, k)\n\n_default_controller = MinKController(MinKService(InMemoryMinKRepository()))\n\ndef min_k(records, k):\n    \"\"\"\n    Finds the minimum k records from a list of (name, value) tuples.\n    Results are sorted by value, with stability for equal values.\n    \"\"\"\n    return _default_controller.handle_min_k(records, k)"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1, l2, l3):\n    \"\"\"\n    Finds elements that appear in all three lists under the same index.\n    \"\"\"\n    if not (hasattr(l1, \"__len__\") and hasattr(l1, \"__getitem__\") and\n            hasattr(l2, \"__len__\") and hasattr(l2, \"__getitem__\") and\n            hasattr(l3, \"__len__\") and hasattr(l3, \"__getitem__\")):\n        raise TypeError(\"All inputs must be indexable (support len() and __getitem__).\")\n    if not (len(l1) == len(l2) == len(l3)):\n        raise ValueError(\"All lists must have the same length.\")\n    common_elements = []\n    for i in range(len(l1)):\n        if l1[i] == l2[i] == l3[i]:\n            common_elements.append(l1[i])\n    return common_elements"}
{"task_id": "Mbpp/759", "solution": "import re\nfrom typing import Any\n\nDEFAULT_PATTERN = r'^[+-]?\\d+\\.\\d{2}$'\n\nclass RegexProvider:\n    \"\"\"Provides the compiled regex pattern for decimal validation.\"\"\"\n    def __init__(self, pattern_str: str = DEFAULT_PATTERN) -> None:\n        self._pattern_str = pattern_str\n        self._compiled = re.compile(self._pattern_str)\n\n    def get_pattern(self) -> \"re.Pattern\":\n        \"\"\"Returns the compiled regex pattern.\"\"\"\n        return self._compiled\n\n    def get_pattern_str(self) -> str:\n        \"\"\"Returns the raw regex pattern string.\"\"\"\n        return self._pattern_str\n\nclass DecimalValidator:\n    \"\"\"Encapsulates the core logic for decimal string validation.\"\"\"\n    def __init__(self, regex_provider: RegexProvider = None) -> None:\n        self._regex_provider = regex_provider or RegexProvider()\n\n    def is_decimal(self, s: str) -> bool:\n        \"\"\"Checks if a string represents a decimal with exactly two fractional digits.\"\"\"\n        self._validate_type(s)\n        pattern = self._regex_provider.get_pattern()\n        return bool(pattern.match(s))\n\n    def _validate_type(self, s: Any) -> None:\n        \"\"\"Ensures the input `s` is a string, raising TypeError if not.\"\"\"\n        if not isinstance(s, str):\n            raise TypeError(\"s must be a str\")\n\ndef is_decimal(s: str) -> bool:\n    \"\"\"\n    Determines if the given string represents a decimal number\n    with exactly two digits after the decimal point.\n    \"\"\"\n    validator = DecimalValidator()\n    return validator.is_decimal(s)"}
{"task_id": "Mbpp/757", "solution": "import collections\n\ndef count_reverse_pairs(strings: list[str]) -> int:\n    \"\"\"\n    Counts the number of unordered pairs of reverse strings in the given list.\n    Palindromic strings count as n*(n-1)//2 pairs if n occurrences are present.\n    \"\"\"\n    freq = collections.Counter(strings)\n    total_pairs = 0\n\n    # Iterate through a copy of keys to avoid issues if freq changes during iteration\n    for s in list(freq.keys()):\n        r = s[::-1]\n\n        if s == r:\n            # Palindrome: count combinations among its own occurrences\n            n = freq[s]\n            total_pairs += n * (n - 1) // 2\n        elif s < r and r in freq:\n            # Non-palindrome pair: count only when s is alphabetically \"smaller\" than its reverse\n            # This ensures each pair (s, r) is counted exactly once.\n            total_pairs += freq[s] * freq[r]\n\n    return total_pairs"}
{"task_id": "Mbpp/755", "solution": "import math\n\ndef second_smallest(values):\n    \"\"\"\n    Finds the second smallest number in a list of numeric values using a single pass.\n    Assumes the input list contains at least two elements.\n    \"\"\"\n    min1 = math.inf  # Smallest number found so far\n    min2 = math.inf  # Second smallest number found so far\n\n    for x in values:\n        if x <= min1:\n            # If x is smaller than or equal to the current smallest,\n            # the old smallest becomes the new second smallest, and x becomes the new smallest.\n            min2 = min1\n            min1 = x\n        elif x < min2:\n            # If x is not smaller than min1 but is smaller than min2,\n            # then x is the new second smallest.\n            min2 = x\n    return min2"}
{"task_id": "Mbpp/758", "solution": "from collections.abc import Sequence\nfrom typing import Any, Dict, Tuple\n\nclass SublistCounterError(Exception):\n    \"\"\"Base exception for sublist counter operations.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass InvalidInputError(SublistCounterError):\n    \"\"\"Raised when the top-level input is not a valid sequence.\"\"\"\n    pass\n\nclass InvalidSublistError(SublistCounterError):\n    \"\"\"Raised when an element within the top-level list is not a valid sublist.\"\"\"\n    pass\n\nclass UnsupportedElementTypeError(SublistCounterError):\n    \"\"\"Raised when a sublist contains an unhashable element.\"\"\"\n    pass\n\ndef _is_hashable(obj: Any) -> bool:\n    \"\"\"Checks if an object is hashable.\"\"\"\n    try:\n        hash(obj)\n        return True\n    except TypeError:\n        return False\n\nclass Converter:\n    \"\"\"Handles conversion of sequences to hashable tuples.\"\"\"\n    def to_tuple(self, seq: Sequence[Any]) -> Tuple[Any, ...]:\n        \"\"\"\n        Converts a sequence to a tuple, ensuring all elements are hashable.\n        Raises UnsupportedElementTypeError if any element is unhashable.\n        \"\"\"\n        tup = tuple(seq)\n        for el in tup:\n            if not _is_hashable(el):\n                raise UnsupportedElementTypeError(f\"Element not hashable: {el!r}\")\n        return tup\n\nclass InputValidator:\n    \"\"\"Validates the input structure for the sublist counting process.\"\"\"\n    ALLOWED_SEQUENCE_TYPES = (list, tuple)\n\n    def validate_input(self, list_of_lists: Sequence[Any]) -> None:\n        \"\"\"\n        Validates the main input list and its sublist elements.\n        Raises InvalidInputError or InvalidSublistError for structural issues.\n        \"\"\"\n        if not isinstance(list_of_lists, self.ALLOWED_SEQUENCE_TYPES):\n            raise InvalidInputError(\"Top-level input must be a list or tuple.\")\n        for sub in list_of_lists:\n            self.validate_sublist(sub)\n\n    def validate_sublist(self, sub: Any) -> None:\n        \"\"\"\n        Validates if an item is a proper sublist (list or tuple).\n        Raises InvalidSublistError if the item is not a sequence.\n        \"\"\"\n        if not isinstance(sub, self.ALLOWED_SEQUENCE_TYPES):\n            raise InvalidSublistError(f\"Each element must be a list or tuple, got {type(sub).__name__}: {sub!r}\")\n\nclass CounterService:\n    \"\"\"Core logic for counting unique sublists and their frequencies.\"\"\"\n    def __init__(self, validator: InputValidator, converter: Converter) -> None:\n        self._validator = validator\n        self._converter = converter\n\n    def count(self, list_of_lists: Sequence[Sequence[Any]]) -> Dict[Tuple[Any, ...], int]:\n        \"\"\"\n        Counts occurrences of unique sublists, returning a dictionary\n        mapping sublist tuples to their frequencies.\n        \"\"\"\n        self._validator.validate_input(list_of_lists)\n        counts: Dict[Tuple[Any, ...], int] = {}\n        for sub in list_of_lists:\n            tup = self._converter.to_tuple(sub)\n            counts[tup] = counts.get(tup, 0) + 1\n        return counts\n\nclass SublistController:\n    \"\"\"Provides a high-level API wrapper over the counting service.\"\"\"\n    def __init__(self, service: CounterService) -> None:\n        self._service = service\n\n    def unique_sublists_api(self, list_of_lists: Sequence[Sequence[Any]]) -> Dict[Tuple[Any, ...], int]:\n        \"\"\"\n        Orchestrates the counting process for unique sublists.\n        \"\"\"\n        return self._service.count(list_of_lists)\n\n_default_validator = InputValidator()\n_default_converter = Converter()\n_default_service = CounterService(_default_validator, _default_converter)\n_default_controller = SublistController(_default_service)\n\ndef unique_sublists(list_of_lists: list) -> dict:\n    \"\"\"\n    Counts lists within a list, returning a dictionary where each sublist\n    (converted to a tuple) maps to its number of occurrences.\n    \"\"\"\n    return _default_controller.unique_sublists_api(list_of_lists)"}
{"task_id": "Mbpp/763", "solution": "def find_min_diff(values, n):\n    \"\"\"\n    Finds the minimum absolute difference between any two elements in the given array.\n    The array is first sorted to efficiently compare only adjacent elements.\n    \"\"\"\n    arr = sorted(list(values))\n    if n is None:\n        n = len(arr)\n    if n < 2:\n        raise ValueError(\"At least two elements are required to compute a difference.\")\n    if n != len(arr):\n        raise ValueError(\"Provided n does not match length of values.\")\n    min_diff = float('inf')\n\n    for i in range(1, n):\n        diff = abs(arr[i] - arr[i - 1])\n        if diff < min_diff:\n            min_diff = diff\n            if min_diff == 0:\n                break\n\n    return min_diff"}
{"task_id": "Mbpp/762", "solution": "def check_monthnumber_number(month: int) -> bool:\n    \"\"\"\n    Checks if a given month number (1-12) has 30 days.\n    Months considered to have 30 days are April (4), June (6), September (9), and November (11).\n    \"\"\"\n    return month in {4, 6, 9, 11}"}
{"task_id": "Mbpp/760", "solution": "def unique_Element(numbers):\n    \"\"\"\n    Check whether a list or tuple of numbers contains only one distinct element.\n\n    - Returns True if all items are equal (using Python equality semantics).\n    - Returns False for empty sequences.\n    - Raises TypeError for non-list/tuple inputs.\n    \"\"\"\n    if not isinstance(numbers, (list, tuple)):\n        raise TypeError(\"Input must be a list or tuple of numbers\")\n\n    if not numbers:\n        return False\n\n    first = numbers[0]\n    for item in numbers:\n        if item != first:\n            return False\n    return True"}
{"task_id": "Mbpp/764", "solution": "class InvalidStringError(ValueError):\n    \"\"\"Exception raised for invalid string input.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass StringInput:\n    \"\"\"DTO for validated string input.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\ndef is_digit(ch: str) -> bool:\n    \"\"\"Checks if a single character is a digit.\"\"\"\n    return len(ch) == 1 and ch.isdigit()\n\nclass StringValidator:\n    \"\"\"Validates string inputs.\"\"\"\n    def __init__(self, allow_empty: bool = True) -> None:\n        self.allow_empty = allow_empty\n\n    def validate(self, s: object) -> bool:\n        \"\"\"Returns True if s is a valid string.\"\"\"\n        if not isinstance(s, str):\n            return False\n        if not self.allow_empty and not s:\n            return False\n        return True\n\n    def validate_or_raise(self, s: object) -> StringInput:\n        \"\"\"Validates string input or raises InvalidStringError.\"\"\"\n        if not isinstance(s, str):\n            raise InvalidStringError(\"Input must be a string.\")\n        if not self.allow_empty and not s:\n            raise InvalidStringError(\"Input string cannot be empty.\")\n        return StringInput(s)\n\nclass DigitCounterService:\n    \"\"\"Counts digit characters in a StringInput DTO.\"\"\"\n    def __init__(self, validator: StringValidator) -> None:\n        self._validator = validator\n\n    def count_digits(self, input_dto: StringInput) -> int:\n        \"\"\"Counts Unicode digits in the input string's value.\"\"\"\n        count = 0\n        for ch in input_dto.value:\n            if is_digit(ch):\n                count += 1\n        return count\n\nclass CLIController:\n    \"\"\"Orchestrates validation and digit counting service.\"\"\"\n    def __init__(self, service: DigitCounterService, validator: StringValidator) -> None:\n        self._service = service\n        self._validator = validator\n\n    def process_input(self, s: object) -> int:\n        \"\"\"Validates input, counts digits, and returns the count.\"\"\"\n        string_input_dto = self._validator.validate_or_raise(s)\n        return self._service.count_digits(string_input_dto)\n\ndef number_ctr(s: str) -> int:\n    \"\"\"Counts the number of digit characters in a string.\"\"\"\n    validator = StringValidator(allow_empty=True)\n    digit_counter_service = DigitCounterService(validator=validator)\n    controller = CLIController(service=digit_counter_service, validator=validator)\n    return controller.process_input(s)"}
{"task_id": "Mbpp/765", "solution": "def nth_polite(n: int) -> int:\n    \"\"\"\n    Finds the nth polite number.\n    A polite number is a positive integer that is not a power of two.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer (>= 1)\")\n\n    def _is_power_of_two(num: int) -> bool:\n        # Returns True if num is a power of two, assuming num > 0.\n        return num > 0 and (num & (num - 1)) == 0\n\n    polite_count = 0\n    current_num = 1\n    while True:\n        if not _is_power_of_two(current_num):\n            polite_count += 1\n            if polite_count == n:\n                return current_num\n        current_num += 1"}
{"task_id": "Mbpp/766", "solution": "from dataclasses import dataclass\nfrom typing import Generic, List, Tuple, TypeVar, Sequence, Any\nfrom collections.abc import Sequence as SeqABC\n\nT = TypeVar(\"T\")\n\n@dataclass(frozen=True)\nclass Pair(Generic[T]):\n    \"\"\"Represents a consecutive pair of items.\"\"\"\n    first: T\n    second: T\n\n    def to_tuple(self) -> Tuple[T, T]:\n        \"\"\"Returns the pair as a standard tuple.\"\"\"\n        return (self.first, self.second)\n\nclass PairwiseGenerator:\n    \"\"\"Generates a list of consecutive pairs from a sequence.\"\"\"\n    def generate(self, items: Sequence[T]) -> List[Pair[T]]:\n        n = len(items)\n        if n > 1:\n            return [Pair(items[i], items[i+1]) for i in range(n - 1)]\n        return []\n\nclass Validator:\n    \"\"\"Provides utility methods for input validation.\"\"\"\n    @staticmethod\n    def is_sequence(obj: Any) -> bool:\n        \"\"\"Checks if an object is a non-string, non-bytes sequence.\"\"\"\n        return isinstance(obj, SeqABC) and not isinstance(obj, (str, bytes))\n\nclass InvalidInputError(ValueError):\n    \"\"\"Exception raised for invalid input to the pairwise functions.\"\"\"\n    pass\n\nclass PairService:\n    \"\"\"Orchestrates input validation and pair generation.\"\"\"\n    def __init__(self, generator: PairwiseGenerator = None) -> None:\n        self.generator = generator or PairwiseGenerator()\n\n    def generate_pairs(self, items: Sequence[T]) -> List[Pair[T]]:\n        \"\"\"Validates input and delegates pair generation.\"\"\"\n        if items is None or not Validator.is_sequence(items):\n            raise InvalidInputError(\"items must be a non-string sequence\")\n        return self.generator.generate(items)\n\n_service = PairService()\n\ndef pair_wise(items: Sequence[T]) -> List[Tuple[T, T]]:\n    \"\"\"\n    Returns a list of all pairs of consecutive items in a given list.\n    Raises InvalidInputError if input is not a non-string sequence.\n    \"\"\"\n    pairs = _service.generate_pairs(items)\n    return [p.to_tuple() for p in pairs]"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers, sum):\n    \"\"\"\n    Count unordered pairs of elements (distinct indices i < j) in `numbers`\n    whose values add up to `sum`.\n    \"\"\"\n    from collections import Counter\n\n    if numbers is None:\n        raise ValueError(\"numbers must be provided\")\n\n    nums = list(numbers)\n    freq = Counter(nums)\n    count = 0\n\n    for v in freq:\n        c = sum - v\n        if c not in freq:\n            continue\n        if c == v:\n            n = freq[v]\n            count += n * (n - 1) // 2\n        elif v < c:\n            count += freq[v] * freq[c]\n\n    return count"}
{"task_id": "Mbpp/769", "solution": "def Diff(list1, list2):\n    \"\"\"\n    Calculates the difference between two lists, returning elements in list1 not present in list2.\n    The result is ordered by original index: even-indexed elements first, then odd-indexed elements.\n    \"\"\"\n    # Enumerate list1 to capture original indices along with values.\n    enumerated_list1 = list(enumerate(list1))\n\n    # Attempt to create a set from list2 for efficient membership checks.\n    # Fallback to list-based checking if elements are unhashable.\n    try:\n        set_list2 = set(list2)\n        is_in_list2 = lambda x: x in set_list2\n    except TypeError:\n        is_in_list2 = lambda x: x in list2\n\n    # Filter out elements from enumerated_list1 that are present in list2.\n    filtered_items_with_indices = []\n    for idx, item in enumerated_list1:\n        if not is_in_list2(item):\n            filtered_items_with_indices.append((idx, item))\n\n    # Group filtered items by their original index parity (even or odd).\n    evens_indexed_items = []\n    odds_indexed_items = []\n    for idx, item in filtered_items_with_indices:\n        if idx % 2 == 0:\n            evens_indexed_items.append(item)\n        else:\n            odds_indexed_items.append(item)\n\n    # Combine and return the result as specified by the ordering rule.\n    return evens_indexed_items + odds_indexed_items"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the fourth powers of the first n odd natural numbers using a closed-form formula.\n    The formula derived is: sum_{k=1..n} (2k-1)^4 = (n * (48*n^4 - 40*n^2 + 7)) // 15.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be >= 0\")\n    if n == 0:\n        return 0\n    return (n * (48 * n**4 - 40 * n**2 + 7)) // 15"}
{"task_id": "Mbpp/772", "solution": "def remove_length(text: str, k: int) -> str:\n    \"\"\"\n    Removes all words of a specific length k from the given string.\n    Words are split by whitespace, and the remaining words are joined by a single space.\n    \"\"\"\n    words = text.split()\n    filtered_words = [word for word in words if len(word) != k]\n    return \" \".join(filtered_words)"}
{"task_id": "Mbpp/771", "solution": "def check_expression(expression: str) -> bool:\n    \"\"\"\n    Checks if the given expression has balanced brackets.\n    Ignores any characters that are not one of '(', ')', '[', ']', '{', '}'.\n    \"\"\"\n    stack = []\n    opening_brackets = \"([{\"\n    bracket_pairs = {')': '(', ']': '[', '}': '{'}\n\n    for char in expression:\n        if char in opening_brackets:\n            stack.append(char)\n        elif char in bracket_pairs:  # It's a closing bracket\n            if not stack:\n                return False  # Unmatched closing bracket\n            top_char = stack.pop()\n            if top_char != bracket_pairs[char]:\n                return False  # Mismatched opening bracket\n        # Non-bracket characters are ignored as per design context for the balancing logic.\n\n    return not stack  # True if the stack is empty (all brackets matched), False otherwise"}
{"task_id": "Mbpp/775", "solution": "def odd_position(list_):\n    \"\"\"\n    Checks if every odd-indexed element in the list is an odd number.\n    Assumes list_ contains only integers.\n    \"\"\"\n    for i in range(1, len(list_), 2):\n        if abs(list_[i]) % 2 == 0:\n            return False\n    return True"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(text, pattern):\n    \"\"\"\n    Finds the first occurrence and position of a substring within a string.\n    Returns None if there is no match.\n    \"\"\"\n    start_index = text.find(pattern)\n    if start_index == -1:\n        return None\n    end_index = start_index + len(pattern)\n    return (pattern, start_index, end_index)"}
{"task_id": "Mbpp/778", "solution": "from typing import List, TypeVar\n\nT = TypeVar('T')\n\ndef pack_consecutive_duplicates(lst: List[T]) -> List[List[T]]:\n    \"\"\"\n    Packs consecutive duplicate elements of a list into sublists.\n    The order of elements and sublists is preserved.\n    \"\"\"\n    if not lst:\n        return []\n\n    result: List[List[T]] = []\n    current_sublist = [lst[0]]\n\n    for item in lst[1:]:\n        if item == current_sublist[-1]:\n            current_sublist.append(item)\n        else:\n            result.append(current_sublist)\n            current_sublist = [item]\n\n    result.append(current_sublist)  # Append the last sublist\n    return result"}
{"task_id": "Mbpp/777", "solution": "def find_sum(nums):\n    \"\"\"\n    Find the sum of non-repeated elements in a given list.\n    An element is considered non-repeated if it appears exactly once.\n    \"\"\"\n    counts = {}\n    for num in nums:\n        counts[num] = counts.get(num, 0) + 1\n    return sum(num for num, cnt in counts.items() if cnt == 1)"}
{"task_id": "Mbpp/780", "solution": "import itertools\nfrom dataclasses import dataclass\nfrom typing import Any, Iterable, List, Tuple\n\ndef find_combinations(data: List[Tuple[int, int]]) -> List[Tuple[int, int]]:\n    \"\"\"\n    Finds combinations of element-wise sums with tuples in the given tuple list.\n    This function encapsulates all necessary helper classes and functions internally.\n    \"\"\"\n\n    class InvalidInputError(Exception):\n        \"\"\"Custom exception for invalid input data.\"\"\"\n        pass\n\n    @dataclass(frozen=True)\n    class Pair:\n        \"\"\"Represents a 2-element integer tuple for domain logic.\"\"\"\n        a: int\n        b: int\n\n        def to_tuple(self) -> Tuple[int, int]:\n            \"\"\"Converts the Pair to a standard Python tuple.\"\"\"\n            return (self.a, self.b)\n\n        def __add__(self, other: \"Pair\") -> \"Pair\":\n            \"\"\"Performs element-wise addition with another Pair.\"\"\"\n            return Pair(self.a + other.a, self.b + other.b)\n\n    def to_int(value: Any) -> int:\n        \"\"\"Converts a value to an integer or raises InvalidInputError.\"\"\"\n        if not isinstance(value, int):\n            raise InvalidInputError(f\"Expected an integer, but got {type(value).__name__}: {value!r}\")\n        return value\n\n    def is_valid_pair(item: Any) -> bool:\n        \"\"\"Checks if an item is a valid 2-element tuple of integers.\"\"\"\n        if not isinstance(item, (tuple, list)) or len(item) != 2:\n            return False\n        try:\n            to_int(item[0])\n            to_int(item[1])\n            return True\n        except InvalidInputError:\n            return False\n\n    class TupleRepository:\n        \"\"\"Validates raw input and converts it to a list of Pair objects.\"\"\"\n        def parse_list(self, raw: Iterable) -> List[Pair]:\n            result: List[Pair] = []\n            for idx, item in enumerate(raw):\n                if not is_valid_pair(item):\n                    raise InvalidInputError(f\"Item at index {idx} is not a valid 2-int pair: {item!r}\")\n                a = to_int(item[0])\n                b = to_int(item[1])\n                result.append(Pair(a, b))\n            return result\n\n    class CombinationService:\n        \"\"\"Computes unordered pairwise sums of Pair objects.\"\"\"\n        def compute_pairwise_sums(self, pairs: List[Pair]) -> List[Pair]:\n            n = len(pairs)\n            if n < 2:\n                return []\n            out: List[Pair] = []\n            for i in range(n - 1):\n                for j in range(i + 1, n):\n                    out.append(pairs[i] + pairs[j])\n            return out\n\n    class ResultFormatter:\n        \"\"\"Converts a list of Pair objects to a list of standard Python tuples.\"\"\"\n        def format_pairs(self, pairs: List[Pair]) -> List[Tuple[int, int]]:\n            return [p.to_tuple() for p in pairs]\n\n    class CLIController:\n        \"\"\"Orchestrates parsing, computation, and formatting for the library API.\"\"\"\n        def __init__(self):\n            self.repo = TupleRepository()\n            self.service = CombinationService()\n            self.formatter = ResultFormatter()\n\n        def find_combinations_raw(self, raw: Iterable) -> List[Tuple[int, int]]:\n            pairs = self.repo.parse_list(raw)\n            sums = self.service.compute_pairwise_sums(pairs)\n            return self.formatter.format_pairs(sums)\n\n    controller = CLIController()\n    return controller.find_combinations_raw(data)"}
{"task_id": "Mbpp/781", "solution": "def count_divisors(n: int) -> bool:\n    \"\"\"Checks if the number of divisors for n is even.\n    Assumes n is a positive integer.\n    \"\"\"\n    import math\n\n    if not isinstance(n, int):\n        raise ValueError(\"n must be an integer\")\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer (> 0)\")\n\n    root = math.isqrt(n)\n\n    count = 0\n    for i in range(1, root + 1):\n        if n % i == 0:\n            count += 2\n\n    if root * root == n:\n        count -= 1\n\n    return count % 2 == 0"}
{"task_id": "Mbpp/782", "solution": "import json\nfrom typing import Any, List, Optional\n\ndef is_int_like(val: Any) -> bool:\n    \"\"\"Checks if a value can be safely converted to an integer.\"\"\"\n    try:\n        int(val)\n        return True\n    except (TypeError, ValueError):\n        return False\n\ndef validate_int_list(value: Any) -> List[int]:\n    \"\"\"Validates and converts an input value into a list of integers.\"\"\"\n    if isinstance(value, (list, tuple)):\n        if not value:\n            raise ValueError(\"List is empty\")\n        if not all(is_int_like(x) for x in value):\n            raise ValueError(\"All elements must be integer-like\")\n        return [int(x) for x in value]\n    if isinstance(value, str):\n        s = value.strip()\n        if s.startswith(\"[\") and s.endswith(\"]\"):\n            try:\n                parsed = json.loads(s)\n                return validate_int_list(parsed)\n            except json.JSONDecodeError as e:\n                raise ValueError(f\"Invalid JSON string: {e}\")\n        parts = s.split()\n        if not parts:\n            raise ValueError(\"Empty string provided\")\n        if not all(is_int_like(p) for p in parts):\n            raise ValueError(\"String contains non-integer tokens\")\n        return [int(p) for p in parts]\n    raise ValueError(\"Unsupported input type for array\")\n\nclass InputArray:\n    \"\"\"Data transfer object for input array, handling initial validation.\"\"\"\n    def __init__(self, values: list[int]) -> None:\n        self.values = validate_int_list(values)\n        self.n = len(self.values)\n        if self.n == 0:\n            raise ValueError(\"Input list must be non-empty\")\n    def validate(self) -> None:\n        \"\"\"Explicit validation method, though validation happens at construction.\"\"\"\n        pass\n\nclass Result:\n    \"\"\"Data transfer object for the computed sum and input length.\"\"\"\n    def __init__(self, value: int, n: int) -> None:\n        self.value = value\n        self.n = n\n    def to_dict(self) -> dict:\n        \"\"\"Returns the result as a dictionary.\"\"\"\n        return {\"value\": self.value, \"n\": self.n}\n\nclass InMemoryResultRepository:\n    \"\"\"An ephemeral in-memory repository to store the last computed result.\"\"\"\n    def __init__(self) -> None:\n        self._last: Optional[Result] = None\n\n    def save(self, result: Result) -> None:\n        \"\"\"Saves the given result.\"\"\"\n        self._last = result\n\n    def get_last(self) -> Optional[Result]:\n        \"\"\"Retrieves the last saved result.\"\"\"\n        return self._last\n\nclass OddSumService:\n    \"\"\"Core service for computing the sum of all odd-length subarrays.\"\"\"\n    def __init__(self, repo: Optional[InMemoryResultRepository]=None) -> None:\n        self._repo = repo\n\n    def compute_sum(self, input_array: InputArray) -> Result:\n        \"\"\"Computes the sum of all odd-length subarrays using an O(n) algorithm.\"\"\"\n        values = input_array.values\n        total = 0\n        n = input_array.n\n        for i, val in enumerate(values):\n            # Calculate total subarrays including element at index i, then count odd-length ones.\n            total_subarrays = (i + 1) * (n - i)\n            odd_count = (total_subarrays + 1) // 2\n            total += val * odd_count\n        result = Result(total, n)\n        if self._repo:\n            self._repo.save(result)\n        return result\n\n_repo: Optional[InMemoryResultRepository] = None\n\ndef odd_length_sum(arr: list[int]) -> int:\n    \"\"\"Computes the sum of all odd-length subarrays of the given integer array.\"\"\"\n    inp = InputArray(arr)\n    service = OddSumService(repo=_repo)\n    result = service.compute_sum(inp)\n    return result.value"}
{"task_id": "Mbpp/784", "solution": "from typing import Sequence, Optional\n\ndef mul_even_odd(seq: Sequence[int]) -> Optional[int]:\n    \"\"\"\n    Finds the product of the first even and first odd number in a given list.\n\n    Returns None if either an even or odd number is not found.\n    \"\"\"\n    first_odd = None\n    first_even = None\n\n    for num in seq:\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n        if first_even is None and num % 2 == 0:\n            first_even = num\n\n        # If both have been found, we can stop iterating early\n        if first_odd is not None and first_even is not None:\n            break\n\n    if first_odd is not None and first_even is not None:\n        return first_odd * first_even\n    else:\n        return None"}
{"task_id": "Mbpp/786", "solution": "from typing import Sequence, TypeVar\n\nT = TypeVar(\"T\")\n\ndef right_insertion(seq: Sequence[T], value: T) -> int:\n    \"\"\"\n    Locates the right insertion point for a specified value in sorted order using binary search.\n    This places the value after any existing equal elements.\n    \"\"\"\n    lo = 0\n    hi = len(seq)\n    while lo < hi:\n        mid = (lo + hi) // 2\n        if seq[mid] <= value:\n            lo = mid + 1\n        else:\n            hi = mid\n    return lo"}
{"task_id": "Mbpp/787", "solution": "import re\nfrom typing import Pattern\n\n# Helper classes and objects defined inline as per instructions\n\nclass AppConfig:\n    \"\"\"Centralizes constant configuration values.\"\"\"\n    PATTERN_STR: str = r\"ab{3}\"\n\n_CACHE: dict[str, Pattern] = {} # Module-private cache for RegexProvider\n\nclass RegexProvider:\n    \"\"\"Compiles and optionally caches regex patterns.\"\"\"\n    def get_compiled(self, pattern_str: str) -> Pattern:\n        if pattern_str not in _CACHE:\n            _CACHE[pattern_str] = re.compile(pattern_str)\n        return _CACHE[pattern_str]\n\n    def compile_and_cache(self, pattern_str: str) -> Pattern:\n        # This method is exposed for consistency but internally uses the same cache logic as get_compiled.\n        return self.get_compiled(pattern_str)\n\n    def clear_cache(self) -> None:\n        _CACHE.clear()\n\n_regex_provider = RegexProvider()\n\ndef text_match_three(text: str) -> bool:\n    \"\"\"\n    Checks if the input string contains an 'a' followed by exactly three 'b's.\n    Raises TypeError if the input is not a string.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"text must be a str\")\n    pattern: Pattern = _regex_provider.get_compiled(AppConfig.PATTERN_STR)\n    return bool(pattern.search(text))"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(s: str) -> tuple[int, ...]:\n    \"\"\"Converts a string representation of an integer tuple to an actual tuple of integers.\n    Handles empty tuples and single-element tuples with trailing commas as per Python semantics.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"input must be a string\")\n\n    s = s.strip()\n    if not s.startswith('(') or not s.endswith(')'):\n        raise ValueError(\"expected string enclosed in parentheses\")\n\n    # Extract the content inside the parentheses\n    content = s[1:-1].strip()\n\n    if content == \"\":\n        return ()\n\n    # Split by comma and strip whitespace from each potential integer part.\n    parts = [p.strip() for p in content.split(',')]\n\n    # Handle trailing comma producing an empty final part, e.g. \"(7,)\" -> ['7', '']\n    if parts and parts[-1] == '':\n        parts.pop()\n\n    if any(p == '' for p in parts):\n        raise ValueError(\"empty token found in tuple string\")\n\n    # Validate and convert each token to int (raises ValueError for invalid integers)\n    result = []\n    for part in parts:\n        # Allow explicit + or - signs and digits only\n        if not part.lstrip('+-').isdigit():\n            raise ValueError(f\"invalid integer token: {part!r}\")\n        try:\n            result.append(int(part))\n        except ValueError:\n            # Re-raise with clearer message\n            raise ValueError(f\"invalid integer token: {part!r}\")\n\n    return tuple(result)"}
