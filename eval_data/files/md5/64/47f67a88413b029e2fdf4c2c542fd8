{"task_id": "Mbpp/453", "solution": "import math\n\ndef sumofFactors(n: int) -> int:\n    \"\"\"Calculates the sum of even factors of a given number n.\"\"\"\n    even_factors_sum = 0\n    for i in range(1, int(math.isqrt(n)) + 1):\n        if n % i == 0:\n            if i % 2 == 0:\n                even_factors_sum += i\n            j = n // i\n            if j != i and j % 2 == 0:\n                even_factors_sum += j\n    return even_factors_sum"}
{"task_id": "Mbpp/448", "solution": "_perrin_cache = {0: 3, 1: 0, 2: 2}\n\ndef cal_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of Perrin numbers from index 0 up to n (inclusive).\n    Perrin numbers are defined by:\n      P(0) = 3, P(1) = 0, P(2) = 2\n      P(k) = P(k-2) + P(k-3) for k >= 3\n\n    Args:\n        n (int): non-negative integer index up to which to sum Perrin numbers.\n\n    Returns:\n        int: sum of Perrin numbers P(0) + P(1) + ... + P(n).\n\n    Raises:\n        TypeError: if n is not an int.\n        ValueError: if n is negative.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    for i in range(3, n + 1):\n        if i not in _perrin_cache:\n            _perrin_cache[i] = _perrin_cache[i - 2] + _perrin_cache[i - 3]\n\n    total_sum = 0\n    for i in range(n + 1):\n        total_sum += _perrin_cache[i]\n\n    return total_sum"}
{"task_id": "Mbpp/455", "solution": "def check_monthnumb_number(month):\n    \"\"\"Return True if the given month number has 31 days.\n\n    Args:\n        month: int month number (1..12)\n\n    Returns:\n        bool: True if month has 31 days, False otherwise.\n\n    Raises:\n        ValueError: if month is not an int in 1..12.\n    \"\"\"\n    if isinstance(month, bool) or not isinstance(month, int):\n        raise ValueError(\"month must be an integer between 1 and 12\")\n    if not (1 <= month <= 12):\n        raise ValueError(\"month must be an integer between 1 and 12\")\n\n    MONTHS_WITH_31_DAYS = {1, 3, 5, 7, 8, 10, 12}\n    return month in MONTHS_WITH_31_DAYS"}
{"task_id": "Mbpp/454", "solution": "import re\nfrom dataclasses import dataclass\nfrom typing import List, Dict, Any, Pattern, Optional\n\n# --- Configuration Constants (from src/wordz_matcher/config.py) ---\nDEFAULT_PATTERN: str = r\"\\b\\w*z\\w*\\b\"\nDEFAULT_FLAGS: int = re.IGNORECASE\nMAX_TEXT_LENGTH: int = 100000\n\n# --- Exceptions (from src/wordz_matcher/exceptions.py) ---\nclass TextMatchError(Exception):\n    \"\"\"Application-specific exception for text matching operations.\"\"\"\n    def __init__(self, code: str, message: str) -> None:\n        self.code = code\n        self.message = message\n        super().__init__(f\"[{self.code}] {self.message}\")\n\n# --- Models (from src/wordz_matcher/models.py) ---\n@dataclass(frozen=True)\nclass PatternMatchResult:\n    \"\"\"Represents the outcome of a pattern match operation.\"\"\"\n    matched: bool\n    tokens: List[str]\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Returns a dictionary representation of the result.\"\"\"\n        return {\"matched\": self.matched, \"tokens\": list(self.tokens)}\n\n# --- Adapters (from src/wordz_matcher/adapters/regex_adapter.py) ---\nclass RegexAdapter:\n    \"\"\"Encapsulates regex compilation and execution.\"\"\"\n    def __init__(self, pattern: str, flags: int = 0) -> None:\n        self._pattern = pattern\n        self._flags = flags\n        self._compiled: Optional[Pattern] = None\n\n    def compile(self) -> Pattern:\n        \"\"\"Compiles the regex pattern if not already compiled.\"\"\"\n        if self._compiled is None:\n            self._compiled = re.compile(self._pattern, self._flags)\n        return self._compiled\n\n    def find_tokens(self, text: str) -> List[str]:\n        \"\"\"Finds all tokens matching the compiled regex in the given text.\"\"\"\n        pat = self.compile()\n        return [m.group(0) for m in pat.finditer(text)]\n\n# --- Utilities (from src/wordz_matcher/utils.py) ---\nclass TextValidator:\n    \"\"\"Validates input text for length and type.\"\"\"\n    def validate_text(self, text: Any) -> str:\n        \"\"\"Validates that the input is a string and within acceptable length.\"\"\"\n        if not isinstance(text, str):\n            raise TextMatchError(\"INVALID_INPUT\", \"text must be a string\")\n        if len(text) > MAX_TEXT_LENGTH:\n            raise TextMatchError(\"INVALID_INPUT\", \"text too long\")\n        return text.strip()\n\n# --- Services (from src/wordz_matcher/services.py) ---\nclass MatcherService:\n    \"\"\"Orchestrates text validation and pattern matching.\"\"\"\n    def __init__(self, adapter: RegexAdapter, validator: TextValidator) -> None:\n        self._adapter = adapter\n        self._validator = validator\n\n    def match_text(self, text: str) -> PatternMatchResult:\n        \"\"\"Validates text and finds matching tokens using the regex adapter.\"\"\"\n        valid_text = self._validator.validate_text(text)\n        try:\n            tokens = self._adapter.find_tokens(valid_text)\n        except Exception as ex:\n            raise TextMatchError(\"INTERNAL_ERROR\", str(ex))\n        return PatternMatchResult(matched=bool(tokens), tokens=tokens)\n\n# --- Public API (from src/wordz_matcher/api.py) ---\ndef text_match_wordz(text: str) -> bool:\n    \"\"\"\n    Checks if the given text contains at least one whole word that includes the letter 'z' (case-insensitive).\n    \"\"\"\n    adapter = RegexAdapter(DEFAULT_PATTERN, DEFAULT_FLAGS)\n    validator = TextValidator()\n    service = MatcherService(adapter, validator)\n    result = service.match_text(text)\n    return result.matched"}
