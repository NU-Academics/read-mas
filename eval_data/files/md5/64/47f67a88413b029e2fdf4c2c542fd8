{"task_id": "Mbpp/410", "solution": "def min_val(values):\n    \"\"\"\n    Return the minimum numeric value from a heterogeneous iterable.\n    Numeric strings are parsed as numbers when possible. Non-numeric items are ignored.\n\n    Raises:\n        TypeError: if `values` is not iterable.\n        ValueError: if no numeric values are found.\n    \"\"\"\n    try:\n        iterator = iter(values)\n    except TypeError:\n        raise TypeError(\"Input must be an iterable.\") from None\n\n    from decimal import Decimal, InvalidOperation\n\n    min_numeric = None\n\n    for item in iterator:\n        numeric_item = None\n\n        # Direct numeric types\n        if isinstance(item, (int, float, Decimal)):\n            numeric_item = item\n        # Try parsing strings\n        elif isinstance(item, str):\n            s = item.strip()\n            if s == \"\":\n                continue\n            try:\n                # If contains a decimal point or exponent, prefer Decimal for precision.\n                if \".\" in s or \"e\" in s.lower():\n                    numeric_item = Decimal(s)\n                else:\n                    numeric_item = int(s)\n            except (ValueError, InvalidOperation):\n                # Fallback to float parsing (also handles things like \"nan\", \"+3.4\", etc.)\n                try:\n                    numeric_item = float(s)\n                except ValueError:\n                    # Not a numeric string; ignore\n                    continue\n        else:\n            # Non-numeric and non-string items are ignored\n            continue\n\n        # Update minimum, handling potential TypeError when comparing mixed types\n        if min_numeric is None:\n            min_numeric = numeric_item\n        else:\n            try:\n                if numeric_item < min_numeric:\n                    min_numeric = numeric_item\n            except TypeError:\n                # Fallback: compare by float coercion to provide a sensible ordering\n                try:\n                    if float(numeric_item) < float(min_numeric):\n                        min_numeric = numeric_item\n                except Exception:\n                    # If we cannot compare, skip the value\n                    continue\n\n    if min_numeric is None:\n        raise ValueError(\"No numeric values found in the input.\")\n\n    return min_numeric"}
{"task_id": "Mbpp/409", "solution": "def min_product_tuple(pairs):\n    \"\"\"\n    Finds the minimum product from the pairs of tuples within a given list.\n    Assumes `pairs` is a non-empty list of 2-element tuples containing integers.\n    \"\"\"\n    min_val = None\n    for a, b in pairs:\n        prod = a * b\n        if min_val is None or prod < min_val:\n            min_val = prod\n    return int(min_val)"}
{"task_id": "Mbpp/405", "solution": "from typing import Any, Tuple, Iterable, Optional\n\nclass TuplexError(Exception):\n    \"\"\"Base exception for tuplex_checker errors.\"\"\"\n    def __init__(self, message: str = \"An error occurred in tuplex_checker.\") -> None:\n        self.message = message\n        super().__init__(self.message)\n\nclass InvalidInputError(TuplexError):\n    \"\"\"Exception raised for invalid input data.\"\"\"\n    def __init__(self, message: str = \"Invalid input provided.\") -> None:\n        super().__init__(message)\n\nclass ServiceError(TuplexError):\n    \"\"\"Exception raised for service layer errors.\"\"\"\n    def __init__(self, message: str = \"A service error occurred.\") -> None:\n        super().__init__(message)\n\ndef is_iterable(value: Any) -> bool:\n    \"\"\"Checks if a value is iterable.\"\"\"\n    try:\n        iter(value)\n    except TypeError:\n        return False\n    return True\n\ndef ensure_tuple(value: Any) -> Tuple[Any, ...]:\n    \"\"\"Ensures the input value is a tuple, converting if necessary.\"\"\"\n    if isinstance(value, tuple):\n        return value\n    if is_iterable(value):\n        return tuple(value)\n    raise InvalidInputError(\"Input is not iterable and cannot be treated as a tuple\")\n\nclass ElementCheckRequest:\n    \"\"\"Data Transfer Object for an element check request.\"\"\"\n    def __init__(self, tuple_input: Tuple[Any, ...] | Iterable[Any], element: Any) -> None:\n        self.tuple_input = tuple_input\n        self.element = element\n\nclass ElementCheckResponse:\n    \"\"\"Data Transfer Object for an element check response.\"\"\"\n    def __init__(self, found: bool) -> None:\n        self.found = found\n\nclass TupleRepository:\n    \"\"\"Abstract base class for tuple data access.\"\"\"\n    def exists(self, tuple_input: Tuple[Any, ...], element: Any) -> bool:\n        raise NotImplementedError\n\nclass InMemoryTupleRepository(TupleRepository):\n    \"\"\"In-memory implementation of TupleRepository.\"\"\"\n    def __init__(self, tuple_data: Optional[Tuple[Any, ...]] = None) -> None:\n        pass # The tuple_data attribute is not directly used by this implementation's exists method.\n\n    def exists(self, tuple_input: Tuple[Any, ...], element: Any) -> bool:\n        \"\"\"Checks if an element exists within the provided tuple.\"\"\"\n        return element in tuple_input\n\nclass TupleService:\n    \"\"\"Business logic for tuple operations.\"\"\"\n    def __init__(self, repo: TupleRepository) -> None:\n        self._repo = repo\n\n    def check(self, tuple_input: Tuple[Any, ...] | Iterable[Any], element: Any) -> bool:\n        \"\"\"Checks if an element exists in a given tuple, handling input validation.\"\"\"\n        try:\n            tup = ensure_tuple(tuple_input)\n        except InvalidInputError:\n            raise\n        except Exception as e:\n            raise ServiceError(f\"Error during input processing: {e}\") from e\n\n        try:\n            return self._repo.exists(tup, element)\n        except Exception as e:\n            raise ServiceError(f\"Repository error during check: {e}\") from e\n\nclass TupleController:\n    \"\"\"Controller for handling tuple check requests.\"\"\"\n    def __init__(self, service: TupleService) -> None:\n        self._service = service\n\n    def handle_check(self, req: ElementCheckRequest) -> ElementCheckResponse:\n        \"\"\"Handles an element check request by delegating to the service.\"\"\"\n        found = self._service.check(req.tuple_input, req.element)\n        return ElementCheckResponse(found)\n\ndef check_tuplex(tuple_input: Tuple[Any, ...] | Iterable[Any], element: Any) -> bool:\n    \"\"\"\n    Checks whether an element exists within a tuple.\n    Accepts a tuple or any iterable (e.g., list) as input.\n    \"\"\"\n    repo = InMemoryTupleRepository()\n    service = TupleService(repo)\n    controller = TupleController(service)\n    req = ElementCheckRequest(tuple_input, element)\n    resp = controller.handle_check(req)\n    return resp.found"}
{"task_id": "Mbpp/412", "solution": "def remove_odd(numbers):\n    \"\"\"\n    Removes odd numbers from a list, returning a new list with only even numbers.\n    The order of elements is preserved.\n    \"\"\"\n    even_numbers = []\n    for num in numbers:\n        if num % 2 == 0:\n            even_numbers.append(num)\n    return even_numbers"}
{"task_id": "Mbpp/415", "solution": "def max_Product(arr):\n    # Validate input\n    if arr is None:\n        raise ValueError(\"Input array is None\")\n    if not hasattr(arr, \"__iter__\"):\n        raise TypeError(\"Input must be an iterable of integers\")\n    arr_list = list(arr)\n    if len(arr_list) < 2:\n        raise ValueError(\"Array must contain at least two integers\")\n    for i, v in enumerate(arr_list):\n        if not isinstance(v, int):\n            raise TypeError(f\"All items must be integers; item at index {i} is {type(v).__name__}\")\n\n    # Sort the array to identify candidates: two largest or two smallest\n    arr_list.sort()\n    n = len(arr_list)\n\n    # Candidate pairs\n    pair1 = (arr_list[n - 2], arr_list[n - 1])  # two largest\n    pair2 = (arr_list[0], arr_list[1])          # two smallest (could be negative)\n\n    product1 = pair1[0] * pair1[1]\n    product2 = pair2[0] * pair2[1]\n\n    # Choose the pair with the greater product. For tie, return the lexicographically smaller pair.\n    if product1 > product2:\n        return pair1\n    if product2 > product1:\n        return pair2\n    # tie-breaker: return lexicographically smaller tuple\n    return pair1 if tuple(sorted(pair1)) <= tuple(sorted(pair2)) else pair2"}
{"task_id": "Mbpp/413", "solution": "def extract_nth_element(list_of_tuples, n):\n    \"\"\"\n    Extracts the nth element from each tuple in a given list of tuples.\n    Assumes valid input and index within bounds for all tuples.\n    \"\"\"\n    return [item[n] for item in list_of_tuples]"}
{"task_id": "Mbpp/418", "solution": "def Find_Max(lst):\n    \"\"\"\n    Finds the element in a list with the maximum length.\n    If multiple elements have the same maximum length, the first one encountered is returned.\n    \"\"\"\n    def _get_length(item):\n        \"\"\"Helper to determine length, treating non-sequence items as length 1.\"\"\"\n        try:\n            return len(item)\n        except TypeError:\n            return 1\n\n    # Initialize with the first element, assuming the list is non-empty based on design context.\n    max_length = _get_length(lst[0])\n    best_element = lst[0]\n\n    # Iterate through the rest of the list to find the element with maximum length.\n    for i in range(1, len(lst)):\n        current_element = lst[i]\n        current_length = _get_length(current_element)\n\n        if current_length > max_length:\n            max_length = current_length\n            best_element = current_element\n\n    return best_element"}
{"task_id": "Mbpp/419", "solution": "def round_and_sum(numbers):\n    \"\"\"\n    Rounds each number in a list, sums the rounded values, and multiplies the sum by the list length.\n    \"\"\"\n    if not numbers:\n        return 0  # Handle empty list case\n\n    rounded_numbers = [round(num) for num in numbers]\n    total_sum = sum(rounded_numbers)\n    result = total_sum * len(numbers)\n    return int(result)"}
{"task_id": "Mbpp/414", "solution": "def overlapping(seq1, seq2):\n    \"\"\"\n    Check whether any value in seq1 exists in seq2.\n    Uses a set-based check when elements are hashable (optimized),\n    otherwise falls back to nested comparisons.\n    \"\"\"\n    a_list = list(seq1)\n    b_list = list(seq2)\n\n    # Use the smaller sequence for set construction when possible.\n    if len(a_list) <= len(b_list):\n        small, large = a_list, b_list\n    else:\n        small, large = b_list, a_list\n\n    # Sample a few elements to determine hashability.\n    sample_limit = 10\n    count = 0\n    hashable = True\n    for elem in small:\n        try:\n            hash(elem)\n        except Exception:\n            hashable = False\n            break\n        count += 1\n        if count >= sample_limit:\n            break\n\n    if hashable:\n        small_set = set(small)\n        for elem in large:\n            if elem in small_set:\n                return True\n    else:\n        for x in small:\n            for y in large:\n                if x == y:\n                    return True\n\n    return False"}
{"task_id": "Mbpp/420", "solution": "def cube_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the cube sum of the first n even natural numbers using a closed-form formula.\n    The formula is 8 * (n * (n + 1) // 2) ** 2.\n    \"\"\"\n    # Validate input\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    # Sum of first n natural numbers\n    sum_natural_numbers = n * (n + 1) // 2\n\n    # Square the sum and multiply by 8 to account for even cubes (2^3 factor)\n    return 8 * (sum_natural_numbers * sum_natural_numbers)"}
