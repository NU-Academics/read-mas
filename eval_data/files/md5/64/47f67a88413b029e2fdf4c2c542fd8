{"task_id": "Mbpp/252", "solution": "import math\nfrom typing import Tuple\n\ndef convert(value: object) -> tuple[float, float]:\n    \"\"\"Converts a complex number or numeric equivalent to polar coordinates (r, theta).\n    Supports int, float, complex, 2-element sequences, and complex-formatted strings.\n    \"\"\"\n\n    class ConversionError(Exception):\n        pass\n\n    class InvalidComplexError(ConversionError):\n        pass\n\n    class PolarCoordinate:\n        def __init__(self, r: float, theta: float) -> None:\n            self.r = r\n            self.theta = theta\n\n        def as_tuple(self) -> tuple[float, float]:\n            return self.r, self.theta\n\n    class Validator:\n        EPSILON = 1e-12\n\n        def is_numeric(self, value: object) -> bool:\n            return isinstance(value, (int, float)) and not isinstance(value, bool)\n\n        def to_components(self, value: object) -> Tuple[float, float]:\n            if isinstance(value, complex):\n                return float(value.real), float(value.imag)\n            if self.is_numeric(value):\n                return float(value), 0.0\n            if isinstance(value, (list, tuple)) and len(value) == 2:\n                a, b = value\n                if self.is_numeric(a) and self.is_numeric(b):\n                    return float(a), float(b)\n                raise InvalidComplexError(\"Sequence elements must be numeric\")\n            if isinstance(value, str):\n                try:\n                    c = complex(value.strip())\n                    return float(c.real), float(c.imag)\n                except Exception as exc:\n                    raise InvalidComplexError(\"Invalid complex string\") from exc\n            raise InvalidComplexError(\"Unsupported input type\")\n\n    class ConverterService:\n        def __init__(self, validator: Validator | None = None) -> None:\n            self._validator = validator or Validator()\n\n        def convert(self, value: object) -> tuple[float, float]:\n            real, imag = self._validator.to_components(value)\n            polar = self._compute_polar(real, imag)\n            return polar.as_tuple()\n\n        def _compute_polar(self, real: float, imag: float) -> PolarCoordinate:\n            r = float(math.hypot(real, imag))\n            theta = float(math.atan2(imag, real))\n            return PolarCoordinate(r=r, theta=theta)\n\n    service = ConverterService()\n    return service.convert(value)"}
{"task_id": "Mbpp/256", "solution": "def count_Primes_nums(n: int) -> int:\n    \"\"\"\n    Count the number of prime numbers strictly less than n.\n\n    Parameters\n    ----------\n    n : int\n        A non-negative integer.\n\n    Returns\n    -------\n    int\n        Number of primes p such that 2 <= p < n.\n\n    Raises\n    ------\n    ValueError\n        If n is not an integer or is negative.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input must be an integer\")\n    if n < 0:\n        raise ValueError(\"Input must be non-negative\")\n\n    if n <= 2:\n        return 0\n\n    sieve = bytearray(n)  # 0 = potential prime, 1 = composite/not prime\n    sieve[0] = 1\n    sieve[1] = 1\n\n    limit = int(n**0.5) + 1\n    for p in range(2, limit):\n        if sieve[p] == 0:\n            start = p * p\n            if start >= n:\n                continue\n            step = p\n            count = (n - 1 - start) // step + 1\n            sieve[start:n:step] = b'\\x01' * count\n\n    return sieve.count(0)"}
