{"task_id": "Mbpp/475", "solution": "from typing import Any, Dict, List, Tuple, Union\n\nNumber = Union[int, float]\n\ndef sort_counter(mapping: Dict[Any, Number]) -> List[Tuple[Any, Number]]:\n    \"\"\"Sorts a dictionary by its values in descending order.\"\"\"\n    return sorted(mapping.items(), key=lambda item: item[1], reverse=True)"}
{"task_id": "Mbpp/478", "solution": "def remove_lowercase(s: str) -> str:\n    \"\"\"\n    Remove contiguous ASCII lowercase substrings from the input string.\n\n    Example:\n        remove_lowercase(\"PYTHon\") -> \"PYTH\"\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"s must be a str\")\n\n    res_chars: list[str] = []\n    i = 0\n    n = len(s)\n    while i < n:\n        ch = s[i]\n        if 'a' <= ch <= 'z':\n            # skip contiguous ASCII-lowercase run\n            i += 1\n            while i < n and 'a' <= s[i] <= 'z':\n                i += 1\n            continue\n        res_chars.append(ch)\n        i += 1\n    return \"\".join(res_chars)"}
{"task_id": "Mbpp/479", "solution": "def first_Digit(num):\n    \"\"\"Extracts the first (most significant) digit of a number, ignoring its sign and fractional part.\"\"\"\n    # Convert the input to its absolute integer part as a string.\n    # This handles integers, floats, and numeric strings, effectively removing signs and decimal components.\n    s_num = str(int(abs(float(num))))\n    # The first character of this string is the desired first digit.\n    return int(s_num[0])"}
{"task_id": "Mbpp/554", "solution": "def Split(lst: list[int]) -> list[int]:\n    \"\"\"Returns a new list containing only the odd integers from the input list.\n    The order of the odd integers is preserved from the original list.\"\"\"\n    return [item for item in lst if item % 2 != 0]"}
{"task_id": "Mbpp/555", "solution": "def difference(n: int) -> int:\n    \"\"\"\n    Compute the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers.\n\n    Formula:\n      sum_1_to_n = n*(n+1)//2\n      sum_cubes = (sum_1_to_n) ** 2\n      difference = sum_cubes - sum_1_to_n\n\n    Raises:\n      TypeError: if n is not an int\n      ValueError: if n < 1\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n < 1:\n        raise ValueError(\"n must be >= 1\")\n\n    s = n * (n + 1) // 2\n    return s * s - s"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(arr, n):\n    \"\"\"Counts the number of pairs in the array whose XOR value is odd.\n    An XOR of two integers is odd iff one is even and the other is odd.\n    \"\"\"\n    odd_count = 0\n    even_count = 0\n    for x in arr:\n        if x % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n    return odd_count * even_count"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(text: str) -> str:\n    \"\"\"\n    Toggles the case of all alphabetic characters in a string.\n    Other characters remain unchanged.\n    \"\"\"\n    toggled_chars = []\n    for char in text:\n        if char.isupper():\n            toggled_chars.append(char.lower())\n        elif char.islower():\n            toggled_chars.append(char.upper())\n        else:\n            toggled_chars.append(char)\n    return \"\".join(toggled_chars)"}
{"task_id": "Mbpp/558", "solution": "import re\n\nclass DigitDistanceError(Exception):\n    \"\"\"Custom exception for errors during digit distance calculation.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\ndef _is_valid_int_literal(value: int | str) -> bool:\n    \"\"\"Checks if a value is an integer or a string representing one.\"\"\"\n    if isinstance(value, int):\n        return True\n    if isinstance(value, str):\n        return re.fullmatch(r'^[+-]?\\d+$', value) is not None\n    return False\n\ndef _strip_sign(value_str: str) -> str:\n    \"\"\"Strips an optional leading sign from a string.\"\"\"\n    if not value_str:\n        return \"\"\n    if value_str[0] in ('+', '-'):\n        return value_str[1:]\n    return value_str\n\ndef _to_absolute_digit_string(value: int | str) -> str:\n    \"\"\"Converts int/str to an absolute digit string, validating its content.\"\"\"\n    s_val = str(value)\n    stripped_s_val = _strip_sign(s_val)\n    if not stripped_s_val.isdigit():\n        raise DigitDistanceError(f\"Input '{value}' contains invalid characters or is empty after sign processing.\")\n    return stripped_s_val\n\ndef _normalize_and_pad_digit_strings(s_a_abs: str, s_b_abs: str) -> tuple[str, str]:\n    \"\"\"Pads two absolute digit strings with leading zeros to equal length.\"\"\"\n    max_len = max(len(s_a_abs), len(s_b_abs))\n    return s_a_abs.zfill(max_len), s_b_abs.zfill(max_len)\n\ndef _calculate_digit_differences(s1: str, s2: str) -> int:\n    \"\"\"Calculates the sum of absolute per-digit differences between two equal-length digit strings.\"\"\"\n    total_diff = 0\n    for digit1_char, digit2_char in zip(s1, s2):\n        total_diff += abs(int(digit1_char) - int(digit2_char))\n    return total_diff\n\ndef digit_distance_nums(a: int | str, b: int | str) -> int:\n    \"\"\"\n    Computes the sum of per-digit absolute differences between two integers.\n    Compares magnitudes, ignoring signs, and pads the shorter number with leading zeros.\n    \"\"\"\n    if not _is_valid_int_literal(a):\n        raise DigitDistanceError(f\"Invalid input 'a': '{a}' is not a valid integer literal.\")\n    if not _is_valid_int_literal(b):\n        raise DigitDistanceError(f\"Invalid input 'b': '{b}' is not a valid integer literal.\")\n\n    s_a_abs = _to_absolute_digit_string(a)\n    s_b_abs = _to_absolute_digit_string(b)\n\n    padded_s_a, padded_s_b = _normalize_and_pad_digit_strings(s_a_abs, s_b_abs)\n\n    return _calculate_digit_differences(padded_s_a, padded_s_b)"}
{"task_id": "Mbpp/560", "solution": "def union_elements(a, b):\n    \"\"\"\n    Finds the union of elements from two tuples and returns them in sorted order as a tuple.\n    Duplicates are removed and the resulting elements are sorted.\n    \"\"\"\n    union_set = set(a) | set(b)\n    sorted_elements = sorted(list(union_set))\n    return tuple(sorted_elements)"}
{"task_id": "Mbpp/564", "solution": "def count_Pairs(arr, n):\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if arr is None:\n        raise ValueError(\"arr must not be None\")\n    try:\n        length = len(arr)\n    except TypeError:\n        raise TypeError(\"arr must be a sequence or iterable with a length\")\n    if length != n:\n        raise ValueError(\"n does not match length of arr\")\n    if n < 2:\n        return 0\n    from collections import Counter\n    freq = Counter(arr)\n    total_pairs = n * (n - 1) // 2\n    equal_pairs = sum(c * (c - 1) // 2 for c in freq.values())\n    return total_pairs - equal_pairs"}
{"task_id": "Mbpp/562", "solution": "class InvalidInputError(Exception):\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\n\n    def __str__(self) -> str:\n        return self.message\n\nALLOW_TUPLES = True\n\nclass InputValidator:\n    def validate(self, raw) -> list[list]:\n        if not isinstance(raw, list):\n            raise InvalidInputError(\"Top-level input must be a list of lists.\")\n        normalized = []\n        for idx, item in enumerate(raw):\n            if self._is_list_like(item):\n                normalized.append(list(item))\n            else:\n                raise InvalidInputError(f\"Element at index {idx} is not a list/tuple.\")\n        return normalized\n\n    def _is_list_like(self, obj) -> bool:\n        if isinstance(obj, list):\n            return True\n        if ALLOW_TUPLES and isinstance(obj, tuple):\n            return True\n        return False\n\nclass ListAnalyzer:\n    def find_max_length(self, lists: list[list]) -> int:\n        if not lists:\n            return 0\n        max_len = 0\n        for sub in lists:\n            length = self._length_of(sub)\n            if length > max_len:\n                max_len = length\n        return max_len\n\n    def _length_of(self, sublist: list) -> int:\n        return len(sublist)\n\ndef Find_Max_Length(lists):\n    \"\"\"\n    Convenience function: validate and compute max sublist length.\n    \"\"\"\n    validated = InputValidator().validate(lists)\n    return ListAnalyzer().find_max_length(validated)"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(arr, n):\n    \"\"\"\n    Finds the sum of the largest contiguous sublist using Kadane's algorithm.\n    This implementation correctly handles lists containing all negative numbers.\n    \"\"\"\n    if not isinstance(arr, (list, tuple)):\n        raise TypeError(\"arr must be a list or tuple of integers\")\n    if len(arr) == 0:\n        raise ValueError(\"arr must not be empty\")\n    # Optionally validate n (not used for computation here, but keep signature)\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    # Use Kadane's algorithm\n    max_so_far = arr[0]\n    current_max = arr[0]\n\n    for i in range(1, len(arr)):\n        x = arr[i]\n        current_max = x if current_max + x < x else current_max + x\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
{"task_id": "Mbpp/563", "solution": "def extract_values(s: str) -> list:\n    \"\"\"\n    Extract substrings enclosed in single or double quotation marks from `s`.\n    Handles escaped quotes (\\\" and \\') and escaped backslashes (\\\\) inside quoted regions.\n    Unmatched/unfinished quoted regions are ignored.\n\n    Example:\n        assert extract_values('\"Python\", \"PHP\", \"Java\"') == ['Python', 'PHP', 'Java']\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"s must be a str\")\n\n    results: list = []\n    i = 0\n    n = len(s)\n    while i < n:\n        ch = s[i]\n        if ch == '\"' or ch == \"'\":\n            quote = ch\n            i += 1\n            buf = []\n            while i < n:\n                c = s[i]\n                if c == \"\\\\\":\n                    # Escape handling: if next char exists, handle it\n                    if i + 1 < n:\n                        nxt = s[i + 1]\n                        # Unescape only quote char and backslash; preserve other escapes (keep backslash + char)\n                        if nxt == quote or nxt == \"\\\\\":\n                            buf.append(nxt)\n                        else:\n                            buf.append(\"\\\\\" + nxt)\n                        i += 2\n                        continue\n                    else:\n                        # Trailing backslash, treat as literal\n                        buf.append(\"\\\\\")\n                        i += 1\n                        continue\n                if c == quote:\n                    i += 1\n                    # closed quote, append token\n                    results.append(\"\".join(buf))\n                    break\n                # normal character inside quotes\n                buf.append(c)\n                i += 1\n            else:\n                # EOF reached without closing quote: ignore this unfinished token (non-strict behavior)\n                # Move on without adding buf to results\n                continue\n        else:\n            i += 1\n    return results"}
{"task_id": "Mbpp/565", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input types.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nDEFAULT_ERROR_MSG = \"Input must be a str\"\n\nclass StringValidator:\n    \"\"\"Validates if the input is a string.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def validate(self, s: any) -> None:\n        \"\"\"Raises InvalidInputError if s is not a string.\"\"\"\n        if not isinstance(s, str):\n            raise InvalidInputError(DEFAULT_ERROR_MSG)\n\nclass CharSplitter:\n    \"\"\"Core logic to split a string into characters.\"\"\"\n    def __init__(self, validator: StringValidator) -> None:\n        self._validator = validator\n\n    def split(self, s: str) -> list[str]:\n        \"\"\"Validates input and returns a list of characters.\"\"\"\n        self._validator.validate(s)\n        chars = self._split_codepoints(s)\n        return chars\n\n    def _split_codepoints(self, s: str) -> list[str]:\n        \"\"\"Splits a string into a list of its codepoint characters.\"\"\"\n        return [c for c in s]\n\nclass SplitController:\n    \"\"\"Orchestrates validation and splitting for API consumers.\"\"\"\n    def __init__(self, splitter: CharSplitter) -> None:\n        self._splitter = splitter\n\n    def split(self, s: str) -> list[str]:\n        \"\"\"Delegates to the CharSplitter to perform the split.\"\"\"\n        return self._splitter.split(s)\n\ndef split(s: str) -> list[str]:\n    \"\"\"Splits a string into a list of its codepoint characters.\"\"\"\n    validator = StringValidator()\n    splitter = CharSplitter(validator)\n    controller = SplitController(splitter)\n    return controller.split(s)"}
{"task_id": "Mbpp/566", "solution": "def sum_digits(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the digits of a non-negative integer.\n    The input `n` is assumed to be a non-negative integer.\n    \"\"\"\n    total = 0\n    while n:\n        total += n % 10\n        n //= 10\n    return total"}
