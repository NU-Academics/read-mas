{"task_id": "Mbpp/62", "solution": "import math\nfrom typing import Sequence, Any, List, Union\n\nNumber = Union[int, float]\n\nclass InvalidListError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass InvalidElementError(Exception):\n    def __init__(self, message: str, index: int) -> None:\n        super().__init__(message)\n        self.message = message\n        self.index = index\n\ndef is_number(value: Any) -> bool:\n    \"\"\"Returns True if value is an int or float and not NaN.\"\"\"\n    if isinstance(value, (int, float)):\n        if isinstance(value, float) and math.isnan(value):\n            return False\n        return True\n    return False\n\nclass ListValidator:\n    \"\"\"Validates input lists and element types.\"\"\"\n    def validate(self, numbers: Sequence[Any]) -> List[Number]:\n        if not hasattr(numbers, \"__iter__\"):\n            raise InvalidListError(\"Input must be a sequence\")\n        nums = list(numbers)\n        if len(nums) == 0:\n            raise InvalidListError(\"Input sequence must not be empty\")\n        for i, v in enumerate(nums):\n            if not is_number(v):\n                raise InvalidElementError(f\"Element at index {i} is not numeric\", i)\n        return nums\n\nclass NumberFinderService:\n    \"\"\"Core algorithm to find the smallest number.\"\"\"\n    def find_smallest(self, numbers: Sequence[Number]) -> Number:\n        # Assumes numbers is non-empty and contains only numeric values.\n        it = iter(numbers)\n        best = next(it)\n        for v in it:\n            if v < best:\n                best = v\n        return best\n\nclass APIController:\n    \"\"\"Orchestrates between validator and service for the public API.\"\"\"\n    def __init__(self, validator: ListValidator = None, service: NumberFinderService = None):\n        self.validator = validator or ListValidator()\n        self.service = service or NumberFinderService()\n\n    def smallest_num(self, numbers: Sequence[Any]) -> Number:\n        validated = self.validator.validate(numbers)\n        return self.service.find_smallest(validated)\n\n_api_controller_instance = APIController()\n\ndef smallest_num(numbers: Sequence[Any]) -> Number:\n    \"\"\"Programmatic API: returns smallest number in numbers, performing validation.\"\"\"\n    return _api_controller_instance.smallest_num(numbers)"}
{"task_id": "Mbpp/65", "solution": "import numbers\n\ndef recursive_list_sum(data):\n    \"\"\"Recursively flattens a list-like structure and sums all numeric elements found within it.\"\"\"\n    total = 0\n    for item in data:\n        if isinstance(item, (list, tuple)):\n            total += recursive_list_sum(item)\n        elif isinstance(item, numbers.Number):\n            total += item\n    return total"}
{"task_id": "Mbpp/66", "solution": "def pos_count(numbers):\n    \"\"\"Counts the number of positive numbers in a given list.\n    A number is considered positive if it is strictly greater than zero.\n    \"\"\"\n    count = 0\n    for num in numbers:\n        if num > 0:\n            count += 1\n    return count"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(arr):\n    \"\"\"\n    Checks if an array is monotonic (either non-increasing or non-decreasing).\n    An array with less than two elements is considered monotonic.\n    \"\"\"\n    if len(arr) < 2:\n        return True\n\n    is_non_decreasing = True\n    is_non_increasing = True\n\n    for i in range(1, len(arr)):\n        if arr[i] > arr[i - 1]:\n            is_non_increasing = False\n        elif arr[i] < arr[i - 1]:\n            is_non_decreasing = False\n\n        # If both flags are false, it's neither non-decreasing nor non-increasing\n        if not is_non_decreasing and not is_non_increasing:\n            return False\n\n    return True"}
{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    \"\"\"\n    Computes the nth Bell number using an iterative Bell triangle approach.\n    The Bell number B(n) represents the number of ways to partition a set of n elements.\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n    if n == 0:\n        return 1\n\n    # Initialize the first row of the Bell triangle, which corresponds to B(0) = 1\n    row = [1]\n\n    # Build rows up to n\n    for i in range(1, n + 1):\n        # First element of new row is last element of previous row\n        new_row = [row[-1]]\n        for j in range(1, i + 1):\n            new_row.append(new_row[-1] + row[j - 1])\n        row = new_row\n\n    # The Bell number B(n) is the first element of the nth row\n    return row[0]"}
{"task_id": "Mbpp/71", "solution": "from .sort_service import SortService\nfrom .comb_sort_algorithm import CombSortAlgorithm\nfrom typing import Sequence, TypeVar, List\n\nT = TypeVar(\"T\")\n\ndef comb_sort(values: Sequence[T]) -> List[T]:\n    \"\"\"Sorts a sequence of comparable elements using the Comb Sort algorithm.\n    This function delegates the sorting and validation to the SortService.\n    \"\"\"\n    service = SortService(algorithm=CombSortAlgorithm())\n    return service.sort(values)"}
{"task_id": "Mbpp/70", "solution": "def get_equal(data):\n    \"\"\"\n    Checks if all tuples in the given iterable have the same length.\n    An empty iterable or an iterable with a single tuple returns True.\n    \"\"\"\n    items = list(data)\n    n = len(items)\n\n    if n <= 1:\n        return True\n\n    lengths = [len(t) for t in items]\n    return min(lengths) == max(lengths)"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(seq, sub):\n    \"\"\"Checks if 'sub' is a contiguous sublist within 'seq' using the KMP algorithm.\"\"\"\n\n    def build_lps(pattern):\n        \"\"\"Builds the longest proper prefix suffix array for the KMP algorithm.\"\"\"\n        lps = [0] * len(pattern)\n        length = 0\n        i = 1\n        while i < len(pattern):\n            if pattern[i] == pattern[length]:\n                length += 1\n                lps[i] = length\n                i += 1\n            else:\n                if length:\n                    length = lps[length - 1]\n                else:\n                    lps[i] = 0\n                    i += 1\n        return lps\n\n    if not sub:\n        return True\n    if len(sub) > len(seq):\n        return False\n\n    lps = build_lps(sub)\n    i = 0  # index for seq\n    j = 0  # index for sub\n\n    while i < len(seq):\n        if seq[i] == sub[j]:\n            i += 1\n            j += 1\n            if j == len(sub):\n                return True\n        else:\n            if j != 0:\n                j = lps[j - 1]\n            else:\n                i += 1\n    return False"}
