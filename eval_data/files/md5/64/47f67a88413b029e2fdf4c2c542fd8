{"task_id": "Mbpp/739", "solution": "import math\n\nclass MathRepository:\n    \"\"\"Provides integer-safe math primitives using the standard math library.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def isqrt(self, n: int) -> int:\n        \"\"\"Computes the integer square root of n, returning floor(sqrt(n)).\"\"\"\n        return math.isqrt(n)\n\n    def triangular_number(self, k: int) -> int:\n        \"\"\"Computes the k-th triangular number, T_k = k*(k+1)/2.\"\"\"\n        return k * (k + 1) // 2\n\nclass IndexResult:\n    \"\"\"Data transfer object containing the number of digits, the index, and the triangular number itself.\"\"\"\n    def __init__(self, digits: int, index: int, triangular: int) -> None:\n        self.digits = digits\n        self.index = index\n        self.triangular = triangular\n\nclass TriangularService:\n    \"\"\"Encapsulates the core logic to determine the minimal index for an n-digit triangular number.\"\"\"\n    def __init__(self, repo: MathRepository = None) -> None:\n        self.repo = repo or MathRepository()\n\n    def find_index_for_digits(self, n: int) -> IndexResult:\n        \"\"\"Finds the index of the smallest triangular number that has exactly n digits.\"\"\"\n        BASE = 10\n        # The smallest n-digit number is 10^(n-1). This is our threshold.\n        threshold = BASE ** (n - 1)\n        k = self._solve_quadratic_min_k_for_threshold(threshold)\n        tri = self.repo.triangular_number(k)\n        return IndexResult(digits=n, index=k, triangular=tri)\n\n    def _solve_quadratic_min_k_for_threshold(self, threshold: int) -> int:\n        \"\"\"\n        Solves the inequality k(k+1)/2 >= threshold for the minimal integer k.\n        This approximates k by solving the quadratic equation k^2 + k - 2*threshold = 0\n        and taking the ceiling of the positive root using integer arithmetic.\n        \"\"\"\n        # The positive root is (-1 + sqrt(1 + 8*threshold)) / 2\n        # We calculate s = floor(sqrt(1 + 8*threshold))\n        s = self.repo.isqrt(1 + 8 * threshold)\n\n        # Calculate ceil((-1 + s) / 2) using integer division\n        # (s - 1) // 2 will give floor. If (s - 1) is odd, we need to add 1 to get ceil.\n        k = (s - 1) // 2\n        if (s - 1) % 2 != 0:\n            k += 1 # Equivalent to ceil for positive (s-1)/2\n\n        # A final check to ensure the calculated k satisfies the condition,\n        # incrementing if necessary (e.g., due to approximations or edge cases\n        # where floor of root might result in T_k being slightly too small).\n        while self.repo.triangular_number(k) < threshold:\n            k += 1\n        return k\n\ndef find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with n digits.\n    It calls a service layer to perform the core calculation.\n    \"\"\"\n    svc = TriangularService()\n    result = svc.find_index_for_digits(n)\n    return result.index"}
