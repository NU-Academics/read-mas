{"task_id": "Mbpp/282", "solution": "from typing import List, Sequence\n\ndef sub_list(a: Sequence[float], b: Sequence[float]) -> List[float]:\n    \"\"\"\n    Subtracts two lists element-wise, returning a new list with the results.\n    Assumes inputs are sequences of numbers of equal length.\n    \"\"\"\n    result: List[float] = []\n    for i in range(len(a)):\n        result.append(float(a[i]) - float(b[i]))\n    return result"}
{"task_id": "Mbpp/283", "solution": "def validate(integer: int) -> bool:\n    \"\"\"\n    Checks if the frequency of each digit in the integer is less than or equal to the digit itself.\n    The absolute value of the integer is used for validation.\n    \"\"\"\n    num_str = str(abs(integer))\n\n    digit_frequencies = {}\n    for char_digit in num_str:\n        digit_frequencies[char_digit] = digit_frequencies.get(char_digit, 0) + 1\n\n    for char_digit, frequency in digit_frequencies.items():\n        digit_value = int(char_digit)\n        if frequency > digit_value:\n            return False\n\n    return True"}
{"task_id": "Mbpp/285", "solution": "import re\n\ndef text_match_two_three(text: str) -> bool:\n    \"\"\"\n    Checks if the input string contains the pattern 'a' followed by two or three 'b' characters.\n    This function performs a case-sensitive search for \"abb\" or \"abbb\".\n    \"\"\"\n    # The regular expression r'ab{2,3}' matches 'a' followed by two or three 'b's.\n    # re.search returns a match object if the pattern is found anywhere in the string, otherwise None.\n    return re.search(r'ab{2,3}', text) is not None"}
{"task_id": "Mbpp/284", "solution": "def check_element(items, element):\n    \"\"\"\n    Checks if all items in the list are equal to the given element.\n    Returns True for an empty list.\n    \"\"\"\n    for item in items:\n        if not (item == element):\n            return False\n    return True"}
{"task_id": "Mbpp/287", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of squares of the first n even natural numbers using a closed-form formula.\n    The formula is (2 * n * (n + 1) * (2 * n + 1)) // 3.\n\n    Example:\n    - n = 1 -> 2^2 = 4\n    - n = 2 -> 2^2 + 4^2 = 4 + 16 = 20\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    # 4 * sum_{k=1..n} k^2 = (4 * n * (n + 1) * (2*n + 1)) // 6\n    # Simplified integer form:\n    return (2 * n * (n + 1) * (2 * n + 1)) // 3"}
{"task_id": "Mbpp/286", "solution": "from typing import List\n\ndef max_sub_array_sum_repeated(arr: List[int], n: int, k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous array in the modified array\n    formed by repeating the given array k times.\n    \"\"\"\n    if n != len(arr):\n        raise ValueError(\"n must equal len(arr)\")\n    if k < 1:\n        raise ValueError(\"k must be >= 1\")\n    if not arr:\n        raise ValueError(\"arr must be non-empty\")\n\n    def kadane(current_arr: List[int]) -> int:\n        \"\"\"Applies Kadane's algorithm to find the maximum contiguous subarray sum.\"\"\"\n        max_ending_here = current_arr[0]\n        max_so_far = current_arr[0]\n        for x in current_arr[1:]:\n            max_ending_here = max(x, max_ending_here + x)\n            max_so_far = max(max_so_far, max_ending_here)\n        return max_so_far\n\n    def max_prefix_sum(current_arr: List[int]) -> int:\n        \"\"\"Calculates the maximum sum of any prefix subarray.\"\"\"\n        current_sum = 0\n        max_p_sum = float('-inf')\n        for x in current_arr:\n            current_sum += x\n            max_p_sum = max(max_p_sum, current_sum)\n        return max_p_sum\n\n    def max_suffix_sum(current_arr: List[int]) -> int:\n        \"\"\"Calculates the maximum sum of any suffix subarray.\"\"\"\n        current_sum = 0\n        max_s_sum = float('-inf')\n        for x in reversed(current_arr):\n            current_sum += x\n            max_s_sum = max(max_s_sum, current_sum)\n        return max_s_sum\n\n    total_array_sum = sum(arr)\n\n    if k == 1:\n        return kadane(arr)\n    else:\n        # Candidate 1: Max subarray sum within the first two concatenations.\n        double_arr = arr + arr\n        candidate1 = kadane(double_arr)\n\n        # Candidate 2: Max subarray sum extending across 'k-2' full repetitions,\n        # plus a prefix from the first `arr` and a suffix from the last `arr`.\n        if total_array_sum > 0:\n            prefix_sum = max_prefix_sum(arr)\n            suffix_sum = max_suffix_sum(arr)\n            candidate2 = suffix_sum + prefix_sum + (k - 2) * total_array_sum\n            return max(candidate1, candidate2)\n        else:\n            # If the total sum is non-positive, repeating more won't help beyond two concatenations.\n            return candidate1"}
{"task_id": "Mbpp/290", "solution": "def max_length(lists):\n    \"\"\"Finds the list with the maximum length in a list of lists.\n    Returns a tuple of the maximum length and the first encountered longest list.\"\"\"\n    if not lists:\n        return (0, [])\n\n    best_list = lists[0]\n    max_len = len(best_list)\n\n    for candidate_list in lists[1:]:\n        current_len = len(candidate_list)\n        if current_len > max_len:\n            max_len = current_len\n            best_list = candidate_list\n\n    return (max_len, best_list)"}
{"task_id": "Mbpp/292", "solution": "import dataclasses\nimport math\nimport numbers\nimport sys\nfrom typing import Tuple, Optional, Union\n\n# --- Exceptions ---\nclass ValidationError(Exception):\n    \"\"\"Exception raised when input values are invalid.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\nclass DivisionByZeroError(Exception):\n    \"\"\"Exception raised when division by zero is attempted.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\n# --- Models ---\n@dataclasses.dataclass\nclass QuotientResult:\n    \"\"\"Data model to store the result of a quotient calculation.\"\"\"\n    dividend: float\n    divisor: float\n    quotient: int\n\n    def to_dict(self) -> dict[str, object]:\n        \"\"\"Returns a serializable dictionary representation of the result.\"\"\"\n        return {\n            \"dividend\": self.dividend,\n            \"divisor\": self.divisor,\n            \"quotient\": self.quotient,\n        }\n\n# --- Utils ---\nclass InputValidator:\n    \"\"\"Utility to parse and validate raw input values.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def _to_number(self, value: object) -> float:\n        \"\"\"Converts an object to a float, raising ValidationError if unsuccessful.\"\"\"\n        if isinstance(value, numbers.Number):\n            return float(value)\n        if isinstance(value, str):\n            try:\n                return float(value)\n            except ValueError:\n                pass\n        raise ValidationError(f\"Invalid input: '{value}' must be a numeric value.\")\n\n    def parse_and_validate(self, dividend_raw: object, divisor_raw: object) -> Tuple[float, float]:\n        \"\"\"Parses and validates the raw dividend and divisor, returning them as floats.\"\"\"\n        dividend = self._to_number(dividend_raw)\n        divisor = self._to_number(divisor_raw)\n        return dividend, divisor\n\n# --- Adapters ---\nclass LoggingAdapter:\n    \"\"\"A simple adapter for logging operation details.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def log_operation(self, result: QuotientResult) -> None:\n        \"\"\"Logs the operation details (dividend, divisor, quotient) to stderr.\"\"\"\n        print(f\"INFO: Operation: dividend={result.dividend}, divisor={result.divisor}, quotient={result.quotient}\", file=sys.stderr)\n\n# --- Services ---\nclass FinderService:\n    \"\"\"Encapsulates the business logic for computing the floor quotient.\"\"\"\n    def __init__(self, logger: Optional[LoggingAdapter] = None) -> None:\n        self.logger = logger\n\n    def compute(self, dividend: float, divisor: float) -> QuotientResult:\n        \"\"\"Calculates the floor of dividend / divisor. Raises DivisionByZeroError if divisor is zero.\"\"\"\n        if divisor == 0:\n            raise DivisionByZeroError(\"Divisor must not be zero.\")\n\n        quotient = math.floor(dividend / divisor)\n        result = QuotientResult(dividend=dividend, divisor=divisor, quotient=int(quotient))\n\n        if self.logger:\n            self.logger.log_operation(result)\n        return result\n\n# --- Controllers ---\nclass DividerController:\n    \"\"\"Orchestrates input validation and delegates computation to the service.\"\"\"\n    def __init__(self, validator: InputValidator, service: FinderService, logger: Optional[LoggingAdapter] = None) -> None:\n        self.validator = validator\n        self.service = service\n        self.logger = logger\n\n    def handle(self, dividend_raw: object, divisor_raw: object) -> QuotientResult:\n        \"\"\"Validates inputs, computes the quotient, and returns the result.\"\"\"\n        dividend, divisor = self.validator.parse_and_validate(dividend_raw, divisor_raw)\n        result = self.service.compute(dividend, divisor)\n        return result\n\n# --- Public API Function ---\ndef find(dividend: Union[float, int], divisor: Union[float, int]) -> int:\n    \"\"\"\n    Finds the quotient of two numbers, rounded down to the nearest integer.\n    Internally handles input validation and division by zero exceptions.\n    \"\"\"\n    validator = InputValidator()\n    logger = LoggingAdapter()\n    service = FinderService(logger=logger)\n    controller = DividerController(validator=validator, service=service, logger=logger)\n    result = controller.handle(dividend, divisor)\n    return result.quotient"}
