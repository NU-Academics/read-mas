{"task_id": "Mbpp/98", "solution": "def multiply_num(numbers):\n    \"\"\"\n    Multiply all numbers in an iterable and divide the product by the iterable's length.\n\n    Args:\n        numbers: An iterable of numeric values (int, float, or numeric strings).\n\n    Returns:\n        float: (product of elements) / (number of elements)\n\n    Raises:\n        ValueError: If 'numbers' is empty or contains non-numeric values.\n    \"\"\"\n    nums = list(numbers)\n    if len(nums) == 0:\n        raise ValueError(\"numbers must contain at least one element\")\n\n    product = 1.0\n    for i, n in enumerate(nums):\n        try:\n            product *= float(n)\n        except (TypeError, ValueError):\n            raise ValueError(f\"Element at index {i} is not numeric: {n!r}\")\n    return product / len(nums)"}
{"task_id": "Mbpp/96", "solution": "def divisor(n: int) -> int:\n    \"\"\"\n    Calculates the number of positive divisors for a given integer.\n    Handles negative numbers by using their absolute value.\n    \"\"\"\n\n    def _factorize_positive(num: int) -> dict:\n        \"\"\"\n        Finds the prime factorization of a positive integer.\n        Returns a dictionary where keys are prime factors and values are their exponents.\n        \"\"\"\n        factors = {}\n        if num == 1:\n            return factors\n\n        d = 2\n        temp_num = num\n        while d * d <= temp_num:\n            while temp_num % d == 0:\n                factors[d] = factors.get(d, 0) + 1\n                temp_num //= d\n            d += 1 if d == 2 else 2\n\n        if temp_num > 1:\n            factors[temp_num] = factors.get(temp_num, 0) + 1\n\n        return factors\n\n    # Use the absolute value of n for divisor calculation as per design context.\n    n_abs = abs(n)\n\n    # Handle the special case for 1 (which has 1 divisor: itself).\n    if n_abs == 1:\n        return 1\n\n    # Get the prime factorization of n_abs.\n    # The constraint \"Do NOT add isinstance() checks or raise exceptions for edge cases\"\n    # implies that `n=0` will not be explicitly handled as an error here.\n    # The factorization for `n_abs=0` would result in an empty dict, returning 1 divisor.\n    prime_exponents = _factorize_positive(n_abs)\n\n    # Calculate the total number of divisors using the formula:\n    # (e1 + 1) * (e2 + 1) * ... * (ek + 1)\n    total_divisors = 1\n    for exponent in prime_exponents.values():\n        total_divisors *= (exponent + 1)\n\n    return total_divisors"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(n: int) -> str:\n    \"\"\"\n    Convert a non-negative integer to its binary representation as a string\n    with no leading zeros. Returns '0' for input 0.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    if n == 0:\n        return '0'\n\n    bits = []\n    while n:\n        bits.append('1' if (n & 1) else '0')\n        n >>= 1\n    return ''.join(reversed(bits))"}
{"task_id": "Mbpp/101", "solution": "def kth_element(arr, k):\n    \"\"\"\n    Finds the kth element in the given array using 1-based indexing.\n\n    Parameters:\n    - arr: sequence (e.g., list) of elements\n    - k: 1-based index (int)\n\n    Returns:\n    - The element at position k (1-based).\n\n    Raises:\n    - TypeError: if k is not an int or arr is not indexable\n    - IndexError: if k is out of range\n    \"\"\"\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an integer\")\n    try:\n        return arr[k - 1]\n    except TypeError:\n        raise TypeError(\"arr must be an indexable sequence\")\n    except IndexError:\n        raise IndexError(\"k is out of range\")"}
{"task_id": "Mbpp/102", "solution": "def snake_to_camel(s: str) -> str:\n    \"\"\"Converts a snake_case string to CamelCase (PascalCase).\"\"\"\n    if s is None:\n        raise TypeError(\"Input cannot be None\")\n    s = str(s)\n    if s == \"\":\n        return \"\"\n\n    parts = s.split(\"_\")\n    camel_case_parts = []\n\n    for part in parts:\n        if part:  # Ignore empty parts from consecutive/leading/trailing underscores\n            # Capitalize first alphabetic character and lowercase alphabetic rest.\n            # Preserve non-letter characters in place.\n            first = \"\"\n            rest = \"\"\n            for i, ch in enumerate(part):\n                if ch.isalpha():\n                    first = ch.upper()\n                    rest = part[i + 1 :].lower()\n                    # include any preceding non-letter characters before the first letter\n                    prefix = part[:i]\n                    camel_case_parts.append(prefix + first + rest)\n                    break\n            else:\n                # no alphabetic character in part; preserve as-is\n                camel_case_parts.append(part)\n\n    return \"\".join(camel_case_parts)"}
{"task_id": "Mbpp/103", "solution": "def eulerian_num(n, m):\n    \"\"\"\n    Computes the Eulerian number A(n, m), representing the number of permutations\n    of {1, ..., n} with exactly m ascents.\n    \"\"\"\n    memo = {}\n\n    def _eulerian(n_val, m_val):\n        # Check memoization table\n        if (n_val, m_val) in memo:\n            return memo[(n_val, m_val)]\n\n        # Base cases\n        if n_val == 0:\n            result = 1 if m_val == 0 else 0\n        elif m_val < 0 or m_val >= n_val:\n            result = 0\n        elif m_val == 0:\n            result = 1\n        else:\n            # Recurrence relation: A(n, m) = (m + 1) * A(n - 1, m) + (n - m) * A(n - 1, m - 1)\n            term1 = (m_val + 1) * _eulerian(n_val - 1, m_val)\n            term2 = (n_val - m_val) * _eulerian(n_val - 1, m_val - 1)\n            result = term1 + term2\n\n        memo[(n_val, m_val)] = result\n        return result\n\n    return _eulerian(n, m)"}
{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome strictly greater than the given integer n.\n    Handles negative numbers by treating them as their absolute value.\n    \"\"\"\n\n    def _strip_leading_zeros(s: str) -> str:\n        \"\"\"Removes leading zeros from a numeric string, returning '0' if all zeros.\"\"\"\n        s2 = s.lstrip('0')\n        return s2 if s2 != '' else '0'\n\n    def _mirror_left_to_right_impl(base_str: str, has_middle_digit_in_base: bool) -> str:\n        \"\"\"\n        Forms a palindrome where `base_str` is its left part.\n        `has_middle_digit_in_base` indicates if `base_str` already contains the middle digit\n        of the resulting palindrome.\n        \"\"\"\n        if has_middle_digit_in_base:\n            # E.g., base_str = \"123\", middle='3', left=\"12\". Result \"12321\"\n            left_part = base_str[:-1]\n            middle_char = base_str[-1]\n            return left_part + middle_char + left_part[::-1]\n        else:\n            # E.g., base_str = \"12\", result \"1221\"\n            return base_str + base_str[::-1]\n\n    def _increment_middle_part(s_original: str) -> str:\n        \"\"\"\n        Increments the 'first half' of the string `s_original` (including middle digit for odd length).\n        Returns the resulting string which will be the new `base_str` for mirroring.\n        \"\"\"\n        n_orig = len(s_original)\n        # Length of the part to increment: left half + middle digit if n_orig is odd.\n        # E.g., for \"12345\" (n_orig=5), this is \"123\". For \"1234\" (n_orig=4), this is \"12\".\n        part_len_to_inc = (n_orig // 2) + (n_orig % 2)\n        s_part_to_inc = s_original[:part_len_to_inc]\n\n        incremented_val = int(s_part_to_inc) + 1\n        return str(incremented_val)\n\n    # Main function logic\n    n_int = abs(n)  # Business rule: negative inputs treated as absolute value\n    s = str(n_int)\n    s = _strip_leading_zeros(s)\n    length = len(s)\n\n    # Case 1: If the number consists of all '9's (e.g., 9, 99, 999),\n    # the next palindrome is '1' followed by (length-1) '0's and then '1' (e.g., 11, 101, 1001).\n    if set(s) == {'9'}:\n        return int('1' + ('0' * (length - 1)) + '1')\n\n    # Determine the 'base string' which is the left half of 's' (including the middle digit if length is odd).\n    # This `base_str_from_s` will be used to construct the first candidate palindrome.\n    base_str_from_s = s[:(length // 2) + (length % 2)]\n\n    # `is_original_base_odd` indicates if `base_str_from_s` itself has an odd number of digits.\n    # This is equivalent to `length % 2 == 1` for the original `s`.\n    is_original_base_odd = (length % 2 == 1)\n\n    # Construct the first candidate palindrome by mirroring `base_str_from_s`.\n    # This generates a palindrome of the *same length* as `s`.\n    mirrored_candidate = _mirror_left_to_right_impl(base_str_from_s, is_original_base_odd)\n\n    # If this candidate is strictly greater than the original number, it's the answer.\n    if int(mirrored_candidate) > n_int:\n        return int(mirrored_candidate)\n\n    # Otherwise (if `mirrored_candidate` <= `n_int`), we need to increment the middle part\n    # and then mirror again to find the next palindrome.\n    incremented_base = _increment_middle_part(s)\n\n    # Determine `has_middle_digit` for the final call to `_mirror_left_to_right_impl`.\n    final_has_middle_digit_in_base = (len(incremented_base) % 2 == 1)\n\n    final_result_str = _mirror_left_to_right_impl(incremented_base, final_has_middle_digit_in_base)\n    return int(final_result_str)"}
{"task_id": "Mbpp/104", "solution": "def sort_sublists(sublists):\n    \"\"\"Sorts each sublist of strings in a given list of lists.\"\"\"\n    sorted_outer_list = []\n    for inner_iterable in sublists:\n        # Convert each inner iterable to a list and then sort it lexicographically.\n        sorted_inner_list = sorted(list(inner_iterable))\n        sorted_outer_list.append(sorted_inner_list)\n    return sorted_outer_list"}
