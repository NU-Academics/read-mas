{"task_id": "Mbpp/296", "solution": "def get_Inv_Count(arr: list) -> int:\n    \"\"\"\n    Counts the number of inversions in an array using a merge-sort based algorithm.\n    An inversion occurs when i < j but arr[i] > arr[j].\n    \"\"\"\n\n    def _merge_count(left: list, right: list) -> tuple[list, int]:\n        \"\"\"\n        Merges two sorted lists and counts the number of inversions between them.\n        \"\"\"\n        i = j = 0\n        merged = []\n        inv_count = 0\n        while i < len(left) and j < len(right):\n            if left[i] <= right[j]:\n                merged.append(left[i])\n                i += 1\n            else:\n                merged.append(right[j])\n                j += 1\n                inv_count += len(left) - i\n        merged.extend(left[i:])\n        merged.extend(right[j:])\n        return merged, inv_count\n\n    def _split_count(current_arr: list) -> tuple[list, int]:\n        \"\"\"\n        Recursively splits the array, sorts it, and counts inversions.\n        \"\"\"\n        n = len(current_arr)\n        if n <= 1:\n            return current_arr, 0\n\n        mid = n // 2\n        left_half, left_inversions = _split_count(current_arr[:mid])\n        right_half, right_inversions = _split_count(current_arr[mid:])\n\n        merged_array, cross_inversions = _merge_count(left_half, right_half)\n\n        return merged_array, left_inversions + right_inversions + cross_inversions\n\n    # The input arr might be a tuple or other sequence, convert to list for slicing and modification\n    _, total_inversions = _split_count(list(arr))\n    return total_inversions"}
{"task_id": "Mbpp/294", "solution": "import collections.abc\nimport re\nfrom typing import Any, List, Optional, Union\n\nclass InvalidInputError(Exception):\n    \"\"\"Raised when the input is not a list-like iterable.\"\"\"\n    pass\n\nclass NoNumericValuesError(Exception):\n    \"\"\"Raised when no numeric values are found in the list.\"\"\"\n    pass\n\nclass InputList:\n    \"\"\"DTO for holding the raw input list.\"\"\"\n    def __init__(self, data: List) -> None:\n        self.data = data\n\nclass MaxResult:\n    \"\"\"DTO for representing the computed maximum value.\"\"\"\n    def __init__(self, value: Union[int, float]) -> None:\n        self.value = value\n\nNUMERIC_TYPES = (int, float)\n\ndef is_numeric(obj: Any) -> bool:\n    \"\"\"Checks if an object is a number or a numeric string.\"\"\"\n    if isinstance(obj, NUMERIC_TYPES):\n        return True\n    if isinstance(obj, str):\n        try:\n            float(obj)\n            return True\n        except ValueError:\n            return False\n    return False\n\ndef coerce_number(obj: Any) -> Optional[Union[int, float]]:\n    \"\"\"Converts an object to an int or float if it's numeric, otherwise returns None.\"\"\"\n    if isinstance(obj, int):\n        return obj\n    if isinstance(obj, float):\n        return obj\n    if isinstance(obj, str):\n        try:\n            f = float(obj)\n            if f.is_integer():\n                return int(f)\n            return f\n        except ValueError:\n            return None\n    return None\n\nclass ListAdapter:\n    \"\"\"Adapts raw inputs into an InputList DTO.\"\"\"\n    def to_input(self, raw_list: Any) -> InputList:\n        if not isinstance(raw_list, list):\n            raise InvalidInputError(\"Input must be a list-like iterable.\")\n        return InputList(raw_list)\n\nclass Validator:\n    \"\"\"Validates the InputList DTO preconditions.\"\"\"\n    def validate_input(self, input_dto: InputList) -> None:\n        if not isinstance(input_dto.data, collections.abc.Iterable):\n            raise InvalidInputError(\"Input data must be an iterable within InputList DTO.\")\n\nclass MaxValueService:\n    \"\"\"Core algorithm to compute the maximum numeric value.\"\"\"\n    def __init__(self, coerce_strings: bool = True) -> None:\n        self._coerce_strings = coerce_strings\n\n    def find_max(self, input_dto: InputList) -> MaxResult:\n        \"\"\"Filters, coerces, and finds the maximum numeric value.\"\"\"\n        numeric_values: List[Union[int, float]] = []\n        for item in input_dto.data:\n            if isinstance(item, NUMERIC_TYPES):\n                numeric_values.append(item)\n            elif self._coerce_strings:\n                coerced = coerce_number(item)\n                if coerced is not None:\n                    numeric_values.append(coerced)\n\n        if not numeric_values:\n            raise NoNumericValuesError(\"No numeric values found.\")\n\n        m = max(numeric_values)\n        if isinstance(m, float) and float(m).is_integer():\n            m = int(m)\n        return MaxResult(m)\n\nclass ResultRepository:\n    \"\"\"In-memory repository for storing MaxResult objects.\"\"\"\n    def __init__(self) -> None:\n        self._store: List[MaxResult] = []\n\n    def save(self, result: MaxResult) -> None:\n        self._store.append(result)\n\n    def all(self) -> List[MaxResult]:\n        return list(self._store)\n\nclass CLIController:\n    \"\"\"Provides the public API entry point, wiring components together.\"\"\"\n    def __init__(self, service: 'MaxValueService' = None, repo: 'ResultRepository' = None) -> None:\n        self.adapter = ListAdapter()\n        self.validator = Validator()\n        self.service = service if service is not None else MaxValueService()\n        self.repo = repo\n\n    def find_max_from_list(self, raw_list: list) -> Union[int, float]:\n        \"\"\"Adapts, validates, computes max, and optionally stores the result.\"\"\"\n        input_dto = self.adapter.to_input(raw_list)\n        self.validator.validate_input(input_dto)\n        result = self.service.find_max(input_dto)\n        if self.repo:\n            self.repo.save(result)\n        return result.value\n\ndef max_val(raw_list: list) -> Union[int, float]:\n    \"\"\"Finds the maximum numeric value in a given heterogeneous list.\"\"\"\n    controller = CLIController()\n    return controller.find_max_from_list(raw_list)"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(data: Any, strategy: Optional[str] = None) -> List[Any]:\n    from typing import Any, List, Optional, Dict, Tuple\n    from abc import ABC, abstractmethod\n\n    class FlattenError(Exception):\n        \"\"\"Base exception for flattening operations.\"\"\"\n        pass\n\n    class InvalidInputError(FlattenError):\n        \"\"\"Exception raised for invalid input data.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n            self.message = message\n\n    class FlattenRequest:\n        \"\"\"Request DTO for the flatten operation.\"\"\"\n        def __init__(self, data: Any, strategy: Optional[str] = None) -> None:\n            self.data = data\n            self.strategy = strategy\n\n    class FlattenResponse:\n        \"\"\"Response DTO for the flatten operation.\"\"\"\n        def __init__(self, result: List[Any], metadata: Dict[str, Any]) -> None:\n            self.result = result\n            self.metadata = metadata\n\n    class Utils:\n        \"\"\"Utility class for common predicates and validation.\"\"\"\n        ACCEPTED_CONTAINER_TYPES: Tuple[type, ...] = (list, tuple)\n\n        @staticmethod\n        def is_iterable_but_not_string(obj: Any) -> bool:\n            \"\"\"Checks if an object is an iterable (list/tuple) but not a string type.\"\"\"\n            return isinstance(obj, Utils.ACCEPTED_CONTAINER_TYPES)\n\n        @staticmethod\n        def validate_input(obj: Any) -> None:\n            \"\"\"Validates the root input object, raising InvalidInputError if not a list or tuple.\"\"\"\n            if not Utils.is_iterable_but_not_string(obj):\n                raise InvalidInputError(\"Input must be a list or tuple as the root container.\")\n\n    class FlattenStrategy(ABC):\n        \"\"\"Abstract base class for flattening strategies.\"\"\"\n        @abstractmethod\n        def flatten(self, data: Any) -> List[Any]:\n            \"\"\"Flattens a given nested list structure.\"\"\"\n            pass\n\n    class RecursiveStrategy(FlattenStrategy):\n        \"\"\"Recursive implementation of the flattening strategy.\"\"\"\n        def flatten(self, data: Any) -> List[Any]:\n            out: List[Any] = []\n            self._flatten_inner(data, out)\n            return out\n\n        def _flatten_inner(self, item: Any, out: List[Any]) -> None:\n            if Utils.is_iterable_but_not_string(item):\n                for sub in item:\n                    self._flatten_inner(sub, out)\n            else:\n                out.append(item)\n\n    class IterativeStrategy(FlattenStrategy):\n        \"\"\"Iterative implementation of the flattening strategy using an explicit stack.\"\"\"\n        def flatten(self, data: Any) -> List[Any]:\n            out: List[Any] = []\n            stack = [data]\n            while stack:\n                current = stack.pop()\n                if Utils.is_iterable_but_not_string(current):\n                    for sub in reversed(list(current)):\n                        stack.append(sub)\n                else:\n                    out.append(current)\n            return out\n\n    class StrategyFactory:\n        \"\"\"Factory to create flatten strategy instances.\"\"\"\n        DEFAULT_STRATEGY: str = \"recursive\"\n\n        def get_strategy(self, name: Optional[str]) -> FlattenStrategy:\n            \"\"\"Returns a FlattenStrategy instance based on the provided name.\"\"\"\n            strategy_name = name if name is not None else self.DEFAULT_STRATEGY\n            if strategy_name == \"recursive\":\n                return RecursiveStrategy()\n            elif strategy_name == \"iterative\":\n                return IterativeStrategy()\n            else:\n                raise ValueError(f\"Unknown strategy: {strategy_name}\")\n\n    class FlattenService:\n        \"\"\"Service layer for flattening operations, orchestrating validation and strategy execution.\"\"\"\n        def __init__(self, strategy_factory: StrategyFactory) -> None:\n            self._strategy_factory = strategy_factory\n\n        def flatten(self, request: FlattenRequest) -> FlattenResponse:\n            \"\"\"Flattens the data in the request using the specified strategy.\"\"\"\n            Utils.validate_input(request.data)\n\n            strategy = self._strategy_factory.get_strategy(request.strategy)\n            flattened_result = strategy.flatten(request.data)\n\n            metadata = {\n                \"strategy\": request.strategy if request.strategy else self._strategy_factory.DEFAULT_STRATEGY,\n                \"input_type\": type(request.data).__name__,\n                \"input_len\": len(request.data) if Utils.is_iterable_but_not_string(request.data) else 1,\n            }\n            return FlattenResponse(result=flattened_result, metadata=metadata)\n\n    class FlattenController:\n        \"\"\"Controller for programmatic access to the flattening service.\"\"\"\n        def __init__(self, service: FlattenService) -> None:\n            self.service = service\n\n        def flatten(self, request: FlattenRequest) -> FlattenResponse:\n            \"\"\"Handles a flatten request and returns a flattened response.\"\"\"\n            return self.service.flatten(request)\n\n    # Initialize core components once and cache them as a function attribute.\n    if not hasattr(flatten_list, \"_controller_instance\"):\n        _strategy_factory = StrategyFactory()\n        _service = FlattenService(_strategy_factory)\n        flatten_list._controller_instance = FlattenController(_service)\n\n    _controller = flatten_list._controller_instance\n\n    req = FlattenRequest(data=data, strategy=strategy)\n    resp = _controller.flatten(req)\n    return resp.result"}
{"task_id": "Mbpp/299", "solution": "def max_aggregate(records):\n    \"\"\"\n    Calculates the maximum aggregate from a list of (name, value) tuples.\n    Aggregates values by name and returns the name with the highest sum,\n    using the first-seen name as a tie-breaker.\n    \"\"\"\n    totals = {}\n    first_seen_index = {}\n\n    for i, (name, value) in enumerate(records):\n        if name not in totals:\n            totals[name] = 0.0\n            first_seen_index[name] = i\n        totals[name] += float(value)\n\n    max_name = None\n    max_total = None\n\n    for name, current_total in totals.items():\n        if max_total is None or \\\n           current_total > max_total or \\\n           (current_total == max_total and first_seen_index[name] < first_seen_index[max_name]):\n            max_name = name\n            max_total = current_total\n\n    if max_total is not None and float(max_total).is_integer():\n        max_total = int(max_total)\n\n    return (max_name, max_total)"}
{"task_id": "Mbpp/300", "solution": "def count_binary_seq(n: int) -> int:\n    \"\"\"\n    Counts binary sequences of length 2n such that the sum of the first n bits\n    equals the sum of the last n bits, using the combinatorial identity C(2n, n).\n    \"\"\"\n\n    def _comb(N: int, K: int) -> int:\n        \"\"\"Calculates the binomial coefficient C(N, K).\"\"\"\n        if K < 0 or K > N:\n            return 0\n        if K == 0 or K == N:\n            return 1\n\n        K = min(K, N - K) # C(N, K) = C(N, N-K) for efficiency\n\n        res = 1\n        # Multiplicative formula: C(N, K) = Product_{i=1 to K} (N - K + i) / i\n        for i in range(1, K + 1):\n            res = res * (N - K + i) // i\n        return res\n\n    try:\n        # Use math.comb for efficiency and correctness if available (Python 3.8+)\n        import math\n        return math.comb(2 * n, n)\n    except (AttributeError, ImportError):\n        # Fallback to the custom _comb function if math.comb is not available.\n        return _comb(2 * n, n)"}
{"task_id": "Mbpp/305", "solution": "def start_withp(lines: list[str]) -> tuple[str, str]:\n    \"\"\"\n    Finds two words from a list of strings that start with 'p' (case-insensitive).\n    Raises NotEnoughMatchesError if fewer than two matches are found.\n    \"\"\"\n    class NotEnoughMatchesError(Exception):\n        \"\"\"Custom exception raised when an insufficient number of words are found.\"\"\"\n        def __init__(self, required: int, found: int):\n            self.required = required\n            self.found = found\n            super().__init__(f\"Not enough matches found (required={required}, found={found})\")\n\n    matched_words: list[str] = []\n\n    for line in lines:\n        for word_str in line.split():\n            cleaned_word = word_str.strip()\n            if cleaned_word and cleaned_word[0].lower() == 'p':\n                matched_words.append(cleaned_word)\n                if len(matched_words) == 2:\n                    return (matched_words[0], matched_words[1])\n\n    if len(matched_words) < 2:\n        raise NotEnoughMatchesError(required=2, found=len(matched_words))\n\n    # This line should ideally be unreachable due to the early return,\n    # but serves as a final catch if exactly two words were found and the loop completed.\n    # However, the `if len(matched_words) == 2:` condition ensures early exit.\n    # It's kept here for completeness if the flow were slightly different, though it won't be hit."}
{"task_id": "Mbpp/301", "solution": "def dict_depth(d: dict) -> int:\n    \"\"\"\n    Calculates the maximum nesting depth of dictionaries within a dictionary.\n    An empty dictionary {} has a depth of 1.\n    \"\"\"\n    def _recursive_depth(current_obj):\n        # Base case: if the current object is not a dictionary, it doesn't contribute\n        # further to dictionary nesting, so its effective depth for recursion is 0.\n        if not isinstance(current_obj, dict):\n            return 0\n\n        max_child_depth = 0\n        # Recursively find the depth of all values if they are dictionaries.\n        for value in current_obj.values():\n            max_child_depth = max(max_child_depth, _recursive_depth(value))\n\n        # The depth of the current dictionary is 1 (for itself)\n        # plus the maximum depth found among its children.\n        return 1 + max_child_depth\n\n    return _recursive_depth(d)"}
{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(arr: list, n: int, i: int, k: int) -> int:\n    \"\"\"\n    Computes the maximum sum of an increasing subsequence from arr[0...i]\n    that also includes arr[k] (where k > i).\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"arr must be a list of integers\")\n    if n != len(arr):\n        raise ValueError(\"n must be equal to len(arr)\")\n    if not (0 <= i < n):\n        raise IndexError(\"i out of range\")\n    if not (0 <= k < n):\n        raise IndexError(\"k out of range\")\n    if k <= i:\n        raise ValueError(\"k must be greater than i\")\n\n    # DP array: msis[j] = maximum sum of increasing subsequence ending at index j (for j <= i)\n    msis = [0] * (i + 1)\n\n    for j in range(i + 1):\n        msis[j] = arr[j]\n        for p in range(j):\n            if arr[p] < arr[j]:\n                candidate = msis[p] + arr[j]\n                if candidate > msis[j]:\n                    msis[j] = candidate\n\n    # Find best prefix sum that can precede arr[k]\n    max_prefix_sum_for_k = 0\n    for j in range(i + 1):\n        if arr[j] < arr[k] and msis[j] > max_prefix_sum_for_k:\n            max_prefix_sum_for_k = msis[j]\n\n    return max_prefix_sum_for_k + arr[k]"}
