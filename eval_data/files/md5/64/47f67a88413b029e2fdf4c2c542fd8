{"task_id": "Mbpp/119", "solution": "from typing import List\n\ndef search(nums: List[int]) -> int:\n    \"\"\"\n    Finds the single element that appears only once in a sorted array.\n    All other elements appear exactly twice.\n    \"\"\"\n    low, high = 0, len(nums) - 1\n\n    while low < high:\n        mid = (low + high) // 2\n\n        # Adjust mid to ensure it's at an even index for pair checking.\n        # This makes sure mid points to the potential start of a pair.\n        if mid % 2 == 1:\n            mid -= 1\n\n        # If nums[mid] and nums[mid+1] are a pair, the unique element is to the right.\n        # Advance 'low' past this pair.\n        if nums[mid] == nums[mid + 1]:\n            low = mid + 2\n        # Otherwise, the unique element is at or to the left of 'mid'.\n        # Narrow the search space to the left half.\n        else:\n            high = mid\n\n    # When low equals high, that index points to the unique element.\n    return nums[low]"}
{"task_id": "Mbpp/123", "solution": "def amicable_numbers_sum(limit: int) -> int:\n    \"\"\"\n    Sums all amicable numbers up to a specified limit using a sieve-like approach.\n    Amicable numbers are two different numbers such that the sum of the proper\n    divisors of each is equal to the other number.\n    \"\"\"\n    if limit < 2:\n        return 0\n\n    # proper_divisor_sums[n] will store the sum of proper divisors of n\n    proper_divisor_sums = [0] * (limit + 1)\n    if limit >= 1:\n        proper_divisor_sums[1] = 0\n\n    # Sieve-like approach to calculate sum of proper divisors for all numbers up to limit\n    for i in range(1, limit // 2 + 1):\n        for j in range(2 * i, limit + 1, i):\n            proper_divisor_sums[j] += i\n\n    amicable_set = set()\n\n    # Iterate through numbers to find amicable pairs\n    for a in range(2, limit + 1):\n        b = proper_divisor_sums[a]\n        if b != a and 1 < b <= limit:\n            if proper_divisor_sums[b] == a:\n                amicable_set.add(a)\n                amicable_set.add(b)\n\n    return sum(amicable_set)"}
{"task_id": "Mbpp/120", "solution": "from typing import List, Tuple, Any, Sequence, Optional\nfrom dataclasses import dataclass\nfrom abc import ABC, abstractmethod\n\nclass InvalidInputError(ValueError):\n    \"\"\"Raised when the input structure or types are invalid.\"\"\"\n    pass\n\nclass EmptyInputError(ValueError):\n    \"\"\"Raised when the input list of pairs is empty.\"\"\"\n    pass\n\nclass ProductComputationError(RuntimeError):\n    \"\"\"Raised for unexpected errors during product computation.\"\"\"\n    pass\n\n@dataclass(frozen=True)\nclass Pair:\n    \"\"\"Represents a pair of numeric values.\"\"\"\n    a: float\n    b: float\n\n    def product(self) -> float:\n        \"\"\"Computes the absolute product of the pair's values.\"\"\"\n        return abs(self.a * self.b)\n\n@dataclass\nclass ResultDTO:\n    \"\"\"Data transfer object for the maximum product result.\"\"\"\n    max_product: float\n    pair_index: int\n    pair: Tuple[float, float]\n\nclass PairRepository(ABC):\n    \"\"\"Abstract base class for a repository of Pair objects.\"\"\"\n    @abstractmethod\n    def save_all(self, pairs: List['Pair']) -> None:\n        pass\n\n    @abstractmethod\n    def all(self) -> List['Pair']:\n        pass\n\nclass InMemoryPairRepository(PairRepository):\n    \"\"\"In-memory implementation of the PairRepository.\"\"\"\n    def __init__(self):\n        self._storage: List[Pair] = []\n\n    def save_all(self, pairs: List[Pair]) -> None:\n        self._storage = list(pairs)\n\n    def all(self) -> List[Pair]:\n        return list(self._storage)\n\nclass InputValidator:\n    \"\"\"Validates raw input and converts it to a list of Pair objects.\"\"\"\n    ALLOWED_PAIR_LENGTH: int = 2\n\n    def validate_pairs(self, raw: Any) -> List[Pair]:\n        \"\"\"Ensures input is a valid list of numeric 2-tuples/lists.\"\"\"\n        if not isinstance(raw, (list, tuple)):\n            raise InvalidInputError(\"Input must be a list or tuple of pairs.\")\n\n        if not raw:\n            raise EmptyInputError(\"Input list of pairs cannot be empty.\")\n\n        validated_pairs: List[Pair] = []\n        for i, item in enumerate(raw):\n            if not isinstance(item, (list, tuple)):\n                raise InvalidInputError(f\"Element at index {i} is not a list or tuple: {item}\")\n            if len(item) != self.ALLOWED_PAIR_LENGTH:\n                raise InvalidInputError(f\"Pair at index {i} must contain exactly {self.ALLOWED_PAIR_LENGTH} numbers, got {len(item)}: {item}\")\n            try:\n                a = float(item[0])\n                b = float(item[1])\n                validated_pairs.append(Pair(a, b))\n            except (ValueError, TypeError):\n                raise InvalidInputError(f\"Elements in pair at index {i} must be numeric: {item}\")\n        return validated_pairs\n\nclass MaxProductService:\n    \"\"\"Provides business logic for computing the maximum absolute product.\"\"\"\n    def __init__(self, repository: Optional[PairRepository] = None) -> None:\n        \"\"\"Initializes the service with an optional repository.\"\"\"\n        self.repository = repository or InMemoryPairRepository()\n\n    def compute_max_product(self, pairs: List[Pair]) -> ResultDTO:\n        \"\"\"Computes the maximum absolute product from a list of Pair objects.\"\"\"\n        if not pairs:\n            raise EmptyInputError(\"No pairs provided for computation.\")\n\n        try:\n            max_prod = -float('inf')\n            max_idx = -1\n\n            for i, p in enumerate(pairs):\n                prod = p.product()\n                if prod > max_prod:\n                    max_prod = prod\n                    max_idx = i\n\n            if max_idx < 0:\n                raise ProductComputationError(\"Could not determine maximum product from provided pairs.\")\n\n            # Save pairs to repository as per design, even if in-memory.\n            self.repository.save_all(pairs)\n\n            return ResultDTO(max_product=max_prod, pair_index=max_idx, pair=(pairs[max_idx].a, pairs[max_idx].b))\n        except (EmptyInputError, ProductComputationError):\n            raise\n        except Exception as e:\n            raise ProductComputationError(f\"An unexpected error occurred during product computation: {e}\") from e\n\ndef max_product_tuple(pairs: Sequence[Tuple[float, float]]) -> float:\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples within a given list.\n    It uses a modular design for validation and computation.\n    \"\"\"\n    validator = InputValidator()\n    validated_pairs = validator.validate_pairs(pairs)\n\n    service = MaxProductService(repository=InMemoryPairRepository())\n\n    result = service.compute_max_product(validated_pairs)\n    return result.max_product"}
{"task_id": "Mbpp/124", "solution": "import math\nfrom typing import Union, Optional\n\nclass AngleError(Exception):\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(message)\n    def __str__(self) -> str:\n        return self.message\n\nDEFAULT_STRICT_ZERO: bool = False\n\nclass ComplexNumber:\n    def __init__(self, real: float, imag: float) -> None:\n        try:\n            self.real = float(real)\n            self.imag = float(imag)\n        except (TypeError, ValueError):\n            raise AngleError(\"real and imag must be numeric\")\n\n    @staticmethod\n    def from_mixed(value: Union[complex, float, int], imag: Optional[Union[complex, float, int]] = None) -> \"ComplexNumber\":\n        try:\n            if isinstance(value, complex) and imag is None:\n                return ComplexNumber(value.real, value.imag)\n\n            if imag is None:\n                return ComplexNumber(value, 0.0)\n\n            combined = complex(value) + complex(imag)\n            return ComplexNumber(combined.real, combined.imag)\n        except (TypeError, ValueError) as e:\n            raise AngleError(f\"Invalid inputs for complex number construction: {e}\")\n\n    def magnitude(self) -> float:\n        return math.hypot(self.real, self.imag)\n\nclass AngleCalculator:\n    def calculate(self, z: complex) -> float:\n        # Per design context constraints: \"Do NOT add isinstance() checks or raise exceptions for edge cases\"\n        # Thus, no check for `isinstance(z, complex)` here, assuming `z` is a complex number.\n        return math.atan2(z.imag, z.real)\n\nclass ComplexService:\n    def __init__(self, angle_calculator: Optional[AngleCalculator] = None) -> None:\n        self.angle_calculator = angle_calculator or AngleCalculator()\n\n    def get_angle(self, value: Union[complex, float, int], imag: Optional[Union[complex, float, int]] = None, strict_zero: Optional[bool] = None) -> float:\n        cn = ComplexNumber.from_mixed(value, imag)\n\n        if cn.magnitude() == 0.0:\n            strict = DEFAULT_STRICT_ZERO if strict_zero is None else strict_zero\n            if strict:\n                raise AngleError(\"Angle is undefined for zero complex number\")\n            return 0.0\n\n        z = complex(cn.real, cn.imag)\n        return self.angle_calculator.calculate(z)\n\n_service = ComplexService()\n\ndef angle_complex(value: Union[complex, float, int], imag: Optional[Union[complex, float, int]] = None, strict_zero: Optional[bool] = None) -> float:\n    \"\"\"\n    Computes the angle (argument) of a complex number in radians.\n    Accepts a complex number or real and imaginary parts.\n    \"\"\"\n    return _service.get_angle(value, imag, strict_zero)"}
