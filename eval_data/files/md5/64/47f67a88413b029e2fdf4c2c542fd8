{"task_id": "Mbpp/599", "solution": "def sum_average(n):\n    \"\"\"\n    Calculate the sum and average of the first n natural numbers.\n\n    Args:\n        n: A positive integer (or value convertible to int).\n\n    Returns:\n        A tuple (sum, average) where sum is int and average is float.\n\n    Raises:\n        ValueError: If n is less than 1 or cannot be converted to int.\n    \"\"\"\n    try:\n        n = int(n)\n    except (TypeError, ValueError):\n        raise ValueError(f\"n must be an integer, got {n!r}\")\n    if n < 1:\n        raise ValueError(\"n must be >= 1\")\n\n    total = n * (n + 1) // 2\n    avg = total / n\n    return total, float(avg)"}
{"task_id": "Mbpp/602", "solution": "def first_repeated_char(s: str):\n    \"\"\"\n    Find the first character in the string `s` that is repeated (i.e., appears at least twice).\n    Returns the character as a one-character string, or None if no character repeats.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string\")\n    seen = set()\n    for ch in s:\n        if ch in seen:\n            return ch\n        seen.add(ch)\n    return None"}
{"task_id": "Mbpp/603", "solution": "def get_ludic(n):\n    \"\"\"\n    Return a list of ludic numbers less than or equal to n.\n    Example: get_ludic(10) -> [1, 2, 3, 5, 7]\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 1:\n        return []\n    # Start with numbers 2..n; 1 is always a ludic number if n >= 1\n    L = list(range(2, n + 1))\n    ludics = [1]\n    idx = 0\n    while idx < len(L):\n        p = L[idx]\n        ludics.append(p)\n        # Remove every p-th element from the remainder of the list (1-based counting)\n        if idx + 1 >= len(L):\n            # no remainder to process\n            break\n        new_remainder = []\n        for pos, val in enumerate(L[idx + 1 :], start=1):\n            if pos % p != 0:\n                new_remainder.append(val)\n        L = L[: idx + 1] + new_remainder\n        idx += 1\n    # ludics are generated in ascending order and already <= n\n    return [x for x in ludics if x <= n]"}
