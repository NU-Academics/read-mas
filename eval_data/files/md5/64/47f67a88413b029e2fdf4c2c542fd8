{"task_id": "Mbpp/722", "solution": "def filter_data(data: dict[str, tuple[float, float]], min_height: float, min_weight: float) -> dict[str, tuple[float, float]]:\n    \"\"\"Filters students from the input dictionary whose height and weight meet the specified minimums.\n\n    Returns a new dictionary containing only the qualifying students with their original height and weight tuples.\n    \"\"\"\n    filtered_students = {}\n    for name, (height, weight) in data.items():\n        if height >= min_height and weight >= min_weight:\n            filtered_students[name] = (height, weight)\n    return filtered_students"}
{"task_id": "Mbpp/721", "solution": "def maxAverageOfPath(matrix):\n    \"\"\"\n    Given an N x N matrix (list of lists), return the maximum average cost\n    among all paths from top-left to bottom-right moving only right or down.\n    \"\"\"\n    # Basic validation\n    if not isinstance(matrix, list) or len(matrix) == 0:\n        raise ValueError(\"matrix must be a non-empty list of lists\")\n    n = len(matrix)\n    for i, row in enumerate(matrix):\n        if not isinstance(row, list):\n            raise ValueError(f\"matrix row {i} is not a list\")\n        if len(row) != n:\n            raise ValueError(\"matrix must be square (NxN)\")\n    # DP for maximum-sum path (since all valid paths have length 2N-1, maximizing sum maximizes average)\n    dp = [[float(\"-inf\")] * n for _ in range(n)]\n    try:\n        dp[0][0] = float(matrix[0][0])\n    except Exception:\n        raise ValueError(\"matrix elements must be numeric\")\n    for r in range(n):\n        for c in range(n):\n            if r == 0 and c == 0:\n                continue\n            try:\n                val = float(matrix[r][c])\n            except Exception:\n                raise ValueError(\"matrix elements must be numeric\")\n            best = float(\"-inf\")\n            if r > 0:\n                best = max(best, dp[r - 1][c] + val)\n            if c > 0:\n                best = max(best, dp[r][c - 1] + val)\n            dp[r][c] = best\n    total = dp[n - 1][n - 1]\n    path_length = 2 * n - 1\n    return total / path_length"}
{"task_id": "Mbpp/723", "solution": "def count_same_pair(list1, list2):\n    \"\"\"\n    Counts indices where values in two lists are the same.\n    Assumes inputs are lists of equal length.\n    \"\"\"\n    count = 0\n    for val1, val2 in zip(list1, list2):\n        if val1 == val2:\n            count += 1\n    return count"}
{"task_id": "Mbpp/724", "solution": "def power_base_sum(base, power):\n    \"\"\"\n    Calculates the sum of all digits of the base to the specified power.\n    Assumes base and power are valid integers, power >= 0.\n    \"\"\"\n    result = pow(base, power)\n    return sum(int(digit) for digit in str(result))"}
{"task_id": "Mbpp/726", "solution": "from typing import Tuple, Union\n\ndef multiply_elements(t: tuple) -> Tuple[Union[int, float], ...]:\n    \"\"\"\n    Computes the product of adjacent elements in a tuple of numbers.\n    Returns a new tuple where the i-th element is t_i * t_{i+1}.\n    \"\"\"\n    return tuple(t[i] * t[i+1] for i in range(len(t) - 1))"}
{"task_id": "Mbpp/725", "solution": "import re\nfrom typing import List\n\n_QUOTE_PATTERN = re.compile(r'''\n    \\\"(                 # opening quote\n        (?:           # non-capturing group for contents\n            \\\\\\\"       # escaped quote\n          | \\\\\\\\       # escaped backslash\n          | [^\"\\\\\\n\\r] # any char except quote, backslash or newline\n        )*\n    )\\\"                 # closing quote\n''', re.VERBOSE)\n\ndef extract_quotation(text: str) -> List[str]:\n    \"\"\"\n    Extracts substrings enclosed in double quotes, handling backslash-escaped quotes and backslashes.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"input must be a string\")\n    tokens = []\n    for m in _QUOTE_PATTERN.finditer(text):\n        inner = m.group(1)\n        # Replace escaped backslash first, then escaped quote\n        unescaped = inner.replace('\\\\\\\\', '\\\\').replace('\\\\\"', '\"')\n        tokens.append(unescaped)\n    return tokens"}
{"task_id": "Mbpp/728", "solution": "def sum_list(a, b):\n    \"\"\"\n    Computes the element-wise sum of two lists of numbers.\n    Assumes inputs are lists of equal length with numeric elements.\n    \"\"\"\n    return [float(x) + float(y) for x, y in zip(a, b)]"}
{"task_id": "Mbpp/730", "solution": "def consecutive_duplicates(items: list) -> list:\n    \"\"\"\n    Removes consecutive duplicate elements from a list, preserving the order.\n    Only the first occurrence of each consecutive-equal run is kept.\n    \"\"\"\n    result = []\n    for item in items:\n        if not result or item != result[-1]:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/731", "solution": "import math\n\ndef lateralsurface_cone(r: float, h: float) -> float:\n    \"\"\"Calculates the lateral surface area of a cone.\n\n    Args:\n        r: The radius of the cone's base.\n        h: The height of the cone.\n\n    Returns:\n        The lateral surface area of the cone.\n    \"\"\"\n    slant_height = math.sqrt(r**2 + h**2)\n    return math.pi * r * slant_height"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(sorted_array: list, target: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a given number in a sorted array.\n    Returns -1 if the target is not found.\n    \"\"\"\n    left, right = 0, len(sorted_array) - 1\n    result = -1\n\n    while left <= right:\n        mid = (left + right) // 2\n        if sorted_array[mid] == target:\n            result = mid\n            right = mid - 1  # Potential first occurrence found, try to find an earlier one\n        elif sorted_array[mid] < target:\n            left = mid + 1\n        else:\n            right = mid - 1\n    return result"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(nums):\n    \"\"\"\n    Calculates the sum of products of all possible contiguous sublists.\n    Uses an O(n) dynamic programming approach.\n    \"\"\"\n    total_sum = 0\n    prev_dp_val = 0\n\n    for num in nums:\n        # dp_i = num * (1 + dp_{i-1}), where dp_i is the sum of products of subarrays ending at current num\n        current_dp_val = num * (1 + prev_dp_val)\n        total_sum += current_dp_val\n        prev_dp_val = current_dp_val\n\n    return total_sum"}
{"task_id": "Mbpp/732", "solution": "def replace_specialchar(text: str) -> str:\n    \"\"\"\n    Replaces spaces, commas, and dots in the input string with colons.\n    Uses str.maketrans and str.translate for efficient character replacement.\n    \"\"\"\n    replacement_map = {\" \": \":\", \",\": \":\", \".\": \":\"}\n    trans_table = str.maketrans(replacement_map)\n    return text.translate(trans_table)"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(number: int) -> int:\n    \"\"\"Toggles bits of the number, excluding the most significant and least significant bits.\n    Numbers with fewer than 3 bits remain unchanged.\"\"\"\n    bit_len = number.bit_length() or 1\n    MIN_BIT_LENGTH_TO_TOGGLE = 3\n    middle_mask = 0\n    if bit_len >= MIN_BIT_LENGTH_TO_TOGGLE:\n        all_ones_mask = (1 << bit_len) - 1\n        msb_mask = 1 << (bit_len - 1)\n        lsb_mask = 1\n        middle_mask = all_ones_mask ^ msb_mask ^ lsb_mask\n    return number ^ middle_mask"}
{"task_id": "Mbpp/737", "solution": "import re\n\ndef check_str(s: str) -> bool:\n    \"\"\"\n    Checks if the given string starts with a vowel using regex.\n    Vowels are defined as 'a', 'e', 'i', 'o', 'u', case-insensitive.\n    \"\"\"\n    vowel_pattern = r\"^[aeiou]\"\n    return re.match(vowel_pattern, s, flags=re.IGNORECASE) is not None"}
{"task_id": "Mbpp/736", "solution": "from typing import Sequence\n\ndef left_insertion(sequence: Sequence[object], value: object) -> int:\n    \"\"\"\n    Locate the left insertion point for a specified value in sorted order using binary search.\n    This is equivalent to `bisect.bisect_left`.\n    \"\"\"\n    lo = 0\n    hi = len(sequence)\n    while lo < hi:\n        mid = (lo + hi) // 2\n        if sequence[mid] < value:\n            lo = mid + 1\n        else:\n            hi = mid\n    return lo"}
{"task_id": "Mbpp/740", "solution": "def tuple_to_dict(t: tuple) -> dict:\n    \"\"\"Converts a tuple of adjacent elements into a key-value dictionary.\n    The first element of each pair is the key, the second is the value.\n    \"\"\"\n    result = {}\n    for i in range(0, len(t), 2):\n        key = t[i]\n        value = t[i + 1]\n        result[key] = value\n    return result"}
