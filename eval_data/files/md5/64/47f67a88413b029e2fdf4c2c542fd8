{"task_id": "Mbpp/801", "solution": "def test_three_equal(a: int, b: int, c: int) -> int:\n    \"\"\"\n    Count how many of the three integers are equal.\n    Returns:\n      - 3 if all three are equal,\n      - 2 if exactly two are equal,\n      - 0 if all are different.\n    \"\"\"\n    if a == b == c:\n        return 3\n    if a == b or a == c or b == c:\n        return 2\n    return 0"}
{"task_id": "Mbpp/805", "solution": "def max_sum_list(lists):\n    \"\"\"\n    Returns the sublist within a list of lists whose sum of elements is the highest.\n    If multiple lists have the same highest sum, the first one encountered is returned.\n    \"\"\"\n    if not isinstance(lists, list):\n        raise TypeError(\"Input must be a list of lists\")\n    if not lists:\n        raise ValueError(\"Input list must be non-empty\")\n\n    # Initialize with the first inner list after basic validation\n    first = lists[0]\n    if not isinstance(first, list):\n        raise TypeError(\"All elements of the top-level list must be lists\")\n    max_list = first\n    try:\n        max_current_sum = sum(max_list)\n    except TypeError:\n        raise TypeError(\"Inner lists must contain numeric types (int or float)\")\n\n    for idx in range(1, len(lists)):\n        current_list = lists[idx]\n        if not isinstance(current_list, list):\n            raise TypeError(f\"Element at index {idx} is not a list\")\n        try:\n            current_sum = sum(current_list)\n        except TypeError:\n            raise TypeError(f\"Inner list at index {idx} contains non-numeric elements\")\n        if current_sum > max_current_sum:\n            max_current_sum = current_sum\n            max_list = current_list\n\n    return max_list"}
{"task_id": "Mbpp/803", "solution": "import math\n\ndef is_perfect_square(n):\n    \"\"\"Checks if a given number is a perfect square.\"\"\"\n    if n < 0:\n        return False\n    # Calculate the integer square root.\n    r = math.isqrt(n)\n    return r * r == n"}
