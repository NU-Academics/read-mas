{"task_id": "Mbpp/312", "solution": "import math\n\ndef volume_cone(radius: float, height: float) -> float:\n    \"\"\"Calculates the volume of a right circular cone given its radius and height.\n    The formula used is V = (1/3) * pi * r^2 * h.\n    \"\"\"\n    return (1.0 / 3.0) * math.pi * (radius ** 2) * height"}
{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(n: int) -> int:\n    \"\"\"Sets the left-most unset bit in the given non-negative integer n.\n    If all bits up to the most significant bit are set, it sets the next higher bit.\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n\n    if n == 0:\n        return 1\n\n    msb = n.bit_length() - 1\n\n    # Scan from msb down to 0 to find the first unset bit\n    for i in range(msb, -1, -1):\n        # Check if the bit at index i is not set\n        if not ((n >> i) & 1):\n            # Set the bit and return the new number\n            return n | (1 << i)\n\n    # If all bits from msb down to 0 are set, set the bit at msb + 1\n    return n | (1 << (msb + 1))"}
{"task_id": "Mbpp/308", "solution": "def large_product(list1: Iterable[Union[int, float]], list2: Iterable[Union[int, float]], k: int) -> List[float]:\n    \"\"\"\n    Finds the specified number of largest products from two given lists, selecting one factor from each list.\n    The function handles general numeric inputs (integers and floats), including negatives and zeros,\n    and returns products in descending order.\n    \"\"\"\n\n    # --- Exceptions (inline) ---\n    class ProductError(Exception):\n        \"\"\"Base exception for product-related errors.\"\"\"\n        pass\n\n    class InvalidInputError(ProductError):\n        \"\"\"Raised when input validation fails.\"\"\"\n        pass\n\n    # --- InputValidator (inline) ---\n    class InputValidator:\n        \"\"\"Utility for validating function inputs.\"\"\"\n        @staticmethod\n        def validate_inputs(a: Iterable[Any], b: Iterable[Any], k_val: int) -> None:\n            if not isinstance(k_val, int) or k_val < 0:\n                raise InvalidInputError(\"k must be a non-negative integer.\")\n\n            if not isinstance(a, Iterable) or not isinstance(b, Iterable):\n                raise InvalidInputError(\"list1 and list2 must be iterables.\")\n\n            def _check_elements(lst, name):\n                for i, x in enumerate(lst):\n                    if not isinstance(x, (int, float)):\n                        raise InvalidInputError(f\"Element at index {i} in {name} is not a number: {x}\")\n                    # NaN check\n                    if isinstance(x, float) and (x != x):\n                        raise InvalidInputError(f\"Element at index {i} in {name} is NaN: {x}\")\n                    # Inf check\n                    if isinstance(x, float) and (x == float('inf') or x == float('-inf')):\n                        raise InvalidInputError(f\"Element at index {i} in {name} is infinity: {x}\")\n\n            _check_elements(a, \"list1\")\n            _check_elements(b, \"list2\")\n\n    # --- Initial validation ---\n    InputValidator.validate_inputs(list1, list2, k)\n\n    # Convert iterables to lists of floats for consistent processing\n    list1_actual = [float(x) for x in list1]\n    list2_actual = [float(x) for x in list2]\n\n    m = len(list1_actual)\n    n = len(list2_actual)\n    total_pairs = m * n\n\n    if k <= 0 or total_pairs == 0:\n        return []\n\n    # --- PartitionUtils (inline) ---\n    class PartitionUtils:\n        \"\"\"Utility for partitioning a list into positive, negative, and zero elements.\"\"\"\n        @staticmethod\n        def partition(seq: List[float]) -> Tuple[List[float], List[float], int]:\n            pos = []  # will be sorted descending (largest first)\n            neg = []  # will be sorted ascending (most negative first)\n            zeros = 0\n            for x in seq:\n                if x == 0:\n                    zeros += 1\n                elif x > 0:\n                    pos.append(x)\n                else:\n                    neg.append(x)\n            pos.sort(reverse=True)\n            neg.sort()\n            return pos, neg, zeros\n\n    # --- PairGenerator (inline) ---\n    class PairGenerator:\n        \"\"\"Generates k largest products from two sorted lists using a heap-based approach.\"\"\"\n        def generate_k_pairs_desc(self, A: List[float], B: List[float], k_limit: int) -> Iterator[Tuple[float, int, int]]:\n            # A and B should be sorted such that A[0]*B[0] is the largest product when starting exploration.\n            # Yields (product, i, j) in descending product order.\n            if not A or not B or k_limit <= 0:\n                return\n            visited = set()\n            # Max-heap for products: stores (-product, i, j) to simulate max-heap with heapq.\n            heap: List[Tuple[float, int, int]] = []\n\n            initial_product = A[0] * B[0]\n            heapq.heappush(heap, (-initial_product, 0, 0))\n            visited.add((0, 0))\n\n            products_count = 0\n            while heap and products_count < k_limit:\n                neg_prod, i, j = heapq.heappop(heap)\n                current_product = -neg_prod\n                yield (current_product, i, j)\n                products_count += 1\n\n                # Add neighbors (i+1, j) and (i, j+1) if valid and not visited\n                if i + 1 < len(A) and (i + 1, j) not in visited:\n                    next_product = A[i+1] * B[j]\n                    heapq.heappush(heap, (-next_product, i + 1, j))\n                    visited.add((i + 1, j))\n\n                if j + 1 < len(B) and (i, j + 1) not in visited:\n                    next_product = A[i] * B[j+1]\n                    heapq.heappush(heap, (-next_product, i, j + 1))\n                    visited.add((i, j + 1))\n\n        def generate_k_pairs_asc(self, A: List[float], B: List[float], k_limit: int) -> Iterator[Tuple[float, int, int]]:\n            # A and B should be sorted ascending. For negative * negative, A[0]*B[0] is the largest product.\n            # This method reuses the same logic as generate_k_pairs_desc.\n            return self.generate_k_pairs_desc(A, B, k_limit)\n\n    # --- Helper functions for main algorithm logic (inline) ---\n    pair_generator = PairGenerator()  # Instantiate PairGenerator\n\n    def _fallback_full_enumeration(a_list: List[float], b_list: List[float], k_limit: int) -> List[float]:\n        \"\"\"Computes all products, sorts them, and returns the top k.\"\"\"\n        all_products = []\n        for x in a_list:\n            for y in b_list:\n                all_products.append(x * y)\n        all_products.sort(reverse=True)\n        return all_products[:k_limit]\n\n    def _merge_candidate_iterators(iterators: List[Iterator[Tuple[float, int, int]]], k_limit: int) -> List[float]:\n        \"\"\"Merges multiple iterators of products (each descending) to produce overall top k products.\"\"\"\n        # Global heap: stores (-product, source_idx, product_val, i, j, iterator_obj)\n        heap_global: List[Tuple[float, int, float, int, int, Iterator[Tuple[float, int, int]]]] = []\n\n        for idx, it in enumerate(iterators):\n            try:\n                prod, i, j = next(it)\n                heapq.heappush(heap_global, (-prod, idx, prod, i, j, it))\n            except StopIteration:\n                continue\n\n        result_products: List[float] = []\n        while heap_global and len(result_products) < k_limit:\n            neg_prod, source_idx, prod_val, i, j, it = heapq.heappop(heap_global)\n            result_products.append(prod_val)\n\n            try:\n                nxt_prod, ni, nj = next(it)\n                heapq.heappush(heap_global, (-nxt_prod, source_idx, nxt_prod, ni, nj, it))\n            except StopIteration:\n                pass\n\n        return result_products\n\n    def zero_products_generator(count: int, k_limit: int) -> Iterator[Tuple[float, int, int]]:\n        \"\"\"Generates zero products as (0.0, -1, -1) up to a count or k_limit.\"\"\"\n        for _ in range(min(count, k_limit)):\n            yield (0.0, -1, -1)\n\n    # --- Main algorithm logic ---\n\n    # Fallback to full enumeration if k is greater than or equal to total_pairs\n    if total_pairs <= k:\n        return _fallback_full_enumeration(list1_actual, list2_actual, k)\n\n    # Partition lists into positive, negative, and zero counts\n    posA, negA, zerosA_count = PartitionUtils.partition(list1_actual)\n    posB, negB, zerosB_count = PartitionUtils.partition(list2_actual)\n\n    candidate_iterators: List[Iterator[Tuple[float, int, int]]] = []\n\n    # Source 1: Positive products from (positive * positive)\n    if posA and posB:\n        candidate_iterators.append(pair_generator.generate_k_pairs_desc(posA, posB, k))\n\n    # Source 2: Positive products from (negative * negative)\n    if negA and negB:\n        # negA and negB are sorted ascending. generate_k_pairs_asc expects this.\n        candidate_iterators.append(pair_generator.generate_k_pairs_asc(negA, negB, k))\n\n    # Source 3: Negative products from (positive * negative)\n    # For this, we need posA (descending) and negB (descending). negB_desc is negB_asc reversed.\n    negB_desc = negB[::-1]\n    if posA and negB_desc:\n        candidate_iterators.append(pair_generator.generate_k_pairs_desc(posA, negB_desc, k))\n\n    # Source 4: Negative products from (negative * positive)\n    # Similar to above, negA_desc is negA_asc reversed, then paired with posB (descending).\n    negA_desc = negA[::-1]\n    if negA_desc and posB:\n        candidate_iterators.append(pair_generator.generate_k_pairs_desc(negA_desc, posB, k))\n\n    # Source 5: Zero products\n    # Calculate the total number of distinct pairs that would result in a product of 0.0\n    actual_zero_products_count = 0\n    if zerosA_count > 0:\n        actual_zero_products_count += (len(list2_actual) - zerosB_count) * zerosA_count\n    if zerosB_count > 0:\n        actual_zero_products_count += (len(list1_actual) - zerosA_count) * zerosB_count\n    if zerosA_count > 0 and zerosB_count > 0:\n        actual_zero_products_count += zerosA_count * zerosB_count\n\n    if actual_zero_products_count > 0:\n        candidate_iterators.append(zero_products_generator(actual_zero_products_count, k))\n\n    # Merge all candidate iterators to get the final k largest products\n    final_products = _merge_candidate_iterators(candidate_iterators, k)\n\n    return final_products"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n):\n    # Computes the highest power of 2 less than or equal to n.\n    # Validate input\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 1:\n        raise ValueError(\"n must be >= 1\")\n    # Use bit_length: highest power = 1 << (n.bit_length() - 1)\n    return 1 << (n.bit_length() - 1)"}
{"task_id": "Mbpp/389", "solution": "def find_lucas(n: int) -> int:\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be >= 0\")\n    if n == 0:\n        return 2\n    if n == 1:\n        return 1\n    a, b = 2, 1\n    for _ in range(2, n + 1):\n        a, b = b, a + b\n    return b"}
