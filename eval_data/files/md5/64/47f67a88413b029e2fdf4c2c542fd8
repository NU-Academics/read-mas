{"task_id": "Mbpp/138", "solution": "def is_Sum_Of_Powers_Of_Two(n):\n    \"\"\"\n    Checks if a number can be represented as a sum of non-zero powers of 2.\n    This means the number must be positive and NOT require 2^0 (i.e., its binary LSB must be 0).\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    return n > 0 and (n & 1) == 0"}
{"task_id": "Mbpp/137", "solution": "from typing import Sequence\n\ndef zero_count(array: Sequence[int]) -> float:\n    \"\"\"\n    Calculates the ratio of zeroes to non-zeroes in an array of integers.\n\n    Args:\n        array: A non-empty sequence of integers.\n\n    Returns:\n        float: zero_count / non_zero_count, or float('inf') if non_zero_count == 0 and zero_count > 0,\n               or 0.0 if zero_count == 0.\n\n    Raises:\n        TypeError: if array is not a sequence or contains non-int (including bool) elements.\n        ValueError: if array is empty.\n    \"\"\"\n    if array is None:\n        raise TypeError(\"array must be provided\")\n    try:\n        # Ensure we can iterate multiple times; materialize if it's an iterator\n        # but prefer not to copy if it's already a sequence (like list/tuple).\n        if not isinstance(array, Sequence):\n            array = list(array)\n    except TypeError:\n        raise TypeError(\"array must be an iterable of ints\")\n\n    if len(array) == 0:\n        raise ValueError(\"array must not be empty\")\n\n    zeroes = 0\n    non_zeroes = 0\n\n    for idx, item in enumerate(array):\n        if isinstance(item, bool) or not isinstance(item, int):\n            raise TypeError(f\"element at index {idx} is not an int\")\n        if item == 0:\n            zeroes += 1\n        else:\n            non_zeroes += 1\n\n    if zeroes == 0:\n        return 0.0\n    if non_zeroes == 0:\n        return float('inf')\n    return float(zeroes) / non_zeroes"}
{"task_id": "Mbpp/141", "solution": "def pancake_sort(items: list):\n    \"\"\"Sorts a list of elements using the pancake sort algorithm.\"\"\"\n    arr = list(items)  # Work on a copy of the input list.\n    n = len(arr)\n\n    def _flip(sub_arr: list, k: int) -> None:\n        \"\"\"Reverses the first k elements of the given sub_arr in-place.\"\"\"\n        sub_arr[:k] = sub_arr[:k][::-1]\n\n    for curr_size in range(n, 1, -1):\n        # Find the index of the maximum element in the current unsorted portion arr[0...curr_size-1].\n        max_idx = 0\n        for i in range(1, curr_size):\n            if arr[i] > arr[max_idx]:\n                max_idx = i\n\n        # If the max element is not already at its final sorted position.\n        if max_idx != curr_size - 1:\n            # Move the largest element to the front.\n            _flip(arr, max_idx + 1)\n            # Move the largest element from the front to its correct position.\n            _flip(arr, curr_size)\n\n    return arr"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(list1, list2, list3):\n    \"\"\"\n    Counts number of items that are identical in the same position of three given lists.\n    Compares elements up to the length of the shortest list.\n    \"\"\"\n    min_len = min(len(list1), len(list2), len(list3))\n    count = 0\n    for i in range(min_len):\n        if list1[i] == list2[i] == list3[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/145", "solution": "def max_Abs_Diff(arr):\n    \"\"\"\n    Finds the maximum difference between any two elements in a given array.\n    This is equivalent to finding the difference between the maximum and minimum elements.\n    \"\"\"\n    if arr is None:\n        raise ValueError(\"Input must be a non-empty sequence of numbers.\")\n    try:\n        iterator = iter(arr)\n    except TypeError:\n        raise ValueError(\"Input must be a sequence.\")\n\n    # Initialize by getting the first element; handle empty sequences.\n    try:\n        first = next(iterator)\n    except StopIteration:\n        raise ValueError(\"Input sequence is empty.\")\n\n    # Ensure the first element is numeric\n    if not isinstance(first, (int, float)):\n        raise ValueError(\"All elements must be numeric (int or float).\")\n\n    current_min = current_max = first\n\n    for x in iterator:\n        if not isinstance(x, (int, float)):\n            raise ValueError(\"All elements must be numeric (int or float).\")\n        if x < current_min:\n            current_min = x\n        elif x > current_max:\n            current_max = x\n\n    return current_max - current_min"}
{"task_id": "Mbpp/160", "solution": "def find_solution(a, b, n):\n    \"\"\"\n    Finds integers x and y that satisfy the linear Diophantine equation ax + by = n.\n    Returns a tuple (x, y) if a solution exists, otherwise returns None.\n    \"\"\"\n\n    def _egcd(a_val, b_val):\n        \"\"\"\n        Extended Euclidean Algorithm to find g = gcd(a_val, b_val) and x_p, y_p\n        such that a_val * x_p + b_val * y_p = g.\n        \"\"\"\n        if a_val == 0:\n            # gcd(0, b_val) = abs(b_val)\n            return (abs(b_val), 0, 1 if b_val >= 0 else -1)\n        else:\n            g, x_p, y_p = _egcd(b_val % a_val, a_val)\n            return (g, y_p - (b_val // a_val) * x_p, x_p)\n\n    # Handle the specific case where both a and b are zero\n    if a == 0 and b == 0:\n        if n == 0:\n            return (0, 0)  # 0*x + 0*y = 0. (0,0) is a valid particular solution.\n        else:\n            return None    # 0*x + 0*y = n (n != 0). No solution exists.\n\n    # Use the extended Euclidean algorithm to find g = gcd(a, b) and x_prime, y_prime\n    # such that a*x_prime + b*y_prime = g.\n    g, x_prime, y_prime = _egcd(a, b)\n\n    # A solution to ax + by = n exists if and only if n is divisible by g.\n    if n % g != 0:\n        return None\n    else:\n        # Scale the particular solution (x_prime, y_prime) by n/g to find a solution for n.\n        factor = n // g\n        x = x_prime * factor\n        y = y_prime * factor\n        return (x, y)"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(s: str) -> int:\n    \"\"\"\n    Counts characters in a string that match their 1-based alphabetic position\n    with their 1-based string position (case-insensitive).\n    \"\"\"\n    # Helper to get the 1-based alphabet index for a given lowercase character.\n    # Returns None if the character is not an English letter.\n    def _char_alpha_index(char_lower: str) -> int | None:\n        if 'a' <= char_lower <= 'z':\n            return ord(char_lower) - ord('a') + 1\n        return None\n\n    count = 0\n    # Normalize the entire string to lowercase for case-insensitive comparison.\n    normalized_s = s.lower()\n\n    for i, ch in enumerate(normalized_s):\n        alpha_idx = _char_alpha_index(ch)\n        string_pos = i + 1  # Current character's 1-based position in the string\n\n        if alpha_idx is not None and alpha_idx == string_pos:\n            count += 1\n\n    return count"}
{"task_id": "Mbpp/161", "solution": "def remove_elements(source, to_remove):\n    \"\"\"Return a new list containing items from `source` with any elements present\n    in `to_remove` removed. Order is preserved and `source` is not mutated.\n\n    Raises:\n        TypeError: if either argument is not a list.\n    \"\"\"\n    if not isinstance(source, list):\n        raise TypeError(f\"source must be a list, got {type(source).__name__}\")\n    if not isinstance(to_remove, list):\n        raise TypeError(f\"to_remove must be a list, got {type(to_remove).__name__}\")\n\n    try:\n        remove_set = set(to_remove)\n    except TypeError:\n        # to_remove contains unhashable elements; fall back to O(n*m) comparison\n        return [x for x in source if not any(x == r for r in to_remove)]\n\n    result = []\n    for x in source:\n        try:\n            if x in remove_set:\n                continue\n        except TypeError:\n            # x is unhashable (e.g., a list); fall back to equality check\n            if any(x == r for r in to_remove):\n                continue\n        result.append(x)\n\n    return result"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Computes the sum of the series S(n) = n + (n-2) + (n-4) + ...\n    until terms are no longer positive.\n    \"\"\"\n    # Validate input type and value\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    # Calculate the number of positive terms in the series n, n-2, n-4, ...\n    count = (n + 1) // 2\n\n    if count == 0:\n        return 0\n\n    # First term is n, last positive term is n - 2*(count-1)\n    a1 = n\n    an = n - 2 * (count - 1)\n\n    # Sum of arithmetic progression: count * (first + last) // 2\n    total_sum = count * (a1 + an) // 2\n    return total_sum"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(nums):\n    \"\"\"Counts the number of pairs of integers in a list that XOR to an even number.\n    Two numbers XOR to an even number if they have the same parity (both even or both odd).\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    for num in nums:\n        if (num % 2) == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    # Number of pairs from even numbers: C(n_even, 2) = n_even * (n_even - 1) // 2\n    pairs_from_even = (even_count * (even_count - 1)) // 2\n    # Number of pairs from odd numbers: C(n_odd, 2) = n_odd * (n_odd - 1) // 2\n    pairs_from_odd = (odd_count * (odd_count - 1)) // 2\n\n    return pairs_from_even + pairs_from_odd"}
{"task_id": "Mbpp/168", "solution": "def frequency(lst, value):\n    \"\"\"\n    Count the number of occurrences of value in lst.\n\n    Args:\n        lst: An iterable (e.g., list, tuple) to search.\n        value: The value to count.\n\n    Returns:\n        int: Number of times value appears in lst.\n\n    Raises:\n        TypeError: If lst is not iterable.\n    \"\"\"\n    try:\n        iterator = iter(lst)\n    except TypeError:\n        raise TypeError(\"lst must be an iterable\") from None\n\n    count = 0\n    for item in iterator:\n        try:\n            if item == value:\n                count += 1\n        except Exception:\n            # If comparison raises, treat as non-equal and continue\n            continue\n    return count"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the smallest power of 2 greater than or equal to n.\n    Handles n <= 0 by returning 1.\n    \"\"\"\n    if n <= 0:\n        return 1\n    # If n is already a power of two, return n\n    if (n & (n - 1)) == 0:\n        return n\n    # Set all bits to the right of the highest set bit, then add 1.\n    v = n - 1\n    v |= v >> 1\n    v |= v >> 2\n    v |= v >> 4\n    v |= v >> 8\n    v |= v >> 16\n    v |= v >> 32\n\n    # For arbitrarily large integers, continue shifting until larger than bit-length.\n    bit_length = v.bit_length()\n    shift = 64\n    while shift < bit_length:\n        v |= v >> shift\n        shift <<= 1\n\n    return v + 1"}
{"task_id": "Mbpp/170", "solution": "def sum_range_list(numbers, start, end):\n    \"\"\"\n    Calculates the sum of numbers in a list within the specified index range (inclusive).\n    It iterates from the start index to the end index, adding each element to a running total.\n    \"\"\"\n    total = 0.0\n    for i in range(start, end + 1):\n        total += float(numbers[i])\n    return total"}
{"task_id": "Mbpp/171", "solution": "def perimeter_pentagon(side: float) -> float:\n    \"\"\"Return the perimeter of a regular pentagon given the length of one side.\n\n    Args:\n        side: length of one side (int, float, or numeric string).\n\n    Returns:\n        Perimeter as a float.\n\n    Raises:\n        ValueError: if side is not numeric or is <= 0.\n    \"\"\"\n    try:\n        s = float(side)\n    except (TypeError, ValueError):\n        raise ValueError(\"side must be a numeric value\") from None\n\n    if s <= 0:\n        raise ValueError(\"side must be greater than 0\")\n\n    return 5 * s"}
{"task_id": "Mbpp/172", "solution": "def count_occurance(text: str) -> int:\n    \"\"\"Counts non-overlapping occurrences of 'std' in the given text.\"\"\"\n    pattern = \"std\"\n    count = 0\n    start_index = 0\n    while True:\n        idx = text.find(pattern, start_index)\n        if idx == -1:\n            break\n        count += 1\n        start_index = idx + len(pattern)\n    return count"}
