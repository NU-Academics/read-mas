{"task_id": "Mbpp/567", "solution": "def issort_list(items):\n    \"\"\"Check if the given list is sorted in non-decreasing order.\n    Returns True for empty or single-element lists.\n    \"\"\"\n    if items is None:\n        raise TypeError(\"items must be a sequence, got None\")\n\n    if not hasattr(items, \"__len__\") or not hasattr(items, \"__getitem__\"):\n        raise TypeError(\"items must be a sequence (like list or tuple)\")\n\n    if len(items) < 2:\n        return True\n\n    for i in range(len(items) - 1):\n        try:\n            if items[i] > items[i + 1]:\n                return False\n        except TypeError as exc:\n            raise TypeError(f\"Elements at indices {i} and {i+1} are not comparable\") from exc\n\n    return True"}
{"task_id": "Mbpp/569", "solution": "from typing import List\n\ndef sort_sublists(list_of_lists: List[List[str]]) -> List[List[str]]:\n    \"\"\"\n    Sorts each sublist of strings within a given list of lists lexicographically.\n    Returns a new list of lists with sorted sublists, without modifying the original input structure.\n    \"\"\"\n    return [sorted(sublist) for sublist in list_of_lists]"}
{"task_id": "Mbpp/572", "solution": "from collections import Counter\n\ndef two_unique_nums(nums_list):\n    \"\"\"\n    Removes duplicate numbers from a single list and returns numbers that appear exactly once.\n    The order of the first appearance is preserved.\n    \"\"\"\n    counts = Counter(nums_list)\n    return [num for num in nums_list if counts[num] == 1]"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(haystack, needle):\n    \"\"\"\n    Checks if a list (needle) is a contiguous sublist of another list (haystack).\n    An empty needle is considered a sublist of any haystack at index 0.\n    \"\"\"\n    if not isinstance(haystack, list) or not isinstance(needle, list):\n        raise TypeError(\"Both haystack and needle must be lists\")\n\n    if not needle:\n        return True\n\n    if len(needle) > len(haystack):\n        return False\n\n    n, m = len(haystack), len(needle)\n    for i in range(n - m + 1):\n        if haystack[i : i + m] == needle:\n            return True\n\n    return False"}
{"task_id": "Mbpp/573", "solution": "from typing import List, Iterable\nfrom datetime import datetime\nfrom dataclasses import dataclass\n\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input to the unique product calculation.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass Validator:\n    \"\"\"Utility class for validating and normalizing input numbers.\"\"\"\n    @staticmethod\n    def is_iterable(obj: object) -> bool:\n        \"\"\"Checks if an object is iterable.\"\"\"\n        try:\n            iter(obj)\n            return True\n        except TypeError:\n            return False\n\n    @staticmethod\n    def is_numeric(value: object) -> bool:\n        \"\"\"Checks if a value is numeric (int or float, but not bool).\"\"\"\n        return isinstance(value, (int, float)) and not isinstance(value, bool)\n\n    @staticmethod\n    def normalize_numbers(values: Iterable[object]) -> List[float]:\n        \"\"\"Normalizes an iterable of values into a list of floats, validating each item.\"\"\"\n        if not Validator.is_iterable(values):\n            raise InvalidInputError(\"Input must be an iterable of numbers.\")\n        out = []\n        for v in values:\n            if not Validator.is_numeric(v):\n                raise InvalidInputError(f\"Non-numeric value: {v!r}\")\n            out.append(float(v))\n        return out\n\n@dataclass\nclass ProductResult:\n    \"\"\"Data transfer object for the result of the unique product calculation.\"\"\"\n    result: float\n    unique: List[float]\n    timestamp: str\n\n    def to_dict(self) -> dict:\n        \"\"\"Converts the ProductResult object to a dictionary.\"\"\"\n        return {\"result\": self.result, \"unique\": self.unique, \"timestamp\": self.timestamp}\n\nclass UniqueProductService:\n    \"\"\"Service responsible for the core logic of calculating the product of unique numbers.\"\"\"\n    def __init__(self, validator: Validator = Validator()):\n        \"\"\"Initializes the service with an optional Validator instance.\"\"\"\n        self._validator = validator\n\n    def unique_product(self, numbers: Iterable[object]) -> ProductResult:\n        \"\"\"Calculates the product of unique numbers in the given iterable.\"\"\"\n        normalized = self._validator.normalize_numbers(numbers)\n        unique = set(normalized)\n\n        result = 1.0  # Multiplicative identity\n        for v in unique:\n            result *= v\n\n        return ProductResult(result=result, unique=list(unique), timestamp=datetime.utcnow().isoformat()+\"Z\")\n\ndef unique_product(numbers: Iterable[object]) -> float:\n    \"\"\"\n    Calculates the product of unique numbers in a given list.\n    Non-numeric items or non-iterable inputs will raise an InvalidInputError.\n    \"\"\"\n    service = UniqueProductService(validator=Validator())\n    product_result = service.unique_product(numbers)\n    return product_result.result"}
{"task_id": "Mbpp/578", "solution": "class LengthMismatchError(ValueError):\n    \"\"\"Exception raised when list lengths differ during interleaving.\"\"\"\n    def __init__(self, lengths: tuple):\n        super().__init__(f\"List lengths differ: {lengths}\")\n        self.lengths = lengths\n\nclass ListValidator:\n    \"\"\"Provides static methods for validating list properties.\"\"\"\n    @staticmethod\n    def validate_equal_length(a: list, b: list, c: list) -> None:\n        \"\"\"Validates that three lists have equal lengths, raising an error if not.\"\"\"\n        lengths = (len(a), len(b), len(c))\n        if lengths[0] != lengths[1] or lengths[1] != lengths[2]:\n            raise LengthMismatchError(lengths)\n\nclass Interleaver:\n    \"\"\"Handles the core logic for interleaving lists.\"\"\"\n    def interleave_lists(self, a: list, b: list, c: list) -> list:\n        \"\"\"Validates and interleaves three lists using the default algorithm.\"\"\"\n        ListValidator.validate_equal_length(a, b, c)\n        return self._interleave_via_zip(a, b, c)\n\n    def _interleave_via_zip(self, a: list, b: list, c: list) -> list:\n        \"\"\"Interleaves three lists using zip and a list comprehension.\"\"\"\n        return [elem for triple in zip(a, b, c) for elem in triple]\n\ndef interleave_lists(a: list, b: list, c: list) -> list:\n    \"\"\"\n    Interleaves three lists of the same length into a single flat list.\n    Raises LengthMismatchError if list lengths differ.\n    \"\"\"\n    return Interleaver().interleave_lists(a, b, c)"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n: int) -> int:\n    \"\"\"\n    Finds the last digit of the factorial of a given number n.\n    For n >= 10, the last digit is 0. For smaller n, it computes n! % 10.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    if n >= 10:\n        return 0\n\n    # For n < 10, compute factorial modulo 10\n    result = 1\n    # The loop iterates from 2 up to n. This handles 0! and 1! correctly as 1.\n    for i in range(2, n + 1):\n        result = (result * i) % 10\n\n    return result"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1, tuple2):\n    \"\"\"\n    Finds elements that appear in one tuple but not both.\n    Results are ordered by elements unique to `tuple1` (in their original order),\n    then elements unique to `tuple2` (in their original order), with duplicates\n    within each segment removed.\n    \"\"\"\n\n    def _order_preserving_difference(source_tuple, filter_set):\n        \"\"\"\n        Returns elements from source_tuple that are not in filter_set,\n        preserving original order and removing duplicates within the result.\n        \"\"\"\n        seen = set()\n        result = []\n        for item in source_tuple:\n            if item not in filter_set and item not in seen:\n                seen.add(item)\n                result.append(item)\n        return tuple(result)\n\n    set1 = set(tuple1)\n    set2 = set(tuple2)\n\n    left_only = _order_preserving_difference(tuple1, set2)\n    right_only = _order_preserving_difference(tuple2, set1)\n\n    return tuple(left_only + right_only)"}
{"task_id": "Mbpp/580", "solution": "def extract_even(data: tuple) -> tuple:\n    \"\"\"\n    Recursively removes odd integers from a nested tuple.\n    Keeps even integers, non-integer elements, and preserves tuple structure.\n    \"\"\"\n    result_elements = []\n    for item in data:\n        if isinstance(item, tuple):\n            processed_nested = extract_even(item)\n            result_elements.append(processed_nested)\n        elif isinstance(item, int):\n            if item % 2 == 0:\n                result_elements.append(item)\n        else:\n            result_elements.append(item)\n\n    return tuple(result_elements)"}
{"task_id": "Mbpp/583", "solution": "def catalan_number(n: int) -> int:\n    \"\"\"Return the nth Catalan number (n >= 0).\n\n    Uses math.comb when available for an exact, efficient computation.\n    Raises:\n      TypeError if n is not an int.\n      ValueError if n is negative.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    import math\n\n    # Use exact binomial formula: C_n = comb(2n, n) // (n + 1)\n    try:\n        return math.comb(2 * n, n) // (n + 1)\n    except AttributeError:\n        # Fallback for Python versions without math.comb:\n        # compute C(2n, n) via multiplicative reduction to avoid large factorials.\n        num = 1\n        den = 1\n        for k in range(1, n + 1):\n            num *= n + k       # multiply by n+1 .. 2n\n            den *= k           # multiply by 1 .. n\n            g = math.gcd(num, den)\n            if g > 1:\n                num //= g\n                den //= g\n        c = num // den\n        return c // (n + 1)"}
{"task_id": "Mbpp/586", "solution": "def split_Arr(arr, n):\n    \"\"\"\n    Splits a list at the nth element and adds the first part to the end.\n    Handles negative n, n out of bounds, and empty lists using modulo semantics.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"arr must be a list\")\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n\n    if not arr:\n        return []\n\n    effective_n = n % len(arr)\n    return arr[effective_n:] + arr[:effective_n]"}
{"task_id": "Mbpp/581", "solution": "import math\nfrom dataclasses import dataclass\n\nclass ValidationError(Exception):\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass MathUtils:\n    @staticmethod\n    def sqrt(x: float) -> float:\n        if x < 0:\n            raise ValueError(\"sqrt of negative\")\n        return math.sqrt(x)\n\ndef validate_positive(name: str, value: float) -> None:\n    if not isinstance(value, (int, float)):\n        raise ValidationError(f\"{name} must be a number\")\n    if value <= 0:\n        raise ValidationError(f\"{name} must be > 0\")\n\n@dataclass\nclass SquarePyramid:\n    base_edge: float\n    height: float\n\n    def slant_height(self) -> float:\n        return MathUtils.sqrt((self.base_edge / 2.0) ** 2 + self.height ** 2)\n\n    def base_area(self) -> float:\n        return self.base_edge ** 2\n\n    def lateral_area(self, use_slant: bool) -> float:\n        if use_slant:\n            s = self.slant_height()\n            return 2.0 * self.base_edge * s  # correct formula\n        else:\n            # legacy mode to match provided example (uses vertical height instead of slant)\n            return 2.0 * self.base_edge * self.height\n\n    def surface_area(self, use_slant: bool) -> float:\n        return self.base_area() + self.lateral_area(use_slant)\n\nDEFAULT_USE_SLANT: bool = False\n\nclass SurfaceAreaService:\n    def compute(self, base_edge: float, height: float, use_slant: bool = False) -> float:\n        validate_positive(\"base_edge\", base_edge)\n        if not isinstance(height, (int, float)):\n            raise ValidationError(\"height must be a number\")\n        if height < 0:\n            raise ValidationError(\"height must be >= 0\")\n        pyramid = SquarePyramid(base_edge=base_edge, height=height)\n        return pyramid.surface_area(use_slant)\n\nclass SurfaceAreaController:\n    def __init__(self, service: SurfaceAreaService = None):\n        self.service = service or SurfaceAreaService()\n\n    def compute(self, base_edge: float, height: float) -> float:\n        return self.service.compute(base_edge, height, use_slant=DEFAULT_USE_SLANT)\n\n_controller = SurfaceAreaController()\n\ndef surface_Area(base_edge: float, height: float) -> float:\n    \"\"\"\n    Public API. Uses package default mode (DEFAULT_USE_SLANT) for lateral area calculation.\n    \"\"\"\n    return _controller.compute(base_edge, height)"}
