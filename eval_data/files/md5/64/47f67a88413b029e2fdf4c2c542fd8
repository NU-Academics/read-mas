{"task_id": "Mbpp/232", "solution": "import heapq\n\ndef larg_nnum(list, n):\n    \"\"\"\n    Returns a list containing the n largest unique items from the input list.\n    This implementation adheres to returning unique items by default, as implied by the provided assertion.\n    \"\"\"\n    if n == 0:\n        return []\n\n    # Get unique values from the input list.\n    unique_values = list(set(list))\n\n    # Find the n largest unique values using a min-heap based approach.\n    result = heapq.nlargest(n, unique_values)\n\n    return result"}
{"task_id": "Mbpp/233", "solution": "import math\nfrom dataclasses import dataclass\nfrom typing import Any\n\nclass ValidationError(Exception):\n    \"\"\"Custom exception for validation errors.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass Validator:\n    \"\"\"Utility class for input validation.\"\"\"\n    @staticmethod\n    def validate_positive_number(value: Any, name: str) -> float:\n        \"\"\"Converts value to float and ensures it's positive.\"\"\"\n        try:\n            f = float(value)\n        except (TypeError, ValueError):\n            raise ValidationError(f\"{name} must be a number\")\n        if f <= 0:\n            raise ValidationError(f\"{name} must be > 0\")\n        return f\n\n@dataclass\nclass Cylinder:\n    \"\"\"Represents a cylinder with height and radius.\"\"\"\n    height: float\n    radius: float\n\n    def surface_lateral(self) -> float:\n        \"\"\"Calculates the lateral surface area of the cylinder.\"\"\"\n        return 2.0 * math.pi * self.radius * self.height\n\nclass GeometryService:\n    \"\"\"Provides geometry computation services.\"\"\"\n    def compute_lateral_surface_area(self, height: float, radius: float) -> float:\n        \"\"\"Computes the lateral surface area after validating inputs.\"\"\"\n        h = Validator.validate_positive_number(height, \"height\")\n        r = Validator.validate_positive_number(radius, \"radius\")\n        cyl = Cylinder(height=h, radius=r)\n        return cyl.surface_lateral()\n\ndef lateralsuface_cylinder(height: float, radius: float) -> float:\n    \"\"\"\n    Computes the lateral surface area of a cylinder.\n    Inputs are validated to be positive numbers.\n    \"\"\"\n    api_service = GeometryService()\n    return api_service.compute_lateral_surface_area(height, radius)"}
{"task_id": "Mbpp/235", "solution": "def even_bit_set_number(n: int) -> int:\n    \"\"\"Sets all even-positioned bits (1-based index) of a non-negative integer `n`.\"\"\"\n    # Determine the 0-based index of the most significant bit.\n    # For n=0, msb_idx is 0. For n > 0, it's n.bit_length() - 1.\n    if n <= 0:\n        msb_idx = 0\n    else:\n        msb_idx = n.bit_length() - 1\n\n    # The mask's bit_length extends up to the MSB of n.\n    # If n=0, msb_idx=0, so bit_length is 1.\n    bit_length = msb_idx + 1\n\n    # If, for some reason, bit_length ends up being less than 1, default to 1 as per design.\n    if bit_length < 1:\n        bit_length = 1\n\n    # Construct a mask with 1s at 0-based indices 1, 3, 5, ... (1-based even positions).\n    # The pattern '10' repeated for `repeats` times covers these positions.\n    repeats = (bit_length + 1) // 2\n    pattern = int('10' * repeats, 2)\n\n    # Truncate the pattern to the required bit_length.\n    mask = pattern & ((1 << bit_length) - 1)\n\n    # Apply the mask using a bitwise OR operation.\n    return n | mask"}
{"task_id": "Mbpp/237", "solution": "import collections\nfrom abc import ABC, abstractmethod\nfrom typing import Any, Dict, Iterable, Optional, Tuple\n\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input data.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass RepositoryError(Exception):\n    \"\"\"Exception raised for repository-related errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\ndef canonicalize_pair(pair: Tuple[Any, Any]) -> Tuple[int, int]:\n    \"\"\"\n    Validates a pair, converts its elements to integers, and returns the canonical form (min, max).\n    Raises InvalidInputError if the pair is malformed or elements cannot be converted to int.\n    \"\"\"\n    if not isinstance(pair, (list, tuple)) or len(pair) != 2:\n        raise InvalidInputError(\"Each item must be a 2-element tuple or list.\")\n    try:\n        a, b = int(pair[0]), int(pair[1])\n    except (ValueError, TypeError) as e:\n        raise InvalidInputError(f\"Pair elements must be convertible to integers: {pair}. Error: {e}\")\n    return (a, b) if a <= b else (b, a)\n\nclass Repository(ABC):\n    \"\"\"Abstract base class for a repository to store pair counts.\"\"\"\n    @abstractmethod\n    def save(self, id: str, counts: Dict[Tuple[int,int], int]) -> None:\n        pass\n\n    @abstractmethod\n    def get(self, id: str) -> Optional[Dict[Tuple[int,int], int]]:\n        pass\n\nclass InMemoryRepository(Repository):\n    \"\"\"An in-memory implementation of the Repository.\"\"\"\n    def __init__(self) -> None:\n        self._store: Dict[str, Dict[Tuple[int,int], int]] = {}\n\n    def save(self, id: str, counts: Dict[Tuple[int,int], int]) -> None:\n        # Store a copy of the counts, ensuring keys are tuple and values are int\n        self._store[id] = {tuple(k): int(v) for k, v in counts.items()}\n\n    def get(self, id: str) -> Optional[Dict[Tuple[int,int], int]]:\n        return self._store.get(id)\n\nclass TupleCounterService:\n    \"\"\"Business logic for counting canonicalized pairs and optional persistence.\"\"\"\n    def __init__(self, repository: Repository | None = None) -> None:\n        self._repository = repository or InMemoryRepository()\n\n    def count(self, pairs: Iterable[Tuple[Any, Any]]) -> Dict[Tuple[int,int], int]:\n        \"\"\"\n        Canonicalizes input pairs and counts their occurrences.\n        Returns a dictionary mapping canonical tuples to their counts.\n        \"\"\"\n        counter = collections.Counter()\n        for p in pairs:\n            key = canonicalize_pair(p)\n            counter[key] += 1\n        return dict(counter)\n\ndef check_occurrences(pairs: Iterable[Tuple[Any, Any]]) -> Dict[Tuple[int,int], int]:\n    \"\"\"\n    Public API function to count occurrences of unordered 2-item tuples.\n    It canonicalizes each pair (e.g., (1,3) and (3,1) both become (1,3)) and returns their frequencies.\n    \"\"\"\n    service = TupleCounterService()  # Uses InMemoryRepository by default\n    return service.count(pairs)"}
