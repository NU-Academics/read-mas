{"task_id": "Mbpp/59", "solution": "def is_octagonal(n: int) -> int:\n    \"\"\"Compute the nth octagonal number using the formula n * (3n - 2).\"\"\"\n    return n * (3 * n - 2)"}
{"task_id": "Mbpp/61", "solution": "def count_Substrings(s: str) -> int:\n    \"\"\"\n    Count contiguous substrings where the sum of digits equals the substring length.\n\n    Example:\n        assert count_Substrings('112112') == 6\n    \"\"\"\n    prefix = 0\n    counts = {0: 1}\n    result = 0\n\n    for ch in s:\n        # convert digit character to int (assumes input contains digits '0'..'9')\n        val = ord(ch) - 48\n        prefix += (val - 1)\n        result += counts.get(prefix, 0)\n        counts[prefix] = counts.get(prefix, 0) + 1\n\n    return result"}
{"task_id": "Mbpp/63", "solution": "def max_difference(pairs):\n    \"\"\"\n    Finds the maximum difference between elements in available pairs.\n    Assumes valid input: a non-empty iterable of 2-element numeric tuples.\n    \"\"\"\n    max_diff = None\n    for item in pairs:\n        if not (hasattr(item, \"__len__\") and len(item) == 2):\n            raise ValueError(\"Each item must be a pair of length 2\")\n        a, b = item\n        try:\n            diff = abs(float(a) - float(b))\n        except (TypeError, ValueError):\n            raise ValueError(\"Pair elements must be numeric\")\n        if max_diff is None or diff > max_diff:\n            max_diff = diff\n    if max_diff is None:\n        raise ValueError(\"Input must contain at least one pair\")\n    # If the result is an integer value, return as int; otherwise float\n    if max_diff.is_integer():\n        return int(max_diff)\n    return max_diff"}
