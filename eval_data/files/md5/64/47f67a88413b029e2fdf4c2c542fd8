{"task_id": "Mbpp/108", "solution": "import heapq\nfrom typing import Iterable, List, TypeVar, Sequence\n\nT = TypeVar('T')\n\ndef merge_sorted_list(list1: Iterable[T], list2: Iterable[T], list3: Iterable[T], optimize: bool = False) -> List[T]:\n    \"\"\"\n    Merges three lists into a single sorted list.\n    If optimize is True and all inputs are individually sorted, a k-way merge is used.\n    \"\"\"\n    a = list(list1)\n    b = list(list2)\n    c = list(list3)\n\n    def is_sorted(seq: Sequence[T]) -> bool:\n        \"\"\"Checks if a sequence is sorted in non-decreasing order.\"\"\"\n        if not seq:\n            return True\n        for i in range(len(seq) - 1):\n            if seq[i] > seq[i+1]:\n                return False\n        return True\n\n    if optimize and is_sorted(a) and is_sorted(b) and is_sorted(c):\n        return list(heapq.merge(a, b, c))\n    else:\n        return sorted(a + b + c)"}
{"task_id": "Mbpp/111", "solution": "import collections.abc\nfrom typing import List, Any, Set\n\nclass CommonFinderError(Exception):\n    \"\"\"Base exception for the commonfinder library.\"\"\"\n    def __init__(self, message: str = \"\") -> None:\n        super().__init__(message)\n        self.message = message\n\nclass InvalidInputError(CommonFinderError):\n    \"\"\"Exception raised for invalid input data.\"\"\"\n    def __init__(self, message: str = \"Invalid input\") -> None:\n        super().__init__(message)\n\nclass Validator:\n    \"\"\"Handles normalization of input lists, without explicit error checks due to constraints.\"\"\"\n    def validate_lists(self, value: Any) -> List[List[Any]]:\n        \"\"\"\n        Converts an iterable of iterables into a list of lists.\n        Assumes input is well-formed enough for list conversions to succeed.\n        \"\"\"\n        # Due to constraints, explicit isinstance checks and error raising are omitted.\n        # Built-in TypeErrors will propagate if assumptions about input iterability are violated.\n        lists = [list(inner) for inner in value]\n        return lists\n\nclass CommonElementsService:\n    \"\"\"Core service to compute common elements across nested lists.\"\"\"\n    def __init__(self, validator: Validator) -> None:\n        \"\"\"Initializes the service with a validator dependency.\"\"\"\n        self._validator = validator\n\n    def _intersect_sets(self, sets: List[Set[Any]]) -> Set[Any]:\n        \"\"\"Calculates the intersection of a list of sets efficiently.\"\"\"\n        if not sets:\n            return set()\n\n        # Optimize by starting with the smallest set for faster intersections.\n        sets.sort(key=len)\n        result_set = sets[0]\n        for i in range(1, len(sets)):\n            result_set = result_set.intersection(sets[i])\n            if not result_set: # Early exit if intersection becomes empty.\n                break\n        return result_set\n\n    def find_common(self, lists: List[List[Any]]) -> List[Any]:\n        \"\"\"\n        Finds the elements common to all given nested lists.\n        Handles single list cases and returns an empty list if no common elements.\n        \"\"\"\n        validated_lists = self._validator.validate_lists(lists)\n\n        if not validated_lists:\n            return []\n\n        # If there's only one list, return its unique elements.\n        if len(validated_lists) == 1:\n            return list(set(validated_lists[0]))\n\n        # Convert all inner lists to sets for efficient intersection.\n        sets = [set(lst) for lst in validated_lists]\n        common_elements_set = self._intersect_sets(sets)\n        return list(common_elements_set)\n\ndef common_in_nested_lists(lists: List[List[Any]]) -> List[Any]:\n    \"\"\"\n    Finds the common elements in given nested lists.\n    This function orchestrates validation and the core intersection logic.\n    \"\"\"\n    validator = Validator()\n    service = CommonElementsService(validator=validator)\n    return service.find_common(lists)"}
{"task_id": "Mbpp/109", "solution": "def odd_Equivalent(binary: str, k: int) -> int:\n    \"\"\"\n    Finds the number of times a binary string rotation results in an odd integer.\n    An integer is odd if its least significant bit (rightmost character) is '1'.\n    \"\"\"\n    if not isinstance(binary, str) or len(binary) == 0:\n        raise ValueError(\"binary must be a non-empty string of '0' and '1'\")\n    if any(c not in ('0', '1') for c in binary):\n        raise ValueError(\"binary must contain only '0' and '1'\")\n    if not isinstance(k, int) or k < 0:\n        raise ValueError(\"k must be a non-negative integer\")\n\n    n = len(binary)\n    if k == 0:\n        return 0\n\n    full_cycles = k // n\n    remainder = k % n\n\n    # Each full cycle of n rotations makes each original position become the LSB once.\n    ones_per_cycle = binary.count(\"1\")\n\n    remainder_ones = 0\n    for i in range(remainder):\n        # After right-rotating i times, the LSB corresponds to original index (n - 1 - i) % n\n        lsb_original_index = (n - 1 - i) % n\n        if binary[lsb_original_index] == '1':\n            remainder_ones += 1\n\n    return ones_per_cycle * full_cycles + remainder_ones"}
