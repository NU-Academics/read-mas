{"task_id": "Mbpp/629", "solution": "class Utils:\n    @staticmethod\n    def is_even(n: int) -> bool:\n        \"\"\"Checks if an integer is even.\"\"\"\n        return n % 2 == 0\n\nclass EvenService:\n    def __init__(self, utils: Utils) -> None:\n        \"\"\"Initializes the EvenService with a Utils instance.\"\"\"\n        self._utils = utils\n\n    def filter_even(self, numbers: list[int]) -> list[int]:\n        \"\"\"Filters a list of integers, returning only the even numbers.\"\"\"\n        return [n for n in numbers if self._utils.is_even(n)]\n\nclass InputAdapter:\n    def validate_and_normalize(self, value: object) -> list[int]:\n        \"\"\"\n        Passes through the input value, assuming it is already a valid list of integers.\n        Input validation checks are skipped per completion constraints.\n        \"\"\"\n        return value\n\nclass SplitController:\n    def __init__(self, adapter: InputAdapter = None, service: EvenService = None) -> None:\n        \"\"\"Initializes the SplitController with optional adapter and service dependencies.\"\"\"\n        self._adapter = adapter if adapter is not None else InputAdapter()\n        self._service = service if service is not None else EvenService(utils=Utils())\n\n    def handle(self, numbers: object) -> list[int]:\n        \"\"\"Handles the request to find even numbers, orchestrating adapter and service.\"\"\"\n        normalized_numbers = self._adapter.validate_and_normalize(numbers)\n        return self._service.filter_even(normalized_numbers)\n\n# Create a module-level controller instance as per design context for the public API.\n_ctrl = SplitController()\n\ndef Split(numbers):\n    \"\"\"\n    Finds even numbers from a list of numbers.\n    Assumes input 'numbers' is a list-like of integers without requiring validation.\n    \"\"\"\n    return _ctrl.handle(numbers)"}
{"task_id": "Mbpp/630", "solution": "def get_coordinates(coord_tuple):\n    \"\"\"\n    Extracts all adjacent coordinates of the given coordinate tuple, including itself.\n    The result is a list of [x, y] lists, ordered row-major (x-1..x+1 then y-1..y+1).\n    \"\"\"\n    x, y = coord_tuple\n    adjacent_coords = []\n\n    for xi in range(x - 1, x + 2):\n        for yi in range(y - 1, y + 2):\n            adjacent_coords.append([xi, yi])\n\n    return adjacent_coords"}
{"task_id": "Mbpp/631", "solution": "def replace_spaces(text: str) -> str:\n    \"\"\"\n    Replaces sequences of whitespaces with a single underscore, or underscores with\n    single spaces, based on content detection in the input string.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"text must be a str\")\n\n    has_whitespace = any(char.isspace() for char in text)\n    has_underscores = \"_\" in text\n\n    if has_whitespace:\n        # Normalize all whitespace characters (space, tab, newline) to single spaces,\n        # then replace these single spaces with underscores.\n        normalized_to_single_spaces = \" \".join(text.split())\n        return normalized_to_single_spaces.replace(\" \", \"_\")\n    elif has_underscores:\n        # Replace all underscores with single spaces. Then, normalize any resulting\n        # multiple spaces to a single space.\n        replaced_underscores = text.replace(\"_\", \" \")\n        return \" \".join(replaced_underscores.split())\n    else:\n        # If neither whitespace nor underscores are found, return the original string unchanged.\n        return text"}
{"task_id": "Mbpp/632", "solution": "def move_zero(nums):\n    \"\"\"\n    Moves all zeroes in the list to the end while preserving the order of non-zero elements.\n    Returns a new list with the modified order.\n    \"\"\"\n    nonzeros = [x for x in nums if x != 0]\n    zeros_count = len(nums) - len(nonzeros)\n    return nonzeros + [0] * zeros_count"}
{"task_id": "Mbpp/635", "solution": "from typing import List, TypeVar\n\nT = TypeVar(\"T\")\n\ndef heap_sort(data: List[T]) -> List[T]:\n    \"\"\"Sorts a list using the heap sort algorithm. Returns a new sorted list in ascending order.\"\"\"\n    arr = list(data)\n    n = len(arr)\n\n    def _sift_down(current_root_idx: int, end_idx: int) -> None:\n        root = current_root_idx\n        while True:\n            child = 2 * root + 1\n            if child > end_idx:\n                break\n\n            if child + 1 <= end_idx and arr[child] < arr[child + 1]:\n                child += 1\n\n            if arr[root] < arr[child]:\n                arr[root], arr[child] = arr[child], arr[root]\n                root = child\n            else:\n                break\n\n    for i in range(n // 2 - 1, -1, -1):\n        _sift_down(i, n - 1)\n\n    for i in range(n - 1, 0, -1):\n        arr[i], arr[0] = arr[0], arr[i]\n        _sift_down(0, i - 1)\n\n    return arr"}
{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(nums, n):\n    \"\"\"\n    Finds the sum of XOR of all unordered pairs of numbers in the given list.\n    Uses a bitwise counting approach (O(n * bit_width)).\n\n    Args:\n        nums: List of integers.\n        n: Number of elements in nums.\n\n    Returns:\n        Integer sum of xor of all pairs (i < j).\n    \"\"\"\n    if n < 2:\n        return 0\n\n    total_xor_sum = 0\n    bit_width = 64  # Use fixed-width two's complement normalization\n\n    for k in range(bit_width):\n        count_ones = 0\n        for num in nums:\n            # Normalize to two's complement within bit_width to handle negatives consistently\n            normalized_num = num % (1 << bit_width)\n            if (normalized_num >> k) & 1:\n                count_ones += 1\n\n        count_zeros = n - count_ones\n        total_xor_sum += (count_ones * count_zeros) * (1 << k)\n\n    return total_xor_sum"}
{"task_id": "Mbpp/637", "solution": "def noprofit_noloss(cost_price, selling_price):\n    \"\"\"\n    Checks if a given cost price and selling price represent no profit and no loss.\n    Returns True if they are equal (to 2 decimal places by default), False otherwise.\n    \"\"\"\n    from decimal import Decimal, InvalidOperation, ROUND_HALF_EVEN\n    from typing import Any\n\n    class InvalidPriceError(ValueError):\n        def __init__(self, message: str) -> None:\n            self.message = message\n            super().__init__(message)\n\n    _DEFAULT_DECIMAL_PLACES = 2\n\n    class _Validator:\n        @staticmethod\n        def parse_price(value: Any) -> Decimal:\n            if isinstance(value, Decimal):\n                return value\n            try:\n                if isinstance(value, float):\n                    value = format(value, \"f\")\n                return Decimal(str(value))\n            except (InvalidOperation, ValueError, TypeError) as exc:\n                raise InvalidPriceError(f\"Unable to parse price: {value}\") from exc\n\n        @staticmethod\n        def assert_non_negative(value: Decimal) -> None:\n            if value < 0:\n                raise InvalidPriceError(f\"Price must be non-negative: {value}\")\n\n    class _AmountComparison:\n        def __init__(self, cost_price_val: Decimal, selling_price_val: Decimal) -> None:\n            self._cost_price = cost_price_val\n            self._selling_price = selling_price_val\n\n        def validate(self) -> None:\n            _Validator.assert_non_negative(self._cost_price)\n            _Validator.assert_non_negative(self._selling_price)\n\n    _precision = _DEFAULT_DECIMAL_PLACES\n\n    cost_d = _Validator.parse_price(cost_price)\n    selling_d = _Validator.parse_price(selling_price)\n\n    comp = _AmountComparison(cost_d, selling_d)\n    comp.validate()\n\n    quant = Decimal(\"1\").scaleb(-_precision)\n    cost_quantized = cost_d.quantize(quant, rounding=ROUND_HALF_EVEN)\n    selling_quantized = selling_d.quantize(quant, rounding=ROUND_HALF_EVEN)\n\n    return cost_quantized == selling_quantized"}
{"task_id": "Mbpp/638", "solution": "def wind_chill(velocity_kmh: float, temp_celsius: float) -> int:\n    \"\"\"\n    Calculates the wind chill index given wind velocity in km/h and temperature in celsius.\n    The result is rounded to the nearest integer using the standard North American formula.\n    \"\"\"\n    A = 13.12\n    B = 0.6215\n    C = -11.37\n    D = 0.3965\n\n    # Validate inputs\n    try:\n        v = float(velocity_kmh)\n    except (TypeError, ValueError):\n        raise ValueError(\"velocity_kmh must be a numeric value\")\n    try:\n        t = float(temp_celsius)\n    except (TypeError, ValueError):\n        raise ValueError(\"temp_celsius must be a numeric value\")\n    if v < 0:\n        raise ValueError(\"velocity_kmh must be >= 0\")\n\n    # Calculate V^0.16, handling the case where velocity is 0 km/h\n    v_pow = 0.0 if v == 0 else v ** 0.16\n\n    # Apply the North American wind chill formula\n    raw_wind_chill = A + B * t + C * v_pow + D * t * v_pow\n\n    # Round to the nearest integer and convert to int\n    rounded_wind_chill = int(round(raw_wind_chill))\n\n    return rounded_wind_chill"}
{"task_id": "Mbpp/639", "solution": "def sample_nam(names):\n    \"\"\"\n    Sums the length of names that start with an uppercase letter from a given list.\n    Names are first trimmed of leading/trailing whitespace.\n    \"\"\"\n    total_length = 0\n    for name in names:\n        trimmed_name = name.strip()\n        if trimmed_name:\n            first_char = trimmed_name[0]\n            # Check if the first character is an ASCII uppercase letter\n            if 'A' <= first_char <= 'Z':\n                total_length += len(trimmed_name)\n    return total_length"}
{"task_id": "Mbpp/643", "solution": "import re\n\ndef text_match_wordz_middle(text: str) -> bool:\n    \"\"\"\n    Checks if the input string contains 'z' in the middle of any word.\n\n    A 'z' is considered in the middle if it's not the first or last character of a word.\n    Words are defined as contiguous runs of alphanumeric characters (including underscore).\n    The check is case-insensitive.\n    \"\"\"\n    # Find all \"words\" using the \\w+ regex, which matches letters, digits, and underscores.\n    words = re.findall(r'\\w+', text)\n\n    for word in words:\n        # Convert the word to lowercase for case-insensitive 'z' matching\n        lower_word = word.lower()\n\n        # A 'z' cannot be in the middle if the word has fewer than 3 characters\n        if len(lower_word) >= 3:\n            # Check if 'z' exists anywhere in the word except the first and last characters\n            if 'z' in lower_word[1:-1]:\n                return True\n\n    return False"}
{"task_id": "Mbpp/641", "solution": "from math import sqrt\n\ndef is_nonagonal(x):\n    \"\"\"\n    Determines if a given integer x is a nonagonal number.\n    It solves the quadratic equation for k and checks if the positive root is a non-negative integer.\n    \"\"\"\n    # Based on the formula N(k) = (7*k^2 - 5*k) / 2, we solve 7k^2 - 5k - 2x = 0 for k.\n    # Using the quadratic formula k = (-b \u00b1 sqrt(b^2 - 4ac)) / 2a\n    # Here, a=7, b=-5, c=-2x\n    # k = (5 \u00b1 sqrt(25 + 56x)) / 14\n\n    # Calculate the discriminant\n    discriminant = 25 + 56 * x\n\n    # If discriminant is negative, no real roots exist, so x is not a nonagonal number.\n    if discriminant < 0:\n        return False\n\n    # Calculate the positive root\n    root = (5.0 + sqrt(discriminant)) / 14.0\n\n    # A nonagonal number must have a positive integer index k.\n    # Check if the root is an integer (with a small tolerance for float inaccuracies) and >= 1.\n    k_candidate = int(round(root))\n    if abs(root - k_candidate) < 1e-9 and k_candidate >= 1:\n        return True\n\n    return False"}
{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(arr, k):\n    \"\"\"\n    Reverses the first 'k' elements of an array.\n    Returns a new list with the first 'k' elements reversed.\n    \"\"\"\n    if arr is None:\n        raise ValueError(\"arr must be a sequence (not None)\")\n    # Convert to list to handle tuples and avoid mutating input\n    result = list(arr)\n\n    try:\n        ik = int(k)\n    except Exception:\n        raise ValueError(\"k must be an integer\")\n\n    if ik <= 0:\n        return result\n    if ik >= len(result):\n        return result[::-1]\n\n    m = ik\n    i, j = 0, m - 1\n    while i < j:\n        result[i], result[j] = result[j], result[i]\n        i += 1\n        j -= 1\n    return result"}
