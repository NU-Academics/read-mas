{"task_id": "Mbpp/440", "solution": "import re\n\ndef find_adverb_position(sentence: str) -> tuple[int, int, str]:\n    \"\"\"Finds the first adverb and its position in a given sentence.\"\"\"\n\n    class AdverbFinderError(Exception):\n        pass\n\n    class NotFoundError(AdverbFinderError):\n        pass\n\n    class AdverbPositionResult:\n        def __init__(self, start: int, end: int, adverb: str):\n            self.start = start\n            self.end = end\n            self.adverb = adverb\n\n        def to_tuple(self) -> tuple[int, int, str]:\n            return (self.start, self.end, self.adverb)\n\n    class Token:\n        def __init__(self, text: str, norm: str, start: int, end: int):\n            self.text = text\n            self.norm = norm\n            self.start = start\n            self.end = end\n\n    class TextNormalizer:\n        def normalize_and_tokenize(self, sentence: str) -> list[Token]:\n            tokens = []\n            for m in re.finditer(r\"\\S+\", sentence):\n                raw = m.group(0)\n                start_original = m.start()\n                end_original = m.end()\n\n                norm = self.strip_punctuation(raw).lower()\n\n                if norm:\n                    # Calculate the actual start and end offsets of the normalized token\n                    # within the original sentence, accounting for stripped punctuation.\n                    idx_in_raw_lower = raw.lower().find(norm)\n                    if idx_in_raw_lower >= 0:\n                        token_start = start_original + idx_in_raw_lower\n                        token_end = token_start + len(norm)\n                        tokens.append(Token(text=raw, norm=norm, start=token_start, end=token_end))\n            return tokens\n\n        def strip_punctuation(self, token: str) -> str:\n            return token.strip(\".,!?;:\\\\\\\"'()[]{}\")\n\n    class LexiconRepository:\n        _DEFAULT_ADVERBS = [\"clearly\", \"quickly\", \"silently\", \"really\", \"barely\", \"slowly\", \"sadly\", \"happily\"]\n\n        def __init__(self):\n            self._lexicon = set()\n            self.load()\n\n        def load(self) -> None:\n            self._lexicon = {adverb.lower() for adverb in self._DEFAULT_ADVERBS}\n\n        def contains(self, token: str) -> bool:\n            return token in self._lexicon\n\n    class AdverbFinderService:\n        def __init__(self, lexicon_repo: LexiconRepository, normalizer: TextNormalizer):\n            self.lexicon_repo = lexicon_repo\n            self.normalizer = normalizer\n\n        def find_first_adverb(self, sentence: str) -> AdverbPositionResult:\n            tokens = self.normalizer.normalize_and_tokenize(sentence)\n            for token in tokens:\n                if self.lexicon_repo.contains(token.norm):\n                    return AdverbPositionResult(start=token.start, end=token.end, adverb=token.norm)\n\n            raise NotFoundError(\"no adverb found in sentence\")\n\n    lexicon_repo = LexiconRepository()\n    normalizer = TextNormalizer()\n    service = AdverbFinderService(lexicon_repo, normalizer)\n\n    result = service.find_first_adverb(sentence)\n    return result.to_tuple()"}
{"task_id": "Mbpp/445", "solution": "def index_multiplication(a: Tuple[Tuple[int, ...], ...], b: Tuple[Tuple[int, ...], ...]) -> Tuple[Tuple[int, ...], ...]:\n    \"\"\"\n    Performs index-wise multiplication of elements in two same-shaped tuples of tuples.\n\n    Example:\n    index_multiplication(((1, 3), (4, 5)), ((6, 7), (3, 9))) -> ((6, 21), (12, 45))\n    \"\"\"\n    # Validate top-level is tuple and lengths match\n    if not isinstance(a, tuple) or not isinstance(b, tuple):\n        raise TypeError(\"Both arguments must be tuples of tuples of integers.\")\n    if len(a) != len(b):\n        raise ValueError(\"Top-level tuples must have the same length.\")\n\n    result_rows = []\n    for i, (ta, tb) in enumerate(zip(a, b)):\n        if not isinstance(ta, tuple) or not isinstance(tb, tuple):\n            raise TypeError(f\"Elements at index {i} must be tuples.\")\n        if len(ta) != len(tb):\n            raise ValueError(f\"Inner tuples at index {i} must have the same length.\")\n        row = []\n        for j, (x, y) in enumerate(zip(ta, tb)):\n            if not isinstance(x, int) or not isinstance(y, int):\n                raise TypeError(f\"Elements at position ({i},{j}) must be integers.\")\n            row.append(x * y)\n        result_rows.append(tuple(row))\n\n    return tuple(result_rows)"}
{"task_id": "Mbpp/446", "solution": "def count_Occurrence(tuple_data, items):\n    \"\"\"Counts the total occurrences of unique elements from a list within a tuple.\"\"\"\n    total_count = 0\n    seen_items = set()\n\n    for item in items:\n        if item not in seen_items:\n            seen_items.add(item)\n            total_count += tuple_data.count(item)\n\n    return total_count"}
