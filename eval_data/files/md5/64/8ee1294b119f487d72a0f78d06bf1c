{"task_id": "HumanEval/80", "solution": "def is_happy(s):\n    \"\"\"Checks if a string is happy.\n    A string is happy if its length is at least 3 and every 3 consecutive letters are distinct.\n    \"\"\"\n    if len(s) < 3:\n        return False\n\n    for i in range(len(s) - 2):\n        # Check if the current triplet of characters is distinct.\n        if s[i] == s[i+1] or s[i] == s[i+2] or s[i+1] == s[i+2]:\n            return False\n    return True"}
{"task_id": "HumanEval/79", "solution": "def decimal_to_binary(decimal):\n    \"\"\"Converts a non-negative decimal integer to its binary string representation.\n    The resulting string is prefixed and suffixed with \"db\".\n    \"\"\"\n    BINARY_PREFIX = \"db\"\n    BINARY_SUFFIX = \"db\"\n\n    # Validate input: it must be a non-negative integer.\n    if not isinstance(decimal, int) or decimal < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n\n    # Convert the decimal to a binary string, removing the \"0b\" prefix.\n    binary_str = bin(decimal)[2:]\n\n    # Prefix and suffix the binary string as required.\n    return BINARY_PREFIX + binary_str + BINARY_SUFFIX"}
{"task_id": "HumanEval/79", "solution": "from typing import Any\nclass InputValidator:\n    \"\"\"Validates if a value is a non-negative integer.\n    Raises ValueError for invalid types or negative numbers.\"\"\"\n    @staticmethod\n    def validate_non_negative_integer(value: Any) -> None:\n        \"\"\"Checks if the value is an integer and non-negative.\n        Raises ValueError if validation fails.\"\"\"\n        if not isinstance(value, int):\n            raise ValueError(\"Input must be an integer.\")\n        if value < 0:\n            raise ValueError(\"Input must be a non-negative integer.\")\nclass DecimalConverter:\n    \"\"\"Converts decimal integers to a specific binary string format.\n    It handles the core conversion and formatting logic.\"\"\"\n    def __init__(self, decimal: int):\n        self._decimal = decimal\n\n    def convert_to_binary_string(self) -> str:\n        \"\"\"Converts the stored decimal to its binary string representation.\n        Handles the special case for input 0.\"\"\"\n        if self._decimal == 0:\n            return \"0\"\n        return bin(self._decimal)[2:] # Remove \"0b\" prefix\n\n    def add_prefix_suffix(self, binary_string: str) -> str:\n        \"\"\"Adds 'db' prefix and suffix to the given binary string.\n        This formats the string as required.\"\"\"\n        return f\"db{binary_string}db\"\ndef decimal_to_binary(decimal):\n    \"\"\"Converts a non-negative decimal integer to a 'db'-prefixed/suffixed binary string.\n    Raises ValueError for invalid input types or negative numbers.\"\"\"\n    InputValidator.validate_non_negative_integer(decimal)\n    converter = DecimalConverter(decimal)\n    binary_str = converter.convert_to_binary_string()\n    return converter.add_prefix_suffix(binary_str)"}
{"task_id": "HumanEval/78", "solution": "from src.services.hex_key_counter_service import HexKeyCounterService\nfrom src.utils.hex_digit_converter import HexDigitConverter\nfrom src.utils.prime_digit_checker import PrimeDigitChecker\ndef hex_key(num: str) -> int:\n    \"\"\"Counts prime hexadecimal digits in a given hex string.\n    It orchestrates the counting logic using helper services.\"\"\"\n    hex_digit_converter = HexDigitConverter()\n    prime_digit_checker = PrimeDigitChecker()\n    counter_service = HexKeyCounterService(hex_digit_converter, prime_digit_checker)\n    return counter_service.count_prime_hex_digits(num)\nclass PrimeDigitChecker:\n    # Set of decimal values for prime hexadecimal digits.\n    PRIME_HEX_DECIMAL_VALUES: set[int] = {2, 3, 5, 7, 11, 13}\n\n    def is_prime(self, decimal_digit: int) -> bool:\n        \"\"\"Checks if a decimal digit is a prime hexadecimal digit.\"\"\"\n        return decimal_digit in self.PRIME_HEX_DECIMAL_VALUES\nclass HexDigitConverter:\n    def to_decimal(self, hex_digit: str) -> int:\n        \"\"\"Converts a single hexadecimal character to its decimal value.\"\"\"\n        return int(hex_digit, 16)\nclass HexKeyCounterService:\n    def __init__(self, hex_digit_converter: HexDigitConverter, prime_digit_checker: PrimeDigitChecker):\n        \"\"\"Initializes the service with converter and checker dependencies.\"\"\"\n        self._hex_digit_converter = hex_digit_converter\n        self._prime_digit_checker = prime_digit_checker\n\n    def count_prime_hex_digits(self, hex_string: str) -> int:\n        \"\"\"Counts prime hexadecimal digits in the given string.\"\"\"\n        prime_count = 0\n        for hex_digit in hex_string:\n            decimal_value = self._hex_digit_converter.to_decimal(hex_digit)\n            if self._prime_digit_checker.is_prime(decimal_value):\n                prime_count += 1\n        return prime_count"}
