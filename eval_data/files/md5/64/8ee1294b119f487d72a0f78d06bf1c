{"task_id": "HumanEval/99", "solution": "import math\ndef closest_integer(value: str) -> int:\n    \"\"\"\n    Takes a string representing a number and returns the closest integer.\n    Equidistant numbers (X.5) are rounded away from zero.\n    \"\"\"\n    try:\n        num = float(value)\n    except ValueError:\n        raise ValueError(f\"Invalid input: '{value}' is not a valid number.\")\n\n    if num == 0.0:\n        return 0\n    \n    floor_num = math.floor(num)\n    ceil_num = math.ceil(num)\n    \n    # Check if the number is exactly X.5\n    if abs(num - floor_num) == 0.5:\n        if num > 0:\n            return int(ceil_num)  # Round positive X.5 up\n        else: # num < 0\n            return int(floor_num) # Round negative X.5 down\n    else:\n        # For non-equidistant numbers, use standard rounding.\n        return int(round(num))"}
{"task_id": "HumanEval/100", "solution": "def make_a_pile(n):\n    \"\"\"\n    Calculates a pile of `n` levels of stones. The first level has `n` stones,\n    and subsequent levels add 2 stones, maintaining initial parity.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    pile = []\n    current_stones = n\n    for _ in range(n):\n        pile.append(current_stones)\n        current_stones += 2\n    return pile"}
{"task_id": "HumanEval/100", "solution": "def make_a_pile(n):\n    \"\"\"\n    Given a positive integer n, you have to make a pile of n levels of stones.\n    The first level has n stones.\n    The number of stones in the next level is:\n        - the next odd number if n is odd.\n        - the next even number if n is even.\n    Return the number of stones in each level in a list, where element at index\n    i represents the number of stones in the level (i+1).\n\n    Examples:\n    >>> make_a_pile(3)\n    [3, 5, 7]\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer.\")\n\n    pile_stones = [n]\n    if n == 1:\n        return pile_stones\n\n    current_stones = n\n    for _ in range(1, n):\n        current_stones += 2\n        pile_stones.append(current_stones)\n\n    return pile_stones"}
{"task_id": "HumanEval/101", "solution": "def words_string(s):\n    \"\"\"\n    Splits a string into words using commas or spaces as delimiters.\n    Multiple consecutive delimiters are treated as a single separator, and empty strings are removed.\n    \"\"\"\n    if not s:\n        return []\n\n    # First, replace all commas with spaces to treat them uniformly.\n    # Then, use .split() with no arguments, which splits by any whitespace\n    # and automatically handles multiple consecutive delimiters, removing empty strings.\n    processed_s = s.replace(',', ' ')\n    words = processed_s.split()\n    return words"}
{"task_id": "HumanEval/99", "solution": "import math\nclass InvalidNumberStringError(ValueError):\n    \"\"\"Custom exception for invalid number string inputs.\"\"\"\n    pass\ndef closest_integer(value: str) -> int:\n    \"\"\"\n    Calculates the closest integer to a number represented by a string.\n    Equidistant values round away from zero (e.g., 14.5 -> 15, -14.5 -> -15).\n    \"\"\"\n    try:\n        num = float(value)\n    except ValueError:\n        raise InvalidNumberStringError(f\"'{value}' is not a valid number string.\")\n\n    if num == 0:\n        return 0\n\n    floor_val = math.floor(num)\n    ceil_val = math.ceil(num)\n\n    dist_to_floor = abs(num - floor_val)\n    dist_to_ceil = abs(num - ceil_val)\n\n    if dist_to_floor < dist_to_ceil:\n        return int(floor_val)\n    elif dist_to_ceil < dist_to_floor:\n        return int(ceil_val)\n    else: # Number is equidistant from two integers (e.g., X.5), round away from zero.\n        if num > 0:\n            return int(ceil_val)\n        else:\n            return int(floor_val)"}
{"task_id": "HumanEval/101", "solution": "def words_string(s):\n    \"\"\"\n    Splits a string of words separated by commas or spaces into an array of words.\n    Handles multiple consecutive delimiters and leading/trailing delimiters.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n    \n    # Replace commas with spaces, then split by spaces, and filter out empty strings.\n    # This handles multiple consecutive delimiters and leading/trailing delimiters.\n    processed_s = s.replace(',', ' ')\n    words = [word for word in processed_s.split(' ') if word]\n    return words"}
{"task_id": "HumanEval/85", "solution": "def add(lst):\n    \"\"\"Given a non-empty list of integers lst. add the even elements that are at odd indices..\n\n\n    Examples:\n        add([4, 2, 6, 7]) ==> 2\n    \"\"\"\n    total_sum = 0\n    for i, num in enumerate(lst):\n        if (i % 2 != 0) and (num % 2 == 0):\n            total_sum += num\n    return total_sum"}
