{"task_id": "HumanEval/103", "solution": "def rounded_avg(n, m):\n    \"\"\"Computes the rounded average of integers from n to m (inclusive) and returns its binary string.\n    Returns -1 if n is greater than m.\"\"\"\n    if n > m:\n        return -1\n\n    # Calculate sum using the arithmetic series formula for efficiency.\n    count = m - n + 1\n    total_sum = count * (n + m) // 2\n    \n    # Compute floating-point average and round to the nearest integer.\n    average = total_sum / count\n    rounded_avg_int = round(average)\n    \n    # Convert the rounded integer to its binary string representation.\n    return bin(rounded_avg_int)"}
{"task_id": "HumanEval/104", "solution": "def unique_digits(x):\n    \"\"\"Given a list of positive integers x. return a sorted list of all \n    elements that hasn't any even digit.\n    \"\"\"\n    # Define the set of odd digits for efficient lookup.\n    ODD_DIGITS = {1, 3, 5, 7, 9}\n\n    def _has_only_odd_digits(number: int) -> bool:\n        \"\"\"Checks if a positive integer consists solely of odd digits.\n        Handles 0 as an even digit, consistent with design's test cases.\n        \"\"\"\n        # If the number is 0, it contains an even digit (0).\n        if number == 0:\n            return False\n\n        for digit_char in str(number):\n            digit = int(digit_char)\n            if digit not in ODD_DIGITS:\n                return False\n        return True\n\n    filtered_numbers = []\n    for num in x:\n        if _has_only_odd_digits(num):\n            filtered_numbers.append(num)\n    \n    filtered_numbers.sort()\n    return filtered_numbers"}
{"task_id": "HumanEval/104", "solution": "class DigitChecker:\n    def has_even_digit(self, number: int) -> bool:\n        \"\"\"Checks if a number contains any even digits.\n        It converts the number to a string to check each digit.\n        \"\"\"\n        num_str = str(number)\n        for digit_char in num_str:\n            digit = int(digit_char)\n            if digit % 2 == 0:\n                return True\n        return False\nclass UniqueDigitsFilter:\n    def __init__(self):\n        \"\"\"Initializes the filter with a DigitChecker instance.\n        This class orchestrates filtering and sorting numbers.\n        \"\"\"\n        self._digit_checker = DigitChecker()\n\n    def filter_and_sort(self, numbers: list[int]) -> list[int]:\n        \"\"\"Filters numbers, keeping only those with odd digits, then sorts them.\n        It utilizes the DigitChecker to evaluate each number.\n        \"\"\"\n        result = []\n        for num in numbers:\n            if not self._digit_checker.has_even_digit(num):\n                result.append(num)\n        result.sort()\n        return result\ndef unique_digits(x):\n    \"\"\"Filters a list of positive integers, keeping only those with no even digits.\n    The resulting list is returned in increasing numerical order.\n    \"\"\"\n    filter_service = UniqueDigitsFilter()\n    return filter_service.filter_and_sort(x)"}
{"task_id": "HumanEval/106", "solution": "def f(n):\n    \"\"\"Generates a list of n integers based on index-dependent rules.\n    Even indices use factorial, odd indices use sum up to the index (1-based).\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n\n    if n <= 0:\n        return []\n\n    def _factorial(num: int) -> int:\n        \"\"\"Calculates the factorial of a non-negative integer.\n        Factorial of 0 is 1, and for positive integers uses iterative multiplication.\"\"\"\n        if num < 0:\n            raise ValueError(\"Factorial is not defined for negative numbers.\")\n        if num == 0:\n            return 1\n        res = 1\n        for x in range(1, num + 1):\n            res *= x\n        return res\n\n    def _sum_up_to(num: int) -> int:\n        \"\"\"Calculates the sum of integers from 1 up to 'num'.\n        Returns 0 if 'num' is non-positive, otherwise uses the arithmetic series formula.\"\"\"\n        if num <= 0:\n            return 0\n        return num * (num + 1) // 2\n\n    result_list = []\n    for i in range(1, n + 1):\n        if i % 2 == 0:  # Even 1-based index\n            result_list.append(_factorial(i))\n        else:  # Odd 1-based index\n            result_list.append(_sum_up_to(i))\n    return result_list"}
{"task_id": "HumanEval/105", "solution": "def by_length(arr):\n    \"\"\"\n    Given an array of integers, sort the integers that are between 1 and 9 inclusive,\n    reverse the resulting array, and then replace each digit by its corresponding name from\n    \"One\", \"Two\", \"Three\", \"Four\", \"Five\", \"Six\", \"Seven\", \"Eight\", \"Nine\".\n\n    For example:\n      arr = [2, 1, 1, 4, 5, 8, 2, 3]\n            -> sort arr -> [1, 1, 2, 2, 3, 4, 5, 8]\n            -> reverse arr -> [8, 5, 4, 3, 2, 2, 1, 1]\n      return [\"Eight\", \"Five\", \"Four\", \"Three\", \"Two\", \"Two\", \"One\", \"One\"]\n\n      If the array is empty, return an empty array:\n      arr = []\n      return []\n\n      If the array has any strange number ignore it:\n      arr = [1, -1 , 55]\n            -> sort arr -> [-1, 1, 55]\n            -> reverse arr -> [55, 1, -1]\n      return = ['One']\n    \"\"\"\n    number_words = {\n        1: \"One\",\n        2: \"Two\",\n        3: \"Three\",\n        4: \"Four\",\n        5: \"Five\",\n        6: \"Six\",\n        7: \"Seven\",\n        8: \"Eight\",\n        9: \"Nine\",\n    }\n\n    if not isinstance(arr, list):\n        return []\n\n    # Filter valid numbers (1 to 9 inclusive)\n    filtered_numbers = [n for n in arr if isinstance(n, int) and 1 <= n <= 9]\n\n    if not filtered_numbers:\n        return []\n\n    # Sort the numbers in ascending order\n    filtered_numbers.sort()\n\n    # Reverse the sorted list\n    filtered_numbers.reverse()\n\n    # Convert numbers to their English word representations\n    word_list = [number_words[n] for n in filtered_numbers]\n\n    return word_list"}
{"task_id": "HumanEval/105", "solution": "def by_length(arr):\n    \"\"\"\n    Given an array of integers, sort the integers that are between 1 and 9 inclusive,\n    reverse the resulting array, and then replace each digit by its corresponding name.\n    \"\"\"\n    if not arr:\n        return []\n\n    digit_words = {\n        1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n        6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\"\n    }\n\n    # Filter for valid integers (1-9 inclusive) and ignore others.\n    filtered_numbers = [n for n in arr if isinstance(n, int) and 1 <= n <= 9]\n\n    # Sort the filtered integers in ascending order.\n    filtered_numbers.sort()\n\n    # Reverse the sorted array.\n    reversed_numbers = filtered_numbers[::-1]\n\n    # Convert each integer to its English word representation.\n    result_words = [digit_words[n] for n in reversed_numbers]\n\n    return result_words"}
{"task_id": "HumanEval/107", "solution": "def even_odd_palindrome(n: int) -> tuple[int, int]:\n    \"\"\"\n    Given a positive integer n, return a tuple that has the number of even and odd\n    integer palindromes that fall within the range(1, n), inclusive.\n    \"\"\"\n    # Validate input n according to FR1 and business rules.\n    if not isinstance(n, int) or not (1 <= n <= 1000):\n        raise ValueError(\"Input 'n' must be an integer between 1 and 1000, inclusive.\")\n\n    even_count = 0\n    odd_count = 0\n\n    def is_palindrome(num: int) -> bool:\n        \"\"\"Checks if a number is a palindrome by comparing its string representation with its reverse.\"\"\"\n        s = str(num)\n        return s == s[::-1]\n\n    # Iterate through the range [1, n] to identify and categorize palindromes.\n    for i in range(1, n + 1):\n        if is_palindrome(i):\n            # Increment appropriate counter based on parity.\n            if i % 2 == 0:\n                even_count += 1\n            else:\n                odd_count += 1\n\n    # Return the tuple of counts as per FR5.\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    \"\"\"\n    Checks if one of the three numbers is the sum of the other two, provided all are integers.\n    Returns True if conditions are met, False otherwise.\n    \"\"\"\n    if not all(isinstance(arg, int) for arg in [x, y, z]):\n        return False\n\n    return (x == y + z) or (y == x + z) or (z == x + y)"}
{"task_id": "HumanEval/108", "solution": "def count_nums(arr):\n    \"\"\"\n    Counts numbers in an array whose sum of digits is greater than zero,\n    with a specific rule for negative numbers.\n    \"\"\"\n\n    def _calculate_digit_sum(num: int) -> int:\n        \"\"\"\n        Calculates the sum of digits for an integer, applying the specific rule for negative numbers.\n        \"\"\"\n        if num == 0:\n            return 0\n\n        s_num = str(num)\n        digit_sum = 0\n\n        if s_num[0] == '-':\n            # The first digit after the minus sign contributes negatively.\n            digit_sum -= int(s_num[1])\n            # Subsequent digits contribute positively.\n            for digit_char in s_num[2:]:\n                digit_sum += int(digit_char)\n        else:\n            # All digits contribute positively for positive numbers.\n            for digit_char in s_num:\n                digit_sum += int(digit_char)\n        return digit_sum\n\n    count = 0\n    for num in arr:\n        if _calculate_digit_sum(num) > 0:\n            count += 1\n    return count"}
{"task_id": "HumanEval/107", "solution": "class PalindromeUtils:\n    @staticmethod\n    def is_palindrome(num: int) -> bool:\n        \"\"\"Checks if an integer is a palindrome by comparing its string representation with its reverse.\"\"\"\n        s_num = str(num)\n        return s_num == s_num[::-1]\nclass PalindromeService:\n    def count_even_odd_palindromes(self, n: int) -> tuple[int, int]:\n        \"\"\"Iterates from 1 to n, counting even and odd palindromes using PalindromeUtils.\"\"\"\n        even_count = 0\n        odd_count = 0\n        for i in range(1, n + 1):\n            if PalindromeUtils.is_palindrome(i):\n                if i % 2 == 0:\n                    even_count += 1\n                else:\n                    odd_count += 1\n        return (even_count, odd_count)\nMIN_N = 1\nMAX_N = 1000\ndef even_odd_palindrome(n: int) -> tuple[int, int]:\n    \"\"\"\n    Given a positive integer n, return a tuple containing the counts of even and odd\n    integer palindromes within the range (1, n), inclusive.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input 'n' must be an integer.\")\n    if not (MIN_N <= n <= MAX_N):\n        raise ValueError(f\"Input 'n' must be between {MIN_N} and {MAX_N} inclusive.\")\n\n    service = PalindromeService()\n    return service.count_even_odd_palindromes(n)"}
{"task_id": "HumanEval/106", "solution": "def f(n: int) -> list[int]:\n    \"\"\"Generates a sequence of numbers where elements are factorials or sums based on their index (1-based).\n    The function performs input validation for 'n' and calculates elements according to the rules.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    def _factorial(num: int) -> int:\n        \"\"\"Calculates the factorial of a positive integer.\"\"\"\n        res = 1\n        for i_val in range(1, num + 1):\n            res *= i_val\n        return res\n\n    def _sum_up_to(num: int) -> int:\n        \"\"\"Calculates the sum of integers from 1 up to a given positive integer.\"\"\"\n        return (num * (num + 1)) // 2\n\n    result = []\n    for i in range(1, n + 1):\n        if i % 2 == 0:  # Even index\n            result.append(_factorial(i))\n        else:  # Odd index\n            result.append(_sum_up_to(i))\n    return result"}
{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr):\n    \"\"\"Checks if an array can be sorted by right shifts.\n    Returns True for empty or already sorted arrays, or arrays that become sorted after rotation.\n    \"\"\"\n    if len(arr) <= 1:\n        return True\n\n    # Find the index of the minimum element to use as the potential start of a sorted sequence.\n    min_idx = 0\n    for i in range(1, len(arr)):\n        if arr[i] < arr[min_idx]:\n            min_idx = i\n    \n    # Rotate the array so that the minimum element is at the beginning.\n    # This creates the only possible sorted version if the array is a rotated sorted array.\n    normalized_arr = arr[min_idx:] + arr[:min_idx]\n\n    # Check if this normalized array is sorted in non-decreasing order.\n    for i in range(len(normalized_arr) - 1):\n        if normalized_arr[i] > normalized_arr[i+1]:\n            return False\n    return True"}
{"task_id": "HumanEval/108", "solution": "def count_nums(arr):\n    \"\"\"\n    Counts numbers in an array where the sum of their digits is greater than zero.\n    Handles negative numbers by treating the first digit after the sign as negative.\n    \"\"\"\n\n    def _calculate_digit_sum(num: int) -> int:\n        \"\"\"Calculates the sum of digits for an integer, correctly handling negative signs.\"\"\"\n        if num == 0:\n            return 0\n        \n        s_num = str(num)\n        total_sum = 0\n        \n        if s_num[0] == '-':\n            total_sum -= int(s_num[1])  # Apply negative sign to the first digit.\n            for digit_char in s_num[2:]:\n                total_sum += int(digit_char)\n        else:\n            for digit_char in s_num:\n                total_sum += int(digit_char)\n        \n        return total_sum\n\n    count = 0\n    for num in arr:\n        # Calculate sum of digits for each integer using the helper function.\n        if _calculate_digit_sum(num) > 0:\n            count += 1\n            \n    return count"}
{"task_id": "HumanEval/110", "solution": "def exchange(lst1, lst2):\n    \"\"\"\n    Determines if lst1 can be transformed into a list of only even numbers\n    by exchanging elements with lst2. Returns \"YES\" or \"NO\".\n    \"\"\"\n    odd_count_lst1 = 0\n    for num in lst1:\n        if num % 2 != 0:\n            odd_count_lst1 += 1\n\n    even_count_lst2 = 0\n    for num in lst2:\n        if num % 2 == 0:\n            even_count_lst2 += 1\n\n    if even_count_lst2 >= odd_count_lst1:\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/110", "solution": "def exchange(lst1, lst2):\n    \"\"\"\n    Determines if lst1 can be made entirely even by exchanging elements with lst2.\n    It checks if the count of odd numbers in lst1 is less than or equal to the count of even numbers in lst2.\n    \"\"\"\n    # Count odd numbers in lst1.\n    odd_count_lst1 = sum(1 for x in lst1 if x % 2 != 0)\n\n    # Count even numbers in lst2.\n    even_count_lst2 = sum(1 for x in lst2 if x % 2 == 0)\n\n    # If enough even numbers exist in lst2 to replace all odd numbers in lst1, return \"YES\".\n    if odd_count_lst1 <= even_count_lst2:\n        return \"YES\"\n    else:\n        return \"NO\""}
