{"task_id": "HumanEval/36", "solution": "def _count_digit_in_number(number: int, digit: int) -> int:\n    \"\"\"Counts occurrences of a specific digit in an integer.\n    Performs input validation for number and digit types and range.\n    \"\"\"\n    if not isinstance(number, int):\n        raise ValueError(\"Number must be an integer.\")\n    if not isinstance(digit, int) or not (0 <= digit <= 9):\n        raise ValueError(\"Digit must be a single integer from 0 to 9.\")\n\n    return str(abs(number)).count(str(digit))\ndef fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    total_sevens = 0\n    for i in range(1, n):\n        if i % 11 == 0 or i % 13 == 0:\n            total_sevens += _count_digit_in_number(i, 7)\n    return total_sevens"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list) -> list:\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"Input must be a list.\")\n\n    # Extract elements at even indices and sort them.\n    even_elements = [l[i] for i in range(0, len(l), 2)]\n    even_elements.sort()\n\n    # Create a new list to preserve odd-indexed elements and insert sorted even-indexed elements.\n    result = list(l)\n    even_idx_ptr = 0\n    for i in range(0, len(result), 2):\n        result[i] = even_elements[even_idx_ptr]\n        even_idx_ptr += 1\n    return result"}
{"task_id": "HumanEval/36", "solution": "class NumberUtils:\n    @staticmethod\n    def is_divisible_by_11_or_13(num: int) -> bool:\n        \"\"\"Checks if a number is divisible by 11 or 13.\n        It returns True if divisible by either 11 or 13, False otherwise.\n        \"\"\"\n        return (num % 11 == 0) or (num % 13 == 0)\n\n    @staticmethod\n    def count_digit_in_number(num: int, digit: int) -> int:\n        \"\"\"Counts occurrences of a specific digit in a number.\n        The number is converted to a string to facilitate digit counting.\n        \"\"\"\n        return str(num).count(str(digit))\ndef fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    This function iterates numbers from 1 to n-1, checking for divisibility and counting the digit '7'.\n    \"\"\"\n    total_sevens_count = 0\n    digit_to_count = 7 # The specific digit '7' to count as per requirements.\n\n    for i in range(1, n): # Iterate through numbers from 1 up to (but not including) n.\n        if NumberUtils.is_divisible_by_11_or_13(i): # Check if the current number is divisible by 11 or 13.\n            total_sevens_count += NumberUtils.count_digit_in_number(i, digit_to_count) # If divisible, count occurrences of the digit '7' in this number.\n\n    return total_sevens_count # Return the accumulated total count of the digit '7'."}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str) -> str:\n    \"\"\"\n    Decodes a string encoded with encode_cyclic by reversing the character cycling within groups of three.\n    Groups shorter than three characters are left unchanged.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n\n    decoded_parts = []\n    for i in range(0, len(s), 3):\n        group = s[i:i+3]\n        if len(group) == 3:\n            # Reverse cycle: 'bca' -> 'abc' by moving the last character to the beginning.\n            decoded_parts.append(group[2] + group[0] + group[1])\n        else:\n            # Groups with fewer than three characters remain unchanged.\n            decoded_parts.append(group)\n    return \"\".join(decoded_parts)"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list) -> list:\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"Input must be a list.\")\n\n    if not l:\n        return []\n\n    # Identify all elements in l located at even indices.\n    even_elements = []\n    for i in range(0, len(l), 2):\n        even_elements.append(l[i])\n\n    # Sort the identified even-indexed elements in ascending order.\n    even_elements.sort()\n\n    # Construct a new list, creating a copy to preserve odd-indexed elements.\n    result = list(l)\n\n    # Place the sorted even-indexed elements into the even indices of the new list.\n    even_idx_ptr = 0\n    for i in range(0, len(l), 2):\n        result[i] = even_elements[even_idx_ptr]\n        even_idx_ptr += 1\n\n    # Return the newly constructed list.\n    return result"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    Decodes a string that was cyclically encoded.\n    Groups of three characters 'bca' become 'abc'; shorter groups are unchanged.\n    \"\"\"\n    decoded_parts = []\n    for i in range(0, len(s), 3):\n        chunk = s[i:i+3]\n        if len(chunk) == 3:\n            # Apply reverse cyclic shift: 'bca' -> 'abc'\n            decoded_chunk = chunk[2] + chunk[0] + chunk[1]\n            decoded_parts.append(decoded_chunk)\n        else:\n            # Groups of fewer than three characters are unchanged.\n            decoded_parts.append(chunk)\n    return \"\".join(decoded_parts)"}
