{"task_id": "HumanEval/163", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even integers between a\n    and b (inclusive), in ascending order.\n    For example: generate_integers(2, 8) => [2, 4, 6, 8]\n    \"\"\"\n    if not isinstance(a, int):\n        raise InvalidInputError(\"Parameter 'a' must be an integer.\")\n    if a <= 0:\n        raise InvalidInputError(\"Parameter 'a' must be a positive integer.\")\n\n    if not isinstance(b, int):\n        raise InvalidInputError(\"Parameter 'b' must be an integer.\")\n    if b <= 0:\n        raise InvalidInputError(\"Parameter 'b' must be a positive integer.\")\n\n    min_val = min(a, b)\n    max_val = max(a, b)\n\n    even_integers = []\n    # Determine the first even number to start the iteration.\n    start = min_val if min_val % 2 == 0 else min_val + 1\n\n    for i in range(start, max_val + 1, 2):\n        even_integers.append(i)\n\n    return even_integers"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n\n    For example:\n    generate_integers(2, 8) => [2, 4, 6, 8]\n    generate_integers(8, 2) => [2, 4, 6, 8]\n    generate_integers(10, 14) => []\n    \"\"\"\n    if not isinstance(a, int) or not isinstance(b, int):\n        raise ValueError(\"Inputs 'a' and 'b' must be integers.\")\n    if a <= 0 or b <= 0:\n        raise ValueError(\"Inputs 'a' and 'b' must be positive integers.\")\n\n    start = min(a, b)\n    end = max(a, b)\n\n    even_digits = set()\n    for num in range(start, end + 1):\n        # Check if it's a single digit and even.\n        if 0 <= num <= 9 and num % 2 == 0:\n            even_digits.add(num)\n\n    return sorted(list(even_digits))"}
{"task_id": "HumanEval/150", "solution": "import math\ndef is_prime(n: int) -> bool:\n    \"\"\"\n    Checks if a number n is prime using an optimized trial division algorithm.\n    It handles edge cases like 0, 1, 2, and even numbers efficiently.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    # Check for factors from 3 up to sqrt(n), only odd numbers.\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\ndef x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is\n    a prime number and should return the value of y otherwise.\n    \"\"\"\n    if is_prime(n):\n        return x\n    else:\n        return y"}
