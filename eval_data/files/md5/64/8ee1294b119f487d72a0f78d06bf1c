{"task_id": "HumanEval/77", "solution": "def iscube(a: int) -> bool:\n    \"\"\"\n    Checks if an integer is a perfect cube.\n    This handles positive, negative, and zero integers accurately.\n    \"\"\"\n    if a == 0:\n        return True\n    \n    # Calculate the cube root of the absolute value and round it.\n    root = round(abs(a)**(1/3))\n    \n    # Reapply the original sign to the root.\n    if a < 0:\n        root = -root\n        \n    # Check if cubing the root returns the original number.\n    return root * root * root == a"}
{"task_id": "HumanEval/76", "solution": "import math\ndef is_simple_power(x, n):\n    \"\"\"Checks if a number x is a simple power of n.\n    Returns True if n**k = x for some integer k, False otherwise.\n    \"\"\"\n    if n <= 0:\n        return False\n    if x == 1:\n        return True\n    if x <= 0:\n        return False\n    if n == 1:\n        return False\n\n    try:\n        k = math.log(x, n)\n        return math.isclose(k, round(k), rel_tol=1e-9, abs_tol=0.0)\n    except ValueError:\n        return False\n    except Exception:\n        return False"}
{"task_id": "HumanEval/75", "solution": "def get_prime_factors(n: int) -> list[int]:\n    \"\"\"Finds all prime factors of a given integer n. Factors are listed including repetitions.\"\"\"\n    if n < 2:\n        return []\n    factors = []\n    d = 2\n    temp_n = n\n    while d * d <= temp_n:\n        if temp_n % d == 0:\n            factors.append(d)\n            while temp_n % d == 0:\n                temp_n //= d\n        d += 1\n    if temp_n > 1:\n        factors.append(temp_n)\n    return factors\ndef is_multiply_prime(a: int) -> bool:\n    \"\"\"\n    Checks if the given number is the multiplication of 3 distinct prime numbers.\n    Input 'a' must be an integer between 1 and 99 (inclusive).\n    \"\"\"\n    if not isinstance(a, int) or not (1 <= a < 100):\n        raise ValueError(\"Input 'a' must be an integer between 1 and 99 (inclusive).\")\n\n    factors = get_prime_factors(a)\n    \n    # Check if there are exactly 3 distinct prime factors.\n    # len(set(factors)) ensures distinctness and len(factors) == 3 ensures exactly three factors.\n    if len(set(factors)) == 3 and len(factors) == 3:\n        return True\n    return False"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"\n    Checks if a number x is a simple power of n.\n    x is a simple power of n if n**k = x for some non-negative integer k.\n    \"\"\"\n    if x == 1:\n        return True\n\n    if n == 1:\n        return False\n\n    current_power = n\n    while current_power < x:\n        current_power *= n\n\n    return current_power == x"}
{"task_id": "HumanEval/77", "solution": "import math\ndef iscube(a):\n    \"\"\"\n    Checks if an integer 'a' is a perfect cube.\n    Handles positive, negative, and zero inputs efficiently.\n    \"\"\"\n    if a == 0:\n        return True\n    \n    # Calculate the integer cube root of the absolute value.\n    # The (1/3) operation can introduce float inaccuracies, which round() helps to mitigate.\n    root = round(abs(a)**(1/3))\n    \n    # Check if cubing the root returns the original number.\n    # This comparison works for both positive and negative cubes after rounding.\n    return root * root * root == abs(a) and math.copysign(1, root) == math.copysign(1, a)"}
