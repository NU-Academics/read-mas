{"task_id": "HumanEval/21", "solution": "from typing import List\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for errors in the input list format or content.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\nclass InsufficientElementsError(Exception):\n    \"\"\"Exception raised when the input list has fewer than two elements.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef rescale_to_unit(numbers: List[float]) -> List[float]:\n    \"\"\" Given list of numbers, apply a linear transform such that the smallest becomes 0 and the largest becomes 1.\n    Raises InvalidInputError or InsufficientElementsError for invalid inputs.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise InvalidInputError(\"Input must be a list.\")\n    # Check if all elements are numbers (int or float) to align with List[float].\n    if not all(isinstance(n, (int, float)) for n in numbers):\n        raise InvalidInputError(\"All elements in the list must be numbers.\")\n\n    if len(numbers) < 2:\n        raise InsufficientElementsError(\"List must contain at least two elements.\")\n\n    min_val = min(numbers)\n    max_val = max(numbers)\n\n    if max_val == min_val:\n        # All numbers are identical, return a list of 0.0s to avoid division by zero.\n        return [0.0] * len(numbers)\n    else:\n        return [(x - min_val) / (max_val - min_val) for x in numbers]"}
