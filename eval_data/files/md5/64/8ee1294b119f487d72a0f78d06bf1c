{"task_id": "HumanEval/149", "solution": "class StringProcessorUtils:\n    @staticmethod\n    def is_even_length(s: str) -> bool:\n        \"\"\"Checks if a string has an even length.\n        Returns True if even, False otherwise.\"\"\"\n        return len(s) % 2 == 0\nclass StringSorter:\n    def __init__(self, strings: list[str]):\n        \"\"\"Initializes the StringSorter with a list of strings.\"\"\"\n        self._strings = strings\n\n    def filter_odd_length_strings(self) -> list[str]:\n        \"\"\"Filters out strings with odd lengths from the initial list.\n        Returns a new list containing only even-length strings.\"\"\"\n        return [s for s in self._strings if StringProcessorUtils.is_even_length(s)]\n\n    def sort_by_length_and_alphabetically(self, strings: list[str]) -> list[str]:\n        \"\"\"Sorts a list of strings by length (ascending) then alphabetically (ascending).\n        Returns a new list with the strings sorted according to these rules.\"\"\"\n        return sorted(strings, key=lambda s: (len(s), s))\ndef sorted_list_sum(lst: list[str]) -> list[str]:\n    \"\"\"\n    Processes a list of strings: filters out odd-length strings and sorts the remainder.\n    Sorting is first by length (ascending), then alphabetically (ascending) for equal lengths.\n    \"\"\"\n    sorter = StringSorter(lst)\n    even_length_strings = sorter.filter_odd_length_strings()\n    sorted_strings = sorter.sort_by_length_and_alphabetically(even_length_strings)\n    return sorted_strings"}
{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun\n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn,\n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2.\n    The function should return a tuple containing all planets whose orbits are\n    located between the orbit of planet1 and the orbit of planet2, sorted by\n    the proximity to the sun.\n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names.\n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n\n    # Defines the solar system planets in their orbital order from the Sun.\n    SOLAR_SYSTEM_PLANETS = [\n        \"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n    ]\n\n    # Helper function to find a planet's index in the list, case-insensitively.\n    def _find_planet_index(name: str) -> int | None:\n        for i, planet_name in enumerate(SOLAR_SYSTEM_PLANETS):\n            if planet_name.lower() == name.lower():\n                return i\n        return None\n\n    # Retrieve the orbital indices for both input planets.\n    index1 = _find_planet_index(planet1)\n    index2 = _find_planet_index(planet2)\n\n    # Return an empty tuple if either planet name is invalid.\n    if index1 is None or index2 is None:\n        return ()\n\n    # Determine the strict range of indices for intermediate planets.\n    start_index = min(index1, index2)\n    end_index = max(index1, index2)\n\n    # Extract the names of planets located strictly between the two input planets.\n    intermediate_planets = SOLAR_SYSTEM_PLANETS[start_index + 1 : end_index]\n\n    return tuple(intermediate_planets)"}
{"task_id": "HumanEval/150", "solution": "def x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is\n    a prime number and should return the value of y otherwise.\n\n    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n\n    \"\"\"\n    def is_prime(num: int) -> bool:\n        \"\"\"Checks if an integer is a prime number.\n        Handles non-positive integers and applies an optimized trial division.\"\"\"\n        if num <= 1:\n            return False\n        if num <= 3:\n            return True\n        if num % 2 == 0 or num % 3 == 0:\n            return False\n        i = 5\n        while i * i <= num:\n            if num % i == 0 or num % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    if is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/148", "solution": "from typing import Tuple, List, Dict\nclass PlanetModel:\n    \"\"\"Represents a planet with its name and orbital order.\n    Ensures name is a non-empty string and order is a positive integer.\"\"\"\n    def __init__(self, name: str, order: int):\n        if not isinstance(name, str) or not name:\n            raise ValueError(\"Planet name must be a non-empty string.\")\n        if not isinstance(order, int) or order <= 0:\n            raise ValueError(\"Planet order must be a positive integer.\")\n        self._name = name\n        self._order = order\n\n    def get_name(self) -> str:\n        \"\"\"Returns the planet's canonical name.\"\"\"\n        return self._name\n\n    def get_order(self) -> int:\n        \"\"\"Returns the planet's orbital order from the Sun.\"\"\"\n        return self._order\n\n    def __repr__(self) -> str:\n        \"\"\"Provides a developer-friendly string representation of the object.\"\"\"\n        return f\"PlanetModel(name='{self._name}', order={self._order})\"\nclass PlanetData:\n    \"\"\"Manages static solar system planet data, offering access by name and orbital order.\n    Pre-populates an ordered list and a dictionary for efficient lookup.\"\"\"\n    def __init__(self):\n        self._SOLAR_SYSTEM_PLANETS: List[PlanetModel] = [\n            PlanetModel(\"Mercury\", 1),\n            PlanetModel(\"Venus\", 2),\n            PlanetModel(\"Earth\", 3),\n            PlanetModel(\"Mars\", 4),\n            PlanetModel(\"Jupiter\", 5),\n            PlanetModel(\"Saturn\", 6),\n            PlanetModel(\"Uranus\", 7),\n            PlanetModel(\"Neptune\", 8),\n        ]\n        self._planets_by_name: Dict[str, PlanetModel] = {\n            planet.get_name().lower(): planet for planet in self._SOLAR_SYSTEM_PLANETS\n        }\n\n    def get_planets_by_name(self) -> Dict[str, PlanetModel]:\n        \"\"\"Returns the dictionary mapping lowercase planet names to their PlanetModel objects.\"\"\"\n        return self._planets_by_name\n\n    def get_planets_by_order(self) -> List[PlanetModel]:\n        \"\"\"Returns the list of PlanetModel objects, sorted by orbital order.\"\"\"\n        return self._SOLAR_SYSTEM_PLANETS\nclass PlanetFinderService:\n    \"\"\"Implements the core business logic to determine planets between two specified inputs.\n    It depends on a PlanetData instance for solar system information.\"\"\"\n    def __init__(self, planet_data: PlanetData):\n        self._planet_data = planet_data\n\n    def find_planets_between(self, planet1_name: str, planet2_name: str) -> Tuple[str, ...]:\n        \"\"\"Calculates and returns a tuple of planet names whose orbits are strictly between planet1 and planet2.\n        Returns an empty tuple for invalid inputs, adjacent planets, or if no planets are found between them.\"\"\"\n        planets_by_name = self._planet_data.get_planets_by_name()\n\n        p1 = planets_by_name.get(planet1_name.lower())\n        p2 = planets_by_name.get(planet2_name.lower())\n\n        if not p1 or not p2:\n            return ()\n\n        order1 = p1.get_order()\n        order2 = p2.get_order()\n\n        # Ensure order1 is always less than order2 for consistent iteration.\n        if order1 > order2:\n            order1, order2 = order2, order1\n\n        # Return empty tuple if planets are adjacent or identical (inclusive of themselves).\n        if order2 - order1 <= 1:\n            return ()\n\n        intermediate_planets = []\n        all_planets_ordered = self._planet_data.get_planets_by_order()\n\n        for planet in all_planets_ordered:\n            # Identify planets whose orbital order is strictly between the two input planets.\n            if order1 < planet.get_order() < order2:\n                intermediate_planets.append(planet.get_name())\n\n        return tuple(intermediate_planets)\nplanet_data_instance = PlanetData()\nplanet_finder_service_instance = PlanetFinderService(planet_data_instance)\ndef bf(planet1: str, planet2: str) -> Tuple[str, ...]:\n    '''\n    There are eight planets in our solar system: the closerst to the Sun\n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn,\n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2.\n    The function should return a tuple containing all planets whose orbits are\n    located between the orbit of planet1 and the orbit of planet2, sorted by\n    the proximity to the sun.\n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names.\n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    return planet_finder_service_instance.find_planets_between(planet1, planet2)"}
