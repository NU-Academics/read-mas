{"task_id": "HumanEval/3", "solution": "from typing import List\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\"\n    Detects if an account's balance, starting at zero, ever falls below zero given a list of operations.\n    Returns True if it does, False otherwise.\n    \"\"\"\n    current_balance = 0\n    for op in operations:\n        current_balance += op\n        if current_balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/0", "solution": "from typing import List\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if abs(numbers[i] - numbers[j]) < threshold:\n                return True\n    return False"}
{"task_id": "HumanEval/2", "solution": "import math\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    an integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    \"\"\"\n    return number - math.floor(number)"}
{"task_id": "HumanEval/2", "solution": "import math\ndef truncate_number(number: float) -> float:\n    \"\"\"Given a positive floating-point number, this function extracts its decimal part.\n    It returns a float `result` such that `0.0 <= result < 1.0`.\n    \"\"\"\n    if not isinstance(number, (int, float)):\n        raise TypeError(\"Input must be a number.\")\n    if number <= 0:\n        raise ValueError(\"Input number must be positive.\")\n\n    integer_part = math.floor(number)\n    decimal_part = number - integer_part\n    return decimal_part"}
{"task_id": "HumanEval/1", "solution": "from typing import List\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"Separates distinct, balanced, top-level parenthesis groups from a string.\n    All space characters are ignored before identifying groups.\n    \"\"\"\n    cleaned_string = paren_string.replace(\" \", \"\")\n\n    if not cleaned_string:\n        return []\n\n    groups = []\n    balance = 0\n    current_group_start = -1\n\n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            if balance == 0:\n                current_group_start = i\n            balance += 1\n        elif char == ')':\n            balance -= 1\n            if balance == 0 and current_group_start != -1:\n                groups.append(cleaned_string[current_group_start : i + 1])\n                current_group_start = -1\n\n    return groups"}
{"task_id": "HumanEval/0", "solution": "from typing import List\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input 'numbers' must be a list.\")\n    if not all(isinstance(n, (int, float)) for n in numbers):\n        raise TypeError(\"All elements in 'numbers' must be numeric (int or float).\")\n    if not isinstance(threshold, (int, float)):\n        raise TypeError(\"Input 'threshold' must be a numeric value.\")\n    if threshold < 0:\n        raise ValueError(\"Threshold cannot be negative.\")\n\n    # Convert all numbers to float for consistent comparison, as specified.\n    numbers_float = [float(n) for n in numbers]\n\n    n = len(numbers_float)\n    if n < 2:\n        return False\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            if abs(numbers_float[i] - numbers_float[j]) < threshold:\n                return True\n    return False"}
