{"task_id": "HumanEval/71", "solution": "import math\ndef triangle_area(a, b, c):\n    \"\"\"\n    Calculates the area of a triangle given its three side lengths, returning the result rounded to two decimal places.\n    If the side lengths are invalid (non-positive or fail triangle inequality), it returns -1.0.\n    \"\"\"\n    # Check if all side lengths are positive (BR2, FR1 Error Handling).\n    if not (a > 0 and b > 0 and c > 0):\n        return -1.0\n\n    # Check triangle inequality (BR1, FR1 Main Flow).\n    # The sum of any two sides must be greater than the third side.\n    if not ((a + b > c) and (a + c > b) and (b + c > a)):\n        return -1.0\n\n    # Calculate semi-perimeter (s) for a valid triangle (FR2).\n    s = (a + b + c) / 2\n\n    # Calculate the area using Heron's formula (FR2).\n    area = math.sqrt(s * (s - a) * (s - b) * (s - c))\n\n    # Return the calculated area rounded to two decimal places (FR3, NFR1).\n    return round(area, 2)"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst: list[int]) -> list[int]:\n    \"\"\"\n    Sorts a list by repeatedly picking the minimum, then maximum of remaining elements, and so on.\n    The original input list is not modified.\n    \"\"\"\n    if not lst:\n        return []\n\n    # Create a sorted copy for efficient min/max finding.\n    mutable_list = sorted(lst)\n    result_list = []\n    is_min_turn = True\n\n    while mutable_list:\n        if is_min_turn:\n            # Smallest element is at the beginning of the sorted list.\n            result_list.append(mutable_list.pop(0))\n        else:\n            # Largest element is at the end of the sorted list.\n            result_list.append(mutable_list.pop())\n        is_min_turn = not is_min_turn\n    \n    return result_list"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"Calculates the minimum changes needed to make an array palindromic.\n    This is determined by comparing elements from both ends of the array.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise ValueError(\"Input must be a list.\")\n    if not all(isinstance(x, int) for x in arr):\n        raise ValueError(\"All elements in the array must be integers.\")\n\n    changes_count = 0\n    left = 0\n    right = len(arr) - 1\n\n    while left < right:\n        if arr[left] != arr[right]:\n            changes_count += 1\n        left += 1\n        right -= 1\n    return changes_count"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q, w):\n    \"\"\"\n    Determines if an object q will fly based on balance and weight.\n    An object flies if it's palindromic and its sum is less than or equal to w.\n    \"\"\"\n    is_palindromic = (q == q[::-1])\n    total_weight = sum(q)\n    is_within_weight = (total_weight <= w)\n    \n    return is_palindromic and is_within_weight"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q, w):\n    \"\"\"\n    Checks if list 'q' is a palindrome and its elements' sum is less than or equal to 'w'.\n    Returns True if both conditions are met, False otherwise.\n    \"\"\"\n    # Determine if 'q' is a palindrome by comparing it to its reversed version.\n    is_palindrome = (q == q[::-1])\n\n    # Calculate the sum of all elements in 'q'.\n    list_sum = sum(q)\n\n    # Return True if both the palindrome and sum conditions are met.\n    return is_palindrome and (list_sum <= w)"}
{"task_id": "HumanEval/71", "solution": "import math\nclass Triangle:\n    def __init__(self, a: float, b: float, c: float):\n        # Validate side lengths are positive numbers.\n        if not all(isinstance(side, (int, float)) and side > 0 for side in [a, b, c]):\n            raise ValueError(\"Side lengths must be positive numbers.\")\n        self.a = float(a)\n        self.b = float(b)\n        self.c = float(c)\nclass TriangleValidator:\n    def is_valid(self, triangle: Triangle) -> bool:\n        # Checks if the sum of any two sides is greater than the third side.\n        if not (triangle.a + triangle.b > triangle.c and\n                triangle.a + triangle.c > triangle.b and\n                triangle.b + triangle.c > triangle.a):\n            return False\n        return True\nclass RoundingUtil:\n    def round_to_two_decimals(self, value: float) -> float:\n        # Rounds the input float to two decimal places.\n        return round(value, 2)\nclass TriangleService:\n    def __init__(self, validator: TriangleValidator, rounder: RoundingUtil):\n        self._validator = validator\n        self._rounder = rounder\n\n    def calculate_area(self, a: float, b: float, c: float) -> float:\n        # Orchestrates validation, area calculation, and rounding.\n        try:\n            triangle = Triangle(a, b, c)\n        except ValueError:\n            return -1.0 # Returns -1 for non-positive inputs.\n\n        if not self._validator.is_valid(triangle):\n            return -1.0\n\n        area = self._calculate_herons_area(triangle)\n        return self._rounder.round_to_two_decimals(area)\n\n    def _calculate_herons_area(self, triangle: Triangle) -> float:\n        # Applies Heron's formula to calculate the triangle's area.\n        s = (triangle.a + triangle.b + triangle.c) / 2\n        radicand = s * (s - triangle.a) * (s - triangle.b) * (s - triangle.c)\n        return math.sqrt(max(0, radicand)) # Handles potential float inaccuracies near zero.\ndef triangle_area(a: float, b: float, c: float) -> float:\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater \n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    '''\n    validator = TriangleValidator()\n    rounder = RoundingUtil()\n    service = TriangleService(validator, rounder)\n    return service.calculate_area(a, b, c)"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Calculates the minimum changes to make an array palindromic.\n    Each mismatch between symmetric elements counts as one change.\n    \"\"\"\n    n = len(arr)\n    # An array with 0 or 1 element is already a palindrome.\n    if n <= 1:\n        return 0\n\n    changes_count = 0\n    left = 0\n    right = n - 1\n\n    while left < right:\n        if arr[left] != arr[right]:\n            changes_count += 1\n        left += 1\n        right -= 1\n    return changes_count"}
