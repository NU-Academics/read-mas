{"task_id": "HumanEval/46", "solution": "def fib4(n: int) -> int:\n    \"\"\"The Fib4 number sequence computes the n-th element based on the sum of the four preceding elements.\n    It efficiently calculates the n-th element iteratively without recursion.\"\"\"\n    \n    if n < 0:\n        raise ValueError(\"Input n must be non-negative.\")\n    \n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # Initialize the first four values: fib4(0), fib4(1), fib4(2), fib4(3)\n    a, b, c, d = 0, 0, 2, 0 \n\n    for _ in range(4, n + 1):\n        next_fib4 = a + b + c + d\n        a, b, c, d = b, c, d, next_fib4\n    \n    return d"}
{"task_id": "HumanEval/46", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to the fib4 function.\n    It carries a descriptive error message.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nFIB4_BASE_CASES = {\n    0: 0,\n    1: 0,\n    2: 2,\n    3: 0\n}\ndef fib4(n: int) -> int:\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    Please write a function to efficiently compute the n-th element of the fib4 number sequence.  Do not use recursion.\n    >>> fib4(5)\n    4\n    >>> fib4(6)\n    8\n    >>> fib4(7)\n    14\n    \"\"\"\n    if n < 0:\n        raise InvalidInputError(\"Input 'n' must be non-negative.\")\n    \n    if n in FIB4_BASE_CASES:\n        return FIB4_BASE_CASES[n]\n    \n    # Initialize variables with the base cases: fib4(0), fib4(1), fib4(2), fib4(3)\n    # These represent fib4(i-4), fib4(i-3), fib4(i-2), fib4(i-1) respectively, as 'i' starts from 4.\n    a, b, c, d = FIB4_BASE_CASES[0], FIB4_BASE_CASES[1], FIB4_BASE_CASES[2], FIB4_BASE_CASES[3]\n\n    for _ in range(4, n + 1):\n        next_fib = a + b + c + d\n        a = b\n        b = c\n        c = d\n        d = next_fib\n    \n    return d"}
{"task_id": "HumanEval/45", "solution": "def triangle_area(a, h):\n    \"\"\"Given length of a side and high return area for a triangle.\n    >>> triangle_area(5, 3)\n    7.5\n    \"\"\"\n    if not (isinstance(a, (int, float)) and a > 0):\n        raise ValueError(\"Base must be a positive number.\")\n    if not (isinstance(h, (int, float)) and h > 0):\n        raise ValueError(\"Height must be a positive number.\")\n\n    area = 0.5 * float(a) * float(h)\n    return area"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    if not l:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    if n % 2 == 1:\n        # Odd number of elements\n        return sorted_l[n // 2]\n    else:\n        # Even number of elements\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        return (mid1 + mid2) / 2"}
