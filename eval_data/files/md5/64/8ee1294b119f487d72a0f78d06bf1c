{"task_id": "HumanEval/57", "solution": "def monotonic(l: list) -> bool:\n    \"\"\"Return True if list elements are monotonically increasing or decreasing.\n    An empty list or a list with one element is considered monotonic.\"\"\"\n\n    if len(l) <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(len(l) - 1):\n        if l[i] > l[i+1]:\n            is_increasing = False\n        if l[i] < l[i+1]:\n            is_decreasing = False\n        \n        # If it's neither strictly increasing nor strictly decreasing, it's not monotonic.\n        if not is_increasing and not is_decreasing:\n            return False\n    \n    return is_increasing or is_decreasing"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list) -> bool:\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    \"\"\"\n    if len(l) <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(len(l) - 1):\n        if l[i] > l[i+1]:\n            is_increasing = False\n        if l[i] < l[i+1]:\n            is_decreasing = False\n\n        if not is_increasing and not is_decreasing:\n            return False\n\n    return True"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\n    This function converts lists to sets, finds their intersection, and sorts the result.\n    \"\"\"\n    set1 = set(l1)\n    set2 = set(l2)\n    common_set = set1.intersection(set2)\n    common_list = list(common_set)\n    common_list.sort()\n    return common_list"}
{"task_id": "HumanEval/55", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input values.\n    It signals that an input does not meet domain constraints.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef fib(n: int) -> int:\n    \"\"\"Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise InvalidInputError(\"n must be a non-negative integer\")\n\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n    else:\n        # Iteratively calculate F(n) = F(n-1) + F(n-2).\n        a, b = 0, 1\n        for _ in range(2, n + 1):\n            a, b = b, a + b\n        return b"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    largest_factor = 1\n    i = 2\n    temp_n = n\n\n    # Handle factor 2 explicitly for efficiency.\n    while temp_n % 2 == 0:\n        largest_factor = 2\n        temp_n //= 2\n\n    # Iterate through odd numbers up to sqrt(temp_n).\n    while i * i <= temp_n:\n        while temp_n % i == 0:\n            largest_factor = i\n            temp_n //= i\n        i += 2\n\n    # If temp_n remains, it is the largest prime factor.\n    if temp_n > 1:\n        largest_factor = temp_n\n\n    return largest_factor"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int) -> int:\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n <= 1:\n        raise ValueError(\"Input 'n' must be greater than 1.\")\n\n    largest_factor = 1\n    temp_n = n\n\n    # Divide by 2 until temp_n is odd, updating largest_factor.\n    while temp_n % 2 == 0:\n        largest_factor = 2\n        temp_n //= 2\n\n    # Check for odd factors from 3 up to sqrt(temp_n).\n    d = 3\n    while d * d <= temp_n:\n        while temp_n % d == 0:\n            largest_factor = d\n            temp_n //= d\n        d += 2\n\n    # If temp_n is still greater than 1, it must be the largest prime factor.\n    if temp_n > 1:\n        largest_factor = temp_n\n    \n    # Raise ValueError if the original input 'n' was a prime number.\n    if largest_factor == n:\n        raise ValueError(\"Input 'n' is a prime number. The function assumes n is not prime.\")\n\n    return largest_factor"}
{"task_id": "HumanEval/58", "solution": "class ListSorter:\n    def sort_list(self, input_list: list) -> list:\n        \"\"\"Sorts a list in ascending order.\n        It uses Python's built-in sorted() function.\"\"\"\n        return sorted(input_list)\nclass UniqueElementExtractor:\n    def extract_unique(self, input_list: list) -> list:\n        \"\"\"Extracts unique elements from a list and returns them as a new list.\n        This operation uses a set for efficient uniqueness.\"\"\"\n        return list(set(input_list))\nclass CommonElementsFinder:\n    def __init__(self, sorter: ListSorter, extractor: UniqueElementExtractor):\n        \"\"\"Initializes the CommonElementsFinder with injected dependencies.\n        It takes a ListSorter and UniqueElementExtractor instance.\"\"\"\n        self._list_sorter = sorter\n        self._unique_extractor = extractor\n\n    def find_common(self, l1: list, l2: list) -> list:\n        \"\"\"Return sorted unique common elements for two lists.\n        It uses set intersection to identify common elements efficiently.\"\"\"\n        set1 = set(l1)\n        set2 = set(l2)\n        raw_common = list(set1.intersection(set2))\n        \n        # The intersection inherently provides unique elements.\n        # However, the extractor is used here to adhere to the design's conceptual separation.\n        unique_common = self._unique_extractor.extract_unique(raw_common) \n        \n        sorted_unique_common = self._list_sorter.sort_list(unique_common)\n        return sorted_unique_common\ndef common(l1: list, l2: list) -> list:\n    \"\"\"Return sorted unique common elements for two lists.\n    >>> common([1, 4, 3, 34, 653, 2, 5], [5, 7, 1, 5, 9, 653, 121])\n    [1, 5, 653]\n    >>> common([5, 3, 2, 8], [3, 2])\n    [2, 3]\n    \"\"\"\n    sorter = ListSorter()\n    extractor = UniqueElementExtractor()\n    finder = CommonElementsFinder(sorter, extractor)\n    return finder.find_common(l1, l2)"}
{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int):\n    \"\"\"sum_to_n is a function that sums numbers from 1 to n.\n    >>> sum_to_n(30)\n    465\n    >>> sum_to_n(100)\n    5050\n    >>> sum_to_n(5)\n    15\n    >>> sum_to_n(10)\n    55\n    >>> sum_to_n(1)\n    1\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"n must be an integer.\")\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer.\")\n    return n * (n + 1) // 2"}
