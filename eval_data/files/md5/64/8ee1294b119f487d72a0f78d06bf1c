{"task_id": "HumanEval/39", "solution": "import math\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input parameters.\n    It carries a descriptive error message.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass FibonacciGenerator:\n    \"\"\"Generates numbers in the Fibonacci sequence.\n    It maintains internal state to produce the next number in sequence.\n    \"\"\"\n    def __init__(self):\n        self.a = 0  # Stores F(k-2)\n        self.b = 1  # Stores F(k-1)\n\n    def generate_next(self) -> int:\n        \"\"\"Calculates and returns the next Fibonacci number.\n        The sequence generated starts 1, 2, 3, 5... when called repeatedly.\n        \"\"\"\n        fib_num = self.a + self.b\n        self.a = self.b\n        self.b = fib_num\n        return fib_num\nclass PrimalityChecker:\n    \"\"\"Determines if a given integer is a prime number.\n    It uses trial division up to the square root of the number for efficiency.\n    \"\"\"\n    def is_prime(self, num: int) -> bool:\n        \"\"\"Checks if a number is prime.\n        Returns True if prime, False otherwise.\n        \"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(num)) + 1, 2):\n            if num % i == 0:\n                return False\n        return True\nclass PrimeFibCalculator:\n    \"\"\"Orchestrates finding the n-th number that is both a Fibonacci number and a prime.\n    It uses a Fibonacci generator and a primality checker.\n    \"\"\"\n    def __init__(self, fib_generator: FibonacciGenerator, prime_checker: PrimalityChecker):\n        self.fib_generator = fib_generator\n        self.prime_checker = prime_checker\n\n    def find_nth_prime_fib(self, n: int) -> int:\n        \"\"\"Finds and returns the n-th Fibonacci number that is also prime.\n        Raises InvalidInputError if n is not a positive integer.\n        \"\"\"\n        if not isinstance(n, int) or n <= 0:\n            raise InvalidInputError(\"Input 'n' must be a positive integer.\")\n\n        prime_fib_count = 0\n        while True:\n            current_fib = self.fib_generator.generate_next()\n            # The generator produces 1, 2, 3, 5... is_prime(1) returns False, correctly.\n            if self.prime_checker.is_prime(current_fib):\n                prime_fib_count += 1\n                if prime_fib_count == n:\n                    return current_fib\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise InvalidInputError(\"Input 'n' must be a positive integer.\")\n\n    fib_gen = FibonacciGenerator()\n    prime_chk = PrimalityChecker()\n    calculator = PrimeFibCalculator(fib_gen, prime_chk)\n    return calculator.find_nth_prime_fib(n)"}
{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    Checks if there are two distinct elements in the list that sum to zero.\n    Returns True if a distinct pair is found, False otherwise.\n    \"\"\"\n    seen = set()\n    for num in l:\n        complement = -num\n        if complement in seen:\n            return True\n        seen.add(num)\n    return False"}
{"task_id": "HumanEval/24", "solution": "def largest_divisor(n: int) -> int:\n    \"\"\"\n    For a given number n, find the largest number that divides n evenly, smaller than n.\n    Raises ValueError if n is less than or equal to 1.\n\n    >>> largest_divisor(15)\n    5\n    >>> largest_divisor(7)\n    1\n    \"\"\"\n    if n <= 1:\n        raise ValueError(\"Input n must be greater than 1\")\n\n    # Iterate downwards from n // 2 to 1 to find the largest divisor.\n    for i in range(n // 2, 0, -1):\n        if n % i == 0:\n            return i\n    return 1"}
{"task_id": "HumanEval/42", "solution": "def incr_list(l: list) -> list:\n    \"\"\"Return list with elements incremented by 1.\n    Raises TypeError if input is not a list or contains non-numeric elements.\n    \"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"Input must be a list.\")\n\n    incremented_list = []\n    for item in l:\n        if not isinstance(item, (int, float)):\n            raise TypeError(\"All elements in the list must be numbers (int or float).\")\n        incremented_list.append(item + 1)\n    return incremented_list"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int) -> str:\n    \"\"\"Change numerical base of input number x to base.\n    Return string representation after the conversion.\n    \"\"\"\n    if not isinstance(x, int):\n        raise TypeError(\"Input x must be an integer.\")\n    if not isinstance(base, int):\n        raise TypeError(\"Input base must be an integer.\")\n    if not (2 <= base <= 9):\n        raise ValueError(f\"Base must be between 2 and 9, inclusive.\")\n    if x < 0:\n        raise ValueError(\"Input number x must be a non-negative integer.\")\n\n    if x == 0:\n        return \"0\"\n\n    result = []\n    while x > 0:\n        remainder = x % base\n        result.append(str(remainder))\n        x //= base\n    return \"\".join(result[::-1])"}
{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l: list[int]) -> bool:\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"Input must be a list.\")\n    for item in l:\n        if not isinstance(item, int):\n            raise ValueError(\"All elements in the list must be integers.\")\n\n    seen_elements = set()\n    for num in l:\n        complement = -num\n        if complement in seen_elements:\n            return True\n        seen_elements.add(num)\n    \n    return False"}
{"task_id": "HumanEval/45", "solution": "def triangle_area(a, h):\n    \"\"\"Given length of a side and high return area for a triangle.\n    >>> triangle_area(5, 3)\n    7.5\n    \"\"\"\n    if not isinstance(a, (int, float)) or not isinstance(h, (int, float)):\n        raise TypeError(\"Base and height must be numeric values.\")\n    if a <= 0 or h <= 0:\n        raise ValueError(\"Base and height must be positive numbers.\")\n    return 0.5 * a * h"}
{"task_id": "HumanEval/44", "solution": "class InvalidBaseError(ValueError):\n    \"\"\"Exception raised for errors in the input base.\"\"\"\n    pass\nclass InvalidNumberError(ValueError):\n    \"\"\"Exception raised for errors in the input number (e.g., negative).\"\"\"\n    pass\ndef change_base(x: int, base: int) -> str:\n    \"\"\"\n    Converts a base-10 integer x to its string representation in a specified target base (2-9).\n    Raises InvalidBaseError for invalid bases or InvalidNumberError for negative x.\n    \"\"\"\n    if not (2 <= base <= 9):\n        raise InvalidBaseError(f\"Base must be between 2 and 9, got {base}\")\n    if x < 0:\n        raise InvalidNumberError(f\"Number x must be non-negative, got {x}\")\n    if x == 0:\n        return \"0\"\n\n    result = []\n    current_x = x\n    while current_x > 0:\n        remainder = current_x % base\n        result.append(str(remainder))\n        current_x //= base\n    return \"\".join(reversed(result))"}
{"task_id": "HumanEval/47", "solution": "from typing import Union\ndef median(l: list) -> Union[int, float]:\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"Input must be a list.\")\n    if not l:\n        raise ValueError(\"Input list cannot be empty.\")\n    for item in l:\n        if not isinstance(item, (int, float)):\n            raise TypeError(\"All elements in the list must be numbers.\")\n\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    if n % 2 == 1:\n        # Odd length, return middle element.\n        return sorted_l[n // 2]\n    else:\n        # Even length, return average of two middle elements.\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        return (mid1 + mid2) / 2.0"}
