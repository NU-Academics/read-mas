{"task_id": "HumanEval/94", "solution": "import math\ndef skjkasdkd(lst):\n    \"\"\"Finds the largest prime in a list and returns the sum of its digits.\n    Assumes the input list contains at least one prime number.\n    \"\"\"\n\n    def _is_prime(n: int) -> bool:\n        \"\"\"Checks if a number is prime. Numbers <= 1 are not prime.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def _sum_digits(n: int) -> int:\n        \"\"\"Calculates the sum of the digits of a positive integer.\"\"\"\n        s = 0\n        while n > 0:\n            s += n % 10\n            n //= 10\n        return s\n\n    prime_numbers = [num for num in lst if _is_prime(num)]\n    \n    # Per the problem examples, the list is guaranteed to contain at least one prime.\n    largest_prime = max(prime_numbers)\n    \n    return _sum_digits(largest_prime)"}
{"task_id": "HumanEval/96", "solution": "def count_up_to(n: int) -> list[int]:\n    \"\"\"\n    Generates a list of all prime numbers strictly less than n.\n    This function handles input validation and edge cases for n.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    if n <= 2:\n        return []\n\n    # Implement Sieve of Eratosthenes for efficient prime generation.\n    is_prime_sieve = [True] * n\n    is_prime_sieve[0] = is_prime_sieve[1] = False\n\n    p = 2\n    while (p * p) < n:\n        if is_prime_sieve[p]:\n            for i in range(p * p, n, p):\n                is_prime_sieve[i] = False\n        p += 1\n\n    primes_list = []\n    for num in range(2, n):\n        if is_prime_sieve[num]:\n            primes_list.append(num)\n\n    return primes_list"}
{"task_id": "HumanEval/96", "solution": "def count_up_to(n):\n    \"\"\"Calculates and returns a list of all prime numbers strictly less than n. It ensures input n is a non-negative integer.\"\"\"\n\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    def _is_prime(num: int) -> bool:\n        \"\"\"Checks if a number is prime using trial division up to its square root. Numbers less than 2 are not considered prime.\"\"\"\n        if num < 2:\n            return False\n        for i in range(2, int(num**0.5) + 1):\n            if num % i == 0:\n                return False\n        return True\n\n    primes = []\n    for i in range(2, n):\n        if _is_prime(i):\n            primes.append(i)\n    return primes"}
