{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"\n    Calculates the sum of ASCII (ordinal) values of all uppercase characters in the input string.\n    Returns 0 if the string is empty or contains no uppercase characters.\n    \"\"\"\n    total_sum = 0\n    for char in s:\n        if char.isupper():\n            total_sum += ord(char)\n    return total_sum"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x: int, shift: int) -> str:\n    \"\"\"Performs a circular right shift of the digits of x, returning the result as a string.\n    If shift is strictly greater than the number of digits in x, the digits are reversed.\n    \"\"\"\n    s_x = str(x)\n    n = len(s_x)\n\n    if shift > n:\n        return s_x[::-1]\n    else:\n        effective_shift = shift % n\n        return s_x[n - effective_shift:] + s_x[:n - effective_shift]"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"Calculates the sum of ASCII values of uppercase characters in a string.\n    Raises TypeError if 's' is not a string.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input 's' must be a string.\")\n\n    total_sum = 0\n    for char in s:\n        if 'A' <= char <= 'Z': # Check if the character is an uppercase letter.\n            total_sum += ord(char)\n    return total_sum"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s: str) -> int:\n    \"\"\"\n    Counts the number of vowels in a string, where 'y' is a vowel only at the end.\n    Vowels include 'a', 'e', 'i', 'o', 'u' (case-insensitive) and 'y' (case-insensitive) if it's the last character.\n    \"\"\"\n    if not s:\n        return 0\n\n    standard_vowels = {'a', 'e', 'i', 'o', 'u'}\n    \n    count = 0\n    s_lower = s.lower()\n\n    # Iterate through characters to count standard vowels.\n    for char in s_lower:\n        if char in standard_vowels:\n            count += 1\n    \n    # Check if 'y' at the end of the word should be counted.\n    if s_lower and s_lower[-1] == 'y':\n        count += 1\n\n    return count"}
{"task_id": "HumanEval/65", "solution": "def _reverse_string(s: str) -> str:\n    \"\"\"Reverses the characters of a given string.\"\"\"\n    return s[::-1]\ndef _perform_circular_shift(s: str, shift_amount: int) -> str:\n    \"\"\"Performs a right circular shift on a string by shift_amount positions.\"\"\"\n    if not s:\n        return \"\"\n    length = len(s)\n    actual_shift = shift_amount % length\n    return s[-actual_shift:] + s[:-actual_shift]\ndef circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string. If shift > number of digits, return digits reversed.\"\"\"\n    \n    full_digits_str = str(x)\n    \n    sign = ''\n    digits_to_process = full_digits_str\n    if full_digits_str.startswith('-'):\n        sign = '-'\n        digits_to_process = full_digits_str[1:]\n\n    num_digits = len(digits_to_process)\n\n    if shift > num_digits:\n        result_digits = _reverse_string(digits_to_process)\n    else:\n        result_digits = _perform_circular_shift(digits_to_process, shift)\n    \n    return sign + result_digits"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr: list[int]) -> list[int, int] | list:\n    \"\"\"\n    Finds the smallest even-valued node from an array, returning its value and index.\n    Prioritizes the smallest index if multiple nodes share the smallest even value.\n    \"\"\"\n    if not arr:\n        return []\n\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for i, value in enumerate(arr):\n        if value % 2 == 0:\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = i\n            elif value == smallest_even_value and i < smallest_even_index:\n                # If values are equal, prioritize the node with the smaller index.\n                smallest_even_index = i\n\n    if smallest_even_index != -1:\n        return [smallest_even_value, smallest_even_index]\n    else:\n        # Returns an empty list if no even values were found.\n        return []"}
{"task_id": "HumanEval/67", "solution": "import re\ndef _parse_fruit_count(text: str, fruit_name: str) -> int:\n    \"\"\"Parses a string to extract the numeric count for a specific fruit.\n    Returns 0 if the fruit name or a valid numeric count is not found.\n    \"\"\"\n    pattern = r\"(\\d+)\\s+\" + re.escape(fruit_name)\n    match = re.search(pattern, text)\n    if match:\n        return int(match.group(1))\n    return 0\ndef fruit_distribution(s: str, n: int) -> int:\n    \"\"\"Calculates the number of mango fruits in a basket.\n    Parses fruit counts from string s and subtracts them from total n.\n    \"\"\"\n    apples = _parse_fruit_count(s, \"apples\")\n    oranges = _parse_fruit_count(s, \"oranges\")\n\n    mangoes = n - apples - oranges\n    return max(0, mangoes)"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    \"\"\"\n    Sorts a list of integers in a \"strange\" order: min, then max of remaining, then min, and so on.\n    Returns a new list with elements sorted according to this logic.\n    \"\"\"\n    if not lst:\n        return []\n\n    # Create a sorted copy to easily find min/max and avoid modifying the original list.\n    temp_list = sorted(lst)\n    result = []\n    is_min_turn = True\n\n    while temp_list:\n        if is_min_turn:\n            result.append(temp_list.pop(0))  # Take the smallest remaining element.\n        else:\n            result.append(temp_list.pop())   # Take the largest remaining element.\n        is_min_turn = not is_min_turn\n    return result"}
{"task_id": "HumanEval/67", "solution": "import re\ndef fruit_distribution(s, n):\n    \"\"\"\n    Calculates the number of mangoes in a basket given apple/orange counts and total fruits.\n    Parses the input string for fruit counts and validates all numerical inputs.\n    \"\"\"\n\n    # Ensure total fruit count (n) is non-negative.\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Total fruit count cannot be negative.\")\n\n    # Parse apple and orange counts using a regex pattern.\n    # Assumes the input string follows the \"X apples and Y oranges\" format.\n    match = re.search(r\"(\\d+)\\s*apples?\\s*and\\s*(\\d+)\\s*oranges?\", s)\n\n    if not match:\n        raise ValueError(\n            \"Input string format is invalid. Expected 'X apples and Y oranges'.\"\n        )\n\n    try:\n        num_apples = int(match.group(1))\n        num_oranges = int(match.group(2))\n    except ValueError as e:\n        # This exception path is less likely due to \\d+ in regex, but provides robustness.\n        raise ValueError(\n            f\"Could not extract valid integer counts for apples or oranges: {e}\"\n        ) from e\n\n    # Ensure parsed apple and orange counts are non-negative.\n    if num_apples < 0 or num_oranges < 0:\n         raise ValueError(\"Parsed apple or orange count cannot be negative.\")\n\n    # Calculate the number of mangoes.\n    sum_apples_oranges = num_apples + num_oranges\n    num_mangoes = n - sum_apples_oranges\n\n    # Validate the overall fruit distribution.\n    if num_mangoes < 0:\n        raise ValueError(\n            \"Impossible fruit distribution: sum of apples and oranges exceeds total fruits.\"\n        )\n\n    return num_mangoes"}
{"task_id": "HumanEval/69", "solution": "from typing import List, Dict\ndef search(lst: List[int]) -> int:\n    \"\"\"\n    Finds the greatest integer x in lst such that its frequency is >= x.\n    Returns -1 if no such integer exists, as per business rules.\n    \"\"\"\n    frequencies: Dict[int, int] = {}\n    for num in lst:\n        frequencies[num] = frequencies.get(num, 0) + 1\n    \n    candidates: List[int] = []\n    for num, freq in frequencies.items():\n        # Check if the frequency of the number is at least its value.\n        if freq >= num:\n            candidates.append(num)\n    \n    # If candidates exist, return the maximum; otherwise, return -1.\n    if not candidates:\n        return -1\n    else:\n        return max(candidates)"}
{"task_id": "HumanEval/69", "solution": "from collections import Counter\ndef search(lst):\n    '''\n    Finds the greatest positive integer in a list whose frequency is greater than or equal to its value.\n    Returns -1 if no such integer exists, or raises ValueError for invalid input.\n    '''\n    if not lst:\n        raise ValueError(\"Input list cannot be empty.\")\n    \n    for item in lst:\n        if not isinstance(item, int) or item <= 0:\n            raise ValueError(\"All elements in the list must be positive integers.\")\n            \n    frequencies = Counter(lst)\n    \n    greatest_qualifying = -1\n    for num, freq in frequencies.items():\n        if freq >= num:\n            greatest_qualifying = max(greatest_qualifying, num)\n            \n    return greatest_qualifying"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Given an array representing a branch of a tree that has non-negative integer nodes, your task is to pluck one of the nodes and return it.\n    The plucked node should be the node with the smallest even value, returning [value, index], or [] if no even values or an empty array.\n    \"\"\"\n    if not arr:\n        return []\n\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for i, node in enumerate(arr):\n        if node % 2 == 0:  # Check if the node is even\n            if node < smallest_even_value:\n                smallest_even_value = node\n                smallest_even_index = i\n            elif node == smallest_even_value and i < smallest_even_index:\n                # If an equal smallest even value is found with a smaller index, update index.\n                smallest_even_index = i\n\n    if smallest_even_index != -1:\n        return [smallest_even_value, smallest_even_index]\n    else:\n        return []"}
