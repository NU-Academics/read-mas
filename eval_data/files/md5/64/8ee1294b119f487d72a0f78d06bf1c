{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    This uses an optimized trial division method.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True"}
{"task_id": "HumanEval/34", "solution": "def unique(l: list) -> list:\n    \"\"\"Returns a new list containing all unique elements from the input list 'l', sorted in ascending order.\n    Raises TypeError if the input is not a list.\n    \"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"Input must be a list.\")\n\n    # Convert the list to a set to efficiently remove duplicate elements.\n    # Then convert the set back to a list and sort it in ascending order.\n    return sorted(list(set(l)))"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list) -> list:\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"Input must be a list.\")\n\n    indices_to_sort = [i for i in range(len(l)) if i % 3 == 0]\n    elements_to_sort = [l[i] for i in indices_to_sort]\n\n    try:\n        elements_to_sort.sort()\n    except TypeError as e:\n        raise TypeError(f\"Elements in the list are not comparable: {e}\")\n\n    result_list = list(l)\n    sorted_idx = 0\n    for i in indices_to_sort:\n        result_list[i] = elements_to_sort[sorted_idx]\n        sorted_idx += 1\n\n    return result_list"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function reorders elements in a list, sorting values at indices divisible by three.\n    It returns a new list, leaving other elements unchanged.\n    \"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"Input 'l' must be a list.\")\n\n    if not l:\n        return []\n\n    # FR2: Identify all indices divisible by three and extract their values.\n    third_indices = []\n    third_values = []\n    for i in range(len(l)):\n        if i % 3 == 0:\n            third_indices.append(i)\n            third_values.append(l[i])\n\n    # FR3: Sort the extracted values in ascending order.\n    sorted_third_values = sorted(third_values)\n\n    # FR4: Construct a new list identical to 'l', and FR5: place sorted values.\n    new_list = list(l) # Create a shallow copy to not modify the original list.\n\n    sorted_values_iter = iter(sorted_third_values)\n    for index in third_indices:\n        new_list[index] = next(sorted_values_iter)\n            \n    # FR6: Return the newly constructed list.\n    return new_list"}
{"task_id": "HumanEval/32", "solution": "import math\nTOLERANCE = 1e-6\nMAX_ITERATIONS = 1000\nSEARCH_RANGE = 1000.0\ndef poly(xs: list, x: float) -> float:\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\ndef find_zero(xs: list) -> float:\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    a = -SEARCH_RANGE\n    b = SEARCH_RANGE\n\n    # Expand the search interval until a root is bracketed, leveraging problem guarantees.\n    # A limit prevents infinite expansion for pathological cases.\n    val_a = poly(xs, a)\n    val_b = poly(xs, b)\n    while val_a * val_b >= 0:\n        a *= 2\n        b *= 2\n        val_a = poly(xs, a)\n        val_b = poly(xs, b)\n        if abs(a) > 1e100 or abs(b) > 1e100:\n            return 0.0\n\n    # Perform bisection to find the zero.\n    for _ in range(MAX_ITERATIONS):\n        mid = (a + b) / 2\n        poly_mid_val = poly(xs, mid)\n\n        if abs(poly_mid_val) < TOLERANCE or (b - a) / 2 < TOLERANCE:\n            return mid\n            \n        if poly(xs, a) * poly_mid_val < 0:\n            b = mid\n        else:\n            a = mid\n    \n    # Return the best approximation after maximum iterations.\n    return (a + b) / 2"}
