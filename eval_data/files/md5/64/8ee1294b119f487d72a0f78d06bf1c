{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums):\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty sub-array\n    of nums.\n    Example\n    minSubArraySum([2, 3, 4, 1, 2, 4]) == 1\n    minSubArraySum([-1, -2, -3]) == -6\n    \"\"\"\n    if not nums:\n        raise ValueError(\"Input array 'nums' cannot be empty.\")\n\n    current_min = nums[0]\n    overall_min = nums[0]\n\n    for i in range(1, len(nums)):\n        current_min = min(nums[i], current_min + nums[i])\n        overall_min = min(overall_min, current_min)\n\n    return overall_min"}
{"task_id": "HumanEval/116", "solution": "def _count_set_bits(n: int) -> int:\n    \"\"\"\n    Counts the number of '1's in the binary representation of a non-negative integer.\n    Handles negative numbers by taking absolute value for bit counting.\n    \"\"\"\n    count = 0\n    num = abs(n)\n    while num > 0:\n        num &= (num - 1)\n        count += 1\n    return count\ndef sort_array(arr: list[int]) -> list[int]:\n    \"\"\"\n    Sorts an array of integers based on the count of ones in their binary representation.\n    For equal counts, elements are sorted by their decimal value.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input must be a list.\")\n\n    return sorted(arr, key=lambda x: (_count_set_bits(x), x))"}
{"task_id": "HumanEval/115", "solution": "import math\ndef max_fill(grid, capacity):\n    \"\"\"\n    Calculates the total number of times buckets need to be lowered to empty all wells.\n    Each '1' in a grid cell represents one unit of water.\n    \"\"\"\n    total_bucket_lowers = 0\n\n    for well_data in grid:\n        water_in_current_well = sum(well_data)\n\n        operations_for_current_well = 0\n        if water_in_current_well > 0:\n            operations_for_current_well = math.ceil(water_in_current_well / capacity)\n        \n        total_bucket_lowers += operations_for_current_well\n\n    return int(total_bucket_lowers)"}
{"task_id": "HumanEval/114", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef minSubArraySum(nums: list[int]) -> int:\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty sub-array.\n    \n    This function implements a variant of Kadane's algorithm to find the minimum\n    subarray sum with O(n) time complexity.\n    \n    Args:\n        nums: A list of integers.\n        \n    Returns:\n        The minimum sum of any non-empty sub-array.\n        \n    Raises:\n        InvalidInputError: If the input is not a list, is empty, or contains non-integer elements.\n        \n    Example:\n    minSubArraySum([2, 3, 4, 1, 2, 4]) == 1\n    minSubArraySum([-1, -2, -3]) == -6\n    \"\"\"\n    # Input validation\n    if not isinstance(nums, list):\n        raise InvalidInputError(\"Input must be a list.\")\n    if not nums:\n        raise InvalidInputError(\"Input list cannot be empty.\")\n    for item in nums:\n        if not isinstance(item, int):\n            raise InvalidInputError(\"All elements in the list must be integers.\")\n\n    min_so_far = float('inf')\n    current_min = 0\n\n    for x in nums:\n        current_min += x\n        min_so_far = min(min_so_far, current_min)\n        # If current_min becomes positive, reset it to 0.\n        # This is because a positive current_min will not contribute to a smaller\n        # sum for subsequent subarrays. We are looking for the minimum sum,\n        # so we want to keep accumulating negative values and discard positive\n        # prefix sums that would only increase the sum.\n        if current_min > 0:\n            current_min = 0\n            \n    return int(min_so_far)"}
{"task_id": "HumanEval/117", "solution": "from typing import List\nVOWELS = {'a', 'e', 'i', 'o', 'u'}\ndef _is_vowel(char: str) -> bool:\n    \"\"\"Checks if a character is a vowel (case-insensitive).\n    Uses the global VOWELS set for efficient lookup.\"\"\"\n    return char.lower() in VOWELS\ndef _count_consonants(word: str) -> int:\n    \"\"\"Counts consonants in a given word.\n    Considers only alphabetic characters, excluding vowels.\"\"\"\n    count = 0\n    for char in word:\n        if char.isalpha() and not _is_vowel(char):\n            count += 1\n    return count\ndef select_words(s: str, n: int) -> List[str]:\n    \"\"\"Given a string s and a natural number n, you have been tasked to implement \n    a function that returns a list of all words from string s that contain exactly \n    n consonants, in order these words appear in the string s.\n    If the string s is empty then the function should return an empty list.\n    \"\"\"\n    # FR6: Return an empty list if the input string `s` is empty.\n    if not s:\n        return []\n\n    result_words = []\n    # FR2: Split the input string `s` into individual words.\n    words = s.split()\n\n    for word in words:\n        # FR3: Count the number of consonants in each word.\n        consonant_count = _count_consonants(word)\n        # FR4: Identify words with exactly `n` consonants.\n        if consonant_count == n:\n            # FR5: Collect matching words, preserving original order.\n            result_words.append(word)\n    \n    return result_words"}
{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"Given a string s and a natural number n, you have been tasked to implement \n    a function that returns a list of all words from string s that contain exactly \n    n consonants, in order these words appear in the string s.\n    If the string s is empty then the function should return an empty list.\n    Note: you may assume the input string contains only letters and spaces.\n    Examples:\n    select_words(\"Mary had a little lamb\", 4) ==> [\"little\"]\n    select_words(\"Mary had a little lamb\", 3) ==> [\"Mary\", \"lamb\"]\n    select_words(\"simple white space\", 2) ==> []\n    select_words(\"Hello world\", 4) ==> [\"world\"]\n    select_words(\"Uncle sam\", 3) ==> [\"Uncle\"]\n    \"\"\"\n    CONSONANTS = {\n        'b', 'c', 'd', 'f', 'g', 'h', 'j', 'k', 'l', 'm',\n        'n', 'p', 'q', 'r', 's', 't', 'v', 'w', 'x', 'y', 'z'\n    }\n\n    def _count_consonants(word: str) -> int:\n        \"\"\"Counts consonants in a word. Assumes word contains only letters.\"\"\"\n        count = 0\n        for char in word.lower():\n            if char in CONSONANTS:\n                count += 1\n        return count\n\n    if not s:\n        return []\n\n    result = []\n    # Splits by any whitespace and handles multiple spaces as delimiters.\n    words = s.split()\n\n    for word in words:\n        if _count_consonants(word) == n:\n            result.append(word)\n    return result"}
{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"Finds the closest vowel from the right side of a word that is surrounded by two consonants.\n    Vowels at the word's beginning or end are not considered; returns an empty string if no such vowel is found.\n    \"\"\"\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    def is_vowel(char: str) -> bool:\n        \"\"\"Checks if a character is a vowel (case-insensitive).\"\"\"\n        return char.lower() in VOWELS\n\n    def is_consonant(char: str) -> bool:\n        \"\"\"Checks if a character is a consonant.\"\"\"\n        return char.isalpha() and not is_vowel(char)\n\n    n = len(word)\n    if n < 3:\n        return \"\"\n\n    # Iterate from right to left, excluding the first and last characters\n    for i in range(n - 2, 0, -1):\n        current_char = word[i]\n        left_char = word[i - 1]\n        right_char = word[i + 1]\n\n        if is_vowel(current_char) and is_consonant(left_char) and is_consonant(right_char):\n            return current_char\n            \n    return \"\""}
{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"You are given a word. Your task is to find the closest vowel that stands between \n    two consonants from the right side of the word (case sensitive).\n    \n    Vowels in the beginning and ending doesn't count. Return empty string if you didn't\n    find any vowel met the above condition. \n\n    You may assume that the given string contains English letter only.\n\n    Example:\n    get_closest_vowel(\"yogurt\") ==> \"u\"\n    get_closest_vowel(\"FULL\") ==> \"U\"\n    get_closest_vowel(\"quick\") ==> \"\"\n    get_closest_vowel(\"ab\") ==> \"\"\n    \"\"\"\n\n    _VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    def is_vowel(char: str) -> bool:\n        \"\"\"Checks if a character is an English vowel (case-insensitive).\"\"\"\n        return char.lower() in _VOWELS\n\n    def is_consonant(char: str) -> bool:\n        \"\"\"Checks if a character is an English consonant (case-insensitive).\"\"\"\n        # Assumes char is a single English letter as per constraints.\n        return char.isalpha() and not is_vowel(char)\n\n    n = len(word)\n    if n < 3:\n        return \"\"\n\n    # Iterate from right to left, skipping the first and last characters.\n    # The range is from index n-2 down to 1 (inclusive).\n    for i in range(n - 2, 0, -1):\n        current_char = word[i]\n        left_char = word[i - 1]\n        right_char = word[i + 1]\n\n        if (is_vowel(current_char) and\n                is_consonant(left_char) and\n                is_consonant(right_char)):\n            return current_char\n            \n    return \"\""}
{"task_id": "HumanEval/119", "solution": "def match_parens(lst: list[str]) -> str:\n    \"\"\"\n    Checks if concatenating two strings of parentheses in some order forms a balanced string.\n    Returns 'Yes' if a balanced string can be formed, 'No' otherwise.\n    \"\"\"\n    def is_balanced(s: str) -> bool:\n        \"\"\"\n        Determines if a string of parentheses is balanced.\n        It requires total counts to match and balance to never be negative.\n        \"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    s1, s2 = lst[0], lst[1]\n\n    if is_balanced(s1 + s2):\n        return 'Yes'\n\n    if is_balanced(s2 + s1):\n        return 'Yes'\n\n    return 'No'"}
