{"task_id": "HumanEval/145", "solution": "from typing import List\ndef _sum_digits(n: int) -> int:\n    \"\"\"Calculates the sum of the absolute value of digits of an integer.\n    It converts the number to a string and sums its digits.\"\"\"\n    s = 0\n    for digit in str(abs(n)):\n        s += int(digit)\n    return s\ndef order_by_points(nums: List[int]) -> List[int]:\n    \"\"\"Sorts a list of integers by the sum of their digits, then by original index for tie-breaking.\n    Returns an empty list if the input is empty.\"\"\"\n    if not nums:\n        return []\n\n    # Create tuples (sum_of_digits, original_index, number) to facilitate custom sorting.\n    decorated_list = [(_sum_digits(num), i, num) for i, num in enumerate(nums)]\n\n    # Sorts primarily by sum_of_digits (ascending), then by original_index (ascending).\n    decorated_list.sort()\n\n    # Extract and return the original numbers in the sorted order.\n    return [item[2] for item in decorated_list]"}
{"task_id": "HumanEval/145", "solution": "from typing import List\ndef order_by_points(nums: List[int]) -> List[int]:\n    \"\"\"\n    Sorts a list of integers based on the sum of their digits,\n    using the original index as a tie-breaker.\n    \"\"\"\n    if not nums:\n        return []\n\n    def _calculate_digit_sum(number: int) -> int:\n        \"\"\"Calculates the sum of the absolute digits of an integer, raising TypeError for non-integers.\"\"\"\n        if not isinstance(number, int):\n            raise TypeError(\"Input must be an integer.\")\n        return sum(int(digit) for digit in str(abs(number)))\n\n    entries = []\n    for i, num in enumerate(nums):\n        digit_sum = _calculate_digit_sum(num)\n        entries.append((num, digit_sum, i))\n\n    entries.sort(key=lambda entry: (entry[1], entry[2]))\n\n    return [entry[0] for entry in entries]"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums: list[int]) -> int:\n    \"\"\"\n    Counts numbers in an array that are greater than 10 and\n    have both first and last digits (absolute value) as odd.\n    \"\"\"\n\n    def _is_odd(digit: int) -> bool:\n        \"\"\"Checks if a given digit is odd.\"\"\"\n        return abs(digit) % 2 == 1\n\n    def _get_first_digit(num: int) -> int:\n        \"\"\"Extracts the first digit of a number (absolute value).\"\"\"\n        s_num = str(abs(num))\n        return int(s_num[0])\n\n    def _get_last_digit(num: int) -> int:\n        \"\"\"Extracts the last digit of a number (absolute value).\"\"\"\n        return abs(num) % 10\n\n    def _is_special(num: int) -> bool:\n        \"\"\"\n        Checks if a number meets all filter criteria.\n        It must be greater than 10, with odd first and last digits.\n        \"\"\"\n        if num <= 10:\n            return False\n\n        first_digit = _get_first_digit(num)\n        last_digit = _get_last_digit(num)\n\n        return _is_odd(first_digit) and _is_odd(last_digit)\n\n    count = 0\n    for num in nums:\n        if _is_special(num):\n            count += 1\n    return count"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n: int) -> int:\n    \"\"\"Calculates the number of specific integer triples from a generated sequence.\n    It counts triples (a[i], a[j], a[k]) where i < j < k and their sum is a multiple of 3.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer.\")\n\n    # Generate array a based on the formula.\n    arr = [i * i - i + 1 for i in range(1, n + 1)]\n\n    # If the array has fewer than 3 elements, no triples can be formed.\n    if len(arr) < 3:\n        return 0\n\n    # Count occurrences of elements with remainder 0, 1, and 2 when divided by 3.\n    remainder_counts = {0: 0, 1: 0, 2: 0}\n    for x in arr:\n        remainder_counts[x % 3] += 1\n    \n    count0 = remainder_counts[0]\n    count1 = remainder_counts[1]\n    count2 = remainder_counts[2]\n\n    total_triples = 0\n    # Combinatorial logic for triples (a[i], a[j], a[k]) whose sum is a multiple of 3.\n    # Case 1: All three elements have remainder 0 (mod 3).\n    total_triples += (count0 * (count0 - 1) * (count0 - 2)) // 6\n    # Case 2: All three elements have remainder 1 (mod 3).\n    total_triples += (count1 * (count1 - 1) * (count1 - 2)) // 6\n    # Case 3: All three elements have remainder 2 (mod 3).\n    total_triples += (count2 * (count2 - 1) * (count2 - 2)) // 6\n    # Case 4: One element of each remainder (0, 1, 2) (mod 3).\n    total_triples += count0 * count1 * count2\n\n    return total_triples"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n: int) -> int:\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) from an array 'a'\n    where a[x] = x*x - x + 1, such that i < j < k and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer.\")\n\n    a = [(i * i - i + 1) for i in range(1, n + 1)]\n    count = 0\n    length = len(a)\n\n    if length < 3:\n        return 0\n\n    for i in range(length):\n        for j in range(i + 1, length):\n            for k in range(j + 1, length):\n                if (a[i] + a[j] + a[k]) % 3 == 0:\n                    count += 1\n    return count"}
