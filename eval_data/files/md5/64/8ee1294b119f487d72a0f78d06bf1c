{"task_id": "HumanEval/1", "solution": "from typing import List\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"\n    Input to this function is a string containing multiple groups of nested parentheses.\n    Your goal is to separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    # Adhering to FR2: ignore any space characters. This replaces Utils.clean_string from the design.\n    cleaned_string = paren_string.replace(' ', '')\n    \n    result_groups: List[str] = []\n    balance_counter = 0\n    current_group_start = 0\n\n    # Adhering to FR3: identify balanced and non-nested groups.\n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            balance_counter += 1\n        elif char == ')':\n            balance_counter -= 1\n        # Other characters are implicitly ignored as they don't affect the balance.\n\n        if balance_counter == 0 and i >= current_group_start:\n            # Found a balanced, non-nested group. Adhering to FR4.\n            group = cleaned_string[current_group_start : i + 1]\n            if group: # Ensure it's not an empty string.\n                result_groups.append(group)\n            current_group_start = i + 1\n        elif balance_counter < 0:\n            # Unbalanced closing parenthesis detected. Reset for the next potential group.\n            balance_counter = 0\n            current_group_start = i + 1 # Start looking for a new group after this invalid character.\n\n    # Adhering to FR5: return a list of separated groups.\n    return result_groups"}
{"task_id": "HumanEval/5", "solution": "from typing import List\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\"Insert a number 'delimeter' between every two consecutive elements of input list `numbers`.\n    Returns a new list with the delimeter interspersed, leaving the original list unchanged.\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/4", "solution": "from typing import List\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\"For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset. MAD is the average absolute difference\n    between each element and the mean.\n    \"\"\"\n    if not numbers:\n        raise ValueError(\"Input list cannot be empty for MAD calculation.\")\n\n    mean = sum(numbers) / len(numbers)\n    absolute_differences_sum = sum(abs(x - mean) for x in numbers)\n    return absolute_differences_sum / len(numbers)"}
{"task_id": "HumanEval/5", "solution": "from typing import List\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'.\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n    \n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/7", "solution": "from typing import List\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    return [s for s in strings if substring in s]"}
{"task_id": "HumanEval/4", "solution": "from typing import List\nclass EmptyInputError(Exception):\n    \"\"\"Custom exception for when an input list is empty.\"\"\"\n    def __init__(self, message=\"Input list cannot be empty for MAD calculation.\"):\n        self.message = message\n        super().__init__(self.message)\nclass MADCalculator:\n    \"\"\"\n    Provides methods for calculating Mean Absolute Deviation components.\n    \"\"\"\n\n    def calculate_mean(self, numbers: List[float]) -> float:\n        \"\"\"Computes the arithmetic mean of a list of numbers.\"\"\"\n        if not numbers:\n            raise EmptyInputError(\"Cannot calculate mean of an empty list.\")\n        return sum(numbers) / len(numbers)\n\n    def calculate_absolute_deviations(self, numbers: List[float], mean: float) -> List[float]:\n        \"\"\"Calculates the absolute difference between each number in the list and the given mean.\"\"\"\n        return [abs(x - mean) for x in numbers]\n\n    def calculate_mad(self, absolute_deviations: List[float]) -> float:\n        \"\"\"Computes the mean of a list of absolute deviations.\"\"\"\n        if not absolute_deviations:\n            raise EmptyInputError(\"Cannot calculate MAD from an empty list of deviations.\")\n        return sum(absolute_deviations) / len(absolute_deviations)\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\"\n    For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset. MAD is the average absolute difference\n    between each element and the dataset's mean.\n    \"\"\"\n    if not numbers:\n        raise EmptyInputError(\"Input list for mean_absolute_deviation cannot be empty.\")\n\n    calculator = MADCalculator()\n    mean_value = calculator.calculate_mean(numbers)\n    absolute_deviations = calculator.calculate_absolute_deviations(numbers, mean_value)\n    mad_value = calculator.calculate_mad(absolute_deviations)\n    return mad_value"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    if not numbers:\n        return (0, 1)\n\n    current_sum = 0\n    current_product = 1\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n    return (current_sum, current_product)"}
{"task_id": "HumanEval/6", "solution": "from typing import List\nclass ParenthesesParserError(Exception):\n    \"\"\"Base exception for parser errors.\"\"\"\n    pass\nclass InvalidParenthesesError(ParenthesesParserError):\n    \"\"\"Raised when a parentheses group is malformed.\"\"\"\n    pass\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"\n    Parses a string of space-separated parentheses groups to find the deepest nesting level for each.\n    Raises TypeError for non-string input or InvalidParenthesesError for malformed groups.\n    \"\"\"\n    if not isinstance(paren_string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    if not paren_string.strip():\n        return []\n\n    def _calculate_depth_for_group(group: str) -> int:\n        \"\"\"Calculates max nesting depth for a single parentheses group.\"\"\"\n        current_depth = 0\n        max_depth = 0\n        for char in group:\n            if char == '(':\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif char == ')':\n                current_depth -= 1\n            else:\n                raise InvalidParenthesesError(f\"Invalid character '{char}' found in group: {group}\")\n\n            if current_depth < 0:\n                raise InvalidParenthesesError(f\"Unmatched closing parenthesis in group: {group}\")\n\n        if current_depth != 0:\n            raise InvalidParenthesesError(f\"Unmatched opening parenthesis in group: {group}\")\n        return max_depth\n\n    groups = paren_string.split(' ')\n    results = []\n    for group in groups:\n        if group: # Handle potential empty strings from multiple spaces or leading/trailing\n            results.append(_calculate_depth_for_group(group))\n    return results"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    \"\"\"\n    current_sum = 0\n    current_product = 1\n\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n\n    return (current_sum, current_product)"}
{"task_id": "HumanEval/6", "solution": "from typing import List\ndef _calculate_max_nesting_single_group(group_string: str) -> int:\n    \"\"\"Calculates the deepest nesting level for a single group of parentheses.\n    Returns 0 if the string is empty or contains no parentheses.\n    \"\"\"\n    max_nesting = 0\n    current_nesting = 0\n    for char in group_string:\n        if char == '(':\n            current_nesting += 1\n        elif char == ')':\n            current_nesting -= 1\n        max_nesting = max(max_nesting, current_nesting)\n    return max_nesting\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    if not paren_string.strip(): # Return an empty list for empty or whitespace-only input.\n        return []\n    \n    groups = paren_string.split(' ')\n    results = []\n    for group in groups:\n        results.append(_calculate_max_nesting_single_group(group))\n    return results"}
{"task_id": "HumanEval/9", "solution": "from typing import List, Tuple\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\"\n    From a given list of integers, generate a list of rolling maximum element\n    found until given moment in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    rolling_max_list: List[int] = []\n    current_max: int = float('-inf') # Initialize to handle negative numbers correctly.\n\n    for number in numbers:\n        if number > current_max:\n            current_max = number\n        rolling_max_list.append(current_max)\n\n    return rolling_max_list"}
{"task_id": "HumanEval/9", "solution": "from typing import List\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    \"\"\"\n    if not numbers:\n        return []\n\n    rolling_maximums = []\n    current_max = float('-inf') # Initialize with negative infinity for correct handling of negative numbers.\n\n    for number in numbers:\n        current_max = max(current_max, number)\n        rolling_maximums.append(current_max)\n\n    return rolling_maximums"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    if len(a) != len(b):\n        raise ValueError(\"Input strings must have the same length.\")\n\n    if not (all(c in '01' for c in a) and all(c in '01' for c in b)):\n        raise ValueError(\"Input strings must contain only '0's and '1's.\")\n\n    result_bits = []\n    for char_a, char_b in zip(a, b):\n        if char_a == char_b:\n            result_bits.append('0')\n        else:\n            result_bits.append('1')\n            \n    return \"\".join(result_bits)"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\"Out of list of strings, return the longest one.\n    Handles type validation, empty list, and tie-breaking by first occurrence.\n    \"\"\"\n    if not isinstance(strings, list):\n        raise TypeError(\"Input 'strings' must be a list.\")\n\n    if not strings:\n        return None\n\n    longest_so_far = strings[0]\n\n    if not isinstance(longest_so_far, str):\n        raise TypeError(\"All elements in the list must be strings.\")\n\n    for i in range(1, len(strings)):\n        current_string = strings[i]\n\n        if not isinstance(current_string, str):\n            raise TypeError(\"All elements in the list must be strings.\")\n\n        if len(current_string) > len(longest_so_far):\n            longest_so_far = current_string\n\n    return longest_so_far"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\"Finds the longest string in a list, returning the first one on a tie. Returns None if the input list is empty.\"\"\"\n    if not strings:\n        return None\n\n    longest_found: Optional[str] = None\n    max_length: int = -1\n\n    for s in strings:\n        if longest_found is None or len(s) > max_length:\n            longest_found = s\n            max_length = len(s)\n\n    return longest_found"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\"\n    Performs binary XOR on two input strings consisting only of '1's and '0's.\n    Raises ValueError for invalid inputs (non-binary characters, different lengths, empty strings).\n    \"\"\"\n    # Validate the first input string for binary characters and non-emptiness.\n    if not a:\n        raise ValueError(\"Input string cannot be empty.\")\n    if not all(char in {'0', '1'} for char in a):\n        raise ValueError(\"Input string must contain only '0's and '1's.\")\n\n    # Validate the second input string for binary characters and non-emptiness.\n    if not b:\n        raise ValueError(\"Input string cannot be empty.\")\n    if not all(char in {'0', '1'} for char in b):\n        raise ValueError(\"Input string must contain only '0's and '1's.\")\n\n    # Validate that both input strings have the same length.\n    if len(a) != len(b):\n        raise ValueError(\"Input strings must be of equal length.\")\n\n    # Perform the bitwise XOR operation.\n    result_chars = []\n    for i in range(len(a)):\n        if a[i] == b[i]:\n            result_chars.append('0')\n        else:\n            result_chars.append('1')\n            \n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\"Test if a given string is a palindrome. Raises TypeError if input is not a string.\"\"\"\n    if not isinstance(string, str):\n        raise TypeError(\"Input must be a string.\")\n    return string == string[::-1]\ndef make_palindrome(string: str) -> str:\n    \"\"\"Find the shortest palindrome that begins with a supplied string.\n    Appends the reverse of the prefix that comes before the longest palindromic suffix.\n    \"\"\"\n    if not isinstance(string, str):\n        raise TypeError(\"Input must be a string.\")\n    if not string:\n        return \"\"\n\n    # Find the smallest k such that string[k:] is a palindrome.\n    # string[k:] is the longest palindromic suffix.\n    # string[:k] is the prefix that comes before this suffix.\n    for k in range(len(string) + 1):\n        suffix = string[k:]\n        if is_palindrome(suffix):\n            prefix_to_reverse = string[:k]\n            return string + prefix_to_reverse[::-1]\n    \n    # This part should be unreachable as string[len(string):] (an empty string) is always a palindrome."}
