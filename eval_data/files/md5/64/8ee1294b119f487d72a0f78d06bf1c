{"task_id": "HumanEval/120", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and an integer k, returns a sorted list\n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    # Validate input types for arr and k, raising TypeError if invalid.\n    if not isinstance(arr, list):\n        raise TypeError(\"Input 'arr' must be a list.\")\n    if not all(isinstance(x, int) for x in arr):\n        raise TypeError(\"All elements in 'arr' must be integers.\")\n    if not isinstance(k, int):\n        raise TypeError(\"Input 'k' must be an integer.\")\n\n    # Validate input values based on business rules, raising InvalidInputError.\n    if not (1 <= len(arr) <= 1000):\n        raise InvalidInputError(\"Length of 'arr' must be in the range [1, 1000].\")\n    if not all(-1000 <= x <= 1000 for x in arr):\n        raise InvalidInputError(\"Elements in 'arr' must be in the range [-1000, 1000].\")\n    if not (0 <= k <= len(arr)):\n        raise InvalidInputError(f\"Input 'k' must be in the range [0, {len(arr)}].\")\n\n    # Handle the edge case where k is 0 by returning an empty list.\n    if k == 0:\n        return []\n\n    # Sort the entire array in descending order to easily pick the top k elements.\n    # `sorted()` creates a new list, ensuring the original input `arr` is not modified.\n    sorted_arr_desc = sorted(arr, reverse=True)\n    \n    # Extract the first k elements, which are the largest k numbers.\n    k_max_elements = sorted_arr_desc[:k]\n    \n    # Sort these k elements in ascending order as required by the specification.\n    k_max_elements.sort()\n    \n    return k_max_elements"}
{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    '''\n    You are given a list of two strings, both strings consist of open\n    parentheses '(' or close parentheses ')' only.\n    Your job is to check if it is possible to concatenate the two strings in\n    some order, that the resulting string will be good.\n    A string S is considered to be good if and only if all parentheses in S\n    are balanced. For example: the string '(())()' is good, while the string\n    '())' is not.\n    Return 'Yes' if there's a way to make a good string, and return 'No' otherwise.\n\n    Examples:\n    match_parens(['()(', ')']) == 'Yes'\n    match_parens([')', ')']) == 'No'\n    '''\n    def _is_balanced(s: str) -> bool:\n        count = 0\n        for char in s:\n            if char == '(':\n                count += 1\n            elif char == ')':\n                count -= 1\n            if count < 0:\n                return False\n        return count == 0\n\n    if not isinstance(lst, list) or len(lst) != 2:\n        # Using ValueError as per the original design for InvalidInputError\n        raise ValueError(\"Input must be a list of exactly two strings.\")\n    \n    s1, s2 = lst[0], lst[1]\n\n    if not (isinstance(s1, str) and isinstance(s2, str)):\n        raise ValueError(\"All elements in the list must be strings.\")\n    \n    if not (all(char in '()' for char in s1) and all(char in '()' for char in s2)):\n        raise ValueError(\"Strings must contain only '(' or ')' characters.\")\n\n    if _is_balanced(s1 + s2) or _is_balanced(s2 + s1):\n        return 'Yes'\n    return 'No'"}
{"task_id": "HumanEval/116", "solution": "from src.sorter.bit_counter import BitCounter\nfrom src.sorter.array_sorter import ArraySorter\nfrom src.sorter.bit_counter import BitCounter\nclass BitCounter:\n    def count_ones(self, n: int) -> int:\n        \"\"\"Counts set bits in a non-negative integer using Brian Kernighan's algorithm.\n        Negative numbers are treated as having zero set bits for sorting key purposes.\"\"\"\n        if n < 0:\n            return 0\n        count = 0\n        while n > 0:\n            n &= (n - 1)\n            count += 1\n        return count\nclass ArraySorter:\n    def __init__(self, bit_counter: BitCounter):\n        self.bit_counter = bit_counter\n\n    def _get_sort_key(self, n: int) -> tuple[int, int]:\n        \"\"\"Generates a sorting key (primary_key, secondary_key) for an integer.\n        Negative numbers are grouped by a virtual bit count of -1 and sorted by value.\"\"\"\n        if n < 0:\n            return (-1, n)\n        else:\n            ones_count = self.bit_counter.count_ones(n)\n            return (ones_count, n)\n\n    def sort(self, arr: list[int]) -> list[int]:\n        \"\"\"Sorts the input array based on bit counts and decimal values.\n        It returns a new list without modifying the original.\"\"\"\n        return sorted(arr, key=self._get_sort_key)\ndef sort_array(arr: list[int]) -> list[int]:\n    \"\"\"Sorts integers by bit count (ascending), then by decimal value (ascending).\n    Negative numbers are sorted by decimal value only.\"\"\"\n    bit_counter = BitCounter()\n    array_sorter = ArraySorter(bit_counter)\n    return array_sorter.sort(arr)"}
{"task_id": "HumanEval/120", "solution": "from typing import List\ndef maximum(arr: List[int], k: int) -> List[int]:\n    \"\"\"\n    Finds the k largest numbers from an array and returns them sorted ascendingly.\n    Handles various input constraints and edge cases as specified.\n    \"\"\"\n    # Validate input types for 'arr' and 'k'.\n    if not isinstance(arr, list):\n        raise TypeError(\"Input 'arr' must be a list.\")\n    if not isinstance(k, int):\n        raise TypeError(\"Input 'k' must be an integer.\")\n    if not all(isinstance(x, int) for x in arr):\n        raise TypeError(\"All elements in 'arr' must be integers.\")\n\n    # Validate 'k' is within the allowed range [0, len(arr)].\n    if k < 0:\n        raise ValueError(\"Input 'k' cannot be negative.\")\n    if k > len(arr):\n        raise ValueError(\"Input 'k' cannot be greater than the length of 'arr'.\")\n\n    # If k is 0, return an empty list.\n    if k == 0:\n        return []\n\n    # Sort the array in descending order to easily find the largest elements.\n    # Note: This modifies the input 'arr' in-place.\n    arr.sort(reverse=True)\n    \n    # Select the top k elements from the sorted array.\n    top_k = arr[:k]\n    \n    # Sort these k elements in ascending order as required by the specification.\n    top_k.sort()\n    \n    return top_k"}
{"task_id": "HumanEval/121", "solution": "def solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"Input must be a list.\")\n    if not lst:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    total_sum = 0\n    # Iterate through the list with index and element.\n    for i, element in enumerate(lst):\n        if not isinstance(element, int):\n            raise ValueError(\"All elements in the list must be integers.\")\n        # Check if the position is even (0-indexed) and the element is odd.\n        if i % 2 == 0 and element % 2 != 0:\n            total_sum += element\n    return total_sum"}
