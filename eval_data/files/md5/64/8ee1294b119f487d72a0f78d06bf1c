{"task_id": "HumanEval/123", "solution": "from typing import List\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    pass\ndef get_odd_collatz(n: int) -> List[int]:\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    The sequence is generated by rules: n/2 if even, 3n+1 if odd, until 1 is reached.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise InvalidInputError(\"Input 'n' must be a positive integer.\")\n\n    if n == 1:\n        return [1]\n\n    sequence = [n]\n    current = n\n    while current != 1:\n        if current % 2 == 0:\n            current //= 2\n        else:\n            current = 3 * current + 1\n        sequence.append(current)\n\n    # Identify unique odd numbers from the sequence and sort them in ascending order.\n    odd_numbers = sorted(list(set(num for num in sequence if num % 2 != 0)))\n    return odd_numbers"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    \"\"\"\n    Processes a string by splitting on whitespace, then commas, or counting odd-order lowercase letters.\n    The order of operations is: whitespace split, comma split, then odd-order lowercase count.\n    \"\"\"\n    if any(char.isspace() for char in txt):\n        return txt.split()\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        count = 0\n        for char in txt:\n            if 'a' <= char <= 'z':\n                alphabetical_order = ord(char) - ord('a')\n                if alphabetical_order % 2 != 0:\n                    count += 1\n        return count"}
{"task_id": "HumanEval/124", "solution": "_DAYS_IN_MONTH = {\n    1: 31, 3: 31, 5: 31, 7: 31, 8: 31, 10: 31, 12: 31,\n    4: 30, 6: 30, 9: 30, 11: 30\n}\n_LEAP_FEB_DAYS = 29\n_NON_LEAP_FEB_DAYS = 28\ndef _is_leap_year(year):\n    \"\"\"Determines if a given year is a leap year.\"\"\"\n    return (year % 4 == 0 and year % 100 != 0) or (year % 400 == 0)\ndef valid_date(date):\n    \"\"\"\n    Validates a given date string according to 'mm-dd-yyyy' format and specific date rules.\n    Returns True if the date is valid, otherwise False.\n    \"\"\"\n    if not date:\n        return False\n\n    try:\n        month_str, day_str, year_str = date.split('-')\n        month = int(month_str)\n        day = int(day_str)\n        year = int(year_str)\n    except (ValueError, IndexError):\n        return False\n\n    if not (1 <= month <= 12):\n        return False\n\n    if not (1 <= day <= 31):\n        return False\n\n    if month == 2:\n        max_days = _LEAP_FEB_DAYS if _is_leap_year(year) else _NON_LEAP_FEB_DAYS\n        if not (1 <= day <= max_days):\n            return False\n    elif month in _DAYS_IN_MONTH:\n        max_days = _DAYS_IN_MONTH[month]\n        if not (1 <= day <= max_days):\n            return False\n\n    return True"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    \"\"\"\n    Checks if a list of non-negative integers is sorted in ascending order\n    and contains no more than two occurrences of any single number.\n    \"\"\"\n    if not lst or len(lst) == 1:\n        return True\n\n    # Count occurrences of each number; return False if any number appears 3 or more times.\n    counts = {}\n    for num in lst:\n        counts[num] = counts.get(num, 0) + 1\n        if counts[num] >= 3:\n            return False\n\n    # Check for ascending order; return False if an element is greater than the next.\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    return True"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    \"\"\"\n    Given a string, returns a list of words split by whitespace or commas,\n    or counts odd-ordered lowercase letters if no delimiters are found.\n    \"\"\"\n    if ' ' in txt:\n        return txt.split(' ')\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        count = 0\n        for char in txt:\n            # Check if character is a single lowercase letter with odd alphabetical order.\n            if len(char) == 1 and char.islower():\n                order = ord(char) - ord('a')\n                if order % 2 != 0:\n                    count += 1\n        return count"}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    You are given an array arr of integers and you need to return\n    sum of magnitudes of integers multiplied by product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    Note: return None for empty arr.\n\n    Example:\n    >>> prod_signs([1, 2, 2, -4]) == -9\n    >>> prod_signs([0, 1]) == 0\n    >>> prod_signs([]) == None\n    \"\"\"\n    if not arr:\n        return None\n\n    product_of_signs = 1\n    sum_of_magnitudes = 0\n\n    for num in arr:\n        # Determine the sign for the current number (1, -1, or 0).\n        if num > 0:\n            current_sign = 1\n        elif num < 0:\n            current_sign = -1\n        else:\n            current_sign = 0\n\n        # Calculate the magnitude (absolute value) of the current number.\n        current_magnitude = abs(num)\n\n        product_of_signs *= current_sign\n        sum_of_magnitudes += current_magnitude\n\n    return sum_of_magnitudes * product_of_signs"}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Calculates the sum of magnitudes of integers multiplied by the product of their signs.\n    Returns None for an empty array.\n    \"\"\"\n    if not arr:\n        return None\n\n    sum_magnitudes = 0\n    product_signs = 1\n    has_zero = False\n\n    for num in arr:\n        sum_magnitudes += abs(num)\n        if num == 0:\n            has_zero = True\n        elif num < 0:\n            product_signs *= -1\n            \n    if has_zero:\n        product_signs = 0\n\n    return sum_magnitudes * product_signs"}
{"task_id": "HumanEval/126", "solution": "from collections import Counter\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to the is_sorted function.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef is_sorted(lst):\n    \"\"\"\n    Validates if a list of non-negative integers is sorted in ascending order and adheres to duplicate constraints.\n    Returns True if valid, False otherwise; raises InvalidInputError for invalid input types or values.\n    \"\"\"\n    if not isinstance(lst, list):\n        raise InvalidInputError(\"Input must be a list.\")\n\n    for item in lst:\n        if not isinstance(item, int):\n            raise InvalidInputError(f\"List element '{item}' is not an integer.\")\n        if item < 0:\n            raise InvalidInputError(f\"List element '{item}' is negative.\")\n\n    if len(lst) <= 1:\n        return True\n\n    # Check for ascending order\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    # Check for duplicate constraints (at most two occurrences)\n    counts = Counter(lst)\n    for count in counts.values():\n        if count > 2:\n            return False\n\n    return True"}
