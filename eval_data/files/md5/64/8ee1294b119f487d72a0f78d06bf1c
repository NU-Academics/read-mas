{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    You're a hungry rabbit, and you already have eaten a certain number of carrots,\n    but now you need to eat more carrots to complete the day's meals.\n    you should return an array of [ total number of eaten carrots after your meals,\n                                    the number of carrots left after your meals ]\n    if there are not enough remaining carrots, you will eat all remaining carrots, but will still be hungry.\n    \n    Example:\n    * eat(5, 6, 10) -> [11, 4]\n    * eat(4, 8, 9) -> [12, 1]\n    * eat(1, 10, 10) -> [11, 0]\n    * eat(2, 11, 5) -> [7, 0]\n    \n    Variables:\n    @number : integer\n        the number of carrots that you have eaten.\n    @need : integer\n        the number of carrots that you need to eat.\n    @remaining : integer\n        the number of remaining carrots thet exist in stock\n    \n    Constrain:\n    * 0 <= number <= 1000\n    * 0 <= need <= 1000\n    * 0 <= remaining <= 1000\n\n    Have fun :)\n    \"\"\"\n    # All input parameters (number, need, remaining) must be integers.\n    if not all(isinstance(arg, int) for arg in [number, need, remaining]):\n        raise TypeError(\"All input parameters must be integers.\")\n\n    # Input parameters must be between 0 and 1000, inclusive.\n    if not (0 <= number <= 1000 and 0 <= need <= 1000 and 0 <= remaining <= 1000):\n        raise ValueError(\"Input parameters must be between 0 and 1000, inclusive.\")\n\n    # Determine actual carrots consumed and update totals.\n    eaten_this_meal = min(need, remaining)\n    total_eaten = number + eaten_this_meal\n    carrots_left = remaining - eaten_this_meal\n    \n    return [total_eaten, carrots_left]"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"Reverses letter case or entire string based on letter presence.\"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n\n    if any(char.isalpha() for char in s):\n        processed_chars = []\n        for char in s:\n            if char.islower():\n                processed_chars.append(char.upper())\n            elif char.isupper():\n                processed_chars.append(char.lower())\n            else:\n                processed_chars.append(char)\n        return \"\".join(processed_chars)\n    else:\n        return s[::-1]"}
{"task_id": "HumanEval/160", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Exception raised for errors in the input provided.\"\"\"\n    def __init__(self, message=\"Invalid input provided\"):\n        self.message = message\n        super().__init__(self.message)\nclass CalculationError(Exception):\n    \"\"\"Exception raised for errors during expression calculation.\"\"\"\n    def __init__(self, message=\"Error during expression calculation\"):\n        self.message = message\n        super().__init__(self.message)\nclass InputValidator:\n    \"\"\"Encapsulates logic for validating input lists against business rules.\"\"\"\n    SUPPORTED_OPERATORS = {'+', '-', '*', '//', '**'}\n\n    def validate(self, operators: list[str], operands: list[int]) -> None:\n        if not isinstance(operators, list) or not isinstance(operands, list):\n            raise InvalidInputError(\"Inputs must be lists.\")\n\n        self._validate_lengths(operators, operands)\n        self._validate_operand_types_and_values(operands)\n        self._validate_operator_types_and_values(operators)\n\n    def _validate_lengths(self, operators: list[str], operands: list[int]) -> None:\n        if not operators:\n            raise InvalidInputError(\"Operator list cannot be empty.\")\n        if len(operands) < 2:\n            raise InvalidInputError(\"Operand list must contain at least two operands.\")\n        if len(operators) != len(operands) - 1:\n            raise InvalidInputError(\"Operator list length must be one less than operand list length.\")\n\n    def _validate_operand_types_and_values(self, operands: list[int]) -> None:\n        for operand in operands:\n            if not isinstance(operand, int):\n                raise InvalidInputError(f\"Operand '{operand}' is not an integer.\")\n            if operand < 0:\n                raise InvalidInputError(f\"Operand '{operand}' must be non-negative.\")\n\n    def _validate_operator_types_and_values(self, operators: list[str]) -> None:\n        for operator in operators:\n            if not isinstance(operator, str):\n                raise InvalidInputError(f\"Operator '{operator}' is not a string.\")\n            if operator not in self.SUPPORTED_OPERATORS:\n                raise InvalidInputError(f\"Unsupported operator: '{operator}'. Supported operators are: {', '.join(self.SUPPORTED_OPERATORS)}\")\nclass AlgebraEvaluatorService:\n    \"\"\"Orchestrates validation, expression construction, and evaluation.\"\"\"\n    def __init__(self):\n        self.input_validator = InputValidator()\n\n    def evaluate_expression(self, operators: list[str], operands: list[int]) -> int:\n        self.input_validator.validate(operators, operands)\n        expression_string = self._build_expression_string(operators, operands)\n        \n        try:\n            result = eval(expression_string) # Leverages Python's standard operator precedence.\n            if not isinstance(result, (int, float)):\n                raise CalculationError(\"Expression did not evaluate to a numeric type.\")\n            return int(result)\n        except (SyntaxError, TypeError, NameError, ZeroDivisionError) as e:\n            raise CalculationError(f\"Failed to evaluate expression '{expression_string}': {e}\")\n\n    def _build_expression_string(self, operators: list[str], operands: list[int]) -> str:\n        expression_parts = []\n        for i in range(len(operands)):\n            expression_parts.append(str(operands[i]))\n            if i < len(operators):\n                expression_parts.append(operators[i])\n        return \" \".join(expression_parts)\ndef do_algebra(operator: list[str], operand: list[int]) -> int:\n    \"\"\"\n    Evaluates an algebraic expression from lists of operators and operands.\n    It returns the integer result of the evaluated expression.\n    \"\"\"\n    service = AlgebraEvaluatorService()\n    return service.evaluate_expression(operator, operand)"}
