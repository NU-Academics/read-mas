{"task_id": "HumanEval/93", "solution": "VOWELS_LOWER = {'a', 'e', 'i', 'o', 'u'}\nALPHABET_MAP = {\n    'a': 'c', 'e': 'g', 'i': 'k', 'o': 'q', 'u': 'w'\n}\ndef encode(message):\n    \"\"\"Encodes a message by swapping the case of letters and replacing vowels with letters two places ahead.\n    Non-alphabetic characters are unchanged, and replacement vowels maintain the case-swapped character's original case.\n    \"\"\"\n    encoded_chars = []\n    for char in message:\n        if not char.isalpha():\n            encoded_chars.append(char)\n            continue\n\n        char_after_case_swap = char.swapcase()\n\n        if char.lower() in VOWELS_LOWER:\n            replacement_base = ALPHABET_MAP.get(char.lower())\n            if replacement_base:\n                if char_after_case_swap.isupper():\n                    encoded_chars.append(replacement_base.upper())\n                else:\n                    encoded_chars.append(replacement_base.lower())\n            else:\n                encoded_chars.append(char_after_case_swap)\n        else:\n            encoded_chars.append(char_after_case_swap)\n            \n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/93", "solution": "VOWELS = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\nALPHABET_LOWER = 'abcdefghijklmnopqrstuvwxyz'\ndef encode(message: str) -> str:\n    \"\"\"Encodes a message by swapping case and replacing specific vowels.\n    Non-alphabetic characters remain unchanged, and operations are ordered.\"\"\"\n    \n    encoded_chars = []\n    \n    for char in message:\n        processed_char = char\n        \n        # Apply case swapping first for alphabetic characters.\n        if char.isalpha():\n            processed_char = char.swapcase()\n        \n        # If the character (after case swap) is a defined vowel, replace it.\n        if processed_char in VOWELS:\n            is_upper = processed_char.isupper()\n            char_lower = processed_char.lower()\n            \n            idx = ALPHABET_LOWER.index(char_lower)\n            new_idx = (idx + 2) % len(ALPHABET_LOWER)\n            \n            replaced_char = ALPHABET_LOWER[new_idx]\n            processed_char = replaced_char.upper() if is_upper else replaced_char\n        \n        encoded_chars.append(processed_char)\n        \n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict_obj: dict) -> bool:\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower\n    case or all keys are strings in upper case, else return False.\n    The function should return False if the given dictionary is empty.\n    \"\"\"\n    if not dict_obj:\n        return False\n\n    keys = list(dict_obj.keys())\n\n    # Verify each key is a string.\n    if not all(isinstance(key, str) for key in keys):\n        return False\n\n    # Determine if all string keys are lowercase or all are uppercase.\n    all_lower = all(key == key.lower() for key in keys)\n    if all_lower:\n        return True\n\n    all_upper = all(key == key.upper() for key in keys)\n    if all_upper:\n        return True\n\n    return False"}
{"task_id": "HumanEval/94", "solution": "import math\nclass PrimeUtils:\n    \"\"\"Provides utility methods for prime checking and digit summation.\"\"\"\n\n    @staticmethod\n    def is_prime(n: int) -> bool:\n        \"\"\"Determines if an integer n is a prime number.\n        It checks for divisibility by odd numbers up to its square root.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    @staticmethod\n    def sum_digits(n: int) -> int:\n        \"\"\"Calculates the sum of digits of a non-negative integer n.\n        It iteratively adds the last digit and removes it.\"\"\"\n        s = 0\n        while n > 0:\n            s += n % 10\n            n //= 10\n        return s\nclass PrimeService:\n    \"\"\"Encapsulates business logic to find the largest prime and sum its digits.\n    It uses PrimeUtils for core mathematical operations.\"\"\"\n\n    def __init__(self, prime_utils: PrimeUtils):\n        \"\"\"Initializes the service with a PrimeUtils instance.\"\"\"\n        self.prime_utils = prime_utils\n\n    def find_largest_prime_and_sum_digits(self, lst: list[int]) -> int:\n        \"\"\"Finds the largest prime in a list and returns the sum of its digits.\n        Returns 0 if no prime number is found in the list.\"\"\"\n        largest_prime = None\n        for num in lst:\n            if self.prime_utils.is_prime(num):\n                if largest_prime is None or num > largest_prime:\n                    largest_prime = num\n\n        if largest_prime is not None:\n            return self.prime_utils.sum_digits(largest_prime)\n        return 0\ndef skjkasdkd(lst: list[int]) -> int:\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n    prime_utils = PrimeUtils()\n    prime_service = PrimeService(prime_utils)\n    return prime_service.find_largest_prime_and_sum_digits(lst)"}
