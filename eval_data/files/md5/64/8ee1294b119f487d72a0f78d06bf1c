{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by rotating alphabetic characters by 4 places.\n    Non-alphabetic characters are left unchanged, and case is preserved.\"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n\n    # The alphabet rotation shift is fixed at 4.\n    ROTATION_SHIFT = 4\n    encrypted_chars = []\n\n    for char in s:\n        if not char.isalpha():\n            encrypted_chars.append(char)\n        else:\n            start = ord('a') if char.islower() else ord('A')\n            rotated_ord = (ord(char) - start + ROTATION_SHIFT) % 26 + start\n            encrypted_chars.append(chr(rotated_ord))\n\n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/90", "solution": "def next_smallest(lst):\n    \"\"\"\n    Returns the 2nd smallest distinct element of the list.\n    Returns None if there is no such element.\n    \"\"\"\n    if not lst:\n        return None\n\n    # Remove duplicates and sort the remaining elements\n    unique_sorted_list = sorted(list(set(lst)))\n\n    # If there are fewer than two distinct elements, return None\n    if len(unique_sorted_list) < 2:\n        return None\n    else:\n        # Otherwise, return the second element (which is the second smallest)\n        return unique_sorted_list[1]"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by shifting each alphabetic character forward by 4 positions.\n    Non-alphabetic characters remain unchanged, and the alphabet wraps around.\"\"\"\n    \n    SHIFT_AMOUNT = 4\n    encrypted_chars = []\n\n    for char in s:\n        if 'a' <= char <= 'z':\n            # Handle lowercase letters\n            offset = ord(char) - ord('a')\n            shifted_offset = (offset + SHIFT_AMOUNT) % 26\n            encrypted_chars.append(chr(ord('a') + shifted_offset))\n        elif 'A' <= char <= 'Z':\n            # Handle uppercase letters\n            offset = ord(char) - ord('A')\n            shifted_offset = (offset + SHIFT_AMOUNT) % 26\n            encrypted_chars.append(chr(ord('A') + shifted_offset))\n        else:\n            # Non-alphabetic characters remain unchanged\n            encrypted_chars.append(char)\n            \n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/91", "solution": "import re\nclass SentenceTokenizer:\n    def tokenize(self, text: str) -> list[str]:\n        # Split by '.', '?', '!' while keeping the delimiters in mind for context.\n        # Filter out empty strings that might result from splitting (e.g., \"Hello!!\").\n        sentences = re.split(r'(?<=[.?!])\\s*', text)\n        return [s.strip() for s in sentences if s.strip()]\nclass BoredomDetector:\n    def is_bored_sentence(self, sentence: str) -> bool:\n        # Check if the normalized sentence starts with \"i \" or is exactly \"i\".\n        normalized_sentence = sentence.strip().lower()\n        return normalized_sentence.startswith(\"i \") or normalized_sentence == \"i\"\nclass BoredomCounterService:\n    def __init__(self, sentence_tokenizer: SentenceTokenizer, boredom_detector: BoredomDetector):\n        self._sentence_tokenizer = sentence_tokenizer\n        self._boredom_detector = boredom_detector\n\n    def count_boredoms(self, text: str) -> int:\n        # Tokenize the text into sentences and count how many are \"boredoms\".\n        sentences = self._sentence_tokenizer.tokenize(text)\n        boredom_count = 0\n        for sentence in sentences:\n            if self._boredom_detector.is_bored_sentence(sentence):\n                boredom_count += 1\n        return boredom_count\ndef is_bored(S: str) -> int:\n    \"\"\"\n    Counts the number of boredoms in a given string.\n    A boredom is a sentence that starts with the word \"I\", delimited by '.', '?' or '!'.\n    \"\"\"\n    tokenizer = SentenceTokenizer()\n    detector = BoredomDetector()\n    counter_service = BoredomCounterService(tokenizer, detector)\n    return counter_service.count_boredoms(S)"}
{"task_id": "HumanEval/90", "solution": "def next_smallest(lst):\n    \"\"\"\n    You are given a list of integers.\n    Write a function next_smallest() that returns the 2nd smallest element of the list.\n    Return None if there is no such element.\n    \n    next_smallest([1, 2, 3, 4, 5]) == 2\n    next_smallest([5, 1, 4, 3, 2]) == 2\n    next_smallest([]) == None\n    next_smallest([1, 1]) == None\n    \"\"\"\n    \n    unique_sorted_elements = sorted(list(set(lst)))\n\n    if len(unique_sorted_elements) < 2:\n        return None\n    else:\n        return unique_sorted_elements[1]"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    '''\n    Checks if one number equals the sum of the other two, and all are integers.\n    Returns true if both conditions are met, false otherwise.\n    '''\n    if not all(isinstance(arg, int) for arg in [x, y, z]):\n        return False\n\n    return (x == y + z) or (y == x + z) or (z == x + y)"}
{"task_id": "HumanEval/91", "solution": "def is_bored(S: str) -> int:\n    \"\"\"\n    Counts \"boredoms\" in a string, where a boredom is a sentence\n    starting with \"I\". Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    SENTENCE_DELIMITERS = ['.', '?', '!']\n    boredom_count = 0\n    sentences_raw = []\n    current_sentence_chars = []\n\n    for char in S:\n        current_sentence_chars.append(char)\n        if char in SENTENCE_DELIMITERS:\n            # Accumulate characters into a sentence, trim, and add if non-empty.\n            sentence_str = \"\".join(current_sentence_chars).strip()\n            if sentence_str:\n                sentences_raw.append(sentence_str)\n            current_sentence_chars = [] # Reset for the next sentence\n\n    # Add any remaining text as a sentence if it's not empty.\n    remaining_text = \"\".join(current_sentence_chars).strip()\n    if remaining_text:\n        sentences_raw.append(remaining_text)\n            \n    for s_text in sentences_raw:\n        # Check if the stripped sentence strictly starts with \"I \" or is exactly \"I\".\n        cleaned_s_text = s_text.strip()\n        if cleaned_s_text == \"I\" or cleaned_s_text.startswith(\"I \"):\n            boredom_count += 1\n            \n    return boredom_count"}
