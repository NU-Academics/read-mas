{"task_id": "HumanEval/26", "solution": "from typing import List, Dict\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    \"\"\"\n    counts: Dict[int, int] = {}\n    for num in numbers:\n        counts[num] = counts.get(num, 0) + 1\n\n    result: List[int] = []\n    for num in numbers:\n        if counts[num] == 1:\n            result.append(num)\n    return result"}
{"task_id": "HumanEval/25", "solution": "from typing import List\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input to the prime factorization function.\"\"\"\n    pass\ndef factorize(n: int) -> List[int]:\n    \"\"\"\n    Returns a list of prime factors for a given integer n.\n    Factors are in ascending order and listed according to their multiplicity.\n    \"\"\"\n    if not isinstance(n, int) or n <= 1:\n        raise InvalidInputError(\"Input 'n' must be an integer greater than 1.\")\n\n    factors: List[int] = []\n    d = 2\n    temp_n = n\n\n    while d * d <= temp_n:\n        while temp_n % d == 0:\n            factors.append(d)\n            temp_n //= d\n        d += 1\n\n    if temp_n > 1:\n        factors.append(temp_n)\n\n    return factors"}
{"task_id": "HumanEval/27", "solution": "def flip_case(string: str) -> str:\n    \"\"\" For a given string, flip lowercase characters to uppercase and uppercase to lowercase.\n    >>> flip_case('Hello')\n    'hELLO'\n    \"\"\"\n    if not isinstance(string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    flipped_chars = []\n    for char in string:\n        if 'a' <= char <= 'z':\n            flipped_chars.append(char.upper())\n        elif 'A' <= char <= 'Z':\n            flipped_chars.append(char.lower())\n        else:\n            flipped_chars.append(char)\n    return \"\".join(flipped_chars)"}
