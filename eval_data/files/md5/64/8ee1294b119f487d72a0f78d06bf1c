{"task_id": "HumanEval/39", "solution": "from typing import Iterator, Dict\nclass FibonacciGenerator:\n    def generate_sequence(self) -> Iterator[int]:\n        \"\"\"Generates an infinite sequence of Fibonacci numbers starting from 0.\"\"\"\n        a, b = 0, 1\n        while True:\n            yield a\n            a, b = b, a + b\nclass PrimeChecker:\n    _prime_cache: Dict[int, bool] = {}\n\n    def is_prime(self, num: int) -> bool:\n        \"\"\"Checks if a number is prime using a cached trial division method.\"\"\"\n        if num in self._prime_cache:\n            return self._prime_cache[num]\n        if num <= 1:\n            self._prime_cache[num] = False\n            return False\n        if num <= 3:\n            self._prime_cache[num] = True\n            return True\n        if num % 2 == 0 or num % 3 == 0:\n            self._prime_cache[num] = False\n            return False\n        i = 5\n        while i * i <= num:\n            if num % i == 0 or num % (i + 2) == 0:\n                self._prime_cache[num] = False\n                return False\n            i += 6\n        self._prime_cache[num] = True\n        return True\nclass PrimeFibonacciService:\n    def __init__(self, fib_generator: FibonacciGenerator, prime_checker: PrimeChecker):\n        \"\"\"Initializes the service with Fibonacci generator and prime checker instances.\"\"\"\n        self.fib_generator = fib_generator\n        self.prime_checker = prime_checker\n\n    def find_nth_prime_fib(self, n: int) -> int:\n        \"\"\"Finds the n-th number that is both a Fibonacci number and a prime.\"\"\"\n        prime_fib_count = 0\n        for fib_num in self.fib_generator.generate_sequence():\n            if fib_num < 2: # 0 and 1 are not prime.\n                continue\n            if self.prime_checker.is_prime(fib_num):\n                prime_fib_count += 1\n                if prime_fib_count == n:\n                    return fib_num\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    This function validates input and orchestrates the search for the number.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    fib_generator = FibonacciGenerator()\n    prime_checker = PrimeChecker()\n    service = PrimeFibonacciService(fib_generator, prime_checker)\n    return service.find_nth_prime_fib(n)"}
