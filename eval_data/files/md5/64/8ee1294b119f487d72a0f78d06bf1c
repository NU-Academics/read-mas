{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of n-digit positive integers\n    that start or end with 1, using the Inclusion-Exclusion Principle.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    # Calculate count of n-digit numbers starting with 1 (FR2).\n    count_starts_with_one = 10**(n - 1)\n\n    # Calculate count of n-digit numbers ending with 1 (FR3).\n    # Handles n=1 as a special case; otherwise, uses 9 * 10^(n-2).\n    if n == 1:\n        count_ends_with_one = 1\n    else:\n        count_ends_with_one = 9 * (10**(n - 2))\n\n    # Calculate count of n-digit numbers starting AND ending with 1 (FR4).\n    # Handles n=1 as a special case; otherwise, uses 1 * 10^(n-2).\n    if n == 1:\n        count_starts_and_ends_with_one = 1\n    else:\n        count_starts_and_ends_with_one = 1 * (10**(n - 2))\n\n    # Apply the Principle of Inclusion-Exclusion (FR5).\n    total_count = count_starts_with_one + count_ends_with_one - count_starts_and_ends_with_one\n\n    return total_count"}
{"task_id": "HumanEval/84", "solution": "class Utils:\n    def decimal_to_binary(self, decimal_num: int) -> str:\n        \"\"\"Converts a non-negative decimal integer to its binary string representation.\"\"\"\n        if decimal_num == 0:\n            return \"0\"\n        return bin(decimal_num)[2:]\nclass DigitSumBinaryCalculator:\n    \"\"\"Manages logic for summing digits and converting sum to binary.\"\"\"\n    def __init__(self, utils: Utils):\n        self.utils = utils\n\n    def calculate_digit_sum(self, N: int) -> int:\n        \"\"\"Computes the sum of the decimal digits of N.\"\"\"\n        total_sum = 0\n        s_N = str(N)\n        for digit_char in s_N:\n            total_sum += int(digit_char)\n        return total_sum\n\n    def convert_to_binary_string(self, decimal_sum: int) -> str:\n        \"\"\"Converts a decimal sum to its binary string representation.\"\"\"\n        return self.utils.decimal_to_binary(decimal_sum)\ndef solve(N: int) -> str:\n    \"\"\"Given a non-negative integer N, return the total sum of its digits in binary.\n    Validates input N and orchestrates digit sum calculation and binary conversion.\n    \"\"\"\n    if not (0 <= N <= 10000):\n        raise ValueError(\"N must be between 0 and 10000 inclusive.\")\n\n    utils = Utils()\n    calculator = DigitSumBinaryCalculator(utils)\n\n    digit_sum = calculator.calculate_digit_sum(N)\n    binary_sum_string = calculator.convert_to_binary_string(digit_sum)\n\n    return binary_sum_string"}
{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Calculates the sum of the decimal digits of a given positive integer N and returns this sum as a binary string.\n    N must be within the range 0 \u2264 N \u2264 10000.\n    \"\"\"\n    if not (0 <= N <= 10000):\n        raise ValueError(\"Input N must be between 0 and 10000 (inclusive).\")\n\n    # Calculate sum of decimal digits (FR2)\n    decimal_sum = 0\n    s_N = str(N)\n    for digit_char in s_N:\n        decimal_sum += int(digit_char)\n\n    # Convert the sum to its binary string representation (FR3)\n    if decimal_sum == 0:\n        return \"0\"\n\n    binary_string = \"\"\n    temp_num = decimal_sum\n    while temp_num > 0:\n        binary_string = str(temp_num % 2) + binary_string\n        temp_num //= 2\n    \n    return binary_string"}
