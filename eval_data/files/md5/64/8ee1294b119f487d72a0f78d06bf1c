{"task_id": "HumanEval/111", "solution": "from collections import Counter\ndef histogram(test: str) -> dict:\n    \"\"\"Analyzes a string of space-separated lowercase letters to find the most frequent letter(s).\n    Returns a dictionary of these letters and their counts, including all letters sharing the maximum frequency.\n    \"\"\"\n    if not test.strip():\n        return {}\n\n    letters = [letter for letter in test.split(' ') if letter]\n    if not letters:\n        return {}\n\n    counts = Counter(letters)\n    if not counts:\n        return {}\n\n    max_count = max(counts.values())\n    \n    result = {\n        letter: count for letter, count in counts.items() if count == max_count\n    }\n    return result"}
{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr):\n    \"\"\"Determines if an array can be sorted by right-shifting its elements.\n    It performs right shifts and checks for a sorted configuration.\n    \"\"\"\n    def _is_sorted(sub_arr: list[int]) -> bool:\n        \"\"\"Checks if a sub-array is sorted in non-decreasing order.\"\"\"\n        if not sub_arr:\n            return True\n        for i in range(len(sub_arr) - 1):\n            if sub_arr[i] > sub_arr[i+1]:\n                return False\n        return True\n\n    n = len(arr)\n    if n == 0:\n        return True\n\n    current_arr = list(arr) # Create a mutable copy of the input array.\n\n    # Iterate up to N times, checking each unique rotation.\n    for _ in range(n):\n        if _is_sorted(current_arr):\n            return True\n        \n        # Perform right shift: move the last element to the first position.\n        last_element = current_arr.pop()\n        current_arr.insert(0, last_element)\n    \n    return False"}
{"task_id": "HumanEval/112", "solution": "def reverse_delete(s, c):\n    \"\"\"\n    Deletes characters from 's' that are present in 'c', then checks if the result is a palindrome.\n    Returns the filtered string and a boolean indicating if it's a palindrome.\n    \"\"\"\n    if not isinstance(s, str) or not isinstance(c, str):\n        raise TypeError(\"Inputs 's' and 'c' must be strings.\")\n\n    def _filter_string(main_s: str, chars_to_delete: str) -> str:\n        \"\"\"Removes all characters from main_s that are present in chars_to_delete.\"\"\"\n        return \"\".join([char for char in main_s if char not in chars_to_delete])\n\n    def _is_palindrome(check_s: str) -> bool:\n        \"\"\"Checks if the given string check_s is a palindrome.\"\"\"\n        return check_s == check_s[::-1]\n\n    filtered_s = _filter_string(s, c)\n    is_pal = _is_palindrome(filtered_s)\n    return (filtered_s, is_pal)"}
{"task_id": "HumanEval/113", "solution": "def odd_count(lst):\n    \"\"\"Given a list of digit-only strings, this function counts odd digits in each.\n    It returns a list of formatted strings, each showing the odd digit count for its respective input string.\n    \"\"\"\n\n    def _count_odd_digits(digit_string: str) -> int:\n        \"\"\"Counts the number of odd digits in a given string.\n        It iterates through the characters, converts them to integers, and checks for oddness.\n        \"\"\"\n        count = 0\n        for char_digit in digit_string:\n            digit = int(char_digit)\n            if digit % 2 != 0:\n                count += 1\n        return count\n\n    def _format_output_string(count: int) -> str:\n        \"\"\"Formats an integer count into the specified output string.\n        The format \"the number of odd elements <count>n the str<count>ng <count> of the <count>nput.\" is used.\n        \"\"\"\n        return f\"the number of odd elements {count}n the str{count}ng {count} of the {count}nput.\"\n\n    results = []\n    for digit_string in lst:\n        odd_digit_count = _count_odd_digits(digit_string)\n        formatted_string = _format_output_string(odd_digit_count)\n        results.append(formatted_string)\n    return results"}
{"task_id": "HumanEval/113", "solution": "def odd_count(lst):\n    \"\"\"Given a list of strings, where each string consists of only digits, return a list.\n    Each element i of the output should be \"the number of odd elements in the\n    string i of the input.\" where all the i's should be replaced by the number\n    of odd digits in the i'th string of the input.\n    \"\"\"\n    results = []\n    odd_digits_set = {'1', '3', '5', '7', '9'} # Defines the set of characters representing odd digits.\n\n    for s in lst:\n        current_odd_count = 0\n        for char in s:\n            if char in odd_digits_set: # Checks if the character is an odd digit.\n                current_odd_count += 1\n        \n        # Formats the output string using the specified pattern and the calculated count.\n        formatted_string = f\"the number of odd elements {current_odd_count}n the str{current_odd_count}ng {current_odd_count} of the {current_odd_count}nput.\"\n        results.append(formatted_string)\n\n    return results"}
