{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\"\"\"\n\n    def _generate_rotations(s: str) -> set[str]:\n        \"\"\"Generates all unique cyclic rotations of a string.\n        This helper is called only when 's' (which is 'b') is guaranteed to be non-empty.\n        \"\"\"\n        rotations = set()\n        for i in range(len(s)):\n            rotated_s = s[i:] + s[:i]\n            rotations.add(rotated_s)\n        return rotations\n\n    # Handle edge cases as per design spec's example and business rules.\n    # An empty pattern 'b' cannot be a substring (BR2).\n    if not b:\n        return False\n    # If target 'a' is empty and pattern 'b' is not, no match.\n    if not a and b:\n        return False\n    # If both 'a' and 'b' are empty, no match for consistency with empty 'b' rule.\n    if not a and not b:\n        return False\n\n    # Generate all unique cyclic rotations of the pattern string 'b'.\n    rotations_of_b = _generate_rotations(b)\n\n    # Check if any generated rotation of 'b' is a substring of 'a'.\n    for rotation in rotations_of_b:\n        if rotation in a:\n            return True\n    return False"}
{"task_id": "HumanEval/152", "solution": "def compare(game, guess):\n    \"\"\"\n    Determines how far off each guess was from the actual game score.\n    Returns a list of absolute differences; 0 for correct guesses.\n    \"\"\"\n    if not isinstance(game, list) or not all(isinstance(x, int) for x in game):\n        raise TypeError(\"Game scores must be a list of integers.\")\n    if not isinstance(guess, list) or not all(isinstance(x, int) for x in guess):\n        raise TypeError(\"Guess scores must be a list of integers.\")\n    if len(game) != len(guess):\n        raise ValueError(\"Game scores and guess scores lists must have the same length.\")\n\n    differences = []\n    for i in range(len(game)):\n        actual_score = game[i]\n        guessed_score = guess[i]\n        difference = abs(actual_score - guessed_score)\n        differences.append(difference)\n\n    return differences"}
{"task_id": "HumanEval/154", "solution": "class StringRotationGenerator:\n    def generate_rotations(self, word: str) -> list[str]:\n        \"\"\"Generates all unique cyclic rotations of the input word.\n        Raises ValueError if the input word is empty.\n        \"\"\"\n        if not word:\n            raise ValueError(\"Input word cannot be empty.\")\n        \n        rotations = set()\n        n = len(word)\n        for i in range(n):\n            rotated_word = word[i:] + word[:i]\n            rotations.add(rotated_word)\n        return list(rotations)\nclass CycPatternChecker:\n    def __init__(self, rotation_generator: StringRotationGenerator):\n        \"\"\"Initializes the checker with a rotation generator.\"\"\"\n        self._rotation_generator = rotation_generator\n\n    def check(self, word_a: str, word_b: str) -> bool:\n        \"\"\"Determines if any rotation of word_b is a substring of word_a.\n        Performs input validation for None and empty strings.\n        \"\"\"\n        if word_a is None or word_b is None:\n            raise TypeError(\"Input words cannot be None.\")\n        if not word_a or not word_b:\n            raise ValueError(\"Input words cannot be empty.\")\n\n        rotations = self._rotation_generator.generate_rotations(word_b)\n        for rotation in rotations:\n            if self._is_substring(word_a, rotation):\n                return True\n        return False\n\n    def _is_substring(self, main_string: str, sub_string: str) -> bool:\n        \"\"\"Checks if a substring is present within a main string.\"\"\"\n        return sub_string in main_string\ndef cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\n    cycpattern_check(\"abcd\",\"abd\") => False\n    cycpattern_check(\"hello\",\"ell\") => True\n    cycpattern_check(\"whassup\",\"psus\") => False\n    cycpattern_check(\"abab\",\"baa\") => True\n    cycpattern_check(\"efef\",\"eeff\") => False\n    cycpattern_check(\"himenss\",\"simen\") => True\n\n    \"\"\"\n    # Instantiates the necessary components for the check operation.\n    checker = CycPatternChecker(StringRotationGenerator())\n    return checker.check(a, b)"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"You will be given the name of a class (a string) and a list of extensions.\n    The extensions are to be used to load additional classes to the class. The\n    strength of the extension is as follows: Let CAP be the number of the uppercase\n    letters in the extension's name, and let SM be the number of lowercase letters\n    in the extension's name, the strength is given by the fraction CAP - SM.\n    You should find the strongest extension and return a string in this\n    format: ClassName.StrongestExtensionName.\n    If there are two or more extensions with the same strength, you should\n    choose the one that comes first in the list.\n    For example, if you are given \"Slices\" as the class and a list of the\n    extensions: ['SErviNGSliCes', 'Cheese', 'StuFfed'] then you should\n    return 'Slices.SErviNGSliCes' since 'SErviNGSliCes' is the strongest extension\n    (its strength is -1).\n    Example:\n    for Strongest_Extension('my_class', ['AA', 'Be', 'CC']) == 'my_class.AA'\n    \"\"\"\n\n    if not extensions:\n        raise ValueError(\"Extensions list cannot be empty.\")\n\n    def calculate_strength(extension_name: str) -> int:\n        cap_count = sum(1 for char in extension_name if 'A' <= char <= 'Z')\n        sm_count = sum(1 for char in extension_name if 'a' <= char <= 'z')\n        return cap_count - sm_count\n\n    strongest_extension_name: str = \"\"\n    max_strength: float = float('-inf')\n\n    for ext_name in extensions:\n        current_strength = calculate_strength(ext_name)\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = ext_name\n\n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"\n    Identifies the strongest extension from a list based on character counts\n    and formats it with the class name. Tie-breaking prioritizes earlier extensions.\n    \"\"\"\n    if not isinstance(class_name, str):\n        raise TypeError(\"Class name must be a string.\")\n    if not isinstance(extensions, list):\n        raise TypeError(\"Extensions must be a list.\")\n\n    if not extensions:\n        return class_name\n\n    strongest_extension_name = None\n    max_strength = -float('inf')\n\n    for ext_name in extensions:\n        if not isinstance(ext_name, str):\n            raise TypeError(f\"Extension '{ext_name}' in list must be a string.\")\n\n        cap_count = sum(1 for char in ext_name if 'A' <= char <= 'Z')\n        sm_count = sum(1 for char in ext_name if 'a' <= char <= 'z')\n        current_strength = cap_count - sm_count\n        \n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = ext_name\n\n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"\n    Given an integer, return a tuple that has the number of even and odd digits respectively.\n    Handles negative numbers by processing their absolute value and raises TypeError for non-integer input.\n    \"\"\"\n    if not isinstance(num, int):\n        raise TypeError(\"Input must be an integer.\")\n\n    even_count = 0\n    odd_count = 0\n\n    # Handle zero explicitly: 0 is an even digit.\n    if num == 0:\n        return (1, 0)\n\n    # Process the absolute value for digit extraction.\n    abs_num_str = str(abs(num))\n\n    for digit_char in abs_num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/157", "solution": "import math\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or \n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    # Ensure all side lengths are positive before proceeding with calculations.\n    if not (a > 0 and b > 0 and c > 0):\n        return False\n\n    # Sort sides to identify the potential hypotenuse and simplify the Pythagorean theorem check.\n    sides = sorted([a, b, c])\n    side1, side2, hypotenuse = sides[0], sides[1], sides[2]\n\n    # Use a small epsilon for robust floating-point comparison, as specified.\n    EPSILON = 1e-9\n    return math.isclose(side1**2 + side2**2, hypotenuse**2, rel_tol=EPSILON)"}
{"task_id": "HumanEval/158", "solution": "def _count_unique_chars(word: str) -> int:\n    \"\"\"Counts the number of unique characters in a string.\"\"\"\n    return len(set(word))\ndef find_max(words):\n    \"\"\"\n    Finds the word with the maximum number of unique characters.\n    If multiple strings tie, returns the lexicographically smallest.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    best_word: str = words[0]\n    max_unique_count: int = _count_unique_chars(best_word)\n\n    for i in range(1, len(words)):\n        word: str = words[i]\n        current_unique_count: int = _count_unique_chars(word)\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            best_word = word\n        elif current_unique_count == max_unique_count:\n            if word < best_word:\n                best_word = word\n    return best_word"}
{"task_id": "HumanEval/156", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input values.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass RomanNumeralMap:\n    \"\"\"Stores the mapping of integer values to their Roman numeral symbols.\"\"\"\n    ROMAN_MAP: list[tuple[int, str]] = [\n        (1000, \"M\"), (900, \"CM\"), (500, \"D\"), (400, \"CD\"),\n        (100, \"C\"), (90, \"XC\"), (50, \"L\"), (40, \"XL\"),\n        (10, \"X\"), (9, \"IX\"), (5, \"V\"), (4, \"IV\"), (1, \"I\")\n    ]\nclass RomanNumeralConverterService:\n    \"\"\"Encapsulates the core logic for converting an integer to its Roman numeral representation.\"\"\"\n    def __init__(self):\n        self._roman_map = RomanNumeralMap.ROMAN_MAP\n\n    def convert(self, num: int) -> str:\n        \"\"\"Converts the given integer num into its Roman numeral string.\"\"\"\n        result = []\n        temp_num = num\n        for value, symbol in self._roman_map:\n            while temp_num >= value:\n                result.append(symbol)\n                temp_num -= value\n        return \"\".join(result)\nclass RomanNumeralController:\n    \"\"\"Provides the public API for conversion, handling validation and delegating.\"\"\"\n    def __init__(self):\n        self._converter_service = RomanNumeralConverterService()\n\n    def convert_to_roman(self, num: int) -> str:\n        \"\"\"Validates input, converts to Roman numeral, and returns in lowercase.\"\"\"\n        if not isinstance(num, int) or not (1 <= num <= 1000):\n            raise InvalidInputError(\"Input must be an integer between 1 and 1000.\")\n        \n        roman_numeral = self._converter_service.convert(num)\n        return roman_numeral.lower()\n_controller_instance = RomanNumeralController()\ndef int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n\n    Examples:\n    >>> int_to_mini_roman(19) == 'xix'\n    >>> int_to_mini_roman(152) == 'clii'\n    >>> int_to_mini_roman(426) == 'cdxxvi'\n    \"\"\"\n    return _controller_instance.convert_to_roman(number)"}
{"task_id": "HumanEval/158", "solution": "def find_max(words: list[str]) -> str:\n    \"\"\"Finds the word with the maximum number of unique characters.\n    If multiple strings have maximum unique characters, returns the one\n    which comes first in lexicographical order.\n    \"\"\"\n\n    def _count_unique_chars(word: str) -> int:\n        \"\"\"Calculates the number of unique characters in a string.\"\"\"\n        return len(set(word))\n\n    if not words:\n        return \"\"\n\n    max_unique_chars = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_chars = _count_unique_chars(word)\n\n        if current_unique_chars > max_unique_chars:\n            max_unique_chars = current_unique_chars\n            result_word = word\n        elif current_unique_chars == max_unique_chars:\n            # Tie-breaking: if current_word is lexicographically smaller, it becomes the new best.\n            if word < result_word:\n                result_word = word\n    return result_word"}
{"task_id": "HumanEval/156", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input values.\n    It carries a descriptive message for the error.\"\"\"\n    def __init__(self, message=\"Input number is out of the valid range [1, 1000].\"):\n        self.message = message\n        super().__init__(self.message)\n_ROMAN_MAP = [\n    (1000, 'm'), (900, 'cm'), (500, 'd'), (400, 'cd'),\n    (100, 'c'), (90, 'xc'), (50, 'l'), (40, 'xl'),\n    (10, 'x'), (9, 'ix'), (5, 'v'), (4, 'iv'), (1, 'i')\n]\ndef int_to_mini_roman(number: int) -> str:\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n\n    Examples:\n    >>> int_to_mini_roman(19) == 'xix'\n    >>> int_to_mini_roman(152) == 'clii'\n    >>> int_to_mini_roman(426) == 'cdxxvi'\n    \"\"\"\n    if not isinstance(number, int) or not (1 <= number <= 1000):\n        raise InvalidInputError(f\"Number {number} is out of the valid range [1, 1000].\")\n\n    roman_numeral = []\n    temp_num = number\n    for value, symbol in _ROMAN_MAP:\n        while temp_num >= value:\n            roman_numeral.append(symbol)\n            temp_num -= value\n    return \"\".join(roman_numeral)"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"Calculates total carrots eaten and remaining stock after a rabbit's meal.\n    Returns a list `[total_eaten, carrots_left]` based on current eaten, need, and available stock.\n    \"\"\"\n    if not all(isinstance(arg, int) for arg in [number, need, remaining]):\n        raise TypeError(\"All inputs (number, need, remaining) must be integers.\")\n    if not all(0 <= arg <= 1000 for arg in [number, need, remaining]):\n        raise ValueError(\"All inputs must be between 0 and 1000 inclusive.\")\n\n    carrots_to_eat_from_stock = min(need, remaining)\n    \n    total_eaten = number + carrots_to_eat_from_stock\n    carrots_left = remaining - carrots_to_eat_from_stock\n    \n    return [total_eaten, carrots_left]"}
