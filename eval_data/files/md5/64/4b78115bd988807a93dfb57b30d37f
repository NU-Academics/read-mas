{"task_id": "HumanEval/151", "solution": "class NumberValidator:\n    \"\"\"Utility class for validating properties of numbers.\"\"\"\n    @staticmethod\n    def is_positive_odd_integer(num: any) -> bool:\n        \"\"\"Checks if a given input is a positive, odd integer.\"\"\"\n        return isinstance(num, int) and num > 0 and num % 2 != 0\ndef double_the_difference(lst):\n    \"\"\"\n    Given a list of numbers, return the sum of squares of positive odd integers.\n    Ignore non-integers, negative numbers, or zero, and returns 0 for non-list input.\n    \"\"\"\n    if not isinstance(lst, list):\n        return 0\n\n    total_sum_of_squares = 0\n    for num in lst:\n        if NumberValidator.is_positive_odd_integer(num):\n            total_sum_of_squares += num * num\n    return total_sum_of_squares"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension based on character case count, handling tie-breaking by appearance order.\n    Returns a formatted string combining the class name and the strongest extension.\n    \"\"\"\n    if not isinstance(class_name, str):\n        raise TypeError(\"Class name must be a string.\")\n    if not isinstance(extensions, list):\n        raise TypeError(\"Extensions must be a list.\")\n    if not all(isinstance(ext, str) for ext in extensions):\n        raise TypeError(\"All extensions in the list must be strings.\")\n    if not extensions:\n        raise ValueError(\"The extensions list cannot be empty.\")\n\n    strongest_ext_name = \"\"\n    max_strength = -float('inf')\n\n    for ext_name in extensions:\n        cap_count = sum(1 for char in ext_name if 'A' <= char <= 'Z')\n        sm_count = sum(1 for char in ext_name if 'a' <= char <= 'z')\n        current_strength = cap_count - sm_count\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_ext_name = ext_name\n\n    return f\"{class_name}.{strongest_ext_name}\""}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"\n    Checks if any cyclic rotation of string 'b' exists as a substring in string 'a'.\n    This function handles empty strings and performs case-sensitive comparisons.\n    \"\"\"\n    def generate_rotations_helper(s: str) -> list[str]:\n        \"\"\"\n        Generates all unique cyclic rotations of a given string.\n        It returns a list of unique rotated strings, handling empty or single-character inputs.\n        \"\"\"\n        if not s:\n            return [\"\"]\n        rotations = set()\n        n = len(s)\n        for i in range(n):\n            rotated_s = s[i:] + s[:i]\n            rotations.add(rotated_s)\n        return list(rotations)\n\n    if not b:\n        # An empty string is always considered a substring of any string.\n        return \"\" in a\n\n    rotations = generate_rotations_helper(b)\n    for rot in rotations:\n        if rot in a:\n            return True\n    return False"}
