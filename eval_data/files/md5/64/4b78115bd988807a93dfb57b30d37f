{"task_id": "HumanEval/21", "solution": "from typing import List\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input scenarios.\n    This exception is raised when input data fails validation checks.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef rescale_to_unit(numbers: List[float]) -> List[float]:\n    \"\"\"Applies a linear transform to a list of numbers, scaling them to the [0.0, 1.0] range.\n    Raises InvalidInputError if the input list has fewer than two elements.\n    \"\"\"\n    if len(numbers) < 2:\n        raise InvalidInputError(\"Input list must have at least two elements.\")\n\n    min_val = min(numbers)\n    max_val = max(numbers)\n\n    if min_val == max_val:\n        return [0.0] * len(numbers)\n    else:\n        scaled_numbers = []\n        for x in numbers:\n            scaled_value = (x - min_val) / (max_val - min_val)\n            scaled_numbers.append(scaled_value)\n        return scaled_numbers"}
