{"task_id": "HumanEval/115", "solution": "import math\ndef max_fill(grid: list[list[int]], capacity: int) -> int:\n    \"\"\"\n    Calculates the number of times buckets need to be lowered to empty wells.\n    This function handles input validation and orchestrates the calculation.\n    \"\"\"\n\n    def validate_grid(grid_param: list[list[int]]) -> None:\n        \"\"\"Validates the structure and content of the input grid.\"\"\"\n        if not isinstance(grid_param, list) or not grid_param:\n            raise ValueError(\"Grid must be a non-empty list of lists.\")\n        \n        num_rows = len(grid_param)\n        if not (1 <= num_rows <= 100):\n            raise ValueError(\"Grid length must be between 1 and 100.\")\n\n        num_cols = len(grid_param[0])\n        if not (1 <= num_cols <= 100):\n            raise ValueError(\"Well length must be between 1 and 100.\")\n\n        for row in grid_param:\n            if not isinstance(row, list) or len(row) != num_cols:\n                raise ValueError(\"All wells must have the same length and contain only lists.\")\n            for cell in row:\n                if not isinstance(cell, int) or cell not in (0, 1):\n                    raise ValueError(\"Grid cells must be 0 or 1.\")\n\n    def validate_capacity(capacity_param: int) -> None:\n        \"\"\"Validates the bucket capacity against defined constraints.\"\"\"\n        if not isinstance(capacity_param, int):\n            raise ValueError(\"Capacity must be an integer.\")\n        if not (1 <= capacity_param <= 10):\n            raise ValueError(\"Capacity must be between 1 and 10.\")\n\n    class Grid:\n        \"\"\"Encapsulates 2D grid data, providing access to well information.\"\"\"\n        def __init__(self, data: list[list[int]]):\n            self._data = data\n\n        def get_well_count(self) -> int:\n            \"\"\"Returns the number of wells (rows) in the grid.\"\"\"\n            return len(self._data)\n\n        def get_well_data(self, index: int) -> list[int]:\n            \"\"\"Returns the data for a specific well by index.\"\"\"\n            if not (0 <= index < len(self._data)):\n                raise IndexError(\"Well index out of bounds.\")\n            return self._data[index]\n\n    class Well:\n        \"\"\"Represents a single well and calculates its total water content.\"\"\"\n        def __init__(self, water_units: list[int]):\n            self._water_units = water_units\n\n        def get_total_water(self) -> int:\n            \"\"\"Calculates and returns the sum of water units in the well.\"\"\"\n            return sum(self._water_units)\n\n    class MaxFillCalculator:\n        \"\"\"Contains core logic for calculating total bucket lowering operations.\"\"\"\n        def calculate_max_fill(self, grid_data_param: list[list[int]], capacity_param: int) -> int:\n            \"\"\"Orchestrates the calculation of total bucket operations for the given grid and capacity.\"\"\"\n            grid_instance = Grid(grid_data_param)\n            total_bucket_operations = 0\n\n            for i in range(grid_instance.get_well_count()):\n                well_data = grid_instance.get_well_data(i)\n                well_instance = Well(well_data)\n                total_water = well_instance.get_total_water()\n\n                if total_water > 0:\n                    operations_for_well = math.ceil(total_water / capacity_param)\n                    total_bucket_operations += operations_for_well\n            \n            return total_bucket_operations\n\n    validate_grid(grid)\n    validate_capacity(capacity)\n\n    calculator = MaxFillCalculator()\n    return calculator.calculate_max_fill(grid, capacity)"}
{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"Given a string s and a natural number n, return a list of words from s\n    that contain exactly n consonants, in order these words appear in the string s.\n    \"\"\"\n    if not s:\n        return []\n\n    VOWELS = \"aeiou\"\n\n    def _count_consonants(word: str) -> int:\n        \"\"\"Counts the number of consonants in a given word.\"\"\"\n        count = 0\n        word_lower = word.lower()\n        for char in word_lower:\n            if 'a' <= char <= 'z' and char not in VOWELS:\n                count += 1\n        return count\n\n    result_words = []\n    words = s.split()\n\n    for word in words:\n        consonant_count = _count_consonants(word)\n        if consonant_count == n:\n            result_words.append(word)\n\n    return result_words"}
{"task_id": "HumanEval/117", "solution": "VOWELS_LOWER = {'a', 'e', 'i', 'o', 'u'}\ndef select_words(s, n):\n    \"\"\"\n    Given a string s and a natural number n, you have been tasked to implement \n    a function that returns a list of all words from string s that contain exactly \n    n consonants, in order these words appear in the string s.\n    If the string s is empty then the function should return an empty list.\n    Note: you may assume the input string contains only letters and spaces.\n    Examples:\n    select_words(\"Mary had a little lamb\", 4) ==> [\"little\"]\n    select_words(\"Mary had a little lamb\", 3) ==> [\"Mary\", \"lamb\"]\n    select_words(\"simple white space\", 2) ==> []\n    select_words(\"Hello world\", 4) ==> [\"world\"]\n    select_words(\"Uncle sam\", 3) ==> [\"Uncle\"]\n    \"\"\"\n\n    if not s:\n        return []\n\n    def _count_consonants(word: str) -> int:\n        \"\"\"\n        Counts the number of consonants in a given word.\n        \"\"\"\n        count = 0\n        for char in word:\n            lower_char = char.lower()\n            if 'a' <= lower_char <= 'z' and lower_char not in VOWELS_LOWER:\n                count += 1\n        return count\n\n    result_words = []\n    words = s.split()\n\n    for word in words:\n        consonant_count = _count_consonants(word)\n        if consonant_count == n:\n            result_words.append(word)\n\n    return result_words"}
{"task_id": "HumanEval/100", "solution": "def make_a_pile(n):\n    \"\"\"\n    Calculates a list of stone counts for `n` levels. The first level has `n` stones, and subsequent levels increase by 2.\n\n    Examples:\n    >>> make_a_pile(3)\n    [3, 5, 7]\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    levels_stones = [n]\n    current_stones = n\n    for _ in range(1, n):\n        current_stones += 2\n        levels_stones.append(current_stones)\n    return levels_stones"}
{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    '''\n    Checks if two given parentheses strings can be concatenated in any order to form a balanced string.\n    Returns 'Yes' if possible, 'No' otherwise.\n    '''\n\n    # FR1: Validate input list and its contents.\n    if not isinstance(lst, list) or len(lst) != 2:\n        raise ValueError(\"Input must be a list containing exactly two strings.\")\n    \n    s1, s2 = lst[0], lst[1]\n\n    if not isinstance(s1, str) or not isinstance(s2, str):\n        raise ValueError(\"All elements in the list must be strings.\")\n    \n    if not all(char in '()' for char in s1) or not all(char in '()' for char in s2):\n        raise ValueError(\"Strings must only contain '(' or ')' characters.\")\n\n    # Helper function to check if a single string is balanced (NFR1, BR1).\n    def _is_balanced_helper(s: str) -> bool:\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            else:  # char == ')'\n                balance -= 1\n            if balance < 0:\n                return False  # Balance dropped below zero.\n        return balance == 0  # Final balance must be zero.\n\n    # FR2, FR3: Check both concatenation orders.\n    if _is_balanced_helper(s1 + s2):\n        return 'Yes'\n    \n    if _is_balanced_helper(s2 + s1):\n        return 'Yes'\n    \n    return 'No'"}
{"task_id": "HumanEval/118", "solution": "def _is_vowel(char):\n    \"\"\"Checks if a character is a vowel.\n    The check is case-sensitive.\"\"\"\n    return char in \"aeiouAEIOU\"\ndef _is_consonant(char):\n    \"\"\"Checks if a character is a consonant.\n    Assumes char is a single English letter per constraints.\"\"\"\n    return char.isalpha() and not _is_vowel(char)\ndef get_closest_vowel(word):\n    \"\"\"You are given a word. Your task is to find the closest vowel that stands between \n    two consonants from the right side of the word (case sensitive).\n    \n    Vowels in the beginning and ending doesn't count. Return empty string if you didn't\n    find any vowel met the above condition. \n\n    You may assume that the given string contains English letter only.\n\n    Example:\n    get_closest_vowel(\"yogurt\") ==> \"u\"\n    get_closest_vowel(\"FULL\") ==> \"U\"\n    get_closest_vowel(\"quick\") ==> \"\"\n    get_closest_vowel(\"ab\") ==> \"\"\n    \"\"\"\n    \n    n = len(word)\n    # Words shorter than 3 characters cannot have an inner vowel surrounded by two consonants.\n    if n < 3:\n        return \"\"\n\n    # Iterate from the second-to-last character (index n-2) down to the second character (index 1).\n    # This range excludes the first and last characters as per business rules.\n    for i in range(n - 2, 0, -1):\n        current_char = word[i]\n        left_neighbor = word[i - 1]\n        right_neighbor = word[i + 1]\n\n        # Check if the current character is a vowel and its immediate neighbors are consonants.\n        if (_is_vowel(current_char) and\n                _is_consonant(left_neighbor) and\n                _is_consonant(right_neighbor)):\n            return current_char\n    \n    # If the loop completes without finding any vowel that meets the condition, return an empty string.\n    return \"\""}
{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"You are given a word. Your task is to find the closest vowel that stands between \n    two consonants from the right side of the word (case sensitive).\n    \n    Vowels in the beginning and ending doesn't count. Return empty string if you didn't\n    find any vowel met the above condition. \n\n    You may assume that the given string contains English letter only.\n\n    Example:\n    get_closest_vowel(\"yogurt\") ==> \"u\"\n    get_closest_vowel(\"FULL\") ==> \"U\"\n    get_closest_vowel(\"quick\") ==> \"\"\n    get_closest_vowel(\"ab\") ==> \"\"\n    \"\"\"\n    VOWELS_LOWERCASE = {'a', 'e', 'i', 'o', 'u'}\n\n    def is_vowel(char: str) -> bool:\n        return char.lower() in VOWELS_LOWERCASE\n\n    def is_consonant(char: str) -> bool:\n        return char.isalpha() and char.lower() not in VOWELS_LOWERCASE\n\n    n = len(word)\n    # Iterate from right to left, skipping the first and last characters.\n    # This range handles words shorter than 3 characters by being empty.\n    for i in range(n - 2, 0, -1):\n        char = word[i]\n        \n        # Check if the current character is a vowel.\n        if is_vowel(char):\n            # If it's a vowel, check if it's surrounded by consonants.\n            if is_consonant(word[i-1]) and is_consonant(word[i+1]):\n                return char  # Return the vowel, preserving its original case.\n    \n    # If no vowel meets the conditions after iterating, return an empty string.\n    return \"\""}
{"task_id": "HumanEval/119", "solution": "class ParensValidator:\n    \"\"\"A utility class to validate if a parenthesis string is balanced.\"\"\"\n    def is_balanced(self, s: str) -> bool:\n        \"\"\"Checks if the input string 's' is a balanced parenthesis string.\"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\nclass ParensService:\n    \"\"\"Orchestrates checking if two parenthesis strings can form a balanced string.\"\"\"\n    def __init__(self, validator: ParensValidator):\n        \"\"\"Initializes ParensService with a ParensValidator instance.\"\"\"\n        self._validator = validator\n\n    def match_parens(self, lst: list[str]) -> str:\n        \"\"\"Determines if concatenating the two strings in 'lst' in any order results in a balanced string.\"\"\"\n        if not isinstance(lst, list) or len(lst) != 2:\n            raise ValueError(\"Input must be a list containing exactly two strings.\")\n\n        s1, s2 = lst[0], lst[1]\n\n        for s_item in [s1, s2]:\n            if not isinstance(s_item, str) or not all(c in '()' for c in s_item):\n                raise ValueError(\"Each string in the list must contain only '(' or ')'.\")\n\n        # Check order 1: s1 + s2\n        concat1 = s1 + s2\n        is_balanced1 = self._validator.is_balanced(concat1)\n\n        # Check order 2: s2 + s1\n        concat2 = s2 + s1\n        is_balanced2 = self._validator.is_balanced(concat2)\n\n        if is_balanced1 or is_balanced2:\n            return 'Yes'\n        else:\n            return 'No'\ndef match_parens(lst):\n    '''\n    You are given a list of two strings, both strings consist of open\n    parentheses '(' or close parentheses ')' only.\n    Your job is to check if it is possible to concatenate the two strings in\n    some order, that the resulting string will be good.\n    A string S is considered to be good if and only if all parentheses in S\n    are balanced. For example: the string '(())()' is good, while the string\n    '())' is not.\n    Return 'Yes' if there's a way to make a good string, and return 'No' otherwise.\n\n    Examples:\n    match_parens(['()(', ')']) == 'Yes'\n    match_parens([')', ')']) == 'No'\n    '''\n    validator = ParensValidator()\n    service = ParensService(validator)\n    return service.match_parens(lst)"}
{"task_id": "HumanEval/120", "solution": "import heapq\ndef maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list\n    of length k with the maximum k numbers in arr.\n\n    Example 1:\n\n        Input: arr = [-3, -4, 5], k = 3\n        Output: [-4, -3, 5]\n\n    Example 2:\n\n        Input: arr = [4, -4, 4], k = 2\n        Output: [4, 4]\n\n    Example 3:\n\n        Input: arr = [-3, 2, 1, 2, -1, -2, 1], k = 1\n        Output: [2]\n\n    Note:\n        1. The length of the array will be in the range of [1, 1000].\n        2. The elements in the array will be in the range of [-1000, 1000].\n        3. 0 <= k <= len(arr)\n    \"\"\"\n    if k == 0:\n        return []\n\n    # Use a min-heap to keep track of the k largest elements seen so far.\n    # The heap will store at most k elements.\n    # If a new number is larger than the smallest element currently in the heap\n    # (which is at the root, min_heap[0]), then replace the smallest with the new number.\n    min_heap = []\n    for number in arr:\n        if len(min_heap) < k:\n            heapq.heappush(min_heap, number)\n        elif number > min_heap[0]:\n            heapq.heapreplace(min_heap, number)\n\n    # The min_heap now contains the k largest elements from the array.\n    # Popping elements from a min-heap one by one will give them in ascending order.\n    result = []\n    while min_heap:\n        result.append(heapq.heappop(min_heap))\n\n    return result"}
{"task_id": "HumanEval/121", "solution": "def solution(lst: list[int]) -> int:\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\"\"\"\n    total_sum = 0\n    for i in range(len(lst)):\n        if i % 2 == 0:  # Check if position is even.\n            if lst[i] % 2 != 0:  # Check if element is odd.\n                total_sum += lst[i]\n    return total_sum"}
{"task_id": "HumanEval/121", "solution": "def solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\n    \n\n    Examples\n    solution([5, 8, 7, 1]) ==> 12\n    solution([3, 3, 3, 3, 3]) ==> 9\n    solution([30, 13, 24, 321]) ==>0\n    \"\"\"\n    total_sum = 0\n    for i, element in enumerate(lst):\n        if i % 2 == 0 and element % 2 != 0:\n            total_sum += element\n    return total_sum"}
{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"arr must be a list of integers.\")\n    if not all(isinstance(x, int) for x in arr):\n        raise TypeError(\"All elements in arr must be integers.\")\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an integer.\")\n\n    if not (1 <= len(arr) <= 100):\n        raise ValueError(f\"Length of arr must be between 1 and 100, but got {len(arr)}.\")\n    if not (1 <= k <= len(arr)):\n        raise ValueError(f\"k must be between 1 and len(arr) ({len(arr)}), but got {k}.\")\n\n    current_sum = 0\n    for i in range(k):\n        element = arr[i]\n        # Check if the element has at most two digits (between -99 and 99, inclusive).\n        if -99 <= element <= 99:\n            current_sum += element\n            \n    return current_sum"}
{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    \"\"\"\n    current_sum = 0\n    for i in range(min(k, len(arr))): # Ensure we don't go out of bounds if k > len(arr) (though constraints prevent this)\n        element = arr[i]\n        if -99 <= element <= 99:\n            current_sum += element\n    return current_sum"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list of odd numbers in its Collatz sequence.\n    The Collatz sequence always ends at 1.\n    \"\"\"\n    odd_numbers = set()\n    current_n = n\n\n    while current_n != 1:\n        if current_n % 2 != 0:  # If current_n is odd\n            odd_numbers.add(current_n)\n            current_n = (3 * current_n) + 1\n        else:  # If current_n is even\n            current_n = current_n // 2\n    \n    odd_numbers.add(1) # Add 1, which is always the last odd number in the sequence.\n\n    sorted_odd_numbers = sorted(list(odd_numbers))\n    return sorted_odd_numbers"}
