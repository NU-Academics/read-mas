{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True"}
{"task_id": "HumanEval/31", "solution": "def is_prime(n: int) -> bool:\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    \"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:  # 2 and 3 are prime\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"Input must be a list.\")\n\n    elements_to_sort = []\n    # Identify elements at indices divisible by three.\n    for i, item in enumerate(l):\n        if i % 3 == 0:\n            elements_to_sort.append(item)\n\n    # Sort the identified elements in ascending order.\n    try:\n        elements_to_sort.sort()\n    except TypeError as e:\n        raise TypeError(f\"Elements at divisible-by-three indices are not sortable: {e}\")\n\n    # Construct the new list, preserving non-sorted elements.\n    result_list = l[:]\n    sorted_idx_ptr = 0\n    for i in range(len(result_list)):\n        if i % 3 == 0:\n            result_list[i] = elements_to_sort[sorted_idx_ptr]\n            sorted_idx_ptr += 1\n    return result_list"}
{"task_id": "HumanEval/34", "solution": "def unique(l: list) -> list:\n    \"\"\"Returns a new list containing only unique elements from the input list `l`, sorted in ascending order.\n    Raises `TypeError` if `l` is not a list or if elements are not comparable during sorting.\n    \"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"Input must be a list.\")\n\n    # Use a set for efficient uniqueness, then convert back to a list.\n    # Sorting will raise TypeError if elements are not comparable.\n    return sorted(list(set(l)))"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list) -> list:\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"Input must be a list.\")\n\n    if not l:\n        return []\n\n    # Identify indices divisible by three (FR2)\n    indices_to_sort = [i for i in range(len(l)) if i % 3 == 0]\n\n    # Extract values at these indices (FR3)\n    values_to_sort = [l[i] for i in indices_to_sort]\n\n    # Sort the extracted values (FR4)\n    values_to_sort.sort()\n\n    # Create a copy of the original list to modify (FR5)\n    result = list(l)\n\n    # Place the sorted values back into the result list at their original positions (FR6)\n    for i, original_index in enumerate(indices_to_sort):\n        result[original_index] = values_to_sort[i]\n\n    # Return the newly constructed list (FR7)\n    return result"}
{"task_id": "HumanEval/32", "solution": "import math\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    if len(xs) % 2 != 0:\n        raise ValueError(\"Coefficients list length must be even for zero finding.\")\n\n    # Helper function to calculate derivative coefficients\n    def calculate_derivative_coefficients(coefficients: list) -> list:\n        if not coefficients or len(coefficients) == 1:\n            return [0.0]\n        derivative_coeffs = []\n        for i in range(1, len(coefficients)):\n            derivative_coeffs.append(i * coefficients[i])\n        return derivative_coeffs\n\n    NEWTON_RAPHSON_MAX_ITERATIONS = 100\n    NEWTON_RAPHSON_TOLERANCE = 1e-6\n    INITIAL_GUESS = 0.0\n\n    current_x = INITIAL_GUESS\n    for _ in range(NEWTON_RAPHSON_MAX_ITERATIONS):\n        f_x = poly(xs, current_x)\n\n        if abs(f_x) < NEWTON_RAPHSON_TOLERANCE:\n            return current_x\n\n        derivative_coeffs = calculate_derivative_coefficients(xs)\n        f_prime_x = poly(derivative_coeffs, current_x)\n\n        if abs(f_prime_x) < NEWTON_RAPHSON_TOLERANCE:\n            # If derivative is too small, Newton-Raphson might diverge or stall.\n            # Given the problem statement guarantees a solution for valid inputs,\n            # this implies numerical issues or a very flat region.\n            # We'll raise an error as per the design to indicate it couldn't be found.\n            raise RuntimeError(\"Derivative too close to zero, cannot proceed with Newton-Raphson.\")\n\n        current_x = current_x - f_x / f_prime_x\n\n    raise RuntimeError(\"Zero not found within the maximum iterations.\")"}
{"task_id": "HumanEval/34", "solution": "def unique(l: list) -> list:\n    \"\"\"Returns a new list containing only the unique elements from the input list, sorted in ascending order.\"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"Input must be a list.\")\n\n    # Use a set to efficiently get unique elements.\n    unique_elements = set(l)\n\n    # Convert back to a list and sort.\n    sorted_unique_elements = sorted(list(unique_elements))\n\n    return sorted_unique_elements"}
