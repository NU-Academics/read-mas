{"task_id": "HumanEval/137", "solution": "from typing import Union, Optional\ndef _to_float(value: Union[int, float, str]) -> float:\n    \"\"\"Converts a value to its float representation, handling comma decimal separators in strings.\n    Raises ValueError if string conversion fails.\n    \"\"\"\n    if isinstance(value, str):\n        normalized_value = value.replace(',', '.')\n        return float(normalized_value)\n    return float(value)\ndef compare_one(a: Union[int, float, str], b: Union[int, float, str]) -> Optional[Union[int, float, str]]:\n    \"\"\"Compares two values numerically, returning the larger value in its original type.\n    Returns None if the values are numerically equal.\n    \"\"\"\n    float_a = _to_float(a)\n    float_b = _to_float(b)\n\n    if float_a > float_b:\n        return a\n    elif float_b > float_a:\n        return b\n    else:\n        return None"}
{"task_id": "HumanEval/138", "solution": "MIN_SUM_OF_FOUR_POSITIVE_EVENS = 8\ndef is_equal_to_sum_even(n):\n    \"\"\"\n    Evaluates if n can be written as the sum of exactly 4 positive even numbers.\n    Raises TypeError if n is not an integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    return n >= MIN_SUM_OF_FOUR_POSITIVE_EVENS and n % 2 == 0"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n: int) -> bool:\n    \"\"\"\n    Evaluates whether the given number n can be written as the sum of exactly 4 positive even numbers.\n    It returns True if n can be written as the sum of four positive even numbers, False otherwise.\n    \"\"\"\n    # The smallest sum of exactly 4 positive even numbers is 2+2+2+2=8.\n    if n < 8:\n        return False\n\n    # The sum of four even numbers must always be an even number.\n    if n % 2 != 0:\n        return False\n\n    # Any even number n >= 8 can be written as 2 + 2 + 2 + (n - 6), where (n - 6) is also a positive even number.\n    return True"}
{"task_id": "HumanEval/137", "solution": "from typing import Union\ndef _normalize_string_number(s: str) -> str:\n    \"\"\"Replaces commas with periods in a string to standardize decimal separators.\n    This prepares the string for conversion to a float.\"\"\"\n    return s.replace(',', '.')\ndef _parse_to_float(value: Union[int, float, str]) -> float:\n    \"\"\"Converts a value (int, float, or string) to its float representation.\n    String values are first normalized to handle comma decimal separators.\"\"\"\n    if isinstance(value, (int, float)):\n        return float(value)\n    elif isinstance(value, str):\n        normalized_string = _normalize_string_number(value)\n        try:\n            return float(normalized_string)\n        except ValueError as e:\n            raise ValueError(f\"Invalid number string: '{value}'\") from e\n    else:\n        raise TypeError(f\"Unsupported type for comparison: {type(value)}\")\ndef compare_one(a, b):\n    \"\"\"\n    Compares two numerical values (int, float, or string) and returns the larger in its original type.\n    Returns None if the values are numerically equal.\n    \"\"\"\n    float_a = _parse_to_float(a)\n    float_b = _parse_to_float(b)\n\n    if float_a > float_b:\n        return a\n    elif float_b > float_a:\n        return b\n    else:\n        return None"}
{"task_id": "HumanEval/139", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input to factorial functions.\"\"\"\n    pass\nERROR_NON_INTEGER = \"Input must be an integer.\"\nERROR_NON_POSITIVE = \"Input must be a positive integer.\"\nERROR_NON_NEGATIVE = \"Input must be a non-negative integer.\"\ndef _factorial(num: int) -> int:\n    \"\"\"Calculates the factorial of a non-negative integer. Raises InvalidInputError for invalid input.\"\"\"\n    if not isinstance(num, int):\n        raise InvalidInputError(ERROR_NON_INTEGER)\n    if num < 0:\n        raise InvalidInputError(ERROR_NON_NEGATIVE)\n    \n    if num == 0:\n        return 1\n    \n    result = 1\n    for i in range(1, num + 1):\n        result *= i\n    return result\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as: n! * (n-1)! * (n-2)! * ... * 1!.\n    This function computes the special factorial for a given positive integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise InvalidInputError(ERROR_NON_INTEGER)\n    if n <= 0:\n        raise InvalidInputError(ERROR_NON_POSITIVE)\n    \n    special_fact_result = 1\n    for i in range(1, n + 1):\n        special_fact_result *= _factorial(i)\n    return special_fact_result"}
{"task_id": "HumanEval/139", "solution": "def _factorial(k: int) -> int:\n    \"\"\"Calculates the standard factorial of a non-negative integer k.\n    This helper function is used internally and assumes k >= 0.\"\"\"\n    if k == 0:\n        return 1\n    res = 1\n    for i in range(1, k + 1):\n        res *= i\n    return res\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    special_fact_result = 1\n    for i in range(1, n + 1):\n        special_fact_result *= _factorial(i)\n    return special_fact_result"}
{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text: str) -> str:\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores,\n    and if a string has more than 2 consecutive spaces,\n    then replace all consecutive spaces with - .\n    \"\"\"\n    # First, replace sequences of two or more spaces with a single hyphen.\n    # This must be done before processing single spaces to prevent issues.\n    fixed_text = re.sub(r' {2,}', '-', text)\n\n    # Then, replace any remaining single spaces with underscores.\n    fixed_text = fixed_text.replace(' ', '_')\n\n    return fixed_text"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    \"\"\"\n    Splits a string by whitespace, then by commas if no whitespace,\n    otherwise counts odd-ordered lowercase letters with odd alphabetical order.\n    \"\"\"\n    if not isinstance(txt, str):\n        raise TypeError(\"Input must be a string.\")\n\n    if ' ' in txt:\n        return txt.split(' ')\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        count = 0\n        for char in txt:\n            if 'a' <= char <= 'z':\n                if (ord(char) - ord('a')) % 2 != 0:\n                    count += 1\n        return count"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions \n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n    - The file's name contains exactly one dot '.'\n    - The substring before the dot should not be empty, and it starts with a letter from \n    the latin alphapet ('a'-'z' and 'A'-'Z').\n    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    Examples:\n    file_name_check(\"example.txt\") # => 'Yes'\n    file_name_check(\"1example.dll\") # => 'No' (the name should start with a latin alphapet letter)\n    \"\"\"\n\n    # Define constants based on the design specification's business rules.\n    MAX_DIGITS = 3\n    ALLOWED_EXTENSIONS = ['txt', 'exe', 'dll']\n\n    # FR1: Ensure input is a string, as per precondition.\n    if not isinstance(file_name, str):\n        return 'No'\n\n    # FR3 / BR1.2: Check for exactly one dot in the file name.\n    if file_name.count('.') != 1:\n        return 'No'\n\n    # Safely split the file name into prefix and extension.\n    prefix, extension = file_name.split('.', 1)\n\n    # FR2 / BR1.1: Count digits and ensure they do not exceed MAX_DIGITS.\n    digit_count = sum(1 for char in file_name if char.isdigit())\n    if digit_count > MAX_DIGITS:\n        return 'No'\n\n    # FR4 / BR1.3 & BR1.4: Validate the prefix part of the file name.\n    # Prefix must not be empty and must start with a Latin letter.\n    if not prefix or not prefix[0].isalpha():\n        return 'No'\n\n    # FR5 / BR1.5: Validate the extension part of the file name.\n    # Extension must be one of the predefined allowed types.\n    if extension not in ALLOWED_EXTENSIONS:\n        return 'No'\n\n    # FR6: If all checks pass, the file name is valid.\n    return 'Yes'"}
