{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n\n    For example:\n    generate_integers(2, 8) => [2, 4, 6, 8]\n    generate_integers(8, 2) => [2, 4, 6, 8]\n    generate_integers(10, 14) => []\n    \"\"\"\n    start = min(a, b)\n    end = max(a, b)\n    even_numbers = []\n    for i in range(start, end + 1):\n        if i % 2 == 0:\n            even_numbers.append(i)\n    return even_numbers"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Identifies specific even single-digit numbers within a given integer range.\n    Returns a sorted list of even single-digit numbers found within the range [min(a, b), max(a, b)].\n    \"\"\"\n    if not isinstance(a, int) or not isinstance(b, int) or a <= 0 or b <= 0:\n        raise ValueError(\"Inputs 'a' and 'b' must be positive integers.\")\n\n    range_min = min(a, b)\n    range_max = max(a, b)\n\n    even_single_digits_target = {2, 4, 6, 8}\n    found_digits = []\n\n    for digit in sorted(list(even_single_digits_target)):\n        if range_min <= digit <= range_max:\n            found_digits.append(digit)\n\n    return found_digits"}
{"task_id": "HumanEval/159", "solution": "class InvalidCarrotInputError(ValueError):\n    \"\"\"Custom exception for invalid carrot input parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef eat(number, need, remaining):\n    \"\"\"\n    Calculates total carrots eaten and remaining stock based on rabbit's needs.\n    Handles scenarios where remaining carrots are insufficient.\n    \"\"\"\n    # Input validation as per InputValidator design\n    if not all(isinstance(arg, int) for arg in [number, need, remaining]):\n        raise InvalidCarrotInputError(\"All inputs must be integers.\")\n\n    if not (0 <= number <= 1000):\n        raise InvalidCarrotInputError(f\"Number of eaten carrots ({number}) must be between 0 and 1000.\")\n    if not (0 <= need <= 1000):\n        raise InvalidCarrotInputError(f\"Number of carrots needed ({need}) must be between 0 and 1000.\")\n    if not (0 <= remaining <= 1000):\n        raise InvalidCarrotInputError(f\"Number of remaining carrots ({remaining}) must be between 0 and 1000.\")\n\n    # Core logic as per CarrotService.eat design\n    carrots_to_eat_from_stock = min(need, remaining)\n    total_eaten = number + carrots_to_eat_from_stock\n    carrots_left = remaining - carrots_to_eat_from_stock\n\n    # Returns the result as a list [total_eaten, carrots_left]\n    return [total_eaten, carrots_left]"}
