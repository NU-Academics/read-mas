{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"Counts numbers greater than 10 where both the first and last digits (absolute) are odd.\n    Handles negative numbers by considering their absolute digit values.\"\"\"\n    count = 0\n    for number in nums:\n        if number > 10:\n            abs_num_str = str(abs(number))\n            first_digit = int(abs_num_str[0])\n            last_digit = int(abs_num_str[-1])\n            if first_digit % 2 != 0 and last_digit % 2 != 0:\n                count += 1\n    return count"}
{"task_id": "HumanEval/145", "solution": "def sum_digits(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the absolute value of digits for an integer.\n    Example: sum_digits(-12) == 3\n    \"\"\"\n    s = 0\n    for digit in str(abs(n)):\n        s += int(digit)\n    return s\ndef order_by_points(nums: list[int]) -> list[int]:\n    \"\"\"\n    Sorts a list of integers by the sum of their digits (ascending),\n    then by original index (ascending) for tie-breaking.\n    \"\"\"\n    if not nums:\n        return []\n\n    # Pair each number with its sum of digits and original index.\n    # This creates a 'decorated' list for stable sorting.\n    decorated_list = []\n    for i, num in enumerate(nums):\n        decorated_list.append((sum_digits(num), i, num))\n\n    # Sort the decorated list; Python's sort is stable and sorts tuples lexicographically.\n    decorated_list.sort()\n\n    # Extract the original numbers from the sorted tuples.\n    sorted_nums = [item[2] for item in decorated_list]\n\n    return sorted_nums"}
{"task_id": "HumanEval/144", "solution": "import math\nclass Fraction:\n    \"\"\"\n    Represents a mathematical fraction with a numerator and denominator.\n    Provides methods for parsing, multiplication, simplification, and whole number checks.\n    \"\"\"\n    def __init__(self, numerator: int, denominator: int):\n        if not isinstance(numerator, int) or not isinstance(denominator, int):\n            raise TypeError(\"Numerator and denominator must be integers.\")\n        if denominator <= 0:\n            raise ValueError(\"Denominator must be a positive whole number.\")\n        self.numerator = numerator\n        self.denominator = denominator\n\n    @classmethod\n    def from_string(cls, fraction_str: str) -> 'Fraction':\n        \"\"\"Constructs a Fraction object from a string in 'numerator/denominator' format.\"\"\"\n        parts = fraction_str.split('/')\n        if len(parts) != 2:\n            raise ValueError(\"Fraction string must be in 'numerator/denominator' format.\")\n        try:\n            numerator = int(parts[0])\n            denominator = int(parts[1])\n        except ValueError:\n            raise ValueError(\"Numerator and denominator must be valid integers.\")\n        return cls(numerator, denominator)\n\n    def __mul__(self, other: 'Fraction') -> 'Fraction':\n        \"\"\"Multiplies this fraction by another Fraction instance.\"\"\"\n        new_numerator = self.numerator * other.numerator\n        new_denominator = self.denominator * other.denominator\n        return Fraction(new_numerator, new_denominator)\n\n    def is_whole_number(self) -> bool:\n        \"\"\"Determines if the simplified fraction represents a whole number.\"\"\"\n        simplified = self._simplify()\n        return simplified.denominator == 1\n\n    def _simplify(self) -> 'Fraction':\n        \"\"\"Reduces the fraction to its lowest terms by dividing by their GCD.\"\"\"\n        common_divisor = self._gcd(self.numerator, self.denominator)\n        return Fraction(self.numerator // common_divisor, self.denominator // common_divisor)\n\n    @staticmethod\n    def _gcd(a: int, b: int) -> int:\n        \"\"\"Calculates the greatest common divisor of two integers.\"\"\"\n        return math.gcd(a, b)\n\n    def __repr__(self) -> str:\n        return f\"Fraction({self.numerator}/{self.denominator})\"\ndef simplify(x: str, n: str) -> bool:\n    \"\"\"\n    Checks if the product of two fractions (x * n) evaluates to a whole number.\n    Returns True if the product is a whole number, False otherwise.\n    \"\"\"\n    fraction_x = Fraction.from_string(x)\n    fraction_n = Fraction.from_string(n)\n    product_fraction = fraction_x * fraction_n\n    return product_fraction.is_whole_number()"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"\n    Filters an array of numbers and returns the count of elements that are\n    greater than 10 and have both first and last digits as odd.\n    \"\"\"\n\n    def _is_odd(digit: int) -> bool:\n        \"\"\"Checks if a given digit is odd. Returns True if odd, False otherwise.\"\"\"\n        return digit % 2 != 0\n\n    def _get_first_digit(num: int) -> int:\n        \"\"\"Extracts the first digit of a number (absolute value).\"\"\"\n        s_num = str(abs(num))\n        return int(s_num[0])\n\n    def _get_last_digit(num: int) -> int:\n        \"\"\"Extracts the last digit of a number (absolute value).\"\"\"\n        s_num = str(abs(num))\n        return int(s_num[-1])\n\n    if not isinstance(nums, list):\n        raise TypeError(\"Input must be a list of integers.\")\n    \n    count = 0\n    for num in nums:\n        if not isinstance(num, int):\n            raise TypeError(\"All elements in the list must be integers.\")\n\n        if num > 10:\n            first_digit = _get_first_digit(num)\n            last_digit = _get_last_digit(num)\n\n            if _is_odd(first_digit) and _is_odd(last_digit):\n                count += 1\n    return count"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n: int) -> int:\n    \"\"\"\n    Counts triples (a[i], a[j], a[k]) from a generated array 'a' where their sum is a multiple of 3.\n    The array 'a' is generated such that a[i] = i*i - i + 1 for 1 <= i <= n.\n    \"\"\"\n    try:\n        # Validate n as per FR1 and BR1\n        if not isinstance(n, int) or n <= 0:\n            raise ValueError(\"n must be a positive integer.\")\n\n        # FR1: Generate array 'a' with a[i] = i*i - i + 1\n        arr = [0] * n\n        for i_val in range(1, n + 1):\n            arr[i_val - 1] = i_val * i_val - i_val + 1\n        \n        # FR2, FR3, FR4: Identify, determine, and count valid triples\n        count = 0\n        arr_len = n\n\n        # FR2 Preconditions: If n < 3, no triples can be formed.\n        if arr_len < 3:\n            return 0\n\n        # Optimization (NFR1): Use modulo 3 values to avoid large sums and improve performance.\n        # The sum (x + y + z) is a multiple of 3 if (x%3 + y%3 + z%3) is a multiple of 3.\n        mod_values = [x % 3 for x in arr]\n\n        # FR2: Iterate through all unique combinations of indices i < j < k\n        for i in range(arr_len):\n            for j in range(i + 1, arr_len):\n                for k in range(j + 1, arr_len):\n                    # FR3: Determine if the sum a[i] + a[j] + a[k] is a multiple of 3 (BR3)\n                    if (mod_values[i] + mod_values[j] + mod_values[k]) % 3 == 0:\n                        count += 1  # FR4: Increment counter for each valid triple\n        return count\n    except ValueError:\n        # MainApp error handling strategy for invalid 'n'\n        return 0"}
{"task_id": "HumanEval/144", "solution": "def gcd(a: int, b: int) -> int:\n    \"\"\"Calculates the greatest common divisor of two integers.\"\"\"\n    while b:\n        a, b = b, a % b\n    return a\nclass Fraction:\n    \"\"\"Represents a mathematical fraction.\"\"\"\n    def __init__(self, numerator: int, denominator: int):\n        if denominator == 0:\n            raise ValueError(\"Denominator cannot be zero.\")\n        self._numerator = numerator\n        self._denominator = denominator\n\n    @property\n    def numerator(self) -> int:\n        return self._numerator\n\n    @property\n    def denominator(self) -> int:\n        return self._denominator\n\n    def __mul__(self, other: 'Fraction') -> 'Fraction':\n        \"\"\"Multiplies this fraction by another Fraction object. Returns a new, simplified Fraction.\"\"\"\n        new_numerator = self.numerator * other.numerator\n        new_denominator = self.denominator * other.denominator\n        return Fraction(new_numerator, new_denominator).simplify()\n\n    def is_whole_number(self) -> bool:\n        \"\"\"Checks if the fraction represents a whole number.\"\"\"\n        return self.denominator == 1\n\n    def simplify(self) -> 'Fraction':\n        \"\"\"Simplifies the fraction by dividing numerator and denominator by their GCD. Returns a new, simplified Fraction.\"\"\"\n        common_divisor = gcd(abs(self._numerator), abs(self._denominator))\n        return Fraction(self._numerator // common_divisor, self._denominator // common_divisor)\nclass FractionParser:\n    \"\"\"Utility for parsing fraction strings.\"\"\"\n    @staticmethod\n    def parse_fraction_string(fraction_str: str) -> Fraction:\n        \"\"\"\n        Parses a string like \"numerator/denominator\" into a Fraction object.\n        \"\"\"\n        try:\n            parts = fraction_str.split('/')\n            if len(parts) != 2:\n                raise ValueError(\"Fraction string must be in 'numerator/denominator' format.\")\n            numerator = int(parts[0])\n            denominator = int(parts[1])\n            return Fraction(numerator, denominator)\n        except ValueError as e:\n            raise ValueError(f\"Invalid fraction string '{fraction_str}': {e}\")\ndef simplify(x: str, n: str) -> bool:\n    \"\"\"\n    Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n\n    You can assume that x, and n are valid fractions, and do not have zero as denominator.\n\n    simplify(\"1/5\", \"5/1\") = True\n    simplify(\"1/6\", \"2/1\") = False\n    simplify(\"7/10\", \"10/2\") = False\n    \"\"\"\n    fraction_x = FractionParser.parse_fraction_string(x)\n    fraction_n = FractionParser.parse_fraction_string(n)\n\n    product_fraction = fraction_x * fraction_n\n    return product_fraction.is_whole_number()"}
