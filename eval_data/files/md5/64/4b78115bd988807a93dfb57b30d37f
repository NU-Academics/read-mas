{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"Encodes a message by swapping letter cases and replacing vowels.\n    Vowels are replaced with the letter two places ahead in the alphabet, wrapping around.\n    \n    Examples:\n    >>> encode('test')\n    'TGST'\n    >>> encode('This is a message')\n    'tHKS KS C MGSSCGG'\n    \"\"\"\n    VOWELS = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n    ALPHABET_LOWER = 'abcdefghijklmnopqrstuvwxyz'\n    ALPHABET_UPPER = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'\n\n    ALPHABET_MAP_LOWER = {\n        char: ALPHABET_LOWER[(i + 2) % len(ALPHABET_LOWER)]\n        for i, char in enumerate(ALPHABET_LOWER)\n    }\n    ALPHABET_MAP_UPPER = {\n        char: ALPHABET_UPPER[(i + 2) % len(ALPHABET_UPPER)]\n        for i, char in enumerate(ALPHABET_UPPER)\n    }\n\n    def _swap_case_local(char: str) -> str:\n        if char.islower():\n            return char.upper()\n        else:\n            return char.lower()\n\n    def _replace_vowel_local(char: str) -> str:\n        if char.islower():\n            return ALPHABET_MAP_LOWER.get(char, char)\n        else:\n            return ALPHABET_MAP_UPPER.get(char, char)\n\n    encoded_chars = []\n    for char in message:\n        if char.isalpha():\n            processed_char = _swap_case_local(char)\n            if processed_char.lower() in VOWELS:\n                processed_char = _replace_vowel_local(processed_char)\n            encoded_chars.append(processed_char)\n        else:\n            encoded_chars.append(char)\n    return ''.join(encoded_chars)"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst: list[int]) -> int:\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n\n    class PrimeUtils:\n        \"\"\"Provides utility methods for primality testing and digit summation.\"\"\"\n        @staticmethod\n        def is_prime(n: int) -> bool:\n            \"\"\"Checks if an integer is a prime number.\"\"\"\n            if n <= 1:\n                return False\n            if n <= 3:\n                return True\n            if n % 2 == 0 or n % 3 == 0:\n                return False\n            i = 5\n            while i * i <= n:\n                if n % i == 0 or n % (i + 2) == 0:\n                    return False\n                i += 6\n            return True\n\n        @staticmethod\n        def sum_digits(n: int) -> int:\n            \"\"\"Calculates the sum of the absolute value of an integer's digits.\"\"\"\n            s = 0\n            n_abs = abs(n)\n            while n_abs > 0:\n                s += n_abs % 10\n                n_abs //= 10\n            return s\n\n    class PrimeAnalyzerService:\n        \"\"\"Orchestrates finding the largest prime and summing its digits.\"\"\"\n        def __init__(self, prime_utils_instance: PrimeUtils):\n            \"\"\"Initializes the service with a PrimeUtils instance.\"\"\"\n            self.prime_utils = prime_utils_instance\n\n        def find_largest_prime_sum_digits(self, lst: list[int]) -> int:\n            \"\"\"Identifies the largest prime in a list and sums its digits.\"\"\"\n            largest_prime = None\n            for num in lst:\n                if self.prime_utils.is_prime(num):\n                    if largest_prime is None or num > largest_prime:\n                        largest_prime = num\n\n            if largest_prime is not None:\n                return self.prime_utils.sum_digits(largest_prime)\n            return 0\n\n    # Validate input list and its elements.\n    if not isinstance(lst, list):\n        raise TypeError(\"Input must be a list.\")\n    if not all(isinstance(x, int) for x in lst):\n        raise ValueError(\"All elements in the list must be integers.\")\n\n    # Initialize components and execute the main logic.\n    prime_utils_instance = PrimeUtils()\n    analyzer_service = PrimeAnalyzerService(prime_utils_instance)\n    return analyzer_service.find_largest_prime_sum_digits(lst)"}
