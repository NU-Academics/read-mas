{"task_id": "HumanEval/96", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\nclass SieveOfEratosthenes:\n    def __init__(self, limit: int):\n        self.limit = limit\n        self.is_prime = [True] * self.limit\n\n    def generate(self) -> list[int]:\n        if self.limit <= 2:\n            return []\n\n        self.is_prime[0] = self.is_prime[1] = False\n        for p in range(2, int(self.limit**0.5) + 1):\n            if self.is_prime[p]:\n                for multiple in range(p * p, self.limit, p):\n                    self.is_prime[multiple] = False\n\n        primes = [i for i, prime_status in enumerate(self.is_prime) if prime_status]\n        return primes\ndef count_up_to(n: int) -> list[int]:\n    \"\"\"\n    Implement a function that takes an non-negative integer and returns an array of the first n\n    integers that are prime numbers and less than n.\n    for example:\n    count_up_to(5) => [2,3]\n    count_up_to(11) => [2,3,5,7]\n    count_up_to(0) => []\n    count_up_to(20) => [2,3,5,7,11,13,17,19]\n    count_up_to(1) => []\n    count_up_to(18) => [2,3,5,7,11,13,17]\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise InvalidInputError(\"Input 'n' must be a non-negative integer.\")\n\n    if n <= 2:\n        return []\n\n    sieve = SieveOfEratosthenes(n)\n    return sieve.generate()"}
{"task_id": "HumanEval/96", "solution": "def _is_prime(num: int) -> bool:\n    if num < 2:\n        return False\n    for i in range(2, int(num**0.5) + 1):\n        if num % i == 0:\n            return False\n    return True\ndef count_up_to(n):\n    \"\"\"\n    Returns a list of all prime numbers p such that 2 <= p < n.\n    Handles edge cases for n=0, 1, returning an empty list.\n    \"\"\"\n    if n < 2:\n        return []\n\n    primes = []\n    for num in range(2, n):\n        if _is_prime(num):\n            primes.append(num)\n    return primes"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict: dict) -> bool:\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower \n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    \"\"\"\n    if not dict:\n        return False\n\n    string_keys = [key for key in dict.keys() if isinstance(key, str)]\n\n    if len(string_keys) != len(dict):\n        # Contains non-string keys\n        return False\n        \n    all_lower = True\n    all_upper = True\n\n    for key in string_keys:\n        if not key.islower():\n            all_lower = False\n        if not key.isupper():\n            all_upper = False\n        \n        # Optimization: if both become False, we can stop early\n        if not all_lower and not all_upper:\n            return False\n\n    return all_lower or all_upper"}
{"task_id": "HumanEval/93", "solution": "import string\ndef encode(message):\n    \"\"\"\n    Encodes a message by applying specific character manipulation rules.\n    It swaps the case of all letters and shifts vowels two places forward in the alphabet.\n    \"\"\"\n    if not isinstance(message, str):\n        raise TypeError(\"Input message must be a string.\")\n\n    VOWELS_LOWER = {'a', 'e', 'i', 'o', 'u'}\n    VOWELS_UPPER = {'A', 'E', 'I', 'O', 'U'}\n    ALPHABET_LOWER = string.ascii_lowercase\n    ALPHABET_UPPER = string.ascii_uppercase\n\n    encoded_chars = []\n    for char in message:\n        if not char.isalpha():\n            encoded_chars.append(char)\n        else:\n            processed_char = char\n            \n            # If the character is a vowel, shift it two places forward in the alphabet.\n            # The case of the shifted vowel is preserved based on the original vowel's case.\n            if processed_char in VOWELS_LOWER or processed_char in VOWELS_UPPER:\n                shift_by = 2\n                if processed_char.islower():\n                    alphabet = ALPHABET_LOWER\n                else: # processed_char.isupper()\n                    alphabet = ALPHABET_UPPER\n\n                current_index = alphabet.index(processed_char)\n                new_index = (current_index + shift_by) % len(alphabet)\n                processed_char = alphabet[new_index]\n            \n            # After potential vowel shifting, swap the case of the character.\n            # This applies to original consonants and potentially shifted vowels.\n            processed_char = processed_char.swapcase()\n            encoded_chars.append(processed_char)\n\n    return \"\".join(encoded_chars)"}
