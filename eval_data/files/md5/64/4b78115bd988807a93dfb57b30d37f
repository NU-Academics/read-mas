{"task_id": "HumanEval/148", "solution": "PLANET_ORDER = [\n    \"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\",\n    \"Saturn\", \"Uranus\", \"Neptune\"\n]\ndef bf(planet1, planet2):\n    \"\"\"\n    Returns planets between two specified planets, sorted by proximity to the sun.\n    Returns an empty tuple if planet names are invalid, identical, or adjacent.\n    \"\"\"\n    try:\n        idx1 = PLANET_ORDER.index(planet1)\n        idx2 = PLANET_ORDER.index(planet2)\n    except ValueError:\n        return ()\n\n    if idx1 > idx2:\n        idx1, idx2 = idx2, idx1\n\n    if idx2 - idx1 <= 1:\n        return ()\n\n    return tuple(PLANET_ORDER[idx1 + 1 : idx2])"}
{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    \"\"\"\n    Identifies planets located between two specified planets in our solar system.\n    Returns an empty tuple if planet names are invalid or no planets are found between them.\n    \"\"\"\n    PLANETS = (\n        \"Mercury\", \"Venus\", \"Earth\", \"Mars\",\n        \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n    )\n\n    def _get_planet_index(name: str) -> int | None:\n        \"\"\"Returns the zero-based index of a planet, or None if not found.\"\"\"\n        try:\n            return PLANETS.index(name)\n        except ValueError:\n            return None\n\n    # Validate both planet names by retrieving their indices.\n    index1 = _get_planet_index(planet1)\n    index2 = _get_planet_index(planet2)\n\n    # If either planet name is invalid, return an empty tuple as per requirements.\n    if index1 is None or index2 is None:\n        return ()\n\n    # Determine the actual start and end indices for slicing, ensuring ascending order.\n    start_idx = min(index1, index2)\n    end_idx = max(index1, index2)\n\n    # Slice the PLANETS tuple to get elements strictly between the two planet indices.\n    between_planets = PLANETS[start_idx + 1 : end_idx]\n    return tuple(between_planets)"}
{"task_id": "HumanEval/150", "solution": "import math\ndef x_or_y(n, x, y):\n    \"\"\"Checks if 'n' is prime and returns 'x' if true, 'y' otherwise.\n    This function implements the primality test as described in the design specification.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n\n    # Apply primality test based on FR1\n    if n <= 1:\n        is_n_prime = False\n    elif n == 2:\n        is_n_prime = True\n    elif n % 2 == 0:  # Even numbers greater than 2 are not prime\n        is_n_prime = False\n    else:\n        # Check for odd divisors from 3 up to the square root of n.\n        is_n_prime = True\n        limit = int(math.sqrt(n))\n        for i in range(3, limit + 1, 2):\n            if n % i == 0:\n                is_n_prime = False\n                break\n\n    if is_n_prime:\n        return x\n    else:\n        return y"}
