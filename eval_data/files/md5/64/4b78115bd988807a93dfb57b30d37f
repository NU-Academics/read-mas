{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a, b):\n    \"\"\"\n    Checks if the second word or any of its rotations is a substring in the first word.\n    An empty string is considered a substring of any string.\n    \"\"\"\n    if not b:\n        return True\n    if len(b) > len(a):\n        return False\n\n    # Generate all rotations of b by concatenating b with itself.\n    # Then, check each possible cyclic shift as a substring.\n    doubled_b = b + b\n    for i in range(len(b)):\n        rotation = doubled_b[i : i + len(b)]\n        if rotation in a:\n            return True\n    return False"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num: int) -> tuple[int, int]:\n    \"\"\"Given an integer, return a tuple that has the number of even and odd digits respectively.\n     Example: even_odd_count(-12) ==> (1, 1), even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n    \n    abs_num = abs(num)\n    num_str = str(abs_num)\n    \n    for digit_char in num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n            \n    return (even_count, odd_count)"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n\n    Examples:\n    >>> int_to_mini_roman(19) == 'xix'\n    >>> int_to_mini_roman(152) == 'clii'\n    >>> int_to_mini_roman(426) == 'cdxxvi'\n    \"\"\"\n    ROMAN_NUMERAL_MAP = [\n        (1000, 'm'), (900, 'cm'), (500, 'd'), (400, 'cd'),\n        (100, 'c'), (90, 'xc'), (50, 'l'), (40, 'xl'),\n        (10, 'x'), (9, 'ix'), (5, 'v'), (4, 'iv'), (1, 'i')\n    ]\n\n    if not isinstance(number, int) or not (1 <= number <= 1000):\n        raise ValueError(\"Input number must be an integer between 1 and 1000.\")\n\n    roman_numeral_parts = []\n    temp_num = number\n\n    for value, symbol in ROMAN_NUMERAL_MAP:\n        while temp_num >= value:\n            roman_numeral_parts.append(symbol)\n            temp_num -= value\n    \n    return \"\".join(roman_numeral_parts)"}
{"task_id": "HumanEval/156", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input numbers.\"\"\"\n    pass\nROMAN_MAP = [\n    (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n    (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n    (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'), (1, 'I')\n]\nclass RomanConverter:\n    \"\"\"\n    Handles the core logic for converting integers to Roman numerals.\n    \"\"\"\n    @staticmethod\n    def convert(number: int) -> str:\n        \"\"\"\n        Converts a positive integer to its lowercase Roman numeral equivalent.\n        Assumes input number is within the valid range [1, 1000].\n        \"\"\"\n        roman_numeral = []\n        temp_num = number\n        for value, symbol in ROMAN_MAP:\n            while temp_num >= value:\n                roman_numeral.append(symbol)\n                temp_num -= value\n        return \"\".join(roman_numeral).lower()\ndef int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n\n    Examples:\n    >>> int_to_mini_roman(19) == 'xix'\n    >>> int_to_mini_roman(152) == 'clii'\n    >>> int_to_mini_roman(426) == 'cdxxvi'\n    \"\"\"\n    if not isinstance(number, int) or not (1 <= number <= 1000):\n        raise InvalidInputError(\"Input number must be an integer between 1 and 1000.\")\n    return RomanConverter.convert(number)"}
{"task_id": "HumanEval/158", "solution": "def count_unique_chars(word: str) -> int:\n    \"\"\"Counts the number of unique characters in a given string.\n    Returns the count of unique characters.\n    \"\"\"\n    return len(set(word))\ndef find_max(words):\n    \"\"\"Returns the word with the maximum number of unique characters.\n    If ties exist, the lexicographically smallest word is returned.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    best_word = \"\"\n\n    for word in words:\n        current_unique_count = count_unique_chars(word)\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            best_word = word\n        elif current_unique_count == max_unique_count:\n            if word < best_word:\n                best_word = word\n    return best_word"}
{"task_id": "HumanEval/157", "solution": "class TriangleValidationError(Exception):\n    \"\"\"Base exception for triangle validation errors.\"\"\"\n    pass\nclass InvalidSideLengthError(TriangleValidationError):\n    \"\"\"Raised when a side length is not positive.\"\"\"\n    pass\nclass NotATriangleError(TriangleValidationError):\n    \"\"\"Raised when the given sides cannot form a valid triangle.\"\"\"\n    pass\ndef are_nearly_equal(a: float, b: float, epsilon: float = 1e-9) -> bool:\n    \"\"\"Compares two floats for approximate equality.\"\"\"\n    return abs(a - b) < epsilon\nclass TriangleService:\n    EPSILON: float = 1e-9\n\n    def is_right_angled(self, side_a: float, side_b: float, side_c: float) -> bool:\n        \"\"\"Determines if the given sides form a right-angled triangle.\"\"\"\n        self._validate_sides_positive(side_a, side_b, side_c)\n        self._validate_triangle_inequality(side_a, side_b, side_c)\n        return self._check_pythagorean_theorem(side_a, side_b, side_c)\n\n    def _validate_sides_positive(self, side_a: float, side_b: float, side_c: float) -> None:\n        \"\"\"Ensures all side lengths are positive.\"\"\"\n        if not (side_a > 0 and side_b > 0 and side_c > 0):\n            raise InvalidSideLengthError(\"All side lengths must be positive.\")\n\n    def _validate_triangle_inequality(self, side_a: float, side_b: float, side_c: float) -> None:\n        \"\"\"Ensures the sides can form a valid triangle.\"\"\"\n        if not (side_a + side_b > side_c and\n                side_a + side_c > side_b and\n                side_b + side_c > side_a):\n            raise NotATriangleError(\"The given side lengths cannot form a valid triangle.\")\n\n    def _check_pythagorean_theorem(self, side_a: float, side_b: float, side_c: float) -> bool:\n        \"\"\"Checks if any permutation of sides satisfies the Pythagorean theorem.\"\"\"\n        sides_squared = sorted([side_a**2, side_b**2, side_c**2])\n        return are_nearly_equal(sides_squared[0] + sides_squared[1], sides_squared[2], self.EPSILON)\ndef right_angle_triangle(a: float, b: float, c: float) -> bool:\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    '''\n    service = TriangleService()\n    return service.is_right_angled(a, b, c)"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates total carrots eaten and remaining stock after a rabbit's meal.\n    If 'need' exceeds 'remaining', all 'remaining' carrots are eaten.\n    \"\"\"\n    carrots_to_eat = min(need, remaining)\n    total_eaten = number + carrots_to_eat\n    carrots_left = remaining - carrots_to_eat\n    return [total_eaten, carrots_left]"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    \"\"\"\n    Given the lengths of three sides of a triangle, determines if it's right-angled.\n    Raises TypeError or ValueError for invalid inputs.\n    \"\"\"\n    # Precision constant for floating-point comparisons as per NFR3.\n    EPSILON: float = 1e-9\n\n    def _float_equals(val1: float, val2: float, epsilon: float = EPSILON) -> bool:\n        \"\"\"Compares two floats for approximate equality using an epsilon.\"\"\"\n        return abs(val1 - val2) < epsilon\n\n    # FR1: Accept three numeric values and validate type.\n    if not all(isinstance(side, (int, float)) for side in [a, b, c]):\n        raise TypeError(\"All side lengths must be numeric.\")\n\n    # Convert inputs to float for consistent calculations.\n    a, b, c = float(a), float(b), float(c)\n\n    # FR2: Validate that all three side lengths are positive numbers.\n    if not all(side > 0 for side in [a, b, c]):\n        raise ValueError(\"All side lengths must be positive.\")\n\n    # FR3: Validate triangle inequality theorem (a + b > c, etc.).\n    if not (a + b > c and a + c > b and b + c > a):\n        raise ValueError(\"The given side lengths do not form a valid triangle.\")\n\n    # FR4: Determine if the sides form a right-angled triangle using Pythagorean theorem.\n    # Sort sides to easily identify the potential hypotenuse (longest side).\n    sides = sorted([a, b, c])\n    s1, s2, s3 = sides[0], sides[1], sides[2]\n\n    # Check if s1^2 + s2^2 equals s3^2, accounting for float precision.\n    # FR5: Return True if right-angled, False otherwise.\n    return _float_equals(s1**2 + s2**2, s3**2)"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"\n    Transforms a string s based on character type:\n    Reverses case of letters, keeps non-letters as is, or reverses the entire string if no letters are present.\n    \"\"\"\n    def _is_letter(char: str) -> bool:\n        \"\"\"Checks if a given single-character string is an alphabetic letter.\"\"\"\n        return char.isalpha()\n\n    def _reverse_case(char: str) -> str:\n        \"\"\"Reverses the case of a single alphabetic character.\"\"\"\n        if char.islower():\n            return char.upper()\n        elif char.isupper():\n            return char.lower()\n        return char\n\n    def _has_letters(input_str: str) -> bool:\n        \"\"\"Checks if the input string contains at least one alphabetic letter.\"\"\"\n        return any(char.isalpha() for char in input_str)\n\n    if not _has_letters(s):\n        return s[::-1]\n\n    transformed_chars = []\n    for char in s:\n        if _is_letter(char):\n            transformed_chars.append(_reverse_case(char))\n        else:\n            transformed_chars.append(char)\n    return \"\".join(transformed_chars)"}
