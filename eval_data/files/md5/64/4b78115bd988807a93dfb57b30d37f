{"task_id": "HumanEval/39", "solution": "import math\nclass FibonacciGenerator:\n    _fib_cache: list[int] = [0, 1]\n\n    def __init__(self) -> None:\n        pass\n\n    def generate_next(self) -> int:\n        \"\"\"Generates the next Fibonacci number and adds it to the shared cache. Handles initial sequence setup.\"\"\"\n        if len(self._fib_cache) < 2:\n            if not self._fib_cache:\n                self._fib_cache.append(0)\n            if len(self._fib_cache) == 1:\n                self._fib_cache.append(1)\n            return self._fib_cache[-1]\n\n        next_fib = self._fib_cache[-1] + self._fib_cache[-2]\n        self._fib_cache.append(next_fib)\n        return next_fib\n\n    def get_fib_at_index(self, index: int) -> int:\n        \"\"\"Retrieves the Fibonacci number at a specific index, generating numbers sequentially if needed. Utilizes the shared cache to avoid redundant calculations.\"\"\"\n        while len(self._fib_cache) <= index:\n            self.generate_next()\n        return self._fib_cache[index]\nclass PrimeChecker:\n    _prime_cache: dict[int, bool] = {}\n\n    def __init__(self) -> None:\n        pass\n\n    def is_prime(self, num: int) -> bool:\n        \"\"\"Determines if a given number is prime using a trial division algorithm up to its square root. Caches results to optimize subsequent checks for the same number.\"\"\"\n        if num in self._prime_cache:\n            return self._prime_cache[num]\n\n        if num < 2:\n            self._prime_cache[num] = False\n            return False\n        if num == 2:\n            self._prime_cache[num] = True\n            return True\n        if num % 2 == 0:\n            self._prime_cache[num] = False\n            return False\n\n        for i in range(3, int(math.sqrt(num)) + 1, 2):\n            if num % i == 0:\n                self._prime_cache[num] = False\n                return False\n\n        self._prime_cache[num] = True\n        return True\nclass PrimeFibonacciService:\n    def __init__(self, fib_generator: FibonacciGenerator, prime_checker: PrimeChecker) -> None:\n        \"\"\"Initializes the service with instances of `FibonacciGenerator` and `PrimeChecker`. These dependencies provide Fibonacci numbers and primality test results.\"\"\"\n        self._fib_generator = fib_generator\n        self._prime_checker = prime_checker\n\n    def find_nth_prime_fib(self, n: int) -> int:\n        \"\"\"Iteratively generates Fibonacci numbers and tests them for primality. Returns the n-th number found that satisfies both properties.\"\"\"\n        prime_fib_count = 0\n        current_fib_index = 0\n        while True:\n            fib_number = self._fib_generator.get_fib_at_index(current_fib_index)\n            \n            # 0 and 1 are not prime numbers; only positive numbers greater than 1 can be prime.\n            if fib_number > 1 and self._prime_checker.is_prime(fib_number):\n                prime_fib_count += 1\n                if prime_fib_count == n:\n                    return fib_number\n            current_fib_index += 1\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"n must be an integer\")\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n\n    fib_generator = FibonacciGenerator()\n    prime_checker = PrimeChecker()\n    service = PrimeFibonacciService(fib_generator, prime_checker)\n\n    return service.find_nth_prime_fib(n)"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list) -> bool:\n    \"\"\"\n    Checks if there are three distinct elements in the list that sum to zero.\n    Returns True if such a triplet exists, False otherwise.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    sorted_numbers = sorted(l)\n\n    for i in range(n - 2):\n        # Skip duplicate elements for the first number to optimize.\n        # This is important to ensure distinct elements are considered efficiently\n        # while also handling cases where the list contains duplicate values.\n        if i > 0 and sorted_numbers[i] == sorted_numbers[i-1]:\n            continue\n\n        left = i + 1\n        right = n - 1\n\n        while left < right:\n            current_sum = sorted_numbers[i] + sorted_numbers[left] + sorted_numbers[right]\n\n            if current_sum == 0:\n                return True\n            elif current_sum < 0:\n                left += 1\n            else: # current_sum > 0\n                right -= 1\n    return False"}
