{"task_id": "HumanEval/105", "solution": "def by_length(arr: list[int]) -> list[str]:\n    \"\"\"\n    Transforms an array of integers into English word representations, filtering, sorting, and reversing.\n    Ignores non-integers or numbers outside the range [1, 9].\n    \"\"\"\n    DIGIT_WORDS = {\n        1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n        6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\"\n    }\n\n    # FR1: Filters input array for integers between 1 and 9 (inclusive).\n    # NFR3: Robustly handles non-integer types and numbers outside the specified range.\n    valid_digits = []\n    for num in arr:\n        if isinstance(num, int) and 1 <= num <= 9:\n            valid_digits.append(num)\n\n    # FR5: Returns an empty array if no valid integers are found after filtering.\n    if not valid_digits:\n        return []\n\n    # FR2: Sorts the filtered integers in ascending order.\n    valid_digits.sort()\n\n    # FR3: Reverses the order of the sorted integers to be descending.\n    valid_digits.reverse()\n\n    # FR4: Replaces each integer with its corresponding English word representation.\n    result_words = [DIGIT_WORDS[digit] for digit in valid_digits]\n\n    return result_words"}
{"task_id": "HumanEval/104", "solution": "def unique_digits(x):\n    \"\"\"Given a list of positive integers x. return a sorted list of all \n    elements that hasn't any even digit.\n\n    Note: Returned list should be sorted in increasing order.\n    \"\"\"\n    if not isinstance(x, list):\n        raise ValueError(\"Input must be a list.\")\n\n    filtered_numbers = []\n\n    def _has_even_digit(number: int) -> bool:\n        # Checks if a positive integer contains any even digits.\n        # The digit 0 is considered even.\n        current_number = number\n        while current_number > 0:\n            digit = current_number % 10\n            if digit % 2 == 0:\n                return True\n            current_number //= 10\n        return False\n\n    for num in x:\n        if not isinstance(num, int) or num <= 0:\n            raise ValueError(\"All elements in the list must be positive integers.\")\n        \n        if not _has_even_digit(num):\n            filtered_numbers.append(num)\n    \n    filtered_numbers.sort()\n    return filtered_numbers"}
{"task_id": "HumanEval/106", "solution": "def f(n):\n    \"\"\"\n    Generates a list of size n where elements are factorials for even indices\n    and sums for odd indices, with index i starting from 1.\n    Raises ValueError for invalid input n.\n    \"\"\"\n\n    def _factorial(num: int) -> int:\n        \"\"\"\n        Calculates the factorial of a non-negative integer.\n        Raises ValueError if num is negative.\n        \"\"\"\n        if num < 0:\n            raise ValueError(\"Factorial is not defined for negative numbers.\")\n        if num == 0:\n            return 1\n        res = 1\n        for i in range(1, num + 1):\n            res *= i\n        return res\n\n    def _sum_up_to(num: int) -> int:\n        \"\"\"\n        Calculates the sum of all integers from 1 to a non-negative integer.\n        Raises ValueError if num is negative.\n        \"\"\"\n        if num < 0:\n            raise ValueError(\"Sum up to a negative number is not defined in this context.\")\n        # Uses Gauss's formula for O(1) calculation.\n        return num * (num + 1) // 2\n\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    result_list = []\n    for i in range(1, n + 1):\n        if i % 2 == 0:  # Even index\n            result_list.append(_factorial(i))\n        else:  # Odd index\n            result_list.append(_sum_up_to(i))\n    return result_list"}
