{"task_id": "HumanEval/1", "solution": "from typing import List\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"Separates balanced, non-nested parenthesis groups from a string, ignoring spaces and other characters.\n    Returns a list of these individual groups.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    # Remove all characters that are not parentheses.\n    cleaned_string = \"\".join(char for char in paren_string if char in '()')\n\n    result: List[str] = []\n    balance_counter: int = 0\n    current_group_start: int = 0\n\n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            balance_counter += 1\n        elif char == ')':\n            balance_counter -= 1\n\n        # If balance is 0, a complete and non-nested group has been found.\n        if balance_counter == 0:\n            group = cleaned_string[current_group_start : i + 1]\n            if group:  # Ensure the extracted group is not empty.\n                result.append(group)\n            current_group_start = i + 1  # Start searching for the next group after this one.\n\n    return result"}
{"task_id": "HumanEval/4", "solution": "from typing import List\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\"For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case).\n    \"\"\"\n\n    def _calculate_mean_helper(nums: List[float]) -> float:\n        \"\"\"Calculates the arithmetic mean of a list of numbers.\n        Raises ValueError if the input list is empty.\n        \"\"\"\n        if not nums:\n            raise ValueError(\"Input list cannot be empty.\")\n        return sum(nums) / len(nums)\n\n    mean_val = _calculate_mean_helper(numbers)\n    absolute_differences = [abs(x - mean_val) for x in numbers]\n\n    # Calculate the mean of these absolute differences.\n    return _calculate_mean_helper(absolute_differences)"}
{"task_id": "HumanEval/6", "solution": "from typing import List\nclass InvalidParenthesesError(Exception):\n    \"\"\"Custom exception for invalid parentheses string.\n    Signals issues like unmatched or unbalanced parentheses.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef _calculate_max_depth(group: str) -> int:\n    \"\"\"\n    Calculates the maximum nesting depth for a single parentheses group.\n    Raises InvalidParenthesesError for malformed groups.\n    \"\"\"\n    current_depth = 0\n    max_depth = 0\n    for char in group:\n        if char == '(':\n            current_depth += 1\n            max_depth = max(max_depth, current_depth)\n        elif char == ')':\n            current_depth -= 1\n            if current_depth < 0:\n                raise InvalidParenthesesError(\"Unmatched closing parenthesis.\")\n    if current_depth != 0:\n        raise InvalidParenthesesError(\"Unbalanced parentheses.\")\n    return max_depth\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    if not isinstance(paren_string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    if not paren_string.strip():\n        return []\n\n    groups = paren_string.split(' ')\n    results = []\n    for group in groups:\n        if not group: # Handle multiple spaces or leading/trailing spaces\n            results.append(0)\n            continue\n        results.append(_calculate_max_depth(group))\n    return results"}
