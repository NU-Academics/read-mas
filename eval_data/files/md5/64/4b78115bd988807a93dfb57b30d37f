{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n: int) -> list[int]:\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in Collatz sequence.\n    This function calculates the Collatz sequence, extracts unique odd numbers, and sorts them.\n    \"\"\"\n    # Ensure n is a positive integer as per FR5.\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    # Handle the base case where n is 1 as per FR4.\n    if n == 1:\n        return [1]\n\n    # Calculate the Collatz sequence as per FR1.\n    sequence = []\n    current_num = n\n    while current_num != 1:\n        sequence.append(current_num)\n        # Apply Collatz sequence rules.\n        if current_num % 2 != 0: # Check if odd, similar to CollatzUtils.is_odd.\n            current_num = 3 * current_num + 1\n        else:\n            current_num = current_num // 2\n    sequence.append(1) # Add the final '1' to the sequence.\n\n    # Identify odd numbers (FR2), remove duplicates, and sort them (FR3).\n    odd_numbers = sorted(list(set(num for num in sequence if num % 2 != 0)))\n    \n    return odd_numbers"}
{"task_id": "HumanEval/124", "solution": "MONTH_DAYS_MAP = {\n    1: 31, 3: 31, 5: 31, 7: 31, 8: 31, 10: 31, 12: 31,\n    4: 30, 6: 30, 9: 30, 11: 30,\n    2: 29\n}\ndef _parse_date_components(date_string: str) -> tuple[int, int, int] | None:\n    \"\"\"Parses mm-dd-yyyy formatted string into month, day, year integers.\n    Returns None if parsing fails due to format or non-integer components.\"\"\"\n    parts = date_string.split('-')\n    if len(parts) != 3:\n        return None\n    try:\n        month = int(parts[0])\n        day = int(parts[1])\n        year = int(parts[2])\n    except ValueError:\n        return None\n    return month, day, year\ndef _is_month_valid(month: int) -> bool:\n    \"\"\"Checks if the month is between 1 and 12.\"\"\"\n    return 1 <= month <= 12\ndef _is_day_valid(day: int, month: int) -> bool:\n    \"\"\"Checks if the day is valid for the given month using MONTH_DAYS_MAP.\n    Assumes month is already validated and present in MONTH_DAYS_MAP.\"\"\"\n    max_days = MONTH_DAYS_MAP.get(month)\n    return 1 <= day <= max_days\ndef valid_date(date):\n    \"\"\"Validates a date string against format and range rules.\n    Returns True if the date is valid, False otherwise.\"\"\"\n    # FR1: The date string is not empty.\n    if not isinstance(date, str) or not date:\n        return False\n\n    # FR2: The date string adheres to \"mm-dd-yyyy\" format and parse components.\n    components = _parse_date_components(date)\n    if components is None:\n        return False\n    month, day, year = components # Year is parsed but not validated per requirements.\n\n    # FR3: The month component is between 1 and 12, inclusive.\n    if not _is_month_valid(month):\n        return False\n\n    # FR4: The day component is within the correct range for the given month.\n    if not _is_day_valid(day, month):\n        return False\n\n    return True"}
{"task_id": "HumanEval/125", "solution": "import re\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input to the word splitter.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    Examples\n    split_words(\"Hello world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"Hello,world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"abcdef\") == 3 \n    '''\n    if not isinstance(txt, str):\n        raise InvalidInputError(\"Input must be a string.\")\n\n    if re.search(r'\\s', txt):\n        return txt.split()\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        # If neither whitespace nor commas, count odd-ordered lowercase letters.\n        count = 0\n        for char in txt:\n            if 'a' <= char <= 'z':\n                order = ord(char) - ord('a')\n                if order % 2 != 0:\n                    count += 1\n        return count"}
{"task_id": "HumanEval/124", "solution": "import re\ndef valid_date(date):\n    \"\"\"Validates a given date string based on format and range rules.\n    Returns True if the date is valid, False otherwise.\n    \"\"\"\n    if not date:\n        return False\n\n    # Define constants directly within the function as per bare function requirement.\n    DAYS_IN_MONTH_MAP = {\n        1: 31, 3: 31, 5: 31, 7: 31, 8: 31, 10: 31, 12: 31,\n        4: 30, 6: 30, 9: 30, 11: 30,\n        2: 29  # February maximum days, no leap year logic applied per specification.\n    }\n    DATE_FORMAT_REGEX = r\"^(?P<month>\\d{2})-(?P<day>\\d{2})-(?P<year>\\d{4})$\"\n\n    match = re.match(DATE_FORMAT_REGEX, date)\n    if not match:\n        return False\n\n    try:\n        month = int(match.group('month'))\n        day = int(match.group('day'))\n        # The year is parsed for format validation but not used in range checks.\n        # year = int(match.group('year'))\n    except ValueError:\n        return False\n\n    if not (1 <= month <= 12):\n        return False\n\n    max_days = DAYS_IN_MONTH_MAP.get(month)\n    if max_days is None:\n        return False # Should not be reached if month is valid.\n    \n    if not (1 <= day <= max_days):\n        return False\n\n    return True"}
