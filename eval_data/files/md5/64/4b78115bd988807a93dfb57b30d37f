{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str) -> bool:\n    \"\"\"\n    Checks if a string of '<' and '>' characters has correctly matched brackets.\n    Returns True if every opening bracket has a corresponding closing bracket, False otherwise.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '<':\n            balance += 1\n        elif char == '>':\n            balance -= 1\n        else:\n            # Non-bracket characters make the sequence invalid.\n            return False\n        if balance < 0:\n            # Closing bracket without a matching open bracket.\n            return False\n    return balance == 0"}
{"task_id": "HumanEval/56", "solution": "class InvalidBracketStringError(Exception):\n    \"\"\"Custom exception for invalid characters in the bracket string.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nVALID_BRACKET_CHARS = {'<', '>'}\ndef correct_bracketing(brackets: str):\n    \"\"\"Checks if every opening bracket has a corresponding closing bracket and is correctly nested.\n    Raises InvalidBracketStringError if the input contains invalid characters.\n    \"\"\"\n    if not isinstance(brackets, str):\n        raise TypeError(\"Input 'brackets' must be a string.\")\n\n    for char in brackets:\n        if char not in VALID_BRACKET_CHARS:\n            raise InvalidBracketStringError(\n                f\"Invalid character '{char}' found in bracket string. Only '<' and '>' are allowed.\"\n            )\n\n    balance = 0\n    for char in brackets:\n        if char == '<':\n            balance += 1\n        elif char == '>':\n            balance -= 1\n        if balance < 0:\n            return False\n\n    return balance == 0"}
{"task_id": "HumanEval/58", "solution": "from typing import List, Any\ndef common(l1: List[Any], l2: List[Any]) -> List[Any]:\n    \"\"\"Return sorted unique common elements for two lists.\n    This uses sets for efficient identification and sorting for consistent output.\n    \"\"\"\n    set1 = set(l1)\n    set2 = set(l2)\n    common_elements = list(set1.intersection(set2))\n    common_elements.sort()\n    return common_elements"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list) -> bool:\n    \"\"\"Return True if list elements are monotonically increasing or decreasing.\n    Raises TypeError if input is not a list or contains incomparable elements.\n    \"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"Input must be a list.\")\n\n    if len(l) <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(len(l) - 1):\n        if l[i] > l[i+1]:\n            is_increasing = False\n        if l[i] < l[i+1]:\n            is_decreasing = False\n\n    return is_increasing or is_decreasing"}
{"task_id": "HumanEval/57", "solution": "from typing import List, Union\ndef monotonic(l: list) -> bool:\n    \"\"\"Return True if list elements are monotonically increasing or decreasing.\n    An empty or single-element list is considered monotonic.\n    \"\"\"\n    if len(l) <= 1:\n        return True\n\n    # Check if the list is non-strictly increasing.\n    is_increasing = True\n    for i in range(len(l) - 1):\n        if l[i] > l[i+1]:\n            is_increasing = False\n            break\n\n    # Check if the list is non-strictly decreasing.\n    is_decreasing = True\n    for i in range(len(l) - 1):\n        if l[i] < l[i+1]:\n            is_decreasing = False\n            break\n\n    return is_increasing or is_decreasing"}
{"task_id": "HumanEval/55", "solution": "def fib(n: int):\n    \"\"\"Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    if n == 1:\n        return 1\n    if n == 2:\n        return 1\n\n    a, b = 1, 1\n    for _ in range(3, n + 1):\n        a, b = b, a + b\n    return b"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int) -> int:\n    \"\"\"\n    Return the largest prime factor of n.\n    Assumes n > 1 and is not a prime.\n    \"\"\"\n    i = 2\n    largest_factor = 1\n    temp_n = n\n\n    while i * i <= temp_n:\n        if temp_n % i == 0:\n            largest_factor = i\n            while temp_n % i == 0:\n                temp_n //= i\n        i += 1\n\n    if temp_n > 1:  # Remaining temp_n is a prime factor itself.\n        largest_factor = temp_n\n\n    return largest_factor"}
