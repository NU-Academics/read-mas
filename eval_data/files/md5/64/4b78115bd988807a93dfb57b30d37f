{"task_id": "HumanEval/0", "solution": "from typing import List\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\"\n    Checks if any two numbers in the list are closer than the given threshold.\n    Returns True if found, False otherwise.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input 'numbers' must be a list.\")\n    if not all(isinstance(n, (int, float)) for n in numbers):\n        raise TypeError(\"All elements in 'numbers' must be numeric.\")\n    if not isinstance(threshold, (int, float)):\n        raise TypeError(\"Input 'threshold' must be a numeric value.\")\n\n    # Treat negative thresholds as 0.0 for comparison based on BR1.\n    effective_threshold = max(0.0, float(threshold))\n\n    n = len(numbers)\n    if n < 2:\n        return False\n\n    # Sort the list to enable an O(N log N) optimization in many cases.\n    sorted_numbers = sorted(numbers)\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            if sorted_numbers[j] - sorted_numbers[i] < effective_threshold:\n                return True\n            # Optimization: for a sorted list, if the difference is already too large,\n            # further elements will also be too far. This applies if threshold > 0.\n            elif effective_threshold > 0 and sorted_numbers[j] - sorted_numbers[i] >= effective_threshold:\n                break\n    return False"}
{"task_id": "HumanEval/1", "solution": "from typing import List\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"\n    Separates distinct, balanced, and non-nested groups of parentheses from an input string.\n    Only parentheses are considered for group formation; all other characters (including spaces) are ignored.\n    \"\"\"\n    cleaned_string = \"\".join(c for c in paren_string if c == '(' or c == ')')\n    groups: List[str] = []\n    balance = 0\n    start_index = 0\n\n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n\n        # A balanced group is found when balance returns to 0.\n        # The parsing continues after the current group for non-nesting.\n        if balance == 0:\n            group = cleaned_string[start_index : i + 1]\n            groups.append(group)\n            start_index = i + 1\n\n    return groups"}
{"task_id": "HumanEval/0", "solution": "from typing import List\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    pass\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    # Validate input types and threshold value.\n    # Raises InvalidInputError for malformed inputs or a negative threshold.\n    if not isinstance(numbers, list) or not all(isinstance(n, (int, float)) for n in numbers):\n        raise InvalidInputError(\"Input 'numbers' must be a list of numbers.\")\n    if not isinstance(threshold, (int, float)):\n        raise InvalidInputError(\"Input 'threshold' must be a number.\")\n    if threshold < 0:\n        raise InvalidInputError(\"Input 'threshold' cannot be negative.\")\n\n    n = len(numbers)\n    # Return False if there are fewer than two elements to compare.\n    if n < 2:\n        return False\n\n    # This implementation uses a brute-force O(N^2) comparison.\n    # For very large lists, a more efficient O(N log N) approach (sorting + linear scan) could be considered.\n    for i in range(n):\n        for j in range(i + 1, n):\n            if abs(numbers[i] - numbers[j]) < threshold:\n                return True # Return True immediately if a close pair is found.\n    \n    return False # Return False if no close pair is found after all comparisons."}
{"task_id": "HumanEval/5", "solution": "from typing import List\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'.\n    Returns a new list with the delimiter placed between original elements.\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
