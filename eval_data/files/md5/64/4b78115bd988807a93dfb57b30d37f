{"task_id": "HumanEval/39", "solution": "from src.fibonacci_generator import FibonacciGenerator\nfrom src.prime_checker import PrimeChecker\nfrom src.prime_fib_service import PrimeFibService\nfrom src.fibonacci_generator import FibonacciGenerator\nfrom src.prime_checker import PrimeChecker\nclass FibonacciGenerator:\n    \"\"\"Generates an infinite sequence of Fibonacci numbers.\"\"\"\n\n    def generate(self):\n        a, b = 0, 1\n        while True:\n            yield a\n            a, b = b, a + b\nclass PrimeChecker:\n    \"\"\"Checks if a given number is prime.\"\"\"\n\n    def is_prime(self, num: int) -> bool:\n        if num < 2:\n            return False\n        i = 2\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 1\n        return True\nclass PrimeFibService:\n    \"\"\"Service to find the n-th number that is both Fibonacci and prime.\"\"\"\n\n    def __init__(self, fib_generator: FibonacciGenerator, prime_checker: PrimeChecker):\n        self.fib_generator = fib_generator\n        self.prime_checker = prime_checker\n\n    def find_nth_prime_fib(self, n: int) -> int:\n        if n < 1:\n            raise ValueError(\"n must be a positive integer.\")\n\n        prime_fib_count = 0\n        for fib_num in self.fib_generator.generate():\n            # Skip 0 and 1 as they are not prime.\n            if fib_num <= 1:\n                continue\n            if self.prime_checker.is_prime(fib_num):\n                prime_fib_count += 1\n                if prime_fib_count == n:\n                    return fib_num\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    fib_generator = FibonacciGenerator()\n    prime_checker = PrimeChecker()\n    service = PrimeFibService(fib_generator, prime_checker)\n    return service.find_nth_prime_fib(n)"}
