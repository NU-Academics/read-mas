{"task_id": "HumanEval/67", "solution": "import re\nclass FruitCounts:\n    def __init__(self, apples: int, oranges: int):\n        if not isinstance(apples, int) or apples < 0:\n            raise ValueError(\"Apples count must be a non-negative integer.\")\n        if not isinstance(oranges, int) or oranges < 0:\n            raise ValueError(\"Oranges count must be a non-negative integer.\")\n        self.apples = apples\n        self.oranges = oranges\nclass FruitParser:\n    def parse(self, s: str) -> FruitCounts:\n        # Extracts apple and orange counts from a string like \"X apples and Y oranges\".\n        # Raises ValueError if the format is invalid or counts are not integers.\n        match = re.match(r\"(\\d+)\\s*apples\\s*and\\s*(\\d+)\\s*oranges\", s)\n        if not match:\n            raise ValueError(\"Input string format is invalid. Expected 'X apples and Y oranges'.\")\n        \n        try:\n            apples = int(match.group(1))\n            oranges = int(match.group(2))\n        except ValueError:\n            raise ValueError(\"Could not parse fruit counts as integers.\")\n        \n        return FruitCounts(apples, oranges)\nclass FruitCalculator:\n    def calculate_mangoes(self, fruit_counts: FruitCounts, total_fruits: int) -> int:\n        # Calculates mangoes by subtracting apples and oranges from the total fruits.\n        # Raises ValueError if total_fruits is invalid or less than combined apples/oranges.\n        if not isinstance(total_fruits, int) or total_fruits < 0:\n            raise ValueError(\"Total fruits must be a non-negative integer.\")\n\n        total_apples_oranges = fruit_counts.apples + fruit_counts.oranges\n        if total_fruits < total_apples_oranges:\n            raise ValueError(\"Total fruits cannot be less than the sum of apples and oranges.\")\n        \n        return total_fruits - total_apples_oranges\ndef fruit_distribution(s, n):\n    \"\"\"\n    Calculates the number of mango fruits in a basket based on provided apple/orange counts and total fruits.\n    Raises ValueError for invalid input string format, non-integer counts, or an impossible fruit distribution.\n    \"\"\"\n    parser = FruitParser()\n    fruit_counts = parser.parse(s)\n\n    calculator = FruitCalculator()\n    mangoes = calculator.calculate_mangoes(fruit_counts, n)\n    \n    return mangoes"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Counts vowels in a string, including conditional 'y' at the end of the word.\n    The function is case-insensitive and handles empty strings gracefully.\n\n    >>> vowels_count(\"abcde\")\n    2\n    >>> vowels_count(\"ACEDY\")\n    3\n    >>> vowels_count(\"happy\")\n    2\n    >>> vowels_count(\"sky\")\n    1\n    >>> vowels_count(\"AEIOUaeiou\")\n    10\n    >>> vowels_count(\"rhythm\")\n    0\n    >>> vowels_count(\"\")\n    0\n    >>> vowels_count(\"y\")\n    1\n    \"\"\"\n    count = 0\n    lower_s = s.lower()\n    standard_vowels = \"aeiou\"\n\n    for char in lower_s:\n        if char in standard_vowels:\n            count += 1\n\n    if len(lower_s) > 0 and lower_s[-1] == 'y':\n        count += 1\n\n    return count"}
{"task_id": "HumanEval/67", "solution": "from dataclasses import dataclass\nclass FruitParser:\n    @staticmethod\n    def parse_fruit_string(s: str) -> FruitCounts:\n        \"\"\"Parses the input string to extract apple and orange counts.\"\"\"\n        try:\n            parts = s.split(\" apples and \")\n            if len(parts) != 2:\n                raise ValueError(\"Invalid string format: missing ' apples and '\")\n\n            apples_str = parts[0].strip()\n            oranges_part = parts[1].strip()\n\n            oranges_parts = oranges_part.split(\" oranges\")\n            if len(oranges_parts) != 2 or oranges_parts[1].strip() != \"\":\n                raise ValueError(\"Invalid string format: missing ' oranges' or extra text\")\n\n            oranges_str = oranges_parts[0].strip()\n\n            apples = int(apples_str)\n            oranges = int(oranges_str)\n\n            if apples < 0 or oranges < 0:\n                raise ValueError(\"Fruit counts cannot be negative.\")\n\n            return FruitCounts(apples=apples, oranges=oranges)\n        except ValueError as e:\n            raise ValueError(f\"Failed to parse fruit string '{s}': {e}\")\nclass FruitCalculator:\n    @staticmethod\n    def _calculate_mangoes(total: int, apples: int, oranges: int) -> int:\n        \"\"\"Calculates mangoes, ensuring counts are valid and total is sufficient.\"\"\"\n        if not isinstance(total, int) or not isinstance(apples, int) or not isinstance(oranges, int):\n            raise TypeError(\"All fruit counts must be integers.\")\n        if total < 0 or apples < 0 or oranges < 0:\n            raise ValueError(\"Fruit counts and total cannot be negative.\")\n\n        sum_other_fruits = apples + oranges\n        if total < sum_other_fruits:\n            raise ValueError(f\"Total fruits ({total}) cannot be less than sum of apples and oranges ({sum_other_fruits}).\")\n\n        return total - sum_other_fruits\n\n    @staticmethod\n    def fruit_distribution(s: str, n: int) -> int:\n        \"\"\"Orchestrates parsing and calculation to determine the number of mangoes.\"\"\"\n        if not isinstance(s, str):\n            raise TypeError(\"Input 's' must be a string.\")\n        if not isinstance(n, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n\n        fruit_counts = FruitParser.parse_fruit_string(s)\n        return FruitCalculator._calculate_mangoes(n, fruit_counts.apples, fruit_counts.oranges)\ndef fruit_distribution(s: str, n: int) -> int:\n    \"\"\"\n    Calculates the number of mango fruits given apple/orange counts and a total.\n    Raises ValueError for invalid inputs or if total fruits are insufficient.\n    \"\"\"\n    return FruitCalculator.fruit_distribution(s, n)"}
{"task_id": "HumanEval/68", "solution": "from typing import List\ndef pluck(arr: List[int]) -> List[int]:\n    \"\"\"\n    Finds the smallest even non-negative integer in arr and its index.\n    If multiple smallest even numbers exist, returns the one with the smallest index, or an empty list if none are found.\n    \"\"\"\n    if not arr:\n        return []\n\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for i, value in enumerate(arr):\n        if value % 2 == 0:\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = i\n            # If values are equal, the first one encountered (smallest index) is kept due to iteration order.\n\n    if smallest_even_index == -1:\n        return []\n    else:\n        return [smallest_even_value, smallest_even_index]"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even-valued node and its index in an array of non-negative integers.\n    Returns [value, index] or an empty list if no even numbers are found or the array is empty.\n    \"\"\"\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for i, value in enumerate(arr):\n        if value % 2 == 0:  # Check if the value is even\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = i\n            elif value == smallest_even_value and i < smallest_even_index:\n                # If values are equal, choose the one with the smaller index\n                smallest_even_index = i\n\n    if smallest_even_index != -1:\n        return [smallest_even_value, smallest_even_index]\n    else:\n        return []"}
{"task_id": "HumanEval/69", "solution": "from collections import Counter\ndef search(lst: list[int]) -> int:\n    \"\"\"\n    Finds the greatest integer in a list whose frequency is greater than or equal to its value.\n    Returns -1 if no such integer exists, handling non-empty lists of positive integers.\n    \"\"\"\n    # As per problem statement, list is non-empty, but defensive check matches example snippet.\n    if not lst:\n        return -1\n\n    frequency_map = Counter(lst)\n    \n    qualifying_numbers = []\n    for num, freq in frequency_map.items():\n        if num > 0 and freq >= num:\n            qualifying_numbers.append(num)\n    \n    if not qualifying_numbers:\n        return -1\n    \n    return max(qualifying_numbers)"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    '''\n    if not lst:\n        return []\n\n    # Sort the list initially to simplify finding min and max elements efficiently.\n    sorted_lst = sorted(lst)\n    result = []\n    is_min_turn = True\n\n    while sorted_lst:\n        if is_min_turn:\n            # Append the current smallest element from the sorted list.\n            result.append(sorted_lst.pop(0))\n        else:\n            # Append the current largest element from the sorted list.\n            result.append(sorted_lst.pop())\n        is_min_turn = not is_min_turn\n    return result"}
{"task_id": "HumanEval/69", "solution": "from collections import Counter\ndef search(lst: list[int]) -> int:\n    \"\"\"\n    Finds the greatest positive integer in a list whose frequency is greater than or equal to its value.\n    Returns -1 if no such integer exists, assuming `lst` is non-empty and contains only positive integers.\n    \"\"\"\n    frequency_map = Counter(lst)\n    \n    candidates = []\n    for num, freq in frequency_map.items():\n        # As per problem statement, input numbers are positive, so num > 0 is implicit.\n        if freq >= num:\n            candidates.append(num)\n    \n    if not candidates:\n        return -1\n    \n    return max(candidates)"}
{"task_id": "HumanEval/70", "solution": "from collections import deque\ndef strange_sort_list(lst: list[int]) -> list[int]:\n    \"\"\"\n    Sorts a list of integers in \"strange\" order: min, then max of remaining, then min, and so on.\n    Returns a new list with elements sorted according to this alternating pattern.\n    \"\"\"\n    if not lst:\n        return []\n\n    result = []\n    # Create a sorted deque for efficient O(1) popping from both ends.\n    # This ensures reasonably efficient performance for large lists as per NFR1.\n    temp_list = deque(sorted(lst)) \n    \n    is_min_turn = True\n    while temp_list:\n        if is_min_turn:\n            # Minimum is always at the beginning of the sorted deque.\n            element = temp_list.popleft() \n        else:\n            # Maximum is always at the end of the sorted deque.\n            element = temp_list.pop()\n        \n        result.append(element)\n        is_min_turn = not is_min_turn\n            \n    return result"}
{"task_id": "HumanEval/55", "solution": "def fib(n: int):\n    \"\"\"Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    if n == 1 or n == 2:\n        return 1\n\n    a, b = 1, 1\n    for _ in range(3, n + 1):\n        a, b = b, a + b\n    return b"}
{"task_id": "HumanEval/71", "solution": "import math\nclass TriangleCalculator:\n    \"\"\"\n    Provides methods for validating triangle side lengths and calculating area.\n    \"\"\"\n    def is_valid_triangle(self, a: float, b: float, c: float) -> bool:\n        \"\"\"\n        Checks if three given side lengths can form a valid triangle.\n        Sides must be positive and satisfy the triangle inequality theorem.\n        \"\"\"\n        if not (a > 0 and b > 0 and c > 0):\n            return False\n        return (a + b > c) and (a + c > b) and (b + c > a)\n\n    def calculate_herons_area(self, a: float, b: float, c: float) -> float:\n        \"\"\"\n        Calculates the area of a triangle using Heron's formula.\n        It assumes valid triangle sides and handles potential float inaccuracies.\n        \"\"\"\n        s = (a + b + c) / 2\n        area_squared = s * (s - a) * (s - b) * (s - c)\n        # Handle potential floating point inaccuracies that might make area_squared slightly negative.\n        if area_squared < 0:\n            return 0.0\n        return math.sqrt(area_squared)\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater \n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    '''\n    calculator = TriangleCalculator()\n    if not calculator.is_valid_triangle(a, b, c):\n        return -1.0\n\n    area = calculator.calculate_herons_area(a, b, c)\n    return round(area, 2)"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q, w):\n    \"\"\"\n    Checks if an object q will fly based on balance (palindromic list) and weight.\n    Returns True if q is a palindrome and sum(q) <= w, False otherwise.\n    \"\"\"\n    is_balanced = (q == q[::-1])\n    total_weight = sum(q)\n    is_within_weight = total_weight <= w\n    return is_balanced and is_within_weight"}
{"task_id": "HumanEval/71", "solution": "import math\nINVALID_TRIANGLE_RETURN_VALUE = -1\nDECIMAL_PLACES_ROUNDING = 2\nclass TriangleCalculator:\n    \"\"\"\n    A utility class to encapsulate logic for validating and calculating triangle properties.\n    It is designed to be stateless with static methods.\n    \"\"\"\n    @staticmethod\n    def is_valid(a: float, b: float, c: float) -> bool:\n        \"\"\"\n        Checks if three given side lengths can form a valid triangle.\n        Sides must be positive and satisfy the triangle inequality theorem.\n        \"\"\"\n        if not (a > 0 and b > 0 and c > 0):\n            return False\n        return (a + b > c) and (a + c > b) and (b + c > a)\n\n    @staticmethod\n    def calculate_area(a: float, b: float, c: float) -> float:\n        \"\"\"\n        Calculates the area of a triangle using Heron's formula.\n        This method assumes the input side lengths already form a valid triangle.\n        \"\"\"\n        s = (a + b + c) / 2\n        # Ensure the term under the square root is non-negative due to potential float inaccuracies near degeneracy.\n        area_squared = s * (s - a) * (s - b) * (s - c)\n        if area_squared < 0: # Safeguard against floating point errors yielding tiny negative values.\n            return 0.0\n        return math.sqrt(area_squared)\ndef triangle_area(a: float, b: float, c: float) -> float:\n    \"\"\"\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle.\n    Otherwise return -1.\n    \"\"\"\n    if not TriangleCalculator.is_valid(a, b, c):\n        return float(INVALID_TRIANGLE_RETURN_VALUE)\n\n    area = TriangleCalculator.calculate_area(a, b, c)\n    return round(area, DECIMAL_PLACES_ROUNDING)"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    \"\"\"\n    Checks if an object q will fly based on its balance and weight.\n    It flies if it's a palindromic list and its sum is less than or equal to w.\n    \"\"\"\n    is_balanced = q == q[::-1]\n    total_weight = sum(q)\n    return is_balanced and (total_weight <= w)"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise ValueError(\"Input must be a list of integers.\")\n    for item in arr:\n        if not isinstance(item, int):\n            raise ValueError(\"Input must be a list of integers.\")\n\n    n = len(arr)\n    changes = 0\n    left = 0\n    right = n - 1\n\n    while left < right:\n        if arr[left] != arr[right]:\n            changes += 1\n        left += 1\n        right -= 1\n    return changes"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Calculates the minimum changes to make an array palindromic, where a change can modify any element.\n    A palindromic array reads the same forwards and backwards.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input must be a list.\")\n    if not all(isinstance(x, int) for x in arr):\n        raise ValueError(\"All elements in the list must be integers.\")\n\n    left_ptr = 0\n    right_ptr = len(arr) - 1\n    changes = 0\n\n    while left_ptr < right_ptr:\n        if arr[left_ptr] != arr[right_ptr]:\n            changes += 1\n        left_ptr += 1\n        right_ptr -= 1\n    return changes"}
