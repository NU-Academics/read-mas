{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    Takes a list of integers, applies conditional transformations (square if index is a multiple of 3, cube if index is a multiple of 4 and not 3),\n    and returns the sum of the transformed elements.\n    \"\"\"\n    if not lst:\n        return 0\n\n    processed_list = []\n    for i, x in enumerate(lst):\n        if i % 3 == 0:\n            processed_list.append(x ** 2)\n        elif i % 4 == 0:\n            processed_list.append(x ** 3)\n        else:\n            processed_list.append(x)\n    \n    return sum(processed_list)"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"Calculates a sum from a list of integers with index-based modifications.\n    Elements are squared if their index is a multiple of 3, or cubed if their index is a multiple of 4 and not 3.\"\"\"\n    modified_list = []\n    for i, num in enumerate(lst):\n        if i % 3 == 0:\n            modified_list.append(num * num)\n        elif i % 4 == 0:  # This implies i % 3 != 0 due to the 'if' condition\n            modified_list.append(num * num * num)\n        else:\n            modified_list.append(num)\n    return sum(modified_list)"}
{"task_id": "HumanEval/141", "solution": "import string\ndef file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions \n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n    - The file's name contains exactly one dot '.'\n    - The substring before the dot should not be empty, and it starts with a letter from \n    the latin alphapet ('a'-'z' and 'A'-'Z').\n    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    \"\"\"\n    ALLOWED_EXTENSIONS = ['txt', 'exe', 'dll']\n\n    # Ensure the input is a string, otherwise it's invalid.\n    if not isinstance(file_name, str):\n        return 'No'\n\n    # Rule: There should not be more than three digits.\n    digit_count = sum(1 for char in file_name if char.isdigit())\n    if digit_count > 3:\n        return 'No'\n\n    # Rule: The file's name contains exactly one dot '.'.\n    if file_name.count('.') != 1:\n        return 'No'\n\n    # Split the file name into prefix and suffix using the single dot.\n    parts = file_name.split('.')\n    prefix = parts[0]\n    suffix = parts[1]\n\n    # Rule: The substring before the dot should not be empty.\n    if not prefix:\n        return 'No'\n\n    # Rule: The substring before the dot must start with a Latin alphabet letter.\n    if prefix[0] not in string.ascii_letters:\n        return 'No'\n\n    # Rule: The substring after the dot should be one of the allowed extensions.\n    if suffix not in ALLOWED_EXTENSIONS:\n        return 'No'\n\n    # If all conditions are met, the file name is valid.\n    return 'Yes'"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    You are given a string representing a sentence,\n    the sentence contains some words separated by a space,\n    and you have to return a string that contains the words from the original sentence,\n    whose lengths are prime numbers,\n    the order of the words in the new string should be the same as the original one.\n\n    Example 1:\n        Input: sentence = \"This is a test\"\n        Output: \"is\"\n\n    Example 2:q\n        Input: sentence = \"lets go for swimming\"\n        Output: \"go for\"\n\n    Constraints:\n        * 1 <= len(sentence) <= 100\n        * sentence contains only letters\n    \"\"\"\n    words = sentence.split(' ')\n    filtered_words = []\n\n    for word in words:\n        word_length = len(word)\n\n        # Determine if word_length is a prime number.\n        is_prime_number = True\n        if word_length < 2:\n            is_prime_number = False\n        else:\n            i = 2\n            while i * i <= word_length:\n                if word_length % i == 0:\n                    is_prime_number = False\n                    break\n                i += 1\n\n        if is_prime_number:\n            filtered_words.append(word)\n\n    return ' '.join(filtered_words)"}
