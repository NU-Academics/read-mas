{"task_id": "HumanEval/44", "solution": "class InvalidBaseError(ValueError):\n    \"\"\"Exception raised for errors in the input base.\"\"\"\n    pass\nclass InvalidInputError(ValueError):\n    \"\"\"Exception raised for errors in the input number x.\"\"\"\n    pass\ndef change_base(x: int, base: int) -> str:\n    \"\"\"Change numerical base of input number x to base.\n    Returns string representation after the conversion.\n    \"\"\"\n    # Validate input number x and base according to specifications.\n    if not isinstance(x, int) or x < 0:\n        raise InvalidInputError(\"Input number 'x' must be a non-negative integer.\")\n    if not isinstance(base, int) or not (2 <= base <= 9):\n        raise InvalidBaseError(\"Base must be an integer between 2 and 9 (inclusive).\")\n\n    # Perform the base conversion algorithm.\n    if x == 0:\n        return \"0\"\n\n    result_digits = []\n    current_x = x\n    while current_x > 0:\n        remainder = current_x % base\n        result_digits.append(str(remainder))\n        current_x //= base\n    \n    return \"\".join(result_digits[::-1])"}
{"task_id": "HumanEval/44", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\n    Used to signal issues with x or base values.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef change_base(x: int, base: int) -> str:\n    \"\"\"Converts a non-negative integer from base 10 to a specified target base (2-9).\n    Returns its string representation in the new base.\n    \"\"\"\n    # Validate input 'x'\n    if not isinstance(x, int) or x < 0:\n        raise InvalidInputError(\"Input number x must be a non-negative integer.\")\n\n    # Validate input 'base'\n    if not isinstance(base, int) or not (2 <= base <= 9):\n        raise InvalidInputError(\"Target base must be an integer between 2 and 9, inclusive.\")\n\n    # Handle the special case where x is 0\n    if x == 0:\n        return \"0\"\n\n    # Perform the base conversion\n    result_digits = []\n    current_x = x\n    while current_x > 0:\n        remainder = current_x % base\n        result_digits.append(str(remainder))\n        current_x //= base\n\n    # Join the collected remainders in reverse order to form the final string\n    return \"\".join(result_digits[::-1])"}
