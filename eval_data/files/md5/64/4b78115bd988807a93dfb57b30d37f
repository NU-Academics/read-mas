{"task_id": "HumanEval/18", "solution": "def how_many_times(string: str, substring: str) -> int:\n    \"\"\"Find how many times a given substring can be found in the original string, including overlapping cases.\n    An empty substring matches at every possible insertion point (len(string) + 1).\n    \"\"\"\n    if not substring:\n        return len(string) + 1\n\n    count = 0\n    for i in range(len(string) - len(substring) + 1):\n        if string[i:i+len(substring)] == substring:\n            count += 1\n    return count"}
{"task_id": "HumanEval/17", "solution": "from typing import List\nclass InvalidNoteError(Exception):\n    def __init__(self, message: str):\n        super().__init__(message)\nclass MusicParser:\n    # Maps ASCII patterns to beat durations, sorted to prioritize longer matches.\n    NOTE_PATTERNS = {\n        'o|': 2,  # Half note\n        '.|': 1,  # Quarter note\n        'o': 4,   # Whole note\n    }\n    _sorted_patterns = sorted(NOTE_PATTERNS.items(), key=lambda item: len(item[0]), reverse=True)\n    _max_pattern_len = max(len(p) for p, _ in _sorted_patterns) if _sorted_patterns else 0\n\n\n    def parse(self, music_string: str) -> List[int]:\n        \"\"\"Parses a musical string into a list of beat durations.\n        Raises InvalidNoteError for unrecognized patterns.\n        \"\"\"\n        beat_durations: List[int] = []\n        i = 0\n        n = len(music_string)\n\n        while i < n:\n            if music_string[i].isspace():\n                i += 1\n                continue\n\n            matched = False\n            for pattern, beats in self._sorted_patterns:\n                if music_string.startswith(pattern, i):\n                    beat_durations.append(beats)\n                    i += len(pattern)\n                    matched = True\n                    break\n\n            if not matched:\n                # Extract the potentially invalid sequence for the error message.\n                invalid_sequence = music_string[i : min(i + self._max_pattern_len, n)]\n                raise InvalidNoteError(f\"Invalid note pattern: {invalid_sequence}\")\n\n        return beat_durations\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\"Input to this function is a string representing musical notes in a special ASCII format.\n    Your task is to parse this string and return list of integers corresponding to how many beats does each not last.\n    \"\"\"\n    parser = MusicParser()\n    return parser.parse(music_string)"}
