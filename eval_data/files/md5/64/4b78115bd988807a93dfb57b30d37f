{"task_id": "HumanEval/128", "solution": "def prod_signs(arr: list[int]) -> int | None:\n    \"\"\"\n    Calculates the sum of magnitudes of integers multiplied by the product of all signs.\n    Returns None for an empty array, and 0 if any number in the array is zero.\n    \"\"\"\n    if not arr:\n        return None\n\n    sum_magnitudes = sum(abs(n) for n in arr)\n\n    product_of_signs = 1\n    for n in arr:\n        if n > 0:\n            sign = 1\n        elif n < 0:\n            sign = -1\n        else:\n            sign = 0\n\n        if sign == 0:\n            product_of_signs = 0\n            break\n        product_of_signs *= sign\n\n    return sum_magnitudes * product_of_signs"}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr: list[int]) -> int | None:\n    \"\"\"\n    Calculates the sum of magnitudes multiplied by the product of signs for an array of integers.\n    Returns None for an empty array; the result is 0 if any number in the array is zero.\n    \"\"\"\n    if not arr:\n        return None\n\n    product_of_signs = 1\n    sum_of_magnitudes = 0\n\n    for num in arr:\n        # Determine the sign for the current number based on its value.\n        if num > 0:\n            sign_value = 1\n        elif num < 0:\n            sign_value = -1\n        else:\n            sign_value = 0\n        product_of_signs *= sign_value\n\n        # Accumulate the magnitude (absolute value) of the current number.\n        sum_of_magnitudes += abs(num)\n    \n    return sum_of_magnitudes * product_of_signs"}
{"task_id": "HumanEval/116", "solution": "def sort_array(arr: list[int]) -> list[int]:\n    \"\"\"\n    Sorts an array of integers primarily by the count of set bits in their\n    absolute binary representation, then by their decimal value.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input must be a list.\")\n    \n    for x in arr:\n        if not isinstance(x, int):\n            raise TypeError(\"All elements in the list must be integers.\")\n\n    def _count_set_bits(n: int) -> int:\n        \"\"\"Counts the number of '1's in the binary representation of an integer's absolute value.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input for bit counting must be an integer.\")\n        return bin(abs(n)).count('1')\n\n    # Sort using a custom key: first by set bit count, then by decimal value.\n    return sorted(arr, key=lambda x: (_count_set_bits(x), x))"}
{"task_id": "HumanEval/130", "solution": "from typing import List, Dict\ndef tri(n: int) -> List[int]:\n    \"\"\"\n    Calculates the Tribonacci sequence up to n using memoization.\n    It efficiently computes individual Tribonacci numbers through recursion.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    _memo: Dict[int, int] = {}\n\n    def _get_tribonacci_value(k: int) -> int:\n        \"\"\"Recursively calculates the k-th Tribonacci number with memoization.\"\"\"\n        if k in _memo:\n            return _memo[k]\n\n        if k == 0:\n            result = 1\n        elif k == 1:\n            result = 3\n        elif k % 2 == 0:  # k is even\n            result = 1 + k // 2\n        else:  # k is odd\n            result = (\n                _get_tribonacci_value(k - 1)\n                + _get_tribonacci_value(k - 2)\n                + _get_tribonacci_value(k + 1)\n            )\n        \n        _memo[k] = result\n        return result\n\n    sequence = []\n    for i in range(n + 1):\n        sequence.append(_get_tribonacci_value(i))\n    return sequence"}
{"task_id": "HumanEval/130", "solution": "class TribonacciCalculator:\n    TRI_0_BASE = 1.0\n    TRI_1_BASE = 3.0\n\n    def __init__(self):\n        self._memoization_cache = {\n            0: self.TRI_0_BASE,\n            1: self.TRI_1_BASE\n        }\n\n    def get_sequence(self, n: int) -> list[float]:\n        if n < 0:\n            raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n        sequence = []\n        for i in range(n + 1):\n            sequence.append(self._calculate_term(i))\n        return sequence\n\n    def _calculate_term(self, k: int) -> float:\n        # Return from cache if already computed.\n        if k in self._memoization_cache:\n            return self._memoization_cache[k]\n\n        if k % 2 == 0:  # Even rule for n > 1.\n            result = 1.0 + k / 2\n        else:  # Odd rule for n > 1.\n            # Recursively calculate k+1 first to ensure it's in cache for k.\n            term_k_plus_1 = self._calculate_term(k + 1)\n            term_k_minus_1 = self._calculate_term(k - 1)\n            term_k_minus_2 = self._calculate_term(k - 2)\n            result = term_k_minus_1 + term_k_minus_2 + term_k_plus_1\n        \n        self._memoization_cache[k] = result\n        return result\ndef tri(n: int) -> list[float]:\n    \"\"\"\n    Calculates the first n + 1 numbers of the Tribonacci sequence.\n    Raises ValueError if n is negative.\n    \"\"\"\n    calculator = TribonacciCalculator()\n    return calculator.get_sequence(n)"}
{"task_id": "HumanEval/131", "solution": "def digits(n: int) -> int:\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n    product = 1\n    found_odd_digit = False\n\n    while n > 0:\n        digit = n % 10\n        if digit % 2 != 0:\n            product *= digit\n            found_odd_digit = True\n        n //= 10\n\n    if not found_odd_digit:\n        return 0\n    return product"}
{"task_id": "HumanEval/129", "solution": "from typing import List, Tuple\nclass GridNavigator:\n    \"\"\"Provides utility functions for grid traversal.\"\"\"\n    @staticmethod\n    def get_neighbors(r: int, c: int, N: int) -> List[Tuple[int, int]]:\n        \"\"\"Returns valid adjacent cell coordinates within an N x N grid.\"\"\"\n        neighbors: List[Tuple[int, int]] = []\n        directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n        for dr, dc in directions:\n            new_r, new_c = r + dr, c + dc\n            if 0 <= new_r < N and 0 <= new_c < N:\n                neighbors.append((new_r, new_c))\n        return neighbors\nclass MinPathSolver:\n    \"\"\"Encapsulates dynamic programming logic to find the lexicographically smallest path.\"\"\"\n    def __init__(self, grid: List[List[int]], k: int):\n        if not (isinstance(grid, list) and all(isinstance(row, list) for row in grid)):\n            raise ValueError(\"Grid must be a list of lists.\")\n        self.N = len(grid)\n        if self.N < 2 or not all(len(row) == self.N for row in grid):\n            raise ValueError(\"Grid must be N x N with N >= 2.\")\n        if not isinstance(k, int) or k < 1:\n            raise ValueError(\"k must be a positive integer.\")\n\n        self.grid = grid\n        self.k = k\n        # dp[s][r][c] stores the lexicographically smallest path of length 's' ending at (r, c).\n        self.dp: List[List[List[List[int]]]] = [\n            [[None for _ in range(self.N)] for _ in range(self.N)]\n            for _ in range(self.k + 1)\n        ]\n\n    def solve(self) -> List[int]:\n        \"\"\"Executes the DP algorithm to compute and return the minimum path.\"\"\"\n        # Base case: paths of length 1 start at any cell.\n        for r in range(self.N):\n            for c in range(self.N):\n                self.dp[1][r][c] = [self.grid[r][c]]\n\n        # Fill DP table for paths of length s from 2 to k.\n        for s in range(2, self.k + 1):\n            for r in range(self.N):\n                for c in range(self.N):\n                    min_path_for_current_cell: List[int] = None\n                    # Consider all neighbors from which a path of length s-1 could have arrived.\n                    for prev_r, prev_c in GridNavigator.get_neighbors(r, c, self.N):\n                        prev_path = self.dp[s - 1][prev_r][prev_c]\n                        if prev_path is not None:\n                            candidate_path = prev_path + [self.grid[r][c]]\n                            if min_path_for_current_cell is None or candidate_path < min_path_for_current_cell:\n                                min_path_for_current_cell = candidate_path\n                    self.dp[s][r][c] = min_path_for_current_cell\n\n        # Find the overall minimum path among all paths of length k.\n        final_min_path: List[int] = None\n        for r in range(self.N):\n            for c in range(self.N):\n                path_at_rc = self.dp[self.k][r][c]\n                if path_at_rc is not None:\n                    if final_min_path is None or path_at_rc < final_min_path:\n                        final_min_path = path_at_rc\n        \n        if final_min_path is None:\n            raise RuntimeError(\"Could not find a path of length k.\")\n\n        return final_min_path\ndef minPath(grid: List[List[int]], k: int) -> List[int]:\n    \"\"\"\n    Given a grid and a positive integer k, finds the lexicographically\n    smallest path of length k in the grid.\n    \"\"\"\n    solver = MinPathSolver(grid, k)\n    return solver.solve()"}
{"task_id": "HumanEval/129", "solution": "class InvalidGridError(ValueError):\n    \"\"\"Custom exception for invalid grid inputs.\"\"\"\n    pass\nclass InvalidPathLengthError(ValueError):\n    \"\"\"Custom exception for invalid path length k.\"\"\"\n    pass\nclass Grid:\n    \"\"\"Manages grid data, providing cell values and neighbor coordinates.\"\"\"\n    def __init__(self, data: list[list[int]]):\n        if not isinstance(data, list) or not all(isinstance(row, list) for row in data):\n            raise InvalidGridError(\"Grid data must be a list of lists.\")\n        \n        N = len(data)\n        if N < 2:\n            raise InvalidGridError(\"Grid dimension N must be at least 2.\")\n        if not all(len(row) == N for row in data):\n            raise InvalidGridError(\"Grid must be square (N x N).\")\n        \n        self._data = data\n        self._N = N\n\n    def get_value(self, r: int, c: int) -> int:\n        \"\"\"Returns the value at the specified row and column.\"\"\"\n        return self._data[r][c]\n\n    def get_N(self) -> int:\n        \"\"\"Returns the dimension N of the grid.\"\"\"\n        return self._N\n\n    def get_neighbors(self, r: int, c: int) -> list[tuple[int, int]]:\n        \"\"\"Returns a list of potential neighbor coordinates (includes out-of-bounds).\"\"\"\n        moves = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n        return [(r + dr, c + dc) for dr, dc in moves]\nclass Path:\n    \"\"\"Represents a path as a sequence of cell values and supports comparison.\"\"\"\n    def __init__(self, initial_values: list[int] | None = None):\n        self._values = list(initial_values) if initial_values is not None else []\n\n    def add_value(self, value: int) -> None:\n        \"\"\"Appends a value to the path.\"\"\"\n        self._values.append(value)\n\n    def remove_last_value(self) -> None:\n        \"\"\"Removes the last value from the path for backtracking.\"\"\"\n        if not self._values:\n            raise IndexError(\"Cannot remove from an empty path.\")\n        self._values.pop()\n\n    def get_values(self) -> list[int]:\n        \"\"\"Returns a copy of the path's values.\"\"\"\n        return list(self._values)\n\n    def get_length(self) -> int:\n        \"\"\"Returns the current length of the path.\"\"\"\n        return len(self._values)\n\n    def __lt__(self, other: 'Path') -> bool:\n        \"\"\"Compares paths lexicographically.\"\"\"\n        return self._values < other._values\n\n    def __eq__(self, other: 'Path') -> bool:\n        \"\"\"Checks if two paths are equal.\"\"\"\n        return self._values == other._values\n    \n    def copy(self) -> 'Path':\n        \"\"\"Returns a new Path instance with a copy of current values.\"\"\"\n        return Path(list(self._values))\nclass PathValidator:\n    \"\"\"Provides utility methods for validating grid coordinates.\"\"\"\n    def is_valid_coordinate(self, N: int, r: int, c: int) -> bool:\n        \"\"\"Checks if the given row and column are within N x N grid bounds.\"\"\"\n        return 0 <= r < N and 0 <= c < N\nclass MinPathFinderService:\n    \"\"\"Orchestrates pathfinding, exploring paths and maintaining the minimum.\"\"\"\n    def __init__(self, grid_data: list[list[int]], k: int):\n        if not isinstance(k, int) or k < 1:\n            raise InvalidPathLengthError(\"Path length k must be a positive integer.\")\n        \n        self._grid = Grid(grid_data)\n        self._k = k\n        self._min_path: Path | None = None\n        self._path_validator = PathValidator()\n\n    def find_min_path(self) -> list[int]:\n        \"\"\"Initiates DFS from all starting cells to find the lexicographically smallest path.\"\"\"\n        N = self._grid.get_N()\n        \n        for r_start in range(N):\n            for c_start in range(N):\n                initial_path = Path([self._grid.get_value(r_start, c_start)])\n                self._dfs(r_start, c_start, initial_path)\n        \n        if self._min_path is None:\n            return [] # Should ideally not be reached given problem guarantees.\n        return self._min_path.get_values()\n\n    def _dfs(self, r: int, c: int, current_path: Path) -> None:\n        \"\"\"Recursive Depth-First Search to explore paths of length k.\"\"\"\n        if current_path.get_length() == self._k:\n            if self._min_path is None or current_path < self._min_path:\n                self._min_path = current_path.copy()\n            return\n\n        if current_path.get_length() > self._k:\n            return\n\n        N = self._grid.get_N()\n        neighbors = self._grid.get_neighbors(r, c)\n\n        for nr, nc in neighbors:\n            if self._path_validator.is_valid_coordinate(N, nr, nc):\n                current_path.add_value(self._grid.get_value(nr, nc))\n                self._dfs(nr, nc, current_path)\n                current_path.remove_last_value() # Backtrack\ndef minPath(grid: list[list[int]], k: int) -> list[int]:\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k, \n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n\n    Examples:\n\n        Input: grid = [ [1,2,3], [4,5,6], [7,8,9]], k = 3\n        Output: [1, 2, 1]\n\n        Input: grid = [ [5,9,3], [4,1,6], [7,8,2]], k = 1\n        Output: [1]\n    \"\"\"\n    if not isinstance(grid, list) or not all(isinstance(row, list) for row in grid):\n        raise TypeError(\"Grid must be a list of lists.\")\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an integer.\")\n\n    try:\n        finder = MinPathFinderService(grid, k)\n        return finder.find_min_path()\n    except (InvalidGridError, InvalidPathLengthError) as e:\n        raise ValueError(str(e)) # Re-raise custom exceptions as ValueError for API consistency."}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Calculates the product of all odd digits in a positive integer `n`.\n    Returns 0 if `n` contains no odd digits.\n    For example:\n    digits(1)  == 1\n    digits(4)  == 0\n    digits(235) == 15\n    \"\"\"\n    product = 1\n    has_odd_digit = False\n    \n    # Iterate through digits by converting the number to a string.\n    for digit_char in str(n):\n        digit = int(digit_char)\n        if digit % 2 != 0:  # Check if the digit is odd.\n            product *= digit\n            has_odd_digit = True\n    \n    return product if has_odd_digit else 0"}
{"task_id": "HumanEval/120", "solution": "import heapq\ndef maximum(arr: list[int], k: int) -> list[int]:\n    \"\"\"\n    Given an array arr of integers and an integer k, return a sorted list\n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    if k == 0:\n        return []\n\n    # Efficiently find the k largest elements and then sort them ascending.\n    largest_elements = heapq.nlargest(k, arr)\n    return sorted(largest_elements)"}
{"task_id": "HumanEval/133", "solution": "import math\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input. Stores a descriptive message.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef sum_squares(lst):\n    \"\"\"You are given a list of numbers.\n    You need to return the sum of squared numbers in the given list,\n    round each element in the list to the upper int(Ceiling) first.\n    Examples:\n    For lst = [1,2,3] the output should be 14\n    For lst = [1,4,9] the output should be 98\n    For lst = [1,3,5,7] the output should be 84\n    For lst = [1.4,4.2,0] the output should be 29\n    For lst = [-2.4,1,1] the output should be 6\n    \n\n    \"\"\"\n    if not isinstance(lst, list):\n        raise InvalidInputError(\"Input must be a list.\")\n\n    if not lst:\n        return 0\n\n    total_sum = 0\n    for num in lst:\n        if not isinstance(num, (int, float)):\n            raise InvalidInputError(f\"List contains non-numeric element: {num}\")\n        \n        ceiled_num = math.ceil(num)\n        total_sum += ceiled_num * ceiled_num\n            \n    return total_sum"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt: str) -> bool:\n    \"\"\"\n    Checks if the last character of a string is an isolated alphabetical character.\n    An \"isolated\" character is defined as one that is preceded by a space or is the only character in the string.\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    # The character is isolated if it's the only character or if the character before it is a space.\n    if len(txt) == 1 or txt[-2] == ' ':\n        return True\n    else:\n        return False"}
{"task_id": "HumanEval/133", "solution": "import math\ndef sum_squares(lst):\n    \"\"\"Calculates the sum of squares for numbers in a list, rounding each number up first.\n    Raises TypeError or ValueError for invalid input.\n    \"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"Input must be a list.\")\n\n    total_sum_of_squares = 0\n    for item in lst:\n        if not isinstance(item, (int, float)):\n            raise ValueError(f\"List elements must be numbers, got {type(item).__name__}.\")\n        \n        rounded_up_item = math.ceil(item)\n        total_sum_of_squares += rounded_up_item ** 2\n        \n    return total_sum_of_squares"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    '''\n    Checks if there is a valid subsequence of brackets with at least one nested bracket.\n    Nesting is determined by a maximum balance of open brackets reaching 2 or more.\n    '''\n    balance = 0\n    max_balance = 0\n\n    for char in string:\n        if char == '[':\n            balance += 1\n        elif char == ']':\n            balance -= 1\n        # Update the maximum balance seen so far.\n        # This correctly tracks the deepest nesting, even if balance drops below zero later.\n        max_balance = max(max_balance, balance)\n\n    return max_balance >= 2"}
