{"task_id": "HumanEval/76", "solution": "def is_simple_power(x: int, n: int) -> bool:\n    \"\"\"\n    Checks if a number x is a simple power of n.\n    x is a simple power of n if n**k = x for some non-negative integer k.\n    \"\"\"\n    if x < 0:\n        return False\n    if x == 1:\n        return True # n^0 = 1 for any n (including n=0, n=1, n>1).\n    if n == 1:\n        return x == 1 # If n is 1, only 1^k = 1 is a power.\n    if n == 0:\n        return x == 0 # If n is 0, only 0^k = 0 is a power (for k > 0).\n    if x == 0:\n        return False # 0 is not a power of any n > 1.\n\n    # At this point, x > 1 and n > 1.\n    while x % n == 0:\n        x //= n\n    return x == 1"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Checks if the input number is the product of exactly three prime numbers.\n    It returns True if it is, False otherwise.\"\"\"\n\n    if not isinstance(a, int):\n        raise TypeError(\"Input 'a' must be an integer.\")\n    \n    # As per functional requirements and business rules, 'a' must be less than 100.\n    # The smallest number that can be a product of three primes is 2*2*2 = 8.\n    if a < 2 or a >= 100:\n        raise ValueError(\"Input 'a' must be an integer between 2 and 99 (inclusive).\")\n\n    def get_primes_up_to(limit):\n        \"\"\"Generates a list of all prime numbers up to and including the limit using a sieve.\"\"\"\n        if limit < 2:\n            return []\n        sieve = [True] * (limit + 1)\n        sieve[0] = sieve[1] = False\n        for p in range(2, int(limit**0.5) + 1):\n            if sieve[p]:\n                for multiple in range(p * p, limit + 1, p):\n                    sieve[multiple] = False\n        return [i for i, is_p in enumerate(sieve) if is_p]\n\n    primes = get_primes_up_to(a)\n    num_primes = len(primes)\n\n    # Iterate through all combinations of three primes (allowing repetition)\n    for i in range(num_primes):\n        for j in range(i, num_primes):\n            for k in range(j, num_primes):\n                p1 = primes[i]\n                p2 = primes[j]\n                p3 = primes[k]\n                \n                product = p1 * p2 * p3\n                if product == a:\n                    return True\n                if product > a:\n                    # Optimization: if product exceeds 'a', further products with larger p3 will also exceed.\n                    break\n                    \n    return False"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Checks if a number x is a simple power of n (i.e., x = n^k for a non-negative integer k).\n    Assumes x and n are positive integers, n >= 1.\n    \"\"\"\n    if x == 1:\n        return True\n    if n == 1:\n        return False\n    if x < n:\n        return False\n\n    current_power = n\n    while current_power < x:\n        current_power *= n\n    return current_power == x"}
{"task_id": "HumanEval/77", "solution": "import math\ndef iscube(a: int) -> bool:\n    \"\"\"\n    Checks if an integer 'a' is a cube of some integer number.\n    Assumes the input 'a' is always a valid integer.\n    \"\"\"\n    if a == 0:\n        return True\n    \n    abs_a = abs(a)\n    \n    # Calculate the cube root using float.\n    cube_root_float = abs_a**(1/3)\n    \n    # Round to the nearest integer and check.\n    rounded_root = round(cube_root_float)\n    \n    # Verify if the cubed rounded root matches the absolute input.\n    is_perfect_cube = (rounded_root ** 3 == abs_a)\n    \n    if a < 0:\n        # For negative inputs, the cube root must also be negative.\n        return is_perfect_cube and ((-rounded_root) ** 3 == a)\n    else:\n        return is_perfect_cube"}
{"task_id": "HumanEval/75", "solution": "def get_prime_factors(n: int) -> list[int]:\n    \"\"\"Returns a sorted list of distinct prime factors for a given integer n.\n    Raises ValueError if n is not an integer or is less than or equal to 0.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input must be an integer.\")\n    if n <= 0:\n        raise ValueError(\"Input must be a positive integer.\")\n    if n == 1:\n        return []\n\n    factors = set()\n    d = 2\n    temp_n = n\n    while d * d <= temp_n:\n        if temp_n % d == 0:\n            factors.add(d)\n            while temp_n % d == 0:\n                temp_n //= d\n        d += 1\n    if temp_n > 1:\n        factors.add(temp_n)\n    return sorted(list(factors))\ndef is_multiply_prime(a):\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100. \n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n    if not isinstance(a, int) or not (0 < a < 100):\n        raise ValueError(\"Input 'a' must be an integer between 1 and 99 (exclusive).\")\n    \n    prime_factors = get_prime_factors(a)\n\n    if len(prime_factors) != 3:\n        return False\n    \n    product = 1\n    for factor in prime_factors:\n        product *= factor\n    \n    return product == a"}
{"task_id": "HumanEval/77", "solution": "def iscube(a: int) -> bool:\n    \"\"\"\n    Checks if an integer 'a' is a perfect cube.\n    It calculates the rounded cube root and then cubes it to verify.\n    \"\"\"\n    if a == 0:\n        return True\n\n    sign = 1 if a >= 0 else -1\n    abs_a = abs(a)\n    \n    # Calculate the cube root of the absolute value and round it.\n    cbrt_abs_a_rounded = round(abs_a**(1/3))\n    \n    # Reapply the original sign to get the candidate integer root.\n    candidate_root = sign * cbrt_abs_a_rounded\n    \n    # Check if cubing the candidate root equals the original number.\n    return (candidate_root * candidate_root * candidate_root) == a"}
