{"task_id": "HumanEval/19", "solution": "class InvalidNumberWordError(ValueError):\n    \"\"\"Custom exception for invalid number words.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass NumberWordMapper:\n    \"\"\"Provides a mapping between number words and their integer equivalents.\"\"\"\n    WORD_TO_INT_MAP = {\n        'zero': 0, 'one': 1, 'two': 2, 'three': 3, 'four': 4,\n        'five': 5, 'six': 6, 'seven': 7, 'eight': 8, 'nine': 9\n    }\n\n    INT_TO_WORD_MAP = {\n        0: 'zero', 1: 'one', 2: 'two', 3: 'three', 4: 'four',\n        5: 'five', 6: 'six', 7: 'seven', 8: 'eight', 9: 'nine'\n    }\n\n    def word_to_int(self, word: str) -> int:\n        \"\"\"Converts a number word to its integer representation.\"\"\"\n        if word not in self.WORD_TO_INT_MAP:\n            raise InvalidNumberWordError(f\"'{word}' is not a valid number word.\")\n        return self.WORD_TO_INT_MAP[word]\n\n    def int_to_word(self, num: int) -> str:\n        \"\"\"Converts an integer (0-9) to its number word representation.\"\"\"\n        if num not in self.INT_TO_WORD_MAP:\n            raise InvalidNumberWordError(f\"'{num}' is not a valid integer for conversion (0-9).\")\n        return self.INT_TO_WORD_MAP[num]\nclass NumberWordSorterService:\n    \"\"\"Encapsulates the core business logic for converting, sorting, and reconverting number words.\"\"\"\n    def __init__(self, mapper: NumberWordMapper):\n        self.mapper = mapper\n\n    def sort_number_words(self, input_string: str) -> str:\n        \"\"\"Splits the input string, converts words to integers, sorts them, converts back to words, and joins them.\"\"\"\n        if not isinstance(input_string, str):\n            raise TypeError(\"Input must be a string.\")\n\n        words = input_string.split()\n        if not words:\n            return \"\"\n\n        int_values = [self.mapper.word_to_int(word) for word in words]\n        int_values.sort()\n\n        sorted_words = [self.mapper.int_to_word(num) for num in int_values]\n        return \" \".join(sorted_words)\nclass NumberWordController:\n    \"\"\"Handles the entry point for the application, orchestrating the sorting process.\"\"\"\n    def __init__(self, sorter_service: NumberWordSorterService):\n        self.sorter_service = sorter_service\n\n    def process_and_sort(self, input_string: str) -> str:\n        \"\"\"Takes a space-delimited string of number words, delegates sorting to the service, and returns the sorted string.\"\"\"\n        return self.sorter_service.sort_number_words(input_string)\ndef sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Valid choices are 'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight' and 'nine'.\n    Return the string with numbers sorted from smallest to largest\n    >>> sort_numbers('three one five')\n    'one three five'\n    \"\"\"\n    mapper = NumberWordMapper()\n    sorter_service = NumberWordSorterService(mapper)\n    controller = NumberWordController(sorter_service)\n    return controller.process_and_sort(numbers)"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n    if n <= 1:\n        return 0\n\n    total_sevens = 0\n    for i in range(1, n):\n        if (i % 11 == 0) or (i % 13 == 0):\n            current_num_str = str(i)\n            total_sevens += current_num_str.count('7')\n\n    return total_sevens"}
