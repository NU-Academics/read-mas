{"task_id": "HumanEval/11", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input strings.\n    Raised when a string contains characters other than '0' or '1'.\n    \"\"\"\n    def __init__(self, message: str = \"Input string contains non-binary characters.\"):\n        self.message = message\n        super().__init__(self.message)\ndef string_xor(a: str, b: str) -> str:\n    \"\"\"\n    Performs binary XOR on two input strings consisting only of '1's and '0's.\n    Pads the shorter string with leading zeros if lengths differ, then returns the XOR result.\n    \"\"\"\n    # Validate input types and characters for both strings.\n    for s in [a, b]:\n        if not isinstance(s, str):\n            raise TypeError(\"Inputs must be strings.\")\n        if not all(char in '01' for char in s):\n            raise InvalidInputError(f\"String '{s}' contains non-binary characters.\")\n\n    # Pad the shorter string with leading '0's to match the length of the longer string.\n    max_len = max(len(a), len(b))\n    padded_a = a.zfill(max_len)\n    padded_b = b.zfill(max_len)\n\n    result_bits = []\n    # Perform bitwise XOR character by character.\n    for i in range(max_len):\n        bit_a = int(padded_a[i])\n        bit_b = int(padded_b[i])\n        xor_result = bit_a ^ bit_b\n        result_bits.append(str(xor_result))\n\n    return \"\".join(result_bits)"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome.\n    Compares the string with its reverse.\n    \"\"\"\n    return string == string[::-1]\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Finds the longest palindromic suffix, then appends the reverse of the preceding prefix.\n    \"\"\"\n    if not string:\n        return \"\"\n\n    # Iterate to find the start index 'i' of the longest palindromic suffix.\n    # The first 'i' (smallest) for which string[i:] is a palindrome identifies this suffix.\n    for i in range(len(string) + 1):\n        if is_palindrome(string[i:]):\n            prefix_to_reverse = string[:i]\n            return string + prefix_to_reverse[::-1]"}
