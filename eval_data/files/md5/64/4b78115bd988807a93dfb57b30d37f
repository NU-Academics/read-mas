{"task_id": "HumanEval/21", "solution": "from typing import List\ndef rescale_to_unit(numbers: List[float]) -> List[float]:\n    \"\"\"Given a list of numbers, applies a linear transform so the smallest becomes 0 and the largest becomes 1.\n    Raises ValueError if the input list contains fewer than two elements.\"\"\"\n\n    if len(numbers) < 2:\n        raise ValueError(\"Input list must contain at least two elements.\")\n\n    min_val = min(numbers)\n    max_val = max(numbers)\n\n    if max_val == min_val:\n        return [0.0] * len(numbers)\n\n    rescaled_numbers = [\n        (x - min_val) / (max_val - min_val) for x in numbers\n    ]\n    return rescaled_numbers"}
{"task_id": "HumanEval/25", "solution": "from typing import List\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to the factorizer.\n    It carries a descriptive message about the error.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef factorize(n: int) -> List[int]:\n    \"\"\"\n    Returns a list of prime factors of the given integer n,\n    ordered from smallest to largest, with each factor listed\n    the number of times it appears in the factorization.\n    \"\"\"\n    if not isinstance(n, int):\n        raise InvalidInputError(\"Input must be an integer.\")\n    if n <= 0:\n        raise InvalidInputError(\"Input must be a positive integer.\")\n    if n == 1:\n        return []\n\n    factors: List[int] = []\n    d = 2\n    temp_n = n\n\n    # Trial division algorithm for factorization.\n    # It efficiently finds factors up to sqrt(n).\n    while d * d <= temp_n:\n        while temp_n % d == 0:\n            factors.append(d)\n            temp_n //= d\n        d += 1\n\n    # If temp_n is still greater than 1, it's a prime factor itself.\n    if temp_n > 1:\n        factors.append(temp_n)\n\n    return factors"}
{"task_id": "HumanEval/26", "solution": "from typing import List\nfrom collections import Counter\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\"From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    \"\"\"\n    if not numbers:\n        return []\n\n    counts = Counter(numbers)\n    result = []\n    for num in numbers:\n        if counts[num] == 1:\n            result.append(num)\n    return result"}
{"task_id": "HumanEval/25", "solution": "from typing import List\nclass InvalidInputError(ValueError):\n    \"\"\"Exception raised for invalid input to the factorizer.\"\"\"\n    pass\nclass FactorizationError(RuntimeError):\n    \"\"\"Exception raised for errors during the factorization process.\"\"\"\n    pass\ndef factorize(n: int) -> List[int]:\n    \"\"\"\n    Return a list of prime factors of given integer n in ascending order.\n    Each factor is listed number of times corresponding to its multiplicity.\n    \"\"\"\n    if not isinstance(n, int):\n        raise InvalidInputError(\"Input must be an integer.\")\n    if n <= 1:\n        raise InvalidInputError(\"Input must be an integer greater than 1.\")\n\n    factors = []\n    d = 2\n    temp_n = n\n\n    try:\n        while d * d <= temp_n:\n            while temp_n % d == 0:\n                factors.append(d)\n                temp_n //= d\n            d += 1\n        if temp_n > 1:\n            factors.append(temp_n)\n    except Exception as e:\n        raise FactorizationError(f\"An unexpected error occurred during factorization: {e}\") from e\n\n    return factors"}
{"task_id": "HumanEval/24", "solution": "def largest_divisor(n: int) -> int:\n    \"\"\" For a given number n, find the largest number that divides n evenly, smaller than n.\n    Raises TypeError if n is not an integer or ValueError if n is less than or equal to 1.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n <= 1:\n        raise ValueError(\"Input 'n' must be greater than 1 to have a proper divisor smaller than n.\")\n\n    for i in range(n // 2, 0, -1):\n        if n % i == 0:\n            return i\n    \n    # This point is reached only if 'n' is a prime number, in which case 1 is its largest proper divisor.\n    return 1"}
