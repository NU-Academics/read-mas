{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"\n    Finds the word with the most unique characters, with lexicographical tie-breaking.\n    Returns an empty string if the input list is empty.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    best_word = words[0]\n    max_unique_count = len(set(words[0]))\n\n    for word in words[1:]:\n        current_unique_count = len(set(word))\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            best_word = word\n        elif current_unique_count == max_unique_count:\n            # If unique counts are tied, use lexicographical order\n            if word < best_word:\n                best_word = word\n\n    return best_word"}
{"task_id": "HumanEval/162", "solution": "import hashlib\nDEFAULT_ENCODING = \"utf-8\"\ndef string_to_md5(text):\n    \"\"\"\n    Computes the MD5 hash of a string, or returns None for an empty string.\n    Raises TypeError if the input is not a string.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input 'text' must be a string.\")\n    \n    if not text:\n        return None\n    \n    md5_hash = hashlib.md5()\n    md5_hash.update(text.encode(DEFAULT_ENCODING))\n    return md5_hash.hexdigest()"}
{"task_id": "HumanEval/161", "solution": "def solve(s: str) -> str:\n    \"\"\"Manipulates a string by reversing letter case or the entire string.\n    If no letters are present, the string is reversed; otherwise, only letter cases are flipped.\"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n\n    has_letters = any(c.isalpha() for c in s)\n\n    if not has_letters:\n        return s[::-1]\n    else:\n        result_chars = []\n        for char in s:\n            if char.isalpha():\n                if char.islower():\n                    result_chars.append(char.upper())\n                else:\n                    result_chars.append(char.lower())\n            else:\n                result_chars.append(char)\n        return \"\".join(result_chars)"}
{"task_id": "HumanEval/162", "solution": "import hashlib\nfrom typing import Optional\ndef string_to_md5(text: str) -> Optional[str]:\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    return hashlib.md5(text.encode('utf-8')).hexdigest()"}
