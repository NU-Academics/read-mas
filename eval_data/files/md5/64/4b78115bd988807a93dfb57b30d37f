{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Transforms a string by sorting characters within each word alphabetically.\n    Preserves original word order and exact spacing.\n    \"\"\"\n    processed_tokens = []\n    # Split the string by a single space, preserving empty strings for multiple spaces.\n    tokens = s.split(' ')\n\n    for token in tokens:\n        if token:  # If the token is a word (not an empty string)\n            # Sort characters within the word based on ASCII values.\n            processed_tokens.append(''.join(sorted(token)))\n        else:  # If the token is an empty string (represents a space)\n            # Preserve the empty string to maintain original spacing.\n            processed_tokens.append(token)\n\n    # Rejoin the processed tokens using a single space delimiter.\n    return ' '.join(processed_tokens)"}
{"task_id": "HumanEval/90", "solution": "def next_smallest(lst: list[int]) -> int | None:\n    \"\"\"\n    Returns the 2nd smallest distinct element of the list.\n    Returns None if there is no such element.\n    \"\"\"\n    \n    # Convert to a set to get distinct elements, then sort them.\n    # This approach ensures duplicates are handled and elements are ordered.\n    distinct_sorted_list = sorted(list(set(lst)))\n    \n    if len(distinct_sorted_list) < 2:\n        return None\n    \n    return distinct_sorted_list[1]"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    \"\"\"\n    Checks if one of three numbers is the sum of the other two, and all are integers.\n    Returns True if both conditions are met, False otherwise.\n    \"\"\"\n    if not all(isinstance(n, int) for n in [x, y, z]):\n        return False\n\n    return (x == y + z) or (y == x + z) or (z == x + y)"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    '''\n    Checks if one of the numbers is equal to the sum of the other two AND all numbers are integers.\n    Returns true if both conditions are met, false otherwise.\n    '''\n    # Check if all numbers are strictly integers (not floats that are numerically integers)\n    if not (isinstance(x, int) and isinstance(y, int) and isinstance(z, int)):\n        return False\n\n    # Check if one number is the sum of the other two\n    if x == y + z or y == x + z or z == x + y:\n        return True\n    else:\n        return False"}
{"task_id": "HumanEval/91", "solution": "def is_bored(S: str) -> int:\n    \"\"\"\n    Counts sentences starting with \"I\" (boredoms) in a text.\n    Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    SENTENCE_DELIMITERS = ['.', '?', '!']\n    sentences = []\n    current_sentence_chars = []\n    \n    # Split the input string into sentences based on delimiters.\n    for char in S:\n        current_sentence_chars.append(char)\n        if char in SENTENCE_DELIMITERS:\n            sentence = \"\".join(current_sentence_chars).strip()\n            if sentence:\n                sentences.append(sentence)\n            current_sentence_chars = []\n            \n    # Add any remaining text as a sentence if no delimiter at the end.\n    remaining = \"\".join(current_sentence_chars).strip()\n    if remaining:\n        sentences.append(remaining)\n            \n    boredom_count = 0\n    # Count sentences that start with the word \"I\", case-insensitively.\n    for sentence in sentences:\n        cleaned_sentence = sentence.strip()\n        if cleaned_sentence.lower().startswith(\"i \") or cleaned_sentence.lower() == \"i\":\n            boredom_count += 1\n            \n    return boredom_count"}
{"task_id": "HumanEval/91", "solution": "import re\ndef is_bored(S):\n    \"\"\"\n    Counts the number of sentences that start with the word 'I'.\n    Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n\n    # FR1 Error Handling: Treat None or non-string input as an empty string.\n    if not isinstance(S, str):\n        S = \"\"\n\n    # Nested helper function for splitting sentences based on the design.\n    def _split_sentences(text: str, delimiters: list[str]) -> list[str]:\n        if not isinstance(text, str):\n            return []\n\n        # FR2: Create a regex pattern to split by delimiters, keeping them.\n        delimiter_pattern = '|'.join(re.escape(d) for d in delimiters)\n        parts = re.split(f'({delimiter_pattern})', text)\n\n        sentences = []\n        current_sentence_parts = []\n        for part in parts:\n            if part in delimiters:\n                if current_sentence_parts:\n                    sentences.append(\"\".join(current_sentence_parts).strip())\n                    current_sentence_parts = []\n            else:\n                current_sentence_parts.append(part)\n        \n        # Add any remaining text as a sentence, ensuring it's not empty.\n        if current_sentence_parts:\n            final_sentence = \"\".join(current_sentence_parts).strip()\n            if final_sentence:\n                sentences.append(final_sentence)\n\n        return sentences\n\n    SENTENCE_DELIMITERS = ['.', '?', '!'] # FR2: Define sentence delimiters.\n    bored_sentence_count = 0\n    sentences = _split_sentences(S, SENTENCE_DELIMITERS)\n\n    for sentence in sentences:\n        stripped_sentence = sentence.strip() # FR3: Ignore leading whitespace.\n        if stripped_sentence:\n            # FR3: Use regex to find the first word and check if it's 'I' (case-insensitive).\n            match = re.match(r\"^\\s*([a-zA-Z]+)\", stripped_sentence)\n            if match:\n                first_word = match.group(1)\n                if first_word.lower() == 'i':\n                    bored_sentence_count += 1\n    \n    return bored_sentence_count # FR4: Return the total count."}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"\n    Encrypts a string by rotating alphabetic characters.\n    The alphabet is rotated such that letters shift down by four places, and non-alphabetic characters remain unchanged.\n    \"\"\"\n    SHIFT_AMOUNT = 4 # The fixed shift value for encryption.\n    encrypted_chars = []\n    for char in s:\n        if 'a' <= char <= 'z':\n            # Handle lowercase letters, apply shift and wrap-around.\n            shifted_char_code = (ord(char) - ord('a') + SHIFT_AMOUNT) % 26 + ord('a')\n            encrypted_chars.append(chr(shifted_char_code))\n        elif 'A' <= char <= 'Z':\n            # Handle uppercase letters, apply shift and wrap-around.\n            shifted_char_code = (ord(char) - ord('A') + SHIFT_AMOUNT) % 26 + ord('A')\n            encrypted_chars.append(chr(shifted_char_code))\n        else:\n            # Non-alphabetic characters remain unchanged.\n            encrypted_chars.append(char)\n    return \"\".join(encrypted_chars)"}
