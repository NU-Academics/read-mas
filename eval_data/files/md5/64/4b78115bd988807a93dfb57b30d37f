{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    Raises ValueError if the input list is empty.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    if not l:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    sorted_list = sorted(l)\n    n = len(sorted_list)\n\n    if n % 2 == 1:\n        # Odd length list: median is the middle element\n        return sorted_list[n // 2]\n    else:\n        # Even length list: median is the average of the two middle elements\n        mid1 = sorted_list[n // 2 - 1]\n        mid2 = sorted_list[n // 2]\n        return (mid1 + mid2) / 2"}
{"task_id": "HumanEval/46", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef fib4(n: int):\n    \"\"\"Computes the n-th element of the Fib4 number sequence iteratively.\n    Raises InvalidInputError if n is a negative integer.\n    \"\"\"\n    if n < 0:\n        raise InvalidInputError(\"Input n cannot be negative.\")\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    fib4_values = [0, 0, 2, 0] # Initialize the first four values for the sliding window.\n\n    for _ in range(4, n + 1):\n        next_fib4 = sum(fib4_values)\n        fib4_values.pop(0)\n        fib4_values.append(next_fib4)\n\n    return fib4_values[3]"}
{"task_id": "HumanEval/47", "solution": "from typing import Union\nclass EmptyListError(Exception):\n    \"\"\"Custom exception indicating an empty list for median calculation.\n    It provides a descriptive message for the error.\"\"\"\n    def __init__(self, message: str = \"Input list cannot be empty.\"):\n        super().__init__(message)\ndef median(l: list) -> Union[int, float]:\n    \"\"\"Return median of elements in the list l.\n    This function handles various error conditions and calculates the median based on list length.\"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"Input must be a list.\")\n    if not l:\n        raise EmptyListError(\"Input list cannot be empty.\")\n\n    for item in l:\n        if not isinstance(item, (int, float)):\n            raise TypeError(\"List elements must be numbers (int or float).\")\n\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    if n % 2 == 1:\n        return sorted_l[n // 2]\n    else:\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        return (mid1 + mid2) / 2.0"}
