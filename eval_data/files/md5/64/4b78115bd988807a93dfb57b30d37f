{"task_id": "HumanEval/78", "solution": "from typing import Set\nclass HexConstants:\n    \"\"\"\n    Defines constant values related to hexadecimal digits.\n    \"\"\"\n    PRIME_HEX_DIGITS: Set[str] = {\"2\", \"3\", \"5\", \"7\", \"B\", \"D\"}\nclass HexKeyCounter:\n    \"\"\"\n    Provides utility methods for counting prime hexadecimal digits.\n    \"\"\"\n    @staticmethod\n    def count_prime_hex_digits(hex_string: str) -> int:\n        \"\"\"\n        Counts the number of prime hexadecimal digits in a given string.\n        \"\"\"\n        prime_count = 0\n        for digit in hex_string:\n            if digit in HexConstants.PRIME_HEX_DIGITS:\n                prime_count += 1\n        return prime_count\ndef hex_key(num):\n    \"\"\"You have been tasked to write a function that receives\n    a hexadecimal number as a string and counts the number of hexadecimal\n    digits that are primes.\n    \"\"\"\n    return HexKeyCounter.count_prime_hex_digits(num)"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x: int, shift: int) -> str:\n    \"\"\"\n    Circularly shifts the digits of an integer to the right.\n    If shift is strictly greater than the number of digits, the digits are reversed.\n    \"\"\"\n    if not isinstance(x, int):\n        raise TypeError(\"Input 'x' must be an integer.\")\n    if not isinstance(shift, int):\n        raise TypeError(\"Input 'shift' must be an integer.\")\n    if shift < 0:\n        raise ValueError(\"Input 'shift' must be a non-negative integer.\")\n\n    if x == 0:\n        return \"0\"\n\n    sign = \"\"\n    if x < 0:\n        sign = \"-\"\n        x = abs(x)\n\n    s_x = str(x)\n    num_digits = len(s_x)\n\n    # FR3: If shift > number of digits, reverse the digits.\n    if shift > num_digits:\n        return sign + s_x[::-1]\n    else:\n        # FR1: Perform a circular right shift on the digits.\n        effective_shift = shift % num_digits\n        shifted_s_x = s_x[num_digits - effective_shift:] + s_x[:num_digits - effective_shift]\n        return sign + shifted_s_x"}
{"task_id": "HumanEval/82", "solution": "import math\ndef prime_length(string):\n    \"\"\"Write a function that takes a string and returns True if the string\n    length is a prime number or False otherwise\n    Examples\n    prime_length('Hello') == True\n    prime_length('abcdcba') == True\n    prime_length('kittens') == True\n    prime_length('orange') == False\n    \"\"\"\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if a given integer is a prime number.\n        A prime number is a natural number greater than 1 with no positive divisors other than 1 and itself.\n        \"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\n\n    if not isinstance(string, str):\n        raise TypeError(\"Input must be a string.\")\n    \n    length = len(string)\n    return is_prime(length)"}
{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"\n    Checks if the string length is a prime number.\n    Returns True if the length is prime, False otherwise.\n    \"\"\"\n    def is_prime(n: int) -> bool:\n        \"\"\"\n        Determines if a given integer is a prime number.\n        This uses an optimized trial division method.\n        \"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    length = len(string)\n    return is_prime(length)"}
{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Calculates the sum of N's decimal digits and returns the sum as a binary string.\n    Input N must be an integer between 0 and 10000, inclusive.\n    \"\"\"\n    if not isinstance(N, int) or not (0 <= N <= 10000):\n        raise ValueError(\"Input N must be an integer between 0 and 10000.\")\n\n    # Calculate sum of digits.\n    # Converting to string and iterating is a straightforward way to sum digits.\n    sum_of_digits = sum(int(digit) for digit in str(N))\n    \n    # Convert the calculated sum to its binary string representation.\n    if sum_of_digits == 0:\n        return \"0\"\n    \n    binary_string = \"\"\n    temp_sum = sum_of_digits\n    while temp_sum > 0:\n        binary_string = str(temp_sum % 2) + binary_string\n        temp_sum //= 2\n        \n    return binary_string"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n: int) -> int:\n    \"\"\"\n    Given a positive integer n, return the count of n-digit positive integers\n    that either start or end with the digit 1.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    if n == 1:\n        return 1  # The only 1-digit number satisfying the condition is '1'.\n\n    # Calculate count of n-digit numbers starting with 1.\n    count_starts_with_1 = 10**(n - 1)\n\n    # Calculate count of n-digit numbers ending with 1.\n    # The first digit cannot be 0, so there are 9 choices for the first digit.\n    count_ends_with_1 = 9 * (10**(n - 2))\n\n    # Calculate count of n-digit numbers starting AND ending with 1.\n    # The first digit is 1, the last is 1. The middle n-2 digits vary.\n    count_starts_and_ends_with_1 = 10**(n - 2)\n\n    # Apply the principle of inclusion-exclusion to find the total count.\n    return count_starts_with_1 + count_ends_with_1 - count_starts_and_ends_with_1"}
