{"task_id": "Mbpp/453", "solution": "from typing import List\n\ndef is_even(factor: int) -> bool:\n    \"\"\"Check if a factor is even (divisible by 2).\"\"\"\n    return factor % 2 == 0\n\ndef find_factors(number: int) -> List[int]:\n    \"\"\"Find all factors of a number including 1 and the number itself.\"\"\"\n    factors = []\n    for i in range(1, number + 1):\n        if number % i == 0:\n            factors.append(i)\n    return factors\n\ndef sum_even_factors(factors: List[int]) -> int:\n    \"\"\"Filter even factors and return their sum.\"\"\"\n    even_sum = 0\n    for factor in factors:\n        if is_even(factor):\n            even_sum += factor\n    return even_sum\n\ndef sumofFactors(number: int) -> int:\n    \"\"\"Main function to calculate sum of even factors.\"\"\"\n    all_factors = find_factors(number)\n    return sum_even_factors(all_factors)"}
