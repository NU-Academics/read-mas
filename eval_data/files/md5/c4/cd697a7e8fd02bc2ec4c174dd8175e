{"task_id": "Mbpp/113", "solution": "def _is_numeric_char(char: str) -> bool:\n    \"\"\"Checks if a single character is a numeric digit.\"\"\"\n    return char.isdigit()\n\ndef _contains_whitespace(s: str) -> bool:\n    \"\"\"Detects whitespace characters in a string.\"\"\"\n    for char in s:\n        if char.isspace():\n            return True\n    return False\n\ndef _contains_decimal(s: str) -> bool:\n    \"\"\"Detects a decimal point in a string.\"\"\"\n    return '.' in s\n\ndef _is_valid_sign(s: str) -> bool:\n    \"\"\"Validates the placement and format of a sign character.\"\"\"\n    if not s:\n        return False\n    \n    first_char = s[0]\n    if first_char == '-' or first_char == '+':\n        # A sign is valid only if it is followed by at least one digit.\n        return len(s) > 1\n    # If there's no sign character at the beginning, it's considered valid in terms of sign format.\n    return True\n\ndef check_integer(input_string: str) -> bool:\n    \"\"\"\n    Checks if a string represents an integer or not.\n    It returns False for empty strings, strings with whitespace, or decimal points.\n    \"\"\"\n    if not input_string:\n        return False\n\n    if _contains_whitespace(input_string):\n        return False\n\n    if _contains_decimal(input_string):\n        return False\n\n    # Check for valid sign. This also handles cases where a sign is present without digits (e.g., \"+\", \"-\").\n    if not _is_valid_sign(input_string):\n        return False\n\n    start_index = 0\n    # Determine if the first character is an optional sign.\n    if input_string[0] == '-' or input_string[0] == '+':\n        start_index = 1\n\n    # All remaining characters from start_index must be numeric digits.\n    for i in range(start_index, len(input_string)):\n        if not _is_numeric_char(input_string[i]):\n            return False\n\n    return True"}
{"task_id": "Mbpp/116", "solution": "def tuple_to_int(input_tuple: tuple) -> int:\n    \"\"\"\n    Convert a tuple of positive integers into a single integer by concatenating digits.\n\n    Args:\n        input_tuple (tuple): Tuple containing positive integers\n\n    Returns:\n        int: Single integer formed by concatenating input digits\n\n    Raises:\n        TypeError: If input is not a tuple.\n        ValueError: If tuple contains non-positive integers.\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n\n    string_parts = []\n    for num in input_tuple:\n        if not isinstance(num, int) or num <= 0:\n            raise ValueError(\"Tuple must contain only positive integers.\")\n        string_parts.append(str(num))\n\n    concatenated_str = \"\".join(string_parts)\n    \n    # int(\"\") raises ValueError, which is consistent with no digits being available for concatenation\n    # and aligns with the function raising ValueErrors for invalid input contents.\n    return int(concatenated_str)"}
