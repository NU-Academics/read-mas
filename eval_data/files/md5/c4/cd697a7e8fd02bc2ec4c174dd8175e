{"task_id": "Mbpp/773", "solution": "def occurance_substring(main_string: str, substring: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Find the occurrence and position of substring within a string.\n\n    Args:\n        main_string: The string to search in\n        substring: The substring to search for\n\n    Returns:\n        Tuple of (substring, start_position, end_position) if found, None otherwise\n    \"\"\"\n    start_pos = main_string.find(substring)\n\n    if start_pos == -1:\n        return None\n\n    end_pos = start_pos + len(substring)\n    return (substring, start_pos, end_pos)"}
{"task_id": "Mbpp/771", "solution": "def check_expression(expression: str) -> bool:\n    \"\"\"\n    Check if the given expression has balanced brackets.\n    \"\"\"\n    OPENING_BRACKETS = {'(', '[', '{'}\n    CLOSING_BRACKETS = {')', ']', '}'}\n    BRACKET_PAIRS = {')': '(', ']': '[', '}': '{'}\n\n    stack = []\n\n    for char in expression:\n        if char in OPENING_BRACKETS:\n            stack.append(char)\n        elif char in CLOSING_BRACKETS:\n            if not stack:\n                return False\n            top_char = stack.pop()\n            if BRACKET_PAIRS[char] != top_char:\n                return False\n\n    return len(stack) == 0"}
{"task_id": "Mbpp/772", "solution": "def remove_length(text: str, k: int) -> str:\n    \"\"\"Removes all words of a specific length k from the input string.\"\"\"\n    if not text:\n        return \"\"\n    if k <= 0:  # According to design, invalid k values result in no filtering.\n        return text\n\n    words = text.split()\n    filtered_words = [word for word in words if len(word) != k]\n    return \" \".join(filtered_words)"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(source_string: str, substring: str):\n    \"\"\"\n    Finds the first occurrence and position of a substring within a string.\n    Returns None if there is no match.\n    \"\"\"\n    start_pos = source_string.find(substring)\n\n    if start_pos == -1:\n        # Substring not found, return None as specified.\n        return None\n    else:\n        # Match found, calculate the end position (exclusive) and return the formatted tuple.\n        end_pos = start_pos + len(substring)\n        return (substring, start_pos, end_pos)"}
