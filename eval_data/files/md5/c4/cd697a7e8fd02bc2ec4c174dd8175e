{"task_id": "Mbpp/65", "solution": "from typing import List, Any\n\ndef _is_numeric(element: Any) -> bool:\n    \"\"\"Checks if an element is an integer.\"\"\"\n    return isinstance(element, int)\n\ndef _is_list(element: Any) -> bool:\n    \"\"\"Checks if an element is a list.\"\"\"\n    return isinstance(element, list)\n\ndef recursive_list_sum(input_list: List) -> int:\n    \"\"\"\n    Flattens a list and sums all of its integer elements recursively.\n    Handles nested lists of arbitrary depth.\n    \"\"\"\n    total_sum = 0\n    for element in input_list:\n        if _is_numeric(element):\n            total_sum += element\n        elif _is_list(element):\n            total_sum += recursive_list_sum(element)\n    return total_sum"}
{"task_id": "Mbpp/66", "solution": "def pos_count(numbers: list) -> int:\n    \"\"\"\n    Counts the number of positive numbers in a given list.\n    \"\"\"\n    def _is_positive_number(value) -> bool:\n        \"\"\"\n        Checks if a value is a positive number (greater than 0).\n        \"\"\"\n        if isinstance(value, (int, float)):\n            return value > 0\n        return False\n\n    count = 0\n    for number in numbers:\n        if _is_positive_number(number):\n            count += 1\n    return count"}
{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    \"\"\"\n    Calculates the Bell number for a given non-negative integer n.\n    This function computes the number of partitions of a set with n elements.\n    \"\"\"\n    if n == 0 or n == 1:\n        return 1\n\n    # Initialize a 2D list for the Bell triangle (Bell numbers)\n    # bell_triangle[i][j] will store S(i, j), the Stirling number of the second kind\n    # Or, more directly, the first row is B(0)=1, and subsequent rows are derived.\n    # We'll use the Akiyama-Jordan method (Bell triangle) for efficiency.\n    bell_triangle = [[0] * (n + 1) for _ in range(n + 1)]\n\n    # B(0) = 1, which is the first element of the first row (conceptually B_0,0)\n    bell_triangle[0][0] = 1\n\n    for i in range(1, n + 1):\n        # The first element of each row is the last element of the previous row.\n        # This is B(i) = S(i,0) + S(i,1) + ... + S(i,i) where B(i) = bell_triangle[i][0]\n        # and also bell_triangle[i][0] = bell_triangle[i-1][i-1]\n        bell_triangle[i][0] = bell_triangle[i-1][i-1]\n        for j in range(1, i + 1):\n            # Each subsequent element is the sum of the element to its left and\n            # the element directly above it in the Bell triangle.\n            # bell_triangle[i][j] = bell_triangle[i][j-1] + bell_triangle[i-1][j-1]\n            bell_triangle[i][j] = bell_triangle[i][j-1] + bell_triangle[i-1][j-1]\n\n    # The Bell number B(n) is the first element of the nth row (0-indexed).\n    return bell_triangle[n][0]"}
{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Bell number using dynamic programming (Bell triangle method).\n    Assumes n is a non-negative integer.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    # Initialize the first row of the Bell triangle (B(0))\n    # prev_row stores the elements of the (i-1)-th row\n    prev_row = [1]\n\n    # Build subsequent rows up to n\n    for i in range(1, n + 1):\n        current_row = []\n        # The first element of the current row is the last element of the previous row\n        current_row.append(prev_row[-1])\n        # Calculate subsequent elements in the current row\n        for j in range(1, i + 1):\n            current_row.append(current_row[j-1] + prev_row[j-1])\n        # The current row becomes the previous row for the next iteration\n        prev_row = current_row\n\n    # The first element of the last computed row (which is bell[n]) is B(n)\n    return prev_row[0]"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(arr: list) -> bool:\n    \"\"\"\n    Checks if the given array is monotonic (either non-decreasing or non-increasing).\n    An empty array or a single-element array is considered monotonic.\n    \"\"\"\n    n = len(arr)\n    if n <= 1:\n        return True\n\n    def _is_non_decreasing(array: list) -> bool:\n        \"\"\"Helper to check if the array is non-decreasing.\"\"\"\n        for i in range(1, len(array)):\n            if array[i] < array[i-1]:\n                return False\n        return True\n\n    def _is_non_increasing(array: list) -> bool:\n        \"\"\"Helper to check if the array is non-increasing.\"\"\"\n        for i in range(1, len(array)):\n            if array[i] > array[i-1]:\n                return False\n        return True\n\n    return _is_non_decreasing(arr) or _is_non_increasing(arr)"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(array: list) -> bool:\n    \"\"\"Checks if the given array is monotonic (either increasing or decreasing).\n    Empty arrays and single-element arrays are considered monotonic.\"\"\"\n    \n    n = len(array)\n    if n <= 1:\n        return True\n\n    # Check if the array is monotonically increasing (non-decreasing).\n    is_increasing = True\n    for i in range(n - 1):\n        if array[i] > array[i+1]:\n            is_increasing = False\n            break\n\n    if is_increasing:\n        return True\n\n    # If not increasing, check if the array is monotonically decreasing (non-increasing).\n    is_decreasing = True\n    for i in range(n - 1):\n        if array[i] < array[i+1]:\n            is_decreasing = False\n            break\n            \n    return is_decreasing"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list: list, sublist: list) -> bool:\n    \"\"\"\n    Check if sublist appears as contiguous subsequence in main_list.\n    This function handles empty list edge cases and performs a sliding window search.\n    \"\"\"\n    # Helper function to handle empty list edge cases\n    def _validate_empty_cases(main_list_inner, sublist_inner):\n        if not sublist_inner:\n            # An empty sublist is always considered a sublist of any list\n            return True, True\n        if not main_list_inner:\n            # A non-empty sublist cannot be found in an empty main list\n            return True, False\n        return False, None # No special empty case, continue with search\n\n    # Helper function to search for a contiguous subsequence\n    def _find_contiguous_subsequence(main_list_inner, sublist_inner):\n        n = len(main_list_inner)\n        m = len(sublist_inner)\n\n        # If the sublist is longer than the main list, it cannot be a sublist\n        if m > n:\n            return False\n\n        # Iterate through all possible starting positions for the sublist\n        for i in range(n - m + 1):\n            # Compare the slice of main_list with the sublist\n            if main_list_inner[i : i + m] == sublist_inner:\n                return True\n        return False\n\n    # First, check for empty list conditions to handle edge cases directly\n    has_result, result_value = _validate_empty_cases(main_list, sublist)\n    if has_result:\n        return result_value\n\n    # If no result from empty cases, proceed with the main subsequence search logic\n    return _find_contiguous_subsequence(main_list, sublist)"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list, sublist):\n    \"\"\"\n    Checks if a sublist exists as a contiguous subsequence within a main list.\n    Handles empty sublists and empty main lists as per design requirements.\n    \"\"\"\n    if not sublist:\n        return True\n    if not main_list:\n        return False\n\n    n = len(main_list)\n    m = len(sublist)\n\n    if m > n:\n        return False\n\n    for i in range(n - m + 1):\n        match = True\n        for j in range(m):\n            if main_list[i + j] != sublist[j]:\n                match = False\n                break\n        if match:\n            return True\n\n    return False"}
