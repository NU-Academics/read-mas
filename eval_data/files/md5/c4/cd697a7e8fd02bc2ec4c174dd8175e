{"task_id": "Mbpp/572", "solution": "def two_unique_nums(input_list):\n    \"\"\"\n    Removes duplicate numbers from a list, returning only numbers that appear exactly once while preserving their original order.\n    \"\"\"\n\n    def _count_occurrences(lst):\n        \"\"\"Counts occurrences of each number in the input list.\"\"\"\n        counts = {}\n        for num in lst:\n            counts[num] = counts.get(num, 0) + 1\n        return counts\n\n    def _filter_unique(counts_map):\n        \"\"\"Identifies numbers that appear exactly once based on the counts map.\"\"\"\n        unique_set = set()\n        for num, count in counts_map.items():\n            if count == 1:\n                unique_set.add(num)\n        return unique_set\n\n    def _preserve_order(original_list, unique_numbers_set):\n        \"\"\"Maintains the original order of unique numbers as they first appeared.\"\"\"\n        result = []\n        for num in original_list:\n            if num in unique_numbers_set:\n                result.append(num)\n        return result\n\n    if not input_list:\n        return []\n\n    counts = _count_occurrences(input_list)\n    unique_numbers_set = _filter_unique(counts)\n    \n    return _preserve_order(input_list, unique_numbers_set)"}
{"task_id": "Mbpp/573", "solution": "def unique_product(input_list: list) -> int:\n    \"\"\"\n    Calculates the product of the unique numbers in a given list.\n    This function orchestrates the extraction of unique numbers and their product calculation.\n    \"\"\"\n\n    def _get_unique_numbers(numbers: list) -> list:\n        \"\"\"Extracts unique numbers from a list.\"\"\"\n        return list(set(numbers))\n\n    def _calculate_product(numbers: list) -> int:\n        \"\"\"Calculates the product of numbers in a list.\"\"\"\n        product = 1\n        for num in numbers:\n            product *= num\n        return product\n\n    unique_nums = _get_unique_numbers(input_list)\n    result_product = _calculate_product(unique_nums)\n    return result_product"}
{"task_id": "Mbpp/573", "solution": "def unique_product(input_list):\n    \"\"\"\n    Calculates the product of the unique numbers in a given list.\n    Handles empty lists by returning 1 as the product.\n    \"\"\"\n    unique_numbers = set(input_list)\n    product = 1\n    for number in unique_numbers:\n        product *= number\n    return product"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n: int) -> int:\n    \"\"\"\n    Calculates the last digit of the factorial of a given number n.\n    For n >= 5, the last digit of n! is always 0 due to the presence of 2 and 5 as factors.\n    \"\"\"\n    if n < 0:\n        # Factorial is not defined for negative numbers in this context.\n        # Assuming non-negative input as per typical factorial definitions.\n        # Returning 0 as a default, or an error would be another approach\n        # if input validation was explicitly allowed.\n        return 0\n    elif n >= 5:\n        return 0\n    elif n == 0:\n        return 1\n    elif n == 1:\n        return 1\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 6\n    elif n == 4:\n        return 4"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(main_list: list, sub_list: list) -> bool:\n    \"\"\"Checks if sub_list is a contiguous sublist of main_list.\n    It returns True if sub_list is found as a contiguous sequence, False otherwise.\"\"\"\n    n = len(main_list)\n    m = len(sub_list)\n\n    if m == 0:\n        return True\n\n    if m > n:\n        return False\n\n    for i in range(n - m + 1):\n        if main_list[i : i + m] == sub_list:\n            return True\n\n    return False"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(main_list, sub_list):\n    \"\"\"\n    Checks if `sub_list` is a contiguous sublist of `main_list`.\n    An empty list is considered a sublist of any list.\n    \"\"\"\n    if not sub_list:\n        return True\n    \n    if len(sub_list) > len(main_list):\n        return False\n\n    for i in range(len(main_list) - len(sub_list) + 1):\n        if main_list[i : i + len(sub_list)] == sub_list:\n            return True\n            \n    return False"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(list1, list2, list3) -> list:\n    \"\"\"Interleaves three lists of the same length into a single flat list.\n    Elements are interleaved in a round-robin fashion: list1[i], list2[i], list3[i].\"\"\"\n    len1 = len(list1)\n    len2 = len(list2)\n    len3 = len(list3)\n\n    if not (len1 == len2 and len2 == len3):\n        raise ValueError(\"All input lists must have the same length.\")\n\n    interleaved_list = []\n    for i in range(len1):\n        interleaved_list.append(list1[i])\n        interleaved_list.append(list2[i])\n        interleaved_list.append(list3[i])\n\n    return interleaved_list"}
{"task_id": "Mbpp/577", "solution": "def _calculate_factorial(number: int) -> int:\n    \"\"\"Calculates the factorial of a given non-negative integer.\"\"\"\n    if number == 0:\n        return 1\n    factorial = 1\n    for i in range(1, number + 1):\n        factorial *= i\n    return factorial\n\ndef _extract_last_digit(factorial: int) -> int:\n    \"\"\"Extracts the last digit from a given integer.\"\"\"\n    return factorial % 10\n\ndef last_Digit_Factorial(number: int) -> int:\n    \"\"\"\n    Finds the last digit in factorial of a given number.\n    Handles special cases for 0, 1, and numbers >= 5 for efficiency.\n    \"\"\"\n    # Assuming 'number' is a non-negative integer as per implicit problem context\n    # and explicit constraints to not raise exceptions or add instance checks.\n\n    if number == 0:\n        return 1  # 0! = 1, last digit is 1\n    elif number == 1:\n        return 1  # 1! = 1, last digit is 1\n    elif number >= 5:\n        return 0  # Factorials of numbers 5 or greater always end in 0.\n    else:\n        # For numbers 2, 3, or 4, calculate factorial and extract the last digit.\n        factorial_result = _calculate_factorial(number)\n        return _extract_last_digit(factorial_result)"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Finds elements that are present in one tuple but not in both.\n    Uses set operations for efficient comparison and returns a new tuple.\n    \"\"\"\n    set1 = set(tuple1)\n    set2 = set(tuple2)\n\n    # Elements unique to tuple1\n    unique_to_tuple1 = set1 - set2\n    # Elements unique to tuple2\n    unique_to_tuple2 = set2 - set1\n\n    # Combine unique elements from both sets\n    dissimilar_elements = unique_to_tuple1.union(unique_to_tuple2)\n\n    return tuple(sorted(list(dissimilar_elements)))"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(list1, list2, list3):\n    \"\"\"\n    Interleaves three lists of the same length into a single flat list.\n    Elements are taken in order from list1, then list2, then list3.\n    \"\"\"\n    result = []\n    length = len(list1)  # All lists are guaranteed to be of the same length\n    for i in range(length):\n        result.append(list1[i])\n        result.append(list2[i])\n        result.append(list3[i])\n    return result"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Finds elements that exist in one tuple but not in both, preserving their original order.\n    Elements from the first tuple appear before elements from the second tuple.\n    \"\"\"\n    def _get_unique_from_first(input_tuple1: tuple, input_tuple2: tuple) -> list:\n        \"\"\"Extracts elements present in input_tuple1 but not in input_tuple2, preserving their order from input_tuple1.\"\"\"\n        set_input_tuple2 = set(input_tuple2)\n        unique_elements = [item for item in input_tuple1 if item not in set_input_tuple2]\n        return unique_elements\n\n    def _get_unique_from_second(input_tuple1: tuple, input_tuple2: tuple) -> list:\n        \"\"\"Extracts elements present in input_tuple2 but not in input_tuple1, preserving their order from input_tuple2.\"\"\"\n        set_input_tuple1 = set(input_tuple1)\n        unique_elements = [item for item in input_tuple2 if item not in set_input_tuple1]\n        return unique_elements\n\n    def _preserve_order(unique_first_list: list, unique_second_list: list) -> tuple:\n        \"\"\"Combines two lists of unique elements into a single tuple, maintaining their relative order.\"\"\"\n        return tuple(unique_first_list + unique_second_list)\n\n    unique_from_t1 = _get_unique_from_first(tuple1, tuple2)\n    unique_from_t2 = _get_unique_from_second(tuple1, tuple2)\n    return _preserve_order(unique_from_t1, unique_from_t2)"}
{"task_id": "Mbpp/583", "solution": "def catalan_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Catalan number using the combinatorial formula C_n = (2n choose n) / (n + 1).\n    Assumes n is a non-negative integer as per design requirements.\n    \"\"\"\n    import math\n\n    # C_n = (2n choose n) / (n + 1)\n    # math.comb(N, K) calculates \"N choose K\"\n    numerator = math.comb(2 * n, n)\n    denominator = n + 1\n\n    # Catalan numbers are integers, so integer division is appropriate.\n    return numerator // denominator"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Recursively filters a nested tuple, retaining only even integers and preserving structure.\n    Non-integer, non-tuple elements are skipped.\n    \"\"\"\n    filtered_elements = []\n    for element in input_tuple:\n        if isinstance(element, int):\n            if element % 2 == 0:\n                filtered_elements.append(element)\n        elif isinstance(element, tuple):\n            processed_sub_tuple = extract_even(element)\n            if processed_sub_tuple:  # Only add non-empty filtered sub-tuples\n                filtered_elements.append(processed_sub_tuple)\n    return tuple(filtered_elements)"}
{"task_id": "Mbpp/581", "solution": "def surface_Area(base_edge: float, height: float) -> float:\n    \"\"\"\n    Calculates the total surface area of a square pyramid.\n    The 'height' parameter is interpreted as the slant height to satisfy the given test case.\n    \"\"\"\n    base_area = base_edge * base_edge\n    lateral_area = 2 * base_edge * height # 'height' is used as slant_height here.\n    total_surface_area = base_area + lateral_area\n    return total_surface_area"}
{"task_id": "Mbpp/583", "solution": "def catalan_number(n):\n    \"\"\"\n    Calculates the nth Catalan number using the formula C(n) = (2n)! / ((n+1)! * n!).\n    Assumes n is a non-negative integer.\n    \"\"\"\n    def _factorial(k):\n        \"\"\"Computes the factorial of a non-negative integer k.\"\"\"\n        res = 1\n        for i in range(1, k + 1):\n            res *= i\n        return res\n\n    fact_2n = _factorial(2 * n)\n    fact_n_plus_1 = _factorial(n + 1)\n    fact_n = _factorial(n)\n\n    return fact_2n // (fact_n_plus_1 * fact_n)"}
{"task_id": "Mbpp/581", "solution": "import math\n\ndef surface_Area(base_edge: float, height: float) -> float:\n    \"\"\"\n    Calculate the surface area of a square pyramid.\n\n    Args:\n        base_edge (float): Length of the square base edge\n        height (float): Height of the pyramid from base to apex\n\n    Returns:\n        float: Total surface area of the square pyramid\n    \"\"\"\n    # To satisfy the assertion surface_Area(3,4) == 33,\n    # the 'height' parameter must be interpreted as the slant height for the lateral faces.\n    # Base area = base_edge * base_edge\n    # Lateral area = 4 * (0.5 * base_edge * slant_height) = 2 * base_edge * slant_height\n    # Assuming height is slant_height to match the assertion.\n    base_area = base_edge * base_edge\n    lateral_area = 2 * base_edge * height\n    total_surface_area = base_area + lateral_area\n    return total_surface_area"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple):\n    \"\"\"\n    Recursively removes odd integer elements from a nested mixed tuple,\n    preserving even integers and non-integer elements.\n    \"\"\"\n\n    def is_integer(element):\n        \"\"\"Checks if an element is an integer type.\"\"\"\n        return isinstance(element, int)\n\n    def is_even(element):\n        \"\"\"Checks if an integer element is even.\"\"\"\n        return element % 2 == 0\n\n    def _process_tuple_elements(elements):\n        \"\"\"Processes elements of a tuple, filtering odd integers and recursing into nested tuples.\"\"\"\n        filtered_list = []\n        for item in elements:\n            if is_integer(item):\n                if is_even(item):\n                    filtered_list.append(item)\n            elif isinstance(item, tuple):\n                nested_result = _process_tuple_elements(item)\n                if nested_result:\n                    filtered_list.append(tuple(nested_result))\n            else:\n                filtered_list.append(item)\n        return filtered_list\n\n    return tuple(_process_tuple_elements(input_tuple))"}
