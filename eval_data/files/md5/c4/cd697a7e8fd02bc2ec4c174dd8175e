{"task_id": "Mbpp/119", "solution": "def search(array: list) -> int:\n    \"\"\"\n    Finds the element that appears only once in a sorted array where all other elements appear twice.\n    Uses the XOR property to cancel out paired elements.\n    \"\"\"\n    unique_element = 0\n    for num in array:\n        unique_element ^= num\n    return unique_element"}
{"task_id": "Mbpp/119", "solution": "def search(array: list[int]) -> int:\n    \"\"\"\n    Find the element that appears only once in a sorted array.\n    This implementation uses binary search to achieve O(log n) time complexity.\n    \"\"\"\n    left = 0\n    right = len(array) - 1\n\n    while left <= right:\n        mid = (left + right) // 2\n\n        # Check if mid is the unique element\n        if (mid == 0 or array[mid] != array[mid - 1]) and \\\n           (mid == len(array) - 1 or array[mid] != array[mid + 1]):\n            return array[mid]\n\n        # Determine if the unique element is in the left or right half\n        # If mid is an even index\n        if mid % 2 == 0:\n            if array[mid] == array[mid + 1]:\n                left = mid + 2  # Unique element is to the right\n            else:\n                right = mid     # Unique element is to the left or is mid\n        # If mid is an odd index\n        else:\n            if array[mid] == array[mid - 1]:\n                left = mid + 1  # Unique element is to the right\n            else:\n                right = mid - 1 # Unique element is to the left\n\n    return -1 # Should not be reached given the problem constraints"}
{"task_id": "Mbpp/120", "solution": "from typing import List, Tuple, Union\n\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input formats.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\ndef _validate_input(tuples: List) -> None:\n    \"\"\"Validate that input is a list of tuples with exactly two numeric elements each.\"\"\"\n    if not isinstance(tuples, list):\n        raise ValidationError(\"Input must be a list.\")\n    \n    # An empty list is considered valid input; no further element-specific validation needed.\n    if not tuples:\n        return\n\n    for i, item in enumerate(tuples):\n        if not isinstance(item, tuple):\n            raise ValidationError(f\"Element at index {i} must be a tuple, got {type(item).__name__}.\")\n        if len(item) != 2:\n            raise ValidationError(f\"Tuple at index {i} must contain exactly two elements, got {len(item)}.\")\n        if not (isinstance(item[0], (int, float)) and isinstance(item[1], (int, float))):\n            raise ValidationError(f\"Elements in tuple at index {i} must be numeric, got types {type(item[0]).__name__} and {type(item[1]).__name__}.\")\n\ndef _calculate_absolute_product(tuple_pair: Tuple[Union[int, float], Union[int, float]]) -> Union[int, float]:\n    \"\"\"Calculate absolute product of two numbers in a tuple.\"\"\"\n    return abs(tuple_pair[0] * tuple_pair[1])\n\ndef _find_maximum(products: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"Find maximum value from list of calculated products.\"\"\"\n    if not products:\n        return 0 # Handles an empty list of products gracefully by returning 0.\n    return max(products)\n\ndef max_product_tuple(tuples: List[Tuple[Union[int, float], Union[int, float]]]) -> Union[int, float]:\n    \"\"\"Find maximum absolute product between numbers in pairs of tuples.\"\"\"\n    _validate_input(tuples)\n    \n    # If the input list is empty after validation, return 0 as graceful handling.\n    if not tuples:\n        return 0\n\n    absolute_products = []\n    for tuple_pair in tuples:\n        absolute_products.append(_calculate_absolute_product(tuple_pair))\n    \n    return _find_maximum(absolute_products)"}
