{"task_id": "Mbpp/141", "solution": "def pancake_sort(arr: list) -> list:\n    \"\"\"\n    Sorts a list using pancake sort algorithm.\n    Returns new list with elements sorted in ascending order.\n    \"\"\"\n\n    def flip(arr: list, k: int) -> list:\n        \"\"\"\n        Reverses elements from index 0 to k in arr (in-place).\n        \"\"\"\n        start = 0\n        while start < k:\n            arr[start], arr[k] = arr[k], arr[start]\n            start += 1\n            k -= 1\n        return arr\n\n    def find_max_index(arr: list, n: int) -> int:\n        \"\"\"\n        Finds index of maximum element in first n elements of arr.\n        \"\"\"\n        max_val = arr[0]\n        max_idx = 0\n        for i in range(1, n):\n            if arr[i] > max_val:\n                max_val = arr[i]\n                max_idx = i\n        return max_idx\n\n    n = len(arr)\n    if n <= 1:\n        return list(arr)\n\n    arr_copy = list(arr)\n\n    for current_size in range(n, 1, -1):\n        max_idx = find_max_index(arr_copy, current_size)\n\n        if max_idx != current_size - 1:\n            if max_idx != 0:\n                flip(arr_copy, max_idx)\n            flip(arr_copy, current_size - 1)\n\n    return arr_copy"}
