{"task_id": "Mbpp/92", "solution": "def _extract_digits(number: int) -> list:\n    \"\"\"Extracts individual digits from an integer and returns them as a list.\"\"\"\n    return [int(d) for d in str(number)]\n\ndef _validate_minimum_digits(number: int) -> bool:\n    \"\"\"Checks if the number has at least 3 digits.\"\"\"\n    return len(str(number)) >= 3\n\ndef _check_alternating_pattern(digits: list) -> bool:\n    \"\"\"Verifies if the list of digits forms an alternating pattern of exactly two different digits.\"\"\"\n    if len(digits) < 2:\n        return False # Should be handled by _validate_minimum_digits, but as a safeguard\n\n    digit_a = digits[0]\n    digit_b = digits[1]\n\n    if digit_a == digit_b:\n        return False # The two alternating digits must be different\n\n    for i in range(2, len(digits)):\n        if i % 2 == 0:  # Even index, should match digit_a\n            if digits[i] != digit_a:\n                return False\n        else:  # Odd index, should match digit_b\n            if digits[i] != digit_b:\n                return False\n    return True\n\ndef is_undulating(number: int) -> bool:\n    \"\"\"\n    Checks if the given number is undulating.\n    An undulating number alternates between exactly two different digits and has at least 3 digits.\n    \"\"\"\n    if not _validate_minimum_digits(number):\n        return False\n\n    digits = _extract_digits(number)\n    return _check_alternating_pattern(digits)"}
