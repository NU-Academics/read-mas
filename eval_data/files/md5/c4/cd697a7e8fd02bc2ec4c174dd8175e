{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(num1: int, num2: int) -> int:\n    \"\"\"\n    Calculates the sum of per-digit absolute differences between two integers.\n    The shorter number is implicitly padded with leading zeros for alignment.\n    \"\"\"\n    s_num1 = str(num1)\n    s_num2 = str(num2)\n\n    max_len = max(len(s_num1), len(s_num2))\n\n    # Pad the shorter string with leading zeros\n    padded_s_num1 = s_num1.zfill(max_len)\n    padded_s_num2 = s_num2.zfill(max_len)\n\n    total_distance = 0\n    for i in range(max_len):\n        digit1 = int(padded_s_num1[i])\n        digit2 = int(padded_s_num2[i])\n        total_distance += abs(digit1 - digit2)\n\n    return total_distance"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(num1: int, num2: int) -> int:\n    \"\"\"\n    Calculates the sum of per-digit differences between two integers.\n    Missing digits are treated as zero for comparison.\n    \"\"\"\n\n    def _extract_digits(number: int) -> list[int]:\n        \"\"\"\n        Extracts individual digits from an integer into a list, ordered from least to most significant.\n        \"\"\"\n        if number == 0:\n            return [0]\n        \n        # Use absolute value for digit extraction, as differences are based on magnitude.\n        current_num = abs(number)\n        digits = []\n        while current_num > 0:\n            digits.append(current_num % 10)\n            current_num //= 10\n        return digits\n\n    def _calculate_digit_difference(digit1: int, digit2: int) -> int:\n        \"\"\"\n        Calculates the absolute difference between two single digits.\n        \"\"\"\n        return abs(digit1 - digit2)\n\n    def _sum_differences(differences: list[int]) -> int:\n        \"\"\"\n        Calculates the sum of a list of integer differences.\n        \"\"\"\n        return sum(differences)\n\n    digits1 = _extract_digits(num1)\n    digits2 = _extract_digits(num2)\n\n    max_len = max(len(digits1), len(digits2))\n    \n    individual_differences = []\n    for i in range(max_len):\n        # Get corresponding digits, treating missing digits as zero.\n        d1 = digits1[i] if i < len(digits1) else 0\n        d2 = digits2[i] if i < len(digits2) else 0\n        \n        diff = _calculate_digit_difference(d1, d2)\n        individual_differences.append(diff)\n    \n    return _sum_differences(individual_differences)"}
{"task_id": "Mbpp/559", "solution": "import math\nfrom typing import List\n\ndef max_sub_array_sum(arr: List[int], n: int) -> int:\n    \"\"\"Finds the sum of the largest contiguous sublist using Kadane's algorithm.\n    It iterates through the array, tracking the maximum sum found so far and the current sum ending at the current position.\n    \"\"\"\n    max_so_far = -math.inf\n    current_max = 0\n\n    for x in arr:\n        current_max += x\n        if current_max > max_so_far:\n            max_so_far = current_max\n        if current_max < 0:\n            current_max = 0\n            \n    # Handle the case where all numbers are negative\n    # In such a case, the result should be the largest negative number.\n    # The above loop will result in max_so_far being the largest negative\n    # if current_max is initialized to 0. If current_max never becomes positive,\n    # max_so_far will eventually be the largest negative.\n    # If all numbers are negative and max_so_far is still -inf at the end\n    # (which can happen for an empty list, but we assume non-empty),\n    # this logic ensures the largest single element is returned.\n    if max_so_far == -math.inf: # This can happen if arr is empty\n        if not arr: return 0 # Or raise an error, based on context\n        return max(arr) # If all elements are negative, max_so_far would have updated to the largest negative\n\n    return max_so_far"}
{"task_id": "Mbpp/559", "solution": "```python\ndef max_sub_array_sum(arr: list[int], length: int) -> int:\n    \"\"\"\n    Finds the sum of the largest contiguous sublist using Kadane's algorithm.\n    The length parameter is unused as per typical Python list handling.\n    \"\"\"\n    if not arr:\n        return 0\n\n    max_so_far = arr[0]\n    current_max = arr[0]\n\n    for i in range(1, len(arr)):\n        current_max = max(arr[i], current_max + arr[i])\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far\n```"}
