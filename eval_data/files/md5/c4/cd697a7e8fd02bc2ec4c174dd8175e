{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(num1: int, num2: int) -> bool:\n    \"\"\"\n    Check if two numbers differ at exactly one bit position.\n    This is true if their XOR result is a power of two.\n    \"\"\"\n    xor_result = num1 ^ num2\n    # A number is a power of 2 if it's greater than 0 and has only one bit set.\n    # The expression `n & (n - 1) == 0` checks if only one bit is set.\n    return xor_result > 0 and (xor_result & (xor_result - 1)) == 0"}
{"task_id": "Mbpp/2", "solution": "def similar_elements(tuple1: tuple, tuple2: tuple) -> list:\n    \"\"\"\n    Finds the common elements between two given tuples.\n    Returns a list containing the shared elements.\n    \"\"\"\n    set1 = set(tuple1)\n    set2 = set(tuple2)\n    \n    common_elements = set1.intersection(set2)\n    \n    return list(common_elements)"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(num1: int, num2: int) -> bool:\n    \"\"\"\n    Check if two numbers differ at exactly one bit position.\n    \"\"\"\n    xor_result = num1 ^ num2\n    return xor_result != 0 and (xor_result & (xor_result - 1)) == 0"}
{"task_id": "Mbpp/4", "solution": "def _validate_inputs(numbers, n):\n    \"\"\"Validates input parameters.\n    Returns True, assuming valid inputs as per constraints.\n    \"\"\"\n    # Per constraints: \"Do NOT add isinstance() checks or raise exceptions for edge cases\"\n    # Therefore, this helper will always return True, assuming valid inputs are provided.\n    return True\n\ndef _find_n_largest(numbers, n):\n    \"\"\"Uses heap queue to efficiently find n largest elements.\"\"\"\n    import heapq\n    return heapq.nlargest(n, numbers)\n\ndef _sort_descending(numbers):\n    \"\"\"Sorts the given list of numbers in descending order.\"\"\"\n    # heapq.nlargest already returns in descending order, but this step\n    # strictly follows the design's sequence diagram and component responsibility.\n    return sorted(numbers, reverse=True)\n\ndef heap_queue_largest(numbers, n):\n    \"\"\"\n    Finds the n largest integers from a given list of numbers, returned in descending order.\n    \"\"\"\n    # 1. Input Validation Layer\n    # The _validate_inputs helper is called but, due to constraints, performs no actual validation.\n    _validate_inputs(numbers, n)\n\n    # 2. Processing Layer\n    # Uses heapq.nlargest to get the n largest elements.\n    # heapq.nlargest inherently returns elements in descending order.\n    largest_elements = _find_n_largest(numbers, n)\n\n    # 3. Output Layer\n    # Sorts the results in descending order. This step is redundant\n    # if _find_n_largest used heapq.nlargest directly, but adheres to the architectural design.\n    final_result = _sort_descending(largest_elements)\n\n    return final_result"}
{"task_id": "Mbpp/3", "solution": "def _is_prime_helper(n: int) -> bool:\n    \"\"\"Helper function to determine if a number is prime.\n    Returns True if n is prime, False otherwise.\"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n\ndef is_not_prime(number: int) -> bool:\n    \"\"\"Identifies non-prime numbers, returning True if not prime, False if prime.\"\"\"\n    if number < 2:\n        return True\n    \n    return not _is_prime_helper(number)"}
{"task_id": "Mbpp/4", "solution": "def heap_queue_largest(numbers_list, n):\n    \"\"\"\n    Finds the n largest integers from a given list of numbers, returned in descending order.\n    \"\"\"\n\n    import heapq\n\n    def _validate_input(numbers_list_val, n_val):\n        \"\"\"\n        Validates input parameters and handles trivial cases without heap processing.\n        Returns a tuple: (should_proceed_with_heap, result_if_not_proceeding).\n        \"\"\"\n        if not numbers_list_val or n_val <= 0:\n            return False, []\n        if n_val >= len(numbers_list_val):\n            # If n is greater than or equal to list length, sort all elements descending.\n            return False, sorted(numbers_list_val, reverse=True)\n        return True, None # Proceed with heap processing\n\n    def _process_with_heap(numbers_list_proc, n_proc):\n        \"\"\"\n        Implements a min-heap to efficiently find the n largest elements.\n        The heap always contains the n largest elements encountered so far.\n        \"\"\"\n        min_heap = []\n        for number in numbers_list_proc:\n            if len(min_heap) < n_proc:\n                heapq.heappush(min_heap, number)\n            elif number > min_heap[0]:\n                heapq.heapreplace(min_heap, number) # Replace smallest with current larger number\n        return min_heap\n\n    def _extract_and_sort(heap_extract):\n        \"\"\"\n        Extracts all elements from the heap and sorts them in descending order.\n        Elements are popped from a min-heap in ascending order, then reversed.\n        \"\"\"\n        result_list = []\n        while heap_extract:\n            result_list.append(heapq.heappop(heap_extract))\n        result_list.reverse() # Final result needs to be in descending order\n        return result_list\n\n    # Orchestrate the process\n    should_proceed, result_if_trivial = _validate_input(numbers_list, n)\n    if not should_proceed:\n        return result_if_trivial\n\n    heap_of_largest = _process_with_heap(numbers_list, n)\n    final_result = _extract_and_sort(heap_of_largest)\n\n    return final_result"}
