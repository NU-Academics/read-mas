{"task_id": "Mbpp/415", "solution": "def max_Product(arr):\n    # Finds the pair with the highest product from an array of integers using nested loops.\n    # It iterates through all unique pairs to determine the one with the maximum product.\n    max_product = float('-inf')\n    result_pair = None\n\n    n = len(arr)\n    for i in range(n):\n        for j in range(i + 1, n):\n            product = arr[i] * arr[j]\n            if product > max_product:\n                max_product = product\n                result_pair = (arr[i], arr[j])\n    \n    return result_pair"}
{"task_id": "Mbpp/415", "solution": "def max_Product(arr):\n    # This function finds a pair with the highest product from a given array of integers.\n    # It considers positive, negative, and zero values.\n    \n    if len(arr) < 2:\n        # According to the design, input will have at least 2 elements.\n        # This branch should ideally not be reached based on the design context.\n        return None \n\n    # Edge case: if there are only two elements, return them directly.\n    if len(arr) == 2:\n        return (arr[0], arr[1])\n\n    # The maximum product can come from:\n    # 1. The two largest positive numbers.\n    # 2. The two smallest (most negative) numbers (as their product would be positive and large).\n    # We need to find the two largest and two smallest numbers.\n\n    # Find the largest and second largest numbers.\n    # Find the smallest and second smallest numbers.\n    # Initialize with values from the array to handle cases with negative numbers correctly.\n    \n    # Initialize these in a way that allows us to find the actual min/max later\n    # Using float('-inf') and float('inf') for initial max/min values is a robust approach.\n    max1 = float('-inf')\n    max2 = float('-inf')\n    min1 = float('inf')\n    min2 = float('inf')\n\n    for x in arr:\n        if x > max1:\n            max2 = max1\n            max1 = x\n        elif x > max2:\n            max2 = x\n\n        if x < min1:\n            min2 = min1\n            min1 = x\n        elif x < min2:\n            min2 = x\n\n    # Calculate products of potential highest pairs\n    product1 = max1 * max2\n    product2 = min1 * min2\n\n    # Compare and return the pair with the highest product\n    if product1 >= product2:\n        return (max2, max1)\n    else:\n        return (min1, min2)"}
{"task_id": "Mbpp/419", "solution": "def round_and_sum(numbers):\n    \"\"\"\n    Rounds each number in a list, sums the rounded values, and multiplies by the list length.\n    Prints and returns the final calculated result.\n    \"\"\"\n    # Round each number to the nearest integer.\n    rounded_numbers = [round(num) for num in numbers]\n\n    # Calculate the sum of all rounded numbers.\n    sum_of_rounded = sum(rounded_numbers)\n\n    # Multiply the sum by the original list length.\n    list_length = len(numbers)\n    final_result = sum_of_rounded * list_length\n\n    # Print the final calculated result.\n    print(final_result)\n\n    # Return the final calculated result.\n    return final_result"}
{"task_id": "Mbpp/419", "solution": "def round_and_sum(numbers: list[float]) -> int:\n    \"\"\"\n    Rounds every number of a given list of numbers, calculates their sum,\n    and prints the total sum multiplied by the length of the list.\n    \"\"\"\n    \n    def round_numbers(numbers_list: list[float]) -> list[int]:\n        \"\"\"Rounds each number in the list to the nearest integer.\"\"\"\n        return [round(num) for num in numbers_list]\n\n    def calculate_sum(rounded_numbers_list: list[int]) -> int:\n        \"\"\"Calculates the sum of all rounded numbers.\"\"\"\n        return sum(rounded_numbers_list)\n\n    def multiply_by_length(sum_value: int, length: int) -> int:\n        \"\"\"Multiplies the sum by the length of the original list.\"\"\"\n        return sum_value * length\n\n    def print_result(result_val: int) -> None:\n        \"\"\"Prints the final result to stdout.\"\"\"\n        print(result_val)\n\n    def return_result(result_val: int) -> int:\n        \"\"\"Returns the final result value.\"\"\"\n        return result_val\n\n    original_length = len(numbers)\n    \n    rounded_nums = round_numbers(numbers)\n    \n    sum_of_rounded = calculate_sum(rounded_nums)\n    \n    final_result = multiply_by_length(sum_of_rounded, original_length)\n    \n    print_result(final_result)\n    \n    return return_result(final_result)"}
{"task_id": "Mbpp/420", "solution": "```python\ndef cube_Sum(n: int) -> int:\n    \"\"\"\n    Calculate the sum of cubes of first n even natural numbers.\n\n    Raises:\n        ValueError: If n is not a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    total_sum = 0\n    for i in range(1, n + 1):\n        even_number = 2 * i\n        total_sum += even_number ** 3\n    return total_sum\n```"}
