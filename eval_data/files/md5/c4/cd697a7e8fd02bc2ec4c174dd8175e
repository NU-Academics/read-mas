{"task_id": "Mbpp/751", "solution": "```python\ndef check_min_heap(arr: list) -> bool:\n    \"\"\"\n    Checks if the given array represents a min heap.\n    It iterates through the array and verifies the min-heap property for each node.\n    \"\"\"\n    n = len(arr)\n\n    # An empty array or an array with a single element is always a valid min heap.\n    if n <= 1:\n        return True\n\n    # Iterate from the first parent node that can have children up to the last parent.\n    # In a 0-indexed array, for a node at index i, its children are at 2*i + 1 and 2*i + 2.\n    # We only need to check nodes that have at least one child.\n    # The last potential parent node is at index (n // 2) - 1.\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child\n        if left_child_idx < n and arr[i] > arr[left_child_idx]:\n            return False\n\n        # Check right child\n        if right_child_idx < n and arr[i] > arr[right_child_idx]:\n            return False\n\n    return True\n```"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(array) -> bool:\n    \"\"\"\n    Check if the given array represents a min heap.\n    Time Complexity: O(n), Space Complexity: O(1).\n    \"\"\"\n    n = len(array)\n\n    if n <= 1:\n        return True\n\n    # Iterate only through potential parent nodes\n    # For a 0-indexed array, parents are at indices 0 to (n // 2) - 1\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child\n        if left_child_idx < n and array[i] > array[left_child_idx]:\n            return False\n\n        # Check right child\n        if right_child_idx < n and array[i] > array[right_child_idx]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/753", "solution": "def min_k(tuples, k):\n    \"\"\"\n    Finds the k tuples with the smallest second element values from a list of tuples.\n    The returned tuples are sorted in ascending order by their second element.\n    \"\"\"\n    if not tuples:\n        return []\n\n    # Sort the list of tuples based on the second element (the integer value)\n    # This ensures an O(n log n) time complexity for the sorting operation.\n    sorted_tuples = sorted(tuples, key=lambda x: x[1])\n\n    # Return the first k elements from the sorted list.\n    # If k is greater than the list length, it will return all available elements.\n    return sorted_tuples[:k]"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    # Calculates the nth Jacobsthal number using an iterative approach.\n    # The sequence starts with J(0)=0, J(1)=1, and follows J(n) = J(n-1) + 2*J(n-2).\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n    \n    a, b = 0, 1 # a = J(i-2), b = J(i-1)\n    for _ in range(2, n + 1):\n        current = b + 2 * a\n        a = b\n        b = current\n    return b"}
{"task_id": "Mbpp/753", "solution": "from typing import List, Tuple\n\ndef min_k(tuple_list: List[Tuple[str, int]], k: int) -> List[Tuple[str, int]]:\n    \"\"\"\n    Finds the k records with the smallest second element from a list of tuples.\n    The result is sorted in ascending order by the second element.\n    \"\"\"\n    sorted_records = sorted(tuple_list, key=lambda x: x[1])\n    return sorted_records[:k]"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"Calculates the nth Jacobsthal number using an iterative approach.\n    Raises ValueError for negative input n as per design requirements.\"\"\"\n    if n < 0:\n        raise ValueError(\"n must be a non-negative integer.\")\n    elif n == 0:\n        return 0\n    elif n == 1:\n        return 1\n    elif n == 2:\n        return 1\n    else:\n        # Initialize with J(1) and J(2)\n        j_n_minus_2 = 1  # Represents J(i-2)\n        j_n_minus_1 = 1  # Represents J(i-1)\n\n        for _ in range(3, n + 1):\n            j_current = j_n_minus_1 + 2 * j_n_minus_2\n            j_n_minus_2 = j_n_minus_1\n            j_n_minus_1 = j_current\n        return j_n_minus_1"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1: list, l2: list, l3: list) -> list:\n    \"\"\"\n    Finds elements that appear in all three lists under the same index.\n    The function returns a list of these common elements.\n    \"\"\"\n    min_length = min(len(l1), len(l2), len(l3))\n    result = []\n\n    for i in range(min_length):\n        if l1[i] == l2[i] == l3[i]:\n            result.append(l1[i])\n            \n    return result"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1, l2, l3):\n    \"\"\"\n    Finds elements that appear in all three lists under the same index.\n    Returns a list of such common elements in their original order.\n    \"\"\"\n    common_elements = []\n    min_length = min(len(l1), len(l2), len(l3))\n\n    for i in range(min_length):\n        if l1[i] == l2[i] and l2[i] == l3[i]:\n            common_elements.append(l1[i])\n\n    return common_elements"}
