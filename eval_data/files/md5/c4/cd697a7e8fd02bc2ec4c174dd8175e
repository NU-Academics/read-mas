{"task_id": "Mbpp/605", "solution": "def prime_num(n: int) -> bool:\n    \"\"\"Checks if a given integer is a prime number.\n    Returns True for prime numbers and False for non-prime numbers.\"\"\"\n    if n <= 1:\n        return False\n    if n == 2 or n == 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True"}
{"task_id": "Mbpp/603", "solution": "def get_ludic(n: int) -> list[int]:\n    \"\"\"\n    Generate all lucid numbers smaller than or equal to n.\n\n    Args:\n        n (int): Upper limit for lucid number generation\n\n    Returns:\n        List[int]: List of lucid numbers in ascending order\n    \"\"\"\n\n    def _validate_input(limit: int) -> bool:\n        \"\"\"Validates the input integer.\"\"\"\n        return limit >= 0\n\n    def _generate_ludic_sequence(limit: int) -> list[int]:\n        \"\"\"Generates lucid numbers up to the given limit using a sieve algorithm.\"\"\"\n        if limit <= 0:\n            return []\n\n        candidates = list(range(1, limit + 1))\n        ludic = []\n\n        while candidates:\n            p = candidates.pop(0)\n            ludic.append(p)\n\n            if p == 1:\n                continue\n\n            # Sieve: remove every p-th element from the remaining candidates list\n            new_candidates = []\n            count = 0\n            for x in candidates:\n                count += 1\n                if count % p != 0:\n                    new_candidates.append(x)\n            candidates = new_candidates\n        return ludic\n\n    if not _validate_input(n):\n        return []\n    \n    return _generate_ludic_sequence(n)"}
{"task_id": "Mbpp/605", "solution": "def prime_num(n: int) -> bool:\n    \"\"\"\n    Check if the given integer is a prime number using an optimized trial division method.\n    Handles base cases and efficiently checks for divisors up to the square root of n.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:  # 2 and 3 are prime\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True"}
{"task_id": "Mbpp/606", "solution": "import math\n\ndef radian_degree(degrees: float) -> float:\n    \"\"\"\n    Converts an angle from degrees to radians using the formula: radians = degrees * (pi / 180).\n    \"\"\"\n    return degrees * (math.pi / 180)"}
{"task_id": "Mbpp/603", "solution": "def _generate_initial_sequence(limit: int) -> list[int]:\n    \"\"\"Generate initial sequence of natural numbers from 1 to limit.\"\"\"\n    return list(range(1, limit + 1))\n\ndef _apply_ludic_sieve(numbers: list[int]) -> list[int]:\n    \"\"\"Apply the ludic sieve algorithm to filter ludic numbers.\"\"\"\n    ludic_numbers = []\n    candidates = numbers[:]\n\n    while candidates:\n        next_ludic = candidates[0]\n        ludic_numbers.append(next_ludic)\n\n        candidates.pop(0)\n\n        if not candidates:\n            break\n\n        if next_ludic == 1:\n            continue\n\n        indices_to_remove = []\n        current_idx = next_ludic - 1\n        while current_idx < len(candidates):\n            indices_to_remove.append(current_idx)\n            current_idx += next_ludic\n\n        for i in reversed(indices_to_remove):\n            if i < len(candidates):\n                candidates.pop(i)\n    return ludic_numbers\n\ndef get_ludic(n: int) -> list[int]:\n    \"\"\"Generate all ludic numbers less than or equal to n.\"\"\"\n    if n < 1:\n        return []\n\n    initial_sequence = _generate_initial_sequence(n)\n    return _apply_ludic_sieve(initial_sequence)"}
{"task_id": "Mbpp/606", "solution": "def radian_degree(degrees):\n    \"\"\"\n    Converts an angle from degrees to radians using the formula: radians = degrees \u00d7 (\u03c0/180).\n    Uses a high-precision value for PI.\n    \"\"\"\n    PI = 3.141592653589793\n    radians = degrees * (PI / 180)\n    return radians"}
{"task_id": "Mbpp/608", "solution": "def bell_Number(n: int) -> int:\n    \"\"\"Calculates the nth Bell number using the Bell triangle algorithm.\"\"\"\n    # Create a 2D array (Bell triangle) to store intermediate values.\n    bell = [[0 for _ in range(n + 1)] for _ in range(n + 1)]\n\n    # Initialize the first element of the Bell triangle.\n    bell[0][0] = 1\n\n    # Fill the Bell triangle row by row.\n    for i in range(1, n + 1):\n        # The first element of each row is the last element of the previous row.\n        bell[i][0] = bell[i - 1][i - 1]\n        # Fill the rest of the current row using the recurrence relation.\n        for j in range(1, i + 1):\n            bell[i][j] = bell[i - 1][j - 1] + bell[i][j - 1]\n\n    # The nth Bell number is the first element of the nth row.\n    return bell[n][0]"}
{"task_id": "Mbpp/607", "solution": "import re\n\ndef find_literals(text: str, pattern: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Search for a regex pattern in a string and return the matching substring, start, and end indices.\n    Returns None if no match is found.\n    \"\"\"\n    match = re.search(pattern, text)\n    if match:\n        return (match.group(0), match.start(), match.end())\n    return None"}
{"task_id": "Mbpp/608", "solution": "def bell_Number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Bell number using the Bell triangle method.\n    The Bell numbers count the number of partitions of a set with n elements.\n    \"\"\"\n    # Initialize the Bell triangle as a list of lists.\n    # bell_triangle[i][j] will store the j-th element of the i-th row.\n    bell_triangle = [[0] * (i + 1) for i in range(n + 1)]\n\n    # The base case: the 0th Bell number is 1.\n    bell_triangle[0][0] = 1\n\n    # Fill the Bell triangle row by row.\n    for i in range(1, n + 1):\n        # The first element of the current row is the last element of the previous row.\n        bell_triangle[i][0] = bell_triangle[i-1][i-1]\n\n        # Fill the remaining elements of the current row.\n        for j in range(1, i + 1):\n            # Each element is the sum of the element to its left in the current row\n            # and the element diagonally up-left from the previous row.\n            bell_triangle[i][j] = bell_triangle[i][j-1] + bell_triangle[i-1][j-1]\n\n    # The nth Bell number is the first element of the nth row in the triangle.\n    return bell_triangle[n][0]"}
