{"task_id": "Mbpp/20", "solution": "def is_woodall(number: int) -> bool:\n    \"\"\"Checks if the given number is a Woodall number.\"\"\"\n    if number < 7:  # Smallest Woodall number (1*2^1 - 1 = 1, 2*2^2 - 1 = 7)\n        return number == 1\n\n    # We need to find if there exists an integer n > 0 such that n * 2^n - 1 == number\n    # Iterate n starting from 1 until n * 2^n - 1 either equals `number` or exceeds it.\n    n = 1\n    while True:\n        woodall_candidate = n * (2**n) - 1\n        if woodall_candidate == number:\n            return True\n        elif woodall_candidate > number:\n            return False\n        n += 1"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(number: int) -> bool:\n    \"\"\"Main function to check if number is a Woodall number.\n    It determines if the number can be expressed as n * 2^n - 1 for some positive integer n.\n    \"\"\"\n\n    def _calculate_woodall_value(n: int) -> int:\n        \"\"\"Calculate n \u00d7 2^n - 1 for a given positive integer n.\"\"\"\n        return n * (2**n) - 1\n\n    def _find_woodall_n(target: int) -> bool:\n        \"\"\"Search for a positive integer n such that n \u00d7 2^n - 1 equals the target.\"\"\"\n        n = 1\n        while True:\n            woodall_num = _calculate_woodall_value(n)\n            if woodall_num == target:\n                return True\n            elif woodall_num > target:\n                # Woodall numbers strictly increase with n, so no further n will match.\n                return False\n            n += 1\n\n    if number <= 0:\n        return False\n    return _find_woodall_n(number)"}
{"task_id": "Mbpp/56", "solution": "def check(number):\n    \"\"\"\n    Checks if a given number is one less than twice its reverse.\n    \"\"\"\n    def _reverse_digits(n):\n        \"\"\"\n        Reverses the digits of a non-negative integer.\n        For example, _reverse_digits(70) returns 7.\n        \"\"\"\n        return int(str(n)[::-1])\n\n    reversed_num = _reverse_digits(number)\n    return number == (2 * reversed_num) - 1"}
{"task_id": "Mbpp/56", "solution": "def check(number: int) -> bool:\n    \"\"\"\n    Checks if the given number is one less than twice its reverse.\n    \"\"\"\n    def reverse_number(num_to_reverse: int) -> int:\n        \"\"\"Reverses the digits of an integer.\"\"\"\n        return int(str(num_to_reverse)[::-1])\n\n    def calculate_twice_reverse(reversed_val: int) -> int:\n        \"\"\"Calculates twice the value of the reversed number.\"\"\"\n        return reversed_val * 2\n\n    reversed_num = reverse_number(number)\n    twice_reversed_num = calculate_twice_reverse(reversed_num)\n\n    return number == (twice_reversed_num - 1)"}
