{"task_id": "Mbpp/109", "solution": "def odd_Equivalent(binary_str: str, rotations: int) -> int:\n    \"\"\"\n    Main function to find the number of odd decimal values when rotating a binary string.\n    It orchestrates string rotation, binary-to-decimal conversion, and odd detection.\n    \"\"\"\n    def _rotate_left(s: str) -> str:\n        \"\"\"Helper function to perform a single left rotation on a string.\"\"\"\n        if not s:\n            return s\n        return s[1:] + s[0]\n\n    def _binary_to_decimal(s: str) -> int:\n        \"\"\"Helper function to convert a binary string to its decimal integer.\"\"\"\n        if not s:\n            return 0\n        return int(s, 2)\n\n    def _is_odd(number: int) -> bool:\n        \"\"\"Helper function to determine if a number is odd.\"\"\"\n        return number % 2 != 0\n\n    odd_count = 0\n    current_binary = binary_str\n\n    for _ in range(rotations):\n        current_binary = _rotate_left(current_binary)\n        decimal_value = _binary_to_decimal(current_binary)\n        if _is_odd(decimal_value):\n            odd_count += 1\n    return odd_count"}
{"task_id": "Mbpp/109", "solution": "def rotate_left(binary_str: str) -> str:\n    \"\"\"Performs a single left rotation on a binary string.\"\"\"\n    if not binary_str:\n        return \"\"\n    return binary_str[1:] + binary_str[0]\n\ndef binary_to_decimal(binary_str: str) -> int:\n    \"\"\"Converts a binary string to its decimal integer equivalent.\"\"\"\n    return int(binary_str, 2)\n\ndef is_odd(value: int) -> bool:\n    \"\"\"Determines if an integer value is odd.\"\"\"\n    return value % 2 != 0\n\ndef odd_Equivalent(binary_string: str, rotations: int) -> int:\n    \"\"\"\n    Finds the number of odd decimal values when a binary string is rotated\n    a given number of times.\n    \"\"\"\n    odd_count = 0\n    current_string = binary_string\n\n    for _ in range(rotations):\n        decimal_value = binary_to_decimal(current_string)\n        if is_odd(decimal_value):\n            odd_count += 1\n        current_string = rotate_left(current_string)\n    \n    return odd_count"}
{"task_id": "Mbpp/111", "solution": "def common_in_nested_lists(nested_lists: list[list[int]]) -> list[int]:\n    \"\"\"Finds elements common to all sublists in a nested list using set intersection.\"\"\"\n    if not nested_lists:\n        return []\n\n    # Convert the first sublist to a set to start the intersection\n    common_elements_set = set(nested_lists[0])\n\n    # Intersect with the remaining sublists\n    for sublist in nested_lists[1:]:\n        common_elements_set = common_elements_set.intersection(sublist)\n        # Optimization: if at any point common_elements_set becomes empty,\n        # no further intersection is needed.\n        if not common_elements_set:\n            return []\n\n    return list(common_elements_set)"}
{"task_id": "Mbpp/113", "solution": "def check_integer(input_string: str) -> bool:\n    \"\"\"Checks if a string represents an integer, handling signs and whitespace.\"\"\"\n    stripped_s = input_string.strip()\n\n    # An empty string or a string consisting only of whitespace is not an integer.\n    if not stripped_s:\n        return False\n\n    # Handle optional leading sign.\n    if stripped_s[0] == '-' or stripped_s[0] == '+':\n        # If there's a sign, the remaining part must be all digits and not empty.\n        if len(stripped_s) == 1:\n            return False  # String is just \"+\" or \"-\"\n        return stripped_s[1:].isdigit()\n    else:\n        # If there's no sign, the entire string must be all digits.\n        return stripped_s.isdigit()"}
{"task_id": "Mbpp/111", "solution": "def common_in_nested_lists(nested_lists: list[list[int]]) -> list[int]:\n    \"\"\"\n    Finds common elements in given nested lists.\n    Returns a list of elements present in all inner lists.\n    \"\"\"\n\n    def _handle_empty_lists(lists: list[list[int]]) -> bool:\n        \"\"\"Checks if any inner list is empty.\"\"\"\n        for lst in lists:\n            if not lst:\n                return True\n        return False\n\n    def _handle_single_list(lists: list[list[int]]) -> list[int] | None:\n        \"\"\"Returns elements if only one list is present.\"\"\"\n        if len(lists) == 1:\n            return lists[0]\n        return None \n\n    def _find_intersection(lists: list[list[int]]) -> list[int]:\n        \"\"\"Finds the intersection of all sets from the lists.\"\"\"\n        common_set = set(lists[0])\n        for i in range(1, len(lists)):\n            common_set.intersection_update(set(lists[i]))\n        return list(common_set)\n\n    if not nested_lists:\n        return []\n\n    if _handle_empty_lists(nested_lists):\n        return []\n\n    single_list_result = _handle_single_list(nested_lists)\n    if single_list_result is not None:\n        return single_list_result\n    \n    return _find_intersection(nested_lists)"}
