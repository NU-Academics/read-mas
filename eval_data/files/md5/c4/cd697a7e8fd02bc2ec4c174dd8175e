{"task_id": "Mbpp/635", "solution": "def heap_sort(input_list):\n    \"\"\"\n    Sorts a list using the heap sort algorithm.\n    Returns a new sorted list in ascending order.\n    \"\"\"\n    arr = input_list.copy()\n    n = len(arr)\n\n    # Helper function to swap two elements in the array\n    def _swap_elements(arr, i, j):\n        arr[i], arr[j] = arr[j], arr[i]\n\n    # Helper function to maintain the heap property in a subtree rooted at index i\n    def _heapify(arr, n, i):\n        largest = i  # Initialize largest as root\n        left = 2 * i + 1  # left child\n        right = 2 * i + 2  # right child\n\n        # See if left child of root exists and is greater than root\n        if left < n and arr[left] > arr[largest]:\n            largest = left\n\n        # See if right child of root exists and is greater than current largest\n        if right < n and arr[right] > arr[largest]:\n            largest = right\n\n        # Change root, if needed\n        if largest != i:\n            _swap_elements(arr, i, largest)\n            # Heapify the root.\n            _heapify(arr, n, largest)\n\n    # Helper function to build a max heap from the array\n    def _build_max_heap(arr):\n        # Build a maxheap.\n        # Starting from the last non-leaf node (n//2 - 1) up to the root (0)\n        for i in range(n // 2 - 1, -1, -1):\n            _heapify(arr, n, i)\n\n    # Build a maxheap from the input array\n    _build_max_heap(arr)\n\n    # One by one extract elements from the heap\n    for i in range(n - 1, 0, -1):\n        # Move current root to end\n        _swap_elements(arr, 0, i)\n        # Call _heapify on the reduced heap\n        _heapify(arr, i, 0)\n\n    return arr"}
{"task_id": "Mbpp/639", "solution": "def sample_nam(names):\n    \"\"\"\n    Sums the length of names after filtering out those starting with a lowercase letter.\n    Helper functions _is_valid_name and _calculate_total_length are used for modularity.\n    \"\"\"\n\n    def _is_valid_name(name):\n        \"\"\"Checks if a name starts with an uppercase letter.\"\"\"\n        return bool(name) and name[0].isupper()\n\n    def _calculate_total_length(names_list):\n        \"\"\"Calculates the sum of lengths for a list of names.\"\"\"\n        total_length = 0\n        for name in names_list:\n            total_length += len(name)\n        return total_length\n\n    valid_names = []\n    for name in names:\n        if _is_valid_name(name):\n            valid_names.append(name)\n\n    return _calculate_total_length(valid_names)"}
{"task_id": "Mbpp/638", "solution": "def wind_chill(wind_velocity, temperature):\n    \"\"\"\n    Calculates the wind chill index using the standard meteorological formula.\n    The result is rounded to the nearest integer.\n    \"\"\"\n    # Calculate the V^0.16 term using the exponentiation operator.\n    term_v_power = wind_velocity**0.16\n    \n    # Apply the Environment Canada wind chill formula.\n    raw_wind_chill = (\n        13.12\n        + (0.6215 * temperature)\n        - (11.37 * term_v_power)\n        + (0.3965 * temperature * term_v_power)\n    )\n    \n    # Round the calculated index to the nearest integer.\n    return round(raw_wind_chill)"}
{"task_id": "Mbpp/638", "solution": "def wind_chill(velocity: float, temperature: float) -> int:\n    \"\"\"\n    Calculates the wind chill index rounded to the next integer given the wind velocity in km/h and a temperature in celsius.\n    Uses the Environment Canada wind chill formula and standard rounding.\n    \"\"\"\n    # Wind chill formula: WCI = 13.12 + 0.6215 * T - 11.37 * V^0.16 + 0.3965 * T * V^0.16\n    # Where T is temperature in Celsius and V is wind speed in km/h.\n\n    v_raised_to_0_16 = velocity**0.16\n    \n    calculated_wind_chill = (\n        13.12\n        + 0.6215 * temperature\n        - 11.37 * v_raised_to_0_16\n        + 0.3965 * temperature * v_raised_to_0_16\n    )\n    \n    # Round the calculated result to the nearest integer.\n    rounded_wind_chill = round(calculated_wind_chill)\n    \n    return int(rounded_wind_chill)"}
