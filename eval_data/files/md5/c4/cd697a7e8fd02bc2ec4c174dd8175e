{"task_id": "Mbpp/123", "solution": "def amicable_numbers_sum(upper_limit: int) -> int:\n    \"\"\"\n    Calculates the sum of all amicable numbers up to a specified upper limit.\n    It identifies amicable pairs (a, b) where sum_of_proper_divisors(a) == b and sum_of_proper_divisors(b) == a, and a != b.\n    \"\"\"\n\n    def get_proper_divisors(n: int) -> list[int]:\n        \"\"\"Calculates all proper divisors of a given number n.\"\"\"\n        if n <= 1:\n            return []\n        divisors = [1]\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                divisors.append(i)\n                if i * i != n:\n                    divisors.append(n // i)\n        return sorted(divisors)\n\n    def sum_of_divisors(n: int) -> int:\n        \"\"\"Calculates the sum of proper divisors of a number n.\"\"\"\n        return sum(get_proper_divisors(n))\n\n    def is_amicable_pair(a: int, b: int) -> bool:\n        \"\"\"Checks if two numbers form an amicable pair.\"\"\"\n        return a != b and sum_of_divisors(a) == b and sum_of_divisors(b) == a\n\n    def find_amicable_numbers(upper_limit: int) -> set[int]:\n        \"\"\"Finds all amicable numbers within the specified range.\"\"\"\n        amicable_set = set()\n        for n in range(1, upper_limit + 1):\n            sum_n = sum_of_divisors(n)\n            if sum_n > n and sum_n <= upper_limit:  # Optimization: check only one number of the pair once\n                if is_amicable_pair(n, sum_n):\n                    amicable_set.add(n)\n                    amicable_set.add(sum_n)\n        return amicable_set\n\n    amicable_numbers = find_amicable_numbers(upper_limit)\n    return sum(amicable_numbers)"}
{"task_id": "Mbpp/120", "solution": "def _calculate_absolute_product(tuple_pair: tuple) -> float:\n    \"\"\"\n    Calculate absolute product of two numbers in a tuple.\n    \"\"\"\n    if not isinstance(tuple_pair, tuple) or len(tuple_pair) != 2:\n        raise ValueError(\"Each item in the list must be a tuple of exactly two elements.\")\n    \n    a, b = tuple_pair\n    if not isinstance(a, (int, float)) or not isinstance(b, (int, float)):\n        raise TypeError(\"Tuple elements must be numeric (int or float).\")\n    \n    return abs(float(a) * float(b))\n\ndef _validate_input(tuple_list: list) -> None:\n    \"\"\"\n    Validate input list structure and content.\n    \"\"\"\n    if not isinstance(tuple_list, list):\n        raise ValueError(\"Input must be a list of tuples.\")\n    \n    for item in tuple_list:\n        _calculate_absolute_product(item) # This call implicitly validates tuple structure and element types.\n\ndef max_product_tuple(tuple_list: list) -> float:\n    \"\"\"\n    Find maximum absolute product between numbers in pairs of tuples.\n    \"\"\"\n    _validate_input(tuple_list)\n\n    if not tuple_list:\n        return 0.0 \n\n    max_abs_product = -float('inf')\n    for tup in tuple_list:\n        current_abs_product = _calculate_absolute_product(tup)\n        if current_abs_product > max_abs_product:\n            max_abs_product = current_abs_product\n            \n    return max_abs_product"}
{"task_id": "Mbpp/123", "solution": "def amicable_numbers_sum(upper_limit: int) -> int:\n    \"\"\"\n    Calculates the sum of all amicable numbers from 1 up to the specified upper limit.\n    This function includes helper functions defined inline to perform divisor calculations and amicable pair checks.\n    \"\"\"\n    import math\n\n    def sum_proper_divisors(n: int) -> int:\n        \"\"\"Calculates the sum of proper divisors for a given number n.\"\"\"\n        if n <= 1:\n            return 0\n        sum_divs = 1  # 1 is always a proper divisor for n > 1\n        for i in range(2, int(math.sqrt(n)) + 1):\n            if n % i == 0:\n                sum_divs += i\n                if i * i != n:\n                    sum_divs += (n // i)\n        return sum_divs\n\n    def is_amicable_pair(n: int, m: int) -> bool:\n        \"\"\"Checks if two numbers n and m form an amicable pair.\"\"\"\n        return n != m and sum_proper_divisors(n) == m and sum_proper_divisors(m) == n\n\n    def find_amicable_numbers(upper_limit: int) -> list[int]:\n        \"\"\"Identifies all amicable numbers within the specified range.\"\"\"\n        amicable_numbers_found = set()\n        for n in range(1, upper_limit + 1):\n            if n in amicable_numbers_found:\n                continue\n\n            sum_of_divs_n = sum_proper_divisors(n)\n\n            # A potential amicable partner 'm' must be within the limit and not be n itself.\n            if sum_of_divs_n > 0 and sum_of_divs_n <= upper_limit:\n                if is_amicable_pair(n, sum_of_divs_n):\n                    amicable_numbers_found.add(n)\n                    amicable_numbers_found.add(sum_of_divs_n)\n                    \n        return sorted(list(amicable_numbers_found))\n\n    amicable_nums = find_amicable_numbers(upper_limit)\n    return sum(amicable_nums)"}
{"task_id": "Mbpp/125", "solution": "def find_length(binary_string: str) -> int:\n    \"\"\"\n    Find maximum difference between 0s and 1s in any substring.\n\n    Args:\n        binary_string: String containing only '0' and '1' characters\n\n    Returns:\n        Maximum difference found among all substrings\n\n    Raises:\n        ValueError: If input contains non-binary characters\n    \"\"\"\n    # Validate that the string contains only '0' and '1' characters.\n    for char in binary_string:\n        if char not in ('0', '1'):\n            raise ValueError(\"Invalid binary string: contains non-binary characters.\")\n\n    max_diff = 0\n    n = len(binary_string)\n\n    # Iterate through all possible starting positions (i) for a substring.\n    for i in range(n):\n        num_zeros = 0\n        num_ones = 0\n        # Iterate through all possible ending positions (j) for the current starting position.\n        for j in range(i, n):\n            # Extend the current substring by one character.\n            if binary_string[j] == '0':\n                num_zeros += 1\n            else: # binary_string[j] == '1'\n                num_ones += 1\n            \n            # Calculate the absolute difference for the current substring.\n            current_diff = abs(num_zeros - num_ones)\n            \n            # Update the maximum difference found so far.\n            if current_diff > max_diff:\n                max_diff = current_diff\n                \n    return max_diff"}
{"task_id": "Mbpp/125", "solution": "def find_length(binary_string: str) -> int:\n    # Convert the binary string to an array where '0' is 1 and '1' is -1.\n    # This transforms the problem into finding the maximum subarray sum (Kadane's algorithm).\n    nums = []\n    for char in binary_string:\n        if char == '0':\n            nums.append(1)\n        else:  # char == '1'\n            nums.append(-1)\n\n    max_so_far = 0\n    current_max = 0\n\n    # Apply Kadane's algorithm to find the maximum sum of a contiguous subarray.\n    for num in nums:\n        current_max += num\n        if current_max < 0:\n            current_max = 0\n        if current_max > max_so_far:\n            max_so_far = current_max\n\n    return max_so_far"}
{"task_id": "Mbpp/126", "solution": "def sum(num1, num2):\n    \"\"\"\n    Finds the sum of common divisors of two given numbers.\n    \"\"\"\n    def _find_divisors(number):\n        \"\"\"\n        Finds all divisors of a given number.\n        \"\"\"\n        divs = []\n        for i in range(1, number + 1):\n            if number % i == 0:\n                divs.append(i)\n        return divs\n\n    divisors1 = _find_divisors(num1)\n    divisors2 = _find_divisors(num2)\n\n    common_divisors = []\n    for d1 in divisors1:\n        if d1 in divisors2:\n            common_divisors.append(d1)\n            \n    return sum(common_divisors)"}
