{"task_id": "Mbpp/620", "solution": "def largest_subset(numbers):\n    \"\"\"\n    Finds the size of the largest subset of a list of numbers so that every pair is divisible.\n    This uses a dynamic programming approach after sorting the input numbers.\n    \"\"\"\n    if not numbers:\n        return 0\n\n    sorted_numbers = sorted(numbers)\n    n = len(sorted_numbers)\n    \n    # dp[i] stores the length of the largest divisible subset ending with sorted_numbers[i].\n    dp = [1] * n\n\n    for i in range(n):\n        for j in range(i):\n            # If sorted_numbers[i] is divisible by sorted_numbers[j],\n            # we can potentially extend the subset ending at sorted_numbers[j].\n            if sorted_numbers[i] % sorted_numbers[j] == 0:\n                dp[i] = max(dp[i], dp[j] + 1)\n\n    # The maximum value in the dp array is the size of the largest divisible subset.\n    return max(dp)"}
{"task_id": "Mbpp/619", "solution": "def _is_numeric_char(char: str) -> bool:\n    \"\"\"Determine if a single character is numeric (0-9).\"\"\"\n    return char.isdigit()\n\ndef _extract_numeric_chars(input_string: str) -> str:\n    \"\"\"Extract all numeric characters (0-9) while preserving order.\"\"\"\n    numeric_chars = []\n    for char in input_string:\n        if _is_numeric_char(char):\n            numeric_chars.append(char)\n    return \"\".join(numeric_chars)\n\ndef _extract_non_numeric_chars(input_string: str) -> str:\n    \"\"\"Extract all non-numeric characters while preserving order.\"\"\"\n    non_numeric_chars = []\n    for char in input_string:\n        if not _is_numeric_char(char):\n            non_numeric_chars.append(char)\n    return \"\".join(non_numeric_chars)\n\ndef move_num(input_string: str) -> str:\n    \"\"\"\n    Moves all numeric characters to the end of the given string,\n    preserving the relative order of both non-numeric and numeric characters.\n    \"\"\"\n    non_numeric_part = _extract_non_numeric_chars(input_string)\n    numeric_part = _extract_numeric_chars(input_string)\n    return non_numeric_part + numeric_part"}
{"task_id": "Mbpp/622", "solution": "def get_median(list1: list, list2: list, size: int) -> float:\n    \"\"\"Calculates the median of two sorted lists of the same size by merging and then finding the median.\"\"\"\n\n    def merge_sorted_lists(l1: list, l2: list) -> list:\n        \"\"\"Merges two sorted lists into a single sorted list.\"\"\"\n        merged_list = []\n        i, j = 0, 0\n        n1, n2 = len(l1), len(l2)\n\n        while i < n1 and j < n2:\n            if l1[i] <= l2[j]:\n                merged_list.append(l1[i])\n                i += 1\n            else:\n                merged_list.append(l2[j])\n                j += 1\n\n        while i < n1:\n            merged_list.append(l1[i])\n            i += 1\n        while j < n2:\n            merged_list.append(l2[j])\n            j += 1\n        return merged_list\n\n    def find_median_from_merged(merged_l: list) -> float:\n        \"\"\"Calculates the median from a single sorted list.\"\"\"\n        n = len(merged_l)\n        if n % 2 == 1:\n            return float(merged_l[n // 2])\n        else:\n            mid1 = merged_l[n // 2 - 1]\n            mid2 = merged_l[n // 2]\n            return (float(mid1) + float(mid2)) / 2.0\n\n    merged = merge_sorted_lists(list1, list2)\n    median = find_median_from_merged(merged)\n    return median"}
