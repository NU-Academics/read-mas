{"task_id": "Mbpp/71", "solution": "def comb_sort(arr: list) -> list:\n    \"\"\"Sorts a list of elements in ascending order using the comb sort algorithm.\"\"\"\n    n = len(arr)\n    if n == 0:\n        return []\n\n    arr_copy = list(arr)\n    gap = n\n    swapped = True\n\n    while gap > 1 or swapped:\n        # Shrink gap by factor of 1.3 as specified in the design.\n        gap = max(1, (gap * 10) // 13)\n        swapped = False\n\n        # Perform a single pass similar to bubble sort with the current gap.\n        for i in range(n - gap):\n            if arr_copy[i] > arr_copy[i + gap]:\n                arr_copy[i], arr_copy[i + gap] = arr_copy[i + gap], arr_copy[i]\n                swapped = True\n    return arr_copy"}
{"task_id": "Mbpp/74", "solution": "def is_samepatterns(array1, array2):\n    \"\"\"\n    Checks if two arrays follow the same structural pattern.\n    Compares element relationships (same or different) at corresponding positions.\n    \"\"\"\n    if len(array1) != len(array2):\n        return False\n\n    if not array1:  # Both arrays are empty at this point due to length check\n        return True\n\n    mapping1 = {}\n    next_char1 = 'a'\n    pattern1 = []\n\n    for item in array1:\n        if item not in mapping1:\n            mapping1[item] = next_char1\n            next_char1 = chr(ord(next_char1) + 1)\n        pattern1.append(mapping1[item])\n\n    mapping2 = {}\n    next_char2 = 'a'\n    pattern2 = []\n\n    for item in array2:\n        if item not in mapping2:\n            mapping2[item] = next_char2\n            next_char2 = chr(ord(next_char2) + 1)\n        pattern2.append(mapping2[item])\n\n    return pattern1 == pattern2"}
{"task_id": "Mbpp/75", "solution": "def find_tuples(tuple_list, k):\n    \"\"\"\n    Find tuples where all elements are divisible by k from the given list of tuples.\n    This function processes each tuple to check if all its elements are perfectly divisible by k.\n    \"\"\"\n\n    def is_all_divisible(tuple_item, k_divisor):\n        \"\"\"Check if all elements in a tuple are divisible by the given divisor k_divisor.\"\"\"\n        for element in tuple_item:\n            if element % k_divisor != 0:\n                return False\n        return True\n\n    result_tuples = []\n    for current_tuple in tuple_list:\n        if is_all_divisible(current_tuple, k):\n            result_tuples.append(current_tuple)\n    return result_tuples"}
{"task_id": "Mbpp/74", "solution": "def is_samepatterns(array1: list, array2: list) -> bool:\n    \"\"\"\n    Checks if two arrays follow the same structural pattern based on element repetition.\n    \"\"\"\n\n    def _extract_pattern(array: list) -> list:\n        \"\"\"\n        Extracts a pattern representation from an array by mapping unique elements to integers.\n        \"\"\"\n        mapping = {}\n        pattern_list = []\n        next_code = 0\n        for element in array:\n            if element not in mapping:\n                mapping[element] = next_code\n                next_code += 1\n            pattern_list.append(mapping[element])\n        return pattern_list\n\n    def _validate_arrays(array1: list, array2: list) -> bool:\n        \"\"\"\n        Validates if two arrays have the same length for pattern comparison.\n        \"\"\"\n        return len(array1) == len(array2)\n\n    if not _validate_arrays(array1, array2):\n        return False\n\n    pattern1 = _extract_pattern(array1)\n    pattern2 = _extract_pattern(array2)\n\n    return pattern1 == pattern2"}
{"task_id": "Mbpp/75", "solution": "def find_tuples(tuple_list, k):\n    \"\"\"\n    Filters a list of tuples, keeping only those where all elements are divisible by k.\n    Assumes valid input types and k != 0 as per design constraints.\n    \"\"\"\n    \n    def is_divisible(element, k):\n        return element % k == 0\n\n    def check_all_divisible(tup, k):\n        for element in tup:\n            if not is_divisible(element, k):\n                return False\n        return True\n\n    result = []\n    for tup in tuple_list:\n        if check_all_divisible(tup, k):\n            result.append(tup)\n    return result"}
