{"task_id": "Mbpp/9", "solution": "def find_Rotations(s: str) -> int:\n    \"\"\"\n    Calculates the minimum number of rotations (greater than 0) required\n    to get the same string.\n    \"\"\"\n    def _validate_input(s_local: str) -> tuple[bool, int]:\n        \"\"\"\n        Validates input string and handles edge cases for empty or single-character strings.\n        Returns (False, result) for edge cases, (True, 0) otherwise.\n        \"\"\"\n        n = len(s_local)\n        if n == 0 or n == 1:\n            return (False, 1)\n        return (True, 0)\n\n    def _calculate_period(s_local: str) -> int:\n        \"\"\"\n        Calculates the smallest period of the string.\n        The period is the length of the shortest substring that can be repeated\n        to form the original string.\n        \"\"\"\n        n = len(s_local)\n        for d in range(1, n + 1):\n            if n % d == 0:\n                # Check if the string is formed by repeating the prefix of length d\n                if s_local == s_local[0:d] * (n // d):\n                    return d\n        return n # Fallback, should always find a period by d=n\n\n    is_valid, edge_case_result = _validate_input(s)\n    if not is_valid:\n        return edge_case_result\n    \n    return _calculate_period(s)"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string: str, character: str) -> str:\n    \"\"\"Remove first and last occurrence of character from string.\n    If the character appears less than twice, it removes at most one occurrence.\"\"\"\n    first_idx = input_string.find(character)\n    \n    if first_idx == -1:\n        return input_string\n\n    last_idx = input_string.rfind(character)\n\n    if first_idx == last_idx:\n        # Only one occurrence\n        return input_string[:first_idx] + input_string[first_idx + 1:]\n    else:\n        # Multiple occurrences, remove last then first to maintain original first_idx\n        temp_string = input_string[:last_idx] + input_string[last_idx + 1:]\n        return temp_string[:first_idx] + temp_string[first_idx + 1:]"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(string: str, character: str) -> str:\n    \"\"\"Removes the first and last occurrence of a given character from the string.\"\"\"\n    first_index = string.find(character)\n    if first_index == -1:\n        return string\n\n    last_index = string.rfind(character)\n\n    if first_index == last_index:\n        # Only one occurrence, remove it\n        return string[:first_index] + string[first_index + 1:]\n    else:\n        # Remove the last occurrence first to avoid shifting indices for the first one\n        temp_string = string[:last_index] + string[last_index + 1:]\n        # Remove the first occurrence from the temporary string\n        return temp_string[:first_index] + temp_string[first_index + 1:]"}
