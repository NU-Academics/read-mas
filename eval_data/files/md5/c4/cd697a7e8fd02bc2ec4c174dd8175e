{"task_id": "Mbpp/615", "solution": "def average_tuple(tuple_of_tuples: tuple) -> list:\n    \"\"\"\n    Calculate the average value for each tuple in a tuple of tuples.\n    Returns a list of average values, one for each inner tuple.\n    \"\"\"\n    averages = []\n    for inner_tuple in tuple_of_tuples:\n        current_sum = sum(inner_tuple)\n        current_count = len(inner_tuple)\n        averages.append(float(current_sum) / current_count)\n    return averages"}
{"task_id": "Mbpp/615", "solution": "def average_tuple(tuple_of_tuples: tuple) -> list:\n    \"\"\"Calculates the average of each inner tuple within a tuple of tuples.\n    Returns a list of these averages.\"\"\"\n    averages = []\n    for inner_tuple in tuple_of_tuples:\n        # Calculate the sum and count of elements for the current inner tuple\n        total_sum = sum(inner_tuple)\n        count = len(inner_tuple)\n        # Compute the average and append it to the result list\n        averages.append(total_sum / count)\n    return averages"}
{"task_id": "Mbpp/616", "solution": "def tuple_modulo(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"Performs element-wise modulo operation on two tuples of the same length.\"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Tuples must have the same length.\")\n\n    result = []\n    for i in range(len(tuple1)):\n        dividend = tuple1[i]\n        divisor = tuple2[i]\n        if divisor == 0:\n            raise ZeroDivisionError(\"Modulo by zero is not allowed.\")\n        result.append(dividend % divisor)\n\n    return tuple(result)"}
{"task_id": "Mbpp/616", "solution": "def tuple_modulo(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise modulo operation on two tuples.\n    Raises ValueError if tuples have different lengths or ZeroDivisionError if any element in tuple2 is zero.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Tuples must have the same length.\")\n\n    return tuple(a % b for a, b in zip(tuple1, tuple2))"}
