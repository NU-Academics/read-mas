{"task_id": "Mbpp/245", "solution": "def max_sum(array: list[int]) -> int:\n    \"\"\"\n    Calculates the maximum sum of a bitonic subsequence in the given array.\n    A bitonic subsequence first increases and then decreases.\n    \"\"\"\n    n = len(array)\n\n    if n == 0:\n        return 0\n    if n == 1:\n        return array[0]\n\n    def calculate_increasing_sums(arr: list[int]) -> list[int]:\n        \"\"\"Computes maximum increasing subsequence sums ending at each position.\"\"\"\n        m = len(arr)\n        lis = list(arr)\n        for i in range(1, m):\n            for j in range(i):\n                if arr[i] > arr[j]:\n                    lis[i] = max(lis[i], lis[j] + arr[i])\n        return lis\n\n    def calculate_decreasing_sums(arr: list[int]) -> list[int]:\n        \"\"\"Computes maximum decreasing subsequence sums starting at each position.\"\"\"\n        m = len(arr)\n        lds = list(arr)\n        for i in range(m - 2, -1, -1):\n            for j in range(m - 1, i, -1):\n                if arr[i] > arr[j]:\n                    lds[i] = max(lds[i], lds[j] + arr[i])\n        return lds\n\n    def find_maximum_bitonic_sum(inc_sums: list[int], dec_sums: list[int], original_arr: list[int]) -> int:\n        \"\"\"Combines increasing and decreasing sums to find the optimal bitonic sum.\"\"\"\n        m = len(original_arr)\n        # Initialize max_bitonic_sum with the sum of a single element for robustness.\n        max_bitonic_sum = original_arr[0]\n\n        for i in range(m):\n            # The element original_arr[i] is the peak and is counted in both LIS and LDS.\n            # Subtract it once to get the correct total sum for a bitonic subsequence.\n            current_sum = inc_sums[i] + dec_sums[i] - original_arr[i]\n            max_bitonic_sum = max(max_bitonic_sum, current_sum)\n        return max_bitonic_sum\n\n    lis_sums = calculate_increasing_sums(array)\n    lds_sums = calculate_decreasing_sums(array)\n    \n    return find_maximum_bitonic_sum(lis_sums, lds_sums, array)"}
