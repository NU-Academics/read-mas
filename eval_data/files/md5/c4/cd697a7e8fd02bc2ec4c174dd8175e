{"task_id": "Mbpp/103", "solution": "def eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Calculate the Eulerian number A(n, m) using the standard sum formula.\n    This counts permutations of {1, ..., n} with exactly m ascents.\n    \"\"\"\n    if n == 0:\n        return 1 if m == 0 else 0\n\n    # Eulerian numbers A(n,m) are commonly defined as 0 for m < 0 or m >= n.\n    if m < 0 or m >= n:\n        return 0\n\n    def combinations(N, K):\n        \"\"\"Calculates the binomial coefficient C(N, K) (N choose K).\"\"\"\n        if K < 0 or K > N:\n            return 0\n        if K == 0 or K == N:\n            return 1\n        if K > N // 2:\n            K = N - K\n        \n        res = 1\n        for i in range(K):\n            res = res * (N - i) // (i + 1)\n        return res\n\n    result = 0\n    # The formula for Eulerian numbers A(n, m) is:\n    # A(n, m) = sum_{k=0 to m} (-1)^k * C(n+1, k) * (m - k + 1)^n\n    for k in range(m + 1):\n        term = ((-1)**k) * combinations(n + 1, k) * ((m - k + 1)**n)\n        result += term\n    \n    return result"}
{"task_id": "Mbpp/102", "solution": "def snake_to_camel(input_string):\n    \"\"\"Converts a snake_case string to CamelCase.\n\n    Splits the string by underscores, capitalizes each word, and joins them.\"\"\"\n    if not input_string:\n        return \"\"\n    words = input_string.split('_')\n    camel_case_words = [word.capitalize() for word in words]\n    return \"\".join(camel_case_words)"}
{"task_id": "Mbpp/103", "solution": "def _factorial(k):\n    \"\"\"Calculates the factorial of a non-negative integer k.\"\"\"\n    if k == 0:\n        return 1\n    res = 1\n    for i in range(1, k + 1):\n        res *= i\n    return res\n\ndef _combinations(n, k):\n    \"\"\"Calculates the binomial coefficient (n choose k).\"\"\"\n    if k < 0 or k > n:\n        return 0\n    if k == 0 or k == n:\n        return 1\n    if k > n // 2:\n        k = n - k\n    \n    # Calculate C(n, k) = n * (n-1) * ... * (n-k+1) / (k * (k-1) * ... * 1)\n    res = 1\n    for i in range(k):\n        res = res * (n - i) // (i + 1)\n    return res\n\ndef eulerian_num(n, m):\n    \"\"\"\n    Calculates the Eulerian number A(n, m) using the explicit formula.\n    A(n, m) is the number of permutations of {1, ..., n} with exactly m ascents.\n    \"\"\"\n    total_sum = 0\n    for k in range(m + 1):\n        term = ((-1)**k) * _combinations(n + 1, k) * ((m - k + 1)**n)\n        total_sum += term\n    return total_sum"}
