{"task_id": "Mbpp/763", "solution": "def _validate_input(array, length):\n    \"\"\"Validate input parameters. Returns True if valid, raises ValueError if invalid.\"\"\"\n    if length < 2:\n        raise ValueError(\"Array must have at least 2 elements.\")\n    if len(array) != length:\n        raise ValueError(\"Provided length does not match array length.\")\n    return True\n\ndef _calculate_min_difference(array):\n    \"\"\"Core calculation logic for minimum difference. Calculates minimum absolute difference between any two elements.\"\"\"\n    sorted_array = sorted(array)\n    min_diff = float('inf')\n    for i in range(len(sorted_array) - 1):\n        diff = abs(sorted_array[i+1] - sorted_array[i])\n        if diff < min_diff:\n            min_diff = diff\n    return min_diff\n\ndef find_min_diff(array, length):\n    \"\"\"\n    Calculate minimum absolute difference between any two distinct elements.\n\n    Args:\n        array: tuple or list of integers\n        length: int, length of the array\n\n    Returns:\n        int: minimum absolute difference\n\n    Raises:\n        ValueError: if array has less than 2 elements or length is inconsistent\n    \"\"\"\n    _validate_input(array, length)\n    return _calculate_min_difference(array)"}
{"task_id": "Mbpp/763", "solution": "def _validate_input(array, length: int) -> bool:\n    \"\"\"Validates input parameters for correctness.\"\"\"\n    # Adhering to the \"Do NOT add isinstance() checks or raise exceptions for edge cases\" constraint,\n    # we assume valid input types and sufficient length (>=2) for calculation.\n    return True\n\ndef _calculate_min_difference(array, length: int) -> int:\n    \"\"\"Core calculation logic for minimum difference.\"\"\"\n    # Sort the array to ensure minimum difference will be between adjacent elements.\n    sorted_array = sorted(array)\n\n    min_diff = float('inf')\n    for i in range(length - 1):\n        diff = sorted_array[i+1] - sorted_array[i]\n        min_diff = min(min_diff, diff)\n            \n    return int(min_diff)\n\ndef find_min_diff(array, length: int) -> int:\n    \"\"\"Main function to find minimum difference between array elements.\"\"\"\n    _validate_input(array, length)\n    return _calculate_min_difference(array, length)"}
{"task_id": "Mbpp/765", "solution": "def is_polite(n: int) -> int:\n    \"\"\"\n    Finds the nth polite number. A polite number is a positive integer that is not a power of two.\n    \"\"\"\n\n    # Helper function to check if a number is a power of two.\n    # This is used to determine if a number is NOT polite.\n    def _is_power_of_two(num: int) -> bool:\n        return num > 0 and (num & (num - 1)) == 0\n\n    # Helper function to determine if a number is polite.\n    # A number is polite if and only if it is not a power of two.\n    def _is_polite_number(num: int) -> bool:\n        return not _is_power_of_two(num)\n\n    # Initialize count of polite numbers found and the current number to check.\n    polite_count = 0\n    current_number = 1\n\n    # Iterate through numbers, counting polite numbers until the nth is found.\n    while True:\n        if _is_polite_number(current_number):\n            polite_count += 1\n            if polite_count == n:\n                return current_number\n        current_number += 1"}
{"task_id": "Mbpp/765", "solution": "def is_polite(n: int) -> int:\n    \"\"\"\n    Finds the nth polite number. A polite number is a positive integer that is not a power of 2.\n    \"\"\"\n    polite_count = 0\n    current_num = 0\n\n    while polite_count < n:\n        current_num += 1\n        # A number x is NOT a power of 2 if (x & (x - 1)) is not 0.\n        if (current_num & (current_num - 1)) != 0:\n            polite_count += 1\n            \n    return current_num"}
