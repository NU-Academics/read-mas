{"task_id": "Mbpp/457", "solution": "def Find_Min(input_list: list[list]) -> list:\n    \"\"\"\n    Find and return the sublist with minimum length.\n\n    This function iterates through the given list of sublists to identify the one with the fewest elements.\n    \"\"\"\n    # Initialize the minimum length sublist and its length using the first element.\n    # This assumes input_list is non-empty as per design context and example.\n    min_length_sublist = input_list[0]\n    min_length = len(input_list[0])\n\n    # Iterate through the remaining sublists to find one with a shorter length.\n    for sublist in input_list[1:]:\n        if len(sublist) < min_length:\n            min_length = len(sublist)\n            min_length_sublist = sublist\n    return min_length_sublist"}
{"task_id": "Mbpp/454", "solution": "def text_match_wordz(input_string: str) -> bool:\n    import re # Import re module for word extraction.\n\n    # Helper function to extract words from text, treating punctuation and whitespace as boundaries.\n    def _extract_words(text: str) -> list[str]:\n        # Use regex to find sequences of word characters (alphanumeric + underscore),\n        # effectively splitting the text into words by non-word characters.\n        return re.findall(r'\\b\\w+\\b', text)\n\n    # Helper function to check if any word in a list contains the character 'z'.\n    def _contains_z_word(words: list[str]) -> bool:\n        for word in words:\n            if 'z' in word:\n                return True\n        return False\n\n    # Main logic: first extract all words from the input string, then check if any contains 'z'.\n    words = _extract_words(input_string)\n    return _contains_z_word(words)"}
{"task_id": "Mbpp/457", "solution": "def Find_Min(list_of_sublists):\n    \"\"\"\n    Finds the sublist with the minimum length from a list of sublists.\n    Returns the first sublist encountered if multiple have the same minimum length.\n    \"\"\"\n    min_sublist = None\n    min_length = float('inf')\n\n    for sublist in list_of_sublists:\n        current_length = len(sublist)\n        if current_length < min_length:\n            min_length = current_length\n            min_sublist = sublist\n    return min_sublist"}
