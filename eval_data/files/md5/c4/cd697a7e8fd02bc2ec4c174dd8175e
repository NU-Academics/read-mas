{"task_id": "Mbpp/631", "solution": "def replace_spaces(input_string: str) -> str:\n    \"\"\"\n    Replaces whitespaces with underscores and vice versa in the given string.\n    Processes string operations in O(n) time complexity.\n    \"\"\"\n    result_chars = []\n    for char in input_string:\n        if char.isspace():\n            result_chars.append('_')\n        elif char == '_':\n            result_chars.append(' ')\n        else:\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/630", "solution": "def get_coordinates(coordinate_tuple: tuple) -> list[list[int]]:\n    \"\"\"\n    Extracts all adjacent coordinates of the given coordinate tuple, forming a 3x3 grid centered on it.\n    Coordinates are returned in row-major order.\n    \"\"\"\n    center_x, center_y = coordinate_tuple\n    result_coordinates = []\n\n    for x_offset in range(-1, 2):  # -1, 0, 1\n        current_x = center_x + x_offset\n        for y_offset in range(-1, 2):  # -1, 0, 1\n            current_y = center_y + y_offset\n            result_coordinates.append([current_x, current_y])\n\n    return result_coordinates"}
{"task_id": "Mbpp/632", "solution": "def move_zero(input_list: list) -> list:\n    \"\"\"Moves all zeroes to the end of the list while preserving the relative order of non-zero elements.\"\"\"\n\n    def _separate_non_zeros(lst: list) -> tuple[list, int]:\n        \"\"\"Separates non-zero elements and counts zeros from a list.\"\"\"\n        non_zeros = []\n        zero_count = 0\n        for item in lst:\n            if item == 0:\n                zero_count += 1\n            else:\n                non_zeros.append(item)\n        return non_zeros, zero_count\n\n    def _reconstruct_with_zeros(non_zeros: list, zero_count: int) -> list:\n        \"\"\"Reconstructs a list by appending a given number of zeros to a list of non-zeros.\"\"\"\n        return non_zeros + [0] * zero_count\n\n    non_zeros_elements, zeros_count = _separate_non_zeros(input_list)\n    result_list = _reconstruct_with_zeros(non_zeros_elements, zeros_count)\n    return result_list"}
{"task_id": "Mbpp/631", "solution": "def replace_spaces(input_string: str) -> str:\n    # Iterate through the input string and build a new string with replacements.\n    # Whitespace characters are replaced with underscores, and underscores with spaces.\n    modified_chars = []\n    for char in input_string:\n        if char.isspace():\n            modified_chars.append('_')\n        elif char == '_':\n            modified_chars.append(' ')\n        else:\n            modified_chars.append(char)\n    return \"\".join(modified_chars)"}
