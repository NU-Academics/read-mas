{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(lst: list) -> int:\n    \"\"\"\n    Calculates the sum of products of all possible contiguous sublists of a given list.\n    \"\"\"\n    total_sum = 0\n    n = len(lst)\n    for i in range(n):\n        current_product = 1\n        for j in range(i, n):\n            current_product *= lst[j]\n            total_sum += current_product\n    return total_sum"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(input_list: list) -> int:\n    \"\"\"Finds the sum of products of all possible contiguous sublists of a given list.\"\"\"\n    total_sum_of_products = 0\n    \n    def calculate_product(sublist: list) -> int:\n        \"\"\"Calculates the product of elements in a single sublist.\"\"\"\n        if not sublist:\n            return 1\n        product = 1\n        for x in sublist:\n            product *= x\n        return product\n\n    n = len(input_list)\n    for i in range(n):\n        for j in range(i, n):\n            current_sublist = input_list[i : j + 1]\n            total_sum_of_products += calculate_product(current_sublist)\n            \n    return total_sum_of_products"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(number: int) -> int:\n    \"\"\"\n    Toggles all bits of the number except the first (MSB) and the last (LSB) bit.\n    \"\"\"\n    if number == 0:\n        return 0\n\n    def _get_bit_length(num: int) -> int:\n        \"\"\"Returns the number of bits required to represent the number.\"\"\"\n        return num.bit_length()\n\n    def _create_toggle_mask(bit_length: int) -> int:\n        \"\"\"Creates a mask to toggle middle bits, preserving MSB and LSB.\"\"\"\n        if bit_length <= 2:\n            return 0  # No middle bits to toggle for 0, 1, or 2 bits\n        # The mask for n bits (n > 2) is 2^(n-1) - 2.\n        # This results in a binary number with 1s from the second bit to the (n-1)th bit.\n        return (1 << (bit_length - 1)) - 2\n\n    bit_length = _get_bit_length(number)\n    toggle_mask = _create_toggle_mask(bit_length)\n\n    # XOR the number with the mask to toggle only the middle bits.\n    return number ^ toggle_mask"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(number: int) -> int:\n    \"\"\"\n    Toggles all bits of the number except the first (MSB) and the last (LSB) bit.\n    Handles numbers with 0, 1, or 2 bits by not toggling anything.\n    \"\"\"\n\n    def _get_bit_length(n: int) -> int:\n        \"\"\"Calculates the number of bits required to represent an integer.\"\"\"\n        return n.bit_length()\n\n    def _create_toggle_mask(bit_length: int) -> int:\n        \"\"\"Creates an XOR mask to toggle only the middle bits.\"\"\"\n        if bit_length <= 2:\n            # If the number has 0, 1, or 2 bits, there are no 'middle' bits to toggle.\n            return 0\n\n        # Create a mask of all ones for the given bit_length (e.g., 0b1111 for length 4)\n        all_ones_mask = (1 << bit_length) - 1\n\n        # Create masks to represent the most significant bit and the least significant bit\n        msb_mask = (1 << (bit_length - 1))\n        lsb_mask = (1 << 0)\n\n        # The toggle mask is obtained by clearing the MSB and LSB from the all_ones_mask\n        middle_bits_toggle_mask = all_ones_mask ^ msb_mask ^ lsb_mask\n        return middle_bits_toggle_mask\n\n    # 1. Determine the number of bits in the input number.\n    bit_len = _get_bit_length(number)\n\n    # 2. Generate the mask that has '1's only at the positions of the middle bits.\n    mask = _create_toggle_mask(bit_len)\n\n    # 3. Toggle the middle bits using an XOR operation.\n    result = number ^ mask\n\n    return result"}
{"task_id": "Mbpp/737", "solution": "import re\n\ndef check_str(input_string: str) -> bool:\n    \"\"\"\n    Checks if the given string starts with a vowel (a, e, i, o, u) using a regular expression.\n    The check is case-insensitive and returns False for empty strings.\n    \"\"\"\n    # An explicit check for an empty string, consistent with design's empty string handling.\n    if not input_string:\n        return False\n\n    # Define the regex pattern to match a vowel at the beginning of the string.\n    # `^` asserts the position at the start of the string.\n    # `[aeiou]` matches any single lowercase vowel.\n    # `re.IGNORECASE` flag makes the pattern match both uppercase and lowercase vowels.\n    vowel_pattern = r\"^[aeiou]\"\n\n    # Use re.match() to check if the pattern exists at the beginning of the string.\n    # re.match() returns a match object if successful, and None otherwise.\n    # bool() converts the match object (truthy) or None (falsy) to a boolean result.\n    return bool(re.match(vowel_pattern, input_string, re.IGNORECASE))"}
