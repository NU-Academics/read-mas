{"task_id": "Mbpp/172", "solution": "def _validate_input(input_str: str) -> bool:\n    \"\"\"Validate that input is a valid string.\"\"\"\n    # Given type hint and constraints, this function ensures the input\n    # is ready for processing without explicit type checks or error raising.\n    return True\n\ndef _search_pattern(text: str, pattern: str) -> int:\n    \"\"\"Search for non-overlapping pattern occurrences.\"\"\"\n    count = 0\n    start_index = 0\n    while True:\n        found_index = text.find(pattern, start_index)\n        if found_index == -1:\n            break\n        count += 1\n        start_index = found_index + len(pattern)\n    return count\n\ndef count_occurance(input_string: str) -> int:\n    \"\"\"Count non-overlapping occurrences of 'std' in input string.\"\"\"\n    _validate_input(input_string)  # Validate input as per design.\n    return _search_pattern(input_string, \"std\")"}
{"task_id": "Mbpp/222", "solution": "def check_type(input_tuple: tuple) -> bool:\n    \"\"\"Checks if all elements in a tuple have the same data type.\"\"\"\n\n    def _get_element_types(tuple_data: tuple) -> list:\n        \"\"\"Extracts the type of each element in the given tuple.\"\"\"\n        return [type(element) for element in tuple_data]\n\n    def _compare_types(type_list: list) -> bool:\n        \"\"\"Compares all types in a list for uniformity.\"\"\"\n        if not type_list:\n            return True\n        first_type = type_list[0]\n        for t in type_list[1:]:\n            if t != first_type:\n                return False\n        return True\n\n    if not input_tuple:\n        return True\n\n    element_types = _get_element_types(input_tuple)\n    return _compare_types(element_types)"}
