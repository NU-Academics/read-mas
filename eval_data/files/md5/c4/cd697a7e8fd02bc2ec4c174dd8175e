{"task_id": "Mbpp/299", "solution": "def max_aggregate(tuple_list):\n    \"\"\"\n    Calculate maximum aggregate from a list of name-value tuples.\n    Groups values by name and finds the name with the highest total sum.\n    \"\"\"\n    name_sums = {}\n    for name, value in tuple_list:\n        name_sums[name] = name_sums.get(name, 0) + value\n\n    # Find the name with the maximum aggregate sum\n    if not name_sums:\n        # Return a sensible default or handle as per specific requirements\n        # Given the assert, input is assumed non-empty leading to non-empty name_sums.\n        # If name_sums is empty, this branch might depend on undefined behavior.\n        # For this problem context, it implies input guarantees at least one sum.\n        return None, 0 # Or raise an error, but \"no exceptions for edge cases\" means this is a safe default.\n\n    max_name = None\n    max_sum = -float('inf')\n\n    for name, total_sum in name_sums.items():\n        if total_sum > max_sum:\n            max_sum = total_sum\n            max_name = name\n\n    return (max_name, max_sum)"}
{"task_id": "Mbpp/299", "solution": "def max_aggregate(tuple_list):\n    \"\"\"\n    Calculates the maximum aggregate sum from a list of tuples.\n    Each tuple contains a string identifier and a numeric value.\n    \"\"\"\n    if not tuple_list:\n        return None  # Or a default value based on specific requirement for empty input\n\n    aggregates = {}\n    for identifier, value in tuple_list:\n        aggregates[identifier] = aggregates.get(identifier, 0) + value\n\n    max_identifier = None\n    max_sum = float('-inf')\n\n    for identifier, current_sum in aggregates.items():\n        if current_sum > max_sum:\n            max_sum = current_sum\n            max_identifier = identifier\n\n    return (max_identifier, max_sum)"}
{"task_id": "Mbpp/300", "solution": "import math\n\ndef count_binary_seq(n: int) -> float:\n    \"\"\"\n    Counts binary sequences of length 2n where the sum of the first n bits equals the sum of the last n bits.\n    This count is given by the central binomial coefficient C(2n, n).\n    \"\"\"\n    result = math.comb(2 * n, n)\n    return float(result)"}
{"task_id": "Mbpp/300", "solution": "def count_binary_seq(n: int) -> float:\n    \"\"\"\n    Calculates the count of all binary sequences of length 2n\n    such that the sum of the first n bits is the same as the sum of the last n bits.\n    \"\"\"\n    total_length = 2 * n\n    valid_sequences_count = 0\n\n    # Iterate through all possible binary sequences of length total_length\n    for i in range(2**total_length):\n        # Convert integer to a binary string, padded to total_length with leading zeros\n        binary_sequence = bin(i)[2:].zfill(total_length)\n\n        # Split the sequence into two halves of length n\n        first_half = binary_sequence[:n]\n        last_half = binary_sequence[n:]\n\n        # Calculate the sum of '1's in each half\n        sum_first_half = first_half.count('1')\n        sum_last_half = last_half.count('1')\n\n        # If the sums are equal, increment the counter\n        if sum_first_half == sum_last_half:\n            valid_sequences_count += 1\n            \n    return float(valid_sequences_count)"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(dictionary: dict) -> int:\n    \"\"\"\n    Calculates the maximum nesting depth of a dictionary.\n    The root dictionary is considered depth 1.\n    \"\"\"\n    def _is_dictionary(value) -> bool:\n        \"\"\"Helper to check if a value is a dictionary.\"\"\"\n        return isinstance(value, dict)\n\n    def _calculate_max_depth(current_dict: dict, current_depth: int) -> int:\n        \"\"\"Recursive helper to traverse dictionaries and find the maximum depth.\"\"\"\n        max_found_depth = current_depth\n        for value in current_dict.values():\n            if _is_dictionary(value):\n                max_found_depth = max(max_found_depth, _calculate_max_depth(value, current_depth + 1))\n        return max_found_depth\n\n    return _calculate_max_depth(dictionary, 1)"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(dictionary: dict) -> int:\n    \"\"\"Calculates the maximum nesting depth of a dictionary, counting the root dictionary as depth 1.\"\"\"\n    max_nested_depth = 0\n    \n    for value in dictionary.values():\n        if isinstance(value, dict):\n            max_nested_depth = max(max_nested_depth, dict_depth(value))\n            \n    return 1 + max_nested_depth"}
{"task_id": "Mbpp/305", "solution": "def start_withp(word_list: list) -> tuple:\n    \"\"\"\n    Returns two words from a list of strings that start with the letter 'P' (case-sensitive).\n    The input list can contain strings with multiple space-separated words.\n    \"\"\"\n    all_individual_words = []\n    for words_in_str in word_list:\n        all_individual_words.extend(words_in_str.split(' '))\n\n    p_starting_words = []\n    for word in all_individual_words:\n        if word.startswith('P'):\n            p_starting_words.append(word)\n            if len(p_starting_words) == 2:\n                # Once two words are found, we can stop processing.\n                break\n\n    return (p_starting_words[0], p_starting_words[1])"}
