{"task_id": "Mbpp/462", "solution": "def combinations_list(input_list):\n    \"\"\"\n    Generates all possible combinations of elements from the input list in binary order.\n    Elements within each combination are ordered by decreasing original index.\n    \"\"\"\n    n = len(input_list)\n    all_combinations = []\n\n    # Iterate from 0 to 2^n - 1 to generate all binary patterns\n    for i in range(1 << n):\n        current_combination = []\n        # Iterate from n-1 down to 0 to build the combination, placing elements corresponding to higher indices first\n        for j in range(n - 1, -1, -1):\n            if (i >> j) & 1:  # Check if the j-th bit is set\n                current_combination.append(input_list[j])\n        all_combinations.append(current_combination)\n\n    return all_combinations"}
{"task_id": "Mbpp/459", "solution": "def remove_uppercase(input_string: str) -> str:\n    \"\"\"\n    Remove all contiguous uppercase letter sequences from the input string.\n    Preserves lowercase letters and non-alphabetic characters.\n    \"\"\"\n    result_chars = []\n    # This flag indicates whether we are currently inside an uppercase sequence that should be removed.\n    skipping_uppercase_run = False\n\n    for char in input_string:\n        if char.isupper():\n            # If the current character is uppercase, we enter or continue a skipping state.\n            # This character is not added to the result.\n            skipping_uppercase_run = True\n        else:\n            # If the current character is not uppercase, it should be appended to the result.\n            # This also signifies the end of any potential uppercase sequence we were skipping.\n            skipping_uppercase_run = False\n            result_chars.append(char)\n\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/462", "solution": "def combinations_list(input_list: list) -> list:\n    \"\"\"\n    Generates all possible combinations (power set) of elements from a given list,\n    maintaining a specific order as demonstrated in the assertion test.\n    \"\"\"\n    combinations = [[]]\n\n    for element in input_list:\n        # We iterate over the combinations that existed before adding the current element.\n        # This ensures new combinations are appended correctly without affecting the iteration.\n        current_length = len(combinations)\n        for i in range(current_length):\n            # Create a new combination by prepending the current element to an existing one.\n            # This order matches the output requirement, e.g., ['red', 'orange']\n            new_combination = [element] + combinations[i]\n            combinations.append(new_combination)\n\n    return combinations"}
