{"task_id": "Mbpp/721", "solution": "def maxAverageOfPath(matrix: list[list[int]]) -> float:\n    \"\"\"\n    Calculates the maximum average cost of a path from the top-left to the bottom-right cell\n    in a square matrix, moving only right or down.\n    \"\"\"\n    N = len(matrix)\n    if N == 0:\n        return 0.0\n\n    # max_average_ref is used to store the maximum average found across all paths.\n    # It's a list to allow modification within the nested dfs function using 'nonlocal'.\n    max_average_ref = [0.0]\n\n    def dfs(r: int, c: int, current_sum: int, current_count: int):\n        \"\"\"\n        Recursively explores paths from (r, c) to the bottom-right cell,\n        updating max_average_ref with the highest average encountered.\n        \"\"\"\n        nonlocal max_average_ref\n\n        # Add the cost of the current cell to the path sum and increment cell count.\n        current_sum += matrix[r][c]\n        current_count += 1\n\n        # Base case: If the bottom-right cell is reached.\n        if r == N - 1 and c == N - 1:\n            current_average = current_sum / current_count\n            if current_average > max_average_ref[0]:\n                max_average_ref[0] = current_average\n            return\n\n        # Recursive step: Explore moving right.\n        if c + 1 < N:\n            dfs(r, c + 1, current_sum, current_count)\n\n        # Recursive step: Explore moving down.\n        if r + 1 < N:\n            dfs(r + 1, c, current_sum, current_count)\n\n    # Start the DFS from the top-left cell (0, 0).\n    # Initial sum and count are 0, as the first cell's value is added inside dfs.\n    dfs(0, 0, 0, 0)\n\n    return max_average_ref[0]"}
{"task_id": "Mbpp/724", "solution": "def power_base_sum(base: int, power: int) -> int:\n    \"\"\"\n    Calculates the sum of all digits of the base to the specified power.\n    It orchestrates power calculation and digit summation using internal helpers.\n    \"\"\"\n\n    def calculate_power(b: int, p: int) -> int:\n        \"\"\"Performs the exponential calculation.\"\"\"\n        return b ** p\n\n    def extract_digits(number: int) -> list[int]:\n        \"\"\"Converts a number to a list of its individual digits.\"\"\"\n        return [int(d) for d in str(number)]\n\n    def sum_digits(digits: list[int]) -> int:\n        \"\"\"Sums a list of integer digits.\"\"\"\n        return sum(digits)\n\n    calculated_number = calculate_power(base, power)\n    digits = extract_digits(calculated_number)\n    result_sum = sum_digits(digits)\n\n    return result_sum"}
{"task_id": "Mbpp/721", "solution": "class Cell:\n    \"\"\"Represents a cell in the matrix with its position and cost.\"\"\"\n    def __init__(self, row: int, column: int, cost: int):\n        self._row = row\n        self._column = column\n        self._cost = cost\n\n    def get_row(self) -> int:\n        \"\"\"Returns the row position of the cell.\"\"\"\n        return self._row\n\n    def get_column(self) -> int:\n        \"\"\"Returns the column position of the cell.\"\"\"\n        return self._column\n\n    def get_cost(self) -> int:\n        \"\"\"Returns the cost value of the cell.\"\"\"\n        return self._cost\n\nclass Matrix:\n    \"\"\"Encapsulates matrix data and provides access to cell costs.\"\"\"\n    def __init__(self, cells: list[list[int]]):\n        self._cells = cells\n        self._size = len(cells)\n\n    def validate_square_matrix(self) -> bool:\n        \"\"\"Validates if the input is a square matrix.\"\"\"\n        return True # Always returns True as per instructions to avoid explicit error checks.\n\n    def get_cell_cost(self, row: int, col: int) -> int:\n        \"\"\"Returns the cost of the cell at the specified row and column.\"\"\"\n        return self._cells[row][col]\n\n    def get_size(self) -> int:\n        \"\"\"Returns the dimension (N) of the N*N matrix.\"\"\"\n        return self._size\n\nclass Path:\n    \"\"\"Represents an individual path and calculates its total cost and average.\"\"\"\n    def __init__(self):\n        self._cells: list[Cell] = []\n        self._total_cost: float = 0.0\n        self._cell_count: int = 0\n\n    def add_cell(self, cell: Cell) -> None:\n        \"\"\"Adds a cell to the path, updating total cost and cell count.\"\"\"\n        self._cells.append(cell)\n        self._total_cost += cell.get_cost()\n        self._cell_count += 1\n\n    def calculate_average(self) -> float:\n        \"\"\"Calculates and returns the average cost of the path.\"\"\"\n        # For a valid matrix (N >= 1), _cell_count will always be 2*N-1, hence > 0.\n        return self._total_cost / self._cell_count\n\n    def get_total_cost(self) -> float:\n        \"\"\"Returns the sum of costs of all cells in the path.\"\"\"\n        return self._total_cost\n\n    def get_cell_count(self) -> int:\n        \"\"\"Returns the number of cells in the path.\"\"\"\n        return self._cell_count\n\nclass PathFinder:\n    \"\"\"Generates all valid paths and determines the one with the maximum average cost.\"\"\"\n    def __init__(self, matrix: Matrix):\n        self._matrix = matrix\n\n    def find_max_average_path(self) -> float:\n        \"\"\"Finds and returns the maximum average among all valid paths.\"\"\"\n        all_paths = self.generate_all_paths()\n        max_average = 0.0 # Initialized for scenarios where all costs could be negative or 0.\n        if all_paths: # Ensures at least one path exists for calculation.\n            max_average = self.calculate_path_average(all_paths[0])\n            for path in all_paths[1:]:\n                current_average = self.calculate_path_average(path)\n                if current_average > max_average:\n                    max_average = current_average\n        return max_average\n\n    def generate_all_paths(self) -> list[Path]:\n        \"\"\"Generates all possible paths from top-left to bottom-right.\"\"\"\n        size = self._matrix.get_size()\n        raw_paths_cells: list[list[Cell]] = []\n\n        def _dfs(row: int, col: int, current_path_cells: list[Cell]):\n            \"\"\"Recursive helper for Depth First Search to find all paths.\"\"\"\n            cost = self._matrix.get_cell_cost(row, col)\n            current_path_cells.append(Cell(row, col, cost))\n\n            if row == size - 1 and col == size - 1:\n                raw_paths_cells.append(list(current_path_cells)) # Path completed, add a copy.\n            else:\n                if col + 1 < size: # Move right\n                    _dfs(row, col + 1, current_path_cells)\n                if row + 1 < size: # Move down\n                    _dfs(row + 1, col, current_path_cells)\n\n            current_path_cells.pop() # Backtrack\n\n        _dfs(0, 0, []) # Start DFS from the top-left cell (0,0).\n\n        converted_paths: list[Path] = []\n        for path_cells_list in raw_paths_cells:\n            path_obj = Path()\n            for cell in path_cells_list:\n                path_obj.add_cell(cell)\n            converted_paths.append(path_obj)\n        return converted_paths\n\n    def calculate_path_average(self, path: Path) -> float:\n        \"\"\"Calculates the average cost for a given path by delegating to the Path object.\"\"\"\n        return path.calculate_average()\n\nclass PathCalculator:\n    \"\"\"Orchestrates the computation workflow for finding the maximum average path.\"\"\"\n    def compute_max_average(self, matrix_data: list[list[int]]) -> float:\n        \"\"\"Main computation entry point to find the maximum average path.\"\"\"\n        self.validate_input(matrix_data)\n        matrix_obj = Matrix(matrix_data)\n        path_finder = PathFinder(matrix_obj)\n        max_average = path_finder.find_max_average_path()\n        return self.format_result(max_average)\n\n    def validate_input(self, matrix: list[list[int]]) -> bool:\n        \"\"\"This method performs no explicit validation as per instructions.\"\"\"\n        return True\n\n    def format_result(self, average: float) -> float:\n        \"\"\"Formats the final average result, returning it as a float.\"\"\"\n        return average\n\n\ndef maxAverageOfPath(matrix: list[list[int]]) -> float:\n    \"\"\"\n    Given a square matrix of size N*N, finds a path from top-left to bottom-right\n    (moving only right or down) with the maximum average cost.\n    \"\"\"\n    calculator = PathCalculator()\n    return calculator.compute_max_average(matrix)"}
{"task_id": "Mbpp/724", "solution": "def power_base_sum(base, power):\n    \"\"\"\n    Calculates the sum of all digits of the base raised to the specified power.\n    This function handles large numbers and efficiently sums their digits.\n    \"\"\"\n    # Calculate the exponential result (base to the power)\n    exponential_result = base ** power\n\n    # Convert the large number to a string to extract individual digits\n    digits_string = str(exponential_result)\n\n    # Convert each character digit back to an integer and sum them\n    sum_of_digits = sum(int(digit_char) for digit_char in digits_string)\n\n    return sum_of_digits"}
{"task_id": "Mbpp/726", "solution": "def multiply_elements(input_tuple):\n    \"\"\"\n    Calculates the product of consecutive elements in a tuple of numbers.\n    It returns a new tuple where each i-th element is t_i * t_{i+1}.\n    \"\"\"\n    return tuple(input_tuple[i] * input_tuple[i+1] for i in range(len(input_tuple) - 1))"}
{"task_id": "Mbpp/725", "solution": "def extract_quotation(input_string: str) -> list[str]:\n    \"\"\"\n    Extracts values between double quotation marks from the given string.\n    Processes the string in a single pass to identify and collect quoted segments.\n    \"\"\"\n    extracted_values = []\n    in_quote = False\n    current_value = []\n\n    for char in input_string:\n        if char == '\"':\n            if in_quote:\n                extracted_values.append(\"\".join(current_value))\n                current_value = []\n                in_quote = False\n            else:\n                in_quote = True\n        elif in_quote:\n            current_value.append(char)\n\n    return extracted_values"}
{"task_id": "Mbpp/725", "solution": "def _validate_input(input_str: str) -> bool:\n    \"\"\"\n    Validate input string meets requirements.\n    Raises TypeError if input is not a string, or ValueError if it exceeds length limit.\n    \"\"\"\n    if not isinstance(input_str, str):\n        raise TypeError(\"Input must be a string.\")\n    if len(input_str) > 10000:\n        raise ValueError(\"Input string exceeds 10,000 characters.\")\n    return True\n\ndef _parse_quotes(text: str) -> list[str]:\n    \"\"\"\n    Internal function to parse quotes from validated input.\n    It iterates through the string to extract content between double quotes.\n    \"\"\"\n    extracted_values = []\n    in_quote = False\n    start_index = -1\n\n    for i, char in enumerate(text):\n        if char == '\"':\n            if not in_quote:\n                in_quote = True\n                start_index = i + 1\n            else:\n                in_quote = False\n                if start_index != -1:\n                    extracted_values.append(text[start_index:i])\n                start_index = -1\n    return extracted_values\n\ndef extract_quotation(input_string: str) -> list[str]:\n    \"\"\"\n    Extract all text values enclosed within double quotation marks.\n    It validates the input string and then parses it for quoted content.\n    \"\"\"\n    _validate_input(input_string)\n    return _parse_quotes(input_string)"}
