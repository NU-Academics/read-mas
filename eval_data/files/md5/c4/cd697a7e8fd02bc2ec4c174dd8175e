{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(number: int) -> int:\n    \"\"\"\n    Sets the leftmost unset bit in the binary representation of the given number.\n    Helper functions identify the bit position and then set it.\n    \"\"\"\n    def _find_leftmost_unset_bit(n: int) -> int:\n        \"\"\"Identifies the position of the leftmost unset bit (0-indexed from the right).\"\"\"\n        position = 0\n        while (n >> position) & 1:  # While the bit at 'position' is 1\n            position += 1\n        return position\n\n    def _set_bit_at_position(n: int, position: int) -> int:\n        \"\"\"Sets the bit at the specified position to 1.\"\"\"\n        return n | (1 << position)\n\n    leftmost_unset_pos = _find_leftmost_unset_bit(number)\n    return _set_bit_at_position(number, leftmost_unset_pos)"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the highest power of 2 that is less than or equal to n.\n    This bit manipulation trick sets all bits to 1 from the MSB downwards, then calculates (n+1) // 2.\n    \"\"\"\n    n |= n >> 1\n    n |= n >> 2\n    n |= n >> 4\n    n |= n >> 8\n    n |= n >> 16\n    n |= n >> 32\n    n |= n >> 64\n    return (n + 1) >> 1"}
{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(n: int) -> int:\n    \"\"\"Sets the leftmost unset bit in the binary representation of an integer.\"\"\"\n\n    def set_bit_at_position(n: int, pos: int) -> int:\n        \"\"\"Helper to set a bit at the specified position (0-indexed from right).\"\"\"\n        return n | (1 << pos)\n\n    def find_left_most_unset_bit(n: int) -> int:\n        \"\"\"Helper to find the position of the leftmost unset bit (0-indexed from right).\"\"\"\n        # Iterate from the most significant bit potentially present down to 0.\n        for pos in range(n.bit_length() - 1, -1, -1):\n            if not (n & (1 << pos)):  # Check if the bit at 'pos' is 0\n                return pos\n        # If all bits up to bit_length()-1 are set, the next bit to the left is unset.\n        return n.bit_length()\n\n    position_to_set = find_left_most_unset_bit(n)\n    return set_bit_at_position(n, position_to_set)"}
