{"task_id": "Mbpp/409", "solution": "def min_product_tuple(tuple_list: List[Tuple[Union[int, float], Union[int, float]]]) -> Union[int, float]:\n    \"\"\"\n    Calculates the minimum product from pairs of numbers within a list of tuples.\n    Assumes valid input conforming to List[Tuple[numeric, numeric]].\n    \"\"\"\n\n    def _calculate_product(tuple_pair: Tuple[Union[int, float], Union[int, float]]) -> Union[int, float]:\n        \"\"\"Calculates the product of the two elements in the given tuple pair.\"\"\"\n        return tuple_pair[0] * tuple_pair[1]\n\n    def _find_minimum(products: List[Union[int, float]]) -> Union[int, float]:\n        \"\"\"Finds the minimum value from a list of numeric products.\"\"\"\n        # Assumes 'products' list is non-empty as per problem context and constraints.\n        return min(products)\n\n    products = []\n    for tuple_pair in tuple_list:\n        product = _calculate_product(tuple_pair)\n        products.append(product)\n\n    return _find_minimum(products)"}
{"task_id": "Mbpp/410", "solution": "def min_val(input_list):\n    \"\"\"\n    Finds the minimum numeric value in a given heterogeneous list.\n    Ignores non-numeric elements and returns None if no numeric values are found.\n    \"\"\"\n\n    def _filter_numeric_values(lst):\n        \"\"\"Filters the input list to include only numeric (int or float) values.\"\"\"\n        return [item for item in lst if isinstance(item, (int, float))]\n\n    def _calculate_minimum(numeric_values):\n        \"\"\"Calculates the minimum value from a list of numeric values.\"\"\"\n        if not numeric_values:\n            return None\n        return min(numeric_values)\n\n    numeric_elements = _filter_numeric_values(input_list)\n    minimum_value = _calculate_minimum(numeric_elements)\n    return minimum_value"}
