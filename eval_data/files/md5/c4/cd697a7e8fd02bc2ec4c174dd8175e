{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"Calculate sum of fourth power of first n odd natural numbers.\"\"\"\n    total_sum = 0\n    for i in range(1, n + 1):\n        odd_num = 2 * i - 1\n        total_sum += odd_num ** 4\n    return total_sum"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the fourth power of the first n odd natural numbers.\n    For example, if n=2, it calculates 1^4 + 3^4.\n    \"\"\"\n    total_sum = 0\n    for i in range(n):\n        odd_number = 2 * i + 1\n        total_sum += odd_number ** 4\n    return total_sum"}
{"task_id": "Mbpp/771", "solution": "def check_expression(expression: str) -> bool:\n    \"\"\"\n    Checks if the given expression has balanced brackets.\n    Supports parentheses, square brackets, and curly braces.\n    \"\"\"\n    bracket_map = {'(': ')', '[': ']', '{': '}'}\n    opening_brackets = set(bracket_map.keys())\n    closing_brackets = set(bracket_map.values())\n    \n    stack = []\n\n    for char in expression:\n        if char in opening_brackets:\n            stack.append(char)\n        elif char in closing_brackets:\n            if not stack:\n                return False\n            last_opening = stack.pop()\n            if bracket_map[last_opening] != char:\n                return False\n\n    return not stack"}
