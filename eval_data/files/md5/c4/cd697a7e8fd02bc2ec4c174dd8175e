{"task_id": "Mbpp/726", "solution": "def multiply_elements(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Calculate products of adjacent elements in a tuple.\n\n    Args:\n        input_tuple: Tuple of numeric elements (length N+1)\n\n    Returns:\n        Tuple of length N with adjacent element products\n\n    Raises:\n        ValueError: If input tuple has fewer than 2 elements\n        TypeError: If input contains non-numeric elements\n    \"\"\"\n\n    def _validate_input(input_tuple: tuple) -> bool:\n        \"\"\"\n        Validate input tuple structure and content.\n        \"\"\"\n        if len(input_tuple) < 2:\n            return False\n        for item in input_tuple:\n            if not isinstance(item, (int, float)):\n                return False\n        return True\n\n    def _calculate_products(input_tuple: tuple) -> tuple:\n        \"\"\"\n        Calculate products of adjacent elements.\n        \"\"\"\n        products = []\n        for i in range(len(input_tuple) - 1):\n            products.append(input_tuple[i] * input_tuple[i+1])\n        return tuple(products)\n\n    is_valid = _validate_input(input_tuple)\n\n    if not is_valid:\n        # Determine specific error type based on initial input conditions\n        if len(input_tuple) < 2:\n            raise ValueError(\"Input tuple must contain at least 2 elements\")\n        else:\n            # If length is sufficient but validation still failed, it must be due to element types\n            raise TypeError(\"Input contains non-numeric elements\")\n\n    return _calculate_products(input_tuple)"}
{"task_id": "Mbpp/728", "solution": "def sum_list(list1, list2):\n    \"\"\"\n    Performs element-wise addition of two lists.\n    Assumes lists are of equal length and contain numeric elements.\n    \"\"\"\n    # Create an empty list to store the results\n    result = []\n    # Iterate through the lists simultaneously using an index\n    for i in range(len(list1)):\n        # Add corresponding elements and append to the result list\n        result.append(list1[i] + list2[i])\n    return result"}
{"task_id": "Mbpp/730", "solution": "def consecutive_duplicates(input_list: list) -> list:\n    \"\"\"Removes consecutive duplicates from a list, preserving order and first occurrences.\"\"\"\n    if not input_list:\n        return []\n\n    result_list = [input_list[0]]\n    for i in range(1, len(input_list)):\n        if input_list[i] != result_list[-1]:\n            result_list.append(input_list[i])\n    return result_list"}
{"task_id": "Mbpp/730", "solution": "def consecutive_duplicates(input_list: list) -> list:\n    \"\"\"\n    Removes consecutive duplicate elements from a list, preserving the original order.\n    Returns a new list with consecutive duplicates removed.\n    \"\"\"\n    if not input_list:\n        return []\n\n    result = [input_list[0]]\n    for item in input_list[1:]:\n        if item != result[-1]:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/731", "solution": "import math\n\ndef lateralsurface_cone(r, h):\n    \"\"\"\n    Calculates the lateral surface area of a cone.\n    The formula used is \u03c0 * r * \u221a(r\u00b2 + h\u00b2), where r is radius and h is height.\n    \"\"\"\n    slant_height = math.sqrt(r**2 + h**2)\n    lateral_surface_area = math.pi * r * slant_height\n    return lateral_surface_area"}
