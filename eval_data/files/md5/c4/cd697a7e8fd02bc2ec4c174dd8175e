{"task_id": "Mbpp/445", "solution": "def index_multiplication(tuple1, tuple2):\n    \"\"\"\n    Performs index-wise multiplication of elements within nested tuples.\n    It takes two tuples of tuples and returns a new tuple with the multiplied results.\n    \"\"\"\n    result = []\n    for sub_tuple1, sub_tuple2 in zip(tuple1, tuple2):\n        multiplied_sub_tuple = (sub_tuple1[0] * sub_tuple2[0], sub_tuple1[1] * sub_tuple2[1])\n        result.append(multiplied_sub_tuple)\n    return tuple(result)"}
{"task_id": "Mbpp/445", "solution": "def index_multiplication(tuple1, tuple2):\n    \"\"\"\n    Performs index-wise multiplication of elements from two input tuples,\n    handling nested tuples recursively to preserve structure.\n    \"\"\"\n    result_elements = []\n    for elem1, elem2 in zip(tuple1, tuple2):\n        if isinstance(elem1, tuple) and isinstance(elem2, tuple):\n            # If both elements are tuples, recurse to multiply their contents\n            result_elements.append(index_multiplication(elem1, elem2))\n        else:\n            # Otherwise, assume elements are numbers and multiply them directly\n            result_elements.append(elem1 * elem2)\n    return tuple(result_elements)"}
{"task_id": "Mbpp/440", "solution": "import re\nimport string\n\nADVERB_PATTERNS = [\n    re.compile(r\"ly$\", re.IGNORECASE),\n    re.compile(r\"always$\", re.IGNORECASE),\n    re.compile(r\"often$\", re.IGNORECASE),\n    re.compile(r\"never$\", re.IGNORECASE),\n    re.compile(r\"very$\", re.IGNORECASE),\n    re.compile(r\"quite$\", re.IGNORECASE),\n    re.compile(r\"well$\", re.IGNORECASE),\n    re.compile(r\"fast$\", re.IGNORECASE),\n    re.compile(r\"hard$\", re.IGNORECASE),\n    re.compile(r\"early$\", re.IGNORECASE),\n    re.compile(r\"late$\", re.IGNORECASE),\n    re.compile(r\"soon$\", re.IGNORECASE),\n    re.compile(r\"there$\", re.IGNORECASE),\n    re.compile(r\"here$\", re.IGNORECASE),\n    re.compile(r\"now$\", re.IGNORECASE),\n    re.compile(r\"then$\", re.IGNORECASE),\n    re.compile(r\"just$\", re.IGNORECASE),\n    re.compile(r\"still$\", re.IGNORECASE),\n    re.compile(r\"even$\", re.IGNORECASE),\n]\n\ndef tokenize_sentence(sentence: str) -> list[str]:\n    \"\"\"Splits a sentence into a list of words, preserving original tokens including punctuation.\"\"\"\n    return sentence.split()\n\ndef clean_word(word: str) -> str:\n    \"\"\"Removes punctuation from the word while preserving its original case.\"\"\"\n    return word.strip(string.punctuation)\n\ndef is_adverb(word: str) -> bool:\n    \"\"\"Checks if a word is an adverb using predefined patterns.\"\"\"\n    if not word:\n        return False\n    for pattern in ADVERB_PATTERNS:\n        if pattern.search(word):\n            return True\n    return False\n\ndef _find_word_position_in_sentence(sentence: str, word: str, start_index: int) -> int:\n    \"\"\"Finds the starting index of a specific word token in the sentence.\"\"\"\n    return sentence.find(word, start_index)\n\ndef calculate_positions(sentence: str, original_word: str, current_search_start: int) -> tuple[int, int]:\n    \"\"\"Calculates the start and end positions of a word token in the sentence.\"\"\"\n    start_pos = _find_word_position_in_sentence(sentence, original_word, current_search_start)\n    if start_pos != -1:\n        end_pos = start_pos + len(original_word)\n        return (start_pos, end_pos)\n    return (-1, -1)\n\ndef find_adverb_position(sentence: str) -> tuple[int, int, str] | None:\n    \"\"\"\n    Finds the first adverb and its positions in a given sentence.\n    Returns (start_position, end_position, adverb_text) or None if no adverb is found.\n    \"\"\"\n    words = tokenize_sentence(sentence)\n    current_offset = 0\n\n    for original_word in words:\n        start_pos, end_pos = calculate_positions(sentence, original_word, current_offset)\n        \n        if start_pos != -1:\n            cleaned_word = clean_word(original_word)\n            \n            if cleaned_word and is_adverb(cleaned_word):\n                return (start_pos, end_pos, cleaned_word)\n            \n            current_offset = end_pos\n        else:\n            # If a token from split() is not found by find() from current_offset,\n            # advance offset heuristically to prevent potential infinite loops.\n            current_offset += len(original_word) + 1 \n\n    return None"}
