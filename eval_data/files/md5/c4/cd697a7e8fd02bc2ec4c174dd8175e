{"task_id": "Mbpp/128", "solution": "def long_words(n: int, text: str) -> list[str]:\n    \"\"\"\n    Filters words from a string that are longer than n characters.\n    Splits the text into words and returns a list of words exceeding the specified length.\n    \"\"\"\n    words = text.split()\n    filtered_words = [word for word in words if len(word) > n]\n    return filtered_words"}
{"task_id": "Mbpp/128", "solution": "def long_words(n: int, text: str) -> list[str]:\n    \"\"\"\n    Finds words that are longer than n characters from a given text string.\n    The text is split into words using whitespace.\n    \"\"\"\n    def _split_text(input_text: str) -> list[str]:\n        \"\"\"Splits input text into individual words using whitespace.\"\"\"\n        return input_text.split()\n\n    def _filter_words(word_list: list[str], threshold: int) -> list[str]:\n        \"\"\"Filters a list of words to include only those longer than the specified threshold.\"\"\"\n        return [word for word in word_list if len(word) > threshold]\n\n    words = _split_text(text)\n    filtered_words = _filter_words(words, n)\n    return filtered_words"}
{"task_id": "Mbpp/130", "solution": "def max_occurrences(input_list):\n    \"\"\"\n    Finds the item with the maximum frequency in a given list.\n    This function processes the input list in O(n) time complexity.\n    \"\"\"\n    # Helper function to count frequencies of items in the list.\n    def _count_frequencies(lst):\n        frequency_map = {}\n        for item in lst:\n            frequency_map[item] = frequency_map.get(item, 0) + 1\n        return frequency_map\n\n    # Helper function to find the item with the maximum frequency from a frequency dictionary.\n    def _find_max_frequency_item(frequency_dict):\n        max_item = None\n        max_count = 0\n        for item, count in frequency_dict.items():\n            if count > max_count:\n                max_count = count\n                max_item = item\n        return max_item\n\n    if not input_list:\n        return None\n\n    frequencies = _count_frequencies(input_list)\n    result = _find_max_frequency_item(frequencies)\n    return result"}
{"task_id": "Mbpp/129", "solution": "def validate_square_matrix(matrix):\n    \"\"\"Checks if the given matrix is square.\"\"\"\n    if not matrix:\n        return False\n    n = len(matrix)\n    for row in matrix:\n        if len(row) != n:\n            return False\n    return True\n\ndef calculate_row_sums(matrix):\n    \"\"\"Calculates the sum for each row in the matrix.\"\"\"\n    return [sum(row) for row in matrix]\n\ndef calculate_column_sums(matrix):\n    \"\"\"Calculates the sum for each column in the matrix.\"\"\"\n    n = len(matrix)\n    col_sums = [0] * n\n    for i in range(n):\n        for j in range(n):\n            col_sums[j] += matrix[i][j]\n    return col_sums\n\ndef calculate_main_diagonal_sum(matrix):\n    \"\"\"Calculates the sum of the main diagonal elements.\"\"\"\n    n = len(matrix)\n    main_diag_sum = 0\n    for i in range(n):\n        main_diag_sum += matrix[i][i]\n    return main_diag_sum\n\ndef calculate_anti_diagonal_sum(matrix):\n    \"\"\"Calculates the sum of the anti-diagonal elements.\"\"\"\n    n = len(matrix)\n    anti_diag_sum = 0\n    for i in range(n):\n        anti_diag_sum += matrix[i][n - 1 - i]\n    return anti_diag_sum\n\ndef compare_all_sums(row_sums, col_sums, main_diag, anti_diag):\n    \"\"\"Compares all calculated sums for equality.\"\"\"\n    if not row_sums:\n        return False\n    \n    expected_sum = row_sums[0]\n    \n    if any(s != expected_sum for s in row_sums):\n        return False\n    \n    if any(s != expected_sum for s in col_sums):\n        return False\n    \n    if main_diag != expected_sum:\n        return False\n        \n    if anti_diag != expected_sum:\n        return False\n        \n    return True\n\ndef magic_square_test(matrix):\n    \"\"\"\n    Calculates whether the matrix is a magic square.\n    A magic square has all rows, columns, and diagonals sum to the same value.\n    \"\"\"\n    if not validate_square_matrix(matrix):\n        return False\n\n    row_sums = calculate_row_sums(matrix)\n    col_sums = calculate_column_sums(matrix)\n    main_diag_sum = calculate_main_diagonal_sum(matrix)\n    anti_diag_sum = calculate_anti_diagonal_sum(matrix)\n\n    return compare_all_sums(row_sums, col_sums, main_diag_sum, anti_diag_sum)"}
{"task_id": "Mbpp/129", "solution": "def _calculate_row_sums(matrix):\n    \"\"\"Calculates the sum of each row in the matrix.\"\"\"\n    return [sum(row) for row in matrix]\n\ndef _calculate_column_sums(matrix):\n    \"\"\"Calculates the sum of each column in the matrix.\"\"\"\n    n = len(matrix)\n    column_sums = [0] * n\n    for j in range(n):\n        for i in range(n):\n            column_sums[j] += matrix[i][j]\n    return column_sums\n\ndef _calculate_main_diagonal_sum(matrix):\n    \"\"\"Calculates the sum of the main diagonal (top-left to bottom-right).\"\"\"\n    n = len(matrix)\n    main_diagonal_sum = 0\n    for i in range(n):\n        main_diagonal_sum += matrix[i][i]\n    return main_diagonal_sum\n\ndef _calculate_anti_diagonal_sum(matrix):\n    \"\"\"Calculates the sum of the anti-diagonal (top-right to bottom-left).\"\"\"\n    n = len(matrix)\n    anti_diagonal_sum = 0\n    for i in range(n):\n        anti_diagonal_sum += matrix[i][n - 1 - i]\n    return anti_diagonal_sum\n\ndef _compare_all_sums(row_sums, col_sums, main_diag_sum, anti_diag_sum):\n    \"\"\"Compares all calculated sums for equality.\"\"\"\n    all_sums = []\n    all_sums.extend(row_sums)\n    all_sums.extend(col_sums)\n    all_sums.append(main_diag_sum)\n    all_sums.append(anti_diag_sum)\n    # A magic square requires all sums to be equal.\n    # Using a set to check if all elements are the same.\n    return len(set(all_sums)) == 1\n\ndef magic_square_test(matrix):\n    \"\"\"\n    Checks if a given matrix is a magic square.\n    A magic square has all row, column, and diagonal sums equal.\n    \"\"\"\n    row_sums = _calculate_row_sums(matrix)\n    col_sums = _calculate_column_sums(matrix)\n    main_diag_sum = _calculate_main_diagonal_sum(matrix)\n    anti_diag_sum = _calculate_anti_diagonal_sum(matrix)\n\n    return _compare_all_sums(row_sums, col_sums, main_diag_sum, anti_diag_sum)"}
{"task_id": "Mbpp/130", "solution": "def max_occurrences(input_list: list) -> int:\n    \"\"\"\n    Finds the item with the maximum frequency in a given list.\n    Returns None if the input list is empty.\n    \"\"\"\n    if not input_list:\n        return None\n\n    frequency_dict = {}\n    for item in input_list:\n        frequency_dict[item] = frequency_dict.get(item, 0) + 1\n\n    max_item = None\n    max_count = -1\n\n    # Iterate through the frequency dictionary to find the item with the highest count.\n    # The first item encountered with the maximum frequency will be returned, ensuring determinism.\n    for item, count in frequency_dict.items():\n        if count > max_count:\n            max_count = count\n            max_item = item\n\n    return max_item"}
