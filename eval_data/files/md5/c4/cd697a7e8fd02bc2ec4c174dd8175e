{"task_id": "Mbpp/643", "solution": "def text_match_wordz_middle(input_string: str) -> bool:\n    \"\"\"Checks if a string contains 'z' in the middle of any word.\"\"\"\n\n    def _is_word_boundary(char: str) -> bool:\n        \"\"\"Determines if a character is a word boundary (space or punctuation).\"\"\"\n        return not ('a' <= char.lower() <= 'z' or '0' <= char <= '9')\n\n    def _find_words(input_string: str) -> list[str]:\n        \"\"\"Parses the input string into individual words.\"\"\"\n        words = []\n        current_word = []\n        for char in input_string:\n            if not _is_word_boundary(char):\n                current_word.append(char)\n            else:\n                if current_word:\n                    words.append(\"\".join(current_word))\n                    current_word = []\n        if current_word:\n            words.append(\"\".join(current_word))\n        return words\n\n    def _check_z_position(word: str, position: int) -> bool:\n        \"\"\"Validates if 'z' at a given position is in the middle of the word.\"\"\"\n        return 0 < position < len(word) - 1\n\n    def _has_middle_z(word: str) -> bool:\n        \"\"\"Checks if a single word has 'z' in a middle position.\"\"\"\n        if len(word) < 3: # A word needs at least 3 characters for a middle 'z'\n            return False\n        for i, char in enumerate(word):\n            if char == 'z' and _check_z_position(word, i):\n                return True\n        return False\n\n    words = _find_words(input_string)\n    for word in words:\n        if _has_middle_z(word):\n            return True\n    return False"}
{"task_id": "Mbpp/643", "solution": "import re\n\ndef text_match_wordz_middle(input_string: str) -> bool:\n    \"\"\"\n    Checks if the input string contains 'z' in the middle of any word,\n    excluding the start and end of the word.\n    \"\"\"\n\n    def _parse_words(text: str) -> list[str]:\n        \"\"\"Extracts alphabetic words from the input string using regex.\"\"\"\n        return re.findall(r'[a-zA-Z]+', text)\n\n    def _check_word_middle_z(word: str) -> bool:\n        \"\"\"\n        Determines if a single word contains 'z' in its middle section.\n        This excludes the first and last characters of the word.\n        \"\"\"\n        if len(word) < 3:  # A word needs at least 3 characters for a 'middle'\n            return False\n        return 'z' in word[1:-1] or 'Z' in word[1:-1] # Case-insensitive check\n\n    words = _parse_words(input_string)\n    for word in words:\n        if _check_word_middle_z(word):\n            return True\n    return False"}
{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(array: list, k: int) -> list:\n    \"\"\"\n    Reverses the first k elements of an array while preserving the rest.\n    Combines the reversed prefix with the original suffix of the array.\n    \"\"\"\n    reversed_prefix = array[:k][::-1]\n    remaining_suffix = array[k:]\n    return reversed_prefix + remaining_suffix"}
{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(array: list, k: int) -> list:\n    \"\"\"\n    Reverses the first k elements of the input array.\n    \"\"\"\n    # Extract the first k elements and reverse them\n    reversed_part = array[:k][::-1]\n    # Combine the reversed part with the remaining elements\n    return reversed_part + array[k:]"}
