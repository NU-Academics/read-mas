{"task_id": "Mbpp/598", "solution": "def armstrong_number(number: int) -> bool:\n    \"\"\"\n    Checks if a given number is an Armstrong number.\n    An Armstrong number equals the sum of its digits, each raised to the power of the total number of digits.\n    \"\"\"\n    if number < 0:\n        return False\n    \n    original_number = number\n    \n    # Convert number to string to easily count digits and iterate through them\n    num_str = str(number)\n    num_digits = len(num_str)\n    \n    calculated_sum = 0\n    for digit_char in num_str:\n        digit = int(digit_char)\n        calculated_sum += digit ** num_digits\n        \n    return calculated_sum == original_number"}
{"task_id": "Mbpp/599", "solution": "def sum_average(n):\n    \"\"\"\n    Calculates the sum and average of the first n natural numbers using mathematical formulas.\n    Returns the sum as an integer and the average as a float in a tuple.\n    \"\"\"\n    total_sum = (n * (n + 1)) // 2\n    average = total_sum / n\n    return (total_sum, average)"}
{"task_id": "Mbpp/598", "solution": "def count_digits(number: int) -> int:\n    \"\"\"Counts the total number of digits in the given number.\"\"\"\n    return len(str(number))\n\ndef extract_digits(number: int) -> list[int]:\n    \"\"\"Extracts individual digits from the input number as a list of integers.\"\"\"\n    return [int(d) for d in str(number)]\n\ndef calculate_digit_sum(digits: list[int], power: int) -> int:\n    \"\"\"Calculates the sum of each digit raised to the specified power.\"\"\"\n    total_sum = 0\n    for digit in digits:\n        total_sum += digit ** power\n    return total_sum\n\ndef armstrong_number(number: int) -> bool:\n    \"\"\"\n    Checks whether the given number is an Armstrong number.\n    An Armstrong number equals the sum of its own digits each raised to the power of the number of digits.\n    \"\"\"\n    if number < 0:\n        return False # Armstrong numbers are typically defined for positive integers.\n\n    power = count_digits(number)\n    digits = extract_digits(number)\n    calculated_sum = calculate_digit_sum(digits, power)\n\n    return calculated_sum == number"}
