{"task_id": "Mbpp/61", "solution": "def count_Substrings(s: str) -> int:\n    \"\"\"\n    Counts the number of substrings where the sum of digits equals their length.\n    Iterates through all possible substrings, calculating digit sum incrementally.\n    \"\"\"\n    n = len(s)\n    count = 0\n    for i in range(n):\n        current_sum = 0\n        for j in range(i, n):\n            current_sum += int(s[j])\n            substring_length = j - i + 1\n            if current_sum == substring_length:\n                count += 1\n    return count"}
{"task_id": "Mbpp/61", "solution": "def count_Substrings(s: str) -> int:\n    \"\"\"\n    Counts substrings where the sum of their digit characters equals their length.\n    \"\"\"\n    n = len(s)\n    count = 0\n\n    for i in range(n):\n        current_sum = 0\n        for j in range(i, n):\n            # s[j] is the current digit character\n            current_sum += int(s[j])\n            \n            # The length of the substring s[i...j]\n            current_length = j - i + 1\n\n            if current_sum == current_length:\n                count += 1\n                \n    return count"}
