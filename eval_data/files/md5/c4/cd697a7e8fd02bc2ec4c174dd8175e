{"task_id": "Mbpp/463", "solution": "def max_subarray_product(arr):\n    \"\"\"\n    Find the maximum product of any contiguous subarray.\n\n    Args:\n        arr: List of numbers (int or float)\n\n    Returns:\n        Number representing the maximum product\n    \"\"\"\n    # Implementation using dynamic programming approach tracking max and min products, and handling zeros.\n    if not arr:\n        return 0 # Or raise an error, based on specific problem requirements for empty input\n\n    max_so_far = arr[0]\n    current_max = arr[0] # Stores the maximum product ending at the current position\n    current_min = arr[0] # Stores the minimum product ending at the current position\n\n    for i in range(1, len(arr)):\n        num = arr[i]\n\n        if num == 0:\n            current_max = 1\n            current_min = 1\n            max_so_far = max(max_so_far, 0) # Consider 0 as a possible maximum product\n            continue\n\n        # temp_max stores the current_max from the previous iteration\n        # This is needed because current_max might be updated before current_min uses its old value\n        temp_max = current_max \n        \n        current_max = max(num, temp_max * num, current_min * num)\n        current_min = min(num, temp_max * num, current_min * num)\n        \n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
{"task_id": "Mbpp/463", "solution": "def max_subarray_product(arr):\n    \"\"\"\n    Finds the maximum product of a contiguous subarray using a modified Kadane's algorithm.\n    Handles positive, negative, and zero values by tracking current max and min products.\n    \"\"\"\n    if not arr:\n        return 0\n\n    max_so_far = arr[0]\n    current_max_prod = arr[0]\n    current_min_prod = arr[0]\n\n    for i in range(1, len(arr)):\n        num = arr[i]\n\n        if num == 0:\n            # If current number is 0, any product including it becomes 0.\n            # Reset current products to 1 for the next segment and update max_so_far if 0 is the new maximum.\n            max_so_far = max(max_so_far, 0)\n            current_max_prod = 1\n            current_min_prod = 1\n            continue\n\n        # Calculate potential new max and min products for the subarray ending at 'num'.\n        # This considers 'num' itself, 'num' multiplied by the previous max, and 'num' multiplied by the previous min.\n        temp_max_prod = max(num, current_max_prod * num, current_min_prod * num)\n        temp_min_prod = min(num, current_max_prod * num, current_min_prod * num)\n\n        current_max_prod = temp_max_prod\n        current_min_prod = temp_min_prod\n\n        # Update the overall maximum product found so far.\n        max_so_far = max(max_so_far, current_max_prod)\n\n    return max_so_far"}
{"task_id": "Mbpp/470", "solution": "def add_pairwise(input_tuple):\n    \"\"\"\n    Calculates the pairwise sum of neighboring elements in the given tuple.\n    Returns a new tuple containing these sums.\n    \"\"\"\n    pairwise_sums = []\n    for i in range(len(input_tuple) - 1):\n        pairwise_sums.append(input_tuple[i] + input_tuple[i+1])\n    return tuple(pairwise_sums)"}
