{"task_id": "Mbpp/440", "solution": "import re\nfrom typing import List, Optional, Tuple\n\n_ADVERB_LIST_CACHE = None\n\ndef clean_punctuation(text: str) -> str:\n    \"\"\"Remove punctuation marks from text for analysis.\"\"\"\n    return re.sub(r'[^\\w\\s]', '', text)\n\ndef normalize_case(text: str) -> str:\n    \"\"\"Convert text to lowercase for comparison.\"\"\"\n    return text.lower()\n\ndef tokenize_words(text: str) -> List[str]:\n    \"\"\"Split text into individual word tokens.\"\"\"\n    return [word for word in text.split() if word]\n\ndef get_adverb_patterns() -> List[str]:\n    \"\"\"Return patterns for adverb identification.\"\"\"\n    # A simple, hardcoded list of common adverbs for demonstration.\n    # In a real system, this list would be more comprehensive or loaded from a lexicon.\n    global _ADVERB_LIST_CACHE\n    if _ADVERB_LIST_CACHE is None:\n        _ADVERB_LIST_CACHE = [\n            # Common adverbs ending in -ly\n            \"clearly\", \"quickly\", \"slowly\", \"badly\", \"happily\", \"loudly\", \"softly\", \"easily\", \"finally\",\n            # Common adverbs not ending in -ly\n            \"very\", \"always\", \"never\", \"often\", \"seldom\", \"sometimes\", \"usually\", \"ever\",\n            \"fast\", \"hard\", \"well\", \"here\", \"there\", \"now\", \"then\", \"soon\", \"today\", \"yesterday\", \"tomorrow\",\n            \"just\", \"already\", \"still\", \"yet\", \"too\", \"enough\", \"almost\", \"quite\", \"rather\",\n            \"away\", \"back\", \"down\", \"forward\", \"in\", \"off\", \"on\", \"out\", \"over\", \"up\"\n        ]\n    return _ADVERB_LIST_CACHE\n\ndef is_adverb(word: str) -> bool:\n    \"\"\"Check if a word is an adverb.\"\"\"\n    # This function expects a lowercase word for accurate comparison.\n    patterns = get_adverb_patterns()\n    if word in patterns:\n        return True\n    # Heuristic: many adverbs end in 'ly'. Exclude common adjectives.\n    if word.endswith('ly') and len(word) > 2:\n        if word in [\"friendly\", \"lovely\", \"ugly\", \"silly\", \"lonely\", \"holy\", \"jolly\", \"hilly\", \"early\"]:\n            return False\n        return True\n    return False\n\ndef find_first_adverb(words: List[str]) -> Optional[str]:\n    \"\"\"Find the first adverb in a list of words.\"\"\"\n    for word in words:\n        if is_adverb(word):\n            return word\n    return None\n\ndef calculate_positions(original_text: str, adverb: str) -> Tuple[int, int]:\n    \"\"\"Calculate start and end positions of adverb in original text.\"\"\"\n    # Finds the first occurrence of the adverb (case-insensitively) in the original text.\n    start_index = original_text.lower().find(adverb)\n    end_index = start_index + len(adverb)\n    return (start_index, end_index)\n\ndef format_result(start: int, end: int, adverb: str) -> Tuple[int, int, str]:\n    \"\"\"Format the final result tuple.\"\"\"\n    return (start, end, adverb)\n\ndef find_adverb_position(sentence: str) -> Optional[Tuple[int, int, str]]:\n    \"\"\"Find the first adverb and its position in the given sentence.\"\"\"\n\n    cleaned_text = clean_punctuation(sentence)\n    normalized_text = normalize_case(cleaned_text)\n    words = tokenize_words(normalized_text)\n\n    found_adverb = find_first_adverb(words)\n\n    if found_adverb:\n        start_pos, end_pos = calculate_positions(sentence, found_adverb)\n        return format_result(start_pos, end_pos, found_adverb)\n    else:\n        return None"}
