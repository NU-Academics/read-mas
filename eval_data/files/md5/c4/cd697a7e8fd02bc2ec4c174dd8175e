{"task_id": "Mbpp/757", "solution": "def count_reverse_pairs(string_list: list[str]) -> int:\n    \"\"\"Counts pairs of reverse strings in the given list.\"\"\"\n\n    class StringProcessor:\n        \"\"\"Handles string reversal and comparison operations.\"\"\"\n        def reverse_string(self, s: str) -> str:\n            return s[::-1]\n\n        def are_reverse(self, s1: str, s2: str) -> bool:\n            return s1 == self.reverse_string(s2)\n\n    class PairCounter:\n        \"\"\"Tracks and counts valid reverse pairs while preventing duplicates.\"\"\"\n        def __init__(self):\n            self._count: int = 0\n            # Stores canonical form of pairs (sorted tuple of strings) to prevent recounting.\n            self._processed_pairs: set[tuple[str, str]] = set()\n\n        def increment(self):\n            self._count += 1\n\n        def get_count(self) -> int:\n            return self._count\n\n        def add_pair(self, s1: str, s2: str):\n            # Create a canonical representation of the pair by sorting the strings.\n            canonical_pair = tuple(sorted((s1, s2)))\n            if canonical_pair not in self._processed_pairs:\n                self._processed_pairs.add(canonical_pair)\n                self.increment()\n\n    # Handle edge cases for input list length.\n    if len(string_list) < 2:\n        return 0\n\n    string_processor = StringProcessor()\n    pair_counter = PairCounter()\n\n    # Iterate through all unique combinations of strings.\n    n = len(string_list)\n    for i in range(n):\n        for j in range(i + 1, n):  # Start j from i+1 to avoid self-comparison and duplicate pairs.\n            s1 = string_list[i]\n            s2 = string_list[j]\n\n            if string_processor.are_reverse(s1, s2):\n                pair_counter.add_pair(s1, s2)\n\n    return pair_counter.get_count()"}
{"task_id": "Mbpp/759", "solution": "def is_decimal(input_string: str) -> bool:\n    \"\"\"\n    Check whether a given string is a decimal number with precision of 2.\n\n    Args:\n        input_string (str): String to validate\n\n    Returns:\n        bool: True if valid decimal with 2 decimal places, False otherwise\n    \"\"\"\n    # Check for exactly one decimal point in the string.\n    if input_string.count('.') != 1:\n        return False\n\n    # Split the string into two parts: integer and decimal.\n    integer_part, decimal_part = input_string.split('.')\n\n    # The integer part must contain only digits and not be an empty string.\n    if not integer_part.isdigit():\n        return False\n\n    # The decimal part must have exactly two digits and contain only digits.\n    if len(decimal_part) != 2 or not decimal_part.isdigit():\n        return False\n\n    return True"}
{"task_id": "Mbpp/757", "solution": "def count_reverse_pairs(strings: list) -> int:\n    \"\"\"\n    Counts pairs of strings in the list where one string is the reverse of the other,\n    performing a case-insensitive comparison.\n    \"\"\"\n    def _normalize_string(s: str) -> str:\n        \"\"\"Converts a string to lowercase for case-insensitive comparison.\"\"\"\n        return s.lower()\n\n    def _is_reverse_pair(str1: str, str2: str) -> bool:\n        \"\"\"Checks if two strings are reverse pairs after normalization.\"\"\"\n        n_str1 = _normalize_string(str1)\n        n_str2 = _normalize_string(str2)\n        return n_str1 == n_str2[::-1]\n\n    pair_count = 0\n    n = len(strings)\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            if _is_reverse_pair(strings[i], strings[j]):\n                pair_count += 1\n    return pair_count"}
{"task_id": "Mbpp/759", "solution": "def is_decimal(input_string: str) -> bool:\n    \"\"\"Checks if a string represents a decimal number with exactly two decimal places.\n    It validates the presence of a decimal point and ensures correct digit counts.\n    \"\"\"\n    if not input_string:\n        return False\n\n    # Check for a single decimal point\n    parts = input_string.split('.')\n    if len(parts) != 2:\n        return False\n\n    integer_part = parts[0]\n    decimal_part = parts[1]\n\n    # Validate the integer part: must not be empty and must contain only digits\n    if not integer_part or not integer_part.isdigit():\n        return False\n\n    # Validate the decimal part: must have exactly 2 digits and contain only digits\n    if len(decimal_part) != 2 or not decimal_part.isdigit():\n        return False\n\n    return True"}
