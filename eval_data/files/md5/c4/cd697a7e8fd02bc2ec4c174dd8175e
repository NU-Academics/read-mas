{"task_id": "Mbpp/16", "solution": "def text_lowercase_underscore(input_string: str) -> bool:\n    \"\"\"\n    Checks if the input string contains sequences of lowercase letters joined by underscores.\n    Each sequence must consist solely of lowercase letters.\n    \"\"\"\n\n    def validate_lowercase_sequence(sequence: str) -> bool:\n        \"\"\"Checks if a string segment contains only lowercase letters.\"\"\"\n        if not sequence:\n            return False\n        for char in sequence:\n            if not ('a' <= char <= 'z'):\n                return False\n        return True\n\n    def validate_underscore_separation(string: str) -> bool:\n        \"\"\"Ensures underscores are properly used as separators, not at edges or consecutive.\"\"\"\n        if not string:\n            return False\n        if string[0] == '_' or string[-1] == '_':\n            return False\n        for i in range(len(string) - 1):\n            if string[i] == '_' and string[i+1] == '_':\n                return False\n        return True\n\n    def split_by_underscore(string: str) -> list[str]:\n        \"\"\"Splits the input string into a list of segments using underscore as a delimiter.\"\"\"\n        return string.split('_')\n\n    if not validate_underscore_separation(input_string):\n        return False\n\n    segments = split_by_underscore(input_string)\n\n    for segment in segments:\n        if not validate_lowercase_sequence(segment):\n            return False\n\n    return True"}
