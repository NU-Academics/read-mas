{"task_id": "Mbpp/607", "solution": "import re\nfrom typing import Optional, Tuple\n\ndef validate_pattern(pattern: str) -> bool:\n    \"\"\"Validate if pattern is valid regex syntax.\"\"\"\n    try:\n        re.compile(pattern)\n        return True\n    except re.error:\n        return False\n\ndef compile_pattern(pattern: str) -> Optional[re.Pattern]:\n    \"\"\"Compile pattern with error handling.\"\"\"\n    try:\n        return re.compile(pattern)\n    except re.error:\n        return None\n\ndef build_result(match: re.Match, text: str) -> Tuple[str, int, int]:\n    \"\"\"Build result tuple from successful match.\"\"\"\n    return match.group(0), match.start(), match.end()\n\ndef build_no_match_result() -> Optional[Tuple[str, int, int]]:\n    \"\"\"Handle no match case according to SRS requirements.\"\"\"\n    return None\n\ndef _find_first_match(text: str, compiled_pattern: re.Pattern) -> Optional[re.Match]:\n    \"\"\"Internal helper to find first pattern match.\"\"\"\n    return compiled_pattern.search(text)\n\ndef find_literals(text: str, pattern: str) -> Optional[Tuple[str, int, int]]:\n    \"\"\"Search for regex pattern in text and return match info.\"\"\"\n    if not validate_pattern(pattern):\n        return build_no_match_result()\n\n    compiled_regex = compile_pattern(pattern)\n    if compiled_regex is None:\n        return build_no_match_result()\n\n    match = _find_first_match(text, compiled_regex)\n\n    if match:\n        return build_result(match, text)\n    else:\n        return build_no_match_result()"}
{"task_id": "Mbpp/610", "solution": "def remove_kth_element(input_list, k):\n    \"\"\"\n    Returns a new list with the element at the specified zero-based index k removed.\n    The original list remains unchanged.\n    \"\"\"\n    # Uses slicing to create a new list by concatenating elements before and after the k-th index.\n    # The design context specifies zero-based indexing where k=0 refers to the first element.\n    return input_list[:k] + input_list[k+1:]"}
{"task_id": "Mbpp/611", "solution": "def extract_column(matrix, n):\n    \"\"\"Extracts values from the specified column of the matrix.\"\"\"\n    column_values = []\n    for row in matrix:\n        column_values.append(row[n])\n    return column_values\n\ndef find_maximum(values):\n    \"\"\"Calculates the maximum value from a list of numerical values.\"\"\"\n    # The built-in max() function will raise ValueError if values is empty.\n    return max(values)\n\ndef max_of_nth(matrix, n):\n    \"\"\"\n    Given a matrix (list of lists), returns the maximum value of the n'th column.\n    This function relies on Python's built-in error handling for invalid matrix\n    structures or out-of-bounds column indices.\n    \"\"\"\n    column = extract_column(matrix, n)\n    maximum_value = find_maximum(column)\n    return maximum_value"}
