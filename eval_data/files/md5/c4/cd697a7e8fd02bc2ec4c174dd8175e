{"task_id": "Mbpp/97", "solution": "def frequency_lists(nested_lists):\n    \"\"\"\n    Flattens a list of lists and counts the frequency of each element.\n    Returns a dictionary with elements as keys and their frequencies as values.\n    \"\"\"\n    flattened_list = [item for sublist in nested_lists for item in sublist]\n\n    frequency_map = {}\n    for element in flattened_list:\n        frequency_map[element] = frequency_map.get(element, 0) + 1\n\n    return frequency_map"}
{"task_id": "Mbpp/97", "solution": "def frequency_lists(list_of_lists: list[list]) -> dict:\n    \"\"\"\n    Finds the frequency of each element in a flattened list of lists.\n    \"\"\"\n\n    def flatten_lists(nested_lists: list[list]) -> list:\n        \"\"\"Flattens a list of lists into a single list.\"\"\"\n        flattened = []\n        for sublist in nested_lists:\n            flattened.extend(sublist)\n        return flattened\n\n    def count_frequencies(flattened_list: list) -> dict:\n        \"\"\"Counts the frequency of each element in a flat list.\"\"\"\n        frequencies = {}\n        for element in flattened_list:\n            frequencies[element] = frequencies.get(element, 0) + 1\n        return frequencies\n\n    flattened_data = flatten_lists(list_of_lists)\n    return count_frequencies(flattened_data)"}
{"task_id": "Mbpp/98", "solution": "def multiply_num(numbers):\n    \"\"\"\n    Multiplies all numbers in a list or tuple and divides the product by the collection's length.\n    Assumes the input collection is not empty to avoid division by zero.\n    \"\"\"\n    product = 1\n    for num in numbers:\n        product *= num\n    \n    length = len(numbers)\n    \n    return product / length"}
{"task_id": "Mbpp/98", "solution": "from functools import reduce\nimport operator\n\ndef multiply_num(numbers: list | tuple) -> float:\n    \"\"\"Multiplies all numbers in a collection and divides by its length.\n    Raises ValueError for empty input collections to prevent division by zero.\n    \"\"\"\n    if not numbers:\n        raise ValueError(\"Cannot process empty list or tuple\")\n\n    # Calculate the product of all numbers, initializing with 1.0 to ensure a float result.\n    product = reduce(operator.mul, numbers, 1.0)\n    \n    # Divide the product by the length of the collection.\n    result = product / len(numbers)\n    \n    return result"}
{"task_id": "Mbpp/99", "solution": "```python\ndef decimal_to_binary(decimal_number: int) -> str:\n    \"\"\"\n    Converts a decimal number to its binary equivalent as a string.\n    Ensures the output string has no leading zeros.\n    \"\"\"\n    if decimal_number == 0:\n        return '0'\n\n    binary_string = \"\"\n    temp_number = decimal_number\n\n    while temp_number > 0:\n        remainder = temp_number % 2\n        binary_string = str(remainder) + binary_string\n        temp_number //= 2\n\n    return binary_string\n```"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(decimal_number: int) -> str:\n    \"\"\"\n    Converts a decimal number to its binary equivalent as a string with no leading zeros.\n    Handles the special case for 0 directly, and uses Python's built-in conversion for others.\n    \"\"\"\n    if decimal_number == 0:\n        return '0'\n    # Python's bin() function returns a string prefixed with '0b'.\n    # Slicing [2:] removes this prefix.\n    return bin(decimal_number)[2:]"}
{"task_id": "Mbpp/100", "solution": "def reverse_digits(n: int) -> int:\n    \"\"\"Reverses the digits of a non-negative integer.\n    For example, reverse_digits(123) returns 321.\"\"\"\n    reversed_num = 0\n    temp_n = n\n    while temp_n > 0:\n        digit = temp_n % 10\n        reversed_num = reversed_num * 10 + digit\n        temp_n //= 10\n    return reversed_num\n\ndef is_palindrome(n: int) -> bool:\n    \"\"\"Checks if a non-negative integer is a palindrome.\"\"\"\n    if n < 0:\n        return False # Negative numbers are not considered palindromes in this context\n    return n == reverse_digits(n)\n\ndef increment_candidate(n: int) -> int:\n    \"\"\"Increments an integer by one.\"\"\"\n    return n + 1\n\ndef next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome greater than the specified integer.\n    It iteratively increments the input number until a palindrome is found.\n    \"\"\"\n    candidate = increment_candidate(n)\n    while True:\n        if is_palindrome(candidate):\n            return candidate\n        candidate = increment_candidate(candidate)"}
