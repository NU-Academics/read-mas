{"task_id": "Mbpp/622", "solution": "def merge_sorted_lists(list1, list2):\n    \"\"\"Merges two sorted lists into a single sorted list.\"\"\"\n    merged = []\n    i, j = 0, 0\n    n1, n2 = len(list1), len(list2)\n\n    while i < n1 and j < n2:\n        if list1[i] <= list2[j]:\n            merged.append(list1[i])\n            i += 1\n        else:\n            merged.append(list2[j])\n            j += 1\n\n    while i < n1:\n        merged.append(list1[i])\n        i += 1\n\n    while j < n2:\n        merged.append(list2[j])\n        j += 1\n    return merged\n\ndef find_median_value(merged_list):\n    \"\"\"Calculates the median of a single sorted list.\"\"\"\n    n = len(merged_list)\n    if n % 2 == 1:\n        return float(merged_list[n // 2])\n    else:\n        mid1 = merged_list[n // 2 - 1]\n        mid2 = merged_list[n // 2]\n        return float((mid1 + mid2) / 2)\n\ndef get_median(list1, list2, size):\n    \"\"\"\n    Calculates the median of two sorted lists of the same size.\n    It merges the lists and then finds the median of the combined list.\n    \"\"\"\n    merged_list = merge_sorted_lists(list1, list2)\n    median = find_median_value(merged_list)\n    return median"}
{"task_id": "Mbpp/620", "solution": "from typing import List\n\ndef is_pair_divisible(a: int, b: int) -> bool:\n    \"\"\"\n    Checks if two numbers form a divisible pair (one divides the other),\n    handling zero divisors to avoid ZeroDivisionError.\n    \"\"\"\n    if a == 0 and b == 0:\n        return False  # Conventionally, 0 does not divide 0.\n    if a == 0:  # If 'a' is zero, 'b' must be non-zero (due to the above check)\n        return True  # 'b' divides 'a' (0 % b == 0).\n    if b == 0:  # If 'b' is zero, 'a' must be non-zero\n        return True  # 'a' divides 'b' (0 % a == 0).\n    \n    return a % b == 0 or b % a == 0\n\ndef is_valid_subset(subset: List[int]) -> bool:\n    \"\"\"\n    Validates if all pairs in the given subset are divisible.\n    An empty or single-element subset is considered valid.\n    \"\"\"\n    n = len(subset)\n    if n <= 1:\n        return True\n    \n    for i in range(n):\n        for j in range(i + 1, n):\n            if not is_pair_divisible(subset[i], subset[j]):\n                return False\n    return True\n\ndef generate_all_subsets(numbers: List[int]) -> List[List[int]]:\n    \"\"\"\n    Generates all possible subsets of the input list recursively.\n    \"\"\"\n    if not numbers:\n        return [[]]\n    \n    first = numbers[0]\n    rest = numbers[1:]\n    \n    subsets_of_rest = generate_all_subsets(rest)\n    \n    all_subsets = []\n    for s in subsets_of_rest:\n        all_subsets.append(s)  # Subset without the first element.\n        all_subsets.append([first] + s)  # Subset with the first element.\n    \n    return all_subsets\n\ndef largest_subset(numbers: List[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset of a list of numbers\n    where every pair in the subset is divisible by the other.\n    \"\"\"\n    max_size = 0\n    \n    all_subsets = generate_all_subsets(numbers)\n    \n    for subset in all_subsets:\n        if is_valid_subset(subset):\n            max_size = max(max_size, len(subset))\n            \n    return max_size"}
