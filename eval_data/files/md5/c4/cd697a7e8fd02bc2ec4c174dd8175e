{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the series (n - 2*i) from i=0 to n//2.\n    Terms less than or equal to 0 are not included in the sum.\n    \"\"\"\n    total_sum = 0\n    # Iterate from i=0 up to n//2 (inclusive)\n    for i in range(n // 2 + 1):\n        term = n - 2 * i\n        # Only add terms that are greater than 0\n        if term > 0:\n            total_sum += term\n    return total_sum"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculate sum of series (n - 2*i) from i=0 to n//2.\n    Terms are included only if they are greater than 0.\n    \"\"\"\n    total_sum = 0\n    for i in range(n // 2 + 1):\n        term = n - 2 * i\n        if term > 0:\n            total_sum += term\n        else:\n            # According to the problem description, stop if term <= 0\n            break \n    return total_sum"}
{"task_id": "Mbpp/160", "solution": "def find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"\n    Find integer solution to linear Diophantine equation ax + by = n.\n    Returns a tuple (x, y) if a solution exists, None otherwise.\n    \"\"\"\n    def _extended_euclidean(val_a: int, val_b: int) -> tuple[int, int, int]:\n        \"\"\"\n        Implements the Extended Euclidean Algorithm to find gcd(val_a, val_b) and coefficients x, y\n        such that val_a*x + val_b*y = gcd(val_a, val_b).\n        \"\"\"\n        if val_b == 0:\n            return val_a, 1, 0\n\n        gcd_val, x1, y1 = _extended_euclidean(val_b, val_a % val_b)\n        x = y1\n        y = x1 - (val_a // val_b) * y1\n        return gcd_val, x, y\n\n    def _verify_solution(x: int, y: int, check_a: int, check_b: int, check_n: int) -> bool:\n        \"\"\"\n        Verifies if the given x and y satisfy the equation check_a*x + check_b*y = check_n.\n        \"\"\"\n        return (check_a * x + check_b * y) == check_n\n\n    def _handle_edge_cases(handle_a: int, handle_b: int, handle_n: int) -> tuple[int, int] | None | bool:\n        \"\"\"\n        Processes edge cases where coefficients handle_a or handle_b are zero, returning a solution, None, or False.\n        Solutions found here are verified using _verify_solution.\n        \"\"\"\n        if handle_a == 0 and handle_b == 0:\n            return (0, 0) if handle_n == 0 else None\n        elif handle_a == 0:\n            if handle_n % handle_b == 0:\n                y_sol = handle_n // handle_b\n                if _verify_solution(0, y_sol, handle_a, handle_b, handle_n):\n                    return (0, y_sol)\n            return None\n        elif handle_b == 0:\n            if handle_n % handle_a == 0:\n                x_sol = handle_n // handle_a\n                if _verify_solution(x_sol, 0, handle_a, handle_b, handle_n):\n                    return (x_sol, 0)\n            return None\n        return False # Not an edge case for this function to fully resolve\n\n    # Handle edge cases for a=0 or b=0\n    edge_case_result = _handle_edge_cases(a, b, n)\n    if edge_case_result is not False:\n        return edge_case_result\n\n    # For the general case, both a and b are non-zero.\n    # Use absolute values for _extended_euclidean to ensure positive gcd.\n    # Coefficients x_g, y_g are then adjusted for original signs of a and b.\n    abs_a = abs(a)\n    abs_b = abs(b)\n\n    gcd, x_g, y_g = _extended_euclidean(abs_a, abs_b)\n\n    # Adjust x_g and y_g based on original signs of a and b\n    if a < 0:\n        x_g = -x_g\n    if b < 0:\n        y_g = -y_g\n\n    # Now, a * x_g + b * y_g = gcd.\n    # Check if n is divisible by gcd; if not, no integer solution exists.\n    if n % gcd != 0:\n        return None\n\n    # Scale the solution to find a particular solution for ax + by = n.\n    k = n // gcd\n    x_particular = x_g * k\n    y_particular = y_g * k\n\n    # Adjust the particular solution (x_particular, y_particular) to find a \"canonical\" solution,\n    # typically one with the smallest non-negative x.\n    # The general solution is x = x_particular + (b/gcd)*t, y = y_particular - (a/gcd)*t.\n    # We find 't' such that x is in the range [0, |b/gcd| - 1] (or similar canonical range).\n    mod_val_b = b // gcd # This is the coefficient for 't' in the x-equation.\n    x_final = x_particular % mod_val_b\n    \n    # Calculate the corresponding y_final for the adjusted x_final.\n    # Since ax_final + by_final = n, then by_final = n - ax_final.\n    y_final = (n - a * x_final) // b\n\n    # Verify the final solution before returning.\n    if _verify_solution(x_final, y_final, a, b, n):\n        return (x_final, y_final)\n    else:\n        # This branch indicates an unexpected calculation error.\n        return None"}
{"task_id": "Mbpp/165", "solution": "def normalize_character(c: str) -> str:\n    \"\"\"Converts a single character to its lowercase form.\"\"\"\n    return c.lower()\n\ndef is_alphabetic(c: str) -> bool:\n    \"\"\"Checks if a single character is an alphabet letter.\"\"\"\n    return c.isalpha()\n\ndef get_alphabet_position(c: str) -> int:\n    \"\"\"Maps a lowercase alphabetic character to its 0-based position.\"\"\"\n    return ord(c) - ord('a')\n\ndef matches_position(char: str, string_pos: int) -> bool:\n    \"\"\"Determines if the character's alphabet position matches the string position.\"\"\"\n    # This function expects 'char' to be a normalized (lowercase) alphabetic character.\n    return get_alphabet_position(char) == string_pos\n\ndef count_char_position(s: str) -> int:\n    \"\"\"\n    Counts characters in a string that occur at the same position\n    as in the English alphabet (case insensitive).\n    \"\"\"\n    match_count = 0\n    for string_pos, char in enumerate(s):\n        if is_alphabetic(char):\n            normalized_char = normalize_character(char)\n            if matches_position(normalized_char, string_pos):\n                match_count += 1\n    return match_count"}
{"task_id": "Mbpp/165", "solution": "ALPHABET_LETTERS = \"abcdefghijklmnopqrstuvwxyz\"\n\ndef normalize_character(char: str) -> str:\n    \"\"\"Converts a character to its lowercase form.\"\"\"\n    return char.lower()\n\ndef is_valid_position(position: int) -> bool:\n    \"\"\"Checks if a given position is valid within the alphabet range (0-25).\"\"\"\n    return 0 <= position < len(ALPHABET_LETTERS)\n\ndef get_alphabet_letter(position: int) -> str:\n    \"\"\"Returns the alphabet letter at the specified 0-indexed position.\"\"\"\n    return ALPHABET_LETTERS[position]\n\ndef count_char_position(input_string: str) -> int:\n    \"\"\"Counts characters in a string that match their alphabet position (case-insensitive).\"\"\"\n    match_count = 0\n    for i, char in enumerate(input_string):\n        if is_valid_position(i):\n            normalized_char = normalize_character(char)\n            expected_char = get_alphabet_letter(i)\n            if normalized_char == expected_char:\n                match_count += 1\n    return match_count"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(numbers: list[int]) -> int:\n    \"\"\"Counts pairs of integers in a list that XOR to an even number.\"\"\"\n\n    def generate_pairs(nums: list[int]) -> list[tuple[int, int]]:\n        \"\"\"Generates all unique pairs from distinct list positions.\"\"\"\n        pairs = []\n        n = len(nums)\n        for i in range(n):\n            for j in range(i + 1, n):\n                pairs.append((nums[i], nums[j]))\n        return pairs\n\n    def calculate_xor(a: int, b: int) -> int:\n        \"\"\"Performs XOR operation on two integers.\"\"\"\n        return a ^ b\n\n    def is_even(number: int) -> bool:\n        \"\"\"Determines if a number is even.\"\"\"\n        return number % 2 == 0\n\n    even_xor_count = 0\n    all_pairs = generate_pairs(numbers)\n\n    for num1, num2 in all_pairs:\n        xor_result = calculate_xor(num1, num2)\n        if is_even(xor_result):\n            even_xor_count += 1\n            \n    return even_xor_count"}
