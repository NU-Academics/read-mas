{"task_id": "HumanEval/26", "solution": "from typing import List\ndef _element_counts(numbers: List[int]) -> dict[int, int]:\n    \"\"\"Computes the frequency of each element in a list.\n    Returns a dictionary mapping each number to its count.\"\"\"\n    counts = {}\n    for num in numbers:\n        counts[num] = counts.get(num, 0) + 1\n    return counts\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    >>> remove_duplicates([1, 2, 3, 2, 4])\n    [1, 3, 4]\n    \"\"\"\n    counts = _element_counts(numbers)\n    result = []\n    for num in numbers:\n        if counts[num] == 1:\n            result.append(num)\n    return result"}
