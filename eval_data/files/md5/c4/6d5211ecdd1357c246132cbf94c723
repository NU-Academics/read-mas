{"task_id": "HumanEval/27", "solution": "def is_upper(char: str) -> bool:\n    \"\"\"Return True if char is an uppercase letter.\"\"\"\n    return char.isupper()\ndef is_lower(char: str) -> bool:\n    \"\"\"Return True if char is a lowercase letter.\"\"\"\n    return char.islower()\ndef to_upper(char: str) -> str:\n    \"\"\"Convert a single character to uppercase.\"\"\"\n    return char.upper()\ndef to_lower(char: str) -> str:\n    \"\"\"Convert a single character to lowercase.\"\"\"\n    return char.lower()\ndef flip_case(string: str) -> str:\n    \"\"\" For a given string, flip lowercase characters to uppercase and uppercase to lowercase.\n    >>> flip_case('Hello')\n    'hELLO'\n    \"\"\"\n    if not string:\n        return \"\"\n\n    flipped_chars = []\n    for char in string:\n        if is_lower(char):\n            flipped_chars.append(to_upper(char))\n        elif is_upper(char):\n            flipped_chars.append(to_lower(char))\n        else:\n            flipped_chars.append(char)\n\n    return \"\".join(flipped_chars)"}
{"task_id": "HumanEval/24", "solution": "def largest_divisor(n: int) -> int:\n    \"\"\" For a given number n, find the largest number that divides n evenly, smaller than n\n    >>> largest_divisor(15)\n    5\n    \"\"\"\n    # Validate input: n must be an integer greater than 1 as per design preconditions.\n    if not isinstance(n, int) or n <= 1:\n        raise ValueError(\"n must be integer and > 1\")\n\n    # Iterate from 2 up to the square root of n to find the smallest factor.\n    # The first factor 'i' found will yield the largest proper divisor 'n // i'.\n    for i in range(2, int(n**0.5) + 1):\n        if n % i == 0:\n            return n // i\n\n    # If no divisors are found in the loop, 'n' is a prime number (since n > 1).\n    # In this case, the largest proper divisor is 1.\n    return 1"}
{"task_id": "HumanEval/25", "solution": "from typing import List\nfrom .service import FactorizationService\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    return FactorizationService().factorize(n)"}
