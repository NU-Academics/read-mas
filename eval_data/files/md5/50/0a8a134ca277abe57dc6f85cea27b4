 return False\n        if num <= 3:\n            return True\n        if num % 2 == 0 or num % 3 == 0:\n            return False\n        i = 5\n        while i * i <= num:\n            if num % i == 0 or num % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    if is_prime(n):\n        return x\n    else:\n        return y", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/154": [{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"Checks if the second word or any of its rotations is a substring in the first word.\"\"\"\n    if not b:\n        return True\n    if len(b) > len(a):\n        return False\n\n    def _generate_cyclic_rotations(s: str) -> list[str]:\n        \"\"\"Generates all unique cyclic rotations of a given string.\"\"\"\n        rotations = set()\n        n = len(s)\n        for i in range(n):\n            rotated_s = s[i:] + s[:i]\n            rotations.add(rotated_s)\n        return list(rotations)\n\n    rotations_of_b = _generate_cyclic_rotations(b)\n\n    for rotation in rotations_of_b:\n        if rotation in a:\n            return True\n            \n    return False", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/155": [{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n    # Convert the absolute number to a string to iterate through its digits.\n    for digit_char in str(abs(num)):\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n    return (even_count, odd_count)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/153": [{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"You will be given the name of a class (a string) and a list of extensions.\n    The extensions are to be used to load additional classes to the class. The\n    strength of the extension is as follows: Let CAP be the number of the uppercase\n    letters in the extension's name, and let SM be the number of lowercase letters \n    in the extension's name, the strength is given by the fraction CAP - SM. \n    You should find the strongest extension and return a string in this \n    format: ClassName.StrongestExtensionName.\n    If there are two or more extensions with the same strength, you should\n    choose the one that comes first in the list.\n    For example, if you are given \"Slices\" as the class and a list of the\n    extensions: ['SErviNGSliCes', 'Cheese', 'StuFfed'] then you should\n    return 'Slices.SErviNGSliCes' since 'SErviNGSliCes' is the strongest extension \n    (its strength is -1).\n    Example:\n    for Strongest_Extension('my_class', ['AA', 'Be', 'CC']) == 'my_class.AA'\n    \"\"\"\n    # Helper class to encapsulate an extension's name and its calculated strength.\n    class Extension:\n        def __init__(self, name: str, strength: int):\n            self.name = name\n            self.strength = strength\n\n    # Helper function to calculate the strength for a given extension name (CAP - SM).\n    def _calculate_strength(extension_name: str) -> int:\n        cap_count = 0\n        sm_count = 0\n        for char in extension_name:\n            if 'A' <= char <= 'Z':\n                cap_count += 1\n            elif 'a' <= char <= 'z':\n                sm_count += 1\n        return cap_count - sm_count\n\n    processed_extensions = []\n    for ext_name in extensions:\n        strength = _calculate_strength(ext_name)\n        processed_extensions.append(Extension(ext_name, strength))\n\n    # Initialize the strongest extension with the first one to handle tie-breaking.\n    strongest_ext_obj = processed_extensions[0]\n    max_strength = strongest_ext_obj.strength\n\n    # Iterate through the rest of the extensions to find the strongest.\n    for i in range(1, len(processed_extensions)):\n        current_ext_obj = processed_extensions[i]\n        # Update if the current extension's strength is strictly greater.\n        # This naturally handles the tie-breaking rule by keeping the first encountered.\n        if current_ext_obj.strength > max_strength:\n            max_strength = current_ext_obj.strength\n            strongest_ext_obj = current_ext_obj\n\n    return f\"{class_name}.{strongest_ext_obj.name}\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/157": [{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or \n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    \n    class Triangle:\n        \"\"\"Encapsulates triangle side lengths and provides logic to check for a right angle.\"\"\"\n        \n        def __init__(self, a: float, b: float, c: float):\n            \"\"\"Initializes a Triangle object with three side lengths, sorted for convenience.\"\"\"\n            self._sides = sorted([a, b, c])\n\n        def determineIfRightAngled(self) -> bool:\n            \"\"\"Checks if the triangle is right-angled using the Pythagorean theorem, considering floating-point precision.\"\"\"\n            s1, s2, s3 = self._sides\n            # Use a small epsilon for floating-point comparison\n            epsilon = 1e-9\n            return abs(s3**2 - (s1**2 + s2**2)) < ep