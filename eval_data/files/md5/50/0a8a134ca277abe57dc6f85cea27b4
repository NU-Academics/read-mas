{self.row}, column={self.column})\"\nclass CoordinateList:\n    \"\"\"Collects Coordinate objects and provides sorting capabilities.\"\"\"\n    def __init__(self):\n        self._coordinates: List[Coordinate] = []\n\n    def add_coordinate(self, coord: Coordinate):\n        self._coordinates.append(coord)\n\n    def get_sorted_coordinates(self) -> List[Tuple[int, int]]:\n        \"\"\"Sorts the collected coordinates and returns them as a list of (row, column) tuples.\"\"\"\n        self._coordinates.sort()\n        return [coord.to_tuple() for coord in self._coordinates]\ndef get_row(lst: List[List[int]], x: int) -> List[Tuple[int, int]]:\n    \"\"\"\n    Finds integer x in the nested list lst and returns a list of its (row, column) coordinates.\n    Coordinates are sorted primarily by rows ascending, then by columns descending.\n    \"\"\"\n    coordinate_list = CoordinateList()\n\n    for row_idx, row_data in enumerate(lst):\n        for col_idx, element in enumerate(row_data):\n            if element == x:\n                coordinate_list.add_coordinate(Coordinate(row_idx, col_idx))\n\n    return coordinate_list.get_sorted_coordinates()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/90": [{"task_id": "HumanEval/90", "solution": "def next_smallest(lst):\n    \"\"\"\n    Returns the 2nd smallest distinct element of the list, or None if not available.\n    \"\"\"\n    distinct_elements = sorted(list(set(lst)))\n    if len(distinct_elements) < 2:\n        return None\n    else:\n        return distinct_elements[1]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/92": [{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    '''\n    Create a function that takes 3 numbers.\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns false in any other cases.\n    \n    Examples\n   