_word = word\n\n    return result_word", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/160": [{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Constructs an algebraic expression from operators and operands, then evaluates it.\n    The expression is built respecting standard operator precedence.\n    \"\"\"\n    expression_parts = [str(operand[0])]\n\n    for i in range(len(operator)):\n        expression_parts.append(operator[i])\n        expression_parts.append(str(operand[i + 1]))\n\n    expression_string = \" \".join(expression_parts)\n    return eval(expression_string)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/159": [{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates the total number of eaten carrots and the remaining carrots after a meal.\n    \"\"\"\n    carrots_eaten_during_meal = min(need, remaining)\n    total_carrots_eaten = number + carrots_eaten_during_meal\n    carrots_left = remaining - carrots_eaten_during_meal\n    return [total_carrots_eaten, carrots_left]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/161": [{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa, \n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    Examples\n    solve(\"1234\") = \"4321\"\n    solve(\"ab\") = \"AB\"\n    solve(\"#a@C\") = \"#A@c\"\n    \"\"\"\n\n    def _has_letters(s_inner: str) -> bool:\n        \"\"\"Determines if the input string contains any alphabetic characters.\"\"\"\n        return any(char.isalpha() for char in s_inner)\n\n    def _reverse_case_char(char_inner: str) -> str:\n        \"\"\"Reverses the case of a single character if it's a letter, otherwise returns it unchanged.\"\"\"\n        if char_inner.islower():\n            return char_inner.upper()\n        elif char_inner.isupper():\n            return char_inner.lower()\n        else:\n            return char_inner\n\n    if not _has_letters(s):\n        return s[::-1]\n    else:\n        transformed_chars = [_reverse_case_char(char) for char in s]\n        return \"\".join(transformed_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/162": [{"task_id": "HumanEval/162", "solution": "def string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    import hashlib\n\n    if not text:\n        return None\n    \n    # Encode the string to bytes before hashing\n    md5_hash = hashlib.md5(text.encode('utf-8'))\n    # Return the hexadecimal representation of the hash\n    return md5_hash.hexdigest()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/15": [{"task_id": "HumanEval/15", "solution": "def string_sequence(n: int) -> str:\n    \"\"\" Return a string containing space-delimited numbers starting from 0 upto n inclusive.\n    >>> string_sequence(0)\n    '0'\n    >>> string_sequence(5)\n    '0 1 2 3 4 5'\n    \"\"\"\n    return ' '.join(str(i) for i in range(n + 1))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/163": [{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n\n    For example:\n    generate_integers(2, 8) => [2, 4, 6, 8]\n    generate_integers(8, 2) => [2, 4, 6, 8]\n    generate_integers(10, 14) => []\n    \"\"\"\n    def _determine_range_bounds(val1, val2):\n        # Determines the minimum and maximum bounds of the inclusive range.\n        return min(val1, val2), max(val1, val2)\n\n    def _is_even(number):\n        # Checks if a given number is an even digit (2, 4, 6, or 8).\n        # Integers 0 and 1 are not considered in the output based on problem context.\n        return 2 <= number <= 8 and number % 2 == 0\n\n    min_val, max_val = _determine_range_bounds(a, b)\n    \n    even_digits_found = []\n    for number in range(min_val, max_val + 1):\n        if _is_even(number):\n            even_digits_found.append(number)\n            \n    return even_digits_found", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[987654321, 123456789]]}], "HumanEval/147": [{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) from an array 'a'\n    where a[x] = x*x - x + 1, such that i < j < k and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n    if n < 3: # Need at least 3 elements for a triple to be formed.\n        return 0\n\n    a = []\n    # Generate array 'a' where a[idx] = (idx+1)*(idx+1) - (idx+1) + 1, using 0-based `idx`.\n    for idx in range(n):\n        x = idx + 1 # x is the 1-based index for the formula\n        a.append(x * x - x + 1)\n\n    valid_triples_count = 0\n\n    # Iterate through all unique combinations of three distinct indices i, j, k\n    # such that 0 <= i < j < k < n.\n    for i in range(n - 2):\n        for j in range(i + 1, n - 1):\n            for k in range(j + 1, n):\n                current_sum = a[i] + a[j] + a[k]\n                if current_sum % 3 == 0:\n                    valid_triples_count += 1\n\n    return valid_triples_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/129": [{"task_id": "HumanEval/129", "solution": "class Cell:\n    \"\"\"Represents a single cell in the grid with its value and coordinates.\"\"\"\n    def __init__(self, value: int, row: int, col: int) -> None:\n        self.value = value\n        self.row = row\n        self.col = col\nclass Grid:\n    \"\"\"Manages the N x N grid structure and provides access to cells.\"\"\"\n    def __init__(self, grid_values: list[list[int]]) -> None:\n        self._grid_values = grid_values\n        self.N = len(grid_values)\n        self._cells = {} \n\n        for r in range(self.N):\n            for c in range(self.N):\n                self._cells[(r, c)] = Cell(grid_values[r][c], r, c)\n\n    def get_cell(self, row: int, col: int) -> Cell:\n        return self._cells.get((row, col))\n\n    def get_N(self) -> int:\n        return self.N\nclass Path:\n    \"\"\"Represents an ordered sequence of cell values and provides lexicographical comparison.\"\"\"\n    def __init__(self, values: list[int]) -> None:\n        self._values = values\n\n    def get_values(self) -> list[int]:\n        return self._values\n\n    def __lt__(self, other: 'Path') -> bool:\n        return self._values < other._values\ndef _is_valid_coord(row: int, col: int, N: int) -> bool:\n    \"\"\"Checks if a given row and column coordinate is within the grid boundaries.\"\"\"\n    return 0 <= row < N and 0 <= col < N\ndef _get_neighbors(cell: Cell, grid_obj: Grid) -> list[Cell]:\n    \"\"\"Identifies valid adjacent cells for a given cell within the grid boundaries.\"\"\"\n    neighbors = []\n    N = grid_obj.get_N()\n    moves = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Up, Down, Left, Right\n\n    for dr, dc in moves:\n        new_row, new_col = cell.row + dr, cell.col + dc\n        if _is_valid_coord(new_row, new_col, N):\n            neighbors.append(grid_obj.get_cell(new_row, new_col))\n    return neighbors\ndef _find_paths_recursive(current_cell: Cell, current_path_values: list[int], remaining_k: int, grid_obj: Grid, best_path_container: list[list[int]]) -> None:\n    \"\"\"Recursively explores all valid paths of length k, upd