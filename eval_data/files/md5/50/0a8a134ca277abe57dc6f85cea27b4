ted_x, x, abs_tol=TOLERANCE)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[4722366482869645213695, 4722366482869645213696]]}], "HumanEval/78": [{"task_id": "HumanEval/78", "solution": "def hex_key(num):\n    \"\"\"Counts the number of prime hexadecimal digits in a given string.\n    Prime hexadecimal digits are 2, 3, 5, 7, B (decimal 11), D (decimal 13).\n    \"\"\"\n    def _hex_char_to_decimal(hex_char):\n        \"\"\"Converts a single hexadecimal character to its decimal value.\"\"\"\n        return int(hex_char, 16)\n\n    def _is_prime_hex_digit(decimal_value):\n        \"\"\"Checks if a decimal value corresponding to a hexadecimal digit is prime.\"\"\"\n        return decimal_value in {2, 3, 5, 7, 11, 13}\n\n    prime_count = 0\n    for char_digit in num:\n        decimal_val = _hex_char_to_decimal(char_digit)\n        if _is_prime_hex_digit(decimal_val):\n            prime_count += 1\n    return prime_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/82": [{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"Write a function that takes a string and returns True if the string\n    length is a prime number or False otherwise\n    \"\"\"\n\n    def _is_prime(number):\n        \"\"\"Checks if a given integer is a prime number.\"\"\"\n        if number < 2:\n            return False\n        if number == 2:\n            return True\n        if number % 2 == 0:\n            return False\n        i = 3\n        while i * i <= number:\n            if number % i == 0:\n                return False\n            i += 2\n        return True\n\n    return _is_prime(len(string))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/81": [{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"It is the last week of the semester and the teacher has to give the grades\n    to students. The teacher has been making her own algorithm for grading.\n    The only problem is, she has lost the code she used for grading.\n    She has given you a list of GPAs for some students and you have to write \n    a function that can output a list of letter grades using the following table:\n             GPA       |    Letter grade\n              4.0                A+\n            > 3.7                A \n            > 3.3                A- \n            > 3.0                B+\n            > 2.7                B \n            > 2.3                B-\n            > 2.0                C+\n            > 1.7                C\n            > 1.3                C-\n            > 1.0                D+ \n            > 0.7                D \n            > 0.0                D-\n              0.0                E\n    \n\n    Example:\n    grade_equation([4.0, 3, 1.7, 2, 3.5]) ==> ['A+', 'B', 'C-', 'C', 'A-']\n    \"\"\"\n\n    def _convert_single_gpa(gpa: float) -> str:\n        \"\"\"Converts a single numerical GPA to its corresponding letter grade.\"\"\"\n        if gpa == 4.0:\n            return 'A+'\n        elif gpa > 3.7:\n            return 'A'\n        elif gpa > 3.3:\n            return 'A-'\n        elif gpa > 3.0:\n            return 'B+'\n        elif gpa > 2.7:\n            return 'B'\n        elif gpa > 2.3:\n            return 'B-'\n        elif gpa > 2.0:\n            return 'C+'\n        elif gpa > 1.7:\n            return 'C'\n        elif gpa > 1.3:\n            return 'C-'\n        elif gpa > 1.0:\n            return 'D+'\n        elif gpa > 0.7:\n            return 'D'\n        elif gpa > 0.0:\n            return 'D-'\n        elif gpa == 0.0:\n            return 'E'\n\n    return [_convert_single_gpa(gpa) for gpa in grades]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/89": [{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by shi