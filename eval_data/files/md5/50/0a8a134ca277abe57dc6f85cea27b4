 range(n - 2, 0, -1):\n        current_char = word[i]\n        prev_char = word[i-1]\n        next_char = word[i+1]\n\n        if is_vowel(current_char) and \\\n           is_consonant(prev_char) and \\\n           is_consonant(next_char):\n            return current_char\n\n    return \"\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/119": [{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    \"\"\"\n    Checks if concatenating two strings from `lst` in either order results in a balanced parentheses string.\n    Returns 'Yes' if a good string can be made, 'No' otherwise.\n    \"\"\"\n\n    def _is_balanced(s: str) -> bool:\n        \"\"\"\n        Determines if a string `s` consisting of parentheses is balanced.\n        It maintains a balance counter, returning False if it ever drops below zero or is not zero at the end.\n        \"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            else:  # char == ')'\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    s1 = lst[0]\n    s2 = lst[1]\n\n    # Check the first concatenation order: s1 + s2\n    combined1 = s1 + s2\n    if _is_balanced(combined1):\n        return 'Yes'\n\n    # Check the second concatenation order: s2 + s1\n    combined2 = s2 + s1\n    if _is_balanced(combined2):\n        return 'Yes'\n\n    return 'No'", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/117": [{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"Given a string s and a natural number n, returns a list of words with exactly n consonants.\"\"\"\n\n    def _is_vowel(char):\n        \"\"\"Determines if a given character is a vowel (case-insensitive).\"\"\"\n        return char.lower() in 'aeiou'\n\n    def _count_consonants(word):\n        \"\"\"Counts the number of consonants in a single word.\"\"\"\n        count = 0\n        for char in word:\n            if char.isalpha() and not _is_vowel(char):\n                count += 1\n        return count\n\n    if not s:\n        return []\n\n    words = s.split()\n    result = []\n    for word in words:\n        if _count_consonants(word) == n:\n            result.append(word)\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/39": [{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n\n    def _is_prime(num: int) -> bool:\n        \"\"\"Checks if a given number is prime.\"\"\"\n        if num <= 1:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    count = 0\n    a, b = 0, 1  # Initialize Fibonacci sequence (F0, F1)\n\n    while True:\n        # Generate the next Fibonacci number\n        next_fib = a + b\n        a = b\n        b = next_fib\n\n        # Check if the current Fibonacci number is prime\n        if _is_prime(b):\n            count += 1\n            if count == n:\n                return b", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[12]]}], "HumanEval/121": [{"task_id": "HumanEval/121", "solution": "def solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\n    \n\n    Examples\n    solution([5, 8, 7, 1]) ==> 12\n    solution([3, 3, 3, 3, 3]) ==> 9\n    solution([30, 13, 24, 321]) ==>0\n    \"\"\"\n    def _is_list_empty(lst: list[int]) -> bool:\n        \"\"\"Checks if the input list is empty.\"\"\"\n        return len(lst) == 0\n\n    def _is_even_index(index: int) -> bool:\n        \"\"\"Determines if a given zero-based index is even.\"\"\"\n        return index % 2 == 0\n\n    def _is_odd_number(number: int) -> bool:\n        \"\"\"Determines if a given integer number is odd.\"\"\"\n        return number % 2 != 0\n\n    if _is_list_empty(lst):\n        return 0\n\n    total_sum = 0\n    for index, element in enumerate(lst):\n        if _is_even_index(index) and _is_odd_number(element):\n            total_sum += element\n\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/120": [{"task_id": "HumanEval/120", "solution": "import heapq\ndef maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list \n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    if k == 0:\n        return []\n\n    # Use a min-heap to keep track of the k largest elements.\n    # This approach has O(N log k) time complexity.\n    min_heap = []\n    for num in arr:\n        if len(min_heap) < k:\n            heapq.heappush(min_heap, num)\n        elif num > min_heap[0]:\n            heapq.heapreplace(min_heap, num)\n\n    # The min_heap now contains the k largest elements. Sort them in ascending order.\n    min_heap.sort()\n    return min_heap", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/116": [{"task_id": "HumanEval/116", "solution": "def _count_set_bits(n: int) -> int:\n    \"\"\"Counts the number of set bits (ones) in the binary representation of a non-negative integer.\"\"\"\n    return bin(n).count('1')\ndef sort_array(arr):\n    \"\"\"\n    In this Kata, you have to sort an array of non-negative integers according to\n    number of ones in their binary representation in ascending order.\n    For similar number of ones, sort based on decimal value.\n\n    It must be implemented like this:\n    >>> sort_array([1, 5, 2, 3, 4]) == [1, 2, 3, 4, 5]\n    >>> sort_array([-2, -3, -4, -5, -6]) == [-6, -5, -4, -3, -2]\n    >>> sort_array([1, 0, 2, 3, 4]) == [0, 1, 2, 3, 4]\n    \"\"\"\n    def custom_sort_key(num):\n        # For negative numbers, sort by decimal value (ascending).\n        # The -1 marker ensures all negatives are grouped before non-negatives.\n        if num < 0:\n            return (-1, num)\n        # For non-negative numbers, sort by (count of ones, then decimal value).\n        # The 0 marker ensures all non-negatives are grouped after negatives.\n        else:\n            return (0, _count_set_bits(num), num)\n\n    return sorted(arr, key=custom_sort_key)", "base_status": "fail", "plus_status": "pass", "base_fail_tests": [[[-2, -3, -4, -5, -6]]], "plus_fail_tests": []}], "HumanEval/122": [{"task_id": "HumanEval/122", "solution": "def _has_at_most_two_digits(number: int) -> bool:\n    \"\"\"\n    Checks if an integer has at most two digits (absolute value < 100).\n    \"\"\"\n    return -99 <= number <= 99\ndef add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n\n    Example:\n\n        Input: arr = [111,21,3,4000,5,6,7,8,9], k = 4\n        Output: 24 # sum of 21 + 3\n\n    Constraints:\n        1. 1 <= len(arr) <= 100\n        2. 1 <= k <= len(arr)\n    \"\"\"\n    _validate_inputs(arr, k)\n\n    current_sum = 0\n    # Iterate through the first k elements.\n    for i in range(k):\n        element = arr[i]\n        # Identify elements with at most two digits.\n        if _has_at_most_two_digits(element):\n            current_sum += element\n\n    return current_sum", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, -2, -3, 41, 57, 76, 87, 88, 99], 3]], "plus_fail_tests": [[[98, 87, 76, 65, 54, 43, 32, 21, 10], 5]]}], "HumanEval/123": [{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n\n    The Collatz conjecture is a conjecture in mathematics that concerns a sequence defined\n    as follows: start with any positive integer n. Then each term is obtained from the \n    previous term as follows: if the previous term is even, the next term is one half of \n    the previous term. If the previous term is odd, the next term is 3 times the previous\n    term plus 1. The conjecture is that no matter what value of n, the sequence will always reach 1.\n\n    Note: \n        1. Collatz(1) is [1].\n        2. returned list sorted in increasing order.\n\n    For example:\n    get_odd_collatz(5) returns [1, 5] # The collatz sequence for 5 is [5, 16, 8, 4, 2, 1], so the odd numbers are only 1, and 5.\n    \"\"\"\n\n    def _generate_collatz_sequence(start_n):\n        \"\"\"Generates the full Collatz sequence from a starting number until 1.\"\"\"\n        sequence = [start_n]\n        current = start_n\n        while current != 1:\n            if current % 2 == 0:\n                current = current // 2\n            else:\n                current = 3 * current + 1\n            sequence.append(current)\n        return sequence\n\n    def _filter_odd_numbers(sequence):\n        \"\"\"Filters a list of numbers to retain only the odd ones.\"\"\"\n        return [num for num in sequence if num % 2 != 0]\n\n    def _sort_numbers(numbers):\n        \"\"\"Sorts a list of integers in increasing order.\"\"\"\n        return sorted(numbers)\n\n    if n == 1:\n        return [1]\n\n    collatz_sequence = _generate_collatz_sequence(n)\n    odd_numbers = _filter_odd_numbers(collatz_sequence)\n    sorted_odd_numbers = _sort_numbers(odd_numbers)\n\n    return sorted_odd_numbers", "base_status": "pas