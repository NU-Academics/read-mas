n MangoResult(mango_count)\n\n    fruit_counts_obj = parse_fruit_counts(s)\n    mango_result_obj = calculate_mango_fruits(n, fruit_counts_obj.apple_count, fruit_counts_obj.orange_count)\n    return mango_result_obj.count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/65": [{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    >>> circular_shift(12, 1)\n    \"21\"\n    >>> circular_shift(12, 2)\n    \"12\"\n    \"\"\"\n\n    def _get_digits(num_val: int) -> list[str]:\n        \"\"\"Converts an integer into a list of its digits as strings.\"\"\"\n        return list(str(abs(num_val)))\n\n    def _perform_circular_shift(digits_list: list[str], shift_amount: int) -> list[str]:\n        \"\"\"Performs a circular right shift on a list of digit strings.\"\"\"\n        num_digits_in_list = len(digits_list)\n        if num_digits_in_list == 0:\n            return []\n        actual_shift = shift_amount % num_digits_in_list\n        return digits_list[-actual_shift:] + digits_list[:-actual_shift]\n\n    def _reverse_digits(digits_list: list[str]) -> list[str]:\n        \"\"\"Reverses the order of a list of digit strings.\"\"\"\n        return digits_list[::-1]\n\n    digits = _get_digits(x)\n    num_digits = len(digits)\n\n    # For any integer x, _get_digits(x) will return at least ['0'] for x=0.\n    # Thus, num_digits will always be >= 1.\n\n    if shift > num_digits:\n        result_digits = _reverse_digits(digits)\n    else:\n        result_digits = _perform_circular_shift(digits, shift)\n\n    return \"\".join(result_digits)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/62": [{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\n     Return derivative of this polynomial in the same form.\n    \"\"\"\n    if not xs or len(xs) == 1:\n        return []\n\n    derivative_coefficients = []\n    for i in range(1, len(xs)):\n        new_coefficient = xs[i] * i\n        derivative_coefficients.append(new_coefficient)\n\n    return derivative_coefficients", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/70": [{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    \"\"\"\n    Given a list of integers, return a list in strange order.\n    Strange sorting starts with the minimum value, then the maximum of the remaining integers,\n    then minimum and so on.\n    \"\"\"\n    if not lst:\n        return []\n\n    working_list = sorted(lst)\n    result_list = []\n    is_min_turn = True\n\n    while working_list:\n        if is_min_turn:\n            selected_value = working_list.pop(0)\n        else:\n            selected_value = working_list.pop()\n\n        result_list.append(selected_value)\n        is_min_turn = not is_min_turn\n\n    return result_list", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/72": [{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    '''\n    Write a function that returns True if the object q will fly, and False otherwise.\n    The object q will fly if it's balanced (it is a palindromic list) and the sum of its elements is less than or equal the maximum possible weight w.\n\n    Example:\n    will_it_fly([1, 2], 5) \u279e False \n    # 1+2 is less than the maximum possible weight, but it's unbalanced.\n\n    will_it_fly([3, 2, 3], 1) \u279e False\n    # it's balanced, but 3+2+3 is more than the maximum possible weight.\n\n    will_it_fly([3, 2, 3], 9) \u279e True\n    # 3+2+3 is less than the maximum possible weight, and it's balanced.\n\n    will_it_fly([3], 5) \u279e True\n    # 3 is less than the maximum possible weight, and it's balanced.\n    '''\n    # Helper function to check if a list is a palindrome.\n    def is_palindrome(lst):\n        return lst == lst[::-1]\n\n    # Helper function to calculate the sum of elements in a list.\n    def calculate_sum(lst):\n        return sum(lst)\n\n    balanced = is_palindrome(q)\n    total_weight = calculate_sum(q)\n    \n    return balanced and (total_weight <= w)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/71": [{"task_id": "HumanEval/71", "solution": "def triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater \n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    '''\n    def _is_valid_triangle(a, b, c):\n        # Checks if the sum of any two sides is greater than the third side and all sides are positive.\n        if not (a > 0 and b > 0 and c > 0):\n            return False\n        return (a + b > c and a + c > b and b + c > a)\n\n    def _calculate_herons_area(a, b, c):\n        # Computes the area given three side lengths using Heron's formula.\n        s = (a + b + c) / 2\n        # The term inside the square root is non-negative for a valid triangle.\n        return (s * (s - a) * (s - b) * (s - c))**0.5\n\n    def _round_to_two_decimals(area):\n        # Rounds the input area to two decimal points.\n        return round(area, 2)\n\n    if not _is_valid_triangle(a, b, c):\n        return -1\n    else:\n        raw_area = _calculate_herons_area(a, b, c)\n        return _round_to_two_decimals(raw_area)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "pl