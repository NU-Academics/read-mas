{"task_id": "HumanEval/0", "solution": "from typing import List\n\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\"Return ``True`` if any two numbers in *numbers* are closer to each other\n    than *threshold*; otherwise ``False``.\n\n    The implementation sorts the list once and then only compares\n    adjacent values, giving a time complexity of ``O(n log n)``.\n\n    Args:\n        numbers: A list of floating\u2011point numbers.\n        threshold: The minimum allowed distance between any pair of\n            numbers.\n\n    Returns:\n        bool: ``True`` if a pair of numbers is found that is too close,\n            otherwise ``False``.\n\n    Examples:\n        >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n        False\n        >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n        True\n    \"\"\"\n    if len(numbers) < 2:\n        return False\n\n    sorted_numbers = sorted(numbers)\n    for prev, curr in zip(sorted_numbers, sorted_numbers[1:]):\n        if abs(curr - prev) < threshold:\n            return True\n    return False"}
{"task_id": "HumanEval/1", "solution": "from typing import List\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"Separate non\u2011nested, balanced parenthesis groups from a string.\n\n    Parameters\n    ----------\n    paren_string : str\n        The input string containing parenthesis groups and optional spaces.\n\n    Returns\n    -------\n    List[str]\n        A list of extracted balanced parenthesis groups, in the order they appear.\n\n    Notes\n    -----\n    * Groups may contain nested parentheses, but groups themselves are not nested.\n    * Leading and trailing whitespace around each group is ignored.\n    * Only balanced groups are returned; any unmatched opens or closes are ignored.\n\n    Examples\n    --------\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    groups: List[str] = []\n    buffer: List[str] = []\n    depth = 0\n    # Iterate over non\u2011space characters\n    for ch in paren_string:\n        if ch.isspace():\n            continue\n        if ch == '(':\n            depth += 1\n            buffer.append(ch)\n        elif ch == ')':\n            if depth > 0:  # ignore stray closing parentheses\n                buffer.append(ch)\n                depth -= 1\n                if depth == 0:\n                    groups.append(''.join(buffer))\n                    buffer.clear()\n            else:\n                # stray closing parenthesis, ignore\n                continue\n        else:\n            # non-parenthesis characters are ignored (as per spec we only\n            # expect '(' or ')')\n            continue\n    return groups\n"}
{"task_id": "HumanEval/2", "solution": "import math\n\ndef truncate_number(number: float) -> float:\n    \"\"\"\n    Given a positive floating point number, decompose it into an integer part\n    (the largest integer less than or equal to the given number) and a decimal\n    part (the remainder). Return the decimal part.\n\n    Args:\n        number: A positive float to truncate.\n\n    Returns:\n        The decimal part of `number`.\n\n    Raises:\n        ValueError: If `number` is negative.\n\n    Examples:\n        >>> truncate_number(3.5)\n        0.5\n        >>> truncate_number(10.0)\n        0.0\n    \"\"\"\n    if number < 0:\n        raise ValueError(\"Number must be non\u2011negative\")\n\n    integer_part = math.floor(number)\n    decimal_part = number - integer_part\n    return decimal_part\n\nif __name__ == \"__main__\":\n    import doctest\n    doctest.testmod()"}
{"task_id": "HumanEval/3", "solution": "from typing import List\n\n\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\"\n    Detect whether the running balance ever drops below zero.\n\n    The account starts at zero. Positive numbers represent deposits,\n    negative numbers represent withdrawals. The function returns\n    True as soon as any intermediate balance is negative, otherwise\n    False.\n\n    Args:\n        operations: A list of integers representing banking operations.\n\n    Returns:\n        bool: True if balance goes below zero, else False.\n\n    Example:\n        >>> below_zero([1, 2, 3])\n        False\n        >>> below_zero([1, 2, -4, 5])\n        True\n    \"\"\"\n    balance = 0\n    for op in operations:\n        balance += op\n        if balance < 0:\n            return True\n    return False\n"}
{"task_id": "HumanEval/4", "solution": "from __future__ import annotations\n\nfrom typing import Iterable, List\n\ndef mean_absolute_deviation(numbers: Iterable[float]) -> float:\n    \"\"\"\n    Calculate the Mean Absolute Deviation (MAD) of a sequence of numbers\n    with respect to its arithmetic mean.\n\n    The MAD is defined as the average of the absolute deviations from the mean:\n    MAD = (1 / n) * \u03a3 |x_i - \u03bc|\n    where \u03bc is the mean of the data and n is the number of observations.\n\n    Parameters\n    ----------\n    numbers : Iterable[float]\n        Sequence of numeric values to analyse.\n\n    Returns\n    -------\n    float\n        The mean absolute deviation.\n\n    Raises\n    ------\n    ValueError\n        If the input iterable is empty.\n\n    Examples\n    --------\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    >>> mean_absolute_deviation([10, 10, 10, 10])\n    0.0\n    >>> mean_absolute_deviation([5.5])\n    0.0\n    \"\"\"\n    values = list(numbers)\n    if not values:\n        raise ValueError(\"The input sequence must contain at least one number.\")\n\n    # Compute mean\n    mean_val = sum(values) / len(values)\n\n    # Compute absolute deviations and average them\n    mad = sum(abs(x - mean_val) for x in values) / len(values)\n    return mad\n\n# If the module is run as a script, demonstrate usage with a simple test.\nif __name__ == \"__main__\":\n    import doctest\n\n    doctest.testmod()\n    print(\"Mean Absolute Deviation of [1, 2, 3, 4]:\", mean_absolute_deviation([1, 2, 3, 4]))\n    print(\"Mean Absolute Deviation of [10, 10, 10, 10]:\", mean_absolute_deviation([10] * 4))\n    print(\"Mean Absolute Deviation of [5.5]:\", mean_absolute_deviation([5.5]))"}
{"task_id": "HumanEval/5", "solution": "from typing import List\n\ndef intersperse(numbers: List[int], delimiter: int) -> List[int]:\n    \"\"\"Insert a number `delimiter` between every two consecutive elements of input list `numbers`.\n\n    Args:\n        numbers: List of integers.\n        delimiter: Integer to insert between elements.\n\n    Returns:\n        A new list with `delimiter` inserted between each pair of elements.\n\n    Examples:\n        >>> intersperse([], 4)\n        []\n        >>> intersperse([1, 2, 3], 4)\n        [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result: List[int] = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimiter)\n    return result\n\nif __name__ == \"__main__\":\n    import doctest\n    doctest.testmod()"}
{"task_id": "HumanEval/6", "solution": "from typing import List\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"\n    Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n    \n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    if not paren_string:\n        return []\n\n    depths = []\n    for group in paren_string.split():\n        max_depth = 0\n        current_depth = 0\n        for char in group:\n            if char == '(':\n                current_depth += 1\n                if current_depth > max_depth:\n                    max_depth = current_depth\n            elif char == ')':\n                current_depth -= 1\n        depths.append(max_depth)\n    return depths\n\nif __name__ == \"__main__\":\n    import doctest\n    doctest.testmod()\n    print(\"All tests passed.\")"}
{"task_id": "HumanEval/7", "solution": "from typing import List\n\n\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\"Filter an input list of strings and return only those that contain the given substring.\n\n    Examples:\n        >>> filter_by_substring([], 'a')\n        []\n        >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n        ['abc', 'bacd', 'array']\n\n    Args:\n        strings: A list of strings to be filtered.\n        substring: The substring to look for in each string.\n\n    Returns:\n        A list of strings that contain the given substring.\n    \"\"\"\n    return [s for s in strings if substring in s]"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\nimport math\nimport doctest\n\n\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\"Return a tuple containing the sum and product of all integers in ``numbers``.\n\n    An empty ``numbers`` list returns (0, 1) \u2013 the mathematical identities for\n    addition and multiplication.\n\n    Args:\n        numbers: List of integers.\n\n    Returns:\n        Tuple[int, int]: (sum, product)\n\n    Examples:\n        >>> sum_product([])\n        (0, 1)\n        >>> sum_product([1, 2, 3, 4])\n        (10, 24)\n    \"\"\"\n    total_sum = sum(numbers)\n    total_prod = math.prod(numbers) if numbers else 1\n    return total_sum, total_prod\n\n\nif __name__ == \"__main__\":\n    doctest.testmod()"}
{"task_id": "HumanEval/9", "solution": "from typing import List\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\"\n    From a given list of integers, generate a list of rolling maximum element found until the current moment\n    in the sequence.\n\n    Parameters:\n    ----------\n    numbers : List[int]\n        Input list of integers.\n\n    Returns:\n    -------\n    List[int]\n        List where each element is the maximum of all elements seen up to that index.\n\n    Examples:\n    --------\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result: List[int] = []\n    current_max = numbers[0]\n    result.append(current_max)\n\n    for num in numbers[1:]:\n        current_max = num if num > current_max else current_max\n        result.append(current_max)\n\n    return result"}
