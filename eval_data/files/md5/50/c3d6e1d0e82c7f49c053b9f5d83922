{"task_id": "HumanEval/0", "solution": "def has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    \"\"\"\n    if threshold < 0:\n        raise ValueError(\"Threshold must be a non-negative number.\")\n\n    n = len(numbers)\n    if n < 2:\n        return False\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            if abs(numbers[i] - numbers[j]) < threshold:\n                return True\n    return False"}
{"task_id": "HumanEval/3", "solution": "def below_zero(operations: List[int]) -> bool:\n    \"\"\"Checks if the account balance ever falls below zero given a list of operations.\n    The account starts with a zero balance.\n    \"\"\"\n    balance = 0\n    for op in operations:\n        balance += op\n        if balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/4", "solution": "def mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    if not numbers:\n        return 0.0  # Or handle as an error if appropriate, but returning 0.0 avoids division by zero.\n\n    # Calculate the mean of the numbers\n    data_mean = sum(numbers) / len(numbers)\n\n    # Calculate the sum of absolute differences from the mean\n    absolute_differences_sum = sum(abs(x - data_mean) for x in numbers)\n\n    # Calculate the Mean Absolute Deviation\n    mad = absolute_differences_sum / len(numbers)\n\n    return mad"}
{"task_id": "HumanEval/7", "solution": "def filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring.\n    This implementation follows a Clean Architecture design with internal domain entities and an application service.\n    \"\"\"\n\n    # Domain Layer Entities\n    class StringList:\n        \"\"\"Represents a collection of strings.\"\"\"\n        def __init__(self, items: List[str]):\n            self.items = items\n\n    class Substring:\n        \"\"\"Represents the substring to filter by.\"\"\"\n        def __init__(self, value: str):\n            self.value = value\n\n    # Application Service Layer\n    class FilterService:\n        \"\"\"Performs the business logic of filtering strings.\"\"\"\n        def filter(self, string_list_entity: StringList, substring_entity: Substring) -> StringList:\n            filtered_items = [\n                s for s in string_list_entity.items\n                if substring_entity.value in s\n            ]\n            return StringList(filtered_items)\n\n    # Interface Layer / Orchestration within the function\n    # 1. Construct domain objects from input primitives\n    string_list = StringList(strings)\n    sub = Substring(substring)\n\n    # 2. Delegate to the application service\n    service = FilterService()\n    filtered_string_list = service.filter(string_list, sub)\n\n    # 3. Extract and return primitive output\n    return filtered_string_list.items"}
