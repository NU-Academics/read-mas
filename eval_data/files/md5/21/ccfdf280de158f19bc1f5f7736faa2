{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"Map a list of numeric GPAs to letter grades according to the specified scale.\n\n    Mapping:\n      4.0 -> 'A+'\n      >3.7 -> 'A'\n      >3.3 -> 'A-'\n      >3.0 -> 'B+'\n      >2.7 -> 'B'\n      >2.3 -> 'B-'\n      >2.0 -> 'C+'\n      >1.7 -> 'C'\n      >1.3 -> 'C-'\n      >1.0 -> 'D+'\n      >0.7 -> 'D'\n      >0.0 -> 'D-'\n      0.0 -> 'E'\n    \"\"\"\n    if not isinstance(grades, (list, tuple)):\n        raise TypeError(\"grades must be a list or tuple of numeric GPA values\")\n\n    letter_grades = []\n    for value in grades:\n        try:\n            gpa = float(value)\n        except (TypeError, ValueError):\n            raise TypeError(\"each grade must be a numeric value\") from None\n\n        if gpa < 0.0 or gpa > 4.0:\n            raise ValueError(\"GPA values must be between 0.0 and 4.0 inclusive\")\n\n        if gpa == 4.0:\n            letter_grades.append('A+')\n        elif gpa > 3.7:\n            letter_grades.append('A')\n        elif gpa > 3.3:\n            letter_grades.append('A-')\n        elif gpa > 3.0:\n            letter_grades.append('B+')\n        elif gpa > 2.7:\n            letter_grades.append('B')\n        elif gpa > 2.3:\n            letter_grades.append('B-')\n        elif gpa > 2.0:\n            letter_grades.append('C+')\n        elif gpa > 1.7:\n            letter_grades.append('C')\n        elif gpa > 1.3:\n            letter_grades.append('C-')\n        elif gpa > 1.0:\n            letter_grades.append('D+')\n        elif gpa > 0.7:\n            letter_grades.append('D')\n        elif gpa > 0.0:\n            letter_grades.append('D-')\n        else:  # gpa == 0.0\n            letter_grades.append('E')\n\n    return letter_grades"}
{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"Checks if the length of a string is a prime number.\n    Returns True if the length is prime, False otherwise.\"\"\"\n    length = len(string)\n\n    if length < 2:\n        return False\n    if length == 2:\n        return True\n    if length % 2 == 0:\n        return False\n\n    i = 3\n    while i * i <= length:\n        if length % i == 0:\n            return False\n        i += 2\n    return True"}
{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"\n    Checks if the length of a string is a prime number.\n    Returns True if the length is prime, False otherwise.\n    \"\"\"\n    n = len(string)\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    # Check for factors from 3 up to the square root of n, skipping even numbers.\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True"}
