{"task_id": "HumanEval/61", "solution": "def correct_bracketing(brackets: str) -> bool:\n    \"\"\"Checks if every opening bracket has a corresponding closing bracket.\n\n    Args:\n        brackets: A string containing only '(' and ')'.\n\n    Returns:\n        True if brackets are correctly balanced, False otherwise.\n\n    Examples:\n        >>> correct_bracketing(\"(\")\n        False\n        >>> correct_bracketing(\"()\")\n        True\n        >>> correct_bracketing(\"(()())\")\n        True\n        >>> correct_bracketing(\")(()\")\n        False\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n        else:\n            # Ignore unexpected characters or alternatively raise ValueError\n            continue\n        if balance < 0:\n            return False\n    return balance == 0"}
