{"task_id": "HumanEval/72", "solution": "def will_it_fly(q, w):\n    \"\"\"\n    Determines if an object flies, which requires it to be a palindromic list (balanced) and its total weight (sum) to be less than or equal to the maximum allowed weight w.\n    \"\"\"\n    # An object flies if it is balanced (q is a palindrome) AND its total weight is within limits.\n    return (q == q[::-1]) and (sum(q) <= w)"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    \"\"\"\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    \"\"\"\n    sorted_lst = sorted(lst)\n    result = []\n    left = 0\n    right = len(sorted_lst) - 1\n\n    while left <= right:\n        result.append(sorted_lst[left])\n        left += 1\n        if left <= right:\n            result.append(sorted_lst[right])\n            right -= 1\n    return result"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Computes the minimum changes to make an array palindromic.\n    Each change can set an element to any value.\n    \"\"\"\n    n = len(arr)\n    count = 0\n    for i in range(n // 2):\n        if arr[i] != arr[n - 1 - i]:\n            count += 1\n    return count"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q, w):\n    \"\"\"\n    Determines if an object q will fly. An object flies if it's balanced (palindromic)\n    and its total weight is less than or equal to the maximum allowed weight w.\n    \"\"\"\n    q_list = list(q)  # Convert q to a list to allow slicing and summing.\n    # Validate types\n    if not isinstance(w, (int, float)):\n        raise TypeError(\"w must be an int or float\")\n    for i, item in enumerate(q_list):\n        if not isinstance(item, (int, float)):\n            raise TypeError(f\"q[{i}] must be an int or float\")\n    is_palindromic = (q_list == q_list[::-1])  # Check if the list is palindromic.\n    total_weight = sum(q_list)  # Calculate the sum of elements in q.\n    is_weight_ok = (total_weight <= w)  # Check if the total weight is within limits.\n    return is_palindromic and is_weight_ok"}
{"task_id": "HumanEval/71", "solution": "import math\n\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle.\n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater\n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    '''\n    # Convert inputs to float safely and validate.\n    try:\n        a_f = float(a)\n        b_f = float(b)\n        c_f = float(c)\n    except (ValueError, TypeError):\n        return -1\n\n    # Validate finiteness and positivity of sides.\n    if not (math.isfinite(a_f) and math.isfinite(b_f) and math.isfinite(c_f) and\n            a_f > 0 and b_f > 0 and c_f > 0):\n        return -1\n\n    # Validate triangle inequality (strict inequality required).\n    if not (a_f + b_f > c_f and a_f + c_f > b_f and b_f + c_f > a_f):\n        return -1\n\n    # Compute semiperimeter.\n    s = (a_f + b_f + c_f) / 2\n\n    # Compute area_squared using Heron's formula.\n    area_squared = s * (s - a_f) * (s - b_f) * (s - c_f)\n\n    # Handle numeric stability: clamp tiny negative area_squared to zero.\n    # Return -1 if significantly negative.\n    if area_squared < -1e-12: # Tolerance for significant negative values\n        return -1\n    if area_squared < 0: # Clamp small negative values (due to float precision) to 0.0\n        area_squared = 0.0\n\n    # Compute area.\n    area = math.sqrt(area_squared)\n\n    # Validate area is finite after sqrt (e.g., if area_squared was extremely large).\n    if not math.isfinite(area):\n        return -1\n\n    # Return area rounded to 2 decimal places.\n    return round(area, 2)"}
