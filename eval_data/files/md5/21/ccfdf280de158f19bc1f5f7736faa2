{"task_id": "HumanEval/98", "solution": "def count_upper(s):\n    \"\"\"\n    Count the number of uppercase vowels (A, E, I, O, U) that occur at even indices (0-based) in the input string s.\n\n    Args:\n        s (str): Input string.\n\n    Returns:\n        int: Number of uppercase vowels at even indices.\n\n    Raises:\n        TypeError: If s is not a str.\n\n    Notes:\n        - Only the ASCII uppercase vowels 'A', 'E', 'I', 'O', 'U' are counted.\n        - Unicode characters that are not exactly one of the above are not counted.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"s must be a str\")\n\n    vowels = {\"A\", \"E\", \"I\", \"O\", \"U\"}\n    count = 0\n    for i, ch in enumerate(s):\n        if (i & 1) == 0 and ch in vowels:\n            count += 1\n    return count"}
{"task_id": "HumanEval/100", "solution": "def make_a_pile(n):\n    \"\"\"\n    Given a positive integer n, return a list of length n where the first element\n    is n and each subsequent element is the next odd (if n is odd) or next even\n    (if n is even) number. Effectively increments by 2 each level.\n    \"\"\"\n    if n <= 0:\n        return []\n    return [n + 2 * i for i in range(n)]"}
{"task_id": "HumanEval/100", "solution": "def make_a_pile(n):\n    \"\"\"\n    Generates a list representing a pile of stones with n levels.\n    The first level has n stones, and subsequent levels increment by 2.\n    \"\"\"\n    pile = []\n    current_stones = n\n    for _ in range(n):\n        pile.append(current_stones)\n        current_stones += 2\n    return pile"}
{"task_id": "HumanEval/99", "solution": "from decimal import Decimal, ROUND_HALF_UP\n\ndef closest_integer(value):\n    \"\"\"\n    Creates a function that takes a string representing a number and returns the closest integer.\n    Equidistant values (e.g., 14.5, -14.5) are rounded away from zero.\n    \"\"\"\n    if not isinstance(value, str):\n        raise TypeError(\"value must be a string\")\n    s = value.strip()\n    if s == \"\":\n        raise ValueError(\"empty string is not a valid number\")\n    try:\n        d = Decimal(s)\n    except Exception as e:\n        raise ValueError(f\"invalid numeric string: {value}\") from e\n    if d.is_nan() or d.is_infinite():\n        raise ValueError(f\"invalid numeric value: {value}\")\n    rounded = d.to_integral_value(rounding=ROUND_HALF_UP)\n    return int(rounded)"}
