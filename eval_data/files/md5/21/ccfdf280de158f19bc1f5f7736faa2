{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by first swapping the case of all letters,\n    then replacing vowels with the letter 2 places ahead in the alphabet.\n    \"\"\"\n    vowel_map = {\n        'a': 'c', 'e': 'g', 'i': 'k', 'o': 'q', 'u': 'w',\n        'A': 'C', 'E': 'G', 'I': 'K', 'O': 'Q', 'U': 'W'\n    }\n\n    encoded_chars = []\n    for char in message:\n        swapped_char = char.swapcase()\n        if swapped_char in vowel_map:\n            encoded_chars.append(vowel_map[swapped_char])\n        else:\n            encoded_chars.append(swapped_char)\n\n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    \"\"\"\n    Return True if one of the three numbers equals the sum of the other two\n    and all three inputs are integers (floats that represent whole numbers are allowed).\n    Booleans and non-numeric types are rejected.\n    \"\"\"\n    import math\n\n    def is_whole_number(v):\n        # Reject booleans explicitly (bool is subclass of int in Python)\n        if isinstance(v, bool):\n            return False\n        # Must be int or float\n        if not isinstance(v, (int, float)):\n            return False\n        # For floats, ensure finite and whole\n        if isinstance(v, float):\n            if not math.isfinite(v):\n                return False\n            if not v.is_integer():\n                return False\n        return True\n\n    for val in (x, y, z):\n        if not is_whole_number(val):\n            return False\n\n    xi, yi, zi = int(x), int(y), int(z)\n    return (xi == yi + zi) or (yi == xi + zi) or (zi == xi + yi)"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"Finds the largest prime number in a list and returns the sum of its digits.\n    Returns 0 if no prime numbers are found.\"\"\"\n    def is_prime(n):\n        \"\"\"Checks if a number is prime.\"\"\"\n        if n < 2:\n            return False\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 1\n        return True\n\n    def sum_digits(n):\n        \"\"\"Calculates the sum of the digits of a number.\"\"\"\n        s = 0\n        while n > 0:\n            s += n % 10\n            n //= 10\n        return s\n\n    largest_prime = 0\n    for num in lst:\n        if is_prime(num) and num > largest_prime:\n            largest_prime = num\n\n    if largest_prime == 0:\n        return 0\n    else:\n        return sum_digits(largest_prime)"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower\n    case or all keys are strings in upper case, else return False.\n    The function returns False if the given dictionary is empty or if any key\n    is not a string or contains no cased characters (so neither islower nor isupper).\n    \"\"\"\n    if not dict:\n        return False\n\n    all_lower = True\n    all_upper = True\n\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False\n        if not key.islower():\n            all_lower = False\n        if not key.isupper():\n            all_upper = False\n        if not all_lower and not all_upper:\n            return False\n\n    return all_lower or all_upper"}
{"task_id": "HumanEval/96", "solution": "def count_up_to(n):\n    \"\"\"Generates a list of prime numbers less than the given non-negative integer n using the Sieve of Eratosthenes.\"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n    if n <= 2:\n        return []\n\n    is_prime = [True] * n\n    is_prime[0] = is_prime[1] = False\n\n    p = 2\n    while p * p < n:\n        if is_prime[p]:\n            for multiple in range(p * p, n, p):\n                is_prime[multiple] = False\n        p += 1\n\n    primes = [i for i in range(2, n) if is_prime[i]]\n    return primes"}
