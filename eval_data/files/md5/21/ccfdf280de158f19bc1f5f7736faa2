{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    Applies optimized trial division method.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True"}
{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    \"\"\"\n    if not isinstance(n, int):\n        return False\n    if n <= 1:  # Covers negative, 0, 1\n        return False\n    if n <= 3:  # 2 and 3 are prime\n        return True\n    if n % 2 == 0 or n % 3 == 0:  # Exclude multiples of 2 and 3\n        return False\n\n    # All primes > 3 are of the form 6k \u00b1 1. Check divisors up to sqrt(n).\n    import math\n    bound = math.isqrt(n)\n    i = 5\n    while i <= bound:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function sorts elements at indices divisible by three while preserving others.\n    It returns a new list with sorted elements at these specific positions.\n    \"\"\"\n    third_elements_unsorted = []\n    third_indices = []\n\n    for i in range(len(l)):\n        if i % 3 == 0:\n            third_elements_unsorted.append(l[i])\n            third_indices.append(i)\n\n    third_elements_sorted = sorted(third_elements_unsorted)\n\n    l_prime = list(l)\n\n    sorted_idx = 0\n    for idx in third_indices:\n        l_prime[idx] = third_elements_sorted[sorted_idx]\n        sorted_idx += 1\n\n    return l_prime"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a new list where elements at indices divisible by three are sorted,\n    while other elements remain in their original positions.\n    \"\"\"\n    third_elements = []\n    # Collect elements from l at indices divisible by three.\n    for i in range(len(l)):\n        if i % 3 == 0:\n            third_elements.append(l[i])\n\n    third_elements.sort()  # Sort the collected elements.\n\n    l_prime = l[:]  # Create a mutable copy of the input list.\n    sorted_idx = 0\n    # Replace elements in l_prime at indices divisible by three with the sorted values.\n    for i in range(len(l_prime)):\n        if i % 3 == 0:\n            l_prime[i] = third_elements[sorted_idx]\n            sorted_idx += 1\n\n    return l_prime"}
{"task_id": "HumanEval/32", "solution": "def find_zero(xs: list):\n    \"\"\"Find a real root x of the polynomial p(x)=xs[0] + xs[1]*x + ... + xs[n]*x^n.\n\n    Requirements/assumptions:\n    - The input list xs must contain at least two coefficients (non-constant polynomial).\n    - The (reduced) polynomial degree must be odd (this guarantees at least one real root).\n    - The function returns one real root as a float.\n\n    Algorithm:\n    - Trim trailing zero coefficients to determine true degree.\n    - Handle linear case exactly.\n    - Use Horner's method to evaluate p(x).\n    - Find a bracketing interval [low, high] by expanding [-1,1] exponentially until p(low) and p(high) have opposite signs (or an endpoint evaluates to zero).\n    - Use the bisection method on the bracket to produce a robust root approximation.\n    \"\"\"\n    # Basic validation and normalization: make a shallow copy and strip trailing zeros.\n    if not isinstance(xs, (list, tuple)) or len(xs) == 0:\n        raise ValueError(\"xs must be a non-empty list or tuple of coefficients\")\n    coeffs = list(xs)\n    # Remove trailing zeros to find true degree\n    while len(coeffs) > 1 and abs(coeffs[-1]) == 0.0:\n        coeffs.pop()\n    # All-zero polynomial\n    if all(abs(c) == 0.0 for c in coeffs):\n        raise ValueError(\"zero polynomial has infinitely many roots\")\n    degree = len(coeffs) - 1\n    if degree == 0:\n        raise ValueError(\"constant non-zero polynomial has no root\")\n    # Require odd degree (as specified); if not odd, raise to indicate unsupported input.\n    if degree % 2 == 0:\n        raise ValueError(\"function only guarantees results for odd-degree polynomials (degree must be odd)\")\n\n    # Horner evaluation for numerical stability\n    def _eval(x: float) -> float:\n        res = 0.0\n        for c in reversed(coeffs):\n            res = res * x + float(c)\n        return res\n\n    # Sign helper with tolerance for near-zero values\n    zero_tol = 1e-16\n    def _sign(v: float) -> int:\n        if v > zero_tol:\n            return 1\n        if v < -zero_tol:\n            return -1\n        return 0\n\n    # Linear case: exact solution\n    if degree == 1:\n        a = coeffs[1]\n        b = coeffs[0]\n        if abs(a) == 0.0:\n            raise ValueError(\"degenerate linear polynomial\")\n        return -b / a\n\n    # Find an initial bracketing interval where the polynomial changes sign.\n    low, high = -1.0, 1.0\n    p_low = _eval(low)\n    p_high = _eval(high)\n    s_low = _sign(p_low)\n    s_high = _sign(p_high)\n    # If an endpoint already is a root (within tolerance), return it.\n    if s_low == 0:\n        return float(low)\n    if s_high == 0:\n        return float(high)\n\n    # Expand exponentially until sign change is found.\n    max_expansions = 200\n    expansions = 0\n    while s_low == s_high and expansions < max_expansions:\n        low *= 2.0\n        high *= 2.0\n        p_low = _eval(low)\n        p_high = _eval(high)\n        s_low = _sign(p_low)\n        s_high = _sign(p_high)\n        if s_low == 0:\n            return float(low)\n        if s_high == 0:\n            return float(high)\n        expansions += 1\n\n    if s_low == s_high:\n        # This should not happen for odd-degree polynomials, unless numerical overflow/underflow occurred.\n        raise RuntimeError(\"failed to bracket a root after expansions\")\n\n    # Bisection method\n    abs_tol = 1e-12      # absolute tolerance on x-interval\n    value_tol = 1e-14    # tolerance for p(x) ~ 0\n    max_bisect_iter = 200\n    for _ in range(max_bisect_iter):\n        mid = (low + high) / 2.0\n        p_mid = _eval(mid)\n        s_mid = _sign(p_mid)\n        if s_mid == 0 or (high - low) / 2.0 < abs_tol or abs(p_mid) <= value_tol:\n            return float(mid)\n        # Narrow the bracket\n        if s_mid == s_low:\n            low = mid\n            p_low = p_mid\n            s_low = s_mid\n        else:\n            high = mid\n            p_high = p_mid\n            s_high = s_mid\n    # If we exit the loop, return midpoint as the best approximation\n    return float((low + high) / 2.0)"}
