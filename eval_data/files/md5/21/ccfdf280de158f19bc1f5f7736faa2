{"task_id": "HumanEval/76", "solution": "def is_simple_power(x: int, n: int) -> bool:\n    \"\"\"Return True if there exists a non-negative integer k such that n**k == x.\n\n    Notes:\n    - Treats 0**0 as undefined (so is_simple_power(1, 0) -> False).\n    - Handles negative bases correctly (e.g., (-2)**3 == -8).\n    \"\"\"\n    # Handle special bases first\n    if n == 0:\n        # 0**k == 0 for k > 0, and 0**0 is treated as undefined -> only x == 0 counts\n        return x == 0\n    if n == 1:\n        return x == 1\n    if n == -1:\n        return x == 1 or x == -1\n\n    # Trivial x cases\n    if x == 1:\n        return True  # any n**0 == 1 (n == 0 already handled)\n    if x == 0:\n        return False  # only n == 0 yields 0, already handled above\n\n    # Positive base cannot produce a negative x\n    if n > 0 and x < 0:\n        return False\n\n    # Repeatedly divide x by n while divisible\n    current = x\n    while current % n == 0:\n        current //= n\n    return current == 1"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    \"\"\"\n    Return True if integer a is a perfect cube of some integer, else False.\n    \"\"\"\n    n = abs(a)\n    if n < 2:\n        return True  # 0 and 1 are cubes (and -1 handled via abs)\n\n    # Try a float-based approximation and check neighbors to handle typical cases quickly\n    k = int(round(n ** (1/3)))\n    for c in (k - 1, k, k + 1):\n        if c >= 0 and c ** 3 == n:\n            return True\n\n    # Fallback: binary search for integer cube root in range [0, n]\n    lo, hi = 0, n\n    while lo <= hi:\n        mid = (lo + hi) // 2\n        cube = mid * mid * mid\n        if cube == n:\n            return True\n        if cube < n:\n            lo = mid + 1\n        else:\n            hi = mid - 1\n\n    return False"}
{"task_id": "HumanEval/79", "solution": "def decimal_to_binary(decimal):\n    \"\"\"Converts a decimal integer to its binary representation,\n    wrapped with 'db' markers and handling negative signs.\n    \"\"\"\n    if not isinstance(decimal, int):\n        raise TypeError(\"Input must be an integer\")\n\n    sign = ''\n    if decimal < 0:\n        sign = '-'\n        num_to_convert = -decimal\n    else:\n        num_to_convert = decimal\n\n    # bin(0) -> '0b0', so this yields '0' for zero as desired\n    binary_digits = bin(num_to_convert)[2:]\n    return 'db' + sign + binary_digits + 'db'"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Checks if x is a simple power of n (n**k == x for k >= 0).\n    Handles edge cases for x=1, n=1, n=-1, x=0, n=0 according to specification.\"\"\"\n    # Type check: require ints\n    if not isinstance(x, int) or not isinstance(n, int):\n        return False\n\n    # x == 1 => n**0 == 1 for any integer n\n    if x == 1:\n        return True\n\n    # n == 1 => only 1**k == 1\n    if n == 1:\n        return x == 1\n\n    # n == -1 => powers alternate between 1 and -1\n    if n == -1:\n        return x in (1, -1)\n\n    # x == 0 => only possible if n == 0 (0**k == 0 for k>=1)\n    if x == 0:\n        return n == 0\n\n    # n == 0 and x != 0 cannot be a power\n    if n == 0:\n        return x == 0\n\n    # For negative base n with positive x, it's impossible if k even/odd mismatch:\n    # The iterative division below handles signs correctly: x must be divisible by n each step.\n    current = x\n    while current % n == 0:\n        current //= n\n\n    return current == 1"}
