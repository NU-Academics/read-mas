{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    Checks if there are two distinct elements in the list that sum to zero.\n    It uses a set to store previously encountered numbers for efficient lookup.\n    \"\"\"\n    seen_numbers = set()\n    for num in l:\n        complement = -num\n        if complement in seen_numbers:\n            return True\n        seen_numbers.add(num)\n    return False"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int):\n    \"\"\"Convert an integer x into its string representation in a target base.\n    The target base must be between 2 and 9 inclusive.\n    \"\"\"\n    # Type checks\n    if not isinstance(x, int):\n        raise TypeError(\"x must be an int\")\n    if not isinstance(base, int):\n        raise TypeError(\"base must be an int\")\n\n    # Base validation\n    if base < 2 or base > 9:\n        raise ValueError(\"base must be between 2 and 9 inclusive\")\n\n    # Zero shortcut\n    if x == 0:\n        return '0'\n\n    sign = ''\n    n = x\n    if x < 0:\n        sign = '-'\n        n = -x\n\n    digits = []\n    while n > 0:\n        remainder = n % base\n        digits.append(str(remainder))\n        n //= base\n\n    return sign + \"\".join(reversed(digits))"}
{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    if len(l) < 2:\n        return False\n\n    seen = set()\n    for x in l:\n        if -x in seen:\n            return True\n        seen.add(x)\n\n    return False"}
{"task_id": "HumanEval/45", "solution": "def triangle_area(a, h):\n    \"\"\"Given length of a side and high return area for a triangle.\n    >>> triangle_area(5, 3)\n    7.5\n    \"\"\"\n    import numbers\n    import math\n\n    # Reject booleans explicitly (bool is a subclass of int)\n    if isinstance(a, bool) or isinstance(h, bool):\n        raise TypeError(\"a and h must be real numbers, not bool\")\n\n    # Type validation: accept real numbers (int/float/other reals)\n    if not isinstance(a, numbers.Real) or not isinstance(h, numbers.Real):\n        raise TypeError(\"a and h must be real numbers (int or float)\")\n\n    # Finite check\n    if not math.isfinite(a) or not math.isfinite(h):\n        raise ValueError(\"a and h must be finite numbers\")\n\n    # Non-negative check (zero area allowed)\n    if a < 0:\n        raise ValueError(\"a must be non-negative\")\n    if h < 0:\n        raise ValueError(\"h must be non-negative\")\n\n    return (a * h) / 2.0"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    Please write a function to efficiently compute the n-th element of the fib4 number sequence.  Do not use recursion.\n    >>> fib4(5)\n    4\n    >>> fib4(6)\n    8\n    >>> fib4(7)\n    14\n    \"\"\"\n    if n == 0 or n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # Initialize the first four values: fib4(0), fib4(1), fib4(2), fib4(3)\n    a, b, c, d = 0, 0, 2, 0\n\n    # Iterate from n=4 up to the desired n\n    for _ in range(4, n + 1):\n        next_fib = a + b + c + d\n        a = b\n        b = c\n        c = d\n        d = next_fib\n    return d"}
{"task_id": "HumanEval/45", "solution": "def triangle_area(a, h):\n    \"\"\"Given length of a side and high return area for a triangle.\n    >>> triangle_area(5, 3)\n    7.5\n    \"\"\"\n    import numbers\n\n    # Disallow bool which is a subclass of int\n    if isinstance(a, bool) or isinstance(h, bool):\n        raise TypeError(\"a and h must be real numbers, not bool\")\n\n    if not isinstance(a, numbers.Real) or not isinstance(h, numbers.Real):\n        raise TypeError(\"a and h must be real numbers\")\n\n    if a <= 0 or h <= 0:\n        raise ValueError(\"a and h must be positive numbers\")\n\n    return (a * h) / 2.0"}
{"task_id": "HumanEval/47", "solution": "import numbers\n\ndef median(l: list):\n    \"\"\"Compute and return the median value of the list l.\n    Handles empty lists, non-numeric values, and differentiates between odd/even lengths.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    if not l:\n        raise ValueError(\"median() arg is an empty list\")\n\n    for x in l:\n        if not isinstance(x, numbers.Real) or isinstance(x, bool):\n            raise TypeError(\"median() arg must contain only numeric values\")\n\n    s = sorted(l)\n    n = len(s)\n    mid = n // 2\n\n    if n % 2 == 1:\n        return s[mid]\n    else:\n        return (s[mid-1] + s[mid]) / 2"}
{"task_id": "HumanEval/48", "solution": "def is_palindrome(text: str):\n    \"\"\"\n    Checks if given string is a palindrome\n    >>> is_palindrome('')\n    True\n    >>> is_palindrome('aba')\n    True\n    >>> is_palindrome('aaaaa')\n    True\n    >>> is_palindrome('zbcd')\n    False\n    \"\"\"\n    return text == text[::-1]"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    # Input validation\n    if not isinstance(l, list):\n        raise TypeError(\"median() expects a list\")\n    n = len(l)\n    if n == 0:\n        raise ValueError(\"median() arg is an empty list\")\n\n    # Work on a sorted copy to avoid mutating input\n    s = sorted(l)\n\n    # Odd length: return middle element preserving its type\n    mid = n // 2\n    if n % 2 == 1:\n        return s[mid]\n\n    # Even length: return float average of the two middle elements\n    a, b = s[mid - 1], s[mid]\n\n    # Reject complex numbers (not orderable in a meaningful way here)\n    try:\n        if isinstance(a, complex) or isinstance(b, complex):\n            raise TypeError(\"median() does not support complex numbers\")\n    except Exception:\n        # In case isinstance check fails for unusual types, let sorting have already failed earlier.\n        pass\n\n    return (float(a) + float(b)) / 2.0"}
{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int):\n    \"\"\"Return 2^n modulo p (be aware of numerics).\n    >>> modp(3, 5)\n    3\n    >>> modp(1101, 101)\n    2\n    >>> modp(0, 101)\n    1\n    >>> modp(3, 11)\n    8\n    >>> modp(100, 101)\n    1\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer.\")\n    if not isinstance(p, int):\n        raise TypeError(\"p must be an integer.\")\n    if p <= 0:\n        raise ValueError(\"p must be a positive integer (p >= 1).\")\n    if n < 0:\n        raise ValueError(\"n must be a non-negative integer.\")\n\n    return pow(2, n, p)"}
{"task_id": "HumanEval/50", "solution": "def decode_shift(s: str):\n    \"\"\"\n    Decodes a string that was encoded by shifting lowercase letters forward by 5 positions.\n    Assumes input 's' contains only lowercase alphabetic characters.\n    \"\"\"\n    decoded_chars = []\n    for ch in s:\n        # Calculate the original character's ordinal value\n        # by reversing the Caesar shift +5 operation.\n        decoded_ord = ((ord(ch) - 5 - ord('a')) % 26) + ord('a')\n        decoded_chars.append(chr(decoded_ord))\n    return \"\".join(decoded_chars)"}
