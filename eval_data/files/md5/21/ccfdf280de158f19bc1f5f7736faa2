{"task_id": "HumanEval/69", "solution": "from collections import Counter\n\ndef search(lst):\n    \"\"\"\n    Finds the greatest positive integer v such that its frequency in the list is >= v.\n    Returns -1 if no such value exists.\n    \"\"\"\n    counts = Counter(lst)\n    best = -1\n    for value, freq in counts.items():\n        if freq >= value:\n            best = max(best, value)\n    return best"}
{"task_id": "HumanEval/69", "solution": "def search(lst):\n    '''\n    Returns the greatest positive integer x such that its frequency in lst is >= x.\n    Returns -1 if no such integer exists.\n    '''\n    from collections import Counter\n\n    n = len(lst)\n    counts = Counter(lst)  # mapping value -> frequency\n    result = -1\n\n    # Iterate through distinct values and their frequencies.\n    for value, freq in counts.items():\n        # Consider only values <= list length 'n' and where frequency is >= the value itself.\n        if value <= n and freq >= value:\n            if value > result:\n                result = value\n    return result"}
{"task_id": "HumanEval/67", "solution": "def fruit_distribution(s, n):\n    \"\"\"\n    Parses apple and orange counts from a string and calculates the remaining fruit.\n    It expects the string to contain counts for apples and oranges, e.g.:\n      \"5 apples and 6 oranges\"\n      \"1 apple and 0 oranges\"\n    Returns the integer number of mangoes: n - apples - oranges.\n\n    Raises:\n      ValueError: for malformed input, non-integer counts, negative result, or invalid types.\n    \"\"\"\n    # Basic type checks\n    if not isinstance(s, str):\n        raise ValueError(\"s must be a string\")\n    if not isinstance(n, int):\n        raise ValueError(\"n must be an integer\")\n\n    # Normalize and attempt to parse numbers\n    try:\n        # Split on 'and' to separate apples and oranges part (case-insensitive)\n        parts = [p.strip() for p in s.lower().split('and')]\n        if len(parts) != 2:\n            raise ValueError(\"input string must contain exactly one 'and' separating apples and oranges\")\n\n        # Extract leading integer from each part\n        def extract_leading_int(part):\n            if not part:\n                raise ValueError(\"empty part in input\")\n            tokens = part.split()\n            # find first token that can be interpreted as integer\n            for tok in tokens:\n                # strip punctuation\n                tok_stripped = tok.strip(' ,.;:')\n                if tok_stripped.lstrip('-').isdigit():\n                    return int(tok_stripped)\n            raise ValueError(f\"no integer found in part: '{part}'\")\n\n        apples = extract_leading_int(parts[0])\n        oranges = extract_leading_int(parts[1])\n\n    except ValueError:\n        raise\n    except Exception as e:\n        raise ValueError(f\"failed to parse input string: {e}\")\n\n    if apples < 0 or oranges < 0:\n        raise ValueError(\"apple and orange counts must be non-negative\")\n\n    mangoes = n - apples - oranges\n    if mangoes < 0:\n        raise ValueError(\"total fruit count n is less than apples + oranges\")\n\n    return mangoes"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even-valued node and its index in a list of non-negative integers.\n    Returns [value, index] or [] if no even values or an empty input.\n    \"\"\"\n    if not arr:\n        return []\n\n    best_value = None\n    best_index = -1\n\n    for index, value in enumerate(arr):\n        if value % 2 == 0:  # Check if the value is even\n            if best_value is None or value < best_value:\n                best_value = value\n                best_index = index\n\n    if best_value is None:\n        return []\n    else:\n        return [best_value, best_index]"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even value and its index in an array.\n    Returns [value, index] or [] if no even values or array is empty.\n    \"\"\"\n    if not arr:\n        return []\n\n    best_val = None\n    best_idx = -1\n\n    for i, v in enumerate(arr):\n        if v % 2 == 0:\n            if best_val is None or v < best_val:\n                best_val = v\n                best_idx = i\n\n    if best_val is None:\n        return []\n    return [best_val, best_idx]"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    The order alternates between the smallest and largest remaining values.\n    '''\n    if not lst:\n        return []\n\n    s = sorted(lst)\n    result = []\n    i = 0\n    j = len(s) - 1\n\n    while i <= j:\n        result.append(s[i])\n        i += 1\n        if i <= j:\n            result.append(s[j])\n            j -= 1\n    return result"}
