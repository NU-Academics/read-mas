{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    \"\"\"\n    Return True iff there exists a valid subsequence of brackets that contains a nested pair.\n    This is equivalent to checking whether we can find indices a < b < c < d with\n    string[a] == string[b] == '[' and string[c] == string[d] == ']',\n    i.e., the subsequence \"[[]]\".\n    \"\"\"\n    stage = 0  # 0: need first '[', 1: found first '[', need second '[', 2: found second '[', need first ']', 3: found first ']', need second ']'\n    for ch in string:\n        if ch == '[':\n            if stage == 0:\n                stage = 1\n            elif stage == 1:\n                stage = 2\n        elif ch == ']':\n            if stage == 2:\n                stage = 3\n            elif stage == 3:\n                return True\n    return False"}
{"task_id": "HumanEval/133", "solution": "def sum_squares(lst):\n    \"\"\"You are given a list of numbers.\n    Return the sum of squared numbers in the given list,\n    rounding each element to the upper int (ceiling) first.\n    \"\"\"\n    from math import ceil\n\n    if lst is None:\n        raise TypeError(\"lst must be an iterable of numbers\")\n\n    total = 0\n    for x in lst:\n        try:\n            c = ceil(x)\n        except TypeError:\n            raise TypeError(\"All elements of lst must be numbers\") from None\n        total += c * c\n    return total"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    \"\"\"\n    Return True iff there exists a subsequence of the form '[', '[', ']', ']' (i<j<k<l).\n    \"\"\"\n    n = len(string)\n    if n < 4:\n        return False\n\n    # suffix count of ']' after position i (i+1..end)\n    suffix_closes = [0] * (n + 1)\n    for i in range(n - 1, -1, -1):\n        suffix_closes[i] = suffix_closes[i + 1] + (1 if string[i] == ']' else 0)\n\n    opens_seen = 0\n    for i, ch in enumerate(string):\n        if ch == '[':\n            opens_seen += 1\n        else:  # ch == ']'\n            # If there are at least two '[' before this ']' and at least one ']' after it,\n            # we can pick i<j<k<l forming \"[[]]\".\n            if opens_seen >= 2 and suffix_closes[i + 1] >= 1:\n                return True\n\n    return False"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Create a function that returns True if the last character\n    of a given string is an alphabetical character and is not\n    a part of a word, and False otherwise.\n    Note: \"word\" is a group of characters separated by space.\n    \"\"\"\n    if not txt:\n        return False\n\n    # If last character is not a letter, it's not a standalone letter token.\n    if not txt[-1].isalpha():\n        return False\n\n    # Split by space and ignore empty tokens caused by consecutive spaces.\n    tokens = [t for t in txt.split(' ') if t != \"\"]\n\n    if not tokens:\n        return False\n\n    last_token = tokens[-1]\n    # Return True only if the last token is a single alphabetical character.\n    return len(last_token) == 1 and last_token.isalpha()"}
