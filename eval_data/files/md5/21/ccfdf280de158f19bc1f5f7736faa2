{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # Split the string into groups of 3, mirroring encode_cyclic.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n\n    # Reverse the cyclic shift for groups of length 3.\n    decoded_groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n\n    return \"\".join(decoded_groups)"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # Split string into groups of up to 3 characters using same logic as encode_cyclic\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # Reverse the 1-character left rotation for groups of length 3 by rotating right by 1\n    decoded_groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(decoded_groups)"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    if n <= 0:\n        return 0\n\n    total_sevens = 0\n    for i in range(n):\n        if (i % 11 == 0) or (i % 13 == 0):\n            total_sevens += str(i).count('7')\n\n    return total_sevens"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function sorts elements at even indices in a list while preserving elements at odd indices.\"\"\"\n    even_values = []\n    for i in range(len(l)):\n        if i % 2 == 0:\n            even_values.append(l[i])\n\n    even_values.sort()\n\n    result = list(l)  # Create a mutable copy of the input list\n    even_idx_counter = 0\n    for i in range(len(result)):\n        if i % 2 == 0:\n            result[i] = even_values[even_idx_counter]\n            even_idx_counter += 1\n\n    return result"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    Checks if there are three distinct elements in the list that sum to zero.\n    The function sorts the list and uses a two-pointer approach to find such a triplet.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    l.sort()  # Sort the list to efficiently find triplets\n\n    for i in range(n - 2):\n        # Optimization: if current element is positive, no way to sum to zero with two more elements from sorted list\n        if l[i] > 0:\n            break\n\n        left = i + 1\n        right = n - 1\n\n        while left < right:\n            current_sum = l[i] + l[left] + l[right]\n            if current_sum == 0:\n                return True\n            elif current_sum < 0:\n                left += 1  # Need a larger sum, move left pointer right\n            else:\n                right -= 1  # Need a smaller sum, move right pointer left\n    return False"}
