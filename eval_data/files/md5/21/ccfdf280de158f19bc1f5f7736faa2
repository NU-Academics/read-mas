{"task_id": "HumanEval/63", "solution": "def fibfib(n: int):\n    \"\"\"Computes the n-th FibFib number efficiently using matrix exponentiation.\"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 1\n\n    def mat_mul(A, B):\n        # Multiply two 3x3 matrices\n        return [\n            [\n                A[0][0]*B[0][0] + A[0][1]*B[1][0] + A[0][2]*B[2][0],\n                A[0][0]*B[0][1] + A[0][1]*B[1][1] + A[0][2]*B[2][1],\n                A[0][0]*B[0][2] + A[0][1]*B[1][2] + A[0][2]*B[2][2],\n            ],\n            [\n                A[1][0]*B[0][0] + A[1][1]*B[1][0] + A[1][2]*B[2][0],\n                A[1][0]*B[0][1] + A[1][1]*B[1][1] + A[1][2]*B[2][1],\n                A[1][0]*B[0][2] + A[1][1]*B[1][2] + A[1][2]*B[2][2],\n            ],\n            [\n                A[2][0]*B[0][0] + A[2][1]*B[1][0] + A[2][2]*B[2][0],\n                A[2][0]*B[0][1] + A[2][1]*B[1][1] + A[2][2]*B[2][1],\n                A[2][0]*B[0][2] + A[2][1]*B[1][2] + A[2][2]*B[2][2],\n            ],\n        ]\n\n    def mat_pow(M, exp):\n        # Exponentiate 3x3 matrix by integer exp using binary exponentiation\n        result = [[1, 0, 0], [0, 1, 0], [0, 0, 1]]  # identity\n        base = M\n        while exp > 0:\n            if exp & 1:\n                result = mat_mul(result, base)\n            base = mat_mul(base, base)\n            exp >>= 1\n        return result\n\n    # Transition matrix for fibfib: S(k+1) = T * S(k), with S(k) = [f(k), f(k-1), f(k-2)]\n    T = [[1, 1, 1],\n         [1, 0, 0],\n         [0, 1, 0]]\n\n    # For n >= 2: S(n) = T^(n-2) * S(2), and f(n) is first element of S(n).\n    T_exp = mat_pow(T, n - 2)\n    return T_exp[0][0]"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Counts vowels in a string, including 'y' only if it's the last character.\n    Vowels are 'a', 'e', 'i', 'o', 'u' (case-insensitive).\n    \"\"\"\n    count = 0\n    vowels_set = {'a', 'e', 'i', 'o', 'u'}\n    s_lower = s.lower()\n\n    for char in s_lower:\n        if char in vowels_set:\n            count += 1\n\n    # Add 1 to count if the last character is 'y' and the string is not empty.\n    if s_lower and s_lower[-1] == 'y':\n        count += 1\n\n    return count"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shifting digits right by shift\n    and returning the result as a string.\n    If shift > number of digits, returns digits reversed.\n    \"\"\"\n    # Input validation\n    if not isinstance(x, int):\n        raise TypeError(\"x must be an int\")\n    if not isinstance(shift, int):\n        raise TypeError(\"shift must be an int\")\n    if shift < 0:\n        raise ValueError(\"shift must be non-negative\")\n\n    is_negative = x < 0\n    digits = str(abs(x))\n    n = len(digits)\n\n    # Handle cases\n    if n == 0:\n        result_digits = \"\"\n    elif shift == 0 or shift == n:\n        result_digits = digits\n    elif shift > n:\n        result_digits = digits[::-1]\n    else:  # 0 < shift < n\n        result_digits = digits[-shift:] + digits[:-shift]\n\n    return ('-' + result_digits) if is_negative else result_digits"}
{"task_id": "HumanEval/63", "solution": "def fibfib(n: int):\n    \"\"\"Computes the n-th element of the FibFib sequence using matrix exponentiation.\n\n    fibfib(0) == 0\n    fibfib(1) == 0\n    fibfib(2) == 1\n    fibfib(n) == fibfib(n-1) + fibfib(n-2) + fibfib(n-3)\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 1\n\n    def mat_mult(A, B):\n        \"\"\"Multiplies two 3x3 matrices.\"\"\"\n        C = [[0, 0, 0] for _ in range(3)]\n        for i in range(3):\n            ai = A[i]\n            ci = C[i]\n            for k in range(3):\n                aik = ai[k]\n                bk = B[k]\n                ci[0] += aik * bk[0]\n                ci[1] += aik * bk[1]\n                ci[2] += aik * bk[2]\n        return C\n\n    def mat_pow(M, p):\n        \"\"\"Computes M^p using exponentiation by squaring.\"\"\"\n        result = [[1, 0, 0], [0, 1, 0], [0, 0, 1]]  # Identity\n        base = M\n        while p > 0:\n            if p & 1:\n                result = mat_mult(result, base)\n            base = mat_mult(base, base)\n            p >>= 1\n        return result\n\n    # Companion matrix for recurrence f(n)=f(n-1)+f(n-2)+f(n-3)\n    M = [[1, 1, 1],\n         [1, 0, 0],\n         [0, 1, 0]]\n\n    power_matrix = mat_pow(M, n - 2)\n    # V(2) = [1,0,0]^T so fibfib(n) is the (0,0) element of M^(n-2)\n    return power_matrix[0][0]"}
