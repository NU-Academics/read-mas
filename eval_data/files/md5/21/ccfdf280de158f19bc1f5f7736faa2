{"task_id": "HumanEval/0", "solution": "from typing import List\nimport math\n\n\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, any two numbers are closer to each other than\n    given threshold.\n\n    Treats 'closer than' as a strict inequality: |a - b| < threshold.\n\n    Behavior notes:\n    - If threshold is NaN or threshold <= 0 -> returns False.\n    - NaN elements in `numbers` are ignored.\n    - Two identical values (including infinities) are considered distance 0.\n    - Input list is not modified.\n\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    >>> has_close_elements([], 1.0)\n    False\n    >>> has_close_elements([float('nan'), 1.0], 1.0)\n    False\n    >>> has_close_elements([float('inf'), float('inf')], 0.1)\n    True\n    \"\"\"\n    # Validate threshold\n    if math.isnan(threshold) or threshold <= 0:\n        return False\n\n    n = len(numbers)\n    if n < 2:\n        return False\n\n    # Work on a sorted copy to preserve immutability and check adjacent differences.\n    sorted_numbers = sorted(numbers)\n\n    for a, b in zip(sorted_numbers, sorted_numbers[1:]):\n        # Skip pairs involving NaN\n        if math.isnan(a) or math.isnan(b):\n            continue\n        # Equal values (including both +inf or both -inf) => distance 0\n        if a == b:\n            return True\n        # Compute difference; sorted ensures b >= a for normal floats, but handle infinities safely.\n        diff = b - a\n        # If diff is not a finite number (NaN/inf), skip; otherwise compare.\n        if math.isfinite(diff) and diff < threshold:\n            return True\n\n    return False"}
{"task_id": "HumanEval/2", "solution": "def truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    an integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    import math\n\n    if not isinstance(number, (int, float)):\n        raise TypeError(\"number must be a real number\")\n    if math.isnan(number) or math.isinf(number):\n        raise ValueError(\"number must be finite\")\n    if number < 0:\n        raise ValueError(\"number must be non-negative\")\n\n    frac, _ = math.modf(number)\n    frac = abs(frac)  # guard against -0.0 or tiny negative artifacts\n    if math.isclose(frac, 0.0, abs_tol=1e-12):\n        return 0.0\n    return frac"}
{"task_id": "HumanEval/1", "solution": "from typing import List\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    result = []\n    current = []\n    balance = 0\n\n    for ch in paren_string:\n        if ch.isspace():\n            continue\n        if ch == '(':\n            current.append('(')\n            balance += 1\n        elif ch == ')':\n            current.append(')')\n            balance -= 1\n            if balance < 0:\n                raise ValueError('Unbalanced parentheses: too many closing )')\n        else:\n            raise ValueError(f\"Invalid character: {ch!r}\")\n\n        if balance == 0 and current:\n            result.append(''.join(current))\n            current = []\n\n    if balance != 0:\n        raise ValueError('Unbalanced parentheses: missing closing )')\n\n    return result"}
{"task_id": "HumanEval/1", "solution": "def separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    groups: List[str] = []\n    current_group: List[str] = []\n    balance = 0\n\n    for ch in paren_string:\n        if ch.isspace():\n            continue\n        if ch not in (\"(\", \")\"):\n            raise ValueError(f\"Invalid character in input: {ch!r}\")\n        current_group.append(ch)\n        if ch == \"(\":\n            balance += 1\n        else:  # ch == \")\"\n            balance -= 1\n            if balance < 0:\n                raise ValueError(\"Unmatched closing parenthesis\")\n\n        if balance == 0 and current_group:\n            groups.append(\"\".join(current_group))\n            current_group = []\n\n    if balance != 0:\n        raise ValueError(\"Unmatched opening parenthesis\")\n\n    return groups"}
{"task_id": "HumanEval/0", "solution": "from typing import List\n\n\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, any two numbers are closer to each other than the given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    # Handle trivial cases quickly\n    if threshold < 0:\n        raise ValueError(\"threshold must be non-negative\")\n    if len(numbers) < 2:\n        return False\n\n    # Work on a sorted copy to avoid mutating caller's list\n    sorted_nums = sorted(numbers)\n\n    # Check adjacent pairs only (closest in sorted order)\n    for a, b in zip(sorted_nums, sorted_nums[1:]):\n        # If any value is NaN, comparisons are undefined; treat as not close\n        if a != a or b != b:  # NaN check\n            continue\n        # Handle infinities correctly: difference may be inf\n        if abs(b - a) < threshold:\n            return True\n    return False"}
{"task_id": "HumanEval/2", "solution": "def truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, return its decimal part.\n    This is achieved by subtracting the integer part from the number.\n    \"\"\"\n    integer_part = int(number)\n    decimal_part = number - integer_part\n    return decimal_part"}
{"task_id": "HumanEval/4", "solution": "def mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    if not hasattr(numbers, \"__len__\"):\n        raise TypeError(\"numbers must be a sized iterable (e.g., list)\")\n\n    n = len(numbers)\n    if n == 0:\n        raise ValueError(\"numbers must be a non-empty list\")\n\n    try:\n        values = [float(x) for x in numbers]\n    except (TypeError, ValueError):\n        raise TypeError(\"all elements in numbers must be numeric\")\n\n    mean = sum(values) / n\n    mad = sum(abs(x - mean) for x in values) / n\n    return mad"}
{"task_id": "HumanEval/5", "solution": "from typing import List\n\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result: List[int] = []\n    for index, element in enumerate(numbers):\n        if index > 0:\n            result.append(delimeter)\n        result.append(element)\n\n    return result"}
{"task_id": "HumanEval/5", "solution": "from typing import List\n\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'.\n    This implementation pre-allocates the result list for efficiency.\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    n = len(numbers)\n    if n == 0:\n        return []\n\n    # Calculate the exact size for the output list: n elements + (n-1) delimiters\n    output_size = 2 * n - 1\n    # Pre-allocate the list to avoid repeated reallocations.\n    result = [0] * output_size\n\n    write_index = 0\n    for num in numbers:\n        result[write_index] = num\n        write_index += 1\n        # Insert delimiter only if it's not the last element to be written\n        if write_index < output_size:\n            result[write_index] = delimeter\n            write_index += 1\n\n    return result"}
{"task_id": "HumanEval/4", "solution": "import math\nfrom typing import List\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\"Calculates the Mean Absolute Deviation (MAD) around the arithmetic mean.\n    MAD is the average absolute difference between each element and the mean.\n    \"\"\"\n\n    # Per critical requirements, assume inputs are valid and do not perform\n    # validation checks or raise exceptions for edge cases.\n\n    n = len(numbers)\n\n    # Compute the mean using math.fsum for improved precision.\n    total_sum = math.fsum(numbers)\n    mean = total_sum / n\n\n    # Compute the sum of absolute deviations using math.fsum for precision.\n    sum_abs_deviations = math.fsum(abs(x - mean) for x in numbers)\n\n    # Return the average absolute deviation.\n    return sum_abs_deviations / n"}
{"task_id": "HumanEval/7", "solution": "from typing import List\n\n\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    return [s for s in strings if substring in s]"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\n\n\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\"For a given list of integers, return a tuple consisting of a sum and a product.\n    Empty sum should be 0 and empty product should be 1.\n    \"\"\"\n    total_sum = 0\n    total_product = 1\n    for num in numbers:\n        total_sum += num\n        total_product *= num\n    return (total_sum, total_product)"}
{"task_id": "HumanEval/6", "solution": "from typing import List\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"Input is a string containing multiple groups of parentheses separated by whitespace.\n    For each group, return the maximum nesting depth of parentheses.\n\n    Examples:\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n\n    Raises:\n        ValueError: if any group contains characters other than '(' or ')', or if parentheses are unbalanced.\n    \"\"\"\n    if paren_string is None:\n        return []\n\n    s = paren_string.strip()\n    if not s:\n        return []\n\n    results: List[int] = []\n    groups = s.split()  # split on any whitespace, ignoring extra spaces/newlines/tabs\n\n    for group in groups:\n        current_depth = 0\n        max_depth = 0\n        for idx, ch in enumerate(group):\n            if ch == '(':\n                current_depth += 1\n                if current_depth > max_depth:\n                    max_depth = current_depth\n            elif ch == ')':\n                current_depth -= 1\n                if current_depth < 0:\n                    raise ValueError(\n                        f\"Unbalanced parentheses in group {group!r}: too many closing parentheses at index {idx}\"\n                    )\n            else:\n                raise ValueError(\n                    f\"Invalid character {ch!r} in group {group!r}; only '(' and ')' are allowed\"\n                )\n        if current_depth != 0:\n            raise ValueError(f\"Unbalanced parentheses in group {group!r}: mismatched opening parentheses\")\n        results.append(max_depth)\n\n    return results"}
{"task_id": "HumanEval/7", "solution": "from typing import List\n\n\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\"Filter an input list of strings, returning only those that contain the given substring.\n    Maintains original order and is case-sensitive.\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    >>> filter_by_substring(['apple', 'banana', 'cherry'], '')\n    ['apple', 'banana', 'cherry']\n    >>> filter_by_substring(['x', 'y', 'z'], 'a')\n    []\n    >>> filter_by_substring(['Aa', 'aa', 'aA'], 'a')\n    ['aa']\n    \"\"\"\n    return [s for s in strings if substring in s]"}
{"task_id": "HumanEval/6", "solution": "from typing import List\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n    \"\"\"\n    if not paren_string.strip():\n        return []\n\n    groups = paren_string.split()\n    results = []\n\n    for group in groups:\n        current_depth = 0\n        max_depth = 0\n        for char in group:\n            if char == '(':\n                current_depth += 1\n                if current_depth > max_depth:\n                    max_depth = current_depth\n            elif char == ')':\n                current_depth -= 1\n                if current_depth < 0:\n                    raise ValueError(f\"Unbalanced parentheses: too many closing parens in group '{group}'\")\n            else:\n                raise ValueError(f\"Invalid character in group: '{char}'\")\n\n        if current_depth != 0:\n            raise ValueError(f\"Unbalanced parentheses: not all opened parens closed in group '{group}'\")\n\n        results.append(max_depth)\n\n    return results"}
{"task_id": "HumanEval/9", "solution": "from typing import List, Tuple\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    current_max = numbers[0]\n    result = []\n\n    for x in numbers:\n        if x > current_max:\n            current_max = x\n        result.append(current_max)\n\n    return result"}
{"task_id": "HumanEval/9", "solution": "from typing import List\n\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    result = []\n    current_max = float('-inf')  # Tracks the maximum value encountered so far.\n\n    for num in numbers:\n        current_max = max(current_max, num)\n        result.append(current_max)\n\n    return result"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\n\n\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers.\n    Empty sum is 0 and empty product is 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    if not numbers:\n        return (0, 1)\n\n    total_sum = 0\n    total_product = 1\n\n    for n in numbers:\n        total_sum += n\n        total_product *= n\n\n    return (total_sum, total_product)"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    max_len = max(len(a), len(b))\n    # Pad shorter strings with leading zeros to match length.\n    padded_a = a.zfill(max_len)\n    padded_b = b.zfill(max_len)\n\n    result_bits = []\n    for i in range(max_len):\n        # Perform XOR bit by bit.\n        if padded_a[i] != padded_b[i]:\n            result_bits.append('1')\n        else:\n            result_bits.append('0')\n\n    return \"\".join(result_bits)"}
{"task_id": "HumanEval/10", "solution": "def make_palindrome(string: str) -> str:\n    \"\"\"Find the shortest palindrome that begins with the supplied string.\n    Finds the longest palindromic suffix and appends the reverse of the\n    prefix that comes before that suffix.\n    \"\"\"\n    n = len(string)\n    if n == 0:\n        return \"\"\n    for i in range(n):\n        if is_palindrome(string[i:]):\n            prefix_to_reverse = string[:i]\n            return string + prefix_to_reverse[::-1]\n    # Fallback (the loop should always return before this point)\n    return string + string[:-1][::-1]"}
{"task_id": "HumanEval/12", "solution": "def longest(strings: List[str]) -> Optional[str]:\n    \"\"\"Out of list of strings, return the longest one.\n    Return the first one in case of multiple strings of the same length.\n    Return None in case the input list is empty.\n    \"\"\"\n    if not strings:\n        return None\n\n    current_longest = strings[0]\n    for s in strings:\n        if len(s) > len(current_longest):\n            current_longest = s\n    return current_longest"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\"Input are two strings a and b consisting only of '1' and '0' characters.\n    Perform bitwise XOR on these inputs and return result as a string.\n\n    Raises:\n        ValueError: if inputs have different lengths or contain characters other than '0' or '1'.\n\n    Examples:\n        >>> string_xor('010', '110')\n        '100'\n    \"\"\"\n    if len(a) != len(b):\n        raise ValueError(\"Inputs must have the same length\")\n    if any(ch not in {\"0\", \"1\"} for ch in a) or any(ch not in {\"0\", \"1\"} for ch in b):\n        raise ValueError(\"Inputs must contain only '0' and '1' characters\")\n    return \"\".join(\"1\" if x != y else \"0\" for x, y in zip(a, b))"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome. \"\"\"\n    return string == string[::-1]\n\n\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    This appends the reverse of the prefix preceding the longest palindromic suffix.\n    \"\"\"\n    n = len(string)\n\n    # Handle edge cases for empty, single-character, or already-palindromic strings.\n    if n <= 1 or is_palindrome(string):\n        return string\n\n    # Find the longest palindromic suffix of the input string.\n    # The first 'i' where string[i:] is a palindrome gives the longest such suffix.\n    for i in range(n):\n        suffix = string[i:]\n        if is_palindrome(suffix):\n            # Extract the prefix that comes before the found palindromic suffix.\n            prefix_before_suffix = string[:i]\n            # Construct the shortest palindrome by appending the reversed prefix.\n            return string + prefix_before_suffix[::-1]"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    a = abs(a)\n    b = abs(b)\n    while b:\n        a, b = b, a % b\n    return a"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\"Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    a_abs = abs(a)\n    b_abs = abs(b)\n\n    while b_abs != 0:\n        a_abs, b_abs = b_abs, a_abs % b_abs\n    return a_abs"}
{"task_id": "HumanEval/14", "solution": "from typing import List\n\n\ndef all_prefixes(string: str) -> List[str]:\n    \"\"\" Return list of all prefixes from shortest to longest of the input string\n    >>> all_prefixes('abc')\n    ['a', 'ab', 'abc']\n    \"\"\"\n    return [string[:i] for i in range(1, len(string) + 1)]"}
