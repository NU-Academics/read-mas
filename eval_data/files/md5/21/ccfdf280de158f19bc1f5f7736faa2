{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 1:\n        raise ValueError(\"n must be a positive integer (n >= 1)\")\n\n    total = 1\n    factorial = 1\n    for i in range(1, n + 1):\n        factorial *= i\n        total *= factorial\n    return total"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n >= 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and returns the special\n    factorial of this integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    special_fact = 1\n    current_factorial = 1\n    for k in range(1, n + 1):\n        current_factorial *= k\n        special_fact *= current_factorial\n    return special_fact"}
{"task_id": "HumanEval/137", "solution": "import math\n\ndef compare_one(a, b):\n    \"\"\"Compares two values (int, float, or string numbers) and returns the numerically larger original value, or None if equal.\"\"\"\n\n    original_a = a\n    original_b = b\n\n    # Convert a to numeric float (na)\n    if isinstance(a, str):\n        s_a = a.strip().replace(',', '.')\n        try:\n            na = float(s_a)\n        except ValueError:\n            raise ValueError(f\"Cannot convert string '{a}' to a number after normalization.\")\n    elif isinstance(a, (int, float)):\n        na = float(a)\n    else:\n        raise TypeError(f\"Unsupported type for a: {type(a).__name__}\")\n\n    # Convert b to numeric float (nb)\n    if isinstance(b, str):\n        s_b = b.strip().replace(',', '.')\n        try:\n            nb = float(s_b)\n        except ValueError:\n            raise ValueError(f\"Cannot convert string '{b}' to a number after normalization.\")\n    elif isinstance(b, (int, float)):\n        nb = float(b)\n    else:\n        raise TypeError(f\"Unsupported type for b: {type(b).__name__}\")\n\n    # Compare numeric values\n    if math.isclose(na, nb, rel_tol=1e-9, abs_tol=1e-12):\n        return None\n    elif na > nb:\n        return original_a\n    else:\n        return original_b"}
{"task_id": "HumanEval/137", "solution": "from decimal import Decimal, InvalidOperation\n\ndef compare_one(a, b):\n    \"\"\"Compares two values (int, float, or string numbers) and returns the larger in its original type.\n    Returns None if values are numerically equal, raising TypeError for unsupported types or malformed strings.\n    \"\"\"\n\n    def to_decimal(val, name):\n        if isinstance(val, int):\n            return Decimal(val)\n        if isinstance(val, float):\n            return Decimal(str(val))\n        if isinstance(val, str):\n            s = val.strip().replace(',', '.')\n            try:\n                return Decimal(s)\n            except InvalidOperation:\n                raise TypeError(f\"Invalid string format for '{name}': '{val}'\")\n        raise TypeError(f\"Unsupported type for '{name}': {type(val).__name__}\")\n\n    dec_a = to_decimal(a, 'a')\n    dec_b = to_decimal(b, 'b')\n\n    if dec_a == dec_b:\n        return None\n    return a if dec_a > dec_b else b"}
{"task_id": "HumanEval/140", "solution": "def fix_spaces(text):\n    \"\"\"\n    Replaces runs of 3 or more consecutive spaces with a hyphen,\n    and all single spaces (including any remaining pairs of two spaces) with underscores.\n    \"\"\"\n    result = []\n    i = 0\n    n = len(text)\n\n    while i < n:\n        if text[i] == ' ':\n            space_count = 0\n            j = i\n            while j < n and text[j] == ' ':\n                space_count += 1\n                j += 1\n\n            if space_count >= 3:\n                result.append('-')\n            elif space_count == 2:\n                result.append('__')\n            else:  # space_count == 1\n                result.append('_')\n            i = j\n        else:\n            result.append(text[i])\n            i += 1\n    return \"\".join(result)"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Checks if a file name is valid based on specific rules.\"\"\"\n\n    # 1. Ensure file_name contains exactly one '.' character.\n    if file_name.count('.') != 1:\n        return 'No'\n\n    # 2. Split into name_part and ext_part, name_part must be non-empty.\n    name_part, ext_part = file_name.split('.', 1)\n    if not name_part:\n        return 'No'\n\n    # 3. Check the first character of name_part is a latin alphabet letter.\n    first_char = name_part[0]\n    if not (('a' <= first_char <= 'z') or ('A' <= first_char <= 'Z')):\n        return 'No'\n\n    # 4. Check ext_part is one of the allowed extensions.\n    allowed_extensions = {'txt', 'exe', 'dll'}\n    if ext_part not in allowed_extensions:\n        return 'No'\n\n    # 5. Count digits in the entire file_name and ensure there are at most 3.\n    digit_count = sum(c.isdigit() for c in file_name)\n    if digit_count > 3:\n        return 'No'\n\n    # If all checks pass\n    return 'Yes'"}
{"task_id": "HumanEval/140", "solution": "def fix_spaces(text):\n    \"\"\"\n    Replaces single or double spaces with underscores, and runs of three or more consecutive spaces with a hyphen.\n    It processes the string character by character to manage space sequences.\n    \"\"\"\n    result = []\n    space_count = 0\n    for char in text:\n        if char == ' ':\n            space_count += 1\n        else:\n            if space_count > 0:\n                if space_count > 2:\n                    result.append('-')\n                else: # space_count is 1 or 2\n                    result.append('_' * space_count)\n            result.append(char)\n            space_count = 0\n    # Handle any trailing spaces at the end of the string\n    if space_count > 0:\n        if space_count > 2:\n            result.append('-')\n        else:\n            result.append('_' * space_count)\n    return \"\".join(result)"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a\n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not\n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries.\n    \"\"\"\n    total_sum = 0\n    for i, entry in enumerate(lst):\n        if i % 3 == 0:\n            total_sum += entry ** 2\n        elif i % 4 == 0:\n            total_sum += entry ** 3\n        else:\n            total_sum += entry\n    return total_sum"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Checks if a file name is valid based on several rules.\n    Returns 'Yes' for a valid name, 'No' otherwise.\n    \"\"\"\n    if file_name.count('.') != 1:\n        return 'No'\n\n    parts = file_name.split('.')\n    prefix = parts[0]\n    suffix = parts[1]\n\n    if suffix not in ['txt', 'exe', 'dll']:\n        return 'No'\n\n    if not prefix or not prefix[0].isalpha():\n        return 'No'\n\n    digit_count = 0\n    for char in file_name:\n        if '0' <= char <= '9':\n            digit_count += 1\n\n    if digit_count > 3:\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Filters words from a sentence, keeping only those with prime lengths.\n    The order of words is preserved.\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"Checks if a number is prime.\"\"\"\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    words = sentence.split()\n    prime_words = []\n    for word in words:\n        if is_prime(len(word)):\n            prime_words.append(word)\n\n    return \" \".join(prime_words)"}
{"task_id": "HumanEval/144", "solution": "def gcd(u, v):\n    \"\"\"Implements the Euclidean algorithm to find the greatest common divisor.\n    This helps in reducing fractions by canceling common factors efficiently.\"\"\"\n    while v:\n        u, v = v, u % v\n    return u\n\ndef simplify(x, n):\n    \"\"\"Determines if the product of two fractions x and n is a whole number.\n    It uses integer arithmetic with GCD-based cross-cancellation for efficiency.\"\"\"\n    # Parse x into numerator 'a' and denominator 'b'\n    x_parts = x.strip().split('/')\n    a = int(x_parts[0])\n    b = int(x_parts[1])\n\n    # Parse n into numerator 'c' and denominator 'd'\n    n_parts = n.strip().split('/')\n    c = int(n_parts[0])\n    d = int(n_parts[1])\n\n    # Perform cross-cancellation to avoid large intermediate numbers\n    # g1 = gcd(a, d); a //= g1; d //= g1\n    common_ad = gcd(a, d)\n    a //= common_ad\n    d //= common_ad\n\n    # g2 = gcd(c, b); c //= g2; b //= g2\n    common_cb = gcd(c, b)\n    c //= common_cb\n    b //= common_cb\n\n    # After cancellation, check if (a*c) is divisible by (b*d)\n    return (a * c) % (b * d) == 0"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Filters words in a sentence, keeping only those with prime lengths.\n    Preserves original order and separates words by a single space.\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"Checks if a number is prime using trial division.\"\"\"\n        if n < 2:\n            return False\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 1\n        return True\n\n    result_words = []\n    words = sentence.split()\n\n    for word in words:\n        if is_prime(len(word)):\n            result_words.append(word)\n\n    return \" \".join(result_words)"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    Sums transformed integers from a list based on their index. Elements at indices multiple of 3 are squared; those at indices multiple of 4 (but not 3) are cubed; others are unchanged.\n    \"\"\"\n    total = 0\n    for i, val in enumerate(lst):\n        if not isinstance(val, int):\n            raise TypeError(\"All elements of lst must be integers\")\n        if i % 3 == 0:\n            transformed_val = val * val\n        elif i % 4 == 0:\n            transformed_val = val * val * val\n        else:\n            transformed_val = val\n        total += transformed_val\n    return total"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"\n    Write a function that takes an array of numbers as input and returns\n    the number of elements in the array that are greater than 10 and both\n    first and last digits of a number are odd (1, 3, 5, 7, 9).\n    For example:\n    specialFilter([15, -73, 14, -15]) => 1\n    specialFilter([33, -2, -3, 45, 21, 109]) => 2\n    \"\"\"\n    count = 0\n    for num in nums:\n        if num > 10:\n            abs_num = int(abs(num))\n\n            # Get the last digit\n            last_digit = abs_num % 10\n\n            # Get the first digit\n            first_digit = abs_num\n            while first_digit >= 10:\n                first_digit //= 10\n\n            # Check if both the first and last digits are odd\n            if last_digit % 2 == 1 and first_digit % 2 == 1:\n                count += 1\n    return count"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sort a list of integers in ascending order by the sum of their digits.\n    For tie-breaking, preserve the original order (stable) by using the original index.\n    \"\"\"\n    def _digit_sum(n):\n        return sum(int(ch) for ch in str(abs(n)))\n\n    return [val for _, val in sorted(enumerate(nums), key=lambda iv: (_digit_sum(iv[1]), iv[0]))]"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers by the sum of their digits (absolute value),\n    preserving original order for equal sums.\n    \"\"\"\n    def sum_digits(n):\n        s = 0\n        n_abs = abs(n)\n        while n_abs > 0:\n            s += n_abs % 10\n            n_abs //= 10\n        return s\n\n    # Create a list of tuples (number, original_index) to preserve original order for ties.\n    indexed_nums = [(num, i) for i, num in enumerate(nums)]\n\n    # Sort based on the sum of digits (primary key) and then by original index (secondary key).\n    indexed_nums.sort(key=lambda item: (sum_digits(item[0]), item[1]))\n\n    # Extract the sorted numbers from the tuples.\n    return [item[0] for item in indexed_nums]"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"Counts numbers strictly greater than 10 whose first and last digits are odd.\n    Non-numeric elements in the input iterable are ignored.\n    \"\"\"\n    odd_digits = {1, 3, 5, 7, 9}\n    count = 0\n\n    for value in nums:\n        if not isinstance(value, (int, float)):\n            continue\n\n        # Check strictly greater than 10\n        try:\n            if value <= 10:\n                continue\n        except Exception:\n            # Skip values that cannot be ordered (e.g., NaN, complex)\n            continue\n\n        # Convert to absolute integer part for digit extraction\n        try:\n            n = abs(int(value))\n        except Exception:\n            continue\n\n        last_digit = n % 10\n\n        # Extract first digit\n        first_digit = n\n        while first_digit >= 10:\n            first_digit //= 10\n\n        if first_digit in odd_digits and last_digit in odd_digits:\n            count += 1\n\n    return count"}
{"task_id": "HumanEval/144", "solution": "def simplify(x, n):\n    import math\n    a_num_str, a_den_str = x.split('/')\n    b_num_str, b_den_str = n.split('/')\n    num1 = int(a_num_str)\n    den1 = int(a_den_str)\n    num2 = int(b_num_str)\n    den2 = int(b_den_str)\n\n    # If any numerator is zero, the product is 0 which is a whole number\n    if num1 == 0 or num2 == 0:\n        return True\n\n    # Cross-cancel common factors to avoid large intermediate products\n    g = math.gcd(num1, den2)\n    num1 //= g\n    den2 //= g\n\n    g = math.gcd(num2, den1)\n    num2 //= g\n    den1 //= g\n\n    # After cancellation, product is whole iff numerator divisible by denominator\n    return (num1 * num2) % (den1 * den2) == 0"}
{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    '''\n    Returns a tuple of planets between planet1 and planet2, sorted by proximity to the Sun.\n    Returns an empty tuple if planet names are invalid or no planets are between them.\n    '''\n    planets_order = ['Mercury', 'Venus', 'Earth', 'Mars', 'Jupiter', 'Saturn', 'Uranus', 'Neptune']\n\n    if planet1 not in planets_order or planet2 not in planets_order:\n        return ()\n\n    idx1 = planets_order.index(planet1)\n    idx2 = planets_order.index(planet2)\n\n    if idx1 == idx2:\n        return ()\n\n    min_idx = min(idx1, idx2)\n    max_idx = max(idx1, idx2)\n\n    return tuple(planets_order[min_idx + 1:max_idx])"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    You are given a positive integer n. You have to create an integer array a of length n.\n    For each i (1 \u2264 i \u2264 n), the value of a[i] = i * i - i + 1.\n    Return the number of triples (a[i], a[j], a[k]) of a where i < j < k,\n    and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n    def combinations3(count):\n        if count < 3:\n            return 0\n        return count * (count - 1) * (count - 2) // 6\n\n    # For i mod 3:\n    # i % 3 == 2 -> a[i] % 3 == 0\n    # i % 3 == 0 or 1 -> a[i] % 3 == 1\n\n    count_i_rem1 = (n + 2) // 3  # i \u2261 1 (mod 3)\n    count_i_rem2 = (n + 1) // 3  # i \u2261 2 (mod 3)\n    count_i_rem0 = n // 3        # i \u2261 0 (mod 3)\n\n    N_0_mod_3 = count_i_rem2\n    N_1_mod_3 = count_i_rem0 + count_i_rem1\n\n    # Valid triples: all three are 0 mod 3, or all three are 1 mod 3\n    return combinations3(N_0_mod_3) + combinations3(N_1_mod_3)"}
