{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return the sum of the elements\n    with at most two digits from the first k elements of arr.\n\n    'At most two digits' is defined as abs(x) <= 99.\n    \"\"\"\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an integer\")\n    if not isinstance(arr, (list, tuple)):\n        raise TypeError(\"arr must be a list or tuple of integers\")\n    if len(arr) == 0:\n        raise ValueError(\"arr must be non-empty\")\n    if k < 1 or k > len(arr):\n        raise ValueError(\"k must satisfy 1 <= k <= len(arr)\")\n\n    return sum(x for x in arr[:k] if abs(x) <= 99)"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    '''\n    Given a list of numbers, return whether they are sorted in ascending order.\n    Also, ensure no number appears more than twice (i.e., at most one duplicate).\n    '''\n    # Check if the list is sorted in non-decreasing (ascending) order\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i + 1]:\n            return False\n\n    # Check for more than one duplicate of any number (count > 2)\n    counts = {}\n    for num in lst:\n        counts[num] = counts.get(num, 0) + 1\n        if counts[num] > 2:\n            return False\n\n    return True"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n\n    The Collatz conjecture is a conjecture in mathematics that concerns a sequence defined\n    as follows: start with any positive integer n. Then each term is obtained from the\n    previous term as follows: if the previous term is even, the next term is one half of\n    the previous term. If the previous term is odd, the next term is 3 times the previous\n    term plus 1. The conjecture is that no matter what value of n, the sequence will always reach 1.\n\n    Note:\n        1. Collatz(1) is [1].\n        2. returned list sorted in increasing order.\n\n    For example:\n    get_odd_collatz(5) returns [1, 5] # The collatz sequence for 5 is [5, 16, 8, 4, 2, 1], so the odd numbers are only 1, and 5.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n\n    odd_numbers = set()\n    current = n\n\n    while True:\n        if current % 2 != 0:\n            odd_numbers.add(current)\n        if current == 1:\n            break\n        if current % 2 == 0:\n            current //= 2\n        else:\n            current = 3 * current + 1\n\n    return sorted(odd_numbers)"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    '''\n    Splits a string based on whitespace, then commas, or counts odd-ordered lowercase letters.\n    Odd-ordered means ord(char) - ord('a') is odd.\n    '''\n\n    has_whitespace = False\n    for char in txt:\n        if char.isspace():\n            has_whitespace = True\n            break\n\n    if has_whitespace:\n        return txt.split()\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        odd_order_count = 0\n        for char in txt:\n            if 'a' <= char <= 'z':\n                if (ord(char) - ord('a')) % 2 != 0:\n                    odd_order_count += 1\n        return odd_order_count"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    \"\"\"\n    Splits text based on whitespace, then commas, or counts odd-indexed lowercase letters.\n    \"\"\"\n    if any(c.isspace() for c in txt):\n        return txt.split()\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        count = 0\n        for char in txt:\n            if 'a' <= char <= 'z' and (ord(char) - ord('a')) % 2 != 0:\n                count += 1\n        return count"}
{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"You are given two closed integer intervals interval1 and interval2 as (start, end).\n    Return \"YES\" if the length of their intersection (end - start) is a prime number, otherwise \"NO\".\n    If they don't intersect, return \"NO\".\"\"\"\n    def is_prime(n):\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    int_start = max(start1, start2)\n    int_end = min(end1, end2)\n\n    if int_start > int_end:\n        return \"NO\"\n\n    length = int_end - int_start\n    return \"YES\" if is_prime(length) else \"NO\""}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n    '''\n    counts = {}\n\n    if len(lst) <= 1:\n        return True\n\n    for i in range(len(lst)):\n        num = lst[i]\n\n        if i > 0 and num < lst[i-1]:\n            return False\n\n        counts[num] = counts.get(num, 0) + 1\n\n        if counts[num] > 2:\n            return False\n\n    return True"}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Returns the sum of magnitudes of integers in arr multiplied by the product of their signs.\n    Returns None if arr is empty, or 0 if any element in arr is zero.\n    \"\"\"\n    if not arr:\n        return None\n\n    sum_abs = 0\n    neg_count = 0\n\n    for x in arr:\n        if x == 0:\n            return 0\n        sum_abs += abs(x)\n        if x < 0:\n            neg_count += 1\n\n    sign_product = -1 if neg_count % 2 == 1 else 1\n\n    return sign_product * sum_abs"}
{"task_id": "HumanEval/127", "solution": "def is_prime(n):\n    # Helper function to determine if a number is prime.\n    # It uses an optimized trial division method.\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n\ndef intersection(interval1, interval2):\n    \"\"\"Determines if the length of the intersection of two closed intervals is a prime number.\n    Returns \"YES\" if prime, \"NO\" otherwise or if intervals do not intersect.\n    \"\"\"\n    a, b = interval1\n    c, d = interval2\n\n    left = max(a, c)\n    right = min(b, d)\n\n    # If left >= right, the intervals either do not overlap or overlap at a single point.\n    # In both cases, the effective length of the intersection is 0 or negative, which is not prime.\n    if left >= right:\n        return \"NO\"\n\n    length = right - left\n\n    # Check if the calculated intersection length is a prime number.\n    return \"YES\" if is_prime(length) else \"NO\""}
{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Finds the lexicographically smallest path of length k in a grid by\n    greedily selecting the minimum reachable value at each step.\n    \"\"\"\n    if k <= 0 or not grid:\n        return []\n\n    n = len(grid)\n\n    # Step 2: Initialize by finding the minimal value and its positions.\n    min_val0 = float('inf')\n    current_positions = set()\n    for r_idx in range(n):\n        for c_idx in range(n):\n            val = grid[r_idx][c_idx]\n            if val < min_val0:\n                min_val0 = val\n                current_positions = {(r_idx, c_idx)}\n            elif val == min_val0:\n                current_positions.add((r_idx, c_idx))\n\n    result = [min_val0]\n\n    # Directions for orthogonal neighbors (right, left, down, up)\n    directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n\n    # Step 3: For k-1 steps, extend the path.\n    for _ in range(1, k):\n        min_neighbor_val = float('inf')\n        next_positions = set()\n\n        # Examine all neighbors of current positions\n        for r, c in current_positions:\n            for dr, dc in directions:\n                nr, nc = r + dr, c + dc\n\n                # Check if neighbor is within grid bounds\n                if 0 <= nr < n and 0 <= nc < n:\n                    neighbor_val = grid[nr][nc]\n                    if neighbor_val < min_neighbor_val:\n                        min_neighbor_val = neighbor_val\n                        next_positions = {(nr, nc)} # Start new set for new minimum\n                    elif neighbor_val == min_neighbor_val:\n                        next_positions.add((nr, nc)) # Add to set if same minimum\n\n        result.append(min_neighbor_val)\n        current_positions = next_positions\n\n    # Step 4: Return the final sequence.\n    return result"}
{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Finds the lexicographically minimum path of length k in a grid by starting at cell 1\n    and greedily choosing the smallest neighbor at each subsequent step.\n    \"\"\"\n    N = len(grid)\n\n    # Find the starting cell (coordinates of value 1)\n    current_r, current_c = -1, -1\n    for r_idx in range(N):\n        for c_idx in range(N):\n            if grid[r_idx][c_idx] == 1:\n                current_r, current_c = r_idx, c_idx\n                break\n        if current_r != -1:\n            break\n\n    path = []\n    # Build the path greedily for k steps\n    for _ in range(k):\n        path.append(grid[current_r][current_c])\n\n        # If the path has reached length k, no further moves are needed\n        if len(path) == k:\n            break\n\n        min_neighbor_value = float('inf')\n        next_r, next_c = -1, -1\n\n        # Define possible orthogonal moves: (dr, dc) for up, down, left, right\n        moves = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n\n        for dr, dc in moves:\n            neighbor_r, neighbor_c = current_r + dr, current_c + dc\n\n            # Check if the neighbor is within grid bounds\n            if 0 <= neighbor_r < N and 0 <= neighbor_c < N:\n                neighbor_value = grid[neighbor_r][neighbor_c]\n                if neighbor_value < min_neighbor_value:\n                    min_neighbor_value = neighbor_value\n                    next_r, next_c = neighbor_r, neighbor_c\n\n        # Update current position to the chosen neighbor for the next step\n        current_r, current_c = next_r, next_c\n\n    return path"}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Computes (sum of magnitudes of integers in arr) * (product of signs).\n    Returns None for empty arr, or 0 if any element is zero.\n    \"\"\"\n    if len(arr) == 0:\n        return None\n\n    sum_abs = 0\n    product_sign = 1\n\n    for x in arr:\n        if x == 0:\n            return 0\n        sum_abs += abs(x)\n        if x > 0:\n            product_sign *= 1\n        else:  # x < 0\n            product_sign *= -1\n\n    return product_sign * sum_abs"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"\n    Return a list of the first n+1 Tribonacci numbers:\n    - tri(1) = 3\n    - tri(n) = 1 + n/2 for even n (including n=0)\n    - tri(n) = tri(n-1) + tri(n-2) + tri(n+1) for odd n\n    The returned list contains tri(0) through tri(n).\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n\n    # If n is odd, we need tri(n+1) (even) to compute tri(n).\n    max_idx = n if n % 2 == 0 else n + 1\n\n    vals = [0] * (max_idx + 1)\n\n    # Fill base/even values\n    for i in range(max_idx + 1):\n        if i == 1:\n            vals[1] = 3\n        elif i % 2 == 0:\n            vals[i] = 1 + i // 2\n\n    # Fill odd values >=3 using dependency on already computed even indices\n    for i in range(3, max_idx + 1, 2):\n        vals[i] = vals[i - 1] + vals[i - 2] + vals[i + 1]\n\n    return vals[: n + 1]"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"\n    Compute the Tribonacci sequence up to index n (0-indexed) and return a list\n    of the first n+1 values.\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n\n    result = [None] * (n + 1)\n    result[0] = 1\n    if n >= 1:\n        result[1] = 3\n\n    for i in range(2, n + 1):\n        if i % 2 == 0:  # even\n            result[i] = 1 + i // 2\n        else:  # odd\n            tri_ip1 = 1 + (i + 1) // 2  # i+1 is even => direct formula\n            result[i] = result[i - 1] + result[i - 2] + tri_ip1\n\n    return result"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    n = abs(n)\n\n    product = 1\n    found_odd = False\n    for char_digit in str(n):\n        digit = int(char_digit)\n        if digit % 2 != 0:\n            product *= digit\n            found_odd = True\n\n    return product if found_odd else 0"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    For example:\n    digits(1)  == 1\n    digits(4)  == 0\n    digits(235) == 15\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        n = -n\n\n    if n == 0:\n        return 0\n\n    product = 1\n    found_odd = False\n    while n:\n        d = n % 10\n        if d & 1:\n            product *= d\n            found_odd = True\n        n //= 10\n\n    return product if found_odd else 0"}
