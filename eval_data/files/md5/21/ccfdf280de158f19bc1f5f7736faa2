{"task_id": "HumanEval/81", "solution": "import math\n\ndef numerical_letter_grade(grades):\n    \"\"\"Converts a list of numeric GPAs into letter grades based on a predefined mapping.\n    Assumes valid input GPAs within [0.0, 4.0] and handles float precision for exact boundaries.\n    \"\"\"\n\n    # Tolerance choices as specified in the design document for equality checks.\n    REL_TOL = 1e-9\n    ABS_TOL = 1e-9\n\n    result_grades = []\n    for gpa in grades:\n        if math.isclose(gpa, 4.0, rel_tol=REL_TOL, abs_tol=ABS_TOL):\n            letter_grade = 'A+'\n        elif gpa > 3.7:\n            letter_grade = 'A'\n        elif gpa > 3.3:\n            letter_grade = 'A-'\n        elif gpa > 3.0:\n            letter_grade = 'B+'\n        elif gpa > 2.7:\n            letter_grade = 'B'\n        elif gpa > 2.3:\n            letter_grade = 'B-'\n        elif gpa > 2.0:\n            letter_grade = 'C+'\n        elif gpa > 1.7:\n            letter_grade = 'C'\n        elif gpa > 1.3:\n            letter_grade = 'C-'\n        elif gpa > 1.0:\n            letter_grade = 'D+'\n        elif gpa > 0.7:\n            letter_grade = 'D'\n        elif gpa > 0.0:\n            letter_grade = 'D-'\n        elif math.isclose(gpa, 0.0, rel_tol=REL_TOL, abs_tol=ABS_TOL):\n            letter_grade = 'E'\n        # Per critical requirements, assume inputs are always valid and within range,\n        # so no 'else' is needed for out-of-range or invalid cases.\n\n        result_grades.append(letter_grade)\n\n    return result_grades"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds occurrences of integer x in a nested list and returns their coordinates.\n    Coordinates are sorted by row ascending, then by column descending.\n    \"\"\"\n    coordinates = []\n    for r_idx, row in enumerate(lst):\n        for c_idx, element in enumerate(row):\n            if element == x:\n                coordinates.append((r_idx, c_idx))\n\n    # Sort primarily by row in ascending order, then by column in descending order\n    coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n    return coordinates"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting.\n    Sort ascending if the sum of the first and last element is odd, or descending if that sum is even.\n    The original array is not modified.\n    \"\"\"\n    if not array:\n        return []\n    if len(array) == 1:\n        return list(array)\n\n    first_val = array[0]\n    last_val = array[-1]\n    total_sum = first_val + last_val\n\n    arr_copy = list(array)\n    if total_sum % 2 != 0:  # Odd sum -> ascending\n        arr_copy.sort()\n    else:  # Even sum -> descending\n        arr_copy.sort(reverse=True)\n\n    return arr_copy"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting.\n    Sort ascending if the sum of the first and last elements is odd, otherwise sort descending.\n    The input array is not modified.\n    \"\"\"\n    if len(array) <= 1:\n        return list(array)\n\n    if (array[0] + array[-1]) % 2 == 1:\n        return sorted(array)\n    return sorted(array, reverse=True)"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by rotating letters by four places. Non-alphabetic characters remain unchanged.\"\"\"\n    result = []\n    shift = 4  # Shift down by two multiplied to two places (2 * 2 = 4)\n\n    for char in s:\n        if 'a' <= char <= 'z':\n            # Handle lowercase letters\n            new_char_code = ord('a') + (ord(char) - ord('a') + shift) % 26\n            result.append(chr(new_char_code))\n        elif 'A' <= char <= 'Z':\n            # Handle uppercase letters\n            new_char_code = ord('A') + (ord(char) - ord('A') + shift) % 26\n            result.append(chr(new_char_code))\n        else:\n            # Keep non-alphabetic characters as they are\n            result.append(char)\n\n    return \"\".join(result)"}
{"task_id": "HumanEval/90", "solution": "def next_smallest(lst):\n    \"\"\"\n    You are given a list of integers.\n    Write a function next_smallest() that returns the 2nd smallest element of the list.\n    Return None if there is no such element.\n    \"\"\"\n    smallest = float('inf')\n    second_smallest = float('inf')\n\n    for x in lst:\n        if x < smallest:\n            second_smallest = smallest\n            smallest = x\n        elif smallest < x < second_smallest:\n            second_smallest = x\n\n    if second_smallest == float('inf'):\n        return None\n    else:\n        return second_smallest"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Applies a Caesar-like rotation to English alphabet letters by shifting them forward by 4 positions.\n    Non-letter characters and their case are preserved.\"\"\"\n    output_chars = []\n    for c in s:\n        if 'a' <= c <= 'z':\n            # Shift lowercase letters by 4, wrapping around 'z'.\n            new_c = chr((ord(c) - ord('a') + 4) % 26 + ord('a'))\n        elif 'A' <= c <= 'Z':\n            # Shift uppercase letters by 4, wrapping around 'Z'.\n            new_c = chr((ord(c) - ord('A') + 4) % 26 + ord('A'))\n        else:\n            # Non-letter characters are appended unchanged.\n            new_c = c\n        output_chars.append(new_c)\n    return ''.join(output_chars)"}
{"task_id": "HumanEval/91", "solution": "def is_bored(S):\n    \"\"\"\n    You'll be given a string of words, and your task is to count the number\n    of boredoms. A boredom is a sentence that starts with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n\n    For example:\n    >>> is_bored(\"Hello world\")\n    0\n    >>> is_bored(\"The sky is blue. The sun is shining. I love this weather\")\n    1\n    \"\"\"\n    import re\n\n    segments = re.split(r'[.?!]', S)\n    count = 0\n\n    for segment in segments:\n        s = segment.strip()\n        if not s:\n            continue\n\n        # Remove common leading quote/parenthesis characters\n        while s and s[0] in \"\\\"'([\":\n            s = s[1:]\n\n        # Get the first token (up to whitespace)\n        m = re.match(r'^\\S+', s)\n        if not m:\n            continue\n        token = m.group(0)\n\n        # Remove trailing punctuation except apostrophe to avoid counting \"I'm\"\n        token = token.rstrip('.,:;!?)\"')\n\n        if token == 'I':\n            count += 1\n\n    return count"}
{"task_id": "HumanEval/91", "solution": "import re\n\ndef is_bored(S):\n    \"\"\"\n    Counts sentences starting with \"I\". Sentences are delimited by '.', '?' or '!'.\n    Leading punctuation and whitespace are tolerated.\n    \"\"\"\n    boredom_count = 0\n    # Split the string into segments by sentence delimiters.\n    sentence_segments = re.split(r'[.?!]', S)\n\n    # Regex to match optional leading punctuation (quotes, parentheses, brackets, apostrophes)\n    # followed by 'I' as a whole word.\n    i_start_pattern = re.compile(r'^[\\\"\\'\\(\\[\\}]*I\\b')\n\n    for segment in sentence_segments:\n        s_stripped = segment.strip()\n        if not s_stripped:\n            continue\n        if i_start_pattern.match(s_stripped):\n            boredom_count += 1\n\n    return boredom_count"}
