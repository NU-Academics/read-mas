{"task_id": "HumanEval/98", "solution": "def count_upper(s):\n    \"\"\"\n    Count uppercase vowels (A, E, I, O, U) at even indices (0-based) in the given input.\n\n    The function accepts any value for `s` and will convert non-string inputs to str before counting.\n\n    Examples:\n    - count_upper('aBCdEf') -> 1  (only 'E' at index 4)\n    - count_upper('abcdefg') -> 0\n    - count_upper('dBBE') -> 0\n    \"\"\"\n    if not isinstance(s, str):\n        s = str(s)\n\n    vowels = {\"A\", \"E\", \"I\", \"O\", \"U\"}\n    count = 0\n    for i, ch in enumerate(s):\n        if (i & 1) == 0 and ch in vowels:\n            count += 1\n    return count"}
{"task_id": "HumanEval/99", "solution": "import decimal\n\ndef closest_integer(value):\n    '''\n    Returns the closest integer to a numeric value string, rounding ties away from zero.\n    Handles various numeric formats and raises ValueError for invalid inputs.\n    '''\n    s_value = str(value).strip()\n\n    try:\n        d_value = decimal.Decimal(s_value)\n        # Round to nearest integer using ROUND_HALF_UP (ties away from zero).\n        rounded_decimal = d_value.to_integral_value(rounding=decimal.ROUND_HALF_UP)\n        return int(rounded_decimal)\n    except decimal.InvalidOperation as e_decimal:\n        # Attempt fallback to float for extremely large exponents or other Decimal parse failures, as per design.\n        try:\n            f_value = float(s_value)\n\n            # Raise ValueError if float conversion results in infinity.\n            if f_value == float('inf') or f_value == float('-inf'):\n                raise ValueError(f\"Numeric value is too large or too small (infinity): {s_value}\") from e_decimal\n\n            # Round float away from zero for ties.\n            if f_value >= 0:\n                return int(f_value + 0.5)\n            else:\n                return int(f_value - 0.5)\n\n        except (ValueError, TypeError):\n            # If float conversion also fails, the input is an invalid numeric value.\n            raise ValueError(f\"Invalid numeric value: {s_value}\") from e_decimal\n    except (TypeError, ValueError) as e_other:\n        # Catch other direct Decimal() construction errors not covered by InvalidOperation.\n        raise ValueError(f\"Invalid numeric value: {s_value}\") from e_other"}
{"task_id": "HumanEval/101", "solution": "import re\n\ndef words_string(s):\n    \"\"\"\n    Splits a string by commas or whitespace into a list of words.\n    Ignores multiple separators and leading/trailing separators.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"s must be a string\")\n    s_stripped = s.strip()\n    if not s_stripped:\n        return []\n    parts = re.split(r\"[,\\\\s]+\", s_stripped)\n    return [word for word in parts if word]"}
{"task_id": "HumanEval/102", "solution": "import math\n\ndef choose_num(x, y):\n    \"\"\"\n    Returns the largest even integer in the inclusive range [x, y].\n    If no such integer exists or x > y, returns -1.\n    \"\"\"\n    if not isinstance(x, (int, float)) or not isinstance(y, (int, float)):\n        raise TypeError(\"x and y must be numeric (int or float)\")\n    if math.isinf(x) or math.isinf(y) or math.isnan(x) or math.isnan(y):\n        raise ValueError(\"x and y must be finite numbers\")\n    if x > y:\n        return -1\n\n    floor_y_int = math.floor(y)\n    largest_even_in_range = floor_y_int\n    if largest_even_in_range % 2 != 0:\n        largest_even_in_range -= 1\n\n    ceil_x_int = math.ceil(x)\n    smallest_even_in_range = ceil_x_int\n    if smallest_even_in_range % 2 != 0:\n        smallest_even_in_range += 1\n\n    if smallest_even_in_range > largest_even_in_range:\n        return -1\n\n    return int(largest_even_in_range)"}
{"task_id": "HumanEval/102", "solution": "def choose_num(x, y):\n    \"\"\"\n    Return the largest even integer within the inclusive range [x, y].\n    If none exists or inputs are invalid, return -1.\n    \"\"\"\n    import math\n\n    # Validate numeric inputs\n    try:\n        xf = float(x)\n        yf = float(y)\n    except (TypeError, ValueError):\n        return -1\n\n    if math.isnan(xf) or math.isnan(yf) or math.isinf(xf) or math.isinf(yf):\n        return -1\n\n    if xf > yf:\n        return -1\n\n    upper = math.floor(yf)\n    # Adjust to largest even <= upper\n    if upper % 2 != 0:\n        upper -= 1\n\n    lower = math.ceil(xf)\n\n    if upper < lower:\n        return -1\n\n    return int(upper)"}
{"task_id": "HumanEval/104", "solution": "def unique_digits(x):\n    \"\"\"Given a list of positive integers x, return a sorted list of all\n    elements that hasn't any even digit.\n    \"\"\"\n\n    collected_numbers = []\n    for n in x:\n        if not isinstance(n, int):\n            raise TypeError(\"All elements must be integers\")\n        s_n = str(abs(n))\n        if any(d in '02468' for d in s_n):\n            continue\n        collected_numbers.append(n)\n    collected_numbers.sort()\n    return collected_numbers"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"Encodes a message by replacing vowels and swapping case.\n    Vowels are replaced by the letter 2 places ahead in the alphabet, then all letters swap case.\"\"\"\n\n    vowel_map = {\n        'a': 'c', 'e': 'g', 'i': 'k', 'o': 'q', 'u': 'w',\n        'A': 'C', 'E': 'G', 'I': 'K', 'O': 'Q', 'U': 'W'\n    }\n\n    encoded_chars = []\n    for char in message:\n        # First, replace vowels if applicable\n        processed_char = vowel_map.get(char, char)\n\n        # Then, swap the case of the (potentially replaced) character\n        encoded_chars.append(processed_char.swapcase())\n\n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/104", "solution": "def unique_digits(x):\n    \"\"\"Given a list of positive integers x. return a sorted list of all\n    elements that hasn't any even digit.\n    \"\"\"\n    result = []\n    for n in x:\n        s_n = str(abs(n))\n        has_even_digit = False\n        for digit_char in s_n:\n            if int(digit_char) % 2 == 0:\n                has_even_digit = True\n                break\n        if not has_even_digit:\n            result.append(n)\n    result.sort()\n    return result"}
{"task_id": "HumanEval/105", "solution": "def by_length(arr):\n    \"\"\"\n    Filters integers between 1 and 9 from an array, sorts them descending,\n    and maps them to their English word representations.\n    Returns an empty list for None input.\n    \"\"\"\n    if arr is None:\n        return []\n\n    names = [None, \"One\", \"Two\", \"Three\", \"Four\", \"Five\", \"Six\", \"Seven\", \"Eight\", \"Nine\"]\n\n    filtered_numbers = []\n    for x in arr:\n        if isinstance(x, int) and 1 <= x <= 9:\n            filtered_numbers.append(x)\n\n    sorted_desc = sorted(filtered_numbers, reverse=True)\n\n    result = [names[num] for num in sorted_desc]\n\n    return result"}
{"task_id": "HumanEval/103", "solution": "def rounded_avg(n, m):\n    \"\"\"Computes the average of integers from n through m, rounded using banker's rounding,\n    then converts it to a binary string. Returns -1 if n > m.\"\"\"\n    if n > m:\n        return -1\n\n    s = n + m\n    q = s // 2  # q is floor((n+m)/2)\n    r = s % 2   # r is 0 if (n+m) is even, 1 if odd\n\n    if r == 0:\n        rounded = q\n    else:  # The average is x.5, where x = q. Apply tie-to-even.\n        if q % 2 == 0:  # If x is even, round down to x.\n            rounded = q\n        else:  # If x is odd, round up to x + 1.\n            rounded = q + 1\n\n    return bin(rounded)"}
{"task_id": "HumanEval/105", "solution": "def by_length(arr):\n    \"\"\"\n    Filters, sorts, reverses, and maps integers in an array to their English names.\n    Only numbers between 1 and 9 inclusive are processed.\n    \"\"\"\n\n    # Filter integers to those between 1 and 9 inclusive\n    valid_numbers = [num for num in arr if 1 <= num <= 9]\n\n    # Sort the valid numbers in ascending order\n    valid_numbers.sort()\n\n    # Reverse the sorted array\n    valid_numbers.reverse()\n\n    # Map each digit to its corresponding English name\n    digit_names = [\"One\", \"Two\", \"Three\", \"Four\", \"Five\", \"Six\", \"Seven\", \"Eight\", \"Nine\"]\n    result = [digit_names[num - 1] for num in valid_numbers]\n\n    return result"}
{"task_id": "HumanEval/107", "solution": "def even_odd_palindrome(n):\n    \"\"\"\n    Counts even and odd integer palindromes in the range [1, n].\n    Returns a tuple (even_count, odd_count).\n    \"\"\"\n    even_palindromes = 0\n    odd_palindromes = 0\n\n    for i in range(1, n + 1):\n        s = str(i)\n        if s == s[::-1]:  # Check if the number is a palindrome\n            if i % 2 == 0:\n                even_palindromes += 1\n            else:\n                odd_palindromes += 1\n\n    return (even_palindromes, odd_palindromes)"}
{"task_id": "HumanEval/107", "solution": "def even_odd_palindrome(n):\n    \"\"\"\n    Counts even and odd integer palindromes from 1 to n (inclusive).\n    Returns a tuple (count_even, count_odd).\n    \"\"\"\n    def is_palindrome(num):\n        s = str(num)\n        return s == s[::-1]\n\n    even_palindromes = 0\n    odd_palindromes = 0\n\n    for i in range(1, n + 1):\n        if is_palindrome(i):\n            if i % 2 == 0:\n                even_palindromes += 1\n            else:\n                odd_palindromes += 1\n\n    return (even_palindromes, odd_palindromes)"}
{"task_id": "HumanEval/106", "solution": "def f(n):\n    \"\"\"Implement the function f that takes n as a parameter,\n    and returns a list of size n, such that the value of the element at index i is the factorial of i if i is even\n    or the sum of numbers from 1 to i otherwise. i starts from 1.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    result = []\n    fact = 1\n    running_sum = 0\n    for i in range(1, n + 1):\n        fact *= i\n        running_sum += i\n        if i % 2 == 0:\n            result.append(fact)\n        else:\n            result.append(running_sum)\n    return result"}
{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr):\n    \"\"\"Determines if the array can be sorted non-decreasingly by right circular shifts.\n    Returns True if arr is empty or can be rotated to non-decreasing order, else False.\n    \"\"\"\n    if not arr or len(arr) <= 1:\n        return True\n\n    n = len(arr)\n    drops = 0\n    for i in range(n):\n        j = (i + 1) % n\n        if arr[i] > arr[j]:\n            drops += 1\n            if drops > 1:\n                return False\n    return True"}
{"task_id": "HumanEval/108", "solution": "def count_nums(arr):\n    \"\"\"\n    Counts elements where the sum of signed digits is greater than 0.\n    For negative numbers, the most significant digit is considered negative.\n    \"\"\"\n    count = 0\n    for n in arr:\n        digits_str = str(abs(n))\n        s = 0\n        if n < 0:\n            # First digit is negative, subsequent digits are positive\n            s = -int(digits_str[0])\n            if len(digits_str) > 1:\n                s += sum(int(d) for d in digits_str[1:])\n        else:\n            # All digits are positive for non-negative numbers\n            s = sum(int(d) for d in digits_str)\n\n        if s > 0:\n            count += 1\n    return count"}
{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr):\n    \"\"\"We have an array 'arr' of N integers. Determine if it is possible to get\n    the array sorted in non-decreasing order by performing any number of right\n    shift operations (rotations). Return True if possible, else False. If the\n    array is empty, return True.\n    \"\"\"\n    n = len(arr)\n    if n <= 1:\n        return True\n\n    descents = 0\n    for i in range(n):\n        if arr[i] > arr[(i + 1) % n]:\n            descents += 1\n            if descents > 1:\n                return False\n    return True"}
{"task_id": "HumanEval/110", "solution": "def exchange(lst1, lst2):\n    \"\"\"Return \"YES\" if by exchanging elements between lst1 and lst2 it's possible\n    to make all elements of lst1 even, otherwise return \"NO\".\n    \"\"\"\n    even_count = sum(1 for x in lst1 if x % 2 == 0) + sum(1 for x in lst2 if x % 2 == 0)\n    return \"YES\" if even_count >= len(lst1) else \"NO\""}
{"task_id": "HumanEval/108", "solution": "def count_nums(arr):\n    \"\"\"\n    Counts numbers in an array where the sum of their signed digits is positive.\n    For negative numbers, the first digit after the sign is treated as negative.\n    \"\"\"\n    count = 0\n    for num in arr:\n        digit_sum = 0\n        s_num = str(num)\n\n        if num < 0:\n            # The first digit after the sign is negative; subsequent digits are positive.\n            digit_sum -= int(s_num[1])\n            for digit_char in s_num[2:]:\n                digit_sum += int(digit_char)\n        else:\n            # For non-negative numbers, all digits are positive.\n            for digit_char in s_num:\n                digit_sum += int(digit_char)\n\n        if digit_sum > 0:\n            count += 1\n    return count"}
{"task_id": "HumanEval/110", "solution": "def exchange(lst1, lst2):\n    \"\"\"In this problem, you will implement a function that takes two lists of numbers,\n    and determines whether it is possible to perform an exchange of elements\n    between them to make lst1 a list of only even numbers.\n    There is no limit on the number of exchanged elements between lst1 and lst2.\n    If it is possible to exchange elements between the lst1 and lst2 to make\n    all the elements of lst1 to be even, return \"YES\".\n    Otherwise, return \"NO\".\n    It is assumed that the input lists will be non-empty.\n    \"\"\"\n    total_even = sum(1 for x in lst1 if x % 2 == 0) + sum(1 for x in lst2 if x % 2 == 0)\n    return \"YES\" if total_even >= len(lst1) else \"NO\""}
{"task_id": "HumanEval/112", "solution": "def reverse_delete(s, c):\n    \"\"\"Deletes characters from s found in c, then checks if the resulting string is a palindrome.\"\"\"\n    result_chars = []\n    for char_s in s:\n        if char_s not in c:\n            result_chars.append(char_s)\n\n    result_string = \"\".join(result_chars)\n\n    is_palindrome = (result_string == result_string[::-1])\n\n    return (result_string, is_palindrome)"}
{"task_id": "HumanEval/113", "solution": "def odd_count(lst):\n    \"\"\"Given a list of strings (each string consists only of digits), return a list\n    where each element is the template string with every lowercase 'i' replaced\n    by the count of odd digits in the corresponding input string.\n    \"\"\"\n    template = \"the number of odd elements in the string i of the input.\"\n    result = []\n    for s in lst:\n        count = sum(1 for ch in s if ch in \"13579\")\n        result.append(template.replace(\"i\", str(count)))\n    return result"}
{"task_id": "HumanEval/112", "solution": "def reverse_delete(s,c):\n    \"\"\"Deletes characters from s found in c, then checks if the resulting string is a palindrome.\n    Returns a tuple containing the modified string and a boolean indicating if it's a palindrome.\n    \"\"\"\n    result_chars = []\n    for char_s in s:\n        if char_s not in c:\n            result_chars.append(char_s)\n\n    result_string = \"\".join(result_chars)\n    is_palindrome = (result_string == result_string[::-1])\n\n    return (result_string, is_palindrome)"}
{"task_id": "HumanEval/111", "solution": "from collections import Counter\n\ndef histogram(test):\n    \"\"\"Given a string representing a space separated lowercase letters, return a dictionary\n    of the letter with the most repetition and containing the corresponding count.\n    If several letters have the same occurrence, return all of them.\n    \"\"\"\n    tokens = test.split()\n\n    if not tokens:\n        return {}\n\n    counts = Counter(tokens)\n    max_count = max(counts.values())\n\n    return {token: cnt for token, cnt in counts.items() if cnt == max_count}"}
{"task_id": "HumanEval/113", "solution": "def odd_count(lst):\n    \"\"\"Counts odd digits in each string and formats output.\n    Each output string describes the count of odd digits found.\n    \"\"\"\n    result = []\n    for s in lst:\n        odd_digit_count = 0\n        for char_digit in s:\n            if int(char_digit) % 2 != 0:\n                odd_digit_count += 1\n\n        output_string = f\"the number of odd elements {odd_digit_count}n the str{odd_digit_count}ng {odd_digit_count} of the {odd_digit_count}nput.\"\n        result.append(output_string)\n    return result"}
{"task_id": "HumanEval/111", "solution": "def histogram(test):\n    \"\"\"Counts letter occurrences and returns letters with the highest frequency.\n    If multiple letters share the max frequency, all are included.\"\"\"\n    if not test:\n        return {}\n\n    counts = {}\n    # Split the string by spaces and count each non-empty letter.\n    for letter in test.split(' '):\n        if letter:\n            counts[letter] = counts.get(letter, 0) + 1\n\n    if not counts:\n        return {}\n\n    max_count = 0\n    # Find the maximum count among all letters.\n    for count in counts.values():\n        if count > max_count:\n            max_count = count\n\n    result = {}\n    # Collect all letters that have the maximum count.\n    for letter, count in counts.items():\n        if count == max_count:\n            result[letter] = count\n\n    return result"}
{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums):\n    \"\"\"\n    Finds the minimum sum of any non-empty sub-array in the given list of integers.\n    It applies a variation of Kadane's algorithm for minimum subarray sum.\n    \"\"\"\n    min_so_far = nums[0]\n    current_min = nums[0]\n\n    for i in range(1, len(nums)):\n        current_min = min(nums[i], current_min + nums[i])\n        min_so_far = min(min_so_far, current_min)\n\n    return min_so_far"}
{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums):\n    \"\"\"\n    Finds the minimum sum of any non-empty sub-array using a variant of Kadane's algorithm.\n    It tracks the minimum sum ending at the current position and the overall minimum sum found.\n    \"\"\"\n    min_so_far = float('inf')\n    current_min = 0\n\n    for num in nums:\n        current_min += num\n        min_so_far = min(min_so_far, current_min)\n        if current_min > 0:\n            current_min = 0\n\n    return min_so_far"}
{"task_id": "HumanEval/115", "solution": "def max_fill(grid, capacity):\n    \"\"\"\n    Calculate the number of times buckets must be lowered to empty all wells.\n\n    Each row in `grid` represents a well; each 1 is a unit of water. Each well\n    has its own bucket of the same `capacity`. For each well, the number of\n    lowers required is ceil(total_water_in_row / capacity). Return the sum\n    across all wells.\n\n    Args:\n        grid (list[list[int]]): Rectangular grid of 0/1 values.\n        capacity (int): Capacity of each bucket (>= 1).\n\n    Returns:\n        int: Total number of times buckets must be lowered.\n    \"\"\"\n    if capacity <= 0:\n        raise ValueError(\"capacity must be >= 1\")\n\n    total_lowers = 0\n    for row in grid:\n        # Count water units in the well (treat truthy values as water)\n        water_units = 0\n        for cell in row:\n            if cell:\n                water_units += 1\n\n        if water_units:\n            # ceil division without importing math\n            lowers_for_well = (water_units + capacity - 1) // capacity\n            total_lowers += lowers_for_well\n\n    return total_lowers"}
{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"\n    Returns a list of words from string s that contain exactly n consonants.\n    Words are returned in their original order.\n    \"\"\"\n    vowels = {'a', 'e', 'i', 'o', 'u'}\n    result = []\n\n    words = s.split()\n\n    for word in words:\n        consonant_count = 0\n        for char in word:\n            # Assumes 'char' is a letter as per problem statement\n            if char.lower() not in vowels:\n                consonant_count += 1\n\n        if consonant_count == n:\n            result.append(word)\n\n    return result"}
{"task_id": "HumanEval/115", "solution": "def max_fill(grid, capacity):\n    \"\"\"Calculates the total bucket lowers needed to empty all wells in a grid.\n    Each 1 in a row is a unit of water; buckets have a shared capacity.\n    \"\"\"\n    if not isinstance(capacity, int) or capacity <= 0:\n        raise ValueError(\"capacity must be a positive integer\")\n\n    total_lowers = 0\n\n    for row in grid:\n        if not hasattr(row, \"__iter__\"):\n            raise ValueError(\"each row in grid must be an iterable of 0/1 values\")\n        # Validate and count units (ensure values are 0 or 1)\n        units_of_water = 0\n        for cell in row:\n            if cell not in (0, 1):\n                raise ValueError(\"grid cells must be 0 or 1\")\n            units_of_water += cell\n\n        if units_of_water > 0:\n            lowers_for_well = (units_of_water + capacity - 1) // capacity\n            total_lowers += lowers_for_well\n\n    return total_lowers"}
