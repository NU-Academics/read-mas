{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    \"\"\"\n    Checks if two parenthesis strings can be concatenated to form a balanced string.\n    Returns 'Yes' if possible, 'No' otherwise.\n    \"\"\"\n    s1 = lst[0]\n    s2 = lst[1]\n\n    # Check the concatenation s1 + s2\n    combined_s12 = s1 + s2\n    balance_s12 = 0\n    is_balanced_s12 = True\n    for char in combined_s12:\n        if char == '(':\n            balance_s12 += 1\n        else:\n            balance_s12 -= 1\n        if balance_s12 < 0:\n            is_balanced_s12 = False\n            break\n    if is_balanced_s12 and balance_s12 == 0:\n        return 'Yes'\n\n    # Check the concatenation s2 + s1\n    combined_s21 = s2 + s1\n    balance_s21 = 0\n    is_balanced_s21 = True\n    for char in combined_s21:\n        if char == '(':\n            balance_s21 += 1\n        else:\n            balance_s21 -= 1\n        if balance_s21 < 0:\n            is_balanced_s21 = False\n            break\n    if is_balanced_s21 and balance_s21 == 0:\n        return 'Yes'\n\n    return 'No'"}
{"task_id": "HumanEval/116", "solution": "def sort_array(arr):\n    \"\"\"Sorts an array of integers by bit count for non-negatives and numerically for negatives.\n    Negatives come first, followed by non-negatives.\n    \"\"\"\n    if not isinstance(arr, (list, tuple)):\n        raise TypeError(\"arr must be a list or tuple of integers\")\n\n    arr_list = list(arr)\n\n    if any(not isinstance(x, int) for x in arr_list):\n        raise TypeError(\"all elements of arr must be integers\")\n\n    def count_ones(n: int) -> int:\n        # n is non-negative when this is used\n        if hasattr(int, \"bit_count\"):\n            return n.bit_count()\n        return bin(n).count(\"1\")\n\n    negatives = [x for x in arr_list if x < 0]\n    nonnegatives = [x for x in arr_list if x >= 0]\n\n    negatives_sorted = sorted(negatives)\n    nonnegatives_sorted = sorted(nonnegatives, key=lambda x: (count_ones(x), x))\n\n    return negatives_sorted + nonnegatives_sorted"}
{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    \"\"\"\n    Checks if concatenating two strings in any order results in a balanced parentheses string.\n    Returns 'Yes' if balanced, 'No' otherwise.\n    \"\"\"\n    def is_valid(s):\n        \"\"\"Checks if a given string of parentheses is balanced.\"\"\"\n        count = 0\n        for char in s:\n            if char == '(':\n                count += 1\n            else:\n                count -= 1\n            if count < 0:\n                return False\n        return count == 0\n\n    s1, s2 = lst[0], lst[1]\n\n    # Check the first order of concatenation\n    if is_valid(s1 + s2):\n        return 'Yes'\n\n    # Check the second order of concatenation\n    if is_valid(s2 + s1):\n        return 'Yes'\n\n    return 'No'"}
