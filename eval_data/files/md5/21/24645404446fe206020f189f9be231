{"task_id": "Mbpp/801", "solution": "def test_three_equal(num1, num2, num3):\n    \"\"\"\n    Counts the number of equal integers among three given inputs.\n    Returns 3 if all are identical, 2 if exactly two are identical, or 0 if none are.\n    \"\"\"\n    if num1 == num2 == num3:\n        return 3\n    elif num1 == num2 or num1 == num3 or num2 == num3:\n        return 2\n    else:\n        return 0"}
{"task_id": "Mbpp/803", "solution": "import math\ndef is_perfect_square(number: int) -> bool:\n    \"\"\"Checks if the given integer is a perfect square.\"\"\"\n    if number < 0:\n        return False\n    if number == 0:\n        return True\n    \n    # Calculate the integer square root\n    root = int(math.isqrt(number)) # Using math.isqrt for integer square root\n    \n    # Check if squaring the integer root gives the original number\n    return root * root == number"}
{"task_id": "Mbpp/804", "solution": "from typing import List\nclass Number:\n    \"\"\"Encapsulates an integer value and provides a method to check its evenness.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def is_even(self) -> bool:\n        \"\"\"Returns True if the number is even, False otherwise.\"\"\"\n        return self._value % 2 == 0\nclass NumberList:\n    \"\"\"Manages a collection of Number objects and provides methods to query properties.\"\"\"\n    def __init__(self, numbers: List[int]):\n        self._numbers = [Number(num) for num in numbers]\n\n    def is_empty(self) -> bool:\n        \"\"\"Returns True if the list is empty, False otherwise.\"\"\"\n        return not self._numbers\n\n    def has_even_number(self) -> bool:\n        \"\"\"Returns True if any number in the list is even, False otherwise.\"\"\"\n        for num in self._numbers:\n            if num.is_even():\n                return True\n        return False\nclass ProductEvennessService:\n    \"\"\"Provides the core business logic to determine if the product of numbers is even.\"\"\"\n    def check(self, number_list: NumberList) -> bool:\n        \"\"\"Determines product evenness based on the NumberList's properties.\"\"\"\n        if number_list.is_empty():\n            return False  # An empty list's product is 1, which is odd.\n        return number_list.has_even_number() # Product is even if any number is even.\ndef is_product_even(numbers: List[int]) -> bool:\n    \"\"\"\n    Checks whether the product of numbers in a list is even or not.\n    Returns True if the product is even, False otherwise.\n    \"\"\"\n    number_list = NumberList(numbers)\n    service = ProductEvennessService()\n    return service.check(number_list)"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string: str) -> int:\n    \"\"\"\n    Finds the maximum run of uppercase characters in the given string.\n    Calculates the maximum length of a contiguous sequence of uppercase characters.\n    \"\"\"\n    current_run = 0\n    max_run = 0\n\n    for char in input_string:\n        if char.isupper():\n            current_run += 1\n        else:\n            max_run = max(max_run, current_run)\n            current_run = 0\n\n    # Final check for a trailing run of uppercase characters\n    max_run = max(max_run, current_run)\n\n    return max_run"}
{"task_id": "Mbpp/805", "solution": "from typing import List\ndef max_sum_list(list_of_lists: List[List[int]]) -> List[int]:\n    \"\"\"\n    Finds the inner list within a list of lists whose sum of elements is the highest.\n    Returns an empty list if the input is empty or contains only empty lists.\n    \"\"\"\n    if not list_of_lists:\n        return []\n\n    max_current_sum = float('-inf')\n    result_list = []\n\n    for inner_list in list_of_lists:\n        current_sum = sum(inner_list)\n        if current_sum > max_current_sum:\n            max_current_sum = current_sum\n            result_list = inner_list\n            \n    return result_list"}
{"task_id": "Mbpp/808", "solution": "from typing import Any, Tuple\ndef check_K(input_tuple: Tuple[Any, ...], k: Any) -> bool:\n    \"\"\"\n    Checks if a given element 'k' is present within the input_tuple.\n\n    Returns True if 'k' is found in input_tuple, False otherwise.\n    \"\"\"\n    return k in input_tuple"}
{"task_id": "Mbpp/807", "solution": "def first_odd(numbers: list) -> int | None:\n    \"\"\"\n    Finds the first odd number in a list of numbers.\n    Returns None if no odd number is found or the list is empty.\n    \"\"\"\n    for number in numbers:\n        if number % 2 != 0:\n            return number\n    return None"}
{"task_id": "Mbpp/809", "solution": "def check_smaller(tuple1: tuple, tuple2: tuple) -> bool:\n    \"\"\"\n    Checks if each element of tuple2 is strictly smaller than its corresponding\n    element in tuple1.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        return False\n\n    for i in range(len(tuple1)):\n        if not (tuple2[i] < tuple1[i]):\n            return False\n    return True"}
