{"task_id": "Mbpp/614", "solution": "def cummulative_sum(tuple_list: list[tuple]) -> int:\n    \"\"\"\n    Calculates the cumulative sum of all numeric values present in the given tuple list.\n    \"\"\"\n    total_sum = 0\n    for tpl in tuple_list:\n        for item in tpl:\n            total_sum += item\n    return total_sum"}
{"task_id": "Mbpp/615", "solution": "def average_tuple(data: tuple[tuple[float | int, ...], ...]) -> list[float]:\n    \"\"\"Calculates the average value for each inner tuple in a given tuple of tuples.\n\n    Returns a list containing the average of the numerical values for each inner tuple.\n    \"\"\"\n    averages = []\n    for inner_tuple in data:\n        if len(inner_tuple) == 0:\n            averages.append(0.0)\n        else:\n            averages.append(sum(inner_tuple) / len(inner_tuple))\n    return averages"}
{"task_id": "Mbpp/616", "solution": "def tuple_modulo(tuple1: tuple[int], tuple2: tuple[int]) -> tuple[int]:\n    \"\"\"\n    Performs element-wise modulo on two input tuples of identical length.\n    Raises ValueError if lengths differ, ZeroDivisionError if any divisor is zero.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Input tuples must have identical lengths\")\n\n    result = []\n    for i in range(len(tuple1)):\n        dividend = tuple1[i]\n        divisor = tuple2[i]\n        if divisor == 0:\n            raise ZeroDivisionError(\"Modulo by zero is not allowed\")\n        result.append(dividend % divisor)\n\n    return tuple(result)"}
{"task_id": "Mbpp/618", "solution": "class ListLengthMismatchError(Exception):\n    \"\"\"Custom exception for when input lists have different lengths.\"\"\"\n    def __init__(self, message=\"Input lists must have the same length.\"):\n        self.message = message\n        super().__init__(self.message)\nclass NonNumericalInputError(Exception):\n    \"\"\"Custom exception for when input lists contain non-numerical elements.\"\"\"\n    def __init__(self, message=\"Input lists must contain only numerical values.\"):\n        self.message = message\n        super().__init__(self.message)\ndef div_list(list1, list2):\n    \"\"\"\n    Performs element-wise division of two numerical lists.\n    Raises custom exceptions for validation failures.\n    \"\"\"\n    if not isinstance(list1, list) or not isinstance(list2, list):\n        raise TypeError(\"Inputs must be two lists\")\n\n    if len(list1) != len(list2):\n        raise ListLengthMismatchError()\n\n    results = []\n    for i in range(len(list1)):\n        num1 = list1[i]\n        num2 = list2[i]\n\n        if not isinstance(num1, (int, float)) or not isinstance(num2, (int, float)):\n            raise NonNumericalInputError()\n\n        if num2 == 0:\n            raise ZeroDivisionError(\"Cannot divide by zero\")\n\n        results.append(float(num1 / num2))\n    return results"}
{"task_id": "Mbpp/619", "solution": "def move_num(input_string: str) -> str:\n    \"\"\"\n    Moves all digit characters to the end of the given string.\n    Preserves the relative order of non-digit characters and digit characters.\n    \"\"\"\n    non_digits_chars = []\n    digit_chars = []\n\n    for char in input_string:\n        if char.isdigit():\n            digit_chars.append(char)\n        else:\n            non_digits_chars.append(char)\n\n    return ''.join(non_digits_chars) + ''.join(digit_chars)"}
{"task_id": "Mbpp/620", "solution": "def largest_subset(numbers: list[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset of the input list where every pair is divisible.\n    Uses dynamic programming after sorting the input numbers.\n    \"\"\"\n    if not numbers:\n        return 0\n\n    # Sort the numbers to ensure that if a % b == 0, then b appears before a.\n    # This simplifies the DP state transition.\n    numbers.sort()\n    n = len(numbers)\n\n    # dp[i] will store the size of the largest divisible subset ending with numbers[i]\n    dp = [1] * n\n\n    for i in range(n):\n        for j in range(i):\n            # Check if numbers[i] is divisible by numbers[j]\n            # Since numbers is sorted, we only need to check numbers[i] % numbers[j]\n            if numbers[i] % numbers[j] == 0:\n                dp[i] = max(dp[i], 1 + dp[j])\n\n    return max(dp)"}
{"task_id": "Mbpp/622", "solution": "def get_median(list1: list[float], list2: list[float], size: int) -> float:\n    # This function finds the median of two sorted lists of the same size.\n    # It uses a two-pointer approach to find the two middle elements of the conceptually merged list.\n    i = 0\n    j = 0\n    m1 = -1.0 # (size-1)-th element\n    m2 = -1.0 # size-th element\n\n    # Iterate size + 1 times to find the two middle elements (0-indexed: size-1 and size).\n    for count in range(size + 1):\n        m1 = m2\n        if i < size and j < size:\n            if list1[i] <= list2[j]:\n                m2 = float(list1[i])\n                i += 1\n            else:\n                m2 = float(list2[j])\n                j += 1\n        elif i < size: # list2 is exhausted\n            m2 = float(list1[i])\n            i += 1\n        else: # list1 is exhausted\n            m2 = float(list2[j])\n            j += 1\n\n    return (m1 + m2) / 2.0"}
