{"task_id": "Mbpp/572", "solution": "import collections\ndef two_unique_nums(numbers: list[int]) -> list[int]:\n    \"\"\"\n    Identifies and returns numbers that appear exactly once in an input list, \n    preserving their original order of first appearance.\n    \"\"\"\n    counts = collections.Counter(numbers)\n    unique_numbers_list = []\n    for num in numbers:\n        if counts[num] == 1:\n            unique_numbers_list.append(num)\n    return unique_numbers_list"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n: int) -> int:\n    \"\"\"\n    Calculates the last digit of the factorial of a given non-negative integer.\n    Handles special cases for 0!, and n! for n >= 5.\n    \"\"\"\n    if n == 0:\n        return 1\n    if n >= 5:\n        return 0\n\n    if n == 1:\n        return 1\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 6\n    elif n == 4:\n        return 4"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(list1: list, list2: list, list3: list) -> list:\n    \"\"\"\n    Interleaves three lists of the same length into a single flat list.\n\n    Args:\n        list1 (list): The first input list.\n        list2 (list): The second input list.\n        list3 (list): The third input list.\n\n    Returns:\n        list: A new list with elements interleaved from the three input lists.\n\n    Raises:\n        ValueError: If the input lists do not have the same length.\n    \"\"\"\n    if not (len(list1) == len(list2) == len(list3)):\n        raise ValueError(\"All input lists must have the same length.\")\n\n    interleaved_result = []\n    for i in range(len(list1)):\n        interleaved_result.append(list1[i])\n        interleaved_result.append(list2[i])\n        interleaved_result.append(list3[i])\n\n    return interleaved_result"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Identifies and returns elements that are present in one input tuple\n    but not in the other.\n    \"\"\"\n    set1 = set(tuple1)\n    set2 = set(tuple2)\n    dissimilar_elements = (set1 - set2) | (set2 - set1)\n    return tuple(sorted(list(dissimilar_elements)))"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"Recursively extracts even integers from a nested tuple, preserving its structure.\"\"\"\n    result = []\n    for item in input_tuple:\n        if isinstance(item, tuple):\n            processed_nested = extract_even(item)\n            if processed_nested: # Only add non-empty nested tuples\n                result.append(processed_nested)\n        elif isinstance(item, int):\n            if item % 2 == 0:\n                result.append(item)\n    return tuple(result)"}
{"task_id": "Mbpp/581", "solution": "import math\ndef surface_Area(base_edge, height):\n    \"\"\"\n    Calculates the total surface area of a square pyramid.\n    It takes the base edge and height as input.\n    \"\"\"\n    half_base_edge = base_edge / 2\n    slant_height = math.sqrt((half_base_edge ** 2) + (height ** 2))\n    base_area = base_edge ** 2\n    lateral_area = 2 * base_edge * slant_height\n    total_surface_area = base_area + lateral_area\n    return total_surface_area"}
{"task_id": "Mbpp/585", "solution": "def expensive_items(items: list[dict], n: int) -> list[dict]:\n    \"\"\"\n    Finds the 'n' most expensive items in a given dataset.\n    Returns a list of dictionaries representing the 'n' most expensive items,\n    sorted by 'price' in descending order.\n    \"\"\"\n    # Input validation as per design context\n    if not isinstance(items, list):\n        raise TypeError(\"'items' must be a list.\")\n    if not isinstance(n, int):\n        raise TypeError(\"'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"'n' cannot be negative.\")\n\n    for item in items:\n        if not isinstance(item, dict):\n            raise ValueError(\"Each item in 'items' must be a dictionary.\")\n        if 'price' not in item:\n            raise ValueError(\"Each item dictionary must contain a 'price' attribute.\")\n        if not isinstance(item['price'], (int, float)):\n            raise ValueError(\"The 'price' attribute must be a numerical value.\")\n\n    # Sort items by 'price' in descending order\n    sorted_items = sorted(items, key=lambda x: x['price'], reverse=True)\n\n    # Select the top 'n' items\n    return sorted_items[:n]"}
{"task_id": "Mbpp/583", "solution": "def catalan_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Catalan number using dynamic programming.\n    The formula used is C_0 = 1, C_{n+1} = sum_{i=0 to n} (C_i * C_{n-i}).\n    \"\"\"\n    if n == 0:\n        return 1\n\n    catalan = [0] * (n + 1)\n    catalan[0] = 1\n\n    for i in range(1, n + 1):\n        for j in range(i):\n            catalan[i] += catalan[j] * catalan[i - 1 - j]\n            \n    return catalan[n]"}
{"task_id": "Mbpp/586", "solution": "def split_Arr(list_arg: list, n_arg: int) -> list:\n    \"\"\"\n    Splits a list at the nth element and adds the first part to the end.\n    Returns a new list with the second part followed by the first part.\n    \"\"\"\n    first_sub_list = list_arg[:n_arg]\n    second_sub_list = list_arg[n_arg:]\n\n    reordered_list = second_sub_list + first_sub_list\n    return reordered_list"}
