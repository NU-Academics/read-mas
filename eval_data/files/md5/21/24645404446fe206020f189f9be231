{"task_id": "Mbpp/244", "solution": "import math\ndef next_Perfect_Square(number: int) -> int:\n    \"\"\"\n    Calculates the smallest perfect square strictly greater than the given number.\n    It raises a TypeError if the input is not an integer.\n    \"\"\"\n    if not isinstance(number, int):\n        raise TypeError(\"Input 'number' must be an integer.\")\n\n    # Find the square root of the number. For non-negative numbers,\n    # the next perfect square's root will be floor(sqrt(number)) + 1.\n    # For negative numbers, 0 is not a perfect square in this context,\n    # so we'll start from 1.\n    if number < 0:\n        next_root = 1\n    else:\n        # Calculate the integer part of the square root\n        root = int(math.sqrt(number))\n        # The next integer root is one more than this\n        next_root = root + 1\n    \n    # Square the next_root to get the next perfect square\n    return next_root * next_root"}
{"task_id": "Mbpp/245", "solution": "def _calculate_lis_sums(arr: list[int]) -> list[int]:\n    \"\"\"\n    Computes the maximum sum of an increasing subsequence ending at each position.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return []\n\n    lis_sums = list(arr)\n    for i in range(1, n):\n        for j in range(i):\n            if arr[i] > arr[j]:\n                lis_sums[i] = max(lis_sums[i], lis_sums[j] + arr[i])\n    return lis_sums\ndef _calculate_lds_sums(arr: list[int]) -> list[int]:\n    \"\"\"\n    Computes the maximum sum of a decreasing subsequence starting at each position.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return []\n\n    lds_sums = list(arr)\n    for i in range(n - 2, -1, -1):\n        for j in range(n - 1, i, -1):\n            if arr[i] > arr[j]:\n                lds_sums[i] = max(lds_sums[i], lds_sums[j] + arr[i])\n    return lds_sums\ndef max_sum(arr: list[int]) -> int:\n    \"\"\"\n    Finds the maximum sum of a bitonic subsequence in the given array.\n    A bitonic sequence is first increasing and then decreasing.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return 0\n    if n == 1:\n        return arr[0]\n\n    lis_sums = _calculate_lis_sums(arr)\n    lds_sums = _calculate_lds_sums(arr)\n\n    max_bitonic_sum = 0\n    for i in range(n):\n        # Subtract arr[i] because it's counted in both LIS ending at i and LDS starting at i\n        current_bitonic_sum = lis_sums[i] + lds_sums[i] - arr[i]\n        if current_bitonic_sum > max_bitonic_sum:\n            max_bitonic_sum = current_bitonic_sum\n\n    return max_bitonic_sum"}
{"task_id": "Mbpp/247", "solution": "def lps(input_string: str) -> int:\n    \"\"\"\n    Calculates the length of the longest palindromic subsequence for the given string.\n    Uses dynamic programming to build up the solution from smaller subproblems.\n    \"\"\"\n    n = len(input_string)\n    # Create a table to store results of subproblems\n    dp = [[0 for _ in range(n)] for _ in range(n)]\n\n    # Strings of length 1 have LPS length 1\n    for i in range(n):\n        dp[i][i] = 1\n\n    # Consider subsequences of length from 2 to n\n    for cl in range(2, n + 1):\n        for i in range(n - cl + 1):\n            j = i + cl - 1\n            if input_string[i] == input_string[j] and cl == 2:\n                dp[i][j] = 2\n            elif input_string[i] == input_string[j]:\n                dp[i][j] = 2 + dp[i + 1][j - 1]\n            else:\n                dp[i][j] = max(dp[i][j - 1], dp[i + 1][j])\n\n    return dp[0][n - 1]"}
