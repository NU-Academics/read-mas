{"task_id": "Mbpp/440", "solution": "import re\ndef find_adverb_position(sentence: str) -> tuple[int, int, str] | None:\n    \"\"\"\n    Finds the first adverb (ending in '-ly') and its positions in a sentence.\n    Returns (start_index, end_index, cleaned_adverb) or None if not found.\n    \"\"\"\n    # Use regex to find words that end in '-ly', including any trailing punctuation.\n    # r'\\b' ensures whole word matching.\n    # r'([a-zA-Z]+ly)\\S*' matches 'wordly' followed by any non-whitespace characters\n    # 're.IGNORECASE' for case-insensitive matching of '-ly'\n    for match in re.finditer(r'\\b([a-zA-Z]+ly)\\S*', sentence, re.IGNORECASE):\n        full_word_with_punct = match.group(0)\n        potential_adverb_root = match.group(1) # This group captures the part before punctuation\n\n        # Check if the word truly ends with 'ly' (case-insensitive)\n        # and has at least one letter before 'ly'\n        if potential_adverb_root.lower().endswith('ly') and len(potential_adverb_root) > 2:\n            start_index = match.start()\n            \n            # Clean the adverb by removing trailing punctuation\n            cleaned_adverb = potential_adverb_root\n            \n            # The end_index should be after the last character of the cleaned adverb in the original string.\n            end_index = start_index + len(cleaned_adverb)\n            \n            return (start_index, end_index, cleaned_adverb)\n            \n    return None"}
