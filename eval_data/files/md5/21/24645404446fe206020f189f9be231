{"task_id": "Mbpp/166", "solution": "import itertools\nfrom typing import List, Tuple\ndef _is_even(number: int) -> bool:\n    \"\"\"Determines if an integer is even.\"\"\"\n    return number % 2 == 0\ndef _get_unique_pairs(numbers: List[int]) -> List[Tuple[int, int]]:\n    \"\"\"\n    Identifies all unique combinations of two distinct integers from the input list.\n    \"\"\"\n    return list(itertools.combinations(numbers, 2))\ndef find_even_pair(numbers: List[int]) -> int:\n    \"\"\"\n    Counts the number of pairs of integers in a list that XOR to an even number.\n    \"\"\"\n    even_xor_count = 0\n\n    unique_pairs = _get_unique_pairs(numbers)\n\n    for pair in unique_pairs:\n        num1, num2 = pair\n        xor_result = num1 ^ num2\n\n        if _is_even(xor_result):\n            even_xor_count += 1\n\n    return even_xor_count"}
