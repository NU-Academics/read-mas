{"task_id": "Mbpp/123", "solution": "def _calculate_sum_of_proper_divisors(n: int) -> int:\n    \"\"\"Calculates the sum of proper divisors for a given integer n.\"\"\"\n    if n <= 1:\n        return 0\n    divisors_sum = 1\n    for i in range(2, int(n**0.5) + 1):\n        if n % i == 0:\n            divisors_sum += i\n            if i * i != n:\n                divisors_sum += n // i\n    return divisors_sum\ndef amicable_numbers_sum(upper_limit: int) -> int:\n    \"\"\"Calculates the sum of all unique amicable numbers from 1 up to (but not including) the specified upper_limit.\"\"\"\n    if upper_limit <= 1:\n        return 0\n\n    amicable_set = set()\n\n    for a in range(1, upper_limit):\n        sum_div_a = _calculate_sum_of_proper_divisors(a)\n\n        if sum_div_a > a and sum_div_a < upper_limit:\n            sum_div_b = _calculate_sum_of_proper_divisors(sum_div_a)\n\n            if sum_div_b == a:\n                amicable_set.add(a)\n                amicable_set.add(sum_div_a)\n\n    return sum(amicable_set)"}
{"task_id": "Mbpp/125", "solution": "def find_length(binary_string: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of '0's and '1's in any substring\n    of the given binary string using a Kadane's algorithm variant.\n    \"\"\"\n\n    def _validate_binary_string(s: str) -> None:\n        \"\"\"Raises ValueError if string contains characters other than '0' or '1'.\"\"\"\n        if not all(c in '01' for c in s):\n            raise ValueError(\"Input string must contain only '0's and '1's.\")\n\n    def _calculate_max_diff_kadane(s: str) -> int:\n        \"\"\"\n        Calculates the maximum sum of a contiguous subarray after transforming '0's to 1 and '1's to -1.\n        This represents the maximum difference (0s - 1s).\n        \"\"\"\n        if not s:\n            return 0\n\n        # Transform the binary string: '0' -> 1, '1' -> -1\n        transformed_array = [1 if char == '0' else -1 for char in s]\n\n        max_so_far = 0\n        current_max = 0\n        has_positive_diff = False\n\n        for x in transformed_array:\n            current_max += x\n            if current_max < 0:\n                current_max = 0\n            if current_max > max_so_far:\n                max_so_far = current_max\n            if x == 1: # check if there's at least one '0' (which contributes +1)\n                has_positive_diff = True\n        \n        # If the string contains only '1's, the max_so_far will be 0.\n        # However, the problem asks for the maximum difference, which could be 0 if only '1's exist.\n        # But if the input is \"111\", the max diff is 0 (0 zeros, 3 ones -> -3; max is 0).\n        # If the input is \"101\", the substring \"0\" gives 1.\n        # If all characters are '1', then transformed_array contains only -1. Kadane will return 0.\n        # If all characters are '0', transformed_array contains only 1. Kadane will return length.\n        \n        # The edge case where all elements are negative and max_so_far remains 0 but should be the\n        # maximum single element (i.e. -1 for all 1s).\n        # However, for this problem, the difference is (count of 0s - count of 1s).\n        # A substring with only '1's (e.g., \"1\") has difference -1. The problem asks for MAX difference,\n        # so if all substrings result in negative differences, the max difference should be 0 (empty substring).\n        # An empty substring has 0 zeros and 0 ones, so difference is 0.\n        # Kadane's naturally handles this by returning 0 if all sums are negative.\n        # The question implies 'length' as a non-negative value, so max(0, actual_max_diff).\n        # If there are '0's in the string at all, max_so_far will correctly represent the max positive difference.\n        # If the string contains ONLY '1's, then all transformed values are -1. \n        # current_max will go negative, reset to 0. max_so_far will remain 0. This is correct as \n        # the max difference for \"111\" is 0 (an empty substring has 0 difference).\n        # The problem is looking for (count of 0s - count of 1s), which can be negative.\n        # But the example \"11000010001\" == 6 implies we want max(0s-1s, 0).\n        # The original Kadane's returns max(0, subarray_sum)\n        # However, if 'has_positive_diff' is False, meaning no '0' was encountered, then max_so_far should be 0.\n        # If there's at least one '0', then max_so_far > 0 if there's a good substring.\n        \n        # The phrasing \"maximum difference between the number of 0s and number of 1s\"\n        # implies max(0s - 1s).\n        # If a string is \"111\", 0s=0, 1s=3, diff = -3. Max diff over all substrings is 0.\n        # If a string is \"000\", 0s=3, 1s=0, diff = 3. Max diff over all substrings is 3.\n        # If a string is \"101\", substring \"0\" -> 0s=1, 1s=0, diff=1.\n        # If a string is \"11000\", substring \"000\" -> 0s=3, 1s=0, diff=3.\n        # This confirms max(0, calculated_kadane_sum).\n        \n        return max_so_far # Kadane's as implemented correctly gives max(0, max_subarray_sum)\n\n    _validate_binary_string(binary_string)\n\n    if not binary_string:\n        return 0\n\n    return _calculate_max_diff_kadane(binary_string)"}
{"task_id": "Mbpp/126", "solution": "def _get_divisors(number: int) -> list[int]:\n    \"\"\"\n    Identifies all positive divisors for a given number.\n    Satisfies FR2, FR3, BR1.\n    \"\"\"\n    if not isinstance(number, int) or number <= 0:\n        raise ValueError(\"Input number must be a positive integer.\")\n    divs = []\n    for i in range(1, int(number**0.5) + 1):\n        if number % i == 0:\n            divs.append(i)\n            if i * i != number:\n                divs.append(number // i)\n    return sorted(divs)\n\ndef _find_common_divisors(divisors1: list[int], divisors2: list[int]) -> list[int]:\n    \"\"\"\n    Determines common divisors between two lists of divisors.\n    Satisfies FR4, BR2.\n    \"\"\"\n    return sorted(list(set(divisors1) & set(divisors2)))\n\ndef _sum_list_elements(numbers: list[int]) -> int:\n    \"\"\"\n    Calculates the sum of integers in a list.\n    Satisfies FR5, BR3.\n    \"\"\"\n    return sum(numbers)\n\ndef sum_common_divisors(num1: int, num2: int) -> int:\n    \"\"\"\n    Calculates the sum of common divisors for two given positive numbers.\n    Satisfies FR1, FR6, NFR2.\n    \"\"\"\n    if not isinstance(num1, int) or num1 <= 0:\n        raise ValueError(\"First number must be a positive integer.\")\n    if not isinstance(num2, int) or num2 <= 0:\n        raise ValueError(\"Second number must be a positive integer.\")\n\n    divisors_list_1 = _get_divisors(num1)\n    divisors_list_2 = _get_divisors(num2)\n\n    common_divisors_list = _find_common_divisors(divisors_list_1, divisors_list_2)\n\n    final_sum = _sum_list_elements(common_divisors_list)\n\n    return final_sum"}
{"task_id": "Mbpp/129", "solution": "from typing import List\nclass Matrix:\n    \"\"\"Represents a 2D matrix and provides methods for its properties and sum calculations.\"\"\"\n\n    def __init__(self, elements: List[List[int]]):\n        if not elements or not all(isinstance(row, list) for row in elements):\n            raise ValueError(\"Input must be a non-empty list of lists.\")\n        if not all(isinstance(item, int) for row in elements for item in row):\n            raise ValueError(\"All matrix elements must be integers.\")\n\n        self._elements = elements\n        self._rowCount = len(elements)\n        self._colCount = len(elements[0]) if elements else 0\n\n        if not all(len(row) == self._colCount for row in elements):\n            raise ValueError(\"All rows in the matrix must have the same number of columns.\")\n\n    def getRowCount(self) -> int:\n        \"\"\"Returns the number of rows in the matrix.\"\"\"\n        return self._rowCount\n\n    def getColumnCount(self) -> int:\n        \"\"\"Returns the number of columns in the matrix.\"\"\"\n        return self._colCount\n\n    def getElement(self, row: int, col: int) -> int:\n        \"\"\"Returns the element at the specified row and column.\"\"\"\n        if not (0 <= row < self._rowCount and 0 <= col < self._colCount):\n            raise IndexError(\"Row or column index out of bounds.\")\n        return self._elements[row][col]\n\n    def isSquare(self) -> bool:\n        \"\"\"Verifies if the matrix is square (number of rows equals number of columns).\"\"\"\n        return self._rowCount > 0 and self._rowCount == self._colCount\n\n    def calculateRowSum(self, rowIndex: int) -> int:\n        \"\"\"Calculates the sum of all elements in the specified row.\"\"\"\n        if not (0 <= rowIndex < self._rowCount):\n            raise IndexError(\"Row index out of bounds.\")\n        return sum(self._elements[rowIndex])\n\n    def calculateColumnSum(self, colIndex: int) -> int:\n        \"\"\"Calculates the sum of all elements in the specified column.\"\"\"\n        if not (0 <= colIndex < self._colCount):\n            raise IndexError(\"Column index out of bounds.\")\n        return sum(self._elements[row_idx][colIndex] for row_idx in range(self._rowCount))\n\n    def calculateMainDiagonalSum(self) -> int:\n        \"\"\"Calculates the sum of all elements in the main diagonal.\"\"\"\n        if not self.isSquare():\n            raise ValueError(\"Matrix must be square to calculate main diagonal sum.\")\n        return sum(self._elements[i][i] for i in range(self._rowCount))\n\n    def calculateAntiDiagonalSum(self) -> int:\n        \"\"\"Calculates the sum of all elements in the anti-diagonal.\"\"\"\n        if not self.isSquare():\n            raise ValueError(\"Matrix must be square to calculate anti-diagonal sum.\")\n        n = self._rowCount\n        return sum(self._elements[i][n - 1 - i] for i in range(n))\ndef magic_square_test(matrix_data: List[List[int]]) -> bool:\n    \"\"\"\n    Determines if the input 2D list represents a magic square.\n    It checks if the matrix is square and all row, column, and diagonal sums are equal.\n    \"\"\"\n    try:\n        matrix = Matrix(matrix_data)\n    except ValueError:\n        return False\n\n    if not matrix.isSquare():\n        return False\n\n    n = matrix.getRowCount()\n\n    row_sums = [matrix.calculateRowSum(i) for i in range(n)]\n    col_sums = [matrix.calculateColumnSum(i) for i in range(n)]\n    main_diag_sum = matrix.calculateMainDiagonalSum()\n    anti_diag_sum = matrix.calculateAntiDiagonalSum()\n\n    if not row_sums:\n        return False\n\n    target_sum = row_sums[0]\n\n    if not all(s == target_sum for s in row_sums):\n        return False\n\n    if not all(s == target_sum for s in col_sums):\n        return False\n\n    if main_diag_sum != target_sum or anti_diag_sum != target_sum:\n        return False\n\n    return True"}
{"task_id": "Mbpp/130", "solution": "from collections import Counter\nfrom typing import List, Any, Optional\ndef max_occurrences(input_list: List[Any]) -> Optional[Any]:\n    \"\"\"\n    Finds the item with the maximum frequency in a given list.\n\n    Args:\n        input_list: A list of items (can be of any comparable type).\n\n    Returns:\n        The item with the highest frequency. If multiple items share the same\n        maximum frequency, any one of them may be returned. Returns None if\n        the input list is empty.\n\n    Acceptance Criteria:\n    - max_occurrences([2,3,8,4,7,9,8,2,6,5,1,6,1,2,3,2,4,6,9,1,2]) == 2\n    - Given [1, 1, 2, 2, 3], the function returns 1 or 2.\n    - Given ['a', 'b', 'a', 'c', 'a'], the function returns 'a'.\n    - Given [], the function returns None.\n    \"\"\"\n    if not input_list:\n        return None\n\n    # Use collections.Counter for efficient frequency counting\n    counts = Counter(input_list)\n\n    # Find the item with the maximum count\n    max_item = None\n    max_count = -1\n\n    # Iterate through items and their counts\n    for item, count in counts.items():\n        if count > max_count:\n            max_count = count\n            max_item = item\n\n    return max_item"}
{"task_id": "Mbpp/131", "solution": "def _is_vowel(char: str) -> bool:\n    \"\"\"Checks if a character is a vowel (a, e, i, o, u, case-insensitive).\"\"\"\n    return char.lower() in 'aeiou'\ndef reverse_vowels(s: str) -> str:\n    \"\"\"Reverses only the vowels in a given string, maintaining non-vowel positions.\"\"\"\n    s_list = list(s)\n    vowel_indices = []\n    vowels_found = []\n\n    for i, char in enumerate(s_list):\n        if _is_vowel(char):\n            vowel_indices.append(i)\n            vowels_found.append(char)\n\n    vowels_found.reverse()\n\n    for i, original_index in enumerate(vowel_indices):\n        s_list[original_index] = vowels_found[i]\n\n    return \"\".join(s_list)"}
