{"task_id": "Mbpp/223", "solution": "def is_majority(array: list[int], n: int, element: int) -> bool:\n    \"\"\"Checks if an element is the majority element in a sorted array.\"\"\"\n\n    def _find_first_occurrence(arr: list[int], length: int, target: int) -> int:\n        \"\"\"Finds the index of the first occurrence of an element in a sorted array using binary search.\"\"\"\n        low, high = 0, length - 1\n        first_idx = -1\n        while low <= high:\n            mid = low + (high - low) // 2\n            if arr[mid] == target:\n                first_idx = mid\n                high = mid - 1\n            elif arr[mid] < target:\n                low = mid + 1\n            else:\n                high = mid - 1\n        return first_idx\n\n    def _find_last_occurrence(arr: list[int], length: int, target: int) -> int:\n        \"\"\"Finds the index of the last occurrence of an element in a sorted array using binary search.\"\"\"\n        low, high = 0, length - 1\n        last_idx = -1\n        while low <= high:\n            mid = low + (high - low) // 2\n            if arr[mid] == target:\n                last_idx = mid\n                low = mid + 1\n            elif arr[mid] < target:\n                low = mid + 1\n            else:\n                high = mid - 1\n        return last_idx\n\n    first_idx = _find_first_occurrence(array, n, element)\n\n    if first_idx == -1:\n        return False\n\n    last_idx = _find_last_occurrence(array, n, element)\n\n    count = last_idx - first_idx + 1\n\n    return count > n / 2"}
{"task_id": "Mbpp/224", "solution": "def count_Set_Bits(number: int) -> int:\n    \"\"\"\n    Counts the number of set bits (binary digits with value 1) in a given non-negative integer.\n    Uses Brian Kernighan's algorithm for efficient counting.\n    \"\"\"\n    count = 0\n    while number > 0:\n        number &= (number - 1) # Clear the least significant set bit\n        count += 1\n    return count"}
