{"task_id": "Mbpp/92", "solution": "def is_undulating(number: int) -> bool:\n    \"\"\"\n    Checks if a given integer is an undulating number.\n    An undulating number strictly alternates between two distinct digits (e.g., ABABAB...).\n    \"\"\"\n    str_number = str(number)\n    n = len(str_number)\n\n    if n < 2:\n        return False\n\n    first_digit = str_number[0]\n    second_digit = str_number[1]\n\n    if first_digit == second_digit:\n        return False\n\n    for i in range(2, n):\n        if i % 2 == 0:  # Even index, should match first_digit\n            if str_number[i] != first_digit:\n                return False\n        else:  # Odd index, should match second_digit\n            if str_number[i] != second_digit:\n                return False\n    \n    return True"}
