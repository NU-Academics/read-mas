{"task_id": "Mbpp/286", "solution": "def max_sub_array_sum_repeated(arr: list[int], n: int, k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous sub-array in the modified array formed by repeating the given array k times.\n    Applies a modified Kadane's algorithm considering array repetitions.\n    \"\"\"\n\n    def kadane(current_arr: list[int]) -> int:\n        \"\"\"\n        Helper function to implement Kadane's algorithm for finding the maximum contiguous sub-array sum.\n        Handles cases where all numbers are negative by returning the largest single element.\n        \"\"\"\n        if not current_arr:\n            return 0\n        \n        max_so_far = current_arr[0]\n        current_max = current_arr[0]\n\n        for i in range(1, len(current_arr)):\n            current_max = max(current_arr[i], current_max + current_arr[i])\n            max_so_far = max(max_so_far, current_max)\n        \n        return max_so_far\n            \n    if k == 0:\n        return 0\n            \n    if k == 1:\n        return kadane(arr)\n            \n    total_sum = sum(arr)\n    \n    # Calculate max sub-array sum for arr concatenated with itself (arr + arr).\n    # This covers sub-arrays that span at most one boundary between original arrays.\n    max_sum_double_arr = kadane(arr + arr)\n        \n    if total_sum > 0:\n        # If the total sum of the array is positive, we can include (k-2) full repetitions\n        # to maximize the sum. The max_sum_double_arr already covers the best start/end segments.\n        return max_sum_double_arr + (k - 2) * total_sum\n    else:\n        # If the total sum is non-positive, including more full repetitions won't help.\n        # The maximum sum must be contained within at most two repetitions.\n        return max_sum_double_arr"}
{"task_id": "Mbpp/287", "solution": "class InputIntegerN:\n    \"\"\"Represents and validates the input integer n.\"\"\"\n    def __init__(self, n: int):\n        if not isinstance(n, int) or n <= 0:\n            raise ValueError(\"Input 'n' must be a positive integer.\")\n        self._value = n\n\n    def get_value(self) -> int:\n        return self._value\nclass EvenNaturalNumber:\n    \"\"\"Represents an even natural number and calculates its square.\"\"\"\n    def __init__(self, value: int):\n        if not isinstance(value, int) or value <= 0 or value % 2 != 0:\n            raise ValueError(\"Value must be a positive even integer.\")\n        self._value = value\n\n    def get_value(self) -> int:\n        return self._value\n\n    def get_square(self) -> int:\n        return self._value * self._value\nclass SumOfSquaresResult:\n    \"\"\"Aggregates and stores the total sum of squares.\"\"\"\n    def __init__(self):\n        self._total_value = 0\n\n    def add_square(self, square: int):\n        if not isinstance(square, int) or square < 0:\n            raise ValueError(\"Square value must be a non-negative integer.\")\n        self._total_value += square\n\n    def get_total_value(self) -> int:\n        return self._total_value\ndef square_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of squares of the first n even natural numbers.\n    \"\"\"\n    input_n_obj = InputIntegerN(n)\n    validated_n = input_n_obj.get_value()\n\n    sum_accumulator = SumOfSquaresResult()\n\n    for i in range(1, validated_n + 1):\n        current_even_number_value = 2 * i\n        even_num_obj = EvenNaturalNumber(current_even_number_value)\n        square = even_num_obj.get_square()\n        sum_accumulator.add_square(square)\n\n    return sum_accumulator.get_total_value()"}
{"task_id": "Mbpp/290", "solution": "from typing import List, Any, Tuple\ndef max_length(list_of_lists: List[List[Any]]) -> Tuple[int, List[Any]]:\n    \"\"\"\n    Finds the sub-list with the maximum length in a list of lists.\n    Returns (0, []) for an empty input list or a list of empty sub-lists.\n    \"\"\"\n    max_len = 0\n    max_sublist = []\n\n    for sub_list in list_of_lists:\n        current_length = len(sub_list)\n        if current_length > max_len:\n            max_len = current_length\n            max_sublist = sub_list\n\n    return (max_len, max_sublist)"}
{"task_id": "Mbpp/292", "solution": "def find(dividend: float, divisor: float) -> int:\n    \"\"\"\n    Computes the floor division of two numbers, rounded down to the nearest integer.\n    Raises ZeroDivisionError if the divisor is zero.\n    \"\"\"\n    if divisor == 0:\n        raise ZeroDivisionError(\"Divisor cannot be zero.\")\n    return int(dividend // divisor)"}
{"task_id": "Mbpp/294", "solution": "def max_val(heterogeneous_list: list) -> (int | float | None):\n    \"\"\"\n    Finds the maximum numeric value in a given heterogeneous list.\n    Returns None if the list is empty or contains no numeric values.\n    \"\"\"\n    max_numeric = None\n    for item in heterogeneous_list:\n        if isinstance(item, (int, float)):\n            if max_numeric is None or item > max_numeric:\n                max_numeric = item\n    return max_numeric"}
{"task_id": "Mbpp/293", "solution": "import math\ndef otherside_rightangle(leg1, leg2):\n    \"\"\"\n    Calculates the hypotenuse of a right-angled triangle using the Pythagorean theorem.\n    Assumes leg1 and leg2 are the lengths of the two shorter sides.\n    \"\"\"\n    hypotenuse_squared = leg1**2 + leg2**2\n    hypotenuse = math.sqrt(hypotenuse_squared)\n    return hypotenuse"}
{"task_id": "Mbpp/296", "solution": "def get_Inv_Count(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the total number of inversions in the given array using a merge sort approach.\n    An inversion is a pair (i, j) such that i < j and arr[i] > arr[j].\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return 0\n\n    # Create a temporary array for merging, required by the merge sort algorithm.\n    temp = [0] * n\n\n    def _merge_and_count(arr: list[int], temp: list[int], left: int, mid: int, right: int) -> int:\n        \"\"\"\n        Merges two sorted subarrays and counts inversions where an element from the left\n        subarray is greater than an element from the right subarray.\n        \"\"\"\n        i = left    # Starting index for left subarray\n        j = mid + 1 # Starting index for right subarray\n        k = left    # Starting index for merged array in temp\n        inv_count = 0\n\n        while i <= mid and j <= right:\n            if arr[i] <= arr[j]:\n                temp[k] = arr[i]\n                i += 1\n            else:\n                # If arr[i] > arr[j], then arr[i] and all remaining elements in the left\n                # subarray (from i to mid) form inversions with arr[j].\n                temp[k] = arr[j]\n                inv_count += (mid - i + 1)\n                j += 1\n            k += 1\n\n        # Copy the remaining elements of the left subarray, if any.\n        while i <= mid:\n            temp[k] = arr[i]\n            i += 1\n            k += 1\n\n        # Copy the remaining elements of the right subarray, if any.\n        while j <= right:\n            temp[k] = arr[j]\n            j += 1\n            k += 1\n\n        # Copy the merged elements from temp back to the original array.\n        for idx in range(left, right + 1):\n            arr[idx] = temp[idx]\n\n        return inv_count\n\n    def _merge_sort_and_count(arr: list[int], temp: list[int], left: int, right: int) -> int:\n        \"\"\"\n        Recursively sorts the array segment arr[left...right] and counts inversions.\n        \"\"\"\n        inv_count = 0\n        if left < right:\n            mid = (left + right) // 2\n            inv_count += _merge_sort_and_count(arr, temp, left, mid)\n            inv_count += _merge_sort_and_count(arr, temp, mid + 1, right)\n            inv_count += _merge_and_count(arr, temp, left, mid, right)\n        return inv_count\n\n    return _merge_sort_and_count(arr, temp, 0, n - 1)"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(nested_list: list) -> list:\n    \"\"\"\n    Flattens a given nested list structure into a single-level list.\n\n    Args:\n        nested_list: The input list, which may contain nested lists.\n\n    Returns:\n        A new list containing all scalar elements from the input, flattened.\n    \"\"\"\n    flattened = []\n    for item in nested_list:\n        if isinstance(item, list):\n            flattened.extend(flatten_list(item))\n        else:\n            flattened.append(item)\n    return flattened"}
{"task_id": "Mbpp/299", "solution": "from collections import defaultdict\nfrom typing import List, Tuple\ndef max_aggregate(score_entries: List[Tuple[str, int]]) -> Tuple[str, int]:\n    \"\"\"\n    Calculates the maximum aggregate score from a list of name-score tuples.\n    Aggregates scores by name and returns the name and total score of the participant with the highest aggregate.\n    \"\"\"\n    aggregated_scores = defaultdict(int)\n\n    for name, score in score_entries:\n        aggregated_scores[name] += score\n\n    if not aggregated_scores:\n        return ('', 0)\n\n    max_name = None\n    max_score = -1\n\n    for name, total_score in aggregated_scores.items():\n        if total_score > max_score:\n            max_score = total_score\n            max_name = name\n\n    return (max_name, max_score)"}
{"task_id": "Mbpp/300", "solution": "import math\ndef count_binary_seq(n: int) -> float:\n    \"\"\"\n    Calculates the count of binary sequences of length 2n such that\n    the sum of the first n bits equals the sum of the last n bits.\n    \"\"\"\n    return float(math.comb(2 * n, n))"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(dictionary: dict) -> int:\n    \"\"\"Calculates the maximum nesting depth of a dictionary.\"\"\"\n    if not dictionary:\n        return 1\n\n    max_depth_contribution = 0\n    for value in dictionary.values():\n        if isinstance(value, dict):\n            nested_depth = dict_depth(value)\n            max_depth_contribution = max(max_depth_contribution, nested_depth)\n    \n    return 1 + max_depth_contribution"}
{"task_id": "Mbpp/305", "solution": "def start_withp(input_list: list[str]) -> tuple[str | None, str | None]:\n    collected_words = []\n    for input_string in input_list:\n        words = input_string.split()\n        for word in words:\n            if word.lower().startswith('p'):\n                collected_words.append(word)\n                if len(collected_words) == 2:\n                    return (collected_words[0], collected_words[1])\n\n    # Format the collected words into a tuple, using None for missing elements.\n    return (collected_words[0] if len(collected_words) > 0 else None,\n            collected_words[1] if len(collected_words) > 1 else None)"}
{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(arr: list[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence from a prefix until the `i`th index,\n    and also including the `k`th element (where `k > i`).\n    \"\"\"\n    # dp[j] stores the maximum sum of an increasing subsequence ending at arr[j]\n    # within the prefix up to index i.\n    dp = [arr[j] for j in range(i + 1)]\n\n    # Populate the dp array for the prefix up to index i\n    for j in range(1, i + 1):\n        for p in range(j):\n            if arr[j] > arr[p]:\n                dp[j] = max(dp[j], dp[p] + arr[j])\n\n    # Initialize the overall maximum sum with arr[k] itself, as it must be included.\n    overall_max_sum = arr[k]\n\n    # Iterate through the prefix to find the best increasing subsequence ending at some arr[j] (j <= i)\n    # that can be extended by arr[k].\n    for j in range(i + 1):\n        if arr[j] < arr[k]:\n            overall_max_sum = max(overall_max_sum, dp[j] + arr[k])\n\n    return overall_max_sum"}
{"task_id": "Mbpp/308", "solution": "def _generate_all_products(list1: list, list2: list) -> list:\n    \"\"\"\n    Computes all possible products from two input lists.\n    Returns a list of all products.\n    \"\"\"\n    products = []\n    for num1 in list1:\n        for num2 in list2:\n            products.append(num1 * num2)\n    return products\ndef large_product(list1: list, list2: list, k: int) -> list:\n    \"\"\"\n    Finds the specified number of largest products from two given lists,\n    selecting one factor from each list.\n    \"\"\"\n    _validate_inputs(list1, list2, k)\n    all_products = _generate_all_products(list1, list2)\n    all_products.sort(reverse=True)\n    return all_products[:k]"}
