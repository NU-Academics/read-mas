{"task_id": "Mbpp/473", "solution": "def _normalize_tuple(t: tuple) -> frozenset:\n    \"\"\"Returns a frozenset of elements from the input tuple for order-independent comparison.\"\"\"\n    return frozenset(t)\ndef tuple_intersection(list1: list[tuple], list2: list[tuple]) -> set[tuple]:\n    \"\"\"Computes the intersection of two lists of tuples, ignoring element order within tuples.\n\n    Args:\n        list1: The first list of tuples.\n        list2: The second list of tuples.\n\n    Returns:\n        A set of tuples representing the intersection.\n    \"\"\"\n    normalized_forms_from_list1 = set()\n    # Store a mapping from canonical form to an original tuple from list1\n    canonical_to_original_map = {}\n\n    for original_tuple in list1:\n        canonical_form = _normalize_tuple(original_tuple)\n        normalized_forms_from_list1.add(canonical_form)\n        # Store the original tuple. If duplicates in list1, the last one for a canonical form wins.\n        canonical_to_original_map[canonical_form] = original_tuple\n\n    intersection_result = set()\n    for original_tuple_b in list2:\n        canonical_form_b = _normalize_tuple(original_tuple_b)\n        if canonical_form_b in normalized_forms_from_list1:\n            # Add the original tuple from list1 that corresponds to the canonical form\n            intersection_result.add(canonical_to_original_map[canonical_form_b])\n\n    return intersection_result"}
{"task_id": "Mbpp/476", "solution": "def big_sum(arr: list[float | int]) -> float | int:\n    \"\"\"Calculates the sum of the largest and smallest values in a given array.\n    Raises ValueError if the input array is empty.\"\"\"\n    if not arr:\n        raise ValueError(\"Input array cannot be empty.\")\n    min_value = min(arr)\n    max_value = max(arr)\n    return min_value + max_value"}
