{"task_id": "Mbpp/763", "solution": "def find_min_diff(collection, size):\n    \"\"\"\n    Calculates the minimum absolute difference between any two elements in the input collection.\n    It sorts the collection first to optimize the search.\n    \"\"\"\n    collection = sorted(collection)\n    min_diff = float('inf')\n\n    for i in range(size - 1):\n        min_diff = min(min_diff, collection[i+1] - collection[i])\n            \n    return min_diff"}
{"task_id": "Mbpp/764", "solution": "def number_ctr(input_string: str) -> int:\n    \"\"\"\n    Counts the number of numerical digits (0-9) in the given string.\n\n    Args:\n        input_string: The string to analyze.\n    \"\"\"\n    digit_count = 0\n    for char in input_string:\n        if char.isdigit():\n            digit_count += 1\n    return digit_count"}
{"task_id": "Mbpp/765", "solution": "def is_power_of_two(n: int) -> bool:\n    \"\"\"Checks if a positive integer is a power of two.\"\"\"\n    return n > 0 and (n & (n - 1)) == 0\ndef is_polite(n: int) -> int:\n    \"\"\"Calculates the nth polite number, where a polite number is a positive integer not a power of 2.\"\"\"\n    count = 0\n    num = 1\n    while True:\n        if not is_power_of_two(num):\n            count += 1\n            if count == n:\n                return num\n        num += 1"}
{"task_id": "Mbpp/766", "solution": "def pair_wise(input_list: list) -> list[tuple]:\n    \"\"\"\n    Returns a list of all pairs of consecutive items in a given list.\n    Returns an empty list if the input list has fewer than two elements.\n    \"\"\"\n    if len(input_list) < 2:\n        return []\n    result = []\n    for i in range(len(input_list) - 1):\n        result.append((input_list[i], input_list[i+1]))\n    return result"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers: list[int], target_sum: int) -> int:\n    \"\"\"\n    Counts the number of unique pairs (by index) in a list whose sum equals a target value.\n    This implementation uses a nested loop to check all possible pairs.\n    \"\"\"\n    count = 0\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if numbers[i] + numbers[j] == target_sum:\n                count += 1\n    return count"}
