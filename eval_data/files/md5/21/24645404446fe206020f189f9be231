{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Calculates the nth Jacobsthal number iteratively.\n    J(n) = J(n-1) + 2*J(n-2) with J(0)=0 and J(1)=1.\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n    else:\n        a, b = 0, 1  # J(0), J(1)\n        for _ in range(2, n + 1):\n            next_jacobsthal = b + 2 * a\n            a = b\n            b = next_jacobsthal\n        return b"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(arr: list) -> bool:\n    \"\"\"\n    Checks if the given array represents a min-heap.\n    It verifies that each parent node is less than or equal to its children.\n    \"\"\"\n    n = len(arr)\n\n    # An empty array or an array with a single element is always a min-heap.\n    if n <= 1:\n        return True\n\n    # Iterate only through potential parent nodes.\n    # In a 0-indexed array, parents are from index 0 to n/2 - 1.\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child\n        if left_child_idx < n and arr[i] > arr[left_child_idx]:\n            return False\n\n        # Check right child\n        if right_child_idx < n and arr[i] > arr[right_child_idx]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/753", "solution": "def min_k(data: list[tuple], k: int) -> list[tuple]:\n    \"\"\"\n    Finds the minimum k records from a list of tuples based on their second element's numerical value.\n    Ignores invalid tuples and returns a sorted list.\n    \"\"\"\n    if k < 0:\n        raise ValueError(\"k must be a non-negative integer.\")\n    if k == 0:\n        return []\n\n    valid_records = []\n    for item in data:\n        # Validate item: must be a tuple with at least two elements, and the second must be numerical.\n        if isinstance(item, tuple) and len(item) >= 2 and isinstance(item[1], (int, float)):\n            valid_records.append(item)\n\n    # Sort valid_records by the second element (numerical value)\n    valid_records.sort(key=lambda x: x[1])\n\n    # Select the top k records\n    return valid_records[:k]"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(list1: list, list2: list, list3: list) -> list:\n    \"\"\"\n    Finds elements that appear at the same index in all three input lists.\n    The function iterates up to the length of the shortest list to prevent IndexError.\n    \"\"\"\n    common_elements = []\n    min_length = min(len(list1), len(list2), len(list3))\n\n    for i in range(min_length):\n        if list1[i] == list2[i] == list3[i]:\n            common_elements.append(list1[i])\n\n    return common_elements"}
