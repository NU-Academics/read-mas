{"task_id": "Mbpp/771", "solution": "from enum import Enum\nfrom typing import List, Optional\nclass BracketType(Enum):\n    PARENTHESIS = 1\n    SQUARE = 2\n    CURLY = 3\nclass Bracket:\n    _opening_brackets = {'(': BracketType.PARENTHESIS, '[': BracketType.SQUARE, '{': BracketType.CURLY}\n    _closing_brackets = {')': BracketType.PARENTHESIS, ']': BracketType.SQUARE, '}': BracketType.CURLY}\n\n    def __init__(self, symbol: str):\n        self._symbol = symbol\n        if symbol in self._opening_brackets:\n            self._type = self._opening_brackets[symbol]\n            self._is_opening = True\n        elif symbol in self._closing_brackets:\n            self._type = self._closing_brackets[symbol]\n            self._is_opening = False\n        else:\n            raise ValueError(f\"Invalid bracket symbol: {symbol}\")\n\n    def get_type(self) -> BracketType:\n        return self._type\n\n    def is_opening_bracket(self) -> bool:\n        return self._is_opening\n\n    def matches(self, other: 'Bracket') -> bool:\n        \"\"\"Checks if this opening bracket matches the given closing bracket.\"\"\"\n        if self.is_opening_bracket() and not other.is_opening_bracket():\n            return self.get_type() == other.get_type()\n        return False\nclass Stack:\n    def __init__(self):\n        self._items: List[Bracket] = []\n\n    def push(self, item: Bracket):\n        self._items.append(item)\n\n    def pop(self) -> Bracket:\n        if self.is_empty():\n            raise IndexError(\"pop from empty stack\")\n        return self._items.pop()\n\n    def peek(self) -> Optional[Bracket]:\n        if self.is_empty():\n            return None\n        return self._items[-1]\n\n    def is_empty(self) -> bool:\n        return len(self._items) == 0\ndef check_expression(expression_string: str) -> bool:\n    \"\"\"\n    Checks if the given expression string has balanced parentheses, square brackets, and curly braces.\n    Returns True if the expression is balanced, False otherwise.\n    \"\"\"\n    stack = Stack()\n\n    opening_symbols = Bracket._opening_brackets.keys()\n    closing_symbols = Bracket._closing_brackets.keys()\n\n    for char in expression_string:\n        if char in opening_symbols:\n            stack.push(Bracket(char))\n        elif char in closing_symbols:\n            if stack.is_empty():\n                return False\n\n            last_opening_bracket = stack.pop()\n            current_closing_bracket = Bracket(char)\n\n            if not last_opening_bracket.matches(current_closing_bracket):\n                return False\n        # Ignore other characters as per SRS\n\n    return stack.is_empty()"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(main_string: str, sub_string: str) -> tuple[str, int, int] | None:\n    \"\"\"Finds the first occurrence and position of a substring within a main string.\"\"\"\n    start_index = main_string.find(sub_string)\n    if start_index == -1:\n        return None\n    end_index = start_index + len(sub_string)\n    return (sub_string, start_index, end_index)"}
{"task_id": "Mbpp/775", "solution": "def _is_odd(number: int) -> bool:\n    \"\"\"Checks if a given integer is odd.\"\"\"\n    return number % 2 != 0\ndef odd_position(input_list: list) -> bool:\n    \"\"\"\n    Checks if every odd index in a given list contains an odd number.\n    It iterates through the list and validates elements at odd indices.\n    \"\"\"\n    for index, element in enumerate(input_list):\n        if _is_odd(index):  # Check if the current index is odd\n            if not _is_odd(element):  # If index is odd, check if the element at this index is also odd\n                return False  # If element is not odd, immediately return False\n    return True  # All odd-indexed elements were odd, or there were no odd indices"}
{"task_id": "Mbpp/777", "solution": "import collections\ndef find_sum(elements: list) -> (int | float):\n    \"\"\"\n    Calculates the sum of elements that appear exactly once in a given list.\n    Uses collections.Counter to efficiently count element frequencies.\n    \"\"\"\n    counts = collections.Counter(elements)\n    total_sum = 0\n    for element, count in counts.items():\n        if count == 1:\n            total_sum += element\n    return total_sum"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list: list) -> list:\n    \"\"\"\n    Packs consecutive duplicates of list elements into sublists.\n    Groups consecutive identical elements into sublists.\n    \"\"\"\n    if not input_list:\n        return []\n\n    output_list = []\n    current_group = []\n\n    for element in input_list:\n        if not current_group or element == current_group[0]:\n            current_group.append(element)\n        else:\n            output_list.append(current_group)\n            current_group = [element]\n    \n    # Add the last group if it's not empty\n    if current_group:\n        output_list.append(current_group)\n            \n    return output_list"}
{"task_id": "Mbpp/780", "solution": "import itertools\ndef find_combinations(tuple_list: list[tuple[int, int]]) -> list[tuple[int, int]]:\n    \"\"\"\n    Finds the combinations of sums with tuples in the given tuple list.\n    Calculates element-wise sums for all unique pairs of 2-element integer tuples.\n    \"\"\"\n    if not isinstance(tuple_list, list):\n        raise ValueError(\"Input must be a list.\")\n    for i, item in enumerate(tuple_list):\n        if not isinstance(item, tuple) or len(item) != 2:\n            raise ValueError(f\"Element at index {i} is not a 2-element tuple: {item}\")\n        if not all(isinstance(e, int) for e in item):\n            raise ValueError(f\"Elements within tuple at index {i} must be integers: {item}\")\n\n    if len(tuple_list) < 2:\n        return []\n\n    unique_pairs = list(itertools.combinations(tuple_list, 2))\n\n    sum_tuples = []\n    for pair1, pair2 in unique_pairs:\n        sum_tuples.append((pair1[0] + pair2[0], pair1[1] + pair2[1]))\n\n    return sum_tuples"}
{"task_id": "Mbpp/781", "solution": "def count_divisors_is_even(number: int) -> bool:\n    \"\"\"Calculates the count of positive divisors for a given number and checks if the count is even.\n\n    Args:\n        number: A positive integer.\n\n    Returns:\n        True if the count of divisors is even, False otherwise.\n\n    Raises:\n        ValueError: If the input number is not a positive integer.\n    \"\"\"\n    if not isinstance(number, int) or number <= 0:\n        raise ValueError(\"Input number must be a positive integer.\")\n\n    divisor_count = 0\n    i = 1\n    while i * i <= number:\n        if number % i == 0:\n            if i * i == number:\n                divisor_count += 1\n            else:\n                divisor_count += 2\n        i += 1\n    \n    return divisor_count % 2 == 0"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(arr: list[int | float]) -> int | float:\n    \"\"\"Calculates the sum of all elements of all odd-length subarrays.\n\n    Args:\n        arr: A list of numbers (integers or floats).\n\n    Returns:\n        The total sum of elements from all odd-length subarrays.\n    \"\"\"\n    total_sum = 0\n    n = len(arr)\n\n    # Iterate through all possible start indices\n    for i in range(n):\n        # Iterate through all possible end indices from the current start index\n        for j in range(i, n):\n            # Extract the subarray\n            subarray = arr[i : j + 1]\n\n            # Determine length and check if it's odd\n            if len(subarray) % 2 != 0:\n                # Sum elements of the odd-length subarray\n                total_sum += sum(subarray)\n\n    return total_sum"}
{"task_id": "Mbpp/784", "solution": "def mul_even_odd(numbers: list[int]) -> int | None:\n    \"\"\"\n    Finds the product of the first even and first odd numbers in a list.\n    Returns None if either number is not found.\n    \"\"\"\n\n    def _is_even(number: int) -> bool:\n        \"\"\"Checks if a given integer is even.\"\"\"\n        return number % 2 == 0\n\n    def _is_odd(number: int) -> bool:\n        \"\"\"Checks if a given integer is odd.\"\"\"\n        return number % 2 != 0\n\n    def _find_first_even(numbers: list[int]) -> int | None:\n        \"\"\"Finds and returns the first even number in the list.\"\"\"\n        for num in numbers:\n            if _is_even(num):\n                return num\n        return None\n\n    def _find_first_odd(numbers: list[int]) -> int | None:\n        \"\"\"Finds and returns the first odd number in the list.\"\"\"\n        for num in numbers:\n            if _is_odd(num):\n                return num\n        return None\n\n    first_even = _find_first_even(numbers)\n    first_odd = _find_first_odd(numbers)\n\n    if first_even is not None and first_odd is not None:\n        return first_even * first_odd\n    else:\n        return None"}
