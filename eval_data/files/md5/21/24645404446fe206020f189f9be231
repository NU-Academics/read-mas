{"task_id": "Mbpp/594", "solution": "def diff_even_odd(list_of_integers: list[int]) -> int:\n    \"\"\"\n    Finds the difference of the first even and first odd number in a given list.\n    Assumes the list contains at least one even and one odd number.\n    \"\"\"\n    def _is_even(number: int) -> bool:\n        \"\"\"Determines if a given integer is even.\"\"\"\n        return number % 2 == 0\n\n    def _is_odd(number: int) -> bool:\n        \"\"\"Determines if a given integer is odd.\"\"\"\n        return number % 2 != 0\n\n    first_even = None\n    first_odd = None\n\n    for number in list_of_integers:\n        if first_even is None and _is_even(number):\n            first_even = number\n        if first_odd is None and _is_odd(number):\n            first_odd = number\n        \n        # Stop iterating once both the first even and first odd numbers are found.\n        if first_even is not None and first_odd is not None:\n            break\n\n    # As per prompt's constraint \"Do NOT add isinstance() checks or raise exceptions for edge cases\",\n    # we assume both first_even and first_odd will be found.\n    return first_even - first_odd"}
{"task_id": "Mbpp/597", "solution": "def find_kth(arr1: list[int], arr2: list[int], k: int) -> int:\n    \"\"\"\n    Finds the k-th smallest element from two given sorted arrays.\n    It uses a two-pointer approach to effectively merge and count elements.\n    \"\"\"\n    len1, len2 = len(arr1), len(arr2)\n    p1, p2 = 0, 0\n    kth_element = 0\n\n    for _ in range(k):\n        if p1 < len1 and (p2 >= len2 or arr1[p1] <= arr2[p2]):\n            kth_element = arr1[p1]\n            p1 += 1\n        elif p2 < len2 and (p1 >= len1 or arr2[p2] < arr1[p1]):\n            kth_element = arr2[p2]\n            p2 += 1\n    return kth_element"}
{"task_id": "Mbpp/598", "solution": "def armstrong_number(number: int) -> bool:\n    \"\"\"Checks if a given integer is an Armstrong number.\"\"\"\n    num_str = str(number)\n    num_digits = len(num_str)\n    sum_of_powers = 0\n    for digit_char in num_str:\n        digit = int(digit_char)\n        sum_of_powers += digit ** num_digits\n    return sum_of_powers == number"}
{"task_id": "Mbpp/599", "solution": "def sum_average(n):\n    \"\"\"\n    Calculates the sum and average of the first 'n' natural numbers.\n    \"\"\"\n    # Sum of first n natural numbers: n * (n + 1) / 2\n    calculated_sum = n * (n + 1) // 2\n\n    # Average of first n natural numbers: sum / n\n    calculated_average = float(calculated_sum) / n\n\n    return (calculated_sum, calculated_average)"}
