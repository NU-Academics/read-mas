{"task_id": "Mbpp/71", "solution": "def comb_sort(list_of_elements: list) -> list:\n    \"\"\"Sorts a list of elements using the Comb Sort algorithm.\n    Returns a new sorted list.\"\"\"\n    n = len(list_of_elements)\n    if n == 0:\n        return []\n\n    # Create a copy to avoid modifying the original list\n    arr = list_of_elements[:]\n\n    gap = n\n    shrink_factor = 1.3\n    swapped = True\n\n    while gap > 1 or swapped:\n        if gap > 1:\n            gap = int(gap / shrink_factor)\n        \n        swapped = False\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True\n    return arr"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list: list, sub_list: list) -> bool:\n    \"\"\"\n    Checks if a sublist is a contiguous sequence within the main list.\n    \"\"\"\n    if not sub_list:\n        return True\n    if len(sub_list) > len(main_list):\n        return False\n\n    for i in range(len(main_list) - len(sub_list) + 1):\n        if main_list[i:i + len(sub_list)] == sub_list:\n            return True\n    return False"}
{"task_id": "Mbpp/75", "solution": "def _is_element_divisible(element: int, k: int) -> bool:\n    \"\"\"Checks if an integer element is perfectly divisible by k.\"\"\"\n    return element % k == 0\ndef _is_tuple_fully_divisible(current_tuple: tuple[int, ...], k: int) -> bool:\n    \"\"\"Checks if all elements in a tuple are perfectly divisible by k.\"\"\"\n    for element in current_tuple:\n        if not _is_element_divisible(element, k):\n            return False\n    return True\ndef find_tuples(list_of_tuples: list[tuple[int, ...]], k: int) -> list[tuple[int, ...]]:\n    \"\"\"Filters a list of tuples, returning only those where all elements are divisible by k.\"\"\"\n    filtered_tuples = []\n    for current_tuple in list_of_tuples:\n        if _is_tuple_fully_divisible(current_tuple, k):\n            filtered_tuples.append(current_tuple)\n    return filtered_tuples"}
