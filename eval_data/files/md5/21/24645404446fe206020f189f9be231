{"task_id": "Mbpp/739", "solution": "import math\ndef _calculate_triangular_number(k: int) -> int:\n    \"\"\"Calculates the triangular number for a given index k.\"\"\"\n    return k * (k + 1) // 2\ndef _count_digits(number: int) -> int:\n    \"\"\"Counts the number of digits in an integer.\"\"\"\n    if number == 0:\n        return 1\n    return int(math.log10(number)) + 1\ndef find_Index(n: int) -> int:\n    \"\"\"Finds the index of the smallest triangular number with n digits.\"\"\"\n    k = 1\n    while True:\n        triangular_number = _calculate_triangular_number(k)\n        if _count_digits(triangular_number) == n:\n            return k\n        k += 1"}
{"task_id": "Mbpp/740", "solution": "def tuple_to_dict(input_tuple: tuple) -> dict:\n    \"\"\"\n    Converts a tuple into a dictionary using adjacent elements as key-value pairs.\n    Raises ValueError if the input tuple has an odd number of elements.\n    \"\"\"\n    if len(input_tuple) % 2 != 0:\n        raise ValueError(\"Input tuple must contain an even number of elements to form complete key-value pairs.\")\n\n    result_dict = {}\n    for i in range(0, len(input_tuple), 2):\n        key = input_tuple[i]\n        value = input_tuple[i + 1]\n        result_dict[key] = value\n    return result_dict"}
