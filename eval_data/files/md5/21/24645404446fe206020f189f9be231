{"task_id": "Mbpp/415", "solution": "def max_Product(arr: list[int]) -> tuple[int, int]:\n    \"\"\"\n    Finds a pair of integers with the highest product from a given array.\n\n    Returns a tuple containing the two integers whose product is the highest.\n    \"\"\"\n    if len(arr) < 2:\n        raise ValueError(\"Input array must contain at least two elements.\")\n\n    arr.sort()\n\n    # The highest product can come from either the two largest numbers\n    # or the two smallest (most negative) numbers.\n    product_of_largest_positives = arr[-1] * arr[-2]\n    pair_of_largest_positives = (arr[-2], arr[-1])\n\n    product_of_smallest_negatives = arr[0] * arr[1]\n    pair_of_smallest_negatives = (arr[0], arr[1])\n\n    if product_of_largest_positives >= product_of_smallest_negatives:\n        return pair_of_largest_positives\n    else:\n        return pair_of_smallest_negatives"}
{"task_id": "Mbpp/418", "solution": "def Find_Max(list_of_lists: list) -> list | None:\n    \"\"\"\n    Finds the sub-list with the maximum length from a list of sub-lists.\n    Returns the first sub-list with the maximum length encountered, or None if the input list is empty.\n    \"\"\"\n    if not list_of_lists:\n        return None\n\n    max_length_sublist = None\n    max_length = -1\n\n    for sublist in list_of_lists:\n        current_length = len(sublist)\n        if current_length > max_length:\n            max_length = current_length\n            max_length_sublist = sublist\n\n    return max_length_sublist"}
{"task_id": "Mbpp/419", "solution": "def _round_numbers(numbers: list[float]) -> list[int]:\n    \"\"\"Rounds each floating-point number in the input list to the nearest integer.\"\"\"\n    return [round(num) for num in numbers]\ndef _calculate_sum(rounded_numbers: list[int]) -> int:\n    \"\"\"Calculates the sum of a list of integer numbers.\"\"\"\n    return sum(rounded_numbers)\ndef _get_list_length(numbers: list[float]) -> int:\n    \"\"\"Determines the number of elements in the input list.\"\"\"\n    return len(numbers)\ndef _calculate_final_value(sum_rounded: int, list_length: int) -> int:\n    \"\"\"Multiplies the sum of rounded numbers by the list length.\"\"\"\n    return sum_rounded * list_length\ndef round_and_sum(numbers: list[float]) -> int:\n    \"\"\"\n    Rounds every number of a given list of numbers, calculates their total sum,\n    and returns the sum multiplied by the length of the original list.\n    \"\"\"\n    rounded_numbers = _round_numbers(numbers)\n    sum_rounded = _calculate_sum(rounded_numbers)\n    list_length = _get_list_length(numbers)\n    final_value = _calculate_final_value(sum_rounded, list_length)\n    return final_value"}
{"task_id": "Mbpp/420", "solution": "def cube_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the cubes of the first 'n' even natural numbers.\n    For n=2, this calculates (2^3) + (4^3) = 8 + 64 = 72.\n    \"\"\"\n    total_sum = 0\n    for i in range(1, n + 1):\n        even_number = 2 * i\n        cube = even_number ** 3\n        total_sum += cube\n    return total_sum"}
{"task_id": "Mbpp/422", "solution": "def find_Average_Of_Cube(n):\n    \"\"\"\n    Calculates the average of the cubes of the first 'n' natural numbers.\n    Assumes 'n' is a positive integer.\n    \"\"\"\n    sum_of_cubes = 0\n    for i in range(1, n + 1):\n        sum_of_cubes += i ** 3\n    return sum_of_cubes / n"}
