{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(input_list: list) -> int:\n    \"\"\"\n    Calculates the sum of products of all possible contiguous sublists of a given list.\n    \"\"\"\n    def _calculate_product(sublist: list) -> int:\n        \"\"\"Calculates the product of all elements in a given sublist.\"\"\"\n        if not sublist:\n            return 0\n        product = 1\n        for x in sublist:\n            product *= x\n        return product\n\n    def _generate_sublists(input_list: list) -> list[list]:\n        \"\"\"Generates all possible contiguous sublists from the input list.\"\"\"\n        all_sublists = []\n        n = len(input_list)\n        for i in range(n):\n            for j in range(i, n):\n                all_sublists.append(input_list[i : j + 1])\n        return all_sublists\n\n    total_sum = 0\n    all_sublists = _generate_sublists(input_list)\n    for sublist in all_sublists:\n        total_sum += _calculate_product(sublist)\n    return total_sum"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(arr: list[int], target: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a target number in a sorted array.\n    Uses a binary search variant to locate the first occurrence.\n    \"\"\"\n    low, high = 0, len(arr) - 1\n    first_occurrence_index = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if arr[mid] == target:\n            first_occurrence_index = mid\n            high = mid - 1  # Try to find an earlier occurrence in the left half\n        elif arr[mid] < target:\n            low = mid + 1\n        else:\n            high = mid - 1\n\n    return first_occurrence_index"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(number: int) -> int:\n    \"\"\"Toggles all bits of the number except the most significant and least significant bits.\"\"\"\n    num_bits = number.bit_length()\n\n    # If the number has 0, 1, or 2 bits, there are no \"middle\" bits to toggle.\n    if num_bits <= 2:\n        return number\n\n    # Create a mask with '1's for all bits between the MSB and LSB.\n    # The mask will have '1's from position 1 up to (num_bits - 2), and '0's elsewhere.\n    # ((1 << (num_bits - 2)) - 1) creates num_bits - 2 ones starting from the LSB.\n    # Shifting it left by 1 places these ones from position 1 onwards.\n    mask = ((1 << (num_bits - 2)) - 1) << 1\n\n    # XOR the number with the mask to toggle only the middle bits.\n    return number ^ mask"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(collection: list[int], value: int) -> int:\n    \"\"\"\n    Determines the left insertion point for a value in a sorted collection.\n    It returns the index of the first element that is greater than or equal to the specified value.\n    \"\"\"\n    for i, element in enumerate(collection):\n        if element >= value:\n            return i\n    return len(collection)"}
