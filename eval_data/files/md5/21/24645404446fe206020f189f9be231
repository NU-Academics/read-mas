{"task_id": "Mbpp/96", "solution": "def divisor(n: int) -> int:\n    \"\"\"\n    Calculates the number of positive divisors for a given integer n.\n    Raises ValueError if n is not a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input must be a positive integer.\")\n\n    count = 0\n    for i in range(1, int(n**0.5) + 1):\n        if n % i == 0:\n            if i * i == n:\n                count += 1\n            else:\n                count += 2\n    return count"}
{"task_id": "Mbpp/97", "solution": "import collections\nimport itertools\ndef frequency_lists(list_of_lists):\n    \"\"\"\n    Calculates the frequency of each element in a flattened list of lists.\n    Returns a dictionary mapping each unique element to its count.\n    \"\"\"\n    flattened_list = list(itertools.chain.from_iterable(list_of_lists))\n    frequency_dict = collections.Counter(flattened_list)\n    return dict(frequency_dict)"}
{"task_id": "Mbpp/98", "solution": "def multiply_num(numbers):\n    \"\"\"\n    Multiplies all numbers in a list/tuple and divides the product by the list's length.\n    Assumes valid, non-empty numeric input as per design context for final implementation.\n    \"\"\"\n    product = 1.0\n    for item in numbers:\n        product *= item\n\n    length = len(numbers)\n    return product / length"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(decimal_num: int) -> str:\n    \"\"\"Converts a decimal number to its binary string equivalent.\n    Ensures no leading zeros, except for input 0 which returns '0'.\n    \"\"\"\n    if decimal_num == 0:\n        return '0'\n\n    binary_digits = []\n    current_num = decimal_num\n    while current_num > 0:\n        remainder = current_num % 2\n        binary_digits.append(str(remainder))\n        current_num //= 2\n\n    return \"\".join(binary_digits[::-1])"}
{"task_id": "Mbpp/100", "solution": "import math\ndef next_smallest_palindrome(n: int) -> int:\n    # Helper function to check if a number is a palindrome\n    def is_palindrome(num: int) -> bool:\n        if num < 0:\n            return False\n        s = str(num)\n        return s == s[::-1]\n\n    current_num = n + 1\n    while True:\n        if is_palindrome(current_num):\n            return current_num\n        current_num += 1"}
{"task_id": "Mbpp/101", "solution": "def kth_element(array, k):\n    \"\"\"\n    Finds the kth element in the given array using 1-based indexing.\n    Raises ValueError if k is not positive or is out of bounds.\n    \"\"\"\n    if k <= 0:\n        raise ValueError(\"k must be a positive integer\")\n    if k > len(array):\n        raise ValueError(\"k is out of bounds for the array\")\n\n    # Convert 1-based index k to 0-based index\n    zero_based_index = k - 1\n    return array[zero_based_index]"}
