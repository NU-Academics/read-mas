{"task_id": "Mbpp/757", "solution": "def count_reverse_pairs(string_list: list[str]) -> int:\n    \"\"\"\n    Counts the number of unique pairs of strings in the given list\n    where one string is the reverse of the other.\n    \"\"\"\n    pairs_count = 0\n    seen_pairs = set()\n\n    string_set = set(string_list)\n\n    for s1 in string_set:\n        reversed_s1 = s1[::-1]\n\n        if reversed_s1 in string_set:\n            if s1 == reversed_s1:\n                continue\n\n            canonical_pair = tuple(sorted((s1, reversed_s1)))\n\n            if canonical_pair not in seen_pairs:\n                seen_pairs.add(canonical_pair)\n                pairs_count += 1\n\n    return pairs_count"}
{"task_id": "Mbpp/759", "solution": "import re\ndef is_decimal(input_string: str) -> bool:\n    \"\"\"\n    Checks if a string represents a decimal number with exactly two decimal places.\n    Handles optional leading signs and ensures the decimal point is followed by two digits.\n    \"\"\"\n    # Regex to match a decimal number with an optional sign, zero or more digits before\n    # the decimal point, and exactly two digits after it.\n    pattern = r\"^[+-]?\\d*\\.\\d{2}$\"\n    return re.fullmatch(pattern, input_string) is not None"}
{"task_id": "Mbpp/758", "solution": "from collections import defaultdict\ndef unique_sublists(list_of_lists: list[list]) -> dict[tuple, int]:\n    \"\"\"Counts the occurrences of unique sublists within a list of lists, returning a frequency map.\n    Each sublist is converted to a tuple to serve as a dictionary key.\"\"\"\n    frequency_map = defaultdict(int)\n    for sublist in list_of_lists:\n        sublist_tuple = tuple(sublist)\n        frequency_map[sublist_tuple] += 1\n    return dict(frequency_map)"}
