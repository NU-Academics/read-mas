{"task_id": "Mbpp/456", "solution": "from typing import List\nclass String:\n    \"\"\"Encapsulates a single string value and provides a method to reverse it.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n\n    def reverse(self) -> 'String':\n        \"\"\"Returns a new String object with the characters of the current string reversed.\"\"\"\n        return String(self._value[::-1])\n\n    def get_value(self) -> str:\n        \"\"\"Returns the raw string value contained within the object.\"\"\"\n        return self._value\n\n    def __eq__(self, other) -> bool:\n        if not isinstance(other, String):\n            return NotImplemented\n        return self._value == other._value\n\n    def __repr__(self) -> str:\n        return f\"String('{self._value}')\"\nclass StringList:\n    \"\"\"Manages a collection of String objects and orchestrates the reversal of all contained strings.\"\"\"\n    def __init__(self, string_values: List[str]):\n        self._strings: List[String] = [String(value) for value in string_values]\n\n    def add_string(self, value: str):\n        \"\"\"Adds a new raw string value to the list, converting it to a String object.\"\"\"\n        self._strings.append(String(value))\n\n    def get_reversed_strings(self) -> List[str]:\n        \"\"\"Iterates through its String objects, reverses each, and returns a new list of the reversed string values.\"\"\"\n        reversed_values_list: List[str] = []\n        for string_obj in self._strings:\n            reversed_string_obj = string_obj.reverse()\n            reversed_values_list.append(reversed_string_obj.get_value())\n        return reversed_values_list\n\n    def __eq__(self, other) -> bool:\n        if not isinstance(other, StringList):\n            return NotImplemented\n        return self._strings == other._strings\n\n    def __repr__(self) -> str:\n        return f\"StringList({self._strings})\"\ndef reverse_string_list(input_list: List[str]) -> List[str]:\n    \"\"\"\n    Reverses each string in the provided list and returns a new list containing the reversed strings.\n    This function uses domain-specific StringList and String classes for processing.\n    \"\"\"\n    string_list_manager = StringList(input_list)\n    return string_list_manager.get_reversed_strings()"}
{"task_id": "Mbpp/457", "solution": "def Find_Min(list_of_lists: list[list]) -> list | None:\n    \"\"\"\n    Finds the sublist with the minimum length from a given list of lists.\n    Returns None if the input list_of_lists is empty.\n    \"\"\"\n    if not list_of_lists:\n        return None\n\n    min_length = float('inf')\n    min_length_sublist = None\n\n    for sublist in list_of_lists:\n        current_length = len(sublist)\n        if current_length < min_length:\n            min_length = current_length\n            min_length_sublist = sublist\n\n    return min_length_sublist"}
{"task_id": "Mbpp/458", "solution": "import math\nclass InputValidator:\n    \"\"\"Provides static methods for validating numerical inputs.\"\"\"\n    @staticmethod\n    def validate_dimension(value: float, name: str) -> None:\n        \"\"\"Validates if a dimension value is a non-negative float.\"\"\"\n        if not isinstance(value, (int, float)):\n            raise ValueError(f\"{name} must be a number.\")\n        if value < 0:\n            raise ValueError(f\"{name} must be a non-negative number.\")\nclass Rectangle:\n    \"\"\"Represents a rectangle and calculates its area.\"\"\"\n\n    def __init__(self, length: float, width: float):\n        InputValidator.validate_dimension(length, \"Length\")\n        InputValidator.validate_dimension(width, \"Width\")\n        self._length = length\n        self._width = width\n\n    @property\n    def length(self) -> float:\n        return self._length\n\n    @length.setter\n    def length(self, value: float):\n        InputValidator.validate_dimension(value, \"Length\")\n        self._length = value\n\n    @property\n    def width(self) -> float:\n        return self._width\n\n    @width.setter\n    def width(self, value: float):\n        InputValidator.validate_dimension(value, \"Width\")\n        self._width = value\n\n    def calculate_area(self) -> float:\n        \"\"\"Calculates the area of the rectangle.\"\"\"\n        return self._length * self._width\ndef rectangle_area(length: float, width: float) -> float:\n    \"\"\"Calculates the area of a rectangle given its length and width.\"\"\"\n    rectangle = Rectangle(length, width)\n    return rectangle.calculate_area()"}
{"task_id": "Mbpp/459", "solution": "def remove_uppercase(input_string: str) -> str:\n    \"\"\"\n    Removes all uppercase characters from the input string.\n    Preserves the relative order of remaining characters.\n    \"\"\"\n    result_chars = []\n    for char in input_string:\n        if not char.isupper():\n            result_chars.append(char)\n    return ''.join(result_chars)"}
