{"task_id": "Mbpp/603", "solution": "from typing import List\ndef get_ludic(n: int) -> List[int]:\n    \"\"\"\n    Calculates all Ludic numbers less than or equal to n using a sieve method.\n    Ludic numbers are generated by starting with a list of natural numbers\n    and iteratively removing every p-th element, where p is the next Ludic number.\n    \"\"\"\n    if n < 1:\n        return []\n\n    candidates = list(range(1, n + 1))\n    ludic_numbers = []\n\n    while candidates:\n        p = candidates.pop(0)\n        ludic_numbers.append(p)\n\n        if p == 1:\n            # The first Ludic number (1) does not remove any subsequent elements\n            # in the standard sieve for Ludic numbers.\n            continue\n\n        next_candidates = []\n        count = 0\n        for x in candidates:\n            count += 1\n            if count % p != 0:\n                next_candidates.append(x)\n        candidates = next_candidates\n\n    return ludic_numbers"}
{"task_id": "Mbpp/604", "solution": "class Word:\n    \"\"\"Encapsulates a single word's string value.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n\n    def get_value(self) -> str:\n        \"\"\"Returns the string value of the word.\"\"\"\n        return self._value\nclass String:\n    \"\"\"Manages string content, providing methods to split into Word objects and join Word objects back into a string.\"\"\"\n    def __init__(self, content: str):\n        self._content = content\n\n    def split_into_words(self) -> list[Word]:\n        \"\"\"Splits the internal string content into a list of Word objects using spaces as delimiters.\"\"\"\n        word_strings = self._content.split(' ')\n        return [Word(ws) for ws in word_strings if ws] # Filter out empty strings from multiple spaces\n\n    @staticmethod\n    def join_words(words: list[Word]) -> 'String':\n        \"\"\"Joins a list of Word objects into a new String object, separated by single spaces.\"\"\"\n        word_values = [word.get_value() for word in words]\n        return String(' '.join(word_values))\n\n    def get_content(self) -> str:\n        \"\"\"Returns the raw string content.\"\"\"\n        return self._content\ndef reverse_words(input_string: str) -> str:\n    \"\"\"Reverses the order of words in a given string.\"\"\"\n    # Create a String object from the input.\n    input_string_obj = String(input_string)\n    \n    # Split the String object into a list of Word objects.\n    list_of_word_objects = input_string_obj.split_into_words()\n    \n    # Reverse the order of the list of Word objects.\n    list_of_word_objects.reverse() # In-place reversal\n    \n    # Join the reversed list of Word objects back into a new String object.\n    output_string_obj = String.join_words(list_of_word_objects)\n    \n    # Return the content of the output String object.\n    return output_string_obj.get_content()"}
{"task_id": "Mbpp/605", "solution": "import math\ndef prime_num(n: int) -> bool:\n    \"\"\"\n    Determines if a given integer is a prime number.\n    Returns True if n is a prime number, False otherwise.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n\n    # Check for divisibility from 3 up to sqrt(n) with a step of 2.\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        if n % i == 0:\n            return False\n\n    return True"}
