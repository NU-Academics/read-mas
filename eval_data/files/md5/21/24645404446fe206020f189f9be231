{"task_id": "Mbpp/748", "solution": "def capital_words_spaces(input_string: str) -> str:\n    \"\"\"\n    Inserts spaces before each uppercase letter that is not the first character of the string.\n\n    Args:\n        input_string (str): The string to process.\n\n    Returns:\n        str: The modified string with spaces inserted.\n    \"\"\"\n    if not input_string:\n        return \"\"\n\n    result_chars = [input_string[0]]\n    for char in input_string[1:]:\n        if char.isupper():\n            result_chars.append(\" \")\n        result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/745", "solution": "def divisible_by_digits(startnum: int, endnum: int) -> list[int]:\n    \"\"\"\n    Finds numbers within a given range where every number is divisible by every digit it contains.\n    Numbers containing '0' are not considered self-divisible based on provided examples.\n    \"\"\"\n\n    def _get_digits(number: int) -> list[int]:\n        \"\"\"Extracts individual digits from an integer and returns them as a list.\"\"\"\n        return [int(d) for d in str(number)]\n\n    def _is_self_divisible(number: int) -> bool:\n        \"\"\"Checks if a number is divisible by all its non-zero digits, disqualifying numbers containing '0'.\"\"\"\n        digits = _get_digits(number)\n        for digit in digits:\n            if digit == 0:\n                return False  # Numbers containing '0' are not self-divisible.\n            if number % digit != 0:\n                return False\n        return True\n\n    result = []\n    for num in range(startnum, endnum + 1):\n        if _is_self_divisible(num):\n            result.append(num)\n    return result"}
