{"task_id": "Mbpp/56", "solution": "def _calculate_reverse(number: int) -> int:\n    \"\"\"\n    Calculates the reverse of an integer number.\n    Handles both positive and negative numbers by reversing the absolute value.\n    \"\"\"\n    s = str(abs(number))\n    reversed_s = s[::-1]\n    reversed_num = int(reversed_s)\n    return reversed_num if number >= 0 else -reversed_num\ndef check(number: int) -> bool:\n    \"\"\"\n    Checks if a given number is one less than twice its reverse.\n    Uses a helper function to calculate the reverse.\n    \"\"\"\n    reversed_number = _calculate_reverse(number)\n    return number == (2 * reversed_number) - 1"}
{"task_id": "Mbpp/12", "solution": "class Row:\n    \"\"\"Encapsulates a single row of a matrix and provides its sum calculation.\"\"\"\n    def __init__(self, elements: list[int]):\n        self._elements = elements\n        self._sum = sum(elements)\n\n    def get_elements(self) -> list[int]:\n        \"\"\"Returns the elements of the row.\"\"\"\n        return self._elements\n\n    def calculate_sum(self) -> int:\n        \"\"\"Returns the sum of the row's elements.\"\"\"\n        return self._sum\ndef sort_matrix(matrix: list[list[int]]) -> list[list[int]]:\n    \"\"\"Sorts the rows of a given matrix in ascending order based on their sums.\"\"\"\n    row_objects = [Row(row_data) for row_data in matrix]\n    row_objects.sort(key=lambda row: row.calculate_sum())\n\n    sorted_matrix = [row.get_elements() for row in row_objects]\n    return sorted_matrix"}
