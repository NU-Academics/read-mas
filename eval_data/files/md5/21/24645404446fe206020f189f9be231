{"task_id": "Mbpp/607", "solution": "import re\ndef find_literals(text: str, pattern: str) -> tuple[str, int, int] | None:\n    \"\"\"Searches a string for a regex pattern. Returns a tuple (matched_substring, start_index, end_index) if a match is found.\"\"\"\n    match = re.search(pattern, text)\n    if match:\n        return (match.group(0), match.start(), match.end())\n    return None"}
{"task_id": "Mbpp/608", "solution": "def _combinations(n: int, k: int) -> int:\n    \"\"\"Calculates the binomial coefficient \"n choose k\".\"\"\"\n    if k < 0 or k > n:\n        return 0\n    if k == 0 or k == n:\n        return 1\n    if k > n // 2:\n        k = n - k\n\n    res = 1\n    for i in range(k):\n        res = res * (n - i) // (i + 1)\n    return res\ndef bell_Number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Bell number using dynamic programming based on the recurrence relation.\n    B(n) = sum(k=0 to n-1) of (n-1 choose k) * B(k) for n > 0, and B(0) = 1.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    bell_numbers = [0] * (n + 1)\n    bell_numbers[0] = 1\n\n    for i in range(1, n + 1):\n        current_bell = 0\n        for k in range(i):\n            current_bell += _combinations(i - 1, k) * bell_numbers[k]\n        bell_numbers[i] = current_bell\n\n    return bell_numbers[n]"}
{"task_id": "Mbpp/610", "solution": "def remove_kth_element(input_list: list, k: int) -> list:\n    \"\"\"\n    Removes the k-th (1-based) element from a list and returns a new list.\n    Ensures the original list is not modified.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"input_list must be a list\")\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an integer\")\n\n    zero_based_index = k - 1\n\n    if not (0 <= zero_based_index < len(input_list)):\n        raise IndexError(f\"k ({k}) is out of bounds for list of size {len(input_list)}\")\n\n    return input_list[:zero_based_index] + input_list[zero_based_index + 1:]"}
{"task_id": "Mbpp/611", "solution": "def _get_column_elements(matrix: list[list[int]], n: int) -> list[int]:\n    \"\"\"Extracts all elements for a given column index from the matrix.\n    Returns a list of integers representing the elements of the specified column.\n    \"\"\"\n    return [row[n] for row in matrix]\ndef max_of_nth(matrix: list[list[int]], n: int) -> int:\n    \"\"\"Calculates the maximum value of the n'th column in a matrix.\n    Returns the maximum integer value in the specified column.\n    \"\"\"\n    column_elements = _get_column_elements(matrix, n)\n    return max(column_elements)"}
