{"task_id": "Mbpp/61", "solution": "def _calculate_digit_sum(s: str) -> int:\n    \"\"\"\n    Calculates the sum of numeric characters in a string, ignoring non-digit characters.\n    \"\"\"\n    total_sum = 0\n    for char in s:\n        if char.isdigit():\n            total_sum += int(char)\n    return total_sum\ndef count_Substrings(input_string: str) -> int:\n    \"\"\"\n    Counts the number of substrings in the given input_string where the sum of\n    the digits in each substring equals the substring's length.\n    \"\"\"\n    valid_substring_count = 0\n    n = len(input_string)\n\n    for i in range(n):\n        for j in range(i, n):\n            current_substring = input_string[i : j + 1]\n            substring_length = len(current_substring)\n            digit_sum = _calculate_digit_sum(current_substring)\n\n            if digit_sum == substring_length:\n                valid_substring_count += 1\n\n    return valid_substring_count"}
{"task_id": "Mbpp/62", "solution": "def smallest_num(numbers: list[int | float]) -> int | float:\n    \"\"\"\n    Identifies and returns the smallest number from a given list of numerical values.\n    Raises ValueError if the input list is empty.\n    \"\"\"\n    if not numbers:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    smallest_value = numbers[0]\n\n    for number in numbers[1:]:\n        if number < smallest_value:\n            smallest_value = number\n\n    return smallest_value"}
