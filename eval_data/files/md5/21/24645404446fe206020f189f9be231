{"task_id": "Mbpp/445", "solution": "def index_multiplication(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Performs index-wise multiplication of elements in two nested tuples.\n    It raises ValueError for incompatible structures or TypeError for non-numeric elements.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Input tuples must have the same number of inner tuples.\")\n\n    result_outer_list = []\n    for inner_tuple1, inner_tuple2 in zip(tuple1, tuple2):\n        if len(inner_tuple1) != len(inner_tuple2):\n            raise ValueError(\"Inner tuples at corresponding positions must have the same length.\")\n\n        result_inner_list = []\n        for element1, element2 in zip(inner_tuple1, inner_tuple2):\n            if not isinstance(element1, (int, float)) or not isinstance(element2, (int, float)):\n                raise TypeError(\"Elements in inner tuples must be numeric.\")\n            product = element1 * element2\n            result_inner_list.append(product)\n        result_outer_list.append(tuple(result_inner_list))\n    return tuple(result_outer_list)"}
{"task_id": "Mbpp/446", "solution": "def count_Occurrence(input_tuple: tuple, search_list: list) -> int:\n    \"\"\"\n    Counts the total occurrences of elements from search_list within input_tuple.\n    It iterates through the tuple and increments a counter if an element is found in the search list.\n    \"\"\"\n    total_count = 0\n    for element_in_tuple in input_tuple:\n        if element_in_tuple in search_list:\n            total_count += 1\n    return total_count"}
{"task_id": "Mbpp/447", "solution": "def cube_nums(numbers: list) -> list:\n    \"\"\"Calculates the cube of each individual element in a list of numbers.\n    It returns a new list containing the cubed values, preserving the original order.\n    \"\"\"\n    cubed_numbers = []\n    for num in numbers:\n        cubed_numbers.append(num * num * num)\n    return cubed_numbers"}
{"task_id": "Mbpp/448", "solution": "def cal_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of Perrin numbers from P(0) up to P(n), inclusive.\n    Uses a helper function with memoization for efficient Perrin number generation.\n    \"\"\"\n    memo = {}\n\n    def _calculate_perrin_number(index: int) -> int:\n        \"\"\"\n        Recursively calculates a single Perrin number P(index) using memoization.\n        \"\"\"\n        if index in memo:\n            return memo[index]\n        if index == 0:\n            return 3\n        if index == 1:\n            return 0\n        if index == 2:\n            return 2\n        \n        result = _calculate_perrin_number(index - 2) + _calculate_perrin_number(index - 3)\n        memo[index] = result\n        return result\n\n    total_sum = 0\n    for i in range(n + 1):\n        total_sum += _calculate_perrin_number(i)\n    return total_sum"}
