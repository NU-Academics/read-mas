{"task_id": "Mbpp/630", "solution": "def get_coordinates(coordinate: tuple[int, int]) -> list[list[int]]:\n    \"\"\"\n    Extracts all adjacent coordinates of the given coordinate tuple, including itself.\n    Adjacency is defined as x-1 <= x' <= x+1 and y-1 <= y' <= y+1.\n    \"\"\"\n    x, y = coordinate\n    adjacent_coords = []\n    for dx in range(-1, 2):  # -1, 0, 1\n        for dy in range(-1, 2):  # -1, 0, 1\n            adjacent_coords.append([x + dx, y + dy])\n    return adjacent_coords"}
{"task_id": "Mbpp/631", "solution": "def replace_spaces(input_string: str) -> str:\n    \"\"\"\n    Replaces whitespaces with underscores and vice versa in a string.\n    Handles various whitespace characters like space, tab, and newline.\n    \"\"\"\n    result_chars = []\n    for char in input_string:\n        if char.isspace():\n            result_chars.append('_')\n        elif char == '_':\n            result_chars.append(' ')\n        else:\n            result_chars.append(char)\n    return ''.join(result_chars)"}
{"task_id": "Mbpp/632", "solution": "def move_zero(input_list: list) -> list:\n    \"\"\"\n    Moves all zero elements to the end of the given list while preserving\n    the relative order of non-zero elements.\n    \"\"\"\n    non_zero_elements = []\n    zero_count = 0\n\n    for element in input_list:\n        if element == 0:\n            zero_count += 1\n        else:\n            non_zero_elements.append(element)\n\n    non_zero_elements.extend([0] * zero_count)\n\n    return non_zero_elements"}
{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(numbers: list[int], n: int) -> int:\n    \"\"\"Calculates the sum of XOR of all unique pairs of numbers in the given list.\"\"\"\n    total_xor_sum = 0\n    # Iterate through all unique pairs of numbers (numbers[i], numbers[j]).\n    for i in range(n):\n        for j in range(i + 1, n):\n            total_xor_sum += (numbers[i] ^ numbers[j])\n    return total_xor_sum"}
{"task_id": "Mbpp/635", "solution": "from typing import List, TypeVar, Any\nComparable = TypeVar('Comparable', bound=Any)\ndef heap_sort(input_list: List[Comparable]) -> List[Comparable]:\n    \"\"\"\n    Sorts a list of comparable elements in ascending order using the heap sort algorithm.\n    Returns a new list without modifying the original input_list.\n    \"\"\"\n    def _swap(arr: List[Comparable], i: int, j: int) -> None:\n        \"\"\"Swaps two elements at specified indices within a list.\"\"\"\n        arr[i], arr[j] = arr[j], arr[i]\n\n    def _heapify(arr: List[Comparable], n: int, i: int) -> None:\n        \"\"\"Restores the max-heap property in a subtree rooted at index `i`.\"\"\"\n        largest = i  # Initialize largest as root\n        left_child = 2 * i + 1\n        right_child = 2 * i + 2\n\n        # See if left child of root exists and is greater than root\n        if left_child < n and arr[largest] < arr[left_child]:\n            largest = left_child\n\n        # See if right child of root exists and is greater than current largest\n        if right_child < n and arr[largest] < arr[right_child]:\n            largest = right_child\n\n        # Change root, if needed\n        if largest != i:\n            _swap(arr, i, largest)\n            # Heapify the root.\n            _heapify(arr, n, largest)\n\n    n = len(input_list)\n    # Create a mutable copy of the input list.\n    arr_copy = list(input_list)\n\n    # Build a max-heap (rearrange array)\n    for i in range(n // 2 - 1, -1, -1):\n        _heapify(arr_copy, n, i)\n\n    # One by one extract elements\n    for i in range(n - 1, 0, -1):\n        # Move current root to end\n        _swap(arr_copy, i, 0)\n        # call max heapify on the reduced heap\n        _heapify(arr_copy, i, 0)\n    \n    return arr_copy"}
