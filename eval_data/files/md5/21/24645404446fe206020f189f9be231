{"task_id": "Mbpp/391", "solution": "def convert_list_dictionary(ids: list[str], names: list[str], scores: list[int]) -> list[dict[str, dict[str, int]]]:\n    \"\"\"\n    Converts three input lists (student IDs, names, scores) into a list of nested dictionaries.\n    Each dictionary in the output list represents a single student record: {'StudentID': {'StudentName': Score}}.\n    \"\"\"\n    if not (len(ids) == len(names) == len(scores)):\n        raise ValueError(\"Input lists must have the same length.\")\n\n    result = []\n    for i in range(len(ids)):\n        student_id = ids[i]\n        student_name = names[i]\n        score = scores[i]\n        record = {student_id: {student_name: score}}\n        result.append(record)\n    return result"}
{"task_id": "Mbpp/392", "solution": "class MaxSumCalculator:\n    \"\"\"Calculates the maximum sum for a given integer n with memoization.\"\"\"\n\n    def __init__(self):\n        \"\"\"Initializes the calculator with an empty memoization cache.\"\"\"\n        self._memo: dict[int, int] = {}\n\n    def calculate(self, n: int) -> int:\n        \"\"\"\n        Computes the maximum sum for n using the equation\n        f(n) = max((f(n/2) + f(n/3) + f(n/4) + f(n/5)), n).\n        \"\"\"\n        if n <= 1:\n            return n\n\n        if n in self._memo:\n            return self._memo[n]\n\n        sum_of_parts = (\n            self.calculate(n // 2) +\n            self.calculate(n // 3) +\n            self.calculate(n // 4) +\n            self.calculate(n // 5)\n        )\n\n        result = max(sum_of_parts, n)\n        self._memo[n] = result\n        return result\ndef get_max_sum(n: int) -> int:\n    \"\"\"\n    Public interface to calculate the maximum sum for a given integer n.\n    Initializes a new MaxSumCalculator for each call to ensure a fresh cache.\n    \"\"\"\n    calculator = MaxSumCalculator()\n    return calculator.calculate(n)"}
