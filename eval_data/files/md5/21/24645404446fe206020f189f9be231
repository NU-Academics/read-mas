{"task_id": "Mbpp/554", "solution": "def Split(numbers: list[int]) -> list[int]:\n    \"\"\"\n    Filters a list of integers and returns a new list containing only the odd numbers.\n\n    Args:\n        numbers: A list of integers.\n\n    Returns:\n        A new list containing only the odd integers from the input list, preserving order.\n    \"\"\"\n    result = []\n    for num in numbers:\n        if num % 2 != 0:\n            result.append(num)\n    return result"}
{"task_id": "Mbpp/555", "solution": "def calculate_sum_of_cubes(n: int) -> int:\n    \"\"\"Calculates the sum of the cubes of the first n natural numbers.\"\"\"\n    sum_cubes = 0\n    for i in range(1, n + 1):\n        sum_cubes += i ** 3\n    return sum_cubes\ndef calculate_sum_of_naturals(n: int) -> int:\n    \"\"\"Calculates the sum of the first n natural numbers.\"\"\"\n    sum_naturals = 0\n    for i in range(1, n + 1):\n        sum_naturals += i\n    return sum_naturals\ndef difference(n: int) -> int:\n    \"\"\"\n    Finds the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers.\n    \"\"\"\n    sum_cubes = calculate_sum_of_cubes(n)\n    sum_naturals = calculate_sum_of_naturals(n)\n    return sum_cubes - sum_naturals"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(numbers: list[int], length: int) -> int:\n    \"\"\"\n    Counts the number of pairs in a list whose bitwise XOR value is odd.\n    An XOR value is odd if and only if one number is odd and the other is even.\n    \"\"\"\n    odd_count = 0\n    even_count = 0\n\n    for num in numbers:\n        if num % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return odd_count * even_count"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input_string: str) -> str:\n    \"\"\"\n    Toggles the case of all alphabetic characters in the input string.\n    Non-alphabetic characters remain unchanged.\n    \"\"\"\n    toggled_chars = [\n        (char.lower() if char.isupper() else char.upper()) if char.isalpha() else char\n        for char in input_string\n    ]\n    return \"\".join(toggled_chars)"}
{"task_id": "Mbpp/558", "solution": "class Digit:\n    \"\"\"Represents a single digit's value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\nclass Number:\n    \"\"\"Encapsulates an integer and provides a method to extract its digits.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def get_digits(self) -> list[Digit]:\n        \"\"\"Converts the encapsulated integer into a list of Digit objects.\"\"\"\n        if self._value == 0:\n            return [Digit(0)]\n\n        digits = []\n        temp_value = self._value\n        while temp_value > 0:\n            digits.append(Digit(temp_value % 10))\n            temp_value //= 10\n        \n        # Return digits in natural order (most significant first)\n        return digits[::-1]\ndef digit_distance_nums(num1: int, num2: int) -> int:\n    \"\"\"\n    Calculates the sum of per-digit absolute differences between two input integers.\n    The function conceptually pads the shorter number with leading zeros.\n    \"\"\"\n    number_obj1 = Number(num1)\n    number_obj2 = Number(num2)\n\n    digits1 = number_obj1.get_digits()\n    digits2 = number_obj2.get_digits()\n\n    max_len = max(len(digits1), len(digits2))\n    total_diff = 0\n\n    for k in range(max_len):\n        # Determine the value of the k-th digit from the right (least significant)\n        digit1_val = 0\n        if k < len(digits1):\n            digit1_val = digits1[len(digits1) - 1 - k].value\n        \n        digit2_val = 0\n        if k < len(digits2):\n            digit2_val = digits2[len(digits2) - 1 - k].value\n        \n        total_diff += abs(digit1_val - digit2_val)\n\n    return total_diff"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(numbers: list[int], length: int) -> int:\n    \"\"\"\n    Finds the sum of the largest contiguous sublist in the given list.\n    \"\"\"\n    if not numbers or length == 0:\n        return 0\n\n    max_so_far = numbers[0]\n    current_max = numbers[0]\n\n    for i in range(1, length):\n        current_max = max(numbers[i], current_max + numbers[i])\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
{"task_id": "Mbpp/560", "solution": "def union_elements(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Computes the union of elements from two tuples and returns them sorted.\n\n    Args:\n        tuple1 (tuple): The first input tuple.\n        tuple2 (tuple): The second input tuple.\n\n    Returns:\n        tuple: A new tuple containing the sorted union of elements.\n    \"\"\"\n    set_union = set(tuple1).union(set(tuple2))\n    sorted_list = sorted(list(set_union))\n    return tuple(sorted_list)"}
