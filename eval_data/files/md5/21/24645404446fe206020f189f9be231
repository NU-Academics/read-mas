{"task_id": "Mbpp/426", "solution": "class Number:\n    \"\"\"Represents an integer value and determines if it is odd.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def isOdd(self) -> bool:\n        \"\"\"Returns True if the number is odd, False otherwise.\"\"\"\n        return self._value % 2 != 0\n\n    def get_value(self) -> int:\n        \"\"\"Returns the encapsulated integer value.\"\"\"\n        return self._value\nclass NumberList:\n    \"\"\"Manages a collection of Number objects and provides filtering.\"\"\"\n    def __init__(self, numbers: list[int]):\n        self._numbers = [Number(val) for val in numbers]\n\n    def filterOddNumbers(self) -> 'NumberList':\n        \"\"\"Filters out even numbers, returning a new NumberList of odd numbers.\"\"\"\n        odd_numbers_values = [num.get_value() for num in self._numbers if num.isOdd()]\n        return NumberList(odd_numbers_values)\n\n    def to_int_list(self) -> list[int]:\n        \"\"\"Converts the internal list of Number objects back into a standard list of integers.\"\"\"\n        return [num.get_value() for num in self._numbers]\ndef filter_oddnumbers(input_list: list[int]) -> list[int]:\n    \"\"\"\n    Filters odd numbers from a list of integers.\n    \"\"\"\n    number_list_instance = NumberList(input_list)\n    odd_number_list = number_list_instance.filterOddNumbers()\n    return odd_number_list.to_int_list()"}
{"task_id": "Mbpp/427", "solution": "class Date:\n    \"\"\"Represents date components (year, month, day) and provides formatting.\"\"\"\n    def __init__(self, year: str, month: str, day: str):\n        self.year = year\n        self.month = month\n        self.day = day\n\n    def to_dd_mm_yyyy(self) -> str:\n        \"\"\"Formats the date into 'dd-mm-yyyy' format.\"\"\"\n        return f\"{self.day}-{self.month}-{self.year}\"\ndef change_date_format(date_str: str) -> str:\n    \"\"\"Converts a date string from 'yyyy-mm-dd' format to 'dd-mm-yyyy' format.\"\"\"\n    year, month, day = date_str.split('-')\n    date_obj = Date(year, month, day)\n    return date_obj.to_dd_mm_yyyy()"}
{"task_id": "Mbpp/428", "solution": "from typing import List, Any\ndef shell_sort(arr: List[Any]) -> List[Any]:\n    \"\"\"\n    Sorts a list of comparable elements in ascending order using the Shell Sort algorithm.\n    The sorting is performed in-place, modifying the input list directly.\n    \"\"\"\n    n = len(arr)\n    gap = n // 2\n\n    while gap > 0:\n        for i in range(gap, n):\n            temp = arr[i]\n            j = i\n            while j >= gap and arr[j - gap] > temp:\n                arr[j] = arr[j - gap]\n                j -= gap\n            arr[j] = temp\n        gap //= 2\n\n    return arr"}
