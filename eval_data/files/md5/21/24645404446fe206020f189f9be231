{"task_id": "Mbpp/128", "solution": "def long_words(n: int, text: str) -> list[str]:\n    \"\"\"\n    Finds words that are strictly longer than n characters from a given text.\n    \"\"\"\n    words = text.split()\n    long_words_list = [word for word in words if len(word) > n]\n    return long_words_list"}
{"task_id": "Mbpp/230", "solution": "def replace_blank(string: str, character: str) -> str:\n    \"\"\"\n    Replaces all blank spaces in the input string with the specified character.\n    Returns the modified string.\n    \"\"\"\n    return string.replace(\" \", character)"}
{"task_id": "Mbpp/429", "solution": "def and_tuples(tuple1: tuple[int, ...], tuple2: tuple[int, ...]) -> tuple[int, ...]:\n    \"\"\"Computes the element-wise bitwise AND of corresponding elements from two input tuples.\n    Returns a new tuple where each element is the result of the bitwise AND operation.\n    \"\"\"\n    return tuple(t1 & t2 for t1, t2 in zip(tuple1, tuple2))"}
{"task_id": "Mbpp/573", "solution": "import collections\nimport math\ndef unique_product(numbers: list) -> int:\n    \"\"\"\n    Calculates the product of unique numbers in a given list.\n    A number is considered unique if it appears exactly once in the list.\n    \"\"\"\n    if not numbers:\n        return 1\n\n    counts = collections.Counter(numbers)\n    unique_nums = [num for num, count in counts.items() if count == 1]\n\n    if not unique_nums:\n        return 1\n\n    product = math.prod(unique_nums)\n    return int(product)"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(main_list: list, sub_list: list) -> bool:\n    \"\"\"\n    Checks if 'sub_list' is a contiguous sublist of 'main_list'.\n    Returns True if sub_list is found as a contiguous sequence in main_list, False otherwise.\n    \"\"\"\n    if not sub_list:\n        return True\n\n    if len(sub_list) > len(main_list):\n        return False\n\n    n = len(main_list)\n    m = len(sub_list)\n\n    for i in range(n - m + 1):\n        if main_list[i:i+m] == sub_list:\n            return True\n\n    return False"}
