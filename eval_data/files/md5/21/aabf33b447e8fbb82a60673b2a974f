{"task_id": "HumanEval/0", "solution": "from typing import List, Iterable\n\n\ndef has_close_elements(numbers: Iterable[float], threshold: float) -> bool:\n    \"\"\"\n    Return ``True`` if any two numbers in *numbers* are closer together\n    than *threshold*, otherwise return ``False``.\n    \n    The function sorts the input sequence and compares each element with\n    its next neighbor.  Sorting gives a **O(n log n)** runtime, while\n    the na\u00efve double\u2011loop approach would be **O(n\u00b2)**.\n    \n    Parameters\n    ----------\n    numbers : Iterable[float]\n        Sequence of numeric values to inspect.\n    threshold : float\n        Distance below which two elements are considered \"close\".\n        A non\u2011negative value is required; negative values will raise\n        a ``ValueError``.\n    \n    Returns\n    -------\n    bool\n        ``True`` if any two numbers are within ``threshold`` of each\n        other, ``False`` otherwise.\n    \n    Examples\n    --------\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    if threshold < 0:\n        raise ValueError(\"Threshold must be non-negative\")\n\n    # Convert to a sorted list for efficient comparison\n    sorted_numbers = sorted(numbers)\n\n    # Early exit for trivial cases\n    if len(sorted_numbers) < 2:\n        return False\n\n    # Compare adjacent elements\n    prev = sorted_numbers[0]\n    for curr in sorted_numbers[1:]:\n        if abs(curr - prev) < threshold:\n            return True\n        prev = curr\n\n    return False\n\n\n# When run as a script, demonstrate the examples in the docstring.\nif __name__ == \"__main__\":\n    import doctest\n    doctest.testmod()\n"}
{"task_id": "HumanEval/1", "solution": "from typing import List\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"Separate balanced parenthesis groups from a string.\n\n    The input string may contain multiple groups of nested parentheses\n    separated by whitespace or other characters.  All whitespace is ignored\n    and each top\u2011level pair of parentheses (and everything inside it) is\n    returned as a separate string.\n\n    Args:\n        paren_string: The raw string containing the parenthesis groups.\n\n    Returns:\n        A list of strings, each string being a balanced group of\n        parentheses.\n\n    Raises:\n        ValueError: If the parentheses are not balanced.\n\n    Examples:\n        >>> separate_paren_groups('( ) (( )) (( )( ))')\n        ['()', '(())', '(()())']\n        >>> separate_paren_groups('()()')\n        ['()', '()']\n    \"\"\"\n    # Remove all whitespace characters to simplify processing.\n    cleaned: str = \"\".join(paren_string.split())\n    if not cleaned:\n        return []\n\n    groups: List[str] = []\n    depth = 0\n    start_index: int | None = None\n\n    for index, char in enumerate(cleaned):\n        if char == \"(\":\n            if depth == 0:\n                # Starting a new group.\n                start_index = index\n            depth += 1\n        elif char == \")\":\n            depth -= 1\n            if depth < 0:\n                raise ValueError(\"Unbalanced parentheses: too many closing brackets.\")\n            if depth == 0 and start_index is not None:\n                # End of a top\u2011level group.\n                groups.append(cleaned[start_index : index + 1])\n                start_index = None\n        else:\n            # The problem statement guarantees only parentheses.\n            # We ignore unexpected characters silently.\n            continue\n\n    if depth != 0:\n        raise ValueError(\"Unbalanced parentheses: missing closing brackets.\")\n\n    return groups"}
{"task_id": "HumanEval/2", "solution": "def truncate_number(number: float) -> float:\n    \"\"\"Return the decimal part of a positive floating point number.\n\n    Args:\n        number (float): A positive floating point number.\n\n    Returns:\n        float: The fractional part of the number.\n    \"\"\"\n    import math\n    return number - math.floor(number)"}
{"task_id": "HumanEval/3", "solution": "from typing import List\n\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\"Detects whether the cumulative balance ever drops below zero.\n\n    The account starts with a balance of zero. Each element of ``operations`` is added\n    to the running total; negative numbers represent withdrawals and positive numbers\n    represent deposits.  As soon as the total becomes negative, the function returns\n    ``True``.  If the loop completes without the balance ever falling below zero,\n    the function returns ``False``.\n\n    Parameters\n    ----------\n    operations : List[int]\n        List of integer operations to apply to the balance.\n\n    Returns\n    -------\n    bool\n        ``True`` if the balance ever drops below zero, otherwise ``False``.\n\n    Examples\n    --------\n    >>> below_zero([1, 2, 3])\n    False\n    >>> below_zero([1, 2, -4, 5])\n    True\n    \"\"\"\n    balance = 0\n    for op in operations:\n        balance += op\n        if balance < 0:\n            return True\n    return False\n"}
{"task_id": "HumanEval/4", "solution": "from typing import List\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\"\n    Calculate the Mean Absolute Deviation (MAD) of a list of numbers.\n\n    MAD = average | x_i - mean |\n\n    Parameters\n    ----------\n    numbers : List[float]\n        The dataset for which to compute the MAD.\n\n    Returns\n    -------\n    float\n        The mean absolute deviation. Returns 0.0 for an empty list.\n\n    Examples\n    --------\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    if not numbers:\n        return 0.0\n\n    mean = sum(numbers) / len(numbers)\n    deviations = [abs(x - mean) for x in numbers]\n    return sum(deviations) / len(deviations)"}
