 def get_month_by_number(self, month: int) -> MonthModel:\n        \"\"\"Retrieves a MonthModel for the given month number.\"\"\"\n        data = self._metadata.get(month)\n        if not data:\n            raise NotFoundError(f\"Month {month} not found\")\n        return MonthModel(number=month, name=data[\"name\"], days=data[\"days\"])\nclass Validator:\n    \"\"\"Utility class for validating input values.\"\"\"\n    def validate_month_number(self, month: int) -> None:\n        \"\"\"Validates if the month is an integer within the range 1-12.\"\"\"\n        if not (1 <= month <= 12):\n            raise ValidationError(f\"Month {month} is out of range (1..12)\")\nclass MonthService:\n    \"\"\"Business logic for checking month properties.\"\"\"\n    def __init__(self, repository: MonthRepository, validator: Validator) -> None:\n        self._repository = repository\n        self._validator = validator\n\n    def has_31_days(self, month: int) -> bool:\n        \"\"\"Checks if the given month number has 31 days.\"\"\"\n        self._validator.validate_month_number(month)\n        m = self._repository.get_month_by_number(month)\n        return m.days == 31\nclass CLIController:\n    \"\"\"Acts as the adapter for CLI and top-level function calls.\"\"\"\n    def __init__(self, service: MonthService) -> None:\n        self._service = service\n\n    def check_monthnumb_number(self, month: int) -> bool:\n        \"\"\"Determines if a month has 31 days.\"\"\"\n        return self._service.has_31_days(month)\ndef check_monthnumb_number(month: int) -> bool:\n    \"\"\"\n    Checks whether the given month number contains 31 days or not.\n    \"\"\"\n    repo = MonthRepository()\n    validator = Validator()\n    service = MonthService(repo, validator)\n    controller = CLIController(service)\n    return controller.check_monthnumb_number(month)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/454": [{"task_id": "Mbpp/454", "solution": "import re\nclass MatcherError(RuntimeError):\n    \"\"\"Exception raised for errors during regex matching or pattern compilation.\"\"\"\n    pass\nclass ServiceError(RuntimeError):\n    \"\"\"Exception raised for errors within the TextMatchService.\"\"\"\n    pass\nclass RegexFactory:\n    \"\"\"Factory for creating compiled regex patterns.\"\"\"\n    DEFAULT_PATTERN_STR = r'\\b\\w*z\\w*\\b'\n    ALPHA_PATTERN_STR = r'\\b[A-Za-z]*z[A-Za-z]*\\b'\n\n    def create_pattern(self, only_alpha: bool=False) -> re.Pattern:\n        \"\"\"\n        Compiles and returns a regex pattern for matching words containing 'z'.\n        The pattern is case-insensitive and unicode-aware.\n        \"\"\"\n        pat = self.ALPHA_PATTERN_STR if only_alpha else self.DEFAULT_PATTERN_STR\n        try:\n            return re.compile(pat, flags=re.IGNORECASE | re.UNICODE)\n        except re.error as e:\n            raise MatcherError(f\"Failed to compile regex pattern: {e}\")\nclass TextMatcher:\n    \"\"\"Performs text matching using a compiled regex pattern.\"\"\"\n    def __init__(self, pattern: re.Pattern) -> None:\n        \"\"\"Initializes the matcher with a compiled regex pattern.\"\"\"\n        if not hasattr(pattern, \"search\"):\n            raise MatcherError(\"Invalid compiled pattern provided: missing 'search' method.\")\n        self._pattern = pattern\n\n    def match(self, text: str) -> bool:\n        \"\"\"\n        Searches the text for a word matching the compiled regex pattern.\n        Returns True if a match is found, False otherwise.\n        \"\"\"\n        try:\n            return self._pattern.search(text) is not None\n        except TypeError as e:\n            # Handles cases where 'text' is not a string or bytes, which re.search would raise.\n            raise MatcherError(f\"Input for regex search must be a string or bytes: {e}\")\n        except re.error as e:\n            raise MatcherError(f\"Regex search failed unexpectedly: {e}\")\nclass TextMatchService:\n    \"\"\"Orchestrates text matching by utilizing a TextMatcher instance.\"\"\"\n    def __init__(self, matcher: TextMatcher) -> None:\n        \"\"\"Initializes the service with a TextMatcher instance.\"\"\"\n        self._matcher = matcher\n\n    def match_text(self, text: str) -> bool:\n        \"\"\"\n        Delegates the text matching operation to the configured TextMatcher.\n        Wraps any exceptions from the matcher into a ServiceError.\n        \"\"\"\n        try:\n            return self._matcher.match(text)\n        except Exception as e:\n            raise ServiceError(f\"An error occurred during text matching: {e}\")\ndef text_match_wordz(text: str, only_alpha: bool=False) -> bool:\n    \"\"\"\n    Checks if the given text contains at least one word that includes the letter 'z' (case-insensitive).\n    An optional 'only_alpha' flag restricts words to alphabetic characters only.\n    \"\"\"\n    factory = RegexFactory()\n    pattern = factory.create_pattern(only_alpha=only_alpha)\n    matcher = TextMatcher(pattern)\n    service = TextMatchService(matcher)\n    return service.match_text(text)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/448": [{"task_id": "Mbpp/448", "solution": "import json\nfrom typing import Dict, Optional, Any\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input values.\"\"\"\n    pass\nclass Validator:\n    \"\"\"Utility for validating input values.\"\"\"\n    def ensure_non_negative_int(self, value: Any) -> int:\n        \"\"\"Ensures the value is a non-negative integer.\"\"\"\n        if value < 0:\n            raise InvalidInputError(\"Input 'n' must be a non-negative integer.\")\n        return value\nclass PerrinRepository:\n    \"\"\"Stores and retrieves Perrin numbers, with optional JSON persistence.\"\"\"\n    def __init__(self, persist_file: Optional[str] = None) -> None:\n        self._cache: Dict[int, int] = {}\n        self._persist_file = persist_file\n        if self._persist_file:\n            self.load()\n\n    def get(self, index: int) -> Optional[int]:\n        \"\"\"Retrieves a Perrin number by index from the cache.\"\"\"\n        return self._cache.get(index)\n\n    def set(self, index: int, value: int) -> None:\n        \"\"\"Stores a Perrin number in the cache.\"\"\"\n        self._cache[index] = value\n\n    def bulk_load(self, mapping: Dict[int, int]) -> None:\n        \"\"\"Loads multiple Perrin numbers into the cache.\"\"\"\n        self._cache.update(mapping)\n\n    def persist(self) -> None:\n        \"\"\"Persists the cache to a JSON file if configured.\"\"\"\n        if not self._persist_file:\n            return\n        try:\n            serializable_cache = {str(k): v for k, v in self._cache.items()}\n            with open(self._persist_file, 'w') as f:\n                json.dump(serializable_cache, f)\n        except IOError:\n            pass # As per design, swallow IO errors\n\n    def load(self) -> None:\n        \"\"\"Loads the cache from a JSON file if configured.\"\"\"\n        if not self._persist_file:\n            return\n        try:\n            with open(self._persist_file, 'r') as f:\n                loaded_data = json.load(f)\n                self._cache.update({int(k): v for k, v in loaded_data.items()})\n        except (IOError, json.JSONDecodeError):\n            self._cache = {} # Reset cache on failure\n            pass # As per design, swallow errors\nclass PerrinCalculator:\n    \"\"\"Computes Perrin numbers and their sums, leveraging a repository for caching.\"\"\"\n    def __init__(self, repository: PerrinRepository) -> None:\n        self._repo = repository\n        self._ensure_bases()\n\n    def _ensure_bases(self) -> None:\n        \"\"\"Ensures the base Perrin values P(0), P(1), P(2) are in the repository.\"\"\"\n        bases = {0: 3, 1: 0, 2: 2}\n        for i, val in bases.items():\n            if self._repo.get(i) is None:\n                self._repo.set(i, val)\n\n    def perrin_value(self, n: int) -> int:\n        \"\"\"Calculates the n-th Perrin number, using and updating the cache.\"\"\"\n        if n < 0:\n            raise InvalidInputError(\"Index 'n' for Perrin number must be non-negative.\")\n\n        cached = self._repo.get(n)\n        if cached is not None:\n            return cached\n\n        # Find the highest index currently in cache to start computing from\n        max_cached_idx = -1\n        if self._repo._cache:\n            max_cached_idx = max(self._repo._cache.keys())\n\n        # Compute iteratively up to n, starting from max(3, highest cached + 1)\n        start_idx = max(3, max_cached_idx + 1)\n\n        for i in range(start_idx, n + 1):\n            val_i_minus_2 = self._repo.get(i - 2)\n            val_i_minus_3 = self._repo.get(i - 3)\n            # Due to iterative computation, these predecessors are guaranteed to be in cache.\n            # Type ignore because mypy might infer Optional[int] but logic ensures non-None.\n            v = val_i_minus_2 + val_i_minus_3 # type: ignore\n            self._repo.set(i, v)\n\n        return self._repo.get(n) # Value for n is now guaranteed to be in cache.\n\n    def sum_up_to(self, n: int) -> int:\n        \"\"\"Calculates the sum of Perrin numbers from P(0) to P(n) inclusive.\"\"\"\n        # This call ensures all Perrin numbers from P(0) to P(n) are computed and cached.\n        self.perrin_value(n)\n\n        total_sum = 0\n        for i in range(n + 1):\n            # All values P(0) through P(n) are guaranteed to be in the cache.\n            # Type ignore because mypy might infer Optional[int] but logic ensures non-None.\n            val = self._repo.get(i) # type: ignore\n            total_sum += val\n        return total_sum\ndef cal_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of Perrin numbers from P(0) to P(n) inclusive.\n    \"\"\"\n    validator = Validator()\n    n = validator.ensure_non_negative_int(n)\n    repo = PerrinRepository()  # Uses in-memory cache by default\n    calc = PerrinCalculator(repo)\n    return calc.sum_up_to(n)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[-5]]}], "Mbpp/453": [{"task_id": "Mbpp/453", "solution": "import math\nfrom typing import Dict\ndef sumofFactors(n: int) -> int:\n    \"\"\"\n    Calculates the sum of even factors of a given number.\n    This implementation uses prime factorization to find the sum of even divisors.\n    \"\"\"\n\n    def _factorize(number: int) -> Dict[int, int]:\n        \"\"\"Returns the prime factorization of a number as a dictionary {prime: exponent}.\"\"\"\n        factors = {}\n        m = number\n        d = 2\n        while d * d <= m:\n            while m % d == 0:\n                factors[d] = factors.get(d, 0) + 1\n                m //= d\n            d += 1 if d == 2 else 2\n        if m > 1:\n            factors[m] = factors.get(m, 0) + 1\n        return factors\n\n    def _sum_of_divisors_from_factors(factors_subset: Dict[int, int]) -> int:\n        \"\"\"Calculates the sum of divisors from a given prime factorization.\"\"\"\n        total = 1\n        for p, e in factors_subset.items():\n            total *= (p**(e + 1) - 1) // (p - 1)\n        return total\n\n    # If the number is 0 or negative, it has no positive factors or even factors.\n    # If the number is 1, its only factor is 1, which is odd.\n    if n <= 1:\n        return 0\n\n    prime_factors = _factorize(n)\n\n    # If 2 is not a prime factor, there are no even divisors\n    if 2 not in prime_factors:\n        return 0\n\n    # Calculate the total sum of all divisors\n    total_sum_divisors = _sum_of_divisors_from_factors(prime_factors)\n\n    # Calculate the sum of odd divisors\n    odd_prime_factors = dict(prime_factors)\n    odd_prime_factors.pop(2, None) # Remove factor 2 to only consider odd divisors\n\n    # If odd_prime_factors is empty, it means the number was a power of 2,\n    # and its only odd divisor is 1. Otherwise, calculate sum from remaining factors.\n    sum_odd_divisors = _sum_of_divisors_from_factors(odd_prime_factors) if odd_prime_factors else 1\n\n    # The sum of even divisors is the total sum of divisors minus the sum of odd divisors\n    return total_sum_divisors - sum_odd_divisors", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/456": [{"task_id": "Mbpp/456", "solution": "from typing import List\ndef reverse_string_list(strings: List[str]) -> List[str]:\n    \"\"\"Reverses each string in a given list of strings.\"\"\"\n    return [s[::-1] for s in strings]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/460": [{"task_id": "Mbpp/460", "solution": "def Extract(data):\n    \"\"\"\n    Extracts the first element from each sublist in a list of lists.\n    Assumes valid input where each sublist is non-empty.\n    \"\"\"\n    result = []\n    for sublist in data:\n        result.append(sublist[0])\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/459": [{"task_id": "Mbpp/459", "solution": "def remove_uppercase(s: str) -> str:\n    \"\"\"\n    Removes all uppercase characters from a given string.\n    This effectively removes any contiguous uppercase substrings by filtering out each uppercase character.\n    \"\"\"\n    out_chars = []\n    for char_code in s:\n        if not char_code.isupper():\n            out_chars.append(char_code)\n    return \"\".join(out_chars)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["ThiS%^%!s&a(mY)TesTStR%i*ng"]]}], "Mbpp/458": [{"task_id": "Mbpp/458", "solution": "import math\nclass InvalidDimensionError(Exception):\n    \"\"\"Exception raised for invalid rectangle dimensions.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\ndef parse_non_negative_number(value: any) -> float:\n    \"\"\"Coerces input to float, ensuring it's finite and non-negative.\"\"\"\n    try:\n        v = float(value)\n    except (TypeError, ValueError):\n        raise InvalidDimensionError(f\"not a number: {value!r}\")\n    if not math.isfinite(v):\n        raise InvalidDimensionError(f\"must be finite: {value!r}\")\n    if v < 0:\n        raise InvalidDimensionError(f\"must be non-negative: {v}\")\n    return v\ndef rectangle_area(length, width):\n    \"\"\"\n    Calculates the area of a rectangle given its length and width.\n    Length and width must be finite, non-negative numbers.\n    \"\"\"\n    validated_length = parse_non_negative_number(length)\n    validated_width = parse_non_negative_number(width)\n    return validated_length * validated_width", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[1000000000000, 1000000000000]]}], "Mbpp/450": [{"task_id": "Mbpp/450", "solution": "def extract_string(string_list, size):\n    \"\"\"\n    Extracts strings of a specified length from a given list of string values.\n    Strings are filtered based on exact length equality.\n    \"\"\"\n    return [s for s in string_list if len(s) == size]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/463": [{"task_id": "Mbpp/463", "solution": "from typing import Sequence, List, Union\nimport math\nNumber = Union[float, int]\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input to array processing functions.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass ArrayInput:\n    \"\"\"Encapsulates input array validation and normalized view.\"\"\"\n    def __init__(self, values: Sequence[Number]) -> None:\n        self.values: List[Number] = list(values)\n        self.validate()\n\n    def validate(self) -> None:\n        \"\"\"Ensures the array is non-empty and contains only finite numbers.\"\"\"\n        if not self.values:\n            raise InvalidInputError(\"Input array cannot be empty.\")\n        for i, val in enumerate(self.values):\n            if not isinstance(val, (int, float)):\n                raise InvalidInputError(f\"Array element at index {i} is not a number: {val}\")\n            if isinstance(val, float) and (math.isnan(val) or math.isinf(val)):\n                raise InvalidInputError(f\"Array element at index {i} is not a finite number: {val}\")\n\n    def as_list(self) -> List[Number]:\n        \"\"\"Returns the validated input array as a list.\"\"\"\n        return self.values\nclass MaxProductResult:\n    \"\"\"Data transfer object for maximum product subarray results.\"\"\"\n    def __init__(self, value: Number, subarray: List[Number] | None = None) -> None:\n        self.value = value\n        self.subarray = subarray\n\n    def to_dict(self) -> dict:\n        \"\"\"Converts the result to a dictionary for serialization.\"\"\"\n        return {\"value\": self.value, \"subarray\": self.subarray}\nclass MaxProductService:\n    \"\"\"Service to compute the maximum product of a contiguous subarray.\"\"\"\n    _EPS = 1e-12  # Numeric tolerance (not used in current core algorithm)\n\n    def compute(self, nums: Sequence[Number]) -> MaxProductResult:\n        \"\"\"\n        Public API to compute the maximum product subarray.\n        Validates input and calls the core algorithm.\n        \"\"\"\n        # ArrayInput handles input validation (non-empty, numeric, finite).\n        arr = ArrayInput(nums).as_list()\n        best_value, best_subarray = self._compute_core(arr)\n        return MaxProductResult(value=best_value, subarray=best_subarray)\n\n    def _compute_core(self, nums: List[Number]) -> tuple[Number, List[Number]]:\n        \"\"\"\n        Core algorithm to find the maximum product subarray in O(n) time.\n        It tracks max_ending, min_ending products and their corresponding start/end indices.\n        \"\"\"\n        # This internal check is a safeguard; ArrayInput should prevent empty arrays.\n        if not nums:\n            raise InvalidInputError(\"Internal error: input array for computation cannot be empty.\")\n\n        max_ending: Number = nums[0]\n        min_ending: Number = nums[0]\n        best: Number = nums[0]\n\n        start: int = 0\n        end: int = 0\n        temp_start: int = 0  # Tracks the start of the current `max_ending` subarray\n\n        for i in range(1, len(nums)):\n            x = nums[i]\n\n            # If the current number is negative, swapping max_ending and min_ending\n            # ensures that when multiplied by x, the new potential max comes from old min, and vice-versa.\n            if x < 0:\n                max_ending, min_ending = min_ending, max_ending\n\n            # Update max_ending: it's either x itself (starting a new subarray)\n            # or the product of x with the previous max_ending.\n            if x > max_ending * x:\n                max_ending = x\n                temp_start = i  # New max_ending subarray starts at this index\n            else:\n                max_ending = max_ending * x\n\n            # Update min_ending: it's either x itself or the product of x with previous min_ending.\n            min_ending = min(x, min_ending * x)\n\n            # Update the overall best product found so far and its subarray indices.\n            if max_ending > best:\n                best = max_ending\n                start = temp_start\n                end = i\n\n        return best, nums[start : end + 1]\ndef max_subarray_product(nums: Sequence[Number]) -> Number:\n    \"\"\"\n    Computes the maximum product of any contiguous subarray within the given array.\n    \"\"\"\n    service = MaxProductService()\n    result = service.compute(nums)\n    return result.value", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "