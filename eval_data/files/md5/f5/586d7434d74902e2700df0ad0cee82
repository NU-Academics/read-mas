: List[int]) -> int:\n        \"\"\"\n        Finds the single unique element using a binary search approach.\n        Assumes input is a sorted list with an odd length, where all but one element appear twice.\n        \"\"\"\n        low, high = 0, len(nums) - 1\n        while low < high:\n            mid = (low + high) // 2\n            if mid % 2 == 1: # Ensure mid is even for consistent pair checking\n                mid -= 1\n            \n            # Check if nums[mid] is part of a pair (nums[mid], nums[mid+1])\n            if mid + 1 < len(nums) and nums[mid] == nums[mid + 1]:\n                low = mid + 2 # Unique element is on the right, skip the pair\n            else:\n                high = mid # Unique element is in the left half, including mid\n        \n        if 0 <= low < len(nums):\n            return nums[low]\n        raise NotFoundError(\"Unique element not found; algorithm logic failed or input invalid.\")\nclass UniqueElementService:\n    \"\"\"Coordinates validation and unique element finding.\"\"\"\n    def __init__(self, validator: Validator = Validator, algorithm: BinarySearchAlgorithm = BinarySearchAlgorithm) -> None:\n        self._validator = validator\n        self._algorithm = algorithm\n\n    def find_unique(self, nums: List[int]) -> int:\n        \"\"\"\n        Validates the input list and then finds the unique element.\n        Raises InvalidInputError for malformed inputs or NotFoundError if no unique element is found.\n        \"\"\"\n        self._validator.validate_non_empty(nums)\n        self._validator.validate_all_ints(nums)\n        self._validator.validate_sorted(nums)\n        \n        if len(nums) % 2 == 0:\n            raise InvalidInputError(\"Input list must have an odd number of elements to guarantee a unique element.\")\n        \n        return self._algorithm.find_unique(nums)\nclass SearchController:\n    \"\"\"Provides the public API interface for finding the unique element.\"\"\"\n    def __init__(self, 