arr[0], arr[end] = arr[end], arr[0]\n            # Reduce the heap size and sift down the new root\n            end -= 1\n            _sift_down(arr, 0, end)\n        return arr\n    except TypeError as e:\n        raise SortException(f\"Incomparable elements found: {e}\")", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/630": [{"task_id": "Mbpp/630", "solution": "def get_coordinates(coordinate_tuple):\n    \"\"\"\n    Extracts all adjacent coordinates, including the given coordinate, in a 3x3 grid.\n    The coordinates are returned in row-major order (top-left to bottom-right).\n    \"\"\"\n    x, y = coordinate_tuple\n    adjacent_coords = []\n    for r_offset in [-1, 0, 1]:\n        for c_offset in [-1, 0, 1]:\n            adjacent_coords.append([x + r_offset, y + c_offset])\n    return adjacent_coords", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[1, 1, 1]]]}], "Mbpp/641": [{"task_id": "Mbpp/641", "solution": "def is_nonagonal(n: int) -> int:\n    \"\"\"\n    Computes the nth nonagonal number using the formula (7*n^2 - 5*n) // 2.\n    Assumes n is a non-negative integer as per design context.\n    \"\"\"\n    return (7 * n * n - 5 * n) // 2", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/720": [{"task_id": "Mbpp/720", "solution": "from typing import Any, Dict, Tuple\ndef add_dict_to_tuple(base: Tuple[Any, ...], extra: Dict[str, Any]) -> Tuple[Any, ...]:\n    \"\"\"Appends a dictionary as a single element to a tuple and returns a new tuple.\"\"\"\n    return base + (extra,)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/643": [{"task_id": "Mbpp/643", "solution": "import re\nimport threading\nfrom abc import ABC, abstractmethod\nfrom typing import List, Tuple\nclass InvalidInputError(ValueError):\n    \"\"\"Exception raised for invalid input parameters.\"\"\"\n    pass\nclass InputTooLargeError(ValueError):\n    \"\"\"Exception raised when input text exceeds the maximum allowed size.\"\"\"\n    pass\nMAX_INPUT_BYTES: int = 10_485_760\nWORD_REGEX: str = r\"[A-Za-z0-9_'-]+\"\nclass TextCheckRequest:\n    \"\"\"Represents input parameters for a text check operation.\"\"\"\n    def __init__(self, text: str, case_sensitive: bool = False):\n        if not isinstance(text, str):\n            raise InvalidInputError(\"Input 'text' must be a string.\")\n        self.text = text\n        self.case_sensitive = case_sensitive\nclass TextCheckResult:\n    \"\"\"Represents the result of a text check operation.\"\"\"\n    def __init__(self, matched: bool, tokens_checked: int):\n        self.matched = matched\n        self.tokens_checked = tokens_checked\nclass Stats:\n    \"\"\"Holds in-memory runtime statistics.\"\"\"\n    def __init__(self, processed_count: int = 0, match_count: int = 0):\n        self.processed_count = processed_count\n        self.match_count = match_count\nclass StatsRepository(ABC):\n    \"\"\"Abstract interface for stats persistence.\"\"\"\n    @abstractmethod\n    def increment_processed(self, count: int = 1) -> None:\n        pass\n\n    @abstractmethod\n    def increment_matches(self, count: int = 1) -> None:\n        pass\n\n    @abstractmethod\n    def get_stats(self) -> Stats:\n        pass\nclass InMemoryStatsRepository(StatsRepository):\n    \"\"\"Simple in-memory counter implementation for statistics.\"\"\"\n    def __init__(self) -> None:\n        self._lock = threading.Lock()\n        self._stats = Stats()\n\n    def increment_processed(self, count: int = 1) -> None:\n        with self._lock:\n            self._stats.processed_count += count\n\n    def increment_matches(self, count: int = 1) -> None:\n        with self._lock:\n            self._stats.match_count += count\n\n    def get_stats(self) -> Stats:\n        with self._lock:\n            return Stats(self._stats.processed_count, self._stats.match_count)\nclass RegexHelper:\n    \"\"\"Provides deterministic tokenization and token-level match logic.\"\"\"\n    WORD_RE = re.compile(WORD_REGEX)\n\n    @staticmethod\n    def tokenize(text: str) -> List[str]:\n        return RegexHelper.WORD_RE.findall(text)\n\n    @staticmethod\n    def token_has_z_middle(token: str, case_sensitive: bool = False) -> bool:\n        \"\"\"Checks if a token contains 'z' (or 'Z') not at its start or end.\"\"\"\n        if len(token) < 3:\n            return False\n        \n        if case_sensitive:\n            return any(ch == 'z' for ch in token[1:-1])\n        else:\n            return 'z' in token.lower()[1:-1]\nclass TextCheckService:\n    \"\"\"Core logic for text checking; enforces input size limits; updates repository.\"\"\"\n    def __init__(self, repo: StatsRepository, max_input_bytes: int = MAX_INPUT_BYTES) -> None:\n        self._repo = repo\n        self._max_input_bytes = max_input_bytes\n\n    def process(self, request: TextCheckRequest) -> TextCheckResult:\n        if not isinstance(request, TextCheckRequest):\n            raise InvalidInputError(\"Request must be an instance of TextCheckRequest.\")\n        \n        text = request.text\n        case_sensitive = request.case_sensitive\n\n        if len(text.encode('utf-8')) > self._max_input_bytes:\n            raise InputTooLargeError(f\"Input text exceeds maximum size of {self._max_input_bytes} bytes.\")\n\n        matched, tokens_checked = self._check_text(text, case_sensitive)\n        \n        self._repo.increment_processed()\n        if matched:\n            self._repo.increment_matches()\n            \n        return TextCheckResult(matched, tokens_checked)\n\n    def _check_text(self, text: str, case_sensitive: bool) -> Tuple[bool, int]:\n        \"\"\"Core scanning logic: tokenizes, iterates tokens, calls RegexHelper.token_has_z_middle.\"\"\"\n        tokens = RegexHelper.tokenize(text)\n        \n        matched = False\n        for token in tokens:\n            if RegexHelper.token_has_z_middle(token, case_sensitive):\n                matched = True\n                break\n\n        return matched, len(tokens)\nclass TextCheckController:\n    \"\"\"Lightweight adapter for callers; constructs request and calls service.\"\"\"\n    def __init__(self, service: TextCheckService) -> None:\n        self._service = service\n\n    def check_text(self, text: str, case_sensitive: bool = False) -> bool:\n        \"\"\"Wraps request creation and delegates to TextCheckService, returning a boolean result.\"\"\"\n        request = TextCheckRequest(text=text, case_sensitive=case_sensitive)\n        result = self._service.process(request)\n        return result.matched\ndef text_match_wordz_middle(text: str, case_sensitive: bool = False) -> bool:\n    \"\"\"\n    Checks if any word in the given text contains 'z' (or 'Z') not at its start or end.\n    Returns True if a match is found, False otherwise.\n    \"\"\"\n    repo = InMemoryStatsRepository()\n    service = TextCheckService(repo)\n    controller = TextCheckController(service)\n    return controller.check_text(text, case_sensitive)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/724": [{"task_id": "Mbpp/724", "solution": "import math\ndef power_base_sum(base: int, power: int) -> int:\n    \"\"\"\n    Calculates the sum of all digits of the base to the specified power.\n    Assumes base and power are non-negative integers.\n    \"\"\"\n    pow_result = base ** power\n    digit_sum = 0\n    # Convert the result to a string and sum its digits\n    for digit_char in str(pow_result):\n        digit_sum += int(digit_char)\n    return digit_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/722": [{"task_id": "Mbpp/722", "solution": "import collections\ndef filter_data(data: dict, min_height: float, min_weight: float) -> dict:\n    \"\"\"\n    Filters a dictionary of stud