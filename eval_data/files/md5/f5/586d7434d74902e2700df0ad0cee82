  def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass IndexOutOfRangeError(IndexError):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass KthRequest:\n    def __init__(self, array: list, k: int) -> None:\n        self.array = array\n        self.k = k\nclass KthResponse:\n    def __init__(self, value: Any) -> None:\n        self.value = value\n    def __repr__(self) -> str:\n        return f\"KthResponse(value={self.value!r})\"\nclass InputValidator:\n    def validate_array(self, array: Any) -> list[Any]:\n        if array is None:\n            raise InvalidInputError(\"array must not be None\")\n        if not isinstance(array, (list, tuple)):\n            raise InvalidInputError(\"array must be a list or tuple\")\n        return list(array)\n\n    def validate_k(self, k: Any, length: int) -> int:\n        if not isinstance(k, int):\n            raise InvalidInputError(\"k must be an integer\")\n        if k < 1 or k > length:\n            raise IndexOutOfRangeError(f\"k must be between 1 and {length}, got {k}\")\n        return k\nclass KthElementService:\n    def __init__(self, validator: Optional[InputValidator] = None) -> None:\n        self._validator = validator or InputValidator()\n\n    def get_kth(self, request: KthRequest) -> KthResponse:\n        arr = self._validator.validate_array(request.array)\n        k = self._validator.validate_k(request.k, len(arr))\n        return KthResponse(arr[k - 1])\ndef kth_element(array: list[Any], k: int) -> Any:\n    \"\"\"\n    Finds the kth element in the given array using 1-based indexing.\n    Raises InvalidInputError if array or k are invalid types, or IndexOutOfRangeError if k is out of bounds.\n    \"\"\"\n    service = KthElementService()\n    req = KthRequest(array=array, k=k)\n    return service.get_kth(req).value", "base_status": "pass", "plus_status": "pass", "base_fail_tests