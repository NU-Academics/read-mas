h.square(validated_radius)\nclass LoggerAdapter:\n    \"\"\"Wraps standard logging for consistent application logging.\"\"\"\n    def __init__(self, name: str = \"sphere_area\") -> None:\n        self._logger = logging.getLogger(name)\n        if not self._logger.handlers:\n            handler = logging.StreamHandler()\n            self._logger.addHandler(handler)\n            self._logger.setLevel(logging.INFO)\n\n    def info(self, msg: str) -> None:\n        self._logger.info(msg)\n\n    def error(self, msg: str) -> None:\n        self._logger.error(msg)\nclass FileRepository:\n    \"\"\"Manages persistence of records to a local JSON file.\"\"\"\n    def __init__(self, path: Union[str, Path]) -> None:\n        self._path = Path(path)\n        if not self._path.exists():\n            self._path.parent.mkdir(parents=True, exist_ok=True)\n            self._path.write_text(\"[]\")\n\n    def save(self, record: dict) -> None:\n        data = json.loads(self._path.read_text())\n        data.append(record)\n        tmp = self._path.with_suffix(\".tmp\")\n        tmp.write_text(json.dumps(data))\n        tmp.replace(self._path)\n\n    def load_all(self) -> List[dict]:\n        return json.loads(self._path.read_text())\nclass SurfaceAreaController:\n    \"\"\"Orchestrates sphere surface area computation and optional result persistence.\"\"\"\n    def __init__(self, service: SurfaceAreaService, logger: LoggerAdapter, repo: Optional[FileRepository]) -> None:\n        self._service = service\n        self._logger = logger\n        self._repo = repo\n\n    def compute_and_optionally_save(self, radius: float, save: bool = False) -> float:\n        area = self._service.surface_area(radius)\n        self._logger.info(f\"Computed area {area} for radius {radius}\")\n        if save and self._repo:\n            rec = {\"timestamp\": datetime.utcnow().isoformat() + \"Z\", \"radius\": float(radius), \"area\": float(area)}\n            try:\n                self._repo.save(rec)\n     