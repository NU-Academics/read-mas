 = None) -> None:\n        self._extractor = extractor or NumericExtractor()\n\n    def find_min(self, values: Iterable[Any], coerce: bool = False) -> float | int:\n        \"\"\"Finds the minimum numeric value in the given iterable.\"\"\"\n        if not is_iterable(values):\n            raise InvalidInputError(\"Provided values is not iterable\")\n        nums = self._extractor.extract_numerics(values, coerce_str=coerce)\n        if not nums:\n            raise NoNumericValueError(\"No numeric values found in input\")\n        return min(nums)\ndef min_val(values: Iterable[Any], coerce: bool = DEFAULT_COERCE) -> float | int:\n    \"\"\"Finds the minimum numeric value in a heterogeneous list.\"\"\"\n    service = MinFinderService()\n    return service.find_min(values, coerce=coerce)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[["Python", 10, 5, 2.5, 2.5, "version"]]]}], "Mbpp/413": [{"task_id": "Mbpp/413", "solution": "def extract_nth_element(tuples, n):\n    \"\"\"\n    Extracts the nth element from each tuple in a given list of tuples.\n    Assumes valid input where each tuple has an element at the specified index.\n    \"\"\"\n    return [t[n] for t in tuples]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/414": [{"task_id": "Mbpp/414", "solution": "from typing import Iterable, Any, Optional, Set, Tuple, List\nclass InvalidSequenceError(Exception):\n    \"\"\"Custom exception for invalid sequence inputs.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass SequenceDTO:\n    \"\"\"A Data Transfer Object for sequence validation and canonical representation.\"\"\"\n    def __init__(self, items: List[Any]) -> None:\n        self.items = items\n\n    @staticmethod\n    def from_iterable(seq: Iterable[Any]) -> 'SequenceDTO':\n        \"\"\"Validates that seq is iterable and converts it to a list.\"\"\"\n        try:\n            lst = list(seq)\n        except TypeError:\n            raise InvalidSequenceError(\"Provided value is not iterable\")\n        return SequenceDTO(lst)\ndef safe_to_set(seq: Iterable[Any]) -> Tuple[Optional[Set[Any]], bool]:\n    \"\"\"Attempts to convert an iterable to a set, returning whether all elements were hashable.\"\"\"\n    s = set()\n    try:\n        for x in seq:\n            s.add(x)\n        return s, True\n    except TypeError:\n        return None, False\ndef overlapping(seq1: Iterable[Any], seq2: Iterable[Any]) -> bool:\n    \"\"\"\n    Checks if any value in seq1 exists in seq2.\n    Uses set membership for hashable items, falls back to nested loops for unhashable items.\n    \"\"\"\n    dto1 = SequenceDTO.from_iterable(seq1)\n    dto2 = SequenceDTO.from_iterable(seq2)\n    a, b = dto1.items, dto2.items\n\n    if len(a) <= len(b):\n        smaller, other = a, b\n    else:\n        smaller, other = b, a\n\n    s, is_hashable = safe_to_set(smaller)\n\n    if is_hashable and s is not None:\n        for x in other:\n            if x in s:\n                return True\n        return False\n    else:\n        # Fallback to O(n*m) comparison for unhashable items or if set conversion failed.\n        for x in smaller:\n            for y in other:\n                if x == y:\n                    return True\n        return False", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/415": [{"task_id": "Mbpp/415", "solution": "from typing import List, Tuple\ndef max_Product(arr: List[int]) -> Tuple[int, int]:\n    \"\"\"\n    Finds a pair of integers from the given array with the highest product.\n    Handles positive, negative numbers, and zeros in linear time O(n).\n    \"\"\"\n    \n    # Helper function for tie-breaking when products are equal.\n    # Prefers the pair with a larger maximum element, then a larger minimum element.\n    def compare_pairs_tiebreak(a: Tuple[int, int], b: Tuple[int, int]) -> int:\n        a_max, a_min = max(a), min(a)\n        b_max, b_min = max(b), min(b)\n\n        if a_max != b_max:\n            return 1 if a_max > b_max else -1\n        if a_min != b_min:\n            return 1 if a_min > b_min else -1\n        return 0\n\n    # Initialize tracking variables for the two largest and two smallest numbers.\n    # Using float('-inf') and float('inf') as sentinels ensures any actual integer\n    # from the array will correctly replace them, given that the input array has\n    # at least two elements and consists of integers.\n    max1 = float('-inf')  # Largest number found\n    max2 = float('-inf')  # Second largest number found\n    min1 = float('inf')   # Smallest number found\n    min2 = float('inf')   # Second smallest number found\n\n    for x in arr:\n        # Update the two largest numbers\n        if x > max1:\n            max2 = max1\n            max1 = x\n        elif x > max2:\n            max2 = x\n\n        # Update the two smallest numbers\n        if x < min1:\n            min2 = min1\n            min1 = x\n        elif x < min2:\n            min2 = x\n\n    # The two candidate pairs for the maximum product are:\n    # 1. The two largest numbers (e.g., 7 * 8 = 56)\n    # 2. The two smallest numbers (if both are negative, their product will be positive, e.g., -10 * -9 = 90)\n    \n    # Cast to int for safety, although for valid inputs they will already be integers\n    # after being replaced by actual array elements.\n    candidate1_pair = (int(max1), int(max2))\n    candidate1_product = candidate1_pair[0] * candidate1_pair[1]\n\n    candidate2_pair = (int(min1), int(min2))\n    candidate2_product = candidate2_pair[0] * candidate2_pair[1]\n\n    # Compare the products of the two candidate pairs.\n    if candidate1_product > candidate2_product:\n        best_pair = candidate1_pair\n    elif candidate2_product > candidate1_product:\n        best_pair = candidate2_pair\n    else:\n        # Products are equal, use the defined