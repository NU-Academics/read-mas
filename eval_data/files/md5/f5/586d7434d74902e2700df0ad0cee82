        return False\n        return True\n\n    all_hashable = True\n    for val in values:\n        if not _is_hashable(val):\n            all_hashable = False\n            break\n\n    if all_hashable:\n        return _check_with_set(values)\n    else:\n        return _check_with_pairwise(values)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/391": [{"task_id": "Mbpp/391", "solution": "def convert_list_dictionary(*lists):\n    \"\"\"\n    Converts multiple parallel lists into a list of nested dictionaries.\n\n    Each item at the same index across the input lists forms a single nested dictionary entry,\n    where the first list's item is the outermost key, subsequent lists' items form nested keys,\n    and the last list's item becomes the final value.\n    \"\"\"\n    if not lists:\n        return []\n\n    num_rows = len(lists[0])\n    result = []\n\n    for i in range(num_rows):\n        # Collect items for the current row across all lists\n        row_items = [lst[i] for lst in lists]\n\n        # The last item is the value, previous items are keys forming the nested structure\n        current_nested_dict = row_items[-1]\n\n        # Build the nested dictionary by iterating backwards through the keys\n        for j in range(len(row_items) - 2, -1, -1):\n            key = row_items[j]\n            current_nested_dict = {key: current_nested_dict}\n        \n        result.append(current_nested_dict)\n\n    return result", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[["S001", "S002", "S003", "S004"], ["Adina Park", "Leyton Marsh", "Duncan Boyle", "Saim Richards"], [[1, 2, 3], [4, 5, 6], {"a": "x", "b": "y", "c": "z"}]]]}], "Mbpp/392": [{"task_id": "Mbpp/392", "solution": "_cache = {}\ndef get_max_sum(n):\n    \"\"\"\n    Computes the maximum sum for a given n using the recurrence relation\n    f(n) = max((f(n/2) + f(n/3) + f(n/4) + f(n/5)), n), with memoization.\n 