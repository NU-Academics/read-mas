ethod\n    def is_hashable(item: Any) -> bool:\n        \"\"\"Checks if an item is hashable.\"\"\"\n        try:\n            hash(item)\n            return True\n        except TypeError:\n            return False\n\n    @staticmethod\n    def fallback_unique_check(items: Sequence[Any]) -> bool:\n        \"\"\"Performs O(n^2) equality-based duplicate detection for unhashable elements.\"\"\"\n        seen = []\n        for x in items:\n            if x in seen:\n                return False\n            seen.append(x)\n        return True\nclass AllUniqueService:\n    def __init__(self, repo: Optional[Any] = None) -> None:\n        \"\"\"Initializes the service with an optional repository.\"\"\"\n        self._repo = repo\n\n    def is_all_unique(self, items: Sequence[Any]) -> bool:\n        \"\"\"Checks if all elements in a sequence are unique, handling hashable and unhashable types.\"\"\"\n        if items is None:\n            raise ValidationError(\"items must not be None\")\n        \n        if not items or len(items) == 1:\n            return True\n\n        try:\n            seen = set()\n            for x in items:\n                if x in seen:\n                    return False\n                seen.add(x)\n            return True\n        except TypeError:\n            return ListUtils.fallback_unique_check(items)\ndef all_unique(items: Sequence[Any]) -> bool:\n    \"\"\"Checks if the elements of a given list are unique or not.\"\"\"\n    return AllUniqueService().is_all_unique(items)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/287": [{"task_id": "Mbpp/287", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of squares of the first n even natural numbers using a closed-form formula.\n    Assumes n is a non-negative integer.\n    \"\"\"\n    if n == 0:\n        return 0\n    # Sum of squares of first n even numbers is sum_{k=1 to n} (2k)^2 = 4 * sum_{k=1 to n} k^2\n    # The sum of the first n squares (sum k^2) is n * (n + 1) * (2 * n + 1) / 6\n    # So the total sum is 4 * (n * (n + 1) * (2 * n + 1) // 6)\n    return 4 * (n * (n + 1) * (2 * n + 1) // 6)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[1000000]]}], "Mbpp/285": [{"task_id": "Mbpp/285", "solution": "import re\ndef text_match_two_three(text: str) -> bool:\n    \"\"\"\n    Checks if a string contains the 'a' character followed by two or three 'b' characters.\n    Uses regex to search for the pattern \"ab{2,3}\" within the input string.\n    \"\"\"\n    pattern = r\"ab{2,3}\"\n    return bool(re.search(pattern, text))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/284": [{"task_id": "Mbpp/284", "solution": "from typing import List, Any\ndef check_element(items: List[Any], element: Any) -> bool:\n    \"\"\"\n    Checks if all items in the given list are equal to the specified element.\n    Returns True for an empty list.\n    \"\"\"\n    return all(item == element for item in items)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/286": [{"task_id": "Mbpp/286", "solution": "import math\ndef max_sub_array_sum_repeated(arr: list[int], n: int, k: int) -> int:\n    \"\"\"\n    Calculates the maximum subarray sum in an array repeated k times.\n    This implementation uses Kadane's algorithm and handles positive/negative sums\n    and varying k values efficiently without constructing the repeated array.\n    \"\"\"\n\n    # Helper for standard Kadane's algorithm\n    def max_subarray(current_arr: list[int]) -> int:\n        if not current_arr:\n            # According to problem constraints, arr will not be empty because n=len(arr) >= 1\n            # If it could be empty, could return -infinity or raise error\n            return 0 \n        \n        max_ending_here = current_arr[0]\n        max_so_far = current_arr[0]\n        for x in current_arr[1:]:\n            max_ending_here = max(x, max_ending_here + x)\n            max_so_far = max(max_so_far, max_ending_here)\n        return max_so_far\n\n    # Helper for maximum prefix sum\n    def max_prefix_sum(current_arr: list[int]) -> int:\n        if not current_arr:\n            return 0\n        current_sum = 0\n        max_pref = -math.inf # Initialize with a very small number\n        for x in current_arr:\n            current_sum += x\n            max_pref = max(max_pref, current_sum)\n        return max_pref\n\n    # Helper for maximum suffix sum\n    def max_suffix_sum(current_arr: list[int]) -> int:\n        if not current_arr:\n            return 0\n        current_sum = 0\n        max_suff = -math.inf # Initialize with a very small number\n        for x in reversed(current_arr):\n            current_sum += x\n            max_suff = max(max_suff, current_sum)\n        return max_suff\n\n    # Handle k=1 case (standard Kadane's)\n    if k == 1:\n        return max_subarray(arr)\n\n    # Calculate sum of the original array\n    total_sum_arr = sum(arr)\n    \n    # Calculate max subarray sum for the original array\n    max_sum_single = max_subarray(arr)\n\n    # Case for k > 1:\n    # We need to consider subarrays that span across repetitions.\n    # A subarray can be:\n    # 1. Entirely within one copy of `arr`.\n    # 2. Span across two copies of `arr`.\n    # 3. Span across more than two copies of `arr`.\n\n    # To handle cases 1 and 2 (and cover simple wrap-around within 2 copies),\n    # we can run Kadane's on a conceptual `arr + arr` (i.e., iterating through 2n elements).\n    # This covers `max_sum_single` implicitly and also wraps around scenarios.\n    \n    # Calculate max subarray sum for two concatenated arrays (arr + arr)\n    # This is equivalent to running Kadane on arr twice.\n    max_ending_here_two_concats = arr[0]\n    max_so_far_two_concats = arr[0]\n    for i in range(1, 2 * n):\n        x = arr[i % n] # Access elements as if array is repeated\n        max_ending_here_two_concats = max(x, max_ending_here_two_concats + x)\n        max_so_far_two_concats = max(max_so_far_two_concats, max_ending_here_two_concats)\n    \n    max_sum_two_concats = max_so_far_two_concats\n\n    # If the total sum of the array is positive, it's beneficial to include as many full copies of the array as possible.\n    # This happens when a subarray starts in a suffix of the first copy, includes (k-2) full copies, and ends in a prefix of the last copy.\n    if total_sum_arr > 0:\n        # Maximum sum if we include (k-2) full blocks + a prefix + a suffix\n        max_pref = max_prefix_sum(arr)\n        max_suff = max_suffix_sum(arr)\n        return max(max_sum_two_concats, max_pref + max_suff + (k - 2) * total_sum_arr)\n    else:\n        # If the total sum is non-positive, including more full copies beyond two\n        # would only decrease or keep the sum the same.\n        # So, the maximum sum will be found within the first two concatenations.\n        return max_sum_two_concats", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/283": [{"task_id": "Mbpp/283", "solution": "from collections import Counter\ndef validate(number: int) -> bool:\n    \"\"\"\n    Checks if the frequency of each digit in the integer is less than or equal to the digit itself.\n    Negative numbers are validated based on their absolute value.\n    \"\"\"\n    s_number = str(abs(number))\n    char_counts = Counter(s_number)\n    \n    # Convert character digits to integers for comparison with their numeric value.\n    digit_frequencies = {int(digit_char): count for digit_char, count in char_counts.items()}\n\n    for digit, count in digit_frequencies.items():\n        # The condition is that the frequency (count) must be less than or equal to the digit's value.\n        # For example, digit '2' can appear at most 2 times.\n        # Digit '0' can appear at most 0 times, meaning if it appears even once, the number is invalid.\n        if not (count <= digit):\n            return False\n            \n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/293": [{"task_id": "Mbpp/293", "solution": "import math\ndef otherside_rightangle(a: float, b: float) -> float:\n    # Assuming 'a' and 'b' are the lengths of the two legs of the right-angled triangle.\n    # The function calculates the length of the hypotenuse using the Pythagorean theorem.\n    return math.sqrt(a * a + b * b)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/300": [{"task_id": "Mbpp/300", "solution": "import math\ndef count_binary_seq(n: int) -> float:\n    \"\"\"\n    Calculates the count of binary sequences of length 2n where the sum of\n    the first n bits equals the sum of the last n bits. This is equivalent\n    to the central binomial coefficient C(2n, n).\n    \"\"\"\n    return float(math.comb(2 * n, n))", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[1000]]}], "Mbpp/290": [{"task_id": "Mbpp/290", "solution": "from typing import List, Any, Tuple\ndef max_length(lst: List[List[Any]]) -> Tuple[int, List[Any]]:\n    \"\"\"\n    Finds the list of maximum length in a list of lists.\n    Returns a tuple containing the maximum length and the first sublist with that length.\n    \"\"\"\n    if not lst:\n        return (0, [])\n\n    max_len = 0\n    max_sublist = []\n\n    for sublist in lst:\n        current_len = len(sublist)\n        if current_len > max_len:\n            max_len = current_len\n            max_sublist = sublist\n            \n    return (max_len, max_sublist)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/292": [{"task_id": "Mbpp/292", "solution": "import math\ndef find(a, b):\n    \"\"\"\n    Computes the quotient of two numbers, rounded down to the nearest integer (floor division).\n    Handles both integer and float inputs.\n    \"\"\"\n    return int(math.floor(a / b))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/294": [{"task_id": "Mbpp/294", "solution": "from typing import Any, List, Optional, Union\nNumeric = Union[int, float]\nclass NoNumericValuesError(Exception):\n    \"\"\"Raised when no numeric values are found in a list and strict mode is enabled.\"\"\"\n    def __init__(self, message: str = \"No numeric values found\"):\n        super().__init__(message)\nclass InvalidInputError(ValueError):\n    \"\"\"Raised when invalid input is provided to a function.\"\"\"\n    def __init__(self, message: str = \"Invalid input provided\"):\n        super().__init__(message)\nclass NumberUtils:\n    @staticmethod\n    def is_number(obj: Any) -> bool:\n        \"\"\"Checks if an object is an int or float, excluding boolean.\"\"\"\n        # Exclude bool (subclass of int) as per design requirements.\n        return isinstance(obj, (int, float)) and not isinstance(obj, bool)\n\n    @staticmethod\n    def parse_numeric_string(s: str) -> Optional[Numeric]:\n        \"\"\"Attempts to parse a string into an int or float, returning None on failure.\"\"\"\n        s = s.strip()\n        if not s:\n            return None\n        try:\n            # Prioritize float if it contains decimal or exponential notation, otherwise int.\n            if '.' in s or 'e' in s.lower() or 'E' in s:\n                return float(s)\n            else:\n                return int(s)\n        except ValueError:\n            # If int conversion failed, try float as a fallback.\n            try:\n                return float(s)\n            except ValueError:\n                return None\n\n    @staticmethod\n    def coerce_to_number(obj: Any, parse_numeric_strings: bool=False) -> Optional[Numeric]:\n        \"\"\"Coerces an object to a number if it's numeric or a parsable string.\"\"\"\n        if NumberUtils.is_number(obj):\n            return obj\n        if parse_numeric_strings and isinstance(obj, str):\n            return NumberUtils.parse_numeric_string(obj)\n        return None\nclass HeteroList:\n    \"\"\"A wrapper for a heterogeneous list, providing methods to extract numeric items.\"\"\"\n    def __init__(self, items: List[Any]):\n        # Validate that the initial input is a list.\n        if not isinstance(items, list):\n            raise InvalidInputError(\"HeteroList requires a list\")\n        self._items = list(items) # Store a shallow copy to prevent external modification.\n\n    def items(self) -> List[Any]:\n        \"\"\"Returns a shallow copy of the underlying list.\"\"\"\n        return list(self._items)\n\n    def get_numeric_items(self, parse_numeric_strings: bool=False) -> List[Numeric]:\n        \"\"\"Extracts numeric items from the list, optionally parsing numeric strings.\"\"\"\n        out: List[Numeric] = []\n        for it in self._items:\n            num = NumberUtils.coerce_to_number(it, parse_numeric_strings=parse_numeric_strings)\n            if num is not None:\n                out.append(num)\n        return out\nclass MaxFinderService:\n    \"\"\"Provides the core logic for finding the maximum numeric value.\"\"\"\n    @staticmethod\n    def max_value(hetero_list: HeteroList, parse_numeric_strings: bool=False, raise_on_empty: bool=False) -> Optional[Numeric]:\n        \"\"\"Finds the maximum numeric value in a HeteroList, with options for string parsing and error handling.\"\"\"\n        nums = hetero_list.get_numeric_items(parse_numeric_strings=parse_numeric_strings)\n        if not nums:\n            if raise_on_empty:\n                raise NoNumericValuesError(\"No numeric values found in the provided list\")\n            return None\n        # Python's max() function correctly handles mixed int/float types, returning the most appropriate numeric type.\n        return max(nums)\ndef max_val(items: List[Any], parse_numeric_strings: bool = False) -> Optional[Numeric]:\n    \"\"\"\n    Finds the maximum numeric value in a given heterogeneous list.\n    Non-numeric entries are ignored by default. Numeric strings can be parsed if `parse_numeric_strings` is True.\n    Returns the maximum numeric value or None if no numeric values are found.\n    \"\"\"\n    # Validate input type as per design's MaxFinderController.find_max.\n    if not isinstance(items, list):\n        raise InvalidInputError(\"items must be a list\")\n\n    hetero = HeteroList(items)\n    # This convenience function is designed to return None if no numerics are found.\n    return MaxFinderService.max_value(hetero, parse_numeric_strings=parse_numeric_strings, raise_on_empty=False)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[["3.14", false, 7.5]]]}], "Mbpp/305": [{"task_id": "Mbpp/305", "solution": "import collections\nclass NotFoundError(Exception):\n    \"\"\"Custom exception raised when fewer than two matching words are found.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\ndef start_withp(lines: list[str]) -> tuple[str, str]:\n    \"\"\"\n    Finds the first two words from a list of strings that start with the letter 'p' (case-insensitive).\n    The returned words preserve their original casing (after leading/trailing whitespace is removed).\n    \"\"\"\n    \n    matches = []\n    \n    for line in lines:\n        for token in line.split():\n            # Inlined logic for TextUtils.normalize_word and TextUtils.starts_with\n            stripped_token = token.strip()\n            if stripped_token and stripped_token.lower().startswith('p'):\n                matches.append(stripped_token)\n                if len(matches) == 2:\n                    return (matches[0], matches[1])\n    \n    raise NotFoundError(\"Fewer than two words starting with 'p' were found\")", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[]]]}], "Mbpp/299": [{"task_id": "Mbpp/299", "solution": "from collections import defaultdict\ndef max_aggregate(records: list[tuple[str, object]]) -> tuple[str, float]:\n    \"\"\"\n    Calculates the maximum aggregate total from a list of (name, value) tuples.\n    In case of a tie in total, the name that comes first lexicographically is chosen.\n    \"\"\"\n    aggregates = defaultdict(float)\n\n    for name, value in records:\n        aggregates[name] += float(value)\n\n    max_name = None\n    max_total = None\n\n    for name, total in aggregates.items():\n        if max_total is None or total > max_total:\n            max_total = total\n            max_name = name\n        elif total == max_total:\n            # Tie-breaking: choose lexicographically smaller name\n            if name < max_name:\n                max_name = name\n    \n    # Convert total to an integer if it's a whole number, as per the example output.\n    if max_total is not None and max_total.is_integer():\n        max_total = int(max_total)\n\n    return max_name, max_total", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[["Alice", -50], ["AlDavidice", -50]]]]}], "Mbpp/297": [{"task_id": "Mbpp/297", "solution": "class FlattenError(Exception):\n    \"\"\"Custom exception for flattening-related errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\nSUPPORTED_PRIMITIVE_TYPES = (int, float, str, bool, type(None))\nclass NestedListModel:\n    \"\"\"Represents a potentially nested list input.\"\"\"\n    def __init__(self, items: list) -> None:\n        self.items = items\nclass FlatListModel:\n    \"\"\"Represents a flattened list output.\"\"\"\n    def __init__(self, items: list) -> None:\n        self.items = items\n\n    def to_list(self) -> list:\n        \"\"\"Returns the flattened items as a plain Python list.\"\"\"\n        return list(self.items)\nclass Validators:\n    \"\"\"Provides validation utilities for list structures and element types.\"\"\"\n    def __init__(self, supported_primitive_types: tuple) -> None:\n        self.supported_primitive_types = supported_primitive_types\n\n    def is_list(self, obj: any) -> bool:\n        \"\"\"Checks if the given object is a list.\"\"\"\n        return isinstance(obj, list)\n\n    def validate_supported_types(self, obj: any) -> None:\n        \"\"\"Recursively validates all elements are lists or supported primitive types.\"\"\"\n        if self.is_list(obj):\n            for item in obj:\n                if self.is_list(item):\n                    self.validate_supported_types(item)\n                elif not isinstance(item, self.supported_primitive_types):\n                    raise FlattenError(f\"Unsupported element type found: {type(item).__name__} ({item})\")\n        # If obj is not a list, this method assumes it's being called on an element\n        # and defers to `isinstance(item, self.supported_primitive_types)` check.\n        # Top-level list validation is handled by ListAdapter.\nclass ListAdapter:\n    \"\"\"Adapts an arbitrary object to a NestedListModel, performing initial validation.\"\"\"\n    def __init__(self, validators: Validators) -> None:\n        self.validators = validators\n\n    def to_nested_model(self, obj: any) -> NestedListModel:\n        \"\"\"Validates input as a list and its contents, then creates a NestedListModel.\"\"\"\n        if not self.validators.is_list(obj):\n            raise FlattenError(\"Top-level object must be a list\")\n        self.validators.validate_supported_types(obj)\n        return NestedListModel(list(obj))\nclass FlattenService:\n    \"\"\"Implements the core iterative flattening algorithm.\"\"\"\n    def __init__(self, supported_types: tuple = None) -> None:\n        self.supported_types = supported_types or SUPPORTED_PRIMITIVE_TYPES\n\n    def flatten(self, model: NestedListModel) -> FlatListModel:\n        \"\"\"Flattens a NestedListModel using an iterative approach.\"\"\"\n        flat_items = self._iterative_flatten(model.items)\n        return FlatListModel(flat_items)\n\n    def _iterative_flatten(self, items: list) -> list:\n        \"\"\"Performs the iterative, stack-based flattening.\"\"\"\n        result = []\n        stack = list(reversed(items))\n        while stack:\n            item = stack.pop()\n            if isinstance(item, list):\n                stack.extend(reversed(item))\n            elif isinstance(item, self.supported_types):\n                result.append(item)\n            else:\n                raise FlattenError(f\"Unsupported element type: {type(item).__name__} ({item}) found during flattening.\")\n        return result\ndef flatten_list(input_list: list) -> list:\n    \"\"\"\n    Flattens a given nested list structure into a single-level list.\n    Raises FlattenError for invalid top-level input or unsupported element types.\n    \"\"\"\n    validators = Validators(SUPPORTED_PRIMITIVE_TYPES)\n    adapter = ListAdapter(validators)\n    service = FlattenService(SUPPORTED_PRIMITIVE_TYPES)\n\n    nested_model = adapter.to_nested_model(input_list)\n    flat_model = service.flatten(nested_model)\n\n    return flat_model.to_list()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/296": [{"task_id": "Mbpp/296", "solution": "import time\nimport json\nfrom typing import Sequence, List, Tuple, Optional, Any, Dict\nclass InversionError(Exception):\n    \"\"\"Custom exception for inversion counting errors.\"\"\"\n    def __init__(self, message: str, code: int = 400) -> None:\n        super().__init__(message)\n        self.message = message\n        self.code = code\n\n    def to_dict(self) -> Dict[str, Any]:\n        return {\"error\": self.message, \"code\": self.code}\nclass ArrayInput:\n    \"\"\"Data model wrapping