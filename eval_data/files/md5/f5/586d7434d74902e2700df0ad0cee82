em)\n        result = sorted(min_heap, reverse=True)\n        return result\n\n    def _select_k_largest_unique(self, iterable: Iterator[float], k: int) -> List[float]:\n        \"\"\"Selects k largest unique items, using a set for deduping and a min-heap.\"\"\"\n        unique_elements: Set[float] = set()\n        for item in iterable:\n            unique_elements.add(item)\n        \n        min_heap: List[float] = []\n        for item in unique_elements:\n            if len(min_heap) < k:\n                heapq.heappush(min_heap, item)\n            elif item > min_heap[0]:\n                heapq.heapreplace(min_heap, item)\n        result = sorted(min_heap, reverse=True)\n        return result\n\n    def get_n_largest(self, data: Iterable, n: int, allow_duplicates: bool = True) -> List[float]:\n        \"\"\"Returns a list containing the n largest items from the data.\"\"\"\n        iterator = self._repository.read(data)\n        \n        if allow_duplicates:\n            return self._select_k_largest_iterable(iterator, n)\n        else:\n            return self._select_k_largest_unique(iterator, n)\nclass LargestNController:\n    \"\"\"Thin API layer for the LargestNService, including input validation.\"\"\"\n    def __init__(self, service: LargestNService) -> None:\n        self._service = service\n\n    def get_n_largest(self, data: Iterable, n: int, allow_duplicates: bool = True) -> List[float]:\n        \"\"\"Validates inputs and delegates to the service to find n largest items.\"\"\"\n        validate_input(data, n, allow_duplicates)\n        return self._service.get_n_largest(data, n, allow_duplicates)\n_default_repository = ListRepository()\n_default_service = LargestNService(_default_repository)\n_default_controller = LargestNController(_default_service)\ndef larg_nnum(data: Iterable[Any], n: int, allow_duplicates: bool = True) -> List[float]:\n    \"\"\"\n    Returns a list containing the n largest items from the list.\n    The list is sorted in descending order.\n    \"\"\"\n    return _default_controller.get_n_largest(data, n, allow_duplicates)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[10, 20, 50, 70, 90, 20, 50, 40, 60, 80, 100], 2]], "plus_fail_tests": [[[1, 5, 3, 8, 7, 2, 6, 4, 9], 4]]}], "Mbpp/235": [{"task_id": "Mbpp/235", "solution": "def even_bit_set_number(n: int) -> int:\n    \"\"\"Sets all even-positioned bits (1-based index) of the given number.\"\"\"\n    # Determine the effective width for the mask, ensuring a minimum width of 1.\n    width = max(n.bit_length(), 1)\n\n    # Generate a mask with bits set at 0-based indices 1, 3, 5, ... up to (width - 1).\n    mask = 0\n    for i in range(1, width, 2):\n        mask |= (1 << i)\n    \n    # OR the input number with the generated mask to set the specified bits.\n    return n | mask", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/123": [{"task_id": "Mbpp/123", "solution": "import math\nfrom typing import List, Set\nclass InMemoryCache:\n    \"\"\"A simple in-memory key-value cache.\"\"\"\n    def __init__(self):\n        self._store = {}\n\n    def get(self, key):\n        \"\"\"Retrieves a value from the cache.\"\"\"\n        return self._store.get(key)\n\n    def set(self, key, value):\n        \"\"\"Stores a value in the cache.\"\"\"\n        self._store[key] = value\n\n    def clear(self):\n        \"\"\"Clears all items from the cache.\"\"\"\n        self._store.clear()\nclass DivisorService:\n    \"\"\"Calculates proper divisors and their sum for a given number.\"\"\"\n    def __init__(self, cache: InMemoryCache = None):\n        self._cache = cache\n\n    def proper_divisors(self, n: int) -> List[int]:\n        \"\"\"Returns a sorted list of proper divisors for n (excluding n).\"\"\"\n        if n <= 1:\n            return []\n        divisors = {1}\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                divisors.add(i)\n                divisors.add(n // i)\n            i += 1\n        return sorted(list(divisors))\n\n    def sum_proper_divisors(self, n: int) -> int:\n        \"\"\"Returns the sum of proper divisors for n, using cache if available.\"\"\"\n        if n <= 1:\n            return 0\n        if self._cache:\n            cache_key = f\"sum_div_{n}\"\n            cached_sum = self._cache.get(cache_key)\n            if cached_sum is not None:\n                return cached_sum\n\n        s = sum(self.proper_divisors(n))\n\n        if self._cache:\n            self._cache.set(cache_key, s)\n        return s\nclass AmicablePair:\n    \"\"\"A value object representing an amicable pair of integers (a, b).\"\"\"\n    def __init__(self, a: int, b: int):\n        self.a = a\n        self.b = b\n\n    def __eq__(self, other):\n        if not isinstance(other, AmicablePair):\n            return NotImplemented\n        # Pairs (a,b) and (b,a) are considered equal\n        return (self.a == other.a and self.b == other.b) or \\\n               (self.a == other.b and self.b == other.a)\n\n    def __hash__(self):\n        # Hash needs to be consistent for (a,b) and (b,a)\n        return hash(frozenset({self.a, self.b}))\nclass AmicableCalculator:\n    \"\"\"Orchestrates the detection and summation of amicable numbers.\"\"\"\n    def __init__(self, divisor_service: DivisorService, cache: InMemoryCache = None):\n        self._divisor_service = divisor_service\n        # _cache is for AmicableCalculator's own caching, if needed for pairs.\n        # For sums of divisors, DivisorService's cache is used.\n        self._cache = cache\n\n    def find_amicable_pairs(self, limit: int) -> List[AmicablePair]:\n        \"\"\"Finds all amicable pairs (a,b) such that a < b.\"\"\"\n        amicable_pairs: Set[AmicablePair] = set()\n\n        # Iterate numbers from 2 up to the limit to find potential 'a' values\n        for n in range(2, limit + 1):\n            sd_n = self._divisor_service.sum_proper_divisors(n)\n\n            # Condition to filter out perfect numbers (sd_n == n) or numbers\n            # whose sum of divisors is less than or equal to 1, or those already processed (n >= sd_n).\n            if sd_n <= n:\n                continue\n\n            # Calculate sum of proper divisors for the potential amicable partner (sd_n)\n            sd_sd_n = self._divisor_service.sum_proper_divisors(sd_n)\n\n            # If sd_sd_n equals n, and n is not sd_n, an amicable pair is found\n            if sd_sd_n == n:\n                amicable_pairs.add(AmicablePair(n, sd_n))\n\n        # Return sorted list for deterministic output\n        return sorted(list(amicable_pairs), key=lambda p: p.a)\n\n    def sum_amicable_numbers(self, limit: int) -> int:\n        \"\"\"Sums all amicable numbers less than or equal to the specified limit.\"\"\"\n        pairs = self.find_amicable_pairs(limit)\n        total = 0\n        counted_numbers = set() # To ensure each unique amicable number is summed only once\n\n        for p in pairs:\n            # Add 'a' to total if it's within limit and not already counted\n            if p.a <= limit and p.a not in counted_numbers:\n                total += p.a\n                counted_numbers.add(p.a)\n            # Add 'b' to total if it's within limit and not already counted\n            if p.b <= limit and p.b not in counted_numbers:\n                total += p.b\n                counted_numbers.add(p.b)\n        return total\n_cache = InMemoryCache()\n_div = DivisorService(cache=_cache)\n_calc = AmicableCalculator(divisor_service=_div, cache=_cache)\ndef amicable_numbers_sum(limit: int) -> int:\n    \"\"\"\n    Sums all amicable numbers up to a specified limit.\n    An amicable pair (a, b) consists of two distinct integers such that the sum of the\n    proper divisors of a is b and the sum of the proper divisors of b is a.\n    \"\"\"\n    return _calc.sum_amicable_numbers(limit)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/237": [{"task_id": "Mbpp/237", "solution": "import collections\nclass InvalidPairError(ValueError):\n    \"\"\"Exception raised for errors in pair validation or normalization.\"\"\"\n    pass\nclass PairNormalizer:\n    \"\"\"Utility to canonicalize pairs (unordered semantics).\"\"\"\n    def normalize(self, pair: tuple) -> tuple[int, int]:\n        \"\"\"Validates, casts to int, and returns a canonical (min, max) tuple.\"\"\"\n        if not hasattr(pair, \"__iter__\"):\n            raise InvalidPairError(\"Pair must be iterable of length 2\")\n        try:\n            a, b = pair\n        except (TypeError, ValueError):\n            raise InvalidPairError(\"Pair must have exactly two elements\")\n        \n        try:\n            a_i, b_i = int(a), int(b)\n        except (TypeError, ValueError):\n            raise InvalidPairError(f\"Pair elements must be convertible to integers: {pair}\")\n\n        return (a_i, b_i) if a_i <= b_i else (b_i, a_i)\nclass InMemoryCounterRepository:\n    \"\"\"In-memory counts repository (incremental).\"\"\"\n    def __init__(self) -> None:\n        self._counts: dict[tuple[int,int], int] = {}\n\n    def increment(self, pair: tuple[int,int], amount: int = 1) -> None:\n        \"\"\"Increments the count for a given canonical pair.\"\"\"\n        if amount < 1:\n            raise ValueError(\"amount must be >= 1\")\n        self._counts[pair] = self._counts.get(pair, 0) + amount\n\n    def get_all(self) -> dict[tuple[int,int], int]:\n        \"\"\"Returns a shallow copy of all stored counts.\"\"\"\n        return dict(self._counts)\n\n    def reset(self) -> None:\n        \"\"\"Clears all stored counts.\"\"\"\n        self._counts.clear()\nclass CounterService:\n    \"\"\"Business logic to count occurrences using a normalizer and repository.\"\"\"\n    def __init__(self, repository: InMemoryCounterRepository, normalizer: PairNormalizer) -> None:\n        self._repo = repository\n        self._normalizer = normalizer\n\n    def count_occurrences(self, pairs: list[tuple]) -> dict[tuple[int,int], int]:\n        \"\"\"Counts occurrences of canonical pairs from a list of input pairs.\"\"\"\n        if pairs is None:\n            raise TypeError(\"pairs must be an iterable of 2-element tuples\")\n        \n        self._repo.reset() # Reset repository for each counting operation\n        for p in pairs:\n            canonical = self._normalizer.normalize(p)\n            self._repo.increment(canonical)\n        return self._repo.get_all()\ndef check_occurences(pairs: list[tuple]) -> dict[tuple[int,int], int]:\n    \"\"\"\n    Takes a list of tuples and returns a dictionary mapping each unique\n    canonical tuple to the number of times it occurs in the list.\n    \"\"\"\n    repo = InMemoryCounterRepository()\n    normalizer = PairNormalizer()\n    service = CounterService(repo, normalizer)\n    return service.count_occurrences(pairs)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[[1], [2, 3], [4, 5, 6], [7, 8], [9], [1], [2, 3]]]]}], "Mbpp/234": [{"task_id": "Mbpp/234", "solution": "def volume_cube(side_length):\n    \"\"\"\n    Calculates the volume of a cube given its side length.\n    \"\"\"\n    return side_length ** 3", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/240": [{"task_id": "Mbpp/240", "solution": "from typing import List, Any\ndef replace_list(a: List[Any], b: List[Any]) -> List[Any]:\n    \"\"\"\n    Replaces the last element of the first list with the elements of the second list.\n    Returns a new list without modifying the original inputs.\n    \"\"\"\n    if not a:\n        return list(b)\n    \n    # Create a new list from 'a' excluding its last element, then append 'b'.\n    # list() calls ensure copies are made to prevent modification of original inputs.\n    return list(a[:-1]) + list(b)", "base_status": "pass", "plus_status": "pass", "bas