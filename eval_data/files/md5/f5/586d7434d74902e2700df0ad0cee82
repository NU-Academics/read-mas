stance(el, int):\n            if el % 2 == 0:\n                out.append(el)\n        elif isinstance(el, tuple):\n            nested_result = extract_even(el)\n            if nested_result:  # Only append if the nested tuple is not empty\n                out.append(nested_result)\n    return tuple(out)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/588": [{"task_id": "Mbpp/588", "solution": "def big_diff(nums):\n    \"\"\"\n    Finds the difference between the largest and smallest value in a given list.\n    Assumes the input list `nums` is non-empty and contains comparable numeric values.\n    \"\"\"\n    return max(nums) - min(nums)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/586": [{"task_id": "Mbpp/586", "solution": "from typing import List, Any\ndef split_Arr(arr: List[Any], n: int) -> List[Any]:\n    \"\"\"\n    Splits a list at the nth element and adds the first part to the end.\n    \"\"\"\n    if not arr:\n        return []\n    \n    # Normalize n to be within the list bounds using modulo\n    effective_n = n % len(arr)\n    \n    # Split the list and concatenate\n    return arr[effective_n:] + arr[:effective_n]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/585": [{"task_id": "Mbpp/585", "solution": "import collections.abc\nfrom abc import ABC, abstractmethod\nfrom typing import Any, Callable, Iterable, List, Optional, Union\nclass ValidationError(Exception):\n    \"\"\"Custom exception for invalid input data.\"\"\"\n    pass\ndef safe_cast_price(value: Any) -> float:\n    \"\"\"\n    Safely casts a value to a float.\n\n    Raises ValidationError if the value cannot be converted to a float.\n    \"\"\"\n    try:\n        return float(value)\n    except (ValueError, TypeError) as e:\n        raise ValidationError(f\"Price value '{value}' is not numeric.\") from e\ndef validate_items(items: Iterable[dict]) -> List[dict]:\n    \"\"\"\n    Validates a list of item dictionaries, ensuring each has 'name' and 'price' and\n    'price' is convertible to float.\n\n    Returns a new list of dictionaries with normalized 'name' (str) and 'price' (float).\n    Raises ValidationError if any item is invalid or if items is not iterable.\n    \"\"\"\n    if not isinstance(items, collections.abc.Iterable):\n        raise ValidationError(\"Input 'items' must be an iterable.\")\n\n    validated_items = []\n    for i, item_data in enumerate(items):\n        if not isinstance(item_data, dict):\n            raise ValidationError(f\"Item at index {i} is not a dictionary.\")\n        if 'name' not in item_data or 'price' not in item_data:\n            raise ValidationError(f\"Item at index {i} must contain 'name' and 'price' keys.\")\n        \n        try:\n            name = str(item_data['name'])\n            price = safe_cast_price(item_data['price'])\n            validated_items.append({\"name\": name, \"price\": price})\n        except ValidationError as e:\n            raise ValidationError(f\"Validation error for item at index {i}: {e}\") from e\n            \n    return validated_items\nclass DataRepository(ABC):\n    \"\"\"Abstract base class for data repositories.\"\"\"\n\n    @abstractmethod\n    def fetch_items(self) -> List[dict]:\n        \"\"\"Fetches a list of item dictionaries from the repository.\"\"\"\n        pass\nclass InMemoryRepository(DataRepository):\n    \"\"\"A data repository that holds items in memory.\"\"\"\n\n    def __init__(self, items: List[dict]):\n        self._items = list(items)  # Store a copy to prevent external modification\n\n    def fetch_items(self) -> List[dict]:\n        \"\"\"Returns the items stored in this in-memory repository.\"\"\"\n        return list(self._items) # Return a copy\nclass PriceService:\n    \"\"\"Provides business logic for finding the n most expensive items.\"\"\"\n\n    def __init__(self, repo: Optional[DataRepository] = None, validator: Callable[[Iterable[dict]], List[dict]] = validate_items):\n        \"\"\"\n        Initializes the PriceService.\n\n        Args:\n            repo: An optional DataRepository instance to fetch items.\n            validator: A callable used to validate and normalize item data.\n        \"\"\"\n        self._repo = repo\n        self._validator = validator\n\n    def get_top_n_items(self, n: int, items: Optional[List[dict]] = None) -> List[dict]:\n        \"\"\"\n        Retrieves the n most expensive items from a dataset.\n\n        Args:\n            n: The number of most expensive items to retrieve. Must be a non-negative integer.\n            items: An optional list of item dictionaries to process directly.\n                   If None, items are fetched from the configured repository.\n        \n        Returns:\n            A list of item dictionaries, sorted by price in descending order.\n        \n        Raises:\n            ValidationError: If n is invalid, no item source is provided, or item data is invalid.\n        \"\"\"\n        if not isinstance(n, int) or n < 0:\n            raise ValidationError(\"n must be a non-negative integer.\")\n\n        source_items: Optional[List[dict]] = None\n        if items is not None:\n            source_items = items\n        elif self._repo is not None:\n            source_items = self._repo.fetch_items()\n        \n        if source_items is None:\n            raise ValidationError(\"No items provided and no repository configured.\")\n\n        # Validate and normalize the items, ensuring 'price' is float\n        validated_items = self._validator(source_items)\n\n        # Pair items with their original index to ensure stable sorting for ties\n        indexed_items = list(enumerate(validated_items))\n\n        # Sort by price in descending order, then by original index for stability\n        indexed_items.sort(key=lambda pair: (-pair[1]['price'], pair[0]))\n\n        # Extract the top n items\n        top_n_items = [item for _, item in indexed_items[:n]]\n\n        return top_n_items\ndef expensive_items(items: List[dict], n: int = 1) -> List[dict]:\n    \"\"\"\n    Finds the n most expensive items in a given dataset.\n\n    Args:\n        items: A list of dictionaries, where each dictionary represents an item\n               and must contain 'name' (str) and 'price' (numeric or numeric str) keys.\n        n: The number of most expensive items to retrieve. Defaults to 1.\n           Must be a non-negative integer.\n\n    Returns:\n        A list of dictionaries representing the n most expensive items,\n        sorted by price in descending order.\n\n    Raises:\n        ValidationError: If input items or n are invalid.\n    \"\"\"\n    repo = InMemoryRepository(items)\n    svc = PriceService(repo=repo)\n    return svc.get_top_n_items(n)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[{"name": "Item-1", "price": 100.13437547119709}, {"name": "Item-1", "price": 100.13437547119709}, {"name": "Item-4", "price": 555.22, "pricpricee": "Iteem-4"}, {"name": "Item-4", "price": 22.75}, {"name": "Item-1", "price": 100.13437547119709}], 2]]}], "Mbpp/568": [{"task_id": "Mbpp/568", "solution": "from typing import List\ndef empty_list(N: int) -> List[dict]:\n    \"\"\"\n    Creates a list of N empty dictionaries.\n    Each dictionary in the list is a distinct object.\n    \"\"\"\n    return [dict() for _ in range(N)]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/587": [{"task_id": "Mbpp/587", "solution": "from typing import Iterable, Any, Callable\nclass ConversionError(Exception):\n    \"\"\"Custom exception for conversion failures.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\ndef is_iterable(obj: Any) -> bool:\n    \"\"\"Checks if an object is iterable but not a string or bytes, as per design rules.\"\"\"\n    if obj is None:\n        return False\n    if isinstance(obj, (str, bytes)):\n        return False\n    try:\n        iter(obj)\n        return True\n    except TypeError:\n        return False\nclass InputDTO:\n    \"\"\"Data Transfer Object for input values.\"\"\"\n    def __init__(self, values: Any) -> None:\n        self.values = values\nclass ListDTO:\n    \"\"\"Data Transfer Object for converted list items.\"\"\"\n    def __init__(self, items: tuple) -> None:\n        self.items = items\nclass ListConverterService:\n    \"\"\"Service to validate and convert iterables to tuples.\"\"\"\n    def __init__(self, validator: Callable[[Any], bool] = is_iterable) -> None:\n        self._validator = validator\n\n    def convert(self, input_dto: InputDTO) -> ListDTO:\n        value = input_dto.values\n        if not self._validator(value):\n            raise ConversionError(\"Input is not an acceptable iterable\")\n        try:\n            items = tuple(value)\n        except Exception as exc:\n            raise ConversionError(f\"Conversion failed: {exc}\") from exc\n        return ListDTO(items)\ndef list_tuple(input_list: Iterable[Any]) -> tuple:\n    \"\"\"\n    Converts an input iterable to a tuple using a structured conversion service.\n    \"\"\"\n    service = ListConverterService()\n    input_dto = InputDTO(input_list)\n    result_dto = service.convert(input_dto)\n    return result_dto.items", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/589": [{"task_id": "Mbpp/589", "solution": "import math\nfrom typing import List\ndef perfect_squares(low: int, high: int) -> List[int]:\n    \"\"\"\n    Finds perfect square integers within a closed integer range [low, high].\n    \"\"\"\n    \n    # Handle negative lower bounds by starting from 0, as perfect squares are non-negative.\n    # Calculate the smallest integer 'k_start' such that k_start * k_start >= low.\n    # math.isqrt(n) returns floor(sqrt(n)).\n    start_sqrt_val = math.isqrt(max(0, low))\n    if start_sqrt_val * start_sqrt_val < low:\n        k_start = start_sqrt_val + 1\n    else:\n        k_start = start_sqrt_val\n\n    # Calculate the largest integer 'k_end' such that k_end * k_end <= high.\n    k_end = math.isqrt(high)\n\n    # Collect all k*k for k in the range [k_start, k_end].\n    result = [k * k for k in range(k_start, k_end + 1)]\n    return result", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[-10, -1]]}], "Mbpp/591": [{"task_id": "Mbpp/591", "solution": "def swap_List(items: list) -> list:\n    \"\"\"Interchanges the first and last elements in a list, returning a new list.\"\"\"\n    list_copy = list(items)\n    if len(list_copy) < 2:\n        return list_copy\n    list_copy[0], list_copy[-1] = list_copy[-1], list_copy[0]\n    return list_copy", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/592": [{"task_id": "Mbpp/592", "solution": "import math\ndef sum_Of_product(n: int) -> int:\n    \"\"\"\n    Finds the sum of the product of consecutive binomial coefficients using a closed-form identity.\n    The sum is S(n) = sum_{k=0}^{n-1} C(n,k) * C(n,k+1), which equals C(2n, n-1) for n >= 1 and 0 for n = 0.\n    \"\"\"\n    if n == 0:\n        return 0\n    # For n >= 1, the sum of C(n,k) * C(n,k+1) for k from 0 to n-1 is given by the identity C(2n, n-1).\n    return math.comb(2 * n, n - 1)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/593": [{"task_id": "Mbpp/593", "solution": "class InvalidIPAddressError(Exception):\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\nclass Utils:\n    @staticmethod\n    def is_digits(s: str) -> bool:\n        return s.isdigit()\n\n    @staticmethod\n    def strip_whitespace(s: str) -> str:\n        return s.strip()\nclass IPAddress:\n    def __init__(self, raw: str, octets: list[int]) -> None:\n        self.raw = raw\n        self.octets = octets\n\n    def to_normalized(self) -> str:\n        return \".\".join(str(o) for o in self.octets)\nclass IPParser:\n    def sanitize(self, ip: str) -> str:\n        return Utils.strip_whitespace(ip)\n\n    def tokenize(self, ip: str) -> list[str]:\n        s = self.sanitize(ip)\n        return s.split(\".\")\nclass IPValidator:\n    def validate_octet(self, token: str) -> int:\n        if token == \"\":\n            raise InvalidIPAddressError(\"Empty octet\")\n        if not Utils.is_digits(token):\n            raise InvalidIPAddressError(f\"Non-digit octet: {token}\")\n        val = int(token)\n        if val < 0 or val > 255:\n            raise InvalidIPAddressError(f\"Octet out of range: {token}\")\n        return val\n\n    def validate_octets(self, tokens: list[str]) -> list[int]:\n        if len(tokens) != 4:\n            raise InvalidIPAddressError(\"IP must have exactly 4 octets\")\n        return [self.validate_octet(t) for t in tokens]\nclass IPCleanerService:\n    def __init__(self, parser: IPParser=None, validator: IPValidator=None) -> None:\n        self.parser = parser or IPParser()\n        self.validator = validator or IPValidator()\n\n    def normalize(self, ip: str) -> str:\n        tokens = self.parser.tokenize(ip)\n        octets = self.validator.validate_octets(tokens)\n        model = IPAddress(raw=ip, octets=octets)\n        return model.to_normalized()\n_default_service = IPCleanerService()\ndef removezero_ip(ip: str) -> str:\n    \"\"\"Removes leading zeroes from each octet of an IPv4 address.\"\"\"\n    return _default_service.normalize(ip)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [["12.01.024"]], "plus_fail_tests": [["0.0.0.0"]]}], "Mbpp/590": [{"task_id": "Mbpp/590", "solution": "import math\nfrom dataclasses import dataclass\nfrom typing import Tuple\nclass ConverterService:\n    \"\"\"Provides coordinate conversion logic between Cartesian and Polar forms.\"\"\"\n\n    def cartesian_to_polar(self, rect: Rect) -> Polar:\n        \"\"\"Converts Rect (Cartesian) to Polar.\"\"\"\n        return rect.to_polar()\n\n    def polar_to_cartesian(self, polar: Polar) -> Rect:\n        \"\"\"Converts Polar to Rect (Cartesian).\"\"\"\n        c = polar.to_rect()\n        return Rect(c.real, c.imag)\n\n    def convert(self, a: float, b: float, mode: str = 'cartesian') -> Tuple[Polar, complex]:\n        \"\"\"\n        Converts coordinates based on the specified mode.\n        If mode='cartesian', (a,b) are (x,y). If mode='polar', (a,b) are (r,theta).\n        \"\"\"\n        if mode == 'cartesian':\n            rect = Rect(a, b)\n            polar = self.cartesian_to_polar(rect)\n            return polar, complex(rect.x, rect.y)\n        elif mode == 'polar':\n            polar = Polar(a, b)\n            rect = self.polar_to_cartesian(polar)\n            return polar, complex(rect.x, rect.y)\n        else:\n            raise ValueError(f\"Unknown mode: {mode}. Must be 'cartesian' or 'polar'.\")\ndef polar_rect(a: float, b: float, mode: str = 'cartesian') -> Tuple[Tuple[float,float], complex]:\n    \"\"\"\n    Converts coordinates between polar and rectangular forms based on the mode.\n    If mode='cartesian', (a,b) are (x,y). If mode='polar', (a,b) are (r,theta).\n    Returns a tuple of ((r, theta), complex(x,y)).\n    \"\"\"\n    svc = ConverterService()\n    polar_obj, rect_complex_val = svc.convert(a, b, mode)\n    return (polar_obj.r, polar_obj.theta), rect_complex_val", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/594": [{"task_id": "Mbpp/594", "solution": "import math\ndef diff_even_odd(numbers):\n    first_even = None\n    first_odd = None\n\n    for num in numbers:\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n        if first_even is None and num % 2 == 0:\n            first_