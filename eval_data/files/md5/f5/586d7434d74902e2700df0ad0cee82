s digits.\"\"\"\n        if value == 0:\n            return [0]\n        digits = []\n        temp_val = value\n        while temp_val > 0:\n            digits.append(temp_val % 10)\n            temp_val //= 10\n        return list(reversed(digits))\n\n    digits = _get_digits(abs_num_val)\n\n    MIN_DIGITS = 2\n    if len(digits) < MIN_DIGITS:\n        return False\n\n    # Get the first two digits. They must be distinct for an undulating number.\n    digit_a = digits[0]\n    digit_b = digits[1]\n\n    if digit_a == digit_b:\n        return False\n\n    # Check that all subsequent digits strictly alternate between digit_a and digit_b.\n    for i in range(len(digits)):\n        expected_digit = digit_a if i % 2 == 0 else digit_b\n        if digits[i] != expected_digit:\n            return False\n\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/95": [{"task_id": "Mbpp/95", "solution": "from typing import Sequence, Any\ndef Find_Min_Length(lists: Sequence[Sequence[Any]]) -> int:\n    \"\"\"\n    Finds the length of the smallest list within a list of lists.\n    Assumes input validation has already been performed by the caller.\n    \"\"\"\n    return min(len(inner_list) for inner_list in lists)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/94": [{"task_id": "Mbpp/94", "solution": "from typing import List, Tuple, Any\ndef index_minimum(items: List[Tuple[Any, Any]]) -> Any:\n    \"\"\"\n    Given a list of tuples, returns the first value of the tuple with the smallest second value.\n    Assumes the input list is non-empty and contains 2-element tuples where the second element is comparable.\n    \"\"\"\n    min_value = items[0][1]\n    result = items[0][0]\n\n    for item_first, item_second in items[1:]:\n        if item_second < min_value:\n            min_value = item_second\n            result = item_first\n            \n    return result", "