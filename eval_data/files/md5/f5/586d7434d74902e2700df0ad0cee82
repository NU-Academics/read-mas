ill need to check the 0th bit\n        return max_val.bit_length()\n\n    if not nums:\n        return 0\n\n    num_elements = len(nums)\n    max_bits = _get_max_bit_length(nums)\n    total_xor_sum = 0\n\n    for b in range(max_bits):\n        mask = 1 << b\n        ones_count = 0\n        for x in nums:\n            if (x & mask) != 0:\n                ones_count += 1\n        \n        zeros_count = num_elements - ones_count\n        \n        total_xor_sum += ones_count * zeros_count * mask\n        \n    return total_xor_sum", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[1, 2, 3, 2, 1, 2, 3, 4, 5, 4, 5, 3], 11]]}], "Mbpp/638": [{"task_id": "Mbpp/638", "solution": "import math\ndef wind_chill(velocity_kmh: float, temp_c: float) -> int:\n    \"\"\"Calculates the wind chill index using the standard formula and rounds to the nearest integer, with .5 rounding up.\"\"\"\n    # Constants for the wind chill formula (Canadian/North American standard)\n    A = 13.12\n    B = 0.6215\n    C = 11.37\n    D = 0.3965\n    V_EXP = 0.16\n\n    # Calculate V^0.16\n    v_pow = velocity_kmh ** V_EXP\n\n    # Apply the wind chill formula\n    raw_wci = A + (B * temp_c) - (C * v_pow) + (D * temp_c * v_pow)\n\n    # Round to the nearest integer, with .5 rounding up (away from zero)\n    if raw_wci >= 0:\n        return int(math.floor(raw_wci + 0.5))\n    else:\n        return int(math.ceil(raw_wci - 0.5))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/637": [{"task_id": "Mbpp/637", "solution": "import decimal\ndef noprofit_noloss(selling_price, cost_price):\n    \"\"\"\n    Checks if the selling price is exactly equal to the cost price, indicating no profit and no loss.\n    Internally converts inputs to Decimal for precise comparison.\n    \"\"\"\n    sp_decimal = decimal.Decimal(str(selling_price))\n    cp_decimal = decimal.Decimal(str(cost_price))\n    return sp_decimal == cp_decima