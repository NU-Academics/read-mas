stError(\"Cannot find minimum of empty sequence\")\n        for v in it:\n            if v < min_val:\n                min_val = v\n        return min_val\nclass ListAnalyzer:\n    \"\"\"Application-level service for list analysis, validating inputs and finding the minimum.\"\"\"\n    def __init__(self, finder: SmallestFinder) -> None:\n        self._finder = finder\n\n    def find_min(self, numbers: Sequence[Any]) -> float | int:\n        \"\"\"Validates the input sequence and delegates to SmallestFinder to find the minimum.\"\"\"\n        if not isinstance(numbers, (list, tuple)):\n            raise InvalidTypeError(\"Input must be a list or tuple\")\n        if len(numbers) == 0:\n            raise EmptyListError(\"Input sequence is empty\")\n        for i, v in enumerate(numbers):\n            if not is_numeric(v):\n                raise InvalidTypeError(f\"Element at index {i} is not numeric: {v!r}\")\n        return self._finder.find_smallest(numbers)\ndef smallest_num(numbers: Sequence[float|int]) -> float|int:\n    \"\"\"\n    Finds the smallest number in a list of numbers.\n    It delegates validation and the core algorithm to ListAnalyzer and SmallestFinder.\n    \"\"\"\n    analyzer = ListAnalyzer(SmallestFinder())\n    return analyzer.find_min(numbers)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/65": [{"task_id": "Mbpp/65", "solution": "import decimal\nfrom typing import Any, Iterator, Tuple, List\nclass InvalidElementError(Exception):\n    \"\"\"\n    Exception raised when non-numeric elements are encountered in strict mode.\n    Contains a list of (index_path, offending_value) tuples.\n    \"\"\"\n    def __init__(self, offending: List[Tuple[Tuple[int, ...], Any]]) -> None:\n        self._offending = offending\n        super().__init__(str(self))\n\n    def offending_elements(self) -> List[Tuple[Tuple[int, ...], Any]]:\n        return self._offending\n\n    def __str__(self) -> str:\n        return f\"Non-numeric elements encountered: {self._offending}\"\nNUMERIC_TYPES = (int, float, decimal.Decimal)\ndef is_numeric(value: Any) -> bool:\n    \"\"\"Checks if a value is an instance of a numeric type.\"\"\"\n    return isinstance(value, NUMERIC_TYPES)\ndef to_number(value: Any) -> float:\n    \"\"\"Converts a numeric value to a float.\"\"\"\n    if isinstance(value, decimal.Decimal):\n        return float(value)\n    if isinstance(value, (int, float)):\n        return float(value)\n    raise TypeError(f\"Value '{value}' is not numeric and cannot be converted.\")\nclass ListFlattener:\n    \"\"\"Recursively flattens nested iterables, yielding atomic elements with their index paths.\"\"\"\n    def flatten(self, iterable: Any) -> Iterator[Tuple[Tuple[int, ...], Any]]:\n        def _recur(obj: Any, path: Tuple[int, ...]):\n            if self._is_iterable(obj):\n                for i, child in enumerate(obj):\n                    yield from _recur(child, path + (i,))\n            else:\n                yield (path, obj)\n        \n        # If the root input is atomic, treat it as a single element with an empty path.\n        if not self._is_iterable(iterable) and not isinstance(iterable, (str, bytes, bytearray)):\n            yield ((), iterable)\n        else:\n            yield from _recur(iterable, ())\n\n    def _is_iterable(self, obj: Any) -> bool:\n        \"\"\"Helper to detect iterables excluding (str, bytes, bytearray).\"\"\"\n        return hasattr(obj, \"__iter__\") and not isinstance(obj, (str, bytes, bytearray))\ndef recursive_list_sum(iterable: Any, ignore_non_numeric: bool=False) -> float:\n    \"\"\"\n    Flattens a list and sums all its numeric elements.\n    Raises InvalidElementError if non-numeric elements are found and not ignored.\n    \"\"\"\n    flattener = ListFlattener()\n    total = 0.0\n    offending_elements: List[Tuple[Tuple[int, ...], Any]] = []\n\n    for path, val in flattener.flatten(iterable):\n        if is_numeric(val):\n            total += to_number(val)\n        else:\n            if ignore_non_numeric:\n                continue\n            offending_elements.append((path, val))\n    \n    if offending_elements and not ignore_non_numeric:\n        raise InvalidElementError(offending_elements)\n        \n    return total", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/67": [{"task_id": "Mbpp/67", "solution": "import collections\ndef bell_number(n: int) -> int:\n    \"\"\"\n    Computes the Bell number for a non-negative integer n using dynamic programming\n    based on the Bell triangle method.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    # Initialize the first row of the Bell triangle\n    # B(0,0) = 1\n    # B(1,0) = B(0,0) = 1\n    # B(1,1) = B(1,0) + B(0,0) = 1 + 1 = 2 (not used directly for B(n))\n    # B(0) = 1\n    # B(1) = 1\n    # B(2) = 2\n    # B(3) = 5\n    # The first element of row[i] is B_i, the Bell number for i.\n    # The Bell triangle:\n    # 1\n    # 1   2\n    # 2   3   5\n    # 5   7  10  15\n    # The first element of each row is the Bell number for that row index.\n    # row_i[0] = row_{i-1}[i-1]\n    # row_i[k] = row_i[k-1] + row_{i-1}[k-1]\n\n    # Use a deque for efficient popping from left.\n    # The current `row` will effectively be `row_{i-1}` from the description\n    # when computing the next row.\n    current_row = collections.deque([1])\n\n    for i in range(1, n + 1):\n        # The first element of the new row is the last element of the previous row.\n        # This is B(i,0) = B(i-1, i-1) in Bell's triangle definition.\n        # However, our current_row is actually the previous row,\n        # and its first element (current_row[0]) is B_{i-1}.\n        # The actual Bell triangle computation is:\n        # B_{n,0} = B_{n-1, n-1}\n        # B_{n,k} = B_{n,k-1} + B_{n-1, k-1}\n        # In this implementation:\n        # `new_row[0]` will be `current_row[-1]` (last element of prev row)\n