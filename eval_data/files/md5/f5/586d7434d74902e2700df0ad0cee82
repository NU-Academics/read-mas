teger and convert back to string.\n        incremented_prefix_int = int(prefix_to_increment) + 1\n        incremented_prefix_str = str(incremented_prefix_int)\n\n        # Rebuild the palindrome using the incremented prefix.\n        # The `len(incremented_prefix_str)` should be `prefix_len_for_increment` here,\n        # as the `all('9' for ch in s)` check handles cases where incrementing would increase length.\n        new_left_part = incremented_prefix_str\n        \n        # Construct the final palindrome string based on original length parity\n        if length % 2 == 1: # Original length was odd, so new_left_part includes the middle digit\n            final_palindrome_str = new_left_part + new_left_part[:-1][::-1]\n        else: # Original length was even\n            final_palindrome_str = new_left_part + new_left_part[::-1]\n            \n        return final_palindrome_str\n\n    # To find the \"next smallest palindrome strictly greater than n\",\n    # we start by considering `n + 1`.\n    # Then, we find the smallest palindrome that is greater than or equal to `n + 1`.\n    \n    start_num_for_search = n + 1\n    \n    # Convert to string to apply the digit-based palindrome logic.\n    start_num_str = str(start_num_for_search)\n    \n    # Get the smallest palindrome string greater than or equal to `start_num_str`.\n    result_str = _get_next_or_equal_palindrome_str(start_num_str)\n    \n    # Convert the resulting palindrome string back to an integer.\n    return int(result_str)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[8]]}], "Mbpp/106": [{"task_id": "Mbpp/106", "solution": "import collections.abc\nimport sys\nfrom typing import Iterable, Tuple, TypeVar, Any\nT = TypeVar(\"T\")\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid function inputs.\"\"\"\n    pass\nclass TupleBuilder:\n    \"\"\"Helper class to build new tuples from existing tuples and iterables.\"\"\"\n    def build(self, base: Tuple[T, ...], items: Iterable[T]) -> Tuple[T, ...]:\n        return tuple(base) + tuple(items)\nclass AppendService:\n    \"\"\"Service to append elements from an iterable to a tuple, with input validation.\"\"\"\n    def __init__(self, tuple_builder: TupleBuilder = None) -> None:\n        self.tuple_builder = tuple_builder or TupleBuilder()\n\n    def validate_inputs(self, items: Iterable, base: Any) -> None:\n        \"\"\"Validates that base is a tuple and items is an iterable.\"\"\"\n        if not isinstance(base, tuple):\n            raise InvalidInputError(\"base must be a tuple\")\n        if not isinstance(items, collections.abc.Iterable):\n            raise InvalidInputError(\"items must be iterable\")\n\n    def add_lists(self, items: Iterable[T], base: Tuple[T, ...]) -> Tuple[T, ...]:\n        \"\"\"Appends elements from an iterable to a tuple, returning a new tuple.\"\"\"\n        self.validate_inputs(items, base)\n        return self.tuple_builder.build(base, items)\n_default_service = AppendService(tuple_builder=TupleBuilder())\ndef add_lists(items: Iterable[T], base: Tuple[T, ...]) -> Tuple[T, ...]:\n    \"\"\"\n    Appends the elements of the given list (or any iterable) to the given tuple,\n    returning a new tuple.\n    \"\"\"\n    return _default_service.add_lists(items, base)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/104": [{"task_id": "Mbpp/104", "solution": "import collections.abc\nfrom typing import Any, Iterable, List\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input to the sorting functions.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\ndef is_iterable(obj: Any) -> bool:\n    \"\"\"Checks if an object is an iterable, excluding strings and bytes.\"\"\"\n    return isinstance(obj, collections.abc.Iterable) and not isinstance(obj, (str, bytes))\ndef deep_copy_list_of_lists(sublists: Iterable[Iterable[str]]) -> List[List[str]]:\n    \"\"\"Creates a deep copy of a list of lists of strings.\"\"\"\n    return [list(inner_list) for inner_list in sublists]\nclass InputValidator:\n    \"\"\"Validates and normalizes input to ensure it's a list of lists of strings.\"\"\"\n    def validate(self, sublists: Any) -> List[List[str]]:\n        if not is_iterable(sublists):\n            raise ValidationError(\"Input must be an iterable of iterables.\")\n        \n        normalized_result = []\n        for i, inner in enumerate(sublists):\n            if isinstance(inner, (str, bytes)):\n                raise ValidationError(f\"Element at outer[{i}] must be an iterable of strings, not a string.\")\n            if not is_iterable(inner):\n                raise ValidationError(f\"Inner element at outer[{i}] is not iterable.\")\n            \n            normalized_inner = []\n            for j, item in enumerate(inner):\n                if not isinstance(item, str):\n                    raise ValidationError(f\"Element at outer[{i}][{j}] is not a string.\")\n                normalized_inner.append(item)\n            normalized_result.append(normalized_inner)\n        return normalized_result\nclass SortService:\n    \"\"\"Provides the core logic for sorting sublists.\"\"\"\n    def sort_sublists(self, sublists: Iterable[Iterable[str]]) -> List[List[str]]:\n        # Make a defensive copy and sort each inner list.\n        copied = deep_copy_list_of_lists(sublists)\n        return [self._sort_single(inner) for inner in copied]\n\n    def _sort_single(self, sublist: List[str]) -> List[str]:\n        \"\"\"Returns a new list containing the sorted elements of the input sublist.\"\"\"\n        return sorted(sublist)\nclass SortController:\n    \"\"\"Orchestrates validation and sorting of sublists.\"\"\"\n    def __init__(self, validator: InputValidator, service: SortService) -> None:\n        self.validator = validator\n        self.service = service\n\n    def sort(self, sublists_input: Any) -> List[List[str]]:\n        \"\"\"Validates the input, sorts the sublists, and returns the result.\"\"\"\n        validated_input = self.validator.validate(sublists_input)\n        return self.service.sort_sublists(validated_input)\n_default_controller = SortController(InputValidator(), SortService())\ndef sort_sublists(sublists: Iterable[Iterable[str]]) -> List[List[str]]:\n    \"\"\"\n    Sorts each sublist of strings in a given list of lists.\n    Returns a new list of lists with inner lists sorted lexicographically.\n    \"\"\"\n    return _default_controller.sort(sublists)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/105": [{"task_id": "Mbpp/105", "solution": "import time\nimport logging\nfrom typing import List, Optional, Any, Sequence\nfrom abc import ABC, abstractmethod\nfrom dataclasses import dataclass\nclass InvalidItemTypeError(Exception):\n    def __init__(self, message: str, index: Optional[int] = None, item: Optional[Any] = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.index = index\n        self.item = item\nclass StatsRepository(ABC):\n    @abstractmethod\n    def save(self, entry: StatsEntry) -> None:\n        pass\n\n    @abstractmethod\n    def list_all(self) -> List[StatsEntry]:\n        pass\nclass InMemoryStatsRepository(StatsRepository):\n    def __init__(self) -> None:\n        self._entries: List[StatsEntry] = []\n\n    def save(self, entry: StatsEntry) -> None:\n        self._entries.append(entry)\n\n    def list_all(self) -> List[StatsEntry]:\n        return list(self._entries)\nclass Validator:\n    def validate_bool_list(self, items: Sequence[Any]) -> None:\n        for i, item in enumerate(items):\n            self._check_item(item, i)\n\n    def _check_item(self, item: Any, index: int) -> None:\n        if not isinstance(item, bool):\n            raise InvalidItemTypeError(f\"Item at index {index} is not a bool\", index=index, item=item)\nclass CounterService:\n    def __init__(self, repository: Optional[StatsRepository] = None) -> None:\n        self._repository = repository\n\n    def count_booleans(self, items: List[bool]) -> int:\n        Validator().validate_bool_list(items)\n        count = sum(1 for v in items if v is True)\n        if self._repository is not None:\n            try:\n                entry = StatsEntry(timestamp=time.time(), count=count)\n                self._repository.save(entry)\n            except Exception:\n                logging.exception(\"Repository save failed\")\n        return count\ndef count(items: List[bool]) -> int:\n    service = CounterService(repository=InMemoryStatsRepository())\n    return service.count_booleans(items)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/111": [{"task_id": "Mbpp/111", "solution": "from typing import List, Any, Set\ndef common_in_nested_lists(lists: List[List[Any]]) -> List[Any]:\n    # Handle the case where the input list of lists is empty.\n    if not lists:\n        return []\n\n    # Initialize the set of common elements with the elements from the first list.\n    common_elements_set: Set[Any] = set(lists[0])\n\n    # Iterate through the rest of the nested lists, intersecting with the current common set.\n    for sublist in lists[1:]:\n        common_elements_set = common_elements_set.intersection(sublist)\n        # If at any point the set becomes empty, no common elements exist in all lists.\n        if not common_elements_set:\n            return []\n\n    return list(common_elements_set)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/108": [{"task_id": "Mbpp/108", "solution": "from typing import Any\nfrom abc import ABC, abstractmethod\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input data.\"\"\"\n    pass\nclass ListValidator:\n    \"\"\"Validates and converts list elements to integers, and checks if a list is sorted.\"\"\"\n    def validate_and_convert(self, lst: Any) -> list[int]:\n        if not isinstance(lst, (list, tuple)):\n            raise InvalidInputError(\"Expected list-like input (list or tuple).\")\n        result = []\n        for idx, item in enumerate(lst):\n            try:\n                result.append(int(item))\n            except (ValueError, TypeError) as e:\n                raise InvalidInputError(f\"Element at index {idx} not convertible to int: {item}\") from e\n        return result\n\n    def is_sorted(self, lst: list[int]) -> bool:\n        \"\"\"Checks if a list is sorted in non-decreasing order.\"\"\"\n        return all(lst[i] <= lst[i+1] for i in range(len(lst) - 1))\nclass Sorter(ABC):\n    \"\"\"Abstract base class for sorting strategies.\"\"\"\n    @abstractmethod\n    def sort(self, lst: list[int]) -> list[int]:\n        pass\nclass DefaultSorter(Sorter):\n    \"\"\"A sorter implementation using Python's built-in sorted() function.\"\"\"\n    def sort(self, lst: list[int]) -> list[int]:\n        return sorted(lst)\nclass ThreeWayMerger:\n    \"\"\"Implements an efficient three-way merge algorithm for already-sorted lists.\"\"\"\n    def three_way_merge(self, a: list[int], b: list[int], c: list[int]) -> list[int]:\n        i = j = k = 0\n        out = []\n        len_a, len_b, len_c = len(a), len(b), len(c)\n\n        while i < len_a or j < len_b or k < len_c:\n            candidates = []\n            if i < len_a:\n                candidates.append((a[i], 'a'))\n            if j < len_b:\n                candidates.append((b[j], 'b'))\n            if k < len_c:\n                candidates.append((c[k], 'c'))\n\n            if not candidates:\n                break # All lists exhausted\n\n            # Find the minimum value among the candidates\n            min_val, source = min(candidates, key=lambda x: x[0])\n            out.append(min_val)\n\n            # Advance the pointer for the list from which the minimum was taken\n            if source == 'a':\n                i += 1\n            elif source == 'b':\n                j += 1\n            else: # source == 'c'\n                k += 1\n        return out\nclass MergeService:\n    \"\"\"Orchestrates the merging process, including validation, sorting, and merging.\"\"\"\n    def __init__(self, validator: ListValidator, sorter: Sorter, merger: ThreeWayMerger) -> None:\n        self.validator = validator\n        self.sorter = sorter\n        self.merger = merger\n\n    def merge_sorted_lists(self, a: Any, b: Any, c: Any) -> list[int]:\n        \"\"\"Validates, sorts if necessary, and merges three lists into a single sorted list.\"\"\"\n        a_conv = self.validator.validate_and_convert(a)\n        b_conv = self.validator.validate_and_convert(b)\n        c_conv = self.validator.validate_and_convert(c)\n\n        # Check if all inputs are already sorted to apply an O(n) merge directly\n        if self.validator.is_sorted(a_conv) and \\\n           self.validator.is_sorted(b_conv) and \\\n           self.validator.is_sorted(c_conv):\n            return self.merger.three_way_merge(a_conv, b_conv, c_conv)\n        else:\n            # If not all sorted, sort them individually first (O(N log N))\n            a_sorted = self.sorter.sort(a_conv)\n            b_sorted = self.sorter.sort(b_conv)\n            c_sorted = self.sorter.sort(c_conv)\n            return self.merger.three_way_merge(a_sorted, b_sorted, c_sorted)\ndef merge_sorted_list(a: list, b: list, c: list) -> list[int]:\n    \"\"\"Merges three lists into a single sorted list, handling unsorted inputs and type conversion.\"\"\"\n    service = MergeService(\n        validator=ListValidator(),\n        sorter=DefaultSorter(),\n        merger=ThreeWayMerger(),\n    )\n    return service.merge_sorted_lists(a, b, c)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[1.5, 2.5, 3.5, 4.5, 5.5], 