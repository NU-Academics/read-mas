 correctness tests.\"\"\"\n    def count(self, array: Sequence[int]) -> int:\n        arr = list(array)\n        n = len(arr)\n        cnt = 0\n        for i in range(n):\n            for j in range(i+1, n):\n                if arr[i] > arr[j]:\n                    cnt += 1\n        return cnt\nclass Config:\n    \"\"\"Runtime configuration and defaults.\"\"\"\n    DEFAULT_DB_PATH: str = \"invcount_results.db\"\n    MAX_PERSIST_LENGTH: int = 10000\n    DEFAULT_ALGORITHM: str = \"merge\"\n    PERSIST: bool = False # Default persistence disabled\nclass Validator:\n    \"\"\"Validation helpers for arrays, ensuring elements are comparable integers.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def validate_array(self, array: Any) -> List[int]:\n        if not isinstance(array, (list, tuple)):\n            raise InversionError(\"Input must be a list or tuple.\", code=400)\n        \n        if not array:\n            return []\n\n        try:\n            validated_arr = [int(x) for x in array]\n        except (ValueError, TypeError):\n            raise InversionError(\"All array elements must be convertible to integers.\", code=400)\n        \n        return validated_arr\n\n    def is_comparable(self, array: Sequence[Any]) -> bool:\n        # Assumes elements are already numeric or will be handled by validate_array.\n        return True\nclass ArrayRepository:\n    \"\"\"Persistence adapter using SQLite, stubbed for this function's immediate needs.\"\"\"\n    def __init__(self, db_path: str) -> None:\n        self.db_path = db_path\n\n    def init_db(self) -> None:\n        pass\n\n    def save_result(self, input: ArrayInput, result: InversionResult) -> int:\n        return 1\n\n    def query_recent(self, limit: int = 100) -> List[Dict[str, Any]]:\n        return []\nclass InversionService:\n    \"\"\"Core orchestration; validates input, selects algorithm, computes, and optionally persists.\"\"\"\n    def __init__(self, algorithm_strategy: Optional[object] = None, repository: Optional[ArrayRepository] = None, config: Optional[Config] = None) -> None:\n        self.validator = Validator()\n        self.algorithm_strategy = algorithm_strategy or MergeSortCounter()\n        self.repository = repository\n        self.config = config or Config()\n\n    def count_inversions(self, array: Sequence[int], algorithm: Optional[str] = None) -> InversionResult:\n        arr = self.validator.validate_array(array)\n        algo_name_str = algorithm or self.config.DEFAULT_ALGORITHM\n        \n        current_strategy = self.algorithm_strategy\n        if algorithm is not None:\n             if algo_name_str == \"merge\":\n                 current_strategy = MergeSortCounter()\n             elif algo_name_str == \"bruteforce\":\n                 current_strategy = BruteForceCounter()\n             else:\n                 # Default to merge if an unknown algorithm string is provided.\n                 current_strategy = MergeSortCounter()\n                 algo_name_str = \"merge\" # Update algo_name_str for the result object\n\n        start = time.perf_counter()\n        \n        if hasattr(current_strategy, \"count\"):\n            result = current_strategy.count(arr)\n            count = result[0] if isinstance(result, tuple) else int(result)\n        else:\n            raise InversionError(\"Invalid algorithm strategy provided.\", code=500)\n            \n        duration_ms = (time.perf_counter() - start) * 1000.0\n        \n        # Determine algorithm name for the result object based on the actual strategy used.\n        if isinstance(current_strategy, MergeSortCounter):\n            algo_name_for_result = \"merge\"\n        elif isinstance(current_strategy, BruteForceCounter):\n            algo_name_for_result = \"bruteforce\"\n        else:\n            algo_name_for_result = algo_name_str # Fallback to passed/default string\n\n        inv_result = InversionResult(count=count, algorithm=algo_name_for_result, duration_ms=duration_ms)\n        \n        if self.repository and self.config.PERSIST and len(arr) <= self.config.MAX_PERSIST_LENGTH:\n            try:\n                self.repository.save_result(ArrayInput(arr), inv_result)\n            except Exception:\n                # In a real application, an error here should be logged.\n                pass\n        return inv_result\n\n    def get_inv_count(self, array: Sequence[int]) -> int:\n        \"\"\"A backwards-compatible wrapper to directly return the inversion count.\"\"\"\n        return self.count_inversions(array).count\ndef get_Inv_Count(array: Sequence[int]) -> int:\n    \"\"\"\n    Counts inversions in an array using the default inversion service.\n    This function is a compatibility wrapper for `InversionService.get_inv_count`.\n    \"\"\"\n    service = InversionService()\n    return service.get_inv_count(array)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/301": [{"task_id": "Mbpp/301", "solution": "from typing import Any, Set\nclass DepthError(Exception):\n    \"\"\"Custom exception for depth calculation errors, like cycles.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\ndef dict_depth(obj: Any, strict: bool = False) -> int:\n    \"\"\"\n    Calculates the maximum depth of nested dictionaries, handling non-dict objects and cycles.\n    Raises DepthError for cycles or if strict mode validation fails for the top-level object.\n    \"\"\"\n    if strict and not isinstance(obj, dict):\n        raise DepthError(\"Top-level object must be a dictionary in strict mode.\")\n\n    visited_ids: Set[int] = set()\n\n    def _recursive_depth(current_obj: Any) -> int:\n        if not isinstance(current_obj, dict):\n            return 0\n\n        obj_id = id(current_obj)\n        if obj_id in visited_ids:\n            raise DepthError(\"Cycle detected in dictionary structure\")\n\n        visited_ids.add(obj_id)\n\n        max_child_depth = 0\n        for value in current_obj.values():\n            if isinstance(value, dict):\n                child_depth = _recursive_depth(value)\n                max_child_depth = max(max_child_depth, child_depth)\n\n        visited_ids.remove(obj_id)\n\n        return 1 + max_child_depth\n\n    return _recursive_depth(obj)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/309": [{"task_id": "Mbpp/309", "solution": "def maximum(a, b):\n    \"\"\"\n    Compares two numbers and returns the larger one as a float.\n    If values are equal, the first argument 'a' is returned, converted to float.\n    \"\"\"\n    if a >= b:\n        return float(a)\n    else:\n        return float(b)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[-9876543210987654321098765, -1234567890123456789012345]]}], "Mbpp/306": [{"task_id": "Mbpp/306", "solution": "from typing import List\nclass MSISError(Exception):\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\nclass MSISInvalidInputError(MSISError):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass MSISRepository:\n    def compute_prefix_dp(self, arr: List[int], i: int) -> List[int]:\n        \"\"\"\n        Computes the maximum sum of an increasing subsequence ending at each index j in 0..i.\n        \"\"\"\n        if i < 0:\n            raise MSISInvalidInputError(\"Index 'i' must be non-negative for DP computation.\")\n        \n        dp = [0] * (i + 1)\n        for j in range(i + 1):\n            dp[j] = arr[j] # Initialize with the element itself\n            for t in range(j):\n                if arr[t] < arr[j]:\n                    dp[j] = max(dp[j], dp[t] + arr[j])\n        return dp\n\n    def compute_with_k(self, arr: List[int], i: int, k: int) -> int:\n        \"\"\"\n        Calculates the maximum sum of increasing subsequence including arr[k]\n        after a prefix subsequence ending at an index j <= i.\n        \"\"\"\n        prefix_dp_sums = self.compute_prefix_dp(arr, i)\n        \n        best_prefix_sum = 0\n        for j in range(i + 1):\n            if arr[j] < arr[k]: # Only consider prefix sums where arr[j] can be followed by arr[k]\n                best_prefix_sum = max(best_prefix_sum, prefix_dp_sums[j])\n        \n        # If no suitable prefix element was found, the subsequence is just arr[k]\n        return best_prefix_sum + arr[k] if best_prefix_sum > 0 else arr[k]\nclass MSISService:\n    def __init__(self, repo: MSISRepository = None) -> None:\n        self.repo = repo or MSISRepository()\n\n    def compute(self, arr: List[int], n: int, i: int, k: int) -> int:\n        \"\"\"\n        Validates inputs and computes the maximum sum of increasing subsequence.\n        \"\"\"\n        validate_indices(arr, n, i, k)\n        return self.repo.compute_with_k(arr, i, k)\nclass MSISController:\n    def __init__(self, service: MSISService = None) -> None:\n        self.service = service or MSISService()\n\n    def max_sum(self, arr: List[int], n: int, i: int, k: int) -> int:\n        \"\"\"\n        Acts as a controller for the maximum sum increasing subsequence computation.\n        \"\"\"\n        return self.service.compute(arr, n, i, k)\ndef max_sum_increasing_subseq(arr: List[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence from a prefix until index i,\n    including a given k-th element (k > i).\n    \"\"\"\n    controller = MSISController()\n    return controller.max_sum(arr, n, i, k)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, 101, 2, 3, 100, 4, 5], 7, 4, 6]], "plus_fail_tests": [[[5, 2, 4, 1, 3, 6], 6, 1, 3]]}], "Mbpp/308": [{"task_id": "Mbpp/308", "solution": "import heapq\nfrom typing import List\ndef large_product(a: List[float], b: List[float], k: int) -> List[float]:\n    \"\"\"Finds the specified number of largest products from two lists, selecting one factor from each.\n    Uses a heap-based approach to efficiently retrieve the top K products.\n    \"\"\"\n    a_sorted = sorted(a, reverse=True)\n    b_sorted = sorted(b, reverse=True)\n\n    len_a = len(a_sorted)\n    len_b = len(b_sorted)\n\n    if len_a == 0 or len_b == 0:\n        return []\n\n    products = []\n    # Min-heap to store (-product, i, j) to simulate a max-heap.\n    heap = []\n    # Set to keep track of (i, j) pairs already added to the heap.\n    visited = set()\n\n    # Start with the largest product formed by the first elements.\n    initial_product = float(a_sorted[0]) * float(b_sorted[0])\n    heapq.heappush(heap, (-initial_product, 0, 0))\n    visited.add((0, 0))\n\n    while len(products) < k and heap:\n        neg_prod, i, j = heapq.heappop(heap)\n        products.append(-neg_prod)\n\n        # Explore the next product by incrementing the index in list 'a'.\n        if i + 1 < len_a and (i + 1, j) not in visited:\n            next_prod_a = float(a_sorted[i + 1]) * float(b_sorted[j])\n            heapq.heappush(heap, (-next_prod_a, i + 1, j))\n            visited.add((i + 1, j))\n\n        # Explore the next product by incrementing the index in list 'b'.\n        if j + 1 < len_b and (i, j + 1) not in visited:\n            next_prod_b = float(a_sorted[i]) * float(b_sorted[j + 1])\n            heapq.heappush(heap, (-next_prod_b, i, j + 1))\n            visited.add((i, j + 1))\n\n    return products", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[-14, 95, -14, true, -100, true, -93, -93, 28, -100, -58, -93], [-14, 95, -14, true, -100, true, -93, -93, 28, -100, -58, -93], 1]]}], "Mbpp/311": [{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(n: int) -> int:\n    \"\"\"\n    Sets the left-most (most significant) unset bit in the given non-negative integer.\n    If all bits up to the most significant set bit are already set, the next higher bit is set.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    # Find the position of the most significant set bit (0-indexed).\n    pos = n.bit_length() - 1\n\n    # Iterate from the MSB position down to 0 to find the first unset bit.\n    for k in range(pos, -1, -1):\n        if not (n >> k) & 1:  # Check if the k-th bit is 0\n            return n | (1 << k) # Set the found unset bit\n\n    # If all bits from 0 to 'pos' are set, set the next higher bit (pos + 1).\n    return n | (1 << (pos + 1))", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[15]], "plus_fail_tests": [[255]]}], "Mbpp/310": [{"task_id": "Mbpp/310", "solution": "def string_to_tuple(s: str) -> tuple:\n    \"\"\"Converts a string to a tuple of its characters, removing whitespace.\"\"\"\n    chars = []\n    for char in s:\n        if not char.isspace():\n            chars.append(char)\n    return tuple(chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/388": [{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n):\n    \"\"\"\n    Finds the highest power of 2 that is less than or equal to n using bit manipulation.\n    Assumes n is a positive integer.\n    \"\"\"\n    return 1 << (n.bit_length() - 1)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/390": [{"task_id": "Mbpp/390", "solution": "from typing import List, Any\ndef add_string(elements: List[Any], fmt: str) -> List[str]:\n    \"\"\"Applies a format string to each element in a list.\"\"\"\n    return [fmt.format(element) for element in elements]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/312": [{"task_id": "Mbpp/312", "solution": "import math\nfrom typing import Optional\nclass ValidationError(Exception):\n    \"\"\"Custom exception for input validation errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n    def __str__(self) -> str:\n        return self.message\nclass Cone:\n    \"\"\"Represents a cone with a given radius and height, and handles validation.\"\"\"\n    def __init__(self, radius: float, height: float) -> None:\n        try:\n            self.radius: float = float(radius)\n            self.height: float = float(height)\n        except (TypeError, ValueError):\n            raise ValidationError(\"radius and height must be numeric\")\n        self.validate()\n\n    def validate(self) -> None:\n        \"\"\"Validates that radius and height are non-negative.\"\"\"\n        if self.radius < 0 or self.height < 0:\n            raise ValidationError(\"radius and height must be non-negative\")\nclass MathUtils:\n    \"\"\"Provides mathematical constants and utility functions.\"\"\"\n    PI: float = math.pi\n\n    @staticmethod\n    def square(x: float) -> float:\n        \"\"\"Calculates the square of a number.\"\"\"\n        return x * x\nclass VolumeCalculator:\n    \"\"\"Calculates the volume of a cone.\"\"\"\n    def compute_volume(self, cone: Cone) -> float:\n        \"\"\"Computes the volume using the cone's radius and height.\"\"\"\n        return self._compute_formula(cone.radius, cone.height)\n\n    def _compute_formula(self, radius: float, height: float) -> float:\n        \"\"\"Applies the cone volume formula.\"\"\"\n        return (1.0 / 3.0) * MathUtils.PI * MathUtils.square(radius) * height\nclass ConeController:\n    \"\"\"Coordinates cone volume calculation, including validation and optional persistence.\"\"\"\n    def __init__(self, calculator: VolumeCalculator = None, repository: Optional[\"ConeRepository\"] = None) -> None:\n        self._calculator = calculator or VolumeCalculator()\n        self._repository = repository\n\n    def volume_from_params(self, radius: float, height: float) -> float:\n        \"\"\"Computes cone volume from given parameters, validates, and optionally saves.\"\"\"\n        cone = Cone(radius, height)\n        volume = self._calculator.compute_volume(cone)\n        if self._repository:\n            try:\n                # The repository is an optional dependency and its failure should not block calculation.\n                self._repository.save(cone, volume)\n            except Exception:\n                pass\n        return volume\ndef volume_cone(radius: float, height: float) -> float:\n    \"\"\"Calculates the volume of a cone given its radius and height.\"\"\"\n    return ConeController().volume_from_params(radius, height)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/389": [{"task_id": "Mbpp/389", "solution": "import abc\nfrom typing import Dict, Optional\nclass CacheRepository(abc.ABC):\n    \"\"\"Abstract base class for a cache repository.\"\"\"\n    @abc.abstractmethod\n    def get(self, n: int) -> Optional[int]:\n        pass\n\n    @abc.abstractmethod\n    def set(self, n: int, value: int) -> None:\n        pass\n\n    @abc.abstractmethod\n    def clear(self) -> None:\n        pass\nclass InMemoryCacheRepository(CacheRepository):\n    \"\"\"In-memory implementation of CacheRepository.\"\"\"\n    def __init__(self) -> None:\n        self._store: Dict[int, int] = {}\n\n    def get(self, n: int) -> Optional[int]:\n        return self._store.get(n)\n\n    def set(self, n: int, value: int) -> None:\n        self._store[n] = value\n\n    def clear(self) -> None:\n        self._store.clear()\nclass LucasService:\n    \"\"\"Service to compute Lucas numbers, with optional caching.\"\"\"\n    def __init__(self, cache: CacheRepository | None = None) -> None:\n        self.cache = cache if cache is not None else InMemoryCacheRepository()\n\n    def find_lucas(self, n: int) -> int:\n        \"\"\"Computes the n'th Lucas number, utilizing a cache.\"\"\"\n        # Input validation (n >= 0 and is int) is omitted due to specific prompt constraints