provides safe accessors.\"\"\"\n    def __init__(self, grid: List[List[Union[int,float]]]) -> None:\n        self._grid = [list(map(float, row)) for row in grid]\n        self.rows = len(self._grid)\n        self.cols = len(self._grid[0]) if self.rows else 0\n\n    def get(self, r: int, c: int) -> float:\n        \"\"\"Returns the value at the specified row and column.\"\"\"\n        return self._grid[r][c]\n\n    def as_list(self) -> List[List[float]]:\n        \"\"\"Returns a shallow copy of the internal grid representation.\"\"\"\n        return [row[:] for row in self._grid]\nclass PathResult:\n    \"\"\"DTO for storing path sum, length, and average.\"\"\"\n    def __init__(self, sum_val: float, length: int) -> None:\n        self.sum = sum_val\n        self.length = length\n        if length <= 0:\n            raise ValueError(\"Path length must be positive to compute average.\")\n        self.average = sum_val / length\nclass MaxSumSolver:\n    \"\"\"Computes the maximum sum path from top-left to bottom-right.\"\"\"\n    def __init__(self, optimized_space: bool = True) -> None:\n        self.optimized_space = optimized_space\n\n    def solve(self, matrix: MatrixModel) -> PathResult:\n        \"\"\"Solves for the maximum path sum and returns a PathResult DTO.\"\"\"\n        if matrix.rows == 0 or matrix.cols == 0:\n            raise SolverError(\"Empty matrix\")\n        \n        path_length = matrix.rows + matrix.cols - 1\n\n        if self.optimized_space:\n            max_sum = self._solve_optimized(matrix)\n        else:\n            max_sum = self._solve_full_dp(matrix)\n        \n        return PathResult(max_sum, path_length)\n\n    def _solve_full_dp(self, matrix: MatrixModel) -> float:\n        \"\"\"Computes max sum using full O(rows*cols) DP table.\"\"\"\n        r, c = matrix.rows, matrix.cols\n        dp = [[0.0] * c for _ in range(r)]\n\n        for i in range(r):\n            for j in range(c):\n                val = matrix.get(i, j)\n                if i == 0 and j == 0:\n                    dp[i][j] = val\n                else:\n                    top = dp[i-1][j] if i > 0 else float('-inf')\n                    left = dp[i][j-1] if j > 0 else float('-inf')\n                    dp[i][j] = val + max(top, left)\n        return dp[-1][-1]\n\n    def _solve_optimized(self, matrix: MatrixModel) -> float:\n        \"\"\"Computes max sum using space-optimized DP.\"\"\"\n        r, c = matrix.rows, matrix.cols\n        \n        if c <= r: # Iterate row-by-row, dp array size c\n            dp = [float('-inf')] * c\n            for i in range(r):\n                for j in range(c):\n                    val = matrix.get(i, j)\n                    if i == 0 and j == 0:\n                        dp[j] = val\n                    else:\n                        top = dp[j] if i > 0 else float('-inf')\n                        left = dp[j-1] if j > 0 else float('-inf')\n                        dp[j] = val + max(top, left)\n            return dp[-1]\n        else: # Iterate column-by-column, dp array size r\n            dp = [float('-inf')] * r\n            for j in range(c):\n                for i in range(r):\n                    val = matrix.get(i, j)\n                    if i == 0 and j == 0:\n                        dp[i] = val\n                    else:\n                        top = dp[i-1] if i > 0 else float('-inf')\n                        left = dp[i] if j > 0 else float('-inf')\n                        dp[i] = val + max(left, top)\n            return dp[-1]\ndef maxAverageOfPath(matrix: List[List[Union[int, float]]]) -> float:\n    \"\"\"\n    Given a square matrix, finds a path from top-left to bottom-right (only right/down moves)\n    with the maximum average cost.\n    \"\"\"\n    norm = validate_matrix(matrix)\n    model = MatrixModel(norm)\n    solver = MaxSumSolver()\n    result = solver.solve(model)\n    return result.average", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_f