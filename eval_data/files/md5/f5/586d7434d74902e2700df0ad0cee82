em}.\")\nclass CacheRepository:\n    \"\"\"In-memory cache for computed results with simple FIFO eviction.\"\"\"\n    DEFAULT_MAX_CACHE_SIZE: int = 1000\n\n    def __init__(self, max_size: Optional[int] = None) -> None:\n        self._store: Dict[Tuple[int, ...], int] = {}\n        self._order: Deque[Tuple[int, ...]] = collections.deque()\n        self._max_size = max_size if max_size is not None else self.DEFAULT_MAX_CACHE_SIZE\n\n    def get(self, key: Tuple[int, ...]) -> Optional[int]:\n        \"\"\"Retrieves a value from the cache.\"\"\"\n        return self._store.get(key)\n\n    def set(self, key: Tuple[int, ...], value: int) -> None:\n        \"\"\"\n        Stores a value in the cache, managing size with a simple FIFO eviction.\n        If a key is already present, its value is updated, but its position in the eviction order remains unchanged.\n        \"\"\"\n        if self._max_size == 0:\n            return\n\n        if key not in self._store:\n            if len(self._store) >= self._max_size:\n                oldest_key = self._order.popleft()\n                del self._store[oldest_key]\n            self._order.append(key)\n        self._store[key] = value\n\n    def clear(self) -> None:\n        \"\"\"Clears the entire cache.\"\"\"\n        self._store.clear()\n        self._order.clear()\ndef list_to_key(arr: List[int]) -> Tuple[int, ...]:\n    \"\"\"Converts a list to a tuple for use as a cache key.\"\"\"\n    return tuple(arr)\nclass OddLengthSumCalculator(abc.ABC):\n    \"\"\"Abstract base class for odd length subarray sum calculators.\"\"\"\n    @abc.abstractmethod\n    def calculate(self, arr: List[int]) -> int:\n        \"\"\"Calculates the sum of all odd-length contiguous subarrays.\"\"\"\n        pass\nclass OptimizedOddLengthSumCalculator(OddLengthSumCalculator):\n    \"\"\"\n    Calculates the sum of all odd-length contiguous subarrays using an O(n) algorithm.\n    It counts how many odd-length subarrays each element belongs to.\n    \"\"\"\n    def calculate(self, arr: List[int]) -> int:\n        n = len(arr)\n        total = 0\n        for i, val in enumerate(arr):\n            # The total number of subarrays containing arr[i] is (i + 1) * (n - i).\n            # The number of odd-length subarrays among them is ceil(total_subarrays / 2).\n            total_subarrays_containing_val = (i + 1) * (n - i)\n            odd_count = (total_subarrays_containing_val + 1) // 2\n            total += val * odd_count\n        return total\nclass OddLengthSumService:\n    \"\"\"Orchestrates validation, caching, and calculation of odd length subarray sums.\"\"\"\n    def __init__(self, calculator: OddLengthSumCalculator, cache: CacheRepository, validator: InputValidator, cache_enabled: bool = True) -> None:\n        \"\"\"Initializes the service with dependencies.\"\"\"\n        self._calculator = calculator\n        self._cache = cache\n        self._validator = validator\n        self._cache_enabled = cache_enabled\n\n    def calculate(self, arr: List[int]) -> int:\n        \"\"\"\n        Calculates the sum of all odd-length contiguous subarrays for the given array.\n        Validates input, checks cache, performs calculation, and updates cache.\n        \"\"\"\n        self._validator.validate(arr)\n        \n        if self._cache_enabled and self._cache:\n            key = list_to_key(arr)\n            if (cached := self._cache.get(key)) is not None:\n                return cached\n        \n        result = self._calculator.calculate(arr)\n        \n        if self._cache_enabled and self._cache:\n            key = list_to_key(arr)\n            self._cache.set(key, result)\n            \n        return result\n\n    def clear_cache(self) -> None:\n        \"\"\"Clears the internal cache.\"\"\"\n        if self._cache:\n            self._cache.clear()\ndef odd_length_sum(arr: List[int]) -> int:\n    \"\"\"\n    Finds the sum of all odd-length subarrays using an optimized O(n) algorithm.\n    Includes input validation and in-memory caching.\n    \"\"\"\n    validator = InputValidator()\n    cache = CacheRepository(max_size=1000)\n    calc = OptimizedOddLengthSumCalculator()\n    service = OddLengthSumService(calculator=calc, cache=cache, validator=validator, cache_enabled=True)\n    return service.calculate(arr)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[false, true, false]]]}], "Mbpp/787": [{"task_id": "Mbpp/787", "solution": "import re\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\nclass Config:\n    \"\"\"Configuration constants for the text matcher.\"\"\"\n    PATTERN_THREE_B: str = r\"^ab{3}$\"\n    MAX_INPUT_LENGTH: int = 10000\nclass RegexMatcher:\n    \"\"\"Handles regex compilation and matching.\"\"\"\n    def __init__(self, pattern: str) -> None:\n        self._pattern = pattern\n        self._compiled = re.compile(pattern)\n\n    def matches(self, text: str) -> bool:\n        \"\"\"Returns True if the text fully matches the compiled regex pattern.\"\"\"\n        return self._compiled.fullmatch(text) is not None\nclass TextValidator:\n    \"\"\"Validates input text for type and length.\"\"\"\n    def validate_text(self, text: str, max_length: int) -> bool:\n        \"\"\"Checks if text is a string and within maximum length, raising InvalidInputError if not.\"\"\"\n        if not isinstance(text, str):\n            raise InvalidInputError(\"Input must be a string\")\n        if len(text) > max_length:\n            raise InvalidInputError(f\"Input exceeds maximum length of {max_length}\")\n        return True\nclass TextMatchService:\n    \"\"\"Core business logic for matching \"a\" followed by three \"b\"s.\"\"\"\n    def __init__(self, matcher: RegexMatcher, validator: TextValidator) -> None:\n        self._matcher = matcher\n        self._validator = validator\n\n    def match_three(self, text: str) -> bool:\n        \"\"\"Validates and matches the input text against the pattern.\"\"\"\n        self._validator.validate_text(text, Config.MAX_INPUT_LENGTH)\n        return self._matcher.matches(text)\ndef text_match_three(text: str) -> bool:\n    \"\"\"\n    Checks if a string consists of an 'a' followed by exactly three 'b' characters.\n    Raises InvalidInputError for non-string or excessively long inputs.\n    \"\"\"\n    matcher = RegexMatcher(Config.PATTERN_THREE_B)\n    validator = TextValidator()\n    service = TextMatchService(matcher, validator)\n    return service.match_three(text)", "base_status": "fail", "plus_status": "pass", "base_fail_tests": [["abbbba"]], "plus_fail_tests": []}], "Mbpp/790": [{"task_id": "Mbpp/790", "solution": "from typing import List\ndef even_position(lst: List[int]) -> bool:\n    \"\"\"\n    Checks if every even index in the list contains an even number.\n    Assumes the input list contains integers.\n    \"\"\"\n    for i in range(0, len(lst), 2):\n        if lst[i] % 2 != 0:\n            return False\n    return True", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[2, 1, 4, 2, 6, 1, 8, 2, 10, 1, 12]]]}], "Mbpp/788": [{"task_id": "Mbpp/788", "solution": "import collections\ndef new_tuple(items: collections.abc.Iterable, suffix: str) -> tuple:\n    \"\"\"\n    Creates a new tuple by appending a string suffix to the elements of an iterable.\n    \"\"\"\n    return tuple(list(items) + [suffix])", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/791": [{"task_id": "Mbpp/791", "solution": "from typing import Any, Tuple\ndef remove_nested(input_tuple: Tuple[Any, ...]) -> Tuple[Any, ...]:\n    \"\"\"\n    Returns a new tuple with any top-level elements that are tuple instances removed.\n    Preserves order and identity of non-tuple values.\n    \"\"\"\n    return tuple(el for el in input_