tional[Config]=None) -> Dict[Any, Any]:\n        \"\"\"Returns a new dictionary with items whose values are considered empty removed.\"\"\"\n        current_checker = EmptyChecker(config) if config else self._checker\n\n        filtered_dict = {}\n        for key, value in mapping.items():\n            if not current_checker.is_empty(value):\n                filtered_dict[key] = value\n        return filtered_dict\nclass APIAdapter:\n    \"\"\"Adapts DropEmptyService for simple API consumption.\"\"\"\n    def __init__(self, service: DropEmptyService) -> None:\n        self._service = service\n\n    def drop_empty(self, mapping: Mapping[Any, Any], config: Optional[Config]=None) -> Dict[Any, Any]:\n        \"\"\"Delegates to the core service to drop empty items.\"\"\"\n        return self._service.drop_empty(mapping, config)\ndef drop_empty(d: dict, config: Optional[Config]=None) -> dict:\n    \"\"\"Drops items with empty values from the given dictionary.\"\"\"\n    checker = EmptyChecker(DEFAULT_CONFIG)\n    service = DropEmptyService(checker)\n    adapter = APIAdapter(service)\n\n    return adapter.drop_empty(d, config)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/474": [{"task_id": "Mbpp/474", "solution": "def replace_char(original: str, old: str, new: str) -> str:\n    \"\"\"Replaces all occurrences of a character in a string with another character.\"\"\"\n    return original.replace(old, new)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/477": [{"task_id": "Mbpp/477", "solution": "def is_lower(s: str) -> str:\n    \"\"\"Converts the given string to lower case.\"\"\"\n    return s.lower()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/476": [{"task_id": "Mbpp/476", "solution": "import json\nfrom typing import Any, Sequence, Union\nclass BigSumError(Exception):\n    \"\"\"Custom exception for big_sum errors.\"\"\"\n    def __init__(self, message: str, *, cause: Exception | None = None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.cause = cause\nNumber = Union[float, int]\nclass BigSumResult:\n    \"\"\"Result data model for big_sum computation.\"\"\"\n    def __init__(self, min_value: Number, max_value: Number) -> None:\n        self.min_value = min_value\n        self.max_value = max_value\n        self.sum = min_value + max_value\n\n    def to_dict(self) -> dict[str, Number]:\n        return {\"min\": self.min_value, \"max\": self.max_value, \"sum\": self.sum}\nclass ArrayValidator:\n    \"\"\"Validates and normalizes input arrays, ensuring they are non-empty sequences of numbers.\"\"\"\n    def _is_number(self, value: Any) -> bool:\n        \"\"\"Helper to check if a value is an int or float, explicitly excluding booleans.\"\"\"\n        return isinstance(value, (int, float)) and not isinstance(value, bool)\n\n    def validate(self, arr: Any) -> Sequence[Number]:\n        if arr is None:\n            raise BigSumError(\"Input is None\")\n\n        if isinstance(arr, str):\n            arr = arr.strip()\n            try:\n                parsed = json.loads(arr)\n                arr = parsed\n            except json.JSONDecodeError:\n                # If not valid JSON, try parsing as comma-separated values\n                arr = [x.strip() for x in arr.split(\",\") if x.strip() != \"\"]\n            except Exception as e:\n                raise BigSumError(f\"Invalid string input format: '{arr}'\", cause=e)\n\n        try:\n            # Convert to list for consistent processing and to handle generators/other iterables\n            seq = list(arr)\n        except TypeError:\n            raise BigSumError(\"Input is not iterable\")\n\n        if len(seq) == 0:\n            raise BigSumError(\"Input sequence is empty\")\n\n        normalized = []\n        for i, v in enumerate(seq):\n            if self._is_number(v):\n                normalized.append(v)\n            elif isinstance(v, str):\n                try:\n                    # Allow numeric strings to be converted to float\n                    normalized.append(float(v))\n                except ValueError:\n                    raise BigSumError(f\"Non-numeric element at index {i}: '{v}'\")\n            else:\n                raise BigSumError(f\"Non-numeric element at index {i}: {v}\")\n        return normalized\nclass BigSumService:\n    \"\"\"Provides the core algorithm to compute the min, max, and their sum in a single pass.\"\"\"\n    def compute(self, arr: Sequence[Number]) -> BigSumResult:\n        if not arr:\n            # Defensive check; validator should prevent this, but good practice\n            raise BigSumError(\"Array cannot be empty for computation.\")\n\n        min_val = arr[0]\n        max_val = arr[0]\n\n        for v in arr[1:]:\n            if v < min_val:\n                min_val = v\n            if v > max_val:\n                max_val = v\n            \n        return BigSumResult(min_val, max_val)\nclass BigSumController:\n    \"\"\"Orchestrates validation of input and computation of the sum of min/max values.\"\"\"\n    def __init__(self, validator: ArrayValidator | None = None, service: BigSumService | None = None) -> None:\n        self.validator = validator or ArrayValidator()\n        self.service = service or BigSumService()\n\n    def process(self, arr: Any) -> BigSumResult:\n        try:\n            validated_arr = self.validator.validate(arr)\n            return self.service.compute(validated_arr)\n        except BigSumError:\n            raise # Re-raise domain-specific errors directly\n        except Exception as e:\n            # Catch unexpected errors and wrap them in a BigSumError\n            raise BigSumError(f\"An unexpected error occurred during processing: {e}\", cause=e)\ndef big_sum(arr: Sequence[Number]) -> Number:\n    \"\"\"Finds the sum of the largest and smallest value in a given array.\"\"\"\n    controller = BigSumController()\n    result = controller.process(arr)\n    return result.sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/554": [{"task_id": "Mbpp/554", "solution": "from typing import List\ndef Split(nums: List[int]) -> List[int]:\n    \"\"\"\n    Filters a list of integers to return only the odd ones.\n    The order of the elements is preserved.\n    \"\"\"\n    return [n for n in nums if n % 2 != 0]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/479": [{"task_id": "Mbpp/479", "solution": "from decimal import Decimal\nfrom typing import Union\ndef strip_sign_and_decimal(s: str) -> str:\n    \"\"\"\n    Removes leading sign (+/-) and the decimal part from a string representation of a number,\n    keeping only the integer digits.\n    \"\"\"\n    s = s.strip()\n    \n    if s and (s[0] == '-' or s[0] == '+'):\n        s = s[1:]\n    \n    if '.' in s:\n        s = s.split('.')[0]\n        \n    return s\ndef first_Digit(num: Union[int, str, Decimal]) -> int:\n    \"\"\"\n    Finds the first digit of a given number, ignoring its sign and any decimal part.\n    This function assumes valid input that will yield at least one digit after normalization.\n    \"\"\"\n    s_raw = str(num)\n    \n    normalized_s = strip_sign_and_decimal(s_raw)\n    \n    return int(normalized_s[0])", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/473": [{"task_id": "Mbpp/473", "solution": "from typing import Iterable, Set, Tuple, Any\ndef tuple_intersection(list1: Iterable[Iterable[Any]], list2: Iterable[Iterable[Any]]) -> Set[Tuple[Any, Any]]:\n    \"\"\"\n    Finds the tuple intersection of elements in the given tuple lists, irrespective of their order.\n    It canonicalizes each 2-element tuple by sorting its elements before finding the set intersection.\n    \"\"\"\n    def _normalize_pair(pair: Iterable[Any]) -> Tuple[Any, Any]:\n        # Converts an iterable pair to a canonical sorted tuple (e.g., (5,4) -> (4,5)).\n        return tuple(sorted(pair))\n\n    set1 = {_normalize_pair(t) for t in list1}\n    set2 = {_normalize_pair(t) for t in list2}\n\n    return set1.intersection(set2)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/555": [{"task_id": "Mbpp/555", "solution": "def difference(n: int) -> int:\n    \"\"\"\n    Calculates the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers using an O(1) formula.\n    \"\"\"\n    # Calculate the sum of the first n natural numbers: S = n * (n + 1) / 2\n    sum_n = n * (n + 1) // 2\n    \n    # The sum of cubes of the first n natural numbers is S^2.\n    # The required difference is S^2 - S, which simplifies to S * (S - 1).\n    result = sum_n * (sum_n - 1)\n    \n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/556": [{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(arr, n):\n    \"\"\"Counts the number of pairs from the first 'n' elements of 'arr' whose XOR value is odd.\n    An XOR operation results in an odd number if and only if one operand is even and the other is odd.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    # Iterate through the first 'n' elements of the array\n    # The design context implies 'n' will be a valid length for processing.\n    for i in range(n):\n        if arr[i] % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    # The number of pairs with odd XOR is the product of the count of even and odd numbers.\n    return even_count * odd_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/557": [{"task_id": "Mbpp/557", "solution": "def toggle_string(text: str) -> str:\n    \"\