          s = raw.strip()\n            if s == \"\":\n                raise InvalidNumberError(\"Empty string\")\n            sign = 1\n            if s.startswith('-'):\n                sign = -1\n                s = s[1:]\n            elif s.startswith('+'):\n                s = s[1:]\n            if not s.isdigit():\n                raise InvalidNumberError(f\"Invalid digits: {raw}\")\n            return sign * int(s)\n        raise InvalidNumberError(f\"Unsupported type: {type(raw)}\")\n\n    @staticmethod\n    def alternating_digit_sum(n: int) -> int:\n        \"\"\"Computes the alternating digit sum for divisibility by 11.\"\"\"\n        n = abs(n)\n        total = 0\n        sign = 1\n        while n > 0:\n            total += sign * (n % 10)\n            n //= 10\n            sign *= -1\n        return total\nclass AttemptRepository(Protocol):\n    \"\"\"Protocol for persisting divisibility check attempts.\"\"\"\n    def save_attempt(self, number: int, result: bool, timestamp: str) -> None:\n        ...\nclass InMemoryAttemptRepository:\n    \"\"\"In-memory implementation of AttemptRepository, primarily for testing.\"\"\"\n    def __init__(self) -> None:\n        self._attempts = []\n\n    def save_attempt(self, number: int, result: bool, timestamp: str) -> None:\n        self._attempts.append({\"id\": str(uuid.uuid4()), \"number\": number, \"result\": result, \"timestamp\": timestamp})\n\n    def list_attempts(self) -> list:\n        return list(self._attempts)\nclass DivisibilityService:\n    \"\"\"Core business logic for checking divisibility by 11 and orchestrating persistence.\"\"\"\n    def __init__(self, repo: AttemptRepository | None = None) -> None:\n        self._repo = repo or InMemoryAttemptRepository()\n\n    def is_divisible_by_11(self, number: Number) -> bool:\n        \"\"\"Checks if a Number is divisible by 11 using the alternating digit sum.\"\"\"\n        s = DigitUtils.alternating_digit_sum(number.value)\n        result = (s % 11) == 0\n 