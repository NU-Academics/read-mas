omputes the n-th power of each number in an iterable.\n    Returns a new list where each element is raised to the power of n.\n    \"\"\"\n    return [float(x) ** n for x in numbers]", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[-100, -50, 0, 10, 77, 50, 100, -100], 77]]}], "Mbpp/616": [{"task_id": "Mbpp/616", "solution": "import sys\nimport re\nfrom typing import Tuple, Iterable, Any\nclass InvalidTupleError(Exception):\n    def __init__(self, message: str, code: str = \"invalid_input\") -> None:\n        super().__init__(message)\n        self.message = message\n        self.code = code\nclass TuplePair:\n    def __init__(self, a: Tuple[int, ...], b: Tuple[int, ...]) -> None:\n        self.a = a\n        self.b = b\n\n    @classmethod\n    def from_iterables(cls, a_iter: Iterable[int], b_iter: Iterable[int]) -> \"TuplePair\":\n        return cls(tuple(a_iter), tuple(b_iter))\n\n    def __len__(self) -> int:\n        return len(self.a)\nclass TupleResult:\n    def __init__(self, result: Tuple[int, ...]) -> None:\n        self.result = result\n\n    def to_tuple(self) -> Tuple[int, ...]:\n        return self.result\n\n    def __repr__(self) -> str:\n        return f\"TupleResult(result={self.result})\"\nclass TupleValidator:\n    def validate(self, a: Any, b: Any) -> TuplePair:\n        try:\n            a_converted = tuple(a)\n            b_converted = tuple(b)\n        except TypeError as e:\n            raise InvalidTupleError(f\"Inputs must be iterable: {e}\", \"type_error\")\n        except Exception as e:\n            raise InvalidTupleError(f\"Failed to process inputs as iterables: {e}\", \"type_error\")\n\n        if len(a_converted) != len(b_converted):\n            raise InvalidTupleError(\"Tuples must be the same length\", \"length_mismatch\")\n\n        for i in range(len(a_converted)):\n            ai = a_converted[i]\n            bi = b_converted[i]\n            if not isinstance(ai, int) or not isinstance(bi, int):\n                raise InvalidTupleError(\n                    f\"All elements must be integers. Found {type(ai).__name__} or {type(bi).__name__} at index {i}.\",\n                    \"non_integer_element\"\n                )\n            if bi == 0:\n                raise InvalidTupleError(f\"Divisor cannot be zero at index {i}\", \"divide_by_zero\")\n        \n        return TuplePair(a_converted, b_converted)\nclass TupleModuloService:\n    def compute(self, pair: TuplePair) -> TupleResult:\n        res = tuple(ai % bi for ai, bi in zip(pair.a, pair.b))\n        return TupleResult(res)\ndef parse_csv_to_tuple(s: str) -> Tuple[int, ...]:\n    if not isinstance(s, str):\n        raise InvalidTupleError(\"Input must be a string\", \"type_error\")\n    items = [item.strip() for item in re.split(r',\\s*', s) if item.strip() != \"\"]\n    try:\n        ints = tuple(int(item) for item in items)\n    except ValueError:\n        raise InvalidTupleError(f\"All CSV items must be integers. Could not convert '{s}'\", \"non_integer_element\")\n    return ints\nclass TupleController:\n    def __init__(self, validator: TupleValidator | None = None, service: TupleModuloService | None = None) -> None:\n        self.validator = validator or TupleValidator()\n        self.service = service or TupleModuloService()\n\n    def tuple_modulo(self, a: Tuple[int, ...], b: Tuple[int, ...]) -> Tuple[int, ...]:\n        pair = self.validator.validate(a, b)\n        result = self.service.compute(pair)\n        return result.to_tuple()\n\n    def cli_process(self, a_str: str, b_str: str) -> int:\n        try:\n            a = parse_csv_to_tuple(a_str)\n            b = parse_csv_to_tuple(b_str)\n            res = self.tuple_modulo(a, b)\n            print(res)\n            return 0\n        except InvalidTupleError as e:\n            print(f\"Error: {e.message}\", file=sys.stderr)\n            return 2\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 3\n_controller_instance = TupleController()\ndef tuple_modulo(a: Tuple[int, ...], b: Tuple[int, ...]) -> Tuple[int, ...]:\n    \"\"\"\n    Performs element-wise modulo on two tuples of the same length.\n    Delegates validation and computation to internal services.\n    \"\"\"\n    return _controller_instance.tuple_modulo(a, b)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/618": [{"task_id": "Mbpp/618", "solution": "from typing import List, Any, Optional\nfrom abc import ABC, abstractmethod\nclass DivisionError(Exception):\n    \"\"\"Base exception for division-related errors.\"\"\"\n    pass\nclass ValidationError(DivisionError):\n    \"\"\"Exception raised for invalid input data.\"\"\"\n    pass\nclass DivisionByZeroError(DivisionError):\n    \"\"\"Exception raised when division by zero occurs at a specific index.\"\"\"\n    def __init__(self, index: int, message: str = None):\n        super().__init__(message if message is not None else f\"Division by zero at index {index}\")\n        self.index = index\nclass Validator:\n    \"\"\"Provides utility methods for validating list inputs.\"\"\"\n    @staticmethod\n    def _is_numeric(x: Any) -> bool:\n        \"\"\"Helper to check if a value is numeric (int or float) and not boolean.\"\"\"\n        return isinstance(x, (int, float)) and not isinstance(x, bool)\n\n    @staticmethod\n    def validate_lists(a: List[Any], b: List[Any]) -> None:\n        \"\"\"\n        Validates that both inputs are lists, have the same length,\n        and all their elements are numeric.\n        \"\"\"\n        if not isinstance(a, list) or not isinstance(b, list):\n            raise ValidationError(\"Inputs must be lists.\")\n\n        if len(a) != len(b):\n            raise ValidationError(f\"Lists must have the same length. Got {len(a)} and {len(b)}.\")\n\n        for i, (val_a, val_b) in enumerate(zip(a, b)):\n            if not Validator._is_numeric(val_a):\n                raise ValidationError(f\"Non-numeric value '{val_a}' found at index {i} in list 'a'.\")\n            if not Validator._is_numeric(val_b):\n                raise ValidationError(f\"Non-numeric value '{val_b}' found at index {i} in list 'b'.\")\nclass Repository(ABC):\n    \"\"\"Abstract base class for repositories.\"\"\"\n    @abstractmethod\n    def save(self, result: Any) -> None:\n        pass\nclass DivisionService:\n    \"\"\"Core logic for element-wise division of lists.\"\"\"\n    def __init__(self, repository: Optional[Repository] = None) -> None:\n        self.repository = repository\n\n    def _compute_pair(self, a_val: float, b_val: float) -> float:\n        \"\"\"Performs division, raising a ValueError if divisor is zero.\"\"\"\n        if b_val == 0:\n            raise ValueError(\"Division by zero occurred.\")\n        return float(a_val) / float(b_val)\n\n    def divide(self, a: List[Any], b: List[Any]) -> List[float]:\n        \"\"\"\n        Computes element-wise division of two lists after validation.\n        \"\"\"\n        Validator.validate_lists(a, b)\n        result = []\n        for i, (av, bv) in enumerate(zip(a, b)):\n            try:\n                result.append(self._compute_pair(float(av), float(bv)))\n            except ValueError:\n                raise DivisionByZeroError(i, f\"Division by zero at index {i}\")\n        return result\nclass DivisionController:\n    \"\"\"Orchestrates validation, division, and optional persistence for high-level API.\"\"\"\n    def __init__(self, service: DivisionService) -> None:\n        self.service = service\n\n    def divide_and_maybe_persist(self, a: List[Any], b: List[Any], persist: bool=False, repo: Optional[Repository]=None) -> List[float]:\n        \"\"\"\n        Validates inputs, performs division, and optionally persists results.\n        \"\"\"\n        Validator.validate_lists(a, b)\n\n        result_list = self.service.divide(a, b)\n\n        if persist:\n            if repo is None:\n                raise ValidationError(\"Repository must be provided if persist is True.\")\n            # Persistence logic (e.g., repo.save(ResultList(result_list, metadata=...)))\n            # is omitted as 'persist' is False for the 'div_list' function.\n            pass\n\n        return result_list\ndef div_list(a: list, b: list) -> list:\n    \"\"\"\n    Divides two lists element-wise.\n    Raises ValidationError for invalid inputs or length mismatch.\n    Raises DivisionByZeroError if any divisor is zero.\n    \"\"\"\n    svc = DivisionService()\n    controller = DivisionController(svc)\n    return controller.divide_and_maybe_persist(a, b, persist=False)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/624": [{"task_id": "Mbpp/624", "solution": "class InvalidStringError(Exception):\n    \"\"\"Custom exception for invalid string inputs.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef is_upper(value):\n    \"\"\"Converts the given string to uppercase, handling validation and coercion.\"\"\"\n    if value is None:\n        raise InvalidStringError(\"Input must not be None\")\n\n    # Attempt to coerce to string if not already a string\n    if not isinstance(value, str):\n        try:\n            value = str(value)\n        except Exception:\n            raise InvalidStringError(\"Cannot coerce input to string\")\n\n    return value.upper()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/626": [{"task_id": "Mbpp/626", "solution": "import math\ndef triangle_area(radius: float) -> float | None:\n    \"\"\"\n    Calculates the area of the largest triangle inscribed in a semicircle.\n    Returns None if the radius is negative or not a valid number.\n    \"\"\"\n    if not isinstance(radius, (int, float)) or math.isinf(radius) or math.isnan(radius):\n        return None\n    \n    r = float(radius)\n    if r < 0:\n        return None\n    \n    return r * r", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[999999999]]}], "Mbpp/628": [{"task_id": "Mbpp/628", "solution": "def replace_spaces(text: str) -> str:\n    \"\"\"\n    Replaces all spaces in the given string with '%20'.\n    \"\"\"\n    return text.replace(\" \", \"%20\")", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/629": [{"task_id": "Mbpp/629", "solution": "from typing import Iterable, Any, List, Optional\nclass SplitError(Exception):\n    \"\"\"\n    Custom exception for errors during number splitting, encapsulating a message and an optional cause.\n    \"\"\"\n    def __init__(self, message: str, cause: Optional[Exception]=None) -> None:\n        super().__init__(message)\n        self.message = message\n        self.cause = cause\nclass NumberListDTO:\n    \"\"\"\n    Data Transfer Object for encapsulating a list of numbers, ensuring iterable input.\n    \"\"\"\n    def __init__(self, numbers: Iterable[Any]) -> None:\n        try:\n            self._numbers: List[Any] = list(numbers)\n        except TypeError as e:\n            raise SplitError(\"Input is not iterable\", cause=e)\n\n    def to_list(self) -> List[Any]:\n        \"\"\"Returns a shallow copy of the stored numbers list.\"\"\"\n        return list(self._numbers)\nclass Validator:\n    \"\"\"\n    Utility class for validating individual items and coercing them to integers if specified.\n    \"\"\"\n    def validate_iterable(self, obj: Any) -> Iterable[Any]:\n        \"\"\"Ensures the provided object is iterable.\"\"\"\n        try:\n            iter(obj)\n            return obj\n        except TypeError as e:\n            raise SplitError(\"Provided object is not iterable\", cause=e)\n\n    def validate_item(self, item: Any, tolerant: bool=False) -> int:\n        \"\"\"\n        Validates an item is an integer or can be coerced to one in tolerant mode.\n        \"\"\"\n        if isinstance(item, int):\n            return item\n        if tolerant and isinstance(item, float) and item.is_integer():\n            return int(item)\n        raise SplitError(f\"Item {item!r} is not an integer\")\nclass EvenSplitter:\n    \"\"\"\n    Business logic service for filtering even numbers from a NumberListDTO.\n    \"\"\"\n    def __init__(self, validator: Validator) -> None:\n        self._validator = validator\n\n    def split(self, dto: NumberListDTO, tolerant: bool=False) -> List[int]:\n        \"\"\"\n        Processes a DTO, validates items, and collects all even integers.\n        \"\"\"\n        result: List[int] = []\n        items = dto.to_list()\n        for item in items:\n            n = self._validator.validate_item(item, tolerant=tolerant)\n            if n % 2 == 0:\n                result.append(n)\n        return result\nclass SplitController:\n    \"\"\"\n    Controller that orchestrates the DTO creation and delegates to the EvenSplitter service.\n    \"\"\"\n    def __init__(self, splitter: EvenSplitter) -> None:\n        self._splitter = splitter\n\n    def run(self, numbers: Iterable[Any], tolerant: bool=False) -> list[int]:\n        \"\"\"\n        Main entry point for the controller, taking raw numbers and returning evens.\n        \"\"\"\n        dto = NumberListDTO(numbers)\n        return self._splitter.split(dto, tolerant=tolerant)\ndef Split(numbers: Iterable[Any], tolerant: bool = False) -> list[int]:\n    \"\"\"\n    Finds even numbers from a list of numbers, with optional tolerance for float integers.\n    Raises SplitError for invalid inputs.\n    \"\"\"\n    validator = Validator()\n    splitter = EvenSplitter(validator)\n    controller = SplitController(splitter)\n    return controller.run(numbers, tolerant=tolerant)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/603": [{"task_id": "Mbpp/603", "solution": "from typing import List, Optional, Any, Dict\nDEFAULT_MIN_N: int = 1\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass ComputationError(Exception):\n    \"\"\"Custom exception for algorithm computation failures.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\ndef is_positive_int(value: Any) -> bool:\n    \"\"\"Checks if a value is a positive integer greater than or equal to DEFAULT_MIN_N.\"\"\"\n    return isinstance(value, int) and value >= DEFAULT_MIN_N\nclass SieveRepository:\n    \"\"\"\n    Implements the Ludic Sieve algorithm and manages an in-memory cache for computed sequences.\n    \"\"\"\n    def __init__(self, cache_file: Optional[str] = None) -> None:\n        self.cache_file = cache_file # Placeholder, not used in core logic for this function\n        self._memory_cache: Dict[int, List[int]] = {}\n\n    def generate(self, n: int) -> List[int]:\n        \"\"\"\n        Generates ludic numbers up to n, using or updating the in-memory cache.\n        It first checks if a cached list covering 'n' already exists to avoid recomputation.\n        \"\"\"\n        cached_max_val = -1\n        for m in self._memory_cache:\n            if m >= n and m > cached_max_val:\n                cached_max_val = m\n\n        if cached_max_val != -1:\n            return [x for x in self._memory_cache[cached_max_val] if x <= n]\n\n        numbers = self._sieve(n)\n        self._memory_cache[n] = numbers\n        return numbers\n\n    def _sieve(self, limit: int) -> List[int]:\n        \"\"\"\n        The core algorithm implementing the ludic sieve to generate numbers up to a limit.\n        It iteratively removes every p-th element from the list of remaining numbers.\n        \"\"\"\n        try:\n            L = list(range(1, limit + 1))\n            i = 1  # L[0] (which is 1) is the first ludic number and is always kept.\n                   # We start the sieving process by taking the next element L[1] as the first 'p'.\n            while i < len(L):\n                p = L[i]\n                \n                # Elements to keep before the current ludic number 'p' (including 'p' itself)\n                new_prefix = L[:i+1]\n                \n                # Remaining elements after 'p' from which elements will be removed\n                rem = L[i+1:]\n                \n                new_rem = []\n                # Enumerate from 1 to simulate 1-based counting for removal\n                for idx, val in enumerate(rem, start=1):\n                    if idx % p != 0:\n                        new_rem.append(val)\n                \n                # Reconstruct the list with removed elements\n                L = new_prefix + new_rem\n                i += 1 # Move to the next number in the (potentially smaller) list to use as 'p'\n            return L\n        except Exception as e:\n            raise ComputationError(f\"sieve failure: {e}\") from e\nclass LudicService:\n    \"\"\"\n    Orchestrates input validation, caching, and delegates the generation of ludic numbers\n    to the SieveRepository.\n    \"\"\"\n    def __init__(self, repository: Optional[SieveRepository] = None) -> None:\n        self.repository = repository or SieveRepository()\n\n    def _validate_n(self, n: int) -> None:\n        \"\"\"\n        Validates the input 'n', ensuring it is an integer and meets the minimum requirement.\n        \"\"\"\n        if not is_positive_int(n):\n            raise InvalidInputError(f\"n must be an integer >= {DEFAULT_MIN_N}\")\n\n    def get_ludic(self, n: int) -> List[int]:\n        \"\"\"\n        Retrieves all ludic numbers smaller than or equal to n.\n        It performs input validation before calling the repository for computation.\n        \"\"\"\n        self._validate_n(n)\n        return self.repository.generate(n)\n_default_service = LudicService()\ndef get_ludic(n: int) -> list[int]:\n    \"\"\"\n    Returns a list of all ludic numbers smaller than or equal to n.\n    \"\"\"\n    return _default_service.get_ludic(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/632": [{"task_id": "Mbpp/632", "solution": "from typing import List\ndef move_zero(nums: List[int]) -> List[int]:\n    \"\"\"\n    Moves all zeroes to the end of the given list, preserving the relative order of non-zero elements.\n    Returns a new list with the reordered elements.\n    \"\"\"\n    nonzeros = [x for x in nums if x != 0]\n    zeros_count = len(nums) - len(nonzeros)\n    return nonzeros + [0] * zeros_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/622": [{"task_id": "Mbpp/622", "solution": "def get_median(a, b, n):\n    \"\"\"\n    Finds the median of two sorted lists of the same size.\n    Uses a recursive k-th element approach with O(log n) time and O(log n) space for recursion stack.\n    \"\"\"\n    def _find_kth_1_indexed(nums1, p1, nums2, p2, k):\n        \"\"\"\n        Helper function to find the k-th smallest element (1-indexed)\n        in the merged sorted segments of nums1[p1:] and nums2[p2:].\n        \"\"\"\n        # Ensure nums1's remaining segment is shorter or equal in length\n        # This optimization helps to reduce the recursion depth.\n        if (len(nums1) - p1) > (len(nums2) - p2):\n            return _find_kth_1_indexed(nums2, p2, nums1, p1, k)\n        \n        # Base case 1: If nums1 segment is exhausted, k-th element must be in nums2\n        if p1 == len(nums1):\n            return nums2[p2 + k - 1]\n        \n        # Base case 2: If k is 1, we're looking for the 1st smallest element\n        if k == 1:\n            return min(nums1[p1], nums2[p2])\n\n        # Determine how many elements to tentatively skip from each array's segment\n        # `idx1` is the count of elements to skip from nums1's current segment.\n        # We try to skip roughly k/2 elements from the (currently shorter) nums1.\n        idx1 = min(k // 2, len(nums1) - p1)\n        # `idx2` is the count of elements to skip from nums2's current segment.\n        # The total number of elements skipped should sum to k.\n        idx2 = k - idx1\n        \n        # Compare the elements at the partition points\n        # If nums1[p1 + idx1 - 1] < nums2[p2 + idx2 - 1]:\n        # It means the first `idx1` elements of nums1's segment are smaller than\n        # the `idx2`-th element of nums2's segment (relative to p2).\n        # So, the k-th element cannot be in nums1[p1 ... p1 + idx1 - 1].\n        # We discard these `idx1` elements from nums1 and search for the (k - idx1)-th element.\n        if nums1[p1 + idx1 - 1] < nums2[p2 + idx2 - 1]:\n            return _find_kth_1_indexed(nums1, p1 + idx1, nums2, p2, k - idx1)\n        else: # nums2[p2 + idx2 - 1] <= nums1[p1 + idx1 - 1]\n            # Discard `idx2` elements from nums2 and search for the (k - idx2)-th element.\n            return _find_kth_1_indexed(nums1, p1, nums2, p2 + idx2, k - idx2)\n\n    # For two sorted arrays of equal length n, the combined list has 2*n elements.\n    # The median is the average of the n-th and (n+1)-th smallest elements overall (1-indexed).\n    \n    # Find the n-th smallest element (1-indexed)\n    nth_smallest = _find_kth_1_indexed(a, 0, b, 0, n)\n    # Find the (n+1)-th smallest element (1-indexed)\n    n_plus_1_th_smallest = _find_kth_1_indexed(a, 0, b, 0, n + 1)\n    \n    return (nth_smallest + n_plus_1_th_smallest) / 2.0", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[1], [2], 0]]}], "Mbpp/639": [{"task_id": "Mbpp/639", "solution": "import re\ndef sample_nam(names: list[str]) -> int:\n    \"\"\"\n    Sums the length of names after filtering out those starting wi