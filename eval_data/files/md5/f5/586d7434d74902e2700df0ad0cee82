rt List\ndef _get_digits(n: int) -> List[int]:\n    \"\"\"Extracts digits of a non-negative integer.\"\"\"\n    if n == 0:\n        return [0]\n    digits = []\n    temp_n = n\n    while temp_n > 0:\n        digits.append(temp_n % 10)\n        temp_n //= 10\n    return digits[::-1]\ndef _calculate_power_sum(digits: List[int], power: int) -> int:\n    \"\"\"Calculates the sum of each digit raised to the given power.\"\"\"\n    total = 0\n    for digit in digits:\n        total += digit ** power\n    return total\ndef armstrong_number(n: int) -> bool:\n    \"\"\"Checks if the given number is an Armstrong number.\"\"\"\n    digits = _get_digits(n)\n    power = len(digits)\n    computed_sum = _calculate_power_sum(digits, power)\n    return computed_sum == n", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/597": [{"task_id": "Mbpp/597", "solution": "import math\nfrom typing import List\ndef find_kth(arr1: List[int], arr2: List[int], k: int) -> int:\n    \"\"\"\n    Finds the k-th smallest element from two sorted arrays using a divide-and-conquer approach.\n    Assumes arrays are sorted and k is a positive integer within valid bounds.\n    \"\"\"\n\n    def _find_kth_recursive(a: List[int], b: List[int], k: int) -> int:\n        \"\"\"\n        Recursive helper to find the k-th element, assuming a and b are sorted sub-arrays.\n        This function uses slicing, which creates new list objects in Python.\n        \"\"\"\n        len_a = len(a)\n        len_b = len(b)\n\n        # Ensure array 'a' is the shorter one to optimize recursion path length.\n        if len_a > len_b:\n            return _find_kth_recursive(b, a, k)\n\n        # Base cases\n        if len_a == 0:\n            # If 'a' is empty, the k-th element must be in 'b'.\n            return b[k - 1]\n        if k == 1:\n            # If k is 1, return the smaller of the first elements.\n            return min(a[0], b[0])\n\n        # Divide k into two parts