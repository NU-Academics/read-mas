task_id": "Mbpp/428", "solution": "import math\nfrom typing import List, Sequence, Optional\ndef shell_sort(arr: Sequence[float]) -> List[float]:\n    \"\"\"\n    Sorts a sequence of numbers using the Shell sort algorithm with Shell's original gap sequence.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return []\n\n    # Make a mutable copy of the input sequence\n    arr_copy = list(arr)\n\n    # Generate Shell's original gap sequence: n/2, n/4, ..., 1\n    gaps = []\n    gap = n // 2\n    while gap > 0:\n        gaps.append(gap)\n        gap //= 2\n\n    # Perform Shell sort using the generated gaps\n    for g in gaps:\n        # Do a g-gapped insertion sort for this gap size\n        for i in range(g, n):\n            temp = arr_copy[i]\n            j = i\n            # Shift elements for g-gapped insertion\n            while j >= g and arr_copy[j - g] > temp:\n                arr_copy[j] = arr_copy[j - g]\n                j -= g\n            arr_copy[j] = temp\n            \n    return arr_copy", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/432": [{"task_id": "Mbpp/432", "solution": "import typing\ndef median_trapezium(base_a: float, base_b: float, third_side: typing.Optional[float] = None) -> float:\n    \"\"\"\n    Calculates the median length of a trapezium given its two parallel bases.\n    The optional third_side parameter is ignored for the median calculation.\n    \"\"\"\n    return (base_a + base_b) / 2.0", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/429": [{"task_id": "Mbpp/429", "solution": "import math\nfrom typing import Tuple\ndef and_tuples(a: Tuple[int, ...], b: Tuple[int, ...]) -> Tuple[int, ...]:\n    \"\"\"\n    Computes the element-wise bitwise AND of two tuples.\n    Assumes inputs are valid tuples of integers and have the same length.\n    \"\"\"\n    return tuple(x & y for x, y in zip(a, b))", "base_status": "pass", "plus_s