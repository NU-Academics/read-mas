e_fail_tests": [[["Red", "Green", "Blue"], 2]], "plus_fail_tests": [[["A", "B", "C", "D"], 4]]}], "Mbpp/758": [{"task_id": "Mbpp/758", "solution": "from abc import ABC, abstractmethod\nfrom collections.abc import Sequence\nimport threading\nfrom typing import Any, Optional, Dict, Tuple\nclass InvalidInputError(Exception):\n    \"\"\"Raised when the top-level input is not a valid sequence.\"\"\"\n    pass\nclass NormalizationError(Exception):\n    \"\"\"Raised when normalization fails (e.g., recursion too deep or unhashable content).\"\"\"\n    pass\nclass CountingResult:\n    \"\"\"A data transfer object for storing sublist counts.\"\"\"\n    def __init__(self, counts: Dict[Tuple[Any, ...], int]) -> None:\n        self.counts = counts\n\n    def to_json(self) -> Dict[str, int]:\n        \"\"\"Converts tuple keys to string representation for JSON output.\"\"\"\n        return {str(k): v for k, v in self.counts.items()}\n\n    @staticmethod\n    def from_counts(counts: Dict[Tuple[Any, ...], int]) -> \"CountingResult\":\n        \"\"\"Factory method to create a CountingResult instance.\"\"\"\n        return CountingResult(counts)\nclass ListNormalizer:\n    \"\"\"Normalizes arbitrary nested lists/tuples into hashable tuples.\"\"\"\n    MAX_RECURSION_DEPTH = 1000\n\n    def normalize(self, item: Any, depth: int = 0) -> Any:\n        \"\"\"Recursively converts lists and tuples to tuples for hashability.\"\"\"\n        if depth > self.MAX_RECURSION_DEPTH:\n            raise NormalizationError(\"Maximum recursion depth exceeded during normalization.\")\n        if isinstance(item, (list, tuple)):\n            return tuple(self.normalize(x, depth + 1) for x in item)\n        return item\n\n    def normalize_sequence(self, seq: Sequence[Any]) -> Tuple[Any, ...]:\n        \"\"\"Validates input is a sequence and returns a normalized tuple.\"\"\"\n        if not isinstance(seq, Sequence):\n            raise InvalidInputError(f\"Expected a sequence, got {type(seq).__name__}.\")\n        return tuple(self.normalize(x, depth=1) for x in seq)\nclass SublistRepository(ABC):\n    \"\"\"Abstract base class for sublist count repositories.\"\"\"\n    @abstractmethod\n    def save_counts(self, counts: Dict[Tuple[Any, ...], int]) -> None:\n        pass\n\n    @abstractmethod\n    def get_counts(self) -> Dict[Tuple[Any, ...], int]:\n        pass\nclass InMemorySublistRepository(SublistRepository):\n    \"\"\"An in-memory implementation of a sublist count repository.\"\"\"\n    def __init__(self, initial: Optional[Dict[Tuple[Any, ...], int]] = None) -> None:\n        self._lock = threading.Lock()\n        self._store = dict(initial) if initial else {}\n\n    def save_counts(self, counts: Dict[Tuple[Any, ...], int]) -> None:\n        \"\"\"Atomically replaces the internal store with the given counts.\"\"\"\n        with self._lock:\n            self._store = dict(counts)\n\n    def get_counts(self) -> Dict[Tuple[Any, ...], int]:\n        \"\"\"Returns a copy of the currently stored counts.\"\"\"\n        with self._lock:\n            return dict(self._store)\nclass UniqueSublistService:\n    \"\"\"Orchestrates normalization, counting, and repository persistence.\"\"\"\n    def __init__(self, repository: SublistRepository, normalizer: ListNormalizer) -> None:\n        self.repository = repository\n        self.normalizer = normalizer\n\n    def count(self, sublists: list[Any]) -> CountingResult:\n        \"\"\"Counts occurrences of unique sublists after normalization and saves them.\"\"\"\n        if not isinstance(sublists, (list, tuple)):\n            raise InvalidInputError(\"Top-level input must be a list or tuple of sublists.\")\n\n        counts: Dict[Tuple[Any, ...], int] = {}\n        for item in sublists:\n            key = self.normalizer.normalize(item)\n            counts[key] = counts.get(key, 0) + 1\n\n        self.repository.save_counts(counts)\n        return CountingResult.from_counts(counts)\ndef unique_sublists(sublists: list[Any]) -> Dict[Tuple[Any, ...], int]:\n    \"\"\"Counts unique sublists within a list, converting them to tuples, and returns their frequencies.\"\"\"\n    normalizer = ListNormalizer()\n    repo = InMemorySublistRepository()\n    service = UniqueSublistService(repository=repo, normalizer=normalizer)\n    result = service.count(sublists)\n    return result.counts", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/271": [{"task_id": "Mbpp/271", "solution": "def even_Power_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the first n even natural numbers, each raised to the fifth power.\n    Assumes n is a non-negative integer.\n    \"\"\"\n    total_sum = 0\n    for k in range(1, n + 1):\n        even_num = 2 * k\n        total_sum += even_num ** 5\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}]}}