ation.\"\"\"\n    return ch in PUNCTUATION_CHARS\ndef clean_word(raw: str) -> Tuple[str, int, int]:\n    \"\"\"Removes leading/trailing punctuation from a raw word and returns cleaned text and trim offsets.\"\"\"\n    left = 0\n    right = len(raw)\n    while left < right and is_punctuation(raw[left]):\n        left += 1\n    while right > left and is_punctuation(raw[right - 1]):\n        right -= 1\n    return raw[left:right], left, len(raw) - right\nclass Tokenizer:\n    \"\"\"Splits a sentence into Token objects, preserving original indices and stripping punctuation.\"\"\"\n    def tokenize(self, sentence: str) -> List[Token]:\n        tokens = []\n        # Use finditer to correctly get start and end indices of whitespace-separated chunks\n        # This handles multiple spaces and leading/trailing spaces correctly.\n        for match in re.finditer(r'\\S+', sentence):\n            chunk = match.group(0)\n            start_raw = match.start()\n            end_raw = match.end()\n\n            cleaned, ltrim, rtrim = clean_word(chunk)\n            \n            if cleaned:\n                token_start = start_raw + ltrim\n                token_end = end_raw - rtrim\n                tokens.append(Token(cleaned, token_start, token_end))\n        return tokens\nclass PosTagger:\n    \"\"\"Applies heuristic rules to tag tokens as adverbs.\"\"\"\n    def __init__(self, suffixes: Optional[List[str]] = None, overrides: Optional[Set[str]] = None, exceptions: Optional[Set[str]] = None) -> None:\n        self.suffixes = suffixes or ADVERB_SUFFIXES\n        self.overrides = overrides or ADVERB_OVERRIDES\n        self.exceptions = exceptions or ADVERB_EXCEPTIONS\n\n    def tag(self, tokens: List[Token]) -> List[Token]:\n        \"\"\"Tags tokens based on adverb heuristics.\"\"\"\n        for t in tokens:\n            text_l = t.text.lower()\n            if text_l in self.overrides:\n                t.pos = \"ADV\"\n            elif any(text_l.endswith(s) for s in self.suffixes) and text_l not in self.exceptions:\n                t.pos = \"ADV\"\n            else:\n                t.pos = None\n        return tokens\nclass AdverbFinderService:\n    \"\"\"Orchestrates tokenization and tagging to find the first adverb in a sentence.\"\"\"\n    def __init__(self, tokenizer: Tokenizer = None, tagger: PosTagger = None) -> None:\n        self.tokenizer = tokenizer or Tokenizer()\n        self.tagger = tagger or PosTagger()\n\n    def find_first_adverb(self, sentence: str) -> Optional[Tuple[int, int, str]]:\n        \"\"\"Finds the first adverb and its position in the given sentence.\"\"\"\n        tokens = self.tokenizer.tokenize(sentence)\n        tokens = self.tagger.tag(tokens)\n        for t in tokens:\n            if t.pos == \"ADV\":\n                return (t.start, t.end, t.text)\n        return None\n_adverb_finder_service = AdverbFinderService()\ndef find_adverb_position(sentence: str) -> Optional[Tuple[int, int, str]]:\n    \"\"\"\n    Finds the first adverb and its position in a given sentence.\n    Returns a tuple (start_index, end_index, adverb_text) or None if no adverb is found.\n    \"\"\"\n    return _adverb_finder_service.find_first_adverb(sentence)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["awaquicklyy"]]}], "Mbpp/447": [{"task_id": "Mbpp/447", "solution": "def cube_nums(numbers: list[float | int]) -> list[float | int]:\n    \"\"\"\n    Computes the cube of each numeric element in the input list.\n    \"\"\"\n    return [n ** 3 for n in numbers]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/445": [{"task_id": "Mbpp/445", "solution": "import collections.abc\nfrom typing import Tuple\ndef index_multiplication(t1: Tuple[Tuple[int, ...], ...], t2: Tuple[Tuple[int, ...], ...]) -> Tuple[Tuple[int, ...], ...]:\n    \"\"\"\n    Performs index-wise multiplication of tuple elements in two given nested tuples.\n    Assumes inputs 