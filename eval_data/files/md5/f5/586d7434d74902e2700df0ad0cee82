lidate(self) -> None:\n        \"\"\"Validates input, converts to int, checks bounds, raises InvalidInputError on failure.\"\"\"\n        try:\n            v = int(self.original)\n        except (TypeError, ValueError) as e:\n            raise InvalidInputError(f\"Input is not an integer: {self.original}\") from e\n        if abs(v) > MathUtils.MAX_SUPPORTED:\n            raise InvalidInputError(f\"Input {v} out of supported range (abs max {MathUtils.MAX_SUPPORTED})\")\n        self.value = v\n\n    def to_int(self) -> int:\n        \"\"\"Returns the validated integer value.\"\"\"\n        if self.value is None:\n            self.validate()\n        return self.value\nclass NextSquareService:\n    def __init__(self, repo=None) -> None:\n        # FileRepository logging is not implemented inline, so repo is always None here.\n        self._repo = None\n\n    def compute_next_square(self, n: int) -> int:\n        \"\"\"Computes the smallest perfect square strictly greater than n.\"\"\"\n        if n < 0:\n            # For any n < 0, the smallest non-negative perfect square is 0,\n            # and 0 is strictly greater than any negative n.\n            return 0\n        \n        # For n >= 0, find k such that k*k is the next perfect square > n.\n        k = MathUtils.safe_ceil_sqrt(n)\n        try:\n            result = k * k\n        except OverflowError as e:\n            raise ComputationError(\"Overflow during square computation\") from e\n        return result\n\n    def validate_and_compute(self, raw_input: object) -> int:\n        \"\"\"Validates raw input, computes the next perfect square, and returns it.\"\"\"\n        num = NumberInput(raw_input)\n        num.validate()\n        n = num.to_int()\n        \n        result = self.compute_next_square(n)\n        \n        # Optional logging via _repo is omitted as FileRepository is not implemented inline.\n        \n        return result\ndef next_Perfect_Square(n: object) -> int:\n    \"\"\"\n    Finds the next perfect square strictly greater than a given number.\n    assert next_Perfect_Square(35) == 36\n    \"\"\"\n    service = NextSquareService()\n    return service.validate_and_compute(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/250": [{"task_id": "Mbpp/250", "solution": "def count_X(data: tuple, element) -> int:\n    \"\"\"\n    Counts the occurrences of an element in a tuple.\n    \"\"\"\n    count = 0\n    for item in data:\n        if item == element:\n            count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/251": [{"task_id": "Mbpp/251", "solution": "from typing import List, Any\ndef insert_element(input_list: List[Any], element: Any) -> List[Any]:\n    \"\"\"\n    Inserts an element before each element in the input list, returning a new list.\n    The original list is not modified.\n    \"\"\"\n    n = len(input_list)\n    if n == 0:\n        return []\n\n    result: List[Any] = [None] * (2 * n)\n    for i, item in enumerate(input_list):\n        result[2 * i] = element\n        result[2 * i + 1] = item\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/253": [{"task_id": "Mbpp/253", "solution": "def count_integer(items):\n    \"\"\"\n    Counts the number of integer elements in a list, excluding booleans.\n    \"\"\"\n    count = 0\n    for item in items:\n        if type(item) is int:\n            count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/239": [{"task_id": "Mbpp/239", "solution": "def get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Finds the number of possible sequences of length n, such that each element\n    is a positive integer, is greater than or equal to twice the previous element,\n    and is less than or equal to m.\n    \"\"\"\n    # dp[x] will store the number of valid sequences of current length ending with x.\n    # We use 1-based indexing for elements, so array size is m+2 to handle m.\n    dp = [0] * (m + 2)\n\n    # For sequences of length 1, any number from 1 to m is valid.\n    for x in range(1, m + 1):\n        dp[x] = 1\n\n    # Iterate for sequence lengths from 2 up to n.\n    for level in range(2, n + 1):\n        # Calculate suffix sums for the current dp array to optimize next_dp calculation.\n        # suffix[k] stores sum(dp[k]...dp[m]).\n        suffix_sums = [0] * (m + 3) # size m+3 for suffix[m+1] and beyond to be 0\n        for x in range(m, 0, -1):\n            suffix_sums[x] = dp[x] + suffix_sums[x + 1]\n\n        # Calculate dp values for the next level (length 'level').\n        new_dp = [0] * (m + 2)\n        for x in range(1, m + 1):\n            # A sequence ending in x at current level can be followed by an element y\n            # such that y >= 2*x. The count of such sequences is the sum of dp[y] for y >= 2*x.\n            # This sum is efficiently found using suffix_sums.\n            min_next_val = 2 * x\n            if min_next_val <= m:\n                new_dp[x] = suffix_sums[min_next_val]\n            else:\n                new_dp[x] = 0 # No valid next element if 2*x exceeds m\n        \n        dp = new_dp # Update dp for the next level\n\n    # The total number of sequences of length n is the sum of all values in dp for elements 1 to m.\n    return sum(dp[1 : m + 1])", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/245": [{"task_id": "Mbpp/245", "solution": "def max_sum(arr: list[int]) -> int:\n    \"\"\"\n    Finds the maximum sum of a bitonic subsequence for the given array.\n    A sequence is bitonic if it is first increasing and then decreasing.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return 0\n\n    # Helper function to compute the maximum sum of an increasing subsequence ending at each index.\n    def _compute_lis_sums(sequence: list[int], length: int) -> list[int]:\n        lis = [0] * length\n        for i in range(length):\n            lis[i] = sequence[i]\n            for j in range(i):\n                if sequence[i] > sequence[j]:\n                    lis[i] = max(lis[i], lis[j] + sequence[i])\n        return lis\n\n    # Helper function to compute the maximum sum of a decreasing subsequence starting at each index.\n    def _compute_lds_sums(sequence: list[int], length: int) -> list[int]:\n        lds = [0] * length\n        for i in range(length - 1, -1, -1):\n            lds[i] = sequence[i]\n            for j in range(length - 1, i, -1):\n                if sequence[i] > sequence[j]:\n                    lds[i] = max(lds[i], lds[j] + sequence[i])\n        return lds\n\n    lis_sums = _compute_lis_sums(arr, n)\n    lds_sums = _compute_lds_sums(arr, n)\n\n    maximum_sum = 0\n    # Combine LIS and LDS sums. Subtract arr[i] because it's included in both LIS and LDS sums.\n    for i in range(n):\n        current_bitonic_sum = lis_sums[i] + lds_sums[i] - arr[i]\n        if current_bitonic_sum > maximum_sum:\n            maximum_sum = current_bitonic_sum\n            \n    return maximum_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/252": [{"task_id": "Mbpp/252", "solution": "import math\nfrom typing import Any, Tuple, List, Union\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input values.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\nclass MathUtils:\n    \"\"\"Utility class for safe mathematical operations.\"\"\"\n    @staticmethod\n    def sanitize_number(x: Any) -> float:\n        \"\"\"Coerce to float and check for NaN/Inf.\"\"\"\n        try:\n            fx = float(x)\n        except (TypeError, ValueError):\n            raise InvalidInputError(f\"Not a number: {x!r}\")\n        if math.isnan(fx) or math.isinf(fx):\n            raise InvalidInputError(f\"Invalid numeric value (NaN or Inf): {x!r}\")\n        return fx\n\n    @staticmethod\n    def hypot(a: float, b: float) -> float:\n        \"\"\"Calculate hypotenuse.\"\"\"\n        return math.hypot(a, b)\n\n    @staticmethod\n    def atan2(y: float, x: float) -> float:\n        \"\"\"Calculate arctangent of y/x.\"\"\"\n        return math.atan2(y, x)\nclass ComplexNumber:\n    \"\"\"Domain model for a complex number.\"\"\"\n    def __init__(self, real: Any, imag: Any, sanitizer: MathUtils) -> None:\n        \"\"\"Constructs ComplexNumber, sanitizing real/imag parts.\"\"\"\n        self._real = sanitizer.sanitize_number(real)\n        self._imag = sanitizer.sanitize_number(imag)\n\n    def real(self) -> float:\n        \"\"\"Returns the real part.\"\"\"\n        return self._real\n\n    def imag(self) -> float:\n        \"\"\"Returns the imaginary part.\"\"\"\n        return self._imag\n\n    def to_complex(self) -> complex:\n        \"\"\"Converts to a built-in complex number.\"\"\"\n        return complex(self._real, self._imag)\nclass PolarCoordinates:\n    \"\"\"Domain model for polar coordinates.\"\"\"\n    def __init__(self, radius: float, angle: float) -> None:\n        \"\"\"Constructs PolarCoordinates, radius must be non-negative.\"\"\"\n        if radius < 0:\n            raise ValueError(\"Radius cannot be negative.\")\n        self._radius = radius\n        self._angle = angle\n\n    def radius(self) -> float:\n        \"\"\"Returns the radius component.\"\"\"\n        return self._radius\n\n    def angle(self) -> float:\n        \"\"\"Returns the angle component.\"\"\"\n        return self._angle\n\n    def as_tuple(self) -> Tuple[float, float]:\n        \"\"\"Returns coordinates as a (radius, angle) tuple.\"\"\"\n        return (self._radius, self._angle)\nclass InputAdapter:\n    \"\"\"Adapts various inputs to a ComplexNumber.\"\"\"\n    def __init__(self, sanitizer: MathUtils) -> None:\n        self._sanitizer = sanitizer\n\n    def normalize(self, value: Any) -> ComplexNumber:\n        \"\"\"Normalizes diverse inputs into a ComplexNumber instance.\"\"\"\n        real_part: Any\n        imag_part: Any\n\n        if isinstance(value, complex):\n            real_part = value.real\n            imag_part = value.imag\n        elif isinstance(value, (int, float)):\n            real_part = float(value)\n            imag_part = 0.0\n        elif isinstance(value, (tuple, list)) and len(value) == 2:\n            real_part = value[0]\n            imag_part = value[1]\n        elif isinstance(value, str):\n            try:\n                c = complex(value)\n                real_part = c.real\n                imag_part = c.imag\n            except ValueError:\n                raise InvalidInputError(f\"Cannot parse string as complex number: {value!r}\")\n        else:\n            raise InvalidInputError(f\"Unsupported input type: {type(value)} for value {value!r}\")\n\n        return ComplexNumber(real_part, imag_part, self._sanitizer)\nclass PolarConverter:\n    \"\"\"Converts a ComplexNumber to PolarCoordinates.\"\"\"\n    def __init__(self, math_utils: MathUtils) -> None:\n        self._math = math_utils\n\n    def to_polar(self, cn: ComplexNumber) -> PolarCoordinates:\n        \"\"\"Computes radius and angle from a ComplexNumber.\"\"\"\n        r = self._math.hypot(cn.real(), cn.imag())\n        theta = self._math.atan2(cn.imag(), cn.real()) if r != 0.0 else 0.0\n        return PolarCoordinates(r, theta)\nclass ConverterController:\n    \"\"\"High-level facade for complex to polar conversion.\"\"\"\n    def __init__(self, adapter: InputAdapter, converter: PolarConverter) -> None:\n        self._adapter = adapter\n        self._converter = converter\n\n    def convert(self, value: object) -> Tuple[float, float]:\n        \"\"\"Orchestrates input normalization and polar conversion.\"\"\"\n        cn = self._adapter.normalize(value)\n        polar = self.