(\"\"\"\n                CREATE INDEX IF NOT EXISTS idx_computations_timestamp ON computations(timestamp DESC);\n            \"\"\")\n            conn.commit()\n        except sqlite3.Error as e:\n            raise PersistenceError(f\"Failed to ensure database schema: {e}\")\n\n    def insert_computation(self, side_length: float, result: float, timestamp: str) -> int:\n        \"\"\"Inserts a new computation record into the database.\"\"\"\n        conn = self._get_conn()\n        try:\n            cursor = conn.cursor()\n            cursor.execute(\n                \"INSERT INTO computations (timestamp, side_length, result) VALUES (?, ?, ?)\",\n                (timestamp, side_length, result)\n            )\n            conn.commit()\n            return cursor.lastrowid\n        except sqlite3.Error as e:\n            raise PersistenceError(f\"Failed to insert computation record: {e}\")\n\n    def query_recent(self, limit: int = 10) -> List[Dict[str, Any]]:\n        \"\"\"Queries recent computation records from the database.\"\"\"\n        conn = self._get_conn()\n        try:\n            cursor = conn.cursor()\n            cursor.execute(\n                \"SELECT id, timestamp, side_length, result FROM computations ORDER BY timestamp DESC LIMIT ?\",\n                (limit,)\n            )\n            return [dict(row) for row in cursor.fetchall()]\n        except sqlite3.Error as e:\n            raise PersistenceError(f\"Failed to query recent computations: {e}\")\nclass SquareDTO:\n    \"\"\"Data Transfer Object for square input.\"\"\"\n    def __init__(self, side_length: float) -> None:\n        self.side_length = side_length\nclass PerimeterResult:\n    \"\"\"Data Transfer Object for perimeter computation result.\"\"\"\n    def __init__(self, side_length: float, perimeter: float, timestamp: str) -> None:\n        self.side_length = side_length\n        self.perimeter = perimeter\n        self.timestamp = timestamp\nclass SquareService:\n    \"\"\"Orchestrates validation, calculation, and persistence for square perimeters.\"\"\"\n    def __init__(self, calculator: GeometryCalculator, repository: MetricsRepository):\n        self._calculator = calculator\n        self._repository = repository\n\n    def compute_perimeter(self, dto: SquareDTO) -> PerimeterResult:\n        \"\"\"Computes the perimeter, persists the log, and returns the result.\"\"\"\n        perimeter = self._calculator.compute_square_perimeter(dto.side_length)\n        timestamp = current_iso_timestamp()\n        try:\n            self._repository.insert_computation(dto.side_length, perimeter, timestamp)\n        except PersistenceError:\n            # Log warning about persistence failure, but do not prevent returning the result.\n            pass\n        return PerimeterResult(dto.side_length, perimeter, timestamp)\nclass SquareController:\n    \"\"\"A controller that maps external inputs to service calls.\"\"\"\n    def __init__(self, service: SquareService) -> None:\n        self._service = service\n\n    def compute(self, side_length: float) -> float:\n        \"\"\"Computes the perimeter for a given side length, assuming valid input.\"\"\"\n        # Input validation for side_length is omitted here per the constraint:\n        # \"DO NOT add isinstance() checks or raise exceptions for edge cases\"\n        dto = SquareDTO(side_length)\n        result = self._service.compute_perimeter(dto)\n        return result.perimeter\ndef square_perimeter(side_length: float, db_path: Optional[str] = None) -> float:\n    \"\"\"\n    Returns the perimeter of a square given its side length, and logs the computation.\n    Assumes side_length is a valid float as per constraints.\n    \"\"\"\n    repo = MetricsRepository(db_path or DEFAULT_DB_PATH)\n    repo.ensure_schema()\n    calculator = GeometryCalculator()\n    service = SquareService(calculator, repo)\n    controller = SquareController(service)\n    return controller.compute(side_length)", "base_status": "tim