al [a, b]\n    # The problem statement guarantees a solution for polynomials with an even number of coefficients\n    # (i.e., odd degree), which implies the polynomial must cross the x-axis.\n\n    # Heuristic for initial interval: try common small intervals first.\n    test_points = [0.0, 1.0, -1.0, 0.5, -0.5, 2.0, -2.0, 10.0, -10.0]\n    \n    a_initial, b_initial = -1e12, 1e12 # Fallback to a very wide interval, guaranteed to span a root for odd-degree poly\n    \n    found_heuristic_interval = False\n    \n    for i in range(len(test_points)):\n        for j in range(i + 1, len(test_points)):\n            x1, x2 = test_points[i], test_points[j]\n            y1 = poly(xs, x1)\n            y2 = poly(xs, x2)\n            \n            # Check if x1 or x2 is already a root or very close\n            if abs(y1) < DEFAULT_TOLERANCE:\n                return x1\n            if abs(y2) < DEFAULT_TOLERANCE:\n                return x2\n            \n            # Check for a sign change\n            if y1 * y2 < 0:\n                a_initial, b_initial = min(x1, x2), max(x1, x2)\n                found_heuristic_interval = True\n                break\n        if found_heuristic_interval:\n            break\n            \n    # Set the working interval based on heuristic or fallback\n    a = a_initial\n    b = b_initial\n    \n    fa = poly(xs, a)\n    fb = poly(xs, b)\n\n    # Re-check if any bound from the chosen interval is already a root\n    if abs(fa) < DEFAULT_TOLERANCE:\n        return a\n    if abs(fb) < DEFAULT_TOLERANCE:\n        return b\n\n    # Bisection method\n    for _ in range(MAX_ITERATIONS):\n        mid = (a + b) / 2\n        f_mid = poly(xs, mid)\n\n        if abs(f_mid) < DEFAULT_TOLERANCE:\n            return mid\n\n        # Update the interval based on the sign of f_mid relative to f_a\n        if fa * f_mid < 0:\n            b = mid\n            fb = f_mid\n        else:\n            a = mid\n            fa = f_mid\n            \n    # If max iterations reached, return the midpoint of the final interval\n    return (a + b) / 2", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[5, 10, -3, 1]]]}], "HumanEval/46": [{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    Please write a function to efficiently compute the n-th element of the fib4 number sequence.  Do not use recursion.\n    >>> fib4(5)\n    4\n    >>> fib4(6)\n    8\n    >>> fib4(7)\n    14\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # Initialize the last four values corresponding to fib4(0), fib4(1), fib4(2), fib4(3)\n    # These represent fib4(i-4), fib4(i-3), fib4(i-2), fib4(i-1) in the loop\n    a = 0  # fib4(0)\n    b = 0  # fib4(1)\n    c = 2  # fib4(2)\n    d = 0  # fib4(3)\n\n    # Iterate from 4 up to n to compute the n-th Fib4 number\n    for _ in range(4, n + 1):\n        next_fib = a + b + c + d\n        # Update the rolling window: shift values and assign the new fib4 number\n        a, b, c, d = b, c, d, next_fib\n    \n    return d", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/43": [{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    seen_numbers = set()\n    for num in l:\n        if -num in seen_numbers:\n            return True\n        seen_numbers.add(num)\n    return False", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail