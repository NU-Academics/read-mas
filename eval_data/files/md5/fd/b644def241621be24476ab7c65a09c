anges)\n\n        def _extract_count(self, text: str, keyword: str) -> int:\n            \"\"\"\n            Helper to extract a numerical count preceding a specific keyword.\n            \"\"\"\n            pattern = rf\"(\\d+)\\s+{re.escape(keyword)}\"\n            match = re.search(pattern, text)\n            if not match:\n                raise InvalidFruitStringError(f\"Could not find count for '{keyword}' in string: '{text}'\")\n            return int(match.group(1))\n\n    class FruitCalculator:\n        def __init__(self):\n            self._parser = FruitParser()\n\n        def calculate_mangoes(self, parsed_counts: ParsedFruitCounts, total_fruits: int) -> int:\n            \"\"\"\n            Calculates the number of mangoes based on parsed fruit counts and total fruits.\n            \"\"\"\n            if total_fruits < 0:\n                raise InvalidFruitCountError(\"Total fruits cannot be negative.\")\n            if parsed_counts.apples < 0 or parsed_counts.oranges < 0:\n                raise InvalidFruitCountError(\"Apple or orange counts cannot be negative.\")\n\n            total_known_fruits = parsed_counts.apples + parsed_counts.oranges\n            if total_known_fruits > total_fruits:\n                raise InvalidFruitCountError(\n                    f\"Sum of apples ({parsed_counts.apples}) and oranges ({parsed_counts.oranges}) \"\n                    f\"exceeds total fruits ({total_fruits}).\"\n                )\n            return total_fruits - total_known_fruits\n\n    calculator = FruitCalculator()\n    try:\n        parsed_counts = calculator._parser.parse(s)\n        return calculator.calculate_mangoes(parsed_counts, n)\n    except (InvalidFruitStringError, InvalidFruitCountError) as e:\n        raise e", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/76": [{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Your task is to write a function that retur