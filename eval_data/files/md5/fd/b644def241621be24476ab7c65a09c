integer to it. If the number is equidistant\n    from two integers, round it away from zero.\n\n    Examples\n    >>> closest_integer(\"10\")\n    10\n    >>> closest_integer(\"15.3\")\n    15\n\n    Note:\n    Rounding away from zero means that if the given number is equidistant\n    from two integers, the one you should return is the one that is the\n    farthest from zero. For example closest_integer(\"14.5\") should\n    return 15 and closest_integer(\"-14.5\") should return -15.\n    '''\n    num = float(value)\n    \n    floor_num = math.floor(num)\n    ceil_num = math.ceil(num)\n\n    # Calculate distances to floor and ceil.\n    dist_to_floor = abs(num - floor_num)\n    dist_to_ceil = abs(num - ceil_num)\n\n    if dist_to_floor == dist_to_ceil:\n        # Equidistant case (e.g., X.5), round away from zero.\n        if num >= 0:\n            return int(ceil_num)\n        else: # num < 0\n            return int(floor_num)\n    elif dist_to_floor < dist_to_ceil:\n        return int(floor_num)\n    else: # dist_to_ceil < dist_to_floor\n        return int(ceil_num)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/106": [{"task_id": "HumanEval/106", "solution": "def f(n):\n    \"\"\" Implement the function f that takes n as a parameter,\n    and returns a list of size n, such that the value of the element at index i is the factorial of i if i is even\n    or the sum of numbers from 1 to i otherwise.\n    \"\"\"\n    def _factorial(k):\n        # Calculates the factorial of k.\n        if k == 0:\n            return 1\n        res = 1\n        for i in range(1, k + 1):\n            res *= i\n        return res\n\n    def _sum_up_to(k):\n        # Calculates the sum of numbers from 1 to k.\n        return k * (k + 1) // 2\n\n    if n <= 0:\n        return []\n\n    result_list = []\n    for i in range(1, n + 1):\n        if i % 2 == 0:  # Even index\n            result_list.append(_factorial(i))\n        else:  # Odd index\n            result_list.append(_sum_up_to(i))\n    return result_list", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/104": [{"task_id": "HumanEval/104", "solution": "def unique_digits(x):\n    \"\"\"Given a list of positive integers x. return a sorted list of all \n    elements that hasn't any even digit.\n    \"\"\"\n    def _has_even_digit(number):\n        \"\"\"Checks if a given integer contains at least one even digit.\"\"\"\n        for digit_char in str(number):\n            digit = int(digit_char)\n            if digit % 2 == 0:\n                return True\n        return False\n\n    filtered_numbers = []\n    for num in x:\n        if not _has_even_digit(num):\n            filtered_numbers.append(num)\n\n    filtered_numbers.sort()\n    return filtered_numbers", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/100": [{"task_id": "HumanEval/100", "solution": "def make_a_pile(n):\n    \"\"\"\n    Given a positive integer n, return a list where each element represents the number of stones in a level.\n    The first level has n stones, and subsequent levels increment by 2, maintaining the initial parity.\n    \"\"\"\n    pile_levels = [n]\n    current_stones = n\n\n    for _ in range(1, n):\n        current_stones += 2\n        pile_levels.append(current_stones)\n\n    return pile_levels", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/107": [{"task_id": "HumanEval/107", "solution": "def even_odd_palindrome(n):\n    \"\"\"\n    Counts even and odd integer palindromes within the range [1, n].\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    for i in range(1, n + 1):\n        # Check if the number is a palindrome\n        s_i = str(i)\n        if s_i == s_i[::-1]:\n            # Check if the palindrome is even or odd\n            if i % 2 == 0:\n                even