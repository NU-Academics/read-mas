{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int) -> int:\n    \"\"\"\n    Calculates the sum of all integers from 1 to n (inclusive).\n\n    This function utilizes Gauss's formula for the sum of an arithmetic series\n    to achieve constant time complexity (O(1)).\n\n    Args:\n        n (int): The upper bound integer for the summation.\n                 Must be a positive integer (n >= 1).\n\n    Returns:\n        int: The sum of integers from 1 to n.\n\n    Raises:\n        ValueError: If n is less than 1, as the problem context\n                    implies positive integers.\n        TypeError: If n is not an integer.\n\n    Examples:\n        >>> sum_to_n(30)\n        465\n        >>> sum_to_n(100)\n        5050\n        >>> sum_to_n(5)\n        15\n        >>> sum_to_n(10)\n        55\n        >>> sum_to_n(1)\n        1\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 1:\n        raise ValueError(\"Input 'n' must be a positive integer (n >= 1).\")\n\n    # Using the arithmetic series sum formula: n * (n + 1) / 2\n    # The result of this division is guaranteed to be an integer if n or (n+1) is even.\n    return (n * (n + 1)) // 2"}
{"task_id": "HumanEval/61", "solution": "def correct_bracketing(brackets: str) -> bool:\n    \"\"\"\n    Checks if a string of '(' and ')' characters has correctly balanced brackets.\n\n    This function determines if every opening bracket has a corresponding closing\n    bracket, and they are correctly nested and ordered.\n\n    Args:\n        brackets: A string consisting only of '(' and ')' characters.\n                  Assumes input strictly contains only these characters as per\n                  product constraints (2.3) and assumptions (2.5).\n\n    Returns:\n        True if the brackets are correctly balanced, meaning:\n        1. Every opening bracket has a matching closing bracket.\n        2. Brackets are closed in the correct order (e.g., '(()())' is valid, ')((()' is not).\n        3. An empty string is considered correctly balanced.\n        False otherwise.\n    \"\"\"\n    open_brackets_count = 0\n\n    # F.6: Process the input string from left to right.\n    for char in brackets:\n        if char == '(':\n            open_brackets_count += 1\n        elif char == ')':\n            # F.4: Return False if a closing bracket appears before a corresponding opening bracket.\n            if open_brackets_count == 0:\n                return False\n            open_brackets_count -= 1\n        # As per assumption 2.5, no other characters are expected,\n        # so no 'else' clause for invalid characters is needed.\n\n    # F.5: True if every opening bracket has a corresponding closing bracket, and they are correctly nested.\n    # F.2: True if the input string is empty (open_brackets_count will be 0).\n    # F.3: False if an unequal number of opening and closing brackets (open_brackets_count != 0).\n    return open_brackets_count == 0"}
{"task_id": "HumanEval/61", "solution": "def correct_bracketing(brackets: str) -> bool:\n    \"\"\" brackets is a string of \"(\" and \")\".\n    return True if every opening bracket has a corresponding closing bracket.\n\n    >>> correct_bracketing(\"(\")\n    False\n    >>> correct_bracketing(\"()\")\n    True\n    >>> correct_bracketing(\"(()())\")\n    True\n    >>> correct_bracketing(\")(()\")\n    False\n    >>> correct_bracketing(\"\")\n    True\n    >>> correct_bracketing(\"(())(\")\n    False\n    \"\"\"\n    stack = []\n    for char in brackets:\n        if char == '(':\n            stack.append(char)\n        elif char == ')':\n            if not stack:\n                return False  # Unmatched closing bracket\n            stack.pop()\n        # Per specification (2.5 Assumptions and Dependencies),\n        # it is assumed the input string will only contain '(' and ')' characters.\n        # No handling is needed for other characters.\n\n    return not stack # True if stack is empty (all brackets matched), False otherwise"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list) -> list:\n    \"\"\"\n    Calculates the derivative of a polynomial given its coefficients.\n\n    The polynomial is represented as: xs[0] + xs[1]*x + xs[2]*x^2 + ... + xs[n]*x^n\n\n    Args:\n        xs (list): A list of numerical coefficients. xs[i] is the coefficient of x^i.\n\n    Returns:\n        list: A new list of numerical coefficients representing the derivative polynomial.\n              The derivative polynomial is represented as:\n              result[0] + result[1]*x + result[2]*x^2 + ...\n              An empty list is returned if the input polynomial is constant or empty.\n\n    Examples:\n        >>> derivative([3, 1, 2, 4, 5])\n        [1, 4, 12, 20]\n        >>> derivative([1, 2, 3])\n        [2, 6]\n        >>> derivative([5])\n        []\n        >>> derivative([])\n        []\n    \"\"\"\n    result = []\n    # Iterate from the second coefficient (index 1), as the derivative of xs[0] (constant) is 0.\n    # For each coefficient xs[i], its derivative term will have coefficient i * xs[i]\n    # and its power will be x^(i-1).\n    for i in range(1, len(xs)):\n        new_coefficient = i * xs[i]\n        result.append(new_coefficient)\n    return result"}
{"task_id": "HumanEval/62", "solution": "class PolynomialCalculator:\n    \"\"\"\n    A utility class for polynomial operations.\n    \"\"\"\n    @staticmethod\n    def derivative(xs: list) -> list:\n        \"\"\"\n        Calculates the derivative of a polynomial represented by coefficients.\n        xs[0] + xs[1] * x + xs[2] * x^2 + ....\n\n        Args:\n            xs: A list of numbers representing the polynomial coefficients.\n\n        Returns:\n            A list of numbers representing the coefficients of the derivative polynomial.\n        \"\"\"\n        # F.2 Handle Constant Polynomials: If the input list xs contains only one element, return an empty list.\n        # F.3 Handle Zero Polynomial: If the input list xs is empty, return an empty list.\n        if len(xs) <= 1:\n            return []\n\n        derived_coeffs = []\n        # F.1 Calculate Derivative: For P(x) = a_0 + a_1*x + ... + a_n*x^n, P'(x) = 1*a_1 + 2*a_2*x + ... + n*a_n*x^(n-1).\n        # The coefficient of x^j in P'(x) is (j+1) * a_{j+1}.\n        # In terms of original list indices: xs[i] is a_i.\n        # The derivative of a_i * x^i is i * a_i * x^(i-1).\n        # So, the coefficient for x^(i-1) in the derivative is i * xs[i].\n        # We iterate from i=1 (the coefficient of x^1) up to len(xs)-1 (the highest power).\n        for i in range(1, len(xs)):\n            new_coeff = i * xs[i]\n            derived_coeffs.append(new_coeff)\n            \n        # F.4 Input Type Handling: Python's native arithmetic handles int/float type promotion automatically.\n        return derived_coeffs"}
{"task_id": "HumanEval/63", "solution": "def fibfib(n: int) -> int:\n    \"\"\"\n    Calculates the n-th element of the FibFib number sequence.\n\n    The sequence is defined as:\n    fibfib(0) = 0\n    fibfib(1) = 0\n    fibfib(2) = 1\n    fibfib(n) = fibfib(n-1) + fibfib(n-2) + fibfib(n-3) for n > 2\n\n    Args:\n        n: The integer index (non-negative) of the desired FibFib number.\n\n    Returns:\n        The n-th FibFib number as an integer.\n\n    Raises:\n        ValueError: If n is a negative integer.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n    elif n == 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 1\n    else:\n        # Initialize base cases for fibfib(0), fibfib(1), fibfib(2)\n        # 'a' stores fibfib(i-3)\n        # 'b' stores fibfib(i-2)\n        # 'c' stores fibfib(i-1)\n        a = 0  # Represents fibfib(0)\n        b = 0  # Represents fibfib(1)\n        c = 1  # Represents fibfib(2)\n\n        # Iterate from n=3 up to the target n\n        for i in range(3, n + 1):\n            next_fib = a + b + c\n            # Shift values for the next iteration\n            a = b\n            b = c\n            c = next_fib\n        return c"}
{"task_id": "HumanEval/63", "solution": "def fibfib(n: int) -> int:\n    \"\"\"\n    Calculates the n-th element of the FibFib number sequence.\n\n    The FibFib sequence is defined as:\n    fibfib(0) = 0\n    fibfib(1) = 0\n    fibfib(2) = 1\n    fibfib(n) = fibfib(n-1) + fibfib(n-2) + fibfib(n-3) for n > 2.\n\n    Args:\n        n: A non-negative integer representing the index in the FibFib sequence.\n\n    Returns:\n        The n-th FibFib number.\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 1\n    else:\n        # Initialize the first three FibFib numbers for n-3, n-2, n-1 positions\n        # These correspond to fibfib(0), fibfib(1), fibfib(2) when starting the loop for i=3\n        a = 0  # Represents fibfib(i-3)\n        b = 0  # Represents fibfib(i-2)\n        c = 1  # Represents fibfib(i-1)\n\n        # Iterate from the 3rd index up to n (inclusive)\n        for i in range(3, n + 1):\n            next_fib = a + b + c\n            # Shift values for the next iteration\n            a = b\n            b = c\n            c = next_fib\n        return c"}
