{"task_id": "HumanEval/55", "solution": "def fib(n: int) -> int:\n    \"\"\"\n    Calculates the nth Fibonacci number based on a 1-indexed sequence\n    where F(1)=1 and F(2)=1.\n\n    Args:\n        n (int): The position of the desired Fibonacci number in the sequence.\n                 Must be a positive integer.\n\n    Returns:\n        int: The nth Fibonacci number.\n\n    Raises:\n        ValueError: If 'n' is not a positive integer (i.e., n <= 0 or\n                    n is not of type int).\n    \"\"\"\n    # FR.1, FR.6: Input validation. 'n' must be a positive integer.\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    # FR.3: Base case for n = 1\n    if n == 1:\n        return 1\n    \n    # FR.4: Base case for n = 2\n    if n == 2:\n        return 1\n\n    # FR.5, QOS.2: Iterative calculation for n > 2 using the recurrence relation\n    # F(n) = F(n-1) + F(n-2). This avoids excessive recalculations of naive recursion.\n    # Initialize variables for F(1) and F(2)\n    a, b = 1, 1\n\n    # Iterate from the 3rd number up to the nth number\n    for _ in range(3, n + 1):\n        # Calculate the next Fibonacci number\n        next_fib = a + b\n        # Update 'a' to become the previous 'b' (F(k-1))\n        # Update 'b' to become the 'next_fib' (F(k))\n        a = b\n        b = next_fib\n        \n    # After the loop, 'b' holds the nth Fibonacci number\n    return b"}
{"task_id": "HumanEval/55", "solution": "def fib(n: int) -> int:\n    \"\"\"\n    Calculates the n-th Fibonacci number using an iterative approach.\n\n    Args:\n        n (int): The non-negative integer index of the Fibonacci number to calculate.\n\n    Returns:\n        int: The n-th Fibonacci number (F(n)).\n\n    Raises:\n        ValueError: If the input 'n' is a negative integer.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n    elif n == 0:\n        return 0\n    elif n == 1:\n        return 1\n    else:\n        a, b = 0, 1\n        # Loop n-1 times to calculate F(2) through F(n)\n        for _ in range(2, n + 1):\n            next_fib = a + b\n            a = b\n            b = next_fib\n        return b"}
{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str) -> bool:\n    \"\"\"\n    Checks if a string of '<' and '>' characters has correctly matched and nested brackets.\n\n    Parameters:\n    brackets (str): The input string containing only '<' and '>' characters.\n\n    Returns:\n    bool: True if every opening bracket has a corresponding closing bracket in correct order,\n          False otherwise.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '<':\n            balance += 1\n        elif char == '>':\n            balance -= 1\n        \n        # If balance ever drops below zero, a closing bracket appeared without a matching open bracket.\n        if balance < 0:\n            return False\n            \n    # After iterating through the entire string, if the balance is zero,\n    # all opening brackets were correctly closed.\n    return balance == 0"}
{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str) -> bool:\n    \"\"\"\n    Checks if a string of '<' and '>' characters has correct bracketing.\n\n    A string has correct bracketing if:\n    1. Every opening bracket ('<') has a corresponding closing bracket ('>')\n       appearing after it.\n    2. Every closing bracket ('>') has a corresponding opening bracket ('<')\n       appearing before it.\n    3. Brackets are properly nested (i.e., the count of open brackets never\n       drops below zero, and is zero at the end).\n\n    Args:\n        brackets: The input string containing only '<' and '>' characters.\n\n    Returns:\n        True if the bracketing is correct, False otherwise.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '<':\n            balance += 1\n        elif char == '>':\n            balance -= 1\n        # Per REQ-FUNC-006: If balance drops below zero, a closing bracket\n        # appeared without a corresponding opening bracket. Return False immediately.\n        if balance < 0:\n            return False\n        # Constraint 2.3 notes: \"The function's behavior with other characters\n        # is undefined but should not raise unhandled exceptions.\"\n        # Implicitly ignoring other characters here satisfies this.\n        # An explicit 'else' block could raise an error if strict validation\n        # of input characters were required, but the SRS defines behavior\n        # only for '<' and '>'.\n\n    # Per REQ-FUNC-007: For correct bracketing, the balance must be exactly\n    # zero at the end. A positive balance means unmatched opening brackets.\n    return balance == 0"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list) -> bool:\n    \"\"\"\n    Checks if a list of numbers is monotonically increasing or decreasing.\n\n    A list is monotonic if it is either entirely non-decreasing or entirely non-increasing.\n    An empty list or a single-element list is considered monotonic.\n\n    Args:\n        l (list): The input list of numbers (integers or floats).\n\n    Returns:\n        bool: True if the list is monotonic, False otherwise.\n\n    Examples:\n        >>> monotonic([1, 2, 4, 20])\n        True\n        >>> monotonic([1, 20, 4, 10])\n        False\n        >>> monotonic([4, 1, 0, -10])\n        True\n        >>> monotonic([])\n        True\n        >>> monotonic([5])\n        True\n    \"\"\"\n    if len(l) <= 1:\n        return True\n\n    # Check for non-decreasing sequence\n    # all() short-circuits on the first False\n    is_non_decreasing = all(l[i] <= l[i+1] for i in range(len(l) - 1))\n    if is_non_decreasing:\n        return True\n\n    # Check for non-increasing sequence\n    # all() short-circuits on the first False\n    is_non_increasing = all(l[i] >= l[i+1] for i in range(len(l) - 1))\n    if is_non_increasing:\n        return True\n\n    # If neither, the list is not monotonic\n    return False"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list) -> bool:\n    \"\"\"\n    Determines if a given list of elements is monotonic.\n\n    A list is monotonic if it is either entirely non-increasing or entirely non-decreasing.\n    Empty lists and single-element lists are considered monotonic.\n\n    Args:\n        l: A list of comparable elements (e.g., numbers, strings).\n\n    Returns:\n        True if the list is monotonic, False otherwise.\n    \"\"\"\n    # FR.2, FR.3: Handle empty or single-element lists\n    if len(l) <= 1:\n        return True\n\n    is_non_decreasing = True\n    is_non_increasing = True\n\n    # QOS.1: Iterate through the list once\n    for i in range(len(l) - 1):\n        # FR.4: Check for non-decreasing property\n        if l[i] > l[i+1]:\n            is_non_decreasing = False\n\n        # FR.5: Check for non-increasing property\n        if l[i] < l[i+1]:\n            is_non_increasing = False\n\n        # QOS.1 (Optimization), FR.7: Early exit if it's neither\n        if not is_non_decreasing and not is_non_increasing:\n            return False\n\n    # FR.6: Return True if it's either non-decreasing or non-increasing\n    # QOS.2: Space complexity is O(1)\n    return is_non_decreasing or is_non_increasing"}
{"task_id": "HumanEval/58", "solution": "from typing import List, TypeVar\nT = TypeVar('T')\ndef common(l1: List[T], l2: List[T]) -> List[T]:\n    \"\"\"Return sorted unique common elements for two lists.\n    >>> common([1, 4, 3, 34, 653, 2, 5], [5, 7, 1, 5, 9, 653, 121])\n    [1, 5, 653]\n    >>> common([5, 3, 2, 8], [3, 2])\n    [2, 3]\n\n    \"\"\"\n    if not isinstance(l1, list) or not isinstance(l2, list):\n        raise TypeError(\"Both inputs must be lists.\")\n\n    # Convert lists to sets for efficient intersection and uniqueness.\n    # This step implicitly handles uniqueness for elements within each list as well.\n    # Requires elements to be hashable.\n    set1 = set(l1)\n    set2 = set(l2)\n\n    # Find common elements using set intersection.\n    # The result is a set, guaranteeing uniqueness of common elements.\n    common_set = set1.intersection(set2)\n\n    # Convert the resulting set back to a list.\n    common_list = list(common_set)\n\n    # Sort the list of common elements in ascending order.\n    # This requires elements to be mutually comparable (e.g., using < or > operators).\n    common_list.sort()\n\n    return common_list"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list) -> list:\n    \"\"\"\n    Finds unique common elements between two lists and returns them sorted in ascending order.\n\n    Args:\n        l1: The first input list of elements.\n        l2: The second input list of elements.\n\n    Returns:\n        A new list containing unique common elements, sorted in ascending order.\n        Returns an empty list if no common elements are found.\n    \"\"\"\n    # Convert lists to sets to leverage efficient set operations for intersection\n    # and automatic handling of uniqueness.\n    set_l1 = set(l1)\n    set_l2 = set(l2)\n\n    # Find the intersection of the two sets, which results in a set\n    # containing only the unique common elements.\n    common_elements_set = set_l1.intersection(set_l2)\n\n    # Convert the set of common elements back to a list.\n    common_elements_list = list(common_elements_set)\n\n    # Sort the list of common elements in ascending order as required.\n    sorted_common_elements = sorted(common_elements_list)\n\n    return sorted_common_elements"}
