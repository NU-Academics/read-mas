{"task_id": "HumanEval/86", "solution": "import re\ndef anti_shuffle(s: str) -> str:\n    \"\"\"\n    Takes a string as input and returns an \"ordered\" version of it.\n    An ordered version means that all words within the string have their characters\n    arranged in ascending ASCII order. The original order of words and the exact\n    spacing (including multiple spaces) in the sentence are preserved.\n\n    Args:\n        s (str): The input string to be processed.\n\n    Returns:\n        str: The ordered version of the input string.\n    \"\"\"\n    # Use re.findall to split the string into a list of words (non-space sequences)\n    # and spaces (space sequences), preserving the original order and exact spacing.\n    # r'(\\S+|\\s+)' captures either one or more non-whitespace characters (a word)\n    # OR one or more whitespace characters (a spacer).\n    parts = re.findall(r'(\\S+|\\s+)', s)\n\n    processed_parts = []\n    for part in parts:\n        # Check if the part consists entirely of whitespace characters\n        if not part.isspace():\n            # If it's a word, sort its characters by ASCII value\n            sorted_word = \"\".join(sorted(part))\n            processed_parts.append(sorted_word)\n        else:\n            # If it's a sequence of spaces, keep it as is\n            processed_parts.append(part)\n\n    # Join all processed parts back together to form the final string\n    return \"\".join(processed_parts)"}
{"task_id": "HumanEval/86", "solution": "import re\ndef anti_shuffle(s: str) -> str:\n    \"\"\"\n    Transforms a string by sorting the characters within each word while\n    preserving the original order of words and blank spaces.\n\n    A \"word\" is defined as a contiguous sequence of one or more non-whitespace characters.\n    \"Whitespace\" includes spaces, tabs, newlines, etc.\n    Character sorting is based on ascending ASCII values.\n\n    Args:\n        s (str): The input string to be processed.\n\n    Returns:\n        str: The \"ordered version\" of the input string.\n    \"\"\"\n    # F-1.2: If s is an empty string, return an empty string.\n    if not s:\n        return \"\"\n\n    # F-2.1, F-2.2, F-2.3, F-2.4, F-2.5: Parse the string into parts\n    # (words or space sequences), preserving their original order and treating\n    # multiple spaces/leading/trailing spaces as distinct sequences.\n    # The regex '(\\s+|\\S+)' captures one or more whitespace characters (\\s+)\n    # or one or more non-whitespace characters (\\S+).\n    # re.findall returns a list of all non-overlapping matches.\n    parts = re.findall(r'(\\s+|\\S+)', s)\n\n    processed_parts = []\n    for part in parts:\n        # F-4.1: Parts identified as \"space sequences\" shall remain unchanged.\n        if part.isspace():\n            processed_parts.append(part)\n        else:\n            # F-3.1, F-3.2, F-3.3: For each word, sort its characters\n            # based on ascending ASCII values. Punctuation and special\n            # characters are included in sorting.\n            sorted_chars = sorted(part)\n            processed_parts.append(\"\".join(sorted_chars))\n\n    # F-4.2, F-4.3: Concatenate the processed parts in their original relative\n    # order to form the final output string and return it.\n    return \"\".join(processed_parts)"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst: list[list[int]], x: int) -> list[tuple[int, int]]:\n    \"\"\"\n    Locates all occurrences of a target integer 'x' within a nested list 'lst'\n    and returns their 0-indexed (row, column) coordinates.\n\n    The resulting list of coordinates is sorted primarily by row index in ascending order,\n    and secondarily by column index in descending order for elements within the same row.\n\n    Args:\n        lst: A list of lists, where each inner list contains integers.\n             It can be empty ([]) or contain empty sublists (e.g., [[], [1, 2]]).\n        x: An integer to search for.\n\n    Returns:\n        A list of tuples, where each tuple (row, column) represents a 0-indexed\n        coordinate of 'x' found in 'lst'.\n        Returns an empty list [] if 'x' is not found or 'lst' is empty.\n    \"\"\"\n    coordinates = []\n\n    for row_idx, row in enumerate(lst):\n        for col_idx, value in enumerate(row):\n            if value == x:\n                coordinates.append((row_idx, col_idx))\n\n    # Sort the collected coordinates according to the specified rules:\n    # 1. Primary sort key: row index (ascending)\n    # 2. Secondary sort key: column index (descending)\n    #    Sorting by -coord[1] effectively sorts coord[1] in descending order.\n    coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n\n    return coordinates"}
{"task_id": "HumanEval/87", "solution": "from typing import List, Tuple\ndef get_row(lst: List[List[int]], x: int) -> List[Tuple[int, int]]:\n    \"\"\"\n    Finds all occurrences of an integer x in a 2D nested list and returns their\n    0-indexed (row, column) coordinates. The coordinates are sorted primarily\n    by row in ascending order, and secondarily by column in descending order.\n\n    Args:\n        lst: A 2D list (list of lists) of integers. It can be a ragged list,\n             meaning inner lists (rows) may have different lengths.\n        x: The integer value to search for within the list.\n\n    Returns:\n        A list of (row_index, column_index) tuples.\n        - If x is found multiple times, all its coordinates are returned.\n        - The list is sorted first by row_index (ascending).\n        - For coordinates with the same row_index, they are sorted by\n          column_index (descending).\n        - Returns an empty list if 'lst' is empty or 'x' is not found.\n\n    Examples:\n        >>> get_row([[1,2,3,4,5,6],[1,2,3,4,1,6],[1,2,3,4,5,1]], 1)\n        [(0, 0), (1, 4), (1, 0), (2, 5), (2, 0)]\n        >>> get_row([], 1)\n        []\n        >>> get_row([[], [1], [1, 2, 3]], 3)\n        [(2, 2)]\n        >>> get_row([[5, 8], [1, 5, 9], [5]], 5)\n        [(0, 0), (1, 1), (2, 0)]\n    \"\"\"\n    found_coordinates: List[Tuple[int, int]] = []\n\n    # Iterate through each row of the input list along with its 0-indexed row_index\n    for row_index, row in enumerate(lst):\n        # Iterate through each element in the current row along with its 0-indexed col_index\n        for col_index, element in enumerate(row):\n            # If the current element matches the target integer x, record its coordinates\n            if element == x:\n                found_coordinates.append((row_index, col_index))\n\n    # Sort the collected coordinates according to the specified rules:\n    # 1. Primary sort key: row_index (ascending - coord[0])\n    # 2. Secondary sort key: col_index (descending - achieved by using -coord[1])\n    found_coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n\n    return found_coordinates"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array: list[int]) -> list[int]:\n    \"\"\"\n    Sorts an array of non-negative integers based on the parity of the\n    sum of its first and last elements.\n\n    - If the array is empty, returns an empty list.\n    - If the array has one element, returns a copy of the array.\n    - If the array has two or more elements:\n        - Calculates the sum of the first and last elements.\n        - If the sum is odd, sorts the array in ascending order.\n        - If the sum is even, sorts the array in descending order.\n    - The original array is guaranteed not to be modified.\n    \"\"\"\n    if not array:\n        return []\n\n    if len(array) == 1:\n        return array[:]  # Return a shallow copy\n\n    first_element = array[0]\n    last_element = array[len(array) - 1]\n\n    sum_first_last = first_element + last_element\n\n    # Determine sorting order:\n    # If sum_first_last is odd, sort ascending (reverse=False)\n    # If sum_first_last is even, sort descending (reverse=True)\n    is_sum_even = (sum_first_last % 2 == 0)\n    \n    # Set the reverse flag for the sorted() function\n    # reverse=True for descending, reverse=False for ascending\n    should_reverse = is_sum_even\n\n    return sorted(array, reverse=should_reverse)"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array: list[int]) -> list[int]:\n    \"\"\"\n    Sorts an array of non-negative integers based on a conditional logic.\n    If the sum of the first and last elements is odd, sorts in ascending order.\n    If the sum is even, sorts in descending order.\n    The original array remains unmodified.\n    \"\"\"\n    # 1. Input Handling for Edge Cases:\n    # Check if the input array has less than two elements.\n    # If so, return a direct copy (array[:]) as no conditional sorting logic applies or is necessary.\n    if len(array) < 2:\n        return array[:]\n\n    # 2. Determine Sorting Condition:\n    # Retrieve the first element (array[0]) and the last element (array[-1]).\n    first_element = array[0]\n    last_element = array[-1]\n\n    # Calculate their sum.\n    elements_sum = first_element + last_element\n\n    # Determine sort_order:\n    # If sum % 2 == 1 (odd), set sorting to ascending (reverse=False).\\n\n    # If sum % 2 == 0 (even), set sorting to descending (reverse=True).\\n\n    # The 'reverse' flag for sorted() is True for descending, False for ascending.\n    reverse_sort_flag = (elements_sum % 2 == 0)\n\n    # 3. Perform Sorting:\n    # Create a shallow copy of the input array using slicing (array[:])\n    # to ensure the original array is not modified.\n    array_copy = array[:]\n\n    # Use Python's built-in sorted() function on the copied array.\n    # Pass the reverse parameter based on the determined sorting condition.\n    sorted_new_array = sorted(array_copy, reverse=reverse_sort_flag)\n\n    # 4. Return Result:\n    return sorted_new_array"}
{"task_id": "HumanEval/89", "solution": "import string\ndef encrypt(s: str) -> str:\n    \"\"\"\n    Encrypts a string by rotating lowercase English letters.\n    The alphabet is rotated such that letters shift down by 4 places (2 * 2).\n    Non-alphabetic characters remain unchanged.\n\n    Args:\n        s: The input string to be encrypted.\n\n    Returns:\n        The encrypted string.\n\n    Examples:\n        encrypt('hi') returns 'lm'\n        encrypt('asdfghjkl') returns 'ewhjklnop'\n        encrypt('gf') returns 'kj'\n        encrypt('et') returns 'ix'\n        encrypt('Hello World! 123') returns 'Hello World! 123'\n        encrypt('') returns ''\n        encrypt('123?!') returns '123?!'\n        encrypt('xyz') returns 'bcd'\n    \"\"\"\n    result_chars = []\n    shift_amount = 4  # 2 multiplied by 2\n\n    for char in s:\n        if 'a' <= char <= 'z':\n            # Calculate 0-indexed position (0-25)\n            start_ordinal = ord('a')\n            char_ordinal = ord(char)\n\n            # Apply shift and wrap around using modulo 26\n            shifted_ordinal = ((char_ordinal - start_ordinal + shift_amount) % 26) + start_ordinal\n\n            result_chars.append(chr(shifted_ordinal))\n        else:\n            # Keep non-alphabetic characters unchanged\n            result_chars.append(char)\n\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s: str) -> str:\n    \"\"\"\n    Encrypts a string by rotating each alphabetic character forward by 4 positions.\n    Preserves case and handles wrap-around. Non-alphabetic characters remain unchanged.\n    \"\"\"\n    encrypted_chars = []\n    for char in s:\n        if 'a' <= char <= 'z':  # Check if lowercase alphabetic\n            # Calculate new character code for lowercase, handling wrap-around\n            new_char_code = ((ord(char) - ord('a') + 4) % 26) + ord('a')\n            encrypted_chars.append(chr(new_char_code))\n        elif 'A' <= char <= 'Z':  # Check if uppercase alphabetic\n            # Calculate new character code for uppercase, handling wrap-around\n            new_char_code = ((ord(char) - ord('A') + 4) % 26) + ord('A')\n            encrypted_chars.append(chr(new_char_code))\n        else:  # Non-alphabetic character\n            encrypted_chars.append(char)\n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/90", "solution": "def next_smallest(lst: list[int]) -> int | None:\n    \"\"\"\n    Identifies and returns the second smallest unique integer from a given list of integers.\n\n    Handles various edge cases, including empty lists, lists with a single unique element,\n    and lists containing duplicates. If a second smallest unique element cannot be found,\n    the function returns None.\n\n    Args:\n        lst (list[int]): A list of integer numbers.\n\n    Returns:\n        int | None: The second smallest unique element, or None if no such element exists.\n    \"\"\"\n    # 1. Deduplication: Convert the input list lst into a set to automatically remove duplicate elements.\n    unique_elements_set = set(lst)\n\n    # 2. Conversion to List: Convert the set back into a list.\n    unique_elements_list = list(unique_elements_set)\n\n    # 3. Sorting: Sort this new list of unique elements in ascending order.\n    unique_elements_list.sort()\n\n    # 4. Length Check and 5. Return Value:\n    # If the length is less than 2 (meaning zero or one unique element), return None.\n    if len(unique_elements_list) < 2:\n        return None\n    # Otherwise, return the element at index 1 of the sorted unique list,\n    # which corresponds to the second smallest unique element.\n    else:\n        return unique_elements_list[1]"}
{"task_id": "HumanEval/90", "solution": "def next_smallest(lst: list[int]) -> int | None:\n    \"\"\"\n    Returns the 2nd smallest unique element of the list.\n    Returns None if there is no such element.\n\n    Args:\n        lst: A list of integers.\n\n    Returns:\n        The second smallest unique integer, or None if the list is empty\n        or has fewer than two unique elements.\n    \"\"\"\n    # FR2: If lst is empty, return None.\n    if not lst:\n        return None\n\n    # FR3: Process lst to identify all unique integer elements.\n    # Convert to a set to get unique elements, then back to a list.\n    unique_elements = list(set(lst))\n\n    # FR5: Sort the identified unique integer elements in ascending order.\n    unique_elements.sort()\n\n    # FR4: If the count of unique integer elements is less than 2, return None.\n    if len(unique_elements) < 2:\n        return None\n\n    # FR6: Return the element at index 1 (the second element) of the sorted list.\n    return unique_elements[1]"}
{"task_id": "HumanEval/91", "solution": "import re\ndef is_bored(S: str) -> int:\n    \"\"\"\n    Counts the number of sentences in a given string S that start with 'I' (case-insensitive).\n\n    Sentences are delimited by '.', '?' or '!'.\n\n    Args:\n        S: The input string.\n\n    Returns:\n        An integer representing the count of sentences starting with 'I'.\n\n    Raises:\n        TypeError: If the input S is not a string.\n    \"\"\"\n    if not isinstance(S, str):\n        raise TypeError(\"Input must be a string.\")\n\n    if not S:\n        return 0\n\n    # REQ-FUNC-002, REQ-FUNC-003: Split the string into sentence fragments\n    # using '.', '?', and '!' as delimiters.\n    # re.split handles consecutive delimiters and delimiters at start/end by producing empty strings.\n    sentence_fragments = re.split(r'[.?!]', S)\n    \n    bored_count = 0\n    for fragment in sentence_fragments:\n        # REQ-FUNC-005: Trim leading and trailing whitespace from each fragment.\n        trimmed_sentence = fragment.strip()\n\n        # REQ-FUNC-004: Ignore empty strings resulting from sentence splitting (e.g., from consecutive delimiters).\n        # REQ-FUNC-006: Determine if a valid (non-empty, trimmed) sentence starts with 'I', ignoring case.\n        if trimmed_sentence and trimmed_sentence.lower().startswith('i'):\n            # REQ-FUNC-007: Increment a counter for each sentence that meets the criteria.\n            bored_count += 1\n            \n    # REQ-FUNC-008: Return the final count as an integer.\n    return bored_count"}
{"task_id": "HumanEval/91", "solution": "import re\ndef is_bored(text_string: str) -> int:\n    \"\"\"\n    Analyzes a given string of text and counts the number of \"boredoms.\"\n    A boredom is defined as a sentence that starts with the word \"I\" (case-insensitive).\n    Sentences are delimited by '.', '?' or '!'.\n\n    Args:\n        text_string (str): The text to be analyzed.\n\n    Returns:\n        int: The count of \"boredoms\" found in the text.\n\n    Raises:\n        TypeError: If the input is not a string.\n    \"\"\"\n    # R.2, S.1: Input Validation - Ensure input is a string.\n    if not isinstance(text_string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    bored_count = 0\n\n    # F.9: Empty Input Handling - If the string is empty or only contains whitespace, return 0.\n    if not text_string.strip():\n        return 0\n\n    # F.2, F.3: Sentence Delimitation and Extraction.\n    # Split the text by sentence delimiters ('.', '?', '!')\n    # re.split can produce empty strings, especially if delimiters are at the start/end\n    # or are consecutive (e.g., \"Hi!!\"). These need to be filtered out.\n    sentences = re.split(r'[.?!]', text_string)\n\n    for sentence in sentences:\n        # F.4: Whitespace Handling - Trim leading and trailing whitespace from each sentence.\n        trimmed_sentence = sentence.strip()\n\n        # Only process non-empty sentences after trimming.\n        if trimmed_sentence:\n            # F.5: First Word Identification.\n            # Use regex to find the first sequence of alphabetic characters at the start\n            # of the trimmed sentence, ignoring any leading non-alphanumeric characters (e.g., quotes).\n            # This ensures \"I\" is correctly identified even if preceded by punctuation.\n            match = re.match(r'^\\W*([A-Za-z]+)', trimmed_sentence)\n\n            if match:\n                first_word = match.group(1)  # Extract the captured alphabetic word\n\n                # F.6: \"I\" Check (Case-Insensitive).\n                # 2.3: \"I\" must be a standalone word, not part of another word (e.g., \"Idea\").\n                # The regex `[A-Za-z]+` ensures it's a word, and `match.group(1)` isolates it.\n                if first_word.lower() == \"i\":\n                    # F.7: Boredom Counting - Increment the counter.\n                    bored_count += 1\n\n    # F.8: Result Return - Return the final count.\n    return bored_count"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z) -> bool:\n    \"\"\"\n    Checks if one of the numbers is equal to the sum of the other two,\n    and all numbers are integers.\n\n    Args:\n        x: The first number.\n        y: The second number.\n        z: The third number.\n\n    Returns:\n        True if one of the numbers is equal to the sum of the other two,\n              and all numbers are integers.\n        False in any other cases.\n\n    Examples:\n        any_int(5, 2, 7) \u279e True\n        any_int(3, 2, 2) \u279e False\n        any_int(3, -2, 1) \u279e True\n        any_int(3.6, -2.2, 2) \u279e False\n    \"\"\"\n    # 1. Validate that all inputs are integers\n    if not all(isinstance(arg, int) for arg in [x, y, z]):\n        return False\n\n    # 2. Check if any one number is the sum of the other two\n    condition1 = (x == y + z)\n    condition2 = (y == x + z)\n    condition3 = (z == x + y)\n\n    return condition1 or condition2 or condition3"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z) -> bool:\n    \"\"\"\n    Checks if all three numbers are integers AND one of the numbers is equal to\n    the sum of the other two.\n\n    Args:\n        x (Any): The first value, expected to be a number.\n        y (Any): The second value, expected to be a number.\n        z (Any): The third value, expected to be a number.\n\n    Returns:\n        bool: True if all three inputs are integers AND at least one of them\n              is the sum of the other two. False otherwise.\n\n    Examples:\n        >>> any_int(5, 2, 7)\n        True\n        >>> any_int(3, 2, 2)\n        False\n        >>> any_int(3, -2, 1)\n        True\n        >>> any_int(3.6, -2.2, 2)\n        False\n        >>> any_int('a', 1, 2)\n        False\n        >>> any_int(None, 1, 2)\n        False\n    \"\"\"\n    # REQ-ANYINT-110, REQ-ANYINT-120, REQ-ANYINT-130: Verify all inputs are integers.\n    # REQ-ANYINT-140: If any are not integers, return False immediately.\n    if not (isinstance(x, int) and isinstance(y, int) and isinstance(z, int)):\n        return False\n\n    # REQ-ANYINT-150, REQ-ANYINT-160, REQ-ANYINT-170: Check the sum conditions.\n    # REQ-ANYINT-180: Return True if all inputs are integers AND any sum condition is met.\n    # REQ-ANYINT-190: Otherwise (if integers but no sum condition met), return False.\n    if (x == y + z) or (y == x + z) or (z == x + y):\n        return True\n    else:\n        return False"}
{"task_id": "HumanEval/93", "solution": "def encode(message: str) -> str:\n    \"\"\"\n    Encodes a message by swapping the case of all letters and replacing\n    all vowels with the letter that appears 2 places ahead in the\n    English alphabet. Non-letter characters are preserved.\n\n    Rules:\n    1. For each letter:\n        a. If the *original* letter is a vowel (a, e, i, o, u, case-insensitive),\n           replace it with the letter two places ahead in the alphabet,\n           preserving its original case (e.g., 'a' -> 'c', 'E' -> 'G').\n        b. Then, swap the case of this resulting character\n           (which was either the consonant or the replaced vowel).\n    2. Non-letter characters (e.g., spaces, numbers, symbols) are unchanged.\n\n    Examples:\n    >>> encode('test')\n    'TGST'\n    >>> encode('This is a message')\n    'tHKS KS C MGSSCGG'\n    >>> encode('Hello World123')\n    'hGLLQ wQRLD123'\n    \"\"\"\n    \n    encoded_chars = []\n    vowels = 'aeiouAEIOU'\n\n    for char in message:\n        if 'a' <= char <= 'z' or 'A' <= char <= 'Z': # Check if character is an English letter\n            processed_char = char\n            \n            # Step 1a: If original char is a vowel, replace it with letter 2 places ahead\n            if char in vowels:\n                if 'a' <= char <= 'z':\n                    # Handle lowercase vowels\n                    processed_char = chr(ord(char) + 2)\n                elif 'A' <= char <= 'Z':\n                    # Handle uppercase vowels\n                    processed_char = chr(ord(char) + 2)\n            \n            # Step 1b: Swap the case of the (potentially shifted) character\n            if processed_char.islower():\n                encoded_chars.append(processed_char.upper())\n            else:\n                encoded_chars.append(processed_char.lower())\n        else:\n            # Step 2: Preserve non-letter characters\n            encoded_chars.append(char)\n            \n    return ''.join(encoded_chars)"}
{"task_id": "HumanEval/93", "solution": "def encode(message: str) -> str:\n    \"\"\"\n    Transforms a given string message according to specific rules:\n    - Swaps the case of all alphabetic characters.\n    - Subsequently, replaces any vowels (that result from the case swap)\n      with the letter two places ahead in the English alphabet,\n      preserving the character's case.\n    - Non-alphabetic characters remain unchanged.\n\n    Args:\n        message (str): The text to be encoded.\n\n    Returns:\n        str: The encoded text.\n    \"\"\"\n    encoded_chars = []\n    vowels = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n\n    for char in message:\n        if char.isalpha():\n            swapped_char = char.swapcase()\n            if swapped_char in vowels:\n                # Calculate the shifted character, preserving case\n                shifted_char_ord = ord(swapped_char) + 2\n                final_char = chr(shifted_char_ord)\n            else:\n                final_char = swapped_char\n        else:\n            final_char = char\n        encoded_chars.append(final_char)\n\n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/94", "solution": "import math\ndef is_prime(n: int) -> bool:\n    \"\"\"\n    Checks if a given integer n is a prime number.\n\n    Input:\n        n (int): An integer.\n    Output:\n        True if n is prime, False otherwise.\n    Logic:\n        REQ-ISPR-001: The system shall return False if n <= 1.\n        REQ-ISPR-002: The system shall return True if n == 2 or n == 3.\n        REQ-ISPR-003: The system shall return False if n % 2 == 0.\n        REQ-ISPR-004: The system shall iterate i starting from 3 up to and including the integer square root of n,\n                      incrementing i by 2 in each step.\n        REQ-ISPR-005: If n is divisible by i (i.e., n % i == 0), the system shall return False.\n        REQ-ISPR-006: If the loop completes without finding any divisors, the system shall return True.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2 or n == 3:\n        return True\n    if n % 2 == 0:  # REQ-ISPR-003\n        return False\n    \n    # REQ-ISPR-004: Iterate i from 3 up to int(sqrt(n)), incrementing by 2\n    # Using math.isqrt for efficiency (integer square root)\n    for i in range(3, math.isqrt(n) + 1, 2):\n        if n % i == 0:  # REQ-ISPR-005\n            return False\n    return True  # REQ-ISPR-006\ndef sum_digits(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the digits of a given non-negative integer n.\n\n    Input:\n        n (int): A non-negative integer.\n    Output:\n        An integer, representing the sum of the digits of n.\n    Logic:\n        REQ-SUDI-001: The system shall initialize digit_sum to 0.\n        REQ-SUDI-002: The system shall loop while n > 0.\n        REQ-SUDI-003: Inside the loop, the system shall add n % 10 to digit_sum.\n        REQ-SUDI-004: Inside the loop, the system shall update n by integer division n //= 10.\n        REQ-SUDI-005: After the loop terminates, the system shall return digit_sum.\n    \"\"\"\n    digit_sum = 0  # REQ-SUDI-001\n    # Ensure n is non-negative, though for primes it will always be.\n    # The problem specification for sum_digits states \"non-negative integer\".\n    n = abs(n) \n    while n > 0:  # REQ-SUDI-002\n        digit_sum += n % 10  # REQ-SUDI-003\n        n //= 10             # REQ-SUDI-004\n    return digit_sum         # REQ-SUDI-005\ndef skjkasdkd(lst: list[int]) -> int:\n    \"\"\"\n    Finds the largest prime number in a given list of integers and returns the sum of its digits.\n\n    Input:\n        lst (list of integers).\n    Output:\n        An integer, representing the sum of the digits of the largest prime found in lst.\n    Logic:\n        REQ-SKJK-001: The system shall initialize largest_prime to -1.\n        REQ-SKJK-002: The system shall iterate through each num in the input list lst.\n        REQ-SKJK-003: For each num, the system shall call is_prime(num) to check if num is a prime number.\n        REQ-SKJK-004: If is_prime(num) returns True AND num is greater than largest_prime,\n                      the system shall update largest_prime = num.\n        REQ-SKJK-005: After iterating through the entire list, the system shall call sum_digits(largest_prime).\n        REQ-SKJK-006: The system shall return the result of sum_digits(largest_prime).\n    Constraints:\n        - The input list lst is guaranteed to contain at least one prime number.\n        - Prime numbers are defined as positive integers greater than 1.\n    \"\"\"\n    largest_prime = -1  # REQ-SKJK-001\n\n    for num in lst:  # REQ-SKJK-002\n        if is_prime(num):  # REQ-SKJK-003\n            if num > largest_prime:  # REQ-SKJK-004\n                largest_prime = num\n    \n    # According to constraints, largest_prime will always be updated to a prime number >= 2.\n    # No need to handle largest_prime still being -1.\n    \n    return sum_digits(largest_prime)  # REQ-SKJK-005, REQ-SKJK-006"}
{"task_id": "HumanEval/94", "solution": "import math\ndef _is_prime(n: int) -> bool:\n    \"\"\"\n    Determines if a given integer n is a prime number.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    # Check for divisibility by odd integers from 3 up to the square root of n\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        if n % i == 0:\n            return False\n    return True\ndef _sum_digits(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the digits of a given non-negative integer n.\n    \"\"\"\n    digit_sum = 0\n    # Handle the case of n=0 separately as the while loop condition n > 0 would fail\n    if n == 0:\n        return 0\n        \n    while n > 0:\n        digit_sum += n % 10  # Add the last digit\n        n //= 10             # Remove the last digit\n    return digit_sum\ndef skjkasdkd(lst: list[int]) -> int:\n    \"\"\"\n    Processes a list of integers, identifies the largest prime number within it,\n    and then calculates the sum of the digits of that largest prime.\n\n    Returns 0 if the list is empty or contains no prime numbers.\n    \"\"\"\n    largest_prime = 0\n\n    for num in lst:\n        if _is_prime(num) and num > largest_prime:\n            largest_prime = num\n    \n    if largest_prime == 0:\n        return 0\n    else:\n        return _sum_digits(largest_prime)"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(input_dict: dict) -> bool:\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower\n    case or all keys are strings in upper case, else return False.\n    The function should return False if the given dictionary is empty.\n    Non-string keys will immediately result in a False return.\n    \"\"\"\n    # F1: The system shall return False if the input_dict is empty.\n    if not input_dict:\n        return False\n\n    all_lower = True\n    all_upper = True\n\n    for key in input_dict:\n        # F2: The system shall return False if any key in input_dict is not of type str.\n        if not isinstance(key, str):\n            return False\n\n        # F3 & F4: Determine if all keys are entirely lowercase or entirely uppercase.\n        if not key.islower():\n            all_lower = False\n        if not key.isupper():\n            all_upper = False\n\n        # F6: Early exit if neither F3 nor F4 can be met.\n        # This occurs if a key is mixed case (e.g., \"Name\") or\n        # if the dictionary already contains a mix of purely lower and purely upper keys.\n        if not all_lower and not all_upper:\n            return False\n\n    # F5: Return True if F3 is met OR F4 is met.\n    # If the loop completes, it means either all_lower is True (all keys were lower)\n    # or all_upper is True (all keys were upper), or both flags became False\n    # due to a single mixed-case key, but the early exit wasn't triggered\n    # (e.g., a dictionary with just one key like {\"Name\": \"value\"}).\n    # The final return covers F5 and the remaining F6 cases where no early exit happened.\n    return all_lower or all_upper"}
{"task_id": "HumanEval/95", "solution": "from typing import Dict, Any\ndef check_dict_case(d: Dict[Any, Any]) -> bool:\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower \n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    \n    Examples:\n    check_dict_case({\"a\":\"apple\", \"b\":\"banana\"}) should return True.\n    check_dict_case({\"a\":\"apple\", \"A\":\"banana\", \"B\":\"banana\"}) should return False.\n    check_dict_case({\"a\":\"apple\", 8:\"banana\", \"a\":\"apple\"}) should return False.\n    check_dict_case({\"Name\":\"John\", \"Age\":\"36\", \"City\":\"Houston\"}) should return False.\n    check_dict_case({\"STATE\":\"NC\", \"ZIP\":\"12345\" }) should return True.\n    \"\"\"\n    if not d:\n        return False\n\n    has_lower_keys = False\n    has_upper_keys = False\n\n    for key in d.keys():\n        if not isinstance(key, str):\n            return False  # Non-string key found\n\n        if key.islower():\n            has_lower_keys = True\n        elif key.isupper():\n            has_upper_keys = True\n        else:\n            # String key is neither all lower nor all upper (e.g., \"Name\", \"Key123\")\n            return False\n\n    # After checking all keys, determine consistency\n    # True if all were lower AND no upper keys were found.\n    # OR if all were upper AND no lower keys were found.\n    # False if there was a mix (both has_lower_keys and has_upper_keys are True)\n    # or if no string keys were found (which isn't possible if d is not empty and no False was returned earlier).\n    return (has_lower_keys and not has_upper_keys) or (not has_lower_keys and has_upper_keys)"}
{"task_id": "HumanEval/96", "solution": "import math\ndef count_up_to(n: int) -> list[int]:\n    \"\"\"\n    Finds all prime numbers less than a non-negative integer n.\n\n    Args:\n        n (int): The upper exclusive bound. Must be a non-negative integer.\n\n    Returns:\n        list[int]: A list of prime numbers less than n, sorted in ascending order.\n                   Returns an empty list if n is 0 or 1.\n    \"\"\"\n    # Handle edge cases for n <= 2\n    if n <= 2:\n        return []\n    \n    # Initialize a boolean array 'is_prime' where is_prime[i] will be true\n    # if i is prime, false otherwise.\n    # We need to check up to n-1, so array size is n.\n    is_prime = [True] * n\n    \n    # 0 and 1 are not prime numbers\n    is_prime[0] = False\n    is_prime[1] = False\n    \n    # Start checking from p = 2\n    # We only need to iterate up to sqrt(n) for marking multiples\n    for p in range(2, int(math.sqrt(n)) + 1):\n        # If is_prime[p] is still True, then it is a prime number\n        if is_prime[p]:\n            # Mark all multiples of p (starting from p*p) as not prime\n            # Numbers smaller than p*p that are multiples of p would have\n            # already been marked by smaller prime factors.\n            for multiple in range(p * p, n, p):\n                is_prime[multiple] = False\n                \n    # Collect all prime numbers\n    primes = []\n    for i in range(2, n):\n        if is_prime[i]:\n            primes.append(i)\n            \n    return primes"}
{"task_id": "HumanEval/96", "solution": "def count_up_to(n: int) -> list[int]:\n    \"\"\"\n    Identifies all prime numbers strictly less than a given non-negative integer n\n    using the Sieve of Eratosthenes algorithm.\n\n    Args:\n        n: A non-negative integer representing the upper bound (exclusive) for prime numbers.\n\n    Returns:\n        A list of prime numbers less than n, in ascending order.\n        Returns an empty list if n is less than or equal to 2.\n    \"\"\"\n    if n <= 2:\n        return []\n\n    # Initialize a boolean list \"is_prime[0..n-1]\" and assume all numbers are prime.\n    # We will mark multiples of primes as non-prime.\n    is_prime = [True] * n\n\n    # 0 and 1 are not prime numbers\n    is_prime[0] = False\n    is_prime[1] = False\n\n    # Start checking from p = 2\n    # We only need to iterate up to sqrt(n) because if n has a factor greater than sqrt(n),\n    # it must also have a factor smaller than sqrt(n).\n    for p in range(2, int(n**0.5) + 1):\n        # If is_prime[p] is still True, then it is a prime number\n        if is_prime[p]:\n            # Mark all multiples of p (starting from p*p) as not prime.\n            # Multiples less than p*p would have already been marked by smaller primes.\n            for multiple in range(p * p, n, p):\n                is_prime[multiple] = False\n\n    # Collect all numbers that are marked as prime\n    primes = [i for i, prime_status in enumerate(is_prime) if prime_status]\n\n    return primes"}
{"task_id": "HumanEval/97", "solution": "def multiply(a: int, b: int) -> int:\n    \"\"\"\n    Calculates the product of the unit digits of two integers.\n\n    Args:\n        a: The first integer.\n        b: The second integer.\n\n    Returns:\n        The product of their unit digits.\n    \"\"\"\n    # Extract the unit digit of 'a'.\n    # abs(a) is used to ensure the unit digit is always positive,\n    # regardless of whether 'a' is positive or negative, as per requirements FUN-006 and FUN-007.\n    unit_digit_a = abs(a) % 10\n\n    # Extract the unit digit of 'b' using the same logic.\n    unit_digit_b = abs(b) % 10\n\n    # Calculate the product of the extracted unit digits.\n    product = unit_digit_a * unit_digit_b\n\n    return product"}
{"task_id": "HumanEval/97", "solution": "class MathUtils:\n    @staticmethod\n    def _get_unit_digit(n: int) -> int:\n        \"\"\"\n        Extracts the unit digit of an integer, handling negative numbers.\n        Example: _get_unit_digit(148) -> 8\n                 _get_unit_digit(-15) -> 5\n        \"\"\"\n        return abs(n) % 10\n\n    @staticmethod\n    def multiply(a: int, b: int) -> int:\n        \"\"\"\n        Completes the function that takes two integers and returns\n        the product of their unit digits.\n        Assumes the input is always valid.\n        Examples:\n        multiply(148, 412) should return 16.\n        multiply(19, 28) should return 72.\n        multiply(2020, 1851) should return 0.\n        multiply(14,-15) should return 20.\n        \"\"\"\n        unit_digit_a = MathUtils._get_unit_digit(a)\n        unit_digit_b = MathUtils._get_unit_digit(b)\n        return unit_digit_a * unit_digit_b"}
{"task_id": "HumanEval/98", "solution": "def count_upper(s: str) -> int:\n    \"\"\"\n    Counts the number of uppercase vowels ('A', 'E', 'I', 'O', 'U') that appear\n    at even 0-based indices in the input string.\n\n    Args:\n        s: The input string to be analyzed.\n\n    Returns:\n        An integer representing the count of uppercase vowels at even indices.\n    \"\"\"\n    count = 0\n    uppercase_vowels = {'A', 'E', 'I', 'O', 'U'}\n\n    for index, char in enumerate(s):\n        # Check if the current index is even\n        if index % 2 == 0:\n            # Check if the character is one of the uppercase vowels\n            if char in uppercase_vowels:\n                count += 1\n    return count"}
{"task_id": "HumanEval/98", "solution": "def count_upper(s: str) -> int:\n    \"\"\"\n    Counts the number of uppercase vowels (A, E, I, O, U) that are located\n    at even indices within the provided string.\n\n    Args:\n        s: The input string to be analyzed.\n\n    Returns:\n        An integer representing the count of uppercase vowels found at even indices.\n    \"\"\"\n    UPPERCASE_VOWELS = {'A', 'E', 'I', 'O', 'U'}\n    count = 0\n    for index, char in enumerate(s):\n        if index % 2 == 0:  # Check if the current index is even\n            if char in UPPERCASE_VOWELS:  # Check if the character is an uppercase vowel\n                count += 1\n    return count"}
{"task_id": "HumanEval/99", "solution": "import math\ndef closest_integer(value: str) -> int:\n    \"\"\"\n    Returns the closest integer to the given string representation of a number.\n    If the number is equidistant from two integers (X.5), it rounds away from zero.\n\n    Args:\n        value: A string representation of a numerical value (e.g., \"10\", \"15.3\", \"-14.5\").\n\n    Returns:\n        The closest integer as per the \"round away from zero\" rule.\n\n    Raises:\n        ValueError: If the input 'value' string cannot be converted to a float.\n\n    Examples:\n        closest_integer('10')     -> 10\n        closest_integer('15.3')   -> 15  (fractional part < 0.5, rounds down)\n        closest_integer('14.5')   -> 15  (fractional part = 0.5, rounds up, away from zero)\n        closest_integer('15.7')   -> 16  (fractional part > 0.5, rounds up)\n        closest_integer('-10')    -> -10\n        closest_integer('-15.3')  -> -15 (fractional part < 0.5, rounds towards zero)\n        closest_integer('-14.5')  -> -15 (fractional part = 0.5, rounds down, away from zero)\n        closest_integer('-15.7')  -> -16 (fractional part > 0.5, rounds away from zero)\n    \"\"\"\n    try:\n        f_value = float(value)\n    except ValueError as e:\n        # FR-6: Propagate ValueError if conversion fails\n        raise ValueError(f\"Invalid input: '{value}' cannot be converted to a float.\") from e\n\n    if f_value >= 0:\n        # FR-3: Positive Number Rounding\n        # For non-negative numbers, add 0.5 and truncate.\n        # This correctly handles X.5 by rounding up (e.g., 14.5 -> 15.0 -> 15),\n        # and other values as expected (e.g., 15.3 -> 15.8 -> 15, 15.7 -> 16.2 -> 16).\n        return math.trunc(f_value + 0.5)\n    else:\n        # FR-4: Negative Number Rounding\n        # For negative numbers, subtract 0.5 and truncate.\n        # This correctly handles X.5 by rounding down (e.g., -14.5 -> -15.0 -> -15),\n        # and other values as expected (e.g., -15.3 -> -15.8 -> -15, -15.7 -> -16.2 -> -16).\n        return math.trunc(f_value - 0.5)"}
