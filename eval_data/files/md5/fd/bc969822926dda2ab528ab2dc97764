{"task_id": "HumanEval/47", "solution": "from typing import Union\ndef median(l: list) -> Union[int, float]:\n    \"\"\"\n    Calculates the median of a list of numbers.\n\n    Args:\n        l (list): A list of numerical elements (int or float).\n\n    Returns:\n        Union[int, float]: The median value of the list.\n                          Returns an int if the median is an integer,\n                          otherwise returns a float.\n    \"\"\"\n    if not l:\n        raise ValueError(\"Input list cannot be empty\")\n\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    if n % 2 == 1:\n        # Odd number of elements\n        # The middle element is at index n // 2\n        return sorted_l[n // 2]\n    else:\n        # Even number of elements\n        # The two middle elements are at n // 2 - 1 and n // 2\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        return (mid1 + mid2) / 2.0"}
{"task_id": "HumanEval/48", "solution": "def is_palindrome(text: str) -> bool:\n    \"\"\"\n    Checks if the given string is a palindrome.\n\n    A palindrome is a sequence of characters that reads the same forwards and backward.\n    The check is case-sensitive and considers all characters (including spaces, punctuation,\n    and special characters). An empty string is considered a palindrome.\n\n    :param text: The input string to check.\n    :return: True if the string is a palindrome, False otherwise.\n    \"\"\"\n    # FUNC-004: Handle empty string case\n    if not text:\n        return True\n\n    left = 0\n    right = len(text) - 1\n\n    # PERF-001: Time complexity O(N)\n    # PERF-002: Memory usage O(1)\n    while left < right:\n        # FUNC-005: Case-sensitive comparison\n        # FUNC-006: All characters considered\n        if text[left] != text[right]:\n            # FUNC-003: Not a palindrome\n            return False\n        left += 1\n        right -= 1\n\n    # FUNC-002: Is a palindrome\n    return True"}
{"task_id": "HumanEval/48", "solution": "def is_palindrome(text: str) -> bool:\n    \"\"\"\n    Checks if a given string is a palindrome, ignoring case, spaces, and punctuation.\n\n    A palindrome is a word, phrase, or sequence that reads the same backward as forward.\n\n    Args:\n        text: The string to be checked.\n\n    Returns:\n        True if the string is a palindrome, False otherwise.\n    \"\"\"\n    # FR-2: Convert to a consistent case (lowercase)\n    # FR-3: Filter out non-alphanumeric characters\n    # Using a generator expression and \"\".join() for efficiency and readability\n    cleaned_text = \"\".join(char for char in text.lower() if char.isalnum())\n\n    # FR-4: Determine if the filtered and normalized string reads the same forwards and backward.\n    # FR-5: An empty string (after filtering) is considered a palindrome.\n    # This comparison naturally handles empty strings correctly: \"\" == \"\"[::-1] is True.\n    # FR-6: Return True if a palindrome, False otherwise.\n    return cleaned_text == cleaned_text[::-1]"}
