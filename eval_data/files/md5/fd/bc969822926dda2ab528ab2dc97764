{"task_id": "HumanEval/64", "solution": "def vowels_count(s: str) -> int:\n    \"\"\"\n    Counts the number of vowels in a given string.\n\n    Vowels are 'a', 'e', 'i', 'o', 'u'. 'y' is considered a vowel only\n    when it is the last character of the given word. The counting is case-insensitive.\n\n    Args:\n        s (str): The input string (word).\n\n    Returns:\n        int: The total count of vowels in the string.\n    \"\"\"\n    vowel_count = 0\n    s_lower = s.lower()\n    standard_vowels = {'a', 'e', 'i', 'o', 'u'}\n\n    if not s_lower:\n        return 0\n\n    last_index = len(s_lower) - 1\n\n    for i, char in enumerate(s_lower):\n        if char in standard_vowels:\n            vowel_count += 1\n        elif char == 'y' and i == last_index:\n            vowel_count += 1\n\n    return vowel_count"}
{"task_id": "HumanEval/65", "solution": "class CircularShiftService:\n    def shift_digits(self, x: int, shift: int) -> str:\n        s = str(x)\n        n = len(s)\n\n        if shift > n:\n            # If shift > number of digits, return digits reversed.\n            return s[::-1]\n        else:\n            # Perform circular right shift\n            # The part that moves to the front\n            part_to_move = s[n - shift:]\n            # The remaining part\n            remaining_part = s[:n - shift]\n            return part_to_move + remaining_part\ndef circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    >>> circular_shift(12, 1)\n    \"21\"\n    >>> circular_shift(12, 2)\n    \"12\"\n    \"\"\"\n    service = CircularShiftService()\n    return service.shift_digits(x, shift)"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x: int, shift: int) -> str:\n    \"\"\"\n    Performs a circular right shift on the digits of an integer or reverses them.\n\n    Args:\n        x: The integer whose digits are to be manipulated.\n        shift: The number of positions to shift digits to the right.\n               If `shift` is greater than the number of digits in `x`,\n               the digits are reversed.\n\n    Returns:\n        A string representing the circularly shifted or reversed digits of `x`.\n    \"\"\"\n    s = str(x)\n    n = len(s)\n\n    if shift > n:\n        # REQ-FUNC-003: Handle Shift Greater Than Digits\n        return s[::-1]\n    else:\n        # REQ-FUNC-004: Perform Circular Right Shift\n        # REQ-QOS-002: Handles shift=0 and shift=n cases implicitly\n        effective_shift = shift % n\n        if effective_shift == 0:\n            return s\n        return s[n - effective_shift:] + s[:n - effective_shift]"}
{"task_id": "HumanEval/66", "solution": "def calculateUppercaseAsciiSum(inputString: str) -> int:\n    \"\"\"\n    Calculates the sum of ASCII values exclusively for uppercase English alphabet characters\n    (A-Z) within a given input string.\n\n    Args:\n        inputString: The string to be processed.\n\n    Returns:\n        The total sum of ASCII values of uppercase characters.\n        Returns 0 if no uppercase characters are found or if the input string is empty.\n    \"\"\"\n    total_sum = 0\n    for char in inputString:\n        # FUN-004: Determine if it is an uppercase English alphabet character ('A' through 'Z').\n        # Using explicit range check for strict adherence to \"A-Z\" ASCII characters.\n        if 'A' <= char <= 'Z':\n            # FUN-005: Add its ASCII (ordinal) value to the sum accumulator.\n            total_sum += ord(char)\n    # FUN-006: Return the final value of the sum accumulator.\n    # FUN-007: If inputString is empty, total_sum remains 0, correctly handled.\n    # FUN-008: If no uppercase characters, total_sum remains 0, correctly handled.\n    return total_sum"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s: str) -> int:\n    \"\"\"\n    Calculates the sum of ASCII values of only the uppercase English alphabet characters in a string.\n\n    Args:\n        s (str): The input string.\n\n    Returns:\n        int: The sum of ASCII values of uppercase characters.\n             Returns 0 if the string is empty or contains no uppercase characters.\n\n    Examples:\n        digitSum(\"\") => 0\n        digitSum(\"abAB\") => 131 (A=65, B=66)\n        digitSum(\"abcCd\") => 67 (C=67)\n        digitSum(\"helloE\") => 69 (E=69)\n        digitSum(\"woArBld\") => 131 (A=65, B=66)\n        digitSum(\"aAaaaXa\") => 153 (A=65, X=88)\n    \"\"\"\n    total_sum = 0\n    for char in s:\n        if 'A' <= char <= 'Z':  # Explicit check for English uppercase letters (A-Z)\n            total_sum += ord(char)\n    return total_sum"}
{"task_id": "HumanEval/67", "solution": "import re\ndef fruit_distribution(s: str, n: int) -> int:\n    \"\"\"\n    Calculates the number of mango fruits in a basket.\n\n    This function extracts the counts of apples and oranges from an input string,\n    sums them, and then subtracts this sum from the total number of fruits\n    to determine the number of mangoes.\n\n    Args:\n        s (str): A string representing the number of apples and oranges,\n                 formatted as \"X apples and Y oranges\".\n                 Example: \"5 apples and 6 oranges\"\n        n (int): The total number of fruits in the basket.\n\n    Returns:\n        int: The number of mango fruits.\n    \"\"\"\n    # Use regular expressions to find all numbers in the string.\n    # The problem statement's format \"X apples and Y oranges\" implies\n    # the first number is apples and the second is oranges.\n    fruit_counts_str = re.findall(r'\\d+', s)\n\n    # Convert extracted strings to integers\n    # Based on constraints, 's' will always contain two non-negative integers\n    # representing apple and orange counts in the specified order.\n    apple_count = int(fruit_counts_str[0])\n    orange_count = int(fruit_counts_str[1])\n\n    total_known_fruits = apple_count + orange_count\n    mango_count = n - total_known_fruits\n\n    return mango_count"}
{"task_id": "HumanEval/67", "solution": "import re\nclass FruitStringParser:\n    \"\"\"\n    Parses a string to extract the number of apples and oranges.\n    Assumes the format \"X apples and Y oranges\".\n    \"\"\"\n    def parse(self, fruit_string: str) -> dict[str, int]:\n        \"\"\"\n        Extracts apple and orange counts from the input string.\n        (FR1: Parse Apple Count, FR2: Parse Orange Count)\n\n        Args:\n            fruit_string: The input string describing apple and orange counts.\n                          Expected format: \"X apples and Y oranges\".\n\n        Returns:\n            A dictionary containing \"apples\" and \"oranges\" counts as integers.\n\n        Raises:\n            ValueError: If the fruit_string does not conform to the expected format.\n                        (Based on SRS 2.5, input is assumed to be valid, but this\n                        provides a safeguard as per QOS2 for potential future enhancements).\n        \"\"\"\n        match = re.search(r\"(\\d+)\\s*apples\\s*and\\s*(\\d+)\\s*oranges\", fruit_string)\n        if not match:\n            raise ValueError(\n                \"Invalid fruit string format. Expected 'X apples and Y oranges'.\"\n                f\" Received: '{fruit_string}'\"\n            )\n        \n        apples = int(match.group(1))\n        oranges = int(match.group(2))\n        return {\"apples\": apples, \"oranges\": oranges}\nclass FruitDistributionService:\n    \"\"\"\n    Calculates the number of mango fruits based on apple and orange counts\n    extracted from a string and a total fruit count.\n    (DIM2: Modularity - Separates calculation logic from parsing)\n    \"\"\"\n    def __init__(self, parser: FruitStringParser):\n        \"\"\"\n        Initializes the FruitDistributionService with a FruitStringParser instance.\n\n        Args:\n            parser: An instance of FruitStringParser to delegate string parsing.\n        \"\"\"\n        self._parser = parser\n\n    def calculate_mangoes(self, s: str, total_fruits: int) -> int:\n        \"\"\"\n        Calculates the number of mango fruits.\n        (FR3: Calculate Mangoes, FR4: Return Mango Count)\n\n        Args:\n            s: A string containing the count of apples and oranges (e.g., \"5 apples and 6 oranges\").\n            total_fruits: An integer representing the total number of fruits (n).\n\n        Returns:\n            An integer representing the number of mangoes.\n            The result is guaranteed to be non-negative based on problem constraints (SRS 2.3).\n        \"\"\"\n        fruit_counts = self._parser.parse(s)\n        apples = fruit_counts[\"apples\"]\n        oranges = fruit_counts[\"oranges\"]\n        \n        # Calculate mangoes according to FR3\n        mangoes = total_fruits - (apples + oranges)\n        \n        # Return non-negative mango count as per FR4 and SRS 2.3 constraints\n        # max(0, mangoes) ensures non-negative, though constraints imply it won't be negative.\n        return max(0, mangoes)\ndef fruit_distribution(s: str, n: int) -> int:\n    \"\"\"\n    Calculates the number of mango fruits in a basket.\n\n    This function parses a string detailing apple and orange counts, then subtracts their sum\n    from the total number of fruits to determine the mango count.\n\n    Args:\n        s: A string detailing apple and orange counts, e.g., \"5 apples and 6 oranges\".\n           Must conform to the format \"X apples and Y oranges\" where X and Y are non-negative integers.\n        n: An integer representing the total number of fruits.\n           Must be a non-negative integer, and greater than or equal to the sum of apples and oranges.\n\n    Returns:\n        An integer representing the number of mangoes.\n        The result is guaranteed to be a non-negative integer.\n    \"\"\"\n    parser = FruitStringParser()\n    service = FruitDistributionService(parser)\n    return service.calculate_mangoes(s, n)"}
{"task_id": "HumanEval/68", "solution": "import math\nfrom typing import List\ndef pluck(arr: List[int]) -> List[int]:\n    \"\"\"\n    Extracts a specific node from a given array of non-negative integers.\n\n    The criteria for plucking a node are:\n    1. It must have the smallest even value.\n    2. In case of multiple nodes sharing the smallest even value, the one\n       with the smallest index is chosen.\n\n    Args:\n        arr: A Python list of non-negative integers.\n             Constraints: 0 <= node.value, 1 <= len(arr) <= 10000.\n\n    Returns:\n        A Python list:\n        - [smallest_even_value, its_index] if an even value is found.\n        - [] if no even values are found or the input array is empty.\n    \"\"\"\n    if not arr:\n        return []\n\n    smallest_even_value = math.inf\n    smallest_even_index = -1\n\n    for i, node in enumerate(arr):\n        # As per SRS, input array elements are non-negative.\n        # Check if the node is even.\n        if node % 2 == 0:\n            # If this even node is smaller than the current smallest_even_value,\n            # update both the value and its index.\n            if node < smallest_even_value:\n                smallest_even_value = node\n                smallest_even_index = i\n            # If node == smallest_even_value, we do not update. This implicitly\n            # adheres to the \"smallest index in case of ties\" rule, as the\n            # first encountered smallest even value (which would have the\n            # smallest index) is retained.\n\n    # After iterating, check if any even number was found.\n    if smallest_even_index == -1:\n        return []\n    else:\n        return [smallest_even_value, smallest_even_index]"}
{"task_id": "HumanEval/68", "solution": "import math\ndef pluck(arr: list[int]) -> list[int]:\n    \"\"\"\n    Given an array representing a branch of a tree that has non-negative integer nodes\n    your task is to pluck one of the nodes and return it.\n    The plucked node should be the node with the smallest even value.\n    If multiple nodes with the same smallest even value are found return the node that has smallest index.\n\n    The plucked node should be returned in a list, [ smallest_value, its index ],\n    If there are no even values or the given array is empty, return [].\n\n    Args:\n        arr (list[int]): A list of non-negative integers.\n\n    Returns:\n        list[int]: A list containing [smallest_even_value, its_index],\n                    or an empty list if no even values or an empty array.\n    \"\"\"\n    if not arr:\n        return []\n\n    smallest_even_value = math.inf  # Initialize with a value larger than any possible node\n    smallest_even_index = -1\n\n    for index, node in enumerate(arr):\n        if node % 2 == 0:  # Check if the node is even\n            if node < smallest_even_value:\n                smallest_even_value = node\n                smallest_even_index = index\n            # If node == smallest_even_value, we don't update,\n            # ensuring the smallest index is kept due to enumerate's order (F.6).\n\n    if smallest_even_index == -1:\n        return []  # No even numbers found (F.9)\n    else:\n        return [smallest_even_value, smallest_even_index] # (F.8)"}
{"task_id": "HumanEval/69", "solution": "import collections\ndef search(lst: list[int]) -> int:\n    \"\"\"\n    Finds the greatest positive integer 'x' in a list such that its frequency\n    in the list is greater than or equal to 'x'.\n\n    Args:\n        lst: A non-empty list of positive integers.\n\n    Returns:\n        The greatest integer satisfying the condition, or -1 if no such integer exists.\n\n    Examples:\n        >>> search([4, 1, 2, 2, 3, 1])\n        2\n        >>> search([1, 2, 2, 3, 3, 3, 4, 4, 4])\n        3\n        >>> search([5, 5, 4, 4, 4])\n        -1\n        >>> search([1, 1, 1, 1, 1])\n        1\n        >>> search([3, 3, 3])\n        3\n        >>> search([1])\n        1\n        >>> search([2, 2, 1])\n        2\n        >>> search([10, 10, 10, 10, 10, 10])\n        -1\n    \"\"\"\n    # 1. Count Frequencies\n    # Use collections.Counter for efficient frequency counting.\n    # This results in a dictionary where keys are integers and values are their frequencies.\n    frequency_map = collections.Counter(lst)\n\n    # 2. Initialize a variable to store the greatest qualifying integer found.\n    # Initialize to -1, which is the default return value if no such integer exists.\n    max_qualifying_value = -1\n\n    # 3. Iterate and Filter\n    # Iterate through the unique numbers (keys) and their frequencies (values)\n    # in the frequency map.\n    for value, frequency in frequency_map.items():\n        # The problem statement specifies \"positive integers\" for the input list,\n        # so 'value' will always be > 0 here.\n        # Check if the frequency of the current 'value' is greater than or equal\n        # to the 'value' itself.\n        if frequency >= value:\n            # 4. Find Maximum\n            # If the condition is met, update 'max_qualifying_value'\n            # if the current 'value' is greater than the previously found maximum.\n            if value > max_qualifying_value:\n                max_qualifying_value = value\n    \n    # 5. Return Result\n    return max_qualifying_value"}
{"task_id": "HumanEval/69", "solution": "import collections\nclass IntegerFrequencySearcher:\n    \"\"\"\n    The Greatest Integer Frequency Search (GIFS) system.\n    Processes a list of positive integers to identify and return the largest integer\n    whose frequency of occurrence is greater than or equal to its value.\n    Returns -1 if no such integer exists.\n    \"\"\"\n\n    def search(self, numbers: list[int]) -> int:\n        \"\"\"\n        Orchestrates the search for the greatest integer satisfying the frequency condition.\n\n        Args:\n            numbers: A list of positive integers.\n\n        Returns:\n            The largest integer 'n' whose frequency 'f' in the list is f >= n.\n            Returns -1 if no such integer exists.\n\n        Raises:\n            ValueError: If the input list is empty or contains non-positive integers.\n        \"\"\"\n        self._validate_input(numbers)\n        freq_map = self._count_frequencies(numbers)\n        return self._find_greatest_matching_integer(freq_map)\n\n    def _validate_input(self, numbers: list[int]) -> None:\n        \"\"\"\n        Validates the input list to ensure it's non-empty and contains only positive integers.\n\n        Args:\n            numbers: The list of integers to validate.\n\n        Raises:\n            ValueError: If the list is empty or contains any non-positive or non-integer elements.\n        \"\"\"\n        if not numbers:\n            raise ValueError(\"Input list cannot be empty.\")\n        for num in numbers:\n            if not isinstance(num, int) or num <= 0:\n                raise ValueError(\"All elements in the list must be positive integers.\")\n\n    def _count_frequencies(self, numbers: list[int]) -> dict[int, int]:\n        \"\"\"\n        Counts the frequency of each unique integer in the input list.\n\n        Args:\n            numbers: The list of integers.\n\n        Returns:\n            A dictionary where keys are unique integers and values are their frequencies.\n        \"\"\"\n        freq_map = {}\n        for num in numbers:\n            freq_map[num] = freq_map.get(num, 0) + 1\n        return freq_map\n\n    def _find_greatest_matching_integer(self, freq_map: dict[int, int]) -> int:\n        \"\"\"\n        Finds the greatest integer 'n' in the frequency map whose frequency 'f'\n        satisfies the condition f >= n.\n\n        Args:\n            freq_map: A dictionary of integer frequencies.\n\n        Returns:\n            The largest integer matching the condition, or -1 if none is found.\n        \"\"\"\n        # Get unique numbers and sort them in descending order to easily find the \"greatest\"\n        unique_numbers_desc = sorted(freq_map.keys(), reverse=True)\n\n        for n in unique_numbers_desc:\n            f = freq_map[n]\n            if f >= n:\n                return n  # Found the greatest matching integer due to descending order\n\n        return -1  # No integer found that satisfies the condition\ndef search(lst):\n    '''\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than \n    zero, and has a frequency greater than or equal to the value of the integer itself. \n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    Examples:\n        search([4, 1, 2, 2, 3, 1]) == 2\n        search([1, 2, 2, 3, 3, 3, 4, 4, 4]) == 3\n        search([5, 5, 4, 4, 4]) == -1\n    '''\n    processor = IntegerFrequencySearcher()\n    return processor.search(lst)"}
