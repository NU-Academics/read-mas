{"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_to_md5(text: str) -> str | None:\n    \"\"\"\n    Calculates the MD5 hash equivalent of a given string.\n\n    If 'text' is an empty string, returns None.\n\n    Args:\n        text (str): The input string to hash.\n\n    Returns:\n        str | None: The 32-character hexadecimal MD5 hash string,\n                    or None if the input text is empty.\n\n    Examples:\n        >>> string_to_md5('Hello world') == '3e25960a79dbc69b674cd4ec67a72c62'\n        >>> string_to_md5('') is None\n        True\n        >>> string_to_md5('Python') == '18c54c30e927c3761376046e7f864551'\n    \"\"\"\n    if not text:  # Handles empty string\n        return None\n\n    # Encode the string to bytes (UTF-8 is a common choice)\n    text_bytes = text.encode('utf-8')\n\n    # Create an MD5 hash object\n    md5_hash_object = hashlib.md5()\n\n    # Update the hash object with the bytes\n    md5_hash_object.update(text_bytes)\n\n    # Get the hexadecimal representation of the hash\n    md5_hex_string = md5_hash_object.hexdigest()\n\n    return md5_hex_string"}
{"task_id": "HumanEval/163", "solution": "from typing import List\ndef generate_integers(a: int, b: int) -> List[int]:\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n\n    For example:\n    generate_integers(2, 8) => [2, 4, 6, 8]\n    generate_integers(8, 2) => [2, 4, 6, 8]\n    generate_integers(10, 14) => []\n    generate_integers(1, 3) => [2]\n    generate_integers(5, 7) => [6]\n    generate_integers(1, 1) => []\n    \"\"\"\n    # 1. Determine Range Bounds to handle a > b or a < b\n    min_val = min(a, b)\n    max_val = max(a, b)\n\n    # 2. Define Candidate Even Digits.\n    #    As per SRS/Design, inputs 'a' and 'b' are positive, so 0 is excluded.\n    candidate_even_digits = [2, 4, 6, 8]\n\n    # 3. Filter Digits that fall within the determined range [min_val, max_val]\n    result = []\n    for digit in candidate_even_digits:\n        if min_val <= digit <= max_val:\n            result.append(digit)\n\n    # 4. Return the collected digits.\n    #    Since candidate_even_digits is already sorted, result will also be sorted.\n    return result"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a: int, b: int) -> list[int]:\n    \"\"\"\n    Given two non-negative integers a and b, return a sorted list of even\n    single-digit numbers found inclusively between a and b.\n\n    A \"single-digit number\" is defined as an integer from 0 to 9.\n    Even numbers are those divisible by 2.\n\n    The function determines the inclusive range [min(a, b), max(a, b)]\n    and filters for numbers within this range that are both single-digit\n    and even.\n\n    Args:\n        a (int): A non-negative integer.\n        b (int): A non-negative integer.\n\n    Returns:\n        list[int]: A list of even single-digit numbers found in the\n                   specified range, in ascending order. Returns an\n                   empty list if no such numbers are found.\n\n    Raises:\n        ValueError: If 'a' or 'b' are not non-negative integers.\n\n    Examples:\n        generate_integers(2, 8)    => [2, 4, 6, 8]\n        generate_integers(8, 2)    => [2, 4, 6, 8]\n        generate_integers(10, 14)  => []\n        generate_integers(1, 9)    => [2, 4, 6, 8]\n        generate_integers(0, 0)    => [0]\n        generate_integers(15, 20)  => []\n    \"\"\"\n    # FR.1: Input Handling & Product Constraints (2.3)\n    # The SRS specifies \"positive integers\" for a and b. However, the example\n    # `generate_integers(0, 0) => [0]` implies that 0 should be considered valid.\n    # Therefore, we interpret \"positive\" as \"non-negative\" in this context.\n    if not (isinstance(a, int) and isinstance(b, int) and a >= 0 and b >= 0):\n        raise ValueError(\"Inputs 'a' and 'b' must be non-negative integers.\")\n\n    # FR.2: Range Determination\n    min_val = min(a, b)\n    max_val = max(a, b)\n\n    even_digits_found = []\n    # Iterate through the numbers within the determined inclusive range\n    for num in range(min_val, max_val + 1):\n        # FR.3: Digit Identification (0-9)\n        # FR.4: Even Number Filtering\n        if 0 <= num <= 9 and num % 2 == 0:\n            even_digits_found.append(num)\n\n    # FR.5: Output Ordering\n    # The numbers are added in ascending order due to the range iteration,\n    # so the list is naturally sorted.\n    return even_digits_found"}
