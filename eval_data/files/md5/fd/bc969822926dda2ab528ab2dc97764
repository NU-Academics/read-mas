{"task_id": "HumanEval/133", "solution": "import math\ndef sum_squares(lst: list[float | int]) -> float | int:\n    \"\"\"\n    Calculates the sum of the squares of ceiling-rounded numbers in a list.\n\n    Args:\n        lst: A list of numbers (integers or floats).\n\n    Returns:\n        The sum of the squares of the ceiling-rounded numbers.\n        Returns 0 for an empty list.\n\n    Examples:\n        >>> sum_squares([1.1, 2.5, 3.9])\n        29.0\n        # ceil(1.1) = 2, 2^2 = 4\n        # ceil(2.5) = 3, 3^2 = 9\n        # ceil(3.9) = 4, 4^2 = 16\n        # Sum = 4 + 9 + 16 = 29\n\n        >>> sum_squares([-1.1, -2.5, -3.9])\n        14.0\n        # ceil(-1.1) = -1, (-1)^2 = 1\n        # ceil(-2.5) = -2, (-2)^2 = 4\n        # ceil(-3.9) = -3, (-3)^2 = 9\n        # Sum = 1 + 4 + 9 = 14\n\n        >>> sum_squares([0])\n        0.0\n\n        >>> sum_squares([])\n        0\n\n        >>> sum_squares([2, 4, 6])\n        56.0\n        # ceil(2) = 2, 2^2 = 4\n        # ceil(4) = 4, 4^2 = 16\n        # ceil(6) = 6, 6^2 = 36\n        # Sum = 4 + 16 + 36 = 56\n    \"\"\"\n    total_sum = 0\n    for x in lst:\n        rounded_x = math.ceil(x)\n        total_sum += rounded_x * rounded_x\n    \n    # If the list contains only integers, the sum might naturally be an integer.\n    # However, math.ceil returns a float, so the sum will likely be a float.\n    # The return type annotation reflects this flexibility.\n    \n    return total_sum"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt: str) -> bool:\n    \"\"\"\n    Checks if the last character of a given string is an alphabetical character\n    and is not a part of a word.\n    Note: \"word\" is a group of characters separated by space.\n\n    Args:\n        txt (str): The input string.\n\n    Returns:\n        bool: True if the last character is an alphabetical character and is not\n              part of a word, False otherwise.\n    \"\"\"\n    # FR-1: Return False if the input string txt is empty.\n    if not txt:\n        return False\n\n    # FR-2: Identify the last character of txt.\n    last_char = txt[-1]\n\n    # FR-3: Check if the identified last character is an alphabetical character.\n    if not last_char.isalpha():\n        return False\n\n    # At this point, txt is not empty and last_char is alphabetical.\n    # Now, we need to check if it's \"not part of a word\".\n    # This means either the string has only one character, or the character\n    # immediately preceding the last character is a space.\n\n    # FR-4: Check if the string has only one character.\n    if len(txt) == 1:\n        return True\n\n    # If the string has more than one character (len(txt) > 1),\n    # FR-5: Check if the character immediately preceding the last character is a space (' ').\n    preceding_char = txt[-2]\n    if preceding_char == ' ':\n        return True\n\n    # FR-7: If none of the conditions for returning True (FR-6) are met, return False.\n    # This case covers scenarios where the last character is alphabetical but\n    # is preceded by a non-space, non-empty character, meaning it's part of a word.\n    return False"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt: str) -> bool:\n    \"\"\"\n    Checks if the last character of a given string is an alphabetical character\n    and is not a part of a word (i.e., it's isolated by a space or is the only character).\n\n    Args:\n        txt (str): The input string.\n\n    Returns:\n        bool: True if the last character is an isolated alphabetical character, False otherwise.\n    \"\"\"\n    # FR1: The system shall return False if the input string txt is empty.\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    # FR4: The system shall determine if the actual last character is an alphabetical character.\n    # If not, the system shall return False.\n    if not last_char.isalpha():\n        # This implicitly handles FR2 (string contains only whitespace) and\n        # cases like \"apple pi e \" where the last char is a space.\n        return False\n\n    # At this point, we know last_char is an alphabetical letter.\n    # Now, check FR5: if it is \"not a part of a word\".\n    # This condition is met if:\n    # 1. The string has a length of 1 (and the character itself is alphabetical).\n    if len(txt) == 1:\n        return True\n\n    # 2. The character immediately preceding the last alphabetical character is a space.\n    char_before_last = txt[-2]\n    if char_before_last == ' ':\n        return True\n    else:\n        # The last character is a letter, but it's preceded by a non-space character,\n        # meaning it's part of a word.\n        return False"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr: list[int]) -> int:\n    \"\"\"\n    Finds the largest index i such that arr[i] is strictly less than arr[i-1].\n\n    Args:\n        arr: A list of integers. Assumed not to contain duplicate values.\n\n    Returns:\n        The largest index i where arr[i] < arr[i-1], or -1 if no such index exists.\n    \"\"\"\n    # REQ-FUNC-3: If the length of arr is less than 2, return -1.\n    if len(arr) < 2:\n        return -1\n\n    # REQ-FUNC-4: Iterate through the input list arr from the second-to-last\n    # element down to the second element (i.e., for indices i from len(arr) - 1 down to 1).\n    # REQ-FUNC-5: During iteration, for each index i, compare arr[i] with arr[i-1].\n    for i in range(len(arr) - 1, 0, -1):\n        # REQ-FUNC-6: If the condition arr[i] < arr[i-1] is met,\n        # immediately return the current index i.\n        if arr[i] < arr[i-1]:\n            return i\n\n    # REQ-FUNC-7: If the iteration completes without finding any index i that\n    # satisfies the condition arr[i] < arr[i-1], the system shall return -1.\n    return -1"}
{"task_id": "HumanEval/135", "solution": "class CanArrangeService:\n    \"\"\"\n    A service class for analyzing arrays based on specific criteria.\n    \"\"\"\n\n    @staticmethod\n    def can_arrange(arr: list[int]) -> int:\n        \"\"\"\n        Returns the largest index of an element which is not greater than or\n        equal to the element immediately preceding it. If no such element exists,\n        then returns -1. The given array will not contain duplicate values.\n\n        Args:\n            arr: A list of integers.\n\n        Returns:\n            The largest index i such that arr[i] < arr[i-1], or -1 if no such\n            element exists.\n        \"\"\"\n        n = len(arr)\n        \n        # Handle edge cases for empty or single-element arrays as per REL-002 and examples.\n        if n <= 1:\n            return -1\n\n        # Iterate from the second-to-last element down to the second element\n        # (index n-1 down to 1) to find the largest index first (PERF-001).\n        # This ensures O(n) time complexity and O(1) space complexity (PERF-002).\\n        for i in range(n - 1, 0, -1):\\n            # Check the condition arr[i] < arr[i-1] as per FUN-001.\\n            if arr[i] < arr[i - 1]:"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst: list) -> tuple:\n    \"\"\"\n    Finds the largest negative integer and the smallest positive integer in a list.\n\n    Args:\n        lst (list): A list of integers.\n\n    Returns:\n        tuple: A tuple (a, b) where:\n            a: The largest negative integer in the list, or None if no negative integers.\n            b: The smallest positive integer in the list, or None if no positive integers.\n    \"\"\"\n    largest_negative = None\n    smallest_positive = None\n\n    for number in lst:\n        if number < 0:\n            if largest_negative is None or number > largest_negative:\n                largest_negative = number\n        elif number > 0:\n            if smallest_positive is None or number < smallest_positive:\n                smallest_positive = number\n    \n    return (largest_negative, smallest_positive)"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst: list[int]) -> tuple[int | None, int | None]:\n    \"\"\"\n    Finds the largest negative and smallest positive integers in a list.\n\n    Args:\n        lst: A list of integers.\n\n    Returns:\n        A tuple (a, b), where 'a' is the largest negative integer in 'lst'\n        and 'b' is the smallest positive integer in 'lst'.\n        If no negative integers are present, 'a' is None.\n        If no positive integers are present, 'b' is None.\n\n    Examples:\n        >>> largest_smallest_integers([2, 4, 1, 3, 5, 7])\n        (None, 1)\n        >>> largest_smallest_integers([])\n        (None, None)\n        >>> largest_smallest_integers([0])\n        (None, None)\n        >>> largest_smallest_integers([-1, -5, -3])\n        (-1, None)\n        >>> largest_smallest_integers([-10, 5, -3, 8, 0, 1])\n        (-3, 1)\n    \"\"\"\n    largest_negative = None\n    smallest_positive = None\n\n    for num in lst:\n        if num < 0:\n            if largest_negative is None or num > largest_negative:\n                largest_negative = num\n        elif num > 0:\n            if smallest_positive is None or num < smallest_positive:\n                smallest_positive = num\n    \n    return largest_negative, smallest_positive"}
