{"task_id": "HumanEval/24", "solution": "import math\ndef largest_divisor(n: int) -> int:\n    \"\"\"\n    Finds the largest number that divides n evenly, and is smaller than n.\n\n    This implementation iterates from 2 up to the square root of n.\n    If a divisor 'i' is found, then n // i is the largest proper divisor.\n    If no divisor is found, n is prime, and 1 is returned.\n\n    Args:\n        n (int): The integer for which to find the largest proper divisor.\n                 Must be greater than 1.\n\n    Returns:\n        int: The largest proper divisor of n.\n             Returns 1 if n is a prime number (its only proper divisor is 1).\n\n    Raises:\n        ValueError: If n is not an integer or is not greater than 1.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input 'n' must be an integer.\")\n    if n <= 1:\n        raise ValueError(\"Input 'n' must be greater than 1.\")\n\n    # Iterate from 2 up to sqrt(n)\n    # The smallest factor 'i' will yield the largest proper divisor 'n // i'\n    for i in range(2, int(math.sqrt(n)) + 1):\n        if n % i == 0:\n            # If i is a divisor, then n // i is also a divisor.\n            # Since i is the smallest prime factor (or any factor) found,\n            # n // i will be the largest proper divisor.\n            return n // i\n\n    # If no divisor is found in the loop, n is a prime number.\n    # Prime numbers greater than 1 have only one proper divisor: 1.\n    return 1"}
{"task_id": "HumanEval/24", "solution": "import math\ndef largest_divisor(n: int) -> int:\n    \"\"\"\n    Finds the largest number that divides `n` evenly, smaller than `n`.\n\n    This function handles positive integers n.\n    For n >= 2, it returns the largest proper divisor.\n    For n < 2, it raises a ValueError.\n\n    The algorithm iterates through potential divisors up to the square root of n.\n    If a factor 'i' is found, then 'n // i' is also a factor.\n    By finding the smallest prime factor 'i', the largest proper divisor is 'n // i'.\n    If no factors are found up to sqrt(n), 'n' is prime, and the largest proper divisor is 1.\n\n    Args:\n        n (int): A positive integer.\n\n    Returns:\n        int: The largest proper divisor of n.\n\n    Raises:\n        ValueError: If n is less than 2.\n\n    Examples:\n        >>> largest_divisor(10)\n        5\n        >>> largest_divisor(7)\n        1\n        >>> largest_divisor(12)\n        6\n        >>> largest_divisor(1)\n        Traceback (most recent call last):\n        ...\n        ValueError: Input 'n' must be an integer greater than or equal to 2.\n    \"\"\"\n    if n < 2:\n        raise ValueError(\"Input 'n' must be an integer greater than or equal to 2.\")\n\n    # Handle even numbers first, as 2 is the smallest prime factor\n    if n % 2 == 0:\n        return n // 2\n\n    # Check for odd divisors from 3 up to sqrt(n)\n    # The smallest factor (if n is composite and odd) will be an odd number.\n    # If `i` is the smallest factor, then `n // i` is the largest proper divisor.\n    limit = int(math.sqrt(n))\n    for i in range(3, limit + 1, 2):  # Iterate only over odd numbers\n        if n % i == 0:\n            return n // i\n\n    # If no factors were found, n must be a prime number (since we handled n=2 separately)\n    # For a prime number, the largest proper divisor is 1.\n    return 1"}
{"task_id": "HumanEval/25", "solution": "from typing import List\ndef factorize(n: int) -> List[int]:\n    factors = []\n    if n <= 1:\n        return factors\n\n    divisor = 2\n    while n > 1:\n        if n % divisor == 0:\n            factors.append(divisor)\n            n //= divisor\n        else:\n            # Optimization: If divisor*divisor > n, then remaining n must be prime\n            if divisor * divisor > n:\n                factors.append(n)\n                n = 1 # Exit loop\n            else:\n                divisor += 1\n    return factors"}
{"task_id": "HumanEval/25", "solution": "import math\nfrom typing import List\nclass Factorizer:\n    \"\"\"\n    A utility class for computing prime factorizations of integers.\n    Encapsulates the prime factorization logic.\n    \"\"\"\n\n    def factorize(self, n: int) -> List[int]:\n        \"\"\"\n        Computes the prime factors of a given positive integer.\n\n        Args:\n            n (int): The number to factorize. Must be a positive integer (n >= 1).\n\n        Returns:\n            List[int]: A list of prime factors of n, sorted in ascending order.\n                       Each factor is included as many times as it appears in the factorization.\n                       Returns an empty list for n=1.\n\n        Raises:\n            ValueError: If n is less than 1.\n        \"\"\"\n        # REQ-REL-002: Handle n < 1 by raising ValueError\n        if n < 1:\n            raise ValueError(\"Input must be a positive integer (n >= 1).\")\n\n        # REQ-FUN-003: Return an empty list for n = 1\n        if n == 1:\n            return []\n\n        # REQ-FUN-001: Accept a single integer n as input\n        # REQ-FUN-002: Compute the prime factors of n\n        # REQ-FUN-004: Include each prime factor with its multiplicity\n        # REQ-FUN-005: Return factors sorted in ascending order (algorithm naturally does this)\n        # REQ-PERF-002: Efficient algorithm for factorization\n\n        factors: List[int] = []\n\n        # Handle factor 2\n        # Continuously divide by 2 until n is odd\n        while n % 2 == 0:\n            factors.append(2)\n            n //= 2\n\n        # Handle odd factors\n        # Iterate from 3 up to sqrt(n), checking only odd numbers\n        # The loop condition d*d <= n is equivalent to d <= sqrt(n)\n        # but avoids floating-point operations.\n        d = 3\n        while d * d <= n:\n            while n % d == 0:\n                factors.append(d)\n                n //= d\n            d += 2  # Increment by 2 to check next odd number\n\n        # Handle remaining prime factor\n        # If n is still greater than 1 after the loop, it must be a prime number\n        # itself (and greater than sqrt of the original n).\n        if n > 1:\n            factors.append(n)\n\n        # REQ-FUN-006: The product of all elements in the returned list shall be equal to the input integer n.\n        # This is ensured by the correctness of the algorithm.\n\n        return factors\nfactorize = Factorizer().factorize"}
{"task_id": "HumanEval/26", "solution": "from typing import List\nfrom collections import Counter\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\"\n    From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n\n    Parameters:\n    numbers (List[int]): The input list of integers.\n\n    Returns:\n    List[int]: A new list containing only elements that occurred exactly once\n                in the input list, maintaining their original relative order.\n    \"\"\"\n    counts_map = Counter(numbers)\n    result_list = []\n\n    for number in numbers:\n        if counts_map[number] == 1:\n            result_list.append(number)\n\n    return result_list"}
{"task_id": "HumanEval/26", "solution": "from collections import Counter\nfrom typing import List\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\"\n    Filters a list of integers, retaining only those elements that appear exactly once\n    and preserving their original relative order.\n\n    Args:\n        numbers: A list of integers.\n\n    Returns:\n        A new list containing only the unique elements from the input list,\n        in their original relative order.\n    \"\"\"\n    # FR-2: Element Counting - Accurately count the occurrences of each integer.\n    counts = Counter(numbers)\n\n    # FR-4: Output List Construction - Initialize an empty list to store the result.\n    result = []\n    \n    # FR-5: Order Preservation - Iterate through the original input list\n    # to maintain the relative order of elements.\n    for num in numbers:\n        # FR-3: Uniqueness Identification - Identify integers whose occurrence count is exactly one.\n        if counts[num] == 1:\n            result.append(num) # Append only the unique elements.\n\n    # FR-6: Result Return - Return the newly constructed list.\n    return result"}
{"task_id": "HumanEval/27", "solution": "def flip_case(string: str) -> str:\n    \"\"\"\n    Flips the case of letters in the input string.\n    Lowercase letters become uppercase, and uppercase letters become lowercase.\n    Other characters remain unchanged.\n\n    Args:\n        string: The input string.\n\n    Returns:\n        The string with the case of letters flipped.\n    \"\"\"\n    flipped_chars = []\n    for char in string:\n        if 'a' <= char <= 'z':  # Check if it's a lowercase letter\n            flipped_chars.append(char.upper())\n        elif 'A' <= char <= 'Z':  # Check if it's an uppercase letter\n            flipped_chars.append(char.lower())\n        else:  # Other characters remain unchanged\n            flipped_chars.append(char)\n    return \"\".join(flipped_chars)"}
{"task_id": "HumanEval/27", "solution": "def flip_case(string: str) -> str:\n    \"\"\"\n    Flips the case of alphabetic characters in a given string.\n    Lowercase characters become uppercase, and uppercase characters become lowercase.\n    Non-alphabetic characters remain unchanged.\n\n    Args:\n        string (str): The input string to process.\n\n    Returns:\n        str: A new string with the case of alphabetic characters flipped.\n\n    Example:\n        >>> flip_case('Hello')\n        'hELLO'\n        >>> flip_case('PyThOn')\n        'pYtHoN'\n        >>> flip_case('123!@#')\n        '123!@#'\n        >>> flip_case('')\n        ''\n        >>> flip_case('\u00c4\u00d6\u00dc\u00e4\u00f6\u00fc') # Unicode example\n        '\u00e4\u00f6\u00fc\u00c4\u00d6\u00dc'\n    \"\"\"\n    return string.swapcase()"}
