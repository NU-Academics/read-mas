{"task_id": "HumanEval/147", "solution": "import math\nfrom typing import List, Tuple\nclass TripleCalculator:\n    def _combinations(self, n: int, k: int) -> int:\n        \"\"\"\n        Calculates nCk (n choose k) efficiently.\n        \"\"\"\n        if k < 0 or k > n:\n            return 0\n        if k == 0 or k == n:\n            return 1\n        if k > n // 2:\n            k = n - k\n        \n        res = 1\n        for i in range(k):\n            res = res * (n - i) // (i + 1)\n        return res\n\n    def calculate_modulo_counts(self, n: int) -> Tuple[int, int]:\n        \"\"\"\n        Calculates the counts of a[i] % 3 == 0 and a[i] % 3 == 1 for i in 1..n.\n        a[i] = i*i - i + 1\n        \n        Analysis of a[i] % 3 for 1-indexed i:\n        - If i % 3 == 0 (e.g., i=3, 6, ...): a[i] % 3 = (0*0 - 0 + 1) % 3 = 1\n        - If i % 3 == 1 (e.g., i=1, 4, ...): a[i] % 3 = (1*1 - 1 + 1) % 3 = 1\n        - If i % 3 == 2 (e.g., i=2, 5, ...): a[i] % 3 = (2*2 - 2 + 1) % 3 = (4 - 2 + 1) % 3 = 0\n\n        Counts of i in range [1, n] based on i % 3:\n        - n_mod_1_indices: count of i such that i % 3 == 1. This occurs for i = 1, 4, 7, ...\n          The count is (n + 2) // 3.\n        - n_mod_2_indices: count of i such that i % 3 == 2. This occurs for i = 2, 5, 8, ...\n          The count is (n + 1) // 3.\n        - n_mod_0_indices: count of i such that i % 3 == 0. This occurs for i = 3, 6, 9, ...\n          The count is n // 3.\n        \"\"\"\n        \n        n_mod_0_indices = n // 3\n        n_mod_1_indices = (n + 2) // 3\n        n_mod_2_indices = (n + 1) // 3\n\n        # Based on the analysis above:\n        # a[i] % 3 == 0 occurs when i % 3 == 2\n        count_a_mod_0 = n_mod_2_indices\n        # a[i] % 3 == 1 occurs when i % 3 == 0 or i % 3 == 1\n        count_a_mod_1 = n_mod_0_indices + n_mod_1_indices\n        \n        return count_a_mod_0, count_a_mod_1\n\n    def calculate_total_triples(self, count_a_mod_0: int, count_a_mod_1: int) -> int:\n        \"\"\"\n        Calculates the total number of unique triples (a[i], a[j], a[k]) such that i < j < k\n        and a[i] + a[j] + a[k] is a multiple of 3.\n        \n        The modulo property of a[i] values dictates they are either 0 or 1.\n        A sum (x + y + z) % 3 == 0 can occur in two ways for x,y,z in {0,1}:\n        1. All three are 0 (0 + 0 + 0 = 0 mod 3)\n        2. All three are 1 (1 + 1 + 1 = 3 = 0 mod 3)\n        \"\"\"\n        \n        # Number of ways to choose 3 elements whose modulo 3 value is 0\n        triples_000 = self._combinations(count_a_mod_0, 3)\n        # Number of ways to choose 3 elements whose modulo 3 value is 1\n        triples_111 = self._combinations(count_a_mod_1, 3)\n        \n        return triples_000 + triples_111\n\n    def generate_array(self, n: int) -> List[int]:\n        \"\"\"\n        Generates the array a where a[i] = i*i - i + 1 for 1 <= i <= n.\n        \"\"\"\n        return [i * i - i + 1 for i in range(1, n + 1)]\n\n    def find_valid_triples_naive(self, n: int, arr: List[int]) -> List[Tuple[int, int, int]]:\n        \"\"\"\n        Naively finds all unique triples (a[i], a[j], a[k]) such that i < j < k\n        and their sum is a multiple of 3. This method is for small n for explicit visualization.\n        \"\"\"\n        valid_triples = []\n        for i in range(n):\n            for j in range(i + 1, n):\n                for k in range(j + 1, n):\n                    if (arr[i] + arr[j] + arr[k]) % 3 == 0:\n                        valid_triples.append((arr[i], arr[j], arr[k]))\n        return valid_triples\ndef get_max_triples(n):\n    \"\"\"\n    You are given a positive integer n. You have to create an integer array a of length n.\n        For each i (1 \u2264 i \u2264 n), the value of a[i] = i * i - i + 1.\n        Return the number of triples (a[i], a[j], a[k]) of a where i < j < k, \n    and a[i] + a[j] + a[k] is a multiple of 3.\n\n    Example :\n        Input: n = 5\n        Output: 1\n        Explanation: \n        a = [1, 3, 7, 13, 21]\n        The only valid triple is (1, 7, 13).\n    \"\"\"\n    calculator = TripleCalculator()\n    count_a_mod_0, count_a_mod_1 = calculator.calculate_modulo_counts(n)\n    return calculator.calculate_total_triples(count_a_mod_0, count_a_mod_1)"}
{"task_id": "HumanEval/148", "solution": "PLANETS = [\n    \"Mercury\", \"Venus\", \"Earth\", \"Mars\",\n    \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n]\ndef bf(planet1: str, planet2: str) -> tuple[str, ...]:\n    \"\"\"\n    Finds planets between two given planet names, sorted by proximity to the sun.\n\n    Args:\n        planet1 (str): The name of the first planet. Case-insensitive.\n        planet2 (str): The name of the second planet. Case-insensitive.\n\n    Returns:\n        tuple[str, ...]: A tuple of planets strictly between planet1 and planet2,\n                         sorted by proximity to the sun. Returns an empty tuple\n                         if inputs are invalid, the same, or if no planets are\n                         between them.\n    \"\"\"\n    # Create a lowercased version of the PLANETS list for case-insensitive lookup\n    lower_planets = [p.lower() for p in PLANETS]\n\n    # Convert input planets to lowercase for matching\n    p1_lower = planet1.lower()\n    p2_lower = planet2.lower()\n\n    # FR.4: Invalid Planet Handling & FR.5: Same Planet Handling\n    if p1_lower not in lower_planets or p2_lower not in lower_planets or p1_lower == p2_lower:\n        return ()\n\n    # Get the indices of the planets\n    idx1 = lower_planets.index(p1_lower)\n    idx2 = lower_planets.index(p2_lower)\n\n    # Determine the start and end indices for slicing, ensuring correct order\n    # FR.8: Output Order - planets in the returned tuple shall be sorted by their proximity to the sun.\n    start_index = min(idx1, idx2)\n    end_index = max(idx1, idx2)\n\n    # FR.6: Intermediate Planet Identification\n    # Extract the planets strictly between the two input planets\n    # We add 1 to start_index to exclude the first planet\n    # The slice naturally excludes the end_index planet\n    intermediate_planets = PLANETS[start_index + 1 : end_index]\n\n    # FR.7: Output Format\n    return tuple(intermediate_planets)"}
{"task_id": "HumanEval/148", "solution": "class SolarSystem:\n    _PLANETS = (\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\")\n\n    def get_planet_index(self, planet_name: str) -> int | None:\n        \"\"\"\n        Returns the index of a planet in the _PLANETS list.\n        Returns None if the planet_name is not found.\n        \"\"\"\n        try:\n            return self._PLANETS.index(planet_name)\n        except ValueError:\n            return None\n\n    def get_planets_between_orbits(self, planet1_index: int, planet2_index: int) -> tuple:\n        \"\"\"\n        Returns a tuple of planets strictly between the given indices, sorted by proximity to the Sun.\n        Assumes valid indices are provided.\n        \"\"\"\n        # Ensure correct order for slicing\n        start_idx = min(planet1_index, planet2_index)\n        end_idx = max(planet1_index, planet2_index)\n\n        # Slice the planets list, excluding the start and end planets\n        intermediate_planets = self._PLANETS[start_idx + 1:end_idx]\n        return tuple(intermediate_planets)\n_solar_system = SolarSystem()\ndef bf(planet1: str, planet2: str) -> tuple:\n    \"\"\"\n    There are eight planets in our solar system: the closest to the Sun\n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn,\n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2.\n    The function should return a tuple containing all planets whose orbits are\n    located between the orbit of planet1 and the orbit of planet2, sorted by\n    the proximity to the sun.\n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names.\n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    \"\"\"\n    index1 = _solar_system.get_planet_index(planet1)\n    index2 = _solar_system.get_planet_index(planet2)\n\n    if index1 is None or index2 is None:\n        return ()  # Return empty tuple if any planet name is invalid\n\n    return _solar_system.get_planets_between_orbits(index1, index2)"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"\n    Filters a list of strings, removing those with odd lengths, and then sorts\n    the remaining strings first by length (ascending) and then alphabetically\n    (ascending) for strings of equal length.\n\n    The list is always a list of strings and never an array of numbers,\n    and it may contain duplicates.\n\n    Args:\n        lst: A list of strings to be processed.\n\n    Returns:\n        A new list containing only the even-length strings from the input list,\n        sorted as specified. The original list is not modified.\n\n    For example:\n    assert sorted_list_sum([\"aa\", \"a\", \"aaa\"]) == [\"aa\"]\n    assert sorted_list_sum([\"ab\", \"a\", \"aaa\", \"cd\"]) == [\"ab\", \"cd\"]\n    \"\"\"\n    # Filter out strings with odd lengths\n    filtered_list = [s for s in lst if len(s) % 2 == 0]\n\n    # Sort the filtered list\n    # The key for sorting is a tuple: (length of string, string itself).\n    # Python's sorted() function with a tuple key will sort primarily by the\n    # first element of the tuple (length) in ascending order, and secondarily\n    # by the second element (string value) in ascending alphabetical order.\n    sorted_result_list = sorted(filtered_list, key=lambda s: (len(s), s))\n\n    return sorted_result_list"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst: list[str]) -> list[str]:\n    \"\"\"\n    Filters a list of strings, keeping only those with an even length.\n    Then sorts the remaining strings first by length (ascending) and then\n    alphabetically (ascending) for strings of the same length.\n\n    Args:\n        lst: A list of strings.\n\n    Returns:\n        A new list containing the filtered and sorted strings.\n\n    Example:\n        >>> sorted_list_sum([\"aa\", \"a\", \"aaa\"])\n        [\"aa\"]\n        >>> sorted_list_sum([\"ab\", \"a\", \"aaa\", \"cd\"])\n        [\"ab\", \"cd\"]\n        >>> sorted_list_sum([\"apple\", \"banana\", \"kiwi\", \"grape\"])\n        [\"kiwi\", \"grape\", \"banana\"]\n        >>> sorted_list_sum([])\n        []\n        >>> sorted_list_sum([\"short\", \"medium\", \"longer\", \"a\", \"bb\"])\n        [\"bb\", \"medium\", \"longer\"]\n    \"\"\"\n    # Filter out strings with odd length, keeping only even-length strings.\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n\n    # Sort the even-length strings:\n    # 1. Primarily by length in ascending order (len(s)).\n    # 2. Secondarily alphabetically in ascending order (s) for strings of the same length.\n    # Python's `sorted()` with a key function that returns a tuple handles this naturally.\n    final_sorted_list = sorted(even_length_strings, key=lambda s: (len(s), s))\n\n    return final_sorted_list"}
{"task_id": "HumanEval/150", "solution": "from typing import Any\ndef _is_prime(n: int) -> bool:\n    \"\"\"\n    Determines if an integer n is a prime number.\n\n    Args:\n        n: The integer to check for primality.\n\n    Returns:\n        True if n is prime, False otherwise.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 2:\n        return False\n    if n == 2 or n == 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\ndef x_or_y(n: int, x: Any, y: Any) -> Any:\n    \"\"\"\n    Returns 'x' if 'n' is a prime number, otherwise returns 'y'.\n\n    Args:\n        n: An integer to check for primality.\n        x: The value to return if 'n' is prime.\n        y: The value to return if 'n' is not prime.\n\n    Returns:\n        'x' if 'n' is prime, 'y' otherwise.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n\n    if _is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/150", "solution": "import math\nfrom typing import Any\ndef is_prime(num: int) -> bool:\n    \"\"\"\n    Determines if a given integer is a prime number.\n\n    Args:\n        num (int): The integer to test for primality.\n\n    Returns:\n        bool: True if num is prime, False otherwise.\n    \"\"\"\n    if num <= 1:\n        return False  # F.2: Numbers less than or equal to 1 are not prime.\n    if num == 2:\n        return True   # F.3: 2 is the only even prime number.\n    if num % 2 == 0:\n        return False  # F.4: Even numbers greater than 2 are not prime.\n\n    # F.5: Iterate through odd numbers from 3 up to the square root of num.\n    # If a divisor is found, num is not prime.\n    # The upper limit for divisors to check is the integer square root of num.\n    limit = math.isqrt(num)\n    for i in range(3, limit + 1, 2):\n        if num % i == 0:\n            return False  # F.6: Divisible by i, so not prime.\n\n    return True  # F.7: No divisors found, so num is prime.\ndef x_or_y(n: int, x: Any, y: Any) -> Any:\n    \"\"\"\n    Selects between two values x and y based on whether n is a prime number.\n\n    Args:\n        n (int): The integer to check for primality. (F.8)\n        x (Any): The value to return if n is prime. (F.9)\n        y (Any): The value to return if n is not prime. (F.9)\n\n    Returns:\n        Any: Returns x if n is prime, otherwise returns y.\n    \"\"\"\n    # F.10: Call the is_prime function with n to determine its primality.\n    if is_prime(n):\n        return x  # F.11: If n is prime, return x.\n    else:\n        return y  # F.12: If n is not prime, return y."}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst: list) -> int:\n    \"\"\"\n    Calculates the sum of squares of positive odd integers in a list.\n\n    Args:\n        lst (list): A list of numbers (integers, floats) and potentially other types.\n\n    Returns:\n        int: The sum of squares of positive odd integers. Returns 0 if the list is empty\n             or contains no qualifying numbers.\n\n    Examples:\n        double_the_difference([1, 3, 2, 0]) == 10\n        double_the_difference([-1, -2, 0]) == 0\n        double_the_difference([9, -2]) == 81\n        double_the_difference([0]) == 0\n        double_the_difference([1.5, 3.0, 5]) == 25\n    \"\"\"\n    total_sum = 0\n    for element in lst:\n        # FR3.1: The system shall verify if num is an instance of an integer (int).\n        if isinstance(element, int):\n            # FR3.2: If num is an integer, the system shall verify if num is non-negative (num >= 0).\n            if element >= 0:\n                # FR3.3: If num is a non-negative integer, the system shall verify if num is odd (num % 2 != 0).\n                if element % 2 != 0:\n                    # FR3.4: If num satisfies all conditions, the system shall square num.\n                    squared_value = element ** 2\n                    # FR3.5: The system shall add the squared value of num to the running sum.\n                    total_sum += squared_value\n    \n    # FR4: If the input list lst is empty, the system shall return 0.\n    # This is implicitly handled by total_sum starting at 0 and no elements meeting criteria.\n    # FR5: The system shall return the final calculated running sum.\n    return total_sum"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    \"\"\"\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are positive and odd integers. Ignore numbers that\n    are negative, zero, not integers, or not numbers.\n\n    Args:\n        lst (list): A list of various types of numbers or other objects.\n\n    Returns:\n        int: The sum of squares of qualifying numbers. Returns 0 if the\n             input list is empty or contains no qualifying numbers.\n\n    Examples:\n        double_the_difference([1, 3, 2, 0]) == 10  (1*1 + 3*3)\n        double_the_difference([-1, -2, 0]) == 0\n        double_the_difference([9, -2]) == 81  (9*9)\n        double_the_difference([0]) == 0\n        double_the_difference([1.5, 3.0, 5]) == 25 (only 5 is int and odd)\n        double_the_difference([]) == 0\n    \"\"\"\n    total_sum = 0\n    # REQ-FUNC-002: Iterate through each element within the input lst\n    for item in lst:\n        # REQ-FUNC-003: Verify if its type is int (an integer)\n        # REQ-FUNC-004: If an element is not an int type, it shall be excluded\n        if isinstance(item, int):\n            # REQ-FUNC-005: Check if its value is positive (i.e., element > 0)\n            # REQ-FUNC-006: If an int element's value is not positive (i.e., element <= 0), it shall be excluded\n            if item > 0:\n                # REQ-FUNC-007: Check if its value is odd (i.e., element % 2 != 0)\n                # REQ-FUNC-008: If a positive int element's value is not odd (i.e., it's even), it shall be excluded\n                if item % 2 != 0:\n                    # REQ-FUNC-009: For each element that is a positive odd integer, calculate its square\n                    # REQ-FUNC-010: Maintain a running total, summing the squares\n                    total_sum += item * item\n    # REQ-FUNC-011: If the input lst is empty, the system shall immediately return 0 (handled by initial total_sum = 0)\n    # REQ-FUNC-012: The system shall return the final calculated sum of squares\n    return total_sum"}
{"task_id": "HumanEval/152", "solution": "def compare(game: list[int], guess: list[int]) -> list[int]:\n    \"\"\"\n    Compares two lists of integers element-wise.\n\n    For each corresponding pair of elements (score from 'game' and guess from 'guess')\n    at the same index:\n    - If the score and guess are equal, the element in the result list should be 0.\n    - If the score and guess are not equal, the element in the result list should be\n      the absolute difference between the score and the guess.\n\n    Assumes 'game' and 'guess' are of equal length and contain only integers.\n    No explicit error handling for unequal lengths or non-integer elements is included\n    as per requirements.\n\n    Args:\n        game (list[int]): The reference list of integer scores.\n        guess (list[int]): The list of integer guesses.\n\n    Returns:\n        list[int]: A new list containing the comparison results.\n    \"\"\"\n    result = []\n    # Using zip to iterate through both lists simultaneously, assuming equal length\n    for score, g in zip(game, guess):\n        if score == g:\n            result.append(0)\n        else:\n            result.append(abs(score - g))\n    return result"}
{"task_id": "HumanEval/152", "solution": "def compare(game: list[int], guess: list[int]) -> list[int]:\n    \"\"\"I think we all remember that feeling when the result of some long-awaited\n    event is finally known. The feelings and thoughts you have at that moment are\n    definitely worth noting down and comparing.\n    Your task is to determine if a person correctly guessed the results of a number of matches.\n    You are given two arrays of scores and guesses of equal length, where each index shows a match. \n    Return an an array of the same length denoting how far off each guess was. If they have guessed correctly,\n    the value is 0, and if not, the value is the absolute difference between the guess and the score.\n    \n    \n    example:\n\n    compare([1,2,3,4,5,1],[1,2,3,4,2,-2]) -> [0,0,0,0,3,3]\n    compare([0,5,0,0,0,4],[4,1,1,0,0,-2]) -> [4,4,1,0,0,6]\n    \"\"\"\n    \n    # According to FR2 and assumptions, game and guess are guaranteed to be of equal length.\n    # No explicit length check is performed as per current requirements, but could be added\n    # for robustness (e.g., raise ValueError).\n\n    deviations = []\n    # FR3: For each corresponding element, calculate the absolute difference.\n    # FR4: If equal, difference is 0. This is naturally handled by abs(x - x) == 0.\n    for i in range(len(game)):\n        deviation = abs(game[i] - guess[i])\n        deviations.append(deviation)\n    \n    # FR5: Return a new list containing all calculated deviations.\n    return deviations"}
{"task_id": "HumanEval/153", "solution": "import string\ndef _calculate_strength(extension_name: str) -> int:\n    \"\"\"\n    Calculates the strength of a single extension.\n\n    Strength = (number of uppercase letters) - (number of lowercase letters).\n\n    Args:\n        extension_name (str): The extension string.\n\n    Returns:\n        int: The calculated strength.\n    \"\"\"\n    upper_count = 0\n    lower_count = 0\n    for char in extension_name:\n        if char.isupper():\n            upper_count += 1\n        elif char.islower():\n            lower_count += 1\n    return upper_count - lower_count\ndef Strongest_Extension(class_name: str, extensions: list[str]) -> str:\n    \"\"\"\n    Determines the 'strongest' extension based on a strength formula.\n\n    Strength formula: (number of uppercase letters) - (number of lowercase letters).\n    In case of a tie in strength, the first occurring extension in the list is chosen.\n\n    Args:\n        class_name (str): The name of the class (e.g., \"MyClass\").\n        extensions (list[str]): A list of extension names (e.g., [\"Txt\", \"DocX\", \"ZIP\"]).\n\n    Returns:\n        str: A string in the format 'ClassName.StrongestExtensionName'.\n\n    Raises:\n        TypeError: If class_name is not a string, extensions is not a list,\n                   or any element in extensions is not a string.\n        ValueError: If the extensions list is empty.\n    \"\"\"\n    # F.REQ.8: The system shall raise a TypeError if class_name is not a string.\n    if not isinstance(class_name, str):\n        raise TypeError(\"class_name must be a string.\")\n\n    # F.REQ.9: The system shall raise a TypeError if extensions is not a list.\n    if not isinstance(extensions, list):\n        raise TypeError(\"extensions must be a list.\")\n\n    # F.REQ.7: If the extensions list is empty, the system shall raise a ValueError.\n    if not extensions:\n        raise ValueError(\"extensions list cannot be empty.\")\n\n    # F.REQ.10: The system shall raise a TypeError if any element within the extensions list is not a string.\n    for ext in extensions:\n        if not isinstance(ext, str):\n            raise TypeError(\"All elements in the extensions list must be strings.\")\n\n    max_strength = float('-inf')\n    strongest_extension_name = \"\"\n\n    # F.REQ.3: For each extension_name, calculate its 'strength'.\n    # F.REQ.4: Identify the extension_name with the highest calculated strength.\n    # F.REQ.5: If multiple extensions share the same highest strength,\n    #          select the one that appears earliest in the input extensions list.\n    for extension_name in extensions:\n        current_strength = _calculate_strength(extension_name)\n        \n        # The tie-breaking rule (first occurring) is implicitly handled here:\n        # We only update `strongest_extension_name` if `current_strength` is *strictly greater*\n        # than `max_strength`. If `current_strength` is equal to `max_strength`,\n        # we do not update, thus preserving the `strongest_extension_name` that was\n        # encountered earlier in the list.\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = extension_name\n\n    # F.REQ.6: The system shall return a string formatted as 'ClassName.StrongestExtensionName'.\n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/153", "solution": "import math\ndef Strongest_Extension(class_name: str, extensions: list[str]) -> str:\n    \"\"\"\n    Finds the strongest extension from a list based on a predefined strength\n    calculation and returns it combined with the class name.\n\n    Strength is calculated as (Count of Uppercase letters - Count of lowercase letters).\n    In case of a tie in strength, the first encountered extension in the list is chosen.\n\n    Args:\n        class_name (str): The base name for the class.\n        extensions (list[str]): A list of candidate extension names.\n\n    Returns:\n        str: A string in the format \"{class_name}.{strongest_extension_name}\".\n             If the extensions list is empty, returns \"{class_name}.\"\n    \"\"\"\n    if not extensions:\n        return f\"{class_name}.\"\n\n    max_strength = -math.inf  # Initialize with a very low value to ensure any valid strength is higher\n    strongest_ext_name = \"\"\n\n    for extension in extensions:\n        cap_count = 0  # Count of Uppercase letters (CAP)\n        sm_count = 0   # Count of lowercase letters (SM)\n\n        for char in extension:\n            if char.isupper():\n                cap_count += 1\n            elif char.islower():\n                sm_count += 1\n        \n        current_strength = cap_count - sm_count\n\n        # If current strength is greater, update.\n        # This naturally handles the tie-breaking rule by keeping the first encountered\n        # extension if strengths are equal.\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_ext_name = extension\n\n    return f\"{class_name}.{strongest_ext_name}\""}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a: str, b: str) -> bool:\n    \"\"\"\n    Determines if a given string `b` or any of its cyclic rotations is a substring of\n    another given string `a`.\n\n    Args:\n        a: The main text string to search within.\n        b: The pattern string whose rotations are to be searched.\n\n    Returns:\n        True if any cyclic rotation of `b` is found as a substring in `a`,\n        False otherwise.\n    \"\"\"\n    if len(b) == 0:\n        return True\n    \n    if len(b) > len(a):\n        return False\n\n    b_double = b + b\n    len_b = len(b)\n\n    for i in range(len_b):\n        candidate_rotation = b_double[i : i + len_b]\n        if candidate_rotation in a:\n            return True\n            \n    return False"}
{"task_id": "HumanEval/154", "solution": "class StringPatternChecker:\n    @staticmethod\n    def cycpattern_check(a: str, b: str) -> bool:\n        # Handle initial edge cases\n        if not b:  # If b is an empty string, it's considered a substring of any string\n            return True\n        if len(b) > len(a):  # If b is longer than a, it cannot be a substring\n            return False\n\n        # Create a doubled version of b to easily access all its cyclic rotations\n        # Any cyclic rotation of b will be a substring of b_doubled with length len(b)\n        b_doubled = b + b\n\n        # Iterate through all unique cyclic rotations of b\n        # There are exactly len(b) unique rotations\n        for i in range(len(b)):\n            current_rotation = b_doubled[i : i + len(b)]\n            # Check if the current rotation is a substring of a\n            if current_rotation in a:\n                return True\n\n        # If no rotation of b was found as a substring in a after checking all of them\n        return False"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num: int) -> tuple[int, int]:\n    even_count = 0\n    odd_count = 0\n\n    if num == 0:\n        return (1, 0) # 0 is one even digit\n\n    abs_num = abs(num)\n    str_num = str(abs_num)\n\n    for digit_char in str_num:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n            \n    return (even_count, odd_count)"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num: int) -> tuple[int, int]:\n    \"\"\"\n    Given an integer, return a tuple that has the number of even and odd digits respectively.\n\n    Args:\n        num (int): The integer to analyze.\n\n    Returns:\n        tuple[int, int]: A tuple containing (even_digit_count, odd_digit_count).\n\n    Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n        even_odd_count(0)   ==> (1, 0)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    # Handle the special case where the input number is 0\n    if num == 0:\n        return (1, 0)\n\n    # Convert the absolute value of the number to a string to iterate through its digits.\n    # abs() ensures negative numbers like -12 are treated as 12 for digit counting.\n    num_str = str(abs(num))\n\n    for char_digit in num_str:\n        # Convert the character digit back to an integer\n        digit = int(char_digit)\n        \n        # Check if the digit is even or odd and update the respective count\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number: int) -> str:\n    \"\"\"\n    Converts a positive integer (1-1000) to its Roman numeral equivalent in lowercase.\n\n    Args:\n        number: An integer between 1 and 1000 (inclusive).\n\n    Returns:\n        A string representing the lowercase Roman numeral.\n    \"\"\"\n    roman_map = [\n        (1000, 'm'), (900, 'cm'), (500, 'd'), (400, 'cd'),\n        (100, 'c'), (90, 'xc'), (50, 'l'), (40, 'xl'),\n        (10, 'x'), (9, 'ix'), (5, 'v'), (4, 'iv'),\n        (1, 'i')\n    ]\n\n    result = []\n    current_number = number\n\n    for value, symbol in roman_map:\n        while current_number >= value:\n            result.append(symbol)\n            current_number -= value\n    \n    return \"\".join(result)"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number: int) -> str:\n    \"\"\"\n    Converts a positive integer (1 <= number <= 1000) to its lowercase Roman numeral equivalent.\n\n    Args:\n        number: A positive integer between 1 and 1000.\n\n    Returns:\n        A string representing the lowercase Roman numeral equivalent.\n\n    Raises:\n        ValueError: If the input number is not within the specified range [1, 1000].\n\n    Examples:\n        >>> int_to_mini_roman(19)\n        'xix'\n        >>> int_to_mini_roman(152)\n        'clii'\n        >>> int_to_mini_roman(426)\n        'cdxxvi'\n        >>> int_to_mini_roman(1)\n        'i'\n        >>> int_to_mini_roman(1000)\n        'm'\n    \"\"\"\n    if not (1 <= number <= 1000):\n        raise ValueError(\"Input number must be between 1 and 1000.\")\n\n    roman_map = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'), (1, 'I')\n    ]\n\n    roman_numeral = []\n    for value, symbol in roman_map:\n        while number >= value:\n            roman_numeral.append(symbol)\n            number -= value\n    \n    return \"\".join(roman_numeral).lower()"}
{"task_id": "HumanEval/157", "solution": "from typing import Union\ndef right_angle_triangle(a: Union[int, float], b: Union[int, float], c: Union[int, float]) -> bool:\n    \"\"\"\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is a right angle (90 degrees).\n\n    The function first sorts the sides to easily identify the potential hypotenuse.\n    It then validates that sides are positive and satisfy the triangle inequality.\n    Finally, it applies the Pythagorean theorem, using an epsilon for float comparison\n    to account for potential floating-point precision errors.\n\n    Args:\n        a: A numeric value representing the length of the first side.\n        b: A numeric value representing the length of the second side.\n        c: A numeric value representing the length of the third side.\n\n    Returns:\n        True if the three sides form a right-angled triangle.\n        False otherwise.\n\n    Examples:\n        right_angle_triangle(3, 4, 5) == True\n        right_angle_triangle(5, 12, 13) == True\n        right_angle_triangle(3.0, 4.0, 5.0) == True\n        right_angle_triangle(1, 2, 3) == False  # Fails triangle inequality\n        right_angle_triangle(2, 2, 2) == False  # Equilateral, not right-angled\n        right_angle_triangle(0, 4, 5) == False  # Non-positive side\n        right_angle_triangle(-3, 4, 5) == False # Non-positive side\n    \"\"\"\n    sides = sorted([a, b, c])\n    s1, s2, s3 = sides[0], sides[1], sides[2]\n\n    # FR3: All sides must be strictly positive\n    if s1 <= 0:\n        return False\n\n    # FR4: Check triangle inequality (s1 + s2 > s3 for a non-degenerate triangle)\n    # If s1 + s2 <= s3, the sides cannot form a valid triangle.\n    if s1 + s2 <= s3:\n        return False\n\n    # FR5: Apply Pythagorean theorem\n    # Use an epsilon for floating-point comparisons to account for precision errors.\n    # A default epsilon of 1e-9 is recommended.\n    epsilon = 1e-9 \n    \n    # Calculate squares\n    s1_sq = s1 * s1\n    s2_sq = s2 * s2\n    s3_sq = s3 * s3\n\n    # Check if (s1*s1 + s2*s2) is approximately equal to (s3*s3)\n    if abs((s1_sq + s2_sq) - s3_sq) < epsilon:\n        # FR6: If all conditions met, return True\n        return True\n    else:\n        # FR6: Otherwise, return False\n        return False"}
{"task_id": "HumanEval/157", "solution": "import math\ndef right_angle_triangle(a: float, b: float, c: float) -> bool:\n    \"\"\"\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or\n    90 degree.\n\n    Args:\n        a (float): Length of the first side.\n        b (float): Length of the second side.\n        c (float): Length of the third side.\n\n    Returns:\n        bool: True if the sides form a right-angled triangle, False otherwise.\n    \"\"\"\n    sides = sorted([a, b, c])\n    # a_sq + b_sq = c_sq\n    # The longest side is the hypotenuse (sides[2])\n    # The other two are legs (sides[0], sides[1])\n    # Using math.isclose for float precision if inputs are floats\n    # A reasonable relative tolerance for geometry might be 1e-9 or similar.\n    # For integer inputs, direct comparison would work, but isclose is safer for floats.\n    return math.isclose(sides[0]**2 + sides[1]**2, sides[2]**2, rel_tol=1e-9)"}
{"task_id": "HumanEval/158", "solution": "from typing import List\ndef find_max(words: List[str]) -> str:\n    \"\"\"\n    Finds the word with the maximum number of unique characters.\n    If multiple strings have the maximum number of unique characters,\n    returns the one that comes first in lexicographical order.\n\n    Args:\n        words: A list of strings.\n\n    Returns:\n        The word satisfying the criteria.\n\n    Raises:\n        ValueError: If the input list 'words' is empty.\n    \"\"\"\n    if not words:\n        raise ValueError(\"Input list 'words' cannot be empty.\")\n\n    # Helper function to count unique characters in a string\n    def count_unique_chars(s: str) -> int:\n        return len(set(s))\n\n    max_unique_count: int = -1\n    result_word: str = \"\"\n\n    # Iterate through the words to find the one with max unique characters\n    for word in words:\n        current_unique_count = count_unique_chars(word)\n\n        if current_unique_count > max_unique_count:\n            # Found a new maximum unique count, update both count and word\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            # Same unique count, apply lexicographical tie-breaker\n            if word < result_word:\n                result_word = word\n    \n    return result_word"}
{"task_id": "HumanEval/158", "solution": "def find_max(words: list[str]) -> str | None:\n    \"\"\"\n    Finds the word with the maximum number of unique characters.\n    If multiple words have the same maximum, returns the one that comes first\n    in lexicographical order.\n\n    Args:\n        words: A list of strings.\n\n    Returns:\n        The word with the maximum unique characters (and lexicographically first\n        in case of a tie), or None if the input list is empty.\n    \"\"\"\n    if not words:\n        return None\n\n    # Initialize with the first word in the list.\n    # This handles the single-element list case and provides initial values\n    # for comparison.\n    best_word = words[0]\n    max_unique_chars = len(set(best_word))\n\n    # Iterate from the second word onwards to compare with the current best.\n    for word in words[1:]:\n        current_unique_count = len(set(word))\n\n        if current_unique_count > max_unique_chars:\n            # Found a word with more unique characters, update the best.\n            max_unique_chars = current_unique_count\n            best_word = word\n        elif current_unique_count == max_unique_chars:\n            # Tie-breaking: if unique character counts are equal,\n            # select the one that comes first in lexicographical order.\n            if word < best_word:\n                best_word = word\n    \n    return best_word"}
{"task_id": "HumanEval/159", "solution": "class CarrotManagementService:\n    @staticmethod\n    def eat(number: int, need: int, remaining: int) -> list[int, int]:\n        \"\"\"\n        You're a hungry rabbit, and you already have eaten a certain number of carrots,\n        but now you need to eat more carrots to complete the day's meals.\n        you should return an array of [ total number of eaten carrots after your meals,\n                                        the number of carrots left after your meals ]\n        if there are not enough remaining carrots, you will eat all remaining carrots, but will still be hungry.\n        \n        Example:\n        * eat(5, 6, 10) -> [11, 4]\n        * eat(4, 8, 9) -> [12, 1]\n        * eat(1, 10, 10) -> [11, 0]\n        * eat(2, 11, 5) -> [7, 0]\n        \n        Variables:\n        @number : integer\n            the number of carrots that you have eaten.\n        @need : integer\n            the number of carrots that you need to eat.\n        @remaining : integer\n            the number of remaining carrots thet exist in stock\n        \n        Constrain:\n        * 0 <= number <= 1000\n        * 0 <= need <= 1000\n        * 0 <= remaining <= 1000\n        \"\"\"\n        \n        # Determine how many carrots are actually eaten in this meal\n        # It's the minimum of what's needed and what's available\n        carrots_eaten_this_meal = min(need, remaining)\n        \n        # Calculate the total number of carrots eaten\n        total_eaten_carrots = number + carrots_eaten_this_meal\n        \n        # Calculate the number of carrots left after the meal\n        carrots_left_in_stock = remaining - carrots_eaten_this_meal\n        \n        return [total_eaten_carrots, carrots_left_in_stock]"}
{"task_id": "HumanEval/159", "solution": "class CarrotConsumption:\n    \"\"\"\n    A utility class for calculating rabbit carrot consumption.\n    \"\"\"\n\n    @staticmethod\n    def eat(number: int, need: int, remaining: int) -> list[int, int]:\n        \"\"\"\n        Calculates the outcome of a rabbit's carrot meal.\n\n        You're a hungry rabbit, and you already have eaten a certain number of carrots,\n        but now you need to eat more carrots to complete the day's meals.\n        you should return an array of [ total number of eaten carrots after your meals,\n                                        the number of carrots left after your meals ]\n        if there are not enough remaining carrots, you will eat all remaining carrots,\n        but will still be hungry.\n\n        Args:\n            number (int): The number of carrots that you have eaten.\n            need (int): The number of carrots that you need to eat.\n            remaining (int): The number of remaining carrots that exist in stock.\n\n        Returns:\n            list[int, int]: An array of [total_eaten_carrots, carrots_left_after_meals].\n\n        Constrains:\n            0 <= number <= 1000\n            0 <= need <= 1000\n            0 <= remaining <= 1000\n        \"\"\"\n        # FR1: Input Validation\n        if not (0 <= number <= 1000):\n            raise ValueError(f\"Input 'number' ({number}) must be between 0 and 1000 inclusive.\")\n        if not (0 <= need <= 1000):\n            raise ValueError(f\"Input 'need' ({need}) must be between 0 and 1000 inclusive.\")\n        if not (0 <= remaining <= 1000):\n            raise ValueError(f\"Input 'remaining' ({remaining}) must be between 0 and 1000 inclusive.\")\n\n        # FR2: Calculate carrots actually consumed from stock\n        # The rabbit eats the minimum of what it needs and what is available.\n        carrots_consumed = min(need, remaining)\n\n        # FR3: Calculate total carrots eaten\n        total_eaten = number + carrots_consumed\n\n        # FR4: Calculate carrots left in stock\n        carrots_left = remaining - carrots_consumed\n\n        # FR5: Return the result as a two-element list\n        return [total_eaten, carrots_left]"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator: list[str], operand: list[int]) -> int:\n    \"\"\"\n    Constructs and evaluates an algebraic expression from a list of operators and operands.\n\n    The expression is constructed by interleaving operands and operators in the order they appear:\n    operand[0] operator[0] operand[1] operator[1] ... operand[N].\n    The evaluation respects standard mathematical operator precedence.\n\n    Args:\n        operator: A list of strings, where each string is one of '+', '-', '*', '//', '**'.\n                  Assumed to have a length equal to len(operand) - 1 and at least one operator.\n        operand: A list of non-negative integers.\n                 Assumed to have at least two operands.\n\n    Returns:\n        An integer representing the evaluated result of the algebraic expression.\n\n    Raises:\n        SyntaxError, TypeError, IndexError: If the input assumptions are violated or\n                                            if `eval` encounters an invalid expression.\n    \"\"\"\n    expression_parts = []\n\n    # REQ-FUNC-001: Start by appending the first operand\n    expression_parts.append(str(operand[0]))\n\n    # REQ-FUNC-001: Interleave operators and subsequent operands\n    # REQ-FUNC-005, REQ-FUNC-006: Assumed lengths ensure this loop is valid\n    for i in range(len(operator)):\n        # REQ-FUNC-002: Supported operations are implicitly handled by appending the string\n        # REQ-QOS-SEC-001: Operators are appended directly, operands are stringified\n        expression_parts.append(operator[i])\n        expression_parts.append(str(operand[i+1]))\n\n    # Join all parts to form the complete expression string\n    expression_string = \" \".join(expression_parts)\n\n    # REQ-FUNC-003: Evaluate the expression string respecting standard precedence\n    # REQ-QOS-SEC-001: Leverages Python's eval() with controlled string construction\n    result = eval(expression_string)\n\n    # REQ-FUNC-004: Return the integer result\n    # Given the allowed operators ('+', '-', '*', '//', '**') and integer operands,\n    # the result of these operations should naturally be an integer (e.g., floor division).\n    # No explicit cast to int is typically needed unless floating-point division was allowed.\n    return result"}
{"task_id": "HumanEval/160", "solution": "import operator\nfrom typing import List\ndef do_algebra(operator_list: List[str], operand_list: List[int]) -> int:\n    \"\"\"\n    Evaluates a basic algebraic expression defined by lists of operators and operands.\n\n    The function constructs an expression by interleaving operands and operators\n    and evaluates it following standard mathematical operator precedence.\n\n    Args:\n        operator_list (List[str]): A list of strings representing arithmetic operations\n                                   ('+', '-', '*', '//', '**'). Must contain at least one operator.\n        operand_list (List[int]): A list of non-negative integers.\n                                  Must contain at least two operands.\n\n    Returns:\n        int: The integer result of the evaluated expression.\n\n    Raises:\n        ValueError: If input lists do not meet specified length constraints or\n                    if the expression is malformed during evaluation.\n        TypeError: If operands are not integers (implicit, handled by Python operators).\n        KeyError: If an unsupported operator string is provided (implicit, handled by dictionary lookup).\n        ZeroDivisionError: If a floor division by zero occurs (implicit, handled by operator.floordiv).\n    \"\"\"\n    # Product Constraints and FR-4: Input Validation (Length)\n    if len(operand_list) < 2:\n        raise ValueError(\"Operand list must contain at least two operands.\")\n    if len(operator_list) < 1:\n        raise ValueError(\"Operator list must contain at least one operator.\")\n    if len(operator_list) != len(operand_list) - 1:\n        raise ValueError(\n            f\"Operator list length ({len(operator_list)}) must be \"\n            f\"one less than operand list length ({len(operand_list)}).\"\n        )\n\n    # FR-1: Expression Construction\n    # Interleave operands and operators into a single list\n    expression_tokens = []\n    for i in range(len(operand_list)):\n        expression_tokens.append(operand_list[i])\n        if i < len(operator_list):\n            expression_tokens.append(operator_list[i])\n\n    # FR-2, FR-3: Operator Precedence Evaluation and Supported Operations\n    # Define operator precedence levels\n    precedence = {\n        '**': 3,\n        '*': 2, '//': 2,\n        '+': 1, '-': 1\n    }\n\n    # Map operator strings to their corresponding Python functions\n    op_funcs = {\n        '+': operator.add,\n        '-': operator.sub,\n        '*': operator.mul,\n        '//': operator.floordiv,\n        '**': operator.pow\n    }\n\n    # Get unique precedence levels and sort them in descending order for multi-pass evaluation\n    # This ensures higher precedence operations are processed first.\n    precedence_levels = sorted(list(set(precedence.values())), reverse=True)\n\n    # `current_expression` will be iteratively reduced in each pass\n    current_expression = list(expression_tokens)\n\n    # Iterate through each precedence level\n    for level in precedence_levels:\n        new_expression_pass = []\n        i = 0\n        while i < len(current_expression):\n            item = current_expression[i]\n\n            # Check if the current item is an operator matching the current precedence level\n            if isinstance(item, str) and item in op_funcs and precedence[item] == level:\n                # Found an operator of the current precedence.\n                # It requires a left operand (from `new_expression_pass`)\n                # and a right operand (from `current_expression[i+1]`).\n\n                # Validate left operand availability\n                if not new_expression_pass:\n                    raise ValueError(f\"Malformed expression: Operator '{item}' at index {i} has no left operand.\")\n                left_operand = new_expression_pass.pop() # Get the last operand processed\n\n                op = item\n\n                # Validate right operand availability\n                if i + 1 >= len(current_expression):\n                    raise ValueError(f\"Malformed expression: Operator '{op}' at index {i} has no right operand.\")\n                right_operand = current_expression[i+1]\n\n                # Perform the operation using the mapped function\n                # FR-5 & FR-6 implicit validation:\n                # If operands are not numbers, `op_funcs[op]` will raise TypeError.\n                # If `op` is not a valid key, `op_funcs[op]` will raise KeyError (though checked above).\n                # If `right_operand` is 0 for floor division, `operator.floordiv` will raise ZeroDivisionError.\n                result = op_funcs[op](left_operand, right_operand)\n                \n                # Append the result to the new list for this pass\n                new_expression_pass.append(result)\n                i += 2  # Skip the operator and its right operand (both consumed)\n            else:\n                # If not an operator of the current precedence level (or an operand),\n                # just add it to the new list\n                new_expression_pass.append(item)\n                i += 1\n        \n        # After processing all items at the current precedence level,\n        # update `current_expression` for the next pass\n        current_expression = new_expression_pass\n\n        # Optimization: If the expression has been reduced to a single value,\n        # we can stop early and return the result.\n        if len(current_expression) == 1 and isinstance(current_expression[0], (int, float)):\n            return int(current_expression[0]) # FR-7: Ensure integer return\n\n    # FR-7: Result Output\n    # After all precedence levels are processed, `current_expression` should contain\n    # a single element, which is the final integer result.\n    if len(current_expression) == 1:\n        return int(current_expression[0])\n    else:\n        # This case indicates an unhandled error or malformed expression that\n        # was not fully reduced.\n        raise ValueError(f\"Failed to fully evaluate expression; remaining tokens: {current_expression}\")"}
{"task_id": "HumanEval/161", "solution": "def solve(s: str) -> str:\n    \"\"\"\n    Transforms the input string s according to the following rules:\n    1. If s[i] is a letter, reverse its case (lower to upper or vice versa).\n    2. Otherwise, keep it as is.\n    3. If the string contains no letters, reverse the entire original string.\n    \n    Args:\n        s (str): The input string.\n        \n    Returns:\n        str: The transformed string.\n    \n    Examples:\n        solve(\"1234\") == \"4321\"\n        solve(\"ab\") == \"AB\"\n        solve(\"#a@C\") == \"#A@c\"\n        solve(\"\") == \"\"\n        solve(\"Hello World!\") == \"hELLO wORLD!\"\n    \"\"\"\n    modified_chars = []\n    has_letters = False\n\n    for char in s:\n        if char.isalpha():\n            modified_chars.append(char.swapcase())\n            has_letters = True\n        else:\n            modified_chars.append(char)\n    \n    if not has_letters:\n        # FR-06: If no alphabetic letters were found, reverse the entire original string\n        return s[::-1]\n    else:\n        # FR-07: Construct and return the final string based on character-wise transformations\n        return \"\".join(modified_chars)"}
{"task_id": "HumanEval/161", "solution": "def solve(s: str) -> str:\n    \"\"\"\n    Transforms a string s based on its content.\n    If s contains any letters, reverses the case of each letter, keeping non-letters as is.\n    If s contains no letters, reverses the entire string.\n    \"\"\"\n    has_letters = False\n    for char in s:\n        if char.isalpha():\n            has_letters = True\n            break\n\n    if has_letters:\n        result_chars = []\n        for char in s:\n            if char.isalpha():\n                result_chars.append(char.swapcase())\n            else:\n                result_chars.append(char)\n        return \"\".join(result_chars)\n    else:\n        return s[::-1]"}
