{"task_id": "Mbpp/7", "solution": "def find_char_long(input_string: str) -> set[str]:\n    \"\"\"\n    Finds all words in the input_string that are at least 4 characters long.\n    \"\"\"\n    long_words = set()\n    words = input_string.split()\n    for word in words:\n        if len(word) >= 4:\n            long_words.add(word)\n    return long_words"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(input_string: str) -> int:\n    \"\"\"\n    Calculates the minimum number of rotations (greater than 0)\n    required to get the same string.\n    \"\"\"\n    n = len(input_string)\n\n    if n == 0:\n        # According to the prompt, do not raise exceptions for edge cases.\n        # An empty string technically cannot be rotated to itself in a positive\n        # number of rotations while remaining non-empty. For practical purposes,\n        # if the input is guaranteed non-empty (as implied by the example \"aaaa\"),\n        # this branch might not be hit. If it is, 0 could be a logical return.\n        # However, if we strictly adhere to \"greater than 0 rotations\", it's undefined.\n        # Given \"aaaa\" == 1, implying n>=1, we can proceed.\n        return 0 # Or handle as per undefined spec; assuming non-empty for problem context.\n\n    if n == 1:\n        return 1\n\n    temp = input_string + input_string\n\n    for k in range(1, n + 1):\n        rotated_string = temp[k : k + n]\n        if rotated_string == input_string:\n            return k"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string: str, char_to_remove: str) -> str:\n    \"\"\"\n    Removes the first and last occurrences of a given character from the string.\n    \"\"\"\n    first_idx = input_string.find(char_to_remove)\n    last_idx = input_string.rfind(char_to_remove)\n\n    if first_idx == -1:\n        return input_string\n\n    if first_idx == last_idx:\n        return input_string[:first_idx] + input_string[first_idx + 1:]\n\n    char_list = list(input_string)\n\n    # Remove the last occurrence first to avoid index shifting issues for the first occurrence\n    del char_list[last_idx]\n\n    # Re-calculate first_idx if it was after the original last_idx, because the list has shrunk\n    if first_idx > last_idx:\n        first_idx -= 1\n\n    del char_list[first_idx]\n\n    return \"\".join(char_list)"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(num1: int, num2: int) -> bool:\n    \"\"\"\n    Checks if two integer numbers differ at exactly one bit position.\n    A number x is a power of 2 if x > 0 and (x & (x - 1)) == 0.\n    \"\"\"\n    xor_result = num1 ^ num2\n    return xor_result > 0 and (xor_result & (xor_result - 1)) == 0"}
{"task_id": "Mbpp/14", "solution": "def find_Volume(base_of_triangle, height_of_triangle, length_of_prism):\n    \"\"\"\n    Calculates the volume of a triangular prism.\n    Volume = (0.5 * base_of_triangle * height_of_triangle) * length_of_prism\n    \"\"\"\n    volume_of_triangle = 0.5 * base_of_triangle * height_of_triangle\n    volume = volume_of_triangle * length_of_prism\n    return volume"}
{"task_id": "Mbpp/19", "solution": "def test_duplicate(nums):\n    \"\"\"\n    Checks if the given list of integers contains any duplicate elements.\n    It leverages a set for efficient duplicate detection.\n    \"\"\"\n    seen = set()\n    for num in nums:\n        if num in seen:\n            return True\n        seen.add(num)\n    return False"}
