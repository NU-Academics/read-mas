{"task_id": "Mbpp/65", "solution": "def recursive_list_sum(input_list: list) -> int | float:\n    \"\"\"\n    Flattens a list and sums all of its numerical elements.\n    Non-numerical elements are ignored.\n    \"\"\"\n    total_sum = 0\n    for element in input_list:\n        if isinstance(element, list):\n            total_sum += recursive_list_sum(element)\n        elif isinstance(element, (int, float)):\n            total_sum += element\n    return total_sum"}
{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    \"\"\"\n    Calculates the Bell number B(n), which is the number of ways to partition a set of 'n' elements.\n    Uses dynamic programming to compute Stirling numbers of the second kind.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input must be a non-negative integer\")\n    if n == 0:\n        return 1\n\n    # Initialize a 2D list for Stirling numbers of the second kind S(i, j)\n    # S[i][j] represents the number of ways to partition a set of i elements into j non-empty subsets\n    stirling_numbers = [[0] * (n + 1) for _ in range(n + 1)]\n\n    # Base case: S(0, 0) = 1 (one way to partition an empty set into zero subsets)\n    stirling_numbers[0][0] = 1\n\n    # Calculate Stirling numbers using the recurrence relation:\n    # S(i, j) = S(i-1, j-1) + j * S(i-1, j)\n    for i in range(1, n + 1):\n        for j in range(1, i + 1):  # j can be at most i\n            stirling_numbers[i][j] = stirling_numbers[i - 1][j - 1] + j * stirling_numbers[i - 1][j]\n\n    # The Bell number B(n) is the sum of S(n, k) for k from 0 to n\n    bell_n = sum(stirling_numbers[n][k] for k in range(n + 1))\n\n    return bell_n"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(array):\n    \"\"\"\n    Checks if the given array is monotonic (either non-decreasing or non-increasing).\n    \"\"\"\n\n    def _is_monotonically_increasing(arr):\n        \"\"\"\n        Checks if the array is in non-decreasing order.\n        \"\"\"\n        for i in range(1, len(arr)):\n            if arr[i] < arr[i - 1]:\n                return False\n        return True\n\n    def _is_monotonically_decreasing(arr):\n        \"\"\"\n        Checks if the array is in non-increasing order.\n        \"\"\"\n        for i in range(1, len(arr)):\n            if arr[i] > arr[i - 1]:\n                return False\n        return True\n\n    return _is_monotonically_increasing(array) or _is_monotonically_decreasing(array)"}
