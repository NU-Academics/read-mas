{"task_id": "Mbpp/18", "solution": "def remove_dirty_chars(main_string: str, dirty_chars_string: str) -> str:\n    \"\"\"Removes characters from the first string that are present in the second string.\"\"\"\n    dirty_chars_set = set(dirty_chars_string)\n    result_chars = []\n    for char in main_string:\n        if char not in dirty_chars_set:\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(num: int) -> bool:\n    \"\"\"\n    Checks if the given number is a Woodall number.\n    A Woodall number is of the form n * 2^n - 1 for some natural number n >= 1.\n    \"\"\"\n    n = 1\n    while True:\n        woodall_candidate = n * (2**n) - 1\n        if woodall_candidate == num:\n            return True\n        elif woodall_candidate > num:\n            return False\n        n += 1"}
