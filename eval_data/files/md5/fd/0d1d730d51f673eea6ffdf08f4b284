{"task_id": "Mbpp/2", "solution": "def similar_elements(list1: 'Iterable[Any]', list2: 'Iterable[Any]') -> 'Set[Any]':\n    \"\"\"Finds and returns elements common to two input iterable collections.\n\n    It converts both iterables to sets and computes their intersection.\n    \"\"\"\n    set1 = set(list1)\n    set2 = set(list2)\n    return set1.intersection(set2)"}
{"task_id": "Mbpp/3", "solution": "import math\n\ndef is_not_prime(number: int) -> bool:\n    \"\"\"\n    Determines if an integer is a non-prime number.\n    Returns True for non-prime numbers, False for prime numbers or numbers less than or equal to 1.\n    \"\"\"\n    if number <= 1:\n        return False\n    if number == 2:\n        return False\n    if number % 2 == 0:\n        return True\n    \n    # Check for odd divisors from 3 up to the square root of the number\n    for i in range(3, int(math.sqrt(number)) + 1, 2):\n        if number % i == 0:\n            return True\n            \n    return False"}
{"task_id": "Mbpp/4", "solution": "import heapq\nfrom typing import List\n\ndef heap_queue_largest(input_list: List[int], n: int) -> List[int]:\n    \"\"\"\n    Finds the n largest integers from a given list of numbers and returns them in descending order.\n    It efficiently uses a min-heap to identify the largest elements.\n    \"\"\"\n    # heapq.nlargest returns elements in descending order by default\n    return heapq.nlargest(n, input_list)"}
