{"task_id": "HumanEval/7", "solution": "from typing import List\n\n\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    filtered_strings = []\n    for s in strings:\n        if substring in s:\n            filtered_strings.append(s)\n    return filtered_strings"}
{"task_id": "HumanEval/6", "solution": "from typing import List\n\n\ndef split_into_groups(paren_string: str) -> List[str]:\n    \"\"\"Trim input and split on one-or-more space characters returning ordered groups.\n    Returns an empty list for empty or whitespace-only input.\n    \"\"\"\n    stripped_string = paren_string.strip()\n    if not stripped_string:\n        return []\n    return stripped_string.split(' ')\n\n\ndef compute_max_depth(group: str) -> int:\n    \"\"\"Scan group left-to-right; increment on '(' and decrement on ')'.\n    Current depth is clamped at 0 to avoid negative running depth on unmatched ')'.\n    Return the maximum observed depth (>= 0).\n    \"\"\"\n    current_depth = 0\n    max_depth = 0\n    for char in group:\n        if char == '(':\n            current_depth += 1\n        elif char == ')':\n            current_depth = max(0, current_depth - 1)\n        max_depth = max(max_depth, current_depth)\n    return max_depth\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    groups = split_into_groups(paren_string)\n    result_depths = [compute_max_depth(group) for group in groups]\n    return result_depths"}
{"task_id": "HumanEval/3", "solution": "from typing import List, Iterator\n\n\nclass Account:\n    \"\"\"Maintains an integer running balance and provides operations to apply amounts and query negative state.\"\"\"\n    def __init__(self) -> None:\n        self.balance: int = 0\n\n    def applyOperation(self, amount: int) -> None:\n        \"\"\"Adds an amount to the current balance.\"\"\"\n        self.balance += amount\n\n    def isBelowZero(self) -> bool:\n        \"\"\"Returns True if the balance is less than zero, False otherwise.\"\"\"\n        return self.balance < 0\n\n\nclass Operation:\n    \"\"\"Represents a single bank account operation with an amount and its sequence index.\"\"\"\n    def __init__(self, amount: int, sequence: int) -> None:\n        self.amount: int = amount\n        self.sequence: int = sequence\n\n\nclass OperationList:\n    \"\"\"Wraps a list of integer operations and provides an iterator over Operation objects.\"\"\"\n    def __init__(self, operations: List[int]) -> None:\n        self.operations: List[int] = operations\n\n    def iterator(self) -> Iterator[Operation]:\n        \"\"\"Yields Operation objects in sequence from the internal list.\"\"\"\n        for i, amount in enumerate(self.operations):\n            yield Operation(amount, i)\n\n\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\"\n    You're given a list of deposit and withdrawal operations on a bank account that starts with\n    zero balance. Your task is to detect if at any point the balance of account fallls below zero, and\n    at that point function should return True. Otherwise it should return False.\n    >>> below_zero([1, 2, 3])\n    False\n    >>> below_zero([1, 2, -4, 5])\n    True\n    \"\"\"\n    account = Account()\n    op_list = OperationList(operations)\n\n    for op in op_list.iterator():\n        account.applyOperation(op.amount)\n        if account.isBelowZero():\n            return True\n\n    return False"}
{"task_id": "HumanEval/2", "solution": "import math\n\n\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    if number < 0.0:\n        raise ValueError(\"negative input not allowed\")\n    return number - math.floor(number)"}
{"task_id": "HumanEval/1", "solution": "from typing import List\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Separates a string of nested parentheses into a list of top-level balanced groups.\n    Ignores spaces in the input string.\n    \"\"\"\n\n    class NormalizedString:\n        \"\"\"Holds normalized value and provides character accessors.\"\"\"\n        def __init__(self, value: str):\n            self.value = value\n\n        def length(self) -> int:\n            return len(self.value)\n\n        def char_at(self, idx: int) -> str:\n            return self.value[idx]\n\n    class InputString:\n        \"\"\"Encapsulates raw input and produces NormalizedString.\"\"\"\n        def __init__(self, raw: str):\n            self.raw = raw\n\n        def trim_spaces(self) -> NormalizedString:\n            \"\"\"Removes space characters from the raw string.\"\"\"\n            normalized_value = self.raw.replace(' ', '')\n            return NormalizedString(normalized_value)\n\n    class ParenthesisGroup:\n        \"\"\"Represents a contiguous top-level group.\"\"\"\n        def __init__(self, value: str, start_index: int, end_index: int):\n            self.value = value\n            self.start_index = start_index\n            self.end_index = end_index\n\n        def depth(self) -> int:\n            \"\"\"Computes the maximum nesting depth within the group's value.\"\"\"\n            max_depth = 0\n            current_depth = 0\n            for char in self.value:\n                if char == '(':\n                    current_depth += 1\n                    max_depth = max(max_depth, current_depth)\n                elif char == ')':\n                    current_depth -= 1\n            return max_depth\n\n    class Parser:\n        \"\"\"Scans NormalizedString and produces top-level ParenthesisGroup instances; validates balance.\"\"\"\n        def __init__(self):\n            pass\n\n        def is_balanced(self, group: ParenthesisGroup) -> bool:\n            \"\"\"Validates if the parenthesis group's value is balanced.\"\"\"\n            balance = 0\n            for char in group.value:\n                if char == '(':\n                    balance += 1\n                elif char == ')':\n                    balance -= 1\n                if balance < 0:\n                    return False  # Unmatched closing parenthesis\n            return balance == 0  # Must end with a zero balance\n\n        def parse_groups(self, ns: NormalizedString) -> List[ParenthesisGroup]:\n            \"\"\"Parses the normalized string into a list of balanced top-level parenthesis groups.\"\"\"\n            groups = []\n            depth = 0\n            start_index = -1\n\n            for i in range(ns.length()):\n                char = ns.char_at(i)\n                if char == '(':\n                    if depth == 0:\n                        start_index = i  # Mark start of a new top-level group\n                    depth += 1\n                elif char == ')':\n                    depth -= 1\n\n                if depth == 0 and start_index != -1:\n                    # End of a top-level group\n                    group_value = ns.value[start_index : i + 1]\n                    new_group = ParenthesisGroup(group_value, start_index, i + 1)\n                    if self.is_balanced(new_group):\n                        groups.append(new_group)\n                    start_index = -1  # Reset for next group\n\n            return groups\n\n    class OutputList:\n        \"\"\"Collects ParenthesisGroup instances and exports the final list of strings.\"\"\"\n        def __init__(self):\n            self.groups: List[ParenthesisGroup] = []\n\n        def append(self, group: ParenthesisGroup) -> None:\n            \"\"\"Appends a ParenthesisGroup to the list.\"\"\"\n            self.groups.append(group)\n\n        def to_string_list(self) -> List[str]:\n            \"\"\"Returns a list of string values from the collected groups.\"\"\"\n            return [group.value for group in self.groups]\n\n    # Orchestration\n    input_str_obj = InputString(paren_string)\n    normalized_str_obj = input_str_obj.trim_spaces()\n\n    parser_obj = Parser()\n    parsed_groups = parser_obj.parse_groups(normalized_str_obj)\n\n    output_list_obj = OutputList()\n    for group in parsed_groups:\n        output_list_obj.append(group)\n\n    return output_list_obj.to_string_list()"}
{"task_id": "HumanEval/0", "solution": "def has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    n = len(numbers)\n    if n < 2:\n        return False\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            if abs(numbers[i] - numbers[j]) < threshold:\n                return True\n    return False"}
{"task_id": "HumanEval/4", "solution": "from typing import List\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\"Calculates the Mean Absolute Deviation (MAD) for a list of numbers around their mean.\n    MAD is the average absolute difference between each element and the dataset's mean.\n    \"\"\"\n\n    class MeanCalculator:\n        def compute_mean(self, numbers: List[float]) -> float:\n            \"\"\"Calculates the arithmetic mean of a list of numbers.\"\"\"\n            return sum(numbers) / len(numbers)\n\n    class AbsDiffCalculator:\n        def compute_abs_diff(self, x: float, mean: float) -> float:\n            \"\"\"Calculates the absolute difference between a value and the mean.\"\"\"\n            return abs(x - mean)\n\n    class MADCalculator:\n        def __init__(self):\n            self.mean_calc = MeanCalculator()\n            self.absdiff_calc = AbsDiffCalculator()\n\n        def compute_mad(self, numbers: List[float]) -> float:\n            \"\"\"Computes the Mean Absolute Deviation (MAD) for a list of numbers.\"\"\"\n            mean_val = self.mean_calc.compute_mean(numbers)\n            absolute_differences = [self.absdiff_calc.compute_abs_diff(x, mean_val) for x in numbers]\n            return sum(absolute_differences) / len(absolute_differences)\n\n    mad_calculator = MADCalculator()\n    return mad_calculator.compute_mad(numbers)"}
{"task_id": "HumanEval/5", "solution": "from typing import List\n\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n    if len(numbers) == 1:\n        return [numbers[0]]\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
