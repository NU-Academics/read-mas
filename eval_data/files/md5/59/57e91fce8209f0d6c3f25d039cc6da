umn).\"\"\"\n        return (self.row, self.column)\n\n    def __eq__(self, other): # For comparison in tests\n        if not isinstance(other, Coordinate):\n            return NotImplemented\n        return self.row == other.row and self.column == other.column\n\n    def __lt__(self, other): # For sorting: primarily by row ascending, secondarily by column descending\n        if not isinstance(other, Coordinate):\n            return NotImplemented\n        if self.row != other.row:\n            return self.row < other.row\n        return self.column > other.column # Descending for column\nclass ResultCoordinates:\n    \"\"\"Collects and manages Coordinate objects, handles sorting.\"\"\"\n    def __init__(self):\n        self._coordinates: list[Coordinate] = []\n\n    def add_coordinate(self, row: int, column: int):\n        \"\"\"Adds a new coordinate to the collection.\"\"\"\n        self._coordinates.append(Coordinate(row, column))\n\n    def sort(self):\n        \"\"\"Sorts the collected coordinates based on specified rules.\"\"\"\n        self._coordinates.sort() # Uses Coordinate's __lt__ for sorting\n\n    def to_list_of_tuples(self) -> list[tuple[int, int]]:\n        \"\"\"Converts the sorted coordinates to a list of tuples.\"\"\"\n        return [coord.to_tuple() for coord in self._coordinates]\ndef get_row(lst, x):\n    \"\"\"\n    You are given a 2 dimensional data, as a nested lists,\n    which is similar to matrix, however, unlike matrices,\n    each row may contain a different number of columns.\n    Given lst, and integer x, find integers x in the list,\n    and return list of tuples, [(x1, y1), (x2, y2) ...] such that\n    each tuple is a coordinate - (row, columns), starting with 0.\n    Sort coordinates initially by rows in ascending order.\n    Also, sort coordinates of the row by columns in descending order.\n    \"\"\"\n    if not lst:\n        return []\n\n    result_coords = ResultCoordinates()\n\n    for row_idx, row_list in enumerate(lst):\n 