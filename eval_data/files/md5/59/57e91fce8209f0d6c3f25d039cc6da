  Finds the strongest extension based on the strength calculation (CAP - SM)\n    and returns a formatted string 'ClassName.StrongestExtensionName'.\n    \"\"\"\n\n    def _calculate_strength(extension_name: str) -> int:\n        \"\"\"Calculates strength as (uppercase count - lowercase count).\"\"\"\n        cap_count = sum(1 for char in extension_name if char.isupper())\n        sm_count = sum(1 for char in extension_name if char.islower())\n        return cap_count - sm_count\n\n    def _find_strongest_extension_name(extensions: list[str]) -> str:\n        \"\"\"Finds the strongest extension, prioritizing earlier entries in case of a tie.\"\"\"\n        if not extensions:\n            return \"\"\n\n        strongest_name = extensions[0]\n        max_strength = _calculate_strength(extensions[0])\n\n        for i in range(1, len(extensions)):\n            current_extension_name = extensions[i]\n            current_strength = _calculate_strength(current_extension_name)\n\n            if current_strength > max_strength:\n                max_strength = current_strength\n                strongest_name = current_extension_name\n\n        return strongest_name\n\n    def _format_result(class_name: str, strongest_extension_name: str) -> str:\n        \"\"\"Formats the result string.\"\"\"\n        return f\"{class_name}.{strongest_extension_name}\"\n\n    if not extensions:\n        return f\"{class_name}.\"\n\n    strongest_extension_name = _find_strongest_extension_name(extensions)\n    return _format_result(class_name, strongest_extension_name)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/155": [{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n