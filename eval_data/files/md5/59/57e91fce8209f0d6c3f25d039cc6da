d(digit.get_value())\n\n        if not odd_digits:\n            return 0\n\n        product = 1\n        for odd_d in odd_digits:\n            product *= odd_d\n\n        return product\ndef digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    For example:\n    digits(1)  == 1\n    digits(4)  == 0\n    digits(235) == 15\n    \"\"\"\n    calculator = OddDigitProductCalculator()\n    return calculator.calculate_product(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/133": [{"task_id": "HumanEval/133", "solution": "import math\ndef sum_squares(lst):\n    \"\"\"You are given a list of numbers.\n    You need to return the sum of squared numbers in the given list,\n    round each element in the list to the upper int(Ceiling) first.\n    Examples:\n    For lst = [1,2,3] the output should be 14\n    For lst = [1,4,9] the output should be 98\n    For lst = [1,3,5,7] the output should be 84\n    For lst = [1.4,4.2,0] the output should be 29\n    For lst = [-2.4,1,1] the output should be 6\n    \"\"\"\n    def _round_to_ceiling(num):\n        \"\"\"Rounds a single number up to its nearest upper integer (ceiling).\"\"\"\n        return math.ceil(num)\n\n    def _square_number(num):\n        \"\"\"Squares a given number.\"\"\"\n        return num * num\n\n    total_sum = 0\n    for number in lst:\n        ceiling_value = _round_to_ceiling(number)\n        squared_value = _square_number(ceiling_value)\n        total_sum += squared_value\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/132": [{"task_id": "HumanEval/132", "solution": "def _is_valid_bracket_sequence(s: str) -> bool:\n    \"\"\"Checks if a string `s` forms a well-formed bracket sequence.\"\"\"\n    stack = []\n    for char in s:\n        if char == '[':\n            stack.append(char)\n        elif char == ']':\n            if not stack:\n                return False\n            stack.pop()\n    return not stack\ndef _has_nested_structure(s: str) -> bool:\n    \"\"\"Checks if a valid bracket sequence `s` contains at least one nested bracket.\"\"\"\n    current_depth = 0\n    for char in s:\n        if char == '[':\n            current_depth += 1\n            if current_depth > 1:\n                return True\n        elif char == ']':\n            current_depth -= 1\n    return False\ndef is_nested(string: str) -> bool:\n    \"\"\"\n    Checks if a string contains a valid subsequence of brackets where at least one bracket is nested.\n    Iterates through all possible subsequences and checks for validity and nesting.\n    \"\"\"\n    n = len(string)\n    # Iterate through all non-empty subsequences using bit manipulation.\n    for i in range(1, 1 << n):\n        subsequence_chars = []\n        for j in range(n):\n            if (i >> j) & 1:  # If the j-th bit is set, include string[j]\n                subsequence_chars.append(string[j])\n        \n        sub = \"\".join(subsequence_chars)\n        \n        # Optimization: The shortest valid and nested bracket sequence is '[[]]' (length 4).\n        if len(sub) < 4:\n            continue\n\n        if _is_valid_bracket_sequence(sub) and _has_nested_structure(sub):\n            return True\n                \n    return False", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["[][][]"]]}], "HumanEval/135": [{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"Returns the largest index of an element which is strictly less than the element immediately preceding it.\n    If no such element exists then return -1.\n    \"\"\"\n    largest_disorder_index = -1\n    for i in range(1, len(arr)):\n        if arr[i] < arr[i-1]:\n            largest_disorder_index = i\n    return largest_disorder_index", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/136": [{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst: list) -> tuple:\n    '''\n    Create a function that returns a tuple (a, b), where 'a' is\n    the largest of negative integers, and 'b' is the smallest\n    of positive integers in a list.\n    If there is no negative or positive integers, return them as None.\n    '''\n    largest_negative = None\n    smallest_positive = None\n\n    for number in lst:\n        if number < 0:\n            if largest_negative is None or number > largest_negative:\n                largest_negative = number\n        elif number > 0:\n            if smallest_positive is None or number < smallest_positive:\n                smallest_positive = number\n\n    return (largest_negative, smallest_positive)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/138": [{"task_id": "HumanEval/138", "solution": "class Number:\n    \"\"\"Represents an integer value and provides utility methods for checking its properties.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def isEven(self) -> bool:\n        \"\"\"Checks if the number is even.\"\"\"\n        return self.value % 2 == 0\n\n    def isPositive(self) -> bool:\n        \"\"\"Checks if the number is positive.\"\"\"\n        return self.value > 0\ndef is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers.\"\"\"\n    if n < 8:\n        return False\n\n    num_obj = Number(n)\n    if not num_obj.isEven():\n        return False\n\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/137": [{"task_id": "HumanEval/137", "solution": "from typing import Any, Union, Type\ndef _parse_string_to_float(s: str) -> float:\n    \"\"\"Converts a string representation of a real number to float, handling both '.' and ',' as decimal separators.\"\"\"\n    if ',' in s:\n        s = s.replace(',', '.')\n    return float(s)\nclass ValueWrapper:\n    \"\"\"Encapsulates an input value, its original type, and its numerical (float) representation for comparison.\"\"\"\n    def __init__(self, value: Any):\n        self._original_value = value\n        self._original_type = type(value)\n\n        if isinstance(value, str):\n            self._numerical_value = _parse_string_to_float(value)\n        elif isinstance(value, (int, float)):\n            self._numerical_value = float(value)\n        else:\n            raise TypeError(\"Input must be an integer, float, or string representing a real number.\")\n\n    def get_numerical_value(self) -> float:\n        \"\"\"Returns the numerical representation of the wrapped value.\"\"\"\n        return self._numerical_value\n\n    def get_original_value(self) -> Any:\n        \"\"\"Returns the original input value as provided.\"\"\"\n        return self._original_value\n\n    def get_original_type(self) -> Type[Any]:\n        \"\"\"Returns the original Python type of the input value.\"\"\"\n        return self._original_type\ndef compare_one(a: Any, b: Any) -> Union[Any, None]:\n    \"\"\"\n    Compares two input values and returns the numerically larger one in its original type,\n    or None if they are numerically equal.\n    \"\"\"\n    wrapper_a = ValueWrapper(a)\n    wrapper_b = ValueWrapper(b)\n\n    num_a = wrapper_a.get_numerical_value()\n    num_b = wrapper_b.get_numerical_value()\n\n    if num_a > num_b:\n        return wrapper_a.get_original_value()\n    elif num_b > num_a:\n        return wrapper_b.get_original_value()\n    else:\n        return None", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/134": [{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Returns True if the last character of a given string is an alphabetical character\n    and is not a part of a word, and False otherwise.\n    A 'word' is a group of characters separated by space.\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    if len(txt) == 1:\n        return True\n    else:\n        char_before_last = txt[-2]\n        if char_before_last.isspace():\n            return True\n        else:\n            return False", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["apple pi\ne"]]}], "HumanEval/140": [{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores, \n    and if a string has more than 2 consecutive spaces, \n    then replace all consecutive spaces with - \n    \n    fix_spaces(\"Example\") == \"Example\"\n    fix_spaces(\"Example 1\") == \"Example_1\"\n    fix_spaces(\" Example 2\") == \"_Example_2\"\n    fix_spaces(\" Example   3\") == \"_Example-3\"\n    \"\"\"\n    # Replace sequences of three or more consecutive spaces with a single hyphen.\n    modified_text = re.sub(r' {3,}', '-', text)\n\n    # Replace any remaining single space character (including those from two consecutive spaces) with an underscore.\n    modified_text = modified_text.replace(' ', '_')\n\n    return modified_text", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/141": [{"task_id": "HumanEval/141", "solution": "class FileName:\n    \"\"\"Encapsulates a file name string and provides parsed components and properties for validation.\"\"\"\n\n    def __init__(self, file_name: str):\n        self._full_name = file_name\n        self._prefix = \"\"\n        self._suffix = \"\"\n        self._digit_count = 0\n        self._dot_count = 0\n        self._split_name()\n        self._count_digits()\n\n    def _split_name(self):\n        \"\"\"Splits the full file name into prefix and suffix based on the dot.\"\"\"\n        self._dot_count = self._full_name.count('.')\n        if self._dot_count == 1:\n            parts = self._full_name.split('.', 1)\n            self._prefix = parts[0]\n            self._suffix = parts[1]\n        else:\n            self._prefix = self._full_name # If no dot or multiple, prefix is full name, suffix is empty\n\n    def _count_digits(self):\n        \"\"\"Counts the total number of digits in the full file name.\"\"\"\n        self._digit_count = sum(1 for char in self._full_name if char.isdigit())\n\n    def get_prefix(self) -> str:\n        \"\"\"Returns the part of the file name before the dot.\"\"\"\n        return self._prefix\n\n    def get_suffix(self) -> str:\n        \"\"\"Returns the part of the file name after the dot (extension).\"\"\"\n        return self._suffix\n\n    def get_digit_count(self) -> int:\n        \"\"\"Returns the total number of digits in the file name.\"\"\"\n        return self._digit_count\n\n    def get_dot_count(self) -> int:\n        \"\"\"Returns the total number of dots in the file name.\"\"\"\n        return self._dot_count\n\n    def starts_with_letter(self) -> bool:\n        \"\"\"Checks if the prefix starts with a Latin alphabet letter.\"\"\"\n        return bool(self._prefix and self._prefix[0].isalpha())\ndef file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions \n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n    - The file's name contains exactly one dot '.'\n    - The substring before the dot should not be empty, and it starts with a letter from \n    the latin alphapet ('a'-'z' and 'A'-'Z').\n    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n