{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(arr, x):\n    \"\"\"\n    Finds the index of the first occurrence of a given number in a sorted array using binary search.\n    Returns the index or -1 if the number is not found.\n    \"\"\"\n    low = 0\n    high = len(arr) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if arr[mid] == x:\n            result = mid\n            high = mid - 1  # Continue searching in the left half for the first occurrence\n        elif arr[mid] < x:\n            low = mid + 1\n        else:\n            high = mid - 1\n            \n    return result"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(input_list: list) -> int:\n    \"\"\"\n    Calculates the sum of products of all contiguous sublists of a given list.\n    Handles an empty list by returning 0.\n    \"\"\"\n    total_sum = 0\n    n = len(input_list)\n\n    for i in range(n):\n        current_product = 1\n        for j in range(i, n):\n            current_product *= input_list[j]\n            total_sum += current_product\n    return total_sum"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(input: int) -> int:\n    \"\"\"\n    Toggles all bits of the number except its least significant bit (LSB) and\n    its most significant set bit (MSB).\n    \"\"\"\n    if input == 0:\n        return 0\n\n    h_pos = input.bit_length() - 1\n\n    # If the number has less than 3 relevant bits, there are no \"middle\" bits to toggle.\n    if h_pos < 2:\n        return input\n\n    middle_mask = 0\n    # Construct a mask with bits set from position 1 up to (h_pos - 1).\n    for i in range(1, h_pos):\n        middle_mask |= (1 << i)\n\n    # XOR the input with the middle_mask to toggle only those bits.\n    return input ^ middle_mask"}
{"task_id": "Mbpp/736", "solution": "from typing import List, TypeVar, Protocol\nT = TypeVar('T', bound=Protocol)\ndef left_insertion(elements: List[T], target: T) -> int:\n    \"\"\"\n    Return the leftmost index at which `target` can be inserted into `elements`\n    while maintaining ascending order.\n    \"\"\"\n    low, high = 0, len(elements)\n    while low < high:\n        mid = (low + high) // 2\n        if elements[mid] < target:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/739", "solution": "import math\ndef find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with at least n digits.\n    \"\"\"\n    if n <= 0:\n        # Though the design context states \"Do NOT add isinstance() checks or raise exceptions for edge cases\"\n        # The design document explicitly mentions \"Validate input and raise ValueError for invalid values.\"\n        # and \"Input Validation: IndexFinder.find_index checks that n is an integer \u2265 1, raising ValueError otherwise.\"\n        # Given this contradiction, I will prioritize the explicit instruction in the \"REQUIREMENTS\" section\n        # to NOT raise exceptions for edge cases, and assume `n` will always be valid (n >= 1).\n        # However, if I were to implement the validation per the design document, it would be:\n        # raise ValueError(\"n must be a positive integer.\")\n        pass # Per requirements to not raise exceptions\n\n    # A triangular number T_k = k * (k + 1) / 2 has 'n' digits if 10^(n-1) <= T_k < 10^n.\n    # We are looking for the smallest k such that T_k >= 10^(n-1).\n    # k * (k + 1) / 2 >= 10^(n-1)\n    # k^2 + k >= 2 * 10^(n-1)\n    # For large k, k^2 approx 2 * 10^(n-1)\n    # So, k approx sqrt(2 * 10^(n-1))\n    \n    # Calculate a lower bound for k to start the search.\n    # 2 * 10^(n-1) is the target value we want T_k to be at least.\n    # Use floor to ensure we start at or before the actual index.\n    lower_bound_k = math.isqrt(2 * (10**(n - 1))) - 2 \n    # Subtracting 2 to be safe, as integer square root might be off by a small margin\n    # and k^2+k is slightly larger than just k^2.\n    \n    # Ensure k starts from at least 1, as triangular numbers are defined for k >= 1.\n    k = max(1, lower_bound_k)\n\n    while True:\n        triangular_number = k * (k + 1) // 2\n        \n        # Check the number of digits.\n        # An integer 'num' has 'd' digits if 10^(d-1) <= num < 10^d.\n        # So, num has 'd' digits if d = floor(log10(num)) + 1.\n        \n        # Optimized digit counting:\n        # For a number to have at least 'n' digits, it must be >= 10^(n-1).\n        if triangular_number >= (10**(n - 1)):\n            return k\n        \n        k += 1"}
