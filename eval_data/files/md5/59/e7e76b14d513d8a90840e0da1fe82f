{"task_id": "Mbpp/61", "solution": "def count_Substrings(input_str: str) -> int:\n    \"\"\"\n    Count the number of contiguous substrings of `input_str` whose sum of digits\n    equals the substring's length.\n    \"\"\"\n    if not input_str:\n        return 0\n\n    for char in input_str:\n        if not char.isdigit():\n            raise ValueError(\"Input string must contain only digit characters (0-9).\")\n\n    count = 0\n    n = len(input_str)\n\n    for i in range(n):\n        current_sum = 0\n        for j in range(i, n):\n            # The current substring is input_str[i : j+1]\n            # Its length is (j - i + 1)\n            # Add the digit at index j to the current sum\n            current_sum += int(input_str[j])\n            \n            current_length = j - i + 1\n            if current_sum == current_length:\n                count += 1\n    return count"}
{"task_id": "Mbpp/63", "solution": "from typing import List, Tuple, Optional\nclass TuplePair:\n    \"\"\"Represents a pair of integers, used as a domain object.\"\"\"\n    def __init__(self, first: int, second: int):\n        self.first = first\n        self.second = second\nclass MaxDifferenceFunction:\n    \"\"\"Calculates the maximum absolute difference from a list of TuplePair objects.\"\"\"\n    def calculate(self, pairs: List[TuplePair]) -> int:\n        max_diff = 0\n        for pair in pairs:\n            diff = abs(pair.first - pair.second)\n            if diff > max_diff:\n                max_diff = diff\n        return max_diff\ndef max_difference(pairs: List[Tuple[int, int]]) -> Optional[int]:\n    \"\"\"\n    Finds the maximum difference between available pairs in the given tuple list.\n    Returns None if the input list is empty, otherwise returns the maximum absolute difference.\n    \"\"\"\n    if not pairs:\n        return None\n\n    tuple_pair_objects = [TuplePair(t[0], t[1]) for t in pairs]\n    calculator = MaxDifferenceFunction()\n    return calculator.calculate(tuple_pair_objects)"}
{"task_id": "Mbpp/64", "solution": "from dataclasses import dataclass\nfrom typing import List, Tuple\nclass SubjectMarksSorter:\n    def sort(self, marks: List[SubjectMark]) -> List[SubjectMark]:\n        \"\"\"Sorts a list of SubjectMark objects by their score in ascending order.\"\"\"\n        return sorted(marks, key=lambda sm: sm.score)\ndef subject_marks(marks: List[Tuple[str, int]]) -> List[Tuple[str, int]]:\n    \"\"\"Sorts a list of tuples by the second value (score) of each tuple.\"\"\"\n    subject_mark_objects = [SubjectMark(subject=s, score=sc) for s, sc in marks]\n    sorter = SubjectMarksSorter()\n    sorted_subject_mark_objects = sorter.sort(subject_mark_objects)\n    sorted_tuples = [(sm.subject, sm.score) for sm in sorted_subject_mark_objects]\n    return sorted_tuples"}
