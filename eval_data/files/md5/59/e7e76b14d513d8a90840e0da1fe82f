{"task_id": "Mbpp/459", "solution": "def remove_uppercase(s: str) -> str:\n    \"\"\"Removes all contiguous uppercase substrings from a string and converts remaining characters to lowercase.\"\"\"\n    result = []\n    i = 0\n    n = len(s)\n\n    while i < n:\n        # Check if the current character is an ASCII uppercase letter\n        if 'A' <= s[i] <= 'Z':\n            # If it is, skip all subsequent contiguous uppercase letters\n            while i < n and 'A' <= s[i] <= 'Z':\n                i += 1\n            continue  # Continue to the next character after the skipped block\n        else:\n            # If not uppercase, convert to lowercase and append to the result\n            result.append(s[i].lower())\n            i += 1\n\n    return ''.join(result)"}
{"task_id": "Mbpp/462", "solution": "def combinations_list(items):\n    \"\"\"\n    Finds all possible combinations (subsets) of elements from a given list,\n    maintaining a specific order for both combinations and their elements.\n    \"\"\"\n    # Start with the empty set, as it is a combination of any list.\n    all_combinations = [[]]\n\n    # Iterate through each element in the input list.\n    for item in items:\n        # Create new combinations by adding the current 'item' to all existing combinations.\n        # The 'item' is prepended to ensure the desired internal order\n        # (e.g., higher indexed elements appearing before lower indexed elements from the original list).\n        new_sets_with_item = []\n        for combo in all_combinations:\n            new_sets_with_item.append([item] + combo)\n        \n        # Extend the main list with these new combinations.\n        # This naturally groups and orders the combinations as required by the assertion.\n        all_combinations.extend(new_sets_with_item)\n\n    return all_combinations"}
