{"task_id": "Mbpp/590", "solution": "import math\nimport cmath\nfrom typing import Tuple\ndef polar_rect(radius: float, angle: float) -> Tuple[Tuple[float, float], complex]:\n    \"\"\"\n    Converts polar coordinates (radius, angle) to rectangular coordinates.\n    Returns a tuple `((magnitude, angle_rect), complex_value)`.\n    \"\"\"\n    complex_value = radius * (math.cos(angle) + 1j * math.sin(angle))\n    magnitude = abs(complex_value)\n    angle_rect = math.atan2(complex_value.imag, complex_value.real)\n    return ((magnitude, angle_rect), complex_value)"}
{"task_id": "Mbpp/589", "solution": "import math\ndef perfect_squares(lower, upper):\n    \"\"\"\n    Finds perfect squares within a given inclusive integer range.\n    \"\"\"\n    start = math.ceil(math.sqrt(lower))\n    end = math.floor(math.sqrt(upper))\n\n    squares = []\n    for i in range(int(start), int(end) + 1):\n        squares.append(i * i)\n\n    return squares"}
{"task_id": "Mbpp/591", "solution": "def swap_List(lst: list) -> list:\n    \"\"\"\n    Return a new list with the first and last elements swapped. The original list is not modified.\n    \"\"\"\n    if len(lst) < 2:\n        return lst.copy()\n    new_lst = lst.copy()\n    new_lst[0], new_lst[-1] = new_lst[-1], new_lst[0]\n    return new_lst"}
{"task_id": "Mbpp/592", "solution": "import math\ndef sum_Of_product(n: int) -> int:\n    \"\"\"\n    Finds the sum of the product of consecutive binomial coefficients C(n,k) * C(n,k+1).\n    This uses the identity C(2n, n-1) or C(2n, n+1).\n    \"\"\"\n    if n == 0:\n        return 0\n    return math.comb(2 * n, n - 1)"}
{"task_id": "Mbpp/593", "solution": "def removezero_ip(ip_address):\n    \"\"\"\n    Removes leading zeroes from each octet of an IPv4 address string.\n    The function assumes valid IPv4 format as input.\n    \"\"\"\n    octets = ip_address.split('.')\n    cleaned_octets = [str(int(octet)) for octet in octets]\n    cleaned_ip = '.'.join(cleaned_octets)\n    return (cleaned_ip,)"}
{"task_id": "Mbpp/594", "solution": "from typing import List\ndef diff_even_odd(numbers: List[int]) -> int:\n    \"\"\"\n    Finds the difference of the first even and first odd number in a list.\n    Raises TypeError if input is not a list of integers, or ValueError if an even or odd number is not found.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list of integers\")\n    if any(not isinstance(n, int) for n in numbers):\n        raise TypeError(\"Input must be a list of integers\")\n\n    first_even = None\n    first_odd = None\n\n    for n in numbers:\n        if first_even is None and n % 2 == 0:\n            first_even = n\n        elif first_odd is None and n % 2 != 0:\n            first_odd = n\n        if first_even is not None and first_odd is not None:\n            break\n\n    if first_even is None:\n        raise ValueError(\"No even number found\")\n    if first_odd is None:\n        raise ValueError(\"No odd number found\")\n\n    return first_even - first_odd"}
{"task_id": "Mbpp/597", "solution": "def find_kth(a, b, k):\n    \"\"\"\n    Finds the kth smallest element from two sorted arrays using a binary search approach.\n    Assumes arrays are sorted and k is 1-indexed and within valid bounds.\n    \"\"\"\n    m, n = len(a), len(b)\n\n    # Ensure array 'a' is the smaller one for optimization\n    if m > n:\n        a, b = b, a\n        m, n = n, m\n\n    # Binary search range for the partition point in array 'a'\n    low, high = max(0, k - n), min(k, m)\n\n    while low <= high:\n        partition_a = (low + high) // 2\n        partition_b = k - partition_a\n\n        # Determine elements around the partitions\n        # If partition_a is 0, then no elements from 'a' are taken on the left side\n        # If partition_a is m, then all elements from 'a' are taken on the left side\n        max_left_a = float('-inf') if partition_a == 0 else a[partition_a - 1]\n        min_right_a = float('inf') if partition_a == m else a[partition_a]\n\n        max_left_b = float('-inf') if partition_b == 0 else b[partition_b - 1]\n        min_right_b = float('inf') if partition_b == n else b[partition_b]\n\n        if max_left_a <= min_right_b and max_left_b <= min_right_a:\n            # We found the correct partition\n            return max(max_left_a, max_left_b)\n        elif max_left_a > min_right_b:\n            # We are too far right in array 'a', need to move left\n            high = partition_a - 1\n        else: # max_left_b > min_right_a\n            # We are too far left in array 'a', need to move right\n            low = partition_a + 1"}
