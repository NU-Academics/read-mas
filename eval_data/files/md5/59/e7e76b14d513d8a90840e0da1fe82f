{"task_id": "Mbpp/139", "solution": "import math\nclass MathUtility:\n    \"\"\"Utility class to provide mathematical constants.\"\"\"\n    @staticmethod\n    def pi():\n        return math.pi\nclass Circle:\n    \"\"\"Represents a circle with a given radius.\"\"\"\n    def __init__(self, radius: float):\n        self.radius = radius\n\n    def circumference(self) -> float:\n        \"\"\"Calculates the circumference of the circle.\"\"\"\n        return 2 * MathUtility.pi() * self.radius\ndef circle_circumference(radius: float) -> float:\n    \"\"\"\n    Calculates the circumference of a circle given its radius.\n    \"\"\"\n    circle = Circle(radius)\n    return circle.circumference()"}
{"task_id": "Mbpp/141", "solution": "def pancake_sort(elements):\n    \"\"\"\n    Sorts a list of elements using the pancake sort algorithm.\n    Returns a new sorted list, leaving the original list unmodified.\n    \"\"\"\n    arr = list(elements)  # Create a shallow copy to ensure immutability\n\n    n = len(arr)\n    if n <= 1:\n        return arr\n\n    for current_size in range(n, 1, -1):\n        # Find the index of the maximum element in the unsorted prefix arr[0...current_size-1]\n        max_val_idx = 0\n        for i in range(1, current_size):\n            if arr[i] > arr[max_val_idx]:\n                max_val_idx = i\n\n        # If the maximum element is not already at its correct final position\n        if max_val_idx != current_size - 1:\n            # First, flip the sub-array from 0 to max_val_idx to bring the max element to the beginning\n            arr[:max_val_idx + 1] = arr[:max_val_idx + 1][::-1]\n\n            # Second, flip the sub-array from 0 to current_size-1 to move the max element to its sorted position\n            arr[:current_size] = arr[:current_size][::-1]\n\n    return arr"}
