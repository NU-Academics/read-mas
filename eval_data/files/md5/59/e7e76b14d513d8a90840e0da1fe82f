{"task_id": "Mbpp/463", "solution": "from typing import List\ndef max_subarray_product(arr: List[int]) -> int:\n    \"\"\"\n    Finds the maximum product of a contiguous subarray within the given array.\n    Handles negative numbers and zeros efficiently in O(n) time.\n    \"\"\"\n    if not arr:\n        return 0\n\n    max_prod = min_prod = result = arr[0]\n\n    for num in arr[1:]:\n        # If current number is negative, swap max_prod and min_prod\n        # because multiplying by a negative will reverse their roles.\n        if num < 0:\n            max_prod, min_prod = min_prod, max_prod\n\n        # Update max_prod: it's either the number itself or number times current max_prod.\n        max_prod = max(num, max_prod * num)\n        # Update min_prod: it's either the number itself or number times current min_prod.\n        min_prod = min(num, min_prod * num)\n\n        # Update overall maximum product found so far.\n        result = max(result, max_prod)\n\n    return result"}
{"task_id": "Mbpp/468", "solution": "from typing import List\ndef max_product(numbers: List[int]) -> int:\n    \"\"\"\n    Finds the maximum product formed by multiplying numbers of an increasing subsequence of that array.\n    This implicitly refers to contiguous increasing subarrays based on the provided assert.\n    \"\"\"\n    if not numbers:\n        return 0\n\n    max_overall_product = numbers[0]\n    current_product_ending_here = numbers[0]\n\n    for i in range(1, len(numbers)):\n        if numbers[i] > numbers[i-1]:\n            # If the current product accumulated zero (due to an intermediate zero),\n            # and the current number is positive, start a new product sequence with the current number.\n            # Otherwise, extend the current product.\n            if current_product_ending_here == 0 and numbers[i] > 0:\n                current_product_ending_here = numbers[i]\n            else:\n                current_product_ending_here *= numbers[i]\n        else:\n            # Sequence is broken or current number is not greater.\n            # Start a new product sequence with the current number.\n            current_product_ending_here = numbers[i]\n        \n        max_overall_product = max(max_overall_product, current_product_ending_here)\n\n    return max_overall_product"}
{"task_id": "Mbpp/470", "solution": "from typing import Tuple\ndef add_pairwise(input_tuple: Tuple[int, ...]) -> Tuple[int, ...]:\n    \"\"\"\n    Calculates the pairwise sum of neighboring elements in a tuple.\n    \"\"\"\n    if len(input_tuple) < 2:\n        return ()\n    \n    return tuple(input_tuple[i] + input_tuple[i+1] for i in range(len(input_tuple) - 1))"}
{"task_id": "Mbpp/471", "solution": "from typing import List\ndef find_remainder(array: List[int], n: int) -> int:\n    \"\"\"\n    Return the product of all elements in `array` modulo `n`.\n    Raises ValueError if `n` is zero.\n    \"\"\"\n    if n == 0:\n        raise ValueError(\"Modulus divisor 'n' must be non\u2011zero.\")\n\n    product = 1\n    for value in array:\n        product = (product * value) % n\n\n    return product % n"}
{"task_id": "Mbpp/472", "solution": "def check_Consecutive(numbers):\n    \"\"\"Checks if a given list of numbers contains a consecutive sequence.\"\"\"\n    if not numbers:\n        return True\n\n    for i in range(1, len(numbers)):\n        if numbers[i] != numbers[i-1] + 1:\n            return False\n    return True"}
{"task_id": "Mbpp/473", "solution": "def tuple_intersection(list1, list2):\n    \"\"\"\n    Finds the intersection of elements in two tuple lists, treating tuples as unordered pairs.\n    Each tuple (a, b) is normalized to (min(a, b), max(a, b)) before comparison.\n    \"\"\"\n    set1_normalized = set()\n    for tpl in list1:\n        set1_normalized.add(tuple(sorted(tpl)))\n\n    set2_normalized = set()\n    for tpl in list2:\n        set2_normalized.add(tuple(sorted(tpl)))\n\n    return set1_normalized.intersection(set2_normalized)"}
