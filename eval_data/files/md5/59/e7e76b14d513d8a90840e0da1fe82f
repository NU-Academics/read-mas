{"task_id": "Mbpp/763", "solution": "from typing import Tuple\ndef find_min_diff(elements: Tuple[int, ...], n: int) -> int:\n    \"\"\"\n    Finds the minimum absolute difference between any two elements in the given array.\n    Assumes valid input: `elements` is a tuple of integers with at least two elements,\n    and `n` is its length.\n    \"\"\"\n    sorted_elements = sorted(elements)\n    min_diff = float('inf')\n    for i in range(1, len(sorted_elements)):\n        min_diff = min(min_diff, abs(sorted_elements[i] - sorted_elements[i - 1]))\n    return min_diff"}
{"task_id": "Mbpp/766", "solution": "from typing import List, Any, Tuple\ndef pair_wise(input_list: List[Any]) -> List[Tuple[Any, Any]]:\n    \"\"\"\n    Return a list of tuples containing consecutive items from input_list.\n    Handles lists shorter than two elements by returning an empty list.\n    \"\"\"\n    if len(input_list) < 2:\n        return []\n\n    result: List[Tuple[Any, Any]] = []\n    for i in range(len(input_list) - 1):\n        result.append((input_list[i], input_list[i + 1]))\n\n    return result"}
{"task_id": "Mbpp/765", "solution": "def is_power_of_two(x: int) -> bool:\n    \"\"\"Checks if a number is a power of two.\"\"\"\n    return x > 0 and (x & (x - 1)) == 0\ndef is_polite(n: int) -> int:\n    \"\"\"Finds the nth polite number.\"\"\"\n    count = 0\n    current_num = 0\n    while count < n:\n        current_num += 1\n        if not is_power_of_two(current_num):\n            count += 1\n    return current_num"}
{"task_id": "Mbpp/767", "solution": "from typing import List\ndef get_pairs_count(numbers: List[int], target: int) -> int:\n    \"\"\"\n    Counts the number of unordered pairs in a list whose sum equals a given target.\n    Each unique pair of indices (i, j) with i < j is considered.\n    \"\"\"\n    count = 0\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if numbers[i] + numbers[j] == target:\n                count += 1\n    return count"}
{"task_id": "Mbpp/770", "solution": "from typing import List\nclass OddNumberSequence:\n    def __init__(self, n: int):\n        self.n = n\n\n    def generate(self) -> List[int]:\n        return [2 * i + 1 for i in range(self.n)]\nclass PowerCalculator:\n    @staticmethod\n    def fourth_power(x: int) -> int:\n        return x ** 4\nclass SumCalculator:\n    @staticmethod\n    def sum_of_powers(numbers: List[int]) -> int:\n        return sum(numbers)\ndef odd_num_sum(n: int) -> int:\n    \"\"\"\n    Compute the sum of the fourth powers of the first n odd natural numbers.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n\n    odd_seq = OddNumberSequence(n)\n    odds = odd_seq.generate()\n\n    powers = [PowerCalculator.fourth_power(x) for x in odds]\n    return SumCalculator.sum_of_powers(powers)"}
{"task_id": "Mbpp/771", "solution": "def check_expression(expression: str) -> bool:\n    \"\"\"\n    Checks if the given expression has balanced parentheses, brackets, and braces.\n    Uses a stack-based algorithm with O(n) time and space complexity.\n    \"\"\"\n    stack = []\n    matching = {')': '(', ']': '[', '}': '{'}\n    opening_brackets = set(matching.values())\n    closing_brackets = set(matching.keys())\n\n    for char in expression:\n        if char in opening_brackets:\n            stack.append(char)\n        elif char in closing_brackets:\n            if not stack or stack.pop() != matching[char]:\n                return False\n        else:\n            # Character is not a valid bracket type\n            return False\n\n    return not stack"}
{"task_id": "Mbpp/772", "solution": "def remove_length(input_string: str, k: int) -> str:\n    \"\"\"Removes all words of length k from the given string.\"\"\"\n    words = input_string.split()\n    filtered_words = [word for word in words if len(word) != k]\n    return ' '.join(filtered_words)"}
{"task_id": "Mbpp/773", "solution": "from typing import Optional, Tuple\ndef occurance_substring(target: str, sub: str) -> Optional[Tuple[str, int, int]]:\n    \"\"\"\n    Finds the first occurrence and position of a substring within a string.\n    Returns None if there is no match.\n    \"\"\"\n    start_index = target.find(sub)\n    if start_index == -1:\n        return None\n    \n    end_index = start_index + len(sub)\n    return (sub, start_index, end_index)"}
{"task_id": "Mbpp/769", "solution": "from typing import List\nclass ListDifference:\n    \"\"\"\n    Helper class to compute the difference between two lists.\n    It identifies elements present in list1 but not in list2, preserving relative order.\n    \"\"\"\n    def __init__(self, list1: List[int], list2: List[int]):\n        self.list1 = list1\n        self.list2 = list2\n\n    def compute(self) -> List[int]:\n        \"\"\"\n        Computes the list difference.\n        Elements from list1 that are not in list2 are returned, maintaining their original order.\n        \"\"\"\n        set_list2 = set(self.list2)\n        result = []\n        for item in self.list1:\n            if item not in set_list2:\n                result.append(item)\n        return result\ndef Diff(list1: List[int], list2: List[int]) -> List[int]:\n    \"\"\"\n    Calculates the difference between two lists, returning elements in list1 not in list2.\n    Preserves the relative order of elements from list1.\n    \"\"\"\n    list_difference_calculator = ListDifference(list1, list2)\n    return list_difference_calculator.compute()"}
{"task_id": "Mbpp/775", "solution": "def odd_position(lst):\n    \"\"\"\n    Checks if every odd-indexed element in a list is an odd number.\n    Returns False if any odd-indexed element is not an integer or is an even number.\n    \"\"\"\n    for i, num in enumerate(lst):\n        if i % 2 != 0:  # If the index is odd\n            if not isinstance(num, int) or num % 2 == 0:  # If the element is not an int or is even\n                return False\n    return True"}
{"task_id": "Mbpp/777", "solution": "from typing import List\ndef find_sum(lst: List[int]) -> int:\n    \"\"\"\n    Returns the sum of distinct integers in the provided list.\n    The input list is not modified.\n    \"\"\"\n    unique_values = set(lst)\n    return sum(unique_values)"}
{"task_id": "Mbpp/778", "solution": "from typing import List, Any\ndef pack_consecutive_duplicates(lst: List[Any]) -> List[List[Any]]:\n    \"\"\"Return a list of sub\u2011lists grouping consecutive duplicates.\"\"\"\n    if not lst:\n        return []\n\n    result: List[List[Any]] = []\n    current_sublist: List[Any] = [lst[0]]\n\n    for elem in lst[1:]:\n        if elem == current_sublist[-1]:\n            current_sublist.append(elem)\n        else:\n            result.append(current_sublist)\n            current_sublist = [elem]\n\n    result.append(current_sublist)\n    return result"}
{"task_id": "Mbpp/780", "solution": "from typing import List, Tuple\ndef find_combinations(tuples: List[Tuple[int, ...]]) -> List[Tuple[int, ...]]:\n    \"\"\"\n    Compute all unique pairwise element-wise sums of the input tuples.\n    The order follows the input tuple ordering, and duplicate sums are omitted.\n    \"\"\"\n    if len(tuples) < 2:\n        return []\n\n    result: List[Tuple[int, ...]] = []\n    seen: set[Tuple[int, ...]] = set()\n\n    for i in range(len(tuples)):\n        for j in range(i + 1, len(tuples)):\n            sum_tuple = tuple(a + b for a, b in zip(tuples[i], tuples[j]))\n            if sum_tuple not in seen:\n                seen.add(sum_tuple)\n                result.append(sum_tuple)\n\n    return result"}
{"task_id": "Mbpp/781", "solution": "def count_divisors(n: int) -> bool:\n    \"\"\"\n    Checks if the count of positive divisors for an integer n is even.\n    Returns False for non-positive integers as per design specification.\n    \"\"\"\n    if n <= 0:\n        return False\n\n    count = 0\n    # Iterate from 1 up to the square root of n\n    # For performance, n**0.5 is preferred over math.isqrt or math.sqrt\n    # to avoid importing math for a single, simple operation.\n    limit = int(n**0.5)\n    for i in range(1, limit + 1):\n        if n % i == 0:\n            if i * i == n:  # i is a perfect square root of n\n                count += 1\n            else:  # i and n // i are distinct divisors\n                count += 2\n    \n    return count % 2 == 0"}
{"task_id": "Mbpp/784", "solution": "from typing import List\ndef mul_even_odd(numbers: List[int]) -> int:\n    \"\"\"Return the product of the first even and first odd numbers in the list.\"\"\"\n    first_even = None\n    first_odd = None\n    for num in numbers:\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n        if first_even is not None and first_odd is not None:\n            break\n    return first_even * first_odd"}
{"task_id": "Mbpp/782", "solution": "from typing import List\ndef odd_length_sum(values: List[int]) -> int:\n    \"\"\"\n    Compute the sum of all odd\u2011length subarrays of the input list.\n    \"\"\"\n    total_sum = 0\n    n = len(values)\n\n    for start in range(n):\n        current_sum = 0\n        for end in range(start, n):\n            current_sum += values[end]\n            length = end - start + 1\n            if length % 2 == 1:\n                total_sum += current_sum\n\n    return total_sum"}
{"task_id": "Mbpp/785", "solution": "import re\nfrom typing import Tuple\n_TUPLE_PATTERN = re.compile(r\"\"\"\n    ^\\s*                      # Optional leading whitespace\n    \\(\\s*                     # Opening parenthesis\n    (?P<values>               # Capture group for the values\n        (?:-?\\d+\\s*,\\s*)*     # Zero or more integers followed by commas\n        -?\\d+                 # Final integer (no trailing comma)\n    )\n    \\s*\\)\\s*$                 # Closing parenthesis and optional trailing whitespace\n\"\"\", re.VERBOSE)\ndef tuple_str_int(tuple_str: str) -> Tuple[int, ...]:\n    \"\"\"\n    Parse a string representation of a tuple of integers and return a tuple.\n    Raises ValueError for invalid input.\n    \"\"\"\n    if not isinstance(tuple_str, str):\n        raise ValueError(\"Input must be a string.\")\n\n    match = _TUPLE_PATTERN.match(tuple_str)\n    if not match:\n        raise ValueError(f\"Invalid tuple string: {tuple_str!r}\")\n\n    values_str = match.group(\"values\")\n    try:\n        values = tuple(int(v.strip()) for v in values_str.split(\",\"))\n    except ValueError as exc:\n        raise ValueError(f\"Non-integer value in tuple string: {tuple_str!r}\") from exc\n\n    return values"}
{"task_id": "Mbpp/786", "solution": "from typing import List\ndef right_insertion(list: List[int], value: int) -> int:\n    \"\"\"\n    Locates the right insertion point for a specified value in a sorted list.\n    This is equivalent to `bisect_right` or `bisect.bisect`.\n    \"\"\"\n    low = 0\n    high = len(list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if list[mid] <= value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/787", "solution": "class TextMatcher:\n    \"\"\"Encapsulates the logic for matching specific text patterns.\"\"\"\n    def match_three(self, input_string: str) -> bool:\n        \"\"\"Checks if the input string contains the substring \"abbb\".\"\"\"\n        return \"abbb\" in input_string\ndef text_match_three(text: str) -> bool:\n    \"\"\"\n    Matches a string that has an 'a' followed by three 'b's.\n    e.g., \"abbb\".\n    \"\"\"\n    matcher = TextMatcher()\n    return matcher.match_three(text)"}
