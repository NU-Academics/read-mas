{"task_id": "Mbpp/644", "solution": "from typing import List\ndef reverse_Array_Upto_K(array: List[int], k: int) -> List[int]:\n    \"\"\"\n    Reverses the first k elements of an array and returns a new array.\n    The original array is not modified.\n    \"\"\"\n    n = len(array)\n    # Calculate the actual number of elements to reverse, ensuring it's non-negative and within array bounds.\n    elements_to_reverse_count = max(0, min(k, n))\n\n    # Split the array into the part to be reversed and the remaining part.\n    prefix = array[:elements_to_reverse_count]\n    suffix = array[elements_to_reverse_count:]\n\n    # Reverse the prefix and concatenate it with the suffix.\n    return prefix[::-1] + suffix"}
{"task_id": "Mbpp/721", "solution": "import math\ndef maxAverageOfPath(matrix: list[list[int]]) -> float:\n    \"\"\"\n    Calculates the maximum average cost of a path from the top-left to the bottom-right\n    cell in a square matrix, moving only right or down.\n    \"\"\"\n    N = len(matrix)\n\n    def check(target_avg: float) -> bool:\n        # dp[r][c] stores the maximum sum of (cell_cost - target_avg) to reach (r, c).\n        # If this sum is non-negative for the bottom-right cell, then target_avg is achievable.\n        dp = [[0.0] * N for _ in range(N)]\n\n        # Initialize the top-left cell's dp value\n        dp[0][0] = matrix[0][0] - target_avg\n\n        # Fill the first row: a path can only come from the left\n        for c in range(1, N):\n            dp[0][c] = dp[0][c-1] + (matrix[0][c] - target_avg)\n\n        # Fill the first column: a path can only come from above\n        for r in range(1, N):\n            dp[r][0] = dp[r-1][0] + (matrix[r][0] - target_avg)\n\n        # Fill the rest of the dp table\n        # For each cell, the path can come from above (r-1, c) or from the left (r, c-1).\n        # We take the maximum of these two paths to maximize the sum of (cost - target_avg).\n        for r in range(1, N):\n            for c in range(1, N):\n                dp[r][c] = (matrix[r][c] - target_avg) + max(dp[r-1][c], dp[r][c-1])\n        \n        # The maximum average path exists if the max sum to reach the bottom-right cell is non-negative.\n        return dp[N-1][N-1] >= 0\n\n    # Determine the search range for the binary search.\n    # The maximum average must be between the minimum and maximum individual cell costs.\n    min_cost = float(matrix[0][0])\n    max_cost = float(matrix[0][0])\n    for r in range(N):\n        for c in range(N):\n            min_cost = min(min_cost, float(matrix[r][c]))\n            max_cost = max(max_cost, float(matrix[r][c]))\n\n    low = min_cost\n    high = max_cost\n\n    # Perform binary search for a fixed number of iterations to find the maximum average.\n    # 100 iterations typically provide sufficient precision for floating-point results.\n    for _ in range(100):\n        mid = (low + high) / 2.0\n        if check(mid):\n            low = mid  # An average of 'mid' is achievable, try for a higher average\n        else:\n            high = mid # An average of 'mid' is not achievable, reduce the upper bound\n            \n    # 'low' will contain the maximum achievable average after convergence.\n    return low"}
{"task_id": "Mbpp/723", "solution": "from typing import List\ndef count_same_pair(list1: List[int], list2: List[int]) -> int:\n    \"\"\"\n    Counts indices where two lists have the same values.\n\n    Raises ValueError if lists are of unequal length.\n    \"\"\"\n    if len(list1) != len(list2):\n        raise ValueError(\"Input lists must be of the same length.\")\n\n    count = 0\n    for i in range(len(list1)):\n        if list1[i] == list2[i]:\n            count += 1\n    return count"}
