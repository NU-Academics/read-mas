{"task_id": "Mbpp/759", "solution": "def is_decimal(value: str) -> bool:\n    \"\"\"Checks if a string represents a decimal number with exactly two decimal places.\"\"\"\n    # 1. Non-empty string and no leading/trailing whitespace.\n    if not value or value.strip() != value:\n        return False\n\n    # 2. Exactly one decimal point.\n    if value.count('.') != 1:\n        return False\n\n    parts = value.split('.')\n    integer_part = parts[0]\n    decimal_part = parts[1]\n\n    # 4. Two digits after the decimal point.\n    if len(decimal_part) != 2:\n        return False\n\n    # 5. Only digits, an optional leading sign, and the decimal point are present.\n    # Check decimal part: must be exactly two digits.\n    if not decimal_part.isdigit():\n        return False\n\n    # Check integer part: can have an optional leading sign, followed by one or more digits.\n    if not integer_part:\n        # If integer part is empty (e.g., \".12\"), it's not considered valid here.\n        return False\n\n    if integer_part[0] == '+' or integer_part[0] == '-':\n        # Has a leading sign\n        signed_digits = integer_part[1:]\n        # Must have at least one digit after the sign\n        if not signed_digits or not signed_digits.isdigit():\n            return False\n    else:\n        # No leading sign\n        # Must consist of only digits\n        if not integer_part.isdigit():\n            return False\n\n    return True"}
{"task_id": "Mbpp/758", "solution": "from typing import List, Any, Dict, Tuple\ndef unique_sublists(input_list: List[List[Any]]) -> Dict[Tuple[Any, ...], int]:\n    \"\"\"\n    Counts the occurrences of sublists within a list, returning a dictionary\n    where sublists are converted to tuples and mapped to their counts.\n    \"\"\"\n    counts = {}\n    for sublist in input_list:\n        sublist_as_tuple = tuple(sublist)\n        counts[sublist_as_tuple] = counts.get(sublist_as_tuple, 0) + 1\n    return counts"}
{"task_id": "Mbpp/757", "solution": "from typing import List\ndef count_reverse_pairs(strings: List[str]) -> int:\n    \"\"\"Return the number of distinct reverse string pairs in *strings*.\n\n    Empty strings are ignored, and pairing is case-sensitive.\n    \"\"\"\n    freq = {}\n    for s in strings:\n        if s:\n            freq[s] = freq.get(s, 0) + 1\n\n    count = 0\n    seen = set()\n    for s, s_count in freq.items():\n        if s in seen:\n            continue\n\n        rev = s[::-1]\n        if rev in freq:\n            # A string cannot pair with itself if it's its own reverse\n            if s == rev:\n                continue\n            \n            # Each occurrence of s can pair with each occurrence of rev\n            count += s_count * freq[rev]\n            seen.add(s)\n            seen.add(rev)\n    return count"}
