{"task_id": "Mbpp/261", "solution": "def division_elements(tuple1: tuple[int], tuple2: tuple[int]) -> tuple[int]:\n    \"\"\"Performs element-wise floor division on two tuples of integers.\n    Raises ValueError for length mismatch and ZeroDivisionError for division by zero.\"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Input tuples must have the same length.\")\n\n    results = []\n    for i in range(len(tuple1)):\n        numerator = tuple1[i]\n        divisor = tuple2[i]\n        if divisor == 0:\n            raise ZeroDivisionError(\"Cannot divide by zero.\")\n        results.append(numerator // divisor)\n\n    return tuple(results)"}
{"task_id": "Mbpp/260", "solution": "import math\ndef _is_prime(num: int) -> bool:\n    \"\"\"Checks if a number is prime.\"\"\"\n    if num < 2:\n        return False\n    if num == 2:\n        return True\n    if num % 2 == 0:\n        return False\n    i = 3\n    while i * i <= num:\n        if num % i == 0:\n            return False\n        i += 2\n    return True\nclass PrimeGenerator:\n    \"\"\"Generates and caches primes following the 3*2^k +/- 1 rule.\"\"\"\n    _instance = None\n\n    def __new__(cls):\n        if cls._instance is None:\n            cls._instance = super(PrimeGenerator, cls).__new__(cls)\n            cls._instance._cache = []\n            cls._instance._current_k = -1\n            cls._instance._k_candidates = []\n            cls._instance._current_power_of_2 = 1\n        return cls._instance\n\n    def _generate_next_prime_candidate(self) -> int:\n        \"\"\"Produces the next candidate number from the 3*2^k +/- 1 sequence.\"\"\"\n        if not self._k_candidates:\n            self._current_k += 1\n            if self._current_k == 0:\n                self._current_power_of_2 = 1\n            else:\n                self._current_power_of_2 *= 2\n            \n            val_minus_1 = 3 * self._current_power_of_2 - 1\n            val_plus_1 = 3 * self._current_power_of_2 + 1\n            \n            self._k_candidates.append(val_minus_1)\n            self._k_candidates.append(val_plus_1)\n            \n        return self._k_candidates.pop(0)\n\n    def _generate_next_nsw_prime(self):\n        \"\"\"Finds the next prime from the sequence and adds it to the cache.\"\"\"\n        while True:\n            candidate = self._generate_next_prime_candidate()\n            if _is_prime(candidate):\n                self._cache.append(candidate)\n                break\n\n    def nthPrime(self, n: int) -> int:\n        \"\"\"Returns the nth prime generated by the sequence.\"\"\"\n        while len(self._cache) < n:\n            self._generate_next_nsw_prime()\n        return self._cache[n - 1]\n_nsw_prime_generator = PrimeGenerator()\ndef newman_prime(n: int) -> int:\n    \"\"\"Finds the nth newman\u2013shanks\u2013williams prime number.\"\"\"\n    return _nsw_prime_generator.nthPrime(n)"}
