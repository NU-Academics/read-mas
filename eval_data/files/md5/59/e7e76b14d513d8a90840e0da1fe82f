{"task_id": "Mbpp/305", "solution": "from typing import List, Tuple\ndef start_withp(strings: List[str]) -> Tuple[str, str]:\n    \"\"\"\n    Extracts the first two words that start with 'p' (case\u2011insensitive) from a list of strings.\n    Raises ValueError if fewer than two such words are found.\n    \"\"\"\n    matches = []\n    for s in strings:\n        for word_text in s.split():\n            if word_text.lower().startswith('p'):\n                matches.append(word_text)\n                if len(matches) == 2:\n                    return tuple(matches)\n    raise ValueError(\"Less than two words starting with 'p' found.\")"}
{"task_id": "Mbpp/306", "solution": "import math\ndef max_sum_increasing_subseq(arr: list[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Computes the maximum sum of an increasing subsequence ending at or before index i,\n    and including the element at index k, where k > i.\n    \"\"\"\n    if k >= n or i >= n or k <= i:\n        return 0\n\n    # dp[j] stores the maximum sum of an increasing subsequence ending at index j\n    dp = [0] * (i + 1)\n    \n    # Initialize dp values for the prefix up to index i\n    for j in range(i + 1):\n        dp[j] = arr[j]\n        for x in range(j):\n            if arr[x] < arr[j]:\n                dp[j] = max(dp[j], dp[x] + arr[j])\n\n    # Find the maximum sum from dp array for elements less than arr[k]\n    max_prefix_sum = 0\n    for j in range(i + 1):\n        if arr[j] < arr[k]:\n            max_prefix_sum = max(max_prefix_sum, dp[j])\n\n    if max_prefix_sum == 0 and arr[k] not in arr[:i+1]: # No element in prefix can precede arr[k]\n        return 0 # Since arr[k] must be included, and nothing can precede it, and arr[k] not in prefix, it's 0\n\n    return max_prefix_sum + arr[k]"}
