{"task_id": "Mbpp/745", "solution": "def divisible_by_digits(startnum: int, endnum: int) -> list[int]:\n    \"\"\"\n    Finds numbers within a given range where every number is divisible by every digit it contains.\n    \"\"\"\n\n    def _is_divisible_by_its_digits(number: int) -> bool:\n        \"\"\"\n        Checks if a given number is divisible by each of its non-zero digits.\n        \"\"\"\n        s_number = str(number) # Convert number to string to easily iterate through its digits\n        \n        for char_digit in s_number:\n            digit = int(char_digit)\n            \n            if digit == 0: # A number cannot be divisible by zero\n                return False\n            \n            if number % digit != 0: # Check if the number is divisible by the current digit\n                return False\n        \n        return True # If all digits (non-zero) successfully divide the number\n\n    result = []\n    for num in range(startnum, endnum + 1): # Iterate through the numbers in the given range (inclusive)\n        if _is_divisible_by_its_digits(num):\n            result.append(num)\n            \n    return result"}
{"task_id": "Mbpp/742", "solution": "import math\nclass Tetrahedron:\n    def __init__(self, sideLength: float):\n        self.sideLength = sideLength\n\n    def surfaceArea(self) -> float:\n        \"\"\"Calculates the surface area of the regular tetrahedron.\"\"\"\n        return math.sqrt(3) * self.sideLength ** 2\ndef area_tetrahedron(sideLength: float) -> float:\n    \"\"\"\n    Calculates the surface area of a regular tetrahedron given its side length.\n    \"\"\"\n    tetra = Tetrahedron(sideLength)\n    return tetra.surfaceArea()"}
