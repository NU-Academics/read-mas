{"task_id": "Mbpp/476", "solution": "from typing import List\nclass ArrayProcessor:\n    @staticmethod\n    def big_sum(array: List[int]) -> int:\n        \"\"\"\n        Computes the sum of the largest and smallest values in a given array.\n        Raises ValueError if the array is empty.\n        \"\"\"\n        if not array:\n            raise ValueError(\"Array must contain at least one element\")\n\n        min_val = max_val = array[0]\n        for num in array[1:]:\n            if num < min_val:\n                min_val = num\n            elif num > max_val:\n                max_val = num\n        return min_val + max_val\ndef big_sum(array: List[int]) -> int:\n    \"\"\"\n    Return the sum of the maximum and minimum values in a non-empty list of integers.\n    Raises ValueError if the list is empty.\n    \"\"\"\n    return ArrayProcessor.big_sum(array)"}
