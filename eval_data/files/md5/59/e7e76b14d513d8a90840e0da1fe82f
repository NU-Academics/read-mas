{"task_id": "Mbpp/80", "solution": "class InputValidator:\n    \"\"\"\n    Validates input parameters for tetrahedral number calculation.\n    \"\"\"\n    def is_positive(self, n: int) -> bool:\n        \"\"\"\n        Checks if n is a positive integer, raising ValueError if not.\n        \"\"\"\n        if n <= 0:\n            raise ValueError(\"Input 'n' must be a positive integer.\")\n        return True\nclass TetrahedralNumberCalculator:\n    \"\"\"\n    Calculates the nth tetrahedral number.\n    \"\"\"\n    def tetrahedral_number(self, n: int) -> int:\n        \"\"\"\n        Computes the nth tetrahedral number using the formula n*(n+1)*(n+2)//6.\n        \"\"\"\n        return (n * (n + 1) * (n + 2)) // 6\ndef tetrahedral_number(n: int) -> int:\n    \"\"\"\n    Finds the nth tetrahedral number.\n    Delegates validation and calculation to internal classes.\n    \"\"\"\n    validator = InputValidator()\n    validator.is_positive(n)\n\n    calculator = TetrahedralNumberCalculator()\n    return calculator.tetrahedral_number(n)"}
{"task_id": "Mbpp/82", "solution": "import math\ndef volume_sphere(radius: float) -> float:\n    \"\"\"\n    Calculates the volume of a sphere given its radius.\n    Raises ValueError if radius is not positive.\n    \"\"\"\n    if radius <= 0:\n        raise ValueError(\"Radius must be a positive number.\")\n    return (4/3) * math.pi * (radius ** 3)"}
{"task_id": "Mbpp/84", "solution": "def sequence(n):\n    \"\"\"\n    Calculates the nth number in the Newman-Conway sequence using dynamic programming.\n    The sequence is defined by a(1) = 1, a(2) = 1, and a(n) = a(a(n-1)) + a(n - a(n-1)) for n > 2.\n    \"\"\"\n    if n <= 0:\n        # Per requirements, not raising an exception, but this is an invalid input.\n        # The sequence is defined for positive integers.\n        return None # Or handle as appropriate, assuming valid inputs per prompt.\n    if n == 1:\n        return 1\n    if n == 2:\n        return 1\n\n    # Initialize a list to store computed sequence values.\n    # a[0] is unused, a[i] stores the i-th sequence number.\n    a = [0] * (n + 1)\n    a[1] = 1\n    a[2] = 1\n\n    # Compute sequence values iteratively from the 3rd term up to n.\n    for i in range(3, n + 1):\n        a[i] = a[a[i - 1]] + a[i - a[i - 1]]\n\n    return a[n]"}
