{"task_id": "Mbpp/751", "solution": "def check_min_heap(array: list[int]) -> bool:\n    \"\"\"\n    Checks if the given array represents a min-heap.\n    A min-heap satisfies the property where each parent node's value is less than or equal to its children's values.\n    \"\"\"\n    n = len(array)\n    # Start from the last parent node and go up to the root.\n    # The last parent node is at index (n // 2) - 1 for a 0-indexed array.\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check against left child\n        if array[i] > array[left_child_idx]:\n            return False\n\n        # Check against right child if it exists\n        if right_child_idx < n and array[i] > array[right_child_idx]:\n            return False\n            \n    return True"}
{"task_id": "Mbpp/748", "solution": "def capital_words_spaces(input_str: str) -> str:\n    \"\"\"\n    Inserts spaces between words starting with capital letters if they follow a lowercase letter.\n    \"\"\"\n    if not input_str:\n        return \"\"\n\n    result = [input_str[0]]\n    for prev, curr in zip(input_str, input_str[1:]):\n        if curr.isupper() and prev.islower():\n            result.append(' ')\n        result.append(curr)\n\n    return ''.join(result)"}
