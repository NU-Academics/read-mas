{"task_id": "Mbpp/398", "solution": "def sum_of_digits(numbers: list) -> int:\n    \"\"\"\n    Computes the sum of digits for each number in a list and returns their total sum.\n    \"\"\"\n\n    class DigitSumCalculator:\n        \"\"\"\n        Calculates the sum of digits for individual numbers and a list of numbers.\n        \"\"\"\n        def compute_digit_sum(self, number: int) -> int:\n            \"\"\"\n            Computes the sum of decimal digits for a single non-negative integer.\n            \"\"\"\n            digit_sum = 0\n            if number == 0:\n                return 0\n            while number > 0:\n                digit_sum += number % 10\n                number //= 10\n            return digit_sum\n\n        def compute_total_sum(self, numbers_list: list) -> int:\n            \"\"\"\n            Aggregates the sum of digits for all numbers in a given list.\n            \"\"\"\n            total_sum = 0\n            for num in numbers_list:\n                total_sum += self.compute_digit_sum(num)\n            return total_sum\n\n    calculator = DigitSumCalculator()\n    return calculator.compute_total_sum(numbers)"}
{"task_id": "Mbpp/409", "solution": "import math\ndef min_product_tuple(tuples: list[tuple[int, int]]) -> int:\n    \"\"\"\n    Calculates the minimum product from pairs of tuples within a given list.\n    The function iterates through the list, computes the product for each tuple,\n    and returns the smallest product found.\n    \"\"\"\n    min_prod = math.inf\n    for a, b in tuples:\n        current_prod = a * b\n        if current_prod < min_prod:\n            min_prod = current_prod\n    return min_prod"}
