{"task_id": "Mbpp/427", "solution": "import re\nfrom datetime import datetime\nDATE_REGEX = re.compile(r\"^(?P<year>\\d{4})-(?P<month>\\d{2})-(?P<day>\\d{2})$\")\ndef change_date_format(input_date: str) -> str:\n    \"\"\"Converts a date string from yyyy-mm-dd to dd-mm-yyyy, validating the input format and calendar date.\"\"\"\n    match = DATE_REGEX.match(input_date)\n    if not match:\n        raise ValueError(f\"Invalid date format: {input_date}\")\n\n    year, month, day = match.group('year'), match.group('month'), match.group('day')\n    try:\n        datetime(int(year), int(month), int(day))\n    except ValueError as exc:\n        raise ValueError(f\"Invalid calendar date: {input_date}\") from exc\n\n    return f\"{day}-{month}-{year}\""}
{"task_id": "Mbpp/429", "solution": "def and_tuples(tuple1: tuple[int], tuple2: tuple[int]) -> tuple[int]:\n    \"\"\"\n    Computes the element-wise bitwise AND of two tuples of integers.\n    Raises ValueError if the input tuples have different lengths.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Input tuples must have the same length.\")\n\n    result = tuple(a & b for a, b in zip(tuple1, tuple2))\n    return result"}
{"task_id": "Mbpp/428", "solution": "import math\ndef shell_sort(array):\n    \"\"\"\n    Sorts a list of numbers using the Shell sort algorithm.\n    Returns a new list with elements sorted in ascending order.\n    \"\"\"\n    n = len(array)\n    # Create a mutable copy to perform sorting\n    arr = list(array)\n\n    # Start with a large gap and reduce it\n    gap = n // 2\n    while gap > 0:\n        # Do a gapped insertion sort for this gap size.\n        # The first gap elements arr[0..gap-1] are already in gapped order\n        # keep adding one more element until the entire array is gap sorted\n        for i in range(gap, n):\n            # add arr[i] to the elements that have been gap sorted\n            # save arr[i] in temp and make a hole at position i\n            temp = arr[i]\n\n            # shift earlier gap-sorted elements up until the correct\n            # location for arr[i] is found\n            j = i\n            while j >= gap and arr[j - gap] > temp:\n                arr[j] = arr[j - gap]\n                j -= gap\n\n            # put temp (the original arr[i]) in its correct location\n            arr[j] = temp\n        gap //= 2\n    return arr"}
