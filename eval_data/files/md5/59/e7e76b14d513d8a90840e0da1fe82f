{"task_id": "Mbpp/803", "solution": "import math\ndef is_perfect_square(n):\n    \"\"\"\n    Checks if a given number is a perfect square.\n    Returns True if n is a perfect square, False otherwise.\n    \"\"\"\n    if n < 0:\n        return False\n    r = int(math.sqrt(n))\n    return r * r == n"}
{"task_id": "Mbpp/804", "solution": "from typing import List\ndef is_product_even(numbers: List[int]) -> bool:\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    The product is even if any number in the list is even.\n    \"\"\"\n    if not numbers:\n        # The product of an empty list is conventionally 1, which is odd.\n        return False\n\n    for num in numbers:\n        if num % 2 == 0:\n            return True\n    return False"}
{"task_id": "Mbpp/805", "solution": "from typing import List\ndef max_sum_list(lists: List[List[int]]) -> List[int]:\n    \"\"\"\n    Returns the sub-list with the highest sum of elements from a list of lists.\n    In case of a tie, the first such sub-list encountered is returned.\n    \"\"\"\n    if not lists:\n        return []\n\n    max_sublist = lists[0]\n    max_current_sum = sum(lists[0])\n\n    for i in range(1, len(lists)):\n        current_list = lists[i]\n        current_sum = sum(current_list)\n        if current_sum > max_current_sum:\n            max_current_sum = current_sum\n            max_sublist = current_list\n\n    return max_sublist"}
