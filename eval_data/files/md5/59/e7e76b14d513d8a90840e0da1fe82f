{"task_id": "Mbpp/619", "solution": "def move_num(s: str) -> str:\n    \"\"\"\n    Moves all numeric characters to the end of the given string, preserving\n    the relative order of both non-numeric and numeric characters.\n    \"\"\"\n    non_numeric_chars = []\n    numeric_chars = []\n    for char in s:\n        if char.isdigit():\n            numeric_chars.append(char)\n        else:\n            non_numeric_chars.append(char)\n    return \"\".join(non_numeric_chars) + \"\".join(numeric_chars)"}
{"task_id": "Mbpp/618", "solution": "class Number:\n    \"\"\"Represents a single numeric value.\"\"\"\n    def __init__(self, value):\n        self._value = value\n\n    def get_value(self):\n        \"\"\"Returns the numeric value.\"\"\"\n        return self._value\nclass NumberList:\n    \"\"\"Represents a list of numeric values.\"\"\"\n    def __init__(self, raw_list):\n        self._elements = [Number(val) for val in raw_list]\n\n    def get_element_at(self, index):\n        \"\"\"Returns the Number object at a specified index.\"\"\"\n        return self._elements[index]\n\n    def length(self):\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self._elements)\n\n    def to_float_list(self):\n        \"\"\"Converts the NumberList to a list of float values.\"\"\"\n        return [element.get_value() for element in self._elements]\nclass DivListFunction:\n    \"\"\"Orchestrates the element-wise division of two NumberList objects.\"\"\"\n    def divide(self, list1: NumberList, list2: NumberList) -> NumberList:\n        \"\"\"Divides two NumberList objects element-wise.\"\"\"\n        result_elements = []\n        for i in range(list1.length()):\n            val1 = list1.get_element_at(i).get_value()\n            val2 = list2.get_element_at(i).get_value()\n            result_elements.append(Number(float(val1 / val2)))\n        \n        # We need to construct a NumberList from the list of Number objects\n        # The NumberList constructor expects a raw list of numbers,\n        # so we'll simulate that for now, assuming it can handle Number objects later\n        # or adjust DivListFunction to return a raw list of floats directly.\n        # Given the sequence diagram, it returns a NumberList.\n        return NumberList([n.get_value() for n in result_elements])\ndef div_list(list1: list, list2: list) -> list[float]:\n    \"\"\"\n    Divides two lists element-wise, returning a new list of floats.\n    \"\"\"\n    number_list1 = NumberList(list1)\n    number_list2 = NumberList(list2)\n\n    division_handler = DivListFunction()\n    result_number_list = division_handler.divide(number_list1, number_list2)\n    \n    return result_number_list.to_float_list()"}
{"task_id": "Mbpp/620", "solution": "from typing import List\ndef largest_subset(nums: List[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset of numbers where every pair is divisible.\n    The algorithm sorts the input and uses dynamic programming to build up subset sizes.\n    \"\"\"\n    if not nums:\n        return 0\n\n    nums.sort()\n    n = len(nums)\n    dp = [1] * n  # dp[i] stores the size of the largest divisible subset ending with nums[i]\n\n    max_size = 1\n\n    for i in range(n):\n        for j in range(i):\n            if nums[i] % nums[j] == 0:\n                dp[i] = max(dp[i], dp[j] + 1)\n        max_size = max(max_size, dp[i])\n\n    return max_size"}
{"task_id": "Mbpp/622", "solution": "def get_median(list1, list2, n):\n    \"\"\"\n    Finds the median of two sorted lists of the same size n.\n    The total elements are 2n, and the median is the average of the (n-1)-th and n-th elements (0-indexed)\n    of the conceptually merged list.\n    \"\"\"\n    i = 0  # Pointer for list1\n    j = 0  # Pointer for list2\n    m1 = 0 # Stores the element at position (n-1) in the merged list\n    m2 = 0 # Stores the element at position n in the merged list\n\n    # Iterate n+1 times to find the elements at (n-1) and n positions (0-indexed)\n    for count in range(n + 1):\n        m1 = m2 # m1 takes the value that was previously held by m2\n\n        # Compare elements from both lists and pick the smaller one, or handle exhausted lists\n        if i == n:  # list1 is exhausted\n            m2 = list2[j]\n            j += 1\n        elif j == n:  # list2 is exhausted\n            m2 = list1[i]\n            i += 1\n        elif list1[i] <= list2[j]:\n            m2 = list1[i]\n            i += 1\n        else:  # list2[j] < list1[i]\n            m2 = list2[j]\n            j += 1\n\n    return (float)(m1 + m2) / 2.0"}
