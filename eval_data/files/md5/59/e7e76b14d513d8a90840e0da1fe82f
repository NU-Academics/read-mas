{"task_id": "Mbpp/11", "solution": "def remove_Occ(inputString: str, targetChar: str) -> str:\n    \"\"\"\n    Removes the first and last occurrence of a given character from the string.\n    Returns the original string if the character occurs fewer than two times.\n    \"\"\"\n    first_occurrence = -1\n    last_occurrence = -1\n\n    for i, char in enumerate(inputString):\n        if char == targetChar:\n            if first_occurrence == -1:\n                first_occurrence = i\n            last_occurrence = i\n\n    if first_occurrence == -1 or first_occurrence == last_occurrence:\n        return inputString\n\n    result = []\n    for i, char in enumerate(inputString):\n        if i != first_occurrence and i != last_occurrence:\n            result.append(char)\n\n    return \"\".join(result)"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(inputString: str) -> int:\n    \"\"\"\n    Finds the minimum number of rotations (greater than 0) required to get the same string.\n    The algorithm uses string concatenation and checks for the first occurrence.\n    \"\"\"\n    n = len(inputString)\n    # Concatenate the string to itself to easily check for rotations.\n    doubled_string = inputString + inputString\n    \n    # Iterate from 1 up to n to find the smallest positive rotation.\n    for k in range(1, n + 1):\n        if doubled_string[k : k + n] == inputString:\n            return k\n    \n    # This case should theoretically not be reached for non-empty strings,\n    # as at least n rotations (the string itself) will always match.\n    return n"}
{"task_id": "Mbpp/2", "solution": "from typing import List, Any\ndef similar_elements(list1: List[Any], list2: List[Any]) -> List[Any]:\n    \"\"\"\n    Compute the intersection of two lists, returning unique shared elements in sorted order for determinism.\n    \"\"\"\n    set1 = set(list1)\n    shared_set = {item for item in list2 if item in set1}\n    return sorted(shared_set)"}
{"task_id": "Mbpp/3", "solution": "import math\ndef is_not_prime(n: int) -> bool:\n    \"\"\"\n    Identifies if a number is not prime.\n    Returns True for non-prime numbers, False for prime numbers.\n    \"\"\"\n    if n <= 1:\n        return True\n    if n == 2:\n        return False\n    if n % 2 == 0:\n        return True\n\n    # Check for odd divisors from 3 up to the square root of n.\n    limit = int(math.sqrt(n))\n    for i in range(3, limit + 1, 2):\n        if n % i == 0:\n            return True\n\n    return False"}
{"task_id": "Mbpp/4", "solution": "from typing import List\nimport heapq\ndef heap_queue_largest(numbers: List[int], n: int) -> List[int]:\n    if n <= 0 or not numbers:\n        return []\n\n    if n >= len(numbers):\n        return sorted(numbers, reverse=True)\n\n    min_heap = []\n    for num in numbers:\n        if len(min_heap) < n:\n            heapq.heappush(min_heap, num)\n        else:\n            if num > min_heap[0]:\n                heapq.heapreplace(min_heap, num)\n    \n    # The heap contains the n largest elements. Sort them in descending order.\n    return sorted(min_heap, reverse=True)"}
