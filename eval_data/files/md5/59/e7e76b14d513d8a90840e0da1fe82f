{"task_id": "Mbpp/311", "solution": "class BitManipulator:\n    \"\"\"Encapsulates static bit-level manipulation logic.\"\"\"\n\n    @staticmethod\n    def _set_left_most_unset_bit_impl(value: int) -> int:\n        \"\"\"\n        Computes the integer with the most significant 0 bit set.\n        Handles edge cases for 0 and -1 as per design requirements.\n        \"\"\"\n        if value == -1:\n            return -1\n        if value == 0:\n            return 1\n\n        # For positive integers, determine the range of bits to check.\n        # bit_length gives the index of the most significant bit + 1.\n        bit_length = value.bit_length()\n        \n        # Iterate from the most significant active bit position downwards.\n        for i in range(bit_length - 1, -1, -1):\n            # Check if the i-th bit is unset (0).\n            if not ((value >> i) & 1):\n                # If an unset bit is found, set it and return the new value.\n                return value | (1 << i)\n\n        # If no unset bit is found within the active bit_length,\n        # it means all bits up to bit_length-1 are set.\n        # In this case, the leftmost unset bit is at the bit_length position.\n        return value | (1 << bit_length)\ndef set_left_most_unset_bit(value: int) -> int:\n    \"\"\"Sets the leftmost unset bit in the given integer by delegating to the BitManipulator domain class.\"\"\"\n    return BitManipulator._set_left_most_unset_bit_impl(value)"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the highest power of 2 that is less than or equal to n.\n    Returns 0 if n is less than 1.\n    \"\"\"\n    if n < 1:\n        return 0\n    # For a positive n, n.bit_length() gives the number of bits needed to represent n.\n    # The highest power of 2 less than or equal to n will have a binary representation\n    # that is 1 followed by (n.bit_length() - 1) zeros, which is 2**(n.bit_length() - 1).\n    return 1 << (n.bit_length() - 1)"}
{"task_id": "Mbpp/389", "solution": "class LucasNumber:\n    \"\"\"Represents a Lucas number.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\nclass LucasCalculator:\n    \"\"\"Calculates Lucas numbers using an iterative approach.\"\"\"\n    def find_lucas(self, n: int) -> int:\n        \"\"\"Computes the nth Lucas number.\"\"\"\n        if n < 0:\n            raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n        if n == 0:\n            return LucasNumber(2).value\n        if n == 1:\n            return LucasNumber(1).value\n\n        # L(0) = 2, L(1) = 1\n        a, b = 2, 1\n        for _ in range(2, n + 1):\n            next_lucas = a + b\n            a = b\n            b = next_lucas\n        \n        return LucasNumber(b).value\ndef find_lucas(n: int) -> int:\n    \"\"\"\n    Finds the n'th Lucas number.\n    It delegates the computation to a LucasCalculator instance.\n    \"\"\"\n    calculator = LucasCalculator()\n    return calculator.find_lucas(n)"}
{"task_id": "Mbpp/391", "solution": "from typing import List, Dict\ndef convert_list_dictionary(\n    ids: List[str],\n    names: List[str],\n    scores: List[int]\n) -> List[Dict[str, Dict[str, int]]]:\n    \"\"\"Converts parallel lists of IDs, names, and scores into a list of nested dictionaries.\n    Each dictionary maps an ID to an inner dictionary of {name: score}.\n    \"\"\"\n    result: List[Dict[str, Dict[str, int]]] = []\n    for id_val, name_val, score_val in zip(ids, names, scores):\n        result.append({id_val: {name_val: score_val}})\n    return result"}
