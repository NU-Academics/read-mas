{"task_id": "Mbpp/247", "solution": "from dataclasses import dataclass\nfrom typing import List\nclass LPSolver:\n    \"\"\"Domain service that computes the LPS length using dynamic programming.\"\"\"\n\n    def lps(self, input: str) -> int:\n        \"\"\"Return the length of the longest palindromic subsequence of *input*.\"\"\"\n        if not input:\n            return 0\n        n = len(input)\n        dp: List[List[int]] = [[0] * n for _ in range(n)]\n        for i in range(n):\n            dp[i][i] = 1\n        for length in range(2, n + 1):\n            for i in range(n - length + 1):\n                j = i + length - 1\n                if input[i] == input[j]:\n                    dp[i][j] = 2 + (dp[i + 1][j - 1] if length > 2 else 0)\n                else:\n                    dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])\n        return dp[0][n - 1]\ndef lps(input: str) -> int:\n    \"\"\"Compute the length of the longest palindromic subsequence.\"\"\"\n    solver = LPSolver()\n    result = solver.lps(input)\n    return result"}
