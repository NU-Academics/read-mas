{"task_id": "Mbpp/296", "solution": "from typing import List, Tuple\ndef _merge(left: List[int], right: List[int]) -> Tuple[List[int], int]:\n    \"\"\"\n    Merge two sorted lists and count cross-inversions.\n    \"\"\"\n    merged = []\n    i = j = inv_count = 0\n    len_left = len(left)\n\n    while i < len_left and j < len(right):\n        if left[i] <= right[j]:\n            merged.append(left[i])\n            i += 1\n        else:\n            merged.append(right[j])\n            inv_count += len_left - i\n            j += 1\n\n    merged.extend(left[i:])\n    merged.extend(right[j:])\n    return merged, inv_count\ndef _merge_sort(arr: List[int]) -> Tuple[List[int], int]:\n    \"\"\"\n    Recursively sort the array and count inversions.\n    \"\"\"\n    n = len(arr)\n    if n <= 1:\n        return arr, 0\n\n    mid = n // 2\n    left, inv_left = _merge_sort(arr[:mid])\n    right, inv_right = _merge_sort(arr[mid:])\n\n    merged, inv_split = _merge(left, right)\n    total_inv = inv_left + inv_right + inv_split\n    return merged, total_inv\ndef get_Inv_Count(arr: List[int]) -> int:\n    \"\"\"\n    Return the number of inversions in the input list using a merge-sort based approach.\n    The input list is not modified.\n    \"\"\"\n    arr_copy = list(arr)\n    _, inv_count = _merge_sort(arr_copy)\n    return inv_count"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(nested_list):\n    \"\"\"\n    Flattens a given nested list structure into a single list.\n    Preserves the order of elements from the original nested list.\n    \"\"\"\n    result = []\n    # Initialize the stack with elements of the input list in reverse order\n    # to process them from left to right using stack.pop().\n    stack = list(reversed(nested_list))\n\n    while stack:\n        current_item = stack.pop()\n        # If the item is a list, extend the stack with its elements in reverse order.\n        if isinstance(current_item, list):\n            for sub_item in reversed(current_item):\n                stack.append(sub_item)\n        else:\n            # If it's not a list, it's an atomic element, add it to the result.\n            result.append(current_item)\n            \n    return result"}
{"task_id": "Mbpp/290", "solution": "from typing import List, Tuple\ndef max_length(list_of_lists: List[List[int]]) -> Tuple[int, List[int]]:\n    \"\"\"\n    Finds the list of maximum length in a list of lists.\n    Returns a tuple containing the maximum length and the first sublist with that length.\n    \"\"\"\n    max_len = len(list_of_lists[0])\n    max_sublist = list_of_lists[0]\n\n    for sublist in list_of_lists[1:]:\n        current_len = len(sublist)\n        if current_len > max_len:\n            max_len = current_len\n            max_sublist = sublist\n\n    return (max_len, max_sublist)"}
{"task_id": "Mbpp/299", "solution": "from collections import defaultdict\ndef max_aggregate(input_list):\n    \"\"\"\n    Calculates the maximum aggregate score from a list of (name, score) tuples.\n    Aggregates scores for each unique name and returns the name with the highest total score.\n    \"\"\"\n    if not input_list:\n        return None\n\n    aggregated_scores = defaultdict(int)\n    for name, score in input_list:\n        aggregated_scores[name] += score\n\n    max_name = None\n    max_score = -1\n\n    for name, total_score in aggregated_scores.items():\n        if total_score > max_score:\n            max_score = total_score\n            max_name = name\n\n    return (max_name, max_score)"}
