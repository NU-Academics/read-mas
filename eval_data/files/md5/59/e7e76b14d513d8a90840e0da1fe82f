{"task_id": "Mbpp/448", "solution": "from dataclasses import dataclass\nfrom typing import Iterable\nclass PerrinCalculator:\n    \"\"\"Stateless calculator for Perrin numbers and their sum.\"\"\"\n\n    @staticmethod\n    def _generate_sequence(n: int) -> Iterable[PerrinNumber]:\n        \"\"\"Yield PerrinNumber objects from P0 to Pn.\"\"\"\n        a, b, c = 3, 0, 2  # P0, P1, P2\n        if n == 0:\n            yield PerrinNumber(0, a)\n            return\n        yield PerrinNumber(0, a)\n        if n >= 1:\n            yield PerrinNumber(1, b)\n        if n >= 2:\n            yield PerrinNumber(2, c)\n        for idx in range(3, n + 1):\n            a, b, c = b, c, a + b  # Pn = Pn-2 + Pn-3\n            yield PerrinNumber(idx, c)\n\n    @classmethod\n    def calculateSum(cls, n: int) -> int:\n        \"\"\"Return the sum of Perrin numbers from P0 to Pn.\"\"\"\n        total = 0\n        for number in cls._generate_sequence(n):\n            total += number.value\n        return total\ndef cal_sum(n: int) -> int:\n    \"\"\"\n    Public API to compute the sum of Perrin numbers up to index n.\n    Delegates calculation to PerrinCalculator.\n    \"\"\"\n    return PerrinCalculator.calculateSum(n)"}
{"task_id": "Mbpp/453", "solution": "def sumofFactors(n):\n    \"\"\"\n    Calculates the sum of all even factors of a given positive integer.\n    \"\"\"\n    total = 0\n    i = 1\n    while i * i <= n:\n        if n % i == 0:\n            # Check the current divisor 'i'\n            if i % 2 == 0:\n                total += i\n            \n            # Check the paired divisor 'j'\n            j = n // i\n            if j != i and j % 2 == 0:\n                total += j\n        i += 1\n    return total"}
