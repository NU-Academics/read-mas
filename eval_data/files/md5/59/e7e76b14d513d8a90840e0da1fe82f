{"task_id": "Mbpp/129", "solution": "def magic_square_test(matrix):\n    n = len(matrix)\n\n    # BR1: Matrix must be square. An empty matrix is not a magic square.\n    if n == 0:\n        return False\n    for row in matrix:\n        if len(row) != n:\n            return False\n\n    # Calculate the target magic sum from the first row.\n    # BR2: All row, column, and diagonal sums must equal this constant.\n    magic_sum = sum(matrix[0])\n\n    seen_elements = set()\n    col_sums = [0] * n\n    diag_sum1 = 0  # Main diagonal (top-left to bottom-right)\n    diag_sum2 = 0  # Anti-diagonal (top-right to bottom-left)\n\n    for i in range(n):\n        row_sum = 0\n        for j in range(n):\n            element = matrix[i][j]\n\n            # BR4: All elements are positive integers within 1...n^2.\n            if not (1 <= element <= n * n):\n                return False\n\n            # BR3: All elements are distinct.\n            if element in seen_elements:\n                return False\n            seen_elements.add(element)\n\n            row_sum += element\n            col_sums[j] += element\n\n            if i == j:\n                diag_sum1 += element\n            if i + j == n - 1:\n                diag_sum2 += element\n\n        # BR2: Check row sum.\n        if row_sum != magic_sum:\n            return False\n\n    # BR2: Check column sums.\n    for current_col_sum in col_sums:\n        if current_col_sum != magic_sum:\n            return False\n\n    # BR2: Check diagonal sums.\n    if diag_sum1 != magic_sum:\n        return False\n    if diag_sum2 != magic_sum:\n        return False\n\n    return True"}
{"task_id": "Mbpp/131", "solution": "class VowelSet:\n    \"\"\"Encapsulates vowel detection logic.\"\"\"\n    _VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    def is_vowel(self, char: str) -> bool:\n        \"\"\"Checks if a given character is a vowel (case-insensitive, 'y' not included).\"\"\"\n        return char.lower() in self._VOWELS\nclass VowelReverser:\n    \"\"\"Orchestrates the process of reversing only the vowels in a string.\"\"\"\n    def __init__(self):\n        self.vowel_set = VowelSet()\n\n    def reverse_vowels(self, input_str: str) -> str:\n        \"\"\"Reverses only the vowels in the input string.\"\"\"\n        char_list = list(input_str)\n        vowel_indices = []\n        vowel_chars = []\n\n        for i, char in enumerate(char_list):\n            if self.vowel_set.is_vowel(char):\n                vowel_indices.append(i)\n                vowel_chars.append(char)\n\n        vowel_chars.reverse()\n\n        for i, original_index in enumerate(vowel_indices):\n            char_list[original_index] = vowel_chars[i]\n\n        return \"\".join(char_list)\ndef reverse_vowels(s: str) -> str:\n    \"\"\"\n    Reverses only the vowels of a given string (where y is not a vowel).\n    assert reverse_vowels(\"Python\") == \"Python\"\n    \"\"\"\n    reverser = VowelReverser()\n    return reverser.reverse_vowels(s)"}
