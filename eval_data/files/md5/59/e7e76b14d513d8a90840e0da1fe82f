{"task_id": "Mbpp/102", "solution": "def snake_to_camel(snake_str: str) -> str:\n    \"\"\"Converts a snake_case string to a CamelCase string.\"\"\"\n    if not isinstance(snake_str, str):\n        raise ValueError(\"Input must be a string.\")\n    \n    # Basic validation for common non-snake_case patterns\n    if not snake_str or not snake_str.islower() and '_' not in snake_str:\n        # Simplistic check: If it contains uppercase or isn't purely lowercase with underscores, it's not snake_case\n        # This is a simplification based on \"never crash on valid input, raise ValueError on invalid\"\n        # and \"raises ValueError if the input contains uppercase letters\"\n        if any(c.isupper() for c in snake_str) or '__' in snake_str or snake_str.startswith('_') or snake_str.endswith('_'):\n            raise ValueError(\"Invalid snake_case string format.\")\n\n    components = snake_str.split('_')\n    return \"\".join(x.capitalize() for x in components)"}
{"task_id": "Mbpp/101", "solution": "from typing import List\ndef kth_element(array: List[int], k: int) -> int:\n    \"\"\"\n    Finds the kth element in the given array using 1-based indexing.\n    Raises IndexError if k is out of bounds.\n    \"\"\"\n    if not (1 <= k <= len(array)):\n        raise IndexError(f\"k ({k}) is out of bounds for array of length {len(array)}\")\n    return array[k - 1]"}
{"task_id": "Mbpp/103", "solution": "def eulerian_num(n, m):\n    \"\"\"\n    Computes the Eulerian number a(n, m) using the recurrence relation.\n    Handles base cases and valid ranges for n and m.\n    \"\"\"\n    if m < 0 or m >= n:\n        return 0\n    if n == 0 and m == 0:\n        return 1\n\n    # Using dynamic programming (iterative approach)\n    # dp[i][j] stores a(i, j)\n    dp = [[0] * (i + 1) for i in range(n + 1)]\n    dp[0][0] = 1\n\n    for i in range(1, n + 1):\n        for j in range(i + 1): # m can go up to i-1 for a(i,j) > 0, but dp table needs up to i\n            if j < 0 or j >= i:\n                # a(i, j) = 0 for m < 0 or m >= n (here i)\n                dp[i][j] = 0\n            else:\n                term1 = (i - j) * (dp[i-1][j-1] if j-1 >= 0 else 0)\n                term2 = (j + 1) * dp[i-1][j]\n                dp[i][j] = term1 + term2\n    \n    return dp[n][m]"}
