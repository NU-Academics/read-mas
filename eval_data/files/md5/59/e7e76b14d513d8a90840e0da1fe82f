{"task_id": "Mbpp/608", "solution": "import math\nclass BellNumberCalculator:\n    \"\"\"Calculates Bell numbers using dynamic programming with memoization.\"\"\"\n    def __init__(self):\n        self._cache = {0: 1} # Initialize cache with B_0 = 1.\n\n    def calculate(self, n: int) -> int:\n        \"\"\"Computes the nth Bell number.\"\"\"\n        if n < 0:\n            raise ValueError(\"Bell number is not defined for negative input.\")\n        if n in self._cache:\n            return self._cache[n]\n\n        # Calculate B_n using the recurrence: B_n = sum_{k=0}^{n-1} C(n-1, k) * B_k\n        result = 0\n        for k in range(n):\n            combination = math.comb(n - 1, k)\n            bell_k = self.calculate(k) # Recursively get B_k, which will use the cache.\n            result += combination * bell_k\n        \n        self._cache[n] = result\n        return result\n_bell_calculator = BellNumberCalculator()\ndef bell_Number(n: int) -> int:\n    \"\"\"\n    Finds the nth Bell number.\n    Delegates the computation to an internal BellNumberCalculator instance.\n    \"\"\"\n    return _bell_calculator.calculate(n)"}
{"task_id": "Mbpp/610", "solution": "from typing import List, Any\ndef remove_kth_element(lst: List[Any], k: int) -> List[Any]:\n    \"\"\"\n    Return a new list with the element at index k removed.\n    Raises IndexError if k is not a valid index, or TypeError if k is not an integer.\n    \"\"\"\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an integer\")\n    if k < 0 or k >= len(lst):\n        raise IndexError(f\"Index {k} out of range for list of length {len(lst)}\")\n\n    return lst[:k] + lst[k+1:]"}
