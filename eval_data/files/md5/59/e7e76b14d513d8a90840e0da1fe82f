{"task_id": "Mbpp/67", "solution": "import threading\nclass BellNumberCache:\n    \"\"\"Thread-safe cache for Bell numbers.\"\"\"\n    def __init__(self):\n        self._cache = {}\n        self._lock = threading.Lock()\n\n    def get(self, n):\n        \"\"\"Retrieves Bell number for n from cache.\"\"\"\n        with self._lock:\n            return self._cache.get(n)\n\n    def set(self, n, value):\n        \"\"\"Stores Bell number for n in cache.\"\"\"\n        with self._lock:\n            self._cache[n] = value\nclass BellNumberCalculator:\n    \"\"\"Computes Bell numbers using the Bell triangle algorithm.\"\"\"\n    def __init__(self, cache: BellNumberCache):\n        self._cache = cache\n        self._max_n_computed = -1\n        self._last_triangle_row = []\n        self._calculator_lock = threading.Lock()\n\n    def bell_number(self, n: int) -> int:\n        cached_value = self._cache.get(n)\n        if cached_value is not None:\n            return cached_value\n\n        with self._calculator_lock:\n            # Re-check cache inside lock in case another thread computed it\n            cached_value = self._cache.get(n)\n            if cached_value is not None:\n                return cached_value\n\n            if n == 0:\n                if self._cache.get(0) is None:\n                    self._cache.set(0, 1)\n                if self._max_n_computed < 0:\n                    self._max_n_computed = 0\n                    self._last_triangle_row = [1]\n                return 1\n            \n            # Initialize B(0) and triangle state if not already done\n            if self._cache.get(0) is None:\n                self._cache.set(0, 1)\n            if self._max_n_computed < 0:\n                self._max_n_computed = 0\n                self._last_triangle_row = [1]\n\n            # Iteratively compute Bell triangle rows up to n\n            for current_n_val in range(self._max_n_computed + 1, n + 1):\n                prev_row = self._last_triangle_row\n                \n                first_element = prev_row[-1]\n                current_row = [first_element]\n                self._cache.set(current_n_val, first_element)\n\n                for j in range(1, current_n_val + 1):\n                    next_element = current_row[j-1] + prev_row[j-1]\n                    current_row.append(next_element)\n                \n                self._last_triangle_row = current_row\n                self._max_n_computed = current_n_val\n        \n        return self._cache.get(n)\n_bell_number_cache = BellNumberCache()\n_bell_number_calculator = BellNumberCalculator(_bell_number_cache)\ndef bell_number(n: int) -> int:\n    \"\"\"\n    Computes the Bell number B(n) for a non-negative integer n.\n    Uses a memoized Bell triangle algorithm for efficiency.\n    \"\"\"\n    return _bell_number_calculator.bell_number(n)"}
{"task_id": "Mbpp/68", "solution": "from typing import List\nclass Array:\n    \"\"\"Represents an array of integers for monotonicity checks.\"\"\"\n    def __init__(self, elements: List[int]):\n        self.elements = elements\nclass MonotonicChecker:\n    \"\"\"Provides static methods to determine if an array is monotonic.\"\"\"\n    @staticmethod\n    def isMonotonic(arr: Array) -> bool:\n        if len(arr.elements) <= 1:\n            return True\n\n        increasing = decreasing = True\n        for i in range(1, len(arr.elements)):\n            if arr.elements[i] > arr.elements[i-1]:\n                decreasing = False\n            elif arr.elements[i] < arr.elements[i-1]:\n                increasing = False\n        return increasing or decreasing\ndef is_Monotonic(arr: List[int]) -> bool:\n    \"\"\"Checks whether the given array is monotonic (non-decreasing or non-increasing).\"\"\"\n    array_obj = Array(arr)\n    return MonotonicChecker.isMonotonic(array_obj)"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list, sublist):\n    \"\"\"\n    Checks if a sublist is present contiguously within a main list using a sliding window.\n    \"\"\"\n    n_main = len(main_list)\n    n_sub = len(sublist)\n\n    if n_sub == 0:\n        return True\n    if n_sub > n_main:\n        return False\n\n    for i in range(n_main - n_sub + 1):\n        if main_list[i:i+n_sub] == sublist:\n            return True\n    return False"}
