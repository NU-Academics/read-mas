{"task_id": "Mbpp/92", "solution": "def is_undulating(number: int) -> bool:\n    \"\"\"\n    Checks if the digits of a number strictly alternate between higher and lower values.\n    Returns False if the number has fewer than 3 digits.\n    \"\"\"\n    s_num = str(number)\n    if len(s_num) < 3:\n        return False\n\n    digits = [int(d) for d in s_num]\n    \n    # state indicates the trend of the previous comparison:\n    # True if prev < current (increasing), False if prev > current (decreasing)\n    state = None \n\n    for i in range(1, len(digits)):\n        prev_digit = digits[i-1]\n        current_digit = digits[i]\n\n        if prev_digit == current_digit:\n            return False # Digits must strictly alternate\n\n        current_comparison_is_greater = (current_digit > prev_digit)\n\n        if state is None:\n            # Establish the initial trend (first comparison)\n            state = current_comparison_is_greater\n        else:\n            # Subsequent comparisons must alternate the trend\n            if state == current_comparison_is_greater:\n                return False # Trend did not alternate\n            else:\n                state = current_comparison_is_greater # Trend alternated, update state\n\n    return True"}
{"task_id": "Mbpp/93", "solution": "def power(a, b):\n    \"\"\"\n    Calculates the value of 'a' raised to the power of 'b' using exponentiation by squaring.\n    Handles both positive and negative integer exponents.\n    \"\"\"\n    if b == 0:\n        return 1\n    \n    if a == 0:\n        return 0 if b > 0 else float('inf') # 0^0 is 1 by convention, but here we return 1. 0^neg is inf.\n\n    is_negative_exponent = b < 0\n    abs_b = abs(b)\n    \n    result = 1\n    base = a\n    \n    while abs_b > 0:\n        if abs_b % 2 == 1:\n            result *= base\n        base *= base\n        abs_b //= 2\n            \n    return 1 / result if is_negative_exponent else result"}
{"task_id": "Mbpp/94", "solution": "from typing import List, Tuple\ndef index_minimum(tuples: List[Tuple[str, int]]) -> str:\n    \"\"\"\n    Returns the first value of the tuple with the smallest second value.\n    Raises ValueError if the input list is empty.\n    \"\"\"\n    if not tuples:\n        raise ValueError(\"Input list must contain at least one tuple.\")\n\n    min_tuple = tuples[0]\n    for t in tuples[1:]:\n        if t[1] < min_tuple[1]:\n            min_tuple = t\n\n    return min_tuple[0]"}
{"task_id": "Mbpp/96", "solution": "import math\ndef divisor(n: int) -> int:\n    \"\"\"\n    Calculates the number of positive divisors for a given integer.\n    Handles negative numbers by using their absolute value and returns 0 for n=0.\n    \"\"\"\n    if n == 0:\n        return 0\n    \n    num = abs(n)\n    count = 0\n    # Iterate from 1 up to the square root of num\n    for i in range(1, int(math.sqrt(num)) + 1):\n        if num % i == 0:\n            if i * i == num:\n                # If i is the square root, count it once\n                count += 1\n            else:\n                # Otherwise, i and num // i are two distinct divisors\n                count += 2\n    return count"}
{"task_id": "Mbpp/97", "solution": "def frequency_lists(list_of_lists):\n    \"\"\"\n    Finds the frequency of each element in a flattened list of lists.\n    \"\"\"\n    flattened_list = []\n    for sublist in list_of_lists:\n        for item in sublist:\n            flattened_list.append(item)\n\n    frequency_map = {}\n    for item in flattened_list:\n        frequency_map[item] = frequency_map.get(item, 0) + 1\n\n    return frequency_map"}
{"task_id": "Mbpp/95", "solution": "from typing import List, Any\ndef Find_Min_Length(list_of_lists: List[List[Any]]) -> int:\n    \"\"\"\n    Finds the length of the smallest list in a list of lists.\n    Returns 0 if the input list of lists is empty.\n    \"\"\"\n    if not list_of_lists:\n        return 0\n\n    min_length = float('inf')\n    for sublist in list_of_lists:\n        min_length = min(min_length, len(sublist))\n    \n    return int(min_length)"}
