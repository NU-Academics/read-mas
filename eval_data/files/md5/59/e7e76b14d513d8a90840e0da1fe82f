{"task_id": "Mbpp/576", "solution": "from typing import List\ndef is_Sub_Array(list1: List[int], list2: List[int]) -> bool:\n    \"\"\"Check if list2 is a contiguous sublist of list1.\n\n    Returns True if list2 is found as a sublist, False otherwise.\n    \"\"\"\n    if not list2:\n        return True\n    if not list1:\n        return False\n\n    m, n = len(list1), len(list2)\n    if n > m:\n        return False\n\n    for i in range(m - n + 1):\n        if list1[i : i + n] == list2:\n            return True\n    return False"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(list1, list2, list3):\n    \"\"\"Interleaves three lists of the same length into a single flat list.\"\"\"\n    result = []\n    length = len(list1)\n    for i in range(length):\n        result.append(list1[i])\n        result.append(list2[i])\n        result.append(list3[i])\n    return result"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n: int) -> int:\n    \"\"\"\n    Returns the last decimal digit of n! for a non-negative integer n.\n    For n >= 5, the last digit is 0. Otherwise, calculate and return the last digit.\n    \"\"\"\n    if n >= 5:\n        return 0\n\n    # Pre-calculate factorials for n < 5 to avoid repeated computation\n    # 0! = 1, 1! = 1, 2! = 2, 3! = 6, 4! = 24\n    if n == 0:\n        return 1\n    elif n == 1:\n        return 1\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 6\n    elif n == 4:\n        return 4\n    # The design mentioned a loop for n < 5, let's use that for flexibility\n    # and to strictly follow the design's \"System Implementation\" section\n    # but slightly adjusted to handle n=0 and n=1 correctly as per the logic.\n    # The direct return values above are effectively what the loop produces for these small n.\n\n    # Reverting to the loop as per the provided \"System Implementation\" detail\n    # ensuring it correctly covers 0! and 1! and small factorials.\n    # This logic naturally handles n=0, 1, 2, 3, 4 correctly as shown in thought process.\n    factorial = 1\n    for i in range(2, n + 1):\n        factorial *= i\n    return factorial % 10"}
{"task_id": "Mbpp/583", "solution": "import math\ndef catalan_number(n):\n    \"\"\"\n    Calculates the nth Catalan number using the closed-form formula.\n    C_n = (2n)! / (n! * (n+1)!)\n    \"\"\"\n    numerator = math.factorial(2 * n)\n    denominator = math.factorial(n) * math.factorial(n + 1)\n    return numerator // denominator"}
{"task_id": "Mbpp/580", "solution": "def extract_even(nested_tuple):\n    \"\"\"\n    Recursively extracts even numbers from a nested tuple, preserving its structure.\n    Odd numbers are discarded, and sub-tuples are processed recursively.\n    \"\"\"\n    result = []\n    for item in nested_tuple:\n        if isinstance(item, int):\n            if item % 2 == 0:\n                result.append(item)\n        elif isinstance(item, tuple):\n            sub_tuple_result = extract_even(item)\n            if sub_tuple_result:  # Only add non-empty sub-tuples to preserve structure for valid content\n                result.append(sub_tuple_result)\n    return tuple(result)"}
{"task_id": "Mbpp/581", "solution": "def surface_Area(baseEdge, height):\n    \"\"\"\n    Calculates the surface area of a square pyramid.\n    The formula used is base_area + (perimeter * height) / 2.\n    \"\"\"\n    if not isinstance(baseEdge, (int, float)) or not isinstance(height, (int, float)):\n        raise TypeError(\"Inputs baseEdge and height must be numeric.\")\n    if baseEdge < 0 or height < 0:\n        raise ValueError(\"Inputs baseEdge and height must be non-negative.\")\n\n    base_area = baseEdge ** 2\n    # The slant height is needed for the lateral surface area of a pyramid, not the vertical height.\n    # The problem description and given formula \"base area + (perimeter * height) / 2\" are inconsistent\n    # with standard geometry for a square pyramid's surface area.\n    # Standard formula for surface area of a square pyramid is Base_Area + 2 * baseEdge * Slant_Height\n    # where Slant_Height = sqrt(height^2 + (baseEdge/2)^2).\n    # However, the design context explicitly states to follow \"business rules\" which include:\n    # \"Compute total surface area (base area + (perimeter * height) / 2)\".\n    # This formula implies 'height' is being used as if it were the slant height or for a different geometric shape.\n    # Given the assert `surface_Area(3,4) == 33`, let's verify if the provided formula matches.\n    # baseEdge = 3, height = 4\n    # base_area = 3 * 3 = 9\n    # perimeter = 4 * 3 = 12\n    # surface_area = 9 + (12 * 4) / 2 = 9 + 48 / 2 = 9 + 24 = 33.\n    # The assert matches the provided formula. Therefore, we must use the formula as stated in the design context.\n    \n    perimeter = 4 * baseEdge\n    surface_area = base_area + (perimeter * height) / 2\n    return float(surface_area)"}
{"task_id": "Mbpp/579", "solution": "from typing import Tuple, Any\ndef find_dissimilar(tuple1: Tuple[Any], tuple2: Tuple[Any]) -> Tuple[Any]:\n    \"\"\"\n    Finds elements that are present in only one of the two input tuples, preserving their original order.\n    \"\"\"\n    set1 = set(tuple1)\n    set2 = set(tuple2)\n    \n    dissimilar_elements = []\n    \n    for item in tuple1:\n        if item not in set2:\n            dissimilar_elements.append(item)\n            \n    for item in tuple2:\n        if item not in set1:\n            dissimilar_elements.append(item)\n            \n    return tuple(dissimilar_elements)"}
{"task_id": "Mbpp/585", "solution": "import heapq\ndef expensive_items(items, n):\n    \"\"\"\n    Finds the n most expensive items in a list of dictionaries.\n    Uses a min-heap to efficiently find the top n items without a full sort.\n    \"\"\"\n    if n <= 0:\n        return []\n\n    # Use a min-heap to keep track of the n most expensive items seen so far.\n    # The heap stores (price, item_index, item) tuples.\n    # item_index is used to ensure stable sorting for items with the same price.\n    min_heap = []\n    \n    for i, item in enumerate(items):\n        price = item.get('price', 0) \n        if len(min_heap) < n:\n            heapq.heappush(min_heap, (price, i, item))\n        else:\n            # If current item is more expensive than the least expensive in our top n,\n            # pop the least expensive and push the current one.\n            if price > min_heap[0][0]:\n                heapq.heapreplace(min_heap, (price, i, item))\n    \n    # Extract items from the heap, sort them by price in descending order.\n    # Note: heapq itself doesn't guarantee sorted order upon extraction,\n    # and we need overall descending price order for the final output.\n    result = [item_tuple[2] for item_tuple in min_heap]\n    result.sort(key=lambda x: x.get('price', 0), reverse=True)\n    \n    return result"}
{"task_id": "Mbpp/586", "solution": "def split_Arr(lst, n):\n    \"\"\"\n    Splits a list at the nth element and adds the first part to the end.\n    Returns a new list with elements rotated.\n    \"\"\"\n    if not (0 <= n <= len(lst)):\n        raise IndexError(\"n is out of bounds for the list.\")\n    \n    first_part = lst[:n]\n    second_part = lst[n:]\n    return second_part + first_part"}
