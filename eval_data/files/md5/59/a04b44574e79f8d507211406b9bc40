      digit_sum += int(s[0] + s[1])\n            for i in range(2, len(s)):\n                digit_sum += int(s[i])\n        else:\n            # For positive numbers, sum all digits\n            for char_digit in s:\n                digit_sum += int(char_digit)\n        \n        if digit_sum > 0:\n            count += 1\n            \n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/109": [{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr):\n    \"\"\"Checks if an array can be sorted by right shifting.\n    Returns True if sortable, False otherwise, and True for an empty array.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return True\n\n    # Find the index of the minimum element.\n    # This index is where a sorted array would have been \"cut\" and rotated.\n    min_val = arr[0]\n    min_idx = 0\n    for i in range(1, n):\n        if arr[i] < min_val:\n            min_val = arr[i]\n            min_idx = i\n\n    # If the minimum element is at index 0, the array must be fully sorted\n    # to achieve non-decreasing order with zero right shifts.\n    if min_idx == 0:\n        for i in range(n - 1):\n            if arr[i] > arr[i+1]:\n                return False\n        return True\n    \n    # If min_idx > 0, the array is a candidate for a rotated sorted array.\n    # It must consist of two sorted segments: arr[min_idx:] and arr[:min_idx].\n    \n    # Check if the segment from min_idx to the end is sorted.\n    for i in range(min_idx, n - 1):\n        if arr[i] > arr[i+1]:\n            return False\n    \n    # Check if the segment from the beginning to min_idx-1 is sorted.\n    for i in range(min_idx - 1): # loop from 0 up to min_idx-2\n        if arr[i] > arr[i+1]:\n            return False\n            \n    # Finally, check the \"wrap-around\" condition.\n    # The last element of the original array (which would be at the end of the first segment after rotation