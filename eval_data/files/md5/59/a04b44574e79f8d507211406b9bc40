rder 1: s1 + s2\n    if _is_balanced(s1 + s2):\n        return 'Yes'\n\n    # Check order 2: s2 + s1\n    if _is_balanced(s2 + s1):\n        return 'Yes'\n\n    return 'No'", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/120": [{"task_id": "HumanEval/120", "solution": "class ValidationError(Exception):\n    \"\"\"Exception raised for invalid input to the maximum_k_numbers library.\"\"\"\n    pass\nclass InputArray:\n    \"\"\"Wraps a list of integers and provides its length.\"\"\"\n    def __init__(self, elements):\n        self._elements = elements\n        self.length = len(elements)\n\n    @property\n    def elements(self):\n        return self._elements\nclass ResultList:\n    \"\"\"Holds the resulting list of integers.\"\"\"\n    def __init__(self, elements):\n        self._elements = elements\n        self.length = len(elements)\n\n    @property\n    def elements(self):\n        return self._elements\nclass System:\n    \"\"\"Handles validation and computation of the top-k maximum numbers.\"\"\"\n    @staticmethod\n    def process(input_array: InputArray, k: int) -> ResultList:\n        \"\"\"Processes the input array and k to find the k maximum numbers.\"\"\"\n        arr = input_array.elements\n        arr_len = input_array.length\n\n        # Enforce Array Length (FR5)\n        if not (1 <= arr_len <= 1000):\n            raise ValidationError(\"Array length must be between 1 and 1000.\")\n\n        # Enforce Element Range (FR6)\n        for element_value in arr:\n            if not (-1000 <= element_value <= 1000):\n                raise ValidationError(\"Each array element must be between -1000 and 1000.\")\n\n        # Enforce k Range (FR7)\n        if not (0 <= k <= arr_len):\n            raise ValidationError(\"k must be between 0 and the array length inclusive.\")\n\n        # Handle k=0 (FR4)\n        if k == 0:\n            return ResultList([])\n\n        # Compute top-k elements (FR2, FR3) using sorting.\n        sorted_arr = sorted(arr)\n        top_k_elements = sorted_arr[-k:]\n        \n        return ResultList(top_k_elements)\ndef maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list \n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    input_arr_obj = InputArray(arr)\n    result_list_obj = System.process(input_arr_obj, k)\n    return result_list_obj.elements", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/124": [{"task_id": "HumanEval/124", "solution": "import re\n_MONTH_DAYS = {\n    1: 31, 2: 29, 3: 31, 4: 30,\n    5: 31, 6: 30, 7: 31, 8: 31,\n    9: 30,10: 31,11: 30,12: 31\n}\n_DATE_REGEX = re.compile(r\"^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])-(\\d{4})$\")\ndef valid_date(date):\n    \"\"\"You have to write a function which validates a given date string and\n    returns True if the date is valid otherwise False.\n    The date is valid if all of the following rules are satisfied:\n    1. The date string is not empty.\n    2. The number of days is not less than 1 or higher than 31 days for months 1,3,5,7,8,10,12. And the number of days is not less than 1 or higher than 30 days for months 4,6,9,11. And, the number of days is not less than 1 or higher than 29 for the month 2.\n    3. The months should not be less than 1 or higher than 12.\n    4. The date should be in the format: mm-dd-yyyy\n\n    for example: \n    valid_date('03-11-2000') => True\n\n    valid_date('15-01-2012') => False\n\n    valid_date('04-0-2040') => False\n\n    valid_date('06-04-2020') => True\n\n    valid_date('06/04/2020') => False\n    \"\"\"\n    if not date:\n        return False\n\n    match = _DATE_REGEX.match(date)\n    if not match:\n        return False\n\n    month, day, _ = map(int, match.groups())\n\n    if month < 1 or month > 12: # This is largely redundant due to regex but explicitly covers the rule.\n        return False\n\