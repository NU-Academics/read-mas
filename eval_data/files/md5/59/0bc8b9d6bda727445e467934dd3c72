{"task_id": "HumanEval/24", "solution": "import math\nclass DivisorCalculator:\n    \"\"\"Computes the largest proper divisor and provides a prime check.\"\"\"\n    def is_prime(self, n: int) -> bool:\n        \"\"\"Checks if a number is prime.\"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\n\n    def largest_divisor(self, n: int) -> int:\n        \"\"\"Finds the largest number that divides n evenly, smaller than n.\"\"\"\n        if self.is_prime(n):\n            return 1\n\n        for i in range(n // 2, 0, -1):\n            if n % i == 0:\n                return i\n        # This point should be unreachable for n > 1 based on the logic.\ndef largest_divisor(n: int) -> int:\n    \"\"\" For a given number n, find the largest number that divides n evenly, smaller than n\n    >>> largest_divisor(15)\n    5\n    \"\"\"\n    if n <= 1:\n        raise ValueError(\"n must be an integer greater than 1\")\n\n    calculator = DivisorCalculator()\n    return calculator.largest_divisor(n)"}
{"task_id": "HumanEval/26", "solution": "def remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    >>> remove_duplicates([1, 2, 3, 2, 4])\n    [1, 3, 4]\n    \"\"\"\n\n    class FrequencyMap:\n        \"\"\"Helper class to count frequencies of elements.\"\"\"\n        from typing import Dict # Import needed here if class is nested.\n        def __init__(self) -> None:\n            self._frequencies: Dict[int, int] = {}\n\n        def increment(self, value: int) -> None:\n            self._frequencies[value] = self._frequencies.get(value, 0) + 1\n\n        def get(self, value: int) -> int:\n            return self._frequencies.get(value, 0)\n\n    freq_map = FrequencyMap()\n    for num in numbers:\n        freq_map.increment(num)\n\n    result_list: List[int] = []\n    for num in numbers:\n        if freq_map.get(num) == 1:\n            result_list.append(num)\n\n    return result_list"}
{"task_id": "HumanEval/25", "solution": "from typing import List\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n\n    class PrimeFactor:\n        def __init__(self, value: int, multiplicity: int) -> None:\n            self.value = value\n            self.multiplicity = multiplicity\n\n    class InputValidator:\n        def __init__(self) -> None:\n            pass\n\n        def validate(self, n: int) -> bool:\n            return isinstance(n, int) and n >= 1\n\n    class PrimeFactorGenerator:\n        def __init__(self) -> None:\n            pass\n\n        def generate(self, n: int) -> List[PrimeFactor]:\n            if n == 1:\n                return []\n\n            prime_factors: List[PrimeFactor] = []\n            temp_n = n\n            divisor = 2\n\n            while divisor * divisor <= temp_n:\n                if temp_n % divisor == 0:\n                    multiplicity = 0\n                    while temp_n % divisor == 0:\n                        multiplicity += 1\n                        temp_n //= divisor\n                    prime_factors.append(PrimeFactor(divisor, multiplicity))\n                divisor += 1\n\n            if temp_n > 1:\n                prime_factors.append(PrimeFactor(temp_n, 1))\n\n            return prime_factors\n\n    class FactorizationResult:\n        def __init__(self, factors: List[int]) -> None:\n            self.factors = factors\n\n        def product(self) -> int:\n            if not self.factors:\n                return 1\n            res = 1\n            for factor in self.factors:\n                res *= factor\n            return res\n\n    class FactorizationService:\n        def __init__(self) -> None:\n            self._validator = InputValidator()\n            self._generator = PrimeFactorGenerator()\n\n        def factorize(self, n: int) -> List[int]:\n            if not self._validator.validate(n):\n                raise ValueError(\"invalid input\")\n\n            prime_factors_with_multiplicity = self._generator.generate(n)\n\n            factors_list: List[int] = []\n            for pf in prime_factors_with_multiplicity:\n                factors_list.extend([pf.value] * pf.multiplicity)\n\n            result = FactorizationResult(factors_list)\n\n            if result.product() != n:\n                raise RuntimeError(\"factorization product mismatch\")\n\n            return result.factors\n\n    service = FactorizationService()\n    return service.factorize(n)"}
{"task_id": "HumanEval/27", "solution": "class CharacterUnit:\n    \"\"\"Encapsulates single-character predicates and conversions.\"\"\"\n    def __init__(self, char: str):\n        self.char = char\n\n    def is_alpha(self) -> bool:\n        \"\"\"Checks if the character is an alphabet.\"\"\"\n        return self.char.isalpha()\n\n    def is_upper(self) -> bool:\n        \"\"\"Checks if the character is uppercase.\"\"\"\n        return self.char.isupper()\n\n    def is_lower(self) -> bool:\n        \"\"\"Checks if the character is lowercase.\"\"\"\n        return self.char.islower()\n\n    def to_upper(self) -> str:\n        \"\"\"Converts the character to uppercase.\"\"\"\n        return self.char.upper()\n\n    def to_lower(self) -> str:\n        \"\"\"Converts the character to lowercase.\"\"\"\n        return self.char.lower()\nclass InputString:\n    \"\"\"Thin wrapper around input str; provides length accessor.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the string.\"\"\"\n        return len(self.value)\nclass OutputString:\n    \"\"\"Thin wrapper for returned string value; provides length accessor.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the string.\"\"\"\n        return len(self.value)\nclass FlipCaseService:\n    \"\"\"Core transformation logic; stateless service implementing per-character rules.\"\"\"\n    def flip_case(self, string: str) -> str:\n        \"\"\"Flips the case of alphabetic characters in a string.\"\"\"\n        if not string:\n            return \"\"\n\n        input_str_obj = InputString(string)\n        result_chars = []\n\n        for char in input_str_obj.value:\n            char_unit = CharacterUnit(char)\n            if char_unit.is_alpha():\n                if char_unit.is_upper():\n                    result_chars.append(char_unit.to_lower())\n                else: # If alpha and not upper, it must be lower\n                    result_chars.append(char_unit.to_upper())\n            else:\n                result_chars.append(char)\n        \n        final_string = \"\".join(result_chars)\n        output_str_obj = OutputString(final_string)\n        return output_str_obj.value\ndef flip_case(string: str) -> str:\n    \"\"\" For a given string, flip lowercase characters to uppercase and uppercase to lowercase.\n    >>> flip_case('Hello')\n    'hELLO'\n    \"\"\"\n    service = FlipCaseService()\n    return service.flip_case(string)"}
{"task_id": "HumanEval/28", "solution": "def concatenate(strings: List[str]) -> str:\n    \"\"\" Concatenate list of strings into a single string\n    >>> concatenate([])\n    ''\n    >>> concatenate(['a', 'b', 'c'])\n    'abc'\n    \"\"\"\n    return ''.join(strings)"}
{"task_id": "HumanEval/29", "solution": "from typing import List\ndef filter_by_prefix(strings: List[str], prefix: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that start with a given prefix.\n    >>> filter_by_prefix([], 'a')\n    []\n    >>> filter_by_prefix(['abc', 'bcd', 'cde', 'array'], 'a')\n    ['abc', 'array']\n    \"\"\"\n    filtered_strings = []\n    for s in strings:\n        if s.startswith(prefix):\n            filtered_strings.append(s)\n    return filtered_strings"}
{"task_id": "HumanEval/30", "solution": "def get_positive(l: list):\n    \"\"\"Return only positive numbers in the list.\n    >>> get_positive([-1, 2, -4, 5, 6])\n    [2, 5, 6]\n    >>> get_positive([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    [5, 3, 2, 3, 9, 123, 1]\n    \"\"\"\n    # Create a new list containing only elements from l that are strictly greater than 0.\n    return [num for num in l if num > 0]"}
{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    \"\"\"\n    import math\n\n    class Number:\n        def __init__(self, value: int):\n            self.value = value\n\n    class InputValidator:\n        @staticmethod\n        def validate_integer(n) -> bool:\n            return isinstance(n, int)\n\n    class PrimeChecker:\n        @staticmethod\n        def is_prime(num) -> bool:\n            if num <= 1:\n                return False\n            if num == 2:\n                return True\n            if num % 2 == 0:\n                return False\n            \n            limit = math.isqrt(num)\n            for i in range(3, limit + 1, 2):\n                if num % i == 0:\n                    return False\n            return True\n\n    class PrimeTestResult:\n        def __init__(self, is_prime: bool):\n            self.is_prime = is_prime\n\n    if not InputValidator.validate_integer(n):\n        raise TypeError(\"n must be an integer\")\n    \n    result_bool = PrimeChecker.is_prime(n)\n    return PrimeTestResult(result_bool).is_prime"}
{"task_id": "HumanEval/34", "solution": "def _extract_unique_sorted(l: list) -> list:\n    \"\"\"Compute unique elements and return them sorted.\"\"\"\n    unique_elements = []\n    # Deduplicate elements by equality using a first-seen approach.\n    for item in l:\n        if item not in unique_elements:\n            unique_elements.append(item)\n    # Sort the unique elements. This relies on elements being mutually comparable.\n    return sorted(unique_elements)\ndef unique(l: list):\n    \"\"\"Return sorted unique elements in a list\n    >>> unique([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [0, 2, 3, 5, 9, 123]\n    \"\"\"\n    _validate_input(l)\n    return _extract_unique_sorted(l)"}
{"task_id": "HumanEval/33", "solution": "class ComparabilityError(Exception):\n    \"\"\"Raised when elements at indices divisible by three are not mutually comparable.\"\"\"\n    pass\ndef sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    if not l:\n        return []\n\n    result = list(l)  # Create a shallow copy to avoid modifying the input list.\n    target_indices = [i for i in range(len(l)) if i % 3 == 0]\n    target_values = [l[i] for i in target_indices]\n\n    try:\n        sorted_values = sorted(target_values)\n    except TypeError as err:\n        raise ComparabilityError(\"Elements at indices divisible by three are not mutually comparable.\") from err\n\n    for i, original_index in enumerate(target_indices):\n        result[original_index] = sorted_values[i]\n\n    return result"}
{"task_id": "HumanEval/35", "solution": "def max_element(l: list):\n    \"\"\"Return maximum element in the list.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"Input must be a list.\")\n    return max(l)"}
{"task_id": "HumanEval/32", "solution": "def _trim_trailing_zeros(xs: list) -> list:\n    \"\"\"Removes trailing zero coefficients from the list.\"\"\"\n    trimmed_xs = list(xs)\n    while len(trimmed_xs) > 1 and float(trimmed_xs[-1]) == 0.0:\n        trimmed_xs.pop()\n    return trimmed_xs\ndef _validate_and_prepare(xs: list) -> list:\n    \"\"\"\n    Validates input coefficients, converts to float, trims trailing zeros,\n    and checks for even length and non-zero highest coefficient.\n    \"\"\"\n    if not isinstance(xs, (list, tuple)):\n        raise TypeError(\"Coefficients 'xs' must be a list or sequence.\")\n\n    if not xs:\n        raise ValueError(\"Coefficients 'xs' cannot be empty.\")\n\n    prepared_xs = []\n    for i, val in enumerate(xs):\n        try:\n            prepared_xs.append(float(val))\n        except (TypeError, ValueError) as e:\n            raise TypeError(f\"Coefficient at index {i} is not numeric: {val}\") from e\n\n    trimmed_xs = _trim_trailing_zeros(prepared_xs)\n\n    if not trimmed_xs or (len(trimmed_xs) == 1 and trimmed_xs[0] == 0.0):\n        raise ValueError(\"Highest-degree coefficient is zero after trimming (degenerate polynomial).\")\n\n    if len(trimmed_xs) % 2 != 0:\n        raise ValueError(\"Number of coefficients must be even after trimming trailing zeros.\")\n\n    return trimmed_xs\ndef _find_bracket(xs: list) -> tuple[float, float]:\n    \"\"\"\n    Deterministically expands symmetric bounds from [-1.0, 1.0] until a sign change is found.\n    \"\"\"\n    a = -1.0\n    b = 1.0\n    MAX_EXPANSIONS = 100 # Safety limit for bracket search\n    \n    val_a = poly(xs, a)\n    val_b = poly(xs, b)\n\n    if val_a == 0.0:\n        return a, a\n    if val_b == 0.0:\n        return b, b\n    if val_a * val_b < 0:\n        return a, b\n\n    for _ in range(MAX_EXPANSIONS):\n        a *= 2.0\n        b *= 2.0\n        val_a = poly(xs, a)\n        val_b = poly(xs, b)\n\n        if val_a == 0.0:\n            return a, a\n        if val_b == 0.0:\n            return b, b\n        \n        if val_a * val_b < 0:\n            return a, b\n    \n    raise RuntimeError(\"Could not find a bracket within deterministic expansion limits.\")\ndef _bisection(xs: list, a: float, b: float, tol: float) -> float:\n    \"\"\"\n    Performs deterministic bisection to find a root within the interval [a, b].\n    \"\"\"\n    val_a = poly(xs, a)\n    # val_b = poly(xs, b) # Not needed to initialize explicitly for logic flow\n\n    MAX_BISECTION_ITERATIONS = 1000 # Safety limit for bisection\n\n    for _ in range(MAX_BISECTION_ITERATIONS):\n        mid = (a + b) / 2.0\n        val_mid = poly(xs, mid)\n\n        if abs(val_mid) <= tol:\n            return mid\n\n        if val_a * val_mid < 0: # Root is in [a, mid]\n            b = mid\n            # val_b is conceptually updated but not explicitly used in next iteration's condition\n        else: # Root is in [mid, b]\n            a = mid\n            val_a = val_mid # Update val_a for the next iteration\n\n    # If tolerance is not met within max iterations, return the midpoint of the last interval\n    return (a + b) / 2.0\nTOLERANCE = 1e-9\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    processed_xs = _validate_and_prepare(xs)\n    a, b = _find_bracket(processed_xs)\n    \n    if a == b: # If a root was found exactly at the bracket boundary\n        return a\n\n    return _bisection(processed_xs, a, b, TOLERANCE)"}
{"task_id": "HumanEval/36", "solution": "class IntegerCandidate:\n    def __init__(self, value: int):\n        self.value = value\n\n    def isDivisibleBy(self, divisor: int) -> bool:\n        return self.value % divisor == 0\n\n    def countDigit(self, digit: int) -> int:\n        # Converts the integer to a string to count digit occurrences.\n        return str(self.value).count(str(digit))\nclass Result:\n    def __init__(self):\n        self.totalCount = 0\n\n    def add(self, count: int) -> None:\n        self.totalCount += count\n\n    def value(self) -> int:\n        return self.totalCount\nclass DigitCounter:\n    def countOccurrences(self, n: int) -> int:\n        result_aggregator = Result()\n        for m in range(n):\n            candidate = IntegerCandidate(m)\n            if candidate.isDivisibleBy(11) or candidate.isDivisibleBy(13):\n                # Counts digit '7' for selected candidates and adds to total.\n                c = candidate.countDigit(7)\n                result_aggregator.add(c)\n        return result_aggregator.value()\ndef fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    # The 'n: int' type hint implies 'n' is always an integer.\n    # Given constraints, we directly proceed to count occurrences.\n    return DigitCounter().countOccurrences(n)"}
{"task_id": "HumanEval/39", "solution": "import math\nclass PrimeChecker:\n    \"\"\"Provides utilities for primality testing.\"\"\"\n    def is_prime(self, x: int) -> bool:\n        \"\"\"Checks if a given integer x is a prime number using trial division.\"\"\"\n        if x < 2:\n            return False\n        if x == 2 or x == 3:\n            return True\n        if x % 2 == 0:\n            return False\n        i = 3\n        while i * i <= x:\n            if x % i == 0:\n                return False\n            i += 2\n        return True\nclass FibonacciSequence:\n    \"\"\"Generates Fibonacci numbers sequentially.\"\"\"\n    def __init__(self):\n        self._a = 0\n        self._b = 1\n\n    def next_term(self) -> int:\n        \"\"\"Returns the next Fibonacci number in the sequence.\"\"\"\n        current_fib = self._b\n        self._a, self._b = self._b, self._a + self._b\n        return current_fib\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    fib_sequence = FibonacciSequence()\n    prime_checker = PrimeChecker()\n    found_primes_count = 0\n\n    while True:\n        fib_num = fib_sequence.next_term()\n        if prime_checker.is_prime(fib_num):\n            found_primes_count += 1\n            if found_primes_count == n:\n                return fib_num"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # right-cycle elements in each group to decode. Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n\n    class InputList:\n        def __init__(self, elements: list):\n            self.elements = elements\n        def length(self) -> int:\n            return len(self.elements)\n        def get_even_indices(self) -> list:\n            return [self.elements[i] for i in range(0, len(self.elements), 2)]\n        def get_odd_indices(self) -> list:\n            return [self.elements[i] for i in range(1, len(self.elements), 2)]\n\n    class EvenElements:\n        def __init__(self, values: list):\n            self.values = values\n        def count(self) -> int:\n            return len(self.values)\n        def is_comparable(self) -> bool:\n            if self.count() <= 1:\n                return True\n            try:\n                sorted(self.values) # Attempt to sort a copy to check comparability\n                return True\n            except TypeError:\n                return False\n        def sort(self) -> 'SortedEvenElements':\n            return SortedEvenElements(sorted(self.values))\n\n    class SortedEvenElements:\n        def __init__(self, values: list):\n            self.values = values\n\n    class OddElements:\n        def __init__(self, values: list):\n            self.values = values\n\n    class OutputList:\n        def __init__(self, length: int):\n            self.elements = [None] * length\n        def length(self) -> int:\n            return len(self.elements)\n\n    input_list_obj = InputList(l)\n    \n    even_values_extracted = input_list_obj.get_even_indices()\n    odd_values_extracted = input_list_obj.get_odd_indices()\n\n    even_elements_obj = EvenElements(even_values_extracted)\n    odd_elements_obj = OddElements(odd_values_extracted)\n\n    if not even_elements_obj.is_comparable():\n        raise TypeError(\"Even-indexed elements are not mutually comparable.\")\n\n    sorted_even_obj = even_elements_obj.sort()\n\n    output_list_obj = OutputList(input_list_obj.length())\n\n    current_sorted_even_idx = 0\n    current_odd_idx = 0\n    for i in range(input_list_obj.length()):\n        if i % 2 == 0:\n            output_list_obj.elements[i] = sorted_even_obj.values[current_sorted_even_idx]\n            current_sorted_even_idx += 1\n        else:\n            output_list_obj.elements[i] = odd_elements_obj.values[current_odd_idx]\n            current_odd_idx += 1\n            \n    return output_list_obj.elements"}
