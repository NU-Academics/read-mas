{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    This function efficiently computes the n-th element of the fib4 number sequence iteratively using a sliding window.\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # Initialize the sliding window with the first four Fib4 numbers: fib4(0), fib4(1), fib4(2), fib4(3)\n    window = [0, 0, 2, 0]\n\n    # Iteratively compute Fib4 numbers from n=4 up to the desired n\n    for _ in range(4, n + 1):\n        next_fib4_value = sum(window)\n        # Shift the window: remove the oldest value and add the new one\n        window.pop(0)\n        window.append(next_fib4_value)\n\n    # The last element in the window is fib4(n)\n    return window[-1]"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n\n    class NumericElement:\n        \"\"\"Represents a numeric element, primarily for type consistency.\"\"\"\n        def __init__(self, value):\n            if not isinstance(value, (int, float)):\n                raise ValueError(\"Element must be numeric.\")\n            self.value = float(value) # Store all as float for consistency\n\n        def __lt__(self, other):\n            return self.value < other.value\n\n        def __repr__(self):\n            return f\"NumericElement({self.value})\"\n\n    class InputList:\n        \"\"\"Wraps a raw list and converts elements to NumericElement.\"\"\"\n        def __init__(self, elements):\n            self.elements = elements\n\n        @classmethod\n        def from_raw(cls, raw_list):\n            if not isinstance(raw_list, list):\n                raise ValueError(\"Input must be a list.\")\n            if not raw_list:\n                raise ValueError(\"Input list cannot be empty.\")\n            elements = [NumericElement(item) for item in raw_list]\n            return cls(elements)\n\n        def length(self):\n            return len(self.elements)\n\n    class MEDIAN_RESULT:\n        \"\"\"Holds the computed median value and its type (odd/even length).\"\"\"\n        def __init__(self, value: float, type: str):\n            self.value = value\n            self.type = type\n\n    class Sorter:\n        \"\"\"Provides a static method to sort a list of NumericElement objects.\"\"\"\n        @staticmethod\n        def sort(elements: list[NumericElement]) -> list[NumericElement]:\n            return sorted(elements)\n\n    class Statistics:\n        \"\"\"Provides a static method to compute the arithmetic mean.\"\"\"\n        @staticmethod\n        def arithmetic_mean(a: float, b: float) -> float:\n            return (a + b) / 2.0\n\n    class MedianCalculator:\n        \"\"\"Calculates the median using injected Sorter and Statistics utilities.\"\"\"\n        def __init__(self, sorter: Sorter, statistics: Statistics):\n            self.sorter = sorter\n            self.statistics = statistics\n\n        def compute_median(self, elements: list[NumericElement]) -> MEDIAN_RESULT:\n            sorted_elements = self.sorter.sort(elements)\n            n = len(sorted_elements)\n\n            if n % 2 == 1:\n                # Odd length, return middle element\n                middle_idx = n // 2\n                return MEDIAN_RESULT(sorted_elements[middle_idx].value, 'odd')\n            else:\n                # Even length, return mean of two middle elements\n                right_middle_idx = n // 2\n                left_middle_idx = right_middle_idx - 1\n                mean_value = self.statistics.arithmetic_mean(\n                    sorted_elements[left_middle_idx].value,\n                    sorted_elements[right_middle_idx].value\n                )\n                return MEDIAN_RESULT(mean_value, 'even')\n\n    # Main orchestration logic\n    input_list_obj = InputList.from_raw(l)\n    calculator = MedianCalculator(sorter=Sorter(), statistics=Statistics())\n    result = calculator.compute_median(input_list_obj.elements)\n    return result.value"}
