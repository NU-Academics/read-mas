{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    >>> pairs_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> pairs_sum_to_zero([1, 3, -2, 1])\n    False\n    >>> pairs_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> pairs_sum_to_zero([2, 4, -5, 3, 5, 7])\n    True\n    >>> pairs_sum_to_zero([1])\n    False\n    \"\"\"\n    from typing import List, Optional\n\n    class InputList:\n        def __init__(self, elements: List[int]):\n            self.elements = elements\n\n        def length(self) -> int:\n            return len(self.elements)\n\n        def validate(self) -> bool:\n            \"\"\"Validates if the input is a list of integers.\"\"\"\n            if not isinstance(self.elements, list):\n                return False\n            for item in self.elements:\n                if not isinstance(item, int):\n                    return False\n            return True\n\n    class Element:\n        def __init__(self, value: int, index: int):\n            self.value = value\n            self.index = index\n\n    class Pair:\n        def __init__(self, a: Element, b: Element):\n            self.a = a\n            self.b = b\n\n        def sum(self) -> int:\n            return self.a.value + self.b.value\n\n    class PairFinder:\n        def find_pair_sum_zero(self, input_list: InputList) -> bool:\n            \"\"\"Searches for two distinct elements in the list that sum to zero.\"\"\"\n            n = input_list.length()\n            elements_data = input_list.elements\n\n            for i in range(n):\n                for j in range(i + 1, n):\n                    if elements_data[i] + elements_data[j] == 0:\n                        return True\n            return False\n\n    input_list = InputList(elements=l)\n\n    if not input_list.validate():\n        raise TypeError(\"Input must be a list of integers\")\n\n    if input_list.length() < 2:\n        return False\n\n    return PairFinder().find_pair_sum_zero(input_list)"}
{"task_id": "HumanEval/40", "solution": "from typing import List\nclass InputList:\n    \"\"\"Encapsulate input values and implement validation and core algorithm.\"\"\"\n    def __init__(self, values: List[int]):\n        self.values = values\n\n    def validate_length(self) -> bool:\n        \"\"\"Returns True if the list has at least three elements.\"\"\"\n        return len(self.values) >= 3\n\n    def validate_integers(self) -> bool:\n        \"\"\"Performs an optional lightweight check for integer elements.\"\"\"\n        # Per design, behavior for non-integers is unspecified and\n        # 'isinstance' checks are disallowed by prompt. We assume valid input.\n        return True\n\n    def find_triplet_zero(self) -> bool:\n        \"\"\"Finds if any three distinct-indexed elements sum to zero.\"\"\"\n        n = len(self.values)\n        # Using three nested loops to ensure distinct indices i, j, k\n        for i in range(n - 2):\n            for j in range(i + 1, n - 1):\n                for k in range(j + 1, n):\n                    if self.values[i] + self.values[j] + self.values[k] == 0:\n                        return True\n        return False\ndef triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n\n    >>> triples_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> triples_sum_to_zero([1, 3, -2, 1])\n    True\n    >>> triples_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> triples_sum_to_zero([2, 4, -5, 3, 9, 7])\n    True\n    >>> triples_sum_to_zero([1])\n    False\n    \"\"\"\n    input_list_wrapper = InputList(l)\n\n    if not input_list_wrapper.validate_length():\n        return False\n\n    # As per design, validate_integers is optional and behavior for non-integers unspecified.\n    # The current constraints also prevent actual type checking, so it is omitted.\n\n    result_exists = input_list_wrapper.find_triplet_zero()\n    # The design models a 'Result' class, but the function signature requires a boolean return.\n    return result_exists"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    class Number:\n        def __init__(self, value: int):\n            self.value = value\n\n        def isNonNegative(self) -> bool:\n            return self.value >= 0\n\n    class Base:\n        def __init__(self, value: int):\n            self.value = value\n\n        def isValid(self) -> bool:\n            return 2 <= self.value < 10\n\n    class ConversionResult:\n        def __init__(self, representation: str):\n            self.representation = representation\n\n    class ChangeBaseFunction:\n        def convert(self, number_obj: Number, base_obj: Base) -> ConversionResult:\n            if not base_obj.isValid():\n                raise ValueError(\"Invalid base. Base must be between 2 and 9 (inclusive).\")\n\n            x_val = number_obj.value\n            base_val = base_obj.value\n\n            if x_val == 0:\n                return ConversionResult(\"0\")\n            \n            # The behavior for negative x is unspecified. For positive numbers,\n            # this loop extracts digits using modulo and division.\n            digits = []\n            current_x = x_val\n            while current_x > 0:\n                remainder = current_x % base_val\n                digits.append(str(remainder))\n                current_x //= base_val\n            \n            return ConversionResult(\"\".join(digits[::-1]))\n\n    number_instance = Number(x)\n    base_instance = Base(base)\n    converter = ChangeBaseFunction()\n    \n    result = converter.convert(number_instance, base_instance)\n    \n    return result.representation"}
