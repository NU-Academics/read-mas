esult.to_list()"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and \n    the second list is a list of integers. Use the two given lists to build the algebric \n    expression and return the evaluation of this expression.\n\n    The basic algebra operations:\n    Addition ( + ) \n    Subtraction ( - ) \n    Multiplication ( * ) \n    Floor division ( // ) \n    Exponentiation ( ** ) \n\n    Example:\n    operator['+', '*', '-']\n    array = [2, 3, 4, 5]\n    result = 2 + 3 * 4 - 5\n    => result = 9\n\n    Note:\n        The length of operator list is equal to the length of operand list minus one.\n        Operand is a list of of non-negative integers.\n        Operator list has at least one operator, and operand list has at least two operands.\n\n    \"\"\"\n    # Validate lengths of operator and operand lists.\n    if not (len(operator) == len(operand) - 1 and len(operator) >= 1 and len(operand) >= 2):\n        raise ValueError(\"Invalid lengths: len(operator) must be len(operand) - 1, and len(operator) >= 1, len(operand) >= 2.\")\n\n    # Validate operators.\n    allowed_operators = {'+', '-', '*', '//', '**'}\n    for op_sym in operator:\n        if not isinstance(op_sym, str) or op_sym not in allowed_operators:\n            raise ValueError(f\"Invalid operator '{op_sym}'. Allowed operators are {allowed_operators}.\")\n\n    # Validate operands.\n    for op_val in operand:\n        if not isinstance(op_val, int) or op_val < 0:\n            raise ValueError(f\"Invalid operand '{op_val}'. Operands must be non-negative integers.\")\n\n    # Build the algebraic expression string.\n    expression_parts = []\n    for i in range(len(operator)):\n        expression_parts.append(str(operand[i]))\n        expression_parts.append(operator[i])\n    expression_parts.append(str(operand[-1]))\n    expression_string = \" \".join(expression_parts)\n\n    # Evaluate the expression, handling ZeroDivisionError explicitly.\n    try:\n        result = eval(expression_string)\n    except ZeroDivisionError:\n        raise # Re-raise ZeroDivisionError directly.\n\n    return result"}
{"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    \n    # Encode the string to bytes using UTF-8, then compute MD5 hash.\n    md5_hash = hashlib.md5(text.encode('utf-8')).hexdigest()\n    return md5_hash"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"Reverses case for letters, keeps non-letters as is, or reverses the whole string if no letters are present.\"\"\"\n    \n    has_letters = False\n    for char_s in s:\n        if char_s.isalpha():\n            has_letters = True\n            break\n\n    if not has_letters:\n        return s[::-1]\n    else:\n        transformed_chars = []\n        for char_s in s:\n            if char_s.isalpha():\n                if char_s.isupper():\n                    transformed_chars.append(char_s.lower())\n                else:\n                    transformed_chars.append(char_s.upper())\n            else:\n                transformed_chars.append(char_s)\n        return \"\".join(transformed_chars)"}
{"task_id": "HumanEval/163", "solution": "from typing import List, Set\nCANDIDATE_DIGITS: Set[int] = {0, 2, 4, 6, 8}\nclass InputParameters:\n    \"\"\"Represents and validates the two input integers a and b.\"\"\"\n    def __init__(self, a: int, b: int) -> None:\n        self.a = a\n        self.b = b\n\n    def validatePositive(self) -> bool:\n        \"\"\"Returns True if both a and b are positive integers.\"\"\"\n        return self.a > 0 and self.b > 0\nclass Interval:\n    \"\"\"Represents a normalized inclusive interval [low, high] and provides membership checks.\"\"\"\n    def __init__(self, low: int, high: int) -> None:\n        self.low = low\n        self.high = high\n\n    @staticmethod\n    def normalize(a: int, b: int) -> 'Interval':\n        \"\"\"Returns an Interval instance with low=min(a,b) and high=max(a,b).\"\"\"\n        return Interval(min(a, b), max(a, b))\n\n    def contains(self, value: int) -> bool:\n        \"\"\"Returns True if the value is within the inclusive interval.\"\"\"\n        return self.low <= value <= self.high\nclass ResultList:\n    \"\"\"Collects selected integers, ensures uniqueness, and ascending order.\"\"\"\n    def __init__(self) -> None:\n        self.values: List[int] = []\n\n    def removeDuplicates(self) -> None:\n        \"\"\"Mutates the values list to remove duplicate entries.\"\"\"\n        self.values = list(dict.fromkeys(self.values)) # Preserves order in Python 3.7+\n\n    def sortAscending(self) -> None:\n        \"\"\"Mutates the values list to sort entries in ascending order.\"\"\"\n        self.values.sort()\ndef generate_integers(a, b) -> List[int]:\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n\n    For example:\n    generate_integers(2, 8) => [2, 4, 6, 8]\n    generate_integers(8, 2) => [2, 4, 6, 8]\n    generate_integers(10, 14) => []\n    \"\"\"\n    input_params = InputParameters(a, b)\n    # Per design, caller ensures a, b are positive. validatePositive is for traceability.\n    # input_params.validatePositive() # No explicit check or error raising per instructions.\n\n    interval = Interval.normalize(input_params.a, input_params.b)\n    \n    result_list = ResultList()\n\n    for digit in CANDIDATE_DIGITS:\n        # EvenDigit class for traceability, but checks are implicit in CANDIDATE_DIGITS\n        # even_digit = EvenDigit(digit)\n        # if even_digit.isSingleDigit() and even_digit.isEven(): # These are always true for CANDIDATE_DIGITS\n        if interval.contains(digit):\n            result_list.values.append(digit)\n\n    result_list.removeDuplicates()\n    result_list.sortAscending()\n\n    return result_list.values"}
