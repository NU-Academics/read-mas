{"task_id": "Mbpp/57", "solution": "def find_Max_Num(digits: list[int]) -> int:\n    \"\"\"\n    Finds the largest number that can be formed with the given list of digits.\n    Converts digits to strings, sorts them in descending order, joins them, and converts back to an integer.\n    \"\"\"\n    str_digits = [str(d) for d in digits]\n    str_digits.sort(reverse=True)\n    largest_num_str = \"\".join(str_digits)\n    return int(largest_num_str)"}
{"task_id": "Mbpp/58", "solution": "def opposite_Signs(int1: int, int2: int) -> bool:\n    \"\"\"Checks if two integers have opposite signs.\n    Returns True if one is strictly positive and the other is strictly negative.\"\"\"\n    return (int1 > 0 and int2 < 0) or (int1 < 0 and int2 > 0)"}
{"task_id": "Mbpp/59", "solution": "def is_octagonal(n):\n    \"\"\"Calculates the nth octagonal number.\n\n    The formula for the nth octagonal number is n * (3n - 2).\n    \"\"\"\n    return n * (3 * n - 2)"}
{"task_id": "Mbpp/62", "solution": "def smallest_num(numbers: list) -> float:\n    \"\"\"Finds the smallest number in a list of numeric values.\n\n    Assumes the input list 'numbers' is not empty and contains only numeric types.\n    \"\"\"\n    min_value = numbers[0]\n    for num in numbers:\n        if num < min_value:\n            min_value = num\n    return min_value"}
{"task_id": "Mbpp/61", "solution": "def count_Substrings(s: str) -> int:\n    \"\"\"\n    Counts the number of substrings in 's' where the sum of their digits equals their length.\n    \"\"\"\n    def _calculate_digit_sum(sub: str) -> int:\n        \"\"\"Calculates the sum of numerical digits in a given string.\"\"\"\n        total_sum = 0\n        for char in sub:\n            total_sum += int(char)\n        return total_sum\n\n    count = 0\n    n = len(s)\n    for i in range(n):\n        for j in range(i, n):\n            substring = s[i:j+1]\n            substring_length = len(substring)\n            digit_sum = _calculate_digit_sum(substring)\n            if digit_sum == substring_length:\n                count += 1\n    return count"}
{"task_id": "Mbpp/66", "solution": "def pos_count(numbers_list: list) -> int:\n    \"\"\"Counts the number of positive numbers in a list.\n\n    Iterates through the list and increments a counter for each number greater than zero.\n    \"\"\"\n    count = 0\n    for number in numbers_list:\n        if number > 0:\n            count += 1\n    return count"}
{"task_id": "Mbpp/65", "solution": "def recursive_list_sum(input_list: list) -> int | float:\n    \"\"\"\n    Flattens a given nested list and calculates the sum of all numerical elements within it.\n    It recursively traverses the list, summing numbers and further flattening nested lists.\n    \"\"\"\n    total_sum = 0\n    for element in input_list:\n        if isinstance(element, list):\n            total_sum += recursive_list_sum(element)\n        elif isinstance(element, (int, float)):\n            total_sum += element\n    return total_sum"}
