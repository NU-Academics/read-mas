{"task_id": "Mbpp/63", "solution": "from typing import Union\n\nclass NumericalPair:\n    \"\"\"\n    Encapsulates two numerical values and calculates their absolute difference.\n    \"\"\"\n    def __init__(self, val1: Union[int, float], val2: Union[int, float]):\n        self.value1 = val1\n        self.value2 = val2\n\n    def get_absolute_difference(self) -> int:\n        \"\"\"\n        Calculates and returns the absolute difference between value1 and value2.\n        \"\"\"\n        return int(abs(self.value1 - self.value2))\n\ndef max_difference(tuple_list: list[tuple[Union[int, float], Union[int, float]]]) -> int:\n    \"\"\"\n    Calculates the maximum absolute difference from a list of numerical pairs.\n    Initializes max_diff to 0 and updates it by iterating through each pair.\n    \"\"\"\n    max_diff = 0\n    for val1, val2 in tuple_list:\n        pair = NumericalPair(val1, val2)\n        current_difference = pair.get_absolute_difference()\n        if current_difference > max_diff:\n            max_diff = current_difference\n    return max_diff"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(array):\n    \"\"\"\n    Checks if the given array is monotonic (either monotonically increasing or decreasing).\n    An array is monotonic if its elements are consistently non-decreasing or consistently non-increasing.\n    \"\"\"\n    if len(array) <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(1, len(array)):\n        if array[i] < array[i - 1]:\n            is_increasing = False\n        if array[i] > array[i - 1]:\n            is_decreasing = False\n        \n        # Optimization: if both flags become False, it's neither increasing nor decreasing\n        if not is_increasing and not is_decreasing:\n            return False\n\n    return is_increasing or is_decreasing"}
{"task_id": "Mbpp/67", "solution": "_bell_cache = {0: 1, 1: 1}\n\ndef bell_number(n: int) -> int:\n    \"\"\"Calculates the nth Bell number, B(n), using dynamic programming with memoization.\n    This function implements the calculation of Bell numbers based on Stirling numbers of the second kind.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Bell number index must be non-negative.\")\n    if n in _bell_cache:\n        return _bell_cache[n]\n\n    stirling_cache = [[0] * (n + 1) for _ in range(n + 1)]\n    stirling_cache[0][0] = 1\n\n    for i in range(1, n + 1):\n        for j in range(1, i + 1):\n            stirling_cache[i][j] = stirling_cache[i - 1][j - 1] + j * stirling_cache[i - 1][j]\n\n    bell_n = sum(stirling_cache[n][k] for k in range(n + 1))\n    _bell_cache[n] = bell_n\n    return bell_n"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list: list, sub_list: list) -> bool:\n    \"\"\"\n    Checks if a sub_list is a contiguous sequence within a main_list.\n    Returns True if sub_list is found contiguously in main_list, False otherwise.\n    \"\"\"\n    if not sub_list:\n        return True\n\n    if not main_list:\n        return False\n\n    n = len(main_list)\n    m = len(sub_list)\n\n    if m > n:\n        return False\n\n    for i in range(n - m + 1):\n        if main_list[i:i+m] == sub_list:\n            return True\n\n    return False"}
