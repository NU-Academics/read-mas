)\nclass XOROperation:\n    \"\"\"Performs character-by-character binary XOR operation on two StringInput objects.\"\"\"\n    def __init__(self, input_a: StringInput, input_b: StringInput):\n        self._input_a = input_a\n        self._input_b = input_b\n        self._result: str = \"\"\n\n    def perform_xor(self) -> None:\n        \"\"\"Executes the character-by-character XOR logic and stores the result.\"\"\"\n        s_a = self._input_a.get_value()\n        s_b = self._input_b.get_value()\n        xor_result = []\n        for i in range(len(s_a)):\n            if s_a[i] == s_b[i]:\n                xor_result.append('0')\n            else:\n                xor_result.append('1')\n        self._result = \"\".join(xor_result)\n\n    def get_result(self) -> str:\n        \"\"\"Returns the computed XOR result string.\"\"\"\n        return self._result\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    input_a_obj = StringInput(a)\n    input_b_obj = StringInput(b)\n\n    input_a_obj.validate_binary_content()\n    input_b_obj.validate_binary_content()\n    input_a_obj.check_equal_length(input_b_obj)\n\n    xor_op = XOROperation(input_a_obj, input_b_obj)\n    xor_op.perform_xor()\n    return xor_op.get_result()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/16": [{"task_id": "HumanEval/16", "solution": "def count_distinct_characters(string: str) -> int:\n    \"\"\" Given a string, find out how many distinct characters (regardless of case) does it consist of\n    >>> count_distinct_characters('xyzXYZ')\n    3\n    >>> count_distinct_characters('Jerry')\n    4\n    \"\"\"\n    distinct_chars = set()\n    for char in string:\n        distinct_chars.add(char.lower())\n    return len(distinct_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/17": [{"task_id": "HumanEval/17", "solution": "def parse_music(music_string: str) -> List[int]:\n    \"\"\" Input to this function is a string representing musical notes in a special ASCII format.\n    Your task is to parse this string and return list of integers corresponding to how many beats does each\n    not last.\n\n    Here is a legend:\n    'o' - whole note, lasts four beats\n    'o|' - half note, lasts two beats\n    '.|' - quater note, lasts one beat\n\n    >>> parse_music('o o| .| o| o| .| .| .| .| o o')\n    [4, 2, 1, 2, 2, 1, 1, 1, 1, 4, 4]\n    \"\"\"\n    _NOTE_BEAT_MAP = {\n        'o': 4,   # Whole note\n        'o|': 2,  # Half note\n        '.|': 1   # Quarter note\n    }\n\n    def _tokenize_music_string(music_string: str) -> List[str]:\n        \"\"\"Splits the input music string into a list of note symbols, assuming space-separation.\"\"\"\n        return music_string.split(' ')\n\n    def _get_beat_value(note_symbol: str) -> int:\n        \"\"\"Returns the beat duration for a given note symbol based on predefined rules.\"\"\"\n        return _NOTE_BEAT_MAP[note_symbol]\n\n    tokens = _tokenize_music_string(music_string)\n    beat_durations = []\n    for token in tokens:\n        beat_durations.append(_get_beat_value(token))\n    return beat_durations", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/14": [{"task_id": "HumanEval/14", "solution": "def all_prefixes(string: str) -> List[str]:\n    \"\"\" Return list of all prefixes from shortest to longest of the input string\n    >>> all_prefixes('abc')\n    ['a', 'ab', 'abc']\n    \"\"\"\n    prefixes_list = []\n    for i in range(1, len(string) + 1):\n        prefixes_list.append(string[0:i])\n    return prefixes_list", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/10": [{"task_id": "HumanEval