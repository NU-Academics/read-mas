tional[int] = None\n        smallest_even_index: int = -1\n\n        for node in self._nodes:\n            if node.is_even():\n                if smallest_even_value is None or node.value < smallest_even_value:\n                    smallest_even_value = node.value\n                    smallest_even_index = node.index\n                elif node.value == smallest_even_value and node.index < smallest_even_index:\n                    smallest_even_index = node.index\n\n        if smallest_even_index == -1:\n            return []\n        else:\n            return [smallest_even_value, smallest_even_index]\ndef pluck(arr: List[int]) -> List[int]:\n    \"\"\"\n    Given an array representing a branch of a tree that has non-negative integer nodes\n    your task is to pluck one of the nodes and return it.\n    The plucked node should be the node with the smallest even value.\n    If multiple nodes with the same smallest even value are found return the node that has smallest index.\n\n    The plucked node should be returned in a list, [ smalest_value, its index ],\n    If there are no even values or the given array is empty, return [].\n    \"\"\"\n    node_list = NodeList(arr)\n    return node_list.pluck_node()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/70": [{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    \"\"\"\n    Sorts a list of integers into a 'strange order' by alternately picking minimum and maximum values.\n    Does not modify the original input list.\n    \"\"\"\n    if not lst:\n        return []\n\n    # Create a sorted copy of the input list to enable efficient min/max picking\n    sorted_lst = sorted(lst)\n    result = []\n    min_ptr = 0\n    max_ptr = len(sorted_lst) - 1\n    is_min_turn = True\n\n    # Alternately append minimum and maximum values from the sorted list\n    while min_ptr <= max_ptr:\n        if is_min_turn:\n            result.append(sorted_lst[min_ptr]