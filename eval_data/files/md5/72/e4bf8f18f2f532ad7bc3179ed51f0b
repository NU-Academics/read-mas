ce for all file name validation rules.\"\"\"\n    def apply(self, file_name_obj: 'FileName') -> bool:\n        raise NotImplementedError(\"Subclasses must implement apply method\")\nclass MaxDigitsRule(IFileValidationRule):\n    \"\"\"Validates that the file name does not contain more than three digits.\"\"\"\n    def apply(self, file_name_obj: 'FileName') -> bool:\n        digit_count = sum(1 for char in file_name_obj.name if '0' <= char <= '9')\n        return digit_count <= 3\nclass ExactlyOneDotRule(IFileValidationRule):\n    \"\"\"Validates that the file name contains exactly one dot.\"\"\"\n    def apply(self, file_name_obj: 'FileName') -> bool:\n        return file_name_obj.name.count('.') == 1\nclass NonEmptyBaseNameRule(IFileValidationRule):\n    \"\"\"Validates that the substring before the dot is not empty.\"\"\"\n    def apply(self, file_name_obj: 'FileName') -> bool:\n        return len(file_name_obj.base_name) > 0\nclass BaseNameStartsWithLetterRule(IFileValidationRule):\n    \"\"\"Validates that the substring before the dot starts with a Latin alphabet letter.\"\"\"\n    def apply(self, file_name_obj: 'FileName') -> bool:\n        if not file_name_obj.base_name: # Guard against empty base_name, though NonEmptyBaseNameRule should catch this.\n            return False\n        return file_name_obj.base_name[0].isalpha()\nclass ValidExtensionRule(IFileValidationRule):\n    \"\"\"Validates that the substring after the dot is one of the allowed extensions.\"\"\"\n    _allowed_extensions = {'txt', 'exe', 'dll'}\n\n    def apply(self, file_name_obj: 'FileName') -> bool:\n        return file_name_obj.extension in self._allowed_extensions\nclass FileValidationService:\n    \"\"\"Orchestrates the application of multiple validation rules to a file name.\"\"\"\n    def __init__(self, rules: list[IFileValidationRule]):\n        self._rules = rules\n\n    def validate(self, file_name_obj: 'FileName') -> bool:\n        for rule in self._rules:\n            if not ru