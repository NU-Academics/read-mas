ficients[i] * i)\n            return derived_coeffs\n\n    poly = Polynomial(xs)\n    return poly._calculate_derivative_coefficients()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/75": [{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100. \n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"Checks if a number is prime.\"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    def get_prime_factors(n):\n        \"\"\"Returns a list of prime factors for a given number, including multiplicities.\"\"\"\n        factors = []\n        \n        # Handle factor 2\n        while n % 2 == 0:\n            factors.append(2)\n            n //= 2\n            \n        # Handle odd factors\n        d = 3\n        while d * d <= n:\n            while n % d == 0:\n                factors.append(d)\n                n //= d\n            d += 2\n            \n        # If n is still greater than 1, it must be a prime factor itself\n        if n > 1:\n            factors.append(n)\n            \n        return factors\n\n    # Main logic for is_multiply_prime\n    if a >= 100:\n        return False\n    \n    # The smallest product of 3 primes is 2 * 2 * 2 = 8\n    if a < 8:\n        return False\n\n    factors = get_prime_factors(a)\n    \n    return len(factors) == 3", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/71": [{"task_id": "HumanEval/71", "solution": "import math\ndef trian