{"task_id": "Mbpp/2", "solution": "from collections import Counter\nfrom typing import Iterable, Callable, Any, Optional, Union, List, Tuple, Set, Sequence\n\ndef similar_elements(a: Iterable[Any], b: Iterable[Any], *, keep_duplicates: bool = False, key: Optional[Callable[[Any], Any]] = None, output_type: str = \"tuple\") -> Union[Tuple[Any, ...], List[Any], Set[Any]]:\n    \"\"\"\n    Finds shared elements between two iterables, with options for duplicates, key function, and output type.\n    \"\"\"\n\n    # --- Utility functions and constants (extracted from utils.py and formatter.py) ---\n    def _is_hashable(obj: Any) -> bool:\n        \"\"\"Checks if an object is hashable.\"\"\"\n        try:\n            hash(obj)\n            return True\n        except TypeError:\n            return False\n\n    _ALLOWED_OUTPUT_TYPES = {\"tuple\", \"list\", \"set\"}\n    def _validate_output_type(output_type: str) -> None:\n        \"\"\"Validates the requested output_type.\"\"\"\n        if output_type not in _ALLOWED_OUTPUT_TYPES:\n            raise ValueError(f\"Unsupported output_type: '{output_type}'. Must be one of {', '.join(sorted(_ALLOWED_OUTPUT_TYPES))}.\")\n\n    def _make_keyed_value(x: Any, key_func: Optional[Callable[[Any], Any]]) -> Any:\n        \"\"\"Applies the key function to an item, or returns the item itself.\"\"\"\n        return key_func(x) if key_func else x\n\n    def _format_output(items: Sequence[Any], output_type: str) -> Union[Tuple[Any, ...], List[Any], Set[Any]]:\n        \"\"\"Converts the result list to the specified output type.\"\"\"\n        if output_type == \"tuple\":\n            return tuple(items)\n        if output_type == \"list\":\n            return list(items)\n        if output_type == \"set\":\n            return set(items)\n        # _validate_output_type should ensure this case is not reached.\n        raise ValueError(f\"Unsupported output_type: {output_type}\")\n\n\n    # --- Input Validation and Normalization ---\n    _validate_output_type(output_type)\n\n    # Normalize inputs to lists\n    try:\n        a_list = list(a)\n    except TypeError:\n        raise TypeError(\"Input 'a' must be an iterable.\")\n    try:\n        b_list = list(b)\n    except TypeError:\n        raise TypeError(\"Input 'b' must be an iterable.\")\n\n    # --- Core Similarity Logic ---\n    result_list: List[Any] = []\n\n    # Determine if keyed elements are hashable to choose intersection strategy\n    all_keyed_elements_hashable = True\n    for item in a_list:\n        if not _is_hashable(_make_keyed_value(item, key)):\n            all_keyed_elements_hashable = False\n            break\n    if all_keyed_elements_hashable:\n        for item in b_list:\n            if not _is_hashable(_make_keyed_value(item, key)):\n                all_keyed_elements_hashable = False\n                break\n\n    if all_keyed_elements_hashable:\n        # Strategy for hashable keyed elements (O(N+M) complexity)\n        if key:\n            b_keyed_elements = [_make_keyed_value(x, key) for x in b_list]\n        else:\n            b_keyed_elements = b_list\n\n        if keep_duplicates:\n            counts = Counter(b_keyed_elements)\n            for x in a_list:\n                k = _make_keyed_value(x, key)\n                if counts.get(k, 0) > 0:\n                    result_list.append(x)\n                    counts[k] -= 1\n        else:\n            b_set = set(b_keyed_elements)\n            seen_in_result = set() # Track keyed values already added to result_list\n            for x in a_list:\n                k = _make_keyed_value(x, key)\n                if k in b_set and k not in seen_in_result:\n                    result_list.append(x)\n                    seen_in_result.add(k)\n    else:\n        # Strategy for non-hashable keyed elements (O(N*M) complexity)\n        b_matched_indices = [False] * len(b_list) # Tracks if an element from b_list has been used\n        seen_keyed_values_from_a: List[Any] = [] # Tracks unique keyed values from 'a' for non-duplicate results\n\n        for a_item in a_list:\n            a_keyed = _make_keyed_value(a_item, key)\n\n            if not keep_duplicates:\n                # Check if this keyed value has already contributed an item to the result\n                already_seen_this_keyed_value = False\n                for seen_k in seen_keyed_values_from_a:\n                    if a_keyed == seen_k:\n                        already_seen_this_keyed_value = True\n                        break\n                if already_seen_this_keyed_value:\n                    continue # Skip this a_item, a unique element for this keyed value is already included\n\n            for j, b_item in enumerate(b_list):\n                if b_matched_indices[j] and keep_duplicates:\n                    # If keeping duplicates, an element from b can only be used once per overall intersection process.\n                    # This check ensures we don't reuse it for a *new* a_item if it was already used.\n                    # For `keep_duplicates=True`, we need to find a distinct matching `b_item` for each `a_item` that qualifies.\n                    continue\n                \n                b_keyed = _make_keyed_value(b_item, key)\n                if a_keyed == b_keyed:\n                    result_list.append(a_item)\n                    b_matched_indices[j] = True # Mark b_item as used\n                    if not keep_duplicates:\n                        seen_keyed_values_from_a.append(a_keyed) # Record this keyed value as seen\n                    break # Found a match for current a_item, move to next a_item\n\n    # --- Output Formatting ---\n    return _format_output(result_list, output_type)"}
{"task_id": "Mbpp/4", "solution": "import heapq\nimport time\nfrom typing import Sequence, List, Tuple, Callable, Any, TypeVar\n\n# Custom exception as per design context\nclass InvalidInputError(Exception):\n    \"\"\"Raised when input to the largest number finder is invalid.\"\"\"\n    pass\n\n# Type variable for the timeit_ms helper\nT = TypeVar('T')\n\n# Helper functions as per design context (src/heap_largest/utils.py)\ndef validate_numbers(numbers: Sequence[float]) -> bool:\n    \"\"\"Validates that 'numbers' is an iterable containing only numeric types.\"\"\"\n    if not hasattr(numbers, '__iter__'):\n        return False\n    for x in numbers:\n        if not isinstance(x, (int, float)):\n            return False\n    return True\n\ndef timeit_ms(func: Callable[..., T], *args: Any, **kwargs: Any) -> Tuple[T, float]:\n    \"\"\"Times the execution of a function and returns its result and duration in milliseconds.\"\"\"\n    start_time = time.perf_counter()\n    result = func(*args, **kwargs)\n    end_time = time.perf_counter()\n    duration_ms = (end_time - start_time) * 1000\n    return result, duration_ms\n\n# DTOs and Adapters as per design context\nclass LargestRequest:\n    \"\"\"Data Transfer Object for input numbers and n.\"\"\"\n    def __init__(self, numbers: Sequence[float], n: int) -> None:\n        self.numbers = numbers\n        self.n = n\n\n    def validate(self) -> None:\n        \"\"\"Validates the request inputs based on design rules, raising exceptions for invalid cases.\"\"\"\n        if not isinstance(self.n, int):\n            raise InvalidInputError(\"n must be int\")\n        if self.n < 0:\n            raise ValueError(\"n must be >= 0\")\n        if not validate_numbers(self.numbers):\n            raise InvalidInputError(\"numbers must be an iterable of numerics\")\n\nclass LargestResponse:\n    \"\"\"Data Transfer Object for output results and timing metadata.\"\"\"\n    def __init__(self, results: List[float], duration_ms: float) -> None:\n        self.results = results\n        self.duration_ms = duration_ms\n\n    def to_list(self) -> List[float]:\n        \"\"\"Returns the results as a list.\"\"\"\n        return self.results\n\nclass HeapAdapter:\n    \"\"\"Implements the efficient O(N log K) selection of top-N elements using a min-heap.\"\"\"\n    def top_n(self, numbers: Sequence[float], n: int) -> List[float]:\n        \"\"\"Returns the top N elements from the sequence, sorted in descending order.\"\"\"\n        if n <= 0:\n            return []\n        \n        # Business rule: If n > len(numbers), return all numbers sorted descending.\n        if n >= len(numbers):\n            return sorted(list(numbers), reverse=True)\n\n        minheap: List[float] = []\n        for x in numbers:\n            if len(minheap) < n:\n                heapq.heappush(minheap, x)\n            else:\n                if x > minheap[0]: # If current element is greater than the smallest in heap\n                    heapq.heapreplace(minheap, x) # Replace smallest with current\n\n        # The minheap now contains the n largest elements. Sort them descending.\n        return sorted(minheap, reverse=True)\n\nclass LargestFinderService:\n    \"\"\"Orchestrates validation, computation using an adapter, sorting, and timing.\"\"\"\n    def __init__(self, adapter: Any, history_repo: Any = None) -> None:\n        self.adapter = adapter\n        self.history_repo = history_repo # History repository is not used in this specific function's scope.\n\n    def find_top_n(self, request: LargestRequest) -> LargestResponse:\n        \"\"\"Finds the top N numbers for a given request, handles validation and timing.\"\"\"\n        request.validate()\n\n        def _run_adapter():\n            return self.adapter.top_n(request.numbers, request.n)\n\n        results_from_adapter, duration = timeit_ms(_run_adapter)\n        \n        # Ensure descending sort as per FR1 and LargestFinderService description\n        # (even if the adapter already sorted them, the service guarantees it).\n        results_final_sorted = sorted(results_from_adapter, reverse=True)\n        \n        return LargestResponse(results_final_sorted, duration)\n\n# Global service instance as per design context (src/heap_largest/__init__.py snippet)\n_default_service = LargestFinderService(adapter=HeapAdapter(), history_repo=None)\n\ndef heap_queue_largest(numbers: Sequence[float], n: int) -> List[float]:\n    \"\"\"\n    Finds the n largest integers from a given list of numbers, returned in descending order.\n    Uses an internal heap-based algorithm for efficient selection.\n    \"\"\"\n    req = LargestRequest(numbers, n)\n    resp = _default_service.find_top_n(req)\n    return resp.to_list()"}
