{"task_id": "HumanEval/86", "solution": "```python\ndef anti_shuffle(s):\n    \"\"\"\n    Write a function that takes a string and returns an ordered version of it.\n    Ordered version of string, is a string where all words (separated by space)\n    are replaced by a new word where all the characters arranged in\n    ascending order based on ascii value.\n    Note: You should keep the order of words and blank spaces in the sentence.\n    \"\"\"\n    parts = []\n    current_word_chars = []\n\n    for char in s:\n        if char == ' ':\n            if current_word_chars:\n                # Sort characters of the accumulated word and add it to parts\n                sorted_word = \"\".join(sorted(\"\".join(current_word_chars)))\n                parts.append(sorted_word)\n                current_word_chars = []\n            parts.append(' ') # Add the space\n        else:\n            current_word_chars.append(char)\n\n    # Add any remaining word after the loop\n    if current_word_chars:\n        sorted_word = \"\".join(sorted(\"\".join(current_word_chars)))\n        parts.append(sorted_word)\n\n    return \"\".join(parts)\n```"}
{"task_id": "HumanEval/89", "solution": "```python\ndef encrypt(s):\n    \"\"\"Create a function encrypt that takes a string as an argument and\n    returns a string encrypted with the alphabet being rotated.\n    The alphabet should be rotated in a manner such that the letters\n    shift down by two multiplied to two places.\n    \"\"\"\n    SHIFT_VALUE = 4  # Shift by two multiplied to two places\n    ALPHABET_SIZE = 26\n    ASCII_LOWER_A = ord('a')\n\n    encrypted_chars = []\n    for char in s:\n        if 'a' <= char <= 'z':\n            # Calculate the shifted position and wrap around the alphabet.\n            shifted_pos = (ord(char) - ASCII_LOWER_A + SHIFT_VALUE) % ALPHABET_SIZE\n            encrypted_chars.append(chr(ASCII_LOWER_A + shifted_pos))\n        else:\n            encrypted_chars.append(char)\n    return \"\".join(encrypted_chars)\n```"}
{"task_id": "HumanEval/87", "solution": "```python\nfrom dataclasses import dataclass, field\nfrom typing import List, Tuple\n\ndef get_row(lst: List[List[int]], x: int) -> List[Tuple[int, int]]:\n    \"\"\"\n    Finds all occurrences of integer `x` in a 2D list `lst`.\n    Returns a list of `(row, column)` coordinates, sorted by row ascending then column descending.\n    \"\"\"\n\n    @dataclass(order=False, frozen=True)\n    class Coordinate:\n        row: int\n        column: int\n\n        def __lt__(self, other: 'Coordinate') -> bool:\n            # Sort primarily by row in ascending order.\n            if self.row != other.row:\n                return self.row < other.row\n            # If rows are equal, sort columns in descending order.\n            return self.column > other.column\n\n        def to_tuple(self) -> tuple[int, int]:\n            return (self.row, self.column)\n\n    found_coordinates: List[Coordinate] = []\n\n    for r_idx, row_list in enumerate(lst):\n        for c_idx, item in enumerate(row_list):\n            if item == x:\n                found_coordinates.append(Coordinate(row=r_idx, column=c_idx))\n\n    # The custom __lt__ in Coordinate handles the specified sorting logic.\n    found_coordinates.sort()\n\n    return [coord.to_tuple() for coord in found_coordinates]\n```"}
{"task_id": "HumanEval/91", "solution": "```python\nclass SentenceSplitter:\n    SENTENCE_DELIMITERS = ['.', '?', '!']\n\n    @staticmethod\n    def split_text(text: str) -> list[str]:\n        if not text:\n            return []\n\n        temp_text = text\n        for delimiter in SentenceSplitter.SENTENCE_DELIMITERS:\n            # Replace delimiters with a unique marker to split.\n            temp_text = temp_text.replace(delimiter, delimiter + '###SENTENCE_END###')\n\n        # Split by the marker and filter out empty strings.\n        sentences = [s.strip() for s in temp_text.split('###SENTENCE_END###') if s.strip()]\n        return sentences\n\n\nclass BoredomCounter:\n    @staticmethod\n    def count_boredoms(text: str) -> int:\n        sentences = SentenceSplitter.split_text(text)\n        boredom_count = 0\n        for sentence in sentences:\n            # Check if the sentence starts with \"I\" (case-sensitive) as a standalone word.\n            if sentence.startswith(\"I \") or sentence == \"I\":\n                boredom_count += 1\n        return boredom_count\n\n\ndef is_bored(S: str) -> int:\n    \"\"\"\n    Counts sentences starting with \"I\" in string S.\n    Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    return BoredomCounter.count_boredoms(S)\n```"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    '''\n    Create a function that takes 3 numbers.\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns false in any other cases.\n\n    Examples\n    any_int(5, 2, 7) \u279e True\n\n    any_int(3, 2, 2) \u279e False\n\n    any_int(3, -2, 1) \u279e True\n\n    any_int(3.6, -2.2, 2) \u279e False\n\n\n\n    '''\n    if not (isinstance(x, int) and isinstance(y, int) and isinstance(z, int)):\n        return False\n\n    return (x == y + z) or (y == x + z) or (z == x + y)"}
{"task_id": "HumanEval/90", "solution": "```python\nclass ListProcessor:\n    \"\"\"Utility class for processing lists.\"\"\"\n    @staticmethod\n    def get_unique_sorted_elements(lst: list[int]) -> list[int]:\n        \"\"\"Returns a list of unique elements from the input list, sorted in ascending order.\"\"\"\n        if not lst:\n            return []\n        unique_elements = sorted(list(set(lst)))\n        return unique_elements\n\nclass NextSmallestFinder:\n    \"\"\"Finds the second smallest distinct element in a list of integers.\"\"\"\n    def find(self, lst: list[int]) -> int | None:\n        \"\"\"Returns the second smallest distinct element of the list. Returns None if there is no such element.\"\"\"\n        unique_sorted_elements = ListProcessor.get_unique_sorted_elements(lst)\n\n        if len(unique_sorted_elements) < 2:\n            return None\n        else:\n            return unique_sorted_elements[1]\n\ndef next_smallest(lst: list[int]) -> int | None:\n    \"\"\"Returns the second smallest distinct element of the list. Returns None if there is no such element.\"\"\"\n    finder = NextSmallestFinder()\n    return finder.find(lst)\n```"}
{"task_id": "HumanEval/92", "solution": "```python\ndef any_int(x, y, z):\n    '''\n    Create a function that takes 3 numbers.\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns false in any other cases.\n\n    Examples\n    any_int(5, 2, 7) \u279e True\n\n    any_int(3, 2, 2) \u279e False\n\n    any_int(3, -2, 1) \u279e True\n\n    any_int(3.6, -2.2, 2) \u279e False\n    '''\n    if not (isinstance(x, int) and isinstance(y, int) and isinstance(z, int)):\n        return False\n\n    return (x == y + z) or (y == x + z) or (z == x + y)\n```"}
{"task_id": "HumanEval/93", "solution": "```python\ndef encode(message):\n    \"\"\"\n    Encodes a message by swapping the case of all letters and replacing vowels\n    with the letter two places ahead in the alphabet.\n    \"\"\"\n    VOWELS_LOWER = {'a', 'e', 'i', 'o', 'u'}\n    VOWELS_UPPER = {'A', 'E', 'I', 'O', 'U'}\n    ALPHABET_LOWER = 'abcdefghijklmnopqrstuvwxyz'\n    ALPHABET_UPPER = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'\n\n    def _get_char_two_ahead(char_to_shift: str) -> str:\n        \"\"\"Returns the character two places ahead in the alphabet, maintaining case.\"\"\"\n        if char_to_shift.islower():\n            alphabet = ALPHABET_LOWER\n        else:\n            alphabet = ALPHABET_UPPER\n\n        index = alphabet.index(char_to_shift)\n        new_index = (index + 2) % len(alphabet)\n        return alphabet[new_index]\n\n    encoded_chars = []\n    for char in message:\n        if not char.isalpha():\n            encoded_chars.append(char)\n            continue\n\n        swapped_char = char.swapcase()\n\n        # Check if the *swapped character* is a vowel.\n        if swapped_char in VOWELS_LOWER or swapped_char in VOWELS_UPPER:\n            transformed_char = _get_char_two_ahead(swapped_char)\n            encoded_chars.append(transformed_char)\n        else:\n            encoded_chars.append(swapped_char)\n\n    return \"\".join(encoded_chars)\n```"}
{"task_id": "HumanEval/93", "solution": "```python\ndef encode(message):\n    \"\"\"Encodes a message by swapping case and replacing specific vowels.\n    Non-alphabetic characters are passed through unchanged.\"\"\"\n\n    VOWELS = \"aeiouAEIOU\"\n    ALPHABET_LOWER = \"abcdefghijklmnopqrstuvwxyz\"\n    ALPHABET_UPPER = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"\n\n    def _swap_case(char):\n        if 'a' <= char <= 'z':\n            return char.upper()\n        elif 'A' <= char <= 'Z':\n            return char.lower()\n        return char\n\n    def _replace_vowel(char):\n        if char in VOWELS:\n            if char.islower():\n                idx = ALPHABET_LOWER.find(char)\n                new_idx = (idx + 2) % len(ALPHABET_LOWER)\n                return ALPHABET_LOWER[new_idx]\n            elif char.isupper():\n                idx = ALPHABET_UPPER.find(char)\n                new_idx = (idx + 2) % len(ALPHABET_UPPER)\n                return ALPHABET_UPPER[new_idx]\n        return char\n\n    encoded_chars = []\n    for char in message:\n        # First, swap the case of the character.\n        swapped_char = _swap_case(char)\n        # Then, replace the character if it is a vowel.\n        final_char = _replace_vowel(swapped_char)\n        encoded_chars.append(final_char)\n    return \"\".join(encoded_chars)\n```"}
{"task_id": "HumanEval/91", "solution": "```python\nimport re\nfrom typing import List\n\nclass SentenceAnalyzer:\n    SENTENCE_DELIMITERS = ['.', '?', '!']\n\n    def __init__(self):\n        # Initializes the analyzer.\n        pass\n\n    def split_sentences(self, text: str) -> List[str]:\n        # Splits the input text into a list of individual sentences based on delimiters.\n        if not text:\n            return []\n\n        # Split by delimiters, keeping the delimiters to ensure proper sentence boundaries.\n        parts = re.split(r'([.?!]+)', text)\n\n        sentences = []\n        current_sentence_parts = []\n\n        for part in parts:\n            if not part.strip(): # Ignore empty parts or parts with only whitespace.\n                continue\n\n            if re.match(r'^[.?!]+$', part): # If the part is a delimiter.\n                if current_sentence_parts:\n                    sentence = \"\".join(current_sentence_parts).strip()\n                    if sentence: # Only add non-empty sentences.\n                        sentences.append(sentence)\n                    current_sentence_parts = []\n            else:\n                current_sentence_parts.append(part)\n\n        # Add any remaining sentence parts if they don't end with a delimiter.\n        if current_sentence_parts:\n            sentence = \"\".join(current_sentence_parts).strip()\n            if sentence:\n                sentences.append(sentence)\n\n        return sentences\n\n    def starts_with_i(self, sentence: str) -> bool:\n        # Checks if a given sentence starts with the word 'I' (case-insensitive and standalone).\n        cleaned_sentence = sentence.strip()\n        if not cleaned_sentence:\n            return False\n\n        # Regex checks for 'I' or 'i' at the start, followed by end of string, contraction, or non-word character.\n        match = re.match(r\"^(I|i)($|'m|'ve|'ll|'d|'s|\\W)\", cleaned_sentence)\n        return bool(match)\n\nclass SentenceAnalyzerService:\n    def __init__(self):\n        # Initializes the service by creating an instance of SentenceAnalyzer.\n        self.analyzer = SentenceAnalyzer()\n\n    def is_bored(self, text: str) -> int:\n        # Splits the input text into sentences and counts how many start with 'I'.\n        count = 0\n        sentences = self.analyzer.split_sentences(text)\n        for sentence in sentences:\n            if self.analyzer.starts_with_i(sentence):\n                count += 1\n        return count\n\ndef is_bored(S: str) -> int:\n    \"\"\"\n    You'll be given a string of words, and your task is to count the number\n    of boredoms. A boredom is a sentence that starts with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n\n    For example:\n    >>> is_bored(\"Hello world\")\n    0\n    >>> is_bored(\"The sky is blue. The sun is shining. I love this weather\")\n    1\n    \"\"\"\n    service = SentenceAnalyzerService()\n    return service.is_bored(S)\n```"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n\n    Examples:\n    For lst = [0,3,2,1,3,5,7,4,5,5,5,2,181,32,4,32,3,2,32,324,4,3] the output should be 10\n    For lst = [1,0,1,8,2,4597,2,1,3,40,1,2,1,2,4,2,5,1] the output should be 25\n    For lst = [1,3,1,32,5107,34,83278,109,163,23,2323,32,30,1,9,3] the output should be 13\n    For lst = [0,724,32,71,99,32,6,0,5,91,83,0,5,6] the output should be 11\n    For lst = [0,81,12,3,1,21] the output should be 3\n    For lst = [0,8,1,2,1,7] the output should be 7\n    \"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Determines if a number is prime. Optimizes for common small divisors.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def sum_digits(n: int) -> int:\n        \"\"\"Calculates the sum of the absolute value of a number's digits.\"\"\"\n        s = 0\n        abs_n = abs(n)\n        while abs_n:\n            s += abs_n % 10\n            abs_n //= 10\n        return s\n\n    largest_prime = -1\n    found_prime = False\n\n    for num in lst:\n        if is_prime(num):\n            if num > largest_prime:\n                largest_prime = num\n            found_prime = True\n\n    if not found_prime:\n        raise ValueError(\"No prime numbers found in the list.\")\n\n    return sum_digits(largest_prime)```"}
{"task_id": "HumanEval/95", "solution": "```python\ndef check_dict_case(dict):\n    \"\"\"Determines if all keys in the given dictionary are strings and are uniformly cased (all lowercase or all uppercase). Returns False for empty dictionaries or if non-string keys are present.\"\"\"\n    if not dict:\n        return False\n\n    all_keys_are_strings = all(isinstance(key, str) for key in dict.keys())\n    if not all_keys_are_strings:\n        return False\n\n    all_lower = True\n    all_upper = True\n\n    for key in dict.keys():\n        if key != key.lower():\n            all_lower = False\n        if key != key.upper():\n            all_upper = False\n\n        if not all_lower and not all_upper:\n            return False\n\n    return all_lower or all_upper\n```"}
{"task_id": "HumanEval/94", "solution": "```python\ndef skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n\n    Examples:\n    For lst = [0,3,2,1,3,5,7,4,5,5,5,2,181,32,4,32,3,2,32,324,4,3] the output should be 10\n    For lst = [1,0,1,8,2,4597,2,1,3,40,1,2,1,2,4,2,5,1] the output should be 25\n    For lst = [1,3,1,32,5107,34,83278,109,163,23,2323,32,30,1,9,3] the output should be 13\n    For lst = [0,724,32,71,99,32,6,0,5,91,83,0,5,6] the output should be 11\n    For lst = [0,81,12,3,1,21] the output should be 3\n    For lst = [0,8,1,2,1,7] the output should be 7\n    \"\"\"\n    import math\n\n    def _is_prime(n: int) -> bool:\n        if n < 2:\n            return False\n        for i in range(2, int(math.sqrt(n)) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    def _sum_digits(n: int) -> int:\n        return sum(int(digit) for digit in str(abs(n)))\n\n    largest_prime = None\n    for number in lst:\n        if _is_prime(number):\n            if largest_prime is None or number > largest_prime:\n                largest_prime = number\n\n    if largest_prime is None:\n        return 0\n    else:\n        return _sum_digits(largest_prime)\n\n```"}
{"task_id": "HumanEval/95", "solution": "```python\ndef check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower\n    case or all keys are strings in upper case, else return False.\n    The function should return False if the given dictionary is empty.\n    \"\"\"\n    if not dict:\n        return False\n\n    string_keys = []\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False\n        string_keys.append(key)\n\n    # Check if all collected string keys are uniformly lowercase or uppercase.\n    all_lower = all(key.islower() for key in string_keys)\n    all_upper = all(key.isupper() for key in string_keys)\n\n    return all_lower or all_upper\n```"}
{"task_id": "HumanEval/96", "solution": "```python\ndef count_up_to(n: int) -> list[int]:\n    \"\"\"Returns a list of prime numbers strictly less than n.\"\"\"\n\n    def is_prime(num: int) -> bool:\n        \"\"\"Checks if an integer is prime. It handles numbers less than 2 as non-prime.\"\"\"\n        if num < 2:\n            return False\n        for i in range(2, int(num**0.5) + 1):\n            if num % i == 0:\n                return False\n        return True\n\n    if n <= 2:\n        return []\n\n    primes = []\n    for i in range(2, n):\n        if is_prime(i):\n            primes.append(i)\n    return primes\n```"}
