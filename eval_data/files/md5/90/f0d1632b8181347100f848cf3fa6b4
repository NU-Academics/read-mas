{"task_id": "HumanEval/140", "solution": "import re\n\ndef fix_spaces(text):\n    \"\"\"\n    Replaces single spaces with underscores and sequences of three or more consecutive spaces with a single hyphen.\n    This ensures consistent string formatting.\n    \"\"\"\n    # Replace sequences of 3 or more spaces with a single hyphen first.\n    fixed_text = re.sub(r' {3,}', '-', text)\n\n    # Then replace remaining single spaces with underscores.\n    fixed_text = fixed_text.replace(' ', '_')\n\n    return fixed_text"}
{"task_id": "HumanEval/140", "solution": "```python\nimport re\n\ndef fix_spaces(text: str) -> str:\n    \"\"\"\n    Standardizes space formatting in a string.\n    Replaces sequences of 3+ spaces with a hyphen, and single/double spaces with underscores.\n    \"\"\"\n    # Replace sequences of 3 or more spaces with a single hyphen.\n    text = re.sub(r' {3,}', '-', text)\n    # Replace any remaining single spaces (including those from original double spaces) with underscores.\n    text = text.replace(' ', '_')\n    return text\n```"}
{"task_id": "HumanEval/141", "solution": "```python\ndef file_name_check(file_name):\n    \"\"\"Checks if a file's name is valid based on predefined rules. Returns 'Yes' if valid, 'No' otherwise.\"\"\"\n\n    # Rule: The file's name contains exactly one dot '.'\n    if file_name.count('.') != 1:\n        return 'No'\n\n    parts = file_name.rsplit('.', 1)\n    prefix = parts[0]\n    extension = parts[1]\n\n    # Rule: The substring before the dot should not be empty.\n    if not prefix:\n        return 'No'\n\n    # Rule: The substring before the dot starts with a latin alphabet letter.\n    if not prefix[0].isalpha():\n        return 'No'\n\n    # Rule: The substring after the dot should be one of these.\n    VALID_EXTENSIONS = ['txt', 'exe', 'dll']\n    if extension not in VALID_EXTENSIONS:\n        return 'No'\n\n    # Rule: There should not be more than three digits in the file's name.\n    digit_count = 0\n    for char in file_name:\n        if '0' <= char <= '9':  # Check if character is a digit\n            digit_count += 1\n    if digit_count > 3:\n        return 'No'\n\n    # All conditions met\n    return 'Yes'\n```"}
{"task_id": "HumanEval/142", "solution": "```python\ndef sum_squares(lst):\n    \"\"\"\n    Processes a list of integers, applying squaring or cubing based on index rules, then sums them.\n    Index multiples of 3 are squared; index multiples of 4 (but not 3) are cubed.\n    \"\"\"\n    total_sum = 0\n    for i, num in enumerate(lst):\n        modified_num = num\n        if i % 3 == 0:\n            modified_num = num * num\n        elif i % 4 == 0: # This implies i % 3 != 0 due to the preceding 'if'\n            modified_num = num * num * num\n\n        total_sum += modified_num\n    return total_sum\n```"}
{"task_id": "HumanEval/142", "solution": "```python\ndef sum_squares(lst):\n    \"\"\"Calculates a specific sum from a list of integers, applying conditional transformations based on element index.\"\"\"\n    total_sum = 0\n    for i, num in enumerate(lst):\n        if i % 3 == 0:\n            total_sum += num * num\n        elif i % 4 == 0:\n            total_sum += num * num * num\n        else:\n            total_sum += num\n    return total_sum\n```"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Filters words from a sentence, keeping only those with prime lengths.\n    Maintains original word order and joins filtered words with a space.\n    \"\"\"\n    def is_prime(n: int) -> bool:\n        \"\"\"Determines if a given integer n is a prime number.\"\"\"\n        if n < 2:\n            return False\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 1\n        return True\n\n    words = sentence.split()\n    filtered_words = []\n    for word in words:\n        if is_prime(len(word)):\n            filtered_words.append(word)\n    return \" \".join(filtered_words)"}
{"task_id": "HumanEval/139", "solution": "```python\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as the product of factorials from 1! up to n!.\\n    This function calculates the special factorial for a positive integer n.\\n    \"\"\"\n\n    def factorial(k):\n        \"\"\"Calculates the standard factorial k! for a non-negative integer k.\\n        This function assumes k is a non-negative integer as per critical requirements.\\n        \"\"\"\n        if k == 0 or k == 1:\n            return 1\n        res = 1\n        for i in range(2, k + 1):\n            res *= i\n        return res\n\n    # Per requirements, n is an integer greater than 0.\n    # The base case for n=1 is 1! which equals 1.\n    if n == 1:\n        return 1\n\n    result = 1\n    # Calculate the product of factorials: 1! * 2! * ... * n!\n    for i in range(1, n + 1):\n        result *= factorial(i)\n    return result\n```"}
{"task_id": "HumanEval/141", "solution": "```python\ndef file_name_check(file_name: str) -> str:\n    \"\"\"\n    Validates a file name string, returning 'Yes' if it meets specific criteria\n    and 'No' otherwise. Criteria include digit count, dot presence, prefix validity, and allowed extensions.\n    \"\"\"\n    ALLOWED_EXTENSIONS = ['txt', 'exe', 'dll']\n\n    # Rule 2: The file's name contains exactly one dot '.'\n    if file_name.count('.') != 1:\n        return 'No'\n\n    prefix, suffix = file_name.split('.')\n\n    # Rule 3: The substring before the dot should not be empty\n    if not prefix:\n        return 'No'\n\n    # Rule 4: The substring before the dot starts with a letter from the latin alphabet\n    if not prefix[0].isalpha():\n        return 'No'\n\n    # Rule 1: There should not be more than three digits ('0'-'9') in the file's name.\n    digit_count = sum(1 for char in file_name if char.isdigit())\n    if digit_count > 3:\n        return 'No'\n\n    # Rule 5: The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    if suffix not in ALLOWED_EXTENSIONS:\n        return 'No'\n\n    return 'Yes'\n\n```"}
{"task_id": "HumanEval/144", "solution": "```python\ndef _parse_fraction(fraction_str: str) -> tuple[int, int]:\n    \"\"\"Helper to parse a fraction string into a (numerator, denominator) tuple.\"\"\"\n    parts = fraction_str.split('/')\n    numerator = int(parts[0])\n    denominator = int(parts[1])\n    return (numerator, denominator)\n\ndef _multiply_fractions(f1: tuple[int, int], f2: tuple[int, int]) -> tuple[int, int]:\n    \"\"\"Helper to multiply two fraction tuples.\"\"\"\n    new_numerator = f1[0] * f2[0]\n    new_denominator = f1[1] * f2[1]\n    return (new_numerator, new_denominator)\n\ndef _is_whole_number(f: tuple[int, int]) -> bool:\n    \"\"\"Helper to check if a fraction tuple represents a whole number.\"\"\"\n    return f[0] % f[1] == 0\n\ndef simplify(x: str, n: str) -> bool:\n    \"\"\"\n    Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n\n    You can assume that x, and n are valid fractions, and do not have zero as denominator.\n\n    simplify(\"1/5\", \"5/1\") = True\n    simplify(\"1/6\", \"2/1\") = False\n    simplify(\"7/10\", \"10/2\") = False\n    \"\"\"\n    fraction_x = _parse_fraction(x)\n    fraction_n = _parse_fraction(n)\n\n    product_fraction = _multiply_fractions(fraction_x, fraction_n)\n\n    return _is_whole_number(product_fraction)\n```"}
{"task_id": "HumanEval/146", "solution": "```python\ndef specialFilter(nums):\n    \"\"\"\n    Counts numbers in a list that are greater than 10 and have odd first and last digits.\n    Digits are extracted from the absolute value of the number.\n    \"\"\"\n    count = 0\n    for num in nums:\n        if num > 10:\n            # Convert to string to easily extract first and last digits from its absolute value.\n            abs_num_str = str(abs(num))\n            first_digit = int(abs_num_str[0])\n            last_digit = int(abs_num_str[-1])\n\n            # Check if both the first and last digits are odd.\n            if first_digit % 2 != 0 and last_digit % 2 != 0:\n                count += 1\n    return count\n```"}
{"task_id": "HumanEval/145", "solution": "```python\ndef _sum_digits(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the absolute value of digits of an integer.\n    \"\"\"\n    s = 0\n    n_abs = abs(n)\n    while n_abs > 0:\n        s += n_abs % 10\n        n_abs //= 10\n    return s\n\ndef order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers based on the sum of their digits (ascending)\n    and then their original index (ascending) for ties.\n    \"\"\"\n    decorated_list = []\n    for i, num in enumerate(nums):\n        decorated_list.append((_sum_digits(num), i, num))\n\n    decorated_list.sort()\n\n    sorted_nums = [item[2] for item in decorated_list]\n\n    return sorted_nums\n```"}
{"task_id": "HumanEval/144", "solution": "def simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n\n    You can assume that x, and n are valid fractions, and do not have zero as denominator.\n\n    simplify(\"1/5\", \"5/1\") = True\n    simplify(\"1/6\", \"2/1\") = False\n    simplify(\"7/10\", \"10/2\") = False\n    \"\"\"\n    # Parse the first fraction x\n    x_parts = x.split('/')\n    x_num = int(x_parts[0])\n    x_den = int(x_parts[1])\n\n    # Parse the second fraction n\n    n_parts = n.split('/')\n    n_num = int(n_parts[0])\n    n_den = int(n_parts[1])\n\n    # Multiply the fractions\n    product_numerator = x_num * n_num\n    product_denominator = x_den * n_den\n\n    # Check if the product is a whole number\n    return product_numerator % product_denominator == 0"}
{"task_id": "HumanEval/147", "solution": "```python\ndef combinations(n, k):\n    \"\"\"\n    Calculates \"n choose k\" (C(n, k)).\n    Returns 0 if k is out of bounds.\n    \"\"\"\n    if k < 0 or k > n:\n        return 0\n    if k == 0 or k == n:\n        return 1\n    if k > n // 2:\n        k = n - k\n\n    res = 1\n    for i in range(k):\n        res = res * (n - i) // (i + 1)\n    return res\n\ndef get_max_triples(n):\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) of a where i < j < k,\n    and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n    if n < 3:\n        return 0\n\n    count_a_mod_0 = 0  # Occurrences of a[x] % 3 == 0 (where x % 3 == 2)\n    count_a_mod_1 = 0  # Occurrences of a[x] % 3 == 1 (where x % 3 == 0 or x % 3 == 1)\n\n    for x in range(1, n + 1):\n        if x % 3 == 2:\n            count_a_mod_0 += 1\n        else:\n            count_a_mod_1 += 1\n\n    # Triples (0, 0, 0) sum to 0 (mod 3)\n    triples_000 = combinations(count_a_mod_0, 3)\n\n    # Triples (1, 1, 1) sum to 3 (mod 3), which is 0 (mod 3)\n    triples_111 = combinations(count_a_mod_1, 3)\n\n    return triples_000 + triples_111\n```"}
{"task_id": "HumanEval/145", "solution": "```python\ndef order_by_points(nums):\n    \"\"\"\n    Write a function which sorts the given list of integers\n    in ascending order according to the sum of their digits.\n    Note: if there are several items with similar sum of their digits,\n    order them based on their index in original list.\n\n    For example:\n    >>> order_by_points([1, 11, -1, -11, -12]) == [-1, -11, 1, -12, 11]\n    >>> order_by_points([]) == []\n    \"\"\"\n\n    def _calculate_digit_sum(n):\n        \"\"\"Calculates the sum of the absolute digits of an integer.\"\"\"\n        s = str(abs(n))\n        digit_sum = 0\n        for digit_char in s:\n            digit_sum += int(digit_char)\n        return digit_sum\n\n    if not nums:\n        return []\n\n    # Create a list of tuples: (digit_sum, original_index, original_number)\n    # This allows sorting by digit_sum first, then original_index for tie-breaking.\n    decorated_list = []\n    for i, num in enumerate(nums):\n        digit_sum = _calculate_digit_sum(num)\n        decorated_list.append((digit_sum, i, num))\n\n    # Sort the decorated list. Python's built-in sorted function sorts tuples lexicographically,\n    # applying the sort criteria in the order of elements in the tuple.\n    sorted_decorated_list = sorted(decorated_list)\n\n    # Extract the original numbers in their sorted order.\n    return [item[2] for item in sorted_decorated_list]\n\n```"}
{"task_id": "HumanEval/149", "solution": "```python\ndef sorted_list_sum(lst: list[str]) -> list[str]:\n    \"\"\"Deletes strings with odd lengths from the input list and returns the\n    resulted list sorted by length (ascending), then alphabetically (ascending).\"\"\"\n\n    # Filter out strings with odd lengths\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n\n    # Sort by length, then alphabetically. Python's sort handles tuple keys naturally.\n    sorted_list = sorted(even_length_strings, key=lambda s: (len(s), s))\n\n    return sorted_list\n```"}
{"task_id": "HumanEval/148", "solution": "```python\ndef bf(planet1, planet2):\n    '''\n    Finds planets located between two specified planets in our solar system.\n    Returns a tuple of intermediate planets, sorted by proximity to the sun.\n    '''\n    SOLAR_SYSTEM_PLANETS = [\n        \"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n    ]\n\n    if planet1 not in SOLAR_SYSTEM_PLANETS or planet2 not in SOLAR_SYSTEM_PLANETS:\n        return ()\n\n    idx1 = SOLAR_SYSTEM_PLANETS.index(planet1)\n    idx2 = SOLAR_SYSTEM_PLANETS.index(planet2)\n\n    start_idx = min(idx1, idx2)\n    end_idx = max(idx1, idx2)\n\n    intermediate_planets = SOLAR_SYSTEM_PLANETS[start_idx + 1 : end_idx]\n\n    return tuple(intermediate_planets)\n```"}
{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun\n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn,\n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2.\n    The function should return a tuple containing all planets whose orbits are\n    located between the orbit of planet1 and the orbit of planet2, sorted by\n    the proximity to the sun.\n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names.\n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    _SOLAR_SYSTEM_PLANETS = (\n        \"Mercury\", \"Venus\", \"Earth\", \"Mars\",\n        \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n    )\n\n    try:\n        idx1 = _SOLAR_SYSTEM_PLANETS.index(planet1)\n    except ValueError:\n        return ()\n\n    try:\n        idx2 = _SOLAR_SYSTEM_PLANETS.index(planet2)\n    except ValueError:\n        return ()\n\n    start_idx = min(idx1, idx2)\n    end_idx = max(idx1, idx2)\n\n    return _SOLAR_SYSTEM_PLANETS[start_idx + 1:end_idx]"}
