{"task_id": "HumanEval/37", "solution": "```python\ndef sort_even(l: list) -> list:\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    even_elements = [l[i] for i in range(0, len(l), 2)]\n    even_elements.sort()\n\n    result_list = list(l)\n    even_idx_pointer = 0\n    for i in range(0, len(result_list), 2):\n        result_list[i] = even_elements[even_idx_pointer]\n        even_idx_pointer += 1\n\n    return result_list\n```"}
{"task_id": "HumanEval/37", "solution": "```python\ndef sort_even(l: list) -> list:\n    \"\"\"This function takes a list l and returns a new list where even-indexed elements are sorted\n    and odd-indexed elements are preserved.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    even_elements = []\n    for i in range(len(l)):\n        if i % 2 == 0:\n            even_elements.append(l[i])\n\n    even_elements.sort()\n\n    result = list(l)\n\n    even_idx_counter = 0\n    for i in range(len(result)):\n        if i % 2 == 0:\n            result[i] = even_elements[even_idx_counter]\n            even_idx_counter += 1\n    return result\n```"}
{"task_id": "HumanEval/36", "solution": "```python\ndef fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\"\"\"\n    total_count = 0\n    divisor_one = 11\n    divisor_two = 13\n    target_digit = 7\n\n    for i in range(1, n):\n        if (i % divisor_one == 0) or (i % divisor_two == 0):\n            total_count += str(i).count(str(target_digit))\n    return total_count\n```"}
{"task_id": "HumanEval/36", "solution": "```python\ndef fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    total_sevens_count = 0\n    target_digit_char = '7'\n\n    for i in range(1, n):\n        if i % 11 == 0 or i % 13 == 0:\n            current_number_str = str(i)\n            sevens_in_current_number = current_number_str.count(target_digit_char)\n            total_sevens_count += sevens_in_current_number\n\n    return total_sevens_count\n```"}
{"task_id": "HumanEval/38", "solution": "```python\ndef encode_cyclic(s: str):\n    \"\"\"\n    returns encoded string by cycling groups of three characters.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[1:] + group[0]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)\n\n\ndef decode_cyclic(s: str):\n    \"\"\"\n    Decodes a string that has been encoded using the encode_cyclic function.\n    Reverses the cyclic left shift for groups of three characters.\n    \"\"\"\n    decoded_parts = []\n    n = len(s)\n    for i in range(0, n, 3):\n        chunk = s[i:i+3]\n        if len(chunk) == 3:\n            # Perform a cyclic RIGHT shift: \"bca\" -> \"abc\"\n            decoded_parts.append(chunk[2] + chunk[0] + chunk[1])\n        else:\n            # Groups with fewer than three characters are left unchanged\n            decoded_parts.append(chunk)\n    return \"\".join(decoded_parts)\n```"}
{"task_id": "HumanEval/38", "solution": "```python\ndef decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    decoded_groups = []\n    for group in groups:\n        if len(group) == 3:\n            decoded_group = group[-1] + group[:-1]\n            decoded_groups.append(decoded_group)\n        else:\n            decoded_groups.append(group)\n    return \"\".join(decoded_groups)\n```"}
{"task_id": "HumanEval/32", "solution": "```python\nimport math\n\n_DEFAULT_TOLERANCE: float = 1e-6\n_MAX_ITERATIONS: int = 1000\n_SEARCH_RANGE_START: float = -100.0\n_SEARCH_RANGE_END: float = 100.0\n\n\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    Returns xs[0] + xs[1] * x + ... + xs[n] * x^n.\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\n\n\ndef find_zero(xs: list):\n    \"\"\"\n    Finds a single zero x such that poly(xs, x) = 0 using the bisection method.\n    It returns only one zero point, even if there are many.\n    \"\"\"\n    a = _SEARCH_RANGE_START\n    b = _SEARCH_RANGE_END\n\n    poly_a = poly(xs, a)\n\n    # Initialize poly_b for the bisection loop, although it will be updated.\n    # The bisection logic primarily uses poly_a and poly_m for sign comparison.\n    # No explicit check for poly_a * poly_b > 0 as per critical requirements.\n\n    m = (a + b) / 2.0 # Initialize m outside the loop for the final return if needed\n\n    for _ in range(_MAX_ITERATIONS):\\\n        m = (a + b) / 2.0\n        poly_m = poly(xs, m)\n\n        if abs(poly_m) < _DEFAULT_TOLERANCE:\n            return m\n\n        if poly_a * poly_m < 0:\n            b = m\n            # No need to update poly_b explicitly if we're only checking poly_a * poly_m\n        else:\n            a = m\n            poly_a = poly_m # Update poly_a for the next iteration\n\n    # If the loop completes without finding a zero within tolerance, return the last midpoint.\n    return m\n\n```"}
