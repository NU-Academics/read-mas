{"task_id": "HumanEval/154", "solution": "```python\ndef cycpattern_check(a , b):\n    \"\"\"\n    Checks if any cyclic rotation of string b is a substring within string a.\n    \"\"\"\n    if not b:\n        return True # An empty string is a substring of any string.\n\n    # If b is not empty, but is longer than a, it cannot be a substring.\n    # This also covers the case where 'a' is empty and 'b' is not.\n    if len(b) > len(a):\n        return False\n\n    rotations = set()\n    n = len(b)\n    for i in range(n):\n        rotated_b = b[i:] + b[:i]\n        rotations.add(rotated_b)\n\n    for rotation in rotations:\n        if rotation in a:\n            return True\n\n    return False\n```"}
{"task_id": "HumanEval/155", "solution": "```python\ndef even_odd_count(num):\n    \"\"\"Given an integer, this function counts its even and odd digits.\n    It processes the absolute value and returns a tuple (even_count, odd_count).\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    # Convert the absolute value of the number to a string to iterate through digits.\n    abs_num_str = str(abs(num))\n\n    for digit_char in abs_num_str:\n        digit = int(digit_char)\n        # Check if the digit is even or odd.\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)\n```"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer, return a tuple that has the number of even and odd digits respectively.\n    The absolute value of the number is used for digit analysis.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    # Convert the absolute value of the number to a string to iterate through digits.\n    num_str = str(abs(num))\n\n    for char_digit in num_str:\n        digit = int(char_digit)\n        if digit % 2 == 0:  # Check if the digit is even (0 is even).\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/156", "solution": "```python\n_ROMAN_MAP = {\n    1000: 'm', 900: 'cm', 500: 'd', 400: 'cd',\n    100: 'c', 90: 'xc', 50: 'l', 40: 'xl',\n    10: 'x', 9: 'ix', 5: 'v', 4: 'iv', 1: 'i'\n}\n\n\ndef int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    roman_numeral = []\n    temp_num = number\n    for value, symbol in _ROMAN_MAP.items():\n        while temp_num >= value:\n            roman_numeral.append(symbol)\n            temp_num -= value\n    return \"\".join(roman_numeral)\n```"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or\n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    EPSILON = 1e-9\n\n    sides = sorted([a, b, c])\n    s1, s2, s3 = sides[0], sides[1], sides[2]\n\n    return abs(s1**2 + s2**2 - s3**2) < EPSILON"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n\n    Examples:\n    >>> int_to_mini_roman(19) == 'xix'\n    >>> int_to_mini_roman(152) == 'clii'\n    >>> int_to_mini_roman(426) == 'cdxxvi'\n    \"\"\"\n    ROMAN_MAP = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'), (1, 'I')\n    ]\n\n    # The design includes validation, but the problem description implies valid input\n    # based on the \"Restrictions\" and \"Examples\".\n    # However, to align with the design's validation step, let's include a simple check.\n    # The original prompt specified \"1 <= num <= 1000\", which the design also covers.\n    # The design suggested InvalidInputError, but since we cannot define classes,\n    # we will use a standard ValueError if the input is outside the expected range.\n    MIN_VALUE = 1\n    MAX_VALUE = 1000\n\n    if not isinstance(number, int) or not (MIN_VALUE <= number <= MAX_VALUE):\n        raise ValueError(\n            f\"Input must be an integer between {MIN_VALUE} and {MAX_VALUE} inclusive.\"\n        )\n\n    roman_numeral = []\n    temp_num = number\n\n    for value, symbol in ROMAN_MAP:\n        while temp_num >= value:\n            roman_numeral.append(symbol)\n            temp_num -= value\n\n    return \"\".join(roman_numeral).lower()"}
{"task_id": "HumanEval/157", "solution": "```python\ndef right_angle_triangle(a, b, c):\n    \"\"\"\n    Given the lengths of three sides, returns True if they form a right-angled triangle.\n    It checks if the square of one side equals the sum of the squares of the other two, with tolerance.\n    \"\"\"\n    # Handle non-positive side lengths as per FR5.\n    if not (a > 0 and b > 0 and c > 0):\n        return False\n\n    a_sq = a * a\n    b_sq = b * b\n    c_sq = c * c\n\n    # Apply Pythagorean theorem considering all permutations with a small tolerance for float precision.\n    if (abs(a_sq + b_sq - c_sq) < 1e-9 or\n        abs(a_sq + c_sq - b_sq) < 1e-9 or\n        abs(b_sq + c_sq - a_sq) < 1e-9):\n        return True\n    else:\n        return False\n```"}
{"task_id": "HumanEval/158", "solution": "```python\ndef find_max(words):\n    \"\"\"\n    Finds the word with the maximum unique characters,\n    using lexicographical order for tie-breaking.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_count = len(set(word))\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            if result_word == \"\" or word < result_word:\n                result_word = word\n\n    return result_word\n```"}
{"task_id": "HumanEval/158", "solution": "```python\ndef find_max(words):\n    \"\"\"\n    Finds the word with the maximum number of unique characters,\n    with lexicographical tie-breaking.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    def _count_unique_chars(word: str) -> int:\n        \"\"\"Counts the number of unique characters in a string.\"\"\"\n        return len(set(word))\n\n    result_word = words[0]\n    max_unique_count = _count_unique_chars(result_word)\n\n    for i in range(1, len(words)):\n        word = words[i]\n        current_unique_count = _count_unique_chars(word)\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            if word < result_word:\n                result_word = word\n\n    return result_word\n```"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Simulates a rabbit's carrot consumption based on its need and available stock.\n    Returns the total carrots eaten and the remaining stock as an array.\n    \"\"\"\n    carrots_to_eat = min(need, remaining)\n    total_eaten_carrots = number + carrots_to_eat\n    carrots_left_in_stock = remaining - carrots_to_eat\n    return [total_eaten_carrots, carrots_left_in_stock]"}
{"task_id": "HumanEval/159", "solution": "```python\ndef eat(number, need, remaining):\n    \"\"\"\n    Calculates total eaten carrots and remaining stock after a rabbit's meal.\n    The rabbit eats the minimum of its need or available remaining carrots.\n    \"\"\"\n    actual_eaten_this_meal = min(need, remaining)\n    total_eaten = number + actual_eaten_this_meal\n    carrots_left = remaining - actual_eaten_this_meal\n    return [total_eaten, carrots_left]\n```"}
{"task_id": "HumanEval/161", "solution": "```python\ndef solve(s):\n    \"\"\"\n    Reverses the case of letters in a string, keeping non-letters unchanged.\n    If the string contains no letters, the entire string is reversed.\n    \"\"\"\n    has_letters = any(char.isalpha() for char in s)\n\n    if not has_letters:\n        return s[::-1]\n    else:\n        result_chars = []\n        for char in s:\n            if char.isalpha():\n                if char.islower():\n                    result_chars.append(char.upper())\n                else:  # char.isupper()\n                    result_chars.append(char.lower())\n            else:\n                result_chars.append(char)\n        return \"\".join(result_chars)\n```"}
{"task_id": "HumanEval/161", "solution": "```python\ndef solve(s):\n    \"\"\"\n    Modifies a string based on character type: reverses letter case or reverses the entire string if no letters.\n    Returns the modified string.\n    \"\"\"\n    has_letters = any(c.isalpha() for c in s)\n\n    if not has_letters:\n        return s[::-1]\n\n    modified_chars = []\n    for char in s:\n        if char.isalpha():\n            modified_chars.append(char.swapcase())\n        else:\n            modified_chars.append(char)\n    return \"\".join(modified_chars)\n```"}
