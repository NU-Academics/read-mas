{"task_id": "HumanEval/77", "solution": "```python\nimport math\n\ndef iscube(a):\n    \"\"\"\n    Checks if an integer 'a' is a perfect cube of some integer number.\n    It calculates the rounded cube root and verifies if its cube matches 'a'.\n    \"\"\"\n    if a == 0:\n        return True\n\n    # Determine the sign and work with the absolute value to compute the cube root.\n    # Floating-point precision is managed by rounding the root and then cubing it back for exact comparison.\n    sign = 1 if a >= 0 else -1\n    abs_a = abs(a)\n\n    # Use math.cbrt if available (Python 3.11+), otherwise use the power operator.\n    if hasattr(math, 'cbrt'):\n        root = round(math.cbrt(abs_a))\n    else:\n        root = round(abs_a**(1/3))\n\n    # Reconstruct the potential cube and compare it to the original number 'a'.\n    return (root * root * root * sign) == a\n```"}
{"task_id": "HumanEval/77", "solution": "```python\ndef iscube(a: int) -> bool:\n    \"\"\"\n    Checks if an integer 'a' is a perfect cube.\n    It handles positive, negative, and zero inputs using floating-point cube root and rounding for verification.\n    \"\"\"\n    if a == 0:\n        return True\n\n    if a < 0:\n        root = round((-a)**(1/3))\n        return (-root * -root * -root) == a\n    else:\n        root = round(a**(1/3))\n        return (root * root * root) == a\n```"}
{"task_id": "HumanEval/75", "solution": "```python\ndef is_multiply_prime(a):\n    \"\"\"Checks if 'a' is the product of exactly three prime numbers.\n    'a' is less than 100.\"\"\"\n\n    def _is_prime(n: int) -> bool:\n        \"\"\"Helper to check if a number is prime. Handles numbers greater than or equal to 2.\"\"\"\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    # The smallest multiply prime is 2*2*2 = 8.\n    if a < 8:\n        return False\n\n    prime_factors = []\n    temp_a = a\n\n    # Find prime factors by iterative division.\n    for i in range(2, int(temp_a**0.5) + 1):\n        while temp_a % i == 0 and _is_prime(i):\n            prime_factors.append(i)\n            temp_a //= i\n            # Optimization: if more than 3 factors, it's not a multiply prime.\n            if len(prime_factors) > 3:\n                return False\n\n    # If temp_a is still greater than 1, it must be the last prime factor.\n    if temp_a > 1:\n        prime_factors.append(temp_a)\n\n    # Return True if exactly 3 prime factors were found.\n    return len(prime_factors) == 3\n```"}
{"task_id": "HumanEval/75", "solution": "```python\nimport itertools\n\ndef is_multiply_prime(a):\n    \"\"\"Checks if the given number is the product of exactly three distinct prime numbers.\n    The input 'a' is assumed to be an integer less than 100.\"\"\"\n\n    def is_prime_local(n):\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    def get_primes_up_to_local(limit):\n        primes = []\n        for i in range(2, limit + 1):\n            if is_prime_local(i):\n                primes.append(i)\n        return primes\n\n    # The smallest product of three distinct primes is 2 * 3 * 5 = 30.\n    # Numbers less than 30 cannot be multiply primes in this context.\n    if a < 30:\n        return False\n\n    primes = get_primes_up_to_local(a)\n\n    for p1, p2, p3 in itertools.combinations(primes, 3):\n        if p1 * p2 * p3 == a:\n            return True\n    return False\n```"}
{"task_id": "HumanEval/76", "solution": "```python\ndef is_simple_power(x, n):\n    \"\"\"Checks if x is a simple power of n, i.e., n^k = x for non-negative integer k.\n    Assumes x and n are non-negative integers as per preconditions.\"\"\"\n\n    if x == 1:\n        return True # This covers cases like n^0 = 1 for any n >= 0.\n\n    if n == 0:\n        return x == 0 # 0 is a power of 0 (0^k=0 for k>0). 0^0=1 is handled above.\n\n    if n == 1:\n        return False # 1^k is always 1. If x > 1, it cannot be a power of 1.\n\n    # For x > 1 and n > 1, repeatedly divide x by n.\n    current_x = x\n    while current_x > 1:\n        if current_x % n != 0:\n            return False\n        current_x //= n\n    return current_x == 1\n```"}
