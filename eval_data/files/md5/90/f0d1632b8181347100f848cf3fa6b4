{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    You are given an array arr of integers and you need to return\n    sum of magnitudes of integers multiplied by product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    Note: return None for empty arr.\n    \"\"\"\n    if not arr:\n        return None\n\n    sum_magnitudes = 0\n    product_of_signs = 1\n\n    for n in arr:\n        sum_magnitudes += abs(n)\n\n        sign = 0\n        if n > 0:\n            sign = 1\n        elif n < 0:\n            sign = -1\n\n        product_of_signs *= sign\n\n    return sum_magnitudes * product_of_signs"}
{"task_id": "HumanEval/127", "solution": "```python\ndef is_prime(n: int) -> bool:\n    \"\"\"\n    Determines if a given integer n is a prime number.\n    Returns True if n is prime, False otherwise.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    # Iterate from 2 up to the square root of n.\n    for i in range(2, int(n**0.5) + 1):\n        if n % i == 0:\n            return False\n    return True\n\ndef intersection(interval1: tuple[int, int], interval2: tuple[int, int]) -> str:\n    \"\"\"You are given two intervals,\n    where each interval is a pair of integers. For example, interval = (start, end) = (1, 2).\n    The given intervals are closed which means that the interval (start, end)\n    includes both start and end.\n    For each given interval, it is assumed that its start is less or equal its end.\n    Your task is to determine whether the length of intersection of these two\n    intervals is a prime number.\n    Example, the intersection of the intervals (1, 3), (2, 4) is (2, 3)\n    which its length is 1, which not a prime number.\n    If the length of the intersection is a prime number, return \"YES\",\n    otherwise, return \"NO\".\n    If the two intervals don't intersect, return \"NO\".\n\n\n    [input/output] samples:\n    intersection((1, 2), (2, 3)) ==> \"NO\"\n    intersection((-1, 1), (0, 4)) ==> \"NO\"\n    intersection((-3, -1), (-5, 5)) ==> \"YES\"\n    \"\"\"\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    start_intersect = max(start1, start2)\n    end_intersect = min(end1, end2)\n\n    # If start of intersection is greater than end, there is no overlap.\n    if start_intersect > end_intersect:\n        return \"NO\"\n\n    length = end_intersect - start_intersect\n    if is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\"\n\n```"}
{"task_id": "HumanEval/128", "solution": "```python\ndef prod_signs(arr):\n    \"\"\"\n    Calculates the sum of magnitudes multiplied by the product of signs for an array of integers.\n    Returns None for an empty array, otherwise returns the calculated integer value.\n    \"\"\"\n    if not arr:\n        return None\n\n    product_of_signs = 1\n    sum_of_magnitudes = 0\n\n    for num in arr:\n        # Determine the sign of the current number.\n        sign = 0\n        if num > 0:\n            sign = 1\n        elif num < 0:\n            sign = -1\n\n        product_of_signs *= sign\n        sum_of_magnitudes += abs(num)\n\n    return sum_of_magnitudes * product_of_signs\n```"}
{"task_id": "HumanEval/127", "solution": "```python\nfrom typing import Optional\n\nclass Interval:\n    \"\"\"Represents a closed interval [start, end] with basic operations.\"\"\"\n    def __init__(self, start: int, end: int):\n        self.start = start\n        self.end = end\n\n    def length(self) -> int:\n        \"\"\"Calculates and returns the length of the interval.\"\"\"\n        return self.end - self.start\n\n    def intersects(self, other: 'Interval') -> bool:\n        \"\"\"Checks if this interval intersects with another Interval object.\"\"\"\n        return self.start <= other.end and other.start <= self.end\n\n\nclass PrimeChecker:\n    \"\"\"Provides a utility method to check if a given integer is a prime number.\"\"\"\n    @staticmethod\n    def is_prime(n: int) -> bool:\n        \"\"\"Determines if the input integer n is a prime number.\"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n\nclass IntervalService:\n    \"\"\"Encapsulates business logic for interval operations.\"\"\"\n    def calculate_intersection(self, interval1: Interval, interval2: Interval) -> Optional[Interval]:\n        \"\"\"Computes the intersection of two Interval objects.\"\"\"\n        if not interval1.intersects(interval2):\n            return None\n\n        max_start = max(interval1.start, interval2.start)\n        min_end = min(interval1.end, interval2.end)\n        return Interval(max_start, min_end)\n\n    def get_intersection_length_is_prime(self, interval1_tuple: tuple[int, int], interval2_tuple: tuple[int, int]) -> str:\n        \"\"\"Orchestrates the process to check if intersection length is prime.\"\"\"\n        interval1 = Interval(interval1_tuple[0], interval1_tuple[1])\n        interval2 = Interval(interval2_tuple[0], interval2_tuple[1])\n\n        intersection_interval = self.calculate_intersection(interval1, interval2)\n\n        if intersection_interval is None:\n            return \"NO\"\n\n        length = intersection_interval.length()\n\n        if PrimeChecker.is_prime(length):\n            return \"YES\"\n        else:\n            return \"NO\"\n\n\ndef intersection(interval1: tuple[int, int], interval2: tuple[int, int]) -> str:\n    \"\"\"You are given two intervals,\n    where each interval is a pair of integers. For example, interval = (start, end) = (1, 2).\n    The given intervals are closed which means that the interval (start, end)\n    includes both start and end.\n    For each given interval, it is assumed that its start is less or equal its end.\n    Your task is to determine whether the length of intersection of these two\n    intervals is a prime number.\n    Example, the intersection of the intervals (1, 3), (2, 4) is (2, 3)\n    which its length is 1, which not a prime number.\n    If the length of the intersection is a prime number, return \"YES\",\n    otherwise, return \"NO\".\n    If the two intervals don't intersect, return \"NO\".\n\n\n    [input/output] samples:\n    intersection((1, 2), (2, 3)) ==> \"NO\"\n    intersection((-1, 1), (0, 4)) ==> \"NO\"\n    intersection((-3, -1), (-5, 5)) ==> \"YES\"\n    \"\"\"\n    service = IntervalService()\n    return service.get_intersection_length_is_prime(interval1, interval2)\n```"}
{"task_id": "HumanEval/129", "solution": "```python\nimport heapq\n\ndef minPath(grid, k):\n    \"\"\"\n    Finds the lexicographically smallest path of length k in a grid.\n    Uses a Dijkstra-like BFS with a min-priority queue for path comparison.\n    \"\"\"\n    N = len(grid)\n\n    # Priority queue stores tuples: (current_path_tuple, row, col, current_length).\n    # The current_path_tuple allows heapq to perform lexicographical comparison.\n    pq = []\n\n    # Dictionary to store the lexicographically smallest path found so far\n    # to reach a specific state (row, col, length). This is for pruning.\n    dist = {} # Keys: (row, col, length), Values: current_path_tuple\n\n    # Define directions for exploring neighbors (up, down, left, right).\n    dr = [-1, 1, 0, 0]\n    dc = [0, 0, -1, 1]\n\n    # Initialize the priority queue with all possible starting cells (paths of length 1).\n    for r in range(N):\n        for c in range(N):\n            initial_path = (grid[r][c],)\n            heapq.heappush(pq, (initial_path, r, c, 1))\n            dist[(r, c, 1)] = initial_path\n\n    # Main Dijkstra-like BFS loop to find the shortest lexicographical path.\n    while pq:\n        current_path_tuple, r, c, current_length = heapq.heappop(pq)\n\n        # Pruning: If a lexicographically smaller or equal path to this state\n        # has already been found and processed, skip this path.\n        if current_path_tuple > dist.get((r, c, current_length), current_path_tuple):\n            continue\n\n        # Goal Check: If the current path has reached the desired length k, return it.\n        if current_length == k:\n            return list(current_path_tuple)\n\n        # Explore neighbors if the path length is less than k.\n        for i in range(4):\n            nr, nc = r + dr[i], c + dc[i]\n\n            # Check if the neighbor cell is within the grid boundaries.\n            if 0 <= nr < N and 0 <= nc < N:\n                next_length = current_length + 1\n                new_path_tuple = current_path_tuple + (grid[nr][nc],)\n\n                # Update `dist` and push to `pq` if this new path is better or new.\n                if (nr, nc, next_length) not in dist or \\\n                   new_path_tuple < dist[(nr, nc, next_length)]:\\\n                    dist[(nr, nc, next_length)] = new_path_tuple\n                    heapq.heappush(pq, (new_path_tuple, nr, nc, next_length))\n\n    # This part should not be reached based on the problem guarantees that an answer always exists.\n    return []\n```"}
{"task_id": "HumanEval/131", "solution": "```python\ndef digits(n: int) -> int:\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\"\"\"\n    product = 1\n    has_odd_digit = False\n    temp_n = n\n\n    while temp_n > 0:\n        digit = temp_n % 10\n        if digit % 2 != 0:  # Check if digit is odd\n            product *= digit\n            has_odd_digit = True\n        temp_n //= 10\n\n    if not has_odd_digit:\n        return 0\n    return product\n```"}
{"task_id": "HumanEval/130", "solution": "```python\ndef tri(n):\n    \"\"\"\n    Calculates the first n + 1 numbers of the Tribonacci sequence.\n    This function uses memoization to store previously computed terms.\n    \"\"\"\n    _memo = {}\n\n    def _get_single_term(k):\n        \"\"\"\n        Recursively calculates the k-th Tribonacci term with memoization.\n        \"\"\"\n        if k in _memo:\n            return _memo[k]\n\n        if k == 0:\n            result = 1\n        elif k == 1:\n            result = 3\n        elif k % 2 == 0:  # k is even and >= 2\n            result = 1 + k // 2\n        else:  # k is odd and >= 3\n            # tri(k) = tri(k - 1) + tri(k - 2) + tri(k + 1)\n            term_k_minus_1 = _get_single_term(k - 1)\n            term_k_minus_2 = _get_single_term(k - 2)\n            term_k_plus_1 = _get_single_term(k + 1)\n            result = term_k_minus_1 + term_k_minus_2 + term_k_plus_1\n\n        _memo[k] = result\n        return result\n\n    sequence = []\n    for i in range(n + 1):\n        sequence.append(_get_single_term(i))\n\n    return sequence\n```"}
{"task_id": "HumanEval/131", "solution": "```python\ndef digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Returns 0 if no odd digits are found.\n    \"\"\"\n    product = 1\n    has_odd_digit = False\n\n    # Work with a temporary copy of n to extract digits\n    temp_n = n\n\n    while temp_n > 0:\n        digit = temp_n % 10\n        if digit % 2 != 0:  # Check if digit is odd\n            product *= digit\n            has_odd_digit = True\n        temp_n //= 10\n\n    return product if has_odd_digit else 0\n```"}
{"task_id": "HumanEval/129", "solution": "```python\nclass Cell:\n    def __init__(self, row: int, col: int, value: int):\n        self.row = row\n        self.col = col\n        self.value = value\n\nclass Grid:\n    def __init__(self, grid_data: list[list[int]]):\n        self.N = len(grid_data)\n        self.grid_cells: list[list[Cell]] = []\n        for r in range(self.N):\n            row_cells = []\n            for c in range(self.N):\n                row_cells.append(Cell(r, c, grid_data[r][c]))\n            self.grid_cells.append(row_cells)\n\n    def get_cell(self, row: int, col: int) -> Cell:\n        return self.grid_cells[row][col]\n\n    def get_neighbors(self, row: int, col: int) -> list[Cell]:\n        neighbors = []\n        directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]\n        for dr, dc in directions:\n            new_row, new_col = row + dr, col + dc\n            if 0 <= new_row < self.N and 0 <= new_col < self.N:\n                neighbors.append(self.grid_cells[new_row][new_col])\n        return neighbors\n\n    def get_dimensions(self) -> tuple[int, int]:\n        return self.N, self.N\n\nclass Path:\n    def __init__(self, values: list[int]):\n        self.values = values\n\n    def __lt__(self, other: 'Path') -> bool:\n        \"\"\"\n        Compares two paths lexicographically.\n        Python's list comparison handles lexicographical order directly.\n        \"\"\"\n        return self.values < other.values\n\n    def get_values(self) -> list[int]:\n        return self.values\n\nclass PathFinder:\n    def __init__(self, grid: Grid, k: int):\n        self.grid = grid\n        self.k = k\n        self.min_path_values_from_start: list[int] = []\n\n    def _dfs(self, current_row: int, current_col: int, current_path_values: list[int]):\n        # Base case: path length k reached.\n        if len(current_path_values) == self.k:\n            if Path(current_path_values) < Path(self.min_path_values_from_start):\n                self.min_path_values_from_start = list(current_path_values)\n            return\n\n        # Recursive step: explore neighbors.\n        neighbors = self.grid.get_neighbors(current_row, current_col)\n        for neighbor_cell in neighbors:\n            self._dfs(neighbor_cell.row, neighbor_cell.col, current_path_values + [neighbor_cell.value])\n\n    def find_min_path_from_start(self, start_row: int, start_col: int) -> list[int]:\n        # Reset min_path_values_from_start for each new starting point search.\n        self.min_path_values_from_start = [float('inf')] * self.k\n\n        start_cell = self.grid.get_cell(start_row, start_col)\n        self._dfs(start_row, start_col, [start_cell.value])\n\n        return self.min_path_values_from_start\n\nclass MinPathSolver:\n    def __init__(self, grid_data: list[list[int]], k: int):\n        self.grid = Grid(grid_data)\n        self.k = k\n        self.path_finder = PathFinder(self.grid, self.k)\n        self.overall_min_path: list[int] = [float('inf')] * k\n\n    def find_min_path(self) -> list[int]:\n        N, _ = self.grid.get_dimensions()\n        for r in range(N):\n            for c in range(N):\n                min_path_from_start = self.path_finder.find_min_path_from_start(r, c)\n                current_path_obj = Path(min_path_from_start)\n                overall_min_path_obj = Path(self.overall_min_path)\n                if current_path_obj < overall_min_path_obj:\n                    self.overall_min_path = min_path_from_start\n        return self.overall_min_path\n\ndef minPath(grid: list[list[int]], k: int) -> list[int]:\n    \"\"\"\n    Finds the lexicographically smallest path of length k in the grid.\n    Starts search from every cell and explores paths using DFS.\n    \"\"\"\n    solver = MinPathSolver(grid, k)\n    return solver.find_min_path()\n```"}
{"task_id": "HumanEval/132", "solution": "```python\ndef _is_valid_and_nested_substring(sub: str) -> bool:\n    \"\"\"\n    Checks if a given substring is a valid (balanced) bracket sequence\n    and has a maximum nesting depth of at least 2.\n    \"\"\"\n    stack = []\n    current_depth = 0\n    max_depth = 0\n\n    for char in sub:\n        if char == '[':\n            stack.append(char)\n            current_depth += 1\n            max_depth = max(max_depth, current_depth)\n        elif char == ']':\n            if not stack:\n                return False\n            stack.pop()\n            current_depth -= 1\n\n    # A valid bracket sequence must be balanced and achieve max_depth >= 2.\n    return not stack and max_depth >= 2\n\ndef is_nested(string: str) -> bool:\n    \"\"\"\n    Determines if the input string contains a substring that is a valid\n    bracket sequence with at least one nested bracket.\n    \"\"\"\n    n = len(string)\n    # Iterate through all possible substrings.\n    for i in range(n):\n        for j in range(i + 1, n + 1):\n            substring = string[i:j]\n            if _is_valid_and_nested_substring(substring):\n                return True\n    return False\n```"}
{"task_id": "HumanEval/133", "solution": "```python\nimport math\n\ndef sum_squares(lst):\n    \"\"\"Calculates the sum of squares of ceiling-rounded numbers in a list.\n    Each number is rounded up to the nearest integer before squaring.\n    \"\"\"\n    if not lst:\n        return 0\n\n    total_sum = 0\n    for num in lst:\n        rounded_num = math.ceil(num)\n        total_sum += rounded_num * rounded_num\n    return total_sum\n```"}
