{"task_id": "HumanEval/4", "solution": "```python\nfrom typing import List\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\"Calculates Mean Absolute Deviation (MAD) for a dataset.\n    MAD is the average absolute difference between each element and the mean.\n    \"\"\"\n    mean = sum(numbers) / len(numbers)\n    absolute_differences = [abs(x - mean) for x in numbers]\n    return sum(absolute_differences) / len(absolute_differences)\n```"}
{"task_id": "HumanEval/1", "solution": "```python\nfrom typing import List\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"Separates balanced, non-nested parentheses groups from an input string, ignoring spaces.\n    Returns a list of the identified groups.\"\"\"\n    cleaned_string = paren_string.replace(\" \", \"\").replace(\"\\t\", \"\").replace(\"\\n\", \"\")\n\n    groups = []\n    balance_count = 0\n    group_start_index = -1\n\n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            if balance_count == 0:\n                group_start_index = i\n            balance_count += 1\n        elif char == ')':\n            balance_count -= 1\n\n        # If balance drops below zero, it indicates an unmatched ')' invalidating all found groups.\n        if balance_count < 0:\n            return []\n\n        # When balance returns to zero after processing a sequence, it's a complete group.\n        if balance_count == 0 and group_start_index != -1:\n            group = cleaned_string[group_start_index : i + 1]\n            groups.append(group)\n            group_start_index = -1 # Reset for the next top-level group\n\n    # After checking all characters, if balance_count is not zero, unmatched '(' exist.\n    if balance_count != 0:\n        return []\n\n    return groups\n```"}
{"task_id": "HumanEval/7", "solution": "```python\nfrom typing import List\n\n\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    return [s for s in strings if substring in s]\n```"}
{"task_id": "HumanEval/6", "solution": "```python\nfrom typing import List\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n\n    def _calculate_group_depth(group: str) -> int:\n        \"\"\"Helper function to calculate the deepest nesting level for a single group.\"\"\"\n        current_depth = 0\n        max_depth = 0\n        for char in group:\n            if char == '(':\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif char == ')':\n                current_depth -= 1\n        return max_depth\n\n    if not paren_string.strip():\n        return []\n\n    groups = paren_string.split(' ')\n    results = []\n    for group in groups:\n        if group: # Process only non-empty group strings.\n            results.append(_calculate_group_depth(group))\n    return results\n```\n"}
{"task_id": "HumanEval/8", "solution": "```python\nfrom typing import List, Tuple\n\n\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    \"\"\"\n    if not numbers:\n        return (0, 1)\n\n    current_sum = 0\n    current_product = 1\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n    return (current_sum, current_product)\n```"}
