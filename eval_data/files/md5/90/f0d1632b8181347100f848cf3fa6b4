{"task_id": "HumanEval/104", "solution": "```python\ndef unique_digits(x):\n    \"\"\"Filters a list of positive integers, returning a sorted list of numbers without any even digits.\"\"\"\n\n    # Define the set of even digits for efficient lookup.\n    EVEN_DIGITS = {0, 2, 4, 6, 8}\n\n    filtered_list = []\n    for number in x:\n        has_even = False\n        # Check each digit of the number.\n        for digit_char in str(number):\n            if int(digit_char) in EVEN_DIGITS:\n                has_even = True\n                break  # An even digit was found, so this number is excluded.\n\n        if not has_even:\n            filtered_list.append(number)\n\n    filtered_list.sort()  # Sort the resulting list in increasing order.\n    return filtered_list\n```"}
{"task_id": "HumanEval/103", "solution": "```python\ndef rounded_avg(n: int, m: int) -> str | int:\n    \"\"\"Computes the rounded average of integers in a range and returns its binary string.\n    Returns -1 if n is greater than m.\"\"\"\n    import math\n\n    # FR5: Handle the error condition where n is greater than m.\n    if n > m:\n        return -1\n\n    # Inline helper for FR1: Calculates the sum of integers from start to end (inclusive).\n    def _calculate_sum_range_inline(start: int, end: int) -> int:\n        # Uses the arithmetic progression sum formula for efficiency.\n        count = end - start + 1\n        return (count * (start + end)) // 2\n\n    # Inline helper for FR3: Rounds a floating-point number to the nearest integer, 0.5 rounds up.\n    def _round_to_nearest_int_inline(value: float) -> int:\n        # This custom rounding logic ensures 0.5 always rounds up for positive values.\n        return int(math.floor(value + 0.5))\n\n    # Inline helper for FR4: Converts an integer to its binary string representation.\n    def _to_binary_string_inline(value: int) -> str:\n        return bin(value)\n\n    # FR1: Calculate the sum of integers from n to m.\n    sum_val = _calculate_sum_range_inline(n, m)\n\n    # Calculate the count of integers in the range [n, m].\n    count = m - n + 1\n\n    # FR2: Compute the floating-point average of the integers.\n    average = sum_val / count\n\n    # FR3: Round the computed average to the nearest integer.\n    rounded_average = _round_to_nearest_int_inline(average)\n\n    # FR4: Convert the rounded integer average to its binary string representation.\n    binary_string = _to_binary_string_inline(rounded_average)\n\n    return binary_string\n```"}
{"task_id": "HumanEval/104", "solution": "```python\ndef unique_digits(x):\n    \"\"\"Given a list of positive integers x. return a sorted list of all\n    elements that hasn't any even digit.\n\n    Note: Returned list should be sorted in increasing order.\n\n    For example:\n    >>> unique_digits([15, 33, 1422, 1])\n    [1, 15, 33]\n    >>> unique_digits([152, 323, 1422, 10])\n    []\n    \"\"\"\n\n    def is_positive_integer(value):\n        \"\"\"Checks if a given value is an integer and is positive.\"\"\"\n        return isinstance(value, int) and value > 0\n\n    EVEN_DIGITS = {'0', '2', '4', '6', '8'}\n\n    def has_even_digit(number):\n        \"\"\"Checks if a given integer contains any even digit.\"\"\"\n        return any(digit in EVEN_DIGITS for digit in str(number))\n\n    filtered_numbers = []\n    for number in x:\n        if is_positive_integer(number) and not has_even_digit(number):\n            filtered_numbers.append(number)\n\n    filtered_numbers.sort()\n    return filtered_numbers\n```"}
{"task_id": "HumanEval/103", "solution": "def rounded_avg(n, m):\n    \"\"\"Computes the rounded average of integers from n to m, then converts to binary.\n    Returns -1 if n is greater than m.\n    \"\"\"\n    # FR5: The system shall return -1 if n is greater than m.\n    if n > m:\n        return -1\n\n    # FR1: The system shall calculate the sum of integers from n through m (inclusive).\n    total_sum = 0\n    for i in range(n, m + 1):\n        total_sum += i\n\n    # Calculate the count of integers in the range [n, m]\n    count = m - n + 1\n\n    # FR2: The system shall compute the average of the integers in the range [n, m].\n    average = total_sum / count\n\n    # FR3: The system shall round the computed average to the nearest integer (round half up).\n    # For positive numbers, int(x + 0.5) implements round half up.\n    rounded_avg_int = int(average + 0.5)\n\n    # FR4: The system shall convert the rounded integer average to its binary string representation.\n    return bin(rounded_avg_int)"}
{"task_id": "HumanEval/105", "solution": "```python\ndef by_length(arr):\n    \"\"\"\n    Transforms an array of integers by filtering numbers 1-9, sorting, reversing, and mapping them to their word names.\n    Non-matching numbers are ignored.\n    \"\"\"\n    if not arr:\n        return []\n\n    _MAPPING = {\n        1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n        6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\"\n    }\n\n    # Filters to numbers 1-9. Assumes elements are numerically comparable due to strict constraints.\n    filtered_numbers = [n for n in arr if isinstance(n, int) and 1 <= n <= 9]\n\n    filtered_numbers.sort()\n    filtered_numbers.reverse()\n\n    result = [_MAPPING[n] for n in filtered_numbers]\n\n    return result\n```"}
{"task_id": "HumanEval/107", "solution": "```python\ndef even_odd_palindrome(n):\n    \"\"\"\n    Given a positive integer n, return a tuple containing the counts of even and odd\n    integer palindromes within the range [1, n] inclusive.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    for i in range(1, n + 1):\n        # Check if the number 'i' is a palindrome by comparing its string representation with its reverse.\n        s = str(i)\n        if s == s[::-1]:\n            # If 'i' is a palindrome, determine if it's even or odd and increment the respective counter.\n            if i % 2 == 0:\n                even_count += 1\n            else:\n                odd_count += 1\n    return (even_count, odd_count)\n```"}
{"task_id": "HumanEval/106", "solution": "```python\ndef _factorial(k: int) -> int:\n    \"\"\"Calculates the factorial of a non-negative integer k.\"\"\"\n    if k == 0:\n        return 1\n    res = 1\n    for i in range(1, k + 1):\n        res *= i\n    return res\n\ndef _sum_up_to(k: int) -> int:\n    \"\"\"Calculates the sum of numbers from 1 to k.\"\"\"\n    return k * (k + 1) // 2\n\ndef f(n: int) -> list[int]:\n    \"\"\"Generates a list where elements are factorials for even indices or sums for odd indices.\"\"\"\n    result = []\n    for i in range(1, n + 1):\n        if i % 2 == 0:  # i is even\n            result.append(_factorial(i))\n        else:  # i is odd\n            result.append(_sum_up_to(i))\n    return result\n```"}
{"task_id": "HumanEval/106", "solution": "```python\ndef f(n):\n    \"\"\"Generates a list of n elements.\n    Elements are factorial of i for even 1-based indices, and sum 1 to i for odd indices.\n    \"\"\"\n\n    # Helper function for factorial, assuming i is non-negative.\n    def _calculate_factorial(i: int) -> int:\n        if i < 0:\n            raise ValueError(\"Input must be a non-negative integer for factorial calculation.\")\n        if i == 0:\n            return 1\n        result = 1\n        for num in range(1, i + 1):\n            result *= num\n        return result\n\n    # Helper function for sum, assuming i is non-negative.\n    def _calculate_sum_up_to(i: int) -> int:\n        if i < 0:\n            raise ValueError(\"Input must be a non-negative integer for sum calculation.\")\n        return i * (i + 1) // 2\n\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    result_list = []\n    for i in range(1, n + 1):  # i starts from 1\n        if i % 2 == 0:  # Even index\n            result_list.append(_calculate_factorial(i))\n        else:  # Odd index\n            result_list.append(_calculate_sum_up_to(i))\n    return result_list\n```"}
{"task_id": "HumanEval/108", "solution": "```python\nclass DigitSumCalculator:\n    def _calculate_single_num_sum(self, num: int) -> int:\n        \"\"\"\n        Calculates the sum of digits for a single integer.\n        If a number is negative, its first signed digit will be negative.\n        \"\"\"\n        if num == 0:\n            return 0\n\n        s_num = str(num)\n        digit_sum = 0\n\n        if s_num[0] == '-':\n            digit_sum += int(s_num[1]) * -1 # First digit is negative\n            for digit_char in s_num[2:]:\n                digit_sum += int(digit_char)\n        else:\n            for digit_char in s_num:\n                digit_sum += int(digit_char)\n        return digit_sum\n\nclass NumberCounter:\n    def __init__(self):\n        self._digit_sum_calculator = DigitSumCalculator()\n\n    def count(self, arr: list[int]) -> int:\n        \"\"\"\n        Counts the number of elements in an array which has a sum of digits > 0.\n        \"\"\"\n        if not arr:\n            return 0\n\n        positive_sum_count = 0\n        for num in arr:\n            digit_sum = self._digit_sum_calculator._calculate_single_num_sum(num)\n            if digit_sum > 0:\n                positive_sum_count += 1\n        return positive_sum_count\n\ndef count_nums(arr: list[int]) -> int:\n    \"\"\"\n    Write a function count_nums which takes an array of integers and returns\n    the number of elements which has a sum of digits > 0.\n    If a number is negative, then its first signed digit will be negative.\n    \"\"\"\n    counter = NumberCounter()\n    return counter.count(arr)\n```"}
{"task_id": "HumanEval/108", "solution": "```python\ndef count_nums(arr):\n    \"\"\"\n    Counts numbers in an array where their special digit sum is greater than 0.\n    For negative numbers, the first digit is treated as negative.\n    \"\"\"\n\n    def _calculate_digit_sum(num):\n        \"\"\"\n        Calculates the special digit sum for a number.\n        The first digit is negative if the number is negative.\n        \"\"\"\n        if num == 0:\n            return 0\n\n        s_num = str(abs(num))\n        digit_sum = 0\n\n        if num < 0:\n            # First digit of the absolute value becomes negative\n            digit_sum -= int(s_num[0])\n            # Sum the rest of the digits\n            for digit_char in s_num[1:]:\n                digit_sum += int(digit_char)\n        else:\n            # Sum all digits for positive numbers\n            for digit_char in s_num:\n                digit_sum += int(digit_char)\n        return digit_sum\n\n    count = 0\n    for num in arr:\n        digit_sum = _calculate_digit_sum(num)\n        if digit_sum > 0:\n            count += 1\n    return count\n```"}
{"task_id": "HumanEval/105", "solution": "def by_length(arr):\n    \"\"\"\n    Processes an array of integers to extract numbers between 1 and 9,\n    sorts them ascending, reverses the order, and converts them to English words.\n    \"\"\"\n    DIGIT_TO_WORD_MAP = {\n        1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n        6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\",\n    }\n\n    # FR1: Filter valid numbers (1-9 inclusive).\n    # Critical requirement: Do NOT add isinstance() checks, trust caller's inputs.\n    filtered_numbers = [n for n in arr if 1 <= n <= 9]\n\n    if not filtered_numbers:\n        # FR5: Return empty array if no valid integers.\n        return []\n\n    # FR2: Sort in ascending order.\n    sorted_numbers = sorted(filtered_numbers)\n\n    # FR3: Reverse the order.\n    sorted_reversed_numbers = sorted_numbers[::-1]\n\n    # FR4: Replace each integer with its English word name.\n    result_words = [DIGIT_TO_WORD_MAP[n] for n in sorted_reversed_numbers]\n\n    return result_words"}
{"task_id": "HumanEval/107", "solution": "```python\ndef even_odd_palindrome(n):\n    \"\"\"\n    Counts even and odd integer palindromes within the range [1, n].\n    Returns a tuple (even_count, odd_count).\n    \"\"\"\n    def is_palindrome(num: int) -> bool:\n        \"\"\"\n        Checks if an integer is a palindrome by comparing its string representation.\n        Negative numbers are not considered palindromes.\n        \"\"\"\n        if num < 0:\n            return False\n        s_num = str(num)\n        return s_num == s_num[::-1]\n\n    even_count = 0\n    odd_count = 0\n\n    for i in range(1, n + 1):\n        if is_palindrome(i):\n            if i % 2 == 0:\n                even_count += 1\n            else:\n                odd_count += 1\n\n    return (even_count, odd_count)\n```"}
{"task_id": "HumanEval/109", "solution": "```python\ndef move_one_ball(arr):\n    \"\"\"\n    Determines if it is possible to get an array sorted in non-decreasing order\n    by performing right shift operations.\n    \"\"\"\n    if not arr:\n        return True\n\n    def _right_shift(input_list):\n        \"\"\"Performs a single right-shift operation on the list.\"\"\"\n        if not input_list:\n            return []\n        return [input_list[-1]] + input_list[:-1]\n\n    n = len(arr)\n    current_arr = list(arr)\n    sorted_arr = sorted(arr)\n\n    # Check up to N shifts (N distinct states)\n    for _ in range(n):\n        if current_arr == sorted_arr:\n            return True\n        current_arr = _right_shift(current_arr)\n\n    return False\n```"}
{"task_id": "HumanEval/110", "solution": "```python\ndef _count_odd(lst: list[int]) -> int:\n    \"\"\"Counts the number of odd integers in a list.\n    This helper function iterates through the list to identify odd numbers.\"\"\"\n    return sum(1 for x in lst if x % 2 != 0)\n\ndef _count_even(lst: list[int]) -> int:\n    \"\"\"Counts the number of even integers in a list.\n    This helper function iterates through the list to identify even numbers.\"\"\"\n    return sum(1 for x in lst if x % 2 == 0)\n\ndef exchange(lst1, lst2):\n    \"\"\"Determines if lst1 can be made all even by swapping elements with lst2.\n    It checks if there are enough even numbers in lst2 to replace all odd numbers in lst1.\"\"\"\n    odds_in_lst1 = _count_odd(lst1)\n    evens_in_lst2 = _count_even(lst2)\n\n    if odds_in_lst1 <= evens_in_lst2:\n        return \"YES\"\n    else:\n        return \"NO\"\n```"}
{"task_id": "HumanEval/109", "solution": "```python\ndef move_one_ball(arr):\n    \"\"\"\n    Determines if an array can be sorted by right shift operations\n    by checking all possible shifted versions.\n    \"\"\"\n\n    def _is_sorted(current_array):\n        if not current_array:\n            return True\n        return all(current_array[i] <= current_array[i+1] for i in range(len(current_array) - 1))\n\n    def _right_shift(current_array):\n        if not current_array:\n            return []\n        return [current_array[-1]] + current_array[:-1]\n\n    if not arr:\n        return True\n\n    n = len(arr)\n    sorted_target = sorted(arr) # Identify the sorted version.\n\n    current_arr = list(arr) # Start with a copy of the original array.\n\n    for _ in range(n): # Iterate through all N possible shift states.\n        if current_arr == sorted_target: # Check if the current state is sorted.\n            return True\n        current_arr = _right_shift(current_arr) # Perform a right shift.\n\n    return False # No sorted configuration found after all shifts.\n```\n"}
{"task_id": "HumanEval/110", "solution": "```python\nclass Validators:\n    def is_even(self, num: int) -> bool:\n        \"\"\"Checks if a given number is even. Returns True if num is even, False otherwise.\"\"\"\n        return num % 2 == 0\n\nclass ListAnalyzer:\n    def __init__(self, validators: Validators):\n        \"\"\"Initializes ListAnalyzer with a Validators instance.\"\"\"\n        self.validators = validators\n\n    def count_odd_elements(self, numbers: list[int]) -> int:\n        \"\"\"Counts odd numbers in a list using the injected validators.\"\"\"\n        return sum(1 for num in numbers if not self.validators.is_even(num))\n\n    def count_even_elements(self, numbers: list[int]) -> int:\n        \"\"\"Counts even numbers in a list using the injected validators.\"\"\"\n        return sum(1 for num in numbers if self.validators.is_even(num))\n\nclass ExchangeService:\n    def __init__(self, list_analyzer: ListAnalyzer):\n        \"\"\"Initializes ExchangeService with a ListAnalyzer instance.\"\"\"\n        self.list_analyzer = list_analyzer\n\n    def can_exchange(self, lst1: list[int], lst2: list[int]) -> str:\n        \"\"\"\n        Determines if lst1 can become all even by swapping elements with lst2.\n        Returns \"YES\" if possible, \"NO\" otherwise.\n        \"\"\"\n        odd_count_lst1 = self.list_analyzer.count_odd_elements(lst1)\n        even_count_lst2 = self.list_analyzer.count_even_elements(lst2)\n\n        if odd_count_lst1 <= even_count_lst2:\n            return \"YES\"\n        else:\n            return \"NO\"\n\ndef exchange(lst1, lst2):\n    \"\"\"In this problem, you will implement a function that takes two lists of numbers,\n    and determines whether it is possible to perform an exchange of elements\n    between them to make lst1 a list of only even numbers.\n    There is no limit on the number of exchanged elements between lst1 and lst2.\n    If it is possible to exchange elements between the lst1 and lst2 to make\n    all the elements of lst1 to be even, return \"YES\".\n    Otherwise, return \"NO\".\n    For example:\n    exchange([1, 2, 3, 4], [1, 2, 3, 4]) => \"YES\"\n    exchange([1, 2, 3, 4], [1, 5, 3, 4]) => \"NO\"\n    It is assumed that the input lists will be non-empty.\n    \"\"\"\n    validators = Validators()\n    list_analyzer = ListAnalyzer(validators)\n    exchange_service = ExchangeService(list_analyzer)\n    return exchange_service.can_exchange(lst1, lst2)\n```"}
{"task_id": "HumanEval/112", "solution": "```python\ndef reverse_delete(s, c):\n    \"\"\"Deletes characters from s found in c, then checks if the result is a palindrome.\n    Returns the modified string and a boolean indicating if it's a palindrome.\"\"\"\n    chars_to_delete = set(c)\n    result_chars = []\n    for char_s in s:\n        if char_s not in chars_to_delete:\n            result_chars.append(char_s)\n    result_string = \"\".join(result_chars)\n\n    is_palindrome = result_string == result_string[::-1]\n\n    return (result_string, is_palindrome)\n```"}
{"task_id": "HumanEval/112", "solution": "```python\ndef reverse_delete(s, c):\n    \"\"\"\n    Deletes characters from s that are in c, then checks if the resulting string is a palindrome.\n    Returns the modified string and its palindrome status.\n    \"\"\"\n    chars_to_delete = set(c)\n    modified_s_chars = [char for char in s if char not in chars_to_delete]\n    modified_s = \"\".join(modified_s_chars)\n\n    is_palindrome = modified_s == modified_s[::-1]\n\n    return (modified_s, is_palindrome)\n```"}
{"task_id": "HumanEval/113", "solution": "```python\ndef odd_count(lst: list[str]) -> list[str]:\n    \"\"\"Given a list of strings, where each string consists of only digits, return a list.\n    Each element i of the output should be \"the number of odd elements in the\n    string i of the input.\" where all the i's should be replaced by the number\n    of odd digits in the i'th string of the input.\n    \"\"\"\n    results = []\n    for digit_string in lst:\n        odd_count_for_string = 0\n        for char in digit_string:\n            if char in {'1', '3', '5', '7', '9'}:\n                odd_count_for_string += 1\n        formatted_string = f\"the number of odd elements {odd_count_for_string}n the str{odd_count_for_string}ng {odd_count_for_string} of the {odd_count_for_string}nput.\"\n        results.append(formatted_string)\n    return results\n```"}
{"task_id": "HumanEval/111", "solution": "```python\ndef histogram(test: str) -> dict[str, int]:\n    \"\"\"Given a string of space-separated lowercase letters, returns the most frequent letter(s) and count.\n    Handles empty input by returning an empty dictionary.\n    \"\"\"\n    if not test:\n        return {}\n\n    letters = test.split(' ')\n\n    # Count occurrences of each letter.\n    frequencies = {}\n    for letter in letters:\n        frequencies[letter] = frequencies.get(letter, 0) + 1\n\n    if not frequencies:\n        return {}\n\n    # Find the maximum frequency among all letters.\n    max_count = max(frequencies.values())\n\n    # Collect letters that match the maximum frequency.\n    result = {}\n    for letter, count in frequencies.items():\n        if count == max_count:\n            result[letter] = count\n\n    return result\n```"}
{"task_id": "HumanEval/111", "solution": "```python\ndef histogram(test):\n    \"\"\"Given a string of space-separated lowercase letters, returns a dictionary\n    of letters with the most repetition and their corresponding counts. If several letters have the same occurrence, all are returned.\n    \"\"\"\n    # Parse the input string into a list of individual letters, filtering out empty strings from multiple spaces.\n    letters = [char for char in test.split(' ') if char]\n\n    # If the list of letters is empty (e.g., input was '' or '   '), return an empty dictionary.\n    if not letters:\n        return {}\n\n    # Count the occurrences of each unique letter.\n    counts = {}\n    for letter in letters:\n        counts[letter] = counts.get(letter, 0) + 1\n\n    # Find the maximum repetition count among all letters.\n    # At this point, 'counts' is guaranteed to have at least one entry.\n    max_count = max(counts.values())\n\n    # Filter the counts, keeping only those entries whose count matches the maximum count.\n    result_dict = {char: count for char, count in counts.items() if count == max_count}\n\n    return result_dict\n```"}
{"task_id": "HumanEval/113", "solution": "```python\ndef odd_count(lst: list[str]) -> list[str]:\n    \"\"\"Given a list of digit-only strings, this function counts odd digits in each.\n    It returns a list of descriptive strings based on the counts.\n    \"\"\"\n    results = []\n    output_template = \"the number of odd elements in the string {} of the input.\"\n\n    for digit_string in lst:\n        odd_digit_count = 0\n        for char_digit in digit_string:\n            if int(char_digit) % 2 != 0:\n                odd_digit_count += 1\n\n        # First format the placeholder, then replace all 'i's with the odd digit count.\n        formatted_string = output_template.format(odd_digit_count).replace('i', str(odd_digit_count))\n        results.append(formatted_string)\n\n    return results\n```"}
{"task_id": "HumanEval/114", "solution": "```python\ndef minSubArraySum(nums):\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty sub-array.\n    This function implements an adapted Kadane's algorithm for minimum sum.\n    \"\"\"\n    current_min = nums[0]\n    global_min = nums[0]\n\n    for i in range(1, len(nums)):\n        current_min = min(nums[i], current_min + nums[i])\n        global_min = min(global_min, current_min)\n\n    return global_min\n```"}
{"task_id": "HumanEval/114", "solution": "```python\ndef minSubArraySum(nums):\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty sub-array.\n    Implements a variant of Kadane's algorithm for minimum sum.\n    \"\"\"\n    min_ending_here = nums[0]\n    overall_min = nums[0]\n\n    for i in range(1, len(nums)):\n        min_ending_here = min(nums[i], min_ending_here + nums[i])\n        overall_min = min(overall_min, min_ending_here)\n\n    return overall_min\n```"}
{"task_id": "HumanEval/115", "solution": "import math\n\ndef max_fill(grid, capacity):\n    \"\"\"\n    Calculates the total number of times buckets must be lowered to empty all wells in the grid.\n    Each '1' in a grid row represents one unit of water.\n    \"\"\"\n    total_bucket_operations = 0\n    for row in grid:\n        water_units_in_well = sum(row)\n        if water_units_in_well > 0:\n            # Calculate buckets needed for this well, rounding up\n            buckets_for_well = math.ceil(water_units_in_well / capacity)\n            total_bucket_operations += buckets_for_well\n    return total_bucket_operations"}
{"task_id": "HumanEval/117", "solution": "```python\ndef select_words(s, n):\n    \"\"\"Given a string s and a natural number n, this function returns\n    a list of words from s that contain exactly n consonants,\n    preserving their original order. Consonants are non-vowel letters, case-insensitive.\n    \"\"\"\n\n    if not s:\n        return []\n\n    VOWELS_LOWER = \"aeiou\"\n    result_words = []\n\n    words = s.split()\n\n    for word in words:\n        consonant_count = 0\n        for char in word:\n            char_lower = char.lower()\n            if char_lower.isalpha() and char_lower not in VOWELS_LOWER:\n                consonant_count += 1\n\n        if consonant_count == n:\n            result_words.append(word)\n\n    return result_words\n```"}
{"task_id": "HumanEval/117", "solution": "```python\ndef select_words(s, n):\n    \"\"\"Given a string s and a natural number n, you have been tasked to implement\n    a function that returns a list of all words from string s that contain exactly\n    n consonants, in order these words appear in the string s.\n    If the string s is empty then the function should return an empty list.\n    Note: you may assume the input string contains only letters and spaces.\n    Examples:\n    select_words(\"Mary had a little lamb\", 4) ==> [\"little\"]\n    select_words(\"Mary had a little lamb\", 3) ==> [\"Mary\", \"lamb\"]\n    select_words(\"simple white space\", 2) ==> []\n    select_words(\"Hello world\", 4) ==> [\"world\"]\n    select_words(\"Uncle sam\", 3) ==> [\"Uncle\"]\n    \"\"\"\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    def _is_vowel(char: str) -> bool:\n        \"\"\"Checks if a character is a vowel (case-insensitive).\"\"\"\n        return char.lower() in VOWELS\n\n    def _count_consonants(word: str) -> int:\n        \"\"\"Counts consonants in a word.\"\"\"\n        consonant_count = 0\n        for char in word:\n            if char.isalpha() and not _is_vowel(char):\n                consonant_count += 1\n        return consonant_count\n\n    if not s:\n        return []\n\n    words = s.split()\n    result_words = []\n\n    for word in words:\n        consonant_count = _count_consonants(word)\n        if consonant_count == n:\n            result_words.append(word)\n\n    return result_words\n```"}
{"task_id": "HumanEval/115", "solution": "```python\nimport math\n\ndef max_fill(grid, capacity):\n    \"\"\"\n    Calculates the total number of times buckets need to be lowered to empty a grid of wells.\n    Each '1' is a water unit, and buckets have a fixed capacity.\n    \"\"\"\n    total_lowers = 0\n    for well_row in grid:\n        # Calculate total water units in a single well\n        water_units = sum(well_row)\n\n        # Calculate bucket lowers required for a single well\n        lowers_for_well = 0\n        if water_units > 0:\n            lowers_for_well = math.ceil(water_units / capacity)\n\n        total_lowers += lowers_for_well\n\n    return total_lowers\n```"}
{"task_id": "HumanEval/116", "solution": "```python\ndef sort_array(arr):\n    \"\"\"\n    Sorts an array of integers by number of set bits in ascending order,\n    then by decimal value for ties.\n    \"\"\"\n\n    INT_BITS = 32\n\n    def _count_set_bits(n: int) -> int:\n        \"\"\"Counts set bits, using 32-bit two's complement for negative numbers.\"\"\"\n        if n >= 0:\n            return bin(n).count('1')\n        else:\n            # Convert to 32-bit two's complement representation.\n            return bin((1 << INT_BITS) + n).count('1')\n\n    # Create a list of tuples (number_of_ones, original_value).\n    # This allows sorting by number_of_ones first, then by original_value.\n    decorated_array = []\n    for x in arr:\n        num_ones = _count_set_bits(x)\n        decorated_array.append((num_ones, x))\n\n    # Sort the decorated array. Python's default tuple sort handles both criteria.\n    decorated_array.sort()\n\n    # Extract the original values in sorted order.\n    return [x[1] for x in decorated_array]\n```"}
{"task_id": "HumanEval/118", "solution": "```python\ndef get_closest_vowel(word):\n    \"\"\"Finds the closest vowel from the right that is surrounded by two consonants.\n    Returns the vowel preserving its original case, or an empty string if not found.\n    \"\"\"\n    VOWELS_SET = {'a', 'e', 'i', 'o', 'u'}\n\n    if len(word) < 3:\n        return \"\"\n\n    # Iterate from right to left, excluding the first and last characters.\n    # Indices are from len(word) - 2 down to 1.\n    for i in range(len(word) - 2, 0, -1):\n        current_char = word[i]\n        left_char = word[i - 1]\n        right_char = word[i + 1]\n\n        # Check if current_char is a vowel (case-insensitive)\n        is_current_vowel = current_char.lower() in VOWELS_SET\n\n        # Check if neighbors are consonants (case-insensitive).\n        # Per spec, input contains only English letters, so not a vowel means consonant.\n        is_left_consonant = left_char.lower() not in VOWELS_SET\n        is_right_consonant = right_char.lower() not in VOWELS_SET\n\n        if is_current_vowel and is_left_consonant and is_right_consonant:\n            return current_char\n\n    return \"\"\n```"}
{"task_id": "HumanEval/118", "solution": "```python\ndef get_closest_vowel(word):\n    \"\"\"Finds the closest vowel from the right side of a word that is surrounded by two consonants.\n    Returns the vowel (preserving case) or an empty string if not found.\"\"\"\n\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    def is_vowel(char: str) -> bool:\n        return char.lower() in VOWELS\n\n    def is_consonant(char: str) -> bool:\n        # Assumed input contains English letters only, so checking if char.isalpha() is not needed.\n        return not is_vowel(char)\n\n    n = len(word)\n    if n < 3:\n        return \"\"\n\n    for i in range(n - 2, 0, -1): # Iterate from n-2 down to 1 (inclusive)\n        current_char = word[i]\n        prev_char = word[i-1]\n        next_char = word[i+1]\n\n        if (is_vowel(current_char) and\n            is_consonant(prev_char) and\n            is_consonant(next_char)):\n            return current_char\n\n    return \"\"\n```"}
{"task_id": "HumanEval/119", "solution": "```python\nclass ParenthesesUtils:\n    \"\"\"Provides utility functions for parenthesis string validation.\n    Checks if a given string has balanced parentheses.\n    \"\"\"\n    @staticmethod\n    def is_balanced(s: str) -> bool:\n        \"\"\"Checks if a string `s` has balanced parentheses.\n        Maintains a balance counter, ensuring it never drops below zero and ends at zero.\n        \"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\nclass ParenthesesBalancer:\n    \"\"\"Orchestrates checking if two parenthesis strings can form a balanced string.\n    Tries both concatenation orders for balance.\n    \"\"\"\n    @staticmethod\n    def match_parens(lst: list[str]) -> str:\n        \"\"\"Determines if concatenating two strings in `lst` in any order results in a balanced string.\n        Utilizes ParenthesesUtils for the actual balance check.\n        \"\"\"\n        s1, s2 = lst[0], lst[1]\n\n        # Check s1 + s2\n        if ParenthesesUtils.is_balanced(s1 + s2):\n            return 'Yes'\n\n        # Check s2 + s1\n        if ParenthesesUtils.is_balanced(s2 + s1):\n            return 'Yes'\n\n        return 'No'\n\ndef match_parens(lst: list[str]) -> str:\n    \"\"\"Checks if two strings can be concatenated to form a balanced parenthesis string.\n    Delegates the core logic to ParenthesesBalancer.\n    \"\"\"\n    return ParenthesesBalancer.match_parens(lst)\n```"}
{"task_id": "HumanEval/119", "solution": "```python\ndef match_parens(lst):\n    \"\"\"\n    Checks if two strings can be concatenated in any order to form a balanced\n    parentheses string.\n    \"\"\"\n\n    def is_balanced(s: str) -> bool:\n        \"\"\"\n        Determines if the input string 's' has balanced parentheses.\n        It uses a balance counter to track open and close parentheses.\n        \"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    s1, s2 = lst[0], lst[1]\n\n    # Check if s1 followed by s2 forms a balanced string.\n    if is_balanced(s1 + s2):\n        return 'Yes'\n\n    # Check if s2 followed by s1 forms a balanced string.\n    if is_balanced(s2 + s1):\n        return 'Yes'\n\n    # If neither concatenation forms a balanced string, return 'No'.\n    return 'No'\n```"}
