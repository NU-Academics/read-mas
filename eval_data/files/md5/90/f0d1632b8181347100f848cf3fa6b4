{"task_id": "HumanEval/160", "solution": "```python\ndef do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand, build and evaluate an algebraic expression.\n    The evaluation respects standard mathematical operator precedence.\n    \"\"\"\n    expression_parts = []\n    for i in range(len(operator)):\n        expression_parts.append(str(operand[i]))\n        expression_parts.append(operator[i])\n    expression_parts.append(str(operand[-1]))\n\n    expression_string = \" \".join(expression_parts)\n\n    result = eval(expression_string)\n    return int(result)\n```"}
{"task_id": "HumanEval/163", "solution": "```python\ndef generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return all even integers between them (inclusive) in ascending order.\n    Returns an empty list if no even integers are found.\n    \"\"\"\n    start = min(a, b)\n    end = max(a, b)\n\n    even_numbers = []\n    for num in range(start, end + 1):\n        if num % 2 == 0:\n            even_numbers.append(num)\n\n    return even_numbers\n```"}
{"task_id": "HumanEval/160", "solution": "```python\nimport operator\nfrom typing import List, Any, Callable, Dict\n\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to the do_algebra function.\"\"\"\n    def __init__(self, message=\"Invalid input provided for algebraic evaluation.\"):\n        self.message = message\n        super().__init__(self.message)\n\nclass InputValidator:\n    SUPPORTED_OPERATORS = {'+', '-', '*', '//', '**'}\n\n    @staticmethod\n    def validate_inputs(operators: List[str], operands: List[int]) -> None:\n        if not isinstance(operators, list) or not isinstance(operands, list):\n            raise InvalidInputError(\"Inputs must be lists.\")\n\n        if not operators:\n            raise InvalidInputError(\"Operator list cannot be empty.\")\n        if len(operands) < 2:\n            raise InvalidInputError(\"Operand list must contain at least two operands.\")\n\n        if len(operators) != len(operands) - 1:\n            raise InvalidInputError(\n                f\"Length of operators ({len(operators)}) must be one less than length of operands ({len(operands)}).\"\n            )\n\n        for op in operators:\n            if not InputValidator._is_valid_operator(op):\n                raise InvalidInputError(f\"Unsupported operator found: '{op}'.\")\n\n        for num in operands:\n            if not InputValidator._is_non_negative_integer(num):\n                raise InvalidInputError(f\"Operand '{num}' is not a non-negative integer.\")\n\n    @staticmethod\n    def _is_valid_operator(op: str) -> bool:\n        return op in InputValidator.SUPPORTED_OPERATORS\n\n    @staticmethod\n    def _is_non_negative_integer(num: Any) -> bool:\n        return isinstance(num, int) and num >= 0\n\nclass AlgebraEvaluator:\n    OPERATOR_PRECEDENCE: Dict[str, int] = {\n        '+': 1, '-': 1,\n        '*': 2, '//': 2,\n        '**': 3\n    }\n\n    BINARY_OPERATIONS: Dict[str, Callable[[int, int], int]] = {\n        '+': operator.add,\n        '-': operator.sub,\n        '*': operator.mul,\n        '//': operator.floordiv,\n        '**': operator.pow\n    }\n\n    @staticmethod\n    def evaluate(operators: List[str], operands: List[int]) -> int:\n        output_queue = []\n        operator_stack = []\n\n        operand_idx = 0\n        for i in range(len(operators)):\n            output_queue.append(operands[operand_idx])\n            operand_idx += 1\n            current_op = operators[i]\n\n            while (operator_stack and\n                   AlgebraEvaluator.OPERATOR_PRECEDENCE.get(current_op, 0) <=\n                   AlgebraEvaluator.OPERATOR_PRECEDENCE.get(operator_stack[-1], 0)):\n                output_queue.append(operator_stack.pop())\n            operator_stack.append(current_op)\n\n        output_queue.append(operands[operand_idx]) # Add the last operand\n\n        while operator_stack:\n            output_queue.append(operator_stack.pop())\n\n        # Evaluate the RPN (Reverse Polish Notation) expression\n        evaluation_stack = []\n        for token in output_queue:\n            if isinstance(token, int):\n                evaluation_stack.append(token)\n            else: # It's an operator\n                if len(evaluation_stack) < 2:\n                    raise InvalidInputError(\"Malformed expression: not enough operands for operator.\")\n                val2 = evaluation_stack.pop()\n                val1 = evaluation_stack.pop()\n                result = AlgebraEvaluator._apply_operator(token, val1, val2)\n                evaluation_stack.append(result)\n\n        if len(evaluation_stack) != 1:\n            raise InvalidInputError(\"Malformed expression: too many operands or operators.\")\n\n        return evaluation_stack[0]\n\n    @staticmethod\n    def _apply_operator(op: str, val1: int, val2: int) -> int:\n        try:\n            return AlgebraEvaluator.BINARY_OPERATIONS[op](val1, val2)\n        except ZeroDivisionError:\n            raise InvalidInputError(\"Division by zero encountered.\")\n        except Exception as e:\n            raise InvalidInputError(f\"Error applying operator '{op}': {e}\")\n\ndef do_algebra(operator: List[str], operand: List[int]) -> int:\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and\n    the second list is a list of integers. Use the two given lists to build the algebric\n    expression and return the evaluation of this expression.\n\n    The basic algebra operations:\n    Addition ( + )\n    Subtraction ( - )\n    Multiplication ( * )\n    Floor division ( // )\n    Exponentiation ( ** )\n\n    Example:\n    operator['+', '*', '-']\n    array = [2, 3, 4, 5]\n    result = 2 + 3 * 4 - 5\n    => result = 9\n\n    Note:\n        The length of operator list is equal to the length of operand list minus one.\n        Operand is a list of of non-negative integers.\n        Operator list has at least one operator, and operand list has at least two operands.\n    \"\"\"\n    try:\n        InputValidator.validate_inputs(operator, operand)\n        result = AlgebraEvaluator.evaluate(operator, operand)\n        return result\n    except InvalidInputError as e:\n        # Re-raise the specific error for the client\n        raise e\n    except Exception as e:\n        # Catch any unexpected errors and wrap them\n        raise InvalidInputError(f\"An unexpected error occurred during evaluation: {e}\")\n```"}
