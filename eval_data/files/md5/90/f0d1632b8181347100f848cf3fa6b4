{"task_id": "HumanEval/116", "solution": "def sort_array(arr):\n    \"\"\"\n    Sorts an array of integers by the number of set bits in their binary representation.\n    For equal bit counts, elements are sorted by their decimal value.\n    \"\"\"\n\n    def _count_set_bits(n: int) -> int:\n        \"\"\"Counts set bits, using 32-bit two's complement for negative numbers.\"\"\"\n        if n < 0:\n            n = (n + (1 << 32)) % (1 << 32)\n        count = 0\n        while n > 0:\n            n &= (n - 1)\n            count += 1\n        return count\n\n    return sorted(arr, key=lambda x: (_count_set_bits(x), x))"}
{"task_id": "HumanEval/120", "solution": "```python\ndef maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list\n    of length k with the maximum k numbers in arr.\n\n    Example 1:\n\n        Input: arr = [-3, -4, 5], k = 3\n        Output: [-4, -3, 5]\n\n    Example 2:\n\n        Input: arr = [4, -4, 4], k = 2\n        Output: [4, 4]\n\n    Example 3:\n\n        Input: arr = [-3, 2, 1, 2, -1, -2, 1], k = 1\n        Output: [2]\n\n    Note:\n        1. The length of the array will be in the range of [1, 1000].\n        2. The elements in the array will be in the range of [-1000, 1000].\n        3. 0 <= k <= len(arr)\n    \"\"\"\n    if k == 0:\n        return []\n\n    # Sort the array in descending order to easily pick the largest k elements.\n    arr.sort(reverse=True)\n\n    # Take the first k elements and sort them in ascending order as required.\n    max_k_elements = arr[:k]\n    max_k_elements.sort()\n\n    return max_k_elements\n```"}
{"task_id": "HumanEval/122", "solution": "```python\ndef add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of elements with at most two digits from the first k elements of arr.\n    \"\"\"\n    sum_of_elements = 0\n    for i in range(k):\n        element = arr[i]\n        # Check if the absolute value of the element is less than 100 (i.e., at most two digits).\n        if abs(element) < 100:\n            sum_of_elements += element\n    return sum_of_elements\n```"}
{"task_id": "HumanEval/120", "solution": "def maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list\n    of length k with the maximum k numbers in arr.\n\n    Example 1:\n\n        Input: arr = [-3, -4, 5], k = 3\n        Output: [-4, -3, 5]\n\n    Example 2:\n\n        Input: arr = [4, -4, 4], k = 2\n        Output: [4, 4]\n\n    Example 3:\n\n        Input: arr = [-3, 2, 1, 2, -1, -2, 1], k = 1\n        Output: [2]\n\n    Note:\n        1. The length of the array will be in the range of [1, 1000].\n        2. The elements in the array will be in the range of [-1000, 1000].\n        3. 0 <= k <= len(arr)\n    \"\"\"\n    arr.sort()\n    return arr[len(arr) - k:]"}
{"task_id": "HumanEval/122", "solution": "```python\ndef add_elements(arr, k):\n    \"\"\"\n    Calculates the sum of elements with at most two digits from the first k elements of arr.\n    An element qualifies if its absolute value is less than 100.\n    \"\"\"\n    total_sum = 0\n    # Iterate through the first k elements as specified by the constraints.\n    for i in range(k):\n        element = arr[i]\n        # Add element to sum if its absolute value has at most two digits.\n        if -99 <= element <= 99:\n            total_sum += element\n    return total_sum\n```"}
{"task_id": "HumanEval/123", "solution": "```python\ndef get_odd_collatz(n: int) -> list[int]:\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in its Collatz sequence.\n    The returned list contains unique odd numbers in increasing order.\n    \"\"\"\n\n    # Handle the base case where n is 1, as per FR5.\n    if n == 1:\n        return [1]\n\n    # Generate the Collatz sequence starting from n, as per FR2 and BR1/BR2/BR3.\n    sequence = [n]\n    current = n\n    while current != 1:\n        if current % 2 == 0:\n            current //= 2\n        else:\n            current = 3 * current + 1\n        sequence.append(current)\n\n    # Identify all odd numbers within the generated sequence, as per FR3.\n    # Using a set to efficiently store unique odd numbers.\n    odd_numbers = {num for num in sequence if num % 2 != 0}\n\n    # Return a sorted list of these unique odd numbers in increasing order, as per FR4 and BR4.\n    return sorted(list(odd_numbers))\n```"}
{"task_id": "HumanEval/125", "solution": "```python\nimport re\n\ndef split_words(txt: str) -> list[str] | int:\n    \"\"\"\n    Splits text by whitespace, then by commas if no whitespace,\n    otherwise counts odd-ordered lowercase letters.\n    \"\"\"\n    if re.search(r'\\s', txt):\n        return txt.split()\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        count = 0\n        for char in txt:\n            if 'a' <= char <= 'z':\n                order = ord(char) - ord('a')\n                if order % 2 != 0:\n                    count += 1\n        return count\n\n```"}
{"task_id": "HumanEval/124", "solution": "def valid_date(date):\n    \"\"\"Validates a date string against rules: not empty, mm-dd-yyyy format, valid month, valid day.\"\"\"\n\n    # 1. The date string is not empty.\n    if not date:\n        return False\n\n    # 4. The date should be in the format: mm-dd-yyyy\n    parts = date.split('-')\n    if len(parts) != 3:\n        return False\n\n    month_str, day_str, year_str = parts\n\n    # Check for correct length of components to ensure mm-dd-yyyy format strictly\n    if not (len(month_str) == 2 and len(day_str) == 2 and len(year_str) == 4):\n        return False\n\n    try:\n        month = int(month_str)\n        day = int(day_str)\n        year = int(year_str) # Year component needs no specific range validation as per spec\n    except ValueError:\n        # Non-numeric parts are considered invalid format\n        return False\n\n    # 3. The months should not be less than 1 or higher than 12.\n    if not (1 <= month <= 12):\n        return False\n\n    # 2. Day validation based on month\n    # February max 29 days, no leap year logic as per spec \"not less than 1 or higher than 29 for the month 2\".\n    days_in_month = {\n        1: 31, 3: 31, 5: 31, 7: 31, 8: 31, 10: 31, 12: 31, # 31-day months\n        4: 30, 6: 30, 9: 30, 11: 30,                       # 30-day months\n        2: 29                                             # February\n    }\n\n    if not (1 <= day <= days_in_month.get(month, 0)):\n        return False\n\n    return True"}
{"task_id": "HumanEval/123", "solution": "```python\ndef get_odd_collatz(n: int) -> list[int]:\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in Collatz sequence.\n    The list contains unique odd numbers encountered in the sequence.\n    \"\"\"\n\n    sequence = [n]\n    current_term = n\n\n    # Generate the Collatz sequence\n    while current_term != 1:\n        if current_term % 2 == 0:\n            current_term //= 2\n        else:\n            current_term = (3 * current_term) + 1\n        sequence.append(current_term)\n\n    # Filter out odd numbers and ensure uniqueness\n    odd_numbers = set()\n    for num in sequence:\n        if num % 2 != 0:\n            odd_numbers.add(num)\n\n    # Sort the unique odd numbers\n    return sorted(list(odd_numbers))\n```"}
{"task_id": "HumanEval/126", "solution": "```python\ndef is_sorted(lst):\n    '''\n    Checks if a list is sorted in ascending order with at most one duplicate of any number.\n    Assumes input is a list of non-negative integers.\n    '''\n    if len(lst) <= 1:\n        return True\n\n    # Check for ascending order\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    # Manually count occurrences of each number\n    counts = {}\n    for num in lst:\n        counts[num] = counts.get(num, 0) + 1\n\n    # Check for more than one duplicate (i.e., count > 2)\n    for count in counts.values():\n        if count > 2:\n            return False\n\n    return True\n```"}
{"task_id": "HumanEval/126", "solution": "```python\ndef is_sorted(lst: list[int]) -> bool:\n    \"\"\"\n    Checks if a list is sorted in ascending order and adheres to a duplicate constraint.\n    Numbers can appear at most twice.\n    \"\"\"\n    if len(lst) <= 1:\n        return True\n\n    def _check_ascending_order(current_lst: list[int]) -> bool:\n        \"\"\"\n        Iterates and compares adjacent elements to ensure ascending order.\n        Returns False if any element is less than its preceding element.\n        \"\"\"\n        for i in range(len(current_lst) - 1):\n            if current_lst[i] > current_lst[i+1]:\n                return False\n        return True\n\n    def _count_occurrences(current_lst: list[int]) -> dict[int, int]:\n        \"\"\"\n        Counts the frequency of each element in the given list.\n        Returns a dictionary mapping elements to their counts.\n        \"\"\"\n        occurrences = {}\n        for x in current_lst:\n            occurrences[x] = occurrences.get(x, 0) + 1\n        return occurrences\n\n    def _check_duplicate_constraint(current_lst: list[int]) -> bool:\n        \"\"\"\n        Ensures no number appears more than twice by counting occurrences.\n        Returns False if any number's count is greater than 2.\n        \"\"\"\n        occurrences = _count_occurrences(current_lst)\n        for count in occurrences.values():\n            if count > 2:\n                return False\n        return True\n\n    if not _check_ascending_order(lst):\n        return False\n\n    if not _check_duplicate_constraint(lst):\n        return False\n\n    return True\n```"}
{"task_id": "HumanEval/124", "solution": "```python\nclass DateComponents:\n    \"\"\"\n    A simple data transfer object (DTO) to hold parsed date components.\n    \"\"\"\n    def __init__(self, month: int, day: int, year: int):\n        self.month = month\n        self.day = day\n        self.year = year\n\nMONTH_DAYS_MAP: dict[int, int] = {\n    1: 31, 3: 31, 5: 31, 7: 31, 8: 31, 10: 31, 12: 31,\n    4: 30, 6: 30, 9: 30, 11: 30,\n    2: 29  # Max 29 for February as per requirement\n}\n\nclass StringParser:\n    \"\"\"\n    Utility class for safe string parsing operations.\n    \"\"\"\n    @staticmethod\n    def parse_int(s: str) -> int | None:\n        \"\"\"\n        Attempts to convert a string to an integer, returning None on failure.\n        \"\"\"\n        try:\n            return int(s)\n        except ValueError:\n            return None\n\nclass DateValidator:\n    \"\"\"\n    Provides methods to validate a date string according to specific rules.\n    \"\"\"\n\n    @staticmethod\n    def _parse_date(date_string: str) -> DateComponents | None:\n        \"\"\"\n        Parses the date string in 'mm-dd-yyyy' format into DateComponents.\n        \"\"\"\n        parts = date_string.split('-')\n        if len(parts) != 3:\n            return None\n\n        month_str, day_str, year_str = parts\n\n        # Enforce strict 'mm-dd-yyyy' format by checking string lengths.\n        if not (len(month_str) == 2 and len(day_str) == 2 and len(year_str) == 4):\n            return None\n\n        month = StringParser.parse_int(month_str)\n        day = StringParser.parse_int(day_str)\n        year = StringParser.parse_int(year_str)\n\n        if month is None or day is None or year is None:\n            return None\n\n        return DateComponents(month, day, year)\n\n    @staticmethod\n    def _is_valid_month(month: int) -> bool:\n        \"\"\"\n        Validates if the month is between 1 and 12, inclusive.\n        \"\"\"\n        return 1 <= month <= 12\n\n    @staticmethod\n    def _is_valid_day(day: int, month: int) -> bool:\n        \"\"\"\n        Validates if the day is within the correct range for the given month.\n        \"\"\"\n        max_days = MONTH_DAYS_MAP.get(month)\n        if max_days is None:\n            return False\n        return 1 <= day <= max_days\n\ndef valid_date(date: str) -> bool:\n    \"\"\"\n    Validates a given date string according to specific rules.\n    Returns True if the date is valid, False otherwise.\n    \"\"\"\n    if not date:\n        return False\n\n    date_components = DateValidator._parse_date(date)\n    if date_components is None:\n        return False\n\n    if not DateValidator._is_valid_month(date_components.month):\n        return False\n\n    if not DateValidator._is_valid_day(date_components.day, date_components.month):\n        return False\n\n    return True\n```"}
