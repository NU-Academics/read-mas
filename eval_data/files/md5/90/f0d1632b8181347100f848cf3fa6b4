{"task_id": "HumanEval/147", "solution": "def _combinations(n_items: int, k_choose: int) -> int:\n    \"\"\"\n    Calculates n choose k (C(n_items, k_choose)).\n    Returns 0 if k_choose is out of range.\n    \"\"\"\n    if k_choose < 0 or k_choose > n_items:\n        return 0\n    if k_choose == 0 or k_choose == n_items:\n        return 1\n\n    res = 1\n    # Optimized for combinations C(n, k) = C(n, n-k)\n    if k_choose > n_items // 2:\n        k_choose = n_items - k_choose\n\n    for i in range(k_choose):\n        res = res * (n_items - i) // (i + 1)\n    return res\n\n\ndef get_max_triples(n: int) -> int:\n    \"\"\"\n    Counts triples (a[i], a[j], a[k]) from sequence a[x] = x*x - x + 1,\n    where i < j < k and their sum is a multiple of 3.\n    \"\"\"\n    if n < 3:\n        return 0\n\n    count_rem0 = 0  # Count of a[x] where a[x] % 3 == 0\n    count_rem1 = 0  # Count of a[x] where a[x] % 3 == 1\n\n    # a[x] = x*x - x + 1\n    # If x % 3 == 0: a[x] % 3 = (0 - 0 + 1) % 3 = 1\n    # If x % 3 == 1: a[x] % 3 = (1 - 1 + 1) % 3 = 1\n    # If x % 3 == 2: a[x] % 3 = (4 - 2 + 1) % 3 = 3 % 3 = 0\n\n    for i in range(1, n + 1):\n        if i % 3 == 2:\n            count_rem0 += 1\n        else:  # i % 3 == 0 or i % 3 == 1\n            count_rem1 += 1\n\n    # Triples sum to 0 (mod 3) if all elements have remainder 0 (mod 3)\n    # or all elements have remainder 1 (mod 3).\n    triples_from_rem0 = _combinations(count_rem0, 3)\n    triples_from_rem1 = _combinations(count_rem1, 3)\n\n    return triples_from_rem0 + triples_from_rem1"}
{"task_id": "HumanEval/150", "solution": "def _is_prime(num):\n    \"\"\"Checks if num is a prime number using an optimized trial division algorithm.\"\"\"\n    if num <= 1:\n        return False\n    if num <= 3:\n        return True\n    if num % 2 == 0 or num % 3 == 0:\n        return False\n    i = 5\n    while i * i <= num:\n        if num % i == 0 or num % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n\ndef x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is\n    a prime number and should return the value of y otherwise.\"\"\"\n    if _is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/150", "solution": "```python\ndef x_or_y(n, x, y):\n    \"\"\"\n    Returns x if n is a prime number, otherwise returns y.\n    It includes a nested helper function for primality testing.\n    \"\"\"\n\n    def is_prime_helper(num):\n        \"\"\"\n        Checks if a number is prime using an optimized trial division.\n        Handles numbers less than or equal to 1 as not prime.\n        \"\"\"\n        if num <= 1:\n            return False\n        if num <= 3:\n            return True\n        if num % 2 == 0 or num % 3 == 0:\n            return False\n        i = 5\n        while i * i <= num:\n            if num % i == 0 or num % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    if is_prime_helper(n):\n        return x\n    else:\n        return y\n```"}
