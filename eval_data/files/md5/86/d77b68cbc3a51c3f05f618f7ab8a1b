{"task_id": "HumanEval/54", "solution": "def same_chars(s0: str, s1: str):\n    \"\"\"\n    Check if two words have the same characters.\n    >>> same_chars('eabcdzzzz', 'dddzzzzzzzddeddabc')\n    True\n    >>> same_chars('abcd', 'dddddddabc')\n    True\n    >>> same_chars('dddddddabc', 'abcd')\n    True\n    >>> same_chars('eabcd', 'dddddddabc')\n    False\n    >>> same_chars('abcd', 'dddddddabce')\n    False\n    >>> same_chars('eabcdzzzz', 'dddzzzzzzzddddabc')\n    False\n    \"\"\"\n    return set(s0) == set(s1)"}
{"task_id": "HumanEval/55", "solution": "def fib(n: int):\n    \"\"\"Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    \"\"\"\n    if n <= 2:\n        return 1\n\n    a, b = 1, 1\n    for _ in range(3, n + 1):\n        a, b = b, a + b\n    return b"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\"\"\"\n    if len(l) <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(len(l) - 1):\n        if l[i] > l[i+1]:\n            is_increasing = False\n        if l[i] < l[i+1]:\n            is_decreasing = False\n        \n        # Optimization: if neither is possible, we can stop early\n        if not is_increasing and not is_decreasing:\n            return False\n\n    return is_increasing or is_decreasing"}
{"task_id": "HumanEval/59", "solution": "import math\ndef largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    largest_factor = 1\n\n    # Handle factor 2\n    while n % 2 == 0:\n        largest_factor = 2\n        n //= 2\n\n    # Handle odd factors from 3 up to sqrt(n)\n    # We only need to check odd numbers\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        while n % i == 0:\n            largest_factor = i\n            n //= i\n\n    # If n is still greater than 2, it must be a prime factor itself\n    if n > 2:\n        largest_factor = n\n\n    return largest_factor"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\"\"\"\n    set1 = set(l1)\n    set2 = set(l2)\n    common_elements_set = set1.intersection(set2)\n    result_list = list(common_elements_set)\n    result_list.sort()\n    return result_list"}
{"task_id": "HumanEval/61", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"(\" and \")\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    open_brackets_count = 0\n    for char in brackets:\n        if char == '(':\n            open_brackets_count += 1\n        elif char == ')':\n            open_brackets_count -= 1\n        \n        if open_brackets_count < 0:\n            return False\n    \n    return open_brackets_count == 0"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"Calculates the sum of ASCII codes of only the uppercase characters in a string.\"\"\"\n    total_sum = 0\n    for char in s:\n        if char.isupper():\n            total_sum += ord(char)\n    return total_sum"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\n     Return derivative of this polynomial in the same form.\n    >>> derivative([3, 1, 2, 4, 5])\n    [1, 4, 12, 20]\n    >>> derivative([1, 2, 3])\n    [2, 6]\n    \"\"\"\n    if not xs or len(xs) <= 1:\n        return []\n\n    derivative_coeffs = []\n    for i in range(1, len(xs)):\n        derivative_coeffs.append(xs[i] * i)\n\n    return derivative_coeffs"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    \"\"\"\n    s = str(abs(x))\n    n = len(s)\n\n    if shift > n:\n        return s[::-1]\n    else:\n        effective_shift = shift % n\n        return s[-effective_shift:] + s[:-effective_shift]"}
{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int):\n    \"\"\"sum_to_n is a function that sums numbers from 1 to n.\n    >>> sum_to_n(30)\n    465\n    >>> sum_to_n(100)\n    5050\n    >>> sum_to_n(5)\n    15\n    >>> sum_to_n(10)\n    55\n    >>> sum_to_n(1)\n    1\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Parameter 'n' must be an integer.\")\n    if n <= 0:\n        raise ValueError(\"Parameter 'n' must be a positive integer.\")\n\n    return n * (n + 1) // 2"}
{"task_id": "HumanEval/63", "solution": "def fibfib(n: int):\n    \"\"\"Computes the n-th element of the FibFib number sequence using memoization.\"\"\"\n    memo = {\n        0: 0,\n        1: 0,\n        2: 1\n    }\n\n    def _fibfib_recursive(k: int):\n        if k in memo:\n            return memo[k]\n        \n        result = _fibfib_recursive(k - 1) + _fibfib_recursive(k - 2) + _fibfib_recursive(k - 3)\n        memo[k] = result\n        return result\n\n    return _fibfib_recursive(n)"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Counts the number of vowels in a string, including 'y' if it's the last character.\n    Vowels are 'a', 'e', 'i', 'o', 'u' (case-insensitive); 'y' is also a vowel when at the end.\n    \"\"\"\n    standard_vowels = {'a', 'e', 'i', 'o', 'u'}\n    vowel_count = 0\n    \n    lower_s = s.lower()\n    \n    for i, char in enumerate(lower_s):\n        if char in standard_vowels:\n            vowel_count += 1\n        elif char == 'y' and i == len(lower_s) - 1:\n            vowel_count += 1\n            \n    return vowel_count"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for i, value in enumerate(arr):\n        if value % 2 == 0:  # Check if the value is even.\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = i\n            # If value == smallest_even_value, the current smallest_even_index (which is smaller) is retained.\n\n    if smallest_even_index != -1:\n        return [smallest_even_value, smallest_even_index]\n    else:\n        return []"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic. A palindromic array is an array that\n    is read the same backwards and forwards. In one change, you can change one element to any other element.\n\n    For example:\n    smallest_change([1,2,3,5,4,7,9,6]) == 4\n    smallest_change([1, 2, 3, 4, 3, 2, 2]) == 1\n    smallest_change([1, 2, 3, 2, 1]) == 0\n    \"\"\"\n    changes_count = 0\n    left = 0\n    right = len(arr) - 1\n\n    while left < right:\n        if arr[left] != arr[right]:\n            changes_count += 1\n        left += 1\n        right -= 1\n    return changes_count"}
{"task_id": "HumanEval/69", "solution": "from collections import Counter\ndef search(lst):\n    '''\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than \n    zero, and has a frequency greater than or equal to the value of the integer itself. \n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    '''\n    # Calculate the frequency of each integer in the list.\n    frequency_map = Counter(lst)\n    \n    qualifying_integers = []\n    # Identify integers that meet the frequency-to-value criterion.\n    for num, freq in frequency_map.items():\n        if num > 0 and freq >= num:\n            qualifying_integers.append(num)\n    \n    # Return the greatest qualifying integer or -1 if none exist.\n    if not qualifying_integers:\n        return -1\n    \n    return max(qualifying_integers)"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    '''\n    if not lst:\n        return []\n\n    # Create a sorted copy of the input list to efficiently get min/max.\n    # This also ensures the original list is not modified.\n    mutable_list = sorted(lst)\n    result_list = []\n    is_min_turn = True\n\n    while mutable_list:\n        if is_min_turn:\n            # Take the minimum element (which is at the beginning of the sorted list)\n            val = mutable_list.pop(0)\n        else:\n            # Take the maximum element (which is at the end of the sorted list)\n            val = mutable_list.pop()\n        \n        result_list.append(val)\n        is_min_turn = not is_min_turn\n        \n    return result_list"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    \"\"\"\n    Determines if the object q will fly based on balance (palindromic list) and weight.\n    \"\"\"\n    balanced = (q == q[::-1])\n    total_weight = sum(q)\n    within_weight_limit = (total_weight <= w)\n    \n    return balanced and within_weight_limit"}
{"task_id": "HumanEval/67", "solution": "import re\nclass InvalidFruitStringError(ValueError):\n    \"\"\"Exception raised for errors in the input fruit string format.\"\"\"\n    pass\nclass InvalidFruitCountError(ValueError):\n    \"\"\"Exception raised when total fruits are less than known fruits.\"\"\"\n    pass\nclass FruitStringParser:\n    \"\"\"Parses a string to extract apple and orange counts.\"\"\"\n\n    _PATTERN = re.compile(r\"(\\d+)\\s+apples\\s+and\\s+(\\d+)\\s+oranges\")\n\n    def parse(self, fruit_string: str) -> dict[str, int]:\n        \"\"\"Extracts apple and orange counts from the given string.\"\"\"\n        match = self._PATTERN.match(fruit_string)\n        if not match:\n            raise InvalidFruitStringError(\n                f\"Invalid fruit string format: '{fruit_string}'. \"\n                \"Expected 'X apples and Y oranges'.\"\n            )\n        \n        apples = int(match.group(1))\n        oranges = int(match.group(2))\n        \n        return {\"apples\": apples, \"oranges\": oranges}\nclass FruitCalculatorService:\n    \"\"\"Provides functionality to calculate the number of mango fruits.\"\"\"\n\n    def __init__(self, parser: FruitStringParser):\n        \"\"\"Initializes the FruitCalculatorService with a parser.\"\"\"\n        self._parser = parser\n\n    def calculate_mangoes(self, fruit_string: str, total_fruits: int) -> int:\n        \"\"\"Calculates the number of mango fruits in a basket.\"\"\"\n        if not isinstance(total_fruits, int) or total_fruits < 0:\n            raise ValueError(\"total_fruits must be a non-negative integer.\")\n\n        counts = self._parser.parse(fruit_string)\n\n        apple_count = counts[\"apples\"]\n        orange_count = counts[\"oranges\"]\n\n        known_fruits_sum = apple_count + orange_count\n\n        if known_fruits_sum > total_fruits:\n            raise InvalidFruitCountError(\n                f\"Total fruits ({total_fruits}) cannot be less than \"\n                f\"the sum of apples and oranges ({known_fruits_sum}).\"\n            )\n\n        mango_count = total_fruits - known_fruits_sum\n        return mango_count\ndef fruit_distribution(s,n):\n    \"\"\"\n    In this task, you will be given a string that represents a number of apples and oranges \n    that are distributed in a basket of fruit this basket contains \n    apples, oranges, and mango fruits. Given the string that represents the total number of \n    the oranges and apples and an integer that represent the total number of the fruits \n    in the basket return the number of the mango fruits in the basket.\n    for examble:\n    fruit_distribution(\"5 apples and 6 oranges\", 19) ->19 - 5 - 6 = 8\n    fruit_distribution(\"0 apples and 1 oranges\",3) -> 3 - 0 - 1 = 2\n    fruit_distribution(\"2 apples and 3 oranges\", 100) -> 100 - 2 - 3 = 95\n    fruit_distribution(\"100 apples and 1 oranges\",120) -> 120 - 100 - 1 = 19\n    \"\"\"\n    parser = FruitStringParser()\n    calculator = FruitCalculatorService(parser)\n    return calculator.calculate_mangoes(s, n)"}
{"task_id": "HumanEval/71", "solution": "import math\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater \n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    '''\n    if a <= 0 or b <= 0 or c <= 0:\n        return -1.0\n    \n    if not ((a + b > c) and (a + c > b) and (b + c > a)):\n        return -1.0\n    \n    s = (a + b + c) / 2\n    area_squared = s * (s - a) * (s - b) * (s - c)\n    \n    # Handle potential floating-point inaccuracies for nearly degenerate triangles.\n    if area_squared < 0:\n        return 0.0\n        \n    area = math.sqrt(area_squared)\n    return round(area, 2)"}
