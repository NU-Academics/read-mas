{"task_id": "HumanEval/15", "solution": "def string_sequence(n: int) -> str:\n    \"\"\" Return a string containing space-delimited numbers starting from 0 upto n inclusive.\n    \"\"\"\n    if n < 0:\n        return \"\"\n    return \" \".join(str(i) for i in range(n + 1))"}
{"task_id": "HumanEval/1", "solution": "from typing import List\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    result = []\n    current_group = []\n    balance = 0\n\n    for char in paren_string:\n        if char == '(':\n            balance += 1\n            current_group.append(char)\n        elif char == ')':\n            balance -= 1\n            current_group.append(char)\n        elif char == ' ':\n            continue\n\n        if balance == 0 and current_group:\n            result.append(\"\".join(current_group))\n            current_group = []\n        elif balance < 0:\n            # An unmatched ')' invalidates the current group being built.\n            current_group = []\n            balance = 0\n\n    return result"}
{"task_id": "HumanEval/16", "solution": "def count_distinct_characters(string: str) -> int:\n    \"\"\" Given a string, find out how many distinct characters (regardless of case) does it consist of\n    >>> count_distinct_characters('xyzXYZ')\n    3\n    >>> count_distinct_characters('Jerry')\n    4\n    \"\"\"\n    seen_characters = set()\n    for char in string:\n        seen_characters.add(char.lower())\n    return len(seen_characters)"}
{"task_id": "HumanEval/10", "solution": "def make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    if not string:\n        return \"\"\n\n    # Iterate `i` from 0 up to `len(string)` to find the longest palindromic suffix.\n    # The first `i` for which `string[i:]` is a palindrome will correspond to the longest such suffix.\n    for i in range(len(string) + 1):\n        suffix = string[i:]\n        if is_palindrome(suffix):\n            # The part of the string before the palindromic suffix needs to be reversed and appended.\n            prefix_to_reverse = string[:i]\n            return string + prefix_to_reverse[::-1]\n\n    # This line should theoretically not be reached, as an empty suffix (when i=len(string)) is always a palindrome."}
{"task_id": "HumanEval/18", "solution": "def how_many_times(string: str, substring: str) -> int:\n    \"\"\" Find how many times a given substring can be found in the original string. Count overlaping cases.\n    >>> how_many_times('', 'a')\n    0\n    >>> how_many_times('aaa', 'a')\n    3\n    >>> how_many_times('aaaa', 'aa')\n    3\n    \"\"\"\n    if not substring:\n        return 0\n    \n    count = 0\n    len_string = len(string)\n    len_substring = len(substring)\n\n    # Loop through the string, considering each character as a potential start of the substring.\n    # The loop needs to go up to len_string - len_substring to ensure a full substring can fit.\n    for i in range(len_string - len_substring + 1):\n        if string[i:i+len_substring] == substring:\n            count += 1\n            \n    return count"}
{"task_id": "HumanEval/22", "solution": "from typing import List, Any\ndef filter_integers(values: List[Any]) -> List[int]:\n    \"\"\" Filter given list of any python values only for integers\n    >>> filter_integers(['a', 3.14, 5])\n    [5]\n    >>> filter_integers([1, 2, 3, 'abc', {}, []])\n    [1, 2, 3]\n    \"\"\"\n    return [value for value in values if isinstance(value, int)]"}
{"task_id": "HumanEval/17", "solution": "from typing import List\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\" Input to this function is a string representing musical notes in a special ASCII format.\n    Your task is to parse this string and return list of integers corresponding to how many beats does each\n    not last.\n\n    Here is a legend:\n    'o' - whole note, lasts four beats\n    'o|' - half note, lasts two beats\n    '.|' - quater note, lasts one beat\n\n    >>> parse_music('o o| .| o| o| .| .| .| .| o o')\n    [4, 2, 1, 2, 2, 1, 1, 1, 1, 4, 4]\n    \"\"\"\n    note_beat_map = {\n        'o': 4,\n        'o|': 2,\n        '.|': 1,\n    }\n\n    beat_durations: List[int] = []\n    \n    # Split the string by any whitespace, handling multiple spaces and returning\n    # an empty list for empty or all-whitespace input strings.\n    notes = music_string.split() \n\n    for note in notes:\n        if note in note_beat_map:\n            beat_durations.append(note_beat_map[note])\n            \n    return beat_durations"}
{"task_id": "HumanEval/19", "solution": "from typing import List, Dict, Optional\nclass NumberWordMapper:\n    \"\"\"Provides bidirectional mapping between number words and their integer equivalents.\"\"\"\n    WORD_TO_INT_MAP: Dict[str, int] = {\n        'zero': 0, 'one': 1, 'two': 2, 'three': 3, 'four': 4,\n        'five': 5, 'six': 6, 'seven': 7, 'eight': 8, 'nine': 9\n    }\n\n    INT_TO_WORD_MAP: Dict[int, str] = {\n        0: 'zero', 1: 'one', 2: 'two', 3: 'three', 4: 'four',\n        5: 'five', 6: 'six', 7: 'seven', 8: 'eight', 9: 'nine'\n    }\n\n    def word_to_int(self, word: str) -> Optional[int]:\n        \"\"\"Converts a number word to its integer.\"\"\"\n        return self.WORD_TO_INT_MAP.get(word.lower())\n\n    def int_to_word(self, num: int) -> Optional[str]:\n        \"\"\"Converts an integer to its number word.\"\"\"\n        return self.INT_TO_WORD_MAP.get(num)\nclass StringSplitter:\n    \"\"\"Splits an input string into a list of words based on a delimiter (space).\"\"\"\n    def split_string(self, input_string: str) -> List[str]:\n        \"\"\"Splits the input_string by spaces and returns a list of non-empty words.\"\"\"\n        return [word for word in input_string.split(' ') if word]\nclass NumberSorterService:\n    \"\"\"Encapsulates the core logic for sorting number words.\"\"\"\n    def __init__(self, mapper: NumberWordMapper, splitter: StringSplitter):\n        self._mapper = mapper\n        self._splitter = splitter\n\n    def sort_words(self, number_string: str) -> str:\n        \"\"\"Sorts a space-delimited string of number words numerically.\"\"\"\n        words = self._splitter.split_string(number_string)\n        \n        integers = []\n        for word in words:\n            num = self._mapper.word_to_int(word)\n            if num is not None:\n                integers.append(num)\n        \n        integers.sort()\n        \n        sorted_words = []\n        for num in integers:\n            word = self._mapper.int_to_word(num)\n            if word is not None:\n                sorted_words.append(word)\n                \n        return ' '.join(sorted_words)\ndef sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Valid choices are 'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight' and 'nine'.\n    Return the string with numbers sorted from smallest to largest\n    >>> sort_numbers('three one five')\n    'one three five'\n    \"\"\"\n    mapper = NumberWordMapper()\n    splitter = StringSplitter()\n    service = NumberSorterService(mapper=mapper, splitter=splitter)\n    return service.sort_words(numbers)"}
