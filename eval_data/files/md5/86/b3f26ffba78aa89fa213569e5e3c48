{"task_id": "Mbpp/594", "solution": "def diff_even_odd(numbers: list[int]) -> int:\n    \"\"\"\n    Finds the difference between the first even and first odd number in a list.\n    Assumes that both an even and an odd number exist in the list.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for number in numbers:\n        if first_even is None and number % 2 == 0:\n            first_even = number\n        if first_odd is None and number % 2 != 0:\n            first_odd = number\n        if first_even is not None and first_odd is not None:\n            break\n\n    return first_even - first_odd"}
{"task_id": "Mbpp/593", "solution": "def removezero_ip(ip_address):\n    \"\"\"\n    Removes leading zeroes from each octet of an IPv4 address string.\n    The function splits the IP, processes each octet, and then reconstructs the string.\n    \"\"\"\n    octets = ip_address.split('.')\n    normalized_octets = []\n    for octet in octets:\n        # Convert to int and then back to string to remove leading zeroes\n        # int('08') becomes 8, str(8) becomes '8'\n        normalized_octets.append(str(int(octet)))\n    return '.'.join(normalized_octets)"}
{"task_id": "Mbpp/599", "solution": "def sum_average(n: int) -> tuple:\n    \"\"\"\n    Calculates the sum and average of the first n natural numbers.\n    Assumes n is a positive integer.\n    \"\"\"\n    total_sum = n * (n + 1) / 2\n    average = total_sum / n\n    return int(total_sum), float(average)"}
{"task_id": "Mbpp/602", "solution": "def first_repeated_char(input_string: str) -> str:\n    \"\"\"\n    Finds the first character that appears more than once in the given string.\n    It scans the string from left to right, tracking seen characters using a set.\n    \"\"\"\n    seen_chars = set()\n    for char in input_string:\n        if char in seen_chars:\n            return char\n        seen_chars.add(char)\n    return None"}
{"task_id": "Mbpp/598", "solution": "def armstrong_number(number):\n    \"\"\"\n    Checks if a number is an Armstrong number.\n    An Armstrong number is equal to the sum of its digits, each raised to the power of the total number of digits.\n    \"\"\"\n    original_number = number\n    num_str = str(number)\n    num_digits = len(num_str)\n    \n    armstrong_sum = 0\n    for digit_char in num_str:\n        digit = int(digit_char)\n        armstrong_sum += digit ** num_digits\n        \n    return armstrong_sum == original_number"}
