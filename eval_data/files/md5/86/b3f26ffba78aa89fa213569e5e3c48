{"task_id": "Mbpp/643", "solution": "import string\n\ndef is_word_boundary(char):\n    \"\"\"Determines if a character is a word boundary (whitespace or punctuation).\"\"\"\n    return char.isspace() or char in string.punctuation\n\ndef identify_word_boundaries(input_string):\n    \"\"\"Identifies the start and end indices of words in the input string.\"\"\"\n    word_spans = []\n    current_word_start = -1\n    for i, char in enumerate(input_string):\n        if not is_word_boundary(char):\n            if current_word_start == -1:\n                current_word_start = i\n        else:\n            if current_word_start != -1:\n                word_spans.append((current_word_start, i))\n                current_word_start = -1\n    if current_word_start != -1:\n        word_spans.append((current_word_start, len(input_string)))\n    return word_spans\n\ndef extract_words(input_string, word_spans):\n    \"\"\"Extracts words from the input string based on identified word spans.\"\"\"\n    words = []\n    for start, end in word_spans:\n        words.append(input_string[start:end])\n    return words\n\ndef parse_words(input_string):\n    \"\"\"Extracts individual words from the input string using boundary detection.\"\"\"\n    word_spans = identify_word_boundaries(input_string)\n    words = extract_words(input_string, word_spans)\n    return words\n\ndef has_middle_z(word):\n    \"\"\"Checks if a single word contains 'z' in a middle position.\"\"\"\n    if len(word) < 3:\n        return False\n    for i in range(1, len(word) - 1):\n        if word[i] == 'z':\n            return True\n    return False\n\ndef text_match_wordz_middle(input_string):\n    \"\"\"\n    Checks if the input string contains 'z' in the middle position of any word.\n    'z' must not be at the start or end of a word.\n    \"\"\"\n    words = parse_words(input_string)\n    for word in words:\n        if has_middle_z(word):\n            return True\n    return False"}
{"task_id": "Mbpp/721", "solution": "class Cell:\n    \"\"\"Represents an individual cell in the matrix with its coordinates and cost.\"\"\"\n    def __init__(self, row: int, column: int, cost: float):\n        self._row = row\n        self._column = column\n        self._cost = cost\n\n    def getRow(self) -> int:\n        return self._row\n\n    def getColumn(self) -> int:\n        return self._column\n\n    def getCost(self) -> float:\n        return self._cost\n\nclass Path:\n    \"\"\"Represents a traversal path through the matrix, storing cells and calculating average cost.\"\"\"\n    def __init__(self):\n        self._cells = []\n        self._total_cost = 0.0\n        self._cell_count = 0\n\n    def addCell(self, cell: Cell) -> None:\n        self._cells.append(cell)\n        self._total_cost += cell.getCost()\n        self._cell_count += 1\n\n    def calculateAverage(self) -> float:\n        if self._cell_count == 0:\n            return 0.0\n        return self._total_cost / self._cell_count\n\n    def getTotalCost(self) -> float:\n        return self._total_cost\n\n    def getCellCount(self) -> int:\n        return self._cell_count\n\nclass Matrix:\n    \"\"\"Represents the input matrix, providing data access and size information.\"\"\"\n    def __init__(self, cells_data: list[list[float]]):\n        self._cells_data = cells_data\n        self._size = len(cells_data)\n\n    def getCell(self, row: int, col: int) -> float:\n        return self._cells_data[row][col]\n\n    def getSize(self) -> int:\n        return self._size\n\nclass PathFinder:\n    \"\"\"Core logic for generating all valid paths and finding the maximum average.\"\"\"\n    def __init__(self, matrix: Matrix):\n        self._matrix = matrix\n        self._all_paths = []\n\n    def _find_all_paths_recursive(self, row: int, col: int, current_path_cells: list[Cell]):\n        N = self._matrix.getSize()\n\n        cell_cost = self._matrix.getCell(row, col)\n        current_cell_obj = Cell(row, col, cell_cost)\n\n        new_path_cells = current_path_cells + [current_cell_obj]\n\n        if row == N - 1 and col == N - 1:\n            final_path = Path()\n            for cell in new_path_cells:\n                final_path.addCell(cell)\n            self._all_paths.append(final_path)\n            return\n\n        if col + 1 < N:\n            self._find_all_paths_recursive(row, col + 1, new_path_cells)\n\n        if row + 1 < N:\n            self._find_all_paths_recursive(row + 1, col, new_path_cells)\n\n    def findAllPaths(self) -> list[Path]:\n        self._find_all_paths_recursive(0, 0, [])\n        return self._all_paths\n\n    def calculateMaxAverage(self) -> float:\n        self.findAllPaths()\n\n        if not self._all_paths:\n            return 0.0\n\n        max_avg = -1.0\n\n        for path in self._all_paths:\n            avg = path.calculateAverage()\n            if avg > max_avg:\n                max_avg = avg\n        return max_avg\n\ndef maxAverageOfPath(matrix: list[list[float]]) -> float:\n    \"\"\"\n    Calculates the maximum average cost of a path from the top-left to the bottom-right\n    cell in a square matrix, moving only right or down.\n    \"\"\"\n    matrix_obj = Matrix(matrix)\n    path_finder_obj = PathFinder(matrix_obj)\n    return path_finder_obj.calculateMaxAverage()"}
{"task_id": "Mbpp/724", "solution": "def power_base_sum(base: int, power: int) -> int:\n    \"\"\"\n    Calculates the sum of all digits of the base raised to the specified power.\n    Handles large integer results automatically.\n    \"\"\"\n    result = base ** power\n    digit_sum = 0\n    for digit_char in str(result):\n        digit_sum += int(digit_char)\n    return digit_sum"}
