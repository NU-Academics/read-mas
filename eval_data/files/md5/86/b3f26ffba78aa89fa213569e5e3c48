{"task_id": "Mbpp/274", "solution": "import math\n\ndef _calculate_binomial_coefficient(n: int, k: int) -> int:\n    \"\"\"Calculates the binomial coefficient C(n, k).\n    Returns 0 if k is out of bounds (k < 0 or k > n).\"\"\"\n    if k < 0 or k > n:\n        return 0\n    return math.factorial(n) // (math.factorial(k) * math.factorial(n - k))\n\ndef even_binomial_Coeff_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of even-indexed binomial coefficients C(n, k) for a positive integer n.\n    Iterates through even indices k from 0 to n, summing C(n, k) for each.\n    \"\"\"\n    total_sum = 0\n    # Iterate through even indices k: 0, 2, 4, ... up to n\n    for k in range(0, n + 1, 2):\n        total_sum += _calculate_binomial_coefficient(n, k)\n    return total_sum"}
