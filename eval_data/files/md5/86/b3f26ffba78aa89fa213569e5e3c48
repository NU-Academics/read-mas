{"task_id": "Mbpp/775", "solution": "def _is_odd_index(index: int) -> bool:\n    \"\"\"Check if index position is odd (1, 3, 5, etc.).\"\"\"\n    return index % 2 != 0\n\ndef _is_odd_number(number: int) -> bool:\n    \"\"\"Check if number is odd (not divisible by 2).\"\"\"\n    return number % 2 != 0\n\ndef odd_position(input_list: list) -> bool:\n    \"\"\"\n    Check if every odd index contains an odd number.\n    Returns True if all odd indices contain odd numbers, False otherwise.\n    \"\"\"\n    for index, number in enumerate(input_list):\n        if _is_odd_index(index):\n            if not _is_odd_number(number):\n                return False\n    return True"}
{"task_id": "Mbpp/781", "solution": "def count_divisors(n: int) -> bool:\n    \"\"\"\n    Checks if the count of divisors for a given positive integer n is even.\n    Returns True if the divisor count is even, False otherwise.\n    \"\"\"\n    count = 0\n    i = 1\n    while i * i <= n:\n        if n % i == 0:\n            if i * i == n:\n                count += 1\n            else:\n                count += 2\n        i += 1\n    return count % 2 == 0"}
{"task_id": "Mbpp/780", "solution": "import itertools\n\ndef find_combinations(tuple_list):\n    \"\"\"\n    Finds all pairwise combinations of sums from a list of tuples.\n    This includes self-pairing and sums the elements at corresponding positions.\n    \"\"\"\n    result_sums = []\n    # Generate all combinations of indices (including self-pairing)\n    # The `itertools.combinations_with_replacement` function is ideal for this.\n    for i, j in itertools.combinations_with_replacement(range(len(tuple_list)), 2):\n        tuple1 = tuple_list[i]\n        tuple2 = tuple_list[j]\n\n        # Calculate element-wise sum for the pair\n        sum_tuple = (tuple1[0] + tuple2[0], tuple1[1] + tuple2[1])\n        result_sums.append(sum_tuple)\n    \n    return result_sums"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(arr: list) -> int:\n    \"\"\"\n    Calculates the sum of all odd length subarrays from an input array.\n    This function generates all subarrays, filters for odd lengths, and sums their elements.\n    \"\"\"\n    total_sum = 0\n    n = len(arr)\n\n    for i in range(n):\n        for j in range(i, n):\n            subarray = arr[i : j + 1]\n            if len(subarray) % 2 == 1:\n                total_sum += sum(subarray)\n    return total_sum"}
{"task_id": "Mbpp/785", "solution": "def _validate_tuple_format(string_input: str) -> bool:\n    \"\"\"Checks if the input string starts and ends with parentheses.\"\"\"\n    return string_input.startswith('(') and string_input.endswith(')')\n\ndef _parse_integers(string_content: str) -> list:\n    \"\"\"Extracts and converts comma-separated integer values from a string.\"\"\"\n    if not string_content.strip():\n        return []\n    parts = string_content.split(',')\n    return [int(part.strip()) for part in parts]\n\ndef tuple_str_int(string_input: str) -> tuple:\n    \"\"\"\n    Converts a string representation of a tuple containing integers to an actual integer tuple.\n    Assumes valid input format based on _validate_tuple_format.\n    \"\"\"\n    if not _validate_tuple_format(string_input):\n        # As per design, no exceptions or complex error handling.\n        # Returning an empty tuple for invalid format is a simple graceful handling.\n        return ()\n\n    # Extract the content between the parentheses\n    content = string_input[1:-1]\n    \n    # Parse the content into a list of integers\n    int_list = _parse_integers(content)\n    \n    # Convert the list to a tuple\n    return tuple(int_list)"}
