{"task_id": "Mbpp/61", "solution": "def validate_input(s: str) -> bool:\n    \"\"\"\n    Validate input contains only numeric characters.\n    \"\"\"\n    return s.isnumeric()\n\ndef calculate_digit_sum(substring: str) -> int:\n    \"\"\"\n    Calculate sum of digits in substring.\n    \"\"\"\n    return sum(int(digit) for digit in substring)\n\ndef generate_substrings(s: str) -> list[str]:\n    \"\"\"\n    Generate all possible contiguous substrings.\n    \"\"\"\n    substrings = []\n    n = len(s)\n    for i in range(n):\n        for j in range(i + 1, n + 1):\n            substrings.append(s[i:j])\n    return substrings\n\ndef count_Substrings(s: str) -> int:\n    \"\"\"\n    Count substrings where sum of digits equals substring length.\n    \"\"\"\n    if not validate_input(s):\n        return 0\n\n    count = 0\n    all_substrings = generate_substrings(s)\n\n    for substring in all_substrings:\n        digit_sum = calculate_digit_sum(substring)\n        length = len(substring)\n        if digit_sum == length:\n            count += 1\n    return count"}
