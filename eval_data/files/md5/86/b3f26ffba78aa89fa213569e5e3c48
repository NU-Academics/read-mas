{"task_id": "Mbpp/751", "solution": "def check_min_heap(array):\n    \"\"\"\n    Checks if the given array represents a min heap.\n    Iterates through parent nodes and validates the min-heap property against their children.\n    \"\"\"\n    n = len(array)\n\n    # Empty or single-element arrays are considered valid min heaps.\n    if n <= 1:\n        return True\n\n    # Iterate only up to the last parent node that can have children.\n    # For a 0-indexed array, the last parent is at index (n // 2) - 1.\n    for i in range(n // 2):\n        left_child_index = 2 * i + 1\n        right_child_index = 2 * i + 2\n\n        # Check left child\n        if left_child_index < n and array[i] > array[left_child_index]:\n            return False\n\n        # Check right child\n        if right_child_index < n and array[i] > array[right_child_index]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/753", "solution": "def min_k(tuples: list, k: int) -> list:\n    \"\"\"\n    Finds the k tuples with the smallest second element values from a list of tuples.\n    The returned tuples are sorted in ascending order by their second element.\n    \"\"\"\n    if not tuples:\n        return []\n\n    # Sort the list of tuples based on the second element (index 1)\n    sorted_tuples = sorted(tuples, key=lambda x: x[1])\n\n    # Select the first k elements from the sorted list.\n    # If k is larger than the list length, it will return all elements.\n    return sorted_tuples[:k]"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Calculates the nth Jacobsthal number iteratively.\n    Handles base cases for n=0 and n=1, then uses the recurrence J(n) = J(n-1) + 2*J(n-2).\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n\n    j_n_minus_2 = 0  # Represents J(0)\n    j_n_minus_1 = 1  # Represents J(1)\n    current_jacobsthal = 0\n\n    # The loop starts from i=2 to calculate J(2), J(3), ..., J(n)\n    for _ in range(2, n + 1):\n        current_jacobsthal = j_n_minus_1 + 2 * j_n_minus_2\n        j_n_minus_2 = j_n_minus_1\n        j_n_minus_1 = current_jacobsthal\n\n    return current_jacobsthal"}
