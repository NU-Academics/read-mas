{"task_id": "Mbpp/733", "solution": "import List\n\ndef find_first_occurrence(array: List[int], target: int) -> int:\n    \"\"\"\n    Find the index of the first occurrence of target in a sorted array using binary search.\n    \"\"\"\n    low, high = 0, len(array) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == target:\n            result = mid\n            high = mid - 1  # Move left to find the first occurrence\n        elif array[mid] < target:\n            low = mid + 1\n        else:\n            high = mid - 1\n            \n    return result"}
{"task_id": "Mbpp/734", "solution": "def calculate_product(sublist):\n    \"\"\"Calculates the product of all elements in a sublist.\n    Returns 1 for an empty sublist, consistent with multiplicative identity.\"\"\"\n    if not sublist:\n        return 1\n    product = 1\n    for x in sublist:\n        product *= x\n    return product\n\ndef sum_products(sublists):\n    \"\"\"Sums the products of all given sublists.\"\"\"\n    total_sum = 0\n    for sublist in sublists:\n        total_sum += calculate_product(sublist)\n    return total_sum\n\ndef generate_contiguous_sublists(lst):\n    \"\"\"Generates all contiguous sublists of a given list.\"\"\"\n    contiguous_sublists = []\n    n = len(lst)\n    for i in range(n):\n        for j in range(i, n):\n            contiguous_sublists.append(lst[i : j + 1])\n    return contiguous_sublists\n\ndef generate_noncontiguous_sublists(lst):\n    \"\"\"Generates all non-contiguous sublists of a list.\n    This implementation returns an empty list to satisfy the provided assert example,\n    which implies only contiguous sublists are considered for summation.\"\"\"\n    # The problem assertion sum_Of_Subarray_Prod([1,2,3]) == 20\n    # indicates that only contiguous sublists are to be included in the sum.\n    return []\n\ndef generate_all_sublists(lst):\n    \"\"\"Generates all possible sublists by combining contiguous and (effectively empty) non-contiguous lists.\n    The non-contiguous generation is suppressed to match the problem's assertion.\"\"\"\n    all_subs = generate_contiguous_sublists(lst)\n    all_subs.extend(generate_noncontiguous_sublists(lst)) # This will extend with an empty list.\n    return all_subs\n\ndef sum_Of_Subarray_Prod(input_list):\n    \"\"\"Finds the sum of products of all possible sublists of a given list.\n    This function processes only contiguous sublists to satisfy the problem's assertion.\"\"\"\n    all_sublists = generate_all_sublists(input_list)\n    return sum_products(all_sublists)"}
{"task_id": "Mbpp/735", "solution": "def _get_bit_length(number: int) -> int:\n    \"\"\"Calculates the number of bits in the binary representation of a number.\"\"\"\n    return number.bit_length()\n\ndef _create_toggle_mask(bit_length: int) -> int:\n    \"\"\"Creates a bitmask to toggle all bits except the first (MSB) and last (LSB).\"\"\"\n    mask = 0\n    # Iterate from the second bit (index 1) to the second-to-last bit (index bit_length - 2)\n    for i in range(1, bit_length - 1):\n        mask |= (1 << i)\n    return mask\n\ndef toggle_middle_bits(number: int) -> int:\n    \"\"\"Toggles bits of the number except the first (MSB) and the last (LSB) bit.\"\"\"\n    bit_length = _get_bit_length(number)\n    toggle_mask = _create_toggle_mask(bit_length)\n    return number ^ toggle_mask"}
{"task_id": "Mbpp/737", "solution": "import re\n\ndef check_str(input_string: str) -> bool:\n    \"\"\"Check if the string starts with a vowel (case-insensitive) using regex.\"\"\"\n    # Pattern to match a vowel (a, e, i, o, u) at the beginning of the string\n    vowel_pattern = r'^[aeiouAEIOU]'\n    return re.match(vowel_pattern, input_string) is not None"}
{"task_id": "Mbpp/740", "solution": "def tuple_to_dict(input_tuple: tuple) -> dict:\n    \"\"\"\n    Converts a tuple to a dictionary using adjacent elements as key-value pairs.\n    It expects the input tuple to have an even number of elements.\n    \"\"\"\n    result_dict = {}\n    for i in range(0, len(input_tuple), 2):\n        key = input_tuple[i]\n        value = input_tuple[i + 1]\n        result_dict[key] = value\n    return result_dict"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(arr: list[int], target: int) -> int:\n    \"\"\"\n    Locates the left insertion point for a specified value in a sorted array.\n    This uses a binary search algorithm to find the first index where target could be inserted.\n    \"\"\"\n    left = 0\n    right = len(arr)\n\n    while left < right:\n        mid = left + (right - left) // 2\n        if arr[mid] < target:\n            left = mid + 1\n        else:\n            right = mid\n            \n    return left"}
{"task_id": "Mbpp/739", "solution": "def calculate_triangular_number(k: int) -> int:\n    \"\"\"Calculate triangular number T(k) = k*(k+1)/2.\"\"\"\n    return k * (k + 1) // 2\n\ndef count_digits(number: int) -> int:\n    \"\"\"Count digits in positive integer.\"\"\"\n    return len(str(number))\n\ndef find_Index(n: int) -> int:\n    \"\"\"Find index of smallest triangular number with n digits.\"\"\"\n    k = 1\n    while True:\n        triangular_value = calculate_triangular_number(k)\n        digit_count = count_digits(triangular_value)\n        if digit_count == n:\n            return k\n        k += 1"}
