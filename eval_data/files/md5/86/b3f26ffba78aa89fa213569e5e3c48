{"task_id": "Mbpp/409", "solution": "def min_product_tuple(tuples_list):\n    \"\"\"\n    Finds the minimum product from pairs of tuples within a given list.\n    Handles empty lists and invalid tuple formats gracefully.\n    \"\"\"\n    if not tuples_list:\n        raise ValueError(\"Empty list provided\")\n\n    products = []\n    for tpl in tuples_list:\n        if not isinstance(tpl, tuple) or len(tpl) != 2:\n            raise ValueError(\"Each item in the list must be a tuple of exactly two elements.\")\n        if not (isinstance(tpl[0], (int, float)) and isinstance(tpl[1], (int, float))):\n            raise ValueError(\"Tuple elements must be numeric.\")\n        products.append(tpl[0] * tpl[1])\n\n    if not products:\n        raise ValueError(\"No valid products could be calculated.\")\n\n    return min(products)"}
{"task_id": "Mbpp/410", "solution": "from typing import Union\n\ndef min_val(input_list: list) -> Union[int, float]:\n    \"\"\"\n    Finds the minimum numeric value in a given heterogeneous list.\n    Non-numeric elements are ignored during processing.\n    \"\"\"\n\n    def _filter_numeric_values(lst: list) -> list:\n        \"\"\"Filters a list to return only numeric (int or float) values.\"\"\"\n        numeric_values = []\n        for item in lst:\n            if isinstance(item, (int, float)):\n                numeric_values.append(item)\n        return numeric_values\n\n    def _find_minimum(numeric_lst: list) -> Union[int, float]:\n        \"\"\"Finds the minimum value in a list of numbers.\"\"\"\n        return min(numeric_lst)\n\n    filtered_list = _filter_numeric_values(input_list)\n    return _find_minimum(filtered_list)"}
{"task_id": "Mbpp/415", "solution": "def max_Product(array: list[int]) -> tuple[int, int]:\n    \"\"\"\n    Find pair with highest product from array of integers.\n\n    Args:\n        array: List of integers\n\n    Returns:\n        Tuple containing the two numbers with highest product\n\n    Raises:\n        ValueError: If array has fewer than 2 elements\n    \"\"\"\n    if len(array) < 2:\n        raise ValueError(\"Input array must contain at least two elements.\")\n\n    max_product = float('-inf')\n    result_pair = None\n\n    for i in range(len(array)):\n        for j in range(i + 1, len(array)):\n            current_product = array[i] * array[j]\n            if current_product > max_product:\n                max_product = current_product\n                result_pair = (array[i], array[j])\n    \n    # The requirement specifies returning the pair as (7,8) for [1,2,3,4,7,0,8,4],\n    # implying order does not matter for the pair itself, but a consistent\n    # order might be desired for the return value. For simplicity and\n    # as product is commutative, we return the pair as it was found.\n    # If a sorted pair is required, uncomment the line below.\n    # return tuple(sorted(result_pair))\n    return result_pair"}
