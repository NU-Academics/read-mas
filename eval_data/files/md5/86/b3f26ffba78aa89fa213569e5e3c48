{"task_id": "Mbpp/616", "solution": "def tuple_modulo(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise modulo operation on two input tuples of equal length.\n    Raises ValueError if tuples have unequal lengths.\n    \"\"\"\n\n    def validate_tuple_lengths(t1: tuple, t2: tuple) -> bool:\n        \"\"\"Validates that both input tuples have equal length.\"\"\"\n        return len(t1) == len(t2)\n\n    def compute_element_modulo(element1, element2):\n        \"\"\"Computes modulo operation for individual elements.\"\"\"\n        return element1 % element2\n\n    if not validate_tuple_lengths(tuple1, tuple2):\n        raise ValueError(\"Tuples must have equal length\")\n\n    result_elements = []\n    for i in range(len(tuple1)):\n        modulo_result = compute_element_modulo(tuple1[i], tuple2[i])\n        result_elements.append(modulo_result)\n\n    return tuple(result_elements)"}
{"task_id": "Mbpp/619", "solution": "def move_num(input_string: str) -> str:\n    \"\"\"\n    Moves all numeric digits to the end of the given string, preserving relative order.\n    Iterates through the string once to separate non-digit and digit characters.\n    \"\"\"\n    non_digits = []\n    digits = []\n    for char in input_string:\n        if char.isdigit():\n            digits.append(char)\n        else:\n            non_digits.append(char)\n    return \"\".join(non_digits) + \"\".join(digits)"}
{"task_id": "Mbpp/620", "solution": "import itertools\nfrom typing import Iterator, List\n\ndef _validate_divisibility(a: int, b: int) -> bool:\n    \"\"\"Checks if two positive integers are divisible by each other.\"\"\"\n    return a % b == 0 or b % a == 0\n\ndef _generate_subsets(numbers: List[int]) -> Iterator[List[int]]:\n    \"\"\"Generates all possible subsets of the input list.\"\"\"\n    for i in range(len(numbers) + 1):\n        for subset_tuple in itertools.combinations(numbers, i):\n            yield list(subset_tuple)\n\ndef _find_max_subset_size(numbers: List[int]) -> int:\n    \"\"\"Finds the maximum size among valid divisible subsets.\"\"\"\n    if not numbers:\n        return 0\n\n    max_size = 1\n\n    for subset in _generate_subsets(numbers):\n        current_subset_size = len(subset)\n\n        if current_subset_size <= max_size:\n            continue\n\n        is_valid_subset = True\n        if current_subset_size > 1:\n            for i in range(current_subset_size):\n                for j in range(i + 1, current_subset_size):\n                    num1 = subset[i]\n                    num2 = subset[j]\n                    if not _validate_divisibility(num1, num2):\n                        is_valid_subset = False\n                        break\n                if not is_valid_subset:\n                    break\n\n        if is_valid_subset:\n            max_size = current_subset_size\n\n    return max_size\n\ndef largest_subset(numbers: List[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset of numbers where every pair is divisible.\n    A pair (a, b) is divisible if a % b == 0 or b % a == 0.\n    \"\"\"\n    return _find_max_subset_size(numbers)"}
{"task_id": "Mbpp/622", "solution": "def get_median(list1: list, list2: list, size: int) -> float:\n    \"\"\"\n    Finds the median of two sorted lists of the same size using a binary search approach.\n    This function has O(log n) time complexity.\n    \"\"\"\n\n    def find_kth_element(nums1: list, nums2: list, k: int) -> int:\n        \"\"\"\n        Helper function to find the k-th smallest element in two sorted lists.\n        It assumes nums1 and nums2 are of equal length (size).\n        \"\"\"\n        m = size # length of nums1\n        n = size # length of nums2\n\n        # Binary search for partitionX, the number of elements taken from nums1\n        # partitionX range: [max(0, k - n), min(k, m)]\n        low = max(0, k - n)\n        high = min(k, m)\n\n        while low <= high:\n            partitionX = (low + high) // 2\n            partitionY = k - partitionX # Elements taken from nums2\n\n            # Determine the boundary values for the current partitions\n            max_left_X = float('-inf') if partitionX == 0 else nums1[partitionX - 1]\n            min_right_X = float('inf') if partitionX == m else nums1[partitionX]\n\n            max_left_Y = float('-inf') if partitionY == 0 else nums2[partitionY - 1]\n            min_right_Y = float('inf') if partitionY == n else nums2[partitionY]\n\n            if max_left_X <= min_right_Y and max_left_Y <= min_right_X:\n                # Correct partition found: the k-th element is the maximum of the left halves\n                return max(max_left_X, max_left_Y)\n            elif max_left_X > min_right_Y:\n                # partitionX is too large, need to take fewer elements from nums1\n                high = partitionX - 1\n            else: # max_left_Y > min_right_X\n                # partitionX is too small, need to take more elements from nums1\n                low = partitionX + 1\n        \n        # This line should theoretically not be reached with valid inputs and k.\n        return -1\n\n    total_elements = 2 * size\n\n    # Since total_elements is always even (2 * size), the median is the average\n    # of the (total_elements // 2)-th and (total_elements // 2 + 1)-th elements\n    # (using 1-based indexing for k).\n    k1 = total_elements // 2\n    k2 = total_elements // 2 + 1\n\n    # Find these two elements\n    val1 = find_kth_element(list1, list2, k1)\n    val2 = find_kth_element(list1, list2, k2)\n\n    return (val1 + val2) / 2.0"}
