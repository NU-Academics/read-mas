{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1, l2, l3):\n    \"\"\"\n    Finds elements that appear in all three lists under the same index.\n    Compares elements positionally up to the length of the shortest list.\n    \"\"\"\n    common_elements = []\n    min_length = min(len(l1), len(l2), len(l3))\n\n    for i in range(min_length):\n        if l1[i] == l2[i] == l3[i]:\n            common_elements.append(l1[i])\n\n    return common_elements"}
{"task_id": "Mbpp/758", "solution": "from typing import List, Dict, Tuple\n\ndef unique_sublists(input_list: List) -> Dict[Tuple, int]:\n    \"\"\"\n    Counts occurrences of sublists within a list, converting each sublist to a tuple.\n    Returns a dictionary mapping each unique tuple to its occurrence count.\n    \"\"\"\n    counts = {}\n    for sublist in input_list:\n        sublist_tuple = tuple(sublist)\n        counts[sublist_tuple] = counts.get(sublist_tuple, 0) + 1\n    return counts"}
{"task_id": "Mbpp/755", "solution": "import math\n\ndef second_smallest(numbers):\n    \"\"\"\n    Finds the second smallest unique number in a list.\n    Returns infinity if there are fewer than two unique elements.\n    \"\"\"\n    unique_numbers = sorted(list(set(numbers)))\n\n    if len(unique_numbers) < 2:\n        return math.inf\n    else:\n        return unique_numbers[1]"}
{"task_id": "Mbpp/759", "solution": "def is_decimal(input_string: str) -> bool:\n    \"\"\"\n    Checks if the input string is a decimal number with exactly 2 decimal places.\n    \"\"\"\n\n    def count_decimal_points(s: str) -> int:\n        \"\"\"Counts the number of decimal points in a string.\"\"\"\n        return s.count('.')\n\n    def validate_numeric_characters(s: str) -> bool:\n        \"\"\"Checks if all characters in the string are digits or a single decimal point.\"\"\"\n        decimal_points = 0\n        for char in s:\n            if char == '.':\n                decimal_points += 1\n            elif not char.isdigit():\n                return False\n        return True\n\n    def validate_format(s: str) -> bool:\n        \"\"\"Validates the overall format of the string, ensuring valid characters and decimal point count.\"\"\"\n        if not s: # Empty string is not a valid decimal\n            return False\n        \n        if not validate_numeric_characters(s):\n            return False\n\n        num_decimal_points = count_decimal_points(s)\n        if num_decimal_points > 1:\n            return False\n        \n        # If there's a decimal point, it shouldn't be the only character,\n        # nor should it be the first if there are no digits before it (e.g., '.'),\n        # but the problem implies positive numbers so negative numbers are not in scope.\n        # The design context shows '.12' as valid so no leading/trailing checks needed here,\n        # just numeric chars and single dot.\n        return True\n\n    def parse_decimal_string(s: str) -> tuple[str, str, int]:\n        \"\"\"Parses the string into its integer part, decimal part, and decimal point position.\"\"\"\n        decimal_pos = s.find('.')\n        if decimal_pos == -1:\n            return s, \"\", len(s)\n        else:\n            integer_part = s[:decimal_pos]\n            decimal_part = s[decimal_pos+1:]\n            return integer_part, decimal_part, decimal_pos\n\n    def check_precision(decimal_part: str) -> bool:\n        \"\"\"Checks if the decimal part has exactly 2 digits.\"\"\"\n        return len(decimal_part) == 2\n\n    if not validate_format(input_string):\n        return False\n\n    integer_part, decimal_part, decimal_position = parse_decimal_string(input_string)\n\n    return check_precision(decimal_part)<ctrl63>"}
{"task_id": "Mbpp/757", "solution": "def _is_palindrome(s: str) -> bool:\n    \"\"\"Check if a string is a palindrome.\"\"\"\n    return s == s[::-1]\n\ndef _is_reverse(str1: str, str2: str) -> bool:\n    \"\"\"Check if two strings are reverses of each other.\"\"\"\n    return str1 == str2[::-1]\n\ndef _normalize_pairs(pairs: list[tuple[str, str]]) -> set[tuple[str, str]]:\n    \"\"\"Remove duplicate pairs and normalize their order.\"\"\"\n    normalized_unique_pairs = set()\n    for s1, s2 in pairs:\n        # Normalize by sorting strings within the tuple to handle (a,b) and (b,a) as the same pair.\n        normalized_pair = tuple(sorted((s1, s2)))\n        normalized_unique_pairs.add(normalized_pair)\n    return normalized_unique_pairs\n\ndef count_reverse_pairs(string_list: list[str]) -> int:\n    \"\"\"\n    Count pairs of reverse strings in the input list, excluding palindromes\n    from forming pairs and handling duplicate strings and pairs.\n    \"\"\"\n    if not string_list:\n        return 0\n\n    # Filter out palindromes as per design guidance (they should not form any pairs).\n    # This means a string like \"aba\" will not participate in pair finding.\n    filtered_strings = [s for s in string_list if not _is_palindrome(s)]\n\n    found_pairs = []\n    n = len(filtered_strings)\n\n    # Iterate through unique pairs of strings in the filtered list\n    for i in range(n):\n        for j in range(i + 1, n):\n            s1 = filtered_strings[i]\n            s2 = filtered_strings[j]\n\n            if _is_reverse(s1, s2):\n                found_pairs.append((s1, s2))\n\n    # Normalize and deduplicate the found pairs\n    return len(_normalize_pairs(found_pairs))"}
{"task_id": "Mbpp/764", "solution": "def number_ctr(input_string: str) -> int:\n    \"\"\"Counts the number of digit characters in a given string.\"\"\"\n    digit_count = 0\n    for char in input_string:\n        if char.isdigit():\n            digit_count += 1\n    return digit_count"}
{"task_id": "Mbpp/762", "solution": "def _validate_month_number(month_number: int) -> bool:\n    \"\"\"Validates that the input month number is in a valid range (1-12).\"\"\"\n    return 1 <= month_number <= 12\n\ndef _has_thirty_days(month_number: int) -> bool:\n    \"\"\"Determines if the given month number corresponds to a month with 30 days.\"\"\"\n    return month_number in (4, 6, 9, 11)\n\ndef check_monthnumber_number(month_number: int) -> bool:\n    \"\"\"\n    Checks whether the given month number contains 30 days.\n    Months are given as numbers from 1 to 12.\n    \"\"\"\n    if not _validate_month_number(month_number):\n        raise ValueError(\"Invalid month number: Month number must be between 1 and 12.\")\n    return _has_thirty_days(month_number)"}
{"task_id": "Mbpp/763", "solution": "def find_min_diff(array, length):\n    \"\"\"\n    Finds the minimum absolute difference between any two elements in a given array.\n    Assumes the array has at least 2 elements.\n    \"\"\"\n    array_list = sorted(list(array))\n    min_diff = float('inf')\n\n    for i in range(length - 1):\n        diff = array_list[i+1] - array_list[i]\n        if diff < min_diff:\n            min_diff = diff\n            \n    return min_diff"}
{"task_id": "Mbpp/769", "solution": "def Diff(first_list, second_list):\n    \"\"\"\n    Calculates the difference between two lists, returning elements from the first list\n    that are not present in the second list, while preserving their original order.\n    \"\"\"\n    result = []\n    # Convert second_list to a set for efficient membership checking.\n    second_list_set = set(second_list)\n    for item in first_list:\n        if item not in second_list_set:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers: list, target_sum: int) -> int:\n    \"\"\"\n    Counts the number of pairs in a list whose sum equals a target value.\n    Pairs are identified by unique indices (i, j) where i < j.\n    \"\"\"\n    count = 0\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if numbers[i] + numbers[j] == target_sum:\n                count += 1\n    return count"}
{"task_id": "Mbpp/766", "solution": "from typing import List, Tuple, Any\n\ndef pair_wise(input_list: List[Any]) -> List[Tuple[Any, Any]]:\n    \"\"\"\n    Return a list of all pairs of consecutive items in a given list.\n    \"\"\"\n    return [(input_list[i], input_list[i+1]) for i in range(len(input_list) - 1)]"}
{"task_id": "Mbpp/765", "solution": "def nth_polite_number(n: int) -> int:\n    \"\"\"\n    Finds the nth polite number. A polite number is a positive integer that is not a power of 2.\n    \"\"\"\n    \n    count = 0\n    num = 1\n    while True:\n        # Check if 'num' is a power of 2 using bitwise AND.\n        # A positive integer x is a power of 2 if x > 0 and (x & (x - 1)) == 0.\n        is_power_of_two = (num > 0) and ((num & (num - 1)) == 0)\n        \n        if not is_power_of_two:\n            count += 1\n            if count == n:\n                return num\n        num += 1"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"\n    Calculate sum of fourth powers of first n odd natural numbers.\n    The sum is computed using the formula (2i-1)^4 for i=1 to n.\n    \"\"\"\n    total_sum = 0\n    for i in range(1, n + 1):\n        odd_number = 2 * i - 1\n        total_sum += odd_number ** 4\n    return total_sum"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(source_string, search_substring):\n    \"\"\"\n    Finds the first occurrence and position of a substring within a string.\n    Returns None if no match is found.\n    \"\"\"\n    if not source_string or not search_substring:\n        return None\n\n    if len(search_substring) > len(source_string):\n        return None\n\n    for i in range(len(source_string) - len(search_substring) + 1):\n        match = True\n        for j in range(len(search_substring)):\n            if source_string[i + j] != search_substring[j]:\n                match = False\n                break\n        if match:\n            return (search_substring, i, i + len(search_substring))\n\n    return None"}
{"task_id": "Mbpp/772", "solution": "def remove_length(text: str, k: int) -> str:\n    \"\"\"\n    Removes all words with k length from the given string.\n    Words are separated by spaces, and the output maintains single spaces between remaining words.\n    \"\"\"\n    words = text.split()\n    filtered_words = [word for word in words if len(word) != k]\n    return ' '.join(filtered_words)"}
{"task_id": "Mbpp/771", "solution": "def check_expression(expression: str) -> bool:\n    \"\"\"\n    Checks if the given expression has balanced brackets using a stack-based approach.\n    Supports parentheses (), square brackets [], and curly braces {}.\n    \"\"\"\n    \n    # Defines the mapping of closing brackets to their corresponding opening brackets.\n    BRACKET_MAP = {\n        ')': '(',\n        ']': '[',\n        '}': '{'\n    }\n    \n    # A set of all opening brackets for efficient lookup.\n    OPENING_BRACKETS = set(BRACKET_MAP.values())\n    \n    # A list acting as a stack to keep track of encountered opening brackets.\n    stack = []\n\n    for char in expression:\n        if char in OPENING_BRACKETS:\n            # If the character is an opening bracket, push it onto the stack.\n            stack.append(char)\n        elif char in BRACKET_MAP:\n            # If the character is a closing bracket:\n            # 1. Check if the stack is empty. An empty stack means no opening bracket\n            #    exists to match the current closing bracket.\n            if not stack:\n                return False\n            \n            # 2. Pop the last opening bracket from the stack.\n            last_opening_bracket = stack.pop()\n            \n            # 3. Check if the popped opening bracket matches the current closing bracket.\n            #    If not, the brackets are unbalanced.\n            if BRACKET_MAP[char] != last_opening_bracket:\n                return False\n        # Characters that are not brackets are ignored based on the problem context.\n\n    # After iterating through the entire expression, if the stack is empty,\n    # all opening brackets have been matched with their corresponding closing brackets.\n    return not stack"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list):\n    \"\"\"\n    Groups consecutive duplicate elements into sublists.\n\n    Args:\n        input_list: List of comparable elements\n\n    Returns:\n        List of sublists where consecutive duplicates are grouped\n    \"\"\"\n    if not input_list:\n        return []\n\n    result = []\n    current_group = [input_list[0]]\n\n    for i in range(1, len(input_list)):\n        if input_list[i] == current_group[-1]:\n            current_group.append(input_list[i])\n        else:\n            result.append(current_group)\n            current_group = [input_list[i]]\n\n    result.append(current_group)\n    return result"}
