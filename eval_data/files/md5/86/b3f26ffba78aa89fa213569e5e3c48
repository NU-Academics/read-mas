{"task_id": "Mbpp/730", "solution": "from typing import List\n\ndef consecutive_duplicates(input_list: List) -> List:\n    \"\"\"Removes consecutive duplicate elements from a list, preserving the first occurrence.\n    Returns a new list without modifying the original input list.\"\"\"\n    if not input_list:\n        return []\n\n    result = [input_list[0]]\n    for i in range(1, len(input_list)):\n        if input_list[i] != result[-1]:\n            result.append(input_list[i])\n    return result"}
{"task_id": "Mbpp/731", "solution": "import math\n\ndef lateralsurface_cone(radius: float, height: float) -> float:\n    \"\"\"\n    Calculate the lateral surface area of a cone given radius and height.\n    The formula used is \u03c0 * r * sqrt(r^2 + h^2).\n    \"\"\"\n    slant_height = math.sqrt(radius**2 + height**2)\n    lateral_surface_area = math.pi * radius * slant_height\n    return lateral_surface_area"}
