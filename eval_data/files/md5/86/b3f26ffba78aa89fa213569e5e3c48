{"task_id": "Mbpp/440", "solution": "import re\n\ndef find_adverb_position(sentence: str) -> tuple:\n    \"\"\"\n    Finds the first adverb and its positions in a given sentence.\n    Returns a tuple (start_position, end_position, adverb_text).\n    \"\"\"\n\n    # --- src/text_processor.py ---\n    def tokenize_sentence(s: str) -> list:\n        # Split by spaces, keeping punctuation attached initially\n        return s.split()\n\n    def clean_word(word: str) -> str:\n        # Remove leading/trailing punctuation, but keep internal\n        return re.sub(r'^\\W+|\\W+$', '', word)\n\n    # --- src/adverb_identifier.py ---\n    # A simple list of common adverb endings and some common adverbs.\n    # This is a simplified approach, a real NLP solution would use POS tagging.\n    ADVERB_PATTERNS = [\n        \"ly\", \"ward\", \"wards\", \"wise\", \"where\", \"here\", \"there\", \"then\",\n        \"now\", \"soon\", \"late\", \"early\", \"often\", \"always\", \"never\", \"seldom\",\n        \"usually\", \"sometimes\", \"already\", \"still\", \"yet\", \"ever\", \"hard\", \"fast\",\n        \"much\", \"little\", \"very\", \"quite\", \"rather\", \"too\", \"enough\", \"almost\",\n        \"only\", \"just\", \"even\", \"indeed\", \"forth\", \"back\", \"up\", \"down\", \"in\", \"out\",\n        \"away\", \"around\", \"about\", \"above\", \"below\", \"inside\", \"outside\",\n        # Some common single-word adverbs that might not end in -ly\n        \"well\", \"badly\", \"slowly\", \"quickly\", \"loudly\", \"softly\", \"carefully\", \"happily\",\n        \"angrily\", \"bravely\", \"eagerly\", \"easily\", \"freely\", \"fully\", \"gently\", \"greatly\",\n        \"honestly\", \"instantly\", \"lightly\", \"neatly\", \"openly\", \"perfectly\", \"promptly\",\n        \"quietly\", \"rarely\", \"readily\", \"really\", \"scarcely\", \"simply\", \"smoothly\",\n        \"softly\", \"strongly\", \"surely\", \"sweetly\", \"terribly\", \"truly\", \"urgently\",\n        \"warmly\", \"wildly\", \"wisely\", \"yearly\", \"daily\", \"weekly\", \"monthly\", \"tonight\",\n        \"tomorrow\", \"yesterday\", \"anywhere\", \"everywhere\", \"nowhere\", \"somewhere\",\n        \"actually\", \"apparently\", \"certainly\", \"definitely\", \"especially\", \"evidently\",\n        \"generally\", \"hopefully\", \"incidentally\", \"luckily\", \"naturally\", \"obviously\",\n        \"possibly\", \"presumably\", \"probably\", \"reportedly\", \"seemingly\", \"seriously\",\n        \"typically\", \"ultimately\", \"unfortunately\", \"undoubtedly\", \"virtually\"\n    ]\n    # Convert to a set for O(1) average lookup\n    ADVERBS_SET = {adverb.lower() for adverb in ADVERB_PATTERNS}\n\n    def is_adverb(word: str) -> bool:\n        cleaned = clean_word(word).lower()\n        if not cleaned: # handle empty strings after cleaning\n            return False\n        # Basic heuristic: ends in -ly or is in a predefined list\n        if cleaned.endswith(\"ly\") or cleaned in ADVERBS_SET:\n            return True\n        return False\n\n    def find_first_adverb(tokens: list) -> tuple:\n        current_pos = 0\n        for i, token in enumerate(tokens):\n            if is_adverb(token):\n                return i, token\n            current_pos += len(token) + 1 # +1 for space separator\n        return -1, None # No adverb found\n\n    # --- src/position_calculator.py ---\n    def calculate_positions(original_word: str, sentence_text: str, token_index: int) -> tuple:\n        # Find the actual start and end positions in the original sentence string\n        # using the original token to account for attached punctuation.\n        current_search_index = 0\n        for i, token in enumerate(tokenize_sentence(sentence_text)):\n            if i == token_index:\n                start_pos = current_search_index\n                end_pos = start_pos + len(original_word)\n                return start_pos, end_pos\n            current_search_index += len(token) + 1 # +1 for space\n        return -1, -1 # Should not happen if token_index is valid\n\n    # --- src/result_formatter.py ---\n    def format_result(start_pos: int, end_pos: int, adverb_text: str) -> tuple:\n        return (start_pos, end_pos, adverb_text)\n\n    # --- Main Logic (find_adverb_position) ---\n    tokens = tokenize_sentence(sentence)\n    adverb_token_index, adverb_token_text = find_first_adverb(tokens)\n\n    if adverb_token_text:\n        start_pos, end_pos = calculate_positions(adverb_token_text, sentence, adverb_token_index)\n        cleaned_adverb_text = clean_word(adverb_token_text)\n        return format_result(start_pos, end_pos, cleaned_adverb_text)\n    else:\n        return (-1, -1, '') # Return an empty/default tuple if no adverb is found"}
