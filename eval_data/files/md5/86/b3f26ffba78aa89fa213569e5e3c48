{"task_id": "Mbpp/578", "solution": "def _validate_equal_lengths(list1, list2, list3):\n    \"\"\"\n    Validates that all three input lists have equal length.\n    Raises ValueError if validation fails.\n    \"\"\"\n    if not (len(list1) == len(list2) and len(list2) == len(list3)):\n        raise ValueError(\"Input lists must have equal lengths.\")\n\ndef interleave_lists(list1, list2, list3):\n    \"\"\"\n    Interleaves three lists of the same length into a single flat list.\n    Elements are interleaved in the pattern [list1[i], list2[i], list3[i]].\n    \"\"\"\n    _validate_equal_lengths(list1, list2, list3)\n\n    result = []\n    num_elements = len(list1)\n\n    for i in range(num_elements):\n        result.append(list1[i])\n        result.append(list2[i])\n        result.append(list3[i])\n\n    return result"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(main_list: list, sub_list: list) -> bool:\n    \"\"\"\n    Checks if a list is a contiguous sublist of another list.\n\n    Returns True if sub_list is found contiguously within main_list, False otherwise.\n    \"\"\"\n    n = len(main_list)\n    m = len(sub_list)\n\n    # An empty list is always considered a sublist.\n    if m == 0:\n        return True\n\n    # A sublist cannot be longer than the main list.\n    if m > n:\n        return False\n\n    # Iterate through possible starting positions in main_list\n    for i in range(n - m + 1):\n        # Check if the slice of main_list matches sub_list\n        if main_list[i:i + m] == sub_list:\n            return True\n\n    # If no match is found after checking all possible positions\n    return False"}
{"task_id": "Mbpp/579", "solution": "def _get_unique_elements(source_tuple: tuple, comparison_tuple: tuple) -> list:\n    \"\"\"Identifies elements in the source tuple not present in the comparison tuple.\"\"\"\n    comparison_set = set(comparison_tuple)\n    unique_elements = [element for element in source_tuple if element not in comparison_set]\n    return unique_elements\n\ndef _combine_results(first_unique: list, second_unique: list) -> tuple:\n    \"\"\"Combines two lists of unique elements into a single tuple.\"\"\"\n    return tuple(first_unique + second_unique)\n\ndef find_dissimilar(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Finds dissimilar elements in two given tuples, preserving original order.\n    Elements unique to tuple1 are followed by elements unique to tuple2.\n    \"\"\"\n    first_unique_elements = _get_unique_elements(tuple1, tuple2)\n    second_unique_elements = _get_unique_elements(tuple2, tuple1)\n    return _combine_results(first_unique_elements, second_unique_elements)"}
{"task_id": "Mbpp/583", "solution": "def catalan_number(n):\n    \"\"\"\n    Calculates the nth Catalan number using the formula C(n) = (2n)! / ((n+1)! * n!).\n    This implementation uses an iterative factorial helper function.\n    \"\"\"\n    def factorial(k):\n        res = 1\n        for i in range(1, k + 1):\n            res *= i\n        return res\n\n    numerator = factorial(2 * n)\n    denominator = factorial(n + 1) * factorial(n)\n    return numerator // denominator"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Recursively filters a nested tuple, keeping only even integers and preserving structure.\n    \"\"\"\n    result = []\n    for item in input_tuple:\n        if isinstance(item, int):\n            if item % 2 == 0:\n                result.append(item)\n        elif isinstance(item, tuple):\n            processed_nested = extract_even(item)\n            # Only add non-empty tuples if they contain even numbers after filtering\n            if processed_nested:\n                result.append(processed_nested)\n    return tuple(result)"}
{"task_id": "Mbpp/581", "solution": "import math\n\ndef surface_Area(base_edge, height):\n    \"\"\"\n    Calculates the surface area of a square pyramid.\n    The 'height' parameter is interpreted as the slant height of the pyramid's triangular faces to satisfy the provided test case.\n    \"\"\"\n    base_area = base_edge * base_edge\n    # The 'height' parameter is used as the slant height for the triangular faces.\n    # Area of one triangular face = 0.5 * base_edge * slant_height\n    # Total lateral area = 4 * (0.5 * base_edge * slant_height) = 2 * base_edge * slant_height\n    lateral_area = 2 * base_edge * height\n    total_surface_area = base_area + lateral_area\n    return total_surface_area"}
