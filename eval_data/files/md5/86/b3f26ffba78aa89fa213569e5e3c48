{"task_id": "Mbpp/607", "solution": "import re\n\ndef find_literals(text: str, pattern: str) -> tuple[str, int, int]:\n    \"\"\"\n    Searches a string for a regex pattern, returning the matching substring, start, and end indices.\n    If no match is found, it returns an empty string and -1 for both indices.\n    \"\"\"\n    match = re.search(pattern, text)\n    if match:\n        return (match.group(0), match.start(), match.end())\n    else:\n        return ('', -1, -1)"}
{"task_id": "Mbpp/612", "solution": "def validate_input(input_list):\n    \"\"\"\n    Validates the input list structure.\n    Given problem constraints, this function assumes valid input.\n    \"\"\"\n    # Per the problem statement, each sublist is guaranteed to have two elements.\n    # And we are instructed not to add isinstance() checks or raise exceptions for edge cases.\n    return True\n\ndef extract_first_elements(input_list):\n    \"\"\"\n    Extracts the first element from each sublist in the input.\n    \"\"\"\n    first_elements = []\n    for sublist in input_list:\n        first_elements.append(sublist[0])\n    return first_elements\n\ndef extract_second_elements(input_list):\n    \"\"\"\n    Extracts the second element from each sublist in the input.\n    \"\"\"\n    second_elements = []\n    for sublist in input_list:\n        second_elements.append(sublist[1])\n    return second_elements\n\ndef merge(input_list):\n    \"\"\"\n    Transposes a list of two-element sublists into two separate lists.\n    The first output list contains all first elements, the second has all second elements.\n    \"\"\"\n    # The design specifies calling validate_input, which assumes valid input per problem constraints.\n    _ = validate_input(input_list)\n\n    first_elements = extract_first_elements(input_list)\n    second_elements = extract_second_elements(input_list)\n\n    return [first_elements, second_elements]"}
{"task_id": "Mbpp/614", "solution": "import collections\n\ndef cummulative_sum(tuple_list):\n    \"\"\"\n    Calculates the cumulative sum of all numeric values within a list of tuples.\n    It iterates through each tuple and sums its elements.\n    \"\"\"\n    total_sum = 0\n    for tup in tuple_list:\n        for item in tup:\n            total_sum += item\n    return total_sum"}
