{"task_id": "Mbpp/592", "solution": "import math\n\ndef binomial_coefficient(n: int, k: int) -> int:\n    \"\"\"Calculates the binomial coefficient C(n, k).\"\"\"\n    if k < 0 or k > n:\n        return 0\n    return math.factorial(n) // (math.factorial(k) * math.factorial(n - k))\n\ndef get_consecutive_products(n: int) -> list:\n    \"\"\"Computes products of consecutive binomial coefficients C(n, k) * C(n, k+1).\"\"\"\n    products = []\n    for k in range(n):\n        product = binomial_coefficient(n, k) * binomial_coefficient(n, k + 1)\n        products.append(product)\n    return products\n\ndef sum_Of_product(n: int) -> int:\n    \"\"\"Finds the sum of the product of consecutive binomial coefficients.\"\"\"\n    products = get_consecutive_products(n)\n    return sum(products)"}
{"task_id": "Mbpp/589", "solution": "import math\n\ndef perfect_squares(start: int, end: int) -> list[int]:\n    \"\"\"\n    Finds perfect squares within a given numerical range [start, end).\n    \"\"\"\n    squares = []\n\n    # Determine the first integer whose square is greater than or equal to 'start'.\n    # math.isqrt returns the integer square root (floor(sqrt(n))).\n    initial_base = math.isqrt(start)\n    if initial_base * initial_base < start:\n        initial_base += 1\n\n    # Iterate from this base, adding squares to the list until they reach 'end'.\n    current_base = initial_base\n    while True:\n        square = current_base * current_base\n        if square >= end:\n            break\n        squares.append(square)\n        current_base += 1\n\n    return squares"}
{"task_id": "Mbpp/591", "solution": "def swap_List(input_list: list) -> list:\n    \"\"\"\n    Interchanges the first and last elements in a list, returning a new list.\n    The original list remains unchanged.\n    \"\"\"\n    if len(input_list) < 2:\n        return list(input_list) # Return a copy for immutability even if no swap occurs\n    \n    first_element = input_list[0]\n    last_element = input_list[-1]\n    \n    # Construct a new list with the swapped elements\n    # [last_element] + middle_elements + [first_element]\n    return [last_element] + input_list[1:-1] + [first_element]"}
{"task_id": "Mbpp/590", "solution": "import math\n\ndef polar_rect(radius: float, theta: float) -> tuple[tuple[float, float], complex]:\n    \"\"\"\n    Converts polar coordinates (radius, theta) to rectangular coordinates (x, y)\n    and returns both the rectangular coordinates and their complex number representation.\n    \"\"\"\n    x = radius * math.cos(theta)\n    y = radius * math.sin(theta)\n    return ((x, y), complex(x, y))"}
