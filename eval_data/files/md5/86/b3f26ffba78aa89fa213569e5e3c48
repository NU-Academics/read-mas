{"task_id": "Mbpp/223", "solution": "def is_majority(array: list[int], n: int, element: int) -> bool:\n    \"\"\"\n    Determines if the element is a majority element in the sorted array.\n    A majority element occurs more than n/2 times.\n    \"\"\"\n\n    def binary_search_left(arr: list[int], target: int) -> int:\n        \"\"\"\n        Finds the insertion point for the target in a sorted array,\n        such that all elements to the left are less than the target.\n        \"\"\"\n        low, high = 0, len(arr) - 1\n        ans = len(arr)\n        while low <= high:\n            mid = low + (high - low) // 2\n            if arr[mid] >= target:\n                ans = mid\n                high = mid - 1\n            else:\n                low = mid + 1\n        return ans\n\n    def binary_search_right(arr: list[int], target: int) -> int:\n        \"\"\"\n        Finds the insertion point for the target in a sorted array,\n        such that all elements to the left are less than or equal to the target.\n        \"\"\"\n        low, high = 0, len(arr) - 1\n        ans = -1\n        while low <= high:\n            mid = low + (high - low) // 2\n            if arr[mid] <= target:\n                ans = mid\n                low = mid + 1\n            else:\n                high = mid - 1\n        return ans\n\n    def find_first_occurrence(arr: list[int], target: int) -> int:\n        \"\"\"\n        Finds the index of the first occurrence of the target in a sorted array.\n        Returns -1 if the target is not found.\n        \"\"\"\n        idx = binary_search_left(arr, target)\n        if idx < len(arr) and arr[idx] == target:\n            return idx\n        return -1\n\n    def find_last_occurrence(arr: list[int], target: int) -> int:\n        \"\"\"\n        Finds the index of the last occurrence of the target in a sorted array.\n        Returns -1 if the target is not found.\n        \"\"\"\n        idx = binary_search_right(arr, target)\n        if idx >= 0 and arr[idx] == target:\n            return idx\n        return -1\n\n    if n == 0:\n        return False\n\n    first_index = find_first_occurrence(array, element)\n    if first_index == -1:\n        return False\n\n    last_index = find_last_occurrence(array, element)\n    \n    count = last_index - first_index + 1\n    return count > n / 2"}
{"task_id": "Mbpp/232", "solution": "from typing import List\n\ndef get_unique_sorted(input_list: List[int]) -> List[int]:\n    \"\"\"\n    Extracts unique values from a list and sorts them in descending order.\n    \"\"\"\n    unique_elements = list(set(input_list))\n    unique_elements.sort(reverse=True)\n    return unique_elements\n\ndef larg_nnum(input_list: List[int], n: int) -> List[int]:\n    \"\"\"\n    Returns a list containing the n largest unique items from the input list.\n    \"\"\"\n    unique_sorted_list = get_unique_sorted(input_list)\n    return unique_sorted_list[:n]"}
