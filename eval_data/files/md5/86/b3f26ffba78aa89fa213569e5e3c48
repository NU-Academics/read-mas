{"task_id": "Mbpp/558", "solution": "import itertools\n\ndef digit_distance_nums(num1: int, num2: int) -> int:\n    \"\"\"\n    Calculate sum of per-digit differences between two integers.\n    Missing digits are treated as zero.\n    \"\"\"\n    str_num1 = str(num1)\n    str_num2 = str(num2)\n\n    # Reverse strings to align digits from the units place up\n    rev_str_num1 = str_num1[::-1]\n    rev_str_num2 = str_num2[::-1]\n\n    total_distance = 0\n    # Use zip_longest to iterate over digits, padding the shorter number with '0'\n    for digit1_char, digit2_char in itertools.zip_longest(rev_str_num1, rev_str_num2, fillvalue='0'):\n        digit1 = int(digit1_char)\n        digit2 = int(digit2_char)\n        total_distance += abs(digit1 - digit2)\n\n    return total_distance"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(array, size):\n    \"\"\"\n    Counts the number of pairs in an array whose XOR value is odd.\n    An XOR result is odd if and only if one operand is even and the other is odd.\n    \"\"\"\n    odd_count = 0\n    even_count = 0\n\n    for x in array:\n        if x % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    # An XOR value is odd if one number is odd and the other is even.\n    # The number of such pairs is odd_count * even_count.\n    return odd_count * even_count"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input_str: str) -> str:\n    \"\"\"Toggles the case of all alphabetic characters in a string.\"\"\"\n    toggled_chars = []\n    for char in input_str:\n        if 'a' <= char <= 'z':\n            toggled_chars.append(chr(ord(char) - 32))  # Convert to uppercase\n        elif 'A' <= char <= 'Z':\n            toggled_chars.append(chr(ord(char) + 32))  # Convert to lowercase\n        else:\n            toggled_chars.append(char)  # Keep non-alphabetic characters as is\n    return \"\".join(toggled_chars)"}
