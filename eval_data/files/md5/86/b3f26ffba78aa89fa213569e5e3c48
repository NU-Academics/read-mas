{"task_id": "Mbpp/804", "solution": "import math\nfrom typing import List\n\ndef is_product_even(numbers: List[int]) -> bool:\n    \"\"\"\n    Check whether the product of numbers in a list is even.\n    Returns True if product is even, False if odd.\n    \"\"\"\n    if not numbers:\n        # Per business rules, empty list product implicitly handles as True (even).\n        return True\n\n    product = 1\n    for num in numbers:\n        if num == 0:\n            return True  # If any number is 0, the product is 0, which is even.\n        product *= num\n    \n    return product % 2 == 0"}
{"task_id": "Mbpp/805", "solution": "from typing import List\n\ndef max_sum_list(list_of_lists: List[List[int]]) -> List[int]:\n    \"\"\"\n    Returns the list with the highest sum of elements from a list of lists.\n    The first list with the maximum sum is returned in case of a tie.\n    \"\"\"\n    return max(list_of_lists, key=sum)"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(s: str) -> int:\n    \"\"\"\n    Finds the maximum run of consecutive uppercase characters in a string.\n    Returns 0 for empty strings or strings with no uppercase characters.\n    \"\"\"\n    max_run = 0\n    current_run = 0\n    for char in s:\n        if 'A' <= char <= 'Z':  # Check if char is an ASCII uppercase letter\n            current_run += 1\n        else:\n            current_run = 0\n        max_run = max(max_run, current_run)\n    return max_run"}
{"task_id": "Mbpp/808", "solution": "def check_K(input_tuple: tuple, k: int) -> bool:\n    \"\"\"\n    Checks if the given integer k is present in the input tuple.\n    Performs a linear search to find the value k within the tuple.\n    \"\"\"\n    return k in input_tuple"}
{"task_id": "Mbpp/809", "solution": "def check_smaller(tuple1: tuple, tuple2: tuple) -> bool:\n    \"\"\"\n    Checks if each element of the second tuple is smaller than its corresponding element in the first tuple.\n    Assumes tuples are of equal length and contain numeric data types.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        # Per design, assume equal length, but a pragmatic check is harmless.\n        # This case is not explicitly handled by returning True/False in requirements,\n        # but is an invalid input state described in the design (ValidationError).\n        # However, as per instructions, do not raise exceptions for edge cases.\n        # Returning False is a reasonable default for \"not all elements smaller\".\n        return False\n\n    for i in range(len(tuple1)):\n        if tuple2[i] >= tuple1[i]:\n            return False\n    return True"}
