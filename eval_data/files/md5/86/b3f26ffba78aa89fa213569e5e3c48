{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(arr: list[int], length: int) -> int:\n    def validate_input(arr_param: list[int], length_param: int) -> bool:\n        # Validates if the given length matches the actual array length and is non-negative.\n        return length_param == len(arr_param) and length_param >= 0\n\n    def kadane_algorithm(arr_param: list[int]) -> int:\n        # Implements Kadane's algorithm to find the maximum sum of a contiguous subarray.\n        # Assumes arr_param is a non-empty list of integers.\n        max_so_far = arr_param[0]\n        current_max = arr_param[0]\n\n        for i in range(1, len(arr_param)):\n            current_max = max(arr_param[i], current_max + arr_param[i])\n            max_so_far = max(max_so_far, current_max)\n        return max_so_far\n\n    if not validate_input(arr, length):\n        raise ValueError(\"Invalid input: list length does not match provided length, or length is negative.\")\n\n    if length == 0:\n        return 0\n\n    return kadane_algorithm(arr)"}
{"task_id": "Mbpp/566", "solution": "def sum_digits(number: int) -> int:\n    \"\"\"\n    Calculate the sum of all digits in a non-negative integer.\n    The sum is computed by repeatedly taking the number modulo 10 and dividing by 10.\n    \"\"\"\n    if number < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n\n    if number == 0:\n        return 0\n\n    digit_sum = 0\n    while number > 0:\n        digit_sum += number % 10\n        number //= 10\n    return digit_sum"}
