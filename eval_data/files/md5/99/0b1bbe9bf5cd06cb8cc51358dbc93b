ave a fixed capacity.\n    \"\"\"\n    total_lowerings = 0\n\n    for well_row in grid:\n        water_units = _calculate_water_units_in_well(well_row)\n        lowerings_for_this_well = _calculate_lowerings_per_well(water_units, capacity)\n        total_lowerings += lowerings_for_this_well\n\n    return total_lowerings```\n", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/118": [{"task_id": "HumanEval/118", "solution": "def _is_vowel(char: str) -> bool:\n    \"\"\"Checks if a character is a vowel (case-insensitive).\"\"\"\n    return char.lower() in ('a', 'e', 'i', 'o', 'u')\n\ndef _is_consonant(char: str) -> bool:\n    \"\"\"Checks if a character is a consonant (English letter, not a vowel).\"\"\"\n    return char.isalpha() and not _is_vowel(char)\n\ndef get_closest_vowel(word: str) -> str:\n    \"\"\"Finds the closest vowel from the right that is surrounded by two consonants.\n    Returns the found vowel or an empty string if no such vowel exists.\n    \"\"\"\n    # Words shorter than 3 characters cannot have a vowel between two neighbors.\n    if len(word) < 3:\n        return \"\"\n\n    # Iterate from the second-to-last character down to the second character (index 1).\n    for i in range(len(word) - 2, 0, -1):\n        current_char = word[i]\n\n        # Check if the current character is a vowel.\n        if _is_vowel(current_char):\n            left_char = word[i - 1]\n            right_char = word[i + 1]\n\n            # Verify that its immediate left and right neighbors are both consonants.\n            if _is_consonant(left_char) and _is_consonant(right_char):\n                return current_char  # Return the first vowel found that meets the conditions.\n\n    return \"\" # Return an empty string if no suitable vowel is found.", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/118", "solution": "```python\ndef get_closest_vowel(word):\n    \"\"\"Finds the closest vowel from the right, surrounded by two consonants (case-sensitive).\n    Excludes vowels at word boundaries; returns empty string if none found.\n    \"\"\"\n\n    def _is_vowel(char):\n        \"\"\"Checks if a character is an English vowel (case-sensitive).\"\"\"\n        return char in {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n\n    def _is_consonant(char):\n        \"\"\"Checks if a character is an English consonant (case-sensitive).\"\"\"\n        return char.isalpha() and not _is_vowel(char)\n\n    # Iterate from the second-to-last character down to the second character.\n    # This range excludes the first (index 0) and last (index len-1) characters.\n    for i in range(len(word) - 2, 0, -1):\n        current_char = word[i]\n        prev_char = word[i-1]\n        next_char = word[i+1]\n\n        if _is_vowel(current_char):\n            if _is_consonant(prev_char) and _is_consonant(next_char):\n                return current_char\n\n    return \"\"\n```", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/119": [{"task_id": "HumanEval/119", "solution": "```python\ndef is_balanced(s: str) -> bool:\n    \"\"\"\n    Checks if a string has balanced parentheses.\n    Balance counter must never drop below zero and be zero at the end.\n    \"\"\"\n    balance = 0\n    for char in s:\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n        if balance < 0:\n            return False\n    return balance == 0\n\ndef match_parens(lst: list[str]) -> str:\n    \"\"\"\n    Determines if two parenthesis strings can be concatenated to form a good (balanced) string.\n    Checks both concatenation orders and returns 'Yes' or 'No'.\n    \"\"\"\n    str1, str2 = lst[0], lst[1]\n\n    # Check the first concatenation order: str1 + str2\n    if is_balanced(str1 + str2):\n        return 'Yes'\n\n    # Check the second concatenation or