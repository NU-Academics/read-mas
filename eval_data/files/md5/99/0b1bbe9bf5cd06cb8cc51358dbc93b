t.\"\"\"\n            self.elements.append(element)\n\n        def remove(self, element: int):\n            \"\"\"Removes the first occurrence of a specific integer from the list.\"\"\"\n            self.elements.remove(element)\n\n        def get_minimum(self) -> int:\n            \"\"\"Returns the minimum integer in the list.\"\"\"\n            return min(self.elements)\n\n        def get_maximum(self) -> int:\n            \"\"\"Returns the maximum integer in the list.\"\"\"\n            return max(self.elements)\n\n        def is_empty(self) -> bool:\n            \"\"\"Checks if the list is empty.\"\"\"\n            return not self.elements\n\n        def size(self) -> int:\n            \"\"\"Returns the number of elements in the list.\"\"\"\n            return len(self.elements)\n\n        def to_list(self) -> list[int]:\n            \"\"\"Converts the internal representation to a standard Python list.\"\"\"\n            return list(self.elements)\n\n    input_integer_list = IntegerList(lst)\n    output_integer_list = IntegerList()\n\n    turn_min = True\n    while not input_integer_list.is_empty():\n        if turn_min:\n            val_to_add = input_integer_list.get_minimum()\n        else:\n            val_to_add = input_integer_list.get_maximum()\n\n        input_integer_list.remove(val_to_add)\n        output_integer_list.add(val_to_add)\n\n        turn_min = not turn_min\n\n    return output_integer_list.to_list()\n```", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/71": [{"task_id": "HumanEval/71", "solution": "import math\n\ndef triangle_area(a: float, b: float, c: float) -> float:\n    \"\"\"\n    Given three side lengths, calculate the area of a valid triangle using Heron's formula.\n    Returns -1 if the side lengths do not form a geometrically valid triangle.\n    \"\"\"\n    if not (a > 0 and b > 0 and c > 0):\n        return -1\n    if not (a + b > c and a + c > b and b + c > a):\n        