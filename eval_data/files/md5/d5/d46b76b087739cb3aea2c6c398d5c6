{"task_id": "Mbpp/252", "solution": "import math\nimport cmath\nfrom typing import Tuple, Union\n\nclass ComplexNumber:\n    \"\"\"Represents a complex number with real and imaginary parts.\"\"\"\n    def __init__(self, real: float, imag: float) -> None:\n        self.real = real\n        self.imag = imag\n\n    def magnitude(self) -> float:\n        \"\"\"Calculates the magnitude (absolute value) of the complex number.\"\"\"\n        return abs(complex(self.real, self.imag))\n\n    def phase(self) -> float:\n        \"\"\"Calculates the phase angle (argument) of the complex number in radians.\"\"\"\n        return cmath.phase(complex(self.real, self.imag))\n\nclass PolarCoordinate:\n    \"\"\"Represents polar coordinates with magnitude (r) and angle (theta).\"\"\"\n    def __init__(self, r: float, theta: float) -> None:\n        self.r = r\n        self.theta = theta\n\nclass ConvertFunction:\n    \"\"\"Encapsulates the logic for converting numbers to polar coordinates.\"\"\"\n    def validate_input(self, value: object) -> bool:\n        \"\"\"Checks if the input value is a supported type (complex, int, or float).\"\"\"\n        return isinstance(value, (complex, int, float))\n\n    def _normalize_input(self, value: Union[complex, int, float]) -> ComplexNumber:\n        \"\"\"Normalizes an input value to a ComplexNumber instance.\"\"\"\n        if isinstance(value, complex):\n            return ComplexNumber(value.real, value.imag)\n        else:  # int or float\n            return ComplexNumber(float(value), 0.0)\n\n    def convert(self, value: Union[complex, int, float]) -> Tuple[float, float]:\n        \"\"\"Converts a complex, int, or float number to polar coordinates (r, theta).\"\"\"\n        if not self.validate_input(value):\n            raise TypeError(\"convert: unsupported input type; expected complex, int, or float\")\n\n        normalized_complex = self._normalize_input(value)\n        r = normalized_complex.magnitude()\n        theta = normalized_complex.phase()\n        return (r, theta)\n\ndef convert(value: Union[complex, int, float]) -> Tuple[float, float]:\n    \"\"\"Converts a complex, int, or float number to its polar coordinates (r, theta).\"\"\"\n    return ConvertFunction().convert(value)"}
{"task_id": "Mbpp/256", "solution": "class InputParameter:\n    \"\"\"\n    Encapsulates input value and provides validation of numeric type and non-negativity.\n    \"\"\"\n    def __init__(self, n):\n        self.n = n\n\n    def is_non_negative(self) -> bool:\n        \"\"\"Checks if the encapsulated number is non-negative.\"\"\"\n        return self.n >= 0\n\n    def as_int_floor(self) -> int:\n        \"\"\"Returns the floor of the encapsulated number as an integer.\"\"\"\n        return int(self.n)\n\n\nclass SieveEngine:\n    \"\"\"\n    Efficiently generates primes up to a given limit using the Sieve of Eratosthenes.\n    \"\"\"\n    @staticmethod\n    def generate_primes(limit: int) -> list:\n        \"\"\"\n        Generates a list of prime numbers strictly less than the given limit.\n        \"\"\"\n        if limit <= 2:\n            return []\n\n        is_prime = [True] * limit\n        is_prime[0] = is_prime[1] = False  # 0 and 1 are not prime numbers\n\n        p = 2\n        while (p * p < limit):\n            if is_prime[p]:\n                # Update all multiples of p starting from p*p\n                for i in range(p * p, limit, p):\n                    is_prime[i] = False\n            p += 1\n\n        primes = [i for i, prime in enumerate(is_prime) if prime]\n        return primes\n\n\ndef _validate_numeric(n) -> None:\n    \"\"\"\n    Internal helper to check that n is numeric (int or float) and raise TypeError if not.\n    \"\"\"\n    if not isinstance(n, (int, float)):\n        raise TypeError(\"Input must be a numeric value (int or float).\")\n\n\ndef count_Primes_nums(n) -> int:\n    \"\"\"\n    Takes in a non-negative number and returns the number of prime numbers less than it.\n    \"\"\"\n    _validate_numeric(n)\n\n    param = InputParameter(n)\n\n    if not param.is_non_negative():\n        raise ValueError(\"Input number must be non-negative.\")\n\n    limit = param.as_int_floor()\n\n    if limit <= 2:\n        return 0\n\n    primes = SieveEngine.generate_primes(limit)\n    return len(primes)"}
