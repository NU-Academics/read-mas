{"task_id": "Mbpp/440", "solution": "import re\n\nclass Sentence:\n    \"\"\"Represents a sentence with its text.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\n    def __len__(self) -> int:\n        return len(self.text)\n\nclass Token:\n    \"\"\"Represents a token with its raw text, original indices, and stripped text/indices.\"\"\"\n    def __init__(self, raw_text: str, start_index: int, end_index: int):\n        self.raw_text = raw_text\n        self.start_index = start_index\n        self.end_index = end_index\n        self.stripped_text = \"\"\n        self.stripped_start = None\n        self.stripped_end = None\n\n    def compute_stripped(self):\n        \"\"\"Computes and sets the letters-only stripped text and its indices.\"\"\"\n        self.stripped_text, self.stripped_start, self.stripped_end = strip_surrounding_nonletters(\n            self.raw_text, self.start_index, self.end_index\n        )\n\nclass AdverbMatch:\n    \"\"\"Represents a found adverb with its original indices and lowercased text.\"\"\"\n    def __init__(self, start_index: int, end_index: int, adverb: str):\n        self.start_index = start_index\n        self.end_index = end_index\n        self.adverb = adverb\n\n    def as_tuple(self) -> tuple:\n        \"\"\"Returns the adverb match as a 3-tuple.\"\"\"\n        return (self.start_index, self.end_index, self.adverb)\n\ndef tokenize_with_indices(sentence: str) -> list[Token]:\n    \"\"\"Splits a sentence into tokens based on whitespace, preserving original indices.\"\"\"\n    tokens = []\n    current_index = 0\n    for match in re.finditer(r'\\S+', sentence):\n        raw_text = match.group(0)\n        start_index = match.start(0)\n        end_index = match.end(0)\n        tokens.append(Token(raw_text, start_index, end_index))\n        current_index = end_index\n    return tokens\n\ndef strip_surrounding_nonletters(token_raw: str, token_start: int, token_end: int) -> tuple[str, int | None, int | None]:\n    \"\"\"Strips non-letter characters from the start and end of a token, returning the stripped text and its original indices.\"\"\"\n    if not token_raw:\n        return \"\", None, None\n\n    start_offset = 0\n    for char in token_raw:\n        if char.isalpha():\n            break\n        start_offset += 1\n    else:  # No letters found\n        return \"\", None, None\n\n    end_offset = len(token_raw)\n    for i in range(len(token_raw) - 1, -1, -1):\n        if token_raw[i].isalpha():\n            break\n        end_offset -= 1\n\n    stripped_text = token_raw[start_offset:end_offset]\n    stripped_start = token_start + start_offset\n    stripped_end = token_start + end_offset\n    return stripped_text, stripped_start, stripped_end\n\ndef find_adverb_position(sentence: str) -> tuple[int, int, str] | None:\n    \"\"\"Finds the first adverb and its position in a given sentence.\"\"\"\n    if not isinstance(sentence, str):\n        raise TypeError(\"Input 'sentence' must be a string.\")\n\n    tokens = tokenize_with_indices(sentence)\n\n    for token in tokens:\n        token.compute_stripped() # This computes stripped_text, stripped_start, stripped_end\n        \n        stripped_text = token.stripped_text\n        stripped_start = token.stripped_start\n        stripped_end = token.stripped_end\n\n        if stripped_text and stripped_text.lower().endswith('ly'):\n            adverb_match = AdverbMatch(stripped_start, stripped_end, stripped_text.lower())\n            return adverb_match.as_tuple()\n\n    return None"}
{"task_id": "Mbpp/446", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass TupleSequence:\n    \"\"\"Represents an input tuple for processing.\"\"\"\n    items: tuple\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the tuple.\"\"\"\n        return len(self.items)\n\n    def count(self, item) -> int:\n        \"\"\"Counts occurrences of a specific item in the tuple.\"\"\"\n        return self.items.count(item)\n\n@dataclass\nclass ElementList:\n    \"\"\"Represents a list of elements for matching, using a cached set for efficient lookups.\"\"\"\n    elements: list\n    _elements_set: set = field(init=False, repr=False)\n\n    def __post_init__(self):\n        \"\"\"Initializes the cached set for O(1) membership checks.\"\"\"\n        self._elements_set = set(self.elements)\n\n    def contains(self, item) -> bool:\n        \"\"\"Checks if an item is present in the element list.\"\"\"\n        return item in self._elements_set\n\n@dataclass\nclass CountResult:\n    \"\"\"Encapsulates the total count result.\"\"\"\n    total: int\n\ndef count_Occurrence(input_tuple: tuple, elements_list: list) -> int:\n    \"\"\"\n    Counts the total occurrences of any elements from elements_list within input_tuple.\n    Each appearance in the tuple is counted separately.\n    \"\"\"\n    total_occurrence_count = 0\n    tuple_sequence = TupleSequence(input_tuple)\n    element_matcher = ElementList(elements_list)\n\n    for item in tuple_sequence.items:\n        if element_matcher.contains(item):\n            total_occurrence_count += 1\n\n    result = CountResult(total_occurrence_count)\n    return result.total"}
{"task_id": "Mbpp/445", "solution": "def index_multiplication(a: tuple, b: tuple) -> tuple:\n    \"\"\"Return a tuple-of-tuples where result[i][j] == a[i][j] * b[i][j].\n\n    Raises:\n        ValueError: if outer tuple lengths differ or if any corresponding inner tuple lengths differ.\n    \"\"\"\n    if len(a) != len(b):\n        raise ValueError(\"outer tuple lengths differ\")\n\n    if len(a) == 0:\n        return ()\n\n    collected_inner_tuples = []\n    for i in range(len(a)):\n        if len(a[i]) != len(b[i]):\n            raise ValueError(f\"inner tuple lengths differ at index {i}\")\n\n        inner_products = tuple(a[i][j] * b[i][j] for j in range(len(a[i])))\n        collected_inner_tuples.append(inner_products)\n\n    return tuple(collected_inner_tuples)"}
{"task_id": "Mbpp/447", "solution": "from typing import Sequence, List, Union\n\nclass Number:\n    \"\"\"Encapsulates a numeric value and computes its cube.\"\"\"\n    def __init__(self, value: Union[int, float]) -> None:\n        self._value = value\n\n    def cube(self) -> Union[int, float]:\n        \"\"\"Computes the cube of the stored numeric value.\"\"\"\n        return self._value ** 3\n\nclass InputList:\n    \"\"\"Wraps and exposes caller-provided input sequence.\"\"\"\n    def __init__(self, elements: Sequence) -> None:\n        self._elements = elements\n        \n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the input.\"\"\"\n        return len(self._elements)\n\n    def elements(self) -> Sequence:\n        \"\"\"Returns the raw input elements.\"\"\"\n        return self._elements\n\nclass OutputList:\n    \"\"\"Collects numeric results and converts to a plain Python list for return.\"\"\"\n    def __init__(self) -> None:\n        self._elements: List[Union[int, float]] = []\n\n    def append(self, value: Union[int, float]) -> None:\n        \"\"\"Appends a cubed value to the output list.\"\"\"\n        self._elements.append(value)\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements collected.\"\"\"\n        return len(self._elements)\n\n    def to_list(self) -> List[Union[int, float]]:\n        \"\"\"Converts the collected elements to a plain Python list.\"\"\"\n        return self._elements\n\nclass CubeFunction:\n    \"\"\"Encapsulates validation and computation logic for cubing numbers.\"\"\"\n    def cube_nums(self, inputList: 'InputList') -> 'OutputList':\n        \"\"\"Validates input, computes cubes for each element, and returns an OutputList.\"\"\"\n        self.validateInput(inputList)\n\n        output_list = OutputList()\n        if inputList.length() == 0:\n            return output_list\n\n        for value in inputList.elements():\n            num_obj = Number(value)\n            output_list.append(num_obj.cube())\n        \n        return output_list\n\n    def validateInput(self, inputList: 'InputList') -> bool:\n        \"\"\"\n        Checks if the input is a sequence and all elements are numeric.\n        Raises TypeError or ValueError on violation.\n        \"\"\"\n        if not isinstance(inputList.elements(), Sequence):\n            raise TypeError(\"Input must be a list or sequence.\")\n        \n        for element in inputList.elements():\n            if not isinstance(element, (int, float)):\n                raise ValueError(\"All elements in the input list must be numeric (int or float).\")\n        \n        return True\n\ndef cube_nums(input_list: Sequence) -> List[Union[int, float]]:\n    \"\"\"\n    Finds cubes of individual elements in a list.\n\n    The function validates the input, computes element-wise cubes, and returns\n    a new list with the results.\n    \"\"\"\n    input_list_obj = InputList(input_list)\n    cube_func = CubeFunction()\n    output_list_obj = cube_func.cube_nums(input_list_obj)\n    return output_list_obj.to_list()"}
