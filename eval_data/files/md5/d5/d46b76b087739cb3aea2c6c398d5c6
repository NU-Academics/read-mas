{"task_id": "Mbpp/392", "solution": "class GetMaxSum:\n    \"\"\"Manages the recurrence computation, including memoization and input validation.\"\"\"\n    def __init__(self):\n        self._cache = {}\n\n    def _get_or_compute(self, n: int) -> int:\n        \"\"\"Retrieves value from cache or computes it, validating input.\"\"\"\n        if n < 0:\n            raise ValueError(\"n must be non-negative\")\n        if n in self._cache:\n            return self._cache[n]\n        \n        value = self._compute_recurrence(n)\n        self._cache[n] = value\n        return value\n\n    def _compute_recurrence(self, n: int) -> int:\n        \"\"\"Implements the f(n) recurrence relation with base case f(0)=0.\"\"\"\n        if n == 0:\n            return 0\n\n        v2 = self._get_or_compute(n // 2)\n        v3 = self._get_or_compute(n // 3)\n        v4 = self._get_or_compute(n // 4)\n        v5 = self._get_or_compute(n // 5)\n\n        total_subproblems_sum = v2 + v3 + v4 + v5\n        return max(total_subproblems_sum, n)\n\n# A module-level instance of GetMaxSum to persist the cache across calls.\n_max_sum_engine = GetMaxSum()\n\ndef get_max_sum(n: int) -> int:\n    \"\"\"\n    Finds the maximum sum for n using the recurrence\n    f(n) = max(f(n//2) + f(n//3) + f(n//4) + f(n//5), n).\n    \"\"\"\n    return _max_sum_engine._get_or_compute(n)"}
{"task_id": "Mbpp/395", "solution": "from typing import Optional, Dict, List\n\nclass InputString:\n    \"\"\"Represents the input string for character processing.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n\n    def chars(self) -> list[str]:\n        \"\"\"Returns a list of individual characters from the string.\"\"\"\n        return list(self._value)\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the string.\"\"\"\n        return len(self._value)\n\nclass Character:\n    \"\"\"Represents a character with its codepoint and original index.\"\"\"\n    def __init__(self, codepoint: str, index: int):\n        self.codepoint = codepoint\n        self.index = index\n        self.count = 0\n\nclass FrequencyMap:\n    \"\"\"Manages the frequency count of characters.\"\"\"\n    def __init__(self):\n        self._map: Dict[str, int] = {}\n\n    def increment(self, ch: str) -> None:\n        \"\"\"Increments the count for a given character.\"\"\"\n        self._map[ch] = self._map.get(ch, 0) + 1\n\n    def get(self, ch: str) -> int:\n        \"\"\"Returns the frequency count of a character, or 0 if not found.\"\"\"\n        return self._map.get(ch, 0)\n\nclass Result:\n    \"\"\"Wraps the optional string result.\"\"\"\n    def __init__(self, value: Optional[str]):\n        self.value = value\n\n    def is_none(self) -> bool:\n        \"\"\"Checks if the wrapped result is None.\"\"\"\n        return self.value is None\n\ndef first_non_repeating_character(s: str) -> Optional[str]:\n    \"\"\"\n    Finds the first non-repeated character in a given string.\n    This function computes character frequencies and then scans the string in order.\n    \"\"\"\n    input_str = InputString(s)\n    freq_map = FrequencyMap()\n\n    # First pass: populate frequency map for all characters\n    for char in input_str.chars():\n        freq_map.increment(char)\n\n    # Second pass: find the first character in order with frequency 1\n    for char in input_str.chars():\n        if freq_map.get(char) == 1:\n            return char\n\n    return None"}
