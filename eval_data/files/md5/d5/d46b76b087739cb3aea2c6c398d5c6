{"task_id": "Mbpp/415", "solution": "class IntegerPair:\n    \"\"\"\n    A simple value object to hold two integers and compute their product.\n    \"\"\"\n    def __init__(self, first: int, second: int):\n        self.first = first\n        self.second = second\n\n    def product(self) -> int:\n        \"\"\"Returns the product of the two integers in the pair.\"\"\"\n        return self.first * self.second\n\n    def as_ordered_tuple(self) -> tuple[int, int]:\n        \"\"\"Returns the pair as a tuple (smaller, larger).\"\"\"\n        return (min(self.first, self.second), max(self.first, self.second))\n\ndef _compute_candidates(values: list[int]) -> tuple[IntegerPair, IntegerPair]:\n    \"\"\"\n    Computes two candidate IntegerPair objects for the maximum product:\n    one from the two smallest and one from the two largest values.\n    \"\"\"\n    sorted_values = sorted(values)\n    \n    # Identify the two smallest values\n    min1 = sorted_values[0]\n    min2 = sorted_values[1]\n    \n    # Identify the two largest values\n    max1 = sorted_values[-1]\n    max2 = sorted_values[-2]\n\n    pair_from_smallest = IntegerPair(min1, min2)\n    pair_from_largest = IntegerPair(max1, max2)\n\n    return pair_from_smallest, pair_from_largest\n\ndef _order_pair(pair: IntegerPair) -> tuple[int, int]:\n    \"\"\"\n    Returns an ordered tuple (smaller, larger) from an IntegerPair instance.\n    \"\"\"\n    return pair.as_ordered_tuple()\n\ndef max_Product(input_list: list[int]) -> tuple[int, int]:\n    \"\"\"\n    Finds a pair with the highest product from a given array of integers.\n    The function returns the pair as a tuple (smaller, larger).\n    \"\"\"\n    if len(input_list) < 2:\n        raise ValueError(\"Input list must contain at least two integers.\")\n\n    candidate1, candidate2 = _compute_candidates(input_list)\n\n    selected_pair = None\n\n    prod1 = candidate1.product()\n    prod2 = candidate2.product()\n\n    if prod1 > prod2:\n        selected_pair = candidate1\n    elif prod2 > prod1:\n        selected_pair = candidate2\n    else: # Products are equal, apply tie-breaking rule: prefer higher max element\n        max_elem1 = max(candidate1.first, candidate1.second)\n        max_elem2 = max(candidate2.first, candidate2.second)\n        if max_elem1 > max_elem2:\n            selected_pair = candidate1\n        elif max_elem2 > max_elem1:\n            selected_pair = candidate2\n        else: # Still tied, prefer the candidate encountered first (candidate1)\n            selected_pair = candidate1\n            \n    return _order_pair(selected_pair)"}
{"task_id": "Mbpp/420", "solution": "def cube_Sum(n: int) -> int:\n    \"\"\"\n    Finds the cube sum of the first n even natural numbers.\n    Raises TypeError if n is not an integer or ValueError if n is negative.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    if n == 0:\n        return 0\n\n    total_sum = 0\n    for k in range(1, n + 1):\n        total_sum += (2 * k) ** 3\n    return total_sum"}
{"task_id": "Mbpp/419", "solution": "import math\nfrom typing import List\n\nclass Number:\n    \"\"\"Encapsulates a numeric value and its rounded integer form.\"\"\"\n    def __init__(self, value: float):\n        self.value = float(value)\n        self.roundedValue: int = 0\n\n    def round(self) -> int:\n        \"\"\"\n        Rounds the number using standard arithmetic rounding where fractional part 0.5 rounds up.\n        Negative halves round towards positive infinity (e.g., -1.5 -> -1).\n        \"\"\"\n        self.roundedValue = int(math.floor(self.value + 0.5))\n        return self.roundedValue\n\nclass NumberList:\n    \"\"\"A collection of Number objects with methods to sum their rounded values.\"\"\"\n    def __init__(self, raw_numbers: List[float]):\n        if not isinstance(raw_numbers, list):\n            raise TypeError(\"Input 'numbers' must be a list.\")\n        \n        self.items: List[Number] = []\n        for num in raw_numbers:\n            if not isinstance(num, (int, float)):\n                raise TypeError(f\"List elements must be numeric, got {type(num)}.\")\n            self.items.append(Number(num))\n        self.length = len(self.items)\n\n    def sumRounded(self) -> int:\n        \"\"\"Sums the rounded values of all numbers in the list.\"\"\"\n        total_sum = 0\n        for item in self.items:\n            total_sum += item.round()\n        return total_sum\n\nclass Result:\n    \"\"\"Holds the intermediate sum and the final computed value, and provides a method to print.\"\"\"\n    def __init__(self, sum_value: int, final_value: int):\n        self.sum = sum_value\n        self.finalValue = final_value\n\n    def print(self) -> None:\n        \"\"\"Prints the final computed integer value to standard output.\"\"\"\n        print(self.finalValue)\n\nclass RoundAndSumFunction:\n    \"\"\"Orchestrates the rounding, summing, and multiplication logic.\"\"\"\n    def round_and_sum(self, number_list: NumberList) -> int:\n        \"\"\"Orchestrates rounding, summing, multiplying by list length, printing, and returning the final value.\"\"\"\n        sum_of_rounded = number_list.sumRounded()\n        final_value = sum_of_rounded * number_list.length\n        \n        result = Result(sum_of_rounded, final_value)\n        result.print()\n        return final_value\n\ndef round_and_sum(numbers: List[float]) -> int:\n    \"\"\"Rounds every number in a list, sums them, multiplies by list length, prints, and returns the result.\"\"\"\n    number_list = NumberList(numbers)\n    function_orchestrator = RoundAndSumFunction()\n    return function_orchestrator.round_and_sum(number_list)"}
