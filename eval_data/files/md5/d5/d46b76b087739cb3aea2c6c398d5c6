{"task_id": "Mbpp/103", "solution": "import functools\n\nclass Validator:\n    \"\"\"Validates input domain constraints.\"\"\"\n    def is_valid(self, n: int, m: int) -> bool:\n        \"\"\"Returns True if n >= 1 and 0 <= m < n, otherwise False.\"\"\"\n        return n >= 1 and 0 <= m < n\n\nclass EulerianResult:\n    \"\"\"Lightweight value object holding computed integer result.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass EulerianFunction:\n    \"\"\"Encapsulates Eulerian number computation following recurrence.\"\"\"\n    \n    @functools.lru_cache(None) # Using functools.lru_cache for memoization\n    def _compute_recursive(self, n: int, m: int) -> int:\n        \"\"\"\n        Computes the Eulerian number a(n, m) using recurrence.\n        Base case: a(1,0) = 1.\n        Recurrence: a(n,m) = (m+1)*a(n-1,m) + (n-m)*a(n-1,m-1).\n        \"\"\"\n        if n == 1 and m == 0:\n            return 1\n        if m < 0 or m >= n:\n            return 0 # Defined as 0 outside the primary range\n\n        term1 = (m + 1) * self._compute_recursive(n - 1, m)\n        term2 = (n - m) * self._compute_recursive(n - 1, m - 1)\n        return term1 + term2\n\n    def eulerian_num(self, n: int, m: int) -> int:\n        \"\"\"Computes and returns the Eulerian number a(n, m).\"\"\"\n        result = self._compute_recursive(n, m)\n        return EulerianResult(result).value\n\ndef eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Public API: Validates inputs and returns the Eulerian number a(n, m).\n    Raises ValueError for invalid inputs (n < 1 or m < 0 or m >= n).\n    \"\"\"\n    validator = Validator()\n    if not validator.is_valid(n, m):\n        raise ValueError(f\"Invalid input: n must be >= 1 and 0 <= m < n. Got n={n}, m={m}\")\n    \n    eulerian_func = EulerianFunction()\n    return eulerian_func.eulerian_num(n, m)"}
{"task_id": "Mbpp/105", "solution": "def count(list: list) -> int:\n    \"\"\"Return number of elements strictly equal to boolean True.\"\"\"\n    counter: int = 0\n    for element in list:\n        if element is True:\n            counter += 1\n    return counter"}
{"task_id": "Mbpp/104", "solution": "def sort_sublists(input):\n    \"\"\"Accept an outer collection (tuple or list) of sublists (each containing strings) and return a list of sublists where each inner sublist is sorted lexicographically ascending.\n    The output is a list-of-lists, preserving outer order and the multiset of elements per sublist.\n    \"\"\"\n    sorted_outer_list = []\n    for sublist in input:\n        sorted_inner_list = sorted(sublist)\n        sorted_outer_list.append(sorted_inner_list)\n    return sorted_outer_list"}
{"task_id": "Mbpp/106", "solution": "def validate_types(list_arg, tuple_arg):\n    \"\"\"Validate that list_arg is a list and tuple_arg is a tuple.\n    Raises TypeError with an informative message if validation fails.\n    \"\"\"\n    if not isinstance(list_arg, list):\n        raise TypeError(\"list_arg must be a list\")\n    if not isinstance(tuple_arg, tuple):\n        raise TypeError(\"tuple_arg must be a tuple\")\n    return None\n\ndef add_lists(list_arg, tuple_arg):\n    \"\"\"Return a tuple containing elements of tuple_arg followed by elements of list_arg.\n    Raises TypeError if input types do not match expectations (list_arg must be list, tuple_arg must be tuple).\n    \"\"\"\n    validate_types(list_arg, tuple_arg)\n    return tuple_arg + tuple(list_arg)"}
{"task_id": "Mbpp/113", "solution": "def check_integer(s: str) -> bool:\n    \"\"\"\n    Checks if a string represents an integer according to specified format.\n    The format accepts an optional leading '+' or '-' followed by one or more ASCII digits, with no surrounding whitespace.\n    \"\"\"\n    if not s:\n        return False\n\n    start_index = 0\n    if s[0] == '+' or s[0] == '-':\n        start_index = 1\n\n    # After handling the sign, there must be at least one digit.\n    # Also, ensure there are no other characters besides digits in the remainder.\n    if len(s[start_index:]) == 0:\n        return False\n\n    return s[start_index:].isdigit()"}
{"task_id": "Mbpp/108", "solution": "def merge_sorted_list(list1, list2, list3):\n    \"\"\"\n    Merges three input lists into a single sorted list.\n    Validates inputs, combines elements preserving duplicates, and sorts them in ascending order.\n    \"\"\"\n    def _validate_integer_list(lst, name):\n        \"\"\"Validates that a value is a list and that every element is an integer.\"\"\"\n        if not isinstance(lst, list):\n            raise TypeError(f\"{name} must be a list.\")\n        for element in lst:\n            if not isinstance(element, int):\n                raise TypeError(f\"Elements in {name} must be integers.\")\n\n    def _merge_three_lists(l1, l2, l3):\n        \"\"\"Concatenates three lists preserving duplicates and returns the combined list.\"\"\"\n        return l1 + l2 + l3\n\n    _validate_integer_list(list1, \"list1\")\n    _validate_integer_list(list2, \"list2\")\n    _validate_integer_list(list3, \"list3\")\n\n    combined = _merge_three_lists(list1, list2, list3)\n    return sorted(combined)"}
{"task_id": "Mbpp/111", "solution": "def common_in_nested_lists(nested_lists: list[list[int]]) -> list[int]:\n    \"\"\"Return a list of integers that appear in every inner list of nested_lists.\n\n    Behavior (implementation choice consistent with set semantics and SRS):\n    - If nested_lists is empty, returns an empty list.\n    - Duplicates within an inner list are treated as single membership (set semantics).\n    - Ordering of returned elements is not significant.\n    \"\"\"\n    if not nested_lists:\n        return []\n\n    # Initialize the common elements set with the elements of the first inner list\n    common_elements_set = set(nested_lists[0])\n\n    # Intersect with the elements of subsequent inner lists\n    for i in range(1, len(nested_lists)):\n        current_list_set = set(nested_lists[i])\n        common_elements_set = common_elements_set.intersection(current_list_set)\n\n    # Convert the final set of common elements to a list and return it\n    return list(common_elements_set)"}
{"task_id": "Mbpp/109", "solution": "class ValidationError(ValueError):\n    \"\"\"\n    Exception raised for invalid input parameters.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass Validator:\n    \"\"\"\n    Handles input validation for binary strings and rotation counts.\n    (Note: Validation logic is omitted per strict instructions to not add checks or exceptions for edge cases).\n    \"\"\"\n    def validate_binary_string(self, s: str) -> None:\n        # Per strict instruction: \"DO NOT add isinstance() checks or raise exceptions for edge cases\"\n        # The design specified raising ValidationError, but this constraint overrides it.\n        pass\n\n    def validate_rotations(self, r: int) -> None:\n        # Per strict instruction: \"DO NOT add isinstance() checks or raise exceptions for edge cases\"\n        pass\n\nclass RotationEngine:\n    \"\"\"\n    Provides utilities for rotating binary strings and computing effective rotation counts.\n    \"\"\"\n    def left_rotate(self, s: str, k: int = 1) -> str:\n        \"\"\"Left-rotates a string by k positions.\"\"\"\n        if not s:\n            return s\n        actual_k = k % len(s)\n        return s[actual_k:] + s[:actual_k]\n\n    def effective_rotations(self, rotations: int, length: int) -> int:\n        \"\"\"Computes the effective number of rotations modulo string length.\"\"\"\n        if length == 0:\n            return 0\n        return rotations % length\n\nclass Evaluator:\n    \"\"\"\n    Evaluates binary strings for oddness and counts odd variants over rotations.\n    \"\"\"\n    def is_odd(self, s: str) -> bool:\n        \"\"\"Determines if a binary string represents an odd number.\"\"\"\n        return s and s[-1] == '1'\n\n    def count_odd_variants(self, s: str, rotations: int, rotation_engine: RotationEngine) -> int:\n        \"\"\"\n        Counts odd variants from 1 up to 'rotations' left shifts of the binary string.\n        Optimized for large 'rotations' by considering cycles.\n        \"\"\"\n        if not s:\n            return 0\n\n        string_length = len(s)\n        \n        # Determine oddness for each of the 'string_length' distinct single left shifts\n        # (i.e., the string after 1 shift, 2 shifts, ..., string_length shifts)\n        odd_status_for_distinct_shifts = [False] * string_length\n        current_shifted_string = s\n        for i in range(string_length):\n            current_shifted_string = rotation_engine.left_rotate(current_shifted_string, 1)\n            if self.is_odd(current_shifted_string):\n                odd_status_for_distinct_shifts[i] = True\n\n        total_odd_count = 0\n        \n        # Sum odd counts for full cycles of rotations\n        num_full_cycles = rotations // string_length\n        total_odd_in_one_cycle = sum(1 for status in odd_status_for_distinct_shifts if status)\n        total_odd_count += num_full_cycles * total_odd_in_one_cycle\n\n        # Sum odd counts for remaining rotations\n        remaining_rotations = rotations % string_length\n        for i in range(remaining_rotations):\n            if odd_status_for_distinct_shifts[i]:\n                total_odd_count += 1\n        \n        return total_odd_count\n\ndef odd_Equivalent(binary_string: str, rotations: int) -> int:\n    \"\"\"\n    Finds the number of times a binary string, when rotated from 1 up to 'rotations' times,\n    represents an odd number.\n    \"\"\"\n    v = Validator()\n    v.validate_binary_string(binary_string)\n    v.validate_rotations(rotations)\n\n    re = RotationEngine()\n    ev = Evaluator()\n\n    return ev.count_odd_variants(binary_string, rotations, re)"}
{"task_id": "Mbpp/116", "solution": "from typing import Tuple\n\nclass Validator:\n    def validate_tuple(self, t):\n        \"\"\"Checks if the input is a tuple and raises TypeError if not.\"\"\"\n        if not isinstance(t, tuple):\n            raise TypeError(\"Input must be a tuple.\")\n\n    def validate_elements(self, t):\n        \"\"\"Checks if all tuple elements are positive integers and raises ValueError if not.\"\"\"\n        for i, e in enumerate(t):\n            if not isinstance(e, int):\n                raise ValueError(f\"Tuple element at index {i} must be an integer, got {type(e).__name__}.\")\n            if e <= 0:\n                raise ValueError(f\"Tuple element at index {i} must be a positive integer, got {e}.\")\n\nclass Converter:\n    def concatenate(self, elements: Tuple[int, ...]) -> int:\n        \"\"\"Converts a tuple of integers into a single integer by concatenating their string representations.\"\"\"\n        str_elements = [str(e) for e in elements]\n        concatenated_str = \"\".join(str_elements)\n        if not concatenated_str:\n            return 0\n        return int(concatenated_str)\n\ndef tuple_to_int(t: Tuple[int, ...]) -> int:\n    \"\"\"\n    Converts a tuple of positive integers into a single integer by concatenating their decimal representations.\n    Raises TypeError if input is not a tuple, or ValueError if elements are not positive integers.\n    \"\"\"\n    validator = Validator()\n    validator.validate_tuple(t)\n    validator.validate_elements(t)\n    converter = Converter()\n    result = converter.concatenate(t)\n    return result"}
