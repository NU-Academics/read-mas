{"task_id": "Mbpp/743", "solution": "def _validate_inputs(input_list, n):\n    \"\"\"\n    Placeholder for input validation. Per constraints, no explicit checks or exceptions are raised.\n    \"\"\"\n    pass\n\ndef _compute_effective_k(n, L):\n    \"\"\"\n    Computes the effective number of positions to rotate right.\n    Returns 0 if the list is empty.\n    \"\"\"\n    if L == 0:\n        return 0\n    return n % L\n\ndef _rotate_by_k(input_list, k):\n    \"\"\"\n    Returns a new list rotated right by k positions.\n    The original input list is not modified.\n    \"\"\"\n    L = len(input_list)\n    if L == 0 or k == 0:\n        return list(input_list)\n\n    # Slice the list into two parts and concatenate them in the rotated order.\n    return input_list[L - k:] + input_list[:L - k]\n\ndef rotate_right(input_list, n):\n    \"\"\"\n    Returns a new list rotated to the right by n positions.\n    The input list is not modified.\n    \"\"\"\n    _validate_inputs(input_list, n)\n\n    list_length = len(input_list)\n    effective_k = _compute_effective_k(n, list_length)\n\n    return _rotate_by_k(input_list, effective_k)"}
{"task_id": "Mbpp/742", "solution": "def area_tetrahedron(side_length):\n    \"\"\"\n    Calculates the surface area of a regular tetrahedron.\n    Uses the formula: Area = sqrt(3) * side_length^2.\n    \"\"\"\n    SQRT3 = 1.7320508075688772\n    return SQRT3 * side_length * side_length"}
{"task_id": "Mbpp/748", "solution": "def isUpper(c):\n    \"\"\"Checks if a character is uppercase.\"\"\"\n    return c.isupper()\n\ndef isLetter(c):\n    \"\"\"Checks if a character is a letter.\"\"\"\n    return c.isalpha()\n\ndef isBoundary(prev, curr, index):\n    \"\"\"Determines if a space should be inserted before the current character.\"\"\"\n    if index == 0:\n        return False\n    # A boundary occurs if the current character is uppercase AND the previous character is not uppercase.\n    return isUpper(curr) and not isUpper(prev)\n\ndef capital_words_spaces(input_string):\n    \"\"\"\n    Inserts spaces between words starting with capital letters in a given string.\n    Returns the original string if no spaces are inserted, or an empty string for empty input.\n    \"\"\"\n    if not input_string:\n        return \"\"\n\n    output_chars = []\n    space_was_inserted = False\n\n    for i in range(len(input_string)):\n        current_char = input_string[i]\n\n        if i > 0:\n            previous_char = input_string[i - 1]\n            if isBoundary(previous_char, current_char, i):\n                output_chars.append(' ')\n                space_was_inserted = True\n        output_chars.append(current_char)\n\n    if not space_was_inserted:\n        return input_string\n    else:\n        return \"\".join(output_chars)"}
{"task_id": "Mbpp/745", "solution": "from typing import List\n\nclass Digit:\n    \"\"\"Represents a single base-10 digit and provides checks for zero and divisibility.\"\"\"\n    def __init__(self, digit: int):\n        self.digit = digit\n\n    def is_zero(self) -> bool:\n        \"\"\"Checks if the digit is zero.\"\"\"\n        return self.digit == 0\n\n    def divides(self, value: int) -> bool:\n        \"\"\"Checks if this digit divides the given value evenly.\"\"\"\n        # Precondition: digit is not zero.\n        return value % self.digit == 0\n\nclass Number:\n    \"\"\"Represents an integer value and provides digit decomposition and divisibility checks.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n        # Digits derived from abs(value) in base-10.\n        abs_value_str = str(abs(value))\n        self.digits: List[Digit] = [Digit(int(d)) for d in abs_value_str]\n\n    def contains_zero(self) -> bool:\n        \"\"\"Checks if the number contains the digit zero.\"\"\"\n        return any(digit_obj.is_zero() for digit_obj in self.digits)\n\n    def digits_divide_value(self) -> bool:\n        \"\"\"Checks if every non-zero digit divides the absolute value of the number.\"\"\"\n        abs_val = abs(self.value)\n        for digit_obj in self.digits:\n            if not digit_obj.is_zero():  # Only check non-zero digits\n                if not digit_obj.divides(abs_val):\n                    return False\n        return True\n\nclass Range:\n    \"\"\"Represents an inclusive integer range and provides Number instances for iteration.\"\"\"\n    def __init__(self, start: int, end: int):\n        self.start = start\n        self.end = end\n\n    def iterator(self) -> List[Number]:\n        \"\"\"Returns a list of Number instances for each integer value from start to end inclusive.\"\"\"\n        if self.start > self.end:\n            return []\n        return [Number(i) for i in range(self.start, self.end + 1)]\n\nclass DivisibilityService:\n    \"\"\"Encapsulates the algorithm for finding numbers divisible by their digits within a range.\"\"\"\n    def divisible_by_digits(self, startnum: int, endnum: int) -> List[int]:\n        \"\"\"Finds numbers within a range where every number is divisible by every digit it contains.\"\"\"\n        result: List[int] = []\n        range_obj = Range(startnum, endnum)\n\n        for number_obj in range_obj.iterator():\n            if number_obj.contains_zero():\n                continue\n            if number_obj.digits_divide_value():\n                result.append(number_obj.value)\n        return result\n\ndef divisible_by_digits(startnum: int, endnum: int) -> List[int]:\n    \"\"\"\n    Finds numbers within a given range where every number is divisible by every digit it contains.\n    Numbers containing the digit 0 are excluded. Digits are derived from the absolute value.\n    \"\"\"\n    service = DivisibilityService()\n    return service.divisible_by_digits(startnum, endnum)"}
{"task_id": "Mbpp/749", "solution": "from typing import List\n\nclass _InputList:\n    \"\"\"Wraps and manages the caller-provided list of string numbers.\"\"\"\n    def __init__(self, items: List[str]):\n        self.items = items\n\n    def isEmpty(self) -> bool:\n        \"\"\"Checks if the input list is empty.\"\"\"\n        return not self.items\n\nclass _NumberString:\n    \"\"\"Encapsulates a raw string and provides conversion to an integer.\"\"\"\n    def __init__(self, raw: str):\n        self.raw = raw\n\n    def toInteger(self) -> int:\n        \"\"\"Converts the raw string to an integer.\"\"\"\n        return int(self.raw)\n\nclass _IntegerValue:\n    \"\"\"Immutable wrapper for a converted integer value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass _ConvertedList:\n    \"\"\"Container for IntegerValue items produced during conversion.\"\"\"\n    def __init__(self):\n        self._items: List[_IntegerValue] = []\n\n    def add(self, item: _IntegerValue):\n        \"\"\"Adds an IntegerValue to the list.\"\"\"\n        self._items.append(item)\n\n    @property\n    def items(self) -> List[_IntegerValue]:\n        \"\"\"Provides access to the internal list of IntegerValue objects.\"\"\"\n        return self._items\n\nclass _SortedList:\n    \"\"\"Container for IntegerValue items after sorting.\"\"\"\n    def __init__(self, items: List[_IntegerValue]):\n        # Create a copy to ensure sorting does not affect the original list passed in\n        self.items = list(items)\n\n    def sortAscending(self):\n        \"\"\"Sorts the internal list of IntegerValue items in ascending order.\"\"\"\n        self.items.sort(key=lambda x: x.value)\n\nclass _Converter:\n    \"\"\"Converts an InputList of string numbers to a ConvertedList of IntegerValue objects.\"\"\"\n    def convertAll(self, input_list: _InputList) -> _ConvertedList:\n        \"\"\"Converts all string items in InputList to IntegerValue objects.\"\"\"\n        converted_list = _ConvertedList()\n        for raw_str in input_list.items:\n            number_string = _NumberString(raw_str)\n            int_value = number_string.toInteger()\n            converted_list.add(_IntegerValue(int_value))\n        return converted_list\n\nclass _Sorter:\n    \"\"\"Sorts a ConvertedList of IntegerValue objects into a SortedList.\"\"\"\n    def sort(self, converted: _ConvertedList) -> _SortedList:\n        \"\"\"Sorts the items in the ConvertedList numerically.\"\"\"\n        sorted_list = _SortedList(converted.items)\n        sorted_list.sortAscending()\n        return sorted_list\n\nclass _Result:\n    \"\"\"Maps a SortedList of IntegerValue objects to a plain list of integers.\"\"\"\n    def __init__(self, sorted_list: _SortedList):\n        self.items = [iv.value for iv in sorted_list.items]\n\nclass _SortFunction:\n    \"\"\"Orchestrates the conversion and sorting process.\"\"\"\n    def execute(self, items: List[str]) -> List[int]:\n        \"\"\"Executes the complete workflow to sort numeric strings.\"\"\"\n        input_list = _InputList(items)\n\n        if input_list.isEmpty():\n            return []\n\n        converter = _Converter()\n        converted_list = converter.convertAll(input_list)\n\n        sorter = _Sorter()\n        sorted_list = sorter.sort(converted_list)\n\n        result = _Result(sorted_list)\n        return result.items\n\ndef sort_numeric_strings(input_list: List[str]) -> List[int]:\n    \"\"\"\n    Sorts a given list of strings of numbers numerically.\n    \"\"\"\n    sort_func = _SortFunction()\n    return sort_func.execute(input_list)"}
{"task_id": "Mbpp/750", "solution": "def _validate_input_types(input_list, input_tuple) -> None:\n    \"\"\"Validates the input types for add_tuple, raising TypeError on mismatch.\"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"first argument must be a list\")\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"second argument must be a tuple\")\n\ndef add_tuple(input_list: list, input_tuple: tuple) -> list:\n    \"\"\"Adds the elements of a tuple to a list and returns a new combined list.\"\"\"\n    _validate_input_types(input_list, input_tuple)\n    return list(input_list) + list(input_tuple)"}
{"task_id": "Mbpp/751", "solution": "from typing import Any, List\n\ndef check_min_heap(array) -> bool:\n    \"\"\"\n    Checks if the given array represents a min-heap using 0-based indexing.\n    A min-heap requires parent elements to be less than or equal to their children.\n    \"\"\"\n    n = len(array)\n\n    if n <= 1:\n        return True\n\n    # Iterate through all parent nodes; the last parent node index is floor((n-2)/2)\n    last_parent_idx = (n - 2) // 2\n    for i in range(last_parent_idx + 1):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check if current node is greater than its left child\n        if left_child_idx < n and array[i] > array[left_child_idx]:\n            return False\n\n        # Check if current node is greater than its right child\n        if right_child_idx < n and array[i] > array[right_child_idx]:\n            return False\n            \n    return True"}
{"task_id": "Mbpp/753", "solution": "class Validator:\n    \"\"\"Validates input list and each tuple record shape and types.\"\"\"\n    def validateRecord(self, record: tuple) -> bool:\n        \"\"\"Returns True if record is a 2-tuple with (str, numeric).\"\"\"\n        if not isinstance(record, tuple) or len(record) != 2:\n            return False\n        if not isinstance(record[0], str):\n            return False\n        if not isinstance(record[1], (int, float)):\n            return False\n        return True\n\n    def validateInput(self, input_list: list[tuple], k: int) -> bool:\n        \"\"\"Returns True if input_list is a list of valid records and k is an int.\"\"\"\n        if not isinstance(input_list, list):\n            return False\n        if not all(self.validateRecord(record) for record in input_list):\n            return False\n        if not isinstance(k, int):\n            return False\n        return True\n\nclass Sorter:\n    \"\"\"Sorts and selects the k smallest tuples, ensuring deterministic tie-breaking.\"\"\"\n    def sortAscending(self, records: list[tuple]) -> list[tuple]:\n        \"\"\"Returns records sorted ascending by numeric value using a stable sort.\"\"\"\n        return sorted(records, key=lambda x: x[1])\n\n    def selectK(self, records: list[tuple], k: int) -> list[tuple]:\n        \"\"\"Returns the first k records and raises ValueError if k is out of bounds.\"\"\"\n        if not isinstance(k, int) or k <= 0 or k > len(records):\n            raise ValueError(\"k must be a positive integer and not exceed the number of records.\")\n        return records[:k]\n\ndef min_k(input_list: list[tuple[str, float|int]], k: int) -> list[tuple[str, float|int]]:\n    \"\"\"\n    Returns exactly k tuples with the smallest numeric values in ascending order.\n    Raises ValueError on invalid input or k.\n    \"\"\"\n    validator = Validator()\n    if not validator.validateInput(input_list, k):\n        raise ValueError(\"Invalid input_list or k\")\n\n    sorter = Sorter()\n    sorted_records = sorter.sortAscending(input_list)\n    result = sorter.selectK(sorted_records, k)\n    return result"}
{"task_id": "Mbpp/752", "solution": "\nclass InvalidInputError(Exception):\n    \"\"\"Domain-specific exception for invalid input.\"\"\"\n    def __init__(self, code: str, message: str):\n        self.code = code\n        self.message = message\n        super().__init__(message)\n\nclass InputValidator:\n    \"\"\"Validates input for Jacobsthal number computation.\"\"\"\n    @staticmethod\n    def isInteger(value) -> bool:\n        \"\"\"Checks if the value is an integer.\"\"\"\n        return isinstance(value, int)\n\n    @staticmethod\n    def isNonNegative(n: int) -> bool:\n        \"\"\"Checks if the integer is non-negative.\"\"\"\n        return n >= 0\n\n    @staticmethod\n    def validate(n) -> None:\n        \"\"\"Validates that n is an integer and non-negative, raising InvalidInputError if not.\"\"\"\n        if not InputValidator.isInteger(n):\n            raise InvalidInputError(\"INVALID_TYPE\", \"Input 'n' must be an integer.\")\n        if not InputValidator.isNonNegative(n):\n            raise InvalidInputError(\"INVALID_VALUE\", \"Input 'n' must be a non-negative integer.\")\n\nclass JacobsthalNumberGenerator:\n    \"\"\"Computes Jacobsthal numbers based on their recurrence relation.\"\"\"\n    @staticmethod\n    def compute(n: int) -> int:\n        \"\"\"Returns the nth Jacobsthal number.\"\"\"\n        if n == 0:\n            return 0\n        elif n == 1:\n            return 1\n        else:\n            return JacobsthalNumberGenerator.computeIterative(n)\n\n    @staticmethod\n    def computeIterative(n: int) -> int:\n        \"\"\"Computes the nth Jacobsthal number iteratively.\"\"\"\n        j_prev2 = 0  # Represents J(i-2)\n        j_prev1 = 1  # Represents J(i-1)\n        \n        for _ in range(2, n + 1):\n            current_j = j_prev1 + 2 * j_prev2\n            j_prev2 = j_prev1\n            j_prev1 = current_j\n        return j_prev1\n\ndef jacobsthal_num(n) -> int:\n    \"\"\"\n    Finds the nth Jacobsthal number.\n    Validates input and computes the Jacobsthal number using an iterative approach.\n    \"\"\"\n    InputValidator.validate(n)\n    return JacobsthalNumberGenerator.compute(n)"}
{"task_id": "Mbpp/754", "solution": "from typing import List, Any\n\ndef _determine_min_length(l1: List, l2: List, l3: List) -> int:\n    \"\"\"Computes the minimum length among the three input lists.\"\"\"\n    return min(len(l1), len(l2), len(l3))\n\ndef _compare_triplet(a: Any, b: Any, c: Any) -> bool:\n    \"\"\"Checks if three elements are equal using language-default semantics.\"\"\"\n    return a == b == c\n\ndef extract_index_list(l1: List, l2: List, l3: List) -> List[Any]:\n    \"\"\"Return list of elements where l1[i] == l2[i] == l3[i] for indices up to min length.\n\n    The function iterates through the lists and collects elements that are identical at the same index across all three.\n    \"\"\"\n    result = []\n    min_len = _determine_min_length(l1, l2, l3)\n\n    for i in range(min_len):\n        if _compare_triplet(l1[i], l2[i], l3[i]):\n            result.append(l1[i])\n            \n    return result"}
{"task_id": "Mbpp/755", "solution": "from typing import List\nfrom numbers import Number\n\ndef second_smallest(values: List[Number]) -> Number:\n    \"Return the second smallest numeric value from `values` per FR2 semantics. Raises ValueError if preconditions not met.\"\n    if len(values) < 2:\n        raise ValueError(\"Input list must contain at least two elements.\")\n\n    for item in values:\n        if not isinstance(item, Number):\n            raise ValueError(\"All elements in the list must be numeric values.\")\n\n    sorted_values = sorted(values)\n    return sorted_values[1]"}
{"task_id": "Mbpp/758", "solution": "from typing import Any, List, Tuple, Dict\n\ndef unique_sublists(lists: List[List[Any]]) -> Dict[Tuple[Any, ...], int]:\n    \"\"\"\n    Counts occurrences of sublists, returning a dictionary mapping\n    tuple-converted sublists to their counts.\n    \"\"\"\n    result: Dict[Tuple[Any, ...], int] = {}\n    for inner in lists:\n        key = tuple(inner)\n        result[key] = result.get(key, 0) + 1\n    return result"}
{"task_id": "Mbpp/757", "solution": "from typing import List\n\ndef count_reverse_pairs(items: List[str]) -> int:\n    \"\"\"\n    Counts unordered pairs of reverse strings in the given list.\n    Each unique pair of reverse strings is counted exactly once.\n    \"\"\"\n    found_pairs = set()\n    n = len(items)\n\n    for i in range(n):\n        s1 = items[i]\n        # Iterate through remaining items to find potential reverse pairs,\n        # ensuring each combination (s1, s2) is considered once and preventing self-comparison.\n        for j in range(i + 1, n):\n            s2 = items[j]\n            \n            # Check if s1 is the exact character-reverse of s2\n            if s1 == s2[::-1]:\n                # Create a canonical representation of the pair (e.g., sorted tuple of strings)\n                # to ensure unordered pairs are counted only once, regardless of their original order or duplicates in input.\n                canonical_pair = tuple(sorted((s1, s2)))\n                found_pairs.add(canonical_pair)\n    \n    return len(found_pairs)"}
{"task_id": "Mbpp/759", "solution": "import re\n\n# Although the design specifies classes like InputString, ValidationResult, and DecimalValidator,\n# the core requirement for the 'is_decimal' function is to use a specific regex.\n# For simplicity and directness, and since the design allows for internal instantiation/reuse,\n# a single compiled regex object can be used at the module level for efficiency.\n\n_DECIMAL_PATTERN = re.compile(r\"^\\d+\\.\\d{2}$\")\n\ndef is_decimal(input_string: str) -> bool:\n    \"\"\"\n    Checks if the input string is a decimal number with exactly two digits after the decimal point.\n    It uses the regex pattern `^\\d+\\.\\d{2}$` for validation.\n    \"\"\"\n    return bool(_DECIMAL_PATTERN.match(input_string))"}
{"task_id": "Mbpp/762", "solution": "class Month:\n    \"\"\"Encapsulates a month number and provides has30Days().\"\"\"\n    def __init__(self, number: int):\n        self.number = number\n\n    def has30Days(self) -> bool:\n        \"\"\"Returns True if the month has 30 days, False otherwise.\"\"\"\n        return self.number in {4, 6, 9, 11}\n\nclass MonthChecker:\n    \"\"\"Orchestrates month evaluation using the Month class.\"\"\"\n    def check_monthnumber_number(self, month: int) -> bool:\n        \"\"\"Checks if the given month number has 30 days.\"\"\"\n        m = Month(number=month)\n        return m.has30Days()\n\ndef check_monthnumber_number(month: int) -> bool:\n    \"\"\"Checks whether the given month number contains 30 days.\"\"\"\n    checker = MonthChecker()\n    return checker.check_monthnumber_number(month)"}
{"task_id": "Mbpp/760", "solution": "def _distinct_count(list_of_numbers):\n    \"\"\"\n    Counts the number of distinct elements in a list.\n    Uses Python set semantics for distinctness.\n    \"\"\"\n    return len(set(list_of_numbers))\n\ndef unique_Element(list_of_numbers):\n    \"\"\"\n    Checks whether a list of numbers contains only one distinct element.\n    Returns True if there is exactly one distinct element, False otherwise.\n    \"\"\"\n    distinct_elements_count = _distinct_count(list_of_numbers)\n    return distinct_elements_count == 1"}
{"task_id": "Mbpp/763", "solution": "from .validation import Validation\nfrom .result import Result\nfrom typing import Sequence\n\ndef find_min_diff(arr: Sequence[float], n: int) -> float:\n    \"\"\"Compute minimum absolute difference among first n elements of arr.\n    Raises ValueError when n < 2 or n > len(arr).\n    \"\"\"\n    Validation().validate_n(arr, n)\n\n    # Consider only the first n elements\n    sub_arr = list(arr[:n])\n    sub_arr.sort()\n\n    min_diff = float('inf')\n    for i in range(1, n):\n        min_diff = min(min_diff, sub_arr[i] - sub_arr[i-1])\n\n    return Result(min_diff).min_diff"}
{"task_id": "Mbpp/764", "solution": "class InputString:\n    def __init__(self, value: str):\n        self.value = value\n\nclass DigitCharacter:\n    def __init__(self, char: str):\n        self.char = char\n\n    def is_digit(self) -> bool:\n        \"\"\"Checks if the character is an ASCII digit ('0'-'9').\"\"\"\n        return '0' <= self.char <= '9'\n\nclass Result:\n    def __init__(self, count: int):\n        self.count = count\n\nclass DigitCounter:\n    def number_ctr(self, s: str) -> int:\n        \"\"\"Counts digit characters in the input string using domain objects.\"\"\"\n        input_string = InputString(s)\n        count = 0\n        for char in input_string.value:\n            digit_char = DigitCharacter(char)\n            if digit_char.is_digit():\n                count += 1\n        result = Result(count)\n        return result.count\n\ndef number_ctr(s: str) -> int:\n    \"\"\"Counts the number of digit characters in the given string.\"\"\"\n    counter = DigitCounter()\n    return counter.number_ctr(s)"}
{"task_id": "Mbpp/769", "solution": "from typing import Any\n\ndef Diff(list1: list, list2: list) -> list:\n    \"\"\"\n    Return a list containing elements in list1 that are not present in list2.\n    Ordering: preserves the order of elements as encountered in list1.\n    \"\"\"\n    # Implementation note: use membership testing (value equality) and preserve order.\n    result = []\n    for e in list1:\n        if e not in list2:\n            result.append(e)\n    return result"}
{"task_id": "Mbpp/766", "solution": "def pair_wise(input_list):\n    \"\"\"Return a list of 2-element tuples where each tuple is (input_list[i], input_list[i+1]).\n\n    Raises TypeError if input_list is not iterable.\n    \"\"\"\n    results = []\n    try:\n        it = iter(input_list)\n    except TypeError:\n        raise TypeError(\"input_list must be an iterable.\")\n\n    try:\n        previous = next(it)\n    except StopIteration:\n        return []\n\n    for current in it:\n        results.append((previous, current))\n        previous = current\n\n    return results"}
{"task_id": "Mbpp/767", "solution": "import collections\nfrom typing import List, Union\n\nNumber = Union[int, float]\n\nclass NumberElement:\n    \"\"\"Represents a number with its original index.\"\"\"\n    def __init__(self, value: Number, index: int):\n        self.value = value\n        self.index = index\n\nclass Pair:\n    \"\"\"Represents an unordered pair of NumberElements.\"\"\"\n    def __init__(self, a: NumberElement, b: NumberElement):\n        self.a = a\n        self.b = b\n\n    def sum(self) -> Number:\n        return self.a.value + self.b.value\n\nclass PairCountResult:\n    \"\"\"Holds the final count of pairs.\"\"\"\n    def __init__(self, count: int):\n        self.count = count\n\nclass PairCounter:\n    \"\"\"Handles validation and counting of pairs.\"\"\"\n    def get_pairs_count(self, numbers: List[Number], target: Number) -> int:\n        self._validate_input(numbers, target)\n        return self._count_pairs(numbers, target)\n\n    def _validate_input(self, numbers: List[Number], target: Number) -> None:\n        \"\"\"Validates that inputs are of the correct numeric types.\"\"\"\n        if not isinstance(numbers, list):\n            raise TypeError(\"Input 'numbers' must be a list.\")\n        for i, num in enumerate(numbers):\n            if not isinstance(num, (int, float)):\n                raise TypeError(f\"Element at index {i} is not a number: {num}\")\n        if not isinstance(target, (int, float)):\n            raise TypeError(\"Input 'target' must be a number.\")\n\n    def _count_pairs(self, numbers: List[Number], target: Number) -> int:\n        \"\"\"Counts index-distinct pairs that sum to the target.\"\"\"\n        n = len(numbers)\n        if n < 2:\n            return 0\n\n        count = 0\n        for i in range(n - 1):\n            for j in range(i + 1, n):\n                if numbers[i] + numbers[j] == target:\n                    count += 1\n        return count\n\ndef get_pairs_count(numbers: List[Number], sum: Number) -> int:\n    \"\"\"\n    Counts the number of unordered index-distinct pairs in a list\n    whose sum is equal to the target 'sum'.\n    \"\"\"\n    counter = PairCounter()\n    return counter.get_pairs_count(numbers, sum)"}
{"task_id": "Mbpp/765", "solution": "import collections\nfrom typing import List, Optional\n\n# --- PoliteNumber Class ---\nclass PoliteNumber:\n    \"\"\"Domain value representing a polite number with its index.\"\"\"\n    def __init__(self, value: int, index: int):\n        self.value = value\n        self.index = index\n\n# --- InputValidator Class ---\nclass InputValidator:\n    \"\"\"Validates input n to ensure it's a positive integer.\"\"\"\n    def is_integer(self, value) -> bool:\n        return isinstance(value, int)\n\n    def is_positive(self, n: int) -> bool:\n        return n >= 1\n\n    def validate_n(self, n) -> None:\n        \"\"\"Raises ValueError if n is not an integer or is less than 1.\"\"\"\n        if not self.is_integer(n) or not self.is_positive(n):\n            raise ValueError(\"n must be an integer >= 1\")\n\n# --- PoliteNumberRepository Class ---\nclass PoliteNumberRepository:\n    \"\"\"Manages an in-memory cache of computed PoliteNumber objects.\"\"\"\n    def __init__(self):\n        # Using a list and managing insertion to keep it sorted by index.\n        self.cached_sequence: List[PoliteNumber] = []\n\n    def store(self, p: PoliteNumber) -> None:\n        \"\"\"Stores or updates a PoliteNumber in the cache, maintaining sorted order by index.\"\"\"\n        for i, existing_p in enumerate(self.cached_sequence):\n            if existing_p.index == p.index:\n                self.cached_sequence[i] = p  # Update existing entry\n                return\n            if existing_p.index > p.index:\n                self.cached_sequence.insert(i, p) # Insert in sorted position\n                return\n        self.cached_sequence.append(p)  # Append if larger than all existing\n\n    def query_up_to_index(self, idx: int) -> List[PoliteNumber]:\n        \"\"\"Returns cached polite numbers up to the specified index.\"\"\"\n        return [p for p in self.cached_sequence if p.index <= idx]\n\n# --- PoliteNumberCalculator Class ---\nclass PoliteNumberCalculator:\n    \"\"\"Contains number-theory logic to identify and compute polite numbers.\"\"\"\n\n    def is_polite_value(self, x: int) -> bool:\n        \"\"\"Returns True if x is a polite number (i.e., not a power of 2).\"\"\"\n        if x <= 0:\n            return False\n        # A positive integer is polite if and only if it is not a power of 2.\n        return (x & (x - 1)) != 0\n\n    def compute_nth(self, n: int) -> int:\n        \"\"\"Scans integers to find the nth polite number (1-based index).\"\"\"\n        if n < 1:\n            raise ValueError(\"n must be a positive integer for computation.\")\n\n        count = 0\n        num = 0\n        while count < n:\n            num += 1\n            if self.is_polite_value(num):\n                count += 1\n        return num\n\n# --- PoliteNumberService Class ---\nclass PoliteNumberService:\n    \"\"\"Orchestrates input validation, caching, and polite number computation.\"\"\"\n    def __init__(self, repository: Optional[PoliteNumberRepository] = None):\n        self.validator = InputValidator()\n        self.calculator = PoliteNumberCalculator()\n        self.repository = repository or PoliteNumberRepository()\n\n    def is_polite(self, n: int) -> int:\n        \"\"\"Finds the nth polite number, using cache or computation.\"\"\"\n        self.validator.validate_n(n)\n\n        # Check if the nth number is already in the cache\n        for p_num in self.repository.cached_sequence:\n            if p_num.index == n:\n                return p_num.value\n\n        # If not found, compute it\n        computed_value = self.calculator.compute_nth(n)\n        \n        # Store the newly computed result in the repository for future requests\n        self.repository.store(PoliteNumber(computed_value, n))\n        \n        return computed_value\n\n    def generate_sequence_up_to(self, limit: int) -> list[int]:\n        \"\"\"Generate polite-number values up to a numeric limit.\"\"\"\n        polite_values = []\n        num = 1\n        while num <= limit:\n            if self.calculator.is_polite_value(num):\n                polite_values.append(num)\n            num += 1\n        return polite_values\n\n    def find_nth(self, n: int) -> int:\n        \"\"\"Find the nth polite number using repository and calculator.\"\"\"\n        # This method's logic is similar to `is_polite` in the service, designed for internal use.\n        self.validator.validate_n(n)\n\n        for p_num in self.repository.cached_sequence:\n            if p_num.index == n:\n                return p_num.value\n\n        computed_value = self.calculator.compute_nth(n)\n        self.repository.store(PoliteNumber(computed_value, n))\n        return computed_value\n\ndef is_polite(n: int) -> int:\n    \"\"\"\n    Finds the nth polite number (1-based index).\n    A polite number is a positive integer that can be expressed as the sum of two or more\n    consecutive positive integers (i.e., it is not a power of 2).\n    \"\"\"\n    service = PoliteNumberService()\n    return service.is_polite(n)"}
{"task_id": "Mbpp/770", "solution": "def _pow4(x) -> int:\n    \"\"\"Compute x raised to the fourth power.\"\"\"\n    return x ** 4\n\ndef _generate_odds(n) -> list:\n    \"\"\"Generate a list of the first n odd natural numbers.\"\"\"\n    return [(2 * k - 1) for k in range(1, n + 1)]\n\ndef odd_num_sum(n) -> int:\n    \"\"\"\n    Find the sum of the fourth power of the first n odd natural numbers.\n    Returns 0 if n is 0.\n    \"\"\"\n    if n == 0:\n        return 0\n    \n    odds = _generate_odds(n)\n    total_sum = 0\n    for num in odds:\n        total_sum += _pow4(num)\n    return total_sum"}
{"task_id": "Mbpp/771", "solution": "def check_expression(expression: str) -> bool:\n    \"\"\"\n    Checks if the given expression has balanced brackets using a stack-based approach.\n    Recognizes parentheses '()', braces '{}', and square brackets '[]'.\n    \"\"\"\n    stack = []\n    \n    # Mappings for opening and closing brackets\n    opening_brackets = {'(', '{', '['}\n    closing_to_opening_map = {')': '(', '}': '{', ']': '['}\n\n    for char in expression:\n        if char in opening_brackets:\n            stack.append(char)\n        elif char in closing_to_opening_map:\n            if not stack:\n                # Mismatch: closing bracket with no corresponding opening bracket\n                return False\n            \n            last_open = stack.pop()\n            expected_open = closing_to_opening_map[char]\n            \n            if last_open != expected_open:\n                # Mismatch: closing bracket type does not match the most recent opening bracket\n                return False\n        # Ignore non-bracket characters as per typical problem interpretation\n\n    # After iterating through the expression, the stack should be empty if all brackets are balanced.\n    return not stack"}
{"task_id": "Mbpp/772", "solution": "from src.validator import Validator\nfrom src.parser import split_by_whitespace\nfrom src.filter import filter_words_by_length\nfrom src.joiner import join_with_single_space\nfrom src.domain import InputString, Word, ResultString\n\ndef remove_length(input_string, k) -> str:\n    Validator.validate_types(input_string, k)\n    if not input_string:\n        return ''\n    words = split_by_whitespace(input_string)\n    retained = filter_words_by_length(words, k)\n    result = join_with_single_space(retained)\n    return result"}
{"task_id": "Mbpp/773", "solution": "from typing import Optional, Tuple\n\ndef occurance_substring(haystack: str, needle: str) -> Optional[Tuple[str, int, int]]:\n    \"\"\"\n    Finds the first occurrence and position of a substring within a string.\n    Returns (substring, start_index, end_index) if found, otherwise None.\n    \"\"\"\n    start_index = haystack.find(needle)\n    if start_index == -1:\n        return None\n    \n    end_index = start_index + len(needle)\n    return (needle, start_index, end_index)"}
{"task_id": "Mbpp/777", "solution": "def find_sum(lst):\n    \"\"\"Compute the sum of distinct numeric elements from lst.\n\n    Preconditions: lst is iterable (TypeError raised otherwise). Elements are expected to be numeric (ints/floats); Python will raise TypeError if non-numeric types are encountered during summation.\n    Postconditions: returns numeric sum of distinct values (0 for empty input).\n    \"\"\"\n    try:\n        iterator = iter(lst)\n    except TypeError:\n        raise TypeError(\"find_sum: input must be iterable\")\n\n    unique_values = set(lst)\n    # sum() will raise TypeError if elements are not summable numeric types,\n    # which preserves deterministic behavior for numeric types per BR8.\n    return sum(unique_values)"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list):\n    \"\"\"\n    Packs consecutive duplicates of a given list elements into sublists.\n    \"\"\"\n    if not input_list:\n        return []\n\n    packed_list = []\n    current_group = []\n\n    for element in input_list:\n        if not current_group or element == current_group[0]:\n            current_group.append(element)\n        else:\n            packed_list.append(current_group)\n            current_group = [element]\n    \n    # Add the last group after the loop finishes\n    if current_group:\n        packed_list.append(current_group)\n\n    return packed_list"}
{"task_id": "Mbpp/775", "solution": "from typing import List\n\ndef odd_position(input_list: List[int]) -> bool:\n    \"\"\"Return True if every element at an odd index in input_list is an odd integer.\n\n    Raises:\n        TypeError: if input_list is not a list or contains non-integer elements.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    for i in range(len(input_list)):\n        element = input_list[i]\n        if not isinstance(element, int):\n            raise TypeError(\"All elements in the list must be integers.\")\n\n        # Check only odd indices (1, 3, 5, ...)\n        if i % 2 != 0:\n            # If an element at an odd index is even, return False\n            if element % 2 == 0:\n                return False\n    return True"}
{"task_id": "Mbpp/780", "solution": "import collections.abc\nfrom typing import List, Tuple as TypingTuple\nfrom numbers import Number\n\nclass InvalidInputException(Exception):\n    \"\"\"Domain-specific exception for validation failures.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass _InternalTuple:\n    \"\"\"Internal representation for 2-element numeric tuples, allowing attribute access.\"\"\"\n    def __init__(self, first: Number, second: Number):\n        self.first = first\n        self.second = second\n\nclass Validator:\n    \"\"\"Validates if the input list contains valid 2-element numeric tuples.\"\"\"\n    def validate(self, input_list: List[TypingTuple[Number, Number]]) -> None:\n        if not isinstance(input_list, list):\n            raise InvalidInputException(\"Input must be a list.\")\n        for i, item in enumerate(input_list):\n            if not isinstance(item, collections.abc.Sequence) or len(item) != 2:\n                raise InvalidInputException(f\"Item at index {i} must be a 2-element tuple.\")\n            if not isinstance(item[0], Number) or not isinstance(item[1], Number):\n                raise InvalidInputException(f\"Elements of tuple at index {i} must be numeric.\")\n\nclass ResultAssembler:\n    \"\"\"Collects results and builds the final list of standard Python tuples.\"\"\"\n    def __init__(self):\n        self._results: List[_InternalTuple] = []\n\n    def append(self, t: _InternalTuple) -> None:\n        self._results.append(t)\n\n    def build(self) -> List[TypingTuple[Number, Number]]:\n        return [(t.first, t.second) for t in self._results]\n\nclass PairwiseSummationProcessor:\n    \"\"\"Iterates over pairs of input tuples and computes their sums.\"\"\"\n    def process(self, input_list: List[TypingTuple[Number, Number]], assembler: ResultAssembler) -> None:\n        n = len(input_list)\n        for i in range(0, n - 1):\n            a_tuple = input_list[i]\n            for j in range(i + 1, n):\n                b_tuple = input_list[j]\n                summed = _InternalTuple(a_tuple[0] + b_tuple[0], a_tuple[1] + b_tuple[1])\n                assembler.append(summed)\n\ndef find_combinations(input_list: List[TypingTuple[Number, Number]]) -> List[TypingTuple[Number, Number]]:\n    \"\"\"\n    Finds combinations of sums with tuples in the given tuple list.\n    For every unordered pair of distinct input tuples (i, j) with i < j,\n    produces one output tuple (sum of first elements, sum of second elements).\n    \"\"\"\n    Validator().validate(input_list)\n    assembler = ResultAssembler()\n    PairwiseSummationProcessor().process(input_list, assembler)\n    return assembler.build()"}
{"task_id": "Mbpp/782", "solution": "from dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass Array:\n    elements: List[int]\n    def length(self) -> int:\n        return len(self.elements)\n\n@dataclass\nclass Subarray:\n    start: int\n    end: int  # exclusive\n    source: Array\n    def length(self) -> int:\n        return self.end - self.start\n    def sum(self) -> int:\n        return sum(self.source.elements[self.start:self.end])\n\n@dataclass\nclass Result:\n    value: int\n\ndef odd_length_sum(arr: List[int]) -> int:\n    \"\"\"Calculates the sum of all contiguous subarrays of odd length.\"\"\"\n    total_sum = 0\n    array_obj = Array(elements=arr)\n    n = array_obj.length()\n\n    for i in range(n):\n        for j in range(i, n):\n            subarray_obj = Subarray(start=i, end=j + 1, source=array_obj)\n            if subarray_obj.length() % 2 == 1:\n                total_sum += subarray_obj.sum()\n    \n    return total_sum"}
{"task_id": "Mbpp/781", "solution": "from dataclasses import dataclass\nfrom typing import List, Any\nimport math\n\n@dataclass\nclass IntegerValue:\n    \"\"\"Represents an integer value.\"\"\"\n    value: int\n\n@dataclass\nclass DivisorSet:\n    \"\"\"Container for a list of positive divisors.\"\"\"\n    divisors: List[int]\n    def size(self) -> int:\n        \"\"\"Returns the number of divisors in the set.\"\"\"\n        return len(self.divisors)\n\n@dataclass\nclass Result:\n    \"\"\"Container for the boolean parity result.\"\"\"\n    is_even: bool\n\ndef _validate_input(n: Any) -> int:\n    \"\"\"Validates the input and returns its absolute value.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n    if n == 0:\n        raise ValueError(\"Input cannot be zero.\")\n    return abs(n)\n\ndef compute_divisors(n: int) -> List[int]:\n    \"\"\"Computes all positive divisors of a positive integer n.\"\"\"\n    divs = set()\n    # Iterate from 1 up to the square root of n\n    for i in range(1, int(math.isqrt(n)) + 1):\n        if n % i == 0:\n            divs.add(i)\n            divs.add(n // i)\n    return sorted(list(divs))\n\ndef _is_count_even(count: int) -> bool:\n    \"\"\"Checks if a given count is an even number.\"\"\"\n    return (count % 2) == 0\n\ndef count_divisors(n: int) -> bool:\n    \"\"\"\n    Checks whether the count of positive divisors for an integer n is even.\n    Raises TypeError if n is not an integer or ValueError if n is zero.\n    \"\"\"\n    abs_n = _validate_input(n)\n    divisors = compute_divisors(abs_n)\n    return _is_count_even(len(divisors))"}
{"task_id": "Mbpp/784", "solution": "from typing import List\n\nclass InputList:\n    \"\"\"A lightweight wrapper for an ordered sequence of integer items.\"\"\"\n    def __init__(self, items: List[int]) -> None:\n        self.items: List[int] = items\n\n    def length(self) -> int:\n        \"\"\"Returns the number of items in the list.\"\"\"\n        return len(self.items)\n\nclass Element:\n    \"\"\"Wraps an integer value and provides even/odd classification.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value: int = value\n\n    def is_even(self) -> bool:\n        \"\"\"Checks if the element's value is even.\"\"\"\n        return self.value % 2 == 0\n\n    def is_odd(self) -> bool:\n        \"\"\"Checks if the element's value is odd.\"\"\"\n        return self.value % 2 != 0\n\nclass Result:\n    \"\"\"Holds the first encountered even and odd values and their product.\"\"\"\n    def __init__(self, even_value: int, odd_value: int) -> None:\n        self.even_value: int = even_value\n        self.odd_value: int = odd_value\n        self.product: int = even_value * odd_value\n\ndef mul_even_odd(input_list: List[int]) -> int:\n    \"\"\"\n    Finds the product of the first even and first odd number in a given list.\n    Raises ValueError if the list does not contain at least one odd and one even integer.\n    \"\"\"\n    first_even: int | None = None\n    first_odd: int | None = None\n\n    input_wrapper = InputList(input_list)\n\n    for item_value in input_wrapper.items:\n        element = Element(item_value)\n\n        if first_odd is None and element.is_odd():\n            first_odd = element.value\n        \n        if first_even is None and element.is_even():\n            first_even = element.value\n            \n        if first_odd is not None and first_even is not None:\n            break\n\n    if first_even is None or first_odd is None:\n        raise ValueError(\"Input must contain at least one odd and one even integer\")\n\n    result = Result(first_even, first_odd)\n    return result.product"}
{"task_id": "Mbpp/785", "solution": "class TupleString:\n    \"\"\"Domain data holder for the raw input string.\"\"\"\n    def __init__(self, raw: str) -> None:\n        self.raw: str = raw\n\nclass IntegerTuple:\n    \"\"\"Domain data holder for parsed integer values.\"\"\"\n    def __init__(self, values: tuple[int, ...]) -> None:\n        self.values: tuple[int, ...] = values\n\nclass TupleParser:\n    \"\"\"Stateless parsing service that validates, tokenizes, and converts tokens to integers.\"\"\"\n    def tuple_str_int(self, raw: str) -> IntegerTuple:\n        \"\"\"Parse 'raw' and return IntegerTuple. Raises ValueError on invalid input.\"\"\"\n        if not raw.startswith('(') or not raw.endswith(')'):\n            raise ValueError(\"Input string must start and end with parentheses.\")\n        \n        if len(raw) < 2:\n            raise ValueError(\"Malformed tuple string: too short or incomplete parentheses.\")\n\n        content = raw[1:-1].strip()\n\n        if not content:\n            return IntegerTuple(values=())\n\n        tokens = content.split(',')\n        parsed_ints = []\n        for token in tokens:\n            stripped_token = token.strip()\n            if not stripped_token:\n                raise ValueError(f\"Empty or malformed integer token found in tuple string: '{raw}'\")\n            try:\n                parsed_ints.append(int(stripped_token))\n            except ValueError:\n                raise ValueError(f\"Could not convert '{stripped_token}' to integer in tuple string: '{raw}'\")\n\n        return IntegerTuple(values=tuple(parsed_ints))\n\ndef tuple_str_int(raw: str) -> tuple[int, ...]:\n    \"\"\"Public API. Validates type, delegates to TupleParser, returns native tuple of ints.\"\"\"\n    if not isinstance(raw, str):\n        raise TypeError(f\"Input must be a string, but got {type(raw).__name__}\")\n\n    parser = TupleParser()\n    integer_tuple = parser.tuple_str_int(raw)\n    return integer_tuple.values"}
{"task_id": "Mbpp/787", "solution": "\"\"\"\nThis module provides the text_match_three function to detect the substring \"abbb\".\nIt also defines InputString and MatchResult for domain model traceability.\n\"\"\"\nfrom dataclasses import dataclass\n\n@dataclass\nclass InputString:\n    \"\"\"Represents the input string for matching.\"\"\"\n    value: str\n\n@dataclass\nclass MatchResult:\n    \"\"\"Represents the result of a string match operation.\"\"\"\n    matched: bool\n\ndef text_match_three(input: str) -> bool:\n    \"\"\"\n    Checks if the input string contains the contiguous substring \"abbb\".\n    Returns True if \"abbb\" is found, False otherwise.\n    \"\"\"\n    return \"abbb\" in input\n\n__all__ = [\"text_match_three\", \"InputString\", \"MatchResult\"]"}
