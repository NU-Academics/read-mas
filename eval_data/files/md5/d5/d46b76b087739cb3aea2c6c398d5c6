{"task_id": "Mbpp/125", "solution": "class ValidationError(Exception):\n    \"\"\"Exception raised for invalid characters in the binary string.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass BinaryString:\n    \"\"\"Represents a binary string and provides validation.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the binary string.\"\"\"\n        return len(self.value)\n\n    def validateCharacters(self) -> None:\n        \"\"\"Validates that the string contains only '0' or '1'.\"\"\"\n        for char in self.value:\n            if char not in ('0', '1'):\n                raise ValidationError(f\"Invalid character '{char}' found in binary string. Only '0' and '1' are allowed.\")\n\ndef find_length(binary_string: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and 1s\n    in any contiguous sub-string of the given binary string.\n    \"\"\"\n    bs = BinaryString(binary_string)\n    bs.validateCharacters()\n\n    if bs.length() == 0:\n        return 0\n\n    # Map '0' to +1 and '1' to -1 to use Kadane's algorithm\n    # for maximum contiguous sub-array sum.\n    numeric_sequence = []\n    for char in bs.value:\n        if char == '0':\n            numeric_sequence.append(1)\n        else: # char == '1'\n            numeric_sequence.append(-1)\n\n    max_so_far = 0\n    current_max = 0\n\n    for num in numeric_sequence:\n        current_max += num\n        if current_max < 0:\n            current_max = 0\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
{"task_id": "Mbpp/123", "solution": "from amicable_sum_service import AmicableSumService\n\ndef amicable_numbers_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of all amicable numbers up to a specified number n.\n    Validates input and delegates the core logic to AmicableSumService.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n    \n    service = AmicableSumService()\n    return service.amicable_numbers_sum(n)"}
{"task_id": "Mbpp/126", "solution": "import math\nfrom dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass InputNumbers:\n    a: int\n    b: int\n\n@dataclass\nclass CommonDivisor:\n    value: int\n\n@dataclass\nclass Result:\n    value: int\n\nclass CommonDivisorCalculator:\n    def computeCommonDivisors(self, a: int, b: int) -> List[int]:\n        \"\"\"\n        Computes all positive common divisors of two integers.\n        It calculates the GCD and then finds all its divisors.\n        \"\"\"\n        common_gcd = math.gcd(abs(a), abs(b))\n        divisors = set()\n        for i in range(1, int(math.sqrt(common_gcd)) + 1):\n            if common_gcd % i == 0:\n                divisors.add(i)\n                divisors.add(common_gcd // i)\n        return sorted(list(divisors))\n\n    def sumCommonDivisors(self, a: int, b: int) -> int:\n        \"\"\"\n        Sums all positive common divisors of two integers.\n        It delegates to computeCommonDivisors and sums the resulting list.\n        \"\"\"\n        common_divisors = self.computeCommonDivisors(a, b)\n        return sum(common_divisors)\n\ndef sum(a: int, b: int) -> int:\n    \"\"\"\n    Calculates the sum of all positive common divisors of two integers.\n    It validates inputs and delegates the computation to CommonDivisorCalculator.\n    \"\"\"\n    if not isinstance(a, int) or not isinstance(b, int):\n        raise TypeError(\"a and b must be integers\")\n\n    calculator = CommonDivisorCalculator()\n    return calculator.sumCommonDivisors(a, b)"}
{"task_id": "Mbpp/127", "solution": "class IntegerOperand:\n    \"\"\"Represents an integer operand and validates its type.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if the operand's value is an integer.\"\"\"\n        return isinstance(self.value, int)\n\nclass Result:\n    \"\"\"Holds the computed integer result.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass MultiplyFunction:\n    \"\"\"Encapsulates validation and multiplication logic.\"\"\"\n    def validate_args(self, a, b) -> None:\n        \"\"\"Validates that both arguments are integers.\"\"\"\n        operand_a = IntegerOperand(a)\n        operand_b = IntegerOperand(b)\n        if not operand_a.is_valid() or not operand_b.is_valid():\n            raise TypeError(\"Arguments must be integers.\")\n\n    def multiply_int(self, a, b) -> int:\n        \"\"\"Validates arguments and computes their product.\"\"\"\n        self.validate_args(a, b)\n        product_value = a * b\n        result = Result(product_value)\n        return result.value\n\ndef multiply_int(a, b) -> int:\n    \"\"\"\n    Multiplies two integers after validating their types.\n    Raises TypeError if arguments are not integers.\n    \"\"\"\n    # Python's function signature implicitly handles the argument count.\n    # The MultiplyFunction class handles type validation and computation.\n    calculator = MultiplyFunction()\n    return calculator.multiply_int(a, b)"}
{"task_id": "Mbpp/128", "solution": "from typing import List\n\ndef long_words(n: int, words) -> List[str]:\n    \"\"\"\n    Finds words that are strictly longer than n characters from a given input.\n    The input 'words' can be a string (whitespace-separated) or a list of strings.\n    \"\"\"\n    if isinstance(words, str):\n        tokens = words.split()\n    else:\n        tokens = words\n\n    return [word for word in tokens if len(word) > n]"}
{"task_id": "Mbpp/130", "solution": "```python\ndef max_occurrences(lst):\n    \"\"\"\n    Finds the item with the maximum frequency in a list, using earliest first occurrence for tie-breaking.\n    Raises TypeError if input is not a list, ValueError if the list is empty.\n    \"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"Input must be a list.\")\n    if len(lst) == 0:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    counts = {}\n    first_indices = {}\n\n    for i, item in enumerate(lst):\n        if item not in first_indices:\n            first_indices[item] = i\n        counts[item] = counts.get(item, 0) + 1\n\n    max_count = -1\n    result_item = None\n    result_first_index = float('inf')\n\n    for item, count in counts.items():\n        if count > max_count:\n            max_count = count\n            result_item = item\n            result_first_index = first_indices[item]\n        elif count == max_count:\n            # Tie-breaking: choose the item with the earliest first occurrence\n            if first_indices[item] < result_first_index:\n                result_item = item\n                result_first_index = first_indices[item]\n\n    return result_item\n```"}
