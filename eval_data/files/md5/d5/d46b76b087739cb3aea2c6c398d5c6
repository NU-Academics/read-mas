{"task_id": "Mbpp/603", "solution": "from typing import List\n\nclass LudicSequence:\n    \"\"\"A wrapper for a sequence of ludic numbers.\"\"\"\n    def __init__(self, numbers: List[int]):\n        self.numbers = numbers\n\n    def size(self) -> int:\n        \"\"\"Returns the number of elements in the sequence.\"\"\"\n        return len(self.numbers)\n\n    def contains(self, x: int) -> bool:\n        \"\"\"Checks if a number is present in the sequence.\"\"\"\n        return x in self.numbers\n\nclass ResultList:\n    \"\"\"A data transfer object for the list of ludic numbers.\"\"\"\n    def __init__(self, values: List[int]):\n        self.values = values\n\nclass LudicGenerator:\n    \"\"\"Encapsulates the algorithm for generating ludic numbers.\"\"\"\n\n    @staticmethod\n    def generate(n: int) -> ResultList:\n        \"\"\"\n        Computes all ludic numbers up to n using a sieve-like method.\n        It iteratively finds the next ludic number and removes elements\n        from the candidate list based on its position.\n        \"\"\"\n        if n < 1:\n            return ResultList([])\n\n        candidates = list(range(1, n + 1))\n        ludic_numbers = []\n\n        while candidates:\n            # The first number in candidates is always the next ludic number\n            next_ludic = candidates[0]\n            ludic_numbers.append(next_ludic)\n            \n            # Remove the current ludic number from candidates\n            candidates.pop(0)\n\n            # If no more candidates, break\n            if not candidates:\n                break\n\n            # If the current ludic number is 1, it does not \"sieve\" out any positions\n            if next_ludic == 1:\n                continue\n\n            # Build a new list of candidates by removing elements at specific positions.\n            # The indices to remove are 1-based multiples of next_ludic in the *current* candidates list.\n            # For example, if next_ludic is 2, remove the 2nd, 4th, 6th... elements.\n            # In 0-indexed list, this means indices 1, 3, 5...\n            \n            new_candidates = []\n            for i in range(len(candidates)):\n                # If (1-based position) % next_ludic == 0, then skip this element\n                if (i + 1) % next_ludic != 0:\n                    new_candidates.append(candidates[i])\n            \n            candidates = new_candidates\n\n        return ResultList(ludic_numbers)\n\n\ndef get_ludic(n: int) -> List[int]:\n    \"\"\"\n    Returns a list of all ludic numbers less than or equal to the given integer n.\n\n    Validates that the input n is an integer and delegates the generation\n    to a LudicGenerator.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    \n    result_list_dto = LudicGenerator.generate(n)\n    return result_list_dto.values"}
{"task_id": "Mbpp/604", "solution": "def reverse_words(input: str) -> str:\n    \"\"\"\n    Reverses the order of words in a string, handling multiple spaces and trimming.\n    Raises TypeError if the input is not a string.\n    \"\"\"\n    if not isinstance(input, str):\n        raise TypeError(\"input must be a string\")\n\n    if input == \"\":\n        return \"\"\n\n    tokens = [t for t in input.split(' ') if t != \"\"]\n    reversed_tokens = list(reversed(tokens))\n    return ' '.join(reversed_tokens)"}
{"task_id": "Mbpp/605", "solution": "from math import isqrt\n\nclass PrimeChecker:\n    def is_divisible(self, a: int, b: int) -> bool:\n        \"\"\"Return True if a is divisible by b.\"\"\"\n        return a % b == 0\n\n    def prime_num(self, n: int) -> bool:\n        \"\"\"Return True iff n is prime.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if self.is_divisible(n, 2):\n            return False\n\n        # Check for odd divisors from 3 up to sqrt(n)\n        for i in range(3, isqrt(n) + 1, 2):\n            if self.is_divisible(n, i):\n                return False\n        return True\n\ndef prime_num(n: int) -> bool:\n    \"\"\"Public API. Delegates to PrimeChecker.prime_num.\"\"\"\n    checker = PrimeChecker()\n    return checker.prime_num(n)"}
{"task_id": "Mbpp/606", "solution": "import math\n\ndef radian_degree(degrees: float) -> float:\n    \"\"\"Compute radians from degrees using radians = degrees * PI / 180.\n\n    Parameters:\n        degrees (float): angle in degrees\n    Returns:\n        float: angle in radians\n    \"\"\"\n    return degrees * math.pi / 180.0"}
{"task_id": "Mbpp/608", "solution": "def bell_Number(n: int) -> int:\n    \"\"\"\n    Computes the nth Bell number using the Bell triangle method.\n    Raises TypeError for non-integer input or ValueError for negative input.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n\n    if n == 0:\n        return 1\n\n    bell_triangle = [[0] * (n + 1) for _ in range(n + 1)]\n    bell_triangle[0][0] = 1\n\n    for i in range(1, n + 1):\n        bell_triangle[i][0] = bell_triangle[i-1][i-1]\n        for j in range(1, i + 1):\n            bell_triangle[i][j] = bell_triangle[i-1][j-1] + bell_triangle[i][j-1]\n\n    return bell_triangle[n][0]"}
{"task_id": "Mbpp/610", "solution": "def remove_kth_element(input_list: list, k: int) -> list:\n    \"\"\"\n    Returns a new list with the k'th element (1-based index) removed.\n    Raises IndexError if k is out of range.\n    \"\"\"\n    if k < 1 or k > len(input_list):\n        raise IndexError(\"k is out of range for the list.\")\n    \n    # Convert 1-based k to 0-based index\n    index_to_remove = k - 1\n    \n    # Create a new list by concatenating slices before and after the removed element\n    return input_list[:index_to_remove] + input_list[index_to_remove+1:]"}
{"task_id": "Mbpp/611", "solution": "def _validate_matrix_shape(matrix):\n    \"\"\"\n    Validates if the input matrix is a non-empty list of lists and is rectangular.\n    Returns (row_count, column_count) if valid, otherwise raises ValueError.\n    \"\"\"\n    if not isinstance(matrix, list):\n        raise ValueError(\"Matrix must be a list of lists.\")\n    if not matrix:\n        raise ValueError(\"Matrix cannot be empty.\")\n\n    row_count = len(matrix)\n    \n    if not matrix[0]: # Handle cases like [[], []]\n        column_count = 0\n    else:\n        column_count = len(matrix[0])\n\n    for row in matrix:\n        if not isinstance(row, list):\n            raise ValueError(\"All rows in the matrix must be lists.\")\n        if len(row) != column_count:\n            raise ValueError(\"Matrix is not rectangular.\")\n\n    return row_count, column_count\n\ndef _validate_index(matrix, n):\n    \"\"\"\n    Validates if the column index n is within the bounds of the matrix columns.\n    Raises IndexError if n is out of range.\n    \"\"\"\n    if not matrix: # Should be caught by _validate_matrix_shape, but defensive check\n        raise IndexError(\"Matrix is empty, cannot validate column index.\")\n    \n    # Get column_count, assuming matrix[0] exists and is a list due to _validate_matrix_shape\n    if not matrix[0]:\n        column_count = 0\n    else:\n        column_count = len(matrix[0])\n\n    if not (0 <= n < column_count):\n        raise IndexError(f\"Column index {n} is out of bounds for matrix with {column_count} columns.\")\n\ndef _extract_column(matrix, n):\n    \"\"\"\n    Extracts the n-th column from the matrix as a list of values.\n    Assumes matrix is valid and n is in bounds.\n    \"\"\"\n    return [row[n] for row in matrix]\n\ndef _validate_column_numeric(values):\n    \"\"\"\n    Validates if all values in the given list are numeric (int or float).\n    Raises TypeError if a non-numeric value is found.\n    \"\"\"\n    for val in values:\n        if not isinstance(val, (int, float)):\n            raise TypeError(f\"Non-numeric value '{val}' found in column.\")\n\ndef max_of_nth(matrix, n):\n    \"\"\"\n    Returns the maximum value of the n'th column in a given matrix (list of lists).\n    Raises ValueError, IndexError, or TypeError for invalid inputs.\n    \"\"\"\n    row_count, column_count = _validate_matrix_shape(matrix)\n    _validate_index(matrix, n)\n    values = _extract_column(matrix, n)\n    _validate_column_numeric(values)\n    return max(values)"}
{"task_id": "Mbpp/607", "solution": "import re\n\nclass SourceString:\n    \"\"\"Represents the source text to be searched.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\n    def length(self) -> int:\n        return len(self.text)\n\nclass Pattern:\n    \"\"\"Encapsulates a regex pattern and provides compilation.\"\"\"\n    def __init__(self, expression: str):\n        self.expression = expression\n\n    def compile(self) -> re.Pattern:\n        return re.compile(self.expression)\n\nclass MatchResult:\n    \"\"\"Holds the details of a found match.\"\"\"\n    def __init__(self, substring: str, startIndex: int, endIndex: int):\n        self.substring = substring\n        self.startIndex = startIndex\n        self.endIndex = endIndex\n\nclass RegexEngine:\n    \"\"\"Adapts Python's re module for searching.\"\"\"\n    def search(self, text: str, compiled_regex: re.Pattern) -> MatchResult | None:\n        m = compiled_regex.search(text)\n        if m is None:\n            return None\n        else:\n            return MatchResult(m.group(0), m.start(), m.end())\n\ndef find_literals(source: str, pattern: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Searches a string for a regex pattern.\n    Returns the matching substring, a start index, and an end index, or None if no match.\n    \"\"\"\n    source_string_obj = SourceString(source)\n    pattern_obj = Pattern(pattern)\n\n    compiled_regex = pattern_obj.compile()\n\n    engine = RegexEngine()\n    match_result = engine.search(source_string_obj.text, compiled_regex)\n\n    if match_result is None:\n        return None\n    else:\n        return (match_result.substring, match_result.startIndex, match_result.endIndex)"}
{"task_id": "Mbpp/614", "solution": "def _is_numeric(value):\n    \"\"\"Internal helper returning True if value is int or float (bool excluded).\"\"\"\n    return isinstance(value, (int, float)) and not isinstance(value, bool)\n\ndef _validate_input(tuple_list):\n    \"\"\"Internal helper. Raises TypeError if tuple_list is not a list, contains non-tuple items, or contains non-numeric tuple elements.\"\"\"\n    if not isinstance(tuple_list, list):\n        raise TypeError(\"Input must be a list.\")\n    for item in tuple_list:\n        if not isinstance(item, tuple):\n            raise TypeError(\"All elements in the input list must be tuples.\")\n        for value in item:\n            if not _is_numeric(value):\n                raise TypeError(\"All elements within tuples must be numeric (int or float).\")\n\ndef cummulative_sum(tuple_list):\n    \"\"\"Public API. Expects tuple_list to be a list whose elements are tuples of numeric values (int or float). Returns numeric total or raises TypeError on invalid input.\"\"\"\n    _validate_input(tuple_list)\n\n    total = 0\n    for tpl in tuple_list:\n        for value in tpl:\n            total += value\n    return total"}
{"task_id": "Mbpp/612", "solution": "from typing import Any, List\n\ndef merge(pairs: List[List[Any]]) -> List[List[Any]]:\n    \"\"\"Merges a list of 2-element sublists into two separate lists.\n\n    Raises ValueError for invalid input (e.g., non-list input or sublists not of length 2).\n    \"\"\"\n    if pairs == []:\n        return [[], []]\n    if not isinstance(pairs, list):\n        raise ValueError(\"pairs must be a list of 2-element sublists\")\n    first_list: List[Any] = []\n    second_list: List[Any] = []\n    for idx, pair in enumerate(pairs):\n        try:\n            if len(pair) != 2:\n                raise ValueError(f\"sublist at index {idx} does not contain exactly two elements: {pair}\")\n        except TypeError:\n            # pair is not a sequence with len()\n            raise ValueError(f\"sublist at index {idx} is not a sequence with length 2: {pair}\")\n        first_list.append(pair[0])\n        second_list.append(pair[1])\n    return [first_list, second_list]"}
{"task_id": "Mbpp/615", "solution": "from dataclasses import dataclass\nfrom typing import List, Tuple, Union\n\n@dataclass\nclass NumericElement:\n    \"\"\"Wraps a numeric value (int or float) as a domain object.\"\"\"\n    value: float\n\n@dataclass\nclass InnerTuple:\n    \"\"\"Represents an inner tuple with NumericElement instances.\"\"\"\n    elements: Tuple[NumericElement, ...]\n\n    def sum(self) -> float:\n        \"\"\"Calculates the sum of wrapped numeric elements.\"\"\"\n        return sum(e.value for e in self.elements)\n\n    def count(self) -> int:\n        \"\"\"Returns the number of wrapped numeric elements.\"\"\"\n        return len(self.elements)\n\n@dataclass\nclass TupleOfTuples:\n    \"\"\"A carrier for an outer tuple of InnerTuple instances.\"\"\"\n    tuples: Tuple[InnerTuple, ...]\n\n@dataclass\nclass AverageResult:\n    \"\"\"Container for a list of computed averages.\"\"\"\n    values: List[float]\n\nclass AverageCalculator:\n    \"\"\"Encapsulates the logic for computing averages.\"\"\"\n    def __init__(self, raw_tuple_of_tuples: Tuple[Tuple[Union[int, float], ...], ...]):\n        # Converts raw input into the domain model: TupleOfTuples of InnerTuples of NumericElements.\n        inner_tuples_model = []\n        for inner_raw_tup in raw_tuple_of_tuples:\n            numeric_elements = tuple(NumericElement(value=float(x)) for x in inner_raw_tup)\n            inner_tuples_model.append(InnerTuple(elements=numeric_elements))\n        \n        self._data: TupleOfTuples = TupleOfTuples(tuples=tuple(inner_tuples_model))\n\n    def compute(self) -> List[float]:\n        \"\"\"Computes the average for each inner tuple.\"\"\"\n        averages: List[float] = []\n        for inner_tuple in self._data.tuples:\n            # As per constraints, assumes valid input and no explicit checks for edge cases\n            # like empty inner tuples (which would cause ZeroDivisionError).\n            avg = inner_tuple.sum() / inner_tuple.count()\n            averages.append(avg)\n        return AverageResult(values=averages).values\n\ndef average_tuple(tuple_of_tuples: Tuple[Tuple[Union[int, float], ...], ...]) -> List[float]:\n    \"\"\"\n    Calculates the average value for each inner tuple in a tuple of tuples.\n    \"\"\"\n    calculator = AverageCalculator(tuple_of_tuples)\n    return calculator.compute()"}
{"task_id": "Mbpp/618", "solution": "class LengthMismatchError(Exception):\n    \"Raised when input lists differ in length.\"\n    pass\n\nclass DivisionByZeroError(Exception):\n    \"Raised when denominator list contains zero.\"\n    pass\n\nclass TypeValidationError(TypeError):\n    \"Raised when any input element is not numeric (int or float).\"\n    pass\n\nclass Validator:\n    \"\"\"Helper class to encapsulate validation logic.\"\"\"\n    def validate_lengths(self, a: list, b: list) -> None:\n        \"Raise LengthMismatchError if len(a) != len(b).\"\n        if len(a) != len(b):\n            raise LengthMismatchError(\"Input lists must have the same length.\")\n\n    def validate_numeric(self, a: list, b: list) -> None:\n        \"Raise TypeValidationError if any element is not int or float.\"\n        for x in a + b:\n            if not isinstance(x, (int, float)):\n                raise TypeValidationError(\"All elements in input lists must be numeric (int or float).\")\n\n    def validate_no_zero_in_denominator(self, b: list) -> None:\n        \"Raise DivisionByZeroError if any element in b == 0.\"\n        if 0 in b:\n            raise DivisionByZeroError(\"Denominator list cannot contain zero.\")\n\ndef div_list(a: list, b: list) -> list[float]:\n    \"\"\"\n    Perform element-wise division of lists a and b and return a list of floats.\n    Input lists are validated for equal length, numeric elements, and no division by zero.\n    \"\"\"\n    validator = Validator()\n\n    validator.validate_lengths(a, b)\n    validator.validate_numeric(a, b)\n    validator.validate_no_zero_in_denominator(b)\n\n    results: list[float] = []\n    for i in range(len(a)):\n        results.append(float(a[i]) / float(b[i]))\n\n    return results"}
{"task_id": "Mbpp/622", "solution": "class ValidationError(Exception):\n    \"\"\"Exception raised for validation errors.\"\"\"\n    pass\n\nclass ValidationResult:\n    \"\"\"Represents the outcome of a validation check.\"\"\"\n    def __init__(self, ok: bool, message: str = \"\"):\n        self.ok = ok\n        self.message = message\n\nclass ListInput:\n    \"\"\"Wraps an input list and provides utility methods.\"\"\"\n    def __init__(self, values: list):\n        self.values = values\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the wrapped list.\"\"\"\n        return len(self.values)\n\n    def is_sorted(self) -> bool:\n        \"\"\"Checks if the wrapped list is sorted non-decreasingly.\"\"\"\n        if not self.values:\n            return True\n        for i in range(len(self.values) - 1):\n            if self.values[i] > self.values[i+1]:\n                return False\n        return True\n\nclass Validation:\n    \"\"\"Performs validation checks on ListInput instances.\"\"\"\n    def validate_length(self, input_list: ListInput, n: int) -> ValidationResult:\n        \"\"\"Validates if the list length matches n.\"\"\"\n        if input_list.length() != n:\n            return ValidationResult(ok=False, message=f\"List length mismatch: expected {n}, got {input_list.length()}.\")\n        return ValidationResult(ok=True)\n\n    def validate_sorted(self, input_list: ListInput) -> ValidationResult:\n        \"\"\"Validates if the list is sorted non-decreasingly.\"\"\"\n        if not input_list.is_sorted():\n            return ValidationResult(ok=False, message=\"List is not sorted non-decreasingly.\")\n        return ValidationResult(ok=True)\n\nclass MedianService:\n    \"\"\"Orchestrates validation and median computation.\"\"\"\n\n    def get_median(self, list1: list, list2: list, n: int) -> float:\n        \"\"\"Validates inputs, merges lists, and computes the median.\"\"\"\n        input1 = ListInput(list1)\n        input2 = ListInput(list2)\n        validator = Validation()\n\n        res_len1 = validator.validate_length(input1, n)\n        if not res_len1.ok:\n            raise ValidationError(res_len1.message)\n        res_len2 = validator.validate_length(input2, n)\n        if not res_len2.ok:\n            raise ValidationError(res_len2.message)\n\n        res_sorted1 = validator.validate_sorted(input1)\n        if not res_sorted1.ok:\n            raise ValidationError(res_sorted1.message)\n        res_sorted2 = validator.validate_sorted(input2)\n        if not res_sorted2.ok:\n            raise ValidationError(res_sorted2.message)\n\n        merged_list = self._merge_sorted(list1, list2)\n        return self._compute_median_from_merged(merged_list)\n\n    def _merge_sorted(self, a: list, b: list) -> list:\n        \"\"\"Merges two sorted lists into a single sorted list.\"\"\"\n        merged = []\n        i, j = 0, 0\n        while i < len(a) and j < len(b):\n            if a[i] <= b[j]:\n                merged.append(a[i])\n                i += 1\n            else:\n                merged.append(b[j])\n                j += 1\n        merged.extend(a[i:])\n        merged.extend(b[j:])\n        return merged\n\n    def _compute_median_from_merged(self, merged: list) -> float:\n        \"\"\"Computes the median from a single sorted list.\"\"\"\n        total_len = len(merged)\n        if total_len == 0:\n            return 0.0 # This case should be prevented by input validation (n >= 1).\n\n        if total_len % 2 == 1:\n            return float(merged[total_len // 2])\n        else:\n            mid1 = merged[total_len // 2 - 1]\n            mid2 = merged[total_len // 2]\n            return (float(mid1) + float(mid2)) / 2.0\n\ndef get_median(list1: list, list2: list, n: int) -> float:\n    \"\"\"\n    Finds the median of two sorted lists of the same size.\n    Validates inputs, merges lists, and computes the median.\n    \"\"\"\n    median_service = MedianService()\n    return median_service.get_median(list1, list2, n)"}
{"task_id": "Mbpp/619", "solution": "class Character:\n    \"\"\"Base class for characters, providing value, position, and digit classification.\"\"\"\n    def __init__(self, value: str, position: int):\n        self.value = value\n        self.position = position\n\n    def isDigit(self) -> bool:\n        \"\"\"Checks if the character's value is an ASCII digit ('0'-'9').\"\"\"\n        return '0' <= self.value <= '9'\n\nclass DigitCharacter(Character):\n    \"\"\"Represents a character that is a digit.\"\"\"\n    def isDigit(self) -> bool:\n        \"\"\"Always returns True for a DigitCharacter.\"\"\"\n        return True\n\nclass NonDigitCharacter(Character):\n    \"\"\"Represents a character that is not a digit.\"\"\"\n    def isDigit(self) -> bool:\n        \"\"\"Always returns False for a NonDigitCharacter.\"\"\"\n        return False\n\ndef _parse_characters(input_str: str) -> list[Character]:\n    \"\"\"Parses the input string into a list of Character objects, preserving order.\"\"\"\n    chars = []\n    for index, char_value in enumerate(input_str):\n        if '0' <= char_value <= '9':\n            chars.append(DigitCharacter(value=char_value, position=index))\n        else:\n            chars.append(NonDigitCharacter(value=char_value, position=index))\n    return chars\n\ndef _split_digits_non_digits(chars: list[Character]) -> tuple[list[Character], list[Character]]:\n    \"\"\"Splits a list of Character objects into two lists: non-digits and digits, preserving original relative order within each group.\"\"\"\n    non_digits = []\n    digits = []\n    for char in chars:\n        if char.isDigit():\n            digits.append(char)\n        else:\n            non_digits.append(char)\n    return non_digits, digits\n\ndef _concat_char_lists(non_digits: list[Character], digits: list[Character]) -> str:\n    \"\"\"Concatenates the values from two lists of Character objects into a single string.\"\"\"\n    result_parts = []\n    for char in non_digits:\n        result_parts.append(char.value)\n    for char in digits:\n        result_parts.append(char.value)\n    return \"\".join(result_parts)\n\ndef move_num(input_str: str) -> str:\n    \"\"\"\n    Moves all numeric characters to the end of the given string,\n    preserving the relative order of non-numeric and numeric characters.\n    \"\"\"\n    if not input_str:\n        return \"\"\n\n    parsed_chars = _parse_characters(input_str)\n    non_digits, digits = _split_digits_non_digits(parsed_chars)\n    result = _concat_char_lists(non_digits, digits)\n    return result"}
{"task_id": "Mbpp/620", "solution": "from typing import List\n\nclass IntegerElement:\n    \"\"\"Represents an integer value along with its original index.\"\"\"\n    def __init__(self, value: int, index: int):\n        self.value = value\n        self.index = index\n\n    def divides(self, other: 'IntegerElement') -> bool:\n        \"\"\"Checks if self.value divides other.value. Handles zero values.\"\"\"\n        if self.value == 0:\n            return other.value == 0\n        else:\n            return other.value % self.value == 0\n\n    def __lt__(self, other: 'IntegerElement') -> bool:\n        \"\"\"Enables sorting IntegerElement objects by their value.\"\"\"\n        return self.value < other.value\n\nclass DivisibleSubset:\n    \"\"\"Represents a candidate subset and provides methods for validation.\"\"\"\n    def __init__(self, elements: List[IntegerElement]):\n        self.elements = elements\n\n    def is_pairwise_divisible(self) -> bool:\n        \"\"\"Verifies that every pair (a, b) in the subset satisfies (a|b or b|a).\"\"\"\n        n = len(self.elements)\n        if n <= 1:\n            return True\n        for i in range(n):\n            for j in range(i + 1, n):\n                a = self.elements[i]\n                b = self.elements[j]\n                if not (a.divides(b) or b.divides(a)):\n                    return False\n        return True\n\n    def size(self) -> int:\n        \"\"\"Returns the number of elements in the subset.\"\"\"\n        return len(self.elements)\n\nclass LargestSubsetFunction:\n    \"\"\"Encapsulates the algorithm to find the size of the largest pairwise-divisible subset.\"\"\"\n    def largest_subset(self, numbers: List[int]) -> int:\n        \"\"\"Handles input validation, normalization, and delegates to the core algorithm.\"\"\"\n        if not numbers:\n            return 0\n        if len(numbers) == 1:\n            return 1\n\n        elements = [IntegerElement(value, i) for i, value in enumerate(numbers)]\n        elements.sort()\n\n        return self._build_max_chain(elements)\n\n    def _build_max_chain(self, elements: List[IntegerElement]) -> int:\n        \"\"\"Computes the size of the longest divisible chain using dynamic programming.\"\"\"\n        n = len(elements)\n        if n == 0:\n            return 0\n\n        dp = [1] * n\n        max_len = 1\n\n        for i in range(n):\n            for j in range(i):\n                if elements[j].divides(elements[i]):\n                    dp[i] = max(dp[i], dp[j] + 1)\n            max_len = max(max_len, dp[i])\n            \n        return max_len\n\ndef largest_subset(numbers: List[int]) -> int:\n    \"\"\"Finds the size of the largest subset of numbers where every pair is divisible.\n    This public API delegates the computation to an encapsulated algorithm class.\"\"\"\n    algo = LargestSubsetFunction()\n    return algo.largest_subset(numbers)"}
{"task_id": "Mbpp/624", "solution": "def is_upper(input: str) -> str:\n    \"\"\"Return the uppercase form of input.\n\n    Precondition: input is of type str. If not, raise TypeError.\n    Postcondition: returned value == input.upper().\n    \"\"\"\n    if not isinstance(input, str):\n        raise TypeError(\"Input must be a string.\")\n    return input.upper()"}
{"task_id": "Mbpp/623", "solution": "def nth_nums(numbers, n):\n    \"\"\"\n    Computes the n-th power of each number in the given list.\n    Returns a new list with the results.\n    \"\"\"\n    return [num ** n for num in numbers]"}
{"task_id": "Mbpp/626", "solution": "class Triangle:\n    \"\"\"Represents a triangle with a given base and height.\"\"\"\n    def __init__(self, base: float, height: float):\n        self.base = base\n        self.height = height\n\n    def compute_area(self) -> float:\n        \"\"\"Computes and returns the area of the triangle.\"\"\"\n        return 0.5 * self.base * self.height\n\nclass Semicircle:\n    \"\"\"Represents a semicircle with a given radius.\"\"\"\n    def __init__(self, radius):\n        self.radius = radius\n\n    def get_max_inscribed_triangle(self) -> 'Triangle' | None:\n        \"\"\"Returns the largest inscribed triangle, or None if radius is invalid.\"\"\"\n        if self.radius < 0:\n            return None\n        # The largest triangle inscribed in a semicircle has its base along the diameter\n        # and its apex at the circumference.\n        # Its base is 2 * radius and its height is radius.\n        base = 2 * self.radius\n        height = self.radius\n        return Triangle(base, height)\n\nclass TriangleCalculator:\n    \"\"\"Encapsulates the logic for computing the area of the largest inscribed triangle.\"\"\"\n    @staticmethod\n    def triangle_area(radius) -> float | None:\n        \"\"\"Calculates the area of the largest triangle inscribed in a semicircle.\"\"\"\n        semicircle = Semicircle(radius)\n        triangle = semicircle.get_max_inscribed_triangle()\n        if triangle is None:\n            return None\n        return triangle.compute_area()\n\ndef triangle_area(radius) -> float | None:\n    \"\"\"\n    Calculates the area of the largest triangle that can be inscribed in a semicircle with a given radius.\n    Returns None if the radius is negative.\n    \"\"\"\n    return TriangleCalculator.triangle_area(radius)"}
{"task_id": "Mbpp/628", "solution": "def replace_spaces(input_str: str) -> str:\n    \"\"\"\n    Replaces all spaces in the given string with '%20'.\n    Iterates through characters, substituting ' ' with '%20' and preserving others.\n    \"\"\"\n    result_chars = []\n    for char in input_str:\n        if char == ' ':\n            result_chars.append('%20')\n        else:\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/630", "solution": "from typing import List, Tuple, Any\n\nclass Coordinate:\n    \"\"\"Represents a single coordinate (x, y) and provides conversion to a list.\"\"\"\n    def __init__(self, x: int, y: int):\n        self.x = x\n        self.y = y\n\n    def toList(self) -> List[int]:\n        \"\"\"Returns the coordinate as a two-element integer list [x, y].\"\"\"\n        return [self.x, self.y]\n\n    def __eq__(self, other: Any) -> bool:\n        if not isinstance(other, Coordinate):\n            return NotImplemented\n        return self.x == other.x and self.y == other.y\n\n    def __hash__(self) -> int:\n        return hash((self.x, self.y))\n\n\nclass CoordinateSet:\n    \"\"\"Holds and orders Coordinate objects, providing conversion to a list of lists.\"\"\"\n    def __init__(self, coordinates: List[Coordinate]):\n        self.coordinates = coordinates\n\n    def size(self) -> int:\n        \"\"\"Returns the number of coordinates in the set.\"\"\"\n        return len(self.coordinates)\n\n    def toListOfLists(self) -> List[List[int]]:\n        \"\"\"Converts the ordered set of coordinates to a list of two-element integer lists.\"\"\"\n        return [coord.toList() for coord in self.coordinates]\n\n\nclass Validator:\n    \"\"\"Validates input center conforms to a 2-tuple of integers.\"\"\"\n    @staticmethod\n    def validate_center(center: Any) -> bool:\n        \"\"\"Validates the center input. Raises ValueError if invalid.\"\"\"\n        if not isinstance(center, tuple):\n            raise ValueError(\"Input center must be a tuple.\")\n        if len(center) != 2:\n            raise ValueError(\"Input center tuple must have exactly two elements.\")\n        if not all(isinstance(coord, int) for coord in center):\n            raise ValueError(\"Input center tuple elements must be integers.\")\n        return True\n\n\nclass CoordinateGridGenerator:\n    \"\"\"Generates the ordered 3x3 neighborhood around a given center coordinate.\"\"\"\n    def get_coordinates(self, center: Tuple[int, int]) -> CoordinateSet:\n        \"\"\"Builds an ordered CoordinateSet for the 3x3 grid centered on (x, y).\"\"\"\n        center_x, center_y = center\n        generated_coords: List[Coordinate] = []\n\n        # Generate coordinates row by row, then column by column\n        for dx in range(-1, 2):  # offsets for x: -1, 0, 1\n            current_x = center_x + dx\n            for dy in range(-1, 2):  # offsets for y: -1, 0, 1\n                current_y = center_y + dy\n                generated_coords.append(Coordinate(current_x, current_y))\n\n        return CoordinateSet(generated_coords)\n\n\ndef get_coordinates(center: Tuple[int, int]) -> List[List[int]]:\n    \"\"\"\n    Extracts all the adjacent coordinates of the given coordinate tuple, including itself.\n    The result is a 3x3 grid, ordered by row then by column.\n    \"\"\"\n    Validator.validate_center(center)\n    generator = CoordinateGridGenerator()\n    coord_set = generator.get_coordinates(center)\n    return coord_set.toListOfLists()"}
{"task_id": "Mbpp/629", "solution": "def Split(inputList: list) -> list:\n    \"\"\"Filters even numbers from a list, preserving order.\"\"\"\n    even_numbers = []\n    for number in inputList:\n        if number % 2 == 0:\n            even_numbers.append(number)\n    return even_numbers"}
{"task_id": "Mbpp/632", "solution": "def move_zero(input_list):\n    \"\"\"\n    Moves all zeroes to the end of the given list, preserving the relative order of non-zero elements.\n    Returns a new list with the modified order.\n    \"\"\"\n    non_zeros = []\n    zeros = []\n    for element in input_list:\n        if element == 0:\n            zeros.append(element)\n        else:\n            non_zeros.append(element)\n    return non_zeros + zeros"}
{"task_id": "Mbpp/631", "solution": "def replace_spaces(input_string, reverse=False):\n    \"\"\"\n    Replaces whitespaces with underscores or vice versa in a given string.\n    If reverse is False, spaces, tabs, and newlines are replaced with underscores.\n    \"\"\"\n    transformed_chars = []\n    if not reverse:\n        for char in input_string:\n            if char in (' ', '\\t', '\\n'):\n                transformed_chars.append('_')\n            else:\n                transformed_chars.append(char)\n    else:\n        for char in input_string:\n            if char == '_':\n                transformed_chars.append(' ')\n            else:\n                transformed_chars.append(char)\n\n    return \"\".join(transformed_chars)"}
{"task_id": "Mbpp/637", "solution": "from typing import Union\n\nclass Amount:\n    \"\"\"Immutable data holder for a numeric amount value.\"\"\"\n    def __init__(self, value: Union[int, float]) -> None:\n        self.value: float = float(value)\n\nclass Result:\n    \"\"\"Immutable holder for Boolean outcome.\"\"\"\n    def __init__(self, is_no_profit_no_loss: bool) -> None:\n        self.is_no_profit_no_loss: bool = is_no_profit_no_loss\n\nclass ProfitLossChecker:\n    \"\"\"Compares two numeric amounts and produces a Result.\"\"\"\n    def noprofit_noloss(self, amount1: Union[int, float], amount2: Union[int, float]) -> Result:\n        a1 = float(amount1)\n        a2 = float(amount2)\n        result_bool = (a1 == a2)\n        return Result(result_bool)\n\ndef noprofit_noloss(amount1: Union[int, float], amount2: Union[int, float]) -> bool:\n    \"\"\"Checks whether the given amount has no profit and no loss.\"\"\"\n    checker = ProfitLossChecker()\n    result = checker.noprofit_noloss(amount1, amount2)\n    return result.is_no_profit_no_loss"}
{"task_id": "Mbpp/635", "solution": "class Heap:\n    \"\"\"Helper class to implement max-heap operations.\"\"\"\n    def __init__(self):\n        self._data: list = []\n\n    def _leftChild(self, i: int) -> int:\n        \"\"\"Returns the index of the left child.\"\"\"\n        return 2 * i + 1\n\n    def _rightChild(self, i: int) -> int:\n        \"\"\"Returns the index of the right child.\"\"\"\n        return 2 * i + 2\n\n    def siftDown(self, index: int, size: int) -> None:\n        \"\"\"Sifts element at index down within internal heap up to size to maintain max-heap property.\"\"\"\n        max_idx = index\n        l = self._leftChild(index)\n        r = self._rightChild(index)\n\n        if l < size and self._data[l] > self._data[max_idx]:\n            max_idx = l\n        if r < size and self._data[r] > self._data[max_idx]:\n            max_idx = r\n\n        if max_idx != index:\n            self._data[index], self._data[max_idx] = self._data[max_idx], self._data[index]\n            self.siftDown(max_idx, size)\n\n    def buildHeap(self, arr: list) -> None:\n        \"\"\"Builds internal max-heap from arr (arr is copied internally).\"\"\"\n        self._data = arr[:] # Create a copy of the input list\n        n = len(self._data)\n        for i in range(n // 2 - 1, -1, -1):\n            self.siftDown(i, n)\n\n    def extract(self, size: int):\n        \"\"\"Swaps the root with the last element of the current heap and sifts down to re-heapify.\"\"\"\n        if size == 0:\n            return None \n        \n        # Swap root (largest element) with the last element of the current logical heap\n        self._data[0], self._data[size - 1] = self._data[size - 1], self._data[0]\n        \n        # Sift down the new root to maintain heap property for the reduced heap size\n        self.siftDown(0, size - 1)\n        \n        # Return the original root element (which is now at position size - 1 in the array)\n        return self._data[size - 1]\n\n\ndef heap_sort(lst: list) -> list:\n    \"\"\"Accepts a Python list of comparable elements and returns a new list sorted ascending.\"\"\"\n    if not lst:\n        return []\n\n    my_heap = Heap()\n    my_heap.buildHeap(lst)\n\n    # Perform the in-place sorting by repeatedly moving the max element\n    # to the end of the current (decreasing) heap portion.\n    n = len(my_heap._data)\n    for i in range(n, 0, -1):\n        my_heap.extract(i) # This moves the largest remaining element to my_heap._data[i-1]\n\n    return my_heap._data"}
{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(nums, n):\n    \"\"\"\n    Computes the sum of XORs for all unordered pairs among the first n elements of nums.\n    Returns 0 if n is less than 2, otherwise computes the sum.\n    \"\"\"\n    if n < 2:\n        return 0\n\n    def _sum_pairwise_xors_internal(elements_list):\n        total_xor_sum = 0\n        num_elements = len(elements_list)\n        for i in range(num_elements):\n            for j in range(i + 1, num_elements):\n                total_xor_sum += (elements_list[i] ^ elements_list[j])\n        return total_xor_sum\n\n    first_n_elements = nums[:n]\n\n    return _sum_pairwise_xors_internal(first_n_elements)"}
{"task_id": "Mbpp/638", "solution": "import math\n\nclass Measurement:\n    \"\"\"Represents input wind velocity and temperature.\"\"\"\n    def __init__(self, velocity_kmh: float, temperature_celsius: float):\n        self.velocity_kmh = velocity_kmh\n        self.temperature_celsius = temperature_celsius\n\nclass InputValidator:\n    \"\"\"Validates numeric input values.\"\"\"\n    def validate_measurement(self, measurement: Measurement) -> None:\n        \"\"\"Ensures measurement fields are convertible to float, raising ValueError otherwise.\"\"\"\n        float(measurement.velocity_kmh)\n        float(measurement.temperature_celsius)\n\nclass WindChillCalculator:\n    \"\"\"Calculates wind chill index using a standard formula and applies ceiling rounding.\"\"\"\n    def calculateWindChill(self, velocity_kmh: float, temperature_celsius: float) -> int:\n        \"\"\"Computes the raw wind chill index and applies ceiling rounding to the result.\"\"\"\n        raw_wind_chill = self._computeFormula(velocity_kmh, temperature_celsius)\n        return self._applyCeiling(raw_wind_chill)\n\n    def _computeFormula(self, v_kmh: float, t_c: float) -> float:\n        \"\"\"\n        Uses the standard Canadian Wind Chill Index formula (2001) for km/h and Celsius.\n        This formula satisfies the acceptance test wind_chill(120, 35) == 40.\n        \"\"\"\n        v_power_0_16 = v_kmh**0.16\n        return (13.12 + (0.6215 * t_c) - (11.37 * v_power_0_16) + (0.3965 * t_c * v_power_0_16))\n\n    def _applyCeiling(self, value: float) -> int:\n        \"\"\"Rounds a float value up to the next integer using math.ceil.\"\"\"\n        return math.ceil(value)\n\ndef wind_chill(velocity_kmh, temperature_celsius) -> int:\n    \"\"\"\n    Calculates the wind chill index rounded to the next integer.\n    Given wind velocity in km/h and temperature in Celsius.\n    \"\"\"\n    measurement = Measurement(velocity_kmh, temperature_celsius)\n    validator = InputValidator()\n    validator.validate_measurement(measurement)\n    calculator = WindChillCalculator()\n    return calculator.calculateWindChill(measurement.velocity_kmh, measurement.temperature_celsius)"}
{"task_id": "Mbpp/641", "solution": "from dataclasses import dataclass\nfrom typing import Any\n\nclass InputParameter:\n    \"\"\"Encapsulates raw parameter and validation logic.\"\"\"\n    def __init__(self, n: Any) -> None:\n        self.n = n\n\n    def validate(self) -> int:\n        \"\"\"Validates n; returns validated int or raises ValueError.\"\"\"\n        if not isinstance(self.n, int) or self.n < 1:\n            raise ValueError(\"n must be an integer >= 1\")\n        return self.n\n\n@dataclass\nclass NonagonalNumber:\n    \"\"\"A data holder for a nonagonal number value.\"\"\"\n    value: int\n\ndef is_nonagonal(n: int) -> int:\n    \"\"\"\n    Computes the nth nonagonal number.\n    Raises ValueError if n is not an integer >= 1.\n    \"\"\"\n    param = InputParameter(n)\n    n_valid = param.validate()\n    \n    numerator = 7 * n_valid * n_valid - 5 * n_valid\n    value = numerator // 2\n    \n    return value"}
{"task_id": "Mbpp/639", "solution": "from typing import List\n\nclass Name:\n    \"\"\"Encapsulates a name string and provides helper methods.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def firstChar(self) -> str:\n        \"\"\"Returns the first character of the name, or an empty string if the name is empty.\"\"\"\n        return self.value[0] if self.value else ''\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the name.\"\"\"\n        return len(self.value)\n\n    def startsWithLowercase(self) -> bool:\n        \"\"\"Checks if the name starts with an ASCII lowercase letter (a-z).\"\"\"\n        ch = self.firstChar()\n        return 'a' <= ch <= 'z'\n\nclass NameList:\n    \"\"\"Holds a list of Name instances.\"\"\"\n    def __init__(self, names: List[str]):\n        self.names = [Name(s) for s in names]\n\n    def size(self) -> int:\n        \"\"\"Returns the number of names in the list.\"\"\"\n        return len(self.names)\n\nclass Filter:\n    \"\"\"A stateless service to filter Name objects.\"\"\"\n    def filterLowercase(self, input: List[Name]) -> List[Name]:\n        \"\"\"Removes names whose first character is ASCII lowercase.\"\"\"\n        return [n for n in input if not n.startsWithLowercase()]\n\nclass LengthCalculator:\n    \"\"\"A stateless service to sum the lengths of Name objects.\"\"\"\n    def sumLengths(self, input: List[Name]) -> int:\n        \"\"\"Calculates the total length of all names in the list.\"\"\"\n        return sum(n.length() for n in input)\n\nclass Result:\n    \"\"\"Encapsulates an integer output value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\ndef sample_nam(names: List[str]) -> int:\n    \"\"\"\n    Sums the length of names after removing those that start with a lowercase letter.\n    \"\"\"\n    name_list_obj = NameList(names)\n    \n    filter_service = Filter()\n    filtered_names = filter_service.filterLowercase(name_list_obj.names)\n    \n    length_calculator_service = LengthCalculator()\n    total_length = length_calculator_service.sumLengths(filtered_names)\n    \n    return total_length"}
{"task_id": "Mbpp/643", "solution": "class TextInput:\n    \"\"\"Encapsulates the input string and provides helper accessors.\"\"\"\n    def __init__(self, raw: str):\n        self.raw = raw\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the raw string.\"\"\"\n        return len(self.raw)\n\n    def char_at(self, index: int) -> str:\n        \"\"\"\n        Returns the character at the specified index.\n        Returns an empty string for out-of-range indices.\n        \"\"\"\n        if 0 <= index < self.length():\n            return self.raw[index]\n        return \"\"\n\nclass LetterClassifier:\n    \"\"\"Stateless utility to determine if a character is an ASCII letter.\"\"\"\n    def is_ascii_letter(self, c: str) -> bool:\n        \"\"\"Checks if the given character is an ASCII letter (A-Z or a-z).\"\"\"\n        return len(c) == 1 and c.isalpha() and c.isascii()\n\nclass WordBoundaryChecker:\n    \"\"\"Determines whether a character should be treated as a word boundary.\"\"\"\n    def __init__(self, letter_classifier: LetterClassifier):\n        self._letter_classifier = letter_classifier\n\n    def is_boundary(self, c: str) -> bool:\n        \"\"\"Returns True if the character is not an ASCII letter.\"\"\"\n        return not self._letter_classifier.is_ascii_letter(c)\n\nclass TextMatcher:\n    \"\"\"\n    Orchestrates scanning for 'z' characters and applying neighbor checks\n    to determine the match outcome.\n    \"\"\"\n    def __init__(self, letter_classifier: LetterClassifier, boundary_checker: WordBoundaryChecker):\n        self._letter_classifier = letter_classifier\n        self._boundary_checker = boundary_checker\n\n    def _checkZAt(self, index: int, input_text: TextInput) -> bool:\n        \"\"\"\n        Checks if characters immediately before and after the 'z' at 'index'\n        are ASCII letters.\n        \"\"\"\n        left_char = input_text.char_at(index - 1)\n        right_char = input_text.char_at(index + 1)\n        \n        is_left_letter = self._letter_classifier.is_ascii_letter(left_char)\n        is_right_letter = self._letter_classifier.is_ascii_letter(right_char)\n        \n        return is_left_letter and is_right_letter\n\n    def text_match_wordz_middle(self, text: str) -> bool:\n        \"\"\"\n        Scans the input text for 'z' characters and checks if they are\n        surrounded by ASCII letters.\n        \"\"\"\n        input_text = TextInput(text)\n        \n        for i in range(input_text.length()):\n            if input_text.char_at(i) == 'z':\n                if self._checkZAt(i, input_text):\n                    return True\n        return False\n\ndef text_match_wordz_middle(text: str) -> bool:\n    \"\"\"\n    Checks if the string contains 'z' with ASCII letter neighbors\n    immediately before and after.\n    \"\"\"\n    letter_classifier = LetterClassifier()\n    boundary_checker = WordBoundaryChecker(letter_classifier)\n    text_matcher = TextMatcher(letter_classifier, boundary_checker)\n    return text_matcher.text_match_wordz_middle(text)"}
{"task_id": "Mbpp/644", "solution": "class Error:\n    def __init__(self, message: str):\n        self.message = message\n\nclass Validation:\n    @staticmethod\n    def validate_types(array, k):\n        if not isinstance(array, list):\n            raise TypeError(Error(\"The 'array' argument must be a list.\").message)\n        if not isinstance(k, int):\n            raise TypeError(Error(\"The 'k' argument must be an integer.\").message)\n\n    @staticmethod\n    def normalize_k(array, k) -> int:\n        if k <= 0:\n            return 0\n        if k >= len(array):\n            return len(array)\n        return k\n\nclass ReverseFunction:\n    @staticmethod\n    def reverseUpToK(array, k) -> list:\n        if k <= 0:\n            return array.copy()\n        if k >= len(array):\n            return array[::-1]\n        else:\n            return array[:k][::-1] + array[k:]\n\ndef reverse_Array_Upto_K(array, k):\n    \"\"\"\n    Reverses the first 'k' elements of an array and returns a new list.\n    The input array is not modified.\n    \"\"\"\n    Validation.validate_types(array, k)\n    effective_k = Validation.normalize_k(array, k)\n    result = ReverseFunction.reverseUpToK(array, effective_k)\n    return result"}
{"task_id": "Mbpp/720", "solution": "def add_dict_to_tuple(t, d) -> tuple:\n    \"\"\"Validate inputs and return a new tuple containing original tuple elements followed by d.\"\"\"\n    if not isinstance(t, tuple):\n        raise TypeError(\"first argument must be a tuple\")\n    if not isinstance(d, dict):\n        raise TypeError(\"second argument must be a dict\")\n    return t + (d,)"}
{"task_id": "Mbpp/722", "solution": "from typing import Dict, Tuple, Iterator\n\nclass Student:\n    \"\"\"Represents a single student record with name, height, and weight.\"\"\"\n    def __init__(self, name: str, height: float, weight: float) -> None:\n        self.name = name\n        self.height = height\n        self.weight = weight\n\n    def as_tuple(self) -> Tuple[float, float]:\n        \"\"\"Returns the student's height and weight as a tuple.\"\"\"\n        return (self.height, self.weight)\n\nclass StudentCollection:\n    \"\"\"Adapts an input dictionary of students to an iterable of Student objects.\"\"\"\n    def __init__(self, students_dict: Dict[str, Tuple[float, float]]) -> None:\n        self.students_dict = students_dict\n\n    def __iter__(self) -> Iterator[Student]:\n        \"\"\"Yields Student objects from the collection.\"\"\"\n        for name, (height, weight) in self.students_dict.items():\n            yield Student(name, height, weight)\n\nclass FilterCriteria:\n    \"\"\"Encapsulates the minimum height and weight for filtering.\"\"\"\n    def __init__(self, min_height: float, min_weight: float) -> None:\n        self.min_height = min_height\n        self.min_weight = min_weight\n\nclass FilterService:\n    \"\"\"Performs the core filtering logic based on provided criteria.\"\"\"\n    def __init__(self, input_collection: StudentCollection, criteria: FilterCriteria) -> None:\n        self.input_collection = input_collection\n        self.criteria = criteria\n\n    def filter(self) -> Dict[str, Tuple[float, float]]:\n        \"\"\"Filters students based on height > min_height and weight >= min_weight.\"\"\"\n        result_dict: Dict[str, Tuple[float, float]] = {}\n        for student in self.input_collection:\n            if student.height > self.criteria.min_height and student.weight >= self.criteria.min_weight:\n                result_dict[student.name] = student.as_tuple()\n        return result_dict\n\ndef filter_data(data: Dict[str, Tuple[float, float]], min_height: float, min_weight: float) -> Dict[str, Tuple[float, float]]:\n    \"\"\"Filters students based on height and weight criteria.\"\"\"\n    collection = StudentCollection(data)\n    criteria = FilterCriteria(min_height, min_weight)\n    service = FilterService(collection, criteria)\n    return service.filter()"}
{"task_id": "Mbpp/721", "solution": "class Validator:\n    def isNonEmpty(self, matrix) -> bool:\n        \"\"\"Checks if the matrix is non-empty and has valid rows/columns.\"\"\"\n        if not matrix or not isinstance(matrix, list):\n            return False\n        if not matrix[0] or not isinstance(matrix[0], list):\n            return False\n        return True\n\n    def isSquare(self, matrix) -> bool:\n        \"\"\"Checks if the matrix is square and contains only numeric entries.\"\"\"\n        if not self.isNonEmpty(matrix):\n            return False\n\n        n = len(matrix)\n        for row in matrix:\n            if not isinstance(row, list) or len(row) != n:\n                return False\n            for entry in row:\n                if not isinstance(entry, (int, float)):\n                    return False\n        return True\n\n    def raiseError(self, msg) -> None:\n        \"\"\"Raises a ValueError with the given message.\"\"\"\n        raise ValueError(msg)\n\nclass Cell:\n    \"\"\"Represents a cell in the matrix with its coordinates and cost.\"\"\"\n    def __init__(self, row: int, col: int, cost: float):\n        self.row = row\n        self.col = col\n        self.cost = float(cost)\n\nclass Matrix:\n    \"\"\"Represents the N x N grid of cells.\"\"\"\n    def __init__(self, matrix):\n        self.size = len(matrix)\n        self.cells = []\n        for r in range(self.size):\n            row_cells = []\n            for c in range(self.size):\n                row_cells.append(Cell(r, c, matrix[r][c]))\n            self.cells.append(row_cells)\n\n    def getCell(self, r: int, c: int) -> Cell:\n        \"\"\"Retrieves the Cell object at the specified row and column.\"\"\"\n        if 0 <= r < self.size and 0 <= c < self.size:\n            return self.cells[r][c]\n        raise IndexError(\"Cell coordinates out of bounds\")\n\nclass Path:\n    \"\"\"Represents a path as a sequence of Cell objects.\"\"\"\n    def __init__(self, cells: list[Cell]):\n        self.cells = cells\n        self.length = len(cells)\n\n    def totalCost(self) -> float:\n        \"\"\"Calculates the sum of costs of all cells in the path.\"\"\"\n        return sum(cell.cost for cell in self.cells)\n\n    def average(self) -> float:\n        \"\"\"Calculates the average cost per cell for the path.\"\"\"\n        if self.length == 0:\n            return 0.0\n        return self.totalCost() / self.length\n\nclass PathCalculator:\n    \"\"\"Generates all valid paths and calculates the maximum average.\"\"\"\n    def generatePaths(self, matrix_obj: Matrix) -> list[Path]:\n        \"\"\"Generates all valid paths from top-left to bottom-right using DFS.\"\"\"\n        all_paths = []\n        n = matrix_obj.size\n\n        if n == 1:\n            all_paths.append(Path([matrix_obj.getCell(0, 0)]))\n            return all_paths\n\n        def _dfs(current_row, current_col, current_path_cells):\n            # Base case: Reached the bottom-right cell\n            if current_row == n - 1 and current_col == n - 1:\n                all_paths.append(Path(list(current_path_cells)))\n                return\n\n            # Move right\n            if current_col + 1 < n:\n                current_path_cells.append(matrix_obj.getCell(current_row, current_col + 1))\n                _dfs(current_row, current_col + 1, current_path_cells)\n                current_path_cells.pop() # Backtrack\n\n            # Move down\n            if current_row + 1 < n:\n                current_path_cells.append(matrix_obj.getCell(current_row + 1, current_col))\n                _dfs(current_row + 1, current_col, current_path_cells)\n                current_path_cells.pop() # Backtrack\n\n        # Start DFS from (0,0)\n        _dfs(0, 0, [matrix_obj.getCell(0, 0)])\n        return all_paths\n\n    def computeTotalCost(self, path: Path) -> float:\n        \"\"\"Delegates total cost computation to the Path object.\"\"\"\n        return path.totalCost()\n\n    def computeAverage(self, path: Path) -> float:\n        \"\"\"Delegates average cost computation to the Path object.\"\"\"\n        return path.average()\n\n    def maxAverageOfPath(self, matrix_obj: Matrix) -> float:\n        \"\"\"Computes the maximum average among all paths in the given matrix.\"\"\"\n        if matrix_obj.size == 1:\n            return matrix_obj.getCell(0, 0).cost\n\n        paths = self.generatePaths(matrix_obj)\n        max_avg = -float('inf')\n        for path in paths:\n            max_avg = max(max_avg, self.computeAverage(path))\n        return max_avg\n\nclass Result:\n    \"\"\"A simple wrapper class to hold the maximum average value.\"\"\"\n    def __init__(self, maxAverage: float):\n        self.maxAverage = maxAverage\n\ndef maxAverageOfPath(matrix):\n    \"\"\"\n    Given a square matrix, finds a path from top-left to bottom-right\n    (moving only right or down) with the maximum average cost.\n    \"\"\"\n    validator = Validator()\n    if not validator.isNonEmpty(matrix) or not validator.isSquare(matrix):\n        validator.raiseError(\"Invalid input: must be non-empty square N x N matrix with numeric entries\")\n\n    matrix_obj = Matrix(matrix)\n    calculator = PathCalculator()\n    max_avg_value = calculator.maxAverageOfPath(matrix_obj)\n    \n    return max_avg_value"}
{"task_id": "Mbpp/725", "solution": "from typing import List\n\ndef extract_quotation(input_string: str) -> List[str]:\n    \"\"\"Public API per SRS. Returns list of substrings enclosed by paired double-quote characters in left-to-right order.\"\"\"\n    extracted_texts = []\n    in_quote = False\n    start_index = -1\n\n    for i, char in enumerate(input_string):\n        if char == '\"':\n            if not in_quote:\n                # Found opening quote\n                in_quote = True\n                start_index = i + 1\n            else:\n                # Found closing quote\n                in_quote = False\n                if start_index != -1: # Ensure a valid opening quote was found\n                    extracted_texts.append(input_string[start_index:i])\n                start_index = -1 # Reset for the next segment\n    return extracted_texts"}
{"task_id": "Mbpp/723", "solution": "def count_same_pair(list1, list2) -> int:\n    \"\"\"Counts indices where values in two lists are the same.\n\n    Raises ValueError if the input lists do not have equal length.\n    \"\"\"\n    if len(list1) != len(list2):\n        raise ValueError(\"input lists must have equal length\")\n\n    count = 0\n    for i in range(len(list1)):\n        if list1[i] == list2[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/724", "solution": "class InputParameters:\n    \"\"\"Holds the base and power input values.\"\"\"\n    def __init__(self, base: int, power: int) -> None:\n        self.base = base\n        self.power = power\n\nclass PowerComputation:\n    \"\"\"Provides utilities for input validation and power computation.\"\"\"\n    @staticmethod\n    def validateInputs(base: int, power: int) -> bool:\n        \"\"\"Validates that base and power are integers and power is non-negative.\"\"\"\n        if not isinstance(base, int) or not isinstance(power, int):\n            return False\n        if power < 0:\n            return False\n        return True\n\n    @staticmethod\n    def computePower(base: int, power: int) -> int:\n        \"\"\"Computes base**power using Python's arbitrary-precision integers.\"\"\"\n        return base ** power\n\nclass DigitSum:\n    \"\"\"Computes the sum of all decimal digits of an absolute integer.\"\"\"\n    @staticmethod\n    def sumDigits(n: int) -> int:\n        \"\"\"Calculates the sum of digits for the absolute value of n.\"\"\"\n        return sum(int(digit) for digit in str(abs(n)))\n\nclass Result:\n    \"\"\"Container for the computed digit sum.\"\"\"\n    def __init__(self, digitSum: int) -> None:\n        self.digitSum = digitSum\n\ndef power_base_sum(base: int, power: int) -> int:\n    \"\"\"\n    Calculates the sum of all digits of the base to the specified power.\n    Python's 'int' type automatically handles arbitrary-precision integers (BigInt).\n    \"\"\"\n    # Create InputParameters - though not directly used in the next step,\n    # it aligns with the design's object flow.\n    # input_params = InputParameters(base, power)\n\n    if not PowerComputation.validateInputs(base, power):\n        raise ValueError(\"base and power must be integers and power must be >= 0\")\n\n    power_result = PowerComputation.computePower(base, power)\n    digit_sum = DigitSum.sumDigits(power_result)\n    \n    result_obj = Result(digit_sum)\n    return result_obj.digitSum"}
{"task_id": "Mbpp/726", "solution": "from typing import Tuple\n\ndef multiply_elements(input_tuple: Tuple) -> Tuple:\n    \"\"\"\n    Returns a tuple where each element is the product of adjacent elements from the input tuple.\n    Assumes input_tuple is a tuple of numbers with at least two elements.\n    \"\"\"\n    return tuple(input_tuple[i] * input_tuple[i+1] for i in range(len(input_tuple) - 1))"}
{"task_id": "Mbpp/728", "solution": "def sum_list(a, b):\n    \"\"\"\n    Computes the element-wise sum of two lists.\n    Assumes lists are of equal length and contain numeric types.\n    \"\"\"\n    return [x + y for x, y in zip(a, b)]"}
{"task_id": "Mbpp/730", "solution": "def consecutive_duplicates(input_list: list) -> list:\n    \"\"\"\n    Remove consecutive duplicates from input_list and return a new list.\n\n    Args:\n        input_list (list): Input sequence of elements. Elements must support equality comparison under runtime semantics.\n\n    Returns:\n        list: New list containing the first element of each consecutive run from input_list.\n    \"\"\"\n    if not input_list:\n        return []\n\n    result = [input_list[0]]\n\n    for i in range(1, len(input_list)):\n        current_element = input_list[i]\n        last_added_element = result[-1]\n\n        if current_element != last_added_element:\n            result.append(current_element)\n\n    return result"}
{"task_id": "Mbpp/731", "solution": "from math import sqrt, pi\n\ndef lateralsurface_cone(r, h) -> float:\n    \"\"\"Compute lateral surface area A = PI * r * l where l = sqrt(r^2 + h^2) and return as float.\"\"\"\n\n    def _computeSlantHeight(radius: float, height: float) -> float:\n        \"\"\"Compute sqrt(r*r + h*h).\"\"\"\n        return sqrt(radius * radius + height * height)\n\n    def _computeLateralSurface(radius: float, slant_height: float) -> float:\n        \"\"\"Compute PI * r * l.\"\"\"\n        return pi * radius * slant_height\n\n    l = _computeSlantHeight(r, h)\n    return _computeLateralSurface(r, l)"}
{"task_id": "Mbpp/732", "solution": "def replace_specialchar(input: str) -> str:\n    \"\"\"Replaces spaces, commas, and dots with colons in the input string.\"\"\"\n    TARGETS = {' ', ',', '.'}\n    REPLACEMENT = ':'\n\n    result_chars = []\n    for char in input:\n        if char in TARGETS:\n            result_chars.append(REPLACEMENT)\n        else:\n            result_chars.append(char)\n    return ''.join(result_chars)"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(input_list):\n    \"\"\"\n    Calculates the sum of products of all possible contiguous sublists.\n    \"\"\"\n    def _product_of_list(seq):\n        \"\"\"Calculates the product of all numbers in a sequence; returns 1 for an empty sequence.\"\"\"\n        product = 1\n        for num in seq:\n            product *= num\n        return product\n\n    def _generate_contiguous_subarrays(input_list):\n        \"\"\"Yields all contiguous subarrays from the given list.\"\"\"\n        n = len(input_list)\n        for i in range(n):\n            for j in range(i, n):\n                yield input_list[i : j + 1]\n\n    total_sum_of_products = 0\n    for subarray in _generate_contiguous_subarrays(input_list):\n        total_sum_of_products += _product_of_list(subarray)\n    return total_sum_of_products"}
{"task_id": "Mbpp/735", "solution": "def _bit_length(n: int) -> int:\n    \"\"\"Compute number of bits in n's binary representation.\"\"\"\n    return n.bit_length()\n\ndef _has_enough_bits(bit_length: int) -> bool:\n    \"\"\"Return True if bit_length >= 3, otherwise False.\"\"\"\n    return bit_length >= 3\n\ndef compute_mask(bit_length: int) -> int:\n    \"\"\"\n    Compute an integer mask with 1s in positions strictly between MSB and LSB\n    for the given bit length, ensuring zeros at MSB and LSB positions.\n    \"\"\"\n    if bit_length < 3:\n        return 0\n    # Create a sequence of 'bit_length - 2' ones and shift them left by 1.\n    num_middle_bits = bit_length - 2\n    mask = ((1 << num_middle_bits) - 1) << 1\n    return mask\n\ndef toggle_middle_bits(n: int) -> int:\n    \"\"\"\n    Toggles bits of the number except the first (MSB) and the last (LSB) bit.\n    Returns the input unchanged if its binary representation has fewer than three bits.\n    \"\"\"\n    bit_length = _bit_length(n)\n\n    if not _has_enough_bits(bit_length):\n        return n\n    \n    mask = compute_mask(bit_length)\n    return n ^ mask"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(array, target):\n    \"\"\"\n    Finds the index of the first occurrence of a target number in a sorted array.\n    Raises ValueError if array is None; returns -1 if empty or target not found.\n    \"\"\"\n    if array is None:\n        raise ValueError(\"array must not be None\")\n\n    if not array:\n        return -1\n\n    low = 0\n    high = len(array) - 1\n    result = -1\n\n    while low <= high:\n        mid = (low + high) // 2\n        if array[mid] == target:\n            result = mid\n            high = mid - 1  # Continue searching in the left half for an earlier occurrence\n        elif array[mid] < target:\n            low = mid + 1\n        else: # array[mid] > target\n            high = mid - 1\n            \n    return result"}
{"task_id": "Mbpp/737", "solution": "import re\n\nclass InputString:\n    \"\"\"Wraps the input string value.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n\n    def value(self) -> str:\n        return self._value\n\nclass RegexPattern:\n    \"\"\"Encapsulates regex pattern and flags; performs match.\"\"\"\n    def __init__(self, pattern: str, flags):\n        self._pattern = pattern\n        self._flags = flags\n\n    def match(self, s: str) -> bool:\n        \"\"\"Uses runtime regex engine (re.match with flags) to check anchored pattern.\"\"\"\n        return re.match(self._pattern, s, self._flags) is not None\n\nclass CheckResult:\n    \"\"\"Wraps boolean result.\"\"\"\n    def __init__(self, value: bool):\n        self._value = value\n\n    def value(self) -> bool:\n        return self._value\n\nclass CheckStr:\n    \"\"\"Orchestrates InputString -> RegexPattern.match -> CheckResult.\"\"\"\n    def check_str(self, input: str) -> bool:\n        input_obj = InputString(input)\n        vowel_pattern = RegexPattern(r'^[aeiou]', re.IGNORECASE)\n        is_vowel_start = vowel_pattern.match(input_obj.value())\n        result_obj = CheckResult(is_vowel_start)\n        return result_obj.value()\n\ndef check_str(input: str) -> bool:\n    \"\"\"\n    Public API. Delegates to CheckStr.check_str and returns boolean indicating\n    if the string starts with a vowel using regex.\n    \"\"\"\n    orchestrator = CheckStr()\n    return orchestrator.check_str(input)"}
{"task_id": "Mbpp/736", "solution": "from typing import Sequence, Any\n\n\ndef left_insertion(sequence: Sequence[Any], value: Any) -> int:\n    \"\"\"Locates the left insertion point for a value in a sorted sequence using binary search.\n    It returns the index where the value can be inserted to maintain sorted order.\n    \"\"\"\n    low = 0\n    high = len(sequence)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sequence[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/739", "solution": "def find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with exactly n digits.\n    Iteratively computes triangular numbers T_k = k*(k+1)/2 until one with n digits is found.\n    \"\"\"\n    k = 1\n    while True:\n        triangular_number_value = k * (k + 1) // 2\n        num_digits = len(str(triangular_number_value))\n\n        if num_digits == n:\n            return k\n        \n        k += 1"}
{"task_id": "Mbpp/741", "solution": "def all_Characters_Same(input: str) -> bool:\n    \"\"\"\n    Checks if all characters in the input string are identical.\n    Returns True if all characters are the same, False otherwise.\n    \"\"\"\n    if not input:\n        return True\n    first_char = input[0]\n    for char in input:\n        if char != first_char:\n            return False\n    return True"}
{"task_id": "Mbpp/740", "solution": "def tuple_to_dict(input: tuple) -> dict:\n    \"\"\"\n    Converts a tuple of adjacent elements to a key-value dictionary.\n    Assumes input is an even-length tuple; no type or length validation is performed.\n    \"\"\"\n    def map_adjacent_pairs(data: tuple) -> dict:\n        result = {}\n        for i in range(0, len(data), 2):\n            result[data[i]] = data[i+1]\n        return result\n\n    return map_adjacent_pairs(input)"}
