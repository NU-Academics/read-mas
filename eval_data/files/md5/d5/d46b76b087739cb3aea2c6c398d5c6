{"task_id": "Mbpp/589", "solution": "import math\nfrom typing import List\n\ndef _is_perfect_square(n: int) -> bool:\n    \"\"\"Checks if an integer n is a perfect square using integer arithmetic.\"\"\"\n    if n < 0:\n        return False\n    # math.isqrt provides the integer square root, available in Python 3.8+\n    root = math.isqrt(n)\n    return root * root == n\n\ndef perfect_squares(start: int, end: int) -> List[int]:\n    \"\"\"\n    Finds perfect squares within a given inclusive range [start, end].\n    Returns an ascending list of all perfect squares found.\n    \"\"\"\n    squares = []\n    for num in range(start, end + 1):\n        if _is_perfect_square(num):\n            squares.append(num)\n    return squares"}
{"task_id": "Mbpp/590", "solution": "import math\n\nclass PolarCoordinate:\n    \"\"\"Represents polar coordinates (radius and angle).\"\"\"\n    def __init__(self, r: float, theta: float) -> None:\n        self.r = r\n        self.theta = theta\n\n    def toRectangular(self) -> 'RectangularCoordinate':\n        \"\"\"Converts polar coordinates to rectangular coordinates.\"\"\"\n        x = self.r * math.cos(self.theta)\n        y = self.r * math.sin(self.theta)\n        return RectangularCoordinate(x, y)\n\nclass RectangularCoordinate:\n    \"\"\"Represents rectangular coordinates (x and y).\"\"\"\n    def __init__(self, x: float, y: float) -> None:\n        self.x = x\n        self.y = y\n\n    def toComplex(self) -> complex:\n        \"\"\"Converts rectangular coordinates to a complex number.\"\"\"\n        return complex(self.x, self.y)\n\ndef polar_rect(r, theta):\n    \"\"\"\n    Converts polar coordinates (r, theta) to rectangular coordinates and a complex number.\n    Returns a tuple: ((r, theta), complex_value).\n    \"\"\"\n    polar = PolarCoordinate(r, theta)\n    rectangular = polar.toRectangular()\n    complex_value = rectangular.toComplex()\n    return ((r, theta), complex_value)"}
{"task_id": "Mbpp/593", "solution": "from typing import List\n\nclass Octet:\n    \"\"\"Represents one octet substring of an IP address.\"\"\"\n    def __init__(self, raw: str, position: int):\n        self.raw = raw\n        self.normalized = \"\"\n        self.position = position\n\n    def toInt(self) -> int:\n        \"\"\"Return the integer numeric value of the octet.\"\"\"\n        return int(self.raw)\n\nclass IPAddress:\n    \"\"\"Represents a raw and normalized IPv4 address.\"\"\"\n    def __init__(self, raw: str):\n        self.raw = raw\n        self.normalized = \"\"\n\n    def parse(self) -> List[Octet]:\n        \"\"\"Split the raw IP string into four octet substrings and return Octet objects.\"\"\"\n        octet_strs = self.raw.split('.')\n        octets = []\n        for i, octet_str in enumerate(octet_strs):\n            octets.append(Octet(raw=octet_str, position=i + 1))\n        return octets\n\nclass RemoveZeroService:\n    \"\"\"Orchestrates parsing and normalization of an IP address.\"\"\"\n    def removezero_ip(self, raw: str) -> str:\n        \"\"\"Main operation returning a normalized dotted string.\"\"\"\n        ip_address = IPAddress(raw)\n        octets = ip_address.parse()\n        \n        normalized_octet_strs = []\n        for octet in octets:\n            normalized_octet_strs.append(self.normalizeOctet(octet.raw))\n            \n        ip_address.normalized = \".\".join(normalized_octet_strs)\n        return ip_address.normalized\n\n    def normalizeOctet(self, octetStr: str) -> str:\n        \"\"\"Remove leading zeros while preserving numeric value; special-case '0' -> '0'.\"\"\"\n        return str(int(octetStr))\n\ndef removezero_ip(raw: str) -> str:\n    \"\"\"Removes leading zeroes from an IP address string.\"\"\"\n    service = RemoveZeroService()\n    return service.removezero_ip(raw)"}
{"task_id": "Mbpp/592", "solution": "import math\n\ndef sum_Of_product(n: int) -> int:\n    \"\"\"\n    Finds the sum of the product of consecutive binomial coefficients using the identity C(2n, n-1).\n    Returns 0 for n=0; validation for n < 0 or non-integer input is omitted per strict prompt instructions.\n    \"\"\"\n    if n == 0:\n        return 0\n    \n    # For n >= 1, the sum is equivalent to the binomial coefficient C(2n, n-1).\n    # math.comb computes binomial coefficients (n choose k) exactly for integers.\n    return math.comb(2 * n, n - 1)"}
{"task_id": "Mbpp/594", "solution": "def diff_even_odd(list) -> int:\n    \"\"\"Scans list left-to-right to find the first even and first odd number.\n    Returns (first even) - (first odd), or raises ValueError if either is missing.\"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in list:\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        elif first_odd is None and num % 2 != 0:\n            first_odd = num\n        \n        if first_even is not None and first_odd is not None:\n            break\n\n    if first_even is None or first_odd is None:\n        raise ValueError(\"list must contain at least one even and one odd integer\")\n    \n    return first_even - first_odd"}
{"task_id": "Mbpp/597", "solution": "class InputValidator:\n    def validate_sorted(self, arr):\n        \"\"\"Checks if the given array is sorted in ascending order.\n        Raises ValueError if the array is not sorted.\n        \"\"\"\n        for i in range(len(arr) - 1):\n            if arr[i] > arr[i+1]:\n                raise ValueError(f\"Array is not sorted in ascending order: {arr}\")\n        return True\n\n    def validate_k(self, k, total):\n        \"\"\"Validates if k is an integer and within the valid range [1, total].\n        Raises ValueError if k is invalid.\n        \"\"\"\n        if not isinstance(k, int):\n            raise ValueError(f\"k must be an integer, got {type(k).__name__}\")\n        if not (1 <= k <= total):\n            raise ValueError(f\"k must be between 1 and {total} (inclusive), got {k}\")\n        return True\n\n    def ensure_comparable(self, arr1, arr2):\n        \"\"\"Verifies mutual comparability between elements of arr1 and arr2.\n        Raises TypeError if elements are not mutually comparable.\n        \"\"\"\n        if len(arr1) > 0:\n            try:\n                # Check self-comparability within arr1\n                _ = arr1[0] < arr1[0]\n            except TypeError as e:\n                raise TypeError(f\"Elements in arr1 are not comparable: {e}\")\n\n        if len(arr2) > 0:\n            try:\n                # Check self-comparability within arr2\n                _ = arr2[0] < arr2[0]\n            except TypeError as e:\n                raise TypeError(f\"Elements in arr2 are not comparable: {e}\")\n\n        if len(arr1) > 0 and len(arr2) > 0:\n            try:\n                # Check mutual comparability between arr1 and arr2\n                _ = arr1[0] < arr2[0]\n            except TypeError as e:\n                raise TypeError(f\"Elements between arr1 and arr2 are not mutually comparable: {e}\")\n        return True\n\n\ndef find_kth(arr1, arr2, k):\n    \"\"\"Return the k-th smallest element (1-based) from arr1 and arr2.\n\n    Raises:\n      ValueError: if k is out of range or arrays are unsorted.\n      TypeError: if elements are not mutually comparable.\n    \"\"\"\n    validator = InputValidator()\n\n    validator.validate_sorted(arr1)\n    validator.validate_sorted(arr2)\n    \n    total_length = len(arr1) + len(arr2)\n    validator.validate_k(k, total_length)\n    \n    validator.ensure_comparable(arr1, arr2)\n\n    ptr1, ptr2 = 0, 0\n    len1, len2 = len(arr1), len(arr2)\n    current_count = 0\n\n    while ptr1 < len1 and ptr2 < len2:\n        current_count += 1\n        if arr1[ptr1] <= arr2[ptr2]:\n            if current_count == k:\n                return arr1[ptr1]\n            ptr1 += 1\n        else:\n            if current_count == k:\n                return arr2[ptr2]\n            ptr2 += 1\n\n    while ptr1 < len1:\n        current_count += 1\n        if current_count == k:\n            return arr1[ptr1]\n        ptr1 += 1\n\n    while ptr2 < len2:\n        current_count += 1\n        if current_count == k:\n            return arr2[ptr2]\n        ptr2 += 1"}
{"task_id": "Mbpp/599", "solution": "from dataclasses import dataclass\n\nclass Validator:\n    \"\"\"Provides input validation logic for natural numbers.\"\"\"\n    def validateN(self, n) -> bool:\n        \"\"\"Returns True if n is a positive integer, otherwise False.\"\"\"\n        return isinstance(n, int) and n >= 1\n\n    def raiseError(self, msg):\n        \"\"\"Raises a ValueError with the specified message.\"\"\"\n        raise ValueError(msg)\n\nclass NaturalNumberSequence:\n    \"\"\"Generates a sequence of natural numbers.\"\"\"\n    def __init__(self, end: int):\n        \"\"\"Initializes the sequence generator.\"\"\"\n        self.start = 1\n        self.end = end\n\n    def generate(self) -> list:\n        \"\"\"Returns a list of natural numbers from start to end.\"\"\"\n        return list(range(self.start, self.end + 1))\n\nclass Calculator:\n    \"\"\"Performs numeric computations for sum and average.\"\"\"\n    def sum(self, sequence: list) -> int:\n        \"\"\"Calculates the integer sum of the provided sequence.\"\"\"\n        return sum(sequence)\n\n    def average(self, sum: int, count: int) -> float:\n        \"\"\"Calculates the average of the sum and count as a float.\"\"\"\n        return sum / count\n\n@dataclass\nclass ResultTuple:\n    \"\"\"A data container for the computed sum and average.\"\"\"\n    sum: int\n    average: float\n\n    def to_tuple(self) -> tuple:\n        \"\"\"Converts the result object to a tuple (sum, average).\"\"\"\n        return (self.sum, self.average)\n\ndef sum_average(n):\n    \"\"\"\n    Calculates the sum and average of the first n natural numbers.\n    Validates n to be a positive integer; raises ValueError if invalid.\n    \"\"\"\n    validator = Validator()\n    if not validator.validateN(n):\n        validator.raiseError(f\"Invalid n: {n}. Must be a positive integer.\")\n\n    seq_generator = NaturalNumberSequence(end=n)\n    sequence = seq_generator.generate()\n\n    calculator = Calculator()\n    total_sum = calculator.sum(sequence)\n    avg = calculator.average(total_sum, n)\n\n    result = ResultTuple(sum=total_sum, average=avg)\n    return result.to_tuple()"}
