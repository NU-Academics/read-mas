{"task_id": "Mbpp/239", "solution": "class Input:\n    \"\"\"Input representation and validation logic enforcing m >= 1, n >= 1 and integer types.\"\"\"\n    def __init__(self, m, n):\n        self.m = m\n        self.n = n\n\n    def validate(self) -> bool:\n        \"\"\"Returns True if inputs are positive integers, False otherwise.\"\"\"\n        return (isinstance(self.m, int) and isinstance(self.n, int) and\n                self.m >= 1 and self.n >= 1)\n\nclass Validator:\n    \"\"\"Input validation logic for positive integers.\"\"\"\n    @staticmethod\n    def validatePositiveIntegers(m, n) -> None:\n        \"\"\"Raises ValueError if m or n are not positive integers.\"\"\"\n        if not (isinstance(m, int) and isinstance(n, int) and m >= 1 and n >= 1):\n            raise ValueError(\"Inputs m and n must be positive integers and >= 1.\")\n\nclass Sequence:\n    \"\"\"Represents a candidate sequence and provides isValid(m) to check constraints.\"\"\"\n    def __init__(self, elements: list[int]):\n        self.elements = elements\n        self.length = len(elements)\n\n    def isValid(self, m) -> bool:\n        \"\"\"Checks if the sequence satisfies all constraints up to m.\"\"\"\n        if not all(e <= m for e in self.elements):\n            return False\n        for i in range(1, self.length):\n            if self.elements[i] < 2 * self.elements[i-1]:\n                return False\n        return True\n\nclass Result:\n    \"\"\"Simple container for the computed total count.\"\"\"\n    def __init__(self, total: int = 0):\n        self.total = total\n\nclass SequenceCounter:\n    \"\"\"Counting logic that enumerates/recurses over valid sequences and accumulates the exact count.\"\"\"\n    def __init__(self):\n        # Memoization table to store results of subproblems: (a_prev, remainingLength) -> count\n        self._memo = {} \n\n    def countSequences(self, m, n) -> int:\n        \"\"\"\n        Counts the total number of valid sequences of length n,\n        with elements less than or equal to m.\n        \"\"\"\n        if n == 1:\n            return m\n\n        # Reset memoization table for each top-level call to countSequences\n        self._memo.clear() \n        \n        total_sequences = 0\n        # The first element (a1) can range from 1 to m.\n        for a1 in range(1, m + 1):\n            # Recursively count valid sequences that start with a1\n            # and need (n - 1) more elements to reach length n.\n            total_sequences += self.countFromStart(a1, m, n - 1)\n        return total_sequences\n\n    def countFromStart(self, a_prev: int, m: int, remainingLength: int) -> int:\n        \"\"\"\n        Recursively counts valid sequence suffixes starting after a_prev,\n        with 'remainingLength' elements to place.\n        \"\"\"\n        # Base case: If no more elements are needed, we've successfully formed\n        # a valid sequence suffix, contributing 1 to the total count.\n        if remainingLength == 0:\n            return 1\n\n        # Check if the result for this subproblem (a_prev, remainingLength)\n        # is already stored in the memoization table.\n        if (a_prev, remainingLength) in self._memo:\n            return self._memo[(a_prev, remainingLength)]\n\n        current_sub_count = 0\n        # The next element (a_next) must be at least twice the previous element (a_prev)\n        # and not exceed m.\n        min_next_val = 2 * a_prev\n        \n        # If the minimum possible next value is already greater than m,\n        # then no valid next element can be placed, so this path yields 0 sequences.\n        if min_next_val > m:\n            self._memo[(a_prev, remainingLength)] = 0\n            return 0\n\n        # Iterate through all possible valid values for the next element (a_next)\n        # and sum the counts from the recursive calls.\n        for a_next in range(min_next_val, m + 1):\n            current_sub_count += self.countFromStart(a_next, m, remainingLength - 1)\n        \n        # Store the computed result in the memoization table before returning it.\n        self._memo[(a_prev, remainingLength)] = current_sub_count\n        return current_sub_count\n\ndef get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Finds the number of possible sequences of length n, such that each element\n    is a positive integer and is greater than or equal to twice the previous\n    element but less than or equal to m.\n    \"\"\"\n    # Validate inputs using the Validator class as per design\n    Validator.validatePositiveIntegers(m, n)\n\n    # Instantiate SequenceCounter and get the total count\n    counter = SequenceCounter()\n    total = counter.countSequences(m, n)\n    \n    # Return the total count\n    return int(total)"}
