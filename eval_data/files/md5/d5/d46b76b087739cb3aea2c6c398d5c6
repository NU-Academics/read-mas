{"task_id": "Mbpp/119", "solution": "from typing import List\n\ndef search(nums: List[int]) -> int:\n    \"\"\"Return the single integer that appears only once in a sorted list where every other integer appears exactly twice.\"\"\"\n    low = 0\n    high = len(nums) - 1\n    while low < high:\n        mid = (low + high) // 2\n        if mid % 2 == 1:\n            mid -= 1\n        if nums[mid] == nums[mid + 1]:\n            low = mid + 2\n        else:\n            high = mid\n    return nums[low]"}
{"task_id": "Mbpp/120", "solution": "class TuplePair:\n    \"\"\"Encapsulates a 2-element numeric pair and computes its absolute product.\"\"\"\n    def __init__(self, a: float, b: float) -> None:\n        self.a = float(a)\n        self.b = float(b)\n\n    def abs_product(self) -> float:\n        \"\"\"Computes the absolute product of the two numbers in the pair.\"\"\"\n        return abs(self.a * self.b)\n\nclass MaxProductFunction:\n    \"\"\"Encapsulates the algorithm to find the maximum absolute product from a list of TuplePair instances.\"\"\"\n    def max_product_tuple(self, tuple_pairs: list) -> float:\n        \"\"\"Calculates the maximum absolute product from a list of TuplePair objects.\"\"\"\n        if not tuple_pairs:\n            return 0.0\n        \n        absolute_products = [pair.abs_product() for pair in tuple_pairs]\n        return max(absolute_products)\n\ndef max_product_tuple(tuples: list) -> float:\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples within a given list.\n    The input list is assumed to contain 2-element numeric tuples.\n    \"\"\"\n    if not tuples:\n        return 0.0\n\n    converted_pairs = [TuplePair(item[0], item[1]) for item in tuples]\n    \n    calculator = MaxProductFunction()\n    return calculator.max_product_tuple(converted_pairs)"}
