{"task_id": "Mbpp/598", "solution": "class Digit:\n    \"\"\"Represents a single digit of a number.\"\"\"\n    def __init__(self, value: int, position: int) -> None:\n        self.value = value\n        self.position = position\n\nclass Number:\n    \"\"\"Represents an integer, providing methods to access its digits and digit count.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n        self._digits: list[Digit] = []\n        \n        str_value = str(abs(value)) # Extract digits from the absolute value\n        \n        if str_value == '0':\n            self._digits.append(Digit(0, 0)) # Special case for 0 to ensure one Digit(0,0)\n        else:\n            for i, digit_char in enumerate(str_value):\n                self._digits.append(Digit(int(digit_char), i))\n\n    def digitCount(self) -> int:\n        \"\"\"Returns the number of decimal digits in the number.\"\"\"\n        return len(self._digits)\n\n    def digits(self) -> list[Digit]:\n        \"\"\"Returns a list of Digit objects representing the number's decimal digits.\"\"\"\n        return self._digits\n\nclass ArmstrongResult:\n    \"\"\"Encapsulates the boolean result of an Armstrong number check.\"\"\"\n    def __init__(self, isArmstrong: bool) -> None:\n        self.isArmstrong = isArmstrong\n\nclass ArmstrongChecker:\n    \"\"\"Provides methods to check if a number is an Armstrong number.\"\"\"\n    def __init__(self) -> None:\n        pass # This checker is stateless and requires no initialization.\n\n    def computeDigitCount(self, number: Number) -> int:\n        \"\"\"Computes the number of decimal digits in the given Number object.\"\"\"\n        return number.digitCount()\n\n    def computePoweredSum(self, number: Number) -> int:\n        \"\"\"Computes the sum of each decimal digit raised to the power of the total digit count.\"\"\"\n        n = self.computeDigitCount(number)\n        powered_sum = 0\n        for digit in number.digits():\n            powered_sum += digit.value ** n\n        return powered_sum\n\n    def armstrong_number(self, n: int) -> bool:\n        \"\"\"Determines if the given integer n is an Armstrong number.\"\"\"\n        if n < 0: # Armstrong numbers are typically defined for non-negative integers.\n            return False\n        \n        number_obj = Number(n)\n        powered_sum = self.computePoweredSum(number_obj)\n        \n        return powered_sum == n\n\ndef armstrong_number(n: int) -> bool:\n    \"\"\"Checks whether the given number is an Armstrong number.\"\"\"\n    checker = ArmstrongChecker()\n    return checker.armstrong_number(n)"}
