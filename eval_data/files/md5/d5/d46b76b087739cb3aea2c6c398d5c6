{"task_id": "Mbpp/247", "solution": "def lps(s: str) -> int:\n    \"\"\"\n    Finds the length of the longest palindromic subsequence in the given string using dynamic programming.\n    \"\"\"\n    n = len(s)\n\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n\n    # dp[i][j] will store the length of the longest palindromic subsequence for substring s[i...j]\n    dp = [[0] * n for _ in range(n)]\n\n    # All single characters are palindromic subsequences of length 1\n    for i in range(n):\n        dp[i][i] = 1\n\n    # Fill the DP table for lengths from 2 to n\n    for cl in range(2, n + 1):  # cl is current length of substring\n        for i in range(n - cl + 1):\n            j = i + cl - 1  # j is the ending index of the current substring\n\n            if s[i] == s[j]:\n                if cl == 2:\n                    dp[i][j] = 2\n                else:\n                    dp[i][j] = 2 + dp[i+1][j-1]\n            else:\n                dp[i][j] = max(dp[i][j-1], dp[i+1][j])\n    \n    # The length of the longest palindromic subsequence for the entire string is dp[0][n-1]\n    return dp[0][n-1]"}
{"task_id": "Mbpp/245", "solution": "import sys\nfrom typing import List\n\nclass Element:\n    \"\"\"Data holder representing an array element.\"\"\"\n    def __init__(self, index: int, value: int):\n        self.index = index\n        self.value = value\n\nclass ArrayInput:\n    \"\"\"Input holder and validator.\"\"\"\n    def __init__(self, values: List[int]):\n        self.values = values\n\n    def validate(self) -> bool:\n        \"\"\"Validate that values is a list/array and every element is an int.\"\"\"\n        if not isinstance(self.values, list):\n            return False\n        for item in self.values:\n            if not isinstance(item, int):\n                return False\n        return True\n\nclass BitonicSubsequence:\n    \"\"\"Represent a candidate subsequence and validate bitonic property.\"\"\"\n    def __init__(self, indices: List[int], subsequence_sum: int):\n        self.indices = indices\n        self.sum = subsequence_sum\n\n    def isBitonic(self) -> bool:\n        \"\"\"Validate that elements at indices form a strictly increasing-then-strictly-decreasing subsequence.\"\"\"\n        return True # Placeholder as per design notes.\n\nclass Result:\n    \"\"\"Carrier for final result.\"\"\"\n    def __init__(self, max_sum: int):\n        self.maxSum = max_sum\n\nclass BitonicAlgorithm:\n    \"\"\"Implements BitonicAlgorithm computing the maximum-sum bitonic subsequence.\"\"\"\n\n    def computeLISums(self, values: List[int]) -> List[int]:\n        \"\"\"\n        Compute the maximum possible sum of a strictly increasing subsequence that ends at each index.\n        Returns a list of sums of the same length as values.\n        \"\"\"\n        n = len(values)\n        if n == 0:\n            return []\n        lis_sums = [0] * n\n        for i in range(n):\n            lis_sums[i] = values[i]\n            for j in range(i):\n                if values[j] < values[i]:\n                    lis_sums[i] = max(lis_sums[i], lis_sums[j] + values[i])\n        return lis_sums\n\n    def computeLDSums(self, values: List[int]) -> List[int]:\n        \"\"\"\n        Compute the maximum possible sum of a strictly decreasing subsequence that starts at each index.\n        Returns a list of sums of the same length as values.\n        \"\"\"\n        n = len(values)\n        if n == 0:\n            return []\n        lds_sums = [0] * n\n        for i in range(n - 1, -1, -1):\n            lds_sums[i] = values[i]\n            for j in range(n - 1, i, -1):\n                if values[j] < values[i]:\n                    lds_sums[i] = max(lds_sums[i], lds_sums[j] + values[i])\n        return lds_sums\n\n    def computeMaxSum(self, arrayInput: ArrayInput) -> int:\n        \"\"\"\n        Computes the maximum sum of a bitonic subsequence for the given array.\n        Returns 0 for an empty input.\n        \"\"\"\n        values = arrayInput.values\n        n = len(values)\n\n        if n == 0:\n            return 0\n\n        lis_sums = self.computeLISums(values)\n        lds_sums = self.computeLDSums(values)\n\n        max_bitonic_sum = float('-inf')\n\n        for i in range(n):\n            current_bitonic_sum = lis_sums[i] + lds_sums[i] - values[i]\n            if current_bitonic_sum > max_bitonic_sum:\n                max_bitonic_sum = current_bitonic_sum\n        \n        return max_bitonic_sum\n\ndef max_sum(values: List[int]) -> int:\n    \"\"\"\n    Calculates the maximum sum of a bitonic subsequence for the given array.\n    A sequence is bitonic if it is first increasing and then decreasing.\n    \"\"\"\n    array_input = ArrayInput(values)\n\n    if not array_input.validate():\n        raise ValueError(\"Input must be a list of integers\")\n\n    bitonic_algo = BitonicAlgorithm()\n    return bitonic_algo.computeMaxSum(array_input)"}
