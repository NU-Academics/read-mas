{"task_id": "Mbpp/308", "solution": "from typing import List, Union\n\nclass Product:\n    \"\"\"Represents a product of two factors.\"\"\"\n    def __init__(self, factor1: Union[int, float], factor2: Union[int, float]):\n        self._factor1 = factor1\n        self._factor2 = factor2\n        self._value = factor1 * factor2\n\n    def value(self) -> Union[int, float]:\n        \"\"\"Returns the product's value.\"\"\"\n        return self._value\n\nclass InputList:\n    \"\"\"A light wrapper for an input list of numeric values.\"\"\"\n    def __init__(self, values: List[Union[int, float]]):\n        self._values = values\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the list is empty.\"\"\"\n        return not self._values\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the list.\"\"\"\n        return len(self._values)\n\n    def values(self) -> List[Union[int, float]]:\n        \"\"\"Returns the underlying list of values.\"\"\"\n        return self._values\n\nclass Result:\n    \"\"\"Container for top-products to be returned to the caller.\"\"\"\n    def __init__(self, products: List[Union[int, float]]):\n        self._products = products\n\n    def as_list(self) -> List[Union[int, float]]:\n        \"\"\"Returns the contained products as a list.\"\"\"\n        return self._products\n\nclass LargeProductService:\n    \"\"\"Encapsulates validation, computation, and selection logic for large products.\"\"\"\n    def large_product(self, list1: List[Union[int, float]], list2: List[Union[int, float]], k: int) -> List[Union[int, float]]:\n        \"\"\"Orchestrates finding the k largest products from two lists.\"\"\"\n        self.validate_inputs(list1, list2, k)\n        products = self.compute_pairwise_products(list1, list2)\n        top_values = self.select_top_k(products, k)\n        return Result(top_values).as_list()\n\n    def validate_inputs(self, list1: List[Union[int, float]], list2: List[Union[int, float]], k: int) -> None:\n        \"\"\"Validates input types and values, raising ValueError on failure.\"\"\"\n        if not isinstance(list1, list):\n            raise ValueError(\"list1 must be a list.\")\n        if not isinstance(list2, list):\n            raise ValueError(\"list2 must be a list.\")\n        if not all(isinstance(x, (int, float)) for x in list1):\n            raise ValueError(\"All elements in list1 must be numbers (int or float).\")\n        if not all(isinstance(x, (int, float)) for x in list2):\n            raise ValueError(\"All elements in list2 must be numbers (int or float).\")\n        if not isinstance(k, int):\n            raise ValueError(\"k must be an integer.\")\n\n    def compute_pairwise_products(self, list1: List[Union[int, float]], list2: List[Union[int, float]]) -> List[Product]:\n        \"\"\"Computes all pairwise products from elements of two lists.\"\"\"\n        products: List[Product] = []\n        input_list1 = InputList(list1)\n        input_list2 = InputList(list2)\n\n        if input_list1.is_empty() or input_list2.is_empty():\n            return []\n\n        for factor1 in input_list1.values():\n            for factor2 in input_list2.values():\n                products.append(Product(factor1, factor2))\n        return products\n\n    def select_top_k(self, products: List[Product], k: int) -> List[Union[int, float]]:\n        \"\"\"Selects the top k largest product values from a list of Product objects.\"\"\"\n        if k <= 0:\n            return []\n\n        if not products:\n            return []\n\n        product_values = [p.value() for p in products]\n        product_values.sort(reverse=True)\n\n        return product_values[:k]\n\ndef large_product(list1: List[Union[int, float]], list2: List[Union[int, float]], k: int) -> List[Union[int, float]]:\n    \"\"\"Finds the k largest products from two lists, selecting one factor from each.\"\"\"\n    service = LargeProductService()\n    return service.large_product(list1, list2, k)"}
{"task_id": "Mbpp/312", "solution": "import math\n\ndef volume_cone(radius, height) -> float:\n    \"\"\"Calculate the volume of a cone given its radius and height.\n    Inputs are converted to float, and standard geometric formula is used.\"\"\"\n    r_float = float(radius)\n    h_float = float(height)\n    volume = (1.0/3.0) * math.pi * (r_float ** 2) * h_float\n    return volume"}
{"task_id": "Mbpp/306", "solution": "from dataclasses import dataclass\nfrom typing import List\n\nclass ValidationError(Exception):\n    \"\"\"Custom exception for validation failures.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\n@dataclass\nclass Array:\n    \"\"\"Represents the input array and its declared length.\"\"\"\n    elements: List[int]\n    length: int\n\n    def validate_length(self) -> None:\n        \"\"\"Validates that the declared length matches the actual array length.\"\"\"\n        if self.length != len(self.elements):\n            raise ValidationError(f\"Declared length {self.length} does not match actual array length {len(self.elements)}.\")\n\n@dataclass\nclass Index:\n    \"\"\"Encapsulates the indices i and k.\"\"\"\n    i: int\n    k: int\n\n    def validate_bounds(self, n: int) -> None:\n        \"\"\"Validates that indices i and k are within bounds and k > i.\"\"\"\n        if not (0 <= self.i < n and 0 <= self.k < n):\n            raise ValidationError(f\"Indices i={self.i} or k={self.k} are out of bounds for array of length {n}.\")\n        if self.k <= self.i:\n            raise ValidationError(f\"Index k={self.k} must be strictly greater than index i={self.i}.\")\n\n@dataclass\nclass Subsequence:\n    \"\"\"Represents a candidate subsequence with its elements and sum.\"\"\"\n    elements: List[int]\n    sum: int = 0\n    containsK: bool = False\n\n    def __init__(self, elements: List[int], containsK: bool = False):\n        self.elements = elements\n        self.containsK = containsK\n        self.sum = 0 # Initialize sum, to be computed by compute_sum\n\n    def compute_sum(self) -> int:\n        \"\"\"Computes and sets the sum of the subsequence elements.\"\"\"\n        self.sum = sum(self.elements)\n        return self.sum\n\nclass MaxSumIncSubseqFunction:\n    \"\"\"Encapsulates the core algorithm for finding the maximum sum.\"\"\"\n\n    @staticmethod\n    def max_sum_increasing_subseq(arr: List[int], n: int, i: int, k: int) -> int:\n        \"\"\"\n        Computes the maximum sum of an increasing subsequence from prefix until ith index\n        including a given kth element (k > i).\n        \"\"\"\n        # 1. Input Validation\n        array_obj = Array(arr, n)\n        array_obj.validate_length()\n\n        index_obj = Index(i, k)\n        index_obj.validate_bounds(n)\n\n        # 2. Dynamic Programming for prefix arr[0...i]\n        # dp[j] will store the maximum sum of an increasing subsequence ending at arr[j]\n        # within the prefix arr[0...j].\n        dp = [0] * (i + 1)\n\n        for current_idx in range(i + 1):\n            dp[current_idx] = arr[current_idx] # Base case: subsequence ending at current_idx is just arr[current_idx] itself\n\n            for prev_idx in range(current_idx):\n                if arr[prev_idx] < arr[current_idx]:\n                    dp[current_idx] = max(dp[current_idx], dp[prev_idx] + arr[current_idx])\n\n        # 3. Calculate the maximum sum including arr[k]\n        # Initialize with arr[k] itself, in case no eligible prefix elements are found.\n        max_total_sum = arr[k]\n\n        # Iterate through the computed dp sums for prefix elements\n        for prefix_idx in range(i + 1):\n            # An element arr[prefix_idx] is eligible if it's smaller than arr[k]\n            if arr[prefix_idx] < arr[k]:\n                max_total_sum = max(max_total_sum, dp[prefix_idx] + arr[k])\n\n        return max_total_sum\n\ndef max_sum_increasing_subseq(arr: List[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence from prefix until ith index\n    and also including a given kth element which is after i, i.e., k > i.\n    \"\"\"\n    return MaxSumIncSubseqFunction.max_sum_increasing_subseq(arr, n, i, k)"}
{"task_id": "Mbpp/311", "solution": "from typing import List\n\ndef _highest_set_bit(n: int) -> int:\n    \"\"\"\n    Computes the position of the highest set bit (0-indexed, LSB is 0).\n    Returns -1 for n <= 0.\n    \"\"\"\n    if n <= 0:\n        return -1\n    return n.bit_length() - 1\n\nclass IntegerInput:\n    \"\"\"\n    Encapsulates the input integer and provides highest_set_bit computation\n    and conversion to a binary list.\n    \"\"\"\n    def __init__(self, n: int) -> None:\n        self.n = n\n\n    def highest_set_bit(self) -> int:\n        \"\"\"Returns the index of the highest set bit, or -1 if n <= 0.\"\"\"\n        return _highest_set_bit(self.n)\n\n    def to_binary_up_to_highest(self) -> List[int]:\n        \"\"\"\n        Converts the integer to a list of bits from LSB to MSB,\n        up to and including the highest set bit.\n        Example: 10 (0b1010) with highest bit 3 returns [0, 1, 0, 1].\n        \"\"\"\n        highest = self.highest_set_bit()\n        if highest == -1:\n            return []\n        \n        bits = []\n        for i in range(highest + 1):\n            bits.append((self.n >> i) & 1)\n        return bits\n\nclass BinaryRepresentation:\n    \"\"\"\n    Represents bits (LSB to MSB) and provides methods to find/set the\n    left-most unset bit and convert back to int.\n    \"\"\"\n    def __init__(self, bits: List[int]) -> None:\n        self.bits = list(bits) # Store a mutable copy\n\n    def find_left_most_unset(self) -> int:\n        \"\"\"\n        Finds the index (0-based, LSB is 0) of the most significant zero bit\n        within the current bit representation. Returns -1 if no unset bit is found.\n        \"\"\"\n        for i in range(len(self.bits) - 1, -1, -1):\n            if self.bits[i] == 0:\n                return i\n        return -1\n\n    def set_bit(self, pos: int) -> None:\n        \"\"\"Sets the bit at the given position to 1.\"\"\"\n        if 0 <= pos < len(self.bits):\n            self.bits[pos] = 1\n        # Behavior for pos out of bounds is not specified. Assuming pos is valid.\n\n    def to_int(self) -> int:\n        \"\"\"Converts the list of bits (LSB to MSB) back to an integer.\"\"\"\n        result = 0\n        for i, bit in enumerate(self.bits):\n            if bit == 1:\n                result |= (1 << i)\n        return result\n\nclass Result:\n    \"\"\"Wraps the resulting integer value.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def binary(self) -> str:\n        \"\"\"Returns the binary string representation of the value.\"\"\"\n        return bin(self.value)\n\ndef set_left_most_unset_bit(n: int) -> int:\n    \"\"\"\n    Sets the left-most unset bit in the input integer's binary representation\n    considering bits 0..highest_set_bit inclusive, and returns the resulting integer.\n    \"\"\"\n    input_obj = IntegerInput(n)\n    initial_bits = input_obj.to_binary_up_to_highest()\n\n    binary_rep = BinaryRepresentation(initial_bits)\n    unset_pos = binary_rep.find_left_most_unset()\n\n    if unset_pos != -1:\n        binary_rep.set_bit(unset_pos)\n    \n    # If no unset bit is found within the specified range,\n    # binary_rep remains unchanged, and to_int() will return the original n.\n    # This aligns with the \"Behavior unspecified by SRS (BR-3)\" for \"not found\".\n\n    final_value = binary_rep.to_int()\n    result_obj = Result(final_value)\n    \n    return result_obj.value"}
{"task_id": "Mbpp/389", "solution": "def find_lucas(n: int) -> int:\n    \"\"\"Calculates the n'th Lucas number using an iterative approach.\n    Handles base cases L(0)=2, L(1)=1 and the recurrence L(n)=L(n-1)+L(n-2).\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    if n == 0:\n        return 2\n    elif n == 1:\n        return 1\n    else:\n        a, b = 2, 1  # L(0), L(1)\n        for _ in range(2, n + 1):\n            a, b = b, a + b\n        return b"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n):\n    \"\"\"Return the largest power of two (2^k, k >= 0) <= n.\n\n    Parameters:\n    - n: int (expected by SRS BR6)\n\n    Returns:\n    - int: largest power of two <= n\n    \"\"\"\n    if n < 1:\n        # Per definition, no power of 2 (2^k, k>=0 meaning 1, 2, 4...)\n        # can be less than or equal to n if n is less than 1.\n        return 0\n\n    power = 1\n    # Repeatedly double 'power' until it would exceed 'n'.\n    while power * 2 <= n:\n        power *= 2\n    return power"}
{"task_id": "Mbpp/390", "solution": "from typing import Any, List\n\ndef _apply_format(element: Any, fmt: str) -> str:\n    \"\"\"Convert element to str and apply Python-style format (positional {0}).\"\"\"\n    return fmt.format(str(element))\n\ndef add_string(items: List[Any], fmt: str) -> List[str]:\n    \"\"\"Apply fmt to each element in items using Python-style {0} placeholder and return list of strings.\"\"\"\n    return [_apply_format(e, fmt) for e in items]"}
{"task_id": "Mbpp/394", "solution": "from typing import Any, Tuple\n\ndef check_distinct(t: tuple) -> bool:\n    \"\"\"Precondition: t is a tuple. Returns True if no duplicates; False otherwise.\"\"\"\n    seen = set()\n    for item in t:\n        if item in seen:\n            return False\n        seen.add(item)\n    return True"}
{"task_id": "Mbpp/391", "solution": "def convert_list_dictionary(*lists):\n    \"\"\"Convert two or more parallel lists into a list of nested dictionaries.\n\n    Args:\n        *lists: two or more indexable sequences (lists) of equal length.\n\n    Returns:\n        list: a list of dictionaries where each item corresponds to an index in the input lists.\n\n    Raises:\n        ValueError: if fewer than two lists are provided or if input lists have unequal lengths.\n\n    Example:\n    assert convert_list_dictionary([\"S001\", \"S002\", \"S003\", \"S004\"],[\"Adina Park\", \"Leyton Marsh\", \"Duncan Boyle\", \"Saim Richards\"] ,[85, 98, 89, 92])==[{'S001': {'Adina Park': 85}}, {'S002': {'Leyton Marsh': 98}}, {'S003': {'Duncan Boyle': 89}}, {'S004': {'Saim Richards': 92}}]\n    \"\"\"\n    num_lists = len(lists)\n\n    if num_lists < 2:\n        raise ValueError(\"At least two lists are required for conversion.\")\n\n    first_list_length = len(lists[0])\n\n    for lst_idx in range(1, num_lists):\n        if len(lists[lst_idx]) != first_list_length:\n            raise ValueError(\"All input lists must have equal lengths.\")\n\n    result = []\n    for i in range(first_list_length):\n        # Start with the innermost value from the last list\n        current_nested_value = lists[num_lists - 1][i]\n\n        # Build the nested dictionary from the second-to-last list backwards to the second list\n        for j in range(num_lists - 2, 0, -1):\n            current_nested_value = {lists[j][i]: current_nested_value}\n\n        # The outermost key is from the first list, with the constructed nested value\n        outer_dict = {lists[0][i]: current_nested_value}\n        result.append(outer_dict)\n\n    return result"}
