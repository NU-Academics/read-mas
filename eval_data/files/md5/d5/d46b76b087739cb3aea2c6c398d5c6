{"task_id": "Mbpp/63", "solution": "from typing import Union\n\n# Define 'number' type hint as specified in the design context.\nnumber = Union[int, float]\n\nclass ValidationService:\n    \"\"\"\n    Validates the input list of pairs according to business rules.\n    It checks for non-empty input, correct item structure, and numeric types.\n    \"\"\"\n    def validate_input(self, pairs: list) -> None:\n        \"\"\"\n        Validates the given list of pairs, raising ValueError or TypeError for invalid input.\n        Raises:\n            ValueError: If the input list is empty.\n            TypeError: If any item is not a 2-element tuple/list or contains non-numeric elements.\n        \"\"\"\n        if not pairs:\n            raise ValueError(\"input list must not be empty\")\n\n        for item in pairs:\n            if not isinstance(item, (tuple, list)) or len(item) != 2:\n                raise TypeError(\"each item must be a 2-element tuple/list of numeric types\")\n            if not isinstance(item[0], (int, float)) or not isinstance(item[1], (int, float)):\n                raise TypeError(\"each item must be a 2-element tuple/list of numeric types\")\n\n\nclass MaxDifferenceCalculator:\n    \"\"\"\n    Computes the absolute difference for each pair and determines the maximum difference.\n    This class assumes validated input and focuses solely on the calculation logic.\n    \"\"\"\n    def max_difference(self, pairs: list[tuple[number, number]]) -> number:\n        \"\"\"\n        Calculates the maximum absolute difference from a list of 2-element numeric pairs.\n        Returns the highest absolute difference found among all pairs.\n        \"\"\"\n        if not pairs:\n            # This case should ideally be caught by ValidationService, but defensive if called directly.\n            # Given the design context, the external facade ensures validation.\n            # If no pairs are left after some filter or in an edge scenario, max() on an empty list would fail.\n            # However, with ValidationService guaranteed to run, 'pairs' will not be empty here.\n            pass # Remove this if confident ValidationService prevents empty list reaching here.\n\n        differences = [self.compute_difference(pair) for pair in pairs]\n        return max(differences)\n\n    def compute_difference(self, pair: tuple[number, number]) -> number:\n        \"\"\"\n        Computes the absolute difference between the two numbers in a given pair.\n        Returns abs(a - b) for the pair (a, b).\n        \"\"\"\n        a, b = pair\n        return abs(a - b)\n\n\ndef max_difference(pairs: list[tuple[number, number]]) -> number:\n    \"\"\"\n    Finds the maximum difference between available pairs in the given tuple list.\n    Validates input and computes the maximum absolute difference across all pairs.\n    Raises ValueError for empty input or TypeError for malformed items.\n    \"\"\"\n    validation_service = ValidationService()\n    validation_service.validate_input(pairs)\n\n    calculator = MaxDifferenceCalculator()\n    return calculator.max_difference(pairs)"}
{"task_id": "Mbpp/57", "solution": "def find_Max_Num(digits: list) -> int:\n    \"\"\"\n    Finds the largest number that can be formed with the given list of digits.\n    Assumes valid input digits (0-9) as per problem constraints.\n    \"\"\"\n    sorted_digits = sorted(digits, reverse=True)\n    \n    max_num = 0\n    for digit in sorted_digits:\n        max_num = max_num * 10 + digit\n        \n    return max_num"}
{"task_id": "Mbpp/65", "solution": "def recursive_list_sum(lst: list) -> int:\n    \"\"\"\n    Recursively sum all integer atomic elements in lst.\n    Elements can be ints or lists (nested to arbitrary depth).\n    \"\"\"\n    total_sum = 0\n    for elem in lst:\n        if isinstance(elem, int):\n            total_sum += elem\n        elif isinstance(elem, list):\n            total_sum += recursive_list_sum(elem)\n    return total_sum"}
{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    \"\"\"\n    Computes the nth Bell number, representing the number of ways to partition a set of n elements.\n    Uses the Bell triangle construction.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    bell_row = [1]  # Represents B_0 and then successive rows of the Bell triangle\n\n    for i in range(1, n + 1):\n        new_bell_row = [bell_row[-1]]  # First element of new row is last of previous\n        for j in range(len(bell_row)):\n            new_bell_row.append(new_bell_row[-1] + bell_row[j])\n        bell_row = new_bell_row\n\n    return bell_row[0]"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(source_list, sublist):\n    \"\"\"\n    Checks if a list contains the given sublist as a contiguous subsequence.\n    \"\"\"\n    len_source = len(source_list)\n    len_sub = len(sublist)\n\n    if len_sub > len_source:\n        return False\n\n    if len_sub == 0:\n        return True # An empty list is considered a sublist of any list\n\n    for i in range(len_source - len_sub + 1):\n        if source_list[i : i + len_sub] == sublist:\n            return True\n            \n    return False"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(array):\n    \"\"\"Return True if 'array' is monotonic (non-increasing OR non-decreasing). Does not mutate 'array'.\"\"\"\n    is_non_increasing = True\n    is_non_decreasing = True\n\n    for i in range(1, len(array)):\n        if array[i] > array[i-1]:\n            is_non_increasing = False\n        if array[i] < array[i-1]:\n            is_non_decreasing = False\n        \n        # Early exit if neither property holds\n        if not is_non_increasing and not is_non_decreasing:\n            return False\n\n    return is_non_increasing or is_non_decreasing"}
{"task_id": "Mbpp/70", "solution": "from typing import Iterable, List, Set\n\nclass Tuple:\n    def __init__(self, elements: tuple) -> None:\n        self.elements = elements\n        self.length = len(elements)\n\nclass TupleCollection:\n    def __init__(self, raw_collection: Iterable[tuple]) -> None:\n        # Assumes raw_collection yields tuple objects per SRS.\n        self.tuples: List[Tuple] = [Tuple(tup) for tup in raw_collection]\n\n    def count(self) -> int:\n        return len(self.tuples)\n\n    def distinctLengths(self) -> Set[int]:\n        # Computes and returns the set of distinct tuple lengths.\n        return {t.length for t in self.tuples}\n\nclass GetEqual:\n    def check(self, collection: TupleCollection) -> bool:\n        distinct_lengths = collection.distinctLengths()\n        # Returns True if the collection is empty or all tuples have the same length.\n        return len(distinct_lengths) <= 1\n\ndef get_equal(collection: Iterable[tuple]) -> bool:\n    # Converts the raw collection into a TupleCollection and checks for equal lengths.\n    tuple_collection_obj = TupleCollection(collection)\n    return GetEqual().check(tuple_collection_obj)"}
{"task_id": "Mbpp/71", "solution": "from typing import List\n\nDEFAULT_SHRINK_FACTOR = 1.3\n\ndef comb_sort(input_list: List) -> List:\n    \"\"\"Sorts a list of elements using the comb sort algorithm.\"\"\"\n    n = len(input_list)\n    # Create a shallow copy to avoid mutating the original list.\n    arr = list(input_list)\n\n    gap = n\n    swapped = True\n\n    # Continue sorting as long as there is a gap greater than 1 or elements were swapped.\n    while gap > 1 or swapped:\n        # Reduce the gap by the shrink factor.\n        gap = int(gap / DEFAULT_SHRINK_FACTOR)\n        if gap < 1:\n            gap = 1 # Ensure gap is at least 1.\n\n        swapped = False # Reset swapped flag for the current pass.\n\n        # Perform a pass with the current gap.\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                # Swap elements if they are in the wrong order.\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True # Mark that a swap occurred.\n\n    return arr"}
{"task_id": "Mbpp/72", "solution": "def dif_Square(n):\n    \"\"\"Returns True iff integers a,b exist with n = a^2 - b^2.\n    If n is not an int, the function raises TypeError.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"dif_Square: n must be int\")\n    return n % 4 != 2"}
{"task_id": "Mbpp/75", "solution": "from typing import List, Tuple\n\ndef find_tuples(tuples: List[Tuple[int, ...]], k: int) -> List[Tuple[int, ...]]:\n    \"\"\"\n    Finds tuples where all elements are divisible by k from a list of tuples.\n    Raises ValueError if k is 0.\n    \"\"\"\n    if k == 0:\n        raise ValueError(\"Divisor k cannot be zero.\")\n\n    result = []\n    for tup in tuples:\n        if all(element % k == 0 for element in tup):\n            result.append(tup)\n    return result"}
{"task_id": "Mbpp/74", "solution": "from typing import Any, Dict\n\nclass Mapping:\n    \"\"\"\n    A helper class to maintain a bidirectional mapping between sequence elements\n    and pattern elements, ensuring a one-to-one correspondence.\n    \"\"\"\n    def __init__(self) -> None:\n        self.seq_to_pat: Dict[Any, Any] = {}\n        self.pat_to_seq: Dict[Any, Any] = {}\n\n    def add_mapping(self, seq_elem: Any, pat_elem: Any) -> bool:\n        \"\"\"\n        Adds a mapping if consistent, returning False if a conflict is detected.\n        \"\"\"\n        # Check if seq_elem is already mapped\n        if seq_elem in self.seq_to_pat:\n            # If it's mapped to a different pat_elem, it's a conflict\n            if self.seq_to_pat[seq_elem] != pat_elem:\n                return False\n        \n        # Check if pat_elem is already mapped\n        if pat_elem in self.pat_to_seq:\n            # If it's mapped to a different seq_elem, it's a conflict\n            if self.pat_to_seq[pat_elem] != seq_elem:\n                return False\n        \n        # If no conflicts, establish or confirm the mapping\n        self.seq_to_pat[seq_elem] = pat_elem\n        self.pat_to_seq[pat_elem] = seq_elem\n        return True\n\ndef is_samepatterns(sequence: Any, pattern: Any) -> bool:\n    \"\"\"\n    Checks if a sequence follows the structure given in the patterns array.\n    This function ensures a one-to-one correspondence (bijection) between sequence elements and pattern tokens.\n    \"\"\"\n    if len(sequence) != len(pattern):\n        return False\n\n    if not sequence:  # Covers case where both lengths are zero\n        return True\n\n    mapper = Mapping()\n    for i in range(len(sequence)):\n        seq_elem = sequence[i]\n        pat_elem = pattern[i]\n        if not mapper.add_mapping(seq_elem, pat_elem):\n            return False\n            \n    return True"}
{"task_id": "Mbpp/77", "solution": "class DivisibilityChecker:\n    @staticmethod\n    def is_divisible_by_11(n: int) -> bool:\n        \"\"\"Checks if a number is divisible by 11 using the modulo operator.\"\"\"\n        return n % 11 == 0\n\n    @staticmethod\n    def is_Diff(n: int) -> bool:\n        \"\"\"Delegates the divisibility check to the core logic function.\"\"\"\n        return DivisibilityChecker.is_divisible_by_11(n)\n\ndef is_Diff(n: int) -> bool:\n    \"\"\"\n    Checks if an integer is divisible by 11.\n    This public API function delegates the check to the DivisibilityChecker class.\n    \"\"\"\n    return DivisibilityChecker.is_Diff(n)"}
{"task_id": "Mbpp/79", "solution": "def word_len(word):\n    \"\"\"Return True if the length of the word is odd, False otherwise.\"\"\"\n    return len(word) % 2 == 1"}
{"task_id": "Mbpp/82", "solution": "import math\n\ndef computeVolume(radius: float) -> float:\n    \"\"\"Compute the sphere volume using math.pi; returns float.\"\"\"\n    return (4.0/3.0) * math.pi * (radius ** 3)\n\ndef volume_sphere(radius: float) -> float:\n    \"\"\"Public API: accept numeric radius and return computed volume as float.\"\"\"\n    return computeVolume(radius)"}
{"task_id": "Mbpp/80", "solution": "def tetrahedral_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth tetrahedral number using the formula T(n) = n * (n + 1) * (n + 2) / 6.\n    The calculation uses integer arithmetic to avoid floating-point errors.\n    \"\"\"\n    if n == 0:\n        return 0\n    # The product of three consecutive integers (n, n+1, n+2) is always divisible by 6.\n    # Therefore, integer division (//) can be applied directly to ensure integer-only arithmetic.\n    return (n * (n + 1) * (n + 2)) // 6"}
{"task_id": "Mbpp/86", "solution": "def centered_hexagonal_number(n: int) -> int:\n    \"\"\"\n    Computes the nth centered hexagonal number.\n\n    Raises ValueError if n is not a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"Input 'n' must be a positive integer (n >= 1).\")\n    return 3 * n * (n - 1) + 1"}
{"task_id": "Mbpp/85", "solution": "import math\n\nclass MathConstants:\n    \"\"\"Provides mathematical constants.\"\"\"\n    PI: float = math.pi\n\nclass Sphere:\n    \"\"\"Represents a sphere with a radius and surface area.\"\"\"\n    def __init__(self, radius: float):\n        self.radius = radius\n        self.surface_area: float | None = None\n\n    def computeSurfaceArea(self) -> float:\n        \"\"\"Computes and returns the surface area of the sphere.\"\"\"\n        self.surface_area = 4 * MathConstants.PI * (self.radius ** 2)\n        return self.surface_area\n\nclass SurfaceAreaCalculator:\n    \"\"\"Encapsulates the calculation logic for sphere surface area.\"\"\"\n    @staticmethod\n    def surfacearea_sphere(radius: float) -> float:\n        \"\"\"Computes and returns the surface area of a sphere.\"\"\"\n        return 4 * MathConstants.PI * (radius ** 2)\n\ndef surfacearea_sphere(radius: float) -> float:\n    \"\"\"\n    Calculates the surface area of a sphere given its radius.\n    Delegates the calculation to SurfaceAreaCalculator.\n    \"\"\"\n    return SurfaceAreaCalculator.surfacearea_sphere(radius)"}
{"task_id": "Mbpp/84", "solution": "from typing import Dict\n\n_memo: Dict[int, int] = {1: 1, 2: 1}\n\ndef sequence(n: int) -> int:\n    \"\"\"\n    Finds the nth number in the Newman-Conway sequence using memoization.\n    Raises ValueError for invalid input n.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"Invalid input: n must be integer >= 1\")\n\n    if n in _memo:\n        return _memo[n]\n\n    # Calculate a(n) = a(a(n-1)) + a(n - a(n-1))\n    val_n_minus_1 = sequence(n - 1)\n    \n    term1_index = val_n_minus_1\n    term2_index = n - val_n_minus_1\n    \n    result = sequence(term1_index) + sequence(term2_index)\n    _memo[n] = result\n    \n    return result"}
{"task_id": "Mbpp/87", "solution": "def _collect_all_keys(d1: dict, d2: dict, d3: dict) -> set:\n    \"\"\"Return union of keys from d1, d2, d3 (module-private helper).\"\"\"\n    return d1.keys() | d2.keys() | d3.keys()\n\ndef merge_dictionaries_three(d1: dict, d2: dict, d3: dict) -> dict:\n    \"\"\"Return a new dict that is the merge of d1, d2, d3 according to the SRS.\n\n    If a key appears in multiple inputs with differing values, raise ValueError (fail-fast).\n    \"\"\"\n    merged_dict = {}\n    all_keys = _collect_all_keys(d1, d2, d3)\n\n    for key in all_keys:\n        present_values = []\n        if key in d1:\n            present_values.append(d1[key])\n        if key in d2:\n            present_values.append(d2[key])\n        if key in d3:\n            present_values.append(d3[key])\n\n        first_value = present_values[0]\n        if all(v == first_value for v in present_values):\n            merged_dict[key] = first_value\n        else:\n            raise ValueError(f\"Conflicting values for key '{key}': {present_values}\")\n            \n    return merged_dict"}
{"task_id": "Mbpp/88", "solution": "class FrequencyAnalyzer:\n    def freq_count(self, items: list) -> dict:\n        \"\"\"Compute and return a built-in dict mapping each distinct element to its integer occurrence count.\n\n        Implementation detail: iterate over items and accumulate counts in a local dict.\n        \"\"\"\n        counts = {}\n        for item in items:\n            counts[item] = counts.get(item, 0) + 1\n        return counts\n\ndef freq_count(items: list) -> dict:\n    \"\"\"Public function required by FR1. Delegates to FrequencyAnalyzer.freq_count.\n\n    Preconditions: items is expected to be a Python list.\n    \"\"\"\n    analyzer = FrequencyAnalyzer()\n    return analyzer.freq_count(items)"}
