{"task_id": "Mbpp/265", "solution": "class InvalidNError(Exception):\n    \"\"\"Custom exception raised when the 'n' parameter is invalid.\"\"\"\n    def __init__(self, message: str = \"n must be an integer greater than 0\"):\n        super().__init__(message)\n\ndef validate_n(n):\n    \"\"\"Raises InvalidNError if 'n' is not a positive integer.\"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise InvalidNError()\n\ndef split(lst, n):\n    \"\"\"Distributes elements of a list into 'n' sublists based on index modulo 'n'.\"\"\"\n    result = [[] for _ in range(n)]\n    for idx, item in enumerate(lst):\n        result[idx % n].append(item)\n    return result\n\ndef list_split(lst, n):\n    \"\"\"\n    Splits a list into 'n' sublists, where each sublist contains elements\n    taken at intervals of 'n' from the original list.\n    \"\"\"\n    validate_n(n)\n    return split(lst, n)"}
{"task_id": "Mbpp/267", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass InputParameter:\n    name: str\n    type: str\n    value: int\n\n@dataclass\nclass Result:\n    value: int\n\nclass Computation:\n    @staticmethod\n    def compute(n: int) -> int:\n        \"\"\"\n        Computes the sum of the squares of the first n odd natural numbers.\n        This method calculates sum_{k=1..n} (2*k - 1)^2.\n        \"\"\"\n        total_sum = 0\n        for k in range(1, n + 1):\n            odd_number = (2 * k) - 1\n            total_sum += odd_number ** 2\n        return total_sum\n\ndef _validate_n(n) -> InputParameter:\n    \"\"\"\n    Validates the input n, ensuring it is a non-negative integer.\n    Raises TypeError if not an integer, ValueError if negative.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' cannot be a negative integer.\")\n    return InputParameter(name='n', type='int', value=n)\n\ndef square_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the squares of the first n odd natural numbers.\n    It validates the input, returns 0 for n=0, and delegates computation for n > 0.\n    \"\"\"\n    _validate_n(n) # Perform validation as per design\n\n    if n == 0:\n        return 0\n    else:\n        return Computation.compute(n)"}
{"task_id": "Mbpp/268", "solution": "def find_star_num(n: int) -> int:\n    \"\"\"Compute and return the nth star number using the formula S(n) = 6 * n * (n - 1) + 1.\"\"\"\n    return 6 * n * (n - 1) + 1"}
{"task_id": "Mbpp/269", "solution": "class ValidationError(ValueError):\n    \"\"\"Deterministic validation error raised when input length != 1.\"\"\"\n\nclass InputValidator:\n    \"\"\"Validates that inputs conform to the single-character requirement.\"\"\"\n    def validateSingleChar(self, input_str: str) -> bool:\n        \"\"\"Checks if the input string contains exactly one character.\"\"\"\n        return len(input_str) == 1\n\nclass Character:\n    \"\"\"Holds a single-character value and provides its code point.\"\"\"\n    def __init__(self, value: str):\n        \"\"\"Initializes the Character with a string value.\"\"\"\n        self.value: str = value\n\n    def getCodePoint(self) -> int:\n        \"\"\"Returns the integer code point of the character.\"\"\"\n        return ord(self.value)\n\nclass AsciiService:\n    \"\"\"Implements the workflow to find the ASCII value of a character.\"\"\"\n    def ascii_value(self, char: str) -> int:\n        \"\"\"Validates input, constructs a Character, and returns its code point.\"\"\"\n        validator = InputValidator()\n        if not validator.validateSingleChar(char):\n            raise ValidationError(\"Input must be a single character string.\")\n\n        character_obj = Character(char)\n        return character_obj.getCodePoint()\n\ndef ascii_value(character: str) -> int:\n    \"\"\"Public API: returns ASCII code for single-character input or raises ValidationError.\"\"\"\n    service = AsciiService()\n    return service.ascii_value(character)"}
{"task_id": "Mbpp/270", "solution": "def sum_even_and_even_index(lst):\n    \"\"\"\n    Calculates the sum of even numbers found at even positions (0-based) in a list.\n    Raises TypeError if the input is not a list or contains non-integer elements.\n    \"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"lst must be a list of integers\")\n    if any(not isinstance(item, int) for item in lst):\n        raise TypeError(\"all elements of lst must be integers\")\n\n    total_sum = 0\n    for i, v in enumerate(lst):\n        if i % 2 == 0 and v % 2 == 0:\n            total_sum += v\n    return total_sum"}
{"task_id": "Mbpp/271", "solution": "from typing import Any, List\n\nclass EvenPowerSumFunction:\n    exponent: int = 5\n\n    def _validate_input(self, n: Any) -> None:\n        \"\"\"Raise ValueError if n is not int or n < 0. Accept n == 0.\"\"\"\n        if not isinstance(n, int):\n            raise ValueError(\"Input 'n' must be an integer.\")\n        if n < 0:\n            raise ValueError(\"Input 'n' must be non-negative.\")\n\n    def _generate_even_sequence(self, n: int) -> List[int]:\n        \"\"\"Return [2, 4, ..., 2*n] for n >= 0.\"\"\"\n        return [2 * k for k in range(1, n + 1)]\n\n    def _raise_to_fifth(self, x: int) -> int:\n        \"\"\"Return x ** self.exponent using integer arithmetic.\"\"\"\n        return x ** self.exponent\n\n    def compute(self, n: int) -> int:\n        \"\"\"Validate and compute sum_{k=1..n} (2*k)**5 returning int.\"\"\"\n        self._validate_input(n)\n        if n == 0:\n            return 0\n        \n        even_numbers = self._generate_even_sequence(n)\n        total_sum = 0\n        for num in even_numbers:\n            total_sum += self._raise_to_fifth(num)\n        return total_sum\n\ndef even_Power_Sum(n: int) -> int:\n    \"\"\"Public API. Instantiates EvenPowerSumFunction and returns compute(n).\"\"\"\n    calculator = EvenPowerSumFunction()\n    return calculator.compute(n)"}
{"task_id": "Mbpp/272", "solution": "from typing import List, Tuple, Any\n\n# Type aliases for documentation/typing as per design context\nTupleList = List[Tuple[Any, ...]]\nResultList = List[Any]\n\ndef rear_extract(tupleList: TupleList) -> ResultList:\n    \"\"\"\n    Extracts the rear (last) element from each tuple in a list of tuples.\n    Returns a new list containing these elements in the original order.\n    \"\"\"\n    return [t[-1] for t in tupleList]"}
{"task_id": "Mbpp/277", "solution": "def dict_filter(data, n):\n    \"\"\"Return a new dict containing only key/value pairs from 'data' where value >= n.\n    Preconditions: 'data' is a dict-like mapping; 'n' is an integer.\n    \"\"\"\n    result = {}\n    for key, value in data.items():\n        if value >= n:\n            result[key] = value\n    return result"}
{"task_id": "Mbpp/273", "solution": "def _validate_is_tuple(arg, name: str) -> None:\n    \"\"\"Ensures an argument is a tuple, raising ValueError if not.\"\"\"\n    if not isinstance(arg, tuple):\n        raise ValueError(f\"{name} must be a tuple\")\n\ndef _validate_same_length(t1, t2) -> None:\n    \"\"\"Ensures two tuples have the same length, raising ValueError if not.\"\"\"\n    if len(t1) != len(t2):\n        raise ValueError(\"Input tuples must have the same length\")\n\ndef _validate_numeric_elements(t, name: str) -> None:\n    \"\"\"Ensures all elements in a tuple are int or float, raising ValueError if not.\"\"\"\n    for element in t:\n        if not isinstance(element, (int, float)):\n            raise ValueError(f\"All elements of {name} must be int or float\")\n\ndef _compute_elementwise(t1, t2) -> tuple:\n    \"\"\"Performs element-wise subtraction of two tuples.\"\"\"\n    return tuple(t1[i] - t2[i] for i in range(len(t1)))\n\ndef substract_elements(tuple1, tuple2) -> tuple:\n    \"\"\"\n    Subtracts the elements of the first tuple by the elements of the second tuple with the same index.\n    Raises ValueError for invalid inputs (non-tuple, length mismatch, non-numeric elements).\n    \"\"\"\n    _validate_is_tuple(tuple1, \"tuple1\")\n    _validate_is_tuple(tuple2, \"tuple2\")\n    _validate_same_length(tuple1, tuple2)\n    _validate_numeric_elements(tuple1, \"tuple1\")\n    _validate_numeric_elements(tuple2, \"tuple2\")\n    return _compute_elementwise(tuple1, tuple2)"}
{"task_id": "Mbpp/278", "solution": "def count_first_elements(input_tuple: tuple) -> int:\n    \"\"\"\n    Counts the number of top-level elements before the first top-level element that is itself a tuple.\n    Raises TypeError if the input is not a tuple.\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n\n    for i, element in enumerate(input_tuple):\n        if isinstance(element, tuple):\n            return i\n    return 0"}
{"task_id": "Mbpp/274", "solution": "class Validator:\n    \"\"\"Encapsulates input validation logic for the function parameter n.\"\"\"\n    def validate(self, n: int) -> None:\n        \"\"\"Raise ValueError if n is not an int or n <= 0.\"\"\"\n        if not isinstance(n, int) or n <= 0:\n            raise ValueError(\"n must be a positive integer (> 0)\")\n\nclass BinomialCalculator:\n    \"\"\"Encapsulates computation of the sum of even-index binomial coefficients.\"\"\"\n    def compute_sum_even_coeffs(self, n: int) -> int:\n        \"\"\"Return integer Sum_{k even} C(n,k). For n>0 returns pow(2, n-1).\"\"\"\n        return pow(2, n - 1)\n\ndef even_binomial_Coeff_Sum(n):\n    \"\"\"\n    Validates n and returns the sum of even index binomial coefficients.\n    Uses Validator for input validation and BinomialCalculator for computation.\n    \"\"\"\n    validator = Validator()\n    validator.validate(n)\n    calculator = BinomialCalculator()\n    result = calculator.compute_sum_even_coeffs(n)\n    return result"}
{"task_id": "Mbpp/279", "solution": "class InputParameter:\n    \"\"\"A data container for the input index n.\"\"\"\n    def __init__(self, n: int) -> None:\n        self.n = n\n\nclass DecagonalNumber:\n    \"\"\"A data container for a decagonal number and its index.\"\"\"\n    def __init__(self, n: int, value: int) -> None:\n        self.n = n\n        self.value = value\n\nclass FunctionSignature:\n    \"\"\"Holds the canonical API name and an optional description.\"\"\"\n    name: str = \"is_num_decagonal\"\n    def __init__(self, description: str = \"\") -> None:\n        self.description = description\n\nclass DecagonalNumberCalculator:\n    \"\"\"Provides methods to validate and compute decagonal numbers.\"\"\"\n    def validate(self, n: int) -> bool:\n        \"\"\"Validates if n is a 1-based integer index.\"\"\"\n        return isinstance(n, int) and n >= 1\n\n    def compute(self, n: int) -> int:\n        \"\"\"Computes the nth decagonal number using the formula.\"\"\"\n        # Precondition: n is valid (n >= 1)\n        return 4 * n * n - 3 * n\n\ndef is_num_decagonal(n: int) -> int:\n    \"\"\"\n    Finds the nth decagonal number using the formula 4*n*n - 3*n.\n    Raises ValueError if n is not a 1-based integer index (n < 1).\n    \"\"\"\n    calculator = DecagonalNumberCalculator()\n    if not calculator.validate(n):\n        raise ValueError(\"n must be a 1-based integer index (n >= 1)\")\n    return calculator.compute(n)"}
{"task_id": "Mbpp/282", "solution": "def sub_list(list1, list2):\n    \"\"\"\n    Subtracts two lists element-wise.\n    Assumes inputs are lists of numeric values and have the same length.\n    \"\"\"\n    result = []\n    for i in range(len(list1)):\n        result.append(list1[i] - list2[i])\n    return result"}
