{"task_id": "Mbpp/3", "solution": "import math\n\ndef _is_divisible_by_any(n: int) -> bool:\n    \"\"\"Checks if n is divisible by any integer from 2 up to its integer square root.\"\"\"\n    limit = math.isqrt(n)\n    for d in range(2, limit + 1):\n        if n % d == 0:\n            return True\n    return False\n\ndef is_not_prime(n: int) -> bool:\n    \"\"\"Identifies if a number is not prime (composite or special non-prime).\"\"\"\n    if n < 2:\n        return True\n    if n == 2:\n        return False\n    return _is_divisible_by_any(n)"}
{"task_id": "Mbpp/8", "solution": "import numbers\nfrom typing import Sequence, List\n\ndef square_nums(input_list: Sequence[numbers.Number]) -> List[numbers.Number]:\n    \"\"\"\n    Finds squares of individual numeric elements in a list.\n    Raises ValueError if input is not a sequence of numbers or contains non-numeric elements.\n    \"\"\"\n    if not isinstance(input_list, Sequence):\n        raise ValueError(\"Input must be a list/sequence of numeric values.\")\n    \n    for x in input_list:\n        if not isinstance(x, numbers.Number):\n            raise ValueError(\"Input must be a list/sequence of numeric values.\")\n\n    return [x * x for x in input_list]"}
{"task_id": "Mbpp/2", "solution": "def similar_elements(seq1, seq2):\n    \"\"\"\n    Finds elements common to both input sequences.\n    Returns a list of unique shared elements.\n    \"\"\"\n    set1 = set(seq1)\n    set2 = set(seq2)\n    shared_elements_set = set1.intersection(set2)\n    return list(shared_elements_set)"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(a: int, b: int) -> bool:\n    \"\"\"\n    Checks if the binary representations of two numbers differ at exactly one bit position.\n    \"\"\"\n    xor_result = a ^ b\n    return xor_result != 0 and (xor_result & (xor_result - 1)) == 0"}
{"task_id": "Mbpp/7", "solution": "from typing import List\n\nclass Word:\n    \"\"\"Encapsulates a word token with its text and length.\"\"\"\n    def __init__(self, text: str):\n        self.text: str = text\n\n    def length(self) -> int:\n        \"\"\"Return integer length of self.text (Python codepoint count via len()).\"\"\"\n        return len(self.text)\n\nResultList = List[str]\n\nclass Tokenizer:\n    \"\"\"Handles splitting text into word tokens.\"\"\"\n    @staticmethod\n    def split_on_whitespace(text: str) -> List[Word]:\n        \"\"\"Split text on Python whitespace and return list of Word instances preserving original token strings.\"\"\"\n        tokens = text.split()\n        return [Word(t) for t in tokens]\n\ndef find_char_long(text: str) -> ResultList:\n    \"\"\"Public API: accept one argument (text) and return list of strings where len >= 4 preserving casing.\"\"\"\n    tokens: List[Word] = Tokenizer.split_on_whitespace(text)\n    filtered = [w.text for w in tokens if w.length() >= 4]\n    return filtered"}
{"task_id": "Mbpp/4", "solution": "from typing import List\nimport heapq\n\ndef heap_queue_largest(input_list: List[int], n: int) -> List[int]:\n    \"\"\"\n    Finds the n largest integers from a list and returns them in descending order.\n    Duplicates are preserved if they are among the top n.\n    \"\"\"\n    if not input_list or n <= 0:\n        return []\n    \n    # heapq.nlargest efficiently finds the n largest elements,\n    # returning them in descending order and preserving duplicates.\n    # It also handles cases where n is larger than the list length, returning all elements.\n    return heapq.nlargest(n, input_list)"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(s: str) -> int:\n    \"\"\"\n    Finds the minimum number of rotations (greater than 0) required to get the same string.\n    \"\"\"\n    n = len(s)\n    if n == 0:\n        return 0\n\n    # Iterate through possible rotation counts k, from 1 up to n-1.\n    for k in range(1, n):\n        # A rotation by k means taking the last k characters and putting them at the beginning.\n        # Example: s = \"abc\", k = 1 -> \"cab\" (s[-1:] + s[:-1])\n        rotated_s = s[-k:] + s[:-k]\n\n        if rotated_s == s:\n            return k\n\n    # If no rotation k (from 1 to n-1) results in the original string,\n    # then the string itself is the smallest repeating unit, meaning n rotations are required.\n    # For example, \"abc\" needs 3 rotations to become \"abc\" again.\n    return n"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string, char) -> str:\n    \"\"\"\n    Removes the first and last occurrences of a given character from the string.\n    \"\"\"\n    first_index = input_string.find(char)\n    if first_index == -1:\n        return input_string\n\n    last_index = input_string.rfind(char)\n\n    if first_index == last_index:\n        # Character occurs only once, remove that single occurrence\n        return input_string[:first_index] + input_string[first_index + 1:]\n    else:\n        # Character occurs multiple times, remove first and last\n        return input_string[:first_index] + input_string[first_index + 1:last_index] + input_string[last_index + 1:]"}
{"task_id": "Mbpp/59", "solution": "class ValidationError(Exception):\n    \"\"\"\n    Exception raised for invalid input parameters.\n    Captures a numeric code and a descriptive message.\n    \"\"\"\n    def __init__(self, code: int, message: str):\n        self.code = code\n        self.message = message\n        super().__init__(f\"Error {code}: {message}\")\n\nclass InputParameter:\n    \"\"\"\n    Wraps raw input n and provides validation for octagonal number index.\n    Ensures n is an integer and n >= 1.\n    \"\"\"\n    def __init__(self, n):\n        self.n = n\n\n    def validate(self) -> bool:\n        \"\"\"\n        Validates that n is an integer and is greater than or equal to 1.\n        \"\"\"\n        if not isinstance(self.n, int):\n            return False\n        if self.n < 1:\n            return False\n        return True\n\nclass OctagonalNumber:\n    \"\"\"\n    Represents an octagonal number with its index and calculated value.\n    \"\"\"\n    def __init__(self, index: int, value: int):\n        self.index = index\n        self.value = value\n\nclass OctagonalCalculator:\n    \"\"\"\n    Validates input and computes the nth octagonal number.\n    Delegates input validation and performs pure calculation.\n    \"\"\"\n    def is_octagonal(self, n) -> int:\n        \"\"\"\n        Validates the input n and computes the nth octagonal number.\n        Raises ValidationError if n is not a valid 1-based index.\n        \"\"\"\n        ip = InputParameter(n)\n        if not ip.validate():\n            raise ValidationError(code=1, message=f\"Invalid input for n: {n}; n must be integer >= 1\")\n        return self.calculate(n)\n\n    def calculate(self, n: int) -> int:\n        \"\"\"\n        Computes the nth octagonal number using the formula O_n = n * (3 * n - 2).\n        Assumes n has already been validated.\n        \"\"\"\n        return n * (3 * n - 2)\n\ndef is_octagonal(n: int) -> int:\n    \"\"\"\n    Calculates the nth octagonal number.\n    Delegates to OctagonalCalculator for validation and computation.\n    \"\"\"\n    calculator = OctagonalCalculator()\n    return calculator.is_octagonal(n)"}
{"task_id": "Mbpp/16", "solution": "import re\n\nclass RegexPattern:\n    \"\"\"Helper class to compile and match a regular expression pattern.\"\"\"\n    def __init__(self, pattern_str: str) -> None:\n        self._pattern_str = pattern_str\n        self._compiled = re.compile(pattern_str)\n\n    def matches(self, input_string: str) -> bool:\n        \"\"\"Returns True if the input string matches the compiled pattern, False otherwise.\"\"\"\n        return self._compiled.search(input_string) is not None\n\n# Module-level constant for the regex pattern\nPATTERN: str = r\"[a-z]+_[a-z]+\"\n\n# Module-level instance of RegexPattern for efficiency\n_regex_matcher = RegexPattern(PATTERN)\n\ndef text_lowercase_underscore(input_string: str) -> bool:\n    \"\"\"\n    Checks if the input string contains sequences of lowercase letters\n    joined with an underscore.\n    \"\"\"\n    return _regex_matcher.matches(input_string)\n\nclass TestCase:\n    \"\"\"Lightweight helper to encapsulate a test input, expected result, and run verification.\"\"\"\n    def __init__(self, input: str, expected: bool) -> None:\n        self.input = input\n        self.expected = expected\n        self.actual = None\n\n    def run(self) -> bool:\n        \"\"\"Executes the test and returns True if actual result matches expected.\"\"\"\n        self.actual = text_lowercase_underscore(self.input)\n        return self.actual == self.expected"}
{"task_id": "Mbpp/14", "solution": "def _is_numeric(value):\n    \"\"\"Return True if value is an int or float, but not a bool.\"\"\"\n    return isinstance(value, (int, float)) and not isinstance(value, bool)\n\ndef find_Volume(base, triangle_height, length):\n    \"\"\"Return numeric volume of triangular prism computed as (0.5 * base * triangle_height) * length.\n    Accepts int or float for parameters; raises TypeError for non-numeric values.\n    \"\"\"\n    if not _is_numeric(base):\n        raise TypeError(\"Inputs must be numeric (int or float)\")\n    if not _is_numeric(triangle_height):\n        raise TypeError(\"Inputs must be numeric (int or float)\")\n    if not _is_numeric(length):\n        raise TypeError(\"Inputs must be numeric (int or float)\")\n\n    base_area = 0.5 * base * triangle_height\n    volume = base_area * length\n    return volume"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(number: int) -> bool:\n    \"\"\"\n    Checks if the given number is a Woodall number.\n    A Woodall number is of the form n * 2^n - 1 for some integer n >= 1.\n    \"\"\"\n    n = 1\n    while True:\n        candidate = n * (2**n) - 1\n        if candidate == number:\n            return True\n        if candidate > number:\n            return False\n        n += 1"}
