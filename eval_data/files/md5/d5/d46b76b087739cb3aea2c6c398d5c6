{"task_id": "Mbpp/285", "solution": "import re\nfrom typing import Optional\n\nclass MatchResult:\n    \"\"\"Represents the boolean matching result and optional matched substring.\"\"\"\n    def __init__(self, matched: bool, matched_substring: Optional[str] = None) -> None:\n        self.matched = matched\n        self.matched_substring = matched_substring\n\nclass InputString:\n    \"\"\"Encapsulates the input string and its length.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n        self.length = len(value)\n\nclass MatchPattern:\n    \"\"\"Encapsulates the matching pattern and provides evaluation method.\"\"\"\n    def __init__(self, pattern: str = 'ab{2,3}', case_sensitive: bool = True) -> None:\n        # The 'pattern' argument is informational as literal substring checks are used.\n        self.pattern = pattern\n        self.case_sensitive = case_sensitive\n\n    def matches(self, input_string: str) -> bool:\n        \"\"\"Checks if the input string contains 'abb' or 'abbb' literally and case-sensitively.\"\"\"\n        return ('abb' in input_string) or ('abbb' in input_string)\n\nclass TextMatchTwoThreeFunction:\n    \"\"\"Orchestrates pattern matching for an input string.\"\"\"\n    def __init__(self, pattern: Optional[MatchPattern] = None) -> None:\n        self._pattern = pattern if pattern is not None else MatchPattern()\n\n    def execute(self, input_str: str) -> bool:\n        \"\"\"Executes the pattern matching logic for the given input string.\"\"\"\n        input_obj = InputString(input_str)\n        matched = self._pattern.matches(input_obj.value)\n        result = MatchResult(matched, matched_substring=None)\n        return result.matched\n\ndef text_match_two_three(input: str) -> bool:\n    \"\"\"\n    Checks whether a string contains the 'a' character followed by exactly two or three 'b' characters.\n    \"\"\"\n    return TextMatchTwoThreeFunction().execute(input)"}
{"task_id": "Mbpp/283", "solution": "import collections\n\ndef validate(n: int) -> bool:\n    \"\"\"\n    Checks if the frequency of each digit in n is less than or equal to the digit itself.\n    Returns False if digit 0 is present or if any digit's frequency exceeds its value.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n\n    s = str(abs(n))\n    counts = collections.Counter(s)\n\n    for char_digit, freq in counts.items():\n        digit = int(char_digit)\n        if digit == 0:\n            return False\n        if freq > digit:\n            return False\n    return True"}
{"task_id": "Mbpp/281", "solution": "def all_unique(lst) -> bool:\n    \"\"\"Return True if all elements in lst are unique using Python equality (a == b).\n\n    Iterates through the list, comparing each element to all subsequent elements.\n    \"\"\"\n    n = len(lst)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if lst[i] == lst[j]:\n                return False\n    return True"}
{"task_id": "Mbpp/280", "solution": "from typing import Any, List, Tuple\n\nclass SearchResult:\n    \"\"\"Immutable container representing search outcome.\"\"\"\n    def __init__(self, found: bool, index: int) -> None:\n        self._found = found\n        self._index = index\n\n    def as_tuple(self) -> Tuple[bool, int]:\n        \"\"\"Returns the search result as a (found, index) tuple.\"\"\"\n        return (self._found, self._index)\n\nclass Element:\n    \"\"\"Encapsulates a target value and provides equality comparison.\"\"\"\n    def __init__(self, value: Any) -> None:\n        self._value = value\n\n    def equals(self, other_value: Any) -> bool:\n        \"\"\"Compares the encapsulated value with another value.\"\"\"\n        return self._value == other_value\n\nclass Array:\n    \"\"\"Lightweight read-only wrapper representing an ordered collection.\"\"\"\n    def __init__(self, elements: List[Any]) -> None:\n        self._elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the array.\"\"\"\n        return len(self._elements)\n\n    def get(self, index: int) -> Any:\n        \"\"\"Retrieves an element by its zero-based index.\"\"\"\n        return self._elements[index]\n\nclass SearchAlgorithm:\n    \"\"\"Abstract contract for search algorithm implementations.\"\"\"\n    def execute(self, array: 'Array', element: 'Element') -> 'SearchResult':\n        \"\"\"Executes the search algorithm.\"\"\"\n        raise NotImplementedError(\"Subclasses must implement execute method.\")\n\nclass SequentialSearch(SearchAlgorithm):\n    \"\"\"Concrete implementation of a sequential (linear) search algorithm.\"\"\"\n    def __init__(self) -> None:\n        self._algorithm_type = 'sequential'\n\n    def execute(self, array: 'Array', element: 'Element') -> 'SearchResult':\n        \"\"\"Performs a linear scan to find the element in the array.\"\"\"\n        for i in range(array.length()):\n            current_array_value = array.get(i)\n            if element.equals(current_array_value):\n                return SearchResult(True, i)\n        return SearchResult(False, -1)\n\ndef sequential_search(array: List[Any], element: Any) -> Tuple[bool, int]:\n    \"\"\"\n    Searches for an element in an array using a sequential scan.\n    Returns a tuple (found: bool, index: int) where index is -1 if not found.\n    \"\"\"\n    arr_wrapper = Array(array)\n    elem_wrapper = Element(element)\n    search_algo = SequentialSearch()\n    result = search_algo.execute(arr_wrapper, elem_wrapper)\n    return result.as_tuple()"}
{"task_id": "Mbpp/286", "solution": "from typing import List\n\nclass InputValidationError(Exception):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    pass\n\ndef _validate_inputs(arr: List[int], n: int, k: int) -> None:\n    \"\"\"Validates input array, its length, and repetition count.\"\"\"\n    if not isinstance(arr, list):\n        raise InputValidationError(\"Input 'arr' must be a list.\")\n    if not all(isinstance(x, int) for x in arr):\n        raise InputValidationError(\"All elements in 'arr' must be integers.\")\n    if n != len(arr):\n        raise InputValidationError(\"Parameter 'n' must be equal to len(arr).\")\n    if k <= 0:\n        raise InputValidationError(\"Parameter 'k' must be a positive integer.\")\n\ndef _kadane(arr: List[int]) -> int:\n    \"\"\"\n    Computes the maximum sum of a contiguous subarray using Kadane's algorithm.\n    Handles arrays with all negative numbers by returning the largest element.\n    \"\"\"\n    if not arr:\n        return 0\n\n    max_so_far = arr[0]\n    current_max = arr[0]\n\n    for i in range(1, len(arr)):\n        current_max = max(arr[i], current_max + arr[i])\n        max_so_far = max(max_so_far, current_max)\n    return max_so_far\n\ndef _max_prefix_sum(arr: List[int]) -> int:\n    \"\"\"\n    Computes the maximum sum of any prefix subarray of the given array.\n    This includes considering the entire array or a single element.\n    \"\"\"\n    if not arr:\n        return 0\n\n    max_sum = arr[0]\n    current_sum = arr[0]\n\n    for i in range(1, len(arr)):\n        current_sum += arr[i]\n        max_sum = max(max_sum, current_sum)\n    return max_sum\n\ndef _max_suffix_sum(arr: List[int]) -> int:\n    \"\"\"\n    Computes the maximum sum of any suffix subarray of the given array.\n    This includes considering the entire array or a single element.\n    \"\"\"\n    if not arr:\n        return 0\n\n    max_sum = arr[-1]\n    current_sum = arr[-1]\n\n    for i in range(len(arr) - 2, -1, -1):\n        current_sum += arr[i]\n        max_sum = max(max_sum, current_sum)\n    return max_sum\n\ndef max_sub_array_sum_repeated(arr: List[int], n: int, k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous subarray in the modified array\n    formed by repeating the given array k times.\n    \"\"\"\n    _validate_inputs(arr, n, k)\n\n    if n == 0:\n        return 0\n\n    single_max_sum = _kadane(arr)\n\n    if k == 1:\n        return single_max_sum\n\n    prefix_sum = _max_prefix_sum(arr)\n    suffix_sum = _max_suffix_sum(arr)\n    total_sum = sum(arr)\n\n    # Compute maximum sum considering subarrays that span across repetition boundaries.\n    # This sum includes a suffix of the first array, optionally k-1 full arrays,\n    # and a prefix of the last array.\n    cross_boundary_max = suffix_sum + prefix_sum + max(0, (k - 1) * total_sum)\n\n    return max(single_max_sum, cross_boundary_max)"}
{"task_id": "Mbpp/287", "solution": "def square_Sum(n):\n    \"\"\"Compute the sum of squares of the first n even natural numbers.\n    This implementation uses a closed-form algebraic formula for efficiency.\n    \"\"\"\n    return 4 * n * (n + 1) * (2 * n + 1) // 6"}
{"task_id": "Mbpp/290", "solution": "def max_length(lists):\n    \"\"\"\n    Finds the list of maximum length in a list of lists.\n    Returns a tuple (max_len, max_list), using the first encountered list for tie-breaking.\n    \"\"\"\n    if not lists:\n        raise ValueError(\"outer list must contain at least one inner list\")\n\n    max_len = -1\n    max_list = None\n\n    for inner_list in lists:\n        current_len = len(inner_list)\n        if current_len > max_len:\n            max_len = current_len\n            max_list = inner_list\n    \n    return (max_len, max_list)"}
