{"task_id": "Mbpp/19", "solution": "def _validate_integer_list(array):\n    \"\"\"Private helper: raises TypeError if 'array' is not a list/tuple of int elements.\"\"\"\n    if not isinstance(array, (list, tuple)):\n        raise TypeError(\"Input must be a list or tuple.\")\n    for element in array:\n        if not isinstance(element, int):\n            raise TypeError(\"All elements in the array must be integers.\")\n\ndef test_duplicate(array):\n    \"\"\"Public API as required by SRS. Returns True if any duplicate integer value exists in 'array', otherwise False. Raises TypeError on invalid input.\"\"\"\n    _validate_integer_list(array)\n    seen = set()\n    for item in array:\n        if item in seen:\n            return True\n        seen.add(item)\n    return False"}
{"task_id": "Mbpp/12", "solution": "from typing import List, Union\n\nNumeric = Union[int, float]\n\ndef _compute_row_sums(matrix: List[List[Numeric]]) -> List[float]:\n    \"\"\"Compute numeric sum for each row and return list of sums.\"\"\"\n    sums = []\n    for row in matrix:\n        sums.append(sum(row))\n    return sums\n\ndef _stable_sort_rows_by_sum(matrix: List[List[Numeric]], sums: List[float]) -> List[List[Numeric]]:\n    \"\"\"Return rows sorted ascending by sums while preserving original relative order for equal sums.\"\"\"\n    sum_row_pairs = [(sums[i], matrix[i]) for i in range(len(matrix))]\n    sum_row_pairs.sort(key=lambda pair: pair[0])\n    sorted_matrix = [row for _, row in sum_row_pairs]\n    return sorted_matrix\n\ndef sort_matrix(matrix: List[List[Numeric]]) -> List[List[Numeric]]:\n    \"\"\"\n    Sorts a given matrix in ascending order according to the sum of its rows.\n    Returns a reordered list-of-lists.\n    \"\"\"\n    if not matrix:\n        return []\n\n    sums = _compute_row_sums(matrix)\n    sorted_matrix = _stable_sort_rows_by_sum(matrix, sums)\n    return sorted_matrix"}
{"task_id": "Mbpp/18", "solution": "def remove_dirty_chars(first_string: str, second_string: str) -> str:\n    \"\"\"\n    Removes characters from the first string which are present in the second string.\n    Preserves order of remaining characters and performs case-sensitive matching.\n    \"\"\"\n    if not first_string:\n        return \"\"\n    if not second_string:\n        return first_string\n\n    dirty_chars_set = set(second_string)\n    result_chars = []\n    for char in first_string:\n        if char not in dirty_chars_set:\n            result_chars.append(char)\n\n    return \"\".join(result_chars)"}
