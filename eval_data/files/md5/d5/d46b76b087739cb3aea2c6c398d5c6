{"task_id": "Mbpp/448", "solution": "def cal_sum(n: int) -> int:\n    \"\"\"Calculates the sum of Perrin numbers from 0 to n.\"\"\"\n\n    class PerrinSequence:\n        def __init__(self):\n            # Base cases for Perrin sequence P(0)=3, P(1)=0, P(2)=2\n            self._memo = {0: 3, 1: 0, 2: 2}\n\n        def getP(self, n_val: int) -> int:\n            # Assumes n_val is a non-negative integer based on outer function's implied contract.\n            if n_val in self._memo:\n                return self._memo[n_val]\n\n            # Calculate Perrin numbers iteratively for n_val >= 3 using memoization.\n            # P(k) = P(k-2) + P(k-3)\n            for i in range(3, n_val + 1):\n                self._memo[i] = self._memo[i - 2] + self._memo[i - 3]\n            \n            return self._memo[n_val]\n\n    class SumCalculator:\n        def __init__(self):\n            self._perrin_sequence_generator = PerrinSequence()\n\n        def cal_sum(self, n_val: int) -> int:\n            # Assumes n_val is a non-negative integer based on outer function's implied contract.\n            total_sum = 0\n            for i in range(n_val + 1):\n                total_sum += self._perrin_sequence_generator.getP(i)\n            return total_sum\n\n    # The main public API function orchestrates the calculation.\n    # Input validation (type and range) is omitted as per specific \"DO NOT\" requirements.\n    calculator = SumCalculator()\n    return calculator.cal_sum(n)"}
{"task_id": "Mbpp/451", "solution": "class WhitespaceClassifier:\n    \"\"\"Classifies characters as whitespace, using Python's str.isspace().\"\"\"\n    def isWhitespace(self, c: str) -> bool:\n        \"\"\"Returns True if the character is whitespace, False otherwise.\"\"\"\n        return c.isspace()\n\nclass RemoveWhitespaces:\n    \"\"\"Handles the core logic of removing whitespace from a string.\"\"\"\n    def __init__(self):\n        self._classifier = WhitespaceClassifier()\n\n    def remove(self, input_str: str) -> str:\n        \"\"\"Processes the input string to remove all whitespace characters.\"\"\"\n        result_chars = []\n        for char in input_str:\n            if not self._classifier.isWhitespace(char):\n                result_chars.append(char)\n        return \"\".join(result_chars)\n\ndef remove_whitespaces(input: str) -> str:\n    \"\"\"\n    Removes all whitespaces from the given string.\n    The function delegates to an internal service for character classification and removal.\n    \"\"\"\n    remover = RemoveWhitespaces()\n    return remover.remove(input)"}
{"task_id": "Mbpp/453", "solution": "def sumofFactors(n: int) -> int:\n    \"\"\"\n    Calculates the sum of even factors of a given number n.\n    Returns 0 if n is less than or equal to 0, or if no even factors are found.\n    \"\"\"\n\n    def _is_even(x: int) -> bool:\n        \"\"\"Returns True if x is an even number.\"\"\"\n        return x % 2 == 0\n\n    def _positive_divisors(n: int) -> list[int]:\n        \"\"\"Returns a list of all positive divisors for a given number n.\"\"\"\n        if n <= 0:\n            return []\n        divs = set()\n        for i in range(1, int(n**0.5) + 1):\n            if n % i == 0:\n                divs.add(i)\n                divs.add(n // i)\n        return sorted(list(divs))\n\n    def _sum_even_divisors_from_divisors(divisors: list[int]) -> int:\n        \"\"\"Filters a list of divisors for even numbers and returns their sum.\"\"\"\n        total_sum = 0\n        for divisor in divisors:\n            if _is_even(divisor):\n                total_sum += divisor\n        return total_sum\n\n    if n <= 0:\n        return 0\n\n    divisors = _positive_divisors(n)\n    return _sum_even_divisors_from_divisors(divisors)"}
{"task_id": "Mbpp/454", "solution": "import string\n\nclass TextInput:\n    \"\"\"Holds input string; provides length.\"\"\"\n    def __init__(self, content: str):\n        self.content = content\n\n    def length(self) -> int:\n        return len(self.content)\n\nclass Word:\n    \"\"\"Represents a token; stores rawText and normalizedText; determines containsZ.\"\"\"\n    def __init__(self, rawText: str):\n        self.rawText = rawText\n        self.normalizedText = None\n\n    def containsZ(self) -> bool:\n        \"\"\"Returns True if lowercase 'z' appears in normalizedText.\"\"\"\n        return 'z' in (self.normalizedText if self.normalizedText is not None else \"\")\n\nclass MatchResult:\n    \"\"\"Container for matched boolean.\"\"\"\n    def __init__(self, matched: bool = False):\n        self.matched = matched\n\nclass PunctuationHandler:\n    \"\"\"Strips punctuation attached to tokens.\"\"\"\n    def stripPunctuation(self, word: str) -> str:\n        \"\"\"Returns normalized token with surrounding/attached punctuation removed.\"\"\"\n        return word.strip(string.punctuation)\n\nclass Tokenizer:\n    \"\"\"Tokenize input string into Word instances.\"\"\"\n    def tokenize(self, text: str) -> list[Word]:\n        \"\"\"Splits input using Unicode whitespace splitting and creates Word objects.\"\"\"\n        return [Word(raw_text) for raw_text in text.split()]\n\nclass TextMatcher:\n    \"\"\"Orchestrates tokenization, normalization and detection; exposes text_match_wordz.\"\"\"\n    def __init__(self, tokenizer: 'Tokenizer' = None, puncHandler: 'PunctuationHandler' = None):\n        self.tokenizer = tokenizer if tokenizer is not None else Tokenizer()\n        self.puncHandler = puncHandler if puncHandler is not None else PunctuationHandler()\n\n    def text_match_wordz(self, text: str) -> bool:\n        \"\"\"Detects if any word in the text contains 'z' after normalization.\"\"\"\n        text_input = TextInput(text)\n        words = self.tokenizer.tokenize(text_input.content)\n\n        match_result = MatchResult()\n        for word_obj in words:\n            word_obj.normalizedText = self.puncHandler.stripPunctuation(word_obj.rawText)\n            if word_obj.containsZ():\n                match_result.matched = True\n                break\n        return match_result.matched\n\ndef text_match_wordz(text: str) -> bool:\n    \"\"\"\n    Matches a word containing 'z' in the input text.\n    Raises TypeError if input is not a string.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input must be a string.\")\n\n    matcher = TextMatcher()\n    return matcher.text_match_wordz(text)"}
{"task_id": "Mbpp/455", "solution": "from typing import Optional\n\nclass Month:\n    \"\"\"Represents a month number and determines if it has 31 days.\"\"\"\n    def __init__(self, number: int):\n        self.number = number\n\n    def has31Days(self) -> bool:\n        \"\"\"Returns True if the month has 31 days, False otherwise.\"\"\"\n        return self.number in {1, 3, 5, 7, 8, 10, 12}\n\nclass InputValidator:\n    \"\"\"Validates if an input month number is within the range 1-12.\"\"\"\n    def validate(self, month: int) -> bool:\n        \"\"\"Returns True if month is in 1..12, False otherwise.\"\"\"\n        return 1 <= month <= 12\n\nclass Result:\n    \"\"\"Encapsulates the boolean result of 31-day membership.\"\"\"\n    def __init__(self, is31: bool):\n        self.is31 = is31\n\nclass MonthChecker:\n    \"\"\"Coordinates validation and month evaluation.\"\"\"\n    def __init__(self, validator: Optional[InputValidator] = None):\n        self.validator = validator or InputValidator()\n\n    def check_monthnumb_number(self, month: int) -> bool:\n        \"\"\"Validates month input and checks if it has 31 days.\"\"\"\n        if not self.validator.validate(month):\n            return False\n\n        month_obj = Month(month)\n        is_31_days = month_obj.has31Days()\n        _ = Result(is_31_days) # Result object is instantiated internally\n        return is_31_days\n\ndef check_monthnumb_number(month: int) -> bool:\n    \"\"\"Checks whether the given month number contains 31 days.\"\"\"\n    checker = MonthChecker()\n    return checker.check_monthnumb_number(month)"}
{"task_id": "Mbpp/458", "solution": "def rectangle_area(width: float, height: float) -> float:\n    \"\"\"\n    Calculates the area of a rectangle.\n    The area is computed by multiplying width by height.\n    \"\"\"\n    return float(width) * float(height)"}
{"task_id": "Mbpp/459", "solution": "def remove_uppercase(input: str) -> str:\n    \"\"\"Removes all ASCII uppercase letters (A-Z) from the input string, preserving order.\"\"\"\n    preserved_chars = [c for c in input if not ('A' <= c <= 'Z')]\n    return ''.join(preserved_chars)"}
{"task_id": "Mbpp/457", "solution": "def Find_Min(sublists: list) -> list:\n    \"\"\"\n    Finds the sublist with the minimum length from a list of sublists.\n    Returns the first such sublist if multiple have the same minimum length.\n    \"\"\"\n    if not isinstance(sublists, list):\n        raise TypeError(\"Input must be a list of sublists.\")\n    if not sublists:\n        raise ValueError(\"Input list of sublists cannot be empty.\")\n\n    # Validate the first element and initialize tracking variables\n    if not isinstance(sublists[0], list):\n        raise TypeError(\"All elements in the input list must be lists.\")\n    \n    min_sublist = sublists[0]\n    min_length = len(sublists[0])\n\n    # Iterate from the second element to find the sublist with minimal length\n    for i in range(1, len(sublists)):\n        current_sublist = sublists[i]\n        \n        if not isinstance(current_sublist, list):\n            raise TypeError(\"All elements in the input list must be lists.\")\n        \n        current_length = len(current_sublist)\n        \n        if current_length < min_length:\n            min_length = current_length\n            min_sublist = current_sublist\n            \n    return min_sublist"}
{"task_id": "Mbpp/456", "solution": "from typing import List\n\nclass StringItem:\n    \"\"\"Represents a string value with its original position.\"\"\"\n    def __init__(self, value: str, position: int):\n        self.value = value\n        self.position = position\n\n    def reverse(self) -> str:\n        \"\"\"Returns the character-wise reversed version of the string value.\"\"\"\n        return self.value[::-1]\n\nclass StringList:\n    \"\"\"Wraps a list of raw strings into a list of StringItem objects.\"\"\"\n    def __init__(self, raw_strings: List[str]):\n        self.items: List[StringItem] = [\n            StringItem(s, i) for i, s in enumerate(raw_strings)\n        ]\n\n    def __iter__(self):\n        return iter(self.items)\n\n    def __len__(self) -> int:\n        return len(self.items)\n\nclass ResultList:\n    \"\"\"Collects StringItem objects containing reversed string values.\"\"\"\n    def __init__(self):\n        self.items: List[StringItem] = []\n\n    def append(self, item: StringItem):\n        \"\"\"Appends a StringItem to the result collection.\"\"\"\n        self.items.append(item)\n\n    def to_list(self) -> List[str]:\n        \"\"\"Converts the collected StringItems into a list of their string values.\"\"\"\n        return [item.value for item in self.items]\n\nclass ReverseStringListFunction:\n    \"\"\"Implements the core logic for reversing strings in a list.\"\"\"\n    def execute(self, input_list: List[str]) -> List[str]:\n        \"\"\"\n        Processes an input list of strings, reverses each string, and returns a new list.\n        The input list and its elements are not modified.\n        \"\"\"\n        string_list = StringList(input_list)\n        result_list = ResultList()\n\n        for original_item in string_list:\n            reversed_value = original_item.reverse()\n            # Create a new StringItem with the reversed value and its original position\n            result_item = StringItem(reversed_value, original_item.position)\n            result_list.append(result_item)\n\n        return result_list.to_list()\n\n    def isPure(self) -> bool:\n        \"\"\"Indicates that this function operates as a pure function.\"\"\"\n        return True\n\ndef reverse_string_list(list_of_strings: List[str]) -> List[str]:\n    \"\"\"\n    Reverses each string in a given list of string values.\n    Returns a new list with each string reversed, preserving the original order.\n    \"\"\"\n    return ReverseStringListFunction().execute(list_of_strings)"}
{"task_id": "Mbpp/460", "solution": "from typing import List, Any\n\ndef _validate_input(input_list: List[List[Any]]) -> None:\n    \"\"\"\n    Validates the input_list according to design constraints, raising\n    TypeError or ValueError for invalid inputs.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n    \n    for i, sublist in enumerate(input_list):\n        if not isinstance(sublist, list):\n            raise TypeError(f\"Element at index {i} is not a list.\")\n        if not sublist:\n            raise ValueError(f\"Sublist at index {i} cannot be empty.\")\n\ndef Extract(input_list: List[List[Any]]) -> List[Any]:\n    \"\"\"\n    Extracts the first element of each sublist from the input_list.\n    Raises TypeError or ValueError for invalid inputs per design.\n    \"\"\"\n    _validate_input(input_list)\n    \n    result = []\n    for sublist in input_list:\n        result.append(sublist[0])\n        \n    return result"}
{"task_id": "Mbpp/465", "solution": "from typing import Dict, Any\n\ndef drop_empty(input: Dict[Any, Any]) -> Dict[Any, Any]:\n    \"\"\"\n    Removes key-value pairs from a dictionary where the value is None.\n    >>> drop_empty({'c1': 'Red', 'c2': 'Green', 'c3': None})\n    {'c1': 'Red', 'c2': 'Green'}\n    \"\"\"\n    filtered_dict = {}\n    for key, value in input.items():\n        if value is not None:\n            filtered_dict[key] = value\n    return filtered_dict"}
{"task_id": "Mbpp/462", "solution": "from typing import List, Any, Optional\n\nclass Element:\n    \"\"\"Represents an element value and its original index from the input list.\"\"\"\n    def __init__(self, value: Any, originalIndex: int):\n        self.value = value\n        self.originalIndex = originalIndex\n\nclass InputList:\n    \"\"\"A lightweight wrapper for the input list, preserving original indexing.\"\"\"\n    def __init__(self, elements: List[Any]):\n        self._elements = [Element(value, i) for i, value in enumerate(elements)]\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the input list.\"\"\"\n        return len(self._elements)\n\nclass BitmaskEnumerator:\n    \"\"\"Enumerates integers from 0 to 2^n - 1 in increasing order.\"\"\"\n    def __init__(self, n: int):\n        self._n = n\n        self._current_mask = 0\n        self._max_mask = 2**n\n\n    def next(self) -> Optional[int]:\n        \"\"\"Returns the next bitmask or None if all masks have been enumerated.\"\"\"\n        if self._current_mask < self._max_mask:\n            mask = self._current_mask\n            self._current_mask += 1\n            return mask\n        return None\n\nclass Combination:\n    \"\"\"Holds selected Element objects for one combination.\"\"\"\n    def __init__(self, elements: List[Element]):\n        self._elements = elements\n\n    def asList(self) -> List[Any]:\n        \"\"\"Returns the values of the elements in this combination as a native list.\"\"\"\n        return [e.value for e in self._elements]\n\nclass CombinationCollection:\n    \"\"\"An ordered collection of Combination instances.\"\"\"\n    def __init__(self):\n        self.combinations: List[Combination] = []\n\n    def append(self, combination: Combination):\n        \"\"\"Adds a combination to the collection.\"\"\"\n        self.combinations.append(combination)\n\n    def count(self) -> int:\n        \"\"\"Returns the total number of combinations in the collection.\"\"\"\n        return len(self.combinations)\n\nclass CombinationsFunction:\n    \"\"\"Orchestrates the generation of all combinations (power set).\"\"\"\n    def generate(self, input: InputList) -> CombinationCollection:\n        \"\"\"Generates all combinations for the given InputList.\"\"\"\n        collection = CombinationCollection()\n        n = input.length()\n        enumerator = BitmaskEnumerator(n)\n\n        while True:\n            mask = enumerator.next()\n            if mask is None:\n                break\n\n            selected_elements: List[Element] = []\n            for i in range(n):\n                # Check if the i-th bit of the mask is set\n                if (mask >> i) & 1:\n                    selected_elements.append(input._elements[i]) # Accessing _elements directly for internal use\n\n            # Order selected elements by originalIndex descending\n            selected_elements.sort(key=lambda e: e.originalIndex, reverse=True)\n            \n            collection.append(Combination(selected_elements))\n        \n        return collection\n\ndef combinations_list(input_list: List[Any]) -> List[List[Any]]:\n    \"\"\"\n    Finds all possible combinations (power set) of the elements of a given list.\n    Elements within each combination are ordered by their original index in descending order.\n    \"\"\"\n    input_obj = InputList(input_list)\n    func = CombinationsFunction()\n    collection = func.generate(input_obj)\n    return [c.asList() for c in collection.combinations]"}
{"task_id": "Mbpp/470", "solution": "def add_pairwise(input_tuple: tuple) -> tuple:\n    \"\"\"Compute neighbor-wise sums.\n    Args:\n      input_tuple: tuple of integers or floats\n    Returns:\n      tuple of sums (native tuple), or empty tuple when input length < 2.\n    \"\"\"\n    n = len(input_tuple)\n    if n < 2:\n        return ()\n\n    result = []\n    for i in range(n - 1):\n        result.append(input_tuple[i] + input_tuple[i+1])\n    \n    return tuple(result)"}
{"task_id": "Mbpp/463", "solution": "def max_subarray_product(values: list) -> float:\n    \"\"\"\n    Finds the maximum product of any contiguous subarray within the given list of numbers.\n    This function uses a single-pass streaming algorithm to track current max/min products.\n    \"\"\"\n    # Initialize current maximum and minimum products ending at the current position,\n    # and the overall maximum product found so far.\n    # Initialize with the first element as a valid subarray.\n    current_max_product = values[0]\n    current_min_product = values[0]\n    global_max_product = values[0]\n\n    # Iterate through the array starting from the second element\n    for num in values[1:]:\n        # Store previous current_max_product because current_min_product calculation\n        # needs the value before current_max_product is updated.\n        temp_current_max = current_max_product\n        \n        # The new current_max_product can be 'num' itself,\n        # or 'num' multiplied by the previous current_max_product,\n        # or 'num' multiplied by the previous current_min_product (important for negative numbers).\n        current_max_product = max(num, temp_current_max * num, current_min_product * num)\n        \n        # The new current_min_product has similar possibilities.\n        current_min_product = min(num, temp_current_max * num, current_min_product * num)\n        \n        # Update the overall maximum product found\n        global_max_product = max(global_max_product, current_max_product)\n        \n    return global_max_product"}
{"task_id": "Mbpp/472", "solution": "def check_Consecutive(elements: list) -> bool:\n    \"\"\"\n    Checks if the given list contains consecutive numbers (strictly ascending or descending).\n    Handles input validation and edge cases as per design specifications.\n    \"\"\"\n    if not isinstance(elements, list):\n        raise TypeError(\"elements must be a list\")\n\n    if not elements:\n        return False\n\n    if any(not isinstance(x, int) for x in elements):\n        raise TypeError(\"all elements must be int\")\n\n    if len(elements) == 1:\n        return True\n\n    # Compute differences between adjacent elements\n    diffs = [elements[i+1] - elements[i] for i in range(len(elements) - 1)]\n\n    # Check for strictly ascending consecutive sequence (all diffs must be 1)\n    if all(d == 1 for d in diffs):\n        return True\n\n    # Check for strictly descending consecutive sequence (all diffs must be -1)\n    if all(d == -1 for d in diffs):\n        return True\n\n    # If neither ascending nor descending consecutive, return False\n    return False"}
{"task_id": "Mbpp/468", "solution": "import math\nfrom typing import List\n\ndef _max_product_dp(values: List[float]) -> float:\n    \"\"\"\n    Dynamic programming implementation to compute maximum product among strictly increasing subsequences.\n    dp[i] stores the maximum product of an increasing subsequence ending at index i.\n    \"\"\"\n    n = len(values)\n    if n == 0:\n        return 0.0\n    if n == 1:\n        return float(values[0])\n    \n    dp = [float(val) for val in values]\n\n    for i in range(1, n):\n        for j in range(i):\n            if values[i] > values[j]:\n                dp[i] = max(dp[i], dp[j] * values[i])\n    \n    return max(dp)\n\ndef max_product(array: List[float]) -> float:\n    \"\"\"\n    Finds the maximum product formed by multiplying numbers of an increasing subsequence of that array.\n    \"\"\"\n    return _max_product_dp(array)"}
{"task_id": "Mbpp/471", "solution": "def validate_inputs(array, n):\n    \"\"\"Validates the input array and modulus n, raising exceptions on invalid inputs.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"modulus n must be an integer\")\n    if n <= 0:\n        raise ValueError(\"modulus n must be > 0\")\n    if not isinstance(array, list):\n        raise TypeError(\"input array must be a list\")\n    for element in array:\n        if not isinstance(element, int):\n            raise TypeError(\"all array elements must be integers\")\n\ndef _modular_multiply(acc: int, value: int, n: int) -> int:\n    \"\"\"Computes (acc * value) % n efficiently, normalizing value first.\"\"\"\n    return (acc * (value % n)) % n\n\ndef find_remainder(array: list[int], n: int) -> int:\n    \"\"\"\n    Finds the product of the array multiplication modulo n.\n    Uses iterative modular multiplication to avoid large intermediate values.\n    \"\"\"\n    validate_inputs(array, n)\n\n    accumulator = 1\n    for element in array:\n        accumulator = _modular_multiply(accumulator, element, n)\n\n    return accumulator"}
{"task_id": "Mbpp/473", "solution": "def normalize_tuple(tup):\n    # Generates a deterministic, hashable multiset key for a tuple.\n    # It counts elements and sorts them to ensure order-independence.\n    counts = {}\n    for element in tup:\n        counts[element] = counts.get(element, 0) + 1\n    sorted_items = sorted(counts.items())\n    return tuple(sorted_items)\n\ndef validate_inputs(list1, list2):\n    # Validates that inputs are iterables of tuples and all tuple elements are hashable.\n    # Raises TypeError on any validation failure.\n    for i, lst in enumerate([list1, list2]):\n        list_name = f\"list{i+1}\"\n        if not hasattr(lst, '__iter__'):\n            raise TypeError(f\"Input '{list_name}' must be an iterable.\")\n        for j, item in enumerate(lst):\n            if not isinstance(item, tuple):\n                raise TypeError(f\"Element at index {j} of '{list_name}' must be a tuple, got {type(item).__name__}.\")\n            for k, element in enumerate(item):\n                try:\n                    hash(element)\n                except TypeError:\n                    raise TypeError(f\"Element at index {k} of tuple at index {j} in '{list_name}' is not hashable: {element!r}.\")\n\ndef compute_intersection(list1, list2):\n    # Finds the intersection of tuples based on their normalized multiset keys.\n    # Returns a set of original tuple instances from the first input.\n    normalized_keys_to_tuple1 = {}\n    for original_tup in list1:\n        normalized_key = normalize_tuple(original_tup)\n        if normalized_key not in normalized_keys_to_tuple1:\n            normalized_keys_to_tuple1[normalized_key] = original_tup\n\n    normalized_keys2 = set()\n    for original_tup in list2:\n        normalized_key = normalize_tuple(original_tup)\n        normalized_keys2.add(normalized_key)\n\n    common_normalized_keys = set(normalized_keys_to_tuple1.keys()).intersection(normalized_keys2)\n\n    result_set = set()\n    for key in common_normalized_keys:\n        result_set.add(normalized_keys_to_tuple1[key])\n\n    return result_set\n\ndef tuple_intersection(list1, list2):\n    # Finds the tuple intersection of elements in the given tuple list irrespective of their order.\n    # It validates inputs and then computes the intersection using normalized tuple keys.\n    validate_inputs(list1, list2)\n    return compute_intersection(list1, list2)"}
{"task_id": "Mbpp/475", "solution": "from typing import List, Dict, Tuple, Any\n\ndef sort_counter(input_dict: Dict[Any, Any]) -> List[Tuple[Any, Any]]:\n    \"\"\"Return a list of (key, value) tuples sorted by value descending then key ascending.\"\"\"\n    \n    sorted_items = sorted(input_dict.items(), key=lambda kv: (-kv[1], kv[0]))\n    return list(sorted_items)"}
{"task_id": "Mbpp/474", "solution": "class ValidationError(Exception):\n    \"\"\"Custom exception for validation failures with a message and a numeric code.\"\"\"\n    def __init__(self, message: str, code: int):\n        super().__init__(message)\n        self.message = message\n        self.code = code\n\nclass CharacterParam:\n    \"\"\"Helper to encapsulate single-character string semantics.\"\"\"\n    @staticmethod\n    def is_single_char(value: str) -> bool:\n        \"\"\"Checks if the given string represents a single character.\"\"\"\n        return len(value) == 1\n\nclass Validator:\n    \"\"\"Validates parameters for the replace_char function.\"\"\"\n    def validate(self, target_char: str, replacement_char: str) -> None:\n        \"\"\"Raises ValidationError if target_char or replacement_char are not single characters.\"\"\"\n        if not CharacterParam.is_single_char(target_char):\n            raise ValidationError(\"target_char must be a single character\", code=1)\n        if not CharacterParam.is_single_char(replacement_char):\n            raise ValidationError(\"replacement_char must be a single character\", code=2)\n\nclass ReplacementEngine:\n    \"\"\"Performs the single-pass character replacement.\"\"\"\n    def replace(self, input_string: str, target_char: str, replacement_char: str) -> str:\n        \"\"\"Scans the input string once, replacing target_char with replacement_char.\"\"\"\n        result_chars = []\n        for char in input_string:\n            if char == target_char:\n                result_chars.append(replacement_char)\n            else:\n                result_chars.append(char)\n        return \"\".join(result_chars)\n\ndef replace_char(input_string: str, target_char: str, replacement_char: str) -> str:\n    \"\"\"\n    Replaces all occurrences of target_char with replacement_char in input_string.\n    Raises ValidationError if target_char or replacement_char are not single characters.\n    \"\"\"\n    validator = Validator()\n    replacement_engine = ReplacementEngine()\n\n    validator.validate(target_char, replacement_char)\n\n    if not input_string:\n        return \"\"\n\n    return replacement_engine.replace(input_string, target_char, replacement_char)"}
{"task_id": "Mbpp/477", "solution": "def is_lower(input: str) -> str:\n    \"\"\"Converts the given string to lower case.\"\"\"\n    return input.lower()"}
{"task_id": "Mbpp/476", "solution": "def big_sum(arr):\n    \"\"\"\n    Finds the sum of the largest and smallest value in a given array.\n    Performs validation for empty arrays and non-numeric elements.\n    \"\"\"\n    def _validate_numeric_sequence(sequence):\n        if not sequence:\n            raise ValueError(\"Input array cannot be empty.\")\n        for item in sequence:\n            if not isinstance(item, (int, float)):\n                raise TypeError(\"All elements in the array must be numeric.\")\n\n    _validate_numeric_sequence(arr)\n\n    if len(arr) == 1:\n        return arr[0] + arr[0]\n    else:\n        return min(arr) + max(arr)"}
{"task_id": "Mbpp/479", "solution": "def first_Digit(number: int) -> int:\n    \"\"\"Compute and return the most significant (first) decimal digit of 'number'.\n    Negative numbers are handled by using their absolute value.\n    \"\"\"\n    n = abs(number)\n    while n >= 10:\n        n //= 10\n    return n"}
{"task_id": "Mbpp/478", "solution": "class InputString:\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        return len(self.value)\n\nclass CharacterSegment:\n    def __init__(self, text: str) -> None:\n        self.text = text\n\n    def is_ascii_lowercase(self) -> bool:\n        return all('a' <= char <= 'z' for char in self.text)\n\n    def is_non_lowercase(self) -> bool:\n        return not self.is_ascii_lowercase()\n\nclass OutputString:\n    def __init__(self) -> None:\n        self.value = \"\"\n\n    def append(self, text: str) -> None:\n        self.value += text\n\n    def get(self) -> str:\n        return self.value\n\ndef remove_lowercase(input: str) -> str:\n    \"\"\"Removes all contiguous ASCII-lowercase-only substrings from the input string.\"\"\"\n    if not input:\n        return \"\"\n\n    output_string = OutputString()\n    n = len(input)\n    i = 0\n\n    while i < n:\n        # Determine the type of the character at the current position 'i'\n        is_current_char_lower = ('a' <= input[i] <= 'z')\n\n        j = i + 1\n        # Find the end of the current contiguous segment of characters of the same type\n        while j < n:\n            is_next_char_lower = ('a' <= input[j] <= 'z')\n            if is_current_char_lower != is_next_char_lower:\n                break\n            j += 1\n\n        # Create a CharacterSegment from the identified substring\n        segment = CharacterSegment(input[i:j])\n\n        # If the segment is not entirely ASCII lowercase, append it to the output\n        if not segment.is_ascii_lowercase():\n            output_string.append(segment.text)\n\n        # Move to the start of the next segment\n        i = j\n\n    return output_string.get()"}
{"task_id": "Mbpp/554", "solution": "from typing import List\n\ndef Split(inputList: List[int]) -> List[int]:\n    \"\"\"Return a new list containing only the odd integers from inputList.\n\n    Behavior for non-list or non-integer inputs is unspecified by SRS.\n    \"\"\"\n    return [x for x in inputList if x % 2 != 0]"}
{"task_id": "Mbpp/555", "solution": "def _sum_n(n: int) -> int:\n    \"\"\"Returns the sum of the first n natural numbers using a closed-form formula.\"\"\"\n    return n * (n + 1) // 2\n\ndef _sum_cubes(n: int) -> int:\n    \"\"\"Returns the sum of cubes of the first n natural numbers using a closed-form formula.\"\"\"\n    s = _sum_n(n)\n    return s * s\n\ndef difference(n: int) -> int:\n    \"\"\"Validate n and return (sum of cubes) - (sum of n) as int.\"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n\n    sum_of_n = _sum_n(n)\n    sum_of_cubes = _sum_cubes(n)\n\n    return sum_of_cubes - sum_of_n"}
{"task_id": "Mbpp/562", "solution": "def Find_Max_Length(input_list):\n    \"\"\"\n    Compute and return the length of the longest sublist in input_list.\n    Returns 0 if input_list is empty.\n    \"\"\"\n    max_length = 0\n    for sublist in input_list:\n        current_length = len(sublist)\n        if current_length > max_length:\n            max_length = current_length\n    return max_length"}
{"task_id": "Mbpp/556", "solution": "class Element:\n    \"\"\"Represents an element with its value and index, providing a parity check.\"\"\"\n    def __init__(self, value, index):\n        self.value = value\n        self.index = index\n\n    def isOdd(self) -> bool:\n        \"\"\"Returns True if the element's value is odd, False otherwise.\"\"\"\n        return self.value % 2 != 0\n\nclass InputArray:\n    \"\"\"Manages the input array, providing length and sub-array access.\"\"\"\n    def __init__(self, values):\n        self.values = values\n\n    def length(self) -> int:\n        \"\"\"Returns the total length of the stored array.\"\"\"\n        return len(self.values)\n\n    def getFirstN(self, n) -> list:\n        \"\"\"Returns a list containing the first n elements of the array.\"\"\"\n        return self.values[:n]\n\nclass PairCounter:\n    \"\"\"Provides static methods for counting pairs and checking XOR parity.\"\"\"\n    @staticmethod\n    def isXorOdd(a, b) -> bool:\n        \"\"\"Checks if the bitwise XOR of two numbers is odd.\"\"\"\n        return (a % 2) != (b % 2)\n\n    @staticmethod\n    def countOddXorPairs(arr, n) -> int:\n        \"\"\"Counts pairs with odd XOR value in the first n elements of arr using an O(n) approach.\"\"\"\n        odd_count = 0\n        even_count = 0\n        for i in range(n):\n            # Using Element class as per design for parity check\n            if Element(arr[i], i).isOdd():\n                odd_count += 1\n            else:\n                even_count += 1\n        return odd_count * even_count\n\ndef find_Odd_Pair(arr, n) -> int:\n    \"\"\"\n    Counts the number of unordered pairs from the first 'n' elements of 'arr'\n    whose bitwise XOR value is odd.\n    \"\"\"\n    # Per completion constraints, input validation (type, range, element types)\n    # and raising ValueErrors for edge cases are explicitly omitted.\n    # The function assumes valid inputs as per the design's logical flow.\n\n    # Use InputArray to represent the input and get the first N elements.\n    input_array_obj = InputArray(arr)\n    first_n_elements = input_array_obj.getFirstN(n)\n\n    # Delegate the counting logic to the PairCounter.\n    return PairCounter.countOddXorPairs(first_n_elements, n)"}
{"task_id": "Mbpp/557", "solution": "class InputString:\n    \"\"\"Wrapper around the input string; provides length() accessor.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the encapsulated string.\"\"\"\n        return len(self.value)\n\nclass Character:\n    \"\"\"Encapsulates a single character and provides case-related operations.\"\"\"\n    def __init__(self, char: str) -> None:\n        self.char = char\n\n    def isAlpha(self) -> bool:\n        \"\"\"Checks if the character is an alphabet letter.\"\"\"\n        return self.char.isalpha()\n\n    def isUpper(self) -> bool:\n        \"\"\"Checks if the character is an uppercase letter.\"\"\"\n        return self.char.isupper()\n\n    def toggleCase(self) -> str:\n        \"\"\"Toggles the case of an alphabetic character or returns it unchanged.\"\"\"\n        if self.isAlpha():\n            if self.isUpper():\n                return self.char.lower()\n            else:\n                return self.char.upper()\n        return self.char\n\nclass ToggledString:\n    \"\"\"Holder for the resulting string value.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\nclass CharacterProcessor:\n    \"\"\"Iterates characters and performs case transformations.\"\"\"\n    def process(self, input_str: InputString) -> 'ToggledString':\n        \"\"\"Processes an InputString to produce a ToggledString.\"\"\"\n        toggled_chars = []\n        for char_value in input_str.value:\n            character_obj = Character(char_value)\n            toggled_chars.append(character_obj.toggleCase())\n        return ToggledString(\"\".join(toggled_chars))\n\ndef toggle_string(input: str) -> str:\n    \"\"\"\n    Toggles the case of all alphabetic characters in a string, preserving\n    non-alphabetic characters.\n    \"\"\"\n    input_obj = InputString(input)\n    processor = CharacterProcessor()\n    toggled_obj = processor.process(input_obj)\n    return toggled_obj.value"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(a: int, b: int) -> int:\n    \"\"\"\n    Calculates the sum of per-digit absolute differences between two integers.\n    Digits are aligned from the least-significant position, treating missing digits as 0.\n    \"\"\"\n    num_a = abs(a)\n    num_b = abs(b)\n\n    def get_lsb_first_digits(n: int) -> list[int]:\n        \"\"\"Extracts digits from an integer, returning them in a list from LSB to MSB.\"\"\"\n        if n == 0:\n            return [0]\n        digits = []\n        while n > 0:\n            digits.append(n % 10)\n            n //= 10\n        return digits\n\n    digits_a = get_lsb_first_digits(num_a)\n    digits_b = get_lsb_first_digits(num_b)\n\n    max_len = max(len(digits_a), len(digits_b))\n    total_distance = 0\n\n    for i in range(max_len):\n        digit_a = digits_a[i] if i < len(digits_a) else 0\n        digit_b = digits_b[i] if i < len(digits_b) else 0\n        total_distance += abs(digit_a - digit_b)\n\n    return total_distance"}
{"task_id": "Mbpp/559", "solution": "def _compute_max_sum_kadane(arr_slice: list[int]) -> int:\n    \"\"\"Computes the maximum contiguous sub-array sum using Kadane's algorithm.\n    Assumes arr_slice is non-empty as per design constraints (1 <= n <= len(list_of_integers)).\"\"\"\n    max_ending_here = arr_slice[0]\n    max_so_far = arr_slice[0]\n\n    for x in arr_slice[1:]:\n        max_ending_here = max(x, max_ending_here + x)\n        max_so_far = max(max_so_far, max_ending_here)\n\n    return max_so_far\n\ndef max_sub_array_sum(list_of_integers: list[int], n: int) -> int:\n    \"\"\"Finds the sum of the largest contiguous sublist within the first 'n' elements of the given list.\n    Input validation (types, n bounds) is assumed to be handled externally.\"\"\"\n    arr_slice = list_of_integers[0:n]\n    return _compute_max_sum_kadane(arr_slice)"}
{"task_id": "Mbpp/563", "solution": "import re\n\ndef extract_values(input: str) -> list[str]:\n    \"\"\"\n    Parse input string and return list of substrings that were enclosed in double quotes (\").\n\n    Extracts quoted substrings, removes quotes, trims whitespace, and preserves order.\n    \"\"\"\n    # Regex to find content between double quotes.\n    # The capturing group `([^\"]*)` extracts the content without the quotes.\n    matches = re.findall(r'\"([^\"]*)\"', input)\n\n    # Trim leading/trailing whitespace from each extracted value\n    trimmed_values = [value.strip() for value in matches]\n\n    return trimmed_values"}
{"task_id": "Mbpp/560", "solution": "from typing import Tuple, List, Any\n\ndef validate_elements(elements: Tuple[Any, ...]) -> bool:\n    \"\"\"Return True if elements are mutually comparable (sorting the list does not raise TypeError).\"\"\"\n    try:\n        # Create a list from elements before sorting to ensure it's mutable and not a tuple\n        _ = sorted(list(elements))\n        return True\n    except TypeError:\n        return False\n\ndef sort_elements(items: List[Any]) -> List[Any]:\n    \"\"\"Return sorted(items).\"\"\"\n    return sorted(items)\n\ndef to_tuple(items: List[Any]) -> Tuple[Any, ...]:\n    \"\"\"Return tuple(items).\"\"\"\n    return tuple(items)\n\ndef union_elements(tuple_a: Tuple[Any, ...], tuple_b: Tuple[Any, ...]) -> Tuple[Any, ...]:\n    \"\"\"Public API. Accept two tuples, validate comparability, compute unique sorted union, return tuple.\"\"\"\n    combined = tuple_a + tuple_b\n    \n    if not validate_elements(combined):\n        raise TypeError(\"Elements are not mutually comparable for ordering\")\n    \n    unique_items = list(set(combined))\n    sorted_list = sort_elements(unique_items)\n    return to_tuple(sorted_list)"}
{"task_id": "Mbpp/565", "solution": "def split(input: str) -> list[str]:\n    \"\"\"Return a list of single-character strings for each character in input.\"\"\"\n    return [c for c in input]"}
{"task_id": "Mbpp/566", "solution": "def sum_digits(n: int) -> int:\n    \"\"\"Compute sum of base-10 digits of non-negative integer n.\n    Raises ValueError if n < 0.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n    return sum(int(digit) for digit in str(n))"}
{"task_id": "Mbpp/564", "solution": "from typing import List, Dict, Iterable, Tuple\n\nclass InputList:\n    \"\"\"A simple wrapper for the input list, primarily for design traceability.\"\"\"\n    def __init__(self, items: List[int]):\n        self.items = items\n\n    def get(self) -> List[int]:\n        return self.items\n\nclass IntegerArg:\n    \"\"\"A simple wrapper for the integer argument 'n', primarily for design traceability.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n\n    def get(self) -> int:\n        return self.n\n\nclass FrequencyMap:\n    \"\"\"Calculates and stores the frequency of each integer in a list.\"\"\"\n    def __init__(self):\n        self.freq: Dict[int, int] = {}\n\n    def build(self, items: List[int]) -> None:\n        \"\"\"Populates the frequency map from the given list of items.\"\"\"\n        for item in items:\n            self.freq[item] = self.freq.get(item, 0) + 1\n\n    def items(self) -> Iterable[Tuple[int, int]]:\n        \"\"\"Returns an iterable of (value, frequency) pairs.\"\"\"\n        return self.freq.items()\n\nclass PairResult:\n    \"\"\"A value object to hold the computed count of pairs.\"\"\"\n    def __init__(self, count: int):\n        self.count = count\n\n    def value(self) -> int:\n        return self.count\n\nclass PairCounter:\n    \"\"\"Encapsulates the logic for counting unequal unordered pairs.\"\"\"\n    def __init__(self, items: List[int], n: int):\n        self._items = InputList(items)\n        self._n = IntegerArg(n) # n is preserved for signature compliance, but len(items) is used.\n\n    def count_Pairs(self) -> int:\n        \"\"\"Counts the number of unordered pairs with unequal elements.\"\"\"\n        items = self._items.get()\n        L = len(items)\n\n        # Calculate total possible unordered pairs (i, j) with i < j\n        total_pairs = L * (L - 1) // 2\n\n        freq_map = FrequencyMap()\n        freq_map.build(items)\n\n        equal_pairs_sum = 0\n        # For each unique value, calculate pairs where elements are equal\n        for _, frequency in freq_map.items():\n            if frequency > 1:\n                equal_pairs_sum += frequency * (frequency - 1) // 2\n        \n        unequal_pairs = total_pairs - equal_pairs_sum\n        return PairResult(unequal_pairs).value()\n\ndef count_Pairs(items: List[int], n: int) -> int:\n    \"\"\"\n    Counts the number of possible unordered pairs where both elements are unequal.\n    The parameter 'n' is accepted for signature compliance, but len(items) is used for calculations.\n    \"\"\"\n    counter = PairCounter(items, n)\n    return counter.count_Pairs()"}
{"task_id": "Mbpp/568", "solution": "from typing import List, Dict\n\ndef empty_list(N: int) -> List[Dict]:\n    \"\"\"Return a list containing N empty dictionaries.\n\n    Returns a Python list of length N where each element is an empty dict.\n    \"\"\"\n    return [dict() for _ in range(N)]"}
{"task_id": "Mbpp/567", "solution": "from typing import Any\n\nclass SortChecker:\n    \"\"\"\n    Stateless service to check if a list is sorted and compare elements.\n    \"\"\"\n    def issort_list(self, input_list: list) -> bool:\n        \"\"\"\n        Checks if the provided list is sorted in non-decreasing order.\n        Returns True if sorted, False otherwise.\n        \"\"\"\n        if not input_list:\n            return True\n\n        for i in range(len(input_list) - 1):\n            if input_list[i] > input_list[i+1]:\n                return False\n        return True\n\n    def compare(self, a: Any, b: Any) -> int:\n        \"\"\"\n        Compares two elements and returns an integer indicating their relative order.\n        Returns negative if a < b, zero if a == b, positive if a > b.\n        \"\"\"\n        if a < b:\n            return -1\n        elif a == b:\n            return 0\n        else:\n            return 1\n\ndef issort_list(list: list) -> bool:\n    \"\"\"\n    Checks if a list is sorted in ascending order.\n    Delegates the sorting check to a SortChecker instance.\n    \"\"\"\n    checker = SortChecker()\n    return checker.issort_list(list)"}
{"task_id": "Mbpp/569", "solution": "from typing import List\n\ndef sort_sublists(input_list: List[List[str]]) -> List[List[str]]:\n    \"\"\"Sorts each sublist of strings in ascending lexicographical order, preserving outer list order.\"\"\"\n    return [sorted(sublist) for sublist in input_list]"}
{"task_id": "Mbpp/572", "solution": "from typing import List, Dict\n\nclass FrequencyMap:\n    \"\"\"\n    Manages frequency counts of integers from a list.\n    \"\"\"\n    def __init__(self, counts: Dict[int, int]):\n        self.counts = counts\n\n    @staticmethod\n    def from_list(input_list: List[int]) -> 'FrequencyMap':\n        \"\"\"\n        Creates a FrequencyMap by counting occurrences in the input list.\n        \"\"\"\n        counts: Dict[int, int] = {}\n        for item in input_list:\n            counts[item] = counts.get(item, 0) + 1\n        return FrequencyMap(counts)\n\n    def get_count(self, value: int) -> int:\n        \"\"\"\n        Returns the count of a specific value, or 0 if not present.\n        \"\"\"\n        return self.counts.get(value, 0)\n\ndef _compute_frequency_map(input_list: List[int]) -> FrequencyMap:\n    \"\"\"\n    Helper function to compute a FrequencyMap for the given list.\n    \"\"\"\n    return FrequencyMap.from_list(input_list)\n\ndef two_unique_nums(input_list: List[int]) -> List[int]:\n    \"\"\"\n    Returns a new list containing only numbers that appear exactly once in the input,\n    preserving their original relative order.\n    \"\"\"\n    freq_map = _compute_frequency_map(input_list)\n    result: List[int] = []\n    for num in input_list:\n        if freq_map.get_count(num) == 1:\n            result.append(num)\n    return result"}
{"task_id": "Mbpp/573", "solution": "def _product_of_iterable(iterable):\n    \"\"\"Return multiplicative product of numeric values in iterable.\n    Returns 1 for an empty iterable.\"\"\"\n    product = 1\n    for num in iterable:\n        product *= num\n    return product\n\ndef extract_unique(input_list):\n    \"\"\"Return a set of distinct numeric values from input_list.\"\"\"\n    return set(input_list)\n\ndef unique_product(input_list):\n    \"\"\"Accepts a list of numeric values and returns the numeric product of distinct values.\"\"\"\n    unique_numbers = extract_unique(input_list)\n    return _product_of_iterable(unique_numbers)"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(a, b) -> bool:\n    \"\"\"Return True if list b appears as a contiguous subarray in list a; otherwise False.\"\"\"\n    len_a = len(a)\n    len_b = len(b)\n\n    if len_b == 0:\n        return True\n    if len_b > len_a:\n        return False\n\n    for i in range(len_a - len_b + 1):\n        if a[i:i+len_b] == b:\n            return True\n    return False"}
{"task_id": "Mbpp/577", "solution": "class InputValidator:\n    def isNonNegativeInteger(self, value) -> bool:\n        \"\"\"Checks if the value is a non-negative integer.\"\"\"\n        return isinstance(value, int) and value >= 0\n\nclass FactorialService:\n    def __init__(self, validator: InputValidator = None):\n        \"\"\"Initializes the FactorialService with an optional InputValidator.\"\"\"\n        self._validator = validator if validator is not None else InputValidator()\n\n    def last_Digit_Factorial(self, n: int) -> int:\n        \"\"\"\n        Computes the last decimal digit of n!.\n        Raises ValueError for invalid input.\n        \"\"\"\n        if not self._validator.isNonNegativeInteger(n):\n            raise ValueError(\"Input must be a non-negative integer.\")\n\n        if n == 0:\n            return 1\n        elif n >= 5:\n            return 0\n        else:\n            # For n in [1, 4], compute factorial and take the last digit\n            if n == 1:\n                return 1\n            elif n == 2:\n                return 2\n            elif n == 3:\n                return 6\n            elif n == 4:\n                return 4\n\ndef last_Digit_Factorial(n: int) -> int:\n    \"\"\"Finds the last digit in factorial of a given non-negative number.\"\"\"\n    service = FactorialService()\n    return service.last_Digit_Factorial(n)"}
{"task_id": "Mbpp/578", "solution": "def _validate_inputs(a, b, c) -> None:\n    \"\"\"\n    Raises ValueError if inputs are not list-like or have differing lengths.\n    Ensures all inputs are lists and their lengths match.\n    \"\"\"\n    if not isinstance(a, list) or not isinstance(b, list) or not isinstance(c, list):\n        raise ValueError(\"inputs must be list-like\")\n\n    if not (len(a) == len(b) == len(c)):\n        raise ValueError(\"input lists must have same length\")\n\n\ndef interleave_lists(a, b, c) -> list:\n    \"\"\"\n    Interleaves three lists of the same length into a single flat list.\n    Elements are interleaved as a[0], b[0], c[0], a[1], b[1], c[1], and so on.\n    \"\"\"\n    _validate_inputs(a, b, c)\n\n    n = len(a)\n    result = []\n    for i in range(n):\n        result.append(a[i])\n        result.append(b[i])\n        result.append(c[i])\n    return result"}
{"task_id": "Mbpp/581", "solution": "class Validator:\n    \"\"\"Provides static methods for input validation.\"\"\"\n    @staticmethod\n    def isNumeric(value) -> bool:\n        \"\"\"Checks if a value is an integer or a float.\"\"\"\n        return isinstance(value, (int, float))\n\nclass SquarePyramidModel:\n    \"\"\"Represents a square pyramid and computes its surface area.\"\"\"\n    def __init__(self, base_edge: float, height: float):\n        self.base_edge = base_edge\n        self.height = height\n\n    def computeSurfaceArea(self) -> float:\n        \"\"\"Calculates the total surface area using the base edge and slant height.\"\"\"\n        return self.base_edge**2 + 2 * self.base_edge * self.height\n\nclass Result:\n    \"\"\"A simple container for the computed surface area.\"\"\"\n    def __init__(self, area: float):\n        self.area = area\n\nclass SurfaceAreaFunction:\n    \"\"\"Domain wrapper, though the module-level function implements the core logic directly.\"\"\"\n    def surface_Area(self, base_edge, height):\n        pass # This method is not actively used by the top-level module function.\n\ndef surface_Area(base_edge, height):\n    \"\"\"Compute and return the surface area of a square pyramid.\n\n    Parameters:\n      base_edge (int|float): base edge length\n      height (int|float): slant height\n    Returns:\n      int|float: computed surface area\n    \"\"\"\n    if not Validator.isNumeric(base_edge):\n        raise TypeError(\"base_edge must be a numeric value (int or float).\")\n    if not Validator.isNumeric(height):\n        raise TypeError(\"height must be a numeric value (int or float).\")\n\n    # The design explicitly treats 'height' as the slant height for the given formula.\n    pyramid = SquarePyramidModel(float(base_edge), float(height))\n    area = pyramid.computeSurfaceArea()\n\n    _ = Result(area) # Instantiate Result as per design, but return the numeric value directly.\n    return area"}
{"task_id": "Mbpp/579", "solution": "from typing import Tuple, Any\n\nclass DissimilarFinder:\n    @staticmethod\n    def find_dissimilar(a: Tuple, b: Tuple) -> Tuple:\n        \"\"\"Computes the symmetric difference of two tuples with specific ordering and deduplication rules.\"\"\"\n        result_list = []\n        # Tracks what's already in 'result_list' to ensure deduplication across both passes.\n        included_elements = [] \n\n        # First pass: Add elements from 'a' that are not in 'b' and not already in 'result_list'.\n        for item_a in a:\n            if not any(item_a == x for x in b) and not any(item_a == y for y in included_elements):\n                result_list.append(item_a)\n                included_elements.append(item_a)\n\n        # Second pass: Add elements from 'b' that are not in 'a' and not already in 'result_list'.\n        for item_b in b:\n            if not any(item_b == x for x in a) and not any(item_b == y for y in included_elements):\n                result_list.append(item_b)\n                included_elements.append(item_b)\n\n        return tuple(result_list)\n\n\ndef find_dissimilar(a: Tuple, b: Tuple) -> Tuple:\n    \"\"\"\n    Finds dissimilar elements in two tuples, returning elements present in exactly one input,\n    preserving order (elements from 'a' then 'b') and deduplicating.\n    \"\"\"\n    if not isinstance(a, tuple) or not isinstance(b, tuple):\n        raise TypeError(\"Both inputs must be tuples\")\n    return DissimilarFinder.find_dissimilar(a, b)"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Public API to remove odd integers from a nested tuple.\n    Delegates to the recursive helper function.\n    \"\"\"\n    return _extract_even_recursive(input_tuple)\n\ndef _extract_even_recursive(obj: tuple) -> tuple:\n    \"\"\"\n    Module-private helper for recursive traversal and filtering.\n    Filters out odd integers and recursively processes nested tuples.\n    \"\"\"\n    result_elements = []\n    for item in obj:\n        if isinstance(item, int):\n            if item % 2 == 0:\n                result_elements.append(item)\n        elif isinstance(item, tuple):\n            nested_result = _extract_even_recursive(item)\n            result_elements.append(nested_result)\n    return tuple(result_elements)"}
{"task_id": "Mbpp/583", "solution": "class ValidationException(Exception):\n    \"\"\"Exception raised for invalid input parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass InputParameter:\n    \"\"\"Data model for validated input parameter.\"\"\"\n    def __init__(self, n: int, is_valid: bool):\n        self.n: int = n\n        self.is_valid: bool = is_valid\n\nclass Validator:\n    \"\"\"Validates input parameters for Catalan number computation.\"\"\"\n    @staticmethod\n    def is_integer(n: object) -> bool:\n        \"\"\"Checks if the input is an integer.\"\"\"\n        return isinstance(n, int)\n\n    @staticmethod\n    def is_non_negative(n: int) -> bool:\n        \"\"\"Checks if the integer input is non-negative.\"\"\"\n        return n >= 0\n\n    @staticmethod\n    def validate(n: object) -> InputParameter:\n        \"\"\"Validates the input 'n' to be a non-negative integer.\"\"\"\n        if not Validator.is_integer(n):\n            raise ValidationException(\"Input must be an integer.\")\n        if not Validator.is_non_negative(n):\n            raise ValidationException(\"Input must be a non-negative integer.\")\n        return InputParameter(n, is_valid=True)\n\nclass Calculator:\n    \"\"\"Computes the nth Catalan number.\"\"\"\n    @staticmethod\n    def compute_catalan(n: int) -> int:\n        \"\"\"Calculates the nth Catalan number using binomial coefficients.\"\"\"\n        if n == 0:\n            return 1\n\n        def combinations(N, K):\n            \"\"\"Helper to calculate binomial coefficient C(N, K).\"\"\"\n            if K < 0 or K > N:\n                return 0\n            if K == 0 or K == N:\n                return 1\n            if K > N // 2:\n                K = N - K\n\n            res = 1\n            for i in range(K):\n                res = res * (N - i) // (i + 1)\n            return res\n\n        # Catalan number C_n = C(2n, n) / (n + 1)\n        binom_coeff = combinations(2 * n, n)\n        return binom_coeff // (n + 1)\n\ndef catalan_number(n: int) -> int:\n    \"\"\"\n    Computes the nth Catalan number after validating the input.\n    Raises ValidationException for invalid inputs.\n    \"\"\"\n    ip = Validator.validate(n)\n    result = Calculator.compute_catalan(ip.n)\n    return result"}
{"task_id": "Mbpp/585", "solution": "from typing import List, TypedDict, Any\n\nclass Item(TypedDict):\n    name: str\n    price: float\n\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid input to the expensive_items service.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\n    def __str__(self) -> str:\n        return self.message\n\nclass ExpensiveItemsService:\n    \"\"\"Encapsulates validation, sorting, and selection logic for expensive items.\"\"\"\n\n    def expensive_items(self, items: Any, n: Any) -> List[Item]:\n        \"\"\"Orchestrates validation and returns up to n most expensive items.\"\"\"\n        self.validate_items(items, n)\n\n        if n == 0:\n            return []\n\n        for item in items:\n            self.validate_item(item)\n\n        sorted_items = self.sort_by_price_desc(items)\n\n        if n >= len(sorted_items):\n            return sorted_items\n        else:\n            return sorted_items[:n]\n\n    def validate_items(self, items: Any, n: Any) -> None:\n        \"\"\"Validates that items is a list and n is an integer.\"\"\"\n        if not isinstance(items, list):\n            raise InvalidInputError(\"Input 'items' must be a list.\")\n        if not isinstance(n, int):\n            raise InvalidInputError(\"Input 'n' must be an integer.\")\n\n    def validate_item(self, item: Any) -> None:\n        \"\"\"Validates that an item has a 'name' (str) and a numeric 'price' (float/int).\"\"\"\n        if not isinstance(item, dict):\n            raise InvalidInputError(\"Each item in 'items' must be a dictionary.\")\n        if 'name' not in item or not isinstance(item['name'], str):\n            raise InvalidInputError(\"Each item must have a 'name' (string).\")\n        if 'price' not in item or not isinstance(item['price'], (int, float)):\n            raise InvalidInputError(\"Each item must have a 'price' (numeric).\")\n\n    def sort_by_price_desc(self, items: List[Item]) -> List[Item]:\n        \"\"\"Returns a new list of items sorted by numeric price in descending order.\"\"\"\n        return sorted(items, key=lambda item: item['price'], reverse=True)\n\ndef expensive_items(items: List[Item], n: int) -> List[Item]:\n    \"\"\"\n    Finds the n most expensive items in a given dataset.\n    Delegates to ExpensiveItemsService for validation and logic.\n    \"\"\"\n    service = ExpensiveItemsService()\n    return service.expensive_items(items, n)"}
