{"task_id": "Mbpp/96", "solution": "import math\n\ndef divisor(n: int) -> int:\n    \"\"\"Calculates the number of positive divisors for a given integer n.\n    This implementation uses an O(sqrt(n)) algorithm.\n    \"\"\"\n    count = 0\n    # Loop from 1 up to the square root of n (inclusive).\n    # math.isqrt(n) returns the integer part of the square root.\n    for i in range(1, math.isqrt(n) + 1):\n        if n % i == 0:\n            if i * i == n:\n                # If i is a perfect square root, it's counted once.\n                count += 1\n            else:\n                # Otherwise, i and n // i are distinct divisors, counted as a pair.\n                count += 2\n    return count"}
{"task_id": "Mbpp/97", "solution": "import collections\n\ndef frequency_lists(list_of_lists):\n    \"\"\"Accepts a single argument (a list of lists) and returns a dict mapping elements to integer counts.\"\"\"\n    flattened_list = []\n    for sublist in list_of_lists:\n        for item in sublist:\n            flattened_list.append(item)\n    \n    return collections.Counter(flattened_list)"}
{"task_id": "Mbpp/98", "solution": "from typing import Sequence, Union\n\ndef _validate_sequence(sequence: Sequence[Union[int, float]]) -> None:\n    \"\"\"Validates the input sequence for type, non-emptiness, and numeric elements.\"\"\"\n    if not isinstance(sequence, (list, tuple)):\n        raise TypeError(f\"Input must be a list or tuple, but got {type(sequence).__name__}\")\n    if not sequence:\n        raise ValueError(\"Sequence must not be empty.\")\n    for i, element in enumerate(sequence):\n        if not isinstance(element, (int, float)):\n            raise TypeError(f\"Element at index {i} is not numeric: {element} (type: {type(element).__name__})\")\n\ndef _compute_product(sequence: Sequence[Union[int, float]]) -> float:\n    \"\"\"Computes the product of all numeric elements in the sequence.\"\"\"\n    running_product = 1.0\n    for element in sequence:\n        running_product *= float(element)\n    return running_product\n\ndef _divide_product_by_length(product: float, length: int) -> float:\n    \"\"\"Divides the product by the sequence length, returning a float.\"\"\"\n    return product / length\n\ndef multiply_num(sequence) -> float:\n    \"\"\"Compute (product of elements) / len(sequence) and return as float.\n\n    Raises TypeError or ValueError for invalid input, with informative messages.\n    \"\"\"\n    _validate_sequence(sequence)\n    product = _compute_product(sequence)\n    length = len(sequence)\n    result = _divide_product_by_length(product, length)\n    return result"}
{"task_id": "Mbpp/100", "solution": "class IntegerInput:\n    \"\"\"Simple domain holder for the input integer.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass PalindromeNumber:\n    \"\"\"Domain holder for a candidate palindrome value and provides palindrome test.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def isPalindrome(self) -> bool:\n        \"\"\"Checks if the stored integer value is a palindrome based on its decimal digits.\"\"\"\n        s = str(self.value)\n        return s == s[::-1]\n\nclass PalindromeCalculator:\n    \"\"\"Encapsulates the algorithm to produce the smallest integer palindrome strictly greater than an input.\"\"\"\n    @staticmethod\n    def next_smallest_palindrome(input_val: int) -> int:\n        \"\"\"Finds the next smallest palindrome by incrementing from input_val + 1 and checking each candidate.\"\"\"\n        candidate = input_val + 1\n        while True:\n            pn = PalindromeNumber(candidate)\n            if pn.isPalindrome():\n                return candidate\n            candidate += 1\n\ndef next_smallest_palindrome(input: int) -> int:\n    \"\"\"\n    Computes and returns the smallest integer palindrome strictly greater than the provided integer input.\n    Delegates the computation to the PalindromeCalculator class.\n    \"\"\"\n    return PalindromeCalculator.next_smallest_palindrome(input)"}
{"task_id": "Mbpp/99", "solution": "from datetime import datetime\nfrom typing import List, Dict\n\nCALL_LOG: List[Dict] = []\n\ndef decimal_to_binary(n: int) -> str:\n    # Convert decimal integer to its binary string representation.\n    if n == 0:\n        binary_value = \"0\"\n    else:\n        binary_value = bin(n)[2:]\n\n    CALL_LOG.append({\n        'decimal_value': n,\n        'binary_value': binary_value,\n        'called_at': datetime.utcnow().isoformat()\n    })\n    return binary_value"}
