{"task_id": "Mbpp/233", "solution": "import math\n\ndef lateralsuface_cylinder(radius, height):\n    \"\"\"\n    Calculates the lateral surface area of a cylinder.\n    Inputs must be numeric (int or float); otherwise, a TypeError is raised.\n    \"\"\"\n    if not isinstance(radius, (int, float)) or not isinstance(height, (int, float)):\n        raise TypeError(\"radius and height must be numeric (int or float)\")\n\n    # Convert inputs to float to ensure consistent floating-point arithmetic\n    radius_f = float(radius)\n    height_f = float(height)\n\n    # Compute lateral surface area using the formula: 2 * pi * radius * height\n    lateral_surface = 2 * math.pi * radius_f * height_f\n\n    return lateral_surface"}
{"task_id": "Mbpp/238", "solution": "def compute_length(s):\n    \"\"\"Returns the length of the input string.\"\"\"\n    return len(s)\n\ndef formula(n):\n    \"\"\"Calculates n*(n+1)//2 for a given integer n.\"\"\"\n    return n * (n + 1) // 2\n\ndef number_of_substrings(s):\n    \"\"\"\n    Counts the number of non-empty substrings of a given string.\n    This is calculated using the formula n*(n+1)//2, where n is the string length.\n    \"\"\"\n    length = compute_length(s)\n    return formula(length)"}
{"task_id": "Mbpp/235", "solution": "def generate_even_bits_mask(length: int) -> int:\n    \"\"\"Generate mask with bits set at even (1-based) positions up to length.\n    This mask is intended for bitwise OR with the input number.\n    \"\"\"\n    mask = 0\n    for p in range(1, length + 1):\n        if p % 2 == 0:\n            mask |= (1 << (p - 1))\n    return mask\n\ndef even_bit_set_number(n: int) -> int:\n    \"\"\"Set all even bits (1-based positions 2,4,6,...) of integer n to 1 and return result.\n    It determines the necessary bit length for mask generation.\n    \"\"\"\n    length = max(1, n.bit_length())\n    even_bits_mask = generate_even_bits_mask(length)\n    return n | even_bits_mask"}
{"task_id": "Mbpp/237", "solution": "from typing import List, Tuple, Dict, Any, Iterator\n\nclass TupleList:\n    def __init__(self, items: List[Tuple[Any, Any]]) -> None:\n        self.items = items\n\n    def __iter__(self) -> Iterator[Tuple[Any, Any]]:\n        return iter(self.items)\n\n    def validate_items(self) -> None:\n        \"\"\"\n        Validates that all items in the list are 2-element tuples.\n        Raises TypeError if an item is not a tuple, or ValueError if it's not a 2-element tuple.\n        \"\"\"\n        for item in self.items:\n            if not isinstance(item, tuple):\n                raise TypeError(f\"List element must be a tuple, but got {type(item)}\")\n            if len(item) != 2:\n                raise ValueError(f\"Tuple must contain exactly 2 elements, but got {len(item)} in {item}\")\n\nclass TuplePair:\n    def __init__(self, a: Any, b: Any) -> None:\n        self.a = a\n        self.b = b\n\n    def normalize(self) -> Tuple[Any, Any]:\n        \"\"\"\n        Returns the 2-element tuple with its elements in non-decreasing order.\n        \"\"\"\n        return (min(self.a, self.b), max(self.a, self.b))\n\n    def as_tuple(self) -> Tuple[Any, Any]:\n        \"\"\"\n        Returns the original 2-element tuple.\n        \"\"\"\n        return (self.a, self.b)\n\nclass OccurrenceDictionary:\n    def __init__(self) -> None:\n        self.mapping: Dict[Tuple[Any, Any], int] = {}\n\n    def increment(self, key: Tuple[Any, Any]) -> None:\n        \"\"\"\n        Increments the count for a given tuple key. Initializes to 1 if not present.\n        \"\"\"\n        self.mapping[key] = self.mapping.get(key, 0) + 1\n\n    def get(self, key: Tuple[Any, Any]) -> int:\n        \"\"\"\n        Returns the count for a given tuple key, or 0 if not present.\n        \"\"\"\n        return self.mapping.get(key, 0)\n\n    def as_dict(self) -> Dict[Tuple[Any, Any], int]:\n        \"\"\"\n        Returns the underlying dictionary mapping normalized tuples to counts.\n        \"\"\"\n        return self.mapping\n\ndef _validate_input(list_of_2_tuples: List[Tuple[Any, Any]]) -> None:\n    \"\"\"\n    Validates that the input is a list.\n    Raises TypeError if the input is not a list.\n    \"\"\"\n    if not isinstance(list_of_2_tuples, list):\n        raise TypeError(f\"Input must be a list, but got {type(list_of_2_tuples)}\")\n\ndef _normalize_tuple(two_tuple: Tuple[Any, Any]) -> Tuple[Any, Any]:\n    \"\"\"\n    Normalizes a 2-element tuple by ordering its elements non-decreasingly.\n    \"\"\"\n    return TuplePair(two_tuple[0], two_tuple[1]).normalize()\n\ndef check_occurences(list_of_2_tuples: List[Tuple[Any, Any]]) -> Dict[Tuple[Any, Any], int]:\n    \"\"\"\n    Takes a list of tuples and returns a dictionary mapping each unique normalized tuple\n    to the number of times it occurs in the list.\n    \"\"\"\n    _validate_input(list_of_2_tuples)\n\n    if not list_of_2_tuples:\n        return {}\n\n    tuple_list_obj = TupleList(list_of_2_tuples)\n    tuple_list_obj.validate_items()\n\n    occurrence_dict_obj = OccurrenceDictionary()\n\n    for item_tuple in tuple_list_obj:\n        normalized_key = _normalize_tuple(item_tuple)\n        occurrence_dict_obj.increment(normalized_key)\n\n    return occurrence_dict_obj.as_dict()"}
