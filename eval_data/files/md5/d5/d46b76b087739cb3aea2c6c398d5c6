{"task_id": "Mbpp/292", "solution": "import math\nfrom typing import Union, Any\n\nclass NumericValue:\n    \"\"\"\n    Encapsulates a numeric value, storing its original input and validating if it's numeric.\n    \"\"\"\n    def __init__(self, value: Any):\n        self._original_value = value\n        self._is_valid = isinstance(value, (int, float))\n        try:\n            self._value: float = float(value)\n        except (TypeError, ValueError):\n            # If the original value isn't numeric and also not convertible to float,\n            # store a default float. The _is_valid flag will indicate the original type.\n            self._value = 0.0 \n\n    def is_valid(self) -> bool:\n        \"\"\"Returns True if the original value was an int or float.\"\"\"\n        return self._is_valid\n\n    @property\n    def value(self) -> float:\n        \"\"\"Returns the internal float representation of the value.\"\"\"\n        return self._value\n\nclass DivisionOperation:\n    \"\"\"\n    Performs the division operation on two NumericValue objects, computing the floor.\n    \"\"\"\n    def __init__(self, dividend: NumericValue, divisor: NumericValue):\n        self._dividend = dividend\n        self._divisor = divisor\n\n    def compute(self) -> int:\n        \"\"\"\n        Computes floor(dividend / divisor) using mathematical floor semantics.\n        Raises ZeroDivisionError if the divisor is zero.\n        \"\"\"\n        if self._divisor.value == 0:\n            raise ZeroDivisionError(\"Divisor cannot be zero.\")\n        return math.floor(self._dividend.value / self._divisor.value)\n\nclass Result:\n    \"\"\"\n    A simple wrapper for an integer quotient, ensuring its type.\n    \"\"\"\n    def __init__(self, quotient: int):\n        self._quotient = quotient\n\n    def as_int(self) -> int:\n        \"\"\"Returns the stored quotient as an integer.\"\"\"\n        return self._quotient\n\ndef find(dividend: Union[int, float], divisor: Union[int, float]) -> int:\n    \"\"\"\n    Calculates the quotient of two numbers, rounded down to the nearest integer (floor).\n    Raises TypeError if inputs are non-numeric, or ZeroDivisionError if divisor is zero.\n    \"\"\"\n    dividend_nv = NumericValue(dividend)\n    divisor_nv = NumericValue(divisor)\n\n    if not dividend_nv.is_valid() or not divisor_nv.is_valid():\n        raise TypeError(\"Inputs must be numeric (int or float).\")\n\n    operation = DivisionOperation(dividend_nv, divisor_nv)\n    quotient = operation.compute()\n\n    return quotient"}
{"task_id": "Mbpp/297", "solution": "def _flatten_generator(item):\n    \"\"\"Internal generator yielding atomic elements found when traversing nested lists.\n    If item is a list, recursively yield from its elements; otherwise yield the item.\n    \"\"\"\n    if isinstance(item, list):\n        for sub_item in item:\n            yield from _flatten_generator(sub_item)\n    else:\n        yield item\n\ndef flatten_list(input_list):\n    \"\"\"Return a newly allocated list containing all non-list elements from input_list\n    in left-to-right order. Only list instances are treated as nested containers.\n    \"\"\"\n    return [x for x in _flatten_generator(input_list)]"}
{"task_id": "Mbpp/294", "solution": "class Result:\n    \"\"\"A data holder for the computed maximum value.\"\"\"\n    def __init__(self, maxValue):\n        self.maxValue = maxValue\n\nclass ListItem:\n    \"\"\"Base class for an item in the input list.\"\"\"\n    def __init__(self, value):\n        self.value = value\n    \n    def isNumeric(self) -> bool:\n        \"\"\"Checks if the item's value is numeric (int or float).\"\"\"\n        return isinstance(self.value, (int, float))\n\nclass NumericItem(ListItem):\n    \"\"\"Represents a numeric item in the list.\"\"\"\n    def __init__(self, value: (int or float)):\n        super().__init__(value)\n    \n    def isNumeric(self) -> bool:\n        \"\"\"Always returns True for a NumericItem.\"\"\"\n        return True\n\nclass NonNumericItem(ListItem):\n    \"\"\"Represents a non-numeric item in the list.\"\"\"\n    def __init__(self, value):\n        super().__init__(value)\n    \n    def isNumeric(self) -> bool:\n        \"\"\"Always returns False for a NonNumericItem.\"\"\"\n        return False\n\nclass InputList:\n    \"\"\"A wrapper for the input list.\"\"\"\n    def __init__(self, items: list):\n        self.items = items\n\nclass MaxValFunction:\n    \"\"\"Encapsulates the logic for finding the maximum numeric value.\"\"\"\n    def compute(self, items: list) -> (int or float):\n        \"\"\"\n        Filters numeric items from the list and computes their maximum value.\n        Non-numeric items are ignored per requirements.\n        \"\"\"\n        collected_numeric_items = []\n        for item_value in items:\n            if isinstance(item_value, (int, float)):\n                item_obj = NumericItem(item_value)\n                collected_numeric_items.append(item_obj)\n            else:\n                pass # NonNumericItem is ignored.\n\n        max_val_found = None\n        if collected_numeric_items:\n            max_val_found = collected_numeric_items[0].value\n            for i in range(1, len(collected_numeric_items)):\n                current_numeric_value = collected_numeric_items[i].value\n                if current_numeric_value > max_val_found:\n                    max_val_found = current_numeric_value\n        \n        return max_val_found\n\ndef max_val(items: list) -> (int or float):\n    \"\"\"\n    Finds the maximum numeric value in a given heterogeneous list,\n    delegating the computation to an internal MaxValFunction.\n    \"\"\"\n    maximizer = MaxValFunction()\n    return maximizer.compute(items)"}
{"task_id": "Mbpp/300", "solution": "from dataclasses import dataclass\n\nclass ValidationError(ValueError):\n    \"\"\"\n    Custom exception for invalid input parameters.\n    \"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\n@dataclass\nclass InputParameter:\n    \"\"\"\n    Data holder for input parameters.\n    \"\"\"\n    n: int\n\n@dataclass\nclass ComputationResult:\n    \"\"\"\n    Data holder for computation results.\n    \"\"\"\n    value: int\n\nclass BinomialCoefficient:\n    \"\"\"\n    Provides exact integer computation for binomial coefficients C(N, K).\n    \"\"\"\n    def compute(self, two_n: int, n: int) -> int:\n        \"\"\"\n        Computes C(two_n, n) using an integer multiplicative algorithm.\n        \"\"\"\n        # Constraints: two_n >= 0, 0 <= n <= two_n are assumed due to external requirements.\n        # However, for the binomial coefficient formula, handling out-of-bounds n is necessary.\n        if n < 0 or n > two_n:\n            return 0\n        if n == 0 or n == two_n:\n            return 1\n        # Optimize by using C(N, K) = C(N, N-K)\n        if n > two_n // 2:\n            n = two_n - n\n\n        res = 1\n        for i in range(n):\n            res = res * (two_n - i) // (i + 1)\n        return res\n\nclass CountBinarySeq:\n    \"\"\"\n    Facade class to orchestrate validation and binomial coefficient computation.\n    \"\"\"\n    def __init__(self, binom: BinomialCoefficient = None) -> None:\n        self._binom = binom if binom is not None else BinomialCoefficient()\n\n    def count(self, n: int) -> int:\n        \"\"\"\n        Computes the count of binary sequences of length 2n satisfying the condition.\n        \"\"\"\n        # Input validation for n (non-negative integer) is skipped due to external requirements.\n        two_n = 2 * n\n        result_value = self._binom.compute(two_n=two_n, n=n)\n        return result_value\n\n# Module-level instance for the public API function.\n_count_binary_seq_instance = CountBinarySeq()\n\ndef count_binary_seq(n: int) -> int:\n    \"\"\"\n    Finds the count of all binary sequences of length 2n such that sum of first n bits\n    is the same as sum of last n bits.\n    \"\"\"\n    return _count_binary_seq_instance.count(n)"}
{"task_id": "Mbpp/299", "solution": "import collections\nfrom typing import List, Tuple, Union\n\nclass AggregatedResult:\n    \"\"\"Represents the name and total of an aggregation result.\"\"\"\n    def __init__(self, name: str, total: Union[int, float]):\n        self.name = name\n        self.total = total\n\nclass TupleEntry:\n    \"\"\"Validates and stores a name-value pair from input.\"\"\"\n    def __init__(self, name: str, value: Union[int, float]):\n        if not isinstance(name, str):\n            raise TypeError(f\"Name must be a string, got {type(name).__name__}\")\n        if not isinstance(value, (int, float)):\n            raise TypeError(f\"Value must be numeric, got {type(value).__name__}\")\n        self.name = name\n        self.value = value\n\nclass AggregationMap:\n    \"\"\"Manages aggregation of values per name, preserving insertion order for tie-breaking.\"\"\"\n    def __init__(self):\n        self._map: dict[str, Union[int, float]] = {}\n        self._insertion_order: List[str] = []\n\n    def increment(self, name: str, value: Union[int, float]):\n        \"\"\"Adds a value to a name's total, tracking first-seen names.\"\"\"\n        if name not in self._map:\n            self._map[name] = 0\n            self._insertion_order.append(name)\n        self._map[name] += value\n\n    def get_max(self) -> AggregatedResult:\n        \"\"\"Finds the name with the maximum total, resolving ties by first-seen order.\"\"\"\n        # If max_aggregate completes without raising an error, _map is guaranteed to be non-empty.\n        \n        max_name: str = self._insertion_order[0]\n        max_total: Union[int, float] = self._map[max_name]\n\n        # Iterate through insertion order to handle tie-breaking (first-seen policy)\n        for name in self._insertion_order:\n            current_total = self._map[name]\n            if current_total > max_total:\n                max_total = current_total\n                max_name = name\n        \n        return AggregatedResult(max_name, max_total)\n\nclass MaxAggregateFunction:\n    \"\"\"Orchestrates input validation, aggregation, and result retrieval.\"\"\"\n    def max_aggregate(self, input_list: List[Tuple[str, Union[int, float]]]) -> AggregatedResult:\n        \"\"\"Processes a list of tuples to find the highest aggregate.\"\"\"\n        if not isinstance(input_list, list):\n             raise TypeError(\"Input must be a list\")\n        \n        if not input_list:\n            raise ValueError('input_list must contain at least one valid (name, value) tuple')\n\n        aggregation_map = AggregationMap()\n\n        for i, item in enumerate(input_list):\n            if not isinstance(item, tuple) or len(item) != 2:\n                raise TypeError(f\"Item at index {i} must be a 2-tuple, got {type(item).__name__} or invalid length.\")\n            \n            try:\n                entry = TupleEntry(item[0], item[1])\n                aggregation_map.increment(entry.name, entry.value)\n            except TypeError as e:\n                raise TypeError(f\"Invalid tuple entry at index {i}: {e}\") from e\n        \n        return aggregation_map.get_max()\n\ndef max_aggregate(input_list: List[Tuple[str, Union[int, float]]]) -> Tuple[str, Union[int, float]]:\n    \"\"\"\n    Calculates the maximum aggregate from a list of (name, value) tuples.\n    Aggregates numeric values for unique names and returns the name with the\n    highest total, resolving ties by first-seen order.\n    \"\"\"\n    processor = MaxAggregateFunction()\n    result = processor.max_aggregate(input_list)\n    return (result.name, result.total)"}
{"task_id": "Mbpp/296", "solution": "import typing\nfrom dataclasses import dataclass\n\n# -- Domain Classes --\n\nclass ValidationException(TypeError):\n    \"\"\"\n    Exception raised for invalid input to inversion counting functions.\n    This class subclasses TypeError as specified in design.\n    \"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\n@dataclass(frozen=True)\nclass InputArray:\n    \"\"\"A value object representing the input array.\"\"\"\n    elements: typing.List[int]\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the array.\"\"\"\n        return len(self.elements)\n\n@dataclass(frozen=True)\nclass Element:\n    \"\"\"Represents an element in the array with its index and value.\"\"\"\n    index: int\n    value: int\n\n@dataclass(frozen=True)\nclass InversionPair:\n    \"\"\"Represents an inversion pair (arr[i], arr[j]) where i < j and arr[i] > arr[j]).\"\"\"\n    leftIndex: int\n    rightIndex: int\n    leftValue: int\n    rightValue: int\n\nclass InversionCountResult:\n    \"\"\"Container for the inversion count result.\"\"\"\n    def __init__(self, count: int) -> None:\n        self._count = count\n\n    def get_count(self) -> int:\n        \"\"\"Returns the calculated inversion count.\"\"\"\n        return self._count\n\n# -- InversionCalculator --\n\nclass InversionCalculator:\n    \"\"\"\n    Orchestrates validation and merge-based inversion counting.\n    Its count_using_merge method is O(n log n) time and O(n) auxiliary space.\n    \"\"\"\n    def get_Inv_Count(self, arr: typing.List[int]) -> int:\n        \"\"\"\n        Validates the input array and calculates the total number of inversions.\n        Returns 0 for empty or single-element arrays.\n        \"\"\"\n        self.validate_input(arr)\n\n        n = len(arr)\n        if n <= 1:\n            return 0  # No inversions in empty or single-element arrays\n\n        # Delegates to the core counting logic\n        return self.count_using_merge(arr)\n\n    def validate_input(self, arr: typing.List[int]) -> None:\n        \"\"\"\n        Ensures the input is a list of integers.\n        Raises ValidationException if the input is invalid.\n        \"\"\"\n        if not isinstance(arr, list):\n            raise ValidationException(\n                f\"Input must be a list, but received type {type(arr).__name__}\"\n            )\n        for i, item in enumerate(arr):\n            if not isinstance(item, int):\n                raise ValidationException(\n                    f\"List must contain only integers, but element at index {i} \"\n                    f\"is of type {type(item).__name__} with value '{item}'\"\n                )\n\n    def count_using_merge(self, arr_to_count: typing.List[int]) -> int:\n        \"\"\"\n        Implements the merge-based inversion counting algorithm.\n        This method operates on a copy of the input list to ensure non-mutation.\n        It is O(n log n) time complexity and O(n) auxiliary space complexity.\n        \"\"\"\n        # A shallow copy is sufficient for non-mutation of the top-level list\n        # since integers are immutable.\n        _, inversions = self._merge_sort_and_count_recursive(list(arr_to_count))\n        return inversions\n\n    def _merge_sort_and_count_recursive(self, arr_segment: typing.List[int]) -> typing.Tuple[typing.List[int], int]:\n        \"\"\"\n        Recursively sorts a sub-array and counts inversions during the merge process.\n        This method operates on copies of segments and returns new lists, ensuring\n        the original input array is not mutated.\n        \"\"\"\n        n = len(arr_segment)\n        if n <= 1:\n            return arr_segment, 0\n\n        mid = n // 2\n        left_half, left_inversions = self._merge_sort_and_count_recursive(arr_segment[:mid])\n        right_half, right_inversions = self._merge_sort_and_count_recursive(arr_segment[mid:])\n\n        merged_arr = []\n        split_inversions = 0\n        i = j = 0\n\n        while i < len(left_half) and j < len(right_half):\n            if left_half[i] <= right_half[j]:\n                merged_arr.append(left_half[i])\n                i += 1\n            else:\n                # An inversion occurs: left_half[i] is greater than right_half[j].\n                # All remaining elements in left_half (from index i onwards)\n                # will also be greater than right_half[j].\n                merged_arr.append(right_half[j])\n                split_inversions += (len(left_half) - i)\n                j += 1\n        \n        merged_arr.extend(left_half[i:])\n        merged_arr.extend(right_half[j:])\n        \n        return merged_arr, left_inversions + right_inversions + split_inversions\n\n# -- Public API Function --\n\ndef get_Inv_Count(arr: typing.List[int]) -> int:\n    \"\"\"\n    Counts inversions in an array using a merge-based algorithm (O(n log n)).\n    This function validates input and returns the total inversion count.\n    \"\"\"\n    calculator = InversionCalculator()\n    return calculator.get_Inv_Count(arr)"}
{"task_id": "Mbpp/301", "solution": "class InputValidator:\n    \"\"\"Input validation utilities for precondition checks.\"\"\"\n    def validate(self, arg) -> bool:\n        \"\"\"Returns True if arg is a native dict; False otherwise.\"\"\"\n        return isinstance(arg, dict)\n\nclass DepthResult:\n    \"\"\"Lightweight data holder for computed depth value.\"\"\"\n    def __init__(self, depth: int):\n        self.depth = depth\n\nclass DepthCalculator:\n    \"\"\"Core algorithm to compute maximum nesting depth of dictionaries.\"\"\"\n    def dict_depth(self, d: dict) -> int:\n        \"\"\"Computes the maximum dictionary nesting depth, starting from 1.\"\"\"\n        return self._max_depth(d, 1)\n\n    def _max_depth(self, d: dict, current: int) -> int:\n        \"\"\"Recursive helper to calculate maximum depth.\"\"\"\n        max_child_depth = current\n        for value in d.values():\n            if isinstance(value, dict):\n                max_child_depth = max(max_child_depth, self._max_depth(value, current + 1))\n        return max_child_depth\n\ndef dict_depth(d: dict) -> int:\n    \"\"\"Public API. Validates and computes nested dict depth per SRS.\"\"\"\n    validator = InputValidator()\n    if not validator.validate(d):\n        raise TypeError(\"dict_depth expects a dict as the single argument\")\n    calc = DepthCalculator()\n    return calc.dict_depth(d)"}
{"task_id": "Mbpp/305", "solution": "class InputList:\n    \"\"\"Stores raw lines and provides an iterator for Word objects.\"\"\"\n    def __init__(self, raw_lines: list) -> None:\n        if not isinstance(raw_lines, list):\n            raise TypeError(\"Input must be a list.\")\n        for i, item in enumerate(raw_lines):\n            if not isinstance(item, str):\n                raise TypeError(f\"List element at index {i} must be a string.\")\n        self.lines = raw_lines\n\n    def iterate_words(self) -> list:\n        \"\"\"Tokenizes lines into Word instances.\"\"\"\n        words = []\n        for line_index, raw_line in enumerate(self.lines):\n            tokens = raw_line.split()\n            for word_index, text in enumerate(tokens):\n                words.append(Word(text, line_index, word_index))\n        return words\n\nclass Word:\n    \"\"\"Represents a token (word) with its original text and position.\"\"\"\n    def __init__(self, text: str, line_index: int, word_index: int) -> None:\n        self.text = text\n        self.line_index = line_index\n        self.word_index = word_index\n\n    def starts_with_p(self) -> bool:\n        \"\"\"Checks if the word starts with 'p' case-insensitively.\"\"\"\n        return bool(self.text) and self.text[0].casefold() == 'p'\n\nclass MatchResult:\n    \"\"\"A value object holding the first and second matched strings.\"\"\"\n    def __init__(self, first: str, second: str) -> None:\n        self.first = first\n        self.second = second\n\n    def as_tuple(self) -> tuple:\n        \"\"\"Returns the matched words as a tuple.\"\"\"\n        return (self.first, self.second)\n\n\ndef start_withp(inputStrings: list) -> tuple:\n    \"\"\"\n    Returns two words from a list of words starting with 'p'.\n\n    The function validates input, tokenizes strings by whitespace,\n    identifies words starting with 'p' (case-insensitive), and returns\n    the first two matches preserving original casing.\n    \"\"\"\n    input_list = InputList(inputStrings)\n    all_words = input_list.iterate_words()\n    \n    matching_words = []\n    for word_obj in all_words:\n        if word_obj.starts_with_p():\n            matching_words.append(word_obj.text)\n        if len(matching_words) == 2:\n            break\n\n    if len(matching_words) < 2:\n        raise ValueError(\"Fewer than two words starting with 'p' were found.\")\n\n    result = MatchResult(matching_words[0], matching_words[1])\n    return result.as_tuple()"}
