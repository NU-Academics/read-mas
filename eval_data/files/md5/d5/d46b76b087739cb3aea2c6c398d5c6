{"task_id": "Mbpp/138", "solution": "from dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass InputNumber:\n    value: int\n    def type_name(self) -> str:\n        return type(self.value).__name__\n\n@dataclass\nclass PowerOfTwo:\n    exponent: int\n    value: int  # computed as 2 ** exponent\n\nclass SumRepresentation:\n    def __init__(self, target: int, terms: List[PowerOfTwo]):\n        self.target = target\n        self.terms = terms\n\n    def is_valid(self) -> bool:\n        # Checks exponents >= 1, uniqueness of exponents, and sum of terms equals target.\n        if not self.terms:\n            return False\n\n        current_sum = 0\n        exponents_seen = set()\n        for term in self.terms:\n            if term.exponent < 1:\n                return False\n            if term.exponent in exponents_seen:\n                return False\n            exponents_seen.add(term.exponent)\n            current_sum += term.value\n\n        return current_sum == self.target\n\n@dataclass\nclass Result:\n    value: bool\n\ndef _decompose_into_powers(n: int) -> SumRepresentation:\n    # Decompose n into PowerOfTwo terms using binary decomposition, but only exponents >= 1.\n    original_n = n\n    terms: List[PowerOfTwo] = []\n    exponent = 0\n    temp_n = n\n    while temp_n > 0:\n        if (temp_n & 1) == 1:\n            if exponent >= 1:\n                terms.append(PowerOfTwo(exponent=exponent, value=2 ** exponent))\n        temp_n >>= 1\n        exponent += 1\n    return SumRepresentation(target=original_n, terms=terms)\n\ndef is_Sum_Of_Powers_Of_Two(n):\n    # Check whether the given number can be represented as sum of non-zero powers of 2.\n    try:\n        input_obj = InputNumber(value=n)\n    except TypeError:\n        raise TypeError(\"Input must be an integer.\")\n\n    validated_n = input_obj.value\n\n    if validated_n <= 1:\n        return False\n\n    sum_representation = _decompose_into_powers(validated_n)\n    return Result(value=sum_representation.is_valid()).value"}
{"task_id": "Mbpp/140", "solution": "def extract_singly(sequences):\n    \"\"\"\n    Flattens a list of lists into a single set of numbers.\n    Raises TypeError if the top-level argument is not iterable.\n    \"\"\"\n    _validate_top_level_iterable(sequences)\n    all_elements = _process_sequences(sequences)\n    return _build_result_set(all_elements)\n\ndef _validate_top_level_iterable(sequences):\n    \"\"\"\n    Verifies the top-level argument is iterable and not None.\n    Raises TypeError if invalid.\n    \"\"\"\n    if sequences is None or not hasattr(sequences, '__iter__'):\n        raise TypeError(\"Top-level argument must be an iterable, not None.\")\n\ndef _collect_elements(sequences):\n    \"\"\"\n    Yields elements from inner sequences, treating non-iterable items as single elements.\n    \"\"\"\n    for inner_sequence in sequences:\n        try:\n            # Attempt to iterate the inner_sequence\n            iterator = iter(inner_sequence)\n            for element in iterator:\n                yield element\n        except TypeError:\n            # If not iterable, treat inner_sequence itself as a single element\n            yield inner_sequence\n\ndef _process_sequences(sequences):\n    \"\"\"\n    Orchestrates collecting elements from the top-level sequences.\n    \"\"\"\n    return _collect_elements(sequences)\n\ndef _build_result_set(iterable_of_elements):\n    \"\"\"\n    Constructs and returns a set of unique elements from the provided iterable.\n    \"\"\"\n    return set(iterable_of_elements)"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(list1: list, list2: list, list3: list) -> int:\n    \"\"\"Return the number of positions i in 0..min(len(list1),len(list2),len(list3))-1\n    where list1[i] == list2[i] == list3[i].\"\"\"\n    \n    min_length = min(len(list1), len(list2), len(list3))\n    count = 0\n    for i in range(min_length):\n        if list1[i] == list2[i] == list3[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/141", "solution": "import dataclasses\nfrom typing import Any, List, Optional\n\n@dataclasses.dataclass\nclass Element:\n    \"\"\"Wraps a language-native value.\"\"\"\n    value: Any\n\n    def isComparable(self) -> bool:\n        \"\"\"Best-effort helper for comparability. The authoritative check is performed by Validator.areElementsComparable().\"\"\"\n        try:\n            # A value should generally be comparable to itself if its type supports ordering.\n            _ = self.value < self.value\n            return True\n        except TypeError:\n            return False\n        except Exception:\n            # Catch other potential comparison issues not specifically TypeError\n            return False\n\n@dataclasses.dataclass\nclass InputList:\n    \"\"\"Holds a list of Element objects and its size.\"\"\"\n    elements: List[Element]\n\n    @property\n    def size(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.elements)\n\n@dataclasses.dataclass\nclass OutputList:\n    \"\"\"Holds a sorted list of Element objects and its size.\"\"\"\n    elements: List[Element]\n\n    @property\n    def size(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.elements)\n\nclass Validator:\n    \"\"\"Deterministic validation of mutual comparability for list elements.\"\"\"\n\n    @staticmethod\n    def areElementsComparable(input_list: List[Any]) -> bool:\n        \"\"\"\n        Accepts a list of values and returns True if all elements are mutually comparable.\n        Returns False deterministically if ordering comparisons fail (e.g., TypeError).\n        \"\"\"\n        if len(input_list) <= 1:\n            return True # Empty or single-element lists are always considered comparable.\n\n        try:\n            # Attempt to sort the list. Python's built-in sorted() will raise TypeError\n            # if elements are not mutually comparable.\n            sorted(input_list)\n            return True\n        except TypeError:\n            # If sorting raises a TypeError, elements are not mutually comparable.\n            return False\n        except Exception:\n            # Catch any other unexpected exceptions during comparison, though less likely for standard types.\n            return False\n\nclass PancakeSort:\n    \"\"\"Orchestration and core sorting logic.\"\"\"\n\n    def pancake_sort(self, input_list: List[Any]) -> List[Any]:\n        \"\"\"\n        Validates input list elements for comparability, sorts them in ascending order\n        (out-of-place), and returns a new sorted list. Raises ValueError for\n        incomparable elements.\n        \"\"\"\n        # 1. Validate comparability\n        if not Validator.areElementsComparable(input_list):\n            raise ValueError(\"incomparable elements\")\n\n        # 2. Perform sorting (out-of-place)\n        # Using Python's built-in sorted() for ascending order, as implied by the design context.\n        sorted_native_list = sorted(input_list)\n\n        # 3. Construct OutputList (internal representation, as per design)\n        # Convert native values to Element objects for internal OutputList.\n        output_elements = [Element(val) for val in sorted_native_list]\n        _ = OutputList(elements=output_elements) # The OutputList object is created but not directly returned.\n\n        # 4. Return language-native list (extract values from the \"conceptual\" OutputList.elements)\n        return sorted_native_list\n\ndef pancake_sort(input_list: List[Any]) -> List[Any]:\n    \"\"\"\n    Sorts a list of elements in non-decreasing (ascending) order.\n    Raises ValueError if elements are incomparable.\n    \"\"\"\n    return PancakeSort().pancake_sort(input_list)"}
{"task_id": "Mbpp/145", "solution": "from typing import Sequence\n\ndef max_Abs_Diff(seq: Sequence[float | int]) -> float | int:\n    \"\"\"Validate seq and return max(seq) - min(seq).\n\n    Raises:\n        TypeError: if seq is not a list or tuple.\n        ValueError: if seq has fewer than two numeric elements or contains non-numeric items.\n    \"\"\"\n    if not isinstance(seq, (list, tuple)):\n        raise TypeError(\"seq must be a list or tuple\")\n\n    if len(seq) < 2:\n        raise ValueError(\"sequence must contain at least two numeric elements\")\n\n    for element in seq:\n        if not isinstance(element, (int, float)) or type(element) is bool:\n            raise ValueError(\"all elements of seq must be int or float\")\n\n    min_val = min(seq)\n    max_val = max(seq)\n    return max_val - min_val"}
{"task_id": "Mbpp/161", "solution": "class EqualityComparator:\n    \"\"\"Encapsulates equality semantics using language's == operator.\"\"\"\n    def equals(self, a, b):\n        return a == b\n\nclass RemoveElementsFunction:\n    \"\"\"Encapsulates input validation and the filtering algorithm.\"\"\"\n    def __init__(self, source_list, remove_list):\n        self._source_list = source_list\n        self._remove_list = remove_list\n        self._result_list = []\n        self._comparator = EqualityComparator()\n\n    def validate_inputs(self):\n        \"\"\"Raises TypeError if inputs are not lists.\"\"\"\n        if not isinstance(self._source_list, list):\n            raise TypeError(\"source_list must be a list\")\n        if not isinstance(self._remove_list, list):\n            raise TypeError(\"remove_list must be a list\")\n\n    def remove_elements(self):\n        \"\"\"Executes validation and filtering, returns the new list.\"\"\"\n        self.validate_inputs()\n\n        if not self._source_list:\n            return [] # If source_list is empty, return an empty list.\n\n        if not self._remove_list:\n            # If remove_list is empty, return a new list with all elements from source_list.\n            return list(self._source_list)\n\n        for element in self._source_list:\n            is_to_be_removed = False\n            for item_to_remove in self._remove_list:\n                if self._comparator.equals(element, item_to_remove):\n                    is_to_be_removed = True\n                    break\n            if not is_to_be_removed:\n                self._result_list.append(element)\n        \n        return self._result_list\n\ndef remove_elements(source_list, remove_list):\n    \"\"\"\n    Removes all elements from source_list that are present in remove_list, \n    preserving order and returning a new list.\n    \"\"\"\n    remover = RemoveElementsFunction(source_list, remove_list)\n    return remover.remove_elements()"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum (n - 2*i) from i=0 to n // 2 using a closed-form formula.\n    Raises ValueError for non-integer or negative inputs.\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    if n == 0:\n        return 0\n\n    # Number of terms in the series: i from 0 to n // 2\n    count = n // 2 + 1\n\n    # The first term (when i=0)\n    first_term = n\n\n    # The last term (when i=n // 2)\n    last_term = n - 2 * (n // 2)\n\n    # Sum of an arithmetic series: count * (first + last) / 2\n    total_sum = count * (first_term + last_term) // 2\n\n    return total_sum"}
{"task_id": "Mbpp/165", "solution": "from typing import Optional\n\ndef _is_alpha(c: str) -> bool:\n    \"\"\"Checks if a character is an English letter (a-z or A-Z).\"\"\"\n    return 'a' <= c.lower() <= 'z'\n\ndef _alpha_pos(c: str) -> Optional[int]:\n    \"\"\"Maps an English letter to its 1-based alphabet position (1-26). Returns None for non-alphabetic characters.\"\"\"\n    if not _is_alpha(c):\n        return None\n    return ord(c.lower()) - ord('a') + 1\n\ndef count_char_position(input: str) -> int:\n    \"\"\"\n    Counts characters in a string that occur at the same position in the string\n    as in the English alphabet (case insensitive).\n    \"\"\"\n    count = 0\n    for i, char in enumerate(input):\n        string_pos = i + 1  # 1-based string position\n\n        if _is_alpha(char):\n            alpha_pos = _alpha_pos(char)\n            if alpha_pos is not None and alpha_pos == string_pos:\n                count += 1\n    return count"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n):\n    \"\"\"\n    Finds the smallest power of 2 greater than or equal to n.\n    Handles n=0 specifically to return 1.\n    \"\"\"\n    if n == 0:\n        return 1\n    \n    power = 1\n    while power < n:\n        power *= 2\n    return power"}
{"task_id": "Mbpp/160", "solution": "def find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"Return (x,y) integers satisfying a*x + b*y == n, or None if no solution exists.\"\"\"\n\n    def extended_gcd_impl(a_val: int, b_val: int) -> tuple[int, int, int]:\n        # Returns (g, x, y) such that a_val*x + b_val*y = g and g = gcd(|a_val|,|b_val|) >= 0.\n        # Computes x, y for the original signed a_val, b_val.\n\n        if a_val == 0 and b_val == 0:\n            return 0, 0, 0\n\n        a_orig = a_val\n        b_orig = b_val\n        \n        # Work with absolute values to compute gcd, ensuring 'g' is positive.\n        a_abs = abs(a_val)\n        b_abs = abs(b_val)\n\n        x_prev, y_prev = 1, 0\n        x_curr, y_curr = 0, 1\n        \n        while b_abs != 0:\n            q = a_abs // b_abs\n            a_abs, b_abs = b_abs, a_abs % b_abs\n            x_prev, x_curr = x_curr, x_prev - q * x_curr\n            y_prev, y_curr = y_curr, y_prev - q * y_curr\n        \n        g = a_abs # g is the GCD, always positive.\n        \n        # Adjust x_prev and y_prev for the signs of original a_val and b_val.\n        # x_prev and y_prev satisfy abs(a_orig)*x_prev + abs(b_orig)*y_prev = g.\n        # We need a_orig*x + b_orig*y = g.\n        x_final = x_prev\n        y_final = y_prev\n\n        if a_orig < 0:\n            x_final = -x_final\n        if b_orig < 0:\n            y_final = -y_final\n            \n        return g, x_final, y_final\n\n    # --- find_solution main logic ---\n\n    # Handle special case where both coefficients are zero\n    if a == 0 and b == 0:\n        if n == 0:\n            return (0, 0)\n        else:\n            return None\n\n    # Calculate g = gcd(|a|, |b|) and a particular solution (x0, y0) for a*x0 + b*y0 = g\n    g, x0, y0 = extended_gcd_impl(a, b)\n\n    # Check for solvability: n must be divisible by g\n    if n % g != 0:\n        return None\n\n    # Scale the particular solution (x0, y0) to satisfy a*x + b*y = n\n    factor = n // g\n    x_particular = x0 * factor\n    y_particular = y0 * factor\n\n    # Adjust the solution to a canonical range (e.g., 0 <= x < abs(b/g))\n    # This ensures a consistent result when multiple solutions exist, fulfilling FR-5.\n    \n    # Adjustment is only meaningful if 'b' is not zero, as 'x' depends on (b/g).\n    # If b is zero, x_particular is the unique solution for x, and y_particular is 0.\n    if b != 0:\n        b_prime = b // g # The period for x, can be positive or negative\n        abs_b_prime = abs(b_prime)\n        \n        # Calculate x_candidate such that 0 <= x_candidate < abs_b_prime\n        x_candidate = x_particular % abs_b_prime\n        \n        # Calculate 'k' to shift x_particular to x_candidate\n        # This formula works correctly for both positive and negative b_prime\n        k = (x_candidate - x_particular) // b_prime\n        \n        x_final = x_particular + k * b_prime\n        y_final = y_particular - k * (a // g) # 'a // g' is the period for y\n        \n        return (x_final, y_final)\n    else:\n        # If b is 0, then a must be non-zero (handled by initial check).\n        # x_particular = n // a is the unique x value, y_particular = 0.\n        return (x_particular, y_particular)"}
{"task_id": "Mbpp/166", "solution": "def _combination2(n: int) -> int:\n    \"\"\"Computes 'n choose 2', which is the number of ways to choose 2 items from n.\n    Returns 0 if n is less than 2.\n    \"\"\"\n    if n < 2:\n        return 0\n    return n * (n - 1) // 2\n\nclass FindEvenPairService:\n    \"\"\"Stateless service that computes the count of unordered pairs with even XOR.\"\"\"\n\n    def countPairsByParity(self, lst) -> int:\n        \"\"\"Counts parity frequencies and returns C(n_even,2) + C(n_odd,2).\"\"\"\n        if len(lst) < 2:\n            return 0\n\n        n_even = 0\n        n_odd = 0\n        for num in lst:\n            if num % 2 == 0:\n                n_even += 1\n            else:\n                n_odd += 1\n\n        return _combination2(n_even) + _combination2(n_odd)\n\ndef find_even_pair(lst):\n    \"\"\"Counts the number of pairs of integers in a list that xor to an even number.\"\"\"\n    if len(lst) < 2:\n        return 0\n\n    service = FindEvenPairService()\n    return service.countPairsByParity(lst)"}
{"task_id": "Mbpp/168", "solution": "from typing import Any\n\ndef frequency(list: list[Any], value: Any) -> int:\n    \"\"\"Return the number of times `value` occurs in `list`.\n    Contract: do not modify `list`; run-time complexity O(n); deterministic.\n    \"\"\"\n    counter = 0\n    for elem in list:\n        if elem == value:\n            counter += 1\n    return counter"}
{"task_id": "Mbpp/171", "solution": "def perimeter_pentagon(side_length):\n    \"\"\"\n    Calculates the perimeter of a regular pentagon given its side length.\n    Raises TypeError if side_length is not a numeric type.\n    \"\"\"\n    if not isinstance(side_length, (int, float)):\n        raise TypeError(\"side_length must be numeric\")\n    \n    return 5 * side_length"}
{"task_id": "Mbpp/172", "solution": "class StringInput:\n    \"\"\"Represents the input string for occurrence counting.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def isValid(self) -> bool:\n        \"\"\"Checks if the stored value is a valid string.\"\"\"\n        return isinstance(self.value, str)\n\nclass SubstringMatcher:\n    \"\"\"Matches and counts non-overlapping occurrences of a pattern in a string.\"\"\"\n    def __init__(self, pattern: str = \"std\") -> None:\n        self.pattern = pattern\n\n    def countOccurrences(self, input_obj: StringInput) -> int:\n        \"\"\"Counts non-overlapping literal occurrences of the pattern.\"\"\"\n        count = 0\n        start_index = 0\n        input_value = input_obj.value\n        pattern_length = len(self.pattern)\n\n        while True:\n            index = input_value.find(self.pattern, start_index)\n            if index == -1:\n                break\n            count += 1\n            start_index = index + pattern_length\n        return count\n\nPATTERN: str = \"std\"\n\ndef count_occurance(input_str: str) -> int:\n    \"\"\"\n    Counts the number of non-overlapping occurrences of the string 'std' in a given string.\n    Raises TypeError if the input is not a string.\n    \"\"\"\n    if not isinstance(input_str, str):\n        raise TypeError(\"input must be a string\")\n\n    string_input = StringInput(input_str)\n    matcher = SubstringMatcher(PATTERN)\n    return matcher.countOccurrences(string_input)"}
{"task_id": "Mbpp/170", "solution": "class ValidationError(Exception):\n    \"\"\"\n    Represents a descriptive validation failure with code and message.\n    Raised on invalid input to sum_range_list.\n    \"\"\"\n    def __init__(self, code: str, message: str):\n        self.code = code\n        self.message = message\n        super().__init__(f\"{code}: {message}\")\n\n    def __str__(self) -> str:\n        return f\"{self.code}: {self.message}\"\n\nclass NumberList:\n    \"\"\"\n    Represents an ordered collection of numeric elements.\n    Provides basic list operations like length.\n    \"\"\"\n    def __init__(self, elements: list):\n        self.elements = elements\n\n    def length(self) -> int:\n        return len(self.elements)\n\nclass IndexRange:\n    \"\"\"\n    Encapsulates start and end indices for a range.\n    By default, assumes zero-based indexing.\n    \"\"\"\n    def __init__(self, start: int, end: int, isZeroBased: bool = True):\n        self.start = start\n        self.end = end\n        self.isZeroBased = isZeroBased\n\nclass SumResult:\n    \"\"\"\n    A container for a numeric result value.\n    Not directly used as return type for sum_range_list, but part of domain model.\n    \"\"\"\n    def __init__(self, value: float):\n        self.value = value\n\nclass SumRangeFunction:\n    \"\"\"\n    Validates inputs and computes the inclusive sum for a NumberList and IndexRange.\n    This class is stateless.\n    \"\"\"\n    def calculate(self, number_list: NumberList, index_range: IndexRange) -> float:\n        \"\"\"\n        Calculates the sum of elements within the specified range (inclusive).\n        Validates all inputs before computation.\n        \"\"\"\n        self.validateInputs(number_list, index_range)\n\n        total_sum = 0.0\n        for i in range(index_range.start, index_range.end + 1):\n            total_sum += number_list.elements[i]\n        return total_sum\n\n    def validateInputs(self, number_list: NumberList, index_range: IndexRange) -> None:\n        \"\"\"\n        Performs index type checks, bounds checks, ordering checks, and numeric element checks.\n        Raises ValidationError on failure.\n        \"\"\"\n        if not isinstance(index_range.start, int) or not isinstance(index_range.end, int):\n            raise ValidationError(\n                code=\"INVALID_INDEX_TYPE\",\n                message=f\"Start and end indices must be integers. Got start={type(index_range.start).__name__}, end={type(index_range.end).__name__}.\"\n            )\n\n        list_len = number_list.length()\n\n        if index_range.start > index_range.end:\n            raise ValidationError(\n                code=\"START_GREATER_THAN_END\",\n                message=f\"Start index ({index_range.start}) cannot be greater than end index ({index_range.end}).\"\n            )\n\n        if not (0 <= index_range.start and index_range.end < list_len):\n            raise ValidationError(\n                code=\"INDEX_OUT_OF_BOUNDS\",\n                message=f\"Indices ({index_range.start}, {index_range.end}) are out of bounds for list of length {list_len}.\"\n            )\n\n        for i in range(index_range.start, index_range.end + 1):\n            element = number_list.elements[i]\n            if not isinstance(element, (int, float)):\n                raise ValidationError(\n                    code=\"NON_NUMERIC_ELEMENT\",\n                    message=f\"Element at index {i} is not numeric. Got type {type(element).__name__} with value '{element}'.\"\n                )\n\ndef sum_range_list(list, start, end):\n    \"\"\"\n    Calculates the sum of numbers in a list within a specified range (inclusive).\n    Validates indices and element types, raising ValidationError on invalid input.\n    \"\"\"\n    number_list = NumberList(elements=list)\n    index_range = IndexRange(start=start, end=end)\n    sum_function = SumRangeFunction()\n    return sum_function.calculate(number_list, index_range)"}
{"task_id": "Mbpp/222", "solution": "def check_type(tuple_arg):\n    \"\"\"\n    Checks if all elements in a tuple have the same data type.\n    Handles empty tuples by returning True as there are no differing types.\n    \"\"\"\n    if not tuple_arg:\n        return True\n\n    first_type = type(tuple_arg[0])\n    for element in tuple_arg:\n        if type(element) != first_type:\n            return False\n    return True"}
{"task_id": "Mbpp/223", "solution": "def _first_occurrence(array, n, element) -> int:\n    \"\"\"Returns leftmost index of element within indices [0, min(n, len(array)) - 1], or -1 if not found.\"\"\"\n    low = 0\n    search_limit = min(n, len(array))\n    high = search_limit - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == element:\n            result = mid\n            high = mid - 1  # Search in the left half for an earlier occurrence\n        elif array[mid] < element:\n            low = mid + 1\n        else: # array[mid] > element\n            high = mid - 1\n    return result\n\ndef _last_occurrence(array, n, element) -> int:\n    \"\"\"Returns rightmost index of element within indices [0, min(n, len(array)) - 1], or -1 if not found.\"\"\"\n    low = 0\n    search_limit = min(n, len(array))\n    high = search_limit - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == element:\n            result = mid\n            low = mid + 1  # Search in the right half for a later occurrence\n        elif array[mid] < element:\n            low = mid + 1\n        else: # array[mid] > element\n            high = mid - 1\n    return result\n\ndef is_majority(array, n, element) -> bool:\n    \"\"\"Return True iff element occurs more than n/2 times among the first n elements of array.\n    Precondition: array is sorted (non-decreasing). Uses provided n as authoritative threshold numerator.\n    \"\"\"\n    first_idx = _first_occurrence(array, n, element)\n\n    if first_idx == -1:\n        return False\n\n    last_idx = _last_occurrence(array, n, element)\n    \n    count = last_idx - first_idx + 1\n    return count > n / 2"}
