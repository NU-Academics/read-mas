{"task_id": "Mbpp/129", "solution": "class NumericElement:\n    \"\"\"Represents a numeric element (int or float) in the matrix.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\nclass Matrix:\n    \"\"\"A read-only wrapper around a nested list matrix providing dimension and element access.\"\"\"\n    def __init__(self, elements: list) -> None:\n        self.elements = elements\n        self._n_rows = len(elements) if isinstance(elements, list) else 0\n        self._n_cols = 0\n        if self._n_rows > 0 and isinstance(elements[0], list):\n            self._n_cols = len(elements[0])\n\n    def rows(self) -> int:\n        \"\"\"Returns the number of rows in the matrix.\"\"\"\n        return self._n_rows\n\n    def cols(self) -> int:\n        \"\"\"Returns the number of columns in the matrix.\"\"\"\n        return self._n_cols\n\n    def get(self, i: int, j: int):\n        \"\"\"Returns the element at the specified row and column.\"\"\"\n        return self.elements[i][j]\n\nclass MagicSquareChecker:\n    \"\"\"Encapsulates logic for validating and checking magic square properties.\"\"\"\n\n    def validate(self, matrix: Matrix) -> bool:\n        \"\"\"\n        Validates if the input matrix is a non-empty, square matrix with numeric elements.\n        Returns False if the matrix is empty, non-square, ragged, or contains non-numeric elements.\n        \"\"\"\n        n_rows = matrix.rows()\n        n_cols = matrix.cols()\n\n        if n_rows == 0 or n_cols == 0:\n            return False\n\n        if n_rows != n_cols:\n            return False\n        \n        for i in range(n_rows):\n            current_row = matrix.elements[i] # Direct access for structural checks\n            if not isinstance(current_row, list) or len(current_row) != n_cols:\n                return False\n\n            for j in range(n_cols):\n                element = current_row[j]\n                if not isinstance(element, (int, float)):\n                    return False\n        \n        return True\n\n    def compute_row_sum(self, matrix: Matrix, row_idx: int):\n        \"\"\"Computes the sum of elements in a specific row.\"\"\"\n        current_sum = 0\n        n_cols = matrix.cols()\n        for j in range(n_cols):\n            current_sum += matrix.get(row_idx, j)\n        return current_sum\n\n    def compute_col_sum(self, matrix: Matrix, col_idx: int):\n        \"\"\"Computes the sum of elements in a specific column.\"\"\"\n        current_sum = 0\n        n_rows = matrix.rows()\n        for i in range(n_rows):\n            current_sum += matrix.get(i, col_idx)\n        return current_sum\n\n    def compute_diagonals(self, matrix: Matrix) -> tuple:\n        \"\"\"Computes the sums of the main and anti-diagonals.\"\"\"\n        main_diag_sum = 0\n        anti_diag_sum = 0\n        n = matrix.rows()\n        for i in range(n):\n            main_diag_sum += matrix.get(i, i)\n            anti_diag_sum += matrix.get(i, n - 1 - i)\n        return (main_diag_sum, anti_diag_sum)\n\n    def compare_sums(self, matrix: Matrix, target_sum) -> bool:\n        \"\"\"\n        Compares all row, column, and diagonal sums against a target_sum.\n        Returns True if all sums are equal to the target_sum, False otherwise.\n        \"\"\"\n        n = matrix.rows()\n\n        for i in range(n):\n            if self.compute_row_sum(matrix, i) != target_sum:\n                return False\n\n        for j in range(n):\n            if self.compute_col_sum(matrix, j) != target_sum:\n                return False\n\n        main_diag_sum, anti_diag_sum = self.compute_diagonals(matrix)\n        if main_diag_sum != target_sum or anti_diag_sum != target_sum:\n            return False\n\n        return True\n\ndef magic_square_test(matrix) -> bool:\n    \"\"\"\n    Checks if the given matrix (nested list of numbers) is a magic square.\n    Returns False for empty, non-square, or non-numeric matrices.\n    \"\"\"\n    matrix_obj = Matrix(matrix)\n    checker = MagicSquareChecker()\n\n    if not checker.validate(matrix_obj):\n        return False\n    \n    target_sum = checker.compute_row_sum(matrix_obj, 0)\n    \n    return checker.compare_sums(matrix_obj, target_sum)"}
{"task_id": "Mbpp/131", "solution": "from typing import FrozenSet\n\nVOWEL_SET: FrozenSet[str] = frozenset({'a','e','i','o','u','A','E','I','O','U'})\n\ndef is_vowel(c: str) -> bool:\n    \"\"\"Return True if c is a vowel according to VOWEL_SET.\"\"\"\n    if len(c) != 1:\n        return False\n    return c in VOWEL_SET\n\ndef reverse_vowels(input: str) -> str:\n    \"\"\"Return a new string with vowels reversed per SRS (FR1..FR5).\"\"\"\n    char_list = list(input)\n    \n    vowel_indices = []\n    vowel_chars = []\n    \n    for i, char in enumerate(char_list):\n        if is_vowel(char):\n            vowel_indices.append(i)\n            vowel_chars.append(char)\n            \n    if len(vowel_chars) <= 1:\n        return input\n        \n    vowel_chars.reverse()\n    \n    for i, original_idx in enumerate(vowel_indices):\n        char_list[original_idx] = vowel_chars[i]\n        \n    return \"\".join(char_list)"}
{"task_id": "Mbpp/133", "solution": "from dataclasses import dataclass\nfrom typing import List, Union\n\n@dataclass\nclass Number:\n    value: float\n\n    def is_negative(self) -> bool:\n        \"\"\"Returns True if the number's value is strictly less than 0.\"\"\"\n        return self.value < 0\n\n@dataclass\nclass NumberList:\n    numbers: List[Number]\n\n@dataclass\nclass SumResult:\n    total: float\n\nclass SumNegativeNumFunction:\n    def sum_negativenum(self, numbers: 'NumberList') -> 'SumResult':\n        \"\"\"Computes the sum of strictly negative Number values in a NumberList.\"\"\"\n        running_total = 0.0\n        for num in numbers.numbers:\n            if num.is_negative():\n                running_total += num.value\n        return SumResult(total=running_total)\n\ndef sum_negativenum(numbers: list) -> float:\n    \"\"\"\n    Calculates the sum of the negative numbers of a given list of numbers.\n\n    Validates input, converts to internal domain objects, and delegates calculation.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input 'numbers' must be a list.\")\n\n    number_objects: List[Number] = []\n    for item in numbers:\n        if not isinstance(item, (int, float)):\n            raise TypeError(\"All elements in the list must be numeric (int or float).\")\n        number_objects.append(Number(float(item)))\n\n    number_list = NumberList(numbers=number_objects)\n    calculator = SumNegativeNumFunction()\n    result = calculator.sum_negativenum(number_list)\n    return result.total"}
{"task_id": "Mbpp/135", "solution": "class ValidationError(Exception):\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass InputParameter:\n    def __init__(self, value):\n        self.value = value\n\n    def isInteger(self) -> bool:\n        return isinstance(self.value, int)\n\n    def isPositive(self) -> bool:\n        return self.value >= 1\n\nclass Validator:\n    def validate(self, n) -> None:\n        \"\"\"\n        Validates that n is an integer >= 1, raising ValidationError if not.\n        \"\"\"\n        param = InputParameter(n)\n        if not param.isInteger():\n            raise ValidationError(\"Input must be an integer.\")\n        if not param.isPositive():\n            raise ValidationError(\"Input must be a positive integer (n >= 1).\")\n\nclass HexagonalNumberFunction:\n    def compute(self, n: int) -> int:\n        \"\"\"\n        Computes the nth hexagonal number using the formula n * (2 * n - 1).\n        \"\"\"\n        return n * (2 * n - 1)\n\ndef hexagonal_num(n) -> int:\n    \"\"\"\n    Finds the nth hexagonal number after validating the input.\n    \"\"\"\n    Validator().validate(n)\n    return HexagonalNumberFunction().compute(n)"}
{"task_id": "Mbpp/137", "solution": "from typing import List\nfrom dataclasses import dataclass\n\n@dataclass\nclass InputArray:\n    values: List[int]\n    length: int\n\n@dataclass\nclass Counter:\n    zeroCount: int\n    nonZeroCount: int\n\n@dataclass\nclass Result:\n    ratio: float\n\n@dataclass\nclass ErrorCondition:\n    code: str\n    message: str\n\nclass ZeroCountFunction:\n    def _countZeros(self, values: List[int]) -> int:\n        \"\"\"Counts the number of zero elements in a list of integers.\"\"\"\n        count = 0\n        for x in values:\n            if x == 0:\n                count += 1\n        return count\n\n    def _countNonZeros(self, values: List[int]) -> int:\n        \"\"\"Counts the number of non-zero elements in a list of integers.\"\"\"\n        count = 0\n        for x in values:\n            if x != 0:\n                count += 1\n        return count\n\n    def compute(self, values: List[int]) -> float:\n        \"\"\"Computes the ratio of zeros to non-zeros, handling error conditions.\"\"\"\n        if not values:\n            error_condition = ErrorCondition(code=\"EMPTY_INPUT\", message=\"Input array cannot be empty.\")\n            raise ValueError(error_condition.message)\n\n        zero_count = self._countZeros(values)\n        non_zero_count = self._countNonZeros(values)\n\n        if non_zero_count == 0:\n            error_condition = ErrorCondition(code=\"NO_NON_ZEROS\", message=\"Cannot compute ratio: no non-zero elements found.\")\n            raise ValueError(error_condition.message)\n\n        return float(zero_count) / float(non_zero_count)\n\ndef zero_count(values: List[int]) -> float:\n    \"\"\"Calculates the ratio of zeroes to non-zeroes in a list of integers.\"\"\"\n    calculator = ZeroCountFunction()\n    return calculator.compute(values)"}
