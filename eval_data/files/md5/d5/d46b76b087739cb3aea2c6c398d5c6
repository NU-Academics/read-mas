{"task_id": "Mbpp/786", "solution": "import collections.abc\nimport sys\n\n# Define Comparator Protocol and default_comparator inline as per instructions\nif sys.version_info >= (3, 8):\n    from typing import Protocol\nelse:\n    from typing import TypeVar, Any, Callable\n    Protocol = object\n\nif sys.version_info >= (3, 8):\n    class Comparator(Protocol):\n        def compare(self, a: Any, b: Any) -> int: ...\nelse:\n    # A simplified stand-in for older Python versions\n    class Comparator:\n        def compare(self, a: Any, b: Any) -> int:\n            raise NotImplementedError\n\n\ndef default_comparator(a: Any, b: Any) -> int:\n    \"\"\"Compares two elements, returning -1 if a < b, 0 if a == b, and 1 if a > b.\"\"\"\n    if a < b:\n        return -1\n    elif a == b:\n        return 0\n    else:\n        return 1\n\n# No SequenceModel or InsertionResult classes needed for this specific completion;\n# the design context indicates they are \"internal helpers\" that are not\n# strictly required to be exposed or fully implemented if only the top-level\n# function is requested. The binary search can directly use sequence indexing.\n\n\ndef right_insertion(sequence: collections.abc.Sequence, value: Any) -> int:\n    \"\"\"\n    Locates the right insertion point for a specified value in sorted order using binary search.\n    Returns an index such that all elements up to this index are less than or equal to the value.\n    \"\"\"\n    lo = 0\n    hi = len(sequence)\n    compare = default_comparator\n\n    while lo < hi:\n        mid = (lo + hi) // 2\n        if compare(value, sequence[mid]) < 0:  # value < sequence[mid]\n            hi = mid\n        else:  # value >= sequence[mid]\n            lo = mid + 1\n    return lo"}
{"task_id": "Mbpp/790", "solution": "class Element:\n    def __init__(self, index: int, value) -> None:\n        self.index = index\n        self.value = value\n\n    def is_even(self) -> bool:\n        \"\"\"\n        Checks if the element's value is an integer and is even.\n        Returns True if value is an int and value % 2 == 0; otherwise False.\n        \"\"\"\n        return isinstance(self.value, int) and self.value % 2 == 0\n\nclass Result:\n    def __init__(self, is_all_even: bool) -> None:\n        self.is_all_even = is_all_even\n\n\ndef even_position(input_list) -> bool:\n    \"\"\"\n    Checks whether every even index contains even numbers of a given list.\n    Returns False if the input is not a list, or if any even-indexed element is not an even integer.\n    \"\"\"\n    if not isinstance(input_list, list):\n        return False\n\n    for i in range(0, len(input_list), 2):\n        element = Element(i, input_list[i])\n        if not element.is_even():\n            return False\n\n    return Result(True).is_all_even"}
