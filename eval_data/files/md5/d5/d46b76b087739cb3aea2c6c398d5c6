{"task_id": "Mbpp/61", "solution": "from typing import List\n\nclass Substring:\n    \"\"\"Represents a contiguous substring with its properties.\"\"\"\n    def __init__(self, start: int, end: int, content: str):\n        self.start = start\n        self.end = end\n        self.content = content\n        self.length = end - start\n        self.digit_sum = 0 # Will be computed later\n\n    def matches(self) -> bool:\n        \"\"\"Checks if the sum of digits equals the substring's length.\"\"\"\n        return self.digit_sum == self.length\n\nclass Digit:\n    \"\"\"Lightweight holder for a single digit value and its position.\"\"\"\n    def __init__(self, value: int, position: int):\n        self.value = value\n        self.position = position\n\nclass SubstringEvaluator:\n    \"\"\"Handles validation, substring generation, digit sum computation, and counting.\"\"\"\n    def isValidInput(self, input_string: str) -> bool:\n        \"\"\"Checks if the input string contains only decimal digit characters.\"\"\"\n        return input_string.isdigit()\n\n    def generateSubstrings(self, input_string: str) -> List[Substring]:\n        \"\"\"Deterministically generates all contiguous substrings of the input string.\"\"\"\n        n = len(input_string)\n        substrings = []\n        for start in range(n):\n            for end in range(start + 1, n + 1):\n                substrings.append(Substring(start, end, input_string[start:end]))\n        return substrings\n\n    def computeDigitSum(self, substring: Substring) -> int:\n        \"\"\"Computes the sum of digits for a given substring and updates its digit_sum.\"\"\"\n        substring.digit_sum = sum(int(char) for char in substring.content)\n        return substring.digit_sum\n\n    def count_Substrings(self, input_string: str) -> int:\n        \"\"\"Counts substrings where the sum of digits equals their length.\"\"\"\n        count = 0\n        substrings = self.generateSubstrings(input_string)\n        for sub in substrings:\n            self.computeDigitSum(sub)\n            if sub.matches():\n                count += 1\n        return count\n\ndef count_Substrings(input_string: str) -> int:\n    \"\"\"\n    Counts the number of substrings in the input_string where the sum of\n    their digits equals their length.\n    \"\"\"\n    evaluator = SubstringEvaluator()\n    if not evaluator.isValidInput(input_string):\n        raise ValueError(\"input_string must contain only decimal digit characters (0-9)\")\n    return evaluator.count_Substrings(input_string)"}
