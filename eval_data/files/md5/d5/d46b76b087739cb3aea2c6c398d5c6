{"task_id": "Mbpp/255", "solution": "import itertools\n\nclass Validator:\n    \"\"\"Validates inputs for combinations_colors function.\"\"\"\n    def validate_input(self, input_list, n):\n        \"\"\"Return True if inputs valid; otherwise raise TypeError/ValueError.\"\"\"\n        if not isinstance(input_list, (list, tuple, set)):\n            raise TypeError(\"input_list must be a list, tuple, or set.\")\n        if not isinstance(n, int):\n            raise TypeError(\"n must be an integer.\")\n        if n < 1:\n            raise ValueError(\"n must be an integer >= 1.\")\n        return True\n\nclass CombinationGenerator:\n    \"\"\"Generates combinations with repetition.\"\"\"\n    def generate(self, input_list, n):\n        \"\"\"Return list of tuples representing all combinations with repetition.\"\"\"\n        if not input_list:\n            return []\n        \n        return list(itertools.product(input_list, repeat=n))\n\ndef combinations_colors(input_list, n):\n    \"\"\"Public API. Returns a Python list of Python tuple objects.\"\"\"\n    validator = Validator()\n    validator.validate_input(input_list, n)\n\n    generator = CombinationGenerator()\n    return generator.generate(input_list, n)"}
{"task_id": "Mbpp/259", "solution": "from typing import Tuple, Any\n\nclass Validator:\n    \"\"\"\n    Validates input tuples for structure and element types, raising ValueError on failure.\n    \"\"\"\n    def validate(self, input1: tuple, input2: tuple) -> None:\n        \"\"\"\n        Ensures both inputs are tuples, have equal length,\n        contain inner tuples of equal length, and all elements are numeric.\n        \"\"\"\n        if not isinstance(input1, tuple) or not isinstance(input2, tuple):\n            raise ValueError(\"Both inputs must be top-level tuples.\")\n\n        if len(input1) != len(input2):\n            raise ValueError(\"Top-level tuples must have equal length.\")\n\n        for i in range(len(input1)):\n            inner1 = input1[i]\n            inner2 = input2[i]\n\n            if not isinstance(inner1, tuple) or not isinstance(inner2, tuple):\n                raise ValueError(f\"Elements at index {i} must be inner tuples.\")\n\n            if len(inner1) != len(inner2):\n                raise ValueError(f\"Inner tuples at index {i} must have equal length.\")\n\n            for j in range(len(inner1)):\n                val1 = inner1[j]\n                val2 = inner2[j]\n\n                if not isinstance(val1, (int, float)) or not isinstance(val2, (int, float)):\n                    raise ValueError(f\"Elements at [{i}][{j}] must be numeric (int or float).\")\n\nclass MaxOperator:\n    \"\"\"\n    Provides a method to find the maximum of two comparable values.\n    \"\"\"\n    def max(self, a: Any, b: Any) -> Any:\n        \"\"\"Returns the larger of two values using native comparison.\"\"\"\n        return a if a >= b else b\n\nclass MaximizeElements:\n    \"\"\"\n    Orchestrates the validation and element-wise maximization of two tuples.\n    \"\"\"\n    def __init__(self, validator: Validator = None, max_operator: MaxOperator = None):\n        \"\"\"Initializes with optional validator and max_operator instances.\"\"\"\n        self._validator = validator if validator is not None else Validator()\n        self._max_operator = max_operator if max_operator is not None else MaxOperator()\n\n    def execute(self, input1: tuple, input2: tuple) -> tuple:\n        \"\"\"\n        Validates inputs and computes element-wise maxima, returning a new tuple.\n        \"\"\"\n        self._validator.validate(input1, input2)\n\n        result_inner_tuples = []\n        for inner1, inner2 in zip(input1, input2):\n            current_inner_result = []\n            for val1, val2 in zip(inner1, inner2):\n                current_inner_result.append(self._max_operator.max(val1, val2))\n            result_inner_tuples.append(tuple(current_inner_result))\n\n        return tuple(result_inner_tuples)\n\ndef maximize_elements(input1: tuple, input2: tuple) -> tuple:\n    \"\"\"\n    Maximizes elements of two tuples by comparing corresponding numeric values.\n    Raises ValueError for input type or structure mismatches.\n    \"\"\"\n    return MaximizeElements().execute(input1, input2)"}
{"task_id": "Mbpp/260", "solution": "import math\n\nclass InvalidInputError(ValueError):\n    \"\"\"\n    Exception raised for invalid input to the newman_prime function.\n    Subclasses ValueError.\n    \"\"\"\n    pass\n\nclass InputValidator:\n    \"\"\"\n    Validates input for the newman_prime function, ensuring it's an integer >= 1.\n    Raises InvalidInputError for invalid inputs.\n    \"\"\"\n    def validate_n(self, n):\n        if not isinstance(n, int):\n            raise InvalidInputError(\"Input 'n' must be an integer.\")\n        if n < 1:\n            raise InvalidInputError(\"Input 'n' must be a positive integer (>= 1).\")\n\nclass NSWNumber:\n    \"\"\"\n    Data holder for a Newman\u2013Shanks\u2013Williams sequence member with primality status.\n    \"\"\"\n    def __init__(self, index: int, value: int, is_prime: bool = False):\n        self.index = index\n        self.value = value\n        self.is_prime = is_prime\n\nclass Request:\n    \"\"\"\n    Data holder for the input request to the NSWPrimeService.\n    \"\"\"\n    def __init__(self, n: int):\n        self.n = n\n\nclass Response:\n    \"\"\"\n    Data holder for the response from the NSWPrimeService.\n    \"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass NSWSequenceGenerator:\n    \"\"\"\n    Generates Newman\u2013Shanks\u2013Williams sequence members incrementally.\n    \"\"\"\n    def __init__(self):\n        self._sequence = {0: 1, 1: 1}\n        self._current_index = 0\n\n    def next(self) -> NSWNumber:\n        \"\"\"\n        Generates and returns the next Newman\u2013Shanks\u2013Williams number as an NSWNumber object.\n        \"\"\"\n        index_to_generate = self._current_index\n        self._current_index += 1\n\n        if index_to_generate in self._sequence:\n            return NSWNumber(index_to_generate, self._sequence[index_to_generate])\n\n        s_k_minus_1 = self._sequence[index_to_generate - 1]\n        s_k_minus_2 = self._sequence[index_to_generate - 2]\n        s_k = 2 * s_k_minus_1 + s_k_minus_2\n        self._sequence[index_to_generate] = s_k\n        return NSWNumber(index_to_generate, s_k)\n\nclass PrimeChecker:\n    \"\"\"\n    Checks if a given number is prime using a deterministic primality test.\n    \"\"\"\n    def is_prime(self, x: int) -> bool:\n        \"\"\"\n        Determines if a number is prime using a deterministic test.\n        \"\"\"\n        if x < 2:\n            return False\n        if x == 2 or x == 3:\n            return True\n        if x % 2 == 0 or x % 3 == 0:\n            return False\n        i = 5\n        while i * i <= x:\n            if x % i == 0 or x % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\nclass NSWPrimeService:\n    \"\"\"\n    Orchestrates finding the nth Newman\u2013Shanks\u2013Williams prime number.\n    Coordinates sequence generation, primality checking, and input validation.\n    \"\"\"\n    def __init__(self):\n        self._sequence_generator = NSWSequenceGenerator()\n        self._prime_checker = PrimeChecker()\n        # InputValidator instance for architectural consistency, though primary validation\n        # is handled by the top-level newman_prime function.\n        self._input_validator = InputValidator() \n\n    def newman_prime(self, n: int) -> Response:\n        \"\"\"\n        Finds the nth Newman\u2013Shanks\u2013Williams prime number.\n        Assumes n has already been validated by the top-level API.\n        \"\"\"\n        primes_found_count = 0\n        nsw_prime_value = None\n\n        current_nsw_number = None\n        while primes_found_count < n:\n            current_nsw_number = self._sequence_generator.next()\n            if self._prime_checker.is_prime(current_nsw_number.value):\n                primes_found_count += 1\n                nsw_prime_value = current_nsw_number.value\n        \n        return Response(value=nsw_prime_value)\n\ndef newman_prime(n: int) -> int:\n    \"\"\"\n    Finds the nth Newman\u2013Shanks\u2013Williams prime number.\n    Validates input and delegates to NSWPrimeService.\n    \"\"\"\n    validator = InputValidator()\n    validator.validate_n(n)\n\n    service = NSWPrimeService()\n    response = service.newman_prime(n)\n    return response.value"}
{"task_id": "Mbpp/261", "solution": "class ValidationError(Exception):\n    def __init__(self, message: str):\n        super().__init__(message)\n\ndef division_elements(a: tuple, b: tuple) -> tuple:\n    \"\"\"Compute element-wise division of two tuples. Validates inputs for types, length, numeric elements, and non-zero divisors, raising specific exceptions on failure.\"\"\"\n    if not isinstance(a, tuple) or not isinstance(b, tuple):\n        raise TypeError(\"Both inputs must be tuples\")\n    if len(a) != len(b):\n        raise ValueError(\"Input tuples must have the same length\")\n    results = []\n    for idx, (va, vb) in enumerate(zip(a, b)):\n        if not isinstance(va, (int, float)) or not isinstance(vb, (int, float)):\n            raise TypeError(f\"Tuple elements must be numeric at index {idx}\")\n        if vb == 0:\n            raise ZeroDivisionError(f\"Division by zero at index {idx}\")\n        results.append(va / vb)\n    return tuple(results)"}
