{"task_id": "Mbpp/93", "solution": "from typing import Union\n\nclass NumericInput:\n    \"\"\"A value-object wrapper for an operand and its type metadata.\"\"\"\n    def __init__(self, value: Union[int, float]):\n        self._value = float(value)\n        self._type = type(value).__name__\n\n    def value(self) -> float:\n        return self._value\n\n    def type(self) -> str:\n        return self._type\n\nclass Result:\n    \"\"\"Encapsulates the numeric result.\"\"\"\n    def __init__(self, value: float):\n        self._value = float(value)\n\n    def value(self) -> float:\n        return self._value\n\nclass PowerFunction:\n    \"\"\"Encapsulates validation and computation for exponentiation.\"\"\"\n    def validateInputs(self, a: Union[int, float], b: Union[int, float]) -> bool:\n        \"\"\"Returns True if both a and b are numeric (int or float); False otherwise.\"\"\"\n        return isinstance(a, (int, float)) and isinstance(b, (int, float))\n\n    def compute(self, a: Union[int, float], b: Union[int, float]) -> float:\n        \"\"\"Computes and returns a ** b.\"\"\"\n        return float(a ** b)\n\ndef power(a, b) -> float:\n    \"\"\"Calculates the value of 'a' to the power 'b'.\"\"\"\n    pf = PowerFunction()\n    if not pf.validateInputs(a, b):\n        raise TypeError(\"Inputs must be numeric\")\n    result = pf.compute(a, b)\n    return result"}
{"task_id": "Mbpp/92", "solution": "from typing import List\n\nclass NumberInput:\n    \"\"\"Represents an input integer and provides its canonical base-10 digit representation.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def get_digits(self) -> 'DigitSequence':\n        \"\"\"Converts the integer value into a sequence of its decimal digits.\"\"\"\n        digits_str = str(self.value)\n        digits_list = [int(ch) for ch in digits_str]\n        return DigitSequence(digits_list)\n\nclass DigitSequence:\n    \"\"\"Holds a list of digits (most-significant at index 0) and provides accessors.\"\"\"\n    def __init__(self, digits: List[int]):\n        self.digits = digits\n\n    def length(self) -> int:\n        \"\"\"Returns the number of digits in the sequence.\"\"\"\n        return len(self.digits)\n\n    def digit_at(self, idx: int) -> int:\n        \"\"\"Returns the digit at the specified index.\"\"\"\n        return self.digits[idx]\n\nclass UndulatingChecker:\n    \"\"\"Executes undulating checks based on business rules BR-2 through BR-5.\"\"\"\n    def is_undulating(self, number_input: NumberInput) -> bool:\n        \"\"\"Determines if the given number input represents an undulating number.\"\"\"\n        digits_seq = number_input.get_digits()\n        length = digits_seq.length()\n\n        # Single-digit numbers are not undulating as they cannot have two distinct alternating digits.\n        if length < 2:\n            return False\n\n        even_digit = digits_seq.digit_at(0) # Candidate digit A for even indices\n        odd_digit = digits_seq.digit_at(1)  # Candidate digit B for odd indices\n\n        # Digits A and B must be distinct.\n        if even_digit == odd_digit:\n            return False\n\n        # Verify all digits at even indices match even_digit.\n        for i in range(0, length, 2):\n            if digits_seq.digit_at(i) != even_digit:\n                return False\n\n        # Verify all digits at odd indices match odd_digit.\n        for i in range(1, length, 2):\n            if digits_seq.digit_at(i) != odd_digit:\n                return False\n\n        return True\n\ndef is_undulating(number: int) -> bool:\n    \"\"\"Checks whether the given number is undulating.\n    A number is undulating if its decimal digits alternate between two distinct digits.\n    \"\"\"\n    num_input = NumberInput(number)\n    checker = UndulatingChecker()\n    return checker.is_undulating(num_input)"}
{"task_id": "Mbpp/94", "solution": "from typing import Any, Sequence\n\ndef index_minimum(list_of_tuples: Sequence[tuple]) -> Any:\n    \"\"\"\n    Returns the first value of the tuple with the smallest second value.\n    Assumes valid input: a non-empty list of tuples, each with at least two comparable elements.\n    \"\"\"\n    min_index = 0\n    min_second_value = list_of_tuples[0][1]\n\n    for i in range(1, len(list_of_tuples)):\n        current_second_value = list_of_tuples[i][1]\n        if current_second_value < min_second_value:\n            min_second_value = current_second_value\n            min_index = i\n\n    return list_of_tuples[min_index][0]"}
