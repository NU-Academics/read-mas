{"task_id": "Mbpp/398", "solution": "from typing import List\n\ndef sum_of_digits(numbers: List[int]) -> int:\n    \"\"\"\n    Computes the sum of digits of each number of a given list.\n    assert sum_of_digits([10,2,56])==14\n    \"\"\"\n\n    def _validate_input(nums: List[int]) -> None:\n        \"\"\"\n        Validates the input list and its elements according to design rules.\n        Raises TypeError for invalid types or ValueError for negative numbers.\n        \"\"\"\n        if not isinstance(nums, list):\n            raise TypeError(\"Input must be a list.\")\n        \n        for n_item in nums:\n            if not isinstance(n_item, int):\n                raise TypeError(\"All elements in the list must be integers.\")\n            if n_item < 0:\n                raise ValueError(\"All integers in the list must be non-negative.\")\n\n    def _digits_of(n: int) -> List[int]:\n        \"\"\"\n        Extracts base-10 digits of a non-negative integer into a list of ints.\n        \"\"\"\n        return [int(digit_char) for digit_char in str(n)]\n\n    def _digit_sum_of(n: int) -> int:\n        \"\"\"\n        Computes the sum of base-10 digits for a single non-negative integer.\n        \"\"\"\n        return sum(_digits_of(n))\n\n    _validate_input(numbers)\n    \n    total_sum = 0\n    for num in numbers:\n        total_sum += _digit_sum_of(num)\n        \n    return total_sum"}
{"task_id": "Mbpp/412", "solution": "from typing import List\n\ndef remove_odd(input_list: List[int]) -> List[int]:\n    \"\"\"Return a new list containing only even integers from input_list in original order.\"\"\"\n    even_numbers = []\n    for number in input_list:\n        if number % 2 == 0:\n            even_numbers.append(number)\n    return even_numbers"}
{"task_id": "Mbpp/409", "solution": "def min_product_tuple(pairs):\n    \"\"\"\n    Finds the minimum product from pairs of tuples within a given list.\n    Handles validation for input types, structure, and content.\n    \"\"\"\n    if not isinstance(pairs, (list, tuple)):\n        raise TypeError(\"Input must be a list or tuple of pairs.\")\n    if not pairs:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    products = []\n    for i, pair in enumerate(pairs):\n        if not isinstance(pair, (list, tuple)):\n            raise TypeError(f\"Element at index {i} must be a tuple or list.\")\n        if len(pair) != 2:\n            raise ValueError(f\"Tuple at index {i} must contain exactly two elements.\")\n        if not isinstance(pair[0], int) or not isinstance(pair[1], int):\n            raise TypeError(f\"Elements within tuple at index {i} must be integers.\")\n        \n        products.append(pair[0] * pair[1])\n    \n    if not products: # Should ideally be caught by empty check, but as a safeguard.\n        raise ValueError(\"No valid products could be computed from the input.\")\n\n    return min(products)"}
{"task_id": "Mbpp/410", "solution": "from typing import Any, List, Optional, Union\n\nclass Element:\n    \"\"\"Represents one raw input element and provides classification/conversion operations.\"\"\"\n    def __init__(self, raw_value: Any) -> None:\n        self.raw_value = raw_value\n\n    def is_numeric(self) -> bool:\n        \"\"\"Determines if the element is numeric.\"\"\"\n        return False\n\n    def as_number(self) -> Optional[Union[int, float]]:\n        \"\"\"Converts the element to a number if numeric, otherwise returns None.\"\"\"\n        return None\n\nclass NumericElement(Element):\n    \"\"\"Concrete numeric element; as_number returns numeric value.\"\"\"\n    def __init__(self, value: Union[int, float]) -> None:\n        super().__init__(value)\n        self._value = value\n\n    def is_numeric(self) -> bool:\n        \"\"\"Returns True as this is a numeric element.\"\"\"\n        return True\n\n    def as_number(self) -> Union[int, float]:\n        \"\"\"Returns the numeric value of the element.\"\"\"\n        return self._value\n\nclass NonNumericElement(Element):\n    \"\"\"Concrete non-numeric element; as_number returns None.\"\"\"\n    def __init__(self, value: Any) -> None:\n        super().__init__(value)\n        self._value = value\n\n    def is_numeric(self) -> bool:\n        \"\"\"Returns False as this is a non-numeric element.\"\"\"\n        return False\n\n    def as_number(self) -> None:\n        \"\"\"Returns None as this element is not numeric.\"\"\"\n        return None\n\nclass ListInput:\n    \"\"\"Wraps the incoming Python list and provides canonical access to elements.\"\"\"\n    def __init__(self, elements: list) -> None:\n        self._elements = elements\n\n    def get_elements(self) -> list:\n        \"\"\"Returns the raw list of elements.\"\"\"\n        return self._elements\n\nclass Result:\n    \"\"\"Holds and exposes the computed minimum numeric value.\"\"\"\n    def __init__(self, min_value: Union[int, float]) -> None:\n        self._min_value = min_value\n\n    def get_min(self) -> Union[int, float]:\n        \"\"\"Returns the minimum numeric value.\"\"\"\n        return self._min_value\n\nclass MinValFunction:\n    \"\"\"Orchestrates computation of minimum numeric value from a ListInput and produces a Result.\"\"\"\n    def min_val(self, list_input: list) -> Union[int, float]:\n        \"\"\"Computes the minimum numeric value from the input list.\"\"\"\n        list_input_wrapper = ListInput(list_input)\n        raw_elements = list_input_wrapper.get_elements()\n\n        processed_numeric_values: List[Union[int, float]] = []\n\n        for raw_element in raw_elements:\n            element_wrapper: Element\n            if isinstance(raw_element, (int, float)):\n                element_wrapper = NumericElement(raw_element)\n            else:\n                element_wrapper = NonNumericElement(raw_element)\n            \n            if element_wrapper.is_numeric():\n                numeric_value = element_wrapper.as_number()\n                if numeric_value is not None:\n                    processed_numeric_values.append(numeric_value)\n        \n        min_value_computed = min(processed_numeric_values)\n        \n        result = Result(min_value_computed)\n        return result.get_min()\n\ndef min_val(list_input: list) -> Union[int, float]:\n    \"\"\"\n    Finds the minimum numeric value in a given heterogeneous list.\n    Non-numeric elements are ignored.\n    \"\"\"\n    return MinValFunction().min_val(list_input)"}
