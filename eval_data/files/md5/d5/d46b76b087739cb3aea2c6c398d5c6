{"task_id": "Mbpp/797", "solution": "import typing\n\nclass InputRange:\n    \"\"\"Represents and validates input bounds l and r.\"\"\"\n    def __init__(self, l: int, r: int):\n        self.l = l\n        self.r = r\n\n    def isValid(self) -> bool:\n        \"\"\"Raises TypeError if l or r are not integers, otherwise returns True.\"\"\"\n        if not isinstance(self.l, int) or not isinstance(self.r, int):\n            raise TypeError(\"Inputs l and r must be integers.\")\n        return True\n\nclass Number:\n    \"\"\"Represents a candidate integer value and provides predicates.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def isNatural(self) -> bool:\n        \"\"\"Returns True if the value is a natural number (>= 1).\"\"\"\n        return self.value >= 1\n\n    def isOdd(self) -> bool:\n        \"\"\"Returns True if the value is an odd number.\"\"\"\n        return self.value % 2 != 0\n\nclass Result:\n    \"\"\"A carrier for the computed sum.\"\"\"\n    def __init__(self, sum: int = 0):\n        self.sum = sum\n\ndef sum_in_range(l: int, r: int) -> int:\n    \"\"\"\n    Finds the sum of all odd natural numbers within the inclusive range [l, r].\n    Raises TypeError if l or r are not integers; if l > r, returns 0.\n    \"\"\"\n    input_range = InputRange(l, r)\n    input_range.isValid() # This will raise TypeError if l or r are not int\n\n    if l > r:\n        return 0\n\n    result = Result()\n    for v in range(l, r + 1):\n        number = Number(v)\n        if number.isNatural() and number.isOdd():\n            result.sum += number.value\n\n    return result.sum"}
{"task_id": "Mbpp/799", "solution": "def left_rotate(value: int, d: int) -> int:\n    \"\"\"\n    Rotates the bits of a 32-bit number to the left by d positions.\n    Bits shifted out from the most significant bit are wrapped around to the least significant bit.\n    \"\"\"\n    MASK_32_BIT = 0xFFFFFFFF\n    \n    # Mask the input value to ensure it's treated as a 32-bit number\n    masked_value = value & MASK_32_BIT\n    \n    # Normalize the shift count to be between 0 and 31\n    k = d % 32\n    \n    if k == 0:\n        return masked_value\n    \n    # Perform the circular left rotation\n    # The left part is shifted left and masked to stay within 32 bits\n    # The right part is shifted right to bring wrapped bits to the LSB\n    rotated_value = ((masked_value << k) & MASK_32_BIT) | (masked_value >> (32 - k))\n    \n    return rotated_value"}
{"task_id": "Mbpp/800", "solution": "def remove_all_spaces(input_string):\n    \"\"\"\n    Removes all whitespace characters from the input string.\n    Preserves the relative order of non-whitespace characters.\n    \"\"\"\n    result_chars = []\n    for char in input_string:\n        if not char.isspace():\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/803", "solution": "import math\n\ndef is_perfect_square(n) -> bool:\n    \"\"\"Return True iff there exists an integer k such that k * k == n.\"\"\"\n    if n < 0:\n        return False\n    # Use math.isqrt for integer square root, available from Python 3.8.\n    # For older Python versions, consider int(n**0.5).\n    root = math.isqrt(n)\n    return root * root == n"}
{"task_id": "Mbpp/801", "solution": "def test_three_equal(a: int, b: int, c: int) -> int:\n    \"\"\"Return 3 if a==b==c, 2 if exactly two are equal, 0 if no two are equal.\n    Raises TypeError if any input is not an int.\n    \"\"\"\n    if not all(isinstance(arg, int) for arg in [a, b, c]):\n        raise TypeError(\"All inputs must be integers.\")\n\n    if a == b and b == c:\n        return 3\n    elif a == b or a == c or b == c:\n        return 2\n    else:\n        return 0"}
{"task_id": "Mbpp/805", "solution": "def max_sum_list(list_of_lists):\n    \"\"\"\n    Returns the inner list from a list of lists whose sum of elements is the highest.\n    If the input list is empty, returns None.\n    \"\"\"\n    return max(list_of_lists, key=sum, default=None)"}
{"task_id": "Mbpp/804", "solution": "def is_product_even(list_of_integers: list) -> bool:\n    \"\"\"Checks if the product of numbers in a list is even.\n    Returns True if at least one number in the list is even; otherwise, returns False.\n    \"\"\"\n    for number in list_of_integers:\n        if number % 2 == 0:\n            return True\n    return False"}
{"task_id": "Mbpp/806", "solution": "from datetime import datetime\n\nclass MaxRunResult:\n    \"\"\"Value object holding computation result and timestamp.\"\"\"\n    def __init__(self, maxRun: int, timestamp: datetime):\n        self.maxRun = maxRun\n        self.timestamp = timestamp\n\nclass MaxRunCalculator:\n    \"\"\"\n    Algorithm to compute maximum contiguous run of uppercase letters.\n    Stateless and expected to be O(n) time complexity.\n    \"\"\"\n    def computeMaxRun(self, s: str) -> int:\n        \"\"\"\n        Calculates the length of the longest contiguous run of uppercase characters.\n        Returns 0 for empty strings or strings with no uppercase letters.\n        \"\"\"\n        max_run = 0\n        current_run = 0\n        for char in s:\n            if self.isUppercase(char):\n                current_run += 1\n            else:\n                max_run = max(max_run, current_run)\n                current_run = 0\n        return max(max_run, current_run)\n\n    def isUppercase(self, ch: str) -> bool:\n        \"\"\"\n        Checks if a character is an uppercase letter.\n        Behavior follows platform semantics for \"uppercase\".\n        \"\"\"\n        return ch.isupper()\n\ndef max_run_uppercase(s: str) -> int:\n    \"\"\"\n    Finds the maximum run of uppercase characters in the given string.\n    Delegates the computation to a MaxRunCalculator instance.\n    \"\"\"\n    calculator = MaxRunCalculator()\n    return calculator.computeMaxRun(s)"}
{"task_id": "Mbpp/807", "solution": "from typing import List, Optional\n\nclass Number:\n    \"\"\"Encapsulates a numeric integer value and provides a parity check.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def is_odd(self) -> bool:\n        \"\"\"Returns True if the stored value is odd.\"\"\"\n        return self.value % 2 != 0\n\nclass NumberList:\n    \"\"\"Wraps a raw Python sequence of numeric values into Number objects.\"\"\"\n    def __init__(self, raw_list: List[int]) -> None:\n        self.elements = [Number(int(x)) for x in raw_list]\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.elements)\n\nclass FirstOddFunction:\n    \"\"\"Encapsulates the operation to find the first odd Number in a NumberList.\"\"\"\n    def __init__(self, name: str = \"first_odd\") -> None:\n        self.name = name\n\n    def execute(self, num_list: 'NumberList') -> Optional['Number']:\n        \"\"\"Iterates through the NumberList and returns the first odd Number, or None.\"\"\"\n        for number_obj in num_list.elements:\n            if number_obj.is_odd():\n                return number_obj\n        return None\n\ndef first_odd(numbers: List[int]) -> Optional[int]:\n    \"\"\"\n    Finds the first odd number in a given list of numbers.\n    Oddness is defined by (value % 2) != 0.\n    \"\"\"\n    number_list = NumberList(numbers)\n    finder = FirstOddFunction()\n    first_odd_num_obj = finder.execute(number_list)\n    if first_odd_num_obj:\n        return first_odd_num_obj.value\n    return None"}
{"task_id": "Mbpp/809", "solution": "def check_smaller(first_tuple, second_tuple):\n    \"\"\"\n    Checks if each element of the second tuple is smaller than its corresponding\n    element in the first tuple.\n    \"\"\"\n    if len(first_tuple) != len(second_tuple):\n        raise ValueError('tuple length mismatch')\n\n    if not first_tuple:  # Handles empty tuples (vacuously true)\n        return True\n\n    for i in range(len(first_tuple)):\n        try:\n            if not (second_tuple[i] < first_tuple[i]):\n                return False\n        except TypeError:\n            raise TypeError('elements must be numeric/comparable')\n\n    return True"}
{"task_id": "Mbpp/808", "solution": "def check_K(input_tuple, k) -> bool:\n    \"\"\"Checks if a given value k is present in the input tuple.\"\"\"\n    return k in input_tuple"}
{"task_id": "Mbpp/102", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass InputString:\n    \"\"\"Represents the input string and provides basic validation.\"\"\"\n    value: str\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if the stored value is a string.\"\"\"\n        return isinstance(self.value, str)\n\nclass WordSegment:\n    \"\"\"Represents a segment of the input string and provides capitalization.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\n    def capitalize_first(self) -> str:\n        \"\"\"Capitalizes the first character of the segment.\"\"\"\n        if not self.text:\n            return \"\"\n        return self.text[0].upper() + self.text[1:]\n\nclass OutputString:\n    \"\"\"Holds the resulting CamelCase string.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\nclass SnakeToCamelFunction:\n    \"\"\"Encapsulates the conversion algorithm from snake_case to CamelCase.\"\"\"\n    def snake_to_camel(self, input_str: str) -> str:\n        \"\"\"Converts a snake_case string to CamelCase.\"\"\"\n        inp = InputString(input_str)\n        if not inp.is_valid():\n            raise TypeError(\"input_str must be a string\")\n\n        segments = [WordSegment(s) for s in inp.value.split('_') if s != '']\n        capitalized_segments = [seg.capitalize_first() for seg in segments]\n        \n        out = OutputString(''.join(capitalized_segments))\n        return out.value\n\ndef snake_to_camel(input_str: str) -> str:\n    \"\"\"\n    Converts a snake_case string to camel case string.\n    assert snake_to_camel('python_program')=='PythonProgram'\n    \"\"\"\n    converter = SnakeToCamelFunction()\n    return converter.snake_to_camel(input_str)"}
{"task_id": "Mbpp/616", "solution": "def tuple_modulo(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Computes the element-wise modulo of two tuples of the same length.\n    Raises ValueError if inputs are not tuples or have different lengths.\n    \"\"\"\n    if not isinstance(a, tuple) or not isinstance(b, tuple):\n        raise ValueError(\"inputs must be tuples of equal length\")\n\n    if len(a) != len(b):\n        raise ValueError(\"inputs must be tuples of equal length\")\n\n    result_elements = []\n    for i in range(len(a)):\n        result_elements.append(a[i] % b[i])\n\n    return tuple(result_elements)"}
{"task_id": "Mbpp/276", "solution": "import math\nfrom dataclasses import dataclass\n\n@dataclass\nclass Cylinder:\n    radius: float\n    height: float\n    volume: float = 0.0\n\n    def compute_volume(self) -> float:\n        \"\"\"Compute and store volume = math.pi * radius * radius * height.\"\"\"\n        self.volume = math.pi * self.radius * self.radius * self.height\n        return self.volume\n\nclass VolumeCalculator:\n    @staticmethod\n    def compute(radius: float, height: float) -> float:\n        \"\"\"Return math.pi * float(radius) * float(radius) * float(height).\"\"\"\n        cylinder = Cylinder(radius=radius, height=height)\n        return cylinder.compute_volume()\n\nclass TestCase:\n    def __init__(self, name: str, expected_value: float, rel_tol: float):\n        \"\"\"Initialize TestCase with name, expected_value, and relative tolerance.\"\"\"\n        self.name = name\n        self.expected_value = expected_value\n        self.rel_tol = rel_tol\n    def run(self, computed_value: float) -> bool:\n        \"\"\"Run the isclose check against the computed value.\"\"\"\n        return math.isclose(computed_value, self.expected_value, rel_tol=self.rel_tol)\n\ndef volume_cylinder(radius, height) -> float:\n    \"\"\"Compute and return cylinder volume (float).\"\"\"\n    return VolumeCalculator.compute(float(radius), float(height))"}
