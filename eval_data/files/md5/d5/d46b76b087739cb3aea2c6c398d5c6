{"task_id": "Mbpp/437", "solution": "def remove_odd(input: str) -> str:\n    \"\"\"Removes characters at even (0-based) indices, keeping characters at odd indices.\"\"\"\n    if not isinstance(input, str):\n        raise TypeError(\"input must be a string\")\n\n    if len(input) < 2:\n        return \"\"\n\n    return ''.join(input[i] for i in range(1, len(input), 2))"}
{"task_id": "Mbpp/439", "solution": "from typing import List\nfrom dataclasses import dataclass\n\n@dataclass\nclass IntegerElement:\n    \"\"\"Represents a single integer element.\"\"\"\n    value: int\n\n    def to_decimal_string(self) -> str:\n        \"\"\"Converts the integer value to its decimal string representation.\"\"\"\n        return str(self.value)\n\n@dataclass\nclass IntegerList:\n    \"\"\"Represents a list of integer elements.\"\"\"\n    elements: List[IntegerElement]\n\n    @classmethod\n    def from_int_list(cls, values: List[int]) -> 'IntegerList':\n        \"\"\"Factory method to construct IntegerList from a list of raw integers.\"\"\"\n        return cls(elements=[IntegerElement(value=v) for v in values])\n\n@dataclass\nclass ResultInteger:\n    \"\"\"Represents the final concatenated integer result.\"\"\"\n    value: int\n\nclass ConcatenationFunction:\n    \"\"\"Stateless utility for concatenating integers.\"\"\"\n    def multiple_to_single(self, numbers: List[int]) -> int:\n        \"\"\"Joins a list of integers into a single integer by concatenating their string representations.\"\"\"\n        integer_list = IntegerList.from_int_list(numbers)\n        decimal_strings = [element.to_decimal_string() for element in integer_list.elements]\n        concatenated_string = self._concat_decimal_strings(decimal_strings)\n        result_value = int(concatenated_string)\n        return result_value\n\n    @staticmethod\n    def _concat_decimal_strings(strings: List[str]) -> str:\n        \"\"\"Concatenates a list of decimal strings into a single string.\"\"\"\n        return \"\".join(strings)\n\ndef multiple_to_single(numbers: List[int]) -> int:\n    \"\"\"\n    Joins a list of multiple integers into a single integer by concatenating their string representations.\n    Example: multiple_to_single([11, 33, 50]) == 113350\n    \"\"\"\n    return ConcatenationFunction().multiple_to_single(numbers)"}
