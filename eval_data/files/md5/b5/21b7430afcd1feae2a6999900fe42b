{"task_id": "HumanEval/26", "solution": "from typing import List, Dict\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    >>> remove_duplicates([1, 2, 3, 2, 4])\n    [1, 3, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    # Use a dictionary to count occurrences for an O(N) pass\n    counts: Dict[int, int] = {}\n    for num in numbers:\n        counts[num] = counts.get(num, 0) + 1\n\n    # Build the result list, preserving order and including only unique elements\n    result: List[int] = []\n    for num in numbers:\n        if counts[num] == 1:\n            result.append(num)\n\n    return result"}
{"task_id": "HumanEval/24", "solution": "def largest_divisor(n: int) -> int:\n    \"\"\" For a given number n, find the largest number that divides n evenly, smaller than n\n    >>> largest_divisor(15)\n    5\n    \"\"\"\n    if n <= 1:\n        raise ValueError(\"n must be greater than 1 to have a divisor smaller than n.\")\n\n    for i in range(n // 2, 0, -1):\n        if n % i == 0:\n            return i\n    return 1 # This line should technically not be reached if n > 1, as 1 always divides n."}
{"task_id": "HumanEval/25", "solution": "def factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    factors = []\n\n    # Handle edge cases for n <= 1 as they don't have prime factors.\n    if n <= 1:\n        return []\n\n    # Perform trial division starting with 2.\n    # Divide by 2 repeatedly until n is no longer divisible by 2.\n    d = 2\n    while n % d == 0:\n        factors.append(d)\n        n //= d\n\n    # After dividing by 2, check odd numbers from 3 upwards.\n    # The loop runs up to sqrt(n) for efficiency.\n    d = 3\n    while d * d <= n:\n        while n % d == 0:\n            factors.append(d)\n            n //= d\n        d += 2  # Increment by 2 to check only odd numbers.\n\n    # If n is still greater than 1, it must be a prime factor itself.\n    if n > 1:\n        factors.append(n)\n\n    return factors"}
{"task_id": "HumanEval/27", "solution": "def flip_case(string: str) -> str:\n    \"\"\" For a given string, flip lowercase characters to uppercase and uppercase to lowercase. Non-alphabetic characters remain unchanged.\n    >>> flip_case('Hello')\n    'hELLO'\n    \"\"\"\n    flipped_chars = []\n    for char in string:\n        if char.isalpha():\n            if char.islower():\n                flipped_chars.append(char.upper())\n            else:  # char.isupper()\n                flipped_chars.append(char.lower())\n        else:\n            flipped_chars.append(char)\n    return \"\".join(flipped_chars)"}
{"task_id": "HumanEval/28", "solution": "def concatenate(strings: List[str]) -> str:\n    \"\"\" Concatenate list of strings into a single string \"\"\"\n    return \"\".join(strings)"}
{"task_id": "HumanEval/29", "solution": "from typing import List\ndef filter_by_prefix(strings: List[str], prefix: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that start with a given prefix.\n    >>> filter_by_prefix([], 'a')\n    []\n    >>> filter_by_prefix(['abc', 'bcd', 'cde', 'array'], 'a')\n    ['abc', 'array']\n    \"\"\"\n    filtered_strings = []\n    for s in strings:\n        if s.startswith(prefix):\n            filtered_strings.append(s)\n    return filtered_strings"}
{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n\n    # Check for odd divisors from 3 up to the square root of n\n    # We only need to check up to sqrt(n) because if n has a divisor greater than sqrt(n),\n    # it must also have a divisor smaller than sqrt(n).\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True"}
{"task_id": "HumanEval/30", "solution": "def get_positive(l: list):\n    \"\"\"Return only positive numbers in the list.\"\"\"\n    return [item for item in l if item > 0]"}
{"task_id": "HumanEval/34", "solution": "def unique(l: list):\n    \"\"\"Return sorted unique elements in a list\n    >>> unique([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [0, 2, 3, 5, 9, 123]\n    \"\"\"\n    return sorted(list(set(l)))"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    if not l:\n        return []\n\n    l_prime = list(l)\n\n    divisible_indices = []\n    divisible_elements = []\n\n    for i, item in enumerate(l):\n        if i % 3 == 0:\n            divisible_indices.append(i)\n            divisible_elements.append(item)\n\n    sorted_divisible_elements = sorted(divisible_elements)\n\n    for i, sorted_val in zip(divisible_indices, sorted_divisible_elements):\n        l_prime[i] = sorted_val\n\n    return l_prime"}
{"task_id": "HumanEval/35", "solution": "def max_element(l: list):\n    \"\"\"Return maximum element in the list.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    if not l:\n        return None\n\n    try:\n        return max(l)\n    except TypeError as e:\n        raise ValueError(f\"Elements in the list are not comparable: {e}\") from e"}
{"task_id": "HumanEval/32", "solution": "def find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    # For odd-degree polynomials (implied by an even number of coefficients),\n    # there is always at least one real root. The bisection method is used.\n\n    # Initial bracket for the root search. The range is iteratively expanded\n    # until a sign change is found, guaranteeing a root is within the bracket.\n    low, high = -1.0, 1.0\n    max_bracket_expand_iterations = 100\n\n    for _ in range(max_bracket_expand_iterations):\n        val_low = poly(xs, low)\n        val_high = poly(xs, high)\n\n        if abs(val_low) < 1e-7: return low  # Check if low is already a root\n        if abs(val_high) < 1e-7: return high # Check if high is already a root\n        if abs(poly(xs, 0.0)) < 1e-7: return 0.0 # Check if zero is a root\n\n        if val_low * val_high < 0:\n            break # Found a bracket with a sign change\n\n        # Expand the interval exponentially if no sign change is found\n        low *= 2.0\n        high *= 2.0\n\n        # Safeguard for extremely large ranges, using a fixed large bracket if expansion goes too far.\n        if low < -1e12 or high > 1e12:\n            low, high = -1e10, 1e10 # Fallback to a very wide, fixed range\n            if poly(xs, low) * poly(xs, high) < 0:\n                break\n            else:\n                return 0.0 # Should ideally not be reached under problem assumptions\n\n    # Bisection method to find the root within the established bracket\n    tolerance = 1e-7 # Desired precision for the root\n    max_bisection_iterations = 1000 # Max iterations for bisection convergence\n\n    for _ in range(max_bisection_iterations):\n        mid = (low + high) / 2.0\n        val_mid = poly(xs, mid)\n\n        # If the polynomial value at mid is close to zero, or interval is very small\n        if abs(val_mid) < tolerance or (high - low) / 2.0 < tolerance:\n            return mid\n\n        val_low = poly(xs, low) # Re-evaluate for robustness\n\n        # Narrow the search interval based on the sign of poly(mid)\n        if val_low * val_mid < 0: # Root is in the lower half [low, mid]\n            high = mid\n        else: # Root is in the upper half [mid, high]\n            low = mid\n\n    # If max_bisection_iterations is reached, return the midpoint of the last interval as the best estimate\n    return (low + high) / 2.0"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    if not l:\n        return []\n\n    # Create a copy of the input list to build the result\n    result_list = l.copy()\n\n    # Extract and sort even-indexed elements\n    even_elements = [l[i] for i in range(0, len(l), 2)]\n    even_elements.sort()\n\n    # Place the sorted even-indexed elements back into the result list\n    even_idx_counter = 0\n    for i in range(0, len(l), 2):\\\n        result_list[i] = even_elements[even_idx_counter]"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n\n    def _is_divisible_by_11_or_13(num: int) -> bool:\n        \"\"\"Checks if a given integer is divisible by 11 or 13.\"\"\"\n        return num % 11 == 0 or num % 13 == 0\n\n    def _count_digit_seven(num: int) -> int:\n        \"\"\"Counts the occurrences of the digit '7' in a given integer.\"\"\"\n        return str(num).count('7')\n\n    total_sevens_count = 0\n    for i in range(1, n):\n        if _is_divisible_by_11_or_13(i):\n            total_sevens_count += _count_digit_seven(i)\n    return total_sevens_count"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # uncycle elements in each group. Unless group has fewer elements than 3.\n    unshifted_groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(unshifted_groups)"}
{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    import math\n    from typing import Generator\n\n    def _is_prime(number: int) -> bool:\n        \"\"\"\n        _is_prime determines if a given number is prime.\n        It checks for divisibility up to the square root of the number.\n        \"\"\"\n        if number < 2:\n            return False\n        for i in range(2, int(math.sqrt(number)) + 1):\n            if number % i == 0:\n                return False\n        return True\n\n    def _generate_fibonacci_sequence() -> Generator[int, None, None]:\n        \"\"\"\n        _generate_fibonacci_sequence generates Fibonacci numbers sequentially.\n        It yields an infinite sequence of Fibonacci numbers starting from 0.\n        \"\"\"\n        a, b = 0, 1\n        while True:\n            yield a\n            a, b = b, a + b\n\n    fib_generator = _generate_fibonacci_sequence()\n    prime_fib_count = 0\n    current_fib_num = 0\n\n    # Skip F(0)=0 and F(1)=1 as 0 is not prime and 1 is not prime.\n    # The generator yields 0, 1, 1, 2, 3, 5, ...\n    next(fib_generator) # Skip 0\n    next(fib_generator) # Skip 1 (first occurrence)\n    next(fib_generator) # Skip 1 (second occurrence)\n\n    while prime_fib_count < n:\n        current_fib_num = next(fib_generator)\n        if _is_prime(current_fib_num):\n            prime_fib_count += 1\n\n    return current_fib_num"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    for i in range(n - 2):\n        for j in range(i + 1, n - 1):\n            for k in range(j + 1, n):\n                if l[i] + l[j] + l[k] == 0:\n                    return True\n    return False"}
{"task_id": "HumanEval/41", "solution": "def car_race_collision(n: int):\n    \"\"\"\n    Calculates the number of collisions between n cars moving left-to-right\n    and n cars moving right-to-left. Each of the n left-to-right cars will\n    collide with each of the n right-to-left cars exactly once.\n    \"\"\"\n    return n * n"}
{"task_id": "HumanEval/42", "solution": "def incr_list(l: list):\n    \"\"\"Return list with elements incremented by 1.\n    >>> incr_list([1, 2, 3])\n    [2, 3, 4]\n    >>> incr_list([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [6, 4, 6, 3, 4, 4, 10, 1, 124]\n    \"\"\"\n    return [x + 1 for x in l]"}
{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    >>> pairs_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> pairs_sum_to_zero([1, 3, -2, 1])\n    False\n    >>> pairs_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> pairs_sum_to_zero([2, 4, -5, 3, 5, 7])\n    True\n    >>> pairs_sum_to_zero([1])\n    False\n    \"\"\"\n    seen_numbers = set()\n    for num in l:\n        complement = -num\n        if complement in seen_numbers:\n            return True\n        seen_numbers.add(num)\n    return False"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    \"\"\"\n    if x == 0:\n        return \"0\"\n\n    result_digits = []\n    while x > 0:\n        remainder = x % base\n        result_digits.append(str(remainder))\n        x //= base\n\n    return \"\".join(result_digits[::-1])"}
{"task_id": "HumanEval/45", "solution": "def triangle_area(a, h):\n    \"\"\"Given length of a side and high return area for a triangle.\n    >>> triangle_area(5, 3)\n    7.5\n    \"\"\"\n    return (a * h) / 2"}
{"task_id": "HumanEval/48", "solution": "def is_palindrome(text: str):\n    \"\"\"\n    Checks if given string is a palindrome.\n    It ignores case and non-alphanumeric characters.\n    \"\"\"\n    if not text:\n        return True\n\n    processed_text = \"\"\n    for char in text:\n        if char.isalnum():\n            processed_text += char.lower()\n\n    return processed_text == processed_text[::-1]"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    Please write a function to efficiently compute the n-th element of the fib4 number sequence.  Do not use recursion.\n    >>> fib4(5)\n    4\n    >>> fib4(6)\n    8\n    >>> fib4(7)\n    14\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 0\n\n    # Initialize the four preceding values (fib4(0) to fib4(3)).\n    # These represent fib4(i-4), fib4(i-3), fib4(i-2), fib4(i-1) during iteration.\n    f0, f1, f2, f3 = 0, 0, 2, 0\n\n    for _ in range(4, n + 1):\n        next_fib = f3 + f2 + f1 + f0\n        f0, f1, f2, f3 = f1, f2, f3, next_fib\n\n    return f3"}
{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int):\n    \"\"\"Return 2^n modulo p (be aware of numerics).\n    This function implements modular exponentiation by squaring to compute (2^n) % p efficiently.\n    \"\"\"\n    result = 1\n    base = 2\n\n    # Reduce base modulo p once, though for base=2, it's often just 2 unless p <= 2\n    base = base % p\n\n    while n > 0:\n        # If n is odd, multiply base with result\n        if n % 2 == 1:\n            result = (result * base) % p\n\n        # n must be even now, square the base\n        base = (base * base) % p\n\n        # Divide n by 2\n        n = n // 2\n\n    return result"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    # Sort the input list to find the median.\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    if n % 2 == 1:\n        # If the list has an odd number of elements, the median is the middle element.\n        return float(sorted_l[n // 2])\n    else:\n        # If the list has an even number of elements, the median is the average of the two middle elements.\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        return (float(mid1) + float(mid2)) / 2.0"}
{"task_id": "HumanEval/50", "solution": "def decode_shift(s: str):\n    \"\"\"\n    takes as input string encoded with encode_shift function. Returns decoded string.\n    Shifts every lowercase English alphabet character by 5 positions backward.\n    Non-lowercase characters remain unchanged.\n    \"\"\"\n    decoded_chars = []\n    for ch in s:\n        if 'a' <= ch <= 'z':\n            shifted_ch = chr(((ord(ch) - 5 - ord('a') + 26) % 26) + ord('a'))\n            decoded_chars.append(shifted_ch)\n        else:\n            decoded_chars.append(ch)\n    return \"\".join(decoded_chars)"}
{"task_id": "HumanEval/51", "solution": "def remove_vowels(text):\n    \"\"\"\n    remove_vowels is a function that takes string and returns string without vowels.\n    >>> remove_vowels('')\n    ''\n    >>> remove_vowels(\"abcdef\\nghijklm\")\n    'bcdf\\nghjklm'\n    >>> remove_vowels('abcdef')\n    'bcdf'\n    >>> remove_vowels('aaaaa')\n    ''\n    >>> remove_vowels('aaBAA')\n    'B'\n    >>> remove_vowels('zbcd')\n    'zbcd'\n    \"\"\"\n    vowels = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n    result_chars = []\n    for char in text:\n        if char not in vowels:\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
