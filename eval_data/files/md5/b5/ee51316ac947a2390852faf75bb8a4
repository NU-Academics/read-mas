{"task_id": "Mbpp/165", "solution": "from typing import List, Iterator\n\nclass InputString:\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        return len(self.value)\n\n    def iter_positions(self) -> Iterator['CharacterPosition']:\n        \"\"\"Iterates over the input string, yielding CharacterPosition objects (1-based index) up to position 26.\"\"\"\n        for i in range(min(len(self.value), 26)): # Loop for 0-25 indices, corresponding to 1-26 positions\n            yield CharacterPosition(index=i + 1, character=self.value[i])\n\nclass CharacterPosition:\n    def __init__(self, index: int, character: str) -> None:\n        self.index = index\n        self.character = character.lower() # Store lowercase for case-insensitive comparison\n\n    def isAlphabetic(self) -> bool:\n        \"\"\"Checks if the character is an English alphabet letter (a-z).\"\"\"\n        return 'a' <= self.character <= 'z'\n\nclass AlphabetLetter:\n    def __init__(self, position: int, letter: str) -> None:\n        self.position = position\n        self.letter = letter.lower() # Ensure letter is lowercase\n\nclass MatchResult:\n    def __init__(self, matched_count: int, matched_positions: List['CharacterPosition']) -> None:\n        self.matched_count = matched_count\n        self.matched_positions = matched_positions\n\n# Module-level constant: ALPHABET (list of 26 AlphabetLetter objects mapping positions 1..26 to 'a'..'z').\nALPHABET: List[AlphabetLetter] = [AlphabetLetter(pos + 1, chr(ord('a') + pos)) for pos in range(26)]\n\ndef count_char_position(input: str) -> int:\n    \"\"\"\n    Counts characters in a string that match their 1-based alphabetical position.\n    Compares characters case-insensitively, ignores non-alphabetic chars and positions > 26.\n    \"\"\"\n    if not isinstance(input, str):\n        raise TypeError(\"Input must be a string.\")\n\n    matched_count = 0\n    input_str_obj = InputString(input)\n\n    for char_pos_obj in input_str_obj.iter_positions():\n        # char_pos_obj.index is already 1-based and iter_positions limits iteration to 26 positions.\n        if char_pos_obj.isAlphabetic():\n            # ALPHABET is 0-indexed, so we use `position_1based - 1`.\n            if char_pos_obj.character == ALPHABET[char_pos_obj.index - 1].letter:\n                matched_count += 1\n    \n    return matched_count"}
{"task_id": "Mbpp/166", "solution": "from typing import List\n\ndef _comb2(n: int) -> int:\n    \"\"\"Calculates n choose 2, returning 0 if n is less than 2.\"\"\"\n    if n < 2:\n        return 0\n    return n * (n - 1) // 2\n\ndef find_even_pair(nums: List[int]) -> int:\n    \"\"\"\n    Counts the number of pairs of integers in a list that xor to an even number.\n    This is equivalent to counting pairs of integers with the same parity.\n    \"\"\"\n    if len(nums) < 2:\n        return 0\n\n    evens_count = 0\n    odds_count = 0\n\n    for num in nums:\n        if num % 2 == 0:\n            evens_count += 1\n        else:\n            odds_count += 1\n\n    # Pairs with even XOR are formed by two even numbers or two odd numbers.\n    # Count pairs of even numbers: C(evens_count, 2)\n    # Count pairs of odd numbers: C(odds_count, 2)\n    return _comb2(evens_count) + _comb2(odds_count)"}
{"task_id": "Mbpp/167", "solution": "def validate_non_negative(n) -> None:\n    \"\"\"Validates that n is a non-negative integer, raising TypeError or ValueError if invalid.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\ndef is_power_of_two(n: int) -> bool:\n    \"\"\"Checks if a given positive integer n is a power of two.\"\"\"\n    return n > 0 and (n & (n - 1) == 0)\n\ndef _ceil_pow2(n: int) -> int:\n    \"\"\"Computes the smallest power of two greater than or equal to n, for n > 0 and not already a power of two.\"\"\"\n    # For a number N, its next power of 2 is 1 << (N-1).bit_length()\n    # (N-1).bit_length() gives the number of bits required to represent N-1,\n    # which is equivalent to log2(N-1) + 1. For example, for N=5, N-1=4, 4.bit_length() is 3. 1 << 3 = 8.\n    return 1 << (n - 1).bit_length()\n\ndef next_power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the smallest power of 2 greater than or equal to n.\n    Handles non-negative integer inputs, returning 1 for n=0 and n if it's already a power of two.\n    \"\"\"\n    validate_non_negative(n)\n\n    if n == 0:\n        return 1\n    if is_power_of_two(n):\n        return n\n    return _ceil_pow2(n)"}
{"task_id": "Mbpp/171", "solution": "from dataclasses import dataclass\nfrom typing import Union\n\nNumber = Union[int, float]\n\n@dataclass\nclass Pentagon:\n    side_length: float\n    perimeter: float = 0.0\n\n    def __post_init__(self) -> None:\n        self.perimeter = self.compute_perimeter()\n\n    def compute_perimeter(self) -> float:\n        return 5.0 * float(self.side_length)\n\ndef perimeter_pentagon(side_length: Number) -> float:\n    \"\"\"Compute the perimeter of a regular pentagon given side_length.\n\n    Accepts int or float and returns numeric perimeter (float).\n    \"\"\"\n    p = Pentagon(side_length=float(side_length))\n    return p.perimeter"}
{"task_id": "Mbpp/170", "solution": "from typing import List, Union\n\nNumber = Union[int, float]\n\nclass ListModel:\n    \"\"\"Lightweight wrapper for input list, providing length and element access.\"\"\"\n    def __init__(self, elements: List[Number]) -> None:\n        self.elements = elements\n\n    def __len__(self) -> int:\n        return len(self.elements)\n\n    def __getitem__(self, index: int) -> Number:\n        return self.elements[index]\n\nclass IndexRange:\n    \"\"\"Represents the start and end indices for a range.\"\"\"\n    def __init__(self, start_index: int, end_index: int) -> None:\n        self.start_index = start_index\n        self.end_index = end_index\n\nclass ValidationResult:\n    \"\"\"Encapsulates the outcome of a validation check.\"\"\"\n    def __init__(self, is_valid: bool, message: str = '') -> None:\n        self.is_valid = is_valid\n        self.message = message\n\nclass SumResult:\n    \"\"\"Holds the computed sum value.\"\"\"\n    def __init__(self, value: Number) -> None:\n        self.value = value\n\ndef _validate_indices(lst_model: ListModel, index_range: IndexRange) -> ValidationResult:\n    \"\"\"Validates the given indices against the list model's bounds and consistency rules.\"\"\"\n    if not isinstance(index_range.start_index, int) or not isinstance(index_range.end_index, int):\n        return ValidationResult(False, \"Indices must be integers.\")\n\n    list_length = len(lst_model)\n    start = index_range.start_index\n    end = index_range.end_index\n\n    if not (0 <= start < list_length):\n        return ValidationResult(False, f\"Start index {start} is out of bounds for list of length {list_length}.\")\n    if not (0 <= end < list_length):\n        return ValidationResult(False, f\"End index {end} is out of bounds for list of length {list_length}.\")\n    if start > end:\n        return ValidationResult(False, f\"Start index {start} cannot be greater than end index {end}.\")\n    \n    return ValidationResult(True)\n\ndef sum_range_list(lst: List[Number], start_index: int, end_index: int) -> Number:\n    \"\"\"\n    Calculates the sum of numbers in a list within a specified, inclusive range of indices.\n    Raises ValueError for invalid inputs (non-integer indices, out-of-bounds, or start > end).\n    \"\"\"\n    list_model = ListModel(lst)\n    idx_range = IndexRange(start_index, end_index)\n\n    validation_result = _validate_indices(list_model, idx_range)\n    if not validation_result.is_valid:\n        raise ValueError(validation_result.message)\n\n    current_sum: Number = 0\n    for i in range(idx_range.start_index, idx_range.end_index + 1):\n        current_sum += list_model[i]\n    \n    return SumResult(current_sum).value"}
{"task_id": "Mbpp/222", "solution": "class TypeChecker:\n    def __init__(self) -> None:\n        pass\n\n    def check_type(self, inputTuple: tuple) -> bool:\n        \"\"\"Encapsulates the algorithm to check for type homogeneity in a tuple.\"\"\"\n        # If the tuple is empty or has a single element, it's considered trivially homogeneous.\n        if not inputTuple or len(inputTuple) == 1:\n            return True\n\n        # For tuples with two or more elements, collect all unique types.\n        # If all elements have the same type, the set of types will have size 1.\n        types_in_tuple = {type(item) for item in inputTuple}\n        return len(types_in_tuple) == 1\n\ndef check_type(inputTuple: tuple) -> bool:\n    \"\"\"Public API function required by SRS; delegates the type checking logic to TypeChecker.\"\"\"\n    checker = TypeChecker()\n    return checker.check_type(inputTuple)"}
{"task_id": "Mbpp/172", "solution": "class InputString:\n    \"\"\"A value object wrapping an input string.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the wrapped string.\"\"\"\n        return len(self.value)\n\nclass OccurrenceResult:\n    \"\"\"A value object holding the integer count of occurrences.\"\"\"\n    def __init__(self, count: int):\n        self.count = count\n\nclass SubstringCounter:\n    \"\"\"Implements the counting algorithm for the substring 'std'.\"\"\"\n    def count_occurance(self, input_value: str) -> OccurrenceResult:\n        \"\"\"Counts non-overlapping, case-sensitive occurrences of 'std'.\"\"\"\n        input_obj = InputString(value=input_value)\n        target_substring = \"std\"\n        target_len = len(target_substring)\n        count = 0\n        start_index = 0\n\n        while True:\n            index = input_obj.value.find(target_substring, start_index)\n            if index == -1:\n                break\n            count += 1\n            start_index = index + target_len\n        \n        return OccurrenceResult(count=count)\n\ndef count_occurance(input: str) -> int:\n    \"\"\"\n    Counts the number of non-overlapping, case-sensitive occurrences of 'std' in the given string.\n    \"\"\"\n    counter = SubstringCounter()\n    result_obj = counter.count_occurance(input)\n    return result_obj.count"}
{"task_id": "Mbpp/224", "solution": "def count_Set_Bits(n: int) -> int:\n    \"\"\"\n    Return the number of set bits (1 bits) in the binary representation of integer n.\n    The minimal implementation assumes callers supply non-negative integers.\n    \"\"\"\n    return bin(n).count('1')"}
