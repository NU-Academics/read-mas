{"task_id": "Mbpp/61", "solution": "from typing import Iterator, Tuple\n\ndef _validate_input(s: str) -> None:\n    \"\"\"Validates that all characters in the input string are decimal digits.\"\"\"\n    for char_code in s:\n        if not char_code.isdigit():\n            raise ValueError(\"Input string must contain only decimal digits.\")\n\ndef _sum_digits(sub: str) -> int:\n    \"\"\"Calculates the sum of the numeric values of digits in a substring.\"\"\"\n    return sum(int(c) for c in sub)\n\ndef _generate_substrings(s: str) -> Iterator[Tuple[int, int, str]]:\n    \"\"\"Generates all contiguous substrings of the input string with their start and end indices (exclusive).\"\"\"\n    n = len(s)\n    for i in range(n):\n        for j in range(i + 1, n + 1):\n            yield (i, j, s[i:j])\n\ndef count_Substrings(s: str) -> int:\n    \"\"\"\n    Counts substrings where the sum of their digits equals their length.\n    It validates input and enumerates all contiguous substrings.\n    \"\"\"\n    _validate_input(s)\n    \n    match_count = 0\n    for _start, _end, sub_str in _generate_substrings(s):\n        sub_length = len(sub_str)\n        digit_sum = _sum_digits(sub_str)\n        \n        if digit_sum == sub_length:\n            match_count += 1\n            \n    return match_count"}
{"task_id": "Mbpp/65", "solution": "def _is_numeric(value):\n    \"\"\"Checks if a value is an integer or a float.\"\"\"\n    return isinstance(value, (int, float))\n\ndef _recursive_sum(item):\n    \"\"\"Recursively sums numeric elements in a list or returns a numeric item's value.\"\"\"\n    if isinstance(item, list):\n        current_sum = 0\n        for element in item:\n            current_sum += _recursive_sum(element)\n        return current_sum\n    elif _is_numeric(item):\n        return item\n    else:\n        return 0\n\ndef recursive_list_sum(input_list):\n    \"\"\"Public API: accepts exactly one argument 'input_list' (a list possibly containing nested lists) and returns the numeric total.\"\"\"\n    return _recursive_sum(input_list)"}
{"task_id": "Mbpp/64", "solution": "import collections\n\ndef subject_marks(items: list) -> list:\n    \"\"\"Sorts a list of tuples by the second element.\"\"\"\n    if not isinstance(items, list):\n        raise TypeError(\"items must be a list-like object\")\n\n    for idx, item in enumerate(items):\n        if not (isinstance(item, collections.abc.Sequence) and not isinstance(item, str)):\n            raise ValueError(f\"item at index {idx} is not a tuple/sequence: {type(item)!r}\")\n        if len(item) < 2:\n            raise ValueError(f\"item at index {idx} does not contain at least two elements: {item!r}\")\n\n    def _extract_second(item):\n        return item[1]\n\n    try:\n        sorted_iterable = sorted(items, key=_extract_second)\n    except TypeError as e:\n        raise TypeError(\"second elements are not mutually comparable: \" + str(e)) from e\n    return list(sorted_iterable)"}
{"task_id": "Mbpp/63", "solution": "class Pair:\n    \"\"\"Represents a validated 2-element numeric pair and computes its absolute difference.\"\"\"\n    def __init__(self, a, b):\n        self.a = a\n        self.b = b\n\n    def difference(self):\n        \"\"\"Returns the absolute difference between the pair's elements.\"\"\"\n        return abs(self.a - self.b)\n\nclass PairList:\n    \"\"\"Holds an ordered collection of Pair instances and produces a list of differences.\"\"\"\n    def __init__(self, pairs: list[Pair]):\n        self.pairs = pairs\n\n    def compute_differences(self) -> list:\n        \"\"\"Computes the difference for each pair in the list.\"\"\"\n        return [pair.difference() for pair in self.pairs]\n\nclass InputValidator:\n    \"\"\"Validates the input iterable and each pair for exactly two numeric elements.\"\"\"\n    def validate_pair(self, item) -> tuple:\n        \"\"\"Validates a single item to be a 2-element tuple of numbers.\"\"\"\n        if not isinstance(item, tuple) or len(item) != 2:\n            raise TypeError(\"Each item in the list must be a 2-element tuple.\")\n        \n        a, b = item\n        if not isinstance(a, (int, float)) or not isinstance(b, (int, float)):\n            raise TypeError(\"Each element within a pair must be an int or a float.\")\n        \n        return (a, b)\n\n    def validate_iterable(self, list_of_pairs) -> list:\n        \"\"\"Validates the entire iterable and its contained pairs.\"\"\"\n        if not hasattr(list_of_pairs, '__iter__'):\n            raise TypeError(\"Input must be an iterable (e.g., list or tuple).\")\n        \n        validated_tuples = []\n        for item in list_of_pairs:\n            validated_tuples.append(self.validate_pair(item))\n        \n        if not validated_tuples:\n            raise ValueError(\"Input list cannot be empty.\")\n            \n        return validated_tuples\n\nclass DifferenceCalculator:\n    \"\"\"Computes absolute differences |a - b| for a collection of validated pairs.\"\"\"\n    def compute(self, validated_pairs: list[tuple]) -> list:\n        \"\"\"Calculates the absolute difference for each validated pair.\"\"\"\n        pairs_obj = [Pair(a, b) for a, b in validated_pairs]\n        pair_list_obj = PairList(pairs_obj)\n        return pair_list_obj.compute_differences()\n\nclass MaxAggregator:\n    \"\"\"Selects the maximum numeric value from a list of numeric differences.\"\"\"\n    def aggregate_max(self, differences: list) -> (int | float):\n        \"\"\"Returns the maximum value from a list of differences.\"\"\"\n        if not differences:\n            raise ValueError(\"No differences to aggregate, the list is empty.\")\n        return max(differences)\n\nclass MaxDifferenceService:\n    \"\"\"Orchestrates validation, calculation, and aggregation to find the maximum difference.\"\"\"\n    def __init__(self, validator=None, calculator=None, aggregator=None):\n        self.validator = validator if validator is not None else InputValidator()\n        self.calculator = calculator if calculator is not None else DifferenceCalculator()\n        self.aggregator = aggregator if aggregator is not None else MaxAggregator()\n\n    def max_difference(self, list_of_pairs) -> (int | float):\n        \"\"\"Public API method to find the maximum difference in a list of pairs.\"\"\"\n        validated_pairs = self.validator.validate_iterable(list_of_pairs)\n        differences = self.calculator.compute(validated_pairs)\n        result = self.aggregator.aggregate_max(differences)\n        return result\n\ndef max_difference(list_of_pairs) -> (int | float):\n    \"\"\"\n    Finds the maximum difference between available pairs in the given tuple list.\n    assert max_difference([(3, 5), (1, 7), (10, 3), (1, 2)]) == 7\n    \"\"\"\n    service = MaxDifferenceService()\n    return service.max_difference(list_of_pairs)"}
{"task_id": "Mbpp/66", "solution": "def pos_count(numbers) -> int:\n    \"\"\"Count numbers strictly greater than zero.\n\n    Args:\n        numbers: list of numeric values (int or float).\n\n    Returns:\n        int: number of elements > 0\n    \"\"\"\n    count = 0\n    for n in numbers:\n        if n > 0:\n            count += 1\n    return count"}
{"task_id": "Mbpp/68", "solution": "class MonotonicChecker:\n    def _is_non_decreasing(self, values: list) -> bool:\n        \"\"\"Return True if for all i: values[i] <= values[i+1].\"\"\"\n        for i in range(1, len(values)):\n            if values[i] < values[i - 1]:\n                return False\n        return True\n\n    def _is_non_increasing(self, values: list) -> bool:\n        \"\"\"Return True if for all i: values[i] >= values[i+1].\"\"\"\n        for i in range(1, len(values)):\n            if values[i] > values[i - 1]:\n                return False\n        return True\n\n    def is_Monotonic(self, values: list) -> bool:\n        \"\"\"Return True if values is non-decreasing or non-increasing (adjacent equals allowed).\"\"\"\n        if len(values) <= 1:\n            return True\n        return self._is_non_decreasing(values) or self._is_non_increasing(values)\n\ndef is_Monotonic(values: list) -> bool:\n    \"\"\"Public API: return True if values is monotonic (non-increasing or non-decreasing).\"\"\"\n    checker = MonotonicChecker()\n    return checker.is_Monotonic(values)"}
{"task_id": "Mbpp/69", "solution": "from typing import Sequence, Any\n\ndef is_sublist(main_list: Sequence[Any], candidate_sublist: Sequence[Any]) -> bool:\n    \"\"\"Return True iff candidate_sublist appears as a contiguous subsequence of main_list.\n\n    The SRS defines 'sublist' strictly as contiguous subsequence.\n    \"\"\"\n    n = len(main_list)\n    m = len(candidate_sublist)\n\n    if m == 0:\n        return True\n    if m > n:\n        return False\n\n    for i in range(n - m + 1):\n        if main_list[i:i+m] == candidate_sublist:\n            return True\n    return False"}
{"task_id": "Mbpp/70", "solution": "import typing\n\nclass GetEqualService:\n    \"\"\"\n    Service class to encapsulate the logic for checking tuple length equality.\n    It is stateless and provides a single method for this purpose.\n    \"\"\"\n    def get_equal(self, tuples: typing.List[typing.Tuple]) -> bool:\n        \"\"\"\n        Determines if all tuples in the given list have the same length.\n        An empty list of tuples is considered to have all equal lengths (vacuously true).\n        \"\"\"\n        lengths = [len(t) for t in tuples]\n        if not lengths:\n            return True\n        first_length = lengths[0]\n        return all(length == first_length for length in lengths)\n\ndef get_equal(tuples: typing.List[typing.Tuple]) -> bool:\n    \"\"\"\n    Checks if all tuples in a list have the same length.\n    Delegates the core logic to GetEqualService.\n    \"\"\"\n    service = GetEqualService()\n    return service.get_equal(tuples)"}
{"task_id": "Mbpp/67", "solution": "class InputValidator:\n    def validate(self, n: int) -> bool:\n        \"\"\"Raise TypeError if n is not int; raise ValueError if n < 0; return True otherwise.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"n must be an integer\")\n        if n < 0:\n            raise ValueError(\"n must be non-negative\")\n        return True\n\nclass BellNumberResult:\n    def __init__(self, n: int, value: int) -> None:\n        self.n = n\n        self.value = value\n\nclass BellCalculator:\n    def bell_number(self, n: int) -> int:\n        \"\"\"\n        Validate n via InputValidator and compute Bell number B_n.\n        Raises TypeError or ValueError per InputValidator on invalid input.\n        Returns integer B_n on success.\n        \"\"\"\n        validator = InputValidator()\n        validator.validate(n)\n\n        if n == 0:\n            return 1\n\n        # Use dynamic programming to compute Stirling numbers of the second kind S(i, j)\n        # dp[i][j] will store S(i, j)\n        dp = [[0] * (n + 1) for _ in range(n + 1)]\n\n        # Base case: S(0,0) = 1\n        dp[0][0] = 1\n\n        for i in range(1, n + 1):\n            dp[i][0] = 0  # S(i,0) = 0 for i > 0\n            for j in range(1, i + 1):\n                # Recurrence relation: S(i,j) = S(i-1, j-1) + j * S(i-1, j)\n                dp[i][j] = dp[i-1][j-1] + j * dp[i-1][j]\n        \n        # The Bell number B_n is the sum of S(n, j) for j from 0 to n\n        b_n = sum(dp[n][j] for j in range(n + 1))\n        \n        return b_n\n\ndef bell_number(n: int) -> int:\n    \"\"\"Public API wrapper delegating to BellCalculator.bell_number.\"\"\"\n    return BellCalculator().bell_number(n)"}
{"task_id": "Mbpp/71", "solution": "from typing import List, Any\n\n_DEFAULT_SHRINK_FACTOR: float = 1.3\n\nclass Element:\n    \"\"\"Lightweight typed holder for a comparable value.\"\"\"\n    def __init__(self, value: Any) -> None:\n        self.value = value\n\nclass ListOfElements:\n    \"\"\"Wrapper for a collection of Element instances.\"\"\"\n    def __init__(self, elements: List[Any]) -> None:\n        self.elements: List[Element] = [Element(e) for e in elements]\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements.\"\"\"\n        return len(self.elements)\n\n    def to_values(self) -> List[Any]:\n        \"\"\"Extracts and returns the raw values from the elements.\"\"\"\n        return [e.value for e in self.elements]\n\nclass CombSortFunction:\n    \"\"\"Encapsulates algorithmic parameters and implements comb sort.\"\"\"\n    def __init__(self, name: str = \"comb_sort\", algorithm: str = \"comb sort\", shrink_factor: float = _DEFAULT_SHRINK_FACTOR) -> None:\n        self.name = name\n        self.algorithm = algorithm\n        self._shrink_factor = shrink_factor\n\n    def sort(self, inputList: List[Any]) -> List[Any]:\n        \"\"\"\n        Sorts a list of comparable values in ascending order using comb sort.\n        Returns a new sorted list, preserving multiplicity.\n        \"\"\"\n        data = list(inputList)  # Create a mutable copy of the input list\n        self._comb_sort(data)  # Sorts the list in-place\n        return data\n\n    def _comb_sort(self, data: List[Any]) -> None:\n        \"\"\"Internal method implementing the comb sort algorithm.\"\"\"\n        n = len(data)\n        if n <= 1:\n            return\n\n        gap = n\n        swapped = True\n\n        while gap > 1 or swapped:\n            gap = int(gap / self._shrink_factor)\n            if gap < 1:\n                gap = 1\n\n            swapped = False\n            for i in range(n - gap):\n                if data[i] > data[i + gap]:\n                    data[i], data[i + gap] = data[i + gap], data[i]\n                    swapped = True\n\ndef comb_sort(input_list: List[Any]) -> List[Any]:\n    \"\"\"\n    Sorts a list of elements using the Comb Sort algorithm.\n    It returns a new list with elements sorted in ascending order.\n    \"\"\"\n    sorter = CombSortFunction()\n    return sorter.sort(input_list)"}
{"task_id": "Mbpp/72", "solution": "def dif_Square(n: int) -> bool:\n    \"\"\"Return True if integer n can be expressed as a^2 - b^2 for integers a,b, else False.\n    This is true if and only if n is not congruent to 2 modulo 4.\"\"\"\n    return (n % 4) != 2"}
{"task_id": "Mbpp/75", "solution": "from typing import List, Tuple\n\nclass FindTuplesService:\n    \"\"\"Service to find tuples where all elements are divisible by k.\"\"\"\n\n    def is_all_elements_divisible(self, t: Tuple[int, ...], k: int) -> bool:\n        \"\"\"Checks if every element in a tuple is divisible by k.\"\"\"\n        for e in t:\n            if e % k != 0:\n                return False\n        return True\n\n    def find_tuples(self, list_of_tuples: List[Tuple[int, ...]], k: int) -> List[Tuple[int, ...]]:\n        \"\"\"Evaluates each tuple and returns a list of tuples where all elements are divisible by k.\"\"\"\n        result = []\n        for t in list_of_tuples:\n            if self.is_all_elements_divisible(t, k):\n                result.append(t)\n        return result\n\ndef find_tuples(list_of_tuples: List[Tuple[int, ...]], k: int) -> List[Tuple[int, ...]]:\n    \"\"\"\n    Finds tuples from a list where all elements are divisible by k.\n    This function acts as a public API facade, delegating to FindTuplesService.\n    \"\"\"\n    service = FindTuplesService()\n    return service.find_tuples(list_of_tuples, k)"}
