{"task_id": "Mbpp/123", "solution": "import math\nfrom typing import Dict, List, Set\n\nclass InputValidator:\n    def validate(self, n: int) -> None:\n        \"\"\"Validates that n is an integer greater than or equal to 1.\"\"\"\n        if not isinstance(n, int) or n < 1:\n            raise ValueError(\"n must be an integer >= 1\")\n\nclass DivisorCalculator:\n    def __init__(self):\n        self._divisor_cache: Dict[int, int] = {}\n\n    def sum_proper_divisors(self, x: int) -> int:\n        \"\"\"Calculates the sum of proper divisors for a given number x, using a cache.\"\"\"\n        if x in self._divisor_cache:\n            return self._divisor_cache[x]\n        \n        if x <= 1:\n            self._divisor_cache[x] = 0\n            return 0\n\n        total_sum = 1 # 1 is always a proper divisor for x > 1\n        limit = math.isqrt(x)\n        for i in range(2, limit + 1):\n            if x % i == 0:\n                total_sum += i\n                if i * i != x:\n                    total_sum += x // i\n        \n        self._divisor_cache[x] = total_sum\n        return total_sum\n\nclass Number:\n    def __init__(self, value: int, divisor_sum: int, is_amicable: bool):\n        \"\"\"Initializes a Number object with its value, sum of proper divisors, and amicability status.\"\"\"\n        self.value = value\n        self.divisor_sum = divisor_sum\n        self.is_amicable = is_amicable\n\nclass AmicablePair:\n    def __init__(self, a: Number, b: Number):\n        \"\"\"Initializes an AmicablePair with two Number objects.\"\"\"\n        self.a = a\n        self.b = b\n\nclass AmicableDetector:\n    def __init__(self, divisor_calculator: DivisorCalculator):\n        \"\"\"Initializes the AmicableDetector with a DivisorCalculator instance.\"\"\"\n        self._divisor_calculator = divisor_calculator\n\n    def is_amicable(self, a: int) -> bool:\n        \"\"\"Checks if a given number 'a' is part of an amicable pair.\"\"\"\n        b = self._divisor_calculator.sum_proper_divisors(a)\n        if b <= 1 or a == b:\n            return False\n        \n        s_b = self._divisor_calculator.sum_proper_divisors(b)\n        return s_b == a\n\n    def find_amicable_pairs_up_to(self, n: int) -> List[AmicablePair]:\n        \"\"\"Finds all amicable pairs where at least one member is less than or equal to n.\"\"\"\n        pairs: List[AmicablePair] = []\n        seen_numbers: Set[int] = set()\n\n        for num_a in range(1, n + 1):\n            if num_a in seen_numbers:\n                continue\n\n            sum_div_a = self._divisor_calculator.sum_proper_divisors(num_a)\n            num_b = sum_div_a\n\n            if num_a == num_b:\n                continue\n            \n            sum_div_b = self._divisor_calculator.sum_proper_divisors(num_b)\n\n            if sum_div_b == num_a:\n                # Found an amicable pair (num_a, num_b)\n                if num_a < num_b: # Ensure deterministic ordering and avoid duplicates\n                    number_a = Number(value=num_a, divisor_sum=sum_div_a, is_amicable=True)\n                    number_b = Number(value=num_b, divisor_sum=sum_div_b, is_amicable=True)\n                    pairs.append(AmicablePair(a=number_a, b=number_b))\n                    seen_numbers.add(num_a)\n                    seen_numbers.add(num_b)\n                elif num_b < num_a: # Mark num_a as seen if its pair was already processed\n                    seen_numbers.add(num_a)\n                    seen_numbers.add(num_b)\n        return pairs\n\nclass ResultAggregator:\n    def __init__(self, detector: AmicableDetector):\n        \"\"\"Initializes the ResultAggregator with an AmicableDetector instance.\"\"\"\n        self._detector = detector\n\n    def amicable_numbers_sum(self, n: int) -> int:\n        \"\"\"Aggregates and sums unique amicable numbers from 1 to n.\"\"\"\n        pairs = self._detector.find_amicable_pairs_up_to(n)\n        \n        amicable_members: Set[int] = set()\n        for pair in pairs:\n            if 1 <= pair.a.value <= n:\n                amicable_members.add(pair.a.value)\n            if 1 <= pair.b.value <= n:\n                amicable_members.add(pair.b.value)\n                \n        return sum(amicable_members) if amicable_members else 0\n\ndef amicable_numbers_sum(n: int) -> int:\n    \"\"\"Sums all amicable numbers from 1 to a specified number n.\"\"\"\n    InputValidator().validate(n)\n    \n    divisor_calculator = DivisorCalculator()\n    amicable_detector = AmicableDetector(divisor_calculator)\n    result_aggregator = ResultAggregator(amicable_detector)\n    \n    return result_aggregator.amicable_numbers_sum(n)"}
{"task_id": "Mbpp/125", "solution": "class BinaryString:\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        return len(self.value)\n\nclass Validator:\n    def is_valid(self, binary: BinaryString) -> bool:\n        return all(char in ('0', '1') for char in binary.value)\n\nclass FindLengthFunction:\n    def execute(self, binary: BinaryString) -> int:\n        \"\"\"Applies Kadane's algorithm to find the maximum difference.\"\"\"\n        max_so_far = 0\n        current_max = 0\n\n        for char in binary.value:\n            if char == '0':\n                current_max += 1\n            else: # char == '1'\n                current_max -= 1\n            \n            if current_max < 0:\n                current_max = 0\n            \n            max_so_far = max(max_so_far, current_max)\n        \n        return max_so_far\n\ndef find_length(binary_string: str) -> int:\n    \"\"\"\n    Finds the maximum difference (#0s - #1s) in any substring of the binary string.\n    Uses a Kadane-like algorithm mapping '0' to +1 and '1' to -1.\n    \"\"\"\n    b = BinaryString(binary_string)\n    validator = Validator()\n    if not validator.is_valid(b):\n        raise ValueError(\"Input must contain only '0' and '1'\")\n    \n    algo = FindLengthFunction()\n    return algo.execute(b)"}
{"task_id": "Mbpp/126", "solution": "from math import isqrt\n\ndef _compute_gcd(x: int, y: int) -> int:\n    \"\"\"Computes the greatest common divisor of two non-negative integers using the Euclidean algorithm.\"\"\"\n    while y:\n        x, y = y, x % y\n    return x\n\ndef _sum_divisors_of(n: int) -> int:\n    \"\"\"Calculates the sum of positive divisors for a given non-negative integer n.\"\"\"\n    if n == 0:\n        return 0\n    sum_val = 0\n    for i in range(1, isqrt(n) + 1):\n        if n % i == 0:\n            sum_val += i\n            if i * i != n:\n                sum_val += n // i\n    return sum_val\n\ndef sum(a: int, b: int) -> int:\n    \"\"\"\n    Finds the sum of common divisors of two given numbers.\n    Operates on absolute values of inputs.\n    \"\"\"\n    a_abs = abs(a)\n    b_abs = abs(b)\n\n    if a_abs == 0 and b_abs == 0:\n        return 0\n\n    common_divisor_gcd = _compute_gcd(a_abs, b_abs)\n    return _sum_divisors_of(common_divisor_gcd)"}
{"task_id": "Mbpp/128", "solution": "from typing import List, Sequence, Union\n\ndef _tokenize_words(words: Union[str, Sequence[str]]) -> List[str]:\n    \"\"\"\n    Splits a string into words by whitespace or converts a sequence of words into a list.\n    Preserves the order of words.\n    \"\"\"\n    if isinstance(words, str):\n        return words.split()\n    return list(words)\n\ndef long_words(n: int, words: Union[str, Sequence[str]]) -> List[str]:\n    \"\"\"\n    Finds words from a given string or sequence of words that are longer than n characters.\n    The order of words is preserved.\n    \"\"\"\n    tokens = _tokenize_words(words)\n    result = []\n    for word in tokens:\n        if len(word) > n:\n            result.append(word)\n    return result"}
{"task_id": "Mbpp/129", "solution": "class Matrix:\n    \"\"\"Represents an n x n matrix of integer values.\"\"\"\n    def __init__(self, values: list[list[int]]):\n        self.values = values\n        self.n = len(values) if values else 0\n\nclass Cell:\n    \"\"\"Value object for a single cell (row, col, value).\"\"\"\n    def __init__(self, row: int, col: int, value: int):\n        self.row = row\n        self.col = col\n        self.value = value\n\nclass ValidationReport:\n    \"\"\"Collects validation outcome and failure messages.\"\"\"\n    def __init__(self):\n        self.is_magic = False\n        self.failures: list[str] = []\n\n    def add_failure(self, msg: str):\n        \"\"\"Adds a failure message and sets the report to not magic.\"\"\"\n        self.failures.append(msg)\n        self.is_magic = False\n\n    def set_magic(self, value: bool):\n        \"\"\"Sets the magic square status.\"\"\"\n        self.is_magic = value\n\nclass MagicSquareChecker:\n    \"\"\"Implements the logic to check if a matrix is a magic square.\"\"\"\n\n    def magic_square_test(self, matrix: list[list[int]]) -> bool:\n        \"\"\"Performs a full validation of the matrix and returns True if it's a magic square.\"\"\"\n        report = self.validate(matrix)\n        return report.is_magic\n\n    def validate(self, matrix: list[list[int]]) -> ValidationReport:\n        \"\"\"Performs a series of checks to validate if the matrix is a magic square.\"\"\"\n        report = ValidationReport()\n\n        if not self._check_shape(matrix, report):\n            return report\n\n        n = len(matrix)\n        \n        if not self._check_type_and_range(matrix, n, report):\n            return report\n        \n        if not self._check_uniqueness(matrix, n, report):\n            return report\n            \n        target_sum = self.compute_magic_sum(n)\n        \n        if not self._check_rows(matrix, target_sum, report):\n            return report\n            \n        if not self._check_columns(matrix, target_sum, report):\n            return report\n            \n        if not self._check_diagonals(matrix, target_sum, report):\n            return report\n            \n        report.set_magic(True)\n        return report\n\n    def compute_magic_sum(self, n: int) -> int:\n        \"\"\"Computes the magic sum for an n x n magic square.\"\"\"\n        return n * (n * n + 1) // 2\n\n    def _check_shape(self, values: list[list[int]], report: ValidationReport) -> bool:\n        \"\"\"Checks if the matrix is non-empty and square.\"\"\"\n        if not values:\n            report.add_failure(\"Matrix is empty.\")\n            return False\n        \n        n = len(values)\n        for i, row in enumerate(values):\n            if len(row) != n:\n                report.add_failure(f\"Matrix is not square: row {i} has length {len(row)}, expected {n}.\")\n                return False\n        return True\n\n    def _check_type_and_range(self, values: list[list[int]], n: int, report: ValidationReport) -> bool:\n        \"\"\"Checks if all elements are within the range 1 to n*n.\"\"\"\n        max_val = n * n\n        for r_idx, row in enumerate(values):\n            for c_idx, val in enumerate(row):\n                if not (1 <= val <= max_val):\n                    report.add_failure(f\"Cell ({r_idx},{c_idx}) value {val} is not in range 1..{max_val}.\")\n                    return False\n        return True\n\n    def _check_uniqueness(self, values: list[list[int]], n: int, report: ValidationReport) -> bool:\n        \"\"\"Checks if the matrix contains all integers from 1 to n*n exactly once.\"\"\"\n        seen = set()\n        expected_count = n * n\n        \n        for row in values:\n            for val in row:\n                if val in seen:\n                    report.add_failure(f\"Duplicate value found: {val}.\")\n                    return False\n                seen.add(val)\n        \n        if len(seen) != expected_count:\n            report.add_failure(f\"Not all numbers from 1 to {expected_count} are present exactly once.\")\n            return False\n            \n        return True\n\n    def _check_rows(self, values: list[list[int]], target_sum: int, report: ValidationReport) -> bool:\n        \"\"\"Checks if every row sums to the target sum.\"\"\"\n        for r_idx, row in enumerate(values):\n            if sum(row) != target_sum:\n                report.add_failure(f\"Row {r_idx} sum is {sum(row)}, expected {target_sum}.\")\n                return False\n        return True\n\n    def _check_columns(self, values: list[list[int]], target_sum: int, report: ValidationReport) -> bool:\n        \"\"\"Checks if every column sums to the target sum.\"\"\"\n        n = len(values)\n        for c_idx in range(n):\n            col_sum = 0\n            for r_idx in range(n):\n                col_sum += values[r_idx][c_idx]\n            if col_sum != target_sum:\n                report.add_failure(f\"Column {c_idx} sum is {col_sum}, expected {target_sum}.\")\n                return False\n        return True\n\n    def _check_diagonals(self, values: list[list[int]], target_sum: int, report: ValidationReport) -> bool:\n        \"\"\"Checks if both main diagonals sum to the target sum.\"\"\"\n        n = len(values)\n        diag1_sum = 0\n        diag2_sum = 0\n        \n        for i in range(n):\n            diag1_sum += values[i][i]\n            diag2_sum += values[i][n - 1 - i]\n        \n        if diag1_sum != target_sum:\n            report.add_failure(f\"Main diagonal sum is {diag1_sum}, expected {target_sum}.\")\n            return False\n        \n        if diag2_sum != target_sum:\n            report.add_failure(f\"Anti-diagonal sum is {diag2_sum}, expected {target_sum}.\")\n            return False\n            \n        return True\n\ndef magic_square_test(matrix: list[list[int]]) -> bool:\n    \"\"\"\n    Calculates whether the given matrix is a magic square.\n    A magic square is a square matrix where the sum of numbers in each row,\n    each column, and both main diagonals is the same.\n    \"\"\"\n    checker = MagicSquareChecker()\n    return checker.magic_square_test(matrix)"}
{"task_id": "Mbpp/130", "solution": "from typing import Dict, List\n\nclass FrequencyMap:\n    \"\"\"Helper class to manage item frequencies.\"\"\"\n    def __init__(self):\n        self.map: Dict[int, int] = {}\n\n    def increment(self, value: int) -> None:\n        \"\"\"Increments the count for a given value.\"\"\"\n        self.map[value] = self.map.get(value, 0) + 1\n\n    def getMaxCount(self) -> int:\n        \"\"\"Returns the maximum frequency count.\"\"\"\n        if not self.map:\n            return 0\n        return max(self.map.values())\n\n    def getElementsWithCount(self, count: int) -> List[int]:\n        \"\"\"Returns all elements that have a specific frequency count.\"\"\"\n        return [item for item, freq in self.map.items() if freq == count]\n\ndef buildFrequencyMap(input_list: List[int]) -> FrequencyMap:\n    \"\"\"Builds a FrequencyMap from the input list.\"\"\"\n    freq_map = FrequencyMap()\n    for item in input_list:\n        freq_map.increment(item)\n    return freq_map\n\ndef selectWinner(freq_map: FrequencyMap, input_list: List[int]) -> int:\n    \"\"\"Selects the winning element, resolving ties by earliest occurrence.\"\"\"\n    max_count = freq_map.getMaxCount()\n    candidates = freq_map.getElementsWithCount(max_count)\n\n    if len(candidates) == 1:\n        return candidates[0]\n    else:\n        # Resolve ties by earliest occurrence in the original list\n        for item in input_list:\n            if item in candidates:\n                return item\n        # This case should not be reached if input_list is non-empty and candidates is not empty.\n        # Returning a default or raising an error could be an option, but design implies valid state.\n        return candidates[0] # Fallback, if for some reason list scan fails, pick first candidate\n\ndef max_occurrences(input_list: List[int]) -> int:\n    \"\"\"\n    Finds the item with maximum frequency in a given list.\n    Resolves ties by returning the element that appears earliest in the original list.\n    \"\"\"\n    freq_map = buildFrequencyMap(input_list)\n    return selectWinner(freq_map, input_list)"}
{"task_id": "Mbpp/131", "solution": "class VowelSet:\n    def __init__(self) -> None:\n        \"\"\"Initializes the set of valid vowels.\"\"\"\n        self.vowels = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n\n    def is_vowel(self, ch: str) -> bool:\n        \"\"\"Checks if a given character is a vowel.\"\"\"\n        return ch in self.vowels\n\nclass ReverseVowelsFunction:\n    def __init__(self, _vowel_set: VowelSet) -> None:\n        \"\"\"Initializes the function with a VowelSet instance.\"\"\"\n        self._vowel_set = _vowel_set\n\n    def execute(self, input: str) -> str:\n        \"\"\"Orchestrates the reversal of vowels in the input string.\"\"\"\n        vowel_positions, extracted_vowels = self._extract_vowel_positions_and_chars(input)\n        \n        reversed_vowels = extracted_vowels[::-1] # Reverse the list of extracted vowels\n\n        return self._place_reversed_vowels(input, vowel_positions, reversed_vowels)\n\n    def _extract_vowel_positions_and_chars(self, s: str) -> (list[int], list[str]):\n        \"\"\"Extracts positions and characters of vowels from the string.\"\"\"\n        positions = []\n        chars = []\n        for i, ch in enumerate(s):\n            if self._vowel_set.is_vowel(ch):\n                positions.append(i)\n                chars.append(ch)\n        return positions, chars\n\n    def _place_reversed_vowels(self, s: str, positions: list[int], reversed_vowels: list[str]) -> str:\n        \"\"\"Constructs a new string with reversed vowels placed at their original positions.\"\"\"\n        s_list = list(s) # Convert string to list for mutable access\n        for i, pos in enumerate(positions):\n            s_list[pos] = reversed_vowels[i]\n        return \"\".join(s_list)\n\ndef reverse_vowels(input: str) -> str:\n    \"\"\"Reverses only the vowels in the input string.\"\"\"\n    if not isinstance(input, str):\n        raise TypeError(\"Input must be a string.\")\n    if not input:\n        return \"\"\n\n    vowel_set_instance = VowelSet()\n    reverse_vowels_function_instance = ReverseVowelsFunction(_vowel_set=vowel_set_instance)\n    return reverse_vowels_function_instance.execute(input)"}
