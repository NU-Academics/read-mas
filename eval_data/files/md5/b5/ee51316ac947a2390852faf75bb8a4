{"task_id": "Mbpp/87", "solution": "def merge_dictionaries_three(dict1: dict, dict2: dict, dict3: dict) -> dict:\n    \"\"\"Validate inputs are dict, merge keys (left-to-right precedence) and return new dict without mutating inputs.\"\"\"\n    if not isinstance(dict1, dict):\n        raise TypeError(\"Argument dict1 must be a dictionary.\")\n    if not isinstance(dict2, dict):\n        raise TypeError(\"Argument dict2 must be a dictionary.\")\n    if not isinstance(dict3, dict):\n        raise TypeError(\"Argument dict3 must be a dictionary.\")\n\n    # Merge dictionaries with left-to-right precedence (dict1, then dict2, then dict3).\n    # Python's dictionary unpacking {**d1, **d2, ...} processes keys from left to right,\n    # with later (rightmost) dictionaries overwriting earlier (leftmost) ones for common keys.\n    # To achieve dict1 highest precedence, then dict2, then dict3, we unpack in reverse order:\n    # first dict3 (lowest precedence), then dict2, then dict1 (highest precedence).\n    result_dict = {**dict3, **dict2, **dict1}\n    \n    return result_dict"}
{"task_id": "Mbpp/94", "solution": "def _validate_input(inputList):\n    \"\"\"Validate that inputList is a list/sequence and each element is a tuple of length 2.\n    Raises ValueError on failure.\n    \"\"\"\n    if not isinstance(inputList, list):\n        raise ValueError(\"Input must be a list.\")\n\n    for item in inputList:\n        if not isinstance(item, tuple) or len(item) != 2:\n            raise ValueError(\"Each element in the list must be a 2-element tuple.\")\n\n\ndef index_minimum(inputList):\n    \"\"\"Return the first element of the tuple with the smallest second element.\n\n    Parameters:\n    - inputList: a list/sequence of 2-element tuples (parameter name must be inputList).\n\n    Raises:\n    - ValueError: if inputList fails validation (non-list, tuple elements not length 2, etc.).\n    \"\"\"\n    _validate_input(inputList)\n\n    min_tuple = min(inputList, key=lambda t: t[1])\n    return min_tuple[0]"}
{"task_id": "Mbpp/93", "solution": "class PowerFunction:\n    \"\"\"Encapsulates the logic to compute a number raised to a power.\"\"\"\n    def __init__(self, a: float, b: float) -> None:\n        \"\"\"\n        Initializes the PowerFunction with base 'a' and exponent 'b'.\n        Converts inputs to float for calculation.\n        \"\"\"\n        self.a = float(a)\n        self.b = float(b)\n\n    def compute(self) -> float:\n        \"\"\"\n        Calculates 'a' to the power 'b'.\n        \"\"\"\n        return self.a ** self.b\n\ndef power(a, b) -> float:\n    \"\"\"\n    Calculates the value of 'a' to the power 'b'.\n    \"\"\"\n    power_fn = PowerFunction(a, b)\n    return power_fn.compute()"}
{"task_id": "Mbpp/95", "solution": "def Find_Min_Length(list_of_lists):\n    \"\"\"\n    Compute and return the length of the smallest inner list in list_of_lists.\n\n    Notes: Behavior for empty outer list or non-list inner elements is unspecified by SRS; function uses built-in len() on each element and returns min(...).\n    \"\"\"\n    return min(len(inner) for inner in list_of_lists)"}
{"task_id": "Mbpp/96", "solution": "import math\n\ndef divisor(n: int) -> int:\n    \"\"\"\n    Calculates the number of positive divisors for a given integer n.\n    Raises TypeError if n is not an int, ValueError if n is zero.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n == 0:\n        raise ValueError(\"divisors for 0 are undefined\")\n\n    m = abs(n)\n    count = 0\n    # Iterate from 1 up to the square root of m\n    # If i divides m, then m/i also divides m.\n    # We only need to check up to sqrt(m) to find all pairs of divisors.\n    for i in range(1, int(math.sqrt(m)) + 1):\n        if m % i == 0:\n            if i * i == m:\n                # If i*i == m, i is a perfect square root, count it once\n                count += 1\n            else:\n                # Otherwise, i and m/i are two distinct divisors\n                count += 2\n    return count"}
{"task_id": "Mbpp/92", "solution": "from typing import List\n\nclass Number:\n    \"\"\"Represents an integer value and provides digit extraction.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def toDigits(self) -> List[int]:\n        \"\"\"Extracts decimal digits of the absolute value, most-significant-digit first.\"\"\"\n        abs_value = abs(self.value)\n        if abs_value == 0:\n            return [0]\n        return [int(d) for d in str(abs_value)]\n\nclass DigitSequence:\n    \"\"\"Represents a sequence of digits and provides basic queries.\"\"\"\n    def __init__(self, digits: List[int]):\n        self.digits = digits\n\n    def length(self) -> int:\n        \"\"\"Returns the number of digits in the sequence.\"\"\"\n        return len(self.digits)\n\nclass Result:\n    \"\"\"Encapsulates the boolean undulating result.\"\"\"\n    def __init__(self, isUndulating: bool):\n        self._isUndulating = isUndulating\n\n    @property\n    def isUndulating(self) -> bool:\n        \"\"\"The undulating status.\"\"\"\n        return self._isUndulating\n\nclass IsUndulatingService:\n    \"\"\"Provides the business logic for checking if a number is undulating.\"\"\"\n    def __init__(self):\n        pass\n\n    def is_undulating(self, number_obj: 'Number') -> bool:\n        \"\"\"Checks if the given number's digit sequence is undulating.\"\"\"\n        digits = number_obj.toDigits()\n        digit_sequence = DigitSequence(digits)\n\n        if digit_sequence.length() < 2:\n            return False\n\n        distinct_digits_set = set(digits)\n        if len(distinct_digits_set) != 2:\n            return False\n\n        # If we reach here, we have at least two digits and exactly two distinct digits.\n        # Now, check for strict alternation.\n        # The first two digits (digits[0] and digits[1]) must be the two distinct digits\n        # and they must be different from each other.\n        d1 = digits[0]\n        d2 = digits[1]\n\n        if d1 == d2:\n            # This handles cases like 1121 where distinct count is 2 but alternation fails early.\n            return False\n\n        # Check if the pattern (d1, d2, d1, d2, ...) holds for the entire sequence.\n        for i in range(digit_sequence.length()):\n            expected_digit = d1 if i % 2 == 0 else d2\n            if digits[i] != expected_digit:\n                return False\n\n        # All checks passed, it's an undulating number.\n        return True\n\n\ndef is_undulating(number: int) -> bool:\n    \"\"\"\n    Checks whether the given number is undulating or not.\n    An undulating number has at least two digits, exactly two distinct digits,\n    and these digits strictly alternate throughout the sequence.\n    \"\"\"\n    number_obj = Number(number)\n    service = IsUndulatingService()\n    return service.is_undulating(number_obj)"}
{"task_id": "Mbpp/98", "solution": "from typing import Sequence\n\ndef multiply_num(seq: Sequence[float | int]) -> float:\n    \"\"\"\n    Multiplies all numbers in a sequence and divides by its length.\n    \"\"\"\n    product = 1.0\n    for num in seq:\n        product *= num\n    \n    length = len(seq)\n    result = product / length\n    return result"}
{"task_id": "Mbpp/99", "solution": "class InputParameter:\n    \"\"\"Value object holding the input parameter.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n\nclass BinaryString:\n    \"\"\"Value object representing the binary string result.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\nclass DecimalToBinaryFunction:\n    \"\"\"Encapsulates validation and conversion algorithm.\"\"\"\n    name: str = 'decimal_to_binary'\n\n    def validateInput(self, n: any) -> bool:\n        \"\"\"Returns True if n is a non-negative integer, otherwise False.\"\"\"\n        return isinstance(n, int) and n >= 0\n\n    def execute(self, n: int) -> str:\n        \"\"\"Validates n and returns its binary string representation with no leading zeros.\"\"\"\n        if not self.validateInput(n):\n            raise ValueError(\"Input must be a non-negative integer.\")\n\n        # The design allows for built-in formatting. bin() returns a string like '0b1000'.\n        # Slicing [2:] removes the '0b' prefix.\n        # For n=0, bin(0) is '0b0', [2:] yields '0', which satisfies \"no leading zeros\" for zero.\n        binary_representation = bin(n)[2:]\n        return BinaryString(binary_representation).value\n\nclass TestCase:\n    \"\"\"Represents and runs a unit test case.\"\"\"\n    def __init__(self, input: int, expectedOutput: str):\n        self.input = input\n        self.expectedOutput = expectedOutput\n\n    def run(self) -> bool:\n        \"\"\"Calls decimal_to_binary and returns True if the result matches expectedOutput.\"\"\"\n        result = decimal_to_binary(self.input)\n        return result == self.expectedOutput\n\ndef decimal_to_binary(n) -> str:\n    \"\"\"\n    Converts a decimal number to its binary equivalent, represented as a string with no leading zeros.\n    The function delegates to DecimalToBinaryFunction for validation and conversion.\n    \"\"\"\n    converter = DecimalToBinaryFunction()\n    return converter.execute(n)"}
{"task_id": "Mbpp/97", "solution": "from collections import Counter\n\ndef frequency_lists(list_of_lists):\n    \"\"\"\n    Flattens a list of lists and computes the frequency of each element.\n    Returns a dictionary mapping each unique element to its count.\n    \"\"\"\n    flattened_list = [item for sublist in list_of_lists for item in sublist]\n    return Counter(flattened_list)"}
{"task_id": "Mbpp/101", "solution": "def kth_element(arr, k):\n    \"\"\"Return the element at 1-based index k in arr.\n\n    Behavior for invalid k (<=0 or > len(arr)) or non-integer k is unspecified by the SRS and therefore not implemented beyond standard Python IndexError behavior if k is out-of-range when converted to zero-based index.\n    \"\"\"\n    return arr[k - 1]"}
{"task_id": "Mbpp/102", "solution": "def _capitalize_word(word: str) -> str:\n    \"\"\"Capitalizes the first letter of a word.\"\"\"\n    return word.capitalize()\n\ndef _split_on_underscore(input_string: str) -> list:\n    \"\"\"Splits a string by underscores, preserving empty segments.\"\"\"\n    return input_string.split('_')\n\ndef snake_to_camel(input_string: str) -> str:\n    \"\"\"\n    Converts a snake case string to a camel case (PascalCase) string.\n    Splits the string by underscores, capitalizes each word, and concatenates them.\n    \"\"\"\n    words = _split_on_underscore(input_string)\n    camel_cased_words = [_capitalize_word(word) for word in words]\n    return \"\".join(camel_cased_words)"}
{"task_id": "Mbpp/100", "solution": "import collections\n\ndef next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome of a specified integer, returned as an integer.\n    Handles input validation for integers and the all-9s special case.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n\n    s = str(n)\n    length = len(s)\n    digits = [int(d) for d in s]\n\n    # Special case: all nines (e.g., 9, 99, 999)\n    if all(d == 9 for d in digits):\n        return int('1' + '0' * (length - 1) + '1')\n\n    # Helper to mirror the left half to the right\n    def _mirror_left_to_right(d: list[int]) -> list[int]:\n        half = (len(d) + 1) // 2\n        for i in range(len(d) // 2):\n            d[len(d) - 1 - i] = d[i]\n        return d\n\n    # Helper to increment the middle digit(s) and handle carry\n    def _increment_middle(d: list[int]) -> list[int]:\n        mid = (len(d) - 1) // 2\n        carry = 1\n        i = mid\n        while i >= 0 and carry > 0:\n            d[i] += carry\n            carry = d[i] // 10\n            d[i] %= 10\n            i -= 1\n        return d\n\n    # Create initial candidate by mirroring left to right\n    candidate_digits = list(digits) # Make a copy to avoid modifying original 'digits' directly\n    candidate_digits = _mirror_left_to_right(candidate_digits)\n    candidate_int = int(\"\".join(map(str, candidate_digits)))\n\n    if candidate_int > n:\n        return candidate_int\n    else:\n        # If candidate is not greater than n, increment the middle part and mirror again\n        digits_after_increment = _increment_middle(digits) # Use the original digits for increment\n        final_digits = _mirror_left_to_right(digits_after_increment)\n        final_int = int(\"\".join(map(str, final_digits)))\n        return final_int"}
{"task_id": "Mbpp/104", "solution": "from typing import Sequence, List\n\ndef _sort_sublist(sublist: Sequence[str]) -> List[str]:\n    \"\"\"Sorts a single sublist of strings lexicographically.\"\"\"\n    return sorted(sublist)\n\ndef sort_sublists(sequence: Sequence[Sequence[str]]) -> List[List[str]]:\n    \"\"\"\n    Sorts each sublist of strings in a given list of lists.\n    Returns a new list of lists where each sublist's strings are sorted.\n    \"\"\"\n    return [_sort_sublist(sublist) for sublist in sequence]"}
{"task_id": "Mbpp/105", "solution": "from typing import List\n\ndef count(items: list) -> int:\n    \"\"\"Return the number of elements equal to the boolean value True in 'items'.\n\n    Count only elements that are the boolean value True.\n    \"\"\"\n    counter = 0\n    for x in items:\n        if isinstance(x, bool) and x is True:\n            counter += 1\n    return counter"}
{"task_id": "Mbpp/103", "solution": "import math\nfrom typing import Dict, Optional, Tuple\n\nclass ValidationError(Exception):\n    \"\"\"\n    Exception raised for invalid input parameters to the Eulerian number function.\n    \"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\nclass Cache:\n    \"\"\"\n    A simple in-memory cache for Eulerian numbers (n, m) -> value.\n    \"\"\"\n    def __init__(self) -> None:\n        self._memo: Dict[Tuple[int, int], int] = {}\n\n    def get(self, n: int, m: int) -> Optional[int]:\n        \"\"\"Retrieves a cached value for (n, m), or None if not found.\"\"\"\n        return self._memo.get((n, m))\n\n    def put(self, n: int, m: int, value: int) -> None:\n        \"\"\"Stores a value for (n, m) in the cache.\"\"\"\n        self._memo[(n, m)] = value\n\nclass EulerianFunction:\n    \"\"\"\n    Encapsulates validation and computation logic for Eulerian numbers.\n    Uses dynamic programming with optional caching.\n    \"\"\"\n    def __init__(self, cache: Optional[Cache] = None) -> None:\n        self._cache = cache\n\n    def validateInputs(self, n: int, m: int) -> None:\n        \"\"\"\n        Validates if n and m are integers and within valid ranges.\n        Raises ValidationError if inputs are invalid.\n        \"\"\"\n        if not isinstance(n, int):\n            raise ValidationError(f\"Invalid type for n: expected int, got {type(n).__name__}\")\n        if not isinstance(m, int):\n            raise ValidationError(f\"Invalid type for m: expected int, got {type(m).__name__}\")\n\n        if n < 0:\n            raise ValidationError(f\"Invalid value for n: expected n >= 0, got {n}\")\n        if m < 0:\n            raise ValidationError(f\"Invalid value for m: expected m >= 0, got {m}\")\n        if m >= n:\n            raise ValidationError(f\"Invalid value for m: expected m < n, got n={n}, m={m}\")\n\n    def compute(self, n: int, m: int) -> int:\n        \"\"\"\n        Computes the Eulerian number a(n, m) after validating inputs.\n        Uses cache if available.\n        \"\"\"\n        self.validateInputs(n, m)\n\n        if self._cache:\n            cached_value = self._cache.get(n, m)\n            if cached_value is not None:\n                return cached_value\n\n        result = self.computeWithDP(n, m)\n\n        if self._cache:\n            self._cache.put(n, m, result)\n\n        return result\n\n    def computeWithDP(self, n: int, m: int) -> int:\n        \"\"\"\n        Computes the Eulerian number a(n, m) using dynamic programming.\n        Assumes inputs are already validated: n >= 0 and 0 <= m < n.\n        \"\"\"\n        # dp[i][j] stores a(i, j) for i from 0 to n and j from 0 to i-1.\n        # The table size is (n+1) x (n+1) for simpler indexing (j up to n-1).\n        dp = [[0] * (n + 1) for _ in range(n + 1)]\n\n        # Base case: a(i, 0) = 1 for i >= 0.\n        for i in range(n + 1):\n            dp[i][0] = 1\n\n        # Fill the DP table using the recurrence relation.\n        # a(i, j) = (j + 1) * a(i - 1, j) + (i - j) * a(i - 1, j - 1)\n        for i in range(1, n + 1): # For current 'n' from 1 up to the target 'n'\n            for j in range(1, i): # For current 'm' from 1 up to 'i-1'\n                dp[i][j] = (j + 1) * dp[i-1][j] + (i - j) * dp[i-1][j-1]\n        \n        return dp[n][m]\n\n# A global cache instance to be used across all calls to eulerian_num for efficiency.\n_global_eulerian_cache = Cache()\n\ndef eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Calculates the Eulerian number A(n, m), representing the number of permutations\n    of {1, ..., n} with m ascents.\n    \"\"\"\n    eulerian_calculator = EulerianFunction(cache=_global_eulerian_cache)\n    return eulerian_calculator.compute(n, m)"}
{"task_id": "Mbpp/108", "solution": "def _is_integer(value) -> bool:\n    \"\"\"Checks if a value is an integer.\"\"\"\n    return isinstance(value, int)\n\ndef validate_inputs(listA, listB, listC) -> None:\n    \"\"\"Validates that all inputs are lists of integers.\"\"\"\n    for lst_arg in [listA, listB, listC]:\n        if not isinstance(lst_arg, list):\n            raise TypeError(\"All arguments must be lists.\")\n        for element in lst_arg:\n            if not _is_integer(element):\n                raise TypeError(\"All list elements must be integers.\")\n\ndef _flatten(inputs: list) -> list:\n    \"\"\"Concatenates a list of lists into a single list.\"\"\"\n    # The 'inputs' argument here is expected to be a list containing the three input lists,\n    # e.g., [listA, listB, listC].\n    # Concatenate them as specified in the design context (listA + listB + listC).\n    return inputs[0] + inputs[1] + inputs[2]\n\ndef merge_sorted_list(listA: list, listB: list, listC: list) -> list:\n    \"\"\"Merges three lists into a single sorted list.\"\"\"\n    validate_inputs(listA, listB, listC)\n    \n    combined_list = _flatten([listA, listB, listC])\n    combined_list.sort()\n    \n    return combined_list"}
{"task_id": "Mbpp/106", "solution": "def add_lists(input_list: list, input_tuple: tuple) -> tuple:\n    \"\"\"Validate inputs and return a tuple containing input_tuple elements followed by input_list elements.\"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"first parameter must be a list\")\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"second parameter must be a tuple\")\n    return tuple(input_tuple) + tuple(input_list)"}
{"task_id": "Mbpp/113", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass InputString:\n    value: str\n\n@dataclass\nclass Result:\n    is_integer: bool\n\ndef check_integer(input: str) -> bool:\n    \"\"\"Return True iff `input` is non-empty and every character is an ASCII digit '0'..'9'.\"\"\"\n    if not input:\n        return False\n    return all('0' <= ch <= '9' for ch in input)"}
{"task_id": "Mbpp/111", "solution": "import collections\nfrom typing import Any, Set\n\ndef common_in_nested_lists(iterable_of_sublists: collections.abc.Iterable) -> Set[Any]:\n    \"\"\"Finds common elements in given nested lists using hash-based set operations.\n\n    Elements should be equality-comparable and hashable for optimal performance.\n    \"\"\"\n    if not isinstance(iterable_of_sublists, collections.abc.Iterable):\n        raise TypeError(\"Top-level argument must be an iterable of iterables\")\n\n    sublist_iterator = iter(iterable_of_sublists)\n\n    try:\n        first_sublist = next(sublist_iterator)\n    except StopIteration:\n        return set()\n\n    if not isinstance(first_sublist, collections.abc.Iterable):\n        raise TypeError(\"Each member of iterable_of_sublists must be an iterable\")\n\n    result_set = set(first_sublist)\n\n    for sublist in sublist_iterator:\n        if not isinstance(sublist, collections.abc.Iterable):\n            raise TypeError(\"Each member of iterable_of_sublists must be an iterable\")\n        result_set.intersection_update(sublist)\n        if not result_set:  # Early exit if intersection becomes empty\n            return set()\n\n    return result_set"}
{"task_id": "Mbpp/116", "solution": "class Element:\n    \"\"\"Represents a single element of the input tuple, validating its type and value.\"\"\"\n    def __init__(self, value: int, position: int) -> None:\n        self.value = value\n        self.position = position\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if the element is a positive integer.\"\"\"\n        return isinstance(self.value, int) and self.value >= 1\n\nclass TupleInput:\n    \"\"\"Represents and validates the entire input tuple.\"\"\"\n    def __init__(self, elements: tuple) -> None:\n        self.elements = elements\n\n    def validate(self) -> None:\n        \"\"\"Validates that the input is a tuple of positive integers.\"\"\"\n        if not isinstance(self.elements, tuple):\n            raise TypeError(\"input must be a tuple\")\n        \n        for i, val in enumerate(self.elements):\n            element = Element(val, i)\n            if not element.is_valid():\n                raise ValueError(\"tuple elements must be positive integers\")\n\nclass ResultInteger:\n    \"\"\"Holds the final concatenated integer value.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\ndef tuple_to_int(input_tuple: tuple) -> int:\n    \"\"\"\n    Converts a tuple of positive integers into a single integer by concatenation.\n    Validates input type and element values, then joins their string representations.\n    \"\"\"\n    ti = TupleInput(input_tuple)\n    ti.validate()\n\n    parts = [str(e) for e in input_tuple]\n    concatenated = ''.join(parts)\n    \n    result = ResultInteger(int(concatenated))\n    return result.value"}
{"task_id": "Mbpp/109", "solution": "class BinaryString:\n    \"\"\"Represent and validate the input binary string; provide LSB/oddness utilities.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n        self.length = len(value)\n        self.validate()\n\n    def validate(self) -> None:\n        \"\"\"Raises ValueError if invalid.\"\"\"\n        if not self.value:\n            raise ValueError(\"Input string 's' cannot be empty.\")\n        if not all(c in '01' for c in self.value):\n            raise ValueError(\"Input string 's' must contain only '0' or '1'.\")\n\n    def lsb(self) -> str:\n        \"\"\"Returns rightmost character.\"\"\"\n        return self.value[-1]\n\n    def is_odd(self) -> bool:\n        \"\"\"True if lsb() == '1'.\"\"\"\n        return self.lsb() == '1'\n\nclass ParameterK:\n    \"\"\"Represent and validate the integer parameter k.\"\"\"\n    def __init__(self, k: int) -> None:\n        self.k = k\n        self.validate()\n\n    def validate(self) -> None:\n        \"\"\"Raises ValueError if invalid.\"\"\"\n        if not isinstance(self.k, int):\n            raise ValueError(\"Parameter 'k' must be an integer.\")\n        if self.k < 0:\n            raise ValueError(\"Parameter 'k' cannot be negative.\")\n\n    def is_zero(self) -> bool:\n        \"\"\"True if k == 0.\"\"\"\n        return self.k == 0\n\nclass Rotation:\n    \"\"\"Represent a single rotation instance (index and rotated string) and provide oddness check.\"\"\"\n    def __init__(self, index: int, value: str) -> None:\n        self.index = index\n        self.value = value\n\n    def is_odd(self) -> bool:\n        \"\"\"True if value[-1] == '1'.\"\"\"\n        return self.value[-1] == '1'\n\nclass OddEquivalentFunction:\n    \"\"\"Coordinate validation and perform the k rotation evaluations, counting odd rotations.\"\"\"\n    def validate_inputs(self, s: str, k: int) -> None:\n        \"\"\"Validate s and k; raise ValueError on failure.\"\"\"\n        _ = BinaryString(s) # BinaryString constructor performs validation\n        _ = ParameterK(k)   # ParameterK constructor performs validation\n\n    def _rotate_string_once(self, s_val: str) -> str:\n        \"\"\"Helper for performing a single cyclic rotation (right-to-left shift).\"\"\"\n        if not s_val: # This case should be prevented by BinaryString validation\n            return \"\"\n        return s_val[-1] + s_val[:-1]\n\n    def count_odd_rotations(self, s: str, k: int) -> int:\n        \"\"\"Perform exactly k evaluations and return count.\"\"\"\n        self.validate_inputs(s, k)\n\n        if k == 0:\n            return 0\n\n        odd_count = 0\n        current_s = s # Start with the original string (rotation 0)\n\n        for _ in range(k):\n            # Check if the current rotation is odd\n            if current_s[-1] == '1':\n                odd_count += 1\n            \n            # Prepare the string for the next rotation\n            current_s = self._rotate_string_once(current_s)\n\n        return odd_count\n\ndef odd_Equivalent(s: str, k: int) -> int:\n    \"\"\"\n    Find the number of numbers with an odd value when rotating a binary string \n    the given number of times.\n    Raises ValueError for invalid inputs (s is empty/non-binary or k is negative/non-integer).\n    \"\"\"\n    calculator = OddEquivalentFunction()\n    return calculator.count_odd_rotations(s, k)"}
