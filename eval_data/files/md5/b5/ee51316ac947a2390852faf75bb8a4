{"task_id": "Mbpp/89", "solution": "import math\nfrom typing import Union\n\nclass Number:\n    \"\"\"Represents a numeric input value.\"\"\"\n    def __init__(self, value: float) -> None:\n        self.value = value\n\nclass Result:\n    \"\"\"Represents the numeric output value.\"\"\"\n    def __init__(self, value: float) -> None:\n        self.value = value\n\nclass ClosestNum:\n    \"\"\"Encapsulates the algorithm to find the closest smaller number.\"\"\"\n    def compute(self, n: Number) -> Result:\n        if isinstance(n.value, int) or (isinstance(n.value, float) and n.value.is_integer()):\n            return Result(n.value - 1)\n        else:\n            # For non-integer floats, return the next representable IEEE-754 float strictly less than n.\n            return Result(math.nextafter(n.value, -math.inf))\n\ndef closest_num(n: int | float) -> float:\n    \"\"\"\n    Finds the largest number strictly less than n. \n    For integers, returns n - 1; for non-integer floats, returns the next smaller float.\n    \"\"\"\n    if not isinstance(n, (int, float)):\n        raise TypeError(\"closest_num: n must be numeric\")\n    \n    num = Number(float(n))\n    result = ClosestNum().compute(num)\n    return result.value"}
{"task_id": "Mbpp/88", "solution": "from typing import Any, Dict, List\n\ndef freq_count(input_list: List[Any]) -> Dict[Any, int]:\n    \"\"\"Compute the frequency (count) of each unique element in input_list and return a dict mapping element -> int count.\n    For an empty list, an empty dictionary is returned.\n    \"\"\"\n    counts: Dict[Any, int] = {}\n    for element in input_list:\n        counts[element] = counts.get(element, 0) + 1\n    return counts"}
