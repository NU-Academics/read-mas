{"task_id": "Mbpp/119", "solution": "from typing import List\n\nclass SortedArray:\n    def __init__(self, elements: List[int]):\n        \"\"\"Initializes the SortedArray with a list of elements.\"\"\"\n        self.elements = elements\n\n    def __len__(self) -> int:\n        \"\"\"Returns the length of the array.\"\"\"\n        return len(self.elements)\n\n    def __getitem__(self, idx: int) -> int:\n        \"\"\"Returns the element at the specified index.\"\"\"\n        return self.elements[idx]\n\nclass ArrayElement:\n    def __init__(self, value: int, occurrenceCount: int):\n        \"\"\"Initializes an ArrayElement with a value and its occurrence count.\"\"\"\n        self.value = value\n        self.occurrenceCount = occurrenceCount\n\nclass SearchFunction:\n    @staticmethod\n    def search(nums: List[int]) -> int:\n        \"\"\"\n        Finds the element that appears only once in a sorted array where all other elements appear twice.\n        This implementation uses a binary search approach.\n        \"\"\"\n        low = 0\n        high = len(nums) - 1\n\n        while low < high:\n            mid = low + (high - low) // 2\n\n            # Ensure 'mid' points to the start of a potential pair or the unique element.\n            # If mid is odd, decrement to make it even.\n            if mid % 2 == 1:\n                mid -= 1\n\n            # Check if nums[mid] and nums[mid+1] form a pair.\n            if nums[mid] == nums[mid + 1]:\n                # This is a regular pair, so the unique element is to the right.\n                low = mid + 2\n            else:\n                # nums[mid] is either the unique element or part of a pair\n                # where the unique element is to its left (including mid).\n                high = mid\n        \n        # When low == high, this index points to the single unique element.\n        return nums[low]\n\ndef search(nums: List[int]) -> int:\n    \"\"\"\n    Finds the element that appears only once in a sorted array where all other elements appear twice.\n    Delegates the core logic to SearchFunction.search.\n    \"\"\"\n    return SearchFunction.search(nums)"}
{"task_id": "Mbpp/120", "solution": "class Pair:\n    \"\"\"Represents a validated 2-element numeric pair and computes its raw product.\"\"\"\n    def __init__(self, a: float | int, b: float | int):\n        self.a = a\n        self.b = b\n\n    def get_product(self) -> float | int:\n        \"\"\"Returns the raw product of a and b.\"\"\"\n        return self.a * self.b\n\nclass PairList:\n    \"\"\"Wraps input iterable of pairs, performs validation, and provides iteration over Pair objects.\"\"\"\n    def __init__(self, list_of_pairs: list):\n        self._list_of_pairs = list_of_pairs\n\n    def validate(self) -> bool:\n        \"\"\"Validates the input list of pairs, raising ValueError or TypeError on failure.\"\"\"\n        if not self._list_of_pairs:\n            raise ValueError(\"Input list cannot be empty.\")\n\n        for i, element in enumerate(self._list_of_pairs):\n            if not isinstance(element, (tuple, list)):\n                raise ValueError(f\"Element at index {i} must be a tuple or list, but got {type(element).__name__}.\")\n            if len(element) != 2:\n                raise ValueError(f\"Element at index {i} must be a 2-element sequence, but got {len(element)} elements: {element}.\")\n            \n            a, b = element\n            if not isinstance(a, (int, float)):\n                raise TypeError(f\"First component of element at index {i} must be numeric, but got {type(a).__name__}: {element}.\")\n            if not isinstance(b, (int, float)):\n                raise TypeError(f\"Second component of element at index {i} must be numeric, but got {type(b).__name__}: {element}.\")\n        return True\n\n    def __iter__(self):\n        \"\"\"Yields Pair instances for each valid (a, b) pair in the list.\"\"\"\n        for a, b in self._list_of_pairs:\n            yield Pair(a, b)\n\nclass MaxProductCalculator:\n    \"\"\"Computes the maximum absolute product from an iterable of Pair objects using single-pass aggregation.\"\"\"\n    def __init__(self):\n        pass\n\n    def max_product_tuple(self, list_of_pairs: list) -> float | int:\n        \"\"\"Orchestrates iteration over validated pairs, computes absolute product, and returns the maximum numeric value.\"\"\"\n        current_max = float('-inf')\n        all_products_integral = True\n\n        # Assumes list_of_pairs has been validated externally by the public function.\n        # This PairList instance is used solely for its iteration capabilities.\n        pair_list_for_iteration = PairList(list_of_pairs)\n\n        for pair_obj in pair_list_for_iteration:\n            raw_product = pair_obj.get_product()\n            abs_product = abs(raw_product)\n\n            if abs_product > current_max:\n                current_max = abs_product\n\n            # Determine if the final return type should be int or float.\n            # If any product is a non-integral float (e.g., 5.5 but not 5.0),\n            # then all_products_integral becomes False.\n            if all_products_integral and isinstance(raw_product, float) and raw_product % 1.0 != 0.0:\n                all_products_integral = False\n        \n        # Return an integer if all products were effectively integral, otherwise a float.\n        # current_max will not be -inf as PairList.validate ensures non-empty input.\n        if all_products_integral:\n            return int(current_max)\n        else:\n            return float(current_max)\n\ndef max_product_tuple(list_of_pairs: list) -> float | int:\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples within a given list.\n    \"\"\"\n    # 1. Construct PairList and validate input; this step handles all specified input errors.\n    pair_list_validator = PairList(list_of_pairs)\n    pair_list_validator.validate()\n\n    # 2. Delegate the maximum product computation to MaxProductCalculator.\n    calculator = MaxProductCalculator()\n    result = calculator.max_product_tuple(list_of_pairs)\n    \n    return result"}
