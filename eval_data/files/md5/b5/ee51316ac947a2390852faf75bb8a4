{"task_id": "Mbpp/135", "solution": "class InputValidator:\n    \"\"\"\n    Validator for hexagonal number input.\n    As per strict completion requirements, actual validation logic is omitted.\n    \"\"\"\n    def is_valid(self, n: int) -> bool:\n        # Per explicit completion constraints, `isinstance` checks and error raising are disallowed.\n        # This method therefore always returns True, effectively skipping input validation.\n        return True\n\nclass HexagonalNumber:\n    \"\"\"\n    Data holder for a computed hexagonal number.\n    Stores the integer value of a hexagonal number.\n    \"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass HexagonalNumberCalculator:\n    \"\"\"\n    Calculates hexagonal numbers, orchestrating input handling and computation.\n    It uses an InputValidator and computes the nth hexagonal number.\n    \"\"\"\n    def __init__(self):\n        self.validator = InputValidator()\n\n    def _compute(self, n: int) -> int:\n        \"\"\"\n        Computes the nth hexagonal number using the formula H(n) = n * (2*n - 1).\n        Returns the calculated integer value.\n        \"\"\"\n        return n * (2 * n - 1)\n\n    def hexagonal_num(self, n: int) -> int:\n        \"\"\"\n        Calculates the nth hexagonal number after a nominal validation check.\n        Delegates the actual computation to _compute.\n        \"\"\"\n        # The design specified input validation, but strict completion requirements\n        # forbid `isinstance` checks or raising exceptions for edge cases.\n        # Thus, validation is nominally performed but will always pass, and no errors are raised.\n        if not self.validator.is_valid(n):\n            # This path is unreachable due to the `is_valid` implementation based on constraints.\n            pass\n        return self._compute(n)\n\ndef hexagonal_num(n: int) -> int:\n    \"\"\"\n    Finds the nth hexagonal number.\n    This module-level function serves as the public API entry point.\n    \"\"\"\n    calculator = HexagonalNumberCalculator()\n    return calculator.hexagonal_num(n)"}
{"task_id": "Mbpp/133", "solution": "from typing import List\n\nclass Number:\n    \"\"\"Represents a single numeric value and provides a method to check its sign.\"\"\"\n    def __init__(self, value: float):\n        self.value = float(value)\n\n    def is_negative(self) -> bool:\n        \"\"\"Returns True if the number's value is less than zero, False otherwise.\"\"\"\n        return self.value < 0\n\nclass NumberList:\n    \"\"\"Manages a list of numbers and facilitates filtering operations.\"\"\"\n    def __init__(self, numbers: list):\n        self.items = numbers\n\n    def length(self) -> int:\n        \"\"\"Returns the total count of numbers in the list.\"\"\"\n        return len(self.items)\n\n    def filter_negative(self) -> List[float]:\n        \"\"\"Iterates through the list and returns a new list containing only negative numeric values.\"\"\"\n        negative_values = []\n        for item in self.items:\n            num_obj = Number(item)\n            if num_obj.is_negative():\n                negative_values.append(num_obj.value)\n        return negative_values\n\nclass Result:\n    \"\"\"A simple data holder for the computed sum.\"\"\"\n    def __init__(self, sum_val: float):\n        self.sum = sum_val\n\nclass SumNegativeNumFunction:\n    \"\"\"Encapsulates the core logic for calculating the sum of negative numbers.\"\"\"\n    def execute(self, numbers: list) -> float:\n        \"\"\"Processes the input list to find and sum all negative numbers.\"\"\"\n        number_list = NumberList(numbers)\n        negative_values = number_list.filter_negative()\n        total_sum = sum(negative_values)\n        result = Result(total_sum)\n        return result.sum\n\ndef sum_negativenum(numbers: list) -> float:\n    \"\"\"Calculates the sum of all negative numbers within a given list.\n\n    Returns 0.0 if the list is empty or contains no negative numbers.\n    \"\"\"\n    calculator = SumNegativeNumFunction()\n    return calculator.execute(numbers)"}
{"task_id": "Mbpp/137", "solution": "from dataclasses import dataclass\nfrom typing import List, Tuple, Any\n\n@dataclass\nclass InputArray:\n    \"\"\"A value object for validated input arrays.\"\"\"\n    elements: List[int]\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the array.\"\"\"\n        return len(self.elements)\n\n@dataclass\nclass Element:\n    \"\"\"A value object for an individual element.\"\"\"\n    value: int\n\n    def is_zero(self) -> bool:\n        \"\"\"Checks if the element's value is zero.\"\"\"\n        return self.value == 0\n\n@dataclass\nclass Result:\n    \"\"\"A value object for the computed ratio result.\"\"\"\n    ratio: float\n\ndef _validate_input(raw_input: Any) -> InputArray:\n    \"\"\"Validates the raw input against type and emptiness rules.\"\"\"\n    if not isinstance(raw_input, list):\n        raise TypeError(\"Input must be a list of integers.\")\n    if not raw_input:\n        raise ValueError(\"Input array cannot be empty.\")\n    for item in raw_input:\n        if not isinstance(item, int):\n            raise TypeError(\"All elements in the input list must be integers.\")\n    return InputArray(elements=raw_input)\n\ndef _count_elements(input_array: InputArray) -> Tuple[int, int]:\n    \"\"\"Counts zero and non-zero elements in the validated input array.\"\"\"\n    zero_count = 0\n    nonzero_count = 0\n    for val in input_array.elements:\n        element = Element(value=val)\n        if element.is_zero():\n            zero_count += 1\n        else:\n            nonzero_count += 1\n    return zero_count, nonzero_count\n\nclass ZeroCountFunction:\n    \"\"\"Orchestrates the computation of the zero-to-non-zero ratio.\"\"\"\n    def compute(self, input_array: InputArray) -> Result:\n        \"\"\"Computes the ratio of zeroes to non-zeroes.\"\"\"\n        zeros, nonzeros = _count_elements(input_array)\n        if nonzeros == 0:\n            raise ValueError(\"Cannot compute ratio: no non-zero elements present.\")\n        ratio = float(zeros) / nonzeros\n        return Result(ratio=ratio)\n\ndef zero_count(input_array: List[int]) -> float:\n    \"\"\"\n    Finds the ratio of zeroes to non-zeroes in an array of integers.\n    Raises TypeError for invalid input types or ValueError for empty arrays or no non-zeroes.\n    \"\"\"\n    validated_input = _validate_input(input_array)\n    zcf = ZeroCountFunction()\n    result = zcf.compute(validated_input)\n    return result.ratio"}
{"task_id": "Mbpp/138", "solution": "from dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass InputNumber:\n    value: int\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if the input value is a positive integer.\"\"\"\n        return isinstance(self.value, int) and self.value > 0\n\n@dataclass\nclass PowerOfTwo:\n    exponent: int\n    value: int # value == 1 << exponent\n\n@dataclass\nclass Representation:\n    terms: List[PowerOfTwo]\n\n    def sum(self) -> int:\n        \"\"\"Calculates the sum of the values of all power of two terms.\"\"\"\n        return sum(term.value for term in self.terms)\n\n@dataclass\nclass Result:\n    isRepresentable: bool\n\ndef decompose_into_powers_of_two(n: int) -> Representation:\n    \"\"\"Decomposes an integer into a representation of distinct powers of two.\"\"\"\n    terms: List[PowerOfTwo] = []\n    current_exponent = 0\n    temp_n = n\n    while temp_n > 0:\n        if temp_n & 1: # Check if the least significant bit is set\n            terms.append(PowerOfTwo(current_exponent, 1 << current_exponent))\n        temp_n >>= 1 # Right shift to check the next bit\n        current_exponent += 1\n    return Representation(terms)\n\ndef is_Sum_Of_Powers_Of_Two(n: int) -> bool:\n    \"\"\"Checks if a given number can be represented as the sum of distinct non-zero powers of 2.\n    Returns False for non-integer or non-positive inputs as per design.\"\"\"\n    input_num = InputNumber(n)\n    if not input_num.is_valid():\n        return False\n\n    representation = decompose_into_powers_of_two(n)\n    rep_sum = representation.sum()\n\n    return rep_sum == n"}
