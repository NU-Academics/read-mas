{"task_id": "Mbpp/282", "solution": "from typing import List, Union\n\nclass LengthMismatchError(Exception):\n    \"\"\"Exception raised when input lists have different lengths.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass TypeValidationError(Exception):\n    \"\"\"Exception raised when a non-numeric element is found.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass InputList:\n    \"\"\"Represents an input list of numeric elements.\"\"\"\n    def __init__(self, elements: List[Union[int, float]]):\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the input list.\"\"\"\n        return len(self.elements)\n\nclass ResultList:\n    \"\"\"Represents a result list of numeric elements.\"\"\"\n    def __init__(self, elements: List[Union[int, float]]):\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the result list.\"\"\"\n        return len(self.elements)\n\nclass Validator:\n    \"\"\"Validates properties of input lists.\"\"\"\n    def _is_numeric(self, value) -> bool:\n        \"\"\"Checks if a value is numeric.\"\"\"\n        return isinstance(value, (int, float))\n\n    def validate_lengths_and_types(self, listA: InputList, listB: InputList) -> None:\n        \"\"\"Validates lengths and element types of two input lists.\"\"\"\n        if listA.length() != listB.length():\n            raise LengthMismatchError(f\"Input lists have different lengths: {listA.length()} vs {listB.length()}\")\n\n        for i, val_a in enumerate(listA.elements):\n            if not self._is_numeric(val_a):\n                raise TypeValidationError(f\"Element at index {i} in list A is not numeric: {val_a}\")\n        \n        for i, val_b in enumerate(listB.elements):\n            if not self._is_numeric(val_b):\n                raise TypeValidationError(f\"Element at index {i} in list B is not numeric: {val_b}\")\n\nclass Processor:\n    \"\"\"Performs element-wise operations on lists.\"\"\"\n    def element_wise_subtraction(self, listA: InputList, listB: InputList) -> ResultList:\n        \"\"\"Performs element-wise subtraction of two input lists.\"\"\"\n        result_elements = [a - b for a, b in zip(listA.elements, listB.elements)]\n        return ResultList(result_elements)\n\ndef sub_list(listA: List[float], listB: List[float]) -> List[float]:\n    \"\"\"\n    Subtracts two lists element-wise.\n    This function validates inputs and performs subtraction using internal components.\n    \"\"\"\n    input_list_a = InputList(listA)\n    input_list_b = InputList(listB)\n\n    validator = Validator()\n    processor = Processor()\n\n    validator.validate_lengths_and_types(input_list_a, input_list_b)\n    result_list = processor.element_wise_subtraction(input_list_a, input_list_b)\n\n    return result_list.elements"}
{"task_id": "Mbpp/287", "solution": "from typing import List\n\nclass InputParameter:\n    \"\"\"Validates the input parameter n, ensuring it's a non-negative integer.\"\"\"\n    def __init__(self, n):\n        if not isinstance(n, int):\n            raise TypeError(\"Input n must be an integer.\")\n        if n < 0:\n            raise ValueError(\"Input n must be a non-negative integer.\")\n        self._n = n\n\n    @property\n    def n(self) -> int:\n        return self._n\n\nclass EvenNumberSequence:\n    \"\"\"Generates a list of the first n even natural numbers.\"\"\"\n    def generate(self, n: int) -> List[int]:\n        if n == 0:\n            return []\n        return [2 * i for i in range(1, n + 1)]\n\nclass Calculator:\n    \"\"\"Computes the sum of squares for a given list of integers.\"\"\"\n    def sum_of_squares(self, nums: List[int]) -> int:\n        return sum(x * x for x in nums)\n\nclass OutputResult:\n    \"\"\"Encapsulates the integer result value.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    @property\n    def value(self) -> int:\n        return self._value\n\nclass SquareSumFunction:\n    \"\"\"Orchestrates the calculation of the sum of squares of even numbers.\"\"\"\n    def compute(self, n: int) -> int:\n        sequence_generator = EvenNumberSequence()\n        even_numbers = sequence_generator.generate(n)\n\n        calculator = Calculator()\n        sum_sq = calculator.sum_of_squares(even_numbers)\n        \n        return sum_sq\n\ndef square_Sum(n: int) -> int:\n    \"\"\"Calculates the sum of squares of the first n even natural numbers.\"\"\"\n    validated_n = InputParameter(n).n\n    \n    calculator_function = SquareSumFunction()\n    result = calculator_function.compute(validated_n)\n    \n    return result"}
{"task_id": "Mbpp/292", "solution": "import math\nfrom typing import Union\n\ndef find(dividend, divisor):\n    \"\"\"Compute floor(dividend / divisor) and return as int. Uses Python's numeric semantics; if divisor == 0, Python raises ZeroDivisionError.\"\"\"\n    quotient = dividend / divisor\n    floored = math.floor(quotient)\n    return int(floored)"}
{"task_id": "Mbpp/286", "solution": "import math\n\nclass Array:\n    \"\"\"Represents the base integer array.\"\"\"\n    def __init__(self, values: list[int], length: int):\n        self.values = values\n        self.length = length\n\nclass RepeatedArray:\n    \"\"\"Logical wrapper for base Array and repeat count k.\"\"\"\n    def __init__(self, baseArray: Array, k: int):\n        self.baseArray = baseArray\n        self.k = k\n\n    def totalLength(self) -> int:\n        \"\"\"Returns the total length of the repeated array.\"\"\"\n        return self.baseArray.length * self.k\n\nclass SubarraySumCalculator:\n    \"\"\"Encapsulates algorithmic logic for max contiguous subarray sum.\"\"\"\n\n    def kadane(self, a: Array) -> int:\n        \"\"\"Computes the maximum contiguous subarray sum for a single copy.\"\"\"\n        # Assumes a.values is not empty based on outer validation (n=len(arr) and n > 0 if arr not empty)\n        max_so_far = a.values[0]\n        current_max = a.values[0]\n\n        for i in range(1, a.length):\n            current_max = max(a.values[i], current_max + a.values[i])\n            max_so_far = max(max_so_far, current_max)\n        return max_so_far\n\n    def maxPrefixSum(self, a: Array) -> int:\n        \"\"\"Computes the maximum prefix sum for the base array.\"\"\"\n        # Assumes a.values is not empty\n        max_prefix = -math.inf\n        current_sum = 0\n        for x in a.values:\n            current_sum += x\n            max_prefix = max(max_prefix, current_sum)\n        return int(max_prefix)\n\n    def maxSuffixSum(self, a: Array) -> int:\n        \"\"\"Computes the maximum suffix sum for the base array.\"\"\"\n        # Assumes a.values is not empty\n        max_suffix = -math.inf\n        current_sum = 0\n        for x in reversed(a.values):\n            current_sum += x\n            max_suffix = max(max_suffix, current_sum)\n        return int(max_suffix)\n\n    def maxSubarraySum(self, ra: RepeatedArray) -> int:\n        \"\"\"Calculates the largest sum of a contiguous subarray in the repeated array.\"\"\"\n        a = ra.baseArray\n        \n        single_kadane = self.kadane(a)\n\n        if ra.k == 1:\n            return single_kadane\n\n        prefix = self.maxPrefixSum(a)\n        suffix = self.maxSuffixSum(a)\n        total = sum(a.values)\n\n        cross_sum = suffix + prefix\n        \n        extend_candidate = cross_sum\n        if total > 0 and ra.k >= 2:\n            extend_candidate = cross_sum + total * (ra.k - 2) \n\n        result = max(single_kadane, cross_sum, extend_candidate)\n        \n        return result\n\ndef max_sub_array_sum_repeated(arr, n, k):\n    \"\"\"\n    Finds the largest sum of a contiguous subarray in the modified array \n    which is formed by repeating the given array k times.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input 'arr' must be a list.\")\n    if not all(isinstance(x, int) for x in arr):\n        raise TypeError(\"All elements in 'arr' must be integers.\")\n    if not isinstance(n, int) or n != len(arr):\n        raise ValueError(f\"Input 'n' must be an integer equal to len(arr) ({len(arr)}), but got {n}.\")\n    if not isinstance(k, int) or k < 1:\n        raise ValueError(\"Input 'k' must be an integer and k >= 1.\")\n\n    if n == 0:\n        return 0\n\n    base_array = Array(values=arr, length=n)\n    repeated_array = RepeatedArray(baseArray=base_array, k=k)\n\n    calculator = SubarraySumCalculator()\n    result_value = calculator.maxSubarraySum(repeated_array)\n\n    return result_value"}
{"task_id": "Mbpp/290", "solution": "from typing import List, Tuple, Any\n\ndef max_length(list_of_lists: List[List[Any]]) -> Tuple[int, List[Any]]:\n    \"\"\"\n    Finds the list of maximum length in a list of lists.\n    Returns a tuple (n, lst) where n is the length and lst is the sublist.\n    \"\"\"\n    if not isinstance(list_of_lists, list):\n        raise TypeError(\"Input must be a list.\")\n\n    max_len = 0\n    longest_sublist: List[Any] = []\n\n    for sublist in list_of_lists:\n        if not isinstance(sublist, list):\n            raise ValueError(\"All elements in the input list must be list-like.\")\n        \n        current_len = len(sublist)\n        if current_len > max_len:\n            max_len = current_len\n            longest_sublist = sublist\n            \n    return (max_len, longest_sublist)"}
{"task_id": "Mbpp/294", "solution": "def _is_numeric(value):\n    \"\"\"Helper to check if a value is an integer or a float.\"\"\"\n    return isinstance(value, (int, float))\n\nclass MaxValFunction:\n    \"\"\"Encapsulates the algorithm to find the maximum numeric value.\"\"\"\n    def computeMax(self, data_list):\n        \"\"\"Filters numeric elements and returns the maximum numeric value.\"\"\"\n        max_val_found = None\n        for element in data_list:\n            if _is_numeric(element):\n                if max_val_found is None or element > max_val_found:\n                    max_val_found = element\n        return max_val_found\n\ndef max_val(list):\n    \"\"\"\n    Finds the maximum numeric value in a given heterogeneous list,\n    ignoring non-numeric elements.\n    \"\"\"\n    computer = MaxValFunction()\n    return computer.computeMax(list)"}
{"task_id": "Mbpp/296", "solution": "def get_Inv_Count(arr: list) -> int:\n    \"\"\"\n    Counts inversions in an array using a straightforward O(n^2) approach.\n    An inversion is a pair of indices (i, j) such that i < j and arr[i] > arr[j].\n    \"\"\"\n    n = len(arr)\n    inv_count = 0\n    if n <= 1:\n        return 0\n\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            if arr[i] > arr[j]:\n                inv_count += 1\n    return inv_count"}
