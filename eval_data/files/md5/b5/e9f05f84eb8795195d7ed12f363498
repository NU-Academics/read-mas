{"task_id": "Mbpp/93", "solution": "class Result:\n    \"\"\"A value object to encapsulate the computation result.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\nclass PowerFunction:\n    \"\"\"\n    Computes 'a' to the power 'b'.\n    It produces a Result object containing the calculated value.\n    \"\"\"\n    def __init__(self, a, b):\n        self.a = a\n        self.b = b\n\n    def compute(self):\n        \"\"\"Calculates a**b and returns it wrapped in a Result object.\"\"\"\n        calculated_value = self.a ** self.b\n        return Result(calculated_value)\n\ndef power(a, b):\n    \"\"\"\n    Calculates the value of 'a' to the power 'b'.\n    This function delegates the computation to the PowerFunction class.\n    \"\"\"\n    power_calculator = PowerFunction(a, b)\n    result_object = power_calculator.compute()\n    return result_object.value"}
{"task_id": "Mbpp/92", "solution": "def is_undulating(number: int) -> bool:\n    \"\"\"\n    Checks if a number is undulating, meaning its decimal digits alternate between exactly two distinct digits.\n    The pattern must be ABAB... or BABA... for the entire length.\n    \"\"\"\n    # Convert the absolute value of the number to a list of its decimal digits.\n    s_number = str(abs(number))\n    digits = [int(d) for d in s_number]\n\n    # An undulating number must have at least two digits to form an alternating pattern.\n    if len(digits) < 2:\n        return False\n\n    # An undulating number must consist of exactly two distinct digits.\n    distinct_digits = set(digits)\n    if len(distinct_digits) != 2:\n        return False\n\n    # Check if the digits alternate consistently throughout the sequence.\n    # This means digits[i] must be equal to digits[i-2] for i >= 2.\n    for i in range(2, len(digits)):\n        if digits[i] != digits[i-2]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/94", "solution": "def index_minimum(list_of_tuples):\n    \"\"\"Given a list of tuples, returns the first value of the tuple with the smallest second value.\n    This implementation assumes valid input and relies on Python's default error handling for edge cases.\n    \"\"\"\n    min_tuple = min(list_of_tuples, key=lambda x: x[1])\n    return min_tuple[0]"}
