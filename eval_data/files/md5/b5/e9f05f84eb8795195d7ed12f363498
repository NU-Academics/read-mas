{"task_id": "Mbpp/790", "solution": "def even_position(input_list):\n    \"\"\"\n    Checks if every element at an even index in the list is an even number.\n    Raises TypeError if input is not a list of integers.\n    \"\"\"\n\n    def validate_input(lst):\n        # Validate that the input is a list and contains only integers.\n        if not isinstance(lst, list):\n            raise TypeError(\"Input must be a list.\")\n        for item in lst:\n            if not isinstance(item, int):\n                raise TypeError(\"All elements in the list must be integers.\")\n\n    def check_even_indices(lst):\n        # Iterate through even indices and check if elements are even.\n        if not lst:\n            return True\n        for i in range(0, len(lst), 2):\n            if lst[i] % 2 != 0:\n                return False\n        return True\n\n    validate_input(input_list)\n    return check_even_indices(input_list)"}
{"task_id": "Mbpp/791", "solution": "def remove_nested(input_tuple):\n    \"\"\"\n    Removes top-level tuple elements from the given tuple, preserving order.\n    Raises TypeError if the input is not a tuple.\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n\n    return tuple(item for item in input_tuple if not isinstance(item, tuple))"}
{"task_id": "Mbpp/792", "solution": "from dataclasses import dataclass\nfrom typing import Any, List\n\n@dataclass\nclass InputList:\n    elements: List[Any]\n\n@dataclass\nclass ListElement:\n    value: Any\n    type_name: str = None\n\n    def __post_init__(self):\n        self.type_name = type(self.value).__name__\n\n    def is_list(self) -> bool:\n        return isinstance(self.value, list)\n\n@dataclass\nclass CountResult:\n    value: int\n\ndef validate_input(items) -> None:\n    \"\"\"Ensures the top-level input is a Python list.\"\"\"\n    if not isinstance(items, list):\n        raise TypeError(\"items must be a Python list\")\n\ndef count_list(items) -> int:\n    \"\"\"\n    Counts the number of lists in a given number of lists.\n    It validates the input, then iterates through top-level elements,\n    counting only those that are Python lists.\n    \"\"\"\n    validate_input(items)\n    input_wrapper = InputList(elements=items)\n    count = 0\n    for val in input_wrapper.elements:\n        elem = ListElement(val)\n        if elem.is_list():\n            count += 1\n    result = CountResult(value=count)\n    return result.value"}
{"task_id": "Mbpp/793", "solution": "NOT_FOUND = -1\n\ndef last(arr, x):\n    \"\"\"\n    Returns the last (highest) index of x in a sorted list arr, or NOT_FOUND if not present.\n    Uses an iterative binary search optimized for the rightmost match.\n    \"\"\"\n    low = 0\n    high = len(arr) - 1\n    result = NOT_FOUND\n\n    while low <= high:\n        mid = (low + high) // 2\n        if arr[mid] == x:\n            result = mid\n            low = mid + 1  # Look for a further occurrence in the right half\n        elif arr[mid] < x:\n            low = mid + 1\n        else:  # arr[mid] > x\n            high = mid - 1\n    return result"}
