{"task_id": "Mbpp/432", "solution": "class NumericArgument:\n    \"\"\"Encapsulates a numeric argument and provides type validation.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n    def is_numeric(self) -> bool:\n        return isinstance(self.value, (int, float))\n\nclass Trapezium:\n    \"\"\"Data-holder for trapezium base dimensions and an other parameter.\"\"\"\n    def __init__(self, base1: float, base2: float, otherParameter: float):\n        self.base1 = base1\n        self.base2 = base2\n        self.otherParameter = otherParameter\n\nclass MedianResult:\n    \"\"\"Data-holder for the computed median value.\"\"\"\n    def __init__(self, value: float):\n        self.value = value\n\nclass MedianCalculator:\n    \"\"\"Domain service for validating inputs and computing the median of a trapezium's bases.\"\"\"\n    def median_trapezium(self, a: float, b: float, c: float) -> float:\n        # Validate inputs using NumericArgument as per design.\n        arg_a = NumericArgument(a)\n        arg_b = NumericArgument(b)\n        arg_c = NumericArgument(c)\n\n        if not arg_a.is_numeric():\n            raise TypeError(\"Argument 'a' must be numeric (int or float).\")\n        if not arg_b.is_numeric():\n            raise TypeError(\"Argument 'b' must be numeric (int or float).\")\n        if not arg_c.is_numeric():\n            # The third parameter 'c' is validated but its value is ignored for computation.\n            raise TypeError(\"Argument 'c' must be numeric (int or float).\")\n\n        # Construct Trapezium domain object as per design, even if its instance isn't directly used for computation.\n        trapezium_instance = Trapezium(base1=a, base2=b, otherParameter=c)\n\n        # Compute the median length of the trapezium, which is the average of the parallel sides (a and b).\n        median_value = (a + b) / 2.0\n\n        # Encapsulate the result in a MedianResult object as per design.\n        result_object = MedianResult(median_value)\n\n        # Return the numeric value of the result.\n        return result_object.value\n\ndef median_trapezium(a: float, b: float, c: float) -> float:\n    \"\"\"Public API: validates inputs and returns (a + b) / 2 as a numeric result.\"\"\"\n    return MedianCalculator().median_trapezium(a, b, c)"}
