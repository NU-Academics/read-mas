{"task_id": "Mbpp/69", "solution": "from typing import List, Any\n\nclass SourceList:\n    \"\"\"\n    Wrapper for the source list, providing element access and length.\n    \"\"\"\n    def __init__(self, elements: List[Any]):\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"\n        Returns the length of the source list.\n        \"\"\"\n        return len(self.elements)\n\nclass SubList:\n    \"\"\"\n    Wrapper for the sublist (pattern), providing element access and length.\n    \"\"\"\n    def __init__(self, elements: List[Any]):\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"\n        Returns the length of the sublist.\n        \"\"\"\n        return len(self.elements)\n\nclass Result:\n    \"\"\"\n    Value-object for boolean match outcome.\n    \"\"\"\n    def __init__(self, value: bool):\n        self.value = value\n\nclass SublistChecker:\n    \"\"\"\n    Encapsulates the contiguous-window matching algorithm and comparison logic.\n    \"\"\"\n    def __init__(self, source: SourceList, target: SubList):\n        self.source = source\n        self.target = target\n        self._source_len = source.length()\n        self._target_len = target.length()\n\n    def _compare_window(self, start_index: int) -> bool:\n        \"\"\"\n        Compares a window of the source list with the target sublist.\n        \"\"\"\n        return self.source.elements[start_index : start_index + self._target_len] == self.target.elements\n\n    @staticmethod\n    def is_sublist(source_list_raw: List[Any], sub_list_raw: List[Any]) -> bool:\n        \"\"\"\n        Checks if the sublist is present as a contiguous sequence in the source list.\n        \"\"\"\n        source = SourceList(source_list_raw)\n        target = SubList(sub_list_raw)\n\n        if target.length() > source.length():\n            return False\n\n        checker = SublistChecker(source, target)\n        for i in range(source.length() - target.length() + 1):\n            if checker._compare_window(i):\n                return True\n        return False\n\ndef is_sublist(source_list: List[Any], sub_list: List[Any]) -> bool:\n    \"\"\"\n    Checks if a list contains the given sublist as a contiguous sequence.\n    Returns False if the sublist is longer than the source list.\n    \"\"\"\n    if len(sub_list) > len(source_list):\n        return False\n\n    return SublistChecker.is_sublist(source_list, sub_list)"}
{"task_id": "Mbpp/68", "solution": "class MonotonicChecker:\n    \"\"\"\n    Helper class to check for monotonicity properties of an array.\n    It provides methods to determine if an array is non-increasing, non-decreasing, or monotonic overall.\n    \"\"\"\n    def is_non_increasing(self, array) -> bool:\n        \"\"\"Checks if the array is non-increasing (each element is less than or equal to the previous).\"\"\"\n        if len(array) < 2:\n            return True\n        for i in range(1, len(array)):\n            if array[i-1] < array[i]:\n                return False\n        return True\n\n    def is_non_decreasing(self, array) -> bool:\n        \"\"\"Checks if the array is non-decreasing (each element is greater than or equal to the previous).\"\"\"\n        if len(array) < 2:\n            return True\n        for i in range(1, len(array)):\n            if array[i-1] > array[i]:\n                return False\n        return True\n\n    def is_Monotonic(self, array) -> bool:\n        \"\"\"Determines if the array is monotonic, meaning it's either non-increasing or non-decreasing.\"\"\"\n        return self.is_non_increasing(array) or self.is_non_decreasing(array)\n\ndef is_Monotonic(array) -> bool:\n    \"\"\"\n    Checks whether the given array is monotonic.\n    An array is monotonic if it is either entirely non-increasing or entirely non-decreasing.\n    \"\"\"\n    checker = MonotonicChecker()\n    return checker.is_Monotonic(array)"}
