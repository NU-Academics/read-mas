{"task_id": "Mbpp/415", "solution": "```python\ndef max_Product(elements: list[int]) -> tuple[int, int]:\n    \"\"\"\n    Finds a pair with the highest product from a given array of integers.\n    Handles positive, negative, and zero values.\n    \"\"\"\n    if len(elements) < 2:\n        raise ValueError(\"input list must contain at least two integers\")\n\n    # The maximum product can come from:\n    # 1. The two largest positive numbers.\n    # 2. The two smallest (most negative) numbers.\n    # We need to keep track of the two largest and two smallest numbers.\n\n    # Initialize with values that will be overwritten\n    max1 = -float('inf')  # Largest number\n    max2 = -float('inf')  # Second largest number\n    min1 = float('inf')   # Smallest number\n    min2 = float('inf')   # Second smallest number\n\n    for x in elements:\n        if x > max1:\n            max2 = max1\n            max1 = x\n        elif x > max2:\n            max2 = x\n\n        if x < min1:\n            min2 = min1\n            min1 = x\n        elif x < min2:\n            min2 = x\n\n    # Calculate candidate products\n    product1 = max1 * max2\n    product2 = min1 * min2\n\n    if product1 >= product2:\n        return (max2, max1) if max2 < max1 else (max1, max2)\n    else:\n        return (min1, min2) if min1 < min2 else (min2, min1)\n```"}
{"task_id": "Mbpp/418", "solution": "def Find_Max(list_input):\n    if not isinstance(list_input, list):\n        raise TypeError(\"list_input must be of type 'list'\")\n\n    if not list_input:\n        return None\n\n    max_element = None\n    max_length = -1\n\n    for element in list_input:\n        try:\n            current_length = len(element)\n        except TypeError:\n            # Re-raise TypeError if an element does not support len() (fail-fast).\n            raise\n\n        # Update if a strictly greater length is found, or if this is the first valid element.\n        if max_element is None or current_length > max_length:\n            max_length = current_length\n            max_element = element\n\n    return max_element"}
{"task_id": "Mbpp/420", "solution": "def cube_Sum(n):\n    \"\"\"Return sum of cubes of first n even natural numbers (2,4,...,2*n).\"\"\"\n    return sum((2 * i) ** 3 for i in range(1, n + 1))"}
{"task_id": "Mbpp/419", "solution": "from typing import List\n\ndef _round_number(n: float) -> int:\n    \"\"\"Rounds a single numeric value to the nearest integer.\"\"\"\n    return round(n)\n\ndef _compute_sum(rounded_numbers: List[int]) -> int:\n    \"\"\"Computes the arithmetic sum of rounded integers.\"\"\"\n    return sum(rounded_numbers)\n\ndef _multiply(current_sum: int, list_length: int) -> int:\n    \"\"\"Multiplies sum by length and returns the integer product.\"\"\"\n    return current_sum * list_length\n\ndef _print_result(result: int) -> None:\n    \"\"\"Writes the result to stdout.\"\"\"\n    print(result)\n\ndef round_and_sum(numbers: List[float]) -> int:\n    \"\"\"\n    Rounds every number of a given list, computes their sum,\n    multiplies the sum by the list's length, and prints the result.\n    \"\"\"\n    rounded_numbers = [_round_number(num) for num in numbers]\n    total_sum = _compute_sum(rounded_numbers)\n    list_length = len(numbers)\n    final_product = _multiply(total_sum, list_length)\n    _print_result(final_product)\n    return final_product"}
{"task_id": "Mbpp/424", "solution": "def _last_char(s: str) -> str:\n    \"\"\"Returns the last character of a string.\"\"\"\n    return s[-1]\n\ndef extract_rear(input_tuple: tuple) -> list:\n    \"\"\"\n    Extracts the last character of each string in a tuple and returns them as a list.\n    \"\"\"\n    result = []\n    for s in input_tuple:\n        result.append(_last_char(s))\n    return result"}
{"task_id": "Mbpp/421", "solution": "def concatenate_tuple(t: tuple, delimiter: str = '-') -> str:\n    \"\"\"\n    Concatenates each element of a tuple by a specified delimiter.\n    Non-string elements are converted to their string representation.\n    \"\"\"\n    if not isinstance(t, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n\n    if not t:\n        return ''\n\n    string_elements = [str(element) for element in t]\n    return delimiter.join(string_elements)"}
{"task_id": "Mbpp/425", "solution": "def count_element_in_list(sublists, element) -> int:\n    \"\"\"Count number of sublists in 'sublists' that contain 'element'.\n    Each sublist is counted at most once, even if the element appears multiple times.\"\"\"\n    count = 0\n    for sublist in sublists:\n        if element in sublist:\n            count += 1\n    return count"}
{"task_id": "Mbpp/422", "solution": "def _validate_n(n):\n    \"\"\"Validates that n is an integer and n >= 1, raising ValueError for invalid input.\"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\ndef sum_cubes(n):\n    \"\"\"Computes the sum of cubes of the first n natural numbers using a closed-form identity.\"\"\"\n    # The sum of the first n cubes is given by (n * (n + 1) / 2)^2\n    sum_of_natural_numbers = n * (n + 1) // 2\n    return sum_of_natural_numbers ** 2\n\ndef compute_average(total_sum, n):\n    \"\"\"Computes the average by dividing the total sum by n, ensuring a float result.\"\"\"\n    return float(total_sum) / float(n)\n\ndef find_Average_Of_Cube(n):\n    \"\"\"\n    Finds the average of the cubes of the first n natural numbers.\n    Validates input, computes the sum of cubes, and then calculates the average.\n    \"\"\"\n    _validate_n(n)\n    total_cubes_sum = sum_cubes(n)\n    average = compute_average(total_cubes_sum, n)\n    return average"}
