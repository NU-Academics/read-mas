{"task_id": "Mbpp/245", "solution": "from typing import List\nimport math\n\ndef compute_lis_sums(arr: List[int]) -> List[int]:\n    \"\"\"Computes the maximum sum of a strictly increasing subsequence ending at each index.\"\"\"\n    n = len(arr)\n    if n == 0:\n        return []\n    lis_sums = list(arr)\n    for i in range(1, n):\n        for j in range(i):\n            if arr[i] > arr[j]:\n                lis_sums[i] = max(lis_sums[i], lis_sums[j] + arr[i])\n    return lis_sums\n\ndef compute_lds_sums(arr: List[int]) -> List[int]:\n    \"\"\"Computes the maximum sum of a strictly decreasing subsequence starting at each index.\"\"\"\n    n = len(arr)\n    if n == 0:\n        return []\n    lds_sums = list(arr)\n    # Iterate from right to left to find decreasing subsequences starting at i\n    for i in range(n - 2, -1, -1):\n        for j in range(n - 1, i, -1):\n            if arr[i] > arr[j]:\n                lds_sums[i] = max(lds_sums[i], lds_sums[j] + arr[i])\n    return lds_sums\n\ndef max_sum(arr: List[int]) -> int:\n    \"\"\"\n    Finds the maximum sum of a bitonic subsequence in the given array.\n    A sequence is bitonic if it is first strictly increasing and then strictly decreasing.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return 0\n\n    lis_sums = compute_lis_sums(arr)\n    lds_sums = compute_lds_sums(arr)\n\n    max_bitonic_sum = float('-inf')\n\n    for i in range(n):\n        # The peak element arr[i] is counted in both LIS and LDS, so subtract it once.\n        current_bitonic_sum = lis_sums[i] + lds_sums[i] - arr[i]\n        max_bitonic_sum = max(max_bitonic_sum, current_bitonic_sum)\n\n    return max_bitonic_sum"}
