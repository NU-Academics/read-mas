{"task_id": "Mbpp/440", "solution": "import re\nimport string\n\nclass Adverb:\n    \"\"\"Represents an adverb with its text and original position.\"\"\"\n    def __init__(self, text: str, start_index: int, end_index: int):\n        self.text = text\n        self.start_index = start_index\n        self.end_index = end_index\n\nclass Token:\n    \"\"\"Represents a token (word or punctuation) with its text and original position.\"\"\"\n    def __init__(self, text: str, start_index: int, end_index: int):\n        self.text = text\n        self.start_index = start_index\n        self.end_index = end_index\n\n    def is_adverb(self) -> bool:\n        \"\"\"Determines if the token is an adverb using a simple heuristic.\"\"\"\n        # Normalize the token text internally to check for adverbial suffix.\n        normalized_text = self.text.strip(string.punctuation)\n        # Heuristic: check if the normalized word ends with 'ly' and is not too short.\n        return normalized_text.endswith(\"ly\") and len(normalized_text) > 2\n\nclass Sentence:\n    \"\"\"Represents a sentence, holding its original text and tokens.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n        self.tokens = []\n\n    def tokenize(self):\n        \"\"\"Splits the sentence into tokens and stores them with their positions.\"\"\"\n        # Finds sequences of non-whitespace characters, including attached punctuation.\n        token_pattern = re.compile(r'\\S+')\n        for match in token_pattern.finditer(self.text):\n            token_text = match.group(0)\n            start = match.start()\n            end = match.end()\n            self.tokens.append(Token(token_text, start, end))\n        return self.tokens\n\nclass AdverbFinder:\n    \"\"\"Service to find the first adverb and its position in a Sentence.\"\"\"\n    def find_adverb_position(self, sentence: Sentence) -> tuple[int, int, str] | None:\n        \"\"\"Iterates through tokens to find the first adverb and its details.\"\"\"\n        for token in sentence.tokens:\n            if token.is_adverb():\n                adverb_text = self._normalize(token.text)\n                # Calculate the end_index based on the original start_index and length of normalized adverb.\n                end_index = token.start_index + len(adverb_text)\n                return (token.start_index, end_index, adverb_text)\n        return None # Return None if no adverb is found, as behavior is unspecified\n\n    def _normalize(self, text: str) -> str:\n        \"\"\"Removes leading and trailing punctuation from a string.\"\"\"\n        return text.strip(string.punctuation)\n\ndef find_adverb_position(sentence: str) -> tuple[int, int, str] | None:\n    \"\"\"\n    Finds the first adverb and its position in a given sentence.\n    Returns (start_index, end_index, adverb_text) or None if no adverb is found.\n    \"\"\"\n    s = Sentence(sentence)\n    s.tokenize()\n    finder = AdverbFinder()\n    return finder.find_adverb_position(s)"}
