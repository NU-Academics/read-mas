{"task_id": "Mbpp/131", "solution": "class VowelSet:\n    \"\"\"Encapsulates the vowel set definition and a helper to test vowel membership.\"\"\"\n    def __init__(self):\n        self.letters = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n\n    def is_vowel(self, ch: str) -> bool:\n        \"\"\"Checks if a character is considered a vowel.\"\"\"\n        return ch in self.letters\n\ndef reverse_vowels(s: str) -> str:\n    \"\"\"\n    Reverses only the vowels of a given string (where y is not a vowel).\n    Non-vowel characters remain in their original positions.\n    \"\"\"\n    vowel_checker = VowelSet()\n\n    # Identify and collect all vowels from the input string in their original order.\n    vowels_in_s = [char for char in s if vowel_checker.is_vowel(char)]\n\n    # If no vowels are found, return the original string unchanged.\n    if not vowels_in_s:\n        return s\n\n    # Reverse the collected vowels for re-insertion.\n    reversed_vowels = list(reversed(vowels_in_s))\n    reversed_vowel_ptr = 0\n\n    # Build the result string by iterating through the original and replacing vowels.\n    result_chars = list(s)\n    for i in range(len(s)):\n        if vowel_checker.is_vowel(s[i]):\n            result_chars[i] = reversed_vowels[reversed_vowel_ptr]\n            reversed_vowel_ptr += 1\n\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/135", "solution": "class ValidationError(Exception):\n    \"\"\"Exception raised for invalid input to hexagonal number calculation.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\n    def __str__(self) -> str:\n        return self.message\n\ndef validate(n) -> None:\n    \"\"\"Validates that n is an integer and n >= 1, raising ValidationError if not.\"\"\"\n    if not isinstance(n, int):\n        raise ValidationError(\"Input 'n' must be an integer.\")\n    if n < 1:\n        raise ValidationError(\"Input 'n' must be greater than or equal to 1.\")\n\ndef compute(n) -> int:\n    \"\"\"Computes the nth hexagonal number using the formula n * (2 * n - 1).\"\"\"\n    return n * (2 * n - 1)\n\ndef hexagonal_num(n) -> int:\n    \"\"\"\n    Calculates the nth hexagonal number.\n\n    This function first validates the input `n` to ensure it is an integer\n    and greater than or equal to 1, then computes the hexagonal number.\n    \"\"\"\n    validate(n)\n    return compute(n)"}
{"task_id": "Mbpp/133", "solution": "from typing import Iterable, Union, List\n\nNumberType = Union[int, float]\n\nclass SumNegativeNum:\n    def calculate(self, inputList: Iterable[NumberType]) -> NumberType:\n        \"\"\"Orchestrate validation, filtering, summation; return numeric result or raise TypeError.\"\"\"\n        self.validateInput(inputList)\n        negs = self.filterNegatives(inputList)\n        return self.sum(negs)\n\n    def validateInput(self, inputList: Iterable[NumberType]):\n        \"\"\"Validate that inputList is iterable and all elements are int or float.\n        Raises TypeError if inputList is not iterable or any element is not a numeric type.\"\"\"\n        if not isinstance(inputList, Iterable):\n            raise TypeError(\"inputList must be an iterable of numeric types\")\n        for item in inputList:\n            if not isinstance(item, (int, float)):\n                raise TypeError(\"inputList must be an iterable of numeric types\")\n\n    def filterNegatives(self, inputList: Iterable[NumberType]) -> List[NumberType]:\n        \"\"\"Return a list of elements < 0 from inputList (preserve numeric types).\"\"\"\n        return [num for num in inputList if num < 0]\n\n    def sum(self, values: Iterable[NumberType]) -> NumberType:\n        \"\"\"Compute numeric sum of values; if values is empty, return 0.\"\"\"\n        # The built-in sum() function returns 0 for an empty iterable.\n        return sum(values)\n\ndef sum_negativenum(inputList: Iterable[NumberType]) -> NumberType:\n    \"\"\"Public API: delegate to SumNegativeNum.calculate and return numeric result.\"\"\"\n    return SumNegativeNum().calculate(inputList)"}
{"task_id": "Mbpp/137", "solution": "class InputArray:\n    \"\"\"Represents the input array with its values and length.\"\"\"\n    def __init__(self, values: list):\n        self.values = values\n        self.length = len(values)\n\nclass CountMetrics:\n    \"\"\"Holds the counts of zero and non-zero elements.\"\"\"\n    def __init__(self, zero_count: int, non_zero_count: int):\n        self.zero_count = zero_count\n        self.non_zero_count = non_zero_count\n\nclass RatioResult:\n    \"\"\"Holds the computed ratio and an optional status.\"\"\"\n    def __init__(self, ratio: float, status: str = 'ok'):\n        self.ratio = ratio\n        self.status = status\n\nclass ErrorCondition:\n    \"\"\"Represents an error condition with a code and message.\"\"\"\n    def __init__(self, code: str, message: str):\n        self.code = code\n        self.message = message\n\nclass ZeroCountFunction:\n    \"\"\"Stateless computation unit for calculating zero/non-zero ratios.\"\"\"\n    def compute(self, input_array: InputArray) -> float:\n        \"\"\"\n        Computes the ratio of zeroes to non-zeroes in the input array.\n        Raises ValueError if all elements are zero.\n        \"\"\"\n        zero_count = 0\n        non_zero_count = 0\n\n        for value in input_array.values:\n            if value == 0:\n                zero_count += 1\n            else:\n                non_zero_count += 1\n\n        if non_zero_count > 0:\n            return float(zero_count / non_zero_count)\n        elif zero_count > 0:  # This implies non_zero_count == 0 and the array is not empty\n            raise ValueError(ErrorCondition('ALL_ZEROS', 'Array contains only zeros, cannot compute ratio of zeroes to non-zeroes.').message)\n        # This branch should not be reached if `zero_count` handles empty arrays before calling `compute`.\n        return 0.0\n\ndef zero_count(values) -> float:\n    \"\"\"\n    Calculates the ratio of zeroes to non-zeroes in an array of integers.\n    Raises TypeError for non-integer elements or ValueError for all-zero arrays; returns 0.0 for an empty array.\n    \"\"\"\n    if not values:  # Handles empty list per FR8, BR6\n        return 0.0\n\n    for value in values:\n        if not isinstance(value, int):\n            raise TypeError(ErrorCondition('INVALID_INPUT_TYPE', 'All elements in the input array must be integers.').message)\n\n    input_array = InputArray(values)\n    return ZeroCountFunction().compute(input_array)"}
{"task_id": "Mbpp/140", "solution": "def extract_singly(iterable):\n    \"\"\"\n    Flattens an iterable of inner sequences into a single set of unique numbers.\n    Each number from all inner sequences is added to a set to ensure uniqueness.\n    \"\"\"\n    result_set = set()\n    for inner_sequence in iterable:\n        for number in inner_sequence:\n            result_set.add(number)\n    return result_set"}
