{"task_id": "Mbpp/270", "solution": "def sum_even_and_even_index(input_list: list[int]) -> int:\n    \"\"\"Compute the sum of elements that are even and at even zero-based indices.\n\n    The function iterates through the list, adding elements that meet both criteria to a running total.\n    \"\"\"\n    total_sum = 0\n    for i, value in enumerate(input_list):\n        if i % 2 == 0 and value % 2 == 0:\n            total_sum += value\n    return total_sum"}
{"task_id": "Mbpp/268", "solution": "import logging\n\nclass InputError(Exception):\n    \"\"\"Custom exception for invalid input errors.\"\"\"\n    def __init__(self, message: str, code: int):\n        super().__init__(message)\n        self.message = message\n        self.code = code\n\nclass StarNumber:\n    \"\"\"Encapsulates the star-number domain object and closed-form computation.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n        self.value = None\n\n    def compute(self) -> int:\n        \"\"\"Computes the star number using the formula 6 * n * (n - 1) + 1.\"\"\"\n        self.value = 6 * self.n * (self.n - 1) + 1\n        return self.value\n\nclass ValidationResult:\n    \"\"\"Represents the result of an input validation.\"\"\"\n    def __init__(self, is_valid: bool, error_message: str = \"\"):\n        self.is_valid = is_valid\n        self.error_message = error_message\n\nclass Validator:\n    \"\"\"Enforces the input contract for star numbers.\"\"\"\n    def is_positive_integer(self, n) -> bool:\n        \"\"\"Checks if n is an integer and positive (n >= 1).\"\"\"\n        return isinstance(n, int) and n >= 1\n\n    def validate(self, n) -> ValidationResult:\n        \"\"\"Validates the input n and returns a ValidationResult.\"\"\"\n        if self.is_positive_integer(n):\n            return ValidationResult(is_valid=True)\n        else:\n            return ValidationResult(is_valid=False, error_message=f\"Input 'n' must be a positive integer (n >= 1), but got {n} of type {type(n).__name__}.\")\n\nclass StarNumberService:\n    \"\"\"Orchestrates validation and computation of star numbers.\"\"\"\n    def find_star_num(self, n) -> int:\n        \"\"\"Validates input, computes the star number, or raises InputError.\"\"\"\n        validation_result = self.validate_input(n)\n        if not validation_result.is_valid:\n            logging.error(validation_result.error_message)\n            raise InputError(validation_result.error_message, code=400)\n        return self.compute_star_number(n)\n\n    def compute_star_number(self, n) -> int:\n        \"\"\"Creates a StarNumber object and computes its value.\"\"\"\n        star_num_obj = StarNumber(n)\n        return star_num_obj.compute()\n\n    def validate_input(self, n) -> ValidationResult:\n        \"\"\"Uses Validator to check if input n is valid.\"\"\"\n        validator = Validator()\n        return validator.validate(n)\n\ndef find_star_num(n):\n    \"\"\"\n    Finds the n'th star number.\n\n    Delegates to StarNumberService to validate input and compute the value.\n    \"\"\"\n    service = StarNumberService()\n    return service.find_star_num(n)"}
{"task_id": "Mbpp/271", "solution": "def even_Power_Sum(n):\n    \"\"\"\n    Calculates the sum of the first n even natural numbers, each raised to the fifth power.\n    Validates input for type and value, raising TypeError or ValueError for invalid n.\n    \"\"\"\n\n    def _validate_n(n_param):\n        \"\"\"Internal helper to validate the input parameter n.\"\"\"\n        if not isinstance(n_param, int):\n            raise TypeError(\"n must be an integer\")\n        if n_param < 1:\n            raise ValueError(\"n must be a positive integer (n >= 1)\")\n\n    def _generate_even_sequence(n_param):\n        \"\"\"Internal helper to generate a list of the first n even natural numbers.\"\"\"\n        return [2 * k for k in range(1, n_param + 1)]\n\n    def _pow5(x):\n        \"\"\"Internal helper to compute a number raised to the fifth power.\"\"\"\n        return x ** 5\n\n    _validate_n(n)\n\n    total_sum = 0\n    even_numbers = _generate_even_sequence(n)\n\n    for num in even_numbers:\n        total_sum += _pow5(num)\n\n    return total_sum"}
