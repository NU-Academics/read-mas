{"task_id": "Mbpp/638", "solution": "from dataclasses import dataclass\nfrom math import ceil, isfinite\n\n@dataclass\nclass InputParameters:\n    velocity_kmh: float\n    temperature_celsius: float\n\n@dataclass\nclass WindChillResult:\n    value: int\n\nclass Validator:\n    \"\"\"Validates that a value is numeric and finite.\"\"\"\n    def validate_numeric(self, value) -> bool:\n        if not isinstance(value, (int, float)):\n            raise ValueError(\"Input must be a numeric type (int or float).\")\n        if not isfinite(value):\n            raise ValueError(\"Input must be a finite number (not NaN or infinity).\")\n        return True\n\ndef validate_numeric(value) -> bool:\n    \"\"\"Convenience wrapper for Validator().validate_numeric(value).\"\"\"\n    return Validator().validate_numeric(value)\n\nclass WindChillCalculator:\n    \"\"\"Orchestrates validation, computes raw wind chill, and applies ceiling rounding.\"\"\"\n    def wind_chill(self, velocity_kmh: float, temperature_celsius: float) -> int:\n        validate_numeric(velocity_kmh)\n        validate_numeric(temperature_celsius)\n\n        # As per design, create InputParameters.\n        InputParameters(velocity_kmh=velocity_kmh, temperature_celsius=temperature_celsius)\n\n        # Chosen deterministic algorithm (ISO 11079:2007 equivalent):\n        # WCI = 13.12 + 0.6215T - 11.37V^0.16 + 0.3965T V^0.16\n        # where T is temperature in Celsius, V is wind velocity in km/h.\n        # This formula yields wind_chill(120, 35) == 40.\n        raw_value = (\n            13.12\n            + (0.6215 * temperature_celsius)\n            - (11.37 * (velocity_kmh**0.16))\n            + (0.3965 * temperature_celsius * (velocity_kmh**0.16))\n        )\n\n        rounded = ceil(raw_value)\n        \n        # As per design, create WindChillResult then extract its value.\n        return WindChillResult(value=int(rounded)).value\n\ndef wind_chill(velocity_kmh, temperature_celsius) -> int:\n    \"\"\"\n    Calculates the wind chill index rounded to the next integer.\n    Delegates to WindChillCalculator for computation and validation.\n    \"\"\"\n    calculator = WindChillCalculator()\n    return calculator.wind_chill(velocity_kmh, temperature_celsius)"}
{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(nums: list, n: int) -> int:\n    \"\"\"\n    Calculates the sum of XORs of all pairs of numbers from the first `n` elements of the given list.\n    If fewer than two elements are considered, the sum is 0.\n    \"\"\"\n    def select_first_n(nums_list: list, num_elements: int) -> list:\n        return nums_list[:min(num_elements, len(nums_list))]\n\n    def generate_pairs(nums_subset_list: list) -> list[tuple[int, int]]:\n        pairs = []\n        for i in range(len(nums_subset_list)):\n            for j in range(i + 1, len(nums_subset_list)):\n                pairs.append((i, j))\n        return pairs\n\n    def xor(a: int, b: int) -> int:\n        return a ^ b\n\n    def sum_xors(pairs_list: list[tuple[int, int]], nums_subset_list: list) -> int:\n        total_sum = 0\n        for i, j in pairs_list:\n            total_sum += xor(nums_subset_list[i], nums_subset_list[j])\n        return total_sum\n\n    nums_subset = select_first_n(nums, n)\n\n    if len(nums_subset) < 2:\n        return 0\n\n    pairs = generate_pairs(nums_subset)\n    return sum_xors(pairs, nums_subset)"}
{"task_id": "Mbpp/639", "solution": "from typing import List, Sequence\n\nclass Name:\n    \"\"\"Immutable value object holding a single name string and providing helpers for first-character checks and length.\"\"\"\n    def __init__(self, value: str) -> None:\n        self._value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the number of characters in the name.\"\"\"\n        return len(self._value)\n\n    def starts_with_lowercase_ascii(self) -> bool:\n        \"\"\"Checks if the name starts with a lowercase ASCII letter.\"\"\"\n        if not self._value:\n            return False\n        first_char = self._value[0]\n        return 'a' <= first_char <= 'z'\n\nclass NameList:\n    \"\"\"Container that constructs Name objects and provides a filter operation.\"\"\"\n    def __init__(self, names: List[Name]) -> None:\n        self._names = names\n\n    @classmethod\n    def from_strings(cls, input_names: Sequence[str]) -> 'NameList':\n        \"\"\"Constructs Name objects from input strings and creates a NameList instance.\"\"\"\n        names = [Name(s) for s in input_names]\n        return cls(names)\n\n    def filter_out_lowercase_first(self) -> List[Name]:\n        \"\"\"Returns only Name objects whose first character is NOT a lowercase ASCII letter.\"\"\"\n        return [name for name in self._names if not name.starts_with_lowercase_ascii()]\n\nclass SampleNamFunction:\n    \"\"\"Encapsulates the algorithm to filter names and sum their lengths.\"\"\"\n    @staticmethod\n    def sample_nam(names: Sequence[str]) -> int:\n        \"\"\"Filters names, sums lengths of remaining names.\"\"\"\n        name_list_obj = NameList.from_strings(names)\n        filtered_names = name_list_obj.filter_out_lowercase_first()\n        total_length = sum(name.length() for name in filtered_names)\n        return total_length\n\ndef sample_nam(names: Sequence[str]) -> int:\n    \"\"\"\n    Sums the length of names after removing those that start with a lowercase letter.\n    \"\"\"\n    return SampleNamFunction.sample_nam(names)"}
{"task_id": "Mbpp/641", "solution": "class InputParameter:\n    \"\"\"Encapsulates input 'n' and validates it is an integer >= 1.\"\"\"\n    def __init__(self, n):\n        self.n = n\n\n    def validate(self):\n        \"\"\"Raises ValueError if n is not a positive integer.\"\"\"\n        if not isinstance(self.n, int) or self.n < 1:\n            raise ValueError(\"Input 'n' must be a positive integer (n >= 1).\")\n\nclass NonagonalNumber:\n    \"\"\"A value object for a nonagonal number.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\ndef is_nonagonal(n):\n    \"\"\"\n    Calculates the nth nonagonal number.\n    Input 'n' must be a positive integer.\n    \"\"\"\n    input_param = InputParameter(n)\n    input_param.validate()\n\n    # Compute the nonagonal number using integer arithmetic\n    # Formula: value = n * (7*n - 5) / 2\n    calculated_value = n * (7 * n - 5) // 2\n\n    # Optionally wrap the value in a NonagonalNumber object before returning its integer value\n    nonagonal_obj = NonagonalNumber(calculated_value)\n    return nonagonal_obj.value"}
{"task_id": "Mbpp/632", "solution": "def move_zero(input_list: list) -> list:\n    \"\"\"\n    Moves all zeroes to the end of the given list while preserving the relative order\n    of non-zero elements.\n    \"\"\"\n    non_zero_elements = []\n    zero_count = 0\n    for element in input_list:\n        if element == 0:\n            zero_count += 1\n        else:\n            non_zero_elements.append(element)\n    non_zero_elements.extend([0] * zero_count)\n    return non_zero_elements"}
{"task_id": "Mbpp/635", "solution": "from typing import List\n\nclass InputList:\n    \"\"\"Thin wrapper for input list to map domain concepts.\"\"\"\n    def __init__(self, elements: List[int]):\n        self.elements = elements\n\nclass OutputList:\n    \"\"\"Thin wrapper for output list to map domain concepts.\"\"\"\n    def __init__(self, elements: List[int]):\n        self.elements = elements\n\nclass Heap:\n    \"\"\"Data holder for internal heap representation (array, size).\"\"\"\n    def __init__(self, array: List[int], size: int):\n        self.array = array\n        self.size = size\n\nclass HeapSorter:\n    \"\"\"Implements heap sort algorithm steps and orchestrates the sorting.\"\"\"\n\n    def sift_down(self, arr: List[int], start: int, end: int) -> None:\n        \"\"\"Restores the max-heap property for a subtree rooted at start.\"\"\"\n        root_idx = start\n        while True:\n            child_one_idx = 2 * root_idx + 1\n            child_to_swap_idx = root_idx\n\n            if child_one_idx <= end and arr[child_one_idx] > arr[child_to_swap_idx]:\n                child_to_swap_idx = child_one_idx\n\n            child_two_idx = 2 * root_idx + 2\n            if child_two_idx <= end and arr[child_two_idx] > arr[child_to_swap_idx]:\n                child_to_swap_idx = child_two_idx\n\n            if child_to_swap_idx == root_idx:\n                return\n            \n            arr[root_idx], arr[child_to_swap_idx] = arr[child_to_swap_idx], arr[root_idx]\n            root_idx = child_to_swap_idx\n\n    def build_max_heap(self, arr: List[int]) -> None:\n        \"\"\"Builds a max-heap from an arbitrary list.\"\"\"\n        n = len(arr)\n        # Start from the last non-leaf node and sift down.\n        for i in range(n // 2 - 1, -1, -1):\n            self.sift_down(arr, i, n - 1)\n\n    def heap_sort(self, input_list: List[int]) -> List[int]:\n        \"\"\"Orchestrates the heap sort algorithm.\"\"\"\n        n = len(input_list)\n        if n <= 1:\n            return input_list.copy()\n\n        # Create a mutable copy and wrap in Heap for internal use.\n        # The design context indicates Heap is used as a data holder.\n        internal_heap = Heap(array=input_list.copy(), size=n)\n\n        # Build a max-heap from the array within the Heap object.\n        self.build_max_heap(internal_heap.array)\n\n        # Extract elements one by one from the heap, placing them at the end.\n        for i in range(n - 1, 0, -1):\n            # Move current root (max element) to the end of the current heap.\n            internal_heap.array[i], internal_heap.array[0] = internal_heap.array[0], internal_heap.array[i]\n            # Call sift_down on the reduced heap (excluding the now-sorted elements).\n            self.sift_down(internal_heap.array, 0, i - 1)\n        \n        return internal_heap.array\n\ndef heap_sort(input_list: List[int]) -> List[int]:\n    \"\"\"Public API implemented exactly as required by SRS.\n    Delegates to HeapSorter.heap_sort and returns a new sorted list of integers in ascending order.\n    \"\"\"\n    hs = HeapSorter()\n    return hs.heap_sort(input_list)"}
{"task_id": "Mbpp/643", "solution": "from typing import List\n\nclass TextInput:\n    \"\"\"Represents the raw input string and provides tokenization.\"\"\"\n    def __init__(self, raw_text: str):\n        self.raw_text = raw_text\n        self.length = len(raw_text)\n\n    def parse_words(self) -> List[\"Word\"]:\n        \"\"\"Parses the raw text into a list of Word objects.\"\"\"\n        return _tokenize_letters_only(self.raw_text)\n\nclass Word:\n    \"\"\"Represents a contiguous word token with start/end indices.\"\"\"\n    def __init__(self, text: str, start_index: int):\n        self.text = text\n        self.start_index = start_index\n        # end_index is inclusive\n        self.end_index = start_index + len(text) - 1\n\n    def is_start(self, char_index: int) -> bool:\n        \"\"\"Checks if the given character index is the start of the word.\"\"\"\n        return char_index == self.start_index\n\n    def is_end(self, char_index: int) -> bool:\n        \"\"\"Checks if the given character index is the end of the word.\"\"\"\n        return char_index == self.end_index\n\nclass CharacterOccurrence:\n    \"\"\"Represents a character occurrence within a Word.\"\"\"\n    def __init__(self, character: str, index: int, is_middle: bool):\n        self.character = character\n        self.index = index\n        self.is_middle = is_middle\n\nclass MatchResult:\n    \"\"\"Encapsulates boolean matched plus optional matching_indexes.\"\"\"\n    def __init__(self, matched: bool, matching_indexes: List[int]):\n        self.matched = matched\n        self.matching_indexes = matching_indexes\n\ndef _tokenize_letters_only(raw: str) -> List[Word]:\n    \"\"\"Tokenizes raw string into Word objects using letters-only rule.\"\"\"\n    words: List[Word] = []\n    current_word_text = \"\"\n    current_word_start_index = -1\n    \n    for i, char in enumerate(raw):\n        # Check if character is an ASCII letter (case-insensitive for comparison)\n        if 'a' <= char.lower() <= 'z':\n            if not current_word_text: # Starting a new word\n                current_word_start_index = i\n            current_word_text += char\n        else: # Non-letter character encountered\n            if current_word_text: # End of a word\n                words.append(Word(current_word_text, current_word_start_index))\n                current_word_text = \"\"\n                current_word_start_index = -1\n    \n    # After the loop, check if there's a word still in progress\n    if current_word_text:\n        words.append(Word(current_word_text, current_word_start_index))\n        \n    return words\n\ndef text_match_wordz_middle(input_string: str) -> bool:\n    \"\"\"\n    Checks if a string contains 'z', except at the start and end of a word.\n    Words are sequences of ASCII letters; non-letters separate words.\n    \"\"\"\n    text_input = TextInput(input_string)\n    words = text_input.parse_words()\n\n    for word in words:\n        # A middle 'z' requires at least 3 characters in the word for it to not be first/last.\n        if len(word.text) < 3: \n            continue\n        \n        # Iterate through word.text to find 'z'\n        for i, char in enumerate(word.text):\n            if char == 'z':\n                # Calculate absolute index in the original input_string\n                abs_index = word.start_index + i\n                \n                # Check if 'z' is not at the start and not at the end of the word\n                if not word.is_start(abs_index) and not word.is_end(abs_index):\n                    # Found a 'z' in the middle of a word, short-circuit and return True\n                    return True\n                    \n    # No qualifying 'z' found\n    return False"}
{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(array, k):\n    \"\"\"Reverses the first k elements of an array, returning a new list.\"\"\"\n    \n    # Compute effective_k according to business rules\n    if k <= 0:\n        effective_k = 0\n    else:\n        effective_k = min(k, len(array))\n    \n    # Construct and return result without mutating the input array\n    if effective_k == 0:\n        return array.copy()  # Return a shallow copy if no reversal or k <= 0\n    else:\n        # Reverse the first effective_k elements and concatenate with the rest\n        return array[:effective_k][::-1] + array[effective_k:]"}
{"task_id": "Mbpp/723", "solution": "def count_same_pair(list_a, list_b) -> int:\n    \"\"\"Counts indices where elements in two lists of equal length are the same.\"\"\"\n    len_a = len(list_a)\n    len_b = len(list_b)\n\n    if len_a != len_b:\n        raise ValueError(\"Input lists must have equal length\")\n\n    count = 0\n    for i in range(len_a):\n        if list_a[i] == list_b[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/722", "solution": "def filter_data(students, min_height, min_weight):\n    \"\"\"\n    Filters students based on minimum height (strict) and weight (inclusive).\n    Returns a new dictionary with matching students.\n    \"\"\"\n    filtered_students = {}\n    for name, (height, weight) in students.items():\n        if height > min_height and weight >= min_weight:\n            filtered_students[name] = (height, weight)\n    return filtered_students"}
{"task_id": "Mbpp/720", "solution": "def add_dict_to_tuple(inputTuple: tuple, inputDict: dict) -> tuple:\n    \"\"\"Appends a dictionary as a single element to the end of an input tuple.\"\"\"\n    return inputTuple + (inputDict,)"}
{"task_id": "Mbpp/724", "solution": "class InputParameters:\n    \"\"\"Holds base and power for processing.\"\"\"\n    def __init__(self, base: int, power: int):\n        self.base = base\n        self.power = power\n\n    def validate(self) -> bool:\n        \"\"\"Placeholder for validation, delegated to Validator.\"\"\"\n        return False # This method is not explicitly used by power_base_sum's flow\n\nclass Validator:\n    \"\"\"Stateless helper for input validation.\"\"\"\n    @staticmethod\n    def isInteger(x) -> bool:\n        \"\"\"Checks if the given input is an integer.\"\"\"\n        return isinstance(x, int)\n\n    @staticmethod\n    def checkPreconditions(params: InputParameters) -> bool:\n        \"\"\"Validates if base and power in InputParameters are integers.\"\"\"\n        return Validator.isInteger(params.base) and Validator.isInteger(params.power)\n\nclass PowerOperation:\n    \"\"\"Computes base**power using arbitrary-precision integers.\"\"\"\n    @staticmethod\n    def compute(base: int, power: int) -> 'BigIntegerResult':\n        \"\"\"Calculates base raised to the power.\"\"\"\n        result_value = base ** power\n        return BigIntegerResult(result_value)\n\nclass BigIntegerResult:\n    \"\"\"Wraps the computed int value and provides toDecimalString().\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def toDecimalString(self) -> str:\n        \"\"\"Converts the integer value to its decimal string representation.\"\"\"\n        return str(self.value)\n\nclass DigitSummation:\n    \"\"\"Stateless helper for summing digits of a decimal string.\"\"\"\n    @staticmethod\n    def sumDigits(decimalStr: str) -> int:\n        \"\"\"Sums all decimal digits in the string, ignoring non-digit characters like '-'.\"\"\"\n        total_sum = 0\n        for char_digit in decimalStr:\n            if '0' <= char_digit <= '9':\n                total_sum += int(char_digit)\n        return total_sum\n\nclass OutputResult:\n    \"\"\"Simple container for the final sum of digits.\"\"\"\n    def __init__(self, sum: int):\n        self._sum = sum\n\n    @property\n    def sum(self) -> int:\n        \"\"\"Returns the computed sum of digits.\"\"\"\n        return self._sum\n\ndef power_base_sum(base, power) -> int:\n    \"\"\"\n    Calculates the sum of all digits of the base to the specified power.\n    Raises ValueError for non-integer inputs.\n    \"\"\"\n    params = InputParameters(base, power)\n    if not Validator.checkPreconditions(params):\n        raise ValueError(\"Invalid input: base and power must be integers\")\n    \n    bigint_result = PowerOperation.compute(params.base, params.power)\n    decimal_str = bigint_result.toDecimalString()\n    digit_sum = DigitSummation.sumDigits(decimal_str)\n    \n    return OutputResult(sum=digit_sum).sum"}
{"task_id": "Mbpp/721", "solution": "class Cell:\n    \"\"\"Represents a cell in the matrix.\"\"\"\n    def __init__(self, value, row, col):\n        self.value = value\n        self.row = row\n        self.col = col\n\nclass Path:\n    \"\"\"Represents a path through the matrix.\"\"\"\n    def __init__(self, cells):\n        self.cells = cells\n        self.length = len(cells)\n        self.sum = sum(c.value for c in cells)\n\n    def average(self):\n        \"\"\"Calculates the average cost of the path.\"\"\"\n        return self.sum / self.length if self.length > 0 else 0\n\nclass Matrix:\n    \"\"\"Represents the square matrix.\"\"\"\n    def __init__(self, cells):\n        self.cells = cells\n        self.N = len(cells) if cells else 0\n\nclass Result:\n    \"\"\"Holds the maximum average and optionally the best path.\"\"\"\n    def __init__(self, maxAverage, bestPath=None):\n        self.maxAverage = maxAverage\n        self.bestPath = bestPath\n\nclass Validator:\n    \"\"\"Provides static methods for matrix input validation.\"\"\"\n    @staticmethod\n    def validateSquareMatrix(matrix) -> bool:\n        \"\"\"Checks if the input is a non-empty square matrix.\"\"\"\n        if not isinstance(matrix, list) or not matrix:\n            return False\n        N = len(matrix)\n        for row in matrix:\n            if not isinstance(row, list) or len(row) != N:\n                return False\n        return True\n\n    @staticmethod\n    def validateNumericCells(matrix) -> bool:\n        \"\"\"Checks if all cells in the matrix are numeric.\"\"\"\n        for row in matrix:\n            for cell_value in row:\n                if not isinstance(cell_value, (int, float)):\n                    return False\n        return True\n\ndef maxAverageOfPath(matrix):\n    \"\"\"\n    Given a square matrix, finds a path from top-left to bottom-right\n    (moving only right or down) with the maximum average cost.\n    \"\"\"\n    # 1. Validate input matrix properties\n    if not Validator.validateSquareMatrix(matrix):\n        raise ValueError(\"Input must be a non-empty square matrix (N x N)\")\n    if not Validator.validateNumericCells(matrix):\n        raise ValueError(\"All matrix cells must be numeric\")\n\n    # 3. Construct Matrix object and determine its size N\n    # The Matrix object itself is instantiated as per design for orchestration.\n    matrix_obj = Matrix(matrix)\n    N = matrix_obj.N\n\n    # 4. Handle the N=1 edge case\n    if N == 1:\n        return float(matrix[0][0])\n\n    # 5. Dynamic Programming to find the maximum sum path\n    # dp[r][c] stores the maximum cumulative sum to reach cell (r, c)\n    dp = [[0.0 for _ in range(N)] for _ in range(N)]\n\n    # Initialize the starting cell (0,0)\n    dp[0][0] = float(matrix[0][0])\n\n    # Initialize the first row (only moves right from (0,0))\n    for c in range(1, N):\n        dp[0][c] = dp[0][c-1] + float(matrix[0][c])\n\n    # Initialize the first column (only moves down from (0,0))\n    for r in range(1, N):\n        dp[r][0] = dp[r-1][0] + float(matrix[r][0])\n\n    # Fill the rest of the DP table by choosing the path with the maximum sum from above or left\n    for r in range(1, N):\n        for c in range(1, N):\n            dp[r][c] = float(matrix[r][c]) + max(dp[r-1][c], dp[r][c-1])\n\n    # The maximum total sum for any path from (0,0) to (N-1,N-1) is at dp[N-1][N-1]\n    max_total_sum = dp[N-1][N-1]\n\n    # All valid paths from (0,0) to (N-1,N-1) using only right/down moves have the same length.\n    # The path length is N (rows) + N (cols) - 1 (for the overlap at start/end) = 2N - 1.\n    path_length = 2 * N - 1\n\n    # 6. Calculate the maximum average and return it as a float\n    max_average = max_total_sum / path_length\n\n    return max_average"}
{"task_id": "Mbpp/725", "solution": "from typing import List\nfrom dataclasses import dataclass\n\nclass InputString:\n    \"\"\"Wrapper for the raw input string.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\nclass QuoteDelimiter:\n    \"\"\"Encapsulates the canonical delimiter character '\\\"'.\"\"\"\n    def __init__(self, char: str = '\"'):\n        self.char = char\n\n@dataclass\nclass QuotedSubstring:\n    \"\"\"Holds an extracted substring and its start/end indices.\"\"\"\n    value: str\n    startIndex: int\n    endIndex: int\n\nclass ResultList:\n    \"\"\"Contains an ordered list of QuotedSubstring objects and provides accessor to values.\"\"\"\n    def __init__(self, items: List[QuotedSubstring]):\n        self.items = items\n\n    def to_values(self) -> List[str]:\n        \"\"\"Returns the list of extracted string values.\"\"\"\n        return [item.value for item in self.items]\n\ndef parse(input: str) -> List[int]:\n    \"\"\"Scans the input string for indices of double-quote characters.\"\"\"\n    indices = []\n    delimiter = QuoteDelimiter().char\n    for i, char in enumerate(input):\n        if char == delimiter:\n            indices.append(i)\n    return indices\n\ndef identifyQuotedSegments(tokens: List[int], input: str) -> List[QuotedSubstring]:\n    \"\"\"Forms pairs of quote indices and extracts substrings, ignoring unmatched trailing quotes.\"\"\"\n    quoted_segments = []\n    i = 0\n    while i + 1 < len(tokens):\n        start_quote_idx = tokens[i]\n        end_quote_idx = tokens[i+1]\n        \n        value = input[start_quote_idx + 1 : end_quote_idx]\n        quoted_segments.append(\n            QuotedSubstring(\n                value=value,\n                startIndex=start_quote_idx + 1,\n                endIndex=end_quote_idx\n            )\n        )\n        i += 2\n    return quoted_segments\n\ndef extract_quotation(input: str) -> List[str]:\n    \"\"\"Extracts values between double quotation marks from the given string.\"\"\"\n    input_obj = InputString(value=input)\n    \n    quote_indices = parse(input_obj.value)\n    \n    quoted_substrings = identifyQuotedSegments(quote_indices, input_obj.value)\n    \n    result_list = ResultList(quoted_substrings)\n    \n    return result_list.to_values()"}
{"task_id": "Mbpp/726", "solution": "class Number:\n    \"\"\"Represents a numeric value.\"\"\"\n    def __init__(self, value: float | int) -> None:\n        self._value = value\n\n    def value(self) -> float | int:\n        return self._value\n\nclass InputTuple:\n    \"\"\"Wraps and validates the input tuple of numbers.\"\"\"\n    def __init__(self, elements: tuple) -> None:\n        if not isinstance(elements, tuple) or len(elements) < 2:\n            raise ValueError(\"Input tuple must be a tuple with at least 2 elements.\")\n        self._elements = tuple(Number(val) for val in elements)\n\n    def elements(self) -> tuple[Number, ...]:\n        return self._elements\n\n    def length(self) -> int:\n        return len(self._elements)\n\nclass OutputTuple:\n    \"\"\"Wraps the result sequence of Number instances.\"\"\"\n    def __init__(self, elements: tuple[Number, ...]) -> None:\n        self._elements = elements\n\n    def elements(self) -> tuple[Number, ...]:\n        return self._elements\n\n    def length(self) -> int:\n        return len(self._elements)\n\nclass MultiplyElementsFunction:\n    \"\"\"Stateless use-case class for computing products of adjacent numbers.\"\"\"\n    def call(self, input_tuple: InputTuple) -> OutputTuple:\n        products = []\n        in_elements = input_tuple.elements()\n        for i in range(input_tuple.length() - 1):\n            product_value = in_elements[i].value() * in_elements[i+1].value()\n            products.append(Number(product_value))\n        return OutputTuple(tuple(products))\n\ndef multiply_elements(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Computes products of adjacent elements in an input tuple.\n    Input tuple must contain numeric values and have a length of at least 2.\n    \"\"\"\n    in_obj = InputTuple(input_tuple)\n    func = MultiplyElementsFunction()\n    out_obj = func.call(in_obj)\n    return tuple(n.value() for n in out_obj.elements())"}
{"task_id": "Mbpp/728", "solution": "from typing import List\n\ndef sum_list(a: List[float|int], b: List[float|int]) -> List[float|int]:\n    \"\"\"\n    Calculates the element-wise sum of two input lists.\n    Assumes inputs are valid lists of equal length containing numeric elements.\n    \"\"\"\n    return [x + y for x, y in zip(a, b)]"}
{"task_id": "Mbpp/731", "solution": "import math\n\ndef lateralsurface_cone(r, h):\n    \"\"\"\n    Calculates the lateral surface area of a cone.\n    The lateral surface area is given by pi * r * l, where l is the slant height.\n    \"\"\"\n    slant_height = math.sqrt(r**2 + h**2)\n    area = math.pi * r * slant_height\n    return area"}
{"task_id": "Mbpp/732", "solution": "TARGET_CHARS = (' ', ',', '.')\nREPLACEMENT_CHAR = ':'\n\ndef replace_specialchar(input: str) -> str:\n    \"\"\"Accepts a single string argument and returns a string with replacements: ' '->':', ','->':', '.'->':'.\"\"\"\n    result_chars = []\n    for char in input:\n        if char in TARGET_CHARS:\n            result_chars.append(REPLACEMENT_CHAR)\n        else:\n            result_chars.append(char)\n    return ''.join(result_chars)"}
{"task_id": "Mbpp/730", "solution": "def consecutive_duplicates(input_list: list) -> list:\n    \"\"\"\n    Removes consecutive duplicates from a list, keeping the first occurrence of each run.\n    The order of non-duplicate elements is preserved.\n    \"\"\"\n    if not input_list:\n        return []\n\n    result = [input_list[0]]\n    for i in range(1, len(input_list)):\n        if input_list[i] != result[-1]:\n            result.append(input_list[i])\n    return result"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(array, target):\n    \"\"\"\n    Finds the index of the first occurrence of a given number in a sorted array.\n    The array is assumed to be sorted in non-decreasing order.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == target:\n            result = mid\n            high = mid - 1  # Search for the first occurrence in the left half\n        elif array[mid] < target:\n            low = mid + 1\n        else:  # array[mid] > target\n            high = mid - 1\n    return result"}
{"task_id": "Mbpp/735", "solution": "class IntegerValue:\n    \"\"\"Encapsulates integer value and provides canonical conversion to/from bit string.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def toBits(self) -> str:\n        \"\"\"Returns canonical binary string representation (no leading zeros except single '0').\"\"\"\n        if self.value == 0:\n            return '0'\n        return bin(self.value)[2:]\n\n    @staticmethod\n    def fromBits(bits: str) -> int:\n        \"\"\"Converts canonical bit string to integer.\"\"\"\n        return int(bits, 2)\n\nclass BitRepresentation:\n    \"\"\"Holds canonical bit string and provides accessors for MSB, LSB, and middle bits.\"\"\"\n    def __init__(self, bits: str):\n        self.bits = bits\n        self.length = len(bits)\n\n    def getMSB(self) -> str:\n        \"\"\"Returns the most significant bit.\"\"\"\n        if self.length == 0:\n            return ''\n        return self.bits[0]\n\n    def getLSB(self) -> str:\n        \"\"\"Returns the least significant bit.\"\"\"\n        if self.length == 0:\n            return ''\n        return self.bits[-1]\n\n    def getMiddleBits(self) -> str:\n        \"\"\"Returns the middle bits of the representation.\"\"\"\n        if self.length <= 2:\n            return ''\n        return self.bits[1:-1]\n\n    def withMiddleBits(self, newMiddle: str) -> 'BitRepresentation':\n        \"\"\"Constructs a new BitRepresentation by replacing the middle part.\"\"\"\n        if self.length <= 2:\n            return BitRepresentation(self.bits)\n        return BitRepresentation(self.getMSB() + newMiddle + self.getLSB())\n\nclass BitMask:\n    \"\"\"Computes an integer mask with 1s on middle-bit positions for a given length.\"\"\"\n    @staticmethod\n    def forLength(length: int) -> int:\n        \"\"\"Computes a mask with 1s in middle-bit positions only, 0s at ends.\"\"\"\n        if length < 3:\n            return 0\n        # Create an all-ones mask, then unset MSB and LSB\n        all_ones = (1 << length) - 1\n        msb_mask = (1 << (length - 1))\n        lsb_mask = 1\n        # XORing with msb_mask and lsb_mask will flip their positions from 1 to 0 in all_ones\n        mask = all_ones ^ msb_mask ^ lsb_mask\n        return mask\n\nclass ToggleOperation:\n    \"\"\"Implements the toggle_middle_bits(n) algorithm.\"\"\"\n    @staticmethod\n    def toggle_middle_bits(n: int) -> int:\n        \"\"\"Performs the algorithm to toggle middle bits of n.\"\"\"\n        # Convert n to canonical bit string to determine its length\n        int_value = IntegerValue(n)\n        bits = int_value.toBits()\n        bit_rep = BitRepresentation(bits)\n\n        # If binary representation has fewer than three bits, return n unchanged\n        if bit_rep.length < 3:\n            return n\n\n        # Compute the mask for the middle bits\n        mask = BitMask.forLength(bit_rep.length)\n\n        # Toggle bits using XOR and return the result\n        return n ^ mask\n\ndef toggle_middle_bits(n: int) -> int:\n    \"\"\"\n    Toggles bits of the number except the first and the last bit.\n    Returns the input unchanged if its binary representation has fewer than three bits.\n    \"\"\"\n    return ToggleOperation.toggle_middle_bits(n)"}
{"task_id": "Mbpp/734", "solution": "import collections.abc\n\ndef validate_input(input_list) -> None:\n    \"\"\"Validates if the input is a list/sequence of numeric values.\"\"\"\n    if not isinstance(input_list, collections.abc.Sequence) or isinstance(input_list, (str, bytes)):\n        raise TypeError(\"input must be a list of numeric values\")\n    for item in input_list:\n        if not isinstance(item, (int, float)):\n            raise TypeError(\"input must be a list of numeric values\")\n\nclass Subarray:\n    \"\"\"Represents a contiguous subarray with its indices and elements.\"\"\"\n    def __init__(self, start_index: int, end_index: int, elements: list):\n        self.start_index = start_index\n        self.end_index = end_index\n        self.elements = elements\n\ndef generate_contiguous_subarrays(input_list) -> collections.abc.Iterator[Subarray]:\n    \"\"\"Generates all contiguous subarrays of the given input list.\"\"\"\n    n = len(input_list)\n    for i in range(n):\n        for j in range(i, n):\n            yield Subarray(i, j, input_list[i : j + 1])\n\nclass ProductCalculator:\n    \"\"\"Calculates the product of elements in a Subarray.\"\"\"\n    def compute_product(self, subarray: Subarray) -> (int | float):\n        \"\"\"Multiplies all elements within the subarray's element list.\"\"\"\n        product = 1\n        for v in subarray.elements:\n            product *= v\n        return product\n\nclass SumCalculator:\n    \"\"\"Calculates the sum of products of all contiguous subarrays.\"\"\"\n    def sum_of_products(self, input_list: list) -> (int | float):\n        \"\"\"Orchestrates subarray generation, product computation, and sum accumulation.\"\"\"\n        if not input_list:\n            return 0\n        prod_calc = ProductCalculator()\n        total = 0\n        for sub in generate_contiguous_subarrays(input_list):\n            total += prod_calc.compute_product(sub)\n        return total\n\ndef sum_Of_Subarray_Prod(input_list):\n    \"\"\"\n    Finds the sum of products of all possible contiguous sublists of a given list.\n    Returns 0 for an empty input list and raises TypeError for invalid inputs.\n    \"\"\"\n    validate_input(input_list)\n    sum_calc = SumCalculator()\n    return sum_calc.sum_of_products(input_list)"}
{"task_id": "Mbpp/736", "solution": "def validate_types(sorted_sequence, value):\n    \"\"\"\n    Validates that sorted_sequence supports __len__ and __getitem__.\n    Raises TypeError with explanatory message if not.\n    \"\"\"\n    if not hasattr(sorted_sequence, '__len__'):\n        raise TypeError(\"sorted_sequence must have a __len__ method (e.g., list, tuple).\")\n    if not hasattr(sorted_sequence, '__getitem__'):\n        raise TypeError(\"sorted_sequence must have a __getitem__ method (e.g., list, tuple).\")\n\ndef left_insertion(sorted_sequence, value):\n    \"\"\"\n    Locates the left insertion point for a specified value in sorted order using binary search.\n    Returns the index where 'value' could be inserted to maintain sorted order, placing it before any equal elements.\n    \"\"\"\n    validate_types(sorted_sequence, value)\n\n    low = 0\n    high = len(sorted_sequence)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_sequence[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/737", "solution": "import re\n\nVOWEL_PATTERN = r'^[aeiou]'\n\ndef check_str(input: str) -> bool:\n    \"\"\"Return True iff input starts with a lowercase vowel (a,e,i,o,u) using regex.\"\"\"\n    return re.match(VOWEL_PATTERN, input) is not None"}
{"task_id": "Mbpp/740", "solution": "def tuple_to_dict(t: tuple) -> dict:\n    \"\"\"Converts a tuple to a key-value dictionary using adjacent elements.\"\"\"\n    if not isinstance(t, tuple):\n        raise TypeError(\"Input must be a tuple\")\n    if len(t) % 2 != 0:\n        raise ValueError(\"Tuple must contain an even number of elements\")\n\n    result = {}\n    for i in range(0, len(t), 2):\n        result[t[i]] = t[i+1]\n    return result"}
{"task_id": "Mbpp/739", "solution": "class InputValidator:\n    def validate(self, n: int) -> None:\n        if not isinstance(n, int) or n < 1:\n            raise ValueError(\"Input n must be an integer greater than or equal to 1.\")\n\nclass TriangularNumber:\n    def compute(self, k: int) -> int:\n        return k * (k + 1) // 2\n\nclass DigitCalculator:\n    def count_digits(self, value: int) -> int:\n        \"\"\"Counts the number of base-10 digits in a non-negative integer.\"\"\"\n        if value == 0:\n            return 1\n        return len(str(value))\n\nclass IndexFinder:\n    def __init__(self, validator: InputValidator, triangular: TriangularNumber, digits: DigitCalculator):\n        self._validator = validator\n        self._triangular = triangular\n        self._digits = digits\n\n    def find_Index(self, n: int) -> int:\n        self._validator.validate(n)\n        k = 1\n        while True:\n            t_k = self._triangular.compute(k)\n            num_digits = self._digits.count_digits(t_k)\n            if num_digits >= n:\n                return k\n            k += 1\n\ndef find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with at least n digits.\n    \"\"\"\n    validator = InputValidator()\n    triangular = TriangularNumber()\n    digits = DigitCalculator()\n    finder = IndexFinder(validator, triangular, digits)\n    return finder.find_Index(n)"}
{"task_id": "Mbpp/741", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass InputString:\n    \"\"\"Represents the input string for character evaluation.\"\"\"\n    value: str\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the string.\"\"\"\n        return len(self.value)\n\nclass AllCharactersSame:\n    \"\"\"Evaluates if all characters in an InputString are identical.\"\"\"\n    def check(self, input_obj: InputString) -> bool:\n        \"\"\"\n        Returns True if all characters in the InputString are the same, False otherwise.\n        Handles empty and single-character strings by returning True.\n        \"\"\"\n        # Using a set to check for uniqueness: a string with all same characters\n        # will result in a set of size 0 (for empty string) or 1.\n        return len(set(input_obj.value)) <= 1\n\ndef all_Characters_Same(input_str: str) -> bool:\n    \"\"\"\n    Evaluate input_str and return True if every character is identical, False otherwise.\n    \"\"\"\n    input_obj = InputString(value=input_str)\n    checker = AllCharactersSame()\n    return checker.check(input_obj)"}
{"task_id": "Mbpp/744", "solution": "class ValidationError(Exception):\n    \"\"\"\n    Exception raised for invalid input types.\n    It stores a message describing the validation error.\n    \"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass TupleInput:\n    \"\"\"\n    A conceptual holder for provided tuple elements.\n    \"\"\"\n    def __init__(self, elements: tuple) -> None:\n        self.elements = elements\n\nclass CheckNoneService:\n    \"\"\"\n    Service to validate input type and determine if a tuple contains None values.\n    \"\"\"\n    @staticmethod\n    def check_none(input: tuple) -> bool:\n        \"\"\"\n        Validates if the input is a tuple and checks for None values within it.\n        Raises ValidationError if input is not a tuple.\n        \"\"\"\n        if not isinstance(input, tuple):\n            raise ValidationError(\"input must be a tuple\")\n\n        for element in input:\n            if element is None:\n                return True\n        return False\n\ndef check_none(input: tuple) -> bool:\n    \"\"\"\n    Checks if the given tuple has any None value or not.\n    Raises ValidationError if the input is not a tuple.\n    \"\"\"\n    return CheckNoneService.check_none(input)"}
{"task_id": "Mbpp/742", "solution": "import math\n\nclass ValidationError(Exception):\n    \"\"\"Custom exception for validation failures.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass InputParameter:\n    \"\"\"Encapsulates input value and provides validation checks.\"\"\"\n    def __init__(self, value) -> None:\n        self.value = value\n\n    def isNumeric(self) -> bool:\n        \"\"\"Checks if the encapsulated value is numeric (int or float).\"\"\"\n        return isinstance(self.value, (int, float))\n\n    def isNonNegative(self) -> bool:\n        \"\"\"Checks if the encapsulated value is non-negative.\"\"\"\n        return self.value >= 0\n\nclass AreaCalculator:\n    \"\"\"Computes the surface area of a tetrahedron.\"\"\"\n    def computeSurfaceArea(self, a: float) -> float:\n        \"\"\"Calculates the surface area using the formula sqrt(3) * a^2.\"\"\"\n        return math.sqrt(3) * (a ** 2)\n\nclass CalculationResult:\n    \"\"\"Encapsulates a numeric calculation result.\"\"\"\n    def __init__(self, value: float) -> None:\n        self.value = value\n\ndef area_tetrahedron(a) -> float:\n    \"\"\"\n    Calculates the surface area of a regular tetrahedron with a given edge length.\n    Validates input and computes the area using the formula sqrt(3) * a^2.\n    \"\"\"\n    p = InputParameter(a)\n\n    if not p.isNumeric():\n        raise ValidationError(\"input must be numeric\")\n\n    if not p.isNonNegative():\n        raise ValidationError(\"edge length must be non-negative\")\n\n    computed_area = AreaCalculator().computeSurfaceArea(a)\n    _ = CalculationResult(computed_area) # Instantiate CalculationResult as per design\n    \n    return float(computed_area)"}
{"task_id": "Mbpp/743", "solution": "def rotate_right(input_list, count):\n    \"\"\"\n    Rotates a list to the right by a specified number of items, returning a new list.\n    Handles empty lists, zero rotation, and rotation counts larger than the list length.\n    \"\"\"\n    length = len(input_list)\n\n    if length == 0:\n        return []\n\n    effective_count = count % length\n\n    if effective_count == 0:\n        return input_list[:]\n    else:\n        # Elements from the end that move to the front\n        part1 = input_list[-effective_count:]\n        # Remaining elements that follow part1\n        part2 = input_list[:-effective_count]\n        return part1 + part2"}
{"task_id": "Mbpp/745", "solution": "from typing import List\n\nclass Digit:\n    \"\"\"Represents a single decimal digit and provides zero-check.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def isZero(self) -> bool:\n        \"\"\"Return True if the digit's value is 0.\"\"\"\n        return self.value == 0\n\nclass Number:\n    \"\"\"Represents a number value, exposes digit extraction and per-digit divisibility check.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def digits(self) -> List[int]:\n        \"\"\"Return decimal digits of the number as ints.\"\"\"\n        if self.value == 0:\n            return [0]\n        \n        digits_list = []\n        temp_val = self.value\n        while temp_val > 0:\n            digits_list.append(temp_val % 10)\n            temp_val //= 10\n        \n        return digits_list[::-1]\n\n    def isDivisibleByDigits(self) -> bool:\n        \"\"\"Return True iff every digit d is non-zero and self.value % d == 0.\"\"\"\n        for digit_val in self.digits():\n            digit_obj = Digit(digit_val)\n\n            if digit_obj.isZero():\n                return False\n            \n            if self.value % digit_obj.value != 0:\n                return False\n        \n        return True\n\nclass Range:\n    \"\"\"Represents inclusive numeric bounds and validates them.\"\"\"\n    def __init__(self, startnum: int, endnum: int):\n        self.startnum = startnum\n        self.endnum = endnum\n\n    def isValid(self) -> bool:\n        \"\"\"Returns True if startnum is less than or equal to endnum.\"\"\"\n        return self.startnum <= self.endnum\n\nclass ResultList:\n    \"\"\"Accumulates Number instances and provides sorted output.\"\"\"\n    def __init__(self):\n        self.results: List[Number] = []\n\n    def add(self, n: Number) -> None:\n        \"\"\"Appends a Number object to the internal list.\"\"\"\n        self.results.append(n)\n\n    def sortAscending(self) -> None:\n        \"\"\"Sorts the stored Number objects in ascending order by their value.\"\"\"\n        self.results.sort(key=lambda num_obj: num_obj.value)\n\n    def as_int_list(self) -> List[int]:\n        \"\"\"Converts stored Number objects into a plain List[int].\"\"\"\n        return [num_obj.value for num_obj in self.results]\n\ndef divisible_by_digits(startnum: int, endnum: int) -> List[int]:\n    \"\"\"\n    Finds numbers within a given range where every number is divisible by every digit it contains.\n    Returns a sorted list of such numbers.\n    \"\"\"\n    num_range = Range(startnum, endnum)\n\n    if not num_range.isValid():\n        return []\n\n    result_list = ResultList()\n\n    for n in range(startnum, endnum + 1):\n        num_obj = Number(n)\n        if num_obj.isDivisibleByDigits():\n            result_list.add(num_obj)\n\n    result_list.sortAscending()\n    return result_list.as_int_list()"}
{"task_id": "Mbpp/749", "solution": "class InputList:\n    \"\"\"Wraps the incoming list of numeric strings.\"\"\"\n    def __init__(self, numeric_strings: list[str]) -> None:\n        self.numeric_strings = numeric_strings\n\nclass NumericString:\n    \"\"\"Value object representing a single input numeric string.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\nclass IntegerValue:\n    \"\"\"Value object representing a converted integer.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass Converter:\n    \"\"\"Converts NumericString instances to IntegerValue instances.\"\"\"\n    def toInteger(self, numeric_string: NumericString) -> IntegerValue:\n        return IntegerValue(int(numeric_string.value))\n\nclass Sorter:\n    \"\"\"Sorts lists of integer values in ascending order.\"\"\"\n    def sortAscending(self, values: list[int]) -> list[int]:\n        return sorted(values)\n\nclass OutputList:\n    \"\"\"Wraps the sorted list of integers for returning to caller.\"\"\"\n    def __init__(self, sorted_integers: list[int]) -> None:\n        self.sorted_integers = sorted_integers\n\ndef sort_numeric_strings(list_of_strings: list[str]) -> list[int]:\n    \"\"\"\n    Orchestrates conversion and sorting to return a numerically sorted list of integers.\n    It processes a list of string representations of numbers, converts them to integers,\n    sorts them in ascending order, and returns the sorted list of integers.\n    \"\"\"\n    input_wrapper = InputList(list_of_strings)\n    converter = Converter()\n    \n    integer_values = []\n    for s in input_wrapper.numeric_strings:\n        numeric_string_obj = NumericString(s)\n        integer_value_obj = converter.toInteger(numeric_string_obj)\n        integer_values.append(integer_value_obj.value)\n    \n    sorter = Sorter()\n    sorted_ints = sorter.sortAscending(integer_values)\n    \n    output_wrapper = OutputList(sorted_ints)\n    return output_wrapper.sorted_integers"}
{"task_id": "Mbpp/748", "solution": "class Character:\n    def __init__(self, value: str):\n        self.value = value\n\n    def isUpper(self) -> bool:\n        return self.value.isupper()\n\n    def isLower(self) -> bool:\n        return self.value.islower()\n\n    def isDigit(self) -> bool:\n        return self.value.isdigit()\n\nclass InsertionRule:\n    def __init__(self, description: str = \"Rule to insert space before capital\"):\n        self.description = description\n\n    def appliesTo(self, prev: Character | None, current: Character) -> bool:\n        # Returns True iff prev is not None AND (prev.isLower() OR prev.isDigit()) AND current.isUpper().\n        return prev is not None and \\\n               (prev.isLower() or prev.isDigit()) and \\\n               current.isUpper()\n\nclass InputString:\n    def __init__(self, value: str):\n        self.value = value\n        self.length = len(value)\n\nclass OutputString:\n    def __init__(self):\n        self._buffer: list[str] = []\n\n    def append(self, s: str):\n        self._buffer.append(s)\n\n    def get_value(self) -> str:\n        return \"\".join(self._buffer)\n\n    @property\n    def value(self) -> str:\n        return \"\".join(self._buffer)\n\n    @property\n    def length(self) -> int:\n        return len(self.value)\n\nclass StringProcessor:\n    def __init__(self):\n        self._rule = InsertionRule()\n\n    def capital_words_spaces(self, input: str) -> str:\n        input_string_obj = InputString(input)\n        output_string = OutputString()\n        \n        prev_char_obj: Character | None = None\n\n        for char_value in input_string_obj.value:\n            current_char_obj = Character(char_value)\n\n            if self._rule.appliesTo(prev_char_obj, current_char_obj):\n                output_string.append(' ')\n            \n            output_string.append(current_char_obj.value)\n            prev_char_obj = current_char_obj\n\n        return output_string.get_value()\n\ndef capital_words_spaces(input: str) -> str:\n    \"\"\"\n    Inserts spaces before words starting with capital letters, following specific rules.\n    This function delegates to an internal StringProcessor class for implementation.\n    \"\"\"\n    if not input:\n        return \"\"\n    \n    processor = StringProcessor()\n    return processor.capital_words_spaces(input)"}
{"task_id": "Mbpp/750", "solution": "def add_tuple(input_list, input_tuple):\n    \"\"\"Validate arguments and return a new list concatenating input_list and input_tuple.\"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError('input_list must be a list')\n    if not isinstance(input_tuple, tuple):\n        raise TypeError('input_tuple must be a tuple')\n    return input_list + list(input_tuple)"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(arr):\n    \"\"\"\n    Checks if the given array represents a min-heap using 0-based indexing.\n    Child nodes are found at 2*i + 1 (left) and 2*i + 2 (right).\n    \"\"\"\n    n = len(arr)\n    if n <= 1:\n        return True\n\n    for i in range(n // 2): # Iterates up to the last non-leaf node\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        if left_child_idx < n:\n            if not (arr[i] <= arr[left_child_idx]):\n                return False\n\n        if right_child_idx < n:\n            if not (arr[i] <= arr[right_child_idx]):\n                return False\n\n    return True"}
{"task_id": "Mbpp/752", "solution": "from typing import Any\n\nclass InputValidator:\n    def isNonNegativeInteger(self, value: Any) -> bool:\n        \"\"\"Checks if the value is a non-negative integer.\"\"\"\n        return isinstance(value, int) and value >= 0\n\nclass JacobsthalSequence:\n    \"\"\"Provides Jacobsthal sequence base values.\"\"\"\n    J0: int = 0\n    J1: int = 1\n\nclass ErrorResponse:\n    \"\"\"Data holder for error conditions.\"\"\"\n    def __init__(self, message: str, code: int):\n        self.message = message\n        self.code = code\n\nclass JacobsthalCalculator:\n    \"\"\"Computes Jacobsthal numbers using base cases and recurrence.\"\"\"\n    def __init__(self):\n        self._sequence = JacobsthalSequence()\n\n    def jacobsthal_num(self, n: int) -> int:\n        \"\"\"Internal method to compute J(n) for valid n.\"\"\"\n        if n == 0:\n            return self._sequence.J0\n        elif n == 1:\n            return self._sequence.J1\n        else: # n >= 2, assumes n is already validated as a non-negative integer\n            return self._computeRecurrence(n)\n\n    def _computeRecurrence(self, n: int) -> int:\n        \"\"\"Computes J(n) for n >= 2 iteratively.\"\"\"\n        j_prev2 = self._sequence.J0  # Represents J(i-2)\n        j_prev1 = self._sequence.J1  # Represents J(i-1)\n\n        for _ in range(2, n + 1):\n            j_current = j_prev1 + 2 * j_prev2\n            j_prev2 = j_prev1\n            j_prev1 = j_current\n        return j_prev1\n\ndef jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Finds the nth Jacobsthal number (0-indexed).\n    Raises ValueError for invalid inputs (negative or non-integer).\n    \"\"\"\n    validator = InputValidator()\n    if not validator.isNonNegativeInteger(n):\n        raise ValueError(\"Input must be a non-negative integer.\")\n\n    calculator = JacobsthalCalculator()\n    return calculator.jacobsthal_num(n)"}
{"task_id": "Mbpp/753", "solution": "class TupleRecord:\n    \"\"\"A lightweight container representing a single 2-tuple (name, value).\"\"\"\n    def __init__(self, name: str, value: float):\n        self.name = name\n        self.value = value\n\ndef _to_tuple_records(list_of_tuples: list) -> list[TupleRecord]:\n    \"\"\"Converts input tuples to internal TupleRecord list preserving values.\"\"\"\n    records = []\n    for name, value in list_of_tuples:\n        records.append(TupleRecord(name, float(value)))\n    return records\n\ndef _select_k_smallest(tuple_records: list[TupleRecord], k: int) -> list[TupleRecord]:\n    \"\"\"Selects up to k TupleRecord objects with smallest .value, sorted ascending.\"\"\"\n    if k <= 0:\n        return []\n    # Python's Timsort is stable, satisfying the stability requirement for ties.\n    sorted_records = sorted(tuple_records, key=lambda record: record.value)\n    return sorted_records[:k]\n\ndef _from_tuple_records(tuple_records: list[TupleRecord]) -> list[tuple]:\n    \"\"\"Converts selected TupleRecord objects back into 2-element tuples for output.\"\"\"\n    return [(record.name, record.value) for record in tuple_records]\n\ndef min_k(list_of_tuples: list, k: int) -> list[tuple]:\n    \"\"\"\n    Finds minimum k records from a list of (string, numeric) tuples.\n    Returns up to k tuples with the smallest numeric values, ordered ascending.\n    \"\"\"\n    records = _to_tuple_records(list_of_tuples)\n    selected_records = _select_k_smallest(records, k)\n    return _from_tuple_records(selected_records)"}
{"task_id": "Mbpp/754", "solution": "from typing import Any, List, Sequence\n\ndef extract_index_list(l1: Sequence[Any], l2: Sequence[Any], l3: Sequence[Any]) -> List[Any]:\n    \"\"\"\n    Finds elements that appear in all three lists under the same index.\n    The comparison iterates only up to the length of the shortest input list.\n    \"\"\"\n    result: List[Any] = []\n    min_len = min(len(l1), len(l2), len(l3))\n\n    for i in range(min_len):\n        if l1[i] == l2[i] == l3[i]:\n            result.append(l1[i])\n            \n    return result"}
{"task_id": "Mbpp/755", "solution": "def second_smallest(list_arg):\n    \"\"\"Return the second smallest numeric value from list_arg.\n\n    Raises TypeError for invalid types/elements or ValueError for insufficient length.\n    \"\"\"\n    if not isinstance(list_arg, (list, tuple)):\n        raise TypeError(\"Input must be a list or tuple.\")\n\n    if len(list_arg) < 2:\n        raise ValueError(\"List must contain at least two elements.\")\n\n    # Initialize first_min and second_min with appropriate values.\n    # Handle the first two elements carefully to ensure correct initialization.\n    first_min = float('inf')\n    second_min = float('inf')\n\n    # Iterate once through the list\n    for x in list_arg:\n        if not isinstance(x, (int, float)):\n            raise TypeError(\"All elements in the list must be numeric.\")\n\n        if x < first_min:\n            second_min = first_min\n            first_min = x\n        elif x < second_min:  # Use elif to correctly handle duplicates and ensure second_min is distinct from first_min (if needed, but design allows duplicates)\n            second_min = x\n    \n    return second_min"}
{"task_id": "Mbpp/757", "solution": "from typing import List, Tuple, Dict\n\nclass StringEntry:\n    \"\"\"Represents a string value and its original index.\"\"\"\n    def __init__(self, value: str, index: int) -> None:\n        self.value = value\n        self.index = index\n\nclass ReversePair:\n    \"\"\"Represents a pair of strings that are reverses of each other.\"\"\"\n    def __init__(self, a: StringEntry, b: StringEntry) -> None:\n        self.a = a\n        self.b = b\n\n    def canonical_key(self) -> Tuple[int, int]:\n        \"\"\"Returns a canonical key (min_index, max_index) for unordered deduplication.\"\"\"\n        return tuple(sorted((self.a.index, self.b.index)))\n\nclass CountResult:\n    \"\"\"Holds the integer result of counting.\"\"\"\n    def __init__(self, count: int) -> None:\n        self.count = count\n\ndef validate_input(list_of_strings: List[str]) -> None:\n    \"\"\"Validates the input list_of_strings, raising TypeError on invalid input.\"\"\"\n    if not isinstance(list_of_strings, list):\n        raise TypeError(\"Input must be a list.\")\n    for item in list_of_strings:\n        if not isinstance(item, str):\n            raise TypeError(\"All elements in the list must be strings.\")\n\ndef detect_reverse_matches(list_of_strings: List[str]) -> List[ReversePair]:\n    \"\"\"Detects all ReversePair instances for distinct indices.\"\"\"\n    str_to_indices: Dict[str, List[int]] = {}\n    for i, s in enumerate(list_of_strings):\n        if s not in str_to_indices:\n            str_to_indices[s] = []\n        str_to_indices[s].append(i)\n\n    all_raw_pairs: List[ReversePair] = []\n    for i, current_str in enumerate(list_of_strings):\n        reversed_str = current_str[::-1]\n        \n        if reversed_str in str_to_indices:\n            for j in str_to_indices[reversed_str]:\n                if i != j:  # Ensure distinct indices for a pair\n                    entry_a = StringEntry(current_str, i)\n                    entry_b = StringEntry(list_of_strings[j], j)\n                    all_raw_pairs.append(ReversePair(entry_a, entry_b))\n    return all_raw_pairs\n\ndef count_unique_unordered_pairs(pairs: List[ReversePair]) -> CountResult:\n    \"\"\"Canonicalizes index pairs and counts unique unordered pairs.\"\"\"\n    unique_canonical_keys = set()\n    for pair in pairs:\n        unique_canonical_keys.add(pair.canonical_key())\n    return CountResult(len(unique_canonical_keys))\n\ndef count_reverse_pairs(list_of_strings: List[str]) -> int:\n    \"\"\"Counts the pairs of reverse strings in the given string list.\"\"\"\n    validate_input(list_of_strings)\n    \n    detected_pairs = detect_reverse_matches(list_of_strings)\n    \n    final_count_result = count_unique_unordered_pairs(detected_pairs)\n    \n    return final_count_result.count"}
{"task_id": "Mbpp/760", "solution": "def unique_Element(numbers):\n    \"\"\"\n    Checks if a list of numbers contains only one distinct element.\n    Returns True if only one distinct element is found, False otherwise.\n    \"\"\"\n    return len(set(numbers)) == 1"}
{"task_id": "Mbpp/759", "solution": "import re\n\nclass DecimalValidator:\n    \"\"\"Validates if a string is a decimal number with two fractional digits.\"\"\"\n    pattern: str = r\"^\\d+\\.\\d{2}$\" # Using raw string for the regex pattern\n\n    def is_decimal(self, input_string) -> bool:\n        \"\"\"\n        Checks if the input string matches the decimal number pattern.\n        Returns False for non-string inputs, as specified by the design.\n        \"\"\"\n        if not isinstance(input_string, str):\n            return False\n        # re.match checks from the beginning of the string.\n        # Adding \\\\Z ensures the match covers the entire string (full-string match).\n        return bool(re.match(self.pattern + r\"\\Z\", input_string))\n\ndef is_decimal(input_string) -> bool:\n    \"\"\"\n    Checks whether a given string is a decimal number with a precision of 2.\n    Returns True for valid decimal strings, False otherwise.\n    \"\"\"\n    return DecimalValidator().is_decimal(input_string)"}
{"task_id": "Mbpp/758", "solution": "class FrequencyMap:\n    \"\"\"\n    Maintains a dictionary mapping tuples to their occurrence counts.\n    \"\"\"\n    def __init__(self):\n        self.map = {}\n\n    def increment(self, tuple_key_obj):\n        \"\"\"\n        Increments the count for the given tuple key object's elements.\n        \"\"\"\n        native_tuple = tuple_key_obj.elements\n        self.map[native_tuple] = self.map.get(native_tuple, 0) + 1\n\n    def get_all(self):\n        \"\"\"\n        Returns a shallow copy of the internal frequency map.\n        \"\"\"\n        return self.map.copy()\n\n\nclass TupleKey:\n    \"\"\"\n    A value-object wrapper holding the tuple form of a sublist.\n    \"\"\"\n    def __init__(self, elements_tuple):\n        self.elements = elements_tuple\n\n\nclass Sublist:\n    \"\"\"\n    Encapsulates an ordered collection and provides conversion to a tuple.\n    \"\"\"\n    def __init__(self, elements):\n        # Create a copy to ensure immutability of the original sublist elements.\n        self.elements = list(elements)\n\n    def to_tuple(self):\n        \"\"\"\n        Converts the sublist's elements to an immutable tuple.\n        \"\"\"\n        return tuple(self.elements)\n\n\nclass InputList:\n    \"\"\"\n    Lightweight wrapper for the caller-provided list-like collection.\n    \"\"\"\n    def __init__(self, raw_list):\n        self.sublists = raw_list\n\n    def __iter__(self):\n        \"\"\"\n        Allows iteration over the wrapped sublists.\n        \"\"\"\n        return iter(self.sublists)\n\n\nclass UniqueSublistsFunction:\n    \"\"\"\n    Coordinates the conversion of sublists to tuple keys and counting occurrences.\n    \"\"\"\n    @staticmethod\n    def unique_sublists(input_list_obj):\n        \"\"\"\n        Processes an InputList to count unique sublists as tuples.\n        \"\"\"\n        frequency_map = FrequencyMap()\n\n        if not input_list_obj.sublists:\n            return frequency_map.get_all()\n\n        for raw_sublist in input_list_obj:\n            sublist_obj = Sublist(raw_sublist)\n            native_tuple = sublist_obj.to_tuple()\n            tuple_key_obj = TupleKey(native_tuple)\n            frequency_map.increment(tuple_key_obj)\n\n        return frequency_map.get_all()\n\n\ndef unique_sublists(input_list):\n    \"\"\"\n    Counts lists within a list, converting each to a tuple, and returns\n    a dictionary of tuple-counts.\n    \"\"\"\n    input_list_obj = InputList(input_list)\n    return UniqueSublistsFunction.unique_sublists(input_list_obj)"}
