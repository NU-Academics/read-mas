{"task_id": "Mbpp/803", "solution": "import math\n\ndef is_perfect_square(n: int) -> bool:\n    \"\"\"\n    Checks if the given number is a perfect square.\n    Returns True if n is a perfect square, False otherwise.\n    \"\"\"\n    if n < 0:\n        return False\n    root = math.isqrt(n)\n    return root * root == n"}
{"task_id": "Mbpp/804", "solution": "from typing import List\n\nclass IntegerElement:\n    \"\"\"Represents an integer element.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass IntegerList:\n    \"\"\"A list of IntegerElement objects.\"\"\"\n    def __init__(self, elements: List[IntegerElement]) -> None:\n        self.elements = elements\n\n    @staticmethod\n    def from_primitives(values: List[int]) -> 'IntegerList':\n        \"\"\"Constructs an IntegerList from a list of primitive integers.\"\"\"\n        elements = [IntegerElement(value) for value in values]\n        return IntegerList(elements)\n\nclass IsProductEvenFunction:\n    \"\"\"Service to determine if a product of integers is even.\"\"\"\n    def is_product_even(self, integer_list: IntegerList) -> bool:\n        \"\"\"Return True if any IntegerElement.value is even; else False.\"\"\"\n        for element in integer_list.elements:\n            if element.value % 2 == 0:\n                return True\n        return False\n\ndef is_product_even(list_of_integers: List[int]) -> bool:\n    \"\"\"Checks whether the product of numbers in a list is even.\"\"\"\n    integer_list = IntegerList.from_primitives(list_of_integers)\n    service = IsProductEvenFunction()\n    return service.is_product_even(integer_list)"}
{"task_id": "Mbpp/805", "solution": "def max_sum_list(input_list):\n    \"\"\"\n    Returns the sublist in a list of lists whose sum of elements is the highest.\n    If multiple sublists share the highest sum, the first occurrence is returned.\n    \"\"\"\n    if not input_list:\n        return None # Returning None for empty input_list, as per constraints.\n\n    max_sum_value = sum(input_list[0])\n    max_sum_sublist = input_list[0]\n\n    for sublist in input_list[1:]:\n        current_sum = sum(sublist)\n        if current_sum > max_sum_value:\n            max_sum_value = current_sum\n            max_sum_sublist = sublist\n\n    return max_sum_sublist"}
{"task_id": "Mbpp/807", "solution": "from collections.abc import Iterable\nfrom numbers import Number\n\ndef validate_input(numbers):\n    \"\"\"\n    Validates that the input is an iterable of numeric values.\n    Raises TypeError if validation fails.\n    \"\"\"\n    if not isinstance(numbers, Iterable):\n        raise TypeError(\"Input must be an iterable.\")\n    if isinstance(numbers, (str, bytes)):\n        raise TypeError(\"Input cannot be a string or bytes.\")\n\n    # Using enumerate to provide context for error messages if needed.\n    for i, num in enumerate(numbers):\n        if not isinstance(num, Number):\n            raise TypeError(f\"Element at index {i} is not a numeric value.\")\n        if isinstance(num, complex):\n            # Complex numbers do not support the modulo operator '%' needed for oddness check.\n            raise TypeError(f\"Element at index {i} is a complex number, which does not support odd/even semantics.\")\n\ndef find_first_odd(numbers):\n    \"\"\"\n    Finds the first odd number in an iterable of numbers.\n    Raises ValueError if no odd number is found.\n    \"\"\"\n    for number in numbers:\n        # Oddness is determined by value % 2 != 0.\n        if number % 2 != 0:\n            return number\n    raise ValueError(\"no odd number found\")\n\ndef first_odd(numbers):\n    \"\"\"\n    Finds the first odd number in a given list of numbers.\n    Validates input and raises exceptions for invalid data or no odd numbers.\n    \"\"\"\n    validate_input(numbers)\n    return find_first_odd(numbers)"}
{"task_id": "Mbpp/806", "solution": "class InputString:\n    \"\"\"Encapsulates the input string and provides iteration and emptiness check.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def isEmpty(self) -> bool:\n        \"\"\"Checks if the encapsulated string is empty.\"\"\"\n        return len(self.value) == 0\n\n    def chars(self) -> list:\n        \"\"\"Returns a list of single-character strings from the input.\"\"\"\n        return list(self.value)\n\nclass Character:\n    \"\"\"Represents a single character and determines if it is an ASCII uppercase letter.\"\"\"\n    def __init__(self, c: str) -> None:\n        self.c = c\n\n    def isUpperAscii(self) -> bool:\n        \"\"\"Checks if the character is an ASCII uppercase letter (A-Z).\"\"\"\n        return 'A' <= self.c <= 'Z'\n\nclass UppercaseRun:\n    \"\"\"Tracks current and maximum contiguous uppercase run lengths.\"\"\"\n    def __init__(self) -> None:\n        self.currentLength = 0\n        self.maxLength = 0\n\n    def reset(self) -> None:\n        \"\"\"Resets the current run length.\"\"\"\n        self.currentLength = 0\n\n    def increment(self) -> None:\n        \"\"\"Increments the current run length and updates the maximum length.\"\"\"\n        self.currentLength += 1\n        if self.currentLength > self.maxLength:\n            self.maxLength = self.currentLength\n\n    def update(self, char: Character) -> None:\n        \"\"\"Updates the run tracking based on the character's uppercase status.\"\"\"\n        if char.isUpperAscii():\n            self.increment()\n        else:\n            self.reset()\n\nclass Result:\n    \"\"\"Value object that holds the final integer result.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\ndef max_run_uppercase(s: str) -> int:\n    \"\"\"\n    Scans the input string to find the maximum run of uppercase characters.\n    Returns 0 if the string is empty or contains no uppercase ASCII letters.\n    \"\"\"\n    input_str_obj = InputString(s)\n\n    if input_str_obj.isEmpty():\n        return Result(0).value\n\n    run_tracker = UppercaseRun()\n\n    for char_str in input_str_obj.chars():\n        char_obj = Character(char_str)\n        run_tracker.update(char_obj)\n\n    return Result(run_tracker.maxLength).value"}
