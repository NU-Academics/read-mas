{"task_id": "Mbpp/630", "solution": "from typing import List, Tuple\n\ndef get_coordinates(coord_tuple: Tuple[int, int]) -> List[List[int]]:\n    \"\"\"\n    Extracts all 3x3 adjacent coordinates, including diagonals and the center,\n    from the given coordinate tuple in row-major order.\n    \"\"\"\n    input_x, input_y = coord_tuple\n    adjacent_coords = []\n\n    for x_offset in range(-1, 2):  # -1, 0, 1\n        for y_offset in range(-1, 2):  # -1, 0, 1\n            adjacent_coords.append([input_x + x_offset, input_y + y_offset])\n\n    return adjacent_coords"}
{"task_id": "Mbpp/622", "solution": "class MedianResult:\n    \"\"\"Holds the numeric median value.\"\"\"\n    def __init__(self, value: float):\n        self.value = value\n\nclass InputValidator:\n    \"\"\"Provides static methods for validating input lists and 'n'.\"\"\"\n\n    @staticmethod\n    def _is_non_decreasing(lst: list) -> bool:\n        \"\"\"Checks if a list is sorted in non-decreasing order.\"\"\"\n        for i in range(len(lst) - 1):\n            if lst[i] > lst[i+1]:\n                return False\n        return True\n\n    @staticmethod\n    def validate_n(n: int):\n        \"\"\"Validates that n is an integer and n >= 1.\"\"\"\n        if not isinstance(n, int) or n < 1:\n            raise ValueError(\"n must be an integer >= 1.\")\n\n    @staticmethod\n    def validate_lengths(list1: list, list2: list, n: int):\n        \"\"\"Validates that both lists have length n.\"\"\"\n        if len(list1) != n or len(list2) != n:\n            raise ValueError(f\"Both lists must have length {n}.\")\n\n    @staticmethod\n    def validate_sorted(lst: list):\n        \"\"\"Validates that a list is sorted in non-decreasing order.\"\"\"\n        if not InputValidator._is_non_decreasing(lst):\n            raise ValueError(\"List must be sorted in non-decreasing order.\")\n\nclass MedianCalculator:\n    \"\"\"Calculates the median of two sorted lists.\"\"\"\n\n    @staticmethod\n    def merge_find_median(list1: list, list2: list, n: int) -> MedianResult:\n        \"\"\"Finds the median of two sorted lists of same size n by merging.\"\"\"\n        i = 0  # pointer for list1\n        j = 0  # pointer for list2\n        m1 = -1  # stores the (n-1)-th smallest element\n        m2 = -1  # stores the n-th smallest element\n\n        # Iterate n+1 times to find the n-th and (n+1)-th elements (0-indexed: elements at index n-1 and n)\n        for count in range(n + 1):\n            if i == n: # list1 exhausted\n                m1 = m2\n                m2 = list2[j]\n                j += 1\n            elif j == n: # list2 exhausted\n                m1 = m2\n                m2 = list1[i]\n                i += 1\n            elif list1[i] < list2[j]:\n                m1 = m2\n                m2 = list1[i]\n                i += 1\n            else: # list2[j] <= list1[i]\n                m1 = m2\n                m2 = list2[j]\n                j += 1\n        \n        return MedianResult((m1 + m2) / 2.0)\n\ndef get_median(list1: list, list2: list, n: int) -> float:\n    \"\"\"Finds the median of two sorted lists of same size n.\n    Performs validation and delegates to a median calculator.\n    \"\"\"\n    InputValidator.validate_n(n)\n    InputValidator.validate_lengths(list1, list2, n)\n    InputValidator.validate_sorted(list1)\n    InputValidator.validate_sorted(list2)\n\n    result = MedianCalculator.merge_find_median(list1, list2, n)\n    return result.value"}
{"task_id": "Mbpp/631", "solution": "from dataclasses import dataclass\nfrom typing import Optional, List\n\n@dataclass\nclass InputString:\n    value: str\n\n@dataclass\nclass OutputString:\n    value: str\n\n@dataclass\nclass CharacterMapping:\n    from_char: str\n    to_char: str\n\nclass ReplaceSpacesFunction:\n    \"\"\"Encapsulates the transformation logic for replacing spaces and underscores.\"\"\"\n    _placeholder: str = '\\x01' # A very unlikely character for atomic toggle swap.\n\n    def __init__(self, mode: str):\n        self.mode = mode\n        self._mappings: List[CharacterMapping] = [] # Property exists as per design.\n        if mode == 'space_to_underscore':\n            self._mappings.append(CharacterMapping(' ', '_'))\n        elif mode == 'underscore_to_space':\n            self._mappings.append(CharacterMapping('_', ' '))\n\n    def replace(self, input_str_value: str) -> str:\n        \"\"\"Applies the character replacement based on the initialized mode.\"\"\"\n        if self.mode == 'space_to_underscore':\n            return input_str_value.replace(' ', '_')\n        elif self.mode == 'underscore_to_space':\n            return input_str_value.replace('_', ' ')\n        elif self.mode == 'toggle':\n            # Perform atomic swap using a placeholder.\n            temp_string = input_str_value.replace(' ', self._placeholder)\n            temp_string = temp_string.replace('_', ' ')\n            return temp_string.replace(self._placeholder, '_')\n        else:\n            raise ValueError(f\"Unknown mode during replacement: {self.mode}\")\n\ndef replace_spaces(input_string: str, mode: Optional[str] = None) -> str:\n    \"\"\"\n    Replaces whitespaces with underscores and vice versa in a given string.\n    The behavior is determined by the optional 'mode' parameter or inferred from the input.\n    \"\"\"\n    if not isinstance(input_string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    has_spaces = ' ' in input_string\n    has_underscores = '_' in input_string\n\n    resolved_mode = mode\n    if resolved_mode is None:\n        if has_spaces and not has_underscores:\n            resolved_mode = 'space_to_underscore'\n        elif has_underscores and not has_spaces:\n            resolved_mode = 'underscore_to_space'\n        elif has_spaces and has_underscores:\n            raise ValueError(\"Input string contains both spaces and underscores. Explicit 'mode' is required.\")\n        else:\n            resolved_mode = 'space_to_underscore' # Default for empty or neither-present strings.\n    elif resolved_mode not in ['space_to_underscore', 'underscore_to_space', 'toggle']:\n        raise ValueError(f\"Invalid mode '{resolved_mode}'. Allowed modes are 'space_to_underscore', 'underscore_to_space', 'toggle'.\")\n\n    # Instantiate InputString object for traceability as per design context.\n    _ = InputString(input_string)\n\n    transformer = ReplaceSpacesFunction(resolved_mode)\n    result_str = transformer.replace(input_string)\n\n    # Instantiate OutputString object for traceability as per design context.\n    _ = OutputString(result_str)\n\n    return result_str"}
