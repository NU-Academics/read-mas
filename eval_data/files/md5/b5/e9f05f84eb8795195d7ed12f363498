{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(a, b):\n    \"\"\"\n    Checks if two integers differ at exactly one bit position.\n    This is determined by computing their XOR and counting the set bits in the result.\n    \"\"\"\n    def _xor(a, b):\n        \"\"\"Computes the bitwise XOR of two integers.\"\"\"\n        return a ^ b\n\n    def _count_set_bits(value):\n        \"\"\"Counts the number of set (1) bits in an integer.\"\"\"\n        count = 0\n        # Brian Kernighan's algorithm to count set bits\n        while value > 0:\n            value &= (value - 1)\n            count += 1\n        return count\n\n    xor_result = _xor(a, b)\n    set_bit_count = _count_set_bits(xor_result)\n    return set_bit_count == 1"}
{"task_id": "Mbpp/4", "solution": "from typing import List\nimport heapq\n\ndef heap_queue_largest(list: List[int], n: int) -> List[int]:\n    \"\"\"Returns the n largest integers from a list in descending order.\"\"\"\n    if n <= 0:\n        return []\n\n    if n >= len(list):\n        return sorted(list, reverse=True)\n\n    return heapq.nlargest(n, list)"}
{"task_id": "Mbpp/11", "solution": "```python\ndef remove_Occ(source: str, char: str) -> str:\n    \"\"\"Removes the first and last occurrence of a given character from the string.\"\"\"\n    if len(char) != 1:\n        raise ValueError(\"char parameter must be a single-character string\")\n\n    first_idx = source.find(char)\n    if first_idx == -1:\n        return source\n\n    last_idx = source.rfind(char)\n\n    if first_idx == last_idx:  # Character appears only once\n        return source[:first_idx] + source[first_idx+1:]\n    else:  # Character appears two or more times\n        # Remove first occurrence\n        temp_str = source[:first_idx] + source[first_idx+1:]\n        # Calculate new last_idx in temp_str (accounting for the removed character)\n        # If the original last_idx was after first_idx, it shifts left by 1\n        new_last_idx = temp_str.rfind(char)\n        \n        return temp_str[:new_last_idx] + temp_str[new_last_idx+1:]\n```"}
{"task_id": "Mbpp/7", "solution": "class Tokenizer:\n    \"\"\"Handles splitting the input string into tokens.\"\"\"\n    def split(self, input_string):\n        return input_string.split()\n\nclass WordFilter:\n    \"\"\"Filters a list of words based on a minimum length.\"\"\"\n    def filterByMinLength(self, words, minLen):\n        return [word for word in words if len(word) >= minLen]\n\nclass InputString:\n    \"\"\"A lightweight wrapper for the raw input string.\"\"\"\n    def __init__(self, text):\n        self.text = text\n\nclass ResultList:\n    \"\"\"A container for the list of matched words.\"\"\"\n    def __init__(self, words):\n        self.words = words\n\nclass FindCharLong:\n    \"\"\"Orchestrates tokenization and filtering to find words of a minimum length.\"\"\"\n    def __init__(self, min_length=4):\n        self.min_length = min_length\n        self.tokenizer = Tokenizer()\n        self.filter = WordFilter()\n\n    def execute(self, input_text):\n        input_obj = InputString(input_text)\n        tokens = self.tokenizer.split(input_obj.text)\n        matched = self.filter.filterByMinLength(tokens, self.min_length)\n        return matched\n\ndef find_char_long(input_string):\n    \"\"\"\n    Finds all words which are at least 4 characters long in a string.\n    \"\"\"\n    orchestrator = FindCharLong(min_length=4)\n    return orchestrator.execute(input_string)"}
{"task_id": "Mbpp/3", "solution": "import math\n\nclass PrimeChecker:\n    def _is_prime(self, n: int) -> bool:\n        \"\"\"Internal helper to determine if a number is prime.\"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        # Check for odd divisors from 3 up to the square root of n.\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\n\n    def is_not_prime(self, n: int) -> bool:\n        \"\"\"Returns True if n is not prime, False if n is prime.\"\"\"\n        return not self._is_prime(n)\n\nclass Number:\n    \"\"\"Immutable value object wrapping an integer.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def is_prime(self) -> bool:\n        \"\"\"Returns True if the number is prime.\"\"\"\n        return PrimeChecker()._is_prime(self.value)\n\ndef is_not_prime(n: int) -> bool:\n    \"\"\"\n    Identifies non-prime numbers.\n    Returns True for non-prime integers (including composite numbers and integers less than 2), False for prime integers.\n    \"\"\"\n    return PrimeChecker().is_not_prime(n)"}
{"task_id": "Mbpp/2", "solution": "from collections.abc import Sequence\n\ndef similar_elements(seq1, seq2):\n    \"\"\"\n    Return a list containing the unique elements that appear in both seq1 and seq2.\n\n    Preconditions:\n      - seq1 and seq2 must be sequence-like (collections.abc.Sequence); else raise TypeError.\n\n    Behavior:\n      - Use equality (==) to determine shared elements.\n      - Ensure each shared element appears only once in the returned list.\n      - Order of elements in returned list is not significant.\n    \"\"\"\n    if not isinstance(seq1, Sequence):\n        raise TypeError(\"seq1 must be a sequence-like object.\")\n    if not isinstance(seq2, Sequence):\n        raise TypeError(\"seq2 must be a sequence-like object.\")\n\n    try:\n        # Attempt efficient path using sets for hashable elements\n        set1 = set(seq1)\n        set2 = set(seq2)\n        intersection = set1 & set2\n        return list(intersection)\n    except TypeError:\n        # Fallback path for unhashable elements\n        result = []\n        for item1 in seq1:\n            # Check if item1 exists in seq2\n            found_in_seq2 = False\n            for item2 in seq2:\n                if item1 == item2:\n                    found_in_seq2 = True\n                    break\n            \n            # If found in seq2, add to result if not already present\n            if found_in_seq2:\n                # Check for uniqueness in result list using equality\n                is_already_present = False\n                for existing_item in result:\n                    if existing_item == item1:\n                        is_already_present = True\n                        break\n                if not is_already_present:\n                    result.append(item1)\n        return result"}
