{"task_id": "Mbpp/170", "solution": "from typing import List, Union\n\nNumber = Union[int, float]\n\nclass NumberList:\n    \"\"\"Holds a list of numbers and provides its length.\"\"\"\n    def __init__(self, items: List[Number]):\n        self.items = items\n\n    def length(self) -> int:\n        \"\"\"Returns the number of items in the list.\"\"\"\n        return len(self.items)\n\nclass Index:\n    \"\"\"Represents an index value, with an option for 0-based semantics.\"\"\"\n    def __init__(self, value: int, is_zero_based: bool = True):\n        self.value = value\n        self.is_zero_based = is_zero_based\n\nclass Result:\n    \"\"\"A simple value holder for an integer result.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass SumRangeFunction:\n    \"\"\"Encapsulates the logic for validating indices and computing the sum within a range.\"\"\"\n    def __init__(self, numbers: List[Number], start_index: int, end_index: int):\n        self.number_list = NumberList(numbers)\n        self.start_index = Index(start_index)\n        self.end_index = Index(end_index)\n\n    def validate_indices(self) -> bool:\n        \"\"\"Validates that indices are within bounds and ordered correctly.\"\"\"\n        list_length = self.number_list.length()\n        return (0 <= self.start_index.value and\n                self.start_index.value <= self.end_index.value and\n                self.end_index.value < list_length)\n\n    def execute(self) -> int:\n        \"\"\"Computes the sum of numbers within the specified inclusive range.\"\"\"\n        # Assumes validate_indices has been called and returned True\n        sum_value = sum(self.number_list.items[self.start_index.value : self.end_index.value + 1])\n        return Result(sum_value).value\n\ndef sum_range_list(numbers: List[Number], start_index: int, end_index: int) -> int:\n    \"\"\"\n    Calculates the sum of numbers in a list within a specified 0-based index range (inclusive).\n    Raises ValueError if indices are out of bounds or start_index is greater than end_index.\n    \"\"\"\n    sum_range_func = SumRangeFunction(numbers, start_index, end_index)\n    if not sum_range_func.validate_indices():\n        raise ValueError(\"Invalid indices: start_index or end_index are out of bounds or start_index > end_index.\")\n    return sum_range_func.execute()"}
