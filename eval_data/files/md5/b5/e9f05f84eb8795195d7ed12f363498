{"task_id": "Mbpp/18", "solution": "def remove_dirty_chars(source: str, remove_chars: str) -> str:\n    \"\"\"Removes characters from the first string that are present in the second string.\n    The relative order of the remaining characters is preserved.\"\"\"\n    if not remove_chars:\n        return source\n\n    chars_to_remove = set(remove_chars)\n    \n    result_chars = []\n    for char in source:\n        if char not in chars_to_remove:\n            result_chars.append(char)\n            \n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/56", "solution": "class ReverseOperation:\n    \"\"\"\n    Component for computing the decimal-digit reversal of an integer value.\n    Ignores leading zeros in the reversed digit sequence.\n    \"\"\"\n    def computeReverse(self, value: int) -> int:\n        \"\"\"\n        Compute decimal-digit reverse of abs(value) and return as int (leading zeros ignored).\n        Returns a non-negative integer.\n        \"\"\"\n        return int(str(abs(value))[::-1])\n\ndef check(n: int) -> bool:\n    \"\"\"\n    Return True iff n is one less than twice its reverse.\n    Raises TypeError for non-int inputs.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n\n    rev_op = ReverseOperation()\n    reversed_n = rev_op.computeReverse(n)\n\n    return n == (2 * reversed_n - 1)"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(n) -> bool:\n    \"\"\"Checks if the given number is a Woodall number (n = k * 2^k - 1 for k >= 1).\n    Woodall numbers are positive, so n less than 1 cannot be a Woodall number.\n    \"\"\"\n    if n < 1:\n        return False\n\n    k = 1\n    while True:\n        woodall_candidate = k * (2 ** k) - 1\n        if woodall_candidate == n:\n            return True\n        elif woodall_candidate > n:\n            return False\n        k += 1"}
{"task_id": "Mbpp/59", "solution": "class OctagonalNumber:\n    \"\"\"Domain class encapsulating an octagonal number and its computation.\"\"\"\n    def __init__(self, n: int):\n        \"\"\"Initialize with integer n.\"\"\"\n        self.n = n\n        self.value = None\n\n    def compute(self) -> int:\n        \"\"\"Compute the octagonal number O_n = n * (3*n - 2).\"\"\"\n        self.value = self.n * (3 * self.n - 2)\n        return self.value\n\ndef is_octagonal(n: int) -> int:\n    \"\"\"\n    Validate input n and return the nth octagonal number.\n    Raises ValueError if n is not a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"n must be a positive integer (n >= 1)\")\n\n    octagonal_num = OctagonalNumber(n)\n    return octagonal_num.compute()"}
{"task_id": "Mbpp/62", "solution": "def smallest_num(input_list):\n    \"\"\"Accept exactly one parameter (a list of numbers) and return the smallest numeric value.\n\n    Args:\n        input_list: list of int and/or float numbers\n\n    Returns:\n        int or float: the smallest numeric value contained in input_list\n\n    Notes:\n        Behavior for empty lists or non-numeric elements is unspecified in SRS; this implementation will raise built-in Python exceptions in those cases (e.g., ValueError or TypeError) per natural Python semantics.\n    \"\"\"\n    return min(input_list)"}
{"task_id": "Mbpp/57", "solution": "class Validator:\n    def validate(self, digits: list) -> bool:\n        \"\"\"\n        Validates if the input is a list of integers, with each digit in the range 0-9.\n        Returns True if valid, False otherwise.\n        \"\"\"\n        if not isinstance(digits, list):\n            return False\n        for digit in digits:\n            if not isinstance(digit, int) or not (0 <= digit <= 9):\n                return False\n        return True\n\nclass Sorter:\n    def sort_desc(self, digits: list) -> list:\n        \"\"\"\n        Sorts a list of digits in descending order.\n        Duplicates are preserved.\n        \"\"\"\n        return sorted(digits, reverse=True)\n\nclass Formatter:\n    def to_integer(self, sorted_digits: list) -> int:\n        \"\"\"\n        Composes an integer from a list of sorted digits.\n        Returns 0 if the list is empty.\n        \"\"\"\n        if not sorted_digits:\n            return 0\n        return int(\"\".join(str(d) for d in sorted_digits))\n\ndef find_Max_Num(digits: list) -> int:\n    \"\"\"\n    Finds the largest number that can be formed with the given list of digits.\n    Orchestrates validation, sorting, and formatting of digits.\n    \"\"\"\n    validator = Validator()\n    if not validator.validate(digits):\n        raise ValueError(\"Invalid digit list\")\n\n    sorter = Sorter()\n    sorted_digits = sorter.sort_desc(digits)\n\n    formatter = Formatter()\n    return formatter.to_integer(sorted_digits)"}
{"task_id": "Mbpp/61", "solution": "def count_Substrings(input_string):\n    \"\"\"\n    Counts the number of substrings with the sum of digits equal to their length.\n    It leverages a prefix-sum technique by transforming digits and counting zero-sum subarrays.\n    \"\"\"\n    def _count_zero_sum_subarrays(int_list):\n        \"\"\"\n        Internal helper to count contiguous subarrays within int_list that sum to zero.\n        Uses a hash map (dictionary) to store prefix sum frequencies.\n        \"\"\"\n        count = 0\n        current_sum = 0\n        sum_frequencies = {0: 1} # Initialize with sum 0 having frequency 1 for subarrays starting at index 0\n\n        for num in int_list:\n            current_sum += num\n            if current_sum in sum_frequencies:\n                count += sum_frequencies[current_sum]\n            sum_frequencies[current_sum] = sum_frequencies.get(current_sum, 0) + 1\n        return count\n\n    # Transform the input string into a list of integers, mapping each digit d to (d - 1)\n    # This transforms the condition sum(digits) == length into sum(d - 1) == 0.\n    transformed_list = [int(char) - 1 for char in input_string]\n\n    # Use the helper function to count zero-sum subarrays in the transformed list\n    return _count_zero_sum_subarrays(transformed_list)"}
