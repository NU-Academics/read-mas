{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(arr, n, i, k):\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence that includes arr[k]\n    and any preceding elements from the prefix arr[0...i].\n    \"\"\"\n    # Input Validation checks (mimicking Validator.validate)\n    if n != len(arr):\n        raise ValueError(\"n must be equal to the length of arr.\")\n    if not (0 <= i < n):\n        raise ValueError(\"Index i must be within array bounds [0, n-1].\")\n    if not (0 <= k < n):\n        raise ValueError(\"Index k must be within array bounds [0, n-1].\")\n    if k <= i:\n        raise ValueError(\"Index k must be strictly greater than index i.\")\n\n    # Core computation (mimicking SubsequenceCalculator.computeMaxSum)\n    # dp[j] stores the maximum sum of an increasing subsequence ending at index j\n    # within the prefix arr[0...i].\n    dp = [0] * (i + 1)\n\n    # Calculate dp values for each element in the prefix arr[0...i]\n    for current_idx in range(i + 1):\n        dp[current_idx] = arr[current_idx]  # Base case: subsequence ending at current_idx is just arr[current_idx]\n        for prev_idx in range(current_idx):\n            # If arr[current_idx] can extend an increasing subsequence ending at arr[prev_idx]\n            if arr[prev_idx] < arr[current_idx]:\n                dp[current_idx] = max(dp[current_idx], dp[prev_idx] + arr[current_idx])\n\n    # Initialize max_final_sum with arr[k] itself (the single-element subsequence)\n    max_final_sum = arr[k]\n\n    # Iterate through the calculated dp values for the prefix arr[0...i]\n    # and combine them with arr[k] if they form a valid increasing subsequence.\n    for prefix_idx in range(i + 1):\n        # A prefix subsequence ending at prefix_idx can precede arr[k] only if\n        # its last element (arr[prefix_idx]) is strictly less than arr[k].\n        if arr[prefix_idx] < arr[k]:\n            max_final_sum = max(max_final_sum, dp[prefix_idx] + arr[k])\n\n    return max_final_sum"}
{"task_id": "Mbpp/308", "solution": "# Module that implements large_product(list1, list2, k) per SRS FR1..FR5\n\nclass Product:\n    \"\"\"Immutable value object representing a product and its origin indices.\"\"\"\n    def __init__(self, value, index1, index2):\n        self.value = value\n        self.index1 = index1\n        self.index2 = index2\n\n    def __lt__(self, other):\n        \"\"\"Allows Product instances to be compared for sorting by value.\"\"\"\n        return self.value < other.value\n\nclass ResultSet:\n    \"\"\"Stores Product instances, sorts descending, returns top k numeric values.\"\"\"\n    def __init__(self):\n        self.products = []\n\n    def add(self, product):\n        \"\"\"Adds a Product instance to the collection.\"\"\"\n        self.products.append(product)\n\n    def sortDescending(self):\n        \"\"\"Sorts the stored products by their value in descending order.\"\"\"\n        self.products.sort(key=lambda p: p.value, reverse=True)\n\n    def top(self, k) -> list:\n        \"\"\"Returns the numeric values of the top k products.\"\"\"\n        actual_k = min(k, len(self.products))\n        return [p.value for p in self.products[:actual_k]]\n\nclass LargeProductFunction:\n    \"\"\"Orchestrates computation: computes Product instances, collects into ResultSet, sorts and selects top k.\"\"\"\n    def __init__(self, list1, list2, k):\n        self.list1 = list1\n        self.list2 = list2\n        self.k = k\n        self.result = None\n\n    def execute(self) -> list:\n        \"\"\"Computes all pairwise products, sorts, and returns the top k values.\"\"\"\n        result_set = ResultSet()\n\n        for i, val1 in enumerate(self.list1):\n            for j, val2 in enumerate(self.list2):\n                product_value = val1 * val2\n                product = Product(product_value, i, j)\n                result_set.add(product)\n\n        result_set.sortDescending()\n        self.result = result_set.top(self.k)\n        return self.result\n\ndef large_product(list1, list2, k):\n    \"\"\"\n    Finds the specified number of largest products from two given lists,\n    selecting one factor from each list.\n    \"\"\"\n    function_instance = LargeProductFunction(list1, list2, k)\n    return function_instance.execute()"}
{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(value: int) -> int:\n    \"\"\"\n    Sets the left-most unset bit (0) in a non-negative integer to 1.\n    If all significant bits are already set, a new most-significant bit is prepended.\n    \"\"\"\n    if value == 0:\n        return 1\n\n    n = value.bit_length()\n    # Scan from MSB down to LSB (from n-1 to 0)\n    for i in reversed(range(n)):\n        # If the i-th bit is 0, set it\n        if not (value & (1 << i)):\n            return value | (1 << i)\n\n    # If the loop completes, all significant bits are 1.\n    # Prepend a new most significant bit.\n    return value | (1 << n)"}
{"task_id": "Mbpp/389", "solution": "class InputValidator:\n    def is_non_negative_integer(self, n) -> bool:\n        \"\"\"\n        Checks if n is a non-negative integer.\n        Returns True if n is an int and n >= 0, otherwise False.\n        \"\"\"\n        return isinstance(n, int) and n >= 0\n\nclass LucasSequence:\n    \"\"\"\n    Encapsulates Lucas sequence computation using base cases and recurrence.\n    Uses an iterative approach to compute the nth Lucas number.\n    \"\"\"\n    _L0: int = 2\n    _L1: int = 1\n\n    def compute(self, n: int) -> int:\n        if n == 0:\n            return self._L0\n        elif n == 1:\n            return self._L1\n        else:\n            a, b = self._L0, self._L1 # L(0), L(1)\n            for _ in range(2, n + 1):\n                a, b = b, a + b\n            return b\n\ndef find_lucas(n: int) -> int:\n    \"\"\"\n    Finds the n'th Lucas number.\n    Raises ValueError if n is not a non-negative integer.\n    \"\"\"\n    validator = InputValidator()\n    if not validator.is_non_negative_integer(n):\n        raise ValueError(\"n must be a non-negative integer\")\n    \n    engine = LucasSequence()\n    return engine.compute(n)"}
