{"task_id": "Mbpp/88", "solution": "from typing import Any, List, Dict\n\nclass Element:\n    \"\"\"Wrapper for an element value, providing hashability check.\"\"\"\n    def __init__(self, value: Any):\n        self.value = value\n\n    def hashable(self) -> bool:\n        \"\"\"Checks if the wrapped value is hashable.\"\"\"\n        try:\n            hash(self.value)\n            return True\n        except TypeError:\n            return False\n\nclass InputList:\n    \"\"\"Lightweight wrapper/adapter around the provided input list.\"\"\"\n    def __init__(self, elements: List[Any]):\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.elements)\n\nclass FrequencyDictionary:\n    \"\"\"Maintains an internal mapping of element to integer count.\"\"\"\n    def __init__(self):\n        self.mapping: Dict[Any, int] = {}\n\n    def increment(self, element: Element):\n        \"\"\"Increments the count for the given element's value.\"\"\"\n        self.mapping[element.value] = self.mapping.get(element.value, 0) + 1\n\n    def getCount(self, element: Element) -> int:\n        \"\"\"Returns the count for the given element's value, or 0 if not present.\"\"\"\n        return self.mapping.get(element.value, 0)\n\n    def as_dict(self) -> Dict[Any, int]:\n        \"\"\"Returns a shallow copy of the internal frequency mapping.\"\"\"\n        return self.mapping.copy()\n\nclass FrequencyCounter:\n    \"\"\"Encapsulates the counting algorithm and iterates over InputList.\"\"\"\n    def __init__(self):\n        self.frequency_dict = FrequencyDictionary()\n\n    def freq_count(self, input_list_wrapper: InputList) -> Dict[Any, int]:\n        \"\"\"Processes the input list to compute element frequencies.\"\"\"\n        for value in input_list_wrapper.elements:\n            element = Element(value)\n            if not element.hashable():\n                raise TypeError(f\"Unhashable element encountered: {value}\")\n            self.frequency_dict.increment(element)\n        return self.frequency_dict.as_dict()\n\ndef freq_count(input_list: list) -> dict:\n    \"\"\"\n    Computes the frequency of all elements in a list, returned as a dictionary.\n    Raises TypeError if input is not a list or contains unhashable elements.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    if not input_list:\n        return {}\n\n    input_list_wrapper = InputList(input_list)\n    counter = FrequencyCounter()\n    result_dict = counter.freq_count(input_list_wrapper)\n\n    return result_dict"}
{"task_id": "Mbpp/89", "solution": "from math import floor, isfinite\nfrom typing import Union\n\nclass Parameter:\n    \"\"\"A simple data holder for an input parameter's value and type.\"\"\"\n    def __init__(self, value: Union[int, float]) -> None:\n        self.value: Union[int, float] = value\n        self.type: str = type(value).__name__\n\nclass Result:\n    \"\"\"A simple data holder for an integer result.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value: int = value\n\nclass ClosestNumFunction:\n    \"\"\"Encapsulates validation and computation for finding the closest smaller number.\"\"\"\n    def __init__(self, n: Union[int, float]) -> None:\n        self.n: Union[int, float] = n\n\n    def validateInput(self) -> None:\n        \"\"\"Validates that the input n is a finite numeric type.\"\"\"\n        if not isinstance(self.n, (int, float)) or not isfinite(self.n):\n            raise TypeError(\"Input must be a finite numeric value.\")\n\n    def compute(self) -> int:\n        \"\"\"Computes the largest integer strictly less than n.\"\"\"\n        # Check if n is an integer or mathematically an integer (e.g., 11.0)\n        if isinstance(self.n, int) or (isinstance(self.n, float) and self.n == int(self.n)):\n            return int(self.n) - 1\n        else:\n            return int(floor(self.n))\n\ndef closest_num(n: Union[int, float]) -> int:\n    \"\"\"\n    Finds the largest integer strictly less than n.\n    Raises TypeError if n is not a finite numeric value.\n    \"\"\"\n    processor = ClosestNumFunction(n)\n    processor.validateInput()\n    result_value = processor.compute()\n    return Result(result_value).value"}
