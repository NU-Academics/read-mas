{"task_id": "Mbpp/63", "solution": "from typing import Iterable, List, Union\n\nNumeric = Union[int, float]\n\nclass Tuple:\n    def __init__(self, a: Numeric, b: Numeric) -> None:\n        self.a = a\n        self.b = b\n\n    def absDifference(self) -> Numeric:\n        \"\"\"Return abs(self.a - self.b).\"\"\"\n        return abs(self.a - self.b)\n\nclass TupleList:\n    def __init__(self, pairs: Iterable[Union[Tuple, tuple]]) -> None:\n        \"\"\"Normalize input iterable of Tuple or 2-element tuples into List[Tuple].\"\"\"\n        self.pairs: List[Tuple] = []\n        for item in pairs:\n            if isinstance(item, Tuple):\n                self.pairs.append(item)\n            elif isinstance(item, tuple) and len(item) == 2:\n                self.pairs.append(Tuple(item[0], item[1]))\n\nclass Result:\n    def __init__(self, max_difference: Numeric) -> None:\n        self.max_difference = max_difference\n\nclass MaxDifferenceFunction:\n    def compute(self, pairs: Iterable[Union[Tuple, tuple]]) -> Numeric:\n        \"\"\"Compute the maximum abs difference across provided tuples.\n        Raises ValueError for empty input or TypeError for non-numeric elements.\n        \"\"\"\n        tuple_list = TupleList(pairs)\n        \n        if not tuple_list.pairs:\n            raise ValueError(\"Input list of pairs cannot be empty.\")\n        \n        max_diff = tuple_list.pairs[0].absDifference()\n        \n        for i in range(1, len(tuple_list.pairs)):\n            current_diff = tuple_list.pairs[i].absDifference()\n            if current_diff > max_diff:\n                max_diff = current_diff\n        \n        result_obj = Result(max_diff)\n        return result_obj.max_difference\n\ndef max_difference(pairs: Iterable[Union[Tuple, tuple]]) -> Numeric:\n    \"\"\"Public API: minimal validation/normalization then return MaxDifferenceFunction().compute(pairs).\"\"\"\n    return MaxDifferenceFunction().compute(pairs)"}
{"task_id": "Mbpp/65", "solution": "from typing import Iterator\n\ndef _flatten(item) -> Iterator[int]:\n    \"\"\"Recursively yield integers from item (int or list). Raises TypeError on invalid types.\"\"\"\n    if isinstance(item, int):\n        yield item\n    elif isinstance(item, list):\n        for sub_item in item:\n            yield from _flatten(sub_item)\n    else:\n        raise TypeError(\"List elements must be integers or nested lists.\")\n\ndef recursive_list_sum(inputList: list) -> int:\n    \"\"\"Entry-point function to flatten a list and sum its elements, raising TypeError per FR6/FR7.\"\"\"\n    if not isinstance(inputList, list):\n        raise TypeError(\"Input must be a list.\")\n\n    return sum(_flatten(inputList))"}
{"task_id": "Mbpp/64", "solution": "from typing import List, Tuple, Union\n\nclass Validator:\n    \"\"\"\n    Validates input conforms to requirements for a list of subject-mark tuples.\n    Raises TypeError if validation fails.\n    \"\"\"\n    @staticmethod\n    def validate_list_of_2tuples(input_list: List[Tuple[str, Union[int, float]]]) -> None:\n        if not isinstance(input_list, list):\n            raise TypeError(\"Input must be a list.\")\n        \n        for i, item in enumerate(input_list):\n            if not isinstance(item, tuple) or len(item) != 2:\n                raise TypeError(f\"Item at index {i} must be a 2-element tuple.\")\n            if not isinstance(item[1], (int, float)):\n                raise TypeError(f\"Second element of tuple at index {i} must be a number (int or float).\")\n\nclass Sorter:\n    \"\"\"\n    Provides a static method to sort a list of tuples by their second element.\n    Uses Python's built-in sorted() for O(n log n) stable sorting.\n    \"\"\"\n    @staticmethod\n    def sort_by_mark(items: List[Tuple[str, Union[int, float]]]) -> List[Tuple[str, Union[int, float]]]:\n        return sorted(items, key=lambda t: t[1])\n\nclass SubjectMarkList:\n    \"\"\"\n    Represents a collection of subject-mark tuples and provides a method\n    to get the list sorted by mark.\n    \"\"\"\n    def __init__(self, items: List[Tuple[str, Union[int, float]]]):\n        self.items = items\n\n    def get_sorted_by_mark(self) -> List[Tuple[str, Union[int, float]]]:\n        return Sorter.sort_by_mark(self.items)\n\ndef subject_marks(input_list: List[Tuple[str, Union[int, float]]]) -> List[Tuple[str, Union[int, float]]]:\n    \"\"\"\n    Sorts a list of tuples using the second value of each tuple (the mark).\n    Input is validated to be a list of 2-element tuples with numeric marks.\n    \"\"\"\n    Validator.validate_list_of_2tuples(input_list)\n\n    if not input_list:\n        return []\n    \n    subject_mark_list = SubjectMarkList(items=input_list)\n    return subject_mark_list.get_sorted_by_mark()"}
{"task_id": "Mbpp/67", "solution": "class ValidationError(Exception):\n    \"\"\"\n    Exception raised when input validation fails.\n    \"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\nclass InputParameter:\n    \"\"\"\n    Represents and validates the input parameter n.\n    \"\"\"\n    def __init__(self, n: int):\n        self.n = n\n\n    def isValid(self) -> bool:\n        \"\"\"\n        Checks if n is a non-negative integer.\n        \"\"\"\n        return isinstance(self.n, int) and self.n >= 0\n\nclass Result:\n    \"\"\"\n    A container for the computed integer Bell number.\n    \"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass BellFunction:\n    \"\"\"\n    Encapsulates the Bell number computation algorithm using the Bell triangle recurrence.\n    \"\"\"\n    def calculate(self, n: int) -> int:\n        \"\"\"\n        Computes the Bell number for a given non-negative integer n.\n        \"\"\"\n        if n == 0:\n            return 1\n\n        # Initialize the Bell triangle process with B_0\n        prev_row = [1] # Represents the Bell number for n=0\n\n        for i in range(1, n + 1):\n            current_row = [0] * (i + 1)\n            # The first element of the current row is the last element of the previous row\n            current_row[0] = prev_row[-1]\n            for j in range(1, i + 1):\n                # Each subsequent element is the sum of the element to its left in the current row\n                # and the element diagonally up-left in the previous row\n                current_row[j] = current_row[j-1] + prev_row[j-1]\n            prev_row = current_row\n        \n        # The Bell number B_n is the first element of the last computed row\n        return prev_row[0]\n\ndef bell_number(n: int) -> int:\n    \"\"\"\n    Calculates the Bell number for a non-negative integer n.\n    Raises ValidationError for invalid input.\n    \"\"\"\n    param = InputParameter(n)\n    if not param.isValid():\n        raise ValidationError(\"Input 'n' must be a non-negative integer.\")\n\n    calculator = BellFunction()\n    bell_value = calculator.calculate(n)\n\n    # The design specifies wrapping the result in a Result object internally.\n    result_obj = Result(bell_value)\n    \n    return result_obj.value"}
{"task_id": "Mbpp/70", "solution": "def get_equal(seq):\n    \"\"\"\n    Checks if all tuples in the given sequence have the same length.\n    Returns True for empty or single-tuple sequences.\n    \"\"\"\n    iterator = iter(seq)\n\n    # BR4: Empty or single-item sequence returns True\n    try:\n        first_tuple = next(iterator)\n        first_length = len(first_tuple)\n    except StopIteration:\n        return True  # Sequence is empty\n\n    # Compare the length of subsequent tuples to the first one\n    for current_tuple in iterator:\n        if len(current_tuple) != first_length:\n            return False\n\n    return True"}
