{"task_id": "Mbpp/591", "solution": "def swap_List(input_list: list) -> list:\n    \"\"\"Return a list where the first and last elements of input_list are interchanged.\"\"\"\n    list_len = len(input_list)\n    if list_len < 2:\n        return input_list[:] # Return a shallow copy for lists of length 0 or 1\n    \n    # Create a new list with the last element first, middle elements, and first element last\n    return [input_list[list_len - 1]] + input_list[1:list_len - 1] + [input_list[0]]"}
{"task_id": "Mbpp/589", "solution": "import math\n\ndef is_perfect_square(n: int) -> bool:\n    \"\"\"Checks if n is a perfect square.\n    Handles non-negative integers; negative numbers are not perfect squares.\n    \"\"\"\n    if n < 0:\n        return False\n    sqrt_n = math.isqrt(n)\n    return sqrt_n * sqrt_n == n\n\nclass Range:\n    \"\"\"Represents an inclusive integer range [start, end].\"\"\"\n    def __init__(self, start: int, end: int):\n        self.start = start\n        self.end = end\n\nclass IntegerValue:\n    \"\"\"Wraps an integer and provides a perfect square predicate.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def isPerfectSquare(self) -> bool:\n        \"\"\"Checks if the wrapped value is a perfect square using the helper function.\"\"\"\n        return is_perfect_square(self.value)\n\nclass ResultList:\n    \"\"\"Collects qualifying integers, ensures ascending order, and exposes the final list.\"\"\"\n    def __init__(self):\n        self.squares = []\n\n    def append(self, n: int):\n        \"\"\"Adds a perfect square to the internal list.\"\"\"\n        self.squares.append(n)\n\n    def sortAscending(self):\n        \"\"\"Sorts the collected perfect squares in ascending order.\"\"\"\n        self.squares.sort()\n\n    def to_list(self) -> list:\n        \"\"\"Returns the collected perfect squares as a list.\"\"\"\n        return self.squares\n\nclass Function:\n    \"\"\"Encapsulates the computation of perfect squares within a given range.\"\"\"\n    def __init__(self, start: int, end: int):\n        self.range = Range(start, end)\n\n    def compute(self) -> list:\n        \"\"\"Finds all perfect squares in the specified range and returns them in ascending order.\"\"\"\n        result_list = ResultList()\n\n        # Handle the case where start > end by returning an empty list.\n        if self.range.start > self.range.end:\n            return result_list.to_list()\n\n        # Iterate through each number in the inclusive range [start, end].\n        for n in range(self.range.start, self.range.end + 1):\n            # Skip negative numbers as they cannot be perfect squares.\n            if n < 0:\n                continue\n\n            # Use IntegerValue to check if the number is a perfect square, as per design.\n            integer_value = IntegerValue(n)\n            if integer_value.isPerfectSquare():\n                result_list.append(n)\n\n        # Ensure the list is sorted, although iteration naturally appends in order.\n        result_list.sortAscending()\n        return result_list.to_list()\n\ndef perfect_squares(start: int, end: int) -> list:\n    \"\"\"Finds all perfect squares between two given numbers, inclusive.\"\"\"\n    # The public API delegates to the Function class for computation.\n    calculator = Function(start, end)\n    return calculator.compute()"}
{"task_id": "Mbpp/592", "solution": "import math\n\nclass Result:\n    def __init__(self, value: int):\n        self.value = value\n        self.type = \"int\"\n\nclass BinomialCoefficient:\n    @staticmethod\n    def compute(n: int, k: int) -> int:\n        return math.comb(n, k)\n\ndef validate_input(n) -> None:\n    pass\n\ndef sum_Of_product(n) -> int:\n    \"\"\"Validate n and compute S(n) = sum_{k=0}^{n-1} C(n,k) * C(n,k+1).\"\"\"\n    validate_input(n)\n\n    if n == 0:\n        _ = Result(0) # Internal creation as per design\n        return 0\n\n    total = 0\n    for k in range(0, n):\n        c1 = BinomialCoefficient.compute(n, k)\n        c2 = BinomialCoefficient.compute(n, k + 1) if k + 1 <= n else 0\n        total += c1 * c2\n    \n    _ = Result(total) # Internal creation as per design\n    return total"}
{"task_id": "Mbpp/590", "solution": "from math import sqrt, atan2, cos, sin\n\nclass CartesianCoordinate:\n    \"\"\"Holds x,y coordinates and converts to PolarCoordinate.\"\"\"\n    def __init__(self, x: float, y: float):\n        self.x = float(x)\n        self.y = float(y)\n\n    def toPolar(self) -> 'PolarCoordinate':\n        \"\"\"Computes r = sqrt(x^2 + y^2), theta = atan2(y, x) (radians).\"\"\"\n        r = sqrt(self.x**2 + self.y**2)\n        theta = atan2(self.y, self.x)\n        return PolarCoordinate(r, theta)\n\nclass PolarCoordinate:\n    \"\"\"Holds r,theta coordinates and converts to ComplexNumber.\"\"\"\n    def __init__(self, r: float, theta: float):\n        self.r = float(r)\n        self.theta = float(theta)\n\n    def toCartesian(self) -> 'ComplexNumber':\n        \"\"\"Computes x = r * cos(theta), y = r * sin(theta).\"\"\"\n        x = self.r * cos(self.theta)\n        y = self.r * sin(self.theta)\n        return ComplexNumber(x, y)\n\nclass ComplexNumber:\n    \"\"\"Holds real,imag components and converts to native complex.\"\"\"\n    def __init__(self, real: float, imag: float):\n        self.real = float(real)\n        self.imag = float(imag)\n\n    def asComplex(self) -> complex:\n        \"\"\"Returns native complex(real, imag) i.e., real + imag*j.\"\"\"\n        return complex(self.real, self.imag)\n\ndef polar_rect(a, b):\n    \"\"\"Converts coordinates from polar to rectangular and vice-versa.\"\"\"\n    # Cartesian path: interpret (a, b) as (x, y)\n    cart = CartesianCoordinate(a, b)\n    polar_from_cartesian = cart.toPolar()\n    polar_tuple = (polar_from_cartesian.r, polar_from_cartesian.theta)\n\n    # Polar path: interpret (a, b) as (r, theta)\n    pol_input = PolarCoordinate(a, b)\n    complex_val = pol_input.toCartesian().asComplex()\n\n    return (polar_tuple, complex_val)"}
{"task_id": "Mbpp/594", "solution": "from typing import List, Optional\n\nclass Element:\n    \"\"\"Represent a single list element with its integer value and position; provide parity inspection.\"\"\"\n    def __init__(self, value: int, position: int) -> None:\n        self.value = value\n        self.position = position\n\n    def parity(self) -> str:\n        \"\"\"Returns \"even\" or \"odd\" based on the element's value.\"\"\"\n        return \"even\" if self.value % 2 == 0 else \"odd\"\n\nclass InputList:\n    \"\"\"Represent an ordered collection of Element objects.\"\"\"\n    def __init__(self, values: List[int]) -> None:\n        self.elements: List[Element] = [Element(value, i) for i, value in enumerate(values)]\n\nclass DiffEvenOdd:\n    \"\"\"Encapsulate algorithm to scan InputList and compute first_even - first_odd.\"\"\"\n    def execute(self, input_list: InputList) -> int:\n        \"\"\"\n        Scans InputList.elements left-to-right to identify the first even and first odd elements.\n        Returns first_even.value - first_odd.value.\n        \"\"\"\n        first_even: Optional[Element] = None\n        first_odd: Optional[Element] = None\n\n        for element in input_list.elements:\n            if first_even is None and element.parity() == \"even\":\n                first_even = element\n            if first_odd is None and element.parity() == \"odd\":\n                first_odd = element\n            if first_even is not None and first_odd is not None:\n                break # Both found, stop scanning\n\n        # Per requirement, behavior for missing operands is unspecified, assume they are found.\n        return first_even.value - first_odd.value\n\ndef diff_even_odd(list_of_integers: List[int]) -> int:\n    \"\"\"\n    Public API to find the difference of the first even and first odd number of a given list.\n    Creates InputList and delegates to DiffEvenOdd.execute.\n    \"\"\"\n    input_list = InputList(list_of_integers)\n    diff_calculator = DiffEvenOdd()\n    return diff_calculator.execute(input_list)"}
{"task_id": "Mbpp/593", "solution": "from typing import List\n\nclass ValidationError(Exception):\n    \"\"\"\n    Custom exception for invalid input validation.\n    \"\"\"\n    def __init__(self, message: str, code: int = 0):\n        super().__init__(message)\n        self.message = message\n        self.code = code\n\nclass Octet:\n    \"\"\"\n    Represents an IP address octet, handling raw string and integer value.\n    \"\"\"\n    def __init__(self, raw: str):\n        self.raw = raw\n        self.value = int(raw)\n\n    def stripLeadingZeros(self) -> str:\n        \"\"\"\n        Strips leading zeros, preserving '0' for a zero-valued octet.\n        \"\"\"\n        if self.value == 0:\n            return '0'\n        else:\n            return str(self.value)\n\nclass IPAddress:\n    \"\"\"\n    Parses and normalizes an IP address string into its constituent octets.\n    \"\"\"\n    def __init__(self, raw: str, octets: List[Octet]):\n        self.raw = raw\n        self.octets = octets\n\n    @classmethod\n    def parse(cls, raw: str) -> 'IPAddress':\n        \"\"\"\n        Parses a raw dotted-decimal IP string into an IPAddress object.\n        \"\"\"\n        parts = raw.split('.')\n        if len(parts) != 4:\n            raise ValidationError(\"IP address must have exactly 4 octets.\")\n        \n        octets = [Octet(part) for part in parts]\n        return cls(raw, octets)\n\n    def normalize(self) -> str:\n        \"\"\"\n        Normalizes the IP address by stripping leading zeros from each octet.\n        \"\"\"\n        normalized_parts = [octet.stripLeadingZeros() for octet in self.octets]\n        return \".\".join(normalized_parts)\n\nclass RemoveZeroFunction:\n    \"\"\"\n    Orchestrates the process of removing leading zeros from an IP address.\n    \"\"\"\n    def removezero_ip(self, input: str) -> str:\n        \"\"\"\n        Parses, normalizes, and returns the IP address string without leading zeros.\n        \"\"\"\n        ip_address_obj = IPAddress.parse(input)\n        return ip_address_obj.normalize()\n\ndef removezero_ip(input: str) -> str:\n    \"\"\"\n    Removes leading zeros from each octet of an IPv4 address string.\n    \"\"\"\n    return RemoveZeroFunction().removezero_ip(input)"}
