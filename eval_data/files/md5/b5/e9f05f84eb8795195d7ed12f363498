{"task_id": "Mbpp/273", "solution": "from typing import Tuple\n\nclass InputTuple:\n    \"\"\"A wrapper for an input tuple of integers.\"\"\"\n    def __init__(self, elements: Tuple[int, ...]) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the tuple.\"\"\"\n        return len(self.elements)\n\nclass ResultTuple:\n    \"\"\"A wrapper for a result tuple of integers.\"\"\"\n    def __init__(self, elements: Tuple[int, ...]) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the tuple.\"\"\"\n        return len(self.elements)\n\n    def to_tuple(self) -> Tuple[int, ...]:\n        \"\"\"Converts the ResultTuple to a native Python tuple.\"\"\"\n        return self.elements\n\nclass Element:\n    \"\"\"Represents a single element with its value and index.\"\"\"\n    def __init__(self, value: int, index: int) -> None:\n        self.value = value\n        self.index = index\n\nclass SubtractService:\n    \"\"\"Provides methods for validating and computing tuple differences.\"\"\"\n    def substract_elements(self, t1_input: InputTuple, t2_input: InputTuple) -> ResultTuple:\n        \"\"\"Subtracts elements and returns a ResultTuple, raising ValueError if lengths differ.\"\"\"\n        if not self.validate_equal_length(t1_input, t2_input):\n            raise ValueError(\"Input tuples must have the same length.\")\n        return self.compute_difference(t1_input, t2_input)\n\n    def validate_equal_length(self, t1_input: InputTuple, t2_input: InputTuple) -> bool:\n        \"\"\"Checks if two InputTuple objects have the same length.\"\"\"\n        return t1_input.length() == t2_input.length()\n\n    def compute_difference(self, t1_input: InputTuple, t2_input: InputTuple) -> ResultTuple:\n        \"\"\"Computes element-wise differences and returns them as a ResultTuple.\"\"\"\n        differences = []\n        for i in range(t1_input.length()):\n            diff = t1_input.elements[i] - t2_input.elements[i]\n            differences.append(diff)\n        return ResultTuple(tuple(differences))\n\ndef substract_elements(t1: Tuple[int, ...], t2: Tuple[int, ...]) -> Tuple[int, ...]:\n    \"\"\"\n    Subtracts elements of the second tuple from the first tuple at corresponding indices.\n    Raises ValueError if input tuples have different lengths.\n    \"\"\"\n    input_t1 = InputTuple(t1)\n    input_t2 = InputTuple(t2)\n\n    service = SubtractService()\n    result_tuple_obj = service.substract_elements(input_t1, input_t2)\n\n    return result_tuple_obj.to_tuple()"}
{"task_id": "Mbpp/276", "solution": "import math\nfrom dataclasses import dataclass\n\nclass MathConstant:\n    PI: float = math.pi\n\n@dataclass\nclass Parameters:\n    radius: float\n    height: float\n\nclass Cylinder:\n    def __init__(self, radius: float, height: float):\n        self.radius = radius\n        self.height = height\n\n    def compute_volume(self) -> float:\n        \"\"\"Return PI * radius^2 * height\"\"\"\n        return MathConstant.PI * (self.radius ** 2) * self.height\n\n@dataclass\nclass VolumeResult:\n    value: float\n\ndef volume_cylinder(radius, height) -> float:\n    \"\"\"Compute and return the cylinder volume as a float.\"\"\"\n    params = Parameters(radius=float(radius), height=float(height))\n    cylinder = Cylinder(params.radius, params.height)\n    volume_value = cylinder.compute_volume()\n    result = VolumeResult(value=volume_value)\n    return result.value"}
{"task_id": "Mbpp/274", "solution": "import math\n\nclass InputParameter:\n    \"\"\"\n    Holds the input parameter n.\n    The validate method is present for structural conformity but performs no checks as per specific constraints.\n    \"\"\"\n    def __init__(self, n: int):\n        self.n = n\n\n    def validate(self) -> bool:\n        # As per specific constraints, no validation or exception raising is performed here.\n        return True\n\nclass BinomialCoefficient:\n    \"\"\"\n    Provides a static method to compute binomial coefficients C(n, k) using math.comb.\n    \"\"\"\n    @staticmethod\n    def compute(n: int, k: int) -> int:\n        return math.comb(n, k)\n\nclass Result:\n    \"\"\"\n    A simple data holder for the accumulated sum of coefficients.\n    \"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\ndef even_binomial_Coeff_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of even-indexed binomial coefficients for a given positive integer n.\n    This function adheres to specific constraints regarding validation and helper classes.\n    \"\"\"\n    # Instantiate InputParameter and call validate, which performs no actual validation as per constraints.\n    param = InputParameter(n)\n    param.validate()\n\n    total_sum = Result(0)\n\n    # Iterate through even indices k from 0 up to n (inclusive).\n    for k in range(0, n + 1, 2):\n        coeff = BinomialCoefficient.compute(n, k)\n        total_sum.value += coeff\n\n    return total_sum.value"}
{"task_id": "Mbpp/277", "solution": "def dict_filter(input_dict, n):\n    \"\"\"\n    Filters a dictionary to include only entries with values greater than or equal to n.\n    Returns a new dictionary without mutating the input_dict.\n    \"\"\"\n    return {k: v for k, v in input_dict.items() if v >= n}"}
{"task_id": "Mbpp/279", "solution": "def is_num_decagonal(n: int) -> int:\n    \"\"\"Calculates the nth decagonal number.\n    Raises ValueError if n is not an integer or n < 1.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"n must be integer >= 1\")\n    return n * (4 * n - 3)"}
