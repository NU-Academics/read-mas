{"task_id": "Mbpp/109", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid inputs.\"\"\"\n    pass\n\nclass InputValidator:\n    \"\"\"Validates binary strings and rotation counts.\"\"\"\n    def is_binary(self, s: str) -> bool:\n        return bool(s) and all(c in '01' for c in s)\n\n    def is_non_negative(self, n: int) -> bool:\n        return isinstance(n, int) and n >= 0\n\n    def validate(self, s: str, n: int) -> None:\n        if not self.is_binary(s):\n            raise InvalidInputError(\"Binary string must be non-empty and contain only '0' and '1'.\")\n        if not self.is_non_negative(n):\n            raise InvalidInputError(\"Rotations must be a non-negative integer.\")\n\nclass RotationOperation:\n    \"\"\"Performs cyclic left-rotation on binary strings.\"\"\"\n    def rotate_left(self, s: str, k: int) -> str:\n        # Assumes s is non-empty, and k is the effective rotation offset.\n        return s[k:] + s[:k]\n\nclass BinaryString:\n    \"\"\"A wrapper for binary strings.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n    def length(self) -> int:\n        return len(self.value)\n    def char_at(self, pos: int) -> str:\n        return self.value[pos]\n\nclass RotationResult:\n    \"\"\"Represents a rotated string and checks its oddness.\"\"\"\n    def __init__(self, index: int, value: str):\n        self.index = index\n        self.value = value\n    def is_odd(self) -> bool:\n        return self.value[-1] == '1'\n\nclass OddEquivalentFunction:\n    \"\"\"Orchestrates the counting of odd-valued rotations.\"\"\"\n    def __init__(self):\n        self._validator = InputValidator()\n        self._rotator = RotationOperation()\n\n    def odd_Equivalent(self, binary_string: str, rotations: int) -> int:\n        self._validator.validate(binary_string, rotations)\n\n        if rotations == 0:\n            return 0\n\n        odd_count = 0\n        n = len(binary_string)\n\n        for i in range(rotations):\n            offset = i % n\n            rotated_string = self._rotator.rotate_left(binary_string, offset)\n            rotation_result = RotationResult(i, rotated_string)\n            if rotation_result.is_odd():\n                odd_count += 1\n        \n        return odd_count\n\ndef odd_Equivalent(binary_string: str, rotations: int) -> int:\n    \"\"\"\n    Finds the number of numbers with an odd value when rotating a binary string.\n    \"\"\"\n    return OddEquivalentFunction().odd_Equivalent(binary_string, rotations)"}
{"task_id": "Mbpp/116", "solution": "from typing import Tuple, List\n\nclass TupleInput:\n    \"\"\"Represents the input tuple and provides validation.\"\"\"\n    def __init__(self, elements: Tuple[int, ...]) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the tuple.\"\"\"\n        return len(self.elements)\n\n    def is_valid(self) -> bool:\n        \"\"\"Validates if the input is a tuple of positive integers.\"\"\"\n        if not isinstance(self.elements, tuple):\n            return False\n        if not all(isinstance(e, int) and e > 0 for e in self.elements):\n            return False\n        return True\n\nclass TupleElement:\n    \"\"\"Represents a single integer element and provides its digit string.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def to_digits(self) -> str:\n        \"\"\"Converts the integer value to its string representation.\"\"\"\n        return str(self.value)\n\nclass IntegerOutput:\n    \"\"\"Holds the final integer result and returns it as a primitive int.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def as_int(self) -> int:\n        \"\"\"Returns the stored integer value.\"\"\"\n        return self.value\n\nclass TupleConverter:\n    \"\"\"Orchestrates conversion from TupleInput to IntegerOutput.\"\"\"\n    def tuple_to_int(self, t_input: 'TupleInput') -> 'IntegerOutput':\n        \"\"\"Converts a TupleInput into an IntegerOutput.\"\"\"\n        tuple_elements: List[TupleElement] = [TupleElement(e) for e in t_input.elements]\n        concatenated_digits = self.concatenateDigits(tuple_elements)\n        # int('') will raise ValueError, which is consistent with no explicit handling for empty tuple concatenation.\n        return IntegerOutput(int(concatenated_digits))\n\n    def concatenateDigits(self, elements: List['TupleElement']) -> str:\n        \"\"\"Joins the decimal-digit strings of TupleElements.\"\"\"\n        return \"\".join(element.to_digits() for element in elements)\n\ndef tuple_to_int(t: Tuple[int, ...]) -> int:\n    \"\"\"\n    Write a function to convert a given tuple of positive integers into a single integer.\n    assert tuple_to_int((1,2,3))==123\n    \"\"\"\n    tuple_input = TupleInput(t)\n    if not tuple_input.is_valid():\n        raise ValueError(\"input must be a tuple of positive integers\")\n\n    converter = TupleConverter()\n    integer_output = converter.tuple_to_int(tuple_input)\n    return integer_output.as_int()"}
{"task_id": "Mbpp/119", "solution": "def search(nums: list[int]) -> int:\n    \"\"\"Return the single integer in a sorted list where every other integer appears exactly twice.\n    Precondition: input is a sorted list of integers and exactly one integer appears once; behavior undefined otherwise.\n    \"\"\"\n    # Iterate through the array in steps of two, checking pairs.\n    # The array length will always be odd due to the problem constraints.\n    for i in range(0, len(nums) - 1, 2):\n        # If the current element does not match the next element,\n        # then the current element must be the single unique one.\n        if nums[i] != nums[i + 1]:\n            return nums[i]\n    # If the loop completes, it means all elements except the last one formed pairs.\n    # Therefore, the last element is the single unique one.\n    return nums[len(nums) - 1]"}
{"task_id": "Mbpp/120", "solution": "import math\nfrom typing import Union\n\nclass TuplePair:\n    \"\"\"A data model for a pair of numbers, capable of computing their product.\"\"\"\n    def __init__(self, a: Union[int, float], b: Union[int, float]) -> None:\n        if not isinstance(a, (int, float)) or not isinstance(b, (int, float)):\n            raise TypeError(\"TuplePair elements must be numeric.\")\n        self.a = float(a)\n        self.b = float(b)\n\n    def product(self) -> float:\n        \"\"\"Computes the product of the pair's elements.\"\"\"\n        return self.a * self.b\n\ndef max_product_tuple(tuples: list[TuplePair]) -> float:\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples.\n    Handles inputs as raw tuples or TuplePair objects, raising errors for malformed entries.\n    \"\"\"\n    if not tuples:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    max_abs_product = float('-inf')\n\n    for i, item in enumerate(tuples):\n        product_value = None\n\n        if isinstance(item, TuplePair):\n            product_value = item.product()\n        elif isinstance(item, tuple) and len(item) == 2:\n            val1, val2 = item\n            if isinstance(val1, (int, float)) and isinstance(val2, (int, float)):\n                product_value = float(val1) * float(val2)\n            else:\n                raise TypeError(f\"Elements of tuple at index {i} must be numeric, but got ({type(val1)}, {type(val2)}).\")\n        else:\n            raise TypeError(f\"Element at index {i} must be a 2-element tuple or TuplePair, but got {type(item)}.\")\n        \n        max_abs_product = max(max_abs_product, abs(product_value))\n\n    return max_abs_product"}
{"task_id": "Mbpp/127", "solution": "def multiply_int(a, b) -> int:\n    \"\"\"Multiply two integers and return the product.\n\n    Raises:\n        TypeError: if either a or b is not an int.\n    \"\"\"\n    if not isinstance(a, int) or not isinstance(b, int):\n        raise TypeError(\"multiply_int requires integer arguments\")\n    return a * b"}
{"task_id": "Mbpp/125", "solution": "class InputValidationError(Exception):\n    \"\"\"Raised when the input string contains characters other than '0' or '1'.\"\"\"\n    pass\n\nclass Validator:\n    \"\"\"Validates input strings for binary content.\"\"\"\n    def validate(self, string: str) -> bool:\n        \"\"\"\n        Checks if the string contains only '0' and '1' characters.\n        Raises InputValidationError if invalid characters are found.\n        \"\"\"\n        if not all(c in {'0', '1'} for c in string):\n            self.raise_error(\"Input string must contain only '0' or '1' characters.\")\n        return True\n\n    def raise_error(self, message: str):\n        \"\"\"Raises an InputValidationError with the given message.\"\"\"\n        raise InputValidationError(message)\n\nclass BinaryString:\n    \"\"\"A domain model for a binary string.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the binary string.\"\"\"\n        return len(self.value)\n\nclass FindLengthService:\n    \"\"\"Orchestrates validation and computation for finding max difference.\"\"\"\n    def find_length(self, string: str) -> int:\n        \"\"\"\n        Validates the input, converts it to a difference array,\n        and computes the maximum difference using Kadane's algorithm.\n        \"\"\"\n        validator = Validator()\n        validator.validate(string)\n\n        if not string:\n            return 0\n\n        bstr = BinaryString(string)\n        diff_array = self._to_diff_array(bstr)\n        return self._compute_max_difference(diff_array)\n\n    def _to_diff_array(self, bstr: BinaryString) -> list[int]:\n        \"\"\"Maps '0' to +1 and '1' to -1 for the given binary string.\"\"\"\n        return [1 if char == '0' else -1 for char in bstr.value]\n\n    def _compute_max_difference(self, diff_array: list[int]) -> int:\n        \"\"\"\n        Applies Kadane's algorithm to find the maximum contiguous subarray sum.\n        This sum represents the maximum difference between zeros and ones.\n        \"\"\"\n        if not diff_array:\n            return 0\n\n        max_so_far = diff_array[0]\n        max_ending_here = diff_array[0]\n\n        for i in range(1, len(diff_array)):\n            max_ending_here = max(diff_array[i], max_ending_here + diff_array[i])\n            max_so_far = max(max_so_far, max_ending_here)\n\n        return max_so_far\n\ndef find_length(string: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the count of '0's and '1's\n    in any contiguous substring of the given binary string.\n    \"\"\"\n    service = FindLengthService()\n    return service.find_length(string)"}
{"task_id": "Mbpp/123", "solution": "from dataclasses import dataclass\nfrom typing import List, Dict\n\n@dataclass\nclass Number:\n    \"\"\"Represents a number and its pre-computed proper divisor sum.\"\"\"\n    value: int\n    properDivisorSum: int\n\n@dataclass\nclass AmicablePair:\n    \"\"\"Represents an identified amicable pair.\"\"\"\n    a: int\n    b: int\n\n@dataclass\nclass ComputationResult:\n    \"\"\"Encapsulates the result of an amicable sum computation.\"\"\"\n    n: int\n    sum: int\n\nclass AmicableService:\n    \"\"\"Service responsible for identifying and summing amicable numbers.\"\"\"\n\n    def __init__(self):\n        # A transient in-memory mapping for number -> proper divisor sum\n        self.divisor_sums: Dict[int, int] = {}\n\n    def sum_of_proper_divisors(self, m: int) -> int:\n        \"\"\"Computes the sum of proper divisors for a given number m.\"\"\"\n        if m <= 1:\n            return 0\n        total = 0\n        # Iterate up to the square root of m to find divisors efficiently\n        for i in range(1, int(m**0.5) + 1):\n            if m % i == 0:\n                # i is a divisor\n                if i < m: # Exclude m itself from proper divisors\n                    total += i\n                # m // i is also a divisor\n                # Add m // i only if it's different from i and less than m\n                if (m // i) != i and (m // i) < m:\n                    total += m // i\n        return total\n\n    def identify_amicable_pairs(self, max_num: int) -> List[AmicablePair]:\n        \"\"\"Identifies amicable pairs up to max_num based on pre-computed divisor sums.\"\"\"\n        found_pairs: List[AmicablePair] = []\n        # Use a set to prevent adding duplicate pairs (e.g., (a,b) and (b,a))\n        checked_pairs = set()\n\n        for a in range(1, max_num + 1):\n            sum_a = self.divisor_sums.get(a)\n\n            # Check if sum_a is valid, within range, and not equal to a\n            if sum_a is not None and 1 <= sum_a <= max_num and sum_a != a:\n                b = sum_a\n                sum_b = self.divisor_sums.get(b)\n\n                # Check if b's proper divisor sum equals a (amicable condition)\n                if sum_b == a:\n                    # Store the pair with its members sorted to ensure uniqueness in the set\n                    pair_tuple = tuple(sorted((a, b)))\n                    if pair_tuple not in checked_pairs:\n                        found_pairs.append(AmicablePair(a, b))\n                        checked_pairs.add(pair_tuple)\n        return found_pairs\n\n    def amicable_numbers_sum(self, n: int) -> ComputationResult:\n        \"\"\"Orchestrates the computation of the sum of amicable numbers up to n.\"\"\"\n        # First, pre-compute all proper divisor sums for numbers from 1 to n\n        for m in range(1, n + 1):\n            self.divisor_sums[m] = self.sum_of_proper_divisors(m)\n\n        # Identify all amicable pairs based on the pre-computed sums\n        pairs = self.identify_amicable_pairs(n)\n\n        total_amicable_sum = 0\n        # A set to track unique amicable numbers already added to the sum\n        added_numbers = set()\n\n        for pair in pairs:\n            # Add both members of the pair to the total sum if they haven't been added yet\n            # The identify_amicable_pairs method already filters for numbers within [1, n],\n            # but this provides an explicit final check.\n            if pair.a not in added_numbers:\n                total_amicable_sum += pair.a\n                added_numbers.add(pair.a)\n            if pair.b not in added_numbers:\n                total_amicable_sum += pair.b\n                added_numbers.add(pair.b)\n        \n        return ComputationResult(n=n, sum=total_amicable_sum)\n\ndef amicable_numbers_sum(n: int) -> int:\n    \"\"\"Calculates the sum of all amicable numbers from 1 up to a specified number n.\"\"\"\n    service = AmicableService()\n    result = service.amicable_numbers_sum(n)\n    return result.sum"}
{"task_id": "Mbpp/124", "solution": "import math\nfrom typing import Tuple, Any\n\ndef _to_components(*args: Any) -> Tuple[float, float]:\n    \"\"\"\n    Normalizes input to real and imaginary float components.\n    Handles single complex-like or two numeric arguments.\n    \"\"\"\n    if len(args) == 1:\n        arg = args[0]\n        if isinstance(arg, complex):\n            return float(arg.real), float(arg.imag)\n        elif hasattr(arg, 'real') and hasattr(arg, 'imag'):\n            return float(arg.real), float(arg.imag)\n        else:\n            raise TypeError(\"Single argument must be a complex number or an object with .real and .imag attributes.\")\n    elif len(args) == 2:\n        real_val, imag_val = args[0], args[1]\n        real = float(real_val.real) if isinstance(real_val, complex) else float(real_val)\n        imag = float(imag_val.imag) if isinstance(imag_val, complex) else float(imag_val)\n        return real, imag\n    else:\n        raise TypeError(\"angle_complex expects one complex-like argument or two numeric arguments (real, imag).\")\n\ndef angle_complex(*args: Any) -> float:\n    \"\"\"\n    Calculates the argument (angle) of a complex number in radians.\n    It can accept a single complex-like object or two numeric components.\n    \"\"\"\n    real, imag = _to_components(*args)\n    return float(math.atan2(imag, real))"}
{"task_id": "Mbpp/126", "solution": "\"\"\"\nThis module provides a function named `sum` that calculates the sum of common divisors.\nNote: The function name `sum` intentionally shadows Python's built-in `sum()`;\ncallers should be aware of this potential conflict.\n\"\"\"\n\nclass InputPair:\n    \"\"\"Data holder for inputs a and b.\"\"\"\n    def __init__(self, a: int, b: int) -> None:\n        self.a = a\n        self.b = b\n\nclass Divisor:\n    \"\"\"Represents a candidate positive divisor and tests if it divides both inputs.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def is_common(self, input_pair: InputPair) -> bool:\n        \"\"\"Returns True if value divides both input_pair.a and input_pair.b.\"\"\"\n        return (input_pair.a % self.value == 0) and \\\n               (input_pair.b % self.value == 0)\n\nclass Result:\n    \"\"\"Holds the aggregated sum value.\"\"\"\n    def __init__(self, sum_value: int) -> None:\n        self.sum = sum_value\n\nclass Validator:\n    \"\"\"Validates inputs, provides is_integer and is_valid_input.\"\"\"\n    def is_integer(self, value) -> bool:\n        \"\"\"Checks if the given value is an integer.\"\"\"\n        return isinstance(value, int)\n\n    def is_valid_input(self, input_pair: InputPair) -> bool:\n        \"\"\"\n        Validates the input pair. Raises TypeError/ValueError on invalid input.\n        Inputs must be non-negative integers, and not both zero.\n        \"\"\"\n        if not self.is_integer(input_pair.a) or not self.is_integer(input_pair.b):\n            raise TypeError(\"Inputs 'a' and 'b' must be integers.\")\n\n        if input_pair.a < 0 or input_pair.b < 0:\n            raise ValueError(\"Inputs 'a' and 'b' must be non-negative.\")\n        \n        if input_pair.a == 0 and input_pair.b == 0:\n            raise ValueError(\"Both inputs 'a' and 'b' cannot be zero as the sum of common positive divisors would be infinite.\")\n            \n        return True\n\nclass SumFunction:\n    \"\"\"Orchestrates validation, divisor enumeration, aggregation, and return of result.\"\"\"\n    def __init__(self, a: int, b: int) -> None:\n        self.a = a\n        self.b = b\n        self._validator = Validator()\n\n    def execute(self) -> int:\n        \"\"\"Executes the sum of common divisors computation.\"\"\"\n        input_pair = InputPair(self.a, self.b)\n        self._validator.is_valid_input(input_pair)\n\n        common_divisors = self._compute_common_divisors(input_pair)\n        result = self._aggregate_sum(common_divisors)\n        return result.sum\n\n    def _compute_common_divisors(self, input_pair: InputPair) -> list[Divisor]:\n        \"\"\"Computes a list of common positive divisors for the input pair.\"\"\"\n        common_divisor_objects = []\n\n        upper_bound = 0\n        if input_pair.a == 0:\n            upper_bound = input_pair.b\n        elif input_pair.b == 0:\n            upper_bound = input_pair.a\n        else:\n            upper_bound = min(input_pair.a, input_pair.b)\n        \n        for d in range(1, upper_bound + 1):\n            divisor_candidate = Divisor(d)\n            if divisor_candidate.is_common(input_pair):\n                common_divisor_objects.append(divisor_candidate)\n        \n        return common_divisor_objects\n\n    def _aggregate_sum(self, divisors: list[Divisor]) -> Result:\n        \"\"\"Aggregates common divisor values into a Result object.\"\"\"\n        total_sum = sum(d.value for d in divisors)\n        return Result(total_sum)\n\ndef sum(a: int, b: int) -> int:\n    \"\"\"\n    Finds the sum of common positive divisors of two given numbers.\n\n    Args:\n        a: The first integer.\n        b: The second integer.\n\n    Returns:\n        The sum of their common positive divisors.\n\n    Raises:\n        TypeError: If inputs 'a' or 'b' are not integers.\n        ValueError: If inputs 'a' or 'b' are negative, or if both are zero.\n    \"\"\"\n    return SumFunction(a, b).execute()"}
{"task_id": "Mbpp/128", "solution": "```python\ndef _validate_inputs(n, words_input):\n    \"\"\"Ensure n is an int and words_input is either a string or an iterable/list.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer.\")\n    if not isinstance(words_input, (str, list)):\n        raise TypeError(\"words_input must be a string or a list of strings.\")\n\ndef _parse_words(words_input):\n    \"\"\"Convert words_input into a list of string tokens.\"\"\"\n    if isinstance(words_input, str):\n        return words_input.split(' ')\n    elif isinstance(words_input, list):\n        return list(words_input) # shallow copy\n\ndef _filter_longer(words, n):\n    \"\"\"Return a new list with tokens where len(token) > n, preserving original order.\"\"\"\n    return [token for token in words if len(token) > n]\n\ndef long_words(n, words_input):\n    \"\"\"Return list of tokens whose length is strictly greater than n.\n\n    Parameters:\n    - n (int): threshold; include token iff len(token) > n\n    - words_input (list | str): list of strings or a space-separated single string\n\n    Returns:\n    - list of strings (tokens) in the original order\n    \"\"\"\n    _validate_inputs(n, words_input)\n    parsed_words = _parse_words(words_input)\n    return _filter_longer(parsed_words, n)\n```"}
{"task_id": "Mbpp/129", "solution": "class ValidationError:\n    \"\"\"Internal lightweight error container; not propagated to caller.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n\nclass Matrix:\n    \"\"\"Encapsulates 2D integer data and provides helpers for dimension and sum computations.\"\"\"\n    def __init__(self, data: list[list[int]]) -> None:\n        self.data = data\n        self.rows = len(data)\n        self.cols = len(data[0]) if self.rows > 0 else 0\n\n    def is_square(self) -> bool:\n        \"\"\"Returns True if the matrix is non-empty, square, and consistent in row lengths.\"\"\"\n        if self.rows == 0:\n            return False\n        if self.rows != self.cols:\n            return False\n        for row in self.data:\n            if len(row) != self.cols:\n                return False\n        return True\n\n    def row_sum(self, i: int) -> int:\n        \"\"\"Returns the sum of elements in the specified row.\"\"\"\n        return sum(self.data[i])\n\n    def col_sum(self, j: int) -> int:\n        \"\"\"Returns the sum of elements in the specified column.\"\"\"\n        return sum(self.data[r][j] for r in range(self.rows))\n\n    def diag_sum_main(self) -> int:\n        \"\"\"Returns the sum of elements on the main diagonal.\"\"\"\n        return sum(self.data[i][i] for i in range(self.rows))\n\n    def diag_sum_secondary(self) -> int:\n        \"\"\"Returns the sum of elements on the secondary diagonal.\"\"\"\n        return sum(self.data[i][self.cols - 1 - i] for i in range(self.rows))\n\nclass MagicSquareChecker:\n    \"\"\"Implements the use-case for validating and checking a magic square.\"\"\"\n    def _validate(self, matrix: Matrix) -> bool:\n        \"\"\"Checks if the matrix is non-empty, square, and contains only integers.\"\"\"\n        if matrix.rows == 0 or matrix.cols == 0:\n            return False\n        if not matrix.is_square():\n            return False\n\n        for r in range(matrix.rows):\n            for c in range(matrix.cols):\n                if not isinstance(matrix.data[r][c], int):\n                    return False\n        return True\n\n    def _compute_target_sum(self, matrix: Matrix) -> int:\n        \"\"\"Computes the canonical target sum from the first row of the matrix.\"\"\"\n        return matrix.row_sum(0)\n\n    def _check_rows(self, matrix: Matrix, target: int) -> bool:\n        \"\"\"Verifies that every row's sum equals the target sum.\"\"\"\n        for i in range(matrix.rows):\n            if matrix.row_sum(i) != target:\n                return False\n        return True\n\n    def _check_columns(self, matrix: Matrix, target: int) -> bool:\n        \"\"\"Verifies that every column's sum equals the target sum.\"\"\"\n        for j in range(matrix.cols):\n            if matrix.col_sum(j) != target:\n                return False\n        return True\n\n    def _check_diagonals(self, matrix: Matrix, target: int) -> bool:\n        \"\"\"Verifies that both main diagonal sums equal the target sum.\"\"\"\n        main_diag_sum = matrix.diag_sum_main()\n        secondary_diag_sum = matrix.diag_sum_secondary()\n        return main_diag_sum == target and secondary_diag_sum == target\n\n    def magic_square_test(self, data: list[list[int]]) -> bool:\n        \"\"\"Performs full validation and checking; catches exceptions and returns False on error.\"\"\"\n        try:\n            matrix = Matrix(data)\n\n            if not self._validate(matrix):\n                return False\n\n            target_sum = self._compute_target_sum(matrix)\n\n            if not self._check_rows(matrix, target_sum):\n                return False\n            if not self._check_columns(matrix, target_sum):\n                return False\n            if not self._check_diagonals(matrix, target_sum):\n                return False\n\n            return True\n        except (IndexError, TypeError, ValueError, Exception):\n            return False\n\ndef magic_square_test(matrix: list[list[int]]) -> bool:\n    \"\"\"Public API: returns True if matrix is a magic square per design; returns False on validation/runtime errors.\"\"\"\n    checker = MagicSquareChecker()\n    return checker.magic_square_test(matrix)"}
{"task_id": "Mbpp/130", "solution": "import collections\n\ndef max_occurrences(lst):\n    \"\"\"\n    Finds the item with maximum frequency in a given list.\n    If multiple items tie for maximum frequency, the one appearing first in the original list is returned.\n    \"\"\"\n    freq_map = collections.Counter(lst)\n\n    # Find the maximum frequency among all items.\n    max_count = max(freq_map.values())\n\n    # Collect all items that have this maximum frequency.\n    candidates = [item for item, count in freq_map.items() if count == max_count]\n\n    # If there's only one candidate, return it directly.\n    if len(candidates) == 1:\n        return candidates[0]\n    else:\n        # If there are multiple candidates, return the one that appears first in the original list.\n        # This is achieved by using lst.index as a key for the min function.\n        return min(candidates, key=lst.index)"}
