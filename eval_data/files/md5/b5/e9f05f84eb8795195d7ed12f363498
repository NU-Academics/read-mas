{"task_id": "Mbpp/256", "solution": "class InputValidator:\n    \"\"\"Validates input parameters.\"\"\"\n    def validate_non_negative(self, n):\n        \"\"\"Raises ValueError if n is negative.\"\"\"\n        if n < 0:\n            raise ValueError('n must be non-negative')\n\nclass PrimeCounter:\n    \"\"\"Counts prime numbers less than a given number.\"\"\"\n    def _is_prime(self, k):\n        \"\"\"Checks if a number is prime using a basic algorithm.\"\"\"\n        if k < 2:\n            return False\n        if k == 2:\n            return True\n        if k % 2 == 0:\n            return False\n        i = 3\n        while i * i <= k:\n            if k % i == 0:\n                return False\n            i += 2\n        return True\n\n    def count_Primes_nums(self, n):\n        \"\"\"Returns the number of primes strictly less than n.\"\"\"\n        count = 0\n        # Iterate from 2 up to n-1 to find primes\n        for num in range(2, n):\n            if self._is_prime(num):\n                count += 1\n        return count\n\ndef count_Primes_nums(n):\n    \"\"\"\n    Write a python function that takes in a non-negative number and returns the number of prime numbers less than the given non-negative number.\n    \"\"\"\n    validator = InputValidator()\n    validator.validate_non_negative(n)\n    \n    prime_counter = PrimeCounter()\n    return prime_counter.count_Primes_nums(n)"}
{"task_id": "Mbpp/255", "solution": "class InputList:\n    def __init__(self, input_iterable):\n        # Validate indexability: check for __len__ and __getitem__ attributes.\n        if not (hasattr(input_iterable, '__len__') and hasattr(input_iterable, '__getitem__')):\n            raise TypeError(\"Input list must be indexable (have __len__ and __getitem__).\")\n        self.elements = list(input_iterable)  # Create a concrete copy\n        self.order_preserved = True\n\n    def __len__(self):\n        return len(self.elements)\n\n    def __getitem__(self, idx):\n        return self.elements[idx]\n\nclass Element:\n    def __init__(self, index, value):\n        self.index = index\n        self.value = value\n\nclass Combination:\n    def __init__(self, items: tuple):\n        self.items = items\n        self.length = len(items)\n\nclass CombinationGenerator:\n    def generate(self, input_list_elements, n: int) -> list[tuple]:\n        # Validate n as specified in the design context for the generator.\n        if not isinstance(n, int):\n            raise TypeError(\"n must be an integer.\")\n        if n < 0:\n            raise ValueError(\"n must be non-negative.\")\n\n        if n == 0:\n            return [()]\n\n        elements_count = len(input_list_elements)\n        if elements_count == 0: # and n > 0 is implied by previous checks\n            return []\n\n        results = []\n        # Initialize the first combination (all 0s, representing the first element repeated n times)\n        current_indices = [0] * n\n\n        while True:\n            # Construct the current combination tuple based on current_indices\n            combination = tuple(input_list_elements[i] for i in current_indices)\n            results.append(combination)\n\n            # Find the rightmost index that can be incremented\n            # (i.e., not yet at the maximum value for an element)\n            k = n - 1\n            while k >= 0 and current_indices[k] == elements_count - 1:\n                k -= 1\n\n            # If all indices are at their maximum, all combinations have been generated\n            if k < 0:\n                break\n\n            # Increment the found index and reset all subsequent indices to 0\n            # to ensure lexicographical order with the rightmost index varying fastest\n            current_indices[k] += 1\n            for j in range(k + 1, n):\n                current_indices[j] = 0\n        \n        return results\n\ndef combinations_colors(input_list, n):\n    # This function itself does not contain explicit isinstance() checks or raise exceptions,\n    # as per the direct requirement. Validation is delegated to helper classes.\n    \n    # InputList handles checking if input_list is indexable.\n    # It will raise TypeError if input_list is invalid, but the call to InputList() is\n    # not an explicit 'raise' statement within combinations_colors.\n    validated_input = InputList(input_list) \n    \n    generator = CombinationGenerator()\n    # CombinationGenerator.generate handles validation for 'n' (type and value),\n    # raising TypeError or ValueError if n is invalid.\n    return generator.generate(validated_input.elements, n)"}
{"task_id": "Mbpp/262", "solution": "import typing\n\nclass ValidationError(Exception):\n    \"\"\"Custom exception for validation errors.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\ndef _validate_inputs(list_input: typing.List[typing.Any], L: int) -> None:\n    \"\"\"Validates the input list and integer L, raising ValidationError on failure.\"\"\"\n    if not isinstance(list_input, list):\n        raise ValidationError(\"list_input must be a list\")\n    if not isinstance(L, int):\n        raise ValidationError(\"L must be an int\")\n    if L < 0 or L > len(list_input):\n        raise ValidationError(\"L must be between 0 and len(list_input)\")\n\ndef split_two_parts(list_input: typing.List[typing.Any], L: int) -> typing.Tuple[typing.List[typing.Any], typing.List[typing.Any]]:\n    \"\"\"\n    Splits a list into two parts: the first of length L, and the remainder.\n    Returns the two parts as new lists in a tuple.\n    \"\"\"\n    _validate_inputs(list_input, L)\n\n    first_part = list_input[:L]\n    second_part = list_input[L:]\n\n    return (first_part, second_part)"}
{"task_id": "Mbpp/264", "solution": "class HumanAge:\n    def __init__(self, years: int):\n        self.years = years\n\nclass DogAge:\n    def __init__(self, years: int):\n        self.years = years\n\nclass DogAgeCalculator:\n    def calculate(self, humanYears: int) -> int:\n        \"\"\"\n        Calculates a dog's age in dog years, reading HumanAge and creating DogAge conceptually.\n        Uses a common formula: first two years are 10.5 dog years each, subsequent years are 4 dog years each.\n        \"\"\"\n        human_age_obj = HumanAge(humanYears)\n        \n        dog_years_val = 0.0\n        if human_age_obj.years <= 0:\n            dog_years_val = 0.0\n        elif human_age_obj.years <= 2:\n            dog_years_val = human_age_obj.years * 10.5\n        else:\n            dog_years_val = (2 * 10.5) + ((human_age_obj.years - 2) * 4)\n        \n        dog_age_obj = DogAge(int(dog_years_val))\n        return dog_age_obj.years\n\ndef dog_age(human_years: int) -> int:\n    \"\"\"\n    Calculates a dog's age in dog years using the DogAgeCalculator.\n    \"\"\"\n    calculator = DogAgeCalculator()\n    return calculator.calculate(human_years)"}
{"task_id": "Mbpp/261", "solution": "class Validator:\n    \"\"\"Helper class for input validation.\"\"\"\n    def validate_is_tuple(self, obj):\n        if not isinstance(obj, tuple):\n            raise TypeError(\"Input must be a tuple.\")\n\n    def validate_equal_length(self, t1, t2):\n        if len(t1) != len(t2):\n            raise ValueError(\"Tuples must have equal length.\")\n\n    def validate_numeric_elements(self, t):\n        for element in t:\n            if not isinstance(element, (int, float)):\n                raise TypeError(\"All tuple elements must be numeric (int or float).\")\n\ndef division_elements(tuple1, tuple2):\n    \"\"\"\n    Performs element-wise division on two input tuples.\n    Validates input types, lengths, and element types, raising exceptions on errors.\n    \"\"\"\n    validator = Validator()\n\n    validator.validate_is_tuple(tuple1)\n    validator.validate_is_tuple(tuple2)\n    validator.validate_equal_length(tuple1, tuple2)\n    validator.validate_numeric_elements(tuple1)\n    validator.validate_numeric_elements(tuple2)\n\n    results_list = []\n    for a, b in zip(tuple1, tuple2):\n        if b == 0:\n            raise ZeroDivisionError(\"Cannot divide by zero.\")\n        results_list.append(a / b)\n\n    return tuple(results_list)"}
{"task_id": "Mbpp/259", "solution": "# Helper to validate lengths of two tuples.\ndef _validate_lengths(a, b):\n    if len(a) != len(b):\n        raise ValueError(\"Input tuples must have the same length.\")\n\n# Helper to validate elements of a tuple sequence.\ndef _validate_elements(seq):\n    for i, elem in enumerate(seq):\n        if not isinstance(elem, (tuple, list)) or len(elem) != 2:\n            raise TypeError(f\"Element at index {i} must be a 2-length tuple or list.\")\n        if not isinstance(elem[0], (int, float)) or not isinstance(elem[1], (int, float)):\n            raise TypeError(f\"Components of element at index {i} must be numeric (int or float).\")\n\n# Helper to compute element-wise maximum for two 2-tuples.\ndef _compute_element_max(a_elem, b_elem):\n    return (max(a_elem[0], b_elem[0]), max(a_elem[1], b_elem[1]))\n\ndef maximize_elements(a, b):\n    _validate_lengths(a, b)\n    _validate_elements(a)\n    _validate_elements(b)\n\n    result = []\n    for i in range(len(a)):\n        max_elem = _compute_element_max(a[i], b[i])\n        result.append(max_elem)\n\n    return tuple(result)"}
{"task_id": "Mbpp/260", "solution": "class NewmanShanksWilliamsSequence:\n    \"\"\"Generates terms of the Newman\u2013Shanks\u2013Williams sequence (S_0=1, S_1=1, S_n=2*S_{n-1}+S_{n-2}).\"\"\"\n    def __init__(self) -> None:\n        self._index = 0\n        self._prev2 = 1 # S_0\n        self._prev1 = 1 # S_1\n\n    def next(self) -> int:\n        \"\"\"Computes and returns the next term in the sequence; increments internal index.\"\"\"\n        if self._index == 0:\n            self._index += 1\n            return 1 # S_0\n        elif self._index == 1:\n            self._index += 1\n            return 1 # S_1\n        \n        # S_n = 2*S_{n-1} + S_{n-2}\n        current_term = 2 * self._prev1 + self._prev2\n        self._prev2 = self._prev1\n        self._prev1 = current_term\n        self._index += 1\n        return current_term\n\n    def get(self, index: int) -> int:\n        \"\"\"Returns the S_index term by iterating from S_0 without affecting generator state.\"\"\"\n        if index < 0:\n            raise ValueError(\"Sequence index must be non-negative.\")\n        if index == 0:\n            return 1\n        if index == 1:\n            return 1\n        \n        a, b = 1, 1 # S_0, S_1\n        for _ in range(2, index + 1):\n            a, b = b, 2 * b + a\n        return b\n\n\nclass PrimeTester:\n    \"\"\"Tests if a given integer is a prime number.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def isPrime(self, n: int) -> bool:\n        \"\"\"Determines if n is a prime number using trial division.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3: # 2 and 3 are prime\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        # Check divisibility by numbers of the form 6k \u00b1 1\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n\nclass NewmanPrimeService:\n    \"\"\"Orchestrates generation, primality testing, and counting to find nth NSW prime.\"\"\"\n    def __init__(self, sequence: NewmanShanksWilliamsSequence = None, tester: PrimeTester = None) -> None:\n        # Use provided instances or create defaults\n        self.sequence = sequence if sequence is not None else NewmanShanksWilliamsSequence()\n        self.tester = tester if tester is not None else PrimeTester()\n\n    def newman_prime(self, n: int) -> int:\n        \"\"\"\n        Finds the nth Newman\u2013Shanks\u2013Williams prime number (1-based).\n        It iterates the sequence, counts primes, and returns the nth one.\n        \"\"\"\n        if n < 1:\n            raise ValueError(\"n must be a positive integer (1-based).\")\n\n        prime_count = 0\n        while True:\n            current_nsw_term = self.sequence.next()\n            if self.tester.isPrime(current_nsw_term):\n                prime_count += 1\n                if prime_count == n:\n                    return current_nsw_term\n\n\ndef newman_prime(n: int) -> int:\n    \"\"\"\n    Finds the nth Newman\u2013Shanks\u2013Williams prime number (1-based).\n    Delegates the computation to the NewmanPrimeService.\n    \"\"\"\n    service = NewmanPrimeService()\n    return service.newman_prime(n)"}
{"task_id": "Mbpp/266", "solution": "class LateralSurfaceCalculator:\n    @staticmethod\n    def lateralsurface_cube(side_length: float) -> float:\n        \"\"\"Calculates the lateral surface area of a cube given its side length.\"\"\"\n        return 4 * side_length**2\n\ndef lateralsurface_cube(side_length: float) -> float:\n    \"\"\"\n    Finds the lateral surface area of a cube given its side length.\n    Delegates the computation to LateralSurfaceCalculator.\n    \"\"\"\n    return LateralSurfaceCalculator.lateralsurface_cube(side_length)"}
{"task_id": "Mbpp/265", "solution": "from typing import Any, List\n\ndef list_split(input_list: List[Any], n: int) -> List[List[Any]]:\n    \"\"\"Partition the input sequence named 'input_list' into exactly n sublists.\n\n    The element at zero-based index i from the input is appended to\n    sublist j where j == i % n. Ordering in each sublist preserved.\n    \"\"\"\n    result: List[List[Any]] = [[] for _ in range(n)]\n    for i, element in enumerate(input_list):\n        target_sublist_index = i % n\n        result[target_sublist_index].append(element)\n    return result"}
{"task_id": "Mbpp/267", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the squares of the first n odd natural numbers using a closed-form formula.\n    Input validation (type checks or handling n <= 0) is omitted based on prompt constraints.\n    \"\"\"\n    def _closed_form(num: int) -> int:\n        return num * (4 * num * num - 1) // 3\n\n    return _closed_form(n)"}
