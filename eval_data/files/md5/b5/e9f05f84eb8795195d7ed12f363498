{"task_id": "Mbpp/247", "solution": "class InputString:\n    \"\"\"Encapsulates input string and provides length.\"\"\"\n    def __init__(self, content: str) -> None:\n        self.content = content\n\n    def length(self) -> int:\n        return len(self.content)\n\nclass LPSResult:\n    \"\"\"Lightweight wrapper for the integer result.\"\"\"\n    def __init__(self, length: int) -> None:\n        self.length = length\n\nclass LPSFunction:\n    \"\"\"Encapsulates the algorithm to compute the LPS length.\"\"\"\n    def lps(self, input_str_obj: InputString) -> LPSResult:\n        s = input_str_obj.content\n        n = input_str_obj.length()\n        \n        if n == 0:\n            return LPSResult(0)\n\n        # dp[i][j] will store the length of the longest palindromic subsequence of s[i...j].\n        dp = [[0] * n for _ in range(n)]\n\n        # All substrings of length 1 are palindromes of length 1.\n        for i in range(n):\n            dp[i][i] = 1\n\n        # Fill the table for lengths from 2 to n.\n        for current_len in range(2, n + 1):\n            for i in range(n - current_len + 1):\n                j = i + current_len - 1\n                if s[i] == s[j]:\n                    # If characters match, it extends the palindrome.\n                    # dp[i+1][j-1] handles the inner subsequence; it's 0 if no inner part.\n                    dp[i][j] = 2 + dp[i+1][j-1]\n                else:\n                    # If characters don't match, take the maximum of excluding s[i] or s[j].\n                    dp[i][j] = max(dp[i+1][j], dp[i][j-1])\n        \n        return LPSResult(dp[0][n-1])\n\ndef lps(s) -> int:\n    \"\"\"\n    Public API that validates input, enforces empty-string behavior,\n    and delegates algorithm to LPSFunction.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n\n    if len(s) == 0:\n        return 0\n\n    input_obj = InputString(s)\n    lps_calculator = LPSFunction()\n    lps_result_obj = lps_calculator.lps(input_obj)\n    \n    return lps_result_obj.length"}
{"task_id": "Mbpp/250", "solution": "def is_tuple(obj) -> bool:\n    \"\"\"Checks if the given object is a tuple.\"\"\"\n    return isinstance(obj, tuple)\n\ndef count_X(tuple, element) -> int:\n    \"\"\"Counts the occurrences of an element in a tuple.\"\"\"\n    if not is_tuple(tuple):\n        raise TypeError(\"First argument must be a tuple.\")\n\n    count = 0\n    for item in tuple:\n        if item == element:\n            count += 1\n    return count"}
{"task_id": "Mbpp/252", "solution": "import math\n\nclass ComplexNumber:\n    def __init__(self, real: float, imag: float) -> None:\n        self.real = real\n        self.imag = imag\n\nclass PolarCoordinates:\n    def __init__(self, r: float, theta: float) -> None:\n        self.r = r\n        self.theta = theta\n    def as_tuple(self) -> (float, float):\n        return (self.r, self.theta)\n\ndef sqrt(x: float) -> float:\n    return math.sqrt(x)\n\ndef atan2(y: float, x: float) -> float:\n    return math.atan2(y, x)\n\nclass Converter:\n    def convert(self, value) -> (float, float):\n        \"\"\"Public conversion API: accept complex or numeric input; return (r, theta) as floats.\"\"\"\n        c = self.to_complex(value)\n        r = self.compute_magnitude(c)\n        theta = self.compute_angle(c)\n        return PolarCoordinates(r, theta).as_tuple()\n\n    def to_complex(self, value) -> ComplexNumber:\n        \"\"\"Convert numeric or Python complex to ComplexNumber(real: float, imag: float).\"\"\"\n        py_complex = complex(value)\n        return ComplexNumber(real=float(py_complex.real), imag=float(py_complex.imag))\n\n    def compute_magnitude(self, c: ComplexNumber) -> float:\n        \"\"\"Compute r = sqrt(c.real**2 + c.imag**2) using src.mathlib.sqrt.\"\"\"\n        return sqrt(c.real**2 + c.imag**2)\n\n    def compute_angle(self, c: ComplexNumber) -> float:\n        \"\"\"Compute theta = atan2(c.imag, c.real) using src.mathlib.atan2.\"\"\"\n        return atan2(c.imag, c.real)\n\ndef convert(value) -> (float, float):\n    \"\"\"Module-level convenience function that creates/uses Converter and returns Converter.convert(value).\"\"\"\n    converter = Converter()\n    return converter.convert(value)"}
