{"task_id": "Mbpp/797", "solution": "from typing import Iterator\n\ndef _is_odd(n: int) -> bool:\n    \"\"\"Return True iff n % 2 != 0.\"\"\"\n    return n % 2 != 0\n\nclass IntegerRange:\n    \"\"\"Encapsulate an inclusive integer range [start, end] and provide iteration and membership.\"\"\"\n    def __init__(self, start: int, end: int):\n        self.start = start\n        self.end = end\n\n    def contains(self, n: int) -> bool:\n        \"\"\"Checks if a number is within the inclusive range.\"\"\"\n        return self.start <= n <= self.end\n\n    def iter_numbers(self) -> Iterator[int]:\n        \"\"\"Yields numbers sequentially from start to end (inclusive).\"\"\"\n        current = self.start\n        while current <= self.end:\n            yield current\n            current += 1\n\nclass Number:\n    \"\"\"Wrap an integer value and provide odd-check operation.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def isOdd(self) -> bool:\n        \"\"\"Returns True if the wrapped number is odd.\"\"\"\n        return _is_odd(self.value)\n\nclass Result:\n    \"\"\"Hold the computed sum value as an explicit result container.\"\"\"\n    def __init__(self, sum_value: int):\n        self.sum = sum_value\n\ndef sum_in_range(l: int, r: int) -> int:\n    \"\"\"Return sum of all odd integers n such that l <= n <= r.\"\"\"\n    range_obj = IntegerRange(start=l, end=r)\n    result_obj = Result(sum_value=0)\n\n    for num_val in range_obj.iter_numbers():\n        number_obj = Number(value=num_val)\n        if number_obj.isOdd():\n            result_obj.sum += num_val\n            \n    return result_obj.sum"}
{"task_id": "Mbpp/799", "solution": "MASK = 0xFFFFFFFF\n\ndef normalize_d(d: int) -> int:\n    \"\"\"Normalizes the rotation amount to be within 0-31.\"\"\"\n    return d % 32\n\ndef to_uint32(n: int) -> int:\n    \"\"\"Masks the input number to a 32-bit unsigned integer.\"\"\"\n    return n & MASK\n\ndef left_rotate(n: int, d: int) -> int:\n    \"\"\"\n    Rotates the bits of a 32-bit number to the left by d positions.\n    All operations enforce 32-bit unsigned integer semantics.\n    \"\"\"\n    normalized_d = normalize_d(d)\n    u = to_uint32(n)\n\n    if normalized_d == 0:\n        return u\n\n    # Perform the left rotation and ensure the result is 32-bit.\n    rotated = ((u << normalized_d) | (u >> (32 - normalized_d))) & MASK\n    return rotated"}
{"task_id": "Mbpp/801", "solution": "def test_three_equal(a: int, b: int, c: int) -> int:\n    \"\"\"Return the count of equal values among a, b, c.\n    Returns 3 if a == b == c, 2 if exactly two inputs are equal, 0 otherwise.\"\"\"\n    if a == b and b == c:\n        return 3\n    elif a == b or a == c or b == c:\n        return 2\n    else:\n        return 0"}
