{"task_id": "Mbpp/445", "solution": "from typing import Tuple\n\ndef is_tuple(x) -> bool:\n    \"\"\"Return True if x is an instance of tuple.\"\"\"\n    return isinstance(x, tuple)\n\ndef is_numeric(x) -> bool:\n    \"\"\"Return True if x is an int or float.\"\"\"\n    return isinstance(x, (int, float))\n\ndef _validate_outer(a: Tuple, b: Tuple) -> None:\n    \"\"\"Raises TypeError or ValueError per outer-level checks.\"\"\"\n    if not is_tuple(a) or not is_tuple(b):\n        raise TypeError(\"Both inputs 'a' and 'b' must be tuples.\")\n    if len(a) != len(b):\n        raise ValueError(\"Input tuples 'a' and 'b' must have the same length.\")\n\ndef _validate_inner_pair(ai: Tuple, bi: Tuple) -> None:\n    \"\"\"Raises TypeError or ValueError per inner-pair checks.\"\"\"\n    if not is_tuple(ai) or not is_tuple(bi):\n        raise TypeError(\"Inner elements of input tuples must be tuples.\")\n    if len(ai) != len(bi):\n        raise ValueError(\"Inner tuples must have the same length at each index.\")\n    for a_elem, b_elem in zip(ai, bi):\n        if not is_numeric(a_elem) or not is_numeric(b_elem):\n            raise TypeError(\"All elements within inner tuples must be numeric (int or float).\")\n\ndef _multiply_pairs(ai: Tuple, bi: Tuple) -> Tuple:\n    \"\"\"Returns a tuple with element-wise products of two inner tuples.\"\"\"\n    # Assumes inputs are valid and elements are numeric, as validated by _validate_inner_pair\n    return tuple(a_val * b_val for a_val, b_val in zip(ai, bi))\n\ndef index_multiplication(a: Tuple, b: Tuple) -> Tuple:\n    \"\"\"\n    Performs index-wise multiplication of tuple elements in two given tuples.\n    Raises TypeError if inputs or their elements are not of expected types,\n    or ValueError if tuple lengths do not match.\n    \"\"\"\n    _validate_outer(a, b)\n\n    result_tuples = []\n    for i in range(len(a)):\n        inner_a = a[i]\n        inner_b = b[i]\n        _validate_inner_pair(inner_a, inner_b)\n        product_tuple = _multiply_pairs(inner_a, inner_b)\n        result_tuples.append(product_tuple)\n\n    return tuple(result_tuples)"}
{"task_id": "Mbpp/451", "solution": "WHITESPACE_CHARS = frozenset((' ', '\\t', '\\n', '\\r', '\\f', '\\v'))\n\ndef remove_whitespaces(input: str) -> str:\n    \"\"\"\n    Removes all whitespace characters (space, tab, newline, carriage return, form feed, vertical tab)\n    from the input string and returns the remaining characters in their original order.\n    \"\"\"\n    result_chars = []\n    for char in input:\n        if char not in WHITESPACE_CHARS:\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/454", "solution": "import re\nfrom typing import List\n\nclass MatchResult:\n    \"\"\"Container for match outcome: whether any z-word was found and which words matched.\"\"\"\n    def __init__(self, has_z_word: bool, matched_words: List[str]) -> None:\n        self.has_z_word = has_z_word\n        self.matched_words = matched_words\n\nclass Word:\n    \"\"\"Represent a token and evaluate whether it contains the character 'z'.\"\"\"\n    def __init__(self, text: str) -> None:\n        self.text = text\n\n    def containsZ(self) -> bool:\n        \"\"\"Checks if the word contains 'z' (case-insensitive).\"\"\"\n        return 'z' in self.text.lower()\n\nclass Tokenizer:\n    \"\"\"Split normalized text into Word tokens and strip trailing punctuation.\"\"\"\n    def tokenize(self, text: str) -> List[\"Word\"]:\n        if not text:\n            return []\n        # Split by whitespace, then strip trailing punctuation from each token.\n        # The regex pattern matches one or more word characters, followed by zero or more non-word characters\n        # at the end, and we capture only the word characters.\n        tokens = re.findall(r'\\b\\w+\\b', text)\n        return [Word(token) for token in tokens if token]\n\nclass Matcher:\n    \"\"\"Evaluate a list of Word tokens and return a MatchResult; short-circuit True on first qualifying token.\"\"\"\n    def match(self, words: List[\"Word\"]) -> \"MatchResult\":\n        matched_words_list: List[str] = []\n        for word in words:\n            if word.containsZ():\n                matched_words_list.append(word.text)\n                return MatchResult(True, matched_words_list)\n        return MatchResult(False, matched_words_list)\n\nclass TextInput:\n    \"\"\"Represent the raw input string and produce normalized text and tokens for matching.\"\"\"\n    def __init__(self, raw_text: str) -> None:\n        self.raw_text = raw_text\n        self.normalized_text: str = \"\"\n\n    def normalize(self) -> None:\n        \"\"\"Currently, normalization is a no-op as Tokenizer handles punctuation.\"\"\"\n        self.normalized_text = self.raw_text if self.raw_text is not None else \"\"\n\n    def tokenize(self) -> List[\"Word\"]:\n        \"\"\"Tokenizes the normalized text using a Tokenizer instance.\"\"\"\n        tokenizer = Tokenizer()\n        return tokenizer.tokenize(self.normalized_text)\n\ndef text_match_wordz(text: str) -> bool:\n    \"\"\"\n    Public entrypoint that returns a Boolean indicating presence of at least one word containing 'z'.\n    Handles None/empty input and orchestrates TextInput, Tokenizer, and Matcher.\n    \"\"\"\n    if not text:\n        return False\n\n    text_input = TextInput(text)\n    text_input.normalize()\n    words = text_input.tokenize()\n\n    matcher = Matcher()\n    result = matcher.match(words)\n\n    return result.has_z_word"}
