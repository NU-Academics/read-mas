{"task_id": "Mbpp/297", "solution": "def flatten_list(input_list):\n    \"\"\"\n    Flattens a given nested list structure into a single-level list, preserving order.\n    Raises TypeError if the top-level input is not a list.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    def _flatten_generator(nested_list):\n        for item in nested_list:\n            if isinstance(item, list):\n                yield from _flatten_generator(item)\n            else:\n                yield item\n\n    return list(_flatten_generator(input_list))"}
{"task_id": "Mbpp/300", "solution": "import math\n\nclass BinomialCoefficient:\n    \"\"\"Computes exact integer binomial coefficients using an iterative multiplicative formula.\"\"\"\n    def computeC(self, total: int, k: int) -> int:\n        \"\"\"Calculates C(total, k) = total! / (k! * (total-k)!).\"\"\"\n        if k < 0 or k > total:\n            return 0\n        if k == 0 or k == total:\n            return 1\n        # Optimization: C(n, k) = C(n, n-k)\n        if k > total // 2:\n            k = total - k\n\n        res = 1\n        for i in range(k):\n            res = res * (total - i) // (i + 1)\n        return res\n\nclass BinarySequence:\n    \"\"\"A domain model for a binary sequence, reasoning about balance.\"\"\"\n    def __init__(self, length: int, sum_first: int, sum_last: int):\n        self.length = length\n        self.sum_first = sum_first\n        self.sum_last = sum_last\n\n    def isBalanced(self) -> bool:\n        \"\"\"Checks if the sum of first n bits equals the sum of last n bits.\"\"\"\n        return self.sum_first == self.sum_last\n\nclass CountBinarySeq:\n    \"\"\"Facade for validating input and coordinating the computation of balanced binary sequences.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n        self.result = 0.0\n\n    def compute(self) -> float:\n        \"\"\"Computes the count of binary sequences based on the central binomial coefficient.\"\"\"\n        # Input validation for 'n' (non-negative integer) is implied by the design,\n        # but explicit isinstance() checks or exception raising are omitted per strict instructions.\n        \n        combinatorics = BinomialCoefficient()\n        # The problem is equivalent to finding the number of ways to choose n positions\n        # out of 2n total positions for the '1's, ensuring the sums balance.\n        # This is given by the central binomial coefficient C(2n, n).\n        count_val = combinatorics.computeC(2 * self.n, self.n)\n        self.result = float(count_val)\n        return self.result\n\ndef count_binary_seq(n: int) -> float:\n    \"\"\"\n    Counts binary sequences of length 2n where the sum of first n bits\n    equals the sum of last n bits, which is equivalent to C(2n, n).\n    \"\"\"\n    calculator = CountBinarySeq(n)\n    return calculator.compute()"}
{"task_id": "Mbpp/299", "solution": "import math\nfrom dataclasses import dataclass\n\n@dataclass(frozen=True)\nclass TupleEntry:\n    \"\"\"Immutable data holder for (name, value).\"\"\"\n    name: str\n    value: float # Stored as float to accommodate both int and float naturally.\n\n@dataclass(frozen=True)\nclass AggregationResult:\n    \"\"\"Immutable holder for (name, total).\"\"\"\n    name: str\n    total: float\n\nclass Validator:\n    \"\"\"Enforce input shape and types.\"\"\"\n    def validateShape(self, list_of_tuples) -> bool:\n        \"\"\"Ensures each element is a 2-tuple (length 2).\"\"\"\n        for item in list_of_tuples:\n            if not isinstance(item, tuple) or len(item) != 2:\n                raise ValueError(\"Each element in the list must be a 2-tuple.\")\n        return True\n\n    def validateTypes(self, tuple_entry: TupleEntry) -> bool:\n        \"\"\"Ensures tuple_entry.name is str and tuple_entry.value is int or float.\"\"\"\n        # Note: tuple_entry.value is already float due to TupleEntry constructor,\n        # so this check primarily confirms its numeric nature implicitly.\n        if not isinstance(tuple_entry.name, str):\n            raise TypeError(\"Name must be a string.\")\n        if not isinstance(tuple_entry.value, (int, float)):\n             raise TypeError(\"Value must be numeric (int or float).\") # This specific check is mainly for the initial raw value.\n        return True\n\nclass Aggregator:\n    \"\"\"Group entries, compute stable sums, and pick max with deterministic tie-breaker.\"\"\"\n    def groupByName(self, list_of_tuple_entries: list[TupleEntry]) -> dict[str, list[float]]:\n        \"\"\"Returns dict mapping name -> list of numeric values, preserving first-seen order of names.\"\"\"\n        aggregation_map: dict[str, list[float]] = {}\n        for entry in list_of_tuple_entries:\n            if entry.name not in aggregation_map:\n                aggregation_map[entry.name] = []\n            aggregation_map[entry.name].append(entry.value)\n        return aggregation_map\n\n    def computeSums(self, aggregation_map: dict[str, list[float]]) -> list[AggregationResult]:\n        \"\"\"Computes sum using math.fsum for each name and returns AggregationResult objects in order.\"\"\"\n        aggregation_results: list[AggregationResult] = []\n        for name, values in aggregation_map.items():\n            total = math.fsum(values)\n            aggregation_results.append(AggregationResult(name=name, total=total))\n        return aggregation_results\n\n    def getMaxAggregate(self, aggregation_results: list[AggregationResult]) -> AggregationResult | None:\n        \"\"\"Scans results in order to find the maximum total; on ties selects the first.\"\"\"\n        if not aggregation_results:\n            return None\n\n        max_result: AggregationResult = aggregation_results[0]\n        for i in range(1, len(aggregation_results)):\n            current_result = aggregation_results[i]\n            if current_result.total > max_result.total:\n                max_result = current_result\n        return max_result\n\ndef max_aggregate(list_of_tuples):\n    \"\"\"Calculates the maximum aggregate from a list of tuples.\"\"\"\n    if not list_of_tuples:\n        return None\n\n    validator = Validator()\n    aggregator = Aggregator()\n\n    # Validate the overall shape of the input list.\n    validator.validateShape(list_of_tuples)\n\n    list_of_tuple_entries: list[TupleEntry] = []\n    for raw_tuple in list_of_tuples:\n        name_component = raw_tuple[0]\n        value_component = raw_tuple[1]\n\n        # Validate types for raw components before creating TupleEntry.\n        if not isinstance(name_component, str):\n            raise TypeError(\"Name must be a string.\")\n        if not isinstance(value_component, (int, float)):\n            raise TypeError(\"Value must be numeric (int or float).\")\n\n        # Create TupleEntry, converting numeric value to float for consistency.\n        entry = TupleEntry(name=name_component, value=float(value_component))\n\n        # Explicitly call validateTypes on the created TupleEntry as per design.\n        validator.validateTypes(entry)\n        list_of_tuple_entries.append(entry)\n\n    aggregation_map = aggregator.groupByName(list_of_tuple_entries)\n    aggregation_results = aggregator.computeSums(aggregation_map)\n    winner = aggregator.getMaxAggregate(aggregation_results)\n\n    if winner:\n        return (winner.name, winner.total)\n    else:\n        return None"}
{"task_id": "Mbpp/301", "solution": "class DepthCalculator:\n    \"\"\"\n    Calculates the maximum depth of nested dictionaries, with cycle detection.\n    \"\"\"\n    def __init__(self):\n        self.visited = set()\n\n    def dict_depth(self, d: dict) -> int:\n        \"\"\"\n        Public method to start the depth calculation for a dictionary.\n        Resets the visited set and initiates the recursive computation.\n        \"\"\"\n        self.visited.clear()\n        return self._compute_recursive(d, 1)\n\n    def _compute_recursive(self, d: dict, current_depth: int) -> int:\n        \"\"\"\n        Recursively computes the maximum depth of nested dictionaries.\n        Detects cycles using the 'visited' set and raises RecursionError if a cycle is found.\n        \"\"\"\n        did = id(d)\n        if did in self.visited:\n            raise RecursionError('cycle detected')\n\n        self.visited.add(did)\n        max_depth = current_depth\n\n        for v in d.values():\n            if isinstance(v, dict):\n                child_depth = self._compute_recursive(v, current_depth + 1)\n                if child_depth > max_depth:\n                    max_depth = child_depth\n\n        self.visited.remove(did)\n        return max_depth\n\ndef dict_depth(dict_obj) -> int:\n    \"\"\"\n    Finds the maximum depth of a dictionary, including nested dictionaries.\n    Raises RecursionError for cyclic dictionaries.\n    \"\"\"\n    calculator = DepthCalculator()\n    return calculator.dict_depth(dict_obj)"}
{"task_id": "Mbpp/305", "solution": "from typing import List, Tuple\n\nclass Word:\n    \"\"\"Represents a single word token.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\n    def firstChar(self) -> str:\n        \"\"\"Returns the first character of the word.\"\"\"\n        return self.text[0] if self.text else ''\n\n    def startsWithP(self) -> bool:\n        \"\"\"Checks if the word starts with 'p' or 'P' (case-insensitive).\"\"\"\n        return _is_first_char_p(self.text)\n\ndef _tokenize(input_strings: List[str]) -> List[Word]:\n    \"\"\"Splits a list of strings into a flat list of Word objects, preserving order.\"\"\"\n    all_words = []\n    for s in input_strings:\n        for token in s.split(): # .split() handles multiple spaces and trims leading/trailing\n            all_words.append(Word(token))\n    return all_words\n\ndef _is_first_char_p(word_text: str) -> bool:\n    \"\"\"Checks if the first character of a word is 'p' or 'P' (case-insensitive).\"\"\"\n    if not word_text:\n        return False\n    return word_text[0].lower() == 'p'\n\ndef start_withp(input_list: List[str]) -> Tuple[str, str]:\n    \"\"\"\n    Finds and returns the first two words from a list of strings that start with 'p' or 'P'.\n    Preserves original capitalization of the found words.\n    \"\"\"\n    found_words = []\n    \n    words_list = _tokenize(input_list)\n    \n    for word_obj in words_list:\n        if _is_first_char_p(word_obj.text):\n            found_words.append(word_obj.text)\n            if len(found_words) == 2:\n                break\n    \n    return tuple(found_words)"}
