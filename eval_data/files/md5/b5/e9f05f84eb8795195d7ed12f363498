{"task_id": "Mbpp/599", "solution": "class Parameter:\n    \"\"\"Encapsulates input n and validates (integer and n >= 1).\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n\n    def validate(self) -> bool:\n        \"\"\"Returns True if n is int and n >= 1, otherwise False.\"\"\"\n        return isinstance(self.n, int) and self.n >= 1\n\nclass Result:\n    \"\"\"Data holder for computed sum and average.\"\"\"\n    def __init__(self, sum: int, average: float):\n        self.sum = sum\n        self.average = average\n\nclass SumAverageFunction:\n    \"\"\"Computes Result (sum and average) for validated n.\"\"\"\n    def compute(self, n: int) -> Result:\n        \"\"\"Computes sum and average using formulas, returning a Result object.\"\"\"\n        s = n * (n + 1) // 2\n        avg = s / n\n        return Result(s, avg)\n\ndef sum_average(n: int) -> tuple[int, float]:\n    \"\"\"\n    Finds the sum and average of the first n natural numbers.\n    Raises ValueError for invalid input n.\n    \"\"\"\n    param = Parameter(n)\n    if not param.validate():\n        raise ValueError(\"Invalid input: n must be integer >= 1\")\n\n    result_obj = SumAverageFunction().compute(n)\n    return (result_obj.sum, result_obj.average)"}
{"task_id": "Mbpp/604", "solution": "def reverse_words(input: str) -> str:\n    \"\"\"\n    Reverses the order of words in a string, where words are separated by spaces.\n    Each word's characters are preserved.\n    \"\"\"\n    words = input.split(' ')\n    words.reverse()\n    return ' '.join(words)"}
{"task_id": "Mbpp/602", "solution": "from typing import Optional\n\n\ndef first_repeated_char(s: str) -> Optional[str]:\n    \"\"\"\n    Finds the first repeated character in a string.\n    Raises TypeError if the input is not a string.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n\n    seen_chars = set()\n    for char in s:\n        if char in seen_chars:\n            return char\n        seen_chars.add(char)\n    return None"}
{"task_id": "Mbpp/603", "solution": "from typing import List\nfrom src.ludic_generator import LudicGenerator\nfrom src.domain import InputParameter, ResultList\n\n\ndef get_ludic(n: int) -> List[int]:\n    \"\"\"\n    Generates all ludic numbers less than or equal to n.\n    It constructs an InputParameter and delegates the computation to LudicGenerator.\n    \"\"\"\n    input_param = InputParameter(n)\n    generator = LudicGenerator()\n    ludic_numbers = generator.generate(input_param.n)\n    return ludic_numbers"}
{"task_id": "Mbpp/605", "solution": "def prime_num(n: int) -> bool:\n    \"\"\"\n    Checks if the given integer is a prime number.\n    Returns True if n is prime, False otherwise.\n    \"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n\n    # Check for odd divisors from 3 up to sqrt(n)\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True"}
