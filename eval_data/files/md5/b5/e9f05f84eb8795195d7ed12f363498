{"task_id": "Mbpp/392", "solution": "class Cache:\n    \"\"\"In-memory cache for memoization.\"\"\"\n    def __init__(self) -> None:\n        self._entries: dict[int, int] = {}\n\n    def contains(self, n: int) -> bool:\n        \"\"\"Checks if n is in the cache.\"\"\"\n        return n in self._entries\n\n    def get(self, n: int) -> int:\n        \"\"\"Retrieves the cached value for n.\"\"\"\n        return self._entries[n]\n\n    def set(self, n: int, value: int) -> None:\n        \"\"\"Stores a value for n.\"\"\"\n        self._entries[n] = value\n\nclass MaxSumCalculator:\n    \"\"\"Calculates max sum f(n) with memoization.\"\"\"\n    def __init__(self, cache: Cache):\n        self._cache = cache\n\n    def get_max_sum(self, n: int) -> int:\n        \"\"\"Computes f(n) = max( (sum of f(n/k)), n) using memoization.\"\"\"\n        if self._cache.contains(n):\n            return self._cache.get(n)\n        \n        result = self._compute(n)\n        self._cache.set(n, result)\n        return result\n\n    def _compute(self, n: int) -> int:\n        \"\"\"Recursively computes f(n) and calls get_max_sum for subproblems.\"\"\"\n        if n == 0:\n            return 0\n        \n        a = n // 2\n        b = n // 3\n        c = n // 4\n        d = n // 5\n        \n        sa = self.get_max_sum(a)\n        sb = self.get_max_sum(b)\n        sc = self.get_max_sum(c)\n        sd = self.get_max_sum(d)\n        \n        ssum = sa + sb + sc + sd\n        return max(ssum, n)\n\ndef get_max_sum(n: int) -> int:\n    \"\"\"\n    Finds the maximum sum for f(n) = max( (f(n/2) + f(n/3) + f(n/4) + f(n/5)), n).\n    Memoization is used to optimize performance for recursive calls.\n    \"\"\"\n    cache = Cache()\n    calc = MaxSumCalculator(cache)\n    return calc.get_max_sum(n)"}
{"task_id": "Mbpp/395", "solution": "def _count_characters(input_string):\n    \"\"\"\n    Counts character occurrences in a string.\n    Returns a dictionary mapping each character to its total count.\n    \"\"\"\n    counts = {}\n    for char in input_string:\n        counts[char] = counts.get(char, 0) + 1\n    return counts\n\ndef first_non_repeating_character(input_string):\n    \"\"\"\n    Finds the first non-repeated character in a given string.\n    Returns the character (str of length 1) or None if no such character exists.\n    \"\"\"\n    char_counts = _count_characters(input_string)\n\n    for char in input_string:\n        if char_counts[char] == 1:\n            return char\n    return None"}
{"task_id": "Mbpp/398", "solution": "import math\nfrom typing import List\n\nclass Digit:\n    \"\"\"Value object representing a single decimal digit (0-9).\"\"\"\n    def __init__(self, value: int) -> None:\n        if not (0 <= value <= 9):\n            raise ValueError(\"Digit value must be between 0 and 9.\")\n        self.value = value\n\nclass IntegerItem:\n    \"\"\"Represents a single integer and decomposes it into digits.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def to_digits(self) -> List[Digit]:\n        \"\"\"Returns a list of Digit objects for the absolute value of the integer.\"\"\"\n        abs_value = abs(self.value)\n        if abs_value == 0:\n            return [Digit(0)]\n        \n        digits_list = []\n        temp_value = abs_value\n        while temp_value > 0:\n            digits_list.append(Digit(temp_value % 10))\n            temp_value //= 10\n        return digits_list[::-1] # Reverse to get correct order\n\nclass IntegerList:\n    \"\"\"Container for IntegerItem objects and performs initial input validation.\"\"\"\n    def __init__(self, raw_list: list) -> None:\n        if not isinstance(raw_list, list):\n            raise TypeError(\"Input must be a list.\")\n        self.items: List[IntegerItem] = []\n        for item in raw_list:\n            if not isinstance(item, int):\n                raise TypeError(\"List elements must be integers.\")\n            self.items.append(IntegerItem(item))\n\nclass Result:\n    \"\"\"Container for the final aggregated integer result.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass SumOfDigits:\n    \"\"\"Encapsulates the algorithm to compute the sum of digits.\"\"\"\n    def compute(self, input_list: list) -> int:\n        \"\"\"Iterates through items, decomposes into digits, and accumulates the sum.\"\"\"\n        integer_list = IntegerList(input_list)\n        total_sum = 0\n        for item in integer_list.items:\n            for digit in item.to_digits():\n                total_sum += digit.value\n        return Result(total_sum).value\n\ndef sum_of_digits(input_list: list) -> int:\n    \"\"\"\n    Computes the sum of digits of each number in a given list.\n    Negative numbers are processed using their absolute value.\n    \"\"\"\n    computer = SumOfDigits()\n    return computer.compute(input_list)"}
