{"task_id": "Mbpp/474", "solution": "class StringEntity:\n    \"\"\"Encapsulates an input string.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n\n    def length(self) -> int:\n        return len(self._value)\n\n    def charAt(self, index: int) -> str:\n        \"\"\"Returns the character at the specified index.\"\"\"\n        return self._value[index]\n\nclass Character:\n    \"\"\"Encapsulates a single character.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n\n    def isEqual(self, other: 'Character') -> bool:\n        \"\"\"Compares this character to another character.\"\"\"\n        return self._value == other._value\n\nclass OutputString:\n    \"\"\"Encapsulates the resulting string.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\nclass ReplaceCharService:\n    \"\"\"Service to perform character replacement based on domain objects.\"\"\"\n    def replace_char(self, input_str: str, target_char: str, replacement_char: str) -> str:\n        input_entity = StringEntity(input_str)\n        target_char_obj = Character(target_char)\n\n        is_target_present = False\n        for i in range(input_entity.length()):\n            current_char_obj = Character(input_entity.charAt(i))\n            if current_char_obj.isEqual(target_char_obj):\n                is_target_present = True\n                break\n\n        if not is_target_present:\n            return input_str\n\n        result_chars = []\n        for i in range(input_entity.length()):\n            current_char_str = input_entity.charAt(i)\n            current_char_obj = Character(current_char_str)\n\n            if current_char_obj.isEqual(target_char_obj):\n                result_chars.append(replacement_char)\n            else:\n                result_chars.append(current_char_str)\n\n        output_str_value = \"\".join(result_chars)\n        output_entity = OutputString(output_str_value)\n        return output_entity.value\n\ndef replace_char(input: str, target: str, replacement: str) -> str:\n    \"\"\"Replaces all occurrences of a target character with a replacement character in a string.\"\"\"\n    service = ReplaceCharService()\n    return service.replace_char(input, target, replacement)"}
{"task_id": "Mbpp/476", "solution": "def big_sum(array):\n    \"\"\"\n    Finds the sum of the largest and smallest value in a given array.\n    Includes comprehensive input validation and handles edge cases.\n    \"\"\"\n    if not isinstance(array, list):\n        raise TypeError(\"Input must be a list.\")\n\n    if not array:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    for element in array:\n        # Per design, bool is treated as non-numeric\n        if not isinstance(element, (int, float)) or isinstance(element, bool):\n            raise TypeError(\"All elements in the list must be numeric (int or float).\")\n\n    if len(array) == 1:\n        return 2 * array[0]\n    else:\n        min_val = min(array)\n        max_val = max(array)\n        return min_val + max_val"}
{"task_id": "Mbpp/479", "solution": "class IntegerInput:\n    \"\"\"Encapsulates an integer input and provides derived queries.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def isSingleDigit(self) -> bool:\n        \"\"\"Returns True if the absolute value of the number is a single digit.\"\"\"\n        return abs(self.value) <= 9\n\n    def absoluteValue(self) -> int:\n        \"\"\"Returns the absolute value of the number.\"\"\"\n        return abs(self.value)\n\nclass DigitResult:\n    \"\"\"Container for the computed first digit.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\ndef first_Digit(n: int) -> int:\n    \"\"\"Finds the first digit of a given integer number, ignoring its sign.\"\"\"\n    inp = IntegerInput(n)\n    magnitude = inp.absoluteValue()\n\n    if inp.isSingleDigit():\n        return DigitResult(magnitude).value\n    else:\n        # For multi-digit numbers, repeatedly divide by 10 until it's a single digit.\n        while magnitude >= 10:\n            magnitude //= 10\n        return DigitResult(magnitude).value"}
{"task_id": "Mbpp/478", "solution": "def remove_lowercase(s: str) -> str:\n    \"\"\"Validate type of s (must be str) and return a new string with every contiguous substring composed only of ASCII lowercase letters (a-z) removed.\n\n    Raises:\n      TypeError: if s is not an instance of str.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n\n    result_chars = []\n    for char in s:\n        # Check if the character is an ASCII lowercase letter\n        if not ('a' <= char <= 'z'):\n            result_chars.append(char)\n    return ''.join(result_chars)"}
{"task_id": "Mbpp/554", "solution": "\n# Helper class for accumulating results.\nclass ResultList:\n    def __init__(self) -> None:\n        self.items = []\n\n    def append(self, value: int) -> None:\n        self.items.append(value)\n\n    def length(self) -> int:\n        return len(self.items)\n\n    def to_list(self) -> list:\n        return list(self.items)\n\n# Helper class for iterating over input.\nclass IntegerList:\n    def __init__(self, items: list) -> None:\n        self.items = items\n\n    def length(self) -> int:\n        return len(self.items)\n\n    def iterator(self):\n        \"\"\"Returns an iterator for the internal list of items.\"\"\"\n        return iter(self.items)\n\n# Core logic for splitting the list.\nclass SplitFunction:\n    def execute(self, input: list) -> list:\n        \"\"\"Filters a list to return only odd integers, preserving order.\"\"\"\n        self.validate_input(input)\n        \n        integer_list = IntegerList(input)\n        result_list = ResultList()\n\n        for item in integer_list.iterator():\n            if item % 2 != 0:\n                result_list.append(item)\n        \n        return result_list.to_list()\n\n    def validate_input(self, input: list) -> bool:\n        \"\"\"Validates that the input is a list, raising TypeError if not.\"\"\"\n        if not isinstance(input, list):\n            raise TypeError(\"Input must be a Python list.\")\n        return True\n\ndef Split(input_list: list) -> list:\n    \"\"\"\n    Takes a list of integers and returns a new list containing only the odd ones.\n    It preserves the relative order of the odd integers from the input list.\n    \"\"\"\n    splitter = SplitFunction()\n    return splitter.execute(input_list)"}
{"task_id": "Mbpp/555", "solution": "def sum_of_naturals(n: int) -> int:\n    \"\"\"Calculates the sum of the first n natural numbers.\"\"\"\n    return n * (n + 1) // 2\n\ndef sum_of_cubes(n: int) -> int:\n    \"\"\"Calculates the sum of the cubes of the first n natural numbers.\"\"\"\n    sum_n = sum_of_naturals(n)\n    return sum_n * sum_n\n\ndef difference(n: int) -> int:\n    \"\"\"\n    Finds the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"n must be a positive integer\")\n\n    cubes_sum = sum_of_cubes(n)\n    naturals_sum = sum_of_naturals(n)\n    return cubes_sum - naturals_sum"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(arr, n):\n    \"\"\"\n    Counts the number of unordered pairs (i, j) with 0 <= i < j < n\n    for which arr[i] XOR arr[j] is odd.\n    \"\"\"\n    if n < 2:\n        return 0\n\n    even_count = 0\n    odd_count = 0\n\n    for i in range(n):\n        if arr[i] % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return even_count * odd_count"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input: str) -> str:\n    \"\"\"\n    Toggles the case of all alphabetic characters in a string.\n    Non-alphabetic characters remain unchanged.\n    \"\"\"\n    if not input:\n        return \"\"\n\n    result_chars = []\n    for char in input:\n        if char.isalpha():\n            if char.isupper():\n                result_chars.append(char.lower())\n            else:  # char is alphabetic and not uppercase, so it's lowercase or titlecase\n                result_chars.append(char.upper())\n        else:\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/558", "solution": "class Digit:\n    \"\"\"Data holder for a single digit with position and value.\"\"\"\n    def __init__(self, position: int, value: int):\n        self.position = position\n        self.value = value\n\nclass DigitPair:\n    \"\"\"Holds two Digit instances and computes their absolute difference.\"\"\"\n    def __init__(self, d1: 'Digit', d2: 'Digit'):\n        self.d1 = d1\n        self.d2 = d2\n\n    def abs_difference(self) -> int:\n        \"\"\"Returns the absolute difference between the values of the two digits.\"\"\"\n        return abs(self.d1.value - self.d2.value)\n\nclass IntegerNumber:\n    \"\"\"Represents an integer and provides LSB-first digit extraction.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def get_digits(self) -> list:\n        \"\"\"Extracts and returns the LSB-first digits of the absolute value.\"\"\"\n        n = abs(self.value)\n        if n == 0:\n            return [0]\n        digits = []\n        while n > 0:\n            digits.append(n % 10)\n            n //= 10\n        return digits\n\nclass CalculationResult:\n    \"\"\"Encapsulates the final total distance.\"\"\"\n    def __init__(self, total_distance: int):\n        self.total_distance = total_distance\n\nclass DigitDistanceCalculator:\n    \"\"\"Coordinates computation of the sum of per-digit absolute differences.\"\"\"\n    def digit_distance_nums(self, a: int, b: int) -> int:\n        num_a = IntegerNumber(a)\n        num_b = IntegerNumber(b)\n\n        digits_a = num_a.get_digits()\n        digits_b = num_b.get_digits()\n\n        max_len = max(len(digits_a), len(digits_b))\n        total_distance = 0\n\n        for i in range(max_len):\n            digit_val_a = digits_a[i] if i < len(digits_a) else 0\n            digit_val_b = digits_b[i] if i < len(digits_b) else 0\n\n            d1 = Digit(i, digit_val_a)\n            d2 = Digit(i, digit_val_b)\n            \n            pair = DigitPair(d1, d2)\n            total_distance += pair.abs_difference()\n        \n        result = CalculationResult(total_distance)\n        return result.total_distance\n\ndef digit_distance_nums(a: int, b: int) -> int:\n    \"\"\"\n    Calculates the sum of per-digit absolute differences between two integers,\n    aligning digits by LSB and treating missing digits as 0.\n    \"\"\"\n    calculator = DigitDistanceCalculator()\n    return calculator.digit_distance_nums(a, b)"}
{"task_id": "Mbpp/560", "solution": "def union_elements(t1: tuple, t2: tuple) -> tuple:\n    \"\"\"Compute sorted union of two tuples and return as a tuple.\n\n    Returns:\n    - tuple: sorted tuple of unique elements from t1 and t2\n    \"\"\"\n    unique = set(t1) | set(t2)\n    sorted_list = sorted(unique)\n    return tuple(sorted_list)"}
{"task_id": "Mbpp/562", "solution": "def Find_Max_Length(input_list):\n    \"\"\"\n    Finds the length of the longest sublist within a list of sublists.\n    Iterates through each sublist and keeps track of the maximum length found.\n    \"\"\"\n    max_len = 0\n    for sublist in input_list:\n        if len(sublist) > max_len:\n            max_len = len(sublist)\n    return max_len"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(numbers: list[int], length_param: int) -> int:\n    \"\"\"\n    Computes the sum of the largest contiguous sublist using Kadane's algorithm.\n    Returns 0 for an empty input list.\n    \"\"\"\n    if not numbers:\n        return 0\n\n    max_so_far = numbers[0]\n    current_max = numbers[0]\n\n    for i in range(1, len(numbers)):\n        current_max = max(numbers[i], current_max + numbers[i])\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
{"task_id": "Mbpp/563", "solution": "from typing import List\n\ndef extract_values(input: str) -> List[str]:\n    \"\"\"\n    Extracts values enclosed in double quotation marks from a string.\n    Each extracted value is stripped of leading/trailing whitespace.\n    \"\"\"\n    extracted_values = []\n    in_quote = False\n    start_index = -1\n\n    for i, char in enumerate(input):\n        if char == '\"':\n            if not in_quote:\n                # Found an opening double quote\n                in_quote = True\n                start_index = i + 1\n            else:\n                # Found a closing double quote\n                in_quote = False\n                if start_index != -1:\n                    # Extract the substring between the quotes\n                    value = input[start_index:i]\n                    extracted_values.append(value.strip())\n                start_index = -1  # Reset for the next potential value\n\n    return extracted_values"}
