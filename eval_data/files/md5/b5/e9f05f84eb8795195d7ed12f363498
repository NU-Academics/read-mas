{"task_id": "Mbpp/453", "solution": "from typing import List\n\nclass Number:\n    \"\"\"Represents an input number.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass Factor:\n    \"\"\"Represents a positive divisor and provides an evenness check.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def isEven(self) -> bool:\n        \"\"\"Checks if the factor's value is even.\"\"\"\n        return self.value % 2 == 0\n\nclass EvenFactorFilter:\n    \"\"\"Encapsulates the logic to determine whether a divisor is even.\"\"\"\n    def isEven(self, factor: int) -> bool:\n        \"\"\"Returns True if the given factor is even, False otherwise.\"\"\"\n        return factor % 2 == 0\n\nclass FactorizationEngine:\n    \"\"\"Enumerates all positive divisors of an integer.\"\"\"\n    def divisors(self, n: int) -> List[int]:\n        \"\"\"Returns a list of all positive divisors of n.\"\"\"\n        divs = set()\n        if n <= 0: # Handle non-positive numbers; no positive divisors\n            return []\n        \n        i = 1\n        while i * i <= n:\n            if n % i == 0:\n                divs.add(i)\n                divs.add(n // i)\n            i += 1\n        return list(divs)\n\nclass SumCalculator:\n    \"\"\"Orchestrates factor enumeration, filtering, and summation.\"\"\"\n    def __init__(self, factor_engine: 'FactorizationEngine' | None = None, filter: 'EvenFactorFilter' | None = None) -> None:\n        self.factor_engine = factor_engine if factor_engine is not None else FactorizationEngine()\n        self.filter = filter if filter is not None else EvenFactorFilter()\n\n    def sumofFactors(self, n: int) -> int:\n        \"\"\"Computes the sum of even positive factors of n.\"\"\"\n        all_divisors = self.factor_engine.divisors(n)\n        even_factors_sum = 0\n        for divisor in all_divisors:\n            if self.filter.isEven(divisor):\n                even_factors_sum += divisor\n        return even_factors_sum\n\ndef sumofFactors(n: int) -> int:\n    \"\"\"Finds the sum of even factors of a number.\"\"\"\n    calculator = SumCalculator()\n    return calculator.sumofFactors(n)"}
{"task_id": "Mbpp/457", "solution": "def Find_Min(input_list):\n    \"\"\"\n    Finds the sublist with the minimum length from a list of sublists.\n    If multiple sublists have the same minimum length, the first one encountered is returned.\n    \"\"\"\n    min_sublist = input_list[0]\n    min_length = len(input_list[0])\n\n    for sublist in input_list[1:]:\n        current_length = len(sublist)\n        if current_length < min_length:\n            min_length = current_length\n            min_sublist = sublist\n            if min_length == 0:  # Optimization: length 0 is the absolute minimum\n                return min_sublist\n    return min_sublist"}
{"task_id": "Mbpp/455", "solution": "class Month:\n    \"\"\"Represents a month number and provides 31-day check.\"\"\"\n    def __init__(self, number: int):\n        self._number = number\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if the internal number is an integer.\"\"\"\n        return isinstance(self._number, int)\n\n    def has_31_days(self) -> bool:\n        \"\"\"Determines if the month has 31 days.\"\"\"\n        return self._number in {1, 3, 5, 7, 8, 10, 12}\n\nclass Result:\n    \"\"\"Encapsulates the boolean outcome of a 31-day check.\"\"\"\n    def __init__(self, has31: bool):\n        self._has31 = has31\n\n    def value(self) -> bool:\n        \"\"\"Returns the boolean result.\"\"\"\n        return self._has31\n\nclass MonthChecker:\n    \"\"\"Service class for checking month properties.\"\"\"\n    def check_monthnumb_number(self, month: int) -> bool:\n        \"\"\"Checks if the given month number has 31 days.\"\"\"\n        month_obj = Month(month)\n        has_31_days_result = month_obj.has_31_days()\n        result_obj = Result(has_31_days_result)\n        return result_obj.value()\n\ndef check_monthnumb_number(month):\n    \"\"\"Checks if the given month number has 31 days.\"\"\"\n    checker = MonthChecker()\n    return checker.check_monthnumb_number(month)"}
{"task_id": "Mbpp/456", "solution": "from typing import List\n\ndef reverse_string_list(input: List[str]) -> List[str]:\n    \"\"\"Reverses each string in a given list of string values.\"\"\"\n\n    # Domain model classes, defined inline to satisfy \"no helper not defined inline\" constraint.\n    # StringItem represents an individual string, its position, and its reversed form.\n    class StringItem:\n        def __init__(self, value: str, position: int):\n            self.value = value\n            self.position = position\n            self.reversed_value = value[::-1]\n\n    # StringList is a container for the input StringItem instances.\n    class StringList:\n        def __init__(self, items: List[str]):\n            self.items = [StringItem(item, i) for i, item in enumerate(items)]\n\n    # OutputList is a container for the resulting list of reversed strings.\n    class OutputList:\n        def __init__(self, items: List[str]):\n            self.items = items # These items are already the reversed string values\n\n    # ReverseStringList encapsulates the core reversal algorithm.\n    class ReverseStringList:\n        def reverse(self, input_list: List[str]) -> List[str]:\n            # Consume the plain Python list into the domain model StringList.\n            string_list = StringList(input_list)\n            \n            # Extract the pre-computed reversed values from StringItem instances.\n            reversed_values = [item.reversed_value for item in string_list.items]\n            \n            # Produce the output list in the domain model OutputList.\n            output_list = OutputList(reversed_values)\n            \n            # Return the plain Python list of reversed strings.\n            return output_list.items\n\n    # Delegate the actual reversal operation to an instance of the inline ReverseStringList.\n    reverser = ReverseStringList()\n    return reverser.reverse(input)"}
{"task_id": "Mbpp/459", "solution": "def _is_ascii_upper(ch: str) -> bool:\n    \"\"\"Checks if a character is an ASCII uppercase letter.\"\"\"\n    return 'A' <= ch <= 'Z'\n\ndef remove_uppercase(input: str) -> str:\n    \"\"\"Removes all ASCII uppercase letters from the input string.\"\"\"\n    result_chars = []\n    for char in input:\n        if not _is_ascii_upper(char):\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
