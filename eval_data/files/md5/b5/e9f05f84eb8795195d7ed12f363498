{"task_id": "Mbpp/96", "solution": "import math\n\ndef divisor(n: int) -> int:\n    \"\"\"Return the number of positive integer divisors of n.\n\n    For negative n, counts divisors of abs(n); for n == 0, returns 0.\n    \"\"\"\n    if n == 0:\n        return 0\n    \n    m = abs(n)\n    count = 0\n    # Iterate from 1 up to the square root of m\n    for i in range(1, int(math.sqrt(m)) + 1):\n        if m % i == 0:\n            # If i is a divisor, then m/i is also a divisor\n            if i * i == m:  # Perfect square, count only once\n                count += 1\n            else:  # Two distinct divisors\n                count += 2\n    return count"}
{"task_id": "Mbpp/97", "solution": "from typing import Any, List, Dict\n\nclass InputListOfLists:\n    \"\"\"Helper for validating that the input is a list of lists.\"\"\"\n    def __init__(self, lists: List[List[Any]]):\n        self.lists = lists\n\n    def validate(self) -> bool:\n        \"\"\"Validates if the top-level input is a list and each element is a list.\"\"\"\n        if not isinstance(self.lists, list):\n            return False\n        for sublist in self.lists:\n            if not isinstance(sublist, list):\n                return False\n        return True\n\nclass FlattenedSequence:\n    \"\"\"Helper for flattening a list of lists into a single sequence.\"\"\"\n    def __init__(self):\n        self.elements: List[Any] = []\n\n    def flatten(self, lists: List[List[Any]]) -> List[Any]:\n        \"\"\"Flattens a list of lists into a single ordered list and returns it.\"\"\"\n        for sublist in lists:\n            for item in sublist:\n                self.elements.append(item)\n        return self.elements\n\nclass FrequencyCounter:\n    \"\"\"Helper for counting the frequency of elements in a list.\"\"\"\n    def __init__(self):\n        self.counts: Dict[Any, int] = {}\n\n    def count(self, elements: List[Any]) -> Dict[Any, int]:\n        \"\"\"Counts the occurrences of each element in the given list.\"\"\"\n        for item in elements:\n            self.counts[item] = self.counts.get(item, 0) + 1\n        return self.counts\n\nclass FrequencyDictionary:\n    \"\"\"Helper for wrapping frequency counts into a dictionary.\"\"\"\n    def __init__(self, counts: Dict[Any, int]):\n        self.mapping = counts\n\n    def to_dict(self) -> Dict[Any, int]:\n        \"\"\"Returns the stored frequency counts as a plain dictionary.\"\"\"\n        return self.mapping\n\ndef frequency_lists(input: List[List[Any]]) -> dict:\n    \"\"\"\n    Finds the frequency of each element in a flattened list of lists, returned in a dictionary.\n    \"\"\"\n    validator = InputListOfLists(input)\n    if not validator.validate():\n        raise TypeError(\"input must be a list of lists\")\n    \n    flattener = FlattenedSequence()\n    elements = flattener.flatten(input)\n    \n    counter = FrequencyCounter()\n    counts = counter.count(elements)\n    \n    freq_dict = FrequencyDictionary(counts)\n    return freq_dict.to_dict()"}
{"task_id": "Mbpp/98", "solution": "def compute_product(sequence):\n    \"\"\"\n    Computes the product of numbers in a sequence and its length.\n    Ensures float product for accurate division.\n    \"\"\"\n    product = 1.0\n    length = 0\n    for num in sequence:\n        product *= num\n        length += 1\n    return product, length\n\ndef multiply_num(sequence):\n    \"\"\"\n    Multiplies all numbers in a sequence and divides by its length.\n    Expects a sequence of numbers (list or tuple).\n    \"\"\"\n    product, length = compute_product(sequence)\n    return product / length"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(n):\n    \"\"\"\n    Converts a non-negative decimal integer to its binary equivalent as a string.\n    Raises ValueError if the input is not a non-negative integer.\n    \"\"\"\n    # Input validation as per design context\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"decimal_to_binary: input must be a non-negative integer\")\n\n    # Special case for n = 0\n    if n == 0:\n        return '0'\n\n    # Conversion logic for n > 0\n    binary_digits = []\n    while n > 0:\n        remainder = n % 2\n        binary_digits.append(str(remainder))\n        n //= 2\n\n    # The digits are collected in reverse order, so reverse and join\n    return \"\".join(reversed(binary_digits))"}
{"task_id": "Mbpp/101", "solution": "class IndexParameter:\n    \"\"\"Represents and validates the index parameter k.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n    def is_integer(self) -> bool:\n        \"\"\"Return True if value is an integer type.\"\"\"\n        return isinstance(self.value, int)\n\n\nclass Validator:\n    \"\"\"Validates an IndexParameter against rules (is integer, and 1 <= k <= array_length).\"\"\"\n    @staticmethod\n    def validate_index_parameter(index_param: 'IndexParameter', array_length: int) -> None:\n        \"\"\"Raises ValueError if k is not an integer; raises IndexError if k is out of range.\"\"\"\n        if not index_param.is_integer():\n            raise ValueError(\"Index 'k' must be an integer.\")\n\n        k_val = index_param.value\n        if not (1 <= k_val <= array_length):\n            raise IndexError(f\"Index 'k' ({k_val}) is out of range for an array of length {array_length}.\")\n\n\nclass KthElementService:\n    \"\"\"Encapsulates logic to validate inputs and return the k-th element (1-based).\"\"\"\n    def kth_element(self, array, k):\n        \"\"\"Validates inputs and returns the element at 1-based index k.\"\"\"\n        array_length = len(array)\n        index_param = IndexParameter(k)\n        Validator.validate_index_parameter(index_param, array_length)\n        return array[k - 1]\n\n\ndef kth_element(array, k):\n    \"\"\"Return element at 1-based index k from array or raise ValueError / IndexError per FR-6.\"\"\"\n    service = KthElementService()\n    return service.kth_element(array, k)"}
{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome of a specified integer, returned as an integer.\n    It increments n and checks for palindromic property.\n    \"\"\"\n    candidate = n + 1\n    while True:\n        s_candidate = str(candidate)\n        if s_candidate == s_candidate[::-1]:\n            return candidate\n        candidate += 1"}
{"task_id": "Mbpp/102", "solution": "def snake_to_camel(input: str) -> str:\n    \"\"\"Convert snake_case string `input` to CamelCase and return it as a string.\n\n    Splits on underscore, capitalizes the first letter of each part, and concatenates them.\n    \"\"\"\n    parts = input.split('_')\n    capitalized = [p[:1].upper() + p[1:] if p else '' for p in parts]\n    return ''.join(capitalized)"}
{"task_id": "Mbpp/104", "solution": "from typing import Iterable, List, Sequence\n\ndef sort_sublists(iterable_of_sublists: Iterable[Sequence[str]]) -> List[List[str]]:\n    \"\"\"\n    Sorts each sublist of strings in a given list of lists lexicographically.\n    Returns a new list of lists with sorted sublists.\n    \"\"\"\n    return [sorted(list(sublist)) for sublist in iterable_of_sublists]"}
{"task_id": "Mbpp/103", "solution": "class InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid inputs to Eulerian number computation.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass EulerianCalculator:\n    \"\"\"\n    Computes Eulerian numbers a(n, m) using memoized recursion.\n    Handles input validation and exact integer arithmetic.\n    \"\"\"\n    def __init__(self):\n        self._cache = {}\n\n    def validate(self, n: int, m: int) -> bool:\n        \"\"\"Validates inputs (n, m) against defined constraints.\"\"\"\n        if not isinstance(n, int) or not isinstance(m, int):\n            raise InvalidInputError(\"Inputs n and m must be integers.\")\n        if n < 1:\n            raise InvalidInputError(\"Input n must be a positive integer (n >= 1).\")\n        if m < 0 or m >= n:\n            raise InvalidInputError(\"Input m must satisfy 0 <= m < n.\")\n        return True\n\n    def _compute_eulerian(self, n: int, m: int) -> int:\n        \"\"\"Recursively computes a(n, m) with memoization for valid intermediate states.\"\"\"\n        if m < 0 or m >= n:\n            return 0\n        if n == 1 and m == 0:\n            return 1\n\n        if (n, m) in self._cache:\n            return self._cache[(n, m)]\n\n        term1 = (m + 1) * self._compute_eulerian(n - 1, m)\n        term2 = (n - m) * self._compute_eulerian(n - 1, m - 1)\n        result = term1 + term2\n\n        self._cache[(n, m)] = result\n        return result\n\n    def eulerian_num(self, n: int, m: int) -> int:\n        \"\"\"Public method to compute the Eulerian number a(n, m) with validation.\"\"\"\n        self.validate(n, m)\n        return self._compute_eulerian(n, m)\n\n_calculator = EulerianCalculator()\n\ndef eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Computes the Eulerian number a(n, m) using a memoized recursive approach.\n    Raises InvalidInputError if inputs are not valid integers or outside the specified range.\n    \"\"\"\n    return _calculator.eulerian_num(n, m)"}
{"task_id": "Mbpp/105", "solution": "def count(items: list) -> int:\n    \"\"\"Return the number of elements in 'items' that are exactly the boolean True.\"\"\"\n    true_count = 0\n    for item in items:\n        if item is True:\n            true_count += 1\n    return true_count"}
{"task_id": "Mbpp/106", "solution": "def add_lists(input_list, input_tuple):\n    \"\"\"Appends elements of a list to a tuple, returning a new tuple.\"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"first argument must be a list\")\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"second argument must be a tuple\")\n\n    return input_tuple + tuple(input_list)"}
{"task_id": "Mbpp/111", "solution": "def common_in_nested_lists(nested_lists):\n    \"\"\"Return a list of elements that appear in every inner list of nested_lists.\n\n    Parameters:\n      nested_lists (list): A list whose elements are inner lists (list of lists).\n\n    Returns:\n      list: Unique elements present in every inner list; empty list if none.\n    \"\"\"\n    if not nested_lists:\n        return []\n\n    # Initialize common_elements with the set of the first inner list\n    common_elements = set(nested_lists[0])\n\n    # Iterate through the rest of the inner lists and find the intersection\n    for i in range(1, len(nested_lists)):\n        common_elements = common_elements.intersection(set(nested_lists[i]))\n        # If common_elements becomes empty at any point, no further intersection is needed\n        if not common_elements:\n            break\n\n    return list(common_elements)"}
{"task_id": "Mbpp/108", "solution": "from typing import List\n\ndef merge_sorted_list(list1: List[int], list2: List[int], list3: List[int]) -> List[int]:\n    \"\"\"\n    Merges three lists of integers into a single sorted list.\n    The resulting list will be sorted in ascending order and preserve duplicates.\n    \"\"\"\n    merged_list = list1 + list2 + list3\n    merged_list.sort()\n    return merged_list"}
{"task_id": "Mbpp/113", "solution": "import re\n\ndef _matches_pattern(s: str) -> bool:\n    \"\"\"Return True if s exactly matches the ASCII-digit pattern with optional leading sign; internal use only.\"\"\"\n    # Pattern: optional '+' or '-' at the start, followed by one or more digits, and nothing else.\n    return re.fullmatch(r\"^[+-]?\\d+$\", s) is not None\n\ndef check_integer(s: str) -> bool:\n    \"\"\"Return True if s matches optional '+'|'-' followed by 1+ ASCII digits; otherwise False.\"\"\"\n    return _matches_pattern(s)"}
