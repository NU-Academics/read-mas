{"task_id": "Mbpp/428", "solution": "from typing import List\n\ndef shell_sort(array: List[int]) -> List[int]:\n    \"\"\"\n    Sorts a list of integers using the Shell sort algorithm in non-decreasing order.\n    Returns a new list containing the sorted elements.\n    \"\"\"\n    n = len(array)\n    if n <= 1:\n        return list(array)  # Return a copy for consistency with \"new list\"\n\n    # Make a copy of the array to avoid modifying the original\n    arr = list(array)\n\n    # Start with a large gap, then reduce the gap\n    gap = n // 2\n    while gap > 0:\n        # Perform a gapped insertion sort for the current gap size\n        for i in range(gap, n):\n            temp = arr[i]\n            j = i\n            # Shift earlier gap-sorted elements up until the correct position for arr[i] is found\n            while j >= gap and arr[j - gap] > temp:\n                arr[j] = arr[j - gap]\n                j -= gap\n            # Put temp (the original arr[i]) in its correct location\n            arr[j] = temp\n        gap //= 2\n    return arr"}
{"task_id": "Mbpp/429", "solution": "class LengthMismatchError(Exception):\n    \"\"\"Raised when input tuple lengths do not match.\"\"\"\n    pass\n\ndef validate_lengths(a: tuple, b: tuple) -> None:\n    \"\"\"Validates that input tuples a and b have equal lengths.\"\"\"\n    if len(a) != len(b):\n        raise LengthMismatchError(\"Input tuples must have equal lengths.\")\n\ndef validate_types(a: tuple, b: tuple) -> None:\n    \"\"\"Validates that inputs are tuples and contain only integers.\"\"\"\n    if not isinstance(a, tuple) or not isinstance(b, tuple):\n        raise TypeError(\"Inputs must be tuples.\")\n    if not all(isinstance(x, int) for x in a) or not all(isinstance(x, int) for x in b):\n        raise TypeError(\"All elements in input tuples must be integers.\")\n\ndef compute_elementwise_and(a: tuple[int], b: tuple[int]) -> tuple[int]:\n    \"\"\"Computes the elementwise bitwise-AND of two integer tuples.\"\"\"\n    return tuple(x & y for x, y in zip(a, b))\n\ndef and_tuples(a: tuple[int], b: tuple[int]) -> tuple[int]:\n    \"\"\"\n    Extracts the elementwise bitwise-AND from two given tuples of integers.\n    Raises LengthMismatchError if tuple lengths differ or TypeError for invalid types.\n    \"\"\"\n    validate_types(a, b)\n    validate_lengths(a, b)\n    return compute_elementwise_and(a, b)"}
