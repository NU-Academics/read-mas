{"task_id": "Mbpp/232", "solution": "from typing import Iterable, List, Union\n\ndef _select_n_largest(items: List[Union[int, float]], n: int) -> List[Union[int, float]]:\n    \"\"\"\n    Given a concrete sequence of numeric items and integer n (0 < n <= len(items)),\n    return a list containing the n largest items, preserving multiplicity.\n    Ordering of returned items is not significant.\n    \"\"\"\n    items.sort(reverse=True)\n    return items[:n]\n\ndef larg_nnum(input_list: Iterable[Union[int, float]], n: int) -> List[Union[int, float]]:\n    \"\"\"\n    Returns a list containing the n largest items from the input list.\n    \"\"\"\n    items = list(input_list)\n    list_length = len(items)\n\n    if n <= 0:\n        return []\n\n    if n >= list_length:\n        return items\n\n    return _select_n_largest(items, n)"}
{"task_id": "Mbpp/233", "solution": "import math\nfrom dataclasses import dataclass\n\nclass LateralSurfaceCalculator:\n    @staticmethod\n    def lateralsuface_cylinder(height, radius):\n        \"\"\"Calculates the lateral surface area of a cylinder.\"\"\"\n        return 2 * math.pi * float(radius) * float(height)\n\n@dataclass\nclass Cylinder:\n    height: float\n    radius: float\n    lateral_surface_area: float = 0.0\n\n    def compute_lateral_surface(self) -> float:\n        \"\"\"Computes and stores the lateral surface area for the cylinder instance.\"\"\"\n        self.lateral_surface_area = LateralSurfaceCalculator.lateralsuface_cylinder(self.height, self.radius)\n        return self.lateral_surface_area\n\n@dataclass\nclass TestCase:\n    expected: float\n    tolerance: float\n    assertion: str = \"\"\n\ndef lateralsuface_cylinder(height, radius):\n    \"\"\"Compute lateral surface area of a cylinder: 2 * pi * radius * height.\"\"\"\n    return LateralSurfaceCalculator.lateralsuface_cylinder(height, radius)"}
{"task_id": "Mbpp/235", "solution": "def even_bit_set_number(n: int) -> int:\n    \"\"\"\n    Sets all even-positioned bits of a given non-negative number to 1,\n    preserving odd-positioned bits.\n    \"\"\"\n    def generate_even_bit_mask(msb_1_based: int) -> int:\n        \"\"\"\n        Produces an integer mask with bit positions 2,4,6,... set to 1\n        for all positions <= msb_1_based (positions counted 1-based).\n        \"\"\"\n        mask = 0\n        for bit_pos_1_based in range(1, msb_1_based + 1):\n            if bit_pos_1_based % 2 == 0:\n                mask |= (1 << (bit_pos_1_based - 1))\n        return mask\n\n    if n == 0:\n        return 0\n\n    msb_1_based = n.bit_length()\n    even_mask = generate_even_bit_mask(msb_1_based)\n    return n | even_mask"}
{"task_id": "Mbpp/237", "solution": "from typing import List, Tuple, Dict\n\nclass NormalizedTuple:\n    \"\"\"Canonical ordered representation (first, second) with deterministic normalization.\"\"\"\n    def __init__(self, first: int, second: int):\n        self._first = first\n        self._second = second\n\n    @staticmethod\n    def normalize(a: int, b: int) -> 'NormalizedTuple':\n        \"\"\"Return NormalizedTuple(min(a,b), max(a,b)).\"\"\"\n        return NormalizedTuple(min(a, b), max(a, b))\n\n    def as_tuple(self) -> tuple:\n        \"\"\"Return (first, second) tuple for use as dict key.\"\"\"\n        return (self._first, self._second)\n\n    def __hash__(self) -> int:\n        return hash((self._first, self._second))\n\n    def __eq__(self, other: object) -> bool:\n        if not isinstance(other, NormalizedTuple):\n            return NotImplemented\n        return self._first == other._first and self._second == other._second\n\nclass OccurrenceCounter:\n    \"\"\"Maintain counts for observed NormalizedTuple keys.\"\"\"\n    def __init__(self):\n        self._counts: Dict[NormalizedTuple, int] = {}\n\n    def increment(self, key: NormalizedTuple) -> None:\n        \"\"\"Increment count for the provided normalized key.\"\"\"\n        self._counts[key] = self._counts.get(key, 0) + 1\n\n    def getCounts(self) -> Dict[NormalizedTuple, int]:\n        \"\"\"Return internal mapping of normalized tuple -> int counts.\"\"\"\n        return self._counts\n\nclass ResultDictionary:\n    \"\"\"Wrap final mapping and produce a plain dict with tuple keys and integer counts.\"\"\"\n    def __init__(self, mapping: Dict[NormalizedTuple, int]):\n        self._mapping = mapping\n\n    def to_dict(self) -> Dict[tuple, int]:\n        \"\"\"Return mapping as a plain dict with tuple keys (first, second) and integer counts.\"\"\"\n        result = {}\n        for normalized_key, count in self._mapping.items():\n            result[normalized_key.as_tuple()] = count\n        return result\n\ndef check_occurences(input_list: list) -> dict:\n    \"\"\"Accepts a list of 2-element tuples and returns a dict mapping normalized tuple keys to integer counts.\"\"\"\n    counter = OccurrenceCounter()\n    for tpl in input_list:\n        normalized_key = NormalizedTuple.normalize(tpl[0], tpl[1])\n        counter.increment(normalized_key)\n\n    final_counts = counter.getCounts()\n    result_builder = ResultDictionary(final_counts)\n    return result_builder.to_dict()"}
{"task_id": "Mbpp/239", "solution": "from typing import List\n\n# Internal helper classes as per design\n\nclass Parameters:\n    \"\"\"Lightweight container for input parameters m and n.\"\"\"\n    def __init__(self, m: int, n: int):\n        self.m = m\n        self.n = n\n\nclass Validator:\n    \"\"\"Validates parameters and element transitions per business rules.\"\"\"\n    @staticmethod\n    def validate_parameters(m: int, n: int) -> bool:\n        \"\"\"Checks if m and n are integers > 0. (Not used by public API due to 'DO NOT' instruction).\"\"\"\n        return m > 0 and n > 0\n\n    @staticmethod\n    def validate_element(prev: int, curr: int, m: int) -> bool:\n        \"\"\"Checks curr >= 2 * prev and 1 <= curr <= m.\"\"\"\n        return curr >= 2 * prev and 1 <= curr <= m\n\nclass SequenceElement:\n    \"\"\"Represents an element and its position in a sequence.\"\"\"\n    def __init__(self, value: int, position: int):\n        self.value = value\n        self.position = position\n\nclass Sequence:\n    \"\"\"Represents a sequence of integers.\"\"\"\n    def __init__(self, elements: List[int]):\n        self.elements = elements\n        self.length = len(elements)\n\nclass SequenceGenerator:\n    \"\"\"Computes the count of valid sequences using dynamic programming.\"\"\"\n    def generate(self, m: int, n: int) -> int:\n        \"\"\"\n        Calculates the number of sequences of length n following the rules\n        using a dynamic programming approach.\n        \"\"\"\n        # dp[i][j] = number of sequences of length i ending with j\n        # Table size: (n+1) rows, (m+1) columns\n        dp = [[0] * (m + 1) for _ in range(n + 1)]\n\n        # Base case: sequences of length 1\n        # Any number from 1 to m can be a sequence of length 1.\n        for num in range(1, m + 1):\n            dp[1][num] = 1\n\n        # Fill the DP table for lengths from 2 to n\n        for length in range(2, n + 1):\n            for current_num in range(1, m + 1):\n                # Iterate over possible previous elements\n                for prev_num in range(1, m + 1):\n                    # Use Validator to check if transition is valid\n                    if Validator.validate_element(prev_num, current_num, m):\n                        dp[length][current_num] += dp[length - 1][prev_num]\n\n        # The total count is the sum of all sequences of length n\n        total_count = sum(dp[n][num] for num in range(1, m + 1))\n        \n        return total_count\n\nclass Result:\n    \"\"\"Encapsulates the returned count.\"\"\"\n    def __init__(self, count: int):\n        self.count = count\n\n\ndef get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Finds the number of possible sequences of length n, such that each element\n    is a positive integer and is greater than or equal to twice the previous\n    element but less than or equal to m.\n    \"\"\"\n    # Per instructions \"DO NOT add isinstance() checks or raise exceptions for edge cases\",\n    # so input validation described in design is omitted from the public API function.\n    # It is assumed that m and n are positive integers.\n\n    generator = SequenceGenerator()\n    count = generator.generate(m, n)\n    return Result(count).count"}
