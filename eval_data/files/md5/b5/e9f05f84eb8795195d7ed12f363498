{"task_id": "Mbpp/763", "solution": "def find_min_diff(seq, n):\n    \"\"\"\n    Calculates the minimum absolute difference between any two elements among the first n elements of a sequence.\n    Assumes valid input: seq is a sequence of numbers, and n is an integer such that 2 <= n <= len(seq).\n    \"\"\"\n    # Extract the first n elements and convert to a list for in-place sorting\n    sub_seq = list(seq)[:n]\n\n    # Sort the sub-sequence to efficiently find the minimum difference between adjacent elements\n    sub_seq.sort()\n\n    min_diff = float('inf')\n\n    # Iterate through the sorted sub-sequence to find the minimum difference\n    for i in range(len(sub_seq) - 1):\n        diff = abs(sub_seq[i+1] - sub_seq[i])\n        if diff < min_diff:\n            min_diff = diff\n            # If the minimum difference is 0, we can return immediately as it's the smallest possible\n            if min_diff == 0:\n                return 0\n    return min_diff"}
{"task_id": "Mbpp/764", "solution": "class InputString:\n    \"\"\"Lightweight data-holder reflecting the input string.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\nclass DigitCountResult:\n    \"\"\"Lightweight data-holder for the digit count result.\"\"\"\n    def __init__(self, count: int):\n        self.count = count\n\nclass DigitCounter:\n    \"\"\"Encapsulates the digit counting algorithm.\"\"\"\n    \n    def number_ctr(self, input_string: str) -> DigitCountResult:\n        \"\"\"Entry method for the DigitCounter, returns a DigitCountResult.\"\"\"\n        actual_count = self._count_digits(input_string)\n        return DigitCountResult(actual_count)\n    \n    def _count_digits(self, input_string: str) -> int:\n        \"\"\"Counts characters '0'..'9' in input_string and returns int.\"\"\"\n        count = 0\n        for char in input_string:\n            if '0' <= char <= '9':\n                count += 1\n        return count\n\ndef number_ctr(input_string: str) -> int:\n    \"\"\"Public API: accepts a string and returns the number of decimal digits in that string.\"\"\"\n    counter_instance = DigitCounter()\n    result_object = counter_instance.number_ctr(input_string)\n    return result_object.count"}
{"task_id": "Mbpp/765", "solution": "class Error(Exception):\n    \"\"\"Custom exception for domain-specific errors.\"\"\"\n    def __init__(self, type: str, message: str):\n        self.type = type\n        self.message = message\n        super().__init__(f\"{type}: {message}\")\n\nclass PowerOfTwoChecker:\n    \"\"\"Provides utility to check if an integer is an exact power of two.\"\"\"\n    def is_power_of_two(self, x) -> bool:\n        \"\"\"Checks if a positive integer x is an exact power of two.\"\"\"\n        return x > 0 and (x & (x - 1)) == 0\n\nclass SequenceGenerator:\n    \"\"\"Generates the sequence of polite numbers.\"\"\"\n    def __init__(self):\n        self._powChecker = PowerOfTwoChecker()\n\n    def get_nth_polite(self, n) -> int:\n        \"\"\"Computes the nth polite number (1-based).\"\"\"\n        count = 0\n        current_num = 1\n        while count < n:\n            if not self._powChecker.is_power_of_two(current_num):\n                count += 1\n            if count == n:\n                return current_num\n            current_num += 1\n        return -1 # Should not be reached given n is validated as positive.\n\nclass InputValidator:\n    \"\"\"Encapsulates input validation logic for n.\"\"\"\n    def is_positive_integer(self, n) -> bool:\n        \"\"\"Checks if n is a positive integer.\"\"\"\n        return isinstance(n, int) and n > 0\n\n    def raise_invalid_input_error(self, n) -> None:\n        \"\"\"Raises an Error for invalid input n.\"\"\"\n        raise Error(\"InvalidInput\", \"n must be a positive integer > 0\")\n\nclass PoliteNumberService:\n    \"\"\"Coordinates validation and sequence generation for polite numbers.\"\"\"\n    def __init__(self):\n        self._validator = InputValidator()\n        self._seqGen = SequenceGenerator()\n\n    def is_polite(self, n) -> int:\n        \"\"\"Validates input and returns the nth polite number.\"\"\"\n        if not self._validator.is_positive_integer(n):\n            self._validator.raise_invalid_input_error(n)\n        return self._seqGen.get_nth_polite(n)\n\ndef is_polite(n) -> int:\n    \"\"\"Returns the nth polite number.\"\"\"\n    return PoliteNumberService().is_polite(n)"}
{"task_id": "Mbpp/766", "solution": "from typing import List, Any, Tuple\n\ndef pair_wise(lst: List[Any]) -> List[Tuple[Any, Any]]:\n    \"\"\"\n    Returns a list of all pairs of consecutive items in the given list.\n    Returns an empty list if the input list has less than two items.\n    \"\"\"\n    if len(lst) < 2:\n        return []\n\n    result_pairs: List[Tuple[Any, Any]] = []\n    for i in range(len(lst) - 1):\n        result_pairs.append((lst[i], lst[i+1]))\n\n    return result_pairs"}
{"task_id": "Mbpp/770", "solution": "\nclass InputParameter:\n    \"\"\"Encapsulates InputParameter and validation rules (enforce integer type and n >= 1).\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n\n    def validate(self) -> None:\n        \"\"\"Enforce that n is an integer and n >= 1, otherwise raise ValueError.\"\"\"\n        if not isinstance(self.n, int):\n            raise ValueError(\"n must be an integer.\")\n        if self.n < 1:\n            raise ValueError(\"n must be a positive integer (n >= 1).\")\n\nclass OddNumberSequence:\n    \"\"\"Generates the first n odd natural numbers (odd_k = 2*k - 1).\"\"\"\n    @staticmethod\n    def generate(n: int) -> list[int]:\n        \"\"\"Returns a list of the first n odd natural numbers.\"\"\"\n        return [2 * k - 1 for k in range(1, n + 1)]\n\nclass MathOps:\n    \"\"\"Provides numeric helpers for power and sum operations.\"\"\"\n    @staticmethod\n    def power(base: int, exponent: int) -> int:\n        \"\"\"Calculates base raised to the power of exponent.\"\"\"\n        return base ** exponent\n\n    @staticmethod\n    def sum(values: list[int]) -> int:\n        \"\"\"Calculates the sum of a list of integers.\"\"\"\n        return sum(values)\n\nclass ComputationResult:\n    \"\"\"Simple container for an integer result.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\ndef odd_num_sum(n: int) -> int:\n    \"\"\"\n    Finds the sum of the fourth power of the first n odd natural numbers.\n    Validates input and orchestrates calculation using helper classes.\n    \"\"\"\n    input_param = InputParameter(n)\n    input_param.validate()\n\n    odd_numbers = OddNumberSequence.generate(n)\n    \n    powered_numbers = []\n    for num in odd_numbers:\n        powered_numbers.append(MathOps.power(num, 4))\n    \n    total_sum = MathOps.sum(powered_numbers)\n    \n    result_obj = ComputationResult(total_sum)\n    return result_obj.value"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers, target):\n    \"\"\"\n    Counts the number of unordered pairs (i < j) in a list whose sum equals a target value.\n    Handles duplicate numbers correctly by counting pairs based on their distinct indices.\n    \"\"\"\n    num_counts = {}\n    for num in numbers:\n        num_counts[num] = num_counts.get(num, 0) + 1\n\n    count = 0\n    # Iterate through unique numbers to find complements and count pairs.\n    # Sorting keys helps avoid double-counting pairs like (a,b) and (b,a).\n    for num in sorted(num_counts.keys()):\n        complement = target - num\n\n        if complement == num:\n            # For pairs of identical numbers (e.g., target 4, num 2), use combinations.\n            # If there are 'n' occurrences of 'num', they form n * (n - 1) / 2 pairs.\n            n = num_counts[num]\n            count += n * (n - 1) // 2\n        elif complement > num:\n            # For pairs of different numbers (e.g., target 6, num 1, complement 5).\n            # We count num * complement occurrences. The condition complement > num ensures\n            # that each pair is counted only once (e.g., (1,5) but not (5,1)).\n            count += num_counts[num] * num_counts.get(complement, 0)\n            \n    return count"}
{"task_id": "Mbpp/769", "solution": "def Diff(list_a, list_b):\n    \"\"\"\n    Returns a list containing elements that are in list_a but not in list_b.\n    The result list is ordered with even numbers first, then odd numbers,\n    preserving their relative order from list_a.\n    \"\"\"\n    evens_diff = []\n    odds_diff = []\n    \n    for item in list_a:\n        if item not in list_b:\n            if item % 2 == 0:\n                evens_diff.append(item)\n            else:\n                odds_diff.append(item)\n                \n    return evens_diff + odds_diff"}
{"task_id": "Mbpp/771", "solution": "from typing import Optional\n\nclass Stack:\n    \"\"\"\n    A lightweight LIFO stack for characters.\n    It supports push, pop, peek, and checking if it's empty.\n    \"\"\"\n    def __init__(self):\n        self._items = []\n\n    def push(self, item: str) -> None:\n        self._items.append(item)\n\n    def pop(self) -> Optional[str]:\n        if not self.is_empty():\n            return self._items.pop()\n        return None\n\n    def peek(self) -> Optional[str]:\n        if not self.is_empty():\n            return self._items[-1]\n        return None\n\n    def is_empty(self) -> bool:\n        return len(self._items) == 0\n\n\nclass ExpressionChecker:\n    \"\"\"\n    Evaluates an expression string for bracket balance using a stack.\n    It recognizes parentheses, square brackets, and curly braces.\n    \"\"\"\n    def __init__(self):\n        self._opening_for_closing = {')': '(', ']': '[', '}': '{'}\n        self._opening_set = set(self._opening_for_closing.values())\n        self._closing_set = set(self._opening_for_closing.keys())\n\n    def check_expression(self, expr: str) -> bool:\n        stack = Stack()\n        for char in expr:\n            if char in self._opening_set:\n                stack.push(char)\n            elif char in self._closing_set:\n                top = stack.peek()\n                # If stack is empty or top does not match the expected opening bracket\n                if top is None or top != self._opening_for_closing[char]:\n                    return False\n                stack.pop()\n            # Characters not in _opening_set or _closing_set are ignored\n        return stack.is_empty()\n\n\ndef check_expression(expr: str) -> bool:\n    \"\"\"\n    Checks if the given expression has balanced brackets.\n    It delegates the balancing logic to an internal ExpressionChecker.\n    \"\"\"\n    checker = ExpressionChecker()\n    return checker.check_expression(expr)"}
{"task_id": "Mbpp/773", "solution": "from typing import Optional, Tuple\n\nclass OccurrenceResult:\n    \"\"\"Data holder for a matched substring and its 0-based start and end indices.\"\"\"\n    def __init__(self, matched_substring: str, start_index: int, end_index: int) -> None:\n        self.matched_substring = matched_substring\n        self.start_index = start_index\n        self.end_index = end_index\n\nclass OccurrenceSearcher:\n    \"\"\"Executes the substring search algorithm and produces OccurrenceResult or None.\"\"\"\n    def occurance_substring(self, source: str, pattern: str) -> Optional[OccurrenceResult]:\n        \"\"\"Finds the first (leftmost) occurrence of pattern in source.\"\"\"\n        start_index = source.find(pattern)\n        if start_index == -1:\n            return None\n        end_index = start_index + len(pattern)\n        return OccurrenceResult(pattern, start_index, end_index)\n\ndef occurance_substring(source: str, pattern: str) -> Optional[Tuple[str, int, int]]:\n    \"\"\"\n    Finds the occurrence and position of the leftmost substring within a string.\n    Returns (matched_substring, start_index, end_index) or None if no match.\n    \"\"\"\n    searcher = OccurrenceSearcher()\n    result = searcher.occurance_substring(source, pattern)\n    if result is not None:\n        return (result.matched_substring, result.start_index, result.end_index)\n    else:\n        return None"}
{"task_id": "Mbpp/772", "solution": "from typing import List\n\nclass InputString:\n    \"\"\"Data holder for the raw input string.\"\"\"\n    def __init__(self, raw: str) -> None:\n        self.raw = raw\n\nclass Word:\n    \"\"\"Token value object with a length helper.\"\"\"\n    def __init__(self, text: str) -> None:\n        self.text = text\n\n    def length(self) -> int:\n        \"\"\"Returns the character length of the word.\"\"\"\n        return len(self.text)\n\nclass OutputString:\n    \"\"\"Data holder for the final result string.\"\"\"\n    def __init__(self, result: str) -> None:\n        self.result = result\n\nclass StringProcessor:\n    \"\"\"Handles tokenization, filtering by length, and joining of words.\"\"\"\n    def remove_length(self, s: str, k: int) -> str:\n        \"\"\"Orchestrates tokenization, filtering, and joining to remove words of length k.\"\"\"\n        words = self.tokenize(s)\n        filtered_words = self.filterByLength(words, k)\n        result_string = self.join(filtered_words)\n        return result_string\n\n    def tokenize(self, s: str) -> List[Word]:\n        \"\"\"Splits the input string into Word objects based on runs of one or more spaces.\"\"\"\n        # s.split() without arguments handles splitting on any whitespace and removes empty strings.\n        return [Word(token) for token in s.split()]\n\n    def filterByLength(self, words: List[Word], k: int) -> List[Word]:\n        \"\"\"Filters out words whose character length is exactly k.\"\"\"\n        return [word for word in words if word.length() != k]\n\n    def join(self, words: List[Word]) -> str:\n        \"\"\"Joins Word objects with a single space, preserving order.\"\"\"\n        word_texts = [word.text for word in words]\n        return ' '.join(word_texts)\n\ndef remove_length(s: str, k: int) -> str:\n    \"\"\"Removes all words with k length from the given string.\"\"\"\n    processor = StringProcessor()\n    return processor.remove_length(s, k)"}
{"task_id": "Mbpp/775", "solution": "from typing import List\n\ndef is_odd(n: int) -> bool:\n    \"\"\"Internal helper: returns True if integer n is odd.\"\"\"\n    return (n % 2) != 0\n\ndef odd_position(lst: List[int]) -> bool:\n    \"\"\"Public API per SRS: odd_position(lst) -> bool\n    Checks if every element at an odd index (0-based) in the list is an odd integer.\n    \"\"\"\n    for i in range(1, len(lst), 2):\n        if not is_odd(lst[i]):\n            return False\n    return True"}
{"task_id": "Mbpp/777", "solution": "def _validate_input(lst: list) -> None:\n    \"\"\"Raise TypeError if lst is not a list; raise ValueError if any element is not an int.\"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"Input must be a list.\")\n    for element in lst:\n        if not isinstance(element, int):\n            raise ValueError(\"All elements in the list must be integers.\")\n\ndef find_sum(lst: list) -> int:\n    \"\"\"Compute and return the sum of distinct integers in lst.\"\"\"\n    _validate_input(lst)\n    unique_elements = set(lst)\n    return sum(unique_elements)"}
{"task_id": "Mbpp/780", "solution": "from typing import List, Tuple\nimport numbers\n\ndef find_combinations(tuples: List[Tuple[numbers.Number, numbers.Number]]) -> List[Tuple[numbers.Number, numbers.Number]]:\n    \"\"\"Compute ordered pairwise element-wise sums.\n    Input: list of 2-element numeric tuples (a,b).\n    Output: list of 2-element numeric tuples (a_i + a_j, b_i + b_j) for each i<j in input order.\n    \"\"\"\n    n = len(tuples)\n    if n < 2:\n        return []\n\n    result = []\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            sum_first = tuples[i][0] + tuples[j][0]\n            sum_second = tuples[i][1] + tuples[j][1]\n            result.append((sum_first, sum_second))\n            \n    return result"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list):\n    \"\"\"Return a list of lists where each sublist is a maximal run of consecutive equal elements from input_list.\n\n    Args:\n        input_list: a list (ordered collection) of elements. Elements are compared using == for grouping.\n\n    Returns:\n        list of lists: each inner list is a maximal run of consecutive equal elements; returns [] when input_list is empty.\n    \"\"\"\n    if not input_list:\n        return []\n\n    packed_list = []\n    current_group = [input_list[0]]\n\n    for i in range(1, len(input_list)):\n        if input_list[i] == current_group[-1]:\n            current_group.append(input_list[i])\n        else:\n            packed_list.append(current_group)\n            current_group = [input_list[i]]\n    \n    packed_list.append(current_group) # Append the last group after the loop finishes\n\n    return packed_list"}
{"task_id": "Mbpp/781", "solution": "def _is_even(count):\n    \"\"\"\n    Checks if a number is even.\n    \"\"\"\n    return count % 2 == 0\n\ndef _compute_positive_divisor_count(n):\n    \"\"\"\n    Computes the number of positive divisors for a given positive integer n.\n    Assumes n is a positive integer (>0).\n    \"\"\"\n    count = 0\n    # Iterate from 1 up to sqrt(n)\n    for i in range(1, int(n**0.5) + 1):\n        if n % i == 0:\n            if i * i == n:\n                count += 1\n            else:\n                count += 2\n    return count\n\ndef count_divisors(n):\n    \"\"\"\n    Checks whether the count of positive divisors for an integer is even.\n    Applies absolute value for negative inputs.\n    \"\"\"\n    n_abs = abs(n)\n    # Following the prompt's 'DO NOT' constraint for error handling,\n    # we proceed assuming n_abs is a valid input for divisor counting.\n    # If n_abs is 0, _compute_positive_divisor_count(0) will return 0.\n    divisor_count = _compute_positive_divisor_count(n_abs)\n    return _is_even(divisor_count)"}
{"task_id": "Mbpp/782", "solution": "from typing import List, Sequence\nfrom dataclasses import dataclass\n\ndef validate_array(arr) -> bool:\n    \"\"\"Return True if arr is a list/sequence and all elements are int. On invalid input raise TypeError or ValueError.\"\"\"\n    if not isinstance(arr, (list, tuple)):\n        raise TypeError(\"arr must be a list or sequence of integers\")\n    for element in arr:\n        if not isinstance(element, int):\n            raise TypeError(\"all elements of arr must be integers\")\n    return True\n\n@dataclass\nclass InputArray:\n    elements: List[int]\n\n@dataclass\nclass Subarray:\n    start_index: int\n    length: int\n    elements: List[int]\n\n@dataclass\nclass Result:\n    total_sum: int = 0\n\ndef odd_length_sum(arr: List[int]) -> int:\n    \"\"\"Validate arr, compute and return sum of all odd-length contiguous subarrays as int.\n    Raises TypeError or ValueError for invalid input. Returns 0 for empty list.\n    \"\"\"\n    validate_array(arr)\n\n    input_array = InputArray(elements=arr)\n    result = Result()\n    n = len(input_array.elements)\n\n    for i in range(n):\n        for length in range(1, n - i + 1, 2):  # Odd lengths: 1, 3, 5, ...\n            sub_elements = input_array.elements[i : i + length]\n            # Create Subarray object as per design, even if not strictly used beyond for clarity\n            _ = Subarray(start_index=i, length=length, elements=sub_elements)\n            result.total_sum += sum(sub_elements)\n            \n    return result.total_sum"}
{"task_id": "Mbpp/784", "solution": "from typing import List\n\nclass InputList:\n    \"\"\"Holds the ordered input values (list of ints).\"\"\"\n    def __init__(self, values: List[int]):\n        self.values = values\n\nclass Number:\n    \"\"\"Represents a single integer value with parity helpers.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def isEven(self) -> bool:\n        \"\"\"Checks if the number is even.\"\"\"\n        return self.value % 2 == 0\n\n    def isOdd(self) -> bool:\n        \"\"\"Checks if the number is odd.\"\"\"\n        return self.value % 2 != 0\n\nclass Result:\n    \"\"\"Holds the multiplication result (product).\"\"\"\n    def __init__(self, product: int):\n        self.product = product\n\nclass MulEvenOdd:\n    \"\"\"Provides the API and scanning logic to find first odd and first even and compute their product.\"\"\"\n\n    def findFirstOdd(self, values: List[int]) -> int:\n        \"\"\"Scans left-to-right and returns the first odd integer encountered.\"\"\"\n        for val in values:\n            number = Number(val)\n            if number.isOdd():\n                return val\n        raise ValueError(\"No odd number found in the list.\")\n\n    def findFirstEven(self, values: List[int]) -> int:\n        \"\"\"Scans left-to-right and returns the first even integer encountered.\"\"\"\n        for val in values:\n            number = Number(val)\n            if number.isEven():\n                return val\n        raise ValueError(\"No even number found in the list.\")\n\n    def mul_even_odd(self, values: List[int]) -> int:\n        \"\"\"Accepts input values, locates first odd and first even, computes and returns their product.\"\"\"\n        first_odd = self.findFirstOdd(values)\n        first_even = self.findFirstEven(values)\n        \n        product_value = first_odd * first_even\n        result = Result(product_value)\n        return result.product\n\ndef mul_even_odd(values: List[int]) -> int:\n    \"\"\"\n    Finds the product of the first even and first odd number in a given list.\n    Raises ValueError if either an even or odd number is not found.\n    \"\"\"\n    processor = MulEvenOdd()\n    return processor.mul_even_odd(values)"}
{"task_id": "Mbpp/785", "solution": "class ParserError(Exception):\n    \"\"\"Domain-specific exception for parse failures.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\nclass IntegerTuple:\n    \"\"\"Holds parsed integers and provides them as a Python tuple.\"\"\"\n    def __init__(self, values: list[int]) -> None:\n        self.values = values\n\n    def as_tuple(self) -> tuple[int, ...]:\n        \"\"\"Returns the stored integer values as an immutable tuple.\"\"\"\n        return tuple(self.values)\n\nclass TupleParser:\n    \"\"\"\n    Parses a string formatted as a Python-style tuple of integers.\n    Orchestrates validation, tokenization, and integer conversion.\n    \"\"\"\n    def tuple_str_int(self, s: str) -> tuple[int, ...]:\n        \"\"\"Orchestrates parsing of a tuple string into an integer tuple.\"\"\"\n        stripped_s = s.strip()\n\n        if not self.validate_format(stripped_s):\n            raise ParserError(f\"Malformed tuple string format: '{s}'\")\n\n        content = stripped_s[1:-1]\n\n        if not content.strip():\n            return ()\n\n        tokens = self.tokenize(content)\n\n        parsed_integers = []\n        for token in tokens:\n            parsed_integers.append(self.parse_int(token))\n        \n        integer_tuple_obj = IntegerTuple(parsed_integers)\n        return integer_tuple_obj.as_tuple()\n\n    def validate_format(self, s: str) -> bool:\n        \"\"\"\n        Checks if the string starts and ends with parentheses.\n        Assumes outer whitespace is already stripped.\n        \"\"\"\n        return s.startswith('(') and s.endswith(')')\n\n    def tokenize(self, s: str) -> list[str]:\n        \"\"\"\n        Splits the content string by commas and trims whitespace from each token.\n        \"\"\"\n        raw_tokens = s.split(',')\n        trimmed_tokens = [token.strip() for token in raw_tokens]\n        return trimmed_tokens\n\n    def parse_int(self, token: str) -> int:\n        \"\"\"\n        Parses a trimmed token into a base-10 signed integer.\n        Raises ParserError if parsing fails.\n        \"\"\"\n        try:\n            return int(token)\n        except ValueError:\n            raise ParserError(f\"Invalid integer token: '{token}'\")\n\ndef tuple_str_int(s: str) -> tuple[int, ...]:\n    \"\"\"\n    Converts a string representation of an integer tuple to an actual integer tuple.\n    Raises ParserError on malformed input or non-integer tokens.\n    \"\"\"\n    parser = TupleParser()\n    return parser.tuple_str_int(s)"}
