{"task_id": "Mbpp/564", "solution": "class ValidationError(Exception):\n    \"\"\"Exception raised for validation errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass ArrayInput:\n    \"\"\"Wrapper for a list of values.\"\"\"\n    def __init__(self, values: list) -> None:\n        self.values = values\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the wrapped list.\"\"\"\n        return len(self.values)\n\nclass Pair:\n    \"\"\"Represents an index pair with its values.\"\"\"\n    def __init__(self, i: int, j: int, value_i: int, value_j: int) -> None:\n        self.i = i\n        self.j = j\n        self.value_i = value_i\n        self.value_j = value_j\n\n    def isUnequal(self) -> bool:\n        \"\"\"Checks if the values in the pair are unequal.\"\"\"\n        return self.value_i != self.value_j\n\nclass PairCountResult:\n    \"\"\"Container for an integer count result.\"\"\"\n    def __init__(self, count: int) -> None:\n        self.count = count\n\nclass PairCounter:\n    \"\"\"Encapsulates logic for validating inputs and counting pairs.\"\"\"\n    def validate(self, arr, n) -> None:\n        # Per explicit requirements: \"Do NOT add isinstance() checks or raise exceptions for edge cases\".\n        # This method is effectively a no-op for the provided context.\n        pass\n\n    def count_Pairs(self, arr, n) -> int:\n        \"\"\"Counts unordered unequal pairs within the first n elements of arr.\"\"\"\n        count = 0\n        for i in range(n - 1):\n            for j in range(i + 1, n):\n                if arr[i] != arr[j]:\n                    count += 1\n        return count\n\ndef count_Pairs(arr, n) -> int:\n    \"\"\"Counts the number of possible unordered pairs where both elements are unequal.\"\"\"\n    pc = PairCounter()\n    # The validate method is called as per design, but performs no checks due to explicit requirements.\n    pc.validate(arr, n)\n    return pc.count_Pairs(arr, n)"}
{"task_id": "Mbpp/568", "solution": "def empty_list(N: int) -> list[dict]:\n    \"\"\"Return a list of N independent empty dict objects.\n\n    Raises:\n        TypeError: if N is not an int.\n        ValueError: if N < 0.\n    \"\"\"\n    if not isinstance(N, int):\n        raise TypeError(\"N must be an integer.\")\n    if N < 0:\n        raise ValueError(\"N cannot be negative.\")\n    return [{} for _ in range(N)]"}
{"task_id": "Mbpp/566", "solution": "from typing import List\n\nclass NegativeInputError(Exception):\n    \"\"\"Custom exception raised for negative integer input.\"\"\"\n    pass\n\ndef validateInput(n: int) -> None:\n    \"\"\"Validates that the input integer `n` is non-negative.\"\"\"\n    if n < 0:\n        raise NegativeInputError(\"input must be non-negative\")\n\ndef decompose_digits(n: int) -> List[int]:\n    \"\"\"Decomposes a non-negative integer into a list of its decimal digits.\"\"\"\n    if n == 0:\n        return [0]\n    return [int(d) for d in str(n)]\n\ndef sum_digits(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the digits of a non-negative integer.\n    Raises NegativeInputError if the input `n` is negative.\n    \"\"\"\n    validateInput(n)\n    digits = decompose_digits(n)\n    return sum(digits)"}
{"task_id": "Mbpp/567", "solution": "from typing import Sequence\n\ndef issort_list(lst: Sequence) -> bool:\n    \"\"\"\n    Checks if a list is sorted in ascending order (each element >= previous).\n    Empty and single-element lists are considered sorted.\n    \"\"\"\n    for i in range(1, len(lst)):\n        if lst[i] < lst[i-1]:\n            return False\n    return True"}
{"task_id": "Mbpp/569", "solution": "from typing import List\n\ndef _sort_sublist(sublist: List[str]) -> List[str]:\n    \"\"\"Sorts a single list of strings lexicographically, returning a new sorted list.\"\"\"\n    return sorted(sublist)\n\ndef sort_sublists(input_list: List[List[str]]) -> List[List[str]]:\n    \"\"\"Sorts each sublist of strings in a given list of lists lexicographically. Python's default string ordering (case-sensitive Unicode code point ordering) is used, and the outer list's order is preserved.\"\"\"\n    result = []\n    for sublist in input_list:\n        sorted_sub = _sort_sublist(sublist)\n        result.append(sorted_sub)\n    return result"}
{"task_id": "Mbpp/572", "solution": "from typing import List, Dict\nfrom dataclasses import dataclass\n\n@dataclass\nclass Number:\n    \"\"\"Conceptual data holder for a number and its count.\"\"\"\n    value: int\n    count: int\n\nclass FrequencyCounter:\n    \"\"\"Helper class to compute occurrence counts of values in a list.\"\"\"\n    def countOccurrences(self, input_list: List[int]) -> Dict[int, int]:\n        \"\"\"Counts occurrences of each number in the input list.\"\"\"\n        counts = {}\n        for num in input_list:\n            counts[num] = counts.get(num, 0) + 1\n        return counts\n\ndef two_unique_nums(input_list: List[int]) -> List[int]:\n    \"\"\"\n    Returns a new list containing only integers that occur exactly once in input_list,\n    preserving their original relative order.\n    \"\"\"\n    counter = FrequencyCounter()\n    counts_map = counter.countOccurrences(input_list)\n\n    result_list = []\n    for num in input_list:\n        if counts_map.get(num) == 1:\n            result_list.append(num)\n            \n    return result_list"}
{"task_id": "Mbpp/573", "solution": "def unique_product(lst):\n    \"\"\"\n    Calculates the product of the unique numbers in a given list.\n    Raises TypeError if the input is not a list or contains non-numeric elements.\n    \"\"\"\n\n    def _validate_input(lst):\n        \"\"\"Validates that the input is a list and all elements are numeric.\"\"\"\n        if not isinstance(lst, list):\n            raise TypeError(\"Input must be a list.\")\n        for item in lst:\n            if not isinstance(item, (int, float, complex)):\n                raise TypeError(\"All elements in the list must be numeric.\")\n\n    def _extract_unique_values(lst):\n        \"\"\"Extracts unique numeric values from a list using Python equality semantics.\"\"\"\n        unique_set = set()\n        for item in lst:\n            unique_set.add(item)\n        return list(unique_set)\n\n    def _product_of(iterable):\n        \"\"\"Calculates the product of values in an iterable, returning 1 for an empty iterable.\"\"\"\n        product = 1\n        for item in iterable:\n            product *= item\n        return product\n\n    _validate_input(lst)\n    unique_values = _extract_unique_values(lst)\n    result = _product_of(unique_values)\n    return result"}
{"task_id": "Mbpp/576", "solution": "class List:\n    def __init__(self, elements: list):\n        self._elements = elements\n    def elements(self) -> list:\n        return self._elements\n\nclass SubList:\n    def __init__(self, elements: list):\n        self._elements = elements\n    def elements(self) -> list:\n        return self._elements\n\nclass Result:\n    def __init__(self, value: bool):\n        self.value = value\n\nclass ElementComparator:\n    def equals(self, a, b) -> bool:\n        return a == b\n\nclass SubArrayChecker:\n    def __init__(self, comparator: ElementComparator = None):\n        self._comparator = comparator or ElementComparator()\n\n    def is_Sub_Array(self, container: List, candidate: SubList) -> bool:\n        c_elems = container.elements()\n        s_elems = candidate.elements()\n\n        len_c = len(c_elems)\n        len_s = len(s_elems)\n\n        if len_s == 0:\n            return True\n\n        if len_s > len_c:\n            return False\n\n        for start in range(len_c - len_s + 1):\n            match = True\n            for j in range(len_s):\n                if not self._comparator.equals(c_elems[start + j], s_elems[j]):\n                    match = False\n                    break\n            if match:\n                return True\n        return False\n\ndef is_Sub_Array(list1, list2) -> bool:\n    \"\"\"\n    Checks whether list2 is a contiguous sublist of list1.\n    It uses helper domain classes and a checker as per design.\n    \"\"\"\n    container = List(list1)\n    candidate = SubList(list2)\n\n    comparator = ElementComparator()\n    checker = SubArrayChecker(comparator)\n\n    result_bool = checker.is_Sub_Array(container, candidate)\n    return result_bool"}
{"task_id": "Mbpp/577", "solution": "def validateInput(n):\n    \"\"\"Validates that the input n is an integer.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n\ndef computeFactorialMod10(n):\n    \"\"\"Computes the last digit of n! based on special rules.\"\"\"\n    if n < 0:\n        # Factorial is typically not defined for negative numbers.\n        # Following the design, assuming non-negative inputs post-validation or handled by specific rules.\n        # The design does not explicitly mention behavior for n < 0 beyond general factorial definition.\n        # However, for last digit, if n < 0 were allowed, its definition would be complex.\n        # Since examples and rules are for n >= 0, we'll implicitly assume n >= 0 from here.\n        pass # This case should ideally be caught earlier or result in an error.\n\n    if n == 0 or n == 1:\n        return 1\n    elif n >= 5:\n        return 0  # Factorials of 5 or greater always end in 0 (e.g., 5! = 120, 6! = 720).\n    elif n == 2:\n        return 2  # 2! = 2\n    elif n == 3:\n        return 6  # 3! = 6\n    elif n == 4:\n        return 4  # 4! = 24, last digit is 4\n\ndef last_Digit_Factorial(n):\n    \"\"\"\n    Finds the last digit in the factorial of a given number n.\n    Handles special cases for small n and n >= 5 efficiently.\n    \"\"\"\n    validateInput(n)\n    return computeFactorialMod10(n)"}
{"task_id": "Mbpp/578", "solution": "class ValidationError(Exception):\n    \"\"\"Exception raised for errors in input list validation.\"\"\"\n    def __init__(self, message):\n        super().__init__(message)\n        self.message = message\n\nclass InputList:\n    \"\"\"Thin wrapper representing an input sequence for design traceability.\"\"\"\n    def __init__(self, elements):\n        self._elements = elements\n\n    def get_element_at(self, pos):\n        \"\"\"Returns the element at the specified position.\"\"\"\n        return self._elements[pos]\n\n    def __len__(self):\n        \"\"\"Returns the length of the input list.\"\"\"\n        return len(self._elements)\n\nclass InterleavedList:\n    \"\"\"A builder class to accumulate and produce the final interleaved list.\"\"\"\n    def __init__(self):\n        self._elements = []\n\n    def append(self, value):\n        \"\"\"Adds an element to the interleaved list.\"\"\"\n        self._elements.append(value)\n\n    def to_list(self):\n        \"\"\"Returns the accumulated elements as a flat list.\"\"\"\n        return self._elements\n\ndef interleave_lists(list1, list2, list3):\n    \"\"\"\n    Interleaves three lists of the same length into a single flat list.\n    Raises ValidationError if input lists do not have equal lengths.\n    \"\"\"\n    len1 = len(list1)\n    len2 = len(list2)\n    len3 = len(list3)\n\n    if not (len1 == len2 and len2 == len3):\n        raise ValidationError(\"Input lists must have equal length to be interleaved.\")\n\n    if len1 == 0:\n        return []\n\n    interleaved_result = InterleavedList()\n    for i in range(len1):\n        interleaved_result.append(list1[i])\n        interleaved_result.append(list2[i])\n        interleaved_result.append(list3[i])\n\n    return interleaved_result.to_list()"}
{"task_id": "Mbpp/579", "solution": "from typing import Any, List, Tuple, Optional, Set\n\nclass Element:\n    \"\"\"Lightweight wrapper for an element value with equality semantics.\"\"\"\n    def __init__(self, value: Any) -> None:\n        self.value = value\n\n    def __eq__(self, other: Any) -> bool:\n        if not isinstance(other, Element):\n            return NotImplemented\n        return self.value == other.value\n\n    def __hash__(self) -> int:\n        return hash(self.value)\n\n    def __repr__(self) -> str:\n        return f\"Element({repr(self.value)})\"\n\nclass TupleInput:\n    \"\"\"Wrapper around a native tuple, providing sequence access.\"\"\"\n    def __init__(self, values: Tuple) -> None:\n        self._values = values\n\n    def values(self) -> Tuple:\n        return self._values\n\n    def first_index(self, value: Any) -> Optional[int]:\n        try:\n            return self._values.index(value)\n        except ValueError:\n            return None\n\nclass DissimilarityResult:\n    \"\"\"Container for ordered unique Element instances.\"\"\"\n    def __init__(self, elements: List[Element]) -> None:\n        self.elements = elements\n\n    def to_tuple(self) -> Tuple:\n        return tuple(elem.value for elem in self.elements)\n\n    def append(self, elem: Element) -> None:\n        self.elements.append(elem)\n\nclass FindDissimilarService:\n    \"\"\"Encapsulates the core algorithm for finding dissimilar elements.\"\"\"\n    def validate_inputs(self, a: Any, b: Any) -> bool:\n        \"\"\"Ensures both inputs are native tuples, raising TypeError if not.\"\"\"\n        if not isinstance(a, tuple) or not isinstance(b, tuple):\n            raise TypeError(\"Both inputs must be tuples\")\n        return True\n\n    def compute_symmetric_difference(self, a_input: TupleInput, b_input: TupleInput) -> Set[Any]:\n        \"\"\"Computes the set of values appearing in exactly one input.\"\"\"\n        set_a = set(a_input.values())\n        set_b = set(b_input.values())\n        return (set_a - set_b) | (set_b - set_a)\n\n    def preserve_order(self, a_input: TupleInput, b_input: TupleInput, diff_values: Set[Any]) -> List[Any]:\n        \"\"\"Produces an ordered list of values, unique to A then unique to B.\"\"\"\n        ordered_result: List[Any] = []\n        seen_in_order: Set[Any] = set()\n\n        for value in a_input.values():\n            if value in diff_values and value not in seen_in_order:\n                ordered_result.append(value)\n                seen_in_order.add(value)\n\n        for value in b_input.values():\n            if value in diff_values and value not in seen_in_order:\n                ordered_result.append(value)\n                seen_in_order.add(value)\n        return ordered_result\n\n    def find_dissimilar(self, a: Any, b: Any) -> DissimilarityResult:\n        \"\"\"Orchestrates the process of finding dissimilar elements.\"\"\"\n        self.validate_inputs(a, b)\n        \n        a_input = TupleInput(a)\n        b_input = TupleInput(b)\n\n        diff_values = self.compute_symmetric_difference(a_input, b_input)\n        ordered_values = self.preserve_order(a_input, b_input, diff_values)\n        \n        result_elements = [Element(v) for v in ordered_values]\n        return DissimilarityResult(result_elements)\n\ndef find_dissimilar(a: Tuple, b: Tuple) -> Tuple:\n    \"\"\"\n    Finds the dissimilar elements in two tuples, preserving their relative order.\n    Elements appearing in exactly one tuple are included.\n    \"\"\"\n    svc = FindDissimilarService()\n    result_obj = svc.find_dissimilar(a, b)\n    return result_obj.to_tuple()"}
{"task_id": "Mbpp/580", "solution": "from typing import Tuple, Any\n\ndef _is_even(n: int) -> bool:\n    \"\"\"Internal: return True if n is even.\"\"\"\n    return n % 2 == 0\n\ndef _process_tuple(t: Tuple[Any, ...]) -> Tuple[Any, ...]:\n    \"\"\"Internal: recursive processing of tuple elements.\"\"\"\n    result_elements = []\n    for item in t:\n        if isinstance(item, int):\n            if _is_even(item):\n                result_elements.append(item)\n        elif isinstance(item, tuple):\n            processed_sub_tuple = _process_tuple(item)\n            result_elements.append(processed_sub_tuple)\n    return tuple(result_elements)\n\ndef extract_even(input_tuple: Tuple[Any, ...]) -> Tuple[Any, ...]:\n    \"\"\"Public API. Accepts a tuple and returns a new tuple with odd integers removed recursively.\"\"\"\n    return _process_tuple(input_tuple)"}
{"task_id": "Mbpp/583", "solution": "class Error(Exception):\n    \"\"\"Custom exception for invalid input.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\ndef catalan_number(n: int) -> int:\n    \"\"\"\n    Computes the nth Catalan number using dynamic programming, with input validation.\n    The computation follows the recurrence: C0 = 1; Cn = sum_{i=0}^{n-1} C_i * C_{n-1-i}.\n    \"\"\"\n    if not isinstance(n, int):\n        raise Error(\"Input must be an integer.\")\n    if n < 0:\n        raise Error(\"Input must be a non-negative integer.\")\n\n    if n == 0:\n        return 1\n\n    catalan = [0] * (n + 1)\n    catalan[0] = 1\n\n    for i in range(1, n + 1):\n        for j in range(i):\n            catalan[i] += catalan[j] * catalan[i - 1 - j]\n\n    return catalan[n]"}
{"task_id": "Mbpp/581", "solution": "import math\n\ndef _validate_numeric(value, name):\n    \"\"\"Validates that a value is an int or float.\"\"\"\n    if not isinstance(value, (int, float)):\n        raise TypeError(f\"{name} must be int or float\")\n\ndef _compute_base_area(base_edge):\n    \"\"\"Calculates the base area of a square pyramid.\"\"\"\n    return float(base_edge ** 2)\n\ndef _compute_slant_height(base_edge, height):\n    \"\"\"Calculates the slant height of a square pyramid.\"\"\"\n    return math.sqrt(height**2 + (base_edge / 2)**2)\n\ndef _compute_lateral_area(base_edge, slant_height):\n    \"\"\"Calculates the lateral area of a square pyramid.\"\"\"\n    return 2 * base_edge * slant_height\n\ndef surface_Area(base_edge, height):\n    \"\"\"Calculates the surface area of a square pyramid with a given base edge and height.\"\"\"\n    _validate_numeric(base_edge, 'base_edge')\n    _validate_numeric(height, 'height')\n\n    base_area = _compute_base_area(base_edge)\n    slant_height = _compute_slant_height(base_edge, height)\n    lateral_area = _compute_lateral_area(base_edge, slant_height)\n\n    surface_area = base_area + lateral_area\n    return surface_area"}
