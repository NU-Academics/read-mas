{"task_id": "Mbpp/585", "solution": "import heapq\nfrom typing import List, Dict, Any, Optional\n\nclass InvalidArgument(Exception):\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\nclass InvalidItem(Exception):\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\nclass Item:\n    \"\"\"Represents an item with a name, price, and additional fields.\"\"\"\n    def __init__(self, mapping: Dict[str, Any]) -> None:\n        self.name: Optional[str] = mapping.get('name')\n        self.price: float = mapping['price']\n        self.additional_fields: Dict[str, Any] = {k: v for k, v in mapping.items() if k not in ['name', 'price']}\n\n    def to_mapping(self) -> Dict[str, Any]:\n        \"\"\"Converts the Item instance back to a dictionary mapping.\"\"\"\n        mapping = {}\n        if self.name is not None:\n            mapping['name'] = self.name\n        mapping['price'] = self.price\n        mapping.update(self.additional_fields)\n        return mapping\n\nclass ItemCollection:\n    \"\"\"A collection of Item instances.\"\"\"\n    def __init__(self, items: List[Item]) -> None:\n        self.items = items\n\n    def count(self) -> int:\n        return len(self.items)\n\ndef _is_numeric(value: Any) -> bool:\n    \"\"\"Helper to check if a value is numeric (int or float).\"\"\"\n    return isinstance(value, (int, float))\n\ndef validate_items(items: Any) -> List[Item]:\n    \"\"\"Validates that the input is a list of mappings with numeric prices.\"\"\"\n    if not isinstance(items, list):\n        raise InvalidItem(\"Input 'items' must be a list.\")\n    \n    validated_items: List[Item] = []\n    for i, item_mapping in enumerate(items):\n        if not isinstance(item_mapping, dict):\n            raise InvalidItem(f\"Item at index {i} is not a dictionary mapping.\")\n        if 'price' not in item_mapping:\n            raise InvalidItem(f\"Item at index {i} is missing 'price' key.\")\n        if not _is_numeric(item_mapping['price']):\n            raise InvalidItem(f\"Item at index {i} has a non-numeric price.\")\n        validated_items.append(Item(item_mapping))\n    return validated_items\n\ndef validate_n(n: Any) -> int:\n    \"\"\"Validates that n is a non-negative integer.\"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise InvalidArgument(\"'n' must be a non-negative integer.\")\n    return n\n\ndef top_n_by_price(items: List[Item], n: int) -> List[Item]:\n    \"\"\"Sorts items by price in descending order and returns the top n.\"\"\"\n    if n == 0:\n        return []\n    \n    # Sort items by price in descending order. Python's Timsort is stable.\n    sorted_items = sorted(items, key=lambda item: item.price, reverse=True)\n    \n    return sorted_items[:n]\n\ndef expensive_items(items: List[Dict[str, Any]], n: int) -> List[Dict[str, Any]]:\n    \"\"\"\n    Finds the n most expensive items in a given dataset.\n    Validates inputs, sorts items by price, and returns the top n as dictionaries.\n    \"\"\"\n    validated_items = validate_items(items)\n    validated_n = validate_n(n)\n\n    top_n_item_objects = top_n_by_price(validated_items, validated_n)\n    \n    return [item_obj.to_mapping() for item_obj in top_n_item_objects]"}
{"task_id": "Mbpp/586", "solution": "def split_Arr(list_obj, n):\n    \"\"\"Split list_obj at index n and append first part to end. Returns a new list.\n\n    Raises:\n        TypeError: if list_obj is not a list or n is not an int.\n        ValueError: if n < 0 or n >= len(list_obj).\n    \"\"\"\n    if not isinstance(list_obj, list):\n        raise TypeError(\"list_obj must be a list.\")\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int.\")\n\n    if n < 0 or n >= len(list_obj):\n        raise ValueError(f\"n must be between 0 and {len(list_obj) - 1} (inclusive) for a list of length {len(list_obj)}.\")\n\n    return list_obj[n:] + list_obj[:n]"}
