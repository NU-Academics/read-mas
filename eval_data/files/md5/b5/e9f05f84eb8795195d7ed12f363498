{"task_id": "Mbpp/607", "solution": "from typing import Tuple\nimport re\n\nMatchResult = Tuple[str, int, int]\n\ndef find_literals(source: str, pattern: str) -> MatchResult:\n    \"\"\"Interprets pattern as a regex and returns the first match as (substring, start_index, end_index).\"\"\"\n    match = re.search(pattern, source)\n    if match is None:\n        raise RuntimeError(\"No match found\")\n    substring = match.group(0)\n    start_index, end_index = match.span()\n    return (substring, start_index, end_index)"}
{"task_id": "Mbpp/608", "solution": "def bell_Number(n):\n    \"\"\"Public API: validate input then return nth Bell number as int. Raises TypeError or ValueError on invalid input.\"\"\"\n\n    def validate_input(num):\n        \"\"\"Validate that n is int and n >= 0. Raises TypeError or ValueError.\"\"\"\n        if not isinstance(num, int):\n            raise TypeError(\"n must be an int\")\n        if num < 0:\n            raise ValueError(\"n must be >= 0\")\n\n    def compute_bell(num):\n        \"\"\"Compute nth Bell number using integer Bell-triangle algorithm and return int.\"\"\"\n        if num == 0:\n            return 1\n\n        # Initialize the Bell triangle (Aitken's array)\n        # bell_triangle[i] will store the elements of row i, up to bell_triangle[i][i]\n        bell_triangle = [[0] * (i + 1) for i in range(num + 1)]\n\n        # Base case: B(0) = 1\n        bell_triangle[0][0] = 1\n\n        # Fill the Bell triangle\n        for i in range(1, num + 1):\n            # The first element of row i is the last element of row i-1\n            bell_triangle[i][0] = bell_triangle[i-1][i-1]\n            for j in range(1, i + 1):\n                # Other elements are sum of the element to the left and the element diagonally up-left\n                bell_triangle[i][j] = bell_triangle[i][j-1] + bell_triangle[i-1][j-1]\n\n        # The nth Bell number is the first element of the nth row\n        return bell_triangle[num][0]\n\n    validate_input(n)\n    return compute_bell(n)"}
{"task_id": "Mbpp/610", "solution": "from typing import Any, List, Tuple\nfrom dataclasses import dataclass\nfrom datetime import datetime\n\n@dataclass\nclass FunctionCall:\n    args: Tuple[List[Any], int]\n    result: List[Any]\n    timestamp: datetime\n\ndef _validate_k(k: int, length: int) -> None:\n    \"\"\"Validate k; raise TypeError or IndexError on invalid values.\"\"\"\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an integer\")\n    if not (1 <= k <= length):\n        raise IndexError(\"k out of range\")\n\ndef _record_function_call(args: Tuple[List[Any], int], result: List[Any]) -> FunctionCall:\n    \"\"\"Create and return a FunctionCall instance (in-memory only).\"\"\"\n    return FunctionCall(args=args, result=result, timestamp=datetime.utcnow())\n\ndef remove_kth_element(lst: List[Any], k: int) -> List[Any]:\n    \"\"\"Remove the k'th element from lst using 1-based indexing and return a new list instance.\n\n    Raises:\n        TypeError: if k is not an int\n        IndexError: if k < 1 or k > len(lst)\n    \"\"\"\n    _validate_k(k, len(lst))\n\n    # k is 1-based, so the 0-based index to remove is k-1\n    result_list = lst[:k-1] + lst[k:]\n\n    _record_function_call(args=(lst, k), result=result_list)\n    return result_list"}
{"task_id": "Mbpp/611", "solution": "from typing import List, Any, Union\n\ndef _is_numeric(value: Any) -> bool:\n    \"\"\"\n    Checks if a value is a numeric type (int or float), excluding booleans.\n    \"\"\"\n    return isinstance(value, (int, float)) and not isinstance(value, bool)\n\ndef _collect_nth_values(matrix: List[List[Any]], n: int) -> List[Any]:\n    \"\"\"\n    Collects values from the n-th column of a matrix, ignoring rows too short.\n    \"\"\"\n    collected_values = []\n    for row in matrix:\n        if isinstance(row, (list, tuple)) and len(row) > n:\n            collected_values.append(row[n])\n    return collected_values\n\ndef max_of_nth(matrix: List[List[Any]], n: int) -> Union[int, float]:\n    \"\"\"\n    Returns the maximum numeric value from the n'th column of a matrix.\n    Raises TypeError if n is not an int or ValueError if no numeric values are found.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Column index 'n' must be an integer.\")\n\n    collected_values = _collect_nth_values(matrix, n)\n    numeric_values = [value for value in collected_values if _is_numeric(value)]\n\n    if not numeric_values:\n        raise ValueError(f\"no numeric values at column index {n}\")\n\n    return max(numeric_values)"}
{"task_id": "Mbpp/614", "solution": "def cummulative_sum(tuple_list: list[tuple]) -> int:\n    \"\"\"Calculates the cumulative sum of all integer values across all tuples in a list.\"\"\"\n    total_sum = 0\n    for current_tuple in tuple_list:\n        total_sum += sum(current_tuple)\n    return total_sum"}
{"task_id": "Mbpp/612", "solution": "def merge(inputList: list) -> list:\n    \"\"\"\n    Transforms a list of 2-element sublists into a list of two lists:\n    the first elements and the second elements, preserving input order.\n    \"\"\"\n    if not inputList:\n        return [[], []]\n    \n    first_elements = [sublist[0] for sublist in inputList]\n    second_elements = [sublist[1] for sublist in inputList]\n    \n    return [first_elements, second_elements]"}
{"task_id": "Mbpp/615", "solution": "def _mean(numeric_tuple):\n    \"\"\"Internal helper: return float(sum(numeric_tuple) / len(numeric_tuple)).\"\"\"\n    return float(sum(numeric_tuple) / len(numeric_tuple))\n\ndef average_tuple(tuple_of_tuples):\n    \"\"\"Compute arithmetic mean for each inner tuple and return a list of floats.\"\"\"\n    averages = []\n    for inner_tuple in tuple_of_tuples:\n        averages.append(_mean(inner_tuple))\n    return averages"}
{"task_id": "Mbpp/616", "solution": "def tuple_modulo(a: tuple, b: tuple) -> tuple:\n    \"\"\"Performs element-wise modulo on two tuples of the same length.\"\"\"\n\n    if not isinstance(a, tuple):\n        raise TypeError(\"Input 'a' must be a tuple.\")\n    if not isinstance(b, tuple):\n        raise TypeError(\"Input 'b' must be a tuple.\")\n\n    if len(a) != len(b):\n        raise ValueError(\"Input tuples 'a' and 'b' must have the same length.\")\n\n    for i in range(len(a)):\n        if not isinstance(a[i], int):\n            raise TypeError(f\"All elements in tuple 'a' must be integers. Found non-integer at index {i}.\")\n        if not isinstance(b[i], int):\n            raise TypeError(f\"All elements in tuple 'b' must be integers. Found non-integer at index {i}.\")\n\n    for i in range(len(b)):\n        if b[i] == 0:\n            raise ZeroDivisionError(f\"Cannot perform modulo by zero. Element at index {i} in tuple 'b' is zero.\")\n\n    result_elements = [a[i] % b[i] for i in range(len(a))]\n\n    return tuple(result_elements)"}
{"task_id": "Mbpp/619", "solution": "def move_num(input: str) -> str:\n    \"\"\"Moves all digit characters to the end of the string, preserving relative order.\"\"\"\n\n    def _char_is_digit(ch: str) -> bool:\n        \"\"\"Checks if a character is an ASCII digit ('0'-'9').\"\"\"\n        return '0' <= ch <= '9'\n\n    def _split_buffers(s: str) -> tuple[str, str]:\n        \"\"\"Separates characters into non-digits and digits buffers, preserving order.\"\"\"\n        non_digits_buffer = []\n        digits_buffer = []\n        for char in s:\n            if _char_is_digit(char):\n                digits_buffer.append(char)\n            else:\n                non_digits_buffer.append(char)\n        return ''.join(non_digits_buffer), ''.join(digits_buffer)\n\n    non_digits, digits = _split_buffers(input)\n    return non_digits + digits"}
{"task_id": "Mbpp/618", "solution": "from typing import List\n\nclass LengthMismatchError(Exception):\n    \"\"\"Raised when input lists have different lengths.\"\"\"\n    pass\n\nclass NonNumericElementError(Exception):\n    \"\"\"Raised when a non-numeric element is found in an input list.\"\"\"\n    pass\n\nclass DivisionByZeroError(Exception):\n    \"\"\"Raised when an attempt to divide by zero is made.\"\"\"\n    pass\n\nclass NumericElement:\n    \"\"\"Represents a numeric value with its original position.\"\"\"\n    def __init__(self, value: float, position: int) -> None:\n        self.value = value\n        self.position = position\n\nclass InputList:\n    \"\"\"Represents an input list of numeric elements.\"\"\"\n    def __init__(self, elements: List[NumericElement]) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        return len(self.elements)\n\nclass ResultList:\n    \"\"\"Represents a list of numeric elements resulting from an operation.\"\"\"\n    def __init__(self, elements: List[NumericElement]) -> None:\n        self.elements = elements\n\ndef _is_numeric(value) -> bool:\n    \"\"\"Helper to check if a value is an integer or a float.\"\"\"\n    return isinstance(value, (int, float))\n\nclass Validator:\n    \"\"\"Validates properties of input lists.\"\"\"\n    def validateEqualLength(self, a: InputList, b: InputList) -> None:\n        \"\"\"Raises LengthMismatchError if InputLists a and b have different lengths.\"\"\"\n        if a.length() != b.length():\n            raise LengthMismatchError(\"Input lists must have the same length.\")\n\n    def validateNumericElements(self, a: InputList, b: InputList) -> None:\n        \"\"\"This method confirms that all elements in the InputLists are numeric (already floats).\"\"\"\n        # Given NumericElement.value is typed as float, and conversion/check is done in div_list,\n        # this method primarily serves the orchestration flow.\n        pass\n\nclass DivisionOperation:\n    \"\"\"Performs element-wise division of two InputLists.\"\"\"\n    def perform(self, a: InputList, b: InputList) -> ResultList:\n        \"\"\"Divides elements of InputList a by elements of InputList b, returning a ResultList.\"\"\"\n        result_elements: List[NumericElement] = []\n        for i in range(a.length()):\n            numerator = a.elements[i].value\n            denominator = b.elements[i].value\n\n            if denominator == 0:\n                raise DivisionByZeroError(f\"Division by zero at position {i}.\")\n\n            result_elements.append(NumericElement(value=numerator / denominator, position=i))\n        return ResultList(elements=result_elements)\n\ndef div_list(a: list, b: list) -> list:\n    \"\"\"\n    Divides two lists element-wise, returning a list of floats.\n    Raises LengthMismatchError, NonNumericElementError, or DivisionByZeroError on validation failure.\n    \"\"\"\n    elements_a: List[NumericElement] = []\n    elements_b: List[NumericElement] = []\n\n    for i, val in enumerate(a):\n        if not _is_numeric(val):\n            raise NonNumericElementError(f\"Element at position {i} in list 'a' is not numeric: {val}\")\n        elements_a.append(NumericElement(value=float(val), position=i))\n\n    for i, val in enumerate(b):\n        if not _is_numeric(val):\n            raise NonNumericElementError(f\"Element at position {i} in list 'b' is not numeric: {val}\")\n        elements_b.append(NumericElement(value=float(val), position=i))\n\n    input_a = InputList(elements=elements_a)\n    input_b = InputList(elements=elements_b)\n\n    validator = Validator()\n    validator.validateEqualLength(input_a, input_b)\n    validator.validateNumericElements(input_a, input_b) # This call adheres to the design flow.\n\n    division_op = DivisionOperation()\n    result_list = division_op.perform(input_a, input_b)\n\n    return [elem.value for elem in result_list.elements]"}
{"task_id": "Mbpp/620", "solution": "class IntegerList:\n    def __init__(self, numbers: list[int]):\n        \"\"\"Initializes IntegerList and sorts the numbers for consistent processing.\"\"\"\n        self.numbers = sorted(numbers)\n\n    def length(self) -> int:\n        \"\"\"Returns the number of integers in the list.\"\"\"\n        return len(self.numbers)\n\n\nclass Number:\n    def __init__(self, value: int):\n        \"\"\"Wraps an integer value.\"\"\"\n        self.value = value\n\n\nclass DivisibilityRelation:\n    def divides(self, a: Number, b: Number) -> bool:\n        \"\"\"\n        Checks if two numbers are divisible according to the predicate (a%b==0 or b%a==0).\n        Handles zero values to avoid division by zero errors.\n        \"\"\"\n        val_a = a.value\n        val_b = b.value\n\n        if val_a == 0 and val_b == 0:\n            return True\n\n        if val_a == 0:\n            return val_a % val_b == 0\n\n        if val_b == 0:\n            return val_b % val_a == 0\n\n        return val_a % val_b == 0 or val_b % val_a == 0\n\n\nclass Subset:\n    def __init__(self, members: list[Number]):\n        \"\"\"Initializes a Subset with a list of Number objects.\"\"\"\n        self.members = members\n        self._div_relation = DivisibilityRelation()\n\n    def size(self) -> int:\n        \"\"\"Returns the number of members in the subset.\"\"\"\n        return len(self.members)\n\n    def isPairwiseDivisible(self) -> bool:\n        \"\"\"Checks if every pair of numbers in the subset is divisible.\"\"\"\n        if len(self.members) <= 1:\n            return True\n\n        for i in range(len(self.members)):\n            for j in range(i + 1, len(self.members)):\n                num_a = self.members[i]\n                num_b = self.members[j]\n                if not self._div_relation.divides(num_a, num_b):\n                    return False\n        return True\n\n\nclass Result:\n    def __init__(self, size: int):\n        \"\"\"A simple data holder for the result size.\"\"\"\n        self.size = size\n\n\nclass LargestSubsetFunction:\n    def largest_subset(self, list_obj: IntegerList) -> int:\n        \"\"\"\n        Computes the size of the largest divisible subset using dynamic programming.\n        Assumes list_obj.numbers is sorted.\n        \"\"\"\n        numbers = list_obj.numbers\n\n        if not numbers:\n            return 0\n\n        n = len(numbers)\n        dp = [1] * n\n        max_subset_size = 1\n\n        div_relation = DivisibilityRelation()\n\n        for i in range(n):\n            current_num = Number(numbers[i])\n            for j in range(i):\n                previous_num = Number(numbers[j])\n                if div_relation.divides(current_num, previous_num):\n                    dp[i] = max(dp[i], dp[j] + 1)\n            \n            max_subset_size = max(max_subset_size, dp[i])\n\n        return max_subset_size\n\n\ndef largest_subset(input_list: list[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset of a list of numbers so that every pair is divisible.\n    Delegates to the LargestSubsetFunction service.\n    \"\"\"\n    integer_list = IntegerList(numbers=input_list)\n    service = LargestSubsetFunction()\n    return service.largest_subset(integer_list)"}
{"task_id": "Mbpp/629", "solution": "def Split(numbers):\n    \"\"\"\n    Finds even numbers from a list of numbers.\n    Returns a new list containing only the even numbers, preserving their original order.\n    \"\"\"\n    even_numbers = []\n    for num in numbers:\n        if num % 2 == 0:\n            even_numbers.append(num)\n    return even_numbers"}
