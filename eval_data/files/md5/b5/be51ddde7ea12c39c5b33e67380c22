{"task_id": "HumanEval/74", "solution": "def _calculate_total_characters(lst):\n    '''\n    Calculates the total character count for all strings in a list.\n    It sums the length of each string in the provided list.\n    '''\n    total_chars = 0\n    for s in lst:\n        total_chars += len(s)\n    return total_chars\ndef total_match(lst1, lst2):\n    '''\n    Compares two lists of strings based on total character counts.\n    Returns the list with fewer total characters, or the first list in case of a tie.\n    '''\n    countA = _calculate_total_characters(lst1)\n    countB = _calculate_total_characters(lst2)\n\n    if countA <= countB:\n        return lst1\n    else:\n        return lst2"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"Calculates the sum of ASCII codes for uppercase characters in a string.\n    It iterates through the string, identifying and summing uppercase character ASCII values.\n    \"\"\"\n    total_sum = 0\n    for char in s:\n        if char.isupper():\n            total_sum += ord(char)\n    return total_sum"}
{"task_id": "HumanEval/75", "solution": "import math\ndef _is_prime(n: int) -> bool:\n    \"\"\"Determines if a given number is prime.\n    Handles base cases and efficiently checks for divisibility up to its square root.\"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\ndef _get_prime_factors(n: int) -> list[int]:\n    \"\"\"Finds all prime factors of a given number.\n    It iterates and adds prime divisors to a list until the number is fully factored.\"\"\"\n    factors = []\n    temp_n = n\n    i = 2\n    while i * i <= temp_n:\n        if _is_prime(i):\n            while temp_n % i == 0:\n                factors.append(i)\n                temp_n //= i\n        i += 1\n    if temp_n > 1:\n        factors.append(temp_n)\n    return factors\ndef is_multiply_prime(a):\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100.\n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n    prime_factors = _get_prime_factors(a)\n    return len(prime_factors) == 3"}
{"task_id": "HumanEval/75", "solution": "def _get_prime_factors(n: int) -> list[int]:\n    \"\"\"Finds all prime factors of a number.\n    Returns a list of prime factors, including duplicates.\"\"\"\n    factors = []\n    d = 2\n    temp_n = n\n    while d * d <= temp_n:\n        while temp_n % d == 0:\n            factors.append(d)\n            temp_n //= d\n        d += 1\n    if temp_n > 1:\n        factors.append(temp_n)\n    return factors\ndef is_multiply_prime(a):\n    \"\"\"Checks if a number is the product of exactly three prime numbers.\n    The input 'a' is less than 100.\"\"\"\n    factors = _get_prime_factors(a)\n    return len(factors) == 3"}
{"task_id": "HumanEval/77", "solution": "def iscube(a: int) -> bool:\n    \"\"\"\n    Checks if an integer is a perfect cube.\n    Returns True if 'a' is a perfect cube, False otherwise.\n    \"\"\"\n    if a == 0:\n        return True\n\n    # Calculate the cube root of the absolute value and round to the nearest integer.\n    # This avoids potential issues with negative bases and fractional exponents in Python.\n    root_candidate_abs = round(abs(a)**(1/3))\n\n    # Check if the cubed candidate matches the original number based on its sign.\n    if a > 0:\n        return root_candidate_abs * root_candidate_abs * root_candidate_abs == a\n    else:  # a < 0\n        return -(root_candidate_abs * root_candidate_abs * root_candidate_abs) == a"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Checks if x is a simple power of n (n^k = x for non-negative integer k).\n    Handles specified edge cases for x and n, including 0 and 1.\n    \"\"\"\n\n    # 1. Handle x = 1: If x is 1, it is considered a simple power of any n (n^0 = 1).\n    if x == 1:\n        return True\n\n    # 2. Handle x = 0:\n    if x == 0:\n        # If n is 0, then 0^1 = 0, so x is a simple power of n.\n        if n == 0:\n            return True\n        # Otherwise (n != 0), n^k can never be 0 for any non-negative integer k.\n        else:\n            return False\n\n    # After this point, x is guaranteed not to be 0 or 1.\n\n    # 3. Handle n = 1: If n is 1, then 1^k is always 1. Since x is not 1 at this point,\n    # x cannot be a simple power of n=1.\n    if n == 1:\n        return False\n\n    # 4. Handle n = 0 (for x not 0 or 1):\n    # If n is 0, 0^k is either 0 (for k>0) or 1 (for k=0). Since x is not 0 or 1,\n    # x cannot be a simple power of n=0.\n    if n == 0:\n        return False\n\n    # 5. General Case (x is not 0 or 1, n is not 0 or 1):\n    # Initialize current_power to n^0, which is 1.\n    current_power = 1\n\n    # Loop while current_power is less than x. This condition is taken directly from the design.\n    # Note: For negative x, this loop will not execute as 1 < x will be false.\n    while current_power < x:\n        current_power *= n\n\n        # Design rule: \"If n is negative and current_power becomes 0... continue.\"\n        # This condition will not be met since n is not 0 and current_power starts at 1.\n        if n < 0 and current_power == 0:\n            continue\n\n        # Design rule: \"If n is negative and x is positive, and current_power becomes negative,\n        # it means x cannot be a power of n. Break and return false.\"\n        if n < 0 and x > 0 and current_power < 0:\n            return False\n\n        # Design rule: \"If n is negative and x is negative, and current_power becomes positive,\n        # it means x cannot be a power of n. Break and return false.\"\n        # This part of the code won't be reached for x < 0 due to the 'current_power < x' loop condition.\n        if n < 0 and x < 0 and current_power > 0:\n            return False\n\n    # After the loop, compare the final current_power with x.\n    # If x was negative, current_power will still be 1, so 1 == x will be False.\n    return current_power == x"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    '''\n    Checks if an integer 'a' is a perfect cube.\n    Handles positive, negative, and zero inputs.\n    '''\n    if a == 0:\n        return True\n\n    # Calculate the cube root of the absolute value.\n    root_abs = abs(a)**(1/3)\n\n    # Round the root_abs to the nearest integer.\n    rounded_root = round(root_abs)\n\n    # Adjust the sign of the rounded_root to match the original input 'a'.\n    # If 'a' is negative, the candidate root must also be negative.\n    if a < 0:\n        candidate_root = -rounded_root\n    else:\n        candidate_root = rounded_root\n\n    # Cube the candidate root and compare with the original input.\n    return candidate_root**3 == a"}
{"task_id": "HumanEval/78", "solution": "def hex_key(num):\n    \"\"\"Counts prime hexadecimal digits in a string, identifying 2, 3, 5, 7, B, D as prime.\"\"\"\n\n    # Private constant set for efficient lookup of prime decimal values.\n    PRIME_HEX_DECIMAL_VALUES = {2, 3, 5, 7, 11, 13}\n\n    def _hex_char_to_decimal(char: str) -> int:\n        # Helper function to convert a single hexadecimal character to its decimal integer value.\n        return int(char, 16)\n\n    def _is_prime_hex_decimal(decimal_value: int) -> bool:\n        # Helper function to check if a decimal value is one of the predefined prime hexadecimal digits.\n        return decimal_value in PRIME_HEX_DECIMAL_VALUES\n\n    prime_count = 0\n    for char in num:\n        decimal_value = _hex_char_to_decimal(char)\n        if _is_prime_hex_decimal(decimal_value):\n            prime_count += 1\n    return prime_count"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Checks if x is a simple power of n (n**k == x for k >= 0). Returns True if it is, False otherwise.\"\"\"\n    if x == 1:\n        return True\n    if n == 1:\n        return False\n\n    while x % n == 0:\n        x = x // n\n\n    return x == 1"}
{"task_id": "HumanEval/78", "solution": "def hex_key(num):\n    \"\"\"Counts prime hexadecimal digits in a given string.\n    Identifies '2', '3', '5', '7', 'B', 'D' as prime hex digits.\"\"\"\n\n    prime_count = 0\n    prime_hex_digits = {'2', '3', '5', '7', 'B', 'D'}\n\n    for char in num:\n        if char in prime_hex_digits:\n            prime_count += 1\n\n    return prime_count"}
{"task_id": "HumanEval/79", "solution": "def decimal_to_binary(decimal):\n    \"\"\"Converts a decimal integer to its binary string representation.\n    The output string is formatted with a \"db\" prefix and a \"db\" suffix.\"\"\"\n    raw_binary_string = bin(decimal)[2:]\n    formatted_binary_string = \"db\" + raw_binary_string + \"db\"\n    return formatted_binary_string"}
{"task_id": "HumanEval/80", "solution": "def is_happy(s):\n    \"\"\"\n    Checks if the given string s is happy.\n    A string is happy if its length is at least 3 and every 3 consecutive letters are distinct.\n    \"\"\"\n    if len(s) < 3:\n        return False\n\n    for i in range(len(s) - 2):\n        char1 = s[i]\n        char2 = s[i+1]\n        char3 = s[i+2]\n\n        if char1 == char2 or char1 == char3 or char2 == char3:\n            return False\n\n    return True"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"It is the last week of the semester and the teacher has to give the grades\n    to students. The teacher has been making her own algorithm for grading.\n    The only problem is, she has lost the code she used for grading.\n    She has given you a list of GPAs for some students and you have to write\n    a function that can output a list of letter grades using the following table:\n             GPA       |    Letter grade\n              4.0                A+\n            > 3.7                A\n            > 3.3                A-\n            > 3.0                B+\n            > 2.7                B\n            > 2.3                B-\n            > 2.0                C+\n            > 1.7                C\n            > 1.3                C-\n            > 1.0                D+\n            > 0.7                D\n            > 0.0                D-\n              0.0                E\n\n\n    Example:\n    grade_equation([4.0, 3, 1.7, 2, 3.5]) ==> ['A+', 'B', 'C-', 'C', 'A-']\n    \"\"\"\n\n    class GradingScaleRule:\n        \"\"\"Represents a single rule in the GPA grading scale.\"\"\"\n        def __init__(self, gpa_threshold: float, comparison_operator: str, letter_grade: str):\n            self.gpa_threshold = gpa_threshold\n            self.comparison_operator = comparison_operator\n            self.letter_grade = letter_grade\n\n        def applies(self, gpa: float) -> bool:\n            \"\"\"Evaluates if a given GPA satisfies the rule's condition.\"\"\"\n            if self.comparison_operator == \">\":\n                return gpa > self.gpa_threshold\n            elif self.comparison_operator == \"==\":\n                return gpa == self.gpa_threshold\n            return False\n\n        def get_letter_grade(self) -> str:\n            \"\"\"Returns the letter grade associated with the rule.\"\"\"\n            return self.letter_grade\n\n    _GRADING_RULES = [\n        GradingScaleRule(4.0, \"==\", \"A+\"),\n        GradingScaleRule(3.7, \">\", \"A\"),\n        GradingScaleRule(3.3, \">\", \"A-\"),\n        GradingScaleRule(3.0, \">\", \"B+\"),\n        GradingScaleRule(2.7, \">\", \"B\"),\n        GradingScaleRule(2.3, \">\", \"B-\"),\n        GradingScaleRule(2.0, \">\", \"C+\"),\n        GradingScaleRule(1.7, \">\", \"C\"),\n        GradingScaleRule(1.3, \">\", \"C-\"),\n        GradingScaleRule(1.0, \">\", \"D+\"),\n        GradingScaleRule(0.7, \">\", \"D\"),\n        GradingScaleRule(0.0, \">\", \"D-\"),\n        GradingScaleRule(0.0, \"==\", \"E\"),\n    ]\n\n    results = []\n    for gpa in grades:\n        for rule in _GRADING_RULES:\n            if rule.applies(gpa):\n                results.append(rule.get_letter_grade())\n                break\n    return results"}
{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"Checks if the length of the input string is a prime number.\n    Returns True if the length is prime, False otherwise.\"\"\"\n    n = len(string)\n\n    # Handle base cases for primality: 0 and 1 are not prime, 2 is prime.\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n\n    # Iterate from 2 up to the square root of n (inclusive).\n    # If n has any divisor in this range, it is not prime.\n    i = 2\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 1\n\n    # If no divisors were found, n is prime.\n    return True"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"It is the last week of the semester and the teacher has to give the grades\n    to students. The teacher has been making her own algorithm for grading.\n    The only problem is, she has lost the code she used for grading.\n    She has given you a list of GPAs for some students and you have to write\n    a function that can output a list of letter grades using the following table:\n             GPA       |    Letter grade\n              4.0                A+\n            > 3.7                A\n            > 3.3                A-\n            > 3.0                B+\n            > 2.7                B\n            > 2.3                B-\n            > 2.0                C+\n            > 1.7                C\n            > 1.3                C-\n            > 1.0                D+\n            > 0.7                D\n            > 0.0                D-\n              0.0                E\n\n\n    Example:\n    grade_equation([4.0, 3, 1.7, 2, 3.5]) ==> ['A+', 'B', 'C-', 'C', 'A-']\n    \"\"\"\n    letter_grades = []\n    for grade in grades:\n        if grade == 4.0:\n            letter_grades.append('A+')\n        elif grade > 3.7:\n            letter_grades.append('A')\n        elif grade > 3.3:\n            letter_grades.append('A-')\n        elif grade > 3.0:\n            letter_grades.append('B+')\n        elif grade > 2.7:\n            letter_grades.append('B')\n        elif grade > 2.3:\n            letter_grades.append('B-')\n        elif grade > 2.0:\n            letter_grades.append('C+')\n        elif grade > 1.7:\n            letter_grades.append('C')\n        elif grade > 1.3:\n            letter_grades.append('C-')\n        elif grade > 1.0:\n            letter_grades.append('D+')\n        elif grade > 0.7:\n            letter_grades.append('D')\n        elif grade > 0.0:\n            letter_grades.append('D-')\n        elif grade == 0.0:\n            letter_grades.append('E')\n    return letter_grades"}
{"task_id": "HumanEval/82", "solution": "def _is_prime(number: int) -> bool:\n    \"\"\"Checks if a given integer is a prime number.\"\"\"\n    if number <= 1:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n    # Check for odd divisors up to the square root of number.\n    i = 3\n    while i * i <= number:\n        if number % i == 0:\n            return False\n        i += 2\n    return True\ndef prime_length(string: str) -> bool:\n    \"\"\"Write a function that takes a string and returns True if the string\n    length is a prime number or False otherwise\n    Examples\n    prime_length('Hello') == True\n    prime_length('abcdcba') == True\n    prime_length('kittens') == True\n    prime_length('orange') == False\n    \"\"\"\n    length = len(string)\n    if length < 2:\n        return False\n    return _is_prime(length)"}
{"task_id": "HumanEval/84", "solution": "def _calculate_digit_sum(number: int) -> int:\n    \"\"\"Calculates the sum of the decimal digits of a given integer.\n    Converts the number to a string and sums its digit characters.\n    \"\"\"\n    total_sum = 0\n    for digit_char in str(number):\n        total_sum += int(digit_char)\n    return total_sum\ndef _convert_to_binary_string(decimal_sum: int) -> str:\n    \"\"\"Converts a decimal integer into its binary string representation.\n    Handles the case for 0 separately to ensure \"0\" is returned.\n    \"\"\"\n    if decimal_sum == 0:\n        return \"0\"\n    return bin(decimal_sum)[2:]\ndef solve(N) -> str:\n    \"\"\"Computes the sum of N's decimal digits and returns the sum as a binary string.\n    This function orchestrates digit summation and binary conversion.\n    \"\"\"\n    # Input N is trusted to be within 0 <= N <= 10000 as per critical requirements,\n    # thus explicit validation and error raising for N are omitted.\n\n    digit_sum = _calculate_digit_sum(N)\n    binary_representation = _convert_to_binary_string(digit_sum)\n    return binary_representation"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of n-digit positive integers that start or end with 1.\n    This uses the inclusion-exclusion principle.\n    \"\"\"\n    # Count of n-digit numbers that start with 1.\n    # The first digit is 1, and the remaining n-1 digits can be any of 0-9.\n    count_starts_with_1 = 10**(n - 1)\n\n    # Count of n-digit numbers that end with 1.\n    # For n=1, only '1'. For n > 1, the first digit cannot be 0 (9 choices), remaining n-2 digits can be any of 0-9.\n    if n == 1:\n        count_ends_with_1 = 1\n    else:\n        count_ends_with_1 = 9 * (10**(n - 2))\n\n    # Count of n-digit numbers that start AND end with 1.\n    # For n=1, only '1'. For n=2, only '11'. For n > 2, first and last digits are 1, remaining n-2 digits can be any of 0-9.\n    if n == 1:\n        count_starts_and_ends_with_1 = 1\n    elif n == 2:\n        count_starts_and_ends_with_1 = 1\n    else:\n        count_starts_and_ends_with_1 = 10**(n - 2)\n\n    # Apply the inclusion-exclusion principle: A U B = A + B - (A intersect B).\n    total_count = count_starts_with_1 + count_ends_with_1 - count_starts_and_ends_with_1\n\n    return total_count"}
{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    The sum of N's decimal digits is calculated and then converted to a binary string.\n    \"\"\"\n\n    def _calculate_decimal_digit_sum(num: int) -> int:\n        \"\"\"Computes the sum of the decimal digits of a given integer.\n        It trusts the input to be a non-negative integer.\n        \"\"\"\n        digit_sum = 0\n        if num == 0:\n            return 0\n\n        current_num = num\n        while current_num > 0:\n            digit_sum += current_num % 10\n            current_num //= 10\n        return digit_sum\n\n    def _convert_to_binary_string(decimal_sum: int) -> str:\n        \"\"\"Converts a decimal sum into its binary string representation.\n        The result is a string without the \"0b\" prefix.\n        \"\"\"\n        return bin(decimal_sum)[2:]\n\n    # The _validate_input helper is omitted as per critical requirements.\n    # Trust the caller's input N is within 0 <= N <= 10000 and is an integer.\n\n    decimal_sum_result = _calculate_decimal_digit_sum(N)\n    binary_string_result = _convert_to_binary_string(decimal_sum_result)\n\n    return binary_string_result"}
{"task_id": "HumanEval/85", "solution": "def _is_odd_index(index: int) -> bool:\n    \"\"\"Checks if an index is odd.\n    Returns True if the index is odd, False otherwise.\n    \"\"\"\n    return index % 2 != 0\ndef _is_even_element(value: int) -> bool:\n    \"\"\"Checks if an element's value is even.\n    Returns True if the value is even, False otherwise.\n    \"\"\"\n    return value % 2 == 0\ndef add(lst: list[int]) -> int:\n    \"\"\"Given a non-empty list of integers lst. add the even elements that are at odd indices.\n    Raises ValueError if the input list is empty.\n    \"\"\"\n    if not lst:\n        raise ValueError(\"Input list must not be empty.\")\n\n    current_sum = 0\n    for index, element_value in enumerate(lst):\n        if _is_odd_index(index) and _is_even_element(element_value):\n            current_sum += element_value\n\n    return current_sum"}
{"task_id": "HumanEval/79", "solution": "def decimal_to_binary(decimal):\n    \"\"\"Converts a decimal number to its binary representation.\n    The result is a string, formatted with 'db' prefix and suffix.\"\"\"\n    binary_str_with_prefix = bin(decimal)\n    binary_str_without_prefix = binary_str_with_prefix[2:]\n    formatted_binary_str = \"db\" + binary_str_without_prefix + \"db\"\n    return formatted_binary_str"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q, w):\n    \"\"\"\n    Evaluates if an object represented by list `q` will fly.\n    It flies if `q` is a palindrome and its sum is less than or equal to `w`.\n    \"\"\"\n    is_palindrome = (q == q[::-1]) # Determines if the input list `q` is a palindrome.\n    total_weight = sum(q)          # Calculates the sum of all numerical elements in `q`.\n\n    return is_palindrome and total_weight <= w"}
{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Reorders characters within each word of a string based on ASCII values,\n    preserving word order and original spacing.\n    \"\"\"\n    substrings = s.split(' ')  # Splits the string by space, creating empty strings for multiple spaces.\n\n    processed_substrings = []\n    for sub in substrings:\n        if not sub:  # If a substring is an empty string (representing spaces).\n            processed_substrings.append(sub)  # Preserve empty substrings as they are.\n        else:  # If a substring is a non-empty word.\n            sorted_chars = sorted(sub)  # Sort characters by ASCII values.\n            processed_word = ''.join(sorted_chars)  # Join sorted characters back into a string.\n            processed_substrings.append(processed_word)\n\n    return ' '.join(processed_substrings)  # Joins processed substrings with a space, restoring original word order and spacing."}
{"task_id": "HumanEval/85", "solution": "def _is_even(number: int) -> bool:\n    \"\"\"Checks if a given number is even.\n    Returns True if the number is even, False otherwise.\"\"\"\n    return number % 2 == 0\ndef _is_odd_index(index: int) -> bool:\n    \"\"\"Checks if a given index is odd.\n    Returns True if the index is odd, False otherwise.\"\"\"\n    return index % 2 != 0\ndef add(lst: list[int]) -> int:\n    \"\"\"Given a non-empty list of integers lst.\n    Adds the even elements that are at odd indices (0-based).\"\"\"\n    sum_of_evens_at_odd_indices = 0\n    for index, element in enumerate(lst):\n        if _is_odd_index(index):\n            if _is_even(element):\n                sum_of_evens_at_odd_indices += element\n    return sum_of_evens_at_odd_indices"}
{"task_id": "HumanEval/80", "solution": "def is_happy(s):\n    \"\"\"Checks if a string is \"happy\". A string is happy if its length is at least 3, and all 3 consecutive characters are distinct.\"\"\"\n    if len(s) < 3:\n        return False\n\n    for i in range(len(s) - 2):\n        substring = s[i:i+3]\n        if len(set(substring)) < 3:\n            return False\n\n    return True"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds all occurrences of x in a nested list and returns their 0-indexed (row, column) coordinates.\n    Coordinates are sorted primarily by row ascending and secondarily by column descending.\n    \"\"\"\n    collected_coordinates = []\n\n    # If lst is empty, return [] immediately as per FR11.\n    if not lst:\n        return []\n\n    # Iterate through rows and columns to find x (FR2, FR3, FR4).\n    for row_index, row in enumerate(lst):\n        for col_index, element in enumerate(row):\n            if element == x:\n                # Record (row_index, col_index) as a tuple (FR5, FR6).\n                collected_coordinates.append((row_index, col_index))\n\n    # If x was not found, return [] as per FR12.\n    if not collected_coordinates:\n        return []\n\n    # Sort collected_coordinates as per FR7, FR8, FR9.\n    # Primary sort by row ascending, secondary by column descending.\n    collected_coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n\n    # Return the sorted list (FR10).\n    return collected_coordinates"}
{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Takes a string and returns an ordered version where words have sorted characters.\n    Preserves word order and space characters.\n    \"\"\"\n    result_parts = []\n    current_segment = []\n\n    if not s:\n        return \"\"\n\n    # Initialize is_space_segment based on the first character of the string\n    is_space_segment = s[0].isspace()\n\n    for char in s:\n        char_is_space = char.isspace()\n\n        # Check for a state transition (from word to space or vice versa)\n        if char_is_space != is_space_segment:\n            # Process the completed segment\n            if is_space_segment:  # If the previous segment was spaces\n                result_parts.append(\"\".join(current_segment))\n            else:  # If the previous segment was a word\n                current_segment.sort()\n                result_parts.append(\"\".join(current_segment))\n\n            # Reset for the new segment\n            current_segment = []\n            is_space_segment = char_is_space\n\n        # Add the current character to the current segment\n        current_segment.append(char)\n\n    # Process the last segment after the loop finishes\n    if current_segment:\n        if is_space_segment:\n            result_parts.append(\"\".join(current_segment))\n        else:\n            current_segment.sort()\n            result_parts.append(\"\".join(current_segment))\n\n    return \"\".join(result_parts)"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds all occurrences of integer x in a nested list and returns their (row, column) coordinates.\n    Coordinates are 0-indexed and sorted by row ascending, then by column descending.\n    \"\"\"\n    found_coordinates = []\n\n    for row_idx, row in enumerate(lst):\n        for col_idx, element in enumerate(row):\n            if element == x:\n                found_coordinates.append((row_idx, col_idx))\n\n    found_coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n\n    return found_coordinates"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s: str) -> str:\n    \"\"\"\n    Encrypts a string by shifting lowercase English letters down by four places,\n    leaving other characters unchanged.\n    \"\"\"\n    encrypted_chars = []\n    for char in s:\n        if 'a' <= char <= 'z':\n            # Shift character by 4 places, wrapping around 'z'.\n            shifted_char_code = ord(char) + 4\n            if shifted_char_code > ord('z'):\n                shifted_char_code -= 26  # Wrap around the alphabet.\n            encrypted_chars.append(chr(shifted_char_code))\n        else:\n            # Keep non-lowercase English letters unchanged.\n            encrypted_chars.append(char)\n    return \"\".join(encrypted_chars)"}
