{"task_id": "HumanEval/124", "solution": "import re\nfrom abc import ABC, abstractmethod\nclass _ParsedDate:\n    \"\"\"A data structure to hold parsed date components.\"\"\"\n    def __init__(self, month: int, day: int, year: int):\n        self.month = month\n        self.day = day\n        self.year = year\nclass _DateParser:\n    \"\"\"Parses a date string into its components.\"\"\"\n    DATE_PATTERN = re.compile(r\"^(?P<month>\\d{2})-(?P<day>\\d{2})-(?P<year>\\d{4})$\")\n\n    def parse(self, date_string: str) -> _ParsedDate | None:\n        \"\"\"Attempts to parse the date string in 'mm-dd-yyyy' format.\"\"\"\n        match = self.DATE_PATTERN.match(date_string)\n        if not match:\n            return None\n\n        month = int(match.group('month'))\n        day = int(match.group('day'))\n        year = int(match.group('year'))\n        return _ParsedDate(month, day, year)\nclass _ValidationRule(ABC):\n    \"\"\"Abstract base class for date validation rules.\"\"\"\n    @abstractmethod\n    def is_valid(self, parsed_date: _ParsedDate) -> bool:\n        pass\nclass _MonthRangeRule(_ValidationRule):\n    \"\"\"Validates the month component of a date.\"\"\"\n    def is_valid(self, parsed_date: _ParsedDate) -> bool:\n        \"\"\"Checks if the month is between 1 and 12, inclusive.\"\"\"\n        return 1 <= parsed_date.month <= 12\nclass _DayRangeRule(_ValidationRule):\n    \"\"\"Validates the day component based on the month.\"\"\"\n    def is_valid(self, parsed_date: _ParsedDate) -> bool:\n        \"\"\"Checks if the day is valid for the given month.\"\"\"\n        month = parsed_date.month\n        day = parsed_date.day\n\n        days_in_month = {\n            1: 31, 3: 31, 5: 31, 7: 31, 8: 31, 10: 31, 12: 31,\n            4: 30, 6: 30, 9: 30, 11: 30,\n            2: 29 # As per the requirement, February has 29 days.\n        }\n\n        max_days = days_in_month.get(month)\n        if max_days is None:\n            return False\n\n        return 1 <= day <= max_days\ndef valid_date(date: str) -> bool:\n    \"\"\"Validates a given date string according to predefined rules.\n    It checks for format, month range, and day range based on month.\"\"\"\n    if not date:\n        return False\n\n    parser = _DateParser()\n    parsed_date = parser.parse(date)\n\n    if not parsed_date:\n        return False\n\n    rules = [\n        _MonthRangeRule(),\n        _DayRangeRule()\n    ]\n\n    for rule in rules:\n        if not rule.is_valid(parsed_date):\n            return False\n\n    return True"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n\n    The Collatz conjecture is a conjecture in mathematics that concerns a sequence defined\n    as follows: start with any positive integer n. Then each term is obtained from the\n    previous term as follows: if the previous term is even, the next term is one half of\n    the previous term. If the previous term is odd, the next term is 3 times the previous\n    term plus 1. The conjecture is that no matter what value of n, the sequence will always reach 1.\n\n    Note:\n        1. Collatz(1) is [1].\n        2. returned list sorted in increasing order.\n\n    For example:\n    get_odd_collatz(5) returns [1, 5] # The collatz sequence for 5 is [5, 16, 8, 4, 2, 1], so the odd numbers are only 1, and 5.\n    \"\"\"\n\n    def _generate_sequence(num: int) -> list[int]:\n        \"\"\"Generates the Collatz sequence for a given positive integer n.\"\"\"\n        sequence = [num]\n        while num != 1:\n            if num % 2 == 0:\n                num = num // 2\n            else:\n                num = 3 * num + 1\n            sequence.append(num)\n        return sequence\n\n    def _extract_odd_numbers(sequence: list[int]) -> list[int]:\n        \"\"\"Filters a list of integers to return only the odd numbers.\"\"\"\n        return [val for val in sequence if val % 2 != 0]\n\n    if n == 1:\n        return [1]\n\n    collatz_sequence = _generate_sequence(n)\n    odd_numbers = _extract_odd_numbers(collatz_sequence)\n    odd_numbers.sort()\n    return odd_numbers"}
{"task_id": "HumanEval/124", "solution": "def _parse_date_parts(date_string: str):\n    \"\"\"Parses a date string in 'mm-dd-yyyy' format into month, day, and year integers.\n    Returns None if the format is invalid or conversion fails.\n    \"\"\"\n    parts = date_string.split('-')\n    if len(parts) != 3:\n        return None\n    try:\n        month = int(parts[0])\n        day = int(parts[1])\n        year = int(parts[2])\n        return (month, day, year)\n    except ValueError:\n        return None\ndef _is_valid_month(month: int):\n    \"\"\"Checks if the given month is within the valid range of 1 to 12.\n    Returns True for valid months, False otherwise.\n    \"\"\"\n    return 1 <= month <= 12\ndef _get_max_days_in_month(month: int):\n    \"\"\"Determines the maximum number of days for a given month.\n    This function adheres to specific rules for 31, 30, and 29-day months.\n    \"\"\"\n    if month in [1, 3, 5, 7, 8, 10, 12]:\n        return 31\n    elif month in [4, 6, 9, 11]:\n        return 30\n    elif month == 2:\n        return 29\n    # This point should not be reached if _is_valid_month is called prior.\ndef _is_valid_day(day: int, month: int):\n    \"\"\"Validates if the day is within the acceptable range for the given month.\n    It uses _get_max_days_in_month to determine the upper bound.\n    \"\"\"\n    max_days = _get_max_days_in_month(month)\n    return 1 <= day <= max_days\ndef valid_date(date):\n    \"\"\"Validates a given date string based on format, month, and day rules.\n    Returns True if the date is valid, False otherwise.\n    \"\"\"\n    if not date:\n        return False\n\n    date_parts = _parse_date_parts(date)\n    if date_parts is None:\n        return False\n\n    month, day, year = date_parts\n\n    if not _is_valid_month(month):\n        return False\n\n    if not _is_valid_day(day, month):\n        return False\n\n    return True"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    '''\n    Processes a string based on prioritized rules: whitespace split, comma split, or lowercase odd-order letter count.\n    This function orchestrates helper checks to determine the appropriate operation and return value.\n    '''\n    def _has_whitespace(text: str) -> bool:\n        \"\"\"Checks if the given text contains any whitespace characters.\"\"\"\n        return any(c.isspace() for c in text)\n\n    def _has_comma(text: str) -> bool:\n        \"\"\"Checks if the given text contains a comma character.\"\"\"\n        return ',' in text\n\n    def _count_odd_ordered_lowercase_letters(text: str) -> int:\n        \"\"\"Counts lowercase letters with odd alphabetical order in the text.\"\"\"\n        count = 0\n        for char in text:\n            if 'a' <= char <= 'z':\n                order = ord(char) - ord('a')\n                if order % 2 != 0:\n                    count += 1\n        return count\n\n    if _has_whitespace(txt):\n        return txt.split()\n    elif _has_comma(txt):\n        return txt.split(',')\n    else:\n        return _count_odd_ordered_lowercase_letters(txt)"}
{"task_id": "HumanEval/126", "solution": "from typing import List\nclass Number:\n    \"\"\"A value object representing a non-negative integer.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\nclass NumberList:\n    \"\"\"Manages a list of Number objects and validates their sorting and duplicate constraints.\"\"\"\n    def __init__(self, numbers: List[int]):\n        self._numbers: List[Number] = [Number(num) for num in numbers]\n\n    def evaluate_sort_and_duplicates(self) -> bool:\n        \"\"\"Evaluates if the list is sorted and adheres to duplicate constraints.\"\"\"\n        if not self._is_ascending_sorted():\n            return False\n        return self._has_valid_duplicates()\n\n    def _is_ascending_sorted(self) -> bool:\n        \"\"\"Checks if the list of numbers is sorted in ascending order.\"\"\"\n        for i in range(1, len(self._numbers)):\n            if self._numbers[i].value < self._numbers[i-1].value:\n                return False\n        return True\n\n    def _has_valid_duplicates(self) -> bool:\n        \"\"\"Checks if any number appears more than twice in the list.\"\"\"\n        counts = {}\n        for number_obj in self._numbers:\n            counts[number_obj.value] = counts.get(number_obj.value, 0) + 1\n\n        for count in counts.values():\n            if count > 2:\n                return False\n        return True\ndef is_sorted(lst: List[int]) -> bool:\n    \"\"\"\n    Given a list of numbers, return whether they are sorted in ascending order with valid duplicates.\n    No number appears more than twice, and all numbers are non-negative integers.\n    \"\"\"\n    number_list_obj = NumberList(lst)\n    return number_list_obj.evaluate_sort_and_duplicates()"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    '''\n    Checks if the list is sorted ascending and no number appears more than twice.\n    Assumes non-negative integers as input.\n    '''\n    # First, check if the list is sorted in ascending order.\n    for i in range(1, len(lst)):\n        if lst[i] < lst[i-1]:\n            return False\n\n    # Next, count occurrences of each number and check for more than two duplicates.\n    counts = {}\n    for num in lst:\n        counts[num] = counts.get(num, 0) + 1\n        if counts[num] > 2:\n            return False\n\n    # If both checks pass, the list meets all criteria.\n    return True"}
{"task_id": "HumanEval/125", "solution": "def _has_whitespace(txt: str) -> bool:\n    \"\"\"Checks if the string contains any whitespace characters.\"\"\"\n    return any(c.isspace() for c in txt)\ndef _has_comma(txt: str) -> bool:\n    \"\"\"Checks if the string contains any comma characters.\"\"\"\n    return ',' in txt\ndef _split_by_whitespace(txt: str) -> list[str]:\n    \"\"\"Splits the string by any whitespace characters.\"\"\"\n    return txt.split()\ndef _split_by_comma(txt: str) -> list[str]:\n    \"\"\"Splits the string by comma characters.\"\"\"\n    return txt.split(',')\ndef _count_odd_ordered_lowercase_letters(txt: str) -> int:\n    \"\"\"Counts lowercase letters with an odd alphabetical order (0-indexed, 'a'=0).\"\"\"\n    count = 0\n    for char in txt:\n        if 'a' <= char <= 'z':\n            order = ord(char) - ord('a')\n            if order % 2 != 0:\n                count += 1\n    return count\ndef split_words(txt):\n    \"\"\"\n    Splits text by whitespace, then by commas, or counts odd-ordered lowercase letters.\n    Returns a list of strings or an integer count based on precedence.\n    \"\"\"\n    if _has_whitespace(txt):\n        return _split_by_whitespace(txt)\n    elif _has_comma(txt):\n        return _split_by_comma(txt)\n    else:\n        return _count_odd_ordered_lowercase_letters(txt)"}
{"task_id": "HumanEval/128", "solution": "def _get_sign(number: int) -> int:\n    \"\"\"Returns the sign of a number (1 for positive, -1 for negative, 0 for zero).\"\"\"\n    if number > 0:\n        return 1\n    elif number < 0:\n        return -1\n    else:\n        return 0\ndef _get_magnitude(number: int) -> int:\n    \"\"\"Returns the absolute value (magnitude) of a number.\"\"\"\n    return abs(number)\ndef prod_signs(arr):\n    \"\"\"\n    Calculates the sum of magnitudes of integers in an array multiplied by the product of all signs.\n    Returns None for an empty array.\n    \"\"\"\n    if not arr:\n        return None\n\n    product_of_signs = 1\n    sum_of_magnitudes = 0\n\n    for number in arr:\n        product_of_signs *= _get_sign(number)\n        sum_of_magnitudes += _get_magnitude(number)\n\n    return sum_of_magnitudes * product_of_signs"}
{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"You are given two intervals,\n    where each interval is a pair of integers. For example, interval = (start, end) = (1, 2).\n    The given intervals are closed which means that the interval (start, end)\n    includes both start and end.\n    For each given interval, it is assumed that its start is less or equal its end.\n    Your task is to determine whether the length of intersection of these two\n    intervals is a prime number.\n    Example, the intersection of the intervals (1, 3), (2, 4) is (2, 3)\n    which its length is 1, which not a prime number.\n    If the length of the intersection is a prime number, return \"YES\",\n    otherwise, return \"NO\".\n    If the two intervals don't intersect, return \"NO\".\n\n\n    [input/output] samples:\n    intersection((1, 2), (2, 3)) ==> \"NO\"\n    intersection((-1, 1), (0, 4)) ==> \"NO\"\n    intersection((-3, -1), (-5, 5)) ==> \"YES\"\n    \"\"\"\n    from typing import Tuple, Optional\n\n    class Interval:\n        \"\"\"Represents a closed integer interval (start, end).\"\"\"\n        def __init__(self, start: int, end: int):\n            self._start = start\n            self._end = end\n\n        def get_start(self) -> int:\n            \"\"\"Returns the start point of the interval.\"\"\"\n            return self._start\n\n        def get_end(self) -> int:\n            \"\"\"Returns the end point of the interval.\"\"\"\n            return self._end\n\n    class IntersectionResult:\n        \"\"\"Stores the result of an interval intersection.\"\"\"\n        def __init__(self, intersection_interval: Optional[Interval], length: int):\n            self._intersection_interval = intersection_interval\n            self._length = length\n\n        def get_intersection_interval(self) -> Optional[Interval]:\n            \"\"\"Returns the intersection interval or None.\"\"\"\n            return self._intersection_interval\n\n        def get_length(self) -> int:\n            \"\"\"Returns the length of the intersection.\"\"\"\n            return self._length\n\n        def has_intersection(self) -> bool:\n            \"\"\"Returns True if an intersection exists, False otherwise.\"\"\"\n            return self._intersection_interval is not None\n\n    def _is_prime(n: int) -> bool:\n        \"\"\"Determines if a given integer n is a prime number.\"\"\"\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    def _calculate_length(interval: Interval) -> int:\n        \"\"\"Calculates the length of a given Interval object.\"\"\"\n        return interval.get_end() - interval.get_start() + 1\n\n    def _calculate_intersection(interval1: Interval, interval2: Interval) -> IntersectionResult:\n        \"\"\"Determines the intersection of two Interval objects.\"\"\"\n        start1, end1 = interval1.get_start(), interval1.get_end()\n        start2, end2 = interval2.get_start(), interval2.get_end()\n\n        max_start = max(start1, start2)\n        min_end = min(end1, end2)\n\n        if max_start <= min_end:\n            intersection_interval = Interval(max_start, min_end)\n            length = _calculate_length(intersection_interval)\n            return IntersectionResult(intersection_interval, length)\n        else:\n            return IntersectionResult(None, 0)\n\n    i1 = Interval(interval1[0], interval1[1])\n    i2 = Interval(interval2[0], interval2[1])\n\n    result = _calculate_intersection(i1, i2)\n\n    if not result.has_intersection():\n        return \"NO\"\n\n    length = result.get_length()\n\n    if length == 1:\n        return \"NO\"\n    if length == 2:\n        return \"NO\"\n\n    if _is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/127", "solution": "class Interval:\n    \"\"\"Encapsulates the start and end points of a closed integer interval.\"\"\"\n    def __init__(self, start: int, end: int):\n        self.start = start\n        self.end = end\ndef calculate_intersection(interval1: Interval, interval2: Interval) -> Interval:\n    \"\"\"Calculates the intersection interval (max_start, min_end).\"\"\"\n    max_start = max(interval1.start, interval2.start)\n    min_end = min(interval1.end, interval2.end)\n    return Interval(max_start, min_end)\ndef calculate_length(interval: Interval) -> int:\n    \"\"\"Computes the length of the given interval as end - start + 1.\"\"\"\n    if interval.start > interval.end:\n        return 0 # No actual positive length for non-intersecting intervals.\n    return interval.end - interval.start + 1\ndef is_prime(n: int) -> bool:\n    \"\"\"Checks if n is a prime number (natural number > 1 with only divisors 1 and itself).\"\"\"\n    if n <= 1:\n        return False\n    i = 2\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 1\n    return True\ndef intersection(interval1: tuple[int, int], interval2: tuple[int, int]) -> str:\n    \"\"\"Orchestrates finding the intersection length and checking its primality.\"\"\"\n    # Returns \"YES\" if prime, \"NO\" otherwise.\n\n    int_obj1 = Interval(interval1[0], interval1[1])\n    int_obj2 = Interval(interval2[0], interval2[1])\n\n    intersection_interval = calculate_intersection(int_obj1, int_obj2)\n    length = calculate_length(intersection_interval)\n\n    if is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/128", "solution": "def _get_sign(number):\n    \"\"\"\n    Determines the sign of a number (1 for positive, -1 for negative, 0 for zero).\n    This is an internal helper function for prod_signs.\n    \"\"\"\n    if number > 0:\n        return 1\n    elif number < 0:\n        return -1\n    else:\n        return 0\ndef prod_signs(arr):\n    \"\"\"\n    You are given an array arr of integers and you need to return\n    sum of magnitudes of integers multiplied by product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    Note: return None for empty arr.\n\n    Example:\n    >>> prod_signs([1, 2, 2, -4]) == -9\n    >>> prod_signs([0, 1]) == 0\n    >>> prod_signs([]) == None\n    \"\"\"\n    if not arr:\n        return None\n\n    product_of_signs = 1\n    sum_of_magnitudes = 0\n\n    for number in arr:\n        sign_value = _get_sign(number)\n        product_of_signs *= sign_value\n        sum_of_magnitudes += abs(number)\n\n    final_result = sum_of_magnitudes * product_of_signs\n    return final_result"}
{"task_id": "HumanEval/119", "solution": "class _ParenthesesString:\n    \"\"\"Encapsulates a string of parentheses with validation and balance properties.\"\"\"\n\n    def __init__(self, value: str):\n        self._value = value\n\n    def is_valid_chars(self) -> bool:\n        \"\"\"Checks if the string contains only '(' or ')'. Returns True if valid.\"\"\"\n        for char in self._value:\n            if char != '(' and char != ')':\n                return False\n        return True\n\n    def get_min_balance(self) -> int:\n        \"\"\"Calculates the minimum balance during a left-to-right traversal.\"\"\"\n        balance = 0\n        min_balance = 0\n        for char in self._value:\n            balance += 1 if char == '(' else -1\n            min_balance = min(min_balance, balance)\n        return min_balance\n\n    def get_final_balance(self) -> int:\n        \"\"\"Calculates the final balance (total open minus total close).\"\"\"\n        balance = 0\n        for char in self._value:\n            balance += 1 if char == '(' else -1\n        return balance\n\n    def get_value(self) -> str:\n        \"\"\"Returns the encapsulated string value.\"\"\"\n        return self._value\nclass _ParenthesesMatcher:\n    \"\"\"Determines if concatenating two parentheses strings forms a balanced string.\"\"\"\n\n    def __init__(self):\n        pass\n\n    def can_form_balanced_string(self, s1: _ParenthesesString, s2: _ParenthesesString) -> bool:\n        \"\"\"Checks if s1 + s2 or s2 + s1 results in a balanced string.\"\"\"\n        if self._is_balanced(s1.get_value() + s2.get_value()):\n            return True\n\n        if self._is_balanced(s2.get_value() + s1.get_value()):\n            return True\n\n        return False\n\n    def _is_balanced(self, s: str) -> bool:\n        \"\"\"Checks if a single string `s` is a balanced parentheses string.\"\"\"\n        balance = 0\n        for char in s:\n            balance += 1 if char == '(' else -1\n            if balance < 0:\n                return False\n        return balance == 0\ndef match_parens(lst: list[str]) -> str:\n    \"\"\"\n    Checks if two strings can be concatenated to form a balanced parentheses string.\n    Returns 'Yes' if possible, 'No' otherwise.\n    \"\"\"\n    s1_obj = _ParenthesesString(lst[0])\n    s2_obj = _ParenthesesString(lst[1])\n\n    if not s1_obj.is_valid_chars() or not s2_obj.is_valid_chars():\n        return 'No'\n\n    matcher = _ParenthesesMatcher()\n    if matcher.can_form_balanced_string(s1_obj, s2_obj):\n        return 'Yes'\n    else:\n        return 'No'"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Calculates the first n + 1 terms of a Tribonacci-like sequence using dynamic programming.\n    Handles base cases, even terms, and odd terms with a forward dependency.\"\"\"\n    dp = [0] * (n + 2)\n\n    dp[0] = 1\n    if n >= 1:\n        dp[1] = 3\n\n    # Populate even terms up to n + 1\n    for k in range(2, n + 2):\n        if k % 2 == 0:\n            dp[k] = 1 + k // 2\n\n    # Populate odd terms up to n\n    for k in range(2, n + 1):\n        if k % 2 != 0:\n            dp[k] = dp[k - 1] + dp[k - 2] + dp[k + 1]\n\n    return dp[0 : n + 1]"}
{"task_id": "HumanEval/129", "solution": "class Cell:\n    def __init__(self, row: int, col: int, value: int):\n        self.row = row\n        self.col = col\n        self.value = value\n\n    def __eq__(self, other):\n        # Cells are equal if their coordinates are the same.\n        if not isinstance(other, Cell):\n            return NotImplemented\n        return self.row == other.row and self.col == other.col\n\n    def __hash__(self):\n        # Needed for Cell objects to be stored in sets/dictionaries.\n        return hash((self.row, self.col))\nclass Grid:\n    def __init__(self, grid_values: list[list[int]]):\n        self._N = len(grid_values)\n        self._cells = [[None for _ in range(self._N)] for _ in range(self._N)]\n        for r in range(self._N):\n            for c in range(self._N):\n                self._cells[r][c] = Cell(r, c, grid_values[r][c])\n\n    def get_cell(self, row: int, col: int) -> Cell:\n        # Returns the Cell object at the specified coordinates.\n        return self._cells[row][col]\n\n    def get_neighbors(self, row: int, col: int) -> list[Cell]:\n        # Finds valid adjacent cells (up, down, left, right), enforcing grid boundaries.\n        neighbors = []\n        directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]  # Right, Left, Down, Up\n        for dr, dc in directions:\n            n_row, n_col = row + dr, col + dc\n            if 0 <= n_row < self._N and 0 <= n_col < self._N:\n                neighbors.append(self._cells[n_row][n_col])\n        return neighbors\n\n    def get_N(self) -> int:\n        # Returns the dimension N of the N x N grid.\n        return self._N\nclass Path:\n    def __init__(self, initial_cell: Cell = None, existing_path: 'Path' = None):\n        # Initializes a new path, either empty or as a copy of an existing path.\n        if existing_path:\n            self._visited_cells = list(existing_path._visited_cells)\n            self._values = list(existing_path._values)\n            self._length = existing_path._length\n        else:\n            self._visited_cells = []\n            self._values = []\n            self._length = 0\n            if initial_cell:\n                self.add_cell(initial_cell)\n\n    def add_cell(self, cell: Cell):\n        # Appends a cell to the path, updating its length and values.\n        self._visited_cells.append(cell)\n        self._values.append(cell.value)\n        self._length += 1\n\n    def get_length(self) -> int:\n        # Returns the current number of cells in the path.\n        return self._length\n\n    def get_last_cell(self) -> Cell:\n        # Returns the most recently added cell to the path.\n        return self._visited_cells[-1]\n\n    def get_values(self) -> list[int]:\n        # Returns the ordered list of integer values of cells in the path.\n        return self._values\n\n    def is_complete(self, k: int) -> bool:\n        # Checks if the path has reached the target length k.\n        return self._length == k\n\n    def __lt__(self, other: 'Path') -> bool:\n        # Compares two paths lexicographically based on their values.\n        return self._values < other._values\nclass PathFinderService:\n    def find_minimum_path(self, grid: Grid, k: int) -> list[int]:\n        # Finds all possible paths of length k and returns the lexicographically smallest one.\n        all_paths = []\n        N = grid.get_N()\n\n        for r in range(N):\n            for c in range(N):\n                start_cell = grid.get_cell(r, c)\n                initial_path = Path(initial_cell=start_cell)\n                self._find_all_paths_recursive(grid, initial_path, k, all_paths)\n\n        # Sort all paths to find the lexicographically smallest.\n        all_paths.sort()\n        return all_paths[0].get_values()\n\n    def _find_all_paths_recursive(self, grid: Grid, current_path: Path, k: int, all_paths: list[Path]):\n        # Recursively explores paths, adding complete paths of length k to all_paths.\n        if current_path.is_complete(k):\n            all_paths.append(current_path)\n            return\n\n        last_cell = current_path.get_last_cell()\n        neighbors = grid.get_neighbors(last_cell.row, last_cell.col)\n\n        for neighbor_cell in neighbors:\n            new_path = Path(existing_path=current_path)\n            new_path.add_cell(neighbor_cell)\n            self._find_all_paths_recursive(grid, new_path, k, all_paths)\ndef minPath(grid_values: list[list[int]], k: int) -> list[int]:\n    \"\"\"\n    Given a grid and a length k, finds the lexicographically smallest path of length k.\n    This function orchestrates grid processing and pathfinding services to determine the minimum path.\n    \"\"\"\n    grid_obj = Grid(grid_values)\n    path_finder = PathFinderService()\n    min_path_values = path_finder.find_minimum_path(grid_obj, k)\n    return min_path_values"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n\n    class Digit:\n        \"\"\"Represents an individual digit.\"\"\"\n        def __init__(self, value: int):\n            self.value = value\n\n        def is_odd(self) -> bool:\n            \"\"\"Checks if the digit is odd.\"\"\"\n            return self.value % 2 != 0\n\n    class InputInteger:\n        \"\"\"Represents the input integer and provides digit extraction.\"\"\"\n        def __init__(self, value: int):\n            self.value = value\n\n        def get_digits(self) -> list[Digit]:\n            \"\"\"Extracts individual digits as Digit objects.\"\"\"\n            return [Digit(int(char)) for char in str(self.value)]\n\n    # This section orchestrates the core logic as per odd_digit_product_module.\n    input_int = InputInteger(n)\n    digit_objects = input_int.get_digits()\n\n    product = 1\n    found_odd = False\n\n    for digit in digit_objects:\n        if digit.is_odd():\n            product *= digit.value\n            found_odd = True\n\n    if not found_odd:\n        return 0\n    else:\n        return product"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n    product = 1\n    found_odd_digit = False\n\n    for digit_char in str(n):\n        digit = int(digit_char)\n        if digit % 2 != 0:\n            product *= digit\n            found_odd_digit = True\n\n    if found_odd_digit:\n        return product\n    else:\n        return 0"}
{"task_id": "HumanEval/129", "solution": "from typing import List, Optional\ndef minPath(grid, k):\n    \"\"\"\n    Finds the lexicographically smallest path of length k in a grid.\n    Returns an ordered list of values on the cells of the minimum path.\n    \"\"\"\n\n    class Cell:\n        def __init__(self, value: int, row: int, col: int):\n            self.value = value\n            self.row = row\n            self.col = col\n            self._grid_ref: Optional['Grid'] = None\n\n        def set_grid_ref(self, grid_instance: 'Grid'):\n            \"\"\"Sets the reference to the parent Grid object.\"\"\"\n            self._grid_ref = grid_instance\n\n        def get_neighbors(self) -> List['Cell']:\n            \"\"\"Returns a list of valid neighboring cells.\"\"\"\n            neighbors = []\n            directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n            for dr, dc in directions:\n                n_row, n_col = self.row + dr, self.col + dc\n                if self._grid_ref.is_valid_coordinate(n_row, n_col):\n                    neighbors.append(self._grid_ref.get_cell(n_row, n_col))\n            return neighbors\n\n        def __eq__(self, other: object) -> bool:\n            \"\"\"Compares cells based on their coordinates.\"\"\"\n            return self.row == other.row and self.col == other.col\n\n        def __hash__(self) -> int:\n            \"\"\"Enables Cell objects to be stored in sets or as dictionary keys.\"\"\"\n            return hash((self.row, self.col))\n\n        def __repr__(self) -> str:\n            return f\"Cell(value={self.value}, row={self.row}, col={self.col})\"\n\n    class Grid:\n        def __init__(self, N: int, values: List[List[int]]):\n            self.N = N\n            self.cells: List[List[Cell]] = []\n            for r in range(N):\n                row_cells = []\n                for c in range(N):\n                    cell = Cell(values[r][c], r, c)\n                    cell.set_grid_ref(self)\n                    row_cells.append(cell)\n                self.cells.append(row_cells)\n\n        def get_cell(self, row: int, col: int) -> Cell:\n            \"\"\"Returns the cell at the specified row and column.\"\"\"\n            return self.cells[row][col]\n\n        def is_valid_coordinate(self, row: int, col: int) -> bool:\n            \"\"\"Checks if a given coordinate is within grid bounds.\"\"\"\n            return 0 <= row < self.N and 0 <= col < self.N\n\n        def __repr__(self) -> str:\n            return f\"Grid(N={self.N})\"\n\n    class Path:\n        def __init__(self, sequence_of_cells: List[Cell]):\n            self.sequence_of_cells = sequence_of_cells\n            self.values = [cell.value for cell in sequence_of_cells]\n            self.length = len(self.values)\n\n        def is_lexicographically_less_than(self, other_path: 'Path') -> bool:\n            \"\"\"Compares this path with another path lexicographically.\"\"\"\n            for i in range(self.length):\n                if self.values[i] < other_path.values[i]:\n                    return True\n                if self.values[i] > other_path.values[i]:\n                    return False\n            return False\n\n        def __lt__(self, other_path: 'Path') -> bool:\n            \"\"\"Enables direct comparison using the '<' operator.\"\"\"\n            return self.is_lexicographically_less_than(other_path)\n\n        def __repr__(self) -> str:\n            return f\"Path(values={self.values})\"\n\n    class PathFinder:\n        def __init__(self, grid_instance: Grid, k_length: int):\n            self._grid = grid_instance\n            self._k = k_length\n\n        def _dfs(self, current_cell: Cell, current_path_cells: List[Cell], all_paths: List[Path]) -> None:\n            \"\"\"Recursively explores paths of length k and collects them.\"\"\"\n            current_path_cells.append(current_cell)\n\n            if len(current_path_cells) == self._k:\n                all_paths.append(Path(list(current_p