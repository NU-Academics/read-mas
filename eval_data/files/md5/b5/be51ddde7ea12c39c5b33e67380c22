{"task_id": "HumanEval/6", "solution": "from typing import List\ndef _calculate_group_nesting_level(group_string: str) -> int:\n    \"\"\"Calculates the deepest nesting level for a single group of parentheses.\n    It tracks current depth and updates the maximum encountered depth.\n    \"\"\"\n    current_max_depth = 0\n    current_depth = 0\n    for char in group_string:\n        if char == '(':\n            current_depth += 1\n        elif char == ')':\n            current_depth -= 1\n        current_max_depth = max(current_max_depth, current_depth)\n    return current_max_depth\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"Input is a string with multiple groups of nested parentheses separated by spaces.\n    Outputs the deepest level of nesting for each group.\n    \"\"\"\n    paren_groups = paren_string.split(' ')\n    result_list = []\n    for group_string in paren_groups:\n        if group_string:  # Handle potential empty strings from multiple spaces\n            nesting_level = _calculate_group_nesting_level(group_string)\n            result_list.append(nesting_level)\n    return result_list"}
{"task_id": "HumanEval/6", "solution": "from typing import List\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\"\"\"\n\n    def _parse_groups(s: str) -> List[str]:\n        \"\"\"Splits the input string into individual parentheses group strings by spaces.\"\"\"\n        return s.split(' ')\n\n    def _calculate_deepest_nesting_for_group(group_string: str) -> int:\n        \"\"\"Calculates the deepest nesting level for a single group of parentheses.\"\"\"\n        current_nesting_level = 0\n        max_nesting_level = 0\n        for char in group_string:\n            if char == '(':\n                current_nesting_level += 1\n            elif char == ')':\n                current_nesting_level -= 1\n            max_nesting_level = max(max_nesting_level, current_nesting_level)\n        return max_nesting_level\n\n    groups = _parse_groups(paren_string)\n    results = []\n    for group in groups:\n        results.append(_calculate_deepest_nesting_for_group(group))\n\n    return results"}
