{"task_id": "HumanEval/57", "solution": "def monotonic(l: list) -> bool:\n    \"\"\"Return True if list elements are monotonically increasing or decreasing.\n    This includes lists that are constant, empty, or have a single element.\n    \"\"\"\n    if len(l) <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(len(l) - 1):\n        if l[i] > l[i+1]:\n            is_increasing = False\n        if l[i] < l[i+1]:\n            is_decreasing = False\n\n        # Optimization: if both conditions are broken, no need to check further\n        if not is_increasing and not is_decreasing:\n            return False\n\n    return is_increasing or is_decreasing"}
{"task_id": "HumanEval/58", "solution": "def _identify_common_elements(list1: list, list2: list) -> set:\n    \"\"\"Finds common elements between two lists using set intersection.\n    Returns them as a set, ensuring uniqueness.\"\"\"\n    set1 = set(list1)\n    set2 = set(list2)\n    return set1 & set2\ndef _sort_elements(elements: set) -> list:\n    \"\"\"Sorts a set of elements in ascending order and returns them as a list.\"\"\"\n    return sorted(list(elements))\ndef common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\n    This function leverages helper methods for identification and sorting.\"\"\"\n    common_elements_set = _identify_common_elements(l1, l2)\n    sorted_unique_common_elements_list = _sort_elements(common_elements_set)\n    return sorted_unique_common_elements_list"}
{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str) -> bool:\n    \"\"\"Checks if a string of '<' and '>' characters is correctly balanced.\n    Returns True if every opening bracket has a corresponding closing bracket and the sequence is valid.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '<':\n            balance += 1\n        elif char == '>':\n            balance -= 1\n        if balance < 0: # Early exit if a closing bracket appears without a preceding opening one.\n            return False\n    return balance == 0 # Final balance must be zero for correct bracketing."}
{"task_id": "HumanEval/57", "solution": "def _is_monotonically_increasing(l: list) -> bool:\n    \"\"\"Checks if a list is monotonically increasing (non-decreasing).\"\"\"\n    for i in range(1, len(l)):\n        if l[i] < l[i-1]:\n            return False\n    return True\ndef _is_monotonically_decreasing(l: list) -> bool:\n    \"\"\"Checks if a list is monotonically decreasing (non-increasing).\"\"\"\n    for i in range(1, len(l)):\n        if l[i] > l[i-1]:\n            return False\n    return True\ndef monotonic(l: list) -> bool:\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    \"\"\"\n    if len(l) <= 1:\n        return True\n\n    if _is_monotonically_increasing(l):\n        return True\n\n    return _is_monotonically_decreasing(l)"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list) -> list:\n    \"\"\"\n    Identifies unique common elements from two lists and returns them sorted in ascending order.\n\n    Args:\n        l1 (list): The first input list.\n        l2 (list): The second input list.\n    \"\"\"\n    set1 = set(l1)\n    set2 = set(l2)\n    common_set = set1.intersection(set2)\n    result_list = list(common_set)\n    result_list.sort()\n    return result_list"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\"\"\"\n    max_prime = 1\n\n    # Divide by 2 until n is odd\n    while n % 2 == 0:\n        max_prime = 2\n        n //= 2\n\n    # Check for odd factors starting from 3\n    i = 3\n    while i * i <= n:\n        while n % i == 0:\n            max_prime = i\n            n //= i\n        i += 2  # Increment by 2 to check only odd numbers\n\n    # If n remains greater than 2, it is a prime factor itself and must be the largest\n    if n > 2:\n        max_prime = n\n\n    return max_prime"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int) -> int:\n    \"\"\"Return the largest prime factor of n.\n    Assumes n > 1 and is not a prime number.\n    \"\"\"\n    largest_factor = 1\n\n    # Handle the factor of 2: repeatedly divide n by 2\n    while n % 2 == 0:\n        largest_factor = 2\n        n //= 2\n\n    # Iterate through odd numbers starting from 3 up to the square root of n\n    i = 3\n    while i * i <= n:\n        # If i is a factor, update largest_factor and divide n by i\n        while n % i == 0:\n            largest_factor = i\n            n //= i\n        i += 2 # Move to the next odd number\n\n    # If n is still greater than 2 after divisions, it means the remaining n is prime and the largest factor\n    if n > 2:\n        largest_factor = n\n\n    return largest_factor"}
