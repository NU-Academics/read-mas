{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"\n    Calculates the first n + 1 numbers of a specific Tribonacci sequence.\n    It applies defined recurrence relations with memoization for efficiency.\n    \"\"\"\n    _memo = {}\n\n    def _calculate_tribonacci_value(k: int) -> int:\n        \"\"\"\n        Calculates a single Tribonacci value tri(k) using recurrence relations.\n        This helper function utilizes the parent's memoization dictionary.\n        \"\"\"\n        if k in _memo:\n            return _memo[k]\n\n        result: int\n        if k == 0:\n            result = 1\n        elif k == 1:\n            result = 3\n        elif k % 2 == 0:  # k is even, k >= 2\n            result = 1 + k // 2\n        else:  # k is odd, k >= 3\n            val_k_minus_1 = _calculate_tribonacci_value(k - 1)\n            val_k_minus_2 = _calculate_tribonacci_value(k - 2)\n            val_k_plus_1 = _calculate_tribonacci_value(k + 1)\n            result = val_k_minus_1 + val_k_minus_2 + val_k_plus_1\n\n        _memo[k] = result\n        return result\n\n    sequence = []\n    for k in range(n + 1):\n        sequence.append(_calculate_tribonacci_value(k))\n    return sequence"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    \"\"\"\n    Checks if a string of square brackets contains a valid subsequence with at least one nested bracket.\n    Nesting occurs when one valid bracket pair `[]` is entirely contained within another valid pair `[]`.\n    \"\"\"\n    stack = []  # Stores indices of opening brackets '['\n    valid_pairs_indices = []  # Stores (open_idx, close_idx) for all valid bracket pairs\n\n    for i, char in enumerate(string):\n        if char == '[':\n            stack.append(i)\n        elif char == ']':\n            if stack:  # If there's an opening bracket to match\n                open_idx = stack.pop()\n                valid_pairs_indices.append((open_idx, i))\n\n    # After identifying all valid pairs, check for nesting\n    for outer_open, outer_close in valid_pairs_indices:\n        for inner_open, inner_close in valid_pairs_indices:\n            # A pair (inner_open, inner_close) is nested within (outer_open, outer_close)\n            # if the outer opening bracket comes before the inner opening bracket,\n            # and the inner closing bracket comes before the outer closing bracket.\n            if outer_open < inner_open and inner_close < outer_close:\n                return True\n\n    return False"}
{"task_id": "HumanEval/133", "solution": "import math\ndef _round_up(number):\n    \"\"\"Rounds a number up to its ceiling integer.\n    Uses math.ceil and casts to int to meet design return type.\n    \"\"\"\n    return int(math.ceil(number))\ndef _square(number):\n    \"\"\"Squares an integer.\"\"\"\n    return number * number\ndef sum_squares(lst):\n    \"\"\"You are given a list of numbers.\n    You need to return the sum of squared numbers in the given list,\n    round each element in the list to the upper int(Ceiling) first.\n    \"\"\"\n    total_sum = 0\n    for number in lst:\n        rounded_num = _round_up(number)\n        squared_num = _square(rounded_num)\n        total_sum += squared_num\n    return total_sum"}
{"task_id": "HumanEval/133", "solution": "import math\nclass Number:\n    \"\"\"Represents a single numerical value undergoing transformation.\n    Encapsulates a number's value and provides methods for rounding up and squaring it.\n    \"\"\"\n    def __init__(self, original_value: float):\n        self._original_value = original_value\n        self._rounded_value: int = 0\n        self._squared_value: int = 0\n\n    def round_up(self) -> int:\n        \"\"\"Rounds the original value up to the nearest integer (ceiling).\n        Stores the result in _rounded_value and returns it.\n        \"\"\"\n        self._rounded_value = math.ceil(self._original_value)\n        return self._rounded_value\n\n    def square(self) -> int:\n        \"\"\"Squares the rounded value.\n        Stores the result in _squared_value and returns it.\n        \"\"\"\n        self._squared_value = self._rounded_value ** 2\n        return self._squared_value\n\n    def get_squared_value(self) -> int:\n        \"\"\"Returns the squared value.\n        \"\"\"\n        return self._squared_value\ndef sum_squares(lst):\n    \"\"\"Returns the sum of squared numbers from the input list,\n    after rounding each element up to the nearest integer.\n    \"\"\"\n    total_sum = 0\n\n    for num_val in lst:\n        number_processor = Number(num_val)\n        number_processor.round_up()\n        number_processor.square()\n        total_sum += number_processor.get_squared_value()\n\n    return total_sum"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    \"\"\"\n    Checks if a string of square brackets contains a valid subsequence where at least one bracket is nested.\n    Returns True if a [[ ]] pattern is found, False otherwise.\n    \"\"\"\n    for char in string:\n        if char not in ['[', ']']:\n            return False\n\n    idx_open1 = string.find('[')\n    if idx_open1 == -1:\n        return False\n\n    idx_open2 = string.find('[', idx_open1 + 1)\n    if idx_open2 == -1:\n        return False\n\n    idx_close1 = string.find(']', idx_open2 + 1)\n    if idx_close1 == -1:\n        return False\n\n    idx_close2 = string.find(']', idx_close1 + 1)\n    if idx_close2 == -1:\n        return False\n\n    return True"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Checks if the last character of a string is an alphabetical character\n    and is not part of a preceding word.\n    \"\"\"\n    if not txt:  # FR1: Return False if input string is empty\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():  # FR2: Return False if last char is not alphabetical\n        return False\n\n    if len(txt) == 1:  # FR3: Return True if string has length 1 and last char is alphabetical\n        return True\n    else:  # len(txt) > 1\n        preceding_char = txt[-2]\n        if preceding_char == ' ':  # FR4: Return True if preceding char is a space\n            return True\n        else:  # FR5: Return False if preceding char is not a space\n            return False"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Checks if the last character of a string is an alphabetical character and not part of a word.\n    A \"word\" is defined as a group of characters separated by spaces.\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    if len(txt) == 1:\n        return True\n    else:\n        return txt[-2] == ' '"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr: list) -> int:\n    \"\"\"\n    Identifies the largest index i such that arr[i] < arr[i-1].\n    If no such index exists, returns -1.\n    \"\"\"\n    largest_index = -1\n    for i in range(1, len(arr)):\n        if arr[i] < arr[i-1]:\n            largest_index = i\n    return largest_index"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr: list[int]) -> int:\n    \"\"\"Finds the largest index i where arr[i] is strictly less than arr[i-1].\n    Returns -1 if no such index exists.\"\"\"\n    largest_invalid_index = -1\n    for i in range(1, len(arr)):\n        if arr[i] < arr[i-1]:\n            largest_invalid_index = i\n    return largest_invalid_index"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    \"\"\"\n    Identifies the largest negative and smallest positive integers in a list.\n    Returns (largest_negative, smallest_positive), using None if no such integers are found.\n    \"\"\"\n    largest_negative = None\n    smallest_positive = None\n\n    for number in lst:\n        if number < 0:\n            if largest_negative is None or number > largest_negative:\n                largest_negative = number\n        elif number > 0:\n            if smallest_positive is None or number < smallest_positive:\n                smallest_positive = number\n\n    return (largest_negative, smallest_positive)"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers.\n    This function returns False for odd numbers or even numbers less than 8, otherwise True.\n    Example\n    is_equal_to_sum_even(4) == False\n    is_equal_to_sum_even(6) == False\n    is_equal_to_sum_even(8) == True\n    \"\"\"\n    if n % 2 != 0:\n        return False\n    elif n < 8:\n        return False\n    else:\n        return True"}
{"task_id": "HumanEval/137", "solution": "from typing import Union, Any\ndef _parse_string_to_float(s: str) -> float:\n    \"\"\"\n    Converts a string representing a real number into a float,\n    handling both '.' and ',' as decimal separators.\n    \"\"\"\n    s = s.replace(',', '.')\n    return float(s)\nclass _ParsedValue:\n    \"\"\"\n    Internal helper class to encapsulate an input value, its original type,\n    and its parsed numeric representation for comparison.\n    \"\"\"\n    def __init__(self, value: Union[int, float, str]):\n        self._original_representation = value\n        self._original_type = type(value)\n        if isinstance(value, str):\n            self._numeric_value = _parse_string_to_float(value)\n        else:\n            self._numeric_value = float(value)\n\n    def get_original_representation(self) -> Any:\n        \"\"\"\n        Returns the original input value.\n        \"\"\"\n        return self._original_representation\n\n    def get_numeric_value(self) -> float:\n        \"\"\"\n        Returns the parsed numeric (float) value.\n        \"\"\"\n        return self._numeric_value\ndef compare_one(a: Union[int, float, str], b: Union[int, float, str]) -> Union[int, float, str, None]:\n    \"\"\"\n    Compares two input values (integers, floats, or strings representing\n    real numbers) and returns the larger variable in its given variable type.\n    Returns None if the values are numerically equal.\n\n    Args:\n        a: The first value for comparison. Can be an integer, a float, or a string.\n        b: The second value for comparison. Can be an integer, a float, or a string.\n\n    Returns:\n        The numerically larger of a or b, preserving its original input type.\n        Returns None if the numeric values of a and b are equal.\n\n    Examples:\n        compare_one(1, 2.5) # \u279e 2.5\n        compare_one(1, \"2,3\") # \u279e \"2,3\"\n        compare_one(\"5,1\", \"6\") # \u279e \"6\"\n        compare_one(\"1\", 1) # \u279e None\n    \"\"\"\n    parsed_a = _ParsedValue(a)\n    parsed_b = _ParsedValue(b)\n\n    numeric_a = parsed_a.get_numeric_value()\n    numeric_b = parsed_b.get_numeric_value()\n\n    if numeric_a == numeric_b:\n        return None\n    elif numeric_a > numeric_b:\n        return parsed_a.get_original_representation()\n    else:\n        return parsed_b.get_original_representation()"}
{"task_id": "HumanEval/137", "solution": "def _to_float(value):\n    \"\"\"Converts a value (int, float, or string) to its float representation, handling comma decimals in strings.\"\"\"\n    return float(str(value).replace(',', '.'))\ndef compare_one(a, b):\n    \"\"\"\n    Create a function that takes integers, floats, or strings representing\n    real numbers, and returns the larger variable in its given variable type.\n    Return None if the values are equal.\n    Note: If a real number is represented as a string, the floating point might be . or ,\n\n    compare_one(1, 2.5) \u279e 2.5\n    compare_one(1, \"2,3\") \u279e \"2,3\"\n    compare_one(\"5,1\", \"6\") \u279e \"6\"\n    compare_one(\"1\", 1) \u279e None\n    \"\"\"\n    a_numeric = _to_float(a)\n    b_numeric = _to_float(b)\n\n    if a_numeric > b_numeric:\n        return a\n    elif b_numeric > a_numeric:\n        return b\n    else:\n        return None"}
{"task_id": "HumanEval/139", "solution": "def _factorial(k):\n    \"\"\"Calculates the standard factorial of k.\n    Assumes k is a non-negative integer.\n    \"\"\"\n    if k == 0:\n        return 1\n    res = 1\n    for i in range(1, k + 1):\n        res *= i\n    return res\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    brazilian_fact_result = 1\n    for i in range(n, 0, -1):\n        brazilian_fact_result *= _factorial(i)\n    return brazilian_fact_result"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers.\n    This is true if n is even and greater than or equal to 8.\"\"\"\n    return n % 2 == 0 and n >= 8"}
{"task_id": "HumanEval/140", "solution": "def fix_spaces(text):\n    \"\"\"\n    Transforms input strings by applying specific rules for space character replacement.\n    Single spaces become underscores, two spaces become double underscores, and three or more spaces become a hyphen.\n    \"\"\"\n    modified_chars = []\n    i = 0\n    n = len(text)\n\n    while i < n:\n        if text[i] == ' ':\n            space_count = 0\n            # Count consecutive spaces\n            while i < n and text[i] == ' ':\n                space_count += 1\n                i += 1\n\n            # Apply rules based on space_count, prioritizing longer sequences\n            if space_count >= 3: # BR2: Replace ' {3,}' with '-'\n                modified_chars.append('-')\n            elif space_count == 2: # BR4: Replace ' {2}' with '__'\n                modified_chars.append('__')\n            else: # space_count == 1, BR1: Replace ' ' with '_'\n                modified_chars.append('_')\n        else:\n            modified_chars.append(text[i])\n            i += 1\n\n    return \"\".join(modified_chars)"}
{"task_id": "HumanEval/140", "solution": "def fix_spaces(text):\n    \"\"\"\n    Normalizes spaces in the text: replaces sequences of 3+ spaces with a hyphen,\n    and all other single/double spaces with underscores.\n    \"\"\"\n    result_chars = []\n    current_space_count = 0\n\n    for char in text:\n        if char == ' ':\n            current_space_count += 1\n        else:\n            # If we accumulated spaces before this non-space character\n            if current_space_count > 0:\n                if current_space_count >= 3:\n                    result_chars.append('-')\n                else: # current_space_count is 1 or 2\n                    result_chars.append('_' * current_space_count)\n\n            result_chars.append(char)\n            current_space_count = 0 # Reset space count after a non-space character\n\n    # Handle any trailing spaces at the end of the text\n    if current_space_count > 0:\n        if current_space_count >= 3:\n            result_chars.append('-')\n        else:\n            result_chars.append('_' * current_space_count)\n\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/141", "solution": "class FileExtension:\n    \"\"\"Encapsulates file extension validation logic.\n    It checks if an extension is within a predefined list of allowed types.\"\"\"\n    _ALLOWED_EXTENSIONS: list[str] = ['txt', 'exe', 'dll']\n\n    def __init__(self, value: str):\n        \"\"\"Initializes the FileExtension object with its string value.\"\"\"\n        self._value = value\n\n    def is_allowed(self) -> bool:\n        \"\"\"Checks if the extension is in the list of allowed extensions.\"\"\"\n        return self._value in self._ALLOWED_EXTENSIONS\nclass FileNamePrefix:\n    \"\"\"Handles validation rules specific to the file name prefix.\n    It checks for non-empty and starting with a Latin letter.\"\"\"\n    def __init__(self, value: str):\n        \"\"\"Initializes the FileNamePrefix object with its string value.\"\"\"\n        self._value = value\n\n    def is_non_empty(self) -> bool:\n        \"\"\"Checks if the prefix string is not empty.\"\"\"\n        return len(self._value) > 0\n\n    def starts_with_latin_letter(self) -> bool:\n        \"\"\"Checks if the prefix starts with a Latin alphabet letter.\"\"\"\n        return len(self._value) > 0 and self._value[0].isalpha()\nclass FileName:\n    \"\"\"Encapsulates a file name string and orchestrates all validation checks.\n    It delegates prefix and extension specific rules to composed objects.\"\"\"\n    def __init__(self, name: str):\n        \"\"\"Initializes the FileName object with the given file name.\"\"\"\n        self._name = name\n        self._prefix: 'FileNamePrefix | None' = None\n        self._extension: 'FileExtension | None' = None\n\n    def _count_digits(self) -> int:\n        \"\"\"Counts digits ('0'-'9') present in the file name string.\"\"\"\n        digit_count = 0\n        for char in self._name:\n            if '0' <= char <= '9':\n                digit_count += 1\n        return digit_count\n\n    def _count_dots(self) -> int:\n        \"\"\"Counts occurrences of a dot ('.') in the file name string.\"\"\"\n        return self._name.count('.')\n\n    def _split_name_and_extension(self) -> tuple[str, str]:\n        \"\"\"Splits the file name into its prefix and extension parts.\n        Assumes the file name contains exactly one dot.\"\"\"\n        parts = self._name.split('.', 1)\n        return parts[0], parts[1]\n\n    def validate(self) -> bool:\n        \"\"\"Orchestrates all validation rules for the file name.\n        Returns True if all conditions are met, False otherwise.\"\"\"\n        # FR4: Digit Count Validation\n        if self._count_digits() > 3:\n            return False\n\n        # FR5: Dot Count Validation\n        dot_count = self._count_dots()\n        if dot_count != 1:\n            return False\n\n        # If exactly one dot, proceed with splitting and sub-validations\n        prefix_str, extension_str = self._split_name_and_extension()\n        self._prefix = FileNamePrefix(prefix_str)\n        self._extension = FileExtension(extension_str)\n\n        # FR6: Non-Empty Prefix Validation\n        if not self._prefix.is_non_empty():\n            return False\n\n        # FR7: Prefix Starts with Latin Letter Validation\n        if not self._prefix.starts_with_latin_letter():\n            return False\n\n        # FR8: Extension Type Validation\n        if not self._extension.is_allowed():\n            return False\n\n        return True\ndef file_name_check(file_name: str) -> str:\n    \"\"\"Validates a file name string according to specified rules.\n    Returns 'Yes' if the file name is valid, 'No' otherwise.\"\"\"\n    file_obj = FileName(file_name)\n    if file_obj.validate():\n        return 'Yes'\n    else:\n        return 'No'"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    This function processes a list of integers, squaring entries at indices that are multiples of 3,\n    cubing entries at indices that are multiples of 4 (but not 3), and summing the results.\n    It returns 0 if the input list is empty.\n    \"\"\"\n    if not lst:\n        return 0\n\n    total_sum = 0\n    for i, entry in enumerate(lst):\n        processed_value = entry\n        if i % 3 == 0:\n            processed_value = entry * entry\n        elif i % 4 == 0: # Implies i % 3 != 0 due to the `elif`\n            processed_value = entry * entry * entry\n\n        total_sum += processed_value\n\n    return total_sum"}
{"task_id": "HumanEval/139", "solution": "def _factorial(k):\n    \"\"\"Calculates the factorial of a non-negative integer k.\n    This helper function is used by special_factorial.\"\"\"\n    if k == 0:\n        return 1\n    res = 1\n    for i in range(1, k + 1):\n        res *= i\n    return res\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"n must be greater than 0\")\n\n    brazilian_factorial_result = 1\n    for i in range(n, 0, -1):\n        current_factorial = _factorial(i)\n        brazilian_factorial_result *= current_factorial\n    return brazilian_factorial_result"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    Processes a list of integers, transforming entries based on their index.\n    It squares entries at indices multiple of 3, cubes entries at indices multiple of 4 (but not 3), and returns the sum of all processed values.\n    \"\"\"\n    total_sum = 0\n\n    if not lst:\n        return 0\n\n    for index, value in enumerate(lst):\n        processed_value = value\n        if index % 3 == 0:\n            processed_value = value * value\n        elif index % 4 == 0:  # and index % 3 != 0 is implicitly handled by elif\n            processed_value = value * value * value\n\n        total_sum += processed_value\n\n    return total_sum"}
{"task_id": "HumanEval/143", "solution": "def is_prime(number: int) -> bool:\n    \"\"\"Checks if a given number is a prime number.\"\"\"\n    if number < 2:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n    i = 3\n    while i * i <= number:\n        if number % i == 0:\n            return False\n        i += 2\n    return True\ndef words_in_sentence(sentence: str) -> str:\n    \"\"\"\n    Processes a sentence to extract words whose lengths are prime numbers.\n    The order of words is preserved in the output string.\n    \"\"\"\n    words = sentence.split()\n    prime_length_words = []\n    for word in words:\n        if is_prime(len(word)):\n            prime_length_words.append(word)\n    return \" \".join(prime_length_words)"}
{"task_id": "HumanEval/144", "solution": "class Fraction:\n    \"\"\"Represents a fraction with a numerator and a denominator.\"\"\"\n\n    def __init__(self, numerator: int, denominator: int):\n        self.numerator = numerator\n        self.denominator = denominator\n\n    @staticmethod\n    def parse(fractionString: str) -> 'Fraction':\n        \"\"\"Parses a fraction string into a Fraction object.\"\"\"\n        num_str, den_str = fractionString.split('/')\n        return Fraction(int(num_str), int(den_str))\n\n    def multiply(self, other: 'Fraction') -> 'Fraction':\n        \"\"\"Multiplies this fraction by another fraction.\"\"\"\n        new_numerator = self.numerator * other.numerator\n        new_denominator = self.denominator * other.denominator\n        return Fraction(new_numerator, new_denominator)\n\n    def is_whole_number(self) -> bool:\n        \"\"\"Checks if the fraction represents a whole number.\"\"\"\n        return self.numerator % self.denominator == 0\ndef simplify(x, n):\n    \"\"\"Checks if the product of two fractions is a whole number.\n    Fractions are provided as string representations.\"\"\"\n    x_fraction = Fraction.parse(x)\n    n_fraction = Fraction.parse(n)\n    product_fraction = x_fraction.multiply(n_fraction)\n    return product_fraction.is_whole_number()"}
{"task_id": "HumanEval/143", "solution": "def is_prime(number: int) -> bool:\n    \"\"\"Checks if a number is prime. Uses trial division for efficiency.\"\"\"\n    if number < 2:\n        return False\n    if number == 2:\n        return True\n    if number % 2 == 0:\n        return False\n    i = 3\n    while i * i <= number:\n        if number % i == 0:\n            return False\n        i += 2\n    return True\ndef words_in_sentence(sentence):\n    \"\"\"\n    Filters words from a sentence based on prime length.\n    Returns words in original order, separated by spaces.\n    \"\"\"\n    words = sentence.split(' ')\n    filtered_words = []\n\n    for word in words:\n        if is_prime(len(word)):\n            filtered_words.append(word)\n\n    return ' '.join(filtered_words)"}
{"task_id": "HumanEval/145", "solution": "def _calculate_digit_sum(n):\n    \"\"\"Calculates the sum of the absolute value of digits for a given integer.\"\"\"\n    s = str(abs(n))\n    digit_sum = 0\n    for digit_char in s:\n        digit_sum += int(digit_char)\n    return digit_sum\ndef order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers based on the sum of their absolute digits,\n    using original index for tie-breaking.\n    \"\"\"\n    if not nums:\n        return []\n\n    processed_data = []\n    for original_index, num in enumerate(nums):\n        digit_sum = _calculate_digit_sum(num)\n        processed_data.append((digit_sum, original_index, num))\n\n    # Sort primarily by digit_sum, secondarily by original_index\n    processed_data.sort(key=lambda x: (x[0], x[1]))\n\n    # Extract the original integer values from the sorted data\n    sorted_nums = [item[2] for item in processed_data]\n    return sorted_nums"}
{"task_id": "HumanEval/144", "solution": "def simplify(x: str, n: str) -> bool:\n    \"\"\"\n    Checks if the product of two fraction strings (x * n) is a whole number.\n    Returns True if the product is a whole number, False otherwise.\n    \"\"\"\n    numerator_x_str, denominator_x_str = x.split('/')\n    numerator_x = int(numerator_x_str)\n    denominator_x = int(denominator_x_str)\n\n    numerator_n_str, denominator_n_str = n.split('/')\n    numerator_n = int(numerator_n_str)\n    denominator_n = int(denominator_n_str)\n\n    product_numerator = numerator_x * numerator_n\n    product_denominator = denominator_x * denominator_n\n\n    return product_numerator % product_denominator == 0"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers by sum of digits (absolute) and then original index.\n    Helper classes Integer and IntegerList encapsulate sorting logic as per design.\n    \"\"\"\n\n    class Integer:\n        \"\"\"\n        Represents an integer with its value, original index, and calculated sum of digits.\n        \"\"\"\n        def __init__(self, value: int, original_index: int):\n            self._value = value\n            self._original_index = original_index\n            self._sum_of_digits = None\n\n        def calculate_sum_of_digits(self) -> None:\n            \"\"\"Calculates and stores the sum of absolute digits for the integer.\"\"\"\n            num_str = str(abs(self._value))\n            self._sum_of_digits = sum(int(digit) for digit in num_str)\n\n        def get_value(self) -> int:\n            \"\"\"Returns the original integer value.\"\"\"\n            return self._value\n\n        def get_original_index(self) -> int:\n            \"\"\"Returns the original index in the input list.\"\"\"\n            return self._original_index\n\n        def get_sum_of_digits(self) -> int:\n            \"\"\"Returns the calculated sum of absolute digits.\"\"\"\n            return self._sum_of_digits\n\n    class IntegerList:\n        \"\"\"\n        Manages a list of Integer objects and provides the method for sorting.\n        \"\"\"\n        def __init__(self):\n            self._integers = []\n\n        def add_integer(self, value: int, original_index: int) -> None:\n            \"\"\"\n            Creates an Integer object, calculates its digit sum, and adds it to the internal list.\n            \"\"\"\n            integer_obj = Integer(value, original_index)\n            integer_obj.calculate_sum_of_digits()\n            self._integers.append(integer_obj)\n\n        def get_sorted_list(self) -> list[int]:\n            \"\"\"\n            Sorts the internal list of Integer objects and returns their original values.\n            Primary sort key is sum of digits, secondary is original index, both ascending.\n            \"\"\"\n            sorted_integer_objects = sorted(\n                self._integers,\n                key=lambda i: (i.get_sum_of_digits(), i.get_original_index())\n            )\n            return [i.get_value() for i in sorted_integer_objects]\n\n    # Handle empty input list as specified in the sequence diagram (AF1)\n    if not nums:\n        return []\n\n    integer_list_manager = IntegerList()\n\n    # Iterate through input numbers, creating and adding Integer objects\n    for index, num in enumerate(nums):\n        integer_list_manager.add_integer(num, index)\n\n    # Retrieve the sorted list of integer values\n    sorted_result = integer_list_manager.get_sorted_list()\n\n    return sorted_result"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    \"\"\"\n    Finds the largest negative and smallest positive integers in a list.\n    Returns (largest_negative, smallest_positive), with None for missing categories.\n    \"\"\"\n    largest_neg = None\n    smallest_pos = None\n\n    for number in lst:\n        if number < 0:\n            if largest_neg is None or number > largest_neg:\n                largest_neg = number\n        elif number > 0:\n            if smallest_pos is None or number < smallest_pos:\n                smallest_pos = number\n\n    return (largest_neg, smallest_pos)"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"Counts numbers in an array that are greater than 10 and have both an odd first and last digit.\n    This function uses helper methods to check digit properties.\"\"\"\n\n    def _is_odd(digit):\n        \"\"\"Checks if a given digit is odd.\"\"\"\n        return digit % 2 != 0\n\n    def _get_first_digit(number):\n        \"\"\"Extracts the first digit of a number, considering its absolute value.\"\"\"\n        return int(str(abs(number))[0])\n\n    def _get_last_digit(number):\n        \"\"\"Extracts the last digit of a number, considering its absolute value.\"\"\"\n        return abs(number) % 10\n\n    count = 0\n    for number in nums:\n        # Condition 1: strictly greater than 10\n        if number > 10:\n            first_digit = _get_first_digit(number)\n            # Condition 2: first digit is odd\n            if _is_odd(first_digit):\n                last_digit = _get_last_digit(number)\n                # Condition 3: last digit is odd\n                if _is_odd(last_digit):\n                    # Condition 4: all three conditions met\n                    count += 1\n    return count"}
{"task_id": "HumanEval/146", "solution": "def _get_first_digit(num: int) -> int:\n    \"\"\"Extracts the first digit of a number, ignoring its sign.\n    Converts the number to a string to get its first character.\"\"\"\n    return int(str(abs(num))[0])\ndef _get_last_digit(num: int) -> int:\n    \"\"\"Extracts the last digit of a number, ignoring its sign.\n    Uses the modulo operator on the absolute value.\"\"\"\n    return abs(num) % 10\ndef _is_odd(digit: int) -> bool:\n    \"\"\"Checks if a given digit is odd.\n    Returns True if the digit is odd, False otherwise.\"\"\"\n    return digit % 2 != 0\ndef specialFilter(nums):\n    \"\"\"Counts numbers in the array that are greater than 10 and have\n    both an odd first and an odd last digit.\"\"\"\n    count = 0\n    for num in nums:\n        if num > 10:\n            first_digit = _get_first_digit(num)\n            last_digit = _get_last_digit(num)\n            if _is_odd(first_digit) and _is_odd(last_digit):\n                count += 1\n    return count"}
{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    \"\"\"\n    Returns planets located strictly between two specified planets, sorted by proximity to the Sun.\n    Returns an empty tuple if input planets are invalid or no planets are found between them.\n    \"\"\"\n    _SOLAR_SYSTEM_PLANETS = [\n        \"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\",\n        \"Saturn\", \"Uranus\", \"Neptune\"\n    ]\n\n    # Validate planet names; return empty tuple if either is invalid.\n    if planet1 not in _SOLAR_SYSTEM_PLANETS or planet2 not in _SOLAR_SYSTEM_PLANETS:\n        return ()\n\n    idx1 = _SOLAR_SYSTEM_PLANETS.index(planet1)\n    idx2 = _SOLAR_SYSTEM_PLANETS.index(planet2)\n\n    # Determine the correct start and end indices for slicing, handling reversed order.\n    start_index = min(idx1, idx2)\n    end_index = max(idx1, idx2)\n\n    # Slice the list to get planets strictly between the two, then convert to tuple.\n    result_planets = _SOLAR_SYSTEM_PLANETS[start_index + 1 : end_index]\n    return tuple(result_planets)"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Counts unique triples (a[i], a[j], a[k]) from an array where a[i] = i*i - i + 1,\n    such that their sum is a multiple of 3. This is optimized by categorizing elements\n    based on their remainder modulo 3.\n    \"\"\"\n    count_rem0 = 0  # Counts a[x] where a[x] % 3 == 0\n    count_rem1 = 0  # Counts a[x] where a[x] % 3 == 1\n\n    # Populate remainder counts based on the observed pattern of a[i] % 3:\n    # a[i] % 3 is 0 if i % 3 == 2; otherwise, a[i] % 3 is 1.\n    for i in range(1, n + 1):\n        if i % 3 == 2:\n            count_rem0 += 1\n        else:\n            count_rem1 += 1\n\n    total_count = 0\n\n    # Combinations where all three elements have remainder 0.\n    # C(count_rem0, 3) = count_rem0 * (count_rem0 - 1) * (count_rem0 - 2) / 6\n    total_count += (count_rem0 * (count_rem0 - 1) * (count_rem0 - 2)) // 6\n\n    # Combinations where all three elements have remainder 1.\n    # C(count_rem1, 3) = count_rem1 * (count_rem1 - 1) * (count_rem1 - 2) / 6\n    total_count += (count_rem1 * (count_rem1 - 1) * (count_rem1 - 2)) // 6\n\n    # Cases like (0,1,2) or (2,2,2) are impossible as a[i] % 3 can never be 2.\n\n    return total_count"}
{"task_id": "HumanEval/148", "solution": "_PLANETS_ORDERED_LIST = [\n    \"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n]\n_PLANETS_MAP = {planet: i for i, planet in enumerate(_PLANETS_ORDERED_LIST)}\ndef bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun\n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn,\n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2.\n    The function should return a tuple containing all planets whose orbits are\n    located between the orbit of planet1 and the orbit of planet2, sorted by\n    the proximity to the sun.\n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names.\n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    if planet1 not in _PLANETS_MAP or planet2 not in _PLANETS_MAP:\n        return ()\n\n    index1 = _PLANETS_MAP[planet1]\n    index2 = _PLANETS_MAP[planet2]\n\n    start_index = min(index1, index2)\n    end_index = max(index1, index2)\n\n    between_planets = _PLANETS_ORDERED_LIST[start_index + 1:end_index]\n    return tuple(between_planets)"}
{"task_id": "HumanEval/147", "solution": "def _generate_array_elements(n: int) -> list[int]:\n    \"\"\"Generates an array 'a' of length n where a[idx] = (idx+1)^2 - (idx+1) + 1.\n    It uses 0-based indexing for the array, mapping to 1-based 'i' in the formula.\n    \"\"\"\n    a = [0] * n\n    for idx in range(n):\n        i_1_based = idx + 1\n        a[idx] = i_1_based * i_1_based - i_1_based + 1\n    return a\ndef _count_valid_triples(arr: list[int]) -> int:\n    \"\"\"Counts triples (arr[i], arr[j], arr[k]) where i < j < k and their sum is a multiple of 3.\n    It iterates through all unique combinations of three distinct indices.\n    \"\"\"\n    count = 0\n    n_len = len(arr)\n    for i in range(n_len):\n        for j in range(i + 1, n_len):\n            for k in range(j + 1, n_len):\n                if (arr[i] + arr[j] + arr[k]) % 3 == 0:\n                    count += 1\n    return count\ndef get_max_triples(n: int) -> int:\n    \"\"\"Calculates the number of specific triples within an integer array.\n    It generates an array based on n and then counts triples whose sum is a multiple of 3.\n    \"\"\"\n    # Input validation (e.g., for positive n) is omitted as per critical requirements.\n    a = _generate_array_elements(n)\n    triples_count = _count_valid_triples(a)\n    return triples_count"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Filters a list of strings to keep only even-length strings,\n    then sorts them by length ascending and alphabetically ascending.\"\"\"\n\n    # Filter out strings that have odd lengths.\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n\n    # Sort the filtered list primarily by length and secondarily alphabetically.\n    sorted_result = sorted(even_length_strings, key=lambda s: (len(s), s))\n\n    return sorted_result"}
{"task_id": "HumanEval/150", "solution": "from typing import Any\ndef is_prime(n: int) -> bool:\n    \"\"\"Determines if a given integer n is a prime number.\n    It efficiently checks for divisibility by small primes and then by numbers of the form 6k +/- 1.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\ndef x_or_y(n: int, x: Any, y: Any) -> Any:\n    \"\"\"Returns the value of x if n is a prime number, and y otherwise.\n    This function uses the is_prime helper to determine primality.\n    \"\"\"\n    if is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/150", "solution": "def is_prime(n):\n    \"\"\"Checks if a number n is prime.\n    Handles edge cases and efficiently checks divisibility up to its square root.\"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\ndef x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is\n    a prime number and should return the value of y otherwise.\"\"\"\n    if is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/151", "solution": "def is_integer(value):\n    \"\"\"Checks if the given value is an integer type.\"\"\"\n    return isinstance(value, int)\ndef is_negative(value):\n    \"\"\"Checks if the given integer value is negative.\"\"\"\n    return value < 0\ndef is_odd(value):\n    \"\"\"Checks if the given integer value is odd.\"\"\"\n    return value % 2 != 0\ndef double_the_difference(lst):\n    \"\"\"\n    Given a list of numbers, returns the sum of squares of odd, non-negative\n    integer elements, ignoring others. Returns 0 if the list is empty.\n    \"\"\"\n    if not lst:\n        return 0\n\n    total_sum_of_squares = 0\n\n    for element in lst:\n        if not is_integer(element):\n            continue\n\n        if is_negative(element):\n            continue\n\n        if not is_odd(element):\n            continue\n\n        square = element * element\n        total_sum_of_squares += square\n\n    return total_sum_of_squares"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    \"\"\"\n    Calculates the sum of squares of positive odd integers in a list.\n    Returns 0 if the list is empty or contains no positive odd integers.\n    \"\"\"\n    if not lst:\n        return 0\n\n    sum_of_squares = 0\n    for item in lst:\n        # Check if item is positive and odd. This implicitly handles non-integers and even numbers.\n        if item > 0 and item % 2 == 1:\n            sum_of_squares += item * item\n\n    return sum_of_squares"}
{"task_id": "HumanEval/152", "solution": "def compare(game, guess):\n    \"\"\"Calculates the absolute difference between corresponding game scores and player guesses.\n    A difference of 0 is recorded if the guess matches the score.\n    \"\"\"\n    differences = []\n    for i in range(len(game)):\n        if game[i] == guess[i]:\n            differences.append(0)\n        else:\n            differences.append(abs(game[i] - guess[i]))\n    return differences"}
{"task_id": "HumanEval/153", "solution": "def _calculate_strength(extension_name):\n    \"\"\"Calculates the strength of an extension based on uppercase and lowercase letters.\n    Strength is CAP - SM.\"\"\"\n    cap_count = 0\n    sm_count = 0\n    for char in extension_name:\n        if char.isupper():\n            cap_count += 1\n        elif char.islower():\n            sm_count += 1\n    return cap_count - sm_count\ndef Strongest_Extension(class_name, extensions):\n    \"\"\"You will be given the name of a class (a string) and a list of extensions.\n    The extensions are to be used to load additional classes to the class. The\n    strength of the extension is as follows: Let CAP be the number of the uppercase\n    letters in the extension's name, and let SM be the number of lowercase letters\n    in the extension's name, the strength is given by the fraction CAP - SM.\n    You should find the strongest extension and return a string in this\n    format: ClassName.StrongestExtensionName.\n    If there are two or more extensions with the same strength, you should\n    choose the one that comes first in the list.\n    For example, if you are given \"Slices\" as the class and a list of the\n    extensions: ['SErviNGSliCes', 'Cheese', 'StuFfed'] then you should\n    return 'Slices.SErviNGSliCes' since 'SErviNGSliCes' is the strongest extension\n    (its strength is -1).\n    Example:\n    for Strongest_Extension('my_class', ['AA', 'Be', 'CC']) == 'my_class.AA'\n    \"\"\"\n    max_strength = float('-inf')\n    strongest_ext_name = \"\"\n\n    for extension_name in extensions:\n        current_strength = _calculate_strength(extension_name)\n\n        # FR4: Identify the extension with the maximum calculated strength.\n        # FR5: If multiple extensions have the same maximum strength, select the one that appears earliest.\n        # This is implicitly handled by only updating when current_strength > max_strength.\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_ext_name = extension_name\n\n    # FR6: Return a string composed of the class name, a dot (.), and the strongest extension name.\n    return f\"{class_name}.{strongest_ext_name}\""}
{"task_id": "HumanEval/154", "solution": "def _is_substring(main: str, sub: str) -> bool:\n    \"\"\"Checks if 'sub' exists as a contiguous substring within 'main'.\n    Returns True if found, False otherwise.\"\"\"\n    return sub in main\ndef _generate_rotations(s: str) -> list[str]:\n    \"\"\"Generates all unique cyclic rotations of the input string 's'.\n    Returns a list of these unique rotated strings.\"\"\"\n    if not s:\n        return [\"\"]\n\n    rotations = set()\n    s_double = s + s\n    n = len(s)\n    for i in range(n):\n        rotations.add(s_double[i : i + n])\n    return list(rotations)\ndef cycpattern_check(a: str, b: str) -> bool:\n    \"\"\"Determines if the second word (b) or any of its cyclic rotations exists as a substring within the first word (a).\"\"\"\n    rotations_of_b = _generate_rotations(b)\n\n    for rotation in rotations_of_b:\n        if _is_substring(a, rotation):\n            return True\n    return False"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer, return a tuple that has the number of even and odd digits respectively.\n    Handles negative numbers by considering the absolute value of digits.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    if num == 0:\n        return (1, 0)\n\n    num = abs(num)\n\n    while num > 0:\n        digit = num % 10\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n        num = num // 10\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    # Convert num to its absolute value and then to a string to iterate through digits.\n    abs_num_str = str(abs(num))\n\n    for digit_char in abs_num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Checks if a file name is valid based on digit count, dot presence, prefix, and extension.\n    Returns 'Yes' for valid names, 'No' otherwise.\"\"\"\n    digit_count = 0\n    for char in file_name:\n        if '0' <= char <= '9':\n            digit_count += 1\n    if digit_count > 3:\n        return 'No'\n\n    if file_name.count('.') != 1:\n        return 'No'\n\n    parts = file_name.split('.', 1)\n    prefix = parts[0]\n    extension = parts[1]\n\n    if not prefix:  # Checks for empty prefix\n        return 'No'\n    if not ('a' <= prefix[0] <= 'z' or 'A' <= prefix[0] <= 'Z'):\n        return 'No'\n\n    valid_extensions = ['txt', 'exe', 'dll']\n    if extension not in valid_extensions:\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Converts a positive integer (1-1000) into its lowercase Roman numeral equivalent.\n    This uses a greedy approach with a predefined map for Roman numeral values.\n    \"\"\"\n    # The Roman numeral map, ordered from largest to smallest values, including subtractive forms.\n    roman_map = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'),\n        (1, 'I')\n    ]\n\n    result_roman = \"\"\n    # Iterate through the map to build the Roman numeral string.\n    for value, symbol in roman_map:\n        while number >= value:\n            result_roman += symbol\n            number -= value\n\n    return result_roman.lower()"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Filters a list of strings by removing odd-length strings,\n    then sorts the remaining strings by length and alphabetically.\"\"\"\n    filtered_list = []\n    for s in lst:\n        if len(s) % 2 == 0:\n            filtered_list.append(s)\n\n    filtered_list.sort(key=lambda s: (len(s), s))\n    return filtered_list"}
{"task_id": "HumanEval/156", "solution": "_ROMAN_MAP = [\n    (1000, 'm'), (900, 'cm'), (500, 'd'), (400, 'cd'),\n    (100, 'c'), (90, 'xc'), (50, 'l'), (40, 'xl'),\n    (10, 'x'), (9, 'ix'), (5, 'v'), (4, 'iv'),\n    (1, 'i')\n]\ndef int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n\n    Examples:\n    >>> int_to_mini_roman(19) == 'xix'\n    >>> int_to_mini_roman(152) == 'clii'\n    >>> int_to_mini_roman(426) == 'cdxxvi'\n    \"\"\"\n    if not (1 <= number <= 1000):\n        raise ValueError(\"Number out of range (1-1000)\")\n\n    roman_numerals = []\n    for value, numeral in _ROMAN_MAP:\n        while number >= value:\n            roman_numerals.append(numeral)\n            number -= value\n    return \"\".join(roman_numerals)"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or\n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    epsilon = 1e-9\n\n    if abs(a**2 + b**2 - c**2) < epsilon:\n        return True\n    if abs(a**2 + c**2 - b**2) < epsilon:\n        return True\n    if abs(b**2 + c**2 - a**2) < epsilon:\n        return True\n\n    return False"}
{"task_id": "HumanEval/157", "solution": "class Triangle:\n    \"\"\"\n    Encapsulates triangle side lengths and determines if it is right-angled.\n    It applies the Pythagorean theorem with a small tolerance for floating-point comparisons.\n    \"\"\"\n    sideA: float\n    sideB: float\n    sideC: float\n\n    def __init__(self, a: float, b: float, c: float):\n        \"\"\"Initializes the Triangle object with given side lengths.\"\"\"\n        self.sideA = a\n        self.sideB = b\n        self.sideC = c\n\n    def isRightAngled(self) -> bool:\n        \"\"\"\n        Determines if the triangle is right-angled using the Pythagorean theorem.\n        It considers all permutations of sides by sorting them and using a precision tolerance.\n        \"\"\"\n        sides = sorted([self.sideA, self.sideB, self.sideC])\n        # The longest side must be the hypotenuse if it's a right-angled triangle.\n        a_sq = sides[0] * sides[0]\n        b_sq = sides[1] * sides[1]\n        c_sq = sides[2] * sides[2]\n\n        # Use a small epsilon for floating-point comparison to account for precision issues.\n        epsilon = 1e-6\n        return abs(a_sq + b_sq - c_sq) < epsilon\ndef right_angle_triangle(a: float, b: float, c: float) -> bool:\n    \"\"\"\n    Given the lengths of the three sides of a triangle.\n    Return True if the three sides form a right-angled triangle, False otherwise.\n    \"\"\"\n    triangle = Triangle(a, b, c)\n    return triangle.isRightAngled()"}
{"task_id": "HumanEval/152", "solution": "def compare(game: list[int], guess: list[int]) -> list[int]:\n    \"\"\"Calculates the absolute difference between corresponding match scores and guesses.\n    Returns an array of these differences, with 0 for correct guesses.\n    \"\"\"\n    results = []\n    for game_score, guess_score in zip(game, guess):\n        difference = abs(game_score - guess_score)\n        results.append(difference)\n    return results"}
{"task_id": "HumanEval/158", "solution": "def find_max(words: list[str]) -> str:\n    \"\"\"\n    Finds the word with the maximum number of unique characters from a list.\n    If there's a tie, the word that comes first lexicographically is preferred.\n    \"\"\"\n    max_unique_chars: int = -1\n    result_word: str = \"\"\n\n    for word in words:\n        unique_chars_set: set[str] = set(word)\n        current_unique_count: int = len(unique_chars_set)\n\n        if current_unique_count > max_unique_chars:\n            max_unique_chars = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_chars:\n            # Tie-breaking: prefer the word that comes first lexicographically\n            if word < result_word:\n                result_word = word\n\n    return result_word"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"Calculates total carrots eaten and remaining stock after a meal.\n    The rabbit eats the lesser of what is needed or what is available.\"\"\"\n    consumed_carrots = min(need, remaining)\n    total_eaten = number + consumed_carrots\n    carrots_left = remaining - consumed_carrots\n    return [total_eaten, carrots_left]"}
{"task_id": "HumanEval/158", "solution": "from typing import List\ndef _count_unique_characters(s: str) -> int:\n    \"\"\"Calculates the number of unique characters in a given string.\n    Uses a set to efficiently count distinct characters.\n    \"\"\"\n    return len(set(s))\ndef find_max(words: List[str]) -> str:\n    \"\"\"Returns the word with the maximum number of unique characters.\n    In case of a tie, the lexicographically smallest string is returned.\n    \"\"\"\n    if not words:\n        return \"\" # Handle empty list case\n\n    best_string = words[0]\n    max_unique_count = _count_unique_characters(words[0])\n\n    for current_string in words[1:]:\n        current_unique_count = _count_unique_characters(current_string)\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            best_string = current_string\n        elif current_unique_count == max_unique_count:\n            if current_string < best_string:\n                best_string = current_string\n\n    return best_string"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates total carrots eaten and remaining stock after a rabbit's meal.\n    Handles scenarios where needed carrots are sufficient or insufficient from stock.\n    \"\"\"\n    if need <= remaining:\n        total_eaten_carrots = number + need\n        carrots_left = remaining - need\n    else:\n        total_eaten_carrots = number + remaining\n        carrots_left = 0\n\n    return [total_eaten_carrots, carrots_left]"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension for a class based on CAP - SM strength.\n    If strengths are equal, the first encountered extension in the list is chosen.\n    \"\"\"\n    if not extensions:\n        return f\"{class_name}.\"\n\n    max_strength = float('-inf')\n    strongest_extension_name = None\n\n    for extension_name in extensions:\n        cap_count = 0\n        sm_count = 0\n        for char in extension_name:\n            if 'A' <= char <= 'Z':\n                cap_count += 1\n            elif 'a' <= char <= 'z':\n                sm_count += 1\n\n        current_strength = cap_count - sm_count\n\n        # Update if a stronger extension is found. Tie-breaking favors the first one encountered.\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = extension_name\n\n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Constructs an algebraic expression by interleaving operands and operators.\n    Evaluates the constructed expression using standard operator precedence and returns the integer result.\n    \"\"\"\n    expression_parts = []\n    for i in range(len(operator)):\n        expression_parts.append(str(operand[i]))\n        expression_parts.append(operator[i])\n    expression_parts.append(str(operand[len(operator)]))\n\n    expression_string = \" \".join(expression_parts)\n    result = eval(expression_string)\n\n    return int(result)"}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a, b):\n    \"\"\"Checks if any cyclic rotation of b is a substring in a.\n    Returns True if found, False otherwise.\"\"\"\n\n    rotations_set = set()\n    n_b = len(b)\n\n    # Generate all unique cyclic rotations of string b\n    for i in range(n_b):\n        rotated_s = b[i:] + b[:i]\n        rotations_set.add(rotated_s)\n\n    # Convert the set of rotations to a list for iteration, as per design\n    rotations_list = list(rotations_set)\n\n    # Check if any rotation is a substring of string a\n    for rotation in rotations_list:\n        if rotation in a:\n            return True\n\n    # If no rotation was found as a substring\n    return False"}
{"task_id": "HumanEval/161", "solution": "def solve(s: str) -> str:\n    \"\"\"Processes a string by transforming letter case or reversing if no letters are present.\n    Returns the modified string based on its content.\n    \"\"\"\n    has_letters = False\n    for char in s:\n        if char.isalpha():\n            has_letters = True\n            break\n\n    if has_letters:\n        result_chars = []\n        for char in s:\n            if char.isalpha():\n                if char.islower():\n                    result_chars.append(char.upper())\n                else:  # char is uppercase\n                    result_chars.append(char.lower())\n            else:\n                result_chars.append(char)\n        return \"\".join(result_chars)\n    else:\n        return s[::-1]"}
{"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_to_md5(text: str) -> str | None:\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    return hashlib.md5(text.encode('utf-8')).hexdigest()"}
{"task_id": "HumanEval/162", "solution": "import hashlib\nfrom typing import Optional\ndef string_to_md5(text: str) -> Optional[str]:\n    \"\"\"Calculates the MD5 hash of the input string 'text'.\n    Returns None if the input string is empty.\"\"\"\n    if not text:\n        return None\n    md5_hash_object = hashlib.md5()\n    md5_hash_object.update(text.encode('utf-8'))\n    return md5_hash_object.hexdigest()"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa,\n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    Examples\n    solve(\"1234\") = \"4321\"\n    solve(\"ab\") = \"AB\"\n    solve(\"#a@C\") = \"#A@c\"\n    \"\"\"\n\n    def _has_letters(input_str):\n        \"\"\"Checks if the input string contains any alphabetic characters.\"\"\"\n        for char in input_str:\n            if char.isalpha():\n                return True\n        return False\n\n    def _reverse_char_case(char):\n        \"\"\"Reverses the case of a single letter character.\"\"\"\n        if char.islower():\n            return char.upper()\n        elif char.isupper():\n            return char.lower()\n        return char # Non-letters are unchanged, though this path should ideally be for letters only.\n\n    if not _has_letters(s):\n        # If no letters are found, reverse the entire string.\n        return s[::-1]\n    else:\n        # If letters are present, iterate and transform character by character.\n        transformed_chars = []\n        for char in s:\n            if char.isalpha():\n                transformed_chars.append(_reverse_char_case(char))\n            else:\n                # Keep non-letter characters unchanged.\n                transformed_chars.append(char)\n        return \"\".join(transformed_chars)"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    For example: generate_integers(2, 8) => [2, 4, 6, 8]\n    \"\"\"\n    min_val = min(a, b)\n    max_val = max(a, b)\n    result_list = []\n\n    for n in range(min_val, max_val + 1):\n        if n % 2 == 0 and 0 <= n <= 9:\n            result_list.append(n)\n\n    result_list.sort() # Sorts the list in ascending order as per design.\n\n    return result_list"}
{"task_id": "HumanEval/163", "solution": "from typing import List, Tuple\ndef _determine_range(a: int, b: int) -> Tuple[int, int]:\n    \"\"\"Determines the minimum and maximum values from two inputs.\"\"\"\n    return min(a, b), max(a, b)\ndef _find_even_integers_in_range(min_val: int, max_val: int) -> List[int]:\n    \"\"\"Collects all even single-digit integers within the inclusive range.\"\"\"\n    even_digits_found = []\n    # According to the problem examples, \"even digits\" refers to single-digit even numbers.\n    for digit in [2, 4, 6, 8]:\n        if min_val <= digit <= max_val:\n            even_digits_found.append(digit)\n    return even_digits_found\ndef _sort_integers(numbers: List[int]) -> List[int]:\n    \"\"\"Sorts a list of integers in ascending order.\"\"\"\n    return sorted(numbers)\ndef generate_integers(a: int, b: int) -> List[int]:\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    _validate_inputs(a, b)\n    min_val, max_val = _determine_range(a, b)\n    even_numbers = _find_even_integers_in_range(min_val, max_val)\n    sorted_even_numbers = _sort_integers(even_numbers)\n    return sorted_even_numbers"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and\n    the second list is a list of integers. Use the two given lists to build the algebric\n    expression and return the evaluation of this expression.\n    \"\"\"\n\n    def _validate_inputs(operator: list[str], operand: list[int]) -> None:\n        \"\"\"Validates input lists against length, operator validity, and operand non-negativity.\"\"\"\n        if len(operator) != len(operand) - 1:\n            raise ValueError(\"Operator list length must be (operand length - 1).\")\n        if len(operator) < 1:\n            raise ValueError(\"Operator list must contain at least one operator.\")\n        if len(operand) < 2:\n            raise ValueError(\"Operand list must contain at least two operands.\")\n\n        allowed_operators = {'+', '-', '*', '//', '**'}\n        for op in operator:\n            if op not in allowed_operators:\n                raise ValueError(f\"Unsupported operator: '{op}'.\")\n\n        for num in operand:\n            if num < 0:\n                raise ValueError(\"All operands must be non-negative integers.\")\n\n    def _construct_expression_string(operator: list[str], operand: list[int]) -> str:\n        \"\"\"Builds the algebraic expression string by interleaving operands and operators.\"\"\"\n        expression_parts = []\n        for i in range(len(operator)):\n            expression_parts.append(str(operand[i]))\n            expression_parts.append(operator[i])\n        expression_parts.append(str(operand[-1]))\n        return \" \".join(expression_parts)\n\n    def _evaluate_expression_string(expression_string: str) -> float:\n        \"\"\"Evaluates a given algebraic expression string, respecting standard operator precedence.\"\"\"\n        return float(eval(expression_string))\n\n    _validate_inputs(operator, operand)\n    expression_string = _construct_expression_string(operator, operand)\n    result = _evaluate_expression_string(expression_string)\n    return result"}
