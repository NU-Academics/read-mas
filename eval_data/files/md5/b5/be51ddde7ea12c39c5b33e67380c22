{"task_id": "HumanEval/19", "solution": "_NUMBER_WORD_MAP = {\n    \"zero\": 0, \"one\": 1, \"two\": 2, \"three\": 3, \"four\": 4,\n    \"five\": 5, \"six\": 6, \"seven\": 7, \"eight\": 8, \"nine\": 9\n}\nclass NumberWord:\n    \"\"\"Encapsulates a number word and its integer value for numerical comparison.\"\"\"\n    def __init__(self, word: str, value: int):\n        self.word = word\n        self.value = value\n\n    def __lt__(self, other: 'NumberWord') -> bool:\n        \"\"\"Enables less-than comparison based on the numerical value.\"\"\"\n        return self.value < other.value\n\n    def __eq__(self, other: object) -> bool:\n        \"\"\"Enables equality comparison based on the numerical value.\"\"\"\n        return self.value == other.value\n\n    def __repr__(self) -> str:\n        \"\"\"Provides a developer-friendly string representation.\"\"\"\n        return f\"NumberWord('{self.word}', {self.value})\"\ndef sort_numbers(numbers: str) -> str:\n    \"\"\"Sorts space-delimited number words numerically from smallest to largest.\"\"\"\n    word_list = numbers.split(' ')\n\n    number_word_objects = [\n        NumberWord(word, _NUMBER_WORD_MAP[word])\n        for word in word_list\n    ]\n\n    number_word_objects.sort()\n\n    sorted_words = [nw.word for nw in number_word_objects]\n    return ' '.join(sorted_words)"}
