{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    This function orchestrates the counting process using helper functions.\n    \"\"\"\n\n    def _is_candidate(x: int) -> bool:\n        \"\"\"Checks if an integer x is divisible by 11 or 13.\"\"\"\n        return x % 11 == 0 or x % 13 == 0\n\n    def _count_digit_occurrences(number: int, digit: int = 7) -> int:\n        \"\"\"Counts how many times a specific digit appears in a given number.\"\"\"\n        count = 0\n        num_str = str(number)\n        digit_str = str(digit)\n        for char in num_str:\n            if char == digit_str:\n                count += 1\n        return count\n\n    total_sevens = 0\n    for x in range(1, n):\n        if _is_candidate(x):\n            total_sevens += _count_digit_occurrences(x, 7)\n    return total_sevens"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # reverse cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list) -> list:\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indices, while its values at the even indices are equal\n    to the values of the even indices of l, but sorted.\n    \"\"\"\n    result_list = list(l) # Create a mutable copy of the input list.\n\n    even_values = []\n    for i in range(0, len(l), 2): # Collect all elements located at even indices.\n        even_values.append(l[i])\n\n    even_values.sort() # Sort the collected even-indexed elements.\n\n    j = 0\n    for i in range(0, len(result_list), 2): # Replace elements at even indices with sorted values.\n        result_list[i] = even_values[j]\n        j += 1\n\n    return result_list"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # Split the encoded string into groups of three, mirroring the encoding process.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n\n    # Reverse the cyclic shift for each group.\n    decoded_groups = []\n    for group in groups:\n        if len(group) == 3:\n            # If original 'abc' became 'bca', the encoded 'bca' needs to become 'abc'.\n            # This is done by moving the last character of the encoded group to the front.\n            decoded_group = group[2] + group[0] + group[1]\n        else:\n            # Groups with fewer than 3 elements were not cycled during encoding.\n            decoded_group = group\n        decoded_groups.append(decoded_group)\n\n    return \"\".join(decoded_groups)"}
