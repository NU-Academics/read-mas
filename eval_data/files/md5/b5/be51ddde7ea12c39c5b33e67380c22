{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"Finds the closest vowel surrounded by consonants from the right, excluding word boundaries.\n    Returns an empty string if no such vowel is found.\n    \"\"\"\n\n    VOWELS = set(\"aeiouAEIOU\")\n\n    def _is_vowel(char: str) -> bool:\n        \"\"\"Checks if a character is a vowel (case-insensitive).\"\"\"\n        return char in VOWELS\n\n    def _is_consonant(char: str) -> bool:\n        \"\"\"Checks if a character is a consonant.\"\"\"\n        # Assumes input characters are English letters only, per design spec.\n        return char.isalpha() and not _is_vowel(char)\n\n    if len(word) < 3:\n        return \"\"\n\n    # Iterate from the second-to-last character down to the second character (index 1).\n    # This excludes the first and last characters as potential central vowels.\n    for i in range(len(word) - 2, 0, -1):\n        if _is_vowel(word[i]):\n            if _is_consonant(word[i - 1]) and _is_consonant(word[i + 1]):\n                return word[i]\n\n    return \"\""}
{"task_id": "HumanEval/118", "solution": "def _is_vowel(char):\n    return char in 'aeiouAEIOU'\ndef _is_consonant(char):\n    return not _is_vowel(char)\ndef get_closest_vowel(word):\n    \"\"\"Finds the closest vowel from the right that is surrounded by two consonants.\n    Returns an empty string if no such qualifying vowel exists in the word.\"\"\"\n\n    # Iterate from the second-to-last character down to the second character (index 1).\n    # This range excludes characters at the very beginning (index 0) and very end,\n    # ensuring each checked character has immediate left and right neighbors.\n    for i in range(len(word) - 2, 0, -1):\n        current_char = word[i]\n        left_char = word[i-1]\n        right_char = word[i+1]\n\n        # Check if the current character is a vowel AND both its neighbors are consonants.\n        if _is_vowel(current_char) and _is_consonant(left_char) and _is_consonant(right_char):\n            return current_char\n\n    # If the loop completes without finding a qualifying vowel, return an empty string.\n    return \"\""}
{"task_id": "HumanEval/119", "solution": "def validate_input_list(lst):\n    \"\"\"Checks if the input list has exactly two elements.\"\"\"\n    return len(lst) == 2\ndef validate_parentheses_chars(s):\n    \"\"\"Checks if a string consists only of parentheses characters.\"\"\"\n    for char in s:\n        if char not in '()':\n            return False\n    return True\ndef is_balanced(s):\n    \"\"\"Determines if a string of parentheses is balanced.\"\"\"\n    balance = 0\n    for char in s:\n        if char == '(':\n            balance += 1\n        else:\n            balance -= 1\n        if balance < 0:\n            return False\n    return balance == 0\ndef match_parens(lst):\n    \"\"\"\n    Checks if two given strings of parentheses can be concatenated in any order\n    to form a balanced parentheses string.\n    \"\"\"\n    if not validate_input_list(lst):\n        return 'No'\n\n    # Per design, trust types; only validate character content.\n    # The design states to validate each string for parentheses characters.\n    if not validate_parentheses_chars(lst[0]):\n        return 'No'\n    if not validate_parentheses_chars(lst[1]):\n        return 'No'\n\n    # Check concatenation lst[0] + lst[1]\n    concat_s1_s2 = lst[0] + lst[1]\n    if is_balanced(concat_s1_s2):\n        return 'Yes'\n\n    # Check concatenation lst[1] + lst[0]\n    concat_s2_s1 = lst[1] + lst[0]\n    if is_balanced(concat_s2_s1):\n        return 'Yes'\n\n    return 'No'"}
{"task_id": "HumanEval/121", "solution": "def solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\n    \"\"\"\n\n    def _is_odd(number: int) -> bool:\n        \"\"\"Checks if a number is odd.\"\"\"\n        return number % 2 != 0\n\n    def _is_even_position(position: int) -> bool:\n        \"\"\"Checks if a list position (0-indexed) is even.\"\"\"\n        return position % 2 == 0\n\n    running_sum = 0\n    for position, element_value in enumerate(lst):\n        if _is_even_position(position):\n            if _is_odd(element_value):\n                running_sum += element_value\n    return running_sum"}
{"task_id": "HumanEval/120", "solution": "def maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and an integer k, return a sorted list\n    of length k with the maximum k numbers in arr.\n    \"\"\"\n\n    # Sort the input array in descending order to easily find the largest elements.\n    sorted_arr_desc = sorted(arr, reverse=True)\n\n    # Select the first k elements, which are the k largest numbers.\n    k_largest_elements = sorted_arr_desc[:k]\n\n    # Sort these k elements in ascending order as required for the final output.\n    final_result = sorted(k_largest_elements)\n\n    return final_result"}
{"task_id": "HumanEval/120", "solution": "def maximum(arr, k):\n    \"\"\"\n    Returns a sorted list of the k largest numbers from arr.\n    Handles edge cases for k and array length as per design.\n    \"\"\"\n    # If k is non-positive or the array is empty, return an empty list.\n    if k <= 0 or not arr:\n        return []\n\n    # If k is greater than or equal to the array's length,\n    # consider all elements and return them sorted in ascending order.\n    if k >= len(arr):\n        arr.sort()\n        return arr\n\n    # For the standard case, sort the array in descending order to easily find the largest k elements.\n    arr.sort(reverse=True)\n\n    # Extract the first k elements, which are now the k largest.\n    top_k_elements = arr[:k]\n\n    # Sort these k elements in ascending order as required by the output specification.\n    top_k_elements.sort()\n\n    return top_k_elements"}
{"task_id": "HumanEval/121", "solution": "def solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\n\n\n    Examples\n    solution([5, 8, 7, 1]) ==> 12\n    solution([3, 3, 3, 3, 3]) ==> 9\n    solution([30, 13, 24, 321]) ==>0\n    \"\"\"\n\n    def is_odd(number: int) -> bool:\n        \"\"\"Determines if a given integer is odd.\"\"\"\n        return number % 2 != 0\n\n    def is_even_position(position: int) -> bool:\n        \"\"\"Determines if a given 0-indexed position is even.\"\"\"\n        return position % 2 == 0\n\n    total_sum = 0\n    for position, value in enumerate(lst):\n        if is_even_position(position) and is_odd(value):\n            total_sum += value\n    return total_sum"}
{"task_id": "HumanEval/123", "solution": "def _is_positive_integer(num):\n    \"\"\"\n    Checks if a number is a positive integer.\n    Per critical requirements, input 'n' is trusted; this function's result won't trigger exceptions.\n    \"\"\"\n    return isinstance(num, int) and num > 0\ndef _generate_collatz_sequence(n):\n    \"\"\"\n    Generates the Collatz sequence for a given positive integer n.\n    The sequence continues until it reaches 1.\n    \"\"\"\n    sequence = [n]\n    current = n\n    while current != 1:\n        if current % 2 == 0:\n            current //= 2\n        else:\n            current = 3 * current + 1\n        sequence.append(current)\n    return sequence\ndef _is_odd(num):\n    \"\"\"\n    Checks if a number is odd.\n    Returns True if the number is odd, False otherwise.\n    \"\"\"\n    return num % 2 != 0\ndef get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in Collatz sequence.\n    This function orchestrates sequence generation, odd number identification, and sorting.\n    \"\"\"\n    # The design specifies calling _is_positive_integer, but critical requirements\n    # forbid raising exceptions based on validation. We trust n is a positive integer.\n    _is_positive_integer(n) # Called as per sequence diagram, but its return value does not cause error handling.\n\n    # FR5: Special case handling for n=1\n    if n == 1:\n        return [1]\n\n    # FR1: Generate the Collatz sequence for n > 1\n    collatz_sequence = _generate_collatz_sequence(n)\n\n    odd_numbers_list = []\n    # FR2: Identify the odd numbers within the generated Collatz sequence\n    for number in collatz_sequence:\n        if _is_odd(number):\n            odd_numbers_list.append(number)\n\n    # FR4: Sort the identified odd numbers in increasing order\n    odd_numbers_list.sort()\n\n    # FR3, NFR4: Return the sorted list of odd numbers\n    return odd_numbers_list"}
{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Calculates the sum of elements with at most two digits from the first k elements of arr.\n    Elements are considered to have at most two digits if their absolute value is between 0 and 99, inclusive.\n    \"\"\"\n    total_sum = 0\n    for i in range(min(k, len(arr))):\n        element = arr[i]\n        if -99 <= element <= 99:\n            total_sum += element\n    return total_sum"}
