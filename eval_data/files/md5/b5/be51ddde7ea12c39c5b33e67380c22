{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\"Finds the longest string in a list, returning the first encountered on ties.\n    Returns None if the input list is empty.\"\"\"\n    if not strings:\n        return None\n\n    longest_found = None\n    max_length = -1\n\n    for current_string in strings:\n        current_string_length = len(current_string)\n        if current_string_length > max_length:\n            max_length = current_string_length\n            longest_found = current_string\n\n    return longest_found"}
{"task_id": "HumanEval/11", "solution": "from typing import List\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    result_chars = []\n    for char_a, char_b in zip(a, b):\n        # Convert characters to integers, perform XOR, and convert back to string.\n        xor_result = str(int(char_a) ^ int(char_b))\n        result_chars.append(xor_result)\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/4", "solution": "from typing import List\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    n = len(numbers)\n\n    # Calculate the arithmetic mean of the input numbers.\n    mean = sum(numbers) / n\n\n    # Calculate the sum of absolute differences from the mean.\n    sum_absolute_differences = 0.0\n    for x in numbers:\n        sum_absolute_differences += abs(x - mean)\n\n    # Compute the average of these absolute differences.\n    mad = sum_absolute_differences / n\n    return mad"}
{"task_id": "HumanEval/11", "solution": "from typing import List\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    result_chars: List[str] = []\n    for char_a, char_b in zip(a, b):\n        if char_a == char_b:\n            result_chars.append('0')\n        else:\n            result_chars.append('1')\n    return \"\".join(result_chars)"}
