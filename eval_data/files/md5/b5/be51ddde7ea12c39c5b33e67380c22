{"task_id": "HumanEval/61", "solution": "def correct_bracketing(brackets: str):\n    \"\"\"Checks if a string of parentheses is correctly balanced using a stack.\n    Ignores characters other than '(' and ')'.\n    \"\"\"\n    stack = []\n    for char in brackets:\n        if char == '(':\n            stack.append(char)\n        elif char == ')':\n            if not stack:\n                return False\n            stack.pop()\n    return len(stack) == 0"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list) -> list:\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\n     Return derivative of this polynomial in the same form.\n    \"\"\"\n    if len(xs) <= 1:\n        return []\n\n    derivative_coefficients = []\n    for i in range(1, len(xs)):\n        derivative_coefficients.append(i * xs[i])\n\n    return derivative_coefficients"}
{"task_id": "HumanEval/61", "solution": "def correct_bracketing(brackets: str):\n    \"\"\"brackets is a string of \"(\" and \")\".\n    Returns True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    bracket_count = 0\n    for char in brackets:\n        if char == '(':\n            bracket_count += 1\n        elif char == ')':\n            bracket_count -= 1\n            if bracket_count < 0:\n                return False\n    return bracket_count == 0"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\"Calculates the derivative of a polynomial represented by a list of coefficients.\n    xs[i] is the coefficient of x^i; returns the derivative in the same form.\"\"\"\n\n    if len(xs) <= 1:\n        return []\n\n    derivative_coefficients = []\n    for n in range(1, len(xs)):\n        new_coefficient = n * xs[n]\n        derivative_coefficients.append(new_coefficient)\n\n    return derivative_coefficients"}
{"task_id": "HumanEval/63", "solution": "_memo = {}\ndef fibfib(n: int) -> int:\n    \"\"\"The FibFib number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fibfib(0) == 0\n    fibfib(1) == 0\n    fibfib(2) == 1\n    fibfib(n) == fibfib(n-1) + fibfib(n-2) + fibfib(n-3).\n    Please write a function to efficiently compute the n-th element of the fibfib number sequence.\n    >>> fibfib(1)\n    0\n    >>> fibfib(5)\n    4\n    >>> fibfib(8)\n    24\n    \"\"\"\n    if n in _memo:\n        return _memo[n]\n\n    if n == 0:\n        result = 0\n    elif n == 1:\n        result = 0\n    elif n == 2:\n        result = 1\n    else:\n        result = fibfib(n - 1) + fibfib(n - 2) + fibfib(n - 3)\n\n    _memo[n] = result\n    return result"}
{"task_id": "HumanEval/63", "solution": "_memo: dict[int, int] = {}\ndef fibfib(n: int):\n    \"\"\"Computes the n-th element of the FibFib number sequence efficiently using memoization.\n    This sequence is defined with base cases fibfib(0)=0, fibfib(1)=0, fibfib(2)=1, and fibfib(n) = fibfib(n-1) + fibfib(n-2) + fibfib(n-3) for n > 2.\n    \"\"\"\n    if n in _memo:\n        return _memo[n]\n\n    if n == 0:\n        result = 0\n    elif n == 1:\n        result = 0\n    elif n == 2:\n        result = 1\n    else:\n        result = fibfib(n - 1) + fibfib(n - 2) + fibfib(n - 3)\n\n    _memo[n] = result\n    return result"}
{"task_id": "HumanEval/65", "solution": "def _get_digits_string(x):\n    \"\"\"Converts an integer to its string representation.\"\"\"\n    return str(x)\ndef _reverse_string(s):\n    \"\"\"Reverses the characters of a given string.\"\"\"\n    return s[::-1]\ndef _circular_right_shift_string(s, shift_amount):\n    \"\"\"Performs a circular right shift on a string by the given amount.\"\"\"\n    s_len = len(s)\n    if s_len == 0:\n        return \"\"\n    effective_shift = shift_amount % s_len\n    return s[s_len - effective_shift:] + s[:s_len - effective_shift]\ndef circular_shift(x, shift):\n    \"\"\"\n    Circular shifts the digits of integer x or reverses them based on shift.\n    Returns the result as a string.\n    \"\"\"\n    digits_str = _get_digits_string(x)\n    num_digits = len(digits_str)\n\n    if shift > num_digits:\n        return _reverse_string(digits_str)\n    else:\n        return _circular_right_shift_string(digits_str, shift)"}
{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int) -> int:\n    \"\"\"Calculates the sum of integers from 1 to n.\n    Returns 0 if n is less than 1.\"\"\"\n    if n < 1:\n        return 0\n    else:\n        return n * (n + 1) // 2"}
{"task_id": "HumanEval/65", "solution": "def _get_digits_as_string(number: int) -> str:\n    \"\"\"Converts an integer to its string representation, preserving its sign.\"\"\"\n    return str(number)\ndef _perform_circular_shift(digits_str: str, shift_amount: int) -> str:\n    \"\"\"Shifts characters in digits_str right circularly by shift_amount.\"\"\"\n    length = len(digits_str)\n    if length == 0:\n        return \"\"\n    effective_shift = shift_amount % length\n    return digits_str[length - effective_shift:] + digits_str[:length - effective_shift]\ndef _reverse_digits(digits_str: str) -> str:\n    \"\"\"Reverses the order of characters in the provided string.\"\"\"\n    return digits_str[::-1]\ndef circular_shift(x: int, shift: int) -> str:\n    \"\"\"\n    Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string. If shift > number of digits, return digits reversed.\n    \"\"\"\n    digits_str = _get_digits_as_string(x)\n    num_digits = len(digits_str)\n\n    if shift > num_digits:\n        result_digits = _reverse_digits(digits_str)\n    else:\n        result_digits = _perform_circular_shift(digits_str, shift)\n\n    return result_digits"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Counts vowels in a string, where 'y' is a vowel only if it's the last character.\n    Vowels 'a', 'e', 'i', 'o', 'u' are always counted, case-insensitively.\n    \"\"\"\n    vowel_count = 0\n    s_lower = s.lower()\n    last_index = len(s) - 1\n\n    for i, char in enumerate(s_lower):\n        if char in 'aeiou':\n            vowel_count += 1\n        elif char == 'y' and i == last_index:\n            vowel_count += 1\n    return vowel_count"}
{"task_id": "HumanEval/64", "solution": "def _is_standard_vowel(char):\n    \"\"\"Checks if a character is a standard vowel (a, e, i, o, u), case-insensitive.\"\"\"\n    return char.lower() in ('a', 'e', 'i', 'o', 'u')\ndef _is_y_vowel(char, is_last_char):\n    \"\"\"Checks if 'y' is a vowel based on its position (must be the last character), case-insensitive.\"\"\"\n    return char.lower() == 'y' and is_last_char\ndef vowels_count(s):\n    \"\"\"Counts vowels in the input string.\n    'a', 'e', 'i', 'o', 'u' are always vowels; 'y' is a vowel if it is the last character.\n    \"\"\"\n    vowel_count = 0\n    string_length = len(s)\n\n    if string_length == 0:\n        return 0\n\n    for i, char in enumerate(s):\n        is_last_char = (i == string_length - 1)\n\n        if _is_standard_vowel(char):\n            vowel_count += 1\n        elif _is_y_vowel(char, is_last_char):\n            vowel_count += 1\n\n    return vowel_count"}
{"task_id": "HumanEval/67", "solution": "import re\ndef _parse_fruit_counts(s: str) -> tuple[int, int]:\n    \"\"\"\n    Parses the input string to extract apple and orange counts.\n    Returns a tuple containing the number of apples and oranges.\n    \"\"\"\n    match = re.search(r\"(\\d+) apples and (\\d+) oranges\", s)\n    apples = int(match.group(1))\n    oranges = int(match.group(2))\n    return apples, oranges\ndef fruit_distribution(s: str, n: int) -> int:\n    \"\"\"\n    Calculates the number of mangoes given apple/orange counts in string 's' and total fruits 'n'.\n    It extracts apple and orange counts, sums them, and subtracts from 'n'.\n    \"\"\"\n    apples, oranges = _parse_fruit_counts(s)\n    total_known_fruits = apples + oranges\n    mangoes = n - total_known_fruits\n    return mangoes"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Identifies the smallest even-valued node and its index from an array.\n    Prioritizes the smallest index if multiple nodes share the same smallest even value.\n    \"\"\"\n    if not arr:\n        return []\n\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for i, value in enumerate(arr):\n        if value % 2 == 0:\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = i\n            elif value == smallest_even_value:\n                # If values are equal, prioritize the node with the smaller index.\n                # This only updates if the current index is smaller.\n                if i < smallest_even_index:\n                    smallest_even_index = i\n\n    if smallest_even_index == -1:\n        return []\n    else:\n        return [smallest_even_value, smallest_even_index]"}
{"task_id": "HumanEval/67", "solution": "import re\ndef fruit_distribution(s, n):\n    \"\"\"\n    Calculates the number of mangoes given a string detailing apple and orange counts and a total fruit count.\n    It parses the string using regular expressions to find apples and oranges.\n    \"\"\"\n    # Extract the number of apples from the string s.\n    apple_count = int(re.search(r\"(\\d+) apples\", s).group(1))\n\n    # Extract the number of oranges from the string s.\n    orange_count = int(re.search(r\"(\\d+) oranges\", s).group(1))\n\n    # Calculate the sum of apples and oranges and subtract from the total.\n    mango_count = n - (apple_count + orange_count)\n    return mango_count"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even-valued node and its index in an array.\n    Returns [value, index] or [] if no even values or array is empty.\n    \"\"\"\n    if not arr:\n        return []\n\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for index, value in enumerate(arr):\n        if value % 2 == 0:  # Check if the value is even\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = index\n            # If value == smallest_even_value, no update is needed as we already have the smallest index\n            # due to iteration order.\n\n    if smallest_even_index == -1:\n        return []\n    else:\n        return [smallest_even_value, smallest_even_index]"}
{"task_id": "HumanEval/69", "solution": "def _calculate_frequencies(lst: list[int]) -> dict[int, int]:\n    \"\"\"Calculates the frequency of each integer in the input list.\n    Returns a dictionary mapping integers to their counts.\"\"\"\n    frequencies = {}\n    for num in lst:\n        frequencies[num] = frequencies.get(num, 0) + 1\n    return frequencies\ndef _find_greatest_valid_integer(frequencies: dict[int, int]) -> int:\n    \"\"\"Finds the greatest integer satisfying the frequency condition.\n    Iterates through frequencies and checks if count >= integer.\"\"\"\n    greatest_valid_int = -1\n    for integer, count in frequencies.items():\n        if integer > 0 and count >= integer:\n            if integer > greatest_valid_int:\n                greatest_valid_int = integer\n    return greatest_valid_int\ndef search(lst: list[int]) -> int:\n    \"\"\"\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than\n    zero, and has a frequency greater than or equal to the value of the integer itself.\n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    Examples:\n        search([4, 1, 2, 2, 3, 1]) == 2\n        search([1, 2, 2, 3, 3, 3, 4, 4, 4]) == 3\n        search([5, 5, 4, 4, 4]) == -1\n    \"\"\"\n    frequencies = _calculate_frequencies(lst)\n    result = _find_greatest_valid_integer(frequencies)\n    return result"}
{"task_id": "HumanEval/69", "solution": "def search(lst: list[int]) -> int:\n    \"\"\"\n    Finds the greatest integer N where N is positive and its frequency in lst is greater than or equal to N.\n    Returns -1 if no such integer is found.\n    \"\"\"\n    greatest_satisfying_integer = -1\n    frequency_dict = {}\n\n    # Populate the frequency dictionary in a single pass.\n    for num in lst:\n        frequency_dict[num] = frequency_dict.get(num, 0) + 1\n\n    # Determine the maximum value in the list.\n    max_val_in_list = max(lst)\n\n    # Iterate downwards from the maximum value found in the list to 1.\n    for num_to_check in range(max_val_in_list, 0, -1):\n        if num_to_check in frequency_dict and frequency_dict[num_to_check] >= num_to_check:\n            greatest_satisfying_integer = num_to_check\n            break # Found the greatest satisfying integer, so exit the loop.\n\n    return greatest_satisfying_integer"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst: list[int]) -> list[int]:\n    \"\"\"\n    Sorts a list of integers into a 'strange order' by alternately selecting the minimum and maximum from remaining elements.\n    The process starts by selecting the minimum value.\n    \"\"\"\n    working_list = sorted(lst)\n    result_list = []\n    is_min_turn = True\n\n    while working_list:\n        if is_min_turn:\n            # Select and remove the minimum value (first element)\n            result_list.append(working_list.pop(0))\n        else:\n            # Select and remove the maximum value (last element)\n            result_list.append(working_list.pop(-1))\n        is_min_turn = not is_min_turn\n\n    return result_list"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting starts with the minimum value, then maximum of remaining, and so on.\n    '''\n    if not lst:\n        return []\n\n    sorted_list = sorted(lst)\n    result_list = []\n    is_min_turn = True\n\n    while sorted_list:\n        if is_min_turn:\n            result_list.append(sorted_list.pop(0))\n        else:\n            result_list.append(sorted_list.pop())\n        is_min_turn = not is_min_turn\n\n    return result_list"}
{"task_id": "HumanEval/71", "solution": "class Triangle:\n    \"\"\"\n    Encapsulates triangle properties and provides methods for validity and area calculation.\n    Internal attributes store side lengths, validity status, and calculated area.\n    \"\"\"\n    def __init__(self, a: float, b: float, c: float):\n        \"\"\"\n        Initializes a Triangle object with given side lengths.\n        It immediately determines validity and calculates the area if valid.\n        \"\"\"\n        self._side_a = a\n        self._side_b = b\n        self._side_c = c\n        self._is_valid = self._calculate_validity()\n        self._area = 0.0\n        if self._is_valid:\n            self._area = self._calculate_area()\n\n    def is_valid(self) -> bool:\n        \"\"\"Returns True if the triangle is valid, False otherwise.\"\"\"\n        return self._is_valid\n\n    def get_area(self) -> float:\n        \"\"\"Returns the calculated area of the triangle.\"\"\"\n        return self._area\n\n    def _calculate_validity(self) -> bool:\n        \"\"\"\n        Determines if the three sides form a valid triangle.\n        Checks if the sum of any two sides is strictly greater than the third side.\n        \"\"\"\n        cond1 = (self._side_a + self._side_b > self._side_c)\n        cond2 = (self._side_a + self._side_c > self._side_b)\n        cond3 = (self._side_b + self._side_c > self._side_a)\n        # Additionally, all side lengths must be positive for a valid geometric triangle.\n        # The sum conditions (e.g., a+b>c) inherently handle zero or negative sides by failing.\n        # However, to be explicit about positive lengths for Heron's context:\n        positive_sides = (self._side_a > 0 and self._side_b > 0 and self._side_c > 0)\n        return cond1 and cond2 and cond3 and positive_sides\n\n    def _calculate_area(self) -> float:\n        \"\"\"\n        Calculates the area of the triangle using Heron's formula.\n        Assumes the triangle is valid; otherwise, the result would be non-real or zero.\n        \"\"\"\n        s = (self._side_a + self._side_b + self._side_c) / 2\n        # Use ** 0.5 for square root to avoid external math module import.\n        area_squared = s * (s - self._side_a) * (s - self._side_b) * (s - self._side_c)\n        # Ensure area_squared is non-negative due to potential floating point inaccuracies\n        # for nearly degenerate triangles, though validity check should prevent negative values.\n        return max(0.0, area_squared)**0.5\ndef triangle_area(a: float, b: float, c: float) -> float:\n    \"\"\"\n    Given the lengths of the three sides of a triangle, returns its area rounded to 2 decimal places.\n    Returns -1 if the sides do not form a valid triangle.\n    \"\"\"\n    triangle = Triangle(a, b, c)\n    if triangle.is_valid():\n        raw_area = triangle.get_area()\n        return round(raw_area, 2)\n    else:\n        return -1"}
{"task_id": "HumanEval/71", "solution": "import math\nclass Triangle:\n    \"\"\"Represents a triangle with three side lengths.\"\"\"\n    def __init__(self, a: float, b: float, c: float):\n        \"\"\"Initializes a Triangle object with given side lengths.\"\"\"\n        self._sideA = a\n        self._sideB = b\n        self._sideC = c\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if the side lengths form a valid triangle.\"\"\"\n        # Sum of any two sides must be strictly greater than the third side.\n        return (self._sideA + self._sideB > self._sideC and\n                self._sideA + self._sideC > self._sideB and\n                self._sideB + self._sideC > self._sideA)\n\n    def calculate_area(self) -> float:\n        \"\"\"Calculates the triangle's area using Heron's formula, rounded to two decimal places.\"\"\"\n        s = (self._sideA + self._sideB + self._sideC) / 2\n        area_squared = s * (s - self._sideA) * (s - self._sideB) * (s - self._sideC)\n        # Use max(0, ...) to prevent math domain error for sqrt due to potential float precision issues.\n        area = math.sqrt(max(0, area_squared))\n        return round(area, 2)\ndef triangle_area(a: float, b: float, c: float) -> float:\n    \"\"\"\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle.\n    Otherwise return -1.\n    \"\"\"\n    triangle = Triangle(a, b, c)\n    if triangle.is_valid():\n        return triangle.calculate_area()\n    else:\n        return -1.0"}
{"task_id": "HumanEval/72", "solution": "def is_palindrome(q: list) -> bool:\n    \"\"\"Checks if a list is a palindrome.\n    Compares the list with its reversed version.\"\"\"\n    return q == q[::-1]\ndef calculate_sum(q: list) -> int:\n    \"\"\"Calculates the sum of elements in a list.\n    Returns 0 for an empty list.\"\"\"\n    return sum(q)\ndef will_it_fly(q, w):\n    \"\"\"Checks if an object q will fly based on palindrome property and sum of elements.\n    Returns True if q is a palindrome AND its sum is less than or equal to w.\"\"\"\n    is_q_palindrome = is_palindrome(q)\n    sum_q = calculate_sum(q)\n    return is_q_palindrome and (sum_q <= w)"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic. A palindromic array is an array that\n    is read the same backwards and forwards. In one change, you can change one element to any other element.\n\n    For example:\n    smallest_change([1,2,3,5,4,7,9,6]) == 4\n    smallest_change([1, 2, 3, 4, 3, 2, 2]) == 1\n    smallest_change([1, 2, 3, 2, 1]) == 0\n    \"\"\"\n    changes = 0\n    left = 0\n    right = len(arr) - 1\n\n    while left < right:\n        if arr[left] != arr[right]:\n            changes += 1\n        left += 1\n        right -= 1\n    return changes"}
{"task_id": "HumanEval/74", "solution": "def total_match(lst1, lst2):\n    \"\"\"\n    Compares two lists of strings by their total character lengths.\n    Returns the list with the smaller aggregated length, or the first list on a tie.\n    \"\"\"\n    chars_lst1 = 0\n    chars_lst2 = 0\n\n    for s in lst1:\n        chars_lst1 += len(s)\n\n    for s in lst2:\n        chars_lst2 += len(s)\n\n    if chars_lst1 < chars_lst2:\n        return lst1\n    elif chars_lst2 < chars_lst1:\n        return lst2\n    else:  # chars_lst1 == chars_lst2\n        return lst1"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the minimum changes needed to make an array palindromic.\n    Compares elements from both ends and counts mismatches.\n    \"\"\"\n    n = len(arr)\n    changes = 0\n    for i in range(n // 2):\n        if arr[i] != arr[n - 1 - i]:\n            changes += 1\n    return changes"}
