{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n\n    Note:\n    * don't change the given array.\n\n    Examples:\n    * sort_array([]) => []\n    * sort_array([5]) => [5]\n    * sort_array([2, 4, 3, 0, 1, 5]) => [0, 1, 2, 3, 4, 5]\n    * sort_array([2, 4, 3, 0, 1, 5, 6]) => [6, 5, 4, 3, 2, 1, 0]\n    \"\"\"\n    if len(array) == 0:\n        return []\n    elif len(array) == 1:\n        return array[:]\n\n    first_element = array[0]\n    last_element = array[-1]\n    total_sum = first_element + last_element\n\n    array_copy = array[:]\n\n    if total_sum % 2 != 0:  # Odd sum, sort ascending\n        array_copy.sort()\n    else:  # Even sum, sort descending\n        array_copy.sort(reverse=True)\n\n    return array_copy"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array: list[int]) -> list[int]:\n    \"\"\"\n    Sorts an array of non-negative integers based on the sum of its first and last elements.\n    Returns a new sorted array without modifying the original input.\n    \"\"\"\n\n    def _is_empty(arr: list[int]) -> bool:\n        \"\"\"Checks if an array is empty.\"\"\"\n        return len(arr) == 0\n\n    def _has_single_element(arr: list[int]) -> bool:\n        \"\"\"Checks if an array contains exactly one element.\"\"\"\n        return len(arr) == 1\n\n    def _copy_array(arr: list[int]) -> list[int]:\n        \"\"\"Creates a shallow copy of an array.\"\"\"\n        return list(arr)\n\n    def _get_first_element(arr: list[int]) -> int:\n        \"\"\"Retrieves the first element of an array.\"\"\"\n        return arr[0]\n\n    def _get_last_element(arr: list[int]) -> int:\n        \"\"\"Retrieves the last element of an array.\"\"\"\n        return arr[-1]\n\n    def _calculate_sum_first_last(arr: list[int]) -> int:\n        \"\"\"Calculates the sum of the first and last elements of an array.\"\"\"\n        return _get_first_element(arr) + _get_last_element(arr)\n\n    def _is_odd(num: int) -> bool:\n        \"\"\"Determines if an integer is odd.\"\"\"\n        return num % 2 != 0\n\n    def _sort_ascending(arr: list[int]) -> list[int]:\n        \"\"\"Sorts an array in ascending order.\"\"\"\n        return sorted(arr)\n\n    def _sort_descending(arr: list[int]) -> list[int]:\n        \"\"\"Sorts an array in descending order.\"\"\"\n        return sorted(arr, reverse=True)\n\n    if _is_empty(array):\n        return []\n    elif _has_single_element(array):\n        return _copy_array(array)\n    else:\n        sum_first_last = _calculate_sum_first_last(array)\n        copied_array = _copy_array(array)\n        if _is_odd(sum_first_last):\n            return _sort_ascending(copied_array)"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s: str) -> str:\n    \"\"\"Encrypts a string by rotating alphabetic characters by 4 places.\n    Non-alphabetic characters are left unchanged.\n    \"\"\"\n    ROTATION_AMOUNT = 4\n    ALPHABET_SIZE = 26\n    LOWER_A_ORD = ord('a')\n    UPPER_A_ORD = ord('A')\n\n    encrypted_chars = []\n    for char in s:\n        if 'a' <= char <= 'z':  # Check if lowercase alphabetic\n            offset = ord(char) - LOWER_A_ORD\n            new_offset = (offset + ROTATION_AMOUNT) % ALPHABET_SIZE\n            encrypted_chars.append(chr(LOWER_A_ORD + new_offset))\n        elif 'A' <= char <= 'Z':  # Check if uppercase alphabetic\n            offset = ord(char) - UPPER_A_ORD\n            new_offset = (offset + ROTATION_AMOUNT) % ALPHABET_SIZE\n            encrypted_chars.append(chr(UPPER_A_ORD + new_offset))\n        else:  # Non-alphabetic characters\n            encrypted_chars.append(char)\n    return \"\".join(encrypted_chars)"}
