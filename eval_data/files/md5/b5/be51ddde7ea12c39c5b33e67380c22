{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int):\n    \"\"\"\n    prime_fib returns the n-th number that is both a Fibonacci number and a prime.\n    All supporting classes are defined inline to meet strict requirements.\n    \"\"\"\n\n    class PrimeChecker:\n        \"\"\"Utility for checking if a given number is prime.\"\"\"\n        def is_prime(self, number: int) -> bool:\n            if number <= 1:\n                return False\n            if number <= 3:\n                return True\n            if number % 2 == 0 or number % 3 == 0:\n                return False\n            i = 5\n            while i * i <= number:\n                if number % i == 0 or number % (i + 2) == 0:\n                    return False\n                i += 6\n            return True\n\n    class FibonacciGenerator:\n        \"\"\"Generates Fibonacci numbers and checks for Fibonacci property.\"\"\"\n        def is_fibonacci(self, number: int) -> bool:\n            # A number is Fibonacci if (5*n^2 + 4) or (5*n^2 - 4) is a perfect square.\n            if number < 0: return False\n            if number == 0 or number == 1: return True\n\n            def is_perfect_square(x: int) -> bool:\n                s = int(x**0.5)\n                return s*s == x\n\n            return is_perfect_square(5 * number * number + 4) or is_perfect_square(5 * number * number - 4)\n\n        def generate_fibonacci_sequence(self): # Removed Iterator type hint to meet \"no helper functions\" constraint\n            # Generates an infinite sequence of Fibonacci numbers starting from 0.\n            a, b = 0, 1\n            while True:\n                yield a\n                a, b = b, a + b\n\n    class PrimeFibonacciCalculator:\n        \"\"\"Orchestrates finding the n-th prime Fibonacci number.\"\"\"\n        def __init__(self, fib_gen: 'FibonacciGenerator', prime_chk: 'PrimeChecker'):\n            self._fibonacci_generator = fib_gen\n            self._prime_checker = prime_chk\n\n        def find_nth_prime_fib(self, n: int) -> int:\n            # Finds and returns the n-th prime Fibonacci number.\n            # Assumes n is a positive integer as per critical requirements.\n            found_count = 0\n            fib_sequence_generator = self._fibonacci_generator.generate_fibonacci_sequence()\n\n            for fib_num in fib_sequence_generator:\n                if fib_num <= 1: # 0 and 1 are not prime\n                    continue\n\n                if self._prime_checker.is_prime(fib_num):\n                    found_count += 1\n                    if found_count == n:\n                        return fib_num\n\n    # Instantiate and execute the core logic\n    fib_gen = FibonacciGenerator()\n    prime_chk = PrimeChecker()\n    calculator = PrimeFibonacciCalculator(fib_gen, prime_chk)\n    return calculator.find_nth_prime_fib(n)"}
