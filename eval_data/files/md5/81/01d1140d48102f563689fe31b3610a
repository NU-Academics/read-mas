{"task_id": "Mbpp/782", "solution": "def odd_length_sum(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the sum of all elements in all odd-length subarrays of the input array.\n    It iterates through all possible subarrays, checks if their length is odd, and sums their elements.\n    \"\"\"\n    total_sum = 0\n    n = len(arr)\n\n    for i in range(n):\n        for j in range(i, n):\n            current_length = j - i + 1\n            if current_length % 2 != 0:\n                for k in range(i, j + 1):\n                    total_sum += arr[k]\n    return total_sum"}
{"task_id": "Mbpp/784", "solution": "def mul_even_odd(numbers: list[int]) -> int:\n    \"\"\"\n    Finds the product of the first even and first odd number in a given list.\n    Raises ValueError if the list is empty, or if no even or no odd number is found.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    if not numbers:\n        raise ValueError(\"The input list cannot be empty.\")\n\n    for num in numbers:\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n        if first_even is None and num % 2 == 0:\n            first_even = num\n\n        if first_even is not None and first_odd is not None:\n            break\n\n    if first_even is None:\n        raise ValueError(\"No even number found in the list.\")\n    if first_odd is None:\n        raise ValueError(\"No odd number found in the list.\")\n\n    return first_even * first_odd"}
{"task_id": "Mbpp/785", "solution": "class _TupleString:\n    \"\"\"Encapsulates the input tuple string and provides methods to extract its raw string elements.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n\n    def parse_elements(self) -> list[str]:\n        \"\"\"Removes parentheses, splits the string by commas, and strips whitespace from each element.\"\"\"\n        stripped_content = self._value.strip('()').strip()\n        if not stripped_content:\n            return []\n        return [e.strip() for e in stripped_content.split(',')]\nclass _IntegerTuple:\n    \"\"\"Converts a list of string elements into a list of integers and forms the final native integer tuple.\"\"\"\n    def __init__(self, elements: list[int]):\n        self._elements = elements\n\n    @classmethod\n    def from_string_elements(cls, string_elements: list[str]) -> tuple:\n        \"\"\"Factory method to create an integer tuple from a list of string elements.\"\"\"\n        return tuple(int(s) for s in string_elements)\ndef tuple_str_int(tuple_string: str) -> tuple:\n    \"\"\"Converts a string representation of an integer tuple to a native integer tuple.\"\"\"\n    tuple_string_parser = _TupleString(tuple_string)\n    string_elements = tuple_string_parser.parse_elements()\n    return _IntegerTuple.from_string_elements(string_elements)"}
