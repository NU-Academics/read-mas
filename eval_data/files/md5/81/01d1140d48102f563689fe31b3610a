{"task_id": "Mbpp/799", "solution": "def left_rotate(number: int, d: int) -> int:\n    \"\"\"\n    Performs a 32-bit left bit rotation on the given number by d positions.\n    Bits shifted off the left end reappear on the right end.\n    \"\"\"\n    # Define the bit length for the rotation\n    BIT_LENGTH = 32\n    # Calculate the effective rotation amount, handling cases where d >= BIT_LENGTH\n    effective_d = d % BIT_LENGTH\n\n    # Perform the left rotation\n    # Part 1: Bits shifted left, staying within the 32-bit boundary\n    left_part = (number << effective_d)\n    # Part 2: Bits that wrapped around from the left to the right\n    right_part = (number >> (BIT_LENGTH - effective_d))\n\n    # Combine the two parts and apply a 32-bit mask to ensure the result is 32-bit\n    rotated_number = (left_part | right_part) & 0xFFFFFFFF\n\n    return rotated_number"}
{"task_id": "Mbpp/803", "solution": "def is_perfect_square(number):\n    \"\"\"\n    Checks if the given non-negative integer is a perfect square.\n    \"\"\"\n    if number < 0:\n        return False # Based on assert not is_perfect_square(10), we assume the user will handle invalid input or that it is already validated.\n    \n    root = int(number**0.5)\n    return root * root == number"}
{"task_id": "Mbpp/805", "solution": "def max_sum_list(list_of_lists: list[list[int]]) -> list[int]:\n    \"\"\"\n    Finds the list in a list of lists whose sum of elements is the highest.\n\n    Args:\n        list_of_lists: A list where each element is itself a list of numeric values.\n\n    Returns:\n        The inner list with the highest sum. Returns an empty list if the input is empty.\n    \"\"\"\n    if not list_of_lists:\n        return []\n\n    max_sum = float('-inf')\n    best_list = []\n\n    for inner_list in list_of_lists:\n        current_sum = sum(inner_list)\n        if current_sum > max_sum:\n            max_sum = current_sum\n            best_list = inner_list\n    return best_list"}
{"task_id": "Mbpp/801", "solution": "def test_three_equal(num1, num2, num3):\n    \"\"\"Counts the number of equal numbers among three given integers.\"\"\"\n    if num1 == num2 and num2 == num3:\n        return 3\n    elif num1 == num2 or num1 == num3 or num2 == num3:\n        return 2\n    else:\n        return 0"}
{"task_id": "Mbpp/804", "solution": "import math\nfrom typing import List\nclass NumberList:\n    \"\"\"Manages a list of integers provided as input.\"\"\"\n    def __init__(self, numbers: List[int]) -> None:\n        self._numbers = list(numbers)\n\n    def addNumber(self, number: int) -> None:\n        \"\"\"Adds a single integer to the list.\"\"\"\n        self._numbers.append(number)\n\n    def getNumbers(self) -> List[int]:\n        \"\"\"Returns the current list of numbers.\"\"\"\n        return self._numbers\nclass Product:\n    \"\"\"Stores the computed product value and determines its parity.\"\"\"\n    def __init__(self, value: int) -> None:\n        self._value = value\n\n    def isEven(self) -> bool:\n        \"\"\"Returns True if the product value is even, False otherwise.\"\"\"\n        return self._value % 2 == 0\n\n    def getValue(self) -> int:\n        \"\"\"Returns the product value.\"\"\"\n        return self._value\nclass ProductCalculator:\n    \"\"\"Computes the product of numbers from a NumberList.\"\"\"\n    def calculateProduct(self, number_list: NumberList) -> Product:\n        \"\"\"Calculates the product of numbers in the NumberList and returns a Product object.\"\"\"\n        numbers = number_list.getNumbers()\n        if not numbers:\n            product_value = 0 # Product of an empty list is 0 by convention, which is even.\n        else:\n            product_value = math.prod(numbers)\n        return Product(product_value)\ndef is_product_even(numbers: List[int]) -> bool:\n    \"\"\"\n    Orchestrates the process of checking if the product of input numbers is even.\n    Accepts a list of integers, calculates their product, and returns True if the product is even, False otherwise.\n    \"\"\"\n    number_list_obj = NumberList(numbers)\n    calculator = ProductCalculator()\n    product_obj = calculator.calculateProduct(number_list_obj)\n    return product_obj.isEven()"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string: str) -> int:\n    \"\"\"\n    Calculates the maximum length of a contiguous sequence of uppercase characters in the given string.\n    Returns 0 if the string is empty or contains no uppercase characters.\n    \"\"\"\n    max_run = 0\n    current_run = 0\n    for char in input_string:\n        if 'A' <= char <= 'Z': # Efficiently check if character is uppercase\n            current_run += 1\n        else:\n            current_run = 0\n        max_run = max(max_run, current_run)\n    return max_run"}
