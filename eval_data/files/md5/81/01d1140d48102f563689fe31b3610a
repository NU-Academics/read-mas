{"task_id": "Mbpp/472", "solution": "def check_Consecutive(numbers: list[int]) -> bool:\n    \"\"\"\n    Checks if a given list of integers contains consecutive numbers when sorted.\n    Handles empty or single-element lists as trivially consecutive.\n    \"\"\"\n    if len(numbers) <= 1:\n        return True\n\n    sorted_numbers = sorted(numbers)\n\n    for i in range(1, len(sorted_numbers)):\n        if sorted_numbers[i] != sorted_numbers[i-1] + 1:\n            return False\n\n    return True"}
{"task_id": "Mbpp/468", "solution": "def findMaxProductIncreasingSubsequence(numbers: list[int]) -> int:\n    \"\"\"\n    Computes the maximum product of an increasing subsequence from the given array.\n    Returns 0 if the array is empty or contains no positive increasing subsequences.\n    \"\"\"\n    n = len(numbers)\n\n    if n == 0:\n        return 0\n\n    # dp[i] stores the maximum product of an increasing subsequence ending at index i.\n    # Initialize dp[i] with numbers[i] itself if positive, otherwise 0 (as per rule for positive subsequences).\n    dp = [0] * n\n    for i in range(n):\n        if numbers[i] > 0:\n            dp[i] = numbers[i]\n\n    # max_product stores the overall maximum product found.\n    # It must be initialized to 0 to handle cases where no positive increasing subsequence exists.\n    # We update it with the maximum of single-element positive subsequences initially.\n    max_product = 0\n    for val in dp:\n        max_product = max(max_product, val)\n\n    # Dynamic programming loop to find maximum products\n    for i in range(n):\n        for j in range(i):\n            # If numbers[i] is greater than numbers[j], it can extend the subsequence ending at j.\n            if numbers[i] > numbers[j]:\n                # Calculate potential product by extending the subsequence ending at j with numbers[i].\n                # If dp[j] is 0 (meaning numbers[j] itself or previous products were non-positive),\n                # potential_product will be 0 or negative (if numbers[i] is negative, which is already handled\n                # as dp[i] starts at 0 for negative numbers, and won't be replaced by a negative product).\n                potential_product = dp[j] * numbers[i]\n                \n                # Update dp[i] with the maximum product found for subsequences ending at i.\n                dp[i] = max(dp[i], potential_product)\n        \n        # Update the overall maximum product found across all subsequences.\n        max_product = max(max_product, dp[i])\n        \n    return max_product"}
{"task_id": "Mbpp/473", "solution": "class Tuple:\n    def __init__(self, element1, element2):\n        # Stores the sorted elements for canonical representation.\n        self._canonical_form = tuple(sorted((element1, element2)))\n\n    def __eq__(self, other):\n        # Compares two Tuple instances based on their canonical form.\n        return self._canonical_form == other._canonical_form\n\n    def __hash__(self):\n        # Computes a hash for the Tuple instance based on its canonical form.\n        return hash(self._canonical_form)\n\n    def get_original_form(self):\n        # Returns the canonical tuple form, consistent with the expected output format.\n        return self._canonical_form\ndef tuple_intersection(list1: list[tuple], list2: list[tuple]) -> set[tuple]:\n    processed_set_A = set()\n    for tup in list1:\n        # Convert each tuple into its canonical Tuple object and add to a set.\n        processed_set_A.add(Tuple(tup[0], tup[1]))\n\n    intersection_result_set = set()\n    for tup in list2:\n        # Convert the current tuple from list2 into its canonical Tuple object.\n        current_canonical_tup = Tuple(tup[0], tup[1])\n        # If the canonical form exists in processed_set_A, it's an intersection.\n        if current_canonical_tup in processed_set_A:\n            intersection_result_set.add(current_canonical_tup.get_original_form())\n\n    return intersection_result_set"}
