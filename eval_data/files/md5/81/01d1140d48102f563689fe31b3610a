{"task_id": "Mbpp/108", "solution": "def merge_sorted_list(list1: list, list2: list, list3: list) -> list:\n    \"\"\"\n    Merges three input lists into a single sorted list.\n    Returns a new list containing all elements from the three input lists, sorted in ascending order.\n    \"\"\"\n    combined_list = list1 + list2 + list3\n    combined_list.sort()\n    return combined_list"}
{"task_id": "Mbpp/111", "solution": "def common_in_nested_lists(nested_lists: list[list[any]]) -> set[any]:\n    \"\"\"\n    Finds common elements in a given collection of nested lists.\n    Returns a set of elements present in all input lists, or an empty set if none are found.\n    \"\"\"\n    if not nested_lists:\n        return set()\n\n    common_elements = set(nested_lists[0])\n\n    if not common_elements and nested_lists[0]:\n        return set()\n\n    for i in range(1, len(nested_lists)):\n        if not common_elements:\n            break\n        common_elements.intersection_update(nested_lists[i])\n\n    return common_elements"}
{"task_id": "Mbpp/113", "solution": "def check_integer(input_string: str) -> bool:\n    \"\"\"\n    Checks if a string represents an integer, optionally prefixed by a '+' or '-' sign.\n    Returns True for valid integers, False otherwise.\n    \"\"\"\n    if not input_string:\n        return False\n\n    start_index = 0\n    if input_string[0] == '+' or input_string[0] == '-':\n        start_index = 1\n\n    # An integer must have at least one digit after an optional sign\n    if len(input_string) <= start_index:\n        return False\n\n    for i in range(start_index, len(input_string)):\n        if not '0' <= input_string[i] <= '9':\n            return False\n\n    return True"}
