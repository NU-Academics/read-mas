{"task_id": "Mbpp/722", "solution": "def filter_data(student_data: dict[str, tuple[float, float]], minimal_height: float, minimal_weight: float) -> dict[str, tuple[float, float]]:\n    \"\"\"\n    Filters a dictionary of student data, returning a new dictionary containing only\n    students whose height and weight are above the specified minimums.\n    \"\"\"\n    filtered_results = {}\n    for student_name, (height, weight) in student_data.items():\n        if height >= minimal_height and weight >= minimal_weight:\n            filtered_results[student_name] = (height, weight)\n    return filtered_results"}
{"task_id": "Mbpp/723", "solution": "def count_same_pair(list1: list, list2: list) -> int:\n    \"\"\"\n    Counts the number of indices where values in two lists are identical.\n    It is assumed that the two input lists are of equal length.\n    \"\"\"\n    count = 0\n    for i in range(len(list1)):\n        if list1[i] == list2[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/721", "solution": "import math\nclass Cell:\n    \"\"\"Stores cell coordinates and cost.\"\"\"\n    def __init__(self, row: int, col: int, cost: int):\n        self.row = row\n        self.col = col\n        self.cost = cost\nclass Matrix:\n    \"\"\"Represents the N*N grid of cells and provides access to them.\"\"\"\n    def __init__(self, matrix_data: list[list[int]]):\n        self.N = len(matrix_data)\n        self.cells = [[Cell(r, c, matrix_data[r][c]) for c in range(self.N)] for r in range(self.N)]\n\n    def get_cell(self, row: int, col: int) -> Cell:\n        \"\"\"Returns the Cell object at the specified row and column.\"\"\"\n        return self.cells[row][col]\n\n    def is_valid_coordinate(self, row: int, col: int) -> bool:\n        \"\"\"Checks if the given coordinates are within matrix bounds.\"\"\"\n        return 0 <= row < self.N and 0 <= col < self.N\nclass Path:\n    \"\"\"Manages the sequence of cells in a path and calculates its total cost, cell count, and average cost.\"\"\"\n    def __init__(self, initial_cell: Cell):\n        self.sequence_of_cells = [initial_cell]\n        self.total_cost = float(initial_cell.cost)\n        self.cell_count = 1\n        self.average_cost = float(initial_cell.cost)\n\n    def add_cell(self, cell: Cell):\n        \"\"\"Adds a cell to the path and incrementally updates metrics.\"\"\"\n        self.sequence_of_cells.append(cell)\n        self.total_cost += cell.cost\n        self.cell_count += 1\n        self.average_cost = self.total_cost / self.cell_count\n\n    def clone(self) -> 'Path':\n        \"\"\"Returns a deep copy of the current path.\"\"\"\n        new_path = Path(self.sequence_of_cells[0])\n        new_path.sequence_of_cells = list(self.sequence_of_cells) # shallow copy is fine for immutable Cells\n        new_path.total_cost = self.total_cost\n        new_path.cell_count = self.cell_count\n        new_path.average_cost = self.average_cost\n        return new_path\n\n    def get_average_cost(self) -> float:\n        \"\"\"Returns the calculated average cost of the path.\"\"\"\n        return self.average_cost\nclass PathFinder:\n    \"\"\"Identifies all valid paths from the top-left to the bottom-right cell in a given matrix.\"\"\"\n    def find_all_paths(self, matrix: Matrix) -> list[Path]:\n        \"\"\"Discovers and returns all valid paths in the given matrix using DFS.\"\"\"\n        all_paths = []\n        start_cell = matrix.get_cell(0, 0)\n        initial_path = Path(start_cell)\n        self._dfs(matrix, 0, 0, initial_path, all_paths)\n        return all_paths\n\n    def _dfs(self, matrix: Matrix, r: int, c: int, current_path: Path, all_paths: list[Path]):\n        \"\"\"Recursive helper function to explore paths.\"\"\"\n        if r == matrix.N - 1 and c == matrix.N - 1:\n            all_paths.append(current_path)\n            return\n\n        # Move right\n        if matrix.is_valid_coordinate(r, c + 1):\n            next_cell = matrix.get_cell(r, c + 1)\n            cloned_path = current_path.clone()\n            cloned_path.add_cell(next_cell)\n            self._dfs(matrix, r, c + 1, cloned_path, all_paths)\n\n        # Move down\n        if matrix.is_valid_coordinate(r + 1, c):\n            next_cell = matrix.get_cell(r + 1, c)\n            cloned_path = current_path.clone()\n            cloned_path.add_cell(next_cell)\n            self._dfs(matrix, r + 1, c, cloned_path, all_paths)\ndef maxAverageOfPath(matrix_data: list[list[int]]) -> float:\n    \"\"\"\n    Finds a path with the maximum average over all existing paths in a square matrix.\n    Paths move only right or down from top-left to bottom-right.\n    \"\"\"\n    matrix = Matrix(matrix_data)\n    path_finder = PathFinder()\n    all_paths = path_finder.find_all_paths(matrix)\n\n    max_average = -math.inf\n    for path in all_paths:\n        max_average = max(max_average, path.get_average_cost())\n\n    return max_average"}
{"task_id": "Mbpp/724", "solution": "def power_base_sum(base, power):\n    \"\"\"\n    Calculates the sum of all digits of the base raised to the specified power.\n    Leverages Python's arbitrary-precision integers for large results.\n    \"\"\"\n    result = base ** power\n    sum_of_digits = 0\n    for digit_char in str(result):\n        sum_of_digits += int(digit_char)\n    return sum_of_digits"}
