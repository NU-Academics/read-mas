{"task_id": "Mbpp/20", "solution": "def is_woodall(number: int) -> bool:\n    \"\"\"\n    Determines if the given positive integer is a Woodall number (n * 2^n - 1).\n    Raises ValueError if the input number is not a positive integer.\n    \"\"\"\n    if not isinstance(number, int) or number <= 0:\n        raise ValueError(\"Input number must be a positive integer.\")\n\n    n = 1\n    while True:\n        woodall_candidate = n * (2**n) - 1\n\n        if woodall_candidate == number:\n            return True\n        elif woodall_candidate > number:\n            return False\n\n        n += 1"}
{"task_id": "Mbpp/57", "solution": "def find_Max_Num(digits: list[int]) -> int:\n    \"\"\"Forms the largest number from a list of digits.\"\"\"\n    if not digits:\n        return 0\n\n    # Convert all digits to strings and sort them in descending order to form the largest number.\n    digit_strings = [str(d) for d in digits]\n    digit_strings.sort(reverse=True)\n\n    # Concatenate the sorted digit strings and convert the result to an integer.\n    largest_num_str = \"\".join(digit_strings)\n    return int(largest_num_str)"}
