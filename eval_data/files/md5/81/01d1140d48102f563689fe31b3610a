{"task_id": "Mbpp/77", "solution": "def is_Diff(number: int) -> bool:\n    \"\"\"\n    Checks if a number is divisible by 11 using the alternating sum of digits method.\n    The function name `is_Diff` is used as per the problem description.\n    \"\"\"\n    if number < 0:\n        number = -number # Work with the absolute value\n\n    str_number = str(number)\n    alternating_sum = 0\n    for i, digit_char in enumerate(str_number):\n        digit = int(digit_char)\n        if i % 2 == 0:  # Even position (0-indexed)\n            alternating_sum += digit\n        else:  # Odd position\n            alternating_sum -= digit\n\n    return alternating_sum % 11 == 0"}
{"task_id": "Mbpp/75", "solution": "def _is_all_elements_divisible(tup: tuple[int, ...], k: int) -> bool:\n    \"\"\"Checks if all elements in a tuple are perfectly divisible by k.\"\"\"\n    if k == 0:\n        # If k is 0, return True for an empty tuple, False otherwise (division by zero undefined).\n        return len(tup) == 0\n    for element in tup:\n        if element % k != 0:\n            return False\n    return True\ndef find_tuples(list_of_tuples: list[tuple[int, ...]], k: int) -> list[tuple[int, ...]]:\n    \"\"\"\n    Finds tuples where all elements are divisible by k from the given list of tuples.\n    This function utilizes a helper to check individual tuple divisibility.\n    \"\"\"\n    filtered_list = []\n    for current_tuple in list_of_tuples:\n        if _is_all_elements_divisible(current_tuple, k):\n            filtered_list.append(current_tuple)\n    return filtered_list"}
{"task_id": "Mbpp/74", "solution": "def is_samepatterns(list1: list, list2: list) -> bool:\n    \"\"\"Checks if two lists follow the same relative pattern.\n\n    Returns True if the patterns match, False otherwise.\n    \"\"\"\n    if len(list1) != len(list2):\n        return False\n\n    map1 = {}\n    map2 = {}\n    canonical_id_counter1 = 0\n    canonical_id_counter2 = 0\n\n    for i in range(len(list1)):\n        elem1 = list1[i]\n        elem2 = list2[i]\n\n        if elem1 not in map1:\n            map1[elem1] = canonical_id_counter1\n            canonical_id_counter1 += 1\n\n        if elem2 not in map2:\n            map2[elem2] = canonical_id_counter2\n            canonical_id_counter2 += 1\n\n        if map1[elem1] != map2[elem2]:\n            return False\n\n    return True"}
