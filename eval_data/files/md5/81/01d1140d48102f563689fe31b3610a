{"task_id": "Mbpp/129", "solution": "import math\nfrom typing import List\nclass Matrix:\n    \"\"\"Encapsulates the 2D array, providing safe access to its dimensions and elements, and validating its square property.\"\"\"\n    def __init__(self, elements: List[List[int]]):\n        self._elements = elements\n        self._row_count = len(elements)\n        self._col_count = len(elements[0]) if elements and elements[0] else 0\n\n    def get_row_count(self) -> int:\n        \"\"\"Returns the number of rows in the matrix.\"\"\"\n        return self._row_count\n\n    def get_column_count(self) -> int:\n        \"\"\"Returns the number of columns in the matrix.\"\"\"\n        return self._col_count\n\n    def get_element(self, row: int, col: int) -> int:\n        \"\"\"Returns the element at the specified row and column.\"\"\"\n        return self._elements[row][col]\n\n    def is_square(self) -> bool:\n        \"\"\"Determines if the matrix is a square matrix.\"\"\"\n        if self._row_count == 0:\n            return self._col_count == 0\n        \n        for row in self._elements:\n            if len(row) != self._col_count:\n                return False\n\n        return self._row_count == self._col_count\nclass SumCollection:\n    \"\"\"A data transfer object (DTO) to hold and compare all calculated sums.\"\"\"\n    def __init__(self, row_sums: List[int], col_sums: List[int], main_diagonal_sum: int, anti_diagonal_sum: int):\n        self.row_sums = row_sums\n        self.col_sums = col_sums\n        self.main_diagonal_sum = main_diagonal_sum\n        self.anti_diagonal_sum = anti_diagonal_sum\n\n    def all_sums_equal(self) -> bool:\n        \"\"\"Compares all stored sums to ensure they are equal.\"\"\"\n        if not self.row_sums:\n            return False\n\n        expected_sum = self.row_sums[0]\n\n        if any(s != expected_sum for s in self.row_sums):\n            return False\n\n        if any(s != expected_sum for s in self.col_sums):\n            return False\n\n        if self.main_diagonal_sum != expected_sum:\n            return False\n\n        if self.anti_diagonal_sum != expected_sum:\n            return False\n\n        return True\nclass MagicSquareChecker:\n    \"\"\"Contains the business logic for validating a magic square, delegating calculations and comparisons.\"\"\"\n    def check_magic_square(self, matrix_obj: Matrix) -> bool:\n        \"\"\"Determines if the given Matrix object is a magic square.\"\"\"\n        if not matrix_obj.is_square():\n            return False\n\n        if matrix_obj.get_row_count() == 0:\n            return False\n\n        row_sums = self._calculate_row_sums(matrix_obj)\n        col_sums = self._calculate_column_sums(matrix_obj)\n        main_diag_sum = self._calculate_main_diagonal_sum(matrix_obj)\n        anti_diag_sum = self._calculate_anti_diagonal_sum(matrix_obj)\n\n        sum_collection = SumCollection(row_sums, col_sums, main_diag_sum, anti_diag_sum)\n        return sum_collection.all_sums_equal()\n\n    def _calculate_row_sums(self, matrix_obj: Matrix) -> List[int]:\n        \"\"\"Calculates the sum of each row in the matrix.\"\"\"\n        sums = []\n        for r_idx in range(matrix_obj.get_row_count()):\n            current_row_sum = 0\n            for c_idx in range(matrix_obj.get_column_count()):\n                current_row_sum += matrix_obj.get_element(r_idx, c_idx)\n            sums.append(current_row_sum)\n        return sums\n\n    def _calculate_column_sums(self, matrix_obj: Matrix) -> List[int]:\n        \"\"\"Calculates the sum of each column in the matrix.\"\"\"\n        sums = []\n        for c_idx in range(matrix_obj.get_column_count()):\n            current_col_sum = 0\n            for r_idx in range(matrix_obj.get_row_count()):\n                current_col_sum += matrix_obj.get_element(r_idx, c_idx)\n            sums.append(current_col_sum)\n        return sums\n\n    def _calculate_main_diagonal_sum(self, matrix_obj: Matrix) -> int:\n        \"\"\"Calculates the sum of the main diagonal.\"\"\"\n        main_diag_sum = 0\n        size = matrix_obj.get_row_count()\n        for i in range(size):\n            main_diag_sum += matrix_obj.get_element(i, i)\n        return main_diag_sum\n\n    def _calculate_anti_diagonal_sum(self, matrix_obj: Matrix) -> int:\n        \"\"\"Calculates the sum of the anti-diagonal.\"\"\"\n        anti_diag_sum = 0\n        size = matrix_obj.get_row_count()\n        for i in range(size):\n            anti_diag_sum += matrix_obj.get_element(i, size - 1 - i)\n        return anti_diag_sum\ndef magic_square_test(matrix_data: List[List[int]]) -> bool:\n    \"\"\"Accepts a 2D array and returns True if it's a magic square, False otherwise.\"\"\"\n    matrix_obj = Matrix(matrix_data)\n    checker = MagicSquareChecker()\n    return checker.check_magic_square(matrix_obj)"}
{"task_id": "Mbpp/130", "solution": "def max_occurrences(item_list: list) -> any:\n    \"\"\"\n    Calculates the frequency of each item in a list and returns the item with the highest frequency.\n    If multiple items have the same maximum frequency, the one encountered first is returned.\n    \"\"\"\n    if not item_list:\n        return None\n\n    frequency_map = {}\n    for item in item_list:\n        frequency_map[item] = frequency_map.get(item, 0) + 1\n\n    max_count = -1\n    max_item = None\n\n    # Iterate through the original list to find the first item with max frequency\n    # This ensures that if multiple items have the same max frequency, the one\n    # that appeared earliest in the input list is returned.\n    for item in item_list:\n        if frequency_map[item] > max_count:\n            max_count = frequency_map[item]\n            max_item = item\n        # If the current item has the same frequency as the current max_item,\n        # we do nothing, thus preserving the item encountered first.\n\n    return max_item"}
{"task_id": "Mbpp/131", "solution": "def reverse_vowels(input_string: str) -> str:\n    \"\"\"\n    Reverses only the vowels in a given string.\n    Vowels are 'a', 'e', 'i', 'o', 'u' (case-insensitive), and 'y' is not a vowel.\n    \"\"\"\n    def _is_vowel(char: str) -> bool:\n        \"\"\"\n        Checks if a character is a vowel (a, e, i, o, u, case-insensitive).\n        'y' is explicitly not considered a vowel.\n        \"\"\"\n        return char.lower() in \"aeiou\"\n\n    s_list = list(input_string)\n    vowel_indices = []\n    vowels = []\n\n    for i, char in enumerate(s_list):\n        if _is_vowel(char):\n            vowel_indices.append(i)\n            vowels.append(char)\n\n    # Reverse the collected vowels\n    vowels.reverse()\n\n    # Place the reversed vowels back into their original positions\n    for i, char in zip(vowel_indices, vowels):\n        s_list[i] = char\n\n    return \"\".join(s_list)"}
{"task_id": "Mbpp/133", "solution": "from typing import List\nclass Number:\n    \"\"\"Encapsulates an integer value and provides a method to check its negativity.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def is_negative(self) -> bool:\n        \"\"\"Returns True if the number's value is less than zero, False otherwise.\"\"\"\n        return self.value < 0\nclass NumberList:\n    \"\"\"Manages a collection of Number objects, facilitates filtering negative numbers, and calculates their sum.\"\"\"\n    def __init__(self, numbers_data: List[int]):\n        self.numbers: List[Number] = []\n        for val in numbers_data:\n            self.add_number(Number(val))\n\n    def add_number(self, num: 'Number'):\n        \"\"\"Adds a Number object to the internal list.\"\"\"\n        self.numbers.append(num)\n\n    def get_negative_numbers(self) -> List['Number']:\n        \"\"\"Filters and returns a list containing only the negative Number objects.\"\"\"\n        negative_nums = []\n        for num in self.numbers:\n            if num.is_negative():\n                negative_nums.append(num)\n        return negative_nums\n\n    def calculate_sum(self) -> int:\n        \"\"\"Calculates the sum of the values of all negative Number objects in the list.\"\"\"\n        total_sum = 0\n        for num in self.get_negative_numbers():\n            total_sum += num.value\n        return total_sum\ndef sum_negativenum(numbers_list: List[int]) -> int:\n    \"\"\"Calculates the sum of the negative numbers of a given list of numbers.\"\"\"\n    number_list_obj = NumberList(numbers_list)\n    return number_list_obj.calculate_sum()"}
{"task_id": "Mbpp/135", "solution": "def hexagonal_num(n: int) -> int:\n    \"\"\"\n    Calculates the nth hexagonal number.\n    Input 'n' must be a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    return n * (2 * n - 1)"}
