{"task_id": "Mbpp/430", "solution": "class DirectrixError(Exception):\n    \"\"\"Custom exception raised when 'a' coefficient is zero, making directrix calculation impossible.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\nclass Parabola:\n    \"\"\"Represents a parabola defined by y = ax^2 + bx + c and provides methods to calculate its directrix.\"\"\"\n    def __init__(self, a: float, b: float, c: float):\n        if a == 0:\n            raise DirectrixError(\"Coefficient 'a' cannot be zero for a parabola.\")\n        self._a = a\n        self._b = b\n        self._c = c\n\n    def getDirectrix(self) -> float:\n        \"\"\"Calculates the directrix of the parabola using the formula y = c - (b^2 + 1) / (4a).\"\"\"\n        return self._c - (self._b**2 + 1) / (4 * self._a)\ndef parabola_directrix(a: float, b: float, c: float) -> float:\n    \"\"\"\n    Calculates the directrix of a parabola given its coefficients a, b, and c\n    for the equation y = ax^2 + bx + c.\n    \"\"\"\n    try:\n        parabola = Parabola(a, b, c)\n        return parabola.getDirectrix()\n    except DirectrixError as e:\n        # Re-raise the custom error as specified in the design.\n        raise e"}
{"task_id": "Mbpp/428", "solution": "def shell_sort(arr: list) -> list:\n    \"\"\"Sorts the input list `arr` using the Shell Sort algorithm.\"\"\"\n    n = len(arr)\n    # Create a copy to ensure the original list is not modified.\n    sorted_arr = list(arr)\n\n    # Start with a large gap, then reduce the gap until it is 1.\n    gap = n // 2\n    while gap > 0:\n        # Perform a gapped insertion sort for the current gap size.\n        # This loop does an insertion sort for all elements at a 'gap' distance.\n        for i in range(gap, n):\n            # Store the current element to be inserted into the gap-sorted sublist.\n            temp = sorted_arr[i]\n            j = i\n            # Shift earlier gap-sorted elements up until the correct location for temp is found.\n            while j >= gap and sorted_arr[j - gap] > temp:\n                sorted_arr[j] = sorted_arr[j - gap]\n                j -= gap\n            # Place temp (the original sorted_arr[i]) in its correct location within the sublist.\n            sorted_arr[j] = temp\n        # Reduce the gap for the next pass.\n        gap //= 2\n    return sorted_arr"}
{"task_id": "Mbpp/429", "solution": "def and_tuples(tuple1: tuple[int, ...], tuple2: tuple[int, ...]) -> tuple[int, ...]:\n    \"\"\"\n    Computes the element-wise bitwise AND of two input tuples.\n    The length of the output tuple is equal to the length of the shortest input tuple.\n    \"\"\"\n    results = [a & b for a, b in zip(tuple1, tuple2)]\n    return tuple(results)"}
