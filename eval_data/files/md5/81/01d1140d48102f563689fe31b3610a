{"task_id": "Mbpp/593", "solution": "class Octet:\n    \"\"\"Represents a single octet of an IP address and handles its normalization.\"\"\"\n    def __init__(self, raw_octet_str: str):\n        self._raw_value = raw_octet_str\n        self._normalized_value = int(raw_octet_str)\n\n    def get_normalized_str(self) -> str:\n        \"\"\"Returns the string representation of the normalized octet.\"\"\"\n        return str(self._normalized_value)\nclass IPAddress:\n    \"\"\"Represents an IP address, parses its octets, and orchestrates their normalization.\"\"\"\n    def __init__(self, ip_address_str: str):\n        self._raw_ip_str = ip_address_str\n        octet_strings = ip_address_str.split('.')\n        self._octets = [Octet(os) for os in octet_strings]\n\n    def normalize(self) -> str:\n        \"\"\"Normalizes all contained octets and reconstructs the IP address string.\"\"\"\n        normalized_octet_strs = [octet.get_normalized_str() for octet in self._octets]\n        return '.'.join(normalized_octet_strs)\ndef removezero_ip(ip_address_str: str) -> str:\n    \"\"\"Public entry point to normalize an IP address string by removing leading zeroes.\n\n    Args:\n        ip_address_str: The IP address string to normalize.\n    Returns:\n        The normalized IP address string.\n    \"\"\"\n    ip_obj = IPAddress(ip_address_str)\n    return ip_obj.normalize()"}
{"task_id": "Mbpp/598", "solution": "class Number:\n    \"\"\"\n    Encapsulates a numerical value and provides methods to analyze its digits for Armstrong number determination.\n    \"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def getDigitCount(self) -> int:\n        \"\"\"Calculates and returns the total number of digits in the value.\"\"\"\n        if self.value == 0:\n            return 1\n        return len(str(self.value))\n\n    def getDigit(self, index: int) -> int:\n        \"\"\"Retrieves the digit at the specified 0-based index (from left) of the value.\"\"\"\n        return int(str(self.value)[index])\n\n    def calculateSumOfPowersOfDigits(self) -> int:\n        \"\"\"Calculates the sum of each digit raised to the power of the total number of digits.\"\"\"\n        digit_count = self.getDigitCount()\n        sum_of_powers = 0\n        temp_num = abs(self.value) # Handle negative numbers by using absolute value for digit extraction\n\n        if temp_num == 0:\n            return 0 ** digit_count # 0^1 = 0\n\n        while temp_num > 0:\n            digit = temp_num % 10\n            sum_of_powers += digit ** digit_count\n            temp_num //= 10\n        return sum_of_powers\n\n    def isArmstrong(self) -> bool:\n        \"\"\"Determines if the value is an Armstrong number.\"\"\"\n        # Armstrong numbers are typically defined for positive integers.\n        # Handle 0 as a special case: 0 is sometimes considered Armstrong (0^1 = 0).\n        if self.value < 0:\n            return False\n        return self.value == self.calculateSumOfPowersOfDigits()\ndef armstrong_number(number: int) -> bool:\n    \"\"\"\n    Checks whether the given number is an Armstrong number.\n    An Armstrong number is one where the sum of its own digits, each raised to the power of the number of digits, is equal to the number itself.\n    \"\"\"\n    num_obj = Number(number)\n    return num_obj.isArmstrong()"}
{"task_id": "Mbpp/597", "solution": "def find_kth(array1: list[int], array2: list[int], k: int) -> int:\n    \"\"\"\n    Finds the kth smallest element from two sorted arrays using a two-pointer approach.\n    Assumes k is valid and arrays are sorted.\n    \"\"\"\n    ptr1 = 0\n    ptr2 = 0\n    kth_element = None\n\n    while k > 0:\n        k -= 1\n        val1 = array1[ptr1] if ptr1 < len(array1) else float('inf')\n        val2 = array2[ptr2] if ptr2 < len(array2) else float('inf')\n\n        if val1 <= val2:\n            kth_element = val1\n            ptr1 += 1\n        else:\n            kth_element = val2\n            ptr2 += 1\n            \n    return kth_element"}
{"task_id": "Mbpp/602", "solution": "def first_repeated_char(input_string: str) -> str | None:\n    \"\"\"\n    Finds the first repeated character in the given string, adhering to case-sensitivity.\n    Returns None if no character is repeated.\n    \"\"\"\n    seen_chars = set()\n    for char in input_string:\n        if char in seen_chars:\n            return char\n        seen_chars.add(char)\n    return None"}
