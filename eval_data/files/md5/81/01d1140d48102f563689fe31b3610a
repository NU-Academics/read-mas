{"task_id": "Mbpp/559", "solution": "import math\nfrom typing import List, Union\ndef max_sub_array_sum(input_list: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"\n    Calculates the maximum sum of a contiguous sublist using Kadane's algorithm.\n    Handles empty lists and lists containing only negative numbers.\n    \"\"\"\n    if not input_list:\n        return 0\n\n    max_so_far = -math.inf\n    current_max = 0\n\n    for x in input_list:\n        current_max += x\n        if current_max > max_so_far:\n            max_so_far = current_max\n        if current_max < 0:\n            current_max = 0\n            \n    # Handle the case where all numbers are negative\n    if max_so_far <= 0 and any(x < 0 for x in input_list):\n        return max(input_list)\n        \n    return max_so_far"}
{"task_id": "Mbpp/562", "solution": "def Find_Max_Length(list_of_lists: list[list]) -> int:\n    \"\"\"\n    Calculates the length of the longest sublist within a given list of lists.\n    Returns 0 if the input list is empty or if all sublists are empty.\n    \"\"\"\n    if not list_of_lists:\n        return 0\n\n    max_length = 0\n    for sublist in list_of_lists:\n        current_length = len(sublist)\n        if current_length > max_length:\n            max_length = current_length\n\n    return max_length"}
