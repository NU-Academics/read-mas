{"task_id": "Mbpp/308", "solution": "def large_product(list1, list2, k):\n    \"\"\"\n    Orchestrates finding the k largest products from two lists, selecting one factor from each.\n    \"\"\"\n\n    # 1. Generate all possible products\n    all_products = _generate_all_products(list1, list2)\n\n    # 2. Get the k largest products without guaranteeing their internal order yet.\n    k_largest_unordered = _get_k_largest(all_products, k)\n\n    # 3. Sort these k largest products in descending order for the final result.\n    k_largest_sorted = _sort_descending(k_largest_unordered)\n\n    return k_largest_sorted\ndef _generate_all_products(list1, list2):\n    \"\"\"\n    Computes all possible products by pairing one factor from each input list.\n    \"\"\"\n    products = []\n    for x in list1:\n        for y in list2:\n            products.append(x * y)\n    return products\ndef _get_k_largest(all_products, k):\n    \"\"\"\n    Identifies the 'k' largest products from a given list, returning them without guaranteeing order.\n    \"\"\"\n    # If k is non-positive, no products should be returned.\n    if k <= 0:\n        return []\n    \n    # Sort all products in ascending order to easily pick the largest 'k' values.\n    temp_products_sorted = sorted(all_products)\n    \n    # Return the last 'k' elements, which are the largest.\n    # If k is larger than the number of products, it returns all products.\n    return temp_products_sorted[-k:]\ndef _sort_descending(products):\n    \"\"\"\n    Sorts a list of products in descending order.\n    \"\"\"\n    return sorted(products, reverse=True)"}
{"task_id": "Mbpp/306", "solution": "from typing import List, Union\nclass InputArray:\n    \"\"\"Encapsulates the input array and provides safe access to its elements.\"\"\"\n    def __init__(self, elements: List[int], length: int):\n        self._elements = elements\n        self._length = length\n\n    def get_element(self, index: int) -> int:\n        return self._elements[index]\n\n    def get_length(self) -> int:\n        return self._length\nclass Subsequence:\n    \"\"\"Manages a list of elements forming a subsequence, calculates its sum, and verifies its increasing property.\"\"\"\n    def __init__(self, elements: List[int] = None):\n        self._elements = list(elements) if elements is not None else []\n\n    def add_element(self, element: int):\n        self._elements.append(element)\n\n    def get_elements(self) -> List[int]:\n        return list(self._elements)\n\n    def calculate_sum(self) -> int:\n        return sum(self._elements)\n\n    def is_increasing(self) -> bool:\n        if len(self._elements) <= 1:\n            return True\n        for i in range(1, len(self._elements)):\n            if self._elements[i] <= self._elements[i-1]:\n                return False\n        return True\n\n    def get_last_element(self) -> int:\n        if not self._elements:\n            # Should not be called on empty sequence in the main logic path.\n            return -float('inf') # Sentinel value for comparison purposes\n        return self._elements[-1]\n\n    def is_empty(self) -> bool:\n        return not self._elements\nclass Result:\n    \"\"\"Holds and updates the final maximum sum.\"\"\"\n    def __init__(self, initial_value: int = 0):\n        self._max_value = initial_value\n\n    def update_max_value(self, new_value: int):\n        if new_value > self._max_value:\n            self._max_value = new_value\n\n    def get_max_value(self) -> int:\n        return self._max_value\ndef max_sum_increasing_subseq(arr: List[int], length: int, i: int, k: int) -> int:\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence from prefix until ith index\n    and also including a given kth element (k > i).\n    \"\"\"\n    # Validate input indices and conditions (FR4, BR1, AF1)\n    if not (0 <= i < length and 0 <= k < length and k > i):\n        return -1\n\n    input_arr = InputArray(arr, length)\n    kth_element = input_arr.get_element(k)\n\n    # Initialize result with kth_element itself, representing the subsequence [kth_element].\n    result = Result(initial_value=kth_element)\n\n    # dp_subsequences[idx] stores the Subsequence object that has the maximum sum,\n    # is increasing, and ends at input_arr.get_element(idx).\n    dp_subsequences: List[Union[Subsequence, None]] = [None] * (i + 1)\n\n    for idx in range(i + 1):\n        current_element = input_arr.get_element(idx)\n\n        # Start with a subsequence containing only the current_element\n        best_sub_ending_here = Subsequence()\n        best_sub_ending_here.add_element(current_element)\n\n        # Iterate through previous elements to find extensions for the current subsequence\n        for prev_idx in range(idx):\n            prev_sub = dp_subsequences[prev_idx]\n            # Only extend if a valid previous subsequence exists and current_element is greater\n            if prev_sub is not None and current_element > prev_sub.get_last_element():\n                candidate_sub = Subsequence(prev_sub.get_elements())\n                candidate_sub.add_element(current_element)\n\n                # Update the best subsequence ending at 'idx' if the candidate has a larger sum\n                if candidate_sub.calculate_sum() > best_sub_ending_here.calculate_sum():\n                    best_sub_ending_here = candidate_sub\n        \n        # Store the best found subsequence ending at 'idx'\n        dp_subsequences[idx] = best_sub_ending_here\n\n        # If this best prefix subsequence can precede kth_element (i.e., its last element is smaller)\n        # then calculate the combined sum and update the overall maximum result.\n        if not best_sub_ending_here.is_empty() and best_sub_ending_here.get_last_element() < kth_element:\n            combined_sum = best_sub_ending_here.calculate_sum() + kth_element\n            result.update_max_value(combined_sum)\n            \n    return result.get_max_value()"}
{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(number: int) -> int:\n    \"\"\"Sets the left-most unset bit of an integer.\n\n    This means finding the most significant 0-bit within the number's relevant bit range and setting it to 1.\n    \"\"\"\n    if number == 0:\n        return 1\n\n    # Determine the highest bit position to start searching from.\n    # For both positive and negative numbers, this is based on the magnitude.\n    # E.g., for 10 (0b1010), abs(10).bit_length() - 1 = 3.\n    # For -10 (0b...11110110), abs(-10).bit_length() - 1 = 3.\n    start_bit_pos = abs(number).bit_length() - 1\n\n    # Iterate from the most significant bit downwards to find the first unset bit (0).\n    for i in range(start_bit_pos, -1, -1):\n        if not (number & (1 << i)):  # If the i-th bit is 0\n            return number | (1 << i)\n\n    # If all bits up to start_bit_pos are set (e.g., number is 7 (0b111) or -1 (0b...1111)),\n    # set the next higher bit position (which is implicitly 0).\n    return number | (1 << (start_bit_pos + 1))"}
{"task_id": "Mbpp/391", "solution": "def convert_list_dictionary(list1: list, list2: list, list3: list) -> list:\n    \"\"\"\n    Converts three parallel input lists into a list of nested dictionaries.\n    Each dictionary will have an element from the first list as its outermost key,\n    and its value will be an inner dictionary containing an element from the second list as its key and an element from the third list as its value.\n    \"\"\"\n    if not (len(list1) == len(list2) == len(list3)):\n        raise ValueError(\"Input lists must be of equal length.\")\n\n    result = []\n    for i in range(len(list1)):\n        inner_dict = {list2[i]: list3[i]}\n        outer_dict = {list1[i]: inner_dict}\n        result.append(outer_dict)\n    return result"}
{"task_id": "Mbpp/389", "solution": "def find_lucas(n: int) -> int:\n    \"\"\"\n    Calculates the n'th Lucas number.\n    The Lucas sequence is defined as L(0)=2, L(1)=1, L(n)=L(n-1)+L(n-2) for n>1.\n    \"\"\"\n    if n == 0:\n        return 2\n    if n == 1:\n        return 1\n\n    a, b = 2, 1  # L(0), L(1)\n    for _ in range(2, n + 1):\n        a, b = b, a + b\n    return b"}
