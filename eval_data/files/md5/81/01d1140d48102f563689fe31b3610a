{"task_id": "Mbpp/12", "solution": "import collections\nfrom typing import List, Union\nclass _RowWithSum:\n    \"\"\"Helper class to encapsulate a matrix row and its pre-calculated sum.\"\"\"\n    def __init__(self, row_data: List[Union[int, float]]):\n        self._original_row = row_data\n        self._row_sum = sum(row_data)\n\n    def get_row(self) -> List[Union[int, float]]:\n        \"\"\"Returns the original row data.\"\"\"\n        return self._original_row\n\n    def get_sum(self) -> Union[int, float]:\n        \"\"\"Returns the calculated sum of the row.\"\"\"\n        return self._row_sum\ndef sort_matrix(matrix: List[List[Union[int, float]]]) -> List[List[Union[int, float]]]:\n    \"\"\"Sorts a matrix in ascending order according to the sum of its rows.\"\"\"\n    \n    rows_with_sums = []\n    for row_data in matrix:\n        rows_with_sums.append(_RowWithSum(row_data))\n\n    rows_with_sums.sort(key=lambda rws: rws.get_sum())\n\n    sorted_matrix = []\n    for rws in rows_with_sums:\n        sorted_matrix.append(rws.get_row())\n\n    return sorted_matrix"}
