{"task_id": "Mbpp/726", "solution": "def multiply_elements(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Calculates the product of adjacent elements in an input tuple and returns a new tuple.\n    Each element of the output tuple is the product of t_i and t_{i+1} from the input.\n    \"\"\"\n    products = []\n    # Iterate up to the second-to-last element to ensure i+1 is always a valid index.\n    for i in range(len(input_tuple) - 1):\n        products.append(input_tuple[i] * input_tuple[i+1])\n    return tuple(products)"}
{"task_id": "Mbpp/728", "solution": "def sum_list(list_a, list_b):\n    if len(list_a) != len(list_b):\n        raise ValueError(\"Input lists must have the same number of elements.\")\n\n    result_list = []\n    for i in range(len(list_a)):\n        result_list.append(list_a[i] + list_b[i])\n    return result_list"}
{"task_id": "Mbpp/730", "solution": "def consecutive_duplicates(items: list) -> list:\n    \"\"\"Removes consecutive duplicate elements from a given list.\n    Returns a new list with consecutive duplicate elements removed.\"\"\"\n    if not items:\n        return []\n\n    result = [items[0]]\n    for i in range(1, len(items)):\n        if items[i] != result[-1]:\n            result.append(items[i])\n    return result"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(input_list: list) -> (int | float):\n    \"\"\"\n    Calculates the sum of products of all possible sublists of a given list.\n    \"\"\"\n    total_sum_of_products = 0\n\n    for i in range(len(input_list)):\n        for j in range(i, len(input_list)):\n            sublist = input_list[i : j + 1]\n\n            current_product = 1\n            for element in sublist:\n                current_product *= element\n\n            total_sum_of_products += current_product\n\n    return total_sum_of_products"}
{"task_id": "Mbpp/732", "solution": "def replace_specialchar(input_string: str) -> str:\n    \"\"\"\n    Replaces all occurrences of spaces, commas, or dots with a colon in the input string.\n    \"\"\"\n    processed_string = input_string.replace(' ', ':')\n    processed_string = processed_string.replace(',', ':')\n    processed_string = processed_string.replace('.', ':')\n    return processed_string"}
{"task_id": "Mbpp/731", "solution": "import math\ndef lateralsurface_cone(r: float, h: float) -> float:\n    \"\"\"Calculates the lateral surface area of a cone.\"\"\"\n    if r < 0 or h < 0:\n        raise ValueError(\"Radius and height must be non-negative.\")\n\n    # Calculate slant height 'l'\n    l = math.sqrt(r**2 + h**2)\n\n    # Calculate lateral surface area: \u03c0 * r * l\n    lateral_surface_area = math.pi * r * l\n\n    return lateral_surface_area"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(array: list[int | float], target: int | float) -> int:\n    \"\"\"\n    Finds the 0-based index of the first occurrence of a target number in a sorted array.\n    Returns the 0-based index if the target is found, otherwise returns -1.\n    \"\"\"\n    low, high = 0, len(array) - 1\n    first_occurrence_index = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == target:\n            first_occurrence_index = mid\n            high = mid - 1  # Try to find an earlier occurrence\n        elif array[mid] < target:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return first_occurrence_index"}
{"task_id": "Mbpp/735", "solution": "class Number:\n    def __init__(self, value: int):\n        self._value = value\n        self._binary_representation = bin(value)\n\n    def get_binary_representation(self) -> str:\n        return self._binary_representation\n\n    def get_first_bit(self) -> str:\n        if len(self._binary_representation) <= 2: \n            return self._binary_representation[-1]\n        return self._binary_representation[2]\n\n    def get_last_bit(self) -> str:\n        return self._binary_representation[-1]\n\n    def get_middle_bits(self) -> str:\n        if len(self._binary_representation) <= 4:\n            return \"\"\n        return self._binary_representation[3:-1]\n\n    def invert_middle_bits(self) -> str:\n        first_bit = self.get_first_bit()\n        last_bit = self.get_last_bit()\n        middle_bits = self.get_middle_bits()\n\n        inverted_middle_bits = ''.join(['1' if bit == '0' else '0' for bit in middle_bits])\n\n        if len(self._binary_representation) <= 4:\n            return self._binary_representation\n        else:\n            return f\"0b{first_bit}{inverted_middle_bits}{last_bit}\"\n\n    @staticmethod\n    def to_decimal(binary_string: str) -> int:\n        return int(binary_string, 2)\ndef toggle_middle_bits(input_integer: int) -> int:\n    \"\"\"Toggles bits of the number except the first and the last bit.\"\"\"\n    number_obj = Number(input_integer)\n    modified_binary_string = number_obj.invert_middle_bits()\n    result_integer = Number.to_decimal(modified_binary_string)\n    return result_integer"}
{"task_id": "Mbpp/739", "solution": "import math\nclass _TriangularNumber:\n    \"\"\"Encapsulates the properties and calculations for a single triangular number.\"\"\"\n    def __init__(self, k: int):\n        self._index = k\n        self._value = 0\n        self._digit_count = 0\n        self.calculate_value(k)\n        self.get_digit_count() # calculate and store digit count\n\n    def calculate_value(self, k: int) -> None:\n        \"\"\"Calculates T_k = k * (k + 1) / 2 and stores it in _value.\"\"\"\n        self._value = k * (k + 1) // 2\n\n    def get_digit_count(self) -> int:\n        \"\"\"Returns the number of digits in _value.\"\"\"\n        if self._value == 0:\n            self._digit_count = 1\n        else:\n            self._digit_count = int(math.log10(self._value)) + 1\n        return self._digit_count\n\n    def get_index(self) -> int:\n        \"\"\"Returns the index k.\"\"\"\n        return self._index\n\n    def get_value(self) -> int:\n        \"\"\"Returns the calculated triangular number value.\"\"\"\n        return self._value\nclass _TriangularNumberFinder:\n    \"\"\"Orchestrates the iterative search for the smallest triangular number with the target digit count.\"\"\"\n    def find_index_of_smallest(self, target_digits: int) -> int:\n        k_current = 1\n        while True:\n            tri_num = _TriangularNumber(k_current)\n            if tri_num.get_digit_count() == target_digits:\n                return k_current\n            k_current += 1\ndef find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with n digits.\n    The function uses helper classes for modularity.\n    \"\"\"\n    finder = _TriangularNumberFinder()\n    return finder.find_index_of_smallest(n)"}
{"task_id": "Mbpp/736", "solution": "import bisect\ndef left_insertion(sorted_list: list[float | int], value: float | int) -> int:\n    \"\"\"\n    Finds the index where 'value' should be inserted into 'sorted_list' to maintain sorted order.\n    Returns the leftmost insertion point.\n    \"\"\"\n    return bisect.bisect_left(sorted_list, value)"}
