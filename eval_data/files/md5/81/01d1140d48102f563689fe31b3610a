{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list: list, sub_list: list) -> bool:\n    \"\"\"\n    Checks if `sub_list` is a contiguous subsequence of `main_list`.\n    Returns True if found, False otherwise.\n    \"\"\"\n    n = len(main_list)\n    m = len(sub_list)\n\n    if m == 0:\n        return True\n    if m > n:\n        return False\n\n    for i in range(n - m + 1):\n        if main_list[i : i + m] == sub_list:\n            return True\n    return False"}
{"task_id": "Mbpp/68", "solution": "def _is_monotonically_increasing(array: list) -> bool:\n    \"\"\"\n    Checks if the given array is monotonically increasing.\n    \"\"\"\n    for i in range(len(array) - 1):\n        if array[i] > array[i+1]:\n            return False\n    return True\ndef _is_monotonically_decreasing(array: list) -> bool:\n    \"\"\"\n    Checks if the given array is monotonically decreasing.\n    \"\"\"\n    for i in range(len(array) - 1):\n        if array[i] < array[i+1]:\n            return False\n    return True\ndef is_Monotonic(array: list) -> bool:\n    \"\"\"\n    Checks whether the given array is monotonic or not.\n    An array is monotonic if it is either monotonically increasing or monotonically decreasing.\n    \"\"\"\n    if len(array) <= 1:\n        return True\n\n    return _is_monotonically_increasing(array) or _is_monotonically_decreasing(array)"}
{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Bell number using Stirling numbers of the second kind.\n    B(n) is the number of partitions of a set with n elements.\n    \"\"\"\n    if n == 0:\n        return 1\n    \n    # Initialize a 2D array for Stirling numbers of the second kind S(i, j)\n    # S[i][j] stores the number of ways to partition i elements into j non-empty subsets\n    stirling = [[0] * (n + 1) for _ in range(n + 1)]\n\n    # Base case for Stirling numbers: S(0, 0) = 1\n    stirling[0][0] = 1\n\n    # Fill the Stirling numbers table using the recurrence relation:\n    # S(i, j) = S(i-1, j-1) + j * S(i-1, j)\n    for i in range(1, n + 1):\n        for j in range(1, i + 1):\n            stirling[i][j] = stirling[i-1][j-1] + j * stirling[i-1][j]\n            \n    # The nth Bell number B(n) is the sum of Stirling numbers of the second kind for n\n    # B(n) = sum(k=0 to n) S(n, k)\n    bell_n = 0\n    for k in range(n + 1):\n        bell_n += stirling[n][k]\n    \n    return bell_n"}
{"task_id": "Mbpp/71", "solution": "def comb_sort(input_list):\n    \"\"\"Sorts a list of elements using the Comb Sort algorithm in ascending order.\"\"\"\n    n = len(input_list)\n    arr = list(input_list) # Create a copy to avoid modifying the original list in-place.\n\n    gap = n\n    shrink_factor = 1.3\n    swapped = True\n\n    while gap > 1 or swapped:\n        gap = int(gap / shrink_factor)\n        if gap < 1:\n            gap = 1\n\n        swapped = False\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True\n    return arr"}
