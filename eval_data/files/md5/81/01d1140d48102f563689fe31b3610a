{"task_id": "Mbpp/7", "solution": "def find_char_long(input_string: str) -> set[str]:\n    \"\"\"Finds all words in a string that are at least 4 characters long.\"\"\"\n    result_set = set()\n    words = input_string.split()\n    for word in words:\n        if len(word) >= 4:\n            result_set.add(word)\n    return result_set"}
{"task_id": "Mbpp/4", "solution": "import heapq\nfrom typing import List\ndef heap_queue_largest(list_of_numbers: List[int], n: int) -> List[int]:\n    \"\"\"\n    Finds the n largest integers from a given list of numbers using a heap-based algorithm.\n    The returned list is in descending order.\n    \"\"\"\n    if n <= 0 or not list_of_numbers:\n        return []\n\n    min_heap = []\n\n    for number in list_of_numbers:\n        if len(min_heap) < n:\n            heapq.heappush(min_heap, number)\n        elif number > min_heap[0]:\n            heapq.heapreplace(min_heap, number)\n\n    result = []\n    while min_heap:\n        result.append(heapq.heappop(min_heap))\n\n    return result[::-1]"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(source_string: str, target_char: str) -> str:\n    \"\"\"Removes the first and last occurrences of a given character from the string.\"\"\"\n    first_idx = source_string.find(target_char)\n    last_idx = source_string.rfind(target_char)\n\n    if first_idx == -1:\n        # Character not found\n        return source_string\n    elif first_idx == last_idx:\n        # Character found exactly once\n        return source_string[:first_idx] + source_string[first_idx+1:]\n    else:\n        # Character found multiple times\n        # Remove the last occurrence first to avoid shifting index of the first occurrence\n        temp_string = source_string[:last_idx] + source_string[last_idx+1:]\n        # Remove the first occurrence from the modified string\n        return temp_string[:first_idx] + temp_string[first_idx+1:]"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(num1: int, num2: int) -> bool:\n    \"\"\"\n    Checks if two integers differ at exactly one bit position.\n    This is determined by XORing the numbers and counting the set bits in the result.\n    \"\"\"\n    xor_result = num1 ^ num2\n    # Count the number of set bits (1s) in the XOR result\n    # The bin() function returns a string prefixed with '0b', e.g., '0b101'.\n    # We count the '1' characters in this string.\n    set_bit_count = bin(xor_result).count('1')\n    return set_bit_count == 1"}
{"task_id": "Mbpp/3", "solution": "import math\ndef is_not_prime(number: int) -> bool:\n    \"\"\"\n    Determines if a given integer is a non-prime number.\n    Non-prime numbers are integers greater than 1 with at least one divisor other than 1 and itself.\n    \"\"\"\n    if number <= 1:\n        return False\n\n    if number == 2:\n        return False\n\n    if number % 2 == 0:\n        return True\n\n    for i in range(3, int(math.sqrt(number)) + 1, 2):\n        if number % i == 0:\n            return True\n\n    return False"}
