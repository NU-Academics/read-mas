{"task_id": "Mbpp/116", "solution": "def tuple_to_int(input_tuple):\n    # Convert each integer in the tuple to its string representation.\n    string_parts = [str(item) for item in input_tuple]\n    # Concatenate the string parts and convert the result to an integer.\n    return int(\"\".join(string_parts))"}
{"task_id": "Mbpp/119", "solution": "def search(arr: list) -> int:\n    \"\"\"\n    Finds the element that appears only once in a sorted array where all other\n    elements appear an even number of times (implicitly, twice).\n    \"\"\"\n    low, high = 0, len(arr) - 1\n\n    while low < high:\n        mid = (low + high) // 2\n\n        # Ensure mid always points to the potential start of a pair\n        if mid % 2 == 1:\n            mid -= 1\n\n        # Compare elements at mid and mid + 1\n        if arr[mid] == arr[mid + 1]:\n            # The unique element is in the right half\n            low = mid + 2\n        else:\n            # The unique element is in the left half (or is arr[mid] itself)\n            high = mid\n\n    return arr[low]"}
{"task_id": "Mbpp/109", "solution": "class Integer:\n    \"\"\"Wraps an integer value and provides methods for validation and oddness check.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n    def is_non_negative(self) -> bool:\n        return self._value >= 0\n    def is_odd(self) -> bool:\n        return self._value % 2 != 0\n    def get_value(self) -> int:\n        return self._value\nclass RotationCount:\n    \"\"\"Encapsulates the number of rotations, leveraging the Integer class.\"\"\"\n    def __init__(self, count_value: int):\n        validate_non_negative_integer(count_value)\n        self._count = Integer(count_value)\n    def get_count(self) -> int:\n        return self._count.get_value()\nclass BinaryString:\n    \"\"\"Represents a binary string and provides methods for rotation and conversion to decimal.\"\"\"\n    def __init__(self, value: str):\n        validate_binary_string(value)\n        self._value = value\n\n    def rotate(self, num_rotations: int) -> 'BinaryString':\n        length = len(self._value)\n        if length == 0:\n            return BinaryString(\"\")\n        effective_rotations = num_rotations % length\n        rotated_value = self._value[effective_rotations:] + self._value[:effective_rotations]\n        return BinaryString(rotated_value)\n\n    def to_decimal(self) -> int:\n        if not self._value:\n            return 0\n        return int(self._value, 2)\n\n    def get_value(self) -> str:\n        return self._value\nclass DecimalEquivalent:\n    \"\"\"Encapsulates a decimal integer equivalent, leveraging the Integer class.\"\"\"\n    def __init__(self, decimal_value: int):\n        self._value = Integer(decimal_value)\n    def is_odd(self) -> bool:\n        return self._value.is_odd()\n    def get_value(self) -> int:\n        return self._value.get_value()\nclass OddCount:\n    \"\"\"Manages the cumulative count of odd decimal equivalents.\"\"\"\n    def __init__(self):\n        self._value = 0\n    def increment(self) -> None:\n        self._value += 1\n    def get_value(self) -> int:\n        return self._value\ndef odd_Equivalent(binary_string: str, num_rotations: int) -> int:\n    \"\"\"\n    Calculates the number of odd decimal equivalents when a binary string is cyclically rotated\n    a specified number of times.\n    \"\"\"\n    validate_binary_string(binary_string)\n    validate_non_negative_integer(num_rotations)\n\n    odd_count_obj = OddCount()\n    initial_binary_string_obj = BinaryString(binary_string)\n    rotation_count_obj = RotationCount(num_rotations)\n\n    for i in range(rotation_count_obj.get_count()):\n        current_rotated_string_obj = initial_binary_string_obj.rotate(i)\n        decimal_value = current_rotated_string_obj.to_decimal()\n        decimal_equivalent_obj = DecimalEquivalent(decimal_value)\n\n        if decimal_equivalent_obj.is_odd():\n            odd_count_obj.increment()\n\n    return odd_count_obj.get_value()"}
{"task_id": "Mbpp/124", "solution": "import math\nclass ComplexNumber:\n    \"\"\"Represents a complex number and calculates its angle.\"\"\"\n    def __init__(self, real_part: float, imaginary_part: float):\n        self._real_part = real_part\n        self._imaginary_part = imaginary_part\n\n    @property\n    def real_part(self) -> float:\n        return self._real_part\n\n    @property\n    def imaginary_part(self) -> float:\n        return self._imaginary_part\n\n    def get_angle(self) -> float:\n        \"\"\"Computes and returns the argument (angle) of the complex number in radians.\"\"\"\n        return math.atan2(self._imaginary_part, self._real_part)\ndef angle_complex(real_part: float, imaginary_part: float) -> float:\n    \"\"\"\n    Calculates the angle (argument) of a complex number in radians.\n    It takes the real and imaginary parts and returns the angle.\n    \"\"\"\n    complex_num = ComplexNumber(real_part, imaginary_part)\n    return complex_num.get_angle()"}
{"task_id": "Mbpp/120", "solution": "def max_product_tuple(input_list: list[tuple[int, int]]) -> int:\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples\n    within a given list.\n    \"\"\"\n    if not input_list:\n        return 0\n\n    max_abs_product = 0\n\n    for tpl in input_list:\n        product = tpl[0] * tpl[1]\n        absolute_product = abs(product)\n        if absolute_product > max_abs_product:\n            max_abs_product = absolute_product\n\n    return max_abs_product"}
{"task_id": "Mbpp/123", "solution": "def amicable_numbers_sum(limit: int) -> int:\n    \"\"\"Calculates the sum of all unique amicable numbers up to the specified limit.\"\"\"\n\n    def _calculate_proper_divisor_sum(n: int) -> int:\n        \"\"\"Computes the sum of all positive divisors of 'n' excluding 'n' itself.\"\"\"\n        if n <= 1:\n            return 0\n        s = 1  # 1 is always a proper divisor\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                s += i\n                if i * i != n:\n                    s += n // i\n        return s\n\n    def _is_amicable_pair(a: int, b: int, proper_divisor_sums: dict) -> bool:\n        \"\"\"Determines if 'a' and 'b' form an amicable pair based on their proper divisor sums.\"\"\"\n        return a != b and proper_divisor_sums.get(a) == b and proper_divisor_sums.get(b) == a\n\n    proper_divisor_sums_cache = {}\n    amicable_numbers_set = set()\n\n    for n in range(1, limit + 1):\n        sum_divisors_n = _calculate_proper_divisor_sum(n)\n        proper_divisor_sums_cache[n] = sum_divisors_n\n\n        m = sum_divisors_n\n        if 1 <= m <= limit and m != n:\n            if m in proper_divisor_sums_cache:\n                if _is_amicable_pair(n, m, proper_divisor_sums_cache):\n                    amicable_numbers_set.add(n)\n                    amicable_numbers_set.add(m)\n\n    return sum(amicable_numbers_set)"}
