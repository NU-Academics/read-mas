{"task_id": "Mbpp/572", "solution": "from collections import Counter\ndef two_unique_nums(input_list: list) -> list:\n    \"\"\"\n    Identifies and returns numbers that occur exactly once in the input list,\n    preserving their original order of first appearance.\n    \"\"\"\n    counts = Counter(input_list)\n    unique_ordered_list = []\n    for number in input_list:\n        if counts[number] == 1:\n            unique_ordered_list.append(number)\n    return unique_ordered_list"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(main_list: list, sub_list: list) -> bool:\n    \"\"\"\n    Checks if sub_list is a contiguous sublist of main_list.\n    Handles edge cases for empty lists and sublists longer than the main list.\n    \"\"\"\n    if not sub_list:\n        return True\n    if len(sub_list) > len(main_list):\n        return False\n    if not main_list and sub_list:\n        return False\n\n    n = len(main_list)\n    m = len(sub_list)\n\n    for i in range(n - m + 1):\n        if main_list[i:i+m] == sub_list:\n            return True\n    return False"}
{"task_id": "Mbpp/573", "solution": "import collections\ndef unique_product(numbers: list) -> int:\n    \"\"\"Calculates the product of unique numbers in a given list.\n    Returns 1 if no unique numbers are found or the list is empty.\"\"\"\n    counts = collections.Counter(numbers)\n    product = 1\n    for num, count in counts.items():\n        if count == 1:\n            product *= num\n    return product"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(number: int) -> int:\n    \"\"\"Calculates the last digit of a non-negative integer's factorial. Returns this last digit (0-9).\"\"\"\n    if number == 0:\n        return 1\n\n    factorial_value = 1\n    for i in range(1, number + 1):\n        factorial_value *= i\n\n    return factorial_value % 10"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple: tuple) -> tuple:\n    # Recursively filters odd integer elements from a nested tuple, preserving structure.\n    # Empty nested tuples resulting from filtering are represented as ().\n    result = []\n    for item in input_tuple:\n        if isinstance(item, tuple):\n            processed_nested = extract_even(item)\n            if processed_nested:  # Only add if the nested tuple is not empty after processing\n                result.append(processed_nested)\n        elif isinstance(item, int) and item % 2 == 0:\n            result.append(item)\n    return tuple(result)"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Finds elements that are present in one of the two input tuples but not in the other.\n    The elements in the returned tuple will be sorted for consistent output order.\n    \"\"\"\n    set1 = set(tuple1)\n    set2 = set(tuple2)\n    dissimilar_elements = (set1 - set2) | (set2 - set1)\n    return tuple(sorted(list(dissimilar_elements)))"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(list1: list, list2: list, list3: list) -> list:\n    \"\"\"Interleaves three lists of the same length into a single flat list.\n    Elements are appended as list1[i], list2[i], list3[i] for each index i.\n    \"\"\"\n    result_list = []\n    # All lists are assumed to have the same length\n    list_length = len(list1)\n\n    for i in range(list_length):\n        result_list.append(list1[i])\n        result_list.append(list2[i])\n        result_list.append(list3[i])\n\n    return result_list"}
