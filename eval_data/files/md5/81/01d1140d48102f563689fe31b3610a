{"task_id": "Mbpp/794", "solution": "class Pattern:\n    \"\"\"Encapsulates the specific pattern rules for matching.\"\"\"\n    def __init__(self, start_char: str = 'a', end_char: str = 'b'):\n        self._start_char = start_char\n        self._end_char = end_char\n\n    def get_start_char(self) -> str:\n        \"\"\"Returns the starting character of the pattern.\"\"\"\n        return self._start_char\n\n    def get_end_char(self) -> str:\n        \"\"\"Returns the ending character of the pattern.\"\"\"\n        return self._end_char\nclass Matcher:\n    \"\"\"Applies a given pattern to an input string to determine if it matches.\"\"\"\n    def match(self, input_string: str, pattern: Pattern) -> bool:\n        \"\"\"Checks if the input_string matches the pattern.\"\"\"\n        if len(input_string) < 2:\n            return False\n        \n        starts_with_a = input_string[0] == pattern.get_start_char()\n        ends_with_b = input_string[-1] == pattern.get_end_char()\n        \n        return starts_with_a and ends_with_b\ndef text_starta_endb(input_string: str) -> bool:\n    \"\"\"\n    Public entry point to match a string against the predefined 'a...b' pattern.\n    Returns True if input_string starts with 'a' and ends with 'b', False otherwise.\n    \"\"\"\n    pattern = Pattern(start_char='a', end_char='b')\n    matcher = Matcher()\n    return matcher.match(input_string, pattern)"}
{"task_id": "Mbpp/797", "solution": "def sum_in_range(l: int, r: int) -> int:\n    \"\"\"\n    Calculates the sum of all odd natural numbers within the inclusive range [l, r].\n    Returns 0 if l > r or if no odd natural numbers are found.\n    \"\"\"\n    if l > r:\n        return 0\n\n    total_sum = 0\n    # Natural numbers start from 1. Ensure the lower bound is at least 1.\n    start = max(1, l)\n\n    for num in range(start, r + 1):\n        if num % 2 != 0:  # Check if the number is odd\n            total_sum += num\n\n    return total_sum"}
{"task_id": "Mbpp/793", "solution": "def last(arr: list, target: any) -> int:\n    \"\"\"\n    Finds the last position of an element in a sorted array using binary search.\n    Returns the 0-based index or -1 if the element is not found.\n    \"\"\"\n    low = 0\n    high = len(arr) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if arr[mid] == target:\n            result = mid\n            low = mid + 1  # Try to find further occurrences to the right\n        elif arr[mid] < target:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return result"}
