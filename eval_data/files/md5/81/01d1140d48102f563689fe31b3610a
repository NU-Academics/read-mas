{"task_id": "Mbpp/256", "solution": "def _is_prime(num: int) -> bool:\n    \"\"\"\n    Checks if a given integer is a prime number.\n    Handles base cases and iterates up to the square root of num.\n    \"\"\"\n    if num <= 1:\n        return False\n    if num == 2:\n        return True\n    if num % 2 == 0:\n        return False\n    i = 3\n    while i * i <= num:\n        if num % i == 0:\n            return False\n        i += 2\n    return True\ndef count_Primes_nums(number: int) -> int:\n    \"\"\"\n    Counts the number of prime numbers strictly less than the given non-negative number.\n    Iterates from 2 up to number - 1 and uses a helper function to check primality.\n    \"\"\"\n    count = 0\n    # No need to validate non-negative, as per design context instruction \"DO NOT add isinstance() checks or raise exceptions for edge cases\"\n    # Although the problem description states \"non-negative number\", the iteration range handles number < 2 naturally.\n    for i in range(2, number):\n        if _is_prime(i):\n            count += 1\n    return count"}
{"task_id": "Mbpp/259", "solution": "def maximize_elements(tuple1: tuple[tuple[int, int], ...], tuple2: tuple[tuple[int, int], ...]) -> tuple[tuple[int, int], ...]:\n    \"\"\"\n    Maximizes elements of two input tuples of tuples element-wise.\n    Raises ValueError if input tuples have different lengths or inner tuples do not contain exactly two elements.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Input tuples must have the same number of inner tuples.\")\n\n    result = []\n    for i in range(len(tuple1)):\n        inner_tuple1 = tuple1[i]\n        inner_tuple2 = tuple2[i]\n\n        if len(inner_tuple1) != 2 or len(inner_tuple2) != 2:\n            raise ValueError(\"Each inner tuple must contain exactly two elements.\")\n\n        max_x = max(inner_tuple1[0], inner_tuple2[0])\n        max_y = max(inner_tuple1[1], inner_tuple2[1])\n        result.append((max_x, max_y))\n\n    return tuple(result)"}
