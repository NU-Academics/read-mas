{"task_id": "Mbpp/751", "solution": "from typing import List, Union\ndef check_min_heap(arr: List[Union[int, float]]) -> bool:\n    \"\"\"Checks if the given array represents a min-heap.\"\"\"\n    n = len(arr)\n\n    # An empty array or an array with a single element is considered a valid min-heap.\n    if n <= 1:\n        return True\n\n    # Iterate only through parent nodes.\n    # For a 0-indexed array, parent nodes are from index 0 up to (n/2) - 1.\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child if it exists and violates the min-heap property.\n        if left_child_idx < n and arr[i] > arr[left_child_idx]:\n            return False\n\n        # Check right child if it exists and violates the min-heap property.\n        if right_child_idx < n and arr[i] > arr[right_child_idx]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/745", "solution": "def divisible_by_digits(startnum: int, endnum: int) -> list[int]:\n    \"\"\"\n    Finds numbers within a given range that are divisible by every non-zero digit they contain.\n    Helper functions are defined internally for digit extraction and validation.\n    \"\"\"\n\n    def _get_non_zero_digits(number: int) -> list[int]:\n        \"\"\"Extracts unique non-zero digits from a given number.\"\"\"\n        digits = []\n        if number == 0:\n            return [] # 0 has no non-zero digits, and cannot be divided by any digit anyway\n        \n        temp_num = abs(number) # Handle negative numbers by using their absolute value for digit extraction\n        while temp_num > 0:\n            digit = temp_num % 10\n            if digit != 0 and digit not in digits:\n                digits.append(digit)\n            temp_num //= 10\n        return digits\n\n    def _is_divisible_by_all_digits(number: int) -> bool:\n        \"\"\"Checks if a single number is divisible by all its non-zero constituent digits.\"\"\"\n        non_zero_digits = _get_non_zero_digits(number)\n        \n        # If the number is 0 or contains no non-zero digits (e.g., 0, or if all digits were 0), \n        # it is trivially true by this definition, as there are no digits to divide by.\n        # However, per the problem statement, numbers like 0 are usually excluded or handled specifically.\n        # Given the example (1,22) and result, 0 is not expected.\n        if not non_zero_digits: # Handles single-digit 0 or numbers with only 0s, e.g., 10, 20\n            # For a number like 10, non_zero_digits would be [1]. For 20, [2].\n            # For 0 itself, _get_non_zero_digits returns [].\n            # The prompt example divisible_by_digits(1,22) doesn't include 0, so we assume 0 is not a target.\n            # If a number has no non-zero digits, it cannot satisfy \"divisible by every digit it contains\".\n            # This check ensures that numbers like 0 or single-digit numbers which are 0 are excluded from this condition,\n            # unless 0 is explicitly meant to be divisible by its \"empty set\" of non-zero digits.\n            # Based on the example, we should return False if there are no digits to divide by for numbers like 0.\n            if number == 0:\n                return False\n            else: # This case would only apply if _get_non_zero_digits somehow returned empty for a non-zero number, which it shouldn't.\n                return True # If a number (like 100) only has 1s (implicitly handled by loop)\n            \n\n        for digit in non_zero_digits:\n            if number % digit != 0:\n                return False\n        return True\n\n    result_list = []\n    for num in range(startnum, endnum + 1):\n        if _is_divisible_by_all_digits(num):\n            result_list.append(num)\n    return result_list"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Calculates the nth Jacobsthal number using an iterative approach.\n    J(0) = 0, J(1) = 1, and J(n) = J(n-1) + 2 * J(n-2) for n > 1.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n    elif n == 0:\n        return 0\n    elif n == 1:\n        return 1\n    else:\n        a, b = 0, 1  # J(0), J(1)\n        for _ in range(2, n + 1):\n            a, b = b, a * 2 + b\n        return b"}
{"task_id": "Mbpp/748", "solution": "def is_uppercase(char: str) -> bool:\n    \"\"\"Checks if a character is an uppercase letter.\"\"\"\n    return char.isupper()\ndef is_lowercase(char: str) -> bool:\n    \"\"\"Checks if a character is a lowercase letter.\"\"\"\n    return char.islower()\nclass StringProcessor:\n    \"\"\"Encapsulates the logic for processing strings to add spaces before capital letters.\"\"\"\n\n    def process(self, input_string: str) -> str:\n        \"\"\"\n        Inserts spaces before uppercase letters in the input string under specific conditions.\n        A space is inserted if the uppercase letter is not the first character\n        and is preceded by a lowercase letter.\n        \"\"\"\n        if not input_string:\n            return \"\"\n\n        result_chars = [input_string[0]]\n\n        for i in range(1, len(input_string)):\n            current_char = input_string[i]\n            previous_char = input_string[i-1]\n\n            if is_uppercase(current_char) and is_lowercase(previous_char):\n                result_chars.append(' ')\n            result_chars.append(current_char)\n\n        return \"\".join(result_chars)\ndef capital_words_spaces(input_string: str) -> str:\n    \"\"\"\n    Puts spaces between words starting with capital letters in a given string,\n    inserting a space if an uppercase letter is preceded by a lowercase letter.\n    \"\"\"\n    processor = StringProcessor()\n    return processor.process(input_string)"}
{"task_id": "Mbpp/753", "solution": "def min_k(tuple_list: list[tuple[str, int]], k: int) -> list[tuple[str, int]]:\n    \"\"\"\n    Sorts a list of (string, int) tuples by their integer values and returns the first k elements.\n    \"\"\"\n    sorted_list = sorted(tuple_list, key=lambda x: x[1])\n    return sorted_list[:k]"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(list1: list, list2: list, list3: list) -> list:\n    \"\"\"Finds elements common to all three lists at the same index.\n    Returns a new list containing these common elements.\"\"\"\n    common_elements_list = []\n    min_length = min(len(list1), len(list2), len(list3))\n\n    for i in range(min_length):\n        element1 = list1[i]\n        element2 = list2[i]\n        element3 = list3[i]\n\n        if element1 == element2 and element2 == element3:\n            common_elements_list.append(element1)\n\n    return common_elements_list"}
{"task_id": "Mbpp/757", "solution": "from typing import List\ndef _reverse_string(s: str) -> str:\n    \"\"\"Reverses a given string.\"\"\"\n    return s[::-1]\ndef count_reverse_pairs(string_list: List[str]) -> int:\n    \"\"\"\n    Counts unique pairs of strings where one is the reverse of the other.\n    Each pair is counted once, regardless of order or duplicates in the input list.\n    \"\"\"\n    found_pairs = set()\n    processed_strings = set()\n    string_set_for_lookup = set(string_list)\n\n    for current_string in string_list:\n        if current_string in processed_strings:\n            continue\n\n        reversed_string = _reverse_string(current_string)\n        \n        # Mark the current string as processed to avoid re-evaluating it as a primary string.\n        processed_strings.add(current_string)\n\n        # If the reversed string exists in the original list and it's not the same string,\n        # then we have found a valid pair.\n        if reversed_string in string_set_for_lookup and current_string != reversed_string:\n            # Create a canonical representation (sorted tuple) for the pair to ensure uniqueness in the set.\n            canonical_pair = tuple(sorted((current_string, reversed_string)))\n            found_pairs.add(canonical_pair)\n\n    return len(found_pairs)"}
{"task_id": "Mbpp/759", "solution": "import re\ndef is_decimal(s):\n    \"\"\"Checks if the input string is a decimal number with a precision of 2.\"\"\"\n    pattern = re.compile(r\"^[+-]?\\d+\\.\\d{2}$\")\n    return bool(pattern.fullmatch(s))"}
