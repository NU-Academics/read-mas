{"task_id": "Mbpp/633", "solution": "from typing import List\ndef pair_xor_Sum(numbers: List[int], length: int) -> int:\n    \"\"\"\n    Calculates the sum of XOR of all unique pairs of numbers in the given list.\n\n    Args:\n        numbers: A list of integers.\n        length: The number of elements in the 'numbers' list.\n\n    Returns:\n        The total sum of XOR values for all unique pairs.\n    \"\"\"\n    total_xor_sum = 0\n    for i in range(length):\n        for j in range(i + 1, length):\n            total_xor_sum += (numbers[i] ^ numbers[j])\n    return total_xor_sum"}
{"task_id": "Mbpp/638", "solution": "def wind_chill(wind_velocity_kmh: float, temperature_celsius: float) -> int:\n    \"\"\"\n    Calculates the wind chill index given wind velocity in km/h and temperature in Celsius.\n    The result is rounded to the nearest integer to match the provided assert example.\n    \"\"\"\n    # Standard formula for wind chill index (T in Celsius, V in km/h).\n    # This formula is generally valid for T <= 10 C, but is applied as per problem context.\n    \n    # Calculate the term V^0.16\n    wind_velocity_exponent_term = wind_velocity_kmh ** 0.16\n    \n    # Calculate the raw wind chill index\n    raw_wind_chill = (\n        13.12\n        + 0.6215 * temperature_celsius\n        - 11.37 * wind_velocity_exponent_term\n        + 0.3965 * temperature_celsius * wind_velocity_exponent_term\n    )\n    \n    # Round the raw index to the nearest integer to satisfy the given assert example.\n    # The assert wind_chill(120,35)==40 implies rounding to the nearest integer for a raw value of ~40.296.\n    rounded_wind_chill = round(raw_wind_chill)\n    \n    return int(rounded_wind_chill)"}
{"task_id": "Mbpp/639", "solution": "class Name:\n    \"\"\"Represents a single name and encapsulates its value and validation logic.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n\n    @property\n    def value(self) -> str:\n        \"\"\"Returns the name string.\"\"\"\n        return self._value\n\n    @property\n    def length(self) -> int:\n        \"\"\"Returns the length of the name string.\"\"\"\n        return len(self._value)\n\n    def is_starting_with_lowercase(self) -> bool:\n        \"\"\"Checks if the name starts with a lowercase letter.\"\"\"\n        return self._value and self._value[0].islower()\nclass NameList:\n    \"\"\"Manages a collection of Name objects, providing filtering and aggregation capabilities.\"\"\"\n    def __init__(self):\n        self._names: list[Name] = []\n\n    def add_name(self, name_value: str):\n        \"\"\"Creates and adds a new Name object to the internal list.\"\"\"\n        self._names.append(Name(name_value))\n\n    def get_filtered_names(self) -> list[Name]:\n        \"\"\"Returns a new list containing only Name objects that do not start with a lowercase letter.\"\"\"\n        return [name for name in self._names if not name.is_starting_with_lowercase()]\n\n    def calculate_total_length_sum(self) -> int:\n        \"\"\"Calculates the sum of lengths of all Name objects currently in the internal list.\"\"\"\n        return sum(name.length for name in self._names)\ndef sample_nam(input_names: list[str]) -> int:\n    \"\"\"\n    Sums the length of names after removing names that start with a lowercase letter.\n    \"\"\"\n    all_names_list = NameList()\n    for name_str in input_names:\n        all_names_list.add_name(name_str)\n\n    filtered_name_objects = all_names_list.get_filtered_names()\n\n    filtered_names_list_for_sum = NameList()\n    for name_obj in filtered_name_objects:\n        filtered_names_list_for_sum.add_name(name_obj.value)\n\n    total_sum = filtered_names_list_for_sum.calculate_total_length_sum()\n\n    return total_sum"}
{"task_id": "Mbpp/643", "solution": "def text_match_wordz_middle(input_string: str) -> bool:\n    \"\"\"\n    Checks if a string contains 'z' anywhere except at its very start or very end.\n    A 'middle' section is considered only for strings with a length greater than 2.\n    \"\"\"\n    if len(input_string) <= 2:\n        return False\n\n    # Iterate through the string from the second character (index 1)\n    # up to, but not including, the last character (index len(input_string) - 1).\n    for i in range(1, len(input_string) - 1):\n        if input_string[i] == 'z':\n            return True\n            \n    return False"}
{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(array: list, K: int) -> list:\n    \"\"\"\n    Reverses an array in-place up to a given K-th position (1-based index).\n    Raises ValueError for invalid K values.\n    \"\"\"\n    if K <= 0:\n        raise ValueError(\"K must be a positive integer.\")\n    if K > len(array):\n        raise ValueError(\"K cannot exceed the length of the array.\")\n\n    start = 0\n    end = K - 1\n\n    while start < end:\n        array[start], array[end] = array[end], array[start]\n        start += 1\n        end -= 1\n    \n    return array"}
