{"task_id": "Mbpp/583", "solution": "def catalan_number(n: int) -> int:\n    \"\"\"Calculates the nth Catalan number.\"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n    if n == 0:\n        return 1\n\n    # Using dynamic programming: C_n = sum(C_i * C_{n-1-i} for i in range(n))\n    dp = [0] * (n + 1)\n    dp[0] = 1\n\n    for i in range(1, n + 1):\n        for j in range(i):\n            dp[i] += dp[j] * dp[i - 1 - j]\n\n    return dp[n]"}
{"task_id": "Mbpp/585", "solution": "def expensive_items(items: list[dict], n: int) -> list[dict]:\n    \"\"\"\n    Finds the n most expensive items in a given dataset.\n    Handles edge cases like empty input or n being zero/too large.\n    \"\"\"\n    if n <= 0 or not items:\n        return []\n\n    # Sort items by 'price' in descending order\n    sorted_items = sorted(items, key=lambda x: x['price'], reverse=True)\n\n    # Return the top 'n' items, or all items if n is greater than the total number of items\n    return sorted_items[:n]"}
{"task_id": "Mbpp/588", "solution": "def big_diff(list_of_numbers: list) -> (int | float):\n    \"\"\"Calculates the difference between the largest and smallest values in a list.\n\n    Raises a ValueError if the input list is empty.\"\"\"\n    if not list_of_numbers:\n        raise ValueError(\"Input list cannot be empty.\")\n    largest = max(list_of_numbers)\n    smallest = min(list_of_numbers)\n    return largest - smallest"}
{"task_id": "Mbpp/581", "solution": "import math\ndef surface_Area(base_edge: float, height: float) -> float:\n    \"\"\"\n    Calculates the surface area of a square pyramid.\n    Uses the formula A = a^2 + 2a * sqrt((a/2)^2 + h^2).\n    \"\"\"\n    slant_height = math.sqrt((base_edge / 2)**2 + height**2)\n    base_area = base_edge**2\n    lateral_area = 2 * base_edge * slant_height\n    total_surface_area = base_area + lateral_area\n    return total_surface_area"}
