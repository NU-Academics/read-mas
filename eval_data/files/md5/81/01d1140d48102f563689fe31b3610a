{"task_id": "Mbpp/287", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of squares of the first n even natural numbers.\n    Returns 0 if n is 0 or negative.\n    \"\"\"\n    if n < 0:\n        return 0\n\n    total_sum = 0\n    for i in range(1, n + 1):\n        even_number = 2 * i\n        total_sum += even_number ** 2\n    return total_sum"}
{"task_id": "Mbpp/290", "solution": "def max_length(list_of_lists: list) -> tuple[int, list]:\n    \"\"\"\n    Finds the list of maximum length in a list of lists.\n    Returns a tuple containing the maximum length and the first inner list\n    that possesses this maximum length.\n    \"\"\"\n    max_len = 0\n    max_list_found = []\n\n    for inner_list in list_of_lists:\n        current_len = len(inner_list)\n        if current_len > max_len:\n            max_len = current_len\n            max_list_found = inner_list\n\n    return (max_len, max_list_found)"}
{"task_id": "Mbpp/296", "solution": "def get_Inv_Count(arr: list) -> int:\n    \"\"\"\n    Counts inversions in an array where i < j and arr[i] > arr[j].\n    \"\"\"\n    n = len(arr)\n    inversion_count = 0\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            if arr[i] > arr[j]:\n                inversion_count += 1\n    return inversion_count"}
{"task_id": "Mbpp/292", "solution": "from typing import Union\ndef find(dividend: Union[int, float], divisor: Union[int, float]) -> int:\n    \"\"\"\n    Calculates the quotient of two numbers, rounded down to the nearest integer.\n    Raises ZeroDivisionError if the divisor is zero.\n    \"\"\"\n    if divisor == 0:\n        raise ZeroDivisionError(\"Divisor cannot be zero.\")\n    \n    return int(dividend // divisor)"}
{"task_id": "Mbpp/293", "solution": "import math\ndef otherside_rightangle(leg1, leg2):\n    \"\"\"\n    Calculates the hypotenuse of a right-angled triangle given the lengths of its two legs.\n    Applies the Pythagorean theorem using floating-point arithmetic for precision.\n    \"\"\"\n    hypotenuse_squared = leg1**2 + leg2**2\n    return math.sqrt(hypotenuse_squared)"}
{"task_id": "Mbpp/300", "solution": "import math\ndef count_binary_seq(n: int) -> float:\n    \"\"\"\n    Calculates the count of all binary sequences of length 2n such that\n    the sum of the first n bits is the same as the sum of the last n bits.\n    This uses the combinatorial identity Sum_{k=0 to n} (C(n, k))^2 = C(2n, n).\n    \"\"\"\n    return float(math.comb(2 * n, n))"}
{"task_id": "Mbpp/294", "solution": "def max_val(input_list: list) -> Union[int, float, None]:\n    \"\"\"\n    Finds the maximum numeric value in a heterogeneous list.\n    Disregards non-numeric elements and returns None if no numeric values are found.\n    \"\"\"\n    max_numeric_value = None\n    for element in input_list:\n        if isinstance(element, (int, float)):\n            if max_numeric_value is None or element > max_numeric_value:\n                max_numeric_value = element\n    return max_numeric_value"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(nested_list: list) -> list:\n    \"\"\"\n    Recursively flattens a nested list into a single-dimensional list.\n    Elements maintain their original order during the flattening process.\n    \"\"\"\n    flattened_result = []\n    for element in nested_list:\n        if isinstance(element, list):\n            flattened_result.extend(flatten_list(element))\n        else:\n            flattened_result.append(element)\n    return flattened_result"}
{"task_id": "Mbpp/299", "solution": "def max_aggregate(scores: list[tuple[str, int]]) -> tuple[str, int]:\n    \"\"\"\n    Calculates the maximum aggregate score from a list of named scores.\n    Returns ('', 0) if the input list is empty.\n    \"\"\"\n    if not scores:\n        return ('', 0)\n\n    aggregated_scores = {}\n    for name, score in scores:\n        aggregated_scores[name] = aggregated_scores.get(name, 0) + score\n\n    max_name = ''\n    max_score = 0\n\n    # Find the maximum aggregate score\n    # Note: If multiple names have the same max score, the first one encountered in\n    # the dictionary iteration will be returned. The problem statement does not specify\n    # tie-breaking, so this behavior is acceptable.\n    for name, total_score in aggregated_scores.items():\n        if total_score > max_score:\n            max_score = total_score\n            max_name = name\n\n    return (max_name, max_score)"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(dictionary_input: dict) -> int:\n    \"\"\"\n    Calculates the maximum nesting depth of a given dictionary.\n\n    Args:\n        dictionary_input: The dictionary to calculate the depth for.\n    \"\"\"\n    max_depth = 1\n    for key, value in dictionary_input.items():\n        if isinstance(value, dict):\n            max_depth = max(max_depth, 1 + dict_depth(value))\n    return max_depth"}
{"task_id": "Mbpp/305", "solution": "def _extract_words_from_string(text: str) -> list[str]:\n    \"\"\"\n    Splits a string into words using whitespace as a delimiter.\n    \"\"\"\n    return text.split()\ndef _starts_with_p(word: str) -> bool:\n    \"\"\"\n    Checks if a word starts with 'p' or 'P' (case-insensitive).\n    \"\"\"\n    return word.lower().startswith('p')\ndef start_withp(input_strings: list[str]) -> tuple[str, str]:\n    \"\"\"\n    Extracts the first two words starting with 'p' or 'P' from a list of strings.\n    \"\"\"\n    p_words = []\n    for s in input_strings:\n        words = _extract_words_from_string(s)\n        for word in words:\n            if _starts_with_p(word):\n                p_words.append(word)\n                if len(p_words) == 2:\n                    return (p_words[0], p_words[1])\n    return (p_words[0], p_words[1]) # This line assumes there will always be at least two words, based on the example."}
