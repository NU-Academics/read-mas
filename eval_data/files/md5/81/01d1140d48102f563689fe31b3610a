{"task_id": "Mbpp/392", "solution": "_memo = {}\ndef get_max_sum(n: int) -> int:\n    \"\"\"\n    Calculates the maximum sum f(n) using the given recursive formula with memoization.\n    f(n) = max( (f(n/2) + f(n/3) + f(n/4) + f(n/5)), n)\n    \"\"\"\n    if n in _memo:\n        return _memo[n]\n\n    if n <= 0:\n        return n\n\n    sum_of_parts = get_max_sum(n // 2) + get_max_sum(n // 3) + \\\n                   get_max_sum(n // 4) + get_max_sum(n // 5)\n    \n    result = max(sum_of_parts, n)\n    _memo[n] = result\n    return result"}
{"task_id": "Mbpp/398", "solution": "import math\nfrom typing import List\ndef sum_of_digits(numbers: List[int]) -> int:\n    \"\"\"\n    Computes the total sum of digits for each number in a given list.\n    Example: sum_of_digits([10, 2, 56]) == 14\n    \"\"\"\n    def _calculate_sum_of_digits_for_single_number(number: int) -> int:\n        \"\"\"Calculates the sum of digits for a single non-negative integer.\n        Handles negative numbers by taking their absolute value.\"\"\"\n        number = abs(number) # Handle negative numbers as per design context\n        total = 0\n        if number == 0:\n            return 0\n        while number > 0:\n            total += number % 10\n            number //= 10\n        return total\n\n    total_sum_for_list = 0\n    for num in numbers:\n        total_sum_for_list += _calculate_sum_of_digits_for_single_number(num)\n    return total_sum_for_list"}
