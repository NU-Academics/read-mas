{"task_id": "Mbpp/165", "solution": "def count_char_position(input_string: str) -> int:\n    \"\"\"\n    Counts characters in an input string whose 0-indexed position matches\n    their 0-indexed position in the English alphabet (case-insensitive).\n    \"\"\"\n    match_count = 0\n    for char_index, char_value in enumerate(input_string):\n        if 'a' <= char_value.lower() <= 'z':\n            alphabet_index = ord(char_value.lower()) - ord('a')\n            if char_index == alphabet_index:\n                match_count += 1\n    return match_count"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Calculates the smallest power of 2 greater than or equal to n.\n    Handles the edge case where n is 0, returning 1.\n    \"\"\"\n    if n == 0:\n        return 1\n    \n    power = 1\n    while power < n:\n        power *= 2\n    return power"}
{"task_id": "Mbpp/166", "solution": "from typing import List\nclass Integer:\n    \"\"\"Encapsulates an integer value and provides methods to determine its parity.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def get_value(self) -> int:\n        \"\"\"Returns the integer's numerical value.\"\"\"\n        return self._value\n\n    def is_even(self) -> bool:\n        \"\"\"Returns True if the integer is even, False otherwise.\"\"\"\n        return self._value % 2 == 0\n\n    def is_odd(self) -> bool:\n        \"\"\"Returns True if the integer is odd, False otherwise.\"\"\"\n        return self._value % 2 != 0\nclass Pair:\n    \"\"\"Represents a pair of Integer objects and provides methods to compute their bitwise XOR and determine its parity.\"\"\"\n    def __init__(self, integer1: Integer, integer2: Integer):\n        self._integer1 = integer1\n        self._integer2 = integer2\n\n    def get_integer1(self) -> Integer:\n        \"\"\"Returns the first Integer object.\"\"\"\n        return self._integer1\n\n    def get_integer2(self) -> Integer:\n        \"\"\"Returns the second Integer object.\"\"\"\n        return self._integer2\n\n    def compute_xor(self) -> int:\n        \"\"\"Computes and returns the bitwise XOR of the values of _integer1 and _integer2.\"\"\"\n        return self._integer1.get_value() ^ self._integer2.get_value()\n\n    def is_xor_even(self) -> bool:\n        \"\"\"Determines if the XOR result of the pair's integers is an even number.\"\"\"\n        # XOR is even if both integers have the same parity.\n        return self._integer1.is_even() == self._integer2.is_even()\nclass IntegerList:\n    \"\"\"Manages a collection of Integer objects and generates all distinct, unordered pairs from them.\"\"\"\n    def __init__(self, values: List[int]):\n        self._integers = [Integer(val) for val in values]\n\n    def get_integers(self) -> List[Integer]:\n        \"\"\"Returns the internal list of Integer objects.\"\"\"\n        return self._integers\n\n    def get_pairs(self) -> List[Pair]:\n        \"\"\"Generates and returns a list of all distinct Pair objects from the _integers.\"\"\"\n        pairs = []\n        n = len(self._integers)\n        for i in range(n):\n            for j in range(i + 1, n):\n                pairs.append(Pair(self._integers[i], self._integers[j]))\n        return pairs\nclass PairCounter:\n    \"\"\"Orchestrates the process of counting pairs with an even XOR sum within an IntegerList.\"\"\"\n    def count_even_xor_pairs(self, integer_list: IntegerList) -> int:\n        \"\"\"Iterates through pairs from the integer_list, checks their XOR parity, and returns the total count.\"\"\"\n        count = 0\n        pairs = integer_list.get_pairs()\n        for pair in pairs:\n            if pair.is_xor_even():\n                count += 1\n        return count\ndef find_even_pair(numbers: List[int]) -> int:\n    \"\"\"Counts the number of pairs of integers in a list that xor to an even number.\"\"\"\n    integer_list = IntegerList(numbers)\n    pair_counter = PairCounter()\n    return pair_counter.count_even_xor_pairs(integer_list)"}
