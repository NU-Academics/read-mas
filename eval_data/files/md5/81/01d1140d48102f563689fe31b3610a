{"task_id": "Mbpp/92", "solution": "def _check_alternating_digits(digits_str: str) -> bool:\n    \"\"\"\n    Checks if adjacent digits in a string are not equal.\n    A single digit or empty string trivially satisfies this condition.\n    \"\"\"\n    if len(digits_str) < 2:\n        return True\n    for i in range(len(digits_str) - 1):\n        if digits_str[i] == digits_str[i+1]:\n            return False\n    return True\ndef _check_repeating_every_other(digits_str: str) -> bool:\n    \"\"\"\n    Checks if digits at i and i+2 are equal in a string.\n    Less than 3 digits trivially satisfies this condition.\n    \"\"\"\n    if len(digits_str) < 3:\n        return True\n    for i in range(len(digits_str) - 2):\n        if digits_str[i] != digits_str[i+2]:\n            return False\n    return True\ndef is_undulating(number: int) -> bool:\n    \"\"\"\n    Checks whether the given number is undulating based on two conditions:\n    adjacent digits are not equal, and digits at i and i+2 are equal.\n    \"\"\"\n    digits_str = str(number)\n\n    if len(digits_str) <= 1:\n        return True\n\n    condition_alternating = _check_alternating_digits(digits_str)\n    if not condition_alternating:\n        return False\n\n    condition_repeating = _check_repeating_every_other(digits_str)\n    if not condition_repeating:\n        return False\n\n    return True"}
{"task_id": "Mbpp/94", "solution": "from typing import Any, List, Tuple\ndef index_minimum(list_of_tuples: List[Tuple[Any, Any]]) -> Any:\n    \"\"\"\n    Given a list of tuples, returns the first value of the tuple\n    with the smallest second value.\n    \"\"\"\n    if not list_of_tuples:\n        return None\n\n    min_second_value = float('inf')\n    result_first_value = None\n\n    for current_tuple in list_of_tuples:\n        current_second_value = current_tuple[1]\n\n        if current_second_value < min_second_value:\n            min_second_value = current_second_value\n            result_first_value = current_tuple[0]\n\n    return result_first_value"}
{"task_id": "Mbpp/95", "solution": "import math\ndef Find_Min_Length(list_of_lists: list[list]) -> int:\n    \"\"\"Finds the length of the smallest list in a list of lists.\n    Returns 0 if the input list of lists is empty.\"\"\"\n    if not list_of_lists:\n        return 0\n\n    min_length = math.inf\n    for sublist in list_of_lists:\n        min_length = min(min_length, len(sublist))\n    \n    return int(min_length)"}
{"task_id": "Mbpp/96", "solution": "def divisor(number: int) -> int:\n    \"\"\"\n    Calculates the number of positive divisors for a given integer.\n\n    Args:\n        number: The integer for which to count divisors.\n\n    Returns:\n        The total count of positive divisors.\n\n    Raises:\n        ValueError: If the input is not a positive integer.\n    \"\"\"\n    if not isinstance(number, int) or number <= 0:\n        raise ValueError(\"Input must be a positive integer.\")\n\n    count = 0\n    for i in range(1, int(number**0.5) + 1):\n        if number % i == 0:\n            if i * i == number:\n                count += 1\n            else:\n                count += 2\n    return count"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(decimal_num: int) -> str:\n    if decimal_num == 0:\n        return '0'\n\n    binary_string = []\n    temp_num = decimal_num\n    while temp_num > 0:\n        binary_string.append(str(temp_num % 2))\n        temp_num //= 2\n\n    return \"\".join(binary_string[::-1])"}
{"task_id": "Mbpp/98", "solution": "import typing\ndef multiply_num(numbers: typing.Iterable[typing.Union[int, float]]) -> float:\n    \"\"\"Multiplies all numbers in an iterable and divides the product by the length.\n    Returns 0.0 for an empty iterable to prevent division by zero.\"\"\"\n    product = 1.0\n    count = 0\n\n    for num in numbers:\n        product *= float(num)\n        count += 1\n\n    if count == 0:\n        return 0.0\n    else:\n        return product / count"}
{"task_id": "Mbpp/97", "solution": "import collections\ndef frequency_lists(list_of_lists):\n    \"\"\"\n    Flattens a list of lists and calculates the frequency of each element.\n    Returns a dictionary mapping elements to their counts.\n    \"\"\"\n    flat_list = []\n    for sublist in list_of_lists:\n        flat_list.extend(sublist)\n\n    frequency_dict = collections.defaultdict(int)\n    for element in flat_list:\n        frequency_dict[element] += 1\n        \n    return frequency_dict"}
{"task_id": "Mbpp/102", "solution": "def snake_to_camel(snake_case_string: str) -> str:\n    \"\"\"Converts a snake_case string to a PascalCase string.\n    Each word separated by an underscore will have its first letter capitalized.\n    \"\"\"\n    words = snake_case_string.split('_')\n    pascal_words = [word.capitalize() for word in words]\n    return \"\".join(pascal_words)"}
{"task_id": "Mbpp/103", "solution": "def _combinations(n: int, k: int) -> int:\n    \"\"\"Helper function to calculate nCk (n choose k).\"\"\"\n    if k < 0 or k > n:\n        return 0\n    if k == 0 or k == n:\n        return 1\n    if k > n // 2:\n        k = n - k\n\n    res = 1\n    for i in range(k):\n        res = res * (n - i) // (i + 1)\n    return res\ndef eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Calculates the Eulerian number a(n, m).\n    Preconditions: n >= 0, m >= 0, m < n.\n    \"\"\"\n    if n == 0:\n        return 1 if m == 0 else 0 # Special case for a(0,0), though m < n constraint makes it unreachable\n\n    if m >= n or m < 0: # These cases should ideally be caught by validation\n        return 0\n\n    result = 0\n    for k in range(m + 1):\n        term = ((-1)**k) * _combinations(n + 1, k) * ((m + 1 - k)**n)\n        result += term\n    return result"}
{"task_id": "Mbpp/101", "solution": "from typing import List, Any\nclass KthElementError(Exception):\n    \"\"\"Base exception for Kth Element Finder errors.\"\"\"\n    pass\nclass InvalidIndexError(KthElementError):\n    \"\"\"Raised when the provided index k is invalid.\"\"\"\n    def __init__(self, message: str, index: int, array_size: int):\n        super().__init__(message)\n        self.index = index\n        self.array_size = array_size\nclass EmptyArrayError(KthElementError):\n    \"\"\"Raised when an attempt is made to find an element in an empty array.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef kth_element(array: List[Any], k: int) -> Any:\n    \"\"\"\n    Finds the k-th element in the given array using 1-based indexing.\n    Raises EmptyArrayError or InvalidIndexError for invalid inputs.\n    \"\"\"\n    if not array:\n        raise EmptyArrayError(\"Cannot find element in an empty array.\")\n\n    array_size = len(array)\n\n    if not (1 <= k <= array_size):\n        raise InvalidIndexError(\n            f\"Index {k} is out of bounds for array of size {array_size}. \"\n            \"Index must be between 1 and {array_size} (inclusive).\",\n            index=k, array_size=array_size\n        )\n\n    zero_based_index = k - 1\n    return array[zero_based_index]"}
{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Computes the next smallest palindrome that is strictly greater than the input integer n.\n    It iterates through integers greater than n and checks if they are palindromes.\n    \"\"\"\n    current_num = n + 1\n    while True:\n        s = str(current_num)\n        if s == s[::-1]:\n            return current_num\n        current_num += 1"}
{"task_id": "Mbpp/104", "solution": "from typing import List\ndef sort_sublists(list_of_lists: List[List[str]]) -> List[List[str]]:\n    \"\"\"\n    Sorts each sublist of strings within a given list of lists lexicographically.\n\n    Args:\n        list_of_lists: A list where each element is itself a list of strings.\n\n    Returns:\n        A new list of lists with the same structure as the input, but with each\n        sublist sorted lexicographically in ascending order.\n    \"\"\"\n    result_list = []\n    for sublist in list_of_lists:\n        # Create a sorted copy of the sublist and append it to the result\n        result_list.append(sorted(sublist))\n    return result_list"}
