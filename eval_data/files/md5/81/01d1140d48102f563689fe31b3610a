{"task_id": "Mbpp/603", "solution": "def get_ludic(n: int) -> list[int]:\n    \"\"\"\n    Calculates and returns all ludic numbers less than or equal to a given integer n.\n    It uses a sieving process similar to the Sieve of Eratosthenes, operating on positions.\n    \"\"\"\n    if n < 1:\n        return []\n\n    ludic_numbers = []\n    # Initialize candidates with numbers from 1 to n\n    candidates = list(range(1, n + 1))\n\n    # The first ludic number is 1. It is handled as a special case,\n    # as its \"sieving\" rule is effectively just to remove itself.\n    if 1 in candidates:\n        ludic_numbers.append(1)\n        candidates.remove(1) \n\n    while candidates:\n        current_ludic = candidates[0] # The next number in the sequence is the next ludic number\n        \n        ludic_numbers.append(current_ludic)\n        candidates.pop(0) # Remove the current ludic number from the candidates list\n\n        next_candidates = []\n        # Sieve elements: keep numbers whose 1-based position in the *current* `candidates` list\n        # is NOT a multiple of `current_ludic`.\n        for i in range(len(candidates)):\n            # `i` is the 0-based index. `i + 1` is the 1-based position.\n            if (i + 1) % current_ludic != 0:\n                next_candidates.append(candidates[i])\n        \n        candidates = next_candidates # Update candidates for the next iteration\n\n    return ludic_numbers"}
{"task_id": "Mbpp/605", "solution": "def prime_num(num: int) -> bool:\n    \"\"\"\n    Determines if the given integer is a prime number.\n    Returns True if the number is prime, False otherwise.\n    \"\"\"\n    if num <= 1:\n        return False\n    if num <= 3:\n        return True\n    if num % 2 == 0 or num % 3 == 0:\n        return False\n    i = 5\n    while i * i <= num:\n        if num % i == 0 or num % (i + 2) == 0:\n            return False\n        i += 6\n    return True"}
{"task_id": "Mbpp/608", "solution": "def bell_Number(n: int) -> int:\n    \"\"\"Calculates the nth Bell number using dynamic programming.\n    It sums Stirling numbers of the second kind S(n, k) for k from 0 to n.\"\"\"\n    if n == 0:\n        return 1\n\n    stirling = [[0 for _ in range(n + 1)] for _ in range(n + 1)]\n\n    stirling[0][0] = 1\n    for i in range(1, n + 1):\n        stirling[i][0] = 0\n        stirling[i][i] = 1\n        for j in range(1, i):\n            stirling[i][j] = stirling[i - 1][j - 1] + j * stirling[i - 1][j]\n\n    bell_n = 0\n    for k in range(n + 1):\n        bell_n += stirling[n][k]\n\n    return bell_n"}
{"task_id": "Mbpp/607", "solution": "import re\nfrom typing import Optional, Tuple\ndef find_literals(target_string: str, regex_pattern: str) -> Optional[Tuple[str, int, int]]:\n    \"\"\"\n    Searches a target string for a regex pattern.\n\n    Returns a tuple (matched_substring, start_index, end_index) if a match is found, otherwise None.\n    \"\"\"\n    match = re.search(regex_pattern, target_string)\n    if match:\n        return (match.group(0), match.start(), match.end())\n    return None"}
{"task_id": "Mbpp/610", "solution": "def remove_kth_element(input_list: list, k: int) -> list:\n    \"\"\"\n    Returns a new list with the k-th (1-indexed) element removed.\n\n    Args:\n        input_list: The original list.\n        k: The 1-indexed position of the element to remove.\n\n    Returns:\n        A new list with the k-th element removed.\n\n    Raises:\n        IndexError: If k is out of bounds (k < 1 or k > len(input_list)).\n    \"\"\"\n    if not (1 <= k <= len(input_list)):\n        raise IndexError(\"k is out of bounds for the list\")\n    return input_list[:k-1] + input_list[k:]"}
{"task_id": "Mbpp/611", "solution": "def max_of_nth(matrix: list[list[int]], n: int) -> int:\n    \"\"\"\n    Calculates the maximum value in the n-th column of the given matrix.\n\n    Raises ValueError if the matrix is empty or n is out of bounds; IndexError for jagged arrays.\n    \"\"\"\n    if not matrix:\n        raise ValueError(\"Empty matrix provided.\")\n    if n < 0:\n        raise ValueError(\"Column index 'n' cannot be negative.\")\n    if not matrix[0] or n >= len(matrix[0]):\n        raise ValueError(\"Column index 'n' is out of bounds for the matrix.\")\n\n    max_value = None\n\n    for row in matrix:\n        if n >= len(row):\n            raise IndexError(f\"Row {matrix.index(row)} is shorter than column index {n}, indicating a jagged array or out of bounds access.\")\n        \n        current_value = row[n]\n        if max_value is None or current_value > max_value:\n            max_value = current_value\n            \n    return max_value"}
{"task_id": "Mbpp/612", "solution": "from typing import List, Any\ndef merge(input_list: List[List[Any]]) -> List[List[Any]]:\n    \"\"\"\n    Transforms a list of two-element sublists into two separate lists.\n    The first sublist contains all first elements, the second all second elements.\n    \"\"\"\n    first_elements = []\n    second_elements = []\n    for sublist in input_list:\n        first_elements.append(sublist[0])\n        second_elements.append(sublist[1])\n    return [first_elements, second_elements]"}
{"task_id": "Mbpp/614", "solution": "import typing\ndef cummulative_sum(tuple_list: typing.List[typing.Tuple[typing.Union[int, float], ...]]) -> typing.Union[int, float]:\n    \"\"\"\n    Calculates the cumulative sum of all numeric values present in the given tuple list.\n    \"\"\"\n    total_sum = 0\n    for tpl in tuple_list:\n        for value in tpl:\n            total_sum += value\n    return total_sum"}
{"task_id": "Mbpp/616", "solution": "def tuple_modulo(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise modulo on two tuples of the same length.\n    Raises ValueError if tuples have different lengths.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Tuples must be of the same length\")\n\n    results = []\n    for a, b in zip(tuple1, tuple2):\n        # The design context specifies error handling for non-numeric types and division by zero.\n        # However, the REQUIREMENTS state: \"DO NOT add isinstance() checks or raise exceptions for edge cases\".\n        # Thus, allowing Python's default behavior for TypeError and ZeroDivisionError is preferred.\n        results.append(a % b)\n    return tuple(results)"}
{"task_id": "Mbpp/615", "solution": "def _calculate_single_average(inner_tuple: tuple[float | int, ...]) -> float:\n    \"\"\"\n    Calculates the average of a single tuple of numbers.\n    Handles empty tuples by returning 0.0 as per BR6 interpretation.\n    \"\"\"\n    if not inner_tuple:\n        return 0.0\n    return sum(inner_tuple) / len(inner_tuple)\ndef average_tuple(input_tuple_of_tuples: tuple[tuple[float | int, ...], ...]) -> list[float]:\n    \"\"\"\n    Calculates the average value for each inner tuple within a given tuple of tuples.\n    Returns 0.0 for an empty inner tuple (as per BR6 interpretation).\n    \"\"\"\n    results_list = []\n    for inner_tuple in input_tuple_of_tuples:\n        average_value = _calculate_single_average(inner_tuple)\n        results_list.append(average_value)\n    return results_list"}
