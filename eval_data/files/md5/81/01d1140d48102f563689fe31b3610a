{"task_id": "Mbpp/237", "solution": "from typing import List, Tuple, Any, Dict\ndef _canonicalize_tuple(input_tuple: Tuple[Any, ...]) -> Tuple[Any, ...]:\n    \"\"\"\n    Sorts the elements within a tuple to create a canonical representation.\n    \"\"\"\n    return tuple(sorted(input_tuple))\ndef check_occurences(input_list: List[Tuple[Any, ...]]) -> Dict[Tuple[Any, ...], int]:\n    \"\"\"\n    Takes a list of tuples, canonicalizes each tuple by sorting its elements,\n    and returns a dictionary mapping each unique canonical tuple to its count.\n    \"\"\"\n    counts_dict: Dict[Tuple[Any, ...], int] = {}\n    for current_tuple in input_list:\n        canonical_form_tuple = _canonicalize_tuple(current_tuple)\n        counts_dict[canonical_form_tuple] = counts_dict.get(canonical_form_tuple, 0) + 1\n    return counts_dict"}
{"task_id": "Mbpp/239", "solution": "def get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Calculates the total number of possible sequences of length n,\n    such that each element is a positive integer, is greater than or equal to\n    twice the previous element, but less than or equal to m.\n    \"\"\"\n\n    # Helper function to recursively count valid sequences.\n    def _count_sequences_recursive(current_length: int, last_element: int, m: int, n: int) -> int:\n        if current_length == n:\n            return 1\n\n        count = 0\n        start_next_element = last_element * 2\n\n        for next_element in range(start_next_element, m + 1):\n            count += _count_sequences_recursive(current_length + 1, next_element, m, n)\n\n        return count\n\n    total_count = 0\n    if n == 1:\n        return m\n\n    for first_element in range(1, m + 1):\n        total_count += _count_sequences_recursive(1, first_element, m, n)\n\n    return total_count"}
