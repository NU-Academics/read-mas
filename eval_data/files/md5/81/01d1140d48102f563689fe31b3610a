{"task_id": "Mbpp/410", "solution": "def min_val(input_list: list) -> int | float:\n    \"\"\"Finds the minimum numeric value in a heterogeneous list, ignoring non-numeric elements.\n    If no numeric elements are found, returns float('inf').\n    \"\"\"\n    min_numeric_value = float('inf')\n\n    for element in input_list:\n        if isinstance(element, (int, float)):\n            if element < min_numeric_value:\n                min_numeric_value = element\n    \n    return min_numeric_value"}
{"task_id": "Mbpp/415", "solution": "def max_Product(array_of_integers: list[int]) -> tuple[int, int]:\n    \"\"\"Finds a pair of integers from the input array that yields the highest product.\n    Returns the identified pair as a tuple.\n    \"\"\"\n    sorted_arr = sorted(array_of_integers)\n    n = len(sorted_arr)\n\n    # Candidate 1: Product of the two largest numbers\n    # This covers cases where the highest product comes from two positive numbers.\n    product_of_largest_two = sorted_arr[n - 1] * sorted_arr[n - 2]\n    pair_of_largest_two = (sorted_arr[n - 1], sorted_arr[n - 2])\n\n    # Candidate 2: Product of the two smallest numbers\n    # This covers cases where the highest product comes from two negative numbers.\n    product_of_smallest_two = sorted_arr[0] * sorted_arr[1]\n    pair_of_smallest_two = (sorted_arr[0], sorted_arr[1])\n\n    if product_of_largest_two >= product_of_smallest_two:\n        return pair_of_largest_two\n    else:\n        return pair_of_smallest_two"}
{"task_id": "Mbpp/418", "solution": "def Find_Max(input_list):\n    \"\"\"\n    Finds the element (inner list) with the maximum length from a list of lists.\n    Assumes input_list is a list of lists.\n    \"\"\"\n    if not input_list:\n        return None\n\n    max_length = -1\n    max_length_element = None\n\n    for element in input_list:\n        # Assuming element is always a list based on problem statement and assert\n        current_length = len(element)\n        if current_length > max_length:\n            max_length = current_length\n            max_length_element = element\n\n    return max_length_element"}
{"task_id": "Mbpp/419", "solution": "def _round_number(value: float) -> int:\n    \"\"\"Rounds a single floating-point number to the nearest integer.\"\"\"\n    return round(value)\ndef _calculate_sum(rounded_numbers: list[int]) -> int:\n    \"\"\"Calculates the sum of a list of integers.\"\"\"\n    return sum(rounded_numbers)\ndef _get_list_length(numbers: list[float]) -> int:\n    \"\"\"Determines the length of a given list.\"\"\"\n    return len(numbers)\ndef _multiply_sum_by_length(total_sum: int, list_length: int) -> int:\n    \"\"\"Multiplies two integer values.\"\"\"\n    return total_sum * list_length\ndef round_and_sum(numbers: list[float]) -> int:\n    \"\"\"\n    Rounds every number of a given list and returns the total sum\n    multiplied by the length of the list.\n    \"\"\"\n    list_length = _get_list_length(numbers)\n    rounded_numbers = [_round_number(num) for num in numbers]\n    total_sum = _calculate_sum(rounded_numbers)\n    final_value = _multiply_sum_by_length(total_sum, list_length)\n    return final_value"}
{"task_id": "Mbpp/422", "solution": "def find_Average_Of_Cube(n: int) -> float:\n    \"\"\"\n    Calculates the average of the cubes of the first n natural numbers.\n    Assumes n is a positive integer.\n    \"\"\"\n    sum_of_cubes = 0\n    for i in range(1, n + 1):\n        sum_of_cubes += i * i * i\n    \n    return sum_of_cubes / n"}
