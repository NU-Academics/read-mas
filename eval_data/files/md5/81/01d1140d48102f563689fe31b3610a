{"task_id": "Mbpp/448", "solution": "class PerrinSequenceGenerator:\n    \"\"\"\n    Generates individual Perrin numbers using memoization for efficiency.\n    Initializes cache with base Perrin numbers P(0), P(1), P(2).\n    \"\"\"\n    def __init__(self):\n        self._cache = {\n            0: 3,\n            1: 0,\n            2: 2\n        }\n\n    def generate_perrin_number(self, index: int) -> int:\n        \"\"\"\n        Calculates and returns the Perrin number for the given index.\n        Uses recurrence relation P(n) = P(n-2) + P(n-3) and memoization.\n        \"\"\"\n        if index < 0:\n            return 0  # Or handle error as appropriate for negative indices\n        if index in self._cache:\n            return self._cache[index]\n\n        # Calculate using recurrence relation\n        value = self.generate_perrin_number(index - 2) + self.generate_perrin_number(index - 3)\n        self._cache[index] = value\n        return value\nclass PerrinSumCalculator:\n    \"\"\"\n    Calculates the sum of Perrin numbers from P(0) up to a specified limit.\n    Delegates individual Perrin number generation to a PerrinSequenceGenerator instance.\n    \"\"\"\n    def __init__(self, generator: PerrinSequenceGenerator):\n        self._generator = generator\n\n    def calculate_sum(self, limit: int) -> int:\n        \"\"\"\n        Iterates from 0 to 'limit' (inclusive), generating each Perrin number\n        and accumulating their sum.\n        \"\"\"\n        total_sum = 0\n        for i in range(limit + 1):\n            total_sum += self._generator.generate_perrin_number(i)\n        return total_sum\ndef cal_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of Perrin numbers from P(0) up to and including the specified index 'n'.\n    This is the main entry point for users.\n    \"\"\"\n    generator = PerrinSequenceGenerator()\n    calculator = PerrinSumCalculator(generator)\n    return calculator.calculate_sum(n)"}
