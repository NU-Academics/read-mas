{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"\n    Calculate sum of fourth powers of first n odd natural numbers.\n    \"\"\"\n    total_sum = 0\n    for k in range(1, n + 1):\n        odd_number = 2 * k - 1\n        total_sum += odd_number ** 4\n    return total_sum"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"\n    Finds the sum of the fourth power of the first n odd natural numbers.\n    Calculates \u03a3(2i-1)\u2074 for i=1 to n.\n    \"\"\"\n    total_sum = 0\n    for i in range(1, n + 1):\n        odd_num = (2 * i - 1)\n        total_sum += odd_num ** 4\n    return total_sum"}
{"task_id": "Mbpp/772", "solution": "def remove_length(text: str, k: int) -> str:\n    \"\"\"\n    Removes all words with a specific length k from the given string.\n    The function processes the string to split, filter, and rejoin words.\n    \"\"\"\n    def _split_words(text: str) -> list[str]:\n        \"\"\"Splits the input string into a list of individual words.\"\"\"\n        return text.split()\n\n    def _filter_words_by_length(words: list[str], k: int) -> list[str]:\n        \"\"\"Filters a list of words, removing those with exactly length k.\"\"\"\n        return [word for word in words if len(word) != k]\n\n    def _join_words(words: list[str]) -> str:\n        \"\"\"Joins a list of words into a single string with single spaces.\"\"\"\n        return ' '.join(words)\n\n    words = _split_words(text)\n    filtered_words = _filter_words_by_length(words, k)\n    result_string = _join_words(filtered_words)\n    return result_string"}
{"task_id": "Mbpp/771", "solution": "```python\ndef check_expression(expression: str) -> bool:\n    \"\"\"\n    Checks if the given expression has balanced brackets and parentheses.\n    Uses a stack-based algorithm to ensure proper pairing and nesting.\n    \"\"\"\n    BRACKET_PAIRS = {')': '(', ']': '[', '}': '{'}\n    opening_brackets = set(BRACKET_PAIRS.values())\n    closing_brackets = set(BRACKET_PAIRS.keys())\n\n    stack = []\n\n    for char in expression:\n        if char in opening_brackets:\n            stack.append(char)\n        elif char in closing_brackets:\n            if not stack:\n                return False\n            last_open = stack.pop()\n            if last_open != BRACKET_PAIRS[char]:\n                return False\n    \n    return not stack\n```"}
{"task_id": "Mbpp/771", "solution": "def check_expression(expression: str) -> bool:\n    \"\"\"Checks if the given expression has balanced brackets.\"\"\"\n    stack = []\n    \n    # Define opening brackets and a map for matching closing to opening brackets\n    opening_brackets = \"({[\"\n    closing_brackets_map = {')': '(', ']': '[', '}': '{'}\n\n    for char in expression:\n        if char in opening_brackets:\n            stack.append(char)\n        elif char in closing_brackets_map:\n            if not stack:\n                return False  # Closing bracket found with no corresponding opening bracket\n            \n            last_opened = stack.pop()\n            if closing_brackets_map[char] != last_opened:\n                return False  # Mismatched opening and closing brackets\n    \n    # If the stack is empty at the end, all brackets were balanced\n    return not stack"}
{"task_id": "Mbpp/772", "solution": "def remove_length(text: str, k: int) -> str:\n    \"\"\"\n    Removes all words with exactly k characters from the given string.\n    Words are separated by spaces, and the output string has normalized spacing.\n    \"\"\"\n    words = text.split()\n    filtered_words = [word for word in words if len(word) != k]\n    return \" \".join(filtered_words)"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(source_string: str, search_substring: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Finds the first occurrence and position of a substring within a string.\n    Returns a tuple (matched_substring, start_position, end_position) or None if no match.\n    \"\"\"\n    if source_string is None or search_substring is None:\n        return None\n\n    start_position = source_string.find(search_substring)\n\n    if start_position != -1:\n        end_position = start_position + len(search_substring)\n        return (search_substring, start_position, end_position)\n    else:\n        return None"}
