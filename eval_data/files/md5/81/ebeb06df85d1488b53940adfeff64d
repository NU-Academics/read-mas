{"task_id": "Mbpp/725", "solution": "def extract_quotation(input_string: str) -> list[str]:\n    \"\"\"\n    Extracts values enclosed within double quotation marks from the given string.\n    \"\"\"\n    extracted_values = []\n    in_quote = False\n    start_index = -1\n\n    for i, char in enumerate(input_string):\n        if char == '\"':\n            if not in_quote:\n                # Found an opening quote\n                start_index = i\n                in_quote = True\n            else:\n                # Found a closing quote\n                # Extract the substring between the last opening quote and this closing quote\n                extracted_values.append(input_string[start_index + 1 : i])\n                in_quote = False\n                start_index = -1 # Reset for next pair\n\n    return extracted_values"}
{"task_id": "Mbpp/725", "solution": "import re\n\ndef extract_quotation(input_string: str) -> list[str]:\n    \"\"\"\n    Extract all text values that are enclosed within double quotation marks.\n\n    Args:\n        input_string: String containing potential quoted segments\n\n    Returns:\n        List of strings containing extracted quoted values, excluding quotes\n\n    Example:\n        extract_quotation('Cortex \"A53\" Based \"multi\" tasking \"Processor\"')\n        returns ['A53', 'multi', 'Processor']\n    \"\"\"\n    # Use regular expression to find all non-greedy matches of any characters\n    # (except a double quote) enclosed within double quotes.\n    # The parentheses create a capturing group for the content between the quotes.\n    return re.findall(r'\"([^\"]*)\"', input_string)"}
{"task_id": "Mbpp/730", "solution": "def consecutive_duplicates(input_list: list) -> list:\n    \"\"\"\n    Removes consecutive duplicate elements from a list, preserving the order and non-consecutive duplicates.\n    Returns a new list with no consecutive duplicates.\n    \"\"\"\n    if not input_list:\n        return []\n    \n    # Initialize the result list with the first element\n    result = [input_list[0]]\n    \n    # Iterate through the rest of the list, comparing each element\n    # with the last element added to the result list.\n    for i in range(1, len(input_list)):\n        if input_list[i] != result[-1]:\n            result.append(input_list[i])\n            \n    return result"}
{"task_id": "Mbpp/730", "solution": "def consecutive_duplicates(input_list):\n    \"\"\"\n    Removes consecutive duplicate elements from a list, preserving the first occurrence.\n    Returns a new list with duplicates removed, maintaining the original order.\n    \"\"\"\n    if not input_list:\n        return []\n\n    result = [input_list[0]]\n    for i in range(1, len(input_list)):\n        if input_list[i] != result[-1]:\n            result.append(input_list[i])\n    return result"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(array: list[int], target: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a target number in a sorted array.\n    Uses a binary search approach to achieve O(log n) time complexity.\n    \"\"\"\n    left, right = 0, len(array) - 1\n    first_occurrence_index = -1\n\n    while left <= right:\n        mid = left + (right - left) // 2\n\n        if array[mid] == target:\n            first_occurrence_index = mid\n            # We found an occurrence, but it might not be the *first*.\n            # Try to find an even earlier occurrence in the left half.\n            right = mid - 1\n        elif array[mid] < target:\n            # Target is in the right half.\n            left = mid + 1\n        else:  # array[mid] > target\n            # Target is in the left half.\n            right = mid - 1\n\n    return first_occurrence_index"}
{"task_id": "Mbpp/731", "solution": "import math\n\ndef lateralsurface_cone(r, h):\n    \"\"\"\n    Calculates the lateral surface area of a cone given its radius and height.\n    The formula used is \u03c0 * r * \u221a(r\u00b2 + h\u00b2).\n    \"\"\"\n    slant_height = math.sqrt(r**2 + h**2)\n    lateral_area = math.pi * r * slant_height\n    return lateral_area"}
