{"task_id": "Mbpp/745", "solution": "def divisible_by_digits(startnum, endnum):\n    \"\"\"\n    Finds numbers within a given range where every number is divisible by every digit it contains.\n    Numbers containing the digit 0 are excluded from consideration.\n    \"\"\"\n\n    def contains_zero(number: int) -> bool:\n        \"\"\"Checks if a number contains the digit zero.\"\"\"\n        return '0' in str(number)\n\n    def extract_digits(number: int) -> list:\n        \"\"\"Extracts individual digits from a number.\"\"\"\n        return [int(d) for d in str(number)]\n\n    def is_divisible_by_all_digits(number: int) -> bool:\n        \"\"\"\n        Checks if a number is divisible by all its constituent digits.\n        Assumes the number does not contain the digit 0.\n        \"\"\"\n        digits = extract_digits(number)\n        for digit in digits:\n            if number % digit != 0:\n                return False\n        return True\n\n    result = []\n    for num in range(startnum, endnum + 1):\n        if not contains_zero(num):\n            if is_divisible_by_all_digits(num):\n                result.append(num)\n    return result"}
{"task_id": "Mbpp/748", "solution": "def capital_words_spaces(input_string: str) -> str:\n    \"\"\"\n    Inserts spaces between words starting with capital letters in a given string.\n    Preserves original string for single words starting with a capital.\n    \"\"\"\n\n    if not input_string:\n        return \"\"\n\n    def _is_capital_letter(char: str) -> bool:\n        \"\"\"Determines if a character is an uppercase letter.\"\"\"\n        return 'A' <= char <= 'Z'\n\n    def _should_insert_space(prev_char: str, curr_char: str) -> bool:\n        \"\"\"Determines if a space should be inserted before the current character.\"\"\"\n        return (prev_char != ' ' and\n                (_is_capital_letter(curr_char) and (prev_char.islower() or prev_char.isdigit())))\n\n    result = []\n    prev_char = ''\n\n    for i, char in enumerate(input_string):\n        if i > 0 and _should_insert_space(prev_char, char):\n            result.append(' ')\n        result.append(char)\n        prev_char = char\n\n    return \"\".join(result)"}
{"task_id": "Mbpp/745", "solution": "def divisible_by_digits(startnum, endnum):\n    \"\"\"\n    Finds numbers within a given range where every number is divisible by every digit it contains.\n    Numbers containing the digit 0 are excluded.\n    \"\"\"\n\n    def has_zero_digit(number):\n        \"\"\"Checks if a number contains the digit 0.\"\"\"\n        return '0' in str(number)\n\n    def is_divisible_by_all_digits(number):\n        \"\"\"\n        Checks if a number is divisible by all its digits.\n        Assumes the number does not contain the digit 0.\n        \"\"\"\n        temp_num = number\n        while temp_num > 0:\n            digit = temp_num % 10\n            # By design context, has_zero_digit is checked first,\n            # so 'digit' will never be 0 here.\n            if number % digit != 0:\n                return False\n            temp_num //= 10\n        return True\n\n    result = []\n    for num in range(startnum, endnum + 1):\n        if not has_zero_digit(num):\n            if is_divisible_by_all_digits(num):\n                result.append(num)\n    return result"}
