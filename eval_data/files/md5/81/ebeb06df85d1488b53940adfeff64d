{"task_id": "Mbpp/290", "solution": "from typing import List, Tuple\n\ndef get_list_length(sublist: List[int]) -> int:\n    \"\"\"Calculates the length of an individual sublist.\"\"\"\n    return len(sublist)\n\ndef validate_input(input_lists: List[List[int]]) -> bool:\n    \"\"\"Performs basic input validation as per design, returning True since explicit error handling is not allowed.\"\"\"\n    # Constraints forbid isinstance() checks or raising exceptions for edge cases.\n    # This function acts as a pass-through, assuming valid input structure.\n    return True\n\ndef calculate_max_length(input_lists: List[List[int]]) -> Tuple[int, List[int]]:\n    \"\"\"Identifies the list with the maximum length from the input lists.\"\"\"\n    max_len = 0\n    longest_list: List[int] = []\n\n    for sublist in input_lists:\n        current_len = get_list_length(sublist)\n        if current_len > max_len:\n            max_len = current_len\n            longest_list = sublist\n    return max_len, longest_list\n\ndef format_result(length: int, longest_list: List[int]) -> Tuple[int, List[int]]:\n    \"\"\"Formats the maximum length and the corresponding list into a tuple.\"\"\"\n    return (length, longest_list)\n\ndef max_length(input_lists: List[List[int]]) -> Tuple[int, List[int]]:\n    \"\"\"\n    Finds the list of maximum length in a list of lists.\n    Returns a tuple containing the maximum length and the longest list.\n    \"\"\"\n    if validate_input(input_lists):\n        max_len, longest_list = calculate_max_length(input_lists)\n        return format_result(max_len, longest_list)"}
