{"task_id": "Mbpp/736", "solution": "def left_insertion(array, target_value):\n    \"\"\"\n    Locates the left insertion point for a specified value in a sorted array.\n    This function uses a binary search algorithm to find the correct index in O(log n) time.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n    ans = len(array)  # Default answer if target is greater than all elements or array is empty\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] >= target_value:\n            # mid could be the insertion point, or an earlier index\n            ans = mid\n            high = mid - 1\n        else:\n            # target_value must be in the right half\n            low = mid + 1\n            \n    return ans"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(array: list[int], target: int) -> int:\n    \"\"\"\n    Locates the left insertion point for a specified value in a sorted array.\n    This function implements binary search to find the index where the target\n    should be inserted to maintain sorted order, returning the leftmost position\n    for duplicate values.\n    \"\"\"\n    low = 0\n    high = len(array)\n\n    while low < high:\n        mid = low + (high - low) // 2\n        if array[mid] < target:\n            low = mid + 1\n        else:\n            high = mid\n            \n    return low"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(number: int) -> int:\n    \"\"\"Toggle all bits of the number except the first and the last bit.\"\"\"\n\n    def _get_bit_length(num: int) -> int:\n        \"\"\"Calculates the number of bits needed to represent the number.\"\"\"\n        return num.bit_length()\n\n    def _create_middle_mask(b_length: int) -> int:\n        \"\"\"Creates a mask that covers only the middle bits.\"\"\"\n        if b_length <= 2:\n            return 0\n        all_ones_mask = (1 << b_length) - 1\n        msb_mask = 1 << (b_length - 1)\n        lsb_mask = 1\n        return all_ones_mask ^ msb_mask ^ lsb_mask\n\n    def _preserve_boundaries(original_num: int, toggled_num: int, b_length: int) -> int:\n        \"\"\"Ensures the first and last bits of the toggled number match the original.\"\"\"\n        if b_length == 0:\n            return 0\n        \n        original_msb = (original_num >> (b_length - 1)) & 1\n        original_lsb = original_num & 1\n        \n        result_num = toggled_num\n        \n        # Clear MSB in the toggled number\n        result_num &= ~(1 << (b_length - 1))\n        \n        # Clear LSB in the toggled number\n        result_num &= ~1\n        \n        # Set original MSB\n        result_num |= (original_msb << (b_length - 1))\n        \n        # Set original LSB\n        result_num |= original_lsb\n        \n        return result_num\n\n    bit_len = _get_bit_length(number)\n    \n    middle_mask = _create_middle_mask(bit_len)\n    \n    toggled_val = number ^ middle_mask\n    \n    final_result = _preserve_boundaries(number, toggled_val, bit_len)\n    \n    return final_result"}
