{"task_id": "Mbpp/74", "solution": "def is_samepatterns(array1: list, array2: list) -> bool:\n    \"\"\"\n    Checks if two arrays follow the same pattern structure.\n    A pattern structure is defined by the relative positions and repetition of elements.\n    \"\"\"\n    if not _validate_arrays(array1, array2):\n        return False\n\n    pattern1_map = _create_pattern_map(array1)\n    pattern2_map = _create_pattern_map(array2)\n\n    return _compare_patterns(pattern1_map, pattern2_map)\n\n\ndef _validate_arrays(array1: list, array2: list) -> bool:\n    \"\"\"\n    Validates if the two input arrays have the same length.\n    \"\"\"\n    return len(array1) == len(array2)\n\n\ndef _create_pattern_map(array: list) -> dict:\n    \"\"\"\n    Creates a canonical pattern map for the given array.\n    Each unique element is mapped to a sequential integer code based on its first appearance,\n    and the map stores these codes indexed by their position in the array.\n    \"\"\"\n    seen_elements = {}\n    canonical_pattern_map = {}\n    next_code = 0\n\n    for i, val in enumerate(array):\n        if val not in seen_elements:\n            seen_elements[val] = next_code\n            next_code += 1\n        canonical_pattern_map[i] = seen_elements[val]\n\n    return canonical_pattern_map\n\n\ndef _compare_patterns(pattern1: dict, pattern2: dict) -> bool:\n    \"\"\"\n    Compares two pattern maps for structural equality.\n    \"\"\"\n    return pattern1 == pattern2"}
{"task_id": "Mbpp/74", "solution": "def is_samepatterns(array1: list, array2: list) -> bool:\n    \"\"\"\n    Checks if two arrays follow the same structural pattern.\n    \"\"\"\n    if len(array1) != len(array2):\n        return False\n\n    map1_to_2 = {}\n    map2_to_1 = {}\n\n    for i in range(len(array1)):\n        item1 = array1[i]\n        item2 = array2[i]\n\n        # Check mapping from array1 to array2\n        if item1 in map1_to_2:\n            if map1_to_2[item1] != item2:\n                return False\n        else:\n            map1_to_2[item1] = item2\n\n        # Check mapping from array2 to array1\n        if item2 in map2_to_1:\n            if map2_to_1[item2] != item1:\n                return False\n        else:\n            map2_to_1[item2] = item1\n\n    return True"}
