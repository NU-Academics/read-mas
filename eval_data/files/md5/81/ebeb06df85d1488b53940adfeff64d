{"task_id": "Mbpp/751", "solution": "def check_min_heap(array: list) -> bool:\n    \"\"\"\n    Checks if the given array represents a min heap.\n    Returns True if it is a min heap, False otherwise.\n    \"\"\"\n    def _get_left_child_index(parent_index: int) -> int:\n        return 2 * parent_index + 1\n\n    def _get_right_child_index(parent_index: int) -> int:\n        return 2 * parent_index + 2\n\n    def _validate_parent_child(arr: list, parent_idx: int, child_idx: int) -> bool:\n        return arr[parent_idx] <= arr[child_idx]\n\n    n = len(array)\n    if n <= 1:\n        return True\n\n    # Iterate only through parent nodes\n    # The last parent node is at index (n // 2) - 1\n    for i in range(n // 2):\n        left_child_idx = _get_left_child_index(i)\n        right_child_idx = _get_right_child_index(i)\n\n        # Check left child\n        if left_child_idx < n:\n            if not _validate_parent_child(array, i, left_child_idx):\n                return False\n\n        # Check right child\n        if right_child_idx < n:\n            if not _validate_parent_child(array, i, right_child_idx):\n                return False\n\n    return True"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(array: list[int]) -> bool:\n    \"\"\"\n    Checks if the given array represents a min-heap.\n    A min-heap satisfies the property where every parent node's value is\n    less than or equal to the values of its children nodes.\n    \"\"\"\n    n = len(array)\n\n    # An empty array or an array with one element is always a valid min-heap.\n    if n <= 1:\n        return True\n\n    # Iterate only through parent nodes (from the first node up to the last non-leaf node).\n    # The last non-leaf node is at index (n // 2) - 1.\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child\n        if left_child_idx < n and array[i] > array[left_child_idx]:\n            return False\n\n        # Check right child\n        if right_child_idx < n and array[i] > array[right_child_idx]:\n            return False\n\n    # If no violations were found, it is a min-heap.\n    return True"}
{"task_id": "Mbpp/753", "solution": "def min_k(tuple_list: list[tuple[str, int]], k: int) -> list[tuple[str, int]]:\n    \"\"\"\n    Find minimum k records from tuple list based on second element values.\n\n    Sorts the input list by the second element and returns the first k elements.\n    \"\"\"\n    sorted_list = sorted(tuple_list, key=lambda item: item[1])\n    return sorted_list[:k]"}
