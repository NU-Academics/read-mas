{"task_id": "Mbpp/119", "solution": "def search(array: list) -> int:\n    \"\"\"\n    Finds the element that appears only once in a sorted array using binary search.\n    All other elements appear twice.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n\n    while low < high:\n        mid = (low + high) // 2\n        \n        # `mid ^ 1` calculates the partner index:\n        # If mid is even (e.g., 2), mid ^ 1 is mid + 1 (e.g., 3).\n        # If mid is odd (e.g., 3), mid ^ 1 is mid - 1 (e.g., 2).\n        partner_idx = mid ^ 1\n        \n        if array[mid] == array[partner_idx]:\n            # If the elements at `mid` and `partner_idx` are equal,\n            # they form a pair. The unique element must be to their right.\n            # Advance `low` to the position immediately after this pair.\n            low = max(mid, partner_idx) + 1\n        else:\n            # If the elements are not equal, then `array[mid]` is either\n            # the unique element or the second part of a pair whose first\n            # element is to its left, meaning the unique element is at or\n            # to the left of `mid`.\n            high = mid\n            \n    return array[low]"}
{"task_id": "Mbpp/120", "solution": "def max_product_tuple(tuples: list) -> int:\n    \"\"\"\n    Calculates the maximum absolute product between numbers in pairs of tuples.\n\n    Iterates through each tuple, computes the absolute product of its elements,\n    and returns the largest absolute product found.\n    \"\"\"\n    max_product = 0\n\n    for pair in tuples:\n        current_product = abs(pair[0] * pair[1])\n        max_product = max(max_product, current_product)\n\n    return max_product"}
{"task_id": "Mbpp/120", "solution": "def max_product_tuple(tuple_list):\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples within a given list.\n    Assumes valid input: a list of tuples, where each tuple contains exactly two numbers (int or float).\n    \"\"\"\n    max_abs_product = 0\n\n    for a, b in tuple_list:\n        current_abs_product = abs(a * b)\n        if current_abs_product > max_abs_product:\n            max_abs_product = current_abs_product\n\n    return max_abs_product"}
{"task_id": "Mbpp/123", "solution": "_memo_proper_divisors_sum = {}\n\ndef calculate_proper_divisors_sum(number: int) -> int:\n    \"\"\"Calculates the sum of proper divisors for a given number, using memoization.\"\"\"\n    if number <= 1:\n        return 0\n    if number in _memo_proper_divisors_sum:\n        return _memo_proper_divisors_sum[number]\n\n    total_sum = 1\n    i = 2\n    while i * i <= number:\n        if number % i == 0:\n            total_sum += i\n            if i * i != number:\n                total_sum += number // i\n        i += 1\n    \n    _memo_proper_divisors_sum[number] = total_sum\n    return total_sum\n\ndef is_amicable_pair(a: int, b: int) -> bool:\n    \"\"\"Validates if two numbers form an amicable pair.\"\"\"\n    if a == b:\n        return False\n    \n    if calculate_proper_divisors_sum(a) == b and calculate_proper_divisors_sum(b) == a:\n        return True\n    return False\n\ndef find_amicable_numbers(limit: int) -> list[int]:\n    \"\"\"Identifies all amicable numbers within the specified range.\"\"\"\n    amicable_nums = set()\n    \n    for n in range(1, limit + 1):\n        sum_div_n = calculate_proper_divisors_sum(n)\n        \n        # Check for potential amicable pairs (a, b) where a < b to avoid duplicates and self-pairs\n        if sum_div_n > n and sum_div_n <= limit:\n            if is_amicable_pair(n, sum_div_n):\n                amicable_nums.add(n)\n                amicable_nums.add(sum_div_n)\n                    \n    return sorted(list(amicable_nums))\n\ndef amicable_numbers_sum(limit: int) -> int:\n    \"\"\"\n    Calculates the sum of all amicable numbers up to a specified limit.\n    It identifies amicable pairs (a, b) where a != b, d(a) = b, and d(b) = a.\n    \"\"\"\n    global _memo_proper_divisors_sum\n    # Clear the memoization cache for each call to ensure independent execution\n    _memo_proper_divisors_sum = {} \n\n    if limit <= 0:\n        return 0\n        \n    amicable_nums = find_amicable_numbers(limit)\n    return sum(amicable_nums)"}
