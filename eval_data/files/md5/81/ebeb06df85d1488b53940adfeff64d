{"task_id": "Mbpp/137", "solution": "def zero_count(array: list[int]) -> float:\n    \"\"\"\n    Calculate the ratio of zeros to non-zeros in an integer array.\n    Raises ZeroDivisionError if there are no non-zero elements in the array.\n    \"\"\"\n    zero_count = 0\n    non_zero_count = 0\n\n    for num in array:\n        if num == 0:\n            zero_count += 1\n        else:\n            non_zero_count += 1\n\n    if non_zero_count == 0:\n        raise ZeroDivisionError(\"Cannot calculate ratio: no non-zero elements in the array.\")\n\n    return zero_count / non_zero_count"}
{"task_id": "Mbpp/137", "solution": "def zero_count(array: list[int]) -> float:\n    \"\"\"\n    Calculates the ratio of zeroes to non-zeroes in an array of integers.\n    \"\"\"\n    def _count_zeros(arr: list[int]) -> int:\n        \"\"\"Counts the number of zero elements in the array.\"\"\"\n        return arr.count(0)\n\n    def _count_non_zeros(arr: list[int]) -> int:\n        \"\"\"Counts the number of non-zero elements in the array.\"\"\"\n        return len(arr) - arr.count(0)\n\n    def _calculate_ratio(num_zeros: int, num_non_zeros: int) -> float:\n        \"\"\"Calculates the ratio of zero count to non-zero count.\"\"\"\n        if num_non_zeros == 0:\n            return 0.0  # Handle division by zero gracefully, as per common design patterns for ratios.\n        return num_zeros / num_non_zeros\n\n    num_zeros = _count_zeros(array)\n    num_non_zeros = _count_non_zeros(array)\n    \n    return _calculate_ratio(num_zeros, num_non_zeros)"}
{"task_id": "Mbpp/138", "solution": "def is_Sum_Of_Powers_Of_Two(number: int) -> bool:\n    \"\"\"\n    Checks if the given number can be represented as a sum of non-zero powers of 2.\n    This is true for any positive even integer, as its binary representation will only include powers 2^k where k >= 1.\n    \"\"\"\n    if number <= 0:\n        return False\n    # A number can be represented as a sum of non-zero powers of 2 if and only if\n    # it is positive and even. An odd number would require 2^0 (which is 1),\n    # which is not a \"non-zero power of 2\".\n    return number % 2 == 0"}
{"task_id": "Mbpp/138", "solution": "def is_Sum_Of_Powers_Of_Two(number: int) -> bool:\n    \"\"\"\n    Checks if a number can be represented as a sum of unique non-zero powers of 2.\n    For example, 10 = 2^1 + 2^3.\n    \"\"\"\n\n    if number <= 1:\n        return False\n\n    def generate_powers_of_two(max_value: int) -> list[int]:\n        \"\"\"Generates a list of non-zero powers of 2 up to max_value.\"\"\"\n        powers = []\n        power_of_2 = 2  # Start with 2^1\n        while power_of_2 <= max_value:\n            powers.append(power_of_2)\n            power_of_2 *= 2\n        return powers\n\n    def check_sum_combination(powers: list[int], target: int) -> bool:\n        \"\"\"Checks if any combination of powers sums to the target.\"\"\"\n        n = len(powers)\n        # Iterate through all possible non-empty subsets using bit manipulation.\n        for i in range(1, 1 << n):  # 1 << n is equivalent to 2^n\n            current_sum = 0\n            for j in range(n):\n                # If the j-th bit is set in i, include powers[j] in the sum.\n                if (i >> j) & 1:\n                    current_sum += powers[j]\n            if current_sum == target:\n                return True\n        return False\n\n    relevant_powers = generate_powers_of_two(number)\n    return check_sum_combination(relevant_powers, number)"}
