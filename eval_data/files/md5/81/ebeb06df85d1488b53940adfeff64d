{"task_id": "Mbpp/109", "solution": "def odd_Equivalent(binary_string: str, rotation_count: int) -> int:\n    \"\"\"\n    Finds the number of odd decimal values obtained when rotating a binary string.\n    \"\"\"\n\n    def _rotate_left(s: str) -> str:\n        \"\"\"Rotates a string one position to the left.\"\"\"\n        return s[1:] + s[0]\n\n    def _binary_to_decimal(s: str) -> int:\n        \"\"\"Converts a binary string to its decimal integer equivalent.\"\"\"\n        return int(s, 2)\n\n    def _is_odd(n: int) -> bool:\n        \"\"\"Checks if an integer is odd.\"\"\"\n        return n % 2 != 0\n\n    odd_count = 0\n    current_string = binary_string\n\n    for _ in range(rotation_count):\n        decimal_value = _binary_to_decimal(current_string)\n        if _is_odd(decimal_value):\n            odd_count += 1\n        current_string = _rotate_left(current_string)\n\n    return odd_count"}
{"task_id": "Mbpp/113", "solution": "def check_integer(input_string: str) -> bool:\n    \"\"\"\n    Checks if a string represents a valid integer, handling optional leading signs.\n    Returns True for valid integers, False otherwise.\n    \"\"\"\n    if not input_string:\n        return False\n\n    start_index = 0\n    if input_string[0] in ('-', '+'):\n        start_index = 1\n\n    numeric_part = input_string[start_index:]\n    \n    # An integer must contain at least one digit after an optional sign\n    if not numeric_part:\n        return False\n        \n    return numeric_part.isdigit()"}
{"task_id": "Mbpp/111", "solution": "def common_in_nested_lists(nested_lists):\n    \"\"\"\n    Find common elements in nested lists using set intersections.\n\n    Args:\n        nested_lists: A list of lists, where each inner list contains integer elements.\n\n    Returns:\n        A list of integers that are present in all sublists.\n    \"\"\"\n    if not nested_lists:\n        return []\n\n    # Initialize the set of common elements with the first sublist's elements\n    common_elements_set = set(nested_lists[0])\n\n    # Iterate through the rest of the sublists and find intersections\n    for sublist in nested_lists[1:]:\n        common_elements_set = common_elements_set.intersection(sublist)\n        # Optimization: if common_elements_set becomes empty, no more common elements can be found\n        if not common_elements_set:\n            return []\n\n    return list(common_elements_set)"}
{"task_id": "Mbpp/109", "solution": "def odd_Equivalent(binary_string: str, rotations: int) -> int:\n    \"\"\"Finds the number of odd decimal values when rotating a binary string.\n\n    Performs rotations, converts to decimal, and counts odd results.\n    \"\"\"\n\n    def _rotate_left(s: str) -> str:\n        \"\"\"Rotate string left by one position.\"\"\"\n        if not s:\n            return s\n        return s[1:] + s[0]\n\n    def _binary_to_decimal(s: str) -> int:\n        \"\"\"Convert binary string to decimal integer.\"\"\"\n        if not s:\n            return 0\n        return int(s, 2)\n\n    def _is_odd(n: int) -> bool:\n        \"\"\"Check if number is odd.\"\"\"\n        return n % 2 != 0\n\n    # _validate_binary_string is defined as per design but not called due to \"Do NOT raise exceptions for edge cases\" constraint.\n    # The main function assumes valid binary_string input for its operation.\n    def _validate_binary_string(s: str) -> bool:\n        \"\"\"Validate binary string contains only 0 and 1.\"\"\"\n        return all(char in '01' for char in s)\n\n    odd_count = 0\n    current_string = binary_string\n    n = len(binary_string)\n\n    # Perform rotations up to the given number of times, or length of string if smaller.\n    # The problem description implies 'rotations' is the number of distinct states to check,\n    # starting from the original, up to 'rotations' times.\n    # The 'assert odd_Equivalent(\"011001\",6) == 3' suggests we iterate 6 times,\n    # and \"011001\" has length 6. If rotations > n, it effectively loops through n unique states.\n    # Let's clarify: the design context sequence diagram shows \"loop for each rotation (0 to 5)\".\n    # This means 'rotations' is the total number of states to consider, including the original.\n    for _ in range(rotations):\n        decimal_value = _binary_to_decimal(current_string)\n        if _is_odd(decimal_value):\n            odd_count += 1\n        current_string = _rotate_left(current_string)\n\n    return odd_count"}
{"task_id": "Mbpp/113", "solution": "def check_integer(input_string: str) -> bool:\n    \"\"\"Checks if a string represents an integer, handling signs and excluding non-digit characters.\"\"\"\n    # An empty string or a string containing only whitespace is not an integer.\n    if not input_string or not input_string.strip():\n        return False\n\n    n = len(input_string)\n    start_index = 0\n\n    # Check for an optional leading sign (+ or -).\n    if input_string[0] == '-' or input_string[0] == '+':\n        start_index = 1\n\n    # After checking for a sign, there must be at least one digit.\n    # If start_index equals n, it means the string was empty or only a sign (e.g., \"+\", \"-\").\n    if start_index == n:\n        return False\n\n    # Iterate through the remaining characters to ensure they are all digits.\n    for i in range(start_index, n):\n        if not input_string[i].isdigit():\n            return False\n\n    return True"}
{"task_id": "Mbpp/111", "solution": "from typing import List, Any, Set\n\nclass InputValidator:\n    \"\"\"Utility for validating the structure and types of input nested lists.\"\"\"\n\n    @staticmethod\n    def is_valid_structure(data: Any) -> bool:\n        \"\"\"Checks if the data is a list containing only lists.\"\"\"\n        if not isinstance(data, list):\n            return False\n        for sublist in data:\n            if not isinstance(sublist, list):\n                return False\n        return True\n\n    @staticmethod\n    def validate_nested_lists(nested_lists: Any) -> bool:\n        \"\"\"Validates if the input is a proper nested list structure.\"\"\"\n        if not InputValidator.is_valid_structure(nested_lists):\n            raise ValueError(\"Input must be a list of lists.\")\n        return True\n\n    @staticmethod\n    def validate_sublist_types(sublists: List[List[Any]]) -> bool:\n        \"\"\"Ensures all elements within the sublists are integers.\"\"\"\n        for sublist in sublists:\n            for item in sublist:\n                if not isinstance(item, int):\n                    raise TypeError(\"All elements within sublists must be integers.\")\n        return True\n\n\nclass CommonElementFinder:\n    \"\"\"Handles the core logic for calculating the intersection of elements.\"\"\"\n\n    def calculate_intersection(self, lists: List[List[int]]) -> Set[int]:\n        \"\"\"Calculates the set of common elements across all provided sublists.\"\"\"\n        if not lists:\n            return set()\n        \n        common_elements = set(lists[0])\n        for i in range(1, len(lists)):\n            common_elements.intersection_update(set(lists[i]))\n        \n        return common_elements\n\n    def validate_common_elements(self, result: Set[int]) -> bool:\n        \"\"\"Performs a basic validation on the intersection result.\"\"\"\n        return isinstance(result, set)\n\n\ndef common_in_nested_lists(nested_lists: List[List[int]]) -> List[int]:\n    \"\"\"\n    Find common elements across all sublists in nested list structure.\n    Coordinates input validation and core intersection calculation.\n    \"\"\"\n    validator = InputValidator()\n    finder = CommonElementFinder()\n\n    # Perform input validation as per design\n    validator.validate_nested_lists(nested_lists)\n    validator.validate_sublist_types(nested_lists)\n\n    # Calculate the intersection of elements\n    common_elements_set = finder.calculate_intersection(nested_lists)\n    \n    # Validate the resulting set (as per design, though minimal in this context)\n    finder.validate_common_elements(common_elements_set)\n\n    # Convert the set of common elements to a list before returning\n    return list(common_elements_set)"}
