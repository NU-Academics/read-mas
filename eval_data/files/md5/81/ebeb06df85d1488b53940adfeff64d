{"task_id": "Mbpp/160", "solution": "```python\ndef gcd(a: int, b: int) -> int:\n    \"\"\"\n    Calculates the greatest common divisor of two integers.\n    Ensures a non-negative result.\n    \"\"\"\n    a, b = abs(a), abs(b)\n    while b:\n        a, b = b, a % b\n    return a\n\ndef extended_euclidean(a: int, b: int) -> tuple[int, int, int]:\n    \"\"\"\n    Implements the Extended Euclidean Algorithm.\n    Returns a tuple (g, x, y) such that ax + by = g, where g is gcd(a, b).\n    The sign of g matches the typical output of the recursive algorithm\n    (e.g., if a=0, g will have the sign of b). The caller should normalize g to be positive.\n    \"\"\"\n    if a == 0:\n        return b, 0, 1 # Base case: gcd(0, b) = b; 0*x + b*y = b implies x=0, y=1\n    \n    # Recursive step: g, x1, y1 for b % a and a\n    g, x1, y1 = extended_euclidean(b % a, a)\n    \n    # Calculate x and y for current a and b\n    x = y1 - (b // a) * x1\n    y = x1\n    \n    return g, x, y\n\ndef find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"\n    Finds integer solutions (x, y) for the linear Diophantine equation ax + by = n.\n    Returns (x, y) as a tuple if a solution exists, or None otherwise.\n    \"\"\"\n    # Handle the trivial case where both a and b are zero\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None # If n=0, any (x,y) is a solution; (0,0) is returned. If n!=0, no solution.\n\n    # Use the Extended Euclidean Algorithm to find g, x0, y0 such that a*x0 + b*y0 = g\n    # g will be the gcd(a, b), but its sign might vary based on implementation.\n    g, x0, y0 = extended_euclidean(a, b)\n\n    # Normalize g to be positive, and adjust x0, y0 accordingly\n    if g < 0:\n        g = -g\n        x0 = -x0\n        y0 = -y0\n    \n    # Check if n is divisible by g. If not, no integer solution exists.\n    if n % g != 0:\n        return None\n\n    # Scale the particular solution (x0, y0) to match n\n    # (n // g) is guaranteed to be an exact integer division here.\n    multiplier = n // g\n    \n    x_p = x0 * multiplier\n    y_p = y0 * multiplier\n\n    # Adjust the particular solution to a canonical form, typically where x is\n    # within the range [0, |b/g| - 1] (or similar) if b/g is not zero.\n    # This ensures a consistent output for the given assertion.\n    if b != 0:\n        b_div_g = b // g\n        \n        # Calculate k to shift x_p to the desired range (e.g., 0 <= x_final < abs(b_div_g))\n        # Python's % handles negative numbers such that x_p % b_div_g gives a result\n        # with the same sign as b_div_g. We want 0 <= x < abs(b_div_g).\n        \n        # If b_div_g is negative, result of % will be negative or 0.\n        # Adding b_div_g makes it positive. Then take % again.\n        x_canonical = (x_p % b_div_g + b_div_g) % b_div_g\n        \n        # Determine the k value used for this shift: x_final = x_p + k * (b/g)\n        k = (x_canonical - x_p) // b_div_g\n        \n        # Apply k to find the corresponding y\n        y_canonical = y_p - k * (a // g)\n        \n        return (x_canonical, y_canonical)\n    else: # If b is 0, the equation is ax = n. y can be anything, (x_p, y_p) is (n/a, 0).\n        return (x_p, y_p)\n\n```"}
{"task_id": "Mbpp/160", "solution": "```python\ndef find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"\n    Solves the linear Diophantine equation ax + by = n.\n    Returns a solution (x, y) if it exists, otherwise None.\n    \"\"\"\n\n    # Helper function to compute the greatest common divisor using Euclidean algorithm.\n    # It ensures the returned GCD is non-negative.\n    def gcd(num1: int, num2: int) -> int:\n        # Handle the special case where both numbers are zero, gcd(0,0) is typically 0.\n        if num1 == 0 and num2 == 0:\n            return 0\n        num1 = abs(num1)\n        num2 = abs(num2)\n        while num2:\n            num1, num2 = num2, num1 % num2\n        return num1\n\n    # Helper function for the Extended Euclidean Algorithm.\n    # Returns (g, x, y) such that a*x + b*y = g, where g is gcd(a, b).\n    # Ensures 'g' is always non-negative.\n    def extended_euclidean(num1: int, num2: int) -> tuple[int, int, int]:\n        if num1 == 0:\n            # Base case: gcd(0, num2) = |num2|.\n            # Equation becomes 0*x + num2*y = |num2|.\n            # If num2 is positive, y=1. If num2 is negative, y=-1. If num2 is 0, y=0.\n            return abs(num2), 0, (1 if num2 > 0 else -1 if num2 < 0 else 0)\n        \n        g, x1, y1 = extended_euclidean(num2 % num1, num1)\n        x = y1 - (num2 // num1) * x1\n        y = x1\n        return g, x, y\n\n    # Handle the specific case where a=0 and b=0.\n    # 0*x + 0*y = n. This means n must be 0 for a solution to exist.\n    # If n is 0, any (x,y) is a solution; we can return (0,0).\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n\n    # Calculate the greatest common divisor of a and b.\n    common_divisor = gcd(a, b) # gcd helper already takes abs\n\n    # If n is not divisible by the common_divisor, no integer solution exists.\n    if n % common_divisor != 0:\n        return None\n\n    # Use Extended Euclidean Algorithm to find a particular solution (x_base, y_base)\n    # for the equation a*x_base + b*y_base = common_divisor.\n    # The 'g_ee' returned here should be equal to 'common_divisor' due to our `extended_euclidean` definition.\n    g_ee, x_base, y_base = extended_euclidean(a, b)\n\n    # Scale the particular solution (x_base, y_base) to match the target 'n'.\n    # The scaling factor is n / common_divisor.\n    scale_factor = n // common_divisor\n    x_particular = x_base * scale_factor\n    y_particular = y_base * scale_factor\n\n    # Normalize the solution to find the smallest non-negative x, if b is non-zero.\n    # If b is zero, x is uniquely determined (if a!=0), and y can be any integer.\n    # In this case, `x_particular` already gives the correct x.\n    if b != 0:\n        # Determine the \"period\" for x, which is b / common_divisor.\n        b_reduced = b // common_divisor\n        \n        # Adjust x_particular to be in the range [0, abs(b_reduced) - 1].\n        # Python's % operator result has the same sign as the divisor (b_reduced).\n        # We want a non-negative x, so adjust if x_final is negative.\n        x_final = x_particular % b_reduced\n        if x_final < 0:\n            x_final += b_reduced\n        \n        # Calculate the 'k' factor by which (x_particular, y_particular) was shifted\n        # x_final = x_particular + k * b_reduced  =>  k = (x_final - x_particular) / b_reduced\n        k = (x_final - x_particular) // b_reduced\n        \n        # Adjust y_final accordingly, using the corresponding 'period' for y (a / common_divisor).\n        a_reduced = a // common_divisor\n        y_final = y_particular - k * a_reduced\n        \n        return (x_final, y_final)\n    else: # If b is 0, the equation is a*x = n. x = n/a.\n        # The `x_particular` calculated is already the correct x.\n        # `y_particular` is also correct for one specific solution.\n        return (x_particular, y_particular)\n\n```"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"Calculates the sum (n - 2*i) from i=0, adding terms while they are positive.\"\"\"\n    total_sum = 0\n    upper_bound = n // 2\n    for i in range(upper_bound + 1):\n        term = n - 2 * i\n        if term > 0:\n            total_sum += term\n        else:\n            # Terms are non-increasing; if one is <= 0, subsequent ones will also be.\n            break\n    return total_sum"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the series (n - 2*i) for i from 0 to n // 2,\n    stopping when a term becomes less than or equal to 0.\n    \"\"\"\n    total_sum = 0\n    for i in range(n // 2 + 1):\n        term = n - 2 * i\n        if term <= 0:\n            break\n        total_sum += term\n    return total_sum"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(input_string: str) -> int:\n    \"\"\"\n    Counts characters in a string that match their English alphabet position (case-insensitive).\n    Position 0 corresponds to 'a', 1 to 'b', and so on.\n    \"\"\"\n\n    class AlphabetMatcher:\n        \"\"\"Provides alphabet position mapping and validation.\"\"\"\n        def __init__(self):\n            self._alphabet = \"abcdefghijklmnopqrstuvwxyz\"\n\n        def get_alphabet_position(self, position: int) -> str | None:\n            \"\"\"Returns the alphabet character at the given 0-based position, or None if invalid.\"\"\"\n            if self.is_valid_position(position):\n                return self._alphabet[position]\n            return None\n\n        def is_valid_position(self, position: int) -> bool:\n            \"\"\"Validates if the position is within the alphabet range (0-25).\"\"\"\n            return 0 <= position < len(self._alphabet)\n\n    class PositionCounter:\n        \"\"\"Manages the match counting state.\"\"\"\n        def __init__(self):\n            self._match_count = 0\n\n        def increment_count(self) -> None:\n            \"\"\"Increments the match counter by one.\"\"\"\n            self._match_count += 1\n\n        def get_count(self) -> int:\n            \"\"\"Returns the current match count.\"\"\"\n            return self._match_count\n\n        def reset_count(self) -> None:\n            \"\"\"Resets the counter to zero.\"\"\"\n            self._match_count = 0\n\n    class StringProcessor:\n        \"\"\"Processes the input string and coordinates character position comparison.\"\"\"\n        def __init__(self, alphabet_matcher: AlphabetMatcher, position_counter: PositionCounter):\n            self._alphabet_matcher = alphabet_matcher\n            self._position_counter = position_counter\n\n        def process_string(self, input_string: str) -> int:\n            \"\"\"Processes the string and returns the final match count.\"\"\"\n            self._position_counter.reset_count()\n            for i, char in enumerate(input_string):\n                lowercase_char = self._convert_to_lowercase(char)\n                if self._compare_character_position(lowercase_char, i):\n                    self._position_counter.increment_count()\n            return self._position_counter.get_count()\n\n        def _convert_to_lowercase(self, char: str) -> str:\n            \"\"\"Converts a character to lowercase for comparison.\"\"\"\n            return char.lower()\n\n        def _compare_character_position(self, char: str, position: int) -> bool:\n            \"\"\"Compares a character at a given position with the expected alphabet character.\"\"\"\n            expected_char = self._alphabet_matcher.get_alphabet_position(position)\n            return expected_char is not None and char == expected_char\n\n    # Orchestrate the character counting process using the defined components.\n    alphabet_matcher = AlphabetMatcher()\n    position_counter = PositionCounter()\n    string_processor = StringProcessor(alphabet_matcher, position_counter)\n\n    return string_processor.process_string(input_string)"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(input_string: str) -> int:\n    \"\"\"\n    Counts characters in a string that match their English alphabet position (case-insensitive).\n    Compares characters in the input string to the alphabet positions 'a' at 0, 'b' at 1, etc.\n    \"\"\"\n    alphabet = \"abcdefghijklmnopqrstuvwxyz\"\n    match_count = 0\n\n    # Iterate through the input string with an index\n    for i, char in enumerate(input_string):\n        # Stop checking if the current position exceeds the alphabet's length (26 letters, 0-25)\n        if i >= len(alphabet):\n            break\n\n        # Normalize the character to lowercase for case-insensitive comparison\n        normalized_char = char.lower()\n\n        # Check if the normalized character is an English alphabet letter\n        if 'a' <= normalized_char <= 'z':\n            # Compare the character with the character at the same position in the alphabet\n            if normalized_char == alphabet[i]:\n                match_count += 1\n\n    return match_count"}
