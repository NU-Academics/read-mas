{"task_id": "Mbpp/123", "solution": "def amicable_numbers_sum(limit: int) -> int:\n    \"\"\"Calculate sum of all amicable numbers from 1 to limit (inclusive).\"\"\"\n\n    def get_proper_divisors(number: int) -> list[int]:\n        \"\"\"Get list of proper divisors of a number.\"\"\"\n        if number <= 1:\n            return []\n        divisors = [1]\n        for i in range(2, int(number**0.5) + 1):\n            if number % i == 0:\n                divisors.append(i)\n                if i * i != number:\n                    divisors.append(number // i)\n        return divisors\n\n    def sum_of_proper_divisors(number: int) -> int:\n        \"\"\"Calculate sum of proper divisors of a number.\"\"\"\n        return sum(get_proper_divisors(number))\n\n    amicable_numbers_found = set()\n    for n in range(1, limit + 1):\n        if n in amicable_numbers_found:\n            continue\n\n        sum_n = sum_of_proper_divisors(n)\n\n        # Check for amicable pair conditions:\n        # 1. sum_n must be different from n (a number is not amicable with itself).\n        # 2. sum_n must be within the limit for its proper divisors to be calculated.\n        # 3. The sum of proper divisors of sum_n must equal n.\n        if sum_n != n and sum_n <= limit:\n            sum_sum_n = sum_of_proper_divisors(sum_n)\n            if sum_sum_n == n:\n                amicable_numbers_found.add(n)\n                amicable_numbers_found.add(sum_n)\n    \n    return sum(amicable_numbers_found)"}
{"task_id": "Mbpp/125", "solution": "def find_length(binary_string: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the count of 0s and 1s in any substring.\n    Raises ValueError for invalid binary strings.\n    \"\"\"\n\n    def is_empty_string(s: str) -> bool:\n        \"\"\"Checks if a string is empty.\"\"\"\n        return len(s) == 0\n\n    def validate_binary_string(s: str) -> bool:\n        \"\"\"Validates if a string contains only '0' and '1' characters.\"\"\"\n        if is_empty_string(s):\n            return True # An empty string is considered valid but will return 0.\n        for char in s:\n            if char not in ('0', '1'):\n                return False\n        return True\n\n    def generate_all_substrings(s: str) -> list[str]:\n        \"\"\"Generates all possible substrings from the given string.\"\"\"\n        substrings = []\n        n = len(s)\n        for i in range(n):\n            for j in range(i, n):\n                substrings.append(s[i : j + 1])\n        return substrings\n\n    def count_zeros(s: str) -> int:\n        \"\"\"Counts the occurrences of '0' in a string.\"\"\"\n        return s.count('0')\n\n    def count_ones(s: str) -> int:\n        \"\"\"Counts the occurrences of '1' in a string.\"\"\"\n        return s.count('1')\n\n    def calculate_difference(s: str) -> int:\n        \"\"\"Calculates the absolute difference between counts of '0's and '1's.\"\"\"\n        zeros = count_zeros(s)\n        ones = count_ones(s)\n        return abs(zeros - ones)\n\n    def find_maximum_difference(differences: list[int]) -> int:\n        \"\"\"Finds the maximum value in a list of differences.\"\"\"\n        if not differences:\n            return 0\n        return max(differences)\n\n    # Main logic\n    if not validate_binary_string(binary_string):\n        raise ValueError(\"Invalid binary string\")\n\n    if is_empty_string(binary_string):\n        return 0\n\n    all_substrings = generate_all_substrings(binary_string)\n    all_differences = [calculate_difference(sub) for sub in all_substrings]\n\n    return find_maximum_difference(all_differences)"}
