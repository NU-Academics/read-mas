{"task_id": "Mbpp/453", "solution": "def sumofFactors(number: int) -> int:\n    \"\"\"\n    Calculate the sum of even factors for a given number.\n    \"\"\"\n\n    def _find_factors(num: int) -> list[int]:\n        \"\"\"Finds all factors of a given number.\"\"\"\n        factors = []\n        for i in range(1, num + 1):\n            if num % i == 0:\n                factors.append(i)\n        return factors\n\n    def _filter_even_factors(factors_list: list[int]) -> list[int]:\n        \"\"\"Filters a list of factors to include only even numbers.\"\"\"\n        return [f for f in factors_list if f % 2 == 0]\n\n    def _sum_factors(factors_list: list[int]) -> int:\n        \"\"\"Calculates the sum of a list of factors.\"\"\"\n        return sum(factors_list)\n\n    all_factors = _find_factors(number)\n    even_factors = _filter_even_factors(all_factors)\n    return _sum_factors(even_factors)"}
