{"task_id": "Mbpp/619", "solution": "def move_num(input_string: str) -> str:\n    \"\"\"\n    Move all numeric characters to the end of the string while preserving order.\n\n    Args:\n        input_string (str): Input string containing mixed characters\n\n    Returns:\n        str: String with numeric characters moved to end\n    \"\"\"\n    non_numeric_chars = []\n    numeric_chars = []\n\n    for char in input_string:\n        if '0' <= char <= '9':  # Check if character is a digit\n            numeric_chars.append(char)\n        else:\n            non_numeric_chars.append(char)\n\n    return \"\".join(non_numeric_chars) + \"\".join(numeric_chars)"}
{"task_id": "Mbpp/620", "solution": "from typing import List\n\ndef largest_subset(numbers: List[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset where every pair is divisible.\n    A pair (a, b) is valid if a is divisible by b or b is divisible by a.\n    \"\"\"\n\n    def is_divisible(a: int, b: int) -> bool:\n        \"\"\"Checks if integer a is divisible by integer b.\"\"\"\n        # Assuming b will not be 0 based on typical problem constraints and example.\n        return b != 0 and a % b == 0\n\n    def is_valid_pair(a: int, b: int) -> bool:\n        \"\"\"Checks if a pair (a, b) satisfies the divisibility constraint.\"\"\"\n        return is_divisible(a, b) or is_divisible(b, a)\n\n    def is_valid_subset(subset: List[int]) -> bool:\n        \"\"\"Validates if every pair in the subset satisfies the divisibility constraint.\"\"\"\n        n = len(subset)\n        if n <= 1:\n            return True\n\n        for i in range(n):\n            for j in range(i + 1, n):\n                if not is_valid_pair(subset[i], subset[j]):\n                    return False\n        return True\n\n    def generate_all_subsets(nums: List[int]) -> List[List[int]]:\n        \"\"\"Generates all possible subsets of a given list of numbers.\"\"\"\n        all_subsets = [[]]\n        for num in nums:\n            new_subsets = []\n            for subset in all_subsets:\n                new_subsets.append(subset + [num])\n            all_subsets.extend(new_subsets)\n        return all_subsets\n\n    max_size = 0\n    all_subsets = generate_all_subsets(numbers)\n\n    for subset in all_subsets:\n        if is_valid_subset(subset):\n            max_size = max(max_size, len(subset))\n\n    return max_size"}
{"task_id": "Mbpp/620", "solution": "def largest_subset(numbers):\n    def _is_divisible_by(dividend, divisor):\n        if divisor == 0:\n            return dividend == 0\n        return dividend % divisor == 0\n\n    def _is_pair_divisible(a, b):\n        return _is_divisible_by(a, b) or _is_divisible_by(b, a)\n\n    def _validate_subset(subset):\n        n = len(subset)\n        if n <= 1:\n            return True\n        for i in range(n):\n            for j in range(i + 1, n):\n                if not _is_pair_divisible(subset[i], subset[j]):\n                    return False\n        return True\n\n    if not numbers:\n        return 0\n\n    import itertools\n\n    max_size = 0\n    \n    # The design implies generating all subsets and then validating them.\n    # Iterate through subset sizes from largest to smallest for potential early exit\n    # if maximum size is found, but for this structure, we iterate all and find max.\n    for r in range(len(numbers) + 1):\n        for subset_tuple in itertools.combinations(numbers, r):\n            current_subset = list(subset_tuple)\n            if _validate_subset(current_subset):\n                max_size = max(max_size, len(current_subset))\n            \n    return max_size"}
{"task_id": "Mbpp/622", "solution": "def get_median(list1: list, list2: list, size: int) -> float:\n    \"\"\"\n    Finds the median of two sorted lists of the same size.\n    It uses a binary search approach to find the k-th elements efficiently.\n    \"\"\"\n\n    def find_kth_element(arr1: list, arr2: list, k: int) -> int:\n        \"\"\"\n        Finds the k-th smallest element (1-indexed) in two sorted arrays.\n        This helper function ensures the first array is shorter or equal in length\n        to simplify the binary search range logic.\n        \"\"\"\n        m, n = len(arr1), len(arr2)\n\n        # Ensure arr1 is the shorter list\n        if m > n:\n            return find_kth_element(arr2, arr1, k)\n\n        # Binary search for the number of elements to take from arr1 (idx1)\n        # idx1 can range from max(0, k-n) to min(k, m)\n        low = max(0, k - n)\n        high = min(k, m)\n\n        while low <= high:\n            idx1 = (low + high) // 2\n            idx2 = k - idx1\n\n            # Get the elements at the partition boundaries\n            # Use -infinity or +infinity for boundary conditions\n            left_arr1 = arr1[idx1 - 1] if idx1 > 0 else float('-inf')\n            right_arr1 = arr1[idx1] if idx1 < m else float('inf')\n\n            left_arr2 = arr2[idx2 - 1] if idx2 > 0 else float('-inf')\n            right_arr2 = arr2[idx2] if idx2 < n else float('inf')\n\n            # Check if the partition is correct\n            if left_arr1 <= right_arr2 and left_arr2 <= right_arr1:\n                return max(left_arr1, left_arr2)\n            elif left_arr1 > right_arr2:\n                # idx1 is too large, need fewer elements from arr1\n                high = idx1 - 1\n            else:  # left_arr2 > right_arr1\n                # idx1 is too small, need more elements from arr1\n                low = idx1 + 1\n        \n        # This point should theoretically not be reached with valid inputs and k.\n        # Returning -1 as a fallback, though a valid k will always be found.\n        return -1 \n\n    # For two lists of size 'size', the total number of elements is 2 * size.\n    # The median is the average of the (size)-th and (size+1)-th smallest elements\n    # (using 1-indexed k for find_kth_element).\n\n    median1 = find_kth_element(list1, list2, size)\n    median2 = find_kth_element(list1, list2, size + 1)\n\n    return (median1 + median2) / 2.0"}
