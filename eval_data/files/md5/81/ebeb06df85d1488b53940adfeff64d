{"task_id": "Mbpp/235", "solution": "def even_bit_set_number(number: int) -> int:\n    \"\"\"\n    Sets all even-positioned bits (0, 2, 4, etc.) of a given number to 1.\n    \"\"\"\n    # Create a mask with all even bits set to 1.\n    # 0x5555555555555555 is a 64-bit mask where every other bit starting from bit 0 is set.\n    # For example, in binary, it looks like ...0101010101010101.\n    even_bits_mask = 0x5555555555555555\n\n    # Apply the bitwise OR operation. This will set all even bits in 'number' to 1.\n    # If an even bit in 'number' is already 1, it remains 1. If it's 0, it becomes 1.\n    # Odd bits in 'number' are preserved as the mask has 0s at odd positions.\n    return number | even_bits_mask"}
{"task_id": "Mbpp/239", "solution": "def is_valid_next_element(current_value: int, next_value: int, max_value: int) -> bool:\n    \"\"\"Checks if next_value is valid based on current_value and max_value.\"\"\"\n    return next_value >= current_value * 2 and next_value <= max_value\n\ndef count_sequences_recursive(current_value: int, remaining_length: int, max_value: int) -> int:\n    \"\"\"Recursively counts sequences starting with current_value for the remaining length.\"\"\"\n    if remaining_length == 0:\n        return 1\n    \n    # If the smallest possible next element is already too large, no sequences can be formed.\n    if current_value * 2 > max_value:\n        return 0\n\n    count = 0\n    # Iterate through all possible next values that satisfy the constraints.\n    for next_val in range(current_value * 2, max_value + 1):\n        if is_valid_next_element(current_value, next_val, max_value):\n            count += count_sequences_recursive(next_val, remaining_length - 1, max_value)\n    return count\n\ndef validate_inputs(m: int, n: int) -> bool:\n    \"\"\"This function is included as per design, but its validation logic is omitted due to constraints.\"\"\"\n    return True\n\ndef get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Finds the number of possible sequences of length n, such that each element is\n    a positive integer and is greater than or equal to twice the previous element\n    but less than or equal to m.\n    \"\"\"\n    if not validate_inputs(m, n): # Call to validate_inputs as per design, even if stubbed.\n        return 0 # Should not be reached with the current validate_inputs stub.\n\n    total_count = 0\n    # Iterate through all possible starting values for the sequence.\n    for start_val in range(1, m + 1):\n        total_count += count_sequences_recursive(start_val, n - 1, m)\n    \n    return total_count"}
{"task_id": "Mbpp/239", "solution": "def get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Calculates the total number of valid sequences of length n,\n    where each element is a positive integer, greater than or equal to twice the previous, and less than or equal to m.\n    \"\"\"\n\n    def generate_sequences_recursive(current_sequence: list, remaining_length: int, max_value: int) -> int:\n        \"\"\"Recursively generates and counts valid sequences.\"\"\"\n        if remaining_length == 0:\n            return 1  # A complete valid sequence of length n has been formed.\n\n        total_count = 0\n        \n        # Determine the minimum possible value for the next element in the sequence.\n        if not current_sequence:  # If the sequence is empty, this is the first element.\n            start_val = 1\n        else:  # For subsequent elements, it must be at least twice the previous.\n            prev_val = current_sequence[-1]\n            start_val = prev_val * 2\n\n        # Iterate through all possible valid values for the current position.\n        # The value must be within [start_val, max_value].\n        for next_val in range(start_val, max_value + 1):\n            # Recursively call to build the rest of the sequence.\n            total_count += generate_sequences_recursive(\n                current_sequence + [next_val],  # Append the current valid element.\n                remaining_length - 1,           # One less element to find.\n                max_value                       # The maximum value constraint remains.\n            )\n        return total_count\n\n    # The main function initiates the recursive counting process.\n    # It starts with an empty sequence, the desired length 'n', and the maximum value 'm'.\n    return generate_sequences_recursive([], n, m)"}
