{"task_id": "Mbpp/4", "solution": "from typing import List, Union\nimport heapq\n\ndef _validate_input(numbers: List[Union[int, float]], n: int) -> bool:\n    \"\"\"Validate input parameters according to business rules.\n    Ensures n is positive and not greater than the list length.\n    \"\"\"\n    if n <= 0:\n        return False\n    if not numbers:\n        return False\n    if n > len(numbers):\n        return False\n    return True\n\ndef _find_largest_heap(numbers: List[Union[int, float]], n: int) -> List[Union[int, float]]:\n    \"\"\"Use heap algorithm to find n largest elements efficiently.\"\"\"\n    return heapq.nlargest(n, numbers)\n\ndef _sort_descending(elements: List[Union[int, float]]) -> List[Union[int, float]]:\n    \"\"\"Sort elements in descending order.\n    The heapq.nlargest function already returns elements in descending order.\n    \"\"\"\n    return elements\n\ndef heap_queue_largest(numbers: List[Union[int, float]], n: int) -> List[Union[int, float]]:\n    \"\"\"Find the n largest integers from a given list of numbers, returned in descending order.\"\"\"\n    if not _validate_input(numbers, n):\n        return []\n\n    largest_elements = _find_largest_heap(numbers, n)\n    result = _sort_descending(largest_elements)\n    return result"}
{"task_id": "Mbpp/2", "solution": "def similar_elements(collection1, collection2):\n    \"\"\"\n    Finds elements that are common to both given collections.\n    Returns a list of shared elements.\n    \"\"\"\n    shared = []\n    set2 = set(collection2)\n    for element in collection1:\n        if element in set2:\n            shared.append(element)\n    return shared"}
{"task_id": "Mbpp/4", "solution": "import heapq\n\ndef heap_queue_largest(numbers: list, n: int) -> list:\n    \"\"\"\n    Finds the n largest integers from a list using a min-heap, returned in descending order.\n    Handles edge cases like empty lists or non-positive n.\n    \"\"\"\n    if n <= 0 or not numbers:\n        return []\n\n    # heapq.nlargest directly returns the n largest elements in descending order.\n    # It also handles cases where n is larger than the list length,\n    # returning all elements in descending order.\n    return heapq.nlargest(n, numbers)"}
