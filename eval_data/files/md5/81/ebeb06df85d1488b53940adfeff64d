{"task_id": "Mbpp/100", "solution": "def reverse_digits(num: int) -> int:\n    \"\"\"Reverses the digits of an integer. Handles positive integers.\"\"\"\n    reversed_num = 0\n    while num > 0:\n        digit = num % 10\n        reversed_num = reversed_num * 10 + digit\n        num //= 10\n    return reversed_num\n\ndef is_palindrome(num: int) -> bool:\n    \"\"\"Checks if a positive integer is a palindrome.\"\"\"\n    if num < 0:\n        return False\n    return num == reverse_digits(num)\n\ndef increment_to_next_palindrome(start_num: int) -> int:\n    \"\"\"Finds the next palindrome starting from a given number.\"\"\"\n    current_num = start_num\n    while True:\n        if is_palindrome(current_num):\n            return current_num\n        current_num += 1\n\ndef next_smallest_palindrome(n: int) -> int:\n    \"\"\"Finds the next smallest palindrome of a specified integer, returned as an integer.\"\"\"\n    # The search for the next palindrome begins from n + 1.\n    return increment_to_next_palindrome(n + 1)"}
{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome greater than a specified integer.\n    It repeatedly increments the number until a palindrome is found.\n    \"\"\"\n\n    def reverse_number(num: int) -> int:\n        \"\"\"Returns the reversed digit sequence of a given number.\"\"\"\n        reversed_num = 0\n        original_num = num\n        while num > 0:\n            digit = num % 10\n            reversed_num = reversed_num * 10 + digit\n            num //= 10\n        return reversed_num\n\n    def is_palindrome(num: int) -> bool:\n        \"\"\"Checks if a number reads the same forwards and backwards.\"\"\"\n        return num == reverse_number(num)\n\n    current_num = n + 1\n    while True:\n        if is_palindrome(current_num):\n            return current_num\n        current_num += 1"}
