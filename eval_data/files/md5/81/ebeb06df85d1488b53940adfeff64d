{"task_id": "Mbpp/615", "solution": "def average_tuple(input_tuples: tuple) -> list:\n    \"\"\"\n    Calculate arithmetic mean for each tuple in input and return as list.\n    Averages are calculated for each inner tuple independently.\n    \"\"\"\n    averages = []\n    for inner_tuple in input_tuples:\n        # Calculate the sum of elements and the count for the current inner tuple.\n        # It's assumed that inner_tuple will contain numeric values and will not be empty.\n        average = sum(inner_tuple) / len(inner_tuple)\n        averages.append(average)\n    return averages"}
{"task_id": "Mbpp/615", "solution": "def average_tuple(tuple_of_tuples: tuple) -> list:\n    \"\"\"\n    Calculates the average value for each corresponding position across all inner tuples.\n    Returns the averages as an ordered list of floats.\n    \"\"\"\n\n    class TupleProcessor:\n        # Responsible for computing the average of a single sequence of numbers.\n        def compute_average(self, values: tuple) -> float:\n            # Handles cases where a column might be empty if the input tuple_of_tuples is empty.\n            if not values:\n                return 0.0\n            return sum(values) / len(values)\n\n    class ResultFormatter:\n        # Responsible for ensuring results are in a list and order is maintained.\n        def format_as_list(self, averages: list) -> list:\n            return averages\n\n        def maintain_order(self, results: list) -> list:\n            return results\n\n    processor = TupleProcessor()\n    formatter = ResultFormatter()\n    calculated_averages = []\n\n    # Transpose the tuple of tuples to process elements at corresponding positions (columns).\n    transposed_columns = zip(*tuple_of_tuples)\n\n    for column_values in transposed_columns:\n        average = processor.compute_average(column_values)\n        calculated_averages.append(average)\n\n    # Format and maintain order of the results, which is naturally handled by list appends.\n    final_result = formatter.format_as_list(calculated_averages)\n\n    return final_result"}
