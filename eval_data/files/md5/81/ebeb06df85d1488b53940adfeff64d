{"task_id": "Mbpp/299", "solution": "```python\nimport collections\n\ndef max_aggregate(tuple_list: list) -> tuple:\n    \"\"\"\n    Calculates the maximum aggregate value from a list of (name, value) tuples.\n    It sums values for identical names and returns the name with the highest total.\n    \"\"\"\n    aggregated_data = collections.defaultdict(int)\n    \n    for name, value in tuple_list:\n        aggregated_data[name] += value\n            \n    if not aggregated_data:\n        # If the input list was empty, return a default for no aggregates found.\n        return (None, 0)\n    \n    # Find the key-value pair with the maximum value using the item's second element.\n    max_name, max_value = max(aggregated_data.items(), key=lambda item: item[1])\n    \n    return (max_name, max_value)\n```"}
{"task_id": "Mbpp/299", "solution": "def max_aggregate(tuple_list):\n    \"\"\"\n    Calculates the maximum aggregate sum for names from a list of (name, value) tuples.\n    Returns the name with the highest sum and its total sum.\n    \"\"\"\n    aggregates = {}\n    for name, value in tuple_list:\n        aggregates[name] = aggregates.get(name, 0) + value\n\n    max_name = None\n    max_sum = float('-inf')\n\n    for name, total_sum in aggregates.items():\n        if total_sum > max_sum:\n            max_sum = total_sum\n            max_name = name\n\n    return (max_name, max_sum)"}
{"task_id": "Mbpp/300", "solution": "import math\n\ndef count_binary_seq(n: int) -> float:\n    \"\"\"\n    Calculates the count of binary sequences of length 2n where the sum of the first\n    n bits equals the sum of the last n bits.\n    \"\"\"\n    total_count = 0\n    for k in range(n + 1):\n        # Calculate C(n, k) and square it, then sum up\n        total_count += math.comb(n, k) ** 2\n    return float(total_count)"}
{"task_id": "Mbpp/300", "solution": "import math\n\ndef count_binary_seq(n: int) -> float:\n    \"\"\"\n    Counts binary sequences of length 2n such that the sum of the first n bits\n    is the same as the sum of the last n bits.\n    This count is given by the central binomial coefficient (2n)Cn.\n    \"\"\"\n    result = math.comb(2 * n, n)\n    return float(result)"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(dictionary: dict) -> int:\n    \"\"\"\n    Calculates the maximum nesting depth of a dictionary.\n    Each level of dictionary nesting counts as one depth unit, starting from 1.\n    \"\"\"\n\n    def _traverse_recursive(obj, current_depth):\n        max_found_depth = current_depth\n        for value in obj.values():\n            if isinstance(value, dict):\n                max_found_depth = max(max_found_depth, _traverse_recursive(value, current_depth + 1))\n        return max_found_depth\n\n    if not dictionary:\n        return 1\n\n    return _traverse_recursive(dictionary, 1)"}
{"task_id": "Mbpp/305", "solution": "def start_withp(word_list: list) -> tuple:\n    \"\"\"\n    Returns two words from a list of words that start with the letter 'p' (case-insensitive for the first letter).\n    Words are extracted from space-separated strings within the input list.\n    \"\"\"\n    found_words = []\n    for item_string in word_list:\n        words = item_string.split(' ')\n        for word in words:\n            if word and (word.startswith('p') or word.startswith('P')):\n                found_words.append(word)\n                if len(found_words) == 2:\n                    return tuple(found_words)\n    return tuple(found_words) # In case fewer than two words are found (though context implies two will always be found)"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(dictionary: dict) -> int:\n    \"\"\"\n    Calculates the maximum depth of nested dictionaries within a given dictionary.\n    The depth of an empty dictionary or a flat dictionary is considered 1.\n    \"\"\"\n    if not isinstance(dictionary, dict):\n        return 0 # Or handle as an error/edge case, but for dicts, this path shouldn't be hit with valid input.\n\n    max_depth = 1\n    for value in dictionary.values():\n        if isinstance(value, dict):\n            # For each nested dictionary, calculate its depth and add 1 for the current level.\n            max_depth = max(max_depth, 1 + dict_depth(value))\n    return max_depth"}
{"task_id": "Mbpp/305", "solution": "def start_withp(word_list: list) -> tuple:\n    \"\"\"\n    Return two words from a list of words starting with letter 'P'.\n    Filters for words that begin with 'P' (case-sensitive) and returns the first two found.\n    \"\"\"\n    found_words = []\n    for s in word_list:\n        words = s.split()\n        for word in words:\n            if word.startswith('P'):\n                found_words.append(word)\n                if len(found_words) == 2:\n                    return (found_words[0], found_words[1])\n    return (found_words[0], found_words[1]) # This line assumes there will always be at least two words, based on the problem description."}
{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(array: list[int], length: int, i: int, k: int) -> int:\n    \"\"\"Finds the maximum sum of an increasing subsequence from a prefix until index i,\n    including the element at index k (where k > i).\n    \"\"\"\n    # Validate input indices and constraints.\n    # Return 0 if indices are out of bounds or k is not greater than i.\n    if not (0 <= i < length and 0 <= k < length and k > i):\n        return 0\n\n    # dp[p] stores the maximum sum of an increasing subsequence ending with array[p],\n    # considering elements from array[0...p].\n    dp = [0] * (i + 1)\n\n    # Compute DP values for the prefix up to index i.\n    for p in range(i + 1):\n        dp[p] = array[p]  # Initialize with the element itself\n        for q in range(p):\n            if array[p] > array[q]:\n                dp[p] = max(dp[p], dp[q] + array[p])\n\n    # Find the maximum sum from dp[p] where array[p] is less than array[k].\n    # This represents the optimal increasing prefix subsequence that can precede array[k].\n    max_prefix_sum = 0  # Initialize with 0 to allow for an empty prefix (if no valid elements are found)\n\n    for p in range(i + 1):\n        if array[p] < array[k]:\n            max_prefix_sum = max(max_prefix_sum, dp[p])\n\n    # The total maximum sum is the best prefix sum found, plus the required element array[k].\n    # If max_prefix_sum is 0, it implies no element in array[0...i] could be an increasing\n    # predecessor to array[k], so the subsequence effectively starts with array[k].\n    return max_prefix_sum + array[k]"}
{"task_id": "Mbpp/308", "solution": "from typing import List, Union\n\ndef _calculate_all_products(list1: List[Union[int, float]], list2: List[Union[int, float]]) -> List[int]:\n    \"\"\"Calculates all possible products from elements of two lists.\n    Returns a list of integer products.\n    \"\"\"\n    all_products = []\n    for num1 in list1:\n        for num2 in list2:\n            all_products.append(int(num1 * num2))\n    return all_products\n\ndef _sort_and_select(products: List[int], count: int) -> List[int]:\n    \"\"\"Sorts products in descending order and selects the top 'count' elements.\"\"\"\n    products.sort(reverse=True)\n    return products[:count]\n\ndef large_product(list1: List[Union[int, float]], list2: List[Union[int, float]], count: int) -> List[int]:\n    \"\"\"\n    Finds the specified number of largest products from two given lists,\n    selecting one factor from each list.\n    \"\"\"\n    all_products = _calculate_all_products(list1, list2)\n    largest_products = _sort_and_select(all_products, count)\n    return largest_products"}
