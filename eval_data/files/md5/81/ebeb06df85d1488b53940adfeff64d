{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(n: int) -> int:\n    \"\"\"\n    Sets the leftmost unset bit in the binary representation of the input integer.\n    This operation effectively finds the first 0-bit from the most significant end and changes it to 1.\n    \"\"\"\n\n    def _find_leftmost_unset_bit_position(val: int) -> int:\n        \"\"\"Helper to find the 0-indexed position of the leftmost unset bit.\"\"\"\n        num_bits = val.bit_length()\n\n        # Handle the case of n=0 separately, where the 0th bit is the leftmost unset.\n        if num_bits == 0 and val == 0:\n            return 0\n\n        # Iterate from the most significant bit downwards to find the first unset bit.\n        for i in range(num_bits - 1, -1, -1):\n            if not ((val >> i) & 1):  # If the i-th bit is 0\n                return i\n        \n        # If all bits up to num_bits-1 are set, the leftmost unset bit is at position num_bits.\n        return num_bits\n\n    def _set_bit_at_position(val: int, position: int) -> int:\n        \"\"\"Helper to set a bit to 1 at a specific 0-indexed position.\"\"\"\n        return val | (1 << position)\n\n    position_to_set = _find_leftmost_unset_bit_position(n)\n    result = _set_bit_at_position(n, position_to_set)\n    \n    return result"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the highest power of 2 that is less than or equal to n.\n    Assumes n is a positive integer.\n    \"\"\"\n    res = 1\n    while res <= n // 2:\n        res <<= 1\n    return res"}
{"task_id": "Mbpp/389", "solution": "def find_lucas(n: int) -> int:\n    \"\"\"\n    Calculates the n'th Lucas number using an iterative approach.\n    Assumes n is a non-negative integer.\n    \"\"\"\n    if n == 0:\n        return 2\n    if n == 1:\n        return 1\n\n    a, b = 2, 1  # L(0) and L(1)\n    for _ in range(2, n + 1):\n        a, b = b, a + b\n    return b"}
{"task_id": "Mbpp/388", "solution": "```python\ndef highest_Power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the highest power of 2 that is less than or equal to n.\n    This works for non-negative integers n.\n    \"\"\"\n    if n == 0:\n        return 0\n    # n.bit_length() returns the number of bits required to represent n in binary.\n    # Shifting 1 left by (bit_length - 1) gives the highest power of 2.\n    return 1 << (n.bit_length() - 1)\n```"}
{"task_id": "Mbpp/389", "solution": "def find_lucas(n):\n    \"\"\"\n    Finds the n'th Lucas number using an iterative approach.\n    The sequence starts with L(0)=2 and L(1)=1.\n    \"\"\"\n    if n == 0:\n        return 2\n    if n == 1:\n        return 1\n\n    a, b = 2, 1  # Initialize with L(0) and L(1)\n    for _ in range(2, n + 1):\n        next_lucas = a + b\n        a = b\n        b = next_lucas\n    return b"}
