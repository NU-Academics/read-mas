{"task_id": "Mbpp/608", "solution": "def bell_Number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Bell number using the Bell triangle method.\n    The Bell numbers count the number of partitions of a set with n elements.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    # Initialize the first row of the Bell triangle.\n    # The first element is always 1, representing B(0).\n    bell_row = [1]\n\n    for i in range(1, n + 1):\n        # The first element of the new row is the last element of the previous row.\n        next_row = [bell_row[-1]]\n        # Each subsequent element is the sum of the element above it and the element to its left in the current row.\n        for j in range(len(bell_row)):\n            next_row.append(next_row[-1] + bell_row[j])\n        bell_row = next_row\n\n    # The nth Bell number is the first element of the nth row (0-indexed).\n    return bell_row[0]"}
{"task_id": "Mbpp/607", "solution": "import re\nfrom typing import Optional, Tuple\n\ndef find_literals(text: str, pattern: str) -> Optional[Tuple[str, int, int]]:\n    \"\"\"\n    Search for regex pattern in text and return match with indices.\n\n    Args:\n        text: Input string to search\n        pattern: Regex pattern to find\n\n    Returns:\n        Tuple of (substring, start_index, end_index) if match found, None otherwise\n    \"\"\"\n    match = re.search(pattern, text)\n    if match:\n        return (match.group(0), match.start(), match.end())\n    return None"}
{"task_id": "Mbpp/608", "solution": "def bell_Number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Bell number using a dynamic programming approach\n    based on the Bell triangle.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    # `bell_triangle_row` stores the elements of the current row being constructed.\n    # The first element of this row after `i` iterations will be the i-th Bell number.\n    bell_triangle_row = [1]\n\n    # Iterate `n` times to build the triangle up to the nth row\n    for _ in range(1, n + 1):\n        # The first element of the next row is the last element of the current row.\n        # This corresponds to T[i][0] = T[i-1][i-1] in the Bell triangle definition.\n        next_row = [bell_triangle_row[-1]]\n\n        # Populate the rest of the next row using the recurrence T[i][j] = T[i][j-1] + T[i-1][j-1].\n        # Here, next_row[j] refers to T[i][j-1] and bell_triangle_row[j] refers to T[i-1][j-1].\n        for j in range(len(bell_triangle_row)):\n            next_row.append(next_row[j] + bell_triangle_row[j])\n\n        bell_triangle_row = next_row\n\n    # The nth Bell number is the first element of the `n`-th row constructed.\n    return bell_triangle_row[0]"}
{"task_id": "Mbpp/607", "solution": "import re\n\ndef find_literals(input_string: str, pattern: str) -> tuple:\n    \"\"\"\n    Searches a string for the first occurrence of a regex pattern.\n    Returns the matching substring, its start index, and end index as a tuple, or None if no match is found.\n    \"\"\"\n    compiled_pattern = re.compile(pattern)\n    match_obj = compiled_pattern.search(input_string)\n\n    if match_obj:\n        return (match_obj.group(0), match_obj.start(), match_obj.end())\n    else:\n        return None"}
{"task_id": "Mbpp/610", "solution": "def remove_kth_element(input_list: list, k: int) -> list:\n    \"\"\"\n    Returns a new list with the k'th element removed, using 1-based indexing for k.\n    The original list remains unchanged.\n    \"\"\"\n    # Convert the 1-based index k to a 0-based index.\n    zero_based_index = k - 1\n\n    # Create a new list by concatenating slices before and after the element to be removed.\n    # This ensures immutability of the original list.\n    return input_list[:zero_based_index] + input_list[zero_based_index + 1:]"}
