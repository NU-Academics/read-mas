{"task_id": "Mbpp/555", "solution": "def difference(n: int) -> int:\n    \"\"\"\n    Calculate the difference between sum of cubes and sum of natural numbers.\n    It uses formulas for efficient calculation.\n    \"\"\"\n    sum_of_numbers = n * (n + 1) // 2\n    sum_of_cubes = sum_of_numbers ** 2\n    return sum_of_cubes - sum_of_numbers"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(array: list, size: int) -> int:\n    \"\"\"\n    Counts pairs of elements in an array whose XOR value is odd.\n    An XOR value is odd if and only if one operand is odd and the other is even.\n    \"\"\"\n    odd_count = 0\n    even_count = 0\n\n    for num in array:\n        if num % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return odd_count * even_count"}
{"task_id": "Mbpp/555", "solution": "def difference(n: int) -> int:\n    \"\"\"\n    Calculates the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers.\n    \"\"\"\n    def sum_of_naturals(k: int) -> int:\n        \"\"\"Calculates the sum of the first k natural numbers.\"\"\"\n        return k * (k + 1) // 2\n\n    def sum_of_cubes(k: int) -> int:\n        \"\"\"Calculates the sum of cubes of the first k natural numbers.\"\"\"\n        sum_nat = sum_of_naturals(k)\n        return sum_nat * sum_nat\n\n    sum_cubes = sum_of_cubes(n)\n    sum_naturals = sum_of_naturals(n)\n\n    return sum_cubes - sum_naturals"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(array, size):\n    \"\"\"\n    Counts the number of pairs in an array whose XOR value is odd.\n    A pair's XOR value is odd if one number is odd and the other is even.\n    \"\"\"\n\n    def _is_odd(number):\n        \"\"\"Determines if a given number is odd.\"\"\"\n        return number % 2 != 0\n\n    def _calculate_xor(a, b):\n        \"\"\"Calculates the bitwise XOR of two integers.\"\"\"\n        return a ^ b\n\n    def _generate_pairs(arr, arr_size):\n        \"\"\"Generates all unique pairs from an array.\"\"\"\n        for i in range(arr_size):\n            for j in range(i + 1, arr_size):\n                yield arr[i], arr[j]\n\n    odd_xor_count = 0\n    for num1, num2 in _generate_pairs(array, size):\n        xor_result = _calculate_xor(num1, num2)\n        if _is_odd(xor_result):\n            odd_xor_count += 1\n            \n    return odd_xor_count"}
