{"task_id": "Mbpp/3", "solution": "def is_not_prime(number: int) -> bool:\n    \"\"\"\n    Determines if a number is non-prime.\n\n    Args:\n        number: Integer to test for non-primality\n\n    Returns:\n        False if number is prime, True if number is non-prime\n    \"\"\"\n    if number <= 1:\n        return True  # Numbers less than or equal to 1 are not prime\n    if number == 2:\n        return False # 2 is a prime number\n    if number % 2 == 0:\n        return True  # Even numbers greater than 2 are not prime\n\n    # Check for odd divisors from 3 up to the square root of the number\n    i = 3\n    while i * i <= number:\n        if number % i == 0:\n            return True  # Found a divisor, so it's not prime\n        i += 2  # Increment by 2 to check only odd numbers\n    return False # No divisors found, so the number is prime"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(num1, num2):\n    \"\"\"\n    Checks if two numbers differ at exactly one bit position.\n    \"\"\"\n    xor_result = num1 ^ num2\n    count = 0\n    while xor_result > 0:\n        xor_result &= (xor_result - 1)\n        count += 1\n    return count == 1"}
{"task_id": "Mbpp/3", "solution": "def is_not_prime(number: int) -> bool:\n    \"\"\"\n    Identifies if a number is not prime (composite).\n    Returns True for non-prime numbers and False for prime numbers.\n    \"\"\"\n    if number <= 1:\n        return True  # Numbers less than or equal to 1 are not prime.\n    if number == 2:\n        return False # 2 is prime.\n    if number % 2 == 0:\n        return True  # Even numbers greater than 2 are not prime.\n\n    # Check for odd divisors from 3 up to the square root of the number.\n    i = 3\n    while i * i <= number:\n        if number % i == 0:\n            return True  # Found a divisor, so it's not prime.\n        i += 2\n    return False # No divisors found, so it's prime."}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(num1: int, num2: int) -> bool:\n    \"\"\"\n    Checks if two numbers differ at exactly one bit position.\n    This is determined by XORing the numbers and counting the set bits in the result.\n    \"\"\"\n    xor_result = num1 ^ num2\n    \n    # Count the number of set bits in the XOR result (Brian Kernighan's algorithm)\n    count = 0\n    while xor_result > 0:\n        xor_result &= (xor_result - 1) # Clear the least significant set bit\n        count += 1\n        \n    return count == 1"}
