{"task_id": "Mbpp/721", "solution": "class Cell:\n    \"\"\"Represents a single cell in the matrix with its position and cost.\"\"\"\n    def __init__(self, row, column, cost):\n        self.row = row\n        self.column = column\n        self.cost = float(cost)\n\n    def get_row(self):\n        return self.row\n\n    def get_column(self):\n        return self.column\n\n    def get_cost(self):\n        return self.cost\n\nclass Matrix:\n    \"\"\"Stores and manages the matrix data, providing access to cells.\"\"\"\n    def __init__(self, matrix_data):\n        self.size = len(matrix_data)\n        self.cells = [[None for _ in range(self.size)] for _ in range(self.size)]\n        for r in range(self.size):\n            for c in range(self.size):\n                self.cells[r][c] = Cell(r, c, matrix_data[r][c])\n\n    def get_cell(self, row, col):\n        return self.cells[row][col]\n\n    def get_size(self):\n        return self.size\n\nclass Path:\n    \"\"\"Represents a sequence of cells forming a path and calculates its metrics.\"\"\"\n    def __init__(self):\n        self.cells = []\n        self.total_cost = 0.0\n        self.length = 0\n\n    def add_cell(self, cell):\n        self.cells.append(cell)\n        self.total_cost += cell.get_cost()\n        self.length += 1\n\n    def get_total_cost(self):\n        return self.total_cost\n\n    def get_length(self):\n        return self.length\n\n    def calculate_average(self):\n        if self.length == 0:\n            return 0.0\n        return self.total_cost / self.length\n\nclass PathFinder:\n    \"\"\"Generates all valid paths from top-left to bottom-right in a matrix.\"\"\"\n    def __init__(self, matrix):\n        self.matrix = matrix\n\n    def find_all_paths(self):\n        all_paths = []\n        start_cell = self.matrix.get_cell(0, 0)\n        initial_path = Path()\n        initial_path.add_cell(start_cell)\n        self._generate_paths_recursive(0, 0, initial_path, all_paths)\n        return all_paths\n\n    def _generate_paths_recursive(self, row, col, current_path, all_paths):\n        if row == self.matrix.get_size() - 1 and col == self.matrix.get_size() - 1:\n            all_paths.append(current_path)\n            return\n\n        # Move right\n        if self.is_valid_move(row, col + 1):\n            next_cell = self.matrix.get_cell(row, col + 1)\n            new_path = Path()\n            new_path.cells.extend(current_path.cells)\n            new_path.total_cost = current_path.total_cost\n            new_path.length = current_path.length\n            new_path.add_cell(next_cell)\n            self._generate_paths_recursive(row, col + 1, new_path, all_paths)\n\n        # Move down\n        if self.is_valid_move(row + 1, col):\n            next_cell = self.matrix.get_cell(row + 1, col)\n            new_path = Path()\n            new_path.cells.extend(current_path.cells)\n            new_path.total_cost = current_path.total_cost\n            new_path.length = current_path.length\n            new_path.add_cell(next_cell)\n            self._generate_paths_recursive(row + 1, col, new_path, all_paths)\n\n    def is_valid_move(self, row, col):\n        return 0 <= row < self.matrix.get_size() and \\\n               0 <= col < self.matrix.get_size()\n\nclass AverageCalculator:\n    \"\"\"A utility class to find the maximum average among a list of paths.\"\"\"\n    def find_maximum_average(self, paths):\n        max_avg = -float('inf')\n        for path in paths:\n            current_avg = path.calculate_average()\n            if current_avg > max_avg:\n                max_avg = current_avg\n        return max_avg\n\ndef maxAverageOfPath(matrix):\n    \"\"\"\n    Finds a path with the maximum average cost in a square matrix.\n    Paths start top-left, move right or down, and end bottom-right.\n    \"\"\"\n    matrix_obj = Matrix(matrix)\n    path_finder = PathFinder(matrix_obj)\n    all_paths = path_finder.find_all_paths()\n\n    average_calculator = AverageCalculator()\n    max_average = average_calculator.find_maximum_average(all_paths)\n\n    return max_average"}
