{"task_id": "Mbpp/579", "solution": "from typing import Tuple, Set, Any\n\ndef find_dissimilar(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"Find elements that exist in one tuple but not in both.\n    Returns a sorted tuple of dissimilar elements.\"\"\"\n\n    def _get_unique_elements(source_set: Set[Any], compare_set: Set[Any]) -> Set[Any]:\n        \"\"\"Return elements in source_set that are not in compare_set.\"\"\"\n        return source_set - compare_set\n\n    def _combine_and_sort(set1: Set[Any], set2: Set[Any]) -> Tuple[Any, ...]:\n        \"\"\"Combine two sets and return as sorted tuple for deterministic output.\"\"\"\n        combined_set = set1.union(set2)\n        return tuple(sorted(list(combined_set)))\n\n    set1 = set(tuple1)\n    set2 = set(tuple2)\n\n    unique_from_first = _get_unique_elements(set1, set2)\n    unique_from_second = _get_unique_elements(set2, set1)\n\n    result_tuple = _combine_and_sort(unique_from_first, unique_from_second)\n\n    return result_tuple"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1, tuple2):\n    \"\"\"\n    Finds elements present in only one of the two given tuples.\n    Returns a tuple of these dissimilar elements, sorted in ascending order.\n    \"\"\"\n    set1 = set(tuple1)\n    set2 = set(tuple2)\n    dissimilar_elements = set1.symmetric_difference(set2)\n    return tuple(sorted(list(dissimilar_elements)))"}
{"task_id": "Mbpp/581", "solution": "import math\n\ndef surface_Area(base_edge: float, height: float) -> float:\n    \"\"\"\n    Calculates the surface area of a square pyramid.\n    Assumes 'height' refers to the slant height of the pyramid to match the given assertion.\n    \"\"\"\n    base_area = base_edge * base_edge\n    # For the given assertion (3,4) -> 33, 'height' must represent the slant height.\n    # Area of one triangular face = 0.5 * base_edge * slant_height\n    triangular_face_area = 0.5 * base_edge * height\n    lateral_surface_area = 4 * triangular_face_area\n    total_surface_area = base_area + lateral_surface_area\n    return total_surface_area"}
{"task_id": "Mbpp/583", "solution": "def catalan_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Catalan number using the formula C(n) = (2n)! / ((n+1)! * n!).\n    A helper function for factorial calculation is used internally.\n    \"\"\"\n\n    def factorial(k: int) -> int:\n        \"\"\"Calculates the factorial of a non-negative integer k.\"\"\"\n        if k == 0:\n            return 1\n        result = 1\n        for i in range(1, k + 1):\n            result *= i\n        return result\n\n    numerator = factorial(2 * n)\n    denominator = factorial(n + 1) * factorial(n)\n    return numerator // denominator"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple: tuple) -> tuple:\n    # Helper to determine if an element is an even integer.\n    def _is_even_integer(element) -> bool:\n        return isinstance(element, int) and element % 2 == 0\n\n    # Helper to recursively process an element or nested tuple.\n    def _process_element(element):\n        if isinstance(element, int):\n            # If an integer, keep only if it's even.\n            return element if _is_even_integer(element) else None\n        elif isinstance(element, tuple):\n            # If a tuple, process its elements recursively.\n            processed_sub_elements = []\n            for item in element:\n                processed_item = _process_element(item)\n                if processed_item is not None:\n                    processed_sub_elements.append(processed_item)\n            return tuple(processed_sub_elements)\n        else:\n            # If neither an integer nor a tuple, keep it as is.\n            return element\n\n    result_elements = []\n    for item in input_tuple:\n        processed_item = _process_element(item)\n        if processed_item is not None:\n            result_elements.append(processed_item)\n\n    return tuple(result_elements)"}
{"task_id": "Mbpp/583", "solution": "def catalan_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Catalan number using the formula C(n) = (2n)! / ((n+1)! * n!).\n    This function includes an inline factorial helper.\n    \"\"\"\n    def factorial(k: int) -> int:\n        \"\"\"Computes the factorial of a non-negative integer k.\"\"\"\n        res = 1\n        for i in range(1, k + 1):\n            res *= i\n        return res\n\n    fact_2n = factorial(2 * n)\n    fact_n_plus_1 = factorial(n + 1)\n    fact_n = factorial(n)\n\n    catalan = fact_2n // (fact_n_plus_1 * fact_n)\n    return catalan"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Removes odd integer elements from a nested mixed tuple while preserving its structure.\n    Non-integer elements are preserved as is.\n    \"\"\"\n\n    def _is_even(number: int) -> bool:\n        \"\"\"Determines if an integer is even.\"\"\"\n        return number % 2 == 0\n\n    def _process_element(element):\n        \"\"\"\n        Recursively processes an element. Filters odd integers and reconstructs tuples.\n        \"\"\"\n        if isinstance(element, int):\n            if _is_even(element):\n                return element\n            return None  # Odd integers are filtered out by returning None.\n        elif isinstance(element, tuple):\n            processed_sub_elements = []\n            for item in element:\n                processed_item = _process_element(item)\n                if processed_item is not None:\n                    processed_sub_elements.append(processed_item)\n            return tuple(processed_sub_elements)\n        else:\n            # If the element is not an int or a tuple, it's preserved as is.\n            return element\n\n    return _process_element(input_tuple)"}
{"task_id": "Mbpp/581", "solution": "import math\n\ndef surface_Area(baseEdge: float, height: float) -> float:\n    \"\"\"\n    Calculate the surface area of a square pyramid.\n    The area is derived using geometric formulas for base and lateral faces.\n    \"\"\"\n    # Calculate the area of the square base\n    base_area = baseEdge * baseEdge\n\n    # Calculate half of the base edge, needed for slant height\n    half_base_edge = baseEdge / 2.0\n\n    # Calculate the slant height using the Pythagorean theorem\n    # l = sqrt(height^2 + (half_base_edge)^2)\n    slant_height = math.sqrt(height**2 + half_base_edge**2)\n\n    # Calculate the area of one triangular lateral face (0.5 * base * slant_height)\n    triangular_face_area = 0.5 * baseEdge * slant_height\n\n    # The total surface area is the base area plus the area of four triangular faces\n    total_surface_area = base_area + 4 * triangular_face_area\n\n    return total_surface_area"}
