{"task_id": "Mbpp/643", "solution": "def is_alphabetic(char: str) -> bool:\n    \"\"\"Checks if a single character is alphabetic.\"\"\"\n    return char.isalpha()\n\ndef extract_words(text: str) -> list[str]:\n    \"\"\"Extracts sequences of alphabetic characters as words from the input text.\"\"\"\n    words = []\n    current_word_chars = []\n    for char in text:\n        if is_alphabetic(char):\n            current_word_chars.append(char)\n        else:\n            if current_word_chars:\n                words.append(\"\".join(current_word_chars))\n                current_word_chars = []\n    if current_word_chars:\n        words.append(\"\".join(current_word_chars))\n    return words\n\ndef check_middle_position(word: str) -> bool:\n    \"\"\"Verifies if 'z' appears in middle positions of a word.\"\"\"\n    if len(word) < 3:\n        return False\n    for i in range(1, len(word) - 1):\n        if word[i] == 'z':\n            return True\n    return False\n\ndef has_middle_z(word: str) -> bool:\n    \"\"\"Checks if a word contains 'z' in its middle position.\"\"\"\n    return check_middle_position(word)\n\ndef text_match_wordz_middle(input_string: str) -> bool:\n    \"\"\"\n    Checks if the input string contains 'z' in the middle of any word.\n    'z' must not be at the start or end of a word to count.\n    \"\"\"\n    words = extract_words(input_string)\n    for word in words:\n        if has_middle_z(word):\n            return True\n    return False"}
{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(array: list, k: int) -> list:\n    \"\"\"Reverses elements in an array from index 0 up to a given position k (exclusive).\"\"\"\n    \n    reversed_prefix = array[:k][::-1]\n    remaining_suffix = array[k:]\n    return reversed_prefix + remaining_suffix"}
{"task_id": "Mbpp/643", "solution": "def text_match_wordz_middle(input_string: str) -> bool:\n    \"\"\"\n    Checks if a string contains 'z' in the middle of any word, excluding start and end positions.\n    \"\"\"\n    import string\n\n    def _is_word_boundary(char: str) -> bool:\n        \"\"\"Determines if a character is a word boundary.\"\"\"\n        return char in string.whitespace or char in string.punctuation\n\n    def _parse_words(s: str) -> list[str]:\n        \"\"\"Parses an input string into a list of words.\"\"\"\n        words = []\n        current_word_chars = []\n        for char in s:\n            if _is_word_boundary(char):\n                if current_word_chars:\n                    words.append(\"\".join(current_word_chars))\n                    current_word_chars = []\n            else:\n                current_word_chars.append(char)\n        if current_word_chars:  # Add the last word if string doesn't end with a boundary\n            words.append(\"\".join(current_word_chars))\n        return words\n\n    def _has_middle_z(word: str) -> bool:\n        \"\"\"Checks if a word contains 'z' at any position other than its start or end.\"\"\"\n        if len(word) < 3:  # A 'z' cannot be in the middle of words with less than 3 characters\n            return False\n        for i in range(1, len(word) - 1):  # Iterate from second char to second-to-last char\n            if word[i] == 'z':\n                return True\n        return False\n\n    words = _parse_words(input_string)\n    for word in words:\n        if _has_middle_z(word):\n            return True\n    return False"}
