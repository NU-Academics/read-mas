{"task_id": "Mbpp/61", "solution": "def count_Substrings(s: str) -> int:\n    \"\"\"\n    Count substrings where the sum of their digits equals their length.\n    Iterates through all substrings and checks the condition.\n    \"\"\"\n    n = len(s)\n    count = 0\n\n    for i in range(n):\n        current_sum = 0\n        for j in range(i, n):\n            # Add the current digit to the running sum\n            current_sum += int(s[j])\n            # Calculate the length of the current substring s[i...j]\n            substring_length = j - i + 1\n\n            # Check if the sum of digits equals the substring length\n            if current_sum == substring_length:\n                count += 1\n    return count"}
{"task_id": "Mbpp/61", "solution": "def count_Substrings(s: str) -> int:\n    \"\"\"\n    Count substrings where sum of digits equals substring length.\n    \"\"\"\n\n    def calculate_digit_sum(substring: str) -> int:\n        \"\"\"Calculate sum of digits in substring.\"\"\"\n        return sum(int(char) for char in substring)\n\n    def is_valid_substring(substring: str) -> bool:\n        \"\"\"Check if substring digit sum equals its length.\"\"\"\n        return calculate_digit_sum(substring) == len(substring)\n\n    def generate_substrings(s: str):\n        \"\"\"Generate all possible substrings from input string.\"\"\"\n        n = len(s)\n        for i in range(n):\n            for j in range(i, n):\n                yield s[i : j + 1]\n\n    count = 0\n    for substring in generate_substrings(s):\n        if is_valid_substring(substring):\n            count += 1\n    return count"}
