{"task_id": "Mbpp/453", "solution": "def sumofFactors(number: int) -> int:\n    \"\"\"\n    Calculates the sum of all even factors of a given number.\n    It orchestrates finding factors, filtering even ones, and summing them up.\n    \"\"\"\n\n    def _calculate_factors(n: int) -> list[int]:\n        \"\"\"Finds all factors of a given number.\"\"\"\n        factors = []\n        for i in range(1, n + 1):\n            if n % i == 0:\n                factors.append(i)\n        return factors\n\n    def _filter_even_factors(factors_list: list[int]) -> list[int]:\n        \"\"\"Filters a list of numbers, keeping only the even ones.\"\"\"\n        even_factors = []\n        for factor in factors_list:\n            if factor % 2 == 0:\n                even_factors.append(factor)\n        return even_factors\n\n    def _sum_factors(numbers_list: list[int]) -> int:\n        \"\"\"Calculates the sum of numbers in a list.\"\"\"\n        return sum(numbers_list)\n\n    all_factors = _calculate_factors(number)\n    even_factors_only = _filter_even_factors(all_factors)\n    total_sum_of_even_factors = _sum_factors(even_factors_only)\n\n    return total_sum_of_even_factors"}
{"task_id": "Mbpp/454", "solution": "def text_match_wordz(input_string: str) -> bool:\n    \"\"\"\n    Checks if any word in the input string contains the character 'z'.\n    Punctuation marks are treated as word separators.\n    \"\"\"\n    def _parse_words(text: str) -> list[str]:\n        words = []\n        current_word = []\n        for char in text:\n            if char.isalnum():\n                current_word.append(char)\n            else:\n                if current_word:\n                    words.append(\"\".join(current_word))\n                    current_word = []\n        if current_word:\n            words.append(\"\".join(current_word))\n        return words\n\n    def _contains_z(word: str) -> bool:\n        return 'z' in word\n\n    words = _parse_words(input_string)\n    for word in words:\n        if _contains_z(word):\n            return True\n    return False"}
{"task_id": "Mbpp/454", "solution": "import re\nfrom typing import List\n\ndef parse_words(input_string: str) -> List[str]:\n    \"\"\"Helper function to split string into words using punctuation separators.\"\"\"\n    return re.findall(r'\\b\\w+\\b', input_string)\n\ndef contains_z(word: str) -> bool:\n    \"\"\"Helper function to check if word contains 'z' (case-sensitive).\"\"\"\n    return 'z' in word\n\ndef text_match_wordz(input_string: str) -> bool:\n    \"\"\"Main function that matches a word containing 'z'.\"\"\"\n    words = parse_words(input_string)\n    for word in words:\n        if contains_z(word):\n            return True\n    return False"}
