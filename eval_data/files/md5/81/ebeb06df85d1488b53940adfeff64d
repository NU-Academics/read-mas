{"task_id": "Mbpp/440", "solution": "_PUNCTUATION_CHARS = \"!\\\"#$%&'()*+,-./:;<=>?@[\\\\]^_`{|}~\"\n\ndef _clean_word(word: str) -> str:\n    \"\"\"\n    Removes leading and trailing punctuation from a word.\n    \"\"\"\n    if not word:\n        return \"\"\n\n    start_idx = 0\n    while start_idx < len(word) and word[start_idx] in _PUNCTUATION_CHARS:\n        start_idx += 1\n\n    end_idx = len(word) - 1\n    while end_idx >= start_idx and word[end_idx] in _PUNCTUATION_CHARS:\n        end_idx -= 1\n\n    return word[start_idx : end_idx + 1]\n\ndef _is_adverb(word: str) -> bool:\n    \"\"\"\n    Determines if a word is an adverb based on a simplified rule (ends with 'ly').\n    \"\"\"\n    cleaned_lower = word.lower()\n    return cleaned_lower.endswith('ly') and len(cleaned_lower) > 2\n\ndef _tokenize_sentence(sentence: str) -> list[tuple[str, int, int]]:\n    \"\"\"\n    Splits the sentence into tokens (words and attached punctuation), tracking their positions.\n    Tokens are separated by whitespace.\n    \"\"\"\n    words_data = []\n    current_token_start = -1\n    \n    for i, char in enumerate(sentence):\n        if not char.isspace():\n            if current_token_start == -1:\n                current_token_start = i\n        else: # It's whitespace\n            if current_token_start != -1:\n                token_text = sentence[current_token_start:i]\n                words_data.append((token_text, current_token_start, i))\n                current_token_start = -1\n    \n    # Handle the last token if sentence doesn't end with whitespace\n    if current_token_start != -1:\n        token_text = sentence[current_token_start:len(sentence)]\n        words_data.append((token_text, current_token_start, len(sentence)))\n    \n    return words_data\n\ndef _calculate_adverb_positions(original_word_token: str, token_start_in_sentence: int, cleaned_adverb_text: str) -> tuple[int, int]:\n    \"\"\"\n    Calculates the exact start and end positions of the cleaned adverb within the sentence.\n    \"\"\"\n    relative_start_offset = 0\n    while relative_start_offset < len(original_word_token) and \\\n          original_word_token[relative_start_offset] in _PUNCTUATION_CHARS:\n        relative_start_offset += 1\n    \n    adverb_start_pos = token_start_in_sentence + relative_start_offset\n    adverb_end_pos = adverb_start_pos + len(cleaned_adverb_text)\n    \n    return (adverb_start_pos, adverb_end_pos)\n\ndef find_adverb_position(sentence: str) -> tuple:\n    \"\"\"\n    Finds the first adverb and its positions in a given sentence.\n    Returns a tuple (start_position, end_position, adverb_text) or None if not found.\n    \"\"\"\n    if not sentence:\n        return None\n\n    words_data = _tokenize_sentence(sentence)\n\n    for original_word_token, token_start_in_sentence, _ in words_data:\n        cleaned_word = _clean_word(original_word_token)\n        if _is_adverb(cleaned_word):\n            start_pos, end_pos = _calculate_adverb_positions(original_word_token, token_start_in_sentence, cleaned_word)\n            return (start_pos, end_pos, cleaned_word)\n\n    return None"}
{"task_id": "Mbpp/445", "solution": "def index_multiplication(tuple1, tuple2):\n    \"\"\"\n    Performs index-wise multiplication of tuple elements, handling nested tuples recursively.\n    The function iterates through corresponding elements and multiplies them, preserving the original structure.\n    \"\"\"\n    result = []\n    for item1, item2 in zip(tuple1, tuple2):\n        if isinstance(item1, tuple) and isinstance(item2, tuple):\n            result.append(index_multiplication(item1, item2))\n        else:\n            result.append(item1 * item2)\n    return tuple(result)"}
{"task_id": "Mbpp/445", "solution": "def index_multiplication(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Performs index-wise multiplication of elements from two given tuples containing nested tuples.\n    It iterates through corresponding nested tuples and multiplies their elements at each position.\n    \"\"\"\n    result_list = []\n    for inner_tuple1, inner_tuple2 in zip(tuple1, tuple2):\n        multiplied_pair = (inner_tuple1[0] * inner_tuple2[0], inner_tuple1[1] * inner_tuple2[1])\n        result_list.append(multiplied_pair)\n    return tuple(result_list)"}
