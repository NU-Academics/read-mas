{"task_id": "Mbpp/92", "solution": "def is_undulating(number: int) -> bool:\n    \"\"\"Checks if a positive integer is an undulating number.\n\n    An undulating number alternates between exactly two different digits and has at least 3 digits.\n    \"\"\"\n    s_number = str(number)\n    \n    # Check for minimum 3 digits\n    if len(s_number) < 3:\n        return False\n\n    digits = [int(d) for d in s_number]\n\n    # Check for exactly two distinct digits\n    distinct_digits = set(digits)\n    if len(distinct_digits) != 2:\n        return False\n\n    # Check that the first two digits are different (necessary for alternation)\n    if digits[0] == digits[1]:\n        return False\n\n    # Verify the alternating pattern (digit[i] must be equal to digit[i-2])\n    for i in range(2, len(digits)):\n        if digits[i] != digits[i - 2]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/92", "solution": "def is_undulating(number: int) -> bool:\n    \"\"\"\n    Checks if a number is undulating, meaning it alternates between exactly two different digits.\n    The number must have at least two digits.\n    \"\"\"\n    s = str(number)\n\n    if len(s) < 2:\n        return False\n\n    digit1 = s[0]\n    digit2 = None\n\n    # Find the second distinct digit\n    for i in range(1, len(s)):\n        if s[i] != digit1:\n            digit2 = s[i]\n            break\n\n    # If all digits are the same (e.g., 11111), it's not undulating\n    if digit2 is None:\n        return False\n\n    # Check the alternating pattern using digit1 and digit2\n    for i in range(len(s)):\n        if i % 2 == 0:  # Even index should match digit1\n            if s[i] != digit1:\n                return False\n        else:  # Odd index should match digit2\n            if s[i] != digit2:\n                return False\n\n    return True"}
