{"task_id": "Mbpp/757", "solution": "def count_reverse_pairs(strings: list[str]) -> int:\n    \"\"\"\n    Counts the number of reverse string pairs in the given list of strings.\n    A pair (str1, str2) is counted if str1 is the reverse of str2.\n    \"\"\"\n    def _reverse_string(s: str) -> str:\n        \"\"\"Reverses a given string.\"\"\"\n        return s[::-1]\n\n    def _is_reverse_pair(str1: str, str2: str) -> bool:\n        \"\"\"Checks if two strings are reverse of each other.\"\"\"\n        return str1 == _reverse_string(str2)\n\n    pair_count = 0\n    n = len(strings)\n\n    # Iterate through all unique pairs of strings\n    for i in range(n):\n        for j in range(i + 1, n):\n            if _is_reverse_pair(strings[i], strings[j]):\n                pair_count += 1\n    \n    return pair_count"}
{"task_id": "Mbpp/759", "solution": "def is_decimal(s: str) -> bool:\n    \"\"\"Checks if a string is a decimal number with exactly 2 decimal places.\"\"\"\n    if not s:\n        return False\n\n    # Handle optional leading negative sign\n    if s[0] == '-':\n        s = s[1:]\n        if not s:  # String was just \"-\"\n            return False\n\n    # Split into integer and fractional parts based on the decimal point\n    parts = s.split('.')\n\n    # Must have exactly two parts (one decimal point)\n    if len(parts) != 2:\n        return False\n\n    integer_part, fractional_part = parts[0], parts[1]\n\n    # Validate the integer part\n    if not integer_part or not integer_part.isdigit():\n        return False\n\n    # Validate the fractional part\n    # It must not be empty, must have exactly 2 digits, and all digits must be numeric\n    if not fractional_part or len(fractional_part) != 2 or not fractional_part.isdigit():\n        return False\n\n    return True"}
{"task_id": "Mbpp/757", "solution": "from typing import List\n\ndef reverse_string(s: str) -> str:\n    \"\"\"Return the reverse of the input string.\"\"\"\n    return s[::-1]\n\ndef is_reverse_pair(str1: str, str2: str) -> bool:\n    \"\"\"Check if two strings form a reverse pair.\"\"\"\n    return str1 == reverse_string(str2)\n\ndef is_empty_list(strings: List[str]) -> bool:\n    \"\"\"Check if the input list is empty.\"\"\"\n    return len(strings) == 0\n\ndef is_single_element(strings: List[str]) -> bool:\n    \"\"\"Check if the input list has exactly one element.\"\"\"\n    return len(strings) == 1\n\ndef validate_input(strings: List[str]) -> bool:\n    \"\"\"Validate that input list can be processed.\"\"\"\n    return not (is_empty_list(strings) or is_single_element(strings))\n\ndef count_reverse_pairs(strings: List[str]) -> int:\n    \"\"\"Count pairs of reverse strings in the given list.\"\"\"\n    if not validate_input(strings):\n        return 0\n\n    count = 0\n    num_strings = len(strings)\n    for i in range(num_strings):\n        for j in range(i + 1, num_strings):\n            if is_reverse_pair(strings[i], strings[j]):\n                count += 1\n    return count"}
