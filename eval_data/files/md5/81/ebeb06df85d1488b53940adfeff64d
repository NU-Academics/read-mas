{"task_id": "Mbpp/765", "solution": "def findNthPoliteNumber(n: int) -> int:\n    \"\"\"\n    Finds the nth polite number.\n    A polite number is a positive integer that can be expressed as the sum of two or more consecutive positive integers, excluding powers of 2.\n    \"\"\"\n\n    def isPowerOfTwo(num: int) -> bool:\n        \"\"\"\n        Checks if a given number is a power of 2.\n        \"\"\"\n        return num > 0 and (num & (num - 1)) == 0\n\n    def canBeExpressedAsConsecutiveSum(num: int) -> bool:\n        \"\"\"\n        Verifies if a number can be expressed as the sum of two or more consecutive integers.\n        This is true if and only if the number has an odd factor greater than 1.\n        \"\"\"\n        # Divide out all factors of 2\n        while num > 0 and num % 2 == 0:\n            num //= 2\n        # If the remaining number is greater than 1, it has an odd factor > 1\n        return num > 1\n\n    def isPoliteNumber(num: int) -> bool:\n        \"\"\"\n        Determines if a number is polite by checking if it can be expressed as a consecutive sum\n        and is not a power of two.\n        \"\"\"\n        return canBeExpressedAsConsecutiveSum(num) and not isPowerOfTwo(num)\n\n    polite_count = 0\n    current_number = 1\n    while True:\n        if isPoliteNumber(current_number):\n            polite_count += 1\n            if polite_count == n:\n                return current_number\n        current_number += 1"}
{"task_id": "Mbpp/765", "solution": "def is_polite(n: int) -> int:\n    \"\"\"\n    Finds the nth polite number. A polite number is a positive integer\n    that is not a power of 2.\n    \"\"\"\n    polite_count = 0\n    current_num = 1\n\n    # Iterate through positive integers to find the nth polite number.\n    while True:\n        # A number is polite if it's not a power of 2.\n        # A positive integer x is a power of 2 if (x & (x - 1)) == 0.\n        # Thus, it's polite if (x & (x - 1)) != 0.\n        if (current_num & (current_num - 1)) != 0:\n            polite_count += 1\n            if polite_count == n:\n                return current_num\n        current_num += 1"}
{"task_id": "Mbpp/767", "solution": "def get_pairs_count(numbers: list, target_sum: int) -> int:\n    \"\"\"\n    Counts the number of pairs in a list whose sum equals the target sum.\n    Each index position is treated as unique, even for duplicate elements.\n    \"\"\"\n    count = 0\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if numbers[i] + numbers[j] == target_sum:\n                count += 1\n    return count"}
