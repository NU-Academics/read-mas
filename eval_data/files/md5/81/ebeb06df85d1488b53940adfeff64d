{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(number: int) -> int:\n    \"\"\"Calculates the last digit of the factorial of the given number. Returns the last digit as an integer (0-9).\"\"\"\n    if number < 5:\n        factorial = 1\n        for i in range(1, number + 1):\n            factorial *= i\n        return factorial % 10\n    else:\n        # For numbers 5 and greater, the factorial will always end in 0.\n        return 0"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(number: int) -> int:\n    \"\"\"Calculates the last digit of the factorial of a given number.\"\"\"\n    if number < 0:\n        # Factorial is not defined for negative numbers,\n        # but the problem implies positive or zero input.\n        # For this problem, we'll assume valid non-negative input.\n        pass\n\n    if number == 0:\n        return 1\n\n    factorial = 1\n    for i in range(1, number + 1):\n        factorial *= i\n        # Optimization: for numbers >= 5, factorial ends in 0.\n        # We only care about the last digit.\n        # Once factorial becomes large, multiplying by i and taking modulo 10\n        # at each step or after a certain point might seem like an optimization\n        # but for getting the *true* last digit of the full factorial,\n        # we need to keep track of enough information.\n        # However, for N >= 5, N! ends in 0. So any result for N >= 5 will be 0.\n        # This simplifies things.\n\n        # If we reach 5, the last digit will always be 0 from now on.\n        # This is a key property of factorials.\n        if i >= 5:\n            return 0 # All factorials of 5 and above end in 0.\n\n    return factorial % 10"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(main_list, sub_list):\n    \"\"\"\n    Checks if sub_list is a contiguous sublist of main_list.\n    Returns True if sub_list is found, False otherwise.\n    \"\"\"\n    n = len(main_list)\n    m = len(sub_list)\n\n    if m == 0:\n        return True  # An empty list is always a sublist.\n    if m > n:\n        return False # A sublist cannot be longer than the main list.\n\n    for i in range(n - m + 1):\n        if main_list[i:i + m] == sub_list:\n            return True\n            \n    return False"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(main_list, sub_list) -> bool:\n    \"\"\"\n    Checks if `sub_list` is a contiguous sublist of `main_list`.\n    Returns True if found, False otherwise.\n    \"\"\"\n    len_main = len(main_list)\n    len_sub = len(sub_list)\n\n    if len_sub == 0:\n        return True  # An empty list is always a sublist.\n    if len_sub > len_main:\n        return False # A sublist cannot be longer than the main list.\n\n    for i in range(len_main - len_sub + 1):\n        if main_list[i : i + len_sub] == sub_list:\n            return True\n\n    return False"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(list1, list2, list3):\n    \"\"\"\n    Interleave three lists of equal length into a single flat list.\n    Elements are interleaved in the pattern: first[i], second[i], third[i].\n    \"\"\"\n    result = []\n    for i in range(len(list1)):\n        result.append(list1[i])\n        result.append(list2[i])\n        result.append(list3[i])\n    return result"}
