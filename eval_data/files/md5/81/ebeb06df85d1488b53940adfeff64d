{"task_id": "Mbpp/731", "solution": "import math\n\ndef lateralsurface_cone(r: float, h: float) -> float:\n    \"\"\"Calculate the lateral surface area of a cone given radius r and height h.\"\"\"\n    slant_height = math.sqrt(r**2 + h**2)\n    lateral_surface_area = math.pi * r * slant_height\n    return lateral_surface_area"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(array: list[int], target: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a given number in a sorted array using binary search.\n    Returns the index or -1 if the target is not found.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n    first_occurrence_index = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == target:\n            first_occurrence_index = mid\n            high = mid - 1  # Try to find an even earlier occurrence in the left half\n        elif array[mid] < target:\n            low = mid + 1\n        else:  # array[mid] > target\n            high = mid - 1\n\n    return first_occurrence_index"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(lst: list) -> int:\n    \"\"\"\n    Calculates the sum of products of all possible contiguous sublists of a given list.\n    This implementation follows the assertion sum_Of_Subarray_Prod([1,2,3]) == 20.\n    \"\"\"\n\n    def _calculate_product(sublist: list) -> int:\n        \"\"\"Calculates the product of all elements in a given sublist.\"\"\"\n        product = 1\n        for x in sublist:\n            product *= x\n        return product\n\n    def _generate_all_sublists(input_list: list) -> list:\n        \"\"\"Generates all contiguous sublists of a given list.\"\"\"\n        all_sublists = []\n        n = len(input_list)\n        for i in range(n):\n            for j in range(i, n):\n                all_sublists.append(input_list[i : j + 1])\n        return all_sublists\n\n    total_sum_of_products = 0\n    all_sublists = _generate_all_sublists(lst)\n\n    for sublist in all_sublists:\n        total_sum_of_products += _calculate_product(sublist)\n\n    return total_sum_of_products"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(input_list: list) -> int:\n    \"\"\"\n    Calculates the sum of products of all possible contiguous sublists of a given list.\n    \"\"\"\n    total_sum = 0\n    n = len(input_list)\n\n    for i in range(n):\n        current_product = 1\n        for j in range(i, n):\n            current_product *= input_list[j]\n            total_sum += current_product\n\n    return total_sum"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(number: int) -> int:\n    \"\"\"\n    Toggles all bits of the number except the most significant (first) and least significant (last) bits.\n    For numbers with 0, 1, or 2 bits, there are no middle bits to toggle.\n    \"\"\"\n    # Determine the number of bits required to represent the number.\n    # For example, 9 (binary 1001) has a bit_length of 4.\n    bit_length = number.bit_length()\n\n    # Create a mask where only the middle bits are set to 1.\n    # If the number has 0, 1, or 2 bits, there are no \"middle\" bits, so the mask is 0.\n    if bit_length <= 2:\n        middle_bits_mask = 0\n    else:\n        # A sequence of (bit_length - 2) ones is created (e.g., for bit_length=4, (4-2)=2 ones -> 0b11).\n        # This sequence is then shifted left by 1 to position it correctly, skipping the LSB.\n        # Example: bit_length=4 => ((1 << (4 - 2)) - 1) << 1\n        #        => ((1 << 2) - 1) << 1\n        #        => (4 - 1) << 1\n        #        => 3 << 1 = 6 (binary 0110), which targets the bits at positions 1 and 2.\n        middle_bits_mask = ((1 << (bit_length - 2)) - 1) << 1\n\n    # Toggle the middle bits by performing a bitwise XOR operation with the generated mask.\n    # Bits corresponding to 1s in the mask will be flipped, while others remain unchanged.\n    return number ^ middle_bits_mask"}
