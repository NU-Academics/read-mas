{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"Calculate the nth Jacobsthal number iteratively.\n    Uses the recurrence relation J(n) = J(n-1) + 2*J(n-2) with base cases J(0)=0 and J(1)=1.\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n\n    a, b = 0, 1  # J(0), J(1)\n    for _ in range(2, n + 1):\n        c = b + 2 * a\n        a = b\n        b = c\n    return b"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"Calculate the nth Jacobsthal number using an iterative approach.\n\n    Handles base cases for n=0 and n=1, and uses the recurrence relation J(n) = J(n-1) + 2*J(n-2) for n >= 2.\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n\n    a, b = 0, 1  # J(0), J(1)\n    for _ in range(2, n + 1):\n        # J(k) = J(k-1) + 2*J(k-2)\n        a, b = b, b + 2 * a\n    return b"}
{"task_id": "Mbpp/755", "solution": "def second_smallest(input_list):\n    \"\"\"\n    Finds the second smallest unique number in a list of numbers.\n    This function assumes the input list will yield at least two unique numerical elements after processing.\n    \"\"\"\n    unique_numbers = list(set(input_list))\n    unique_numbers.sort()\n    return unique_numbers[1]"}
{"task_id": "Mbpp/755", "solution": "def _validate_input(numbers: list) -> bool:\n    \"\"\"Validates that input is a list.\n    No exceptions are raised due to explicit constraints.\"\"\"\n    # Assuming valid list type as per type hint and constraints.\n    return True\n\ndef _remove_duplicates(numbers: list) -> list:\n    \"\"\"Removes duplicate values from the input list.\n    Converts to a set for uniqueness, then back to a list.\"\"\"\n    return list(set(numbers))\n\ndef _sort_numbers(numbers: list) -> list:\n    \"\"\"Sorts the list of numbers in ascending order.\n    Uses Python's built-in sorted() function.\"\"\"\n    return sorted(numbers)\n\ndef _extract_second_smallest(sorted_numbers: list) -> int:\n    \"\"\"Extracts the second element from a sorted list.\n    Assumes the list has at least two elements; an IndexError will occur otherwise.\"\"\"\n    return sorted_numbers[1]\n\ndef second_smallest(numbers):\n    \"\"\"Finds the second smallest unique number in a list.\n    Orchestrates validation, duplicate removal, sorting, and extraction.\"\"\"\n    _validate_input(numbers) # Call the no-op validator\n\n    unique_numbers = _remove_duplicates(numbers)\n    sorted_unique_numbers = _sort_numbers(unique_numbers)\n    \n    # The design implies handling edge cases with fewer than 2 unique elements.\n    # As per instructions, no explicit exceptions are raised. If len(sorted_unique_numbers) < 2,\n    # _extract_second_smallest will result in an IndexError, which is a natural consequence.\n    \n    return _extract_second_smallest(sorted_unique_numbers)"}
