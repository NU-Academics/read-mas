{"task_id": "Mbpp/635", "solution": "def heap_sort(input_list: list) -> list:\n    \"\"\"\n    Sorts a list in ascending order using the heap sort algorithm.\n    Returns a new sorted list without modifying the original.\n    \"\"\"\n    if not input_list:\n        return []\n\n    arr = list(input_list)\n    n = len(arr)\n\n    # Helper function to maintain the max-heap property\n    def _heapify(arr, n, i):\n        largest = i\n        left = 2 * i + 1\n        right = 2 * i + 2\n\n        if left < n and arr[left] > arr[largest]:\n            largest = left\n\n        if right < n and arr[right] > arr[largest]:\n            largest = right\n\n        if largest != i:\n            arr[i], arr[largest] = arr[largest], arr[i]\n            _heapify(arr, n, largest)\n\n    # Helper function to build a max-heap from an array\n    def _build_max_heap(arr):\n        n = len(arr)\n        # Start from the last non-leaf node and heapify upwards\n        for i in range(n // 2 - 1, -1, -1):\n            _heapify(arr, n, i)\n\n    # Build a max-heap\n    _build_max_heap(arr)\n\n    # Extract elements one by one from the heap\n    for i in range(n - 1, 0, -1):\n        # Move current root to end\n        arr[i], arr[0] = arr[0], arr[i]\n        # Call _heapify on the reduced heap\n        _heapify(arr, i, 0)\n\n    return arr"}
{"task_id": "Mbpp/635", "solution": "def heap_sort(input_list: list) -> list:\n    \"\"\"\n    Sorts a list of integers using the heap sort algorithm in ascending order.\n    Returns a new sorted list, preserving the original input list.\n    \"\"\"\n\n    def _swap(arr: list, i: int, j: int) -> None:\n        \"\"\"Swaps two elements in the array at indices i and j.\"\"\"\n        arr[i], arr[j] = arr[j], arr[i]\n\n    def _heapify(arr: list, n: int, i: int) -> None:\n        \"\"\"Maintains the max-heap property for a subtree rooted at index i.\"\"\"\n        largest = i\n        left = 2 * i + 1\n        right = 2 * i + 2\n\n        if left < n and arr[left] > arr[largest]:\n            largest = left\n\n        if right < n and arr[right] > arr[largest]:\n            largest = right\n\n        if largest != i:\n            _swap(arr, i, largest)\n            _heapify(arr, n, largest)\n\n    def _build_max_heap(arr: list) -> None:\n        \"\"\"Builds a max heap from the input array.\"\"\"\n        n = len(arr)\n        # Start from the last non-leaf node and go up to the root\n        for i in range(n // 2 - 1, -1, -1):\n            _heapify(arr, n, i)\n\n    n = len(input_list)\n    if n == 0:\n        return []\n\n    # Create a copy to avoid modifying the original list\n    arr = list(input_list)\n\n    # Build a max heap\n    _build_max_heap(arr)\n\n    # Extract elements one by one from the heap\n    for i in range(n - 1, 0, -1):\n        # Move current root to end\n        _swap(arr, 0, i)\n        # call max heapify on the reduced heap\n        _heapify(arr, i, 0)\n\n    return arr"}
