{"task_id": "Mbpp/283", "solution": "def validate(number: int) -> bool:\n    \"\"\"\n    Checks if the frequency of each digit in an integer is less than or equal to the digit itself.\n    This function processes the absolute value of the input number.\n    \"\"\"\n\n    def _count_digit_frequencies(num_val: int) -> dict[int, int]:\n        \"\"\"Counts the frequency of each digit in the integer by converting it to a string.\n        It uses the absolute value of the number to handle signs consistently.\"\"\"\n        frequencies = {}\n        s_num = str(abs(num_val))\n        for char_digit in s_num:\n            digit = int(char_digit)\n            frequencies[digit] = frequencies.get(digit, 0) + 1\n        return frequencies\n\n    def _compare_frequencies(frequencies_map: dict[int, int]) -> bool:\n        \"\"\"Compares each digit's frequency to the digit value.\n        Returns False if any frequency exceeds its corresponding digit, True otherwise.\"\"\"\n        for digit, count in frequencies_map.items():\n            if count > digit:\n                return False\n        return True\n\n    digit_frequencies = _count_digit_frequencies(number)\n    return _compare_frequencies(digit_frequencies)"}
{"task_id": "Mbpp/283", "solution": "def validate(integer: int) -> bool:\n    \"\"\"Checks if the frequency of each digit in the integer is less than or equal to the digit itself.\n    Returns True if all conditions are met, False otherwise.\"\"\"\n\n    def count_digit_frequency(integer_val: int) -> dict[str, int]:\n        \"\"\"Counts the frequency of each digit in the input integer.\"\"\"\n        s = str(integer_val)\n        frequencies = {}\n        for char in s:\n            if char.isdigit():\n                frequencies[char] = frequencies.get(char, 0) + 1\n        return frequencies\n\n    def compare_frequencies(frequency_dict: dict[str, int]) -> bool:\n        \"\"\"Compares each digit's frequency to its numerical value.\"\"\"\n        for digit_char, frequency in frequency_dict.items():\n            digit_value = int(digit_char)\n            if frequency > digit_value:\n                return False\n        return True\n\n    freq_map = count_digit_frequency(integer)\n    return compare_frequencies(freq_map)"}
