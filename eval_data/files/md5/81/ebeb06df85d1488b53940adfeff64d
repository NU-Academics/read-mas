{"task_id": "Mbpp/392", "solution": "_memo = {}\n\ndef get_max_sum(n: int) -> int:\n    \"\"\"\n    Calculates the maximum sum for n using the equation f(n) = max((f(n/2) + f(n/3) + f(n/4) + f(n/5)), n).\n    Memoization is used to optimize performance for larger inputs.\n    \"\"\"\n    if n <= 1:\n        return n\n    if n in _memo:\n        return _memo[n]\n\n    sum_of_parts = (\n        get_max_sum(n // 2) +\n        get_max_sum(n // 3) +\n        get_max_sum(n // 4) +\n        get_max_sum(n // 5)\n    )\n    result = max(sum_of_parts, n)\n    _memo[n] = result\n    return result"}
{"task_id": "Mbpp/395", "solution": "def first_non_repeating_character(input_string: str) -> str | None:\n    \"\"\"\n    Finds the first non-repeated character in a given string.\n    Returns None if no non-repeated character is found.\n    \"\"\"\n\n    def _count_characters(s: str) -> dict[str, int]:\n        \"\"\"Counts the frequency of each character in a string.\"\"\"\n        counts = {}\n        for char in s:\n            counts[char] = counts.get(char, 0) + 1\n        return counts\n\n    def _find_first_unique(s: str, char_counts: dict[str, int]) -> str | None:\n        \"\"\"Finds the first character in the string with a count of 1.\"\"\"\n        for char in s:\n            if char_counts[char] == 1:\n                return char\n        return None\n\n    char_counts = _count_characters(input_string)\n    return _find_first_unique(input_string, char_counts)"}
{"task_id": "Mbpp/395", "solution": "def first_non_repeating_character(input_string: str) -> str | None:\n    \"\"\"Finds the first non-repeated character in a given string.\n    Returns None if no non-repeated character is found or the string is empty.\n    \"\"\"\n    def _count_characters(s: str) -> dict:\n        \"\"\"Counts the frequency of each character in the input string.\"\"\"\n        counts = {}\n        for char in s:\n            counts[char] = counts.get(char, 0) + 1\n        return counts\n\n    def _find_first_unique(s: str, char_counts: dict) -> str | None:\n        \"\"\"Finds the first character with a count of 1, preserving order.\"\"\"\n        for char in s:\n            if char_counts[char] == 1:\n                return char\n        return None\n\n    if not input_string:\n        return None\n\n    char_counts = _count_characters(input_string)\n    return _find_first_unique(input_string, char_counts)"}
