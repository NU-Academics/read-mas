{"task_id": "Mbpp/223", "solution": "def _calculate_threshold(n: int) -> float:\n    \"\"\"\n    Calculate majority threshold (n/2).\n    \"\"\"\n    return n / 2\n\ndef _count_occurrences(sorted_array: list, element: any) -> int:\n    \"\"\"\n    Count occurrences of element in sorted array using binary search.\n    \"\"\"\n    n_arr = len(sorted_array)\n    if n_arr == 0:\n        return 0\n\n    # Find the first occurrence of the element\n    first_idx = -1\n    low, high = 0, n_arr - 1\n    while low <= high:\n        mid = (low + high) // 2\n        if sorted_array[mid] == element:\n            first_idx = mid\n            high = mid - 1 # Try to find an earlier occurrence\n        elif sorted_array[mid] < element:\n            low = mid + 1\n        else: # sorted_array[mid] > element\n            high = mid - 1\n\n    if first_idx == -1: # Element not found in the array\n        return 0\n\n    # Find the last occurrence of the element\n    last_idx = -1\n    low, high = 0, n_arr - 1 # Reset bounds for the second binary search\n    while low <= high:\n        mid = (low + high) // 2\n        if sorted_array[mid] == element:\n            last_idx = mid\n            low = mid + 1 # Try to find a later occurrence\n        elif sorted_array[mid] < element:\n            low = mid + 1\n        else: # sorted_array[mid] > element\n            high = mid - 1\n            \n    # If first_idx was found, last_idx must also have been found\n    return last_idx - first_idx + 1\n\ndef is_majority(sorted_array: list, n: int, element: any) -> bool:\n    \"\"\"\n    Determines if element is majority in sorted array.\n    \"\"\"\n    occurrences = _count_occurrences(sorted_array, element)\n    threshold = _calculate_threshold(n)\n    return occurrences > threshold"}
