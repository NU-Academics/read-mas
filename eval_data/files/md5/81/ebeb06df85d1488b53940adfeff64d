{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list):\n    \"\"\"\n    Pack consecutive duplicates of a given list elements into sublists.\n    \"\"\"\n    if not input_list:\n        return []\n\n    result_list = []\n    current_group = [input_list[0]]\n\n    for i in range(1, len(input_list)):\n        if input_list[i] == current_group[-1]:\n            current_group.append(input_list[i])\n        else:\n            result_list.append(current_group)\n            current_group = [input_list[i]]\n\n    result_list.append(current_group)  # Append the last group\n    return result_list"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(input_list: list) -> list:\n    \"\"\"\n    Packs consecutive duplicates of a given list elements into sublists.\n    Groups identical, consecutive elements together.\n    \"\"\"\n    result = []\n    current_group = []\n    prev_element = None\n\n    for element in input_list:\n        if element == prev_element or prev_element is None:\n            current_group.append(element)\n        else:\n            result.append(current_group)\n            current_group = [element]\n        \n        prev_element = element\n\n    if current_group:\n        result.append(current_group)\n        \n    return result"}
{"task_id": "Mbpp/780", "solution": "def find_combinations(tuple_list: list) -> list:\n    \"\"\"\n    Finds combinations of sums with tuples in the given tuple list.\n    Calculates element-wise sums for unique pairs of tuples.\n    \"\"\"\n    result_combinations = []\n    n = len(tuple_list)\n\n    # Iterate through all unique pairs of tuples\n    for i in range(n):\n        for j in range(i + 1, n):  # Start from i + 1 to avoid self-pairing and duplicate pairs\n            tuple1 = tuple_list[i]\n            tuple2 = tuple_list[j]\n\n            # Calculate the element-wise sum\n            sum_tuple = (tuple1[0] + tuple2[0], tuple1[1] + tuple2[1])\n            result_combinations.append(sum_tuple)\n\n    return result_combinations"}
{"task_id": "Mbpp/780", "solution": "import itertools\n\ndef find_combinations(tuple_list):\n    \"\"\"\n    Finds the combinations of sums with tuples in the given tuple list.\n    Calculates pairwise sums of unique tuple combinations.\n    \"\"\"\n    results = []\n\n    # Helper function to perform element-wise addition of two tuples.\n    def calculate_pairwise_sum(tuple1, tuple2):\n        return (tuple1[0] + tuple2[0], tuple1[1] + tuple2[1])\n\n    # Generate all unique combinations of two distinct tuples from the input list.\n    for t1, t2 in itertools.combinations(tuple_list, 2):\n        sum_tuple = calculate_pairwise_sum(t1, t2)\n        results.append(sum_tuple)\n\n    return results"}
{"task_id": "Mbpp/781", "solution": "import math\n\ndef count_divisors(n: int) -> bool:\n    \"\"\"Checks if the count of divisors for a given positive integer is even.\n    It calculates the number of divisors and returns True if this count is even, False otherwise.\"\"\"\n    count = 0\n    # Iterate from 1 up to the square root of n to find divisors efficiently.\n    for i in range(1, int(math.sqrt(n)) + 1):\n        if n % i == 0:\n            # If i is a divisor, then n/i is also a divisor.\n            # If i * i == n, i and n/i are the same (e.g., sqrt of perfect squares), so count once.\n            if i * i == n:\n                count += 1\n            # Otherwise, i and n/i are distinct divisors, so count both.\n            else:\n                count += 2\n    \n    # Return True if the total count of divisors is even, False if odd.\n    return count % 2 == 0"}
{"task_id": "Mbpp/781", "solution": "def count_divisors(n: int) -> bool:\n    \"\"\"\n    Checks whether the count of divisors for a given integer is even.\n    It calculates the total number of divisors and then checks its parity.\n    \"\"\"\n    divisor_count = 0\n    i = 1\n    # Iterate from 1 up to the square root of n to find divisors\n    while i * i <= n:\n        if n % i == 0:\n            # If i*i == n, i is the square root, contributing one divisor.\n            # Otherwise, i and n // i are two distinct divisors.\n            if i * i == n:\n                divisor_count += 1\n            else:\n                divisor_count += 2\n        i += 1\n    \n    # Return True if the total divisor count is even, False otherwise.\n    return divisor_count % 2 == 0"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the sum of all odd-length subarrays in the given array.\n    It iterates through all possible subarrays, filters those with odd lengths, and sums their elements.\n    \"\"\"\n    total_sum = 0\n    n = len(arr)\n\n    for i in range(n):\n        for j in range(i, n):\n            # Get the current subarray from index i to j (inclusive)\n            current_subarray = arr[i : j + 1]\n            \n            # Check if the length of the subarray is odd\n            if len(current_subarray) % 2 == 1:\n                # Add the sum of elements in this odd-length subarray to the total\n                total_sum += sum(current_subarray)\n                \n    return total_sum"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the sum of all elements in all odd length subarrays.\n    It iterates through all possible subarrays, checks their length, and sums them if odd.\n    \"\"\"\n    total_sum = 0\n    n = len(arr)\n\n    # Iterate through all possible starting indices\n    for i in range(n):\n        # Iterate through all possible ending indices (j must be >= i)\n        for j in range(i, n):\n            # Extract the current subarray from index i to j (inclusive)\n            subarray = arr[i : j + 1]\n            \n            # Check if the length of the current subarray is odd\n            if len(subarray) % 2 == 1:\n                # If the length is odd, add the sum of its elements to the total sum\n                total_sum += sum(subarray)\n                \n    return total_sum"}
{"task_id": "Mbpp/784", "solution": "def mul_even_odd(numbers):\n    \"\"\"\n    Finds the first even and first odd numbers in a list and returns their product.\n    Assumes the list will contain at least one even and one odd number.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in numbers:\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n\n        # If both have been found, we can stop iterating\n        if first_even is not None and first_odd is not None:\n            break\n\n    return first_even * first_odd"}
{"task_id": "Mbpp/784", "solution": "def _is_even(number: int) -> bool:\n    \"\"\"Checks if a number is even.\"\"\"\n    return number % 2 == 0\n\ndef _is_odd(number: int) -> bool:\n    \"\"\"Checks if a number is odd.\"\"\"\n    return number % 2 != 0\n\ndef _find_first_even(numbers: list[int]):\n    \"\"\"Finds the first even number in the list.\"\"\"\n    for num in numbers:\n        if _is_even(num):\n            return num\n    return None\n\ndef _find_first_odd(numbers: list[int]):\n    \"\"\"Finds the first odd number in the list.\"\"\"\n    for num in numbers:\n        if _is_odd(num):\n            return num\n    return None\n\ndef _calculate_product(even: int, odd: int) -> int:\n    \"\"\"Calculates the product of two integers.\"\"\"\n    return even * odd\n\ndef mul_even_odd(numbers: list[int]) -> int:\n    \"\"\"\n    Finds the product of the first even and odd number of a given list.\n    Returns 0 if either an even or odd number is not found in the list.\n    \"\"\"\n    first_even_val = _find_first_even(numbers)\n    first_odd_val = _find_first_odd(numbers)\n\n    # Treat missing numbers as 0 for the product calculation.\n    effective_even = first_even_val if first_even_val is not None else 0\n    effective_odd = first_odd_val if first_odd_val is not None else 0\n    \n    return _calculate_product(effective_even, effective_odd)"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(tuple_string: str) -> tuple:\n    \"\"\"\n    Converts a string representation of an integer tuple into an actual integer tuple.\n    Handles standard tuple string formats including whitespace and empty tuples.\n    \"\"\"\n    # Remove outer parentheses and strip whitespace\n    content = tuple_string.strip()[1:-1]\n\n    # Handle empty tuple case\n    if not content:\n        return ()\n\n    # Split the content by comma, strip whitespace from each element, and convert to int\n    elements = [int(item.strip()) for item in content.split(',')]\n\n    # Convert the list of integers to a tuple\n    return tuple(elements)"}
{"task_id": "Mbpp/785", "solution": "def tuple_str_int(input_string: str) -> tuple:\n    \"\"\"\n    Converts a string representation of an integer tuple to an actual integer tuple.\n    Handles standard tuple string formats like \"(7, 8, 9)\" and converts to corresponding integer tuples.\n    \"\"\"\n    stripped_input = input_string.strip()\n\n    # Input Validation: Check for correct parentheses format\n    if not (stripped_input.startswith('(') and stripped_input.endswith(')')):\n        raise ValueError(\"Input string must start with '(' and end with ')'.\")\n\n    # String Parsing: Extract content between parentheses\n    # Uses slicing to remove outermost parentheses, then strips any internal whitespace.\n    content = stripped_input[1:-1].strip()\n\n    # Handle empty tuple case, e.g., \"()\" or \"(   )\"\n    if not content:\n        return ()\n\n    # Split the content by commas to get individual element strings\n    elements_str = content.split(',')\n    converted_elements = []\n\n    # Integer Conversion: Iterate through elements, strip whitespace, and convert to int\n    for element_str in elements_str:\n        cleaned_str = element_str.strip()\n        if not cleaned_str:\n            # An empty string after stripping indicates a malformed input,\n            # such as consecutive commas (e.g., \"(1,,2)\") or a trailing comma (e.g., \"(1,)\").\n            raise ValueError(f\"Malformed tuple string: empty element found after stripping '{element_str}'.\")\n        try:\n            converted_elements.append(int(cleaned_str))\n        except ValueError:\n            # Raise ValueError if any element cannot be converted to an integer\n            raise ValueError(f\"Could not convert '{cleaned_str}' to an integer.\")\n\n    # Tuple Construction: Create and return the final tuple\n    return tuple(converted_elements)"}
