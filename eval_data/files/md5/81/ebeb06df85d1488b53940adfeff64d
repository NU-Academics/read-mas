{"task_id": "Mbpp/9", "solution": "```python\ndef find_Rotations(s: str) -> int:\n    \"\"\"\n    Finds the minimum number of rotations (greater than 0) required to get the same string.\n    This implementation uses the KMP algorithm's LPS array for O(N) efficiency.\n    \"\"\"\n    n = len(s)\n\n    # Handle empty string as an edge case.\n    # As rotations must be greater than 0, 1 is returned as the smallest positive integer.\n    if n == 0:\n        return 1\n\n    # KMP's Longest Proper Prefix which is also a Suffix (LPS) array construction.\n    # lps[i] stores the length of the longest proper prefix of s[0...i] that is also a suffix of s[0...i].\n    lps = [0] * n\n    length = 0  # Length of the previous longest prefix suffix.\n\n    # Build the LPS array. lps[0] is always 0.\n    i = 1\n    while i < n:\n        if s[i] == s[length]:\n            length += 1\n            lps[i] = length\n            i += 1\n        else:\n            if length != 0:\n                length = lps[length - 1]\n            else:  # length is 0\n                lps[i] = 0\n                i += 1\n\n    # The length of the smallest repeating unit (period) is n - lps[n-1].\n    # This period is the minimum number of rotations if n is divisible by it.\n    period = n - lps[n - 1]\n\n    if n % period == 0:\n        return period\n    else:\n        # If n is not divisible by the calculated period, it means the string\n        # does not have a repeating pattern smaller than its full length.\n        # In this case, the minimum number of rotations is n itself.\n        return n\n\n```"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string: str, target_char: str) -> str:\n    \"\"\"\n    Removes the first and last occurrence of a given character from the string.\n    If the character is not found or occurs only once, it is handled accordingly.\n    \"\"\"\n    first_idx = input_string.find(target_char)\n\n    # If the character is not found, return the original string\n    if first_idx == -1:\n        return input_string\n\n    last_idx = input_string.rfind(target_char)\n\n    # If the character occurs only once, remove that single occurrence\n    if first_idx == last_idx:\n        return input_string[:first_idx] + input_string[first_idx + 1:]\n    else:\n        # Remove the last occurrence first to prevent index shifts affecting the first_idx\n        temp_string = input_string[:last_idx] + input_string[last_idx + 1:]\n        \n        # Then, remove the first occurrence from the temporarily modified string\n        return temp_string[:first_idx] + temp_string[first_idx + 1:]"}
{"task_id": "Mbpp/9", "solution": "def _gcd(a: int, b: int) -> int:\n    \"\"\"\n    Calculate greatest common divisor using Euclidean algorithm.\n    \"\"\"\n    while b:\n        a, b = b, a % b\n    return a\n\ndef _find_period(s: str) -> int:\n    \"\"\"\n    Calculate the length of the shortest repeating period of the string.\n    \"\"\"\n    n = len(s)\n    # The smallest period 'p' must be a divisor of 'n'.\n    # Iterate through all possible lengths 'p' from 1 to n.\n    for p in range(1, n + 1):\n        if n % p == 0:\n            # Check if the string 's' is formed by repeating its prefix s[:p].\n            if s[:p] * (n // p) == s:\n                return p\n    # This line should ideally not be reached for n > 0, as p=n will always be a valid period.\n    # It serves as a fallback or for edge cases not explicitly handled elsewhere.\n    return n\n\ndef find_Rotations(s: str) -> int:\n    \"\"\"\n    Find the minimum number of rotations (greater than 0) required to get the same string.\n    \"\"\"\n    n = len(s)\n    if n == 0:\n        return 0\n    \n    return _find_period(s)"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(string: str, character: str) -> str:\n    \"\"\"\n    Removes the first and last occurrence of a given character from the string.\n    \"\"\"\n    first_index = string.find(character)\n    \n    if first_index == -1:\n        return string\n\n    last_index = string.rfind(character)\n\n    if first_index == last_index:\n        # Only one occurrence\n        return string[:first_index] + string[first_index + 1:]\n    else:\n        # Multiple occurrences\n        return string[:first_index] + string[first_index + 1 : last_index] + string[last_index + 1:]"}
