{"task_id": "Mbpp/126", "solution": "def sum(a, b):\n    \"\"\"\n    Calculates the sum of common divisors of two given numbers.\n    \"\"\"\n    def get_divisors(n):\n        \"\"\"\n        Returns a list of all positive divisors for a given number.\n        \"\"\"\n        divs = []\n        for i in range(1, n + 1):\n            if n % i == 0:\n                divs.append(i)\n        return divs\n\n    divisors_a = get_divisors(a)\n    divisors_b = get_divisors(b)\n\n    common_divisors = []\n    for div_a in divisors_a:\n        if div_a in divisors_b:\n            common_divisors.append(div_a)\n    \n    return sum(common_divisors)"}
{"task_id": "Mbpp/126", "solution": "def sum(num1: int, num2: int) -> int:\n    \"\"\"\n    Calculates the sum of common divisors of two given numbers.\n    \"\"\"\n    def _get_divisors(number: int) -> list[int]:\n        \"\"\"\n        Helper function to calculate all divisors of a number.\n        \"\"\"\n        divs = []\n        for i in range(1, number + 1):\n            if number % i == 0:\n                divs.append(i)\n        return divs\n\n    def _find_common_divisors(divisors1: list[int], divisors2: list[int]) -> list[int]:\n        \"\"\"\n        Helper function to find common divisors between two lists.\n        \"\"\"\n        set1 = set(divisors1)\n        common = [d for d in divisors2 if d in set1]\n        return common\n\n    divs1 = _get_divisors(num1)\n    divs2 = _get_divisors(num2)\n    common_divs = _find_common_divisors(divs1, divs2)\n    return builtins.sum(common_divs)"}
{"task_id": "Mbpp/125", "solution": "def find_length(binary_string: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and 1s in any substring of the given binary string.\n    This function calculates the absolute difference for all substrings and returns the largest one.\n    \"\"\"\n    if not binary_string:\n        return 0\n\n    max_diff = 0\n    n = len(binary_string)\n\n    for i in range(n):\n        zeros_count = 0\n        ones_count = 0\n        for j in range(i, n):\n            # Process substring from index i to j\n            if binary_string[j] == '0':\n                zeros_count += 1\n            else: # binary_string[j] == '1'\n                ones_count += 1\n            \n            current_diff = abs(zeros_count - ones_count)\n            max_diff = max(max_diff, current_diff)\n            \n    return max_diff"}
{"task_id": "Mbpp/128", "solution": "def long_words(n: int, text: str) -> list[str]:\n    \"\"\"\n    Finds words that are longer than n characters from a given list of words.\n    The function splits the text by spaces and filters words based on length.\n    \"\"\"\n    words = text.split(' ')\n    result = [word for word in words if len(word) > n]\n    return result"}
{"task_id": "Mbpp/128", "solution": "def long_words(n, text):\n    \"\"\"\n    Find words that are longer than n characters from a given text string.\n    Splits the text by whitespace and filters words based on length.\n    \"\"\"\n    words = text.split()\n    result = []\n    for word in words:\n        if len(word) > n:\n            result.append(word)\n    return result"}
{"task_id": "Mbpp/130", "solution": "def max_occurrences(input_list):\n    \"\"\"\n    Finds the item with the maximum frequency in a given list.\n    Delegates to helper functions for frequency counting and max identification.\n    \"\"\"\n\n    def count_frequencies(lst):\n        \"\"\"Counts the frequency of each item in the list.\"\"\"\n        frequency_map = {}\n        for item in lst:\n            frequency_map[item] = frequency_map.get(item, 0) + 1\n        return frequency_map\n\n    def find_max_frequency_item(frequency_map):\n        \"\"\"Identifies the item with the highest frequency from a frequency map.\"\"\"\n        if not frequency_map:\n            return None # Or handle as per specific requirement for empty lists\n\n        max_freq = -1\n        most_frequent_item = None\n\n        for item, freq in frequency_map.items():\n            if freq > max_freq:\n                max_freq = freq\n                most_frequent_item = item\n        return most_frequent_item\n\n    frequency_map = count_frequencies(input_list)\n    most_frequent = find_max_frequency_item(frequency_map)\n    return most_frequent"}
{"task_id": "Mbpp/131", "solution": "def reverse_vowels(input_string: str) -> str:\n    \"\"\"\n    Reverses only the vowels of a given string (where y is not a vowel).\n    Consonants and non-alphabetic characters remain in their original positions.\n    \"\"\"\n    def _is_vowel(char: str) -> bool:\n        \"\"\"Determines if a character is a vowel (a, e, i, o, u, case-insensitive).\"\"\"\n        return char.lower() in 'aeiou'\n\n    def _extract_vowels(s: str) -> list[str]:\n        \"\"\"Extracts all vowels from a string, preserving their original case and order.\"\"\"\n        vowels = []\n        for char in s:\n            if _is_vowel(char):\n                vowels.append(char)\n        return vowels\n\n    def _reconstruct_string(s: str, reversed_vowels: list[str]) -> str:\n        \"\"\"Rebuilds the string by placing the reversed vowels back into their original positions.\"\"\"\n        result_chars = list(s)\n        vowel_idx_in_reversed_list = 0\n        for i in range(len(result_chars)):\n            if _is_vowel(result_chars[i]):\n                result_chars[i] = reversed_vowels[vowel_idx_in_reversed_list]\n                vowel_idx_in_reversed_list += 1\n        return \"\".join(result_chars)\n\n    extracted_vowels = _extract_vowels(input_string)\n    extracted_vowels.reverse() # Reverse the list of extracted vowels\n\n    return _reconstruct_string(input_string, extracted_vowels)"}
{"task_id": "Mbpp/131", "solution": "def reverse_vowels(input_string: str) -> str:\n    \"\"\"\n    Reverses only the vowels in a given string (where y is not a vowel).\n    Main entry point for vowel reversal functionality.\n    \"\"\"\n    VOWELS = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n\n    def _identify_vowels(text: str) -> list[tuple[int, str]]:\n        \"\"\"Identifies vowel positions and characters in input string.\"\"\"\n        vowel_positions = []\n        for i, char in enumerate(text):\n            if char in VOWELS:\n                vowel_positions.append((i, char))\n        return vowel_positions\n\n    def _reverse_vowel_order(vowels: list[tuple[int, str]]) -> list[str]:\n        \"\"\"Reverses the order of vowel characters.\"\"\"\n        return [vowel_info[1] for vowel_info in vowels][::-1]\n\n    def _reconstruct_string(\n        original: str, vowel_positions: list[tuple[int, str]], reversed_vowels: list[str]\n    ) -> str:\n        \"\"\"Rebuilds string with reversed vowels in original positions.\"\"\"\n        string_list = list(original)\n        for i, (pos, _) in enumerate(vowel_positions):\n            string_list[pos] = reversed_vowels[i]\n        return \"\".join(string_list)\n\n    vowel_info = _identify_vowels(input_string)\n\n    if not vowel_info:\n        return input_string\n\n    reversed_chars = _reverse_vowel_order(vowel_info)\n    return _reconstruct_string(input_string, vowel_info, reversed_chars)"}
{"task_id": "Mbpp/130", "solution": "def max_occurrences(input_list: list) -> any:\n    \"\"\"Find the item with maximum frequency in the given list.\"\"\"\n\n    def _count_frequencies(lst: list) -> dict:\n        \"\"\"Count frequency of each item in the list.\"\"\"\n        frequency_map = {}\n        for item in lst:\n            frequency_map[item] = frequency_map.get(item, 0) + 1\n        return frequency_map\n\n    def _find_max_item(frequency_map: dict) -> any:\n        \"\"\"Find the item with maximum frequency from frequency map.\"\"\"\n        if not frequency_map:\n            return None  # Or raise an error, depending on desired empty list behavior\n\n        max_item = None\n        max_count = -1\n        for item, count in frequency_map.items():\n            if count > max_count:\n                max_count = count\n                max_item = item\n        return max_item\n\n    if not input_list:\n        return None\n\n    frequencies = _count_frequencies(input_list)\n    return _find_max_item(frequencies)"}
{"task_id": "Mbpp/129", "solution": "def magic_square_test(matrix: list) -> bool:\n    \"\"\"\n    Checks if a given matrix is a magic square.\n    A magic square has equal row sums, column sums, and diagonal sums.\n    \"\"\"\n\n    def _validate_square_matrix(mat: list) -> bool:\n        if not mat:\n            return False\n        n = len(mat)\n        for row in mat:\n            if len(row) != n:\n                return False\n        return True\n\n    def _calculate_row_sums(mat: list) -> list:\n        return [sum(row) for row in mat]\n\n    def _calculate_column_sums(mat: list) -> list:\n        n = len(mat)\n        col_sums = [0] * n\n        for r_idx in range(n):\n            for c_idx in range(n):\n                col_sums[c_idx] += mat[r_idx][c_idx]\n        return col_sums\n\n    def _calculate_main_diagonal_sum(mat: list) -> int:\n        n = len(mat)\n        main_diag_sum = 0\n        for i in range(n):\n            main_diag_sum += mat[i][i]\n        return main_diag_sum\n\n    def _calculate_anti_diagonal_sum(mat: list) -> int:\n        n = len(mat)\n        anti_diag_sum = 0\n        for i in range(n):\n            anti_diag_sum += mat[i][n - 1 - i]\n        return anti_diag_sum\n\n    def _verify_all_sums_equal(row_sums: list, col_sums: list, main_diag_sum: int, anti_diag_sum: int) -> bool:\n        if not row_sums:\n            return False\n\n        target_sum = row_sums[0]\n\n        if any(s != target_sum for s in row_sums):\n            return False\n\n        if any(s != target_sum for s in col_sums):\n            return False\n\n        if main_diag_sum != target_sum:\n            return False\n\n        if anti_diag_sum != target_sum:\n            return False\n\n        return True\n\n    if not _validate_square_matrix(matrix):\n        return False\n\n    row_sums = _calculate_row_sums(matrix)\n    col_sums = _calculate_column_sums(matrix)\n    main_diag_sum = _calculate_main_diagonal_sum(matrix)\n    anti_diag_sum = _calculate_anti_diagonal_sum(matrix)\n\n    return _verify_all_sums_equal(row_sums, col_sums, main_diag_sum, anti_diag_sum)"}
