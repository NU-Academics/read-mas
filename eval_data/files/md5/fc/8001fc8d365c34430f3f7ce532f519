{"task_id": "HumanEval/110", "solution": "def is_even(num: int) -> bool:\n    \"\"\"Checks if a given number is even.\"\"\"\n    return num % 2 == 0\ndef count_odd_numbers(numbers: list[int]) -> int:\n    \"\"\"Counts odd integers in a list. It iterates through the list once.\"\"\"\n    return sum(1 for num in numbers if not is_even(num))\ndef count_even_numbers(numbers: list[int]) -> int:\n    \"\"\"Counts even integers in a list. It leverages the is_even helper.\"\"\"\n    return sum(1 for num in numbers if is_even(num))\ndef exchange(lst1, lst2):\n    \"\"\"In this problem, you will implement a function that takes two lists of numbers,\n    and determines whether it is possible to perform an exchange of elements\n    between them to make lst1 a list of only even numbers.\n    There is no limit on the number of exchanged elements between lst1 and lst2.\n    If it is possible to exchange elements between the lst1 and lst2 to make\n    all the elements of lst1 to be even, return \"YES\".\n    Otherwise, return \"NO\".\n    For example:\n    exchange([1, 2, 3, 4], [1, 2, 3, 4]) => \"YES\"\n    exchange([1, 2, 3, 4], [1, 5, 3, 4]) => \"NO\"\n    It is assumed that the input lists will be non-empty.\n    \"\"\"\n    \n    odds_in_lst1 = count_odd_numbers(lst1)\n    evens_in_lst2 = count_even_numbers(lst2)\n\n    if odds_in_lst1 <= evens_in_lst2:\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/112", "solution": "def reverse_delete(s, c):\n    \"\"\"\n    Deletes characters from s found in c, then checks if the resulting string is a palindrome.\n    Returns the filtered string and a boolean indicating if it's a palindrome.\n    \"\"\"\n    if not isinstance(s, str) or not isinstance(c, str):\n        raise TypeError(\"Inputs 's' and 'c' must be strings.\")\n\n    # Convert characters to delete into a set for efficient lookup.\n    chars_to_delete_set = set(c)\n\n    # Filter the main string s, keeping only characters not in the deletion set.\n    filtered_s = \"\".join(char for char in s if char not in chars_to_delete_set)\n\n    # Check if the filtered string is a palindrome.\n    is_palindrome = (filtered_s == filtered_s[::-1])\n\n    return (filtered_s, is_palindrome)"}
{"task_id": "HumanEval/113", "solution": "def _count_odd_digits(s: str) -> int:\n    \"\"\"Counts the number of odd digits in a given string.\n    Assumes the input string contains only digits.\n    \"\"\"\n    odd_count = 0\n    for char_digit in s:\n        digit = int(char_digit)\n        if digit % 2 != 0:\n            odd_count += 1\n    return odd_count\ndef odd_count(lst: list[str]) -> list[str]:\n    \"\"\"Given a list of digit-only strings, returns a new list of formatted strings.\n    Each output string indicates the count of odd digits in the corresponding input string.\n    \"\"\"\n    results = []\n    for s in lst:\n        if not s.isdigit():\n            raise ValueError(\"Input string must contain only digits.\")\n        count = _count_odd_digits(s)\n        results.append(f\"the number of odd elements in the string {count} of the input.\")\n    return results"}
{"task_id": "HumanEval/115", "solution": "import math\ndef max_fill(grid, capacity):\n    \"\"\"\n    Calculates the total number of times buckets need to be lowered\n    to empty all wells in a given grid.\n    Each '1' in a grid cell represents one unit of water.\n    \"\"\"\n    if not isinstance(capacity, int) or capacity <= 0:\n        raise ValueError(\"Bucket capacity must be a positive integer.\")\n\n    total_bucket_operations = 0\n    for well_row in grid:\n        water_units_in_well = 0\n        for unit in well_row:\n            # Non-'1' values in the well row are treated as '0' water units as per FR1 error handling.\n            if unit == 1:\n                water_units_in_well += 1\n\n        # Calculate the number of bucket operations for the current well, rounding up.\n        if water_units_in_well > 0:\n            operations_for_well = math.ceil(water_units_in_well / capacity)\n            total_bucket_operations += operations_for_well\n    \n    return total_bucket_operations"}
{"task_id": "HumanEval/114", "solution": "class MinSubarraySumError(Exception):\n    \"\"\"Base exception for minimum sub-array sum calculation errors.\"\"\"\n    pass\nclass InvalidInputError(MinSubarraySumError):\n    \"\"\"Exception raised for invalid input to the calculator.\"\"\"\n    pass\ndef minSubArraySum(nums):\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty sub-array.\n    This uses a variation of Kadane's algorithm with O(n) time complexity.\n    \"\"\"\n    # Validate input type and content.\n    if not isinstance(nums, list):\n        raise InvalidInputError(\"Input must be a list.\")\n    if not all(isinstance(x, int) for x in nums):\n        raise InvalidInputError(\"All elements in the list must be integers.\")\n    if not nums:\n        raise MinSubarraySumError(\"Input array cannot be empty.\")\n\n    min_so_far = float('inf')\n    current_min = 0\n\n    # Iterate through the array to find the minimum sub-array sum.\n    for x in nums:\n        current_min += x\n        min_so_far = min(min_so_far, current_min)\n        # Reset current_min if it becomes positive, as it won't contribute to a smaller sum.\n        if current_min > 0:\n            current_min = 0\n\n    return min_so_far"}
{"task_id": "HumanEval/113", "solution": "from typing import List\ndef _count_odd_digits_in_string(s: str) -> int:\n    \"\"\"Counts odd digits in a string.\n    Iterates through characters, converts to int, and checks for oddness.\"\"\"\n    count = 0\n    for char_digit in s:\n        digit = int(char_digit)\n        if digit % 2 != 0:\n            count += 1\n    return count\ndef _format_output_string(count: int) -> str:\n    \"\"\"Constructs the output string.\n    Uses an f-string with the given count as specified in the template.\"\"\"\n    return f\"the number of odd elements {count}n the str{count}ng {count} of the {count}nput.\"\ndef odd_count(lst: List[str]) -> List[str]:\n    \"\"\"Given a list of strings, where each string consists of only digits, return a list.\n    Each element i of the output should be \"the number of odd elements in the\n    string i of the input.\" where all the i's should be replaced by the number\n    of odd digits in the i'th string of the input.\n\n    >>> odd_count(['1234567'])\n    [\"the number of odd elements 4n the str4ng 4 of the 4nput.\"]\n    >>> odd_count(['3',\"11111111\"])\n    [\"the number of odd elements 1n the str1ng 1 of the 1nput.\",\n     \"the number of odd elements 8n the str8ng 8 of the 8nput.\"]\n    \"\"\"\n    _validate_input(lst)\n    result = []\n    for s in lst:\n        odd_digits_count = _count_odd_digits_in_string(s)\n        formatted_string = _format_output_string(odd_digits_count)\n        result.append(formatted_string)\n    return result"}
{"task_id": "HumanEval/114", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input. Carries a descriptive message.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef minSubArraySum(nums):\n    \"\"\"\n    Finds the minimum sum of any non-empty sub-array within a list of integers.\n    Raises InvalidInputError for invalid or empty input.\n    \"\"\"\n    if not isinstance(nums, list):\n        raise InvalidInputError(\"Input must be a list.\")\n    if not nums:\n        raise InvalidInputError(\"Input list cannot be empty.\")\n    for item in nums:\n        if not isinstance(item, int):\n            raise InvalidInputError(\"All elements in the list must be integers.\")\n\n    min_so_far = nums[0]    # Overall minimum sub-array sum found.\n    current_min = nums[0]   # Minimum sub-array sum ending at current position.\n\n    for i in range(1, len(nums)):\n        current_min = min(nums[i], current_min + nums[i])\n        min_so_far = min(min_so_far, current_min)\n\n    return min_so_far"}
