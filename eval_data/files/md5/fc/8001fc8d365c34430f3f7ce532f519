{"task_id": "HumanEval/107", "solution": "def even_odd_palindrome(n):\n    \"\"\"\n    Identifies all integer palindromes within the range [1, n],\n    counts how many are even and how many are odd, and returns\n    the counts as a tuple.\n    \"\"\"\n    MIN_N = 1\n    MAX_N = 1000\n\n    def is_palindrome(num: int) -> bool:\n        \"\"\"\n        Checks if the input integer `num` reads the same forwards and backward.\n        \"\"\"\n        return str(num) == str(num)[::-1]\n\n    if not isinstance(n, int) or not (MIN_N <= n <= MAX_N):\n        raise ValueError(\"Input 'n' must be a positive integer between 1 and 1000, inclusive.\")\n\n    even_count = 0\n    odd_count = 0\n\n    for i in range(1, n + 1):\n        if is_palindrome(i):\n            if i % 2 == 0:\n                even_count += 1\n            else:\n                odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/105", "solution": "def by_length(arr):\n    \"\"\"\n    Transforms a list of integers by filtering to digits 1-9, sorting ascending, reversing,\n    and converting valid digits to their English word representations. Invalid numbers are ignored,\n    and an empty list is returned for empty input.\n    \"\"\"\n    if not arr:\n        return []\n\n    _DIGIT_NAMES = {\n        1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n        6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\"\n    }\n    _MIN_VALID_DIGIT = 1\n    _MAX_VALID_DIGIT = 9\n\n    # Filter for numbers between 1 and 9 inclusive, ignoring non-integers or out-of-range values.\n    # Then sort these valid numbers in ascending order.\n    filtered_and_sorted_arr = []\n    for num in arr:\n        if isinstance(num, int) and _MIN_VALID_DIGIT <= num <= _MAX_VALID_DIGIT:\n            filtered_and_sorted_arr.append(num)\n    filtered_and_sorted_arr.sort()\n\n    # Reverse the sorted array.\n    reversed_arr = filtered_and_sorted_arr[::-1]\n\n    # Convert each digit to its corresponding English word.\n    result_words = [_DIGIT_NAMES[digit] for digit in reversed_arr]\n\n    return result_words"}
{"task_id": "HumanEval/87", "solution": "from typing import List, Tuple\ndef get_row(lst: List[List[int]], x: int) -> List[Tuple[int, int]]:\n    \"\"\"\n    Finds all occurrences of integer x in a 2D ragged list lst.\n    Returns their coordinates (row, column) sorted by row ascending, then column descending.\n    \"\"\"\n    found_coordinates: List[Tuple[int, int]] = []\n\n    # Iterate through the 2D list, recording (row, column) for each target occurrence.\n    # This handles ragged lists by iterating each row up to its specific length.\n    for row_idx, row in enumerate(lst):\n        for col_idx, value in enumerate(row):\n            if value == x:\n                found_coordinates.append((row_idx, col_idx))\n\n    # Sort the collected coordinates: primary by row (ascending), secondary by column (descending).\n    # The lambda key achieves this by using the row for ascending order and negative column for descending.\n    sorted_coordinates = sorted(found_coordinates, key=lambda coord: (coord[0], -coord[1]))\n\n    return sorted_coordinates"}
{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr: list[int]) -> bool:\n    \"\"\"\n    Determines if an array can be sorted by right shifts.\n    It checks for at most one 'descent' point and valid wrap-around.\n    \"\"\"\n    n = len(arr)\n    if n <= 1:\n        return True\n\n    break_point_index = -1\n    for i in range(n - 1):\n        if arr[i] > arr[i+1]:\n            if break_point_index != -1: # More than one descent point means not sortable.\n                return False\n            break_point_index = i\n    \n    if break_point_index == -1: # Array is already sorted.\n        return True\n    \n    # Check if the last element is greater than the first, which would break sortability after rotation.\n    if arr[n-1] > arr[0]:\n        return False\n    \n    return True"}
{"task_id": "HumanEval/108", "solution": "class DigitSumCalculator:\n    def calculate_sum(self, num: int) -> int:\n        \"\"\"\n        Computes the sum of digits for num, treating the first digit as negative if num is negative.\n        Returns the calculated sum of digits.\n        \"\"\"\n        if num == 0:\n            return 0\n        \n        s = str(abs(num))\n        digit_sum = 0\n        \n        if num < 0:\n            digit_sum += -int(s[0])\n            for digit_char in s[1:]:\n                digit_sum += int(digit_char)\n        else:\n            for digit_char in s:\n                digit_sum += int(digit_char)\n                \n        return digit_sum\nclass NumberCounter:\n    def __init__(self, digit_sum_calculator: DigitSumCalculator):\n        self.digit_sum_calculator = digit_sum_calculator\n\n    def count_positive_sum_numbers(self, numbers: list[int]) -> int:\n        \"\"\"\n        Counts numbers in the list whose sum of digits is greater than zero.\n        Raises TypeError if any element in the list is not an integer.\n        \"\"\"\n        count = 0\n        for num in numbers:\n            if not isinstance(num, int):\n                raise TypeError(f\"Expected integer, got {type(num).__name__}\")\n            \n            sum_of_digits = self.digit_sum_calculator.calculate_sum(num)\n            if sum_of_digits > 0:\n                count += 1\n        return count\ndef count_nums(arr: list[int]) -> int:\n    \"\"\"\n    Counts elements in 'arr' with a positive sum of digits.\n    Negative numbers treat the first digit as negative for sum calculation.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input must be a list of integers.\")\n    \n    calculator = DigitSumCalculator()\n    counter = NumberCounter(calculator)\n    return counter.count_positive_sum_numbers(arr)"}
{"task_id": "HumanEval/108", "solution": "def count_nums(arr):\n    \"\"\"\n    Write a function count_nums which takes an array of integers and returns\n    the number of elements which has a sum of digits > 0.\n    If a number is negative, then its first signed digit will be negative:\n    e.g. -123 has signed digits -1, 2, and 3.\n    >>> count_nums([]) == 0\n    >>> count_nums([-1, 11, -11]) == 1\n    >>> count_nums([1, 1, 2]) == 3\n    \"\"\"\n    count = 0\n    for num in arr:\n        s_num = str(num)\n        digit_sum = 0\n\n        if s_num.startswith('-'):\n            # Negative number: first digit after '-' is negative, rest are positive.\n            digit_sum += -int(s_num[1])\n            for digit_char in s_num[2:]:\n                digit_sum += int(digit_char)\n        else:\n            # Positive or zero number: all digits are positive.\n            for digit_char in s_num:\n                digit_sum += int(digit_char)\n\n        if digit_sum > 0:\n            count += 1\n    return count"}
{"task_id": "HumanEval/110", "solution": "def exchange(lst1, lst2):\n    \"\"\"Determines if lst1 can be made entirely of even numbers by exchanging elements with lst2.\n    Returns \"YES\" if possible, \"NO\" otherwise.\"\"\"\n    \n    odd_count_lst1 = sum(1 for x in lst1 if x % 2 != 0)\n    even_count_lst2 = sum(1 for x in lst2 if x % 2 == 0)\n\n    if odd_count_lst1 <= even_count_lst2:\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr):\n    \"\"\"Determines if an array can be sorted in non-decreasing order by\n    performing right shift operations. Returns True if sortable, False otherwise.\"\"\"\n\n    def _is_sorted(arr_to_check):\n        \"\"\"Checks if the given array is sorted in non-decreasing order.\n        Returns True if sorted, False otherwise.\"\"\"\n        if not arr_to_check:\n            return True\n        for i in range(len(arr_to_check) - 1):\n            if arr_to_check[i] > arr_to_check[i+1]:\n                return False\n        return True\n\n    n = len(arr)\n    if n == 0:\n        return True\n\n    # Find the index of the minimum element in the array.\n    min_val = arr[0]\n    min_idx = 0\n    for i in range(1, n):\n        if arr[i] < min_val:\n            min_val = arr[i]\n            min_idx = i\n    \n    # Construct the array by shifting it so the minimum element is at the start.\n    shifted_arr = arr[min_idx:] + arr[:min_idx]\n    \n    # Check if this specific shifted version is sorted.\n    return _is_sorted(shifted_arr)"}
{"task_id": "HumanEval/111", "solution": "from collections import Counter\nfrom typing import Dict\ndef histogram(test: str) -> Dict[str, int]:\n    \"\"\"Given a string representing space-separated lowercase letters, returns the most frequent letters and their counts.\n    If multiple letters share the highest frequency, all are included.\n    \"\"\"\n    if not test:\n        return {}\n\n    # Split the string by spaces and filter out any empty strings that result from multiple spaces.\n    letters = [letter for letter in test.split(' ') if letter]\n    \n    # Count the frequency of each letter.\n    counts = Counter(letters)\n\n    if not counts:\n        return {} # Handles cases where 'letters' was empty after filtering (e.g., input was '   ').\n\n    # Find the maximum frequency among all letters.\n    max_count = max(counts.values())\n\n    # Filter the counts to include only letters that have the maximum frequency.\n    result = {letter: count for letter, count in counts.items() if count == max_count}\n    \n    return result"}
