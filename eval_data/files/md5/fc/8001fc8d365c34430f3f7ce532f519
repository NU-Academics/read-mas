{"task_id": "HumanEval/102", "solution": "def choose_num(x: int, y: int) -> int:\n    \"\"\"Finds the biggest even integer in the range [x, y] inclusive.\n    Returns -1 if no such number exists, including when x > y.\n    \"\"\"\n    if x > y:\n        return -1\n\n    for num in range(y, x - 1, -1):\n        if num % 2 == 0:\n            return num\n    \n    return -1"}
{"task_id": "HumanEval/104", "solution": "def unique_digits(x: list[int]) -> list[int]:\n    \"\"\"Given a list of positive integers x, return a sorted list of all\n    elements that haven't any even digit.\n    \"\"\"\n\n    def _has_even_digit(n: int) -> bool:\n        \"\"\"Checks if a positive integer contains any even digit (0, 2, 4, 6, 8).\n        It converts the number to a string to iterate through its digits efficiently.\n        \"\"\"\n        for digit_char in str(n):\n            if int(digit_char) % 2 == 0:\n                return True\n        return False\n\n    result = []\n    # Iterate through each number in the input list, filtering based on the even digit check.\n    for num in x:\n        if not _has_even_digit(num):\n            result.append(num)\n\n    # Sort the collected numbers in increasing numerical order before returning.\n    result.sort()\n    return result"}
{"task_id": "HumanEval/104", "solution": "def unique_digits(x: list[int]) -> list[int]:\n    \"\"\"\n    Given a list of positive integers x, return a sorted list of all\n    elements that have no even digits. The returned list is sorted in increasing order.\n    \"\"\"\n\n    def _has_even_digit(n: int) -> bool:\n        \"\"\"Helper to check if a number contains any even digit (0, 2, 4, 6, 8).\"\"\"\n        temp_n = n\n        while temp_n > 0:\n            digit = temp_n % 10\n            if digit % 2 == 0:\n                return True\n            temp_n //= 10\n        return False\n\n    filtered_list = []\n    for number in x:\n        if not _has_even_digit(number):\n            filtered_list.append(number)\n\n    filtered_list.sort()\n    return filtered_list"}
