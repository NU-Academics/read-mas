{"task_id": "HumanEval/82", "solution": "def _is_prime(n: int) -> bool:\n    \"\"\"Checks if an integer n is a prime number using an optimized trial division.\n    Handles edge cases for 0, 1, 2, 3 efficiently.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\ndef prime_length(string: str) -> bool:\n    \"\"\"Determines if the length of the input string is a prime number.\n    It calculates the string's length and then applies a primality test.\n    \"\"\"\n    length = len(string)\n    return _is_prime(length)"}
{"task_id": "HumanEval/82", "solution": "import math\ndef is_prime(n: int) -> bool:\n    \"\"\"Determines if a given integer is a prime number.\n    Raises ValueError if n is not an integer or is negative.\"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n    \n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    # Check for divisibility by odd numbers up to the square root of n.\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        if n % i == 0:\n            return False\n    return True\ndef prime_length(string):\n    \"\"\"Write a function that takes a string and returns True if the string\n    length is a prime number or False otherwise\n    Examples\n    prime_length('Hello') == True\n    prime_length('abcdcba') == True\n    prime_length('kittens') == True\n    prime_length('orange') == False\n    \"\"\"\n    if not isinstance(string, str):\n        raise TypeError(\"Input must be a string.\")\n    length = len(string)\n    return is_prime(length)"}
