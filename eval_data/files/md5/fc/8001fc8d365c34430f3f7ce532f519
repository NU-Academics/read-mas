{"task_id": "HumanEval/128", "solution": "def prod_signs(arr: list[int] | None) -> int | None:\n    \"\"\"\n    Calculates sum of magnitudes multiplied by product of signs for integers in an array.\n    Returns None for an empty array, and 0 if any integer is zero.\n    \"\"\"\n    if arr is None or not arr:\n        return None\n\n    product_of_signs = 1\n    sum_of_magnitudes = 0\n\n    for num in arr:\n        if num == 0:\n            return 0  # FR5: If any integer is 0, the final result is 0.\n        elif num > 0:\n            product_of_signs *= 1\n        else:  # num < 0\n            product_of_signs *= -1\n        \n        sum_of_magnitudes += abs(num)\n\n    return product_of_signs * sum_of_magnitudes"}
{"task_id": "HumanEval/112", "solution": "class StringUtils:\n    @staticmethod\n    def delete_chars(s: str, c: str) -> str:\n        \"\"\"Removes all occurrences of characters from `c` within `s`.\n        Raises TypeError if `s` or `c` are not strings.\n        \"\"\"\n        if not isinstance(s, str) or not isinstance(c, str):\n            raise TypeError(\"Inputs s and c must be strings.\")\n        return \"\".join(char for char in s if char not in c)\n\n    @staticmethod\n    def is_palindrome(s: str) -> bool:\n        \"\"\"Checks if the input string `s` is a palindrome.\n        Raises TypeError if `s` is not a string.\n        \"\"\"\n        if not isinstance(s, str):\n            raise TypeError(\"Input s must be a string.\")\n        return s == s[::-1]\nclass ReverseDeleteService:\n    def __init__(self, string_utils: 'StringUtils' = None):\n        \"\"\"Initializes the service, optionally injecting a StringUtils instance for testability.\n        This allows for easier unit testing of the service.\n        \"\"\"\n        self._string_utils = string_utils if string_utils is not None else StringUtils()\n\n    def execute(self, s: str, c: str) -> tuple[str, bool]:\n        \"\"\"Deletes characters from s and then checks if the modified string is a palindrome.\n        It propagates TypeError from StringUtils methods.\n        \"\"\"\n        modified_s = self._string_utils.delete_chars(s, c)\n        is_pal = self._string_utils.is_palindrome(modified_s)\n        return (modified_s, is_pal)\ndef reverse_delete(s, c):\n    \"\"\"Task\n    We are given two strings s and c, you have to deleted all the characters in s that are equal to any character in c\n    then check if the result string is palindrome.\n    A string is called palindrome if it reads the same backward as forward.\n    You should return a tuple containing the result string and True/False for the check.\n    Example\n    For s = \"abcde\", c = \"ae\", the result should be ('bcd',False)\n    For s = \"abcdef\", c = \"b\"  the result should be ('acdef',False)\n    For s = \"abcdedcba\", c = \"ab\", the result should be ('cdedc',True)\n    \"\"\"\n    service = ReverseDeleteService(string_utils=StringUtils())\n    return service.execute(s, c)"}
{"task_id": "HumanEval/127", "solution": "class Interval:\n    \"\"\"Represents a closed integer interval [start, end].\n    Ensures that start and end are integers.\"\"\"\n    def __init__(self, start: int, end: int):\n        if not isinstance(start, int) or not isinstance(end, int):\n            raise TypeError(\"Interval boundaries must be integers.\")\n        self._start = start\n        self._end = end\n\n    @property\n    def start(self) -> int:\n        \"\"\"Returns the start of the interval.\"\"\"\n        return self._start\n\n    @property\n    def end(self) -> int:\n        \"\"\"Returns the end of the interval.\"\"\"\n        return self._end\n\n    def length(self) -> int:\n        \"\"\"Calculates the length of the interval.\n        Returns 0 if the interval is degenerate (start > end).\"\"\"\n        if self._start > self._end:\n            return 0\n        return self._end - self._start + 1\nclass IntervalService:\n    \"\"\"Provides business logic for operations on Interval objects.\n    Specifically calculates the intersection of two intervals.\"\"\"\n    @staticmethod\n    def calculate_intersection(interval1: Interval, interval2: Interval) -> Interval | None:\n        \"\"\"Determines the intersection of two given intervals.\n        Returns an Interval object if an intersection exists, None otherwise.\"\"\"\n        int_start = max(interval1.start, interval2.start)\n        int_end = min(interval1.end, interval2.end)\n\n        if int_start <= int_end:\n            return Interval(int_start, int_end)\n        return None\nclass PrimeService:\n    \"\"\"Provides business logic for determining if a number is prime.\n    Uses an optimized trial division algorithm.\"\"\"\n    @staticmethod\n    def is_prime(number: int) -> bool:\n        \"\"\"Checks if a given integer is a prime number.\n        Returns True if prime, False otherwise (0, 1, or composites).\"\"\"\n        if number <= 1:\n            return False\n        if number <= 3:\n            return True\n        if number % 2 == 0 or number % 3 == 0:\n            return False\n        \n        i = 5\n        while i * i <= number:\n            if number % i == 0 or number % (i + 2) == 0:\n                return False\n            i += 6\n        return True\ndef intersection(interval1: tuple[int, int], interval2: tuple[int, int]) -> str:\n    \"\"\"Determines if the length of the intersection of two intervals is a prime number.\n    Returns 'YES' if prime, 'NO' otherwise, including non-intersecting cases.\"\"\"\n    \n    PRIME_YES_RESPONSE = \"YES\"\n    PRIME_NO_RESPONSE = \"NO\"\n\n    interval_obj1 = Interval(interval1[0], interval1[1])\n    interval_obj2 = Interval(interval2[0], interval2[1])\n\n    intersecting_interval = IntervalService.calculate_intersection(interval_obj1, interval_obj2)\n\n    if intersecting_interval is None:\n        return PRIME_NO_RESPONSE\n\n    intersection_length = intersecting_interval.length()\n    \n    if PrimeService.is_prime(intersection_length):\n        return PRIME_YES_RESPONSE\n    else:\n        return PRIME_NO_RESPONSE"}
{"task_id": "HumanEval/131", "solution": "def digits(n: int) -> int:\n    \"\"\"Given a positive integer n, return the product of its odd digits. Returns 0 if all digits are even.\"\"\"\n    product = 1\n    has_odd_digit = False\n\n    temp_n = n\n    while temp_n > 0:\n        digit = temp_n % 10\n        if digit % 2 != 0:  # Check if digit is odd\n            product *= digit\n            has_odd_digit = True\n        temp_n //= 10\n\n    if not has_odd_digit:\n        return 0\n    return product"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Returns 0 if all digits are even.\n    \"\"\"\n    product = 1\n    found_odd_digit = False\n\n    # Iterate through each digit by converting the number to a string.\n    for char_digit in str(n):\n        digit = int(char_digit)\n        if digit % 2 != 0:  # Check if the digit is odd.\n            product *= digit\n            found_odd_digit = True\n\n    # Return 0 if no odd digits were found, otherwise return the product.\n    if not found_odd_digit:\n        return 0\n    return product"}
