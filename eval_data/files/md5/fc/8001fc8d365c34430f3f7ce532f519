{"task_id": "HumanEval/44", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters in base conversion.\"\"\"\n    pass\ndef change_base(x: int, base: int) -> str:\n    \"\"\"Converts a non-negative integer x to its string representation in the specified base (2-9).\n    Raises InvalidInputError for invalid input parameters.\n    \"\"\"\n    if not isinstance(x, int) or x < 0:\n        raise InvalidInputError(\"Input 'x' must be a non-negative integer.\")\n    if not isinstance(base, int) or not (2 <= base <= 9):\n        raise InvalidInputError(\"Input 'base' must be an integer between 2 and 9 (inclusive).\")\n\n    if x == 0:\n        return \"0\"\n\n    result = []\n    current_x = x\n    while current_x > 0:\n        remainder = current_x % base\n        result.append(str(remainder))\n        current_x //= base\n    \n    return \"\".join(reversed(result))"}
{"task_id": "HumanEval/41", "solution": "def car_race_collision(n: int) -> int:\n    \"\"\"\n    Imagine a road that's a perfectly straight infinitely long line.\n    n cars are driving left to right; simultaneously, a different set of n cars\n    are driving right to left. The two sets of cars start out being very far from\n    each other. All cars move in the same speed. Two cars are said to collide\n    when a car that's moving left to right hits a car that's moving right to left.\n    However, the cars are infinitely sturdy and strong; as a result, they continue moving\n    in their trajectory as if they did not collide.\n\n    This function outputs the number of such collisions.\n\n    Args:\n        n: The number of cars in each opposing set.\n\n    Returns:\n        The total number of collisions.\n\n    Raises:\n        ValueError: If 'n' is not an integer or is negative.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' cannot be negative.\")\n\n    return n * n"}
{"task_id": "HumanEval/42", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception raised when input data is invalid (e.g., non-integer elements).\"\"\"\n    def __init__(self, message: str = \"Invalid input provided.\"):\n        self.message = message\n        super().__init__(self.message)\nclass ListIncrementer:\n    \"\"\"Service class responsible for incrementing elements in a list.\"\"\"\n    def increment_elements(self, data: list) -> list:\n        \"\"\"Returns a new list with each element from the input list incremented by 1.\"\"\"\n        self._validate_input(data)\n        return [x + 1 for x in data]\n\n    def _validate_input(self, data: list) -> None:\n        \"\"\"Validates that the input is a list of integers, raising TypeError or InvalidInputError.\"\"\"\n        if not isinstance(data, list):\n            raise TypeError(\"Input must be a list.\")\n        for item in data:\n            if not isinstance(item, int):\n                raise InvalidInputError(f\"All elements in the list must be integers. Found: {type(item).__name__}\")\ndef incr_list(l: list):\n    \"\"\"Return list with elements incremented by 1.\n    >>> incr_list([1, 2, 3])\n    [2, 3, 4]\n    >>> incr_list([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [6, 4, 6, 3, 4, 4, 10, 1, 124]\n    \"\"\"\n    incrementer = ListIncrementer()\n    return incrementer.increment_elements(l)"}
{"task_id": "HumanEval/45", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters in geometry calculations.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef triangle_area(a, h):\n    \"\"\"Given length of a side and high return area for a triangle.\n    >>> triangle_area(5, 3)\n    7.5\n    \"\"\"\n    if not isinstance(a, (int, float)):\n        raise InvalidInputError(\"Base must be a number.\")\n    if a <= 0:\n        raise InvalidInputError(\"Base must be a positive number.\")\n\n    if not isinstance(h, (int, float)):\n        raise InvalidInputError(\"Height must be a number.\")\n    if h <= 0:\n        raise InvalidInputError(\"Height must be a positive number.\")\n\n    return 0.5 * a * h"}
{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    Checks if there are two distinct elements in the list that sum to zero.\n    Raises TypeError or ValueError for invalid input types.\n    \"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"Input must be a list.\")\n\n    seen_numbers = set()\n    for num in l:\n        if not isinstance(num, int):\n            raise ValueError(\"All elements in the list must be integers.\")\n\n        complement = -num\n        if complement in seen_numbers:\n            return True\n        seen_numbers.add(num)\n    return False"}
{"task_id": "HumanEval/45", "solution": "def triangle_area(a, h):\n    \"\"\"Given length of a side and high return area for a triangle.\n    >>> triangle_area(5, 3)\n    7.5\n    \"\"\"\n    if not isinstance(a, (int, float)) or a <= 0:\n        raise ValueError(\"base (a) must be a positive number.\")\n    if not isinstance(h, (int, float)) or h <= 0:\n        raise ValueError(\"height (h) must be a positive number.\")\n    return (a * h) / 2"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int) -> str:\n    \"\"\"Converts a positive integer `x` from base 10 to a specified target `base`.\n    The target base must be an integer between 2 and 9, returning the result as a string.\n    \"\"\"\n    _validate_input(x)\n    _validate_base(base)\n\n    if x == 0:\n        return \"0\"\n\n    result = []\n    current_x = x\n    while current_x > 0:\n        remainder = current_x % base\n        result.append(str(remainder))\n        current_x //= base\n    \n    return \"\".join(result[::-1])"}
