{"task_id": "HumanEval/124", "solution": "import re\ndef valid_date(date: str) -> bool:\n    \"\"\"Validates a date string against predefined rules and format 'mm-dd-yyyy'.\n    Returns True if the date is valid, False otherwise.\"\"\"\n\n    if not date:\n        return False\n\n    def _is_leap_year(year_val: int) -> bool:\n        \"\"\"Determines if a given year is a leap year based on standard rules.\"\"\"\n        return (year_val % 4 == 0 and year_val % 100 != 0) or (year_val % 400 == 0)\n\n    def _parse_date_components(date_string_val: str) -> tuple[int, int, int] | None:\n        \"\"\"Parses the 'mm-dd-yyyy' format string into integer month, day, and year.\"\"\"\n        match = re.fullmatch(r'(\\d{2})-(\\d{2})-(\\d{4})', date_string_val)\n        if not match:\n            return None\n        try:\n            month_val = int(match.group(1))\n            day_val = int(match.group(2))\n            year_val = int(match.group(3))\n            return month_val, day_val, year_val\n        except ValueError:\n            return None\n\n    def _validate_month(month_val: int) -> bool:\n        \"\"\"Checks if the month is between 1 and 12, inclusive.\"\"\"\n        return 1 <= month_val <= 12\n\n    def _validate_day(day_val: int, month_val: int, year_val: int) -> bool:\n        \"\"\"Validates the day based on the month and year, including leap year for February.\"\"\"\n        if not (1 <= day_val):\n            return False\n\n        months_31_days = [1, 3, 5, 7, 8, 10, 12]\n        months_30_days = [4, 6, 9, 11]\n        february = 2\n\n        if month_val in months_31_days:\n            return day_val <= 31\n        elif month_val in months_30_days:\n            return day_val <= 30\n        elif month_val == february:\n            max_feb_day = 29 if _is_leap_year(year_val) else 28\n            return day_val <= max_feb_day\n        else:\n            return False\n\n    components = _parse_date_components(date)\n    if components is None:\n        return False\n\n    month, day, year = components\n\n    if not _validate_month(month):\n        return False\n\n    if not _validate_day(day, month, year):\n        return False\n\n    return True"}
{"task_id": "HumanEval/126", "solution": "from collections import Counter\ndef is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n\n    Examples\n    is_sorted([5]) \u279e True\n    is_sorted([1, 2, 3, 4, 5]) \u279e True\n    is_sorted([1, 3, 2, 4, 5]) \u279e False\n    is_sorted([1, 2, 3, 4, 5, 6]) \u279e True\n    is_sorted([1, 2, 3, 4, 5, 6, 7]) \u279e True\n    is_sorted([1, 3, 2, 4, 5, 6, 7]) \u279e False\n    is_sorted([1, 2, 2, 3, 3, 4]) \u279e True\n    is_sorted([1, 2, 2, 2, 3, 4]) \u279e False\n    '''\n    if not lst:\n        return True\n\n    # Check for ascending order.\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    # Check for duplicate constraint (max 2 occurrences).\n    counts = Counter(lst)\n    for count in counts.values():\n        if count > 2:\n            return False\n\n    return True"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    \"\"\"\n    Splits a string by whitespace, then by commas if no whitespace,\n    otherwise counts lowercase letters with odd alphabetical order.\n    \"\"\"\n    if ' ' in txt:\n        return txt.split()\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        # Count lowercase letters with odd alphabetical order as a fallback.\n        count = 0\n        alphabet_offset = ord('a')\n        for char in txt:\n            if char.islower():\n                order = ord(char) - alphabet_offset\n                if order % 2 != 0:\n                    count += 1\n        return count"}
{"task_id": "HumanEval/124", "solution": "import datetime\ndef valid_date(date):\n    \"\"\"You have to write a function which validates a given date string and\n    returns True if the date is valid otherwise False.\n    The date is valid if all of the following rules are satisfied:\n    1. The date string is not empty.\n    2. The number of days is not less than 1 or higher than 31 days for months 1,3,5,7,8,10,12. And the number of days is not less than 1 or higher than 30 days for months 4,6,9,11. And, the number of days is not less than 1 or higher than 29 for the month 2.\n    3. The months should not be less than 1 or higher than 12.\n    4. The date should be in the format: mm-dd-yyyy\n\n    for example: \n    valid_date('03-11-2000') => True\n\n    valid_date('15-01-2012') => False\n\n    valid_date('04-0-2040') => False\n\n    valid_date('06-04-2020') => True\n\n    valid_date('06/04/2020') => False\n    \"\"\"\n    # Constants for date validation, moved inside the function\n    DATE_FORMAT = \"%m-%d-%Y\"\n    DAYS_IN_MONTH_MAP = {\n        1: 31,  # January\n        2: 28,  # February (default, adjusted for leap year)\n        3: 31,  # March\n        4: 30,  # April\n        5: 31,  # May\n        6: 30,  # June\n        7: 31,  # July\n        8: 31,  # August\n        9: 30,  # September\n        10: 31, # October\n        11: 30, # November\n        12: 31  # December\n    }\n    LEAP_YEAR_FEB_DAYS = 29\n    NON_LEAP_YEAR_FEB_DAYS = 28\n\n    # Helper function to determine if a year is a leap year, nested inside valid_date\n    def _is_leap_year(year: int) -> bool:\n        return (year % 4 == 0 and year % 100 != 0) or (year % 400 == 0)\n\n    if not date: # Rule 1: The date string is not empty.\n        return False\n\n    try:\n        # Rule 4: The date should be in the format: mm-dd-yyyy\n        # strptime implicitly validates month range [1,12] (Rule 3) and day >= 1.\n        dt_obj = datetime.datetime.strptime(date, DATE_FORMAT)\n        month, day, year = dt_obj.month, dt_obj.day, dt_obj.year\n    except ValueError:\n        return False\n\n    # Rule 2: Validate the number of days for each month, including leap year for February.\n    max_days = DAYS_IN_MONTH_MAP[month]\n    if month == 2: # February\n        max_days = LEAP_YEAR_FEB_DAYS if _is_leap_year(year) else NON_LEAP_YEAR_FEB_DAYS\n    \n    if not (1 <= day <= max_days): # Ensure day is within the calculated maximum.\n        return False\n\n    return True # All validation rules are satisfied."}
{"task_id": "HumanEval/125", "solution": "def _is_odd_ordered_lowercase(char: str) -> bool:\n    \"\"\"Checks if a character is a lowercase English letter with an odd 0-indexed alphabetical order.\"\"\"\n    if 'a' <= char <= 'z':\n        return (ord(char) - ord('a')) % 2 != 0\n    return False\ndef split_words(txt):\n    \"\"\"\n    Splits a string by whitespace, then by commas if no whitespace,\n    otherwise counts odd-ordered lowercase letters.\n    \"\"\"\n    if not isinstance(txt, str):\n        raise TypeError(\"Input must be a string.\")\n\n    if any(c.isspace() for c in txt):\n        return txt.split()\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        count = 0\n        for char in txt:\n            if _is_odd_ordered_lowercase(char):\n                count += 1\n        return count"}
{"task_id": "HumanEval/126", "solution": "import collections\ndef is_sorted(lst):\n    \"\"\"\n    Checks if a list of non-negative integers is sorted in ascending order and has at most one duplicate of any number.\n    Returns True if valid, False otherwise.\n    \"\"\"\n    # Check for ascending order. Empty or single-element lists are considered sorted.\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    # Check that no number appears more than twice (i.e., count > 2 implies more than one duplicate).\n    counts = collections.Counter(lst)\n    for count in counts.values():\n        if count > 2:\n            return False\n\n    return True"}
