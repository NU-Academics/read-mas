{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a \n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not \n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries. \n    \n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    if not lst:\n        return 0\n\n    # Create a mutable copy to avoid modifying the original list.\n    processed_list = list(lst)\n\n    for i, item in enumerate(processed_list):\n        if i % 3 == 0:\n            processed_list[i] = item * item\n        elif i % 4 == 0:  # This condition implies i % 3 != 0 due to the prior check.\n            processed_list[i] = item * item * item\n        # else: item remains unchanged\n\n    return sum(processed_list)"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    Calculates the sum of elements after applying index-based transformations.\n    Elements are squared if the index is a multiple of 3, cubed if the index is a multiple of 4 (and not 3), and unchanged otherwise.\n    \"\"\"\n    processed_list = []\n    for i, num in enumerate(lst):\n        if i % 3 == 0:\n            processed_list.append(num * num)\n        elif i % 4 == 0:  # This condition inherently implies i % 3 != 0 because of the preceding 'if'.\n            processed_list.append(num * num * num)\n        else:\n            processed_list.append(num)\n    return sum(processed_list)"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Checks if a file's name is valid based on specific conditions.\n    Returns 'Yes' if the file's name is valid, and 'No' otherwise.\"\"\"\n\n    ALLOWED_EXTENSIONS = ['txt', 'exe', 'dll']\n    MAX_DIGITS = 3\n\n    # FR1 / BR1: Count digits; must not be more than MAX_DIGITS.\n    digit_count = sum(1 for char in file_name if '0' <= char <= '9')\n    if digit_count > MAX_DIGITS:\n        return 'No'\n\n    # FR2 / BR2: Check for exactly one dot.\n    dot_count = file_name.count('.')\n    if dot_count != 1:\n        return 'No'\n\n    # FR3, FR6: Split the file name into its base name and extension.\n    name_part, extension_part = file_name.split('.')\n\n    # FR4 / BR3: Substring before the dot must not be empty.\n    if not name_part:\n        return 'No'\n\n    # FR5 / BR4: Substring before the dot must start with a letter.\n    if not name_part[0].isalpha():\n        return 'No'\n\n    # FR7 / BR5: Extension must be in the allowed list.\n    if extension_part not in ALLOWED_EXTENSIONS:\n        return 'No'\n\n    # FR8: All conditions met.\n    return 'Yes'"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Filters words from a sentence, keeping only those with prime lengths.\n    The order of words is preserved in the output string.\n    \"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"\n        Checks if an integer is a prime number.\n        Numbers less than 2 are not prime.\n        \"\"\"\n        if n < 2:\n            return False\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 1\n        return True\n\n    words = sentence.split(' ')\n    filtered_words = []\n    for word in words:\n        if is_prime(len(word)):\n            filtered_words.append(word)\n\n    return ' '.join(filtered_words)"}
{"task_id": "HumanEval/145", "solution": "def _sum_digits(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the absolute value of digits of an integer.\n    It iteratively adds the last digit and removes it.\n    \"\"\"\n    s = 0\n    n_abs = abs(n)\n    while n_abs > 0:\n        s += n_abs % 10\n        n_abs //= 10\n    return s\ndef order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers by the sum of their digits, breaking ties by original index.\n    It uses a decorate-sort-undecorate pattern for efficient custom sorting.\n    \"\"\"\n    if not nums:\n        return []\n\n    decorated_list = []\n    for i, num in enumerate(nums):\n        decorated_list.append((_sum_digits(num), i, num))\n\n    decorated_list.sort()\n\n    return [item[2] for item in decorated_list]"}
