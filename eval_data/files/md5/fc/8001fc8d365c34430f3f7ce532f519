{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    \"\"\"\n    Finds the largest negative and smallest positive integers in a list.\n    Returns a tuple (largest_negative, smallest_positive) or None if not found.\n    \"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"Input must be a list.\")\n\n    largest_negative = None\n    smallest_positive = None\n\n    for num in lst:\n        if not isinstance(num, int):\n            raise TypeError(\"List elements must be integers.\")\n\n        if num < 0:\n            if largest_negative is None or num > largest_negative:\n                largest_negative = num\n        elif num > 0:\n            if smallest_positive is None or num < smallest_positive:\n                smallest_positive = num\n\n    return (largest_negative, smallest_positive)"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"Create a function which returns the largest index of an element which\n    is not greater than or equal to the element immediately preceding it. If\n    no such element exists then return -1. The given array will not contain\n    duplicate values.\n\n    Examples:\n    can_arrange([1,2,4,3,5]) = 3\n    can_arrange([1,2,3]) = -1\n    \"\"\"\n    if len(arr) < 2:\n        return -1\n\n    for i in range(len(arr) - 1, 0, -1):\n        if arr[i] < arr[i-1]:\n            return i\n\n    return -1"}
{"task_id": "HumanEval/136", "solution": "from typing import List, Optional, Tuple\ndef largest_smallest_integers(lst: List[int]) -> Tuple[Optional[int], Optional[int]]:\n    \"\"\"\n    Finds the largest negative integer and the smallest positive integer in a list.\n    Returns None for either if no such integers are found.\n    \"\"\"\n    largest_neg = None\n    smallest_pos = None\n\n    for num in lst:\n        if num < 0:\n            if largest_neg is None or num > largest_neg:\n                largest_neg = num\n        elif num > 0:\n            if smallest_pos is None or num < smallest_pos:\n                smallest_pos = num\n\n    return (largest_neg, smallest_pos)"}
{"task_id": "HumanEval/137", "solution": "from typing import Union, Optional\ndef _parse_to_float(value: Union[int, float, str]) -> float:\n    \"\"\"\n    Converts a value to a float. Handles comma as a decimal separator in strings.\n    Raises TypeError for unsupported input types and ValueError for unparseable strings.\n    \"\"\"\n    if isinstance(value, (int, float)):\n        return float(value)\n    elif isinstance(value, str):\n        try:\n            return float(value.replace(',', '.'))\n        except ValueError:\n            raise ValueError(f\"Cannot parse string '{value}' to a float.\")\n    else:\n        raise TypeError(f\"Unsupported type for comparison: {type(value)}\")\ndef compare_one(a: Union[int, float, str], b: Union[int, float, str]) -> Optional[Union[int, float, str]]:\n    \"\"\"\n    Compares two values and returns the numerically larger in its original type.\n    Returns None if the values are numerically equal.\n    \"\"\"\n    parsed_a = _parse_to_float(a)\n    parsed_b = _parse_to_float(b)\n\n    if parsed_a > parsed_b:\n        return a\n    elif parsed_b > parsed_a:\n        return b\n    else:\n        return None"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers.\n    Returns True if n is an even number greater than or equal to 8, False otherwise.\n    \"\"\"\n    # The smallest sum of 4 positive even numbers is 2 + 2 + 2 + 2 = 8.\n    # Any sum of 4 even numbers must itself be an even number.\n    return n % 2 == 0 and n >= 8"}
{"task_id": "HumanEval/137", "solution": "from typing import Union\ndef compare_one(a: Union[int, float, str], b: Union[int, float, str]) -> Union[int, float, str, None]:\n    \"\"\"\n    Compares two values and returns the larger one in its original type.\n    Returns None if the values are numerically equal, handling string number formats.\n    \"\"\"\n\n    def _to_float_internal(value: Union[int, float, str]) -> float:\n        \"\"\"Helper to convert value to float, handling string decimal separators.\"\"\"\n        if isinstance(value, (int, float)):\n            return float(value)\n        elif isinstance(value, str):\n            cleaned_value = value.replace(',', '.')\n            try:\n                return float(cleaned_value)\n            except ValueError:\n                raise ValueError(f\"Cannot convert string '{value}' to a float.\")\n        else:\n            raise TypeError(f\"Unsupported type for conversion: {type(value)}\")\n\n    try:\n        a_numeric = _to_float_internal(a)\n        b_numeric = _to_float_internal(b)\n    except ValueError as e:\n        raise ValueError(f\"Invalid input for comparison: {e}\") from e\n    except TypeError as e:\n        raise TypeError(f\"Unsupported input type for comparison: {e}\") from e\n\n    if a_numeric > b_numeric:\n        return a\n    elif b_numeric > a_numeric:\n        return b\n    else:\n        return None"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n: int) -> bool:\n    \"\"\"\n    Evaluates if n can be written as the sum of exactly four positive even numbers.\n    The minimum sum is 8 (2+2+2+2), and the sum of four even numbers must be even.\n    \"\"\"\n    if n < 8:\n        return False\n    if n % 2 != 0:\n        return False\n    return True"}
{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text: str) -> str:\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores, \n    and if a string has more than 2 consecutive spaces, \n    then replace all consecutive spaces with - \n    \n    fix_spaces(\"Example\") == \"Example\"\n    fix_spaces(\"Example 1\") == \"Example_1\"\n    fix_spaces(\" Example 2\") == \"_Example_2\"\n    fix_spaces(\" Example   3\") == \"_Example-3\"\n    \"\"\"\n    # Replace sequences of 3 or more spaces with a single hyphen.\n    text = re.sub(r' {3,}', '-', text)\n    # Replace single spaces with underscores, including any remaining from double spaces.\n    text = text.replace(' ', '_')\n    return text"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Invalid input: n must be a positive integer.\")\n\n    def _calculate_factorial_helper(k):\n        \"\"\"Calculates the standard factorial k!.\"\"\"\n        if k == 0:\n            return 1\n        \n        fact = 1\n        for i in range(1, k + 1):\n            fact *= i\n        return fact\n\n    result = 1\n    for i in range(1, n + 1):\n        result *= _calculate_factorial_helper(i)\n    return result"}
{"task_id": "HumanEval/139", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef _calculate_factorial(k: int) -> int:\n    \"\"\"Calculates the standard factorial of a non-negative integer k.\"\"\"\n    if k < 0:\n        raise ValueError(\"Factorial is not defined for negative numbers.\")\n    if k == 0:\n        return 1\n    result = 1\n    for i in range(1, k + 1):\n        result *= i\n    return result\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise InvalidInputError(\"Input 'n' must be a positive integer.\")\n\n    special_fact_result = 1\n    for i in range(1, n + 1):\n        special_fact_result *= _calculate_factorial(i)\n    return special_fact_result"}
{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text):\n    \"\"\"\n    Standardizes string formatting by replacing specific space patterns.\n    Replaces sequences of 3+ spaces with a hyphen, then single spaces with underscores.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input must be a string.\")\n    \n    # First, replace sequences of more than two consecutive spaces with a hyphen\n    processed_text = re.sub(r' {3,}', '-', text)\n    \n    # Then, replace all remaining single spaces with underscores\n    processed_text = processed_text.replace(' ', '_')\n    \n    return processed_text"}
