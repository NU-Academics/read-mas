{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Calculates the first n + 1 Tribonacci numbers using memoization.\n\n    The sequence follows specific recurrence relations for k=0, k=1, even k, and odd k.\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n\n    memo = {}\n\n    def _calculate_single_tri(k: int) -> int:\n        \"\"\"Computes a single Tribonacci number tri(k) recursively with memoization.\"\"\"\n        if k in memo:\n            return memo[k]\n\n        if k == 0:\n            result = 1\n        elif k == 1:\n            result = 3\n        elif k % 2 == 0:  # k is even and k > 1\n            result = 1 + k // 2\n        else:  # k is odd and k > 1\n            val_k_minus_1 = _calculate_single_tri(k - 1)\n            val_k_minus_2 = _calculate_single_tri(k - 2)\n            val_k_plus_1 = _calculate_single_tri(k + 1)\n            result = val_k_minus_1 + val_k_minus_2 + val_k_plus_1\n\n        memo[k] = result\n        return result\n\n    # Populate memoization table up to n+1 to handle tri(k+1) dependency for odd k.\n    for i in range(n + 2):\n        _calculate_single_tri(i)\n\n    # Collect results for k from 0 to n.\n    result_sequence = [memo[i] for i in range(n + 1)]\n    return result_sequence"}
{"task_id": "HumanEval/129", "solution": "class Cell:\n    \"\"\"Represents a single cell in the grid with its coordinates and value.\"\"\"\n    def __init__(self, row: int, col: int, value: int):\n        self._row = row\n        self._col = col\n        self._value = value\n\n    def get_row(self) -> int:\n        return self._row\n\n    def get_col(self) -> int:\n        return self._col\n\n    def get_value(self) -> int:\n        return self._value\n\n    def __eq__(self, other: object) -> bool:\n        if not isinstance(other, Cell):\n            return NotImplemented\n        # Compares two Cell objects for equality based on row, col, and value.\n        return self._row == other._row and self._col == other._col and self._value == other._value\n\n    def __hash__(self) -> int:\n        # Enables Cell objects to be used in sets/dictionaries.\n        return hash((self._row, self._col, self._value))\nclass Path:\n    \"\"\"Represents a sequence of visited cells and their values for lexicographical comparison.\"\"\"\n    def __init__(self, initial_cells: list[Cell], initial_values: list[int]):\n        self._cells = list(initial_cells)\n        self._values = list(initial_values)\n\n    def add_cell(self, cell: Cell) -> 'Path':\n        # Returns a new Path instance with the added cell, ensuring immutability for backtracking.\n        return Path(self._cells + [cell], self._values + [cell.get_value()])\n\n    def get_values(self) -> list[int]:\n        return self._values\n\n    def get_length(self) -> int:\n        return len(self._values)\n\n    def __lt__(self, other: 'Path') -> bool:\n        # Implements lexicographical comparison for paths based on their values.\n        return self._values < other._values\nclass Grid:\n    \"\"\"Encapsulates grid data, providing methods for accessing cell values and objects.\"\"\"\n    def __init__(self, grid_data: list[list[int]]):\n        if not isinstance(grid_data, list) or not all(isinstance(row, list) for row in grid_data):\n            raise ValueError(\"Grid must be a list of lists.\")\n        N = len(grid_data)\n        if N < 2 or not all(len(row) == N for row in grid_data):\n            raise ValueError(\"Grid must be an N x N grid with N >= 2.\")\n\n        self._N = N\n        self._grid_data = grid_data\n\n    def get_N(self) -> int:\n        return self._N\n\n    def get_value(self, row: int, col: int) -> int:\n        return self._grid_data[row][col]\n\n    def get_cell(self, row: int, col: int) -> Cell:\n        # Creates and returns a Cell object for the given coordinates.\n        return Cell(row, col, self.get_value(row, col))\nDIRECTIONS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\ndef is_valid_coordinate(row: int, col: int, N: int) -> bool:\n    # Checks if a given (row, col) coordinate is within the N x N grid boundaries.\n    return 0 <= row < N and 0 <= col < N\nclass PathFinderService:\n    \"\"\"Implements the core algorithm to find the lexicographically smallest path of length k.\"\"\"\n    def __init__(self):\n        self._grid_obj: Grid | None = None\n        self._k: int = 0\n        self._min_path_values: list[int] = []\n\n    def find_min_path(self, grid_data: list[list[int]], k_val: int) -> list[int]:\n        # Main entry point: Validates input, initializes grid, and iterates through all starting cells to initiate DFS.\n        # Returns the values of the minimum path.\n        if not isinstance(grid_data, list) or not all(isinstance(row, list) for row in grid_data):\n            raise ValueError(\"Grid must be a list of lists.\")\n        N = len(grid_data)\n        if N < 2 or not all(len(row) == N for row in grid_data):\n            raise ValueError(\"Grid must be an N x N grid with N >= 2.\")\n        if not isinstance(k_val, int) or k_val <= 0:\n            raise ValueError(\"k must be a positive integer.\")\n\n        self._grid_obj = Grid(grid_data)\n        self._k = k_val\n        # Initialize _min_path_values with values larger than any possible grid value.\n        self._min_path_values = [N * N + 1] * self._k \n\n        for r in range(N):\n            for c in range(N):\n                start_cell = self._grid_obj.get_cell(r, c)\n                initial_path = Path([start_cell], [start_cell.get_value()])\n                self._dfs(start_cell, initial_path)\n        \n        return self._min_path_values\n\n    def _dfs(self, current_cell: Cell, current_path: Path) -> None:\n        # Recursive Depth-First Search function to explore paths.\n        # It updates self._min_path_values if a smaller path is found.\n        if current_path.get_length() == self._k:\n            if current_path.get_values() < self._min_path_values:\n                self._min_path_values = current_path.get_values()\n            return\n\n        if current_path.get_length() > self._k: # Pruning: The current path has exceeded the desired length k.\n            return\n\n        # Pruning: If the current path's values are already lexicographically greater than or equal to the best found path's prefix, stop exploring this branch.\n        if current_path.get_values() >= self._min_path_values[:current_path.get_length()]:\n             return\n\n        N = self._grid_obj.get_N()\n        for dr, dc in DIRECTIONS:\n            next_row, next_col = current_cell.get_row() + dr, current_cell.get_col() + dc\n            if is_valid_coordinate(next_row, next_col, N):\n                next_cell = self._grid_obj.get_cell(next_row, next_col)\n                new_path = current_path.add_cell(next_cell) # Creates a new path instance for the next step.\n                self._dfs(next_cell, new_path)\ndef minPath(grid: list[list[int]], k: int) -> list[int]:\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k, \n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n    \"\"\"\n    service = PathFinderService()\n    return service.find_min_path(grid, k)"}
{"task_id": "HumanEval/133", "solution": "import math\ndef sum_squares(lst):\n    \"\"\"\n    Calculates the sum of squared numbers in the given list,\n    rounding each element to the upper integer (Ceiling) first.\n    Raises TypeError if any list element is not a number.\n    \"\"\"\n    total_sum = 0\n    for num in lst:\n        if not isinstance(num, (int, float)):\n            raise TypeError(f\"List elements must be numbers, got {type(num)}\")\n        rounded_num = math.ceil(num)\n        total_sum += rounded_num * rounded_num\n    return total_sum"}
{"task_id": "HumanEval/132", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input strings.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef is_nested(string):\n    '''\n    Create a function that takes a string as input which contains only square brackets.\n    The function should return True if and only if there is a valid subsequence of brackets \n    where at least one bracket in the subsequence is nested.\n\n    is_nested('[[]]') \u279e True\n    is_nested('[]]]]]]][[[[[]') \u279e False\n    is_nested('[][]') \u279e False\n    is_nested('[]') \u279e False\n    is_nested('[[][]]') \u279e True\n    is_nested('[[]][[') \u279e True\n    '''\n    \n    # Helper function to check if a substring is a balanced bracket sequence.\n    def _is_balanced(s: str) -> bool:\n        \"\"\"Checks if a given string of brackets is balanced.\"\"\"\n        stack = []\n        for char in s:\n            if char == '[':\n                stack.append(char)\n            elif char == ']':\n                if not stack:\n                    return False\n                stack.pop()\n        return not stack\n\n    # Input validation, raising an error if non-bracket characters are found.\n    for char in string:\n        if char not in ('[', ']'):\n            raise InvalidInputError(f\"Invalid character '{char}' found. Only square brackets are allowed.\")\n\n    # Handle an empty input string as per requirements.\n    if not string:\n        return False\n\n    n = len(string)\n    # Iterate through all possible outer opening brackets.\n    for i in range(n):\n        if string[i] == '[':\n            # For each opening bracket, iterate through all possible closing brackets to its right.\n            for j in range(i + 1, n):\n                if string[j] == ']':\n                    # Extract the substring between the outer brackets.\n                    inner_substring = string[i+1:j]\n                    # Check if this inner substring is non-empty and a valid bracket sequence.\n                    if inner_substring and _is_balanced(inner_substring):\n                        return True\n    return False"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Checks if the last character of `txt` is an alphabetical character and is not part of a word.\n    A \"word\" is defined as a group of characters separated by space.\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    if len(txt) == 1:\n        return True\n\n    char_before_last = txt[-2]\n    if char_before_last == ' ':\n        return True\n\n    return False"}
{"task_id": "HumanEval/133", "solution": "import math\ndef sum_squares(lst):\n    \"\"\"Calculates the sum of squares of numbers in a list,\n    rounding each element up to the nearest integer first.\n    \"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"Input must be a list.\")\n\n    total_sum = 0\n    for num in lst:\n        if not isinstance(num, (int, float)):\n            raise TypeError(\"All elements in the list must be numbers.\")\n        \n        rounded_num = int(math.ceil(num))\n        total_sum += rounded_num * rounded_num\n        \n    return total_sum"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    \"\"\"\n    Checks if a string of square brackets contains a nested subsequence.\n    A nested subsequence requires finding `[`, `[`, `]`, `]` in order.\n    \"\"\"\n    valid_bracket_chars = \"[]\"\n    for char in string:\n        if char not in valid_bracket_chars:\n            raise ValueError(\"Input string must contain only '[' and ']' characters.\")\n\n    # State machine to find the subsequence `[[...]]`\n    # state 0: looking for 1st '['\n    # state 1: looking for 2nd '['\n    # state 2: looking for 1st ']' (for the inner pair)\n    # state 3: looking for 2nd ']' (for the outer pair)\n    state = 0 \n    for char in string:\n        if char == '[':\n            if state == 0:\n                state = 1\n            elif state == 1:\n                state = 2\n            # If state is 2 or 3 and we find '[', we stay in that state\n            # as it's an inner open bracket, and we're still looking for the next required closing bracket.\n        elif char == ']':\n            if state == 2:\n                state = 3\n            elif state == 3:\n                return True # Found the pattern `[[...]]`\n\n    return False"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    '''\n    Create a function that returns True if the last character\n    of a given string is an alphabetical character and is not\n    a part of a word, and False otherwise.\n    Note: \"word\" is a group of characters separated by space.\n\n    Examples:\n    check_if_last_char_is_a_letter(\"apple pie\") \u279e False\n    check_if_last_char_is_a_letter(\"apple pi e\") \u279e True\n    check_if_last_char_is_a_letter(\"apple pi e \") \u279e False\n    check_if_last_char_is_a_letter(\"\") \u279e False \n    '''\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    if len(txt) == 1:\n        return True\n    else:\n        return txt[-2] == ' '"}
