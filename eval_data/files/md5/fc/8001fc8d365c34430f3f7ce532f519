{"task_id": "HumanEval/24", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to the largest_divisor function.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef largest_divisor(n: int) -> int:\n    \"\"\"\n    For a given number n, find the largest number that divides n evenly, smaller than n\n    >>> largest_divisor(15)\n    5\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n <= 1:\n        raise InvalidInputError(\"Input must be a positive integer greater than 1.\")\n\n    for i in range(n // 2, 0, -1):\n        if n % i == 0:\n            return i"}
{"task_id": "HumanEval/24", "solution": "def largest_divisor(n: int) -> int:\n    \"\"\"\n    Finds the largest number that divides n evenly, smaller than n.\n    Returns n for n <= 1 as per specification.\n    \"\"\"\n    if n <= 1:\n        return n\n    # Iterate downwards from n // 2 to 1 to find the first divisor.\n    for i in range(n // 2, 0, -1):\n        if n % i == 0:\n            return i\n    # This point is reached only if n has no divisors other than itself and 1,\n    # and the loop for i=1 correctly returns 1.\n    return 1"}
{"task_id": "HumanEval/4", "solution": "from typing import List\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    if not numbers:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    # Ensure all elements are numbers (float or int) as per design spec.\n    if not all(isinstance(x, (int, float)) for x in numbers):\n        raise TypeError(\"All elements in the input list must be numbers.\")\n\n    # Calculate the mean of the dataset.\n    data_mean = sum(numbers) / len(numbers)\n\n    # Calculate the absolute differences from the mean for each number.\n    absolute_differences = [abs(x - data_mean) for x in numbers]\n\n    # Return the mean of these absolute differences.\n    return sum(absolute_differences) / len(absolute_differences)"}
{"task_id": "HumanEval/25", "solution": "from typing import List\ndef factorize(n: int) -> List[int]:\n    \"\"\"Return a list of prime factors for the given integer n, in ascending order and with correct multiplicity.\n    The input number n must be an integer greater than or equal to 2.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n    if n < 2:\n        raise ValueError(\"Input must be an integer greater than or equal to 2.\")\n\n    factors = []\n    d = 2\n    temp_n = n\n    while d * d <= temp_n:\n        while temp_n % d == 0:\n            factors.append(d)\n            temp_n //= d\n        d += 1\n    if temp_n > 1:\n        factors.append(temp_n)\n    return factors"}
{"task_id": "HumanEval/25", "solution": "from typing import List\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    factors: List[int] = []\n    d = 2\n    temp_n = n\n\n    while d * d <= temp_n:\n        while temp_n % d == 0:\n            factors.append(d)\n            temp_n //= d\n        d += 1\n\n    if temp_n > 1:\n        factors.append(temp_n)\n\n    return factors"}
{"task_id": "HumanEval/26", "solution": "from typing import List, Dict\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\"Removes all elements that occur more than once from a list of integers,\n    preserving the original order of the remaining unique elements.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n    # Validate all elements are integers to meet type requirements.\n    if not all(isinstance(x, int) for x in numbers):\n        raise TypeError(\"All elements in the list must be integers.\")\n\n    # Count occurrences of each number to identify unique elements.\n    counts: Dict[int, int] = {}\n    for num in numbers:\n        counts[num] = counts.get(num, 0) + 1\n\n    # Iterate through the original list to build the result with elements appearing once.\n    result: List[int] = []\n    for num in numbers:\n        if counts[num] == 1:\n            result.append(num)\n\n    return result"}
{"task_id": "HumanEval/26", "solution": "from typing import List\nfrom collections import Counter\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    >>> remove_duplicates([1, 2, 3, 2, 4])\n    [1, 3, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    # Count the occurrences of each number in the list.\n    counts = Counter(numbers)\n\n    # Build a new list containing only elements that appeared exactly once, preserving original order.\n    unique_numbers = [num for num in numbers if counts[num] == 1]\n\n    return unique_numbers"}
