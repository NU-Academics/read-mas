{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int):\n    \"\"\"Return 2^n modulo p (be aware of numerics).\n    This function computes modular exponentiation efficiently.\n    \"\"\"\n    # Validate that n is a non-negative integer as per requirements.\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Exponent 'n' must be a non-negative integer.\")\n    # Validate that p is a positive integer as per requirements.\n    if not isinstance(p, int) or p <= 0:\n        raise ValueError(\"Modulus 'p' must be a positive integer.\")\n\n    # Compute 2^n mod p using Python's built-in pow function for efficiency and robustness.\n    return pow(2, n, p)"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int) -> int:\n    \"\"\"Computes the n-th element of the Fib4 sequence iteratively.\n    Raises ValueError for negative input n.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # Iteratively calculate the Fib4 sequence for n > 3.\n    # 'a', 'b', 'c', 'd' store fib4(i-4), fib4(i-3), fib4(i-2), fib4(i-1) respectively.\n    a, b, c, d = 0, 0, 2, 0  # Initial values for fib4(0), fib4(1), fib4(2), fib4(3)\n\n    for _ in range(4, n + 1):\n        next_fib4 = a + b + c + d\n        a, b, c, d = b, c, d, next_fib4\n    \n    return d"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    if not l:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    # Validate all elements are numeric.\n    for item in l:\n        if not isinstance(item, (int, float)):\n            raise TypeError(\"All elements in the list must be numeric (int or float).\")\n\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    if n % 2 == 1:\n        return sorted_l[n // 2]\n    else:\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        return (mid1 + mid2) / 2"}
