{"task_id": "HumanEval/39", "solution": "import math\nclass FibonacciGenerator:\n    \"\"\"\n    Generates Fibonacci numbers sequentially.\n    \"\"\"\n    def __init__(self):\n        self._current = 0\n        self._next = 1\n\n    def get_next(self) -> int:\n        \"\"\"\n        Returns the next Fibonacci number and updates the internal state.\n        \"\"\"\n        fib_num = self._current\n        self._current, self._next = self._next, self._current + self._next\n        return fib_num\nclass PrimeChecker:\n    \"\"\"\n    Determines if a given integer is a prime number.\n    \"\"\"\n    def is_prime(self, num: int) -> bool:\n        \"\"\"\n        Checks if num is a prime number using trial division up to its square root.\n        Returns True if prime, False otherwise.\n        \"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(num)) + 1, 2):\n            if num % i == 0:\n                return False\n        return True\nclass PrimeFibService:\n    \"\"\"\n    Orchestrates generation of Fibonacci numbers and primality checks.\n    \"\"\"\n    def __init__(self, fib_generator: FibonacciGenerator, prime_checker: PrimeChecker):\n        \"\"\"\n        Initializes the service with instances of FibonacciGenerator and PrimeChecker.\n        \"\"\"\n        self._fib_generator = fib_generator\n        self._prime_checker = prime_checker\n\n    def find_nth_prime_fib(self, n: int) -> int:\n        \"\"\"\n        Finds the n-th number that is both a Fibonacci and a prime number.\n        It consumes initial non-prime Fibonacci numbers (0, 1, 1) to align with the problem's 1-indexed prime Fibonacci sequence.\n        \"\"\"\n        prime_fib_count = 0\n        \n        # Consume initial non-prime Fibonacci numbers (0, 1, 1)\n        self._fib_generator.get_next() # 0\n        self._fib_generator.get_next() # 1\n        self._fib_generator.get_next() # 1\n\n        while True:\n            fib_num = self._fib_generator.get_next()\n            if self._prime_checker.is_prime(fib_num):\n                prime_fib_count += 1\n                if prime_fib_count == n:\n                    return fib_num\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    fib_generator = FibonacciGenerator()\n    prime_checker = PrimeChecker()\n    service = PrimeFibService(fib_generator, prime_checker)\n    return service.find_nth_prime_fib(n)"}
