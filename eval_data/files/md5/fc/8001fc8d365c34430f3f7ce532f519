{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    \"\"\"\n    if not numbers:\n        return (0, 1)\n\n    current_sum = 0\n    current_product = 1\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n    return (current_sum, current_product)"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\"\n    Calculates the sum and product of all integers in a list.\n    An empty list returns a sum of 0 and a product of 1.\n    \"\"\"\n    current_sum = 0\n    current_product = 1\n\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n\n    return (current_sum, current_product)"}
{"task_id": "HumanEval/9", "solution": "from typing import List, Tuple\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    rolling_max_list: List[int] = []\n    # Initialize with negative infinity to ensure the first element is correctly captured.\n    current_max: int = float('-inf')\n\n    for number in numbers:\n        if number > current_max:\n            current_max = number\n        rolling_max_list.append(current_max)\n\n    return rolling_max_list"}
{"task_id": "HumanEval/9", "solution": "from typing import List\nclass RollingMaxCalculator:\n    \"\"\"\n    Calculates the rolling maximum of a list of integers.\n    \"\"\"\n    def __init__(self):\n        \"\"\"\n        Initializes the RollingMaxCalculator.\n        \"\"\"\n        self._current_max = float('-inf')\n\n    def _validate_input(self, numbers: List[int]) -> None:\n        \"\"\"\n        Validates that the input is a list of integers.\n        \"\"\"\n        if not isinstance(numbers, list):\n            raise TypeError(\"Input must be a list.\")\n        for item in numbers:\n            if not isinstance(item, int):\n                raise TypeError(\"All elements in the list must be integers.\")\n\n    def calculate(self, numbers: List[int]) -> List[int]:\n        \"\"\"\n        From a given list of integers, generate a list of rolling maximum element\n        found until given moment in the sequence.\n        \"\"\"\n        self._validate_input(numbers)\n\n        rolling_max_list: List[int] = []\n        self._current_max = float('-inf') # Reset for each calculation.\n\n        for number in numbers:\n            if number > self._current_max:\n                self._current_max = number\n            rolling_max_list.append(int(self._current_max))\n\n        return rolling_max_list\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\"\n    Public API function to calculate the rolling maximum of a list of integers.\n    \"\"\"\n    calculator = RollingMaxCalculator()\n    return calculator.calculate(numbers)"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    return string == string[::-1]\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Find the longest palindromic suffix and append the reverse of the preceding prefix.\n    \"\"\"\n    if not isinstance(string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    if not string:\n        return \"\"\n\n    # Iterate to find the start index of the longest palindromic suffix.\n    # The first suffix found will be the longest as we iterate from the string's start.\n    start_of_palindromic_suffix_index = 0\n    for i in range(len(string)):\n        suffix = string[i:]\n        if is_palindrome(suffix):\n            start_of_palindromic_suffix_index = i\n            break \n    \n    # Construct by reversing the prefix before the palindromic suffix and appending it.\n    prefix_to_reverse = string[:start_of_palindromic_suffix_index]\n    reversed_prefix = prefix_to_reverse[::-1]\n    \n    return string + reversed_prefix"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\"Test if given string is a palindrome.\"\"\"\n    return string == string[::-1]\ndef make_palindrome(string: str) -> str:\n    \"\"\"Find the shortest palindrome that begins with the supplied string.\n    This is done by finding the longest palindromic suffix and reversing the prefix before it.\n    \"\"\"\n    if not string:\n        return \"\"\n\n    longest_palindromic_suffix_len = 0\n    for i in range(len(string)):\n        suffix = string[i:]\n        if is_palindrome(suffix):\n            longest_palindromic_suffix_len = len(suffix)\n            break\n        \n    prefix_to_reverse = string[:len(string) - longest_palindromic_suffix_len]\n    return string + prefix_to_reverse[::-1]"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of a list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_str: Optional[str] = None\n    max_length: int = -1\n\n    for s in strings:\n        current_length = len(s)\n        if current_length > max_length:\n            max_length = current_length\n            longest_str = s\n    return longest_str"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    _validate_binary_string_input(a)\n    _validate_binary_string_input(b)\n    _validate_equal_length_input(a, b)\n\n    result_chars = []\n    for i in range(len(a)):\n        result_chars.append('0' if a[i] == b[i] else '1')\n\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\"Returns the longest string from a list, or `None` if the list is empty.\n    If multiple strings share the maximum length, the first encountered one is returned.\n    \"\"\"\n    if not strings:\n        return None\n\n    current_longest = strings[0]\n    for s in strings[1:]:\n        if len(s) > len(current_longest):\n            current_longest = s\n    return current_longest"}
{"task_id": "HumanEval/11", "solution": "from typing import List\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    result_bits = []\n    for i in range(len(a)):\n        xor_result = '1' if a[i] != b[i] else '0'\n        result_bits.append(xor_result)\n    return \"\".join(result_bits)"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\"\n    Computes the greatest common divisor of two integers using the Euclidean algorithm.\n    It handles negative inputs by taking their absolute values and raises TypeError for non-integer inputs.\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    if not isinstance(a, int) or not isinstance(b, int):\n        raise TypeError(\"Both inputs must be integers.\")\n\n    a = abs(a)\n    b = abs(b)\n\n    while b:\n        a, b = b, a % b\n    return a"}
