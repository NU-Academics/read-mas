{"task_id": "HumanEval/163", "solution": "def generate_integers(a: int, b: int) -> list[int]:\n    \"\"\"\n    Given two positive integers a and b, this function returns all even integers\n    between them (inclusive) in ascending order. It handles cases where a is greater than b.\n    \"\"\"\n    min_val = min(a, b)\n    max_val = max(a, b)\n    \n    even_numbers = []\n    for i in range(min_val, max_val + 1):\n        if i % 2 == 0:\n            even_numbers.append(i)\n    \n    return even_numbers"}
{"task_id": "HumanEval/100", "solution": "def make_a_pile(n: int) -> list[int]:\n    \"\"\"\n    Given a positive integer n, you have to make a pile of n levels of stones.\n    The first level has n stones.\n    The number of stones in the next level is:\n        - the next odd number if n is odd.\n        - the next even number if n is even.\n    Return the number of stones in each level in a list, where element at index\n    i represents the number of stones in the level (i+1).\n\n    Examples:\n    >>> make_a_pile(3)\n    [3, 5, 7]\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        # Using a built-in ValueError as a substitute for the custom InvalidInputError\n        # to adhere to the single function output constraint and avoid defining a new class.\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    pile = []\n    current_stones = n\n    for _ in range(n):\n        pile.append(current_stones)\n        current_stones += 2\n    return pile"}
{"task_id": "HumanEval/103", "solution": "def rounded_avg(n, m):\n    \"\"\"You are given two positive integers n and m, and your task is to compute the\n    average of the integers from n through m (including n and m). \n    Round the answer to the nearest integer and convert that to binary.\n    If n is greater than m, return -1.\n    Example:\n    rounded_avg(1, 5) => \"0b11\"\n    rounded_avg(7, 5) => -1\n    rounded_avg(10, 20) => \"0b1111\"\n    rounded_avg(20, 33) => \"0b11010\"\n    \"\"\"\n    if n > m:\n        return -1\n\n    # Calculate sum of integers from n to m (inclusive) using the arithmetic series formula.\n    # sum = count * (first + last) / 2\n    count = m - n + 1\n    sum_val = (count * (n + m)) // 2\n\n    # Compute the average\n    average = sum_val / count\n    \n    # Round the computed average to the nearest integer\n    rounded_avg_int = round(average)\n    \n    # Convert the rounded integer to its binary string representation\n    return bin(rounded_avg_int)"}
{"task_id": "HumanEval/94", "solution": "class PrimeChecker:\n    \"\"\"Utility class to determine if a number is prime.\n    Uses trial division up to the square root of the number.\"\"\"\n    def is_prime(self, number: int) -> bool:\n        \"\"\"Checks if the given number is prime.\"\"\"\n        if number < 2:\n            return False\n        i = 2\n        while i * i <= number:\n            if number % i == 0:\n                return False\n            i += 1\n        return True\nclass DigitSummer:\n    \"\"\"Utility class to calculate the sum of digits of an integer.\n    Converts the number to a string to sum its digits.\"\"\"\n    def sum_digits(self, number: int) -> int:\n        \"\"\"Computes the sum of the absolute value of the digits.\"\"\"\n        s = 0\n        num_str = str(abs(number))\n        for digit_char in num_str:\n            s += int(digit_char)\n        return s\nclass PrimeFinderService:\n    \"\"\"Orchestrates finding the largest prime and summing its digits.\n    Injects PrimeChecker and DigitSummer utilities.\"\"\"\n    def __init__(self, prime_checker: PrimeChecker, digit_summer: DigitSummer):\n        \"\"\"Initializes the service with dependency injection.\"\"\"\n        self._prime_checker = prime_checker\n        self._digit_summer = digit_summer\n\n    def find_largest_prime_and_sum_digits(self, lst: list[int]) -> int:\n        \"\"\"Finds the largest prime in the list and returns the sum of its digits.\n        Non-integer elements are ignored as per functional requirement FR2.\"\"\"\n        largest_prime = 0\n        for number in lst:\n            # FR2 / NFR2: Ignore non-integer elements.\n            if not isinstance(number, int):\n                continue\n            \n            if self._prime_checker.is_prime(number):\n                if number > largest_prime:\n                    largest_prime = number\n        \n        # FR3 / Business Rule: If no primes are found, largest_prime is 0.\n        # The sum of digits of 0 is 0, satisfying this requirement.\n        return self._digit_summer.sum_digits(largest_prime)\ndef skjkasdkd(lst: list[int]) -> int:\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n\n    Examples:\n    For lst = [0,3,2,1,3,5,7,4,5,5,5,2,181,32,4,32,3,2,32,324,4,3] the output should be 10\n    For lst = [1,0,1,8,2,4597,2,1,3,40,1,2,1,2,4,2,5,1] the output should be 25\n    For lst = [1,3,1,32,5107,34,83278,109,163,23,2323,32,30,1,9,3] the output should be 13\n    For lst = [0,724,32,71,99,32,6,0,5,91,83,0,5,6] the output should be 11\n    For lst = [0,81,12,3,1,21] the output should be 3\n    For lst = [0,8,1,2,1,7] the output should be 7\n    \"\"\"\n    # FR1: Validate input type.\n    if not isinstance(lst, list):\n        raise TypeError(\"Input must be a list.\")\n\n    # Initialize utility components and the service layer.\n    prime_checker = PrimeChecker()\n    digit_summer = DigitSummer()\n    prime_finder_service = PrimeFinderService(prime_checker, digit_summer)\n    \n    # Delegate core logic to the service and return the result.\n    return prime_finder_service.find_largest_prime_and_sum_digits(lst)"}
