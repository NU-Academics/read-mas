{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"You are given a string s.\n    If s[i] is a letter, reverse its case. If no letters, reverse the string.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n\n    # Determine if the input string contains any letters (StringUtil.is_any_letter logic).\n    has_letters = False\n    for char_check in s:\n        if char_check.isalpha():\n            has_letters = True\n            break\n\n    if not has_letters:\n        # FR4: If s contains no letters, reverse the entire string.\n        return s[::-1]\n    else:\n        # FR3: If s contains letters, iterate and reverse case of each letter.\n        transformed_chars = []\n        for char in s:\n            # Reverse character case logic (StringUtil.reverse_char_case logic).\n            if char.islower():\n                transformed_chars.append(char.upper())\n            elif char.isupper():\n                transformed_chars.append(char.lower())\n            else:  # If not a letter, or not strictly lower/upper, keep as is.\n                transformed_chars.append(char)\n        return \"\".join(transformed_chars)"}
{"task_id": "HumanEval/160", "solution": "VALID_OPERATORS = {'+', '-', '*', '//', '**'}\nclass ExpressionBuilder:\n    \"\"\"Responsible for constructing a valid algebraic expression string.\"\"\"\n    def build(self, operator: list[str], operand: list[int]) -> str:\n        \"\"\"Combines operands and operators into a single string expression.\"\"\"\n        expression_parts = []\n        for i in range(len(operand)):\n            expression_parts.append(str(operand[i]))\n            if i < len(operator):\n                expression_parts.append(operator[i])\n        return \" \".join(expression_parts)\nclass ExpressionEvaluator:\n    \"\"\"Responsible for evaluating a given algebraic expression string.\"\"\"\n    def evaluate(self, expression_string: str) -> int:\n        \"\"\"Evaluates an algebraic expression string to its integer result.\"\"\"\n        try:\n            # Using eval() for simplicity given the problem constraints and trusted input.\n            # In a real-world scenario with untrusted input, a safer parser/evaluator would be used.\n            return int(eval(expression_string))\n        except (SyntaxError, TypeError, NameError) as e:\n            raise ValueError(f\"Failed to evaluate expression '{expression_string}': {e}\") from e\ndef do_algebra(operator, operand):\n    \"\"\"\n    Evaluates an algebraic expression built from a list of operators and non-negative integer operands.\n    Ensures input validity, constructs the expression string, and computes its integer result.\n    \"\"\"\n    if not isinstance(operator, list) or not isinstance(operand, list):\n        raise TypeError(\"Inputs 'operator' and 'operand' must be lists.\")\n    if not all(isinstance(op, str) for op in operator):\n        raise TypeError(\"All elements in 'operator' list must be strings.\")\n    if not all(isinstance(opd, int) and opd >= 0 for opd in operand):\n        raise TypeError(\"All elements in 'operand' list must be non-negative integers.\")\n\n    if len(operator) != len(operand) - 1:\n        raise ValueError(\"Length of operator list must be one less than operand list.\")\n    if not operator or len(operand) < 2:\n        raise ValueError(\"Operator list must have at least one operator, and operand list at least two operands.\")\n    if not all(op in VALID_OPERATORS for op in operator):\n        raise ValueError(f\"Invalid operator found. Supported operators are: {', '.join(VALID_OPERATORS)}\")\n\n    builder = ExpressionBuilder()\n    expression_string = builder.build(operator, operand)\n\n    evaluator = ExpressionEvaluator()\n    result = evaluator.evaluate(expression_string)\n    return result"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"You are given a string s.\n    If s[i] is a letter, reverse its case, otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n\n    # Determine if the string contains any alphabetic characters.\n    contains_letters = any(char.isalpha() for char in s)\n\n    if not contains_letters:\n        # If no letters are found, reverse the entire string.\n        return s[::-1]\n    else:\n        # If letters are present, reverse the case of each letter, leave others as is.\n        return \"\".join(char.swapcase() if char.isalpha() else char for char in s)"}
{"task_id": "HumanEval/160", "solution": "from typing import List, Set\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input conditions.\n    It carries a descriptive message for the error.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nSUPPORTED_OPERATORS: Set[str] = {'+', '-', '*', '//', '**'}\ndef safe_eval(expression: str) -> int:\n    \"\"\"Safely evaluates an algebraic expression string.\n    This function limits the `eval` scope to prevent arbitrary code execution.\"\"\"\n    try:\n        # Use a restricted global and local namespace to prevent arbitrary code execution.\n        result = eval(expression, {\"__builtins__\": None}, {})\n        if not isinstance(result, int):\n            raise InvalidInputError(\"Expression evaluation resulted in a non-integer value.\")\n        return result\n    except (SyntaxError, TypeError, ZeroDivisionError, OverflowError) as e:\n        raise InvalidInputError(f\"Expression evaluation failed: {e}\")\n    except Exception as e:\n        raise InvalidInputError(f\"An unexpected error occurred during evaluation: {e}\")\nclass AlgebraEvaluator:\n    \"\"\"Manages input validation, expression construction, and evaluation.\n    It ensures inputs conform to rules before performing calculations.\"\"\"\n    def __init__(self, operators: List[str], operands: List[int]):\n        self._operators = operators\n        self._operands = operands\n        self._validate_inputs()\n\n    def _validate_inputs(self) -> None:\n        \"\"\"Validates consistency and correctness of the operators and operands lists.\n        Raises InvalidInputError if any validation rule is violated.\"\"\"\n        if not (isinstance(self._operators, list) and isinstance(self._operands, list)):\n            raise InvalidInputError(\"Operators and operands must be lists.\")\n\n        if len(self._operators) != len(self._operands) - 1:\n            raise InvalidInputError(\"Operators list length must be one less than operands list.\")\n\n        if len(self._operators) < 1 or len(self._operands) < 2:\n            raise InvalidInputError(\"Operators list needs at least one, operands list at least two elements.\")\n\n        for operand in self._operands:\n            if not isinstance(operand, int) or operand < 0:\n                raise InvalidInputError(f\"All operands must be non-negative integers. Found: {operand}\")\n\n        for operator in self._operators:\n            if operator not in SUPPORTED_OPERATORS:\n                raise InvalidInputError(f\"Unsupported operator encountered: '{operator}'.\")\n\n    def _build_expression(self) -> str:\n        \"\"\"Constructs the algebraic expression string from operands and operators.\n        It interleaves operands with operators to form the full expression.\"\"\"\n        expression_parts = []\n        for i in range(len(self._operands)):\n            expression_parts.append(str(self._operands[i]))\n            if i < len(self._operators):\n                expression_parts.append(self._operators[i])\n        return \" \".join(expression_parts)\n\n    def evaluate(self) -> int:\n        \"\"\"Evaluates the constructed algebraic expression string.\n        It calls safe_eval to compute the final integer result.\"\"\"\n        expression_string = self._build_expression()\n        return safe_eval(expression_string)\ndef do_algebra(operator: List[str], operand: List[int]) -> int:\n    \"\"\"\n    Evaluates an algebraic expression from lists of operators and operands.\n    Constructs and evaluates an expression, returning the integer result.\n    \"\"\"\n    evaluator = AlgebraEvaluator(operator, operand)\n    return evaluator.evaluate()"}
