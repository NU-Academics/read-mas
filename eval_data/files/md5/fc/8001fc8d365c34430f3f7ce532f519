{"task_id": "HumanEval/115", "solution": "import math\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for signaling invalid input parameters.\"\"\"\n    pass\nclass Well:\n    \"\"\"\n    Represents a single well and provides methods to access its water content.\n    Instances are immutable once created.\n    \"\"\"\n    def __init__(self, water_units: int):\n        \"\"\"\n        Constructor for the Well class.\n        Validates that `water_units` is a non-negative integer.\n        \"\"\"\n        if not isinstance(water_units, int) or water_units < 0:\n            raise InvalidInputError(\"Well water_units must be a non-negative integer.\")\n        self._water_units = water_units\n\n    @staticmethod\n    def from_row(row: list[int]) -> 'Well':\n        \"\"\"\n        Factory method to create a Well instance from a list representing a grid row.\n        It validates the row content to ensure all elements are 0 or 1.\n        \"\"\"\n        if not isinstance(row, list):\n            raise InvalidInputError(\"Well row must be a list.\")\n        if not (1 <= len(row) <= 100):\n            raise InvalidInputError(f\"Well row length must be between 1 and 100, got {len(row)}.\")\n        \n        water_units = 0\n        for cell in row:\n            if not isinstance(cell, int) or cell not in (0, 1):\n                raise InvalidInputError(\"Well row elements must be 0 or 1 integers.\")\n            water_units += cell\n        return Well(water_units)\n\n    def get_water_units(self) -> int:\n        \"\"\"Returns the total water units in the well.\"\"\"\n        return self._water_units\ndef _calculate_operations_for_well(water_units: int, capacity: int) -> int:\n    \"\"\"\n    Calculates the minimum number of bucket operations needed for a given amount of water and bucket capacity.\n    It uses math.ceil to ensure operations are rounded up.\n    \"\"\"\n    if not isinstance(capacity, int) or capacity <= 0 or capacity > 10:\n        raise InvalidInputError(f\"Bucket capacity must be an integer between 1 and 10, got {capacity}.\")\n    \n    if water_units == 0:\n        return 0\n    return math.ceil(water_units / capacity)\ndef max_fill(grid, capacity):\n    \"\"\"\n    Calculates the total number of times buckets need to be lowered to empty all wells in the grid.\n    Performs initial validation on the grid structure and capacity.\n    \"\"\"\n    if not isinstance(grid, list):\n        raise InvalidInputError(\"Grid must be a list of lists.\")\n    if not (1 <= len(grid) <= 100):\n        raise InvalidInputError(f\"Grid length must be between 1 and 100, got {len(grid)}.\")\n    if not isinstance(capacity, int) or capacity <= 0 or capacity > 10:\n        raise InvalidInputError(f\"Bucket capacity must be an integer between 1 and 10, got {capacity}.\")\n\n    total_operations = 0\n    expected_row_length = -1\n\n    for i, row in enumerate(grid):\n        if not isinstance(row, list):\n            raise InvalidInputError(f\"Grid row at index {i} must be a list.\")\n        \n        # Validate grid rectangularity and individual row length\n        if i == 0:\n            # Well.from_row validates row length, but we need it here for rectangularity check too.\n            if not (1 <= len(row) <= 100):\n                 raise InvalidInputError(f\"First well row length must be between 1 and 100, got {len(row)}.\")\n            expected_row_length = len(row)\n        elif len(row) != expected_row_length:\n            raise InvalidInputError(f\"Grid is non-rectangular: row {i} has length {len(row)}, expected {expected_row_length}.\")\n\n        well = Well.from_row(row) # This handles inner row validation for 0/1 values and length.\n        water_units = well.get_water_units()\n        total_operations += _calculate_operations_for_well(water_units, capacity)\n            \n    return total_operations"}
{"task_id": "HumanEval/117", "solution": "VOWELS = {'a', 'e', 'i', 'o', 'u'}\ndef _count_consonants(word: str) -> int:\n    \"\"\"Counts the number of consonants in a given word.\n    It considers 'a', 'e', 'i', 'o', 'u' (case-insensitive) as vowels; all other letters are consonants.\n    \"\"\"\n    consonant_count = 0\n    for char in word:\n        if char.isalpha() and char.lower() not in VOWELS:\n            consonant_count += 1\n    return consonant_count\ndef select_words(s, n):\n    \"\"\"Given a string s and a natural number n, you have been tasked to implement \n    a function that returns a list of all words from string s that contain exactly \n    n consonants, in order these words appear in the string s.\n    If the string s is empty then the function should return an empty list.\n    Note: you may assume the input string contains only letters and spaces.\n    Examples:\n    select_words(\"Mary had a little lamb\", 4) ==> [\"little\"]\n    select_words(\"Mary had a little lamb\", 3) ==> [\"Mary\", \"lamb\"]\n    select_words(\"simple white space\", 2) ==> []\n    select_words(\"Hello world\", 4) ==> [\"world\"]\n    select_words(\"Uncle sam\", 3) ==> [\"Uncle\"]\n    \"\"\"\n    if not s:\n        return []\n\n    result_words = []\n    words = s.split()\n\n    for word in words:\n        if _count_consonants(word) == n:\n            result_words.append(word)\n            \n    return result_words"}
{"task_id": "HumanEval/116", "solution": "def sort_array(arr):\n    \"\"\"\n    Sorts an array: negatives by decimal value, non-negatives by set bit count then decimal value,\n    with all negatives preceding all non-negatives.\n    \"\"\"\n\n    if not arr:\n        return []\n\n    def _count_set_bits(n: int) -> int:\n        \"\"\"\n        Counts the number of set bits (1s) in the binary representation of a non-negative integer.\n        This helper is only called for non-negative numbers (n >= 0) as per design.\n        \"\"\"\n        if n < 0:\n            raise ValueError(\"Input must be a non-negative integer for bit counting.\")\n        count = 0\n        while n > 0:\n            n &= (n - 1)  # Brian Kernighan's algorithm\n            count += 1\n        return count\n\n    negative_numbers = []\n    non_negative_numbers_with_bits = []\n\n    for n in arr:\n        if n < 0:\n            negative_numbers.append(n)\n        else:  # n >= 0\n            bit_count = _count_set_bits(n)\n            # Store as a tuple (bit_count, original_value) for custom sorting\n            non_negative_numbers_with_bits.append((bit_count, n))\n\n    # Sort negative numbers purely by their decimal value (ascending)\n    negative_numbers.sort()\n\n    # Sort non-negative numbers primarily by bit count, secondarily by decimal value\n    non_negative_numbers_with_bits.sort()\n\n    # Extract original values from the sorted tuples\n    sorted_non_negative_values = [item[1] for item in non_negative_numbers_with_bits]\n\n    # Concatenate the two sorted lists: all negatives first, then all non-negatives\n    return negative_numbers + sorted_non_negative_values"}
{"task_id": "HumanEval/117", "solution": "VOWELS = {'a', 'e', 'i', 'o', 'u'}\nclass ConsonantCounter:\n    \"\"\"\n    Counts the number of consonants in a given word.\n    Vowels are defined as 'a', 'e', 'i', 'o', 'u' (case-insensitive).\n    \"\"\"\n    def __init__(self):\n        self._vowels = VOWELS\n\n    def count_consonants(self, word: str) -> int:\n        \"\"\"\n        Counts consonants in the input word, treating all other letters as consonants.\n        Non-letter characters are ignored in the count.\n        \"\"\"\n        consonant_count = 0\n        for char in word.lower():\n            if 'a' <= char <= 'z' and char not in self._vowels:\n                consonant_count += 1\n        return consonant_count\nclass WordSelectorService:\n    \"\"\"\n    Encapsulates the core logic for selecting words based on their consonant count.\n    It orchestrates word splitting, consonant counting, and filtering.\n    \"\"\"\n    def __init__(self, consonant_counter: ConsonantCounter):\n        self._consonant_counter = consonant_counter\n\n    def select_words(self, s: str, n: int) -> list[str]:\n        \"\"\"\n        Splits the input string into words and filters them to find words with exactly 'n' consonants.\n        The original order of words is preserved in the output list.\n        \"\"\"\n        if not s:\n            return []\n\n        words = s.split()  # Handles trimming and multiple spaces per FR2\n        result_words = []\n        for word in words:\n            if self._consonant_counter.count_consonants(word) == n:\n                result_words.append(word)\n        return result_words\ndef select_words(s: str, n: int) -> list[str]:\n    \"\"\"\n    Given a string s and a natural number n, returns a list of all words from string s\n    that contain exactly n consonants, in order these words appear in the string s.\n    \"\"\"\n    consonant_counter = ConsonantCounter()\n    word_selector_service = WordSelectorService(consonant_counter)\n    return word_selector_service.select_words(s, n)"}
{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"You are given a word. Your task is to find the closest vowel that stands between \n    two consonants from the right side of the word (case sensitive).\n    \n    Vowels in the beginning and ending doesn't count. Return empty string if you didn't\n    find any vowel met the above condition. \n\n    You may assume that the given string contains English letter only.\n\n    Example:\n    get_closest_vowel(\"yogurt\") ==> \"u\"\n    get_closest_vowel(\"FULL\") ==> \"U\"\n    get_closest_vowel(\"quick\") ==> \"\"\n    get_closest_vowel(\"ab\") ==> \"\"\n    \"\"\"\n\n    # Helper function to determine if a character is a vowel.\n    def _is_vowel(char):\n        return char.lower() in {'a', 'e', 'i', 'o', 'u'}\n\n    # Helper function to determine if a character is a consonant.\n    # Assumes input contains only English letters and is not a vowel.\n    def _is_consonant(char):\n        return char.isalpha() and not _is_vowel(char)\n\n    if len(word) < 3:\n        return \"\"\n\n    # Iterate from the second-to-last character down to the second character (index 1).\n    # This range ensures that current_char always has a left and a right neighbor.\n    for i in range(len(word) - 2, 0, -1):\n        current_char = word[i]\n        if _is_vowel(current_char):\n            left_char = word[i - 1]\n            right_char = word[i + 1]\n            if _is_consonant(left_char) and _is_consonant(right_char):\n                return current_char\n    return \"\""}
{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"Finds the closest vowel surrounded by two consonants from the right.\n    Returns the vowel preserving its original case, or an empty string if none is found.\n    \"\"\"\n    if len(word) < 3:\n        return \"\"\n\n    VOWELS_LOWER = {'a', 'e', 'i', 'o', 'u'}\n\n    def _is_vowel(char):\n        \"\"\"Checks if a character is an English vowel (case-insensitive).\"\"\"\n        return char.lower() in VOWELS_LOWER\n\n    def _is_consonant(char):\n        \"\"\"Checks if a character is an English consonant (case-insensitive).\"\"\"\n        char_lower = char.lower()\n        return 'a' <= char_lower <= 'z' and char_lower not in VOWELS_LOWER\n\n    # Iterate from right to left, excluding the first and last characters.\n    for i in range(len(word) - 2, 0, -1):\n        current_char = word[i]\n        prev_char = word[i - 1]\n        next_char = word[i + 1]\n\n        if _is_vowel(current_char) and \\\n           _is_consonant(prev_char) and \\\n           _is_consonant(next_char):\n            return current_char\n            \n    return \"\""}
{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    s1, s2 = lst[0], lst[1]\n\n    def _is_balanced(s):\n        \"\"\"Checks if the input string contains balanced parentheses.\n        It maintains a balance counter, ensuring it never drops below zero and ends at zero.\n        \"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            else:  # char == ')'\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    if _is_balanced(s1 + s2):\n        return 'Yes'\n\n    if _is_balanced(s2 + s1):\n        return 'Yes'\n\n    return 'No'"}
