{"task_id": "HumanEval/37", "solution": "def sort_even(l: list) -> list:\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    if not l:\n        return []\n\n    even_elements = [l[i] for i in range(0, len(l), 2)]\n    even_elements.sort()\n\n    result = l[:]\n    even_idx_counter = 0\n    for i in range(0, len(l), 2):\n        result[i] = even_elements[even_idx_counter]\n        even_idx_counter += 1\n    return result"}
{"task_id": "HumanEval/36", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    pass\nclass DigitCounter:\n    \"\"\"Utility class for counting occurrences of a specific digit in a number.\"\"\"\n\n    def __init__(self):\n        pass\n\n    def count_digit(self, number: int, digit: int) -> int:\n        \"\"\"Counts how many times a specific digit appears in the given number. Raises ValueError if 'digit' is not a single digit.\"\"\"\n        if not (0 <= digit <= 9):\n            raise ValueError(\"Digit must be a single digit between 0 and 9.\")\n\n        count = 0\n        num_str = str(number)\n        for char in num_str:\n            if int(char) == digit:\n                count += 1\n        return count\nclass FizzBuzzCounter:\n    \"\"\"Core logic for counting the digit '7' in numbers less than n which are divisible by 11 or 13.\"\"\"\n\n    def __init__(self):\n        self._digit_counter = DigitCounter()\n\n    def _is_divisible_by_11_or_13(self, num: int) -> bool:\n        \"\"\"Checks if a number is divisible by 11 or 13.\"\"\"\n        return (num % 11 == 0) or (num % 13 == 0)\n\n    def count_sevens_in_range(self, n: int) -> int:\n        \"\"\"Iterates from 1 to n-1, checks divisibility, and counts '7's. Raises InvalidInputError if n is not a positive integer.\"\"\"\n        if not isinstance(n, int) or n <= 0:\n            raise InvalidInputError(\"Input 'n' must be a positive integer.\")\n\n        total_sevens_count = 0\n        for i in range(1, n):\n            if self._is_divisible_by_11_or_13(i):\n                total_sevens_count += self._digit_counter.count_digit(i, 7)\n        return total_sevens_count\ndef fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n\n    counter = FizzBuzzCounter()\n    return counter.count_sevens_in_range(n)"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str) -> str:\n    \"\"\"\n    Takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # Split the input string into groups of three characters.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # Reverse cycle elements in each group by shifting one position to the right,\n    # unless the group has fewer than three elements.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/32", "solution": "def find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    # Constants for polynomial zero finding, embedded for self-containment of the function.\n    SEARCH_RANGE_START: float = -10.0\n    SEARCH_RANGE_END: float = 10.0\n    STEP: float = 0.01\n    TOLERANCE: float = 1e-7\n    MAX_ITERATIONS: int = 1000\n\n    # Initial Bracketing Search to find an interval [a, b] where poly(a) * poly(b) < 0.\n    x_current = SEARCH_RANGE_START\n    bracket_a: float\n    bracket_b: float\n    found_bracket = False\n\n    while x_current < SEARCH_RANGE_END:\n        y1 = poly(xs, x_current)\n        if abs(y1) < TOLERANCE:\n            return x_current\n\n        x_next_step = x_current + STEP\n        if x_next_step > SEARCH_RANGE_END:\n            # Adjust the last step to not overshoot the search range end.\n            x_next_step = SEARCH_RANGE_END\n\n        y2 = poly(xs, x_next_step)\n        if abs(y2) < TOLERANCE:\n            return x_next_step\n\n        if y1 * y2 < 0:\n            bracket_a = x_current\n            bracket_b = x_next_step\n            found_bracket = True\n            break\n        x_current = x_next_step\n\n    # Per problem statement, a root is guaranteed. If no bracket is explicitly found with a sign change\n    # within the stepped search, we use the entire search range.\n    if not found_bracket:\n        bracket_a = SEARCH_RANGE_START\n        bracket_b = SEARCH_RANGE_END\n\n    # Bisection Method to refine the root within the identified or default bracket.\n    a = bracket_a\n    b = bracket_b\n\n    for _ in range(MAX_ITERATIONS):\n        mid = (a + b) / 2\n        f_mid = poly(xs, mid)\n\n        if abs(f_mid) < TOLERANCE:\n            return mid\n\n        # Re-evaluate poly(xs, a) for comparison, as 'a' might have changed in a previous iteration.\n        f_a = poly(xs, a) \n        if f_a * f_mid < 0:\n            b = mid\n        else:\n            a = mid\n    \n    # Returns the best approximation after maximum iterations.\n    return (a + b) / 2"}
{"task_id": "HumanEval/40", "solution": "from typing import List\nclass TriplesSumToZeroService:\n    \"\"\"\n    Service class to check for three distinct elements in a list that sum to zero.\n    It implements an optimized O(N^2) algorithm using sorting and two pointers.\n    \"\"\"\n    def check_for_triplet(self, input_list: List[int]) -> bool:\n        \"\"\"\n        Checks if there are three distinct elements in the input_list that sum to zero.\n        The elements must come from distinct indices in the original list.\n        \"\"\"\n        n = len(input_list)\n        if n < 3:\n            return False\n\n        sorted_list = sorted(input_list)\n\n        for i in range(n - 2):\n            # Skip duplicate elements for the first number to avoid redundant calculations.\n            # This ensures that we consider distinct combinations of elements, not just distinct values.\n            if i > 0 and sorted_list[i] == sorted_list[i-1]:\n                continue\n\n            left = i + 1\n            right = n - 1\n\n            while left < right:\n                current_sum = sorted_list[i] + sorted_list[left] + sorted_list[right]\n\n                if current_sum == 0:\n                    return True\n                elif current_sum < 0:\n                    left += 1\n                else:\n                    right -= 1\n        return False\ndef triples_sum_to_zero(l: list) -> bool:\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n\n    >>> triples_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> triples_sum_to_zero([1, 3, -2, 1])\n    True\n    >>> triples_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> triples_sum_to_zero([2, 4, -5, 3, 9, 7])\n    True\n    >>> triples_sum_to_zero([1])\n    False\n    \"\"\"\n    service = TriplesSumToZeroService()\n    return service.check_for_triplet(l)"}
