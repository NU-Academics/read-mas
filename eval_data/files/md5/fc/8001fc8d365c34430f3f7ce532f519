{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    \"\"\"\n    Checks if an integer 'a' is a perfect cube.\n    Handles positive, negative, and zero inputs, accounting for floating-point precision.\n    \"\"\"\n    if a == 0:\n        return True\n\n    # Calculate the cube root of the absolute value, rounding to the nearest integer.\n    cbrt_candidate = round(abs(a)**(1/3))\n\n    # Re-cube the candidate, preserving the original sign, and compare.\n    if a < 0:\n        return (-cbrt_candidate) ** 3 == a\n    else:\n        return cbrt_candidate ** 3 == a"}
{"task_id": "HumanEval/91", "solution": "import re\ndef is_bored(S: str) -> int:\n    \"\"\"\n    Counts the number of sentences in S that start with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    boredom_count = 0\n    sentences = re.split(r'[.?!]', S)\n\n    for sentence_segment in sentences:\n        cleaned_sentence = sentence_segment.strip()\n        if not cleaned_sentence:\n            continue\n\n        if cleaned_sentence.startswith(\"I \") or cleaned_sentence == \"I\":\n            boredom_count += 1\n    return boredom_count"}
{"task_id": "HumanEval/93", "solution": "def encode(message: str) -> str:\n    \"\"\"\n    Encodes a message by swapping letter cases and replacing vowels.\n    Vowels are replaced by the letter two positions ahead in the alphabet, preserving case.\n    \"\"\"\n    # Constants for vowel and alphabet lookups.\n    VOWELS_LOWERCASE = \"aeiou\"\n    VOWELS_UPPERCASE = \"AEIOU\"\n    ALPHABET_LOWERCASE = \"abcdefghijklmnopqrstuvwxyz\"\n    ALPHABET_UPPERCASE = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"\n\n    def _swap_case(char: str) -> str:\n        \"\"\"Helper to swap the case of a single character.\"\"\"\n        if 'a' <= char <= 'z':\n            return char.upper()\n        elif 'A' <= char <= 'Z':\n            return char.lower()\n        return char\n\n    def _replace_vowel(char: str) -> str:\n        \"\"\"Helper to replace a vowel with the letter two places ahead, preserving case.\"\"\"\n        if char in VOWELS_LOWERCASE:\n            idx = ALPHABET_LOWERCASE.find(char)\n            return ALPHABET_LOWERCASE[(idx + 2) % len(ALPHABET_LOWERCASE)]\n        elif char in VOWELS_UPPERCASE:\n            idx = ALPHABET_UPPERCASE.find(char)\n            return ALPHABET_UPPERCASE[(idx + 2) % len(ALPHABET_UPPERCASE)]\n        return char\n\n    encoded_chars = []\n    for char in message:\n        # Apply case swapping first.\n        processed_char = _swap_case(char)\n\n        # Check if the character (after case swap) is a vowel.\n        # Then apply vowel replacement, preserving its current case.\n        if processed_char.lower() in VOWELS_LOWERCASE:\n            processed_char = _replace_vowel(processed_char)\n        \n        encoded_chars.append(processed_char)\n        \n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/93", "solution": "VOWELS = \"aeiouAEIOU\"\nALPHABET_LOWER = \"abcdefghijklmnopqrstuvwxyz\"\nALPHABET_UPPER = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"\ndef encode(message: str) -> str:\n    \"\"\"Encodes a message by swapping letter cases and shifting vowels.\n    Non-alphabetic characters remain unchanged in the output according to the design.\n    \"\"\"\n    encoded_chars = []\n    for char in message:\n        if not char.isalpha():\n            encoded_chars.append(char) # Non-alphabetic characters are passed through unchanged.\n            continue\n\n        is_vowel = char in VOWELS # Determine if the character is a vowel (case-insensitive check).\n\n        if is_vowel:\n            # Vowel replacement: shift 2 places ahead, always resulting in uppercase, as per examples.\n            lower_char = char.lower()\n            current_index = ALPHABET_LOWER.index(lower_char)\n            new_index = (current_index + 2) % len(ALPHABET_LOWER)\n            encoded_chars.append(ALPHABET_UPPER[new_index])\n        else:\n            # Consonant case swapping.\n            if char.islower():\n                encoded_chars.append(char.upper())\n            else: # char.isupper()\n                encoded_chars.append(char.lower())\n    \n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/96", "solution": "def count_up_to(n):\n    \"\"\"Calculates all prime numbers strictly less than n using the Sieve of Eratosthenes.\"\"\"\n    if n <= 2:\n        return []\n\n    is_prime = [True] * n\n    is_prime[0] = is_prime[1] = False\n\n    for p in range(2, int(n**0.5) + 1):\n        if is_prime[p]:\n            for multiple in range(p * p, n, p):\n                is_prime[multiple] = False\n\n    primes = [i for i, prime_status in enumerate(is_prime) if prime_status]\n    return primes"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Checks if all dictionary keys are consistently cased (all lowercase or all uppercase).\n    Returns False for empty dictionaries or dictionaries with non-string keys.\n    \"\"\"\n    if not dict:\n        return False\n\n    all_lower = True\n    all_upper = True\n\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False  # Non-string key found, cannot be uniformly cased.\n\n        if key != key.lower():\n            all_lower = False\n        if key != key.upper():\n            all_upper = False\n\n        # If neither condition can be met anymore, stop early.\n        if not all_lower and not all_upper:\n            return False\n\n    return all_lower or all_upper"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict: dict) -> bool:\n    \"\"\"\n    Given a dictionary, return True if all string keys are consistently cased (all lowercase or all uppercase).\n    Returns False for empty dictionaries, non-string keys, or mixed casing.\n    \"\"\"\n    if not dict:\n        return False\n\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False\n\n    is_all_lower = True\n    is_all_upper = True\n\n    for key in dict.keys():\n        if not key.islower():\n            is_all_lower = False\n        if not key.isupper():\n            is_all_upper = False\n        \n        if not is_all_lower and not is_all_upper:\n            return False\n\n    return is_all_lower or is_all_upper"}
{"task_id": "HumanEval/94", "solution": "class PrimeUtils:\n    @staticmethod\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if a given integer is a prime number.\n        Numbers less than or equal to 1 are not considered prime.\n        \"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\nclass DigitSummerService:\n    def sum_digits(self, number: int) -> int:\n        \"\"\"Calculates the sum of the digits of an integer.\n        The absolute value of the number is used for digit summation.\n        \"\"\"\n        s = 0\n        num_str = str(abs(number))\n        for digit_char in num_str:\n            s += int(digit_char)\n        return s\nclass PrimeFinderService:\n    def find_largest_prime(self, numbers: list[int]) -> int:\n        \"\"\"Finds the largest prime number in a list.\n        Returns 0 if no prime numbers are found.\n        \"\"\"\n        largest_prime = 0\n        for num in numbers:\n            if PrimeUtils.is_prime(num):\n                if num > largest_prime:\n                    largest_prime = num\n        return largest_prime\ndef skjkasdkd(lst: list[int]) -> int:\n    \"\"\"Finds the largest prime value in a list of integers and returns the sum of its digits.\n    Handles input validation and returns 0 if no primes are found.\n    \"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"Input must be a list.\")\n    if not all(isinstance(x, int) for x in lst):\n        raise ValueError(\"All elements in the list must be integers.\")\n\n    prime_finder = PrimeFinderService()\n    largest_prime = prime_finder.find_largest_prime(lst)\n\n    if largest_prime == 0:\n        return 0\n\n    digit_summer = DigitSummerService()\n    return digit_summer.sum_digits(largest_prime)"}
