{"task_id": "HumanEval/2", "solution": "def truncate_number(number: float) -> float:\n    \"\"\"Given a positive floating point number, return its decimal part.\n    The integer part is the largest integer smaller than or equal to the given number.\n    \"\"\"\n    integer_part = int(number)\n    decimal_part = number - integer_part\n    return decimal_part"}
{"task_id": "HumanEval/2", "solution": "import math\ndef truncate_number(number: float) -> float:\n    \"\"\"\n    Extracts the decimal part of a positive floating-point number.\n    Returns the leftover part after subtracting the largest integer less than or equal to the given number.\n    \"\"\"\n    if not isinstance(number, float):\n        raise ValueError(\"Input must be a floating-point number.\")\n    if number <= 0:\n        raise ValueError(\"Input number must be positive.\")\n\n    integer_part = math.floor(number)\n    decimal_part = number - integer_part\n    return decimal_part"}
{"task_id": "HumanEval/3", "solution": "from typing import List\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\" You're given a list of deposit and withdrawal operations on a bank account that starts with\n    zero balance. Your task is to detect if at any point the balance of account fallls below zero, and\n    at that point function should return True. Otherwise it should return False.\n    >>> below_zero([1, 2, 3])\n    False\n    >>> below_zero([1, 2, -4, 5])\n    True\n    \"\"\"\n    if not isinstance(operations, list):\n        raise ValueError(\"Operations must be a list.\")\n\n    current_balance = 0\n    for op in operations:\n        if not isinstance(op, int):\n            raise ValueError(\"All operations must be integers.\")\n        current_balance += op\n        if current_balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/0", "solution": "from typing import List\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\"Check if in given list of numbers, any two numbers are closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    n = len(numbers)\n    if n < 2:\n        return False\n\n    for i in range(n):\n        for j in range(i + 1, n):  # Iterate through unique distinct pairs\n            if abs(numbers[i] - numbers[j]) < threshold:\n                return True\n    return False"}
{"task_id": "HumanEval/3", "solution": "from typing import List\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\"Simulates bank account operations to detect if the balance ever falls below zero.\n    Returns True if an overdraft occurs at any point, False otherwise.\n    >>> below_zero([1, 2, 3])\n    False\n    >>> below_zero([1, 2, -4, 5])\n    True\n    \"\"\"\n    if not isinstance(operations, list):\n        raise TypeError(\"Input 'operations' must be a list.\")\n\n    balance = 0\n\n    for operation in operations:\n        if not isinstance(operation, int):\n            raise ValueError(\"All elements in 'operations' must be integers.\")\n\n        balance += operation\n\n        if balance < 0:\n            return True\n\n    return False"}
{"task_id": "HumanEval/0", "solution": "from typing import List\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\"Check if any two numbers in the given list are closer to each other than the specified threshold.\"\"\"\n\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input 'numbers' must be a list.\")\n    if not isinstance(threshold, (float, int)):\n        raise TypeError(\"Input 'threshold' must be a float or an integer.\")\n\n    n = len(numbers)\n    if n < 2:\n        return False\n\n    # Validate and coerce elements to float for consistent comparison\n    for i in range(n):\n        num = numbers[i]\n        if not isinstance(num, (float, int)):\n            raise TypeError(f\"Element at index {i} in 'numbers' is not a float or integer.\")\n        numbers[i] = float(num)\n\n    # Brute-force O(N^2) comparison\n    for i in range(n):\n        for j in range(i + 1, n):\n            if abs(numbers[i] - numbers[j]) < threshold:\n                return True\n\n    return False"}
{"task_id": "HumanEval/5", "solution": "from typing import List\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\"Insert a number 'delimeter' between every two consecutive elements of input list `numbers`.\n    It handles empty and single-element lists as specified.\"\"\"\n    if not numbers:\n        return []\n\n    result = [numbers[0]]\n    for i in range(1, len(numbers)):\n        result.append(delimeter)\n        result.append(numbers[i])\n    return result"}
{"task_id": "HumanEval/1", "solution": "from typing import List\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"\n    Separates balanced, non-nested parenthesis groups from an input string, ignoring spaces.\n    Returns a list of these groups, each as a string.\n    \"\"\"\n    result_groups: List[str] = []\n    balance: int = 0\n    current_group_start_index: int = -1\n\n    cleaned_string = paren_string.replace(\" \", \"\")\n\n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            if balance == 0:\n                current_group_start_index = i\n            balance += 1\n        elif char == ')':\n            balance -= 1\n            if balance == 0 and current_group_start_index != -1:\n                group = cleaned_string[current_group_start_index : i + 1]\n                result_groups.append(group)\n                current_group_start_index = -1\n\n    return result_groups"}
{"task_id": "HumanEval/1", "solution": "from typing import List\nclass InvalidParenthesisError(Exception):\n    \"\"\"Signals errors related to invalid or unbalanced parenthesis structures.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"\n    Separates distinct, balanced, and non-nested parenthesis groups from a string.\n    Spaces in the input string are ignored.\n    \"\"\"\n\n    def _clean_string(s: str) -> str:\n        \"\"\"Removes all space characters from the input string.\"\"\"\n        return s.replace(\" \", \"\")\n\n    def _find_next_group(cleaned_string: str, start_index: int) -> tuple[str, int]:\n        \"\"\"\n        Scans for the next complete, balanced, top-level parenthesis group, returning it and the next index.\n        Raises InvalidParenthesisError for malformed groups or unexpected characters.\n        \"\"\"\n        if start_index >= len(cleaned_string):\n            return \"\", start_index\n\n        first_char = cleaned_string[start_index]\n        if first_char == ')':\n            raise InvalidParenthesisError(\"Unbalanced closing parenthesis at start of potential group.\")\n        elif first_char != '(':\n            raise InvalidParenthesisError(f\"Unexpected character '{first_char}' encountered at index {start_index}.\")\n\n        balance = 0\n        for i in range(start_index, len(cleaned_string)):\n            char = cleaned_string[i]\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            else:\n                raise InvalidParenthesisError(f\"Unexpected character '{char}' encountered after cleaning at index {i}.\")\n\n            if balance == 0:\n                return cleaned_string[start_index : i + 1], i + 1\n\n        if balance != 0:\n            raise InvalidParenthesisError(\"Unbalanced opening parenthesis: group was not closed.\")\n        # This point should not be reached for a non-empty, valid string starting with '('.\n        return \"\", start_index\n\n    cleaned_paren_string = _clean_string(paren_string)\n    groups = []\n    current_index = 0\n\n    while current_index < len(cleaned_paren_string):\n        group_str, next_index = _find_next_group(cleaned_paren_string, current_index)\n        if group_str:\n            groups.append(group_str)\n        \n        # If no progress was made and no group was found, it means no more valid groups exist.\n        if next_index == current_index and not group_str:\n            break\n        current_index = next_index\n\n    return groups"}
