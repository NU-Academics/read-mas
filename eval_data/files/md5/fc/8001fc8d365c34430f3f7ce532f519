{"task_id": "HumanEval/63", "solution": "_fibfib_cache = {\n    0: 0,\n    1: 0,\n    2: 1\n}\ndef fibfib(n: int) -> int:\n    \"\"\"The FibFib number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fibfib(0) == 0\n    fibfib(1) == 0\n    fibfib(2) == 1\n    fibfib(n) == fibfib(n-1) + fibfib(n-2) + fibfib(n-3).\n    Please write a function to efficiently compute the n-th element of the fibfib number sequence.\n    >>> fibfib(1)\n    0\n    >>> fibfib(5)\n    4\n    >>> fibfib(8)\n    24\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    if n in _fibfib_cache:\n        return _fibfib_cache[n]\n\n    # Compute recursively and store in cache for efficiency\n    result = fibfib(n - 1) + fibfib(n - 2) + fibfib(n - 3)\n    _fibfib_cache[n] = result\n    return result"}
{"task_id": "HumanEval/63", "solution": "from functools import lru_cache\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input values.\"\"\"\n    pass\ndef fibfib(n: int) -> int:\n    \"\"\"The FibFib number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fibfib(0) == 0\n    fibfib(1) == 0\n    fibfib(2) == 1\n    fibfib(n) == fibfib(n-1) + fibfib(n-2) + fibfib(n-3).\n    Please write a function to efficiently compute the n-th element of the fibfib number sequence.\n    >>> fibfib(1)\n    0\n    >>> fibfib(5)\n    4\n    >>> fibfib(8)\n    24\n    \"\"\"\n    if n < 0:\n        raise InvalidInputError(\"Input 'n' must be a non-negative integer.\")\n\n    @lru_cache(maxsize=None)\n    def _fibfib_recursive_inner(k: int) -> int:\n        \"\"\"Inner helper function for memoized recursive calculation.\"\"\"\n        if k == 0:\n            return 0\n        if k == 1:\n            return 0\n        if k == 2:\n            return 1\n        return _fibfib_recursive_inner(k - 1) + _fibfib_recursive_inner(k - 2) + _fibfib_recursive_inner(k - 3)\n\n    return _fibfib_recursive_inner(n)"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\n     Return derivative of this polynomial in the same form.\n    >>> derivative([3, 1, 2, 4, 5])\n    [1, 4, 12, 20]\n    >>> derivative([1, 2, 3])\n    [2, 6]\n    \"\"\"\n    if len(xs) <= 1:\n        return []\n\n    # The derivative of c_i * x^i is i * c_i * x^(i-1)\n    # The new list starts from the derivative of xs[1] * x^1 (which is xs[1])\n    # and goes up to the derivative of xs[n] * x^n (which is n * xs[n] * x^(n-1))\n    derivative_coefficients = [i * xs[i] for i in range(1, len(xs))]\n    return derivative_coefficients"}
{"task_id": "HumanEval/64", "solution": "_STANDARD_VOWELS = {'a', 'e', 'i', 'o', 'u'}\ndef vowels_count(s):\n    \"\"\"Counts vowels in a string, case-insensitively.\n    'y' is a vowel only if it is the last character of the input string.\n\n    Example:\n    >>> vowels_count(\"abcde\")\n    2\n    >>> vowels_count(\"ACEDY\")\n    3\n    >>> vowels_count(\"\")\n    0\n    >>> vowels_count(\"rhythm\")\n    0\n    >>> vowels_count(\"Happy\")\n    2\n    >>> vowels_count(\"mystery\")\n    2\n    >>> vowels_count(\"The quick brown fox jumps over the lazy dog\")\n    12\n    >>> vowels_count(\"H3ll0 W0rld!\")\n    2\n    \"\"\"\n    if not s:\n        return 0\n\n    count = 0\n    lower_s = s.lower()\n\n    for i, char in enumerate(lower_s):\n        if char in _STANDARD_VOWELS:\n            count += 1\n        elif char == 'y' and i == len(lower_s) - 1:\n            count += 1\n            \n    return count"}
