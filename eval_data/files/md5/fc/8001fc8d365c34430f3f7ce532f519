{"task_id": "HumanEval/121", "solution": "def solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\n    Positions are 0-indexed.\n\n    Examples:\n    solution([5, 8, 7, 1]) ==> 12\n    solution([3, 3, 3, 3, 3]) ==> 9\n    solution([30, 13, 24, 321]) ==> 0\n    \"\"\"\n    total_sum = 0\n    for i in range(len(lst)):\n        # Check if the current position 'i' is even and the element at 'lst[i]' is odd.\n        if i % 2 == 0 and lst[i] % 2 != 0:\n            total_sum += lst[i]\n    return total_sum"}
{"task_id": "HumanEval/119", "solution": "from typing import List, Set\nclass ParenthesesValidator:\n    \"\"\"Utility class for validating parentheses-related characters.\"\"\"\n    _VALID_CHARS: Set[str] = {'(', ')'}\n\n    @staticmethod\n    def is_valid_char(char: str) -> bool:\n        \"\"\"Checks if a given character is a valid parenthesis character.\"\"\"\n        return char in ParenthesesValidator._VALID_CHARS\nclass ParenthesesCheckerService:\n    \"\"\"Provides business logic for checking parentheses string balance.\"\"\"\n\n    def is_balanced(self, s: str) -> bool:\n        \"\"\"Checks if a given string of parentheses is balanced.\"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                return False  # Balance fell below zero at some point.\n        return balance == 0  # Final balance must be zero for a good string.\n\n    def can_form_balanced(self, s1: str, s2: str) -> str:\n        \"\"\"Determines if concatenating s1 and s2 in either order results in a balanced string.\"\"\"\n        if self.is_balanced(s1 + s2):\n            return \"Yes\"\n        if self.is_balanced(s2 + s1):\n            return \"Yes\"\n        return \"No\"\ndef match_parens(lst: List[str]) -> str:\n    \"\"\"\n    Checks if two parentheses strings in a list can form a balanced string when concatenated.\n    It returns 'Yes' if possible, 'No' otherwise, performing input validation.\n    \"\"\"\n    if not isinstance(lst, list) or len(lst) != 2:\n        raise TypeError(\"Input must be a list of exactly two strings.\")\n\n    s1, s2 = lst[0], lst[1]\n\n    if not isinstance(s1, str) or not isinstance(s2, str):\n        raise TypeError(\"Both elements in the list must be strings.\")\n\n    # Validate characters in s1 and s2 using ParenthesesValidator.\n    for char in s1:\n        if not ParenthesesValidator.is_valid_char(char):\n            raise ValueError(f\"String s1 contains invalid character: '{char}'. Only '(' and ')' are allowed.\")\n\n    for char in s2:\n        if not ParenthesesValidator.is_valid_char(char):\n            raise ValueError(f\"String s2 contains invalid character: '{char}'. Only '(' and ')' are allowed.\")\n\n    service = ParenthesesCheckerService()\n    return service.can_form_balanced(s1, s2)"}
{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input 'arr' must be a list.\")\n    if not isinstance(k, int):\n        raise TypeError(\"Input 'k' must be an integer.\")\n\n    if not (1 <= len(arr) <= 100):\n        raise ValueError(\"Length of 'arr' must be between 1 and 100.\")\n    if not (1 <= k <= len(arr)):\n        raise ValueError(\"Input 'k' must be between 1 and len(arr).\")\n\n    current_sum = 0\n    for i in range(k):\n        element = arr[i]\n        if not isinstance(element, int):\n            raise TypeError(f\"Element at index {i} in 'arr' is not an integer.\")\n        if -99 <= element <= 99:  # Check if the element has at most two digits (absolute value < 100).\n            current_sum += element\n    return current_sum"}
{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"Calculates the sum of elements with at most two digits from the first k elements of arr.\"\"\"\n    current_sum = 0\n    # Iterate through the first k elements of the array.\n    for i in range(k):\n        element = arr[i]\n        # Check if the element's absolute value is less than 100 (at most two digits).\n        if -99 <= element <= 99:\n            current_sum += element\n    return current_sum"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Calculates unique odd numbers in a Collatz sequence, sorted in increasing order.\n    The sequence starts with n and continues until it reaches 1.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    if n == 1:\n        return [1]\n\n    sequence = [n]\n    current = n\n    while current != 1:\n        if current % 2 == 0:\n            current //= 2\n        else:\n            current = 3 * current + 1\n        sequence.append(current)\n\n    odd_numbers_set = {num for num in sequence if num % 2 != 0}\n    return sorted(list(odd_numbers_set))"}
