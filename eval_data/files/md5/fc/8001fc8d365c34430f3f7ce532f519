{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    import math\n\n    class InvalidInputError(Exception):\n        \"\"\"Custom exception for invalid input parameters.\"\"\"\n        def __init__(self, message=\"Invalid input provided.\"):\n            self.message = message\n            super().__init__(self.message)\n\n    class FibonacciGenerator:\n        \"\"\"Generates Fibonacci numbers sequentially.\"\"\"\n        def __init__(self):\n            self._a = 0\n            self._b = 1\n\n        def get_next_fib(self) -> int:\n            \"\"\"Returns the next Fibonacci number in the sequence.\"\"\"\n            current_fib = self._a\n            self._a, self._b = self._b, self._a + self._b\n            return current_fib\n\n        def reset(self) -> None:\n            \"\"\"Resets the generator to its initial state (0, 1).\"\"\"\n            self._a = 0\n            self._b = 1\n\n    class PrimeChecker:\n        \"\"\"Determines if a given integer is a prime number, using memoization.\"\"\"\n        def __init__(self):\n            self._prime_cache: dict[int, bool] = {}\n\n        def is_prime(self, num: int) -> bool:\n            \"\"\"Checks if a number is prime and caches the result.\"\"\"\n            if num in self._prime_cache:\n                return self._prime_cache[num]\n\n            if num < 2:\n                result = False\n            elif num == 2:\n                result = True\n            elif num % 2 == 0:\n                result = False\n            else:\n                is_prime_flag = True\n                for i in range(3, int(math.sqrt(num)) + 1, 2):\n                    if num % i == 0:\n                        is_prime_flag = False\n                        break\n                result = is_prime_flag\n\n            self._prime_cache[num] = result\n            return result\n\n    class PrimeFibCalculator:\n        \"\"\"Orchestrates finding the n-th number that is both Fibonacci and prime.\"\"\"\n        def __init__(self):\n            self._fib_generator = FibonacciGenerator()\n            self._prime_checker = PrimeChecker()\n\n        def find_nth_prime_fib(self, n: int) -> int:\n            \"\"\"Finds and returns the n-th prime Fibonacci number.\"\"\"\n            if n <= 0:\n                raise InvalidInputError(\"Input 'n' must be a positive integer.\")\n\n            prime_fib_count = 0\n            while True:\n                fib_number = self._fib_generator.get_next_fib()\n                if fib_number > 1 and self._prime_checker.is_prime(fib_number):\n                    prime_fib_count += 1\n                    if prime_fib_count == n:\n                        return fib_number\n\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n\n    calculator = PrimeFibCalculator()\n    try:\n        return calculator.find_nth_prime_fib(n)\n    except InvalidInputError as e:\n        raise e"}
