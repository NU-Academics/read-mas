{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades: list[float]) -> list[str]:\n    \"\"\"\n    Converts a list of GPAs to a list of letter grades based on a predefined scale.\n    The function uses a GradeConverter service to perform the batch conversion.\n    \"\"\"\n    from dataclasses import dataclass\n\n    @dataclass\n    class GPAScaleEntry:\n        \"\"\"Represents a single entry in the GPA to letter grade conversion scale.\"\"\"\n        gpa_threshold: float\n        letter_grade: str\n        inclusive: bool # True if gpa >= threshold, False if gpa > threshold\n\n\n    GRADING_SCALE: list[GPAScaleEntry] = [\n        GPAScaleEntry(gpa_threshold=4.0, letter_grade=\"A+\", inclusive=True),\n        GPAScaleEntry(gpa_threshold=3.7, letter_grade=\"A\", inclusive=False),\n        GPAScaleEntry(gpa_threshold=3.3, letter_grade=\"A-\", inclusive=False),\n        GPAScaleEntry(gpa_threshold=3.0, letter_grade=\"B+\", inclusive=False),\n        GPAScaleEntry(gpa_threshold=2.7, letter_grade=\"B\", inclusive=False),\n        GPAScaleEntry(gpa_threshold=2.3, letter_grade=\"B-\", inclusive=False),\n        GPAScaleEntry(gpa_threshold=2.0, letter_grade=\"C+\", inclusive=False),\n        GPAScaleEntry(gpa_threshold=1.7, letter_grade=\"C\", inclusive=False),\n        GPAScaleEntry(gpa_threshold=1.3, letter_grade=\"C-\", inclusive=False),\n        GPAScaleEntry(gpa_threshold=1.0, letter_grade=\"D+\", inclusive=False),\n        GPAScaleEntry(gpa_threshold=0.7, letter_grade=\"D\", inclusive=False),\n        GPAScaleEntry(gpa_threshold=0.0, letter_grade=\"D-\", inclusive=False),\n        GPAScaleEntry(gpa_threshold=0.0, letter_grade=\"E\", inclusive=True) # Catch-all for 0.0\n    ]\n\n\n    class GradeConverter:\n        \"\"\"Encapsulates logic for converting GPAs to letter grades based on a scale.\"\"\"\n        def __init__(self, grading_scale: list[GPAScaleEntry]):\n            self._grading_scale = grading_scale\n\n        def convert_gpa_to_letter_grade(self, gpa: float) -> str:\n            \"\"\"Converts a single GPA value to its corresponding letter grade.\"\"\"\n            for entry in self._grading_scale:\n                if entry.inclusive:\n                    if gpa >= entry.gpa_threshold:\n                        return entry.letter_grade\n                else:\n                    if gpa > entry.gpa_threshold:\n                        return entry.letter_grade\n            return \"E\" # Fallback for edge cases, though the scale should cover all valid inputs.\n\n        def convert_gpas_to_letter_grades(self, gpas: list[float]) -> list[str]:\n            \"\"\"Converts a list of GPA values to a list of corresponding letter grades.\"\"\"\n            return [self.convert_gpa_to_letter_grade(gpa) for gpa in gpas]\n\n\n    converter = GradeConverter(GRADING_SCALE)\n    return converter.convert_gpas_to_letter_grades(grades)"}
{"task_id": "HumanEval/84", "solution": "class Utils:\n    @staticmethod\n    def decimal_to_binary(decimal_num: int) -> str:\n        \"\"\"Converts a non-negative decimal integer to its binary string representation.\n        It handles the edge case of 0 and uses Python's built-in bin() function.\"\"\"\n        if decimal_num == 0:\n            return \"0\"\n        return bin(decimal_num)[2:]\nclass DigitSumCalculator:\n    def calculate_digit_sum(self, n: int) -> int:\n        \"\"\"Calculates the sum of the decimal digits of n.\n        It converts the number to a string to easily iterate through its digits.\"\"\"\n        digit_sum = 0\n        s_n = str(n)\n        for digit_char in s_n:\n            digit_sum += int(digit_char)\n        return digit_sum\n\n    def convert_to_binary_string(self, decimal_sum: int) -> str:\n        \"\"\"Converts a decimal integer sum into its binary string representation.\n        This method delegates the conversion to the utility class.\"\"\"\n        return Utils.decimal_to_binary(decimal_sum)\ndef solve(N: int) -> str:\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    Constraints: 0 <= N <= 10000.\"\"\"\n    calculator = DigitSumCalculator()\n    digit_sum = calculator.calculate_digit_sum(N)\n    binary_representation = calculator.convert_to_binary_string(digit_sum)\n    return binary_representation"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n: int) -> int:\n    \"\"\"\n    Given a positive integer n, return the count of n-digit positive integers\n    that start or end with 1. It uses the principle of inclusion-exclusion.\n    \"\"\"\n    # Validate that n is a positive integer, as per FR1 and BR1.\n    if not isinstance(n, int):\n        raise ValueError(\"Input 'n' must be an integer.\")\n    if n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    # Handle the specific case for n=1, where only '1' qualifies.\n    if n == 1:\n        return 1\n\n    # Helper function to count n-digit numbers starting with 1 (FR2).\n    # This is effectively 1 followed by (n-1) digits (0-9).\n    count_starts_with_1 = 10**(n - 1)\n\n    # Helper function to count n-digit numbers ending with 1 (FR3).\n    # The last digit is 1. The first digit (for n > 1) can be 1-9 (9 choices).\n    # The (n-2) middle digits can be 0-9 (10 choices each).\n    # For n=2, this is 9 * 10^(2-2) = 9 * 10^0 = 9 numbers (11, 21, ..., 91).\n    count_ends_with_1 = 9 * (10**(n - 2))\n\n    # Helper function to count n-digit numbers starting AND ending with 1 (FR4).\n    # The first digit is 1, the last digit is 1.\n    # For n=2, only '11' qualifies, which is 10^(2-2) = 1.\n    # For n > 2, the (n-2) middle digits can be 0-9 (10 choices each).\n    count_starts_and_ends_with_1 = 10**(n - 2)\n\n    # Apply the principle of inclusion-exclusion (FR5) for the total count:\n    # P(A or B) = P(A) + P(B) - P(A and B)\n    return count_starts_with_1 + count_ends_with_1 - count_starts_and_ends_with_1"}
{"task_id": "HumanEval/84", "solution": "MIN_N = 0\nMAX_N = 10000\ndef solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    Constraints: 0 <= N <= 10000.\n    \"\"\"\n    if not isinstance(N, int):\n        raise TypeError(\"Input N must be an integer.\")\n    if not (MIN_N <= N <= MAX_N):\n        raise ValueError(f\"Input N must be between {MIN_N} and {MAX_N} (inclusive).\")\n\n    # Convert N to string to iterate over digits.\n    n_str = str(N)\n    # Sum the integer value of each digit.\n    digit_sum = sum(int(digit) for digit in n_str)\n\n    # Convert the sum to its binary representation and remove the \"0b\" prefix.\n    binary_sum = bin(digit_sum)[2:]\n    \n    return binary_sum"}
{"task_id": "HumanEval/85", "solution": "def add(lst):\n    \"\"\"Given a non-empty list of integers lst. add the even elements that are at odd indices..\n\n\n    Examples:\n        add([4, 2, 6, 7]) ==> 2\n    \"\"\"\n    total_sum = 0\n    for i, element in enumerate(lst):\n        # Check if the index is odd and the element is even.\n        if i % 2 != 0 and element % 2 == 0:\n            total_sum += element\n    return total_sum"}
{"task_id": "HumanEval/69", "solution": "from collections import Counter\ndef search(lst):\n    \"\"\"\n    Finds the greatest integer in a list whose frequency is greater than or equal to its value.\n    Returns -1 if no such integer exists, or raises ValueError for invalid inputs.\n    \"\"\"\n    if not lst:\n        raise ValueError(\"Input list cannot be empty.\")\n    for item in lst:\n        if not isinstance(item, int):\n            raise ValueError(f\"List elements must be integers, found {type(item).__name__}.\")\n        if item <= 0:\n            raise ValueError(f\"List elements must be positive integers, found {item}.\")\n\n    frequencies = Counter(lst)\n    \n    qualifying_integers = []\n    for num, freq in frequencies.items():\n        if freq >= num:\n            qualifying_integers.append(num)\n    \n    if not qualifying_integers:\n        return -1\n    \n    return max(qualifying_integers)"}
{"task_id": "HumanEval/85", "solution": "def add(lst: list[int]) -> int:\n    \"\"\"Given a non-empty list of integers lst, add the even elements that are at odd indices.\n    Raises ValueError for an empty list, and TypeError for invalid input types.\n    \"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"Input must be a list.\")\n    if not lst:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    total_sum = 0\n    for i, element in enumerate(lst):\n        if not isinstance(element, int):\n            raise TypeError(f\"List element at index {i} is not an integer: {element}\")\n        \n        # Check if the index is odd and the element is even.\n        if i % 2 != 0 and element % 2 == 0:\n            total_sum += element\n            \n    return total_sum"}
{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Takes a string and returns an ordered version of it.\n    Words are reordered by sorting their characters based on ASCII values, preserving original word order and spacing.\n    \"\"\"\n    # Splits the input string into words using space as a delimiter.\n    # Empty strings are created for multiple spaces, preserving original spacing.\n    words = s.split(' ')\n    \n    # Sorts characters within each word in ascending order based on their ASCII values.\n    # The sorted characters are then joined back to form a new word.\n    processed_words = [''.join(sorted(word)) for word in words]\n    \n    # Reconstructs the string by joining the processed words with single spaces,\n    # thereby preserving the original word order and spacing.\n    return ' '.join(processed_words)"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Sorts an array of non-negative integers based on the parity of the sum of its first and last elements.\n    Returns a new sorted array, leaving the original array unchanged.\n    \"\"\"\n    if not array:\n        return []\n    if len(array) == 1:\n        return list(array)\n\n    first_last_sum = array[0] + array[-1]\n\n    if first_last_sum % 2 != 0:\n        return sorted(array)\n    else:\n        return sorted(array, reverse=True)"}
