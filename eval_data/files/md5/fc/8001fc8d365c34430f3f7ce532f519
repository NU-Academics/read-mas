{"task_id": "HumanEval/127", "solution": "import math\nfrom dataclasses import dataclass\nfrom typing import Optional, Tuple\nclass IntervalCalculator:\n    \"\"\"Provides methods for interval-related calculations.\"\"\"\n\n    def calculate_intersection(self, interval1: Interval, interval2: Interval) -> Optional[Interval]:\n        \"\"\"Calculates the intersection of two intervals.\"\"\"\n        max_start = max(interval1.start, interval2.start)\n        min_end = min(interval1.end, interval2.end)\n        if max_start <= min_end:\n            return Interval(max_start, min_end)\n        return None\n\n    def get_length(self, interval: Interval) -> int:\n        \"\"\"Calculates the length of an interval.\"\"\"\n        return interval.end - interval.start + 1\nclass PrimeChecker:\n    \"\"\"Provides methods for checking if a number is prime.\"\"\"\n\n    def is_prime(self, n: int) -> bool:\n        \"\"\"Checks if a given non-negative integer is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\nclass IntervalService:\n    \"\"\"Orchestrates the business logic of finding intersection, length, and primality.\"\"\"\n\n    def __init__(self, interval_calculator: IntervalCalculator, prime_checker: PrimeChecker):\n        \"\"\"Constructor, injects dependencies.\"\"\"\n        self._interval_calculator = interval_calculator\n        self._prime_checker = prime_checker\n\n    def process_intervals(self, interval1_tuple: Tuple[int, int], interval2_tuple: Tuple[int, int]) -> str:\n        \"\"\"Main service method to process two interval tuples.\"\"\"\n        interval1 = Interval(interval1_tuple[0], interval1_tuple[1])\n        interval2 = Interval(interval2_tuple[0], interval2_tuple[1])\n\n        intersection_interval = self._interval_calculator.calculate_intersection(interval1, interval2)\n\n        if intersection_interval is None:\n            return \"NO\"\n\n        length = self._interval_calculator.get_length(intersection_interval)\n        if self._prime_checker.is_prime(length):\n            return \"YES\"\n        return \"NO\"\ndef intersection(interval1: Tuple[int, int], interval2: Tuple[int, int]) -> str:\n    \"\"\"\n    Determines whether the length of the intersection of two intervals\n    is a prime number.\n    Returns \"YES\" if the length of the intersection is a prime number, \"NO\" otherwise.\n    \"\"\"\n    interval_calculator = IntervalCalculator()\n    prime_checker = PrimeChecker()\n    interval_service = IntervalService(interval_calculator, prime_checker)\n    return interval_service.process_intervals(interval1, interval2)"}
