{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    This utility counts occurrences of the digit '7' in qualifying integers.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n    if n <= 1:\n        return 0\n\n    total_sevens = 0\n    for i in range(1, n):\n        # Check if 'i' is divisible by 11 or 13.\n        if (i % 11 == 0) or (i % 13 == 0):\n            # Count the digit '7' in the string representation of 'i'.\n            total_sevens += str(i).count('7')\n    return total_sevens"}
{"task_id": "HumanEval/19", "solution": "from typing import List, Dict\nWORD_TO_INT_MAP: Dict[str, int] = {\n    \"zero\": 0, \"one\": 1, \"two\": 2, \"three\": 3, \"four\": 4,\n    \"five\": 5, \"six\": 6, \"seven\": 7, \"eight\": 8, \"nine\": 9\n}\nINT_TO_WORD_MAP: Dict[int, str] = {\n    0: \"zero\", 1: \"one\", 2: \"two\", 3: \"three\", 4: \"four\",\n    5: \"five\", 6: \"six\", 7: \"seven\", 8: \"eight\", 9: \"nine\"\n}\ndef sort_numbers(numbers: str) -> str:\n    \"\"\"Sorts a space-delimited string of number words from smallest to largest.\n    Only words 'zero' through 'nine' are processed; invalid words are ignored.\"\"\"\n\n    if not numbers:\n        return \"\"\n\n    words: List[str] = numbers.split()\n    \n    int_numbers: List[int] = []\n    for word in words:\n        if word in WORD_TO_INT_MAP:\n            int_numbers.append(WORD_TO_INT_MAP[word])\n    \n    int_numbers.sort()\n    \n    sorted_words: List[str] = [INT_TO_WORD_MAP[num] for num in int_numbers]\n    \n    return \" \".join(sorted_words)"}
