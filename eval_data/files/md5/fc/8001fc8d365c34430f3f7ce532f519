{"task_id": "HumanEval/91", "solution": "import re\ndef is_bored(S):\n    \"\"\"\n    Counts sentences starting with \"I\" (case-insensitive, standalone word).\n    Sentences are delimited by '.', '?', or '!'.\n    \"\"\"\n\n    if not isinstance(S, str):\n        raise TypeError(\"Input must be a string.\")\n    if not S:\n        return 0\n\n    SENTENCE_DELIMITERS = ['.', '?', '!']\n\n    def _split_sentences(text: str) -> list[str]:\n        # Splits text into sentences based on defined delimiters, handling lack of space after delimiters.\n        # It uses a temporary marker to facilitate robust splitting, then cleans up results.\n        temp_text = text\n        for delimiter in SENTENCE_DELIMITERS:\n            temp_text = temp_text.replace(delimiter, delimiter + '###SENTENCE_END###')\n        \n        raw_sentences = [s.strip() for s in temp_text.split('###SENTENCE_END###') if s.strip()]\n        \n        cleaned_sentences = []\n        for sentence in raw_sentences:\n            cleaned_sentence = sentence\n            for delimiter in SENTENCE_DELIMITERS:\n                if cleaned_sentence.endswith(delimiter):\n                    cleaned_sentence = cleaned_sentence[:-len(delimiter)]\n            cleaned_sentences.append(cleaned_sentence.strip())\n            \n        return [s for s in cleaned_sentences if s] \n\n    def _starts_with_i(sentence: str) -> bool:\n        # Checks if a sentence starts with the standalone word \"I\", case-insensitively.\n        # Handles leading/trailing whitespace by trimming the sentence first.\n        trimmed_sentence = sentence.strip()\n        return re.match(r\"^I\\b\", trimmed_sentence, re.IGNORECASE) is not None\n\n    boredom_count = 0\n    sentences = _split_sentences(S)\n\n    for sentence in sentences:\n        if _starts_with_i(sentence):\n            boredom_count += 1\n            \n    return boredom_count"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    \"\"\"\n    Checks if one of three numbers is the sum of the other two,\n    and all numbers are integers. Returns false otherwise.\n    \"\"\"\n\n    def _is_integer(num):\n        # Helper to check if a number is an integer, including float representations like 5.0.\n        return isinstance(num, int) or (isinstance(num, float) and num.is_integer())\n\n    # Verify if all three input values are integers.\n    if not (_is_integer(x) and _is_integer(y) and _is_integer(z)):\n        return False\n\n    # All numbers are integers, now verify the sum condition.\n    return (x == y + z) or (y == x + z) or (z == x + y)"}
