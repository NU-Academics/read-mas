{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers by the sum of their digits, with original index as a tie-breaker.\n    Returns a new list, leaving the original input list unchanged.\n    \"\"\"\n\n    def _calculate_digit_sum(num):\n        \"\"\"Calculates the sum of digits using the absolute value of the number.\"\"\"\n        s = 0\n        for digit_char in str(abs(num)):\n            s += int(digit_char)\n        return s\n\n    if not nums:\n        return []\n\n    # Create tuples (digit_sum, original_index, original_number) for sorting.\n    decorated_list = []\n    for index, num in enumerate(nums):\n        digit_sum = _calculate_digit_sum(num)\n        decorated_list.append((digit_sum, index, num))\n\n    # Sort primarily by digit_sum, secondarily by original_index.\n    decorated_list.sort(key=lambda x: (x[0], x[1]))\n\n    # Extract the original numbers from the sorted tuples.\n    return [item[2] for item in decorated_list]"}
{"task_id": "HumanEval/146", "solution": "class DigitUtils:\n    @staticmethod\n    def get_first_digit(num: int) -> int:\n        \"\"\"Extracts the first digit of a number, considering its absolute value.\n        For example, 1 for 123, 4 for -456, 0 for 0.\"\"\"\n        s_num = str(abs(num))\n        return int(s_num[0])\n\n    @staticmethod\n    def get_last_digit(num: int) -> int:\n        \"\"\"Extracts the last digit of a number, considering its absolute value.\n        For example, 3 for 123, 6 for -456, 0 for 0.\"\"\"\n        s_num = str(abs(num))\n        return int(s_num[-1])\n\n    @staticmethod\n    def is_odd(digit: int) -> bool:\n        \"\"\"Checks if a given digit is odd.\n        Returns True if the digit is odd, False otherwise.\"\"\"\n        return digit % 2 != 0\ndef specialFilter(nums):\n    \"\"\"Counts numbers greater than 10 where both their first and last digits are odd.\n    Uses DigitUtils to extract and check digits, applying the specified filtering criteria.\"\"\"\n    count = 0\n    for num in nums:\n        if num > 10:\n            first_digit = DigitUtils.get_first_digit(num)\n            last_digit = DigitUtils.get_last_digit(num)\n            if DigitUtils.is_odd(first_digit) and DigitUtils.is_odd(last_digit):\n                count += 1\n    return count"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Calculates the number of specific integer triples from a generated array.\n    Finds triples (a[i], a[j], a[k]) where i < j < k and their sum is a multiple of 3.\n    \"\"\"\n    if n < 1:\n        raise ValueError(\"n must be a positive integer.\")\n\n    a = [(i * i - i + 1) for i in range(1, n + 1)]\n\n    if n < 3:\n        return 0\n\n    count = 0\n    # Pre-calculate remainders to optimize sum checks.\n    remainders = [x % 3 for x in a]\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            for k in range(j + 1, n):\n                if (remainders[i] + remainders[j] + remainders[k]) % 3 == 0:\n                    count += 1\n    return count"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst: list[str]) -> list[str]:\n    \"\"\"\n    Filters a list of strings, keeping only those with even lengths.\n    Sorts the remaining strings by length (ascending) then alphabetically (ascending).\n    \"\"\"\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n    sorted_strings = sorted(even_length_strings, key=lambda s: (len(s), s))\n    return sorted_strings"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst: list[str]) -> list[str]:\n    \"\"\"\n    Filters a list of strings to include only even-length strings,\n    then sorts them by length (ascending) and alphabetically (ascending).\n    \"\"\"\n    # Filter out strings with odd lengths.\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n\n    # Sort primarily by length (ascending) and secondarily by string value (alphabetical ascending).\n    sorted_result = sorted(even_length_strings, key=lambda s: (len(s), s))\n\n    return sorted_result"}
{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun \n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn, \n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2. \n    The function should return a tuple containing all planets whose orbits are \n    located between the orbit of planet1 and the orbit of planet2, sorted by \n    the proximity to the sun. \n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names. \n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    PLANETS_ORDER = [\n        \"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\",\n        \"Saturn\", \"Uranus\", \"Neptune\"\n    ]\n\n    def _get_planet_index(planet_name: str) -> int:\n        \"\"\"Helper to get the case-insensitive index of a planet name from PLANETS_ORDER.\"\"\"\n        try:\n            return [p.lower() for p in PLANETS_ORDER].index(planet_name.lower())\n        except ValueError:\n            return -1\n\n    idx1 = _get_planet_index(planet1)\n    idx2 = _get_planet_index(planet2)\n\n    if idx1 == -1 or idx2 == -1:\n        return ()\n\n    start_slice_idx = min(idx1, idx2) + 1\n    end_slice_idx = max(idx1, idx2)\n\n    if start_slice_idx >= end_slice_idx:\n        return ()\n\n    return tuple(PLANETS_ORDER[start_slice_idx:end_slice_idx])"}
{"task_id": "HumanEval/148", "solution": "from enum import Enum\ndef bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun\n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn,\n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2.\n    The function should return a tuple containing all planets whose orbits are\n    located between the orbit of planet1 and the orbit of planet2, sorted by\n    the proximity to the sun.\n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names.\n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n\n    class Planet(Enum):\n        MERCURY = \"Mercury\"\n        VENUS = \"Venus\"\n        EARTH = \"Earth\"\n        MARS = \"Mars\"\n        JUPITER = \"Jupiter\"\n        SATURN = \"Saturn\"\n        URANUS = \"Uranus\"\n        NEPTUNE = \"Neptune\"\n\n    PLANET_ORDER: list[Planet] = [\n        Planet.MERCURY,\n        Planet.VENUS,\n        Planet.EARTH,\n        Planet.MARS,\n        Planet.JUPITER,\n        Planet.SATURN,\n        Planet.URANUS,\n        Planet.NEPTUNE,\n    ]\n\n    try:\n        planet1_enum = Planet[planet1.upper()]\n        planet2_enum = Planet[planet2.upper()]\n    except KeyError:\n        return ()\n\n    idx1 = PLANET_ORDER.index(planet1_enum)\n    idx2 = PLANET_ORDER.index(planet2_enum)\n\n    start_idx = min(idx1, idx2)\n    end_idx = max(idx1, idx2)\n\n    if end_idx - start_idx <= 1:\n        return ()\n\n    intermediate_planets = PLANET_ORDER[start_idx + 1:end_idx]\n    return tuple(p.value for p in intermediate_planets)"}
{"task_id": "HumanEval/147", "solution": "import collections\ndef get_max_triples(n: int) -> int:\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) from an array a\n    where a[i] = i*i - i + 1, i < j < k, and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n    # Validate input n as a positive integer.\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input n must be a positive integer.\")\n    \n    # A minimum of 3 elements are required to form a triple.\n    if n < 3:\n        return 0\n\n    # Count occurrences of each remainder modulo 3 for array elements.\n    remainder_counts = collections.Counter()\n    for i in range(1, n + 1):\n        value = i * i - i + 1\n        remainder_counts[value % 3] += 1\n    \n    count = 0\n    r0 = remainder_counts[0]\n    r1 = remainder_counts[1]\n    r2 = remainder_counts[2]\n\n    # Add combinations for (0, 0, 0), (1, 1, 1), (2, 2, 2), and (0, 1, 2) remainders.\n    if r0 >= 3:\n        count += (r0 * (r0 - 1) * (r0 - 2)) // 6\n    if r1 >= 3:\n        count += (r1 * (r1 - 1) * (r1 - 2)) // 6\n    if r2 >= 3:\n        count += (r2 * (r2 - 1) * (r2 - 2)) // 6\n    count += r0 * r1 * r2\n    \n    return count"}
{"task_id": "HumanEval/150", "solution": "from typing import Any\ndef x_or_y(n: int, x: Any, y: Any) -> Any:\n    \"\"\"Returns x if n is prime, and y otherwise.\n    This function applies an efficient primality test for integer n.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n\n    # Optimized primality test\n    if n <= 1:\n        return y  # Numbers less than or equal to 1 are not prime\n    if n <= 3:  # 2 and 3 are prime numbers\n        return x\n    if n % 2 == 0 or n % 3 == 0:\n        return y  # Exclude multiples of 2 and 3\n\n    # Check for factors from 5 onwards\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return y  # Found a divisor, so n is not prime\n        i += 6\n    \n    return x  # No divisors found, n is prime"}
{"task_id": "HumanEval/150", "solution": "def x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n    \"\"\"\n    \n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n\n    is_n_prime = False\n    if n <= 1:\n        is_n_prime = False\n    elif n <= 3:\n        is_n_prime = True\n    elif n % 2 == 0 or n % 3 == 0:\n        is_n_prime = False\n    else:\n        i = 5\n        is_n_prime = True\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                is_n_prime = False\n                break\n            i += 6\n            \n    if is_n_prime:\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    \"\"\"\n    Calculates the sum of squares of odd, positive integers from a given list.\n    Non-integer, non-positive, or even numbers are ignored.\n    \"\"\"\n    total_sum = 0\n    for num in lst:\n        if isinstance(num, int) and num > 0 and num % 2 != 0:\n            total_sum += num * num\n    return total_sum"}
{"task_id": "HumanEval/152", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to the comparison function.\n    It provides a specific message about the input error encountered.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef compare(game, guess):\n    \"\"\"I think we all remember that feeling when the result of some long-awaited\n    event is finally known. The feelings and thoughts you have at that moment are\n    definitely worth noting down and comparing.\n    Your task is to determine if a person correctly guessed the results of a number of matches.\n    You are given two arrays of scores and guesses of equal length, where each index shows a match. \n    Return an array of the same length denoting how far off each guess was. If they have guessed correctly,\n    the value is 0, and if not, the value is the absolute difference between the guess and the score.\n    \n    \n    example:\n\n    compare([1,2,3,4,5,1],[1,2,3,4,2,-2]) -> [0,0,0,0,3,3]\n    compare([0,5,0,0,0,4],[4,1,1,0,0,-2]) -> [4,4,1,0,0,6]\n    \"\"\"\n    if not isinstance(game, list) or not isinstance(guess, list):\n        raise InvalidInputError(\"Inputs 'game' and 'guess' must be lists.\")\n\n    if len(game) != len(guess):\n        raise InvalidInputError(\"Input arrays 'game' and 'guess' must be of equal length.\")\n\n    results = []\n    for i in range(len(game)):\n        try:\n            score = int(game[i])\n            user_guess = int(guess[i])\n        except (ValueError, TypeError):\n            raise InvalidInputError(\"All elements in 'game' and 'guess' must be integers.\")\n\n        if score == user_guess:\n            results.append(0)\n        else:\n            results.append(abs(score - user_guess))\n    return results"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    \"\"\"\n    Calculates the sum of squares of positive odd integers in a list.\n    Ignores non-integer, negative, or zero values from the calculation.\n    \"\"\"\n    total_sum = 0\n    if not lst:\n        return 0\n\n    for item in lst:\n        # Check if the item is an integer (FR8: ignore non-integers)\n        if not isinstance(item, int):\n            continue\n        # Check if the integer is positive (FR7: ignore negative numbers; BR1: strictly positive)\n        # Note: The prompt's example double_the_difference([1, 3, 2, 0]) == 1 + 9 + 0 + 0 = 10\n        # implies 0 is ignored as it's not odd, not because it's not positive.\n        # The design's NumberValidator explicitly states `num <= 0` returns False, meaning `num > 0`.\n        # Sticking to the design's interpretation for \"positive\".\n        if item <= 0:\n            continue\n        # Check if the integer is odd (FR3: determine if it is odd)\n        if item % 2 == 0:\n            continue\n        \n        # If all conditions met, square the value and add to sum (FR4, FR5)\n        total_sum += item * item\n        \n    return total_sum"}
{"task_id": "HumanEval/153", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    pass\nclass Extension:\n    \"\"\"Represents an extension with its name and calculated strength.\"\"\"\n    def __init__(self, name: str, strength: int):\n        if not isinstance(name, str):\n            raise InvalidInputError(\"Extension name must be a string.\")\n        if not isinstance(strength, int):\n            raise InvalidInputError(\"Extension strength must be an integer.\")\n        self._name = name\n        self._strength = strength\n\n    def get_name(self) -> str:\n        return self._name\n\n    def get_strength(self) -> int:\n        return self._strength\n\n    def __repr__(self) -> str:\n        return f\"Extension(name='{self._name}', strength={self._strength})\"\n\n    def __eq__(self, other):\n        if not isinstance(other, Extension):\n            return NotImplemented\n        return self._name == other._name and self._strength == other._strength\n\n    def __lt__(self, other):\n        if not isinstance(other, Extension):\n            return NotImplemented\n        return self._strength < other._strength\nclass ExtensionStrengthCalculator:\n    \"\"\"Calculates the strength of an extension: (uppercase count - lowercase count).\"\"\"\n    def calculate(self, extension_name: str) -> int:\n        if not isinstance(extension_name, str):\n            raise InvalidInputError(\"Extension name must be a string.\")\n\n        cap_count = sum(1 for char in extension_name if 'A' <= char <= 'Z')\n        sm_count = sum(1 for char in extension_name if 'a' <= char <= 'z')\n        return cap_count - sm_count\nclass StrongestExtensionFinder:\n    \"\"\"Identifies the strongest Extension object from a list, handling ties by precedence.\"\"\"\n    def __init__(self, calculator: ExtensionStrengthCalculator):\n        self._calculator = calculator\n\n    def find(self, extensions: list[Extension]) -> Extension:\n        if not isinstance(extensions, list):\n            raise InvalidInputError(\"Extensions must be a list.\")\n        if not extensions:\n            raise InvalidInputError(\"The list of extensions cannot be empty.\")\n\n        strongest_ext = None\n        max_strength = -float('inf')\n\n        for ext in extensions:\n            if not isinstance(ext, Extension):\n                raise InvalidInputError(\"All items in the extensions list must be Extension objects.\")\n\n            current_strength = ext.get_strength()\n\n            # The loop naturally ensures that if `current_strength == max_strength`,\n            # the earlier `strongest_ext` is retained.\n            if current_strength > max_strength:\n                max_strength = current_strength\n                strongest_ext = ext\n\n        if strongest_ext is None:\n            raise InvalidInputError(\"Could not determine the strongest extension.\")\n\n        return strongest_ext\ndef Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension for a class, calculating strength as CAP - SM.\n    In case of strength ties, the first appearing extension in the list is chosen.\"\"\"\n\n    if not isinstance(class_name, str):\n        raise InvalidInputError(\"Class name must be a string.\")\n    if not isinstance(extensions, list):\n        raise InvalidInputError(\"Extensions must be a list.\")\n    if not extensions:\n        raise InvalidInputError(\"The list of extensions cannot be empty.\")\n    if not all(isinstance(ext, str) for ext in extensions):\n        raise InvalidInputError(\"All items in the extensions list must be strings.\")\n\n    calculator = ExtensionStrengthCalculator()\n    processed_extensions: list[Extension] = []\n\n    for ext_name in extensions:\n        strength = calculator.calculate(ext_name)\n        processed_extensions.append(Extension(name=ext_name, strength=strength))\n\n    finder = StrongestExtensionFinder(calculator)\n    strongest_extension_obj = finder.find(processed_extensions)\n\n    return f\"{class_name}.{strongest_extension_obj.get_name()}\""}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a: str, b: str) -> bool:\n    \"\"\"Checks if the second word or any of its rotations is a substring in the first word.\n    Returns True if a rotation of b is found as a substring in a, False otherwise.\n    \"\"\"\n    if not b:\n        return True  # An empty string is a substring of any string.\n    if len(b) > len(a):\n        return False # A longer pattern cannot be a substring of a shorter target.\n\n    def _generate_rotations(s: str) -> list[str]:\n        \"\"\"Generates all unique cyclic rotations of a string.\n        It ensures a consistent order for generated rotations.\n        \"\"\"\n        if not s:\n            return [\"\"]\n        rotations = set()\n        n = len(s)\n        for i in range(n):\n            rotated_s = s[i:] + s[:i]\n            rotations.add(rotated_s)\n        return sorted(list(rotations))\n\n    rotations = _generate_rotations(b)\n    for rotation in rotations:\n        if rotation in a:\n            return True\n    return False"}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\n    cycpattern_check(\"abcd\",\"abd\") => False\n    cycpattern_check(\"hello\",\"ell\") => True\n    cycpattern_check(\"whassup\",\"psus\") => False\n    cycpattern_check(\"abab\",\"baa\") => True\n    cycpattern_check(\"efef\",\"eeff\") => False\n    cycpattern_check(\"himenss\",\"simen\") => True\n\n    \"\"\"\n    if len(b) > len(a):\n        return False\n\n    n = len(b)\n    for i in range(n):\n        rotation = b[i:] + b[:i]\n        if rotation in a:\n            return True\n    return False"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"\n    Counts the number of even and odd digits in an integer.\n    Handles negative numbers by considering their absolute value.\n    \"\"\"\n    if not isinstance(num, int):\n        raise TypeError(\"Input 'num' must be an integer.\")\n\n    even_count = 0\n    odd_count = 0\n\n    # Convert to absolute value to handle negative numbers.\n    abs_num = abs(num)\n\n    # Special case for 0: it has one even digit.\n    if abs_num == 0:\n        return (1, 0)\n\n    # Iterate through digits by converting to string.\n    num_str = str(abs_num)\n\n    for digit_char in num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/155", "solution": "from typing import List, Tuple\nclass InvalidInputError(TypeError):\n    \"\"\"Custom exception for invalid input types.\"\"\"\n    pass\nclass DigitExtractor:\n    \"\"\"Utility for extracting individual digits from an integer.\"\"\"\n\n    def extract_digits(self, num: int) -> List[int]:\n        \"\"\"\n        Converts an integer into a list of its individual digits.\n        Handles negative numbers by taking their absolute value.\n        \"\"\"\n        abs_num = abs(num)\n        if abs_num == 0:\n            return [0]\n        return [int(d) for d in str(abs_num)]\nclass EvenOddCounter:\n    \"\"\"Service responsible for counting even and odd digits within an integer.\"\"\"\n    def __init__(self, digit_extractor: DigitExtractor):\n        self._digit_extractor = digit_extractor\n\n    def count_digits(self, num: int) -> Tuple[int, int]:\n        \"\"\"\n        Extracts digits from an integer and counts their parity.\n        Returns a tuple (even_count, odd_count), raising InvalidInputError if input is not an integer.\n        \"\"\"\n        if not isinstance(num, int):\n            raise InvalidInputError(\"Input must be an integer.\")\n\n        even_count = 0\n        odd_count = 0\n\n        digits = self._digit_extractor.extract_digits(num)\n\n        for digit in digits:\n            if digit % 2 == 0:\n                even_count += 1\n            else:\n                odd_count += 1\n        return (even_count, odd_count)\ndef even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    digit_extractor = DigitExtractor()\n    counter_service = EvenOddCounter(digit_extractor)\n    return counter_service.count_digits(num)"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"\n    Finds the strongest extension for a class based on character case counts.\n    Ties in strength are broken by choosing the first encountered extension.\n    \"\"\"\n    import math\n    from typing import Optional\n\n    class Extension:\n        \"\"\"Represents an extension with its name and calculated strength.\n        It provides properties for accessing these immutable values.\"\"\"\n        def __init__(self, name: str, strength: int):\n            if not isinstance(name, str):\n                raise TypeError(\"Extension name must be a string.\")\n            if not isinstance(strength, int):\n                raise TypeError(\"Extension strength must be an integer.\")\n            self._name = name\n            self._strength = strength\n\n        @property\n        def name(self) -> str:\n            return self._name\n\n        @property\n        def strength(self) -> int:\n            return self._strength\n\n        def __repr__(self) -> str:\n            return f\"Extension(name='{self.name}', strength={self.strength})\"\n\n    class ExtensionAnalyzer:\n        \"\"\"Analyzes an extension name to calculate its strength.\n        Strength is uppercase count minus lowercase count.\"\"\"\n        def calculate_strength(self, extension_name: str) -> int:\n            if not isinstance(extension_name, str):\n                raise TypeError(\"Extension name must be a string.\")\n\n            uppercase_count = sum(1 for char in extension_name if char.isupper())\n            lowercase_count = sum(1 for char in extension_name if char.islower())\n            return uppercase_count - lowercase_count\n\n    class StrongestExtensionFinder:\n        \"\"\"Finds the strongest extension from a list based on calculated strengths.\n        It uses an ExtensionAnalyzer for strength computation.\"\"\"\n        def __init__(self, analyzer: ExtensionAnalyzer):\n            self._analyzer = analyzer\n\n        def find_strongest(self, class_name: str, extensions: list[str]) -> str:\n            if not isinstance(class_name, str):\n                raise TypeError(\"Class name must be a string.\")\n            if not isinstance(extensions, list):\n                raise TypeError(\"Extensions must be a list.\")\n\n            if not extensions:\n                return f\"{class_name}.\" # Returns class name with a dot for empty list.\n\n            strongest_extension: Optional[Extension] = None\n            max_strength = -math.inf # Initializes with negative infinity to ensure first comparison wins.\n\n            for ext_name in extensions:\n                current_strength = self._analyzer.calculate_strength(ext_name)\n                \n                # Updates if current strength is strictly greater, or if it's the first encountered extension.\n                # This inherently handles tie-breaking by keeping the first in the list.\n                if strongest_extension is None or current_strength > max_strength:\n                    max_strength = current_strength\n                    strongest_extension = Extension(name=ext_name, strength=current_strength)\n\n            # strongest_extension is guaranteed to be not None here if extensions was not empty.\n            return f\"{class_name}.{strongest_extension.name}\"\n\n\n    analyzer = ExtensionAnalyzer()\n    finder = StrongestExtensionFinder(analyzer)\n    return finder.find_strongest(class_name, extensions)"}
{"task_id": "HumanEval/156", "solution": "class InvalidNumberError(ValueError):\n    \"\"\"Custom exception for numbers outside the valid Roman numeral range.\"\"\"\n    pass\nROMAN_MAP = [\n    (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n    (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n    (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'), (1, 'I')\n]\nMIN_NUMBER = 1\nMAX_NUMBER = 1000\ndef int_to_mini_roman(number: int) -> str:\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase. Restrictions: 1 <= num <= 1000.\n    \"\"\"\n    if not isinstance(number, int) or not (MIN_NUMBER <= number <= MAX_NUMBER):\n        raise InvalidNumberError(\n            f\"Number must be an integer between {MIN_NUMBER} and {MAX_NUMBER} inclusive.\"\n        )\n\n    roman_numeral = []\n    temp_num = number\n    for value, symbol in ROMAN_MAP:\n        while temp_num >= value:\n            roman_numeral.append(symbol)\n            temp_num -= value\n    return \"\".join(roman_numeral).lower()"}
{"task_id": "HumanEval/146", "solution": "def _get_first_digit(num: int) -> int:\n    \"\"\"Extracts the first digit of an integer using its absolute value.\n    It converts the number to a string to access the first character.\"\"\"\n    return int(str(abs(num))[0])\ndef _get_last_digit(num: int) -> int:\n    \"\"\"Calculates the last digit of an integer using the modulo 10 operation on its absolute value.\n    This method handles both positive and negative numbers correctly.\"\"\"\n    return abs(num) % 10\ndef _is_odd(digit: int) -> bool:\n    \"\"\"Checks if a given digit is odd.\n    A digit is considered odd if it is not evenly divisible by 2.\"\"\"\n    return digit % 2 != 0\ndef specialFilter(nums: list[int]) -> int:\n    \"\"\"Filters a list of numbers based on specific criteria and returns the count of matching numbers.\n    A number must be greater than 10, and have both its first and last digits as odd.\"\"\"\n    count = 0\n    for num in nums:\n        if num > 10:\n            first_digit = _get_first_digit(num)\n            last_digit = _get_last_digit(num)\n            if _is_odd(first_digit) and _is_odd(last_digit):\n                count += 1\n    return count"}
{"task_id": "HumanEval/157", "solution": "class InvalidSideError(ValueError):\n    \"\"\"Custom exception for invalid triangle side lengths.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\nclass InputValidator:\n    @staticmethod\n    def validate_sides(a, b, c):\n        \"\"\"\n        Validates that the given side lengths are positive numbers.\n        Raises InvalidSideError if any side is invalid.\n        \"\"\"\n        if not all(isinstance(side, (int, float)) for side in [a, b, c]):\n            raise InvalidSideError(\"Side lengths must be numeric.\")\n        if not all(side > 0 for side in [a, b, c]):\n            raise InvalidSideError(\"Side lengths must be positive.\")\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or\n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    InputValidator.validate_sides(a, b, c)\n\n    sides = sorted([a, b, c])\n    side1, side2, hypotenuse = sides[0], sides[1], sides[2]\n\n    # Compare the sum of squares of the two shorter sides with the square of the longest side.\n    return (side1**2 + side2**2) == hypotenuse**2"}
{"task_id": "HumanEval/158", "solution": "def find_max(words: list[str]) -> str:\n    \"\"\"\n    Returns the word with the maximum number of unique characters from a list.\n    If multiple strings tie, the lexicographically first word is returned.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    best_word = words[0]\n    max_unique_count = len(set(best_word))\n\n    for word in words[1:]:\n        current_unique_count = len(set(word))\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            best_word = word\n        elif current_unique_count == max_unique_count:\n            if word < best_word:\n                best_word = word\n        \n    return best_word"}
{"task_id": "HumanEval/157", "solution": "import math\nclass InvalidSideLengthError(ValueError):\n    \"\"\"Raised when a triangle side length is non-positive.\"\"\"\n    pass\nclass InvalidTriangleError(ValueError):\n    \"\"\"Raised when the given sides cannot form a valid triangle.\"\"\"\n    pass\ndef right_angle_triangle(a, b, c):\n    \"\"\"\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    \"\"\"\n    # Validate that all side lengths are positive numbers.\n    if not (a > 0 and b > 0 and c > 0):\n        raise InvalidSideLengthError(\"All side lengths must be positive.\")\n\n    # Validate the triangle inequality theorem.\n    if not (a + b > c and a + c > b and b + c > a):\n        raise InvalidTriangleError(\"The given sides cannot form a valid triangle.\")\n    \n    # Check if the Pythagorean theorem holds true, allowing for floating-point precision.\n    # Sort sides to easily identify potential hypotenuse.\n    sides = sorted([a, b, c])\n    s1, s2, hypotenuse = sides[0], sides[1], sides[2]\n\n    return math.isclose(s1**2 + s2**2, hypotenuse**2)"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase. Restrictions: 1 <= num <= 1000.\n    \"\"\"\n    # Input validation for range and type, raising ValueError as no custom exceptions are allowed.\n    if not isinstance(number, int) or not (1 <= number <= 1000):\n        raise ValueError(\"Input number must be an integer between 1 and 1000.\")\n\n    # Defines the Roman numeral mapping, ordered for the greedy conversion algorithm.\n    # The map uses lowercase symbols as required for mini-roman representation.\n    ROMAN_MAP = [\n        (1000, 'm'), (900, 'cm'), (500, 'd'), (400, 'cd'),\n        (100, 'c'), (90, 'xc'), (50, 'l'), (40, 'xl'),\n        (10, 'x'), (9, 'ix'), (5, 'v'), (4, 'iv'), (1, 'i')\n    ]\n\n    result = []\n    temp_num = number\n\n    # Iteratively subtracts the largest possible Roman numeral value from the number.\n    for value, symbol in ROMAN_MAP:\n        while temp_num >= value:\n            result.append(symbol)\n            temp_num -= value\n            \n    return \"\".join(result)"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Filters words from a sentence, returning only those whose lengths are prime numbers.\n    Maintains the original order of words in the new string.\n    \"\"\"\n\n    def _is_prime(n: int) -> bool:\n        \"\"\"\n        Determines if a given integer n is a prime number.\n        Returns True if n is prime, False otherwise.\n        \"\"\"\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    words = sentence.split()\n    filtered_words = []\n    for word in words:\n        if _is_prime(len(word)):\n            filtered_words.append(word)\n    return \" \".join(filtered_words)"}
{"task_id": "HumanEval/158", "solution": "def find_max(words: list[str]) -> str:\n    \"\"\"Finds the word with the maximum number of unique characters.\n    If ties exist, lexicographical order is used to break them.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_count = len(set(word))\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            # If tied, select the word that comes first lexicographically.\n            if result_word == \"\" or word < result_word:\n                result_word = word\n    return result_word"}
{"task_id": "HumanEval/159", "solution": "def eat(number: int, need: int, remaining: int) -> list[int]:\n    \"\"\"\n    Calculates total carrots eaten and remaining stock after a rabbit's meal.\n    The rabbit eats up to its need or all available carrots, whichever is less.\n    \"\"\"\n    actual_eaten = min(need, remaining)\n    total_eaten = number + actual_eaten\n    carrots_left = remaining - actual_eaten\n    \n    return [total_eaten, carrots_left]"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates total carrots eaten and remaining stock after a rabbit's meal, respecting available stock.\n    Returns `[total_eaten, carrots_left]`.\n    \"\"\"\n    if not isinstance(number, int):\n        raise ValueError(\"'number' must be an integer.\")\n    if not (0 <= number <= 1000):\n        raise ValueError(f\"'number' must be between 0 and 1000, inclusive. Got: {number}\")\n\n    if not isinstance(need, int):\n        raise ValueError(\"'need' must be an integer.\")\n    if not (0 <= need <= 1000):\n        raise ValueError(f\"'need' must be between 0 and 1000, inclusive. Got: {need}\")\n\n    if not isinstance(remaining, int):\n        raise ValueError(\"'remaining' must be an integer.\")\n    if not (0 <= remaining <= 1000):\n        raise ValueError(f\"'remaining' must be between 0 and 1000, inclusive. Got: {remaining}\")\n\n    carrots_consumed_from_stock = min(need, remaining)\n    total_eaten = number + carrots_consumed_from_stock\n    carrots_left = remaining - carrots_consumed_from_stock\n\n    return [total_eaten, carrots_left]"}
