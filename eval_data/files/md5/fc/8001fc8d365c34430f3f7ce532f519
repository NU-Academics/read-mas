{"task_id": "HumanEval/67", "solution": "import re\ndef fruit_distribution(s, n):\n    \"\"\"\n    Calculates the number of mango fruits in a basket given apple and orange counts.\n    Raises ValueError for invalid string format or if known fruits exceed total.\n    \"\"\"\n    FRUIT_STRING_PATTERN = r\"(\\d+)\\s*apples\\s*and\\s*(\\d+)\\s*oranges\"\n\n    match = re.search(FRUIT_STRING_PATTERN, s)\n    if not match:\n        raise ValueError(\n            f\"Invalid fruit string format: '{s}'. Expected 'X apples and Y oranges'.\"\n        )\n\n    apples = int(match.group(1))\n    oranges = int(match.group(2))\n\n    total_known_fruits = apples + oranges\n\n    if total_known_fruits > n:\n        raise ValueError(\n            f\"Total known fruits ({total_known_fruits}) cannot exceed \"\n            f\"total fruits in basket ({n}).\"\n        )\n\n    mangoes = n - total_known_fruits\n    return mangoes"}
{"task_id": "HumanEval/67", "solution": "def fruit_distribution(s, n):\n    \"\"\"\n    Calculates the number of mango fruits in a basket.\n    Raises ValueError for invalid input string format or inconsistent fruit counts.\n    \"\"\"\n    import re\n\n    class FruitStringParser:\n        \"\"\"Parses fruit counts from a string using regex patterns.\"\"\"\n        _APPLE_PATTERN = r\"(\\d+)\\s*apples\"\n        _ORANGE_PATTERN = r\"(\\d+)\\s*oranges\"\n\n        def parse(self, s_val: str) -> tuple[int, int]:\n            \"\"\"\n            Parses the input string `s_val` to find apple and orange counts.\n            Raises ValueError for invalid string format or negative counts.\n            \"\"\"\n            apple_match = re.search(self._APPLE_PATTERN, s_val)\n            orange_match = re.search(self._ORANGE_PATTERN, s_val)\n\n            if not apple_match or not orange_match:\n                raise ValueError(\"Invalid fruit string format. Expected 'X apples and Y oranges'.\")\n\n            apples = int(apple_match.group(1))\n            oranges = int(orange_match.group(1))\n\n            if apples < 0 or oranges < 0:\n                 raise ValueError(\"Parsed apple or orange count cannot be negative.\")\n\n            return apples, oranges\n\n    class FruitCalculator:\n        \"\"\"Calculates the number of mangoes based on apple, orange, and total counts.\"\"\"\n        def calculate_mangoes(self, apples_val: int, oranges_val: int, total_fruits_val: int) -> int:\n            \"\"\"\n            Calculates `total_fruits_val - apples_val - oranges_val`.\n            Raises ValueError if fruit counts are negative or sum of apples/oranges exceeds total fruits.\n            \"\"\"\n            if apples_val < 0 or oranges_val < 0 or total_fruits_val < 0:\n                raise ValueError(\"Fruit counts cannot be negative.\")\n\n            sum_apples_oranges = apples_val + oranges_val\n            \n            if sum_apples_oranges > total_fruits_val:\n                raise ValueError(\"Sum of apples and oranges cannot exceed total fruits.\")\n            \n            return total_fruits_val - sum_apples_oranges\n\n    parser = FruitStringParser()\n    apples, oranges = parser.parse(s)\n\n    calculator = FruitCalculator()\n    mangoes = calculator.calculate_mangoes(apples, oranges, n)\n\n    return mangoes"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x: int, shift: int) -> str:\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    >>> circular_shift(12, 1)\n    \"21\"\n    >>> circular_shift(12, 2)\n    \"12\"\n    \"\"\"\n    if not isinstance(x, int) or not isinstance(shift, int):\n        raise ValueError(\"Both 'x' and 'shift' must be integers.\")\n\n    if x == 0:\n        return \"0\"\n\n    is_negative = x < 0\n    s = str(abs(x))\n    num_digits = len(s)\n\n    if shift >= num_digits:\n        shifted_s = s[::-1]\n    else:\n        effective_shift = shift % num_digits\n        shifted_s = s[num_digits - effective_shift:] + s[:num_digits - effective_shift]\n    \n    return \"-\" + shifted_s if is_negative else shifted_s"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr: list[int]) -> list[int]:\n    \"\"\"\n    Finds the smallest even non-negative integer in an array and its index.\n    If multiple elements share the smallest even value, the one with the lowest index is chosen.\n    \"\"\"\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for index, value in enumerate(arr):\n        if value % 2 == 0:  # Check if the number is even\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = index\n            elif value == smallest_even_value and index < smallest_even_index:\n                # If values are equal, prioritize the one with the smallest index\n                smallest_even_index = index\n\n    if smallest_even_index == -1:\n        return []  # Return empty list if no even numbers are found or array is empty\n    else:\n        return [smallest_even_value, smallest_even_index]"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x right by shift, returning the result as a string.\n    If shift exceeds the number of digits, the digits are reversed.\n    \"\"\"\n    if shift < 0:\n        raise ValueError(\"Shift amount must be non-negative.\")\n\n    if x == 0:\n        return \"0\"\n\n    is_negative = x < 0\n    abs_x_str = str(abs(x))\n    digits = [int(d) for d in abs_x_str] # Converts the absolute value of x to a list of its digits.\n    num_digits = len(digits)\n\n    if shift > num_digits:\n        processed_digits = digits[::-1] # Reverses the order of digits if shift is too large.\n    else:\n        effective_shift = shift % num_digits\n        if effective_shift == 0:\n            processed_digits = list(digits) # No effective shift, return a copy of original digits.\n        else:\n            processed_digits = digits[-effective_shift:] + digits[:-effective_shift] # Performs the circular right shift.\n\n    result_str = \"\".join(map(str, processed_digits)) # Converts the list of digits back to a string.\n    return f\"-{result_str}\" if is_negative else result_str"}
{"task_id": "HumanEval/69", "solution": "from collections import Counter\ndef search(lst):\n    \"\"\"\n    Returns the greatest positive integer from a list whose frequency is greater than or equal to its value.\n    If no such integer exists, returns -1.\n    \"\"\"\n    if not lst:\n        return -1\n\n    frequency_map = Counter(lst)\n    \n    qualifying_numbers = []\n    for num, freq in frequency_map.items():\n        if freq >= num: # num > 0 is implicitly handled by problem statement's positive integer constraint.\n            qualifying_numbers.append(num)\n    \n    if not qualifying_numbers:\n        return -1\n    \n    return max(qualifying_numbers)"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr: list[int]) -> list[int]:\n    \"\"\"\n    Finds the smallest even non-negative integer in the input array.\n    If multiple such integers exist, it returns the one with the smallest index.\n    \"\"\"\n    if not arr:\n        return []\n\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for i, value in enumerate(arr):\n        if value % 2 == 0:  # Check if the current value is even.\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = i\n            # If value == smallest_even_value, we keep the existing smallest_even_index\n            # because we iterate from left to right, ensuring the smallest index is found first.\n\n    if smallest_even_index == -1:\n        return []\n    else:\n        return [smallest_even_value, smallest_even_index]"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    \"\"\"\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n\n    Examples:\n    strange_sort_list([1, 2, 3, 4]) == [1, 4, 2, 3]\n    strange_sort_list([5, 5, 5, 5]) == [5, 5, 5, 5]\n    strange_sort_list([]) == []\n    \"\"\"\n    if not lst:\n        return []\n\n    # Create a sorted copy of the input list to easily get min/max elements.\n    working_list = sorted(lst)\n    result = []\n    is_min_turn = True\n\n    while working_list:\n        if is_min_turn:\n            # The minimum element is at the beginning of the sorted list.\n            val = working_list.pop(0)\n        else:\n            # The maximum element is at the end of the sorted list.\n            val = working_list.pop()\n        result.append(val)\n        is_min_turn = not is_min_turn\n    \n    return result"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic.\n    \"\"\"\n    changes = 0\n    left = 0\n    right = len(arr) - 1\n\n    while left < right:\n        if arr[left] != arr[right]:\n            changes += 1\n        left += 1\n        right -= 1\n    return changes"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst: list[int]) -> list[int]:\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n\n    Examples:\n    strange_sort_list([1, 2, 3, 4]) == [1, 4, 2, 3]\n    strange_sort_list([5, 5, 5, 5]) == [5, 5, 5, 5]\n    strange_sort_list([]) == []\n    '''\n    if not lst:\n        return []\n\n    # Create a sorted copy to easily get min/max without modifying the original.\n    mutable_list = sorted(lst)\n    result_list = []\n    take_min = True\n\n    while mutable_list:\n        if take_min:\n            # Pop the smallest element from the front of the sorted list.\n            result_list.append(mutable_list.pop(0))\n        else:\n            # Pop the largest element from the end of the sorted list.\n            result_list.append(mutable_list.pop())\n        take_min = not take_min\n    return result_list"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q, w):\n    \"\"\"\n    Checks if object q will fly based on palindromic nature and weight.\n    An object flies if it's balanced (palindromic list) and its sum is <= w.\n    \"\"\"\n    if not isinstance(w, (int, float)):\n        raise TypeError(\"Input 'w' must be a number (int or float).\")\n\n    if not isinstance(q, list):\n        raise TypeError(\"Input 'q' must be a list.\")\n\n    is_balanced = (q == q[::-1])\n    \n    if not is_balanced:\n        return False\n    \n    # Validate and calculate sum of elements in 'q'.\n    for item in q:\n        if not isinstance(item, (int, float)):\n            raise TypeError(\"List 'q' must contain only numeric elements for sum calculation.\")\n    total_sum = sum(q)\n    \n    return total_sum <= w"}
{"task_id": "HumanEval/71", "solution": "import math\ndef triangle_area(a, b, c):\n    '''\n    Calculates the area of a triangle given its three side lengths. Returns the area rounded\n    to two decimal points if valid, otherwise returns -1.\n    '''\n    INVALID_TRIANGLE_AREA = -1.0\n\n    # Validate if sides are positive numbers (BR2, FR1 Error Handling).\n    if not (a > 0 and b > 0 and c > 0):\n        return INVALID_TRIANGLE_AREA\n\n    # Validate triangle inequality theorem (BR1, FR1 Main Flow).\n    if not (a + b > c and a + c > b and b + c > a):\n        return INVALID_TRIANGLE_AREA\n\n    # Calculate semi-perimeter (FR2 Main Flow).\n    s = (a + b + c) / 2\n\n    # Calculate raw area using Heron's formula (FR2 Main Flow).\n    # The term inside sqrt can be slightly negative due to float precision for near-degenerate triangles.\n    # However, our validation strictly ensures a valid (non-degenerate) triangle.\n    raw_area = math.sqrt(s * (s - a) * (s - b) * (s - c))\n\n    # Round the calculated area to two decimal points (FR3 Main Flow).\n    return round(raw_area, 2)"}
{"task_id": "HumanEval/71", "solution": "import math\nclass Triangle:\n    \"\"\"\n    Represents a triangle with its three side lengths.\n    Sides are immutable after creation.\n    \"\"\"\n    def __init__(self, side_a: float, side_b: float, side_c: float):\n        self._side_a = side_a\n        self._side_b = side_b\n        self._side_c = side_c\n\n    def get_side_a(self) -> float:\n        \"\"\"Returns the length of side A.\"\"\"\n        return self._side_a\n\n    def get_side_b(self) -> float:\n        \"\"\"Returns the length of side B.\"\"\"\n        return self._side_b\n\n    def get_side_c(self) -> float:\n        \"\"\"Returns the length of side C.\"\"\"\n        return self._side_c\ndef round_to_two_decimals(value: float) -> float:\n    \"\"\"Rounds a float value to two decimal places.\"\"\"\n    return round(value, 2)\nclass TriangleValidator:\n    \"\"\"\n    Determines if three given side lengths can form a valid triangle.\n    Checks for positive side lengths and triangle inequality.\n    \"\"\"\n    def is_valid(self, triangle: Triangle) -> bool:\n        a, b, c = triangle.get_side_a(), triangle.get_side_b(), triangle.get_side_c()\n\n        if a <= 0 or b <= 0 or c <= 0:\n            return False\n\n        # Triangle inequality theorem\n        if not (a + b >= c and a + c >= b and b + c >= a): # Using >= for degenerate triangles with area 0\n            return False\n        \n        return True\nclass TriangleAreaCalculator:\n    \"\"\"\n    Calculates the area of a valid triangle using Heron's formula.\n    Assumes the input triangle is geometrically valid.\n    \"\"\"\n    def calculate_area(self, triangle: Triangle) -> float:\n        a, b, c = triangle.get_side_a(), triangle.get_side_b(), triangle.get_side_c()\n        \n        s = (a + b + c) / 2\n        \n        # Heron's formula for area.\n        # Clamp value to 0 to prevent math.sqrt(negative) due to float inaccuracies.\n        area_squared = s * (s - a) * (s - b) * (s - c)\n        \n        if area_squared < 0:\n            area_squared = 0\n            \n        return math.sqrt(area_squared)\ndef triangle_area(a, b, c):\n    \"\"\"\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1.\n    \"\"\"\n    validator = TriangleValidator()\n    calculator = TriangleAreaCalculator()\n\n    triangle = Triangle(a, b, c)\n\n    if not validator.is_valid(triangle):\n        return -1.0\n    \n    raw_area = calculator.calculate_area(triangle)\n    return round_to_two_decimals(raw_area)"}
{"task_id": "HumanEval/72", "solution": "class ListUtils:\n    @staticmethod\n    def is_palindrome(q: list) -> bool:\n        \"\"\"Checks if a given list reads the same forwards and backwards.\n        Raises TypeError if 'q' is not a list.\n        \"\"\"\n        if not isinstance(q, list):\n            raise TypeError(\"Input 'q' must be a list.\")\n        return q == q[::-1]\n\n    @staticmethod\n    def calculate_sum(q: list) -> (int | float):\n        \"\"\"Calculates the sum of all elements in list 'q'.\n        Raises TypeError if 'q' is not a list or contains non-numeric elements.\n        \"\"\"\n        if not isinstance(q, list):\n            raise TypeError(\"Input 'q' must be a list.\")\n        for item in q:\n            if not isinstance(item, (int, float)):\n                raise TypeError(\"List 'q' must contain only numeric elements.\")\n        return sum(q)\nclass FlyCheckerService:\n    @staticmethod\n    def will_it_fly(q: list, w: int) -> bool:\n        \"\"\"Determines if object 'q' is a palindrome and its sum is less than or equal to 'w'.\n        Raises TypeError if 'q' is not a list, contains non-numeric elements, or 'w' is not an integer.\n        \"\"\"\n        if not isinstance(w, int):\n            raise TypeError(\"Input 'w' must be an integer.\")\n        \n        is_pal = ListUtils.is_palindrome(q)\n        if not is_pal:\n            return False\n        \n        total_weight = ListUtils.calculate_sum(q)\n        return total_weight <= w\ndef will_it_fly(q,w):\n    '''\n    Write a function that returns True if the object q will fly, and False otherwise.\n    The object q will fly if it's balanced (it is a palindromic list) and the sum of its elements is less than or equal the maximum possible weight w.\n    '''\n    return FlyCheckerService.will_it_fly(q, w)"}
{"task_id": "HumanEval/74", "solution": "def total_match(lst1, lst2):\n    \"\"\"\n    Compares two lists of strings based on their total character count.\n    Returns the list with the smaller count, or lst1 if counts are equal.\n    \"\"\"\n    char_count1 = sum(len(s) for s in lst1)\n    char_count2 = sum(len(s) for s in lst2)\n\n    if char_count1 < char_count2:\n        return lst1\n    elif char_count2 < char_count1:\n        return lst2\n    else:  # char_count1 == char_count2\n        return lst1"}
{"task_id": "HumanEval/73", "solution": "from typing import List\ndef smallest_change(arr: List[int]) -> int:\n    \"\"\"Calculates the minimum changes required to make an array palindromic. A change involves modifying one element to any other element.\"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input must be a list.\")\n    \n    for x in arr:\n        if not isinstance(x, int):\n            raise ValueError(\"All elements in the list must be integers.\")\n\n    n = len(arr)\n    changes = 0\n    for i in range(n // 2):\n        if arr[i] != arr[n - 1 - i]:\n            changes += 1\n    return changes"}
{"task_id": "HumanEval/74", "solution": "def total_match(lst1, lst2):\n    \"\"\"\n    Compares two lists of strings by their total character count.\n    Returns the list with the fewer characters, or the first list if counts are equal.\n    \"\"\"\n    if not isinstance(lst1, list):\n        raise TypeError(\"Input 'lst1' must be a list.\")\n    count1 = 0\n    for s in lst1:\n        if not isinstance(s, str):\n            raise TypeError(\"All elements in 'lst1' must be strings.\")\n        count1 += len(s)\n\n    if not isinstance(lst2, list):\n        raise TypeError(\"Input 'lst2' must be a list.\")\n    count2 = 0\n    for s in lst2:\n        if not isinstance(s, str):\n            raise TypeError(\"All elements in 'lst2' must be strings.\")\n        count2 += len(s)\n\n    if count1 <= count2:\n        return lst1\n    else:\n        return lst2"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"\n    Checks if a number x is a simple power of n, i.e., if n**k = x for some non-negative integer k.\n    Handles various integer inputs including edge cases as specified.\n    \"\"\"\n    if x < 0:\n        return False\n\n    if n <= 0:\n        if n == 0 and x == 0:\n            return True\n        return False\n\n    if x == 1:\n        return True\n\n    if n == 1:\n        return False\n\n    current_x = x\n    while current_x > 1:\n        if current_x % n != 0:\n            return False\n        current_x //= n\n    return True"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"\n    Checks if a given number is the product of exactly three prime numbers.\n    The input `a` must be an integer within the range (0, 100).\n    \"\"\"\n    # Helper function to determine if a number is prime.\n    def _is_prime(n: int) -> bool:\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    # Validate input 'a' against defined constraints.\n    # The smallest product of three primes is 2*2*2=8.\n    if a < 8 or a >= 100:\n        return False\n\n    # Generate a list of prime numbers less than 'a'.\n    primes = [p for p in range(2, a) if _is_prime(p)]\n\n    n_primes = len(primes)\n    # Iterate through all unique combinations of three primes (p1, p2, p3).\n    for i in range(n_primes):\n        p1 = primes[i]\n        # Optimization: if p1 cubed already exceeds 'a', no larger p1s will work.\n        if p1 * p1 * p1 > a:\n            break\n        for j in range(i, n_primes): # Start from i to allow non-distinct primes.\n            p2 = primes[j]\n            # Optimization: if p1 * p2 squared already exceeds 'a', no larger p2s will work.\n            if p1 * p2 * p2 > a:\n                break\n            for k in range(j, n_primes): # Start from j to allow non-distinct primes.\n                p3 = primes[k]\n                product = p1 * p2 * p3\n                if product == a:\n                    return True\n                # Optimization: if current product exceeds 'a', subsequent p3s will also exceed it.\n                if product > a:\n                    break\n    return False"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    \"\"\"Checks if an integer is a perfect cube.\n    It calculates the cube root and verifies if its cube matches the original number.\"\"\"\n    if a == 0:\n        return True\n\n    # Calculate the integer cube root, handling potential float inaccuracies.\n    # Use absolute value for root calculation to avoid issues with negative bases for fractional exponents.\n    abs_a = abs(a)\n    cbrt_approx = round(abs_a**(1/3))\n\n    # Reconstruct the cube with the correct sign and compare.\n    if a < 0:\n        return (-cbrt_approx)**3 == a\n    else:\n        return cbrt_approx**3 == a"}
