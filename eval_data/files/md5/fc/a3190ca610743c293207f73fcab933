{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    if not l:\n        return []\n\n    # Extract elements at even indices\n    even_indexed_elements = []\n    for i in range(0, len(l), 2):\n        even_indexed_elements.append(l[i])\n\n    # Sort the extracted elements\n    even_indexed_elements.sort()\n\n    # Create a new list for the result, initially a copy of l\n    result = list(l)\n\n    # Place the sorted even-indexed elements back into their positions\n    sorted_idx = 0\n    for i in range(0, len(l), 2):\n        result[i] = even_indexed_elements[sorted_idx]\n        sorted_idx += 1\n\n    return result"}
{"task_id": "HumanEval/35", "solution": "def max_element(l: list):\n    \"\"\"Return maximum element in the list.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    if not l:\n        # Based on examples, assuming list is not empty.\n        # If it could be empty, a different handling would be needed (e.g., raise error or return None).\n        pass\n\n    max_val = l[0]\n    for element in l[1:]:\n        if element > max_val:\n            max_val = element\n    return max_val"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    l_prime = list(l)  # Create a mutable copy of the input list.\n    third_elements = []\n    third_indices = []\n\n    for i in range(len(l)):\n        if i % 3 == 0:\n            third_elements.append(l[i])\n            third_indices.append(i)\n\n    third_elements.sort()\n\n    sorted_idx = 0\n    for i in third_indices:\n        l_prime[i] = third_elements[sorted_idx]\n        sorted_idx += 1\n\n    return l_prime"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n\n    def _is_divisible_by_11_or_13(i: int) -> bool:\n        \"\"\"Checks if an integer i is divisible by 11 or 13.\"\"\"\n        return (i % 11 == 0) or (i % 13 == 0)\n\n    def _count_digit_7(i: int) -> int:\n        \"\"\"Counts occurrences of the digit '7' in an integer i.\"\"\"\n        return str(i).count('7')\n\n    total_count = 0\n    # Iterate through integers from 1 up to n-1 (exclusive of n)\n    for i in range(1, n):\n        if _is_divisible_by_11_or_13(i):\n            total_count += _count_digit_7(i)\n\n    return total_count"}
{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    \"\"\"\n\n    def _is_prime(num: int) -> bool:\n        # Checks if a given number is prime.\n        if num <= 1:\n            return False\n        if num <= 3:  # 2 and 3 are prime numbers.\n            return True\n        if num % 2 == 0 or num % 3 == 0:\n            return False\n        i = 5\n        while i * i <= num:\n            if num % i == 0 or num % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def _generate_fibonacci_numbers():\n        # Generates an infinite sequence of Fibonacci numbers starting from 2.\n        a, b = 0, 1\n        # We skip 0 and 1 as they are not prime. The sequence starts yielding from F_3 (which is 2).\n        while True:\n            next_fib = a + b\n            a = b\n            b = next_fib\n            if next_fib >= 2:\n                yield next_fib\n\n    prime_count = 0\n    fib_gen = _generate_fibonacci_numbers()\n\n    while True:\n        fib_num = next(fib_gen)\n        if _is_prime(fib_num):\n            prime_count += 1\n            if prime_count == n:\n                return fib_num"}
{"task_id": "HumanEval/32", "solution": "    # Uses the bisection method to find a root, leveraging the guarantee of a solution.\n\n    # Set an initial wide search interval for an odd-degree polynomial.\n    low, high = -1_000_000.0, 1_000_000.0\n    \n    # These initial bounds ensure that poly(low) and poly(high) have opposite signs\n    # for an odd-degree polynomial with a non-zero leading coefficient.\n\n    tolerance = 1e-7\n    max_iterations = 200\n\n    for _ in range(max_iterations):\n        mid = (low + high) / 2\n        p_mid = poly(xs, mid)\n\n        if abs(p_mid) < tolerance:\n            return mid\n\n        # If poly(low) and poly(mid) have opposite signs, the root is in [low, mid].\n        # Otherwise, the root is in [mid, high].\n        if poly(xs, low) * p_mid < 0:\n            high = mid\n        else:\n            low = mid\n    \n    # Return the midpoint of the final interval if max_iterations are reached.\n    return (low + high) / 2"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # uncycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    for i in range(n - 2):\n        for j in range(i + 1, n - 1):\n            for k in range(j + 1, n):\n                if l[i] + l[j] + l[k] == 0:\n                    return True\n    return False"}
