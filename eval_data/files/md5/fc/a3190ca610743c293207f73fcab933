{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    class BracketString:\n        \"\"\"Encapsulates a bracket string and provides the core logic to determine its structural correctness.\"\"\"\n        def __init__(self, brackets_value: str):\n            self._value = brackets_value\n\n        def is_valid(self) -> bool:\n            \"\"\"Implements the core algorithm to check if the encapsulated bracket string is correctly formed.\"\"\"\n            balance = 0\n            for char in self._value:\n                if char == '<':\n                    balance += 1\n                elif char == '>':\n                    balance -= 1\n                if balance < 0:\n                    return False\n            return balance == 0\n\n    # NFR1: Input validation for type (implicitly handled by type hint enforcement in a strict environment)\n    # NFR2: Validate input characters\n    for char in brackets:\n        if char not in ['<', '>']:\n            return False\n\n    bracket_string_instance = BracketString(brackets)\n    return bracket_string_instance.is_valid()"}
