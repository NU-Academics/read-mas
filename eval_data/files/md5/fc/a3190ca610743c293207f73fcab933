{"task_id": "HumanEval/3", "solution": "def below_zero(operations: List[int]) -> bool:\n    \"\"\"Detects if a bank account balance, starting at zero, ever falls below zero given a list of operations.\n    Returns True if the balance falls below zero at any point, False otherwise.\n    \"\"\"\n    balance = 0\n    for operation in operations:\n        balance += operation\n        if balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/2", "solution": "def truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    integer_part = int(number)\n    decimal_part = number - integer_part\n    return decimal_part"}
{"task_id": "HumanEval/5", "solution": "def intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = [numbers[0]]\n    for i in range(1, len(numbers)):\n        result.append(delimeter)\n        result.append(numbers[i])\n    return result"}
{"task_id": "HumanEval/7", "solution": "def filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    result_list = []\n    for item in strings:\n        if substring in item:\n            result_list.append(item)\n    return result_list"}
{"task_id": "HumanEval/4", "solution": "def mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    if not numbers:\n        return 0.0  # Or raise an error, but per instructions, return 0.0 for empty list\n\n    # Calculate the mean of the dataset\n    mean_value = sum(numbers) / len(numbers)\n\n    # Calculate the sum of absolute differences from the mean\n    sum_absolute_differences = 0.0\n    for number in numbers:\n        sum_absolute_differences += abs(number - mean_value)\n\n    # Calculate the Mean Absolute Deviation\n    mad = sum_absolute_differences / len(numbers)\n\n    return mad"}
{"task_id": "HumanEval/6", "solution": "def parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    def _calculate_group_nesting(group_string: str) -> int:\n        \"\"\"Calculates the deepest nesting level within a single parentheses group string.\n        It tracks the current and maximum nesting levels while iterating through characters.\n        \"\"\"\n        current_level = 0\n        max_level = 0\n        for char in group_string:\n            if char == '(':\n                current_level += 1\n                max_level = max(max_level, current_level)\n            elif char == ')':\n                current_level -= 1\n        return max_level\n\n    groups = paren_string.split(' ')\n    results = []\n    for group in groups:\n        if group:  # Process only non-empty groups\n            results.append(_calculate_group_nesting(group))\n    return results"}
{"task_id": "HumanEval/1", "solution": "from typing import List\n\nclass ParenStringProcessor:\n    \"\"\"Encapsulates the raw input string and handles space removal.\"\"\"\n    def __init__(self, raw_string: str):\n        self._raw_string = raw_string\n        self._processed_string = self._remove_spaces_internal()\n\n    def _remove_spaces_internal(self) -> str:\n        \"\"\"Removes all space characters from the raw string.\"\"\"\n        return self._raw_string.replace(' ', '')\n\n    def get_processed_string(self) -> str:\n        \"\"\"Returns the string with spaces removed.\"\"\"\n        return self._processed_string\n\nclass ParenGroupValidator:\n    \"\"\"Validates if a string segment forms a balanced parenthesis group.\"\"\"\n    def __init__(self, content: str):\n        self._content = content\n\n    def is_balanced(self) -> bool:\n        \"\"\"Checks if the content string is a balanced parenthesis group.\"\"\"\n        balance = 0\n        for char in self._content:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    processor = ParenStringProcessor(paren_string)\n    processed_str = processor.get_processed_string()\n\n    groups: List[str] = []\n    balance = 0\n    start_index = -1\n\n    for i, char in enumerate(processed_str):\n        if char == '(':\n            balance += 1\n            if balance == 1:\n                start_index = i\n        elif char == ')':\n            balance -= 1\n            if balance == 0:\n                if start_index != -1:\n                    group_content = processed_str[start_index : i + 1]\n                    validator = ParenGroupValidator(group_content)\n                    if validator.is_balanced():\n                        groups.append(group_content)\n                start_index = -1\n            elif balance < 0:\n                # Malformed string, reset balance and start_index to look for a new group\n                balance = 0\n                start_index = -1\n\n    return groups"}
{"task_id": "HumanEval/0", "solution": "def has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    \"\"\"\n    if len(numbers) < 2:\n        return False\n\n    for i in range(len(numbers)):\n        for j in range(i + 1, len(numbers)):\n            if abs(numbers[i] - numbers[j]) < threshold:\n                return True\n    return False"}
{"task_id": "HumanEval/8", "solution": "def sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    sum_val = 0\n    product_val = 1\n    for number in numbers:\n        sum_val += number\n        product_val *= number\n    return (sum_val, product_val)"}
{"task_id": "HumanEval/9", "solution": "def rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    current_max = float('-inf') # Initialize with negative infinity to correctly handle the first element\n\n    for number in numbers:\n        current_max = max(current_max, number)\n        result.append(current_max)\n\n    return result"}
{"task_id": "HumanEval/12", "solution": "def longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_str: Optional[str] = None\n    max_length: int = -1\n\n    for s in strings:\n        if len(s) > max_length:\n            max_length = len(s)\n            longest_str = s\n    return longest_str"}
{"task_id": "HumanEval/10", "solution": "def make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    # Iterate from the full string down to an empty string to find the longest palindromic postfix.\n    for i in range(len(string), -1, -1):\n        postfix = string[i:]\n        if is_palindrome(postfix):\n            # Once the longest palindromic postfix is found, take the prefix before it.\n            prefix_to_reverse = string[:i]\n            # Append the reversed prefix to the original string to form the shortest palindrome.\n            return string + prefix_to_reverse[::-1]"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n\n    def _validate_binary_string(s: str, param_name: str):\n        \"\"\"Raises ValueError if string s contains characters other than '0' or '1'.\"\"\"\n        if not all(char in ('0', '1') for char in s):\n            raise ValueError(f\"String '{param_name}' must contain only '0' or '1' characters\")\n\n    def _perform_char_xor(char_a: str, char_b: str) -> str:\n        \"\"\"Performs XOR on two single binary characters.\"\"\"\n        return '0' if char_a == char_b else '1'\n\n    _validate_binary_string(a, 'a')\n    _validate_binary_string(b, 'b')\n\n    if len(a) != len(b):\n        raise ValueError(\"Input strings must be of equal length\")\n\n    result_chars = []\n    for i in range(len(a)):\n        result_chars.append(_perform_char_xor(a[i], b[i]))\n\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/14", "solution": "def all_prefixes(string: str) -> List[str]:\n    \"\"\" Return list of all prefixes from shortest to longest of the input string\n    >>> all_prefixes('abc')\n    ['a', 'ab', 'abc']\n    \"\"\"\n    prefixes = []\n    for i in range(1, len(string) + 1):\n        prefixes.append(string[:i])\n    return prefixes"}
{"task_id": "HumanEval/15", "solution": "def string_sequence(n: int) -> str:\n    \"\"\" Return a string containing space-delimited numbers starting from 0 upto n inclusive.\n    >>> string_sequence(0)\n    '0'\n    >>> string_sequence(5)\n    '0 1 2 3 4 5'\n    \"\"\"\n    if n == 0:\n        return '0'\n    \n    # Generate numbers from 0 to n, convert them to strings, and join with spaces.\n    return ' '.join(str(i) for i in range(n + 1))"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    a = abs(a)\n    b = abs(b)\n    while b:\n        a, b = b, a % b\n    return a"}
{"task_id": "HumanEval/16", "solution": "def count_distinct_characters(string: str) -> int:\n    \"\"\" Given a string, find out how many distinct characters (regardless of case) does it consist of\n    \"\"\"\n    if not string:\n        return 0\n\n    distinct_chars = set()\n    for char in string:\n        distinct_chars.add(char.lower())\n\n    return len(distinct_chars)"}
{"task_id": "HumanEval/17", "solution": "def parse_music(music_string: str) -> List[int]:\n    \"\"\" Parses a musical string into a list of beat durations. \"\"\"\n    NOTE_MAP = {\n        'o': 4,\n        'o|': 2,\n        '.|': 1\n    }\n\n    notes = music_string.split()\n    beat_durations = [NOTE_MAP[note] for note in notes]\n    return beat_durations"}
