{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    Please write a function to efficiently compute the n-th element of the fib4 number sequence.  Do not use recursion.\n    >>> fib4(5)\n    4\n    >>> fib4(6)\n    8\n    >>> fib4(7)\n    14\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 0\n    else:\n        # Initialize the first four values corresponding to fib4(0), fib4(1), fib4(2), fib4(3)\n        # a = fib4(i-4), b = fib4(i-3), c = fib4(i-2), d = fib4(i-1)\n        a, b, c, d = 0, 0, 2, 0\n\n        # Iteratively calculate fib4(i) for i from 4 up to n\n        for _ in range(4, n + 1):\n            next_fib = a + b + c + d\n            a = b\n            b = c\n            c = d\n            d = next_fib\n        return d"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    sorted_list = sorted(l)\n    n = len(sorted_list)\n\n    if n % 2 == 1:\n        result = sorted_list[n // 2]\n        # If the median is an integer value (e.g., 3.0), return as int.\n        if isinstance(result, float) and result.is_integer():\n            return int(result)\n        return result\n    else:\n        # For even lists, the median is the average of the two middle elements, returned as a float.\n        mid1 = sorted_list[n // 2 - 1]\n        mid2 = sorted_list[n // 2]\n        return (mid1 + mid2) / 2.0"}
{"task_id": "HumanEval/50", "solution": "def decode_shift(s: str):\n    \"\"\"\n    takes as input string encoded with encode_shift function. Returns decoded string.\n    \"\"\"\n    decoded_chars = []\n    for ch in s:\n        if 'a' <= ch <= 'z':\n            # Reverse the 5-position shift, adding 26 before modulo to handle negative results correctly.\n            shifted_ch = chr(((ord(ch) - ord('a') - 5 + 26) % 26) + ord('a'))\n            decoded_chars.append(shifted_ch)\n        else:\n            # Non-alphabetic characters are passed through unchanged.\n            decoded_chars.append(ch)\n    return \"\".join(decoded_chars)"}
