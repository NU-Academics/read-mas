ectly\n            result_chars.append(text[i])\n            i += 1\n        else:\n            # If a space, count consecutive spaces\n            space_count = 0\n            while i < n and text[i] == ' ':\n                space_count += 1\n                i += 1\n\n            # Apply replacement rules based on the count\n            if space_count <= 2:\n                # 1 or 2 spaces become 1 or 2 underscores\n                for _ in range(space_count):\n                    result_chars.append('_')\n            else:\n                # More than 2 consecutive spaces become a single dash\n                result_chars.append('-')\n\n    return \"\".join(result_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/141": [{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions \n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n    - The file's name contains exactly one dot '.'\n    - The substring before the dot should not be empty, and it starts with a letter from \n    the latin alphapet ('a'-'z' and 'A'-'Z').\n    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    \"\"\"\n\n    def count_digits(text):\n        \"\"\"Counts numeric digits (0-9) in the given string.\"\"\"\n        return sum(1 for char in text if '0' <= char <= '9')\n\n    def validate_digit_count(f_name):\n        \"\"\"Checks if the file name contains no more than three digits.\"\"\"\n        return count_digits(f_name) <= 3\n\n    def validate_dot_count(f_name):\n        \"\"\"Checks if the file name contains exactly one dot.\"\"\"\n        return f_name.count('.') == 1\n\n    def extract_prefix(f_name):\n        \"\"\"Extracts the substring before the first dot.\"\"\"\n        # This function assumes a dot exists as per validation flow\n        return f_name.split('.', 1)[0]\n\n    def extract_extension(f_name):\n        \"\"\"Extracts the substring after the last dot.\"\"\"\n        # This function assumes a dot exists as per validation flow\n        return f_name.split('.')[-1]\n\n    def validate_prefix(prefix_str):\n        \"\"\"Checks if the prefix is non-empty and starts with a letter.\"\"\"\n        if not prefix_str:\n            return False\n        return prefix_str[0].isalpha()\n\n    def validate_extension(ext_str):\n        \"\"\"Checks if the extension is one of the allowed types.\"\"\"\n        allowed_extensions = ['txt', 'exe', 'dll']\n        return ext_str in allowed_extensions\n\n    # Apply validation rules in order, returning 'No' on first failure (fail-fast)\n\n    # Condition 1: There should not be more than three digits ('0'-'9') in the file's name.\n    if not validate_digit_count(file_name):\n        return 'No'\n\n    # Condition 2: The file's name contains exactly one dot '.'\n    if not validate_dot_count(file_name):\n        return 'No'\n\n    # If we reach here, we are guaranteed to have exactly one dot.\n    prefix = extract_prefix(file_name)\n    extension = extract_extension(file_name)\n\n    # Condition 3: The substring before the dot should not be empty, and it starts with a letter.\n    if not validate_prefix(prefix):\n        return 'No'\n\n    # Condition 4: The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    if not validate_extension(extension):\n        return 'No'\n\n    # If all conditions are met\n    return 'Yes'", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/144": [{"task_id": "HumanEval/144", "solution": "class Fraction:\n    \"\"\"Represents a fraction with a numerator and a denominator, providing arithmetic operations.