rn found_coordinates", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/86": [{"task_id": "HumanEval/86", "solution": "import string\ndef _sort_word_characters(word: str) -> str:\n    \"\"\"Sorts characters within a word, putting non-alphabetic characters first (in original order),\n    followed by alphabetic characters sorted by ASCII value.\n    \"\"\"\n    letters = []\n    non_letters = []\n    for char in word:\n        if char.isalpha():\n            letters.append(char)\n        else:\n            non_letters.append(char)\n    \n    letters.sort()\n    \n    return \"\".join(non_letters) + \"\".join(letters)\ndef _get_space_positions(s: str) -> list[int]:\n    \"\"\"Tracks and returns the indices of space characters in the original string.\"\"\"\n    positions = []\n    for i, char in enumerate(s):\n        if char == ' ':\n            positions.append(i)\n    return positions\ndef _split_into_words(s: str) -> list[str]:\n    \"\"\"Splits the input string into a list of words, discarding empty strings from multiple spaces.\"\"\"\n    return s.split()\ndef _concatenate_words(processed_words: list[str], space_positions: list[int], original_length: int) -> str:\n    \"\"\"Reconstructs the final string using processed words and original space positions.\"\"\"\n    result_chars = [''] * original_length\n    \n    for pos in space_positions:\n        result_chars[pos] = ' '\n            \n    word_idx = 0\n    char_in_word_idx = 0\n    \n    for i in range(original_length):\n        if result_chars[i] == ' ':\n            continue\n        \n        if word_idx < len(processed_words):\n            current_word = processed_words[word_idx]\n            \n            # Advance to the next word if the current one is exhausted\n            while char_in_word_idx >= len(current_word) and word_idx + 1 < len(processed_words):\n                word_idx += 1\n                char_in_word_idx = 0\n                current_word = processed_words[word_idx]\n            \n            # Place character from the current word\n            if char_in_word_idx < len(current_word):\n                result_chars[i] = current_word[char_in_word_idx]\n                char_in_word_idx += 1\n    \n    return \"\".join(result_chars)\ndef anti_shuffle(s):\n    \"\"\"\n    Write a function that takes a string and returns an ordered version of it.\n    Ordered version of string, is a string where all words (separated by space)\n    are replaced by a new word where all the characters arranged in\n    ascending order based on ascii value.\n    Note: You should keep the order of words and blank spaces in the sentence.\n\n    For example:\n    anti_shuffle('Hi') returns 'Hi'\n    anti_shuffle('hello') returns 'ehllo'\n    anti_shuffle('Hello World!!!') returns 'Hello !!!Wdlor'\n    \"\"\"\n    if not s:\n        return \"\"\n\n    original_length = len(s)\n    \n    # 1. Preserve spacing positions\n    space_positions = _get_space_positions(s)\n    \n    # 2. Split string into actual words\n    words_to_process = _split_into_words(s)\n    \n    # 3. Sort characters within each word\n    processed_words = [_sort_word_characters(word) for word in words_to_process]\n    \n    # 4. Reconstruct the string with sorted words and original spacing\n    final_string = _concatenate_words(processed_words, space_positions, original_length)\n    \n    return final_string", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["\n\n123 456\n789\n"]]}], "HumanEval/90": [{"task_id": "HumanEval/90", "solution": "def next_smallest(lst):\n    \"\"\"\n    You are given a list of integers.\n    Write a function next_smallest() that returns the 2nd smallest element of the list.\n    Return None if there is no such element.\n    \n    next_smallest([1, 2, 3, 4, 5]) == 2\n    next_smallest([5, 1, 4, 3, 2]) == 2\n    next_smallest([]) == None\n    next_smallest([1, 1]) == None\n    \"\"\"\n\n   