urn True\n\n    n = len(arr)\n    descent_count = 0\n    descent_index = -1\n\n    # Find the number of \"descents\" (where arr[i] > arr[i+1]).\n    # A sorted-then-rotated array will have at most one such descent.\n    for i in range(n - 1):\n        if arr[i] > arr[i+1]:\n            descent_count += 1\n            descent_index = i\n            if descent_count > 1:\n                return False # More than one descent means it's not a single rotation of a sorted array.\n\n    # If no descent was found, the array is already sorted.\n    if descent_count == 0:\n        return True\n    \n    # If exactly one descent was found, check if the \"wrapped\" segment is sorted.\n    # This means the last element must be less than or equal to the first element\n    # for the entire circular sequence to be non-decreasing.\n    return arr[n-1] <= arr[0]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/108": [{"task_id": "HumanEval/108", "solution": "def count_nums(arr):\n    \"\"\"\n    Counts elements in an array with a sum of digits > 0,\n    handling negative numbers by treating the first digit as negative.\n    \"\"\"\n    def extract_digits(number):\n        \"\"\"Extracts individual digits from an integer.\"\"\"\n        s = str(abs(number))\n        return [int(d) for d in s]\n\n    def calculate_digit_sum(number):\n        \"\"\"Calculates the signed digit sum for an individual integer.\"\"\"\n        if number == 0:\n            return 0\n        \n        digits = extract_digits(number)\n        \n        if number < 0:\n            # For negative numbers, the first digit is negative\n            return -digits[0] + sum(digits[1:])\n        else:\n            return sum(digits)\n\n    count = 0\n    for num in arr:\n        if calculate_digit_sum(num) > 0:\n            count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/110":