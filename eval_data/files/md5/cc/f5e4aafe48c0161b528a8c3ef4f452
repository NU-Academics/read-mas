eturn False\n\n    # Rule 4: The date should be in the format: mm-dd-yyyy\n    if not is_valid_format(date):\n        return False\n\n    # Extract components assuming valid format\n    month, day, year = parse_date_components(date)\n\n    # Rule 3: The months should not be less than 1 or higher than 12.\n    if not is_valid_month(month):\n        return False\n\n    # Rule 2: Validate the number of days based on the month.\n    if not is_valid_day(day, month):\n        return False\n\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/126": [{"task_id": "HumanEval/126", "solution": "from typing import List, Dict\ndef _count_duplicates(lst: List[int]) -> Dict[int, int]:\n    \"\"\"Count occurrences of each number.\"\"\"\n    counts = {}\n    for num in lst:\n        counts[num] = counts.get(num, 0) + 1\n    return counts\ndef _is_ascending(lst: List[int]) -> bool:\n    \"\"\"Check if list is in ascending order.\"\"\"\n    for i in range(1, len(lst)):\n        if lst[i] < lst[i-1]:\n            return False\n    return True\ndef _has_excessive_duplicates(counts: Dict[int, int]) -> bool:\n    \"\"\"Check if any number appears more than twice.\"\"\"\n    for count in counts.values():\n        if count > 2:\n            return True\n    return False\ndef is_sorted(lst: List[int]) -> bool:\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n    '''\n    if len(lst) <= 1:\n        return True\n\n    counts = _count_duplicates(lst)\n    if _has_excessive_duplicates(counts):\n        return False\n\n    if not _is_ascending(lst):\n        return False\n\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/128": [{"task_id": "HumanEval/128", "solution": "def prod_sign