 def __init__(self, max_cache_size: int = 1024, enable_cache: bool = True, api_key: Optional[str] = None) -> None:\n        \"\"\"Initializes configuration settings.\"\"\"\n        self.max_cache_size = max_cache_size\n        self.enable_cache = enable_cache\n        self.api_key = api_key\n\n    @classmethod\n    def from_env(cls) -> 'Config':\n        \"\"\"Loads configuration from environment variables.\"\"\"\n        max_cache_size_str = os.getenv(\"MODP_MAX_CACHE_SIZE\")\n        enable_cache_str = os.getenv(\"MODP_ENABLE_CACHE\")\n        api_key = os.getenv(\"MODP_API_KEY\")\n\n        max_cache_size = 1024\n        if max_cache_size_str:\n            try:\n                max_cache_size = int(max_cache_size_str)\n                if max_cache_size < 0:\n                    raise ValueError(\"MODP_MAX_CACHE_SIZE must be non-negative.\")\n            except ValueError as e:\n                logger.warning(f\"Invalid MODP_MAX_CACHE_SIZE environment variable: '{max_cache_size_str}'. Using default 1024. Error: {e}\")\n                max_cache_size = 1024 # Revert to default on error\n\n        enable_cache = True\n        if enable_cache_str is not None:\n            enable_cache = enable_cache_str.lower() == \"true\"\n        \n        logger.info(f\"Loaded config: max_cache_size={max_cache_size}, enable_cache={enable_cache}, api_key_set={bool(api_key)}\")\n        return cls(max_cache_size=max_cache_size, enable_cache=enable_cache, api_key=api_key)\n\n```\n```python\n# src/modp_service/exceptions.py\nclass ModPError(Exception):\n    \"\"\"Base exception for modp_service errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\nclass ValidationError(ModPError):\n    \"\"\"Exception for invalid input values.\"\"\"\n    pass\n\nclass CalculationError(ModPError):\n    \"\"\"Exception for issues during calculation.\"\"\"\n    pass\n\n```\n```python\n# src/modp_service/utils.py\nfrom .exceptions import ValidationError\n\nclass ValidationUtils:\n    \"\"\"Provides utility methods for input validation and parsing.\"\"\"\n\n    @staticmethod\n    def validate_n(n: int) -> None:\n        \"\"\"Validates that n is a non-negative integer.\"\"\"\n        if not isinstance(n, int):\n            raise ValidationError(\"Input 'n' must be an integer.\")\n        if n < 0:\n            raise ValidationError(\"Input 'n' must be a non-negative integer.\")\n\n    @staticmethod\n    def validate_p(p: int) -> None:\n        \"\"\"Validates that p is an integer greater than or equal to 2.\"\"\"\n        if not isinstance(p, int):\n            raise ValidationError(\"Input 'p' must be an integer.\")\n        if p < 2:\n            raise ValidationError(\"Input 'p' must be an integer >= 2.\")\n\n    @staticmethod\n    def parse_int(s: str, param_name: str = \"value\") -> int:\n        \"\"\"Parses a string to an integer, raising ValidationError on failure.\"\"\"\n        try:\n            return int(s)\n        except ValueError:\n            raise ValidationError(f\"Parameter '{param_name}' must be a valid integer string.\")\n\n```\n```python\n# src/modp_service/algorithms.py\nfrom .exceptions import CalculationError\n\nclass FastModExpAlgorithm:\n    \"\"\"Implements an efficient modular exponentiation algorithm for base 2.\"\"\"\n\n    def pow2_mod(self, n: int, p: int) -> int:\n        \"\"\"Computes 2^n modulo p using binary exponentiation (repeated squaring).\n        This algorithm has a time complexity of O(log n).\"\"\"\n        # Preconditions: n >= 0 and p >= 2 (expected to be validated upstream).\n\n        result = 1 % p  # Initialize result, ensures 0 <= result < p initially\n        base = 2 % p    # Base for exponentiation, reduced modulo p\n\n        k = n\n        while k > 0:\n            if k & 1:  # If k is odd\n                result = (result * base) % p\n            base = (base * base) % p\n            k >>= 1    # k = k // 2\n\n        return result\n\n```\n```python\n# src/modp_service/calculator.py\nimport logging\nfrom typing import Optional, Any # Any for ValidationUtils as it's a static class\n\nfrom .algorithms import FastModExpAlgorithm\nfrom .repository import CacheRepository\nfrom .utils import ValidationUtils\nfrom .exceptions import ValidationError, CalculationError\n\nlogger = logging.getLogger(__name__)\n\nclass ModPCalculator:\n    \"\"\"Core service for computing 2^n mod p, incorporating validation, caching, and the algorithm.\"\"\"\n\n    def __init__(self, algorithm: FastModExpAlgorithm, cache: Optional[CacheRepository], validator: Any) -> None:\n        \"\"\"Initializes the calculator with an algorithm, an optional cache, and a validator.\"\"\"\n        self._algorithm = algorithm\n        self._cache = cache\n        self._validator = validator # ValidationUtils is a static class, can be passed directly or by instance\n\n    def calculate(self, n: int, p: int) -> int:\n        \"\"\"Validates inputs, checks cache, computes 2^n mod p, and stores result in cache.\"\"\"\n        self._validator.validate_n(n)\n        self._validator.validate_p(p)\n\n        key = (n, p)\n        if self._cache and self._cache._max_size > 0: # Check if cache is enabled and has capacity\n            cached_result = self._cache.get(key)\n            if cached_result is not None:\n                logger.debug(f\"Retrieved {key} from cache.\")\n                return cached_result\n        \n        logger.debug(f\"Calculating 2^{n} mod {p}...\")\n        try:\n            result = self._algorithm.pow2_mod(n, p)\n        except Exception as e:\n            logger.error(f\"Error during calculation for {key}: {e}\", exc_info=True)\n            raise CalculationError(f\"Calculation failed for 2^{n} mod {p}.\") from e\n\n        if self._cache and self._cache._max_size > 0:\n            self._cache.set(key, result)\n            logger.debug(f\"Stored {key} with result {result} in cache.\")\n        \n        return result\n\n```\n```python\n# src/modp_service/repository.py\nfrom collections import deque\nimport logging\nfrom typing import Optional, Tuple\n\nlogger = logging.getLogger(__name__)\n\nclass CacheRepository:\n    \"\"\"An in-memory LRU cache for (n,p) -> result computations.\"\"\"\n\n    def __init__(self, max_size: int) -> None:\n        \"\"\"Initializes the cache with a specified maximum size.\"\"\"\n        if max_size <= 0:\n            logger.warning(f\"Cache max_size '{max_size}' must be positive; disabling cache.\")\n            self._max_size = 0\n        else:\n            self._max_size = max_size\n        self._cache: dict[Tuple[int, int], int] = {}\n        self._order: deque[Tuple[int, int]] = deque() # Stores keys in LRU order\n\n    def get(self, key: Tuple[int, int]) -> Optional[int]:\n        \"\"\"Retrieves a value from the cache and updates its position as most recently used.\"\"\"\n        if self._max_size == 0:\n            return None\n\n        if key in self._cache:\n            self._order.remove(key)  # Remove from current position\n            self._order.append(key)  # Add to the right (MRU end)\n            logger.debug(f\"Cache HIT for key {key}\")\n            return self._cache[key]\n        logger.debug(f\"Cache MISS for key {key}\")\n        return None\n\n    def set(self, key: Tuple[int, int], value: int) -> None:\n        \"\"\"Stores a value in the cache, managing LRU eviction if capacity is reached.\"\"\"\n        if self._max_size == 0:\n            return\n\n        if key in self._cache:\n            self._order.remove(key) # Update existing key to MRU\n        elif len(self._cache) >= self._max_size:\n            lru_key = self._order.popleft() # Evict LRU item\n            del self._cache[lru_key]\n            logger.debug(f\"Cache EVICTED LRU key {lru_key}\")\n            \n        self._cache[key] = value\n        self._order.append(key)\n        logger.debug(f\"Cache SET key {key}\")\n\n    def clear(self) -> None:\n        \"\"\"Clears all entries from the cache.\"\"\"\n        self._cache.clear()\n        self._order.clear()\n        logger.debug(\"Cache CLEARED\")\n\n```\n```python\n# src/modp_service/factory.py\nimport logging\nfrom typing import Any, Dict, Optional\n\nfrom .config import Config\nfrom .exceptions import (\n    ModPError,\n    ValidationError,\n    CalculationError,\n)\nfrom .utils import ValidationUtils\nfrom .algorithms import FastModExpAlgorithm\nfrom .repository import CacheRepository\nfrom .calculator import ModPCalculator\nfrom .cli import CLIController\nfrom .http_server import HTTPController\nfrom .logging_config import configure_logging\n\nlogger = logging.getLogger(__name__)\n\nclass AppFactory:\n    \"\"\"Responsible for building and wiring all application components based on configuration.\"\"\"\n\n    @staticmethod\n    def build(config: Config) -> Dict[str, Any]:\n        \"\"\"Constructs all application components and wires their dependencies.\"\"\"\n        configure_logging() # Ensure logging is configured early\n\n        algorithm = FastModExpAlgorithm()\n        \n        cache: Optional[CacheRepository] = None\n        if config.enable_cache and config.max_cache_size > 0:\n            cache = CacheRepository(max_size=config.max_cache_size)\n            logger.info(f\"Cache enabled with max_size: {config.max_cache_size}\")\n        else:\n            logger.info(\"Cache disabled by configuration or max_cache_size is zero.\")\n\n        validator = ValidationUtils # ValidationUtils is a static class\n\n        calculator = ModPCalculator(algorithm=algorithm, cache=cache, validator=validator)\n        \n        cli_controller = CLIController(calculator=calculator)\n        http_controller = HTTPController(calculator=calculator, config=config)\n\n        logger.info(\"Application components built successfully.\")\n        return {\n            \"config\": config,\n            \"algorithm\": algorithm,\n            \"cache\": cache,\n            \"validator\": validator,\n            \"calculator\": calculator,\n            \"cli\": cli_controller,\n            \"http\": http_controller,\n        }\n\n```\n```python\n# src/modp_service/cli.py\nimport argparse\nimport sys\nimport logging\n\nfrom .calculator import ModPCalculator\nfrom .utils import ValidationUtils # For parse_int\nfrom .exceptions import ValidationError, ModPError\n\nlogger = logging.getLogger(__name__)\n\nclass CLIController:\n    \"\"\"Handles command-line interface interactions for the modp service.\"\"\"\n\n    def __init__(self, calculator: ModPCalculator) -> None:\n        \"\"\"Initializes the CLI controller with a ModPCalculator instance.\"\"\"\n        self._calculator = calculator\n\n    def run(self, argv: list[str]) -> int:\n        \"\"\"Parses CLI arguments, performs the calculation, and prints the result.\"\"\"\n        parser = argparse.ArgumentParser(\n            prog=\"modp\",\n            description=\"Compute 2^n modulo p for integers n and p.\"\n        )\n        parser.add_argument(\"--n\", type=str, required=True, help=\"The exponent n (integer string).\")\n        parser.add_argument(\"--p\", type=str, required=True, help=\"The modulus p (integer string, p >= 2).\")\n\n        try:\n            args = parser.parse_args(argv[1:]) # Skip script name\n            \n            # Use ValidationUtils for parsing as specified\n            n = ValidationUtils.parse_int(args.n, param_name=\"n\")\n            p = ValidationUtils.parse_int(args.p, param_name=\"p\")\n\n            result = self._calculator.calculate(n, p)\n            print(result)\n            return 0\n        except ValidationError as ex:\n            logger.error(f\"Validation error: {ex.message}\")\n            print(f\"Error: {ex.message}\", file=sys.stderr)\n            return 2 # Exit code for validation errors\n        except ModPError as ex: # Catch CalculationError too, as it inherits from ModPError\n            logger.error(f\"Application error: {ex.message}\")\n            print(f\"Error: {ex.message}\", file=sys.stderr)\n            return 1 # Generic application error\n        except Exception as ex:\n            logger.exception(\"An unexpected error occurred during CLI execution.\")\n            print(f\"An unexpected error occurred: {ex}\", file=sys.stderr)\n            return 1 # Unexpected errors\n\n```\n```python\n# src/modp_service/http_server.py\nimport logging\nfrom typing import Optional\n\nfrom fastapi import FastAPI, HTTPException, Query, Header, status\nfrom fastapi.responses import JSONResponse\n\nfrom .calculator import ModPCalculator\nfrom .config import Config\nfrom .exceptions import ValidationError, ModPError\nfrom .factory import AppFactory # Needed to access the factory for global app setup\nfrom .logging_config import configure_logging # Ensure logging is configured\n\nlogger = logging.getLogger(__name__)\n\n# Global setup: configure logging and build components for the Uvicorn-loadable app instance.\nconfigure_logging(\"INFO\")\n_config = Config.from_env()\n_app_components = AppFactory.build(_config)\n_http_controller_instance = _app_components[\"http\"]\n\n# Expose the FastAPI app instance directly for uvicorn to load.\n# Uvicorn will target `modp_service.http_server:app`.\napp = _http_controller_instance.app\n\nclass HTTPController:\n    \"\"\"Exposes an HTTP REST API for the modp service using FastAPI.\"\"\"\n\n    def __init__(self, calculator: ModPCalculator, config: Config) -> None:\n        \"\"\"Initializes the HTTP controller with a calculator and configuration.\"\"\"\n        self._calculator = calculator\n        self._config = config\n        self.app = FastAPI(\n            title=\"ModP Service\",\n            description=\"API to compute 2^n mod p\",\n            version=\"1.0.0\"\n        )\n        self._register_routes()\n\n    def _register_routes(self) -> None:\n        \"\"\"Registers the API endpoints within the FastAPI app.\"\"\"\n        @self.app.get(\"/modp\", summary=\"Compute 2^n mod p\")\n        async def get_modp(\n            n: int = Query(..., description=\"The exponent n (non-negative integer).\"),\n            p: int = Query(..., description=\"The modulus p (integer, p >= 2).\"),\n            x_api_key: Optional[str] = Header(None, alias=\"X-API-Key\", description=\"Optional API Key for authentication.\")\n        ) -> JSONResponse:\n            \"\"\"\n            Calculates 2^n modulo p.\n            Requires 'n' and 'p' as integer query parameters.\n            \"\"\"\n            logger.info(f\"Received GET /modp?n={n}&p={p}\")\n\n            if self._config.api_key:\n                if not x_api_key or x_api_key != self._config.api_key:\n                    logger.warning(\"Unauthorized access attempt to /modp.\")\n                    raise HTTPException(\n                        status_code=status.HTTP_401_UNAUTHORIZED,\n                        detail={\"error\": \"Unauthorized\", \"message\": \"Missing or invalid API key\"}\n                    )\n\n            try:\n                result = self._calculator.calculate(n, p)\n                logger.info(f\"Successfully computed 2^{n} mod {p} = {result}\")\n                return JSONResponse(content={\"result\": result}, status_code=status.HTTP_200_OK)\n            except ValidationError as e:\n                logger.warning(f\"Validation error for /modp?n={n}&p={p}: {e.message}\")\n                raise HTTPException(\n                    status_code=status.HTTP_400_BAD_REQUEST,\n                    detail={\"error\": \"ValidationError\", \"message\": e.message}\n                )\n            except ModPError as e: # Catches CalculationError as well\n                logger.error(f\"Calculation error for /modp?n={n}&p={p}: {e.message}\", exc_info=True)\n                raise HTTPException(\n                    status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,\n                    detail={\"error\": e.__class__.__name__, \"message\": e.message}\n                )\n            except Exception as e:\n                logger.exception(f\"Unexpected error for /modp?n={n}&p={p}\")\n                raise HTTPException(\n                    status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,\n                    detail={\"error\": \"InternalServerError\", \"message\": \"An unexpected error occurred.\"}\n                )\n            \n        @self.app.get(\"/health\", status_code=status.HTTP_200_OK, summary=\"Service health check\")\n        async def health_check() -> JSONResponse:\n            \"\"\"Checks the operational status of the service.\"\"\"\n            return JSONResponse(content={\"status\": \"ok\", \"message\": \"Service is healthy\"}, status_code=status.HTTP_200_OK)\n\n```\n```python\n# src/modp_service/logging_config.py\nimport logging\nimport sys\n\ndef configure_logging(level: str = \"INFO\") -> None:\n    \"\"\"Configures global logging for the application.\n    Sets up a basic console handler.\"\"\"\n    logging.basicConfig(\n        level=getattr(logging, level.upper(), logging.INFO),\n        format='%(asctime)s - %(name)s - %(levelname)s - %(message)s',\n        handlers=[logging.StreamHandler(sys.stdout)]\n    )\n\n```\n```toml\n# pyproject.toml\n[project]\nname = \"modp-service\"\nversion = \"0.1.0\"\ndescription = \"A service to compute 2^n modulo p\"\nauthors = [\n    { name = \"Your Name\", email = \"your.email@example.com\" }\n]\ndependencies = [\n    \"fastapi>=0.104.1\",\n    \"uvicorn[standard]>=0.23.2\",\n]\nrequires-python = \">=3.10\"\nreadme = \"README.md\"\nlicense = { text = \"MIT\" } # Example license\n\n[project.scripts]\nmodp = \"modp_service.__main__:main\"\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n```\n```text\n# requirements.txt\nfastapi>=0.104.1\nuvicorn[standard]>=0.23.2\npytest>=7.0.0\n```\n```markdown\n# ModP Service\n\nA Python service to compute `2^n mod p` efficiently, exposed via both a Command Line Interface (CLI) and an HTTP REST API.\n\n## Features\n\n-   **Efficient Computation**: Uses binary exponentiation (repeated squaring) for `O(log n)` performance.\n-   **Input Validation**: Robust validation for `n` (non-negative integer) and `p` (integer >= 2).\n-   **Caching**: In-memory LRU cache for recent computations to improve performance on repeated queries.\n-   **CLI Interface**: Easy-to-use command-line tool.\n-   **HTTP API**: RESTful API built with FastAPI, supporting JSON responses and optional API key authentication.\n-   **Configurable**: Settings loaded from environment variables (cache size, cache enablement, API key).\n-   **Testable Design**: Modular architecture favoring unit and integration testing.\n\n## Installation\n\n1.  **Clone the repository:**\n    ```bash\n    git clone https://github.com/your-repo/modp-service.git\n    cd modp-service\n    ```\n\n2.  **Create and activate a virtual environment:**\n    ```bash\n    python -m venv venv\n    source venv/bin/activate # On Windows: `venv\\Scripts\\activate`\n    ```\n\n3.  **Install dependencies:**\n    ```bash\n    pip install -r requirements.txt\n    # Or, if you prefer pyproject.toml for installation:\n    # pip install .\n    ```\n\n## Usage\n\n### 1. Command Line Interface (CLI)\n\nUse the `modp` command (installed as a console script) or run directly via `python -m modp_service`.\n\n```bash\n# Using the installed console script\nmodp --n 10 --p 3\n# Expected output: 1\n\n# Using python -m\npython -m modp_service --n 1101 --p 101\n# Expected output: 2\n\n# Invalid input example\nmodp --n -5 --p 10\n# Expected output to stderr: Error: Input 'n' must be a non-negative integer. (exit code 2)\n```\n\n### 2. HTTP REST API\n\nThe HTTP API runs using Uvicorn.\n\n1.  **Start the HTTP server:**\n\n    ```bash\n    # Ensure you are in the virtual environment and installed dependencies\n    # This command targets the 'app' variable exposed by modp_service.http_server\n    uvicorn modp_service.http_server:app --host 0.0.0.0 --port 8000\n    ```\n\n    The server will start, typically logging output to the console.\n\n2.  **Access the API:**\n\n    Open your browser or use a tool like `curl` or Postman.\n\n    -   **API documentation (Swagger UI)**: `http://localhost:8000/docs`\n    -   **Compute 2^n mod p**:\n        ```bash\n        curl \"http://localhost:8000/modp?n=3&p=5\"\n        # Expected output: {\"result\":3}\n        ```\n        ```bash\n        curl \"http://localhost:8000/modp?n=1101&p=101\"\n        # Expected output: {\"result\":2}\n        ```\n    -   **Health check**:\n        ```bash\n        curl http://localhost:8000/health\n        # Expected output: {\"status\":\"ok\",\"message\":\"Service is healthy\"}\n        ```\n\n3.  **Using API Key (if configured):**\n\n    If you set the `MODP_API_KEY` environment variable (e.g., `export MODP_API_KEY=mysecretkey`), you must include the `X-API-Key` header in your requests:\n\n    ```bash\n    curl -H \"X-API-Key: mysecretkey\" \"http://localhost:8000/modp?n=10&p=3\"\n    ```\n    Without the correct API key, you will receive a 401 Unauthorized error.\n\n## Configuration\n\nThe service can be configured using environment variables:\n\n-   `MODP_MAX_CACHE_SIZE`: Maximum number of items in the in-memory LRU cache (default: 1024). Set to `0` to disable caching.\n-   `MODP_ENABLE_CACHE`: `true` or `false` to enable or disable the cache (default: `true`).\n-   `MODP_API_KEY`: An optional string that enables API key authentication for HTTP endpoints. If set, requests must include `X-API-Key` header matching this value.\n\n**Example (for CLI or HTTP server):**\n\n```bash\nexport MODP_MAX_CACHE_SIZE=500\nexport MODP_ENABLE_CACHE=false\nexport MODP_API_KEY=my_secure_api_key\nuvicorn modp_service.http_server:app --host 0.0.0.0 --port 8000\n```\n```"}
