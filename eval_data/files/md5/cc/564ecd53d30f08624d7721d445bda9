nimport sys\n\ndef configure_logger(name: str = \"happystring\", level: str = \"INFO\") -> logging.Logger:\n    \"\"\"\n    Configures a logger with a structured format and returns the instance.\n    Logs to stdout with INFO level by default.\n    \"\"\"\n    logger = logging.getLogger(name)\n    logger.setLevel(level.upper())\n\n    # Avoid adding multiple handlers if logger is already configured\n    if not logger.handlers:\n        handler = logging.StreamHandler(sys.stdout)\n        formatter = logging.Formatter(\n            '{\"timestamp\": \"%(asctime)s\", \"level\": \"%(levelname)s\", \"name\": \"%(name)s\", \"message\": \"%(message)s\"}'\n        )\n        handler.setFormatter(formatter)\n        logger.addHandler(handler)\n    return logger\n```\n\n```python\n# src/happystring_app/HappyStringModel.py\n\"\"\"Data model for a HappyString check result.\"\"\"\n\nfrom datetime import datetime\nfrom typing import Any, Dict\nimport uuid\n\nclass HappyStringModel:\n    \"\"\"Represents a stored result of a happy string check.\"\"\"\n\n    def __init__(self, id: str, s: str, is_happy: bool, checked_at: datetime):\n        self.id = id\n        self.s = s\n        self.is_happy = is_happy\n        self.checked_at = checked_at\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Converts the model to a dictionary for serialization.\"\"\"\n        return {\n            \"id\": self.id,\n            \"s\": self.s,\n            \"is_happy\": self.is_happy,\n            \"checked_at\": self.checked_at.isoformat(timespec='milliseconds') + \"Z\",\n        }\n\n    @classmethod\n    def from_dict(cls, d: Dict[str, Any]) -> \"HappyStringModel\":\n        \"\"\"Creates a HappyStringModel instance from a dictionary.\"\"\"\n        checked_at_str = d[\"checked_at\"]\n        # Handle 'Z' for UTC by stripping and assuming UTC\n        if checked_at_str.endswith(\"Z\"):\n            checked_at_str = checked_at_str[:-1] + \"+00:00\"\n        return cls(\n            id=d[\"id\"],\n            s=d[\"s\"],\n            is_happy=d[\"is_happy\"],\n            checked_at=datetime.fromisoformat(checked_at_str),\n        )\n```\n\n```python\n# src/happystring_app/Validator.py\n\"\"\"Input validation logic for the HappyString application.\"\"\"\n\nfrom .Exceptions import ValidationError\n\nclass Validator:\n    \"\"\"Utility class for validating input strings.\"\"\"\n\n    @staticmethod\n    def validate_input(s: str) -> None:\n        \"\"\"\n        Validates the input string for happiness checks.\n        Raises ValidationError if the input is invalid.\n        \"\"\"\n        if s is None or not isinstance(s, str):\n            raise ValidationError(\"Input must be a string.\")\n        if len(s) == 0:\n            raise ValidationError(\"Input cannot be empty.\")\n```\n\n```python\n# src/happystring_app/ResultRepository.py\n\"\"\"Repository interface and file-based implementation for HappyString results.\"\"\"\n\nimport json\nimport os\nimport threading\nfrom abc import ABC, abstractmethod\nfrom typing import List, Optional\n\nfrom .HappyStringModel import HappyStringModel\nfrom .Exceptions import RepositoryError\n\nclass ResultRepository(ABC):\n    \"\"\"Abstract base class defining the interface for storing and retrieving HappyStringModels.\"\"\"\n\n    @abstractmethod\n    def save(self, model: HappyStringModel) -> str:\n        \"\"\"Saves a HappyStringModel and returns its ID.\"\"\"\n        pass\n\n    @abstractmethod\n    def get(self, id: str) -> Optional[HappyStringModel]:\n        \"\"\"Retrieves a HappyStringModel by its ID.\"\"\"\n        pass\n\n    @abstractmethod\n    def list(self, limit: int) -> List[HappyStringModel]:\n        \"\"\"Lists recent HappyStringModels, up to a specified limit, sorted by timestamp desc.\"\"\"\n        pass\n\nclass FileResultRepository(ResultRepository):\n    \"\"\"File-based implementation of ResultRepository using NDJSON.\"\"\"\n\n    ENCODING: str = \"utf-8\"\n\n    def __init__(self, path: str):\n        \"\"\"Initializes the repository with a file path.\"\"\"\n        self._path = path\n        self._lock = threading.Lock() # Protects file operations in multi-threaded environments\n\n    def save(self, model: HappyStringModel) -> str:\n        \"\"\"Appends a HappyStringModel to the NDJSON file.\"\"\"\n        line = json.dumps(model.to_dict(), ensure_ascii=False)\n        try:\n            with self._lock:\n                with open(self._path, \"a\", encoding=self.ENCODING) as fh:\n                    fh.write(line + \"\\n\")\n            return model.id\n        except OSError as e:\n            raise RepositoryError(f\"Failed to save result to file: {e}\")\n\n    def get(self, id: str) -> Optional[HappyStringModel]:\n        \"\"\"Scans the file for a specific HappyStringModel by ID.\"\"\"\n        try:\n            with self._lock:\n                if not os.path.exists(self._path):\n                    return None\n                with open(self._path, \"r\", encoding=self.ENCODING) as fh:\n                    for line in fh:\n                        if line.strip():\n                            data = json.loads(line)\n                            if data.get(\"id\") == id:\n                                return HappyStringModel.from_dict(data)\n            return None\n        except (OSError, json.JSONDecodeError) as e:\n            raise RepositoryError(f\"Failed to get result from file: {e}\")\n\n    def list(self, limit: int) -> List[HappyStringModel]:\n        \"\"\"Reads the last 'limit' HappyStringModels from the file, sorted by timestamp desc.\"\"\"\n        entries: List[HappyStringModel] = []\n        try:\n            with self._lock:\n                if not os.path.exists(self._path):\n                    return []\n                with open(self._path, \"r\", encoding=self.ENCODING) as fh:\n                    # Read all lines and keep only the last 'limit' relevant ones.\n                    # This is efficient enough for DEFAULT_HISTORY_LIMIT=1000.\n                    lines = fh.readlines()\n                    for line in lines[-limit:]:\n                        if line.strip():\n                            data = json.loads(line)\n                            entries.append(HappyStringModel.from_dict(data))\n            # The models are read in file order (oldest to newest in the slice).\n            # The requirement is \"sorted by timestamp desc\". So, reverse them.\n            return list(reversed(entries))\n        except (OSError, json.JSONDecodeError) as e:\n            raise RepositoryError(f\"Failed to list history: {e}\")\n```\n\n```python\n# src/happystring_app/HappinessService.py\n\"\"\"Core business logic for determining string happiness and managing check history.\"\"\"\n\nfrom datetime import datetime\nimport uuid\nimport logging\n\nfrom .HappyStringModel import HappyStringModel\nfrom .Exceptions import RepositoryError\nfrom .ResultRepository import ResultRepository # Import the interface\n\nclass HappinessService:\n    \"\"\"Handles the happiness algorithm and orchestration of results persistence.\"\"\"\n\n    def __init__(self, repository: ResultRepository, logger: logging.Logger):\n        \"\"\"Initializes the service with a repository and logger.\"\"\"\n        self._repository = repository\n        self._logger = logger\n\n    def is_happy(self, s: str) -> bool:\n        \"\"\"\n        Determines if a string is \"happy\" according to business rules.\n        Assumes 's' is a non-empty string.\n        \"\"\"\n        if len(s) < 3:\n            return False\n        for i in range(len(s) - 2):\n            a, b, c = s[i], s[i+1], s[i+2]\n            if a == b or a == c or b == c:\n                return False\n        return True\n\n    def check_and_record(self, s: str) -> HappyStringModel:\n        \"\"\"\n        Evaluates string happiness, records the result, and returns the model.\n        Handles persistence errors by logging and re-raising RepositoryError.\n        \"\"\"\n        result = self.is_happy(s)\n        model = HappyStringModel(id=uuid.uuid4().hex, s=s, is_happy=result, checked_at=datetime.utcnow())\n        try:\n            self._repository.save(model)\n        except Exception as e:\n            self._logger.exception(\"Failed to persist result for string '%s'\", s)\n            raise RepositoryError(f\"Failed to persist check result: {e}\")\n        return model\n\n    def get_history(self, limit: int) -> List[HappyStringModel]:\n        \"\"\"\n        Retrieves a list of recent happy string check results.\n        Delegates to the configured repository.\n        \"\"\"\n        try:\n            return self._repository.list(limit)\n        except Exception as e:\n            self._logger.exception(\"Failed to retrieve history\")\n            raise RepositoryError(f\"Failed to retrieve history: {e}\")\n```\n\n```python\n# src/happystring_app/AppFactory.py\n\"\"\"Factory for constructing the HappyString application components.\"\"\"\n\nimport logging\nfrom typing import Optional\n\nfrom .Config import Config\nfrom .LoggerUtil import configure_logger\nfrom .Exceptions import RepositoryError\nfrom .ResultRepository import FileResultRepository, ResultRepository\nfrom .HappinessService import HappinessService\n\nclass App:\n    \"\"\"Holds the core components of the application.\"\"\"\n    def __init__(self, service: HappinessService, repository: ResultRepository, logger: logging.Logger):\n        self.service = service\n        self.repository = repository\n        self.logger = logger\n\ndef build_app(\n    repo_path: Optional[str] = None,\n    log_level: str = \"INFO\"\n) -> App:\n    \"\"\"\n    Constructs and wires together the application's dependencies.\n    \"\"\"\n    logger = configure_logger(level=log_level)\n    \n    actual_repo_path = repo_path if repo_path is not None else Config.DEFAULT_HISTORY_PATH\n    \n    try:\n        repository = FileResultRepository(path=actual_repo_path)\n    except Exception as e:\n        logger.critical(\"Failed to initialize repository at path '%s': %s\", actual_repo_path, e)\n        raise RepositoryError(f\"Failed to initialize repository: {e}\")\n\n    service = HappinessService(repository=repository, logger=logger)\n    \n    logger.info(\"Application components initialized successfully.\")\n    return App(service=service, repository=repository, logger=logger)\n```\n\n```python\n# src/happystring_app/APIController.py\n\"\"\"FastAPI controller for the HappyString HTTP API.\"\"\"\n\nfrom typing import List, Optional\nimport logging\n\nfrom fastapi import FastAPI, HTTPException, Header, Depends, status\nfrom pydantic import BaseModel\n\nfrom .HappinessService import HappinessService\nfrom .HappyStringModel import HappyStringModel\nfrom .Validator import Validator\nfrom .Exceptions import ValidationError, RepositoryError\nfrom .Config import Config # For default history limit\n\nclass CheckRequest(BaseModel):\n    \"\"\"Request model for checking string happiness.\"\"\"\n    s: str\n\ndef create_api_app(service: HappinessService, api_token: Optional[str] = None) -> FastAPI:\n    \"\"\"\n    Creates and configures the FastAPI application.\n    \"\"\"\n    app = FastAPI(\n        title=\"Happy String API\",\n        description=\"API to determine if a string is 'happy' and view history.\",\n        version=\"0.1.0\"\n    )\n    logger = logging.getLogger(\"happystring\") # Use the configured logger\n\n    def verify_api_token(authorization: str = Header(None)):\n        \"\"\"Dependency to verify the API token if configured.\"\"\"\n        if api_token:\n            if not authorization or not authorization.startswith(\"Bearer \"):\n                raise HTTPException(\n                    status_code=status.HTTP_401_UNAUTHORIZED,\n                    detail=\"Missing or invalid Authorization header\"\n                )\n            token = authorization.split(\" \")[1]\n            if token != api_token:\n                raise HTTPException(\n                    status_code=status.HTTP_401_UNAUTHORIZED,\n                    detail=\"Invalid API token\"\n                )\n        return True\n\n    @app.post(\"/check\", response_model=HappyStringModel)\n    async def check(req: CheckRequest, authorized: bool = Depends(verify_api_token)):\n        \"\"\"\n        Checks if a string is happy and records the result.\n        Returns the check result, including its happiness status and a timestamp.\n        \"\"\"\n        try:\n            Validator.validate_input(req.s)\n            model = service.check_and_record(req.s)\n            logger.info(\"Checked string '%s', is_happy: %s, id: %s\", req.s, model.is_happy, model.id)\n            return model\n        except ValidationError as e:\n            logger.warning(\"Validation error for string '%s': %s\", req.s, e)\n            raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=str(e))\n        except RepositoryError as e:\n            logger.error(\"Repository error during check for string '%s': %s\", req.s, e)\n            raise HTTPException(status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=\"Internal server error\")\n        except Exception as e:\n            logger.exception(\"Unhandled error during check for string '%s'\", req.s)\n            raise HTTPException(status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=\"Internal server error\")\n\n    @app.get(\"/history\", response_model=List[HappyStringModel])\n    async def history(limit: int = Config.DEFAULT_HISTORY_LIMIT, authorized: bool = Depends(verify_api_token)):\n        \"\"\"\n        Retrieves a list of recent happy string check results.\n        Returns up to 'limit' entries, sorted by timestamp descending.\n        \"\"\"\n        if not 1 <= limit <= Config.DEFAULT_HISTORY_LIMIT:\n            raise HTTPException(\n                status_code=status.HTTP_400_BAD_REQUEST,\n                detail=f\"Limit must be between 1 and {Config.DEFAULT_HISTORY_LIMIT}\"\n            )\n        try:\n            results = service.get_history(limit)\n            logger.info(\"Retrieved %d history entries (limit: %d)\", len(results), limit)\n            return results\n        except RepositoryError as e:\n            logger.error(\"Repository error during history retrieval: %s\", e)\n            raise HTTPException(status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=\"Internal server error\")\n        except Exception as e:\n            logger.exception(\"Unhandled error during history retrieval\")\n            raise HTTPException(status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=\"Internal server error\")\n            \n    # Optionally add a health check endpoint\n    @app.get(\"/health\")\n    async def health_check():\n        return {\"status\": \"ok\"}\n\n    return app\n```\n\n```python\n# src/happystring_app/CLIController.py\n\"\"\"Click CLI commands for the HappyString application.\"\"\"\n\nimport json\nimport logging\nimport sys\n\nimport click\n\nfrom .HappinessService import HappinessService\nfrom .Exceptions import ValidationError, RepositoryError\nfrom .Config import Config # For default history limit\n\ndef create_cli(service: HappinessService) -> click.Group:\n    \"\"\"\n    Creates the Click CLI command group and its subcommands.\n    \"\"\"\n    logger = logging.getLogger(\"happystring\") # Use the configured logger\n\n    @click.group(name=Config.CLI_APP_NAME)\n    def cli():\n        \"\"\"A CLI tool to check if strings are 'happy' and view history.\"\"\"\n        pass\n\n    @cli.command(\"check\")\n    @click.argument(\"s\")\n    @click.option(\"--json\", \"output_json\", is_flag=True, help=\"Output result in JSON format.\")\n    def check_command(s: str, output_json: bool):\n        \"\"\"Checks if a given string S is happy.\"\"\"\n        try:\n            from .Validator import Validator # Local import to avoid circular dependency\n            Validator.validate_input(s)\n            model = service.check_and_record(s)\n            if output_json:\n                click.echo(json.dumps(model.to_dict(), indent=2))\n            else:\n                click.echo(f\"Is '{s}' happy? {model.is_happy}\")\n            logger.info(\"CLI checked string '%s', is_happy: %s\", s, model.is_happy)\n            sys.exit(0)\n        except ValidationError as e:\n            click.echo(f\"Error: {e}\", err=True)\n            logger.warning(\"CLI validation error for string '%s': %s\", s, e)\n            sys.exit(2) # Exit code 2 for validation errors\n        except RepositoryError as e:\n            click.echo(f\"Error: {e}\", err=True)\n            logger.error(\"CLI repository error during check for string '%s': %s\", s, e)\n            sys.exit(1) # Exit code 1 for internal/repository errors\n        except Exception as e:\n            click.echo(f\"An unexpected error occurred: {e}\", err=True)\n            logger.exception(\"CLI unhandled error during check for string '%s'\", s)\n            sys.exit(1)\n\n    @cli.command(\"history\")\n    @click.option(\n        \"--limit\",\n        default=Config.DEFAULT_HISTORY_LIMIT,\n        type=click.IntRange(1, Config.DEFAULT_HISTORY_LIMIT),\n        help=f\"Number of recent entries to show (max {Config.DEFAULT_HISTORY_LIMIT}).\"\n    )\n    def history_command(limit: int):\n        \"\"\"Lists recent happy string checks.\"\"\"\n        try:\n            results = service.get_history(limit)\n            if not results:\n                click.echo(\"No history found.\")\n                sys.exit(0)\n\n            click.echo(json.dumps([r.to_dict() for r in results], indent=2))\n            logger.info(\"CLI retrieved %d history entries (limit: %d)\", len(results), limit)\n            sys.exit(0)\n        except RepositoryError as e:\n            click.echo(f\"Error: {e}\", err=True)\n            logger.error(\"CLI repository error during history retrieval: %s\", e)\n            sys.exit(1)\n        except Exception as e:\n            click.echo(f\"An unexpected error occurred: {e}\", err=True)\n            logger.exception(\"CLI unhandled error during history retrieval\")\n            sys.exit(1)\n\n    return cli\n```\n\n```python\n# src/happystring_app/app.py\n\"\"\"Main application entry points for API and CLI.\"\"\"\n\nimport os\nimport sys\n\nfrom .AppFactory import build_app\nfrom .APIController import create_api_app\nfrom .CLIController import create_cli\nfrom .Config import Config\n\n# Initialize application components\n# This happens once when the module is imported (e.g., by uvicorn or cli entrypoint)\ntry:\n    app_components = build_app(\n        repo_path=Config.DEFAULT_HISTORY_PATH,\n        log_level=os.getenv(\"LOG_LEVEL\", \"INFO\")\n    )\nexcept Exception as e:\n    # If app initialization fails, log and exit for CLI, or raise for API (uvicorn handles)\n    # For CLI:\n    if \"happy_cli_entrypoint\" in sys.argv[0]: # Simple heuristic for CLI\n        print(f\"CRITICAL: Failed to initialize application: {e}\", file=sys.stderr)\n        sys.exit(1)\n    # For API:\n    raise # Let uvicorn or other ASGI server handle it\n\n# Expose FastAPI application for ASGI servers (e.g., uvicorn)\napi_app = create_api_app(\n    service=app_components.service,\n    api_token=Config.DEFAULT_API_TOKEN\n)\n\n# Expose Click CLI group for console scripts\ncli = create_cli(service=app_components.service)\n\n# Alias for common uvicorn pattern (e.g., uvicorn happystring_app.app:api_app)\nget_app = lambda: api_app\n```"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"Calculates letter grades for a list of GPAs.\n    It applies specific thresholds for conversion, including exact matches for 4.0 and 0.0.\n    \"\"\"\n    letter_grades = []\n    for gpa in grades:\n        if gpa == 4.0:\n            letter_grades.append(\"A+\")\n        elif gpa > 3.7:\n            letter_grades.append(\"A\")\n        elif gpa > 3.3:\n            letter_grades.append(\"A-\")\n        elif gpa > 3.0:\n            letter_grades.append(\"B+\")\n        elif gpa > 2.7:\n            letter_grades.append(\"B\")\n        elif gpa > 2.3:\n            letter_grades.append(\"B-\")\n        elif gpa > 2.0:\n            letter_grades.append(\"C+\")\n        elif gpa > 1.7:\n            letter_grades.append(\"C\")\n        elif gpa > 1.3:\n            letter_grades.append(\"C-\")\n        elif gpa > 1.0:\n            letter_grades.append(\"D+\")\n        elif gpa > 0.7:\n            letter_grades.append(\"D\")\n        elif gpa > 0.0:\n            letter_grades.append(\"D-\")\n        else:\n            letter_grades.append(\"E\")\n    return letter_grades"}
{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"Write a function that takes a string and returns True if the string\n    length is a prime number or False otherwise.\"\"\"\n    n = len(string)\n\n    # Primality test for n\n    if n < 2:\n        return False\n    if n in (2, 3):\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True"}
{"task_id": "HumanEval/81", "solution": "```python\ndef numerical_letter_grade(grades):\n    \"\"\"It is the last week of the semester and the teacher has to give the grades\n    to students. The teacher has been making her own algorithm for grading.\n    The only problem is, she has lost the code she used for grading.\n    She has given you a list of GPAs for some students and you have to write \n    a function that can output a list of letter grades using the following table:\n             GPA       |    Letter grade\n              4.0                A+\n            > 3.7                A \n            > 3.3                A- \n            > 3.0                B+\n            > 2.7                B \n            > 2.3                B-\n            > 2.0                C+\n            > 1.7                C\n            > 1.3                C-\n            > 1.0                D+ \n            > 0.7                D \n            > 0.0                D-\n              0.0                E\n    \n\n    Example:\n    grade_equation([4.0, 3, 1.7, 2, 3.5]) ==> ['A+', 'B', 'C-', 'C', 'A-']\n    \"\"\"\n    def map_single_gpa(gpa):\n        # Maps a single GPA to its corresponding letter grade based on predefined thresholds.\n        # Handles exact matches and greater than comparisons in descending order.\n        if gpa == 4.0:\n            return 'A+'\n        elif gpa > 3.7:\n            return 'A'\n        elif gpa > 3.3:\n            return 'A-'\n        elif gpa > 3.0:\n            return 'B+'\n        elif gpa > 2.7:\n            return 'B'\n        elif gpa > 2.3:\n            return 'B-'\n        elif gpa > 2.0:\n            return 'C+'\n        elif gpa > 1.7:\n            return 'C'\n        elif gpa > 1.3:\n            return 'C-'\n        elif gpa > 1.0:\n            return 'D+'\n        elif gpa > 0.7:\n            return 'D'\n        elif gpa > 0.0:\n            return 'D-'\n        elif gpa == 0.0:\n            return 'E'\n        else:\n            return 'E'\n\n    return [map_single_gpa(gpa) for gpa in grades]\n```"}
{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"Write a function that takes a string and returns True if the string\n    length is a prime number or False otherwise.\"\"\"\n    n = len(string)\n\n    # Check for primality of n\n    if n < 2:\n        return False\n    if n in (2, 3):\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True"}
