{"task_id": "HumanEval/27", "solution": "```python\n# src/strflip/__init__.py\n\"\"\"A reusable Python library and CLI to flip the case of characters in a string.\"\"\"\n\nfrom .api import FlipCaseAPI\n\n# Initialize a default API instance for the package-level convenience function.\n_default_api = FlipCaseAPI()\n\n__version__ = \"0.1.0\"\n__all__ = [\"flip_case\", \"__version__\"]\n\n\ndef flip_case(string: str) -> str:\n    \"\"\"\n    For a given string, flip lowercase characters to uppercase and uppercase to lowercase.\n    This is a convenience wrapper around the core API functionality.\n    \"\"\"\n    return _default_api.flip_case(string)\n\n```\n\n```python\n# src/strflip/api.py\nfrom typing import Optional\n\nfrom .service import FlipCaseService\nfrom .dto import FlipCaseResult\n\nclass FlipCaseAPI:\n    \"\"\"\n    Public API facade for string case flipping.\n    It provides simple functions for callers and handles dependencies.\n    \"\"\"\n    def __init__(self, service: Optional[FlipCaseService] = None) -> None:\n        self.service = service or FlipCaseService()\n\n    def flip_case(self, text: str) -> str:\n        \"\"\"\n        Validates and transforms the input text, returning only the resulting string.\n        Delegates the core logic to FlipCaseService.\n        \"\"\"\n        result_dto = self.service.flip_case(text)\n        return result_dto.result\n\n    def flip_case_with_metadata(self, text: str) -> FlipCaseResult:\n        \"\"\"\n        Validates and transforms the input text, returning the full FlipCaseResult DTO.\n        This includes the original, transformed string, and metadata.\n        \"\"\"\n        return self.service.flip_case(text)\n\n```\n\n```python\n# src/strflip/service.py\nfrom typing import Optional\n\nfrom .validator import StringValidator\nfrom .dto import FlipCaseResult\n\nclass FlipCaseService:\n    \"\"\"\n    Core business logic for flipping character case.\n    It orchestrates validation and the actual transformation.\n    \"\"\"\n    def __init__(self, validator: Optional[StringValidator] = None) -> None:\n        self._validator = validator or StringValidator()\n\n    def flip_case(self, text: str) -> FlipCaseResult:\n        \"\"\"\n        Validates the input string, performs the case flip, and returns a FlipCaseResult DTO.\n        It uses the injected StringValidator for input checks.\n        \"\"\"\n        self._validator.validate(text)\n        transformed = self._transform(text)\n        return FlipCaseResult(original=text, result=transformed, length=len(transformed))\n\n    def _transform(self, text: str) -> str:\n        \"\"\"\n        Performs the actual character case flip using Python's built-in Unicode-aware method.\n        Non-alphabetic characters are preserved unchanged.\n        \"\"\"\n        return text.swapcase()\n\n```\n\n```python\n# src/strflip/validator.py\nfrom typing import Optional\n\nfrom .exceptions import InvalidStringError\nfrom .config import MAX_INPUT_LENGTH\n\nclass StringValidator:\n    \"\"\"\n    Validates input strings based on predefined business rules.\n    It checks for type, non-null status, and maximum length.\n    \"\"\"\n    def __init__(self, max_length: Optional[int] = None) -> None:\n        self.max_length = max_length if max_length is not None else MAX_INPUT_LENGTH\n\n    def validate(self, text: str) -> None:\n        \"\"\"\n        Checks if the input is a valid string within length constraints.\n        Raises InvalidStringError for any validation failures.\n        \"\"\"\n        if not isinstance(text, str):\n            raise InvalidStringError(\"Input must be a string\", code=400)\n        if len(text) > self.max_length:\n            raise InvalidStringError(f\"Input exceeds maximum allowed length of {self.max_length}\", code=413)\n\n```\n\n```python\n# src/strflip/dto.py\nfrom dataclasses import dataclass\n\n@dataclass(frozen=True)\nclass FlipCaseResult:\n    \"\"\"\n    Data Transfer Object (DTO) to encapsulate the original string,\n    its transformed counterpart, and relevant metadata.\n    \"\"\"\n    original: str\n    result: str\n    length: int\n\n    def metadata(self) -> dict:\n        \"\"\"\n        Returns a dictionary containing basic metadata about the string lengths.\n        This provides context about the transformation.\n        \"\"\"\n        return {\n            \"original_length\": len(self.original),\n            \"result_length\": self.length,\n        }\n\n```\n\n```python\n# src/strflip/exceptions.py\nclass InvalidStringError(ValueError):\n    \"\"\"\n    Custom exception for invalid string inputs during validation.\n    It includes a message and a numerical code for better error handling context.\n    \"\"\"\n    def __init__(self, message: str, code: int = 400) -> None:\n        super().__init__(message)\n        self.message = message\n        self.code = code\n\n```\n\n```python\n# src/strflip/cli.py\nimport argparse\nimport sys\nfrom typing import List, Optional\n\nfrom .api import FlipCaseAPI\nfrom .exceptions import InvalidStringError\n\nclass CLIController:\n    \"\"\"\n    Handles command-line interface interactions for the strflip tool.\n    It parses arguments, reads input, calls the API, and prints results.\n    \"\"\"\n    def __init__(self, api: Optional[FlipCaseAPI] = None) -> None:\n        self.api = api or FlipCaseAPI()\n\n    def run(self, argv: List[str]) -> int:\n        \"\"\"\n        Main entrypoint for the CLI, responsible for argument parsing and execution.\n        Returns an exit code (0 for success, non-zero for errors).\n        \"\"\"\n        parser = argparse.ArgumentParser(\n            prog=\"strflip-cli\",\n            description=\"Flip the case of characters in a string or file content.\"\n        )\n        group = parser.add_mutually_exclusive_group(required=True)\n        group.add_argument(\"--text\", type=str, help=\"The string text to flip.\")\n        group.add_argument(\"--file\", type=str, help=\"Path to a file whose content should be flipped.\")\n        parser.add_argument(\"--api-key\", type=str, help=argparse.SUPPRESS) # Hidden argument if not using web server\n        args = parser.parse_args(argv)\n\n        input_text: Optional[str] = None\n        if args.text:\n            input_text = args.text\n        elif args.file:\n            try:\n                with open(args.file, \"r\", encoding=\"utf-8\") as fh:\n                    input_text = fh.read()\n            except FileNotFoundError:\n                print(f\"Error: File not found at '{args.file}'\", file=sys.stderr)\n                return 1\n            except Exception as e:\n                print(f\"Error reading file '{args.file}': {e}\", file=sys.stderr)\n                return 1\n        \n        if input_text is None:\n            parser.print_usage(sys.stderr)\n            return 2 # Usage error\n\n        try:\n            result = self.api.flip_case(input_text)\n            print(result)\n            return 0\n        except InvalidStringError as e:\n            print(f\"Error: {e.message} (Code: {e.code})\", file=sys.stderr)\n            return 1\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1\n\n```\n\n```python\n# src/strflip/web.py\nimport os\nfrom typing import Optional\n\nfrom fastapi import FastAPI, Request, HTTPException, status\nfrom pydantic import BaseModel, Field\nimport uvicorn\n\nfrom .api import FlipCaseAPI\nfrom .exceptions import InvalidStringError\nfrom .config import ENABLE_API_KEY, API_KEY_ENV\n\nclass FlipRequest(BaseModel):\n    \"\"\"Pydantic model for the input request payload.\"\"\"\n    text: str = Field(..., description=\"The string text to flip case.\")\n\nclass FlipResponse(BaseModel):\n    \"\"\"Pydantic model for the successful response payload.\"\"\"\n    result: str = Field(..., description=\"The string with flipped character cases.\")\n\nclass ErrorResponse(BaseModel):\n    \"\"\"Pydantic model for error responses.\"\"\"\n    error: str = Field(..., description=\"A description of the error.\")\n    code: int = Field(..., description=\"An error code.\")\n\nclass WebAPIController:\n    \"\"\"\n    Manages the FastAPI application and exposes the POST /flip endpoint.\n    It integrates with FlipCaseAPI for core logic and handles HTTP specifics.\n    \"\"\"\n    def __init__(self, api: Optional[FlipCaseAPI] = None) -> None:\n        self.app = FastAPI(\n            title=\"StrFlip API\",\n            description=\"API to flip the case of characters in a string.\",\n            version=\"0.1.0\"\n        )\n        self.api = api or FlipCaseAPI()\n        self.register_routes()\n\n    def _get_api_key(self) -> Optional[str]:\n        \"\"\"Retrieves the API key from environment variables.\"\"\"\n        return os.environ.get(API_KEY_ENV)\n\n    def register_routes(self) -> None:\n        \"\"\"\n        Registers the POST /flip endpoint with the FastAPI application.\n        It handles request validation, delegates to FlipCaseAPI, and formats responses.\n        \"\"\"\n        @self.app.post(\n            \"/flip\",\n            response_model=FlipResponse,\n            status_code=status.HTTP_200_OK,\n            summary=\"Flip character case of an input string\",\n            responses={\n                status.HTTP_400_BAD_REQUEST: {\"model\": ErrorResponse, \"description\": \"Invalid input\"},\n                status.HTTP_401_UNAUTHORIZED: {\"model\": ErrorResponse, \"description\": \"Unauthorized\"},\n                status.HTTP_413_PAYLOAD_TOO_LARGE: {\"model\": ErrorResponse, \"description\": \"Input string too large\"},\n                status.HTTP_500_INTERNAL_SERVER_ERROR: {\"model\": ErrorResponse, \"description\": \"Internal server error\"},\n            }\n        )\n        async def flip_endpoint(request: Request, body: FlipRequest):\n            if ENABLE_API_KEY:\n                expected_api_key = self._get_api_key()\n                if not expected_api_key:\n                    raise HTTPException(\n                        status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,\n                        detail={\"error\": \"API key check enabled but no key configured\", \"code\": 500}\n                    )\n                provided_api_key = request.headers.get(\"X-API-KEY\")\n                if not provided_api_key or provided_api_key != expected_api_key:\n                    raise HTTPException(\n                        status_code=status.HTTP_401_UNAUTHORIZED,\n                        detail={\"error\": \"Invalid or missing API Key\", \"code\": 401}\n                    )\n            try:\n                result_str = self.api.flip_case(body.text)\n                return FlipResponse(result=result_str)\n            except InvalidStringError as e:\n                # Map domain-specific error codes to HTTP status codes\n                http_status = status.HTTP_400_BAD_REQUEST\n                if e.code == 413:\n                    http_status = status.HTTP_413_PAYLOAD_TOO_LARGE\n                raise HTTPException(\n                    status_code=http_status,\n                    detail={\"error\": e.message, \"code\": e.code}\n                )\n            except Exception as e:\n                raise HTTPException(\n                    status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,\n                    detail={\"error\": f\"An unexpected server error occurred: {e}\", \"code\": 500}\n                )\n\n    def start(self, host: str = \"127.0.0.1\", port: int = 8000) -> None:\n        \"\"\"\n        Programmatically starts the Uvicorn server to host the FastAPI application.\n        This is a convenience method for local development or testing.\n        \"\"\"\n        uvicorn.run(self.app, host=host, port=port)\n\n```\n\n```python\n# src/strflip/config.py\nimport os\n\n# Maximum allowed length for input strings to prevent resource exhaustion.\nMAX_INPUT_LENGTH: int = 100_000\n\n# Feature flag to enable or disable API key protection for the web API.\nENABLE_API_KEY: bool = os.getenv(\"STRFLIP_ENABLE_API_KEY\", \"False\").lower() == \"true\"\n\n# Environment variable name where the API key is expected if ENABLE_API_KEY is true.\nAPI_KEY_ENV: str = \"STRFLIP_API_KEY\"\n\n```\n\n```python\n# pyproject.toml\n[project]\nname = \"strflip\"\nversion = \"0.1.0\"\ndescription = \"A Python library, CLI, and HTTP API for flipping character case in strings.\"\nauthors = [{ name = \"Your Name\", email = \"you@example.com\" }]\nlicense = \"MIT\"\nreadme = \"README.md\"\nrequires-python = \">=3.10\"\nkeywords = [\"case\", \"flip\", \"string\", \"unicode\", \"cli\", \"api\"]\nclassifiers = [\n    \"Development Status :: 3 - Alpha\",\n    \"Intended Audience :: Developers\",\n    \"License :: OSI Approved :: MIT License\",\n    \"Operating System :: OS Independent\",\n    \"Programming Language :: Python :: 3\",\n    \"Programming Language :: Python :: 3.10\",\n    \"Programming Language :: Python :: 3.11\",\n    \"Programming Language :: Python :: 3.12\",\n    \"Topic :: Text Processing\",\n    \"Topic :: Software Development :: Libraries :: Python Modules\",\n]\n\ndependencies = [\n    \"typing-extensions>=4.0.0\", # For compatibility if needed, though most is built-in in 3.10+\n]\n\n[project.optional-dependencies]\nweb = [\n    \"fastapi>=0.100.0\",\n    \"uvicorn[standard]>=0.20.0\",\n]\n\n[project.scripts]\nstrflip-cli = \"strflip.cli:CLIController.run\"\n\n[build-system]\nrequires = [\"setuptools>=61.0\", \"wheel\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[tool.setuptools.packages.find]\nwhere = [\"src\"]\n\n[tool.setuptools.package-dir]\n\"\" = \"src\"\n\n# Tools specific for development and testing\n[tool.pytest.ini_options]\nminversion = \"6.0\"\naddopts = \"-ra -q\"\ntestpaths = [\"tests\"]\n\n[tool.black]\nline-length = 120\ntarget-version = ['py310']\n\n[tool.isort]\nprofile = \"black\"\nline_length = 120\n\n[tool.mypy]\npython_version = \"3.10\"\nwarn_return_any = true\nwarn_unused_configs = true\nignore_missing_imports = true\n\n```\n\n```python\n# README.md\n# StrFlip: Unicode-Aware Case Flipping Library, CLI, and API\n\nStrFlip is a Python library designed to flip the case of characters in a string (e.g., 'Hello' becomes 'hELLO') with predictable Unicode-aware behavior. It provides a simple function for direct library use, a command-line interface (CLI), and an optional HTTP API.\n\n## Features\n\n- **Unicode-Aware Case Flipping**: Converts uppercase to lowercase and vice-versa, preserving non-letter characters.\n- **Python Library**: A `flip_case(string: str) -> str` function for easy integration into your Python projects.\n- **Command-Line Interface (CLI)**: Use `strflip-cli` to flip strings provided as arguments or from file content.\n- **HTTP API (Optional)**: A FastAPI-based web endpoint (`POST /flip`) for integration with other services.\n- **Robust Error Handling**: Clear, predictable errors for invalid inputs.\n- **Configurable**: Max input length and optional API key for the web service.\n- **Well-Tested**: Includes unit and integration tests (though not generated in this output).\n\n## Installation\n\nStrFlip requires Python 3.10 or higher.\n\nTo install the library:\n\n```bash\npip install strflip\n```\n\nTo include the optional web API dependencies:\n\n```bash\npip install \"strflip[web]\"\n```\n\n## Usage\n\n### Python Library\n\n```python\nimport strflip\n\n# Basic usage\nflipped_text = strflip.flip_case(\"Hello, World!\")\nprint(flipped_text) # Output: hELLO, wORLD!\n\n# With Unicode characters\nunicode_text = \"Stra\u00dfe und \u03a3\u03af\u03b3\u03bc\u03b1\"\nflipped_unicode = strflip.flip_case(unicode_text)\nprint(flipped_unicode) # Output: sTRA\u1e9eE UND \u03c3\u03af\u0393\u039c\u0391\n\n# Error handling (if using the API directly for validation)\nfrom strflip.api import FlipCaseAPI\nfrom strflip.exceptions import InvalidStringError\n\napi = FlipCaseAPI()\ntry:\n    long_string = \"a\" * 200_000\n    api.flip_case(long_string)\nexcept InvalidStringError as e:\n    print(f\"Error: {e.message}\")\n```\n\n### Command-Line Interface (CLI)\n\nUse `strflip-cli` from your terminal.\n\n**Flip a string directly:**\n\n```bash\nstrflip-cli --text \"Python Programming\"\n```\nOutput:\n```\npYTHON pROGRAMMING\n```\n\n**Flip the content of a file:**\n\nFirst, create a file named `input.txt`:\n```\nThis is a test file.\nIt has multiple lines.\n```\n\nThen, run the CLI:\n```bash\nstrflip-cli --file input.txt\n```\nOutput:\n```\ntHIS IS A TEST FILE.\niT HAS MULTIPLE LINES.\n```\n\n**Error Handling in CLI:**\nIf input exceeds max length or file not found, appropriate error messages will be printed to stderr, and the command will exit with a non-zero status code.\n\n### HTTP API (Optional)\n\nIf you installed with `strflip[web]`, you can run the HTTP API.\n\n**To start the API server:**\n\n```bash\nuvicorn strflip.web:WebAPIController().app --host 127.0.0.1 --port 8000\n```\n\nThe API will be available at `http://127.0.0.1:8000`.\n\n**Making a POST request to `/flip`:**\n\n```bash\ncurl -X POST -H \"Content-Type: application/json\" -d '{\"text\": \"Example Text\"}' http://127.0.0.1:8000/flip\n```\nResponse:\n```json\n{\"result\": \"eXAMPLE tEXT\"}\n```\n\n**With API Key (if enabled):**\n\nIf `STRFLIP_ENABLE_API_KEY` environment variable is set to `\"True\"` and `STRFLIP_API_KEY` is set, you must include the `X-API-KEY` header.\n\n```bash\nexport STRFLIP_ENABLE_API_KEY=\"True\"\nexport STRFLIP_API_KEY=\"your-secret-key\"\n\ncurl -X POST -H \"Content-Type: application/json\" -H \"X-API-KEY: your-secret-key\" -d '{\"text\": \"Secure Text\"}' http://127.0.0.1:8000/flip\n```\n\n## Configuration\n\nThe `src/strflip/config.py` module contains constants that can be overridden via environment variables or modified directly (not recommended for library users).\n\n- `MAX_INPUT_LENGTH`: The maximum number of characters allowed in an input string (default: 100,000).\n- `ENABLE_API_KEY`: Boolean flag to enable/disable API key authentication for the web API (default: `False`, controlled by `STRFLIP_ENABLE_API_KEY` env var).\n- `API_KEY_ENV`: The environment variable name (`STRFLIP_API_KEY`) used to retrieve the API key value.\n\n## Development\n\n### Project Structure\n\n```\n\u251c\u2500\u2500 src/\n\u2502   \u2514\u2500\u2500 strflip/\n\u2502       \u251c\u2500\u2500 __init__.py      # Package exposure: flip_case, __version__\n\u2502       \u251c\u2500\u2500 api.py           # Public facade: FlipCaseAPI\n\u2502       \u251c\u2500\u2500 service.py       # Core business logic: FlipCaseService\n\u2502       \u251c\u2500\u2500 validator.py     # Input validation: StringValidator\n\u2502       \u251c\u2500\u2500 dto.py           # Data transfer objects: FlipCaseResult\n\u2502       \u251c\u2500\u2500 exceptions.py    # Domain exceptions: InvalidStringError\n\u2502       \u251c\u2500\u2500 cli.py           # CLI controller: CLIController\n\u2502       \u251c\u2500\u2500 web.py           # Web controller: WebAPIController\n\u2502       \u2514\u2500\u2500 config.py        # Configuration constants\n\u251c\u2500\u2500 tests/                   # Unit and integration tests (not generated in this output)\n\u251c\u2500\u2500 .github/                 # GitHub Actions CI workflow (not generated in this output)\n\u251c\u2500\u2500 pyproject.toml           # Build metadata, dependencies, entry points\n\u251c\u2500\u2500 README.md                # Project overview, usage, examples\n\u2514\u2500\u2500 LICENSE                  # Project license\n```\n\n### Running Tests\n\n*(Note: Test files are not included in this code generation output.)*\nTo run tests using `pytest` (after installing `pytest` as a dev dependency):\n\n```bash\npip install \"pytest>=6.0.0\" # Install pytest separately if needed\npytest\n```\n\n## License\n\nThis project is licensed under the MIT License. See the `LICENSE` file for details.\n\n```\n\n```python\n# 