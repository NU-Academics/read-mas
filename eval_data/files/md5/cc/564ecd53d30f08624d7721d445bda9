):\n            self._raise_invalid(a)\n        if not self.is_binary_string(b):\n            self._raise_invalid(b)\n        if len(a) != len(b):\n            raise LengthMismatchError(expected=len(a), actual=len(b))\n\n```\n```python\n# src/binaryxor/service.py\nfrom .exceptions import LengthMismatchError\n\nclass BinaryXORService:\n    \"\"\"Provides the core bitwise XOR logic for binary strings.\"\"\"\n    CHUNK_SIZE: int = 8192\n\n    def __init__(self) -> None:\n        pass\n\n    def _xor_chunk(self, a_chunk: str, b_chunk: str) -> str:\n        \"\"\"Performs XOR on two small binary string chunks.\"\"\"\n        result_list = []\n        for char_a, char_b in zip(a_chunk, b_chunk):\n            result_list.append('0' if char_a == char_b else '1')\n        return \"\".join(result_list)\n\n    def xor(self, a: str, b: str) -> str:\n        \"\"\"Computes the bitwise XOR of two equal-length binary strings.\"\"\"\n        if len(a) != len(b): # Defensive check, validator should catch this primarily\n            raise LengthMismatchError(expected=len(a), actual=len(b), message=\"Internal service length mismatch.\")\n\n        # Process in chunks for potential memory efficiency with very large strings.\n        if len(a) <= self.CHUNK_SIZE:\n            return self._xor_chunk(a, b)\n        else:\n            result_parts = []\n            for i in range(0, len(a), self.CHUNK_SIZE):\n                a_chunk = a[i : i + self.CHUNK_SIZE]\n                b_chunk = b[i : i + self.CHUNK_SIZE]\n                result_parts.append(self._xor_chunk(a_chunk, b_chunk))\n            return \"\".join(result_parts)\n\n```\n```python\n# src/binaryxor/__init__.py\nfrom .service import BinaryXORService\nfrom .validator import InputValidator\nfrom . import exceptions\n\n# Initialize service and validator for the module-level function\n_service = BinaryXORService()\n_validator = InputValidator()\n\ndef string_xor(a: str, b: str) -> str:\n    \"\"\"Performs bitwise XOR on two binary strings after validation.\"\"\"\n    _validator.validate(a, b)\n    return _service.xor(a, b)\n\n__all__ = [\"string_xor\", \"BinaryXORService\", \"InputValidator\", \"exceptions\"]\n\n```\n```python\n# src/binaryxor/cli.py\nimport sys\nimport argparse\nfrom typing import List\n\nfrom .service import BinaryXORService\nfrom .validator import InputValidator\nfrom .exceptions import InvalidBinaryStringError, LengthMismatchError\n\nclass CLIController:\n    \"\"\"Manages CLI argument parsing, XOR computation, and result/error output.\"\"\"\n    def __init__(self, service: BinaryXORService, validator: InputValidator) -> None:\n        self.service = service\n        self.validator = validator\n\n    def _print_result(self, result: str) -> None:\n        \"\"\"Prints the XOR result to standard output.\"\"\"\n        print(result)\n\n    def _print_error(self, err: Exception) -> None:\n        \"\"\"Prints error messages to standard error.\"\"\"\n        if isinstance(err, (InvalidBinaryStringError, LengthMismatchError)):\n            print(f\"Error: {err.message}\", file=sys.stderr)\n        else:\n            print(f\"An unexpected error occurred: {err}\", file=sys.stderr)\n\n    def run(self, args: List[str]) -> int:\n        \"\"\"Parses CLI arguments, computes XOR, and handles output/exit codes.\"\"\"\n        parser = argparse.ArgumentParser(\n            prog=\"binaryxor\",\n            description=\"Perform bitwise XOR on two binary strings.\"\n        )\n        subparsers = parser.add_subparsers(dest=\"command\", help=\"Available commands\")\n\n        xor_parser = subparsers.add_parser(\n            \"xor\",\n            help=\"Compute XOR of two binary strings.\"\n        )\n        xor_parser.add_argument(\"a\", type=str, help=\"First binary string.\")\n        xor_parser.add_argument(\"b\", type=str, help=\"Second binary string.\")\n\n        parsed_args = parser.parse_args(args[1:]) # Skip the script name\n\n        if parsed_args.command == \"xor\":\n            try:\n                self.validator.validate(parsed_args.a, parsed_args.b)\n                result = self.service.xor(parsed_args.a, parsed_args.b)\n                self._print_result(result)\n                return 0\n            except (InvalidBinaryStringError, LengthMismatchError) as e:\n                self._print_error(e)\n                return 2 # Validation error exit code\n            except Exception as e:\n                self._print_error(e)\n                return 1 # General unexpected error exit code\n        else:\n            parser.print_help()\n            return 1\n\ndef main(argv: List[str] = None) -> int:\n    \"\"\"CLI entry point for the binaryxor package.\"\"\"\n    if argv is None:\n        argv = sys.argv\n    controller = CLIController(BinaryXORService(), InputValidator())\n    return controller.run(argv)\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n\n```\n```python\n# src/binaryxor/http_api.py\nimport json\nfrom http.server import BaseHTTPRequestHandler, HTTPServer\nimport threading\nfrom typing import Dict, Any, Tuple\n\nfrom .service import BinaryXORService\nfrom .validator import InputValidator\nfrom .exceptions import InvalidBinaryStringError, LengthMismatchError\n\nclass HTTPAPI:\n    \"\"\"Minimal HTTP server exposing a POST /xor endpoint.\"\"\"\n    def __init__(self, service: BinaryXORService, validator: InputValidator) -> None:\n        self.service = service\n        self.validator = validator\n\n    def handle_request(self, method: str, path: str, body: bytes) -> Tuple[int, Dict[str, Any]]:\n        \"\"\"Handles a single HTTP request, decoupled from network for testing.\"\"\"\n        if method == \"POST\" and path == \"/xor\":\n            try:\n                data = json.loads(body)\n                a = data.get(\"a\")\n                b = data.get(\"b\")\n\n                if not isinstance(a, str) or not isinstance(b, str):\n                    return 400, {\"error\": \"Missing or invalid 'a' or 'b' fields.\"}\n\n                self.validator.validate(a, b)\n                result = self.service.xor(a, b)\n                return 200, {\"result\": result}\n            except json.JSONDecodeError:\n                return 400, {\"error\": \"Malformed JSON body.\"}\n            except (InvalidBinaryStringError, LengthMismatchError) as e:\n                return 422, {\"error\": e.message}\n            except Exception as e:\n                # Log unexpected errors for debugging\n                return 500, {\"error\": f\"An unexpected error occurred: {str(e)}\"}\n        else:\n            return 404, {\"error\": \"Not Found\"}\n\n    def start(self, host: str = '127.0.0.1', port: int = 8000) -> None:\n        \"\"\"Starts a blocking HTTP server. Use in development or via python -m.\"\"\"\n        api_instance = self # Capture 'self' for the handler factory\n\n        class RequestHandler(BaseHTTPRequestHandler):\n            def do_POST(self):\n                content_length = int(self.headers.get('Content-Length', 0))\n                body = self.rfile.read(content_length)\n\n                status_code, response_data = api_instance.handle_request(\n                    self.command, self.path, body\n                )\n\n                self.send_response(status_code)\n                self.send_header(\"Content-Type\", \"application/json\")\n                self.end_headers()\n                self.wfile.write(json.dumps(response_data).encode(\"utf-8\"))\n\n            def do_GET(self):\n                # Simple health check or info for GET /\n                if self.path == '/':\n                    self.send_response(200)\n                    self.send_header(\"Content-Type\", \"application/json\")\n                    self.end_headers()\n                    self.wfile.write(json.dumps({\"status\": \"running\", \"service\": \"binaryxor\"}).encode(\"utf-8\"))\n                else:\n                    status_code, response_data = api_instance.handle_request(\n                        self.command, self.path, b''\n                    )\n                    self.send_response(status_code)\n                    self.send_header(\"Content-Type\", \"application/json\")\n                    self.end_headers()\n                    self.wfile.write(json.dumps(response_data).encode(\"utf-8\"))\n\n        server_address = (host, port)\n        httpd = HTTPServer(server_address, RequestHandler)\n        print(f\"Starting HTTP server on {host}:{port}...\")\n        try:\n            httpd.serve_forever()\n        except KeyboardInterrupt:\n            print(\"Server shutting down.\")\n            httpd.shutdown()\n\nif __name__ == \"__main__\":\n    # This block allows running the server directly via 'python -m binaryxor.http_api'\n    http_api = HTTPAPI(BinaryXORService(), InputValidator())\n    http_api.start()\n\n```\n```toml\n# pyproject.toml\n[project]\nname = \"binaryxor\"\nversion = \"0.1.0\"\ndescription = \"A simple library for bitwise XOR on binary strings.\"\nauthors = [\n    { name = \"Your Name\", email = \"your.email@example.com\" }, # Replace with your details\n]\nlicense = { text = \"MIT\" }\nrequires-python = \">=3.9\"\ndependencies = [] # Standard library only\n\n[project.scripts]\nbinaryxor = \"binaryxor.cli:main\"\n\n[project.urls]\nHomepage = \"https://github.com/yourusername/binaryxor\" # Placeholder for your repo\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[tool.setuptools.packages]\nfind = { where = [\"src\"] }\n\n[tool.pytest.ini_options]\npythonpath = [\"src\"] # Ensure src is on python path for tests\n\n```\n```markdown\n# README.md\n# Binary XOR Library\n\nA simple Python library to perform bitwise XOR on two binary strings.\n\n## Installation\n\nTo install the library, you would typically run:\n\n```bash\npip install . # from the project root if pyproject.toml is present\n# Or for local development\npip install -e .\n```\n\n## Usage\n\n### Programmatic API\n\nYou can use the `string_xor` function directly in your Python code:\n\n```python\nfrom binaryxor import string_xor, exceptions\n\ntry:\n    result = string_xor(\"0101\", \"1100\")\n    print(f\"XOR result: {result}\") # Output: 1001\n\n    # Error handling for length mismatch\n    string_xor(\"010\", \"11\")\nexcept exceptions.LengthMismatchError as e:\n    print(f\"Error: {e.message}\")\n\n# Error handling for invalid characters\ntry:\n    string_xor(\"012\", \"110\")\nexcept exceptions.InvalidBinaryStringError as e:\n    print(f\"Error: {e.message}\")\n```\n\n### Command Line Interface (CLI)\n\nThe library provides a command-line tool `binaryxor`:\n\n```bash\n# Success example\nbinaryxor xor 0101 1100\n# Expected Output: 1001\n\n# Length mismatch error\nbinaryxor xor 010 11\n# Expected Output to stderr: Error: Input string lengths mismatch: expected 3, got 2.\n# Exits with code 2\n\n# Invalid characters error\nbinaryxor xor 012 110\n# Expected Output to stderr: Error: String contains non-binary characters: ['2'].\n# Exits with code 2\n```\n\n### HTTP API (Development/Testing)\n\nA minimal HTTP server is provided for development or integration testing. To start it:\n\n```bash\npython -m binaryxor.http_api\n# Output: Starting HTTP server on 127.0.0.1:8000...\n```\n\nOnce the server is running, you can send POST requests:\n\n```bash\n# Success example\ncurl -X POST -H \"Content-Type: application/json\" -d '{\"a\": \"0101\", \"b\": \"1100\"}' http://127.0.0.1:8000/xor\n# Expected Output: {\"result\": \"1001\"}\n# HTTP Status: 200 OK\n\n# Validation error (length mismatch)\ncurl -X POST -H \"Content-Type: application/json\" -d '{\"a\": \"010\", \"b\": \"11\"}' http://127.0.0.1:8000/xor\n# Expected Output: {\"error\": \"Input string lengths mismatch: expected 3, got 2.\"}\n# HTTP Status: 422 Unprocessable Entity\n\n# Malformed JSON\ncurl -X POST -H \"Content-Type: application/json\" -d '{\"a\": \"010\", \"b\": }' http://127.0.0.1:8000/xor\n# Expected Output: {\"error\": \"Malformed JSON body.\"}\n# HTTP Status: 400 Bad Request\n```\n\n## Development\n\nIf you're working on the project, you can run tests using `pytest`:\n\n```bash\npip install pytest\npytest\n```\n```"}
