c.strutils.services import StringService\nfrom src.strutils.validation import Validator\nfrom src.strutils.utils import CLI_USAGE # For asserting usage message\n\n# Fixtures for mock objects for testing CLI\n@pytest.fixture\ndef mock_service():\n    \"\"\"Mock StringService for CLIController.\"\"\"\n    validator = Validator() # Use a real validator for some consistency, or mock it too\n    return StringService(validator)\n\n@pytest.fixture\ndef cli_controller(mock_service):\n    \"\"\"CLIController instance with a mock service.\"\"\"\n    return CLIController(mock_service)\n\n# --- Tests for CLIController.run ---\n\ndef test_cli_run_no_args_prints_usage_and_exits_2(cli_controller, capsys):\n    \"\"\"Test CLIController.run with no arguments.\"\"\"\n    assert cli_controller.run([]) == 2\n    captured = capsys.readouterr()\n    assert CLI_USAGE in captured.stderr\n    assert \"Missing string argument\" not in captured.stderr # Should be \"Usage\", not \"Missing\" for no args\n\ndef test_cli_run_invalid_command_prints_usage_and_exits_2(cli_controller, capsys):\n    \"\"\"Test CLIController.run with an unknown command.\"\"\"\n    assert cli_controller.run([\"unknown_command\", \"test\"]) == 2\n    captured = capsys.readouterr()\n    assert \"Error: Unknown command 'unknown_command'.\" in captured.stderr\n    assert CLI_USAGE in captured.stderr\n\ndef test_cli_run_strlen_no_string_arg_prints_usage_and_exits_2(cli_controller, capsys):\n    \"\"\"Test CLIController.run with 'strlen' but no string argument.\"\"\"\n    assert cli_controller.run([\"strlen\"]) == 2\n    captured = capsys.readouterr()\n    assert \"Error: Missing string argument for 'strlen'.\" in captured.stderr\n    assert CLI_USAGE in captured.stderr\n\ndef test_cli_run_strlen_valid_string_prints_length_and_exits_0(cli_controller, capsys):\n    \"\"\"Test CLIController.run with a valid 'strlen' command and string.\"\"\"\n    assert cli_controller.run([\"strlen\", \"hello\"]) == 0\n    captured = capsys.readouterr()\n    assert captured.stdout.strip() == \"5\"\n    assert not captured.stderr\n\ndef test_cli_run_strlen_empty_string_prints_length_and_exits_0(cli_controller, capsys):\n    \"\"\"Test CLIController.run with an empty string.\"\"\"\n    assert cli_controller.run([\"strlen\", \"\"]) == 0\n    captured = capsys.readouterr()\n    assert captured.stdout.strip() == \"0\"\n    assert not captured.stderr\n\ndef test_cli_run_strlen_unicode_string_prints_length_and_exits_0(cli_controller, capsys):\n    \"\"\"Test CLIController.run with a Unicode string.\"\"\"\n    assert cli_controller.run([\"strlen\", \"h\u00e9llo\ud83d\ude00\"]) == 6\n    captured = capsys.readouterr()\n    assert captured.stdout.strip() == \"6\"\n    assert not captured.stderr\n\ndef test_cli_run_strlen_invalid_input_from_service_exits_2(mocker, cli_controller, capsys):\n    \"\"\"\n    Test CLIController.run when StringService.length raises a ValidationError.\n    Mocks the service to simulate specific error.\n    \"\"\"\n    mocker.patch.object(cli_controller._service, 'length', side_effect=ValueError(\"Simulated validation error\"))\n    assert cli_controller.run([\"strlen\", \"bad_input\"]) == 2\n    captured = capsys.readouterr()\n    assert \"Error: Simulated validation error\" in captured.stderr\n    assert not captured.stdout\n\ndef test_cli_run_strlen_unexpected_error_exits_1(mocker, cli_controller, capsys):\n    \"\"\"\n    Test CLIController.run when an unexpected error occurs in StringService.\n    Mocks the service to simulate a non-StrutilsError.\n    \"\"\"\n    mocker.patch.object(cli_controller._service, 'length', side_effect=Exception(\"Unexpected internal error\"))\n    assert cli_controller.run([\"strlen\", \"any_string\"]) == 1\n    captured = capsys.readouterr()\n    assert \"An unexpected error occurred: Unexpected internal error\" in captured.stderr\n    assert not captured.stdout\n\n# --- Tests for main function (integrated CLI flow) ---\n\ndef test_main_no_args_exits_2(capsys):\n    \"\"\"Test main function with no arguments.\"\"\"\n    assert main([]) == 2\n    captured = capsys.readouterr()\n    assert CLI_USAGE in captured.stderr\n\ndef test_main_valid_strlen_exits_0(capsys):\n    \"\"\"Test main function with a valid 'strlen' command.\"\"\"\n    assert main([\"strlen\", \"world\"]) == 0\n    captured = capsys.readouterr()\n    assert captured.stdout.strip() == \"5\"\n    assert not captured.stderr\n\ndef test_main_invalid_input_exits_2(capsys):\n    \"\"\"Test main function with invalid input (simulating non-str being passed via CLI - though CLI passes str).\"\"\"\n    # CLI will always pass strings, so to test the ValidationError path for inputs like None/int,\n    # we'd need to mock the service's behavior to simulate passing non-string data types to it.\n    # However, the current cli_controller.run directly calls service.length(input_string)\n    # where input_string is *always* a string from argv.\n    # So, for the main function, `input_string` will always be `str`.\n    # The ValidationError would typically come from Validator if bytes were passed, but CLI passes string.\n    # The only ValidationError for a string from CLI is if the string is empty and that was somehow invalid (it isn't here).\n    # So this test case primarily covers a scenario where an _internal_ validation error could occur,\n    # even though direct string from CLI is usually valid.\n    \n    # Simulate a scenario where `service.length` somehow fails validation (e.g. if we had `Validator` trying to decode\n    # a string that should be bytes, which isn't the case here, but shows the error path).\n    class BadValidator(Validator):\n        def validate_string(self, s: Any) -> str:\n            raise ValidationError(\"Simulated bad string validation\")\n    \n    # Patch the Validator used within main's StringService setup\n    with patch('src.strutils.cli.Validator', return_value=BadValidator()):\n        assert main([\"strlen\", \"some_string\"]) == 2\n        captured = capsys.readouterr()\n        assert \"Error: Simulated bad string validation\" in captured.stderr\n        assert not captured.stdout\n\n```\n```python\n# examples/example_usage.py\nimport sys\nfrom src.strutils import strlen, StringService, Validator, StringDTO, StrutilsError\n\ndef demonstrate_library_usage():\n    print(\"--- Library Usage ---\")\n\n    # 1. Using the core strlen function\n    print(f\"strlen('hello'): {strlen('hello')}\")\n    print(f\"strlen(''): {strlen('')}\")\n    print(f\"strlen('h\u00e9llo\ud83d\ude00'): {strlen('h\u00e9llo\ud83d\ude00')}\")\n\n    try:\n        # Invalid input for core strlen\n        strlen(123) # type: ignore\n    except StrutilsError as e:\n        print(f\"Error (core strlen): {e}\")\n\n    # 2. Using the StringService with validation\n    validator = Validator()\n    service = StringService(validator)\n\n    print(f\"Service length('world'): {service.length('world')}\")\n    print(f\"Service length(b'bytes'): {service.length(b'bytes')}\") # Service validates bytes to str\n\n    try:\n        # Invalid input for StringService\n        service.length(None)\n    except StrutilsError as e:\n        print(f\"Error (service length): {e}\")\n\n    # 3. Using StringDTO with StringService\n    dto = StringDTO(\"dto_example\")\n    print(f\"Service length_from_dto(dto_example): {service.length_from_dto(dto)}\")\n\n    try:\n        invalid_dto_payload = {\"key\": \"value\"}\n        StringDTO.from_json(invalid_dto_payload)\n    except StrutilsError as e:\n        print(f\"Error (StringDTO from_json): {e}\")\n    \n    print(\"\\n---------------------\\n\")\n\n\ndef demonstrate_cli_usage():\n    print(\"--- CLI Usage (simulated) ---\")\n    print(\"To use from terminal, run:\")\n    print(\"  $ strutils strlen \\\"hello world\\\"\")\n    print(\"  # Expected output: 11\")\n    print(\"\\n  $ strutils strlen \\\"\\\"\")\n    print(\"  # Expected output: 0\")\n    print(\"\\n  $ strutils strlen \\\"h\u00e9