{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Sorts characters within each word of a string by ASCII/codepoint value.\n    Preserves original word order and spacing.\n    \"\"\"\n    processed_tokens = []\n    current_idx = 0\n    n = len(s)\n\n    while current_idx < n:\n        char = s[current_idx]\n        is_space_char = (char == ' ')\n\n        start_idx = current_idx\n        # Find the end of the current token (either a sequence of spaces or non-spaces)\n        while current_idx < n and ((s[current_idx] == ' ') == is_space_char):\n            current_idx += 1\n        \n        token = s[start_idx:current_idx]\n        \n        if is_space_char:\n            processed_tokens.append(token)\n        else:\n            # For non-space tokens, sort their characters by ASCII/codepoint value\n            processed_tokens.append(''.join(sorted(token, key=ord)))\n            \n    return ''.join(processed_tokens)"}
{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"Transforms input string by sorting characters in each word by ASCII order. Original word order and spaces are preserved.\"\"\"\n    \n    tokens = []\n    current_chunk_chars = []\n    is_current_chunk_space = None\n\n    for char in s:\n        char_is_space = (char == ' ')\n\n        if is_current_chunk_space is None:\n            is_current_chunk_space = char_is_space\n            current_chunk_chars.append(char)\n        elif char_is_space == is_current_chunk_space:\n            current_chunk_chars.append(char)\n        else:\n            tokens.append((''.join(current_chunk_chars), is_current_chunk_space))\n            current_chunk_chars = [char]\n            is_current_chunk_space = char_is_space\n\n    if current_chunk_chars:\n        tokens.append((''.join(current_chunk_chars), is_current_chunk_space))\n\n    transformed_parts = []\n    for text, is_space in tokens:\n        if is_space:\n            transformed_parts.append(text)\n        else:\n            transformed_parts.append(''.join(sorted(text, key=ord)))\n\n    return ''.join(transformed_parts)"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Given a 2D nested list and an integer x, find all occurrences of x.\n    Returns a list of (row, column) coordinates, sorted by row ascending, then by column descending.\n    \"\"\"\n    results = []\n    for r_idx, row_data in enumerate(lst):\n        cols_found = []\n        for c_idx, value in enumerate(row_data):\n            if value == x:\n                cols_found.append(c_idx)\n        cols_found.sort(reverse=True)\n        for c_idx in cols_found:\n            results.append((r_idx, c_idx))\n    return results"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds coordinates of value x in a ragged 2D list.\n    Results are sorted by row ascending, then by column descending.\n    \"\"\"\n    found_coordinates = []\n\n    for row_idx, row in enumerate(lst):\n        for col_idx, value in enumerate(row):\n            if value == x:\n                found_coordinates.append((row_idx, col_idx))\n\n    sorted_coordinates = sorted(found_coordinates, key=lambda coord: (coord[0], -coord[1]))\n\n    return sorted_coordinates"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Sorts a copy of the given array based on the parity of the sum of its first and last elements.\n    Ascending if sum is odd, descending if sum is even; handles empty or single-element arrays.\n    \"\"\"\n    if not array:\n        return []\n\n    if len(array) == 1:\n        return list(array)\n\n    first_element = array[0]\n    last_element = array[-1]\n    \n    sum_first_last = first_element + last_element\n    \n    array_copy = list(array)\n    \n    if sum_first_last % 2 == 1:\n        return sorted(array_copy)\n    else:\n        return sorted(array_copy, reverse=True)"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Sorts a copy of the given array based on the parity of the sum of its first and last elements.\n    If the sum is odd, it sorts in ascending order; if even, it sorts in descending order.\n    \"\"\"\n    arr_copy = list(array)\n\n    if len(arr_copy) <= 1:\n        return arr_copy\n\n    first_element = arr_copy[0]\n    last_element = arr_copy[-1]\n    elements_sum = first_element + last_element\n\n    if elements_sum % 2 == 1:  # Odd sum, sort ascending\n        return sorted(arr_copy)\n    else:  # Even sum, sort descending\n        return sorted(arr_copy, reverse=True)"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by rotating alphabet letters by 4 positions.\n    Case is preserved, and non-alphabetic characters remain unchanged.\n    \"\"\"\n    SHIFT = 4\n    result = []\n    for char in s:\n        if 'a' <= char <= 'z':\n            rotated_char_code = (ord(char) - ord('a') + SHIFT) % 26 + ord('a')\n            result.append(chr(rotated_char_code))\n        elif 'A' <= char <= 'Z':\n            rotated_char_code = (ord(char) - ord('A') + SHIFT) % 26 + ord('A')\n            result.append(chr(rotated_char_code))\n        else:\n            result.append(char)\n    return ''.join(result)"}
{"task_id": "HumanEval/89", "solution": "```python\ndef encrypt(s):\n    \"\"\"Encrypts a string using a Caesar-style rotation cipher with a fixed shift of 4.\n    Letters are shifted forward, preserving case, while non-alphabetic characters remain unchanged.\n    \"\"\"\n    shift = 4\n\n    def _is_alpha(ch: str) -> bool:\n        \"\"\"Checks if a character is an ASCII letter.\"\"\"\n        return ('a' <= ch <= 'z') or ('A' <= ch <= 'Z')\n\n    def _shift_char(ch: str, s_val: int) -> str:\n        \"\"\"Shifts an alphabetic character by a given value, preserving case and wrapping around.\"\"\"\n        if not _is_alpha(ch):\n            return ch\n        \n        if 'a' <= ch <= 'z':\n            base = ord('a')\n        else: # 'A' <= ch <= 'Z'\n            base = ord('A')\n            \n        return chr((ord(ch) - base + s_val) % 26 + base)\n\n    return ''.join([_shift_char(char, shift) for char in s])\n```"}
{"task_id": "HumanEval/90", "solution": "```python\n# src/next_smallest_app/config.py\nimport os\nimport logging\n\nclass Config:\n    \"\"\"Application configuration settings.\"\"\"\n    DB_PATH: str = os.environ.get(\"NEXT_SMALLEST_DB_PATH\", \"./data/history.db\")\n    LOG_LEVEL: str = os.environ.get(\"NEXT_SMALLEST_LOG_LEVEL\", \"INFO\")\n    API_HOST: str = os.environ.get(\"NEXT_SMALLEST_API_HOST\", \"127.0.0.1\")\n    API_PORT: int = int(os.environ.get(\"NEXT_SMALLEST_API_PORT\", 8000))\n    API_PREFIX: str = \"/api/v1\"\n\n# src/next_smallest_app/utils.py\nimport json\nimport logging\nfrom typing import Any, List\n\nLOGGER_NAME = \"next_smallest_app\"\nDEFAULT_ENCODING = \"utf-8\"\n\ndef setup_logging(level_str: str = \"INFO\"):\n    \"\"\"Configures basic logging for the application.\"\"\"\n    level = getattr(logging, level_str.upper(), logging.INFO)\n    logging.basicConfig(level=level, format='%(asctime)s - %(name)s - %(levelname)s - %(message)s')\n\ndef get_logger(name: str = LOGGER_NAME) -> logging.Logger:\n    \"\"\"Returns a logger instance.\"\"\"\n    return logging.getLogger(name)\n\ndef parse_int_list(text: str) -> List[int]:\n    \"\"\"Parses a string of space-separated or comma-separated integers.\"\"\"\n    parts = text.replace(',', ' ').split()\n    result = []\n    for part in parts:\n        try:\n            result.append(int(part))\n        except ValueError as e:\n            raise InvalidInputError(f\"Cannot parse '{part}' as an integer.\") from e\n    return result\n\ndef json_response(obj: Any) -> str:\n    \"\"\"Serializes an object to a JSON string.\"\"\"\n    return json.dumps(obj, indent=2)\n\n# src/next_smallest_app/models.py\nfrom typing import List, Optional\nfrom pydantic import BaseModel\n\nclass InputListDTO(BaseModel):\n    \"\"\"Data transfer object for input list.\"\"\"\n    values: List[int]\n\nclass ResultDTO(BaseModel):\n    \"\"\"Data transfer object for result and optional error.\"\"\"\n    result: Optional[int]\n    error: Optional[str] = None\n\n# src/next_smallest_app/validators.py\nfrom typing import Any, List\n\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input.\"\"\"\n    pass\n\nclass ListValidator:\n    \"\"\"Validates and normalizes input into a list of integers.\"\"\"\n    def validate(self, values: Any) -> List[int]:\n        if values is None:\n            return []\n        if not isinstance(values, (list, tuple)):\n            raise InvalidInputError(\"Input must be a list or tuple of integers.\")\n        \n        out = []\n        for i, v in enumerate(values):\n            if not isinstance(v, int):\n                raise InvalidInputError(f\"Element at index {i} is not an integer.\")\n            out.append(v)\n        return out\n\n    def ensure_list_like(self, values: Any) -> List[Any]:\n        \"\"\"Ensures the input is list-like, primarily for CLI parsing flexibility.\"\"\"\n        if isinstance(values, str):\n            try:\n                # Attempt JSON parsing first\n                parsed = json.loads(values)\n                if isinstance(parsed, (list, tuple)):\n                    return list(parsed)\n            except json.JSONDecodeError:\n                # Fallback to space-separated parsing\n                return parse_int_list(values)\n        elif isinstance(values, (list, tuple)):\n            return list(values)\n        \n        raise InvalidInputError(\"Input must be a JSON list, space-separated integers, or a Python list.\")\n\n\n# src/next_smallest_app/services.py\nfrom typing import List, Optional, Iterable\n\nclass NextSmallestService:\n    \"\"\"Core business logic for finding the second smallest integer.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def next_smallest(self, values: List[int]) -> Optional[int]:\n        \"\"\"\n        Public API to compute the second smallest distinct integer.\n        Assumes input is already validated as List[int].\n        \"\"\"\n        if not values: # Empty list\n            return None\n        return self._two_smallest(values)\n\n    def _two_smallest(self, values: Iterable[int]) -> Optional[int]:\n        \"\"\"\n        Efficiently finds the second smallest distinct integer in an iterable.\n        Handles duplicates, negatives, and various list lengths.\n        \"\"\"\n        first = None\n        second = None\n        seen = set()\n\n        for v in values:\n            if v in seen:\n                continue\n            seen.add(v)\n\n            if first is None or v < first:\n                second = first\n                first = v\n            elif second is None or v < second:\n                second = v\n        return second\n\n# migrations/0001_create_history_table.sql\n# SQL to create the history table.\n# CREATE TABLE IF NOT EXISTS history (\n#   id INTEGER PRIMARY KEY AUTOINCREMENT,\n#   input_json TEXT NOT NULL,\n#   result INTEGER NULL,\n#   created_at TIMESTAMP NOT NULL DEFAULT (datetime('now'))\n# );\n# CREATE INDEX IF NOT EXISTS idx_history_created_at ON history(created_at DESC);\n\n\n# src/next_smallest_app/repositories.py\nimport sqlite3\nimport os\nfrom typing import Optional, List, Tuple\nfrom src.next_smallest_app.config import Config\nfrom src.next_smallest_app.utils import get_logger\n\nlogger = get_logger()\n\nclass RepositoryError(Exception):\n    \"\"\"Custom exception for repository-related errors.\"\"\"\n    pass\n\nclass HistoryRepository:\n    \"\"\"Manages persistence of request history to SQLite.\"\"\"\n    def __init__(self, db_path: str = Config.DB_PATH) -> None:\n        self._db_path = db_path\n        self._ensure_db_directory()\n        self._apply_migrations()\n\n    def _ensure_db_directory(self) -> None:\n        \"\"\"Ensures the directory for the SQLite database exists.\"\"\"\n        db_dir = os.path.dirname(self._db_path)\n        if db_dir and not os.path.exists(db_dir):\n            os.makedirs(db_dir, exist_ok=True)\n\n    def _connect(self) -> sqlite3.Connection:\n        \"\"\"Establishes and returns a database connection.\"\"\"\n        conn = sqlite3.connect(self._db_path, check_same_thread=False)\n        conn.row_factory = sqlite3.Row # Allows column access by name\n        return conn\n\n    def _apply_migrations(self) -> None:\n        \"\"\"Applies necessary database schema migrations.\"\"\"\n        migration_sql_path = os.path.join(\n            os.path.dirname(os.path.abspath(__file__)),\n            \"../../migrations/0001_create_history_table.sql\"\n        )\n        try:\n            with open(migration_sql_path, 'r', encoding=\"utf-8\") as f:\n                sql_script = f.read()\n            conn = self._connect()\n            cursor = conn.cursor()\n            cursor.executescript(sql_script)\n            conn.commit()\n            conn.close()\n            logger.info(f\"Migrations applied successfully to {self._db_path}.\")\n        except Exception as e:\n            logger.error(f\"Failed to apply database migrations: {e}\", exc_info=True)\n            # This is critical, but we might allow the app to run in read-only mode if persistence is best-effort.\n\n    def save_record(self, input_json: str, result: Optional[int]) -> None:\n        \"\"\"Saves a request record to the history table.\"\"\"\n        try:\n            conn = self._connect()\n            cursor = conn.cursor()\n            cursor.execute(\n                \"INSERT INTO history (input_json, result) VALUES (?, ?)\",\n                (input_json, result)\n            )\n            conn.commit()\n            conn.close()\n            logger.debug(\"History record saved.\")\n        except Exception as e:\n            logger.error(f\"Failed to save history record: {e}\", exc_info=True)\n            # Persistence is best-effort, so we log and continue.\n\n    def list_recent(self, limit: int = 100) -> List[Tuple[int, str, Optional[int], str]]:\n        \"\"\"Retrieves recent history records.\"\"\"\n        try:\n            conn = self._connect()\n            cursor = conn.cursor()\n            cursor.execute(\n                \"SELECT id, input_json, result, created_at FROM history ORDER BY created_at DESC LIMIT ?\",\n                (limit,)\n            )\n            records = [tuple(row) for row in cursor.fetchall()]\n            conn.close()\n            return records\n        except Exception as e:\n            logger.error(f\"Failed to list recent history records: {e}\", exc_info=True)\n            raise RepositoryError(\"Could not retrieve history records.\") from e\n\n\n# src/next_smallest_app/controllers.py\nimport argparse\nimport sys\nimport json\nfrom typing import List, Optional\n\nfrom src.next_smallest_app.services import NextSmallestService\nfrom src.next_smallest_app.repositories import HistoryRepository, RepositoryError\nfrom src.next_smallest_app.validators import ListValidator, InvalidInputError\nfrom src.next_smallest_app.models import InputListDTO, ResultDTO\nfrom src.next_smallest_app.utils import get_logger, json_response\nfrom src.next_smallest_app.config import Config\n\nlogger = get_logger()\n\nclass CLIController:\n    \"\"\"Handles command-line interface interactions.\"\"\"\n    def __init__(self, service: NextSmallestService, repo: HistoryRepository) -> None:\n        self.service = service\n        self.repo = repo\n        self.validator = ListValidator()\n\n    def handle(self, argv: List[str]) -> int:\n        \"\"\"Parses CLI arguments, computes, persists, and prints results.\"\"\"\n        parser = argparse.ArgumentParser(\n            description=\"Finds the 2nd smallest integer in a list.\",\n            prog=\"next-smallest\"\n        )\n        parser.add_argument(\n            \"values\",\n            nargs=\"*\",\n            help=\"Space-separated integers, or a JSON string like '[1,2,3]' (use --json flag).\"\n        )\n        parser.add_argument(\n            \"--json\",\n            action=\"store_true\",\n            help=\"Treats 'values' argument as a single JSON string input.\"\n        )\n        parser.add_argument(\n            \"--history\",\n            action=\"store_true\",\n            help=\"List recent history records.\"\n        )\n\n        args = parser.parse_args(argv[1:])\n\n        if args.history:\n            return self._handle_history()\n\n        input_str = ' '.join(args.values) if args.values else sys.stdin.read().strip()\n        \n        if not input_str:\n            print(json_response(ResultDTO(result=None, error=\"No input provided.\")))\n            return 2\n        \n        try:\n            if args.json:\n                raw_values = json.loads(input_str)\n            else:\n                raw_values = self.validator.ensure_list_like(input_str) # Handles space-separated or JSON\n            \n            validated_values = self.validator.validate(raw_values)\n            result = self.service.next_smallest(validated_values)\n            \n            self.repo.save_record(json.dumps(raw_values), result)\n            print(json_response(ResultDTO(result=result, error=None)))\n            return 0\n        except json.JSONDecodeError as e:\n            print(json_response(ResultDTO(result=None, error=f\"Invalid JSON input: {e}\")))\n            return 2\n        except InvalidInputError as e:\n            print(json_response(ResultDTO(result=None, error=str(e))))\n            return 2\n        except Exception as e:\n            logger.exception(\"An unexpected error occurred during CLI execution.\")\n            print(json_response(ResultDTO(result=None, error=f\"An internal error occurred: {e}\")))\n            return 1\n    \n    def _handle_history(self) -> int:\n        \"\"\"Handles the history listing command.\"\"\"\n        try:\n            records = self.repo.list_recent()\n            output = []\n            for rec_id, input_json, result, created_at in records:\n                output.append({\n                    \"id\": rec_id,\n                    \"input\": json.loads(input_json),\n                    \"result\": result,\n                    \"created_at\": created_at\n                })\n            print(json_response(output))\n            return 0\n        except RepositoryError as e:\n            print(json_response(ResultDTO(result=None, error=f\"Failed to retrieve history: {e}\")))\n            return 1\n        except Exception as e:\n            logger.exception(\"An unexpected error occurred while listing history.\")\n            print(json_response(ResultDTO(result=None, error=f\"An internal error occurred: {e}\")))\n            return 1\n\n\nclass APIController:\n    \"\"\"Handles HTTP API requests for the /next-smallest endpoint.\"\"\"\n    def __init__(self, service: NextSmallestService, repo: HistoryRepository) -> None:\n        self.service = service\n        self.repo = repo\n        self.validator = ListValidator()\n\n    def post_next_smallest(self, payload: InputListDTO) -> ResultDTO:\n        \"\"\"Processes POST requests to find the second smallest value.\"\"\"\n        try:\n            validated_values = self.validator.validate(payload.values)\n            result = self.service.next_smallest(validated_values)\n            \n            self.repo.save_record(json.dumps(payload.values), result)\n            return ResultDTO(result=result, error=None)\n        except InvalidInputError as e:\n            logger.warning(f\"API Bad Request: {e}\")\n            from fastapi import HTTPException # Lazy import to avoid circular dependency\n            raise HTTPException(status_code=400, detail=str(e))\n        except Exception as e:\n            logger.exception(\"An unexpected error occurred during API request processing.\")\n            from fastapi import HTTPException\n            raise HTTPException(status_code=500, detail=\"Internal server error.\")\n\n\n# src/next_smallest_app/api.py\nfrom fastapi import FastAPI, Depends, status\nfrom typing import Optional\n\nfrom src.next_smallest_app.controllers import APIController\nfrom src.next_smallest_app.services import NextSmallestService\nfrom src.next_smallest_app.repositories import HistoryRepository\nfrom src.next_smallest_app.models import InputListDTO, ResultDTO\nfrom src.next_smallest_app.utils import setup_logging, get_logger\nfrom src.next_smallest_app.config import Config\n\nlogger = get_logger()\n\n# Dependency Injection for components\ndef get_service() -> NextSmallestService:\n    \"\"\"Dependency provider for NextSmallestService.\"\"\"\n    return NextSmallestService()\n\ndef get_repository() -> HistoryRepository:\n    \"\"\"Dependency provider for HistoryRepository.\"\"\"\n    return HistoryRepository(db_path=Config.DB_PATH)\n\ndef get_api_controller(\n    service: NextSmallestService = Depends(get_service),\n    repo: HistoryRepository = Depends(get_repository)\n) -> APIController:\n    \"\"\"Dependency provider for APIController.\"\"\"\n    return APIController(service, repo)\n\ndef create_app() -> FastAPI:\n    \"\"\"Creates and configures the FastAPI application.\"\"\"\n    setup_logging(Config.LOG_LEVEL)\n    app = FastAPI(\n        title=\"Next Smallest API\",\n        description=\"API to find the 2nd smallest integer in a list.\",\n        version=\"0.1.0\"\n    )\n\n    @app.post(\n        f\"{Config.API_PREFIX}/next-smallest\",\n        response_model=ResultDTO,\n        status_code=status.HTTP_200_OK,\n        summary=\"Find the 2nd smallest integer\",\n        response_description=\"The 2nd smallest integer or null if not found.\"\n    )\n    async def post_next_smallest_endpoint(\n        payload: InputListDTO,\n        controller: APIController = Depends(get_api_controller)\n    ) -> ResultDTO:\n        \"\"\"\n        Accepts a list of integers and returns the 2nd smallest distinct integer.\n        Returns null if the list is empty, has only one distinct element, or fewer than two.\n        \"\"\"\n        return controller.post_next_smallest(payload)\n    \n    logger.info(f\"FastAPI app created. Log level: {Config.LOG_LEVEL}\")\n    return app\n\n# src/next_smallest_app/__init__.py\nfrom typing import List, Optional\nfrom src.next_smallest_app.services import NextSmallestService\nfrom src.next_smallest_app.validators import ListValidator, InvalidInputError\n\n__all__ = [\"next_smallest\"]\n\ndef next_smallest(values: List[int]) -> Optional[int]:\n    \"\"\"\n    Top-level function to find the 2nd smallest distinct integer in a list.\n    Delegates to NextSmallestService after input validation.\n    \"\"\"\n    validator = ListValidator()\n    try:\n        validated_values = validator.validate(values)\n    except InvalidInputError as e:\n        # As per FR2, propagate ValueError for non-list or non-integer elements\n        raise ValueError(f\"Invalid input for next_smallest: {e}\") from e\n    \n    service = NextSmallestService()\n    return service.next_smallest(validated_values)\n\n# src/next_smallest_app/main.py\nimport sys\nfrom src.next_smallest_app.controllers import CLIController\nfrom src.next_smallest_app.services import NextSmallestService\nfrom src.next_smallest_app.repositories import HistoryRepository\nfrom src.next_smallest_app.utils import setup_logging\nfrom src.next_smallest_app.config import Config\n\nCLI_USAGE = \"\"\"\nUsage: next-smallest [integers...] [--json \"JSON_LIST\"] [--history]\nFinds the 2nd smallest integer in a list.\nExample: next-smallest 5 1 4 3 2\nExample: next-smallest --json \"[5, 1, 4, 3, 2]\"\nExample: next-smallest --history\n\"\"\"\n\ndef run_cli(argv: Optional[List[str]] = None) -> int:\n    \"\"\"Entry point for the command-line interface.\"\"\"\n    setup_logging(Config.LOG_LEVEL)\n    if argv is None:\n        argv = sys.argv\n    \n    service = NextSmallestService()\n    repo = HistoryRepository(db_path=Config.DB_PATH)\n    controller = CLIController(service, repo)\n    \n    return controller.handle(argv)\n\nif __name__ == \"__main__\":\n    sys.exit(run_cli())\n\n# pyproject.toml\n# [tool.poetry] # Using poetry for simplicity, can be setuptools as well\n# name = \"next-smallest-app\"\n# version = \"0.1.0\"\n# description = \"Finds the 2nd smallest integer in a list with CLI and HTTP API.\"\n# authors = [\"Your Name <your.email@example.com>\"]\n# readme = \"README.md\"\n# packages = [{include = \"next_smallest_app\", from = \"src\"}]\n#\n# [tool.poetry.dependencies]\n# python = \">=3.9,<4.0\"\n# fastapi = \"^0.111.0\"\n# uvicorn = {extras = [\"standard\"], version = \"^0.30.1\"}\n# pydantic = \"^2.7.4\"\n#\n# [tool.poetry.group.dev.dependencies]\n# pytest = \"^8.2.2\"\n# black = \"^24.4.2\"\n# flake8 = \"^7.1.0\"\n#\n# [tool.poetry.scripts]\n# next-smallest = \"next_smallest_app.main:run_cli\"\n#\n# [build-system]\n# requires = [\"poetry-core\"] # For poetry\n# build-backend = \"poetry.core.masonry.api\"\n\n# README.md\n# # Next Smallest Integer Application\n#\n# This application finds the 2nd smallest distinct integer in a list, offering both a Command-Line Interface (CLI) and an HTTP API. It also records request history for auditing.\n#\n# ## Features\n# - **Core Logic**: Efficiently finds the 2nd smallest distinct integer (O(n) time, O(k) memory where k is unique elements).\n# - **CLI Access**: `next-smallest` command for direct use.\n# - **HTTP API**: `POST /api/v1/next-smallest` endpoint.\n# - **Persistence**: SQLite-based history logging of requests and results.\n# - **Robustness**: Input validation, error handling, and logging.\n#\n# ## Installation\n# 1. Clone the repository:\n#    ```bash\n#    git clone <repository-url>\n#    cd next-smallest-app\n#    ```\n# 2. Install dependencies (using poetry as an example):\n#    ```bash\n#    pip install poetry\n#    poetry install\n#    ```\n#    Or with pip:\n#    ```bash\n#    pip install -e .\n#    ```\n#\n# ## Usage\n#\n# ### CLI\n#\n# ```bash\n# # With space-separated integers\n# next-smallest 5 1 4 3 2\n# # Output: {\"result\": 2, \"error\": null}\n#\n# # With JSON string