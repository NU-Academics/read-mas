{"task_id": "HumanEval/113", "solution": "def odd_count(lst):\n    \"\"\"Given a list of digit-only strings, returns a list of formatted sentences.\n    Each sentence reports the count of odd digits in the corresponding input string.\n    \"\"\"\n    results = []\n    odd_digits = {'1', '3', '5', '7', '9'}\n    template = \"the number of odd elements in the string i of the input.\"\n\n    for s in lst:\n        odd_digit_count = 0\n        for char in s:\n            if char in odd_digits:\n                odd_digit_count += 1\n        \n        replacement_str = str(odd_digit_count)\n        formatted_string = template.replace('i', replacement_str)\n        results.append(formatted_string)\n        \n    return results"}
{"task_id": "HumanEval/112", "solution": "def reverse_delete(s, c):\n    \"\"\"\n    Deletes characters from s that appear in c, then checks if the resulting string is a palindrome.\n    Character removal and palindrome check are case-sensitive by default.\n    \"\"\"\n\n    def _filter_chars_internal(s_to_filter: str, c_to_remove: str) -> str:\n        \"\"\"Removes all characters from s_to_filter that appear in c_to_remove.\"\"\"\n        remove_set = set(c_to_remove)\n        return ''.join(ch for ch in s_to_filter if ch not in remove_set)\n\n    def _is_palindrome_internal(text: str) -> bool:\n        \"\"\"Checks if a string is a palindrome; an empty string is considered a palindrome.\"\"\"\n        return text == text[::-1]\n\n    filtered_s = _filter_chars_internal(s, c)\n    is_pal = _is_palindrome_internal(filtered_s)\n\n    return (filtered_s, is_pal)"}
{"task_id": "HumanEval/113", "solution": "```python\ndef odd_count(lst):\n    \"\"\"Given a list of digit strings, count odd digits in each and format a sentence.\n    The template uses '{N}' placeholders which are replaced by the odd digit count.\n    \"\"\"\n    results = []\n    template_sentence = \"the number of odd elements {N}n the str{N}ng {N} of the {N}nput.\"\n\n    for s in lst:\n        n_odd = sum(1 for char_digit in s if int(char_digit) % 2 == 1)\n        \n        formatted_sentence = template_sentence.replace(\"{N}\", str(n_odd))\n        results.append(formatted_sentence)\n    \n    return results\n```"}
{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums):\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty sub-array.\n    This uses a Kadane-like algorithm adapted for minimum sum.\n    \"\"\"\n    min_so_far = nums[0]\n    current_min = nums[0]\n\n    for i in range(1, len(nums)):\n        # If extending the current subarray sum results in a smaller sum, continue it.\n        # Otherwise, start a new subarray from the current number.\n        current_min = min(nums[i], current_min + nums[i])\n        # Update the overall minimum sum found so far.\n        min_so_far = min(min_so_far, current_min)\n        \n    return min_so_far"}
{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums):\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty sub-array.\n    This uses Kadane's algorithm adapted for minimum sum.\n    \"\"\"\n    running_min = global_min = nums[0]\n    for x in nums[1:]:\n        running_min = min(x, running_min + x)\n        global_min = min(global_min, running_min)\n    return global_min"}
{"task_id": "HumanEval/115", "solution": "```python\nimport math\n\ndef max_fill(grid, capacity):\n    \"\"\"\n    Computes the minimum number of bucket lowerings to empty a grid of wells.\n    Each '1' in the grid is a unit of water; buckets have a given capacity.\n    \"\"\"\n    total_units = 0\n    for row in grid:\n        total_units += sum(row)\n\n    if total_units == 0:\n        return 0\n    \n    return math.ceil(total_units / capacity)\n```"}
{"task_id": "HumanEval/115", "solution": "import math\n\ndef max_fill(grid, capacity):\n    \"\"\"\n    Computes the total bucket-lowering operations to empty all wells.\n    Each row is a well, 1s are water units; capacity is uniform.\n    \"\"\"\n    total_lowers = 0\n    for row in grid:\n        units_in_row = sum(row)\n        # Calculate ceiling division for lowers. This formula correctly handles units_in_row = 0.\n        lowers_for_row = (units_in_row + capacity - 1) // capacity\n        total_lowers += lowers_for_row\n    return total_lowers"}
{"task_id": "HumanEval/116", "solution": "```python\ndef sort_array(arr):\n    \"\"\"\n    Sorts an array of integers based on the number of set bits, then numeric value.\n    If all elements are negative, a simple numeric sort is performed.\n    \"\"\"\n\n    def _popcount(n: int) -> int:\n        \"\"\"Counts the number of set bits in the absolute value of an integer.\"\"\"\n        x = abs(n)\n        return x.bit_count() if hasattr(x, \"bit_count\") else bin(x).count(\"1\")\n\n    if not arr:\n        return []\n\n    if all(v < 0 for v in arr):\n        return sorted(arr)\n\n    return sorted(arr, key=lambda v: (_popcount(v), v))\n```"}
{"task_id": "HumanEval/116", "solution": "```python\ndef sort_array(arr):\n    \"\"\"\n    Sorts an array of integers by the number of 1 bits in their binary representation (primary)\n    and by decimal value (secondary). Handles all-negative arrays as a special case.\n    \"\"\"\n    if not arr:\n        return []\n\n    all_negatives = True\n    for x in arr:\n        if x >= 0:\n            all_negatives = False\n            break\n\n    if all_negatives:\n        return sorted(arr)\n    else:\n        return sorted(arr, key=lambda n: (abs(n).bit_count(), n))\n```"}
{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"Given a string s and a natural number n, this function returns a list of words from s\n    that contain exactly n consonants, preserving their original order.\n    \"\"\"\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n    processed_words = []\n    \n    trimmed_s = s.strip()\n    if not trimmed_s:\n        return []\n\n    words = trimmed_s.split()\n\n    for word in words:\n        consonant_count = 0\n        for char in word:\n            lower_char = char.lower()\n            if lower_char not in VOWELS:\n                consonant_count += 1\n        \n        if consonant_count == n:\n            processed_words.append(word)\n            \n    return processed_words"}
{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"Returns words from string s that contain exactly n consonants.\n    Vowels are a, e, i, o, u (case-insensitive); 'y' is a consonant.\n    \"\"\"\n    vowels = {'a', 'e', 'i', 'o', 'u'}\n    result_words = []\n\n    words = s.split()\n\n    for word in words:\n        consonant_count = 0\n        for char in word:\n            char_lower = char.lower()\n            if char_lower.isalpha():\n                if char_lower not in vowels:\n                    consonant_count += 1\n        \n        if consonant_count == n:\n            result_words.append(word)\n\n    return result_words"}
{"task_id": "HumanEval/118", "solution": "VOWELS = {\"a\", \"e\", \"i\", \"o\", \"u\", \"A\", \"E\", \"I\", \"O\", \"U\"}\n\ndef get_closest_vowel(word):\n    \"\"\"You are given a word. Your task is to find the closest vowel that stands between \n    two consonants from the right side of the word (case sensitive).\n    \n    Vowels in the beginning and ending doesn't count. Return empty string if you didn't\n    find any vowel met the above condition. \n\n    You may assume that the given string contains English letter only.\n\n    Example:\n    get_closest_vowel(\"yogurt\") ==> \"u\"\n    get_closest_vowel(\"FULL\") ==> \"U\"\n    get_closest_vowel(\"quick\") ==> \"\"\n    get_closest_vowel(\"ab\") ==> \"\"\n    \"\"\"\n    n = len(word)\n    if n < 3:\n        return \"\"\n\n    for i in range(n - 2, 0, -1):\n        char = word[i]\n        if char in VOWELS:\n            left_char = word[i - 1]\n            right_char = word[i + 1]\n            \n            if left_char not in VOWELS and right_char not in VOWELS:\n                return char\n                \n    return \"\""}
{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"Finds the closest vowel that stands between two consonants from the right side of the word (case sensitive).\n    Vowels at the word's beginning or end do not count.\n    \"\"\"\n    VOWELS = \"aeiouAEIOU\"\n\n    def is_vowel(char):\n        return char in VOWELS\n\n    # Assumes input string contains English letters only, so non-vowels are consonants.\n    def is_consonant(char):\n        return not is_vowel(char)\n\n    n = len(word)\n    # Scan from the second to last character (index n-2) down to the second character (index 1).\n    # This range excludes the first (index 0) and last (index n-1) characters as per rules.\n    for i in range(n - 2, 0, -1):\n        char = word[i]\n        if is_vowel(char):\n            # Check if the preceding and following characters are consonants.\n            if is_consonant(word[i-1]) and is_consonant(word[i+1]):\n                return char\n    return \"\""}
{"task_id": "HumanEval/119", "solution": "```python\ndef match_parens(lst):\n    \"\"\"\n    Checks if two parenthesis-only strings can be concatenated in any order\n    to form a balanced parentheses string.\n    \"\"\"\n    def is_balanced(seq: str) -> bool:\n        \"\"\"\n        Determines if a string of parentheses is balanced.\n        A balanced string has a final balance of zero and no negative intermediate balance.\n        \"\"\"\n        balance = 0\n        for char in seq:\n            if char == '(':\n                balance += 1\n            else:\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    s1, s2 = lst[0], lst[1]\n\n    # Check concatenation order s1 + s2\n    if is_balanced(s1 + s2):\n        return 'Yes'\n\n    # Check concatenation order s2 + s1\n    if is_balanced(s2 + s1):\n        return 'Yes'\n\n    return 'No'\n```"}
{"task_id": "HumanEval/119", "solution": "import datetime\nimport json\nimport pathlib\nimport sys\nimport argparse\nfrom typing import List, Optional\n\nclass InvalidInputError(Exception):\n    \"\"\"Exception raised for invalid inputs.\n    It includes a human-readable message.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass ParenthesisPair:\n    \"\"\"Encapsulates the two input strings for matching.\n    It validates that exactly two strings are provided.\"\"\"\n    def __init__(self, inputs: List[str]) -> None:\n        if len(inputs) != 2:\n            raise InvalidInputError(\"Exactly two strings required\")\n        self.inputs: List[str] = inputs\n\nclass BalanceStats:\n    \"\"\"Stores computed metrics for a parenthesis string.\"\"\"\n    def __init__(self, total: int, min_prefix: int) -> None:\n        self.total = total\n        self.min_prefix = min_prefix\n\nclass MatchResult:\n    \"\"\"Conveys the result of a match attempt.\n    It includes the outcome, the successful order, and an optional reason.\"\"\"\n    def __init__(self, result: str, order: Optional[str], reason: Optional[str]) -> None:\n        self.result = result\n        self.order = order\n        self.reason = reason\n\ndef is_valid_parenthesis_string(s: str) -> bool:\n    \"\"\"Checks if a string contains only parenthesis characters.\"\"\"\n    return all(c in '()' for c in s)\n\ndef compute_balance_stats(s: str) -> BalanceStats:\n    \"\"\"Computes balance statistics for a parenthesis string.\"\"\"\n    bal = 0\n    min_pref = 0\n    for ch in s:\n        bal += 1 if ch == '(' else -1\n        min_pref = min(min_pref, bal)\n    return BalanceStats(total=bal, min_prefix=min_pref)\n\nclass MatcherService:\n    \"\"\"Core algorithm to determine if concatenation yields balanced parentheses.\"\"\"\n    def can_match(self, pair: ParenthesisPair) -> MatchResult:\n        \"\"\"Validates inputs, checks concatenation orders, and produces MatchResult.\"\"\"\n        a, b = pair.inputs\n        if not is_valid_parenthesis_string(a) or not is_valid_parenthesis_string(b):\n            raise InvalidInputError(\"Inputs must contain only '(' and ')' characters\")\n\n        if self._is_good_concat(a, b):\n            return MatchResult(\"Yes\", \"a+b\", None)\n        if self._is_good_concat(b, a):\n            return MatchResult(\"Yes\", \"b+a\", None)\n        \n        return MatchResult(\"No\", None, \"Neither concatenation is balanced\")\n\n    def _is_good_concat(self, a: str, b: str) -> bool:\n        \"\"\"Efficiently tests if concatenation a+b results in a balanced string.\"\"\"\n        bal = 0\n        for ch in (a + b):\n            bal += 1 if ch == '(' else -1\n            if bal < 0:\n                return False\n        return bal == 0\n\ndef match_parens(lst: List[str]) -> str:\n    \"\"\"Checks if two parenthesis-only strings can be concatenated to form a balanced string.\"\"\"\n    svc = MatcherService()\n    res = svc.can_match(ParenthesisPair(lst))\n    return res.result\n\nclass HistoryRepository:\n    \"\"\"Handles optional local JSON persistence of history.\n    It provides atomic append operations to avoid data corruption.\"\"\"\n    def __init__(self, path: pathlib.Path):\n        self.path = path\n        self.path.parent.mkdir(parents=True, exist_ok=True)\n        if not self.path.exists():\n            self.path.write_text(\"[]\", encoding=\"utf-8\")\n\n    def append(self, record: dict) -> None:\n        \"\"\"Appends a record to the history file atomically.\"\"\"\n        tmp_path = self.path.with_suffix('.tmp')\n        data = []\n        if self.path.exists():\n            try:\n                data = json.loads(self.path.read_text(encoding='utf-8'))\n            except json.JSONDecodeError:\n                # If file is corrupt, start with empty history for new append\n                pass \n        \n        data.append(record)\n        tmp_path.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding='utf-8')\n        tmp_path.replace(self.path)\n\n    def read_all(self) -> List[dict]:\n        \"\"\"Reads all records from the history file.\"\"\"\n        if not self.path.exists():\n            return []\n        try:\n            return json.loads(self.path.read_text(encoding='utf-8'))\n        except json.JSONDecodeError:\n            return []\n\nclass CLIController:\n    \"\"\"Orchestrates validation, service call, output, and optional persistence for CLI.\n    It manages the interaction between the MatcherService and HistoryRepository.\"\"\"\n    def __init__(self, history_repo: Optional[HistoryRepository] = None):\n        self.service = MatcherService()\n        self.history_repo = history_repo\n\n    def run(self, str1: str, str2: str, persist: bool = False, strict: bool = False) -> int:\n        \"\"\"Executes the CLI logic, prints result to stdout, and optionally persists history.\n        Returns an exit code: 0 for success, 2 for invalid input, 3 for strict persistence failure.\"\"\"\n        try:\n            pair = ParenthesisPair([str1, str2])\n            result = self.service.can_match(pair)\n            print(result.result)\n\n            if persist and self.history_repo:\n                record = {\n                    \"timestamp\": datetime.datetime.utcnow().isoformat() + \"Z\",\n                    \"inputs\": [str1, str2],\n                    \"successful_order\": result.order,\n                    \"result\": result.result,\n                    \"notes\": result.reason\n                }\n                try:\n                    self.history_repo.append(record)\n                except Exception as exc:\n                    print(f\"Warning: failed to persist history: {exc}\", file=sys.stderr)\n                    if strict:\n                        return 3\n            return 0\n        except InvalidInputError as e:\n            print(f\"Invalid input: {e.message}\", file=sys.stderr)\n            return 2\n\ndef main(argv: Optional[List[str]] = None) -> int:\n    \"\"\"Entry point for the command-line interface.\"\"\"\n    argv = argv if argv is not None else sys.argv[1:]\n    \n    parser = argparse.ArgumentParser(\n        prog=\"paren-match\",\n        description=\"Check if two parenthesis strings can form a balanced string.\"\n    )\n    parser.add_argument(\"str1\", help=\"First string of parentheses\")\n    parser.add_argument(\"str2\", help=\"Second string of parentheses\")\n    parser.add_argument(\n        \"--history\",\n        type=str,\n        default=None,\n        help=\"Path to a JSON file to store evaluation history.\"\n    )\n    parser.add_argument(\n        \"--strict\",\n        action=\"store_true\",\n        help=\"Return non-zero exit code if history persistence fails.\"\n    )\n    args = parser.parse_args(argv)\n\n    repo = HistoryRepository(pathlib.Path(args.history)) if args.history else None\n    controller = CLIController(repo)\n    return controller.run(args.str1, args.str2, persist=bool(args.history), strict=args.strict)"}
