# cd vowel-counter\n\n# Install with Poetry\npoetry install\n\n# Or install with pip\npip install .\n```\n\n## Usage\n\n### Command-Line Interface (CLI)\n\nTo count vowels for a word:\n\n```bash\nvowel-counter count hello\n# Output: 2\n\nvowel-counter count sky\n# Output: 1\n\nvowel-counter count rhythm\n# Output: 0\n\nvowel-counter count \"happy days\"\n# Output: 3 (counts 'a','y','a')\n```\n\nStatistics are enabled by default and stored in `~/.vowel_counter/vowel_stats.json`.\n\n### Python Library\n\n```python\nfrom vowel_counter import vowels_count, VowelCounter\nfrom vowel_counter.repository import JSONStatsRepository\nfrom pathlib import Path\nimport os\n\n# --- Using the simple function ---\ncount = vowels_count(\"example\")\nprint(f\"Count for 'example': {count}\") # Output: 3\n\n# --- Using the VowelCounter service (without persistence) ---\ncounter = VowelCounter()\nresult = counter.count(\"university\")\nprint(f\"Count for '{result.word}': {result.count}\") # Output: 5\n\n# --- Using the VowelCounter service (with persistence) ---\n# Create a custom path for stats, e.g., in a temporary directory\nstats_dir = Path(os.path.expanduser(\"~/.vowel_counter\"))\nstats_dir.mkdir(parents=True, exist_ok=True)\nrepo = JSONStatsRepository(path=stats_dir / \"my_stats.json\")\npersistent_counter = VowelCounter(repository=repo)\n\npersistent_counter.count(\"apple\")\npersistent_counter.count(\"orange\")\npersistent_counter.count(\"apple\") # This will increment 'times_seen' for \"apple\"\n\n# To inspect the stats:\nprint(repo.load())\n```\n\n## Development\n\nRun tests: (Note: tests are not included in this code generation based on instructions)\n```bash\npoetry run pytest\n```\n```\n\n---\n\n**`LICENSE`**\n```\nMIT License\n\nCopyright (c) 2023 Your Name\n\nPermission is hereby granted, free of charge, to any person obtaining a copy\nof this software and associated documentation files (the \"Software\"), to deal\nin the Software without restriction, including without limitation the rights\nto use, copy, modify, merge, publish, distribute, sublicense, and/or sell\ncopies of the Software, and to permit persons to whom the Software is\nfurnished to do so, subject to the following conditions:\n\nThe above copyright notice and this permission notice shall be included in all\ncopies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\nIMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\nFITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\nAUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\nLIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\nOUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\nSOFTWARE.\n```\n\n---\n\n**`src/vowel_counter/__init__.py`**\n```python\n\"\"\"Vowel Counter library and CLI.\"\"\"\n\nfrom .core import VowelCounter, vowels_count\n\n__all__ = [\"vowels_count\", \"VowelCounter\"]\n```\n\n---\n\n**`src/vowel_counter/core.py`**\n```python\n\"\"\"Core vowel counting logic and VowelCounter service.\"\"\"\n\nimport logging\nfrom datetime import datetime\nfrom typing import Optional\n\nfrom .models import CountResult\nfrom .repository import StatsRepository\n\n# Configure logging for the module\nlogger = logging.getLogger(__name__)\n# Avoid duplicate handlers if a root handler is already configured\nif not logger.handlers:\n    logging.basicConfig(level=logging.INFO)\n\n\nVOWELS = frozenset({'a', 'e', 'i', 'o', 'u'})\n\n\ndef vowels_count(s: str) -> int:\n    \"\"\"Counts vowels 'a','e','i','o','u' case-insensitively and 'y' only if at end.\n\n    Example:\n    >>> vowels_count(\"abcde\")\n    2\n    >>> vowels_count(\"ACEDY\")\n    3\n    \"\"\"\n    word = s.strip()\n    length = len(word)\n    count = 0\n    for i, ch in enumerate(word):\n        lower = ch.casefold()\n        if lower in VOWELS:\n            count += 1\n        elif lower == 'y' and i == length - 1:\n            count += 1\n    return count\n\n\nclass VowelCounter:\n    \"\"\"A service class to count vowels, with optional persistence.\"\"\"\n\n    def __init__(self, repository: Optional[StatsRepository] = None) -> None:\n        \"\"\"Initialize the VowelCounter with an optional StatsRepository.\"\"\"\n        self._repository = repository\n\n    def count(self, word: str) -> CountResult:\n        \"\"\"Counts vowels in the given word and optionally persists statistics.\n\n        Raises TypeError if word is not a string.\n        \"\"\"\n        if not isinstance(word, str):\n            raise TypeError(\"Input 'word' must be a string.\")\n\n        cnt = vowels_count(word)\n        current_time_iso = datetime.utcnow().isoformat(timespec='seconds') + \"Z\"\n        result = CountResult(word=word.strip(), count=cnt, timestamp_iso=current_time_iso)\n\n        if self._repository:\n            try:\n                self._repository.update(result)\n            except Exception as e:\n                logger.warning(f\"Failed to update statistics repository for word '{word}': {e}\")\n        return result\n\n```\n\n---\n\n**`src/vowel_counter/models.py`**\n```python\n\"\"\"Data transfer objects (DTOs) for vowel counting results.\"\"\"\n\nfrom dataclasses import dataclass\nfrom typing import Dict, Any\n\n\n@dataclass(frozen=True)\nclass CountResult:\n    \"\"\"Represents the result of a vowel counting operation.\"\"\"\n    word: str\n    count: int\n    timestamp_iso: str  # ISO 8601 UTC timestamp\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Returns a serializable dictionary representation of the result.\"\"\"\n        return {\n            \"word\": self.word,\n            \"count\": self.count,\n            \"timestamp_iso\": self.timestamp_iso,\n        }\n```\n\n---\n\n**`src/vowel_counter/repository.py`**\n```python\n\"\"\"Persistence adapter for usage statistics.\"\"\"\n\nimport json\nimport logging\nimport os\nimport pathlib\nimport threading\nimport time\nfrom typing import Dict, Protocol, Any, TYPE_CHECKING\n\nif TYPE_CHECKING:\n    from .models import CountResult\n\nlogger = logging.getLogger(__name__)\nif not logger.handlers:\n    logging.basicConfig(level=logging.INFO)\n\nDEFAULT_STATS_FILENAME = \"vowel_stats.json\"\n\n\nclass StatsRepository(Protocol):\n    \"\"\"Protocol for a statistics repository.\"\"\"\n\n    def update(self, result: \"CountResult\") -> None:\n        \"\"\"Updates the statistics with a new count result.\"\"\"\n        ...\n\n    def load(self) -> Dict[str, Any]:\n        \"\"\"Loads all stored statistics.\"\"\"\n        ...\n\n\nclass JSONStatsRepository:\n    \"\"\"Persistence adapter for usage statistics using a local JSON file.\"\"\"\n\n    def __init__(self, path: pathlib.Path) -> None:\n        \"\"\"Initialize the JSONStatsRepository.\n\n        Args:\n            path: The path to the JSON file where statistics will be stored.\n        \"\"\"\n        self.path = path\n        self.lock = threading.Lock()\n        self.path.parent.mkdir(parents=True, exist_ok=True)  # Ensure directory exists\n\n    def update(self, result: \"CountResult\") -> None:\n        \"\"\"Updates the statistics for a word in the JSON file.\n\n        The operation is atomic using a temporary file and rename.\n        \"\"\"\n        with self.lock:\n            data = self.load()\n            word_key = result.word  # Use original word for key\n            entry = data.get(word_key, {\"last_count\": 0, \"times_seen\": 0})\n\n            entry[\"last_count\"] = result.count\n            entry[\"times_seen\"] = entry.get(\"times_seen\", 0) + 1\n            entry[\"last_seen_iso\"] = result.timestamp_iso\n            data[word_key] = entry\n            self._atomic_write(data)\n\n    def load(self) -> Dict[str, Any]:\n        \"\"\"Loads all stored statistics from the JSON file.\"\"\"\n        if not self.path.exists():\n            return {}\n        try:\n            with self.path.open(\"r\", encoding=\"utf-8\") as f:\n                return json.load(f)\n        except json.JSONDecodeError as e:\n            logger.warning(f\"Error decoding JSON stats file '{self.path}': {e}. Returning empty stats.\")\n            return {}\n        except IOError as e:\n            logger.warning(f\"Error reading JSON stats file '{self.path}': {e}. Returning empty stats.\")\n            return {}\n\n    def _atomic_write(self, data: Dict[str, Any]) -> None:\n        \"\"\"Writes data to the JSON file atomically.\"\"\"\n        temp_path = self.path.with_suffix(f\".tmp_{os.getpid()}_{int(time.time())}\")\n        try:\n            with temp_path.open(\"w\", encoding=\"utf-8\") as f:\n                json.dump(data, f, indent=2, ensure_ascii=False)\n            os.replace(temp_path, self.path)  # Atomic rename\n        except IOError as e:\n            logger.error(f\"Failed to write stats atomically to '{self.path}': {e}\")\n            if temp_path.exists():\n                os.remove(temp_path)\n        except Exception as e:\n            logger.error(f\"An unexpected error occurred during atomic write to '{self.path}': {e}\")\n            if temp_path.exists():\n                os.remove(temp_path)\n\n```\n\n---\n\n**`src/vowel_counter/cli.py`**\n```python\n\"\"\"CLI entrypoint and argument parsing for the vowel counter.\"\"\"\n\nimport argparse\nimport logging\nimport os\nimport pathlib\nimport sys\nfrom typing import List, Optional\n\nfrom .core import VowelCounter\nfrom .repository import JSONStatsRepository, DEFAULT_STATS_FILENAME, StatsRepository\n\nlogger = logging.getLogger(__name__)\nif not logger.handlers:\n    logging.basicConfig(level=logging.INFO, format='%(levelname)s: %(message)s')\n\n\nclass CLIController:\n    \"\"\"Handles command-line interface operations.\"\"\"\n\n    def __init__(self, repository: Optional[StatsRepository] = None) -> None:\n        \"\"\"Initializes the CLIController with an optional repository.\"\"\"\n        self._repository = repository\n        self._vowel_counter = VowelCounter(repository=self._repository)\n\n    def _get_default_repo(self) -> JSONStatsRepository:\n        \"\"\"Configures and returns the default JSON stats repository.\"\"\"\n        stats_dir = pathlib.Path(os.path.expanduser(\"~/.vowel_counter\"))\n        return JSONStatsRepository(path=stats_dir / DEFAULT_STATS_FILENAME)\n\n    def main(self, argv: Optional[List[str]] = None) -> int:\n        \"\"\"Main entry point for the CLI application.\n\n        Args:\n            argv: Optional list of arguments (defaults to sys.argv[1:]).\n\n        Returns:\n            An exit code (0 for success, 1 for unexpected errors, 2 for bad arguments).\n        \"\"\"\n        parser = argparse.ArgumentParser(\n            prog=\"vowel-counter\",\n            description=\"Count vowels in a word.\",\n            formatter_class=argparse.RawTextHelpFormatter\n        )\n\n        subparsers = parser.add_subparsers(dest=\"command\", help=\"Available commands\")\n\n        count_parser = subparsers.add_parser(\n            \"count\",\n            help=\"Count vowels in a single word.\",\n            description=\"\"\"Count vowels in a word.\nVowels are 'a', 'e', 'i', 'o', 'u' (case-insensitive).\n'y' is counted only if it is the last character of the word.\nLeading/trailing whitespace is trimmed.\"\"\"\n        )\n        count_parser.add_argument(\n            \"word\",\n            type=str,\n            help=\"The word to count vowels in.\"\n        )\n\n        args = parser.parse_args(argv)\n\n        if args.command == \"count\":\n            try:\n                # If repository not explicitly provided, use default\n                if self._repository is None:\n                    self._repository = self._get_default_repo()\n                    self._vowel_counter = VowelCounter(repository=self._repository)\n\n                result = self._vowel_counter.count(args.word)\n                print(result.count)\n                return 0\n            except TypeError as e:\n                logger.error(f\"Error: {e}\")\n                return 2\n            except Exception as e:\n                logger.error(f\"An unexpected error occurred: {e}\")\n                return 1\n        else:\n            parser.print_help()\n            return 2\n\n\ndef main(argv: Optional[List[str]] = None) -> int:\n    \"\"\"Top-level main function for the CLI entrypoint.\"\"\"\n    controller = CLIController()\n    return controller.main(argv)\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n```"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Write a function vowels_count which takes a string representing\n    a word as input and returns the number of vowels in the string.\n    Vowels in this case are 'a', 'e', 'i', 'o', 'u'. Here, 'y' is also a\n    vowel, but only when it is at the end of the given word.\n\n    Example:\n    >>> vowels_count(\"abcde\")\n    2\n    >>> vowels_count(\"ACEDY\")\n    3\n    \"\"\"\n    normalized_s = s.lower()\n    count = 0\n    basic_vowels = {'a', 'e', 'i', 'o', 'u'}\n\n    for char in normalized_s:\n        if char in basic_vowels:\n            count += 1\n    \n    if normalized_s and normalized_s[-1] == 'y':\n        count += 1\n        \n    return count"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    >>> circular_shift(12, 1)\n    \"21\"\n    >>> circular_shift(12, 2)\n    \"12\"\n    \"\"\"\n    s_x = str(x)\n    n = len(s_x)\n\n    if shift > n:\n        return s_x[::-1]\n    \n    effective_shift = shift % n\n    shifted_s_x = s_x[-effective_shift:] + s_x[:-effective_shift]\n    \n    return shifted_s_x"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"Computes the sum of ASCII codes for uppercase letters in a string.\n    Only 'A' through 'Z' characters contribute to the sum.\n    \"\"\"\n    total = 0\n    for ch in s:\n        if 'A' <= ch <= 'Z':\n            total += ord(ch)\n    return total"}
{"task_id": "HumanEval/66", "solution": "```python\ndef digitSum(s):\n    \"\"\"Calculates the sum of ASCII codes for uppercase characters (A-Z) in a string.\n    Only ASCII uppercase letters are considered; non-ASCII characters are ignored.\n    \"\"\"\n    total = 0\n    for ch in s:\n        if 'A' <= ch <= 'Z':\n            total += ord(ch)\n    return total\n```"}
{"task_id": "HumanEval/65", "solution": "```python\n# Create the directory structure first (this will be represented by comments)\n\n# \u251c\u2500\u2500 src/\n# \u2502   \u2514\u2500\u2500 circular_shift_app/\n# \u2502       \u251c\u2500\u2500 __init__.py\n# \u2502       \u251c\u2500\u2500 config.py\n# \u2502       \u251c\u2500\u2500 models.py\n# \u2502       \u251c\u2500\u2500 utils.py\n# \u2502       \u251c\u2500\u2500 validators.py\n# \u2502       \u251c\u2500\u2500 services.py\n# \u2502       \u251c\u2500\u2500 repository.py\n# \u2502       \u251c\u2500\u2500 controllers.py\n# \u2502       \u251c\u2500\u2500 api.py\n# \u2502       \u251c\u2500\u2500 cli.py\n# \u2502       \u2514\u2500\u2500 logging_config.py\n# \u251c\u2500\u2500 scripts/\n# \u2502   \u2514\u2500\u2500 migrate.sql\n# \u251c\u2500\u2500 pyproject.toml\n# \u251c\u2500\u2500 requirements.txt\n# \u2514\u2500\u2500 README.md\n\n\n# File: pyproject.toml\n# Content:\n# ```toml\n# [project]\n# name = \"circular-shift-app\"\n# version = \"0.1.0\"\n# description = \"A reusable library and service for circular digit shifting.\"\n# authors = [{ name = \"Your Name\", email = \"your.email@example.com\" }]\n# readme = \"README.md\"\n# requires-python = \">=3.9\"\n# dependencies = [\n#     \"fastapi\",\n#     \"uvicorn\",\n#     \"pydantic\",\n#     \"python-dotenv\", # for loading .env config\n# ]\n\n# [project.scripts]\n# cshift = \"circular_shift_app.cli:main\"\n\n# [project.optional-dependencies]\n# dev = [\n#     \"pytest\",\n#     \"flake8\",\n#     \"black\",\n#     \"isort\",\n# ]\n\n# [build-system]\n# requires = [\"setuptools>=61.0\"]\n# build-backend = \"setuptools.build_meta\"\n# ```\n\n# File: requirements.txt\n# Content:\n# ```\n# fastapi\n# uvicorn\n# pydantic\n# python-dotenv\n# ```\n\n# File: README.md\n# Content:\n# ```markdown\n# # Circular Shift Application\n\n# This project provides a reusable library and service to perform a circular digit shift of an integer. It offers programmatic, CLI, and HTTP API access, with optional operation history persistence.\n\n# ## Features\n\n# - **Library Function**: `circular_shift_app.services.CircularShiftService.circular_shift(x, shift)`\n# - **CLI Tool**: `cshift <x> <shift>`\n# - **HTTP API**: `POST /shift`\n# - **Persistence**: Optional history logging to SQLite.\n\n# ## Installation\n\n# 1. **Clone the repository**:\n#    ```bash\n#    git clone https://github.com/your-repo/circular-shift-app.git\n#    cd circular-shift-app\n#    ```\n\n# 2. **Create a virtual environment and install dependencies**:\n#    ```bash\n#    python -m venv .venv\n#    source .venv/bin/activate  # On Windows: .venv\\Scripts\\activate\n#    pip install -e .\n#    ```\n#    For development dependencies:\n#    ```bash\n#    pip install -e \".[dev]\"\n#    ```\n\n# ## Configuration\n\n# Configuration can be managed via environment variables or by editing `src/circular_shift_app/config.py`.\n# You can create a `.env` file in the project root:\n\n# ```\n# DB_PATH=./data/history.db\n# PERSISTENCE_ENABLED=True\n# LOG_LEVEL=INFO\n# ```\n\n# ## Usage\n\n# ### Python Library\n\n# ```python\n# from circular_shift_app.services import CircularShiftService\n# from circular_shift_app.validators import InputValidator\n# from circular_shift_app.repository import HistoryRepository\n# from circular_shift_app.config import DB_PATH, PERSISTENCE_ENABLED\n\n# validator = InputValidator()\n# repo = HistoryRepository(DB_PATH) if PERSISTENCE_ENABLED else None\n# service = CircularShiftService(validator, repo)\n\n# result = service.circular_shift(12345, 2)\n# print(f\"Shifted result: {result}\") # Expected: 45123\n\n# result_reversed = service.circular_shift(12, 5)\n# print(f\"Reversed result: {result_reversed}\") # Expected: 21\n# ```\n\n# ### CLI\n\n# ```bash\n# cshift 123 1\n# # Output: 312\n\n# cshift -456 2\n# # Output: -645\n\n# cshift 12 5\n# # Output: 21\n# ```\n\n# ### HTTP API\n\n# 1. **Run the API server**:\n#    ```bash\n#    uvicorn circular_shift_app.api:create_app --host 0.0.0.0 --port 8000\n#    ```\n\n# 2. **Make a POST request**:\n#    ```bash\n#    curl -X POST http://localhost:8000/shift \\\n#         -H \"Content-Type: application/json\" \\\n#         -d '{\"x\": 12345, \"shift\": 2}'\n#    # Expected Output: {\"result\": \"45123\"}\n#    ```\n\n#    ```bash\n#    curl -X POST http://localhost:8000/shift \\\n#         -H \"Content-Type: application/json\" \\\n#         -d '{\"x\": -123, \"shift\": 1}'\n#    # Expected Output: {\"result\": \"-312\"}\n#    ```\n\n#    **Error Handling**:\n#    ```bash\n#    curl -X POST http://localhost:8000/shift \\\n#         -H \"Content-Type: application/json\" \\\n#         -d '{\"x\": \"abc\", \"shift\": 1}'\n#    # Expected Output (400 Bad Request): {\"detail\": \"x must be integer-like; got 'abc'\"}\n#    ```\n\n# ## Development\n\n# ### Running Tests\n\n# ```bash\n# pytest tests/\n# ```\n\n# ### Database Migration\n\n# The SQLite database schema is automatically created/updated on application start via `ensure_schema()`.\n# The schema is defined in `scripts/migrate.sql`.\n\n# ```sql\n# -- scripts/migrate.sql\n# CREATE TABLE IF NOT EXISTS operations (\n#   id INTEGER PRIMARY KEY AUTOINCREMENT,\n#   input_value INTEGER NOT NULL,\n#   shift INTEGER NOT NULL,\n#   result TEXT NOT NULL,\n#   created_at TEXT NOT NULL\n# );\n# CREATE INDEX IF NOT EXISTS idx_operations_created_at ON operations (created_at DESC);\n# ```\n# ```\n\n# File: scripts/migrate.sql\n# Content:\n# ```sql\n# CREATE TABLE IF NOT EXISTS operations (\n#   id INTEGER PRIMARY KEY AUTOINCREMENT,\n#   input_value INTEGER NOT NULL,\n#   shift INTEGER NOT NULL,\n#   result TEXT NOT NULL,\n#   created_at TEXT NOT NULL\n# );\n# CREATE INDEX IF NOT EXISTS idx_operations_created_at ON operations (created_at DESC);\n# ```\n\n# File: src/circular_shift_app/__init__.py\n# Content:\n\"\"\"Circular Shift Application package.\"\"\"\n\n__version__ = \"0.1.0\"\n# ```\n\n# File: src/circular_shift_app/logging_config.py\n# Content:\nimport logging\nimport sys\n\ndef configure_logging(level: str) -> None:\n    \"\"\"Configures application logging.\"\"\"\n    log_level = getattr(logging, level.upper(), logging.INFO)\n    logging.basicConfig(\n        level=log_level,\n        format='%(asctime)s - %(name)s - %(levelname)s - %(message)s',\n        handlers=[logging.StreamHandler(sys.stdout)]\n    )\n# ```\n\n# File: src/circular_shift_app/config.py\n# Content:\nimport os\nfrom dotenv import load_dotenv\n\nload_dotenv() # Load environment variables from .env file\n\nDB_PATH: str = os.getenv(\"DB_PATH\", \"./data/history.db\")\nPERSISTENCE_ENABLED: bool = os.getenv(\"PERSISTENCE_ENABLED\", \"True\").lower() == \"true\"\nLOG_LEVEL: str = os.getenv(\"LOG_LEVEL\", \"INFO\")\n# ```\n\n# File: src/circular_shift_app/models.py\n# Content:\nfrom datetime import datetime\nfrom typing import Any\n\nclass ShiftRequest:\n    \"\"\"Data transfer object for a shift request.\"\"\"\n    def __init__(self, x: int, shift: int):\n        self.x: int = x\n        self.shift: int = shift\n        self.sign: str = '-' if x < 0 else '+'\n\nclass ShiftResult:\n    \"\"\"Data transfer object for a shift operation result.\"\"\"\n    def __init__(self, original: ShiftRequest, result: str):\n        self.original: ShiftRequest = original\n        self.result: str = result\n        self.timestamp: datetime = datetime.now()\n\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input data.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\nclass PersistenceError(Exception):\n    \"\"\"Exception raised for database persistence failures.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n# ```\n\n# File: src/circular_shift_app/utils.py\n# Content:\ndef digits_of(x: int) -> str:\n    \"\"\"Returns the absolute digits of an integer as a string.\"\"\"\n    n = abs(x)\n    return str(n)\n\ndef rotate_right(digits: str, shift: int) -> str:\n    \"\"\"Performs a right circular rotation on a string of digits.\"\"\"\n    if not digits:\n        return digits\n    s = shift % len(digits)\n    if s == 0:\n        return digits\n    return digits[-s:] + digits[:-s]\n\ndef reverse_digits(digits: str) -> str:\n    \"\"\"Reverses a string of digits.\"\"\"\n    return digits[::-1]\n\ndef format_result(sign: str, digits: str) -> str:\n    \"\"\"Combines a sign and digits string into the final result.\"\"\"\n    return ('-' if sign == '-' else '') + digits\n# ```\n\n# File: src/circular_shift_app/validators.py\n# Content:\nfrom typing import Any\nfrom .models import ShiftRequest, ValidationError\n\nclass InputValidator:\n    \"\"\"Validates and coerces inputs for the circular shift operation.\"\"\"\n    def validate(self, x: Any, shift: Any) -> ShiftRequest:\n        \"\"\"Coerces inputs to integers and validates shift value.\"\"\"\n        try:\n            xi = int(x)\n        except (ValueError, TypeError) as e:\n            raise ValidationError(f\"x must be integer-like; got {x!r}\") from e\n\n        try:\n            si = int(shift)\n        except (ValueError, TypeError) as e:\n            raise ValidationError(f\"shift must be integer-like; got {shift!r}\") from e\n\n        if si < 0:\n            raise ValidationError(\"shift must be >= 0\")\n\n        return ShiftRequest(x=xi, shift=si)\n# ```\n\n# File: src/circular_shift_app/repository.py\n# Content:\nimport sqlite3\nimport logging\nimport os\nfrom typing import List, Dict, Any\nfrom .models import ShiftRequest, ShiftResult, PersistenceError\n\nlogger = logging.getLogger(__name__)\n\nclass HistoryRepository:\n    \"\"\"Manages persistence of operation history in a SQLite database.\"\"\"\n    def __init__(self, db_path: str):\n        self.db_path = db_path\n        self._ensure_data_dir()\n        self.ensure_schema()\n\n    def _ensure_data_dir(self):\n        \"\"\"Ensures the directory for the database file exists.\"\"\"\n        data_dir = os.path.dirname(self.db_path)\n        if data_dir and not os.path.exists(data_dir):\n            os.makedirs(data_dir)\n\n    def _get_connection(self) -> sqlite3.Connection:\n        \"\"\"Establishes and returns a SQLite database connection.\"\"\"\n        conn = sqlite3.connect(self.db_path)\n        conn.row_factory = sqlite3.Row # Allows accessing columns by name\n        return conn\n\n    def ensure_schema(self) -> None:\n        \"\"\"Creates the 'operations' table if it does not exist.\"\"\"\n        try:\n            with self._get_connection() as conn:\n                cursor = conn.cursor()\n                # Read SQL from migrate.sql or directly define\n                schema_sql = \"\"\"\n                CREATE TABLE IF NOT EXISTS operations (\n                  id INTEGER PRIMARY KEY AUTOINCREMENT,\n                  input_value INTEGER NOT NULL,\n                  shift INTEGER NOT NULL,\n                  result TEXT NOT NULL,\n                  created_at TEXT NOT NULL\n                );\n                CREATE INDEX IF NOT EXISTS idx_operations_created_at ON operations (created_at DESC);\n                \"\"\"\n                cursor.executescript(schema_sql)\n                conn.commit()\n            logger.info(\"Database schema ensured for %s\", self.db_path)\n        except sqlite3.Error as e:\n            logger.error(\"Error ensuring database schema: %s\", e)\n            raise PersistenceError(f\"Failed to ensure DB schema: {e}\") from e\n\n    def save(self, request: ShiftRequest, result: ShiftResult) -> int:\n        \"\"\"Saves a circular shift operation record to the database.\"\"\"\n        try:\n            with self._get_connection() as conn:\n                cursor = conn.cursor()\n                cursor.execute(\n                    \"INSERT INTO operations (input_value, shift, result, created_at) VALUES (?, ?, ?, ?)\",\n                    (request.x, request.shift, result.result, result.timestamp.isoformat())\n                )\n                conn.commit()\n                return cursor.lastrowid\n        except sqlite3.Error as e:\n            logger.warning(\"Failed to save operation history: %s\", e)\n            raise PersistenceError(f\"Failed to save operation history: {e}\") from e\n\n    def get_recent(self, limit: int = 100) -> List[Dict[str, Any]]:\n        \"\"\"Retrieves recent operation history records.\"\"\"\n        try:\n            with self._get_connection() as conn:\n                cursor = conn.cursor()\n                cursor.execute(\n                    \"SELECT id, input_value, shift, result, created_at FROM operations ORDER BY created_at DESC LIMIT ?\",\n                    (limit,)\n                )\n                return [dict(row) for row in cursor.fetchall()]\n        except sqlite3.Error as e:\n            logger.error(\"Failed to retrieve recent operation history: %s\", e)\n            raise PersistenceError(f\"Failed to retrieve recent history: {e}\") from e\n# ```\n\n# File: src/circular_shift_app/services.py\n# Content:\nimport logging\nfrom .models import ShiftRequest, ShiftResult, ValidationError, PersistenceError\nfrom .utils import digits_of, rotate_right, reverse_digits, format_result\nfrom .validators import InputValidator\nfrom .repository import HistoryRepository\nfrom .config import PERSISTENCE_ENABLED\n\nlogger = logging.getLogger(__name__)\n\nclass CircularShiftService:\n    \"\"\"Core business logic for circular digit shifting with optional persistence.\"\"\"\n    def __init__(self, validator: InputValidator, repo: HistoryRepository | None = None):\n        self.validator = validator\n        self.repo = repo\n\n    def circular_shift(self, x: int, shift: int) -> str:\n        \"\"\"Performs a circular digit shift for external library use.\"\"\"\n        request = self.validator.validate(x, shift)\n        result = self.process(request)\n        return result.result\n\n    def process(self, request: ShiftRequest) -> ShiftResult:\n        \"\"\"Applies rotation/reverse rules and handles optional persistence.\"\"\"\n        digits = digits_of(request.x)\n        \n        if request.shift <= len(digits):\n            # Calculate effective shift to handle cases where shift is a multiple of length\n            effective_shift = request.shift % len(digits)\n            result_digits = rotate_right(digits, effective_shift)\n        else:\n            result_digits = reverse_digits(digits)\n        \n        final_result_str = format_result(request.sign, result_digits)\n        result = ShiftResult(request, final_result_str)\n\n        if self.repo is not None and PERSISTENCE_ENABLED:\n            try:\n                self.repo.save(request, result)\n                logger.debug(\"Operation history saved for x=%s, shift=%s\", request.x, request.shift)\n            except PersistenceError:\n                logger.warning(\"Failed to persist operation history for x=%s, shift=%s. Continuing without persistence.\",\n                               request.x, request.shift, exc_info=True)\n        return result\n# ```\n\n# File: src/circular_shift_app/controllers.py\n# Content:\nimport argparse\nimport sys\nimport logging\nfrom typing import List\nfrom fastapi import FastAPI, HTTPException, Request, status\nfrom pydantic import BaseModel\nfrom .services import CircularShiftService\nfrom .models import ValidationError, ShiftRequest\n\nlogger = logging.getLogger(__name__)\n\nclass ShiftPayload(BaseModel):\n    \"\"\"Pydantic model for HTTP request body validation.\"\"\"\n    x: int\n    shift: int\n\nclass CLIController:\n    \"\"\"Handles command-line interface interactions.\"\"\"\n    def __init__(self, service: CircularShiftService):\n        self.service = service\n\n    def run(self, argv: List[str]) -> int:\n        \"\"\"Parses arguments, executes shift, and prints result.\"\"\"\n        parser = argparse.ArgumentParser(\n            description=\"Perform a circular digit shift of an integer.\"\n        )\n        parser.add_argument(\"x\", type=str, help=\"The integer to shift (e.g., 123, -45)\")\n        parser.add_argument(\"shift\", type=str, help=\"The number of positions to shift right (non-negative integer)\")\n\n        try:\n            args = parser.parse_args(argv)\n            \n            # The service's validator will handle coercion and validation\n            result_str = self.service.circular_shift(args.x, args.shift)\n            print(result_str)\n            return 0\n        except ValidationError as e:\n            logger.error(\"CLI Input Error: %s\", e.message)\n            print(f\"Error: {e.message}\", file=sys.stderr)\n            return 1\n        except Exception as e:\n            logger.exception(\"An unexpected error occurred during CLI execution.\")\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1\n\nclass APIController:\n    \"\"\"Manages FastAPI routes for the circular shift functionality.\"\"\"\n    def __init__(self, service: CircularShiftService):\n        self.service = service\n\n    def create_routes(self, app: FastAPI) -> None:\n        \"\"\"Registers the /shift POST endpoint with the FastAPI application.\"\"\"\n        @app.post(\"/shift\", status_code=status.HTTP_200_OK)\n        async def shift_endpoint(request_data: ShiftPayload):\n            \"\"\"HTTP endpoint to perform a circular digit shift.\"\"\"\n            try:\n                result = self.service.circular_shift(request_data.x, request_data.shift)\n                return {\"result\": result}\n            except ValidationError as e:\n                logger.warning(\"API Validation Error: %s for x=%s, shift=%s\", e.message, request_data.x, request_data.shift)\n                raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=e.message) from e\n            except Exception as e:\n                logger.exception(\"An unexpected error occurred in /shift endpoint for x=%s, shift=%s\", request_data.x, request_data.shift)\n                raise HTTPException(status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=\"Internal server error\") from e\n# ```\n\n# File: src/circular_shift_app/api.py\n# Content:\nimport logging\nfrom fastapi import FastAPI\nfrom .config import DB_PATH, PERSISTENCE_ENABLED, LOG_LEVEL\nfrom .logging_config import configure_logging\nfrom .validators import InputValidator\nfrom .repository import HistoryRepository\nfrom .services import CircularShiftService\nfrom .controllers import APIController\n\nlogger = logging.getLogger(__name__)\n\ndef create_app() -> FastAPI:\n    \"\"\"Creates and configures the FastAPI application.\"\"\"\n    configure_logging(LOG_LEVEL)\n    logger.info(\"Starting FastAPI application...\")\n\n    app = FastAPI(\n        title=\"Circular Shift API\",\n        description=\"API for performing circular digit shifts of integers.\",\n        version=\"0.1.0\",\n    )\n\n    validator = InputValidator()\n    \n    repo = None\n    if PERSISTENCE_ENABLED:\n        try:\n            repo = HistoryRepository(DB_PATH)\n            logger.info(\"Persistence enabled. DB path: %s\", DB_PATH)\n        except Exception as e:\n            logger.error(\"Failed to initialize HistoryRepository, persistence will be disabled: %s\", e)\n            repo = None\n    else:\n        logger.info(\"Persistence is disabled by configuration.\")\n\n    service = CircularShiftService(validator, repo)\n    controller = APIController(service)\n    controller.create_routes(app)\n\n    logger.info(\"FastAPI application created successfully.\")\n    return app\n# ```\n\n# File: src/circular_shift_app/cli.py\n# Content:\nimport sys\nimport logging\nfrom typing import Optional, List\nfrom .config import DB_PATH, PERSISTENCE_ENABLED, LOG_LEVEL\nfrom .logging_config import configure_logging\nfrom .validators import InputValidator\nfrom .repository import HistoryRepository\nfrom .services import CircularShiftService\nfrom .controllers import CLIController\n\nlogger = logging.getLogger(__name__)\n\ndef main(argv: Optional[List[str]] = None) -> int:\n    \"\"\"Main entry point for the CLI application.\"\"\"\n    argv = argv if argv is not None else sys.argv[1:]\n    configure_logging(LOG_LEVEL)\n    logger.info(\"Starting CLI application.\")\n\n    validator = InputValidator()\n    \n    repo = None\n    if PERSISTENCE_ENABLED:\n        try:\n            repo = HistoryRepository(DB_PATH)\n            logger.info(\"Persistence enabled. DB path: %s\", DB_PATH)\n        except Exception as e:\n            logger.error(\"Failed to initialize HistoryRepository, persistence will be disabled: %s\", e)\n            repo = None\n    else:\n        logger.info(\"Persistence is disabled by configuration.\")\n\n    service = CircularShiftService(validator, repo)\n    controller = CLIController(service)\n    \n    exit_code = controller.run(argv)\n    logger.info(\"CLI application finished with exit code %d.\", exit_code)\n    return exit_code\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n# ```"}
{"task_id": "HumanEval/67", "solution": "```python\ndef fruit_distribution(s,n):\n    \"\"\"\n    Given a string of apple and orange counts and a total fruit count,\n    returns the number of mangoes.\n    \"\"\"\n    # Normalize the string to lowercase to handle case variations.\n    s_lower = s.lower()\n    \n    # Split the string at \" and \" to separate apple and orange descriptions.\n    # Example: \"5 apples and 6 oranges\" -> [\"5 apples\", \"6 oranges\"]\n    parts = s_lower.split(\" and \")\n    \n    # Extract the number of apples from the first part.\n    # It removes either \"apples\" or \"apple\" and strips whitespace before converting to int.\n    apples_part = parts[0]\n    if \"apples\" in apples_part:\n        apples_str = apples_part.replace(\"apples\", \"\").strip()\n    else:\n        apples_str = apples_part.replace(\"apple\", \"\").strip()\n    apples = int(apples_str)\n    \n    # Extract the number of oranges from the second part.\n    # It removes either \"oranges\" or \"orange\" and strips whitespace before converting to int.\n    oranges_part = parts[1]\n    if \"oranges\" in oranges_part:\n        oranges_str = oranges_part.replace(\"oranges\", \"\").strip()\n    else:\n        oranges_str = oranges_part.replace(\"orange\", \"\").strip()\n    oranges = int(oranges_str)\n    \n    # Calculate the number of mangoes by subtracting apples and oranges from the total.\n    return n - apples - oranges\n```"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even node and its earliest index in an array.\n    Returns [value, index] or [] if no even values are found.\n    \"\"\"\n    best_value = None\n    best_index = None\n\n    for idx, val in enumerate(arr):\n        if val % 2 == 0:  # Check if the value is even\n            if best_value is None or val < best_value:\n                best_value = val\n                best_index = idx\n\n    if best_value is None:\n        return []\n    else:\n        return [best_value, best_index]"}
{"task_id": "HumanEval/67", "solution": "```python\nimport os\nimport sys\nimport json\nimport re\nimport uuid\nimport datetime\nimport tempfile\nfrom typing import List, Dict, Any, Optional\n\n# --- src/fruit_distribution/config.py ---\nclass Config:\n    \"\"\"Central configuration for the application with defaults.\"\"\"\n    MAX_TOTAL: int = 1_000_000\n    HISTORY_PATH: str = os.path.join(os.getcwd(), \"history.json\")\n    PERSISTENCE_ENABLED: bool = True\n\n# --- src/fruit_distribution/exceptions.py ---\nclass InvalidInputError(Exception):\n    \"\"\"Exception for invalid input data.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\nclass PersistenceError(Exception):\n    \"\"\"Exception for persistence-related failures.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\n# --- src/fruit_distribution/models.py ---\nclass FruitCounts:\n    \"\"\"DTO for parsed apple and orange counts.\"\"\"\n    def __init__(self, apples: int, oranges: int):\n        self.apples = apples\n        self.oranges = oranges\n\n    def to_dict(self) -> Dict[str, int]:\n        \"\"\"Convert FruitCounts to a dictionary.\"\"\"\n        return {\"apples\": self.apples, \"oranges\": self.oranges}\n\nclass ComputationRecord:\n    \"\"\"Represents a persisted computation record.\"\"\"\n    def __init__(self, id: str, apples: int, oranges: int, mangoes: int, total: int, timestamp: str):\n        self.id = id\n        self.apples = apples\n        self.oranges = oranges\n        self.mangoes = mangoes\n        self.total = total\n        self.timestamp = timestamp\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Convert ComputationRecord to a dictionary.\"\"\"\n        return {\n            \"id\": self.id,\n            \"apples\": self.apples,\n            \"oranges\": self.oranges,\n            \"mangoes\": self.mangoes,\n            \"total\": self.total,\n            \"timestamp\": self.timestamp,\n        }\n\n    @classmethod\n    def from_dict(cls, data: Dict[str, Any]) -> \"ComputationRecord\":\n        \"\"\"Create a ComputationRecord from a dictionary.\"\"\"\n        return cls(\n            id=data[\"id\"],\n            apples=data[\"apples\"],\n            oranges=data[\"oranges\"],\n            mangoes=data[\"mangoes\"],\n            total=data[\"total\"],\n            timestamp=data[\"timestamp\"],\n        )\n\n# --- src/fruit_distribution/utils.py ---\nclass Utils:\n    \"\"\"Collection of static helper utilities.\"\"\"\n    @staticmethod\n    def generate_id() -> str:\n        \"\"\"Generates a UUID4 hex string.\"\"\"\n        return str(uuid.uuid4())\n\n    @staticmethod\n    def now_iso() -> str:\n        \"\"\"Returns current UTC ISO8601 timestamp.\"\"\"\n        return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='seconds').replace('+00:00', 'Z')\n\n    @staticmethod\n    def atomic_write(path: str, data: str) -> None:\n        \"\"\"Writes data to a file atomically using a temporary file.\"\"\"\n        dirname = os.path.dirname(path)\n        if dirname and not os.path.exists(dirname):\n            os.makedirs(dirname)\n        \n        # Use a temporary file in the same directory for atomic rename\n        with tempfile.NamedTemporaryFile(mode='w', encoding='utf-8', delete=False, dir=dirname) as tmp_file:\n            tmp_file.write(data)\n        \n        os.replace(tmp_file.name, path)\n\n# --- src/fruit_distribution/parser.py ---\nclass FruitParser:\n    \"\"\"Parses descriptive input strings to extract fruit counts.\"\"\"\n    def parse(self, description: str) -> FruitCounts:\n        \"\"\"Extracts apple and orange counts from a description string.\"\"\"\n        # Regex to capture two integers preceding \"apples\" and \"oranges\", case-insensitive.\n        m = re.search(r'(\\d+)\\s*apples?\\s*and\\s*(\\d+)\\s*oranges?', description, re.I)\n        if not m:\n            raise InvalidInputError(\"Description must be in format '<int> apples and <int> oranges'.\")\n        \n        apples_str, oranges_str = m.group(1), m.group(2)\n        \n        try:\n            apples = int(apples_str)\n            oranges = int(oranges_str)\n        except ValueError:\n            raise InvalidInputError(\"Counts must be valid integers.\")\n\n        if apples < 0 or oranges < 0:\n            raise InvalidInputError(\"Apple and orange counts cannot be negative.\")\n        \n        return FruitCounts(apples=apples, oranges=oranges)\n\n# --- src/fruit_distribution/repository.py ---\nclass FruitRepository:\n    \"\"\"Persists and lists computation records to a JSON file.\"\"\"\n    def __init__(self, path: str):\n        self.path = path\n\n    def _read_records(self) -> List[Dict[str, Any]]:\n        \"\"\"Reads all existing records from the JSON file.\"\"\"\n        if not os.path.exists(self.path):\n            return []\n        try:\n            with open(self.path, 'r', encoding='utf-8') as f:\n                content = f.read()\n                if not content:  # Handle empty file case\n                    return []\n                return json.loads(content)\n        except (json.JSONDecodeError, OSError) as e:\n            # If the file is corrupted or unreadable, treat it as empty or raise specific error\n            if isinstance(e, json.JSONDecodeError):\n                print(f\"Warning: History file '{self.path}' is corrupted. Starting fresh. Error: {e}\", file=sys.stderr)\n                return []\n            raise PersistenceError(f\"Failed to read history file '{self.path}': {e}\") from e\n\n    def save(self, record: ComputationRecord) -> None:\n        \"\"\"Appends a computation record to the history file atomically.\"\"\"\n        try:\n            records = self._read_records()\n            records.append(record.to_dict())\n            Utils.atomic_write(self.path, json.dumps(records, ensure_ascii=False, indent=2))\n        except (OSError, Exception) as e: # Catch all possible errors from _read_records or atomic_write\n            raise PersistenceError(f\"Failed to save record to '{self.path}': {e}\") from e\n\n    def list(self, limit: int = 100) -> List[ComputationRecord]:\n        \"\"\"Returns the last 'limit' records, ordered by timestamp descending.\"\"\"\n        try:\n            records_data = self._read_records()\n            # Sort by timestamp to ensure consistent ordering, though append should keep order.\n            # Convert to ComputationRecord instances for return.\n            records = [ComputationRecord.from_dict(r) for r in records_data]\n            # Assumes records are naturally ordered by timestamp due to append,\n            # but a proper sort would be by timestamp if it wasn't strictly append-only.\n            # For \"last `limit` records\", simply take the tail.\n            return records[-limit:][::-1] # Get last 'limit' and reverse to get latest first.\n        except (OSError, json.JSONDecodeError, PersistenceError) as e:\n            raise PersistenceError(f\"Failed to list records from '{self.path}': {e}\") from e\n\n# --- src/fruit_distribution/service.py ---\nclass FruitService:\n    \"\"\"Orchestrates parsing, validation, computation, and persistence.\"\"\"\n    def __init__(self, repo: FruitRepository, parser: FruitParser, config: Config):\n        self.repo = repo\n        self.parser = parser\n        self.config = config\n\n    def compute(self, description: str, total: int, persist: bool = True) -> int:\n        \"\"\"Computes the number of mangoes and optionally persists the record.\"\"\"\n        # 1. Validate total\n        if not isinstance(total, int) or total < 0 or total > self.config.MAX_TOTAL:\n            raise InvalidInputError(\n                f\"Total must be an integer between 0 and {self.config.MAX_TOTAL} (inclusive).\"\n            )\n\n        # 2. Parse description\n        counts = self.parser.parse(description)\n\n        # 3. Validate parsed counts\n        if counts.apples > self.config.MAX_TOTAL or counts.oranges > self.config.MAX_TOTAL:\n            raise InvalidInputError(\n                f\"Apple or orange counts cannot exceed {self.config.MAX_TOTAL}.\"\n            )\n\n        # 4. Compute mangoes\n        mangoes = total - counts.apples - counts.oranges\n\n        # 5. Validate computed mangoes\n        if mangoes < 0:\n            raise InvalidInputError(\n                f\"Inconsistent totals: computed mangoes count ({mangoes}) is negative.\"\n            )\n\n        # 6. Persist if enabled\n        record_id: Optional[str] = None\n        if persist and self.config.PERSISTENCE_ENABLED:\n            try:\n                record_id = Utils.generate_id()\n                record = ComputationRecord(\n                    id=record_id,\n                    apples=counts.apples,\n                    oranges=counts.oranges,\n                    mangoes=mangoes,\n                    total=total,\n                    timestamp=Utils.now_iso()\n                )\n                self.repo.save(record)\n            except PersistenceError as e:\n                # Wrap persistence errors for consistent handling by controllers\n                raise InvalidInputError(f\"Persistence error: {e.message}\") from e\n        \n        return mangoes\n\n# --- src/fruit_distribution/cli.py ---\nclass CLIController:\n    \"\"\"Handles CLI invocation, argument parsing, and output.\"\"\"\n    def __init__(self, service: FruitService, config: Config):\n        self.service = service\n        self.config = config\n\n    def run(self, argv: List[str]) -> int:\n        \"\"\"Parses CLI arguments, computes, prints result, and handles errors.\"\"\"\n        if len(argv) < 3:\n            print(\"Usage: fruit-distribution <description> <total> [--no-persist]\", file=sys.stderr)\n            print(\"Example: fruit-distribution \\\"5 apples and 6 oranges\\\" 19\", file=sys.stderr)\n            return 2 # Exit code for invalid usage\n\n        description = argv[1]\n        \n        try:\n            total = int(argv[2])\n        except ValueError:\n            print(\"Error: Total must be an integer.\", file=sys.stderr)\n            return 2\n\n        persist = True\n        if \"--no-persist\" in argv:\n            persist = False\n\n        try:\n            mangoes = self.service.compute(description, total, persist=persist)\n            print(f\"Mangoes: {mangoes}\")\n            return 0 # Success\n        except InvalidInputError as e:\n            print(f\"Error: {e.message}\", file=sys.stderr)\n            return 2 # Client-side error\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1 # Server-side or unhandled error\n\n# --- src/fruit_distribution/api.py ---\ntry:\n    from flask import Flask, request, jsonify\n    FLASK_INSTALLED = True\nexcept ImportError:\n    FLASK_INSTALLED = False\n    class Flask: # Dummy Flask for type hints if not installed\n        pass\n    class request:\n        json = {}\n        args = {}\n    def jsonify(*args, **kwargs):\n        pass\n\nclass ApiController:\n    \"\"\"Exposes a minimal Flask API for fruit distribution.\"\"\"\n    @staticmethod\n    def create_app(service: FruitService, config: Config) -> Flask:\n        \"\"\"Creates and configures a Flask application.\"\"\"\n        if not FLASK_INSTALLED:\n            raise RuntimeError(\"Flask is not installed. Please install it to use the API: pip install Flask\")\n\n        app = Flask(__name__)\n\n        @app.route(\"/v1/distribute\", methods=[\"POST\"])\n        def distribute():\n            \"\"\"API endpoint to compute mangoes.\"\"\"\n            data = request.get_json()\n            if not data:\n                return jsonify({\"error\": \"Request must be JSON\"}), 400\n\n            description = data.get(\"description\")\n            total = data.get(\"total\")\n            persist = data.get(\"persist\", True)\n\n            if not isinstance(description, str) or not description:\n                return jsonify({\"error\": \"Missing or invalid 'description' parameter.\"}), 400\n            if not isinstance(total, int):\n                return jsonify({\"error\": \"Missing or invalid 'total' parameter. Must be an integer.\"}), 400\n            if not isinstance(persist, bool):\n                return jsonify({\"error\": \"Invalid 'persist' parameter. Must be a boolean.\"}), 400\n\n            try:\n                mangoes = service.compute(description, total, persist=persist)\n                \n                # Fetch the record if persistence was enabled and successful, to return its ID and full details\n                record_info = {\"mangoes\": mangoes, \"apples\": None, \"oranges\": None, \"total\": total}\n                if persist and config.PERSISTENCE_ENABLED:\n                    # In a real scenario, the service.compute might return the created record ID or the record itself.\n                    # For this implementation, we re-parse description to get apples/oranges for the response.\n                    try:\n                        counts = service.parser.parse(description)\n                        record_info[\"apples\"] = counts.apples\n                        record_info[\"oranges\"] = counts.oranges\n                        # We don't have the actual record ID returned from compute currently, \n                        # so we omit it or assume client doesn't need it in this response.\n                        # For a full record return, compute would need to return the ComputationRecord or its dict.\n                        # For simplicity, based on design: \"return {\"mangoes\": int, ...}\", not necessarily the record ID.\n                    except InvalidInputError: # Should not happen if compute already succeeded\n                        pass\n\n                return jsonify(record_info), 200\n            except InvalidInputError as e:\n                return jsonify({\"error\": e.message}), 400\n            except Exception as e:\n                # Log the exception for debugging\n                return jsonify({\"error\": \"An internal server error occurred.\"}), 500\n\n        @app.route(\"/v1/history\", methods=[\"GET\"])\n        def history():\n            \"\"\"API endpoint to retrieve computation history.\"\"\"\n            if not config.PERSISTENCE_ENABLED:\n                return jsonify({\"error\": \"Persistence is not enabled.\"}), 400\n\n            limit_str = request.args.get(\"limit\", \"10\")\n            try:\n                limit = int(limit_str)\n                if limit < 1:\n                    raise ValueError(\"Limit must be positive.\")\n            except ValueError:\n                return jsonify({\"error\": \"Invalid 'limit' parameter. Must be a positive integer.\"}), 400\n\n            try:\n                records = service.repo.list(limit=limit)\n                return jsonify({\"records\": [r.to_dict() for r in records]}), 200\n            except PersistenceError as e:\n                return jsonify({\"error\": f\"Failed to retrieve history: {e.message}\"}), 500\n            except Exception as e:\n                return jsonify({\"error\": \"An internal server error occurred.\"}), 500\n\n        return app\n\n# --- src/fruit_distribution/__init__.py ---\n# Expose key components for package users\n__all__ = [\"FruitService\", \"CLIController\", \"ApiController\", \"Config\", \"InvalidInputError\", \"PersistenceError\"]\n\n# --- src/fruit_distribution/__main__.py ---\ndef main(argv: Optional[List[str]] = None) -> int:\n    \"\"\"Entry point for `python -m fruit_distribution`.\"\"\"\n    if argv is None:\n        argv = sys.argv[1:]\n\n    # Initialize dependencies\n    config = Config()\n    parser = FruitParser()\n    repository = FruitRepository(path=config.HISTORY_PATH)\n    service = FruitService(repo=repository,