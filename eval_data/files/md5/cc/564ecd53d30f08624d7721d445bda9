{"task_id": "HumanEval/73", "solution": "```python\n# src/palindrome_change/exceptions.py\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass PersistenceError(Exception):\n    \"\"\"Exception raised for persistence failures.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\n```\n```python\n# src/palindrome_change/utils.py\nimport uuid\nfrom datetime import datetime, timezone\n\ndef generate_id() -> str:\n    \"\"\"Generates a UUID4 hex string.\"\"\"\n    return uuid.uuid4().hex\n\ndef now_iso() -> str:\n    \"\"\"Returns current UTC timestamp in ISO8601 format.\"\"\"\n    return datetime.now(timezone.utc).isoformat(timespec='seconds') + 'Z'\n\n```\n```python\n# src/palindrome_change/config.py\nDEFAULT_HISTORY_PATH: str = \"history.json\"\nPERSISTENCE_ENABLED: bool = False\n\n```\n```python\n# src/palindrome_change/validators.py\nfrom typing import Sequence, Any, List\nfrom .exceptions import ValidationError\n\nclass InputValidator:\n    \"\"\"Validates and normalizes sequence inputs.\"\"\"\n    def validate_sequence_of_ints(self, arr: Sequence[Any]) -> List[int]:\n        if arr is None:\n            raise ValidationError(\"Input is None.\")\n        if not isinstance(arr, Sequence):\n            raise ValidationError(\"Input is not a sequence.\")\n        \n        result = []\n        for i, v in enumerate(arr):\n            if not isinstance(v, int):\n                # Explicitly disallow floats, even if they represent whole numbers.\n                if isinstance(v, float) and v == int(v):\n                    raise ValidationError(f\"Element at index {i} is a float ({v!r}), expected an int.\")\n                raise ValidationError(f\"Element at index {i} is not an int: {v!r}.\")\n            result.append(v)\n        return result\n\n```\n```python\n# src/palindrome_change/models.py\nfrom typing import Sequence, List\n\nclass ArrayModel:\n    \"\"\"Domain model for integer arrays.\"\"\"\n    def __init__(self, values: Sequence[int]) -> None:\n        # Assumes values are already validated as a sequence of integers upstream.\n        self._values: List[int] = list(values)\n\n    def to_list(self) -> List[int]:\n        \"\"\"Returns a shallow copy of the internal list.\"\"\"\n        return list(self._values)\n\n```\n```python\n# src/palindrome_change/calculator.py\nfrom typing import Sequence\n\nclass ChangeCalculator:\n    \"\"\"Computes the minimum changes for a palindromic array.\"\"\"\n    def compute(self, arr: Sequence[int]) -> int:\n        left = 0\n        right = len(arr) - 1\n        changes = 0\n        while left < right:\n            if arr[left] != arr[right]:\n                changes += 1\n            left += 1\n            right -= 1\n        return changes\n\n```\n```python\n# src/palindrome_change/repositories.py\nimport json\nimport os\nimport logging\nfrom typing import Dict, Any, List\nfrom .exceptions import PersistenceError\nfrom .config import DEFAULT_HISTORY_PATH\n\nlogger = logging.getLogger(__name__)\nlogger.addHandler(logging.NullHandler()) # Prevent \"No handlers could be found for logger\"\n\nclass FileRepository:\n    \"\"\"Persists and loads records from a JSON file using newline-delimited JSON.\"\"\"\n    def __init__(self, path: str = DEFAULT_HISTORY_PATH) -> None:\n        self._path = path\n\n    def save_record(self, record: Dict[str, Any]) -> None:\n        \"\"\"Appends a record (as a newline-delimited JSON object) to the history file.\"\"\"\n        try:\n            # Open in append mode, create file if it doesn't exist.\n            with open(self._path, 'a', encoding='utf-8') as f:\n                json.dump(record, f)\n                f.write('\\n')\n        except (IOError, OSError) as e:\n            raise PersistenceError(f\"Failed to append record to {self._path}: {e}\")\n\n    def load_all(self) -> List[Dict[str, Any]]:\n        \"\"\"Loads all records from the history file, treating each line as a JSON object.\"\"\"\n        if not os.path.exists(self._path):\n            return []\n        \n        records = []\n        try:\n            with open(self._path, 'r', encoding='utf-8') as f:\n                for line_num, line in enumerate(f, 1):\n                    line = line.strip()\n                    if line: # Ignore empty lines\n                        try:\n                            records.append(json.loads(line))\n                        except json.JSONDecodeError as e:\n                            logger.warning(f\"Skipping malformed JSON line {line_num} in {self._path}: {e}\")\n        except (IOError, OSError) as e:\n            raise PersistenceError(f\"Failed to load records from {self._path}: {e}\")\n        return records\n\n```\n```python\n# src/palindrome_change/services.py\nimport logging\nfrom typing import Sequence, Optional\nfrom .validators import InputValidator\nfrom .calculator import ChangeCalculator\nfrom .repositories import FileRepository\nfrom .utils import generate_id, now_iso\nfrom .exceptions import PersistenceError\n\nlogger = logging.getLogger(__name__)\nlogger.addHandler(logging.NullHandler())\n\nclass PalindromeService:\n    \"\"\"Orchestrates validation, computation, and optional persistence.\"\"\"\n    def __init__(self, validator: InputValidator, calculator: ChangeCalculator, \n                 repository: Optional[FileRepository] = None) -> None:\n        self._validator = validator\n        self._calculator = calculator\n        self._repository = repository\n\n    def compute(self, arr: Sequence[int]) -> int:\n        \"\"\"\n        Validates input, computes minimal changes, and optionally persists the record.\n        \"\"\"\n        validated_arr = self._validator.validate_sequence_of_ints(arr)\n        result = self._calculator.compute(validated_arr)\n        \n        if self._repository:\n            record = {\n                \"id\": generate_id(),\n                \"timestamp\": now_iso(),\n                \"input\": validated_arr,\n                \"result\": result\n            }\n            try:\n                self._repository.save_record(record)\n            except PersistenceError as e:\n                # Log persistence errors but allow computation result to be returned.\n                logger.error(f\"Persistence failed for record {record.get('id', 'N/A')}: {e}\")\n            except Exception as e:\n                # Catch any other unexpected errors during persistence.\n                logger.error(f\"Unexpected error during persistence for record {record.get('id', 'N/A')}: {e}\")\n        return result\n\n```\n```python\n# src/palindrome_change/controllers.py\nimport sys\nimport argparse\nimport logging\nfrom typing import Sequence, List, Any, Optional\n\n# Conditional import for APIController - Flask is an optional dependency\ntry:\n    from flask import Flask, request, jsonify, Response # type: ignore\nexcept ImportError:\n    # Define dummy types/functions if Flask is not available\n    Flask = None # type: ignore\n    request = None # type: ignore\n    jsonify = lambda x, status_code=200: (x, status_code) # type: ignore\n    Response = Any # type: ignore\n    def _flask_missing_error() -> None:\n        logging.getLogger(__name__).warning(\n            \"Flask is not installed. API functionality will be unavailable.\"\n        )\nelse:\n    def _flask_missing_error() -> None: # type: ignore\n        pass # Flask is installed, no warning needed\n\nfrom .services import PalindromeService\nfrom .validators import InputValidator\nfrom .calculator import ChangeCalculator\nfrom .repositories import FileRepository\nfrom .exceptions import ValidationError, PersistenceError\nfrom .config import DEFAULT_HISTORY_PATH, PERSISTENCE_ENABLED\n\nlogger = logging.getLogger(__name__)\nlogger.addHandler(logging.NullHandler())\n\nclass CLIController:\n    \"\"\"Handles command-line interface interactions.\"\"\"\n    def __init__(self, service: PalindromeService) -> None:\n        self._service = service\n\n    def run_compute(self, args: Sequence[str]) -> int:\n        \"\"\"\n        Parses CLI arguments, computes the result, and prints output.\n        Returns exit code (0 for success, non-zero for error).\n        \"\"\"\n        parser = argparse.ArgumentParser(\n            prog=\"palindrome-change\",\n            description=\"Compute the minimum changes to make an array palindromic.\"\n        )\n        subparsers = parser.add_subparsers(dest=\"command\", required=True)\n\n        compute_parser = subparsers.add_parser(\n            \"compute\",\n            help=\"Compute smallest changes for an array.\"\n        )\n        compute_parser.add_argument(\n            \"elements\",\n            metavar=\"N\",\n            type=int,\n            nargs=\"+\",\n            help=\"An integer element of the array.\"\n        )\n        compute_parser.add_argument(\n            \"--persist\",\n            action=\"store_true\",\n            default=PERSISTENCE_ENABLED, # Default from config\n            help=f\"Enable persistence to '{DEFAULT_HISTORY_PATH}'.\"\n        )\n        compute_parser.add_argument(\n            \"--no-persist\",\n            action=\"store_false\",\n            dest=\"persist\",\n            help=\"Disable persistence.\"\n        )\n        \n        try:\n            parsed_args = parser.parse_args(args)\n\n            if parsed_args.command == \"compute\":\n                repository: Optional[FileRepository] = None\n                if parsed_args.persist:\n                    repository = FileRepository(DEFAULT_HISTORY_PATH)\n                \n                # Re-instantiate PalindromeService with correct persistence setting based on CLI args.\n                service_for_cli = PalindromeService(\n                    validator=InputValidator(),\n                    calculator=ChangeCalculator(),\n                    repository=repository\n                )\n                \n                result = service_for_cli.compute(parsed_args.elements)\n                print(f\"Minimal changes: {result}\")\n                return 0\n        except ValidationError as e:\n            print(f\"Error: {e.message}\", file=sys.stderr)\n            return 1\n        except PersistenceError as e:\n            # If persistence errors are configured to be fatal, or need explicit display.\n            print(f\"Error: Persistence failed: {e.message}\", file=sys.stderr)\n            return 1 \n        except SystemExit as e:\n            # argparse handles --help or invalid arguments by raising SystemExit.\n            return e.code\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            logger.exception(\"Unexpected error in CLIController.run_compute\")\n            return 1\n\nclass APIController:\n    \"\"\"Provides an optional REST API using Flask.\"\"\"\n    def __init__(self, service: PalindromeService, token: Optional[str] = None) -> None:\n        self._service = service\n        self._token = token\n        _flask_missing_error() # Log warning if Flask is not available\n\n    def create_app(self) -> Any:\n        \"\"\"\n        Creates and configures a Flask application.\n        Raises RuntimeError if 'Flask' is not installed.\n        \"\"\"\n        if Flask is None:\n            raise RuntimeError(\"Flask is not installed. APIController cannot create an app.\")\n\n        app = Flask(__name__)\n\n        @app.route(\"/compute\", methods=[\"POST\"])\n        def compute_api() -> Response:\n            if self._token:\n                auth_header = request.headers.get(\"Authorization\")\n                if not auth_header or not auth_header.startswith(\"Bearer \"):\n                    return jsonify({\"error\": \"Unauthorized\"}), 401\n                if auth_header.split(\" \", 1)[1] != self._token:\n                    return jsonify({\"error\": \"Unauthorized\"}), 401\n\n            data = request.get_json()\n            if not data or \"array\" not in data:\n                return jsonify({\"error\": \"Invalid request body: 'array' field is missing.\"}), 400\n            \n            arr = data[\"array\"]\n            try:\n                result = self._service.compute(arr)\n                return jsonify({\"result\": result}), 200\n            except ValidationError as e:\n                return jsonify({\"error\": e.message}), 400\n            except PersistenceError as e:\n                # Logged by service; here, we might want to return a 500 error.\n                return jsonify({\"error\": f\"Persistence failed on server: {e.message}\"}), 500\n            except Exception as e:\n                logger.exception(\"Unexpected error in APIController /compute endpoint\")\n                return jsonify({\"error\": f\"An unexpected server error occurred: {e}\"}), 500\n        \n        return app\n\ndef main(argv: Optional[List[str]] = None) -> int:\n    \"\"\"\n    Main entry point for the CLI application.\n    This function initializes dependencies and runs the CLI controller.\n    \"\"\"\n    # A base service for CLIController, actual persistence config depends on parsed CLI args.\n    base_service_for_cli = PalindromeService(\n        validator=InputValidator(),\n        calculator=ChangeCalculator(),\n        repository=None # Persistence is configured dynamically in CLIController.run_compute\n    )\n    controller = CLIController(service=base_service_for_cli)\n    return controller.run_compute(argv if argv is not None else sys.argv[1:])\n\n```\n```python\n# src/palindrome_change/__init__.py\nfrom typing import Sequence, List, Optional, TYPE_CHECKING\nfrom .services import PalindromeService\nfrom .validators import InputValidator\nfrom .calculator import ChangeCalculator\nfrom .exceptions import ValidationError, PersistenceError\nfrom .config import DEFAULT_HISTORY_PATH, PERSISTENCE_ENABLED\nfrom .repositories import FileRepository\nfrom .controllers import APIController # Import APIController for __all__\n\n# Initialize default service for library API.\n# This service adheres to the PERSISTENCE_ENABLED setting from config.\n_default_validator = InputValidator()\n_default_calculator = ChangeCalculator()\n_default_repository: Optional[FileRepository] = None\nif PERSISTENCE_ENABLED:\n    _default_repository = FileRepository(DEFAULT_HISTORY_PATH)\n\n_default_service = PalindromeService(\n    validator=_default_validator,\n    calculator=_default_calculator,\n    repository=_default_repository\n)\n\ndef compute_smallest_change(arr: Sequence[int]) -> int:\n    \"\"\"\n    Computes the minimum number of element changes required to make an integer array palindromic.\n    \n    This is the primary library API entry point. It uses the configured PalindromeService\n    which handles input validation, computation, and optional persistence.\n    \n    Args:\n        arr: A sequence of integers.\n    \n    Returns:\n        The minimal number of single-element modifications needed.\n        \n    Raises:\n        ValidationError: If the input array is invalid (e.g., contains non-integers).\n    \"\"\"\n    return _default_service.compute(arr)\n\n# Export key components for library users.\n__all__ = [\n    \"compute_smallest_change\",\n    \"ValidationError\",\n    \"PersistenceError\",\n    \"PalindromeService\",\n    \"InputValidator\",\n    \"ChangeCalculator\",\n    \"FileRepository\",\n    \"APIController\", # APIController is exposed but requires Flask to be installed.\n]\n\n# The `main` function for the CLI entry point is located in controllers.py.\n# If `pyproject.toml` or `setup.py` defines a console_script, it would typically\n# point to `palindrome_change.controllers:main`.\n```"}
