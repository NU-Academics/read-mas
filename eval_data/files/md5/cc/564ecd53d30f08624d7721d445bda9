 Approved :: MIT License\",\n    \"Operating System :: OS Independent\",\n]\n\n[project.dependencies]\n# No external runtime dependencies beyond standard library\n\n[project.scripts]\nmusic-parse = \"music_parser.controllers.cli:main\"\n\n[project.optional-dependencies]\ndev = [\n    \"pytest>=7.0\",\n    \"pytest-cov>=4.0\",\n    \"flake8>=6.0\",\n    \"black>=23.0\",\n    \"isort>=5.0\",\n]\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[tool.pytest.ini_options]\naddopts = \"--cov=music_parser --cov-report=term-missing\"\ntestpaths = [\"tests\"]\n\n[tool.black]\nline-length = 100\ntarget-version = ['py39']\n\n[tool.isort]\nprofile = \"black\"\nline_length = 100\nknown_first_party = [\"music_parser\"]\n```\n\n```text\nREADME.md\n```markdown\n# Music Parser\n\nA Python library and command-line interface (CLI) tool for parsing simple ASCII musical-note strings into a list of integer beat durations.\n\n## Installation\n\n```bash\n# Using pip\npip install music-parser\n\n# Or from source\ngit clone https://github.com/your-username/music-parser.git\ncd music-parser\npip install .\n```\n\n## Usage\n\n### Library\n\nYou can integrate `music-parser` directly into your Python applications.\n\n```python\nfrom music_parser import parse_music, InvalidTokenError, EmptyInputError\n\n# Parse a valid music string\nmusic_string = \"o o| .| o| o| .| .| .| .| o o\"\ndurations = parse_music(music_string)\nprint(f\"Parsed durations: {durations}\")\n# Expected output: [4, 2, 1, 2, 2, 1, 1, 1, 1, 4, 4]\n\n# Custom note mapping\ncustom_map = {\"W\": 8, \"H\": 4, \"Q\": 2}\ncustom_music = \"W H Q W Q\"\ncustom_durations = parse_music(custom_music, custom_map)\nprint(f\"Custom parsed durations: {custom_durations}\")\n# Expected output: [8, 4, 2, 8, 2]\n\n# Handle errors\ntry:\n    parse_music(\"o x y\")\nexcept InvalidTokenError as e:\n    print(f\"Error parsing: {e.message}. Invalid tokens: {e.invalid_tokens}\")\n    # Expected: Error parsing: Unknown tokens: ['x', 'y']. Invalid tokens: ['x', 'y']\nexcept EmptyInputError:\n    print(\"Error: Input string is empty.\")\n```\n\n### Command-Line Interface (CLI)\n\nThe `music-parse` command allows you to parse music strings directly from your terminal.\n\n**Parse from argument:**\n\n```bash\nmusic-parse \"o o| .| o o\"\n# Output: [4, 2, 1, 4, 4]\n```\n\n**Parse from stdin:**\n\n```bash\necho \"o o| .|\" | music-parse\n# Output: [4, 2, 1]\n```\n\n**Error Handling:**\n\n```bash\nmusic-parse \"o x y\"\n# Output to stderr: Error: Unknown tokens: ['x', 'y']\n# Exits with non-zero status code (e.g., 3)\n```\n\n```bash\nmusic-parse \"\"\n# Output to stderr: Error: Input is empty\n# Exits with non-zero status code (e.g., 2)\n```\n\n## Development\n\n### Running Tests\n\n```bash\npip install \".[dev]\"\npytest\n```\n\n### Code Style\n\nThis project uses `black` for code formatting and `isort` for import sorting.\n\n```bash\nblack src/ tests/\nisort src/ tests/\nflake8 src/ tests/\n```\n\n## Project Structure\n\n```\n\u251c\u2500\u2500 src/\n\u2502   \u2514\u2500\u2500 music_parser/\n\u2502       \u251c\u2500\u2500 __init__.py\n\u2502       \u251c\u2500\u2500 constants.py\n\u2502       \u251c\u2500\u2500 models.py\n\u2502       \u251c\u2500\u2500 exceptions.py\n\u2502       \u251c\u2500\u2500 tokenizer.py\n\u2502       \u251c\u2500\u2500 validator.py\n\u2502       \u251c\u2500\u2500 parser_service.py\n\u2502       \u251c\u2500\u2500 adapters/\n\u2502       \u2502   \u2514\u2500\u2500 io_adapter.py\n\u2502       \u251c\u2500\u2500 controllers/\n\u2502       \u2502   \u2514\u2500\u2500 cli.py\n\u2502       \u2514\u2500\u2500 utils.py\n\u251c\u2500\u2500 tests/\n\u2502   \u251c\u2500\u2500 test_tokenizer.py\n\u2502   \u251c\u2500\u2500 test_validator.py\n\u2502   \u251c\u2500\u2500 test_parser_service.py\n\u2502   \u2514\u2500\u2500 test_cli.py\n\u251c\u2500\u2500 pyproject.toml\n\u251c\u2500\u2500 README.md\n\u2514\u2500\u2500 .github/\n    \u2514\u2500\u2500 workflows/\n        \u2514\u2500\u2500 ci.yml\n```\n```\n\n```text\nsrc/music_parser/__init__.py\n```python\n\"\"\"\nMusic Parser Package: provides a convenient `parse_music` function\nand exposes core components.\n\"\"\"\nfrom typing import List, Dict, Optional\n\nfrom .tokenizer import Tokenizer\nfrom .validator import Validator\nfrom .parser_service import ParserService\nfrom .constants import DEFAULT_NOTE_MAP\nfrom .exceptions import InvalidTokenError, EmptyInputError, ConfigurationError\nfrom .models import ParseResult # Exporting for type hinting if users need it\n\n# Expose key exceptions for users\n__all__ = [\"parse_music\", \"InvalidTokenError\", \"EmptyInputError\", \"ConfigurationError\", \"ParseResult\"]\n\n\ndef parse_music(music_string: str, note_map: Optional[Dict[str, int]] = None) -> List[int]:\n    \"\"\"\n    Parses a simple ASCII musical-note string into an ordered list of integer beat durations.\n    This is a convenience wrapper around the ParserService.\n\n    Args:\n        music_string: The input string representing musical notes.\n        note_map: An optional dictionary mapping note tokens to beat durations.\n                  If not provided, a default mapping is used.\n\n    Returns:\n        A list of integers, where each integer represents the beat duration of a parsed note.\n\n    Raises:\n        EmptyInputError: If the input string is empty or contains only whitespace.\n        InvalidTokenError: If the input string contains tokens not found in the note_map.\n        ConfigurationError: If the provided note_map is malformed (e.g., non-integer values).\n\n    >>> parse_music('o o| .| o| o| .| .| .| .| o o')\n    [4, 2, 1, 2, 2, 1, 1, 1, 1, 4, 4]\n    >>> parse_music('W H Q', note_map={'W': 8, 'H': 4, 'Q': 2})\n    [8, 4, 2]\n    \"\"\"\n    tokenizer = Tokenizer()\n    validator = Validator()\n    service = ParserService(tokenizer, validator, note_map=note_map or DEFAULT_NOTE_MAP)\n    result = service.parse(music_string)\n    return result.to_list()\n\n```\n\n```text\nsrc/music_parser/adapters/io_adapter.py\n```python\n\"\"\"\nIOAdapter: Abstracts standard input/output operations for testability.\n\"\"\"\nimport sys\nimport json\nfrom typing import Any\n\nclass IOAdapter:\n    \"\"\"\n    Provides an abstraction layer for reading from stdin, writing to stdout/stderr,\n    and optionally writing JSON to files.\n    \"\"\"\n    def read_stdin(self) -> str:\n        \"\"\"Reads all available input from stdin.\"\"\"\n        return sys.stdin.read()\n\n    def write_stdout(self, text: str) -> None:\n        \"\"\"Writes the given text to stdout, followed by a newline.\"\"\"\n        sys.stdout.write(text + \"\\n\")\n\n    def write_error(self, text: str) -> None:\n        \"\"\"Writes the given text to stderr, followed by a newline.\"\"\"\n        sys.stderr.write(f\"Error: {text}\\n\")\n\n    def write_json(self, path: str, data: Any) -> None:\n        \"\"\"\n        Writes a Python object as JSON to the specified file path.\n        For optional logging/persistence as per design.\n        \"\"\"\n        try:\n            with open(path, 'w', encoding='utf-8') as f:\n                json.dump(data, f, indent=2)\n        except IOError as e:\n            # In a real system, this might log the error or re-raise\n            self.write_error(f\"Failed to write JSON to {path}: {e}\")\n\n```\n\n```text\nsrc/music_parser/constants.py\n```python\n\"\"\"\nConstants: central mapping and default values.\n\"\"\"\n\nDEFAULT_NOTE_MAP: dict[str, int] = {\"o\": 4, \"o|\": 2, \".|\": 1}\nDEFAULT_ENCODING: str = \"utf-8\"\n```\n\n```text\nsrc/music_parser/controllers/cli.py\n```python\n\"\"\"\nCLIController: Handles command-line argument parsing, orchestrates the parsing service,\nand manages output/error messages for the CLI.\n\"\"\"\nimport sys\nfrom typing import List, Optional\n\nfrom ..parser_service import ParserService\nfrom ..tokenizer import Tokenizer\nfrom ..validator import Validator\nfrom ..adapters.io_adapter import IOAdapter\nfrom ..constants import DEFAULT_NOTE_MAP\nfrom ..exceptions import EmptyInputError, InvalidTokenError, ConfigurationError\nfrom ..models import ParseResult # Unused, but for context if needed for format_output\n\ndef main(argv: Optional[List[str]] = None) -> int:\n    \"\"\"\n    Main entry point for the command-line interface.\n    Initializes dependencies and runs the CLIController.\n    \"\"\"\n    if argv is None:\n        argv = sys.argv[1:] # Exclude script name\n\n    tokenizer = Tokenizer()\n    validator = Validator()\n    # ParserService uses DEFAULT_NOTE_MAP if none is provided\n    service = ParserService(tokenizer, validator)\n    io_adapter = IOAdapter()\n\n    controller = CLIController(service, io_adapter)\n    return controller.run(argv)\n\nclass CLIController:\n    \"\"\"\n    Manages the command-line interface interactions, including input reading,\n    calling the parsing service, and printing results or errors.\n    \"\"\"\n    def __init__(self, service: ParserService, io: IOAdapter) -> None:\n        self._service = service\n        self._io = io\n\n    def run(self, argv: List[str]) -> int:\n        \"\"\"\n        Executes the CLI logic: parses arguments or stdin,\n        calls the parser service, prints output, and returns an exit code.\n        \"\"\"\n        try:\n            music_string = self._parse_arg_or_stdin(argv)\n            result = self._service.parse(music_string)\n            self._io.write_stdout(result.to_json())\n            return 0  # Success\n        except EmptyInputError as e:\n            self._io.write_error(e.message)\n            return 2  # Specific exit code for empty input\n        except InvalidTokenError as e:\n            self._io.write_error(e.message)\n            return 3  # Specific exit code for invalid tokens\n        except ConfigurationError as e:\n            self._io.write_error(f\"Configuration error: {e.message}\")\n            return 4 # Specific exit code for configuration error (should not happen in CLI with defaults)\n        except Exception as e:\n            self._io.write_error(f\"An unexpected error occurred: {e}\")\n            return 1  # Generic error\n\n    def _parse_arg_or_stdin(self, argv: List[str]) -> str:\n        \"\"\"\n        Determines the music string source: either from the first command-line argument\n        or by reading from standard input if no argument is provided.\n        \"\"\"\n        if len(argv) > 0:\n            return argv[0]\n        return self._io.read_stdin()\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n\n```\n\n```text\nsrc/music_parser/exceptions.py\n```python\n\"\"\"\nCustom exceptions for parsing and configuration errors.\n\"\"\"\n\nclass InvalidTokenError(Exception):\n    \"\"\"Raised when one or more tokens are not recognized.\"\"\"\n    def __init__(self, invalid_tokens: list[str], message: str | None = None) -> None:\n        self.invalid_tokens = invalid_tokens\n        self.message = message if message is not None else f\"Unknown tokens: {invalid_tokens}\"\n        super().__init__(self.message)\n\nclass EmptyInputError(Exception):\n    \"\"\"Raised when the input music string is empty or contains only whitespace.\"\"\"\n    def __init__(self, message: str | None = None) -> None:\n        self.message = message if message is not None else \"Input is empty\"\n        super().__init__(self.message)\n\nclass ConfigurationError(Exception):\n    \"\"\"Raised for issues with parser configuration, e.g., invalid note map values.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\n```\n\n```text\nsrc/music_parser/models.py\n```python\n\"\"\"\nData models for parse results and type aliases.\n\"\"\"\nimport json\nfrom dataclasses import dataclass\nfrom typing import List, Dict, TypeAlias\n\nNoteMap: TypeAlias = Dict[str, int]\n\n@dataclass(frozen=True) # Ensure immutability for ParseResult\nclass ParseResult:\n    \"\"\"\n    Represents the result of a music string parsing operation.\n    \"\"\"\n    durations: List[int]\n    source: str\n\n    def to_list(self) -> List[int]:\n        \"\"\"Returns the list of parsed beat durations.\"\"\"\n        return self.durations\n\n    def to_json(self) -> str:\n        \"\"\"Returns the parsed durations as a JSON array string.\"\"\"\n        return json.dumps(self.durations)\n\n```\n\n```text\nsrc/music_parser/parser_service.py\n```python\n\"\"\"\nParserService orchestrates the tokenization, validation, and mapping process.\n\"\"\"\nfrom typing import List, Optional\n\nfrom .tokenizer import Tokenizer\nfrom .validator import Validator\nfrom .models import ParseResult, NoteMap\nfrom .exceptions import EmptyInputError, ConfigurationError\nfrom .constants import DEFAULT_NOTE_MAP\n\nclass ParserService:\n    \"\"\"\n    Orchestrates the parsing of a music string into beat durations.\n    It composes a Tokenizer and a Validator to perform its tasks.\n    \"\"\"\n    def __init__(self, tokenizer: Tokenizer, validator: Validator, note_map: Optional[NoteMap] = None) -> None:\n        self._tokenizer = tokenizer\n        self._validator = validator\n        self._note_map = note_map if note_map is not None else DEFAULT_NOTE_MAP\n\n        # Validate provided note_map values\n        for key, value in self._note_map.items():\n            if not isinstance(key, str):\n                raise ConfigurationError(f\"Note map keys must be strings, found type {type(key)} for key '{key}'\")\n            if not isinstance(value, int):\n                raise ConfigurationError(f\"Note map values must be integers, found type {type(value)} for key '{key}'\")\n\n    def parse(self, music_string: str) -> ParseResult:\n        \"\"\"\n        Parses a music string into a ParseResult object containing beat durations.\n        \"\"\"\n        if not music_string or not music_string.strip():\n            raise EmptyInputError(\"Input is empty\")\n\n        tokens = self._tokenizer.tokenize(music_string)\n        if not tokens: # If input was just whitespace, tokenizer returns [], which should also be EmptyInputError\n             raise EmptyInputError(\"Input is empty after tokenization\")\n\n        self._validator.validate(tokens, self._note_map)\n        durations = self._map_tokens(tokens)\n\n        return ParseResult(durations=durations, source=music_string)\n\n    def _map_tokens(self, tokens: List[str]) -> List[int]:\n        \"\"\"\n        Maps a list of valid tokens to their corresponding integer durations.\n        Assumes tokens have already been validated.\n        \"\"\"\n        return [self._note_map[token] for token in tokens]\n\n```\n\n```text\nsrc/music_parser/tokenizer.py\n```python\n\"\"\"\nTokenizer class for splitting input strings into musical tokens.\n\"\"\"\n\nclass Tokenizer:\n    \"\"\"\n    Splits an input string into a list of non-empty tokens based on whitespace.\n    \"\"\"\n    def tokenize(self, input_str: str) -> list[str]:\n        \"\"\"\n        Tokenizes the input string.\n        Strips leading/trailing whitespace and splits by any sequence of whitespace.\n        \"\"\"\n        normalized_input = self._normalize(input_str)\n        if not normalized_input:\n            return []\n        # Splitting by default splits on any whitespace and removes empty strings\n        return normalized_input.split()\n\n    def _normalize(self, input_str: str) -> str:\n        \"\"\"\n        Strips leading/trailing whitespace from the input string.\n        \"\"\"\n        return input_str.strip()\n\n```\n\n```text\nsrc/music_parser/utils.py\n```python\n\"\"\"\nUtility functions for formatting output.\n\"\"\"\nfrom .models import ParseResult\n\ndef format_output(parse_result: ParseResult) -> str:\n    \"\"\"\n    Formats the ParseResult into a string for output.\n    Defaults to JSON array string as per CLI requirement.\n    \"\"\"\n    return parse_result.to_json()\n\n```\n\n```text\nsrc/music_parser/validator.py\n```python\n\"\"\"\nValidator class for checking if tokens are valid against a note mapping.\n\"\"\"\nfrom typing import List\n\nfrom .exceptions import InvalidTokenError\nfrom .models import NoteMap # TypeAlias\n\nclass Validator:\n    \"\"\"\n    Validates a list of tokens against a provided note mapping.\n    \"\"\"\n    def find_invalid(self, tokens: List[str], note_map: NoteMap) -> List[str]:\n        \"\"\"\n        Identifies and returns a list of tokens not present in the note_map.\n        Preserves order of first appearance and uniqueness.\n        \"\"\"\n        invalid_found = []\n        seen = set()\n        for token in tokens:\n            if token not in note_map and token not in seen:\n                invalid_found.append(token)\n                seen.add(token)\n        return invalid_found\n\n    def validate(self, tokens: List[str], note_map: NoteMap) -> None:\n        \"\"\"\n        Checks if all tokens are present in the note_map.\n        Raises InvalidTokenError if any unknown tokens are found.\n        \"\"\"\n        invalid = self.find_invalid(tokens, note_map)\n        if invalid:\n            raise InvalidTokenError(invalid_tokens=invalid, message=f\"Unknown tokens: {invalid}\")\n\n```\n\n```text\ntests/test_cli.py\n```python\n\"\"\"\nIntegration tests for the CLIController using mocked IOAdapter.\n\"\"\"\nimport pytest\nimport sys\nfrom unittest.mock import Mock, patch\n\nfrom src.music_parser.controllers.cli import CLIController, main\nfrom src.music_parser.parser_service import ParserService\nfrom src.music_parser.tokenizer import Tokenizer\nfrom src.music_parser.validator import Validator\nfrom src.music_parser.adapters.io_adapter import IOAdapter\nfrom src.music_parser.models import ParseResult\nfrom src.music_parser.constants import DEFAULT_NOTE_MAP\nfrom src.music_parser.exceptions import EmptyInputError, InvalidTokenError\n\nclass MockIOAdapter(IOAdapter):\n    \"\"\"A mock IOAdapter to capture stdout/stderr and control stdin for testing.\"\"\"\n    def __init__(self):\n        self.stdin_value = \"\"\n        self.stdout_output = \"\"\n        self.stderr_output = \"\"\n\n    def read_stdin(self) -> str:\n        return self.stdin_value\n\n    def write_stdout(self, text: str) -> None:\n        self.stdout_output += text + \"\\n\"\n\n    def write_error(self, text: str) -> None:\n        self.stderr_output += text + \"\\n\"\n\nclass TestCLIController:\n    def setup_method(self):\n        \"\"\"Set up for each test method.\"\"\"\n        self.mock_tokenizer = Tokenizer() # Use real for simplicity, or mock if more isolation needed\n        self.mock_validator = Validator() # Use real\n        self.mock_io_adapter = MockIOAdapter()\n        self.parser_service = ParserService(self.mock_tokenizer, self.mock_validator, DEFAULT_NOTE_MAP)\n        self.cli_controller = CLIController(self.parser_service, self.mock_io_adapter)\n\n    def test_run_from_arg_success(self):\n        \"\"\"Test CLI with a valid music string from a command-line argument.\"\"\"\n        argv = [\"o o| .|\"]\n        exit_code = self.cli_controller.run(argv)\n\n        assert exit_code == 0\n        assert self.mock_io_adapter.stdout_output == \"[4, 2, 1]\\n\"\n        assert self.mock_io_adapter.stderr_output == \"\"\n\n    def test_run_from_stdin_success(self):\n        \"\"\"Test CLI with a valid music string from stdin.\"\"\"\n        self.mock_io_adapter.stdin_value = \"o o| .|\"\n        argv = []\n        exit_code = self.cli_controller.run(argv)\n\n        assert exit_code == 0\n        assert self.mock_io_adapter.stdout_output == \"[4, 2, 1]\\n\"\n        assert self.mock_io_adapter.stderr_output == \"\"\n\n    def test_run_empty_input_error_from_arg(self):\n        \"\"\"Test CLI with an empty string argument.\"\"\"\n        argv = [\"\"]\n        exit_code = self.cli_controller.run(argv)\n\n        assert exit_code == 2\n        assert self.mock_io_adapter.stdout_output == \"\"\n        assert \"Error: Input is empty\" in self.mock_io_adapter.stderr_output\n\n    def test_run_empty_input_error_from_stdin(self):\n        \"\"\"Test CLI with empty stdin.\"\"\"\n        self.mock_io_adapter.stdin_value = \"\"\n        argv = []\n        exit_code = self.cli_controller.run(argv)\n\n        assert exit_code == 2\n        assert self.mock_io_adapter.stdout_output == \"\"\n        assert \"Error: Input is empty\" in self.mock_io_adapter.stderr_output\n\n    def test_run_invalid_token_error_from_arg(self):\n        \"\"\"Test CLI with an invalid token in the argument.\"\"\"\n        argv = [\"o x y\"]\n        exit_code = self.cli_controller.run(argv)\n\n        assert exit_code == 3\n        assert self.mock_io_adapter.stdout_output == \"\"\n        assert \"Error: Unknown tokens: ['x', 'y']\" in self.mock_io_adapter.stderr_output\n\n    def test_run_invalid_token_error_from_stdin(self):\n        \"\"\"Test CLI with an invalid token from stdin.\"\"\"\n        self.mock_io_adapter.stdin_value = \"o x y\"\n        argv = []\n        exit_code = self.cli_controller.run(argv)\n\n        assert exit_code == 3\n        assert self.mock_io_adapter.stdout_output == \"\"\n        assert \"Error: Unknown tokens: ['x', 'y']\" in self.mock_io_adapter.stderr_output\n\n    def test_run_unexpected_error(self):\n        \"\"\"Test CLI for an unexpected error (e.g., from ParserService internals).\"\"\"\n        # Simulate a generic unexpected error from the parser service\n        mock_service = Mock(spec=ParserService)\n        mock_service.parse.side_effect = ValueError(\"Something went wrong!\")\n        cli_controller_with_mock_service = CLIController(mock_service, self.mock_io_adapter)\n\n        argv = [\"o o|\"]\n        exit_code = cli_controller_with_mock_service.run(argv)\n\n        assert exit_code == 1\n        assert self.mock_io_adapter.stdout_output == \"\"\n        assert \"Error: An unexpected error occurred: Something went wrong!\" in self.mock_io