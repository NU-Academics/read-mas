alidation utilities for the longest_app.\n\"\"\"\nfrom typing import Any, List, Iterable\n\nfrom .exceptions import InvalidInputError\n\nclass Validator:\n    \"\"\"Validates and normalizes input to be an iterable of strings.\"\"\"\n\n    def validate_strings(self, strings: Any) -> List[str]:\n        \"\"\"\n        Ensures the input is an iterable of strings and returns it as a list.\n        Raises InvalidInputError for invalid input types or elements.\n        \"\"\"\n        if strings is None:\n            return []\n        if isinstance(strings, str):\n            raise InvalidInputError(\"Expected an iterable of strings, but received a single string.\")\n        \n        try:\n            result = list(strings)\n        except TypeError:\n            raise InvalidInputError(\"Provided value is not iterable.\")\n        \n        for i, item in enumerate(result):\n            if not isinstance(item, str):\n                raise InvalidInputError(f\"Element at index {i} is not a string: {type(item).__name__}.\")\n        return result\n```\n\n## src/longest_app/service.py\n```python\n\"\"\"\nCore business logic for finding the longest string.\n\"\"\"\nfrom typing import List, Optional\n\nfrom .validator import Validator\n\nclass LongestService:\n    \"\"\"Encapsulates the algorithm for finding the longest string.\"\"\"\n\n    def __init__(self, validator: Optional[Validator] = None) -> None:\n        \"\"\"Initializes the service, optionally injecting a Validator.\"\"\"\n        self._validator = validator or Validator()\n\n    def longest(self, strings: List[str]) -> Optional[str]:\n        \"\"\"\n        Finds the longest string from a list, using the injected validator.\n        Returns None if the list is empty.\n        \"\"\"\n        validated_strings = self._validator.validate_strings(strings)\n        return self._compute(validated_strings)\n\n    def _compute(self, strings: List[str]) -> Optional[str]:\n        \"\"\"\n        Internal computation of the longest string without input validation.\n        Ties are broken by returning the first occurrence.\n        \"\"\"\n        if not strings:\n            return None\n\n        best_string: Optional[str] = None\n        best_length = -1\n\n        for s in strings:\n            current_length = len(s)\n            if current_length > best_length:\n                best_length = current_length\n                best_string = s\n        return best_string\n```\n\n## src/longest_app/api.py\n```python\n\"\"\"\nPublic API for the longest_app library.\n\"\"\"\nfrom typing import List, Optional\n\nfrom .service import LongestService\nfrom .validator import Validator\n\n# Module-level instance of LongestService for the public API.\n_DEFAULT_SERVICE = LongestService(validator=Validator())\n\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\"\n    Returns the longest string from a list, or None if the input is empty.\n    Ties are resolved by returning the first occurring string of max length.\n    \"\"\"\n    return _DEFAULT_SERVICE.longest(strings)\n```\n\n## src/longest_app/adapter.py\n```python\n\"\"\"\nAdapters for converting various input sources (CLI args, STDIN) into a list of strings.\n\"\"\"\nimport io\nfrom typing import List, TextIO\n\nfrom .exceptions import InvalidInputError\n\nclass InputAdapter:\n    \"\"\"Handles parsing input from command-line arguments or standard input.\"\"\"\n\n    STDIN_READ_LIMIT: int = 100_000  # Safety cap for stdin reading in bytes.\n\n    def args_to_list(self, args: List[str]) -> List[str]:\n        \"\"\"\n        Converts a list of command-line arguments into a list of strings.\n        Returns the arguments directly, assuming they are strings.\n        \"\"\"\n        return args\n\n    def stdin_to_list(self, stdin: TextIO) -> List[str]:\n        \"\"\"\n        Reads newline-separated strings from stdin, up to STDIN_READ_LIMIT.\n        Returns a list of stripped strings, or an empty list if stdin is empty.\n        \"\"\"\n        content = stdin.read(self.STDIN_READ_LIMIT)\n        if stdin.read(1):\n            raise InvalidInputError(f\"Input from stdin exceeded the {self.STDIN_READ_LIMIT} byte limit.\")\n\n        if not content:\n            return []\n        \n        return [line.strip() for line in content.splitlines()]\n```\n\n## src/longest_app/utils.py\n```python\n\"\"\"\nSmall, general-purpose helper functions.\n\"\"\"\nfrom typing import Iterable, Callable, Optional, TypeVar\n\nT = TypeVar('T')\n\ndef first_true_index(iterable: Iterable[T], predicate: Callable[[T], bool]) -> Optional[int]:\n    \"\"\"\n    Returns the index of the first element in the iterable for which the predicate is true.\n    Returns None if no such element is found.\n    \"\"\"\n    for i, item in enumerate(iterable):\n        if predicate(item):\n            return i\n    return None\n```\n\n## src/longest_app/cli.py\n```python\n\"\"\"\nCommand-Line Interface (CLI) controller for the longest_app.\n\"\"\"\nimport sys\nimport io\nfrom typing import List, Optional, TextIO\n\nfrom .service import LongestService\nfrom .adapter import InputAdapter\nfrom .validator import Validator\nfrom .exceptions import InvalidInputError\n\nclass CLIController:\n    \"\"\"Manages command-line argument parsing, logic execution, and output.\"\"\"\n\n    def __init__(\n        self,\n        service: Optional[LongestService] = None,\n        adapter: Optional[InputAdapter] = None,\n        validator: Optional[Validator] = None\n    ) -> None:\n        \"\"\"Initializes the CLI controller with optional dependency injection.\"\"\"\n        self.validator = validator or Validator()\n        self.service = service or LongestService(validator=self.validator)\n        self.adapter = adapter or InputAdapter()\n\n    def run(\n        self,\n        argv: List[str],\n        stdin: TextIO = sys.stdin,\n        stdout: TextIO = sys.stdout,\n        stderr: TextIO = sys.stderr\n    ) -> int:\n        \"\"\"\n        Executes the CLI logic, processing arguments or stdin, and printing results.\n        Returns an exit code (0 for success, 1 for unexpected error, 2 for invalid input).\n        \"\"\"\n        try:\n            input_strings: List[str] = []\n\n            if len(argv) > 1:\n                input_strings = self.adapter.args_to_list(argv[1:])\n            else:\n                input_strings = self.adapter.stdin_to_list(stdin)\n            \n            validated_strings = self.validator.validate_strings(input_strings)\n            result = self.service.longest(validated_strings)\n            \n            if result is not None:\n                print(result, file=stdout)\n            return 0\n        except InvalidInputError as e:\n            print(f\"Error: Invalid input: {e.message}\", file=stderr)\n            return 2\n        except Exception as e:\n            print(f\"Error: An unexpected error occurred: {e}\", file=stderr)\n            return 1\n\ndef main():\n    \"\"\"Entry point for the longest CLI console script.\"\"\"\n    controller = CLIController()\n    sys.exit(controller.run(sys.argv))\n```\n\n## tests/test_service.py\n```python\n\"\"\"\nTests for the core LongestService business logic.\n\"\"\"\n# Unit tests would go here, but generating tests is forbidden by the prompt.\n\n```\n\n## tests/test_api.py\n```python\n\"\"\"\nTests for the public API longest_app.api.longest function.\n\"\"\"\n# Unit tests would go here, but generating tests is forbidden by the prompt.\n\n```\n\n## tests/test_cli.py\n```python\n\"\"\"\nTests for the Command Line Interface (CLI) functionality.\n\"\"\"\n# Unit tests would go here, but generating tests is forbidden by the prompt.\n\n```"}
