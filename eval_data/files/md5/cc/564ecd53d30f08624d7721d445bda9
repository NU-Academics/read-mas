{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    This function uses trial division up to the square root of n.\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n\n    d = 3\n    while d * d <= n:\n        if n % d == 0:\n            return False\n        d += 2\n    return True"}
{"task_id": "HumanEval/31", "solution": "```python\ndef is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    This implementation uses an optimized trial division algorithm.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n <= 3: # 2 and 3 are prime numbers\n        return True\n    if n % 2 == 0 or n % 3 == 0: # Eliminate multiples of 2 and 3\n        return False\n    \n    # Check for factors from 5 onwards with a step of 6\n    # (i.e., numbers of the form 6k \u00b1 1) up to the square root of n.\n    i = 5\n    r = int(n**0.5) # Calculate integer square root without importing math\n    while i <= r:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n```"}
{"task_id": "HumanEval/32", "solution": "import math\n\n\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x using Horner's method.\n    Returns xs[0] + xs[1] * x + ... + xs[n] * x^n.\n    \"\"\"\n    result = 0.0\n    for c in reversed(xs):\n        result = result * x + c\n    return result\n\n\ndef find_zero(xs: list):\n    \"\"\"\n    Finds a single real root for a polynomial with odd degree coefficients xs.\n    It uses bisection method within a large initial bracket.\n    \"\"\"\n    # Default tolerance and max iterations for bisection.\n    tolerance = 1e-10\n    max_iterations = 1000\n\n    # Initialize a wide bracket based on the guarantee of a real root for odd-degree polynomials.\n    a = -1e6\n    b = 1e6\n\n    fa = poly(xs, a)\n    if fa == 0.0:\n        return a\n\n    fb = poly(xs, b)\n    if fb == 0.0:\n        return b\n\n    # Perform bisection to converge to a root.\n    for _ in range(max_iterations):\n        m = (a + b) / 2.0\n        fm = poly(xs, m)\n\n        if abs(fm) <= tolerance or (b - a) / 2.0 < tolerance:\n            return m\n\n        if fa * fm <= 0:\n            b = m\n            fb = fm\n        else:\n            a = m\n            fa = fm\n            \n    return m"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    \"\"\"\n    \n    indices_to_sort = []\n    values_to_sort = []\n\n    # Collect indices divisible by 3 and their corresponding values\n    for i in range(len(l)):\n        if i % 3 == 0:\n            indices_to_sort.append(i)\n            values_to_sort.append(l[i])\n            \n    # Sort the collected values\n    sorted_values = sorted(values_to_sort)\n    \n    # Create a copy of the original list to modify\n    result_list = l[:]\n    \n    # Place sorted values back into the original positions\n    for i, original_index in enumerate(indices_to_sort):\n        result_list[original_index] = sorted_values[i]\n        \n    return result_list"}
{"task_id": "HumanEval/32", "solution": "import math\n\n\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x using Horner's method.\n    Coefficients are ordered from constant term (x^0) to highest degree (x^n).\n    \"\"\"\n    # Implements Horner's method from PolynomialEvaluator\n    result = 0.0\n    # Trusting inputs: xs is a list, x is a float.\n    for coeff in reversed(xs):\n        result = result * x + float(coeff)\n    return result\n\n\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial (a0, a1, ..., an).\n    Finds x such that poly(x) = 0, returning one zero point.\n    Assumes xs has an even number of coefficients (odd degree) and a non-zero leading coefficient.\n    \"\"\"\n\n    # Inlined helper for sign function from NumericUtils.sign\n    def _sign(val_x: float) -> int:\n        if val_x > 0: return 1\n        if val_x < 0: return -1\n        return 0\n\n    # Numerical configuration constants derived from the design's Config\n    tolerance = 1e-10\n    max_iterations = 200\n    search_initial = 1.0\n    search_multiplier = 2.0\n    search_max = 1e6\n\n    # Convert coefficients to floats as per design's NumericUtils.to_float_list\n    # Trusting inputs are convertible to float, as per CRITICAL REQUIREMENTS.\n    coefficients = [float(c) for c in xs]\n\n    # _bracket_root logic from BisectionRootFinder (inlined)\n    r = search_initial\n    a_bracket, b_bracket = None, None\n\n    # Search outward from 0 symmetrically\n    while r <= search_max:\n        fa = poly(coefficients, -r)\n        fb = poly(coefficients, r)\n\n        # Check if -r or r is already a root\n        if abs(fa) <= tolerance:\n            a_bracket, b_bracket = -r, -r\n            break\n        if abs(fb) <= tolerance:\n            a_bracket, b_bracket = r, r\n            break\n\n        # Check for sign change\n        if _sign(fa) * _sign(fb) < 0:\n            a_bracket, b_bracket = -r, r\n            break\n        \n        r *= search_multiplier\n    \n    # If no bracket found within search_max, the design would raise NoRootFoundError.\n    # Per CRITICAL REQUIREMENTS, we cannot raise.\n    # The docstring states \"guarantees a solution\", implying a bracket must always be found for valid inputs.\n    # As a fallback (should not be reached if inputs are truly valid per docstring): use a very large default range.\n    if a_bracket is None:\n        a_bracket, b_bracket = -search_max, search_max # Best effort fallback\n\n    # _bisection logic from BisectionRootFinder (inlined)\n    a, b = a_bracket, b_bracket\n    fa = poly(coefficients, a)\n    fb = poly(coefficients, b)\n\n    # If the bracket endpoints are themselves roots, return them immediately\n    if abs(fa) <= tolerance: return a\n    if abs(fb) <= tolerance: return b\n    \n    # If a sign change is not present in the bracket, due to CRITICAL REQUIREMENTS,\n    # we proceed without error. This should ideally not happen if _bracket_root is successful.\n\n    for _ in range(max_iterations):\n        m = a + (b - a) / 2.0  # Calculate midpoint safely\n        fm = poly(coefficients, m)\n\n        if abs(fm) <= tolerance:\n            return m\n\n        # Adjust the bracket based on the sign of fm\n        if _sign(fa) * _sign(fm) < 0:\n            b, fb = m, fm\n        else:\n            a, fa = m, fm\n        \n        # Check for interval convergence\n        if abs(b - a) <= tolerance:\n            return a + (b - a) / 2.0\n    \n    # If bisection fails to converge within max_iterations,\n    # the design would raise NumericalError. Per CRITICAL REQUIREMENTS,\n    # we return the current best estimate (midpoint of the last interval).\n    return a + (b - a) / 2.0"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a new list where elements at indices divisible by three are sorted, while other elements remain in their original positions. The original list is not modified.\"\"\"\n    n = len(l)\n    indices_to_sort = [i for i in range(n) if i % 3 == 0]\n    \n    if not indices_to_sort:\n        return list(l)\n\n    values_at_indices = [l[i] for i in indices_to_sort]\n    sorted_values = sorted(values_at_indices)\n    \n    result_list = list(l)\n    for target_idx, sorted_val in zip(indices_to_sort, sorted_values):\n        result_list[target_idx] = sorted_val\n        \n    return result_list"}
{"task_id": "HumanEval/34", "solution": "def unique(l: list):\n    \"\"\"Return sorted unique elements in a list.\n    This implementation assumes hashable list elements for set-based deduplication.\"\"\"\n\n    unique_elements = set(l)\n    result = sorted(list(unique_elements))\n    return result"}
{"task_id": "HumanEval/34", "solution": "```python\ndef unique(l: list) -> list:\n    \"\"\"Return sorted unique elements from a list.\n    Handles unhashable elements and uses string representation for sorting fallback.\n    \"\"\"\n    unique_elements = []\n    try:\n        seen = set()\n        for item in l:\n            if item not in seen:\n                seen.add(item)\n                unique_elements.append(item)\n    except TypeError:  # Encountered unhashable type, fall back to repr-based tracking\n        seen_keys = set()\n        unique_elements = []  # Reset to build the list with repr-based deduplication\n        for item in l:\n            key = repr(item)\n            if key not in seen_keys:\n                seen_keys.add(key)\n                unique_elements.append(item)\n\n    try:\n        return sorted(unique_elements)\n    except TypeError:  # Elements are not mutually comparable, fall back to string comparison\n        return sorted(unique_elements, key=lambda x: str(x))\n```"}
{"task_id": "HumanEval/35", "solution": "```python\n# src/max_element_lib/exceptions.py\nfrom typing import Optional\n\nclass MaxElementError(ValueError):\n    \"\"\"Custom exception for errors during max element computation.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\n# src/max_element_lib/models.py\nfrom typing import Any, Optional\n\nclass ResultDTO:\n    \"\"\"Data Transfer Object for returning max element results.\"\"\"\n    def __init__(self, result: Any, success: bool = True, message: Optional[str] = None) -> None:\n        self.result = result\n        self.success = success\n        self.message = message\n\n# src/max_element_lib/max_element_finder.py\nfrom typing import Iterable, Any\nfrom .exceptions import MaxElementError\n\nclass MaxElementFinder:\n    \"\"\"Implements the core O(n) algorithm to find the maximum element.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def find_max(self, items: Iterable[Any]) -> Any:\n        \"\"\"Finds the maximum element in an iterable of comparable items.\"\"\"\n        iterator = iter(items)\n        try:\n            best = next(iterator)\n        except StopIteration:\n            raise MaxElementError(\"empty sequence\")\n\n        for item in iterator:\n            try:\n                if item > best:\n                    best = item\n            except TypeError as e:\n                raise MaxElementError(f\"non-comparable items: {e}\")\n        return best\n\n    def _compare(self, a: Any, b: Any) -> bool:\n        \"\"\"Helper for comparison; returns True if a > b.\"\"\"\n        try:\n            return a > b\n        except TypeError as e:\n            raise MaxElementError(f\"comparison failed: {e}\")\n\n# src/max_element_lib/utils.py\nimport json\nfrom typing import List, Any, Iterable\nfrom .exceptions import MaxElementError\n\nclass InputValidator:\n    \"\"\"Utility for parsing and validating input lists from various sources.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def parse_from_args(self, args: List[str]) -> List[Any]:\n        \"\"\"Parses a list of string arguments, supporting JSON array for single arg.\"\"\"\n        if not args:\n            raise MaxElementError(\"no input provided via arguments\")\n\n        if len(args) == 1 and args[0].strip().startswith('['):\n            try:\n                parsed = json.loads(args[0])\n                if not isinstance(parsed, list):\n                    raise MaxElementError(\"JSON input must be an array\")\n                return parsed\n            except json.JSONDecodeError as e:\n                raise MaxElementError(f\"invalid JSON input: {e}\")\n        \n        return [self._parse_token(t) for t in args]\n\n    def parse_from_string(self, s: str) -> List[Any]:\n        \"\"\"Parses a single string, splitting by whitespace into a list of values.\"\"\"\n        tokens = s.strip().split()\n        return [self._parse_token(t) for t in tokens]\n\n    def _parse_token(self, t: str) -> Any:\n        \"\"\"Attempts to convert a string token to int, float, or keeps as string.\"\"\"\n        for conv in (int, float):\n            try:\n                return conv(t)\n            except ValueError:\n                continue\n        return t\n\n    def ensure_non_empty(self, items: Iterable[Any]) -> None:\n        \"\"\"Raises MaxElementError if the iterable is empty.\"\"\"\n        if not any(True for _ in items):\n            raise MaxElementError(\"empty input\")\n\n# src/max_element_lib/max_element_service.py\nfrom typing import Iterable, Any\nfrom .max_element_finder import MaxElementFinder\nfrom .utils import InputValidator\nfrom .models import ResultDTO\nfrom .exceptions import MaxElementError\n\nclass MaxElementService:\n    \"\"\"Orchestrates input validation, calls the finder, and wraps results.\"\"\"\n    def __init__(self, finder: MaxElementFinder = None, validator: InputValidator = None) -> None:\n        self.finder = finder or MaxElementFinder()\n        self.validator = validator or InputValidator()\n\n    def find_max(self, items: Iterable[Any]) -> ResultDTO[Any]:\n        \"\"\"Validates input, finds the max, and returns a ResultDTO.\"\"\"\n        try:\n            if not isinstance(items, list): # Materialize iterable to a list for multiple passes.\n                items = list(items)\n            \n            self.validator.ensure_non_empty(items)\n            result = self.finder.find_max(items)\n            return ResultDTO(result=result, success=True)\n        except MaxElementError:\n            raise # Propagate expected domain errors.\n        except Exception as e:\n            raise MaxElementError(f\"an unexpected service error occurred: {e}\") from e\n\n# src/max_element_lib/max_element_controller.py\nimport sys\nfrom typing import List, Optional\nfrom .max_element_service import MaxElementService\nfrom .exceptions import MaxElementError\n\nDEFAULT_EXIT_SUCCESS = 0\nDEFAULT_EXIT_FAILURE = 1\nDEFAULT_EXIT_USAGE = 2\n\nclass MaxElementController:\n    \"\"\"Handles CLI input parsing, service invocation, and output formatting.\"\"\"\n    def __init__(self, service: MaxElementService) -> None:\n        self.service = service\n        self.validator = service.validator \n\n    def run(self, argv: List[str], stdin_content: Optional[str] = None) -> int:\n        \"\"\"Main entrypoint for the CLI, parses input and prints results or errors.\"\"\"\n        try:\n            if argv:\n                items = self.validator.parse_from_args(argv)\n            elif stdin_content is not None and stdin_content.strip():\n                items = self.validator.parse_from_string(stdin_content)\n            else:\n                raise MaxElementError(\"No input provided. Use arguments or pipe to stdin.\")\n            \n            dto = self.service.find_max(items)\n            self._print_result(dto)\n            return DEFAULT_EXIT_SUCCESS\n        except MaxElementError as e:\n            print(f\"Error: {e.message}\", file=sys.stderr)\n            # Simple heuristic to distinguish usage errors for specific messages.\n            if \"invalid JSON\" in e.message or \"no input\" in e.message:\n                return DEFAULT_EXIT_USAGE\n            return DEFAULT_EXIT_FAILURE\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return DEFAULT_EXIT_FAILURE\n\n    def _print_result(self, dto) -> None:\n        \"\"\"Prints the result to standard output.\"\"\"\n        if dto.success:\n            print(dto.result)\n\n# src/max_element_lib/__init__.py\nfrom typing import Iterable, Any\nfrom .max_element_service import MaxElementService\nfrom .max_element_finder import MaxElementFinder\nfrom .utils import InputValidator\nfrom .exceptions import MaxElementError\nfrom .models import ResultDTO\n\n__all__ = [\n    \"max_element\",\n    \"MaxElementFinder\",\n    \"MaxElementService\",\n    \"InputValidator\",\n    \"MaxElementError\",\n    \"ResultDTO\"\n]\n\ndef max_element(items: Iterable[Any]) -> Any:\n    \"\"\"Facade function: returns the maximum element or raises MaxElementError.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    service = MaxElementService()\n    dto = service.find_max(items)\n    return dto.result\n\n# src/__main__.py\nimport sys\nfrom .max_element_lib.max_element_service import MaxElementService\nfrom .max_element_lib.max_element_controller import MaxElementController\n\ndef main() -> int:\n    \"\"\"CLI entrypoint: constructs dependencies and runs the controller.\"\"\"\n    service = MaxElementService()\n    controller = MaxElementController(service)\n\n    stdin_content = None\n    if not sys.stdin.isatty():\n        stdin_content = sys.stdin.read()\n\n    return_code = controller.run(sys.argv[1:], stdin_content)\n    return return_code\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n\n# pyproject.toml\n\"\"\"\n[project]\nname = \"max_element_lib\"\nversion = \"0.1.0\"\ndescription = \"A small library and CLI tool to compute the maximum element of a list/sequence.\"\nauthors = [{ name = \"Your Name\", email = \"your.email@example.com\" }]\nreadme = \"README.md\"\nrequires-python = \">=3.9\"\ndependencies = []\n\n[project.scripts]\nmax-element = \"max_element_lib.__main__:main\"\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[tool.setuptools.packages.find]\nwhere = [\"src\"]\n\n[tool.pytest.ini_options]\npythonpath = [\"src\"]\naddopts = \"--doctest-modules\"\n\"\"\"\n\n# README.md\n\"\"\"\n# Max Element Library and CLI\n\nThis project provides a small, well-tested Python library and CLI tool for computing the maximum element of a list/sequence.\n\n## Installation\n\n```bash\ngit clone <repository-url>\ncd max_element_lib\npip install .\n```\n\nAlternatively, if published to PyPI:\n```bash\npip install max-element-lib\n```\n\n## Usage\n\n### Library\n\nYou can import the `max_element` function or the `MaxElementService` class into your Python projects.\n\n```python\nfrom max_element_lib import max_element, MaxElementError\nfrom max_element_lib.max_element_service import MaxElementService\n\n# Using the facade function\ntry:\n    result = max_element([10, 2, 8, 15, -3])\n    print(f\"Max element: {result}\")\n\n    result_str = max_element([\"apple\", \"banana\", \"cherry\"])\n    print(f\"Max string: {result_str}\")\n\n    # Empty list raises an error\n    max_element([])\nexcept MaxElementError as e:\n    print(f\"Error: {e.message}\")\n\n# Using the service directly\nservice = MaxElementService()\ntry:\n    dto = service.find_max([1.1, 2.2, 0.5])\n    print(f\"Service result: {dto.result}\")\nexcept MaxElementError as e:\n    print(f\"Service Error: {e.message}\")\n```\n\n### Command Line Interface (CLI)\n\nThe `max-element` command can be used from your terminal.\n\n**1. Using space-separated arguments:**\n\n```bash\nmax-element 1 2 3 4 5\n# Output: 5\n\nmax-element 10 -5 20 0 15\n# Output: 20\n\nmax-element apple banana cherry\n# Output: cherry\n```\n\n**2. Using a JSON array as a single argument:**\n\n```bash\nmax-element '[10, 20, 5, 30]'\n# Output: 30\n\nmax-element '[\"alpha\", \"beta\", \"gamma\"]'\n# Output: gamma\n```\n\n**3. Piping input from stdin:**\n\n```bash\necho \"100 50 150 25\" | max-element\n# Output: 150\n\necho '[{\"value\": 1}, {\"value\": 2}]' | max-element\n# Error: non-comparable items: '>' not supported between instances of 'dict' and 'dict'\n```\n\n**Error Handling:**\n\nInvalid inputs will result in an error message to `stderr` and a non-zero exit code.\n\n```bash\nmax-element # No input\n# Error: No input provided. Use arguments or pipe to stdin.\n# Exit code: 2\n\nmax-element '[]' # Empty JSON array\n# Error: empty input\n# Exit code: 1\n\nmax-element '{\"key\": \"value\"}' # Invalid JSON type (not an array)\n# Error: JSON input must be an array\n# Exit code: 2\n```\n\n## Development\n\nThe project structure follows a standard Python package layout.\n\n**Testing:**\n\nTo run tests (requires `pytest`):\n\n```bash\npip install \"pytest>=7.0\"\npytest tests/\n```\n\nDoctests are also included and run with pytest:\n```bash\npytest --doctest-modules src/max_element_lib/__init__.py\n```\n\n## Architecture\n\nRefer to the design specification for detailed architecture, class diagrams, and sequence diagrams.\n\"\"\"\n```"}
{"task_id": "HumanEval/35", "solution": "```\npyproject.toml\n```toml\n[project]\nname = \"listutils\"\nversion = \"0.1.0\"\ndescription = \"A utility to compute the maximum element of a list.\"\nauthors = [{ name = \"Your Name\", email = \"your.email@example.com\" }]\nrequires-python = \">=3.8\"\ndependencies = [\n    \"Flask>=2.0\",\n]\n\n[project.scripts]\nlistutils = \"listutils.runner:main\"\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n```\n\n```README.md\n# ListUtils\n\nA Python library, CLI tool, and HTTP API for computing the maximum element of a list.\n\n## Features\n\n- **Library Function**: A pure-Python function to get the maximum element.\n- **CLI Tool**: `listutils` command to compute max from terminal, supporting positional arguments and stdin JSON.\n- **HTTP API**: A simple `POST /max` endpoint for integration with other services.\n- **Robust Error Handling**: Clear exceptions and input validation.\n- **Unit Tested**: Comprehensive unit tests for core logic and interfaces.\n- **Easy Packaging**: Distributed via `pyproject.toml`.\n\n## Installation\n\n```bash\npip install .\n```\n(Or `pip install git+https://github.com/your-repo/listutils.git` for direct install)\n\n## Usage\n\n### Library\n\n```python\nfrom listutils import compute_max, ListUtilsError\n\ntry:\n    result = compute_max([1, 2, 3])\n    print(f\"Max: {result}\") # Output: Max: 3\n\n    result = compute_max([5.5, 1.2, 9.8])\n    print(f\"Max: {result}\") # Output: Max: 9.8\n\n    result = compute_max([\"apple\", \"banana\", \"cherry\"])\n    print(f\"Max: {result}\") # Output: Max: cherry\n\n    compute_max([]) # This will raise ListUtilsError\nexcept ListUtilsError as e:\n    print(f\"Error: {e.message}\")\n```\n\n### CLI\n\n```bash\n# From positional arguments\nlistutils 10 20 5 15\n# Output: 20\n\n# From stdin (JSON array)\necho '[1, 5, 2, 8, 3]' | listutils --stdin\n# Output: 8\n\n# From stdin (JSON array) with JSON output\necho '[\"alpha\", \"beta\", \"gamma\"]' | listutils --stdin --json\n# Output: {\"max\": \"gamma\"}\n\n# Error case: empty list\necho '[]' | listutils --stdin\n# Output: Error: input list must not be empty (and exits with code 2)\n```\n\n### HTTP API\n\nThe API runs on Flask. To start it:\n\n```bash\nflask --app listutils.api:APIController().create_app run\n```\n\nThen you can make requests using `curl` or similar:\n\n```bash\n# Success\ncurl -X POST -H \"Content-Type: application/json\" -d '[10, 20, 5, 15]' http://127.0.0.1:5000/max\n# Output: {\"max\":20}\n\n# Error: Empty list\ncurl -X POST -H \"Content-Type: application/json\" -d '[]' http://127.0.0.1:5000/max\n# Output: {\"error\":\"input list must not be empty\"}\n\n# Error: Invalid JSON\ncurl -X POST -H \"Content-Type: application/json\" -d '{\"not_a_list\": [1,2,3]}' http://127.0.0.1:5000/max\n# Output: {\"error\":\"payload must be a JSON list\"}\n```\n\n## Development\n\n### Running Tests\n\n```bash\npip install pytest Flask\npytest\n```\n\n### CI/CD\n\nA GitHub Actions workflow is provided at `.github/workflows/ci.yml` to run tests automatically.\n\n## License\n\nThis project is licensed under the MIT License - see the `LICENSE` file for details.\n```\n\n```LICENSE\nMIT License\n\nCopyright (c) 2023 Your Name\n\nPermission is hereby granted, free of charge, to any person obtaining a copy\nof this software and associated documentation files (the \"Software\"), to deal\nin the Software without restriction, including without limitation the rights\nto use, copy, modify, merge, publish, distribute, sublicense, and/or sell\ncopies of the Software, and to permit persons to whom the Software is\nfurnished to do so, subject to the following conditions:\n\nThe above copyright notice and this permission notice shall be included in all\ncopies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\nIMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\nFITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\nAUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\nLIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\nOUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\nSOFTWARE.\n```\n\n```src/listutils/__init__.py\n\"\"\"\nListutils package for computing the maximum element of a list.\n\nExports MaxElementService and a convenience function compute_max.\n\"\"\"\nfrom .core import MaxElementService\nfrom .exceptions import ListUtilsError\nfrom typing import Any, List, Optional, Callable\n\n# Public convenience function for the library consumer\ndef compute_max(items: List[Any], comparator: Optional[Callable[[Any, Any], int]] = None) -> Any:\n    \"\"\"\n    Computes the maximum element in a list.\n\n    Args:\n        items: The list of comparable elements.\n        comparator: An optional custom comparison function.\n\n    Returns:\n        The maximum element from the list.\n\n    Raises:\n        ListUtilsError: If the list is empty or contains incomparable elements.\n    \"\"\"\n    return MaxElementService(comparator).compute_max(items)\n\n# Explicitly export key classes for direct import\n__all__ = [\"MaxElementService\", \"ListUtilsError\", \"compute_max\"]\n```\n\n```src/listutils/core.py\n\"\"\"\nCore service for computing the maximum element.\n\"\"\"\nfrom .exceptions import ListUtilsError\nfrom .utils import ValidationUtils\nfrom .models import MaxElementResult\nfrom typing import Any, Callable, Optional, List\n\nclass MaxElementService:\n    \"\"\"\n    Service responsible for computing the maximum element in a list.\n    Handles internal comparison logic and error wrapping.\n    \"\"\"\n    def __init__(self, comparator: Optional[Callable[[Any, Any], int]] = None) -> None:\n        \"\"\"\n        Initializes the MaxElementService with an optional custom comparator.\n        \"\"\"\n        self._comparator = comparator\n\n    def compute_max(self, items: List[Any]) -> Any:\n        \"\"\"\n        Returns the maximum element from a list.\n\n        Args:\n            items: A list of comparable elements.\n\n        Returns:\n            The maximum element.\n\n        Raises:\n            ListUtilsError: If the list is empty or elements are not comparable.\n        \"\"\"\n        ValidationUtils.ensure_non_empty(items)\n        candidate = items[0]\n        for item in items[1:]:\n            try:\n                if self._compare(item, candidate) > 0:\n                    candidate = item\n            except TypeError as e:\n                # Wrap TypeError in ListUtilsError for consistent error handling\n                raise ListUtilsError(f\"incomparable elements found: {e}\", status_code=400) from e\n        return MaxElementResult(candidate).value\n\n    def _compare(self, a: Any, b: Any) -> int:\n        \"\"\"\n        Compares two elements. Returns 1 if a > b, 0 if equal, -1 if a < b.\n        Uses the injected comparator if available, otherwise native Python comparison.\n        \"\"\"\n        if self._comparator:\n            return self._comparator(a, b)\n        if a > b:\n            return 1\n        if a == b:\n            return 0\n        return -1\n```\n\n```src/listutils/models.py\n\"\"\"\nData Transfer Objects (DTOs) for the listutils package.\n\"\"\"\nfrom typing import Any\n\nclass MaxElementResult:\n    \"\"\"\n    A simple DTO to wrap the result of the maximum element computation.\n    \"\"\"\n    def __init__(self, value: Any) -> None:\n        \"\"\"\n        Initializes MaxElementResult with the computed maximum value.\n        \"\"\"\n        self.value = value\n\n    def to_json(self) -> dict:\n        \"\"\"\n        Returns a dictionary representation suitable for JSON serialization.\n        \"\"\"\n        return {\"max\": self.value}\n```\n\n```src/listutils/exceptions.py\n\"\"\"\nDomain-specific exceptions for the listutils package.\n\"\"\"\n\nclass ListUtilsError(Exception):\n    \"\"\"\n    Custom exception for errors specific to list utility operations.\n    Includes a message and an optional HTTP-like status code.\n    \"\"\"\n    def __init__(self, message: str, status_code: int = 400) -> None:\n        \"\"\"\n        Initializes a ListUtilsError with a message and a status code.\n        \"\"\"\n        super().__init__(message)\n        self.message = message\n        self.status_code = status_code\n```\n\n```src/listutils/utils.py\n\"\"\"\nUtility functions for input validation and parsing.\n\"\"\"\nimport json\nfrom typing import Any, List\nfrom .exceptions import ListUtilsError\n\nclass ValidationUtils:\n    \"\"\"\n    Provides static methods for validating and parsing various input formats.\n    \"\"\"\n    SUPPORTED_TYPES = (int, float, str)\n\n    @staticmethod\n    def parse_list_from_strings(args: List[str]) -> List[Any]:\n        \"\"\"\n        Converts a list of string arguments to a list of typed values.\n        Attempts to parse as int, then float, otherwise keeps as string.\n        \"\"\"\n        parsed_items: List[Any] = []\n        for arg in args:\n            try:\n                parsed_items.append(int(arg))\n            except ValueError:\n                try:\n                    parsed_items.append(float(arg))\n                except ValueError:\n                    parsed_items.append(arg) # Treat as string if not a number\n        return parsed_items\n\n    @staticmethod\n    def parse_json_list(payload: str) -> List[Any]:\n        \"\"\"\n        Parses a JSON string into a Python list and validates its structure.\n        Ensures the payload is a JSON array and elements are primitive types.\n        \"\"\"\n        try:\n            data = json.loads(payload)\n        except json.JSONDecodeError as e:\n            raise ListUtilsError(f\"invalid JSON payload: {e}\", status_code=400) from e\n        \n        if not isinstance(data, list):\n            raise ListUtilsError(\"payload must be a JSON list\", status_code=400)\n        \n        # Optional: Further validate elements if needed (e.g., all numbers, etc.)\n        # For now, trust the MaxElementService comparison to catch incomparable types.\n        return data\n\n    @staticmethod\n    def ensure_non_empty(items: List[Any]) -> None:\n        \"\"\"\n        Raises ListUtilsError if the provided list is empty.\n        \"\"\"\n        if not items:\n            raise ListUtilsError(\"input list must not be empty\", status_code=400)\n```\n\n```src/listutils/cli.py\n\"\"\"\nCLI controller for the listutils command-line interface.\n\"\"\"\nimport sys\nimport json\nimport argparse\nfrom typing import List, Any, Optional\n\nfrom .utils import ValidationUtils\nfrom .core import MaxElementService\nfrom .exceptions import ListUtilsError\n\nclass CLIController:\n    \"\"\"\n    Handles command-line argument parsing, interaction with the MaxElementService,\n    and output presentation for the CLI tool.\n    \"\"\"\n    DEFAULT_JSON_FLAG = \"--json\"\n    DEFAULT_STDIN_FLAG = \"--stdin\"\n\n    def __init__(self, argv: Optional[List[str]] = None) -> None:\n        \"\"\"\n        Initializes the CLIController with command-line arguments.\n        \"\"\"\n        self.argv = argv if argv is not None else sys.argv[1:]\n        self.json_out = self.DEFAULT_JSON_FLAG in self.argv\n        \n        # Parse arguments using argparse for better structure\n        parser = argparse.ArgumentParser(\n            description=\"Compute the maximum element of a list.\",\n            prog=\"listutils\"\n        )\n        parser.add_argument(\n            \"values\",\n            nargs=\"*\",\n            help=\"Elements of the list (numbers or strings).\",\n        )\n        parser.add_argument(\n            self.DEFAULT_STDIN_FLAG,\n            action=\"store_true\",\n            help=\"Read a JSON array from stdin.\",\n        )\n        parser.add_argument(\n            self.DEFAULT_JSON_FLAG,\n            action=\"store_true\",\n            help=\"Output result as JSON.\",\n        )\n        self.args = parser.parse_args(self.argv)\n\n\n    def run(self) -> int:\n        \"\"\"\n        Main execution flow for the CLI. Parses input, calls the service,\n        and prints the result or error message.\n        Returns 0 on success, non-zero on failure.\n        \"\"\"\n        try:\n            items: List[Any]\n            \n            if self.args.stdin:\n                payload = sys.stdin.read()\n                items = ValidationUtils.parse_json_list(payload)\n            elif self.args.values:\n                items = ValidationUtils.parse_list_from_strings(self.args.values)\n            else:\n                # If no positional args and --stdin is not used, check if stdin is piped\n                # This handles cases like `echo \"[1,2,3]\" | listutils` without --stdin flag\n                if not sys.stdin.isatty():\n                    payload = sys.stdin.read()\n                    items = ValidationUtils.parse_json_list(payload)\n                else:\n                    raise ListUtilsError(\"No input provided. Use positional arguments, --stdin, or pipe a JSON array.\", status_code=2)\n\n            result = MaxElementService().compute_max(items)\n            \n            out = self._format_output(result, self.args.json)\n            print(out)\n            return 0\n        except ListUtilsError as e:\n            print(f\"Error: {e.message}\", file=sys.stderr)\n            return e.status_code # Use status_code from error as exit code if available, otherwise default to 2\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1\n\n    def _format_output(self, result: Any, json_out: bool) -> str:\n        \"\"\"\n        Formats the output string based on the --json flag.\n        \"\"\"\n        if json_out:\n            return json.dumps({\"max\": result})\n        return str(result)\n```\n\n```src/listutils/api.py\n\"\"\"\nHTTP API controller (Flask app factory) for the listutils service.\n\"\"\"\nfrom flask import Flask, request, jsonify\nfrom typing import List, Any, Tuple\nimport logging\n\nfrom .utils import ValidationUtils\nfrom .core import MaxElementService\nfrom .exceptions import ListUtilsError\n\n# Set up logging for the API\nlogging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')\nlogger = logging.getLogger(__name__)\n\nclass APIController:\n    \"\"\"\n    Manages the Flask application, defining routes and handling HTTP requests\n    for the maximum element computation service.\n    \"\"\"\n    def create_app(self) -> Flask:\n        \"\"\"\n        Creates and configures the Flask application.\n        \"\"\"\n        app = Flask(__name__)\n\n        @app.route(\"/max\", methods=[\"POST\"])\n        def max_route() -> Tuple[dict, int]:\n            \"\"\"\n            Handles POST requests to /max to compute the maximum element.\n            Accepts a JSON array in the request body.\n            \"\"\"\n            logger.info(f\"Received /max request from {request.remote_addr}\")\n            try:\n                # Ensure Content-Type is application/json\n                if not request.is_json:\n                    raise ListUtilsError(\"Content-Type must be application/json\", status_code=415) # Unsupported Media Type\n\n                request_data = request.get_data(as_text=True)\n                items = ValidationUtils.parse_json_list(request_data)\n                \n                result = MaxElementService().compute_max(items)\n                logger.info(f\"Successfully computed max: {result}\")\n                return jsonify({\"max\": result}), 200\n            except ListUtilsError as e:\n                logger.warning(f\"Client error in /max: {e.message} (Status: {e.status_code})\")\n                return jsonify({\"error\": e.message}), e.status_code\n            except Exception as e:\n                logger.exception(\"Unhandled server error in /max endpoint\")\n                return jsonify({\"error\": \"internal server error\"}), 500\n        \n        # Global error handler for 404 (Not Found)\n        @app.errorhandler(404)\n        def not_found_error(error) -> Tuple[dict, int]:\n            logger.warning(f\"Not Found: {request.path}\")\n            return jsonify({\"error\": \"Resource not found\"}), 404\n\n        # Global error handler for 405 (Method Not Allowed)\n        @app.errorhandler(405)\n        def method_not_allowed_error(error) -> Tuple[dict, int]:\n            logger.warning(f\"Method Not Allowed: {request.method} {request.path}\")\n            return jsonify({\"error\": \"Method not allowed\"}), 405\n\n        return app\n```\n\n```src/listutils/runner.py\n\"\"\"\nCLI entrypoint function for the listutils package.\n\"\"\"\nimport sys\nfrom typing import List, Optional\n\nfrom .cli import CLIController\n\ndef main(argv: Optional[List[str]] = None) -> int:\n    \"\"\"\n    Main entry point for the listutils CLI tool.\n    Initializes and runs the CLIController.\n    \"\"\"\n    controller = CLIController(argv)\n    return controller.run()\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n```\n\n```src/listutils/__main__.py\n\"\"\"\nAllows listutils to be run as a module (e.g., python -m listutils).\n\"\"\"\nimport sys\nfrom .runner import main\n\ndef main_module() -> None:\n    \"\"\"\n    Entry point for 'python -m listutils'.\n    \"\"\"\n    sys.exit(main(sys.argv[1:]))\n\nif __name__ == \"__main__\":\n    main_module()\n```\n\n```tests/test_core.py\n\"\"\"\nUnit tests for the MaxElementService in listutils/core.py.\n\"\"\"\nimport pytest\nfrom src.listutils.core import MaxElementService\nfrom src.listutils.exceptions import ListUtilsError\nfrom src.listutils.models import MaxElementResult\n\nclass TestMaxElementService:\n\n    def test_compute_max_positive_integers(self):\n        \"\"\"Test with a list of positive integers.\"\"\"\n        assert MaxElementService().compute_max([1, 2, 3]) == 3\n        assert MaxElementService().compute_max([5, 3, 9, 0, 1]) == 9\n        assert MaxElementService().compute_max([7]) == 7\n\n    def test_compute_max_negative_integers(self):\n        \"\"\"Test with a list of negative integers.\"\"\"\n        assert MaxElementService().compute_max([-1, -5, -3]) == -1\n        assert MaxElementService().compute_max([-10, -1, -50]) == -1\n\n    def test_compute_max_mixed_integers(self):\n        \"\"\"Test with a list of mixed positive, negative, and zero integers.\"\"\"\n        assert MaxElementService().compute_max([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10]) == 123\n        assert MaxElementService().compute_max([-1, 0, 1]) == 1\n\n    def test_compute_max_floats(self):\n        \"\"\"Test with a list of floating-point numbers.\"\"\"\n        assert MaxElementService().compute_max([1.1, 2.2, 3.3]) == 3.3\n        assert MaxElementService().compute_max([0.5, 0.1, 0.9, 0.3]) == 0.9\n        assert MaxElementService().compute_max([-1.5, -0.5, -2.0]) == -0.5\n\n    def test_compute_max_mixed_numbers(self):\n        \"\"\"Test with a list of mixed integers and floats.\"\"\"\n        assert MaxElementService().compute_max([1, 2.5, 3, 1.9]) == 3\n        assert MaxElementService().compute_max([10.0, 9]) == 10.0\n        assert MaxElementService().compute_max([-5, -4.5, -6]) == -4.5\n\n    def test_compute_max_strings(self):\n        \"\"\"Test with a list of strings (lexicographical comparison).\"\"\"\n        assert MaxElementService().compute_max([\"apple\", \"banana\", \"cherry\"]) == \"cherry\"\n        assert MaxElementService().compute_max([\"zebra\", \"apple\", \"cat\"]) == \"zebra\"\n        assert MaxElementService().compute_max([\"foo\", \"bar\", \"baz\"]) == \"foo\" # 'f' > 'b'\n\n    def test_compute_max_empty_list(self):\n        \"\"\"Test with an empty list, expecting ListUtilsError.\"\"\"\n        with pytest.raises(ListUtilsError, match=\"input list must not be empty\"):\n            MaxElementService().compute_max([])\n\n    def test_compute_max_incomparable_types(self):\n        \"\"\"Test with a list containing incomparable types, expecting ListUtilsError.\"\"\"\n        with pytest.raises(ListUtilsError, match=\"incomparable elements found\"):\n            MaxElementService().compute_max([1, \"a\"])\n        with pytest.raises(ListUtilsError, match=\"incomparable elements found\"):\n            MaxElementService().compute_max([1, [2]])\n        with pytest.raises(ListUtilsError, match=\"incomparable elements found\"):\n            MaxElementService().compute_max([1.0, \"b\"])\n\n    def test_compute_max_duplicate_max(self):\n        \"\"\"Test with a list containing duplicate maximum elements.\"\"\"\n        assert MaxElementService().compute_max([1, 5, 3, 5]) == 5\n        assert MaxElementService().compute_max([7, 7, 7]) == 7\n\n    def test_compute_max_with_custom_comparator(self):\n        \"\"\"Test with a custom comparator function (e.g., for string length).\"\"\"\n        def compare_by_len(a: str, b: str) -> int:\n            if len(a) > len(b): return 1\n            if len(a) == len(b): return 0\n            return -1\n        \n        service = MaxElementService(comparator=compare_by_len)\n        assert service.compute_max([\"a\", \"bb\", \"ccc\", \"d\"]) == \"ccc\"\n        assert service.compute_max([\"apple\", \"banana\", \"kiwi\"]) == \"banana\" # 'banana' length 6, 'apple' 5, 'kiwi' 4\n\n    def test_compute_max_returns_value(self):\n        \"\"\"Ensure compute_max returns the raw value, not MaxElementResult object.\"\"\"\n        result = MaxElementService().compute_max([1, 2, 3])\n        assert not isinstance(result, MaxElementResult)\n        assert result == 3\n```\n\n```tests/test_utils.py\n\"\"\"\nUnit tests for the ValidationUtils in listutils/utils.py.\n\"\"\"\nimport pytest\nimport json\nfrom src.listutils.utils import Valida