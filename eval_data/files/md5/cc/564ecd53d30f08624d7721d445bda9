ists(db_file):\n        os.remove(db_file)\n\n@pytest.fixture\ndef history_repo(tmp_db_path):\n    \"\"\"Provides a HistoryRepository instance connected to a temporary database.\"\"\"\n    repo = HistoryRepository(tmp_db_path)\n    yield repo\n    repo.close()\n\n```\n\n---\n### `tests/test_encoder.py`\n```python\nimport pytest\nfrom cycliccoder.EncoderService import EncoderService\nfrom cycliccoder.Exceptions import InvalidInputError\nfrom cycliccoder.HistoryRepository import HistoryRepository\nfrom cycliccoder.Utils import Utils\nfrom datetime import datetime\n\nclass MockHistoryRepository:\n    \"\"\"A mock repository for testing persistence behavior without actual DB IO.\"\"\"\n    def __init__(self):\n        self.records = []\n    \n    def add(self, record):\n        self.records.append(record)\n        return len(self.records)\n\n    def list_recent(self, limit=50):\n        return self.records[-limit:]\n\n@pytest.fixture\ndef encoder_service():\n    \"\"\"Provides an EncoderService instance without persistence.\"\"\"\n    return EncoderService(repo=None, utils=Utils())\n\n@pytest.fixture\ndef encoder_service_with_mock_repo():\n    \"\"\"Provides an EncoderService instance with a mock repository.\"\"\"\n    mock_repo = MockHistoryRepository()\n    return EncoderService(repo=mock_repo, utils=Utils()), mock_repo\n\ndef test_encode_empty_string(encoder_service):\n    \"\"\"Tests encoding an empty string.\"\"\"\n    assert encoder_service.encode(\"\") == \"\"\n\ndef test_encode_basic_groups(encoder_service):\n    \"\"\"Tests encoding strings with complete groups of three.\"\"\"\n    assert encoder_service.encode(\"abcdef\") == \"bcaefd\"\n    assert encoder_service.encode(\"xyzabc\") == \"yzxabc\"\n\ndef test_encode_partial_group_one_char(encoder_service):\n    \"\"\"Tests encoding with a partial group of one character.\"\"\"\n    assert encoder_service.encode(\"a\") == \"a\"\n    assert encoder_service.encode(\"abcde\") == \"bcaed\"\n    assert encoder_service.encode(\"abcdefg\") == \"bcaefdg\"\n\ndef test_encode_partial_group_two_chars(encoder_service):\n    \"\"\"Tests encoding with a partial group of two characters.\"\"\"\n    assert encoder_service.encode(\"ab\") == \"ab\"\n    assert encoder_service.encode(\"abcd\") == \"bcad\"\n    assert encoder_service.encode(\"abcdefh\") == \"bcaefdh\"\n\ndef test_encode_single_group(encoder_service):\n    \"\"\"Tests encoding a single group of three.\"\"\"\n    assert encoder_service.encode(\"abc\") == \"bca\"\n    assert encoder_service.encode(\"xyz\") == \"yzx\"\n\ndef test_encode_various_lengths(encoder_service):\n    \"\"\"Tests encoding strings of various lengths.\"\"\"\n    assert encoder_service.encode(\"1\") == \"1\"\n    assert encoder_service.encode(\"12\") == \"12\"\n    assert encoder_service.encode(\"123\") == \"231\"\n    assert encoder_service.encode(\"1234\") == \"2314\"\n    assert encoder_service.encode(\"12345\") == \"23145\"\n    assert encoder_service.encode(\"123456\") == \"231564\"\n\ndef test_encode_with_special_characters(encoder_service):\n    \"\"\"Tests encoding strings with special characters.\"\"\"\n    assert encoder_service.encode(\"!@#\") == \"@#!\"\n    assert encoder_service.encode(\" $ % ^ & *\") == \"$ %^ &*!\"\n\ndef test_encode_invalid_input_raises_error():\n    \"\"\"Tests that encoding non-string input raises InvalidInputError.\"\"\"\n    svc = EncoderService()\n    with pytest.raises(InvalidInputError):\n        svc.encode(123) # type: ignore\n    with pytest.raises(InvalidInputError):\n        svc.encode(None) # type: ignore\n    with pytest.raises(InvalidInputError):\n        svc.encode([\"a\", \"b\", \"c\"]) # type: ignore\n\ndef test_encode_persist_history(encoder_service_with_mock_repo):\n    \"\"\"Tests that encode operation is persisted when requested.\"\"\"\n    svc, mock_repo = encoder_service_with_mock_repo\n    original_len = len(mock_repo.records)\n    \n    encoded = svc.encode(\"test\", persist=True)\n    assert encoded == \"estt\"\n    assert len(mock_repo.records) == original_len + 1\n    record = mock_repo.records[-1]\n    assert record.input_text == \"test\"\n    assert record.output_text == \"estt\"\n    assert record.operation == \"encode\"\n\ndef test_encode_no_persist_history(encoder_service_with_mock_repo):\n    \"\"\"Tests that encode operation is NOT persisted when not requested.\"\"\"\n    svc, mock_repo = encoder_service_with_mock_repo\n    original_len = len(mock_repo.records)\n    \n    encoded = svc.encode(\"test\", persist=False)\n    assert encoded == \"estt\"\n    assert len(mock_repo.records) == original_len # No new record\n    \n    # Also test with a service initialized without a repo\n    svc_no_repo = EncoderService(repo=None)\n    encoded_no_repo = svc_no_repo.encode(\"abc\", persist=True) # persist=True but no repo\n    assert encoded_no_repo == \"bca\" # Still works\n    # Functionally, no persistence would occur here.\n\n```\n\n---\n### `tests/test_decoder.py`\n```python\nimport pytest\nfrom cycliccoder.DecoderService import DecoderService\nfrom cycliccoder.EncoderService import EncoderService # For round-trip testing\nfrom cycliccoder.Exceptions import InvalidInputError\nfrom cycliccoder.HistoryRepository import HistoryRepository\nfrom cycliccoder.Utils import Utils\nfrom datetime import datetime\n\nclass MockHistoryRepository:\n    \"\"\"A mock repository for testing persistence behavior without actual DB IO.\"\"\"\n    def __init__(self):\n        self.records = []\n    \n    def add(self, record):\n        self.records.append(record)\n        return len(self.records)\n\n    def list_recent(self, limit=50):\n        return self.records[-limit:]\n\n@pytest.fixture\ndef decoder_service():\n    \"\"\"Provides a DecoderService instance without persistence.\"\"\"\n    return DecoderService(repo=None, utils=Utils())\n\n@pytest.fixture\ndef decoder_service_with_mock_repo():\n    \"\"\"Provides a DecoderService instance with a mock repository.\"\"\"\n    mock_repo = MockHistoryRepository()\n    return DecoderService(repo=mock_repo, utils=Utils()), mock_repo\n\n@pytest.fixture\ndef encoder_service_for_round_trip():\n    \"\"\"Provides an EncoderService for round-trip tests.\"\"\"\n    return EncoderService(repo=None, utils=Utils())\n\ndef test_decode_empty_string(decoder_service):\n    \"\"\"Tests decoding an empty string.\"\"\"\n    assert decoder_service.decode(\"\") == \"\"\n\ndef test_decode_basic_groups(decoder_service):\n    \"\"\"Tests decoding strings with complete groups of three.\"\"\"\n    assert decoder_service.decode(\"bcaefd\") == \"abcdef\"\n    assert decoder_service.decode(\"yzxabc\") == \"xyzabc\"\n\ndef test_decode_partial_group_one_char(decoder_service):\n    \"\"\"Tests decoding with a partial group of one character.\"\"\"\n    assert decoder_service.decode(\"a\") == \"a\"\n    assert decoder_service.decode(\"bcaed\") == \"abcde\"\n    assert decoder_service.decode(\"bcaefdg\") == \"abcdefg\"\n\ndef test_decode_partial_group_two_chars(decoder_service):\n    \"\"\"Tests decoding with a partial group of two characters.\"\"\"\n    assert decoder_service.decode(\"ab\") == \"ab\"\n    assert decoder_service.decode(\"bcad\") == \"abcd\"\n    assert decoder_service.decode(\"bcaefdh\") == \"abcdefh\"\n\ndef test_decode_single_group(decoder_service):\n    \"\"\"Tests decoding a single group of three.\"\"\"\n    assert decoder_service.decode(\"bca\") == \"abc\"\n    assert decoder_service.decode(\"yzx\") == \"xyz\"\n\ndef test_decode_idempotency_for_non_encoded_strings(decoder_service):\n    \"\"\"\n    Tests that decoding a string that was not necessarily encoded\n    still applies the transformation correctly.\n    \"\"\"\n    # According to FR2: \"decode must be idempotent for non-encoded strings too\"\n    # This implies decode(s) == s if s was not result of encode.\n    # However, the transformation logic (right-rotate any 3-char group) means\n    # decode(\"hello\") -> \"elloh\", which is not \"hello\".\n 