{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"\n    Finds the strongest extension based on letter case count and returns it formatted with the class name.\n    Ties are broken by the extension's original position in the input list.\n    \"\"\"\n\n    # Helper function to count uppercase and lowercase ASCII letters in a string.\n    def _count_case_letters(ext_name):\n        cap_count = 0\n        sm_count = 0\n        for char in ext_name:\n            if 'A' <= char <= 'Z':\n                cap_count += 1\n            elif 'a' <= char <= 'z':\n                sm_count += 1\n        return cap_count, sm_count\n\n    strongest_extension = None\n    max_strength = -float('inf') \n\n    for extension in extensions:\n        cap, sm = _count_case_letters(extension)\n        current_strength = cap - sm\n\n        # Selects the first extension encountered if strengths are equal.\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension = extension\n\n    return f\"{class_name}.{strongest_extension}\""}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension based on CAP - SM, handling ties by choosing the first occurrence.\n    Returns the class name combined with the strongest extension.\n    \"\"\"\n    max_strength = float('-inf')\n    strongest_extension_name = \"\"\n\n    for extension in extensions:\n        cap = 0\n        sm = 0\n        for char in extension:\n            if char.isupper():\n                cap += 1\n            elif char.islower():\n                sm += 1\n        \n        current_strength = cap - sm\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = extension\n            \n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"Checks if any rotation of string 'b' is a substring of string 'a'.\n    Returns True if found, False otherwise.\"\"\"\n    # An empty pattern is considered a substring of any string.\n    if not b:\n        return True\n\n    n = len(b)\n    # Generate all cyclical rotations of pattern b.\n    for i in range(n):\n        rotation = b[i:] + b[:i]\n        # Check if the current rotation is present in the text a.\n        if rotation in a:\n            return True\n            \n    # No rotation was found as a substring.\n    return False"}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\n    cycpattern_check(\"abcd\",\"abd\") => False\n    cycpattern_check(\"hello\",\"ell\") => True\n    cycpattern_check(\"whassup\",\"psus\") => False\n    cycpattern_check(\"abab\",\"baa\") => True\n    cycpattern_check(\"efef\",\"eeff\") => False\n    cycpattern_check(\"himenss\",\"simen\") => True\n\n    \"\"\"\n    if b == \"\":\n        return True\n\n    len_b = len(b)\n    doubled_b = b + b\n    \n    seen_rotations = set() \n\n    for i in range(len_b):\n        rotation = doubled_b[i : i + len_b]\n        if rotation in seen_rotations:\n            continue\n        seen_rotations.add(rotation)\n        \n        if rotation in a:\n            return True\n            \n    return False"}
