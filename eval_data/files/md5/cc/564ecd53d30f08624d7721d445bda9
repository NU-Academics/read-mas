{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Converts an integer (1-1000) to its lowercase Roman numeral representation.\n    Assumes valid integer input within the specified range [1, 1000].\n    \"\"\"\n    roman_map = [\n        (1000, \"M\"), (900, \"CM\"), (500, \"D\"), (400, \"CD\"),\n        (100, \"C\"), (90, \"XC\"), (50, \"L\"), (40, \"XL\"),\n        (10, \"X\"), (9, \"IX\"), (5, \"V\"), (4, \"IV\"), (1, \"I\")\n    ]\n    \n    result = []\n    \n    for value, symbol in roman_map:\n        while number >= value:\n            result.append(symbol)\n            number -= value\n            \n    return \"\".join(result).lower()"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    \"\"\"\n    ROMAN_MAP = [\n        (1000, \"m\"), (900, \"cm\"), (500, \"d\"), (400, \"cd\"),\n        (100, \"c\"), (90, \"xc\"), (50, \"l\"), (40, \"xl\"),\n        (10, \"x\"), (9, \"ix\"), (5, \"v\"), (4, \"iv\"), (1, \"i\")\n    ]\n    \n    result = []\n    n = number\n    for value, sym in ROMAN_MAP:\n        while n >= value:\n            result.append(sym)\n            n -= value\n        if n == 0:\n            break\n    return \"\".join(result)"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    \"\"\"\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    \"\"\"\n    def is_close(x, y, rel_tol=1e-9, abs_tol=0.0):\n        \"\"\"Returns True if x and y are close to each other based on tolerances.\"\"\"\n        return abs(x - y) <= max(rel_tol * max(abs(x), abs(y)), abs_tol)\n\n    side1 = float(a)\n    side2 = float(b)\n    side3 = float(c)\n\n    # Sort the sides to easily identify the two smaller sides and the largest side.\n    # This also handles cases where a, b, c might be in any order.\n    sides = sorted([side1, side2, side3])\n    s1, s2, s3 = sides[0], sides[1], sides[2]\n\n    # Check for right angle using the Pythagorean theorem, with tolerance.\n    # We compare the sum of squares of the two smaller sides to the square of the largest side.\n    return is_close(s1*s1 + s2*s2, s3*s3)"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"\n    Finds the word with the maximum number of unique characters from a list of strings.\n    If multiple words tie, the lexicographically smallest word is returned.\n    \"\"\"\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_count = len(set(word))\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            # If unique counts are tied, choose the lexicographically smallest word.\n            if word < result_word:\n                result_word = word\n    return result_word"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    '''\n    sides = sorted([float(a), float(b), float(c)])\n    s0_sq = sides[0] * sides[0]\n    s1_sq = sides[1] * sides[1]\n    s2_sq = sides[2] * sides[2]\n\n    # Use a configurable tolerance for robust floating point comparison.\n    tolerance = 1e-9\n    \n    diff = abs(s0_sq + s1_sq - s2_sq)\n    return diff <= tolerance or diff <= tolerance * max(abs(s0_sq + s1_sq), abs(s2_sq), 1.0)"}
{"task_id": "HumanEval/158", "solution": "```python\ndef find_max(words):\n    \"\"\"\n    Finds the word with the maximum number of unique characters.\n    If there's a tie, the lexicographically smallest word is returned.\n    \"\"\"\n    \n    scored_words = []\n    for word in words:\n        unique_chars_count = len(set(word))\n        # Use -unique_chars_count to prioritize higher unique counts when using min().\n        # Lexicographical order is handled naturally as the second element in the tuple.\n        scored_words.append((-unique_chars_count, word))\n    \n    # min() will first compare the negative unique char counts, then the words themselves.\n    best_score_tuple = min(scored_words)\n    \n    return best_score_tuple[1]\n```"}
