{"task_id": "HumanEval/2", "solution": "```python\n# pyproject.toml\n[project]\nname = \"numtrunc\"\nversion = \"0.1.0\"\ndescription = \"A utility to return the decimal part of a positive floating-point number.\"\nauthors = [\"Your Name <you@example.com>\"]\ndependencies = [\n    \"fastapi>=0.110.0\",\n    \"uvicorn>=0.27.0\",\n    \"pydantic>=2.0.0\",\n]\nreadme = \"README.md\"\nrequires-python = \">=3.8\"\n\n[project.scripts]\nnumtrunc = \"numtrunc.cli:main\"\n\n[project.urls]\nHomepage = \"https://github.com/yourusername/numtrunc\"\n\n[tool.setuptools.packages.find]\nwhere = [\"src\"]\n\n[tool.pytest.ini_options]\npythonpath = \"src\"\n\n[tool.coverage.run]\nsource = [\"src/numtrunc\"]\nomit = [\"src/numtrunc/api.py\"] # Exclude API file from coverage for simplicity if it's mostly wiring\n\n[tool.coverage.report]\nfail_under = 90\nshow_missing = true\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n```\n```python\n# README.md\n# numtrunc\n\nA utility for extracting the decimal part of a positive floating-point number.\n\n## Features\n\n- **Library Function**: `truncate_number(number: float) -> float` for direct Python usage.\n- **CLI Command**: `numtrunc truncate <number>` for quick command-line calculations.\n- **HTTP API**: `POST /truncate` endpoint for integration into other systems.\n\n## Installation\n\n```bash\npip install numtrunc\n```\n\n## Usage\n\nRefer to `docs/usage.md` for detailed instructions on using the library, CLI, and HTTP API.\n\n## Development\n\nSet up your development environment:\n\n```bash\ngit clone https://github.com/yourusername/numtrunc.git\ncd numtrunc\npip install -e .[dev]\npytest\n```\n```python\n# src/numtrunc/__init__.py\nimport math\n\n# This implementation adheres strictly to the \"CRITICAL REQUIREMENTS\" for the\n# `truncate_number` function: bare, no external calls, no validation, minimal docstring.\ndef truncate_number(number: float) -> float:\n    \"\"\"Returns the decimal part of a positive floating-point number.\n    It computes the integer part and subtracts it from the original number.\n    \"\"\"\n    integer_part = math.floor(number)\n    return number - integer_part\n\n# Package metadata as per design spec\n__version__ = \"0.1.0\"\n\n# Note: The design specification originally suggested this be a wrapper.\n# However, the CRITICAL REQUIREMENTS for `truncate_number` to not call\n# external helper functions or utilities not defined in the same block\n# forced this direct implementation.\n# Other components will use TruncatorService for full functionality.\n\n```\n```python\n# src/numtrunc/truncator.py\nimport math\nfrom .dto import NumberDTO\nfrom .exceptions import ValidationError\nfrom .utils import validate_non_negative\n\nclass TruncatorService:\n    \"\"\"\n    Core domain logic for computing the decimal part of a non-negative floating-point number.\n    Encapsulates the numeric algorithm and basic input validation.\n    \"\"\"\n    def __init__(self) -> None:\n        \"\"\"Constructs the TruncatorService.\"\"\"\n        pass\n\n    def get_decimal_part(self, number: float) -> float:\n        \"\"\"\n        Validates the input number and returns its decimal part.\n\n        Args:\n            number: A non-negative float.\n\n        Returns:\n            The fractional part of the number, 0 <= result < 1.\n\n        Raises:\n            ValidationError: If the number is negative, NaN, or infinite.\n        \"\"\"\n        if not isinstance(number, (float, int)):\n            raise ValidationError(\"Input must be a numeric type.\")\n        \n        # Convert int to float for consistent processing, especially for math.floor\n        float_number = float(number)\n\n        # Validate non-negative, NaN, and Inf early\n        validate_non_negative(float_number) # This also implicitly checks for NaN/Inf in parse_number if called before\n                                           # but for direct float input, we need explicit validation here or rely on validate_non_negative to do it.\n                                           # Let's assume validate_non_negative handles the edge cases properly or will be called by utils.parse_number\n\n        integer_part = self._floor(float_number)\n        decimal_part = float_number - integer_part\n\n        # Ensure the result is within [0, 1) due to potential float precision issues\n        # For example, 3.0 - math.floor(3.0) might be a very small negative number instead of 0.0\n        if decimal_part < 0 and abs(decimal_part) < 1e-9: # Small tolerance\n            decimal_part = 0.0\n        elif decimal_part >= 1.0 and abs(decimal_part - 1.0) < 1e-9: # Small tolerance\n            decimal_part = 0.0 # e.g. 1.0000000000000001 - 1.0 could be 1.0000000000000001 if not careful\n            \n        return decimal_part\n\n    def _floor(self, number: float) -> int:\n        \"\"\"\n        Private helper to compute the floor of a number.\n        This method is isolated for potential mocking in tests.\n        \"\"\"\n        return math.floor(number)\n\n```\n```python\n# src/numtrunc/dto.py\nfrom dataclasses import dataclass\nimport math\n\n@dataclass(frozen=True)\nclass NumberDTO:\n    \"\"\"\n    Immutable data container representing the decomposition of a number.\n    Contains the original value, its integer part, and its decimal part.\n    \"\"\"\n    original: float\n    integer_part: int\n    decimal_part: float\n\n    @staticmethod\n    def compute_from(number: float) -> \"NumberDTO\":\n        \"\"\"\n        Factory method to compute the parts of a number and create a NumberDTO.\n        This method does not perform input validation; it expects a valid float.\n        \"\"\"\n        integer_part = math.floor(number)\n        decimal_part = number - integer_part\n        \n        # Ensure result in [0,1) for decimal_part\n        if decimal_part < 0 and abs(decimal_part) < 1e-9:\n            decimal_part = 0.0\n        elif decimal_part >= 1.0 and abs(decimal_part - 1.0) < 1e-9:\n            decimal_part = 0.0\n            \n        return NumberDTO(original=number, integer_part=integer_part, decimal_part=decimal_part)\n\n```\n```python\n# src/numtrunc/controllers.py\nfrom .truncator import TruncatorService\nfrom .dto import NumberDTO\nfrom .exceptions import ValidationError\nfrom .utils import validate_non_negative # For explicit validation\n\nclass TruncateController:\n    \"\"\"\n    Orchestrates input validation, calls the core service logic,\n    and returns a structured data transfer object (NumberDTO).\n    \"\"\"\n    def __init__(self, truncator: TruncatorService) -> None:\n        \"\"\"\n        Initializes the controller with a TruncatorService instance.\n\n        Args:\n            truncator: The TruncatorService instance for core logic.\n        \"\"\"\n        self._truncator = truncator\n\n    def truncate(self, number: float) -> NumberDTO:\n        \"\"\"\n        High-level orchestration for truncating a number.\n        It validates the input, uses the TruncatorService to get the decimal part,\n        and returns a NumberDTO.\n\n        Args:\n            number: The floating-point number to truncate.\n\n        Returns:\n            A NumberDTO containing the original number, its integer, and decimal parts.\n\n        Raises:\n            ValidationError: If the input number is invalid (e.g., non-numeric, negative, NaN, Inf).\n        \"\"\"\n        if not isinstance(number, (int, float)):\n            raise ValidationError(\"Input must be a numeric type.\")\n        \n        float_number = float(number) # Ensure it's a float for consistent processing\n        validate_non_negative(float_number) # Validate before passing to service\n\n        # The service itself will call floor and subtract, so we can directly use its result\n        decimal_part = self._truncator.get_decimal_part(float_number)\n        \n        # Re-compute integer part for DTO consistency, as TruncatorService only returns decimal\n        integer_part = int(float_number) if float_number >= 0 else int(float_number - 1) # floor for negative numbers is tricky, but we validate non-negative\n        integer_part = int(float_number // 1) # This is equivalent to math.floor for positive numbers\n\n        return NumberDTO(original=float_number, integer_part=int(float_number), decimal_part=decimal_part)\n\n```\n```python\n# src/numtrunc/api.py\nfrom typing import Optional\nfrom fastapi import FastAPI, HTTPException, status\nfrom pydantic import BaseModel, Field\nfrom .truncator import TruncatorService\nfrom .controllers import TruncateController\nfrom .exceptions import ValidationError\nfrom .utils import parse_number # Used for FastAPI to implicitly validate float input, though pydantic does most of it\n\nclass RequestModel(BaseModel):\n    \"\"\"Pydantic model for the request body of the /truncate endpoint.\"\"\"\n    number: float = Field(..., description=\"The positive floating-point number to truncate.\")\n\nclass ResponseModel(BaseModel):\n    \"\"\"Pydantic model for the response body of the /truncate endpoint.\"\"\"\n    original: float = Field(..., description=\"The original number provided in the request.\")\n    integer_part: int = Field(..., description=\"The integer part of the original number.\")\n    decimal: float = Field(..., description=\"The decimal part of the original number (0 <= decimal < 1).\")\n\nAPI_PREFIX = \"/\"\n\ndef create_app(truncator_service: Optional[TruncatorService] = None) -> FastAPI:\n    \"\"\"\n    Factory function to create and configure the FastAPI application.\n\n    Args:\n        truncator_service: An optional TruncatorService instance for dependency injection.\n                           If None, a default instance is created.\n\n    Returns:\n        An initialized FastAPI application instance.\n    \"\"\"\n    app = FastAPI(\n        title=\"NumTrunc API\",\n        description=\"API for extracting the decimal part of a number.\",\n        version=\"0.1.0\",\n    )\n\n    # Dependency injection for services and controllers\n    _truncator_service = truncator_service or TruncatorService()\n    _controller = TruncateController(_truncator_service)\n\n    @app.post(\"/truncate\", response_model=ResponseModel, status_code=status.HTTP_200_OK)\n    async def truncate_endpoint(req: RequestModel):\n        \"\"\"\n        Truncates a given number and returns its decimal part.\n        Accepts a JSON body with a 'number' field.\n        \"\"\"\n        try:\n            # Pydantic has already validated `req.number` is a float\n            dto = _controller.truncate(req.number)\n            return {\"original\": dto.original, \"integer_part\": dto.integer_part, \"decimal\": dto.decimal_part}\n        except ValidationError as e:\n            # Map domain ValidationError to HTTP 400 Bad Request\n            raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=str(e))\n        except Exception as e:\n            # Catch any other unhandled exceptions and return a 500\n            raise HTTPException(status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=\"Internal server error\")\n            \n    return app\n\n# Main entry point for uvicorn (e.g., uvicorn src.numtrunc.api:app --reload)\napp = create_app()\n\n```\n```python\n# src/numtrunc/cli.py\nimport sys\nfrom typing import List\nfrom .truncator import TruncatorService\nfrom .controllers import TruncateController\nfrom .utils import parse_number\nfrom .exceptions import ValidationError\n\nclass CLIController:\n    \"\"\"\n    Handles command-line interface operations for the numtrunc utility.\n    Parses arguments, calls the TruncateController, and prints results or errors.\n    \"\"\"\n    def __init__(self, controller: TruncateController) -> None:\n        \"\"\"\n        Initializes the CLIController with a TruncateController instance.\n\n        Args:\n            controller: The TruncateController instance for business logic.\n        \"\"\"\n        self._controller = controller\n\n    def run_cli(self, argv: List[str]) -> int:\n        \"\"\"\n        Executes the CLI command based on the provided arguments.\n\n        Args:\n            argv: A list of command-line arguments, e.g., [\"truncate\", \"3.5\"].\n\n        Returns:\n            An exit code: 0 for success, 2 for validation errors, 1 for internal errors.\n        \"\"\"\n        if not argv or len(argv) < 2 or argv[0] != \"truncate\":\n            print(\"Usage: numtrunc truncate <number>\", file=sys.stderr)\n            return 2\n\n        try:\n            # Parse the number string using the utility function\n            number_str = argv[1]\n            number = parse_number(number_str)\n            \n            # Call the controller to perform the truncation\n            dto = self._controller.truncate(number)\n            \n            # Print the decimal part to stdout\n            print(dto.decimal_part)\n            return 0\n        except ValidationError as e:\n            # Handle validation errors gracefully\n            print(f\"Error: {e.message}\", file=sys.stderr)\n            return 2\n        except Exception as e:\n            # Handle unexpected internal errors\n            print(f\"Internal error: {e}\", file=sys.stderr)\n            return 1\n\ndef main():\n    \"\"\"Entry point for the command-line interface.\"\"\"\n    truncator_service = TruncatorService()\n    controller = TruncateController(truncator_service)\n    cli_controller = CLIController(controller)\n    # sys.argv[0] is the script name ('numtrunc'), so we pass sys.argv[1:]\n    exit_code = cli_controller.run_cli(sys.argv[1:])\n    sys.exit(exit_code)\n\nif __name__ == \"__main__\":\n    main()\n\n```\n```python\n# src/numtrunc/exceptions.py\nclass ValidationError(Exception):\n    \"\"\"\n    Custom exception for domain-specific validation errors.\n    This helps distinguish application-level validation from generic exceptions.\n    \"\"\"\n    def __init__(self, message: str) -> None:\n        \"\"\"\n        Initializes a ValidationError with a specific message.\n        \"\"\"\n        super().__init__(message)\n        self.message = message\n\n```\n```python\n# src/numtrunc/utils.py\nimport math\nfrom .exceptions import ValidationError\n\ndef parse_number(value: str) -> float:\n    \"\"\"\n    Converts a string value to a float and performs basic validation.\n\n    Args:\n        value: The string representation of a number.\n\n    Returns:\n        The converted float.\n\n    Raises:\n        ValidationError: If the value cannot be converted to a float,\n                         or if it's NaN or Infinity.\n    \"\"\"\n    try:\n        n = float(value)\n    except ValueError:\n        raise ValidationError(f\"'{value}' is not a valid float.\")\n    \n    if math.isnan(n):\n        raise ValidationError(\"Input value cannot be NaN (Not a Number).\")\n    if math.isinf(n):\n        raise ValidationError(\"Input value cannot be Infinity.\")\n    \n    return n\n\ndef validate_non_negative(number: float) -> None:\n    \"\"\"\n    Validates that a given float is non-negative.\n    Also checks for NaN/Inf as these are not considered \"non-negative\" in this context.\n\n    Args:\n        number: The float to validate.\n\n    Raises:\n        ValidationError: If the number is negative, NaN, or Infinity.\n    \"\"\"\n    if math.isnan(number):\n        raise ValidationError(\"Input number cannot be NaN (Not a Number).\")\n    if math.isinf(number):\n        raise ValidationError(\"Input number cannot be Infinity.\")\n    if number < 0:\n        raise ValidationError(\"Input number must be non-negative.\")\n\n```\n```python\n# tests/unit/test_truncator.py\nimport pytest\nfrom numtrunc.truncator import TruncatorService\nfrom numtrunc.exceptions import ValidationError\n\nclass TestTruncatorService:\n    def setup_method(self):\n        self.svc = TruncatorService()\n\n    def test_basic_positive_float(self):\n        \"\"\"Test with a standard positive float.\"\"\"\n        assert self.svc.get_decimal_part(3.5) == 0.5\n        assert self.svc.get_decimal_part(0.12345) == 0.12345\n\n    def test_zero(self):\n        \"\"\"Test with zero.\"\"\"\n        assert self.svc.get_decimal_part(0.0) == 0.0\n\n    def test_integer(self):\n        \"\"\"Test with an integer float (should return 0.0).\"\"\"\n        assert self.svc.get_decimal_part(5.0) == 0.0\n        assert self.svc.get_decimal_part(100.0) == 0.0\n\n    def test_large_number(self):\n        \"\"\"Test with a very large number.\"\"\"\n        # Using a number where the fractional part is exactly representable\n        large_num = 1_000_000_000_000.12345\n        assert self.svc.get_decimal_part(large_num) == 0.12345\n\n    def test_numbers_with_many_decimals(self):\n        \"\"\"Test with numbers having many decimal places.\"\"\"\n        # Due to float precision, direct equality might fail for many cases,\n        # but the difference should be minimal.\n        val = 0.12345678901234567\n        assert self.svc.get_decimal_part(3.12345678901234567) == pytest.approx(val)\n        assert self.svc.get_decimal_part(0.9999999999999999) == pytest.approx(0.9999999999999999)\n\n    def test_float_close_to_integer_boundary(self):\n        \"\"\"Test numbers very close to an integer boundary.\"\"\"\n        assert self.svc.get_decimal_part(2.999999999999999) == pytest.approx(0.999999999999999)\n        assert self.svc.get_decimal_part(3.0000000000000001) == pytest.approx(0.0000000000000001)\n\n    def test_invalid_negative_number(self):\n        \"\"\"Test that negative numbers raise ValidationError.\"\"\"\n        with pytest.raises(ValidationError, match=\"must be non-negative\"):\n            self.svc.get_decimal_part(-1.0)\n        with pytest.raises(ValidationError, match=\"must be non-negative\"):\n            self.svc.get_decimal_part(-3.5)\n\n    def test_invalid_nan_input(self):\n        \"\"\"Test that