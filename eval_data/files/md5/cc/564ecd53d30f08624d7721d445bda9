ock_repo.records[-1]\n    assert record.input_text == \"estt\"\n    assert record.output_text == \"test\"\n    assert record.operation == \"decode\"\n\ndef test_decode_no_persist_history(decoder_service_with_mock_repo):\n    \"\"\"Tests that decode operation is NOT persisted when not requested.\"\"\"\n    svc, mock_repo = decoder_service_with_mock_repo\n    original_len = len(mock_repo.records)\n    \n    decoded = svc.decode(\"estt\", persist=False)\n    assert decoded == \"test\"\n    assert len(mock_repo.records) == original_len # No new record\n\n    # Also test with a service initialized without a repo\n    svc_no_repo = DecoderService(repo=None)\n    decoded_no_repo = svc_no_repo.decode(\"bca\", persist=True) # persist=True but no repo\n    assert decoded_no_repo == \"abc\" # Still works\n    # Functionally, no persistence would occur here.\n\n```\n\n---\n### `tests/test_repository.py`\n```python\nimport pytest\nimport sqlite3\nfrom datetime import datetime, timedelta\nimport os\n\nfrom cycliccoder.HistoryRepository import HistoryRepository, DEFAULT_DB_PATH\nfrom cycliccoder.Models import HistoryRecord\nfrom cycliccoder.Exceptions import PersistenceError\n\ndef test_repository_init_creates_db_and_schema(tmp_db_path):\n    \"\"\"Tests that HistoryRepository initializes, creates the DB file and schema.\"\"\"\n    repo = None\n    try:\n        assert not os.path.exists(tmp_db_path)\n        repo = HistoryRepository(tmp_db_path)\n        assert os.path.exists(tmp_db_path)\n\n        # Verify table exists and has correct columns\n        conn = sqlite3.connect(tmp_db_path)\n        cursor = conn.cursor()\n        cursor.execute(\"PRAGMA table_info(operations)\")\n        columns = [row[1] for row in cursor.fetchall()]\n        assert \"id\" in columns\n        assert \"input\" in columns\n        assert \"output\" in columns\n        assert \"operation\" in columns\n        assert \"created_at\" in columns\n        conn.close()\n    finally:\n        if repo:\n            repo.close()\n\ndef test_repository_add_record(history_repo):\n    \"\"\"Tests adding a single record to the history.\"\"\"\n    record = HistoryRecord(\"input1\", \"output1\", \"encode\", datetime.utcnow().isoformat())\n    record_id = history_repo.add(record)\n    assert isinstance(record_id, int)\n    assert record_id > 0\n\n    records = history_repo.list_recent()\n    assert len(records) == 1\n    added_record = records[0]\n    assert added_record.id == record_id\n    assert added_record.input_text == \"input1\"\n    assert added_record.output_text == \"output1\"\n    assert added_record.operation == \"encode\"\n    assert added_record.created_at == record.created_at\n\ndef test_repository_list_recent(history_repo):\n    \"\"\"Tests listing multiple recent records with a limit.\"\"\"\n    # Add records with different timestamps to ensure ordering\n    now = datetime.utcnow()\n    history_repo.add(HistoryRecord(\"in1\", \"out1\", \"encode\", (now - timedelta(seconds=3)).isoformat()))\n    history_repo.add(HistoryRecord(\"in2\", \"out2\", \"decode\", (now - timedelta(seconds=2)).isoformat()))\n    history_repo.add(HistoryRecord(\"in3\", \"out3\", \"encode\", (now - timedelta(seconds=1)).isoformat()))\n    history_repo.add(HistoryRecord(\"in4\", \"out4\", \"decode\", now.isoformat()))\n\n    recent = history_repo.list_recent(limit=2)\n    assert len(recent) == 2\n    assert recent[0].input_text == \"in4\" # Most recent\n    assert recent[1].input_text == \"in3\"\n\n    all_records = history_repo.list_recent(limit=100) # Get all\n    assert len(all_records) == 4\n    assert all_records[0].input_text == \"in4\"\n    assert all_records[1].input_text == \"in3\"\n    assert all_records[2].input_text == \"in2\"\n    assert all_records[3].input_text == \"in1\"\n\ndef test_repository_add_and_list_empty(history_repo):\n    \"\"\"Tests adding and listing with empty history.\"\"\"\n    assert len(history_repo.list_recent()) == 0\n\ndef test_repository_close_connection(history_repo):\n    \"\"\"Tests closing the database connection.\"\"\"\n    history_repo.add(HistoryRecord(\"test\", \"test\", \"encode\", datetime.utcnow().isoformat()))\n    history_repo.close()\n    # After closing, further operations should fail with PersistenceError\n    with pytest.raises(PersistenceError):\n        history_repo.add(HistoryRecord(\"fail\", \"fail\", \"decode\", datetime.utcnow().isoformat()))\n\ndef test_repository_invalid_db_path_raises_error():\n    \"\"\"Tests that an invalid DB path raises PersistenceError.\"\"\"\n    # Attempt to open a DB in a non-existent/unwritable directory\n    invalid_path = \"/nonexistent_dir/test.db\"\n    with pytest.raises(PersistenceError):\n        HistoryRepository(invalid_path)\n\ndef test_repository_corrupt_db_raises_error(tmp_path):\n    \"\"\"Tests that a corrupt DB file raises PersistenceError during schema check or operation.\"\"\"\n    corrupt_db_path = tmp_path / \"corrupt.db\"\n    # Create a file that is not a valid SQLite DB\n    with open(corrupt_db_path, \"w\") as f:\n        f.write(\"This is not a SQLite database.\")\n\n    with pytest.raises(PersistenceError):\n        HistoryRepository(str(corrupt_db_path))\n\ndef test_repository_sql_injection_prevention(history_repo):\n    \"\"\"Tests that parameterized queries prevent SQL injection.\"\"\"\n    malicious_input = \"'; DROP TABLE operations; --\"\n    innocent_output = \"innocent\"\n    operation = \"encode\"\n    created_at = datetime.utcnow().isoformat()\n\n    record = HistoryRecord(malicious_input, innocent_output, operation, created_at)\n    history_repo.add(record)\n\n    # If injection occurred, the 'operations' table would be dropped.\n    # Attempting to query it should still work.\n    records = history_repo.list_recent()\n    assert len(records) == 1\n    assert records[0].input_text == malicious_input\n\n    conn = sqlite3.connect(history_repo.db_path)\n    cursor = conn.cursor()\n    # Check if table still exists\n    cursor.execute(\"SELECT name FROM sqlite_master WHERE type='table' AND name='operations';\")\n    assert cursor.fetchone() is not None # Table should still exist\n    conn.close()\n\n```"}
{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    \"\"\"\n\n    def _is_prime(num: int) -> bool:\n        \"\"\"\n        Checks if a number is prime using trial division and Miller-Rabin test.\n        \"\"\"\n        if num < 2:\n            return False\n        if num == 2 or num == 3:\n            return True\n        if num % 2 == 0 or num % 3 == 0:\n            return False\n        \n        # Miller-Rabin probabilistic test for larger numbers using deterministic bases.\n        _MR_BASES = [2, 3, 5, 7, 11, 13, 17] \n\n        d = num - 1\n        s = 0\n        while d % 2 == 0:\n            d //= 2\n            s += 1\n\n        for a in _MR_BASES:\n            if a >= num: \n                break \n\n            x = pow(a, d, num)\n            if x == 1 or x == num - 1:\n                continue\n\n            composite = True\n            for _ in range(s - 1):\n                x = pow(x, 2, num)\n                if x == num - 1:\n                    composite = False\n                    break\n            if composite:\n                return False\n        return True\n\n    count_found_primes = 0\n    \n    # Initialize for Fibonacci sequence F1=1, F2=1.\n    fib_prev = 1 \n    fib_curr = 1 \n\n    # The problem examples start counting from F3=2.\n    # F1=1 and F2=1 are not prime and are effectively skipped.\n    \n    while True:\n        # Calculate the next Fibonacci number in the sequence.\n        current_fib_val = fib_prev + fib_curr \n        \n        # Update for the next iteration.\n        fib_prev = fib_curr\n        fib_curr = current_fib_val \n\n        if _is_prime(current_fib_val):\n            count_found_primes += 1\n            if count_found_primes == n:\n                return current_fib_val"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    It returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    nums_sorted = sorted(l)\n\n    for i in range(n - 2):\n        left, right = i + 1, n - 1\n        while left < right:\n            current_sum = nums_sorted[i] + nums_sorted[left] + nums_sorted[right]\n\n            if current_sum == 0:\n                return True\n            elif current_sum < 0:\n                left += 1\n            else:  # current_sum > 0\n                right -= 1\n    \n    return False"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    Checks if three distinct elements in the list sum to zero.\n    Returns True if found, False otherwise.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    nums_sorted = sorted(l)\n\n    for i in range(n - 2):\n        # Fix one element, then use two-pointer approach for the remaining sum\n        a = nums_sorted[i]\n        left, right = i + 1, n - 1\n        while left < right:\n            current_sum = a + nums_sorted[left] + nums_sorted[right]\n            if current_sum == 0:\n                return True\n            elif current_sum < 0:\n                left += 1\n            else:\n                right -= 1\n    return False"}
