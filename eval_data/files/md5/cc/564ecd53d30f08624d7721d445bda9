{"task_id": "HumanEval/7", "solution": "```python\n# pyproject.toml\n[tool.poetry]\nname = \"string-filter\"\nversion = \"0.1.0\"\ndescription = \"A reusable library and application to filter lists of strings by a substring.\"\nauthors = [\"Your Name <you@example.com>\"]\nreadme = \"README.md\"\n\n[tool.poetry.dependencies]\npython = \"^3.9\"\nfastapi = { version = \"^0.111.0\", optional = true }\nuvicorn = { version = \"^0.30.1\", optional = true }\n\n[tool.poetry.group.dev.dependencies]\npytest = \"^8.2.2\"\nruff = \"^0.4.8\"\nmypy = \"^1.10.0\"\n\n[build-system]\nrequires = [\"poetry-core\"]\nbuild-backend = \"poetry.core.masonry.api\"\n\n[tool.poetry.scripts]\nstring-filter = \"string_filter.main:main\"\n```\n\n```python\n# src/string_filter/__init__.py\n\"\"\"\nString Filter Library and Application.\n\"\"\"\n\n__version__ = \"0.1.0\"\n```\n\n```python\n# src/string_filter/config.py\nimport os\nfrom pathlib import Path\n\n\nclass FilterConfig:\n    \"\"\"Central configuration for the string filtering application.\"\"\"\n    DEFAULT_DB_PATH: str = \"./data/filter_history.db\"\n    DEFAULT_PERSIST_HISTORY: bool = True\n    DEFAULT_CASE_INSENSITIVE: bool = False\n\n    def __init__(\n        self,\n        db_path: str = DEFAULT_DB_PATH,\n        persist_history: bool = DEFAULT_PERSIST_HISTORY,\n        case_insensitive_default: bool = DEFAULT_CASE_INSENSITIVE,\n    ):\n        \"\"\"Initialize FilterConfig with given values or defaults.\"\"\"\n        self.db_path = db_path\n        self.persist_history = persist_history\n        self.case_insensitive_default = case_insensitive_default\n\n    @classmethod\n    def from_env(cls) -> \"FilterConfig\":\n        \"\"\"Construct config reading environment variables.\"\"\"\n        db_path = os.getenv(\"STRING_FILTER_DB_PATH\", cls.DEFAULT_DB_PATH)\n        persist_history_str = os.getenv(\"STRING_FILTER_PERSIST_HISTORY\", str(cls.DEFAULT_PERSIST_HISTORY))\n        persist_history = persist_history_str.lower() == \"true\"\n        case_insensitive_str = os.getenv(\"STRING_FILTER_CASE_INSENSITIVE_DEFAULT\", str(cls.DEFAULT_CASE_INSENSITIVE))\n        case_insensitive_default = case_insensitive_str.lower() == \"true\"\n        return cls(db_path, persist_history, case_insensitive_default)\n\n```\n\n```python\n# src/string_filter/models.py\nfrom datetime import datetime\nfrom typing import List, Optional, Dict, Any\nimport json\n\nfrom .exceptions import ValidationError\nfrom .utils import StringUtils\n\n\nclass FilterRequest:\n    \"\"\"Data transfer object for filter requests.\"\"\"\n    def __init__(\n        self, strings: List[str], substring: str, case_insensitive: Optional[bool] = None\n    ):\n        \"\"\"Initialize with input strings, substring, and case sensitivity flag.\"\"\"\n        self.strings = strings\n        self.substring = substring\n        self.case_insensitive = case_insensitive\n\n    def validate(self) -> None:\n        \"\"\"Validate types and non-null constraints.\"\"\"\n        try:\n            StringUtils.validate_strings(self.strings)\n            StringUtils.validate_substring(self.substring)\n            if self.case_insensitive is not None and not isinstance(self.case_insensitive, bool):\n                raise ValidationError(\"Invalid type for 'case_insensitive', must be boolean.\")\n        except ValidationError as e:\n            raise ValidationError(f\"Invalid FilterRequest: {e}\") from e\n\n\nclass FilterResult:\n    \"\"\"Data transfer object for filter operation results.\"\"\"\n    def __init__(self, matches: List[str], count: int):\n        \"\"\"Initialize with matching strings and their count.\"\"\"\n        self.matches = matches\n        self.count = count\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Convert result to a dictionary.\"\"\"\n        return {\"matches\": self.matches, \"count\": self.count}\n\n\nclass HistoryRecord:\n    \"\"\"Data model for a persisted filter operation history record.\"\"\"\n    def __init__(\n        self,\n        id: Optional[int],\n        input_json: str,\n        substring: str,\n        case_insensitive: bool,\n        result_json: str,\n        created_at: datetime,\n    ):\n        \"\"\"Initialize history record attributes.\"\"\"\n        self.id = id\n        self.input_json = input_json\n        self.substring = substring\n        self.case_insensitive = case_insensitive\n        self.result_json = result_json\n        self.created_at = created_at\n\n    def to_row(self) -> tuple:\n        \"\"\"Convert record to a tuple suitable for database insertion (omitting id).\"\"\"\n        return (\n            self.input_json,\n            self.substring,\n            int(self.case_insensitive),\n            self.result_json,\n            self.created_at.isoformat(),\n        )\n\n    @classmethod\n    def from_row(cls, row: tuple) -> \"HistoryRecord\":\n        \"\"\"Create a HistoryRecord instance from a database row.\"\"\"\n        return cls(\n            id=row[0],\n            input_json=row[1],\n            substring=row[2],\n            case_insensitive=bool(row[3]),\n            result_json=row[4],\n            created_at=datetime.fromisoformat(row[5]),\n        )\n\n```\n\n```python\n# src/string_filter/exceptions.py\nclass FilterError(Exception):\n    \"\"\"Base exception for string filtering operations.\"\"\"\n    def __init__(self, message: str = \"An unknown filter error occurred.\"):\n        \"\"\"Initialize with an error message.\"\"\"\n        self.message = message\n        super().__init__(self.message)\n\n\nclass ValidationError(FilterError):\n    \"\"\"Exception raised for invalid input data.\"\"\"\n    def __init__(self, message: str = \"Input validation failed.\"):\n        \"\"\"Initialize with a validation error message.\"\"\"\n        super().__init__(message)\n\n```\n\n```python\n# src/string_filter/utils.py\nfrom typing import List\n\nfrom .exceptions import ValidationError\n\n\nclass StringUtils:\n    \"\"\"Helper functions for string matching and validation.\"\"\"\n\n    @staticmethod\n    def string_contains(s: str, substring: str, case_insensitive: bool) -> bool:\n        \"\"\"Check if a string contains a substring, respecting case sensitivity.\"\"\"\n        if not isinstance(s, str):\n            raise TypeError(\"Input 's' must be a string.\")\n        if not isinstance(substring, str):\n            raise TypeError(\"Input 'substring' must be a string.\")\n\n        if substring == \"\":\n            return True\n        if case_insensitive:\n            return substring.lower() in s.lower()\n        return substring in s\n\n    @staticmethod\n    def validate_strings(strings: List[str]) -> None:\n        \"\"\"Validate that the input is a list of strings.\"\"\"\n        if not isinstance(strings, list):\n            raise ValidationError(\"Input 'strings' must be a list.\")\n        for i, s in enumerate(strings):\n            if not isinstance(s, str):\n                raise ValidationError(f\"Item at index {i} in 'strings' is not a string.\")\n\n    @staticmethod\n    def validate_substring(substring: str) -> None:\n        \"\"\"Validate that the substring is a string and not None.\"\"\"\n        if substring is None:\n            raise ValidationError(\"Substring cannot be None.\")\n        if not isinstance(substring, str):\n            raise ValidationError(\"Substring must be a string.\")\n\n```\n\n```python\n# src/string_filter/repository.py\nimport sqlite3\nimport os\nfrom pathlib import Path\nfrom typing import List, Optional\n\nfrom .models import HistoryRecord\nfrom .exceptions import FilterError\n\n\nclass StringRepository:\n    \"\"\"Manages SQLite persistence for filter history.\"\"\"\n\n    CREATE_TABLE_SQL = \"\"\"\n        CREATE TABLE IF NOT EXISTS filter_history (\n          id INTEGER PRIMARY KEY AUTOINCREMENT,\n          input_json TEXT NOT NULL,\n          substring TEXT NOT NULL,\n          case_insensitive INTEGER NOT NULL DEFAULT 0,\n          result_json TEXT NOT NULL,\n          created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n        );\n        CREATE INDEX IF NOT EXISTS idx_filter_history_substring ON filter_history(substring);\n        CREATE INDEX IF NOT EXISTS idx_filter_history_created_at ON filter_history(created_at);\n    \"\"\"\n\n    def __init__(self, db_path: str):\n        \"\"\"Initialize repository with database path.\"\"\"\n        self._db_path = db_path\n        self._conn: Optional[sqlite3.Connection] = None\n\n    def connect(self) -> None:\n        \"\"\"Open SQLite connection and set pragmas.\"\"\"\n        db_dir = Path(self._db_path).parent\n        db_dir.mkdir(parents=True, exist_ok=True)\n        try:\n            self._conn = sqlite3.connect(self._db_path)\n            self._conn.execute(\"PRAGMA journal_mode=WAL;\")\n        except sqlite3.Error as e:\n            raise FilterError(f\"Failed to connect to database at {self._db_path}: {e}\") from e\n\n    def ensure_schema(self) -> None:\n        \"\"\"Create history table if it does not exist.\"\"\"\n        if not self._conn:\n            raise FilterError(\"Database connection not established.\")\n        try:\n            self._conn.executescript(self.CREATE_TABLE_SQL)\n            self._conn.commit()\n        except sqlite3.Error as e:\n            raise FilterError(f\"Failed to ensure database schema: {e}\") from e\n\n    def insert_history(self, record: HistoryRecord) -> int:\n        \"\"\"Insert a filter history record into the database.\"\"\"\n        if not self._conn:\n            raise FilterError(\"Database connection not established.\")\n        try:\n            cur = self._conn.cursor()\n            cur.execute(\n                \"INSERT INTO filter_history (input_json, substring, case_insensitive, result_json, created_at) VALUES (?, ?, ?, ?, ?)\",\n                record.to_row(),\n            )\n            self._conn.commit()\n            return cur.lastrowid if cur.lastrowid is not None else -1\n        except sqlite3.Error as e:\n            raise FilterError(f\"Failed to insert history record: {e}\") from e\n\n    def query_history(self, limit: int = 100) -> List[HistoryRecord]:\n        \"\"\"Query most recent history records.\"\"\"\n        if not self._conn:\n            raise FilterError(\"Database connection not established.\")\n        try:\n            cur = self._conn.cursor()\n            cur.execute(\n                \"SELECT id, input_json, substring, case_insensitive, result_json, created_at FROM filter_history ORDER BY created_at DESC LIMIT ?\",\n                (limit,),\n            )\n            rows = cur.fetchall()\n            return [HistoryRecord.from_row(row) for row in rows]\n        except sqlite3.Error as e:\n            raise FilterError(f\"Failed to query history records: {e}\") from e\n\n    def close(self) -> None:\n        \"\"\"Close the database connection.\"\"\"\n        if self._conn:\n            self._conn.close()\n            self._conn = None\n\n```\n\n```python\n# src/string_filter/services.py\nimport json\nfrom datetime import datetime, UTC\nfrom typing import List, Optional\n\nfrom .models import FilterResult, HistoryRecord\nfrom .config import FilterConfig\nfrom .utils import StringUtils\nfrom .repository import StringRepository\nfrom .exceptions import ValidationError, FilterError\n\n\nclass FilterService:\n    \"\"\"Core filtering business logic and persistence orchestration.\"\"\"\n\n    def __init__(self, config: FilterConfig, repository: Optional[StringRepository] = None):\n        \"\"\"Initialize service with config and optional repository.\"\"\"\n        self._config = config\n        self._repository = repository\n        if self._config.persist_history and self._repository:\n            try:\n                self._repository.connect()\n                self._repository.ensure_schema()\n            except FilterError as e:\n                print(f\"Warning: Persistence initialization failed ({e}). Running without history persistence.\")\n                self._repository = None\n                self._config.persist_history = False\n\n\n    def filter(self, strings: List[str], substring: str, case_insensitive: Optional[bool] = None) -> FilterResult:\n        \"\"\"Filter a list of strings by substring, supporting case sensitivity and persistence.\"\"\"\n        StringUtils.validate_strings(strings)\n        StringUtils.validate_substring(substring)\n\n        effective_case_insensitive = self._config.case_insensitive_default if case_insensitive is None else case_insensitive\n\n        if substring == \"\":\n            matches = list(strings) # Shallow copy\n        else:\n            matches = [s for s in strings if self._match_single(s, substring, effective_case_insensitive)]\n\n        result = FilterResult(matches=matches, count=len(matches))\n\n        if self._config.persist_history and self._repository:\n            try:\n                record = HistoryRecord(\n                    id=None,\n                    input_json=json.dumps(strings),\n                    substring=substring,\n                    case_insensitive=effective_case_insensitive,\n                    result_json=json.dumps(matches),\n                    created_at=datetime.now(UTC),\n                )\n                self._repository.insert_history(record)\n            except FilterError as e:\n                print(f\"Warning: Failed to persist filter history: {e}\")\n            except Exception as e:\n                print(f\"Warning: Unexpected error during history persistence: {e}\")\n        return result\n\n    def _match_single(self, s: str, substring: str, case_insensitive: bool) -> bool:\n        \"\"\"Helper to check if a single string contains the substring.\"\"\"\n        return StringUtils.string_contains(s, substring, case_insensitive)\n\n```\n\n```python\n# src/string_filter/controllers.py\nfrom typing import List\nfrom datetime import datetime, UTC\nimport json\n\nfrom .models import FilterRequest, FilterResult, HistoryRecord\nfrom .services import FilterService\nfrom .exceptions import FilterError, ValidationError\nfrom .repository import StringRepository\n\n\nclass FilterController:\n    \"\"\"Orchestrates request validation, service calls, and persistence logic.\"\"\"\n\n    def __init__(self, service: FilterService):\n        \"\"\"Initialize controller with a FilterService instance.\"\"\"\n        self._service = service\n\n    def handle_filter_request(self, req: FilterRequest) -> FilterResult:\n        \"\"\"Handle a filter request, validate input, call service, and return result.\"\"\"\n        try:\n            req.validate()\n            result = self._service.filter(req.strings, req.substring, req.case_insensitive)\n            return result\n        except ValidationError as e:\n            raise ValidationError(f\"Request validation failed: {e.message}\") from e\n        except FilterError as e:\n            raise FilterError(f\"Filter operation failed: {e.message}\") from e\n        except Exception as e:\n            raise FilterError(f\"An unexpected error occurred during filtering: {e}\") from e\n\n    def get_history(self, limit: int = 100) -> List[HistoryRecord]:\n        \"\"\"Retrieve filter operation history.\"\"\"\n        # The service's repository is managed by the service itself\n        if self._service._repository and self._service._config.persist_history:\n            try:\n                return self._service._repository.query_history(limit)\n            except FilterError as e:\n                raise FilterError(f\"Failed to retrieve history: {e.message}\") from e\n            except Exception as e:\n                raise FilterError(f\"An unexpected error occurred during history retrieval: {e}\") from e\n        return []\n\n```\n\n```python\n# src/string_filter/api.py\nfrom typing import List, Dict, Any, Optional\n\ntry:\n    from fastapi import FastAPI, HTTPException, status\n    from pydantic import BaseModel, Field\nexcept ImportError:\n    # Define dummy classes to allow the module to be imported even if FastAPI is not installed\n    class FastAPI:\n        def __init__(self, *args, **kwargs):\n            raise RuntimeError(\"FastAPI is not installed. Please install with 'pip install string-filter[api]'\")\n        def post(self, *args, **kwargs): pass\n        def get(self, *args, **kwargs): pass\n    class HTTPException(Exception):\n        def __init__(self, status_code, detail):\n            self.status_code = status_code\n            self.detail = detail\n            super().__init__(detail)\n    class BaseModel: pass\n    class Field:\n        def __init__(self, *args, **kwargs): pass\n\n\nfrom .controllers import FilterController\nfrom .models import FilterRequest, FilterResult, HistoryRecord\nfrom .exceptions import ValidationError, FilterError\n\n\nclass FilterRequestModel(BaseModel):\n    \"\"\"Pydantic model for incoming filter requests.\"\"\"\n    strings: List[str] = Field(..., description=\"List of strings to filter.\")\n    substring: str = Field(..., description=\"The substring to match.\")\n    case_insensitive: Optional[bool] = Field(None, description=\"Whether the filtering should be case-insensitive. Overrides default config.\")\n\n\nclass FilterResponseModel(BaseModel):\n    \"\"\"Pydantic model for filter operation responses.\"\"\"\n    matches: List[str] = Field(..., description=\"List of strings that matched the substring.\")\n    count: int = Field(..., description=\"Number of matching strings.\")\n\n\nclass HistoryRecordResponseModel(BaseModel):\n    \"\"\"Pydantic model for history record responses.\"\"\"\n    id: int = Field(..., description=\"Unique ID of the history record.\")\n    input_json: str = Field(..., description=\"JSON string of the input list.\")\n    substring: str = Field(..., description=\"The substring used for filtering.\")\n    case_insensitive: bool = Field(..., description=\"Whether the operation was case-insensitive.\")\n    result_json: str = Field(..., description=\"JSON string of the resulting matches.\")\n    created_at: str = Field(..., description=\"Timestamp of the operation in ISO 8601 format.\")\n\n\ndef create_app(controller: FilterController) -> FastAPI:\n    \"\"\"Create and configure the FastAPI application.\"\"\"\n    app = FastAPI(\n        title=\"String Filter API\",\n        description=\"API for filtering lists of strings by a substring and querying history.\",\n        version=\"0.1.0\",\n    )\n\n    @app.post(\"/filter\", response_model=FilterResponseModel, status_code=status.HTTP_200_OK)\n    async def filter_strings(request: FilterRequestModel) -> FilterResponseModel:\n        \"\"\"Filter a list of strings by a substring.\"\"\"\n        try:\n            filter_req = FilterRequest(\n                strings=request.strings,\n                substring=request.substring,\n                case_insensitive=request.case_insensitive,\n            )\n            result: FilterResult = controller.handle_filter_request(filter_req)\n            return FilterResponseModel(matches=result.matches, count=result.count)\n        except ValidationError as e:\n            raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=e.message) from e\n        except FilterError as e:\n            raise HTTPException(status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=e.message) from e\n        except Exception as e:\n            raise HTTPException(status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=f\"An unexpected error occurred: {e}\") from e\n\n    @app.get(\"/history\", response_model=List[HistoryRecordResponseModel], status_code=status.HTTP_200_OK)\n    async def get_history(limit: int = Field(100, ge=1, description=\"Maximum number of history records to retrieve.\")) -> List[HistoryRecordResponseModel]:\n        \"\"\"Retrieve filter operation history.\"\"\"\n        try:\n            records: List[HistoryRecord] = controller.get_history(limit)\n            return [\n                HistoryRecordResponseModel(\n                    id=r.id,\n                    input_json=r.input_json,\n                    substring=r.substring,\n                    case_insensitive=r.case_insensitive,\n                    result_json=r.result_json,\n                    created_at=r.created_at.isoformat(),\n                )\n                for r in records\n            ]\n        except FilterError as e:\n            raise HTTPException(status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=e.message) from e\n        except Exception as e:\n            raise HTTPException(status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=f\"An unexpected error occurred: {e}\") from e\n\n    return app\n\n```\n\n```python\n# src/string_filter/cli.py\nimport argparse\nimport sys\nimport json\nfrom typing import List, Optional\n\nfrom .controllers import FilterController\nfrom .models import FilterRequest, FilterResult\nfrom .exceptions import ValidationError, FilterError\nfrom .config import FilterConfig\n\n\nclass StringFilterCLI:\n    \"\"\"CLI for the string filter application.\"\"\"\n\n    def __init__(self, controller: FilterController):\n        \"\"\"Initialize CLI with a FilterController instance.\"\"\"\n        self._controller = controller\n\n    def run(self, argv: Optional[List[str]] = None) -> int:\n        \"\"\"Run the CLI application.\"\"\"\n        parser = argparse.ArgumentParser(\n            prog=\"string-filter\",\n            description=\"Filter lists of strings by a substring.\",\n            formatter_class=argparse.RawTextHelpFormatter,\n        )\n\n        subparsers = parser.add_subparsers(dest=\"command\", help=\"Available commands\", required=True)\n\n        # Filter command\n        filter_parser = subparsers.add_parser(\n            \"filter\",\n            help=\"Filter a list of strings.\",\n            description=\"\"\"Filter a list of strings by a substring.\nInput strings can be provided as a comma-separated list via --strings \nor from a file (--file, one string per line).\"\"\",\n        )\n        filter_parser.add_argument(\n            \"--substring\",\n            type=str,\n            required=True,\n            help=\"The substring to filter by.\",\n        )\n        filter_parser.add_argument(\n            \"--strings\",\n            type=str,\n            help=\"Comma-separated list of strings to filter (e.g., 'abc,def,ghi').\",\n        )\n        filter_parser.add_argument(\n            \"--file\",\n            type=str,\n            help=\"Path to a file containing strings, one per line.\",\n        )\n        filter_parser.add_argument(\n            \"--case-insensitive\",\n            action=\"store_true\",\n            help=\"Perform case-insensitive matching.\",\n        )\n        filter_parser.add_argument(\n            \"--no-persist\",\n            action=\"store_true\",\n            help=\"Do not persist the filter operation history.\",\n        )\n        filter_parser.add_argument(\n            \"--json\",\n            action=\"store_true\",\n            help=\"Output results in JSON format.\",\n        )\n\n        # History command\n        history_parser = subparsers.add_parser(\n            \"history\",\n            help=\"Query filter operation history.\",\n            description=\"\"\"Query the persisted history of filter operations.\"\"\",\n        )\n        history_parser.add_argument(\n            \"--limit\",\n            type=int,\n            default=10,\n            help=\"Maximum number of history records to retrieve.\",\n        )\n        history_parser.add_argument(\n            \"--json\",\n            action=\"store_true\",\n            help=\"Output history records in JSON format.\",\n        )\n\n\n        args = parser.parse_args(argv)\n\n        try:\n            if args.command == \"filter\":\n                input_strings: List[str] = []\n                if args.strings:\n                    input_strings.extend(args.strings.split(\",\"))\n                if args.file:\n                    try:\n                        with open(args.file, \"r\", encoding=\"utf-8\") as f:\n                            input_strings.extend([line.strip() for line in f if line.strip()])\n                    except FileNotFoundError:\n                        raise ValidationError(f\"File not found: {args.file}\")\n                    except IOError as e:\n                        raise FilterError(f\"Error reading file {args.file}: {e}\")\n\n                if not input_strings:\n                    print(\"Error: No strings provided for filtering. Use --strings or --file.\", file=sys.stderr)\n                    return 2\n\n                # Override persistence setting based on --no-persist flag\n                current_config = self._controller._service._config\n                if args.no_persist:\n                    current_config.persist_history = False\n                else:\n                    # Restore original config setting if not explicitly disabled\n                    # This relies on the service holding a mutable config. A better approach\n                    # for CLI might be to pass a new config/flag to the service or controller.\n                    # For this design, we modify the existing config instance for the current run.\n                    current_config.persist_history = FilterConfig.DEFAULT_PERSIST_HISTORY\n\n                req = FilterRequest(\n                    strings=input_strings,\n                    substring=args.substring,\n                    case_insensitive=args.case_insensitive,\n                )\n                result: FilterResult = self._controller.handle_filter_request(req)\n\n                if args.json:\n                    print(json.dumps(result.to_dict(), indent=2))\n                else:\n                    for match in result.matches:\n                        print(match)\n                return 0\n\n            elif args.command == \"history\":\n                history_records = self._controller.get_history(limit=args.limit)\n                if args.json:\n                    output = []\n                    for record in history_records:\n                        output.append({\n                            \"id\": record.id,\n                            \"input_json\": record.input_json,\n                            \"substring\": record.substring,\n                            \"case_insensitive\": record.case_insensitive,\n                            \"result_json\": record.result_json,\n                            \"created_at\": record.created_at.isoformat(),\n                        })\n                    print(json.dumps(output, indent=2))\n                else:\n                    if not history_records:\n                        print(\"No history records found.\")\n                    for record in history_records:\n                        print(f\"ID: {record.id}, Substring: '{record.substring}', Matches: {json.loads(record.result_json)}\")\n                return 0\n\n        except ValidationError as e:\n            print(f\"Error: {e.message}\", file=sys.stderr)\n            return 2\n        except FilterError as e:\n            print(f\"An internal error occurred: {e.message}\", file=sys.stderr)\n            return 1\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1\n        finally:\n            # Ensure repository connection is closed if it was opened by the service\n            if self._controller._service._repository:\n                self._controller._service._repository.close()\n\n```\n\n```python\n# src/string_filter/main.py\nimport sys\n\nfrom .config import FilterConfig\nfrom .repository import StringRepository\nfrom .services import FilterService\nfrom .controllers import FilterController\nfrom .cli import StringFilterCLI\n\n\ndef main() -> int:\n    \"\"\"Main entry point for the CLI application.\"\"\"\n    config = FilterConfig.from_env()\n\n    repository = None\n    if config.persist_history:\n        repository = StringRepository(db_path=config.db_path)\n    \n    service = FilterService(config=config, repository=repository)\n    controller = FilterController(service=service)\n    cli = StringFilterCLI(controller=controller)\n\n    return cli.run(sys.argv[1:])\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n\n```\n\n```sql\n-- migrations/0001_create_history_table.sql\n-- Create table for filter operation history\nCREATE TABLE IF NOT EXISTS filter_history (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  input_json TEXT NOT NULL,\n  substring TEXT NOT NULL,\n  case_insensitive INTEGER NOT NULL DEFAULT 0,\n  result_json TEXT NOT NULL,\n  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n);\n\n-- Add indexes for common queries\nCREATE INDEX IF NOT EXISTS idx_filter_history_substring ON filter_history(substring);\nCREATE INDEX IF NOT EXISTS idx_filter_history_created_at ON filter_history(created_at);\n```\n\n```\n# data/README\nThis directory will store the SQLite database file 'filter_history.db' by default.\nIt is created at runtime if persistence is enabled.\n```\n\n```\n# README.md\n# String Filter Application\n\nThis project provides a reusable Python library and small runnable application to filter lists of strings by a substring. It includes a Command Line Interface (CLI) and an optional HTTP API, with support for persisting filter operation history to SQLite.\n\n## Features\n\n- **String Filtering**: Filter a list of strings based on a given substring.\n- **Case Sensitivity**: Supports both case-sensitive (default) and case-insensitive matching.\n- **Empty Substring Handling**: An empty substring matches all input strings.\n- **CLI Interface**: Run filtering operations from the command line, accepting inline strings or a file.\n- **HTTP API (Optional)**: Exposes a RESTful API endpoint for filtering and querying history using FastAPI.\n- **Persistence**: Persists filter operation history to a SQLite database for audit and debugging purposes.\n\n## Installation\n\n### Using Poetry (Recommended)\n\n1.  **Clone the repository:**\n    ```bash\n    git clone https://github.com/your-username/string-filter.git\n    cd string-filter\n    ```\n\n2.  **Install dependencies:**\n    ```bash\n    poetry install\n    ```\n    If you want to use the HTTP API, install with the `api` extra:\n    ```bash\n    poetry install --extras api\n    ```\n\n3.  **Activate the virtual environment:**\n    ```bash\n    poetry shell\n    ```\n\n### Using pip\n\n1.  **Clone the repository:**\n    ```bash\n    git clone https://github.com/your-username/string-filter.git\n    cd string-filter\n    ```\n\n2.  **Install from local directory:**\n    ```bash\n    pip install .\n    ```\n    For the HTTP API:\n    ```bash\n    pip install \".[api]\"\n    ```\n\n## Usage\n\n### Command Line Interface (CLI)\n\nThe CLI tool is available via the `string-filter` command.\n\n**1. Filter Strings:**\n\nFilter strings from a comma-separated list:\n```bash\nstring-filter filter --substring \"a\" --strings \"apple,banana,orange,grape\"\n```\nOutput:\n```\napple\nbanana\norange\n```\n\nFilter strings from a file (e.g., `inputs.txt` containing `hello\\nworld\\nhey`):\n```bash\n# Create inputs.txt first\necho \"hello\" > inputs.txt\necho \"world\" >> inputs.txt\necho \"hey\" >> inputs.txt\n\nstring-filter filter --substring \"h\" --file inputs.txt\n```\nOutput:\n```\nhello\nhey\n```\n\nWith case-insensitive matching:\n```bash\nstring-filter filter --substring \"A\" --strings \"apple,Banana,orange\" --case-insensitive\n```\nOutput:\n```\napple\nBanana\norange\n```\n\nDisable history persistence for a specific operation:\n```bash\nstring-filter filter --substring \"test\" --strings \"test1,test2\" --no-persist\n```\n\nOutput results in JSON format:\n```bash\nstring-filter filter --substring \"a\" --strings \"abc,bacd,cde,array\" --json\n```\nOutput:\n```json\n{\n  \"matches\": [\n    \"abc\",\n    \"bacd\",\n    \"array\"\n  ],\n  \"count\": 3\n}\n```\n\n**2. Query History:**\n\nView the most recent filter operations:\n```bash\nstring-filter history\n```\nOutput:\n```\nID: 1, Substring: 'a', Matches: ['apple', 'banana', 'orange']\nID: 2, Substring: 'h', Matches: ['hello', 'hey']\n# ... more history\n```\n\nView history in JSON format, with a limit:\n```bash\nstring-filter history --limit 5 --json\n```\n\n### HTTP API (Optional)\n\nIf you installed with `poetry install --extras api` or `pip install \".[api]\"`, you can run the HTTP API.\n\n1.  **Start the API server:**\n    ```bash\n    uvicorn string_filter.api:create_app --factory --host 0.0.0.0 --port 8000\n    ```\n\n2.  **Access the API:**\n\n    *   **Filter Strings (POST /filter):**\n        ```bash\n        curl -X POST \"http://127.0.0.1:8000/filter\" \\\n             -H \"Content-Type: application/json\" \\\n             -d '{\n                   \"strings\": [\"abc\", \"bacd\", \"cde\", \"array\"],\n                   \"substring\": \"a\",\n                   \"case_insensitive\": false\n                 }'\n        ```\n        Response:\n        ```json\n        {\n          \"matches\": [\"abc\", \"bacd\", \"array\"],\n          \"count\": 3\n        }\n        ```\n\n    *   **Query History (GET /history):**\n        ```bash\n        curl \"http://127.0.0.1:8000/history?limit=2\"\n        ```\n        Response:\n        ```json\n        [\n          {\n            \"id\": 1,\n            \"input_json\": \"[\\\"abc\\\", \\\"bacd\\\", \\\"cde\\\", \\\"array\\\"]\",\n            \"substring\": \"a\",\n            \"case_insensitive\": false,\n            \"result_json\": \"[\\\"abc\\\", \\\"bacd\\\", \\\"array\\\"]\",\n            \"created_at\": \"2023-10-27T10:00:00.123456\"\n          }\n        ]\n        ```\n\nThe API documentation (Swagger UI) will be available at `http://127.0.0.1:8000/docs`.\n\n## Configuration\n\nThe application can be configured using environment variables:\n\n-   `STRING_FILTER_DB_PATH`: Path to the SQLite database file (default: `./data/filter_history.db`).\n-   `STRING_FILTER_PERSIST_HISTORY`: `true` or `false` to enable/disable history persistence (default: `true`).\n-   `STRING_FILTER_CASE_INSENSITIVE_DEFAULT`: `true` or `false` to set the default case sensitivity (default: `false`).\n\n## Development\n\n### Running Tests\n\nTo run unit and integration tests:\n\n```bash\npoetry run pytest\n```\n\n### Linting and Type Checking\n\n```bash\npoetry run ruff check .\npoetry run mypy src/\n```\n\n## Project Structure\n\n```\n.\n\u251c\u2500\u2500 src/\n\u2502   \u2514\u2500\u2500 string_filter/\n\u2502       \u251c\u2500\u2500 __init__.py\n\u2502       \u251c\u2500\u2500 config.py\n\u2502       \u251c\u2500\u2500 models.py\n\u2502       \u251c\u2500\u2500 exceptions.py\n\u2502       \u251c\u2500\u2500 utils.py\n\u2502       \u251c\u2500\u2500 repository.py\n\u2502       \u251c\u2500\u2500 services.py\n\u2502       \u251c\u2500\u2500 controllers.py\n\u2502       \u251c\u2500\u2500 api.py\n\u2502       \u251c\u2500\u2500 cli.py\n\u2502       \u2514\u2500\u2500 main.py\n\u251c\u2500\u2500 tests/\n\u2502   \u251c\u2500\u2500 unit/\n\u2502   \u2502   \u251c\u2500\u2500 test_utils.py\n\u2502   \u2502   \u251c\u2500\u2500 test_services.py\n\u2502   \u2502   \u251c\u2500\u2500 test_repository.py\n\u2502   \u2502   \u2514\u2500\u2500 test_controllers.py\n\u2502   \u2514\u2500\u2500 integration/\n\u2502       \u2514\u2500\u2500 test_cli_integration.py\n\u251c\u2500\u2500 migrations/\n\u2502   \u2514\u2500\u2500 0001_create_history_table.sql\n\u251c\u2500\u2500 data/\n\u2502   \u2514\u2500\u2500 README\n\u251c\u2500\u2500 pyproject.toml\n\u251c\u2500\u2500 README.md\n\u2514\u2500\u2500 LICENSE\n```\n```\n# LICENSE\nMIT License\n\nCopyright (c) 2023 Your Name\n\nPermission is hereby granted, free of charge, to any person obtaining a copy\nof this software and associated docum