token.\"\"\"\n        tokens = [\"o\", \"x\", \".|\"]\n        with pytest.raises(InvalidTokenError) as excinfo:\n            self.validator.validate(tokens, self.default_map)\n        assert excinfo.value.invalid_tokens == [\"x\"]\n        assert \"Unknown tokens: ['x']\" in str(excinfo.value)\n\n    def test_validate_with_multiple_invalid_tokens(self):\n        \"\"\"Test validation with multiple distinct invalid tokens.\"\"\"\n        tokens = [\"o\", \"x\", \".|\", \"y\", \"z\", \"x\"] # 'x' appears twice\n        with pytest.raises(InvalidTokenError) as excinfo:\n            self.validator.validate(tokens, self.default_map)\n        assert excinfo.value.invalid_tokens == [\"x\", \"y\", \"z\"] # Should be unique and in order of first appearance\n        assert \"Unknown tokens: ['x', 'y', 'z']\" in str(excinfo.value)\n\n    def test_validate_empty_token_list(self):\n        \"\"\"Test validation with an empty list of tokens.\"\"\"\n        tokens = []\n        self.validator.validate(tokens, self.default_map) # Should not raise\n\n    def test_find_invalid_no_invalid(self):\n        \"\"\"Test find_invalid with no invalid tokens.\"\"\"\n        tokens = [\"o\", \"o|\"]\n        assert self.validator.find_invalid(tokens, self.default_map) == []\n\n    def test_find_invalid_some_invalid(self):\n        \"\"\"Test find_invalid with some invalid tokens.\"\"\"\n        tokens = [\"o\", \"unknown\", \"o|\", \"another_unknown\", \"unknown\"]\n        assert self.validator.find_invalid(tokens, self.default_map) == [\"unknown\", \"another_unknown\"]\n\n    def test_validate_with_custom_map_and_valid_tokens(self):\n        \"\"\"Test validation against a custom mapping with valid tokens.\"\"\"\n        custom_map = {\"W\": 8, \"H\": 4}\n        tokens = [\"W\", \"H\"]\n        self.validator.validate(tokens, custom_map) # Should not raise\n\n    def test_validate_with_custom_map_and_invalid_tokens(self):\n        \"\"\"Test validation against a custom mapping with invalid