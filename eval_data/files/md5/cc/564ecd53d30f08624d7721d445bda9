    def test_parser_service_initialization_with_default_map(self):\n        \"\"\"Test ParserService initializes with default map if none provided.\"\"\"\n        service = ParserService(self.tokenizer, self.validator)\n        assert service._note_map == DEFAULT_NOTE_MAP\n\n    def test_parser_service_initialization_with_custom_map(self):\n        \"\"\"Test ParserService initializes with a custom map.\"\"\"\n        custom_map = {\"A\": 1, \"B\": 2}\n        service = ParserService(self.tokenizer, self.validator, custom_map)\n        assert service._note_map == custom_map\n\n    def test_parser_service_initialization_with_invalid_map_values(self):\n        \"\"\"Test ParserService raises ConfigurationError for non-integer map values.\"\"\"\n        invalid_map = {\"o\": 4, \"o|\": \"two\"}\n        with pytest.raises(ConfigurationError) as excinfo:\n            ParserService(self.tokenizer, self.validator, invalid_map)\n        assert \"All mapping values must be integers\" in str(excinfo.value)\n        assert \"found type <class 'str'>\" in str(excinfo.value) # More specific check\n\n    def test_parser_service_initialization_with_invalid_map_keys(self):\n        \"\"\"Test ParserService raises ConfigurationError for non-string map keys.\"\"\"\n        invalid_map = {1: 4}\n        with pytest.raises(ConfigurationError) as excinfo:\n            ParserService(self.tokenizer, self.validator, invalid_map)\n        assert \"Note map keys must be strings\" in str(excinfo.value)\n        assert \"found type <class 'int'>\" in str(excinfo.value) # More specific check\n\n    def test_parse_valid_music_string(self):\n        \"\"\"Test parsing a valid music string with the default map.\"\"\"\n        music_string = \"o o| .| o| o| .| .| .| .| o o\"\n        expected_durations = [4, 2, 1, 2, 2, 1, 1, 1, 1, 4, 4]\n        result = self.default_service.parse(music_string)\n        assert isinstance(result, ParseResult)\n        assert result.durations == expected_durations\n        assert result.source == music_string\n\n    def test_parse_empty_music_string(self):\n        \"\"\"Test parsing an empty music string raises EmptyInputError.\"\"\"\n        with pytest.raises(EmptyInputError) as excinfo:\n            self.default_service.parse(\"\")\n        assert \"Input is empty\" in str(excinfo.value)\n\n    def test_parse_whitespace_only_music_string(self):\n        \"\"\"Test parsing a whitespace-only string raises EmptyInputError.\"\"\"\n        with pytest.raises(EmptyInputError) as excinfo:\n            self.default_service.parse(\"   \\t\\n \")\n        assert \"Input is empty\" in str(excinfo.value)\n\n    def test_parse_with_unknown_tokens(self):\n        \"\"\"Test parsing with unknown tokens raises InvalidTokenError.\"\"\"\n        music_string = \"o x .| y\"\n        with pytest.raises(InvalidTokenError) as excinfo:\n            self.default_service.parse(music_string)\n        assert excinfo.value.invalid_tokens == [\"x\", \"y\"]\n        assert \"Unknown tokens: ['x', 'y']\" in str(excinfo.value)\n\n    def test_map_tokens(self):\n        \"\"\"Test the private _map_tokens method directly.\"\"\"\n        tokens = [\"o\", \"o|\", \".|\"]\n        expected = [4, 2, 1]\n        assert self.default_service._map_tokens(tokens) == expected\n\n    def test_parse_music_public_function_default_map(self):\n        \"\"\"Test the public parse_music convenience function with default map.\"\"\"\n        music_string = \"o o| .|\"\n        expected_durations = [4, 2, 1]\n        assert parse_music(music_string) == expected_durations\n\n    def test_parse_music_public_function_custom_map(self):\n        \"\"\"Test the public parse_music convenience function with a custom map.\"\"\"\n        custom_map = {\"w\": 8, \"h\": 4}\n        music_string = \"w h w\"\n        expected_durations = [8, 4, 8]\n        assert parse_music(music_string, custom_map) == expected_durations\n\n    def test_parse_music_public_function_empty_input(self):\n        \"\"\"Test the public parse_music function with empty input.\"\"\"\n        with pytest.raises(EmptyInputError):\n            parse_music(\"\")\n\n    def test_parse_music_public_function_invalid_token(self):\n        \"\"\"Test the public parse_music function with invalid tokens.\"\"\"\n        with pytest.raises(InvalidTokenError) as excinfo:\n            parse_music(\"o x\")\n        assert excinfo.value.invalid_tokens == [\"x\"]\n\n    def test_parse_music_public_function_invalid_custom_map(self):\n        \"\"\"Test the public parse_music function with invalid custom map.\"\"\"\n        with pytest.raises(ConfigurationError) as excinfo:\n            parse_music(\"o\", note_map={\"o\": \"invalid\"})\n        assert \"All mapping values must be integers\" in str(excinfo.value)\n\nclass TestParserServiceMocks:\n    def test_parse_calls_tokenizer_and_validator(self):\n        \"\"\"Ensure ParserService uses its collaborators correctly.\"\"\"\n        mock_tokenizer = Mock(spec=Tokenizer)\n        mock_validator = Mock(spec=Validator)\n        mock_tokenizer.tokenize.return_value = [\"o\", \"o|\"]\n        mock_validator.validate.return_value = None # No exception means valid\n\n        service = ParserService(mock_tokenizer, mock_validator, DEFAULT_NOTE_MAP)\n        music_string = \"o o|\"\n        result = service.parse(music_string)\n\n        mock_tokenizer.tokenize.assert_called_once_with(music_string)\n        mock_validator.validate.assert_called_once_with([\"o\", \"o|\"], DEFAULT_NOTE_MAP)\n        assert result.durations == [4, 2]\n\n```\n\n```text\ntests/test_tokenizer.py\n```python\n\"\"\"\nUnit tests for the Tokenizer class.\n\"\"\"\nimport pytest\nfrom src.music_parser.tokenizer import Tokenizer\n\nclass TestTokenizer:\n    def setup_method(self):\n        \"\"\"Set up for each test method.\"\"\"\n        self.tokenizer = Tokenizer()\n\n    @pytest.mark.parametrize(\n        \"input_str, expected_tokens\",\n        [\n            (\"o o| .|\", [\"