threshold: {result}\")\n\nnumbers_invalid = [1, 6, 3]\nthreshold = 5\nresult = service.is_below_threshold(numbers_invalid, threshold)\nprint(f\"All numbers below threshold: {result}\")\n\nprint(\"Recent checks:\", repo.get_recent())\n```\n\n### CLI Tool\n\n```bash\nthreshold-check --numbers \"1,2,3\" --threshold 5\n# Output: below\n# Exit Code: 0\n\nthreshold-check --numbers \"[1, 6, 3]\" --threshold 5\n# Output: not below\n# Exit Code: 1\n\nthreshold-check --numbers \"1,a,3\" --threshold 5\n# Output: Error: Invalid input for numbers.\n# Exit Code: 1 (or other non-zero for validation errors)\n```\n\n### HTTP JSON API (requires `threshold-checker[api]` installation)\n\nTo run the API:\n\n```bash\nuvicorn threshold_checker.api_app:app --host 0.0.0.0 --port 8000\n```\n\nThen, make requests using `curl` or a similar tool:\n\n```bash\ncurl -X POST -H \"Content-Type: application/json\" \\\n     -d '{\"numbers\": [1, 2, 3], \"threshold\": 5}' \\\n     http://localhost:8000/check\n\n# Response: {\"below\": true}\n\ncurl -X POST -H \"Content-Type: application/json\" \\\n     -d '{\"numbers\": [1, 6, 3], \"threshold\": 5}' \\\n     http://localhost:8000/check\n\n# Response: {\"below\": false}\n\ncurl -X POST -H \"Content-Type: application/json\" \\\n     -d '{\"numbers\": [1, \"a\"], \"threshold\": 5}' \\\n     http://localhost:8000/check\n\n# Response: {\"detail\": {\"numbers\": \"Invalid numbers format. Must be a list of integers.\"}}\n# HTTP Status: 400\n```\n\n## Development\n\nSet up a virtual environment and install dependencies:\n\n```bash\npoetry install --with dev --extras api\npoetry shell\n```\n\nThe `tests/` and `.github/` directories would contain unit tests and CI configurations respectively, ensuring code quality and correctness.\n```\n```python\n# src/threshold_checker/__init__.py\n\"\"\"\nthreshold_checker package provides a library, CLI, and optional API\nto determine if all numbers in a list are strictly below a given threshold.\n\"\"\"\n__version__ = \"0.1.0\"\n\n```\n```python\n# src/threshold_checker/config.py\nfrom dataclasses import dataclass\n\n@dataclass(frozen=True)\nclass Config:\n    \"\"\"Centralized configuration for the application.\"\"\"\n    API_KEY_HEADER: str = \"X-API-Key\"\n    DEFAULT_EXIT_CODE_TRUE: int = 0\n    DEFAULT_EXIT_CODE_FALSE: int = 1\n    DEFAULT_EXIT_CODE_ERROR: int = 2 # For validation/unhandled errors\n    MAX_LIST_LENGTH: int = 100000\n    ALLOW_FLOATS: bool = False\n    REPOSITORY_ENABLED: bool = True # Flag to enable/disable repository interaction\n\n_config = Config()\n\ndef get_config() -> Config:\n    \"\"\"Returns the application configuration.\"\"\"\n    return _config\n\n```\n```python\n# src/threshold_checker/exceptions.py\nclass ValidationError(Exception):\n    \"\"\"Exception for structured input validation failures.\"\"\"\n    def __init__(self, errors: dict[str, str]) -> None:\n        super().__init__(\"Validation failed.\")\n        self.errors = errors\n\n    def __str__(self) -> str:\n        return f\"Validation errors: {self.errors}\"\n\n```\n```python\n# src/threshold_checker/number_list.py\nfrom collections.abc import Iterator\n\nclass NumberList:\n    \"\"\"Domain model representing a validated list of integers.\"\"\"\n    def __init__(self, numbers: list[int]) -> None:\n        self._numbers = list(numbers)\n\n    @property\n    def numbers(self) -> list[int]:\n        \"\"\"Returns the internal list of numbers.\"\"\"\n        return self._numbers\n\n    def __len__(self) -> int:\n        \"\"\"Returns the length of the number list.\"\"\"\n        return len(self._numbers)\n\n    def __iter__(self) -> Iterator[int]:\n        \"\"\"Returns an iterator for the numbers.\"\"\"\n        return iter(self._numbers)\n\n```\n```python\n# src/threshold_checker/list_schema.py\nfrom pydantic import BaseModel\nfrom typing import ClassVar\n\nclass ListSchema(BaseModel):\n    \"\"\"Canonical schema for external inputs, using Pydantic.\"\"\"\n    numbers: list[int]\n    threshold: int\n\n    @classmethod\n    def from_dict(cls, data: dict) -> \"ListSchema\":\n        \"\"\"Creates a ListSchema instance from a dictionary.\"\"\"\n        return cls(**data)\n\n```\n```python\n# src/threshold_checker/validators.py\nfrom typing import Any\nfrom threshold_checker.exceptions import ValidationError\nfrom threshold_checker.list_schema import ListSchema\nfrom threshold_checker.config import get_config\n\nclass ListValidator:\n    \"\"\"Validates raw payloads for 'numbers' and 'threshold'.\"\"\"\n    def __init__(self):\n        self._config = get_config()\n\n    def validate(self, payload: dict) -> ListSchema:\n        \"\"\"Validates the entire payload dictionary.\"\"\"\n        errors: dict[str, str] = {}\n        numbers_val: list[int] | None = None\n        threshold_val: int | None = None\n\n        if \"numbers\" not in payload:\n            errors[\"numbers\"] = \"Field is required.\"\n        else:\n            try:\n                numbers_val = self._validate_numbers(payload[\"numbers\"])\n            except ValidationError as e:\n                errors[\"numbers\"] = str(e.errors.get(\"numbers\", \"Invalid numbers format.\"))\n\n        if \"threshold\" not in payload:\n            errors[\"threshold\"] = \"Field is required.\"\n        else:\n            try:\n                threshold_val = self._validate_threshold(payload[\"threshold\"])\n            except ValidationError as e:\n                errors[\"threshold\"] = str(e.errors.get(\"threshold\", \"Invalid threshold format.\"))\n\n        if errors:\n            raise ValidationError(errors)\n        \n        # At this point, numbers_val and threshold_val are guaranteed to be set\n        # if no ValidationError was raised.\n        return ListSchema(numbers=numbers_val, threshold=threshold_val) # type: ignore\n\n    def _validate_numbers(self, numbers: Any) -> list[int]:\n        \"\"\"Validates the 'numbers' field.\"\"\"\n        if not isinstance(numbers, (list, tuple)):\n            raise ValidationError({\"numbers\": \"Must be a list or tuple.\"})\n        \n        if len(numbers) > self._config.MAX_LIST_LENGTH:\n            raise ValidationError({\"numbers\": f\"List exceeds max length of {self._config.MAX_LIST_LENGTH}.\"})\n\n        validated_numbers: list[int] = []\n        for idx, n in enumerate(numbers):\n            if isinstance(n, int):\n                validated_numbers.append(n)\n            elif isinstance(n, float) and self._config.ALLOW_FLOATS:\n                validated_numbers.append(int(n)) # Convert float to int if allowed and cast implicitly\n            else:\n                raise ValidationError({\"numbers\": f\"Element at index {idx} must be an integer.\"})\n        return validated_numbers\n\n    def _validate_threshold(self, threshold: Any) -> int:\n        \"\"\"Validates the 'threshold' field.\"\"\"\n        if not isinstance(threshold, int):\n            try: # Attempt to cast if it's a float without fractional part\n                if isinstance(threshold, float) and threshold == int(threshold):\n                    return int(threshold)\n            except (TypeError, ValueError):\n                pass\n            raise ValidationError({\"threshold\": \"Must be an integer.\"})\n        return threshold\n\n```\n```python\n# src/threshold_checker/repository_interface.py\nfrom abc import ABC, abstractmethod\n\nclass Repository(ABC):\n    \"\"\"Abstract base class for a repository to store check results.\"\"\"\n    @abstractmethod\n    def save_check(self, numbers: list[int], threshold: int, result: bool) -> None:\n        \"\"\"Saves the details of a threshold check.\"\"\"\n        pass\n\n```\n```python\n# src/threshold_checker/in_memory_repository.py\nfrom collections import deque\nfrom datetime import datetime\nfrom threshold_checker.repository_interface import Repository\n\nclass InMemoryRepository(Repository):\n    \"\"\"Ephemeral in-memory storage for recent checks.\"\"\"\n    def __init__(self, max_items: int = 1000) -> None:\n        self._store: deque[dict] = deque(maxlen=max_items)\n        self._max_items = max_items\n\n    def save_check(self, numbers: list[int], threshold: int, result: bool) -> None:\n        \"\"\"Adds a new check result to the in-memory store.\"\"\"\n        check_data = {\n            \"numbers\": numbers,\n            \"threshold\": threshold,\n            \"result\": result,\n            \"ts\": datetime.now().isoformat()\n        }\n        self._store.append(check_data)\n\n    def get_recent(self, limit: int = 10) -> list[dict]:\n        \"\"\"Retrieves a list of recent check results.\"\"\"\n        return list(self._store)[-limit:]\n\n```\n```python\n# src/threshold_checker/threshold_service.py\nimport logging\nfrom typing import Optional\nfrom threshold_checker.repository_interface import Repository\nfrom threshold_checker.config import get_config\n\nlogger = logging.getLogger(__name__)\n\n# This is the bare function from the original problem statement,\n# adhering to CRITICAL REQUIREMENTS.\ndef below_threshold(l: list, t: int):\n    \"\"\"Return True if all numbers in the list l are below threshold t.\"\"\"\n    for n in l:\n        if n >= t:\n            return False\n    return True\n\nclass ThresholdService:\n    \"\"\"Core business logic for checking numbers against a threshold.\"\"\"\n    def __init__(self, repository: Optional[Repository] = None) -> None:\n        self._repo = repository\n        self._config = get_config()\n\n    def is_below_threshold(self, numbers: list[int], threshold: int) -> bool:\n        \"\"\"Determines if all numbers are strictly below the threshold.\n\n        Assumes inputs are already validated as per design specification.\n        \"\"\"\n        # Call the bare function for core numerical logic\n        result = below_threshold(numbers, threshold)\n\n        if self._config.REPOSITORY_ENABLED and self._repo:\n            try:\n                self._repo.save_check(numbers, threshold, result)\n            except Exception as e:\n                logger.error(f\"Failed to save check to repository: {e}\")\n                # Log error but do not fail core business logic\n\n        return result\n\n```\n```python\n# src/threshold_checker/cli_controller.py\nimport json\nfrom typing import Optional, Tuple\nfrom threshold_checker.validators import ListValidator\nfrom threshold_checker.threshold_service import ThresholdService\nfrom threshold_checker.exceptions import ValidationError\nfrom threshold_checker.config import get_config\nfrom threshold_checker.utils import parse_numbers\n\nclass CLIController:\n    \"\"\"Handles CLI input parsing, validation, and service orchestration.\"\"\"\n    def __init__(self, validator: ListValidator, service: ThresholdService) -> None:\n        self._validator = validator\n        self._service = service\n        self._config = get_config()\n\n    def run(self, raw_numbers: Optional[str], raw_threshold: Optional[str]) -> Tuple[bool, int]:\n        \"\"\"\n        Processes CLI arguments, calls the service, and returns the result and exit code.\n        Returns (result_bool, exit_code).\n        \"\"\"\n        payload: dict[str, Any] = {}\n\n        if raw_numbers is not None:\n            try:\n                # Attempt to parse as JSON first, then comma-separated\n                payload[\"numbers\"] = parse_numbers(raw_numbers)\n            except (json.JSONDecodeError, ValueError):\n                # If parse_numbers fails, it means it's not valid JSON or comma-separated\n                # The ListValidator will catch specific type issues.\n                payload[\"numbers\"] = raw_numbers # Pass raw for validator to report specific errors\n\n        if raw_threshold is not None:\n            try:\n                payload[\"threshold\"] = int(raw_threshold)\n            except ValueError:\n                payload[\"threshold\"] = raw_threshold # Pass raw for validator to report specific errors\n        \n        try:\n            validated_input = self._validator.validate(payload)\n            result = self._service.is_below_threshold(\n                validated_input.numbers,\n                validated_input.threshold\n            )\n            exit_code = self._config.DEFAULT_EXIT_CODE_TRUE if result else self._config.DEFAULT_EXIT_CODE_FALSE\n            return result, exit_code\n        except ValidationError as e:\n            # For CLI, a validation error typically means an exit code indicating error.\n            print(f\"Error: Invalid input. Details: {e.errors}\")\n            return False, self._config.DEFAULT_EXIT_CODE_ERROR\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\")\n            return False, self._config.DEFAULT_EXIT_CODE_ERROR\n\n\n```\n```python\n# src/threshold_checker/api_controller.py\nfrom typing import Any\nfrom threshold_checker.validators import ListValidator\nfrom threshold_checker.threshold_service import ThresholdService\nfrom threshold_checker.exceptions import ValidationError\n\nclass APIController:\n    \"\"\"Handles HTTP request payloads, validates, and orchestrates service calls.\"\"\"\n    def __init__(self, validator: ListValidator, service: ThresholdService) -> None:\n        self._validator = validator\n        self._service = service\n\n    def post_check(self, payload: dict[str, Any]) -> dict[str, bool]:\n        \"\"\"\n        Processes a POST /check request payload.\n        Raises ValidationError for invalid inputs.\n        \"\"\"\n        validated_input = self._validator.validate(payload)\n        result = self._service.is_below_threshold(\n            validated_input.numbers,\n            validated_input.threshold\n        )\n        return {\"below\": result}\n\n```\n```python\n# src/threshold_checker/cli_app.py\nimport argparse\nimport sys\nfrom typing import Optional, List\nfrom threshold_checker.cli_controller import CLIController\nfrom threshold_checker.threshold_service import ThresholdService\nfrom threshold_checker.in_memory_repository import InMemoryRepository\nfrom threshold_checker.validators import ListValidator\nfrom threshold_checker.config import get_config\nfrom threshold_checker.utils import format_result # For consistent output formatting\n\nclass CLIApp:\n    \"\"\"Command-line interface application entrypoint.\"\"\"\n    def __init__(self, controller: CLIController) -> None:\n        self._controller = controller\n        self._config = get_config()\n\n    def run(self, argv: Optional[List[str]] = None) -> int:\n        \"\"\"\n        Parses CLI arguments, invokes the controller, and prints results/errors.\n        Returns the appropriate exit code.\n        \"\"\"\n        parser = argparse.ArgumentParser(\n            description=\"Check if a list of numbers is strictly below a threshold.\"\n        )\n        parser.add_argument(\n            \"--numbers\",\n            type=str,\n            required=True,\n            help=\"Comma-separated integers or a JSON array string (e.g., '1,2,3' or '[1,2,3]')\"\n        )\n        parser.add_argument(\n            \"--threshold\",\n            type=int,\n            required=True,\n            help=\"An integer threshold.\"\n        )\n        \n        args = parser.parse_args(argv)\n\n        result_bool, exit_code = self._controller.run(\n            raw_numbers=args.numbers,\n            raw_threshold=str(args.threshold) # Pass as string for validator's flexibility\n        )\n        \n        if exit_code == self._config.DEFAULT_EXIT_CODE_ERROR:\n            # Error message is already printed by controller for validation errors\n            pass \n        else:\n            print(format_result(result_bool))\n        \n        return exit_code\n\ndef main():\n    \"\"\"Entry point for the threshold-check CLI command.\"\"\"\n    # Wire up dependencies\n    repository = InMemoryRepository()\n    service = ThresholdService(repository=repository)\n    validator = ListValidator()\n    controller = CLIController(validator=validator, service=service)\n    \n    app = CLIApp(controller=controller)\n    sys.exit(app.run())\n\n```\n```python\n# src/threshold_checker/api_app.py\nimport os\nfrom typing import Any, Optional\nfrom fastapi import FastAPI, Request, HTTPException, status\nfrom fastapi.responses import JSONResponse\nfrom threshold_checker.api_controller import APIController\nfrom threshold_checker.threshold_service import ThresholdService\nfrom threshold_checker.in_memory_repository import InMemoryRepository\nfrom threshold_checker.validators import ListValidator\nfrom threshold_checker.exceptions import ValidationError\nfrom threshold_checker.config import get_config\n\nclass APIApp:\n    \"\"\"FastAPI application factory for the HTTP API.\"\"\"\n    def __init__(self, controller: APIController) -> None:\n        self._controller = controller\n        self._config = get_config()\n\n    def create_app(self) -> FastAPI:\n        \"\"\"\n        Creates and configures the FastAPI application instance.\n        \"\"\"\n        app = FastAPI(\n            title=\"Threshold Checker API\",\n            description=\"API to check if a list of numbers is strictly below a threshold.\",\n            version=\"0.1.0\"\n        )\n\n        @app.exception_handler(ValidationError)\n        async def validation_exception_handler(request: Request, exc: ValidationError):\n            \"\"\"Handles ValidationError and returns a 400 Bad Request.\"\"\"\n            return JSONResponse(\n                status_code=status.HTTP_400_BAD_REQUEST,\n                content={\"detail\": exc.errors},\n            )\n\n        @app.post(\"/check\", response_model=dict[str, bool])\n        async def check(request: Request, payload: dict[str, Any]):\n            \"\"\"\n            Checks if all numbers in the provided list are below the given threshold.\n            \"\"\"\n            # Optional API Key Authentication\n            api_key = os.environ.get(\"THRESHOLD_API_KEY\")\n            if api_key:\n                provided_api_key = request.headers.get(self._config.API_KEY_HEADER)\n                if not provided_api_key or provided_api_key != api_key:\n                    raise HTTPException(\n                        status_code=status.HTTP_401_UNAUTHORIZED,\n                        detail=\"Invalid or missing API Key\"\n                    )\n\n            return self._controller.post_check(payload)\n\n        return app\n\n# Global FastAPI app instance for Uvicorn\nrepository = InMemoryRepository()\nservice = ThresholdService(repository=repository)\nvalidator = ListValidator()\ncontroller = APIController(validator=validator, service=service)\napp = APIApp(controller=controller).create_app()\n\n```\n```python\n# src/threshold_checker/utils.py\nimport json\nfrom typing import List, Union\n\ndef parse_numbers(s: str) -> List[int]:\n    \"\"\"\n    Parses a string into a list of integers.\n    Supports JSON array string or comma-separated values.\n    Raises ValueError if parsing fails.\n    \"\"\"\n    try:\n        # Try parsing as JSON array first\n        parsed_json = json.loads(s)\n        if isinstance(parsed_json, list):\n            # Ensure all elements are integers or convertible\n            return [int(x) for x in parsed_json]\n        raise ValueError(\"JSON string is not a list.\")\n    except json.JSONDecodeError:\n        # If not JSON, try comma-separated values\n        try:\n            return [int(x.strip()) for x in s.split(',')]\n        except ValueError:\n            raise ValueError(\"String must be a comma-separated list of integers or a JSON array.\")\n    except ValueError as e:\n        raise ValueError(f\"Invalid number format in list: {e}\")\n\n\ndef format_result(result: bool) -> str:\n    \"\"\"Formats a boolean result into a human-readable string.\"\"\"\n    return \"below\" if result else \"not below\"\n\n```\n```python\n# src/threshold_checker/__main__.py\n\"\"\"\nAllows invoking the CLI application directly using `python -m threshold_checker`.\n\"\"\"\nfrom threshold_checker.cli_app import main\n\nif __name__ == \"__main__\":\n    main()\n\n```"}
