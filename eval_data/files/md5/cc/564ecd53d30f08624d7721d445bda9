{"task_id": "HumanEval/0", "solution": "```python\nfrom typing import List\n\n\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    n = len(numbers)\n    if n < 2:\n        return False\n\n    # Sort the list to enable O(n log n) detection by comparing adjacent elements.\n    sorted_numbers = sorted(numbers)\n\n    # Scan through the sorted list and check differences between adjacent pairs.\n    for i in range(n - 1):\n        if sorted_numbers[i+1] - sorted_numbers[i] < threshold:\n            return True\n\n    return False\n```"}
{"task_id": "HumanEval/1", "solution": "```python\nfrom typing import List\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    \"\"\"\n    groups = []\n    balance = 0\n    current_group_chars = []\n\n    for char in paren_string:\n        if char.isspace():\n            continue\n        \n        if char == '(':\n            balance += 1\n            current_group_chars.append(char)\n        elif char == ')':\n            balance -= 1\n            current_group_chars.append(char)\n        # Any other characters are ignored, as per \"simplest, most direct logic\".\n        \n        # A group completes when the balance returns to 0 and characters have been collected.\n        if balance == 0 and current_group_chars:\n            groups.append(\"\".join(current_group_chars))\n            current_group_chars = []\n            \n    return groups\n```"}
{"task_id": "HumanEval/0", "solution": "```python\nimport argparse\nimport sys\nimport math\nfrom dataclasses import dataclass\nfrom typing import Iterable, List, Optional, Tuple\n\n# === src/close_elements/exceptions.py ===\nclass CloseElementsError(Exception):\n    \"\"\"Custom exception for errors in the close_elements library.\"\"\"\n    pass\n\n\n# === src/close_elements/models.py ===\n@dataclass\nclass NumberList:\n    \"\"\"Represents a validated list of numbers.\"\"\"\n    values: List[float]\n\n    @staticmethod\n    def from_iterable(iterable: Iterable[float]) -> \"NumberList\":\n        \"\"\"Validates and coerces items to float, raising CloseElementsError on failure.\"\"\"\n        if not isinstance(iterable, Iterable):\n            raise CloseElementsError(\"Input for numbers must be an iterable.\")\n        try:\n            vals = [float(x) for x in iterable]\n        except (ValueError, TypeError) as e:\n            raise CloseElementsError(f\"Invalid numeric input in list: {e}\")\n        return NumberList(values=vals)\n\n@dataclass\nclass CloseElementsResult:\n    \"\"\"Conveys the result of the close elements algorithm.\"\"\"\n    found: bool\n    pair: Optional[Tuple[float, float]]\n\n\n# === src/close_elements/strategies.py ===\nclass SortStrategy:\n    \"\"\"Interface for sorting algorithms.\"\"\"\n    def sort(self, numbers: List[float]) -> List[float]:\n        \"\"\"Returns a sorted copy of the numbers; does not mutate input.\"\"\"\n        raise NotImplementedError(\"Subclasses must implement the sort method.\")\n\nclass TimSortStrategy(SortStrategy):\n    \"\"\"Default strategy using Python's built-in sorted() (Timsort).\"\"\"\n    def sort(self, numbers: List[float]) -> List[float]:\n        \"\"\"Returns a sorted list using Python's default sort.\"\"\"\n        return list(sorted(numbers))\n\n\n# === src/close_elements/services.py ===\nDEFAULT_SORT_STRATEGY = TimSortStrategy()\n\nclass CloseElementsService:\n    \"\"\"Core algorithm to check for close elements.\"\"\"\n    def __init__(self, sort_strategy: Optional[SortStrategy] = None) -> None:\n        \"\"\"Initializes with a sort strategy, defaulting to TimSortStrategy.\"\"\"\n        self._sort_strategy = sort_strategy or DEFAULT_SORT_STRATEGY\n\n    def has_close_elements(self, numbers: List[float], threshold: float) -> CloseElementsResult:\n        \"\"\"\n        Implements the algorithm to find if any two numbers are closer than a threshold.\n        Validates inputs, sorts numbers, and scans for adjacent differences.\n        \"\"\"\n        if not isinstance(threshold, (int, float)):\n            raise CloseElementsError(\"Threshold must be a non-negative number.\")\n        if threshold < 0:\n            raise CloseElementsError(\"Threshold must be non-negative.\")\n\n        num_list = NumberList.from_iterable(numbers)\n        \n        sorted_vals = self._sort_strategy.sort(num_list.values)\n\n        for i in range(len(sorted_vals) - 1):\n            a, b = sorted_vals[i], sorted_vals[i+1]\n            if math.fabs(b - a) < float(threshold):\n                return CloseElementsResult(found=True, pair=(a, b))\n        \n        return CloseElementsResult(found=False, pair=None)\n\n\n# === src/close_elements/__init__.py ===\nclass PublicAPI:\n    \"\"\"High-level API facade for library consumers.\"\"\"\n    @staticmethod\n    def has_close_elements(numbers: List[float], threshold: float) -> bool:\n        \"\"\"\n        Checks if any two numbers in a list are closer than a given threshold.\n        Delegates to CloseElementsService with default TimSortStrategy.\n        \"\"\"\n        svc = CloseElementsService(sort_strategy=TimSortStrategy())\n        result = svc.has_close_elements(numbers, threshold)\n        return result.found\n\n# Module-level convenience function as per spec.\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\"\n    Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    \"\"\"\n    return PublicAPI.has_close_elements(numbers, threshold)\n\n__all__ = [\"has_close_elements\", \"PublicAPI\", \"CloseElementsError\"]\n\n\n# === src/close_elements/utils.py ===\ndef parse_numbers_arg(arg: str) -> List[float]:\n    \"\"\"Parses a string of comma-separated numbers into a list of floats.\"\"\"\n    if not isinstance(arg, str):\n        raise CloseElementsError(\"Numbers argument must be a string.\")\n    \n    parts = arg.split(',')\n    \n    try:\n        return [float(x.strip()) for x in parts if x.strip()]\n    except ValueError as e:\n        raise CloseElementsError(f\"Invalid number format in --numbers argument: {e}\")\n\n# === src/close_elements/cli.py ===\nCLI_EXIT_OK = 0\nCLI_EXIT_ERROR = 2\n\nclass CliController:\n    \"\"\"CLI controller for the close-elements utility.\"\"\"\n    @staticmethod\n    def run(argv: Optional[List[str]] = None) -> int:\n        \"\"\"\n        Parses command-line arguments, calls the public API, and prints the result.\n        Returns an exit code. This static method serves as the main entry point for the CLI.\n        \"\"\"\n        parser = argparse.ArgumentParser(\n            prog=\"close-elements\",\n            description=\"Determine if any two numbers in a list are closer than a given threshold.\"\n        )\n        parser.add_argument(\n            \"--numbers\",\n            type=str,\n            help=\"Comma-separated list of numbers (e.g., '1.0,2.5,3'). Required if --file is not used.\"\n        )\n        parser.add_argument(\n            \"--threshold\",\n            type=float,\n            required=True,\n            help=\"The threshold value (a non-negative float).\"\n        )\n        parser.add_argument(\n            \"--file\",\n            type=str,\n            help=\"Path to a file containing numbers, one per line or space-separated. If provided, --numbers is ignored.\"\n        )\n\n        args = parser.parse_args(argv if argv is not None else sys.argv[1:])\n\n        if not args.numbers and not args.file:\n            parser.error(\"Either --numbers or --file must be provided.\")\n\n        numbers_to_process: List[float] = []\n\n        try:\n            if args.file:\n                with open(args.file, 'r') as f:\n                    file_content = f.read()\n                raw_nums_from_file = []\n                for line in file_content.splitlines():\n                    raw_nums_from_file.extend(line.split())\n                \n                numbers_to_process = [float(x) for x in raw_nums_from_file if x.strip()]\n            elif args.numbers:\n                numbers_to_process = parse_numbers_arg(args.numbers)\n            \n            result = has_close_elements(numbers_to_process, args.threshold)\n            print(result)\n            return CLI_EXIT_OK\n        except CloseElementsError as e:\n            print(f\"Error: {e}\", file=sys.stderr)\n            return CLI_EXIT_ERROR\n        except FileNotFoundError:\n            print(f\"Error: File not found at '{args.file}'\", file=sys.stderr)\n            return CLI_EXIT_ERROR\n        except ValueError as e: # Catch other potential float conversion errors from file parsing\n            print(f\"Error processing numbers from file or arguments: {e}\", file=sys.stderr)\n            return CLI_EXIT_ERROR\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return CLI_EXIT_ERROR\n```"}
{"task_id": "HumanEval/1", "solution": "from typing import List\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    # Remove all whitespace characters from the input string.\n    processed_string = ''.join(char for char in paren_string if not char.isspace())\n\n    groups = []\n    balance_depth = 0\n    current_group_start = 0\n\n    for i, char in enumerate(processed_string):\n        if char == '(':\n            balance_depth += 1\n        elif char == ')':\n            balance_depth -= 1\n\n        # When the balance depth returns to zero, a complete top-level balanced group is found.\n        if balance_depth == 0:\n            groups.append(processed_string[current_group_start : i + 1])\n            current_group_start = i + 1\n            \n    return groups"}
