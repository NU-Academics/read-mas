{"task_id": "HumanEval/139", "solution": "# The in-memory cache for factorials. Seeded with 0! and 1! as base cases.\n# This cache is shared across calls to special_factorial to improve performance.\n_factorial_cache = {0: 1, 1: 1}\n\ndef _compute_factorial_iterative(k: int) -> int:\n    \"\"\"Computes factorial k! iteratively, using and updating the global cache.\n    It calculates factorials from the largest cached value up to k.\n    \"\"\"\n    if k in _factorial_cache:\n        return _factorial_cache[k]\n\n    # Find the largest factorial already computed in the cache that is less than k.\n    max_cached_k = max(key for key in _factorial_cache if key < k)\n    current_product = _factorial_cache[max_cached_k]\n\n    # Compute factorials from max_cached_k + 1 up to k, storing intermediate results.\n    for i in range(max_cached_k + 1, k + 1):\n        current_product *= i\n        _factorial_cache[i] = current_product\n\n    return current_product\n\ndef special_factorial(n: int) -> int:\n    \"\"\"The Brazilian factorial is defined as: brazilian_factorial(n) = n! * (n-1)! * ... * 1!.\n    This function computes the special factorial for a given positive integer n.\n    \"\"\"\n    brazilian_factorial_result = 1\n    # Iterate from 1 up to n to compute k! for each k and multiply them.\n    for k in range(1, n + 1):\n        k_factorial = _compute_factorial_iterative(k)\n        brazilian_factorial_result *= k_factorial\n    return brazilian_factorial_result"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    \"\"\"\n    \n    special_factorial_result = 1\n    current_factorial_value = 1\n\n    # Iteratively calculate k! for k from 1 to n,\n    # then multiply each k! into the running special factorial result.\n    for k in range(1, n + 1):\n        current_factorial_value *= k \n        special_factorial_result *= current_factorial_value\n\n    return special_factorial_result"}
{"task_id": "HumanEval/140", "solution": "import re\n\ndef fix_spaces(text):\n    \"\"\"\n    Replaces runs of 3 or more spaces with a hyphen, then replaces all remaining single spaces with an underscore.\n    Assumes valid string input.\n    \"\"\"\n    # First, replace runs of 3 or more spaces with a single hyphen.\n    # The design specified r\" {3,}\"\n    text = re.sub(r\" {3,}\", \"-\", text)\n    # Second, replace all remaining single spaces with an underscore.\n    # The design specified r\" \"\n    text = re.sub(r\" \", \"_\", text)\n    return text"}
{"task_id": "HumanEval/140", "solution": "import re\n\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores.\n    If a string has more than 2 consecutive spaces, replace all consecutive spaces with a single hyphen.\n    \"\"\"\n    def _replace_runs(m):\n        \"\"\"Helper function to determine replacement based on the length of matched space runs.\"\"\"\n        run = m.group(1)\n        if len(run) >= 3:\n            return \"-\"\n        return \"_\" * len(run)\n    \n    return re.sub(r\"( {1,})\", _replace_runs, text)"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Checks if a file name is valid based on a strict rule set.\n    Returns 'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    \"\"\"\n    # Rule: The file's name contains exactly one dot '.'\n    if file_name.count('.') != 1:\n        return 'No'\n\n    parts = file_name.split('.')\n    prefix = parts[0]\n    extension = parts[1]\n\n    # Rule: The substring before the dot should not be empty.\n    if not prefix:\n        return 'No'\n\n    # Rule: The substring before the dot starts with a latin alphabet letter.\n    first_char_of_prefix = prefix[0]\n    if not ('a' <= first_char_of_prefix <= 'z' or 'A' <= first_char_of_prefix <= 'Z'):\n        return 'No'\n\n    # Rule: The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    if extension not in ['txt', 'exe', 'dll']:\n        return 'No'\n\n    # Rule: There should not be more than three digits ('0'-'9') in the file's name.\n    digit_count = 0\n    for char in file_name:\n        if '0' <= char <= '9':\n            digit_count += 1\n    if digit_count > 3:\n        return 'No'\n\n    # If all conditions are met, the file name is valid.\n    return 'Yes'"}
{"task_id": "HumanEval/141", "solution": "```python\ndef file_name_check(file_name):\n    \"\"\"Checks if a file name is valid according to specific rules.\n    Returns 'Yes' if valid, 'No' otherwise.\n    \"\"\"\n    digit_count = 0\n    for char in file_name:\n        if '0' <= char <= '9':\n            digit_count += 1\n    if digit_count > 3:\n        return 'No'\n\n    if file_name.count('.') != 1:\n        return 'No'\n\n    parts = file_name.split('.', 1)\n    prefix = parts[0]\n    suffix = parts[1]\n\n    if not prefix:\n        return 'No'\n\n    first_char_ord = ord(prefix[0])\n    if not ((65 <= first_char_ord <= 90) or (97 <= first_char_ord <= 122)):\n        return 'No'\n\n    allowed_suffixes = ['txt', 'exe', 'dll']\n    if suffix not in allowed_suffixes:\n        return 'No'\n    \n    return 'Yes'\n```"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    Computes a transformed sum over a list of integers based on index rules.\n    Indexes divisible by 3 square the element; indexes divisible by 4 (but not 3) cube the element.\n    \"\"\"\n    total = 0\n    for i, x in enumerate(lst):\n        if i % 3 == 0:\n            total += x ** 2\n        elif i % 4 == 0:\n            total += x ** 3\n        else:\n            total += x\n    return total"}
{"task_id": "HumanEval/142", "solution": "```python\ndef sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a \n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not \n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries. \n    \n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    total = 0\n    for i, v in enumerate(lst):\n        transformed_value = v\n        if i % 3 == 0:\n            transformed_value = v * v\n        elif i % 4 == 0: # This applies if the index is a multiple of 4 AND NOT a multiple of 3\n            transformed_value = v * v * v\n        # Otherwise, the value remains unchanged as per the initial assignment\n        total += transformed_value\n    return total\n```"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Extracts words from a sentence whose lengths are prime numbers, preserving original order.\n    Assumes valid input sentence as per constraints (1-100 chars, letters only).\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"Checks if a number is prime, for positive integers.\"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    words = sentence.split()\n    prime_length_words = []\n    for word in words:\n        if is_prime(len(word)):\n            prime_length_words.append(word)\n\n    return \" \".join(prime_length_words)"}
{"task_id": "HumanEval/143", "solution": "```python\ndef words_in_sentence(sentence):\n    \"\"\"\n    You are given a string representing a sentence,\n    the sentence contains some words separated by a space,\n    and you have to return a string that contains the words from the original sentence,\n    whose lengths are prime numbers,\n    the order of the words in the new string should be the same as the original one.\n    \"\"\"\n\n    def is_prime(n):\n        # Checks if a given integer n is a prime number.\n        # Handles 0, 1, 2, and other numbers using trial division.\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    filtered_words = []\n    for word in sentence.split():\n        if is_prime(len(word)):\n            filtered_words.append(word)\n\n    return \" \".join(filtered_words)\n```"}
{"task_id": "HumanEval/144", "solution": "def gcd(a, b):\n    \"\"\"Compute the greatest common divisor of two non-negative integers.\"\"\"\n    while b:\n        a, b = b, a % b\n    return a\n\ndef simplify(x, n):\n    \"\"\"Determines if the product of two fractions, x and n, is a whole number.\n    Fractions are given as strings \"numerator/denominator\".\n    \"\"\"\n    x_parts = x.split('/')\n    num_x = int(x_parts[0])\n    den_x = int(x_parts[1])\n\n    n_parts = n.split('/')\n    num_n = int(n_parts[0])\n    den_n = int(n_parts[1])\n\n    product_num = num_x * num_n\n    product_den = den_x * den_n\n\n    common_divisor = gcd(product_num, product_den)\n    reduced_den = product_den // common_divisor\n\n    return reduced_den == 1"}
{"task_id": "HumanEval/144", "solution": "```python\nimport math\n\ndef simplify(x, n):\n    \"\"\"Determines if the product of two fractions x and n is a whole number.\n    Inputs are strings like \"numerator/denominator\", with positive integers.\n    \"\"\"\n    x_num_str, x_den_str = x.split('/')\n    x_num = int(x_num_str)\n    x_den = int(x_den_str)\n\n    n_num_str, n_den_str = n.split('/')\n    n_num = int(n_num_str)\n    n_den = int(n_den_str)\n\n    product_num = x_num * n_num\n    product_den = x_den * n_den\n\n    # Calculate the greatest common divisor to reduce the fraction.\n    common_divisor = math.gcd(product_num, product_den)\n    \n    # The product is a whole number if its reduced denominator is 1.\n    return (product_den // common_divisor) == 1\n```"}
{"task_id": "HumanEval/145", "solution": "```python\ndef order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers by the sum of their digits.\n    Ties are broken by the original index to ensure stability.\n    \"\"\"\n    processed_numbers = []\n    for index, num in enumerate(nums):\n        current_num_abs = abs(num)\n        digit_sum = 0\n        if current_num_abs == 0:\n            digit_sum = 0\n        else:\n            # Calculate digit sum using iterative integer arithmetic.\n            while current_num_abs > 0:\n                digit_sum += current_num_abs % 10\n                current_num_abs //= 10\n        processed_numbers.append((digit_sum, index, num))\n\n    # Sort primarily by digit_sum, secondarily by original index for stable tie-breaking.\n    processed_numbers.sort()\n\n    # Extract and return the original numbers in the sorted order.\n    return [num for _, _, num in processed_numbers]\n```"}
{"task_id": "HumanEval/145", "solution": "```python\ndef order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers by the sum of their digits (ascending).\n    For values with equal digit-sums, their original relative order is preserved.\n    \"\"\"\n    def _compute_digit_sum(value):\n        # Calculates the sum of decimal digits for a number's absolute value.\n        s = 0\n        n = abs(value)\n        while n:\n            s += n % 10\n            n //= 10\n        return s\n\n    # Create a list of (digit_sum, original_index, value) tuples for sorting.\n    items_with_keys = []\n    for index, value in enumerate(nums):\n        digit_sum = _compute_digit_sum(value)\n        items_with_keys.append((digit_sum, index, value))\n\n    # Sort the list using the digit_sum as primary key and index as secondary for stability.\n    items_with_keys.sort()\n\n    # Extract the original values from the sorted list.\n    return [item[2] for item in items_with_keys]\n```"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"Counts numbers in a list that are greater than 10 and have odd first and last digits.\n    Handles integers, floats (truncated), and numeric strings, assuming valid input.\"\"\"\n\n    def is_odd_digit(d: int) -> bool:\n        \"\"\"Checks if a single digit is odd.\"\"\"\n        return d % 2 == 1\n\n    def get_first_last_digits(n: int) -> tuple[int, int]:\n        \"\"\"Extracts the first and last digits of a number, ignoring its sign.\"\"\"\n        abs_n = abs(int(n))\n        last_digit = abs_n % 10\n        first_digit = int(str(abs_n)[0]) if abs_n != 0 else 0\n        return first_digit, last_digit\n\n    count = 0\n    for item in nums:\n        # Convert item to integer. Assuming valid input per critical requirements.\n        n = int(item)\n\n        if n > 10:\n            first, last = get_first_last_digits(n)\n            if is_odd_digit(first) and is_odd_digit(last):\n                count += 1\n    return count"}
{"task_id": "HumanEval/146", "solution": "```python\ndef specialFilter(nums):\n    \"\"\"Counts numbers greater than 10 where both the first and last digits are odd.\n    Uses absolute value and integer part for digit extraction from numbers.\n    \"\"\"\n    count = 0\n    for num in nums:\n        if num > 10:\n            # Use integer part for digit extraction (floor toward zero).\n            # abs() handles negative numbers for digit logic.\n            int_part = int(num)\n            abs_int_part = abs(int_part)\n\n            # Extract the first decimal digit.\n            if abs_int_part == 0:\n                first_digit = 0\n            else:\n                temp_num = abs_int_part\n                while temp_num >= 10:\n                    temp_num //= 10\n                first_digit = temp_num\n\n            # Extract the last decimal digit.\n            last_digit = abs_int_part % 10\n\n            # Check if both extracted digits are odd.\n            is_first_digit_odd = first_digit % 2 == 1\n            is_last_digit_odd = last_digit % 2 == 1\n\n            if is_first_digit_odd and is_last_digit_odd:\n                count += 1\n    return count\n```"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Computes the number of index triples (i < j < k) such that a[i] + a[j] + a[k] is divisible by 3.\n    This uses combinatorics, exploiting the pattern of a[i] modulo 3.\n    \"\"\"\n\n    def _nCk(n_val, k_val):\n        \"\"\"Calculates the binomial coefficient (n choose k).\"\"\"\n        if k_val < 0 or k_val > n_val:\n            return 0\n        if k_val == 0 or k_val == n_val:\n            return 1\n        k_val = min(k_val, n_val - k_val)\n        num = 1\n        den = 1\n        for i in range(1, k_val + 1):\n            num *= n_val - (k_val - i)\n            den *= i\n        return num // den\n\n    # Determine a[i] % 3 behavior:\n    # a[i] = i*i - i + 1\n    # If i % 3 == 0, a[i] % 3 = (0*0 - 0 + 1) % 3 = 1\n    # If i % 3 == 1, a[i] % 3 = (1*1 - 1 + 1) % 3 = 1\n    # If i % 3 == 2, a[i] % 3 = (2*2 - 2 + 1) % 3 = (4 - 2 + 1) % 3 = 3 % 3 = 0\n\n    # Count indices whose corresponding a[i] values are 0 mod 3 or 1 mod 3.\n    # a[i] % 3 == 0 when i % 3 == 2.\n    # a[i] % 3 == 1 when i % 3 == 0 or i % 3 == 1.\n\n    q = n // 3\n    r = n % 3\n\n    # Count of indices i (1-based) where i % 3 == 2\n    # These indices are 2, 5, 8, ...\n    count_a_mod_0 = q + (1 if r >= 2 else 0)\n\n    # Count of indices i (1-based) where i % 3 == 0 or i % 3 == 1\n    # These are n - (count of i % 3 == 2)\n    count_a_mod_1 = n - count_a_mod_0\n\n    # A sum (a[i] + a[j] + a[k]) is divisible by 3 if:\n    # 1. All three terms are 0 mod 3 (0 + 0 + 0 = 0 mod 3)\n    # 2. All three terms are 1 mod 3 (1 + 1 + 1 = 3 = 0 mod 3)\n\n    # Number of triples where all three a[x] are 0 mod 3\n    triples_from_0_mod_3 = _nCk(count_a_mod_0, 3)\n\n    # Number of triples where all three a[x] are 1 mod 3\n    triples_from_1_mod_3 = _nCk(count_a_mod_1, 3)\n\n    return triples_from_0_mod_3 + triples_from_1_mod_3"}
{"task_id": "HumanEval/148", "solution": "PLANETS = [\n    \"Mercury\", \"Venus\", \"Earth\", \"Mars\",\n    \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n]\n\ndef bf(planet1, planet2):\n    \"\"\"\n    Returns planets located between two given planets in our solar system, ordered by proximity to the Sun.\n    Returns an empty tuple if planet names are invalid or no planets are between them.\n    \"\"\"\n    p1_norm = planet1.strip().title()\n    p2_norm = planet2.strip().title()\n\n    try:\n        idx1 = PLANETS.index(p1_norm)\n        idx2 = PLANETS.index(p2_norm)\n    except ValueError:\n        return ()\n\n    if idx1 == idx2:\n        return ()\n\n    start_idx = min(idx1, idx2)\n    end_idx = max(idx1, idx2)\n\n    return tuple(PLANETS[start_idx + 1 : end_idx])"}
