{"task_id": "HumanEval/45", "solution": "```python\n# src/triangle_area/__init__.py\n\"\"\"\nTriangle Area Calculator Library.\n\"\"\"\nfrom .models.triangle import triangle_area\n\n__all__ = [\"triangle_area\"]\n\n\n# src/triangle_area/config.py\nimport os\n\nclass Config:\n    \"\"\"Application configuration and defaults.\"\"\"\n    DEFAULT_DB = \"sqlite:///./triangle_calculations.db\"\n\n    def __init__(self, database_url: str | None = None, api_host: str = \"127.0.0.1\", api_port: int = 8000) -> None:\n        self.DATABASE_URL: str = database_url or os.getenv(\"DATABASE_URL\", self.DEFAULT_DB)\n        self.API_HOST: str = api_host\n        self.API_PORT: int = api_port\n\n    def get_database_url(self) -> str:\n        \"\"\"Returns the configured database URL.\"\"\"\n        return self.DATABASE_URL\n\n\n# src/triangle_area/exceptions.py\nclass InvalidDimensionError(Exception):\n    \"\"\"Raised when triangle dimensions (a or h) are invalid.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass PersistenceError(Exception):\n    \"\"\"Raised when a database operation fails.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\n\n# src/triangle_area/utils/__init__.py\n# Utils package initializer.\n\n\n# src/triangle_area/utils/logger.py\nimport logging\n\nclass AppLogger:\n    \"\"\"Configures application logging.\"\"\"\n    DEFAULT_LOG_LEVEL = \"INFO\"\n    _logger = None\n\n    @classmethod\n    def configure(cls, level: str = DEFAULT_LOG_LEVEL) -> None:\n        \"\"\"Sets up basic logging configuration.\"\"\"\n        if cls._logger is None:\n            logging.basicConfig(level=getattr(logging, level.upper(), logging.INFO),\n                                format='%(asctime)s - %(name)s - %(levelname)s - %(message)s')\n            cls._logger = logging.getLogger(\"triangle_area\")\n\n    @classmethod\n    def get_logger(cls, name: str) -> logging.Logger:\n        \"\"\"Retrieves a logger instance.\"\"\"\n        if cls._logger is None:\n            cls.configure()\n        return logging.getLogger(name)\n\n\n# src/triangle_area/models/__init__.py\n# Models package initializer.\n\n\n# src/triangle_area/models/triangle.py\nfrom typing import Optional\n\nclass Triangle:\n    \"\"\"Domain model representing a triangle with base 'a' and height 'h'.\"\"\"\n    def __init__(self, a: float, h: float) -> None:\n        self.a: float = float(a)\n        self.h: float = float(h)\n        self.area: Optional[float] = None\n\n    def compute_area(self) -> float:\n        \"\"\"Calculates and returns the area of the triangle.\"\"\"\n        self.area = 0.5 * self.a * self.h\n        return self.area\n\ndef triangle_area(a, h):\n    \"\"\"Given length of a side and high return area for a triangle.\n    >>> triangle_area(5, 3)\n    7.5\n    \"\"\"\n    t = Triangle(a, h)\n    return t.compute_area()\n\n\n# src/triangle_area/validators/__init__.py\n# Validators package initializer.\n\n\n# src/triangle_area/validators/validator.py\nfrom ..exceptions import InvalidDimensionError\n\nclass TriangleValidator:\n    \"\"\"Validates numeric inputs for triangle computations.\"\"\"\n    def __init__(self, min_value: float = 1e-7) -> None:\n        self.min_value = min_value\n\n    def validate(self, a: float, h: float) -> bool:\n        \"\"\"Checks if a and h are valid positive numbers.\"\"\"\n        try:\n            a_val = float(a)\n            h_val = float(h)\n        except (TypeError, ValueError):\n            raise InvalidDimensionError(\"Inputs 'a' and 'h' must be numbers.\")\n        if a_val <= self.min_value:\n            raise InvalidDimensionError(f\"Dimension 'a' must be greater than {self.min_value}.\")\n        if h_val <= self.min_value:\n            raise InvalidDimensionError(f\"Dimension 'h' must be greater than {self.min_value}.\")\n        return True\n\n\n# src/triangle_area/repositories/__init__.py\n# Repositories package initializer.\n\n\n# src/triangle_area/repositories/sqlite_repository.py\nfrom sqlalchemy import create_engine, Column, Integer, Float, String, DateTime, Table, MetaData\nfrom sqlalchemy.orm import sessionmaker\nfrom datetime import datetime, timezone\nfrom ..exceptions import PersistenceError\nfrom ..utils.logger import AppLogger\n\nlogger = AppLogger.get_logger(__name__)\n\nmetadata = MetaData()\ncalculations = Table(\n    \"calculations\",\n    metadata,\n    Column(\"id\", Integer, primary_key=True, autoincrement=True),\n    Column(\"a\", Float, nullable=False),\n    Column(\"h\", Float, nullable=False),\n    Column(\"area\", Float, nullable=False),\n    Column(\"method\", String(32), nullable=False),\n    Column(\"created_at\", DateTime, nullable=False),\n)\n\nclass CalculationRepository:\n    \"\"\"Persists and queries calculation records using SQLAlchemy.\"\"\"\n    def __init__(self, database_url: str) -> None:\n        self.engine = create_engine(database_url, connect_args={\"check_same_thread\": False})\n        self.SessionLocal = sessionmaker(autocommit=False, autoflush=False, bind=self.engine)\n        logger.info(f\"Initialized CalculationRepository with DB: {database_url}\")\n\n    def create_tables(self) -> None:\n        \"\"\"Creates database tables if they do not already exist.\"\"\"\n        try:\n            metadata.create_all(self.engine)\n            logger.info(\"Database tables created or already exist.\")\n        except Exception as e:\n            logger.error(f\"Error creating tables: {e}\")\n            raise PersistenceError(f\"Failed to create tables: {e}\")\n\n    def insert_record(self, a: float, h: float, area: float, method: str = \"library\") -> int:\n        \"\"\"Inserts a new calculation record into the database.\"\"\"\n        with self.SessionLocal() as session:\n            ins = calculations.insert().values(\n                a=a, h=h, area=area, method=method, created_at=datetime.now(timezone.utc)\n            )\n            try:\n                result = session.execute(ins)\n                session.commit()\n                record_id = int(result.inserted_primary_key[0])\n                logger.debug(f\"Record inserted with id: {record_id}\")\n                return record_id\n            except Exception as e:\n                session.rollback()\n                logger.error(f\"Failed to insert record: {e}\")\n                raise PersistenceError(f\"Failed to insert record: {e}\")\n\n    def get_record(self, record_id: int) -> dict | None:\n        \"\"\"Retrieves a single calculation record by its ID.\"\"\"\n        with self.SessionLocal() as session:\n            sel = calculations.select().where(calculations.c.id == record_id)\n            try:\n                result = session.execute(sel).fetchone()\n                if result:\n                    return {col.name: getattr(result, col.name) for col in calculations.columns}\n                return None\n            except Exception as e:\n                logger.error(f\"Failed to get record {record_id}: {e}\")\n                raise PersistenceError(f\"Failed to retrieve record: {e}\")\n\n    def list_recent(self, limit: int = 100) -> list[dict]:\n        \"\"\"Lists recent calculation records, ordered by creation time.\"\"\"\n        with self.SessionLocal() as session:\n            sel = calculations.select().order_by(calculations.c.created_at.desc()).limit(limit)\n            try:\n                results = session.execute(sel).fetchall()\n                return [{col.name: getattr(row, col.name) for col in calculations.columns} for row in results]\n            except Exception as e:\n                logger.error(f\"Failed to list recent records: {e}\")\n                raise PersistenceError(f\"Failed to list records: {e}\")\n\n\n# src/triangle_area/services/__init__.py\n# Services package initializer.\n\n\n# src/triangle_area/services/triangle_service.py\nfrom ..models.triangle import Triangle\nfrom ..validators.validator import TriangleValidator\nfrom ..exceptions import PersistenceError\nfrom ..utils.logger import AppLogger\n\nlogger = AppLogger.get_logger(__name__)\n\nclass TriangleService:\n    \"\"\"Orchestrates validation, computation, and optional persistence for triangles.\"\"\"\n    def __init__(self, validator: TriangleValidator, repository=None) -> None:\n        self.validator = validator\n        self.repository = repository\n        if self.repository:\n            self.repository.create_tables() # Ensure tables exist on service init\n\n    def calculate(self, a: float, h: float, persist: bool = False, method: str = \"library\") -> dict:\n        \"\"\"Calculates triangle area, optionally persisting the result.\"\"\"\n        self.validator.validate(a, h)\n        triangle = Triangle(a, h)\n        area = triangle.compute_area()\n        record_id = None\n        if persist and self.repository:\n            try:\n                record_id = self.repository.insert_record(a, h, area, method)\n                logger.info(f\"Calculated and persisted (id={record_id}): a={a}, h={h}, area={area}, method={method}\")\n            except Exception as exc:\n                logger.error(f\"Persistence failed for a={a}, h={h}: {exc}\")\n                raise PersistenceError(str(exc))\n        else:\n            logger.info(f\"Calculated: a={a}, h={h}, area={area}, persistence skipped.\")\n        return {\"area\": area, \"id\": record_id}\n\n    def get_calculation_history(self, limit: int = 100) -> list[dict]:\n        \"\"\"Retrieves a list of recent calculation records.\"\"\"\n        if not self.repository:\n            raise PersistenceError(\"Repository not configured for history access.\")\n        try:\n            return self.repository.list_recent(limit)\n        except Exception as exc:\n            logger.error(f\"Failed to retrieve history: {exc}\")\n            raise PersistenceError(f\"Failed to retrieve history: {exc}\")\n\n    def get_calculation_by_id(self, record_id: int) -> dict | None:\n        \"\"\"Retrieves a specific calculation record by its ID.\"\"\"\n        if not self.repository:\n            raise PersistenceError(\"Repository not configured for record access.\")\n        try:\n            return self.repository.get_record(record_id)\n        except Exception as exc:\n            logger.error(f\"Failed to retrieve record {record_id}: {exc}\")\n            raise PersistenceError(f\"Failed to retrieve record: {exc}\")\n\n\n# src/triangle_area/controllers/__init__.py\n# Controllers package initializer.\n\n\n# src/triangle_area/controllers/cli.py\nimport click\nfrom ..services.triangle_service import TriangleService\nfrom ..exceptions import InvalidDimensionError, PersistenceError\nfrom ..utils.logger import AppLogger\n\nlogger = AppLogger.get_logger(__name__)\n\nclass CLIController:\n    \"\"\"CLI entrypoint using click for triangle area computation.\"\"\"\n    def __init__(self, service: TriangleService) -> None:\n        self.service = service\n\n    def run(self, args=None) -> int:\n        \"\"\"Sets up and runs the click CLI command.\"\"\"\n        @click.group()\n        def main_group():\n            pass\n\n        @main_group.command(\"compute-triangle-area\")\n        @click.argument(\"a\", type=float)\n        @click.argument(\"h\", type=float)\n        @click.option(\"--save\", is_flag=True, default=False, help=\"Persist calculation to history.\")\n        def compute_triangle_area_cmd(a, h, save):\n            \"\"\"Computes the area of a triangle given side 'a' and height 'h'.\"\"\"\n            try:\n                result = self.service.calculate(a, h, persist=save, method=\"cli\")\n                click.echo(f\"Triangle Area: {result['area']}\")\n                if result.get(\"id\"):\n                    click.echo(f\"Calculation saved with ID: {result['id']}\")\n                return 0\n            except InvalidDimensionError as e:\n                click.echo(f\"Error: Invalid input: {e}\", err=True)\n                return 1\n            except PersistenceError as e:\n                click.echo(f\"Error: Persistence failed: {e}\", err=True)\n                return 1\n            except Exception as e:\n                logger.exception(\"An unexpected error occurred in CLI.\")\n                click.echo(f\"An unexpected error occurred: {e}\", err=True)\n                return 1\n\n        @main_group.command(\"list-history\")\n        @click.option(\"--limit\", type=int, default=10, help=\"Number of recent records to list.\")\n        def list_history_cmd(limit):\n            \"\"\"Lists recent triangle area calculations.\"\"\"\n            try:\n                history = self.service.get_calculation_history(limit)\n                if not history:\n                    click.echo(\"No calculation history found.\")\n                    return 0\n                for record in history:\n                    click.echo(f\"ID: {record['id']}, a: {record['a']}, h: {record['h']}, Area: {record['area']}, Method: {record['method']}, Time: {record['created_at']}\")\n                return 0\n            except PersistenceError as e:\n                click.echo(f\"Error: History access failed: {e}\", err=True)\n                return 1\n            except Exception as e:\n                logger.exception(\"An unexpected error occurred accessing history.\")\n                click.echo(f\"An unexpected error occurred: {e}\", err=True)\n                return 1\n\n        @main_group.command(\"get-record\")\n        @click.argument(\"record_id\", type=int)\n        def get_record_cmd(record_id):\n            \"\"\"Retrieves a specific calculation record by its ID.\"\"\"\n            try:\n                record = self.service.get_calculation_by_id(record_id)\n                if record:\n                    click.echo(f\"ID: {record['id']}, a: {record['a']}, h: {record['h']}, Area: {record['area']}, Method: {record['method']}, Time: {record['created_at']}\")\n                else:\n                    click.echo(f\"Record with ID {record_id} not found.\", err=True)\n                    return 1\n                return 0\n            except PersistenceError as e:\n                click.echo(f\"Error: Record access failed: {e}\", err=True)\n                return 1\n            except Exception as e:\n                logger.exception(f\"An unexpected error occurred getting record {record_id}.\")\n                click.echo(f\"An unexpected error occurred: {e}\", err=True)\n                return 1\n\n        try:\n            main_group.main(args=args, standalone_mode=False)\n            return 0\n        except SystemExit as e:\n            return e.code\n\n\n# src/triangle_area/controllers/api.py\nfrom fastapi import FastAPI, HTTPException, Depends, Query\nfrom pydantic import BaseModel, Field\nfrom typing import List, Optional\nfrom datetime import datetime\n\nfrom ..services.triangle_service import TriangleService\nfrom ..exceptions import InvalidDimensionError, PersistenceError\nfrom ..utils.logger import AppLogger\nfrom ..config import Config\nfrom ..validators.validator import TriangleValidator\nfrom ..repositories.sqlite_repository import CalculationRepository\n\nlogger = AppLogger.get_logger(__name__)\n\n# Pydantic models for request/response\nclass ComputeRequest(BaseModel):\n    \"\"\"Request body for triangle area computation.\"\"\"\n    a: float = Field(..., gt=0, description=\"Base length of the triangle.\")\n    h: float = Field(..., gt=0, description=\"Height of the triangle.\")\n    persist: bool = Field(True, description=\"Whether to save the calculation to history.\")\n\nclass ComputeResponse(BaseModel):\n    \"\"\"Response for triangle area computation.\"\"\"\n    area: float = Field(..., description=\"Computed area of the triangle.\")\n    id: Optional[int] = Field(None, description=\"ID of the persisted record, if saved.\")\n\nclass HistoryRecord(BaseModel):\n    \"\"\"Schema for a historical calculation record.\"\"\"\n    id: int\n    a: float\n    h: float\n    area: float\n    method: str\n    created_at: datetime\n\n# Dependency injection setup\ndef get_service() -> TriangleService:\n    \"\"\"Provides a TriangleService instance with configured dependencies.\"\"\"\n    cfg = Config()\n    validator = TriangleValidator()\n    repository = CalculationRepository(cfg.get_database_url())\n    return TriangleService(validator, repository)\n\nclass APIController:\n    \"\"\"FastAPI application exposing compute and history endpoints.\"\"\"\n    def __init__(self, service: TriangleService) -> None:\n        self.service = service\n        self.app = FastAPI(\n            title=\"Triangle Area Calculator API\",\n            description=\"API for computing triangle area and managing calculation history.\",\n            version=\"1.0.0\",\n        )\n        self._register_routes()\n\n    def _register_routes(self) -> None:\n        \"\"\"Registers all API endpoints.\"\"\"\n        @self.app.post(\"/triangle/area\", response_model=ComputeResponse, summary=\"Compute triangle area\")\n        async def compute(req: ComputeRequest, service: TriangleService = Depends(get_service)):\n            \"\"\"Calculates the area of a triangle given 'a' and 'h'.\"\"\"\n            try:\n                res = service.calculate(req.a, req.h, persist=req.persist, method=\"api\")\n                return res\n            except InvalidDimensionError as e:\n                logger.warning(f\"Bad Request: {e}\")\n                raise HTTPException(status_code=400, detail=str(e))\n            except PersistenceError as e:\n                logger.error(f\"Persistence error during compute: {e}\")\n                raise HTTPException(status_code=500, detail=\"Persistence failed during calculation.\")\n            except Exception as e:\n                logger.exception(\"An unexpected error occurred during /triangle/area POST.\")\n                raise HTTPException(status_code=500, detail=\"An unexpected error occurred.\")\n\n        @self.app.get(\"/triangle/history\", response_model=List[HistoryRecord], summary=\"Get calculation history\")\n        async def get_history(\n            limit: int = Query(10, ge=1, le=100, description=\"Number of recent records to retrieve.\"),\n            service: TriangleService = Depends(get_service)\n        ):\n            \"\"\"Retrieves a list of recent triangle area calculation records.\"\"\"\n            try:\n                history = service.get_calculation_history(limit)\n                return history\n            except PersistenceError as e:\n                logger.error(f\"Persistence error during history retrieval: {e}\")\n                raise HTTPException(status_code=500, detail=\"Failed to retrieve calculation history.\")\n            except Exception as e:\n                logger.exception(\"An unexpected error occurred during /triangle/history GET.\")\n                raise HTTPException(status_code=500, detail=\"An unexpected error occurred.\")\n\n        @self.app.get(\"/triangle/{record_id}\", response_model=HistoryRecord, summary=\"Get calculation by ID\")\n        async def get_record_by_id(\n            record_id: int = Field(..., gt=0, description=\"ID of the calculation record to retrieve.\"),\n            service: TriangleService = Depends(get_service)\n        ):\n            \"\"\"Retrieves a single calculation record by its unique ID.\"\"\"\n            try:\n                record = service.get_calculation_by_id(record_id)\n                if record:\n                    return record\n                raise HTTPException(status_code=404, detail=f\"Record with ID {record_id} not found.\")\n            except PersistenceError as e:\n                logger.error(f\"Persistence error during record {record_id} retrieval: {e}\")\n                raise HTTPException(status_code=500, detail=\"Failed to retrieve calculation record.\")\n            except HTTPException: # Re-raise 404\n                raise\n            except Exception as e:\n                logger.exception(f\"An unexpected error occurred during /triangle/{record_id} GET.\")\n                raise HTTPException(status_code=500, detail=\"An unexpected error occurred.\")\n\n    def get_app(self) -> FastAPI:\n        \"\"\"Returns the configured FastAPI application instance.\"\"\"\n        return self.app\n\n\n# src/triangle_area/scripts/start_api.py\nimport uvicorn\nfrom triangle_area.controllers.api import APIController, get_service\nfrom triangle_area.config import Config\nfrom triangle_area.utils.logger import AppLogger\n\ndef main() -> None:\n    \"\"\"Starts the Uvicorn server for the FastAPI application.\"\"\"\n    AppLogger.configure(level=\"INFO\")\n    logger = AppLogger.get_logger(__name__)\n\n    cfg = Config()\n    service = get_service() # Uses DI to get a configured service\n    api_controller = APIController(service)\n    app = api_controller.get_app()\n\n    logger.info(f\"Starting API server on {cfg.API_HOST}:{cfg.API_PORT}\")\n    uvicorn.run(app, host=cfg.API_HOST, port=cfg.API_PORT)\n\nif __name__ == \"__main__\":\n    main()\n\n\n# pyproject.toml\n[tool.poetry]\nname = \"triangle-area\"\nversion = \"0.1.0\"\ndescription = \"A Python library and service for computing triangle area.\"\nauthors = [\"Your Name <you@example.com>\"]\nreadme = \"README.md\"\npackages = [{include = \"triangle_area\", from = \"src\"}]\n\n[tool.poetry.dependencies]\npython = \">=3.9,<4.0\"\nfastapi = \"^0.111.0\"\nuvicorn = {extras = [\"standard\"], version = \"^0.30.1\"}\nsqlalchemy = \"^2.0.30\"\nclick = \"^8.1.7\"\npydantic = \"^2.7.1\"\n\n[tool.poetry.group.dev.dependencies]\npytest = \"^8.2.0\"\nflake8 = \"^7.0.0\"\nblack = \"^24.4.2\"\n\n[build-system]\nrequires = [\"poetry-core\"]\nbuild-backend = \"poetry.core.masonry.api\"\n\n[tool.poetry.scripts]\ntriangle-cli = \"triangle_area.cli:main_group\" # This would be `main_group` if @click.group() is used directly\ntriangle-api-start = \"triangle_area.scripts.start_api:main\"\n\n\n# requirements.txt\nfastapi==0.111.0\nuvicorn[standard]==0.30.1\nsqlalchemy==2.0.30\nclick==8.1.7\npydantic==2.7.1\n\n\n# README.md\n# Triangle Area Calculator\n\nThis project provides a Python library, a command-line interface (CLI), and an HTTP API for computing the area of a triangle given a base (a) and a height (h). It includes input validation and persistence of calculation history.\n\n## Installation\n\n```bash\n# Using poetry\npoetry install\n\n# Using pip\npip install -r requirements.txt\n```\n\n## Usage\n\n### Library\n\n```python\nfrom triangle_area import triangle_area\n\narea = triangle_area(5, 3)\nprint(f\"Area: {area}\")\n```\n\n### Command Line Interface (CLI)\n\nTo compute the area:\n```bash\npython -m triangle_area.controllers.cli compute-triangle-area 5 3\n```\n\nTo compute and save to history:\n```bash\npython -m triangle_area.controllers.cli compute-triangle-area 5 3 --save\n```\n\nTo view history:\n```bash\npython -m triangle_area.controllers.cli list-history --limit 5\n```\n\nTo get a specific record:\n```bash\npython -m triangle_area.controllers.cli get-record 1\n```\n\n### HTTP API\n\nTo start the API server:\n```bash\npython src/triangle_area/scripts/start_api.py\n```\n(By default, it runs on `http://127.0.0.1:8000`)\n\n**Compute Area (POST)**\n```bash\ncurl -X POST \"http://127.0.0.1:8000/triangle/area\" -H \"Content-Type: application/json\" -d '{\"a\": 10, \"h\": 4, \"persist\": true}'\n```\n\n**Get History (GET)**\n```bash\ncurl \"http://127.0.0.1:8000/triangle/history?limit=5\"\n```\n\n**Get Record by ID (GET)**\n```bash\ncurl \"http://127.0.0.1:8000/triangle/1\"\n```\n\n## Database\n\nBy default, an SQLite database `triangle_calculations.db` is created in the current directory. The database URL can be configured via the `DATABASE_URL` environment variable.\n\n\n# migrations/README.md\n## Database Migrations\n\nThis project uses SQLAlchemy for persistence