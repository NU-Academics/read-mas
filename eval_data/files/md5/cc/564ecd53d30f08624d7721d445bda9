{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    The sequence is defined as follows: if n is even, n = n/2; if n is odd, n = 3n+1.\n    \"\"\"\n    odd_numbers = set()\n    current_n = n\n    while True:\n        if current_n % 2 == 1:\n            odd_numbers.add(current_n)\n        if current_n == 1:\n            break\n        if current_n % 2 == 0:\n            current_n = current_n // 2\n        else:\n            current_n = 3 * current_n + 1\n    return sorted(list(odd_numbers))"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Computes odd numbers in the Collatz sequence for n, returning them sorted and unique.\n    The sequence always terminates at 1, which is included in the result if it's odd.\n    \"\"\"\n    odd_numbers_found = set()\n    current_n = n\n\n    # The problem description implies n is always positive.\n    # We first check if the initial n is odd.\n    if current_n % 2 == 1:\n        odd_numbers_found.add(current_n)\n\n    # Generate the Collatz sequence until 1 is reached.\n    while current_n != 1:\n        if current_n % 2 == 0:\n            current_n = current_n // 2\n        else:\n            current_n = 3 * current_n + 1\n        \n        # Add the current number to the set if it's odd.\n        if current_n % 2 == 1:\n            odd_numbers_found.add(current_n)\n            \n    # Ensure 1 is always in the set, as it is the final odd number in the sequence.\n    odd_numbers_found.add(1)\n\n    # Convert the set to a list and sort it in increasing order.\n    return sorted(list(odd_numbers_found))"}
{"task_id": "HumanEval/124", "solution": "import re\n\ndef valid_date(date):\n    \"\"\"This function validates a date string against format mm-dd-yyyy and per-month day limits.\n    It returns True for a valid date, False otherwise.\n    \"\"\"\n    if not date:\n        return False\n\n    match = re.match(r'^(\\d{2})-(\\d{2})-(\\d{4})$', date)\n    if not match:\n        return False\n\n    month_str, day_str, _ = match.groups()\n\n    month = int(month_str)\n    day = int(day_str)\n\n    if not (1 <= month <= 12):\n        return False\n\n    month_max_days = {\n        1: 31, 2: 29, 3: 31, 4: 30, 5: 31, 6: 30,\n        7: 31, 8: 31, 9: 30, 10: 31, 11: 30, 12: 31\n    }\n\n    allowed_max_day = month_max_days[month]\n\n    if not (1 <= day <= allowed_max_day):\n        return False\n\n    return True"}
{"task_id": "HumanEval/124", "solution": "import re\n\ndef valid_date(date):\n    \"\"\"\n    Validates a date string in mm-dd-yyyy format according to specific rules.\n    Returns True if valid, False otherwise.\n    \"\"\"\n    if not date or not date.strip():\n        return False\n\n    date_format_regex = r\"^\\d{2}-\\d{1,2}-\\d{4}$\"\n    if not re.match(date_format_regex, date):\n        return False\n\n    parts = date.split('-')\n    # Regex should ensure 3 parts, but for robustness\n    if len(parts) != 3:\n        return False\n\n    try:\n        month = int(parts[0])\n        day = int(parts[1])\n        year = int(parts[2])\n    except ValueError:\n        return False\n\n    if not (1 <= month <= 12):\n        return False\n\n    month_day_limits = {\n        1: 31, 2: 29, 3: 31, 4: 30, 5: 31, 6: 30,\n        7: 31, 8: 31, 9: 30, 10: 31, 11: 30, 12: 31\n    }\n\n    max_day = month_day_limits.get(month)\n    if max_day is None:\n        return False # Should not occur if month is already validated 1-12\n\n    if not (1 <= day <= max_day):\n        return False\n\n    return True"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    \"\"\"\n    Splits text based on a hierarchy: whitespace, then commas, otherwise counts odd-ordered lowercase letters.\n    The order for counting letters is a=0, b=1, ..., z=25.\n    \"\"\"\n    # Check for whitespace first (FR1)\n    has_whitespace = False\n    for char in txt:\n        if char.isspace():\n            has_whitespace = True\n            break\n    \n    if has_whitespace:\n        return txt.split()\n\n    # If no whitespace, check for commas (FR2)\n    if ',' in txt:\n        # Split by comma, strip tokens, and filter out empty strings\n        tokens = [t.strip() for t in txt.split(',')]\n        return [token for token in tokens if token != '']\n\n    # If no whitespace and no commas, count odd-ordered lowercase letters (FR3)\n    count = 0\n    base_ord_a = ord('a')\n    for char in txt:\n        if 'a' <= char <= 'z':  # Only consider lowercase letters 'a' through 'z'\n            if (ord(char) - base_ord_a) % 2 == 1:  # Check if alphabetical order is odd\n                count += 1\n    return count"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    '''Splits text by whitespace, then by commas if no whitespace. If neither, counts lowercase letters with odd alphabet order (a=0, b=1, etc.).'''\n    if txt == \"\":\n        return []\n\n    # Check for whitespace first\n    has_whitespace = False\n    for char in txt:\n        if char.isspace():\n            has_whitespace = True\n            break\n    \n    if has_whitespace:\n        return txt.split()\n\n    # If no whitespace, check for commas\n    if ',' in txt:\n        tokens = [t.strip() for t in txt.split(',')]\n        return [t for t in tokens if t != \"\"]\n\n    # If neither, count lowercase letters with odd alphabet order\n    count = 0\n    alpha_offset = ord('a')\n    for char in txt:\n        if 'a' <= char <= 'z':\n            if ((ord(char) - alpha_offset) % 2) == 1:\n                count += 1\n    return count"}
{"task_id": "HumanEval/126", "solution": "```python\ndef is_sorted(lst):\n    \"\"\"\n    Checks if a list of non-negative integers is sorted in ascending order\n    and if no value appears more than twice.\n    \"\"\"\n    # Check for non-decreasing order.\n    for i in range(1, len(lst)):\n        if lst[i] < lst[i - 1]:\n            return False\n\n    # Check for duplicate policy: no value may appear more than twice.\n    counts = {}\n    for num in lst:\n        counts[num] = counts.get(num, 0) + 1\n        if counts[num] > 2:\n            return False\n\n    return True\n```"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    \"\"\"\n    Given a list of numbers, return True if they are sorted non-decreasingly and no number appears more than twice.\n    Assumes non-negative integers.\n    \"\"\"\n    if not lst:\n        return True\n\n    last_val = None\n    consecutive_count = 0\n    max_duplicates_allowed = 2\n\n    for current_val in lst:\n        if last_val is not None and current_val < last_val:\n            return False\n\n        if current_val == last_val:\n            consecutive_count += 1\n            if consecutive_count > max_duplicates_allowed:\n                return False\n        else:\n            consecutive_count = 1\n\n        last_val = current_val\n\n    return True"}
{"task_id": "HumanEval/127", "solution": "```python\ndef intersection(interval1, interval2):\n    \"\"\"Determines if the length of the intersection of two closed integer intervals is a prime number.\n    Returns \"YES\" if prime, \"NO\" otherwise, or if intervals do not intersect.\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"Checks if a non-negative integer is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    # Calculate the intersection interval's start and end points\n    inter_start = max(start1, start2)\n    inter_end = min(end1, end2)\n\n    # If inter_start > inter_end, intervals do not intersect\n    if inter_start > inter_end:\n        return \"NO\"\n\n    # Calculate the length of the intersection\n    intersection_length = inter_end - inter_start\n\n    # Check if the intersection length is a prime number\n    return \"YES\" if is_prime(intersection_length) else \"NO\"\n```"}
{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"Determines if the length of the intersection of two closed integer intervals is a prime number.\n    Returns \"YES\" if the intersection length is prime, otherwise \"NO\".\n    \"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if a non-negative integer is a prime number.\"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    # Calculate the intersection points\n    intersection_start = max(start1, start2)\n    intersection_end = min(end1, end2)\n\n    # If intersection_start > intersection_end, the intervals do not intersect\n    if intersection_start > intersection_end:\n        return \"NO\"\n\n    # Calculate the length of the intersection\n    # As per problem, (2,3) has length 1, so length = end - start\n    length = intersection_end - intersection_start\n\n    # Check if the length is a prime number\n    if is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/128", "solution": "```python\ndef prod_signs(arr):\n    \"\"\"\n    You are given an array arr of integers and you need to return\n    sum of magnitudes of integers multiplied by product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    Note: return None for empty arr.\n    \"\"\"\n    if not arr:\n        return None\n\n    magnitude_sum = 0\n    for x in arr:\n        magnitude_sum += abs(x)\n\n    sign_product = 1\n    has_zero = False\n    for x in arr:\n        if x == 0:\n            has_zero = True\n            break\n\n    if has_zero:\n        sign_product = 0\n    else:\n        for x in arr:\n            if x < 0:\n                sign_product *= -1\n\n    return sign_product * magnitude_sum\n```"}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Computes the sum of magnitudes of integers multiplied by the product of their signs.\n    Returns None for an empty array.\n    \"\"\"\n\n    if not arr:\n        return None\n\n    def _sign_of(x):\n        if x > 0:\n            return 1\n        if x < 0:\n            return -1\n        return 0\n\n    sum_magnitudes_val = 0\n    product_of_signs_val = 1\n    \n    for x in arr:\n        sum_magnitudes_val += abs(x)\n        \n        sign = _sign_of(x)\n        if sign == 0:\n            return 0 \n        product_of_signs_val *= sign\n        \n    return sum_magnitudes_val * product_of_signs_val"}
{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Computes the lexicographically minimum path of length k on an N x N grid.\n    The path starts at the cell containing value 1 and iteratively chooses the minimum value neighbor.\n    \"\"\"\n    N = len(grid)\n\n    # 1. Find the starting position (value 1)\n    start_row, start_col = -1, -1\n    for r in range(N):\n        for c in range(N):\n            if grid[r][c] == 1:\n                start_row, start_col = r, c\n                break\n        if start_row != -1:\n            break\n\n    # Initialize the path with the starting value\n    path_values = [1]\n    current_pos = (start_row, start_col)\n\n    # 2. Iterate k-1 times to find subsequent path elements\n    for _ in range(1, k):\n        r, c = current_pos\n        \n        # Determine valid neighbors and their values\n        neighbors = []\n        for dr, dc in [(0, 1), (0, -1), (1, 0), (-1, 0)]:  # Right, Left, Down, Up\n            next_r, next_c = r + dr, c + dc\n            if 0 <= next_r < N and 0 <= next_c < N:\n                neighbors.append(((next_r, next_c), grid[next_r][next_c]))\n        \n        # Choose the neighbor with the minimum value\n        # It's guaranteed the answer is unique, so min() will work predictably.\n        chosen_neighbor_pos, chosen_neighbor_value = min(neighbors, key=lambda x: x[1])\n        \n        # Update current position and append value to path\n        current_pos = chosen_neighbor_pos\n        path_values.append(chosen_neighbor_value)\n\n    return path_values"}
{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Computes the lexicographically minimum path of length k on a square grid.\n    The path starts at value 1 and moves greedily to the smallest neighboring value.\n    \"\"\"\n    n = len(grid)\n\n    value_to_pos = {}\n    for r_idx in range(n):\n        for c_idx in range(n):\n            value_to_pos[grid[r_idx][c_idx]] = (r_idx, c_idx)\n\n    # The lexicographically minimum path always starts at the cell containing value 1.\n    start_r, start_c = value_to_pos[1]\n    \n    path_values = [1]\n    current_r, current_c = start_r, start_c\n\n    # Define directions for 4-neighbors (up, down, left, right)\n    DR = [-1, 1, 0, 0]\n    DC = [0, 0, -1, 1]\n\n    # Iterate k-1 times to find the remaining path elements\n    for _ in range(1, k):\n        neighbors = []\n        for i in range(4):\n            nr, nc = current_r + DR[i], current_c + DC[i]\n            # Check if the potential neighbor is within grid bounds\n            if 0 <= nr < n and 0 <= nc < n:\n                neighbors.append((nr, nc))\n        \n        # Select the neighbor with the minimum value to extend the path\n        min_neighbor_r, min_neighbor_c = min(neighbors, key=lambda pos: grid[pos[0]][pos[1]])\n        \n        current_r, current_c = min_neighbor_r, min_neighbor_c\n        path_values.append(grid[current_r][current_c])\n\n    return path_values"}
{"task_id": "HumanEval/130", "solution": "```python\ndef tri(n):\n    \"\"\"Computes the Tribonacci sequence up to index n.\n    Follows the rules: tri(0)=1, tri(1)=3, tri(even)=1+n/2, tri(odd)=tri(n-1)+tri(n-2)+tri(n+1).\n    \"\"\"\n    sequence = []\n\n    for i in range(n + 1):\n        if i == 0:\n            value = 1\n        elif i == 1:\n            value = 3\n        elif i % 2 == 0:\n            value = 1 + (i // 2)\n        else:\n            # For odd i, tri(i+1) is even, so its value is directly computable.\n            tri_i_plus_1 = 1 + ((i + 1) // 2)\n            value = sequence[i - 1] + sequence[i - 2] + tri_i_plus_1\n        sequence.append(value)\n\n    return sequence\n```"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n    product = 1\n    found_odd = False\n    for char_digit in str(n):\n        digit = int(char_digit)\n        if digit % 2 != 0:\n            product *= digit\n            found_odd = True\n    return product if found_odd else 0"}
{"task_id": "HumanEval/130", "solution": "import json\nimport sqlite3\nfrom collections import OrderedDict\nfrom datetime import datetime\nfrom typing import List, Optional, Dict, Any\n\nclass CacheAdapter:\n    \"\"\"In-memory LRU cache for sequences.\"\"\"\n    def __init__(self, max_size: int = 1024):\n        self.max_size = max_size\n        self._store: OrderedDict[int, List[int]] = OrderedDict()\n\n    def get(self, n: int) -> Optional[List[int]]:\n        if n in self._store:\n            seq = self._store.pop(n)\n            self._store[n] = seq\n            return seq\n        return None\n\n    def set(self, n: int, seq: List[int]) -> None:\n        if n in self._store:\n            self._store.pop(n)\n        self._store[n] = seq\n        if len(self._store) > self.max_size:\n            self._store.popitem(last=False)\n\n    def clear(self) -> None:\n        self._store.clear()\n\nclass SequenceRepository:\n    \"\"\"Persistence of computed sequences to SQLite.\"\"\"\n    CREATE_TABLE_SQL = \"\"\"\n        CREATE TABLE IF NOT EXISTS sequences (\n            n INTEGER PRIMARY KEY,\n            values TEXT NOT NULL,\n            computed_at TIMESTAMP NOT NULL\n        );\n        CREATE INDEX IF NOT EXISTS idx_sequences_n ON sequences(n);\n    \"\"\"\n    \n    def __init__(self, db_path: str = \"data/tribonacci.db\"):\n        self.db_path = db_path\n        import os\n        os.makedirs(os.path.dirname(self.db_path), exist_ok=True)\n        self._conn = sqlite3.connect(self.db_path)\n        self._conn.execute(self.CREATE_TABLE_SQL)\n        self._conn.commit()\n\n    def get(self, n: int) -> Optional[List[int]]:\n        cur = self._conn.cursor()\n        cur.execute(\"SELECT values FROM sequences WHERE n = ?\", (n,))\n        row = cur.fetchone()\n        if not row:\n            return None\n        return json.loads(row[0])\n\n    def save(self, n: int, seq: List[int]) -> None:\n        cur = self._conn.cursor()\n        try:\n            cur.execute(\n                \"INSERT OR REPLACE INTO sequences (n, values, computed_at) VALUES (?, ?, ?)\",\n                (n, json.dumps(seq), datetime.utcnow().isoformat()),\n            )\n            self._conn.commit()\n        except sqlite3.Error:\n            # Best-effort persistence: silently fail on DB error.\n            pass\n\n    def close(self) -> None:\n        self._conn.close()\n\n# Global instances for cache and repo to persist state across tri() calls.\n_repo = SequenceRepository()\n_cache = CacheAdapter()\n\n# Memoization dictionary for the current top-level computation.\n_memo: Dict[int, int] = {}\n\ndef _compute_value_internal(k: int) -> int:\n    \"\"\"Compute tri(k) recursively, using _memo for efficiency.\"\"\"\n    if k in _memo:\n        return _memo[k]\n\n    # Base cases for tri(0) and tri(1).\n    if k == 0:\n        val = 1\n    elif k == 1:\n        val = 3\n    elif k % 2 == 0:  # Even rule: tri(n) = 1 + n / 2\n        val = 1 + k // 2\n    else:  # Odd rule: tri(n) = tri(n - 1) + tri(n - 2) + tri(n + 1)\n        # Recursively compute tri(k+1) first to resolve the forward reference.\n        right = _compute_value_internal(k + 1)\n        left1 = _compute_value_internal(k - 1)\n        left2 = _compute_value_internal(k - 2)\n        val = left1 + left2 + right\n\n    _memo[k] = val\n    return val\n\ndef tri(n: int) -> List[int]:\n    \"\"\"\n    Computes the Tribonacci sequence up to n, returning a list of the first n+1 numbers.\n    The function utilizes an in-memory cache and SQLite persistence for speed.\n    \"\"\"\n    # Attempt to retrieve the sequence from the in-memory cache first.\n    cached_seq = _cache.get(n)\n    if cached_seq is not None:\n        return cached_seq\n\n    # If not in cache, try to load from the persistent repository.\n    repo_seq = _repo.get(n)\n    if repo_seq is not None:\n        _cache.set(n, repo_seq)  # Populate cache if found in repository.\n        return repo_seq\n\n    # If not found, compute the sequence from scratch using memoized recursion.\n    global _memo\n    _memo = {}  # Clear memoization for a fresh computation.\n    \n    for k in range(0, n + 1):\n        if k not in _memo:\n            _compute_value_internal(k)\n            \n    # Assemble the final sequence from the memoized values.\n    sequence = [_memo[i] for i in range(0, n + 1)]\n\n    # Save the newly computed sequence to the repository and cache for future requests.\n    _repo.save(n, sequence)\n    _cache.set(n, sequence)\n\n    return sequence"}
{"task_id": "HumanEval/131", "solution": "```python\ndef digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Returns 0 if all digits are even or if no odd digits are present.\n    \"\"\"\n    num_str = str(abs(n))\n    odd_digits_found = []\n    for char_digit in num_str:\n        digit = int(char_digit)\n        if digit % 2 == 1:  # Check if the digit is odd (zero is even).\n            odd_digits_found.append(digit)\n\n    if not odd_digits_found:\n        return 0\n\n    product_result = 1\n    for d in odd_digits_found:\n        product_result *= d\n    return product_result\n```"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    \"\"\"\n    Checks if there's a valid subsequence of brackets with at least one nested pair.\n    This function searches for the pattern \"[ [ ] ]\" as a subsequence within the input string.\n    \"\"\"\n    s = string\n    n = len(s)\n\n    # Quick check: a nested subsequence like '[[]]' requires at least 4 characters,\n    # with at least two opening and two closing brackets.\n    if n < 4 or s.count('[') < 2 or s.count(']') < 2:\n        return False\n\n    i = 0\n    while i < n:\n        if s[i] == '[':  # Found outer_open '['\n            j = i + 1\n            while j < n:\n                if s[j] == '[':  # Found inner_open '['\n                    k = j + 1\n                    while k < n and s[k] != ']':\n                        k += 1\n                    if k < n and s[k] == ']':  # Found inner_close ']'\n                        l = k + 1\n                        while l < n and s[l] != ']':\n                            l += 1\n                        if l < n and s[l] == ']':  # Found outer_close ']'\n                            return True  # Pattern \"[ [ ] ]\" found as subsequence\n                j += 1\n        i += 1\n    return False"}
{"task_id": "HumanEval/132", "solution": "To implement the software design specification, I will generate the complete file structure and code for each component as detailed.\n\n```\n.\n\u251c\u2500\u2500 src/\n\u2502   \u2514\u2500\u2500 brackets/\n\u2502       \u251c\u2500\u2500 __init__.py\n\u2502       \u251c\u2500\u2500 config.py\n\u2502       \u251c\u2500\u2500 exceptions.py\n\u2502       \u251c\u2500\u2500 models.py\n\u2502       \u251c\u2500\u2500 utils.py\n\u2502       \u251c\u2500\u2500 services.py\n\u2502       \u251c\u2500\u2500 controllers.py\n\u2502       \u251c\u2500\u2500 repositories.py\n\u2502       \u251c\u2500\u2500 adapters.py\n\u2502       \u2514\u2500\u2500 cli.py\n\u251c\u2500\u2500 tests/\n\u2502   \u251c\u2500\u2500 test_nested_detector.py\n\u2502   \u251c\u2500\u2500 test_controller.py\n\u2502   \u2514\u2500\u2500 conftest.py\n\u251c\u2500\u2500 pyproject.toml\n\u251c\u2500\u2500 README.md\n\u2514\u2500\u2500 LICENSE\n```\n\nHere is the content for each file:\n\n**`src/brackets/config.py`**\n```python\nclass AppConfig:\n    \"\"\"Centralizes constants and configuration values for the application.\"\"\"\n    MIN_PYTHON_VERSION: tuple[int, int] = (3, 8)\n    VALID_CHARS: str = \"[]\"\n    EXIT_CODE_SUCCESS: int = 0\n    EXIT_CODE_VALIDATION_ERROR: int = 2\n    # General error exit code for unexpected issues\n    EXIT_CODE_GENERIC_ERROR: int = 1\n```\n\n**`src/brackets/exceptions.py`**\n```python\nclass BracketError(Exception):\n    \"\"\"Base exception for bracket-related errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass ValidationError(BracketError):\n    \"\"\"Raised when input validation fails.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n```\n\n**`src/brackets/models.py`**\n```python\nclass BracketSequence:\n    \"\"\"Represents a bracket sequence string and provides accessors.\"\"\"\n    def __init__(self, raw: str) -> None:\n        self.raw: str = raw\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the raw string.\"\"\"\n        return len(self.raw)\n\n    def char_at(self, idx: int) -> str:\n        \"\"\"Returns the character at the specified index.\"\"\"\n        return self.raw[idx]\n```\n\n**`src/brackets/utils.py`**\n```python\nfrom .exceptions import ValidationError\n\nclass Validator:\n    \"\"\"Provides utility methods for validating input strings.\"\"\"\n    def validate_non_empty(self, s: str) -> None:\n        \"\"\"Raises ValidationError if the string is empty.\"\"\"\n        if not s:\n            raise ValidationError(\"Input string cannot be empty\")\n\n    def validate_characters(self, s: str, allowed: str) -> None:\n        \"\"\"Raises ValidationError if string contains characters not in allowed set.\"\"\"\n        if any(ch not in allowed for ch in s):\n            raise ValidationError(f\"Invalid characters; only {allowed} allowed\")\n```\n\n**`src/brackets/services.py`**\n```python\nfrom .models import BracketSequence\n\nclass NestedDetector:\n    \"\"\"Implements the core algorithm to detect nested bracket subsequences.\"\"\"\n    def is_nested(self, s: str) -> bool:\n        \"\"\"\n        Determines if there exists a valid subsequence with at least one nested bracket pair.\n        The algorithm greedily matches brackets and tracks the maximum nesting depth.\n        \"\"\"\n        seq = BracketSequence(s)\n        stack: list[int] = []  # Stores indices of unmatched opening brackets\n        max_depth = 0\n\n        for i in range(seq.length()):\n            ch = seq.char_at(i)\n            if ch == \"[\":\n                stack.append(i)\n            else:  # ch == ']'\n                if stack:\n                    stack.pop()  # Match current ']' with the last open '['\n                    # current_depth is the depth of the *just completed* pair\n                    # after popping, stack contains remaining open brackets.\n                    # len(stack) is the depth of the current context *before* the new pair,\n                    # so +1 gives the depth of the new pair.\n                    current_depth = len(stack) + 1\n                    if current_depth > max_depth:\n                        max_depth = current_depth\n                        if max_depth >= 2:\n                            return True  # Nested subsequence found early\n        return False  # No nested subsequence found after scanning\n```\n\n**`src/brackets/repositories.py`**\n```python\nclass InMemoryBracketRepository:\n    \"\"\"An in-memory repository for storing bracket check results.\"\"\"\n    def __init__(self) -> None:\n        self._store: list[dict] = []\n\n    def save(self, input_str: str, result: bool) -> None:\n        \"\"\"Saves an input string and its corresponding result.\"\"\"\n        self._store.append({\"input\": input_str, \"result\": result})\n\n    def all(self) -> list[dict]:\n        \"\"\"Returns all stored records.\"\"\"\n        return list(self._store)\n```\n\n**`src/brackets/adapters.py`**\n```python\nclass IOAdapter:\n    \"\"\"Provides basic file input/output operations.\"\"\"\n    def read_string_from_file(self, path: str) -> str:\n        \"\"\"Reads and returns the content of a file as a string.\"\"\"\n        with open(path, \"r\", encoding=\"utf8\") as f:\n            return f.read()\n\n    def write_result_to_file(self, path: str, result: bool) -> None:\n        \"\"\"Writes a boolean result to a file as its string representation.\"\"\"\n        with open(path, \"w\", encoding=\"utf8\") as f:\n            f.write(str(result))\n```\n\n**`src/brackets/controllers.py`**\n```python\nfrom .utils import Validator\nfrom .services import NestedDetector\nfrom .repositories import InMemoryBracketRepository\nfrom .config import AppConfig\n\nclass BracketsController:\n    \"\"\"Orchestrates input validation, bracket detection, and optional result storage.\"\"\"\n    def __init__(\n        self,\n        validator: Validator,\n        detector: NestedDetector,\n        repo: InMemoryBracketRepository | None = None\n    ) -> None:\n        self._validator = validator\n        self._detector = detector\n        self._repo = repo\n\n    def check_nested(self, s: str) -> bool:\n        \"\"\"\n        Validates the input string and determines if it contains a nested bracket subsequence.\n        Optionally saves the input and result to the repository.\n        \"\"\"\n        self._validator.validate_non_empty(s)\n        self._validator.validate_characters(s, AppConfig.VALID_CHARS)\n        result = self._detector.is_nested(s)\n        if self._repo:\n            self._repo.save(s, result)\n        return result\n```\n\n**`src/brackets/cli.py`**\n```python\nimport sys\nfrom .controllers import BracketsController\nfrom .utils import Validator\nfrom .services import NestedDetector\nfrom .repositories import InMemoryBracketRepository\nfrom .config import AppConfig\nfrom .exceptions import ValidationError\n\nclass CLIApp:\n    \"\"\"Command-line interface application for bracket string analysis.\"\"\"\n    def __init__(self, controller: BracketsController) -> None:\n        self._controller = controller\n\n    def run(self, argv: list[str]) -> int:\n        \"\"\"\n        Parses command-line arguments, invokes the controller, and prints the result.\n        Handles validation errors and returns appropriate exit codes.\n        \"\"\"\n        if len(argv) != 2:\n            print(f\"Usage: {argv[0]} \\\"<bracket_string>\\\"\", file=sys.stderr)\n            return AppConfig.EXIT_CODE_GENERIC_ERROR\n        s = argv[1]\n        try:\n            result = self._controller.check_nested(s)\n            print(str(result))\n            return AppConfig.EXIT_CODE_SUCCESS\n        except ValidationError as e:\n            print(f\"Validation error: {e.message}\", file=sys.stderr)\n            return AppConfig.EXIT_CODE_VALIDATION_ERROR\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return AppConfig.EXIT_CODE_GENERIC_ERROR\n\ndef main() -> None:\n    \"\"\"Entry point for the command-line interface.\"\"\"\n    validator = Validator()\n    detector = NestedDetector()\n    # For CLI, repository is optional; passing it for demonstration.\n    repository = InMemoryBracketRepository() \n    controller = BracketsController(validator=validator, detector=detector, repo=repository)\n    app = CLIApp(controller=controller)\n    sys.exit(app.run(sys.argv))\n\n```\n\n**`src/brackets/__init__.py`**\n```python\nfrom .controllers import BracketsController\nfrom .services import NestedDetector\nfrom .utils import Validator\nfrom .exceptions import BracketError, ValidationError # Expose exceptions for library users\n\n# Initialize dependencies for the public API function\n_validator_instance = Validator()\n_detector_instance = NestedDetector()\n# The public API (is_nested) does not use the repository by default.\n_controller_instance = BracketsController(validator=_validator_instance, detector=_detector_instance, repo=None)\n\ndef is_nested(s: str) -> bool:\n    \"\"\"\n    Determines if a string of square brackets contains a valid subsequence\n    with at least one nested bracket pair.\n\n    This is the main programmatic API for the brackets package.\n    \"\"\"\n    return _controller_instance.check_nested(s)\n```\n\n**`tests/conftest.py`**\n```python\nimport pytest\n# No specific fixtures needed for current tests, but file is present.\n```\n\n**`tests/test_nested_detector.py`**\n```python\nimport pytest\nfrom brackets.services import NestedDetector\n\n@pytest.mark.parametrize(\"s,expected\", [\n    (\"[[]]\", True),\n    (\"[]]]]]]][[[[[]\", False), # Multiple non-nested pairs, then open brackets\n    (\"[][]\", False), # Adjacent non-nested pairs\n    (\"[]\", False), # Single non-nested pair\n    (\"[[][]]\", True), # Nested pair with an adjacent non-nested pair inside\n    (\"[[]][[\", True), # Nested pair followed by unmatched open brackets\n    (\"[[[[]]]]\", True), # Multiple levels of nesting\n    (\"((()))\", False), # Invalid characters (though controller validates this)\n    (\"\", False), # Empty string (though controller validates this)\n    (\"][\", False), # Mismatched, no valid subsequence\n    (\"[\", False), # Unmatched open\n    (\"]\", False), # Unmatched close\n    (\"]]][[[\", False), # Mismatched, no valid subsequence\n    (\"[][[]]\", True), # Non-nested, then nested\n    (\"[[[]]]\", True), # Simple nested\n])\ndef test_nested_detector_examples(s, expected):\n    \"\"\"Tests the NestedDetector with various bracket sequences.\"\"\"\n    det = NestedDetector()\n    assert det.is_nested(s) is expected\n\n```\n\n**`tests/test_controller.py`**\n```python\nimport pytest\nfrom brackets.controllers import BracketsController\nfrom brackets.utils import Validator\nfrom brackets.services import NestedDetector\nfrom brackets.repositories import InMemoryBracketRepository\nfrom brackets.exceptions import ValidationError\nfrom brackets.config import AppConfig\n\ndef test_controller_saves_result_to_repo():\n    \"\"\"Verifies that the controller saves results to the repository if provided.\"\"\"\n    repo = InMemoryBracketRepository()\n    ctrl = BracketsController(Validator(), NestedDetector(), repo)\n    \n    test_str = \"[[]]\"\n    res = ctrl.check_nested(test_str)\n    \n    assert res is True\n    assert len(repo.all()) == 1\n    assert repo.all()[0][\"input\"] == test_str\n    assert repo.all()[0][\"result\"] is True\n\n    test_str_2 = \"[][]\"\n    res_2 = ctrl.check_nested(test_str_2)\n    \n    assert res_2 is False\n    assert len(repo.all()) == 2\n    assert repo.all()[1][\"input\"] == test_str_2\n    assert repo.all()[1][\"result\"] is False\n\n\ndef test_controller_raises_for_empty_string():\n    \"\"\"Ensures the controller raises ValidationError for empty input.\"\"\"\n    ctrl = BracketsController(Validator(), NestedDetector(), None)\n    with pytest.raises(ValidationError, match=\"Input string cannot be empty\"):\n        ctrl.check_nested(\"\")\n\ndef test_controller_raises_for_invalid_characters():\n    \"\"\"Ensures the controller raises ValidationError for invalid characters.\"\"\"\n    ctrl = BracketsController(Validator(), NestedDetector(), None)\n    with pytest.raises(ValidationError, match=f\"Invalid characters; only {AppConfig.VALID_CHARS} allowed\"):\n        ctrl.check_nested(\"abc\")\n    with pytest.raises(ValidationError, match=f\"Invalid characters; only {AppConfig.VALID_CHARS} allowed\"):\n        ctrl.check_nested(\"[a]\")\n\ndef test_controller_delegates_to_detector():\n    \"\"\"Confirms the controller correctly delegates detection logic.\"\"\"\n    ctrl = BracketsController(Validator(), NestedDetector(), None)\n    assert ctrl.check_nested(\"[[]]\") is True\n    assert ctrl.check_nested(\"[][]\") is False\n\n```\n\n**`pyproject.toml`**\n```toml\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[project]\nname = \"brackets\"\nversion = \"0.1.0\"\ndescription = \"Determines if a string contains a valid nested bracket subsequence.\"\nreadme = \"README.md\"\nauthors = [{name = \"Auto Design\", email = \"dev@example.com\"}]\nlicense = {file = \"LICENSE\"}\nclassifiers = [\n    \"Programming Language :: Python :: 3\",\n    \"License :: OSI Approved :: MIT License\",\n    \"Operating System :: OS Independent\",\n    \"Intended Audience :: Developers\",\n    \"Topic :: Software Development :: Libraries :: Python Modules\",\n    \"Topic :: Utilities\",\n]\nrequires-python = \">=3.8\"\ndependencies = []\n\n[project.scripts]\nbrackets-check = \"brackets.cli:main\"\n\n[project.urls]\nHomepage = \"https://github.com/example/brackets\" # Placeholder\nRepository = \"https://github.com/example/brackets\" # Placeholder\n\n[tool.setuptools.packages.find]\nwhere = [\"src\"]\n\n[tool.pytest.ini_options]\nminversion = \"6.0\"\naddopts = \"-q\"\ntestpaths = [\"tests\"]\n```\n\n**`README.md`**\n```markdown\n# Brackets Nested Subsequence Detector\n\nA Python package and CLI tool to determine if a given string of square brackets contains a valid subsequence of brackets where at least one bracket in the subsequence is nested.\n\n## Features\n\n- **Programmatic API**: A simple function `brackets.is_nested(string: str)` for integration into other Python applications.\n- **Command-Line Interface (CLI)**: `brackets-check \"<string>\"` to quickly test bracket sequences.\n- **Robust Validation**: Ensures input strings contain only `[` and `]` characters and are not empty.\n- **Efficient Algorithm**: O(N) time complexity for detection.\n- **Modular Design**: Code organized into layers (Controller, Service, Utils, etc.) for testability and future extensions.\n\n## Installation\n\nThis project can be installed using `pip` after cloning the repository:\n\n```bash\ngit clone https://github.com/example/brackets.git # Placeholder\ncd brackets\npip install .\n```\n\nAlternatively, if you're developing, you can install in editable mode:\n\n```bash\npip install -e .\n```\n\n## Usage\n\n### Command-Line Interface (CLI)\n\nRun the `brackets-check` command followed by your bracket string enclosed in quotes:\n\n```bash\nbrackets-check \"[[]]\"\n# Output: True\n\nbrackets-check \"[]]]]]]][[[[[]\"\n# Output: False\n\nbrackets-check \"[][]\"\n# Output: False\n\nbrackets-check \"[[][]]\"\n# Output: True\n\nbrackets-check \"\"\n# Output: Validation error: Input string cannot be empty\n# Exit Code: 2\n\nbrackets-check \"[a]\"\n# Output: Validation error: Invalid characters; only [] allowed\n# Exit Code: 2\n```\n\n### Programmatic API\n\nYou can import the `is_nested` function into your Python code:\n\n```python\nfrom brackets import is_nested, ValidationError\n\n# Valid nested examples\nprint(is_nested(\"[[]]\"))      # Output: True\nprint(is_nested(\"[[][]]\"))   # Output: True\nprint(is_nested(\"[[]][[\"))   # Output: True\n\n# Valid non-nested examples\nprint(is_nested(\"[]\"))        # Output: False\nprint(is_nested(\"[][]\"))      # Output: False\nprint(is_nested(\"][\"))        # Output: False\n\n# Error handling\ntry:\n    is_nested(\"\")\nexcept ValidationError as e:\n    print(f\"Error: {e.message}\") # Output: Error: Input string cannot be empty\n\ntry:\n    is_nested(\"[a]\")\nexcept ValidationError as e:\n    print(f\"Error: {e.message}\") # Output: Error: Invalid characters; only [] allowed\n```\n\n## Development\n\n### Running Tests\n\nUnit tests are included and can be run using `pytest`:\n\n```bash\npytest\n```\n\n## License\n\nThis project is licensed under the MIT License - see the `LICENSE` file for details.\n```\n\n**`LICENSE`**\n```\nMIT License\n\nCopyright (c) 2023 Auto Design\n\nPermission is hereby granted, free of charge, to any person obtaining a copy\nof this software and associated documentation files (the \"Software\"), to deal\nin the Software without restriction, including without limitation the rights\nto use, copy, modify, merge, publish, distribute, sublicense, and/or sell\ncopies of the Software, and to permit persons to whom the Software is\nfurnished to do so, subject to the following conditions:\n\nThe above copyright notice and this permission notice shall be included in all\ncopies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\nIMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\nFITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\nAUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\nLIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\nOUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\nSOFTWARE.\n```"}
{"task_id": "HumanEval/133", "solution": "```python\nimport math\n\ndef sum_squares(lst):\n    \"\"\"You are given a list of numbers.\n    You need to return the sum of squared numbers in the given list,\n    round each element in the list to the upper int(Ceiling) first.\n    \"\"\"\n    total = 0\n    for num in lst:\n        ceiling_num = int(math.ceil(num))\n        total += ceiling_num * ceiling_num\n    return total\n```"}
{"task_id": "HumanEval/133", "solution": "```python\ndef sum_squares(lst):\n    \"\"\"\n    Computes the sum of squares of numbers in a list,\n    after rounding each element up to the nearest integer (ceiling).\n    \"\"\"\n\n    def _ceil_int(n: float) -> int:\n        \"\"\"Helper to round a number up to the nearest integer, mimicking math.ceil.\"\"\"\n        if n == int(n):\n            return int(n)\n        return int(n) + 1 if n > 0 else int(n)\n\n    def _square_int(n: int) -> int:\n        \"\"\"Helper to compute the square of an integer.\"\"\"\n        return n * n\n\n    total = 0\n    for num in lst:\n        ceiled_num = _ceil_int(num)\n        total += _square_int(ceiled_num)\n    return total\n```"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Returns True if the last character of a string is an alphabetical character\n    that is not part of a word, and False otherwise.\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if last_char.isspace():\n        return False\n\n    if not last_char.isalpha():\n        return False\n\n    if len(txt) == 1:\n        return True\n    else:\n        prev_char = txt[-2]\n        if not prev_char.isspace():\n            return False\n        else:\n            return True"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"Create a function which returns the largest index of an element which\n    is not greater than or equal to the element immediately preceding it. If\n    no such element exists then return -1.\n    \"\"\"\n    # Scan from right to left to find the first (largest) index i where arr[i] < arr[i-1].\n    for i in range(len(arr) - 1, 0, -1):\n        if arr[i] < arr[i - 1]:\n            return i\n    return -1"}
{"task_id": "HumanEval/135", "solution": "```python\ndef can_arrange(arr):\n    \"\"\"Create a function which returns the largest index of an element which\n    is not greater than or equal to the element immediately preceding it. If\n    no such element exists then return -1.\n    \"\"\"\n    if not arr or len(arr) == 1:\n        return -1\n\n    largest_index = -1\n    for i in range(1, len(arr)):\n        if arr[i] < arr[i - 1]:\n            largest_index = i\n    return largest_index\n```"}
{"task_id": "HumanEval/134", "solution": "```python\ndef check_if_last_char_is_a_letter(txt):\n    '''\n    Create a function that returns True if the last character\n    of a given string is an alphabetical character and is not\n    a part of a word, and False otherwise.\n    Note: \"word\" is a group of characters separated by space.\n    '''\n    # Handle empty string directly.\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    # If the last character is whitespace, it is not a standalone letter.\n    if last_char.isspace():\n        return False\n\n    # If the last character is not alphabetical, it is not a standalone letter.\n    if not last_char.isalpha():\n        return False\n\n    # Tokenize the string. str.split() separates by any whitespace and removes empty tokens.\n    tokens = txt.split()\n\n    # If no tokens are found after splitting (e.g., input was solely whitespace), return False.\n    if not tokens:\n        return False\n\n    last_token = tokens[-1]\n\n    # The last character is a standalone letter if its corresponding token has length 1.\n    return len(last_token) == 1\n```"}
{"task_id": "HumanEval/136", "solution": "from typing import Iterable, Optional, Tuple\n\ndef largest_smallest_integers(lst: Iterable[int]) -> Tuple[Optional[int], Optional[int]]:\n    \"\"\"\n    Returns a tuple (largest_negative, smallest_positive) from a list of integers.\n    Zeros are ignored; None is returned for missing categories.\n    \"\"\"\n    largest_negative = None\n    smallest_positive = None\n\n    for x in lst:\n        if x < 0:\n            if largest_negative is None or x > largest_negative:\n                largest_negative = x\n        elif x > 0:\n            if smallest_positive is None or x < smallest_positive:\n                smallest_positive = x\n\n    return (largest_negative, smallest_positive)"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    '''\n    Finds the largest negative integer and the smallest positive integer in a list.\n    Returns (largest_negative, smallest_positive) or (None, None) if not found.\n    '''\n    largest_neg = None\n    smallest_pos = None\n\n    for x in lst:\n        if x < 0:\n            if largest_neg is None or x > largest_neg:\n                largest_neg = x\n        elif x > 0:\n            if smallest_pos is None or x < smallest_pos:\n                smallest_pos = x\n    return (largest_neg, smallest_pos)"}
{"task_id": "HumanEval/137", "solution": "def compare_one(a, b):\n    \"\"\"\n    Compares two values (integers, floats, or numeric strings) and returns the larger argument\n    in its original type, or None if the values are numerically equal, handling ',' as a decimal.\n    \"\"\"\n\n    # Converts a value to its numeric float representation and returns the original value.\n    # Handles string normalization for ',' decimal separators.\n    def _parse_value_to_numeric_and_original(val):\n        if isinstance(val, (int, float)):\n            return float(val), val\n        elif isinstance(val, str):\n            s = val.strip()\n            # Normalize comma to dot for consistent float conversion.\n            normalized_s = s.replace(',', '.')\n            # Trusting caller's inputs, assume this conversion will succeed.\n            numeric_val = float(normalized_s)\n            return numeric_val, val\n        # Per CRITICAL REQUIREMENTS, avoid explicit error handling for unsupported types.\n        # Python will naturally raise an error if an unsupported type attempts .strip() or float().\n        return None, None \n\n    # Convert both arguments to their numeric representation for comparison and keep originals.\n    numeric_a, original_a = _parse_value_to_numeric_and_original(a)\n    numeric_b, original_b = _parse_value_to_numeric_and_original(b)\n\n    # Compare the numeric values and return the larger original value or None if equal.\n    if numeric_a > numeric_b:\n        return original_a\n    elif numeric_b > numeric_a:\n        return original_b\n    else:  # Numeric values are equal.\n        return None"}
{"task_id": "HumanEval/137", "solution": "```python\nimport decimal\n\n# Configure Decimal context once at the module level as per design\ndecimal.getcontext().prec = 28\n\ndef compare_one(a, b):\n    \"\"\"\n    Compares two numbers (int, float, or string) and returns the larger in its original type.\n    Returns None if the values are numerically equal.\n    \"\"\"\n\n    def _parse_to_decimal(value):\n        \"\"\"\n        Parses an input value (int, float, or string) into a Decimal for comparison.\n        It handles ',' as a decimal separator for strings and converts floats via string.\n        \"\"\"\n        if isinstance(value, str):\n            # Normalize string by replacing comma with dot for Decimal conversion.\n            # Assumes string is well-formed as per \"trust the caller's inputs\" rule.\n            s_normalized = value.strip().replace(',', '.')\n            return decimal.Decimal(s_normalized)\n        elif isinstance(value, float):\n            # Convert float to string first to maintain precision when converting to Decimal.\n            return decimal.Decimal(str(value))\n        else: # For int or other types directly parsable by Decimal\n            return decimal.Decimal(value)\n\n    # Convert both inputs to Decimal for accurate numerical comparison\n    decimal_a = _parse_to_decimal(a)\n    decimal_b = _parse_to_decimal(b)\n\n    # Perform the comparison and return the original value of the larger variable\n    if decimal_a > decimal_b:\n        return a\n    elif decimal_b > decimal_a:\n        return b\n    else:\n        # If values are numerically equal, return None\n        return None\n\n```"}
