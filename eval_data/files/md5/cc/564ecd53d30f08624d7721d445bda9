{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    start = min(a, b)\n    end = max(a, b)\n\n    if start % 2 != 0:\n        start += 1\n    \n    if start > end:\n        return []\n    \n    return list(range(start, end + 1, 2))"}
{"task_id": "HumanEval/163", "solution": "```python\ndef generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    # Normalize the input range to ensure 'low' is less than or equal to 'high'.\n    low, high = min(a, b), max(a, b)\n\n    # The set of single-digit even integers to consider.\n    even_single_digits = [2, 4, 6, 8]\n\n    # Filter for digits that fall within the specified inclusive range.\n    result = [digit for digit in even_single_digits if low <= digit <= high]\n\n    return result\n```"}
{"task_id": "HumanEval/148", "solution": "```python\n_CANONICAL_PLANETS = (\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\")\n_PLANET_MAP = {planet.strip().lower(): planet for planet in _CANONICAL_PLANETS}\n\ndef _get_normalized_name(name: str) -> str:\n    \"\"\"Normalizes a planet name for lookup by stripping whitespace and converting to lowercase.\"\"\"\n    return name.strip().lower()\n\ndef bf(planet1, planet2):\n    \"\"\"\n    Returns a tuple of planets whose orbits lie between the two given planets,\n    ordered by proximity to the Sun, or an empty tuple if names are invalid or no planets are between.\n    \"\"\"\n    normalized_p1 = _get_normalized_name(planet1)\n    normalized_p2 = _get_normalized_name(planet2)\n\n    if normalized_p1 not in _PLANET_MAP or normalized_p2 not in _PLANET_MAP:\n        return ()\n\n    # Retrieve canonical names for indexing, ensuring proper casing for _CANONICAL_PLANETS\n    canonical_p1 = _PLANET_MAP[normalized_p1]\n    canonical_p2 = _PLANET_MAP[normalized_p2]\n\n    idx1 = _CANONICAL_PLANETS.index(canonical_p1)\n    idx2 = _CANONICAL_PLANETS.index(canonical_p2)\n\n    if abs(idx1 - idx2) <= 1:\n        return ()\n\n    start_idx = min(idx1, idx2)\n    end_idx = max(idx1, idx2)\n\n    return _CANONICAL_PLANETS[start_idx + 1:end_idx]\n```"}
{"task_id": "HumanEval/149", "solution": "```python\ndef sorted_list_sum(lst):\n    \"\"\"Filters out strings with odd lengths from a list.\n    Returns the result sorted ascending by length, then alphabetically for ties.\"\"\"\n    even_length_strings = [s for s in lst if len(s) % 2 == 0]\n    sorted_result = sorted(even_length_strings, key=lambda s: (len(s), s))\n    return sorted_result\n```"}
{"task_id": "HumanEval/147", "solution": "```python\ndef get_max_triples(n):\n    \"\"\"\n    Computes ordered index-triples (i < j < k) whose sum a[i] + a[j] + a[k] is divisible by 3.\n    a[x] = x*x - x + 1, with residues a[x]%3 == 0 iff x%3 == 2, else a[x]%3 == 1.\n    \"\"\"\n\n    def _comb3(k: int) -> int:\n        \"\"\"Calculates combinations C(k, 3), returning 0 if k < 3.\"\"\"\n        if k < 3:\n            return 0\n        return (k * (k - 1) * (k - 2)) // 6\n\n    def _count_i_mod3(n_val: int, residue: int) -> int:\n        \"\"\"Counts numbers i in [1..n_val] such that i % 3 == residue.\"\"\"\n        base = n_val // 3\n        rem = n_val % 3\n        if residue == 1:\n            return base + (1 if rem >= 1 else 0)\n        if residue == 2:\n            return base + (1 if rem >= 2 else 0)\n        return base # residue == 0 (for 1-based index)\n\n    # c0_count: Number of elements a[i] such that a[i] % 3 == 0.\n    # This happens when i % 3 == 2.\n    c0_count = _count_i_mod3(n, 2)\n\n    # c1_count: Number of elements a[i] such that a[i] % 3 == 1.\n    # This happens when i % 3 == 0 or i % 3 == 1.\n    c1_count = n - c0_count\n\n    # The total number of triples is C(c0_count, 3) + C(c1_count, 3).\n    # Triples must consist of either three a[i]%3 == 0 elements OR three a[i]%3 == 1 elements.\n    return _comb3(c0_count) + _comb3(c1_count)\n```"}
