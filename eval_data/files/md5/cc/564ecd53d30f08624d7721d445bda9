\nuvicorn calculator.api:app --reload\n```\n\nThen send a POST request:\n```bash\ncurl -X POST -H \"Content-Type: application/json\" -d '{\"x\": 5, \"y\": 7}' http://127.0.0.1:8000/add\n# Output: {\"result\":12,\"id\":1,\"timestamp\":\"2023-10-27T10:00:00.123456Z\"}\n```\n\n## Development\n\nRun tests:\n```bash\npoetry run pytest --cov=src/calculator\n```\n\n## Project Structure\n\nRefer to the `src/calculator` directory for the core logic, CLI, and API implementations.\n```\n\n```text\n.github/workflows/ci.yml\n```yaml\nname: CI/CD\n\non:\n  push:\n    branches:\n      - main\n  pull_request:\n    branches:\n      - main\n\njobs:\n  build:\n    runs-on: ubuntu-latest\n    strategy:\n      matrix:\n        python-version: [\"3.8\", \"3.9\", \"3.10\", \"3.11\", \"3.12\"]\n\n    steps:\n      - uses: actions/checkout@v4\n      - name: Set up Python ${{ matrix.python-version }}\n        uses: actions/setup-python@v5\n        with:\n          python-version: ${{ matrix.python-version }}\n      - name: Install Poetry\n        run: pip install poetry\n      - name: Install dependencies\n        run: poetry install --no-root\n      - name: Run tests\n        run: poetry run pytest --cov=src/calculator --doctest-modules src/calculator/\n      - name: Report coverage\n        run: poetry run pytest --cov=src/calculator --cov-report=xml\n      - name: Upload coverage to Codecov\n        uses: codecov/codecov-action@v4\n        with:\n          token: ${{ secrets.CODECOV_TOKEN }}\n          files: ./coverage.xml\n          flags: unittests\n          name: codecov-umbrella\n          fail_ci_if_error: true\n```\n\n```text\nsrc/calculator/__init__.py\n```python\n\"\"\"\nAdd two numbers x and y.\n>>> from calculator import add\n>>> add(2, 3)\n5\n>>> add(5, 7)\n12\n\"\"\"\nfrom .config import get_db_path\nfrom .repository import MathRepository\nfrom .service import CalculatorService\n\n__all__ = [\"add\"]\n\ndef add(x: int, y: int) -> int:\n    \"\"\"Delegates to CalculatorService to add numbers and persist the operation.\"\"\"\n    repo = MathRepository(get_db_path())\n    svc = CalculatorService(repo)\n    op = svc.add(x, y)\n    return op.result\n```\n\n```text\nsrc/calculator/config.py\n```python\nimport os\n\nDB_PATH: str = os.getenv(\"CALC_DB_PATH\", \"data/calculator.db\")\nAPI_HOST: str = os.getenv(\"CALC_API_HOST\", \"127.0.0.1\")\nAPI_PORT: int = int(os.getenv(\"CALC_API_PORT\", \"8000\"))\n\ndef get_db_path() -> str:\n    \"\"\"Returns the configured database file path.\"\"\"\n    return DB_PATH\n```\n\n```text\nsrc/calculator/exceptions.py\n```python\nclass ValidationError(Exception):\n    \"\"\"Exception for invalid input data.\"\"\"\n    pass\n\nclass RepositoryError(Exception):\n    \"\"\"Exception for database or persistence errors.\"\"\"\n    pass\n```\n\n```text\nsrc/calculator/models.py\n```python\nfrom dataclasses import dataclass\nfrom datetime import datetime\nfrom typing import Optional, Dict, Any\nimport sqlite3\n\n@dataclass\nclass Operation:\n    \"\"\"Data Transfer Object for an arithmetic operation.\"\"\"\n    id: Optional[int]\n    x: int\n    y: int\n    result: int\n    timestamp: str # Stored as ISO8601 string\n    op_type: str = \"add\"\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Converts the Operation object to a serializable dictionary.\"\"\"\n        return {\n            \"id\": self.id,\n            \"x\": self.x,\n            \"y\": self.y,\n            \"result\": self.result,\n            \"timestamp\": self.timestamp,\n            \"op_type\": self.op_type,\n        }\n\n    @staticmethod\n    def from_row(row: sqlite3.Row) -> 'Operation':\n        \"\"\"Constructs an Operation object from a SQLite database row.\"\"\"\n        return Operation(\n            id=row[\"id\"],\n            x=row[\"x\"],\n            y=row[\"y\"],\n            result=row[\"result\"],\n            timestamp=row[\"timestamp\"],\n            op_type=row[\"op_type\"]\n        )\n```\n\n```text\nsrc/calculator/validator.py\n```python\nfrom typing import Any\nfrom .exceptions import ValidationError\n\nclass MathValidator:\n    \"\"\"Validates operands for mathematical operations.\"\"\"\n    \n    def validate_operands(self, x: Any, y: Any) -> None:\n        \"\"\"Ensures that both operands are integers.\"\"\"\n        if not isinstance(x, int) or not isinstance(y, int):\n            raise ValidationError(\"Operands must be integers.\")\n```\n\n```text\nsrc/calculator/repository.py\n```python\nimport sqlite3\nimport os\nfrom typing import List\nfrom importlib.resources import files\nimport calculator.migrations\n\nfrom .models import Operation\nfrom .exceptions import RepositoryError\n\nclass MathRepository:\n    \"\"\"Handles persistence for Operation objects in an SQLite database.\"\"\"\n    def __init__(self, db_path: str):\n        self.db_path = db_path\n        self.conn: sqlite3.Connection = None # Initialized by _connect()\n        self.init_db()\n\n    def _connect(self) -> sqlite3.Connection:\n        \"\"\"Establishes and returns an SQLite database connection.\"\"\"\n        if self.conn is None:\n            # Ensure the directory for the DB file exists\n            os.makedirs(os.path.dirname(self.db_path), exist_ok=True)\n            self.conn = sqlite3.connect(self.db_path, check_same_thread=False)\n            self.conn.row_factory = sqlite3.Row\n        return self.conn\n\n    def init_db(self) -> None:\n        \"\"\"Initializes the database schema by executing the migration script.\"\"\"\n        try:\n            sql_resource = files(calculator.migrations).joinpath(\"init.sql\")\n            with sql_resource.open(\"r\") as f:\n                self._connect().executescript(f.read())\n            self._connect().commit()\n        except Exception as e:\n            raise RepositoryError(f\"Failed to initialize database: {e}\")\n\n    def save_operation(self, op: Operation) -> int:\n        \"\"\"Inserts an Operation record into the database and returns its new ID.\"\"\"\n        try:\n            conn = self._connect()\n            cursor = conn.execute(\n                \"INSERT INTO operations (x,y,result,timestamp,op_type) VALUES (?,?,?,?,?)\",\n                (op.x, op.y, op.result, op.timestamp, op.op_type),\n            )\n            conn.commit()\n            return cursor.lastrowid\n        except sqlite3.Error as e:\n            raise RepositoryError(f\"Error saving operation: {e}\")\n\n    def get_history(self, limit: int = 100) -> List[Operation]:\n        \"\"\"Retrieves a list of recent operations from the database.\"\"\"\n        try:\n            conn = self._connect()\n            cursor = conn.execute(\n                \"SELECT id, x, y, result, timestamp, op_type FROM operations ORDER BY timestamp DESC LIMIT ?\",\n                (limit,)\n            )\n            return [Operation.from_row(row) for row in cursor.fetchall()]\n        except sqlite3.Error as e:\n            raise RepositoryError(f\"Error retrieving history: {e}\")\n```\n\n```text\nsrc/calculator/service.py\n```python\nfrom .models import Operation\nfrom .validator import MathValidator\nfrom .repository import MathRepository\nfrom .exceptions import ValidationError, RepositoryError\nfrom .utils import now_iso\n\nclass CalculatorService:\n    \"\"\"Encapsulates business logic for calculator operations.\"\"\"\n    def __init__(self, repository: MathRepository, validator: MathValidator = None):\n        self.repository = repository\n        self.validator = validator or MathValidator()\n\n    def add(self, x: int, y: int) -> Operation:\n        \"\"\"Performs addition, validates inputs, and persists the operation.\"\"\"\n        self.validator.validate_operands(x, y)\n        result = x + y\n        op = Operation(id=None, x=x, y=y, result=result, timestamp=now_iso())\n        try:\n            op_id = self.repository.save_operation(op)\n            op.id = op_id\n            return op\n        except Exception as exc: # Catch RepositoryError explicitly if preferred, but general Exception is okay here for re-raising.\n            raise RepositoryError(f\"Persistence failed for add operation: {exc}\")\n```\n\n```text\nsrc/calculator/cli.py\n```python\nimport argparse\nimport sys\nfrom typing import List\n\nfrom .config import get_db_path\nfrom .repository import MathRepository\nfrom .service import CalculatorService\nfrom .exceptions import ValidationError, RepositoryError\n\nclass CLIController:\n    \"\"\"Manages the command-line interface for the calculator.\"\"\"\n    def __init__(self, service: CalculatorService):\n        self.service = service\n        self.parser = self._setup_parser()\n\n    def _setup_parser(self) -> argparse.ArgumentParser:\n        \"\"\"Configures the argument parser for CLI commands.\"\"\"\n        parser = argparse.ArgumentParser(description=\"Calculator CLI tool.\")\n        subparsers = parser.add_subparsers(dest=\"command\", help=\"Available commands\")\n\n        # Add command\n        add_parser = subparsers.add_parser(\"add\", help=\"Add two integers.\")\n        add_parser.add_argument(\"--x\", type=int, required=True, help=\"First integer operand.\")\n        add_parser.add_argument(\"--y\", type=int, required=True, help=\"Second integer operand.\")\n        return parser\n\n    def run(self, argv: List[str]) -> int:\n        \"\"\"Parses arguments and executes the corresponding calculator command.\"\"\"\n        args = self.parser.parse_args(argv)\n\n        if args.command == \"add\":\n            try:\n                op = self.service.add(args.x, args.y)\n                print(op.result)\n                return 0\n            except ValidationError as e:\n                print(f\"Error: {e}\", file=sys.stderr)\n                return 2 # Non-zero exit code for validation errors\n            except RepositoryError as e:\n                print(f\"Database Error: {e}\", file=sys.stderr)\n                return 3 # Non-zero exit code for repository errors\n            except Exception as e:\n                print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n                return 1 # Generic error\n        else:\n            self.parser.print_help()\n            return 1\n\ndef main() -> None:\n    \"\"\"Entry point for the CLI application.\"\"\"\n    repo = MathRepository(get_db_path())\n    svc = CalculatorService(repo)\n    controller = CLIController(svc)\n    sys.exit(controller.run(sys.argv[1:]))\n\nif __name__ == \"__main__\":\n    main()\n```\n\n```text\nsrc/calculator/api.py\n```python\nfrom fastapi import FastAPI, HTTPException\nfrom pydantic import BaseModel\nfrom typing import Optional\n\nfrom .service import CalculatorService\nfrom .repository import MathRepository\nfrom .config import get_db_path\nfrom .exceptions import ValidationError, RepositoryError\n\n# Initialize service and repository globally for the FastAPI app.\n# This ensures a single instance is used across requests.\nrepository_instance = MathRepository(get_db_path())\ncalculator_service_instance = CalculatorService(repository_instance)\n\napp = FastAPI(title=\"Calculator API\", description=\"Provides basic arithmetic operations.\")\n\nclass AddRequest(BaseModel):\n    \"\"\"Pydantic model for the /add request body.\"\"\"\n    x: int\n    y: int\n\nclass AddResponse(BaseModel):\n    \"\"\"Pydantic model for the /add response body.\"\"\"\n    result: int\n    id: int\n    timestamp: str\n    op_type: str = \"add\"\n\n@app.post(\"/add\", response_model=AddResponse, status_code=200)\ndef post_add(req: AddRequest):\n    \"\"\"Handles POST requests to /add, performing addition and persisting the operation.\"\"\"\n    try:\n        op = calculator_service_instance.add(req.x, req.y)\n        return AddResponse(result=op.result, id=op.id, timestamp=op.timestamp, op_type=op.op_type)\n    except ValidationError as ve:\n        raise HTTPException(status_code=400, detail=str(ve))\n    except RepositoryError as re:\n        raise HTTPException(status_code=500, detail=f\"Database error: {re}\")\n    except Exception as e:\n        raise HTTPException(status_code=500, detail=f\"An unexpected error occurred: {e}\")\n\n# Optional: Add a root endpoint for health check or info\n@app.get(\"/\")\ndef read_root():\n    return {\"message\": \"Calculator API is running. Use /add for calculations.\"}\n```\n\n```text\nsrc/calculator/utils.py\n```python\nfrom datetime import datetime\n\ndef now_iso() -> str:\n    \"\"\"Returns the current UTC time as an ISO 8601 string with 'Z' for UTC.\"\"\"\n    return datetime.utcnow().isoformat(timespec='microseconds') + \"Z\"\n```\n\n```text\nsrc/calculator/migrations/init.sql\n```sql\nCREATE TABLE IF NOT EXISTS operations (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    x INTEGER NOT NULL,\n    y INTEGER NOT NULL,\n    result INTEGER NOT NULL,\n    timestamp TEXT NOT NULL,\n    op_type TEXT NOT NULL\n);\n\nCREATE INDEX IF NOT EXISTS idx_operations_timestamp ON operations(timestamp DESC);\n```\n\n```text\ndata/README\n```\nThis directory is the default location for the SQLite database file (calculator.db).\nThe database file will be created automatically on the first run of the CLI or API,\nif CALC_DB_PATH environment variable is not set.\n```\n\n```text\ntests/test_math_ops.py\n```python\nimport pytest\nimport doctest\nfrom calculator import add\nfrom calculator import __init__ as calculator_init # To run doctests in __init__.py\n\ndef test_doctest_examples():\n    \"\"\"Runs doctests defined in the calculator package's __init__ file.\"\"\"\n    # Test `add` function doctests\n    # For a real project, this might be combined with `pytest --doctest-modules`\n    # or specific doctest collection.\n    failures, _ = doctest.testmod(calculator_init)\n    assert failures == 0, f\"{failures} doctest failures\"\n\ndef test_add_returns_sum(mocker):\n    \"\"\"Verifies the core add function returns the correct sum.\"\"\"\n    # Mocking the repository and service to isolate the __init__.py's add function's direct behavior\n    # This ensures that the test only covers the delegation and return value,\n    # not the side effects (persistence) or deeper logic (validation).\n    mock_operation = mocker.Mock()\n    mock_operation.result = 5\n    mock_service = mocker.Mock()\n    mock_service.add.return_value = mock_operation\n    mocker.patch('calculator.service.CalculatorService', return_value=mock_service)\n    mocker.patch('calculator.repository.MathRepository')\n\n    assert add(2, 3) == 5\n    mock_service.add.assert_called_once_with(2, 3)\n\n    mock_operation.result = 0\n    mock_service.add.return_value = mock_operation\n    assert add(-1, 1) == 0\n    mock_service.add.assert_called_once_with(-1, 1) # This will fail if called twice due to once. Should reset mock.\n    # For strict checking:\n    mock_service.add.reset_mock()\n    mock_operation.result = 0\n    mock_service.add.return_value = mock_operation\n    assert add(-1, 1) == 0\n    mock_service.add.assert_called_once_with(-1, 1)\n\ndef test_add_positive_numbers(mocker):\n    \"\"\"Tests addition with two positive integers.\"\"\"\n    mock_operation = mocker.Mock()\n    mock_operation.result = 15\n    mock_service = mocker.Mock()\n    mock_service.add.return_value = mock_operation\n    mocker.patch('calculator.service.CalculatorService', return_value=mock_service)\n    mocker.patch('calculator.repository.MathRepository')\n    assert add(7, 8) == 15\n\ndef test_add_negative_numbers(mocker):\n    \"\"\"Tests addition with two negative integers.\"\"\"\n    mock_operation = mocker.Mock()\n    mock_operation.result = -10\n    mock_service = mocker.Mock()\n    mock_service.add.return_value = mock_operation\n    mocker.patch('calculator.service.CalculatorService', return_value=mock_service)\n    mocker.patch('calculator.repository.MathRepository')\n    assert add(-4, -6) == -10\n\ndef test_add_zero(mocker):\n    \"\"\"Tests addition involving zero.\"\"\"\n    mock_operation = mocker.Mock()\n    mock_operation.result = 5\n    mock_service = mocker.Mock()\n    mock_service.add.return_value = mock_operation\n    mocker.patch('calculator.service.CalculatorService', return_value=mock_service)\n    mocker.patch('calculator.repository.MathRepository')\n    assert add(5, 0) == 5\n```\n\n```text\ntests/test_service.py\n```python\nimport pytest\nfrom unittest.mock import Mock, patch\nfrom datetime import datetime\n\nfrom calculator.service import CalculatorService\nfrom calculator.repository import MathRepository\nfrom calculator.validator import MathValidator\nfrom calculator.models import Operation\nfrom calculator.exceptions import ValidationError, RepositoryError\n\n# Mock MathRepository for CalculatorService unit tests\n@pytest.fixture\ndef mock_repository():\n    \"\"\"Provides a mock MathRepository instance.\"\"\"\n    return Mock(spec=MathRepository)\n\n# Mock MathValidator for CalculatorService unit tests\n@pytest.fixture\ndef mock_validator():\n    \"\"\"Provides a mock MathValidator instance.\"\"\"\n    return Mock(spec=MathValidator)\n\n@pytest.fixture\ndef calculator_service(mock_repository, mock_validator):\n    \"\"\"Provides a CalculatorService instance with mocked dependencies.\"\"\"\n    return CalculatorService(repository=mock_repository, validator=mock_validator)\n\ndef test_add_success(calculator_service, mock_repository, mock_validator):\n    \"\"\"Tests successful addition operation, ensuring validation and persistence calls.\"\"\"\n    x, y = 10, 5\n    expected_result = x + y\n    mock_repository.save_operation.return_value = 1 # Simulate DB assigning an ID\n    \n    with patch('calculator.utils.now_iso', return_value=\"2023-01-01T12:00:00Z\"):\n        operation = calculator_service.add(x, y)\n\n    mock_validator.validate_operands.assert_called_once_with(x, y)\n    mock_repository.save_operation.assert_called_once()\n    saved_op = mock_repository.save_operation.call_args[0][0]\n    assert saved_op.x == x\n    assert saved_op.y == y\n    assert saved_op.result == expected_result\n    assert saved_op.timestamp == \"2023-01-01T12:00:00Z\"\n    assert saved_op.op_type == \"add\"\n    assert operation.id == 1\n    assert operation.result == expected_result\n\ndef test_add_validation_error(calculator_service, mock_validator):\n    \"\"\"Tests that a ValidationError from the validator is propagated.\"\"\"\n    mock_validator.validate_operands.side_effect = ValidationError(\"Invalid input\")\n    with pytest.raises(ValidationError, match=\"Invalid input\"):\n        calculator_service.add(10, \"invalid\")\n\ndef test_add_repository_error(calculator_service, mock_repository, mock_validator):\n    \"\"\"Tests that a RepositoryError from persistence is propagated.\"\"\"\n    mock_repository.save_operation.side_effect = Exception(\"DB connection lost\")\n    with pytest.raises(RepositoryError, match=\"DB connection lost\"):\n        calculator_service.add(10, 5)\n\ndef test_validator_accepts_integers():\n    \"\"\"Tests MathValidator correctly accepts integer inputs.\"\"\"\n    validator = MathValidator()\n    try:\n        validator.validate_operands(1, 2)\n    except ValidationError:\n        pytest.fail(\"ValidationError raised for valid integers.\")\n\ndef test_validator_rejects_non_integers():\n    \"\"\"Tests MathValidator correctly rejects non-integer inputs.\"\"\"\n    validator = MathValidator()\n    with pytest.raises(ValidationError, match=\"Operands must be integers.\"):\n        validator.validate_operands(1.0, 2)\n    with pytest.raises(ValidationError, match=\"Operands must be integers.\"):\n        validator.validate_operands(\"1\", 2)\n    with pytest.raises(ValidationError, match=\"Operands must be integers.\"):\n        validator.validate_operands(1, None)\n```\n\n```text\ntests/test_api.py\n```python\nimport pytest\nfrom fastapi.testclient import TestClient\nfrom unittest.mock import Mock, patch\n\n# Import the FastAPI app and Pydantic models from the calculator.api module\nfrom calculator.api import app, AddRequest, AddResponse\nfrom calculator.service import CalculatorService\nfrom calculator.repository import MathRepository\nfrom calculator.exceptions import ValidationError, RepositoryError\nfrom calculator.models import Operation\n\n# Create a TestClient instance for the FastAPI app\nclient = TestClient(app)\n\n# Fixture to mock the CalculatorService\n@pytest.fixture\ndef mock_calculator_service():\n    \"\"\"Provides a mock CalculatorService for API tests.\"\"\"\n    with patch('calculator.api.calculator_service_instance', autospec=True) as mock_svc:\n        yield mock_svc\n\ndef test_post_add_success(mock_calculator_service):\n    \"\"\"Tests successful POST /add request with valid integer inputs.\"\"\"\n    x, y = 5, 7\n    expected_result = x + y\n    op_id = 123\n    timestamp = \"2023-10-27T12:34:56.789012Z\"\n    \n    # Configure the mock service to return a successful Operation\n    mock_op = Operation(id=op_id, x=x, y=y, result=expected_result, timestamp=timestamp)\n    mock_calculator_service.add.return_value = mock_op\n\n    response = client.post(\"/add\", json={\"x\": x, \"y\": y})\n\n    assert response.status_code == 200\n    response_data = response.json()\n    assert response_data[\"result\"] == expected_result\n    assert response_data[\"id\"] == op_id\n    assert response_data[\"timestamp\"] == timestamp\n    assert response_data[\"op_type\"] == \"add\"\n    mock_calculator_service.add.assert_called_once_with(x, y)\n\ndef test_post_add_validation_error(mock_calculator_service):\n    \"\"\"Tests POST /add with invalid input type, expecting a 400 Bad Request.\"\"\"\n    # Simulate a ValidationError from the service layer\n    mock_calculator_service.add.side_effect = ValidationError(\"Operands must be integers.\")\n\n    response = client.post(\"/add\", json={\"x\": 5, \"y\": \"invalid\"})\n\n    assert response.status_code == 400\n    assert response.json()[\"detail\"] == \"Operands must be integers.\"\n    mock_calculator_s