{"task_id": "HumanEval/23", "solution": "```python\n# src/strutils/exceptions.py\n\nclass StrutilsError(Exception):\n    \"\"\"Base exception for strutils library errors.\"\"\"\n    pass\n\n\nclass InvalidStringError(StrutilsError):\n    \"\"\"Raised when the core strlen function receives an invalid string type.\"\"\"\n    pass\n\n\nclass ValidationError(StrutilsError):\n    \"\"\"Raised when validation logic fails (e.g., in Validator or DTOs).\"\"\"\n    pass\n\n```\n```python\n# src/strutils/__about__.py\n__version__ = \"0.1.0\"\n\n```\n```python\n# src/strutils/utils.py\nfrom typing import Any, List\n\n# CLI usage string for CLIController\nCLI_USAGE = \"Usage: strutils strlen \\\"<string>\\\"\"\n\ndef safe_str(value: Any) -> str:\n    \"\"\"\n    Converts a value to its string representation.\n    Handles bytes by attempting UTF-8 decode, falling back to repr.\n    \"\"\"\n    if isinstance(value, bytes):\n        try:\n            return value.decode(\"utf-8\")\n        except UnicodeDecodeError:\n            return repr(value)  # Fallback to default string representation for un-decodable bytes\n    return str(value)\n\n```\n```python\n# src/strutils/core.py\nfrom .exceptions import InvalidStringError\n\ndef strlen(string: str) -> int:\n    \"\"\"\n    Return length of given string (number of Python Unicode code points).\n    Raises InvalidStringError if input is not str.\n    \"\"\"\n    if not isinstance(string, str):\n        raise InvalidStringError(f\"Expected str, got {type(string).__name__}\")\n    return len(string)\n\n```\n```python\n# src/strutils/validation.py\nfrom typing import Any\nfrom .exceptions import ValidationError\n\nclass StringDTO:\n    \"\"\"\n    Data Transfer Object for string input.\n    \"\"\"\n    def __init__(self, s: str) -> None:\n        if not isinstance(s, str):\n            raise TypeError(\"StringDTO 's' attribute must be a string.\")\n        self.s = s\n\n    @classmethod\n    def from_json(cls, obj: dict) -> \"StringDTO\":\n        \"\"\"\n        Builds a StringDTO from a JSON-like dictionary.\n        Raises ValidationError if 's' key is missing or not a string.\n        \"\"\"\n        if not isinstance(obj, dict):\n            raise ValidationError(\"Input for from_json must be a dictionary.\")\n        if \"s\" not in obj:\n            raise ValidationError(\"Missing 's' in payload.\")\n        if not isinstance(obj[\"s\"], str):\n            raise ValidationError(f\"Expected 's' to be string, got {type(obj['s']).__name__}.\")\n        return cls(obj[\"s\"])\n\n\nclass Validator:\n    \"\"\"\n    Provides string validation helpers.\n    \"\"\"\n    def validate_string(self, s: Any) -> str:\n        \"\"\"\n        Ensures input `s` is a valid string for processing.\n        Handles None, bytes (decodes UTF-8), and non-str types.\n        \"\"\"\n        if s is None:\n            raise ValidationError(\"String input must not be None.\")\n        if isinstance(s, bytes):\n            try:\n                s = s.decode(\"utf-8\")\n            except UnicodeDecodeError as e:\n                raise ValidationError(\"Bytes input must be valid UTF-8.\") from e\n        if not isinstance(s, str):\n            raise ValidationError(f\"Expected str or bytes, got {type(s).__name__}.\")\n        return s\n\n```\n```python\n# src/strutils/services.py\nfrom .validation import Validator, StringDTO\nfrom .core import strlen\nfrom .exceptions import ValidationError, InvalidStringError\n\nclass StringService:\n    \"\"\"\n    Business service for string operations, coordinating validation and core logic.\n    \"\"\"\n    def __init__(self, validator: Validator) -> None:\n        self._validator = validator\n\n    def length(self, s: Any) -> int:\n        \"\"\"\n        Validates the input string and returns its length.\n        Raises ValidationError for invalid string inputs.\n        \"\"\"\n        # Validator handles None, bytes, and non-str inputs\n        valid_string = self._validator.validate_string(s)\n        # core.strlen strictly expects str, which is guaranteed by validator\n        return strlen(valid_string)\n\n    def length_from_dto(self, dto: StringDTO) -> int:\n        \"\"\"\n        Accepts a StringDTO and returns the length of its string.\n        \"\"\"\n        return self.length(dto.s)\n\n```\n```python\n# src/strutils/cli.py\nimport sys\nfrom typing import List, Optional\n\nfrom .validation import Validator\nfrom .services import StringService\nfrom .exceptions import StrutilsError\nfrom .utils import CLI_USAGE # Import the USAGE string\n\nclass CLIController:\n    \"\"\"\n    Handles command-line interface interactions for string utilities.\n    \"\"\"\n    def __init__(self, service: StringService) -> None:\n        self._service = service\n\n    def run(self, argv: List[str]) -> int:\n        \"\"\"\n        Executes the CLI command based on provided arguments.\n        Returns 0 for success, non-zero for errors.\n        \"\"\"\n        if not argv:\n            print(CLI_USAGE, file=sys.stderr)\n            return 2\n\n        command = argv[0]\n        if command != \"strlen\":\n            print(f\"Error: Unknown command '{command}'.\", file=sys.stderr)\n            print(CLI_USAGE, file=sys.stderr)\n            return 2\n\n        if len(argv) < 2:\n            print(f\"Error: Missing string argument for '{command}'.\", file=sys.stderr)\n            print(CLI_USAGE, file=sys.stderr)\n            return 2\n        \n        input_string = argv[1]\n\n        try:\n            length = self._service.length(input_string)\n            print(length)\n            return 0\n        except StrutilsError as e:\n            print(f\"Error: {e}\", file=sys.stderr)\n            return 2\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1\n\ndef main(argv: Optional[List[str]] = None) -> int:\n    \"\"\"\n    Main entry point for the CLI application.\n    \"\"\"\n    if argv is None:\n        # sys.argv[0] is the script name, sys.argv[1:] are the actual arguments\n        argv = sys.argv[1:]\n\n    # The design specifies `strutils strlen \"<string>\"`, so the first arg\n    # after the script name is 'strlen', and the second is the string.\n    # We want argv for CLIController.run to start with 'strlen',\n    # so we pass sys.argv[1:] to CLIController.run if main is called directly\n    # or if it's called via console_scripts (where `sys.argv[0]` is 'strutils',\n    # and `sys.argv[1]` is 'strlen', `sys.argv[2]` is the string).\n    #\n    # So if main is called as `strutils strlen \"foo\"`:\n    # `sys.argv` will be ['/path/to/strutils', 'strlen', 'foo']\n    # `argv` will be ['strlen', 'foo']\n    # CLIController.run expects ['strlen', 'foo'] for argv[0] and argv[1].\n    \n    validator = Validator()\n    service = StringService(validator)\n    controller = CLIController(service)\n    return controller.run(argv)\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n\n```\n```python\n# src/strutils/http_adapter.py\nfrom typing import Optional, Dict, Any\nfrom .services import StringService\nfrom .validation import Validator, StringDTO\nfrom .exceptions import ValidationError\nfrom .__about__ import __version__\n\n# Conditional import for FastAPI and its dependencies\ntry:\n    from fastapi import FastAPI, HTTPException, status\n    from fastapi.responses import JSONResponse\n    from pydantic import BaseModel\n    FASTAPI_AVAILABLE = True\nexcept ImportError:\n    # Define placeholder types if FastAPI is not available\n    # This allows the module to be imported even without the extra installed\n    class FastAPI:\n        def __init__(self, *args: Any, **kwargs: Any) -> None:\n            pass\n        def post(self, *args: Any, **kwargs: Any) -> Any:\n            return lambda func: func\n    class HTTPException(Exception):\n        def __init__(self, status_code: int, detail: str) -> None:\n            self.status_code = status_code\n            self.detail = detail\n            super().__init__(detail)\n    class BaseModel:\n        pass\n    class JSONResponse:\n        def __init__(self, status_code: int, content: Dict[str, Any]) -> None:\n            pass\n    status = object() # Placeholder for status codes\n    FASTAPI_AVAILABLE = False\n\n\nclass StrlenRequest(BaseModel):\n    \"\"\"Pydantic model for the /strlen request body.\"\"\"\n    s: str\n\n\nclass APIController:\n    \"\"\"\n    Provides a factory for a FastAPI application to expose string utilities via HTTP.\n    \"\"\"\n    def __init__(self, service: StringService) -> None:\n        self._service = service\n\n    def create_app(self) -> FastAPI:\n        \"\"\"\n        Creates and configures a FastAPI application.\n        Raises RuntimeError if FastAPI is not installed.\n        \"\"\"\n        if not FASTAPI_AVAILABLE:\n            raise RuntimeError(\n                \"FastAPI and its dependencies are not installed. \"\n                \"Install with `pip install 'strutils[api]'`.\"\n            )\n\n        app = FastAPI(\n            title=\"Strutils API\",\n            description=\"String Utilities API for computing string length.\",\n            version=__version__,\n        )\n\n        # Custom exception handler for ValidationError from the service layer\n        @app.exception_handler(ValidationError)\n        async def validation_error_handler(_request: Any, exc: ValidationError) -> JSONResponse:\n            return JSONResponse(\n                status_code=status.HTTP_400_BAD_REQUEST,\n                content={\"detail\": str(exc)},\n            )\n\n        @app.post(\"/strlen\", response_model=Dict[str, int], status_code=status.HTTP_200_OK)\n        async def get_string_length(request: StrlenRequest) -> Dict[str, int]:\n            \"\"\"\n            Computes the length of the string provided in the request body.\n            \"\"\"\n            try:\n                # The StrlenRequest model ensures request.s is a str, so no further validation needed from service\n                length = self._service.length(request.s)\n                return {\"length\": length}\n            except ValidationError as e:\n                # This should be caught by the @app.exception_handler above,\n                # but explicit re-raising ensures it's handled correctly\n                raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=str(e))\n            except Exception as e:\n                # Catch any other unexpected errors\n                raise HTTPException(status_code=status.HTTP_500_INTERNAL_SERVER_ERROR, detail=\"An unexpected error occurred.\")\n\n        return app\n\n# Instantiate the necessary components for `uvicorn strutils.http_adapter:app`\n_validator = Validator()\n_service = StringService(_validator)\n_api_controller = APIController(_service)\napp = _api_controller.create_app()\n\n```\n```python\n# src/strutils/__init__.py\nfrom .core import strlen\nfrom .services import StringService\nfrom .validation import StringDTO, Validator\nfrom .exceptions import StrutilsError, InvalidStringError, ValidationError\nfrom .__about__ import __version__\n\n__all__ = [\n    \"strlen\",\n    \"StringService\",\n    \"StringDTO\",\n    \"Validator\",\n    \"StrutilsError\",\n    \"InvalidStringError\",\n    \"ValidationError\",\n    \"__version__\",\n]\n\n```\n```python\n# tests/conftest.py\nimport pytest\nimport sys\nfrom unittest.mock import patch\n\n# No specific fixtures needed for now, but this file is part of the structure.\n\n@pytest.fixture\ndef mock_stdout():\n    \"\"\"Fixture to capture stdout.\"\"\"\n    with patch('sys.stdout') as mock_stdout:\n        yield mock_stdout\n\n@pytest.fixture\ndef mock_stderr():\n    \"\"\"Fixture to capture stderr.\"\"\"\n    with patch('sys.stderr') as mock_stderr:\n        yield mock_stderr\n\n@pytest.fixture\ndef mock_exit():\n    \"\"\"Fixture to capture sys.exit calls.\"\"\"\n    with patch('sys.exit') as mock_exit:\n        yield mock_exit\n\n```\n```python\n# tests/test_core.py\nimport pytest\nfrom src.strutils.core import strlen\nfrom src.strutils.exceptions import InvalidStringError\n\ndef test_strlen_empty_string():\n    \"\"\"Test strlen with an empty string.\"\"\"\n    assert strlen(\"\") == 0\n\ndef test_strlen_ascii_string():\n    \"\"\"Test strlen with a basic ASCII string.\"\"\"\n    assert strlen(\"abc\") == 3\n\ndef test_strlen_unicode_string():\n    \"\"\"Test strlen with a Unicode string (e.g., accented characters).\"\"\"\n    assert strlen(\"h\u00e9llo\") == 5\n    assert strlen(\"\u041f\u0440\u0438\u0432\u0435\u0442\") == 6 # Cyrillic\n\ndef test_strlen_emoji_string():\n    \"\"\"Test strlen with a string containing emojis.\"\"\"\n    assert strlen(\"\ud83d\ude00\") == 1\n    assert strlen(\"\ud83d\udc68\u200d\ud83d\udc69\u200d\ud83d\udc67\u200d\ud83d\udc66\") == 1 # A single grapheme cluster can be multiple code points, but Python's len counts code points\n    assert strlen(\"hello\ud83d\ude00world\") == 11\n\ndef test_strlen_mixed_string():\n    \"\"\"Test strlen with a mixed ASCII, Unicode, and emoji string.\"\"\"\n    assert strlen(\"test_h\u00e9llo\ud83d\ude00\") == 10\n\ndef test_strlen_none_input_raises_invalid_string_error():\n    \"\"\"Test that strlen raises InvalidStringError for None input.\"\"\"\n    with pytest.raises(InvalidStringError) as excinfo:\n        strlen(None) # type: ignore\n    assert \"Expected str, got NoneType\" in str(excinfo.value)\n\ndef test_strlen_int_input_raises_invalid_string_error():\n    \"\"\"Test that strlen raises InvalidStringError for int input.\"\"\"\n    with pytest.raises(InvalidStringError) as excinfo:\n        strlen(123) # type: ignore\n    assert \"Expected str, got int\" in str(excinfo.value)\n\ndef test_strlen_bytes_input_raises_invalid_string_error():\n    \"\"\"Test that strlen raises InvalidStringError for bytes input.\"\"\"\n    with pytest.raises(InvalidStringError) as excinfo:\n 