e types.\"\"\"\n        payload = json.dumps([1, \"a\", 2.5, True, None])\n        assert ValidationUtils.parse_json_list(payload) == [1, \"a\", 2.5, True, None]\n\n    def test_parse_json_list_empty_list(self):\n        \"\"\"Test parsing an empty JSON list.\"\"\"\n        payload = json.dumps([])\n        assert ValidationUtils.parse_json_list(payload) == []\n\n    def test_parse_json_list_invalid_json_format(self):\n        \"\"\"Test parsing malformed JSON, expecting ListUtilsError.\"\"\"\n        with pytest.raises(ListUtilsError, match=\"invalid JSON payload\"):\n            ValidationUtils.parse_json_list(\"{'a': 1}\") # Single quotes\n        with pytest.raises(ListUtilsError, match=\"invalid JSON payload\"):\n            ValidationUtils.parse_json_list(\"not json\")\n\n    def test_parse_json_list_not_a_list(self):\n        \"\"\"Test parsing JSON that is not an array, expecting ListUtilsError.\"\"\"\n        with pytest.raises(ListUtilsError, match=\"payload must be a JSON list\"):\n            ValidationUtils.parse_json_list(json.dumps({\"key\": \"value\"}))\n        with pytest.raises(ListUtilsError, match=\"payload must be a JSON list\"):\n            ValidationUtils.parse_json_list(json.dumps(123))\n        with pytest.raises(ListUtilsError, match=\"payload must be a JSON list\"):\n            ValidationUtils.parse_json_list(json.dumps(\"string\"))\n\n    def test_ensure_non_empty_list(self):\n        \"\"\"Test ensure_non_empty with a non-empty list.\"\"\"\n        ValidationUtils.ensure_non_empty([1, 2, 3]) # Should not raise\n\n    def test_ensure_non_empty_empty_list(self):\n        \"\"\"Test ensure_non_empty with an empty list, expecting ListUtilsError.\"\"\"\n        with pytest.raises(ListUtilsError, match=\"input list must not be empty\"):\n            ValidationUtils.ensure_non_empty([])\n```\n\n```tests/test_cli.py\n\"\"\"\nIntegration-like tests for the CLI controller in listutils/cli.py.\nUses subprocess to simulate CLI calls.\n\"\"\"\nimport pytest\nimport subprocess\nimport sys\nimport json\nfrom typing import List, Tuple\n\n# Path to the listutils runner script\nCLI_RUNNER = [sys.executable, '-m', 'src.listutils.runner']\n\ndef run_cli(args: List[str], stdin_data: str = None) -> Tuple[int, str, str]:\n    \"\"\"\n    Helper to run the CLI command and capture its output and exit code.\n    Returns (exit_code, stdout, stderr).\n    \"\"\"\n    process = subprocess.run(\n        CLI_RUNNER + args,\n        input=stdin_data,\n        capture_output=True,\n        text=True,\n        check=False\n    )\n    return process.returncode, process.stdout.strip(), process.stderr.strip()\n\nclass TestCLIController:\n\n    def test_cli_positional_args_success(self):\n        \"\"\"Test CLI with positional arguments for success.\"\"\"\n        code, stdout, stderr = run_cli([\"1\", \"2\", \"3\", \"0\", \"5\"])\n        assert code == 0\n        assert stdout == \"5\"\n        assert stderr == \"\"\n\n    def test_cli_positional_args_floats_success(self):\n        \"\"\"Test CLI with positional arguments including floats.\"\"\"\n        code, stdout, stderr = run_cli([\"1.1\", \"2.2\", \"3.3\"])\n        assert code == 0\n        assert stdout == \"3.3\"\n        assert stderr == \"\"\n\n    def test_cli_positional_args_strings_success(self):\n        \"\"\"Test CLI with positional arguments including strings.\"\"\"\n        code, stdout, stderr = run_cli([\"apple\", \"banana\", \"cherry\"])\n        assert code == 0\n        assert stdout == \"cherry\"\n        assert stderr == \"\"\n\n    def test_cli_stdin_json_success(self):\n        \"\"\"Test CLI with JSON input from stdin.\"\"\"\n        code, stdout, stderr = run_cli([\"--stdin\"], stdin_data=json.dumps([1, 5, 2, 8, 3]))\n        assert code == 0\n        assert stdout == \"8\"\n        assert stderr == \"\"\n\n    def test_cli_stdin_json_strings_success(self):\n        \"\"\"Test CLI with JSON input from stdin containing strings.\"\"\"\n        code, stdout, stderr = run_cli([\"--stdin\"], stdin_data=json.dumps([\"alpha\", \"beta\", \"gamma\"]))\n        assert code == 0\n        assert stdout == \"gamma\"\n        assert stderr == \"\"\n    \n    def test_cli_piped_json_success(self):\n        \"\"\"Test CLI with JSON input piped directly (without --stdin flag)\"\"\"\n        code, stdout, stderr = run_cli([], stdin_data=json.dumps([1, 5, 2, 8, 3]))\n        assert code == 0\n        assert stdout == \"8\"\n        assert stderr == \"\"\n\n    def test_cli_json_output_flag(self):\n        \"\"\"Test CLI with --json flag for JSON output.\"\"\"\n        code, stdout, stderr = run_cli([\"1\", \"2\", \"3\", \"--json\"])\n        assert code == 0\n        assert json.loads(stdout) == {\"max\": 3}\n        assert stderr == \"\"\n\n    def test_cli_stdin_json_and_json_output_flag(self):\n        \"\"\"Test CLI with --stdin and --json flags.\"\"\"\n        code, stdout, stderr = run_cli([\"--stdin\", \"--json\"], stdin_data=json.dumps([1, 5, 2]))\n        assert code == 0\n        assert json.loads(stdout) == {\"max\": 5}\n        assert stderr == \"\"\n\n    def test_cli_empty_input_positional_args_failure(self):\n        \"\"\"Test CLI with no input, expecting error.\"\"\"\n        code, stdout, stderr = run_cli([])\n        assert code != 0\n        assert \"Error: No input provided.\" in stderr\n\n    def test_cli_empty_list_stdin_json_failure(self):\n        \"\"\"Test CLI with empty JSON list from stdin, expecting error.\"\"\"\n        code, stdout, stderr = run_cli([\"--stdin\"], stdin_data=json.dumps([]))\n        assert code != 0\n        assert \"Error: input list must not be empty\" in stderr\n\n    def test_cli_invalid_json_stdin_failure(self):\n        \"\"\"Test CLI with invalid JSON from stdin, expecting error.\"\"\"\n        code, stdout, stderr = run_cli([\"--stdin\"], stdin_data=\"not a json array\")\n        assert code != 0\n        assert \"Error: invalid JSON payload\" in stderr\n\n    def test_cli_i