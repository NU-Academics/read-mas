         exit_code = cli_controller.run([])\n            assert exit_code == 2\n            captured = capsys.readouterr()\n            assert \"Error: Invalid JSON input\" in captured.err\n            assert captured.out == \"\"\n\n    def test_run_non_list_input(self, cli_controller, capsys):\n        \"\"\"Should handle non-list input with exit code 2.\"\"\"\n        with patch('sys.stdin.read', return_value=json.dumps(\"not_a_list\")):\n            exit_code = cli_controller.run([])\n            assert exit_code == 2\n            captured = capsys.readouterr()\n            assert \"Error: Input 'values' must be a JSON array\" in captured.err\n            assert captured.out == \"\"\n\n    def test_run_input_file_not_found(self, cli_controller, capsys):\n        \"\"\"Should handle non-existent input file with exit code 2.\"\"\"\n        exit_code = cli_controller.run([\"--input\", \"/path/does/not/exist.json\"])\n        assert exit_code == 2\n        captured = capsys.readouterr()\n        assert \"Error: Input file not found\" in captured.err\n        assert captured.out == \"\"\n\n    def test_run_persistence_cli_arg(self, cli_controller, tmp_path):\n        \"\"\"Should persist results to a file specified by --persist-path.\"\"\"\n        input_file = tmp_path / \"input.json\"\n        input_file.write_text(json.dumps([1, \"a\", 2, 3.0]))\n        persist_file = tmp_path / \"cli_results.jsonl\"\n\n        exit_code = cli_controller.run([\"-i\", str(input_file), \"--persist-path\", str(persist_file)])\n        assert exit_code == 0\n        assert os.path.exists(persist_file)\n        with open(persist_file, \"r\") as f:\n            record = json.loads(f.readline())\n            assert record[\"result\"] == [1, 2]\n            assert record[\"input_len\"] == 4\n            assert \"timestamp\" in record\n\n    def test_run_persistence_cli_arg_append_true(self, cli_controller, tmp_path):\n        \"\"\"Should append to persistence file with --persist-append.\"\"\"\n        input_file_1 = tmp_path / \"input1.json\"\n        input_file_1.write_text(json.dumps([1]))\n        input_file_2 = tmp_path / \"input2.json\"\n        input_file_2.write_text(json.dumps([2]))\n        persist_file = tmp_path / \"cli_results_append.jsonl\"\n\n        cli_controller.run([\"-i\", str(input_file_1), \"--persist-path\", str(persist_file), \"--persist-append\"])\n        cli_controller.run([\"-i\", str(input_file_2), \"--persist-path\", str(persist_file), \"--persist-append\"])\n\n        with open(persist_file, \"r\") as f:\n            lines = f.readlines()\n            assert len(lines) == 2\n            assert json.loads(lines[0])[\"result\"] == [1]\n            assert json.loads(lines[1])[\"result\"] == [2]\n\n    def test_run_persistence_cli_arg_append_false(self, cli_controller, tmp_path):\n        \"\"\"Should overwrite persistence file when --persist-append is not used.\"\"\"\n        input_file_1 = tmp_path / \"input1.json\"\n        input_file_1.write_text(json.dumps([1]))\n        input_file_2 = tmp_path / \"input2.json\"\n        input_file_2.write_text(json.dumps([2]))\n        persist_file = tmp_path / \"cli_results_overwrite.json\"\n\n        cli_controller.run([\"-i\", str(input_file_1), \"--persist-path\", str(persist_file)])\n        cli_controller.run([\"-i\", str(input_file_2), \"--persist-path\", str(persist_file)]) # Default append=False\n\n        with open(persist_file, \"r\") as f:\n            content = json.load(f)\n            assert content[\"last_run\"][\"result\"] == [2]\n\n    def test_run_injected_repo_used_when_no_cli_persist(self, cli_controller_with_repo, tmp_path):\n        \"\"\"\n        If a repo is injected via __init__ and no --persist-path is given on CLI,\n        the injected repo should be used.\n        \"\"\"\n        input_file = tmp_path / \"input.json\"\n        input_file.write_text(json.dumps([100, \"b\", 200.5, 300]))\n\n        # The injected repo path is tmp_path / \"injected_repo_results.jsonl\"\n        injected_repo_file = tmp_path / \"injected_repo_results.jsonl\"\n        assert not os.path.exists(injected_repo_file)\n\n        exit_code = cli_controller_with_repo.run([\"-i\", str(input_file)])\n        assert exit_code == 0\n        assert os.path.exists(injected_repo_file)\n        with open(injected_repo_file, \"r\") as f:\n            record = json.loads(f.readline())\n            assert record[\"result\"] == [100, 300]\n            assert record[\"input_len\"] == 4\n\n    def test_run_cli_persist_overrides_injected_repo(self, cli_controller_with_repo, tmp_path):\n        \"\"\"\n        If --persist-path is given on CLI, it should take precedence over an injected repo.\n        \"\"\"\n        input_file = tmp_path / \"input.json\"\n        input_file.write_text(json.dumps([1, 2]))\n        cli_persist_file = tmp_path / \"cli_specific_persist.jsonl\"\n        injected_repo_file = tmp_path / \"injected_repo_results.jsonl\"\n\n        # Sanity check: injected repo file does not exist yet\n        assert not os.path.exists(injected_repo_file)\n        assert not os.path.exists(cli_persist_file)\n\n        exit_code = cli_controller_with_repo.run(\n            [\"-i\", str(input_file), \"--persist-path\", str(cli_persist_file)]\n        )\n        assert exit_code == 0\n\n        # The CLI-specified persist file should exist and contain the result\n        assert os.path.exists(cli_persist_file)\n        with open(cli_persist_file, \"r\") as f:\n            record = json.loads(f.readline())\n            assert record[\"result\"] == [1, 2]\n\n        # The injected repo file should *not* have been used or created\n        assert not os.path.exists(injected_repo_file)\n\n```"}
