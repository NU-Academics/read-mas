 0\n        assert dto.decimal_part == 0.0\n\n    def test_compute_from_integer_float(self):\n        \"\"\"Test compute_from with an integer-valued float.\"\"\"\n        dto = NumberDTO.compute_from(5.0)\n        assert dto.original == 5.0\n        assert dto.integer_part == 5\n        assert dto.decimal_part == 0.0\n\n    def test_compute_from_large_number(self):\n        \"\"\"Test compute_from with a very large number.\"\"\"\n        large_num = 1_000_000_000_000.12345\n        dto = NumberDTO.compute_from(large_num)\n        assert dto.original == large_num\n        assert dto.integer_part == 1_000_000_000_000\n        assert dto.decimal_part == 0.12345\n\n    def test_compute_from_many_decimals(self):\n        \"\"\"Test compute_from with a number having many decimal places.\"\"\"\n        val = 0.12345678901234567\n        dto = NumberDTO.compute_from(3.12345678901234567)\n        assert dto.original == 3.12345678901234567\n        assert dto.integer_part == 3\n        assert dto.decimal_part == pytest.approx(val)\n\n    def test_immutability(self):\n        \"\"\"Test that NumberDTO instances are immutable.\"\"\"\n        dto = NumberDTO.compute_from(1.23)\n        with pytest.raises(AttributeError):\n            dto.original = 2.45\n        with pytest.raises(AttributeError):\n            dto.decimal_part = 0.5\n\n    def test_float_close_to_integer_boundary(self):\n        \"\"\"Test numbers very close to an integer boundary.\"\"\"\n        dto = NumberDTO.compute_from(2.999999999999999)\n        assert dto.integer_part == 2\n        assert dto.decimal_part == pytest.approx(0.999999999999999)\n\n        dto = NumberDTO.compute_from(3.0000000000000001)\n        assert dto.integer_part == 3\n        assert dto.decimal_part == pytest.approx(0.0000000000000001)\n\n```\n```python\n# tests/unit/test_utils.py\nimport pytest\nimport math\nfrom numtrunc.utils import parse_number, validate_non_negative\nfrom numtrunc.exceptions import ValidationError\n\nclass TestUtils:\n    def test_parse_number_valid_float(self):\n        \"\"\"Test parsing valid float strings.\"\"\"\n        assert parse_number(\"3.5\") == 3.5\n        assert parse_number(\"0.0\") == 0.0\n        assert parse_number(\"123\") == 123.0\n        assert parse_number(\"-4.2\") == -4.2 # parse_number itself allows negative, validate_non_negative will catch\n        assert parse_number(\"1e-5\") == 1e-5\n\n    def test_parse_number_invalid_string(self):\n        \"\"\"Test parsing invalid float strings.\"\"\"\n        with pytest.raises(ValidationError, match=\"'abc' is not a valid float\"):\n            parse_number(\"abc\")\n        with pytest.raises(ValidationError, match=\"'' is not a valid float\"):\n            parse_number(\"\")\n        with pytest.raises(ValidationError, match=\"'3.5.2' is not a valid float\"):\n            parse_number(\"3.5.2\")\n\n    def test_parse_number_nan(self):\n        \"\"\"Test parsing NaN string.\"\"\"\n        with pytest.raises(ValidationError, match=\"cannot be NaN\"):\n            parse_number(\"nan\")\n        with pytest.raises(ValidationError, match=\"cannot be NaN\"):\n            parse_number(\"NaN\")\n\n    def test_parse_number_infinity(self):\n        \"\"\"Test parsing infinity strings.\"\"\"\n        with pytest.raises(ValidationError, match=\"cannot be Infinity\"):\n            parse_number(\"inf\")\n        with pytest.raises(ValidationError, match=\"cannot be Infinity\"):\n            parse_number(\"-inf\")\n        with pytest.raises(ValidationError, match=\"cannot be Infinity\"):\n            parse_number(\"Infinity\")\n\n    def test_validate_non_negative_valid(self):\n        \"\"\"Test valid non-negative numbers.\"\"\"\n        validate_non_negative(0.0)\n        validate_non_negative(1.0)\n        validate_non_negative(123.45)\n        validate_non_negative(1e10)\n\n    def test_validate_non_negative_negative(self):\n        \"\"\"Test negative numbers.\"\"\"\n        with pytest.raises(ValidationError, match=\"must be non-negative\"):\n            validate_non_negative(-0.1)\n        with pytest.raises(ValidationError, match=\"must be non-negative\"):\n            validate_non_negative(-100.0)\n\n    def test_validate_non_negative_nan(self):\n        \"\"\"Test NaN input.\"\"\"\n        with pytest.raises(ValidationError, match=\"cannot be NaN\"):\n            validate_non_negative(math.nan)\n\n    def test_validate_non_negative_infinity(self):\n        \"\"\"Test infinity input.\"\"\"\n        with pytest.raises(ValidationError, match=\"cannot be Infinity\"):\n            validate_non_negative(math.inf)\n        with pytest.raises(ValidationError, match=\"cannot be Infinity\"):\n            validate_non_negative(-math.inf)\n\n```\n```python\n# tests/integration/test_api.py\nimport pytest\nfrom fastapi.testclient import TestClient\nfrom numtrunc.api import create_app\nfrom numtrunc.truncator import TruncatorService\nfrom unittest.mock import MagicMock\n\nclass TestAPI:\n    @pytest.fixture\n    def mock_truncator_service(self):\n        \"\"\"Fixture for a mock TruncatorService.\"\"\"\n        mock = MagicMock(spec=TruncatorService)\n        mock.get_decimal_part.return_value = 0.5 # Default mock return\n        return mock\n\n    @pytest.fixture\n    def client(self, mock_truncator_service):\n        \"\"\"Fixture for the FastAPI test client with a mocked service.\"\"\"\n        app = create_app(truncator_service=mock_truncator_service)\n        return TestClient(app)\n\n    def test_truncate_endpoint_success(self, client, mock_truncator_service):\n        \"\"\"\n        Test successful POST request to /truncate.\n        \"\"\"\n        mock_truncator_service.get_decimal_part.return_value = 0.5\n        \n        response = client.post(\"/truncate\", json={\"number\": 3.5})\n        \n        assert response.status_code == 200\n        assert response.json() == {\"original\": 3.5, \"integer_part\": 3, \"decimal\": 0.5}\n        mock_truncator_service.get_decimal_part.assert_called_once_with(3.5)\n\n    def test_truncate_endpoint_zero(self, client, mock_truncator_service):\n        \"\"\"\n        Test successful POST request with zero.\n        \"\"\"\n        mock_truncator_service.get_decimal_part.return_value = 0.0\n        \n        response = client.post(\"/truncate\", json={\"number\": 0.0})\n        \n        assert response.status_code == 200\n        assert response.json() == {\"original\": 0.0, \"integer_part\": 0, \"decimal\": 0.0}\n        mock_truncator_service.get_decimal_part.assert_called_once_with(0.0)\n\n    def test_truncate_endpoint_integer_input(self, client, mock_truncator_service):\n        \"\"\"\n        Test successful POST request with an integer.\n        \"\"\"\n        mock_truncator_service.get_decimal_part.return_value = 0.0\n        \n        response = client.post(\"/truncate\", json={\"number\": 5}) # Pydantic converts int to float\n        \n        assert response.status_code == 200\n        assert response.json() == {\"original\": 5.0, \"integer_part\": 5, \"decimal\": 0.0}\n        mock_truncator_service.get_decimal_part.assert_called_once_with(5.0)\n\n    def test_truncate_endpoint_validation_error_negative(self, client, mock_truncator_service):\n        \"\"\"\n        Test POST request with a negative number resulting in ValidationError.\n        \"\"\"\n        from numtrunc.exceptions import ValidationError\n        mock_truncator_service.get_decimal_part.side_effect = ValidationError(\"number must be non-negative\")\n\n        response = client.post(\"/truncate\", json={\"number\": -3.5})\n        \n        assert response.status_code == 400\n        assert response.json() == {\"detail\": \"number must be non-negative\"}\n        mock_truncator_service.get_decimal_part.assert_called_once_with(-3.5)\n\n    def test_truncate_endpoint_validation_error_nan(self, client, mock_truncator_service):\n        \"\"\"\n        Test POST request with NaN resulting in ValidationError.\n        Pydantic's default behavior for `float` input *does* allow `NaN`.\n        The validation in `TruncatorService` and `utils` is crucial.\n        \"\"\"\n        import math\n        from numtrunc.exceptions import ValidationError\n        mock_truncator_service.get_decimal_part.side_effect = ValidationError(\"Input number cannot be NaN (Not a Number).\")\n\n        response = client.post(\"/truncate\", json={\"number\": math.nan})\n        \n        assert response.status_code == 400\n        assert response.json() == {\"detail\": \"Input number cannot be NaN (Not a Number).\"}\n\n    def test_truncate_endpoint_validation_error_inf(self, client, mock_truncator_service):\n        \"\"\"\n        Test POST request with Infinity resulting in ValidationError.\n        \"\"\"\n        import math\n        from numtrunc.exceptions import ValidationError\n        mock_truncator_service.get_decimal_part.side_effect = ValidationError(\"Input number cannot be Infinity.\")\n\n        response = client.post(\"/truncate\", json={\"number\": math.inf})\n        \n        assert response.status_code == 400\n        assert response.json() == {\"detail\": \"Input number cannot be Infinity.\"}\n\n    def test_truncate_endpoint_invalid_json_body(self, client):\n        \"\"\"\n        Test POST request with invalid JSON body (FastAPI/Pydantic validation).\n        \"\"\"\n        response = client.post(\"/truncate\", json={\"value\": 3.5}) # Missing 'number'\n        assert response.status_code == 422 # Unprocessable Entity by Pydantic\n\n        response = client.post(\"/truncate\", json={\"number\": \"not-a-float\"}) # Invalid type\n        assert response.status_code == 422 # Unprocessable Entity by Pydantic\n\n    def test_truncate_endpoint_internal_server_error(self, client, mock_truncator_service):\n        \"\"\"\n        Test POST request leading to an unhandled internal server error.\n        \"\"\"\n        mock_truncator_service.get_decimal_part.side_effect = Exception(\"Something went wrong internally\")\n        \n        response = client.post(\"/truncate\", json={\"number\": 1.2})\n        \n        assert response.status_code == 500\n        assert response.json() == {\"detail\": \"Internal server error\"}\n\n```\n```yaml\n# .github/workflows/ci.yml\nname: CI/CD Pipeline\n\non:\n  push:\n    branches:\n      - main\n  pull_request:\n    branches:\n      - main\n\njobs:\n  build-and-test:\n    runs-on: ubuntu-latest\n    steps:\n      - name: Checkout repository\n        uses: actions/checkout@v3\n\n      - name: Set up Python\n        uses: actions/setup-python@v4\n        with:\n          python-version: '3.9' # Or your preferred Python version >=3.8\n\n      - name: Install dependencies\n        run: |\n          python -m pip install --upgrade pip\n          pip install -e .[dev] # Install project in editable mode with dev dependencies\n\n      - name: Run tests with pytest and coverage\n        run: |\n          pytest --cov=src/numtrunc --cov-report=xml\n          \n      - name: Upload coverage to Codecov\n        uses: codecov/codecov-action@v3\n        with:\n          file: ./coverage.xml\n          flags: unittests\n          name: codecov-umbrella\n          verbose: true\n```\n```markdown\n# docs/usage.md\n# numtrunc Usage Guide\n\nThis document provides instructions on how to use `numtrunc` as a Python library, a command-line tool, and an HTTP API.\n\n## 1. As a Python Library\n\nThe core functionality is exposed through the `truncate_number` function, which returns the decimal part of a positive floating-point number.\n\n### Installation\n\n```bash\npip install numtrunc\n```\n\n### Example Usage\n\n```python\nfrom numtrunc import truncate_number\n\n# Basic usage\nprint(f\"Decimal part of 3.5: {truncate_number(3.5)}\")  # Output: 0.5\n\n# For an integer (float)\nprint(f\"Decimal part of 7.0: {truncate_number(7.0)}\")  # Output: 0.0\n\n# For a number with many decimals\nvalue = 123.4567890123\nprint(f\"Decimal part of {value}: {truncate_number(value)}\") # Output: 0.4567890123\n\n# Zero\nprint(f\"Decimal part of 0.0: {truncate_number(0.0)}\")  # Output: 0.0\n\n# Note: The raw `truncate_number` function (as per CRITICAL REQUIREMENTS) does not\n# perform input validation for negative numbers, NaN, or Infinity.\n# For robust usage with validation, consider using the `TruncatorService` or `TruncateController`\n# directly, or relying on the CLI/API which include full validation.\n```\n\n## 2. As a Command-Line Interface (CLI)\n\nThe `numtrunc` package provides a command-line utility to quickly get the decimal part of a number.\n\n### Installation\n\nMake sure `numtrunc` is installed as described above. The `pyproject.toml` configures a `console_script` entry point.\n\n### Example Usage\n\n```bash\n# Get the decimal part of 3.5\nnumtrunc truncate 3.5\n# Output: 0.5\n\n# Get the decimal part of 0.123\nnumtrunc truncate 0.123\n# Output: 0.123\n\n# Get the decimal part of an integer\nnumtrunc truncate 100\n# Output: 0.0\n\n# Handling invalid input (negative number)\nnumtrunc truncate -2.5\n# Output (to stderr): Error: Input number must be non-negative.\n# Exit code: 2\n\n# Handling invalid input (non-numeric)\nnumtrunc truncate hello\n# Output (to stderr): Error: 'hello' is not a valid float.\n# Exit code: 2\n\n# Usage help\nnumtrunc\n# Output (to stderr): Usage: numtrunc truncate <number>\n# Exit code: 2\n```\n\n## 3. As an HTTP API\n\nA FastAPI application is provided, exposing a `/truncate` endpoint for programmatic integration.\n\n### Running the API\n\nYou can run the API using `uvicorn`:\n\n```bash\nuvicorn src.numtrunc.api:app --host 0.0.0.0 --port 8000\n```\nThis will start the API server, typically accessible at `http://127.0.0.1:8000`.\n\n### API Endpoint: `POST /truncate`\n\nThis endpoint accepts a JSON payload with a `number` field and returns the original number, its integer part, and its decimal part.\n\n#### Request\n\n- **URL**: `/truncate`\n- **Method**: `POST`\n- **Headers**: `Content-Type: application/json`\n- **Body**:\n  ```json\n  {\n    \"number\": 3.5\n  }\n  ```\n\n#### Successful Response (HTTP 200)\n\n```json\n{\n  \"original\": 3.5,\n  \"integer_part\": 3,\n  \"decimal\": 0.5\n}\n```\n\n#### Error Response (HTTP 400 - Bad Request)\n\nReturns when input validation fails (e.g., negative number, NaN, Infinity).\n\n```json\n{\n  \"detail\": \"Input number must be non-negative.\"\n}\n```\n\n#### Error Response (HTTP 422 - Unprocessable Entity)\n\nReturns when the request body JSON is malformed or the `number` field is not a valid float type (as per Pydantic validation).\n\n```json\n{\n  \"detail\": [\n    {\n      \"type\": \"float_parsing\",\n      \"loc\": [\n        \"body\",\n        \"number\"\n      ],\n      \"msg\": \"Input should be a valid float, unable to parse string\",\n      \"input\": \"not-a-number\"\n    }\n  ]\n}\n```\n\n#### Error Response (HTTP 500 - Internal Server Error)\n\nReturns for unexpected server-side errors.\n\n```json\n{\n  \"detail\": \"Internal server error\"\n}\n```\n\n### Example using `curl`\n\n```bash\n# Successful request\ncurl -X POST \"http://127.0.0.1:8000/truncate\" \\\n     -H \"Content-Type: application/json\" \\\n     -d '{\"number\": 3.5}'\n\n# Request with zero\ncurl -X POST \"http://127.0.0.1:8000/truncate\" \\\n     -H \"Content-Type: application/json\" \\\n     -d '{\"number\": 0.0}'\n\n# Request with a negative number (validation error)\ncurl -X POST \"http://127.0.0.1:8000/truncate\" \\\n     -H \"Content-Type: application/json\" \\\n     -d '{\"number\": -3.5}'\n\n# Request with a non-numeric value (Pydantic validation error)\ncurl -X POST \"http://127.0.0.1:8000/truncate\" \\\n     -H \"Content-Type: application/json\" \\\n     -d '{\"number\": \"hello\"}'\n```\n```\n\n```python\n# src/numtrunc/__init__.py\nimport math\n\n# This implementation adheres strictly to the \"CRITICAL REQUIREMENTS\" for the\n# `truncate_number` function: bare, no external calls, no validation, minimal docstring.\ndef truncate_number(number: float) -> float:\n    \"\"\"Returns the decimal part of a positive floating-point number.\n    It computes the integer part and subtracts it from the original number.\n    \"\"\"\n    integer_part = math.floor(number)\n    return number - integer_part\n\n# Package metadata as per design spec\n__version__ = \"0.1.0\"\n\n# Note: The design specification originally suggested this be a wrapper.\n# However, the CRITICAL REQUIREMENTS for `truncate_number` to not call\n# external helper functions or utilities not defined in the same block\n# forced this direct implementation.\n# Other components will use TruncatorService for full functionality.\n\n```"}
{"task_id": "HumanEval/4", "solution": "from typing import List\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\"Calculates the Mean Absolute Deviation (MAD) around the arithmetic mean for a list of numbers.\n    It computes the average absolute difference between each element and the dataset's mean.\"\"\"\n    n = len(numbers)\n    # Assume n > 0 and all numbers are finite floats due to critical requirements.\n    mean = sum(numbers) / n\n    deviations = [abs(x - mean) for x in numbers]\n    mad = sum(deviations) / n\n    return mad"}
{"task_id": "HumanEval/4", "solution": "from typing import List\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset. MAD is the average absolute difference between each\n    element and a centerpoint (mean in this case).\n    \"\"\"\n    n = len(numbers)\n    # Critical requirements forbid validation; assuming 'numbers' is non-empty list of floats.\n    mean = sum(numbers) / n\n    total_abs_diff = sum(abs(x - mean) for x in numbers)\n    return total_abs_diff / n"}
{"task_id": "HumanEval/5", "solution": "```python\n# src/intersperse_pkg/__init__.py\n\"\"\"\nA small, well-tested, reusable Python library that inserts a delimiter integer\nbetween every two consecutive elements of an integer list.\n\"\"\"\nfrom typing import List\n\nfrom .services import IntersperserService\nfrom .validators import InputValidator\nfrom .exceptions import InvalidInputError\n\n# Public API function\n_intersperse_service = IntersperserService()\n_input_validator = InputValidator()\n\ndef intersperse(numbers: List[int], delimiter: int) -> List[int]:\n    \"\"\"\n    Inserts a delimiter integer between every two consecutive elements of an integer list.\n\n    Args:\n        numbers: A list of integers.\n        delimiter: An integer to be inserted.\n\n    Returns:\n        A new list with the delimiter interspersed.\n\n    Raises:\n        InvalidInputError: If numbers is not a list of integers or delimiter is not an integer.\n    \"\"\"\n    validated_numbers = _input_validator.validate_numbers(numbers)\n    validated_delimiter = _input_validator.validate_delimiter(delimiter)\n    return _intersperse_service.intersperse(validated_numbers, validated_delimiter)\n\n__all__ = [\"intersperse\", \"InvalidInputError\"]\n\n```\n```python\n# src/intersperse_pkg/models.py\nfrom typing import List\n\nclass NumbersDTO:\n    \"\"\"\n    Data Transfer Object for validated numbers and delimiter.\n    \"\"\"\n    def __init__(self, numbers: List[int], delimiter: int) -> None:\n        \"\"\"\n        Initializes a NumbersDTO instance.\n\n        Args:\n            numbers: A list of integers.\n            delimiter: An integer delimiter.\n        \"\"\"\n        self.numbers = numbers\n        self.delimiter = delimiter\n\n    def to_list(self) -> List[int]:\n        \"\"\"\n        Returns a shallow copy of the numbers list.\n        \"\"\"\n        return list(self.numbers)\n\n```\n```python\n# src/intersperse_pkg/exceptions.py\nclass InvalidInputError(Exception):\n    \"\"\"\n    Custom exception for invalid input data.\n    \"\"\"\n    def __init__(self, message: str) -> None:\n        \"\"\"\n        Initializes the exception with a specific message.\n        \"\"\"\n        super().__init__(message)\n        self.message = message\n\n```\n```python\n# src/intersperse_pkg/validators.py\nfrom typing import Any, List\nfrom .exceptions import InvalidInputError\nfrom .models import NumbersDTO\n\nclass InputValidator:\n    \"\"\"\n    Validates various input types and contents for the intersperse operation.\n    \"\"\"\n    def validate_numbers(self, numbers: Any) -> List[int]:\n        \"\"\"\n        Validates that the input is a list or tuple of integers.\n        \"\"\"\n        if not isinstance(numbers, (list, tuple)):\n            raise InvalidInputError(\"Numbers input must be a list or tuple of integers.\")\n        \n        result: List[int] = []\n        for i, x in enumerate(numbers):\n            if not isinstance(x, int):\n                raise InvalidInputError(f\"Element at index {i} is not an integer: {x!r}.\")\n            result.append(x)\n        return result\n\n    def validate_delimiter(self, delimiter: Any) -> int:\n        \"\"\"\n        Validates that the input delimiter is an integer, or convertible from a string.\n        \"\"\"\n        if isinstance(delimiter, int):\n            return delimiter\n        if isinstance(delimiter, str):\n            try:\n                return int(delimiter)\n            except ValueError:\n                raise InvalidInputError(\"Delimiter string is not a valid integer.\")\n        raise InvalidInputError(\"Delimiter must be an integer.\")\n\n    def validate_numbers_and_delimiter(self, numbers: Any, delimiter: Any) -> NumbersDTO:\n        \"\"\"\n        Orchestrates validation for both numbers and delimiter, returning a DTO.\n        \"\"\"\n        validated_numbers = self.validate_numbers(numbers)\n        validated_delimiter = self.validate_delimiter(delimiter)\n        return NumbersDTO(validated_numbers, validated_delimiter)\n\n```\n```python\n# src/intersperse_pkg/services.py\nfrom typing import List, Iterator\n\nclass IntersperserService:\n    \"\"\"\n    Core business logic for interspersing elements in a list.\n    \"\"\"\n    def intersperse(self, numbers: List[int], delimiter: int) -> List[int]:\n        \"\"\"\n        Inserts a delimiter between every two consecutive elements of `numbers`.\n        Returns a new list without modifying the original.\n        \"\"\"\n        n = len(numbers)\n        if n <= 1:\n            return list(numbers) # Return a copy for consistency and immutability\n        \n        result_len = 2 * n - 1\n        result: List[int] = [0] * result_len # Pre-allocate for efficiency\n        \n        # Place numbers at even indices\n        result[0::2] = numbers\n        \n        # Place delimiters at odd indices\n        result[1::2] = [delimiter] * (n - 1)\n        \n        return result\n\n    def intersperse_generator(self, numbers: List[int], delimiter: int) -> Iterator[int]:\n        \"\"\"\n        Yields elements with the delimiter interspersed, useful for streaming.\n        \"\"\"\n        it = iter(numbers)\n        try:\n            first = next(it)\n        except StopIteration:\n            return # Empty list, yield nothing\n        \n        yield first\n        for x in it:\n            yield delimiter\n            yield x\n\n```\n```python\n# src/intersperse_pkg/repositories.py\nimport json\nimport os\nimport tempfile\nfrom typing import List\nfrom .exceptions import InvalidInputError\nfrom .utils import safe_read_json, safe_write_json # Use helper functions for IO\n\nclass FileRepository:\n    \"\"\"\n    Handles reading from and writing to JSON files for integer lists.\n    \"\"\"\n    def read(self, path: str) -> List[int]:\n        \"\"\"\n        Reads a JSON file, validates its content as an array of integers, and returns it.\n        \"\"\"\n        data = safe_read_json(path)\n        if not isinstance(data, list):\n            raise InvalidInputError(f\"Input file '{path}' does not contain a JSON array.\")\n        \n        for i, item in enumerate(data):\n            if not isinstance(item, int):\n                raise InvalidInputError(f\"Input file '{path}' contains non-integer element at index {i}: {item!r}.\")\n        return data\n\n    def write(self, path: str, data: List[int]) -> None:\n        \"\"\"\n        Writes a list of integers as a JSON array to a file.\n        \"\"\"\n        # Basic validation before writing\n        if not isinstance(data, list) or not all(isinstance(x, int) for x in data):\n            raise InvalidInputError(\"Data to write must be a list of integers.\")\n        \n        safe_write_json(path, data)\n\n    def exists(self, path: str) -> bool:\n        \"\"\"\n        Checks if a file exists at the given path.\n        \"\"\"\n        return os.path.exists(path)\n\n```\n```python\n# src/intersperse_pkg/utils.py\nimport json\nimport os\nimport tempfile\nfrom typing import List, Any\nfrom .exceptions import InvalidInputError\n\ndef parse_comma_separated(s: str) -> List[int]:\n    \"\"\"\n    Parses a comma-separated string of integers into a list of integers.\n    Ignores whitespace around numbers.\n    \"\"\"\n    parts = s.split(',')\n    result: List[int] = []\n    for i, part in enumerate(parts):\n        stripped_part = part.strip()\n        if not stripped_part: # Allow empty parts like \"1,,2\" by ignoring them\n            continue\n        try:\n            result.append(int(stripped_part))\n        except ValueError:\n            raise InvalidInputError(f\"Invalid number format in comma-separated list at position {i}: '{part}'.\")\n    return result\n\ndef safe_read_json(path: str) -> Any:\n    \"\"\"\n    Reads and parses a JSON file. Handles file not found or JSON decoding errors.\n    \"\"\"\n    try:\n        with open(path, 'r', encoding='utf-8') as f:\n            return json.load(f)\n    except FileNotFoundError:\n        raise OSError(f\"Input file not found: '{path}'.\")\n    except json.JSONDecodeError as e:\n        raise InvalidInputError(f\"Error decoding JSON from file '{path}': {e}.\")\n    except Exception as e:\n        raise OSError(f\"An unexpected error occurred reading file '{path}': {e}.\")\n\n\ndef safe_write_json(path: str, data: Any) -> None:\n    \"\"\"\n    Writes data to a JSON file atomically (using a temporary file and rename).\n    \"\"\"\n    dirname = os.path.dirname(path)\n    # Ensure directory exists if not writing to current directory\n    if dirname and not os.path.exists(dirname):\n        os.makedirs(dirname, exist_ok=True)\n        \n    temp_file_fd, temp_file_path = tempfile.mkstemp(dir=dirname, suffix=\".tmp\")\n    try:\n        with os.fdopen(temp_file_fd, 'w', encoding='utf-8') as temp_f:\n            json.dump(data, temp_f, indent=4) # Pretty print JSON\n        os.replace(temp_file_path, path) # Atomic rename\n    except Exception as e:\n        # Clean up temp file if something goes wrong\n        if os.path.exists(temp_file_path):\n            os.remove(temp_file_path)\n        raise OSError(f\"An error occurred while writing to file '{path}': {e}.\")\n\n```\n```python\n# src/intersperse_pkg/controllers.py\nimport sys\nfrom argparse import Namespace\nfrom typing import List, Optional\n\nfrom .services import IntersperserService\nfrom .validators import InputValidator\nfrom .repositories import FileRepository\nfrom .exceptions import InvalidInputError\nfrom .utils import parse_comma_separated\n\nclass CLIController:\n    \"\"\"\n    Orchestrates the application logic for the command-line interface.\n    \"\"\"\n    def __init__(self, service: IntersperserService, validator: InputValidator, repo: Optional[FileRepository] = None) -> None:\n        \"\"\"\n        Initializes the CLIController with necessary service, validator, and repository dependencies.\n        \"\"\"\n        self.service = service\n        self.validator = validator\n        self.repo = repo if repo is not None else FileRepository()\n\n    def process(\n        self,\n        numbers_input: Optional[str],\n        input_file: Optional[str],\n        delimiter_input: str,\n        output_file: Optional[str],\n    ) -> List[int]:\n        \"\"\"\n        Main processing pipeline for intersperse logic, including input parsing, validation,\n        service call, and optional file I/O.\n        \"\"\"\n        numbers: List[int]\n\n        # Determine numbers input source\n        if input_file:\n            if numbers_input:\n                raise InvalidInputError(\"Cannot use both --numbers and --input-file simultaneously.\")\n            numbers = self.repo.read(input_file)\n        elif numbers_input:\n            numbers = parse_comma_separated(numbers_input)\n        else:\n            raise InvalidInputError(\"Either --numbers or --input-file must be provided.\")\n\n        # Validate numbers and delimiter\n        validated_dto = self.validator.validate_numbers_and_delimiter(numbers, delimiter_input)\n\n        # Perform the intersperse operation\n        result = self.service.intersperse(validated_dto.numbers, validated_dto.delimiter)\n\n        # Handle output persistence\n        if output_file:\n            self.repo.write(output_file, result)\n        \n        return result\n\n    def run_from_args(self, args: Namespace) -> int:\n        \"\"\"\n        Adapts argparse Namespace arguments to the processing pipeline and handles output/errors.\n        \"\"\"\n        try:\n            result = self.process(args.numbers, args.input_file, args.delimiter, args.output_file)\n            \n            # If no output file was specified, print to stdout\n            if not args.output_file:\n                import json\n                print(json.dumps(result, indent=4))\n            \n            return 0 # Success exit code\n        except (InvalidInputError, OSError) as e:\n            print(f\"Error: {e}\", file=sys.stderr)\n            return 1 # Error exit code\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 2 # General error exit code\n\n```\n```python\n# src/intersperse_pkg/cli.py\nimport argparse\nimport sys\nimport json\n\nfrom .controllers import CLIController\nfrom .services import IntersperserService\nfrom .validators import InputValidator\nfrom .repositories import FileRepository\nfrom .exceptions import InvalidInputError # Import for specific error handling\n\ndef main(argv: Optional[List[str]] = None) -> int:\n    \"\"\"\n    Main entry point for the command-line interface.\n    Parses arguments, initializes the controller, and runs the process.\n    \"\"\"\n    parser = argparse.ArgumentParser(\n        prog=\"intersperse\",\n        description=\"Insert a delimiter integer between elements of an integer list.\",\n        formatter_class=argparse.RawTextHelpFormatter # For better help formatting\n    )\n    \n    input_group = parser.add_mutually_exclusive_group(required=True)\n    input_group.add_argument(\n        \"-n\", \"--numbers\", \n        help=\"Comma-separated integers, e.g., '1,2,3'.\\nCannot be used with --input-file.\"\n    )\n    input_group.add_argument(\n        \"-i\", \"--input-file\", \n        help=\"Path to a JSON input file containing an array of integers.\\nCannot be used with --numbers.\"\n    )\n    \n    parser.add_argument(\n        \"-d\", \"--delimiter\", \n        required=True, \n        help=\"An integer to be inserted between elements.\"\n    )\n    parser.add_argument(\n        \"-o\", \"--output-file\", \n        help=\"Optional: Path to write the JSON output array. If not provided, output prints to stdout.\"\n    )\n\n    args = parser.parse_args(argv)\n\n    # Instantiate core components\n    service = IntersperserService()\n    validator = InputValidator()\n    repo = FileRepository()\n\n    # Create and run the controller\n    controller = CLIController(service, validator, repo)\n    exit_code = controller.run_from_args(args)\n    \n    return exit_code\n\nif __name__ == \"__main__\":\n    from typing import Optional, List\n    sys.exit(main())\n\n```\n```toml\n# pyproject.toml\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[project]\nname = \"intersperse-pkg\"\nversion = \"0.1.0\"\nauthors = [\n  { name=\"Your Name\", email=\"your.email@example.com\" },\n]\ndescription = \"A small Python library to intersperse a delimiter into an integer list.\"\nreadme = \"README.md\"\nrequires-python = \">=3.9\"\nclassifiers = [\n    \"Programming Language :: Python :: 3\",\n    \"License :: OSI Approved :: MIT License\",\n    \"Operating System :: OS Independent\",\n    \"Intended Audience :: Developers\",\n    \"Topic :: Software Development :: Libraries :: Python Modules\",\n]\n\n[project.urls]\nHomepage = \"https://github.com/yourusername/intersperse-pkg\" # Replace with actual repo\n\"Bug Tracker\" = \"https://github.com/yourusername/intersperse-pkg/issues\" # Replace with actual repo\n\n[project.scripts]\nintersperse = \"intersperse_pkg.cli:main\"\n\n[tool.setuptools.packages.find]\nwhere = [\"src\"]\n```\n```markdown\n# README.md\n# Intersperse Package\n\nA small, well-tested, and reusable Python library that inserts a delimiter integer between every two consecutive elements of an integer list. It also provides a simple command-line interface (CLI) for convenience.\n\n## 1. Installation\n\nYou can install this package using pip:\n\n```bash\npip install intersperse-pkg\n```\n\nIf you want to install from source for development:\n\n```bash\ngit clone https://github.com/yourusername/intersperse-pkg.git # Replace with actual repo\ncd intersperse-pkg\npip install .\n```\n\n## 2. Usage\n\n### 2.1. Programmatic API\n\nYou can import and use the `intersperse` function directly in your Python code:\n\n```python\nfrom intersperse_pkg import intersperse, InvalidInputError\n\n# Example 1: Basic usage\nnumbers = [1, 2, 3]\ndelimiter = 4\nresult = intersperse(numbers, delimiter)\nprint(f\"Result: {result}\") # Output: Result: [1, 4, 2, 4, 3]\n\n# Example 2: Empty list\nnumbers = []\ndelimiter = 99\nresult = intersperse(numbers, delimiter)\nprint(f\"Result for empty list: {result}\") # Output: Result for empty list: []\n\n# Example 3: Single element list\nnumbers = [5]\ndelimiter = 0\nresult = intersperse(numbers, delimiter)\nprint(f\"Result for single element list: {result}\") # Output: Result for single element list: [5]\n\n# Example 4: Error handling\ntry:\n    intersperse([1, \"a\", 3], 4)\nexcept InvalidInputError as e:\n    print(f\"Error: {e}\") # Output: Error: Element at index 1 is not an integer: 'a'.\n\ntry:\n    intersperse([1, 2], \"not_an_int\")\nexcept InvalidInputError as e:\n    print(f\"Error: {e}\") # Output: Error: Delimiter string is not a valid integer.\n```\n\n### 2.2. Command-Line Interface (CLI)\n\nThe package provides a `intersperse` command-line tool.\n\n```bash\n# Get help\nintersperse --help\n```\n\n#### Basic Usage\n\nTo intersperse numbers provided inline:\n\n```bash\nintersperse --numbers \"1,2,3\" --delimiter 4\n# Output:\n# [\n#     1,\n#     4,\n#     2,\n#     4,\n#     3\n# ]\n```\n\n#### Using an Input File\n\nCreate an `input.json` file:\n```json\n[10, 20, 30, 40]\n```\n\nThen run the command:\n\n```bash\nintersperse --input-file input.json --delimiter 5\n# Output:\n# [\n#     10,\n#     5,\n#     20,\n#     5,\n#     30,\n#     5,\n#     40\n# ]\n```\n\n#### Writing Output to a File\n\nYou can direct the output to a JSON file instead of stdout:\n\n```bash\nintersperse --numbers \"1,2,3\" --delimiter 4 --output-file output.json\n```\nThis will create an `output.json` file with the result.\n\n#### Error Handling in CLI\n\nInvalid inputs will result in an error message and a non-zero exit code:\n\n```bash\nintersperse --numbers \"1,a,3\" --delimiter 4\n# Error: Element at index 1 is not an integer: 'a'.\n```\n\n```bash\nintersperse --input-file non_existent.json --delimiter 7\n# Error: Input file not found: 'non_existent.json'.\n```\n\n## 3. Development\n\n### Project Structure\n\n```\n.\n\u251c\u2500\u2500 src/\n\u2502   \u2514\u2500\u2500 intersperse_pkg/\n\u2502       \u251c\u2500\u2500 __init__.py\n\u2502       \u251c\u2500\u2500 models.py\n\u2502       \u251c\u2500\u2500 exceptions.py\n\u2502       \u251c\u2500\u2500 validators.py\n\u2502       \u251c\u2500\u2500 services.py\n\u2502       \u251c\u2500\u2500 repositories.py\n\u2502       \u251c\u2500\u2500 utils.py\n\u2502       \u251c\u2500\u2500 controllers.py\n\u2502       \u2514\u2500\u2500 cli.py\n\u251c\u2500\u2500 tests/\n\u2502   \u251c\u2500\u2500 test_services.py\n\u2502   \u251c\u2500\u2500 test_validators.py\n\u2502   \u2514\u2500\u2500 test_cli.py\n\u251c\u2500\u2500 pyproject.toml\n\u251c\u2500\u2500 README.md\n\u2514\u2500\u2500 .github/\n    \u2514\u2500\u2500 workflows/\n        \u2514\u2500\u2500 ci.yml\n```\n\n### Running Tests\n\nTo run the unit and integration tests:\n\n```bash\npip install pytest pytest-cov\npytest --cov=src/intersperse_pkg tests/\n```\n\n### Code Style\n\nThis project follows standard Python best practices and uses type hinting.\n\n## 4. Contributing\n\nContributions are welcome! Please feel free to open issues or submit pull requests.\n\n## 5. License\n\nThis project is licensed under the MIT License. See the LICENSE file for details. (Note: LICENSE file is not generated here but would be part of a full project.)\n\n```\n```yml\n# .github/workflows/ci.yml\nname: Python CI\n\non:\n  push:\n    branches: [ \"main\" ]\n  pull_request:\n    branches: [ \"main\" ]\n\njobs:\n  build:\n    runs-on: ubuntu-latest\n    strategy:\n      matrix:\n        python-version: [\"3.9\", \"3.10\", \"3.11\", \"3.12\"]\n\n    steps:\n    - uses: actions/checkout@v4\n    - name: Set up Python ${{ matrix.python-version }}\n      uses: actio