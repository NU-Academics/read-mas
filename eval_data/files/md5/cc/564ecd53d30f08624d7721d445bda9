", \"utility\", \"strlen\", \"cli\", \"api\"]\nclassifiers = [\n    \"Programming Language :: Python :: 3\",\n    \"License :: OSI Approved :: MIT License\",\n    \"Operating System :: OS Independent\",\n    \"Development Status :: 3 - Alpha\",\n    \"Intended Audience :: Developers\",\n    \"Topic :: Software Development :: Libraries :: Python Modules\",\n    \"Topic :: Utilities\",\n]\n\n[project.dependencies]\npython = \">=3.8\"\n\n[project.optional-dependencies]\napi = [\n    \"fastapi>=0.100.0\", # Using 0.100+ as it's common now\n    \"uvicorn>=0.23.0\", # Uvicorn for ASGI server\n    \"pydantic>=2.0.0\", # FastAPI's dependency for data validation\n]\n\n[project.scripts]\nstrutils = \"strutils.cli:main\"\n\n[build-system]\nrequires = [\"poetry-core>=1.0.0\"]\nbuild-backend = \"poetry.core.masonry.api\"\n\n[tool.poetry]\nname = \"strutils\"\nversion = \"0.1.0\"\ndescription = \"A small, well-tested Python utility to compute string length.\"\nauthors = [\"Your Name <your.email@example.com>\"]\nlicense = \"MIT\"\nreadme = \"README.md\"\npackages = [{ include = \"src/strutils\", from = \"src\" }]\n\n[tool.poetry.dependencies]\npython = \">=3.8\"\n\n[tool.poetry.group.dev.dependencies]\npytest = \"^7.0\"\npytest-cov = \"^4.0\"\nmypy = \"^1.0\"\nflake8 = \"^6.0\"\nblack = \"^23.0\"\nisort = \"^5.0\"\npre-commit = \"^3.0\"\n# For mocking in tests\npytest-mock = \"^3.0\"\n\n[tool.poetry.group.api.dependencies]\nfastapi = { version = \">=0.100.0\", optional = true }\nuvicorn = { version = \">=0.23.0\", extras = [\"standard\"], optional = true }\npydantic = { version = \">=2.0.0\", optional = true }\n\n[tool.poetry.scripts]\nstrutils = \"strutils.cli:main\"\n\n```\n```txt\n# requirements.txt\n# This file lists minimal runtime dependencies.\n# For full development or optional API dependencies, refer to pyproject.toml.\n\npython>=3.8\n\n# For [api] optional extra, you would install these:\n# fastapi>=0.100.0\n# uvicorn[standard]>=0.23.0\n# pydantic>=2.0.0\n```\n```markdown\n# README.md\n# Strutils\n\nA small, well-tested, and reusable Python utility library to compute the length of a string (strlen). It provides a library API, a command-line interface (CLI), and an optional HTTP API adapter.\n\n## Features\n\n-   **Core `strlen` function**: Computes the number of Unicode code points in a string.\n-   **Service Layer**: Wraps core logic with validation and business rules.\n-   **CLI**: Easily compute string length from your shell.\n-   **HTTP Adapter (Optional)**: Embed in web services with a FastAPI endpoint.\n-   **Packaging**: Pip installable with `pyproject.toml` and optional extras.\n-   **Robust Error Handling**: Clear, typed exceptions for invalid inputs.\n-   **Tested**: Comprehensive unit tests with high coverage.\n\n## Installation\n\nYou can install `strutils` using pip:\n\n```bash\npip install strutils\n```\n\nTo include the optional HTTP API adapter (which requires FastAPI and Uvicorn):\n\n```bash\npip install \"strutils[api]\"\n```\n\n## Usage\n\n### Library API\n\n```python\nfrom strutils import strlen, StringService, Validator, StringDTO, InvalidStringError, ValidationError\n\n# Using the core strlen function\nprint(f\"Length of 'hello': {strlen('hello')}\") # Output: 5\nprint(f\"Length of 'h\u00e9llo\ud83d\ude00': {strlen('h\u00e9llo\ud83d\ude00')}\") # Output: 6\n\ntry:\n    strlen(123) # This will raise an error\nexcept InvalidStringError as e:\n    print(f\"Error: {e}\")\n\n# Using the StringService for more robust validation\nvalidator = Validator()\nservice = StringService(validator)\n\nprint(f\"Service length of 'world': {service.length('world')}\") # Output: 5\nprint(f\"Service length of bytes b'bytes': {service.length(b'bytes')}\") # Output: 5 (bytes are decoded)\n\ntry:\n    service.length(None) # This will raise an error\nexcept ValidationError as e:\n    print(f\"Error: {e}\")\n\n# Using StringDTO with StringService\ndto = StringDTO(\"data_transfer_object\")\nprint(f\"Service length from DTO: {service.length_from_dto(dto)}\") # Output: 20\n```\n\n### Command-Line Interface (CLI)\n\nAfter installation, you can use the `strutils` command:\n\n```bash\n# Compute length of a string\nstrutils strlen \"hello from CLI\"\n# Output: 14\n\n# Compute length of an empty string\nstrutils strlen \"\"\n# Output: 0\n\n# With Unicode characters\nstrutils strlen \"h\u00e9llo\ud83d\ude00CLI\"\n# Output: 9\n\n# Invalid usage (missing argument)\nstrutils strlen\n# Output:\n# Error: Missing string argument for 'strlen'.\n# Usage: strutils strlen \"<string>\"\n\n# Invalid command\nstrutils unknown_command \"test\"\n# Output:\n# Error: Unknown command 'unknown_command'.\n# Usage: strutils strlen \"<string>\"\n```\n\n### HTTP API (Optional)\n\nIf you installed with the `[api]` extra, you can run the HTTP service using Uvicorn:\n\n```bash\nuvicorn strutils.http_adapter:app --reload\n```\n\nThen, you can send POST requests to `/strlen`:\n\n```bash\n# Example using curl\ncurl -X POST -H \"Content-Type: application/json\" -d '{\"s\": \"api_test_string\"}' http://127.0.0.1:8000/strlen\n# Expected JSON output: {\"length\": 15}\n\n# Empty string\ncurl -X POST -H \"Content-Type: application/json\" -d '{\"s\": \"\"}' http://127.0.0.1:8000/strlen\n# Expected JSON output: {\"length\": 0}\n\n# Invalid input (missing 's' key)\ncurl -X POST -H \"Content-Type: application/json\" -d '{\"invalid_key\": \"value\"}' http://127.0.0.1:8000/strlen\n# Expected HTTP 422 Unprocessable Entity\n```\n\n## Development\n\n### Setup\n\n1.  **Clone the repository:**\n    ```bash\n    git clone https://github.com/your-username/strutils.git\n    cd strutils\n    ```\n2.  **Install dependencies using Poetry:**\n    ```bash\n    poetry install --with dev,api\n    ```\n    This will install both runtime and development dependencies, including FastAPI components.\n\n### Running Tests\n\n```bash\npoetry run pytest\n# For coverage report\npoetry run pytest --cov=src/strutils --cov-report=term-missing\n```\n\n### Linting and Formatting\n\n```bash\npoetry run black src tests examples\npoetry run isort src tests examples\npoetry run flake8 src tests examples\npoetry run mypy src\n```\n\nConsider setting up pre-commit hooks for automatic checks.\n\n## License\n\nThis project is licensed under the MIT License - see the [LICENSE](LICENSE) file for details.\n\n```\n```txt\n# LICENSE\nMIT License\n\nCopyright (c) 2023 Your Name\n\nPermission is hereby granted, free of charge, to any person obtaining a copy\nof this software and associated documentation files (the \"Software\"), to deal\nin the Software without restriction, including without limitation the rights\nto use, copy, modify, merge, publish, distribute, sublicense, and/or sell\ncopies of the Software, and to permit persons to whom the Software is\nfurnished to do so, subject to the following conditions:\n\nThe above copyright notice and this permission notice shall be included in all\ncopies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\nIMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\nFITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\nAUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\nLIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\nOUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\nSOFTWARE.\n\n```"}
{"task_id": "HumanEval/24", "solution": "To generate the complete executable code based on the provided software design specification, we will create the specified file structure and implement each class and function as described.\n\nHere's the code, organized by file:\n\n```python\n# src/largest_divisor_app/__init__.py\n\"\"\"\nLargest Divisor App: A library and tool for computing the largest proper divisor of an integer.\n\"\"\"\n__version__ = \"0.1.0\"\n```\n\n```python\n# src/largest_divisor_app/models.py\nimport uuid\nfrom datetime import datetime\n\nclass NumberModel:\n    \"\"\"\n    Data Transfer Object (DTO) for a persisted calculation record.\n    Represents a record of an input number, its largest proper divisor,\n    and the timestamp of the calculation.\n    \"\"\"\n    def __init__(self, id: str, n: int, largest_divisor: int, timestamp: str):\n        self.id = id\n        self.n = n\n        self.largest_divisor = largest_divisor\n        self.timestamp = timestamp\n\n    def to_dict(self) -> dict:\n        \"\"\"Returns a serializable dictionary representation of the model.\"\"\"\n        return {\n            \"id\": self.id,\n            \"n\": self.n,\n            \"largest_divisor\": self.largest_divisor,\n            \"timestamp\": self.timestamp,\n        }\n\n    @staticmethod\n    def from_dict(d: dict) -> \"NumberModel\":\n        \"\"\"Creates a NumberModel instance from a dictionary.\"\"\"\n        return NumberModel(\n            id=d[\"id\"],\n            n=d[\"n\"],\n            largest_divisor=d[\"largest_divisor\"],\n            timestamp=d[\"timestamp\"],\n        )\n\n```\n\n```python\n# src/largest_divisor_app/exceptions.py\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input values.\"\"\"\n    pass\n\nclass PersistenceError(Exception):\n    \"\"\"Exception raised for errors during data persistence operations.\"\"\"\n    pass\n\n```\n\n```python\n# src/largest_divisor_app/validator.py\nfrom largest_divisor_app.exceptions import ValidationError\n\nclass NumberValidator:\n    \"\"\"Validates integer inputs according to business rules.\"\"\"\n\n    @staticmethod\n    def validate(n: int) -> None:\n        \"\"\"\n        Validates that n is an integer and greater than 1.\n        Raises ValidationError if validation fails.\n        \"\"\"\n        if not isinstance(n, int):\n            raise ValidationError(f\"Input must be an integer, got type {type(n).__name__}.\")\n        if n <= 1:\n            raise ValidationError(\"Input number must be greater than 1.\")\n\n```\n\n```python\n# src/largest_divisor_app/utils.py\nimport math\n\nclass MathUtils:\n    \"\"\"Provides mathematical utility functions, specifically for divisor computation.\"\"\"\n\n    @staticmethod\n    def largest_proper_divisor(n: int) -> int:\n        \"\"\"\n        Computes the largest proper divisor for a given integer n.\n        A proper divisor d of n satisfies d < n and n % d == 0.\n        \"\"\"\n        if n <= 1:\n            # Although validator should catch this, defensive check for direct calls.\n            raise ValueError(\"n must be greater than 1 to have a proper divisor.\")\n\n        # For even numbers, n/2 is always the largest proper divisor.\n        if n % 2 == 0:\n            return n // 2\n\n        largest_found = 1\n        # Search for divisors from 3 up to sqrt(n), checking only odd numbers.\n        # If n is a prime, the loop completes without finding factors, returning 1.\n        limit = int(math.isqrt(n))\n        for i in range(3, limit + 1, 2):\n            if n % i == 0:\n                # If i divides n, then n // i also divides n.\n                # The largest proper divisor will be the largest of these pairs.\n                # Since i is increasing, n // i is decreasing.\n                # The largest divisor we care about is n // i, as it's closer to n.\n                return n // i # This optimization finds the smallest factor and returns its pair.\n\n        # If no factors were found other than 1 and n, the number is prime.\n        # The largest proper divisor of a prime number is 1.\n        return largest_found\n\n```\n\n```python\n# src/largest_divisor_app/repository.py\nimport json\nimport os\nfrom typing import List, Optional\nfrom largest_divisor_app.models import NumberModel\nfrom largest_divisor_app.exceptions import PersistenceError\n\nDEFAULT_STORAGE_PATH: str = os.environ.get(\n    \"LARGEST_DIVISOR_HISTORY_PATH\", \"./largest_divisor_history.jsonl\"\n)\n\nclass NumberRepository:\n    \"\"\"\n    Persistence adapter for NumberModel records, storing them in a JSON Lines file.\n    Each record is appended as a new JSON object on a new line.\n    \"\"\"\n    def __init__(self, storage_path: str = DEFAULT_STORAGE_PATH):\n        self._storage_path = storage_path\n        # Ensure the directory for the storage file exists\n        os.makedirs(os.path.dirname(self._storage_path) or '.', exist_ok=True)\n\n    def save(self, record: NumberModel) -> None:\n        \"\"\"\n        Appends a NumberModel record to the storage file.\n        Each record is written as a JSON line and flushed to disk.\n        \"\"\"\n        try:\n            with open(self._storage_path, \"a\", encoding=\"utf-8\") as f:\n                f.write(json.dumps(record.to_dict(), ensure_ascii=False) + \"\\n\")\n                f.flush() # Ensure data is written to the OS buffer\n                os.fsync(f.fileno()) # Force OS to write buffers to disk\n        except OSError as exc:\n            raise PersistenceError(f\"Failed to save record to {self._storage_path}: {exc}\") from exc\n        except TypeError as exc:\n            raise PersistenceError(f\"Failed to serialize record: {exc}\") from exc\n\n    def list(self, limit: Optional[int] = None) -> List[NumberModel]:\n        \"\"\"\n        Reads and returns a list of NumberModel records from the storage file.\n        Returns records in the order they were saved.\n        \"\"\"\n        records: List[NumberModel] = []\n        try:\n            if not os.path.exists(self._storage_path):\n                return []\n\n            with open(self._storage_path, \"r\", encoding=\"utf-8\") as f:\n                for line in f:\n                    try:\n                        data = json.loads(line)\n                        records.append(NumberModel.from_dict(data))\n                        if limit is not None and len(records) >= limit:\n                            break\n                    except json.JSONDecodeError as exc:\n                        # Log error for malformed lines but continue\n                        print(f\"Warning: Skipping malformed history record: {line.strip()} - {exc}\", file=os.sys.stderr)\n        except OSError as exc:\n            raise PersistenceError(f\"Failed to read records from {self._storage_path}: {exc}\") from exc\n        return records\n\n```\n\n```python\n# src/largest_divisor_app/services.py\nimport uuid\nfrom datetime import datetime\nfrom largest_divisor_app.models import NumberModel\nfrom largest_divisor_app.repository import NumberRepository\nfrom largest_divisor_app.validator import NumberValidator\nfrom largest_divisor_app.utils import MathUtils\nfrom largest_divisor_app.exceptions import ValidationError, PersistenceError\n\nclass DivisorService:\n    \"\"\"\n    Core business logic service for computing largest proper divisors.\n    Orchestrates validation, computation, and persistence of calculation history.\n    \"\"\"\n    def __init__(self, repo: NumberRepository, validator: NumberValidator):\n        self._repo = repo\n        self._validator = validator\n\n    def calculate(self, n: int) -> int:\n        \"\"\"\n        Validates the input number, computes its largest proper divisor,\n        persists the calculation record, and returns the divisor.\n        \"\"\"\n        # 1. Validate n\n        self._validator.validate(n)\n\n        # 2. Compute largest divisor\n        d = MathUtils.largest_proper_divisor(n)\n\n        # 3. Create and persist NumberModel record\n        # Use UTC for timestamps for consistency\n        timestamp = datetime.utcnow().isoformat(timespec='seconds') + \"Z\"\n        record = NumberModel(\n            id=str(uuid.uuid4()),\n            n=n,\n            largest_divisor=d,\n            timestamp=timestamp\n        )\n        try:\n            self._repo.save(record)\n        except PersistenceError as exc:\n            # Log error but still return calculation result as per design\n            print(f\"Error persisting calculation history for n={n}: {exc}\", file=os.sys.stderr)\n            raise # Re-raise after logging as per default behavior specified in FR5 error handling.\n\n        # 4. Return the computed divisor\n        return d\n\n```\n\n```python\n# src/largest_divisor_app/controllers_cli.py\nfrom largest_divisor_app.services import DivisorService\nfrom largest_divisor_app.exceptions import ValidationError\n\nclass CLIController:\n    \"\"\"\n    Handles CLI-specific input parsing and output formatting.\n    Delegates core logic to DivisorService.\n    \"\"\"\n    def __init__(self, service: DivisorService):\n        self._service = service\n\n    def handle(self, n_str: str) -> int:\n        \"\"\"\n        Parses the string input from CLI, converts it to an integer,\n        calls the DivisorService, and returns the result.\n        \"\"\"\n        try:\n            n = int(n_str)\n        except ValueError:\n            raise ValidationError(f\"Invalid input: '{n_str}' is not a valid integer.\")\n\n        return self._service.calculate(n)\n\n```\n\n```python\n# src/largest_divisor_app/controllers_api.py\nfrom largest_divisor_app.services import DivisorService\nfrom largest_divisor_app.exceptions import ValidationError\n\nclass APIController:\n    \"\"\"\n    Handles API-specific input parsing and output formatting.\n    Delegates core logic to DivisorService and prepares JSON responses.\n    \"\"\"\n    def __init__(self, service: DivisorService):\n        self._service = service\n\n    def get_largest_divisor(self, n_str: str) -> dict:\n        \"\"\"\n        Parses the string input from an API request, converts to integer,\n        calls the DivisorService, and formats the result as a dictionary\n        suitable for JSON response.\n        \"\"\"\n        try:\n            n = int(n_str)\n        except ValueError:\n            raise ValidationError(f\"Invalid input: '{n_str}' is not a valid integer.\")\n\n        d = self._service.calculate(n)\n        return {\"n\": n, \"largest_divisor\": d}\n\n```\n\n```python\n# src/largest_divisor_app/api.py\nfrom fastapi import FastAPI, HTTPException, status\nfrom largest_divisor_app.services import DivisorService\nfrom largest_divisor_app.controllers_api import APIController\nfrom largest_divisor_app.exceptions import ValidationError, PersistenceError\n\ndef create_app(service: DivisorService) -> FastAPI:\n    \"\"\"\n    Creates and configures a FastAPI application instance.\n    Wires up APIController to handle HTTP requests.\n    \"\"\"\n    app = FastAPI(\n        title=\"Largest Proper Divisor API\",\n        description=\"API for computing the largest proper divisor of an integer and logging history.\",\n        version=\"0.1.0\"\n    )\n    api_controller = APIController(service)\n\n    @app.get(\"/largest-divisor\", response_model=dict)\n    async def get_largest_divisor_endpoint(n: str):\n        \"\"\"\n        Computes the largest proper divisor for a given integer `n`.\n        Query parameter `n` must be an integer greater than 1.\n        \"\"\"\n        try:\n            result = api_controller.get_largest_divisor(n)\n            return result\n        except ValidationError as e:\n            raise HTTPException(\n                status_code=status.HTTP_400_BAD_REQUEST,\n                detail={\"error\": str(e)}\n            ) from e\n        except PersistenceError as e:\n            raise HTTPException(\n                status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,\n                detail={\"error\": f\"Internal server error: {e}\"}\n            ) from e\n        except Exception as e:\n            raise HTTPException(\n                status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,\n                detail={\"error\": f\"An unexpected error occurred: {e}\"}\n            ) from e\n\n    return app\n\n# Example of how to run the API (for local testing, not part of the library itself):\n# if __name__ == \"__main__\":\n#     import uvicorn\n#     from largest_divisor_app.repository import NumberRepository\n#     from largest_divisor_app.validator import NumberValidator\n#\n#     # Initialize dependencies for the API\n#     repo = NumberRepository()\n#     validator = NumberValidator()\n#     service = DivisorService(repo, validator)\n#     fastapi_app = create_app(service)\n#\n#     # Run with uvicorn\n#     # uvicorn.run(fastapi_app, host=\"0.0.0.0\", port=8000)\n#     print(\"To run the API, uncomment the uvicorn.run line and ensure FastAPI/uvicorn are installed.\")\n#     print(\"Example: uvicorn largest_divisor_app.api:create_app --reload --factory\")\n\n```\n\n```python\n# src/largest_divisor_app/cli.py\nimport argparse\nimport sys\nimport os\n\nfrom largest_divisor_app.repository import NumberRepository, DEFAULT_STORAGE_PATH\nfrom largest_divisor_app.validator import NumberValidator\nfrom largest_divisor_app.services import DivisorService\nfrom largest_divisor_app.controllers_cli import CLIController\nfrom largest_divisor_app.exceptions import ValidationError, PersistenceError\n\nclass CLIApp:\n    \"\"\"\n    Entrypoint for the command-line interface application.\n    Orchestrates dependency injection and command execution.\n    \"\"\"\n    def __init__(self, controller: CLIController):\n        self._controller = controller\n\n    def main(self, argv=None) -> int:\n        \"\"\"\n        Main function for the CLI. Parses arguments, handles requests,\n        and manages error output and exit codes.\n        \"\"\"\n        parser = argparse.ArgumentParser(\n            prog=\"largest-divisor\",\n            description=\"Compute the largest proper divisor of a positive integer.\"\n        )\n        parser.add_argument(\n            \"n\",\n            type=str,\n            help=\"The positive integer (n > 1) for which to find the largest proper divisor.\"\n        )\n        args = parser.parse_args(argv)\n\n        try:\n            result = self._controller.handle(args.n)\n            print(result)\n            return 0  # Success exit code\n        except ValidationError as e:\n            print(f\"Error: {e}\", file=sys.stderr)\n            return 2  # Validation error exit code\n        except PersistenceError as e:\n            print(f\"Error: {e}\", file=sys.stderr)\n            return 3  # Persistence error exit code\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1  # Generic error exit code\n\ndef main_cli_entrypoint(argv=None) -> int:\n    \"\"\"\n    Function to serve as the console_script entry point.\n    Initializes all necessary components and runs the CLIApp.\n    \"\"\"\n    # Initialize dependencies\n    # The default storage path can be overridden by an environment variable.\n    repo = NumberRepository(storage_path=DEFAULT_STORAGE_PATH)\n    validator = NumberValidator()\n    service = DivisorService(repo, validator)\n    controller = CLIController(service)\n\n    app = CLIApp(controller)\n    return app.main(argv)\n\nif __name__ == \"__main__\":\n    sys.exit(main_cli_entrypoint())\n```"}
{"task_id": "HumanEval/25", "solution": "```python\nfrom typing import List\n\n\ndef factorize(n: int) -> List[int]:\n    \"\"\"Return prime factors of n as an ordered list, repeating factors by multiplicity.\n    Assumes n is a positive integer (n >= 1).\n    \"\"\"\n    factors: List[int] = []\n\n    if n == 1:\n        return []\n\n    # Handle factor 2\n    while n % 2 == 0:\n        factors.append(2)\n        n //= 2\n\n    # Handle factor 3\n    while n % 3 == 0:\n        factors.append(3)\n        n //= 3\n\n    # Handle factors from 5 onwards using 6k +/- 1 optimization.\n    # Primes greater than 3 can be expressed in the form 6k \u00b1 1.\n    i = 5\n    while i * i <= n:\n        while n % i == 0:\n            factors.append(i)\n            n //= i\n        while n % (i + 2) == 0:\n            factors.append(i + 2)\n            n //= (i + 2)\n        i += 6\n\n    # If n is still greater than 1, it must be a prime factor itself.\n    if n > 1:\n        factors.append(n)\n\n    return factors\n```"}
