ile)\n        with open(tmp_persistence_file, \"r\") as f:\n            lines = f.readlines()\n            assert len(lines) == 1\n            record = json.loads(lines[0])\n            assert record[\"input_len\"] == 3\n            assert record[\"result\"] == [10, 20]\n            assert \"timestamp\" in record\n\n    def test_post_filter_persistence_multiple_runs_append(self, client, tmp_persistence_file):\n        \"\"\"Should append results for multiple runs.\"\"\"\n        client.post(\"/filter\", json={\"values\": [1]})\n        client.post(\"/filter\", json={\"values\": [2]})\n\n        with open(tmp_persistence_file, \"r\") as f:\n            lines = f.readlines()\n            assert len(lines) == 2\n            record1 = json.loads(lines[0])\n            record2 = json.loads(lines[1])\n            assert record1[\"result\"] == [1]\n            assert record2[\"result\"] == [2]\n\n    def test_post_filter_body_size_limit(self, mock_filter_service, tmp_path):\n        \"\"\"Should return 413 Payload Too Large if body exceeds limit.\"\"\"\n        mock_repo = FileRepository(path=tmp_path / \"repo.json\", append=True)\n        # Set a very small max_body_size for this test\n        api_server_small_body = ApiServer(service=mock_filter_service, repo=mock_repo, max_body_size=10)\n        client_small_body = TestClient(api_server_small_body.create_app())\n\n        large_payload = {\"values\": list(range(100))} # This will be > 10 bytes\n        response = client_small_body.post(\"/filter\", json=large_payload)\n        assert response.status_code == 413\n        assert \"Request body too large\" in response.json()[\"detail\"]\n\n    def test_post_filter_internal_server_error(self, mock_file_repository):\n        \"\"\"Should return 500 Internal Server Error for unexpected exceptions in service.\"\"\"\n        # Create a FilterService that always raises an unexpected error\n        class FaultyFilterService(FilterService):\n            def filter_integers(self, v