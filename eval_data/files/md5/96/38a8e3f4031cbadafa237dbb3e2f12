{"task_id": "Mbpp/427", "solution": "import re\n\nclass InvalidDateFormatError(ValueError):\n    \"\"\"Custom exception for invalid date format errors.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\ndef change_date_format(date_string: str) -> str:\n    \"\"\"\n    Converts a date string from YYYY-MM-DD format to DD-MM-YYYY format.\n\n    Args:\n        date_string: The input date string in YYYY-MM-DD format.\n\n    Returns:\n        The converted date string in DD-MM-YYYY format.\n\n    Raises:\n        InvalidDateFormatError: If the input date_string does not conform\n                                to the YYYY-MM-DD format.\n    \"\"\"\n    match = re.fullmatch(r\"(\\d{4})-(\\d{2})-(\\d{2})\", date_string)\n    if not match:\n        raise InvalidDateFormatError(\n            f\"Date string '{date_string}' does not match 'YYYY-MM-DD' format.\"\n        )\n    year, month, day = match.groups()\n    return f\"{day}-{month}-{year}\""}
