{"task_id": "Mbpp/721", "solution": "```python\nclass Matrix:\n    \"\"\"Represents the input square matrix and provides cell cost access.\"\"\"\n    def __init__(self, data: list[list[int]]) -> None:\n        self.data = data\n        self.size = len(data)\n\n    def get_cost(self, row: int, col: int) -> int:\n        \"\"\"Returns the cost of the cell at (row, col).\"\"\"\n        return self.data[row][col]\n\n\nclass Path:\n    \"\"\"Represents a single path, storing its cells, total cost, and average cost.\"\"\"\n    def __init__(self, initial_cost: int = 0, initial_cell: tuple[int, int] = None) -> None:\n        self.cells: list[tuple[int, int]] = []\n        self.total_cost: int = initial_cost\n        self.num_cells: int = 0\n        self.average_cost: float = 0.0\n        if initial_cell:\n            self.add_cell(initial_cell[0], initial_cell[1], initial_cost)\n\n    def add_cell(self, row: int, col: int, cost: int) -> None:\n        \"\"\"Adds a new cell to the path and updates its total cost and cell count.\"\"\"\n        self.cells.append((row, col))\n        self.total_cost += cost\n        self.num_cells += 1\n\n    def calculate_average(self) -> None:\n        \"\"\"Computes the average cost of the path.\"\"\"\n        if self.num_cells > 0:\n            self.average_cost = self.total_cost / self.num_cells\n        else:\n            self.average_cost = 0.0\n\n    def clone(self) -> 'Path':\n        \"\"\"Creates a deep copy of the current path instance.\"\"\"\n        new_path = Path()\n        new_path.cells = list(self.cells)\n        new_path.total_cost = self.total_cost\n        new_path.num_cells = self.num_cells\n        new_path.average_cost = self.average_cost\n        return new_path\n\n\nclass PathFinderService:\n    \"\"\"Orchestrates finding all paths, calculating averages, and determining the maximum average.\"\"\"\n    def find_max_average_path(self, matrix_data: list[list[int]]) -> float:\n        n = len(matrix_data)\n        if n == 0:\n            return 0.0\n\n        matrix = Matrix(matrix_data)\n        all_paths: list[Path] = []\n\n        # Start recursive search from (0,0)\n        initial_path = Path(initial_cost=matrix.get_cost(0, 0), initial_cell=(0, 0))\n        self._find_paths_recursive(matrix, 0, 0, initial_path, all_paths)\n\n        if not all_paths:\n            return 0.0\n\n        max_average = 0.0\n        for path in all_paths:\n            path.calculate_average()\n            if path.average_cost > max_average:\n                max_average = path.average_cost\n        \n        return round(max_average, 2)\n\n    def _find_paths_recursive(self, matrix: Matrix, row: int, col: int, current_path: Path, all_paths: list[Path]) -> None:\n        \"\"\"Recursive helper method to explore all possible paths.\"\"\"\n        n = matrix.size\n\n        # Base case: Reached the bottom-right cell\n        if row == n - 1 and col == n - 1:\n            all_paths.append(current_path)\n            return\n\n        # Move right\n        if col + 1 < n:\n            next_path_right = current_path.clone()\n            next_path_right.add_cell(row, col + 1, matrix.get_cost(row, col + 1))\n            self._find_paths_recursive(matrix, row, col + 1, next_path_right, all_paths)\n\n        # Move down\n        if row + 1 < n:\n            next_path_down = current_path.clone()\n            next_path_down.add_cell(row + 1, col, matrix.get_cost(row + 1, col))\n            self._find_paths_recursive(matrix, row + 1, col, next_path_down, all_paths)\n\n\ndef maxAverageOfPath(matrix_data: list[list[int]]) -> float:\n    \"\"\"\n    Finds the path with the maximum average cost in a given square matrix.\n    Paths start at top-left, end at bottom-right, moving only right or down.\n    \"\"\"\n    service = PathFinderService()\n    return service.find_max_average_path(matrix_data)\n```"}
{"task_id": "Mbpp/721", "solution": "```python\ndef maxAverageOfPath(matrix: list[list[int]]) -> float:\n    \"\"\"\n    Finds the path with the maximum average cost in a square matrix.\n    Paths start top-left, end bottom-right, moving only right or down.\n    \"\"\"\n\n    class Matrix:\n        \"\"\"Represents the square cost matrix.\"\"\"\n        def __init__(self, grid: list[list[int]]):\n            self._grid = grid\n            self.size = len(grid)\n\n        def get_cell_cost(self, row: int, col: int) -> int:\n            return self._grid[row][col]\n\n    class PathFinderService:\n        \"\"\"Encapsulates the core algorithm for pathfinding.\"\"\"\n        def find_max_average_path(self, matrix_data: list[list[int]]) -> float:\n            matrix = Matrix(matrix_data)\n            n = matrix.size\n            memo = {}  # Cache for subproblem (r, c) -> (max_sum, path_count).\n\n            path_length = 2 * n - 1\n            max_total_cost, _ = self._find_paths_recursive(matrix, 0, 0, memo)\n\n            return max_total_cost / path_length\n\n        def _find_paths_recursive(self, matrix: Matrix, r: int, c: int, memo: dict) -> tuple[int, int]:\n            \"\"\"Recursively finds max sum and count from (r, c) to bottom-right.\"\"\"\n            n = matrix.size\n            if (r, c) in memo:\n                return memo[(r, c)]\n\n            if r == n - 1 and c == n - 1:\n                return (matrix.get_cell_cost(r, c), 1)\n\n            current_cost = matrix.get_cell_cost(r, c)\n            max_sum_from_here = -float('inf')\n            num_cells_from_here = 0\n\n            if c + 1 < n:  # Can move right\n                right_sum, right_count = self._find_paths_recursive(matrix, r, c + 1, memo)\n                if current_cost + right_sum > max_sum_from_here:\n                    max_sum_from_here = current_cost + right_sum\n                    num_cells_from_here = 1 + right_count\n\n            if r + 1 < n:  # Can move down\n                down_sum, down_count = self._find_paths_recursive(matrix, r + 1, c, memo)\n                if current_cost + down_sum > max_sum_from_here:\n                    max_sum_from_here = current_cost + down_sum\n                    num_cells_from_here = 1 + down_count\n\n            memo[(r, c)] = (max_sum_from_here, num_cells_from_here)\n            return max_sum_from_here, num_cells_from_here\n\n    class MatrixController:\n        \"\"\"Orchestrates the pathfinding service.\"\"\"\n        def __init__(self, path_finder_service: PathFinderService):\n            self._path_finder_service = path_finder_service\n\n        def max_average_of_path(self, matrix_data: list[list[int]]) -> float:\n            # Input validation is omitted as per critical requirements.\n            max_avg = self._path_finder_service.find_max_average_path(matrix_data)\n            return max_avg\n\n    path_finder_service = PathFinderService()\n    controller = MatrixController(path_finder_service)\n    return controller.max_average_of_path(matrix)\n```"}
