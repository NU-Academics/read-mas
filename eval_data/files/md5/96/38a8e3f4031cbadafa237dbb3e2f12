{"task_id": "Mbpp/781", "solution": "```python\nimport math\n\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input values.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\ndef count_divisors(number: int) -> bool:\n    \"\"\"\n    Checks whether the count of divisors for a given positive integer is even.\n\n    Args:\n        number: A positive integer.\n\n    Returns:\n        True if the count of divisors is even, False otherwise.\n\n    Raises:\n        InvalidInputError: If the input number is not a positive integer.\n    \"\"\"\n    if not isinstance(number, int) or number <= 0:\n        raise InvalidInputError(\"Input must be a positive integer.\")\n\n    count = 0\n    # Iterate from 1 up to the square root of 'number'\n    for i in range(1, int(math.sqrt(number)) + 1):\n        if number % i == 0:\n            # If 'i' is a divisor, then 'number / i' is also a divisor.\n            # If 'i * i == number', then 'i' and 'number / i' are the same,\n            # so we only count it once.\n            if i * i == number:\n                count += 1\n            else:\n                count += 2\n    \n    return count % 2 == 0\n\n```"}
{"task_id": "Mbpp/782", "solution": "```python\ndef odd_length_sum(nums: list[int]) -> int:\n    \"\"\"Calculates the sum of all odd-length subarrays for a given list of integers.\n    This optimized approach counts occurrences of each element in such subarrays.\"\"\"\n    total_sum = 0\n    n = len(nums)\n\n    for i in range(n):\n        # Calculate how many times nums[i] appears in an odd-length subarray.\n        # The number of subarrays containing nums[i] is (i + 1) * (n - i).\n        # Approximately half of these will be odd length, and half even.\n        occurrences = ((i + 1) * (n - i) + 1) // 2\n        total_sum += nums[i] * occurrences\n\n    return total_sum\n```"}
{"task_id": "Mbpp/782", "solution": "```python\nimport math\n\ndef odd_length_sum(nums: list[int]) -> int:\n    \"\"\"\n    Calculates the sum of all elements across all odd-length subarrays.\n    Each element's contribution is its value multiplied by the count of odd-length\n    subarrays it belongs to.\n    \"\"\"\n    total_sum = 0\n    n = len(nums)\n\n    for i in range(n):\n        # Calculate the number of odd-length subarrays containing nums[i].\n        # The product of (i + 1) and (n - i) gives the total number of subarrays that contain nums[i].\n        left_count = i + 1\n        right_count = n - i\n        \n        # Roughly half of these total subarrays will be of odd length.\n        # This count is accurately given by math.ceil(total_subarrays / 2.0).\n        odd_subarrays_count = math.ceil((left_count * right_count) / 2.0)\n        \n        total_sum += nums[i] * int(odd_subarrays_count)\n\n    return total_sum\n```"}
{"task_id": "Mbpp/784", "solution": "```python\ndef mul_even_odd(numbers: list[int | float]) -> int | float | None:\n    \"\"\"Finds the first even and first odd number in the given list and returns their product.\n    Returns None if either an even or an odd number is not found.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in numbers:\n        if num % 2 == 0 and first_even is None:\n            first_even = num\n        elif num % 2 != 0 and first_odd is None:\n            first_odd = num\n        \n        if first_even is not None and first_odd is not None:\n            break\n\n    if first_even is not None and first_odd is not None:\n        return first_even * first_odd\n    else:\n        return None\n```"}
{"task_id": "Mbpp/784", "solution": "```python\ndef mul_even_odd(numbers):\n    \"\"\"\n    Calculates the product of the first even and first odd number found in the list.\n    Returns None if either number is not found.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in numbers:\n        if num % 2 == 0:\n            first_even = num\n            break\n\n    for num in numbers:\n        if num % 2 != 0:\n            first_odd = num\n            break\n\n    if first_even is None or first_odd is None:\n        return None\n\n    return first_even * first_odd\n```"}
{"task_id": "Mbpp/785", "solution": "```python\ndef tuple_str_int(tuple_string: str) -> tuple[int, ...]:\n    \"\"\"\n    Converts a string representation of a tuple into an actual tuple of integers.\n    Assumes valid input format and convertible elements as per critical requirements.\n    \"\"\"\n    tuple_string = tuple_string.strip()\n\n    if tuple_string == \"()\":\n        return ()\n\n    content = tuple_string[1:-1].strip()\n    elements_str = content.split(',')\n\n    integer_elements = []\n    for element_str in elements_str:\n        integer_elements.append(int(element_str.strip()))\n\n    return tuple(integer_elements)\n```"}
{"task_id": "Mbpp/786", "solution": "```python\ndef right_insertion(sorted_list, value):\n    \"\"\"\n    Locates the right insertion point for a specified value in a sorted list.\n    This function finds the index where 'value' should be inserted to maintain sorted order, placing it after any existing equal elements.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if value < sorted_list[mid]:\n            high = mid\n        else:\n            low = mid + 1\n    return low\n```"}
{"task_id": "Mbpp/786", "solution": "```python\ndef right_insertion(sorted_list, value):\n    \"\"\"\n    Locates the index where 'value' should be inserted into 'sorted_list'\n    to maintain its sorted order using a binary search algorithm.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low\n```"}
{"task_id": "Mbpp/785", "solution": "```python\nimport ast\n\nclass InvalidTupleStringError(ValueError):\n    \"\"\"Custom exception for invalid tuple string formats.\"\"\"\n    pass\n\ndef tuple_str_int(tuple_string: str) -> tuple[int, ...]:\n    \"\"\"\n    Converts a string representation of a tuple of integers to an actual tuple of integers.\n\n    Args:\n        tuple_string: The string representing a tuple of integers (e.g., \"(7, 8, 9)\").\n\n    Returns:\n        A tuple of integers (e.g., (7, 8, 9)).\n\n    Raises:\n        InvalidTupleStringError: If the input string is not a valid tuple of integers.\n    \"\"\"\n    try:\n        # Safely evaluate the string as a Python literal\n        parsed_value = ast.literal_eval(tuple_string)\n\n        # Check if the evaluated value is a tuple\n        if not isinstance(parsed_value, tuple):\n            raise InvalidTupleStringError(\"Input string does not represent a tuple.\")\n\n        # Check if all elements in the tuple are integers\n        if not all(isinstance(item, int) for item in parsed_value):\n            raise InvalidTupleStringError(\"Tuple contains non-integer elements.\")\n\n        return parsed_value\n    except (ValueError, SyntaxError) as e:\n        # Catch errors from ast.literal_eval or other parsing issues\n        raise InvalidTupleStringError(f\"Invalid tuple string format: {e}\") from e\n```"}
