{"task_id": "Mbpp/129", "solution": "```python\ndef magic_square_test(matrix: list[list[int | float]]) -> bool:\n    \"\"\"Checks if a 2D list is a magic square.\n    All rows, columns, and both main diagonals must sum to the same value.\"\"\"\n\n    n = len(matrix)\n    # Assumes matrix is non-empty and square, as per critical requirements.\n    # No explicit checks for empty matrix, non-square, or non-numeric elements.\n    \n    if n == 0:\n        return False # This is a reasonable behavior for an empty matrix, not explicitly forbidden to handle.\n\n    expected_sum = sum(matrix[0])\n\n    # Check row sums\n    for row in matrix:\n        if sum(row) != expected_sum:\n            return False\n\n    # Check column sums\n    for col_idx in range(n):\n        col_sum = 0\n        for row_idx in range(n):\n            col_sum += matrix[row_idx][col_idx]\n        if col_sum != expected_sum:\n            return False\n\n    # Check main diagonal sum\n    main_diag_sum = 0\n    for i in range(n):\n        main_diag_sum += matrix[i][i]\n    if main_diag_sum != expected_sum:\n        return False\n\n    # Check anti-diagonal sum\n    anti_diag_sum = 0\n    for i in range(n):\n        anti_diag_sum += matrix[i][n - 1 - i]\n    if anti_diag_sum != expected_sum:\n        return False\n\n    return True\n```"}
{"task_id": "Mbpp/130", "solution": "```python\ndef max_occurrences(data_list):\n    \"\"\"\n    Finds the item with the maximum frequency in a given list.\n    Returns None if the list is empty.\n    \"\"\"\n    if not data_list:\n        return None\n\n    counts = {}\n    for item in data_list:\n        counts[item] = counts.get(item, 0) + 1\n\n    max_item = None\n    max_count = -1 \n\n    for item, count in counts.items():\n        if count > max_count:\n            max_count = count\n            max_item = item\n\n    return max_item\n```"}
{"task_id": "Mbpp/129", "solution": "```python\ndef magic_square_test(matrix: list[list[int]]) -> bool:\n    \"\"\"\n    Checks if a given square matrix is a magic square.\n    It sums all rows, columns, and diagonals, and compares them.\n    \"\"\"\n    size = len(matrix)\n\n    # The magic sum is determined by the sum of the first row.\n    magic_sum = sum(matrix[0])\n\n    # Check row sums.\n    for row in matrix:\n        if sum(row) != magic_sum:\n            return False\n\n    # Check column sums.\n    for j in range(size):\n        col_sum = 0\n        for i in range(size):\n            col_sum += matrix[i][j]\n        if col_sum != magic_sum:\n            return False\n\n    # Check main diagonal sum (top-left to bottom-right).\n    main_diag_sum = 0\n    for i in range(size):\n        main_diag_sum += matrix[i][i]\n    if main_diag_sum != magic_sum:\n        return False\n\n    # Check anti-diagonal sum (top-right to bottom-left).\n    anti_diag_sum = 0\n    for i in range(size):\n        anti_diag_sum += matrix[i][size - 1 - i]\n    if anti_diag_sum != magic_sum:\n        return False\n\n    return True\n```"}
{"task_id": "Mbpp/130", "solution": "```python\ndef max_occurrences(data_list: list):\n    \"\"\"\n    Finds the item with the maximum frequency in a given list.\n    Returns None for an empty list; for ties, the item encountered first is returned.\n    \"\"\"\n    if not data_list:\n        return None\n\n    counts = {}\n    for item in data_list:\n        counts[item] = counts.get(item, 0) + 1\n\n    max_item = None\n    max_count = 0\n\n    for item in data_list:\n        if counts[item] > max_count:\n            max_count = counts[item]\n            max_item = item\n\n    return max_item\n```"}
{"task_id": "Mbpp/131", "solution": "```python\ndef reverse_vowels(s: str) -> str:\n    \"\"\"\n    Reverses the positions of only the vowels in the input string, preserving all other characters.\n    Vowels are 'a', 'e', 'i', 'o', 'u' (case-insensitive); 'y' is a consonant.\n    \"\"\"\n    \n    VOWELS_SET = {'a', 'e', 'i', 'o', 'u'}\n\n    def _is_vowel(char: str) -> bool:\n        return char.lower() in VOWELS_SET\n\n    chars = list(s)\n    vowel_indices = []\n    vowels_found = []\n\n    for i, char in enumerate(chars):\n        if _is_vowel(char):\n            vowel_indices.append(i)\n            vowels_found.append(char)\n\n    vowels_found.reverse()\n\n    for i, original_index in enumerate(vowel_indices):\n        chars[original_index] = vowels_found[i]\n\n    return \"\".join(chars)\n```"}
{"task_id": "Mbpp/131", "solution": "```python\ndef reverse_vowels(s: str) -> str:\n    \"\"\"\n    Reverses only the vowels in a given string, treating 'y' as a consonant.\n    Vowels are 'a', 'e', 'i', 'o', 'u', case-insensitive.\n    \"\"\"\n    vowels_set = {'a', 'e', 'i', 'o', 'u'}\n    \n    s_list = list(s)\n    vowel_indices = []\n    found_vowels = []\n\n    for i, char in enumerate(s_list):\n        if char.lower() in vowels_set:\n            vowel_indices.append(i)\n            found_vowels.append(char)\n\n    found_vowels.reverse()\n\n    for i, original_index in enumerate(vowel_indices):\n        s_list[original_index] = found_vowels[i]\n\n    return \"\".join(s_list)\n```"}
