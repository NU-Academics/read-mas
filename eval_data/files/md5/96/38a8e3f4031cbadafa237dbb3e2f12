{"task_id": "Mbpp/631", "solution": "```python\ndef replace_spaces(text: str) -> str:\n    \"\"\"\n    Replaces all whitespace characters with underscores and all underscores with spaces.\n    Constructs a new string with the specified transformations.\n    \"\"\"\n    transformed_chars = []\n    for char in text:\n        if char.isspace():\n            transformed_chars.append('_')\n        elif char == '_':\n            transformed_chars.append(' ')\n        else:\n            transformed_chars.append(char)\n    return \"\".join(transformed_chars)\n```"}
{"task_id": "Mbpp/631", "solution": "```python\ndef replace_spaces(input_string: str) -> str:\n    \"\"\"\n    Transforms strings by replacing whitespaces with underscores, or underscores with spaces.\n    Whitespace replacement takes precedence if both types of characters are present.\n    \"\"\"\n    # Check for standard space, tab, newline, and carriage return characters.\n    has_whitespace = ' ' in input_string or '\\t' in input_string or '\\n' in input_string or '\\r' in input_string\n    has_underscore = '_' in input_string\n\n    if has_whitespace:\n        # Replace all defined whitespace characters with underscores.\n        modified_string = input_string.replace(' ', '_')\n        modified_string = modified_string.replace('\\t', '_')\n        modified_string = modified_string.replace('\\n', '_')\n        modified_string = modified_string.replace('\\r', '_')\n        return modified_string\n    elif has_underscore:\n        # If no whitespaces but underscores exist, replace all underscores with spaces.\n        return input_string.replace('_', ' ')\n    else:\n        # If neither whitespaces nor underscores are found, return the original string.\n        return input_string\n```"}
{"task_id": "Mbpp/632", "solution": "```python\ndef move_zero(data_list: list) -> list:\n    \"\"\"Moves all zero elements to the end of the list while preserving the relative order of non-zero elements.\n    It returns a new list without modifying the original.\n    \"\"\"\n    non_zeroes = [x for x in data_list if x != 0]\n    zeroes = [x for x in data_list if x == 0]\n    return non_zeroes + zeroes\n```"}
{"task_id": "Mbpp/632", "solution": "```python\ndef move_zero(data_list: list) -> list:\n    \"\"\"\n    Reorders the input list, moving all zero elements to the end.\n    Maintains the relative order of non-zero elements.\n    \"\"\"\n    non_zero_elements = []\n    zero_count = 0\n\n    for item in data_list:\n        if item == 0:\n            zero_count += 1\n        else:\n            non_zero_elements.append(item)\n\n    non_zero_elements.extend([0] * zero_count)\n\n    return non_zero_elements\n```"}
{"task_id": "Mbpp/633", "solution": "```python\ndef pair_xor_Sum(numbers: list[int], length: int) -> int:\n    \"\"\"\n    Calculates the sum of XOR of all unique pairs in a list of numbers.\n    Assumes valid input conforming to the problem statement.\n    \"\"\"\n    total_xor_sum = 0\n    for i in range(length):\n        for j in range(i + 1, length):\n            total_xor_sum += (numbers[i] ^ numbers[j])\n    return total_xor_sum\n```"}
{"task_id": "Mbpp/633", "solution": "```python\ndef pair_xor_Sum(numbers: list[int], n: int) -> int:\n    \"\"\"Calculates the sum of XOR of all unique pairs in the given list.\n    It iterates through all unique pairs (numbers[i], numbers[j]) where i < j.\"\"\"\n    \n    total_xor_sum = 0\n    for i in range(n):\n        for j in range(i + 1, n):\n            total_xor_sum += (numbers[i] ^ numbers[j])\n    return total_xor_sum\n```"}
{"task_id": "Mbpp/635", "solution": "```python\ndef _heapify(data, n, i):\n    largest = i\n    l = 2 * i + 1\n    r = 2 * i + 2\n\n    if l < n and data[largest] < data[l]:\n        largest = l\n\n    if r < n and data[largest] < data[r]:\n        largest = r\n\n    if largest != i:\n        data[i], data[largest] = data[largest], data[i]\n        _heapify(data, n, largest)\n\ndef _build_max_heap(data):\n    n = len(data)\n    for i in range(n // 2 - 1, -1, -1):\n        _heapify(data, n, i)\n\ndef heap_sort(data):\n    n = len(data)\n    if n <= 1:\n        return list(data)\n\n    arr = list(data)\n\n    _build_max_heap(arr)\n\n    for i in range(n - 1, 0, -1):\n        arr[i], arr[0] = arr[0], arr[i]\n        _heapify(arr, i, 0)\n    return arr\n```"}
{"task_id": "Mbpp/635", "solution": "```python\ndef _heapify(data: list, n: int, i: int) -> None:\n    \"\"\"\n    A helper function to maintain the max-heap property in a subtree rooted at index i.\n    It compares parent with children and swaps if necessary, then recursively heapifies.\n    \"\"\"\n    largest = i\n    left = 2 * i + 1\n    right = 2 * i + 2\n\n    if left < n and data[left] > data[largest]:\n        largest = left\n\n    if right < n and data[right] > data[largest]:\n        largest = right\n\n    if largest != i:\n        data[i], data[largest] = data[largest], data[i]\n        _heapify(data, n, largest)\n\ndef _build_max_heap(data: list) -> None:\n    \"\"\"\n    Builds a max-heap from an unsorted list in-place.\n    It iterates from the last parent node up to the root, heapifying each subtree.\n    \"\"\"\n    n = len(data)\n    for i in range(n // 2 - 1, -1, -1):\n        _heapify(data, n, i)\n\ndef heap_sort(data: list) -> None:\n    \"\"\"\n    Sorts a list of numbers in ascending order using the heap sort algorithm.\n    It modifies the list in-place.\n    \"\"\"\n    n = len(data)\n\n    _build_max_heap(data)\n\n    for i in range(n - 1, 0, -1):\n        data[i], data[0] = data[0], data[i]\n        _heapify(data, i, 0)\n```"}
