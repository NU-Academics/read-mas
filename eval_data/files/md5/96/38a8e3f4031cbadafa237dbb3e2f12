{"task_id": "Mbpp/223", "solution": "```python\ndef find_first_occurrence(arr: list[int], n: int, x: int) -> int:\n    \"\"\"Finds the index of the first occurrence of x in arr using binary search.\n    Returns the index or -1 if not found.\n    \"\"\"\n    low, high = 0, n - 1\n    result = -1\n    while low <= high:\n        mid = (low + high) // 2\n        if arr[mid] == x:\n            result = mid\n            high = mid - 1\n        elif arr[mid] < x:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return result\n\ndef find_last_occurrence(arr: list[int], n: int, x: int) -> int:\n    \"\"\"Finds the index of the last occurrence of x in arr using binary search.\n    Returns the index or -1 if not found.\n    \"\"\"\n    low, high = 0, n - 1\n    result = -1\n    while low <= high:\n        mid = (low + high) // 2\n        if arr[mid] == x:\n            result = mid\n            low = mid + 1\n        elif arr[mid] < x:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return result\n\ndef is_majority(arr: list[int], n: int, x: int) -> bool:\n    \"\"\"Determines if x is a majority element in arr.\n    Returns True if x occurs more than n/2 times, False otherwise.\n    \"\"\"\n    if n == 0:\n        return False\n\n    first_idx = find_first_occurrence(arr, n, x)\n    if first_idx == -1:\n        return False\n\n    last_idx = find_last_occurrence(arr, n, x)\n    \n    count = last_idx - first_idx + 1\n    \n    return count > (n / 2)\n```\n"}
{"task_id": "Mbpp/223", "solution": "```python\ndef is_majority(arr: list[int], n: int, x: int) -> bool:\n    \"\"\"\n    Determines if element x is a majority element in the sorted array arr.\n    A majority element occurs more than n/2 times.\n    \"\"\"\n\n    def find_first_occurrence(arr_inner: list[int], target: int) -> int:\n        \"\"\"Finds the index of the first occurrence of target in the sorted array arr_inner.\"\"\"\n        low, high = 0, len(arr_inner) - 1\n        result = -1\n        while low <= high:\n            mid = low + (high - low) // 2\n            if arr_inner[mid] == target:\n                result = mid\n                high = mid - 1\n            elif arr_inner[mid] < target:\n                low = mid + 1\n            else:\n                high = mid - 1\n        return result\n\n    def find_last_occurrence(arr_inner: list[int], target: int) -> int:\n        \"\"\"Finds the index of the last occurrence of target in the sorted array arr_inner.\"\"\"\n        low, high = 0, len(arr_inner) - 1\n        result = -1\n        while low <= high:\n            mid = low + (high - low) // 2\n            if arr_inner[mid] == target:\n                result = mid\n                low = mid + 1\n            elif arr_inner[mid] < target:\n                low = mid + 1\n            else:\n                high = mid - 1\n        return result\n\n    first_idx = find_first_occurrence(arr, x)\n    if first_idx == -1:\n        return False\n\n    last_idx = find_last_occurrence(arr, x)\n    \n    count = last_idx - first_idx + 1\n    return count > n / 2\n```"}
