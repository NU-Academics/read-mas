{"task_id": "Mbpp/286", "solution": "```python\ndef _kadane(arr: list[int]) -> int:\n    \"\"\"Implements Kadane's algorithm to find the maximum contiguous subarray sum.\"\"\"\n    if not arr:\n        return 0\n    max_so_far = arr[0]\n    current_max = arr[0]\n    for i in range(1, len(arr)):\n        current_max = max(arr[i], current_max + arr[i])\n        max_so_far = max(max_so_far, current_max)\n    return max_so_far\n\ndef _max_prefix_sum(arr: list[int]) -> int:\n    \"\"\"Calculates the maximum prefix sum of the given array.\"\"\"\n    if not arr:\n        return 0\n    max_prefix = arr[0]\n    current_sum = arr[0]\n    for i in range(1, len(arr)):\n        current_sum += arr[i]\n        max_prefix = max(max_prefix, current_sum)\n    return max_prefix\n\ndef _max_suffix_sum(arr: list[int]) -> int:\n    \"\"\"Calculates the maximum suffix sum of the given array.\"\"\"\n    if not arr:\n        return 0\n    max_suffix = arr[-1]\n    current_sum = arr[-1]\n    for i in range(len(arr) - 2, -1, -1):\n        current_sum += arr[i]\n        max_suffix = max(max_suffix, current_sum)\n    return max_suffix\n\ndef _total_sum(arr: list[int]) -> int:\n    \"\"\"Calculates the total sum of all elements in the given array.\"\"\"\n    return sum(arr)\n\ndef max_sub_array_sum_repeated(arr: list[int], n: int, k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous subarray in an array repeated k times.\n    Assumes k is a positive integer and n is the correct length of arr.\n    \"\"\"\n    if k < 1:\n        raise ValueError(\"k must be a positive integer.\")\n    if n == 0:\n        return 0\n\n    if k == 1:\n        return _kadane(arr)\n\n    # For k > 1, the maximum subarray can be:\n    # 1. Entirely within one instance of arr (handled by _kadane(arr)).\n    # 2. Spanning across two instances of arr (handled by _kadane(arr + arr)).\n    # 3. Spanning multiple instances: a suffix of the first, (k-2) full total_sums, and a prefix of the last.\n\n    total_arr_sum = _total_sum(arr)\n    \n    # Calculate _kadane on arr + arr once, as it's used in both positive and non-positive total_arr_sum cases.\n    # This covers cases where max subarray spans one or two original arrays.\n    kadane_on_double = _kadane(arr + arr)\n\n    if total_arr_sum <= 0:\n        # If the total sum is non-positive, repeating more than twice won't increase the sum.\n        # The max sum is found within at most two concatenations.\n        return kadane_on_double\n    else:\n        # If the total sum is positive, repeating more can increase the sum.\n        # Compare max sum within two concatenations with sum from suffix + (k-2)*total_sum + prefix.\n        max_prefix = _max_prefix_sum(arr)\n        max_suffix = _max_suffix_sum(arr)\n        return max(kadane_on_double, max_suffix + (k - 2) * total_arr_sum + max_prefix)\n```"}
{"task_id": "Mbpp/286", "solution": "```python\ndef _kadane(arr: list[int]) -> int:\n    \"\"\"\n    Implements Kadane's algorithm to find the maximum contiguous subarray sum.\n    Handles arrays with all negative numbers by returning the largest single element.\n    \"\"\"\n    max_so_far = float('-inf')\n    current_max = 0\n    has_positive = False\n\n    for x in arr:\n        if x >= 0:\n            has_positive = True\n        current_max += x\n        max_so_far = max(max_so_far, current_max)\n        if current_max < 0:\n            current_max = 0\n    \n    # If all numbers are negative, the max subarray sum is the largest single element.\n    # `arr` is assumed non-empty per problem constraints for this helper.\n    if not has_positive and max_so_far <= 0:\n        return max(arr)\n    \n    return max_so_far\n\ndef max_sub_array_sum_repeated(arr: list[int], n: int, k: int) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous subarray in an array formed by repeating `arr` `k` times.\n    This function assumes `arr` is non-empty, `n` is positive, and `k` is positive.\n    \"\"\"\n    # Input validation is omitted as per critical requirements.\n    # Trusting inputs: arr is non-empty, n > 0, k > 0.\n\n    # Case 1: k = 1, simply apply Kadane's algorithm on the original array\n    if k == 1:\n        return _kadane(arr)\n\n    # Case 2: k > 1\n    # Max subarray sum entirely within one repetition of arr\n    max_kadane_single = _kadane(arr)\n    \n    # Total sum of the array\n    total_sum_arr = sum(arr)\n\n    # Calculate max prefix sum of arr\n    max_prefix_sum = 0\n    current_prefix_sum = 0\n    for x in arr:\n        current_prefix_sum += x\n        max_prefix_sum = max(max_prefix_sum, current_prefix_sum)\n\n    # Calculate max suffix sum of arr\n    max_suffix_sum = 0\n    current_suffix_sum = 0\n    for x in reversed(arr):\n        current_suffix_sum += x\n        max_suffix_sum = max(max_suffix_sum, current_suffix_sum)\n\n    # Max sum spanning two repetitions (suffix of first arr + prefix of second arr)\n    max_sum_two_repetitions = max_prefix_sum + max_suffix_sum\n\n    # Initialize overall max with the best from a single repetition or two repetitions\n    overall_max = max(max_kadane_single, max_sum_two_repetitions)\n\n    # If total sum of array is positive, it can contribute to larger sums for k > 2\n    if total_sum_arr > 0:\n        overall_max = max(overall_max, total_sum_arr * (k - 2) + max_sum_two_repetitions)\n    \n    return overall_max\n```"}
{"task_id": "Mbpp/287", "solution": "```python\ndef square_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of squares of the first n even natural numbers.\n    The result is 0 if n is non-positive.\n    \"\"\"\n    total_sum = 0\n    for i in range(1, n + 1):\n        even_number = 2 * i\n        total_sum += even_number ** 2\n    return total_sum\n```"}
