{"task_id": "Mbpp/611", "solution": "```python\nclass MatrixUtilsError(Exception):\n    \"\"\"Base exception for matrix utility errors.\n    It provides a common base for all custom matrix-related errors.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass MatrixValueError(MatrixUtilsError, ValueError):\n    \"\"\"Raised when a matrix input has an invalid value or structure.\"\"\"\n    pass\n\nclass MatrixIndexError(MatrixUtilsError, IndexError):\n    \"\"\"Raised when a matrix index is out of bounds.\"\"\"\n    pass\n\ndef max_of_nth(matrix: list[list[int | float]], n: int) -> int | float:\n    \"\"\"Returns the maximum value of the n'th column in a matrix.\n\n    Args:\n        matrix: A list of lists representing the matrix.\n        n: The 0-indexed column number.\n\n    Returns:\n        The maximum value in the specified column.\n\n    Raises:\n        MatrixValueError: If the matrix is empty or any row is empty.\n        MatrixIndexError: If the column index n is out of bounds.\n    \"\"\"\n    if not matrix:\n        raise MatrixValueError(\"Matrix cannot be empty.\")\n    if not matrix[0]:\n        raise MatrixValueError(\"Matrix rows cannot be empty.\")\n    if not isinstance(n, int) or n < 0:\n        raise MatrixIndexError(\"Column index 'n' must be a non-negative integer.\")\n\n    num_cols = len(matrix[0])\n    if n >= num_cols:\n        raise MatrixIndexError(f\"Column index {n} is out of bounds for a matrix with {num_cols} columns.\")\n\n    max_val = matrix[0][n]\n    for row in matrix[1:]:\n        if n >= len(row): # Handle non-rectangular matrices gracefully for this specific column\n            raise MatrixIndexError(f\"Row has fewer columns than expected for index {n}.\")\n        if row[n] > max_val:\n            max_val = row[n]\n    return max_val\n```"}
{"task_id": "Mbpp/612", "solution": "```python\nfrom typing import List, Any\n\ndef merge(input_list: List[List[Any]]) -> List[List[Any]]:\n    \"\"\"\n    Splits a list of 2-element sublists into two separate lists.\n    The first returned list contains all first elements, the second has all second elements.\n    \"\"\"\n    first_elements: List[Any] = []\n    second_elements: List[Any] = []\n\n    for sublist in input_list:\n        first_elements.append(sublist[0])\n        second_elements.append(sublist[1])\n\n    return [first_elements, second_elements]\n```"}
