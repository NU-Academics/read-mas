{"task_id": "Mbpp/259", "solution": "def maximize_elements(tuple1: tuple[tuple[int, int], ...], tuple2: tuple[tuple[int, int], ...]) -> tuple[tuple[int, int], ...]:\n    \"\"\"\n    Performs element-wise maximization on two tuples of tuples containing integers.\n    It returns a new tuple of tuples where each element is the maximum of corresponding elements from the inputs.\n    \"\"\"\n    result = []\n    for (a, b), (e, f) in zip(tuple1, tuple2):\n        result.append((max(a, e), max(b, f)))\n    return tuple(result)"}
{"task_id": "Mbpp/260", "solution": "```python\nimport math\n\ndef _calculate_nsw_number(n: int) -> int:\n    \"\"\"Calculates the nth Newman-Shanks-Williams (NSW) number.\n    It uses the recurrence relation S_n = 2 * S_{n-1} + S_{n-2} with S_0 = 1, S_1 = 1.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n    if n == 0:\n        return 1\n    if n == 1:\n        return 1\n\n    s_prev_prev = 1  # S_0\n    s_prev = 1       # S_1\n    for _ in range(2, n + 1):\n        s_current = 2 * s_prev + s_prev_prev\n        s_prev_prev = s_prev\n        s_prev = s_current\n    return s_prev\n\ndef _is_prime(number: int) -> bool:\n    \"\"\"Checks if a given positive integer is a prime number.\n    This function uses trial division up to the square root of the number.\n    \"\"\"\n    if not isinstance(number, int) or number < 1:\n        raise ValueError(\"Input 'number' must be a positive integer.\")\n    if number <= 1:\n        return False\n    if number <= 3:\n        return True\n    if number % 2 == 0 or number % 3 == 0:\n        return False\n\n    i = 5\n    while i * i <= number:\n        if number % i == 0 or number % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n\ndef newman_prime(n: int) -> int:\n    \"\"\"Finds the nth Newman-Shanks-Williams prime number.\n\n    This function iterates through Newman-Shanks-Williams (NSW) numbers,\n    checks if each is prime, and returns the nth prime found.\n    The sequence of NSW numbers (S_n) is defined by S_0 = 1, S_1 = 1,\n    and S_n = 2 * S_{n-1} + S_{n-2} for n > 1.\n    The first few NSW numbers are: 1, 1, 3, 7, 17, 41, 99, 239, ...\n    The NSW primes are: 3 (S_2), 7 (S_3), 17 (S_4), 41 (S_5), 239 (S_7), ...\n\n    Note: The 'nth' in the problem statement, specifically `newman_prime(3) == 7`,\n    implies that `n=1` corresponds to the first NSW prime (3), `n=2` to the second (7),\n    and so on.\n\n    Args:\n        n (int): The desired position of the Newman-Shanks-Williams prime number\n                 (e.g., 1 for the first, 2 for the second). Must be a positive integer.\n\n    Returns:\n        int: The nth Newman-Shanks-Williams prime number.\n\n    Raises:\n        ValueError: If `n` is not a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    found_primes_count = 0\n    current_nsw_index = 0\n    while True:\n        nsw_number = _calculate_nsw_number(current_nsw_index)\n        if _is_prime(nsw_number):\n            found_primes_count += 1\n            if found_primes_count == n:\n                return nsw_number\n        current_nsw_index += 1\n\n```"}
{"task_id": "Mbpp/260", "solution": "```python\ndef newman_prime(n: int) -> int:\n    \"\"\"\n    Finds the nth Newman-Shanks-Williams prime number, where 'n' refers to the index k of S_k.\n    Raises ValueError if 'n' is not a non-negative integer or if S_n is not a prime number.\n    \"\"\"\n\n    # Helper function to check if a number is prime.\n    def is_prime(num: int) -> bool:\n        if num < 2:\n            return False\n        if num == 2 or num == 3:\n            return True\n        if num % 2 == 0 or num % 3 == 0:\n            return False\n        i = 5\n        while i * i <= num:\n            if num % i == 0 or num % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    # Memoization dictionary for NSW numbers, initialized with base cases.\n    _nsw_memo = {0: 1, 1: 1}\n\n    # Helper function to calculate the kth Newman-Shanks-Williams number.\n    def get_nsw_number(k: int) -> int:\n        if k < 0:\n            raise ValueError(\"k must be a non-negative integer for S_k.\")\n\n        if k in _nsw_memo:\n            return _nsw_memo[k]\n\n        # S_n = 2S_{n-1} + S_{n-2} recurrence relation.\n        nsw_num = 2 * get_nsw_number(k - 1) + get_nsw_number(k - 2)\n        _nsw_memo[k] = nsw_num\n        return nsw_num\n\n    # Validate the input 'n' for the newman_prime function directly\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    s_n = get_nsw_number(n)\n\n    if is_prime(s_n):\n        return s_n\n    else:\n        # If S_n is not prime, it doesn't fit the definition of \"nth newman\u2013shanks\u2013williams prime number\"\n        # when 'n' refers to the index 'k' of S_k.\n        raise ValueError(f\"S_{n} = {s_n} is not a prime number.\")\n```"}
{"task_id": "Mbpp/261", "solution": "```python\nclass TupleLengthMismatchError(ValueError):\n    \"\"\"Exception raised when two tuples have different lengths for an element-wise operation.\"\"\"\n    def __init__(self, message=\"Input tuples must have the same length.\"):\n        self.message = message\n        super().__init__(self.message)\n\nclass DivisionByZeroError(ValueError):\n    \"\"\"Exception raised when an attempt is made to divide by zero.\"\"\"\n    def __init__(self, message=\"Cannot divide by zero.\"):\n        self.message = message\n        super().__init__(self.message)\n\ndef division_elements(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise division operation across two given tuples.\n\n    Args:\n        tuple1: The first tuple (numerator).\n        tuple2: The second tuple (denominator).\n\n    Returns:\n        A new tuple containing the results of the element-wise division.\n        Results are floats to maintain precision.\n\n    Raises:\n        TypeError: If inputs are not tuples or if elements are not numeric.\n        TupleLengthMismatchError: If the input tuples have different lengths.\n        DivisionByZeroError: If any element in tuple2 is zero.\n    \"\"\"\n    if not isinstance(tuple1, tuple) or not isinstance(tuple2, tuple):\n        raise TypeError(\"Inputs must be tuples.\")\n\n    if len(tuple1) != len(tuple2):\n        raise TupleLengthMismatchError(\"Input tuples must have the same length for element-wise division.\")\n\n    results = []\n    for i in range(len(tuple1)):\n        numerator = tuple1[i]\n        denominator = tuple2[i]\n\n        if not isinstance(numerator, (int, float)) or not isinstance(denominator, (int, float)):\n            raise TypeError(\"All elements in tuples must be numeric (int or float).\")\n\n        if denominator == 0:\n            raise DivisionByZeroError(f\"Cannot divide by zero at index {i}.\")\n        results.append(float(numerator) / denominator)\n    return tuple(results)\n```"}
{"task_id": "Mbpp/261", "solution": "```python\ndef division_elements(tuple1: tuple[int | float, ...], tuple2: tuple[int | float, ...]) -> tuple[int, ...]:\n    \"\"\"\n    Performs element-wise division operation across two given tuples.\n\n    Args:\n        tuple1: The first tuple containing numeric (int or float) elements.\n        tuple2: The second tuple containing numeric (int or float) elements,\n                used as divisors.\n\n    Returns:\n        A new tuple where each element is the integer result of the\n        element-wise division of tuple1 by tuple2.\n\n    Raises:\n        TypeError: If inputs are not tuples or contain non-numeric elements.\n        ValueError: If tuples have different lengths or if any division\n                    results in a non-integer value.\n        ZeroDivisionError: If any element in tuple2 is zero.\n    \"\"\"\n    # Validate inputs\n    if not isinstance(tuple1, tuple) or not isinstance(tuple2, tuple):\n        raise TypeError(\"Inputs must be tuples.\")\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Input tuples must have the same length.\")\n\n    result = []\n    for i in range(len(tuple1)):\n        if not isinstance(tuple1[i], (int, float)) or not isinstance(tuple2[i], (int, float)):\n            raise TypeError(\"All tuple elements must be numeric (int or float).\")\n        if tuple2[i] == 0:\n            raise ZeroDivisionError(f\"Division by zero at index {i}.\")\n\n        quotient = tuple1[i] / tuple2[i]\n        if not quotient.is_integer():\n            raise ValueError(f\"Division at index {i} resulted in a non-integer value: {quotient}\")\n        result.append(int(quotient))\n    return tuple(result)\n```"}
