{"task_id": "Mbpp/804", "solution": "```python\ndef is_product_even(numbers):\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    Returns True if any number is zero or even, False otherwise (including for an empty list).\n    \"\"\"\n    if not numbers:\n        return False  # Product of an empty list is 1, which is odd.\n\n    for num in numbers:\n        if num == 0:\n            return True  # Product is 0, which is even.\n        if num % 2 == 0:\n            return True  # An even number makes the product even.\n\n    return False\n```"}
{"task_id": "Mbpp/804", "solution": "```python\nfrom typing import List, Union\n\ndef is_product_even(numbers: List[Union[int, float]]) -> bool:\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    The product of an empty list is conventionally 1 (odd).\n    \"\"\"\n    if not numbers:\n        return False\n\n    for num in numbers:\n        # If any number is 0, the product is 0, which is an even number.\n        if num == 0:\n            return True\n        # If any number is even (integer or even-valued float), the product is even.\n        # Python's modulo operator (%) works for floats as well.\n        # For example, 2.0 % 2 evaluates to 0.0, which is equal to 0.\n        # 1.5 % 2 evaluates to 1.5, which is not equal to 0.\n        if num % 2 == 0:\n            return True\n\n    # If no even number or zero was found, the product is odd.\n    return False\n```"}
{"task_id": "Mbpp/805", "solution": "```python\nfrom typing import List, Union\n\nclass EmptyInputError(Exception):\n    \"\"\"Custom exception raised when an input list is empty.\"\"\"\n    def __init__(self, message: str = \"Input list cannot be empty.\"):\n        self.message = message\n        super().__init__(self.message)\n\ndef max_sum_list(list_of_lists: List[List[Union[int, float]]]) -> List[Union[int, float]]:\n    \"\"\"\n    Returns the list in a list of lists whose sum of elements is the highest.\n\n    Args:\n        list_of_lists: A list of lists, where each inner list contains numbers (int or float).\n\n    Returns:\n        The inner list with the highest sum of elements.\n\n    Raises:\n        EmptyInputError: If the input list_of_lists is empty.\n        TypeError: If the input is not a list of lists, or if inner lists contain non-numeric elements.\n    \"\"\"\n    if not isinstance(list_of_lists, list):\n        raise TypeError(\"Input must be a list of lists.\")\n    if not list_of_lists:\n        raise EmptyInputError(\"Input list cannot be empty.\")\n\n    max_sum: Union[int, float] = float('-inf')\n    max_list: List[Union[int, float]] = []\n\n    for inner_list in list_of_lists:\n        if not isinstance(inner_list, list):\n            raise TypeError(\"All elements in the outer list must be lists of numbers.\")\n        # sum() will raise TypeError if inner_list contains non-numeric elements\n        current_sum = sum(inner_list)\n        if current_sum > max_sum:\n            max_sum = current_sum\n            max_list = inner_list\n            \n    return max_list\n```"}
{"task_id": "Mbpp/806", "solution": "```python\ndef max_run_uppercase(input_string: str) -> int:\n    \"\"\"\n    Finds the maximum consecutive run of uppercase characters in the given string.\n    Returns the maximum consecutive count of uppercase characters.\n    \"\"\"\n    max_run = 0\n    current_run = 0\n    for char in input_string:\n        if char.isupper():\n            current_run += 1\n        else:\n            max_run = max(max_run, current_run)\n            current_run = 0\n    return max(max_run, current_run)\n```"}
{"task_id": "Mbpp/805", "solution": "```python\nfrom typing import List, Union\n\ndef max_sum_list(list_of_lists: List[List[Union[int, float]]]) -> List[Union[int, float]]:\n    \"\"\"\n    Returns the sublist from a list of lists whose sum of elements is the highest.\n    If the input is empty, returns an empty list; if multiple sublists have the same highest sum, the first one is returned.\n    \"\"\"\n    if not list_of_lists:\n        return []\n\n    max_sum = -float('inf')\n    result_list: List[Union[int, float]] = []\n\n    for sublist in list_of_lists:\n        current_sum = sum(sublist)\n        if current_sum > max_sum:\n            max_sum = current_sum\n            result_list = sublist\n    \n    return result_list\n```"}
