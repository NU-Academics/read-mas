{"task_id": "Mbpp/123", "solution": "```python\nfrom typing import Dict\n\n_divisor_sum_cache: Dict[int, int] = {}\n\ndef _sum_proper_divisors(n: int) -> int:\n    \"\"\"Calculates the sum of proper divisors for a given positive integer n.\n    Proper divisors are all positive divisors excluding n itself.\n    \"\"\"\n    if n == 1:\n        return 0\n\n    if n in _divisor_sum_cache:\n        return _divisor_sum_cache[n]\n\n    total_sum = 1\n    for i in range(2, int(n**0.5) + 1):\n        if n % i == 0:\n            total_sum += i\n            if i * i != n:\n                total_sum += n // i\n    _divisor_sum_cache[n] = total_sum\n    return total_sum\n\ndef _is_amicable_pair(a: int, b: int) -> bool:\n    \"\"\"Determines if two distinct positive integers a and b form an amicable pair.\n    It returns True if they are an amicable pair, False otherwise.\n    \"\"\"\n    if a == b:\n        return False\n    \n    sum_div_a = _sum_proper_divisors(a)\n    sum_div_b = _sum_proper_divisors(b)\n\n    return sum_div_a == b and sum_div_b == a\n\ndef amicable_numbers_sum(limit: int) -> int:\n    \"\"\"Sums all amicable numbers from 1 up to a specified limit.\n    It returns the total sum of amicable numbers found.\n    \"\"\"\n    total_amicable_sum = 0\n    found_amicable_numbers = set()\n\n    for n in range(1, limit + 1):\n        if n in found_amicable_numbers:\n            continue\n\n        sum_div_n = _sum_proper_divisors(n)\n        m = sum_div_n\n\n        if m > n and m <= limit:\n            if _is_amicable_pair(n, m):\n                total_amicable_sum += n + m\n                found_amicable_numbers.add(n)\n                found_amicable_numbers.add(m)\n    return total_amicable_sum\n```"}
{"task_id": "Mbpp/123", "solution": "```python\ndef _calculate_sum_proper_divisors(n: int) -> int:\n    \"\"\"Calculates the sum of proper divisors for a given positive integer.\n    Proper divisors include all positive divisors except the number itself.\n    \"\"\"\n    if n == 1:\n        return 0\n    s = 1\n    for i in range(2, int(n**0.5) + 1):\n        if n % i == 0:\n            s += i\n            if i * i != n:\n                s += n // i\n    return s\n\ndef _find_amicable_numbers_up_to_limit(limit: int) -> set[int]:\n    \"\"\"Finds all amicable numbers up to a specified limit (exclusive).\n    Adds both numbers of an amicable pair to the set if they are within the limit.\n    \"\"\"\n    found_amicable_numbers = set()\n    for n in range(1, limit):\n        if n in found_amicable_numbers:\n            continue\n\n        sum_divisors_n = _calculate_sum_proper_divisors(n)\n\n        # Check if sum_divisors_n is a potential amicable partner within the limit.\n        if sum_divisors_n > n and sum_divisors_n < limit:\n            sum_divisors_m = _calculate_sum_proper_divisors(sum_divisors_n)\n            if sum_divisors_m == n:\n                found_amicable_numbers.add(n)\n                found_amicable_numbers.add(sum_divisors_n)\n    return found_amicable_numbers\n\ndef amicable_numbers_sum(limit: int) -> int:\n    \"\"\"Sums all amicable numbers from 1 up to a specified limit (exclusive).\n    An amicable pair consists of two distinct positive integers where each is the sum of the proper divisors of the other.\n    \"\"\"\n    amicable_numbers = _find_amicable_numbers_up_to_limit(limit)\n    return sum(amicable_numbers)\n```"}
