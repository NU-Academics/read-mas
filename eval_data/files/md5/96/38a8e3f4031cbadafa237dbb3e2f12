{"task_id": "Mbpp/751", "solution": "```python\ndef check_min_heap(arr: list) -> bool:\n    \"\"\"\n    Checks if the given array satisfies the min-heap property.\n    An empty or single-element array is considered a valid min-heap.\n    \"\"\"\n    n = len(arr)\n\n    # Empty or single-element arrays satisfy the min-heap property.\n    if n <= 1:\n        return True\n\n    # Iterate only through parent nodes, from index 0 up to (n // 2) - 1.\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # If the parent is greater than its left child, it's not a min-heap.\n        if arr[i] > arr[left_child_idx]:\n            return False\n\n        # If a right child exists and the parent is greater, it's not a min-heap.\n        if right_child_idx < n and arr[i] > arr[right_child_idx]:\n            return False\n\n    # If all parent-child comparisons passed, the array is a min-heap.\n    return True\n```"}
{"task_id": "Mbpp/751", "solution": "```python\ndef check_min_heap(arr: list[int]) -> bool:\n    \"\"\"Checks if the given array represents a min-heap.\n    Assumes the input is a list of comparable elements.\"\"\"\n    n = len(arr)\n    if n <= 1:\n        return True\n\n    # Iterate only up to the last parent node, which is at index (n // 2) - 1\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child: if parent is greater, it's not a min-heap\n        if arr[i] > arr[left_child_idx]:\n            return False\n\n        # Check right child if it exists: if parent is greater, it's not a min-heap\n        if right_child_idx < n and arr[i] > arr[right_child_idx]:\n            return False\n            \n    return True\n```"}
{"task_id": "Mbpp/752", "solution": "```python\n_memo: dict[int, int] = {0: 0, 1: 1}\n\ndef jacobsthal_num(n: int) -> int:\n    \"\"\"Calculates the nth Jacobsthal number using memoization.\n    It returns the value based on J(n) = J(n-1) + 2 * J(n-2) for n > 1.\n    \"\"\"\n    if n in _memo:\n        return _memo[n]\n\n    result = jacobsthal_num(n - 1) + 2 * jacobsthal_num(n - 2)\n    _memo[n] = result\n    return result\n```"}
{"task_id": "Mbpp/752", "solution": "```python\n_jacobsthal_memo = {0: 0, 1: 1}\n\ndef jacobsthal_num(n: int) -> int:\n    \"\"\"Calculates the nth Jacobsthal number based on the recurrence relation.\n    J(0)=0, J(1)=1, and J(n) = J(n-1) + 2 * J(n-2) for n > 1.\"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n\n    if n in _jacobsthal_memo:\n        return _jacobsthal_memo[n]\n\n    result = jacobsthal_num(n - 1) + 2 * jacobsthal_num(n - 2)\n    _jacobsthal_memo[n] = result\n    return result\n```"}
{"task_id": "Mbpp/753", "solution": "```python\nfrom typing import List, Tuple\n\ndef min_k(records: List[Tuple[str, int]], k: int) -> List[Tuple[str, int]]:\n    \"\"\"\n    Finds the k records with the smallest second element (value) from a list of tuples.\n    Returns an empty list if k <= 0 or the input records list is empty.\n    \"\"\"\n    if k <= 0 or not records:\n        return []\n\n    sorted_records = sorted(records, key=lambda x: x[1])\n    return sorted_records[:k]\n```"}
{"task_id": "Mbpp/753", "solution": "def min_k(data_list: list[tuple], k: int) -> list[tuple]:\n    \"\"\"\n    Finds the minimum k records from a list of tuples.\n\n    The comparison for \"minimum\" is based on the second element of each tuple.\n\n    Args:\n        data_list: A list of tuples, where each tuple is expected to be of the form (str, int).\n                   Example: [('Manjeet', 10), ('Akshat', 4)]\n        k: An integer representing the number of minimum records to retrieve.\n\n    Returns:\n        A new list containing k tuples, sorted by the second element in ascending order.\n        If k is 0, an empty list is returned.\n        If k is greater than or equal to the length of data_list, the entire sorted data_list is returned.\n\n    Raises:\n        TypeError: If data_list is not a list or k is not an integer.\n        ValueError: If k is a negative integer.\n    \"\"\"\n    if not isinstance(data_list, list):\n        raise TypeError(\"data_list must be a list.\")\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an integer.\")\n    if k < 0:\n        raise ValueError(\"k must be a non-negative integer.\")\n\n    if not data_list or k == 0:\n        return []\n\n    # Sort the list based on the second element of each tuple\n    sorted_list = sorted(data_list, key=lambda x: x[1])\n\n    # Return the first k elements\n    return sorted_list[:k]"}
