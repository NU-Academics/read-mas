{"task_id": "Mbpp/733", "solution": "```python\ndef find_first_occurrence(arr: list[int], target: int) -> int:\n    \"\"\"Finds the index of the first occurrence of `target` in the sorted `arr`.\n    Returns the index or -1 if `target` is not found.\n    \"\"\"\n    if not arr:\n        return -1\n\n    low, high = 0, len(arr) - 1\n    first_occurrence_index = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if arr[mid] == target:\n            first_occurrence_index = mid\n            high = mid - 1  # Try to find an even earlier occurrence\n        elif arr[mid] < target:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return first_occurrence_index\n```"}
{"task_id": "Mbpp/733", "solution": "```python\ndef find_first_occurrence(sorted_array: list[int | float], target: int | float) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a target number in a sorted array.\n    Returns its index, or -1 if the target is not found.\n    \"\"\"\n    low = 0\n    high = len(sorted_array) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if sorted_array[mid] == target:\n            result = mid\n            high = mid - 1  # Try to find an earlier occurrence\n        elif sorted_array[mid] < target:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return result\n```"}
{"task_id": "Mbpp/734", "solution": "```python\ndef sum_Of_Subarray_Prod(input_list):\n    \"\"\"\n    Calculates the sum of products of all possible contiguous sublists of a given list.\n    For example, sum_Of_Subarray_Prod([1, 2, 3]) == 20.\n    \"\"\"\n    total_sum = 0\n    n = len(input_list)\n\n    for i in range(n):\n        current_product = 1\n        for j in range(i, n):\n            element = input_list[j]\n            current_product *= element\n            total_sum += current_product\n    return total_sum\n```"}
{"task_id": "Mbpp/734", "solution": "```python\ndef sum_Of_Subarray_Prod(input_list: list[int]) -> int:\n    \"\"\"Calculates the sum of products of all contiguous sublists.\n\n    This function processes an input list of integers and returns a single integer sum.\n\n    Args:\n        input_list: The list of integers for which to perform the calculation.\n\n    Returns:\n        The total sum of products of all contiguous sublists.\n\n    Raises:\n        ValueError: If the input is not a list or contains non-integer elements.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise ValueError(\"Input must be a list.\")\n    for item in input_list:\n        if not isinstance(item, int):\n            raise ValueError(\"All elements in the list must be integers.\")\n\n    n = len(input_list)\n    total_sum = 0\n\n    for i in range(n):\n        current_product = 1\n        for j in range(i, n):\n            current_product *= input_list[j]\n            total_sum += current_product\n    return total_sum\n```"}
{"task_id": "Mbpp/735", "solution": "```python\ndef toggle_middle_bits(n: int) -> int:\n    \"\"\"Toggles all bits of the number except the most significant and least significant bits.\n    Returns the original number if it has fewer than 3 bits.\n    \"\"\"\n    num_bits = n.bit_length()\n\n    if num_bits < 3:\n        return n\n\n    # Create a mask with ones for all middle bits.\n    # (1 << (num_bits - 1)) generates 100...00 (MSB set).\n    # Subtracting 2 yields 011...10 (all bits between MSB and LSB set).\n    middle_bits_mask = (1 << (num_bits - 1)) - 2\n\n    return n ^ middle_bits_mask\n```"}
{"task_id": "Mbpp/736", "solution": "```python\ndef left_insertion(sorted_list: list, value) -> int:\n    \"\"\"\n    Locates the left insertion point for a specified value in a sorted list.\n    Returns an index where value should be inserted to maintain sorted order, ensuring the leftmost position for duplicates.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low\n```"}
{"task_id": "Mbpp/736", "solution": "```python\nfrom typing import List, Any\n\ndef left_insertion(sorted_list: List[Any], value: Any) -> int:\n    \"\"\"\n    Locates the left insertion point for a specified value in a sorted list.\n    It uses a binary search algorithm to achieve O(log n) performance.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if value <= sorted_list[mid]:\n            high = mid\n        else:\n            low = mid + 1\n    return low\n```"}
{"task_id": "Mbpp/735", "solution": "```python\ndef toggle_middle_bits(n: int) -> int:\n    if n < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n\n    # Numbers with 0, 1, or 2 bits (i.e., n = 0, 1, 2, or 3) have no middle bits to toggle.\n    # For such numbers, the most significant bit position is 0 or 1, leaving no bits\n    # strictly between the MSB and LSB (position 0).\n    if n <= 3:\n        return n\n\n    # Find the position of the most significant bit (MSB).\n    # For a number like 9 (binary 1001), n.bit_length() is 4, so msb_pos is 3.\n    # This refers to the 0-indexed position of the highest set bit.\n    msb_pos = n.bit_length() - 1\n\n    # Create a mask to target bits strictly between the MSB position and the LSB position (bit 0).\n    # This means the mask will have 1s from bit position 1 up to msb_pos - 1.\n    # 1. `(1 << msb_pos) - 1` creates a sequence of 1s from bit position 0 up to `msb_pos - 1`.\n    #    Example for msb_pos = 3: (1 << 3) - 1 = 8 - 1 = 7 (binary 0111).\n    # 2. `& ~1` then clears the least significant bit (position 0) of this sequence.\n    #    Example: 0111 & ~1 (effectively 0111 & ...1110) = 0110 (binary 6).\n    #    This resulting mask has 1s at positions 1, 2, ..., msb_pos - 1.\n    mask = ((1 << msb_pos) - 1) & ~1\n\n    # Toggle the identified middle bits using the XOR operator.\n    return n ^ mask\n```"}
