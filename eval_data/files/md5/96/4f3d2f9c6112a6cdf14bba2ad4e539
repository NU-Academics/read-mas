{"task_id": "HumanEval/24", "solution": "```python\nimport math\n\ndef largest_divisor(n: int) -> int:\n    \"\"\"Finds the largest positive integer that divides n evenly and is smaller than n.\n    Assumes n is an integer greater than 1.\n    \"\"\"\n    if n <= 3:\n        return 1\n\n    limit = int(math.sqrt(n))\n    for i in range(2, limit + 1):\n        if n % i == 0:\n            return n // i\n\n    return 1\n```"}
{"task_id": "HumanEval/24", "solution": "import math\n\ndef largest_divisor(n: int) -> int:\n    \"\"\"Finds the largest proper divisor of an integer n.\n    Returns 0 for n <= 1, and 1 for prime n.\n    \"\"\"\n    if n <= 1:\n        return 0\n\n    max_div = 1\n    root = int(math.isqrt(n))\n    for i in range(1, root + 1):\n        if n % i == 0:\n            j = n // i\n            # Check i as a proper divisor\n            if i != n and i > max_div:\n                max_div = i\n            # Check j as a proper divisor\n            if j != n and j > max_div:\n                max_div = j\n    return max_div"}
{"task_id": "HumanEval/25", "solution": "```python\nfrom typing import List\n\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    factors = []\n    \n    # Handle factor 2\n    while n % 2 == 0:\n        factors.append(2)\n        n //= 2\n        \n    # Handle odd factors from 3 upwards\n    d = 3\n    while d * d <= n:\n        while n % d == 0:\n            factors.append(d)\n            n //= d\n        d += 2 \n        \n    # If n is still greater than 1, it must be the last prime factor\n    if n > 1:\n        factors.append(n)\n        \n    return factors\n```"}
{"task_id": "HumanEval/25", "solution": "from typing import List\n\n\ndef factorize(n: int) -> List[int]:\n    \"\"\"Return a list of prime factors for a given integer, ordered from smallest to largest, with repeated factors.\n    The input number equals the product of all factors.\n    \"\"\"\n    factors = []\n\n    # Handle factor 2\n    while n % 2 == 0:\n        factors.append(2)\n        n //= 2\n\n    # Handle odd factors starting from 3\n    d = 3\n    while d * d <= n:\n        while n % d == 0:\n            factors.append(d)\n            n //= d\n        d += 2\n\n    # If n is still greater than 1, it must be the last prime factor\n    if n > 1:\n        factors.append(n)\n\n    return factors"}
