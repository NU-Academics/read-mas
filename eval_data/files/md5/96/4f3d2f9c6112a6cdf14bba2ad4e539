, \"D\"]\nignore = [\"D100\", \"D104\"]\n```\n\n**`README.md`**\n```markdown\n# Cyclic Encoder/Decoder\n\nA Python library and service for encoding and decoding strings by cyclically shifting groups of three characters.\n\n## Installation\n\n```bash\n# Clone the repository\ngit clone https://github.com/your-org/cyclic.git\ncd cyclic\n\n# Install with Poetry (recommended)\npoetry install\n\n# If you want to run the optional HTTP API server\npoetry install -E server\n```\n\n## Usage\n\n### As a Library\n\n```python\nfrom cyclic import Encoder, Decoder, CyclicService\n\nencoder = Encoder()\ndecoder = Decoder()\nservice = CyclicService(encoder, decoder)\n\noriginal_text = \"abcdefghi\"\nencoded_response = service.encode(original_text)\nprint(f\"Encoded: {encoded_response.result}\") # Expected: bcadefghic\n\ndecoded_response = service.decode(encoded_response.result)\nprint(f\"Decoded: {decoded_response.result}\") # Expected: abcdefghi\n```\n\n### Command-Line Interface (CLI)\n\n```bash\n# Encode a string\ncyclic --encode --input \"Hello World!\"\n\n# Decode a string\ncyclic --decode --input \"elloH World!\"\n\n# Encode content from a file and write to another file\necho \"My secret message\" > input.txt\ncyclic --encode --file input.txt --output encoded.txt\ncat encoded.txt\n\n# Decode content from a file\ncyclic --decode --file encoded.txt\n```\n\n### HTTP API (Optional)\n\nFirst, ensure you have installed the `server` extra:\n`poetry install -E server`\n\nThen, run the server using Uvicorn:\n`uvicorn src.cyclic.api:app --reload`\n\nOnce the server is running (typically on `http://127.0.0.1:8000`), you can use tools like `curl` or `requests` to interact with it.\n\n**Encode Example:**\n```bash\ncurl -X POST \"http://127.0.0.1:8000/encode\" -H \"Content-Type: application/json\" -d '{\"text\": \"abcdefg\"}'\n# Response: {\"result\":\"bcadefg\"}\n```\n\n**Decode Example:**\n```bash\ncurl -X POST \"http://127.0.0.1:8000/decode\" -H \"Content-Type: application/json\" -d '{\"text\": \"bcadefg\"}'\n# Response: {\"result\":\"abcdefg\"}\n```\n\n## Development\n\nRun tests:\n`poetry run pytest`\n```\n\n---\n\n**`src/cyclic/__init__.py`**\n```python\n\"\"\"\nCyclic package exports.\n\"\"\"\nfrom .encoder import Encoder\nfrom .decoder import Decoder\nfrom .service import CyclicService\nfrom .cli import CLIController, main\nfrom .exceptions import CyclicError, InvalidInputError, InternalError\nfrom .models import CyclicRequest, CyclicResponse\n\n__all__ = [\n    \"Encoder\",\n    \"Decoder\",\n    \"CyclicService\",\n    \"CLIController\",\n    \"main\",\n    \"CyclicError\",\n    \"InvalidInputError\",\n    \"InternalError\",\n    \"CyclicRequest\",\n    \"CyclicResponse\",\n]\n```\n\n---\n\n**`src/cyclic/exceptions.py`**\n```python\n\"\"\"\nDomain-specific exceptions for consistent error handling.\n\"\"\"\n\nclass CyclicError(Exception):\n    \"\"\"Base exception for cyclic operations.\"\"\"\n    def __init__(self, message: str, error_code: str = \"cyclic.error\") -> None:\n        super().__init__(message)\n        self.message = message\n        self.error_code = error_code\n\n    def __repr__(self) -> str:\n        return f\"{self.__class__.__name__}(message='{self.message}', error_code='{self.error_code}')\"\n\nclass InvalidInputError(CyclicError):\n    \"\"\"Raised for invalid input parameters.\"\"\"\n    def __init__(self, message: str = \"Invalid input\") -> None:\n        super().__init__(message, error_code=\"invalid_input\")\n\nclass InternalError(CyclicError):\n    \"\"\"Raised for unexpected internal errors.\"\"\"\n    def __init__(self, message: str = \"Internal error\") -> None:\n        super().__init__(message, error_code=\"internal_error\")\n\n```\n\n---\n\n**`src/cyclic/models.py`**\n```python\n\"\"\"\nData transfer objects for requests and responses.\n\"\"\"\nDEFAULT_CHUNK_SIZE: int = 3\n\nclass CyclicRequest:\n    \"\"\"Represents an encoding/decoding request.\"\"\"\n    def __init__(self, text: str) -> None:\n        self.text = text\n\n    def __repr__(self) -> str:\n        return f\"CyclicRequest(text='{self.text[:20]}...')\"\n\nclass CyclicResponse:\n    \"\"\"Represents an encoding/decoding response.\"\"\"\n    def __init__(self, result: str) -> None:\n        self.result = result\n\n    def __repr__(self) -> str:\n        return f\"CyclicResponse(result='{self.result[:20]}...')\"\n\n```\n\n---\n\n**`src/cyclic/utils.py`**\n```python\n\"\"\"\nReusable utility functions.\n\"\"\"\nfrom typing import List\n\nfrom .exceptions import InvalidInputError\n\ndef chunk(s: str, size: int) -> List[str]:\n    \"\"\"Splits a string into contiguous chunks of specified size.\"\"\"\n    return [s[i:i+size] for i in range(0, len(s), size)]\n\ndef read_file(path: str) -> str:\n    \"\"\"Reads content from a text file, raising InvalidInputError on failure.\"\"\"\n    try:\n        with open(path, 'r', encoding='utf-8') as f:\n            return f.read()\n    except FileNotFoundError:\n        raise InvalidInputError(f\"Input file not found: {path}\")\n    except OSError as e:\n        raise InvalidInputError(f\"Error reading file {path}: {e}\")\n\ndef write_file(path: str, data: str) -> None:\n    \"\"\"Writes data to a text file, raising InvalidInputError on failure.\"\"\"\n    try:\n        with open(path, 'w', encoding='utf-8') as f:\n            f.write(data)\n    except OSError as e:\n        raise InvalidInputError(f\"Error writing to file {path}: {e}\")\n\n```\n\n---\n\n**`src/cyclic/validators.py`**\n```python\n\"\"\"\nInput validation helpers for service layer.\n\"\"\"\nfrom typing import Any\nfrom .exceptions import InvalidInputError\n\nMAX_LENGTH: int = 1_000_000\n\ndef validate_input(text: Any) -> None:\n    \"\"\"Validates input for type and maximum length, raising InvalidInputError.\"\"\"\n    if not isinstance(text, str):\n        raise InvalidInputError(\"Input must be a string.\")\n    if len(text) > MAX_LENGTH:\n        raise InvalidInputError(f\"Input exceeds maximum allowed length of {MAX_LENGTH} characters.\")\n\n```\n\n---\n\n**`src/cyclic/encoder.py`**\n```python\n\"\"\"\nImplements the cyclic encoding logic.\n\"\"\"\nfrom . import utils\nfrom .models import DEFAULT_CHUNK_SIZE\n\nclass Encoder:\n    \"\"\"Encodes strings by cyclically shifting groups of three characters.\"\"\"\n    def __init__(self, chunk_size: int = DEFAULT_CHUNK_SIZE) -> None:\n        self._chunk_size = chunk_size\n\n    def _rotate_group(self, group: str) -> str:\n        \"\"\"Rotates a group of characters left by one.\"\"\"\n        return group[1:] + group[0]\n\n    def encode(self, s: str) -> str:\n        \"\"\"Encodes the input string by cycling groups of characters.\"\"\"\n        chunks = utils.chunk(s, self._chunk_size)\n        rotated_chunks = [self._rotate_group(c) if len(c) == self._chunk_size else c for c in chunks]\n        return \"\".join(rotated_chunks)\n\n```\n\n---\n\n**`src/cyclic/decoder.py`**\n```python\n\"\"\"\nImplements the cyclic decoding logic, reversing the encoder.\n\"\"\"\nfrom . import utils\nfrom .models import DEFAULT_CHUNK_SIZE\n\nclass Decoder:\n    \"\"\"Decodes strings by reversing the cyclic shift of groups of three characters.\"\"\"\n    def __init__(self, chunk_size: int = DEFAULT_CHUNK_SIZE) -> None:\n        self._chunk_size = chunk_size\n\n    def _unrotate_group(self, group: str) -> str:\n        \"\"\"Unrotates a group of characters right by one.\"\"\"\n        return group[-1] + group[:-1]\n\n    def decode(self, s: str) -> str:\n        \"\"\"Decodes the input string, reversing the encoding process.\"\"\"\n        chunks = utils.chunk(s, self._chunk_size)\n        unrotated_chunks = [self._unrotate_group(c) if len(c) == self._chunk_size else c for c in chunks]\n        return \"\".join(unrotated_chunks)\n\n```\n\n---\n\n**`src/cyclic/service.py`**\n```python\n\"\"\"\nApplication service layer coordinating validation, encoding, and decoding.\n\"\"\"\nfrom .encoder import Encoder\nfrom .decoder import Decoder\nfrom .models import CyclicResponse\nfrom . import validators\nfrom .exceptions import InternalError, InvalidInputError\n\nclass CyclicService:\n    \"\"\"Orchestrates validation and calls encoder/decoder operations.\"\"\"\n    def __init__(self, encoder: Encoder, decoder: Decoder) -> None:\n        self._encoder = encoder\n        self._decoder = decoder\n\n    def encode(self, text: str) -> CyclicResponse:\n        \"\"\"Validates input, encodes the text, and returns a CyclicResponse.\"\"\"\n        try:\n            validators.validate_input(text)\n            encoded_text = self._encoder.encode(text)\n            return CyclicResponse(encoded_text)\n        except InvalidInputError:\n            raise\n        except Exception as e:\n            raise InternalError(f\"An unexpected error occurred during encoding: {e}\") from e\n\n    def decode(self, text: str) -> CyclicResponse:\n        \"\"\"Validates input, decodes the text, and returns a CyclicResponse.\"\"\"\n        try:\n            validators.validate_input(text)\n            decoded_text = self._decoder.decode(text)\n            return CyclicResponse(decoded_text)\n        except InvalidInputError:\n            raise\n        except Exception as e:\n            raise InternalError(f\"An unexpected error occurred during decoding: {e}\") from e\n\n```\n\n---\n\n**`src/cyclic/cli.py`**\n```python\n\"\"\"\nCommand-line interface controller.\n\"\"\"\nimport argparse\nimport sys\nfrom typing import List, Optional\n\nfrom .service import CyclicService\nfrom .encoder import Encoder\nfrom .decoder import Decoder\nfrom .exceptions import InvalidInputError, CyclicError\nfrom . import utils\n\nclass CLIController:\n    \"\"\"Handles command-line argument parsing and orchestration of cyclic operations.\"\"\"\n    def __init__(self, service: CyclicService) -> None:\n        self._service = service\n\n    def _setup_parser(self) -> argparse.ArgumentParser:\n        \"\"\"Sets up the argument parser for the CLI.\"\"\"\n        parser = argparse.ArgumentParser(\n            description=\"Encode or decode strings using a cyclic shift.\",\n            formatter_class=argparse.RawTextHelpFormatter\n        )\n        group = parser.add_mutually_exclusive_group(required=True)\n        group.add_argument(\n            \"--encode\", action=\"store_true\", help=\"Encode the input text.\"\n        )\n        group.add_argument(\n            \"--decode\", action=\"store_true\", help=\"Decode the input text.\"\n        )\n\n        input_group = parser.add_mutually_exclusive_group(required=True)\n        input_group.add_argument(\n            \"--input\", type=str, help=\"Direct string input to process.\"\n        )\n        input_group.add_argument(\n            \"--file\", type=str, help=\"Path to a file whose content will be processed.\"\n        )\n\n        parser.add_argument(\n            \"--output\", type=str, help=\"Optional path to write the result to. If not provided, prints to stdout.\"\n        )\n        return parser\n\n    def _handle_operation(self, op_func, input_text: str, out_file: Optional[str]) -> None:\n        \"\"\"Executes the given operation function and handles output.\"\"\"\n        response = op_func(input_text)\n        if out_file:\n            utils.write_file(out_file, response.result)\n        else:\n            print(response.result)\n\n    def run(self, argv: Optional[List[str]] = None) -> int:\n        \"\"\"Runs the CLI application, processing arguments and performing the requested operation.\"\"\"\n        parser = self._setup_parser()\n        args = parser.parse_args(argv)\n\n        input_data: str\n        if args.input:\n            input_data = args.input\n        elif args.file:\n            try:\n                input_data = utils.read_file(args.file)\n            except InvalidInputError as e:\n                print(f\"Error: {e.message}\", file=sys.stderr)\n                return 1\n        else:\n            # Should not happen due to mutually_exclusive_group(required=True)\n            print(\"Error: Either --input or --file must be provided.\", file=sys.stderr)\n            return 1\n\n        try:\n            if args.encode:\n                self._handle_operation(self._service.encode, input_data, args.output)\n            elif args.decode:\n                self._handle_operation(self._service.decode, input_data, args.output)\n            return 0\n        except InvalidInputError as e:\n            print(f\"Error: {e.message}\", file=sys.stderr)\n            return 1\n        except CyclicError as e:\n            print(f\"An internal error occurred: {e.message}\", file=sys.stderr)\n            return 1\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1\n\ndef main(argv: Optional[List[str]] = None) -> None:\n    \"\"\"Entry point for the command-line interface.\"\"\"\n    encoder = Encoder()\n    decoder = Decoder()\n    service = CyclicService(encoder, decoder)\n    controller = CLIController(service)\n    sys.exit(controller.run(argv))\n\nif __name__ == \"__main__\":\n    main()\n\n```\n\n---\n\n**`src/cyclic/api.py`**\n```python\n\"\"\"\nFastAPI server adapter for exposing REST endpoints.\nThis module requires FastAPI and Uvicorn to be installed.\n\"\"\"\nfrom typing import Any, Optional\n\nfrom .service import CyclicService\nfrom .models import CyclicRequest, CyclicResponse\nfrom .exceptions import InvalidInputError, InternalError\nfrom .encoder import Encoder\nfrom .decoder import Decoder\n\n# Conditional import to avoid hard dependency if FastAPI is not installed\ntry:\n    from fastapi import FastAPI, HTTPException, status\n    from fastapi.responses import JSONResponse\nexcept ImportError:\n    FastAPI = None  # type: ignore\n    HTTPException = None  # type: ignore\n    status = None # type: ignore\n    JSONResponse = None # type: ignore\n    # print(\"FastAPI or Uvicorn not installed. API server functionality is disabled.\")\n\n\nclass APIServer:\n    \"\"\"Creates and configures a FastAPI application for cyclic operations.\"\"\"\n    def __init__(self, service: CyclicService) -> None:\n        self._service = service\n\n    def create_app(self) -> Any:\n        \"\"\"Instantiates and configures the FastAPI application.\"\"\"\n        if FastAPI is None:\n            raise RuntimeError(\n                \"FastAPI is not installed. \"\n                \"Please install with 'pip install \\\"cyclic[server]\\\"' or 'poetry install -E server'.\"\n            )\n\n        app = FastAPI(\n            title=\"Cyclic Encoder/Decoder API\",\n            description=\"API for encoding and decoding strings by cycling groups of three characters.\",\n            version=\"0.1.0\"\n        )\n\n        @app.post(\"/encode\", response_model=CyclicResponse, status_code=status.HTTP_200_OK)\n        async def encode_endpoint(request: CyclicRequest) -> CyclicResponse:\n            \"\"\"Encodes a given string using the cyclic shift algorithm.\"\"\"\n            try:\n                response = self._service.encode(request.text)\n                return response\n            except InvalidInputError as e:\n                raise HTTPException(\n                    status_code=status.HTTP_400_BAD_REQUEST,\n                    detail={\"error\": e.error_code, \"message\": e.message}\n                ) from e\n            except InternalError as e:\n                raise HTTPException(\n                    status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,\n                    detail={\"error\": e.error_code, \"message\": e.message}\n                ) from e\n            except Exception as e:\n                # Catch any other unexpected exceptions and map to InternalError\n                raise HTTPException(\n                    status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,\n                    detail={\"error\": \"internal_error\", \"message\": \"An unexpected server error occurred.\"}\n                ) from e\n\n        @app.post(\"/decode\", response_model=CyclicResponse, status_code=status.HTTP_200_OK)\n        async def decode_endpoint(request: CyclicRequest) -> CyclicResponse:\n            \"\"\"Decodes a given string using the cyclic shift algorithm.\"\"\"\n            try:\n                response = self._service.decode(request.text)\n                return response\n            except InvalidInputError as e:\n                raise HTTPException(\n                    status_code=status.HTTP_400_BAD_REQUEST,\n                    detail={\"error\": e.error_code, \"message\": e.message}\n                ) from e\n            except InternalError as e:\n                raise HTTPException(\n                    status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,\n                    detail={\"error\": e.error_code, \"message\": e.message}\n                ) from e\n            except Exception as e:\n                # Catch any other unexpected exceptions and map to InternalError\n                raise HTTPException(\n                    status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,\n                    detail={\"error\": \"internal_error\", \"message\": \"An unexpected server error occurred.\"}\n                ) from e\n\n        return app\n\n# Entry point for uvicorn (e.g., `uvicorn src.cyclic.api:app --reload`)\n_encoder = Encoder()\n_decoder = Decoder()\n_service = CyclicService(_encoder, _decoder)\n_api_server = APIServer(_service)\napp = _api_server.create_app() if FastAPI else None # Assign app if FastAPI is available\n```"}
{"task_id": "HumanEval/39", "solution": "```python\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    Fibonacci sequence considered: 0, 1, 1, 2, 3, 5, 8, ...\n    \"\"\"\n\n    def is_prime(num: int) -> bool:\n        \"\"\"\n        Performs Miller-Rabin primality test with deterministic witnesses for numbers up to 64-bit.\n        Handles small numbers with initial checks.\n        \"\"\"\n        if num < 2: return False\n        if num == 2 or num == 3: return True\n        if num % 2 == 0: return False\n\n        # Deterministic Miller-Rabin witnesses for numbers up to ~3.3 * 10^24.\n        # These are suitable for the specified 64-bit range and larger.\n        witnesses = [2, 325, 9375, 28178, 450775, 9780504, 1795265022]\n\n        d = num - 1\n        s = 0\n        while d % 2 == 0:\n            d //= 2\n            s += 1\n\n        for a in witnesses:\n            if a >= num:\n                continue\n\n            x = pow(a, d, num)\n            if x == 1 or x == num - 1:\n                continue\n\n            for _ in range(s - 1):\n                x = pow(x, 2, num)\n                if x == num - 1:\n                    break\n            else:\n                return False\n\n        return True\n\n    def fibonacci_generator():\n        \"\"\"\n        Yields Fibonacci numbers iteratively, starting 0, 1, 1, 2, 3, ...\n        \"\"\"\n        a, b = 0, 1\n        while True:\n            yield a\n            a, b = b, a + b\n\n    prime_count = 0\n    gen = fibonacci_generator()\n\n    for fib_num in gen:\n        # According to business rules, only Fibonacci values > 1 are prime candidates.\n        # This skips 0, 1, 1 from the sequence.\n        if fib_num <= 1:\n            continue\n\n        if is_prime(fib_num):\n            prime_count += 1\n            if prime_count == n:\n                return fib_num\n\n```"}
