{"task_id": "HumanEval/1", "solution": "from typing import List\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    sanitized_s = ''.join(ch for ch in paren_string if ch in '()')\n    groups = []\n    current_group_buffer = []\n    depth = 0\n\n    for char in sanitized_s:\n        if char == '(':\n            current_group_buffer.append(char)\n            depth += 1\n        elif char == ')':\n            # Only process ')' if currently within a group; ignore unmatched closing parentheses at depth 0.\n            if depth > 0:\n                current_group_buffer.append(char)\n                depth -= 1\n                if depth == 0:\n                    # Group completed: add to results and reset buffer.\n                    groups.append(\"\".join(current_group_buffer))\n                    current_group_buffer = []\n    return groups"}
{"task_id": "HumanEval/1", "solution": "```python\nfrom typing import List\n\n# --- BEGIN inline definitions ---\n\n# From src/paren_splitter/utils.py\nWHITESPACE_CHARS = {' ', '\\t', '\\n', '\\r'}\n\ndef is_whitespace(ch: str) -> bool:\n    \"\"\"Checks if a character is considered whitespace.\"\"\"\n    return ch in WHITESPACE_CHARS\n\n# From src/paren_splitter/config.py\nALLOWED_CHARS = {'(', ')'}\n\n# From src/paren_splitter/exceptions.py\n# These exceptions are defined but will NOT be raised due to critical requirements.\nclass ParenError(Exception):\n    \"\"\"Base exception for the parenthesis splitter library.\"\"\"\n    pass\n\nclass MalformedParenthesesError(ParenError):\n    \"\"\"Raised when parentheses are unbalanced or extra closing bracket found.\"\"\"\n    pass\n\nclass InvalidCharacterError(ParenError):\n    \"\"\"Raised when input contains characters other than whitespace and '(' or ')'. \"\"\"\n    pass\n\n# From src/paren_splitter/tokenizer.py\nclass Tokenizer:\n    \"\"\"Cleans input string by removing whitespace and filtering non-paren characters.\"\"\"\n    def clean_input(self, paren_string: str) -> str:\n        \"\"\"Removes whitespace and keeps only allowed characters.\"\"\"\n        result_chars = []\n        for ch in paren_string:\n            if is_whitespace(ch):\n                continue\n            if ch not in ALLOWED_CHARS:\n                # Invalid characters are silently ignored, as raising exceptions is forbidden.\n                continue\n            result_chars.append(ch)\n        return \"\".join(result_chars)\n\n# From src/paren_splitter/parser.py\nclass ParenParser:\n    \"\"\"Extracts balanced parenthesis groups from a cleaned input string.\"\"\"\n    def extract_groups(self, clean_input: str) -> List[str]:\n        \"\"\"Scans cleaned input to identify and collect balanced groups.\"\"\"\n        if not clean_input:\n            return []\n\n        result: List[str] = []\n        current_group_buffer: List[str] = []\n        depth = 0\n\n        for ch in clean_input:\n            if ch == '(':\n                depth += 1\n            elif ch == ')':\n                depth -= 1\n\n            current_group_buffer.append(ch)\n\n            # If depth drops to 0, and we have content in the buffer, it's a complete balanced group.\n            if depth == 0 and current_group_buffer:\n                result.append(\"\".join(current_group_buffer))\n                current_group_buffer = []\n            # Critical requirements forbid raising exceptions for malformed input.\n            # This logic implicitly discards malformed segments if they don't form balanced groups.\n\n        return result\n\n# From src/paren_splitter/validator.py\nclass Validator:\n    \"\"\"Defensively checks if a parenthesis group is balanced.\"\"\"\n    def is_balanced(self, group: str) -> bool:\n        \"\"\"Checks balance by scanning with a counter.\"\"\"\n        depth = 0\n        for ch in group:\n            if ch == '(':\n                depth += 1\n            elif ch == ')':\n                depth -= 1\n            if depth < 0:\n                return False\n        return depth == 0\n\n    def validate_group(self, group: str) -> None:\n        \"\"\"Performs a defensive check; no exception is raised due to critical requirements.\"\"\"\n        pass # Raising exceptions is forbidden.\n\n# --- END inline definitions ---\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    \"\"\"\n    tokenizer = Tokenizer()\n    parser = ParenParser()\n    validator = Validator()\n\n    cleaned = tokenizer.clean_input(paren_string)\n    groups = parser.extract_groups(cleaned)\n\n    # Validate each group defensively, but do not raise exceptions as forbidden.\n    for g in groups:\n        validator.validate_group(g)\n\n    return groups\n```"}
{"task_id": "HumanEval/0", "solution": "```python\nfrom typing import List\n\n\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    if len(numbers) < 2:\n        return False\n\n    sorted_numbers = sorted(numbers)\n\n    for i in range(len(sorted_numbers) - 1):\n        if abs(sorted_numbers[i+1] - sorted_numbers[i]) < threshold:\n            return True\n\n    return False\n```"}
{"task_id": "HumanEval/0", "solution": "```python\nimport math\nfrom typing import List\n\n\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    # Filter out NaN values; they cannot be meaningfully compared for closeness.\n    valid_numbers = [x for x in numbers if not math.isnan(x)]\n\n    # Sort the numbers to efficiently check only adjacent pairs for closeness.\n    valid_numbers.sort()\n\n    for i in range(1, len(valid_numbers)):\n        # Compare adjacent elements; the problem implies strict inequality (< threshold).\n        if abs(valid_numbers[i] - valid_numbers[i-1]) < threshold:\n            return True\n            \n    return False\n```"}
