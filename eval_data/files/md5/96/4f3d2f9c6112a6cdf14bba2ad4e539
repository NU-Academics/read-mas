{"task_id": "HumanEval/17", "solution": "```python\nfrom typing import List\n\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\"Parses a musical note string into a list of beat durations.\n    Legend: 'o'=4 beats, 'o|'=2 beats, '.|'=1 beat.\n    >>> parse_music('o o| .| o| o| .| .| .| .| o o')\n    [4, 2, 1, 2, 2, 1, 1, 1, 1, 4, 4]\n    \"\"\"\n    note_map = {\n        'o': 4,\n        'o|': 2,\n        '.|': 1\n    }\n    \n    # Split the input string by whitespace to get individual note tokens.\n    tokens = music_string.split()\n    \n    durations = []\n    # Map each token to its corresponding beat duration.\n    for token in tokens:\n        durations.append(note_map[token])\n        \n    return durations\n```"}
{"task_id": "HumanEval/18", "solution": "```python\ndef how_many_times(string: str, substring: str) -> int:\n    \"\"\"Find how many times a given substring occurs in the original string, including overlaps.\n    An empty source string returns 0, and an empty substring counts all positional occurrences.\n    \"\"\"\n    count = 0\n    start_index = 0\n    while True:\n        idx = string.find(substring, start_index)\n        if idx == -1:\n            break\n        count += 1\n        start_index = idx + 1\n    return count\n```"}
{"task_id": "HumanEval/18", "solution": "def how_many_times(string: str, substring: str) -> int:\n    \"\"\" Find how many times a given substring can be found in the original string.\n    Count overlapping cases, and an empty substring counts as 0 occurrences.\n    \"\"\"\n    if substring == \"\":\n        return 0\n\n    count = 0\n    start = 0\n    while True:\n        idx = string.find(substring, start)\n        if idx == -1:\n            break\n        count += 1\n        start = idx + 1\n    return count"}
{"task_id": "HumanEval/19", "solution": "```python\nfrom typing import List\n\ndef sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Return the string with numbers sorted from smallest to largest\n    \"\"\"\n    _WORD_TO_VALUE = {\n        \"zero\": 0, \"one\": 1, \"two\": 2, \"three\": 3, \"four\": 4,\n        \"five\": 5, \"six\": 6, \"seven\": 7, \"eight\": 8, \"nine\": 9\n    }\n\n    # Normalize input: trim, collapse multiple spaces, convert to lowercase.\n    # Split on space to get individual word tokens.\n    tokens = \" \".join(numbers.strip().lower().split()).split(\" \")\n\n    if not tokens or (len(tokens) == 1 and not tokens[0]):\n        return \"\"\n\n    # Map valid word tokens to their numeric values while retaining the word.\n    # Invalid tokens are ignored as per the \"CRITICAL REQUIREMENTS\" to not raise exceptions.\n    numeric_tokens = []\n    for token in tokens:\n        if token in _WORD_TO_VALUE:\n            numeric_tokens.append((_WORD_TO_VALUE[token], token))\n\n    # Sort the tokens based on their numeric values.\n    numeric_tokens.sort(key=lambda x: x[0])\n\n    # Convert sorted numeric tokens back to space-delimited words.\n    sorted_words = [token_word for _, token_word in numeric_tokens]\n    return \" \".join(sorted_words)\n```"}
{"task_id": "HumanEval/20", "solution": "from typing import List, Tuple\nfrom math import inf\n\ndef find_closest_elements(numbers: List[float]) -> Tuple[float, float]:\n    \"\"\"\n    Selects two closest numbers from a list, returning them ordered (smaller, larger).\n    Handles duplicates, returning them if they are the closest.\n    \"\"\"\n    nums_sorted = sorted(numbers)\n    \n    best_diff = float(inf)\n    best_pair = (nums_sorted[0], nums_sorted[1])\n\n    for i in range(len(nums_sorted) - 1):\n        a, b = nums_sorted[i], nums_sorted[i+1]\n        diff = b - a\n        \n        if diff < best_diff:\n            best_diff = diff\n            best_pair = (a, b)\n            \n    return best_pair"}
{"task_id": "HumanEval/19", "solution": "from typing import List, Dict, Tuple\n\n# Mappings for numeral words to integers and vice-versa.\n_WORD_TO_INT: Dict[str, int] = {\n    \"zero\": 0, \"one\": 1, \"two\": 2, \"three\": 3, \"four\": 4,\n    \"five\": 5, \"six\": 6, \"seven\": 7, \"eight\": 8, \"nine\": 9\n}\n_INT_TO_WORD: Dict[int, str] = {v: k for k, v in _WORD_TO_INT.items()}\n\ndef _tokenize(numbers: str) -> List[str]:\n    \"\"\"Splits a string by whitespace and returns a list of normalized, lowercased tokens.\n    Handles empty or all-whitespace input by returning an empty list.\"\"\"\n    if numbers is None:\n        return []\n    s = numbers.strip()\n    if not s:\n        return []\n    return [token.lower() for token in s.split()]\n\ndef _from_str(token: str) -> int:\n    \"\"\"Returns the integer value for a given numeral word token.\n    Assumes the token is valid and lowercased.\"\"\"\n    return _WORD_TO_INT[token]\n\ndef _to_str(value: int) -> str:\n    \"\"\"Returns the canonical numeral word for a given integer value.\n    Assumes the value is within the 0-9 range.\"\"\"\n    return _INT_TO_WORD[value]\n\ndef sort_numbers(numbers: str) -> str:\n    \"\"\"Input is a space-delimited string of numerals from 'zero' to 'nine'.\n    Returns the string with numbers sorted from smallest to largest.\"\"\"\n\n    tokens = _tokenize(numbers)\n\n    if not tokens:\n        return \"\"\n\n    parsed_tokens: List[Tuple[str, int]] = []\n    for original_token in tokens:\n        int_value = _from_str(original_token)\n        parsed_tokens.append((original_token, int_value))\n\n    parsed_tokens.sort(key=lambda item: item[1])\n\n    sorted_words = [_to_str(value) for _, value in parsed_tokens]\n\n    return \" \".join(sorted_words)"}
{"task_id": "HumanEval/20", "solution": "from typing import List, Tuple\n\n\ndef find_closest_elements(numbers: List[float]) -> Tuple[float, float]:\n    \"\"\"\n    From a supplied list of numbers (of length at least two) select and return two that are the closest to each\n    other and return them in order (smaller number, larger number).\n    \"\"\"\n    sorted_numbers = sorted(numbers)\n\n    closest_pair = (sorted_numbers[0], sorted_numbers[1])\n    min_diff = closest_pair[1] - closest_pair[0]\n\n    for i in range(1, len(sorted_numbers)):\n        current_pair = (sorted_numbers[i - 1], sorted_numbers[i])\n        current_diff = current_pair[1] - current_pair[0]\n\n        if current_diff < min_diff:\n            min_diff = current_diff\n            closest_pair = current_pair\n\n    return closest_pair"}
{"task_id": "HumanEval/21", "solution": "from typing import List\n\n\ndef rescale_to_unit(numbers: List[float]) -> List[float]:\n    \"\"\"Given list of numbers, apply a linear transform to map its min to 0.0 and max to 1.0.\n    This function assumes valid input and does not handle edge cases like zero range.\n    \"\"\"\n    min_val = min(numbers)\n    max_val = max(numbers)\n    span = max_val - min_val\n    scaled_numbers = [(num - min_val) / span for num in numbers]\n    return scaled_numbers"}
{"task_id": "HumanEval/21", "solution": "from typing import List\n\n\ndef rescale_to_unit(numbers: List[float]) -> List[float]:\n    \"\"\"Given a list of numbers, linearly transform them such that the minimum becomes 0 and the maximum becomes 1.\n    This function expects valid numeric inputs and performs direct scaling.\n    \"\"\"\n    min_value = min(numbers)\n    max_value = max(numbers)\n    data_range = max_value - min_value\n\n    # If data_range is 0.0, division will result in NaN, as per \"simplest, most direct logic\".\n    if data_range == 0.0:\n        return [float('nan')] * len(numbers)\n    else:\n        return [(x - min_value) / data_range for x in numbers]"}
