threshold([1, 2, 3], 5)\nprint(f\"All below threshold: {result}\")\n\n# Using the service (for more details and auditing)\nrepo = InMemoryRepository() # Or FileAuditRepository(\"audit.json\")\nchecker = BelowThresholdChecker()\nservice = ThresholdService(repo, checker)\n\ndto = service.check([10, 20, 5], 30)\nprint(f\"Service Check Result: {dto.to_dict()}\")\n\ndto_fail = service.check([10, 20, 50], 30)\nprint(f\"Service Check Result (Fail): {dto_fail.to_dict()}\")\n\n# Access audit logs\n# print(repo.all())\n```\n\n### CLI\n```bash\n# Check with comma-separated values\nnumutils-check --values \"1,2,3,4\" --threshold 5\n# Output: All values are below threshold 5.0. Max: 4.0, Count: 4. Exit Code: 0\n\n# Check with JSON array\nnumutils-check -v \"[10, 20, 5]\" -t 30\n# Output: All values are below threshold 30.0. Max: 20.0, Count: 3. Exit Code: 0\n\nnumutils-check -v \"[10, 20, 50]\" -t 30\n# Output: Not all values are below threshold 30.0. Max: 50.0, Count: 3. Exit Code: 2\n\n# Invalid input\nnumutils-check -v \"1,two,3\" -t 5\n# Output: Error: Non-numeric value: 'two'. Exit Code: 1\n```\n\n### REST API\nTo start the API server:\n```bash\npython -m numutils.api_server --host 0.0.0.0 --port 8000 --audit-file audit.json\n```\n\nThen make requests using `curl` or a similar tool:\n```bash\n# example_api_call.sh\ncurl -X POST http://127.0.0.1:8000/check \\\n     -H \"Content-Type: application/json\" \\\n     -d '{\"values\": [1, 2, 4, 10], \"threshold\": 100}'\n\n# Expected 200 OK:\n# {\"result\": true, \"count\": 4, \"max_value\": 10.0, \"timestamp\": \"...\", \"error\": null}\n\ncurl -X POST http://127.0.0.1:8000/check \\\n     -H \"Content-Type: application/json\" \\\n     -d '{\"values\": [1, 20, 4, 10], \"threshold\": 5}'\n\n# Expected 200 OK (with result false):\n# {\"result\": false, \"count\": 4, \"max_value\": 20.0, \"timestamp\": \"...\", \"error\": null}\n\ncurl -X POST http://127.0.0.1:8000/check \\\n     -H \"Content-Type: application/json\" \\\n     -d '{\"values\": [1, \"two\", 4], \"threshold\": 5}'\n\n# Expected 400 Bad Request:\n# {\"detail\":[{\"type\":\"float_type\",\"loc\":[\"body\",\"values\",1],\"msg\":\"Input should be a valid 'float'\",\"input\":\"two\"}]}\n```\n```python\n# LICENSE\nMIT License\n\nCopyright (c) 2023 Your Name\n\nPermission is hereby granted, free of charge, to any person obtaining a copy\nof this software and associated documentation files (the \"Software\"), to deal\nin the Software without restriction, including without limitation the rights\nto use, copy, modify, merge, publish, distribute, sublicense, and/or sell\ncopies of the Software, and to permit persons to whom the Software is\nfurnished to do so, subject to the following conditions:\n\nThe above copyright notice and this permission notice shall be included in all\ncopies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\nIMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\nFITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\nAUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\nLIABILITY, WHETHER IN AN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\nOUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\nSOFTWARE.\n```\n\n```python\n# src/numutils/__init__.py\n\"\"\"\nNumUtils: A library and service for numeric list checks.\n\nExposes a programmatic API, CLI, and REST endpoint.\n\"\"\"\n\nfrom typing import Iterable, Callable\nfrom .exceptions import BadInputError, ValidationError\nfrom .models import NumericListModel, ThresholdResultDTO\nfrom .utils import BelowThresholdChecker, below_threshold\nfrom .services import ThresholdService\nfrom .repositories import InMemoryRepository, FileAuditRepository\nfrom .controllers import CLIController\n\n__all__ = [\n    \"below_threshold\",\n    \"ThresholdService\",\n    \"BadInputError\",\n    \"ValidationError\",\n    \"NumericListModel\",\n    \"ThresholdResultDTO\",\n    \"BelowThresholdChecker\",\n    \"InMemoryRepository\",\n    \"FileAuditRepository\",\n]\n\ndef get_cli_entrypoint() -> Callable:\n    \"\"\"Returns the CLI main function for numutils-check.\"\"\"\n    from .cli import main\n    return main\n```\n\n```python\n# src/numutils/exceptions.py\n\"\"\"Custom exceptions for numutils.\"\"\"\n\nclass BadInputError(Exception):\n    \"\"\"Exception raised for invalid input data.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass ValidationError(BadInputError):\n    \"\"\"Alias for BadInputError, used for input validation issues.\"\"\"\n    pass\n```\n\n```python\n# src/numutils/models.py\n\"\"\"Domain data classes and DTOs for numutils.\"\"\"\n\nimport math\nfrom typing import Iterable, List, Optional, Dict, Any\nfrom .exceptions import BadInputError\n\nclass NumericListModel:\n    \"\"\"Encapsulates a list of numeric values and provides derived properties.\"\"\"\n    def __init__(self, values: Iterable[float]) -> None:\n        _processed_values: List[float] = []\n        for v in values:\n            try:\n                fv = float(v)\n            except (TypeError, ValueError) as e:\n                raise BadInputError(f\"Non-numeric value detected: {v!r}\") from e\n            if math.isnan(fv) or math.isinf(fv):\n                raise BadInputError(f\"NaN or infinite values are not allowed: {v!r}\")\n            _processed_values.append(fv)\n        self._values: List[float] = _processed_values\n\n    def to_list(self) -> List[float]:\n        \"\"\"Return a shallow copy of the internal list.\"\"\"\n        return list(self._values)\n\n    def count(self) -> int:\n        \"\"\"Return the number of elements in the list.\"\"\"\n        return len(self._values)\n\n    def max_value(self) -> Optional[float]:\n        \"\"\"Return the maximum value or None for an empty list.\"\"\"\n        return max(self._values) if self._values else None\n\nclass ThresholdResultDTO:\n    \"\"\"Structured result for a threshold check operation.\"\"\"\n    def __init__(\n        self,\n        result: bool,\n        count: int,\n        max_value: Optional[float],\n        timestamp: str,\n        error: Optional[str] = None\n    ) -> None:\n        self.result = result\n        self.count = count\n        self.max_value = max_value\n        self.timestamp = timestamp\n        self.error = error\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Return the DTO attributes as a dictionary.\"\"\"\n        return {\n            \"result\": self.result,\n            \"count\": self.count,\n            \"max_value\": self.max_value,\n            \"timestamp\": self.timestamp,\n            \"error\": self.error,\n        }\n```\n\n```python\n# src/numutils/schemas.py\n\"\"\"Pydantic schemas for API request and response models.\"\"\"\n\nfrom typing import List, Optional\nfrom pydantic import BaseModel, Field\n\nclass ThresholdRequestSchema(BaseModel):\n    \"\"\"Schema for the POST /check request body.\"\"\"\n    values: List[float] = Field(..., description=\"List of numeric values to check.\")\n    threshold: float = Field(..., description=\"The threshold value.\")\n\nclass ThresholdResponseSchema(BaseModel):\n    \"\"\"Schema for the POST /check response body.\"\"\"\n    result: bool = Field(..., description=\"True if all values are below the threshold, False otherwise.\")\n    count: int = Field(..., description=\"Number of values processed.\")\n    max_value: Optional[float] = Field(..., description=\"Maximum value found in the list, or null if list is empty.\")\n    timestamp: str = Field(..., description=\"ISO8601 timestamp of the check operation.\")\n    error: Optional[str] = Field(None, description=\"Error message if the operation failed.\")\n```\n\n```python\n# src/numutils/utils.py\n\"\"\"Core check algorithm and helper functions.\"\"\"\n\nimport math\nfrom typing import Iterable, Tuple, Optional, List\nfrom .exceptions import BadInputError\n\nclass BelowThresholdChecker:\n    \"\"\"Implements the core algorithm for checking values below a threshold.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def check(self, values: Iterable[float], threshold: float) -> Tuple[bool, Optional[float], int]:\n        \"\"\"\n        Check if all values in an iterable are strictly less than the threshold.\n        Returns (result, max_value, processed_count).\n        \"\"\"\n        processed_count = 0\n        current_max: Optional[float] = None\n\n        for v in values:\n            if math.isnan(v) or math.isinf(v):\n                raise BadInputError(\"NaN or infinite values are not allowed in the list.\")\n            \n            if current_max is None or v > current_max:\n                current_max = v\n            \n            processed_count += 1\n            \n            if not (v < threshold):\n                return False, current_max, processed_count\n        \n        return True, current_max, processed_count\n\ndef below_threshold(values: Iterable[float], threshold: float) -> bool:\n    \"\"\"\n    Return True if all numbers in the iterable are strictly below threshold.\n    This is a convenience wrapper around BelowThresholdChecker.\n    \"\"\"\n    checker = BelowThresholdChecker()\n    result, _, _ = checker.check(values, threshold)\n    return result\n```\n\n```python\n# src/numutils/repositories.py\n\"\"\"Persistence adapters for audit logs.\"\"\"\n\nimport json\nimport os\nimport tempfile\nimport shutil\nfrom typing import Dict, Any, List\n\nDEFAULT_AUDIT_FILE = \"audit.json\"\n\nclass InMemoryRepository:\n    \"\"\"Stores audit records in memory.\"\"\"\n    def __init__(self) -> None:\n        self._records: List[Dict[str, Any]] = []\n\n    def append(self, record: Dict[str, Any]) -> None:\n        \"\"\"Appends a new record to the in-memory list.\"\"\"\n        self._records.append(record)\n\n    def all(self) -> List[Dict[str, Any]]:\n        \"\"\"Returns all stored records.\"\"\"\n        return list(self._records)\n\nclass FileAuditRepository:\n    \"\"\"Provides durable append-only JSON audit logging to the filesystem.\"\"\"\n    def __init__(self, path: str = DEFAULT_AUDIT_FILE) -> None:\n        self.path = os.path.abspath(path)\n        # Ensure directory exists\n        os.makedirs(os.path.dirname(self.path), exist_ok=True)\n\n    def _read_all(self) -> List[Dict[str, Any]]:\n        \"\"\"Reads all records from the audit file.\"\"\"\n        if not os.path.exists(self.path):\n            return []\n        try:\n            with open(self.path, 'r', encoding='utf-8') as f:\n                return [json.loads(line) for line in f if line.strip()]\n        except json.JSONDecodeError as e:\n            # Handle corrupted file or invalid JSON format\n            print(f\"Warning: Audit file {self.path} is corrupted. Error: {e}\")\n            return []\n        except IOError as e:\n            print(f\"Warning: Could not read audit file {self.path}. Error: {e}\")\n            return []\n\n    def append(self, record: Dict[str, Any]) -> None:\n        \"\"\"Appends a new record to the audit file, ensuring atomic write.\"\"\"\n        try:\n            with tempfile.NamedTemporaryFile(mode='a', delete=False, encoding='utf-8') as temp_f:\n                json.dump(record, temp_f)\n                temp_f.write('\\n') # Each record on a new line\n            shutil.move(temp_f.name, self.path)\n        except IOError as e:\n            print(f\"Error: Failed to append to audit file {self.path}. Error: {e}\")\n            # Log the error, but don't re-raise to caller (best-effort persist)\n        finally:\n            # Clean up temp file if move failed\n            if os.path.exists(temp_f.name):\n                os.remove(temp_f.name)\n\n    def all(self) -> List[Dict[str, Any]]:\n        \"\"\"Returns all records from the audit file.\"\"\"\n        return self._read_all()\n```\n\n```python\n# src/numutils/services.py\n\"\"\"Business logic orchestrator for threshold checks.\"\"\"\n\nfrom datetime import datetime\nimport uuid\nimport logging\nfrom typing import Iterable, Any, Optional\n\nfrom .models import NumericListModel, ThresholdResultDTO\nfrom .exceptions import BadInputError\nfrom .utils import BelowThresholdChecker\nfrom .repositories import InMemoryRepository, FileAuditRepository\n\nDEFAULT_TIMESTAMP_FORMAT = \"%Y-%m-%dT%H:%M:%SZ\"\nlogger = logging.getLogger(__name__)\n\nclass ThresholdService:\n    \"\"\"Orchestrates validation, calls checker, builds DTO, and persists audit logs.\"\"\"\n    def __init__(\n        self,\n        repo: \"InMemoryRepository | FileAuditRepository\",\n        checker: BelowThresholdChecker,\n        timestamp_fmt: str = DEFAULT_TIMESTAMP_FORMAT\n    ) -> None:\n        self.repo = repo\n        self.checker = checker\n        self.timestamp_fmt = timestamp_fmt\n\n    def _validate_inputs(self, values: Any, threshold: Any) -> NumericListModel:\n        \"\"\"\n        Validates raw inputs (values, threshold) against expected types.\n        Returns a NumericListModel on success.\n        \"\"\"\n        if not isinstance(threshold, (int, float)):\n            raise BadInputError(f\"Threshold must be numeric, got {type(threshold).__name__!r}.\")\n        \n        # NumericListModel constructor handles validation for 'values' iterable\n        try:\n            model = NumericListModel(values)\n        except BadInputError as e:\n            raise BadInputError(f\"Invalid values list: {e.message}\") from e\n        except TypeError as e:\n            raise BadInputError(f\"Values must be an iterable: {e}\") from e\n\n        return model\n\n    def check(self, values: Iterable[float], threshold: float) -> ThresholdResultDTO:\n        \"\"\"\n        Performs the threshold check, records audit, and returns a DTO.\n        Errors during persistence are logged but not re-raised.\n        \"\"\"\n        error_message: Optional[str] = None\n        current_max: Optional[float] = None\n        processed_count: int = 0\n        is_below_threshold: bool = False\n        \n        try:\n            numeric_list_model = self._validate_inputs(values, threshold)\n            \n            # The checker expects a List[float] but can also handle Iterable[float]\n            # to_list() ensures consistency after NumericListModel's internal processing\n            is_below_threshold, current_max, processed_count = \\\n                self.checker.check(numeric_list_model.to_list(), float(threshold))\n            \n            result_dto = ThresholdResultDTO(\n                result=is_below_threshold,\n                count=processed_count,\n                max_value=current_max,\n                timestamp=datetime.utcnow().strftime(self.timestamp_fmt),\n                error=None\n            )\n            \n        except BadInputError as e:\n            error_message = str(e)\n            # For bad input, we still return a DTO, but with success=False and an error\n            result_dto = ThresholdResultDTO(\n                result=False,\n                count=processed_count, # May be 0 or partial\n                max_value=current_max, # May be None or partial\n                timestamp=datetime.utcnow().strftime(self.timestamp_fmt),\n                error=error_message\n            )\n            logger.warning(f\"Bad input for check: {error_message}\")\n            # Re-raise for callers that need to handle it (like controllers)\n            raise e \n        except Exception as e:\n            error_message = f\"An unexpected error occurred: {type(e).__name__}: {e}\"\n            result_dto = ThresholdResultDTO(\n                result=False,\n                count=processed_count,\n                max_value=current_max,\n                timestamp=datetime.utcnow().strftime(self.timestamp_fmt),\n                error=error_message\n            )\n            logger.exception(\"Unexpected error during threshold check.\")\n            raise  # Re-raise unexpected exceptions\n\n        # Best-effort persist audit record\n        try:\n            audit_record = {\n                \"id\": str(uuid.uuid4()),\n                \"timestamp\": result_dto.timestamp,\n                \"values_count\": result_dto.count,\n                \"max_value\": result_dto.max_value,\n                \"threshold\": threshold,\n                \"result\": result_dto.result,\n                \"error\": result_dto.error,\n                # \"raw_values\": list(values) # Optional for debug, but can be large\n            }\n            self.repo.append(audit_record)\n        except Exception as e:\n            logger.error(f\"Failed to persist audit record: {e}\")\n            # Do not re-raise, as this is best-effort\n\n        return result_dto\n```\n\n```python\n# src/numutils/controllers.py\n\"\"\"CLI and API controllers for numutils.\"\"\"\n\nimport argparse\nimport json\nimport os\nimport sys\nfrom typing import List, Optional, Any, Callable\n\n# Conditional import for FastAPI components\ntry:\n    from fastapi import FastAPI, HTTPException, Request, status\n    from fastapi.responses import JSONResponse\n    from pydantic import ValidationError as PydanticValidationError\n    from .schemas import ThresholdRequestSchema, ThresholdResponseSchema\n    FASTAPI_AVAILABLE = True\nexcept ImportError:\n    FASTAPI_AVAILABLE = False\n    class FastAPI: pass # Dummy for type hinting if not available\n    class HTTPException: pass\n\nfrom .exceptions import BadInputError\nfrom .models import ThresholdResultDTO\nfrom .services import ThresholdService\nfrom .repositories import InMemoryRepository, FileAuditRepository\nfrom .utils import BelowThresholdChecker\n\nCLI_EXIT_OK = 0\nCLI_EXIT_INVALID = 1\nCLI_EXIT_FAILED = 2\n\nclass CLIController:\n    \"\"\"Handles command line interface interactions.\"\"\"\n    def __init__(self, service: ThresholdService) -> None:\n        self.service = service\n\n    def run_cli(self, argv: List[str]) -> int:\n        \"\"\"\n        Parses CLI arguments, performs the check, prints output, and returns an exit code.\n        \"\"\"\n        parser = argparse.ArgumentParser(\n            description=\"Check if all numeric values in a list are below a threshold.\",\n            formatter_class=argparse.ArgumentDefaultsHelpFormatter\n        )\n        parser.add_argument(\n            \"-v\", \"--values\",\n            required=True,\n            help=\"Comma-separated list of numbers (e.g., '1,2,3') or a JSON array string (e.g., '[1,2,3]').\"\n        )\n        parser.add_argument(\n            \"-t\", \"--threshold\",\n            type=float,\n            required=True,\n            help=\"The numeric threshold.\"\n        )\n        parser.add_argument(\n            \"--audit-file\",\n            type=str,\n            default=None,\n            help=f\"Path to an audit JSON file. Defaults to in-memory if not provided.\"\n        )\n\n        args = parser.parse_args(argv if argv else sys.argv[1:])\n\n        # Parse values input\n        try:\n            if args.values.startswith('[') and args.values.endswith(']'):\n                values_list = json.loads(args.values)\n            else:\n                values_list = [float(x.strip()) for x in args.values.split(',') if x.strip()]\n        except (ValueError, json.JSONDecodeError) as e:\n            print(f\"Error: Invalid values format. Please provide comma-separated numbers or a valid JSON array. Details: {e}\", file=sys.stderr)\n            return CLI_EXIT_INVALID\n\n        try:\n            result_dto = self.service.check(values_list, args.threshold)\n            print(f\"Threshold: {args.threshold}\")\n            print(f\"Count: {result_dto.count}\")\n            print(f\"Max Value: {result_dto.max_value}\")\n            if result_dto.result:\n                print(f\"Result: All values are below threshold {args.threshold}.\")\n                return CLI_EXIT_OK\n            else:\n                print(f\"Result: Not all values are below threshold {args.threshold}.\")\n                return CLI_EXIT_FAILED\n        except BadInputError as e:\n            print(f\"Error: {e.message}\", file=sys.stderr)\n            return CLI_EXIT_INVALID\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return CLI_EXIT_INVALID # Map unexpected errors to invalid input for CLI\n\nif FASTAPI_AVAILABLE:\n    class APIController:\n        \"\"\"Constructs and manages the FastAPI application.\"\"\"\n        def __init__(self, service: ThresholdService) -> None:\n            self.service = service\n            self.app = FastAPI(title=\"numutils_api\", description=\"Numeric Utilities API\")\n\n            # Add API key security if environment variable is set\n            api_key = os.getenv(\"NUMUTILS_API_KEY\")\n            if api_key:\n                @self.app.middleware(\"http\")\n                async def verify_api_key(request: Request, call_next):\n                    if request.url.path == \"/check\": # Only secure the /check endpoint for this example\n                        if request.headers.get(\"X-API-Key\") != api_key:\n                            return JSONResponse(\n                                status_code=status.HTTP_401_UNAUTHORIZED,\n                                content={\"detail\": \"Unauthorized: Invalid API Key\"}\n                            )\n                    response = await call_next(request)\n                    return response\n\n            self._register_routes()\n\n        def _register_routes(self) -> None:\n            \"\"\"Registers API endpoints to the FastAPI application.\"\"\"\n            @self.app.post(\"/check\", response_model=ThresholdResponseSchema)\n            def check_endpoint(req: ThresholdRequestSchema):\n                \"\"\"\n                Checks if all provided numeric values are strictly below the given threshold.\n                \"\"\"\n                try:\n                    dto = self.service.check(req.values, req.threshold)\n                    return ThresholdResponseSchema(**dto.to_dict())\n                except BadInputError as e:\n                    raise HTTPException(status_code=400, detail=e.message)\n                except PydanticValidationError as e:\n                    # This should ideally be caught by FastAPI's default handler,\n                    # but explicit re-raising ensures consistency for BadInputError context.\n                    raise HTTPException(status_code=400, detail=e.errors())\n                except Exception as e:\n                    raise HTTPException(status_code=500, detail=f\"Internal server error: {e}\")\n\n        def create_app(self) -> FastAPI:\n            \"\"\"Returns the configured FastAPI application instance.\"\"\"\n            return self.app\nelse:\n    class APIController: # Dummy class if FastAPI is not available\n        def __init__(self, service: ThresholdService) -> None:\n            raise RuntimeError(\"FastAPI is not installed. Install with `pip install numutils[rest]`\")\n        def create_app(self) -> FastAPI:\n            raise RuntimeError(\"FastAPI is not installed. Install with `pip install numutils[rest]`\")\n```\n\n```python\n# src/numutils/cli.py\n\"\"\"CLI entry point script for numutils-check.\"\"\"\n\nimport sys\nfrom typing import List, Optional\n\nfrom .services import ThresholdService\nfrom .repositories import InMemoryRepository, FileAuditRepository\nfrom .utils import BelowThresholdChecker\nfrom .controllers import CLIController\n\ndef main(argv: Optional[List[str]] = None) -> int:\n    \"\"\"\n    Main entry point for the numutils-check CLI command.\n    Initializes service and controller, then runs the CLI.\n    \"\"\"\n    # Create the core components\n    checker = BelowThresholdChecker()\n    \n    # Initialize a temporary argparse to get audit_file path first\n    parser = argparse.ArgumentParser(add_help=False) # Don't parse all args yet\n    parser.add_argument(\"--audit-file\", type=str, default=None)\n    known_args, _ = parser.parse_known_args(argv if argv else sys.argv[1:])\n\n    # Choose repository based on --audit-file flag\n    if known_args.audit_file:\n        repo = FileAuditRepository(known_args.audit_file)\n    else:\n        repo = InMemoryRepository()\n\n    service = ThresholdService(repo=repo, checker=checker)\n    controller = CLIController(service=service)\n    \n    return controller.run_cli(argv)\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n```\n\n```python\n# src/numutils/api_server.py\n\"\"\"REST server launcher for the numutils API.\"\"\"\n\nimport argparse\nimport sys\nimport logging\nfrom typing import Optional\n\n# Conditional import for FastAPI and uvicorn\ntry:\n    import uvicorn\n    from .controllers import APIController\n    from .services import ThresholdService\n    from .repositories import InMemoryRepository, FileAuditRepository\n    from .utils import BelowThresholdChecker\n    FASTAPI_AVAILABLE = True\nexcept ImportError:\n    FASTAPI_AVAILABLE = False\n    print(\"Error: FastAPI and/or Uvicorn are not installed. \"\n          \"Install with `pip install numutils[rest]` to run the API server.\", file=sys.stderr)\n    sys.exit(1)\n\nlogger = logging.getLogger(__name__)\n\ndef run_api(\n    host: str = \"127.0.0.1\",\n    port: int = 8000,\n    repo_path: Optional[str] = None,\n    log_level: str = \"info\"\n) -> None:\n    \"\"\"\n    Runs the FastAPI application using Uvicorn.\n    Initializes the ThresholdService with appropriate repository.\n    \"\"\"\n    if not FASTAPI_AVAILABLE:\n        sys.exit(1) # Exit immediately if dependencies are missing\n\n    logging.basicConfig(level=getattr(logging, log_level.upper()),\n                        format='%(asctime)s - %(name)s - %(levelname)s - %(message)s')\n\n    checker = BelowThresholdChecker()\n    if repo_path:\n        repo = FileAuditRepository(repo_path)\n        logger.info(f\"Using FileAuditRepository at: {repo_path}\")\n    else:\n        repo = InMemoryRepository()\n        logger.info(\"Using InMemoryRepository (no persistence for audit logs).\")\n\n    service = ThresholdService(repo=repo, checker=checker)\n    controller = APIController(service=service)\n    app = controller.create_app()\n\n    logger.info(f\"Starting API server on http://{host}:{port}\")\n    uvicorn.run(app, host=host, port=port, log_level=log_level)\n\nif __name__ == \"__main__\":\n    parser = argparse.ArgumentParser(\n        description=\"Run the NumUtils REST API server.\",\n        formatter_class=argparse.ArgumentDefaultsHelpFormatter\n    )\n    parser.add_argument(\"--host\", type=str, default=\"127.0.0.1\", help=\"Host address to bind to.\")\n    parser.add_argument(\"--port\", type=int, default=8000, help=\"Port to listen on.\")\n    parser.add_argument(\"--audit-file\", type=str, default=None,\n                        help=\"Path to an audit JSON file. If not provided, uses in-memory logging.\")\n    parser.add_argument(\"--log-level\", type=str, default=\"info\",\n                        choices=[\"debug\", \"info\", \"warning\", \"error\", \"critical\"],\n                        help=\"Set the logging level.\")\n\n    args = parser.parse_args()\n\n    run_api(\n        host=args.host,\n        port=args.port,\n        repo_path=args.audit_file,\n        log_level=args.log_level\n    )\n```"}
