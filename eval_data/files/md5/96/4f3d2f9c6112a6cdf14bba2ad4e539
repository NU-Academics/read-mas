{"task_id": "HumanEval/16", "solution": "```python\n# src/textutils/exceptions.py\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input scenarios.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\n```python\n# src/textutils/models.py\nclass TextInput:\n    \"\"\"Data Transfer Object for validated text input.\"\"\"\n    def __init__(self, text: str, ignore_spaces: bool = False) -> None:\n        self.text = text\n        self.ignore_spaces = ignore_spaces\n\n```python\n# src/textutils/utils.py\nimport string\n\ndef normalize_text(text: str, ignore_spaces: bool = False) -> str:\n    \"\"\"Applies Unicode case folding and optional whitespace removal.\"\"\"\n    normalized = text.casefold()\n    if ignore_spaces:\n        # Remove all whitespace characters\n        normalized = normalized.translate(str.maketrans('', '', string.whitespace))\n    return normalized\n\ndef is_str(obj: object) -> bool:\n    \"\"\"Checks if an object is an instance of str.\"\"\"\n    return isinstance(obj, str)\n\n```python\n# src/textutils/validators.py\nfrom textutils.models import TextInput\nfrom textutils.exceptions import InvalidInputError\nfrom textutils.utils import normalize_text, is_str\n\nclass Validator:\n    \"\"\"Validates raw input and converts it into a TextInput DTO.\"\"\"\n    def validate(self, text: object, ignore_spaces: bool = False) -> TextInput:\n        \"\"\"Ensures input is a string, normalizes it, and returns TextInput.\"\"\"\n        if not is_str(text):\n            raise InvalidInputError(\"Input must be a string.\")\n        \n        normalized = normalize_text(text, ignore_spaces=ignore_spaces)\n        return TextInput(normalized, ignore_spaces=ignore_spaces)\n\n```python\n# src/textutils/services.py\nfrom textutils.models import TextInput\n\nclass CharacterCounterService:\n    \"\"\"Provides the core business logic for counting distinct characters.\"\"\"\n    def count_distinct_characters(self, text_input: TextInput) -> int:\n        \"\"\"Counts the number of distinct characters in the provided TextInput.\"\"\"\n        if not isinstance(text_input, TextInput):\n            raise TypeError(\"Expected TextInput DTO.\")\n        # text_input.text is already normalized (casefolded, spaces removed if ignore_spaces is true)\n        return len(set(text_input.text))\n\n```python\n# src/textutils/controllers.py\nimport sys\nfrom textutils.services import CharacterCounterService\nfrom textutils.validators import Validator\nfrom textutils.exceptions import InvalidInputError\n\nclass CLIController:\n    \"\"\"Orchestrates CLI requests by validating input and invoking the service.\"\"\"\n    def __init__(self, service: CharacterCounterService, validator: Validator) -> None:\n        self.service = service\n        self.validator = validator\n\n    def run(self, text: object, ignore_spaces: bool = False) -> int:\n        \"\"\"Validates input, computes character count, and prints the result or error.\"\"\"\n        try:\n            text_input = self.validator.validate(text, ignore_spaces)\n            count = self.service.count_distinct_characters(text_input)\n            print(format_output(count))\n            return 0\n        except InvalidInputError as e:\n            print(f\"Error: {e.message}\", file=sys.stderr)\n            return 2\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1\n\ndef format_output(count: int) -> str:\n    \"\"\"Formats the integer count for display.\"\"\"\n    return str(count)\n\n```python\n# src/textutils/__init__.py\nfrom textutils.validators import Validator\nfrom textutils.services import CharacterCounterService\nfrom textutils.exceptions import InvalidInputError\n\n__version__ = \"0.1.0\"\n\ndef count_distinct_characters(string: str, ignore_spaces: bool = False) -> int:\n    \"\"\"Counts distinct characters in a string, case-insensitively and optionally ignoring spaces.\"\"\"\n    validator = Validator()\n    service = CharacterCounterService()\n    text_input = validator.validate(string, ignore_spaces=ignore_spaces)\n    return service.count_distinct_characters(text_input)\n\n```python\n# src/bin/cli.py\nimport sys\nimport argparse\nfrom textutils.controllers import CLIController\nfrom textutils.validators import Validator\nfrom textutils.services import CharacterCounterService\n\ndef main(argv=None) -> int:\n    \"\"\"Main entry point for the textutils-count CLI.\"\"\"\n    argv = argv if argv is not None else sys.argv[1:]\n    parser = argparse.ArgumentParser(\n        prog=\"textutils-count\",\n        description=\"Count distinct characters (case-insensitive, Unicode-aware).\"\n    )\n    parser.add_argument(\"text\", help=\"Input text to analyze.\")\n    parser.add_argument(\n        \"--ignore-spaces\",\n        action=\"store_true\",\n        help=\"Ignore all whitespace characters during counting.\"\n    )\n    \n    args = parser.parse_args(argv)\n    \n    # Initialize dependencies\n    service = CharacterCounterService()\n    validator = Validator()\n    controller = CLIController(service, validator)\n    \n    return controller.run(args.text, ignore_spaces=args.ignore_spaces)\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n\n```\n```toml\n# pyproject.toml\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[project]\nname = \"textutils\"\nversion = \"0.1.0\"\ndescription = \"A utility to count distinct characters in a string.\"\nauthors = [{ name = \"Your Name\", email = \"your.email@example.com\" }]\nreadme = \"README.md\"\nrequires-python = \">=3.8\"\nlicense = { text = \"MIT\" }\nkeywords = [\"text\", \"utility\", \"character\", \"count\"]\n\n[project.scripts]\ntextutils-count = \"textutils.cli:main\"\n\n[project.optional-dependencies]\ndev = [\"pytest>=7.0\"]\n\n[tool.setuptools.packages.find]\nwhere = [\"src\"]\n\n```\n```text\n# requirements.txt\n# Development and test dependencies\npytest>=7.0\n```\n```markdown\n# README.md\n# TextUtils - Distinct Character Counter\n\n`textutils` is a Python library and command-line utility for counting the number of distinct characters in a string, case-insensitively and with Unicode support.\n\n## Features\n\n- **Case-Insensitive Counting**: Uses Unicode case folding for accurate comparisons.\n- **Whitespace Handling**: Option to ignore whitespace characters.\n- **Python Library**: Embed the functionality into your Python projects.\n- **CLI Tool**: A simple command-line interface for quick analysis.\n\n## Installation\n\nYou can install `textutils` using pip:\n\n```bash\npip install .\n# Or for development:\n# pip install -e .[dev]\n```\n\n## Usage\n\n### Command-Line Interface (CLI)\n\nThe CLI tool is named `textutils-count`.\n\n```bash\n# Count distinct characters in \"Hello World\" (case-insensitive)\ntextutils-count \"Hello World\"\n# Output: 8 (H, e, l, o, W, r, d, space)\n\n# Count distinct characters, ignoring spaces\ntextutils-count \"Hello World\" --ignore-spaces\n# Output: 7 (H, e, l, o, W, r, d)\n\n# Unicode example\ntextutils-count \"Stra\u00dfe\"\n# Output: 5 (S, t, r, a, \u00df/ss, e) - '\u00df' casefolds to 'ss'\n\n# Invalid input\ntextutils-count 123\n# Output: Error: Input must be a string. (and exits with code 2)\n```\n\n### Python Library\n\nYou can import and use the `count_distinct_characters` function in your Python code:\n\n```python\nfrom textutils import count_distinct_characters\n\n# Basic usage\ncount = count_distinct_characters(\"Hello World\")\nprint(f\"Distinct characters: {count}\")  # Output: Distinct characters: 8\n\n# Ignoring spaces\ncount_no_spaces = count_distinct_characters(\"Hello World\", ignore_spaces=True)\nprint(f\"Distinct characters (no spaces): {count_no_spaces}\") # Output: Distinct characters (no spaces): 7\n\n# Unicode example\nunicode_count = count_distinct_characters(\"Stra\u00dfe\")\nprint(f\"Distinct characters (Unicode): {unicode_count}\") # Output: Distinct characters (Unicode): 5\n\n# Handling invalid input\ntry:\n    count_distinct_characters(123)\nexcept Exception as e:\n    print(f\"Error: {e}\") # Output: Error: Input must be a string.\n```\n```"}
