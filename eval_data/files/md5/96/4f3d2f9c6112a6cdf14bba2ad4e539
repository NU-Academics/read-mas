{"task_id": "HumanEval/2", "solution": "from decimal import Decimal, getcontext\n\ndef truncate_number(number: float) -> float:\n    \"\"\"Given a positive floating point number, return its decimal part.\n    The decimal part is always smaller than 1.\n    \"\"\"\n    original_prec = getcontext().prec\n    getcontext().prec = 28\n\n    d = Decimal(str(number))\n    integer_part_decimal = d.to_integral_value(rounding=\"ROUND_FLOOR\")\n    fraction_decimal = d - integer_part_decimal\n    quantized_fraction = +fraction_decimal\n    result = float(quantized_fraction)\n\n    getcontext().prec = original_prec\n    return result"}
{"task_id": "HumanEval/4", "solution": "```python\nfrom typing import List\n\ndef kahan_sum(nums: List[float]) -> float:\n    \"\"\"Calculates a numerically stable sum of floats using Kahan summation.\n    This helps reduce floating-point errors over standard summation.\n    \"\"\"\n    total = 0.0\n    c = 0.0\n    for x in nums:\n        y = x - c\n        t = total + y\n        c = (t - total) - y\n        total = t\n    return total\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset. MAD is the average absolute difference\n    between each element and the mean.\n    \"\"\"\n    n = len(numbers)\n    mean = kahan_sum(numbers) / n\n\n    absolute_deviations = [abs(x - mean) for x in numbers]\n\n    mad = kahan_sum(absolute_deviations) / n\n\n    return mad\n```"}
{"task_id": "HumanEval/5", "solution": "```python\nfrom typing import List\n\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result: List[int] = []\n    for i, n in enumerate(numbers):\n        result.append(n)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result\n```"}
{"task_id": "HumanEval/4", "solution": "```python\nfrom typing import List\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    MAD = average | x - x_mean |\n    \"\"\"\n    # Calculate the arithmetic mean of the dataset.\n    mean_val = sum(numbers) / len(numbers)\n\n    # Calculate the sum of absolute differences from the mean.\n    sum_absolute_deviations = sum(abs(x - mean_val) for x in numbers)\n\n    # Return the mean of these absolute differences.\n    return sum_absolute_deviations / len(numbers)\n```"}
{"task_id": "HumanEval/5", "solution": "```python\nfrom typing import List\n\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers`.\n    Returns an empty list if `numbers` is empty.\n    \"\"\"\n    if not numbers:\n        return []\n\n    result: List[int] = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result\n```"}
{"task_id": "HumanEval/6", "solution": "from typing import List\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    results = []\n    groups = paren_string.split()  # Splits by whitespace and handles multiple spaces, ignoring empty strings.\n\n    for group in groups:\n        current_depth = 0\n        max_depth = 0\n        for char in group:\n            if char == '(':\n                current_depth += 1\n                if current_depth > max_depth:\n                    max_depth = current_depth\n            elif char == ')':\n                current_depth -= 1\n        results.append(max_depth)\n    return results"}
{"task_id": "HumanEval/6", "solution": "from typing import List\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each group, output the deepest level of nesting.\n    \"\"\"\n    results = []\n    # Splits the string by any whitespace, handling multiple spaces and stripping empty tokens.\n    groups = paren_string.split()\n\n    for group in groups:\n        current_depth = 0\n        max_group_depth = 0\n        for char in group:\n            if char == '(':\n                current_depth += 1\n                if current_depth > max_group_depth:\n                    max_group_depth = current_depth\n            elif char == ')':\n                current_depth -= 1\n        results.append(max_group_depth)\n    return results"}
