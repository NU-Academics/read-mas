    Integration-style test for CLI using actual service and repository,\n    including file persistence.\n    \"\"\"\n    stats_path = tmp_path / \"cli_stats.json\"\n    repo = InMemoryStatsRepository(persist_path=str(stats_path))\n    service = LongestService(repository=repo)\n    controller = CLIController(service=service)\n\n    # First call\n    exit_code = controller.run(argv=['string-longest', 'a', 'bb', 'ccc'])\n    assert exit_code == 0\n    out, err = capfd.readouterr()\n    assert out.strip() == 'ccc'\n    assert err == ''\n    assert repo.get_stats() == {'call_count': 1, 'last_result': 'ccc'}\n\n    # Second call\n    exit_code = controller.run(argv=['string-longest', 'x', 'y'])\n    assert exit_code == 0\n    out, err = capfd.readouterr()\n    assert out.strip() == 'x'\n    assert err == ''\n    assert repo.get_stats() == {'call_count': 2, 'last_result': 'x'}\n\n    # Test persistence by creating a new repo instance\n    new_repo = InMemoryStatsRepository(persist_path=str(stats_path))\n    assert new_repo.get_stats() == {'call_count': 2, 'last_result': 'x'}\n\n    # Invalid input test\n    exit_code = controller.run(argv=['string-longest', 'valid', '123', 'invalid'])\n    assert exit_code == 2\n    out, err = capfd.readouterr()\n    assert out == ''\n    assert \"Invalid input: Element at index 1 is not a string: int\" in err\n    # Stats should still reflect previous valid calls, as this one failed validation before stats update\n    assert repo.get_stats() == {'call_count': 2, 'last_result': 'x'}\n\n\ndef test_cli_help_message(capfd):\n    \"\"\"\n    Test that --help prints usage information.\n    Note: Argparse is not explicitly used, so this is a simplified test.\n    If argparse were used, it would handle --help automatically.\n    For this spec, _parse_args is basic.\n    \"\"\"\n    # Assuming standard argparse behavior if it were integrated, for now, it's not.\n    # The spec's `_parse_args` is simple and does not parse `--help`.\n    # This test will effectively treat '--help' as a regular string argument.\n    # A full argparse integration would require modifying CLIController._parse_args.\n    # We will test the existing simple behavior.\n    \n    service = LongestService(InMemoryStatsRepository())\n    controller = CLIController(service=service)\n    \n    # Test --help as a regular string\n    exit_code = controller.run(argv=['string-longest', '--help'])\n    assert exit_code == 0\n    out, err = capfd.readouterr()\n    assert out.strip() == '--help' # It simply returns '--help' as the longest string\n    assert err == ''\n    # If a full argparse was used, this would be a more robust test.\n```\n\n```text\ntests/conftest.py\n```python\n\"\"\"\nPytest fixtures for setting up common dependencies across tests.\nThese fixtures provide pre-configured instances of repositories, services, and controllers.\n\"\"\"\n\nimport pytest\nimport os\nimport tempfile\nfrom string_longest.repository import InMemoryStatsRepository\nfrom string_longest.services import LongestService\nfrom string_longest.controllers import CLIController\n\n\n@pytest.fixture(scope=\"function\")\ndef in_memory_repo_no_persist():\n    \"\"\"Provides a fresh InMemoryStatsRepository without file persistence for each test.\"\"\"\n    return InMemoryStatsRepository(persist_path=None)\n\n@pytest.fixture(scope=\"function\")\ndef longest_service(in_memory_repo_no_persist):\n    \"\"\"Provides a LongestService instance with a non-persisting in-memory repository.\"\"\"\n    return LongestService(repository=in_memory_repo_no_persist)\n\n@pytest.fixture(scope=\"function\")\ndef cli_controller(longest_service):\n    \"\"\"Provides a CLIController instance with a LongestService.\"\"\"\n    return CLIController(service=longest_service)\n\n@pytest.fixture(scope=\"function\")\ndef tmp_stats_file(tmp_path):\n    \"\"\"\n    Provides a temporary path for stats persistence file.\n    Automatically cleaned up after each test.\n    \"\"\"\n    return tmp_path / \"temp_stats.json\"\n\n@pytest.fixture(scope=\"function\")\ndef persisting_repo(tmp_stats_file):\n    \"\"\"\n    Provides an InMemoryStatsRepository configured to persist to a temporary file.\n    Ensures a clean state for each test by deleting the file before setup.\n    \"\"\"\n    if os.path.exists(tmp_stats_file):\n        os.remove(tmp_stats_file)\n    repo = InMemoryStatsRepository(persist_path=str(tmp_stats_file))\n    return repo\n```\n\n```text\n.github/workflows/ci.yml\n```yaml\nname: CI\n\non:\n  push:\n    branches: [ main ]\n  pull_request:\n    branches: [ main ]\n\njobs:\n  build:\n    runs-on: ubuntu-latest\n    strategy:\n      matrix:\n        python-version: [\"3.8\", \"3.9\", \"3.10\", \"3.11\", \"3.12\"]\n\n    steps:\n    - uses: actions/checkout@v4\n\n    - name: Set up Python ${{ matrix.python-version }}\n      uses: actions/setup-python@v5\n      with:\n        python-version: ${{ matrix.python-version }}\n\n    - name: Install Poetry\n      run: |\n        curl -sSL https://install.python-poetry.org | python -\n\n    - name: Add Poetry to PATH\n      run: echo \"$HOME/.poetry/bin\" >> $GITHUB_PATH\n\n    - name: Install dependencies\n      run: |\n        poetry install --with dev --no-interaction --no-root\n\n    - name: Run tests\n      run: |\n        poetry run pytest --cov=string_longest --cov-report=xml\n      env:\n        PYTHONPATH: src\n\n    - name: Upload coverage reports to Codecov\n      uses: codecov/codecov-action@v4\n      with:\n        token: ${{ secrets.CODECOV_TOKEN }}\n        slug: yourusername/string-longest # Replace with your GitHub username/repo\n        fail_ci_if_error: true\n```"}
