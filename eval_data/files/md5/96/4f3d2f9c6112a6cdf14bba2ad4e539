 stdin piped, show help and exit\n            parser.print_help()\n            return DEFAULT_EXIT_CODE_VALIDATION_ERROR # Or 0 if showing help is not an error\n\n        try:\n            result = self._controller.handle(values)\n            if result.longest is not None:\n                print(result.longest)\n            return DEFAULT_EXIT_CODE_SUCCESS\n        except ValidationError as e:\n            print(f\"Error: {e}\", file=sys.stderr)\n            return DEFAULT_EXIT_CODE_VALIDATION_ERROR\n        except Exception as e:\n            print(f\"An unexpected error occurred: {e}\", file=sys.stderr)\n            return 1 # General error code\n\ndef main() -> int:\n    \"\"\"Entry point for the longest-str CLI command.\"\"\"\n    # Dependencies are injected at the entry point.\n    finder = LongestFinder()\n    validator = StringValidator()\n    controller = CLIController(finder=finder, validator=validator)\n    adapter = CLIAdapter(controller=controller)\n    return adapter.run()\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n```\n\n```python\n# src/longest_str/adapters/wsgi_app.py\nimport json\nfrom typing import Callable, Iterable, Dict, Any, List\nfrom urllib.parse import parse_qs\n\nfrom longest_str.services.longest_finder import LongestFinder\nfrom longest_str.utils.string_validator import StringValidator\nfrom longest_str.exceptions.validation_error import ValidationError\nfrom longest_str.models.longest_result import LongestResult\nfrom longest_str.constants import CONTENT_TYPE_JSON\n\nclass WSGIApp:\n    \"\"\"A lightweight WSGI application for the HTTP endpoint.\"\"\"\n    def __init__(self, finder: LongestFinder, validator: StringValidator) -> None:\n        self._finder = finder\n        self._validator = validator\n\n    def _handle_request(self, environ: dict) -> tuple[int, Dict[str, Any]]:\n        \"\"\"Internal handler to process the request and return status/response.\"\"\"\n        method = environ.get(\"REQUEST_METHOD\", \"GET\").upper()\n        values: List[str] = []\n\n        if method == \"GET\":\n            query_string = environ.get(\"QUERY_STRING\", \"\")\n            qs_params = parse_qs(query_string)\n            raw_values_param = qs_params.get(\"values\", [])\n            for item in raw_values_param:\n                # Support both comma-separated and repeated 'values' query params\n                values.extend([p for p in item.split(\",\") if p])\n        elif method == \"POST\":\n            try:\n                content_length = int(environ.get(\"CONTENT_LENGTH\", \"0\"))\n            except ValueError:\n                content_length = 0\n\n            body = environ[\"wsgi.input\"].read(content_length).decode(\"utf-8\")\n            if not body:\n                raise ValidationError(\"POST request body is empty or invalid JSON.\")\n\n            try:\n                payload = json.loads(body)\n            except json.JSONDecodeError:\n                raise ValidationError(\"Invalid JSON in request body.\")\n\n            values_from_payload = payload.get(\"values\")\n            if not isinstance(values_from_payload, list):\n                raise ValidationError(\"JSON body must contain a 'values' key with a list.\")\n            values = values_from_payload\n        else:\n            return 405, {\"error\": \"Method Not Allowed\"}\n\n        # Validate and process the list of strings.\n        validated_input = self._validator.validate_list(values)\n        longest_str = self._finder.find_longest(validated_input.values)\n        result = LongestResult(longest_str).to_dict()\n        return 200, result\n\n    def app(self, environ: dict, start_response: Callable) -> Iterable[bytes]:\n        \"\"\"The WSGI application callable.\"\"\"\n        path = environ.get(\"PATH_INFO\", \"\")\n        if path != \"/longest\":\n            start_response(\"404 Not Found\", [(\"Content-Type\", CONTENT_TYPE_JSON)])\n            return [json.dumps({\"error\": \"not found\"}).encode(\"utf-8\")]\n\n        try:\n            status_code, response_data = self._handle_request(environ)\n            status_message = {\n                200: \"200 OK\",\n                400: \"400 Bad Request\",\n                405: \"405 Method Not Allowed\",\n                500: \"500 Internal Server Error\"\n            }.get(status_code, \"500 Internal Server Error\")\n\n            start_response(status_message, [(\"Content-Type\", CONTENT_TYPE_JSON)])\n            return [json.dumps(response_data).encode(\"utf-8\")]\n        except ValidationError as e:\n            start_response(\"400 Bad Request\", [(\"Content-Type\", CONTENT_TYPE_JSON)])\n            return [json.dumps({\"error\": str(e)}).encode(\"utf-8\")]\n        except Exception:\n            start_response(\"500 Internal Server Error\", [(\"Content-Type\", CONTENT_TYPE_JSON)])\n            return [json.dumps({\"error\": \"internal server error\"}).encode(\"utf-8\")]\n\ndef create_wsgi_app() -> WSGIApp:\n    \"\"\"Helper to create and return the WSGI application instance.\"\"\"\n    finder = LongestFinder()\n    validator = StringValidator()\n    return WSGIApp(finder=finder, validator=validator)\n\n# Example usage with wsgiref (for development/testing):\n# from wsgiref.simple_server import make_server\n# if __name__ == \"__main__\":\n#     httpd = make_server('', 8000, create_wsgi_app().app)\n#     print(\"Serving on port 8000...\")\n#     httpd.serve_forever()\n```\n\n```python\n# src/longest_str/controllers/__init__.py\n# Expose controller-level imports if needed for external access or internal convenience.\n```\n\n```python\n# src/longest_str/controllers/cli_controller.py\nfrom typing import List, Any\n\nfrom longest_str.services.longest_finder import LongestFinder\nfrom longest_str.utils.string_validator import StringValidator\nfrom longest_str.models.longest_result import LongestResult\nfrom longest_str.models.strings_input import StringsInput # Not directly used but good for context\n\nclass CLIController:\n    \"\"\"Orchestrates validation and algorithm execution for CLI requests.\"\"\"\n    def __init__(self, finder: LongestFinder, validator: StringValidator) -> None:\n        self._finder = finder\n        self._validator = validator\n\n    def handle(self, values: List[Any]) -> LongestResult:\n        \"\"\"Validates input, finds the longest string, and returns the result DTO.\"\"\"\n        validated_input: StringsInput = self._validator.validate_list(values)\n        longest_str = self._finder.find_longest(validated_input.values)\n        return LongestResult(longest_str)\n```\n\n```python\n# src/longest_str/exceptions/__init__.py\n# Expose exception-level imports for easier access.\nfrom .validation_error import ValidationError\n```\n\n```python\n# src/longest_str/exceptions/validation_error.py\nclass ValidationError(Exception):\n    \"\"\"Custom exception for signaling input validation failures.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\n    def __str__(self) -> str:\n        \"\"\"Returns the error message as string representation.\"\"\"\n        return self.message\n```\n\n```python\n# src/longest_str/models/__init__.py\n# Expose model-level imports for easier access.\nfrom .strings_input import StringsInput\nfrom .longest_result import LongestResult\n```\n\n```python\n# src/longest_str/models/strings_input.py\nfrom typing import List\n\nclass StringsInput:\n    \"\"\"Data Transfer Object (DTO) for a validated list of strings.\"\"\"\n    def __init__(self, values: List[str]) -> None:\n        self._values: List[str] = list(values)\n\n    @property\n    def values(self) -> List[str]:\n        \"\"\"Provides read-only access to the list of strings.\"\"\"\n        return self._values\n\n    def __repr__(self) -> str:\n        \"\"\"Human-friendly representation for debugging.\"\"\"\n        return f\"StringsInput(values={self._values!r})\"\n```\n\n```python\n# src/longest_str/models/longest_result.py\nfrom typing import Optional, Dict, Any\n\nclass LongestResult:\n    \"\"\"Data Transfer Object (DTO) for the longest string result.\"\"\"\n    def __init__(self, longest: Optional[str]) -> None:\n        self._longest: Optional[str] = longest\n\n    @property\n    def longest(self) -> Optional[str]:\n        \"\"\"Provides read-only access to the longest string.\"\"\"\n        return self._longest\n\n    def to_dict(self) -> Dict[str, Optional[str]]:\n        \"\"\"Converts the result to a dictionary for JSON serialization.\"\"\"\n        return {\"longest\": self._longest}\n```\n\n```python\n# src/longest_str/services/__init__.py\n# Expose service-level imports if needed for external access or internal convenience.\n```\n\n```python\n# src/longest_str/services/longest_finder.py\nfrom typing import List, Optional\n\nclass LongestFinder:\n    \"\"\"Implements the core algorithm to find the longest string.\"\"\"\n    def find_longest(self, values: List[str]) -> Optional[str]:\n        \"\"\"Returns the first longest string from a list, or None if the list is empty.\"\"\"\n        if not values:\n            return None\n\n        max_len = -1\n        max_str: Optional[str] = None\n        for s in values:\n            # Assumes 's' is a string as input is pre-validated by StringValidator.\n            current_len = len(s)\n            if current_len > max_len:\n                max_len = current_len\n                max_str = s\n        return max_str\n```\n\n```python\n# src/longest_str/utils/__init__.py\n# Expose utility-level imports if needed for external access or internal convenience.\nfrom .string_validator import StringValidator\n```\n\n```python\n# src/longest_str/utils/string_validator.py\nfrom typing import List, Any\n\nfrom longest_str.models.strings_input import StringsInput\nfrom longest_str.exceptions.validation_error import ValidationError\n\nclass StringValidator:\n    \"\"\"Provides utility methods for validating string lists.\"\"\"\n    def validate_list(self, values: List[Any]) -> StringsInput:\n        \"\"\"Validates if the input is a list of strings; raises ValidationError otherwise.\"\"\"\n        if not isinstance(values, list):\n            raise ValidationError(\"Input must be a list.\")\n        for i, v in enumerate(values):\n            if not isinstance(v, str):\n                raise ValidationError(f\"Element at index {i} ('{v}') is not a string.\")\n        return StringsInput(values)\n\n    def is_str_list(self, values: List[Any]) -> bool:\n        \"\"\"Checks if all elements in a list are strings.\"\"\"\n        if not isinstance(values, list):\n            return False\n        return all(isinstance(v, str) for v in values)\n```"}
