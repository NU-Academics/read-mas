g\n    md5_hash = hashlib.md5(text.encode('utf-8'))\n    return md5_hash.hexdigest()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/11": [{"task_id": "HumanEval/11", "solution": "class BinaryString:\n    \"\"\"Encapsulates a validated binary string, providing safe access to its characters and length.\"\"\"\n    def __init__(self, value: str):\n        if not all(char in '01' for char in value):\n            raise ValueError(f\"Invalid binary character in '{value}'\")\n        self._value = value\n\n    def get_char(self, index: int) -> str:\n        \"\"\"Returns the character at the specified index.\"\"\"\n        return self._value[index]\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the binary string.\"\"\"\n        return len(self._value)\n\n    def get_value(self) -> str:\n        \"\"\"Returns the underlying string value.\"\"\"\n        return self._value\ndef string_xor(a: str, b: str) -> str:\n    \"\"\"Performs binary XOR on two binary strings, validating inputs and ensuring equal length.\"\"\"\n    binary_a = BinaryString(a)\n    binary_b = BinaryString(b)\n\n    if binary_a.length() != binary_b.length():\n        raise ValueError(\"Input strings must be of equal length\")\n\n    result_chars = []\n    for i in range(binary_a.length()):\n        char_a = binary_a.get_char(i)\n        char_b = binary_b.get_char(i)\n        if char_a == char_b:\n            result_chars.append('0')\n        else:\n            result_chars.append('1')\n    return \"\".join(result_chars)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/159": [{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    You're a hungry rabbit, and you already have eaten a certain number of carrots,\n    but now you need to eat more carrots to complete the day's meals.\n    you should return an array of [ total number of eaten carrots after your meals,\n                                    the number of carrots left after your meals ]\n    if there are not enough remaining carrots, you will eat all remaining carrots, but will still be hungry.\n    \"\"\"\n\n    class CarrotMealStatus:\n        \"\"\"Encapsulates state and logic for a single carrot meal calculation.\"\"\"\n        def __init__(self, eaten_before_meal: int, needed_for_meal: int, remaining_in_stock: int) -> None:\n            self._eaten_before_meal = eaten_before_meal\n            self._needed_for_meal = needed_for_meal\n            self._remaining_in_stock = remaining_in_stock\n            self._eaten_during_meal = 0\n            self._total_eaten_after_meal = 0\n            self._remaining_after_meal = 0\n\n        def calculate_meal_consumption(self) -> None:\n            \"\"\"Determines carrots eaten during the meal based on need and stock.\"\"\"\n            self._eaten_during_meal = min(self._needed_for_meal, self._remaining_in_stock)\n\n        def calculate_total_eaten(self) -> None:\n            \"\"\"Calculates total carrots eaten after the meal.\"\"\"\n            self._total_eaten_after_meal = self._eaten_before_meal + self._eaten_during_meal\n\n        def calculate_remaining_stock(self) -> None:\n            \"\"\"Calculates carrots remaining after the meal.\"\"\"\n            self._remaining_after_meal = self._remaining_in_stock - self._eaten_during_meal\n\n        def get_total_eaten_after_meal(self) -> int:\n            \"\"\"Returns the total carrots eaten after the meal.\"\"\"\n            return self._total_eaten_after_meal\n\n        def get_remaining_after_meal(self) -> int:\n            \"\"\"Returns the carrots remaining after the meal.\"\"\"\n            return self._remaining_after_meal\n\n    meal_status = CarrotMealStatus(number, need, remaining)\n    meal_status.calculate_meal_consumption()\n    meal_status.calculate_total_eaten()\n    meal_status.calculate_remaining_stock()\n\n    total_eaten = meal_status.get_total_eaten_after_meal()\n    carrots_left = meal_status.get_remaining_after_meal()\n\n    return [total_eaten, carrots_left]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/15": [{"task_id": "HumanEval/15", "solution": "def string_sequence(n: int) -> str:\n    \"\"\" Return a string containing space-delimited numbers starting from 0 upto n inclusive.\n    >>> string_sequence(0)\n    '0'\n    >>> string_sequence(5)\n    '0 1 2 3 4 5'\n    \"\"\"\n    numbers = [str(i) for i in range(n + 1)]\n    return ' '.join(numbers)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/83": [{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    if n == 1:\n        return 1\n    else:\n        # For n > 1, the formula is 10^(n-1) + 8 * 10^(n-2)\n        return (10**(n - 1)) + (8 * (10**(n - 2)))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/130": [{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Everyone knows Fibonacci sequence, it was studied deeply by mathematicians in \n    the last couple centuries. However, what people don't know is Tribonacci sequence.\n    Tribonacci sequence is defined by the recurrence:\n    tri(1) = 3\n    tri(n) = 1 + n / 2, if n is even.\n    tri(n) =  tri(n - 1) + tri(n - 2) + tri(n + 1), if n is odd.\n    For example:\n    tri(2) = 1 + (2 / 2) = 2\n    tri(4) = 3\n    tri(3) = tri(2) + tri(1) + tri(4)\n           = 2 + 3 + 3 = 8 \n    You are given a non-negative integer number n, you have to a return a list of the \n    first n + 1 numbers of the Tribonacci sequence.\n    Examples:\n    tri(3) = [1, 3, 2, 8]\n    \"\"\"\n    memo = {}\n\n    def _get_tribonacci_number(index):\n        \"\"\"Calculates the Tribonacci number for a given index using memoization.\"\"\"\n        if index in memo:\n            return memo[index]\n\n        if index == 0:\n            result = 1\n        elif index == 1:\n            result = 3\n        elif index % 2 == 0:  # n is even, n >= 2\n            result = 1 + index // 2\n        else:  # n is odd, n >= 3\n            # This recursive definition requires tri(index+1) to be calculated.\n            result = _get_tribonacci_number(index - 1) + \\\n                     _get_tribonacci_number(index - 2) + \\\n                     _get_tribonacci_number(index + 1)\n        \n        memo[index] = result\n        return result\n\n    sequence = []\n    # Generates the first n + 1 Tribonacci numbers by iterating from 0 to n.\n    for i in range(n + 1):\n        sequence.append(_get_tribonacci_number(i))\n        \n    return sequence", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/129": [{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Finds the minimum path of length k in the grid, lexicographically.\n    Uses Depth-First Search with backtracking and pruning to explore paths.\n    \"\"\"\n    N = len(grid)\n    # Initialize min_path_found with values larger than any possible grid value (N*N)\n    # This ensures the first valid path found will always be considered smaller.\n    max_grid_val = N * N\n    min_path_found = [max_grid_val + 1] * k\n\n    # Use a list to hold min_path_found, allowing it to be modified by nested functions.\n    min_path_wrapper = [min_path_found]\n\n    def _is_valid_move(r, c):\n        \"\"\"Checks if a given cell coordinate (r, c) is within grid boundaries.\"\"\"\n        return 0 <= r < N and 0 <= c < N\n\n    def _get_neighbors(r, c):\n        \"\"\"Returns a list of valid neighbor coordinates for a given cell (r, c).\"\"\"\n        neighbors = []\n        deltas = [(-1, 0), (1, 0), (0, -1), (0, 1)]  # Up, Down, Left, Right\n        for dr, dc in deltas:\n            nr, nc = r + dr, c + dc\n            if _is_valid_move(nr, nc):\n                neighbors.append((nr, nc))\n        return neighbors\n\n    def _is_lexicographically_smaller(path_a, path_b):\n        \"\"\"Compares two paths lexicographically. Returns True if path_a is strictly smaller than path_b.\"\"\"\n        for i in range(k):\n            if path_a[i] < path_b[i]:\n                return True\n            elif path_a[i] > path_b[i]:\n                return False\n        return False  # Paths are identical or one is a prefix of another (not possible for k-length paths)\n\n    def _find_min_path_dfs(current_path_values, r, c, grid_data, N, min_path_wrapper):\n        \"\"\"\n        Recursively explores paths using DFS, updating the global minimum path if a smaller one is found.\n        Includes pruning to avoid exploring branches that cannot lead to a smaller path.\n        \"\"\"\n        current_path_values.append(grid_data[r][c])\n\n        # Pruning: If the current path's prefix is already lexicographically greater\n        # than the known minimum path, stop exploring this branch.\n        current_len = len(current_path_values)\n        for i in range(current_len):\n            if current_path_values[i] > min_path_wrapper[0][i]:\n                current_path_values.pop()  # Backtrack\n                return\n            elif current_path_values[i] < min_path_wrapper[0][i]:\n                # This path is lexicographically smaller so far, continue exploring.\n                break\n\n        # Base case: Path length k reached\n        if current_len == k:\n            if _is_lexicographically_smaller(current_path_values, min_path_wrapper[0]):\n                min_path_wrapper[0] = list(current_path_values)  # Make a copy\n            current_path_values.pop()  # Backtrack\n            return\n\n        # Recursive step: Explore neighbors\n        for nr, nc in _get_neighbors(r, c):\n            _find_min_path_dfs(current_path_values, nr, nc, grid_data, N, min_path_wrapper)\n\n        # Backtrack: Remove the current cell's value when returning from recursion\n        current_path_values.pop()\n\n    # Iterate through each cell as a starting point for DFS\n    for r_start in range(N):\n        for c_start in range(N):\n            _find_min_path_dfs([], r_start, c_start, grid, N, min_path_wrapper)\n\n    return min_path_wrapper[0]", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[[10, 5, 20, 14, 16], [7, 11, 12, 17, 9], [13, 19, 1, 15, 8], [3, 18, 4, 6, 2], [22, 21, 23, 24, 25]], 25]]}], "HumanEval/139": [{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"Calculates the Brazilian factorial defined as n! * (n-1)! * ... * 1! for n > 0. For example, special_factorial(4) returns 288.\"\"\"\n    if n <= 0:\n        raise ValueError(\"Input must be a positive integer.\")\n\n    def factorial(k):\n        \"\"\"Calculates the factorial of a non-negative integer k.\"\"\"\n        res = 1\n        for i in range(1, k + 1):\n            res *= i\n        return res\n\n    result = 1\n    for i in range(1, n + 1):\n        result *= factorial(i)\n\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}]}}