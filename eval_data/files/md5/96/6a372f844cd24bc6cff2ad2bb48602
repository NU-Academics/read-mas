 int(parts[2])\n            return (month, day, year)\n        except (ValueError, IndexError):\n            return None\n\n    def _is_month_valid(month):\n        \"\"\"Checks if the month integer is within the valid range [1, 12].\"\"\"\n        return 1 <= month <= 12\n\n    def _is_day_valid(day, month):\n        \"\"\"Checks if the day integer is valid for the given month.\"\"\"\n        if not (1 <= day):\n            return False\n\n        months_31_days = [1, 3, 5, 7, 8, 10, 12]\n        months_30_days = [4, 6, 9, 11]\n\n        if month in months_31_days:\n            return day <= 31\n        elif month in months_30_days:\n            return day <= 30\n        elif month == 2: # February\n            return day <= 29 # As per requirement, max 29 days\n        else:\n            return False # Should not happen if _is_month_valid passed\n\n    # Rule 1: The date string is not empty.\n    if _is_empty(date):\n        return False\n\n    # Rule 4: The date should be in the format: mm-dd-yyyy\n    if not _is_format_valid(date):\n        return False\n\n    # Parse components (this also handles non-integer parts after format check)\n    parsed_date = _parse_date_components(date)\n    if parsed_date is None:\n        return False\n\n    month, day, year = parsed_date\n\n    # Rule 3: The months should not be less than 1 or higher than 12.\n    if not _is_month_valid(month):\n        return False\n\n    # Rule 2: The number of days is not less than 1 or higher than specified for each month type.\n    if not _is_day_valid(day, month):\n        return False\n\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/131": [{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    For example:\n    digits(1)  == 1\n    digits(4)  == 0\n    digits(235) == 15\n    \"\"\"\n    product_