 non-empty but contained only spaces,\n        # e.g., '   ', which results in an empty list from test.split().\n        return {}\n\n    # Identify the highest frequency among all letters.\n    max_count = max(lc.get_count() for lc in letter_counts.values())\n\n    # Filter and format letters that occur with the highest frequency.\n    result = {}\n    for lc in letter_counts.values():\n        if lc.get_count() == max_count:\n            result[lc.get_character()] = lc.get_count()\n\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/110": [{"task_id": "HumanEval/110", "solution": "def exchange(lst1, lst2):\n    \"\"\"Determines if lst1 can be made entirely even by exchanging elements with lst2.\n    It counts odd numbers in lst1 and even numbers in lst2 to make the decision.\n    \"\"\"\n\n    def is_even(number):\n        \"\"\"Checks if a given number is even.\"\"\"\n        return number % 2 == 0\n\n    def count_odd_numbers(lst):\n        \"\"\"Counts the number of odd elements in a list.\"\"\"\n        count = 0\n        for num in lst:\n            if not is_even(num):\n                count += 1\n        return count\n\n    def count_even_numbers(lst):\n        \"\"\"Counts the number of even elements in a list.\"\"\"\n        count = 0\n        for num in lst:\n            if is_even(num):\n                count += 1\n        return count\n\n    # To make all elements of lst1 even, we need to replace each odd number in lst1\n    # with an even number from lst2.\n    # Therefore, the number of odd numbers in lst1 must be less than or equal to\n    # the number of even numbers available in lst2.\n    odds_in_lst1 = count_odd_numbers(lst1)\n    evens_in_lst2 = count_even_numbers(lst2)\n\n    if odds_in_lst1 <= evens_in_lst2:\n        return \"YES\"\n    else:\n        return \"NO\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/114": [{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums):\n    \"\"\"\n    Finds the minimum sum of any non-empty sub-array using Kadane's algorithm adaptation.\n    It iterates through the array, updating the current minimum sum and the overall minimum sum found so far.\n    \"\"\"\n    min_so_far = nums[0]\n    current_min_sum = nums[0]\n\n    for num in nums[1:]:\n        current_min_sum = min(num, current_min_sum + num)\n        min_so_far = min(min_so_far, current_min_sum)\n\n    return min_so_far", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/115": [{"task_id": "HumanEval/115", "solution": "import math\ndef max_fill(grid, capacity):\n    \"\"\"\n    Calculates the total number of bucket lowerings needed to empty all wells in the grid.\n    Each 1 in the grid represents a unit of water, and buckets have a fixed capacity.\n    \"\"\"\n\n    def _calculate_well_water(well_row):\n        \"\"\"Calculates the total water units in a single well.\"\"\"\n        return sum(well_row)\n\n    def _calculate_lowerings_for_well(water_amount, capacity):\n        \"\"\"Determines the minimum lowerings for a single well using math.ceil.\"\"\"\n        if water_amount == 0:\n            return 0\n        return math.ceil(water_amount / capacity)\n\n    total_lowerings = 0\n    for well_row in grid:\n        water_amount_in_well = _calculate_well_water(well_row)\n        if water_amount_in_well > 0:\n            lowerings_for_well = _calculate_lowerings_for_well(water_amount_in_well, capacity)\n            total_lowerings += lowerings_for_well\n            \n    return total_lowerings", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/113": [{"task_id": "HumanEval/113", "solution": "def odd_count(lst):\n    \"\"\"Given a list of strings, where each string consists of only digits, return a list.\n    Each element i of the output should be \"the number of odd elements in the\n    string i of the input.\" where all the i's should be replaced by the number\n    of odd digits in the i'th string of the input.\n    \"\"\"\n\n    def _validate_digit_string(s: str) -> bool:\n        \"\"\"Checks if the given string 's' consists only of digits (0-9).\"\"\"\n        return s.isdigit()\n\n    def _count_odd_digits_in_string(s: str) -> int:\n        \"\"\"Counts the number of odd digits (1, 3, 5, 7, 9) in the given digit string 's'.\"\"\"\n        odd_digits = {'1', '3', '5', '7', '9'}\n        count = 0\n        for char in s:\n            if char in odd_digits:\n                count += 1\n        return count\n\n    def _format_output_string(count: int) -> str:\n        \"\"\"Generates the specific formatted output string based on an odd digit count.\"\"\"\n        return f\"the number of odd elements {count}n the str{count}ng {count} of the {count}nput.\"\n\n    output_list = []\n    for input_string in lst:\n        # Assuming valid inputs as per examples, or skipping invalid ones.\n        # A robust implementation might raise an exception.\n        if not _validate_digit_string(input_string):\n            continue\n\n        odd_count_value = _count_odd_digits_in_string(input_string)\n        formatted_string = _format_output_string(odd_count_value)\n        output_list.append(formatted_string)\n\n    return output_list", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/117": [{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"Given a string s and a natural number n, you have been tasked to implement \n    a function that returns a list of all words from string s that contain exactly \n    n consonants, in order these words appear in the string s.\n    If the string s is empty then the function should return an empty list.\n    \"\"\"\n\n    def _is_vowel(char):\n        \"\"\"Determines if a given character is a vowel (case-insensitive).\"\"\"\n        return char.lower() in 'aeiou'\n\n    def _count_consonants(word):\n        \"\"\"Counts the number of consonants in a given word string.\"\"\"\n        count = 0\n        for char in word:\n            if char.isalpha() and not _is_vowel(char):\n                count += 1\n        return count\n\n    if not s:\n        return []\n\n    words = s.split()\n    result = []\n    for word in words:\n        if _count_consonants(word) == n:\n            result.append(word)\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/118": [{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"You are given a word. Your task is to find the closest vowel that stands between \n    two consonants from the right side of the word (case sensitive).\n    \n    Vowels in the beginning and ending doesn't count. Return empty string if you didn't\n    find any vowel met the above condition. \n\n    You may assume that the given string contains English letter only.\n\n    Example:\n    get_closest_vowel(\"yogurt\") ==> \"u\"\n    get_closest_vowel(\"FULL\") ==> \"U\"\n    get_closest_vowel(\"quick\") ==> \"\"\n    get_closest_vowel(\"ab\") ==> \"\"\n    \"\"\"\n    def _is_vowel(char):\n        # Determines if a given character is an English vowel (case-sensitive).\n        VOWELS = \"aeiouAEIOU\"\n        return char in VOWELS\n\n    def _is_consonant(char):\n        # Determines if a given character is an English consonant, assuming it's an English letter.\n        return not _is_vowel(char)\n\n    if len(word) < 3:\n        return \"\"\n\n    # Iterate from the second-to-last character down to the second character.\n    for i in range(len(word) - 2, 0, -1):\n        current_char = word[i]\n        prev_char = word[i-1]\n        next_char = word[i+1]\n\n        # Check for a vowel surrounded by two consonants.\n        if _is_vowel(current_char) and _is_consonant(prev_char) and _is_consonant(next_char):\n            return current_char\n\n    return \"\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/116": [{"task_id": "HumanEval/116", "solution": "def sort_array(arr):\n    \"\"\"\n    In this Kata, you have to sort an array of non-negative integers according to\n    number of ones in their binary representation in ascending order.\n    For similar number of ones, sort based on decimal value.\n    \"\"\"\n    def _get_sort_key(num: int) -> tuple[int, int]:\n        \"\"\"\n        Calculates the sorting key for an integer.\n        For non-negative numbers, it's (ones_count, num); for negatives, it's (-1, num) to ensure decimal sort and grouping.\n        \"\"\"\n        if num < 0:\n            return (-1, num)\n        else:\n            binary_str = bin(num)\n            ones_count = binary_str.count('1')\n            return (ones_count, num)\n\n    return sorted(arr, key=_get_sort_key)", "base_status": "fail", "plus_status": "pass", "base_fail_tests": [[[-2, -3, -4, -5, -6]]], "plus_fail_tests": []}], "HumanEval/36": [{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    def _is_divisible_by_11_or_13(x: int) -> bool:\n        \"\"\"Determines if an integer x is divisible by 11 or 13.\"\"\"\n        return (x % 11 == 0) or (x % 13 == 0)\n\n    def _count_digit_7(x: int) -> int:\n        \"\"\"Counts the occurrences of the digit '7' in the string representation of an integer x.\"\"\"\n        return str(x).count('7')\n\n    total_count = 0\n    for x in range(1, n):\n        if _is_divisible_by_11_or_13(x):\n            total_count += _count_digit_7(x)\n    return total_count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/120": [{"task_id": "HumanEval/120", "solution": "def maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list \n    of length k with the maximum k numbers in arr.\n\n    Example 1:\n\n        Input: arr = [-3, -4, 5], k = 3\n        Output: [-4, -3, 5]\n\n    Example 2:\n\n        Input: arr = [4, -4, 4], k = 2\n        Output: [4, 4]\n\n    Example 3:\n\n        Input: arr = [-3, 2, 1, 2, -1, -2, 1], k = 1\n        Output: [2]\n\n    Note:\n        1. The length of the array will be in the range of [1, 1000].\n        2. The elements in the array will be in the range of [-1000, 1000].\n        3. 0 <= k <= len(arr)\n    \"\"\"\n\n    def _validate_inputs(arr: list[int], k: int) -> None:\n        \"\"\"\n        Validates the input array arr and integer k based on NFRs.\n        Raises ValueError if validation fails.\n        \"\"\"\n        # Note: Type checks are implicitly handled by the problem statement/constraints\n        # and are skipped here as per completion instructions, focusing on value-based NFRs.\n\n        # NFR1: The length of the input array arr shall be in the range of [1, 1000].\n        if not (1 <= len(arr) <= 1000):\n            raise ValueError(f\"Array length must be between 1 and 1000, but got {len(arr)}.\")\n\n        # NFR2: The elements in the input array arr shall be in the range of [-1000, 1000].\n        if not all(-1000 <= x <= 1000 for x in arr):\n            raise ValueError(\"Array elements must be between -1000 and 1000.\")\n\n        # NFR3: The value of k shall be in the range of [0, len(arr)].\n        if not (0 <= k <= len(arr)):\n            raise ValueError(f\"Value of 'k' must be between 0 and {len(arr)}, but got {k}.\")\n\n    _validate_inputs(arr, k)\n\n    if k == 0:\n        return []\n\n    # Sort the array in descending order to easily pick the largest k elements.\n    arr_sorted_desc = sorted(arr, reverse=True)\n\n    # Select the top k elements.\n    k_largest = arr_sorted_sorted_desc[:k]\n\n    # Sort these k elements in ascending order as required by the problem.\n    k_largest_sorted_asc = sorted(k_largest)\n\n    return k_largest_sorted_asc", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[-3, -4, 5], 3]], "plus_fail_tests": [[[1, 2, 3, 4, 5], 3]]}], "HumanEval/119": [{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    \"\"\"\n    Checks if concatenating two strings of parentheses in any order can result in a balanced string.\n    This function includes helper functions for validation and balance checking.\n    \"\"\"\n\n    def _validate_input_list(input_list):\n        # Validates that the input is a list with exactly two elements.\n        if not (isinstance(input_list, list) and len(input_list) == 2):\n            raise ValueError('Input list must contain exactly two elements.')\n\n    def _validate_parentheses_string(s):\n        # Validates that a string contains only '(' and ')' characters.\n        if not isinstance(s, str) or not all(char in '()' for char in s):\n            raise ValueError('String contains invalid characters.')\n\n    def _is_balanced(s):\n        # Determines if a given string of parentheses is balanced.\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            else:\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    _validate_input_list(lst)\n    _validate_parentheses_string(lst[0])\n    _validate_parentheses_string(lst[1])\n\n    s1 = lst[0] + lst[1]\n    s2 = lst[1] + lst[0]\n\n    if _is_balanced(s1) or _is_balanced(s2):\n        return 'Yes'\n    else:\n        return 'No'", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/121": [{"task_id": "HumanEval/121", "solution": "def solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\n    \n\n    Examples\n    solution([5, 8, 7, 1]) ==> 12\n    solution([3, 3, 3, 3, 3]) ==> 9\n    solution([30, 13, 24, 321]) ==>0\n    \"\"\"\n    \n    def _is_even_position(index: int) -> bool:\n        \"\"\"Determines if a given 0-based index is an even number.\"\"\"\n        return index % 2 == 0\n\n    def _is_odd_value(value: int) -> bool:\n        \"\"\"Determines if a given integer value is an odd number.\"\"\"\n        return value % 2 != 0\n\n    total_sum = 0\n    for index, element in enumerate(lst):\n        if _is_even_position(index) and _is_odd_value(element):\n            total_sum += element\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/122": [{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    \"\"\"\n    if not arr or not (1 <= len(arr) <= 100):\n        raise ValueError(\"Array length must be between 1 and 100, inclusive.\")\n    if not (1 <= k <= len(arr)):\n        raise ValueError(\"k must be between 1 and the length of arr, inclusive.\")\n\n    def _is_at_most_two_digits(number):\n        \"\"\"Checks if an integer has an absolute value less than 100.\"\"\"\n        return abs(number) < 100\n\n    total_sum = 0\n    for i in range(k):\n        element = arr[i]\n        if _is_at_most_two_digits(element):\n            total_sum += element\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/123": [{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n\n    The Collatz conjecture is a conjecture in mathematics that concerns a sequence defined\n    as follows: start with any positive integer n. Then each term is obtained from the \n    previous term as follows: if the previous term is even, the next term is one half of \n    the previous term. If the previous term is odd, the next term is 3 times the previous\n    term plus 1. The conjecture is that no matter what value of n, the sequence will always reach 1.\n\n    Note: \n        1. Collatz(1) is [1].\n        2. returned list sorted in increasing order.\n\n    For example:\n    get_odd_collatz(5) returns [1, 5] # The collatz sequence for 5 is [5, 16, 8, 4, 2, 1], so the odd numbers are only 1, and 5.\n    \"\"\"\n    def _validate_input(n):\n        \"\"\"Validates if n is a positive integer. Raises ValueError if n is not a positive integer.\"\"\"\n        if not isinstance(n, int) or n <= 0:\n            raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    def _generate_collatz_sequence(start_n):\n        \"\"\"Generates the Collatz sequence starting from start_n until 1.\"\"\"\n        sequence = [start_n]\n        current_term = start_n\n        while current_term != 1:\n            if current_term % 2 == 0:  # Even\n                current_term //= 2\n            else:  # Odd\n                current_term = (3 * current_term) + 1\n            sequence.append(current_term)\n        return sequence\n\n    def _filter_odd_numbers(sequence):\n        \"\"\"Filters a list of integers to return only the odd numbers.\"\"\"\n        return [num for num in sequence if num % 2 != 0]\n\n    def _sort_numbers(numbers):\n        \"\"\"Sorts a list of integers in increasing order.\"\"\"\n        return sorted(numbers)\n\n    _validate_input(n)\n\n    if n == 1:\n        return [1]\n\n    collatz_sequence = _generate_collatz_sequence(n)\n    odd_numbers = _filter_odd_numbers(collatz_sequence)\n    sorted_odd_numbers = _sort_numbers(odd_numbers)\n\n    return sorted_odd_numbers", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/126": [{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n\n    Examples\n    is_sorted([5]) \u279e True\n    is_sorted([1, 2, 3, 4, 5]) \u279e True\n    is_sorted([1, 3, 2, 4, 5]) \u279e False\n    is_sorted([1, 2, 3, 4, 5, 6]) \u279e True\n    is_sorted([1, 2, 3, 4, 5, 6, 7]) \u279e True\n    is_sorted([1, 3, 2, 4, 5, 6, 7]) \u279e False\n    is_sorted([1, 2, 2, 3, 3, 4]) \u279e True\n    is_sorted([1, 2, 2, 2, 3, 4]) \u279e False\n    '''\n    from collections import Counter\n\n    if not lst:\n        return True\n\n    # Check for sorting\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    # Check for duplicates\n    counts = Counter(lst)\n    for number, count in counts.items():\n        if count > 2:\n            return False\n\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/127": [{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"Determines whether the length of the intersection of two closed integer intervals\n    is a prime number.\n    Returns \"YES\" if the length of the intersection is a prime number, \"NO\" otherwise.\n    Returns \"NO\" if the intervals do not intersect.\n    \"\"\"\n    def _is_prime(n: int) -> bool:\n        \"\"\"Determines if a given integer is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    intersection_start = max(start1, start2)\n    intersection_end = min(end1, end2)\n\n    if intersection_start > intersection_end:\n        return \"NO\"\n\n    intersection_length = intersection_end - intersection_start + 1\n\n    is_length_prime = _is_prime(intersection_length)\n\n    if is_length_prime:\n        return \"YES\"\n    else:\n        return \"NO\"", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[-1, 1], [0, 4]]], "plus_fail_tests": [[[10, 20], [15, 25]]]}], "HumanEval/125": [{"task_id": "HumanEval/125", "solution": "import re\ndef _has_whitespace(text: str) -> bool:\n    \"\"\"Checks if the input string contains any whitespace characters.\"\"\"\n    return bool(re.search(r'\\s', text))\ndef _has_commas(text: str) -> bool:\n    \"\"\"Checks if the input string contains any comma characters.\"\"\"\n    return ',' in text\ndef _split_by_whitespace(text: str) -> list[str]:\n    \"\"\"Splits the input string by whitespace characters, handling multiple consecutive spaces and trimming.\"\"\"\n    return [word for word in re.split(r'\\s+', text.strip()) if word]\ndef _split_by_commas(text: str) -> list[str]:\n    \"\"\"Splits the input string by comma characters, handling multiple consecutive commas and trimming.\"\"\"\n    return [word for word in re.split(r',+', text.strip()) if word]\ndef _get_letter_order(char: str) -> int:\n    \"\"\"Calculates the zero-based alphabetical order of a lowercase letter (a=0, b=1, ...).\"\"\"\n    if 'a' <= char <= 'z':\n        return ord(char) - ord('a')\n    return -1\ndef _count_odd_order_letters(text: str) -> int:\n    \"\"\"Counts lowercase letters with an odd alphabetical order in the input string.\"\"\"\n    count = 0\n    for char in text:\n        if 'a' <= char <= 'z':\n            order = _get_letter_order(char)\n            if order != -1 and order % 2 != 0:\n                count += 1\n    return co