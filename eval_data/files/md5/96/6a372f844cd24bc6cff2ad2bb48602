ouble spaces become '__').\n    text = text.replace(' ', '_')\n    \n    return text", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["Hey    there!"]]}], "HumanEval/141": [{"task_id": "HumanEval/141", "solution": "class FileNameValidator:\n    \"\"\"Encapsulates a file name string and provides methods for validation checks.\"\"\"\n    def __init__(self, name: str):\n        self._name = name\n\n    def get_digit_count(self) -> int:\n        # Counts digits in the file name.\n        return sum(1 for char in self._name if char.isdigit())\n\n    def get_dot_count(self) -> int:\n        # Counts dots in the file name.\n        return self._name.count('.')\n\n    def get_prefix(self) -> str:\n        # Extracts the substring before the first dot.\n        dot_index = self._name.find('.')\n        return self._name[:dot_index] if dot_index != -1 else self._name\n\n    def get_extension(self) -> str:\n        # Extracts the substring after the first dot.\n        dot_index = self._name.find('.')\n        return self._name[dot_index + 1:] if dot_index != -1 else \"\"\n\n    def is_prefix_empty(self) -> bool:\n        # Checks if the prefix is empty.\n        return len(self.get_prefix()) == 0\n\n    def starts_with_latin_letter(self) -> bool:\n        # Checks if the prefix starts with a latin letter.\n        prefix = self.get_prefix()\n        return len(prefix) > 0 and prefix[0].isalpha()\nclass FileExtensionValidator:\n    \"\"\"Manages allowed file extensions and validates a given extension against them.\"\"\"\n    def __init__(self, allowed_extensions: set[str]):\n        self._allowed_extensions = allowed_extensions\n\n    def is_valid(self, extension: str) -> bool:\n        # Checks if the given extension is in the set of allowed extensions.\n        return extension in self._allowed_extensions\ndef file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    '