hen return the sum of all entries. \n    \n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    total_sum = 0\n    for index, entry in enumerate(lst):\n        processed_value = entry\n        if index % 3 == 0:\n            processed_value = entry * entry\n        elif index % 4 == 0:\n            # This condition implicitly means 'index % 4 == 0 and index % 3 != 0'\n            processed_value = entry * entry * entry\n        total_sum += processed_value\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/143": [{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Returns a string containing words from the original sentence\n    whose lengths are prime numbers, maintaining original order.\n    \"\"\"\n    # Helper function to check if a number is prime.\n    def is_prime(n):\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    words = sentence.split()\n    filtered_words = []\n    for word in words:\n        if is_prime(len(word)):\n            filtered_words.append(word)\n\n    return \" \".join(filtered_words)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/144": [{"task_id": "HumanEval/144", "solution": "import math\nclass Fraction:\n    \"\"\"Represents a mathematical fraction with numerator and denominator.\n    Assumes numerator and denominator are positive whole numbers, and denominator is not zero.\n    \"\"\"\n    def __init__(self, numerator: int, denominator: int):\n        if not isinstance(numerator, int) or not isinstance(denominator, int):\n            raise TypeError(\"Numerator and denominator must be integers.\")\n        if denominator == 0:\n            raise ValueError(\"Denominator cannot be zero.\")\n        if numerator < 0 or denominator < 0:\n            raise ValueError(\"Numerator and denominator must be positive whole numbers.\")\n\n        self.numerator = numerator\n        self.denominator = denominator\n\n    @classmethod\n    def from_string(cls, fraction_string: str) -> 'Fraction':\n        \"\"\"Parses a string in '<numerator>/<denominator>' format into a Fraction object.\n        Assumes the input string is valid as per NFR1.\n        \"\"\"\n        try:\n            num_str, den_str = fraction_string.split('/')\n            numerator = int(num_str)\n            denominator = int(den_str)\n            return cls(numerator, denominator)\n        except ValueError as e:\n            raise ValueError(f\"Invalid fraction string format: {fraction_string}. Details: {e}\")\n        except IndexError:\n            raise ValueError(f\"Invalid fraction string format: {fraction_string}. Expected 'num/den'.\")\n\n    def multiply(self, other: 'Fraction') -> 'Fraction':\n        \"\"\"Multiplies this fraction by another Fraction object.\n        (a/b) * (c/d) = (a*c)/(b*d)\n        \"\"\"\n        new_numerator = self.numerator * other.numerator\n        new_denominator = self.denominator * other.denominator\n        return Fraction(new_numerator, new_denominator)\n\n    def is_whole_number(self) -> bool:\n        \"\"\"Determines if the fraction represents a whole number.\n        A fraction is a whole number if its numerator is perfectly divisible by its denominator.\n        \"\"\"\n        return self.numerator % self.denominator == 0\ndef simplify(x: str, n: str) -> bool:\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n    \"\"\"\n    fraction_x = Fraction.from_string(x)\n    fraction_n = Fraction.from_string(n)\n    product_fraction = fraction_x.multiply(fraction_n)\n    is_whole = product_fraction.is_whole_number()\n    return is_whole", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/146": [{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"Write a function that takes an array of numbers as input and returns \n    the number of elements in the array that are greater than 10 and both \n    first and last digits of a number are odd (1, 3, 5, 7, 9).\n    For example:\n    specialFilter([15, -73, 14, -15]) => 1 \n    specialFilter([33, -2, -3, 45, 21, 109]) => 2\n    \"\"\"\n\n    class Number:\n        \"\"\"Encapsulates an integer value and provides methods to check its properties.\"\"\"\n        def __init__(self, value: int):\n            self._value = value\n\n        def get_first_digit(self) -> int:\n            \"\"\"Returns the first digit of the absolute value of the number.\"\"\"\n            s = str(abs(self._value))\n            return int(s[0])\n\n        def get_last_digit(self) -> int:\n            \"\"\"Returns the last digit of the absolute value of the number.\"\"\"\n            s = str(abs(self._value))\n            return int(s[-1])\n\n        def is_greater_than_ten(self) -> bool:\n            \"\"\"Checks if the number is strictly greater than 10.\"\"\"\n            return self._value > 10\n\n        def is_first_digit_odd(self) -> bool:\n            \"\"\"Checks if the first digit of the number (absolute value) is odd.\"\"\"\n            return self.get_first_digit() % 2 != 0\n\n        def is_last_digit_odd(self) -> bool:\n            \"\"\"Checks if the last digit of the number (absolute value) is odd.\"\"\"\n            return self.get_last_digit() % 2 != 0\n\n    class NumberArray:\n        \"\"\"Manages a collection of Number objects and orchestrates the filtering process.\"\"\"\n        def __init__(self, raw_numbers: list):\n            self._numbers = [Number(val) for val in raw_numbers]\n\n        def specialFilter(self) -> int:\n            \"\"\"Iterates through its numbers, applies the special filter criteria, and returns the count.\"\"\"\n            count = 0\n            for num_obj in self._numbers:\n                if num_obj.is_greater_than_ten() and \\\n                   num_obj.is_first_digit_odd() and \\\n                   num_obj.is_last_digit_odd():\n                    count += 1\n            return count\n\n    # Main logic for the specialFilter function\n    number_array_instance = NumberArray(nums)\n    return number_array_instance.specialFilter()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/145": [{"task_id": "HumanEval/145", "solution": "from dataclasses import dataclass\ndef order_by_points(nums):\n    \"\"\"\n    Sorts the given list of integers in ascending order according to the sum of their digits.\n    If sums are equal, original index is used for secondary sorting.\n    \"\"\"\n\n    # Helper function to calculate the sum of the absolute values of digits for an integer.\n    def _calculate_digit_sum(n: int) -> int:\n        s = 0\n        abs_n = abs(n)\n        if abs_n == 0:\n            return 0\n        while abs_n > 0:\n            s += abs_n % 10\n            abs_n //= 10\n        return s\n\n    # Internal data structure to bundle the original integer value, its calculated digit sum,\n    # and its original index for efficient sorting.\n    @dataclass\n    class _SortableInteger:\n        value: int\n        digit_sum: int\n        original_index: int\n\n    if not nums:\n        return []\n\n    sortable_items = []\n    for i, num in enumerate(nums):\n        d_sum = _calculate_digit_sum(num)\n        sortable_items.append(_SortableInteger(num, d_sum, i))\n\n    # Sort the collected objects primarily by digit sum and secondarily by original index.\n    sortable_items.sort(key=lambda item: (item.digit_sum, item.original_index))\n\n    # Extract the original values from the sorted _SortableInteger objects.\n    return [item.value for item in sortable_items]", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, 11, -1, -11, -12]]], "plus_fail_tests": [[[-5, -12, 9, 15]]]}], "HumanEval/148": [{"task_id": "HumanEval/148", "solution": "class Planet:\n    \"\"\"Represents a celestial body with a name and its order from the Sun.\"\"\"\n    def __init__(self, name, order_from_sun):\n        self.name = name\n        self.order_from_sun = order_from_sun\nclass SolarSystem:\n    \"\"\"Manages the collection of all recognized planets and provides methods for querying.\"\"\"\n    def __init__(self):\n        planet_names = [\n            \"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n        ]\n        self._planets = []\n        self._planet_map = {}\n        for i, name in enumerate(planet_names):\n            planet = Planet(name, i)\n            self._planets.append(planet)\n            self._planet_map[name] = i\n\n    def get_planet_order(self, planet_name: str) -> int | None:\n        \"\"\"Returns the 0-based order of a planet from the Sun, or None if the name is not recognized.\"\"\"\n        return self._planet_map.get(planet_name)\n\n    def get_planets_between(self, planet1_name: str, planet2_name: str) -> tuple[str, ...]:\n        \"\"\"Identifies and returns a sorted tuple of planet names whose orbits are strictly between the two input planets.\"\"\"\n        order1 = self.get_planet_order(planet1_name)\n        order2 = self.get_planet_order(planet2_name)\n\n        if order1 is None or order2 is None:\n            return ()\n\n        # Ensure order1 is less than