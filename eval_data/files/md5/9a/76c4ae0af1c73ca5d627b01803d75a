{"task_id": "HumanEval/129", "solution": "from typing import List, Tuple\nclass Grid:\n    \"\"\"\n    Manages the grid data, providing safe access to cell values and valid neighbors.\n    \"\"\"\n    def __init__(self, grid_values: List[List[int]]) -> None:\n        if not grid_values or not isinstance(grid_values, list) or not all(isinstance(row, list) for row in grid_values):\n            raise ValueError(\"Grid must be a list of lists.\")\n        \n        N = len(grid_values)\n        if N < 2:\n            raise ValueError(\"Grid dimension N must be at least 2.\")\n        if not all(len(row) == N for row in grid_values):\n            raise ValueError(\"Grid must be square (N x N).\")\n\n        self._grid_values = grid_values\n        self._N = N\n\n    def get_N(self) -> int:\n        \"\"\"Returns the dimension N of the grid.\"\"\"\n        return self._N\n\n    def get_value(self, row: int, col: int) -> int:\n        \"\"\"Returns the integer value at the specified (row, col).\"\"\"\n        if not self._is_valid_coord(row, col):\n            raise IndexError(f\"Coordinates ({row}, {col}) are out of bounds.\")\n        return self._grid_values[row][col]\n\n    def get_neighbors(self, row: int, col: int) -> List[Tuple[int, int]]:\n        \"\"\"Returns a list of valid adjacent cell coordinates (up, down, left, right).\"\"\"\n        neighbors = []\n        directions = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Up, Down, Left, Right\n        for dr, dc in directions:\n            n_row, n_col = row + dr, col + dc\n            if self._is_valid_coord(n_row, n_col):\n                neighbors.append((n_row, n_col))\n        return neighbors\n\n    def _is_valid_coord(self, row: int, col: int) -> bool:\n        \"\"\"Internal helper to check if (row, col) is within grid boundaries.\"\"\"\n        return 0 <= row < self._N and 0 <= col < self._N\nclass PathFinder:\n    \"\"\"\n    Implements dynamic programming to find the lexicographically smallest path of length k.\n    \"\"\"\n    def __init__(self, grid: Grid, k: int) -> None:\n        if not isinstance(grid, Grid):\n            raise TypeError(\"Grid must be an instance of the Grid class.\")\n        if not isinstance(k, int) or k <= 0:\n            raise ValueError(\"k must be a positive integer.\")\n\n        self._grid = grid\n        self._k = k\n        self._N = grid.get_N()\n        \n        # dp_table[length_idx][row][col] stores the min path of 'length_idx + 1'\n        self._dp_table: List[List[List[List[int]]]] = \\\n            [[[[] for _ in range(self._N)] for _ in range(self._N)] for _ in range(self._k)]\n\n    def find_min_path(self) -> List[int]:\n        \"\"\"\n        Computes and returns the overall lexicographically smallest path of length k.\n        \"\"\"\n        # Base case: paths of length 1\n        for r in range(self._N):\n            for c in range(self._N):\n                self._dp_table[0][r][c] = [self._grid.get_value(r, c)]\n\n        # Fill DP table for lengths 2 to k\n        for length_idx in range(1, self._k):\n            for r in range(self._N):\n                for c in range(self._N):\n                    current_cell_value = self._grid.get_value(r, c)\n                    min_path_for_current_cell: List[int] = None # type: ignore\n\n                    for nr, nc in self._grid.get_neighbors(r, c):\n                        path_from_neighbor = self._dp_table[length_idx - 1][nr][nc]\n                        candidate_path = [current_cell_value] + path_from_neighbor\n\n                        if min_path_for_current_cell is None or candidate_path < min_path_for_current_cell:\n                            min_path_for_current_cell = candidate_path\n                    self._dp_table[length_idx][r][c] = min_path_for_current_cell\n\n        # Find the overall minimum path among all starting cells for length k\n        overall_min_path: List[int] = None # type: ignore\n        for r in range(self._N):\n            for c in range(self._N):\n                path_from_start_cell = self._dp_table[self._k - 1][r][c]\n                if overall_min_path is None or path_from_start_cell < overall_min_path:\n                    overall_min_path = path_from_start_cell\n\n        return overall_min_path\ndef minPath(grid: List[List[int]], k: int) -> List[int]:\n    \"\"\"\n    Finds the lexicographically smallest path of length k in the given grid.\n    Input validation is handled by Grid and PathFinder constructors.\n    \"\"\"\n    grid_obj = Grid(grid)\n    path_finder = PathFinder(grid_obj, k)\n    return path_finder.find_min_path()"}
{"task_id": "HumanEval/129", "solution": "import heapq\ndef minPath(grid: list[list[int]], k: int) -> list[int]:\n    N = len(grid)\n\n    DIRECTIONS = [(0, 1), (0, -1), (1, 0), (-1, 0)] # Right, Left, Down, Up\n\n    def is_valid_coord(r: int, c: int) -> bool:\n        \"\"\"Checks if a given (r, c) coordinate is within the N x N grid bounds.\"\"\"\n        return 0 <= r < N and 0 <= c < N\n\n    def get_neighbors(r: int, c: int) -> list[tuple[int, int]]:\n        \"\"\"Returns a list of valid neighbor coordinates for a cell (r, c).\"\"\"\n        neighbors = []\n        for dr, dc in DIRECTIONS:\n            nr, nc = r + dr, c + dc\n            if is_valid_coord(nr, nc):\n                neighbors.append((nr, nc))\n        return neighbors\n\n    pq: list[tuple] = []  # Stores (path_tuple, r, c, length)\n    best_path_to_state: dict[tuple[int, int, int], tuple[int, ...]] = {}\n\n    # Initialize search with all possible starting points (paths of length 1).\n    for r in range(N):\n        for c in range(N):\n            initial_path_tuple = (grid[r][c],)\n            heapq.heappush(pq, (initial_path_tuple, r, c, 1))\n            best_path_to_state[(r, c, 1)] = initial_path_tuple\n\n    while pq:\n        current_path_tuple, r, c, current_length = heapq.heappop(pq)\n\n        # If a lexicographically smaller or equal path to this state was already found, skip.\n        state_key = (r, c, current_length)\n        if state_key in best_path_to_state and \\\n           current_path_tuple > best_path_to_state[state_key]:\n            continue\n\n        if current_length == k:\n            return list(current_path_tuple)\n\n        # Explore neighbors if the path can be extended further (length < k).\n        if current_length < k:\n            for nr, nc in get_neighbors(r, c):\n                new_path_tuple = current_path_tuple + (grid[nr][nc],)\n                new_length = current_length + 1\n\n                new_state_key = (nr, nc, new_length)\n                # Update if this new path is better or this state is new.\n                if new_state_key not in best_path_to_state or \\\n                   new_path_tuple < best_path_to_state[new_state_key]:\n                    best_path_to_state[new_state_key] = new_path_tuple\n                    heapq.heappush(pq, (new_path_tuple, nr, nc, new_length))\n    \n    # This return should not be reached based on the problem guarantee of a unique answer.\n    return []"}
{"task_id": "HumanEval/129", "solution": "import heapq\nfrom typing import List, Tuple, Dict\nclass Grid:\n    \"\"\"\n    Manages access to grid data, validates positions, and provides neighbor coordinates.\n    \"\"\"\n    DIRECTIONS: List[Tuple[int, int]] = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Up, Down, Left, Right\n\n    def __init__(self, grid: List[List[int]]):\n        \"\"\"Initializes the Grid manager with the input grid.\"\"\"\n        self._grid = grid\n        self._N = len(grid)\n\n    def get_value(self, r: int, c: int) -> int:\n        \"\"\"Returns the value at the specified grid coordinates.\"\"\"\n        return self._grid[r][c]\n\n    def is_valid_pos(self, r: int, c: int) -> bool:\n        \"\"\"Checks if the given row and column coordinates are within the grid boundaries.\"\"\"\n        return 0 <= r < self._N and 0 <= c < self._N\n\n    def get_neighbors(self, r: int, c: int) -> List[Tuple[int, int]]:\n        \"\"\"Returns a list of valid (on-grid) neighbor coordinates for a given cell.\"\"\"\n        neighbors = []\n        for dr, dc in self.DIRECTIONS:\n            nr, nc = r + dr, c + dc\n            if self.is_valid_pos(nr, nc):\n                neighbors.append((nr, nc))\n        return neighbors\nclass PathFinder:\n    \"\"\"\n    Implements the core Dijkstra-like algorithm to find the lexicographically smallest path.\n    \"\"\"\n    def __init__(self, grid_manager: Grid, k: int):\n        \"\"\"Initializes the PathFinder with the grid manager and target path length.\"\"\"\n        self._grid_manager = grid_manager\n        self._k = k\n        self._N = grid_manager._N \n        self._priority_queue: List[Tuple[Tuple[int, ...], int, int, int]] = []\n        self._visited: Dict[Tuple[int, int, int], Tuple[int, ...]] = {}\n\n    def find_min_path(self) -> List[int]:\n        \"\"\"\n        Executes the pathfinding algorithm and returns the minimum path.\n        This uses a modified Dijkstra's algorithm to prioritize lexicographically smaller paths.\n        \"\"\"\n        # Initialize priority queue with all possible starting cells\n        for r in range(self._N):\n            for c in range(self._N):\n                start_value = self._grid_manager.get_value(r, c)\n                initial_path = (start_value,)\n                heapq.heappush(self._priority_queue, (initial_path, r, c, 1))\n                self._visited[(r, c, 1)] = initial_path\n\n        while self._priority_queue:\n            current_path_values, r, c, length = heapq.heappop(self._priority_queue)\n\n            # If a lexicographically smaller path to this state (r, c, length) has already been found and processed, skip this one.\n            if current_path_values > self._visited[(r, c, length)]:\n                continue\n\n            if length == self._k:\n                return list(current_path_values)\n\n            if length < self._k:\n                for nr, nc in self._grid_manager.get_neighbors(r, c):\n                    neighbor_value = self._grid_manager.get_value(nr, nc)\n                    new_path_values = current_path_values + (neighbor_value,)\n                    new_length = length + 1\n\n                    # If this new path is better than any previously found path to (nr, nc, new_length)\n                    if (nr, nc, new_length) not in self._visited or \\\n                       new_path_values < self._visited[(nr, nc, new_length)]:\n                        self._visited[(nr, nc, new_length)] = new_path_values\n                        heapq.heappush(self._priority_queue, (new_path_values, nr, nc, new_length))\n        \n        # This part should not be reached based on problem guarantees of a unique answer.\n        return []\ndef minPath(grid: List[List[int]], k: int) -> List[int]:\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k, \n    finds the minimum path of length k.\n    The path is chosen based on lexicographical comparison of cell values.\n    \"\"\"\n    grid_manager = Grid(grid)\n    path_finder = PathFinder(grid_manager, k)\n    return path_finder.find_min_path()"}
