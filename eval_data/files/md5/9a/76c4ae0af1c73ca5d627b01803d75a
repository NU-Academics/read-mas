{"task_id": "HumanEval/115", "solution": "import math\ndef max_fill(grid, capacity):\n    \"\"\"\n    Calculates the number of times buckets need to be lowered to empty the wells.\n    It sums water units per well and applies ceil(water / capacity).\n    \"\"\"\n    if not isinstance(grid, list) or not all(isinstance(row, list) for row in grid):\n        raise TypeError(\"Grid must be a list of lists.\")\n    if not all(all(isinstance(unit, int) and unit in (0, 1) for unit in row) for row in grid):\n        raise ValueError(\"Grid elements must be 0 or 1.\")\n    if not isinstance(capacity, int) or not (1 <= capacity <= 10):\n        raise ValueError(\"Capacity must be an integer between 1 and 10.\")\n    if not grid:\n        return 0\n\n    total_lowerings = 0\n    for row in grid:\n        water_in_well = sum(row)\n        \n        if water_in_well > 0:\n            lowerings_for_well = math.ceil(water_in_well / capacity)\n            total_lowerings += lowerings_for_well\n    \n    return total_lowerings"}
{"task_id": "HumanEval/115", "solution": "import math\nfrom typing import List\nclass Well:\n    \"\"\"Represents a single well (row) in the grid.\n    It calculates its total water content.\"\"\"\n    def __init__(self, water_units: List[int]):\n        self._water_units = water_units\n\n    def get_total_water(self) -> int:\n        \"\"\"Calculates the sum of all '1's in the water units list.\"\"\"\n        return sum(self._water_units)\nclass Grid:\n    \"\"\"Represents the entire grid of wells.\n    It provides an object-oriented view of the raw input.\"\"\"\n    def __init__(self, wells: List[Well]):\n        self._wells = wells\n\n    @classmethod\n    def from_raw_grid(cls, raw_grid: List[List[int]]) -> 'Grid':\n        \"\"\"Factory method to construct a Grid object from raw input.\"\"\"\n        wells = [Well(row) for row in raw_grid]\n        return cls(wells)\n\n    def get_wells(self) -> List[Well]:\n        \"\"\"Returns the list of Well objects contained within the grid.\"\"\"\n        return self._wells\ndef max_fill(grid: List[List[int]], capacity: int) -> int:\n    \"\"\"Calculates the total number of times buckets need to be lowered.\n    It processes a grid of wells and a bucket capacity.\"\"\"\n    grid_obj = Grid.from_raw_grid(grid)\n    total_bucket_lowers = 0\n\n    for well in grid_obj.get_wells():\n        total_water = well.get_total_water()\n        if total_water > 0:\n            lowers_for_well = math.ceil(total_water / capacity)\n            total_bucket_lowers += lowers_for_well\n    \n    return total_bucket_lowers"}
