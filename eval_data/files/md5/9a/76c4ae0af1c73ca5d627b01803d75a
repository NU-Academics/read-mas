{"task_id": "HumanEval/124", "solution": "import re\nDAYS_IN_MONTH = {\n    1: 31, 2: 29, 3: 31, 4: 30, 5: 31, 6: 30,\n    7: 31, 8: 31, 9: 30, 10: 31, 11: 30, 12: 31\n}\n_DATE_FORMAT_REGEX = re.compile(r\"^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])-\\\\d{4}$\")\ndef valid_date(date):\n    \"\"\"Validates a given date string for format mm-dd-yyyy and valid month/day ranges.\n    Returns True if valid, False otherwise.\n    \"\"\"\n    # FR1: The date string is not empty.\n    if not date:\n        return False\n\n    # FR2: The date string is in the format mm-dd-yyyy.\n    if not _DATE_FORMAT_REGEX.match(date):\n        return False\n\n    # Parse date parts after format validation.\n    try:\n        month_str, day_str, year_str = date.split('-')\n        month, day, year = int(month_str), int(day_str), int(year_str)\n    except ValueError:\n        # This case should ideally be covered by the regex, but included for robustness.\n        return False\n\n    # FR3: The month component is not less than 1 or higher than 12.\n    if not (1 <= month <= 12):\n        return False\n\n    # FR4: The day component based on the month.\n    max_days = DAYS_IN_MONTH.get(month)\n    if max_days is None or not (1 <= day <= max_days):\n        return False\n\n    return True"}
{"task_id": "HumanEval/124", "solution": "import re\ndef valid_date(date):\n    \"\"\"\n    Validates a date string according to specified rules and mm-dd-yyyy format.\n    Returns True if the date is valid, False otherwise.\n    \"\"\"\n\n    # Helper function to determine if a year is a leap year.\n    def _is_leap_year(year_val):\n        return (year_val % 4 == 0 and year_val % 100 != 0) or (year_val % 400 == 0)\n\n    # Regular expression for mm-dd-yyyy format validation.\n    DATE_FORMAT_REGEX = r\"^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])-\\\\d{4}$\"\n    # Lists of months with 31 or 30 days.\n    MONTH_DAYS_31 = [1, 3, 5, 7, 8, 10, 12]\n    MONTH_DAYS_30 = [4, 6, 9, 11]\n\n    # BR1/FR1: The date string must not be empty.\n    if not date:\n        return False\n\n    # BR2/FR2: The date format must be mm-dd-yyyy.\n    match = re.match(DATE_FORMAT_REGEX, date)\n    if not match:\n        return False\n\n    month = int(match.group(1))\n    day = int(match.group(2))\n    year = int(match.group(3))\n\n    # BR3/FR3: Months must be between 1 and 12.\n    if not (1 <= month <= 12):\n        return False\n\n    # BR4, BR5, BR6/FR4: Days must be appropriate for the given month and year.\n    max_days = 0\n    if month in MONTH_DAYS_31:\n        max_days = 31\n    elif month in MONTH_DAYS_30:\n        max_days = 30\n    elif month == 2:  # February\n        max_days = 29 if _is_leap_year(year) else 28\n    # The 'else' case for max_days is unreachable due to the month validation above.\n\n    return 1 <= day <= max_days"}
{"task_id": "HumanEval/124", "solution": "import re\nMONTH_DAYS_MAP = {\n    1: 31, 2: 29, 3: 31, 4: 30, 5: 31, 6: 30,\n    7: 31, 8: 31, 9: 30, 10: 31, 11: 30, 12: 31\n}\ndef valid_date(date: str) -> bool:\n    \"\"\"\n    Validates a given date string for non-emptiness, mm-dd-yyyy format, valid month (1-12), and correct days per month.\n    Returns True if all rules are satisfied, False otherwise.\n    \"\"\"\n    # Rule 1: The date string is not empty.\n    if not date:\n        return False\n\n    # Rule 4: The date should be in the format: mm-dd-yyyy.\n    # This regex also partially validates month (01-12) and day (01-31) formats.\n    date_pattern = re.compile(r'^(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])-\\\\d{4}$')\n    match = date_pattern.match(date)\n    if not match:\n        return False\n\n    # Extract components from the matched string for further numeric validation.\n    try:\n        month_str, day_str, _ = date.split('-') # Year is not validated beyond format.\n        month = int(month_str)\n        day = int(day_str)\n    except ValueError:\n        return False\n\n    # Rule 3: The months should not be less than 1 or higher than 12.\n    if not (1 <= month <= 12):\n        return False\n\n    # Rule 2: Validate the number of days based on the month.\n    max_days = MONTH_DAYS_MAP.get(month)\n    \n    if not (1 <= day <= max_days):\n        return False\n\n    return True"}
{"task_id": "HumanEval/124", "solution": "import re\n_DATE_FORMAT_REGEX = r\"^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])-\\d{4}$\"\n_MONTH_DAYS_MAP = {\n    1: 31, 3: 31, 5: 31, 7: 31, 8: 31, 10: 31, 12: 31,\n    4: 30, 6: 30, 9: 30, 11: 30,\n    2: 29\n}\ndef valid_date(date: str) -> bool:\n    \"\"\"Validates a given date string for format and value rules.\n    Returns True if valid, False otherwise.\n    \"\"\"\n    if not date:\n        return False\n\n    if not re.match(_DATE_FORMAT_REGEX, date):\n        return False\n    \n    try:\n        month_str, day_str, year_str = date.split('-')\n        month = int(month_str)\n        day = int(day_str)\n        _ = int(year_str) # Year value is not further validated for range.\n    except ValueError:\n        return False\n\n    if not (1 <= month <= 12):\n        return False\n\n    if not (1 <= day):\n        return False\n    \n    max_days = _MONTH_DAYS_MAP.get(month)\n    if max_days is None or not (day <= max_days):\n        return False\n\n    return True"}
{"task_id": "HumanEval/124", "solution": "import re\ndef valid_date(date):\n    \"\"\"You have to write a function which validates a given date string and\n    returns True if the date is valid otherwise False.\n    The date is valid if all of the following rules are satisfied:\n    1. The date string is not empty.\n    2. The number of days is not less than 1 or higher than 31 days for months 1,3,5,7,8,10,12. And the number of days is not less than 1 or higher than 30 days for months 4,6,9,11. And, the number of days is not less than 1 or higher than 29 for the month 2.\n    3. The months should not be less than 1 or higher than 12.\n    4. The date should be in the format: mm-dd-yyyy\n\n    for example: \n    valid_date('03-11-2000') => True\n\n    valid_date('15-01-2012') => False\n\n    valid_date('04-0-2040') => False\n\n    valid_date('06-04-2020') => True\n\n    valid_date('06/04/2020') => False\n    \"\"\"\n    # Rule 1: The date string is not empty.\n    if not date:\n        return False\n\n    # Constants for date validation\n    DATE_FORMAT_REGEX = r\"^(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])-\\d{4}$\"\n    MONTH_DAYS_31 = [1, 3, 5, 7, 8, 10, 12]\n    MONTH_DAYS_30 = [4, 6, 9, 11]\n    FEBRUARY = 2\n    MIN_MONTH = 1\n    MAX_MONTH = 12\n\n    # Rule 4: The date should be in the format: mm-dd-yyyy\n    match = re.fullmatch(DATE_FORMAT_REGEX, date)\n    if not match:\n        return False\n\n    try:\n        month = int(match.group(1))\n        day = int(match.group(2))\n        year = int(match.group(3))\n    except ValueError:\n        # This should ideally not be reached if regex is robust, but for safety\n        return False\n\n    # Rule 3: The months should not be less than 1 or higher than 12.\n    if not (MIN_MONTH <= month <= MAX_MONTH):\n        return False\n\n    # Rule 2: Validate days based on month and leap year considerations.\n    if day < 1:\n        return False\n\n    if month in MONTH_DAYS_31:\n        if not (day <= 31):\n            return False\n    elif month in MONTH_DAYS_30:\n        if not (day <= 30):\n            return False\n    elif month == FEBRUARY:\n        # Determine if it's a leap year\n        is_leap_year = (year % 4 == 0 and year % 100 != 0) or (year % 400 == 0)\n        max_days = 29 if is_leap_year else 28\n        if not (day <= max_days):\n            return False\n    else:\n        # This case should not be reached if month validation (Rule 3) passed,\n        # but as a safeguard.\n        return False\n\n    return True"}
