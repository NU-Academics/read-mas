{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Calculates the sum of magnitudes multiplied by the product of signs for an array of integers.\n    Returns None for an empty array.\n\n    Example:\n    >>> prod_signs([1, 2, 2, -4]) == -9\n    >>> prod_signs([0, 1]) == 0\n    >>> prod_signs([]) == None\n    \"\"\"\n\n    def _get_sign(num: int) -> int:\n        \"\"\"\n        Determines the sign of an integer.\n        Returns 1 for positive, -1 for negative, and 0 for zero.\n        \"\"\"\n        if num > 0:\n            return 1\n        elif num < 0:\n            return -1\n        else:\n            return 0\n\n    def _calculate_sum_of_magnitudes(data_arr: list[int]) -> int:\n        \"\"\"Calculates the sum of the absolute values (magnitudes) of all integers in an array.\"\"\"\n        total_magnitude = 0\n        for n in data_arr:\n            total_magnitude += abs(n)\n        return total_magnitude\n\n    def _calculate_product_of_signs(data_arr: list[int]) -> int:\n        \"\"\"\n        Calculates the product of the signs of all integers in an array.\n        This uses the _get_sign helper for each number.\n        \"\"\"\n        product_of_signs = 1\n        for n in data_arr:\n            product_of_signs *= _get_sign(n)\n        return product_of_signs\n\n    if not arr:\n        return None\n\n    sum_of_magnitudes = _calculate_sum_of_magnitudes(arr)\n    product_of_signs = _calculate_product_of_signs(arr)\n\n    return sum_of_magnitudes * product_of_signs"}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Calculates the sum of magnitudes multiplied by the product of signs for an array of integers.\n    Returns None for an empty array, otherwise the calculated integer.\n    \"\"\"\n    if not arr:\n        return None\n\n    sum_of_magnitudes = sum(abs(x) for x in arr)\n\n    product_of_signs = 1\n    for num in arr:\n        # Determine sign based on business rules: 1 for positive, -1 for negative, 0 for zero.\n        if num > 0:\n            sign = 1\n        elif num < 0:\n            sign = -1\n        else:\n            sign = 0\n        product_of_signs *= sign\n        # Optimization: if product of signs becomes 0, the final result will be 0.\n        if product_of_signs == 0:\n            break\n\n    return sum_of_magnitudes * product_of_signs"}
