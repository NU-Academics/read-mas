{"task_id": "HumanEval/24", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input values in divisor calculations.\"\"\"\n    pass\ndef largest_divisor(n: int) -> int:\n    \"\"\"\n    Finds the largest divisor of 'n' that is strictly smaller than 'n'.\n    This function efficiently iterates downwards to find the first proper divisor.\n    \"\"\"\n    if not isinstance(n, int) or n <= 1:\n        raise InvalidInputError(\"Input 'n' must be an integer greater than 1.\")\n\n    # Iterate downwards from n // 2 to 1 to find the largest proper divisor efficiently.\n    for i in range(n // 2, 0, -1):\n        if n % i == 0:\n            return i\n    \n    # This line should only be reached if n is prime, in which case 1 is the largest proper divisor.\n    return 1"}
{"task_id": "HumanEval/24", "solution": "def largest_divisor(n: int) -> int:\n    \"\"\" For a given number n, find the largest number that divides n evenly, smaller than n\n    >>> largest_divisor(15)\n    5\n    \"\"\"\n    for i in range(n // 2, 0, -1):\n        if n % i == 0:\n            return i\n    # This line is reached if n is a prime number (e.g., n=2, 3, 5, 7, etc.)\n    # In such cases, the largest divisor smaller than n is 1.\n    return 1"}
{"task_id": "HumanEval/24", "solution": "class DivisorError(Exception):\n    \"\"\"Base exception for errors in mathematical utility functions.\n    It carries a descriptive message about the error.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass InvalidInputError(DivisorError):\n    \"\"\"Exception raised for invalid input values in calculations.\n    This includes non-positive numbers where positive values are required.\"\"\"\n    def __init__(self, message: str = \"Input must be a positive integer greater than 1.\"):\n        super().__init__(message)\ndef largest_divisor(n: int) -> int:\n    \"\"\"For a given number n, find the largest number that divides n evenly, smaller than n.\n    This function specifically looks for proper divisors.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n <= 1:\n        raise InvalidInputError(\"Input 'n' must be greater than 1 to have a proper divisor.\")\n\n    # Iterate downwards from n // 2 to 1 to find the largest proper divisor.\n    for i in range(n // 2, 0, -1):\n        if n % i == 0:\n            return i\n    # This line is a safeguard; for any n > 1, 1 will always be found as a divisor.\n    return 1"}
{"task_id": "HumanEval/24", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\nERROR_INVALID_N = \"Input 'n' must be an integer greater than 1.\"\ndef largest_divisor(n: int) -> int:\n    \"\"\"For a given number n, find the largest number that divides n evenly, smaller than n.\n    Raises InvalidInputError if n is not an integer or n is less than or equal to 1.\n    \"\"\"\n    if not isinstance(n, int) or n <= 1:\n        raise InvalidInputError(ERROR_INVALID_N)\n\n    for i in range(n // 2, 0, -1):\n        if n % i == 0:\n            return i\n    \n    return 1 # For prime numbers, 1 is the largest proper divisor."}
