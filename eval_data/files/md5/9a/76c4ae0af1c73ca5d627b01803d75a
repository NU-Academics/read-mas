{"task_id": "HumanEval/69", "solution": "import collections\ndef search(lst):\n    \"\"\"\n    Given a non-empty list of positive integers, this function returns the greatest integer\n    whose frequency in the list is greater than or equal to its value.\n    If no such integer exists, it returns -1.\n    \"\"\"\n    frequency_map = collections.Counter(lst)\n    \n    candidates = []\n    for num, freq in frequency_map.items():\n        if freq >= num:\n            candidates.append(num)\n    \n    if not candidates:\n        return -1\n    \n    return max(candidates)"}
{"task_id": "HumanEval/69", "solution": "import collections\ndef search(lst):\n    \"\"\"\n    Finds the greatest positive integer in a list whose frequency is greater than or equal to its value.\n    Returns -1 if no such integer exists, assuming the input list contains positive integers.\n    \"\"\"\n    if not lst:\n        return -1\n\n    frequency_map = collections.Counter(lst)\n\n    # Iterate unique numbers in descending order to find the greatest match first.\n    for num in sorted(frequency_map.keys(), reverse=True):\n        if num > 0 and frequency_map[num] >= num:\n            return num\n\n    return -1"}
{"task_id": "HumanEval/69", "solution": "from collections import Counter\nfrom typing import List\ndef search(lst: List[int]) -> int:\n    \"\"\"\n    Finds the greatest integer in a list whose frequency is greater than or equal to its value.\n    Returns -1 if no such integer exists, considering only positive integers.\n    \"\"\"\n    # Calculate the frequency of each integer in the input list.\n    frequencies = Counter(lst)\n\n    candidates = []\n    # Iterate through each unique integer and its frequency.\n    for value, freq in frequencies.items():\n        # Add integer to candidates if it's positive and its frequency is greater than or equal to its value.\n        if value > 0 and freq >= value:\n            candidates.append(value)\n\n    # Return the greatest candidate integer, or -1 if no candidates were found.\n    if candidates:\n        return max(candidates)\n    else:\n        return -1"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even non-negative integer in arr and its smallest index.\n    Returns [value, index] or an empty list if no even values or arr is empty.\n    \"\"\"\n    if not arr:\n        return []\n\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for index, value in enumerate(arr):\n        # Value is guaranteed to be non-negative by business rules.\n        if value % 2 == 0:\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = index\n            elif value == smallest_even_value and index < smallest_even_index:\n                # Resolve ties by smallest index.\n                smallest_even_index = index\n\n    if smallest_even_index != -1:\n        return [smallest_even_value, smallest_even_index]\n    else:\n        return []"}
{"task_id": "HumanEval/69", "solution": "from collections import Counter\ndef search(lst):\n    \"\"\"\n    Finds the greatest integer that is greater than zero, and has a frequency\n    greater than or equal to the value of the integer itself.\n    \"\"\"\n    frequencies = Counter(lst)\n    max_found_value = -1\n\n    for num, freq in frequencies.items():\n        # Check if the number is positive and its frequency meets the condition.\n        if num > 0 and freq >= num:\n            max_found_value = max(max_found_value, num)\n    \n    return max_found_value"}
