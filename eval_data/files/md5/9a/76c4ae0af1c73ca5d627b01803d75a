{"task_id": "HumanEval/44", "solution": "from typing import List\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\n    It carries a descriptive message about the error.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nERROR_MSG_X_NEGATIVE = \"Input number x must be non-negative.\"\nERROR_MSG_BASE_RANGE = \"Base must be an integer between 2 and 9 (inclusive).\"\nERROR_MSG_X_TYPE = \"Input number x must be an integer.\"\nERROR_MSG_BASE_TYPE = \"Base must be an integer.\"\ndef change_base(x: int, base: int) -> str:\n    \"\"\"Change numerical base of input number x to base.\n    Returns string representation after the conversion.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    # Input validation as per specification\n    if not isinstance(x, int):\n        raise InvalidInputError(ERROR_MSG_X_TYPE)\n    if not isinstance(base, int):\n        raise InvalidInputError(ERROR_MSG_BASE_TYPE)\n    if x < 0:\n        raise InvalidInputError(ERROR_MSG_X_NEGATIVE)\n    if not (2 <= base < 10):\n        raise InvalidInputError(ERROR_MSG_BASE_RANGE)\n\n    # Core conversion logic\n    if x == 0:\n        return \"0\"\n\n    result_digits: List[str] = []\n    current_x = x\n\n    while current_x > 0:\n        remainder = current_x % base\n        result_digits.append(str(remainder))\n        current_x //= base\n\n    return \"\".join(reversed(result_digits))"}
{"task_id": "HumanEval/44", "solution": "class InvalidInputError(Exception):\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nMIN_BASE = 2\nMAX_BASE = 9\ndef change_base(x: int, base: int) -> str:\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    # Validate input number x and target base.\n    if not isinstance(x, int) or x < 0:\n        raise InvalidInputError(\"Input number 'x' must be a non-negative integer.\")\n    if not isinstance(base, int) or not (MIN_BASE <= base <= MAX_BASE):\n        raise InvalidInputError(\n            f\"Base must be an integer between {MIN_BASE} and {MAX_BASE} (inclusive).\"\n        )\n\n    # Handle the special case where x is 0.\n    if x == 0:\n        return \"0\"\n\n    result_digits = []\n    current_x = x\n    while current_x > 0:\n        remainder = current_x % base\n        result_digits.append(str(remainder))\n        current_x //= base\n    \n    # Reverse the collected digits and join them to form the final string.\n    return \"\".join(result_digits[::-1])"}
{"task_id": "HumanEval/44", "solution": "class InvalidBaseError(ValueError):\n    \"\"\"Exception raised for errors in the input base.\n    The message provides details about the valid base range.\n    \"\"\"\n    def __init__(self, message: str = \"Invalid base. Base must be between 2 and 9.\"):\n        self.message = message\n        super().__init__(self.message)\nclass InvalidNumberError(ValueError):\n    \"\"\"Exception raised for errors in the input number.\n    This typically occurs if the number is negative.\n    \"\"\"\n    def __init__(self, message: str = \"Invalid number. Number must be non-negative.\"):\n        self.message = message\n        super().__init__(self.message)\nMIN_BASE = 2\nMAX_BASE = 9\ndef change_base(x: int, base: int) -> str:\n    \"\"\"\n    Converts a non-negative integer `x` from base 10 to its string representation in the specified target `base`.\n    The target `base` must be an integer between 2 and 9, inclusive.\n    \"\"\"\n    if not isinstance(x, int) or x < 0:\n        raise InvalidNumberError(\"Input number 'x' must be a non-negative integer.\")\n    if not isinstance(base, int) or not (MIN_BASE <= base <= MAX_BASE):\n        raise InvalidBaseError(f\"Input base 'base' must be an integer between {MIN_BASE} and {MAX_BASE}.\")\n\n    if x == 0:\n        return \"0\"\n\n    result = []\n    current_x = x\n    while current_x > 0:\n        remainder = current_x % base\n        result.append(str(remainder))\n        current_x //= base\n    \n    return \"\".join(result[::-1])"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    Return string representation after the conversion.\"\"\"\n\n    # Validate x is an integer and non-negative.\n    if not isinstance(x, int):\n        raise ValueError(\"x must be an integer.\")\n    if x < 0:\n        raise ValueError(\"x must be a non-negative integer.\")\n\n    # Validate base is an integer and within the valid range [2, 9].\n    if not isinstance(base, int):\n        raise ValueError(\"base must be an integer.\")\n    if not (2 <= base < 10):\n        raise ValueError(\"Base must be an integer between 2 and 9 (inclusive).\")\n\n    # Handle the special case for x = 0.\n    if x == 0:\n        return \"0\"\n\n    # Perform the base conversion algorithm.\n    result = \"\"\n    current_x = x\n    while current_x > 0:\n        remainder = current_x % base\n        result = str(remainder) + result\n        current_x //= base\n    return result"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int) -> str:\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    if not (2 <= base < 10):\n        raise ValueError(f\"Base must be an integer between 2 and 9, but got {base}.\")\n\n    if x == 0:\n        return \"0\"\n\n    is_negative = x < 0\n    abs_x = abs(x)\n    digits = []\n\n    while abs_x > 0:\n        remainder = abs_x % base\n        digits.append(str(remainder))\n        abs_x //= base\n\n    result = \"\".join(digits[::-1])\n    if is_negative:\n        result = \"-\" + result\n    return result"}
