{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    \"\"\"\n    Checks if the input string contains a valid subsequence of brackets\n    where at least one bracket in the subsequence is nested (pattern '[[]]').\n    It also validates the input string.\n    \"\"\"\n    if not isinstance(string, str):\n        raise TypeError(\"Input must be a string.\")\n    if not all(char in ['[', ']'] for char in string):\n        raise ValueError(\"String must contain only square brackets '[' and ']'.\")\n\n    # State machine to detect the '[[]]' pattern as a subsequence.\n    # States track the progress of finding `[`, `[`, `]`, `]`.\n    state = 0\n    for char in string:\n        if char == '[':\n            if state == 0:\n                state = 1\n            elif state == 1:\n                state = 2\n            # If state is 2 or 3, another '[' does not change the state for finding the next required character.\n        elif char == ']':\n            if state == 0:\n                pass  # Unmatched ']', ignore.\n            elif state == 1:\n                state = 0  # Found outer_open, but then ']', not inner_open. Reset state.\n            elif state == 2:\n                state = 3  # Found inner_close.\n            elif state == 3:\n                return True  # Found outer_close, pattern '[[]]' complete.\n    return False"}
{"task_id": "HumanEval/132", "solution": "class InvalidBracketStringError(Exception):\n    \"\"\"Custom exception for invalid bracket strings.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef is_nested(string: str) -> bool:\n    '''\n    Create a function that takes a string as input which contains only square brackets.\n    The function should return True if and only if there is a valid subsequence of brackets \n    where at least one bracket in the subsequence is nested.\n\n    is_nested('[[]]') \u279e True\n    is_nested('[]]]]]]][[[[[]') \u279e False\n    is_nested('[][]') \u279e False\n    is_nested('[]') \u279e False\n    is_nested('[[][]]') \u279e True\n    is_nested('[[]][[') \u279e True\n    '''\n\n    # FR1: Input validation for allowed characters.\n    if not all(char in '[]' for char in string):\n        raise InvalidBracketStringError(\"Input string must contain only '[' and ']' characters.\")\n\n    # Helper function from the design specification.\n    def _is_valid_bracket_sequence(sub_s: str) -> bool:\n        \"\"\"\n        Checks if a substring forms a non-empty, balanced, and correctly ordered bracket sequence.\n        Returns False if the substring is empty or improperly formed.\n        \"\"\"\n        if not sub_s:\n            return False \n        \n        balance = 0\n        for char in sub_s:\n            if char == '[':\n                balance += 1\n            else: # char == ']'\n                balance -= 1\n            if balance < 0:\n                return False # Premature closing bracket\n        return balance == 0\n\n    # FR2 Main Flow: Find the outermost brackets.\n    first_open_idx = string.find('[')\n    last_close_idx = string.rfind(']')\n\n    # If no outer pair or they are in an invalid order, no nesting is possible.\n    if first_open_idx == -1 or last_close_idx == -1 or first_open_idx >= last_close_idx:\n        return False\n\n    # Extract the substring enclosed by the outermost brackets.\n    inner_s = string[first_open_idx + 1 : last_close_idx]\n    \n    # Check if this inner substring forms a valid, non-empty bracket sequence.\n    return _is_valid_bracket_sequence(inner_s)"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    For example:\n    digits(1)  == 1\n    digits(4)  == 0\n    digits(235) == 15\n    \"\"\"\n    product = 1\n    found_odd_digit = False\n\n    temp_n = n\n    if temp_n == 0:  # Handle the case for 0 explicitly, as 0 has no odd digits and is an even number.\n        return 0\n\n    while temp_n > 0:\n        digit = temp_n % 10\n        if digit % 2 != 0:  # Check if the digit is odd\n            product *= digit\n            found_odd_digit = True\n        temp_n //= 10\n\n    return product if found_odd_digit else 0"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string: str) -> bool:\n    '''\n    Create a function that takes a string as input which contains only square brackets.\n    The function should return True if and only if there is a valid subsequence of brackets \n    where at least one bracket in the subsequence is nested.\n    '''\n    \n    # Input validation: Ensure the string contains only square brackets\n    VALID_BRACKET_CHARS = {'[', ']'}\n    for char in string:\n        if char not in VALID_BRACKET_CHARS:\n            raise ValueError(\"Input string must contain only '[' and ']' characters.\")\n\n    # State machine to find the subsequence '[[]]'\n    # State 0: Looking for the first '['\n    # State 1: Found first '[', now looking for the second '['\n    # State 2: Found second '[', now looking for the first ']'\n    # State 3: Found first ']', now looking for the second ']'\n    \n    current_state = 0\n\n    for char in string:\n        if current_state == 0:\n            if char == '[':\n                current_state = 1\n        elif current_state == 1:\n            if char == '[':\n                current_state = 2\n            # If char is ']' here, it means we have '[]' - not nested yet.\n            # We stay in state 1, waiting for another '[' or moving to state 0 if we consider outer bracket completion\n            # But for subsequence, we just continue searching for the next '['\n        elif current_state == 2:\n            if char == ']':\n                current_state = 3\n        elif current_state == 3:\n            if char == ']':\n                return True # Found the pattern '[[]]'\n\n    return False"}
