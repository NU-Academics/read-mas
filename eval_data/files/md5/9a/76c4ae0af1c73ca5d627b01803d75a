{"task_id": "HumanEval/69", "solution": "from collections import Counter\ndef search(lst):\n    '''\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than \n    zero, and has a frequency greater than or equal to the value of the integer itself. \n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    Examples:\n        search([4, 1, 2, 2, 3, 1]) == 2\n        search([1, 2, 2, 3, 3, 3, 4, 4, 4]) == 3\n        search([5, 5, 4, 4, 4]) == -1\n    '''\n    if not lst:\n        return -1 # Although input is guaranteed non-empty by preconditions, this handles potential edge cases.\n\n    frequencies = Counter(lst) # Calculate the frequency of each positive integer in the input list.\n\n    candidates = []\n    for num, freq in frequencies.items():\n        if freq >= num: # Identify integers 'x' where frequency(x) >= x.\n            candidates.append(num)\n\n    if not candidates:\n        return -1\n    return max(candidates) # Return the greatest integer from candidates, or -1 if none exist."}
{"task_id": "HumanEval/69", "solution": "from collections import Counter\nfrom typing import List\ndef search(lst: List[int]) -> int:\n    \"\"\"\n    Finds the greatest integer in a list whose frequency is greater than or equal to its value.\n    Returns -1 if no such integer exists.\n    \"\"\"\n    if not lst:  # Defensive check, though preconditions state non-empty.\n        return -1\n\n    frequency_map = Counter(lst)\n    \n    candidates = []\n    for num, freq in frequency_map.items():\n        if num > 0 and freq >= num:\n            candidates.append(num)\n    \n    if not candidates:\n        return -1\n    \n    return max(candidates)"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    \"\"\"\n    Reorders a list of integers into a \"strange\" sequence,\n    alternating between the minimum and maximum remaining values.\n    \"\"\"\n    if not lst:\n        return []\n\n    sorted_copy = sorted(lst)\n    result = []\n    left, right = 0, len(sorted_copy) - 1\n\n    while left <= right:\n        result.append(sorted_copy[left])  # Append the current minimum\n        left += 1\n\n        if left <= right:\n            result.append(sorted_copy[right])  # Append the current maximum\n            right -= 1\n    return result"}
{"task_id": "HumanEval/69", "solution": "import collections\ndef search(lst):\n    '''\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than \n    zero, and has a frequency greater than or equal to the value of the integer itself. \n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    Examples:\n        search([4, 1, 2, 2, 3, 1]) == 2\n        search([1, 2, 2, 3, 3, 3, 4, 4, 4]) == 3\n        search([5, 5, 4, 4, 4]) == -1\n    '''\n    if not isinstance(lst, list):\n        raise TypeError(\"Input must be a list.\")\n    if not lst:\n        raise ValueError(\"Input list cannot be empty.\")\n    if not all(isinstance(x, int) and x > 0 for x in lst):\n        raise ValueError(\"Input list must contain only positive integers.\")\n\n    frequencies = collections.Counter(lst)\n\n    qualifying_numbers = [number for number, freq in frequencies.items() if freq >= number]\n\n    if not qualifying_numbers:\n        return -1\n\n    return max(qualifying_numbers)"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n\n    Examples:\n    strange_sort_list([1, 2, 3, 4]) == [1, 4, 2, 3]\n    strange_sort_list([5, 5, 5, 5]) == [5, 5, 5, 5]\n    strange_sort_list([]) == []\n    '''\n\n    def _find_and_remove_min(data):\n        \"\"\"\n        Finds the minimum element in the list, removes it, and returns it.\n        Modifies the input list in place.\n        \"\"\"\n        if not data:\n            raise ValueError(\"List cannot be empty for finding min.\")\n        min_val = data[0]\n        min_idx = 0\n        for i, val in enumerate(data):\n            if val < min_val:\n                min_val = val\n                min_idx = i\n        return data.pop(min_idx)\n\n    def _find_and_remove_max(data):\n        \"\"\"\n        Finds the maximum element in the list, removes it, and returns it.\n        Modifies the input list in place.\n        \"\"\"\n        if not data:\n            raise ValueError(\"List cannot be empty for finding max.\")\n        max_val = data[0]\n        max_idx = 0\n        for i, val in enumerate(data):\n            if val > max_val:\n                max_val = val\n                max_idx = i\n        return data.pop(max_idx)\n\n    if not lst:\n        return []\n\n    data_list = list(lst)\n    result = []\n    is_min_turn = True\n\n    while data_list:\n        if is_min_turn:\n            element = _find_and_remove_min(data_list)\n        else:\n            element = _find_and_remove_max(data_list)\n        result.append(element)\n        is_min_turn = not is_min_turn\n    return result"}
{"task_id": "HumanEval/70", "solution": "from typing import List\ndef strange_sort_list(lst: List[int]) -> List[int]:\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    '''\n    if not lst:\n        return []\n\n    working_list = list(lst)  # Create a mutable copy to avoid modifying the original list.\n    result = []\n\n    while working_list:\n        # Extract and append the minimum element from the remaining list.\n        min_val = min(working_list)\n        working_list.remove(min_val)\n        result.append(min_val)\n\n        if not working_list:\n            break  # Stop if the list became empty after extracting the minimum.\n\n        # Extract and append the maximum element from the remaining list.\n        max_val = max(working_list)\n        working_list.remove(max_val)\n        result.append(max_val)\n\n    return result"}
{"task_id": "HumanEval/70", "solution": "from typing import List\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input to the strange sort function.\"\"\"\n    pass\ndef strange_sort_list(lst: List[int]) -> List[int]:\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n\n    Examples:\n    strange_sort_list([1, 2, 3, 4]) == [1, 4, 2, 3]\n    strange_sort_list([5, 5, 5, 5]) == [5, 5, 5, 5]\n    strange_sort_list([]) == []\n    '''\n    if not isinstance(lst, list):\n        raise InvalidInputError(\"Input must be a list.\")\n    if not all(isinstance(x, int) for x in lst):\n        raise InvalidInputError(\"All elements in the list must be integers.\")\n\n    if not lst:\n        return []\n\n    # Create a sorted copy of the list.\n    # This allows efficient retrieval of min (from the beginning)\n    # and max (from the end) using pop operations.\n    working_list = sorted(lst)\n    result_list: List[int] = []\n\n    while working_list:\n        # Take the minimum element (first element in sorted list).\n        result_list.append(working_list.pop(0))\n        if not working_list:\n            # If the list became empty after taking min, break to avoid taking max\n            # from an empty list.\n            break\n\n        # Take the maximum element (last element in sorted list).\n        result_list.append(working_list.pop())\n\n    return result_list"}
{"task_id": "HumanEval/70", "solution": "from typing import List\ndef strange_sort_list(lst: List[int]) -> List[int]:\n    \"\"\"\n    Sorts a list of integers in a 'strange' order: minimum, then maximum of remaining,\n    then minimum of remaining, and so on. It returns a new list without modifying the original.\n    \"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"Input must be a list.\")\n    if not all(isinstance(x, int) for x in lst):\n        raise ValueError(\"All elements in the list must be integers.\")\n\n    if not lst:\n        return []\n\n    sorted_lst = sorted(lst)\n    result = []\n    left_ptr = 0\n    right_ptr = len(sorted_lst) - 1\n\n    while left_ptr <= right_ptr:\n        result.append(sorted_lst[left_ptr])\n        left_ptr += 1\n\n        if left_ptr <= right_ptr:\n            result.append(sorted_lst[right_ptr])\n            right_ptr -= 1\n    \n    return result"}
{"task_id": "HumanEval/70", "solution": "from typing import List\ndef strange_sort_list(lst: List[int]) -> List[int]:\n    \"\"\"\n    Sorts a list of integers into a min-max alternating order.\n    It takes the minimum, then the maximum of remaining elements, and so on.\n    \"\"\"\n    if not lst:\n        return []\n\n    # Create a sorted copy for efficient min/max access.\n    sorted_data = sorted(lst)\n    result_list: List[int] = []\n    min_idx = 0\n    max_idx = len(sorted_data) - 1\n\n    while min_idx <= max_idx:\n        result_list.append(sorted_data[min_idx])\n        min_idx += 1\n\n        if min_idx <= max_idx:\n            result_list.append(sorted_data[max_idx])\n            max_idx -= 1\n    \n    return result_list"}
