{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Checks if a file's name is valid based on specific conditions.\n    Returns 'Yes' if valid, 'No' otherwise.\n    \"\"\"\n    if not isinstance(file_name, str):\n        raise TypeError(\"file_name must be a string.\")\n\n    # Rule: File name must not contain more than three digits.\n    digit_count = sum(1 for char in file_name if char.isdigit())\n    if digit_count > 3:\n        return 'No'\n\n    # Rule: File name must contain exactly one dot.\n    parts = file_name.split('.')\n    if len(parts) != 2:\n        return 'No'\n\n    prefix, suffix = parts[0], parts[1]\n\n    # Rule: Prefix must not be empty and must start with a Latin alphabet letter.\n    if not prefix or not prefix[0].isalpha():\n        return 'No'\n\n    # Rule: Suffix must be one of the allowed extensions.\n    allowed_extensions = ['txt', 'exe', 'dll']\n    if suffix not in allowed_extensions:\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"\n    Checks if a file's name is valid based on predefined rules.\n    Returns 'Yes' if valid, 'No' otherwise.\n    \"\"\"\n    \n    # Rule: The file's name contains exactly one dot '.'\n    parts = file_name.split('.')\n    if len(parts) != 2:\n        return 'No'\n    \n    prefix = parts[0]\n    suffix = parts[1]\n\n    # Rule: There should not be more than three digits ('0'-'9') in the file's name.\n    digit_count = 0\n    for char in file_name:\n        if '0' <= char <= '9':\n            digit_count += 1\n    if digit_count > 3:\n        return 'No'\n\n    # Rule: The substring before the dot should not be empty, and it starts with a letter.\n    if not prefix:\n        return 'No'\n    if not ('a' <= prefix[0] <= 'z' or 'A' <= prefix[0] <= 'Z'):\n        return 'No'\n\n    # Rule: The substring after the dot should be one of these: ['txt', 'exe', 'dll'].\n    allowed_extensions = ['txt', 'exe', 'dll']\n    if suffix not in allowed_extensions:\n        return 'No'\n\n    # All checks passed\n    return 'Yes'"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Checks if a file's name is valid based on predefined rules.\n    Returns 'Yes' if the file's name is valid, 'No' otherwise.\n    \"\"\"\n    if not isinstance(file_name, str):\n        return 'No'\n\n    # BR1: Not more than three digits ('0'-'9')\n    digit_count = sum(1 for char in file_name if char.isdigit())\n    if digit_count > 3:\n        return 'No'\n\n    # BR2: Exactly one dot '.'\n    if file_name.count('.') != 1:\n        return 'No'\n\n    # Split the file name into prefix and extension\n    parts = file_name.split('.')\n    prefix = parts[0]\n    extension = parts[1]\n\n    # BR3: Substring before the dot must not be empty\n    if not prefix:\n        return 'No'\n\n    # BR4: Substring before the dot must start with a letter (a-z, A-Z)\n    if not prefix[0].isalpha():\n        return 'No'\n\n    # BR5: Substring after the dot (extension) must be one of the allowed types\n    ALLOWED_EXTENSIONS = ['txt', 'exe', 'dll']\n    if extension not in ALLOWED_EXTENSIONS:\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"Transforms list elements based on index rules and returns their sum.\n    Elements are squared if index % 3 == 0, cubed if index % 4 == 0 and index % 3 != 0, otherwise unchanged.\"\"\"\n    if not lst:\n        return 0\n\n    total_sum = 0\n    for i, entry in enumerate(lst):\n        if i % 3 == 0:\n            total_sum += entry * entry\n        elif i % 4 == 0:  # This implies i % 3 != 0 due to the 'elif' condition\n            total_sum += entry * entry * entry\n        else:\n            total_sum += entry\n    return total_sum"}
