{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"Checks if all string keys in a dictionary are consistently lowercase or uppercase.\n    Returns False if empty, contains non-string keys, or has mixed-case string keys.\n    \"\"\"\n    if not dict:\n        return False\n\n    is_all_lower = True\n    is_all_upper = True\n\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False  # Contains non-string keys\n\n        if is_all_lower and not key.islower():\n            is_all_lower = False\n        if is_all_upper and not key.isupper():\n            is_all_upper = False\n\n        # Early exit if consistency is already broken for both cases\n        if not is_all_lower and not is_all_upper:\n            return False\n\n    return is_all_lower or is_all_upper"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Checks if all keys are strings and consistently cased (all lowercase or all uppercase).\n    Returns False for empty dictionaries, non-string keys, mixed casing, or invalid string key casing.\n    \"\"\"\n    if not dict:\n        return False\n\n    has_lower = False\n    has_upper = False\n\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False\n\n        # Determine if the string key is all lowercase or all uppercase.\n        if key.islower():\n            has_lower = True\n        elif key.isupper():\n            has_upper = True\n        else:\n            return False # Key is a string but not consistently cased (e.g., \"Name\", \"123\").\n\n        # If both lowercase and uppercase keys have been encountered, return False immediately.\n        if has_lower and has_upper:\n            return False\n\n    return True"}
{"task_id": "HumanEval/96", "solution": "import math\ndef count_up_to(n: int) -> list[int]:\n    \"\"\"\n    Returns a list of all prime numbers strictly less than n.\n    Raises ValueError if n is not a non-negative integer.\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    if n <= 2:\n        return []\n\n    def is_prime(num: int) -> bool:\n        \"\"\"\n        Checks if a given integer is a prime number.\n        This uses trial division optimized by checking odd divisors up to the square root.\n        \"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(num)) + 1, 2):\n            if num % i == 0:\n                return False\n        return True\n\n    primes = []\n    for i in range(2, n):\n        if is_prime(i):\n            primes.append(i)\n    return primes"}
{"task_id": "HumanEval/96", "solution": "from typing import List\ndef _sieve_of_eratosthenes(limit: int) -> List[bool]:\n    \"\"\"\n    Implements the Sieve of Eratosthenes to find all primes up to a limit.\n    Returns a boolean list where index i is True if i is prime.\n    \"\"\"\n    if limit <= 2: # Handle limits where sieve logic might be tricky for 0, 1, 2\n        return [False] * limit\n    \n    is_prime_flags = [True] * limit\n    is_prime_flags[0] = is_prime_flags[1] = False # 0 and 1 are not prime\n\n    p = 2\n    while (p * p) < limit:\n        if is_prime_flags[p]:\n            for multiple in range(p * p, limit, p): # Mark all multiples of p as not prime\n                is_prime_flags[multiple] = False\n        p += 1\n    return is_prime_flags\ndef count_up_to(n):\n    \"\"\"Implement a function that takes an non-negative integer and returns an array of the first n\n    integers that are prime numbers and less than n.\n    for example:\n    count_up_to(5) => [2,3]\n    count_up_to(11) => [2,3,5,7]\n    count_up_to(0) => []\n    count_up_to(20) => [2,3,5,7,11,13,17,19]\n    count_up_to(1) => []\n    count_up_to(18) => [2,3,5,7,11,13,17]\n    \"\"\"\n    _validate_input(n)\n\n    if n <= 2:\n        return []\n\n    is_prime_flags = _sieve_of_eratosthenes(n)\n\n    primes = []\n    for i in range(2, n): # Primes must be less than n\n        if is_prime_flags[i]:\n            primes.append(i)\n    \n    return primes"}
