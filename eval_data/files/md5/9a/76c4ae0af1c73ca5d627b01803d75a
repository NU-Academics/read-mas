{"task_id": "HumanEval/44", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    pass\ndef change_base(x: int, base: int) -> str:\n    \"\"\"\n    Converts a non-negative integer x from base 10 to a specified target base (2-9).\n    Returns its string representation after conversion.\n    \"\"\"\n    if not isinstance(x, int) or x < 0:\n        raise InvalidInputError(\"Input number 'x' must be a non-negative integer.\")\n    if not isinstance(base, int) or not (2 <= base < 10):\n        raise InvalidInputError(\"Base must be an integer between 2 and 9 (inclusive).\")\n\n    if x == 0:\n        return \"0\"\n\n    digits = []\n    # Perform repeated integer division and collect remainders.\n    while x > 0:\n        remainder = x % base\n        digits.append(str(remainder))\n        x //= base\n\n    # Reverse the digits list and join them into a string.\n    return \"\".join(digits[::-1])"}
{"task_id": "HumanEval/44", "solution": "class InvalidBaseError(ValueError):\n    \"\"\"Exception raised for errors in the input base.\"\"\"\n    def __init__(self, message: str = \"Base must be an integer between 2 and 9 (inclusive).\"):\n        self.message = message\n        super().__init__(self.message)\nclass InvalidNumberError(ValueError):\n    \"\"\"Exception raised for errors in the input number.\"\"\"\n    def __init__(self, message: str = \"Number must be a non-negative integer.\"):\n        self.message = message\n        super().__init__(self.message)\nclass BaseConverter:\n    \"\"\"\n    Handles the conversion of a decimal number to a specified base.\n    \"\"\"\n    def __init__(self, x: int, base: int):\n        self._x = x\n        self._base = base\n        self._validate_inputs()\n\n    def _validate_inputs(self) -> None:\n        \"\"\"Validates the input number and base.\"\"\"\n        if not isinstance(self._x, int) or self._x < 0:\n            raise InvalidNumberError()\n        if not isinstance(self._base, int) or not (2 <= self._base <= 9):\n            raise InvalidBaseError()\n\n    def convert(self) -> str:\n        \"\"\"\n        Converts the internal number x to its string representation in the target base.\n        \"\"\"\n        if self._x == 0:\n            return \"0\"\n\n        result = []\n        current_x = self._x\n        while current_x > 0:\n            remainder = current_x % self._base\n            result.append(str(remainder))\n            current_x //= self._base\n        \n        return \"\".join(result[::-1])\ndef change_base(x: int, base: int) -> str:\n    \"\"\"Change numerical base of input number x to base.\n    Return string representation after the conversion.\n    Base numbers are less than 10.\n\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    converter = BaseConverter(x, base)\n    return converter.convert()"}
