'A', so shifted 'c' becomes 'C'.\n                processed_char = shifted_char_base.upper()\n            elif original_is_upper: # Original was 'A', swapped 'a', so shifted 'C' becomes 'c'.\n                processed_char = shifted_char_base.lower()\n\n        encoded_chars.append(processed_char)\n    return \"\".join(encoded_chars)"}
