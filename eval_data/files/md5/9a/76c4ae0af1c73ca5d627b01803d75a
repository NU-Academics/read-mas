{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"\n    Performs a circular right shift on the digits of x, returning the result as a string.\n    If shift exceeds the number of digits, the digits are reversed.\n    \"\"\"\n    if not isinstance(x, int):\n        raise TypeError(\"Input 'x' must be an integer.\")\n    if not isinstance(shift, int):\n        raise TypeError(\"Input 'shift' must be an integer.\")\n    if shift < 0:\n        raise ValueError(\"Input 'shift' must be a non-negative integer.\")\n\n    s = str(x)\n    n = len(s)\n\n    if shift > n:\n        return s[::-1]\n    else:\n        k = shift % n\n        return s[n - k:] + s[:n - k]"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"\n    Circularly shift integer digits to the right, preserving sign.\n    If shift exceeds digit count, digits are reversed.\n    \"\"\"\n    if not isinstance(x, int) or not isinstance(shift, int):\n        raise TypeError(\"Both x and shift must be integers.\")\n    if shift < 0:\n        raise ValueError(\"Shift amount must be non-negative.\")\n\n    is_negative = x < 0\n    abs_x = abs(x)\n    s_abs_x = str(abs_x)\n    num_digits = len(s_abs_x)\n\n    if abs_x == 0:\n        return \"0\"\n\n    result_str: str\n    if shift > num_digits:\n        result_str = s_abs_x[::-1]  # Reverse digits\n    else:\n        effective_shift = shift % num_digits\n        result_str = s_abs_x[-effective_shift:] + s_abs_x[:-effective_shift]\n\n    return \"-\" + result_str if is_negative else result_str"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x: int, shift: int) -> str:\n    \"\"\"\n    Circular shift the digits of the integer x right by shift, returning the result as a string.\n    If shift exceeds the number of digits, the digits are reversed.\n    \"\"\"\n    if not isinstance(x, int) or not isinstance(shift, int):\n        raise TypeError(\"Both x and shift must be integers.\")\n\n    if x == 0:\n        return \"0\"\n\n    sign = \"-\" if x < 0 else \"\"\n    s_abs = str(abs(x))\n    num_digits = len(s_abs)\n\n    if shift > num_digits:\n        return sign + s_abs[::-1]\n    else:\n        effective_shift = shift % num_digits\n        if effective_shift == 0:\n            return sign + s_abs\n        \n        shifted_s_abs = s_abs[num_digits - effective_shift:] + s_abs[:num_digits - effective_shift]\n        return sign + shifted_s_abs"}
