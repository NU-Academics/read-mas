{"task_id": "HumanEval/91", "solution": "import re\nfrom typing import List\nSENTENCE_DELIMITERS: tuple[str, ...] = ('.', '?', '!')\nTARGET_WORD: str = \"I\"\nclass SentenceTokenizer:\n    \"\"\"Utility class to tokenize text into sentences.\n    It splits text based on predefined delimiters.\"\"\"\n    def __init__(self, delimiters: tuple[str, ...]):\n        self._delimiters = delimiters\n        # Pattern to split by delimiters, escaping them for regex.\n        self._split_pattern = '|'.join(re.escape(d) for d in self._delimiters)\n\n    def tokenize(self, text: str) -> List[str]:\n        \"\"\"Splits the input text into a list of sentences.\n        Empty or whitespace-only sentences are filtered out.\"\"\"\n        if not isinstance(text, str):\n            raise TypeError(\"Input 'text' must be a string.\")\n\n        # Split by delimiters and clean up the results.\n        raw_sentences = re.split(self._split_pattern, text)\n\n        sentences = []\n        for s in raw_sentences:\n            stripped_s = s.strip()\n            if stripped_s: # Add only non-empty, non-whitespace sentences.\n                sentences.append(stripped_s)\n        return sentences\nclass BoredomCounterService:\n    \"\"\"Service to count sentences that start with the target word.\n    It uses a SentenceTokenizer to process text.\"\"\"\n    def __init__(self, tokenizer: SentenceTokenizer):\n        self._tokenizer = tokenizer\n\n    def _is_bored_sentence(self, sentence: str) -> bool:\n        \"\"\"Checks if a sentence starts with the target word 'I'.\n        'I' must be a standalone, case-sensitive word at the beginning.\"\"\"\n        words = sentence.strip().split(maxsplit=1)\n        if not words:\n            return False\n\n        first_word = words[0]\n        return first_word == TARGET_WORD\n\n    def count_boredoms(self, text: str) -> int:\n        \"\"\"Counts sentences in the text that begin with 'I'.\n        It tokenizes the text and checks each sentence for the condition.\"\"\"\n        sentences: List[str] = self._tokenizer.tokenize(text)\n        boredom_count = 0\n        for sentence in sentences:\n            if self._is_bored_sentence(sentence):\n                boredom_count += 1\n        return boredom_count\ndef is_bored(S: str) -> int:\n    \"\"\"Counts the number of boredoms in a string.\n    A boredom is a sentence that starts with the word 'I'.\"\"\"\n    tokenizer = SentenceTokenizer(SENTENCE_DELIMITERS)\n    counter_service = BoredomCounterService(tokenizer)\n    return counter_service.count_boredoms(S)"}
