{"task_id": "HumanEval/88", "solution": "from typing import List\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to array sorting functions.\"\"\"\n    ERROR_MSG_INVALID_TYPE = \"Input must be a list of non-negative integers.\"\n\n    def __init__(self, message: str = ERROR_MSG_INVALID_TYPE):\n        super().__init__(message)\n        self.message = message\ndef sort_array(array: List[int]) -> List[int]:\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting.\n    The array is sorted in ascending order if the sum of the first and last index values is odd,\n    or in descending order if the sum is even.\n\n    Note: The given array is not modified.\n    \"\"\"\n    # Validate input type and content.\n    if not isinstance(array, list):\n        raise InvalidInputError(\"Input must be a list.\")\n\n    for item in array:\n        if not isinstance(item, int) or item < 0:\n            raise InvalidInputError(\"All elements in the array must be non-negative integers.\")\n\n    # Handle empty or single-element arrays.\n    if len(array) <= 1:\n        return list(array)\n\n    # Determine sorting order based on sum of first and last elements.\n    first_element = array[0]\n    last_element = array[-1]\n    sum_first_last = first_element + last_element\n\n    # If sum is odd, sort ascending; otherwise, sort descending.\n    sort_ascending = (sum_first_last % 2 != 0)\n\n    # Sort a copy of the array.\n    return sorted(array, reverse=not sort_ascending)"}
{"task_id": "HumanEval/88", "solution": "from typing import List\ndef sort_array(array: List[int]) -> List[int]:\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting.\n    The array is sorted based on the parity of the sum of its first and last elements.\n    \"\"\"\n    # Input validation: Ensure all elements are non-negative integers.\n    if not all(isinstance(x, int) and x >= 0 for x in array):\n        raise ValueError(\"Input array must contain only non-negative integers.\")\n\n    # Return a copy for empty or single-element arrays (FR5, FR2).\n    if not array or len(array) <= 1:\n        return list(array)\n\n    # Create a copy to avoid modifying the original array (FR2).\n    copied_array = list(array)\n\n    first_element = array[0]\n    last_element = array[-1]\n    \n    # Determine sorting order based on sum of first and last elements (FR3).\n    if (first_element + last_element) % 2 != 0:  # Sum is odd, sort ascending.\n        return sorted(copied_array)\n    else:  # Sum is even, sort descending.\n        return sorted(copied_array, reverse=True)"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n\n    Note:\n    * don't change the given array.\n\n    Examples:\n    * sort_array([]) => []\n    * sort_array([5]) => [5]\n    * sort_array([2, 4, 3, 0, 1, 5]) => [0, 1, 2, 3, 4, 5]\n    * sort_array([2, 4, 3, 0, 1, 5, 6]) => [6, 5, 4, 3, 2, 1, 0]\n    \"\"\"\n    copied_array = list(array)\n\n    if len(copied_array) <= 1:\n        return copied_array\n\n    # Determine sorting order based on the sum of the first and last elements of the original array.\n    total_sum = array[0] + array[-1]\n\n    if total_sum % 2 != 0:  # Odd sum -> ascending order\n        copied_array.sort(reverse=False)\n    else:  # Even sum -> descending order\n        copied_array.sort(reverse=True)\n\n    return copied_array"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting.\n    The array is sorted ascending if the sum of its first and last elements is odd, descending if even.\n    \"\"\"\n    copied_array = list(array)  # Create a shallow copy to ensure the original array is not modified.\n\n    if len(copied_array) < 2:\n        return copied_array  # Return copy directly as sorting has no effect on empty or single-element arrays.\n\n    # Determine the sorting order based on the parity of the sum of the first and last elements.\n    sum_first_last = copied_array[0] + copied_array[-1]\n    \n    # Sort in ascending order if the sum is odd, otherwise sort in descending order.\n    if sum_first_last % 2 != 0:  # Odd sum implies ascending order.\n        copied_array.sort()\n    else:  # Even sum implies descending order.\n        copied_array.sort(reverse=True)\n\n    return copied_array"}
