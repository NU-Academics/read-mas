{"task_id": "HumanEval/39", "solution": "from typing import Iterator, Dict\nimport math\nclass FibonacciGenerator:\n    def __init__(self):\n        self._a = 0\n        self._b = 1\n\n    def generate(self) -> Iterator[int]:\n        \"\"\"Yields an infinite sequence of Fibonacci numbers.\"\"\"\n        yield self._a\n        yield self._b\n        while True:\n            next_fib = self._a + self._b\n            self._a = self._b\n            self._b = next_fib\n            yield next_fib\nclass PrimeChecker:\n    def __init__(self):\n        self._memo: Dict[int, bool] = {}\n\n    def is_prime(self, num: int) -> bool:\n        \"\"\"Checks if a number is prime using optimized trial division with memoization.\"\"\"\n        if num in self._memo:\n            return self._memo[num]\n\n        if num < 0:\n            raise ValueError(\"Primality is defined for non-negative integers. Input must be non-negative.\")\n        if num < 2:\n            result = False\n        elif num == 2:\n            result = True\n        elif num % 2 == 0:\n            result = False\n        else:\n            isqrt_num = math.isqrt(num)\n            result = True\n            for i in range(3, isqrt_num + 1, 2):\n                if num % i == 0:\n                    result = False\n                    break\n        self._memo[num] = result\n        return result\nclass PrimeFibFinder:\n    def __init__(self, fib_generator: FibonacciGenerator, prime_checker: PrimeChecker):\n        self._fib_generator = fib_generator\n        self._prime_checker = prime_checker\n\n    def find_nth_prime_fib(self, n: int) -> int:\n        \"\"\"Finds the Nth number that is both a Fibonacci number and a prime number.\"\"\"\n        if n < 1:\n            raise ValueError(\"n must be a positive integer (1-based index).\")\n\n        prime_fib_count = 0\n        fib_sequence = self._fib_generator.generate()\n\n        next(fib_sequence) # F(0) = 0\n        next(fib_sequence) # F(1) = 1\n\n        while True:\n            current_fib = next(fib_sequence)\n            if current_fib < 2:\n                continue\n\n            if self._prime_checker.is_prime(current_fib):\n                prime_fib_count += 1\n                if prime_fib_count == n:\n                    return current_fib\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    fib_generator = FibonacciGenerator()\n    prime_checker = PrimeChecker()\n    finder = PrimeFibFinder(fib_generator, prime_checker)\n    return finder.find_nth_prime_fib(n)"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n\n    >>> triples_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> triples_sum_to_zero([1, 3, -2, 1])\n    True\n    >>> triples_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> triples_sum_to_zero([2, 4, -5, 3, 9, 7])\n    True\n    >>> triples_sum_to_zero([1])\n    False\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    l_sorted = sorted(l) # Sort the list to use the two-pointer technique.\n\n    for i in range(n - 2):\n        # Skip duplicate elements for the first pointer to avoid duplicate triples\n        if i > 0 and l_sorted[i] == l_sorted[i-1]:\n            continue\n\n        left, right = i + 1, n - 1\n        while left < right:\n            current_sum = l_sorted[i] + l_sorted[left] + l_sorted[right]\n\n            if current_sum == 0:\n                return True\n            elif current_sum < 0:\n                left += 1\n            else: # current_sum > 0\n                right -= 1\n    return False"}
{"task_id": "HumanEval/40", "solution": "import itertools\ndef triples_sum_to_zero(l: list[int]) -> bool:\n    \"\"\"\n    Checks if there are three distinct elements in the list that sum to zero.\n    Returns True if such a triple exists, False otherwise.\n    \"\"\"\n    if len(l) < 3:\n        return False\n\n    # Iterate through all unique combinations of three distinct indices.\n    for i, j, k in itertools.combinations(range(len(l)), 3):\n        if l[i] + l[j] + l[k] == 0:\n            return True\n    return False"}
