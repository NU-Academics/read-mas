{"task_id": "HumanEval/75", "solution": "from typing import List\nMAX_NUMBER_TO_CHECK = 99\nNUM_PRIME_FACTORS_REQUIRED = 3\nclass PrimeUtils:\n    \"\"\"\n    Provides static utility methods for prime number generation.\n    Generates primes using the Sieve of Eratosthenes algorithm.\n    \"\"\"\n    @staticmethod\n    def generate_primes_sieve(limit: int) -> List[int]:\n        \"\"\"\n        Generates a list of prime numbers up to and including the limit.\n        Returns an empty list if the limit is less than 2.\n        \"\"\"\n        if limit < 2:\n            return []\n        sieve = [True] * (limit + 1)\n        sieve[0] = sieve[1] = False\n        for start in range(2, int(limit**0.5) + 1):\n            if sieve[start]:\n                for multiple in range(start * start, limit + 1, start):\n                    sieve[multiple] = False\n        return [i for i, is_prime in enumerate(sieve) if is_prime]\nclass PrimeFactorizer:\n    \"\"\"\n    Decomposes a given integer into its prime factors, including multiplicity.\n    Initializes with a pre-computed list of prime numbers.\n    \"\"\"\n    def __init__(self, primes: List[int]):\n        \"\"\"Initializes the factorizer with a list of primes.\"\"\"\n        self._primes = primes\n\n    def get_prime_factors(self, n: int) -> List[int]:\n        \"\"\"\n        Returns a list of prime factors for n, including multiplicity.\n        Raises ValueError if n is not a positive integer.\n        \"\"\"\n        if not isinstance(n, int) or n <= 0:\n            raise ValueError(\"Input must be a positive integer.\")\n        \n        factors = []\n        temp_n = n\n        for p in self._primes:\n            # Optimization: if p is greater than sqrt(temp_n), remaining temp_n must be prime.\n            if p * p > temp_n:\n                break\n            while temp_n % p == 0:\n                factors.append(p)\n                temp_n //= p\n        # If temp_n is still greater than 1, it's a prime factor itself.\n        if temp_n > 1:\n            factors.append(temp_n)\n        return factors\nclass MultiplyPrimeChecker:\n    \"\"\"\n    Implements the core logic to determine if a number is the product of exactly three prime numbers.\n    It uses an injected PrimeFactorizer instance for factorization.\n    \"\"\"\n    def __init__(self, factorizer: PrimeFactorizer):\n        \"\"\"Initializes the checker with a PrimeFactorizer instance.\"\"\"\n        self._factorizer = factorizer\n\n    def is_multiply_prime_internal(self, a: int) -> bool:\n        \"\"\"\n        Checks if 'a' is the product of exactly three prime numbers.\n        Raises ValueError if 'a' is not an integer or outside the valid range.\n        \"\"\"\n        if not isinstance(a, int) or not (0 < a <= MAX_NUMBER_TO_CHECK):\n            raise ValueError(f\"Input 'a' must be an integer between 1 and {MAX_NUMBER_TO_CHECK} (inclusive).\")\n\n        prime_factors = self._factorizer.get_prime_factors(a)\n        return len(prime_factors) == NUM_PRIME_FACTORS_REQUIRED\n_precomputed_primes: List[int] = []\n_prime_factorizer_instance: PrimeFactorizer = None\ndef is_multiply_prime(a: int) -> bool:\n    \"\"\"\n    Returns true if the given number 'a' is the product of exactly three prime numbers, and false otherwise.\n    Input 'a' must be an integer between 1 and 99 (inclusive).\n    \"\"\"\n    global _precomputed_primes, _prime_factorizer_instance\n    # Lazily initialize prime numbers and factorizer instance only once.\n    if not _precomputed_primes:\n        _precomputed_primes = PrimeUtils.generate_primes_sieve(MAX_NUMBER_TO_CHECK)\n        _prime_factorizer_instance = PrimeFactorizer(_precomputed_primes)\n\n    checker = MultiplyPrimeChecker(_prime_factorizer_instance)\n    return checker.is_multiply_prime_internal(a)"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Checks if a number is the product of exactly three distinct prime numbers.\n    The number 'a' must be an integer between 1 and 99, inclusive.\n    \"\"\"\n    if not isinstance(a, int):\n        raise TypeError(\"Input 'a' must be an integer.\")\n    if not (0 < a < 100):\n        raise ValueError(\"Input 'a' must be an integer between 1 and 99 (inclusive).\")\n\n    def _get_distinct_prime_factors(num: int) -> list[int]:\n        \"\"\"Returns a sorted list of distinct prime factors for a given number.\"\"\"\n        if num < 2:\n            return []\n\n        factors = set()\n        d = 2\n        temp_num = num\n        while d * d <= temp_num:\n            if temp_num % d == 0:\n                factors.add(d)\n                while temp_num % d == 0:\n                    temp_num //= d\n            d += 1\n        if temp_num > 1:\n            factors.add(temp_num)\n        return sorted(list(factors))\n\n    prime_factors = _get_distinct_prime_factors(a)\n    return len(prime_factors) == 3"}
{"task_id": "HumanEval/75", "solution": "def _get_prime_factors(n: int) -> list[int]:\n    \"\"\"\n    Computes all prime factors of a given integer n, including multiplicity.\n    Example: get_prime_factors(12) returns [2, 2, 3].\n    \"\"\"\n    factors = []\n    d = 2\n    num = n\n    while d * d <= num:\n        while num % d == 0:\n            factors.append(d)\n            num //= d\n        d += 1\n    if num > 1:\n        factors.append(num)\n    return factors\ndef is_multiply_prime(a: int) -> bool:\n    \"\"\"\n    Returns true if the given number `a` (less than 100) is the\n    multiplication of exactly 3 prime numbers, and false otherwise.\n    \"\"\"\n    if not (0 < a < 100):\n        return False\n\n    factors = _get_prime_factors(a)\n    return len(factors) == 3"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100. \n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n    factors = []\n    d = 2\n    temp_a = a\n    while d * d <= temp_a:\n        while temp_a % d == 0:\n            factors.append(d)\n            temp_a //= d\n        d += 1\n    if temp_a > 1:\n        factors.append(temp_a)\n\n    return len(factors) == 3"}
{"task_id": "HumanEval/75", "solution": "from typing import List\ndef _get_prime_factors(n: int) -> List[int]:\n    \"\"\"\n    Computes all prime factors of a given integer n, including multiplicity.\n    For example, _get_prime_factors(12) returns [2, 2, 3].\n    \"\"\"\n    factors = []\n    d = 2\n    temp_n = n\n    while d * d <= temp_n:\n        while temp_n % d == 0:\n            factors.append(d)\n            temp_n //= d\n        d += 1\n    if temp_n > 1:\n        factors.append(temp_n)\n    return factors\ndef is_multiply_prime(a):\n    \"\"\"\n    Checks if the given number 'a' is the product of exactly three prime numbers.\n    The input 'a' is constrained to be an integer such that 0 < a < 100.\n    \"\"\"\n    MAX_INPUT_VALUE = 100 # Upper bound for input 'a' as per specification\n\n    # Input validation: 'a' must be an integer, 0 < a < 100.\n    if not isinstance(a, int) or a <= 0 or a >= MAX_INPUT_VALUE:\n        return False\n\n    # Factorize the number and check the count of prime factors.\n    factors = _get_prime_factors(a)\n    return len(factors) == 3"}
{"task_id": "HumanEval/75", "solution": "import math\ndef get_prime_factors(n: int) -> list[int]:\n    \"\"\"Finds all prime factors of n, including multiplicity.\n    Returns an empty list for n < 2.\"\"\"\n    factors = []\n    if n < 2:\n        return factors\n\n    # Count the number of 2s that divide n\n    while n % 2 == 0:\n        factors.append(2)\n        n //= 2\n\n    # n must be odd at this point, so a skip of 2 (i = i + 2) can be used\n    # Iterate from 3 up to sqrt(n)\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        while n % i == 0:\n            factors.append(i)\n            n //= i\n\n    # If n is a prime number greater than 2\n    if n > 2:\n        factors.append(n)\n    return factors\ndef is_multiply_prime(a: int) -> bool:\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100.\n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n    if not isinstance(a, int):\n        return False\n    if a <= 0: # Numbers like 0 or 1 cannot be products of three primes.\n        return False\n\n    factors = get_prime_factors(a)\n    return len(factors) == 3"}
