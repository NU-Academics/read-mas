{"task_id": "HumanEval/47", "solution": "def median(l: list) -> float:\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3.0\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    if not l:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    if n % 2 == 1:\n        return float(sorted_l[n // 2])\n    else:\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        return (float(mid1) + float(mid2)) / 2.0"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    Raises ValueError if the input list is empty.\n    \"\"\"\n    if not l:\n        raise ValueError(\"Input list cannot be empty\")\n\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    if n % 2 == 1:\n        # Odd number of elements: median is the middle element.\n        return float(sorted_l[n // 2])\n    else:\n        # Even number of elements: median is the average of the two middle elements.\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        return (float(mid1) + float(mid2)) / 2.0"}
{"task_id": "HumanEval/47", "solution": "from typing import Union\nclass EmptyListError(ValueError):\n    \"\"\"Exception raised when an input list is empty.\n    Inherits from ValueError.\"\"\"\n    def __init__(self, message: str = \"Input list cannot be empty.\"):\n        super().__init__(message)\nclass InvalidInputError(ValueError):\n    \"\"\"Exception raised when an input list contains non-numeric elements.\n    Inherits from ValueError.\"\"\"\n    def __init__(self, message: str = \"List must contain only numbers (int or float).\"):\n        super().__init__(message)\ndef median(l: list) -> Union[int, float]:\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    if not l:\n        raise EmptyListError()\n\n    for item in l:\n        if not isinstance(item, (int, float)):\n            raise InvalidInputError()\n\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    if n % 2 == 1:\n        # For odd number of elements, the median is the middle element.\n        return sorted_l[n // 2]\n    else:\n        # For even number of elements, the median is the average of the two middle elements.\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        return (mid1 + mid2) / 2.0"}
