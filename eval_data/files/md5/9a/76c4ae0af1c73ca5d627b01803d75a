{"task_id": "HumanEval/112", "solution": "class InvalidInputError(TypeError):\n    \"\"\"Custom exception for invalid input types.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\nclass StringManipulator:\n    \"\"\"Handles deletion of characters from a source string.\"\"\"\n    def delete_chars(self, source: str, chars_to_delete: str) -> str:\n        \"\"\"Returns a new string with all characters present in chars_to_delete removed from source.\"\"\"\n        if not isinstance(source, str) or not isinstance(chars_to_delete, str):\n            raise InvalidInputError(\"Inputs 'source' and 'chars_to_delete' must be strings.\")\n        \n        chars_set = set(chars_to_delete)\n        return \"\".join(char for char in source if char not in chars_set)\nclass PalindromeChecker:\n    \"\"\"Determines if a given string is a palindrome.\"\"\"\n    def is_palindrome(self, text: str) -> bool:\n        \"\"\"Checks if the input text reads the same forwards and backwards.\"\"\"\n        if not isinstance(text, str):\n            raise InvalidInputError(\"Input 'text' must be a string.\")\n            \n        return text == text[::-1]\nclass StringProcessorService:\n    \"\"\"Orchestrates character deletion and palindrome checking.\"\"\"\n    def __init__(self, manipulator: StringManipulator, checker: PalindromeChecker):\n        \"\"\"Initializes the service with dependencies for string manipulation and palindrome checking.\"\"\"\n        self._manipulator = manipulator\n        self._checker = checker\n\n    def process_and_check(self, s: str, c: str) -> tuple[str, bool]:\n        \"\"\"Deletes characters from s that are in c, then checks if the result is a palindrome.\"\"\"\n        try:\n            modified_s = self._manipulator.delete_chars(s, c)\n            is_palindrome_status = self._checker.is_palindrome(modified_s)\n            return (modified_s, is_palindrome_status)\n        except InvalidInputError as e:\n            raise e\ndef reverse_delete(s: str, c: str) -> tuple[str, bool]:\n    \"\"\"\n    Deletes characters from s found in c, then checks if the resulting string is a palindrome.\n    It returns the modified string and its palindrome status, raising InvalidInputError for non-string inputs.\n    \"\"\"\n    try:\n        manipulator = StringManipulator()\n        checker = PalindromeChecker()\n        service = StringProcessorService(manipulator, checker)\n        return service.process_and_check(s, c)\n    except InvalidInputError as e:\n        raise e"}
{"task_id": "HumanEval/112", "solution": "def reverse_delete(s, c):\n    \"\"\"Deletes characters from 's' that are present in 'c' and checks if the result is a palindrome.\n    Returns a tuple containing the modified string and a boolean indicating if it's a palindrome.\n    \"\"\"\n    if not isinstance(s, str) or not isinstance(c, str):\n        raise TypeError(\"Inputs 's' and 'c' must be strings.\")\n\n    chars_to_remove_set = set(c)\n    modified_s_chars = []\n    for char_s in s:\n        if char_s not in chars_to_remove_set:\n            modified_s_chars.append(char_s)\n    modified_s = \"\".join(modified_s_chars)\n\n    is_palindrome = (modified_s == modified_s[::-1])\n\n    return (modified_s, is_palindrome)"}
{"task_id": "HumanEval/112", "solution": "def reverse_delete(s,c):\n    \"\"\"Task\n    We are given two strings s and c, you have to deleted all the characters in s that are equal to any character in c\n    then check if the result string is palindrome.\n    A string is called palindrome if it reads the same backward as forward.\n    You should return a tuple containing the result string and True/False for the check.\n    Example\n    For s = \"abcde\", c = \"ae\", the result should be ('bcd',False)\n    For s = \"abcdef\", c = \"b\"  the result should be ('acdef',False)\n    For s = \"abcdedcba\", c = \"ab\", the result should be ('cdedc',True)\n    \"\"\"\n    chars_to_remove_set = set(c)\n    \n    modified_s_list = []\n    for char_s in s:\n        if char_s not in chars_to_remove_set:\n            modified_s_list.append(char_s)\n            \n    modified_s = \"\".join(modified_s_list)\n    \n    is_palindrome = (modified_s == modified_s[::-1])\n    \n    return modified_s, is_palindrome"}
{"task_id": "HumanEval/112", "solution": "def reverse_delete(s, c):\n    \"\"\"\n    Deletes characters from string 's' that are present in string 'c',\n    then checks if the resulting string is a palindrome.\n    The check is case-sensitive.\n    \"\"\"\n    if not isinstance(s, str) or not isinstance(c, str):\n        raise TypeError(\"Inputs 's' and 'c' must be strings.\")\n\n    chars_to_delete = set(c)\n    result_chars = []\n    for char_s in s:\n        if char_s not in chars_to_delete:\n            result_chars.append(char_s)\n\n    result_string = \"\".join(result_chars)\n    is_palindrome = result_string == result_string[::-1]\n\n    return (result_string, is_palindrome)"}
