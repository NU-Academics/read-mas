{"task_id": "HumanEval/96", "solution": "from typing import List\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    pass\ndef _sieve_of_eratosthenes(limit: int) -> List[bool]:\n    \"\"\"Implements the Sieve of Eratosthenes algorithm to find primes up to limit-1.\n    Returns a boolean list where `is_prime[i]` is True if `i` is prime.\"\"\"\n    is_prime = [True] * limit\n    if limit > 0:\n        is_prime[0] = False\n    if limit > 1:\n        is_prime[1] = False\n\n    for p in range(2, int(limit**0.5) + 1):\n        if is_prime[p]:\n            for multiple in range(p * p, limit, p):\n                is_prime[multiple] = False\n    return is_prime\ndef count_up_to(n):\n    \"\"\"Implement a function that takes an non-negative integer and returns an array of the first n\n    integers that are prime numbers and less than n.\n    for example:\n    count_up_to(5) => [2,3]\n    count_up_to(11) => [2,3,5,7]\n    count_up_to(0) => []\n    count_up_to(20) => [2,3,5,7,11,13,17,19]\n    count_up_to(1) => []\n    count_up_to(18) => [2,3,5,7,11,13,17]\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise InvalidInputError(\"Input 'n' must be a non-negative integer.\")\n\n    if n <= 2:\n        return []\n\n    is_prime_sieve = _sieve_of_eratosthenes(n)\n    primes = [i for i, is_p in enumerate(is_prime_sieve) if is_p]\n    return primes"}
{"task_id": "HumanEval/96", "solution": "def count_up_to(n):\n    \"\"\"\n    Finds all prime numbers strictly less than n using the Sieve of Eratosthenes.\n    Raises TypeError if n is not an integer, ValueError if n is negative.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(f\"Input must be an integer, but got {type(n).__name__}\")\n    if n < 0:\n        raise ValueError(f\"Input must be a non-negative integer, but got {n}\")\n\n    # For n less than or equal to 2, there are no primes strictly less than n.\n    if n <= 2:\n        return []\n\n    # Initialize a boolean list for the Sieve of Eratosthenes.\n    is_prime = [True] * n\n    is_prime[0] = is_prime[1] = False  # 0 and 1 are not prime numbers.\n\n    # Iterate from 2 up to the square root of n.\n    for p in range(2, int(n**0.5) + 1):\n        if is_prime[p]:\n            # Mark all multiples of p as not prime, starting from p*p.\n            for multiple in range(p * p, n, p):\n                is_prime[multiple] = False\n\n    # Collect numbers where the corresponding flag in is_prime is True.\n    primes = [i for i, prime_flag in enumerate(is_prime) if prime_flag]\n    return primes"}
{"task_id": "HumanEval/96", "solution": "import math\ndef _is_prime(num: int) -> bool:\n    \"\"\"\n    Checks if a given number is prime using trial division.\n    It handles special cases for numbers less than 2 and even numbers efficiently.\n    \"\"\"\n    if num < 2:\n        return False\n    if num == 2:\n        return True\n    if num % 2 == 0:\n        return False\n    for i in range(3, int(math.sqrt(num)) + 1, 2):\n        if num % i == 0:\n            return False\n    return True\ndef count_up_to(n: int) -> list[int]:\n    \"\"\"\n    Generates a list of all prime numbers strictly less than n.\n    It returns an empty list if n is 0, 1, 2, or any negative integer.\n    \"\"\"\n    primes = []\n    for i in range(2, n):\n        if _is_prime(i):\n            primes.append(i)\n    return primes"}
{"task_id": "HumanEval/96", "solution": "import math\ndef count_up_to(n: int) -> list[int]:\n    \"\"\"\n    Returns a list of prime numbers strictly less than n.\n    Validates input and uses a helper to check primality for each number.\n    \"\"\"\n    def _is_prime(num: int) -> bool:\n        \"\"\"\n        Checks if a number is prime.\n        It optimizes by checking divisibility only up to the square root of the number.\n        \"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(num)) + 1, 2):\n            if num % i == 0:\n                return False\n        return True\n\n    if not isinstance(n, int):\n        raise ValueError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    if n <= 2:\n        return []\n\n    primes = []\n    for i in range(2, n):\n        if _is_prime(i):\n            primes.append(i)\n    return primes"}
{"task_id": "HumanEval/96", "solution": "import math\ndef _is_prime(num: int) -> bool:\n    \"\"\"Checks if a number is prime. It optimizes by checking divisibility up to its square root.\"\"\"\n    if num < 2:\n        return False\n    if num == 2:\n        return True\n    if num % 2 == 0:\n        return False\n    # Only check odd divisors up to the square root of num.\n    for i in range(3, int(math.sqrt(num)) + 1, 2):\n        if num % i == 0:\n            return False\n    return True\ndef count_up_to(n: int) -> list[int]:\n    \"\"\"\n    Returns a list of all prime numbers strictly less than n.\n    Raises ValueError if n is not a non-negative integer.\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    primes = []\n    if n <= 2:\n        return primes\n\n    for num in range(2, n):\n        if _is_prime(num):\n            primes.append(num)\n    return primes"}
{"task_id": "HumanEval/96", "solution": "import math\nfrom typing import List\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input values.\"\"\"\n    pass\ndef _is_prime(num: int) -> bool:\n    \"\"\"Helper function to check if a number is prime.\n    It efficiently tests divisibility up to its square root.\"\"\"\n    if num < 2:\n        return False\n    if num == 2:\n        return True\n    if num % 2 == 0:\n        return False\n    # Check for divisors from 3 up to sqrt(num), only odd numbers.\n    for i in range(3, int(math.sqrt(num)) + 1, 2):\n        if num % i == 0:\n            return False\n    return True\ndef count_up_to(n: int) -> List[int]:\n    \"\"\"Returns a list of all prime numbers strictly less than n.\n    Handles input validation and prime number generation.\"\"\"\n    if n < 0:\n        # Raises a custom exception for negative input values.\n        raise InvalidInputError(\"Input 'n' must be a non-negative integer.\")\n    if n <= 2:\n        return []\n\n    primes = []\n    # Iterates through numbers from 2 up to n-1.\n    for i in range(2, n):\n        if _is_prime(i):\n            primes.append(i)\n    return primes"}
