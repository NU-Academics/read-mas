{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by swapping case of non-vowel letters and\n    replacing vowels with the letter two places ahead, preserving case.\n    \"\"\"\n    LOWERCASE_VOWELS = {'a', 'e', 'i', 'o', 'u'}\n    UPPERCASE_VOWELS = {'A', 'E', 'I', 'O', 'U'}\n    LOWERCASE_ALPHABET = \"abcdefghijklmnopqrstuvwxyz\"\n    UPPERCASE_ALPHABET = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"\n\n    def is_vowel(char: str) -> bool:\n        \"\"\"Checks if a character is an English alphabet vowel (case-insensitive).\"\"\"\n        return char in LOWERCASE_VOWELS or char in UPPERCASE_VOWELS\n\n    def get_char_two_ahead(char: str) -> str:\n        \"\"\"\n        Returns the character two positions ahead in the English alphabet,\n        preserving the original case.\n        \"\"\"\n        if char.islower():\n            idx = LOWERCASE_ALPHABET.index(char)\n            return LOWERCASE_ALPHABET[idx + 2]\n        elif char.isupper():\n            idx = UPPERCASE_ALPHABET.index(char)\n            return UPPERCASE_ALPHABET[idx + 2]\n        return char\n\n    encoded_chars = []\n    for char in message:\n        if char.isalpha():\n            if is_vowel(char):\n                encoded_chars.append(get_char_two_ahead(char))\n            else:\n                encoded_chars.append(char.swapcase())\n        else:\n            encoded_chars.append(char)\n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/93", "solution": "_VOWEL_MAP_LOWER = {'a': 'c', 'e': 'g', 'i': 'k', 'o': 'q', 'u': 'w'}\n_VOWEL_MAP_UPPER = {'A': 'C', 'E': 'G', 'I': 'K', 'O': 'Q', 'U': 'W'}\n_VOWELS_LOWER_SET = set(_VOWEL_MAP_LOWER.keys())\n_VOWELS_UPPER_SET = set(_VOWEL_MAP_UPPER.keys())\ndef encode(message):\n    \"\"\"Encodes a message by swapping letter cases and replacing vowels. Non-alphabetic characters are preserved.\"\"\"\n    encoded_chars = []\n    for char in message:\n        if char.isalpha():\n            transformed_char = char\n            # Apply vowel replacement first, if the character is a vowel.\n            # The replacement preserves the original case of the vowel.\n            if char in _VOWELS_LOWER_SET:\n                transformed_char = _VOWEL_MAP_LOWER[char]\n            elif char in _VOWELS_UPPER_SET:\n                transformed_char = _VOWEL_MAP_UPPER[char]\n            \n            # Then, swap the case of the (potentially replaced) alphabetic character.\n            encoded_chars.append(transformed_char.swapcase())\n        else:\n            # Preserve non-alphabetic characters.\n            encoded_chars.append(char)\n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Write a function that takes a message, and encodes in such a \n    way that it swaps case of all letters, replaces all vowels in \n    the message with the letter that appears 2 places ahead of that \n    vowel in the english alphabet. \n    Assume only letters. \n    \"\"\"\n    encoded_chars = []\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    for char in message:\n        processed_char = char\n\n        if char.isalpha() and char.lower() in VOWELS:\n            start_ord = ord('a') if char.islower() else ord('A')\n            shifted_ord = (ord(char) - start_ord + 2) % 26 + start_ord\n            processed_char = chr(shifted_ord)\n        \n        processed_char = processed_char.swapcase()\n        \n        encoded_chars.append(processed_char)\n    \n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"Encodes a message by swapping case of letters and shifting vowels.\n    Non-alphabetic characters are preserved.\"\"\"\n\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n    ALPHABET_LOWER = 'abcdefghijklmnopqrstuvwxyz'\n    ALPHABET_UPPER = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'\n\n    def _is_vowel(char: str) -> bool:\n        \"\"\"Checks if a character is a vowel (case-insensitive).\"\"\"\n        return char.lower() in VOWELS\n\n    def _get_shifted_char(char: str) -> str:\n        \"\"\"Returns the character two places ahead in the alphabet, preserving case.\n        Assumes the input char is an alphabetic vowel.\"\"\"\n        if char.islower():\n            idx = ALPHABET_LOWER.index(char)\n            return ALPHABET_LOWER[(idx + 2) % len(ALPHABET_LOWER)]\n        else: # isupper\n            idx = ALPHABET_UPPER.index(char)\n            return ALPHABET_UPPER[(idx + 2) % len(ALPHABET_UPPER)]\n\n    encoded_chars = []\n    for char in message:\n        if not char.isalpha():\n            encoded_chars.append(char)\n        else:\n            if _is_vowel(char):\n                encoded_chars.append(_get_shifted_char(char))\n            else:\n                encoded_chars.append(char.swapcase())\n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Write a function that takes a message, and encodes in such a\n    way that it swaps case of all letters, replaces all vowels in\n    the message with the letter that appears 2 places ahead of that\n    vowel in the english alphabet.\n    Assume only letters.\n\n    Examples:\n    >>> encode('test')\n    'TGST'\n    >>> encode('This is a message')\n    'tHKS KS C MGSSCGG'\n    \"\"\"\n    if not isinstance(message, str):\n        raise TypeError(\"Input 'message' must be a string.\")\n\n    VOWELS = \"aeiou\"\n    ALPHABET_LOWER = \"abcdefghijklmnopqrstuvwxyz\"\n\n    encoded_chars = []\n    for char in message:\n        # Check if the character is an English alphabet letter\n        if not ('a' <= char.lower() <= 'z'):\n            encoded_chars.append(char)\n            continue\n\n        is_original_upper = char.isupper()\n        processed_char_val = char\n\n        # Determine if the original character (case-insensitive) is a vowel\n        is_vowel = char.lower() in VOWELS\n\n        if is_vowel:\n            lower_char = char.lower()\n            # Find its index in the lowercase alphabet\n            index = ALPHABET_LOWER.find(lower_char)\n            # Shift two places forward in the alphabet\n            shifted_char = ALPHABET_LOWER[index + 2]\n            processed_char_val = shifted_char\n\n        # Apply final case swap based on the original character's case\n        if is_original_upper:\n            final_char = processed_char_val.lower()\n        else:\n            final_char = processed_char_val.upper()\n\n        encoded_chars.append(final_char)\n\n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/93", "solution": "_VOWEL_REPLACEMENT_MAP = {\n    'a': 'c', 'e': 'g', 'i': 'k', 'o': 'q', 'u': 'w'\n}\ndef encode(message):\n    \"\"\"\n    Encodes a message by swapping letter cases and replacing vowels with the letter two places ahead.\n    Non-alphabetic characters are preserved without modification.\n    \"\"\"\n    encoded_chars = []\n    for char in message:\n        if not char.isalpha():\n            encoded_chars.append(char)\n            continue\n\n        processed_char = char\n        lower_char = char.lower()\n        if lower_char in _VOWEL_REPLACEMENT_MAP:\n            new_char_lower = _VOWEL_REPLACEMENT_MAP[lower_char]\n            processed_char = new_char_lower.upper() if char.isupper() else new_char_lower\n        \n        final_char = processed_char.swapcase()\n\n        encoded_chars.append(final_char)\n\n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/93", "solution": "VOWELS_LOWER = \"aeiou\"\nVOWELS_UPPER = \"AEIOU\"\nALPHABET_LOWER = \"abcdefghijklmnopqrstuvwxyz\"\nALPHABET_UPPER = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"\ndef _is_vowel(char: str) -> bool:\n    \"\"\"Checks if a character is an English vowel (case-insensitive).\"\"\"\n    return char in VOWELS_LOWER or char in VOWELS_UPPER\ndef _get_char_two_ahead(char: str) -> str:\n    \"\"\"Returns the character two positions ahead in the English alphabet, preserving case and wrapping around.\"\"\"\n    if char.islower():\n        idx = ALPHABET_LOWER.find(char)\n        if idx != -1:\n            return ALPHABET_LOWER[(idx + 2) % len(ALPHABET_LOWER)]\n    elif char.isupper():\n        idx = ALPHABET_UPPER.find(char)\n        if idx != -1:\n            return ALPHABET_UPPER[(idx + 2) % len(ALPHABET_UPPER)]\n    return char # Returns original char if not an alphabetic character.\ndef encode(message: str) -> str:\n    \"\"\"\n    Encodes a message by swapping the case of all letters and replacing vowels.\n    Vowels are replaced by the letter two places ahead in the alphabet,\n    then the case of this replacement is swapped.\n    \"\"\"\n    encoded_chars = []\n    for char in message:\n        if not char.isalpha():\n            encoded_chars.append(char)\n            continue\n\n        if _is_vowel(char):\n            # If it's a vowel, get the 2-ahead char (preserving its original case), then swap its case.\n            shifted_char = _get_char_two_ahead(char)\n            encoded_chars.append(shifted_char.swapcase())\n        else:\n            # If it's a consonant, just swap its case.\n            encoded_chars.append(char.swapcase())\n            \n    return \"\".join(encoded_chars)"}
