{"task_id": "HumanEval/4", "solution": "from typing import List\nclass StatisticsError(Exception):\n    \"\"\"Custom exception for errors in statistical calculations.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nERROR_EMPTY_LIST = \"Input list cannot be empty for this calculation.\"\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    if not numbers:\n        raise StatisticsError(ERROR_EMPTY_LIST)\n\n    # Calculate the arithmetic mean of the numbers.\n    mean_val = sum(numbers) / len(numbers)\n\n    # Calculate absolute differences between each number and the mean.\n    absolute_differences = [abs(x - mean_val) for x in numbers]\n\n    # Calculate the mean of these absolute differences.\n    mad = sum(absolute_differences) / len(absolute_differences)\n\n    return mad"}
{"task_id": "HumanEval/4", "solution": "from typing import List\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\"For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset. MAD is the average absolute difference between each element and the mean.\n    \"\"\"\n    if not numbers:\n        return 0.0\n\n    # Calculate the arithmetic mean of the input numbers.\n    x_mean = sum(numbers) / len(numbers)\n\n    # Sum all the absolute differences from the mean.\n    sum_absolute_differences = sum(abs(x - x_mean) for x in numbers)\n\n    # Divide the sum of absolute differences by the count of numbers.\n    return sum_absolute_differences / len(numbers)"}
{"task_id": "HumanEval/4", "solution": "from typing import List\nclass EmptyInputError(Exception):\n    \"\"\"\n    Custom exception for empty input lists.\n    It provides a descriptive error message.\n    \"\"\"\n    def __init__(self, message: str = \"Input list cannot be empty.\"):\n        super().__init__(message)\n        self.message = message\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\"\n    Calculates the Mean Absolute Deviation (MAD) for a list of numbers.\n    This measures the average variability around the mean.\n    \"\"\"\n    if not numbers:\n        raise EmptyInputError(\"Input list for MAD calculation cannot be empty.\")\n\n    # Calculate the arithmetic mean of the numbers.\n    mean = sum(numbers) / len(numbers)\n\n    # For each number, calculate the absolute difference between it and the mean.\n    absolute_differences = [abs(x - mean) for x in numbers]\n\n    # Calculate the average of these absolute differences.\n    mad_value = sum(absolute_differences) / len(numbers)\n\n    return mad_value"}
{"task_id": "HumanEval/5", "solution": "from typing import List\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers`.\n    This function creates a new list without modifying the original.\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/4", "solution": "from typing import List\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input data.\n    Raised when an empty list is provided where data is expected.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef _calculate_mean_internal(numbers_list: List[float]) -> float:\n    \"\"\"Calculates the arithmetic mean of a list of numbers.\n    Raises InvalidInputError if the list is empty.\n    \"\"\"\n    if not numbers_list:\n        raise InvalidInputError(\"Cannot calculate mean of an empty list.\")\n    return sum(numbers_list) / len(numbers_list)\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset. MAD = average | x - x_mean |.\n    \"\"\"\n    if not numbers:\n        raise InvalidInputError(\"Input list for MAD calculation cannot be empty.\")\n\n    mean_value = _calculate_mean_internal(numbers)\n    absolute_differences = [abs(x - mean_value) for x in numbers]\n\n    return _calculate_mean_internal(absolute_differences)"}
{"task_id": "HumanEval/4", "solution": "from typing import List\nclass StatisticsUtils:\n    \"\"\"\n    Provides utility methods for basic statistical calculations.\n    \"\"\"\n    @staticmethod\n    def calculate_mean(numbers: List[float]) -> float:\n        \"\"\"\n        Calculates the arithmetic mean of a list of numbers.\n        Returns 0.0 for an empty list.\n        \"\"\"\n        if not numbers:\n            return 0.0\n        return sum(numbers) / len(numbers)\nclass MeanAbsoluteDeviationCalculator:\n    \"\"\"\n    Calculates the Mean Absolute Deviation (MAD) for a list of numbers.\n    \"\"\"\n    def calculate_mad(self, numbers: List[float]) -> float:\n        \"\"\"\n        Calculates the Mean Absolute Deviation around the mean of the dataset.\n        MAD is the average absolute difference between each element and the mean.\n        \"\"\"\n        if not numbers:\n            return 0.0\n\n        mean = StatisticsUtils.calculate_mean(numbers)\n        absolute_differences = [abs(x - mean) for x in numbers]\n        \n        mad = StatisticsUtils.calculate_mean(absolute_differences)\n        return mad\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" \n    For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    \"\"\"\n    calculator = MeanAbsoluteDeviationCalculator()\n    return calculator.calculate_mad(numbers)"}
{"task_id": "HumanEval/5", "solution": "from typing import List\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n\n    interspersed_list: List[int] = []\n    # Build a new list by appending elements and the delimiter between them.\n    for i, num in enumerate(numbers):\n        interspersed_list.append(num)\n        if i < len(numbers) - 1:\n            interspersed_list.append(delimeter)\n    return interspersed_list"}
{"task_id": "HumanEval/5", "solution": "from typing import List\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\"Inserts a delimiter between every two consecutive elements of a list of numbers.\n    Raises ValueError for invalid input types as per specification.\n    \"\"\"\n    # Validate input types as per FR1 Error Handling and IntersperseRequest.validate\n    if not isinstance(numbers, list):\n        raise ValueError(\"Input 'numbers' must be a list.\")\n    if not all(isinstance(n, int) for n in numbers):\n        raise ValueError(\"All elements in 'numbers' must be integers.\")\n    if not isinstance(delimeter, int):\n        raise ValueError(\"Input 'delimeter' must be an integer.\")\n\n    # Core logic from IntersperseService.intersperse (FR1 Main Flow, BR1.2)\n    if not numbers:\n        return []\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        # Append delimiter only if it's not the last element\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/5", "solution": "from typing import List\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\"\n    Inserts a `delimeter` integer between every two consecutive elements of the input `numbers` list.\n    Returns a new list with the `delimeter` interspersed.\n    \"\"\"\n    if not numbers or len(numbers) == 1:\n        return numbers[:]\n\n    result: List[int] = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
