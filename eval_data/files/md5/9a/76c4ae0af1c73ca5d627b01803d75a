{"task_id": "HumanEval/17", "solution": "from typing import List\nNOTE_BEAT_MAP = {\n    'o': 4,   # Whole note\n    'o|': 2,  # Half note\n    '.|': 1   # Quarter note\n}\nclass InvalidNoteError(Exception):\n    \"\"\"Custom exception raised when an invalid musical note format is encountered.\"\"\"\n    def __init__(self, note_str: str, message: str = \"Invalid note format\"):\n        self.note_str = note_str\n        self.message = f\"{message}: '{note_str}'\"\n        super().__init__(self.message)\nclass MusicParser:\n    \"\"\"\n    A utility class for parsing musical notation strings into beat durations.\n    It encapsulates the core logic for interpreting note symbols.\n    \"\"\"\n    @staticmethod\n    def _parse_single_note(note_str: str) -> int:\n        \"\"\"\n        Parses a single note string into its beat duration.\n        Raises InvalidNoteError if the note_str is not recognized.\n        \"\"\"\n        beats = NOTE_BEAT_MAP.get(note_str)\n        if beats is None:\n            raise InvalidNoteError(note_str=note_str)\n        return beats\n\n    @staticmethod\n    def parse(music_string: str) -> List[int]:\n        \"\"\"\n        Parses a string of musical notes into a list of beat durations.\n        Notes are expected to be space-separated.\n        \"\"\"\n        if not music_string.strip():\n            return []\n\n        notes = music_string.split(' ')\n        beat_durations: List[int] = []\n        for note in notes:\n            if note:\n                beat_durations.append(MusicParser._parse_single_note(note))\n        return beat_durations\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\" Input to this function is a string representing musical notes in a special ASCII format.\n    Your task is to parse this string and return list of integers corresponding to how many beats does each\n    not last.\n\n    Here is a legend:\n    'o' - whole note, lasts four beats\n    'o|' - half note, lasts two beats\n    '.|' - quater note, lasts one beat\n\n    >>> parse_music('o o| .| o| o| .| .| .| .| o o')\n    [4, 2, 1, 2, 2, 1, 1, 1, 1, 4, 4]\n    \"\"\"\n    return MusicParser.parse(music_string)"}
