{"task_id": "HumanEval/49", "solution": "class ModpError(Exception):\n    \"\"\"Base exception for modp_calculator module.\"\"\"\n    pass\nclass InvalidInputError(ModpError):\n    \"\"\"Exception raised for invalid input parameters.\"\"\"\n    pass\nclass InputValidator:\n    @staticmethod\n    def validate_n(n: int) -> None:\n        \"\"\"Validates if 'n' is a non-negative integer.\"\"\"\n        if not isinstance(n, int) or n < 0:\n            raise InvalidInputError(\"Exponent 'n' must be a non-negative integer.\")\n\n    @staticmethod\n    def validate_p(p: int) -> None:\n        \"\"\"Validates if 'p' is a positive integer.\"\"\"\n        if not isinstance(p, int) or p <= 0:\n            raise InvalidInputError(\"Modulus 'p' must be a positive integer.\")\ndef modp(n: int, p: int):\n    \"\"\"Return 2^n modulo p (be aware of numerics).\n    >>> modp(3, 5)\n    3\n    >>> modp(1101, 101)\n    2\n    >>> modp(0, 101)\n    1\n    >>> modp(3, 11)\n    8\n    >>> modp(100, 101)\n    1\n    \"\"\"\n    InputValidator.validate_n(n)\n    InputValidator.validate_p(p)\n\n    return pow(2, n, p)"}
{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int):\n    \"\"\"Return 2^n modulo p, handling potentially large n efficiently.\n    Raises ValueError for invalid inputs (n < 0 or p <= 0).\n    \"\"\"\n    if not isinstance(n, int) or not isinstance(p, int):\n        raise ValueError(\"Inputs 'n' and 'p' must be integers.\")\n    if n < 0:\n        raise ValueError(\"Exponent 'n' must be a non-negative integer.\")\n    if p <= 0:\n        raise ValueError(\"Modulus 'p' must be a positive integer.\")\n\n    return pow(2, n, p)"}
{"task_id": "HumanEval/49", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception raised for invalid input parameters.\n    It provides a descriptive error message.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef modp(n: int, p: int) -> int:\n    \"\"\"Return 2^n modulo p (be aware of numerics).\n    >>> modp(3, 5)\n    3\n    >>> modp(1101, 101)\n    2\n    >>> modp(0, 101)\n    1\n    >>> modp(3, 11)\n    8\n    >>> modp(100, 101)\n    1\n    \"\"\"\n\n    if not isinstance(n, int) or n < 0:\n        raise InvalidInputError(\"n must be a non-negative integer.\")\n    if not isinstance(p, int) or p <= 0:\n        raise InvalidInputError(\"p must be a positive integer.\")\n\n    # Python's built-in pow(base, exp, mod) is highly optimized\n    # for modular exponentiation.\n    return pow(2, n, p)"}
{"task_id": "HumanEval/49", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception raised for invalid input parameters.\n    It inherits from ValueError for standard error handling.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef modp(n: int, p: int) -> int:\n    \"\"\"Return 2^n modulo p using modular exponentiation.\n    Raises InvalidInputError if n is negative or p is not positive.\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise InvalidInputError(\"Exponent 'n' must be a non-negative integer.\")\n    if not isinstance(p, int) or p <= 0:\n        raise InvalidInputError(\"Modulus 'p' must be a positive integer.\")\n\n    if n == 0:\n        return 1 % p  # 2^0 = 1\n\n    base = 2\n    result = 1\n    base %= p \n\n    while n > 0:\n        if n % 2 == 1:\n            result = (result * base) % p\n        base = (base * base) % p\n        n //= 2\n    return result"}
{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int):\n    \"\"\"Return 2^n modulo p using exponentiation by squaring.\n    Raises ValueError if n is negative or p is not positive.\n    \"\"\"\n    if p <= 0:\n        raise ValueError(\"Modulus p must be a positive integer.\")\n    if n < 0:\n        raise ValueError(\"Exponent n must be a non-negative integer.\")\n    \n    # Handle the base case 2^0 = 1\n    if n == 0:\n        return 1 % p\n\n    base = 2\n    result = 1\n    base %= p # Reduce base initially\n\n    # Apply exponentiation by squaring\n    while n > 0:\n        if n % 2 == 1:\n            result = (result * base) % p\n        base = (base * base) % p\n        n //= 2\n    \n    return result"}
{"task_id": "HumanEval/50", "solution": "def decode_shift(s: str):\n    \"\"\"\n    Decodes a string previously encoded with a 5-position Caesar shift.\n    Non-alphabetic characters remain unchanged.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n\n    decoded_chars = []\n    SHIFT_AMOUNT = 5\n    ALPHABET_SIZE = 26\n    BASE_CHAR_ORD = ord('a')\n\n    for ch in s:\n        if 'a' <= ch <= 'z':\n            char_code = ord(ch)\n            shifted_ord = ((char_code - BASE_CHAR_ORD - SHIFT_AMOUNT) % ALPHABET_SIZE) + BASE_CHAR_ORD\n            decoded_chars.append(chr(shifted_ord))\n        else:\n            decoded_chars.append(ch)\n    return \"\".join(decoded_chars)"}
