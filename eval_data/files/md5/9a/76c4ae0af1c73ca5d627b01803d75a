{"task_id": "HumanEval/111", "solution": "from collections import Counter\nfrom typing import Dict\ndef histogram(test: str) -> Dict[str, int]:\n    \"\"\"\n    Counts frequencies of space-separated lowercase letters and returns a dictionary\n    of the most frequent letters and their counts.\n    If several letters have the same occurrence, all are included.\n    \"\"\"\n    if not test:\n        return {}\n\n    letters = test.split(' ')\n    valid_letters = [letter for letter in letters if letter]\n    \n    if not valid_letters:\n        return {}\n\n    frequencies = dict(Counter(valid_letters))\n\n    max_count = max(frequencies.values())\n\n    result = {\n        letter: count\n        for letter, count in frequencies.items()\n        if count == max_count\n    }\n    return result"}
{"task_id": "HumanEval/111", "solution": "from typing import Dict\ndef histogram(test: str) -> Dict[str, int]:\n    \"\"\"Given a string representing space-separated lowercase letters, return a dictionary\n    of the letter with the most repetition and containing the corresponding count.\n    If several letters have the same occurrence, return all of them.\n    \"\"\"\n    if not test:\n        parsed_letters = []\n    else:\n        parsed_letters = [\n            char for char in test.split(' ')\n            if char and char.islower() and char.isalpha()\n        ]\n\n    if not parsed_letters:\n        return {}\n\n    frequencies: Dict[str, int] = {}\n    for letter in parsed_letters:\n        frequencies[letter] = frequencies.get(letter, 0) + 1\n\n    max_freq = max(frequencies.values())\n\n    result = {\n        letter: count for letter, count in frequencies.items()\n        if count == max_freq\n    }\n\n    return result"}
