{"task_id": "HumanEval/39", "solution": "from typing import Generator\nclass FibonacciGenerator:\n    \"\"\"Generates an infinite sequence of Fibonacci numbers.\"\"\"\n\n    def generate_sequence(self) -> Generator[int, None, None]:\n        \"\"\"\n        Yields Fibonacci numbers starting from 0.\n        Sequence: 0, 1, 1, 2, 3, 5, 8, ...\n        \"\"\"\n        a, b = 0, 1\n        while True:\n            yield a\n            a, b = b, a + b\nclass PrimeChecker:\n    \"\"\"Checks if a given number is prime.\"\"\"\n\n    def is_prime(self, num: int) -> bool:\n        \"\"\"\n        Determines if a number is prime using trial division.\n        \"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\nclass PrimeFibFinder:\n    \"\"\"Finds the n-th number that is both a Fibonacci number and a prime.\"\"\"\n\n    def __init__(self, fib_generator: FibonacciGenerator, prime_checker: PrimeChecker):\n        self._fib_generator = fib_generator\n        self._prime_checker = prime_checker\n\n    def find_nth_prime_fib(self, n: int) -> int:\n        \"\"\"\n        Returns the n-th number that is a Fibonacci number and it's also prime.\n        \"\"\"\n        if n < 1:\n            raise ValueError(\"n must be a positive integer (n >= 1)\")\n\n        prime_fib_count = 0\n        fib_sequence = self._fib_generator.generate_sequence()\n\n        # Skip 0 and 1 as they are not prime based on problem examples.\n        next(fib_sequence) # 0\n        next(fib_sequence) # 1\n        current_fib = next(fib_sequence) # First 1\n\n        while True:\n            # The first '1' is not prime, so we only check numbers > 1.\n            if current_fib > 1 and self._prime_checker.is_prime(current_fib):\n                prime_fib_count += 1\