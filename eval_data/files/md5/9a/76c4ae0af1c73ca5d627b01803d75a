{"task_id": "HumanEval/127", "solution": "import math\nfrom typing import NamedTuple, Optional, Tuple\nclass Interval(NamedTuple):\n    \"\"\"Represents a closed integer interval [start, end].\"\"\"\n    start: int\n    end: int\nclass PrimeChecker:\n    \"\"\"Utility class for checking primality of numbers.\"\"\"\n\n    @staticmethod\n    def is_prime(n: int) -> bool:\n        \"\"\"Determines if a given integer n is a prime number.\n        A prime number is a natural number greater than 1 that has no positive divisors other than 1 and itself.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\nclass IntervalService:\n    \"\"\"Provides business logic for interval operations.\"\"\"\n\n    def calculate_intersection(self, i1: Interval, i2: Interval) -> Optional[Interval]:\n        \"\"\"Calculates the intersection of two closed integer intervals.\n        Returns an Interval object or None if no intersection.\"\"\"\n        intersect_start = max(i1.start, i2.start)\n        intersect_end = min(i1.end, i2.end)\n\n        if intersect_start > intersect_end:\n            return None\n        return Interval(intersect_start, intersect_end)\n\n    def get_length(self, interval: Interval) -> int:\n        \"\"\"Calculates the inclusive length of an interval.\n        Length of (start, end) is end - start + 1.\"\"\"\n        return interval.end - interval.start + 1\ndef intersection(interval1: Tuple[int, int], interval2: Tuple[int, int]) -> str:\n    \"\"\"You are given two intervals,\n    where each interval is a pair of integers. For example, interval = (start, end) = (1, 2).\n    The given intervals are closed which means that the interval (start, end)\n    includes both start and end.\n    For each given interval, it is assumed that its start is less or equal its end.\n    Your task is to determine whether the length of intersection of these two \n    intervals is a prime number.\n    Example, the intersection of the intervals (1, 3), (2, 4) is (2, 3)\n    which its length is 1, which not a prime number.\n    If the length of the intersection is a prime number, return \"YES\",\n    otherwise, return \"NO\".\n    If the two intervals don't intersect, return \"NO\".\n\n\n    [input/output] samples:\n    intersection((1, 2), (2, 3)) ==> \"NO\"\n    intersection((-1, 1), (0, 4)) ==> \"NO\"\n    intersection((-3, -1), (-5, 5)) ==> \"YES\"\n    \"\"\"\n\n    interval_service = IntervalService()\n\n    i1_obj = Interval(interval1[0], interval1[1])\n    i2_obj = Interval(interval2[0], interval2[1])\n\n    intersection_interval = interval_service.calculate_intersection(i1_obj, i2_obj)\n\n    if intersection_interval is None:\n        return \"NO\"\n\n    length = interval_service.get_length(intersection_interval)\n\n    if PrimeChecker.is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/127", "solution": "import math\nfrom typing import Tuple, Optional\nclass Interval:\n    \"\"\"Represents a closed integer interval [start, end].\"\"\"\n    def __init__(self, start: int, end: int):\n        # Validates interval bounds as per the detailed design.\n        if not isinstance(start, int) or not isinstance(end, int):\n            raise TypeError(\"Interval bounds must be integers.\")\n        if start > end:\n            raise ValueError(\"Interval start cannot be greater than end.\")\n        self._start = start\n        self._end = end\n\n    def get_start(self) -> int:\n        \"\"\"Returns the start value of the interval.\"\"\"\n        return self._start\n\n    def get_end(self) -> int:\n        \"\"\"Returns the end value of the interval.\"\"\"\n        return self._end\n\n    def to_tuple(self) -> Tuple[int, int]:\n        \"\"\"Returns the interval as a (start, end) tuple.\"\"\"\n        return (self._start, self._end)\n\n    def __eq__(self, other: object) -> bool:\n        \"\"\"Checks for equality with another Interval object.\"\"\"\n        if not isinstance(other, Interval):\n            return NotImplemented\n        return self._start == other._start and self._end == other._end\n\n    def __repr__(self) -> str:\n        \"\"\"Provides a string representation for the Interval.\"\"\"\n        return f\"Interval({self._start}, {self._end})\"\nclass IntervalService:\n    \"\"\"Provides methods for performing operations on Interval objects.\"\"\"\n    def calculate_intersection(self, interval1: Interval, interval2: Interval) -> Optional[Interval]:\n        \"\"\"Calculates the intersection of two intervals, returning None if they do not intersect.\"\"\"\n        max_start = max(interval1.get_start(), interval2.get_start())\n        min_end = min(interval1.get_end(), interval2.get_end())\n\n        if max_start > min_end:\n            return None\n        return Interval(max_start, min_end)\n\n    def calculate_length(self, interval: Optional[Interval]) -> int:\n        \"\"\"Calculates the length of an interval, or 0 if the interval is None.\"\"\"\n        if interval is None:\n            return 0\n        return interval.get_end() - interval.get_start()\nclass PrimeService:\n    \"\"\"Provides methods for determining if a number is prime.\"\"\"\n    def is_prime(self, n: int) -> bool:\n        \"\"\"Checks if a given non-negative integer n is a prime number using an optimized algorithm.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0: # All other even numbers are not prime.\n            return False\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\ndef intersection(interval1: Tuple[int, int], interval2: Tuple[int, int]) -> str:\n    \"\"\"\n    Determines if the length of the intersection of two closed intervals is a prime number.\n    It orchestrates parsing, intersection calculation, length determination, and primality checking.\n    \"\"\"\n    interval_service = IntervalService()\n    prime_service = PrimeService()\n\n    # Parse input intervals into Interval objects.\n    interval1_obj = Interval(interval1[0], interval1[1])\n    interval2_obj = Interval(interval2[0], interval2[1])\n\n    # Calculate the intersection of the two intervals.\n    intersection_interval = interval_service.calculate_intersection(interval1_obj, interval2_obj)\n\n    # Calculate the length of the intersection interval.\n    length = interval_service.calculate_length(intersection_interval)\n\n    # Determine if the calculated length is a prime number.\n    if prime_service.is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\""}
