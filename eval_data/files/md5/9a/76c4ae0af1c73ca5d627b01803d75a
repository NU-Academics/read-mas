{"task_id": "HumanEval/32", "solution": "import math\nDEFAULT_TOLERANCE = 1e-6\nMAX_ITERATIONS = 100\nINITIAL_SEARCH_LOW = -1000.0\nINITIAL_SEARCH_HIGH = 1000.0\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[2] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero finds x such that poly(x) = 0 using the bisection method.\n    It returns only one zero point and assumes an odd-degree polynomial with a guaranteed real solution.\n    \"\"\"\n    low = INITIAL_SEARCH_LOW\n    high = INITIAL_SEARCH_HIGH\n\n    f_low = poly(xs, low)\n    f_high = poly(xs, high)\n\n    # Check if initial bounds are already close enough to a root.\n    if abs(f_low) < DEFAULT_TOLERANCE:\n        return low\n    if abs(f_high) < DEFAULT_TOLERANCE:\n        return high\n\n    # Apply the bisection method iteratively.\n    for _ in range(MAX_ITERATIONS):\n        mid = (low + high) / 2\n        f_mid = poly(xs, mid)\n\n        if abs(f_mid) < DEFAULT_TOLERANCE:\n            return mid\n\n        # Update interval based on sign change, per the bisection method.\n        if f_low * f_mid < 0:\n            high = mid\n            f_high = f_mid\n        else:\n            low = mid\n            f_low = f_mid\n\n    # Return the midpoint of the final interval as the best approximation if max iterations reached.\n    return (low + high) / 2"}
{"task_id": "HumanEval/32", "solution": "import math\nfrom typing import Callable\nclass PolynomialEvaluator:\n    \"\"\"Utility class for evaluating polynomials.\n    Calculates the value of a polynomial at a given point x.\n    \"\"\"\n    @staticmethod\n    def evaluate(coefficients: list[float], x: float) -> float:\n        \"\"\"Calculates the polynomial's value at point x.\n        coefficients[0] + coefficients[1] * x + coefficients[2] * x^2 + ...\n        \"\"\"\n        return sum([coeff * math.pow(x, i) for i, coeff in enumerate(coefficients)])\nclass BisectionSolver:\n    \"\"\"Implements the bisection method for finding a root of a continuous function.\n    It guarantees convergence within an interval [a, b] where f(a) and f(b) have opposite signs.\n    \"\"\"\n    BISECTION_TOLERANCE = 1e-6\n    BISECTION_MAX_ITERATIONS = 100\n\n    def __init__(self, tolerance: float = BISECTION_TOLERANCE, max_iterations: int = BISECTION_MAX_ITERATIONS):\n        \"\"\"Initializes the bisection solver with specified tolerance and max iterations.\"\"\"\n        self._tolerance = tolerance\n        self._max_iterations = max_iterations\n\n    def find_root(self, func: Callable[[float], float], a: float, b: float) -> float:\n        \"\"\"Finds a root of 'func' within [a, b] using bisection.\n        Assumes func(a) and func(b) have opposite signs, or one endpoint is a root.\n        \"\"\"\n        fa = func(a)\n        fb = func(b)\n\n        if abs(fa) < self._tolerance: # 'a' is already a root\n            return a\n        if abs(fb) < self._tolerance: # 'b' is already a root\n            return b\n\n        if fa * fb > 0:\n            raise ValueError(\"Function values at interval endpoints must have opposite signs.\")\n\n        for _ in range(self._max_iterations):\n            mid = (a + b) / 2\n            f_mid = func(mid)\n\n            if abs(f_mid) < self._tolerance or abs(b - a) / 2 < self._tolerance:\n                return mid\n\n            if fa * f_mid < 0:\n                b = mid\n                fb = f_mid\n            else:\n                a = mid\n                fa = f_mid\n        \n        raise RuntimeError(\"Bisection method did not converge within max iterations.\")\nclass PolynomialRootFinder:\n    \"\"\"Orchestrates finding a zero for a polynomial using a numerical method.\n    It first finds an initial interval and then applies the bisection method.\n    \"\"\"\n    INITIAL_SEARCH_MIN = -100.0\n    INITIAL_SEARCH_MAX = 100.0\n    INITIAL_SEARCH_STEP = 0.1\n\n    def __init__(self, evaluator: PolynomialEvaluator, bisection_solver: BisectionSolver):\n        \"\"\"Initializes the root finder with evaluator and bisection solver instances.\"\"\"\n        self._evaluator = evaluator\n        self._bisection_solver = bisection_solver\n\n    def _find_initial_interval(self, coefficients: list[float]) -> tuple[float, float]:\n        \"\"\"Searches for an interval [a, b] where the polynomial changes sign, or finds a root directly.\n        Iterates within a predefined range with a given step size.\n        \"\"\"\n        search_min = self.INITIAL_SEARCH_MIN\n        search_max = self.INITIAL_SEARCH_MAX\n        step = self.INITIAL_SEARCH_STEP\n        tolerance = self._bisection_solver.BISECTION_TOLERANCE\n\n        # Evaluate at the very start of the search range\n        y_at_min = self._evaluator.evaluate(coefficients, search_min)\n        if abs(y_at_min) < tolerance:\n            # If the starting point is a root, return an interval for bisection.\n            return search_min, search_min + step\n\n        current_x = search_min\n        while current_x < search_max:\n            # Determine the next point to evaluate, ensuring it doesn't overshoot search_max.\n            next_x = min(current_x + step, search_max)\n\n            y1 = self._evaluator.evaluate(coefficients, current_x)\n            y2 = self._evaluator.evaluate(coefficients, next_x)\n\n            if abs(y1) < tolerance:\n                return current_x, next_x # Found a root at current_x\n            if abs(y2) < tolerance:\n                return current_x, next_x # Found a root at next_x\n\n            if y1 * y2 < 0: # Found a strict sign change\n                return current_x, next_x\n            \n            current_x = next_x\n            \n            if current_x == search_max: # Break if we've hit the upper bound exactly\n                break\n\n        # Final check if the upper bound itself is a root, or if the entire range [min, max]\n        # contains a sign change without being caught by the steps (e.g., very wide interval).\n        y_at_max = self._evaluator.evaluate(coefficients, search_max)\n        if abs(y_at_max) < tolerance:\n            return search_max - step, search_max # Found a root at search_max\n        \n        if y_at_min * y_at_max < 0:\n            return search_min, search_max # Sign change across the entire range\n\n        raise RuntimeError(\"Could not find an initial interval with sign change or a root within the search range.\")\n\n    def find_zero(self, coefficients: list[float]) -> float:\n        \"\"\"Finds a single zero point for a polynomial given its coefficients.\n        Performs input validation and orchestrates the root-finding process.\n        \"\"\"\n        if not isinstance(coefficients, list) or not all(isinstance(c, (int, float)) for c in coefficients):\n            raise ValueError(\"Coefficients must be a list of numbers.\")\n        if len(coefficients) % 2 != 0:\n            raise ValueError(\"Input coefficients list must have an even number of elements (implying an odd-degree polynomial).\")\n        if not coefficients:\n            raise ValueError(\"Coefficients list cannot be empty.\")\n        if coefficients[-1] == 0:\n            raise ValueError(\"Leading coefficient cannot be zero.\")\n\n        # Define the polynomial function for the solver\n        poly_func: Callable[[float], float] = lambda x: self._evaluator.evaluate(coefficients, x)\n\n        a, b = self._find_initial_interval(coefficients)\n        \n        return self._bisection_solver.find_root(poly_func, a, b)\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    evaluator = PolynomialEvaluator()\n    bisection_solver = BisectionSolver()\n    finder = PolynomialRootFinder(evaluator, bisection_solver)\n    return finder.find_zero(xs)"}
