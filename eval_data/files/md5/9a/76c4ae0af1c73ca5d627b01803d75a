{"task_id": "HumanEval/70", "solution": "from typing import List\ndef strange_sort_list(lst: List[int]) -> List[int]:\n    \"\"\"\n    Sorts a list of integers into a \"strange\" order: minimum, then maximum of remaining, and so on.\n    This function processes the input to create a new list with the specified alternating pattern.\n    \"\"\"\n    if not lst:\n        return []\n\n    # Create a sorted copy of the input list to preserve the original and enable two-pointer traversal.\n    sorted_lst = sorted(lst)\n    \n    result = []\n    left = 0\n    right = len(sorted_lst) - 1\n    is_min_turn = True\n\n    while left <= right:\n        if is_min_turn:\n            result.append(sorted_lst[left])\n            left += 1\n        else:\n            result.append(sorted_lst[right])\n            right -= 1\n        is_min_turn = not is_min_turn\n        \n    return result"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst: list[int]) -> list[int]:\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting starts with the minimum, then maximum of remaining, then minimum, and so on.\n    '''\n    if not lst:\n        return []\n\n    sorted_lst = sorted(lst)\n    result = []\n    left, right = 0, len(sorted_lst) - 1\n    is_min_turn = True\n\n    while left <= right:\n        if is_min_turn:\n            result.append(sorted_lst[left])\n            left += 1\n        else:\n            result.append(sorted_lst[right])\n            right -= 1\n        is_min_turn = not is_min_turn\n    return result"}
{"task_id": "HumanEval/70", "solution": "from typing import List, Any\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to strange_sort_list. Stores a descriptive message.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass StrangeSorter:\n    \"\"\"Handles the strange sorting, including input validation and the core algorithm.\"\"\"\n    def __init__(self, input_list: List[int]):\n        self._validate_input(input_list)\n        self._input_list = input_list\n        self._result_list: List[int] = []\n\n    def _validate_input(self, lst: List[Any]) -> None:\n        \"\"\"Validates if the input is a list and contains only integers, raising an error if not.\"\"\"\n        if not isinstance(lst, list):\n            raise InvalidInputError(\"Input must be a list.\")\n        for item in lst:\n            if not isinstance(item, int):\n                raise InvalidInputError(\"All elements in the list must be integers.\")\n\n    def sort(self) -> List[int]:\n        \"\"\"Executes the strange sorting algorithm, returning a new list in the specified order.\"\"\"\n        if not self._input_list:\n            return []\n\n        # Create a sorted mutable copy for efficient min/max operations.\n        working_list = sorted(self._input_list)\n        self._result_list = []\n        take_min = True\n\n        while working_list:\n            if take_min:\n                self._result_list.append(working_list.pop(0))\n            else:\n                self._result_list.append(working_list.pop())\n            take_min = not take_min\n        \n        return self._result_list\ndef strange_sort_list(lst: List[int]) -> List[int]:\n    \"\"\"\n    Given a list of integers, return the list in strange order.\n    Starts with the minimum value, then maximum of the remaining, then minimum, and so on.\n    \"\"\"\n    sorter = StrangeSorter(lst)\n    return sorter.sort()"}
{"task_id": "HumanEval/71", "solution": "import math\nAREA_ROUND_PRECISION = 2\ndef _are_sides_positive(a: float, b: float, c: float) -> bool:\n    \"\"\"Checks if all side lengths are strictly positive.\n    This fulfills part of FR1's precondition and BR2.\n    \"\"\"\n    return a > 0 and b > 0 and c > 0\ndef _is_valid_triangle(a: float, b: float, c: float) -> bool:\n    \"\"\"Checks if three side lengths form a valid triangle by positive side check and triangle inequality.\n    This implements FR1 and BR1.\n    \"\"\"\n    if not _are_sides_positive(a, b, c):\n        return False\n    \n    return (a + b > c) and (a + c > b) and (b + c > a)\ndef _calculate_herons_area(a: float, b: float, c: float) -> float:\n    \"\"\"Calculates the area of a triangle using Heron's formula.\n    This implements FR2, assuming valid triangle input.\n    \"\"\"\n    s = (a + b + c) / 2\n    # The term under sqrt should be non-negative for valid triangles.\n    # A small negative value due to floating point inaccuracies is clamped to 0.\n    term = s * (s - a) * (s - b) * (s - c)\n    if term < 0:\n        term = 0\n    return math.sqrt(term)\ndef triangle_area(a, b, c):\n    \"\"\"\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater \n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    \"\"\"\n    if not _is_valid_triangle(a, b, c):\n        return -1.0 # FR3: Return -1 for invalid triangles, as a float for consistency.\n\n    raw_area = _calculate_herons_area(a, b, c)\n    return round(raw_area, AREA_ROUND_PRECISION) # FR4: Round to 2 decimal places."}
{"task_id": "HumanEval/71", "solution": "import math\nDECIMAL_PLACES = 2\nclass TriangleValidator:\n    \"\"\"Validates if three given side lengths can form a valid triangle.\n    It checks for positive side lengths and the triangle inequality theorem.\"\"\"\n    def is_valid_triangle(self, a: float, b: float, c: float) -> bool:\n        if not (a > 0 and b > 0 and c > 0):\n            return False\n        \n        # Check triangle inequality theorem.\n        if not (a + b > c and a + c > b and b + c > a):\n            return False\n            \n        return True\nclass TriangleCalculator:\n    \"\"\"Calculates the area of a triangle using Heron's formula.\n    It assumes valid triangle input for the calculation.\"\"\"\n    def calculate_herons_area(self, a: float, b: float, c: float) -> float:\n        s = (a + b + c) / 2\n        area_squared = s * (s - a) * (s - b) * (s - c)\n        \n        # Safeguard against tiny negative values due to floating point inaccuracies.\n        if area_squared < 0:\n            area_squared = 0.0\n            \n        return math.sqrt(area_squared)\nclass TriangleService:\n    \"\"\"Orchestrates triangle validation and area calculation.\n    It provides the logic for the public triangle_area function.\"\"\"\n    def __init__(self, validator: TriangleValidator = None, calculator: TriangleCalculator = None):\n        self._validator = validator if validator is not None else TriangleValidator()\n        self._calculator = calculator if calculator is not None else TriangleCalculator()\n\n    def triangle_area(self, a: float, b: float, c: float) -> float:\n        \"\"\"Calculates and returns the rounded area if the triangle is valid.\n        Otherwise, it returns -1.0 for an invalid triangle.\"\"\"\n        if not self._validator.is_valid_triangle(a, b, c):\n            return -1.0\n        \n        area = self._calculator.calculate_herons_area(a, b, c)\n        return round(area, DECIMAL_PLACES)\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1.0.\n    '''\n    service = TriangleService()\n    return service.triangle_area(float(a), float(b), float(c))"}
{"task_id": "HumanEval/71", "solution": "import math\nfrom dataclasses import dataclass\nclass TriangleValidator:\n    \"\"\"\n    Validates if three given side lengths can form a valid triangle.\n    \"\"\"\n    def is_valid(self, sides: TriangleSides) -> bool:\n        \"\"\"\n        Checks if sides are positive and satisfy the triangle inequality theorem.\n        \"\"\"\n        # All sides must be positive\n        if not (sides.a > 0 and sides.b > 0 and sides.c > 0):\n            return False\n\n        # Triangle inequality theorem\n        if not (sides.a + sides.b > sides.c and\n                sides.a + sides.c > sides.b and\n                sides.b + sides.c > sides.a):\n            return False\n\n        return True\nclass HeronCalculator:\n    \"\"\"\n    Calculates the area of a triangle using Heron's formula.\n    Assumes valid triangle sides as input.\n    \"\"\"\n    def calculate(self, sides: TriangleSides) -> float:\n        \"\"\"\n        Applies Heron's formula to compute the triangle area.\n        \"\"\"\n        s = (sides.a + sides.b + sides.c) / 2\n        area_squared = s * (s - sides.a) * (s - sides.b) * (s - sides.c)\n        \n        # Handle potential floating point inaccuracies that might result in a tiny negative\n        # value for area_squared when the triangle is degenerate (area should be 0).\n        if area_squared < 0:\n            return 0.0\n            \n        return math.sqrt(area_squared)\nclass TriangleService:\n    \"\"\"\n    Orchestrates triangle validation and area calculation.\n    \"\"\"\n    def __init__(self, validator: TriangleValidator, calculator: HeronCalculator):\n        self._validator = validator\n        self._calculator = calculator\n\n    def get_triangle_area(self, a: float, b: float, c: float) -> float:\n        \"\"\"\n        Validates triangle sides, calculates area if valid, and handles rounding.\n        Returns -1.0 if the triangle is invalid.\n        \"\"\"\n        sides = TriangleSides(a, b, c)\n\n        if not self._validator.is_valid(sides):\n            return -1.0 # Return -1.0 as a float for type consistency.\n\n        area = self._calculator.calculate(sides)\n        return round(area, 2)\ndef triangle_area(a: float, b: float, c: float) -> float:\n    \"\"\"\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle.\n    Otherwise return -1.0.\n    Three sides make a valid triangle when the sum of any two sides is greater\n    than the third side, and all sides are positive.\n    \"\"\"\n    validator = TriangleValidator()\n    calculator = HeronCalculator()\n    service = TriangleService(validator, calculator)\n\n    return service.get_triangle_area(a, b, c)"}
{"task_id": "HumanEval/71", "solution": "import math\ndef triangle_area(a: float, b: float, c: float) -> float:\n    \"\"\"\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle.\n    Otherwise return -1.0.\n    \"\"\"\n    # Validate triangle sides: all must be positive and adhere to triangle inequality.\n    if not (a > 0 and b > 0 and c > 0):\n        return -1.0\n    if not (a + b > c and a + c > b and b + c > a):\n        return -1.0\n\n    # Calculate semi-perimeter and area using Heron's formula.\n    s = (a + b + c) / 2\n    \n    # Handle floating point inaccuracies by clamping negative results to zero.\n    area_squared = s * (s - a) * (s - b) * (s - c)\n    if area_squared < 0:\n        area_squared = 0\n\n    area = math.sqrt(area_squared)\n    return round(area, 2)"}
{"task_id": "HumanEval/71", "solution": "import math\ndef triangle_area(a, b, c):\n    \"\"\"\n    Calculates the area of a triangle given its three side lengths.\n    Returns the area rounded to two decimal places if valid, otherwise -1.0.\n    \"\"\"\n    # Validate if sides are positive\n    if not (a > 0 and b > 0 and c > 0):\n        return -1.0\n    \n    # Validate triangle inequality theorem\n    if not ((a + b > c) and (a + c > b) and (b + c > a)):\n        return -1.0\n    \n    # Calculate semi-perimeter\n    s = (a + b + c) / 2\n    \n    # Calculate area using Heron's formula\n    area_squared = s * (s - a) * (s - b) * (s - c)\n    \n    # Handle potential floating-point inaccuracies\n    if area_squared < 0:\n        raw_area = 0.0\n    else:\n        raw_area = math.sqrt(area_squared)\n    \n    # Round the area to two decimal places\n    return round(raw_area, 2)"}
