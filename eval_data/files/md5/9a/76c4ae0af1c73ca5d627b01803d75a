{"task_id": "HumanEval/88", "solution": "from typing import List\ndef sort_array(array: List[int]) -> List[int]:\n    \"\"\"\n    Sorts an array of non-negative integers based on the parity of its first and last elements' sum.\n    A new list is returned without modifying the original array.\n    \"\"\"\n    if not array:\n        return []\n    if len(array) == 1:\n        return list(array)\n\n    array_copy = list(array)\n    sum_of_ends = array_copy[0] + array_copy[-1]\n\n    if sum_of_ends % 2 != 0:  # Odd sum indicates ascending order\n        return sorted(array_copy)\n    else:  # Even sum indicates descending order\n        return sorted(array_copy, reverse=True)"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Sorts a copy of the array based on the parity of the sum of its first and last elements.\n    Returns the sorted copy without modifying the original array.\n    \"\"\"\n    if not array:\n        return []\n\n    copied_array = list(array) # Create a copy to ensure the original array is not modified.\n\n    if len(copied_array) == 1:\n        return copied_array\n\n    first_element = copied_array[0]\n    last_element = copied_array[-1]\n    sum_first_last = first_element + last_element\n\n    if sum_first_last % 2 == 1:  # Odd sum, sort ascending.\n        copied_array.sort()\n    else:  # Even sum, sort descending.\n        copied_array.sort(reverse=True)\n\n    return copied_array"}
{"task_id": "HumanEval/88", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to the array sorting function.\"\"\"\n    def __init__(self, message: str = \"Invalid input array.\"):\n        self.message = message\n        super().__init__(self.message)\ndef sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n\n    Note:\n    * don't change the given array.\n\n    Examples:\n    * sort_array([]) => []\n    * sort_array([5]) => [5]\n    * sort_array([2, 4, 3, 0, 1, 5]) => [0, 1, 2, 3, 4, 5]\n    * sort_array([2, 4, 3, 0, 1, 5, 6]) => [6, 5, 4, 3, 2, 1, 0]\n    \"\"\"\n    # Validate input array according to FR1 and BR4.\n    if not isinstance(array, list):\n        raise InvalidInputError(\"Input must be a list.\")\n    \n    for item in array:\n        if not isinstance(item, int) or item < 0:\n            raise InvalidInputError(\"All elements must be non-negative integers.\")\n            \n    # Handle empty or single-element arrays as per FR2 and NFR2.\n    if len(array) <= 1:\n        return list(array) # Return a copy to ensure original is unchanged.\n\n    # Determine sorting order based on FR2, BR1, BR2, BR3.\n    first_element = array[0]\n    last_element = array[-1]\n    sum_first_last = first_element + last_element\n    \n    # True for odd sum (ascending), False for even sum (descending).\n    should_sort_ascending = (sum_first_last % 2 != 0)\n\n    # Sort a copy of the array according to FR3, FR4, BR5.\n    # Python's built-in sorted() is efficient for NFR1.\n    sorted_copy = sorted(array, reverse=not should_sort_ascending)\n    \n    return sorted_copy"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Create a function encrypt that takes a string as an argument and\n    returns a string encrypted with the alphabet being rotated.\n    The alphabet should be rotated in a manner such that the letters\n    shift down by two multiplied to two places.\n    For example:\n    encrypt('hi') returns 'lm'\n    encrypt('asdfghjkl') returns 'ewhjklnop'\n    encrypt('gf') returns 'kj'\n    encrypt('et') returns 'ix'\n    \"\"\"\n    SHIFT_AMOUNT = 4  # Shift characters by 4 positions.\n    ALPHABET_SIZE = 26 # Standard English alphabet size.\n    ORD_LOWER_A = ord('a')\n    ORD_UPPER_A = ord('A')\n\n    encrypted_chars = []\n    for char in s:\n        char_ord = ord(char)\n        if 'a' <= char <= 'z':\n            # Calculate new position for lowercase, handling wrap-around.\n            shifted_ord = (char_ord - ORD_LOWER_A + SHIFT_AMOUNT) % ALPHABET_SIZE\n            encrypted_chars.append(chr(ORD_LOWER_A + shifted_ord))\n        elif 'A' <= char <= 'Z':\n            # Calculate new position for uppercase, handling wrap-around.\n            shifted_ord = (char_ord - ORD_UPPER_A + SHIFT_AMOUNT) % ALPHABET_SIZE\n            encrypted_chars.append(chr(ORD_UPPER_A + shifted_ord))\n        else:\n            # Non-alphabetic characters remain unchanged.\n            encrypted_chars.append(char)\n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"\n    Create a function encrypt that takes a string as an argument and\n    returns a string encrypted with the alphabet being rotated. \n    The alphabet should be rotated in a manner such that the letters \n    shift down by two multiplied to two places.\n    For example:\n    encrypt('hi') returns 'lm'\n    encrypt('asdfghjkl') returns 'ewhjklnop'\n    encrypt('gf') returns 'kj'\n    encrypt('et') returns 'ix'\n    \"\"\"\n    SHIFT_AMOUNT = 4\n    encrypted_chars = []\n\n    for char in s:\n        if 'a' <= char <= 'z':\n            base = ord('a')\n            offset = ord(char) - base\n            shifted_offset = (offset + SHIFT_AMOUNT) % 26\n            encrypted_chars.append(chr(base + shifted_offset))\n        elif 'A' <= char <= 'Z':\n            base = ord('A')\n            offset = ord(char) - base\n            shifted_offset = (offset + SHIFT_AMOUNT) % 26\n            encrypted_chars.append(chr(base + shifted_offset))\n        else:\n            encrypted_chars.append(char)\n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by rotating alphabetic characters by a fixed amount.\n    Non-alphabetic characters remain unchanged, preserving case.\n    \"\"\"\n    SHIFT_AMOUNT = 4 # The alphabet rotation shift amount is fixed at 4 positions.\n\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n\n    encrypted_chars = []\n\n    def _shift_char(char: str) -> str:\n        # Helper function to shift a single alphabetic character.\n        # It handles case sensitivity and wraps around the alphabet.\n        if 'a' <= char <= 'z':\n            start = ord('a')\n            return chr(start + (ord(char) - start + SHIFT_AMOUNT) % 26)\n        elif 'A' <= char <= 'Z':\n            start = ord('A')\n            return chr(start + (ord(char) - start + SHIFT_AMOUNT) % 26)\n        else:\n            return char\n\n    for char in s:\n        encrypted_chars.append(_shift_char(char))\n\n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"\n    Encrypts a string by rotating each lowercase English alphabet character by four places.\n    Non-lowercase characters are preserved in the output.\n    \"\"\"\n    _ALPHABET_LOWER = \"abcdefghijklmnopqrstuvwxyz\"\n    _ALPHABET_SIZE = len(_ALPHABET_LOWER)\n    _SHIFT_AMOUNT = 4\n\n    encrypted_chars = []\n    for char in s:\n        if 'a' <= char <= 'z':\n            char_index = _ALPHABET_LOWER.find(char)\n            shifted_index = (char_index + _SHIFT_AMOUNT) % _ALPHABET_SIZE\n            encrypted_chars.append(_ALPHABET_LOWER[shifted_index])\n        else:\n            encrypted_chars.append(char)\n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"\n    Encrypts a string by rotating its alphabetic characters by a fixed amount.\n    Non-alphabetic characters remain unchanged, and case is preserved.\n    \"\"\"\n    SHIFT_AMOUNT = 4\n    encrypted_chars = []\n\n    for char in s:\n        if 'a' <= char <= 'z':\n            start_ord = ord('a')\n            shifted_ord = start_ord + (ord(char) - start_ord + SHIFT_AMOUNT) % 26\n            encrypted_chars.append(chr(shifted_ord))\n        elif 'A' <= char <= 'Z':\n            start_ord = ord('A')\n            shifted_ord = start_ord + (ord(char) - start_ord + SHIFT_AMOUNT) % 26\n            encrypted_chars.append(chr(shifted_ord))\n        else:\n            encrypted_chars.append(char)\n            \n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"\n    Encrypts a string by rotating alphabetic characters by 4 positions forward.\n    Non-alphabetic characters remain unchanged, and case is preserved.\n    \"\"\"\n    encrypted_chars = []\n    for char in s:\n        if 'a' <= char <= 'z':\n            # Lowercase letter: rotate within 'a' through 'z'\n            base = ord('a')\n            offset = ord(char) - base\n            rotated_offset = (offset + 4) % 26\n            encrypted_chars.append(chr(base + rotated_offset))\n        elif 'A' <= char <= 'Z':\n            # Uppercase letter: rotate within 'A' through 'Z'\n            base = ord('A')\n            offset = ord(char) - base\n            rotated_offset = (offset + 4) % 26\n            encrypted_chars.append(chr(base + rotated_offset))\n        else:\n            # Non-alphabetic character: leave unchanged\n            encrypted_chars.append(char)\n    return \"\".join(encrypted_chars)"}
