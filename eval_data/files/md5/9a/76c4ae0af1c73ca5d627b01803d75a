{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Checks if x is a simple power of n, meaning x = n^k for some non-negative integer k.\n    Returns True if it is, False otherwise.\n    \"\"\"\n    if not isinstance(x, int) or not isinstance(n, int):\n        raise TypeError(\"Both x and n must be integers.\")\n\n    if n <= 0:\n        raise ValueError(\"Base 'n' must be a positive integer.\")\n\n    if x < 0:\n        return False\n\n    if x == 1:\n        return True\n\n    if n == 1:  # If x is not 1 (from previous step) and n is 1, it cannot be a power\n        return False\n\n    while x > 1 and x % n == 0:\n        x //= n\n\n    return x == 1"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Checks if x is a simple power of n (i.e., n^k = x for k >= 0).\n    Raises TypeError if inputs are not integers, ValueError if n is non-positive.\n    \"\"\"\n    if not isinstance(x, int) or not isinstance(n, int):\n        raise TypeError(\"Both x and n must be integers.\")\n\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer.\")\n\n    if x < 1:\n        return False\n    \n    if x == 1:\n        return True  # n^0 = 1 for any n > 0\n\n    if n == 1:\n        return False # If x != 1, 1^k will always be 1.\n\n    # Repeatedly divide x by n.\n    while x % n == 0:\n        x //= n\n        if x == 1:\n            return True\n    \n    return False"}
{"task_id": "HumanEval/76", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef is_simple_power(x, n):\n    \"\"\"\n    Checks if a number x is a simple power of n (n**k = x for k >= 0).\n    Raises InvalidInputError for non-positive or non-integer inputs.\n    \"\"\"\n    if not isinstance(x, int) or not isinstance(n, int):\n        raise InvalidInputError(\"Inputs x and n must be integers.\")\n    if x <= 0 or n <= 0:\n        raise InvalidInputError(\"Inputs x and n must be positive integers.\")\n\n    if x == 1:\n        return True # n**0 = 1 for any n > 0.\n    if n == 1:\n        return False # 1**k = 1, so if x is not 1, it's not a power of 1.\n\n    current_x = x\n    while current_x % n == 0 and current_x > 1:\n        current_x //= n\n    \n    return current_x == 1"}
{"task_id": "HumanEval/76", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef is_simple_power(x, n):\n    \"\"\"\n    Checks if a number x is a simple power of n (n**k = x for non-negative integer k).\n    Raises InvalidInputError for invalid input types or values.\n    \"\"\"\n    if not isinstance(x, int) or not isinstance(n, int):\n        raise InvalidInputError(\"Inputs x and n must be integers.\")\n    if x < 0:\n        raise InvalidInputError(\"Input x must be a non-negative integer.\")\n    if n <= 0:\n        raise InvalidInputError(\"Input n must be a positive integer.\")\n\n    if x == 1:\n        return True  # n^0 = 1 for any n > 0\n\n    if n == 1:\n        return False # If x > 1 and n = 1, it cannot be a power of 1\n\n    # Repeatedly divide x by n as long as it's greater than 1 and perfectly divisible.\n    while x > 1 and x % n == 0:\n        x //= n\n\n    return x == 1"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    \"\"\"\n    Checks if an integer 'a' is a perfect cube of some integer.\n    Handles positive, negative, and zero inputs.\n    \"\"\"\n    if a == 0:\n        return True\n\n    abs_a = abs(a)\n\n    # Calculate an approximate integer cube root, using rounding to mitigate float inaccuracies.\n    root_candidate = round(abs_a**(1/3))\n\n    # Determine the actual root candidate, preserving the original sign of 'a'.\n    actual_root = root_candidate if a >= 0 else -root_candidate\n\n    return actual_root**3 == a"}
{"task_id": "HumanEval/76", "solution": "class PowerCheckerError(Exception):\n    \"\"\"Base exception for the power_checker package.\"\"\"\n    pass\nclass InvalidInputError(PowerCheckerError):\n    \"\"\"Exception raised for invalid input parameters.\"\"\"\n    pass\ndef is_simple_power(x, n):\n    \"\"\"\n    Checks if x is a simple power of n, i.e., n**k = x for non-negative integer k.\n    This function first validates inputs, then performs an iterative division check.\n    \"\"\"\n    # Validate inputs: x and n must be integers, and n must be positive.\n    if not isinstance(x, int) or not isinstance(n, int):\n        raise InvalidInputError(\"Inputs x and n must be integers.\")\n    if n <= 0:\n        raise InvalidInputError(\"Input n must be a positive integer.\")\n\n    if x == 1:\n        return True  # Any n > 0 raised to power 0 is 1.\n    if n == 1:\n        return False # 1 raised to any power is 1; since x != 1 here, it's false.\n    if x <= 0:\n        return False # Positive n raised to non-negative power is positive or 1.\n\n    current_x = x\n    # Repeatedly divide x by n as long as it's divisible.\n    while current_x % n == 0:\n        current_x //= n\n    \n    # If x became 1 after divisions, it was a power of n.\n    return current_x == 1"}
{"task_id": "HumanEval/77", "solution": "def iscube(a: int) -> bool:\n    \"\"\"\n    Checks if the input integer 'a' is a perfect cube.\n    It handles positive, negative, and zero inputs.\n    \"\"\"\n    if a == 0:\n        return True\n\n    # Calculate the integer cube root of the absolute value of 'a'.\n    # Uses floating-point approximation and rounding.\n    abs_a = abs(a)\n    integer_cbrt_abs = round(abs_a**(1/3))\n\n    # Determine the candidate root based on the original sign of 'a'.\n    candidate_root = -integer_cbrt_abs if a < 0 else integer_cbrt_abs\n    \n    # Check if cubing the candidate root yields the original number.\n    return candidate_root ** 3 == a"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    '''\n    Checks if the given integer 'a' is a perfect cube of some integer number.\n    Handles positive, negative, and zero inputs efficiently using cube root approximation.\n    '''\n    if a == 0:\n        return True\n\n    root = round(abs(a)**(1/3))\n\n    if a < 0:\n        root = -root\n    \n    return root * root * root == a"}
{"task_id": "HumanEval/77", "solution": "import math\ndef iscube(a):\n    \"\"\"\n    Determines if the given integer 'a' is a perfect cube.\n    Returns True if 'a' is a perfect cube, False otherwise.\n    \"\"\"\n    if a == 0:\n        return True\n\n    # Calculate cube root of absolute value, then round to the nearest integer.\n    cbrt_val = math.cbrt(abs(a))\n    rounded_root = round(cbrt_val)\n\n    # Apply the original sign to the rounded root and check its cube.\n    final_root = -rounded_root if a < 0 else rounded_root\n    return final_root ** 3 == a"}
{"task_id": "HumanEval/77", "solution": "import math\ndef iscube(a):\n    \"\"\"\n    Determines if the given integer 'a' is a perfect cube.\n    Handles potential floating point inaccuracies by rounding the cube root and verifying.\n    \"\"\"\n    if a == 0:\n        return True\n    \n    # Calculate the cube root of the absolute value of 'a' and round it.\n    abs_root_candidate = round(abs(a)**(1/3))\n    \n    # Reapply the original sign to get the candidate integer root.\n    candidate_root = int(math.copysign(abs_root_candidate, a))\n    \n    # Verify if cubing the candidate root equals the original number.\n    return candidate_root * candidate_root * candidate_root == a"}
{"task_id": "HumanEval/77", "solution": "def iscube(a: int) -> bool:\n    \"\"\"\n    Determines if the given integer 'a' is a perfect cube.\n    A number 'N' is a perfect cube if there exists an integer 'X' such that X * X * X = N.\n    \"\"\"\n    if a == 0:\n        return True\n\n    abs_a = abs(a)\n\n    # Calculate the approximate cube root and round it.\n    approx_root = abs_a**(1/3)\n    candidate_root = round(approx_root)\n\n    # Check a small range around the candidate root for precision.\n    for r in range(max(0, candidate_root - 2), candidate_root + 3):\n        if r * r * r == abs_a:\n            return True\n\n    return False"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    \"\"\"Checks if an integer 'a' is a perfect cube.\"\"\"\n    if a == 0:\n        return True\n\n    def _integer_cbrt_signed(n_val):\n        \"\"\"Calculates the integer cube root of n_val, handling signs and using binary search.\"\"\"\n        sign = 1\n        if n_val < 0:\n            sign = -1\n            n_val = abs(n_val)\n\n        low = 0\n        # Estimate high bound for binary search, robust for Python's arbitrary-precision integers.\n        # This initial estimate uses float arithmetic, which can have precision issues for very large numbers.\n        # However, the binary search further refines this to find the exact integer root.\n        high = int(n_val**(1/3)) + 2 \n        # Adjust high bound for small numbers where `int(n_val**(1/3)) + 2` might be too large.\n        if high > n_val and n_val > 0:\n            high = n_val\n        \n        ans = 0\n        while low <= high:\n            mid = (low + high) // 2\n            cube = mid * mid * mid\n            if cube == n_val:\n                # Found the exact integer cube root\n                return sign * mid\n            elif cube < n_val:\n                # mid could be the integer cube root (floor), or we need to search higher\n                ans = mid\n                low = mid + 1\n            else: # cube > n_val\n                # We need to search lower\n                high = mid - 1\n        \n        # ans now holds the floor(cbrt(abs(a)))\n        return sign * ans\n\n    root = _integer_cbrt_signed(a)\n    return (root ** 3) == a"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    \"\"\"\n    Checks if the given integer 'a' is a perfect cube of some integer.\n    This function handles positive, negative, and zero inputs.\n    \"\"\"\n    if a == 0:\n        return True\n\n    # Determine the sign for correct cube root calculation.\n    sign = 1 if a >= 0 else -1\n    abs_a = abs(a)\n\n    # Calculate the cube root of the absolute value and round to the nearest integer.\n    rounded_root = round(abs_a**(1/3))\n\n    # Apply the original sign to the rounded integer root.\n    candidate_root = sign * int(rounded_root)\n\n    # Check if cubing the candidate_root yields the original number 'a'.\n    return candidate_root * candidate_root * candidate_root == a"}
{"task_id": "HumanEval/77", "solution": "def iscube(a: int) -> bool:\n    \"\"\"\n    Checks if an integer 'a' is a perfect cube.\n    It handles floating-point inaccuracies by rounding the cube root.\n    \"\"\"\n    if a == 0:\n        return True\n\n    # Calculate the cube root of the absolute value, then round.\n    cbrt_candidate = round(abs(a)**(1/3))\n\n    # Adjust sign for negative input.\n    if a < 0:\n        cbrt_candidate = -cbrt_candidate\n\n    # Verify if the cubed candidate matches the original number.\n    return cbrt_candidate * cbrt_candidate * cbrt_candidate == a"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    \"\"\"\n    Checks if the given integer 'a' is a perfect cube.\n    Handles positive, negative, and zero integers by calculating and verifying the integer cube root.\n    \"\"\"\n    if a == 0:\n        return True\n\n    is_negative = a < 0\n    val = abs(a)\n\n    # Calculate the cube root using floating point, then round to nearest integer.\n    root_candidate = round(val**(1/3))\n\n    # Verify if the cubed candidate equals the absolute value.\n    if root_candidate**3 == val:\n        # If the original number was negative, its cube root must also be negative to match 'a'.\n        if is_negative:\n            return (-root_candidate)**3 == a\n        else:\n            # For positive numbers, the positive root_candidate cubed must equal 'a'.\n            return root_candidate**3 == a\n    return False"}
