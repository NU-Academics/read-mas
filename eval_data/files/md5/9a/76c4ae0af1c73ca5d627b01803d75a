{"task_id": "HumanEval/130", "solution": "from typing import List\ndef tri(n: int) -> List[int]:\n    \"\"\"\n    Calculates the first n + 1 numbers of the Tribonacci sequence.\n    Raises ValueError for negative n.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    if n == 0:\n        return [1]\n    if n == 1:\n        return [1, 3]\n\n    sequence = [0] * (n + 1)\n    sequence[0] = 1\n    sequence[1] = 3\n\n    for i in range(2, n + 1):\n        if i % 2 == 0:  # n is even\n            sequence[i] = 1 + i // 2\n        else:  # n is odd\n            # tri(i+1) is needed, and since i is odd, i+1 is even and directly computable.\n            tri_i_plus_1 = 1 + (i + 1) // 2\n            sequence[i] = sequence[i - 1] + sequence[i - 2] + tri_i_plus_1\n            \n    return sequence"}
{"task_id": "HumanEval/130", "solution": "from typing import List, Dict\ndef tri(n):\n    \"\"\"Calculates the first n+1 numbers of the custom Tribonacci sequence.\n    Handles base cases, even/odd recurrence relations, and validates input.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    memo: Dict[int, float] = {}  # Stores computed Tribonacci values for memoization.\n    sequence: List[float] = []  # Accumulates the sequence elements.\n\n    for k in range(n + 1):\n        current_val: float\n        if k == 0:\n            current_val = 1.0  # Base case for tri(0).\n        elif k == 1:\n            current_val = 3.0  # Base case for tri(1).\n        elif k % 2 == 0:  # For even k > 1, apply the direct formula.\n            current_val = 1.0 + k / 2.0\n        else:  # For odd k > 1, apply the recursive-like formula.\n            # tri(k+1) can be calculated directly as k+1 is always even.\n            val_k_plus_1 = 1.0 + (k + 1) / 2.0\n            current_val = memo[k - 1] + memo[k - 2] + val_k_plus_1\n        \n        memo[k] = current_val\n        sequence.append(current_val)\n            \n    return sequence"}
{"task_id": "HumanEval/130", "solution": "from typing import List, Dict, Union\ndef tri(n: int) -> List[Union[int, float]]:\n    \"\"\"\n    Calculates the custom Tribonacci sequence.\n    Returns a list of the first n+1 numbers, from tri(0) to tri(n).\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        # Input validation ensures n is a non-negative integer.\n        # A standard ValueError is raised for invalid input, as per \"bare function\" constraint.\n        raise ValueError(\"Input n must be a non-negative integer.\")\n\n    def _format_number_local(value: float) -> Union[int, float]:\n        \"\"\"Converts a float to an int if it's a whole number, otherwise keeps it as float.\"\"\"\n        return int(value) if value.is_integer() else value\n\n    # Initialize memoization cache for this function call.\n    memo: Dict[int, Union[int, float]] = {}\n\n    # Define base cases tri(0) and tri(1) as per the specification and examples.\n    memo[0] = _format_number_local(1.0)\n    if n == 0:\n        return [memo[0]]\n\n    memo[1] = _format_number_local(3.0)\n    if n == 1:\n        return [memo[0], memo[1]]\n\n    # Pass 1: Calculate and cache all even terms up to n+1 using `1 + i / 2`.\n    # This ensures `tri(i+1)` is available when needed for odd `tri(i)` terms.\n    for i in range(2, n + 2):\n        if i % 2 == 0:\n            memo[i] = _format_number_local(1 + i / 2)\n\n    # Pass 2: Calculate and cache all odd terms up to n using `tri(i-1) + tri(i-2) + tri(i+1)`.\n    # All necessary dependencies are guaranteed to be in the `memo` cache from Pass 1 or earlier iterations.\n    for i in range(2, n + 1):\n        if i % 2 != 0:\n            memo[i] = _format_number_local(memo[i-1] + memo[i-2] + memo[i+1])\n\n    # Construct and return the final list containing terms from tri(0) to tri(n).\n    return [memo[i] for i in range(n + 1)]"}
