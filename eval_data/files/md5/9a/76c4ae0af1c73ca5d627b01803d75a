 collatz_service.generate_sequence(n)\n    odd_numbers = collatz_service.get_odd_numbers(sequence)\n\n    return sorted(odd_numbers)"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n: int) -> list[int]:\n    \"\"\"\n    Given a positive integer n, return a sorted list of unique odd numbers from its Collatz sequence.\n    The sequence starts with n and terminates at 1, following standard Collatz rules.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    sequence = []\n    current_term = n\n    while current_term != 1:\n        sequence.append(current_term)\n        if current_term % 2 == 0:\n            current_term = current_term // 2\n        else:\n            current_term = (3 * current_term) + 1\n    sequence.append(1)\n\n    odd_numbers = {num for num in sequence if num % 2 != 0}\n    return sorted(list(odd_numbers))"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list of odd numbers in its Collatz sequence.\n    The sequence follows specific rules until 1 is reached.\n    \"\"\"\n    # Validate input: n must be a positive integer.\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    # Handle the base case where n is 1.\n    if n == 1:\n        return [1]\n\n    # Generate the Collatz sequence.\n    sequence = []\n    current_n = n\n    while current_n != 1:\n        sequence.append(current_n)\n        if current_n % 2 == 0:\n            current_n //= 2\n        else:\n            current_n = 3 * current_n + 1\n    sequence.append(1) # Ensure 1 is always included.\n\n    # Identify unique odd numbers from the sequence.\n    odd_numbers = set()\n    for num in sequence:\n        if num % 2 != 0:\n            odd_numbers.add(num)\n\n    # Sort and return the unique odd numbers.\n    return sorted(list(odd_numbers))"}
{"task_id": "HumanEval/123", "solution": "from typing import List\ndef get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in its Collatz sequence.\n    The sequence is generated until it reaches 1, then odd numbers are extracted and sorted.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    if n == 1:\n        return [1]\n\n    def _get_next_term(current_term: int) -> int:\n        \"\"\"Computes the next term in the Collatz sequence based on whether the current term is even or odd.\"\"\"\n        if current_term % 2 == 0:\n            return current_term // 2\n        else:\n            return 3 * current_term + 1\n\n    sequence: List[int] = []\n    current_n = n\n    # Generate the Collatz sequence until 1 is reached.\n    while current_n != 1:\n        sequence.append(current_n)\n        current_n = _get_next_term(current_n)\n    sequence.append(1) # Add the final 1 to complete the sequence.\n\n    # Filter out odd numbers and ensure uniqueness using a set.\n    odd_numbers = {num for num in sequence if num % 2 != 0}\n\n    # Convert to list and sort in ascending order.\n    return sorted(list(odd_numbers))"}
{"task_id": "HumanEval/123", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception raised for invalid input to the Collatz sequence utility.\"\"\"\n    pass\ndef get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n\n    The Collatz conjecture is a conjecture in mathematics that concerns a sequence defined\n    as follows: start with any positive integer n. Then each term is obtained from the \n    previous term as follows: if the previous term is even, the next term is one half of \n    the previous term. If the previous term is odd, the next term is 3 times the previous\n    term plus 1. The conjecture is that no matter what value of n, the sequence will always reach 1.\n\n    Note: \n        1. Collatz(1) is [1].\n        2. returned list sorted in increasing order.\n\n    For example:\n    get_odd_collatz(5) returns [1, 5] # The collatz sequence for 5 is [5, 16, 8, 4, 2, 1], so the odd numbers are only 1, and 5.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise InvalidInputError(\"Input 'n' must be a positive integer (n >= 1).\")\n\n    sequence = [n]\n    current_term = n\n    while current_term != 1:\n        if current_term % 2 == 0:\n            current_term //= 2\n        else:\n            current_term = 3 * current_term + 1\n        sequence.append(current_term)\n\n    odd_numbers = [num for num in sequence if num % 2 != 0]\n    odd_numbers.sort()\n\n    return odd_numbers"}
{"task_id": "HumanEval/123", "solution": "from typing import List, Any\ndef get_odd_collatz(n: Any) -> List[int]:\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in Collatz sequence.\n    This function validates input and calculates the sorted odd numbers from the Collatz sequence.\n    \"\"\"\n    # Input Validation (FR5, NFR2)\n    # Checks if n is a positive integer, raising ValueError if invalid.\n    if not isinstance(n, int):\n        raise ValueError(\"Input 'n' must be an integer.\")\n    if n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    # Collatz Sequence Generation (FR1, NFR1)\n    # Generates the full sequence until it reaches 1, as per Collatz rules.\n    current_n = n\n    sequence = [current_n]\n    while current_n != 1:\n        if current_n % 2 == 0:\n            current_n //= 2\n        else:\n            current_n = 3 * current_n + 1\n        sequence.append(current_n)\n    \n    # Filter Odd Numbers (FR2)\n    # Extracts all odd numbers from the generated Collatz sequence.\n    odd_numbers = [x for x in sequence if x % 2 != 0]\n\n    # Sort Odd Numbers (FR3, Business Rule)\n    # Sorts the list of odd numbers in increasing order.\n    odd_numbers.sort()\n\n    return odd_numbers"}
{"task_id": "HumanEval/124", "solution": "import re\ndef valid_date(date: str) -> bool:\n    \"\"\"Validates a date string according to 'mm-dd-yyyy' format and rules.\"\"\"\n\n    # FR1: The system shall validate that the input date string is not empty.\n    if not date or not date.strip():\n        return False\n\n    # Constants derived from the DateValidator class in the design.\n    DAYS_IN_MONTH = {\n        1: 31, 3: 31, 5: 31, 7: 31, 8: 31, 10: 31, 12: 31,\n        4: 30, 6: 30, 9: 30, 11: 30,\n        2: 29\n    }\n    DATE_FORMAT_REGEX = r\"^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])-\\\\d{4}$\"\n\n    # FR2: The system shall validate that the date string adheres to the 'mm-dd-yyyy' format.\n    match = re.match(DATE_FORMAT_REGEX, date)\n    if not match:\n        return False\n    \n    # Extract components. Regex ensures these are digits and in correct positions.\n    month_str, day_str, year_str = date.split('-')\n    month = int(month_str)\n    day = int(day_str)\n    year = int(year_str) # Parsed as per design, though not used in subsequent checks.\n\n    # FR3: The system shall validate that the month component is between 1 and 12 (inclusive).\n    if not (1 <= month <= 12):\n        return False\n\n    # FR4: The system shall validate that the day component is valid for the given month.\n    max_days = DAYS_IN_MONTH.get(month)\n    if not (1 <= day <= max_days):\n        return False\n\n    return True"}
{"task_id": "HumanEval/124", "solution": "def valid_date(date: str) -> bool:\n    \"\"\"Validates a date string against specific format and range rules.\n    Returns True if the date is valid, False otherwise.\"\"\"\n\n    if not date:\n        return False\n\n    # Constants for day validation, defined within the function.\n    MONTH_DAYS_MAP = {\n        1: 31, 3: 31, 5: 31, 7: 31, 8: 31, 10: 31, 12: 31,\n        4: 30, 6: 30, 9: 30, 11: 30,\n        2: 29\n    }\n\n    def _parse_date_components(date_str: str) -> tuple[int, int, int] | None:\n        \"\"\"Attempts to parse the mm-dd-yyyy string into integer components.\"\"\"\n        try:\n            parts = date_str.split('-')\n            if len(parts) != 3:\n                return None\n            \n            # Ensure strict \"mm-dd-yyyy\" format with correct part lengths.\n            if not (len(parts[0]) == 2 and len(parts[1]) == 2 and len(parts[2]) == 4):\n                return None\n            \n            month = int(parts[0])\n            day = int(parts[1])\n            year = int(parts[2])\n            return month, day, year\n        except ValueError:\n            return None # Handles non-integer components.\n\n    def _is_month_valid(month: int) -> bool:\n        \"\"\"Checks if the month is within the valid range [1, 12].\"\"\"\n        return 1 <= month <= 12\n\n    def _is_day_valid(day: int, month: int) -> bool:\n        \"\"\"Checks if the day is within the valid range for the given month.\"\"\"\n        if month not in MONTH_DAYS_MAP:\n            return False\n        \n        max_days = MONTH_DAYS_MAP[month]\n        return 1 <= day <= max_days\n\n    # --- Main validation logic ---\n\n    components = _parse_date_components(date)\n    if components is None:\n        return False\n\n    month, day, year = components\n\n    if not _is_month_valid(month):\n        return False\n\n    if not _is_day_valid(day, month):\n        return False\n\n    return True"}
