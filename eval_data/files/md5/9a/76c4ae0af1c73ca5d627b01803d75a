{"task_id": "HumanEval/126", "solution": "import collections\ndef is_sorted(lst):\n    \"\"\"\n    Checks if a list is sorted in ascending order with numbers appearing at most twice.\n    Raises TypeError if input is not a list, ValueError if elements are not non-negative integers.\n    \"\"\"\n    MAX_ALLOWED_OCCURRENCES = 2\n\n    if not isinstance(lst, list):\n        raise TypeError(\"Input must be a list.\")\n\n    # Validate list elements to be non-negative integers.\n    for item in lst:\n        if not isinstance(item, int) or item < 0:\n            raise ValueError(f\"List elements must be non-negative integers. Found: {item} (type: {type(item).__name__})\")\n\n    # Empty or single-element lists are considered sorted and valid.\n    if len(lst) <= 1:\n        return True\n\n    # Check for ascending order.\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    # Check for duplicate counts.\n    counts = collections.Counter(lst)\n    for count in counts.values():\n        if count > MAX_ALLOWED_OCCURRENCES:\n            return False\n\n    return True"}
{"task_id": "HumanEval/127", "solution": "import math\nfrom dataclasses import dataclass\nfrom typing import Optional\nclass IntervalService:\n    @staticmethod\n    def get_intersection_interval(interval1: Interval, interval2: Interval) -> Optional[Interval]:\n        \"\"\"Calculates the intersection of two intervals.\"\"\"\n        max_start = max(interval1.start, interval2.start)\n        min_end = min(interval1.end, interval2.end)\n\n        if max_start <= min_end:\n            return Interval(max_start, min_end)\n        return None\n\n    @staticmethod\n    def get_intersection_length(intersection_interval: Interval) -> int:\n        \"\"\"Returns the length of a given interval.\"\"\"\n        return intersection_interval.get_length()\n\n    @staticmethod\n    def is_prime(n: int) -> bool:\n        \"\"\"Determines if a given integer is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\ndef intersection(interval1, interval2):\n    \"\"\"\n    Determines whether the length of the intersection of two intervals is a prime number.\n    This function adheres to the `end - start + 1` length calculation as specified.\n    \"\"\"\n    int1 = Interval(interval1[0], interval1[1])\n    int2 = Interval(interval2[0], interval2[1])\n\n    intersection_result = IntervalService.get_intersection_interval(int1, int2)\n\n    if intersection_result is None:\n        return \"NO\"\n\n    length = IntervalService.get_intersection_length(intersection_result)\n\n    if IntervalService.is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/127", "solution": "import math\nclass PrimeCheckerService:\n    def is_prime(self, n: int) -> bool:\n        \"\"\"Determines if a non-negative integer n is prime using trial division.\"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        # Check for odd divisors up to the square root of n.\n        for i in range(3, int(math.isqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\nclass IntervalOperationsService:\n    def calculate_intersection_interval(self, interval1: tuple[int, int], interval2: tuple[int, int]) -> tuple[int, int] | None:\n        \"\"\"Calculates the intersection of two closed intervals. Returns None if no intersection.\"\"\"\n        s1, e1 = interval1\n        s2, e2 = interval2\n\n        max_start = max(s1, s2)\n        min_end = min(e1, e2)\n\n        if max_start <= min_end:\n            return (max_start, min_end)\n        else:\n            return None\n\n    def get_length(self, interval: tuple[int, int]) -> int:\n        \"\"\"Calculates the length of a given interval.\"\"\"\n        start, end = interval\n        return end - start\nclass IntersectionFacade:\n    def __init__(self, interval_ops_service: IntervalOperationsService, prime_checker_service: PrimeCheckerService):\n        \"\"\"Initializes the facade with interval operations and prime checker services.\"\"\"\n        self._interval_ops_service = interval_ops_service\n        self._prime_checker_service = prime_checker_service\n\n    def intersection(self, interval1: tuple[int, int], interval2: tuple[int, int]) -> str:\n        \"\"\"Determines if the length of the intersection of two intervals is a prime number.\"\"\"\n        intersection_interval = self._interval_ops_service.calculate_intersection_interval(interval1, interval2)\n\n        if intersection_interval is None:\n            return \"NO\"\n\n        length = self._interval_ops_service.get_length(intersection_interval)\n\n        if self._prime_checker_service.is_prime(length):\n            return \"YES\"\n        else:\n            return \"NO\"\ndef intersection(interval1: tuple[int, int], interval2: tuple[int, int]) -> str:\n    \"\"\"You are given two intervals,\n    where each interval is a pair of integers. For example, interval = (start, end) = (1, 2).\n    The given intervals are closed which means that the interval (start, end)\n    includes both start and end.\n    For each given interval, it is assumed that its start is less or equal its end.\n    Your task is to determine whether the length of intersection of these two \n    intervals is a prime number.\n    Example, the intersection of the intervals (1, 3), (2, 4) is (2, 3)\n    which its length is 1, which not a prime number.\n    If the length of the intersection is a prime number, return \"YES\",\n    otherwise, return \"NO\".\n    If the two intervals don't intersect, return \"NO\".\n\n\n    [input/output] samples:\n    intersection((1, 2), (2, 3)) ==> \"NO\"\n    intersection((-1, 1), (0, 4)) ==> \"NO\"\n    intersection((-3, -1), (-5, 5)) ==> \"YES\"\n    \"\"\"\n    interval_ops = IntervalOperationsService()\n    prime_checker = PrimeCheckerService()\n    facade = IntersectionFacade(interval_ops, prime_checker)\n    return facade.intersection(interval1, interval2)"}
{"task_id": "HumanEval/127", "solution": "from dataclasses import dataclass\nfrom typing import Tuple, Optional\nclass MathUtils:\n    \"\"\"Provides utility methods for mathematical operations.\"\"\"\n    @staticmethod\n    def is_prime(n: int) -> bool:\n        \"\"\"Determines if n is a prime number, a natural number > 1 with no positive divisors other than 1 and itself.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\nclass IntervalService:\n    \"\"\"Encapsulates core business logic for interval operations.\"\"\"\n\n    def _calculate_raw_intersection(self, interval1: Interval, interval2: Interval) -> Optional[Interval]:\n        \"\"\"Calculates the intersection of two Interval objects, returning None if they don't overlap.\"\"\"\n        max_start = max(interval1.start, interval2.start)\n        min_end = min(interval1.end, interval2.end)\n\n        if max_start > min_end:\n            return None\n        return Interval(max_start, min_end)\n\n    def get_length(self, interval: Interval) -> int:\n        \"\"\"Calculates the length of an Interval as 'end - start'.\"\"\"\n        return interval.end - interval.start\n\n    def is_intersection_length_prime(self, interval1: Interval, interval2: Interval) -> str:\n        \"\"\"Checks if the length of the intersection of two intervals is prime, returning \"YES\" or \"NO\".\"\"\"\n        intersection_interval = self._calculate_raw_intersection(interval1, interval2)\n\n        if intersection_interval is None:\n            return \"NO\"\n\n        length = self.get_length(intersection_interval)\n        if MathUtils.is_prime(length):\n            return \"YES\"\n        else:\n            return \"NO\"\ndef intersection(interval1: Tuple[int, int], interval2: Tuple[int, int]) -> str:\n    \"\"\"\n    Determines whether the length of the intersection of two closed intervals is a prime number.\n    Returns \"YES\" if the length is prime, \"NO\" otherwise or if intervals don't intersect.\n    \"\"\"\n    interval1_obj = Interval(interval1[0], interval1[1])\n    interval2_obj = Interval(interval2[0], interval2[1])\n\n    service = IntervalService()\n    return service.is_intersection_length_prime(interval1_obj, interval2_obj)"}
