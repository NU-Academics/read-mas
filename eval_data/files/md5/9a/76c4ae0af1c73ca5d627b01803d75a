{"task_id": "HumanEval/67", "solution": "import re\nfrom dataclasses import dataclass\nclass FruitParser:\n    \"\"\"\n    Parses a string to extract apple and orange counts.\n    \"\"\"\n    FRUIT_STRING_PATTERN = r\"(\\d+)\\s*apples\\s*and\\s*(\\d+)\\s*oranges\"\n\n    def parse_fruit_string(self, s: str) -> FruitCounts:\n        \"\"\"\n        Parses the given string to find apple and orange counts.\n        Returns a FruitCounts object, or raises ValueError if format is invalid.\n        \"\"\"\n        match = re.fullmatch(self.FRUIT_STRING_PATTERN, s)\n        if not match:\n            raise ValueError(f\"Invalid fruit string format: '{s}'. Expected 'X apples and Y oranges'.\")\n\n        apples = int(match.group(1))\n        oranges = int(match.group(2))\n\n        return FruitCounts(apples=apples, oranges=oranges)\nclass FruitCalculator:\n    \"\"\"\n    Calculates the number of mango fruits based on total fruits and parsed apple/orange counts.\n    It orchestrates parsing and checks for data consistency.\n    \"\"\"\n    def __init__(self, parser: FruitParser):\n        self._parser = parser\n\n    def calculate_mangoes(self, fruit_string: str, total_fruits: int) -> int:\n        \"\"\"\n        Calculates the number of mangoes in a basket.\n        Raises ValueError for invalid string format or inconsistent total fruit count.\n        \"\"\"\n        fruit_counts: FruitCounts = self._parser.parse_fruit_string(fruit_string)\n\n        total_known_fruits = fruit_counts.apples + fruit_counts.oranges\n\n        if total_fruits < total_known_fruits:\n            raise ValueError(\n                f\"Total fruits ({total_fruits}) cannot be less than the sum of apples \"\n                f\"({fruit_counts.apples}) and oranges ({fruit_counts.oranges}).\"\n            )\n\n        mango_count = total_fruits - total_known_fruits\n        return mango_count\n_fruit_parser_instance = FruitParser()\n_fruit_calculator_instance = FruitCalculator(parser=_fruit_parser_instance)\ndef fruit_distribution(s: str, n: int) -> int:\n    \"\"\"\n    Calculates the number of mango fruits in a basket given the total number of fruits.\n    It parses apple and orange counts from a string and subtracts them from the total.\n    \"\"\"\n    return _fruit_calculator_instance.calculate_mangoes(s, n)"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even-valued node and its index in an array.\n    Returns `[value, index]` or `[]` if no even values or the array is empty.\n    \"\"\"\n    if not arr:\n        return []\n\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for i, value in enumerate(arr):\n        if value % 2 == 0:  # Check if the value is even.\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = i\n            elif value == smallest_even_value and i < smallest_even_index:\n                # If same smallest even value, choose the one with the smallest index.\n                smallest_even_index = i\n\n    if smallest_even_index == -1:\n        return []  # No even values found in the array.\n    else:\n        return [smallest_even_value, smallest_even_index]"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even node in an array. Returns `[value, index]` or `[]` if no even values or the array is empty,\n    prioritizing the smallest index for duplicate smallest even values.\n    \"\"\"\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for i, value in enumerate(arr):\n        if value % 2 == 0:\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = i\n            # If value == smallest_even_value, we keep the earlier index, which is already stored.\n\n    if smallest_even_index != -1:\n        return [smallest_even_value, smallest_even_index]\n    else:\n        return []"}
{"task_id": "HumanEval/67", "solution": "import re\nfrom dataclasses import dataclass\nclass InvalidFruitStringError(ValueError):\n    \"\"\"Raised when the fruit description string is malformed.\"\"\"\n    pass\nclass InvalidFruitCountError(ValueError):\n    \"\"\"Raised when fruit counts are logically inconsistent.\"\"\"\n    pass\nclass FruitStringParser:\n    \"\"\"Parses input strings to extract apple and orange counts using a regex pattern.\"\"\"\n    FRUIT_PATTERN = r\"(\\d+)\\s*apples\\s*and\\s*(\\d+)\\s*oranges\"\n\n    def parse(self, fruit_string: str) -> FruitCounts:\n        \"\"\"Extracts apple and orange counts from the string, raising an error if the format is invalid.\"\"\"\n        match = re.fullmatch(self.FRUIT_PATTERN, fruit_string)\n        if not match:\n            raise InvalidFruitStringError(\n                f\"Malformed fruit string: '{fruit_string}'. Expected format: 'X apples and Y oranges'.\"\n            )\n        apples = int(match.group(1))\n        oranges = int(match.group(2))\n        return FruitCounts(apples=apples, oranges=oranges)\nclass FruitCalculatorService:\n    \"\"\"Orchestrates fruit string parsing and calculates mango fruits.\"\"\"\n    def __init__(self, parser: FruitStringParser):\n        \"\"\"Initializes the service with a parser dependency.\"\"\"\n        self._parser = parser\n\n    def fruit_distribution(self, s: str, n: int) -> int:\n        \"\"\"Calculates mango fruits from the fruit description string and total fruit count.\"\"\"\n        if n < 0:\n            raise InvalidFruitCountError(\"Total fruits 'n' cannot be negative.\")\n\n        fruit_counts: FruitCounts = self._parser.parse(s)\n\n        total_apples_oranges = fruit_counts.apples + fruit_counts.oranges\n\n        if fruit_counts.apples < 0 or fruit_counts.oranges < 0:\n            raise InvalidFruitCountError(\"Apple or orange counts cannot be negative.\")\n\n        if total_apples_oranges > n:\n            raise InvalidFruitCountError(\n                f\"Total apples ({fruit_counts.apples}) and oranges ({fruit_counts.oranges}) \"\n                f\"exceeds total fruits ({n}).\"\n            )\n\n        return n - total_apples_oranges\ndef fruit_distribution(s,n):\n    \"\"\"\n    Calculates the number of mango fruits in a basket given a string of apple/orange counts and total fruits.\n    It parses the input string, validates counts, and computes mangoes.\n    \"\"\"\n    parser = FruitStringParser()\n    calculator_service = FruitCalculatorService(parser)\n    return calculator_service.fruit_distribution(s, n)"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even-valued node and its index.\n    If no even values or the array is empty, returns an empty list.\n    \"\"\"\n    best_value = None\n    best_index = None\n\n    for i, node in enumerate(arr):\n        if node % 2 == 0:\n            if best_value is None or node < best_value:\n                # Found a new smallest even value.\n                best_value = node\n                best_index = i\n            elif node == best_value and i < best_index:\n                # Found the same smallest even value but at an earlier index.\n                best_index = i\n\n    if best_value is None:\n        return []\n    else:\n        return [best_value, best_index]"}
