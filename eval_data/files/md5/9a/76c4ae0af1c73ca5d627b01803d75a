{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n\n    Example\n        For N = 1000, the sum of digits will be 1 the output should be \"1\".\n        For N = 150, the sum of digits will be 6 the output should be \"110\".\n        For N = 147, the sum of digits will be 12 the output should be \"1100\".\n\n    Variables:\n        @N integer\n             Constraints: 0 \u2264 N \u2264 10000.\n    Output:\n         a string of binary number\n    \"\"\"\n    # Validate input N against specified constraints.\n    if not isinstance(N, int) or not (0 <= N <= 10000):\n        raise ValueError(\"Input N must be an integer within the range [0, 10000].\")\n\n    # Calculate the sum of decimal digits for N.\n    digit_sum = 0\n    for digit_char in str(N):\n        digit_sum += int(digit_char)\n\n    # Convert the calculated digit sum to its binary string representation.\n    if digit_sum == 0:\n        return \"0\"\n    return bin(digit_sum)[2:]"}
{"task_id": "HumanEval/84", "solution": "def solve(N: int) -> str:\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n\n    Example\n        For N = 1000, the sum of digits will be 1 the output should be \"1\".\n        For N = 150, the sum of digits will be 6 the output should be \"110\".\n        For N = 147, the sum of digits will be 12 the output should be \"1100\".\n\n    Variables:\n        @N integer\n             Constraints: 0 \u2264 N \u2264 10000.\n    Output:\n         a string of binary number\n    \"\"\"\n\n    # Calculate the sum of the decimal digits of N.\n    digit_sum = 0\n    temp_N = N\n    while temp_N > 0:\n        digit_sum += temp_N % 10\n        temp_N //= 10\n\n    # Convert the calculated digit sum into its binary string representation.\n    # Python's bin() function includes a \"0b\" prefix, which is stripped for the final output.\n    return bin(digit_sum)[2:]"}
{"task_id": "HumanEval/84", "solution": "def solve(N: int) -> str:\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    Constraints: 0 \u2264 N \u2264 10000.\n    \"\"\"\n    MIN_N = 0\n    MAX_N = 10000\n\n    # Validate input N (FR1).\n    if not isinstance(N, int):\n        raise ValueError(f\"Input N must be an integer, but got type {type(N).__name__}.\")\n    if not (MIN_N <= N <= MAX_N):\n        raise ValueError(f\"Input N must be between {MIN_N} and {MAX_N} (inclusive), but got {N}.\")\n\n    # Calculate the sum of N's decimal digits (FR2).\n    digit_sum = sum(int(digit) for digit in str(N))\n\n    # Convert the calculated sum into its binary string representation (FR3).\n    if digit_sum == 0:\n        binary_sum_string = \"0\"\n    else:\n        binary_sum_string = bin(digit_sum)[2:]  # Remove the \"0b\" prefix.\n\n    # Return the binary string (FR4).\n    return binary_sum_string"}
{"task_id": "HumanEval/84", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input values.\n    This is defined here to satisfy the specification's error handling requirements within a single output block.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    Constraints: 0 <= N <= 10000.\n    \"\"\"\n    # Validate N against type and range constraints.\n    if not isinstance(N, int):\n        raise InvalidInputError(f\"Input N must be an integer, got {type(N).__name__}.\")\n    if not (0 <= N <= 10000):\n        raise InvalidInputError(f\"Input N must be between 0 and 10000, got {N}.\")\n\n    # Calculate the sum of decimal digits of N.\n    sum_of_digits = 0\n    for digit_char in str(N):\n        sum_of_digits += int(digit_char)\n\n    # Convert the sum of digits to its binary string representation.\n    if sum_of_digits == 0:\n        return \"0\"\n\n    binary_digits = []\n    temp_value = sum_of_digits\n    while temp_value > 0:\n        binary_digits.append(str(temp_value % 2))\n        temp_value //= 2\n    \n    return \"\".join(reversed(binary_digits))"}
{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    \n    Example\n        For N = 1000, the sum of digits will be 1 the output should be \"1\".\n        For N = 150, the sum of digits will be 6 the output should be \"110\".\n        For N = 147, the sum of digits will be 12 the output should be \"1100\".\n    \n    Variables:\n        @N integer\n             Constraints: 0 \u2264 N \u2264 10000.\n    Output:\n         a string of binary number\n    \"\"\"\n    MIN_N = 0\n    MAX_N = 10000\n\n    # Input validation\n    if not isinstance(N, int):\n        raise ValueError(f\"Input N must be an integer, but got type {type(N).__name__}.\")\n    if not (MIN_N <= N <= MAX_N):\n        raise ValueError(f\"Input N must be between {MIN_N} and {MAX_N}, but got {N}.\")\n\n    # Calculate the sum of decimal digits\n    decimal_sum = 0\n    for digit_char in str(N):\n        decimal_sum += int(digit_char)\n\n    # Convert the sum to its binary string representation\n    binary_string = bin(decimal_sum)[2:]\n    \n    return binary_string"}
{"task_id": "HumanEval/84", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input values.\"\"\"\n    pass\nclass BinaryConverter:\n    \"\"\"Utility class for converting integers to binary strings.\n    It handles non-negative integer conversion and raises an error for negative inputs.\"\"\"\n\n    def to_binary_string(self, value: int) -> str:\n        \"\"\"Converts a non-negative integer to its binary string representation.\n        Raises InvalidInputError if the value is not an integer or is negative.\"\"\"\n        if not isinstance(value, int):\n            raise InvalidInputError(\"Input must be an integer.\")\n        if value < 0:\n            raise InvalidInputError(\"Cannot convert negative integer to binary string.\")\n        return bin(value)[2:] if value > 0 else \"0\"\nclass DigitSumBinaryService:\n    \"\"\"Service for calculating the sum of decimal digits and converting it to binary.\n    It orchestrates the digit sum calculation, input validation, and binary conversion.\"\"\"\n    MIN_N = 0\n    MAX_N = 10000\n\n    def __init__(self, binary_converter: BinaryConverter):\n        \"\"\"Initializes the service with a BinaryConverter instance.\"\"\"\n        self._binary_converter = binary_converter\n\n    def _validate_input(self, n: int) -> None:\n        \"\"\"Validates if the input N is within the allowed range [MIN_N, MAX_N].\n        Raises InvalidInputError if N is not an integer or is out of bounds.\"\"\"\n        if not isinstance(n, int):\n            raise InvalidInputError(\"Input N must be an integer.\")\n        if not (self.MIN_N <= n <= self.MAX_N):\n            raise InvalidInputError(f\"Input N must be between {self.MIN_N} and {self.MAX_N} (inclusive).\")\n\n    def _sum_decimal_digits(self, n: int) -> int:\n        \"\"\"Calculates the sum of the decimal digits of a given integer.\n        It handles N=0 explicitly and processes digits using modulo and floor division.\"\"\"\n        total_sum = 0\n        if n == 0:\n            return 0\n        \n        temp_n = n \n        while temp_n > 0:\n            total_sum += temp_n % 10\n            temp_n //= 10\n        return total_sum\n\n    def calculate_binary_digit_sum(self, n: int) -> str:\n        \"\"\"Calculates the sum of digits of N and returns its binary string.\n        It first validates N, sums its digits, then converts the sum to binary.\"\"\"\n        self._validate_input(n)\n        digit_sum = self._sum_decimal_digits(n)\n        binary_string = self._binary_converter.to_binary_string(digit_sum)\n        return binary_string\n_binary_converter_instance = BinaryConverter()\n_digit_sum_binary_service_instance = DigitSumBinaryService(_binary_converter_instance)\ndef solve(N: int) -> str:\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    N must be between 0 and 10000 inclusive; otherwise, an InvalidInputError is raised.\"\"\"\n    try:\n        return _digit_sum_binary_service_instance.calculate_binary_digit_sum(N)\n    except InvalidInputError as e:\n        raise e \n    except Exception as e:\n        raise RuntimeError(f\"An unexpected error occurred: {e}\") from e"}
