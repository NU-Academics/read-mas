{"task_id": "HumanEval/110", "solution": "def exchange(lst1, lst2):\n    \"\"\"\n    Determines if it is possible to exchange elements between lst1 and lst2\n    to make lst1 a list of only even numbers. Returns \"YES\" or \"NO\".\n    \"\"\"\n\n    # Counts the number of even integers in a list.\n    def _count_even_numbers(lst):\n        count = 0\n        for num in lst:\n            if num % 2 == 0:\n                count += 1\n        return count\n\n    required_evens = len(lst1)\n    \n    evens_in_lst1 = _count_even_numbers(lst1)\n    evens_in_lst2 = _count_even_numbers(lst2)\n    \n    total_available_evens = evens_in_lst1 + evens_in_lst2\n    \n    if total_available_evens >= required_evens:\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/110", "solution": "def exchange(lst1, lst2):\n    \"\"\"In this problem, you will implement a function that takes two lists of numbers,\n    and determines whether it is possible to perform an exchange of elements\n    between them to make lst1 a list of only even numbers.\n    There is no limit on the number of exchanged elements between lst1 and lst2.\n    If it is possible to exchange elements between the lst1 and lst2 to make\n    all the elements of lst1 to be even, return \"YES\".\n    Otherwise, return \"NO\".\n    For example:\n    exchange([1, 2, 3, 4], [1, 2, 3, 4]) => \"YES\"\n    exchange([1, 2, 3, 4], [1, 5, 3, 4]) => \"NO\"\n    It is assumed that the input lists will be non-empty.\n    \"\"\"\n    odd_count_lst1 = 0\n    for num in lst1:\n        if num % 2 != 0:\n            odd_count_lst1 += 1\n\n    even_count_lst2 = 0\n    for num in lst2:\n        if num % 2 == 0:\n            even_count_lst2 += 1\n\n    if even_count_lst2 >= odd_count_lst1:\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/111", "solution": "from collections import Counter\nfrom typing import Dict\ndef histogram(test: str) -> Dict[str, int]:\n    \"\"\"Given a string of space-separated lowercase letters, returns a dictionary\n    of the most frequent letters and their counts. Handles multiple letters with the same highest frequency.\n    \"\"\"\n    if not test.strip():\n        return {}\n\n    # Count occurrences of valid lowercase letters\n    tokens = [\n        token for token in test.split(' ')\n        if len(token) == 1 and 'a' <= token <= 'z'\n    ]\n    letter_counts = dict(Counter(tokens))\n\n    if not letter_counts:\n        return {}\n\n    # Find the maximum frequency among all letters\n    max_frequency = max(letter_counts.values())\n\n    # Filter letters to include only those with the maximum frequency\n    result = {\n        letter: count\n        for letter, count in letter_counts.items()\n        if count == max_frequency\n    }\n\n    return result"}
{"task_id": "HumanEval/110", "solution": "from typing import List\ndef exchange(lst1: List[int], lst2: List[int]) -> str:\n    \"\"\"Determines if it's possible to make lst1 contain only even numbers by exchanging elements with lst2.\n    Returns 'YES' if possible, 'NO' otherwise.\n    \"\"\"\n    # Count odd numbers in lst1.\n    odds_in_lst1 = sum(1 for x in lst1 if x % 2 != 0)\n\n    # Count even numbers in lst2.\n    evens_in_lst2 = sum(1 for x in lst2 if x % 2 == 0)\n\n    # If lst1 is already all even, no exchanges are needed.\n    if odds_in_lst1 == 0:\n        return \"YES\"\n\n    # Check if there are enough even numbers in lst2 to replace all odd numbers in lst1.\n    if evens_in_lst2 >= odds_in_lst1:\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/111", "solution": "from collections import Counter\ndef histogram(test):\n    \"\"\"Calculates the frequency of lowercase letters in the input string, returning a dictionary of letters with their maximum occurrence count. Returns an empty dictionary if no valid letters are found.\"\"\"\n    if not test.strip():\n        return {}\n\n    # Split the string and filter for valid single lowercase alphabetic characters.\n    letters = [char for char in test.split(' ') if char.isalpha() and char.islower()]\n\n    if not letters:\n        return {}\n\n    # Count occurrences of each valid letter.\n    counts = Counter(letters)\n\n    # Determine the maximum occurrence count.\n    max_count = 0\n    if counts:\n        max_count = max(counts.values())\n\n    # Filter to include only letters that achieve the maximum occurrence.\n    result = {letter: count for letter, count in counts.items() if count == max_count}\n\n    return result"}
