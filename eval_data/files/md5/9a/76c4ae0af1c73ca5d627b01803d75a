{"task_id": "HumanEval/78", "solution": "from typing import Set\nclass HexConverter:\n    \"\"\"Utility to convert hexadecimal characters to their decimal equivalents.\n    Assumes input is a valid uppercase hex character (0-9, A-F).\"\"\"\n    def hex_char_to_decimal(self, hex_char: str) -> int:\n        return int(hex_char, 16)\nclass PrimeChecker:\n    \"\"\"Utility to check if a decimal value corresponds to a prime hexadecimal digit.\n    The set of prime hexadecimal digits (2, 3, 5, 7, B, D) is pre-defined.\"\"\"\n    _PRIME_HEX_DECIMALS: Set[int] = {2, 3, 5, 7, 11, 13}\n\n    def is_prime_hex_decimal(self, decimal_value: int) -> bool:\n        return decimal_value in self._PRIME_HEX_DECIMALS\nclass HexKeyCounterService:\n    \"\"\"Service to count the number of prime hexadecimal digits in a given string.\n    It orchestrates HexConverter and PrimeChecker to perform the counting.\"\"\"\n    def __init__(self, hex_converter: HexConverter, prime_checker: PrimeChecker):\n        self.hex_converter = hex_converter\n        self.prime_checker = prime_checker\n\n    def count_prime_hex_digits(self, hex_string: str) -> int:\n        \"\"\"Counts the number of hexadecimal digits that are primes (2, 3, 5, 7, B, D).\n        Assumes the input string is always correct or empty, and A-F are uppercase.\"\"\"\n        prime_count = 0\n        for char in hex_string:\n            decimal_value = self.hex_converter.hex_char_to_decimal(char)\n            if self.prime_checker.is_prime_hex_decimal(decimal_value):\n                prime_count += 1\n        return prime_count\ndef hex_key(num: str) -> int:\n    \"\"\"Counts prime hexadecimal digits (2, 3, 5, 7, B, D) in a hexadecimal string.\n    Input 'num' is assumed to be correct or an empty string, with A-F uppercase.\"\"\"\n    converter = HexConverter()\n    checker = PrimeChecker()\n    service = HexKeyCounterService(converter, checker)\n    return service.count_prime_hex_digits(num)"}
