{"task_id": "HumanEval/108", "solution": "from typing import List\ndef _sum_digits(num: int) -> int:\n    \"\"\"\n    Calculates the sum of digits, treating the first digit of a negative number as negative.\n    For example, -123 has signed digits -1, 2, and 3, summing to 4.\n    \"\"\"\n    if num == 0:\n        return 0\n\n    s_num = str(abs(num))\n    digit_sum = 0\n\n    if num < 0:\n        # The first digit of a negative number is treated as negative.\n        digit_sum += -int(s_num[0])\n        for digit_char in s_num[1:]:\n            digit_sum += int(digit_char)\n    else:\n        # All digits are positive for non-negative numbers.\n        for digit_char in s_num:\n            digit_sum += int(digit_char)\n    return digit_sum\ndef count_nums(arr: List[int]) -> int:\n    \"\"\"\n    Counts numbers in an array whose sum of digits (as defined by _sum_digits) is strictly positive.\n    This function processes each integer in the input list `arr`.\n    \"\"\"\n    count = 0\n    for num in arr:\n        if _sum_digits(num) > 0:\n            count += 1\n    return count"}
{"task_id": "HumanEval/108", "solution": "def count_nums(arr):\n    \"\"\"\n    Write a function count_nums which takes an array of integers and returns\n    the number of elements which has a sum of digits > 0.\n    If a number is negative, then its first signed digit will be negative:\n    e.g. -123 has signed digits -1, 2, and 3.\n    >>> count_nums([]) == 0\n    >>> count_nums([-1, 11, -11]) == 1\n    >>> count_nums([1, 1, 2]) == 3\n    \"\"\"\n    def _calculate_sum_of_digits(num):\n        \"\"\"Calculates the sum of digits for an integer, treating the first digit of negative numbers as negative.\n        For example, -123 has signed digits -1, 2, and 3, summing to 4.\"\"\"\n        s_num = str(num)\n        total_sum = 0\n\n        if num < 0:\n            # For negative numbers, the digit immediately after the '-' sign is parsed as negative.\n            # E.g., for -123, s_num[1] is '1', so -int('1') is -1.\n            total_sum += -int(s_num[1])\n            # The remaining digits (from index 2 onwards) are added as positive values.\n            # E.g., for -123, s_num[2:] is '23', so 2 and 3 are added.\n            for digit_char in s_num[2:]:\n                total_sum += int(digit_char)\n        else:\n            # For non-negative numbers, all digits contribute positively to the sum.\n            for digit_char in s_num:\n                total_sum += int(digit_char)\n        return total_sum\n\n    count = 0\n    for num in arr:\n        if _calculate_sum_of_digits(num) > 0:\n            count += 1\n    return count"}
{"task_id": "HumanEval/109", "solution": "from typing import List\ndef move_one_ball(arr: List[int]) -> bool:\n    \"\"\"\n    Determines if an array can be sorted by zero or more right shift operations.\n    Returns True if sortable, False otherwise.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return True\n\n    sorted_arr = sorted(arr) # The target non-decreasing order.\n    current_arr = list(arr) # A mutable copy to perform shifts on.\n\n    # Iterate up to N times, checking each possible shifted state.\n    for _ in range(n):\n        if current_arr == sorted_arr: # Check if the current arrangement is sorted.\n            return True\n        # Perform one right shift: move the last element to the first position.\n        current_arr = [current_arr[-1]] + current_arr[:-1]\n\n    return False"}
