{"task_id": "HumanEval/81", "solution": "from typing import List\nclass InvalidGPAError(ValueError):\n    \"\"\"Custom exception for invalid GPA values.\"\"\"\n_GRADE_SCALE_STRICT = [\n    (3.7, \"A\"),\n    (3.3, \"A-\"),\n    (3.0, \"B+\"),\n    (2.7, \"B\"),\n    (2.3, \"B-\"),\n    (2.0, \"C+\"),\n    (1.7, \"C\"),\n    (1.3, \"C-\"),\n    (1.0, \"D+\"),\n    (0.7, \"D\"),\n    (0.0, \"D-\"),\n]\ndef numerical_letter_grade(grades: List[float]) -> List[str]:\n    \"\"\"Converts a list of numerical GPAs to letter grades using a predefined scale.\n    Raises InvalidGPAError if any GPA in the list is negative.\"\"\"\n\n    def _convert_single_gpa(gpa: float) -> str:\n        \"\"\"Converts a single GPA to its letter grade based on the strict scale.\"\"\"\n        if gpa < 0.0:\n            raise InvalidGPAError(f\"GPA cannot be negative. Received: {gpa}\")\n        elif gpa == 4.0:\n            return \"A+\"\n        \n        for threshold, letter_grade in _GRADE_SCALE_STRICT:\n            if gpa > threshold:\n                return letter_grade\n        \n        # If no 'gpa > threshold' rule matched, and gpa is not negative, it must be 0.0.\n        return \"E\" \n\n    converted_grades = []\n    for gpa_score in grades:\n        converted_grades.append(_convert_single_gpa(gpa_score))\n    \n    return converted_grades"}
{"task_id": "HumanEval/82", "solution": "import math\ndef prime_length(string):\n    \"\"\"Write a function that takes a string and returns True if the string\n    length is a prime number or False otherwise\n    Examples\n    prime_length('Hello') == True\n    prime_length('abcdcba') == True\n    prime_length('kittens') == True\n    prime_length('orange') == False\n    \"\"\"\n    def is_prime(n: int) -> bool:\n        \"\"\"\n        Helper function to check if an integer is a prime number.\n        \"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        # Iterate from 3 up to the square root of n (inclusive), incrementing by 2\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\n\n    if not isinstance(string, str):\n        raise TypeError(\"Input must be a string.\")\n    \n    length = len(string)\n    return is_prime(length)"}
