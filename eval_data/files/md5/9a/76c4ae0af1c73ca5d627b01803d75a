{"task_id": "HumanEval/4", "solution": "from typing import List\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\"Calculates the Mean Absolute Deviation (MAD) for a list of numbers.\n    MAD is the average absolute difference between each element and the mean of the dataset.\n    \"\"\"\n    if not numbers:\n        raise ValueError(\"Cannot calculate Mean Absolute Deviation of an empty list.\")\n\n    mean = sum(numbers) / len(numbers)\n    absolute_differences = [abs(x - mean) for x in numbers]\n    return sum(absolute_differences) / len(absolute_differences)"}
{"task_id": "HumanEval/3", "solution": "from typing import List\nclass InvalidOperationError(ValueError):\n    \"\"\"Custom exception raised for invalid bank operation types.\"\"\"\n    pass\nINITIAL_BALANCE = 0\nclass BalanceAnalyzerService:\n    \"\"\"\n    Service responsible for analyzing a sequence of bank operations\n    to detect if the balance ever falls below zero.\n    \"\"\"\n    def __init__(self) -> None:\n        self._current_balance: int = INITIAL_BALANCE\n\n    def _process_operation(self, amount: int) -> None:\n        \"\"\"\n        Updates the current balance with a single operation amount.\n        Raises InvalidOperationError if the amount is not an integer.\n        \"\"\"\n        if not isinstance(amount, int):\n            raise InvalidOperationError(f\"Operation amount must be an integer, got {type(amount).__name__}\")\n        self._current_balance += amount\n\n    def analyze_operations(self, operations: List[int]) -> bool:\n        \"\"\"\n        Processes a list of bank operations, returning True if balance\n        falls below zero, False otherwise.\n        \"\"\"\n        for operation in operations:\n            self._process_operation(operation)\n            if self._current_balance < 0:\n                return True\n        return False\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\" You're given a list of deposit and withdrawal operations on a bank account that starts with\n    zero balance. Your task is to detect if at any point the balance of account fallls below zero, and\n    at that point function should return True. Otherwise it should return False.\n    >>> below_zero([1, 2, 3])\n    False\n    >>> below_zero([1, 2, -4, 5])\n    True\n    \"\"\"\n    analyzer = BalanceAnalyzerService()\n    return analyzer.analyze_operations(operations)"}
{"task_id": "HumanEval/4", "solution": "from typing import List\nfrom dataclasses import dataclass\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input data.\"\"\"\n    pass\nclass MathUtils:\n    \"\"\"Provides static utility methods for common mathematical calculations.\"\"\"\n    @staticmethod\n    def calculate_mean(numbers: List[float]) -> float:\n        \"\"\"Calculates the arithmetic mean of a list of floating-point numbers.\n        Raises InvalidInputError if the list is empty.\"\"\"\n        if not numbers:\n            raise InvalidInputError(\"Cannot calculate mean of an empty list.\")\n        return sum(numbers) / len(numbers)\nclass MADService:\n    \"\"\"Service responsible for calculating the Mean Absolute Deviation.\"\"\"\n    def __init__(self, math_utils: MathUtils):\n        self._math_utils = math_utils\n\n    def calculate_mad(self, numbers: List[float]) -> MADResult:\n        \"\"\"Calculates the Mean Absolute Deviation for the given list of numbers.\n        Returns 0.0 for an empty list as per business rule.\"\"\"\n        if not numbers:\n            return MADResult(0.0)\n\n        mean_value = self._math_utils.calculate_mean(numbers)\n        absolute_differences = [abs(x - mean_value) for x in numbers]\n        mad_value = sum(absolute_differences) / len(numbers)\n        return MADResult(mad_value)\n_math_utils_instance = MathUtils()\n_mad_service_instance = MADService(math_utils=_math_utils_instance)\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\"For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset. MAD is the average absolute difference\n    between each element and the mean.\"\"\"\n    mad_result = _mad_service_instance.calculate_mad(numbers)\n    return mad_result.value"}
{"task_id": "HumanEval/4", "solution": "from typing import List\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    if not numbers:\n        raise ValueError(\"Input list cannot be empty for Mean Absolute Deviation calculation.\")\n\n    mean = sum(numbers) / len(numbers)\n    absolute_differences_sum = sum(abs(x - mean) for x in numbers)\n    mad = absolute_differences_sum / len(numbers)\n    return mad"}
{"task_id": "HumanEval/4", "solution": "from typing import List\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case).\n    \"\"\"\n    if not numbers:\n        raise ValueError(\"Input list cannot be empty to calculate MAD.\")\n\n    # Calculate the arithmetic mean of the numbers.\n    data_mean = sum(numbers) / len(numbers)\n\n    # Calculate the absolute differences from the mean for each number.\n    absolute_differences = [abs(x - data_mean) for x in numbers]\n\n    # Calculate the average of these absolute differences (MAD).\n    mad_value = sum(absolute_differences) / len(absolute_differences)\n\n    return mad_value"}
