{"task_id": "HumanEval/99", "solution": "import math\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid numeric input.\n    It provides a specific error message for clarity.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef closest_integer(value: str) -> int:\n    \"\"\"\n    Converts a string to its closest integer, with special rounding for equidistant numbers.\n    If equidistant, it rounds away from zero.\n    \"\"\"\n    try:\n        f_val = float(value)\n    except ValueError:\n        raise InvalidInputError(f\"Invalid numeric input: '{value}'\")\n\n    floor_val = math.floor(f_val)\n    ceil_val = math.ceil(f_val)\n\n    dist_to_floor = abs(f_val - floor_val)\n    dist_to_ceil = abs(f_val - ceil_val)\n\n    if dist_to_floor < dist_to_ceil:\n        return int(floor_val)\n    elif dist_to_ceil < dist_to_floor:\n        return int(ceil_val)\n    else:  # Equidistant (fractional part is 0.5)\n        if f_val >= 0:\n            return int(ceil_val)  # Round away from zero for non-negative\n        else:\n            return int(floor_val) # Round away from zero for negative"}
