{"task_id": "HumanEval/55", "solution": "def fib(n: int) -> int:\n    \"\"\"Return the n-th Fibonacci number.\n    This function handles input validation and calculates Fibonacci numbers iteratively for efficiency.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    \n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n    \n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n    \n    a, b = 0, 1\n    for _ in range(2, n + 1):\n        a, b = b, a + b\n    \n    return b"}
{"task_id": "HumanEval/55", "solution": "from typing import Dict\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input to the fibonacci function.\"\"\"\n    pass\nclass FibonacciCalculator:\n    \"\"\"Calculates Fibonacci numbers using an iterative approach with memoization.\"\"\"\n    def __init__(self) -> None:\n        self._memo: Dict[int, int] = {0: 0, 1: 1}\n\n    def calculate(self, n: int) -> int:\n        \"\"\"Calculates the n-th Fibonacci number. Assumes n is a non-negative integer.\"\"\"\n        if n in self._memo:\n            return self._memo[n]\n\n        # Calculate iteratively and store intermediate results.\n        a, b = self._memo[0], self._memo[1]\n        for i in range(2, n + 1):\n            if i not in self._memo:\n                next_fib = a + b\n                self._memo[i] = next_fib\n                a, b = b, next_fib\n            else:\n                # If already memoized, update 'a' and 'b' to continue from the correct point.\n                a, b = self._memo[i-1], self._memo[i]\n        return self._memo[n]\n_calculator = FibonacciCalculator()\ndef fib(n: int) -> int:\n    \"\"\"Calculates the n-th Fibonacci number. Raises InvalidInputError for invalid input.\"\"\"\n    if not isinstance(n, int):\n        raise InvalidInputError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise InvalidInputError(\"Input 'n' must be a non-negative integer.\")\n\n    return _calculator.calculate(n)"}
{"task_id": "HumanEval/55", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef fib(n: int) -> int:\n    \"\"\"Return n-th Fibonacci number.\n    This function computes the n-th Fibonacci number based on the sequence F(1)=1, F(2)=1.\n    \"\"\"\n    MIN_FIB_N = 1\n\n    if not isinstance(n, int) or n < MIN_FIB_N:\n        raise InvalidInputError(f\"Input 'n' must be a positive integer (>= {MIN_FIB_N}). Received: {n}\")\n\n    if n == 1 or n == 2:\n        return 1\n\n    a, b = 1, 1\n    for _ in range(3, n + 1):\n        a, b = b, a + b\n    return b"}
{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str) -> bool:\n    \"\"\"Checks if a string of '<' and '>' has correctly matched and ordered brackets. Other characters are ignored.\"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '<':\n            balance += 1\n        elif char == '>':\n            balance -= 1\n            if balance < 0:\n                return False\n    return balance == 0"}
{"task_id": "HumanEval/56", "solution": "class BracketValidator:\n    OPENING_BRACKET = '<'\n    CLOSING_BRACKET = '>'\n\n    @staticmethod\n    def _check_input_characters(brackets: str) -> None:\n        \"\"\"Raises ValueError if the string contains invalid characters.\n        It checks each character against the allowed bracket types.\"\"\"\n        for char in brackets:\n            if char not in (BracketValidator.OPENING_BRACKET, BracketValidator.CLOSING_BRACKET):\n                raise ValueError(f\"Invalid character '{char}' found in bracket string. Only '<' and '>' are allowed.\")\n\n    @staticmethod\n    def validate(brackets: str) -> bool:\n        \"\"\"\n        Determines if the given string of angle brackets is correctly balanced.\n        It uses a stack-based approach to match opening and closing brackets.\n        \"\"\"\n        BracketValidator._check_input_characters(brackets)\n\n        stack = []\n        for char in brackets:\n            if char == BracketValidator.OPENING_BRACKET:\n                stack.append(char)\n            elif char == BracketValidator.CLOSING_BRACKET:\n                if not stack:\n                    return False  # Closing bracket without an opening one.\n                stack.pop()  # Pop the corresponding opening bracket.\n        \n        return len(stack) == 0 # True if stack is empty (all brackets matched).\ndef correct_bracketing(brackets: str) -> bool:\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n\n    >>> correct_bracketing(\"<\")\n    False\n    >>> correct_bracketing(\"<>\")\n    True\n    >>> correct_bracketing(\"<<><>>\")\n    True\n    >>> correct_bracketing(\"><<>\")\n    False\n    \"\"\"\n    return BracketValidator.validate(brackets)"}
{"task_id": "HumanEval/56", "solution": "class InvalidBracketInputError(ValueError):\n    \"\"\"Custom exception for invalid input to the bracket validator.\n    It signals issues with input type or disallowed characters.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass BracketValidator:\n    \"\"\"\n    Encapsulates the core logic for validating a string of '<' and '>' characters.\n    It tracks the balance of brackets and raises errors for invalid characters.\n    \"\"\"\n    def __init__(self):\n        self._balance: int = 0\n\n    def _process_char(self, char: str) -> None:\n        \"\"\"\n        Updates the balance based on the character.\n        Raises InvalidBracketInputError if the character is not '<' or '>'.\n        \"\"\"\n        if char == '<':\n            self._balance += 1\n        elif char == '>':\n            self._balance -= 1\n        else:\n            raise InvalidBracketInputError(\n                f\"Invalid character '{char}' found in input. Only '<' and '>' are allowed.\"\n            )\n\n    def validate(self, brackets: str) -> bool:\n        \"\"\"\n        Performs the bracket validation on the input string.\n        Returns True if brackets are correctly matched, False otherwise.\n        \"\"\"\n        if not isinstance(brackets, str):\n            raise InvalidBracketInputError(\"Input must be a string.\")\n\n        self._balance = 0\n        for char in brackets:\n            self._process_char(char)\n            if self._balance < 0:\n                return False\n\n        return self._balance == 0\ndef correct_bracketing(brackets: str) -> bool:\n    \"\"\"\n    Checks if a string of \"<\" and \">\" has correctly matched brackets.\n    It uses BracketValidator for core logic and re-raises any input errors.\n    \"\"\"\n    validator = BracketValidator()\n    try:\n        return validator.validate(brackets)\n    except InvalidBracketInputError:\n        raise"}
{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str) -> bool:\n    \"\"\" brackets is a string of \"<\" and \">\".\n    Return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    OPEN_BRACKET: str = '<'\n    CLOSE_BRACKET: str = '>'\n\n    open_bracket_count = 0\n    for char in brackets:\n        if char == OPEN_BRACKET:\n            open_bracket_count += 1\n        elif char == CLOSE_BRACKET:\n            open_bracket_count -= 1\n\n        # If count drops below zero, it's an invalid sequence.\n        if open_bracket_count < 0:\n            return False\n\n    # All brackets are matched if the final count is zero.\n    return open_bracket_count == 0"}
{"task_id": "HumanEval/56", "solution": "class InvalidBracketInputError(Exception):\n    \"\"\"Custom exception for invalid bracket input characters.\n    It is raised when the input string contains characters other than '<' or '>'.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    if not isinstance(brackets, str):\n        raise TypeError(\"Input 'brackets' must be a string.\")\n\n    open_bracket_count = 0\n    for char in brackets:\n        if char == '<':\n            open_bracket_count += 1\n        elif char == '>':\n            open_bracket_count -= 1\n        else:\n            raise InvalidBracketInputError(f\"Invalid character '{char}' found. Only '<' and '>' are allowed.\")\n\n        if open_bracket_count < 0:\n            return False\n\n    return open_bracket_count == 0"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True if list elements are monotonically increasing or decreasing.\n    An empty list or a list with one element is considered monotonic.\n    \"\"\"\n    if len(l) <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(len(l) - 1):\n        if l[i] > l[i+1]:\n            is_increasing = False\n        if l[i] < l[i+1]:\n            is_decreasing = False\n        \n        # If neither increasing nor decreasing trend is possible, we can stop early.\n        if not is_increasing and not is_decreasing:\n            return False\n\n    return is_increasing or is_decreasing"}
