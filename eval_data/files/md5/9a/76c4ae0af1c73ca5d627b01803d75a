{"task_id": "HumanEval/40", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\n    It indicates that the input list or its elements are not of the expected type.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef triples_sum_to_zero(l: list) -> bool:\n    \"\"\"Checks if there are three distinct elements in the list that sum to zero.\n    The function uses a sorted list and a two-pointer approach for O(N^2) efficiency.\n    \"\"\"\n    if not isinstance(l, list):\n        raise InvalidInputError(\"Input must be a list.\")\n    if not all(isinstance(x, int) for x in l):\n        raise InvalidInputError(\"All elements in the list must be integers.\")\n\n    n = len(l)\n    if n < 3:\n        return False\n\n    sorted_l = sorted(l) # Create a copy and sort to preserve the original list.\n\n    for i in range(n - 2):\n        # The primary pointer iterates through elements.\n        left, right = i + 1, n - 1\n        while left < right:\n            current_sum = sorted_l[i] + sorted_l[left] + sorted_l[right]\n\n            if current_sum == 0:\n                return True\n            elif current_sum < 0:\n                left += 1 # Increment left pointer to increase the sum.\n            else: # current_sum > 0\n                right -= 1 # Decrement right pointer to decrease the sum.\n                \n    return False"}
