{"task_id": "HumanEval/83", "solution": "from typing import Any\nclass InputValidator:\n    \"\"\"\n    Utility class for validating various input types.\n    \"\"\"\n    @staticmethod\n    def is_positive_integer(value: Any) -> bool:\n        \"\"\"\n        Checks if the given value is an integer and is greater than or equal to 1.\n        \"\"\"\n        return isinstance(value, int) and value >= 1\nclass DigitCounterService:\n    \"\"\"\n    Service class containing the core logic for counting n-digit numbers.\n    \"\"\"\n    @staticmethod\n    def _count_starts_with_one(n: int) -> int:\n        \"\"\"Counts n-digit positive integers that start with 1.\"\"\"\n        return 1 if n == 1 else (10**(n - 1))\n\n    @staticmethod\n    def _count_ends_with_one(n: int) -> int:\n        \"\"\"Counts n-digit positive integers that end with 1.\"\"\"\n        return 1 if n == 1 else (9 * (10**(n - 2)))\n\n    @staticmethod\n    def _count_starts_and_ends_with_one(n: int) -> int:\n        \"\"\"Counts n-digit positive integers that start AND end with 1.\"\"\"\n        return 1 if n == 1 else (10**(n - 2))\n\n    @staticmethod\n    def calculate_starts_one_ends(n: int) -> int:\n        \"\"\"\n        Calculates the count of n-digit positive integers that start or end with 1\n        using the principle of inclusion-exclusion.\n        \"\"\"\n        count_starts = DigitCounterService._count_starts_with_one(n)\n        count_ends = DigitCounterService._count_ends_with_one(n)\n        count_starts_and_ends = DigitCounterService._count_starts_and_ends_with_one(n)\n\n        return count_starts + count_ends - count_starts_and_ends\ndef starts_one_ends(n: int) -> int:\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    if not InputValidator.is_positive_integer(n):\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    return DigitCounterService.calculate_starts_one_ends(n)"}
