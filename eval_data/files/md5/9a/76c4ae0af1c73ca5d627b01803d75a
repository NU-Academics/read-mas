{"task_id": "HumanEval/6", "solution": "from typing import List\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"Parses space-separated parenthesis groups and returns their maximum nesting depths.\n    Each integer represents the deepest level of nesting for its corresponding group.\n    \"\"\"\n    def _calculate_group_depth_local(group_string: str) -> int:\n        \"\"\"Calculates the maximum nesting depth for a single parenthesis group.\n        It assumes valid parenthesis strings and returns 0 for empty or space-only strings.\n        \"\"\"\n        max_depth = 0\n        current_depth = 0\n        for char in group_string:\n            if char == '(':\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif char == ')':\n                current_depth -= 1\n        return max_depth\n\n    if not paren_string.strip():\n        return []\n\n    # The design specifies splitting by ' ' and then filtering empty groups.\n    groups = paren_string.split(' ')\n    depths = []\n    for group in groups:\n        if group:  # Only process non-empty group strings resulting from split(' ').\n            depths.append(_calculate_group_depth_local(group))\n    return depths"}
{"task_id": "HumanEval/6", "solution": "from typing import List\nclass InvalidParenthesesError(Exception):\n    \"\"\"\n    Custom exception for malformed parentheses groups.\n    It carries a descriptive message about the error.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef _calculate_max_depth(group: str) -> int:\n    \"\"\"\n    Calculates the deepest nesting level for a single group of parentheses.\n    Raises InvalidParenthesesError if the group is malformed.\n    \"\"\"\n    current_depth = 0\n    max_depth = 0\n    balance = 0 # Tracks overall balance for validation.\n\n    for char in group:\n        if char == '(':\n            current_depth += 1\n            balance += 1\n            max_depth = max(max_depth, current_depth)\n        elif char == ')':\n            current_depth -= 1\n            balance -= 1\n            if current_depth < 0:\n                raise InvalidParenthesesError(f\"Malformed parentheses group: '{group}' - closing parenthesis without matching open.\")\n        # As per spec, other characters are ignored implicitly.\n\n    if balance != 0:\n        raise InvalidParenthesesError(f\"Malformed parentheses group: '{group}' - unbalanced parentheses.\")\n\n    return max_depth\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    \"\"\"\n    if not paren_string.strip(): # Handles empty string and string with only spaces.\n        return []\n\n    groups = paren_string.split(' ') # Splits by single space, producing empty strings for multiple spaces.\n    results: List[int] = []\n\n    for group in groups:\n        if group: # Filters out empty strings resulting from multiple spaces.\n            results.append(_calculate_max_depth(group))\n\n    return results"}
{"task_id": "HumanEval/6", "solution": "from typing import List\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"\n    Input is a string of space-separated parenthesis groups.\n    It returns the deepest nesting level for each group (e.g., '(()())' -> 2, '((()))' -> 3).\n    \"\"\"\n    # Splits the input string into individual parenthesis groups, filtering out empty ones.\n    if not paren_string.strip():\n        return []\n    group_strings = [group for group in paren_string.split(' ') if group]\n\n    nesting_levels = []\n    # Calculates the deepest nesting level for each group and collects the results.\n    for group in group_strings:\n        current_depth = 0\n        max_depth = 0\n        for char in group:\n            if char == '(':\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif char == ')':\n                current_depth -= 1\n        nesting_levels.append(max_depth)\n\n    return nesting_levels"}
{"task_id": "HumanEval/6", "solution": "from typing import List\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    \"\"\"\n\n    def _calculate_group_depth(group_str: str) -> int:\n        \"\"\"Calculates the maximum nesting depth for a given single parenthesis group.\n        It iterates through characters, tracking current and maximum depth.\n        \"\"\"\n        max_depth = 0\n        current_depth = 0\n        for char in group_str:\n            if char == '(':\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif char == ')':\n                current_depth -= 1\n        return max_depth\n\n    if not paren_string:\n        return []\n\n    groups = paren_string.split(' ')\n    depths = []\n    for group in groups:\n        if group:  # Process only non-empty groups, handling multiple spaces.\n            depths.append(_calculate_group_depth(group))\n    return depths"}
{"task_id": "HumanEval/6", "solution": "from typing import List\nclass InvalidParenStringError(ValueError):\n    \"\"\"Custom exception for invalid parenthesis string formats.\n    It indicates issues like mismatched parentheses or invalid characters.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"\n    Parses a string of space-separated parenthesis groups.\n    It returns a list of deepest nesting levels for each group.\n    \"\"\"\n    if not isinstance(paren_string, str):\n        raise TypeError(\"Input 'paren_string' must be a string.\")\n\n    groups = paren_string.split(' ')\n    results = []\n\n    for group in groups:\n        if not group:  # Skip empty strings resulting from multiple spaces\n            continue\n\n        max_depth = 0\n        current_depth = 0\n\n        try:\n            for char in group:\n                if char == '(':\n                    current_depth += 1\n                    max_depth = max(max_depth, current_depth)\n                elif char == ')':\n                    current_depth -= 1\n                    if current_depth < 0:\n                        raise InvalidParenStringError(f\"Mismatched closing parenthesis in group: '{group}'\")\n                else:\n                    raise InvalidParenStringError(f\"Invalid character '{char}' found in group: '{group}'\")\n\n            if current_depth != 0:\n                raise InvalidParenStringError(f\"Mismatched opening parenthesis in group: '{group}'\")\n            \n            results.append(max_depth)\n        except InvalidParenStringError as e:\n            # Propagate InvalidParenStringError with context for the failed group.\n            raise InvalidParenStringError(f\"Error in group '{group}': {e.message}\") from e\n\n    return results"}
{"task_id": "HumanEval/6", "solution": "from typing import List\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"\n    Parses a string with space-separated parentheses groups and\n    returns a list of their deepest nesting levels.\n    \"\"\"\n    if not isinstance(paren_string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    # Split the string by space, then filter out any empty group strings\n    # that might result from multiple spaces or leading/trailing spaces.\n    groups = [group for group in paren_string.split(' ') if group]\n\n    if not groups:  # Handles empty string or string with only spaces\n        return []\n\n    results: List[int] = []\n    for group in groups:\n        max_level = 0\n        current_level = 0\n        for char in group:\n            if char == '(':\n                current_level += 1\n                max_level = max(max_level, current_level)\n            elif char == ')':\n                # Ensure level does not go below zero for malformed inputs\n                current_level = max(0, current_level - 1)\n        results.append(max_level)\n\n    return results"}
