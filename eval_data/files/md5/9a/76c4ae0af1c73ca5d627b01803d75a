{"task_id": "HumanEval/0", "solution": "from typing import List\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\"Check if any two numbers in the list are closer than the threshold.\n    This function validates inputs, sorts the list, and compares adjacent elements.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input 'numbers' must be a list.\")\n    if not all(isinstance(n, float) for n in numbers):\n        raise TypeError(\"All elements in 'numbers' must be floats.\")\n    if not isinstance(threshold, float):\n        raise TypeError(\"Input 'threshold' must be a float.\")\n    if threshold < 0:\n        raise ValueError(\"Input 'threshold' cannot be negative.\")\n\n    if len(numbers) < 2:\n        return False\n\n    sorted_numbers = sorted(numbers)\n\n    for i in range(len(sorted_numbers) - 1):\n        if abs(sorted_numbers[i+1] - sorted_numbers[i]) < threshold:\n            return True\n    return False"}
{"task_id": "HumanEval/0", "solution": "from typing import List\nfrom itertools import combinations\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    if threshold < 0:\n        raise ValueError(\"Threshold cannot be negative.\")\n\n    if len(numbers) < 2:\n        return False\n\n    for n1, n2 in combinations(numbers, 2):\n        if abs(n1 - n2) < threshold:\n            return True\n    return False"}
{"task_id": "HumanEval/0", "solution": "import math\nfrom typing import List\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\"Checks if any two numbers in the list are closer than the threshold.\n    It sorts the list and compares adjacent elements for O(N log N) efficiency.\"\"\"\n    \n    if not isinstance(numbers, list):\n        raise TypeError(\"Input 'numbers' must be a list.\")\n    if not all(isinstance(n, (int, float)) for n in numbers):\n        raise TypeError(\"All elements in 'numbers' must be numeric (float or int).\")\n    if not isinstance(threshold, (int, float)):\n        raise TypeError(\"Input 'threshold' must be a numeric value (float or int).\")\n    if threshold < 0:\n        raise ValueError(\"Input 'threshold' cannot be negative.\")\n\n    if len(numbers) < 2:\n        return False\n\n    # Sort the list to efficiently check only adjacent elements.\n    # This makes the complexity O(N log N) due to sorting.\n    sorted_numbers = sorted(numbers)\n\n    for i in range(len(sorted_numbers) - 1):\n        if math.fabs(sorted_numbers[i] - sorted_numbers[i+1]) < threshold:\n            return True\n            \n    return False"}
{"task_id": "HumanEval/0", "solution": "from typing import List\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    >>> has_close_elements([1.0, 2.0, 3.0], 0.5)\n    False\n    >>> has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3)\n    True\n    \"\"\"\n    if threshold <= 0.0 or len(numbers) < 2:\n        return False\n\n    sorted_numbers = sorted(numbers)\n\n    for i in range(len(sorted_numbers) - 1):\n        if abs(sorted_numbers[i+1] - sorted_numbers[i]) < threshold:\n            return True\n    \n    return False"}
