{"task_id": "HumanEval/9", "solution": "from typing import List\nfrom math import inf\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to the rolling max calculator.\n    It inherits from Python's built-in Exception class.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise InvalidInputError(\"Input must be a list.\")\n\n    if not all(isinstance(n, int) for n in numbers):\n        raise InvalidInputError(\"All elements in the list must be integers.\")\n\n    if not numbers:\n        return []\n\n    rolling_max_list: List[int] = []\n    current_max: float = -inf\n\n    for number in numbers:\n        current_max = max(current_max, number)\n        rolling_max_list.append(int(current_max))\n\n    return rolling_max_list"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    if not isinstance(string, str):\n        raise TypeError(\"Input must be a string.\")\n    return string == string[::-1]\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string. \"\"\"\n    if not isinstance(string, str):\n        raise TypeError(\"Input must be a string.\")\n    if not string:\n        return \"\"\n\n    # Find the longest postfix of `string` that is a palindrome.\n    n = len(string)\n    longest_pal_suffix_start_idx = n\n    for i in range(n, 0, -1):\n        suffix = string[n - i:]\n        if is_palindrome(suffix):\n            longest_pal_suffix_start_idx = n - i\n            break\n\n    # Identify the prefix that comes before this palindromic suffix.\n    prefix_before_suffix = string[:longest_pal_suffix_start_idx]\n\n    # Reverse this prefix and append it to the original string.\n    return string + prefix_before_suffix[::-1]"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\"Test if given string is a palindrome.\n    Raises TypeError if input is not a string.\n    \"\"\"\n    if not isinstance(string, str):\n        raise TypeError(\"Input must be a string.\")\n    return string == string[::-1]\ndef make_palindrome(string: str) -> str:\n    \"\"\"Find the shortest palindrome that begins with a supplied string.\n    The algorithm finds the longest palindromic postfix and appends the reversed preceding prefix.\n    \"\"\"\n    if not isinstance(string, str):\n        raise TypeError(\"Input must be a string.\")\n    if not string:\n        return \"\"\n\n    for j in range(len(string)):\n        suffix = string[j:]\n        if is_palindrome(suffix):\n            prefix_to_reverse = string[:j]\n            return string + prefix_to_reverse[::-1]\n    \n    # This fallback handles cases where the loop might not explicitly return, though\n    # for any non-empty string, at least the last character will be a palindromic suffix.\n    return string"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    return string == string[::-1]\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    if not isinstance(string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    if is_palindrome(string):\n        return string\n\n    # Find the longest postfix of supplied string that is a palindrome.\n    # Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    for i in range(len(string)):\n        suffix = string[i:]\n        if is_palindrome(suffix):\n            prefix_to_reverse = string[:i]\n            return string + prefix_to_reverse[::-1]\n    return string # Should not be reached for non-empty strings, but handles \"\""}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    return string == string[::-1]\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string. \"\"\"\n    if not string:\n        return \"\"\n\n    n = len(string)\n    # Iterate to find the longest palindromic postfix.\n    # A postfix starting at index 'i' is string[i:].\n    for i in range(n):\n        if is_palindrome(string[i:]):\n            # The longest palindromic postfix starts at index i.\n            # The prefix before it is string[:i].\n            return string + string[:i][::-1]\n    \n    # This line is logically unreachable for non-empty strings.\n    return string"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    return string == string[::-1]\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    if not string:\n        return \"\"\n\n    longest_palindromic_postfix_len = 0\n    for i in range(len(string)):\n        suffix = string[i:]\n        if is_palindrome(suffix):\n            longest_palindromic_postfix_len = len(suffix)\n            break\n\n    prefix_to_reverse = string[:-longest_palindromic_postfix_len]\n    return string + prefix_to_reverse[::-1]"}
{"task_id": "HumanEval/11", "solution": "from typing import List\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to the binary XOR operation.\"\"\"\n    pass\ndef string_xor(a: str, b: str) -> str:\n    \"\"\"\n    Performs binary XOR on two input strings consisting only of '1's and '0's.\n    Inputs must be of equal length.\n    \"\"\"\n    if not all(char in '01' for char in a):\n        raise InvalidInputError(f\"String 'a' contains non-binary characters: {a}\")\n    if not all(char in '01' for char in b):\n        raise InvalidInputError(f\"String 'b' contains non-binary characters: {b}\")\n\n    if len(a) != len(b):\n        raise InvalidInputError(f\"Input strings must be of equal length. Got lengths: {len(a)} and {len(b)}\")\n\n    result_bits: List[str] = []\n    for i in range(len(a)):\n        bit_a = int(a[i])\n        bit_b = int(b[i])\n        xor_result = bit_a ^ bit_b\n        result_bits.append(str(xor_result))\n    return \"\".join(result_bits)"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    return string == string[::-1]\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    if not string:\n        return \"\"\n\n    n = len(string)\n    longest_palindromic_postfix = \"\"\n\n    # Iterate through all possible postfixes, starting from the full string\n    # to find the longest one that is a palindrome.\n    for i in range(n):\n        postfix = string[i:]\n        if is_palindrome(postfix):\n            longest_palindromic_postfix = postfix\n            break # The first palindrome found from the beginning is the longest.\n\n    # The prefix is the part of the original string that comes before the longest palindromic postfix.\n    prefix_length = n - len(longest_palindromic_postfix)\n    prefix_to_reverse = string[:prefix_length]\n    \n    # Reverse this prefix.\n    reversed_prefix = prefix_to_reverse[::-1]\n    \n    # Append the reversed prefix to the original string to form the shortest palindrome.\n    return string + reversed_prefix"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\"Test if given string is a palindrome.\"\"\"\n    return string == string[::-1]\ndef make_palindrome(string: str) -> str:\n    \"\"\"\n    Find the shortest palindrome that begins with a supplied string.\n    This is done by finding the longest palindromic suffix and appending the reverse of the preceding prefix.\n    \"\"\"\n    if not string:\n        return \"\"\n\n    longest_pal_suffix = \"\"\n    # Find the longest palindromic suffix by iterating from the start of the string.\n    # The first palindromic suffix found will be the longest one.\n    for i in range(len(string)):\n        suffix = string[i:]\n        if is_palindrome(suffix):\n            longest_pal_suffix = suffix\n            break \n    \n    # Determine the prefix that precedes the longest palindromic suffix.\n    prefix_to_reverse = string[:len(string) - len(longest_pal_suffix)]\n    \n    # Append the reversed prefix to the original string to form the palindrome.\n    return string + prefix_to_reverse[::-1]"}
{"task_id": "HumanEval/11", "solution": "from typing import List\nclass InvalidBinaryStringError(ValueError):\n    \"\"\"Custom exception raised for non-binary characters in an input string.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\nclass UnequalLengthError(ValueError):\n    \"\"\"Custom exception raised when input strings have different lengths.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    if not all(c in '01' for c in a):\n        raise InvalidBinaryStringError(f\"Input string '{a}' contains non-binary characters.\")\n\n    if not all(c in '01' for c in b):\n        raise InvalidBinaryStringError(f\"Input string '{b}' contains non-binary characters.\")\n\n    if len(a) != len(b):\n        raise UnequalLengthError(\n            f\"Input strings must have the same length, but got '{a}' (length {len(a)}) and '{b}' (length {len(b)}).\"\n        )\n\n    result_chars: List[str] = []\n    for char_a, char_b in zip(a, b):\n        if char_a == char_b:\n            result_chars.append('0')\n        else:\n            result_chars.append('1')\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/10", "solution": "def make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    if not string:\n        return \"\"\n\n    # Helper function to check if a string is a palindrome\n    def is_palindrome(s: str) -> bool:\n        return s == s[::-1]\n\n    # Find the longest palindromic suffix\n    for i in range(len(string)):\n        suffix = string[i:]\n        if is_palindrome(suffix):\n            # If a palindromic suffix is found, the part before it is the prefix.\n            prefix = string[:i]\n            return string + prefix[::-1]\n    \n    # This return is logically unreachable for non-empty strings, as the loop always finds at least\n    # the last character as a single-character palindrome. It is kept for strict adherence to the problem prompt's snippet.\n    return string"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    if not a or not b:\n        raise ValueError(\"Input strings cannot be empty.\")\n    if len(a) != len(b):\n        raise ValueError(\"Input strings must have the same length.\")\n\n    result_list = []\n    for char_a, char_b in zip(a, b):\n        if char_a not in ('0', '1') or char_b not in ('0', '1'):\n            raise ValueError(\"Input strings must contain only '0's and '1's.\")\n        \n        # Perform XOR: '0' if chars are same, '1' if different.\n        result_list.append('0' if char_a == char_b else '1')\n    \n    return \"\".join(result_list)"}
{"task_id": "HumanEval/11", "solution": "from typing import Set\ndef string_xor(a: str, b: str) -> str:\n    \"\"\"Performs binary XOR on two input strings consisting only of '1's and '0's.\n    Pads the shorter string with leading '0's if lengths differ to match the longer string's length.\n    \"\"\"\n    \n    BINARY_CHARS: Set[str] = {'0', '1'}\n    if not all(char in BINARY_CHARS for char in a):\n        raise ValueError(f\"Input 'a' is not a valid binary string: '{a}'\")\n    if not all(char in BINARY_CHARS for char in b):\n        raise ValueError(f\"Input 'b' is not a valid binary string: '{b}'\")\n\n    max_len = max(len(a), len(b))\n    padded_a = a.zfill(max_len)\n    padded_b = b.zfill(max_len)\n    \n    result_chars = []\n    for char_a, char_b in zip(padded_a, padded_b):\n        # Apply XOR logic: '0' if bits are the same, '1' if different.\n        result_chars.append('0' if char_a == char_b else '1')\n            \n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/11", "solution": "from typing import List\nclass XorInputError(ValueError):\n    \"\"\"Custom exception for invalid input to the string_xor function.\"\"\"\n    pass\nERROR_MSG_LENGTH = \"Input strings must have the same length.\"\nERROR_MSG_CHARS = \"Input strings must contain only '0' or '1' characters.\"\ndef string_xor(a: str, b: str) -> str:\n    \"\"\"\n    Performs binary XOR on two input strings consisting only of '1's and '0's.\n    Returns the result also as a string.\n    \"\"\"\n    if len(a) != len(b):\n        raise XorInputError(ERROR_MSG_LENGTH)\n\n    if not all(char in '01' for char in a) or not all(char in '01' for char in b):\n        raise XorInputError(ERROR_MSG_CHARS)\n\n    result_chars: List[str] = []\n    for i in range(len(a)):\n        bit_a = int(a[i])\n        bit_b = int(b[i])\n        xor_result = bit_a ^ bit_b\n        result_chars.append(str(xor_result))\n\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/11", "solution": "from typing import List\nclass InvalidBinaryStringError(ValueError):\n    \"\"\"Raised when a string contains characters other than '0' or '1'.\"\"\"\n    pass\nclass UnequalLengthError(ValueError):\n    \"\"\"Raised when two binary strings have different lengths for XOR.\"\"\"\n    pass\nclass BinaryStringValidator:\n    \"\"\"Utility class for validating binary strings.\"\"\"\n    @staticmethod\n    def validate_binary_string(s: str) -> None:\n        \"\"\"Checks if a string contains only '0' or '1' characters.\n        Raises InvalidBinaryStringError if validation fails.\n        \"\"\"\n        if not all(c in '01' for c in s):\n            raise InvalidBinaryStringError(f\"String '{s}' contains non-binary characters.\")\n\n    @staticmethod\n    def validate_equal_length(s1: str, s2: str) -> None:\n        \"\"\"Checks if two strings have the same length.\n        Raises UnequalLengthError if lengths are different.\n        \"\"\"\n        if len(s1) != len(s2):\n            raise UnequalLengthError(f\"Binary strings must be of equal length. Got {len(s1)} and {len(s2)}.\")\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    \"\"\"\n    BinaryStringValidator.validate_binary_string(a)\n    BinaryStringValidator.validate_binary_string(b)\n    BinaryStringValidator.validate_equal_length(a, b)\n\n    result_bits = []\n    for i in range(len(a)):\n        bit_a = int(a[i])\n        bit_b = int(b[i])\n        xor_result = bit_a ^ bit_b\n        result_bits.append(str(xor_result))\n    return \"\".join(result_bits)"}
{"task_id": "HumanEval/11", "solution": "from typing import List\nclass InvalidInputError(ValueError):\n    \"\"\"Raised when an input string is invalid for binary XOR operations.\"\"\"\n    pass\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    if not a:\n        raise InvalidInputError(\"Input string 'a' cannot be empty.\")\n    if not b:\n        raise InvalidInputError(\"Input string 'b' cannot be empty.\")\n\n    if len(a) != len(b):\n        raise InvalidInputError(f\"Input strings must have the same length. Got {len(a)} and {len(b)}.\")\n\n    BINARY_CHARS = {'0', '1'}\n\n    if not all(char in BINARY_CHARS for char in a):\n        raise InvalidInputError(\"String 'a' contains non-binary characters. Only '0' and '1' are allowed.\")\n    if not all(char in BINARY_CHARS for char in b):\n        raise InvalidInputError(\"String 'b' contains non-binary characters. Only '0' and '1' are allowed.\")\n\n    result_chars: List[str] = []\n    for i in range(len(a)):\n        xor_result = int(a[i]) ^ int(b[i])\n        result_chars.append(str(xor_result))\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    >>> longest([])\n\n    >>> longest(['a', 'b', 'c'])\n    'a'\n    >>> longest(['a', 'bb', 'ccc'])\n    'ccc'\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_str = strings[0]\n    max_length = len(strings[0])\n\n    # Iterate from the second element, as the first is already considered.\n    for s in strings[1:]:\n        current_length = len(s)\n        if current_length > max_length:\n            longest_str = s\n            max_length = current_length\n    return longest_str"}
