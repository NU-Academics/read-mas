            prime_fib_count += 1\n                if prime_fib_count == n:\n                    return fib_num\n        # This code path should ideally not be reached as Fibonacci sequence is infinite.\n        raise RuntimeError(\"Could not find the N-th prime Fibonacci number within reasonable limits.\")\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    fib_gen = FibonacciGenerator()\n    prime_checker = PrimeChecker()\n    service = PrimeFibService(fib_gen, prime_checker)\n    return service.find_nth_prime_fib(n)"}
{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    from typing import Generator\n\n    class FibonacciUtils:\n        @staticmethod\n        def generate_sequence() -> Generator[int, None, None]:\n            # Generates an infinite sequence of Fibonacci numbers starting from 2.\n            # This sequence aligns with the problem's examples (2, 3, 5, 8, 13, ...).\n            a, b = 1, 2  # Represents F_2=1 and F_3=2 in a 0-indexed sequence (0,1,1,2,3,5...).\n            yield b # Yields 2, the first number in the desired sequence.\n            while True:\n                a, b = b, a + b # Calculate the next Fibonacci number.\n                yield b\n\n\n    class PrimeUtils:\n        @staticmethod\n        def is_prime(num: int) -> bool:\n            # Checks if a given number is prime using trial division.\n            # It efficiently handles small numbers and even numbers.\n            if num < 2:\n                return False\n            if num == 2:\n                return True\n            if num % 2 == 0:\n                return False\n            i = 3\n            while i * i <= num:\n                if num % i == 0:\n                    return False\n                i += 2\n            return True\n\n\n    class PrimeFibFinder:\n        def __init__(self):\n            # Initializes the finder with instances of Fibonacci and Prime utilities.\n            # These instances provide access to the necessary calculation logic.\n            self.fib_utils = FibonacciUtils()\n            self.prime_utils = PrimeUtils()\n\n        def find_nth_prime_fib(self, n: int) -> int:\n            # Finds the N-th number that is both a Fibonacci number and a prime.\n            # It iterates through Fibonacci numbers until 'n' prime ones are found.\n            fib_generator = self.fib_utils.generate_sequence()\n            count = 0\n            while True:\n                fib_num = next(fib_generator)\n                if self.prime_utils.is_prime(fib_num):\n                    count += 1\n                    if count == n:\n                        return fib_num\n\n    # Validates input 'n' to ensure it's a positive integer, as required.\n    # Raises a ValueError if the input does not meet the criteria.\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    finder = PrimeFibFinder()\n    return finder.find_nth_prime_fib(n)"}
