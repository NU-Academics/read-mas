{"task_id": "HumanEval/17", "solution": "from typing import List, Dict\nclass MusicParserError(Exception):\n    \"\"\"Custom exception for errors during music string parsing.\n    It stores a descriptive message about the error.\n    \"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n_NOTE_BEAT_MAP: Dict[str, int] = {\n    'o': 4,   # Whole note lasts four beats.\n    'o|': 2,  # Half note lasts two beats.\n    '.|': 1   # Quarter note lasts one beat.\n}\nclass MusicParser:\n    \"\"\"Parses musical notation strings into beat durations.\n    It encapsulates the logic for note-to-beat conversion and error handling.\n    \"\"\"\n\n    def __init__(self):\n        self._note_beat_map: Dict[str, int] = _NOTE_BEAT_MAP\n\n    def _parse_single_note(self, note_str: str) -> int:\n        \"\"\"Parses a single note token into its beat duration.\n        Raises MusicParserError if the note symbol is unknown.\n        \"\"\"\n        beat_duration = self._note_beat_map.get(note_str)\n        if beat_duration is None:\n            raise MusicParserError(f\"Unknown note symbol: '{note_str}'\")\n        return beat_duration\n\n    def parse(self, music_string: str) -> List[int]:\n        \"\"\"Parses a music string into a list of beat durations.\n        It splits the string into tokens and processes each token.\n        \"\"\"\n        if not music_string.strip():\n            return []\n\n        note_tokens = music_string.split(' ')\n        beat_durations: List[int] = []\n\n        for token in note_tokens:\n            if token:\n                beat_durations.append(self._parse_single_note(token))\n\n        return beat_durations\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\" Input to this function is a string representing musical notes in a special ASCII format.\n    Your task is to parse this string and return list of integers corresponding to how many beats does each\n    not last.\n\n    Here is a legend:\n    'o' - whole note, lasts four beats\n    'o|' - half note, lasts two beats\n    '.|' - quater note, lasts one beat\n\n    >>> parse_music('o o| .| o| o| .| .| .| .| o o')\n    [4, 2, 1, 2, 2, 1, 1, 1, 1, 4, 4]\n    \"\"\"\n    parser = MusicParser()\n    return parser.parse(music_string)"}
{"task_id": "HumanEval/18", "solution": "def how_many_times(string: str, substring: str) -> int:\n    \"\"\"\n    Find how many times a given substring can be found in the original string.\n    Count overlapping cases.\n    >>> how_many_times('', 'a')\n    0\n    >>> how_many_times('aaa', 'a')\n    3\n    >>> how_many_times('aaaa', 'aa')\n    3\n    >>> how_many_times('ababa', 'aba')\n    2\n    \"\"\"\n    if not isinstance(string, str) or not isinstance(substring, str):\n        raise TypeError(\"Both 'string' and 'substring' must be of type str.\")\n\n    if not substring:\n        # An empty substring can be found at len(string) + 1 positions.\n        return len(string) + 1\n\n    if not string:\n        return 0\n\n    count = 0\n    start_index = 0\n    while True:\n        index = string.find(substring, start_index)\n        if index == -1:\n            break\n        count += 1\n        start_index = index + 1 # Move one character forward to allow overlaps.\n    return count"}
