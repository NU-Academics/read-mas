{"task_id": "HumanEval/122", "solution": "from typing import Callable, List\nMAX_TWO_DIGIT_VALUE = 99\ndef has_at_most_two_digits(number: int) -> bool:\n    \"\"\"\n    Checks if an integer has at most two digits (i.e., its absolute value is <= 99).\n    Raises TypeError if 'number' is not an integer.\n    \"\"\"\n    if not isinstance(number, int):\n        raise TypeError(\"Input 'number' must be an integer.\")\n    return abs(number) <= MAX_TWO_DIGIT_VALUE\nclass ElementProcessor:\n    \"\"\"\n    Encapsulates logic for iterating through a sub-array, filtering, and summing elements.\n    It uses a digit_checker callable provided during initialization.\n    \"\"\"\n    def __init__(self, digit_checker: Callable[[int], bool]):\n        self._digit_checker = digit_checker\n\n    def process_and_sum(self, arr: List[int], k: int) -> int:\n        \"\"\"\n        Iterates through the first k elements of arr, applies the digit_checker, and sums qualifying elements.\n        The function returns the accumulated sum.\n        \"\"\"\n        current_sum = 0\n        for i in range(k):\n            element = arr[i]\n            if self._digit_checker(element):\n                current_sum += element\n        return current_sum\ndef add_elements(arr: List[int], k: int) -> int:\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n\n    Example:\n\n        Input: arr = [111,21,3,4000,5,6,7,8,9], k = 4\n        Output: 24 # sum of 21 + 3\n\n    Constraints:\n        1. 1 <= len(arr) <= 100\n        2. 1 <= k <= len(arr)\n    \"\"\"\n    # FR1: Input validation\n    if not isinstance(arr, list):\n        raise TypeError(\"Input 'arr' must be a list.\")\n    if not all(isinstance(x, int) for x in arr):\n        raise TypeError(\"All elements in 'arr' must be integers.\")\n    if not isinstance(k, int):\n        raise TypeError(\"Input 'k' must be an integer.\")\n    if not arr:\n        raise ValueError(\"Input 'arr' cannot be empty.\")\n    # Constraints: 1 <= k <= len(arr)\n    if not (1 <= k <= len(arr)):\n        raise ValueError(f\"Input 'k' must be between 1 and len(arr) ({len(arr)}), but got {k}.\")\n\n    # Orchestrate using ElementProcessor and has_at_most_two_digits\n    processor = ElementProcessor(has_at_most_two_digits)\n    return processor.process_and_sum(arr, k)"}
{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n\n    An element has 'at most two digits' if its absolute value is less than 100.\n    \"\"\"\n    total_sum = 0\n    # Iterate through the first 'k' elements of the array as specified.\n    for element in arr[:k]:\n        # Add the element to the sum if its absolute value is less than 100.\n        if abs(element) < 100:\n            total_sum += element\n    return total_sum"}
{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input 'arr' must be a list.\")\n    if not isinstance(k, int):\n        raise TypeError(\"Input 'k' must be an integer.\")\n\n    if not (1 <= len(arr) <= 100):\n        raise ValueError(f\"Length of 'arr' must be between 1 and 100, got {len(arr)}.\")\n    if not (1 <= k <= len(arr)):\n        raise ValueError(f\"Input 'k' must be between 1 and len(arr) ({len(arr)}), got {k}.\")\n\n    for i, item in enumerate(arr):\n        if not isinstance(item, int):\n            raise TypeError(f\"All elements in 'arr' must be integers. Element at index {i} is not an int.\")\n\n    current_sum = 0\n    for i in range(k):\n        element = arr[i]\n        if abs(element) < 100:  # Check if element has at most two digits\n            current_sum += element\n    return current_sum"}
