{"task_id": "HumanEval/17", "solution": "from typing import List, Dict\nclass InvalidNoteError(Exception):\n    \"\"\"Custom exception for invalid or unknown musical note symbols.\"\"\"\n    pass\nNOTE_BEAT_MAP: Dict[str, int] = {\n    'o': 4,   # Whole note\n    'o|': 2,  # Half note\n    '.|': 1   # Quarter note\n}\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\" Input to this function is a string representing musical notes in a special ASCII format.\n    Your task is to parse this string and return list of integers corresponding to how many beats does each\n    not last.\n\n    Here is a legend:\n    'o' - whole note, lasts four beats\n    'o|' - half note, lasts two beats\n    '.|' - quater note, lasts one beat\n\n    >>> parse_music('o o| .| o| o| .| .| .| .| o o')\n    [4, 2, 1, 2, 2, 1, 1, 1, 1, 4, 4]\n    \"\"\"\n    beat_durations = []\n    note_symbols = music_string.split(' ') # Splits by spaces, handling multiple spaces.\n\n    for note_symbol in note_symbols:\n        if not note_symbol: # Skips empty strings that result from multiple spaces.\n            continue\n        if note_symbol in NOTE_BEAT_MAP:\n            beat_durations.append(NOTE_BEAT_MAP[note_symbol])\n        else:\n            raise InvalidNoteError(f\"Unknown note symbol: '{note_symbol}'\")\n    return beat_durations"}
{"task_id": "HumanEval/17", "solution": "from typing import List\nclass InvalidNoteError(ValueError):\n    \"\"\"Raised when an unrecognized musical note symbol is encountered.\"\"\"\n    pass\nNOTE_BEAT_MAP = {\n    'o': 4,   # Whole note\n    'o|': 2,  # Half note\n    '.|': 1   # Quarter note\n}\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\" Input to this function is a string representing musical notes in a special ASCII format.\n    Your task is to parse this string and return list of integers corresponding to how many beats does each\n    not last.\n\n    Here is a legend:\n    'o' - whole note, lasts four beats\n    'o|' - half note, lasts two beats\n    '.|' - quater note, lasts one beat\n\n    >>> parse_music('o o| .| o| o| .| .| .| .| o o')\n    [4, 2, 1, 2, 2, 1, 1, 1, 1, 4, 4]\n    \"\"\"\n    if not music_string:\n        return []\n\n    note_symbols = music_string.split(' ')\n    beat_durations: List[int] = []\n\n    for symbol in note_symbols:\n        if symbol: \n            beat_duration = NOTE_BEAT_MAP.get(symbol)\n            if beat_duration is None:\n                raise InvalidNoteError(f\"Unrecognized note symbol: '{symbol}'\")\n            beat_durations.append(beat_duration)\n\n    return beat_durations"}
