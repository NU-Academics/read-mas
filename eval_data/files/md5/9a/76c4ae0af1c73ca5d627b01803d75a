{"task_id": "HumanEval/71", "solution": "import math\nclass Triangle:\n    \"\"\"Holds the three side lengths of a triangle.\"\"\"\n    def __init__(self, a: float, b: float, c: float):\n        \"\"\"Initializes the triangle with side lengths a, b, and c.\"\"\"\n        self._a = a\n        self._b = b\n        self._c = c\n\n    def get_a(self) -> float:\n        \"\"\"Returns the length of side 'a'.\"\"\"\n        return self._a\n\n    def get_b(self) -> float:\n        \"\"\"Returns the length of side 'b'.\"\"\"\n        return self._b\n\n    def get_c(self) -> float:\n        \"\"\"Returns the length of side 'c'.\"\"\"\n        return self._c\nclass TriangleValidator:\n    \"\"\"Encapsulates logic for validating if side lengths form a valid triangle.\"\"\"\n    def is_valid(self, triangle: Triangle) -> bool:\n        \"\"\"Checks if the given triangle's sides are positive and satisfy inequality.\"\"\"\n        return self._is_positive_sides(triangle) and self._satisfies_inequality(triangle)\n\n    def _is_positive_sides(self, triangle: Triangle) -> bool:\n        \"\"\"Checks if all side lengths are greater than 0.\"\"\"\n        return triangle.get_a() > 0 and triangle.get_b() > 0 and triangle.get_c() > 0\n\n    def _satisfies_inequality(self, triangle: Triangle) -> bool:\n        \"\"\"Checks if the sum of any two sides is greater than the third side.\"\"\"\n        a, b, c = triangle.get_a(), triangle.get_b(), triangle.get_c()\n        return (a + b > c) and (a + c > b) and (b + c > a)\nclass AreaCalculator:\n    \"\"\"Encapsulates logic for calculating triangle area using Heron's formula.\"\"\"\n    ROUND_PRECISION = 2\n\n    def calculate_herons_area(self, triangle: Triangle) -> float:\n        \"\"\"Calculates the area of the triangle using Heron's formula and rounds it.\"\"\"\n        s = self._calculate_semi_perimeter(triangle)\n        area_squared = s * (s - triangle.get_a()) * \\\n                       (s - triangle.get_b()) * (s - triangle.get_c())\n        \n        # Clamp to zero to handle floating point inaccuracies near zero.\n        area_squared = max(0.0, area_squared)\n\n        area = math.sqrt(area_squared)\n        return round(area, self.ROUND_PRECISION)\n\n    def _calculate_semi_perimeter(self, triangle: Triangle) -> float:\n        \"\"\"Calculates the semi-perimeter of the triangle.\"\"\"\n        return (triangle.get_a() + triangle.get_b() + triangle.get_c()) / 2\nclass TriangleService:\n    \"\"\"Orchestrates triangle validation and area calculation.\"\"\"\n    def __init__(self, validator: TriangleValidator, calculator: AreaCalculator):\n        \"\"\"Initializes the service with validator and calculator dependencies.\"\"\"\n        self._validator = validator\n        self._calculator = calculator\n\n    def get_area(self, a: float, b: float, c: float) -> float:\n        \"\"\"Returns the area if the triangle is valid, otherwise -1.0.\"\"\"\n        triangle = Triangle(a, b, c)\n        if not self._validator.is_valid(triangle):\n            return -1.0\n        return self._calculator.calculate_herons_area(triangle)\ndef triangle_area(a: float, b: float, c: float) -> float:\n    \"\"\"\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle.\n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater\n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    \"\"\"\n    validator = TriangleValidator()\n    calculator = AreaCalculator()\n    service = TriangleService(validator, calculator)\n    return service.get_area(a, b, c)"}
{"task_id": "HumanEval/71", "solution": "import math\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle, return its area.\n    Returns -1.0 if the sides do not form a valid triangle.\n    '''\n    # Validate if all side lengths are positive.\n    if not (a > 0 and b > 0 and c > 0):\n        return -1.0\n\n    # Validate the triangle inequality theorem.\n    if not (a + b > c and a + c > b and b + c > a):\n        return -1.0\n\n    # Calculate the semi-perimeter.\n    s = (a + b + c) / 2\n\n    # Calculate the area using Heron's formula.\n    area = math.sqrt(s * (s - a) * (s - b) * (s - c))\n\n    return round(area, 2)"}
{"task_id": "HumanEval/71", "solution": "import math\ndef triangle_area(a, b, c):\n    \"\"\"\n    Calculates the area of a triangle given its three side lengths.\n    Returns the area rounded to 2 decimal places, or -1.0 if invalid.\n    \"\"\"\n\n    def _are_sides_positive(s1: float, s2: float, s3: float) -> bool:\n        \"\"\"Checks if all side lengths are strictly positive.\"\"\"\n        return s1 > 0 and s2 > 0 and s3 > 0\n\n    def _satisfy_inequality(s1: float, s2: float, s3: float) -> bool:\n        \"\"\"Checks if the sum of any two sides is greater than the third side.\"\"\"\n        return (s1 + s2 > s3) and (s1 + s3 > s2) and (s2 + s3 > s1)\n\n    def _is_valid_triangle(s1: float, s2: float, s3: float) -> bool:\n        \"\"\"Determines if three side lengths can form a valid triangle.\"\"\"\n        return _are_sides_positive(s1, s2, s3) and _satisfy_inequality(s1, s2, s3)\n\n    def _calculate_area_heron(s1: float, s2: float, s3: float) -> float:\n        \"\"\"Calculates the area using Heron's formula for a valid triangle. Handles potential floating-point inaccuracies.\"\"\"\n        s = (s1 + s2 + s3) / 2\n        area_squared = s * (s - s1) * (s - s2) * (s - s3)\n        if area_squared < 0: # Clamp to 0 due to potential floating point errors for very flat triangles.\n            area_squared = 0\n        return math.sqrt(area_squared)\n\n    if not _is_valid_triangle(a, b, c):\n        return -1.0\n\n    area = _calculate_area_heron(a, b, c)\n    return round(area, 2)"}
