{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even-valued node and its index in the array.\n    Prioritizes the smallest index for ties, returning [] if no even values are found.\n    \"\"\"\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n    found_even = False\n\n    for index, value in enumerate(arr):\n        if value % 2 == 0:  # Check if the value is even.\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = index\n                found_even = True\n            # If value == smallest_even_value, the current smallest_even_index is retained.\n\n    if found_even:\n        return [smallest_even_value, smallest_even_index]\n    else:\n        return []"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even-valued node in an array. If values are equal, the node with the smallest index is chosen,\n    returning `[value, index]` or `[]` if no even nodes are found.\n    \"\"\"\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for index, node_value in enumerate(arr):\n        if node_value % 2 == 0:  # Check if the node is even.\n            if node_value < smallest_even_value:\n                smallest_even_value = node_value\n                smallest_even_index = index\n            elif node_value == smallest_even_value:\n                # For equal values, choose the one with the smallest index.\n                if index < smallest_even_index:\n                    smallest_even_index = index\n    \n    if smallest_even_index != -1:\n        return [smallest_even_value, smallest_even_index]\n    else:\n        return []"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Plucks the smallest even-valued node with the smallest index from a list of non-negative integers.\n    Returns `[value, index]` or `[]` if no even values are found or the input list is empty.\n    \"\"\"\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    if not arr:\n        return []\n\n    for i, node_value in enumerate(arr):\n        if node_value % 2 == 0:  # Check if the node is even.\n            if node_value < smallest_even_value:\n                smallest_even_value = node_value\n                smallest_even_index = i\n            elif node_value == smallest_even_value and i < smallest_even_index:\n                # If same smallest value, update index if current one is smaller.\n                smallest_even_index = i\n\n    if smallest_even_index != -1:\n        return [int(smallest_even_value), smallest_even_index]\n    else:\n        return []"}
