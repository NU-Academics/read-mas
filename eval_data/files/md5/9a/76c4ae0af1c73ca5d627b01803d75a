{"task_id": "HumanEval/6", "solution": "from typing import List\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"\n    Parses a string of space-separated parentheses groups to find the deepest nesting level for each.\n    For each group, it calculates the maximum nesting depth.\n    \"\"\"\n    results = []\n    # Splitting by a single space will produce empty strings for multiple spaces between groups.\n    groups = paren_string.split(' ')\n\n    for group_string in groups:\n        # Only process non-empty group strings, skipping those resulting from multiple spaces.\n        if not group_string:\n            continue\n\n        max_depth = 0\n        current_depth = 0\n        for char in group_string:\n            if char == '(':\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif char == ')':\n                current_depth -= 1\n            # Assumes input contains only '(', ')', and space characters as per specification.\n        results.append(max_depth)\n    return results"}
{"task_id": "HumanEval/6", "solution": "from typing import List\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n\n    def _calculate_group_depth(group: str) -> int:\n        \"\"\"Calculates the deepest nesting level for a single parenthesis group.\n        Handles unbalanced groups gracefully by not allowing depth to go below zero.\"\"\"\n        current_depth = 0\n        max_depth = 0\n        for char in group:\n            if char == '(':\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif char == ')':\n                current_depth = max(0, current_depth - 1)\n            # Other characters are ignored.\n        return max_depth\n\n    if not paren_string:\n        return []\n\n    groups = paren_string.split(' ')\n    results: List[int] = []\n    for group in groups:\n        if group:  # Process only non-empty group strings.\n            results.append(_calculate_group_depth(group))\n    return results"}
