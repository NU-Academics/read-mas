{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"\n    Checks if a string's length is a prime number.\n    Returns True if the length is prime, False otherwise.\n    \"\"\"\n\n    def _is_prime(n: int) -> bool:\n        \"\"\"\n        Determines if an integer is a prime number.\n        Uses an optimized trial division algorithm.\n        \"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        \n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    length = len(string)\n    return _is_prime(length)"}
{"task_id": "HumanEval/82", "solution": "import math\ndef prime_length(string):\n    \"\"\"\n    Checks if the length of a given string is a prime number.\n    Returns True if the string length is prime, False otherwise.\n    \"\"\"\n    if not isinstance(string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    n = len(string)\n\n    # A prime number is a natural number greater than 1 that has no positive divisors other than 1 and itself.\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:  # All even numbers greater than 2 are not prime.\n        return False\n\n    # Check for divisors from 3 up to the square root of n, incrementing by 2 (only odd divisors).\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        if n % i == 0:\n            return False\n    return True"}
{"task_id": "HumanEval/82", "solution": "def _is_prime(n: int) -> bool:\n    \"\"\"\n    Determines if a given integer n is a prime number.\n    Uses an optimized trial division algorithm.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:  # 2 and 3 are prime\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\ndef prime_length(string: str) -> bool:\n    \"\"\"\n    Checks if the length of a string is a prime number.\n    Returns True if the length is prime, False otherwise.\n    \"\"\"\n    if not isinstance(string, str):\n        raise TypeError(\"Input must be a string.\")\n    length = len(string)\n    return _is_prime(length)"}
{"task_id": "HumanEval/82", "solution": "import math\ndef is_prime(n: int) -> bool:\n    \"\"\"Checks if an integer is a prime number, handling rules for 0, 1, and 2.\n    It raises TypeError for non-integers and ValueError for negative inputs.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        if n % i == 0:\n            return False\n    return True\ndef prime_length(string: str) -> bool:\n    \"\"\"Checks if the length of the input string is a prime number.\n    It raises a TypeError if the input is not a string.\n    \"\"\"\n    if not isinstance(string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    length = len(string)\n    return is_prime(length)"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    # Validate input 'n' as per functional requirement FR1 and NFR3.\n    # Raises ValueError if n is not a positive integer.\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"Input 'n' must be a positive integer (n >= 1).\")\n\n    # Handle the base case for n=1 as per business rule BR2.\n    # The only 1-digit positive integer starting or ending with 1 is '1'.\n    if n == 1:\n        return 1\n    \n    # Calculate counts using the principle of inclusion-exclusion for n > 1.\n    # This involves counting numbers starting with 1, ending with 1, and both.\n\n    # Count of n-digit numbers starting with 1 (FR2).\n    # The first digit is 1, and the remaining (n-1) digits can be any from 0-9.\n    count_starts_with_1 = 10**(n - 1)\n\n    # Count of n-digit numbers ending with 1 (FR3).\n    # The first digit can be 1-9 (9 options), and the middle (n-2) digits can be 0-9.\n    count_ends_with_1 = 9 * (10**(n - 2))\n\n    # Count of n-digit numbers starting AND ending with 1 (FR4).\n    # The first digit is 1, the last digit is 1, and the middle (n-2) digits can be 0-9.\n    count_starts_and_ends_with_1 = 10**(n - 2)\n    \n    # Return the total count using the inclusion-exclusion principle (FR5).\n    # Total = (Starts with 1) + (Ends with 1) - (Starts AND Ends with 1).\n    return count_starts_with_1 + count_ends_with_1 - count_starts_and_ends_with_1"}
