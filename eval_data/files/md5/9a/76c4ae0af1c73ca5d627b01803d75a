{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr):\n    \"\"\"Determines if an array can be sorted by right shifts.\n    Returns True if sortable, False otherwise.\n    \"\"\"\n\n    def _is_sorted(sub_arr):\n        \"\"\"Checks if the given array is sorted in non-decreasing order.\"\"\"\n        for i in range(len(sub_arr) - 1):\n            if sub_arr[i] > sub_arr[i+1]:\n                return False\n        return True\n\n    if not arr:\n        return True\n\n    descent_points = []\n    for i in range(len(arr) - 1):\n        if arr[i] > arr[i+1]:\n            descent_points.append(i)\n\n    if not descent_points:\n        return True\n\n    if len(descent_points) > 1:\n        return False\n\n    pivot_idx = descent_points[0]\n    rotated_arr = arr[pivot_idx + 1:] + arr[:pivot_idx + 1]\n    \n    return _is_sorted(rotated_arr)"}
{"task_id": "HumanEval/109", "solution": "from typing import List\nclass ArrayUtils:\n    \"\"\"Utility class for common array operations.\"\"\"\n    @staticmethod\n    def is_sorted(arr: List[int]) -> bool:\n        \"\"\"Checks if an array is sorted in non-decreasing order.\n        Handles empty arrays and iterates to find any decreasing pair.\"\"\"\n        if not arr:\n            return True\n        for i in range(len(arr) - 1):\n            if arr[i] > arr[i+1]:\n                return False\n        return True\nclass BallShifter:\n    \"\"\"Core logic for determining if an array can be sorted by right-shifting.\"\"\"\n    @staticmethod\n    def can_sort_by_shifting(arr: List[int]) -> bool:\n        \"\"\"Determines if the given array can be sorted into non-decreasing order\n        by performing right shift operations.\n        It identifies descents and checks if a single rotation can sort it.\"\"\"\n        n = len(arr)\n        if n <= 1:\n            return True\n\n        descent_points = []\n        for i in range(n - 1):\n            if arr[i] > arr[i+1]:\n                descent_points.append(i)\n\n        if not descent_points:\n            return True # Array is already sorted\n        \n        if len(descent_points) > 1:\n            return False # More than one descent implies not sortable by a single rotation\n\n        # Exactly one descent point found\n        break_point_idx = descent_points[0]\n\n        # Construct the candidate array after one rotation\n        # The elements after the breakpoint become the start,\n        # and elements up to and including the breakpoint become the end.\n        candidate_arr = arr[break_point_idx + 1:] + arr[:break_point_idx + 1]\n        \n        return ArrayUtils.is_sorted(candidate_arr)\ndef move_one_ball(arr: List[int]) -> bool:\n    \"\"\"We have an array 'arr' of N integers arr[1], arr[2], ..., arr[N]. The\n    numbers in the array will be randomly ordered. Your task is to determine if\n    it is possible to get an array sorted in non-decreasing order by performing \n    the following operation on the given array:\n        You are allowed to perform right shift operation any number of times.\n    \n    One right shift operation means shifting all elements of the array by one\n    position in the right direction. The last element of the array will be moved to\n    the starting position in the array i.e. 0th index. \n\n    If it is possible to obtain the sorted array by performing the above operation\n    then return True else return False.\n    If the given array is empty then return True.\n\n    Note: The given list is guaranteed to have unique elements.\n\n    For Example:\n    \n    move_one_ball([3, 4, 5, 1, 2])==>True\n    Explanation: By performin 2 right shift operations, non-decreasing order can\n                 be achieved for the given array.\n    move_one_ball([3, 5, 4, 1, 2])==>False\n    Explanation:It is not possible to get non-decreasing order for the given\n                array by performing any number of right shift operations.\n                \n    \"\"\"\n    return BallShifter.can_sort_by_shifting(arr)"}
{"task_id": "HumanEval/109", "solution": "from typing import List\ndef move_one_ball(arr: List[int]) -> bool:\n    \"\"\"\n    Determines if an array can be sorted in non-decreasing order by\n    performing zero or more right shift operations.\n    The array is guaranteed to have unique elements.\n    \"\"\"\n    n = len(arr)\n\n    if n <= 1:\n        return True  # An empty or single-element array is considered sorted.\n\n    # Count the number of descents (where an element is greater than its subsequent element).\n    descent_count = 0\n    for i in range(n - 1):\n        if arr[i] > arr[i+1]:\n            descent_count += 1\n\n    if descent_count == 0:\n        return True  # The array is already in non-decreasing order.\n\n    if descent_count == 1:\n        # With exactly one descent, it must be a rotated sorted array.\n        # The last element must be less than or equal to the first element to complete the sort.\n        return arr[-1] <= arr[0]\n    \n    return False  # More than one descent indicates it cannot be sorted by a single rotation."}
{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr):\n    \"\"\"Determines if an array can be sorted in non-decreasing order by\n    performing right shift operations. Returns True if possible, False otherwise.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return True\n\n    # Find the index of the minimum element in the array.\n    min_idx = 0\n    for i in range(1, n):\n        if arr[i] < arr[min_idx]:\n            min_idx = i\n\n    # Construct the array rotated so the minimum element is at the beginning.\n    rotated_arr = arr[min_idx:] + arr[:min_idx]\n\n    # Check if this rotated array is sorted in non-decreasing order.\n    for i in range(n - 1):\n        if rotated_arr[i] > rotated_arr[i+1]:\n            return False\n    return True"}
{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr: list[int]) -> bool:\n    \"\"\"\n    Determines if an array can be sorted by right shift operations.\n    Returns True if sortable, False otherwise.\n    \"\"\"\n    n = len(arr)\n\n    if n <= 1:\n        return True\n\n    def _is_sorted(current_arr: list[int]) -> bool:\n        \"\"\"Checks if a list is sorted in non-decreasing order.\"\"\"\n        return all(current_arr[i] <= current_arr[i+1] for i in range(len(current_arr) - 1))\n\n    def _right_shift(current_arr: list[int]) -> list[int]:\n        \"\"\"Performs a single right-shift operation on the list.\"\"\"\n        return [current_arr[-1]] + current_arr[:-1]\n\n    current_arr = list(arr)\n\n    for _ in range(n):\n        if _is_sorted(current_arr):\n            return True\n        current_arr = _right_shift(current_arr)\n\n    return False"}
{"task_id": "HumanEval/109", "solution": "from typing import List\nclass ArrayUtils:\n    \"\"\"\n    Utility class for common array operations.\n    \"\"\"\n\n    @staticmethod\n    def is_sorted(arr: List[int]) -> bool:\n        \"\"\"Checks if the given array is sorted in non-decreasing order.\"\"\"\n        if not arr:\n            return True\n        return all(arr[i] <= arr[i+1] for i in range(len(arr) - 1))\n\n    @staticmethod\n    def right_shift(arr: List[int]) -> List[int]:\n        \"\"\"Performs a single right-shift operation on the array, returning a new list.\"\"\"\n        if not arr:\n            return []\n        return [arr[-1]] + arr[:-1]\nclass ArraySorter:\n    \"\"\"Core logic for checking if an array can be sorted by right shifts.\"\"\"\n    def __init__(self, utils: ArrayUtils):\n        self._utils = utils\n\n    def can_sort_by_right_shift(self, arr: List[int]) -> bool:\n        \"\"\"\n        Determines if the array can be sorted into non-decreasing order by any number of right shifts.\n        \"\"\"\n        if not arr:\n            return True  # Empty array is considered sorted\n\n        n = len(arr)\n        current_arr = list(arr) # Create a mutable copy to avoid modifying original\n\n        for _ in range(n): # Check at most N shifts\n            if self._utils.is_sorted(current_arr):\n                return True\n            current_arr = self._utils.right_shift(current_arr)\n            \n        return False\ndef move_one_ball(arr):\n    \"\"\"We have an array 'arr' of N integers arr[1], arr[2], ..., arr[N].The\n    numbers in the array will be randomly ordered. Your task is to determine if\n    it is possible to get an array sorted in non-decreasing order by performing \n    the following operation on the given array:\n        You are allowed to perform right shift operation any number of times.\n    \n    One right shift operation means shifting all elements of the array by one\n    position in the right direction. The last element of the array will be moved to\n    the starting position in the array i.e. 0th index. \n\n    If it is possible to obtain the sorted array by performing the above operation\n    then return True else return False.\n    If the given array is empty then return True.\n\n    Note: The given list is guaranteed to have unique elements.\n\n    For Example:\n    \n    move_one_ball([3, 4, 5, 1, 2])==>True\n    Explanation: By performin 2 right shift operations, non-decreasing order can\n                 be achieved for the given array.\n    move_one_ball([3, 5, 4, 1, 2])==>False\n    Explanation:It is not possible to get non-decreasing order for the given\n                array by performing any number of right shift operations.\n                \n    \"\"\"\n    sorter = ArraySorter(ArrayUtils())\n    return sorter.can_sort_by_right_shift(arr)"}
{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr: list[int]) -> bool:\n    \"\"\"\n    Determines if an array can be sorted in non-decreasing order by performing\n    right shift operations.\n\n    Args:\n        arr: The input list of integers.\n\n    Returns:\n        True if the array can be sorted by right shifts, False otherwise.\n    \"\"\"\n    # An empty array is considered sorted.\n    if not arr:\n        return True\n\n    # Create a non-decreasing sorted version of the array.\n    sorted_arr = sorted(arr)\n\n    # Find the index of arr[0] within the sorted array.\n    # This identifies the potential \"break\" point if arr is a rotation.\n    try:\n        start_idx = sorted_arr.index(arr[0])\n    except ValueError:\n        # This case should ideally not happen if arr is a permutation of sorted_arr,\n        # but as a safeguard, if arr[0] is not found, it's not a rotation.\n        return False\n\n    # Rotate the sorted array to align its first element with arr[0].\n    expected_arr = sorted_arr[start_idx:] + sorted_arr[:start_idx]\n\n    # Compare the original array with the constructed rotated sorted array.\n    return arr == expected_arr"}
{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr):\n    \"\"\"Checks if an array can be sorted non-decreasingly by right shifts.\n    It returns True for empty or single-element arrays, or if it's a rotated sorted array with at most one \"descent\" point.\n    \"\"\"\n    length = len(arr)\n\n    # FR1, FR2: Handle empty or single-element arrays, which are always considered sorted.\n    if length <= 1:\n        return True\n\n    descent_count = 0\n    # FR3: Count the number of \"descent\" points where arr[i] > arr[i+1].\n    for i in range(length - 1):\n        if arr[i] > arr[i+1]:\n            descent_count += 1\n\n    # FR4: If no descents, the array is already sorted.\n    if descent_count == 0:\n        return True\n    # FR5: If exactly one descent, check if the wrap-around condition holds (last <= first).\n    elif descent_count == 1:\n        return arr[length - 1] <= arr[0]\n    # FR6: More than one descent means it's not a rotated sorted array.\n    else:\n        return False"}
