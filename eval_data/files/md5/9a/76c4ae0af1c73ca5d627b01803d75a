{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int) -> int:\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    This function uses an optimized trial division algorithm.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    largest_factor = 1\n\n    # Handle factor 2\n    while n % 2 == 0:\n        largest_factor = 2\n        n //= 2\n\n    # Handle odd factors from 3 up to the square root of n.\n    # We increment by 2 to check only odd numbers.\n    d = 3\n    while d * d <= n:\n        while n % d == 0:\n            largest_factor = d\n            n //= d\n        d += 2\n\n    # If n is still greater than 2, the remaining n is the largest prime factor.\n    # This covers cases where n was reduced to a prime greater than 2.\n    if n > 2:\n        largest_factor = n\n\n    return largest_factor"}
{"task_id": "HumanEval/58", "solution": "from typing import List, Any, Set\ndef common(l1: List[Any], l2: List[Any]) -> List[Any]:\n    \"\"\"Return sorted unique common elements for two lists.\n    >>> common([1, 4, 3, 34, 653, 2, 5], [5, 7, 1, 5, 9, 653, 121])\n    [1, 5, 653]\n    >>> common([5, 3, 2, 8], [3, 2])\n    [2, 3]\n    \"\"\"\n    set1: Set[Any] = set(l1)\n    set2: Set[Any] = set(l2)\n    \n    common_set: Set[Any] = set1.intersection(set2)\n    \n    result_list: List[Any] = list(common_set)\n    result_list.sort()\n    \n    return result_list"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int) -> int:\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    largest_factor = 1\n    current_n = n\n\n    # Handle factor 2.\n    while current_n % 2 == 0:\n        largest_factor = 2\n        current_n //= 2\n\n    i = 3\n    # Check odd factors up to the square root of current_n.\n    while i * i <= current_n:\n        while current_n % i == 0:\n            largest_factor = i\n            current_n //= i\n        i += 2\n\n    # If a factor remains, it must be the largest prime factor.\n    if current_n > 2:\n        largest_factor = current_n\n\n    return largest_factor"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int) -> int:\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    largest_factor = 1\n    current_n = n\n\n    # Remove all factors of 2.\n    while current_n % 2 == 0:\n        largest_factor = 2\n        current_n //= 2\n\n    # Check for odd factors starting from 3 up to sqrt(current_n).\n    divisor = 3\n    while divisor * divisor <= current_n:\n        while current_n % divisor == 0:\n            largest_factor = divisor\n            current_n //= divisor\n        divisor += 2\n\n    # If current_n is still greater than 1, it must be the largest prime factor.\n    if current_n > 1:\n        largest_factor = max(largest_factor, current_n)\n\n    return largest_factor"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int) -> int:\n    \"\"\"\n    Return the largest prime factor of n.\n    Assumes n > 1 and is not a prime number.\n    \"\"\"\n    largest_factor = 1\n    temp_n = n\n\n    # Handle factor 2 as a special case.\n    while temp_n % 2 == 0:\n        largest_factor = 2\n        temp_n //= 2\n\n    # Iterate through odd factors up to the square root of temp_n.\n    d = 3\n    while d * d <= temp_n:\n        while temp_n % d == 0:\n            largest_factor = d\n            temp_n //= d\n        d += 2\n\n    # If temp_n remains greater than 2, it is the largest prime factor.\n    if temp_n > 2:\n        largest_factor = temp_n\n\n    return largest_factor"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n <= 1:\n        raise ValueError(\"Input 'n' must be greater than 1.\")\n\n    largest_factor = -1\n    current_n = n\n\n    # Handle factor 2.\n    while current_n % 2 == 0:\n        largest_factor = 2\n        current_n //= 2\n\n    # Iterate for odd factors from 3 up to sqrt(current_n).\n    # `i * i <= current_n` efficiently checks `i <= sqrt(current_n)`.\n    i = 3\n    while i * i <= current_n:\n        while current_n % i == 0:\n            largest_factor = i\n            current_n //= i\n        i += 2\n\n    # If remaining `current_n` is greater than 2, it is the largest prime factor.\n    if current_n > 2:\n        largest_factor = current_n\n\n    return largest_factor"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int) -> int:\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    largest_factor = 1\n\n    # Handle factor 2 and divide n by 2 repeatedly.\n    while n % 2 == 0:\n        largest_factor = 2\n        n //= 2\n\n    # Iterate through odd factors up to sqrt(n).\n    i = 3\n    while i * i <= n:\n        while n % i == 0:\n            largest_factor = i\n            n //= i\n        i += 2  # Increment by 2 to check only odd numbers.\n\n    # If n remains greater than 1, it is the largest prime factor.\n    if n > 1:\n        largest_factor = n\n\n    return largest_factor"}
{"task_id": "HumanEval/59", "solution": "import math\ndef largest_prime_factor(n: int) -> int:\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    largest_factor = 1\n\n    # Handle factor 2.\n    while n % 2 == 0:\n        largest_factor = 2\n        n //= 2\n\n    # Handle odd factors up to sqrt(n).\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        while n % i == 0:\n            largest_factor = i\n            n //= i\n\n    # If n remains greater than 2, it is the largest prime factor.\n    if n > 2:\n        largest_factor = n\n\n    return largest_factor"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int) -> int:\n    \"\"\"Return the largest prime factor of n. Assumes n > 1 and is not a prime.\n    This function iteratively divides n by its smallest prime factors to find the largest one.\n    \"\"\"\n    largest_factor = -1\n\n    # Handle factor 2\n    while n % 2 == 0:\n        largest_factor = 2\n        n //= 2\n\n    # Handle odd factors from 3 up to sqrt(n)\n    i = 3\n    while i * i <= n:\n        while n % i == 0:\n            largest_factor = i\n            n //= i\n        i += 2\n\n    # If n is still greater than 2, it must be a prime factor itself\n    if n > 2:\n        largest_factor = n\n\n    return largest_factor"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    largest_factor = -1\n    temp_n = n\n\n    while temp_n % 2 == 0:\n        largest_factor = 2\n        temp_n //= 2\n\n    i = 3\n    while i * i <= temp_n:\n        while temp_n % i == 0:\n            largest_factor = i\n            temp_n //= i\n        i += 2\n\n    if temp_n > 2:\n        largest_factor = temp_n\n\n    return largest_factor"}
{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int):\n    \"\"\"\n    Calculates the sum of all positive integers from 1 up to a given number 'n'.\n    Raises ValueError if 'n' is not a positive integer (i.e., less than 1).\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input 'n' must be an integer.\")\n    if n < 1:\n        raise ValueError(\"Input 'n' must be a positive integer (>= 1).\")\n\n    return n * (n + 1) // 2"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int) -> int:\n    \"\"\"Return the largest prime factor of n.\n    Assumes n > 1 and is not a prime.\n    \"\"\"\n\n    def is_prime(k: int) -> bool:\n        \"\"\"Checks if an integer k is prime. Helper for largest_prime_factor.\"\"\"\n        if k < 2:\n            return False\n        if k == 2:\n            return True\n        if k % 2 == 0:\n            return False\n        i = 3\n        while i * i <= k:\n            if k % i == 0:\n                return False\n            i += 2\n        return True\n\n    max_prime = -1\n\n    # Handle factor 2 repeatedly.\n    while n % 2 == 0:\n        max_prime = 2\n        n //= 2\n\n    # Iterate through odd numbers as potential factors.\n    i = 3\n    while i * i <= n:\n        while n % i == 0:\n            max_prime = i\n            n //= i\n        i += 2\n\n    # If n is still greater than 2, it is the largest prime factor.\n    if n > 2 and is_prime(n):\n        max_prime = n\n\n    return max_prime"}
{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int):\n    \"\"\"sum_to_n is a function that sums numbers from 1 to n.\n    >>> sum_to_n(30)\n    465\n    >>> sum_to_n(100)\n    5050\n    >>> sum_to_n(5)\n    15\n    >>> sum_to_n(10)\n    55\n    >>> sum_to_n(1)\n    1\n    \"\"\"\n    return n * (n + 1) // 2"}
