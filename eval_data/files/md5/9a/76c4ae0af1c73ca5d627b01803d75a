{"task_id": "HumanEval/25", "solution": "from typing import List\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input to the factorization function.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass PrimeFactorizerService:\n    \"\"\"Service class to encapsulate the core prime factorization logic. Designed to be stateless.\"\"\"\n    def _factorize_logic(self, n: int) -> List[int]:\n        \"\"\"Returns a list of prime factors of a given positive integer n. Assumes n is a valid positive integer (n >= 1).\"\"\"\n        factors: List[int] = []\n        d = 2\n        temp_n = n\n\n        while d * d <= temp_n:\n            while temp_n % d == 0:\n                factors.append(d)\n                temp_n //= d\n            d += 1\n\n        if temp_n > 1:\n            factors.append(temp_n)\n\n        return factors\ndef factorize(n: int) -> List[int]:\n    \"\"\"Returns a list of prime factors of a positive integer n. Factors are ordered smallest to largest, with repetitions.\"\"\"\n    if not isinstance(n, int):\n        raise InvalidInputError(\"Input 'n' must be an integer.\")\n    if n < 1:\n        raise InvalidInputError(\"Input 'n' must be a positive integer (n >= 1).\")\n    if n == 1:\n        return []\n\n    service = PrimeFactorizerService()\n    return service._factorize_logic(n)"}
{"task_id": "HumanEval/25", "solution": "from typing import List\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input to factorization functions.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass InputValidator:\n    \"\"\"Utility class for validating input parameters.\"\"\"\n\n    @staticmethod\n    def validate_integer(n: int) -> None:\n        \"\"\"\n        Validates that n is an integer and n >= 1.\n        Raises InvalidInputError if validation fails.\n        \"\"\"\n        if not isinstance(n, int):\n            raise InvalidInputError(f\"Input must be an integer, got {type(n).__name__}.\")\n        if n < 1:\n            raise InvalidInputError(f\"Input must be a positive integer (>= 1), got {n}.\")\nclass FactorizationService:\n    \"\"\"Service responsible for performing prime factorization.\"\"\"\n\n    def factorize(self, n: int) -> List[int]:\n        \"\"\"\n        Returns a list of prime factors of a given integer n,\n        ordered from smallest to largest, with multiplicity.\n        Assumes n is a valid positive integer (n >= 1).\n        \"\"\"\n        if n == 1:\n            return []\n\n        factors: List[int] = []\n        d = 2\n        temp_n = n\n\n        while d * d <= temp_n:\n            while temp_n % d == 0:\n                factors.append(d)\n                temp_n //= d\n            d += 1\n\n        if temp_n > 1:\n            factors.append(temp_n)\n\n        return factors\ndef factorize(n: int) -> List[int]:\n    \"\"\"\n    Return a list of prime factors of a given integer, ordered smallest to largest, with each factor appearing according to its multiplicity.\n    The product of all factors in the list will equal the original input `n`.\n\n    Args:\n        n (int): The positive integer to factorize. Must be >= 1.\n\n    Returns:\n        List[int]: A list of prime factors.\n\n    Raises:\n        InvalidInputError: If n is not an integer or n < 1.\n\n    Examples:\n        >>> factorize(8)\n        [2, 2, 2]\n        >>> factorize(25)\n        [5, 5]\n        >>> factorize(70)\n        [2, 5, 7]\n        >>> factorize(1)\n        []\n    \"\"\"\n    InputValidator.validate_integer(n)\n    service = FactorizationService()\n    return service.factorize(n)"}
{"task_id": "HumanEval/25", "solution": "from typing import List\ndef factorize(n: int) -> List[int]:\n    \"\"\"Returns a list of prime factors for a given integer `n`.\n    Factors are in ascending order and listed with their correct multiplicity.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n\n    if n <= 1:\n        return []\n\n    factors: List[int] = []\n    d = 2\n    temp_n = n\n\n    while d * d <= temp_n:\n        while temp_n % d == 0:\n            factors.append(d)\n            temp_n //= d\n        d += 1\n    if temp_n > 1:\n        factors.append(temp_n)\n\n    return factors"}
{"task_id": "HumanEval/25", "solution": "from typing import List\nfrom math import sqrt\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input values.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef factorize(n: int) -> List[int]:\n    \"\"\"Returns a list of prime factors for a given integer n, ordered smallest to largest, with correct multiplicities.\n    The product of factors equals n.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise InvalidInputError(\"Input 'n' must be a positive integer.\")\n    if n == 1:\n        return []\n\n    factors: List[int] = []\n    temp_n = n\n\n    # Handle factor 2.\n    while temp_n % 2 == 0:\n        factors.append(2)\n        temp_n //= 2\n\n    # Handle odd factors. Iterates up to sqrt(temp_n) for efficiency.\n    d = 3\n    while d * d <= temp_n:\n        while temp_n % d == 0:\n            factors.append(d)\n            temp_n //= d\n        d += 2\n\n    # If temp_n is still greater than 1, it must be a prime factor itself.\n    if temp_n > 1:\n        factors.append(temp_n)\n\n    return factors"}
{"task_id": "HumanEval/25", "solution": "from typing import List\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception raised for invalid input to the factorizer.\n    Initializes with a specific error message.\"\"\"\n    def __init__(self, message: str = \"Input must be a positive integer.\"):\n        super().__init__(message)\n        self.message = message\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    if not isinstance(n, int):\n        raise InvalidInputError(\"Input must be an integer.\")\n    if n <= 0:\n        raise InvalidInputError(\"Input must be a positive integer.\")\n    if n == 1:\n        return []\n\n    factors: List[int] = []\n    divisor = 2\n\n    while n > 1:\n        while n % divisor == 0:\n            factors.append(divisor)\n            n //= divisor\n        divisor += 1\n        # If divisor*divisor > n, then n must be prime and the last remaining factor.\n        if divisor * divisor > n and n > 1:\n            factors.append(n)\n            break\n    return factors"}
{"task_id": "HumanEval/26", "solution": "from typing import List\nfrom collections import Counter\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    >>> remove_duplicates([1, 2, 3, 2, 4])\n    [1, 3, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    # Count occurrences of each number to identify duplicates.\n    counts = Counter(numbers)\n\n    # Build the result list by appending only elements that appear exactly once, preserving original order.\n    result = []\n    for num in numbers:\n        if counts[num] == 1:\n            result.append(num)\n    return result"}
{"task_id": "HumanEval/25", "solution": "from typing import List\ndef factorize(n: int) -> List[int]:\n    \"\"\"Returns a list of prime factors for a given positive integer n, ordered smallest to largest, with correct multiplicities.\n    The product of these factors will equal n.\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n    if n <= 0:\n        raise ValueError(\"Input must be a positive integer.\")\n    if n == 1:\n        return []\n\n    factors: List[int] = []\n    temp_n = n\n\n    # Divide by 2 until temp_n is odd\n    while temp_n % 2 == 0:\n        factors.append(2)\n        temp_n //= 2\n\n    # Check for odd factors from 3 up to sqrt(temp_n)\n    d = 3\n    while d * d <= temp_n:\n        while temp_n % d == 0:\n            factors.append(d)\n            temp_n //= d\n        d += 2\n\n    # If temp_n is still greater than 1, it must be a prime factor itself\n    if temp_n > 1:\n        factors.append(temp_n)\n\n    return factors"}
{"task_id": "HumanEval/26", "solution": "from typing import List\nfrom collections import Counter\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    >>> remove_duplicates([1, 2, 3, 2, 4])\n    [1, 3, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    # Count occurrences of each number in the list.\n    counts = Counter(numbers)\n\n    # Build the result list, keeping only elements that appeared exactly once.\n    result = [num for num in numbers if counts[num] == 1]\n\n    return result"}
{"task_id": "HumanEval/26", "solution": "from typing import List\nfrom collections import Counter\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    >>> remove_duplicates([1, 2, 3, 2, 4])\n    [1, 3, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    # Count occurrences of each number using a frequency map.\n    counts = Counter(numbers)\n\n    # Build the result list, retaining only elements that appeared exactly once.\n    result = [num for num in numbers if counts[num] == 1]\n\n    return result"}
{"task_id": "HumanEval/26", "solution": "from typing import List\nfrom collections import Counter\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    >>> remove_duplicates([1, 2, 3, 2, 4])\n    [1, 3, 4]\n    \"\"\"\n    # Calculate frequencies of all numbers in the input list.\n    frequencies = Counter(numbers)\n\n    result = []\n    # Iterate through the original list to preserve order.\n    for num in numbers:\n        # If a number appears exactly once, add it to the result.\n        if frequencies[num] == 1:\n            result.append(num)\n\n    return result"}
{"task_id": "HumanEval/26", "solution": "from typing import List\nfrom collections import Counter\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\"\n    Removes all elements that occur more than once from a list of integers.\n    Preserves the relative order of the remaining unique elements.\n    \"\"\"\n    if not numbers:\n        return []\n\n    counts = Counter(numbers)\n    result = [num for num in numbers if counts[num] == 1]\n    return result"}
{"task_id": "HumanEval/26", "solution": "from typing import List\nfrom collections import Counter\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    >>> remove_duplicates([1, 2, 3, 2, 4])\n    [1, 3, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    # Count the frequency of each number in the list.\n    frequencies = Counter(numbers)\n\n    # Filter the original list, keeping only numbers that appeared exactly once.\n    result = [num for num in numbers if frequencies[num] == 1]\n\n    return result"}
{"task_id": "HumanEval/26", "solution": "from typing import List\nfrom collections import Counter\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\"From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(f\"\\'numbers\\' must be a list, but got {type(numbers).__name__}\")\n\n    for i, item in enumerate(numbers):\n        if not isinstance(item, int):\n            raise ValueError(\n                f\"All elements in \\'numbers\\' must be integers, \"\n                f\"but element at index {i} is of type {type(item).__name__}\"\n            )\n\n    counts = Counter(numbers)\n    result = [item for item in numbers if counts[item] == 1]\n    return result"}
{"task_id": "HumanEval/26", "solution": "from typing import List\nfrom collections import Counter\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\"Filters a list of integers, retaining only elements that appear exactly once.\n    The original relative order of the unique elements is preserved.\n    \"\"\"\n    counts = Counter(numbers)\n    result = []\n    for num in numbers:\n        if counts[num] == 1:\n            result.append(num)\n    return result"}
