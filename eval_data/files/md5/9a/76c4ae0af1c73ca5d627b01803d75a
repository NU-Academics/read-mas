{"task_id": "HumanEval/125", "solution": "import re\nfrom typing import Union\ndef _count_odd_order_letters(txt: str) -> int:\n    \"\"\"\n    Counts lowercase English letters in a string that have an odd\n    alphabetical order (0-indexed: a=0, b=1, ...).\n    \"\"\"\n    count = 0\n    for char in txt:\n        if 'a' <= char <= 'z':\n            order = ord(char) - ord('a')\n            if order % 2 != 0:\n                count += 1\n    return count\ndef split_words(txt: str) -> Union[list[str], int]:\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    Examples\n    split_words(\"Hello world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"Hello,world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"abcdef\") == 3 \n    '''\n    if not isinstance(txt, str):\n        raise TypeError(\"Input must be a string.\")\n\n    if re.search(r'\\s', txt):\n        return txt.split()\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        return _count_odd_order_letters(txt)"}
{"task_id": "HumanEval/124", "solution": "import re\nDATE_FORMAT_REGEX = re.compile(r'^(\\d{2})-(\\d{2})-(\\d{4})$')\nMONTH_DAYS_MAP = {\n    1: 31, 3: 31, 5: 31, 7: 31, 8: 31, 10: 31, 12: 31,\n    4: 30, 6: 30, 9: 30, 11: 30,\n    2: 29\n}\ndef valid_date(date):\n    \"\"\"\n    Validates a given date string based on specified rules.\n    Returns True if the date is valid, otherwise False.\n    \"\"\"\n    # BR1: Date string must not be empty, also handles non-string inputs.\n    if not isinstance(date, str) or not date:\n        return False\n\n    # FR2 / BR2: The system shall parse the `date_str` to ensure it adheres to \"mm-dd-yyyy\" format.\n    match = DATE_FORMAT_REGEX.match(date)\n    if not match:\n        return False\n\n    try:\n        month = int(match.group(1))\n        day = int(match.group(2))\n        year = int(match.group(3)) # Year is extracted, but no further logical validation specified.\n    except ValueError:\n        return False # Catches cases where regex groups might not convert to integers.\n\n    # FR3 / BR3: The month must be between 1 and 12.\n    if not (1 <= month <= 12):\n        return False\n\n    # FR4 / BR4, BR5, BR6: The day must be within the valid range for the given month.\n    if not (1 <= day):\n        return False\n    \n    max_days = MONTH_DAYS_MAP.get(month)\n    if max_days is None or day > max_days:\n        return False\n\n    return True"}
{"task_id": "HumanEval/125", "solution": "import re\ndef split_words(txt):\n    \"\"\"\n    Processes a string by splitting on whitespace, then comma, or counting specific lowercase letters.\n    Counts lowercase letters with odd 0-indexed alphabetical order if no split condition is met.\n    \"\"\"\n    if re.search(r'\\s', txt):\n        return txt.split()\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        count = 0\n        for char in txt:\n            if 'a' <= char <= 'z':\n                order = ord(char) - ord('a')\n                if order % 2 != 0:\n                    count += 1\n        return count"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    \"\"\"\n    Splits a string by whitespace, then by commas, or counts odd-ordered lowercase letters as a fallback.\n    Alphabetical order starts at 0 for 'a'.\n    \"\"\"\n    if not isinstance(txt, str):\n        raise TypeError(\"Input must be a string.\")\n    if not txt:\n        raise ValueError(\"Input string cannot be empty.\")\n\n    if any(c.isspace() for c in txt):\n        # Split by whitespace if present.\n        return txt.split()\n    elif ',' in txt:\n        # Split by comma if no whitespace is present.\n        return txt.split(',')\n    else:\n        # Count odd-ordered lowercase letters if neither delimiter is found.\n        count = 0\n        for char in txt:\n            if 'a' <= char <= 'z':\n                order = ord(char) - ord('a')\n                if order % 2 != 0:\n                    count += 1\n        return count"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    \"\"\"\n    Given a string, this function processes it based on specific splitting rules.\n    It returns a list of words or a numerical count based on the content and presence of delimiters.\n    \"\"\"\n    if not isinstance(txt, str):\n        raise TypeError(\"Input must be a string.\")\n\n    # FR1: Split by whitespace if present. Whitespace splitting takes precedence.\n    if any(char.isspace() for char in txt):\n        return txt.split()\n\n    # FR2: Split by commas if no whitespace is present.\n    elif ',' in txt:\n        return txt.split(',')\n\n    # FR3: Count lowercase letters with odd alphabetical order if no whitespace or commas are present.\n    else:\n        odd_order_count = 0\n        # Alphabetical order is 0-indexed ('a'=0, 'b'=1, ..., 'z'=25).\n        for char in txt:\n            if 'a' <= char <= 'z':\n                order = ord(char) - ord('a')\n                if order % 2 != 0:\n                    odd_order_count += 1\n        return odd_order_count"}
