{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\" xs represent coefficients of a polynomial: xs[0] + xs[1]*x + xs[2]*x^2 + ....\n    This function returns the derivative of the polynomial in the same coefficient list format.\n    \"\"\"\n    if not xs or len(xs) == 1:\n        return []\n\n    derivative_coeffs = []\n    for i in range(1, len(xs)):\n        derivative_coeffs.append(i * xs[i])\n    \n    # Remove trailing zeros to represent the true degree of the derivative polynomial.\n    while derivative_coeffs and derivative_coeffs[-1] == 0:\n        derivative_coeffs.pop()\n\n    return derivative_coeffs"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\\\n     Return derivative of this polynomial in the same form.\n    >>> derivative([3, 1, 2, 4, 5])\n    [1, 4, 12, 20]\n    >>> derivative([1, 2, 3])\n    [2, 6]\n    \"\"\"\n    if not xs or len(xs) == 1:\n        return []\n\n    # Calculate derivative coefficients: the derivative of a_i * x^i is i * a_i * x^(i-1).\n    derivative_coeffs = [i * float(xs[i]) for i in range(1, len(xs))]\n\n    return derivative_coeffs"}
{"task_id": "HumanEval/62", "solution": "from typing import List, Union\nclass InvalidPolynomialError(Exception):\n    \"\"\"Custom exception for invalid polynomial input.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass PolynomialCalculationError(Exception):\n    \"\"\"Custom exception for errors during polynomial calculation.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef derivative(xs: list) -> List[Union[int, float]]:\n    \"\"\"\n    Calculates the derivative of a polynomial represented by its coefficients.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\n    \"\"\"\n    try:\n        # Validate that the input is a list of numeric coefficients.\n        if not isinstance(xs, list):\n            raise InvalidPolynomialError(\"Input must be a list.\")\n        for i, coeff in enumerate(xs):\n            if not isinstance(coeff, (int, float)):\n                raise InvalidPolynomialError(\n                    f\"Coefficient at index {i} is not a number: {coeff}\"\n                )\n\n        # Handle empty list or constant polynomial, derivative is an empty list.\n        if len(xs) <= 1:\n            return []\n\n        # Compute the derivative: for c_i * x^i, derivative is i * c_i * x^(i-1).\n        derivative_coeffs: List[Union[int, float]] = []\n        for i in range(1, len(xs)):\n            derivative_coeffs.append(xs[i] * i)\n        \n        return derivative_coeffs\n    except InvalidPolynomialError:\n        raise\n    except Exception as e:\n        # Catch unexpected errors during calculation.\n        raise PolynomialCalculationError(f\"An unexpected error occurred during derivative calculation: {e}\") from e"}
{"task_id": "HumanEval/62", "solution": "class InvalidPolynomialError(TypeError):\n    \"\"\"Raised when polynomial input is invalid.\"\"\"\n    pass\ndef derivative(xs: list):\n    \"\"\"Calculates the derivative of a polynomial from its coefficients.\n    Returns coefficients of the derivative polynomial as a list of floats.\n    \"\"\"\n    if not isinstance(xs, list):\n        raise InvalidPolynomialError(\"Input must be a list.\")\n    for i, coeff in enumerate(xs):\n        if not isinstance(coeff, (int, float)):\n            raise InvalidPolynomialError(\n                f\"Coefficient at index {i} is not a number: {coeff}\"\n            )\n\n    if not xs or len(xs) == 1:\n        return []\n\n    # Calculate derivative coefficients. The derivative of a_n * x^n is n * a_n * x^(n-1).\n    # The constant term xs[0] differentiates to 0 and is dropped.\n    derivative_coeffs = []\n    for i in range(1, len(xs)):\n        derivative_coeffs.append(float(i * xs[i]))\n\n    return derivative_coeffs"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\n     Return derivative of this polynomial in the same form.\n    >>> derivative([3, 1, 2, 4, 5])\n    [1, 4, 12, 20]\n    >>> derivative([1, 2, 3])\n    [2, 6]\n    \"\"\"\n    if not xs or len(xs) == 1:\n        return []\n\n    # Calculate derivative coefficients using the rule (a*x^n)' = n*a*x^(n-1).\n    # The new list starts from the coefficient of x^1 in the original polynomial.\n    derivative_coeffs = []\n    for i in range(1, len(xs)):\n        derivative_coeffs.append(i * xs[i])\n\n    return derivative_coeffs"}
{"task_id": "HumanEval/62", "solution": "from typing import List, Union\ndef derivative(xs: list) -> list:\n    \"\"\"Calculates the derivative of a polynomial represented by its coefficients.\n    Returns the coefficients of the derivative polynomial in the same form.\n    \"\"\"\n    if not isinstance(xs, list):\n        raise TypeError(\"Input must be a list of coefficients.\")\n\n    for i, coeff in enumerate(xs):\n        if not isinstance(coeff, (int, float)):\n            raise TypeError(f\"Coefficient at index {i} must be a number (int or float).\")\n\n    if not xs or len(xs) == 1:\n        return [] # Derivative of a constant or zero polynomial is the zero polynomial.\n\n    derived_coefficients: List[Union[int, float]] = []\n    for i in range(1, len(xs)):\n        derived_coefficients.append(i * xs[i])\n\n    return derived_coefficients"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\" xs represent coefficients of a polynomial.\n    Returns the coefficients of the derivative polynomial.\n    \"\"\"\n    if not isinstance(xs, list):\n        raise ValueError(\"Input must be a list of coefficients.\")\n    \n    # Validate that all coefficients are numeric.\n    for coeff in xs:\n        if not isinstance(coeff, (int, float)):\n            raise ValueError(\"All coefficients must be numeric.\")\n\n    # Derivative of a constant or empty polynomial is 0.\n    if not xs or len(xs) == 1:\n        return []\n\n    derivative_coeffs = []\n    # Calculate new coefficients using the power rule.\n    for i in range(1, len(xs)):\n        derivative_coeffs.append(xs[i] * i)\n\n    return derivative_coeffs"}
{"task_id": "HumanEval/62", "solution": "from typing import List, Any\nclass InvalidPolynomialError(Exception):\n    \"\"\"Custom exception for invalid polynomial data.\"\"\"\n    pass\ndef is_numeric(value: Any) -> bool:\n    \"\"\"Checks if a given value is an integer or a float. Used for input validation.\"\"\"\n    return isinstance(value, (int, float))\ndef derivative(xs: list) -> list:\n    \"\"\"\n    Calculates the derivative of a polynomial from its coefficients.\n    `xs[i]` is the coefficient for `x^i`, and the result is in the same form.\n    \"\"\"\n    if not isinstance(xs, list):\n        raise InvalidPolynomialError(\"Coefficients must be a list.\")\n    if not all(is_numeric(c) for c in xs):\n        raise InvalidPolynomialError(\"All coefficients must be numeric.\")\n\n    # Handles constant or empty polynomials, returning an empty list for the derivative.\n    if len(xs) <= 1:\n        return []\n\n    derivative_coeffs: List[float] = []\n    # Calculates derivative coefficients by multiplying each coefficient by its original power.\n    for i in range(1, len(xs)):\n        derivative_coeffs.append(float(xs[i]) * i)\n\n    return derivative_coeffs"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list) -> list:\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\n     Return derivative of this polynomial in the same form.\n    >>> derivative([3, 1, 2, 4, 5])\n    [1, 4, 12, 20]\n    >>> derivative([1, 2, 3])\n    [2, 6]\n    \"\"\"\n    if not xs or len(xs) == 1: # Derivative of a constant or empty polynomial is 0\n        return []\n\n    derivative_coeffs: list = []\n    # The derivative of a_i * x^i is i * a_i * x^(i-1)\n    # So, the new coefficient for x^(i-1) is i * a_i\n    # We start from index 1 because derivative of a_0 (constant) is 0\n    for i in range(1, len(xs)):\n        derivative_coeffs.append(i * xs[i])\n\n    return derivative_coeffs"}
{"task_id": "HumanEval/63", "solution": "def fibfib(n: int):\n    \"\"\"The FibFib number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fibfib(0) == 0\n    fibfib(1) == 0\n    fibfib(2) == 1\n    fibfib(n) == fibfib(n-1) + fibfib(n-2) + fibfib(n-3).\n    Please write a function to efficiently compute the n-th element of the fibfib number sequence.\n    >>> fibfib(1)\n    0\n    >>> fibfib(5)\n    4\n    >>> fibfib(8)\n    24\n    \"\"\"\n    if not hasattr(fibfib, '_memo'):\n        fibfib._memo = {\n            0: 0,\n            1: 0,\n            2: 1\n        }\n\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    if n in fibfib._memo:\n        return fibfib._memo[n]\n\n    result = fibfib(n - 1) + fibfib(n - 2) + fibfib(n - 3)\n    fibfib._memo[n] = result\n    return result"}
{"task_id": "HumanEval/63", "solution": "def fibfib(n: int):\n    \"\"\"The FibFib number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fibfib(0) == 0\n    fibfib(1) == 0\n    fibfib(2) == 1\n    fibfib(n) == fibfib(n-1) + fibfib(n-2) + fibfib(n-3).\n    Please write a function to efficiently compute the n-th element of the fibfib number sequence.\n    >>> fibfib(1)\n    0\n    >>> fibfib(5)\n    4\n    >>> fibfib(8)\n    24\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 1\n\n    a, b, c = 0, 0, 1\n    for _ in range(3, n + 1):\n        next_fib = a + b + c\n        a, b, c = b, c, next_fib\n    return c"}
{"task_id": "HumanEval/63", "solution": "from typing import Dict\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    pass\nFIBFIB_BASE_CASES: Dict[int, int] = {\n    0: 0,\n    1: 0,\n    2: 1\n}\nclass FibFibService:\n    \"\"\"\n    Service for efficiently computing the n-th element of the FibFib number sequence.\n    \"\"\"\n    def __init__(self):\n        # Initializes the memoization cache with base cases.\n        self._memo: Dict[int, int] = dict(FIBFIB_BASE_CASES)\n\n    def calculate_fibfib(self, n: int) -> int:\n        \"\"\"\n        Computes the n-th FibFib number using memoization.\n        Raises InvalidInputError if n is negative.\n        \"\"\"\n        if n < 0:\n            raise InvalidInputError(\"Input 'n' must be a non-negative integer.\")\n\n        if n in self._memo:\n            return self._memo[n]\n\n        # Recursively compute the result and store it in the memoization cache.\n        result = (\n            self.calculate_fibfib(n - 1) +\n            self.calculate_fibfib(n - 2) +\n            self.calculate_fibfib(n - 3)\n        )\n        self._memo[n] = result\n        return result\n_fibfib_service = FibFibService()\ndef fibfib(n: int) -> int:\n    \"\"\"The FibFib number sequence is defined by fibfib(0)=0, fibfib(1)=0, fibfib(2)=1, and fibfib(n)=fibfib(n-1)+fibfib(n-2)+fibfib(n-3) for n>2.\n    This function efficiently computes the n-th element of the sequence using memoization.\n    \"\"\"\n    return _fibfib_service.calculate_fibfib(n)"}
