{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    from typing import Iterator\n\n    class InvalidInputError(ValueError):\n        \"\"\"Custom exception for invalid input parameters.\"\"\"\n        pass\n\n    class FibonacciGenerator:\n        \"\"\"Generates Fibonacci numbers sequentially.\"\"\"\n        def __init__(self):\n            self.a = 0\n            self.b = 1\n\n        def __iter__(self) -> Iterator[int]:\n            return self\n\n        def __next__(self) -> int:\n            fib_num = self.a\n            self.a, self.b = self.b, self.a + self.b\n            return fib_num\n\n    class PrimeChecker:\n        \"\"\"Checks if a number is prime.\"\"\"\n        def is_prime(self, num: int) -> bool:\n            if num <= 1:\n                return False\n            if num <= 3:\n                return True\n            if num % 2 == 0 or num % 3 == 0:\n                return False\n            i = 5\n            while i * i <= num:\n                if num % i == 0 or num % (i + 2) == 0:\n                    return False\n                i += 6\n            return True\n\n    class PrimeFibonacciService:\n        \"\"\"Orchestrates finding the N-th prime Fibonacci number.\"\"\"\n        def __init__(self, fib_generator: FibonacciGenerator, prime_checker: PrimeChecker):\n            self.fib_generator = fib_generator\n            self.prime_checker = prime_checker\n\n        def find_nth_prime_fib(self, n: int) -> int:\n            prime_fib_count = 0\n            for fib_num in self.fib_generator:\n                if fib_num > 1 and self.prime_checker.is_prime(fib_num):\n                    prime_fib_count += 1\n                    if prime_fib_count == n:\n                        return fib_num\n\n    class PrimeFibonacciController:\n        \"\"\"Controller for the prime_fib function.\"\"\"\n        def __init__(self):\n            self.service = PrimeFibonacciService(\n                fib_generator=FibonacciGenerator(),\n                prime_checker=PrimeChecker()\n            )\n\n        def prime_fib(self, n: int) -> int:\n            if not isinstance(n, int) or n < 1:\n                raise InvalidInputError(\"Input 'n' must be a positive integer.\")\n            return self.service.find_nth_prime_fib(n)\n\n    _controller = PrimeFibonacciController()\n\n    return _controller.prime_fib(n)"}
