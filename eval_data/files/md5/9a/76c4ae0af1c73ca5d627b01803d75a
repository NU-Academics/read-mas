{"task_id": "HumanEval/112", "solution": "from typing import Tuple\nclass ProcessingResult:\n    \"\"\"\n    DTO to hold string processing results.\n    Contains the processed string and its palindrome status.\n    \"\"\"\n    def __init__(self, processed_string: str, is_palindrome: bool):\n        if not isinstance(processed_string, str):\n            raise TypeError(\"processed_string must be a string\")\n        if not isinstance(is_palindrome, bool):\n            raise TypeError(\"is_palindrome must be a boolean\")\n\n        self.processed_string: str = processed_string\n        self.is_palindrome: bool = is_palindrome\n\n    def to_tuple(self) -> Tuple[str, bool]:\n        \"\"\"Converts the result to a tuple (processed_string, is_palindrome).\"\"\"\n        return (self.processed_string, self.is_palindrome)\nclass PalindromeChecker:\n    \"\"\"\n    Utility for checking if a string is a palindrome.\n    Performs a case-sensitive check on the entire string.\n    \"\"\"\n    def is_palindrome(self, text: str) -> bool:\n        \"\"\"\n        Checks if the input string is a palindrome.\n        Raises TypeError if input is not a string.\n        \"\"\"\n        if not isinstance(text, str):\n            raise TypeError(\"Input 'text' must be a string.\")\n        return text == text[::-1]\nclass StringProcessorService:\n    \"\"\"\n    Service to delete characters from a string and check if the result is a palindrome.\n    Orchestrates character deletion and palindrome checking.\n    \"\"\"\n    def __init__(self, palindrome_checker: PalindromeChecker):\n        self._palindrome_checker = palindrome_checker\n\n    def _delete_chars(self, s: str, c: str) -> str:\n        \"\"\"\n        Deletes characters from 's' found in 'c'.\n        Returns the filtered string.\n        \"\"\"\n        chars_to_delete = set(c)\n        return \"\".join(char for char in s if char not in chars_to_delete)\n\n    def process_and_check(self, s: str, c: str) -> Tuple[str, bool]:\n        \"\"\"\n        Deletes characters from 's' present in 'c', then checks for palindrome.\n        Returns a tuple of the processed string and its palindrome status.\n        \"\"\"\n        if not isinstance(s, str):\n            raise TypeError(\"Input 's' must be a string.\")\n        if not isinstance(c, str):\n            raise TypeError(\"Input 'c' must be a string.\")\n\n        processed_s = self._delete_chars(s, c)\n        is_palindrome = self._palindrome_checker.is_palindrome(processed_s)\n\n        result = ProcessingResult(processed_s, is_palindrome)\n        return result.to_tuple()\ndef reverse_delete(s: str, c: str) -> Tuple[str, bool]:\n    \"\"\"\n    Deletes characters from 's' that are in 'c', then checks if the result is a palindrome.\n    Returns a tuple of the modified string and a boolean indicating palindrome status.\n    \"\"\"\n    palindrome_checker = PalindromeChecker()\n    processor_service = StringProcessorService(palindrome_checker)\n    return processor_service.process_and_check(s, c)"}
{"task_id": "HumanEval/113", "solution": "from typing import List\ndef odd_count(lst: List[str]) -> List[str]:\n    \"\"\"Processes a list of digit-only strings. For each input string, it counts odd digits and returns a formatted string with the count embedded.\"\"\"\n    results: List[str] = []\n\n    for s in lst:\n        # Count the number of odd digits in the current string.\n        count = 0\n        for digit_char in s:\n            digit = int(digit_char)\n            if digit % 2 != 0:\n                count += 1\n        \n        # Format the output string using the derived count.\n        formatted_string = f\"the number of odd elements {count}n the str{count}ng {count} of the {count}nput.\"\n        \n        results.append(formatted_string)\n        \n    return results"}
{"task_id": "HumanEval/113", "solution": "from typing import List\nclass OddDigitService:\n    \"\"\"\n    Provides static utility methods for counting odd digits and formatting output.\n    Encapsulates core business logic.\n    \"\"\"\n\n    @staticmethod\n    def _is_odd_digit(char_digit: str) -> bool:\n        \"\"\"\n        Checks if a character representing a digit is odd.\n        Assumes input is a valid digit character.\n        \"\"\"\n        digit = int(char_digit)\n        return digit % 2 != 0\n\n    @staticmethod\n    def count_odd_digits_in_string(digit_string: str) -> int:\n        \"\"\"\n        Counts odd digits in a string. Iterates and uses `_is_odd_digit`.\n        \"\"\"\n        count = 0\n        for char_digit in digit_string:\n            if OddDigitService._is_odd_digit(char_digit):\n                count += 1\n        return count\n\n    @staticmethod\n    def format_result_string(count: int) -> str:\n        \"\"\"\n        Formats the output string. Uses an f-string to embed the count.\n        \"\"\"\n        return f\"the number of odd elements in the string {count} of the input.\"\n\n    @staticmethod\n    def process_odd_counts(lst: List[str]) -> List[str]:\n        \"\"\"\n        Processes a list of digit strings, counting odd digits and formatting results.\n        Orchestrates the calls to helper methods.\n        \"\"\"\n        results = []\n        for digit_string in lst:\n            odd_count_val = OddDigitService.count_odd_digits_in_string(digit_string)\n            formatted_string = OddDigitService.format_result_string(odd_count_val)\n            results.append(formatted_string)\n        return results\ndef odd_count(lst: List[str]) -> List[str]:\n    \"\"\"\n    Counts odd digits in a list of digit strings and returns formatted messages.\n    Delegates the full processing to `OddDigitService`.\n    \"\"\"\n    return OddDigitService.process_odd_counts(lst)"}
{"task_id": "HumanEval/113", "solution": "def odd_count(lst: list[str]) -> list[str]:\n    \"\"\"Given a list of strings, where each string consists of only digits, return a list.\n    Each element i of the output should be \"the number of odd elements in the\n    string i of the input.\" where all the i's should be replaced by the number\n    of odd digits in the i'th string of the input.\"\"\"\n\n    ODD_DIGITS: set[str] = {'1', '3', '5', '7', '9'}\n\n    def is_odd_digit(char: str) -> bool:\n        \"\"\"Checks if a character is an odd digit.\n        This uses a predefined set for efficient lookup.\"\"\"\n        return char in ODD_DIGITS\n\n    def count_odd_digits_in_string(s: str) -> int:\n        \"\"\"Counts the number of odd digits in a single string.\n        It iterates through each character, calling a helper to check if it's odd.\"\"\"\n        count = 0\n        for char in s:\n            if is_odd_digit(char):\n                count += 1\n        return count\n\n    def format_output_string(count: int) -> str:\n        \"\"\"Formats the output string based on the given odd digit count.\n        It replaces all occurrences of a placeholder with the actual count.\"\"\"\n        # Pattern: \"the number of odd elements <count>n the str<count>ng <count> of the <count>nput.\"\n        return f\"the number of odd elements {count}n the str{count}ng {count} of the {count}nput.\"\n\n    results: list[str] = []\n    for s in lst:\n        odd_count_val = count_odd_digits_in_string(s)\n        formatted_str = format_output_string(odd_count_val)\n        results.append(formatted_str)\n    return results"}
{"task_id": "HumanEval/113", "solution": "def odd_count(lst):\n    \"\"\"Processes a list of digit strings to count odd digits. Returns a list of formatted strings, where the count replaces 'i's in the output template.\"\"\"\n    results = []\n    for s in lst:\n        odd_digit_count = 0\n        for char in s:\n            # Each character is guaranteed to be a digit. Check if it's odd.\n            if int(char) % 2 != 0:\n                odd_digit_count += 1\n\n        # Formats the string according to the specific pattern from the problem's examples,\n        # replacing 'i' with the count in \"in the string i of the input.\"\n        formatted_string = (\n            f\"the number of odd elements {odd_digit_count}n the str\"\n            f\"{odd_digit_count}ng {odd_digit_count} of the {odd_digit_count}nput.\"\n        )\n        results.append(formatted_string)\n    return results"}
{"task_id": "HumanEval/113", "solution": "from typing import List\n_ODD_DIGITS = {'1', '3', '5', '7', '9'}\n_OUTPUT_TEMPLATE = \"the number of odd elements {count}n the str{count}ng {count} of the {count}nput.\"\ndef _count_odd_digits_in_string(s: str) -> int:\n    \"\"\"Counts the number of odd digits in the given string.\"\"\"\n    count = 0\n    for char_digit in s:\n        if char_digit in _ODD_DIGITS:\n            count += 1\n    return count\ndef _format_output_message(count: int) -> str:\n    \"\"\"Formats the output string using the given odd digit count.\"\"\"\n    return _OUTPUT_TEMPLATE.format(count=count)\ndef odd_count(lst: List[str]) -> List[str]:\n    \"\"\"\n    Given a list of strings, where each string consists of only digits, return a list.\n    Each element i of the output should be \"the number of odd elements in the\n    string i of the input.\" where all the i's should be replaced by the number\n    of odd digits in the i'th string of the input.\n\n    >>> odd_count(['1234567'])\n    [\"the number of odd elements 4n the str4ng 4 of the 4nput.\"]\n    >>> odd_count(['3',\"11111111\"])\n    [\"the number of odd elements 1n the str1ng 1 of the 1nput.\",\n     \"the number of odd elements 8n the str8ng 8 of the 8nput.\"]\n    \"\"\"\n    results = []\n    for s in lst:\n        odd_digit_count = _count_odd_digits_in_string(s)\n        formatted_string = _format_output_message(odd_digit_count)\n        results.append(formatted_string)\n    return results"}
{"task_id": "HumanEval/113", "solution": "def odd_count(lst):\n    \"\"\"\n    Counts odd digits in each string of a list and formats them into a result list.\n    Raises ValueError if an input string contains non-digit characters.\n    \"\"\"\n    results = []\n    for s in lst:\n        odd_digit_count = 0\n        for char in s:\n            if not char.isdigit():\n                raise ValueError(f\"Input string contains non-digit character: '{char}'\")\n            if char in {'1', '3', '5', '7', '9'}:\n                odd_digit_count += 1\n        formatted_string = (\n            f\"the number of odd elements {odd_digit_count}n the str{odd_digit_count}ng \"\n            f\"{odd_digit_count} of the {odd_digit_count}nput.\"\n        )\n        results.append(formatted_string)\n    return results"}
