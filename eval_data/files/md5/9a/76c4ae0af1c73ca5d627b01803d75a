{"task_id": "HumanEval/96", "solution": "import math\nfrom typing import Any, List\nclass Utils:\n    \"\"\"\n    Provides general utility functions for input validation.\n    \"\"\"\n    @staticmethod\n    def validate_non_negative_integer(n: Any) -> int:\n        \"\"\"\n        Validates if the input 'n' is a non-negative integer.\n        Raises ValueError if 'n' is not an integer or is negative.\n        \"\"\"\n        if not isinstance(n, int):\n            raise ValueError(f\"Input must be an integer, but got {type(n).__name__}\")\n        if n < 0:\n            raise ValueError(f\"Input must be a non-negative integer, but got {n}\")\n        return n\nclass _PrimeCalculatorInternal:\n    \"\"\"\n    Internal class managing prime number generation using a cached Sieve of Eratosthenes.\n    It extends the sieve only when a larger limit is required.\n    \"\"\"\n    def __init__(self):\n        self._sieve_limit: int = 0\n        self._primes_cache: List[bool] = []\n\n    def _generate_primes_sieve(self, limit: int) -> None:\n        \"\"\"\n        Generates or extends the Sieve of Eratosthenes up to the given limit.\n        This updates the internal _primes_cache to cover numbers up to 'limit'.\n        \"\"\"\n        if limit <= self._sieve_limit:\n            return\n\n        is_prime_list = [True] * (limit + 1)\n        if limit >= 0: is_prime_list[0] = False\n        if limit >= 1: is_prime_list[1] = False\n\n        for p in range(2, int(math.sqrt(limit)) + 1):\n            if is_prime_list[p]:\n                for multiple in range(p * p, limit + 1, p):\n                    is_prime_list[multiple] = False\n        \n        self._primes_cache = is_prime_list\n        self._sieve_limit = limit\n\n    def is_prime(self, num: int) -> bool:\n        \"\"\"\n        Checks if a given number is prime by ensuring the sieve covers 'num' and then checking the cache.\n        Raises ValueError if 'num' is negative.\n        \"\"\"\n        if num < 0:\n            raise ValueError(\"Number must be non-negative to check for primality.\")\n        if num <= 1:\n            return False\n        \n        self._generate_primes_sieve(num)\n        return self._primes_cache[num]\n\n    def count_up_to_internal(self, n: int) -> List[int]:\n        \"\"\"\n        Finds all prime numbers strictly less than n.\n        It first validates the input and then generates primes using the sieve.\n        \"\"\"\n        validated_n = Utils.validate_non_negative_integer(n)\n\n        if validated_n <= 2:\n            return []\n\n        self._generate_primes_sieve(validated_n - 1)\n\n        primes = []\n        for num in range(2, validated_n):\n            if self._primes_cache[num]:\n                primes.append(num)\n        return primes\n_prime_calculator_instance = _PrimeCalculatorInternal()\ndef count_up_to(n: int) -> List[int]:\n    \"\"\"\n    Implement a function that takes a non-negative integer and returns an array of\n    the prime numbers strictly less than n.\n    Raises ValueError if n is not a non-negative integer.\n    \"\"\"\n    return _prime_calculator_instance.count_up_to_internal(n)"}
