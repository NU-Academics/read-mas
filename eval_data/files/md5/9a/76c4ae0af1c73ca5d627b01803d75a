{"task_id": "HumanEval/31", "solution": "def is_prime(n: int) -> bool:\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    This function implements an optimized trial division algorithm.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:  # Handles 2 and 3\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True"}
{"task_id": "HumanEval/31", "solution": "import math\ndef is_prime(n: int) -> bool:\n    \"\"\"\n    Return true if a given number is prime, and false otherwise.\n    A prime number is a natural number greater than 1 with no positive divisors other than 1 and itself.\n\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0: # Check for even numbers greater than 2.\n        return False\n\n    limit = int(math.sqrt(n)) + 1\n    for i in range(3, limit, 2): # Iterate through odd divisors up to the square root.\n        if n % i == 0:\n            return False\n    return True"}
{"task_id": "HumanEval/31", "solution": "def is_prime(n: int) -> bool:\n    \"\"\"\n    Return true if a given number is prime, and false otherwise.\n    Implements an optimized primality test.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:  # 2 and 3 are prime\n        return True\n    if n % 2 == 0 or n % 3 == 0: # multiples of 2 or 3\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True"}
{"task_id": "HumanEval/31", "solution": "def is_prime(n: int) -> bool:\n    \"\"\"\n    Return true if a given number is prime, and false otherwise.\n\n    A prime number is a natural number greater than 1 that has no positive\n    divisors other than 1 and itself.\n\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    >>> is_prime(0)\n    False\n    >>> is_prime(-5)\n    False\n    \"\"\"\n    if n < 2:\n        return False\n    if n == 2 or n == 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n\n    i = 5\n    # Check for factors up to sqrt(n).\n    # Optimized loop checks numbers of the form 6k \u00b1 1.\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True"}
{"task_id": "HumanEval/31", "solution": "import math\ndef is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    A prime number is a natural number greater than 1 with no positive divisors other than 1 and itself.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0: # Checks even numbers greater than 2.\n        return False\n    # Check for odd divisors from 3 up to the square root of n.\n    # We step by 2 since even divisors have already been excluded.\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        if n % i == 0:\n            return False\n    return True"}
{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input must be an integer.\")\n\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True  # 2 and 3 are prime\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n\n    # Check for divisors from 5 onwards using the 6k \u00b1 1 optimization.\n    # We only need to check up to the square root of n.\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True"}
