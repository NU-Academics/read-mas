{"task_id": "HumanEval/94", "solution": "import math\nclass MathHelpers:\n    \"\"\"Provides utility functions for mathematical operations.\n    It includes methods for primality testing and digit summation.\n    \"\"\"\n\n    @staticmethod\n    def is_prime(n: int) -> bool:\n        \"\"\"Determines if a given integer is a prime number.\n        Checks for divisibility by odd numbers up to its square root.\n        \"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\n\n    @staticmethod\n    def sum_digits(n: int) -> int:\n        \"\"\"Calculates the sum of the digits of a given non-negative integer.\n        Handles negative numbers by summing digits of their absolute value.\n        \"\"\"\n        if n < 0:\n            n = abs(n)\n        digit_sum = 0\n        while n > 0:\n            digit_sum += n % 10\n            n //= 10\n        return digit_sum\nclass PrimeFinderService:\n    \"\"\"Orchestrates the process of finding the largest prime number in a list.\n    It then calculates the sum of the digits of that prime.\n    \"\"\"\n    def __init__(self, math_helpers: MathHelpers):\n        self._math_helpers = math_helpers\n\n    def find_largest_prime_digit_sum(self, numbers: list[int]) -> int:\n        \"\"\"Finds the largest prime in the given list and returns the sum of its digits.\n        Returns 0 if no prime numbers are found.\n        \"\"\"\n        largest_prime = -1 # Initialize with a value smaller than any possible prime\n\n        for number in numbers:\n            if self._math_helpers.is_prime(number):\n                if number > largest_prime:\n                    largest_prime = number\n\n        if largest_prime == -1: # No prime found\n            return 0\n        else:\n            return self._math_helpers.sum_digits(largest_prime)\ndef skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n\n    Examples:\n    For lst = [0,3,2,1,3,5,7,4,5,5,5,2,181,32,4,32,3,2,32,324,4,3] the output should be 10\n    For lst = [1,0,1,8,2,4597,2,1,3,40,1,2,1,2,4,2,5,1] the output should be 25\n    For lst = [1,3,1,32,5107,34,83278,109,163,23,2323,32,30,1,9,3] the output should be 13\n    For lst = [0,724,32,71,99,32,6,0,5,91,83,0,5,6] the output should be 11\n    For lst = [0,81,12,3,1,21] the output should be 3\n    For lst = [0,8,1,2,1,7] the output should be 7\n    \"\"\"\n    math_helpers = MathHelpers()\n    service = PrimeFinderService(math_helpers)\n    return service.find_largest_prime_digit_sum(lst)"}
{"task_id": "HumanEval/94", "solution": "import math\nfrom typing import Optional\ndef _is_prime_helper(n: int) -> bool:\n    \"\"\"Determines if a given integer n is prime.\n    It uses an optimized algorithm checking divisibility up to its square root.\n    \"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        if n % i == 0:\n            return False\n    return True\ndef _find_largest_prime_helper(numbers: list[int]) -> Optional[int]:\n    \"\"\"Finds the largest prime number in a list of integers.\n    Returns None if no primes are present.\n    \"\"\"\n    largest_prime: Optional[int] = None\n    for num in numbers:\n        if _is_prime_helper(num):\n            if largest_prime is None or num > largest_prime:\n                largest_prime = num\n    return largest_prime\ndef _sum_digits_helper(number: int) -> int:\n    \"\"\"Calculates the sum of the digits of a given integer.\n    It uses the absolute value of the number for summation.\n    \"\"\"\n    s = 0\n    abs_number = abs(number)\n    while abs_number > 0:\n        s += abs_number % 10\n        abs_number //= 10\n    return s\ndef skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n    largest_prime = _find_largest_prime_helper(lst)\n\n    if largest_prime is None:\n        return 0\n    else:\n        return _sum_digits_helper(largest_prime)"}
{"task_id": "HumanEval/94", "solution": "import math\ndef skjkasdkd(lst):\n    \"\"\"\n    Finds the largest prime value in a list of integers and returns the sum of its digits.\n    Returns 0 if no prime numbers are found in the list.\n    \"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Determines if a given integer is a prime number.\n        Checks divisibility up to its square root.\n        \"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\n\n    def sum_digits(n: int) -> int:\n        \"\"\"Calculates the sum of the digits of a given non-negative integer.\n        Processes digits by repeatedly taking modulo 10 and integer division.\n        \"\"\"\n        if n < 0:\n            n = abs(n)\n        digit_sum = 0\n        while n > 0:\n            digit_sum += n % 10\n            n //= 10\n        return digit_sum\n\n    largest_prime = -1\n\n    for number in lst:\n        if is_prime(number):\n            if number > largest_prime:\n                largest_prime = number\n\n    if largest_prime == -1:\n        return 0\n    else:\n        return sum_digits(largest_prime)"}
{"task_id": "HumanEval/94", "solution": "import math\ndef skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Determines if an integer `n` is a prime number.\n        It checks for divisibility by odd numbers up to its square root.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\n\n    def find_largest_prime(numbers: list[int]) -> int | None:\n        \"\"\"Finds the largest prime number within a list of integers.\n        Returns None if no prime numbers are found.\"\"\"\n        largest_prime = None\n        for num in numbers:\n            if is_prime(num):\n                if largest_prime is None or num > largest_prime:\n                    largest_prime = num\n        return largest_prime\n\n    def sum_digits(n: int) -> int:\n        \"\"\"Calculates the sum of the digits of a non-negative integer.\n        The absolute value of the number is used for summing.\"\"\"\n        digit_sum = 0\n        abs_n = abs(n)\n        while abs_n > 0:\n            digit_sum += abs_n % 10\n            abs_n //= 10\n        return digit_sum\n\n    largest_prime = find_largest_prime(lst)\n    if largest_prime is None:\n        return 0  # Returns 0 if no prime is found in the list.\n    return sum_digits(largest_prime)"}
{"task_id": "HumanEval/94", "solution": "import math\nclass PrimeUtils:\n    @staticmethod\n    def is_prime(n: int) -> bool:\n        \"\"\"Determines if an integer n is a prime number.\n        Checks divisibility by odd numbers up to its square root.\"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\n\n    @staticmethod\n    def sum_digits(n: int) -> int:\n        \"\"\"Calculates the sum of digits of a non-negative integer.\n        Handles negative input by taking its absolute value.\"\"\"\n        if n < 0:\n            n = abs(n)\n        digit_sum = 0\n        while n > 0:\n            digit_sum += n % 10\n            n //= 10\n        return digit_sum\nclass PrimeService:\n    @staticmethod\n    def find_largest_prime_and_sum_digits(lst: list[int]) -> int:\n        \"\"\"Finds the largest prime in a list and returns the sum of its digits.\n        Returns 0 if no primes are found.\"\"\"\n        largest_prime = -1\n\n        for number in lst:\n            if PrimeUtils.is_prime(number):\n                if number > largest_prime:\n                    largest_prime = number\n        \n        if largest_prime != -1:\n            return PrimeUtils.sum_digits(largest_prime)\n        else:\n            return 0\ndef skjkasdkd(lst: list[int]) -> int:\n    \"\"\"Finds the largest prime in a list of integers and returns the sum of its digits.\"\"\"\n    return PrimeService.find_largest_prime_and_sum_digits(lst)"}
