{"task_id": "HumanEval/60", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input parameters.\n    It carries a descriptive error message.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef sum_to_n(n: int) -> int:\n    \"\"\"Calculates the sum of integers from 1 to n using the efficient arithmetic series formula.\n    Raises an InvalidInputError if n is not a positive integer.\"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise InvalidInputError(\"Input 'n' must be a positive integer.\")\n    return n * (n + 1) // 2"}
{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int) -> int:\n    \"\"\"Calculates the sum of all positive integers from 1 up to n.\n    Raises ValueError if n is not a positive integer.\n    >>> sum_to_n(30)\n    465\n    >>> sum_to_n(100)\n    5050\n    >>> sum_to_n(5)\n    15\n    >>> sum_to_n(10)\n    55\n    >>> sum_to_n(1)\n    1\n    \"\"\"\n    # Validate that n is a positive integer.\n    if not isinstance(n, int):\n        raise ValueError(f\"Parameter 'n' must be an integer, but got {type(n).__name__}.\")\n    if n <= 0:\n        raise ValueError(f\"Parameter 'n' must be a positive integer, but got {n}.\")\n\n    # Compute the sum using the arithmetic series formula.\n    return (n * (n + 1)) // 2"}
