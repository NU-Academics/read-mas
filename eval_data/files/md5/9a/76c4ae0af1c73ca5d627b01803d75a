{"task_id": "HumanEval/125", "solution": "import re\ndef _has_whitespace(txt):\n    \"\"\"Checks if the string contains any whitespace characters using regex.\"\"\"\n    return bool(re.search(r'\\s', txt))\ndef _has_comma(txt):\n    \"\"\"Checks if the string contains any comma characters.\"\"\"\n    return ',' in txt\ndef _count_odd_order_letters(txt):\n    \"\"\"Counts lowercase English letters with odd alphabetical order (0-indexed).\n    'a' is 0, 'b' is 1, etc.\n    \"\"\"\n    count = 0\n    for char in txt:\n        if 'a' <= char <= 'z':\n            order = ord(char) - ord('a')\n            if order % 2 != 0:\n                count += 1\n    return count\ndef split_words(txt):\n    \"\"\"\n    Splits a string by whitespace or commas, or counts specific characters.\n    Whitespace splitting takes precedence, then comma splitting, otherwise counts odd-ordered lowercase letters.\n    \"\"\"\n    if not isinstance(txt, str):\n        raise TypeError(\"Input must be a string.\")\n\n    if _has_whitespace(txt):\n        return txt.split()\n    elif _has_comma(txt):\n        return txt.split(',')\n    else:\n        return _count_odd_order_letters(txt)"}
{"task_id": "HumanEval/125", "solution": "from typing import List, Union\ndef split_words(txt: str) -> Union[List[str], int]:\n    \"\"\"\n    Splits a string by whitespace, then by commas, or counts odd-order lowercase letters.\n    ord('a') is 0-indexed for character counting.\n    \"\"\"\n\n    ORD_A = ord('a')\n\n    def _count_odd_order_chars(text: str) -> int:\n        \"\"\"\n        Counts lowercase letters whose 0-indexed alphabetical order is odd.\n        This helper function assumes valid string input.\n        \"\"\"\n        count = 0\n        for char in text:\n            if 'a' <= char <= 'z':\n                order = ord(char) - ORD_A\n                if order % 2 != 0:\n                    count += 1\n        return count\n\n    if not isinstance(txt, str):\n        raise TypeError(\"Input must be a string.\")\n\n    # 1. Try splitting by whitespace\n    whitespace_split = txt.split()\n    if len(whitespace_split) > 1:\n        return whitespace_split\n\n    # 2. If no whitespace-based split, try splitting by comma\n    comma_split = txt.split(',')\n    if len(comma_split) > 1:\n        return comma_split\n\n    # 3. If neither split, count lowercase letters with odd alphabetical order\n    return _count_odd_order_chars(txt)"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    \"\"\"\n    Splits a string based on specific rules or counts characters.\n    It prioritizes splitting by whitespace, then by commas, otherwise counts\n    lowercase letters with an odd 0-indexed alphabetical order.\n    \"\"\"\n    if not isinstance(txt, str):\n        raise TypeError(\"Input must be a string.\")\n    if not txt:\n        raise ValueError(\"Input string cannot be empty.\")\n\n    if any(c.isspace() for c in txt):\n        return txt.split()\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        count = 0\n        for char in txt:\n            if 'a' <= char <= 'z':\n                # Calculate 0-indexed alphabetical order.\n                order = ord(char) - ord('a')\n                if order % 2 != 0:\n                    count += 1\n        return count"}
{"task_id": "HumanEval/126", "solution": "from collections import Counter\ndef is_sorted(lst: list[int]) -> bool:\n    \"\"\"\n    Checks if a list of non-negative integers is sorted ascending and has no more than two occurrences of any number.\n    Returns True if both conditions are met, False otherwise.\n    \"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"Input must be a list.\")\n    if not all(isinstance(x, int) and x >= 0 for x in lst):\n        raise ValueError(\"All elements must be non-negative integers.\")\n\n    def _check_duplicates(data: list[int]) -> bool:\n        \"\"\"\n        Determines if any number in the list appears three or more times.\n        Returns False if excessive duplicates are found, True otherwise.\n        \"\"\"\n        counts = Counter(data)\n        for count in counts.values():\n            if count > 2:\n                return False\n        return True\n\n    def _check_order(data: list[int]) -> bool:\n        \"\"\"\n        Verifies if the list is sorted in ascending order.\n        Empty or single-element lists are considered sorted.\n        \"\"\"\n        if len(data) <= 1:\n            return True\n        for i in range(1, len(data)):\n            if data[i] < data[i-1]:\n                return False\n        return True\n\n    if not _check_duplicates(lst):\n        return False\n\n    return _check_order(lst)"}
{"task_id": "HumanEval/126", "solution": "from collections import Counter\nfrom typing import List\ndef is_sorted(lst: List[int]) -> bool:\n    \"\"\"\n    Given a list of non-negative integers, return whether or not they are sorted in ascending order.\n    The function returns False if any number appears more than two times.\n    \"\"\"\n    if len(lst) <= 1:\n        return True\n\n    counts = Counter(lst)\n    for count in counts.values():\n        if count > 2:\n            return False\n\n    for i in range(1, len(lst)):\n        if lst[i] < lst[i-1]:\n            return False\n\n    return True"}
{"task_id": "HumanEval/126", "solution": "import collections\ndef is_sorted(lst):\n    \"\"\"\n    Checks if a list of non-negative integers is sorted in ascending order\n    and adheres to the duplicate constraint.\n    Raises TypeError if the input is not a list.\n    \"\"\"\n    if not isinstance(lst, list):\n        # Design specifies SortingError, but critical requirements forbid class wrapper/imports\n        # for custom exceptions. A standard TypeError is used for invalid input type.\n        raise TypeError(\"Input must be a list.\")\n\n    # An empty or single-element list is considered sorted.\n    if len(lst) <= 1:\n        return True\n\n    # Count frequencies; a number appearing more than twice makes the list unsorted.\n    counts = collections.Counter(lst)\n    for count in counts.values():\n        if count > 2:\n            return False\n\n    # Check if elements are in non-decreasing (ascending) order.\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    return True"}
{"task_id": "HumanEval/126", "solution": "import collections\ndef is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n\n    Examples\n    is_sorted([5]) \u279e True\n    is_sorted([1, 2, 3, 4, 5]) \u279e True\n    is_sorted([1, 3, 2, 4, 5]) \u279e False\n    is_sorted([1, 2, 3, 4, 5, 6]) \u279e True\n    is_sorted([1, 2, 3, 4, 5, 6, 7]) \u279e True\n    is_sorted([1, 3, 2, 4, 5, 6, 7]) \u279e False\n    is_sorted([1, 2, 2, 3, 3, 4]) \u279e True\n    is_sorted([1, 2, 2, 2, 3, 4]) \u279e False\n    '''\n    # An empty or single-element list is considered sorted as per FR3.\n    if len(lst) <= 1:\n        return True\n\n    # Check for the duplicate count rule as per FR2 and BR2.\n    # \\\"More than 1 duplicate\\\" means any number appears 3 or more times.\n    counts = collections.Counter(lst)\n    for count in counts.values():\n        if count > 2:\n            return False\n\n    # Check for ascending order as per FR1 and BR1.\n    for i in range(1, len(lst)):\n        if lst[i] < lst[i-1]:\n            return False\n            \n    return True"}
{"task_id": "HumanEval/125", "solution": "import re\ndef split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    Examples\n    split_words(\"Hello world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"Hello,world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"abcdef\") == 3\n    '''\n    # Rule 1: Split by whitespace\n    if re.search(r'\\s', txt):\n        return txt.split()\n\n    # Rule 2: Split by comma\n    if ',' in txt:\n        return txt.split(',')\n\n    # Rule 3: Count odd-ordered lowercase letters\n    count = 0\n    alphabet_start_ord = ord('a')\n    for char in txt:\n        if 'a' <= char <= 'z':\n            order = ord(char) - alphabet_start_ord\n            if order % 2 != 0:  # Check if the order is odd\n                count += 1\n    return count"}
{"task_id": "HumanEval/126", "solution": "from collections import Counter\ndef _check_duplicates(lst: list[int]) -> bool:\n    \"\"\"\n    Checks if any number in the list appears more than twice.\n    Returns True if no number appears more than twice, False otherwise.\n    \"\"\"\n    if not lst:\n        return True\n    counts = Counter(lst)\n    for count in counts.values():\n        if count > 2:\n            return False\n    return True\ndef _check_ascending_order(lst: list[int]) -> bool:\n    \"\"\"\n    Checks if the list is sorted in non-decreasing (ascending) order.\n    Returns True if sorted, False otherwise.\n    \"\"\"\n    if len(lst) <= 1:\n        return True\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n    return True\ndef is_sorted(lst: list[int]) -> bool:\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n\n    Examples\n    is_sorted([5]) \u279e True\n    is_sorted([1, 2, 3, 4, 5]) \u279e True\n    is_sorted([1, 3, 2, 4, 5]) \u279e False\n    is_sorted([1, 2, 3, 4, 5, 6]) \u279e True\n    is_sorted([1, 2, 3, 4, 5, 6, 7]) \u279e True\n    is_sorted([1, 3, 2, 4, 5, 6, 7]) \u279e False\n    is_sorted([1, 2, 2, 3, 3, 4]) \u279e True\n    is_sorted([1, 2, 2, 2, 3, 4]) \u279e False\n    '''\n    if not _check_duplicates(lst):\n        return False\n    if not _check_ascending_order(lst):\n        return False\n    return True"}
{"task_id": "HumanEval/126", "solution": "import collections\ndef is_sorted(lst):\n    \"\"\"\n    Checks if a list of non-negative integers is sorted ascendingly and\n    if no number appears more than twice.\n    \"\"\"\n    if len(lst) <= 1:\n        return True\n\n    counts = collections.Counter(lst)\n    for count in counts.values():\n        if count > 2:\n            return False\n\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    return True"}
{"task_id": "HumanEval/126", "solution": "import collections\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for signaling invalid input data.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef is_sorted(lst):\n    \"\"\"\n    Checks if a list of non-negative integers is sorted ascending and\n    if no number appears more than twice.\n    \"\"\"\n    # Validate input list for type and value constraints (from InputValidator).\n    if not isinstance(lst, list):\n        raise InvalidInputError(\"Input must be a list.\")\n    for item in lst:\n        if not isinstance(item, int):\n            raise InvalidInputError(f\"List elements must be integers, found: {type(item).__name__}\")\n        if item < 0:\n            raise InvalidInputError(f\"List elements must be non-negative, found: {item}\")\n\n    # Check if the list is sorted in ascending order (from SorterService._is_ascending).\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    # Check if any number appears more than twice (from SorterService._has_too_many_duplicates).\n    counts = collections.Counter(lst)\n    for count in counts.values():\n        if count > 2: # An element appearing 3 or more times is \"more than 1 duplicate\".\n            return False\n\n    # If both conditions pass, the list satisfies all requirements.\n    return True"}
{"task_id": "HumanEval/126", "solution": "from collections import Counter\ndef is_sorted(lst):\n    \"\"\"\n    Checks if a list is sorted ascendingly and contains no number more than twice.\n    Assumes non-negative integers.\n    \"\"\"\n    # First, check for excessive duplicates as per FR2 and FR3.\n    counts = Counter(lst)\n    for count in counts.values():\n        if count > 2: # MAX_DUPLICATE_COUNT = 2, so more than 2 is 3 or more.\n            return False\n\n    # If no excessive duplicates, then check if the list is sorted ascendingly as per FR1.\n    if len(lst) <= 1:\n        return True\n    \n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n            \n    return True"}
