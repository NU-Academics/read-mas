{"task_id": "HumanEval/130", "solution": "from typing import List, Dict\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\n    It provides a specific error message for clarity.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef tri(n: int) -> List[int]:\n    \"\"\"\n    Calculates and returns a list of the first n + 1 Tribonacci numbers.\n    The sequence follows specific recurrence rules and base cases for non-negative n.\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise InvalidInputError(\"n must be a non-negative integer.\")\n\n    memo: Dict[int, int] = {}\n\n    def _calculate_single_tribonacci(k: int) -> int:\n        \"\"\"\n        Computes the k-th Tribonacci number using memoization.\n        It applies base cases, even, and odd number rules recursively.\n        \"\"\"\n        if k in memo:\n            return memo[k]\n\n        if k == 0:\n            value = 1\n        elif k == 1:\n            value = 3\n        elif k % 2 == 0:  # k is even and k > 1\n            value = 1 + k // 2\n        else:  # k is odd and k > 1\n            # Recursive calls for odd numbers, utilizing memoization.\n            val_k_minus_1 = _calculate_single_tribonacci(k - 1)\n            val_k_minus_2 = _calculate_single_tribonacci(k - 2)\n            val_k_plus_1 = _calculate_single_tribonacci(k + 1)\n            value = val_k_minus_1 + val_k_minus_2 + val_k_plus_1\n        \n        memo[k] = value\n        return value\n\n    result_list: List[int] = []\n    for i in range(n + 1):\n        result_list.append(_calculate_single_tribonacci(i))\n    \n    return result_list"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Everyone knows Fibonacci sequence, it was studied deeply by mathematicians in\n    the last couple centuries. However, what people don't know is Tribonacci sequence.\n    Tribonacci sequence is defined by the recurrence:\n    tri(1) = 3\n    tri(n) = 1 + n / 2, if n is even.\n    tri(n) =  tri(n - 1) + tri(n - 2) + tri(n + 1), if n is odd.\n    For example:\n    tri(2) = 1 + (2 / 2) = 2\n    tri(4) = 3\n    tri(3) = tri(2) + tri(1) + tri(4)\n           = 2 + 3 + 3 = 8\n    You are given a non-negative integer number n, you have to a return a list of the\n    first n + 1 numbers of the Tribonacci sequence.\n    Examples:\n    tri(3) = [1, 3, 2, 8]\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    memo = {}\n\n    def _calculate_tri_value(k):\n        # Base cases\n        if k == 0:\n            return 1\n        if k == 1:\n            return 3\n\n        # Check memoization\n        if k in memo:\n            return memo[k]\n\n        # Recurrence relation\n        if k % 2 == 0:  # k is even\n            # Using integer division // as per expected output\n            result = 1 + k // 2\n        else:  # k is odd\n            # tri(k) = tri(k - 1) + tri(k - 2) + tri(k + 1)\n            # For odd k, k+1 is even, so tri(k+1) can be calculated directly\n            tri_k_minus_1 = _calculate_tri_value(k - 1)\n            tri_k_minus_2 = _calculate_tri_value(k - 2)\n            # k+1 is even, apply the even rule with integer division\n            tri_k_plus_1 = 1 + (k + 1) // 2\n            result = tri_k_minus_1 + tri_k_minus_2 + tri_k_plus_1\n\n        # Store result in memo and return\n        memo[k] = result\n        return result\n\n    # Generate the sequence\n    result_list = []\n    for i in range(n + 1):\n        result_list.append(_calculate_tri_value(i))\n\n    return result_list"}
{"task_id": "HumanEval/130", "solution": "from typing import Dict, List\nclass TribonacciService:\n    def __init__(self):\n        self._memo: Dict[int, int] = {}\n        self._memo[0] = 1\n        self._memo[1] = 3\n\n    def _calculate_value(self, k: int) -> int:\n        if k in self._memo:\n            return self._memo[k]\n\n        if k < 0:\n            raise ValueError(\"Tribonacci sequence is defined for non-negative integers.\")\n\n        if k % 2 == 0:  # n is even\n            value = 1 + k // 2\n        else:  # n is odd\n            value = (\n                self._calculate_value(k - 1)\n                + self._calculate_value(k - 2)\n                + self._calculate_value(k + 1)\n            )\n        \n        self._memo[k] = value\n        return value\n\n    def get_sequence(self, n: int) -> List[int]:\n        if n < 0:\n            raise ValueError(\"Input n must be a non-negative integer.\")\n        \n        sequence = []\n        for i in range(n + 1):\n            sequence.append(self._calculate_value(i))\n        return sequence\n_tribonacci_service = TribonacciService()\ndef tri(n: int) -> List[int]:\n    \"\"\"\n    Calculates the first n + 1 numbers of the Tribonacci sequence.\n    This function uses a memoized service to handle the custom recurrence relations.\n    \"\"\"\n    return _tribonacci_service.get_sequence(n)"}
{"task_id": "HumanEval/130", "solution": "from typing import Dict, List\ndef tri(n: int) -> List[float]:\n    \"\"\"Calculates the Tribonacci sequence up to the n-th term.\n\n    Returns a list of the first n+1 terms [tri(0), ..., tri(n)].\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    # Memoization cache, local to this call of tri(n).\n    _memo: Dict[int, float] = {}\n\n    def _calculate_term_internal(k: int) -> float:\n        \"\"\"Computes a single Tribonacci term using memoization.\"\"\"\n        if k in _memo:\n            return _memo[k]\n\n        result: float\n        if k == 0:\n            result = 1.0\n        elif k == 1:\n            result = 3.0\n        elif k % 2 == 0 and k > 0: # n is even and n > 0\n            result = 1 + k / 2\n        else: # n is odd and n > 1\n            # The recurrence involves tri(k+1), handled by recursion and memoization.\n            term_k_minus_1 = _calculate_term_internal(k - 1)\n            term_k_minus_2 = _calculate_term_internal(k - 2)\n            term_k_plus_1 = _calculate_term_internal(k + 1)\n            result = term_k_minus_1 + term_k_minus_2 + term_k_plus_1\n        \n        _memo[k] = result # Store computed term in the memoization cache.\n        return result\n\n    sequence: List[float] = []\n    # Generate the sequence from 0 to n.\n    for i in range(n + 1):\n        sequence.append(_calculate_term_internal(i))\n            \n    return sequence"}
