1, 2]) == 3\n    True\n    \"\"\"\n    calculator = DigitSumCalculator()\n    counter = NumberCounter(calculator)\n    return counter.count_nums(arr)"}
{"task_id": "HumanEval/108", "solution": "def count_nums(arr):\n    \"\"\"\n    Counts elements in an array where the sum of signed digits is greater than zero.\n    The first digit of a negative number is treated as negative.\n    \"\"\"\n    def _calculate_signed_digit_sum(num):\n        \"\"\"\n        Calculates the sum of digits for a number, treating the first digit\n        of a negative number as negative.\n        \"\"\"\n        if num == 0:\n            return 0\n\n        s_num = str(num)\n        total_sum = 0\n        is_negative = False\n\n        if s_num[0] == '-':\n            is_negative = True\n            s_num = s_num[1:]\n\n        for i, digit_char in enumerate(s_num):\n            digit = int(digit_char)\n            if is_negative and i == 0:\n                total_sum -= digit\n            else:\n                total_sum += digit\n        return total_sum\n\n    count = 0\n    for num in arr:\n        if not isinstance(num, int):\n            raise TypeError(f\"Expected integer in array, got {type(num)}\")\n        \n        signed_sum = _calculate_signed_digit_sum(num)\n        if signed_sum > 0:\n            count += 1\n    return count"}
{"task_id": "HumanEval/108", "solution": "def count_nums(arr):\n    \"\"\"\n    Counts numbers in an array where the sum of their digits is greater than 0.\n    For negative numbers, the first digit after the sign is treated as negative.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input 'arr' must be a list.\")\n\n    count = 0\n\n    def _calculate_digit_sum(number: int) -> int:\n        \"\"\"\n        Calculates the sum of digits for an integer; the first digit after a negative sign is treated as negative.\n        Otherwise, all digits are summed as positive.\n        \"\"\"\n        if not isinstance(number, int):\n            raise TypeError(\"Element must be an integer.\")\n\n        if number == 0:\n            return 0\n\n        s = str(number)\n        digit_sum = 0\n\n        if s[0] == '-':\n            # The first digit after the sign is negative\n            digit_sum += -int(s[1])\n            # Sum the remaining digits as positive\n            for char_digit in s[2:]:\n                digit_sum += int(char_digit)\n        else:\n            # All digits are positive\n            for char_digit in s:\n                digit_sum += int(char_digit)\n        return digit_sum\n\n    for num in arr:\n        if not isinstance(num, int):\n            raise TypeError(f\"All elements in 'arr' must be integers. Found: {type(num)}\")\n            \n        digit_sum = _calculate_digit_sum(num)\n        if digit_sum > 0:\n            count += 1\n            \n    return count"}
