{"task_id": "HumanEval/103", "solution": "from typing import Union\nclass MathUtils:\n    \"\"\"Provides static utility methods for common mathematical operations.\n    It performs operations like sum calculation, rounding, and binary conversion.\n    \"\"\"\n    @staticmethod\n    def calculate_sum_range(n: int, m: int) -> int:\n        \"\"\"Calculates the sum of integers from n to m (inclusive).\n        It uses the arithmetic series sum formula for efficiency.\n        \"\"\"\n        count = m - n + 1\n        return (count * (n + m)) // 2\n\n    @staticmethod\n    def round_to_nearest_int(value: float) -> int:\n        \"\"\"Rounds a floating-point number to the nearest integer.\n        It uses Python's built-in round() function, which rounds .5 to the nearest even.\n        \"\"\"\n        return round(value)\n\n    @staticmethod\n    def to_binary_string(value: int) -> str:\n        \"\"\"Converts an integer to its binary string representation.\n        The output includes the \"0b\" prefix as per standard Python behavior.\n        \"\"\"\n        return bin(value)\nclass RoundedAverageCalculator:\n    \"\"\"Orchestrates the calculation of the rounded binary average.\n    It handles input validation and delegates specific mathematical tasks to MathUtils.\n    \"\"\"\n    def calculate(self, n: int, m: int) -> Union[str, int]:\n        \"\"\"Computes the rounded binary average of integers from n to m.\n        It validates inputs, checks range order, and uses MathUtils for core calculations.\n        \"\"\"\n        # Validate that n and m are positive integers.\n        if not isinstance(n, int) or not isinstance(m, int) or n <= 0 or m <= 0:\n            raise ValueError(\"n and m must be positive integers.\")\n\n        # Return -1 if n is greater than m.\n        if n > m:\n            return -1\n\n        count = m - n + 1\n        \n        # Calculate the sum of integers from n through m.\n        total_sum = MathUtils.calculate_sum_range(n, m)\n        \n        # Compute the average.\n        average = total_sum / count\n        \n        # Round the calculated average to the nearest integer.\n        rounded_avg_int = MathUtils.round_to_nearest_int(average)\n        \n        # Convert the rounded integer average to its binary string representation.\n        return MathUtils.to_binary_string(rounded_avg_int)\ndef rounded_avg(n: int, m: int) -> Union[str, int]:\n    \"\"\"Computes the rounded binary average of integers from n through m.\n    It serves as the public API, delegating the core logic to RoundedAverageCalculator.\n    \"\"\"\n    calculator = RoundedAverageCalculator()\n    return calculator.calculate(n, m)"}
{"task_id": "HumanEval/104", "solution": "def unique_digits(x: list[int]) -> list[int]:\n    \"\"\"\n    Given a list of positive integers x, return a sorted list of all\n    elements that haven't any even digit.\n    \"\"\"\n    def _has_even_digit(number: int) -> bool:\n        \"\"\"Checks if a positive integer contains any even digit.\n        Returns True if an even digit is found, False otherwise.\"\"\"\n        if number == 0:\n            return True\n\n        temp_num = number\n        while temp_num > 0:\n            digit = temp_num % 10\n            if digit % 2 == 0:\n                return True\n            temp_num //= 10\n        return False\n\n    filtered_numbers = [num for num in x if not _has_even_digit(num)]\n    filtered_numbers.sort()\n    return filtered_numbers"}
{"task_id": "HumanEval/104", "solution": "def unique_digits(x):\n    \"\"\"Given a list of positive integers x, return a sorted list of all\n    elements that haven't any even digit.\n    Returned list should be sorted in increasing order.\n    \"\"\"\n\n    EVEN_DIGITS = {0, 2, 4, 6, 8}\n\n    def _has_only_odd_digits(number: int) -> bool:\n        \"\"\"Checks if all digits in the given number are odd.\n        This assumes the number is a positive integer as per requirements.\n        \"\"\"\n        temp_num = number\n        while temp_num > 0:\n            digit = temp_num % 10\n            if digit in EVEN_DIGITS:\n                return False\n            temp_num //= 10\n        return True\n\n    filtered_numbers = []\n    for number in x:\n        if _has_only_odd_digits(number):\n            filtered_numbers.append(number)\n\n    filtered_numbers.sort()\n    return filtered_numbers"}
{"task_id": "HumanEval/104", "solution": "from typing import List\ndef unique_digits(x: List[int]) -> List[int]:\n    \"\"\"Filters a list of positive integers to include only those without even digits.\n    The resulting list is sorted in increasing order.\n    \"\"\"\n    filtered_numbers = []\n    for number in x:\n        has_even_digit = False\n        for digit_char in str(number):\n            if int(digit_char) % 2 == 0:\n                has_even_digit = True\n                break\n        \n        if not has_even_digit:\n            filtered_numbers.append(number)\n    \n    filtered_numbers.sort()\n    return filtered_numbers"}
{"task_id": "HumanEval/104", "solution": "def unique_digits(x):\n    \"\"\"Given a list of positive integers x. return a sorted list of all \n    elements that hasn't any even digit.\n\n    Note: Returned list should be sorted in increasing order.\n    \n    For example:\n    >>> unique_digits([15, 33, 1422, 1])\n    [1, 15, 33]\n    >>> unique_digits([152, 323, 1422, 10])\n    []\n    \"\"\"\n    \n    _EVEN_DIGITS = {'0', '2', '4', '6', '8'}\n\n    def has_even_digit(number: int) -> bool:\n        \"\"\"\n        Checks if any digit within the given number is an even digit.\n        Assumes 'number' is a positive integer.\n        \"\"\"\n        num_str = str(number)\n        for digit_char in num_str:\n            if digit_char in _EVEN_DIGITS:\n                return True\n        return False\n\n    filtered_numbers = []\n    for num in x:\n        if not has_even_digit(num):\n            filtered_numbers.append(num)\n    \n    return sorted(filtered_numbers)"}
{"task_id": "HumanEval/104", "solution": "def unique_digits(x):\n    \"\"\"Given a list of positive integers x. return a sorted list of all \n    elements that hasn't any even digit.\n\n    Note: Returned list should be sorted in increasing order.\n    \n    For example:\n    >>> unique_digits([15, 33, 1422, 1])\n    [1, 15, 33]\n    >>> unique_digits([152, 323, 1422, 10])\n    []\n    \"\"\"\n    # Input Validation (from UniqueDigitsController)\n    if not isinstance(x, list):\n        raise TypeError(\"Input must be a list.\")\n\n    for num_item in x:\n        if not isinstance(num_item, int):\n            raise TypeError(f\"All elements in the list must be integers, found {type(num_item).__name__}.\")\n        # As per spec: \"list of positive integers x\"\n        if num_item <= 0:\n            raise ValueError(f\"All integers in the list must be positive, found {num_item}.\")\n\n    # Helper function for digit checking (from DigitChecker)\n    def _has_only_odd_digits(number: int) -> bool:\n        \"\"\"\n        Checks if all digits in the given number are odd.\n        \"\"\"\n        if number == 0:  # 0 is an even digit, so a number containing 0 is excluded\n            return False\n        \n        # Convert number to string to easily iterate through its digits\n        for digit_char in str(number):\n            digit = int(digit_char)\n            if digit % 2 == 0:  # If any digit is even (0, 2, 4, 6, 8)\n                return False\n        return True # All digits were odd\n\n    # Filtering and Sorting Logic (from NumberFilter)\n    filtered_numbers = []\n    for num in x:\n        if _has_only_odd_digits(num):\n            filtered_numbers.append(num)\n    \n    filtered_numbers.sort() # Sort the list in increasing order\n    return filtered_numbers"}
{"task_id": "HumanEval/104", "solution": "from typing import List, Set\nclass DigitValidator:\n    \"\"\"Validates if an integer contains only odd digits.\"\"\"\n    _EVEN_DIGITS: Set[int] = {0, 2, 4, 6, 8}\n\n    def has_only_odd_digits(self, number: int) -> bool:\n        \"\"\"Checks if all digits in the given number are odd. It returns True if all digits are odd, False otherwise.\"\"\"\n        return all(int(digit) not in self._EVEN_DIGITS for digit in str(number))\nclass DigitFilterService:\n    \"\"\"Filters a list of numbers based on digit validation and sorts the result.\"\"\"\n    def __init__(self, validator: DigitValidator):\n        \"\"\"Initializes the service with a DigitValidator instance.\"\"\"\n        self._validator = validator\n\n    def filter_and_sort(self, numbers: List[int]) -> List[int]:\n        \"\"\"Filters the input list, keeping only numbers with odd digits. The resulting list is then sorted in increasing order.\"\"\"\n        filtered_numbers = [\n            num for num in numbers if self._validator.has_only_odd_digits(num)\n        ]\n        filtered_numbers.sort()\n        return filtered_numbers\n_digit_validator = DigitValidator()\n_digit_filter_service = DigitFilterService(validator=_digit_validator)\ndef unique_digits(x: List[int]) -> List[int]:\n    \"\"\"Given a list of positive integers x, return a sorted list of all \n    elements that hasn't any even digit.\n\n    Note: Returned list should be sorted in increasing order.\n    \n    For example:\n    >>> unique_digits([15, 33, 1422, 1])\n    [1, 15, 33]\n    >>> unique_digits([152, 323, 1422, 10])\n    []\n    \"\"\"\n    if not isinstance(x, list):\n        raise TypeError(\"Input 'x' must be a list.\")\n\n    for i, num in enumerate(x):\n        if not isinstance(num, int):\n            raise TypeError(f\"Element at index {i} is not an integer: {num}\")\n        # A positive integer is strictly greater than 0.\n        if num <= 0: \n            raise ValueError(f\"Element at index {i} is not a positive integer: {num}\")\n\n    return _digit_filter_service.filter_and_sort(x)"}
{"task_id": "HumanEval/104", "solution": "def unique_digits(x):\n    \"\"\"Given a list of positive integers x, return a sorted list of all\n    elements that do not contain any even digits. The returned list will be\n    sorted in increasing order.\n    \"\"\"\n    filtered_numbers = []\n    for num in x:\n        current_num = num\n        only_odd_digits = True\n        while current_num > 0:\n            digit = current_num % 10\n            if digit % 2 == 0:\n                only_odd_digits = False\n                break\n            current_num //= 10\n        \n        if only_odd_digits:\n            filtered_numbers.append(num)\n            \n    filtered_numbers.sort()\n    return filtered_numbers"}
