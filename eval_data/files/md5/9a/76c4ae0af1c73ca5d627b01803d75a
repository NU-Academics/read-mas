{"task_id": "HumanEval/116", "solution": "def sort_array(arr: list[int]) -> list[int]:\n    \"\"\"\n    Sorts an array of integers based on custom criteria: non-negative by bit count then value,\n    negative by value. Non-negative numbers are grouped before negative numbers.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input must be a list.\")\n    if not all(isinstance(x, int) for x in arr):\n        raise TypeError(\"All elements in the list must be integers.\")\n\n    def _count_set_bits(n: int) -> int:\n        \"\"\"Counts set bits in a non-negative integer's binary representation.\"\"\"\n        return bin(n).count('1')\n\n    def _get_sort_key(num: int) -> tuple:\n        \"\"\"\n        Generates a composite sort key for an integer, prioritizing non-negative numbers.\n        Non-negative keys are (0, bit_count, value); negative keys are (1, value).\n        \"\"\"\n        if num >= 0:\n            return (0, _count_set_bits(num), num)\n        else:\n            return (1, num)\n\n    return sorted(arr, key=_get_sort_key)"}
{"task_id": "HumanEval/116", "solution": "from typing import List, Tuple\ndef sort_array(arr: List[int]) -> List[int]:\n    \"\"\"\n    Sorts an array of integers: non-negative by set bits then value, negative by value only.\n    This function adheres to the custom sorting rules defined in the specification.\n    \"\"\"\n\n    def _get_sort_key(n: int) -> Tuple[int, int, int]:\n        \"\"\"\n        Generates a tuple for sorting: (category, primary_value, secondary_value).\n        Category 0 for negatives (sorted by value), 1 for non-negatives (sorted by bit count then value).\n        \"\"\"\n        if n < 0:\n            return (0, 0, n)\n        else:\n            bit_count = bin(n).count('1')\n            return (1, bit_count, n)\n\n    return sorted(arr, key=_get_sort_key)"}
{"task_id": "HumanEval/116", "solution": "def count_set_bits(n: int) -> int:\n    \"\"\"\n    Counts set bits in an integer using the built-in method.\n    This efficiently handles positive, negative, and zero integers.\n    \"\"\"\n    return n.bit_count()\ndef sort_array(arr: list[int]) -> list[int]:\n    \"\"\"\n    Sorts a list of integers primarily by their set bit count, then by decimal value.\n    This ensures stable sorting according to the specified criteria.\n    \"\"\"\n    return sorted(arr, key=lambda x: (count_set_bits(x), x))"}
{"task_id": "HumanEval/116", "solution": "def sort_array(arr: list[int]) -> list[int]:\n    \"\"\"\n    Sorts an array of integers based on specific rules: primarily by set bit count for\n    non-negative numbers, secondarily by decimal value, and grouping negative numbers first.\n    \"\"\"\n    if not arr:\n        return []\n\n    def _count_set_bits_local(n: int) -> int:\n        \"\"\"Counts the number of set bits in a non-negative integer.\"\"\"\n        return bin(n).count('1')\n\n    def _get_sort_key_local(num: int) -> tuple[int, int]:\n        \"\"\"\n        Generates a custom sorting key: (-1, num) for negatives, (bit_count, num) for non-negatives.\n        \"\"\"\n        if num < 0:\n            return (-1, num)\n        else:\n            return (_count_set_bits_local(num), num)\n\n    return sorted(arr, key=_get_sort_key_local)"}
{"task_id": "HumanEval/116", "solution": "def sort_array(arr):\n    \"\"\"\n    In this Kata, you have to sort an array of non-negative integers according to\n    number of ones in their binary representation in ascending order.\n    For similar number of ones, sort based on decimal value.\n\n    It must be implemented like this:\n    >>> sort_array([1, 5, 2, 3, 4]) == [1, 2, 3, 4, 5]\n    >>> sort_array([-2, -3, -4, -5, -6]) == [-6, -5, -4, -3, -2]\n    >>> sort_array([1, 0, 2, 3, 4]) [0, 1, 2, 3, 4]\n    \"\"\"\n    def get_sort_key(num):\n        # For negative numbers, sort directly by their decimal value.\n        # Assign a primary key of -1 to ensure they come before any non-negative numbers.\n        if num < 0:\n            return (-1, num)\n        else:\n            # For non-negative numbers, first sort by the count of set bits.\n            # Then, for similar bit counts, sort by decimal value.\n            return (bin(num).count('1'), num)\n\n    return sorted(arr, key=get_sort_key)"}
{"task_id": "HumanEval/116", "solution": "def _get_sort_key(n):\n    \"\"\"\n    Generates the sorting key for an integer.\n    The key is a tuple (count_of_ones, n) for custom primary and secondary sorting.\n    \"\"\"\n    count_of_ones = bin(n).count('1')\n    return (count_of_ones, n)\ndef sort_array(arr):\n    \"\"\"\n    Sorts a list of integers based on the count of '1's in binary representation\n    (primary) and decimal value (secondary). It returns a new sorted list.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input 'arr' must be a list.\")\n    if not all(isinstance(x, int) for x in arr):\n        raise TypeError(\"All elements in 'arr' must be integers.\")\n\n    return sorted(arr, key=_get_sort_key)"}
{"task_id": "HumanEval/116", "solution": "def sort_array(arr):\n    \"\"\"\n    Sorts an array of non-negative integers primarily by the count of '1's in their binary\n    representation (ascending), and secondarily by their decimal value (ascending) for ties.\n    Raises TypeError for invalid input types or ValueError for negative numbers.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input must be a list.\")\n\n    # Helper function to compute the custom sort key for an element.\n    # It validates the element type and value.\n    def _get_sort_key(n):\n        if not isinstance(n, int):\n            raise TypeError(f\"Array elements must be integers, got {type(n)}.\")\n        if n < 0:\n            raise ValueError(\"Input array must contain non-negative integers.\")\n        return (bin(n).count('1'), n)\n\n    return sorted(arr, key=_get_sort_key)"}
