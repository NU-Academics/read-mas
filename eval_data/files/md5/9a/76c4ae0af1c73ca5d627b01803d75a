{"task_id": "HumanEval/128", "solution": "from typing import List, Optional\ndef _get_sign(num: int) -> int:\n    \"\"\"\n    Determines the sign of an integer.\n    Returns 1 for positive, -1 for negative, and 0 for zero.\n    \"\"\"\n    if num > 0:\n        return 1\n    elif num < 0:\n        return -1\n    else:\n        return 0\ndef prod_signs(arr: List[int]) -> Optional[int]:\n    \"\"\"\n    Calculates the sum of magnitudes of integers multiplied by the product of all signs.\n    Returns None for an empty array as per requirements.\n    \"\"\"\n    if not arr:\n        return None\n\n    sum_magnitudes = 0\n    product_signs = 1\n\n    for num in arr:\n        sum_magnitudes += abs(num)\n        product_signs *= _get_sign(num)\n        # Optimization: if any sign is 0, the product of signs will remain 0.\n        if product_signs == 0:\n            break\n\n    return sum_magnitudes * product_signs"}
{"task_id": "HumanEval/129", "solution": "from typing import List, Tuple, Optional\nDIRECTIONS: List[Tuple[int, int]] = [(0, 1), (0, -1), (1, 0), (-1, 0)]\ndef is_valid_coordinate(r: int, c: int, N: int) -> bool:\n    # Checks if a given (r, c) coordinate is within grid bounds.\n    return 0 <= r < N and 0 <= c < N\nclass Grid:\n    def __init__(self, data: List[List[int]]) -> None:\n        if not data or not all(isinstance(row, list) for row in data):\n            raise ValueError(\"Grid data must be a non-empty list of lists.\")\n        N = len(data)\n        if not all(len(row) == N for row in data):\n            raise ValueError(\"Grid must be square (N x N).\")\n        self._data = data\n        self._N = N\n\n    def get_value(self, r: int, c: int) -> int:\n        # Returns the integer value at the specified row and column.\n        if not is_valid_coordinate(r, c, self._N):\n            raise IndexError(f\"Coordinates ({r}, {c}) are out of bounds for N={self._N}.\")\n        return self._data[r][c]\n\n    def get_neighbors(self, r: int, c: int) -> List[Tuple[int, int]]:\n        # Returns a list of valid (row, col) tuples for adjacent cells.\n        neighbors = []\n        for dr, dc in DIRECTIONS:\n            nr, nc = r + dr, c + dc\n            if is_valid_coordinate(nr, nc, self._N):\n                neighbors.append((nr, nc))\n        return neighbors\n\n    def get_N(self) -> int:\n        # Returns the dimension N of the grid.\n        return self._N\nclass PathFinder:\n    def __init__(self, grid: Grid, k: int) -> None:\n        if k <= 0:\n            raise ValueError(\"Path length k must be a positive integer.\")\n        self._grid = grid\n        self._k = k\n        self._min_path: Optional[List[int]] = None\n\n    def find_min_path(self) -> List[int]:\n        # Initiates DFS from every cell to find the smallest path.\n        N = self._grid.get_N()\n        for r in range(N):\n            for c in range(N):\n                self._dfs(r, c, [])\n        return self._min_path if self._min_path is not None else []\n\n    def _dfs(self, r: int, c: int, current_path_values: List[int]) -> None:\n        current_path_values.append(self._grid.get_value(r, c))\n\n        # Base Case: Path of length k found.\n        if len(current_path_values) == self._k:\n            if self._min_path is None or current_path_values < self._min_path:\n                self._min_path = list(current_path_values)\n            current_path_values.pop() # Backtrack.\n            return\n\n        # Pruning: Terminate if current path prefix is already too large.\n        if self._min_path is not None:\n            current_len = len(current_path_values)\n            if current_path_values > self._min_path[:current_len]:\n                current_path_values.pop() # Backtrack.\n                return\n\n        # Recursive Step: Explore neighbors.\n        # Cells can be revisited as per problem statement.\n        for nr, nc in self._grid.get_neighbors(r, c):\n            self._dfs(nr, nc, current_path_values)\n\n        current_path_values.pop() # Backtrack.\ndef minPath(grid: List[List[int]], k: int) -> List[int]:\n    \"\"\"\n    Finds the lexicographically smallest path of length k in a grid.\n    You can start from any cell and move to adjacent cells (up, down, left, right).\n    \"\"\"\n    grid_obj = Grid(grid)\n    finder = PathFinder(grid_obj, k)\n    return finder.find_min_path()"}
{"task_id": "HumanEval/129", "solution": "import heapq\ndef minPath(grid, k):\n    \"\"\"\n    Finds the lexicographically smallest path of length k in a grid.\n    Uses a Dijkstra-like algorithm with a priority queue to explore paths.\n    \"\"\"\n    N = len(grid)\n\n    def get_neighbors_internal(r: int, c: int) -> list[tuple[int, int]]:\n        \"\"\"\n        Returns valid (row, col) coordinates for neighbors of (r, c) within the grid.\n        Movement is restricted to cells sharing an edge.\n        \"\"\"\n        neighbors = []\n        moves = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Up, Down, Left, Right\n        for dr, dc in moves:\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < N and 0 <= nc < N: # Boundary check\n                neighbors.append((nr, nc))\n        return neighbors\n\n    pq = []  # Stores (path_tuple, row, col, current_length) for exploration.\n    # Dist stores the lexicographically smallest path tuple to reach (r, c) with 'length' steps.\n    dist = {} # Key: (row, col, length), Value: path_tuple\n\n    # Initialize priority queue with all single-cell paths.\n    for r_start in range(N):\n        for c_start in range(N):\n            initial_path = (grid[r_start][c_start],)\n            heapq.heappush(pq, (initial_path, r_start, c_start, 1))\n            dist[(r_start, c_start, 1)] = initial_path\n\n    while pq:\n        current_path, r, c, length = heapq.heappop(pq)\n\n        # If a better or equal path to this state was already processed, skip.\n        if (r, c, length) in dist and current_path > dist[(r, c, length)]:\n            continue\n\n        # If the target length k is reached, return this path as it's guaranteed to be the smallest.\n        if length == k:\n            return list(current_path)\n\n        # Explore neighbors if the path can still be extended.\n        if length < k:\n            for nr, nc in get_neighbors_internal(r, c):\n                next_value = grid[nr][nc]\n                new_path = current_path + (next_value,)\n                new_length = length + 1\n\n                # If this new path is better than any previously found, update and add to queue.\n                if (nr, nc, new_length) not in dist or new_path < dist[(nr, nc, new_length)]:\n                    dist[(nr, nc, new_length)] = new_path\n                    heapq.heappush(pq, (new_path, nr, nc, new_length))\n\n    # This part should ideally not be reached given problem constraints (a path of length k is guaranteed).\n    return []"}
{"task_id": "HumanEval/129", "solution": "import heapq\nfrom typing import List, Tuple, Dict, Optional\nfrom dataclasses import dataclass, field\ndef minPath(grid: List[List[int]], k: int) -> List[int]:\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k, \n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n\n    Examples:\n\n        Input: grid = [ [1,2,3], [4,5,6], [7,8,9]], k = 3\n        Output: [1, 2, 1]\n\n        Input: grid = [ [5,9,3], [4,1,6], [7,8,2]], k = 1\n        Output: [1]\n    \"\"\"\n\n    class Grid:\n        \"\"\"Manages grid data, provides cell values and neighbor access.\"\"\"\n        def __init__(self, grid_data_inner: List[List[int]]):\n            if not grid_data_inner or not grid_data_inner[0] or \\\n               len(grid_data_inner) != len(grid_data_inner[0]) or \\\n               len(grid_data_inner) < 2:\n                raise ValueError(\"Grid must be a square N x N grid with N >= 2.\")\n            self._grid = grid_data_inner\n            self.rows = len(grid_data_inner)\n            self.cols = len(grid_data_inner[0])\n\n        def get_value(self, r: int, c: int) -> int:\n            \"\"\"Returns the integer value at specified coordinates.\"\"\"\n            if not (0 <= r < self.rows and 0 <= c < self.cols):\n                raise IndexError(\"Coordinates out of grid bounds.\")\n            return self._grid[r][c]\n\n        def get_neighbors(self, r: int, c: int) -> List[Tuple[int, int]]:\n            \"\"\"Returns valid (row, col) tuples for adjacent cells.\"\"\"\n            neighbors = []\n            moves = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Up, Down, Left, Right\n            for dr, dc in moves:\n                nr, nc = r + dr, c + dc\n                if 0 <= nr < self.rows and 0 <= nc < self.cols:\n                    neighbors.append((nr, nc))\n            return neighbors\n\n    @dataclass(order=True)\n    class Path:\n        \"\"\"Represents a path segment for lexicographical comparison.\"\"\"\n        values: Tuple[int, ...] = field(compare=True)\n        row: int = field(compare=False)\n        col: int = field(compare=False)\n\n    class MinPathFinder:\n        \"\"\"Implements the core path-finding algorithm using a modified Dijkstra-like approach.\"\"\"\n        def __init__(self, grid_data_inner: List[List[int]], k_inner: int):\n            self.grid = Grid(grid_data_inner)\n            self.k = k_inner\n            self.pq: List[Path] = []\n            self.min_paths_to_state: Dict[Tuple[int, int, int], Tuple[int, ...]] = {}\n            self.N = self.grid.rows\n\n        def find_min_path(self) -> List[int]:\n            \"\"\"Executes the search to find the unique lexicographically smallest path of length k.\"\"\"\n            min_path_overall: Optional[List[int]] = None\n\n            # Initialize priority queue with all single-cell paths.\n            for r in range(self.N):\n                for c in range(self.N):\n                    initial_value = self.grid.get_value(r, c)\n                    initial_path_tuple = (initial_value,)\n                    initial_path = Path(values=initial_path_tuple, row=r, col=c)\n                    heapq.heappush(self.pq, initial_path)\n                    self.min_paths_to_state[(r, c, 1)] = initial_path_tuple\n\n            while self.pq:\n                current_path_obj = heapq.heappop(self.pq)\n                current_path_values = current_path_obj.values\n                r, c = current_path_obj.row, current_path_obj.col\n                current_length = len(current_path_values)\n\n                # Pruning: Skip if a lexicographically smaller path to this state already exists.\n                if self.min_paths_to_state.get((r, c, current_length)) != current_path_values:\n                    continue\n\n                # If path length k is reached, compare and update the overall minimum.\n                if current_length == self.k:\n                    if min_path_overall is None or current_path_values < tuple(min_path_overall):\n                        min_path_overall = list(current_path_values)\n                    continue\n\n                # Extend path to neighbors if not yet at length k.\n                for nr, nc in self.grid.get_neighbors(r, c):\n                    neighbor_value = self.grid.get_value(nr, nc)\n                    new_path_values = current_path_values + (neighbor_value,)\n                    new_length = current_length + 1\n\n                    if new_length <= self.k:\n                        existing_min_path_for_state = self.min_paths_to_state.get((nr, nc, new_length))\n                        # Add new path to PQ if it's the smallest to reach this new state.\n                        if existing_min_path_for_state is None or new_path_values < existing_min_path_for_state:\n                            self.min_paths_to_state[(nr, nc, new_length)] = new_path_values\n                            new_path_obj = Path(values=new_path_values, row=nr, col=nc)\n                            heapq.heappush(self.pq, new_path_obj)\n            \n            # The problem guarantees a path of length k exists.\n            if min_path_overall is None:\n                raise RuntimeError(\"No path of length k found.\")\n            return min_path_overall\n\n    finder = MinPathFinder(grid, k)\n    return finder.find_min_path()"}
{"task_id": "HumanEval/129", "solution": "import heapq\nfrom dataclasses import dataclass\nfrom typing import List, Tuple, Dict\nclass MinPathFinder:\n    \"\"\"\n    Finds the lexicographically smallest path of length k in a given grid.\n    \"\"\"\n    def __init__(self, grid: List[List[int]], k: int):\n        if not grid or not all(len(row) == len(grid) for row in grid):\n            raise ValueError(\"Grid must be square and non-empty.\")\n        self._N = len(grid)\n        if self._N < 2:\n            raise ValueError(\"Grid dimension N must be at least 2.\")\n        if not isinstance(k, int) or k <= 0:\n            raise ValueError(\"Path length k must be a positive integer.\")\n\n        self._grid = grid\n        self._k = k\n        self._pq: List[PathState] = []\n        self._min_paths_to_state: Dict[Tuple[int, int, int], Tuple[int, ...]] = {}\n\n    def _is_valid_coord(self, r: int, c: int) -> bool:\n        \"\"\"Checks if a coordinate is within grid boundaries.\"\"\"\n        return 0 <= r < self._N and 0 <= c < self._N\n\n    def _get_neighbors(self, r: int, c: int) -> List[Tuple[int, int]]:\n        \"\"\"Returns valid adjacent neighbors for a given cell.\"\"\"\n        neighbors = []\n        directions = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n        for dr, dc in directions:\n            nr, nc = r + dr, c + dc\n            if self._is_valid_coord(nr, nc):\n                neighbors.append((nr, nc))\n        return neighbors\n\n    def find_min_path(self) -> List[int]:\n        \"\"\"\n        Executes the pathfinding algorithm to find the lexicographically smallest path of length k.\n        \"\"\"\n        for r_start in range(self._N):\n            for c_start in range(self._N):\n                initial_path_values = (self._grid[r_start][c_start],)\n                initial_state = PathState(initial_path_values, r_start, c_start, 1)\n                heapq.heappush(self._pq, initial_state)\n                self._min_paths_to_state[(r_start, c_start, 1)] = initial_path_values\n\n        while self._pq:\n            current_state = heapq.heappop(self._pq)\n\n            if current_state.steps == self._k:\n                return list(current_state.path_values)\n\n            state_key = (current_state.row, current_state.col, current_state.steps)\n            if state_key in self._min_paths_to_state and \\\n               current_state.path_values > self._min_paths_to_state[state_key]:\n                continue\n\n            for nr, nc in self._get_neighbors(current_state.row, current_state.col):\n                new_path_values = current_state.path_values + (self._grid[nr][nc],)\n                new_steps = current_state.steps + 1\n\n                if new_steps > self._k:\n                    continue\n\n                new_state_key = (nr, nc, new_steps)\n                if new_state_key not in self._min_paths_to_state or \\\n                   new_path_values < self._min_paths_to_state[new_state_key]:\n                    self._min_paths_to_state[new_state_key] = new_path_values\n                    heapq.heappush(self._pq, PathState(new_path_values, nr, nc, new_steps))\n        \n        return []\ndef minPath(grid: List[List[int]], k: int) -> List[int]:\n    \"\"\"\n    Given a grid with N rows and N columns and a positive integer k,\n    find the minimum path of length k in the grid.\n    \"\"\"\n    finder = MinPathFinder(grid, k)\n    return finder.find_min_path()"}
{"task_id": "HumanEval/129", "solution": "import heapq\nfrom typing import List, Tuple, Dict, Optional\nDIRECTIONS: List[Tuple[int, int]] = [\n    (-1, 0),  # Up\n    (1, 0),   # Down\n    (0, -1),  # Left\n    (0, 1)    # Right\n]\ndef _get_neighbors(r: int, c: int, N: int) -> List[Tuple[int, int]]:\n    \"\"\"\n    Helper function to get valid neighbor coordinates within the grid boundaries.\n    It considers cells sharing an edge (up, down, left, right).\n    \"\"\"\n    neighbors = []\n    for dr, dc in DIRECTIONS:\n        nr, nc = r + dr, c + dc\n        if 0 <= nr < N and 0 <= nc < N:\n            neighbors.append((nr, nc))\n    return neighbors\ndef minPath(grid: List[List[int]], k: int) -> List[int]:\n    \"\"\"\n    Finds the lexicographically smallest path of length k in the grid.\n    The search uses a priority queue for efficiency and pruning based on path lexicography.\n    \"\"\"\n    N = len(grid)\n    min_path_result: Optional[Tuple[int, ...]] = None\n\n    # Priority queue stores (path_tuple, current_row, current_col).\n    # Path_tuple is the primary key for heap ordering, ensuring lexicographical sorting.\n    pq: List[Tuple[Tuple[int, ...], int, int]] = []\n\n    # Stores the lexicographically smallest path_tuple found to reach a\n    # (length, (row, col)) state, used for Dijkstra-like pruning.\n    best_paths_to_state: Dict[Tuple[int, Tuple[int, int]], Tuple[int, ...]] = {}\n\n    # Initialize the priority queue with all possible starting cells as paths of length 1.\n    for r_start in range(N):\n        for c_start in range(N):\n            initial_path = (grid[r_start][c_start],)\n            heapq.heappush(pq, (initial_path, r_start, c_start))\n            best_paths_to_state[(1, (r_start, c_start))] = initial_path\n\n    while pq:\n        current_path_tuple, r, c = heapq.heappop(pq)\n        current_length = len(current_path_tuple)\n\n        # Prune if a lexicographically better path to this state (length, (r,c)) has already been found.\n        if current_path_tuple > best_paths_to_state.get((current_length, (r, c)), current_path_tuple):\n            continue\n\n        # Prune if the current path's prefix is already lexicographically worse than\n        # the best k-length path found so far.\n        if min_path_result is not None and current_path_tuple >= min_path_result[:current_length]:\n            continue\n\n        # If a path of length k is found, update the overall minimum path.\n        if current_length == k:\n            if min_path_result is None or current_path_tuple < min_path_result:\n                min_path_result = current_path_tuple\n            continue  # No need to extend paths that have reached length k.\n\n        # Explore valid neighbors to extend the current path.\n        for nr, nc in _get_neighbors(r, c, N):\n            new_path_tuple = current_path_tuple + (grid[nr][nc],)\n            new_length = current_length + 1\n\n            # Skip if the new path would exceed the target length k.\n            if new_length > k:\n                continue\n\n            state_key = (new_length, (nr, nc))\n            existing_best_for_state = best_paths_to_state.get(state_key)\n\n            # If this new path is lexicographically better than any previously found path\n            # to this specific state (length, (nr, nc)), update and push to PQ.\n            if existing_best_for_state is None or new_path_tuple < existing_best_for_state:\n                best_paths_to_state[state_key] = new_path_tuple\n                heapq.heappush(pq, (new_path_tuple, nr, nc))\n\n    # The problem guarantees a unique answer, so min_path_result will not be None.\n    return list(min_path_result)"}
