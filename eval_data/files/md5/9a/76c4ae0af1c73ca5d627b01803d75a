{"task_id": "HumanEval/94", "solution": "import math\nclass NoPrimeFoundError(Exception):\n    \"\"\"Raised when no prime number is found in a list.\n    Provides clear feedback for this specific error condition.\"\"\"\n    def __init__(self, message: str = \"No prime number found in the list.\"):\n        self.message = message\n        super().__init__(self.message)\ndef is_prime(n: int) -> bool:\n    \"\"\"Checks if an integer is a prime number.\n    Implements trial division up to the square root for efficiency.\"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    # Only check odd divisors up to sqrt(n).\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        if n % i == 0:\n            return False\n    return True\ndef sum_digits(n: int) -> int:\n    \"\"\"Calculates the sum of the absolute value of an integer's digits.\n    Converts the number to a string to easily iterate over digits.\"\"\"\n    return sum(int(digit) for digit in str(abs(n)))\ndef skjkasdkd(lst: list[int]) -> int:\n    \"\"\"Finds the largest prime in a list and returns the sum of its digits.\n    Raises NoPrimeFoundError if no prime numbers are found.\"\"\"\n    largest_prime: int | None = None\n\n    for number in lst:\n        if is_prime(number):\n            if largest_prime is None or number > largest_prime:\n                largest_prime = number\n\n    if largest_prime is None:\n        raise NoPrimeFoundError(\"No prime number found in the input list.\")\n\n    return sum_digits(largest_prime)"}
{"task_id": "HumanEval/95", "solution": "from typing import Any, Dict, List\ndef check_dict_case(dict: Dict[Any, Any]) -> bool:\n    \"\"\"Checks if a dictionary's string keys are uniformly lowercase or uppercase.\n    Returns False if empty or contains non-string keys.\"\"\"\n\n    # FR4, BR5.2: Handle empty dictionary.\n    if not dict:\n        return False\n\n    # FR5, BR5.3: Check for non-string keys and collect string keys.\n    string_keys: List[str] = []\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False  # Non-string key found, return False.\n        string_keys.append(key)\n\n    # Helper function for FR1: Checks if all strings in a list are entirely lowercase.\n    def _is_all_lowercase(keys_list: List[str]) -> bool:\n        return all(key == key.lower() for key in keys_list)\n\n    # Helper function for FR2: Checks if all strings in a list are entirely uppercase.\n    def _is_all_uppercase(keys_list: List[str]) -> bool:\n        return all(key == key.upper() for key in keys_list)\n\n    # FR3: Perform the uniform casing check using the collected string keys.\n    if _is_all_lowercase(string_keys):\n        return True\n    \n    if _is_all_uppercase(string_keys):\n        return True\n\n    return False"}
{"task_id": "HumanEval/95", "solution": "from typing import Dict, Any\ndef check_dict_case(data: Dict[Any, Any]) -> bool:\n    \"\"\"\n    Determines if all keys in the dictionary are strings and uniformly cased (all lowercase or all uppercase).\n    Returns False for empty dictionaries or those with non-string keys.\n    \"\"\"\n    if not data:\n        return False\n\n    keys = list(data.keys())\n\n    # First, check if all keys are strings\n    if not all(isinstance(key, str) for key in keys):\n        return False\n\n    # If all keys are strings, check for uniform casing\n    all_lower = all(key.islower() for key in keys)\n    if all_lower:\n        return True\n\n    all_upper = all(key.isupper() for key in keys)\n    if all_upper:\n        return True\n\n    return False"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Checks if all string keys in a dictionary are uniformly cased (all lowercase or all uppercase).\n    Returns False if the dictionary is empty, contains non-string keys, or has mixed casing.\n    \"\"\"\n    if not dict:\n        return False\n\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False\n\n    all_lowercase = all(key == key.lower() for key in dict.keys())\n    all_uppercase = all(key == key.upper() for key in dict.keys())\n\n    return all_lowercase or all_uppercase"}
