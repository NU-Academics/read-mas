{"task_id": "HumanEval/36", "solution": "from typing import ClassVar\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass NumberProcessor:\n    \"\"\"Provides static utility methods for number-related operations.\"\"\"\n    TARGET_DIGIT: ClassVar[int] = 7\n    DIVISOR_1: ClassVar[int] = 11\n    DIVISOR_2: ClassVar[int] = 13\n\n    @staticmethod\n    def is_divisible_by_11_or_13(num: int) -> bool:\n        \"\"\"Checks if a number is divisible by 11 or 13.\"\"\"\n        return (num % NumberProcessor.DIVISOR_1 == 0) or \\\n               (num % NumberProcessor.DIVISOR_2 == 0)\n\n    @staticmethod\n    def count_digit_occurrences(num: int, digit: int) -> int:\n        \"\"\"Counts how many times a specific digit appears in a number.\"\"\"\n        return str(num).count(str(digit))\nclass FizzBuzzService:\n    \"\"\"Orchestrates the core logic for counting digit occurrences.\"\"\"\n    def count_sevens_in_divisible_numbers(self, n: int) -> int:\n        \"\"\"Calculates total occurrences of '7' in numbers < n divisible by 11 or 13.\"\"\"\n        total_sevens_count = 0\n        for i in range(1, n):\n            if NumberProcessor.is_divisible_by_11_or_13(i):\n                total_sevens_count += NumberProcessor.count_digit_occurrences(\n                    i, NumberProcessor.TARGET_DIGIT\n                )\n        return total_sevens_count\ndef fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n\n    which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise InvalidInputError(\"Input 'n' must be a positive integer.\")\n\n    service = FizzBuzzService()\n    return service.count_sevens_in_divisible_numbers(n)"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list) -> list:\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"Input must be a list.\")\n\n    # Create a mutable copy of the input list to avoid modifying the original.\n    result_list = list(l)\n\n    # Extract elements at even indices and sort them.\n    even_elements = [l[i] for i in range(0, len(l), 2)]\n    even_elements.sort()\n\n    # Place the sorted even elements back into their original even positions.\n    sorted_idx_counter = 0\n    for i in range(0, len(l), 2):\n        result_list[i] = even_elements[sorted_idx_counter]\n        sorted_idx_counter += 1\n\n    return result_list"}
