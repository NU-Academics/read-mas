{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int) -> int:\n    \"\"\"sum_to_n is a function that sums numbers from 1 to n.\n    >>> sum_to_n(30)\n    465\n    >>> sum_to_n(100)\n    5050\n    >>> sum_to_n(5)\n    15\n    >>> sum_to_n(10)\n    55\n    >>> sum_to_n(1)\n    1\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"n must be a positive integer (>= 1)\")\n    return n * (n + 1) // 2"}
{"task_id": "HumanEval/60", "solution": "from typing import Any\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    def __init__(self, message: str, param_name: str, value: Any):\n        super().__init__(message)\n        self.param_name = param_name\n        self.value = value\nclass InputValidator:\n    \"\"\"Provides utility methods for validating common input patterns.\"\"\"\n    @staticmethod\n    def validate_positive_integer(value: Any, param_name: str) -> int:\n        \"\"\"Validates if a value is a positive integer (>= 1).\n        Raises InvalidInputError if validation fails.\n        \"\"\"\n        if not isinstance(value, int):\n            raise InvalidInputError(\n                f\"{param_name} must be an integer.\", param_name, value\n            )\n        if value < 1:\n            raise InvalidInputError(\n                f\"{param_name} must be greater than or equal to 1.\", param_name, value\n            )\n        return value\ndef sum_to_n(n: int):\n    \"\"\"sum_to_n sums numbers from 1 to n.\n    It validates input `n` and computes the sum efficiently.\n    \"\"\"\n    try:\n        validated_n = InputValidator.validate_positive_integer(n, \"n\")\n    except InvalidInputError as e:\n        if \"must be an integer\" in e.message:\n            raise TypeError(e.message) from e\n        else: # \"must be greater than or equal to 1\"\n            raise ValueError(e.message) from e\n\n    # Using the arithmetic series formula for efficiency\n    return validated_n * (validated_n + 1) // 2"}
{"task_id": "HumanEval/61", "solution": "def correct_bracketing(brackets: str):\n    \"\"\"\n    Checks if every opening bracket has a corresponding closing bracket.\n    The string must contain only '(' and ')' characters.\n    \"\"\"\n    open_count = 0\n    for char in brackets:\n        if char == '(':\n            open_count += 1\n        elif char == ')':\n            open_count -= 1\n        \n        if open_count < 0: # A closing bracket appeared without a corresponding open one.\n            return False\n        \n    return open_count == 0"}
