{"task_id": "HumanEval/67", "solution": "import re\nfrom dataclasses import dataclass\nclass InvalidFruitStringError(ValueError):\n    \"\"\"Exception raised for errors in the input fruit string format.\"\"\"\n    pass\nclass InvalidFruitCountError(ValueError):\n    \"\"\"Exception raised when total fruits are less than known fruits.\"\"\"\n    pass\nclass FruitParser:\n    \"\"\"Parses a string to extract apple and orange counts.\"\"\"\n    _FRUIT_PATTERN = r\"(\\d+)\\s*apples\\s*and\\s*(\\d+)\\s*oranges\"\n\n    @staticmethod\n    def parse_fruit_string(s: str) -> 'FruitCounts':\n        \"\"\"Extracts apple and orange counts from a string.\n        Raises InvalidFruitStringError for incorrect format or invalid counts.\"\"\"\n        match = re.search(FruitParser._FRUIT_PATTERN, s)\n        if not match:\n            raise InvalidFruitStringError(f\"Invalid fruit string format: '{s}'. Expected 'X apples and Y oranges'.\")\n\n        try:\n            apples = int(match.group(1))\n            oranges = int(match.group(2))\n            if apples < 0 or oranges < 0:\n                raise InvalidFruitStringError(\"Fruit counts cannot be negative.\")\n            return FruitCounts(apples=apples, oranges=oranges)\n        except ValueError as e:\n            raise InvalidFruitStringError(f\"Could not parse fruit counts as integers: {e}\")\nclass FruitCalculator:\n    \"\"\"Calculates the number of mango fruits in a basket.\"\"\"\n    @staticmethod\n    def calculate_mangoes(total_fruits: int, fruit_string: str) -> int:\n        \"\"\"Calculates the number of mango fruits.\n        Raises exceptions for invalid fruit string format or insufficient total fruits.\"\"\"\n        if total_fruits < 0:\n            raise InvalidFruitCountError(\"Total fruits cannot be negative.\")\n\n        fruit_counts: FruitCounts = FruitParser.parse_fruit_string(fruit_string)\n\n        known_fruits = fruit_counts.apples + fruit_counts.oranges\n\n        if total_fruits < known_fruits:\n            raise InvalidFruitCountError(\n                f\"Total fruits ({total_fruits}) cannot be less than known fruits \"\n                f\"({known_fruits} = {fruit_counts.apples} apples + {fruit_counts.oranges} oranges).\"\n            )\n\n        return total_fruits - known_fruits\ndef fruit_distribution(s: str, n: int) -> int:\n    \"\"\"Calculates the number of mango fruits in a basket.\n    's' describes apples and oranges; 'n' is the total fruits.\"\"\"\n    return FruitCalculator.calculate_mangoes(n, s)"}
{"task_id": "HumanEval/67", "solution": "import re\nfrom dataclasses import dataclass\nclass InvalidFruitStringError(Exception):\n    \"\"\"Custom exception for invalid fruit distribution string format.\"\"\"\n    pass\nclass FruitStringParser:\n    \"\"\"Parses a string to extract apple and orange counts.\"\"\"\n    FRUIT_STRING_PATTERN = r\"(\\d+)\\s*apples\\s*and\\s*(\\d+)\\s*oranges\"\n\n    @staticmethod\n    def parse(s: str) -> FruitCounts:\n        \"\"\"Extracts apple and orange counts from the input string.\n        Raises InvalidFruitStringError for format mismatches or non-integer counts.\n        \"\"\"\n        match = re.fullmatch(FruitStringParser.FRUIT_STRING_PATTERN, s)\n        if not match:\n            raise InvalidFruitStringError(\n                f\"Input string '{s}' does not match expected format 'X apples and Y oranges'.\"\n            )\n        try:\n            apples = int(match.group(1))\n            oranges = int(match.group(2))\n            return FruitCounts(apples=apples, oranges=oranges)\n        except ValueError as e:\n            raise InvalidFruitStringError(\n                f\"Could not convert extracted counts to integers in '{s}': {e}\"\n            )\nclass FruitCalculationService:\n    \"\"\"Provides core business logic for calculating mangoes.\"\"\"\n    def calculate_mangoes(self, fruit_counts: FruitCounts, total_fruits: int) -> int:\n        \"\"\"Calculates mangoes, raising ValueError if total_fruits is insufficient.\n        Ensures total fruits are not less than the sum of apples and oranges.\n        \"\"\"\n        total_apples_oranges = fruit_counts.apples + fruit_counts.oranges\n        if total_fruits < total_apples_oranges:\n            raise ValueError(\n                f\"Invalid fruit distribution: Total fruits ({total_fruits}) \"\n                f\"are less than apples ({fruit_counts.apples}) + oranges ({fruit_counts.oranges}).\"\n            )\n        return total_fruits - total_apples_oranges\ndef fruit_distribution(s, n):\n    \"\"\"Calculates the number of mango fruits in a basket based on a string and total count.\n    Propagates InvalidFruitStringError for parsing issues or ValueError for illogical counts.\n    \"\"\"\n    parser = FruitStringParser()\n    fruit_counts = parser.parse(s)\n\n    calculator = FruitCalculationService()\n    mango_count = calculator.calculate_mangoes(fruit_counts, n)\n\n    return mango_count"}
{"task_id": "HumanEval/67", "solution": "import re\nclass ParsingError(Exception):\n    \"\"\"Custom exception for errors during string parsing.\"\"\"\n    pass\nclass InvalidFruitCountError(ValueError):\n    \"\"\"Custom exception for invalid fruit count logic.\"\"\"\n    pass\nclass FruitParser:\n    \"\"\"\n    Parses fruit counts (apples and oranges) from a given string.\n    \"\"\"\n    _APPLE_PATTERN = re.compile(r\"(\\d+)\\s+apples\")\n    _ORANGE_PATTERN = re.compile(r\"(\\d+)\\s+oranges\")\n\n    def __init__(self):\n        \"\"\"Initializes the FruitParser.\"\"\"\n        pass # Patterns are compiled at class level\n\n    def parse_fruit_counts(self, s: str) -> tuple[int, int]:\n        \"\"\"\n        Extracts apple and orange counts from the input string 's'.\n        It raises ParsingError if counts are not found.\n        \"\"\"\n        apple_match = self._APPLE_PATTERN.search(s)\n        orange_match = self._ORANGE_PATTERN.search(s)\n\n        if not apple_match:\n            raise ParsingError(\"Could not find apple count in the string.\")\n        if not orange_match:\n            raise ParsingError(\"Could not find orange count in the string.\")\n\n        apples = int(apple_match.group(1))\n        oranges = int(orange_match.group(1))\n\n        return apples, oranges\nclass FruitDistributionService:\n    \"\"\"\n    Provides the core business logic for calculating fruit distribution,\n    specifically the number of mangoes.\n    \"\"\"\n    def __init__(self, parser: FruitParser):\n        \"\"\"\n        Initializes the service with a FruitParser dependency.\n        \"\"\"\n        self._fruit_parser = parser\n\n    def fruit_distribution(self, s: str, n: int) -> int:\n        \"\"\"\n        Calculates mangoes based on 's' and total 'n'.\n        It handles parsing and validates fruit counts, raising specific errors.\n        \"\"\"\n        if n < 0:\n            raise InvalidFruitCountError(\"Total fruit count 'n' cannot be negative.\")\n\n        try:\n            apples, oranges = self._fruit_parser.parse_fruit_counts(s)\n        except ParsingError as e:\n            raise e # Re-raise parsing errors\n\n        total_known_fruits = apples + oranges\n\n        if total_known_fruits > n:\n            raise InvalidFruitCountError(\n                f\"Total fruits ({n}) cannot be less than the sum of apples and oranges ({total_known_fruits}).\"\n            )\n\n        mangoes = n - total_known_fruits\n        return mangoes\ndef fruit_distribution(s: str, n: int) -> int:\n    \"\"\"\n    In this task, you will be given a string that represents a number of apples and oranges \n    that are distributed in a basket of fruit this basket contains \n    apples, oranges, and mango fruits. Given the string that represents the total number of \n    the oranges and apples and an integer that represent the total number of the fruits \n    in the basket return the number of the mango fruits in the basket.\n    for examble:\n    fruit_distribution(\"5 apples and 6 oranges\", 19) ->19 - 5 - 6 = 8\n    fruit_distribution(\"0 apples and 1 oranges\",3) -> 3 - 0 - 1 = 2\n    fruit_distribution(\"2 apples and 3 oranges\", 100) -> 100 - 2 - 3 = 95\n    fruit_distribution(\"100 apples and 1 oranges\",120) -> 120 - 100 - 1 = 19\n    \"\"\"\n    parser = FruitParser()\n    service = FruitDistributionService(parser)\n    return service.fruit_distribution(s, n)"}
{"task_id": "HumanEval/67", "solution": "import re\nclass ParsingError(ValueError):\n    \"\"\"Custom exception for errors during fruit string parsing.\"\"\"\n    pass\nclass FruitCounts:\n    \"\"\"\n    Represents the parsed counts of apples and oranges.\n    \"\"\"\n    def __init__(self, apples: int, oranges: int):\n        if not isinstance(apples, int) or apples < 0:\n            raise ValueError(\"Apple count must be a non-negative integer.\")\n        if not isinstance(oranges, int) or oranges < 0:\n            raise ValueError(\"Orange count must be a non-negative integer.\")\n        self.apples = apples\n        self.oranges = oranges\n\n    def total_known_fruits(self) -> int:\n        \"\"\"Calculates the sum of apples and oranges.\"\"\"\n        return self.apples + self.oranges\n\n    def __repr__(self) -> str:\n        return f\"FruitCounts(apples={self.apples}, oranges={self.oranges})\"\nclass FruitParser:\n    \"\"\"\n    Handles parsing of fruit distribution strings.\n    \"\"\"\n    _FRUIT_PATTERN = re.compile(r\"(\\d+)\\s*apples\\s*and\\s*(\\d+)\\s*oranges\")\n\n    @staticmethod\n    def parse_fruit_string(s: str) -> 'FruitCounts':\n        \"\"\"\n        Parses a string like \"5 apples and 6 oranges\" into FruitCounts.\n        Raises ParsingError if the string format is invalid.\n        \"\"\"\n        match = FruitParser._FRUIT_PATTERN.match(s.strip())\n        if not match:\n            raise ParsingError(f\"Invalid fruit string format: '{s}'. Expected 'X apples and Y oranges'.\")\n\n        try:\n            apples = int(match.group(1))\n            oranges = int(match.group(2))\n            return FruitCounts(apples, oranges)\n        except ValueError as e:\n            raise ParsingError(f\"Could not convert parsed numbers to integers: {e}\") from e\nclass FruitService:\n    \"\"\"\n    Provides business logic for calculating fruit distribution.\n    \"\"\"\n    def calculate_mangoes(self, fruit_string: str, total_fruits: int) -> int:\n        \"\"\"\n        Calculates mango fruits based on a string of apples/oranges and total fruits.\n        Raises ParsingError for malformed strings or ValueError for invalid counts.\n        \"\"\"\n        if not isinstance(total_fruits, int) or total_fruits < 0:\n            raise ValueError(\"Total fruits must be a non-negative integer.\")\n\n        fruit_counts: FruitCounts = FruitParser.parse_fruit_string(fruit_string)\n\n        known_fruits = fruit_counts.total_known_fruits()\n\n        if total_fruits < known_fruits:\n            raise ValueError(\n                f\"Total fruits ({total_fruits}) cannot be less than \"\n                f\"the sum of apples and oranges ({known_fruits}).\"\n            )\n\n        return total_fruits - known_fruits\ndef fruit_distribution(s,n):\n    \"\"\"\n    Calculates the number of mango fruits in a basket.\n    Raises ParsingError if the input string 's' is malformed, or ValueError for invalid fruit counts.\n    \"\"\"\n    service = FruitService()\n    return service.calculate_mangoes(s, n)"}
