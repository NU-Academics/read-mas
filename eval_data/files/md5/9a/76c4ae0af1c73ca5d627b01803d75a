{"task_id": "HumanEval/117", "solution": "VOWELS = {'a', 'e', 'i', 'o', 'u'}\ndef _is_consonant(char: str) -> bool:\n    \"\"\"Checks if a character is a consonant (case-insensitive).\n    Assumes char is an alphabet letter.\n    \"\"\"\n    lower_char = char.lower()\n    return lower_char.isalpha() and lower_char not in VOWELS\ndef _count_consonants(word: str) -> int:\n    \"\"\"Counts the number of consonants in a given word.\"\"\"\n    count = 0\n    for char in word:\n        if _is_consonant(char):\n            count += 1\n    return count\ndef select_words(s, n):\n    \"\"\"Given a string `s` and a number `n`, this function returns a list of words from `s` that contain exactly `n` consonants.\n    Words are returned in their original order; an empty string `s` yields an empty list.\n    \"\"\"\n    if not s:\n        return []\n\n    words = s.split()\n    result = []\n    for word in words:\n        if _count_consonants(word) == n:\n            result.append(word)\n    return result"}
{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"Given a string s and a natural number n, you have been tasked to implement \n    a function that returns a list of all words from string s that contain exactly \n    n consonants, in order these words appear in the string s.\n    If the string s is empty then the function should return an empty list.\n    Note: you may assume the input string contains only letters and spaces.\n    Examples:\n    select_words(\"Mary had a little lamb\", 4) ==> [\"little\"]\n    select_words(\"Mary had a little lamb\", 3) ==> [\"Mary\", \"lamb\"]\n    select_words(\"simple white space\", 2) ==> []\n    select_words(\"Hello world\", 4) ==> [\"world\"]\n    select_words(\"Uncle sam\", 3) ==> [\"Uncle\"]\n    \"\"\"\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    def is_vowel(char: str) -> bool:\n        \"\"\"Checks if a given character is an English vowel (case-insensitive).\"\"\"\n        return char.lower() in VOWELS\n\n    def count_consonants(word: str) -> int:\n        \"\"\"Counts the number of consonants in a given word. Non-alphabetic characters are ignored.\"\"\"\n        consonant_count = 0\n        for char in word:\n            if char.isalpha() and not is_vowel(char):\n                consonant_count += 1\n        return consonant_count\n\n    if not s:\n        return []\n\n    result_words: list[str] = []\n    words = s.split()\n\n    for word in words:\n        if count_consonants(word) == n:\n            result_words.append(word)\n\n    return result_words"}
{"task_id": "HumanEval/117", "solution": "def select_words(s: str, n: int) -> list[str]:\n    \"\"\"\n    Filters words from a string `s`, returning those with exactly `n` consonants, preserving original order.\n    If `s` is empty, an empty list is returned; assumes `s` contains only letters and spaces.\n    \"\"\"\n    if not s:\n        return []\n\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    def _is_vowel(char: str) -> bool:\n        \"\"\"Determines if a character is a vowel (case-insensitive) using a predefined set of vowels. Assumes the character is alphabetic.\"\"\"\n        return char.lower() in VOWELS\n\n    def _count_consonants(word: str) -> int:\n        \"\"\"Counts the number of consonants in a given word. It iterates through characters, checking if they are alphabetic and not vowels.\"\"\"\n        count = 0\n        for char in word:\n            if char.isalpha() and not _is_vowel(char):\n                count += 1\n        return count\n\n    result_words = []\n    # s.split() without arguments handles multiple spaces and leading/trailing spaces correctly.\n    words = s.split()\n\n    for word in words:\n        consonant_count = _count_consonants(word)\n        if consonant_count == n:\n            result_words.append(word)\n\n    return result_words"}
{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"Given a string s and a natural number n, returns a list of all words from string s that contain exactly \n    n consonants, in order these words appear in the string s.\n    If the string s is empty then the function should return an empty list.\n    \"\"\"\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    if not s:\n        return []\n\n    words = s.split()\n    result = []\n    for word in words:\n        consonant_count = 0\n        for char in word:\n            if char.isalpha() and char.lower() not in VOWELS:\n                consonant_count += 1\n        if consonant_count == n:\n            result.append(word)\n    return result"}
{"task_id": "HumanEval/117", "solution": "from typing import List\n_VOWELS = {'a', 'e', 'i', 'o', 'u'}\ndef _is_vowel(char: str) -> bool:\n    \"\"\"Checks if a character is a vowel, case-insensitively.\"\"\"\n    return char.lower() in _VOWELS\ndef _count_consonants(word: str) -> int:\n    \"\"\"Counts consonants in a word, treating 'y' as a consonant.\"\"\"\n    consonant_count = 0\n    for char in word:\n        if char.isalpha() and not _is_vowel(char):\n            consonant_count += 1\n    return consonant_count\ndef select_words(s, n):\n    \"\"\"Given a string s and a natural number n, you have been tasked to implement \n    a function that returns a list of all words from string s that contain exactly \n    n consonants, in order these words appear in the string s.\n    If the string s is empty then the function should return an empty list.\n    Note: you may assume the input string contains only letters and spaces.\n    Examples:\n    select_words(\"Mary had a little lamb\", 4) ==> [\"little\"]\n    select_words(\"Mary had a little lamb\", 3) ==> [\"Mary\", \"lamb\"]\n    select_words(\"simple white space\", 2) ==> []\n    select_words(\"Hello world\", 4) ==> [\"world\"]\n    select_words(\"Uncle sam\", 3) ==> [\"Uncle\"]\n    \"\"\"\n    if not s:\n        return []\n\n    result_words: List[str] = []\n    # Split by spaces, then filter out any empty strings that result from multiple spaces.\n    words = [word for word in s.split(' ') if word]\n\n    for word in words:\n        consonant_count = _count_consonants(word)\n        if consonant_count == n:\n            result_words.append(word)\n\n    return result_words"}
{"task_id": "HumanEval/117", "solution": "from typing import List\n_VOWELS = {'a', 'e', 'i', 'o', 'u'}\ndef _is_consonant(char: str) -> bool:\n    \"\"\"Checks if a character is a consonant (case-insensitive).\n    Returns True if alphabetic and not a vowel, False otherwise.\n    \"\"\"\n    lower_char = char.lower()\n    return lower_char.isalpha() and lower_char not in _VOWELS\ndef select_words(s, n):\n    \"\"\"Returns a list of all words from string 's' that contain exactly 'n' consonants, in order of appearance.\n    An empty list is returned if 's' is empty; 's' is assumed to contain only letters and spaces.\n    \"\"\"\n    if not s:\n        return []\n\n    result_words: List[str] = []\n    words = s.split(' ')\n\n    for word in words:\n        consonant_count = 0\n        for char in word:\n            if _is_consonant(char):\n                consonant_count += 1\n        \n        if consonant_count == n:\n            result_words.append(word)\n            \n    return result_words"}
{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"\n    Selects words from a string that contain exactly n consonants.\n    Assumes s contains only letters and spaces, and n is a natural number.\n    \"\"\"\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    def is_vowel(char: str) -> bool:\n        \"\"\"Checks if a character is a vowel (case-insensitive).\"\"\"\n        return char.lower() in VOWELS\n\n    def count_consonants(word: str) -> int:\n        \"\"\"Counts consonants in a word, treating 'y' as a consonant.\"\"\"\n        count = 0\n        for char in word:\n            if char.isalpha() and not is_vowel(char):\n                count += 1\n        return count\n\n    if not s:\n        return []\n\n    words = s.split()\n    result = []\n    for word in words:\n        if count_consonants(word) == n:\n            result.append(word)\n    return result"}
{"task_id": "HumanEval/117", "solution": "VOWELS = {'a', 'e', 'i', 'o', 'u'}\ndef _is_vowel(char: str) -> bool:\n    \"\"\"Checks if a character is a vowel (case-insensitive).\"\"\"\n    return char.lower() in VOWELS\ndef _count_consonants(word: str) -> int:\n    \"\"\"Counts consonants in a word, ignoring non-alphabetic characters.\"\"\"\n    consonant_count = 0\n    for char in word:\n        if char.isalpha() and not _is_vowel(char):\n            consonant_count += 1\n    return consonant_count\ndef select_words(s, n):\n    \"\"\"Given a string s and a natural number n, return a list of words with exactly n consonants.\n    Words are returned in their original order, and an empty list is returned for empty input.\"\"\"\n    if not s:\n        return []\n\n    words = s.split()\n    result = []\n    for word in words:\n        if _count_consonants(word) == n:\n            result.append(word)\n    return result"}
{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"\n    Given a string s and a natural number n, returns a list of all words from string s\n    that contain exactly n consonants, in order these words appear in the string s.\n    If the string s is empty then the function should return an empty list.\n    \"\"\"\n    # Define constants and helper functions locally to encapsulate all logic.\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    def is_vowel(char):\n        \"\"\"Checks if a character is a vowel, case-insensitively.\"\"\"\n        return char.lower() in VOWELS\n\n    def count_consonants(word):\n        \"\"\"Counts consonants in a word, assuming it contains only letters.\"\"\"\n        count = 0\n        for char_val in word:\n            if char_val.isalpha() and not is_vowel(char_val):\n                count += 1\n        return count\n\n    if not s:\n        return []\n\n    result = []\n    # FR1: Split the input string s into individual words using whitespace as a delimiter.\n    words = s.split()\n\n    for word_item in words:\n        # FR2: Count the number of consonants in each word.\n        consonant_count = count_consonants(word_item)\n        # FR3: Filter words that have exactly n consonants and FR4: maintain original order.\n        if consonant_count == n:\n            result.append(word_item)\n            \n    return result"}
{"task_id": "HumanEval/118", "solution": "VOWELS_SET = {'a', 'e', 'i', 'o', 'u'}\ndef _is_vowel(char: str) -> bool:\n    \"\"\"Checks if a character is an English vowel (case-insensitive).\"\"\"\n    return char.lower() in VOWELS_SET\ndef _is_consonant(char: str) -> bool:\n    \"\"\"Checks if a character is an English consonant (case-insensitive).\n    Assumes the character is an alphabet letter.\n    \"\"\"\n    return char.isalpha() and not _is_vowel(char)\ndef get_closest_vowel(word: str) -> str:\n    \"\"\"You are given a word. Your task is to find the closest vowel that stands between \n    two consonants from the right side of the word (case sensitive).\n    \n    Vowels in the beginning and ending doesn't count. Return empty string if you didn't\n    find any vowel met the above condition. \n\n    You may assume that the given string contains English letter only.\n\n    Example:\n    get_closest_vowel(\"yogurt\") ==> \"u\"\n    get_closest_vowel(\"FULL\") ==> \"U\"\n    get_closest_vowel(\"quick\") ==> \"\"\n    get_closest_vowel(\"ab\") ==> \"\"\n    \"\"\"\n    n = len(word)\n    # A CVC pattern requires at least 3 characters.\n    if n < 3:\n        return \"\"\n\n    # Iterate from right to left, excluding the first and last characters (indices 0 and n-1).\n    # The loop range covers indices from n-2 down to 1 (inclusive).\n    for i in range(n - 2, 0, -1):\n        char = word[i]\n        if _is_vowel(char):\n            # Check if the surrounding characters are consonants.\n            if _is_consonant(word[i-1]) and _is_consonant(word[i+1]):\n                return char\n    return \"\""}
{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"Finds the rightmost vowel surrounded by two consonants, excluding word ends.\n    Returns the vowel (case-sensitive) or an empty string if not found.\"\"\"\n\n    VOWELS_SET = {'a', 'e', 'i', 'o', 'u'}\n\n    def is_vowel(char_val):\n        return char_val.lower() in VOWELS_SET\n\n    def is_consonant(char_val):\n        # Assumes English letters only. A consonant is any non-vowel English letter.\n        return not is_vowel(char_val)\n\n    if len(word) < 3:\n        return \"\"\n\n    # Iterate from the second to last character (index len-2) down to the second character (index 1).\n    for i in range(len(word) - 2, 0, -1):\n        current_char = word[i]\n        prev_char = word[i-1]\n        next_char = word[i+1]\n\n        if is_vowel(current_char):\n            if is_consonant(prev_char) and is_consonant(next_char):\n                return current_char\n\n    return \"\""}
{"task_id": "HumanEval/118", "solution": "import string\nVOWELS_SET = {'a', 'e', 'i', 'o', 'u'}\ndef is_vowel(char: str) -> bool:\n    \"\"\"Checks if a given character is an English vowel (case-insensitive).\n    Returns False for non-single-character inputs or non-alphabetic characters.\n    \"\"\"\n    if not isinstance(char, str) or len(char) != 1:\n        return False\n    return char.lower() in VOWELS_SET\ndef is_consonant(char: str) -> bool:\n    \"\"\"Checks if a given character is an English consonant (case-insensitive).\n    Returns False for non-single-character inputs, vowels, or non-alphabetic characters.\n    \"\"\"\n    if not isinstance(char, str) or len(char) != 1:\n        return False\n    char_lower = char.lower()\n    return char_lower in string.ascii_lowercase and char_lower not in VOWELS_SET\ndef get_closest_vowel(word: str) -> str:\n    \"\"\"Finds the rightmost vowel in a word immediately surrounded by two consonants.\n    Vowels at the beginning or end of the word are not considered.\n    \"\"\"\n    if not isinstance(word, str) or len(word) < 3:\n        return \"\"\n\n    # Iterate from the second-to-last character down to the second character.\n    # Indices 0 and len(word)-1 are excluded as per business rules.\n    for i in range(len(word) - 2, 0, -1):\n        current_char = word[i]\n        left_char = word[i-1]\n        right_char = word[i+1]\n\n        if (is_vowel(current_char) and\n            is_consonant(left_char) and\n            is_consonant(right_char)):\n            return current_char\n    \n    return \"\""}
{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"You are given a word. Your task is to find the closest vowel that stands between \n    two consonants from the right side of the word (case sensitive).\n    \n    Vowels in the beginning and ending doesn't count. Return empty string if you didn't\n    find any vowel met the above condition. \n\n    You may assume that the given string contains English letter only.\n\n    Example:\n    get_closest_vowel(\"yogurt\") ==> \"u\"\n    get_closest_vowel(\"FULL\") ==> \"U\"\n    get_closest_vowel(\"quick\") ==> \"\"\n    get_closest_vowel(\"ab\") ==> \"\"\n    \"\"\"\n    _VOWELS = \"aeiouAEIOU\"\n    _ENGLISH_LETTERS = \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\"\n\n    def is_vowel(char):\n        \"\"\"Checks if a given character is an English vowel.\"\"\"\n        return char in _VOWELS\n\n    def is_consonant(char):\n        \"\"\"Checks if a given character is an English consonant.\"\"\"\n        return char in _ENGLISH_LETTERS and char not in _VOWELS\n\n    if len(word) < 3:\n        return \"\"\n\n    # The loop scans from right to left, avoiding word boundaries.\n    # This ensures valid indices and handles the rule about boundary vowels.\n    for i in range(len(word) - 2, 0, -1):\n        current_char = word[i]\n        left_char = word[i-1]\n        right_char = word[i+1]\n\n        if is_vowel(current_char) and \\\n           is_consonant(left_char) and \\\n           is_consonant(right_char):\n            return current_char\n            \n    return \"\""}
{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word: str) -> str:\n    \"\"\"Finds the closest vowel that stands between two consonants from the right side of the word.\n    Vowels in the beginning and ending don't count.\"\"\"\n\n    VOWELS_SET = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n\n    def _is_vowel(char: str) -> bool:\n        \"\"\"Checks if a character is an English vowel.\"\"\"\n        return char in VOWELS_SET\n\n    def _is_consonant(char: str) -> bool:\n        \"\"\"Checks if a character is an English consonant.\"\"\"\n        return char.isalpha() and not _is_vowel(char)\n\n    if len(word) < 3:\n        return \"\"\n\n    # Iterate from the second-to-last character (index len-2) down to the second character (index 1).\n    for i in range(len(word) - 2, 0, -1):\n        char = word[i]\n        left_char = word[i - 1]\n        right_char = word[i + 1]\n\n        if _is_vowel(char):\n            if _is_consonant(left_char) and _is_consonant(right_char):\n                return char\n    return \"\""}
{"task_id": "HumanEval/118", "solution": "def _is_vowel(char: str) -> bool:\n    \"\"\"Checks if a character is an English vowel (case-sensitive).\n    Assumes input is a single English letter.\n    \"\"\"\n    VOWELS = \"aeiouAEIOU\"\n    return char in VOWELS\ndef _is_consonant(char: str) -> bool:\n    \"\"\"Checks if a character is an English consonant (case-sensitive).\n    Assumes input is a single English letter.\n    \"\"\"\n    VOWELS = \"aeiouAEIOU\" # Redefining here to make _is_consonant independent. Could also pass VOWELS as an argument, or define it globally if preferred.\n    return char.isalpha() and char not in VOWELS\ndef get_closest_vowel(word):\n    \"\"\"You are given a word. Your task is to find the closest vowel that stands between \n    two consonants from the right side of the word (case sensitive).\n    \n    Vowels in the beginning and ending doesn't count. Return empty string if you didn't\n    find any vowel met the above condition. \n\n    You may assume that the given string contains English letter only.\n\n    Example:\n    get_closest_vowel(\"yogurt\") ==> \"u\"\n    get_closest_vowel(\"FULL\") ==> \"U\"\n    get_closest_vowel(\"quick\") ==> \"\"\n    get_closest_vowel(\"ab\") ==> \"\"\n    \"\"\"\n    if len(word) < 3:\n        return \"\"\n\n    # Iterate from the second-to-last character down to the second, excluding first and last characters.\n    for i in range(len(word) - 2, 0, -1):\n        current_char = word[i]\n        if _is_vowel(current_char):\n            left_char = word[i-1]\n            right_char = word[i+1]\n            if _is_consonant(left_char) and _is_consonant(right_char):\n                return current_char\n    return \"\""}
{"task_id": "HumanEval/118", "solution": "from typing import Set\nVOWELS_SET: Set[str] = {'a', 'e', 'i', 'o', 'u'}\ndef _is_vowel(char: str) -> bool:\n    \"\"\"Checks if a character is an English vowel (case-insensitive).\"\"\"\n    return char.lower() in VOWELS_SET\ndef _is_consonant(char: str) -> bool:\n    \"\"\"Checks if a character is an English consonant.\"\"\"\n    return char.isalpha() and not _is_vowel(char)\ndef get_closest_vowel(word: str) -> str:\n    \"\"\"Finds the closest vowel from the right, not at the word's ends, and surrounded by consonants.\n    Returns the vowel preserving its case, or an empty string if none is found.\n    \"\"\"\n    if len(word) < 3:\n        return \"\"\n\n    for i in range(len(word) - 2, 0, -1):\n        char = word[i]\n        if _is_vowel(char):\n            left_char = word[i - 1]\n            right_char = word[i + 1]\n            if _is_consonant(left_char) and _is_consonant(right_char):\n                return char\n    return \"\""}
{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"Finds the closest vowel that stands between two consonants from the right side.\n    Vowels at word boundaries do not count; returns an empty string if not found.\"\"\"\n\n    _VOWELS_SET = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n\n    def _is_vowel(char):\n        \"\"\"Checks if the given character is an English vowel.\"\"\"\n        return char in _VOWELS_SET\n\n    def _is_consonant(char):\n        \"\"\"Checks if the given character is an English consonant.\n        It assumes the character is an English letter and not a vowel.\"\"\"\n        return char.isalpha() and not _is_vowel(char)\n\n    n = len(word)\n    if n < 3:\n        return \"\"\n\n    # Iterate from the second-to-last character down to the second character.\n    # This ensures word[i-1] and word[i+1] are always valid indices.\n    for i in range(n - 2, 0, -1):\n        current_char = word[i]\n        left_char = word[i-1]\n        right_char = word[i+1]\n\n        if (_is_vowel(current_char) and\n            _is_consonant(left_char) and\n            _is_consonant(right_char)):\n            return current_char\n    \n    return \"\""}
{"task_id": "HumanEval/118", "solution": "from typing import Set\nVOWELS: Set[str] = {'a', 'e', 'i', 'o', 'u'}\ndef is_vowel(char: str) -> bool:\n    \"\"\"Checks if a given character is an English vowel (case-insensitive).\"\"\"\n    return char.lower() in VOWELS\ndef is_consonant(char: str) -> bool:\n    \"\"\"Checks if a given character is an English consonant (case-insensitive).\"\"\"\n    return char.isalpha() and char.lower() not in VOWELS\ndef get_closest_vowel(word: str) -> str:\n    \"\"\"\n    You are given a word. Your task is to find the closest vowel that stands between \n    two consonants from the right side of the word (case sensitive).\n    \n    Vowels in the beginning and ending doesn't count. Return empty string if you didn't\n    find any vowel met the above condition. \n\n    You may assume that the given string contains English letter only.\n\n    Example:\n    get_closest_vowel(\"yogurt\") ==> \"u\"\n    get_closest_vowel(\"FULL\") ==> \"U\"\n    get_closest_vowel(\"quick\") ==> \"\"\n    get_closest_vowel(\"ab\") ==> \"\"\n    \"\"\"\n    n = len(word)\n    if n < 3:\n        return \"\"\n\n    # Iterate from right to left, excluding the first and last characters.\n    for i in range(n - 2, 0, -1):\n        current_char = word[i]\n        left_char = word[i - 1]\n        right_char = word[i + 1]\n\n        if is_vowel(current_char) and \\\n           is_consonant(left_char) and \\\n           is_consonant(right_char):\n            return current_char\n    \n    return \"\""}
{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    \"\"\"\n    Checks if concatenating two strings of parentheses in any order forms a balanced string.\n    Returns 'Yes' if possible, 'No' otherwise.\n    \"\"\"\n\n    def _is_balanced(s: str) -> bool:\n        \"\"\"\n        Determines if a string of parentheses is balanced.\n        It maintains a balance count, returning False if balance ever drops below zero or is not zero at the end.\n        \"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            else:  # char == ')'\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    s1, s2 = lst[0], lst[1]\n\n    # Check the first concatenation order.\n    if _is_balanced(s1 + s2):\n        return 'Yes'\n\n    # Check the second concatenation order.\n    if _is_balanced(s2 + s1):\n        return 'Yes'\n\n    return 'No'"}
{"task_id": "HumanEval/119", "solution": "from typing import List\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input to the match_parens application.\"\"\"\n    pass\nclass ParenthesesChecker:\n    \"\"\"\n    Core logic for checking if a string of parentheses is balanced.\n    \"\"\"\n    VALID_PARENS_CHARS = {'(', ')'}\n\n    def _validate_string(self, s: str) -> None:\n        \"\"\"Ensures the string contains only valid parentheses characters.\"\"\"\n        if not isinstance(s, str):\n            raise InvalidInputError(\"Input must be a string.\")\n        if not all(char in self.VALID_PARENS_CHARS for char in s):\n            raise InvalidInputError(f\"String '{s}' contains invalid characters. Only '(' and ')' are allowed.\")\n\n    def is_balanced(self, s: str) -> bool:\n        \"\"\"\n        Checks if the given string of parentheses is balanced.\n        This requires equal total counts of parentheses and non-negative balance for all prefixes.\n        \"\"\"\n        self._validate_string(s)\n\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                return False  # Unbalanced prefix\n        return balance == 0\nclass ParenthesesMatcher:\n    \"\"\"\n    Orchestrates the matching logic to determine if two strings can form a balanced\n    parentheses string when concatenated.\n    \"\"\"\n    def __init__(self, checker: ParenthesesChecker):\n        \"\"\"Constructor. Initializes the matcher with a ParenthesesChecker instance.\"\"\"\n        self._checker = checker\n\n    def _validate_input(self, lst: List[str]) -> None:\n        \"\"\"Validates the input list structure and string contents.\"\"\"\n        if not isinstance(lst, list) or len(lst) != 2:\n            raise InvalidInputError(\"Input must be a list containing exactly two strings.\")\n        if not all(isinstance(s, str) for s in lst):\n            raise InvalidInputError(\"All elements in the input list must be strings.\")\n        \n        # Delegate string content validation to the checker\n        for s in lst:\n            self._checker._validate_string(s)\n\n    def match(self, lst: List[str]) -> str:\n        \"\"\"\n        Checks if concatenating the two strings in `lst` in any order results\n        in a balanced parentheses string.\n        \"\"\"\n        self._validate_input(lst)\n\n        s1, s2 = lst[0], lst[1]\n\n        # Check s1 + s2\n        if self._checker.is_balanced(s1 + s2):\n            return 'Yes'\n\n        # Check s2 + s1\n        if self._checker.is_balanced(s2 + s1):\n            return 'Yes'\n\n        return 'No'\ndef match_parens(lst: List[str]) -> str:\n    \"\"\"\n    Public entry point for the match_parens application.\n    Checks if it is possible to concatenate two strings of parentheses in some order\n    to form a balanced string.\n    \"\"\"\n    checker = ParenthesesChecker()\n    matcher = ParenthesesMatcher(checker)\n    return matcher.match(lst)"}
{"task_id": "HumanEval/119", "solution": "from typing import List\nclass ParensValidator:\n    @staticmethod\n    def is_valid_char(char: str) -> bool:\n        \"\"\"Checks if a single character is a valid parenthesis.\"\"\"\n        return char in ('(', ')')\n\n    @staticmethod\n    def is_valid_input_string(s: str) -> bool:\n        \"\"\"Checks if a string consists only of valid parentheses characters.\"\"\"\n        return all(ParensValidator.is_valid_char(char) for char in s)\n\n    @staticmethod\n    def is_balanced(s: str) -> bool:\n        \"\"\"Checks if a string of parentheses is balanced. Balance should never drop below zero, and must be zero at the end.\"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\nclass ParensMatcher:\n    @staticmethod\n    def _validate_input(lst: List[str]) -> None:\n        \"\"\"Validates the input list structure and string contents. Raises ValueError for invalid input.\"\"\"\n        if not isinstance(lst, list) or len(lst) != 2:\n            raise ValueError(\"Input must be a list containing exactly two strings.\")\n        if not all(isinstance(s, str) for s in lst):\n            raise ValueError(\"All elements in the input list must be strings.\")\n        if not all(ParensValidator.is_valid_input_string(s) for s in lst):\n            raise ValueError(\"Input strings must consist only of '(' and ')' characters.\")\n\n    @staticmethod\n    def _can_form_balanced_string(s1: str, s2: str) -> bool:\n        \"\"\"Checks if concatenating s1 and s2 in any order forms a balanced string. It evaluates both s1+s2 and s2+s1.\"\"\"\n        return ParensValidator.is_balanced(s1 + s2) or \\\n               ParensValidator.is_balanced(s2 + s1)\ndef match_parens(lst: List[str]) -> str:\n    \"\"\"\n    Checks if it is possible to concatenate two strings of parentheses in some\n    order such that the resulting string is balanced.\n    \"\"\"\n    ParensMatcher._validate_input(lst)\n    s1, s2 = lst[0], lst[1]\n    \n    if ParensMatcher._can_form_balanced_string(s1, s2):\n        return 'Yes'\n    else:\n        return 'No'"}
{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    \"\"\"\n    Checks if concatenating two strings of parentheses in any order forms a balanced string.\n    Returns 'Yes' if possible, 'No' otherwise.\n    \"\"\"\n    if not isinstance(lst, list) or len(lst) != 2:\n        raise ValueError(\"Input must be a list of exactly two strings.\")\n\n    s1, s2 = lst[0], lst[1]\n\n    def is_balanced(s: str) -> bool:\n        \"\"\"Checks if a given string of parentheses is balanced.\n        A string is balanced if counts of '(' and ')' match, and balance never drops below zero.\n        \"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    if is_balanced(s1 + s2):\n        return 'Yes'\n\n    if is_balanced(s2 + s1):\n        return 'Yes'\n\n    return 'No'"}
{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    '''\n    Checks if two parentheses strings can form a balanced string when concatenated in any order.\n    Returns 'Yes' if a balanced string can be formed, 'No' otherwise.\n    '''\n\n    s1, s2 = lst[0], lst[1]\n\n    def is_balanced(s: str) -> bool:\n        \"\"\"\n        Determines if a string of parentheses is balanced.\n        Requires parentheses count to stay non-negative and end at zero.\n        \"\"\"\n        balance_count = 0\n        for char in s:\n            if char == '(':\n                balance_count += 1\n            elif char == ')':\n                balance_count -= 1\n            if balance_count < 0:\n                return False\n        return balance_count == 0\n\n    if is_balanced(s1 + s2):\n        return 'Yes'\n\n    if is_balanced(s2 + s1):\n        return 'Yes'\n\n    return 'No'"}
