{"task_id": "HumanEval/112", "solution": "def _is_palindrome(s: str) -> bool:\n    \"\"\"\n    Checks if a string is a palindrome.\n    A string is a palindrome if it reads the same backward as forward.\n    \"\"\"\n    return s == s[::-1]\ndef reverse_delete(s: str, c: str) -> tuple[str, bool]:\n    \"\"\"\n    Deletes characters from 's' that are present in 'c', then checks if the result is a palindrome.\n    It returns the modified string and the palindrome check result as a tuple.\n    \"\"\"\n    chars_to_delete = set(c)\n    result_str_list = []\n    for char_s in s:\n        if char_s not in chars_to_delete:\n            result_str_list.append(char_s)\n\n    result_str = \"\".join(result_str_list)\n    is_pal = _is_palindrome(result_str)\n    return (result_str, is_pal)"}
{"task_id": "HumanEval/111", "solution": "from dataclasses import dataclass\nfrom typing import Dict, List\nfrom collections import Counter\nclass InputParser:\n    \"\"\"Utility class for parsing and cleaning input strings.\n    It prepares the raw string into a list of individual letters.\"\"\"\n\n    @staticmethod\n    def parse_letters(input_string: str) -> List[str]:\n        \"\"\"Splits the input string by spaces and filters out empty tokens.\n        This handles multiple spaces and leading/trailing spaces correctly.\"\"\"\n        if not input_string:\n            return []\n        return [letter for letter in input_string.split(' ') if letter]\nclass HistogramService:\n    \"\"\"Service responsible for calculating letter histograms based on frequency.\n    It orchestrates parsing, counting, and filtering to find maximum frequency letters.\"\"\"\n\n    def calculate_histogram(self, input_string: str) -> Dict[str, int]:\n        \"\"\"Calculates the histogram, identifying letters with maximum frequency.\n        It returns a dictionary mapping these letters to their counts.\"\"\"\n        letters = InputParser.parse_letters(input_string)\n        if not letters:\n            return {}\n\n        frequencies = self._count_frequencies(letters)\n        max_freq = self._get_max_frequency(frequencies)\n        \n        return self._filter_by_max_frequency(frequencies, max_freq)\n\n    def _count_frequencies(self, letters: List[str]) -> Dict[str, int]:\n        \"\"\"Counts the occurrences of each letter in a list.\n        It returns a dictionary where keys are letters and values are their counts.\"\"\"\n        return dict(Counter(letters))\n\n    def _get_max_frequency(self, frequencies: Dict[str, int]) -> int:\n        \"\"\"Finds the maximum frequency count from a frequency map.\n        It returns 0 if the input map is empty.\"\"\"\n        if not frequencies:\n            return 0\n        return max(frequencies.values())\n\n    def _filter_by_max_frequency(self, frequencies: Dict[str, int], max_freq: int) -> Dict[str, int]:\n        \"\"\"Filters a frequency map to include only entries with the maximum count.\n        It returns a new dictionary containing only the highest frequency letters.\"\"\"\n        return {\n            letter: count\n            for letter, count in frequencies.items()\n            if count == max_freq\n        }\ndef histogram(test: str) -> Dict[str, int]:\n    \"\"\"Given a string of space separated lowercase letters, return a dictionary\n    of letters with the most repetitions and their counts.\n    If several letters have the same occurrence, return all of them.\"\"\"\n    service = HistogramService()\n    return service.calculate_histogram(test)"}
{"task_id": "HumanEval/112", "solution": "def reverse_delete(s, c):\n    \"\"\"Task\n    We are given two strings s and c, you have to deleted all the characters in s that are equal to any character in c\n    then check if the result string is palindrome.\n    A string is called palindrome if it reads the same backward as forward.\n    \"\"\"\n    # Validate input types for s and c as per FR1 and FR2 error handling.\n    if not isinstance(s, str):\n        raise TypeError(\"Input 's' must be a string.\")\n    if not isinstance(c, str):\n        raise TypeError(\"Input 'c' must be a string.\")\n\n    # Remove all characters from string s that are present in string c (FR1).\n    chars_to_delete = set(c)\n    filtered_s_chars = [char for char in s if char not in chars_to_delete]\n    filtered_s = \"\".join(filtered_s_chars)\n\n    # Determine if the modified string is a palindrome (FR2, BR1).\n    is_palindrome = filtered_s == filtered_s[::-1]\n\n    # Return the modified string and the palindrome check result (FR3).\n    return (filtered_s, is_palindrome)"}
{"task_id": "HumanEval/112", "solution": "def reverse_delete(s, c):\n    \"\"\"\n    Deletes characters from 's' present in 'c' and checks if the result is a palindrome.\n    Returns a tuple of the filtered string and a boolean indicating palindrome status.\n    \"\"\"\n    if not isinstance(s, str) or not isinstance(c, str):\n        raise TypeError(\"Inputs 's' and 'c' must be strings.\")\n\n    chars_to_delete_set = set(c)\n    filtered_s = \"\".join(char for char in s if char not in chars_to_delete_set)\n\n    is_palindrome = (filtered_s == filtered_s[::-1])\n    return (filtered_s, is_palindrome)"}
