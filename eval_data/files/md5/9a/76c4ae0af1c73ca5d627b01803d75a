{"task_id": "HumanEval/101", "solution": "def words_string(s: str) -> list[str]:\n    \"\"\"\n    Splits a string into words using commas or spaces as delimiters.\n    Handles multiple consecutive delimiters and leading/trailing delimiters by\n    ensuring no empty strings are included in the output.\n    \"\"\"\n    # Replace all commas with spaces to normalize delimiters.\n    normalized_s = s.replace(\",\", \" \")\n    # Split by space; str.split() without arguments handles multiple spaces\n    # and leading/trailing spaces by returning only non-empty strings.\n    words = normalized_s.split()\n    return words"}
{"task_id": "HumanEval/101", "solution": "import re\ndef words_string(s):\n    \"\"\"\n    Splits a string of words separated by commas or spaces into a list of words.\n    Handles multiple delimiters and filters out empty strings.\n    \"\"\"\n\n    # Defines the regular expression pattern for splitting words.\n    DELIMITERS = r\"[, ]+\"\n\n    class WordSplitter:\n        \"\"\"\n        A utility class to split a string into words based on a defined delimiter pattern.\n        This inner class encapsulates the core splitting logic.\n        \"\"\"\n        def __init__(self, delimiter_pattern: str):\n            self._delimiter_pattern = delimiter_pattern\n\n        def split_words(self, text: str) -> list[str]:\n            \"\"\"\n            Splits text into non-empty words using the configured regex pattern.\n            Raises TypeError if input is not a string.\n            \"\"\"\n            if not isinstance(text, str):\n                raise TypeError(\"Input 'text' must be a string.\")\n            \n            # Splits by pattern and filters out any empty strings from the result.\n            words = [word for word in re.split(self._delimiter_pattern, text) if word]\n            return words\n\n    # Instantiates the splitter and uses it to process the input string.\n    splitter = WordSplitter(DELIMITERS)\n    return splitter.split_words(s)"}
