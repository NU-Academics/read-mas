{"task_id": "HumanEval/17", "solution": "import re\nfrom typing import List\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\"\n    Parses a music string into a list of beat durations based on predefined symbols.\n    Raises TypeError for non-string input, ValueError for invalid music symbols.\n    \"\"\"\n    if not isinstance(music_string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    # Define beat mapping and regex pattern within the function for self-containment.\n    # Symbols are sorted by length descending to ensure correct regex matching order.\n    beat_map = {'o': 4, 'o|': 2, '.|': 1}\n    sorted_symbols = sorted(beat_map.keys(), key=len, reverse=True)\n    symbol_pattern = \"|\".join(re.escape(s) for s in sorted_symbols)\n    \n    # Remove whitespace from the input string for parsing.\n    cleaned_string = music_string.replace(\" \", \"\")\n\n    if not cleaned_string:\n        return []\n\n    # Find all valid symbols in the string using the compiled regex pattern.\n    found_symbols = re.findall(symbol_pattern, cleaned_string)\n\n    # Reconstruct string from found symbols to check for any unparsed characters.\n    reconstructed_string = \"\".join(found_symbols)\n    if reconstructed_string != cleaned_string:\n        raise ValueError(f\"Music string contains invalid symbols: '{music_string}'\")\n\n    # Map the identified symbols to their corresponding beat durations.\n    beat_durations: List[int] = [beat_map[symbol] for symbol in found_symbols]\n    return beat_durations"}
{"task_id": "HumanEval/17", "solution": "from typing import List, Tuple\nclass MusicParsingError(Exception):\n    \"\"\"Custom exception for errors during music string parsing.\n    It stores a descriptive error message.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass MusicParser:\n    \"\"\"Encapsulates logic for parsing a musical notation string.\n    It identifies known note patterns and accumulates beat durations.\n    \"\"\"\n    def __init__(self):\n        # Patterns ordered from longest to shortest for greedy matching.\n        self._note_patterns: List[Tuple[str, int]] = [\n            ('o|', 2),  # Half note\n            ('o', 4),   # Whole note\n            ('.|', 1)   # Quarter note\n        ]\n\n    def _parse_string_internal(self, music_string: str) -> List[int]:\n        \"\"\"Iterates through the music string, matching patterns and collecting beats.\n        Raises MusicParsingError if an unrecognized sequence is found.\n        \"\"\"\n        beats = []\n        i = 0\n        while i < len(music_string):\n            # Skip any whitespace characters as per problem statement example\n            if music_string[i].isspace():\n                i += 1\n                continue\n\n            matched = False\n            for pattern, beat_value in self._note_patterns:\n                if music_string.startswith(pattern, i):\n                    beats.append(beat_value)\n                    i += len(pattern)\n                    matched = True\n                    break\n            if not matched:\n                raise MusicParsingError(\n                    f\"Invalid music string at index {i}: '{music_string[i:]}'\"\n                )\n        return beats\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\"Parses a musical note string in special ASCII format into a list of beat durations.\n    It converts 'o' (4 beats), 'o|' (2 beats), and '.|' (1 beat) patterns, ignoring whitespace.\n    \"\"\"\n    parser = MusicParser()\n    return parser._parse_string_internal(music_string)"}
{"task_id": "HumanEval/17", "solution": "from typing import List, Dict\nclass InvalidNoteError(Exception):\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nNOTE_BEATS_MAP: Dict[str, int] = {\n    'o': 4,\n    'o|': 2,\n    '.|': 1\n}\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\"Parses a musical notation string into beat durations.\n    Raises InvalidNoteError if an unrecognized note token is found.\"\"\"\n\n    if not music_string.strip():\n        return []\n\n    note_tokens = music_string.split(' ')\n    beat_durations: List[int] = []\n\n    for token in note_tokens:\n        if token in NOTE_BEATS_MAP:\n            beat_durations.append(NOTE_BEATS_MAP[token])\n        else:\n            raise InvalidNoteError(f\"Unrecognized note token: '{token}'\")\n\n    return beat_durations"}
