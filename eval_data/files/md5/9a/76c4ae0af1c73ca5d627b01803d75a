{"task_id": "HumanEval/57", "solution": "def _is_non_decreasing(l: list) -> bool:\n    \"\"\"\n    Checks if a list is non-decreasing.\n    A list is non-decreasing if each element is greater than or equal to the previous one.\n    \"\"\"\n    if len(l) <= 1:\n        return True\n    for i in range(len(l) - 1):\n        if l[i] > l[i+1]:\n            return False\n    return True\ndef _is_non_increasing(l: list) -> bool:\n    \"\"\"\n    Checks if a list is non-increasing.\n    A list is non-increasing if each element is less than or equal to the previous one.\n    \"\"\"\n    if len(l) <= 1:\n        return True\n    for i in range(len(l) - 1):\n        if l[i] < l[i+1]:\n            return False\n    return True\ndef monotonic(l: list) -> bool:\n    \"\"\"Return True if list elements are monotonically increasing or decreasing.\"\"\"\n    if len(l) <= 1:\n        return True\n    return _is_non_decreasing(l) or _is_non_increasing(l)"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True if list elements are monotonically increasing or decreasing.\n    This function efficiently checks for non-decreasing or non-increasing trends.\n    \"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"Input must be a list.\")\n    \n    if len(l) <= 1:\n        return True\n\n    def _is_increasing_internal(current_list: list) -> bool:\n        \"\"\"Checks if the given list is non-decreasing.\n        It iterates through the list, comparing adjacent elements.\n        \"\"\"\n        for i in range(len(current_list) - 1):\n            if current_list[i] > current_list[i+1]:\n                return False\n        return True\n\n    def _is_decreasing_internal(current_list: list) -> bool:\n        \"\"\"Checks if the given list is non-increasing.\n        It iterates through the list, comparing adjacent elements.\n        \"\"\"\n        for i in range(len(current_list) - 1):\n            if current_list[i] < current_list[i+1]:\n                return False\n        return True\n\n    return _is_increasing_internal(l) or _is_decreasing_internal(l)"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True if list elements are monotonically increasing or decreasing.\n    An empty or single-element list is considered monotonic.\n    \"\"\"\n\n    if len(l) <= 1:\n        return True\n\n    def _is_increasing(arr: list) -> bool:\n        \"\"\"Checks if a list is monotonically non-decreasing.\n        Returns False immediately if any element is greater than its successor.\n        \"\"\"\n        for i in range(len(arr) - 1):\n            if arr[i] > arr[i+1]:\n                return False\n        return True\n\n    def _is_decreasing(arr: list) -> bool:\n        \"\"\"Checks if a list is monotonically non-increasing.\n        Returns False immediately if any element is less than its successor.\n        \"\"\"\n        for i in range(len(arr) - 1):\n            if arr[i] < arr[i+1]:\n                return False\n        return True\n    \n    return _is_increasing(l) or _is_decreasing(l)"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True if list elements are monotonically increasing or decreasing.\n    This checks for strictly increasing or strictly decreasing sequences.\n    \"\"\"\n    n = len(l)\n    if n <= 1:\n        return True\n\n    # Check if the list is strictly increasing\n    is_strictly_increasing = True\n    for i in range(n - 1):\n        if l[i] >= l[i+1]:\n            is_strictly_increasing = False\n            break\n    \n    if is_strictly_increasing:\n        return True\n\n    # Check if the list is strictly decreasing\n    is_strictly_decreasing = True\n    for i in range(n - 1):\n        if l[i] <= l[i+1]:\n            is_strictly_decreasing = False\n            break\n            \n    return is_strictly_decreasing"}
{"task_id": "HumanEval/57", "solution": "from typing import List\ndef monotonic(l: List) -> bool:\n    \"\"\"Return True if list elements are monotonically increasing or decreasing.\n    An empty list or a single-element list is considered monotonic.\n    \"\"\"\n    if len(l) <= 1:\n        return True\n\n    def _is_increasing_or_constant(arr: List) -> bool:\n        \"\"\"Checks if the array is non-decreasing.\"\"\"\n        for i in range(len(arr) - 1):\n            if arr[i] > arr[i+1]:\n                return False\n        return True\n\n    def _is_decreasing_or_constant(arr: List) -> bool:\n        \"\"\"Checks if the array is non-increasing.\"\"\"\n        for i in range(len(arr) - 1):\n            if arr[i] < arr[i+1]:\n                return False\n        return True\n\n    return _is_increasing_or_constant(l) or _is_decreasing_or_constant(l)"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    \"\"\"\n    if len(l) <= 1:\n        return True\n\n    # Check if the list is non-decreasing.\n    is_non_decreasing_trend = True\n    for i in range(len(l) - 1):\n        if l[i] > l[i+1]:\n            is_non_decreasing_trend = False\n            break\n    \n    if is_non_decreasing_trend:\n        return True\n\n    # If not non-decreasing, check if it is non-increasing.\n    is_non_increasing_trend = True\n    for i in range(len(l) - 1):\n        if l[i] < l[i+1]:\n            is_non_increasing_trend = False\n            break\n            \n    return is_non_increasing_trend"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list) -> bool:\n    \"\"\"Return True if list elements are monotonically increasing or decreasing.\n    This checks for both non-decreasing and non-increasing trends.\n    \"\"\"\n    if len(l) <= 1:\n        return True\n\n    def _is_increasing(data: list) -> bool:\n        \"\"\"Checks if the list is monotonically non-decreasing.\n        Each element must be greater than or equal to the previous.\n        \"\"\"\n        for i in range(len(data) - 1):\n            if data[i] > data[i+1]:\n                return False\n        return True\n\n    def _is_decreasing(data: list) -> bool:\n        \"\"\"Checks if the list is monotonically non-increasing.\n        Each element must be less than or equal to the previous.\n        \"\"\"\n        for i in range(len(data) - 1):\n            if data[i] < data[i+1]:\n                return False\n        return True\n\n    return _is_increasing(l) or _is_decreasing(l)"}
{"task_id": "HumanEval/58", "solution": "from typing import List, Any\ndef common(l1: List[Any], l2: List[Any]) -> List[Any]:\n    \"\"\"Return sorted unique common elements for two lists.\n    Identifies and returns elements present in both input lists, sorted in ascending order.\n    \"\"\"\n    if not isinstance(l1, list) or not isinstance(l2, list):\n        raise TypeError(\"Both inputs must be lists.\")\n\n    # Convert lists to sets for efficient intersection to find common elements.\n    set_l1 = set(l1)\n    set_l2 = set(l2)\n\n    # Find common elements using set intersection. The result is naturally unique.\n    common_elements_set = set_l1.intersection(set_l2)\n\n    # Convert the set of common elements to a list and sort it.\n    result_list = list(common_elements_set)\n    result_list.sort()\n    \n    return result_list"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\"\"\"\n    if not isinstance(l1, list) or not isinstance(l2, list):\n        raise TypeError(\"Both inputs must be lists.\")\n\n    # Convert to sets for efficient intersection and uniqueness.\n    set_l1 = set(l1)\n    set_l2 = set(l2)\n\n    # Find common elements and convert to list, then sort.\n    common_elements = set_l1.intersection(set_l2)\n    result = list(common_elements)\n    result.sort()\n\n    return result"}
{"task_id": "HumanEval/57", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input to the monotonic function.\"\"\"\n    pass\nclass InputValidator:\n    \"\"\"Provides static methods for validating input lists.\"\"\"\n\n    @staticmethod\n    def _validate_list_type(data) -> None:\n        \"\"\"Checks if the provided data is a list.\n        Raises InvalidInputError if the input is not a list.\n        \"\"\"\n        if not isinstance(data, list):\n            raise InvalidInputError(\"Input must be a list.\")\n\n    @staticmethod\n    def _validate_list_elements(data: list) -> None:\n        \"\"\"Checks if all elements in the list are numbers.\n        Raises InvalidInputError if any element is not an int or float.\n        \"\"\"\n        for item in data:\n            if not isinstance(item, (int, float)):\n                raise InvalidInputError(\"List elements must be numbers (int or float).\")\nclass MonotonicityChecker:\n    \"\"\"Encapsulates the core logic for checking list monotonicity.\"\"\"\n\n    @staticmethod\n    def _is_increasing(data: list) -> bool:\n        \"\"\"Checks if the list is monotonically increasing (non-decreasing).\n        Returns True if the list elements are non-decreasing, False otherwise.\n        \"\"\"\n        for i in range(1, len(data)):\n            if data[i] < data[i-1]:\n                return False\n        return True\n\n    @staticmethod\n    def _is_decreasing(data: list) -> bool:\n        \"\"\"Checks if the list is monotonically decreasing (non-increasing).\n        Returns True if the list elements are non-increasing, False otherwise.\n        \"\"\"\n        for i in range(1, len(data)):\n            if data[i] > data[i-1]:\n                return False\n        return True\n\n    @staticmethod\n    def is_monotonic(data: list) -> bool:\n        \"\"\"\n        Determines if the given list is monotonic (either increasing or decreasing).\n        Empty or single-element lists are considered monotonic.\n        \"\"\"\n        if len(data) <= 1:\n            return True\n\n        return MonotonicityChecker._is_increasing(data) or \\\n               MonotonicityChecker._is_decreasing(data)\ndef monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    \"\"\"\n    InputValidator._validate_list_type(l)\n    InputValidator._validate_list_elements(l)\n\n    return MonotonicityChecker.is_monotonic(l)"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list) -> list:\n    \"\"\"Finds unique, sorted common elements between two lists.\n    It converts lists to sets for efficient intersection, then sorts the resulting common elements.\n    \"\"\"\n    set1 = set(l1)\n    set2 = set(l2)\n\n    common_elements_set = set1.intersection(set2)\n\n    common_elements_list = list(common_elements_set)\n    common_elements_list.sort()\n\n    return common_elements_list"}
