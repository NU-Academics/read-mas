{"task_id": "HumanEval/75", "solution": "import itertools\n_MAX_INPUT_N = 99\n_MIN_INPUT_N = 1\ndef _is_prime(num: int) -> bool:\n    \"\"\"Checks if a number is prime. It handles numbers less than 2 and iterates up to the square root.\"\"\"\n    if num < 2:\n        return False\n    for i in range(2, int(num**0.5) + 1):\n        if num % i == 0:\n            return False\n    return True\ndef _generate_primes_up_to(limit: int) -> list[int]:\n    \"\"\"Generates a list of all prime numbers less than or equal to the given limit.\"\"\"\n    primes = []\n    for num in range(2, limit + 1):\n        if _is_prime(num):\n            primes.append(num)\n    return primes\ndef is_multiply_prime(a):\n    \"\"\"Checks if 'a' is a product of exactly three distinct prime numbers.\n    This function validates input range and type, then uses helper functions to find prime factor combinations.\"\"\"\n    if not isinstance(a, int) or not (_MIN_INPUT_N < a < _MAX_INPUT_N + 1):\n        return False\n\n    candidate_primes = _generate_primes_up_to(a - 1)\n\n    for p1, p2, p3 in itertools.combinations(candidate_primes, 3):\n        if p1 * p2 * p3 == a:\n            return True\n    return False"}
{"task_id": "HumanEval/76", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception raised for invalid input parameters.\"\"\"\n    pass\ndef is_simple_power(x, n):\n    \"\"\"Checks if a number x is a simple power of n (n**k = x for non-negative integer k).\n    Raises InvalidInputError for invalid inputs.\n    \"\"\"\n    if not isinstance(x, int) or not isinstance(n, int):\n        raise InvalidInputError(\"Inputs x and n must be integers.\")\n    if n <= 0:\n        raise InvalidInputError(\"Base n must be greater than 0.\")\n    if x < 1:\n        raise InvalidInputError(\"Number x must be greater than or equal to 1.\")\n\n    if n == 1:\n        return x == 1\n\n    if x == 1:\n        return True\n\n    while x % n == 0 and x > 1:\n        x //= n\n\n    return x == 1"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Checks if a number x is a simple power of n.\n    x is a simple power of n if n**k = x for some non-negative integer k.\n    \"\"\"\n    if not isinstance(x, int) or not isinstance(n, int):\n        raise ValueError(\"Both x and n must be integers.\")\n    if x <= 0 or n <= 0:\n        raise ValueError(\"Both x and n must be positive integers.\")\n\n    if x == 1:\n        return True\n    if n == 1:\n        return False\n\n    while x % n == 0:\n        x //= n\n    \n    return x == 1"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x: int, n: int) -> bool:\n    \"\"\"Checks if x is a simple power of n (n^k = x for non-negative integer k).\n    Raises ValueError for invalid inputs.\"\"\"\n    if not isinstance(x, int) or not isinstance(n, int):\n        raise ValueError(\"Inputs x and n must be integers.\")\n    if x < 0:\n        raise ValueError(\"Input x must be a non-negative integer.\")\n    if n <= 0:\n        raise ValueError(\"Input n must be a positive integer.\")\n\n    if x == 1:\n        return True\n    if n == 1:\n        return False\n    if x == 0:\n        return False\n\n    current_x = x\n    while current_x % n == 0:\n        current_x //= n\n\n    return current_x == 1"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100. \n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n\n    # --- PrimeGenerator Class Definition ---\n    class PrimeGenerator:\n        \"\"\"\n        Generates and provides prime numbers up to a specified limit using Sieve of Eratosthenes.\n        It also checks if a given number is prime.\n        \"\"\"\n        def __init__(self, limit: int):\n            self.limit = limit\n            self._primes = self._sieve_of_eratosthenes(limit)\n\n        def _sieve_of_eratosthenes(self, limit: int) -> list[int]:\n            \"\"\"\n            Implements the Sieve of Eratosthenes to find primes up to limit.\n            Returns a list of prime numbers.\n            \"\"\"\n            if limit <= 1:\n                return []\n            is_prime_arr = [True] * limit\n            is_prime_arr[0] = is_prime_arr[1] = False\n            for p in range(2, int(limit**0.5) + 1):\n                if is_prime_arr[p]:\n                    for multiple in range(p * p, limit, p):\n                        is_prime_arr[multiple] = False\n            return [p for p, is_p in enumerate(is_prime_arr) if is_p]\n\n        def is_prime(self, n: int) -> bool:\n            \"\"\"\n            Checks if a given number n is prime, using pre-computed list if within limit.\n            Returns True if n is prime, False otherwise.\n            \"\"\"\n            if n < 2:\n                return False\n            if n < self.limit:\n                return n in self._primes\n            # Direct check for numbers beyond pre-computed limit, not expected for problem constraints.\n            for p in self._primes:\n                if p * p > n:\n                    break\n                if n % p == 0:\n                    return False\n            return True\n\n        def get_primes(self) -> list[int]:\n            \"\"\"\n            Returns the list of pre-computed prime numbers.\n            \"\"\"\n            return self._primes\n\n    # --- Factorizer Class Definition ---\n    class Factorizer:\n        \"\"\"\n        Decomposes a given integer into its prime factors.\n        It uses a PrimeGenerator to get prime numbers.\n        \"\"\"\n        def __init__(self, prime_generator: PrimeGenerator):\n            self._prime_generator = prime_generator\n\n        def get_prime_factors(self, n: int) -> list[int]:\n            \"\"\"\n            Computes and returns a list of prime factors for n, including multiplicity.\n            \"\"\"\n            # Given the outer function's validation (0 < a < 100), n will always be an int > 1.\n            # Thus, the ValueError below will not be hit by valid inputs to the main function.\n            if not isinstance(n, int) or n <= 1:\n                # For this specific problem context where `a` is guaranteed > 1 by outer checks,\n                # this branch is theoretically unreachable for valid `a`.\n                # Returning an empty list or raising an error are alternatives for general factorizer.\n                # For `is_multiply_prime`, if this happened (e.g., n=1), it implies `False`.\n                return [] \n\n            factors = []\n            temp_n = n\n            primes = self._prime_generator.get_primes()\n\n            for p in primes:\n                if p * p > temp_n: # Optimization: if p*p > remaining number, remaining number must be prime.\n                    break\n                while temp_n % p == 0:\n                    factors.append(p)\n                    temp_n //= p\n            \n            if temp_n > 1: # If temp_n is still > 1, it must be a prime factor itself.\n                factors.append(temp_n)\n                \n            return factors\n\n    # --- MultiplyPrimeChecker Class Definition ---\n    class MultiplyPrimeChecker:\n        \"\"\"\n        Implements core logic to determine if a number is the product of three distinct primes.\n        It relies on a Factorizer instance to get prime factors.\n        \"\"\"\n        def __init__(self, factorizer: Factorizer):\n            self._factorizer = factorizer\n\n        def _is_multiply_prime_internal(self, a_val: int) -> bool:\n            \"\"\"\n            Checks if 'a_val' is the product of exactly three distinct prime numbers.\n            This method assumes 'a_val' has already passed initial validation (type and range).\n            \"\"\"\n            prime_factors = self._factorizer.get_prime_factors(a_val)\n            \n            # Verify if there are exactly 3 distinct prime factors.\n            return len(prime_factors) == 3 and len(set(prime_factors)) == 3\n\n    # --- Main function logic for is_multiply_prime(a) ---\n    if not isinstance(a, int):\n        # As per the problem statement \"returns true if ... and false otherwise\",\n        # non-integer inputs should result in False.\n        return False\n    if not (0 < a < 100): # 'a' must be strictly greater than 0 and strictly less than 100.\n        # Inputs outside the specified range should result in False.\n        return False\n\n    # Instantiate the helper classes for prime generation and factorization.\n    # The limit is 100 because 'a' is less than 100, so the largest possible prime factor is less than 100.\n    prime_gen = PrimeGenerator(limit=100)\n    factorizer = Factorizer(prime_gen)\n    checker = MultiplyPrimeChecker(factorizer)\n\n    # Use the internal checker method to determine if 'a' is a multiply prime.\n    return checker._is_multiply_prime_internal(a)"}
{"task_id": "HumanEval/76", "solution": "import math\nEPSILON = 1e-9\ndef is_simple_power(x: float, n: float) -> bool:\n    \"\"\"Checks if x is a simple power of n (x = n**k for integer k).\n    Returns True if so, False otherwise.\"\"\"\n\n    if abs(n - 1.0) < EPSILON:\n        # If n is 1, x must be 1 (1**k = 1 for any k).\n        return abs(x - 1.0) < EPSILON\n    \n    if abs(n) < EPSILON: # n is 0\n        # 0**k = 0 for k > 0. 0**0 = 1. 0**negative is undefined.\n        return abs(x) < EPSILON or abs(x - 1.0) < EPSILON\n\n    if abs(x - 1.0) < EPSILON:\n        # Any n (except 0) raised to the power of 0 is 1.\n        # We've already handled n=0, so this is True.\n        return True\n    \n    if abs(x) < EPSILON: # x is 0\n        # If x is 0, and n is not 0, then n**k can never be 0.\n        return False\n\n    # Now, x != 0, x != 1, n != 0, n != 1.\n\n    if n > 0:\n        if x < 0:\n            # A positive base raised to any integer power will always result in a positive number.\n            return False\n        \n        # Both x and n are positive. Use logarithm to find k.\n        # k = log_n(x) = log(x) / log(n)\n        try:\n            k = math.log(x) / math.log(n)\n        except ValueError:\n            return False\n        \n        # Check if k is an integer within EPSILON.\n        round_k = round(k)\n        if abs(k - round_k) < EPSILON:\n            # Verify the power to avoid precision issues with log.\n            return abs(n**round_k - x) < EPSILON\n        else:\n            return False\n\n    # If n is negative (n < 0).\n    # n**k can be positive or negative depending on k's parity; abs(n**k) = abs(n)**k.\n    # First, check if abs(x) is a power of abs(n).\n    \n    abs_x = abs(x)\n    abs_n = abs(n)\n\n    # Use the positive base logic for abs_x and abs_n to find k_abs.\n    try:\n        k_abs = math.log(abs_x) / math.log(abs_n)\n    except ValueError:\n        return False\n    \n    round_k_abs = round(k_abs)\n    if abs(k_abs - round_k_abs) < EPSILON:\n        # Verify abs(n)**round_k_abs == abs(x).\n        if not abs(abs_n**round_k_abs - abs_x) < EPSILON:\n            return False\n        \n        # Now check the sign based on the parity of round_k_abs.\n        if round_k_abs % 2 == 0: # Even power, result is positive.\n            return x > 0 # x must be positive.\n        else: # Odd power, result is negative.\n            return x < 0 # x must be negative.\n    else:\n        return False"}
