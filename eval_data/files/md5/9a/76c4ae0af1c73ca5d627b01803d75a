{"task_id": "HumanEval/43", "solution": "from typing import List\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input types or values.\"\"\"\n    pass\nclass PairsSumToZeroService:\n    \"\"\"\n    Service class to check if a list of integers contains two distinct elements that sum to zero.\n    \"\"\"\n    def __init__(self):\n        self._zero_count: int = 0\n        self._seen_numbers: set[int] = set()\n\n    def _validate_input(self, numbers: List) -> None:\n        \"\"\"\n        Validates that the input is a list of integers.\n        Raises InvalidInputError if validation fails.\n        \"\"\"\n        if not isinstance(numbers, list):\n            raise InvalidInputError(\"Input must be a list.\")\n        for i, num in enumerate(numbers):\n            if not isinstance(num, int):\n                raise InvalidInputError(f\"List element at index {i} is not an integer: {num}\")\n\n    def check_for_pair(self, numbers: List[int]) -> bool:\n        \"\"\"\n        Checks if there are two distinct elements in the list that sum to zero.\n        \"\"\"\n        self._validate_input(numbers)\n\n        if len(numbers) < 2:\n            return False\n\n        self._zero_count = 0\n        self._seen_numbers = set()\n\n        for num in numbers:\n            if num == 0:\n                self._zero_count += 1\n                if self._zero_count >= 2:\n                    return True\n            else:\n                complement = -num\n                if complement in self._seen_numbers:\n                    return True\n            self._seen_numbers.add(num)\n        return False\ndef pairs_sum_to_zero(l: List[int]) -> bool:\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    service = PairsSumToZeroService()\n    return service.check_for_pair(l)"}
