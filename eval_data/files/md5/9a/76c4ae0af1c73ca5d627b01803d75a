{"task_id": "HumanEval/91", "solution": "import re\nfrom typing import List\nclass SentenceParser:\n    \"\"\"Utility class for splitting text into sentences.\"\"\"\n    DELIMITERS = r'[.?!]'\n\n    @staticmethod\n    def split(text: str) -> List[str]:\n        \"\"\"Splits text into sentences, stripping whitespace and filtering empty segments.\"\"\"\n        sentences = re.split(SentenceParser.DELIMITERS, text)\n        return [s.strip() for s in sentences if s.strip()]\nclass WordAnalyzer:\n    \"\"\"Utility class for analyzing words within a sentence.\"\"\"\n\n    @staticmethod\n    def starts_with_i(sentence: str) -> bool:\n        \"\"\"Checks if a sentence starts with the exact word \"I\" (case-sensitive).\"\"\"\n        trimmed_sentence = sentence.strip()\n        if not trimmed_sentence:\n            return False\n        \n        # Matches 'I' at the beginning of the string, followed by a word boundary.\n        match = re.match(r'^I\\\\b', trimmed_sentence)\n        return bool(match)\nclass BoredomCounter:\n    \"\"\"Orchestrates the process of counting \"boredom\" sentences.\"\"\"\n\n    def count_boredoms(self, text: str) -> int:\n        \"\"\"Counts sentences that start with the word \"I\" in the given text.\"\"\"\n        sentences: List[str] = SentenceParser.split(text)\n        boredom_count = 0\n        for sentence in sentences:\n            if WordAnalyzer.starts_with_i(sentence):\n                boredom_count += 1\n        return boredom_count\ndef is_bored(S: str) -> int:\n    \"\"\"\n    Counts the number of sentences starting with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    counter = BoredomCounter()\n    return counter.count_boredoms(S)"}
{"task_id": "HumanEval/91", "solution": "import re\nfrom typing import List\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input types or formats.\n    It provides a descriptive error message.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass SentenceParser:\n    \"\"\"Parses text into a list of individual sentences.\n    It uses predefined delimiters to identify sentence boundaries.\"\"\"\n    SENTENCE_DELIMITERS: List[str] = ['.', '?', '!']\n\n    def parse(self, text: str) -> List[str]:\n        \"\"\"Splits the input text into sentences based on delimiters.\n        It reconstructs sentences with their delimiters and strips whitespace.\"\"\"\n        sentences = re.split(r'([.?!])', text)\n        \n        processed_sentences = []\n        current_sentence = \"\"\n        for part in sentences:\n            if part in self.SENTENCE_DELIMITERS:\n                if current_sentence.strip():\n                    processed_sentences.append((current_sentence + part).strip())\n                current_sentence = \"\"\n            else:\n                current_sentence += part\n        \n        if current_sentence.strip():\n            processed_sentences.append(current_sentence.strip())\n\n        return [s for s in processed_sentences if s]\nclass BoredomCounter:\n    \"\"\"Counts sentences that begin with the word 'I'.\n    It utilizes a SentenceParser to break down the input text.\"\"\"\n    def __init__(self, parser: SentenceParser):\n        \"\"\"Initializes the counter with a SentenceParser instance.\"\"\"\n        self.parser = parser\n\n    def count_bored_sentences(self, text: str) -> int:\n        \"\"\"Counts sentences starting with 'I' in the provided text.\n        It uses the injected SentenceParser to obtain sentences.\"\"\"\n        sentences = self.parser.parse(text)\n        bored_count = 0\n        for sentence in sentences:\n            if self._is_bored_sentence(sentence):\n                bored_count += 1\n        return bored_count\n\n    def _is_bored_sentence(self, sentence: str) -> bool:\n        \"\"\"Checks if a sentence qualifies as 'bored'.\n        A sentence is bored if it starts with 'I ' or is exactly 'I'.\"\"\"\n        cleaned_sentence = sentence.strip()\n        return cleaned_sentence.startswith(\"I \") or cleaned_sentence == \"I\"\ndef is_bored(S: str) -> int:\n    \"\"\"Counts sentences starting with the word \"I\" in a given text.\n    Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    if not isinstance(S, str):\n        raise InvalidInputError(\"Input must be a string.\")\n\n    parser = SentenceParser()\n    counter = BoredomCounter(parser)\n    return counter.count_bored_sentences(S)"}
{"task_id": "HumanEval/91", "solution": "import re\nfrom typing import List\nclass SentenceSplitter:\n    SENTENCE_DELIMITERS_PATTERN = r'[.?!]'\n\n    def split_text_into_sentences(self, text: str) -> List[str]:\n        \"\"\"Splits text into potential sentences, filtering empty strings.\n        Raises TypeError if input is not a string.\"\"\"\n        if not isinstance(text, str):\n            raise TypeError(\"Input 'text' must be a string.\")\n        \n        raw_sentences = re.split(self.SENTENCE_DELIMITERS_PATTERN, text)\n        return [s for s in raw_sentences if s.strip()]\nclass BoredomCounter:\n    def __init__(self, splitter: SentenceSplitter):\n        \"\"\"Initializes BoredomCounter with a SentenceSplitter instance.\"\"\"\n        self.splitter = splitter\n\n    def count_boredoms(self, text: str) -> int:\n        \"\"\"Counts sentences starting with 'I' in the given text.\n        Raises TypeError if input is not a string.\"\"\"\n        if not isinstance(text, str):\n            raise TypeError(\"Input 'text' must be a string.\")\n\n        sentences = self.splitter.split_text_into_sentences(text)\n        boredom_count = 0\n\n        for sentence in sentences:\n            cleaned_sentence = sentence.strip()\n            # Check if the sentence starts with \"I \" or is exactly \"I\"\n            if cleaned_sentence.startswith(\"I \") or cleaned_sentence == \"I\":\n                boredom_count += 1\n        return boredom_count\ndef is_bored(S: str) -> int:\n    \"\"\"\n    You'll be given a string of words, and your task is to count the number\n    of boredoms. A boredom is a sentence that starts with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n   \n    For example:\n    >>> is_bored(\"Hello world\")\n    0\n    >>> is_bored(\"The sky is blue. The sun is shining. I love this weather\")\n    1\n    \"\"\"\n    splitter = SentenceSplitter()\n    counter = BoredomCounter(splitter)\n    return counter.count_boredoms(S)"}
{"task_id": "HumanEval/91", "solution": "import re\ndef is_bored(S):\n    \"\"\"\n    Counts sentences starting with \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    if not isinstance(S, str):\n        raise TypeError(\"Input must be a string.\")\n\n    SENTENCE_DELIMITERS = r'[.?!]'\n    BOREDOM_START_WORD = \"I\"\n\n    raw_sentences = re.split(SENTENCE_DELIMITERS, S)\n    # Filter out empty strings and strip whitespace from each sentence.\n    sentences = [s.strip() for s in raw_sentences if s.strip()]\n\n    boredom_count = 0\n    for sentence in sentences:\n        # Check if the trimmed sentence starts with the exact word \"I\" (case-sensitive, followed by a space or end of sentence).\n        if sentence == BOREDOM_START_WORD or sentence.startswith(BOREDOM_START_WORD + ' '):\n            boredom_count += 1\n            \n    return boredom_count"}
{"task_id": "HumanEval/91", "solution": "import re\ndef is_bored(S):\n    \"\"\"\n    You'll be given a string of words, and your task is to count the number\n    of boredoms. A boredom is a sentence that starts with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    if not isinstance(S, str):\n        raise TypeError(\"Input must be a string.\")\n\n    boredom_count = 0\n\n    # Define sentence delimiters and the specific \"boredom\" word.\n    SENTENCE_DELIMITERS = ['.', '?', '!']\n    BOREDOM_WORD = \"I\"\n\n    # Create a regex pattern to split by any of the defined delimiters.\n    delimiter_pattern = ''.join(re.escape(d) for d in SENTENCE_DELIMITERS)\n    \n    # Split the text into potential sentences, then clean and filter out empty strings.\n    sentences = [s.strip() for s in re.split(f'[{delimiter_pattern}]', S) if s.strip()]\n\n    for sentence in sentences:\n        cleaned_sentence = sentence.strip()\n        if not cleaned_sentence:\n            continue\n        \n        # Extract the first word from the sentence.\n        words = cleaned_sentence.split(maxsplit=1)\n        first_word = words[0] if words else None\n\n        # Check if the first word matches the boredom word (case-sensitive).\n        if first_word == BOREDOM_WORD:\n            boredom_count += 1\n    \n    return boredom_count"}
