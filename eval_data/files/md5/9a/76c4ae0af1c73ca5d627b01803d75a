{"task_id": "HumanEval/139", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input values.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass MathUtils:\n    \"\"\"Utility class for common mathematical operations.\"\"\"\n\n    @staticmethod\n    def factorial(k: int) -> int:\n        \"\"\"\n        Calculates the factorial of a non-negative integer k.\n        Assumes k >= 0.\n        \"\"\"\n        if k < 0:\n            raise ValueError(\"Factorial is not defined for negative numbers.\")\n        if k == 0:\n            return 1\n        result = 1\n        for i in range(1, k + 1):\n            result *= i\n        return result\nclass FactorialService:\n    \"\"\"Service for calculating special factorials.\"\"\"\n\n    @staticmethod\n    def calculate_special_factorial(n: int) -> int:\n        \"\"\"\n        Calculates the Brazilian factorial: n! * (n-1)! * ... * 1!\n        \"\"\"\n        if not isinstance(n, int) or n <= 0:\n            raise InvalidInputError(\"Input 'n' must be a positive integer.\")\n\n        special_fact_result = 1\n        for i in range(1, n + 1):\n            current_factorial = MathUtils.factorial(i)\n            special_fact_result *= current_factorial\n        return special_fact_result\ndef special_factorial(n: int) -> int:\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    return FactorialService.calculate_special_factorial(n)"}
