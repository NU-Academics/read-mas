{"task_id": "HumanEval/99", "solution": "import math\ndef closest_integer(value: str) -> int:\n    \"\"\"\n    Rounds a numeric string to the closest integer, rounding away from zero for equidistant values.\n    Raises ValueError if the input string cannot be converted to a valid number.\n    \"\"\"\n    try:\n        float_val = float(value)\n    except ValueError:\n        raise ValueError(f\"Input '{value}' is not a valid number string.\")\n\n    # Apply the round half away from zero logic.\n    # This involves taking the absolute value, adding 0.5, taking the floor,\n    # and then reapplying the original sign.\n    return int(math.copysign(math.floor(math.fabs(float_val) + 0.5), float_val))"}
{"task_id": "HumanEval/99", "solution": "import math\ndef closest_integer(value: str) -> int:\n    \"\"\"\n    Converts a string-represented number to its closest integer.\n    Equidistant numbers (X.5) are rounded away from zero.\n    \"\"\"\n    try:\n        f_val = float(value)\n    except ValueError as e:\n        raise ValueError(f\"Input '{value}' is not a valid number.\") from e\n\n    floor_val = math.floor(f_val)\n    ceil_val = math.ceil(f_val)\n\n    diff_floor = abs(f_val - floor_val)\n    diff_ceil = abs(f_val - ceil_val)\n\n    if diff_floor < diff_ceil:\n        return int(floor_val)\n    elif diff_ceil < diff_floor:\n        return int(ceil_val)\n    else:  # Equidistant, e.g., X.5\n        if f_val >= 0:\n            return int(ceil_val)  # Round up for positive .5 (away from zero)\n        else:\n            return int(floor_val) # Round down for negative .5 (away from zero)"}
{"task_id": "HumanEval/99", "solution": "class InvalidNumberError(ValueError):\n    \"\"\"Custom exception for invalid number format.\n    It indicates that an input string could not be parsed into a valid number.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef _round_away_from_zero(num: float) -> int:\n    \"\"\"Helper function to round a float to the closest integer.\n    It rounds away from zero if equidistant (e.g., X.5).\"\"\"\n    if num >= 0:\n        return int(num + 0.5)\n    else:\n        return int(num - 0.5)\ndef closest_integer(value: str) -> int:\n    \"\"\"Takes a string representing a number and returns the closest integer.\n    Equidistant numbers are rounded away from zero (e.g., 14.5 -> 15, -14.5 -> -15).\"\"\"\n    try:\n        num_float = float(value)\n    except ValueError:\n        raise InvalidNumberError(f\"Invalid number format: '{value}'\")\n\n    return _round_away_from_zero(num_float)"}
{"task_id": "HumanEval/99", "solution": "import math\ndef closest_integer(value: str) -> int:\n    '''\n    Create a function that takes a value (string) representing a number\n    and returns the closest integer to it. If the number is equidistant\n    from two integers, round it away from zero.\n\n    Examples\n    >>> closest_integer(\"10\")\n    10\n    >>> closest_integer(\"15.3\")\n    15\n\n    Note:\n    Rounding away from zero means that if the given number is equidistant\n    from two integers, the one you should return is the one that is the\n    farthest from zero. For example closest_integer(\"14.5\") should\n    return 15 and closest_integer(\"-14.5\") should return -15.\n    '''\n    try:\n        f_value = float(value)\n    except ValueError as e:\n        raise ValueError(f\"Invalid input: '{value}' cannot be converted to a float.\") from e\n\n    floor_val = math.floor(f_value)\n    ceil_val = math.ceil(f_value)\n\n    diff_floor = abs(f_value - floor_val)\n    diff_ceil = abs(f_value - ceil_val)\n\n    if diff_floor < diff_ceil:\n        return int(floor_val)\n    elif diff_ceil < diff_floor:\n        return int(ceil_val)\n    else:  # Equidistant, e.g., X.5\n        if f_value >= 0:\n            return int(ceil_val)  # Round up for positive values.\n        else:\n            return int(floor_val) # Round down for negative values."}
{"task_id": "HumanEval/99", "solution": "import math\ndef closest_integer(value: str) -> int:\n    \"\"\"\n    Converts a string representing a number to the closest integer.\n    If equidistant, it rounds away from zero.\n    \"\"\"\n    try:\n        float_num = float(value)\n    except ValueError:\n        raise ValueError(f\"Invalid input: '{value}' cannot be converted to a number.\")\n\n    floor_num = math.floor(float_num)\n    ceil_num = math.ceil(float_num)\n\n    # Determine which integer is closer to the float number.\n    dist_to_floor = float_num - floor_num\n    dist_to_ceil = ceil_num - float_num\n\n    if dist_to_floor < dist_to_ceil:\n        return int(floor_num)\n    elif dist_to_ceil < dist_to_floor:\n        return int(ceil_num)\n    else:  # Number is equidistant from floor and ceil (e.g., X.5).\n        if float_num >= 0:\n            return int(ceil_num)  # Round up for positive numbers.\n        else:\n            return int(floor_num) # Round down for negative numbers."}
