{"task_id": "HumanEval/104", "solution": "from typing import List\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for signaling invalid input.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass DigitChecker:\n    \"\"\"Utility class to check digits within a number.\"\"\"\n    def has_even_digit(self, number: int) -> bool:\n        \"\"\"Checks if the positive integer contains any even digit (0, 2, 4, 6, 8).\"\"\"\n        for digit_char in str(number):\n            if int(digit_char) % 2 == 0:\n                return True\n        return False\nclass DigitFilterService:\n    \"\"\"Service responsible for filtering and sorting numbers based on digit parity.\"\"\"\n    def __init__(self, digit_checker: DigitChecker = None):\\\n        self._digit_checker = digit_checker if digit_checker is not None else DigitChecker()\n\n    def filter_and_sort_unique_digits(self, numbers: List[int]) -> List[int]:\n        \"\"\"Filters numbers, keeping only those without even digits, then sorts them.\"\"\"\n        result = [number for number in numbers if not self._digit_checker.has_even_digit(number)]\n        result.sort()\n        return result\nclass DigitFilterAPI:\n    \"\"\"Public API for the unique_digits functionality.\"\"\"\n    def __init__(self, service: DigitFilterService = None):\n        self._service = service if service is not None else DigitFilterService()\n\n    def _validate_input(self, x: List[int]) -> None:\n        \"\"\"Internal method to validate the input list.\"\"\"\n        if not isinstance(x, list):\\\n            raise InvalidInputError(\"Input must be a list.\")\n        for item in x:\n            if not isinstance(item, int) or item <= 0:\n                raise InvalidInputError(\"All elements in the list must be positive integers.\")\n\n    def unique_digits(self, x: List[int]) -> List[int]:\n        \"\"\"Filters a list of positive integers, returning a sorted list of numbers that contain no even digits.\"\"\"\n        self._validate_input(x)\n        return self._service.filter_and_sort_unique_digits(x)\ndef unique_digits(x: List[int]) -> List[int]:\n    \"\"\"\n    Given a list of positive integers x, return a sorted list of all \n    elements that hasn't any even digit.\n    \"\"\"\n    api_instance = DigitFilterAPI()\n    return api_instance.unique_digits(x)"}
{"task_id": "HumanEval/104", "solution": "from typing import List\nclass DigitFilter:\n    \"\"\"Utility to check properties of digits within a number.\n    Checks if a number contains any even digit.\n    \"\"\"\n    def has_even_digit(self, number: int) -> bool:\n        \"\"\"Checks if the given number contains any even digit (0, 2, 4, 6, 8).\n        Raises ValueError if the number is not a positive integer (including 0).\n        \"\"\"\n        if not isinstance(number, int) or number < 0:\n            raise ValueError(\"Input 'number' must be a positive integer (including 0).\")\n        if number == 0:\n            return True\n\n        temp_num = number\n        while temp_num > 0:\n            digit = temp_num % 10\n            if digit % 2 == 0:\n                return True\n            temp_num //= 10\n        return False\nclass UniqueDigitsProcessor:\n    \"\"\"Processes a list of numbers to filter out those containing even digits\n    and returns the remaining numbers sorted.\n    \"\"\"\n    def __init__(self, digit_filter: DigitFilter):\n        \"\"\"Initializes the processor with a DigitFilter instance.\n        This enables dependency injection for digit checks.\n        \"\"\"\n        self._digit_filter = digit_filter\n\n    def process(self, numbers: List[int]) -> List[int]:\n        \"\"\"Filters a list of positive integers, keeping only those without\n        any even digits, and returns the result sorted.\n        Raises TypeError or ValueError for invalid input types or values.\n        \"\"\"\n        if not isinstance(numbers, list):\n            raise TypeError(\"Input 'numbers' must be a list.\")\n\n        filtered_numbers = []\n        for num in numbers:\n            if not isinstance(num, int) or num < 0:\n                raise ValueError(\n                    f\"All elements in 'numbers' must be positive integers (including 0). Found: {num}\"\n                )\n            if not self._digit_filter.has_even_digit(num):\n                filtered_numbers.append(num)\n\n        filtered_numbers.sort()\n        return filtered_numbers\ndef unique_digits(x: List[int]) -> List[int]:\n    \"\"\"Given a list of positive integers x, returns a sorted list of all elements\n    that do not have any even digits.\n    The returned list should be sorted in increasing order.\n    \"\"\"\n    digit_filter = DigitFilter()\n    processor = UniqueDigitsProcessor(digit_filter)\n    return processor.process(x)"}
{"task_id": "HumanEval/105", "solution": "from typing import List, Any\nDIGIT_NAMES = {\n    1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n    6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\"\n}\ndef by_length(arr: List[Any]) -> List[str]:\n    \"\"\"\n    Processes an array by filtering integers 1-9, sorting, reversing, and mapping them to English names.\n    Returns an empty array if no valid digits are found.\n    \"\"\"\n    if not arr:\n        return []\n\n    filtered_digits: List[int] = []\n    for item in arr:\n        # Filter to include only integers between 1 and 9.\n        if isinstance(item, int) and 1 <= item <= 9:\n            filtered_digits.append(item)\n\n    if not filtered_digits:\n        return []\n\n    filtered_digits.sort()        # Sort in ascending order.\n    filtered_digits.reverse()     # Reverse to descending order.\n\n    result_names: List[str] = []\n    for digit in filtered_digits:\n        # Map each digit to its English word name.\n        result_names.append(DIGIT_NAMES[digit])\n\n    return result_names"}
{"task_id": "HumanEval/105", "solution": "from typing import List\n_DIGIT_NAMES = {\n    1: \"One\",\n    2: \"Two\",\n    3: \"Three\",\n    4: \"Four\",\n    5: \"Five\",\n    6: \"Six\",\n    7: \"Seven\",\n    8: \"Eight\",\n    9: \"Nine\"\n}\ndef _filter_and_sort_numbers(arr: List[int]) -> List[int]:\n    \"\"\"Filters numbers between 1-9 and sorts them ascending.\"\"\"\n    valid_numbers = [n for n in arr if isinstance(n, int) and 1 <= n <= 9]\n    valid_numbers.sort()\n    return valid_numbers\ndef _map_numbers_to_words(numbers: List[int]) -> List[str]:\n    \"\"\"Maps numbers to their English word representations.\"\"\"\n    return [_DIGIT_NAMES[n] for n in numbers]\ndef by_length(arr: List[int]) -> List[str]:\n    \"\"\"\n    Transforms an array of integers by filtering, sorting, reversing,\n    and mapping valid digits to their English word names.\n    \"\"\"\n    filtered_sorted = _filter_and_sort_numbers(arr)\n    reversed_arr = filtered_sorted[::-1]\n    result = _map_numbers_to_words(reversed_arr)\n    return result"}
{"task_id": "HumanEval/105", "solution": "from typing import Any, List, Optional\nclass NumberConverter:\n    \"\"\"\n    Utility class to convert single digits (1-9) to their English word names.\n    \"\"\"\n    _DIGIT_NAMES: dict[int, str] = {\n        1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n        6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\"\n    }\n\n    def digit_to_word(self, digit: int) -> Optional[str]:\n        \"\"\"\n        Returns the English word for a given digit (1-9).\n        Returns None if the digit is out of range.\n        \"\"\"\n        return self._DIGIT_NAMES.get(digit)\nclass NumberProcessor:\n    \"\"\"\n    Processes an array of integers: filters, sorts, reverses, and maps to words.\n    \"\"\"\n    def __init__(self, converter: NumberConverter):\n        \"\"\"Constructor. Initializes with a NumberConverter instance.\"\"\"\n        self._converter = converter\n\n    def process(self, arr: List[int | Any]) -> List[str]:\n        \"\"\"\n        Main method to process the input array according to the requirements.\n        \"\"\"\n        filtered_numbers = self._filter_and_validate(arr)\n        if not filtered_numbers:\n            return []\n\n        sorted_reversed_numbers = self._sort_and_reverse(filtered_numbers)\n        word_list = self._map_to_words(sorted_reversed_numbers)\n        return word_list\n\n    def _filter_and_validate(self, arr: List[int | Any]) -> List[int]:\n        \"\"\"\n        Filters the input array, keeping only integers between 1 and 9.\n        \"\"\"\n        valid_numbers = []\n        for item in arr:\n            if isinstance(item, int) and 1 <= item <= 9:\n                valid_numbers.append(item)\n        return valid_numbers\n\n    def _sort_and_reverse(self, numbers: List[int]) -> List[int]:\n        \"\"\"\n        Sorts the list of numbers in ascending order and then reverses it.\n        \"\"\"\n        numbers.sort()  # Sorts in ascending order in-place.\n        numbers.reverse() # Reverses in-place.\n        return numbers\n\n    def _map_to_words(self, numbers: List[int]) -> List[str]:\n        \"\"\"\n        Converts each number in the list to its English word representation.\n        \"\"\"\n        word_list = []\n        for number in numbers:\n            word = self._converter.digit_to_word(number)\n            if word:\n                word_list.append(word)\n        return word_list\n_number_converter = NumberConverter()\n_number_processor = NumberProcessor(converter=_number_converter)\ndef by_length(arr: List[int | Any]) -> List[str]:\n    \"\"\"\n    Given an array of integers, sort the integers that are between 1 and 9 inclusive,\n    reverse the resulting array, and then replace each digit by its corresponding name from\n    \"One\", \"Two\", \"Three\", \"Four\", \"Five\", \"Six\", \"Seven\", \"Eight\", \"Nine\".\n\n    For example:\n      arr = [2, 1, 1, 4, 5, 8, 2, 3]\n            -> sort arr -> [1, 1, 2, 2, 3, 4, 5, 8]\n            -> reverse arr -> [8, 5, 4, 3, 2, 2, 1, 1]\n      return [\"Eight\", \"Five\", \"Four\", \"Three\", \"Two\", \"Two\", \"One\", \"One\"]\n\n      If the array is empty, return an empty array:\n      arr = []\n      return []\n\n      If the array has any strange number ignore it:\n      arr = [1, -1 , 55]\n            -> sort arr -> [-1, 1, 55]\n            -> reverse arr -> [55, 1, -1]\n      return = ['One']\n    \"\"\"\n    return _number_processor.process(arr)"}
{"task_id": "HumanEval/105", "solution": "DIGIT_TO_WORD_MAP: dict[int, str] = {\n    1: \"One\",\n    2: \"Two\",\n    3: \"Three\",\n    4: \"Four\",\n    5: \"Five\",\n    6: \"Six\",\n    7: \"Seven\",\n    8: \"Eight\",\n    9: \"Nine\",\n}\ndef _filter_and_sort(arr: list[int]) -> list[int]:\n    \"\"\"\n    Filters numbers between 1 and 9 (inclusive) from the array.\n    Then, it sorts the valid numbers in ascending order.\n    \"\"\"\n    valid_numbers = [num for num in arr if isinstance(num, int) and 1 <= num <= 9]\n    valid_numbers.sort()\n    return valid_numbers\ndef _reverse_array(arr: list[int]) -> list[int]:\n    \"\"\"\n    Reverses the order of elements in the given list.\n    It returns a new list with elements in reverse order.\n    \"\"\"\n    return arr[::-1]\ndef _map_to_names(arr: list[int]) -> list[str]:\n    \"\"\"\n    Maps each integer in the list to its corresponding English word name.\n    It uses the predefined DIGIT_TO_WORD_MAP for the conversion.\n    \"\"\"\n    names = []\n    for num in arr:\n        name = DIGIT_TO_WORD_MAP.get(num)\n        if name:\n            names.append(name)\n    return names\ndef by_length(arr: list[int]) -> list[str]:\n    \"\"\"\n    Given an array of integers, sorts the integers that are between 1 and 9 inclusive,\n    reverses the resulting array, and then replaces each digit by its corresponding name.\n    It handles empty arrays and ignores numbers outside the 1-9 range gracefully.\n    \"\"\"\n    if not arr:\n        return []\n\n    # 1. Filter and sort valid numbers (1-9) in ascending order.\n    filtered_sorted = _filter_and_sort(arr)\n    if not filtered_sorted:\n        return []\n\n    # 2. Reverse the sorted list.\n    reversed_numbers = _reverse_array(filtered_sorted)\n\n    # 3. Map each number to its English word name.\n    result_names = _map_to_names(reversed_numbers)\n\n    return result_names"}
{"task_id": "HumanEval/105", "solution": "class DigitMapper:\n    \"\"\"Provides a lookup for converting single-digit integers (1-9) to their English word representations.\"\"\"\n    DIGIT_NAMES = {\n        1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n        6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\"\n    }\n\n    def __init__(self):\n        \"\"\"Initializes the DigitMapper by setting up the internal digit-to-name mapping.\"\"\"\n        self._digit_names = self.DIGIT_NAMES\n\n    def get_name(self, digit: int) -> str | None:\n        \"\"\"Retrieves the English name for a given digit. Returns None if the digit is not found.\"\"\"\n        return self._digit_names.get(digit)\nclass DigitProcessor:\n    \"\"\"Orchestrates the filtering, sorting, reversing, and mapping of integers in an array.\"\"\"\n    def __init__(self, digit_mapper: DigitMapper):\n        \"\"\"Initializes the DigitProcessor with a DigitMapper instance.\"\"\"\n        self._digit_mapper = digit_mapper\n\n    def process_array(self, arr: list[int]) -> list[str]:\n        \"\"\"Processes the input array through all required steps: filter, sort, reverse, map to names.\"\"\"\n        if not arr:\n            return []\n        \n        filtered_sorted = self._filter_and_sort(arr)\n        reversed_arr = self._reverse_array(filtered_sorted)\n        result_names = self._map_to_names(reversed_arr)\n        \n        return result_names\n\n    def _filter_and_sort(self, arr: list[int]) -> list[int]:\n        \"\"\"Filters the array for integers between 1 and 9 (inclusive) and sorts them ascending.\"\"\"\n        filtered = [x for x in arr if isinstance(x, int) and 1 <= x <= 9]\n        filtered.sort()\n        return filtered\n\n    def _reverse_array(self, arr: list[int]) -> list[int]:\n        \"\"\"Reverses the order of elements in the given list.\"\"\"\n        return arr[::-1]\n\n    def _map_to_names(self, arr: list[int]) -> list[str]:\n        \"\"\"Converts each integer in the list to its corresponding English word using the digit mapper.\"\"\"\n        return [self._digit_mapper.get_name(x) for x in arr if self._digit_mapper.get_name(x) is not None]\ndef by_length(arr: list[int]) -> list[str]:\n    \"\"\"\n    Given an array of integers, sort the integers that are between 1 and 9 inclusive,\n    reverse the resulting array, and then replace each digit by its corresponding name.\n    \"\"\"\n    digit_mapper = DigitMapper()\n    processor = DigitProcessor(digit_mapper)\n    return processor.process_array(arr)"}
{"task_id": "HumanEval/105", "solution": "from typing import List\ndef by_length(arr: List[int]) -> List[str]:\n    \"\"\"\n    Given an array of integers, sort the integers that are between 1 and 9 inclusive,\n    reverse the resulting array, and then replace each digit by its corresponding name.\n    \"\"\"\n    DIGIT_NAMES = {\n        1: \"One\",\n        2: \"Two\",\n        3: \"Three\",\n        4: \"Four\",\n        5: \"Five\",\n        6: \"Six\",\n        7: \"Seven\",\n        8: \"Eight\",\n        9: \"Nine\",\n    }\n\n    # Handle empty input array.\n    if not arr:\n        return []\n\n    # Filter integers between 1 and 9 (inclusive).\n    valid_numbers = [n for n in arr if 1 <= n <= 9]\n\n    # Return empty if no valid numbers remain.\n    if not valid_numbers:\n        return []\n\n    # Sort in ascending order, then reverse to get descending.\n    valid_numbers.sort()\n    valid_numbers.reverse()\n\n    # Map each integer to its English word name.\n    return [DIGIT_NAMES[n] for n in valid_numbers]"}
{"task_id": "HumanEval/105", "solution": "DIGIT_NAMES: dict[int, str] = {\n    1: \"One\",\n    2: \"Two\",\n    3: \"Three\",\n    4: \"Four\",\n    5: \"Five\",\n    6: \"Six\",\n    7: \"Seven\",\n    8: \"Eight\",\n    9: \"Nine\",\n}\nclass LengthProcessorService:\n    \"\"\"\n    Service responsible for processing an array of integers according to specific rules:\n    sorting, reversing, filtering for digits 1-9, and mapping to English names.\n    \"\"\"\n\n    def process(self, arr: list[int]) -> list[str]:\n        \"\"\"\n        Orchestrates the full processing pipeline for the input array.\n        \"\"\"\n        if not arr:\n            return []\n\n        # 1. Sort and reverse the entire array\n        sorted_reversed_arr = self._sort_and_reverse(arr)\n\n        # 2. Filter for digits between 1 and 9\n        filtered_arr = self._filter_digits(sorted_reversed_arr)\n\n        # 3. Map filtered digits to their English names\n        result = self._map_to_names(filtered_arr)\n\n        return result\n\n    def _sort_and_reverse(self, arr: list[int]) -> list[int]:\n        \"\"\"Sorts the array in ascending order then reverses it.\"\"\"\n        temp_arr = sorted(arr)\n        temp_arr.reverse()\n        return temp_arr\n\n    def _filter_digits(self, arr: list[int]) -> list[int]:\n        \"\"\"Filters the array to include only integers between 1 and 9.\"\"\"\n        return [num for num in arr if 1 <= num <= 9]\n\n    def _map_to_names(self, arr: list[int]) -> list[str]:\n        \"\"\"Maps integers to their corresponding English word names.\"\"\"\n        return [DIGIT_NAMES[num] for num in arr]\ndef by_length(arr: list[int]) -> list[str]:\n    \"\"\"\n    Processes an array of integers: sorts, reverses, filters for digits 1-9, then maps to English names.\n    Returns an array of digit names, or an empty array if the input is empty or contains no valid digits.\n    \"\"\"\n    service = LengthProcessorService()\n    return service.process(arr)"}
{"task_id": "HumanEval/105", "solution": "def by_length(arr):\n    \"\"\"\n    Given an array of integers, sort the integers that are between 1 and 9 inclusive,\n    reverse the resulting array, and then replace each digit by its corresponding name from\n    \"One\", \"Two\", \"Three\", \"Four\", \"Five\", \"Six\", \"Seven\", \"Eight\", \"Nine\".\n\n    For example:\n      arr = [2, 1, 1, 4, 5, 8, 2, 3]   \n            -> sort arr -> [1, 1, 2, 2, 3, 4, 5, 8] \n            -> reverse arr -> [8, 5, 4, 3, 2, 2, 1, 1]\n      return [\"Eight\", \"Five\", \"Four\", \"Three\", \"Two\", \"Two\", \"One\", \"One\"]\n    \n      If the array is empty, return an empty array:\n      arr = []\n      return []\n    \n      If the array has any strange number ignore it:\n      arr = [1, -1 , 55] \n            -> sort arr -> [-1, 1, 55]\n            -> reverse arr -> [55, 1, -1]\n      return = ['One']\n    \"\"\"\n    DIGIT_NAMES = {\n        1: \"One\",\n        2: \"Two\",\n        3: \"Three\",\n        4: \"Four\",\n        5: \"Five\",\n        6: \"Six\",\n        7: \"Seven\",\n        8: \"Eight\",\n        9: \"Nine\",\n    }\n\n    if not arr:\n        return []\n\n    filtered_numbers = []\n    for n in arr:\n        if isinstance(n, int) and 1 <= n <= 9:\n            filtered_numbers.append(n)\n\n    if not filtered_numbers:\n        return []\n\n    filtered_numbers.sort()\n    filtered_numbers.reverse()\n\n    result_names = [DIGIT_NAMES[n] for n in filtered_numbers]\n\n    return result_names"}
