{"task_id": "HumanEval/127", "solution": "import math\nfrom typing import Optional, Tuple\ndef intersection(interval1: Tuple[int, int], interval2: Tuple[int, int]) -> str:\n    \"\"\"You are given two intervals,\n    where each interval is a pair of integers. For example, interval = (start, end) = (1, 2).\n    The given intervals are closed which means that the interval (start, end)\n    includes both start and end.\n    For each given interval, it is assumed that its start is less or equal its end.\n    Your task is to determine whether the length of intersection of these two \n    intervals is a prime number.\n    Example, the intersection of the intervals (1, 3), (2, 4) is (2, 3)\n    which its length is 1, which not a prime number.\n    If the length of the intersection is a prime number, return \"YES\",\n    otherwise, return \"NO\".\n    If the two intervals don't intersect, return \"NO\".\n\n\n    [input/output] samples:\n    intersection((1, 2), (2, 3)) ==> \"NO\"\n    intersection((-1, 1), (0, 4)) ==> \"NO\"\n    intersection((-3, -1), (-5, 5)) ==> \"YES\"\n    \"\"\"\n\n    class Interval:\n        \"\"\"Represents a closed integer interval [start, end].\"\"\"\n        def __init__(self, start: int, end: int):\n            if not isinstance(start, int) or not isinstance(end, int):\n                raise TypeError(\"Interval bounds must be integers.\")\n            if start > end:\n                raise ValueError(\"Interval start cannot be greater than end.\")\n            self._start = start\n            self._end = end\n\n        def get_start(self) -> int:\n            return self._start\n\n        def get_end(self) -> int:\n            return self._end\n\n        def __repr__(self) -> str:\n            return f\"Interval({self._start}, {self._end})\"\n\n    class IntervalService:\n        \"\"\"Service for performing operations on intervals.\"\"\"\n        def calculate_intersection(self, i1: Interval, i2: Interval) -> Optional[Interval]:\n            \"\"\"Calculates the intersection of two intervals, returning an Interval or None.\"\"\"\n            start = max(i1.get_start(), i2.get_start())\n            end = min(i1.get_end(), i2.get_end())\n            if start <= end:\n                return Interval(start, end)\n            return None\n\n        def get_length(self, interval: Interval) -> int:\n            \"\"\"Calculates the length of a given interval (end - start + 1).\"\"\"\n            return interval.get_end() - interval.get_start() + 1\n\n    class PrimeService:\n        \"\"\"Service for determining if a number is prime.\"\"\"\n        def is_prime(self, n: int) -> bool:\n            \"\"\"Checks if the given integer n is a prime number using an optimized approach.\"\"\"\n            if n <= 1:\n                return False\n            if n == 2:\n                return True\n            if n % 2 == 0:\n                return False\n            for i in range(3, int(math.sqrt(n)) + 1, 2):\n                if n % i == 0:\n                    return False\n            return True\n\n    # Instantiate Intervals from input tuples.\n    interval_obj1 = Interval(interval1[0], interval1[1])\n    interval_obj2 = Interval(interval2[0], interval2[1])\n\n    # Instantiate services.\n    interval_service = IntervalService()\n    prime_service = PrimeService()\n\n    # Calculate intersection.\n    intersection_interval = interval_service.calculate_intersection(interval_obj1, interval_obj2)\n\n    if intersection_interval is None:\n        return \"NO\"\n\n    # Calculate length of intersection.\n    intersection_length = interval_service.get_length(intersection_interval)\n\n    # Check if length is prime and return result.\n    if prime_service.is_prime(intersection_length):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/128", "solution": "class SignUtils:\n    \"\"\"Utility class for determining the sign of an integer.\"\"\"\n    @staticmethod\n    def get_sign(num: int) -> int:\n        \"\"\"Returns the sign of an integer: 1 for positive, -1 for negative, 0 for zero.\"\"\"\n        if num > 0:\n            return 1\n        elif num < 0:\n            return -1\n        else:\n            return 0\nclass SignProductCalculator:\n    \"\"\"Service class to calculate the sum of magnitudes multiplied by the product of signs.\"\"\"\n    def __init__(self, sign_utils: SignUtils):\n        self._sign_utils = sign_utils\n\n    def calculate_prod_signs(self, arr: list[int]) -> int | None:\n        \"\"\"Calculates the sum of magnitudes multiplied by the product of all signs. Returns None for an empty array.\"\"\"\n        if not arr:\n            return None\n\n        sum_of_magnitudes = 0\n        product_of_signs = 1\n\n        for num in arr:\n            sum_of_magnitudes += abs(num)\n            product_of_signs *= self._sign_utils.get_sign(num)\n\n        return sum_of_magnitudes * product_of_signs\nclass ProdSignsController:\n    \"\"\"Controller class providing the public interface for the prod_signs functionality.\"\"\"\n    def __init__(self, calculator: SignProductCalculator):\n        self._calculator = calculator\n\n    def prod_signs(self, arr: list[int]) -> int | None:\n        \"\"\"Public function to calculate the sum of magnitudes multiplied by the product of all signs.\"\"\"\n        return self._calculator.calculate_prod_signs(arr)\n_sign_utils_instance = SignUtils()\n_calculator_instance = SignProductCalculator(_sign_utils_instance)\n_controller_instance = ProdSignsController(_calculator_instance)\ndef prod_signs(arr: list[int]) -> int | None:\n    \"\"\"\n    You are given an array arr of integers and you need to return\n    sum of magnitudes of integers multiplied by product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    Note: return None for empty arr.\n\n    Example:\n    >>> prod_signs([1, 2, 2, -4]) == -9\n    >>> prod_signs([0, 1]) == 0\n    >>> prod_signs([]) == None\n    \"\"\"\n    return _controller_instance.prod_signs(arr)"}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Calculates the sum of magnitudes of integers multiplied by the product of all signs.\n    Returns None for an empty array.\n    \"\"\"\n    if not arr:\n        return None\n\n    sum_magnitudes = 0\n    product_signs = 1\n\n    # Helper function to determine the sign of a number.\n    def _get_sign(num: int) -> int:\n        if num > 0:\n            return 1\n        elif num < 0:\n            return -1\n        else:\n            return 0\n\n    for num in arr:\n        sum_magnitudes += abs(num)\n        product_signs *= _get_sign(num)\n\n    return sum_magnitudes * product_signs"}
