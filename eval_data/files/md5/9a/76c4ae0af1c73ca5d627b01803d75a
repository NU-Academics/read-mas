{"task_id": "HumanEval/122", "solution": "from typing import List\ndef add_elements(arr: List[int], k: int) -> int:\n    \"\"\"\n    Calculates the sum of elements with at most two digits from the first k elements of arr.\n    Handles input validation according to specified constraints and types.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input 'arr' must be a list.\")\n    if not all(isinstance(x, int) for x in arr):\n        raise TypeError(\"All elements in 'arr' must be integers.\")\n    if not isinstance(k, int):\n        raise TypeError(\"Input 'k' must be an integer.\")\n\n    if not (1 <= len(arr) <= 100):\n        raise ValueError(f\"Length of 'arr' must be between 1 and 100, got {len(arr)}.\")\n    if not (1 <= k <= len(arr)):\n        raise ValueError(f\"Input 'k' must be between 1 and len(arr) ({len(arr)}), got {k}.\")\n\n    total_sum = 0\n    for i in range(k):\n        element = arr[i]\n        if abs(element) < 100:\n            total_sum += element\n    return total_sum"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in its Collatz sequence.\n    For example, get_odd_collatz(5) returns [1, 5].\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    if n == 1:\n        return [1]\n\n    sequence = [n]\n    current = n\n    # Calculate the full Collatz sequence until it reaches 1.\n    while current != 1:\n        if current % 2 == 0:\n            current //= 2\n        else:\n            current = 3 * current + 1\n        sequence.append(current)\n\n    # Filter for odd numbers, ensure uniqueness, and sort the result.\n    odd_numbers = sorted(list(set(num for num in sequence if num % 2 != 0)))\n    return odd_numbers"}
{"task_id": "HumanEval/123", "solution": "from typing import List\nclass CollatzUtils:\n    \"\"\"\n    Utility class for common number checks.\n    \"\"\"\n    @staticmethod\n    def is_odd(n: int) -> bool:\n        \"\"\"Checks if a given integer is odd.\"\"\"\n        return n % 2 != 0\n\n    @staticmethod\n    def is_even(n: int) -> bool:\n        \"\"\"Checks if a given integer is even.\"\"\"\n        return n % 2 == 0\nclass CollatzService:\n    \"\"\"\n    Service responsible for Collatz sequence generation and odd number extraction.\n    \"\"\"\n    def __init__(self, collatz_utils: CollatzUtils = None):\n        \"\"\"Initializes the service, optionally taking a CollatzUtils instance.\"\"\"\n        self._collatz_utils = collatz_utils if collatz_utils else CollatzUtils()\n\n    def get_odd_collatz(self, n: int) -> List[int]:\n        \"\"\"\n        Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n        \"\"\"\n        if not isinstance(n, int) or n <= 0:\n            raise ValueError(\"Input 'n' must be a positive integer.\")\n\n        if n == 1:\n            return [1]\n\n        sequence = self._generate_sequence(n)\n        odd_numbers = sorted(list(set(num for num in sequence if self._collatz_utils.is_odd(num))))\n        return odd_numbers\n\n    def _generate_sequence(self, n: int) -> List[int]:\n        \"\"\"\n        Generates the full Collatz sequence for a given positive integer n.\n        \"\"\"\n        sequence = [n]\n        current_term = n\n        while current_term != 1:\n            current_term = self._calculate_next_term(current_term)\n            sequence.append(current_term)\n        return sequence\n\n    def _calculate_next_term(self, current_term: int) -> int:\n        \"\"\"\n        Calculates the next term in the Collatz sequence.\n        \"\"\"\n        if self._collatz_utils.is_even(current_term):\n            return current_term // 2\n        else:\n            return (3 * current_term) + 1\ndef get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n\n    The Collatz conjecture is a conjecture in mathematics that concerns a sequence defined\n    as follows: start with any positive integer n. Then each term is obtained from the \n    previous term as follows: if the previous term is even, the next term is one half of \n    the previous term. If the previous term is odd, the next term is 3 times the previous\n    term plus 1. The conjecture is that no matter what value of n, the sequence will always reach 1.\n\n    Note: \n        1. Collatz(1) is [1].\n        2. returned list sorted in increasing order.\n\n    For example:\n    get_odd_collatz(5) returns [1, 5] # The collatz sequence for 5 is [5, 16, 8, 4, 2, 1], so the odd numbers are only 1, and 5.\n    \"\"\"\n    collatz_service = CollatzService()\n    return collatz_service.get_odd_collatz(n)"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list of odd numbers in its Collatz sequence.\n    The Collatz sequence starts with n and continues until 1 is reached.\n    \"\"\"\n    # Validate that 'n' is a positive integer as required.\n    # Raise ValueError if 'n' is invalid.\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    # Base case for n=1, its Collatz sequence is just [1].\n    # This also implies [1] is the only odd number.\n    if n == 1:\n        return [1]\n\n    # Compute the full Collatz sequence.\n    # The sequence iteratively applies rules until 1 is reached.\n    current_n = n\n    sequence = [current_n]\n    while current_n != 1:\n        if current_n % 2 == 0:\n            current_n //= 2\n        else:\n            current_n = 3 * current_n + 1\n        sequence.append(current_n)\n\n    # Filter the sequence to find only the odd numbers.\n    # A number is odd if its remainder when divided by 2 is not zero.\n    odd_numbers = [num for num in sequence if num % 2 != 0]\n\n    # Sort the identified odd numbers in increasing order.\n    # This fulfills the final requirement for the returned list.\n    return sorted(odd_numbers)"}
