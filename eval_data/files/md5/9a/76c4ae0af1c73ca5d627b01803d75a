{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums: list[int]) -> int:\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty\n    contiguous sub-array of nums.\n    Example\n    minSubArraySum([2, 3, 4, 1, 2, 4]) == 1\n    minSubArraySum([-1, -2, -3]) == -6\n    \n    Raises ValueError if the input list `nums` is empty.\n    \"\"\"\n    if not nums:\n        raise ValueError(\"Input array cannot be empty.\")\n\n    min_so_far = float('inf')\n    current_min = 0\n\n    for x in nums:\n        current_min += x\n        min_so_far = min(min_so_far, current_min)\n        # Reset current_min if it becomes positive, as it won't help in reducing the sum further.\n        # This is the key difference from max subarray sum where we reset if current_max < 0.\n        # For min, we reset if current_min > 0.\n        if current_min > 0:\n            current_min = 0\n    \n    return int(min_so_far)"}
{"task_id": "HumanEval/113", "solution": "class InvalidDigitStringError(ValueError):\n    \"\"\"Custom exception raised when an input string contains non-digit characters.\"\"\"\n    pass\nOUTPUT_TEMPLATE = \"the number of odd elements {count}n the str{count}ng {count} of the {count}nput.\"\ndef odd_count(lst: list[str]) -> list[str]:\n    \"\"\"\n    Given a list of digit strings, returns a list of formatted reports on odd digit counts.\n    Raises InvalidDigitStringError if any string contains non-digit characters.\n    \"\"\"\n    results = []\n\n    for digit_string in lst:\n        # Validate that the string contains only digits as per FR1.\n        if not isinstance(digit_string, str) or not digit_string.isdigit():\n            raise InvalidDigitStringError(\n                f\"Input '{digit_string}' must be a string containing only digits.\"\n            )\n\n        odd_count_val = 0\n        # Count odd digits in the string.\n        for char_digit in digit_string:\n            num = int(char_digit)\n            if num % 2 != 0:\n                odd_count_val += 1\n\n        # Format the output string using the predefined template.\n        formatted_string = OUTPUT_TEMPLATE.format(count=odd_count_val)\n        results.append(formatted_string)\n\n    return results"}
{"task_id": "HumanEval/114", "solution": "from typing import List\nclass SubarrayError(Exception):\n    \"\"\"Custom exception for errors related to sub-array operations.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\ndef minSubArraySum(nums: List[int]) -> int:\n    \"\"\"\n    Finds the minimum sum of any non-empty sub-array using Kadane's algorithm variation.\n    Raises `SubarrayError` if the input array is empty.\n    \"\"\"\n    if not nums:\n        raise SubarrayError(\"Input array cannot be empty.\")\n\n    min_so_far = float('inf')\n    current_min = 0\n\n    for num in nums:\n        current_min = min(num, current_min + num)\n        min_so_far = min(min_so_far, current_min)\n        \n    return int(min_so_far)"}
{"task_id": "HumanEval/113", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input data.\n    It provides specific error messages for validation failures.\"\"\"\n    pass\nclass InputValidator:\n    \"\"\"Utility class for validating input data.\n    It ensures that strings are valid for processing.\"\"\"\n\n    @staticmethod\n    def validate_digit_string(s: str) -> None:\n        \"\"\"\n        Validates that the given input is a string consisting only of digits.\n        Raises InvalidInputError if validation fails.\n        \"\"\"\n        if not isinstance(s, str):\n            raise InvalidInputError(f\"Expected a string, but got type {type(s).__name__}\")\n        if not s.isdigit():\n            raise InvalidInputError(f\"String '{s}' contains non-digit characters.\")\nclass OddCountService:\n    \"\"\"\n    Service responsible for counting odd digits in strings and formatting output.\n    It orchestrates validation, counting, and string generation.\"\"\"\n    OUTPUT_TEMPLATE = \"the number of odd elements {count}n the str{count}ng {count} of the {count}nput.\"\n\n    def process_strings(self, input_list: list[str]) -> list[str]:\n        \"\"\"\n        Processes a list of digit strings, counts odd digits in each, and formats the output.\n        It validates the input list and individual strings before processing.\n        \"\"\"\n        if not isinstance(input_list, list):\n            raise InvalidInputError(f\"Expected a list, but got type {type(input_list).__name__}\")\n\n        results = []\n        for s in input_list:\n            InputValidator.validate_digit_string(s)\n            odd_count = self._count_odd_digits(s)\n            formatted_string = self._format_output_string(odd_count)\n            results.append(formatted_string)\n        return results\n\n    def _count_odd_digits(self, s: str) -> int:\n        \"\"\"\n        Counts the number of odd digits in a given string.\n        Assumes the string has been validated to contain only digits.\n        \"\"\"\n        count = 0\n        for char_digit in s:\n            if int(char_digit) % 2 != 0:\n                count += 1\n        return count\n\n    def _format_output_string(self, count: int) -> str:\n        \"\"\"\n        Formats the output string using the OUTPUT_TEMPLATE and the given count.\n        Replaces all '{count}' placeholders with the provided integer.\n        \"\"\"\n        return self.OUTPUT_TEMPLATE.format(count=count)\ndef odd_count(lst: list[str]) -> list[str]:\n    \"\"\"Given a list of digit strings, returns a list of formatted output strings.\n    Each output string reports the count of odd digits from its corresponding input string.\n    \"\"\"\n    service = OddCountService()\n    try:\n        return service.process_strings(lst)\n    except InvalidInputError as e:\n        # Re-raise the custom exception for the caller to handle\n        raise e"}
{"task_id": "HumanEval/114", "solution": "from typing import List\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to min sub-array sum functions.\n    It provides a descriptive message about the error.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef minSubArraySum(nums: List[int]) -> int:\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty sub-array.\n    This function uses an adaptation of Kadane's algorithm for O(n) time complexity.\n    \"\"\"\n    if not nums:\n        raise InvalidInputError(\"Input list cannot be empty.\")\n\n    min_so_far = nums[0]\n    current_min = nums[0]\n\n    for i in range(1, len(nums)):\n        num = nums[i]\n        current_min = min(num, current_min + num)\n        min_so_far = min(min_so_far, current_min)\n\n    return min_so_far"}
{"task_id": "HumanEval/114", "solution": "class EmptyInputError(Exception):\n    \"\"\"Custom exception raised when an empty input array is provided.\n    It includes a descriptive error message.\"\"\"\n    def __init__(self, message: str = \"Input array cannot be empty.\"):\n        self.message = message\n        super().__init__(self.message)\nclass MinSubarrayService:\n    \"\"\"Service for calculating the minimum sub-array sum using Kadane's algorithm variant.\n    It efficiently computes the result in O(N) time.\"\"\"\n    def calculate_min_sum(self, nums: list[int]) -> int:\n        \"\"\"Computes the minimum sum of any non-empty sub-array.\n        Raises EmptyInputError if the input list is empty.\"\"\"\n        if not nums:\n            raise EmptyInputError(\"The input array 'nums' cannot be empty.\")\n\n        min_so_far = nums[0]\n        current_min = nums[0]\n\n        for i in range(1, len(nums)):\n            current_min = min(nums[i], current_min + nums[i])\n            min_so_far = min(min_so_far, current_min)\n\n        return min_so_far\nclass MinSubarrayController:\n    \"\"\"Controller providing the public interface for minimum sub-array sum calculation.\n    It orchestrates calls to the MinSubarrayService.\"\"\"\n    def __init__(self, service: MinSubarrayService):\n        self._service = service\n\n    def minSubArraySum(self, nums: list[int]) -> int:\n        \"\"\"Calculates the minimum sum of any non-empty sub-array.\n        Raises EmptyInputError if the input list is empty.\"\"\"\n        try:\n            return self._service.calculate_min_sum(nums)\n        except EmptyInputError as e:\n            # Re-raise the specific error for the client to handle\n            raise e\n_min_subarray_service = MinSubarrayService()\n_min_subarray_controller = MinSubarrayController(service=_min_subarray_service)\ndef minSubArraySum(nums: list[int]) -> int:\n    \"\"\"Public function signature to find the minimum sub-array sum.\n    It delegates the computation to the MinSubarrayController.\"\"\"\n    return _min_subarray_controller.minSubArraySum(nums)"}
{"task_id": "HumanEval/114", "solution": "import math\ndef minSubArraySum(nums: list[int]) -> int:\n    \"\"\"\n    Calculates the minimum sum of any non-empty sub-array using Kadane's algorithm variant.\n    Raises ValueError if the input list is empty.\n    \"\"\"\n    if not nums:\n        raise ValueError(\"Input array 'nums' cannot be empty.\")\n\n    min_so_far = math.inf\n    current_min = 0\n\n    for num in nums:\n        current_min += num\n        min_so_far = min(min_so_far, current_min)\n        if current_min > 0:\n            current_min = 0\n    \n    return min_so_far"}
{"task_id": "HumanEval/114", "solution": "import math\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input data to signal validation failures.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\ndef minSubArraySum(nums):\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty sub-array\n    of nums.\n    Example\n    minSubArraySum([2, 3, 4, 1, 2, 4]) == 1\n    minSubArraySum([-1, -2, -3]) == -6\n    \"\"\"\n    # Input validation based on FR1 and business rules\n    if not isinstance(nums, list):\n        raise InvalidInputError(\"Input must be a list.\")\n    if not nums:\n        raise InvalidInputError(\"Input list cannot be empty.\")\n    for x in nums:\n        if not isinstance(x, int):\n            raise InvalidInputError(\"All elements in the list must be integers.\")\n\n    # Kadane's algorithm variant for minimum sub-array sum (FR2, NFR1)\n    min_ending_here = 0  # Tracks the minimum sum of a sub-array ending at the current position.\n    min_so_far = math.inf # Stores the overall minimum sub-array sum found so far.\n\n    for x in nums:\n        min_ending_here = min(x, min_ending_here + x)\n        min_so_far = min(min_so_far, min_ending_here)\n\n    return int(min_so_far) # FR3: Return the calculated minimum sum."}
