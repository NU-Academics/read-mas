{"task_id": "HumanEval/81", "solution": "from typing import List, Tuple\nclass InvalidGPAError(ValueError):\n    \"\"\"Custom exception for GPA values outside the valid range [0.0, 4.0].\"\"\"\n    def __init__(self, message: str, gpa: float):\n        super().__init__(message)\n        self.gpa = gpa\nGRADING_THRESHOLDS: List[Tuple[float, str]] = [\n    (3.7, \"A\"),\n    (3.3, \"A-\"),\n    (3.0, \"B+\"),\n    (2.7, \"B\"),\n    (2.3, \"B-\"),\n    (2.0, \"C+\"),\n    (1.7, \"C\"),\n    (1.3, \"C-\"),\n    (1.0, \"D+\"),\n    (0.7, \"D\"),\n    (0.0, \"D-\"),\n]\nclass GradeConverter:\n    \"\"\"\n    Service class for converting a single numerical GPA to a letter grade.\n    It uses the predefined GRADING_THRESHOLDS to determine the grade.\n    \"\"\"\n    def __init__(self):\n        self._grading_thresholds = GRADING_THRESHOLDS\n\n    def convert_gpa_to_letter(self, gpa: float) -> str:\n        \"\"\"\n        Converts a single GPA to its letter grade.\n        Raises InvalidGPAError if the GPA is outside the valid range [0.0, 4.0].\n        \"\"\"\n        if not (0.0 <= gpa <= 4.0):\n            raise InvalidGPAError(f\"GPA {gpa} is out of valid range [0.0, 4.0].\", gpa)\n\n        if gpa == 4.0:\n            return \"A+\"\n        elif gpa == 0.0:\n            return \"E\"\n        else:\n            for threshold, grade in self._grading_thresholds:\n                if gpa > threshold:\n                    return grade\n            # This line should not be reached for valid GPAs in (0.0, 4.0].\nclass GradeController:\n    \"\"\"\n    Controller class to manage the conversion of a list of GPAs.\n    It delegates individual GPA conversions to GradeConverter.\n    \"\"\"\n    def __init__(self):\n        self._converter = GradeConverter()\n\n    def numerical_letter_grade(self, grades: List[float]) -> List[str]:\n        \"\"\"\n        Converts a list of numerical GPAs to a list of letter grades.\n        Propagates InvalidGPAError if any GPA is outside the valid range.\n        \"\"\"\n        letter_grades: List[str] = []\n        for gpa in grades:\n            letter_grades.append(self._converter.convert_gpa_to_letter(gpa))\n        return letter_grades\ndef numerical_letter_grade(grades: List[float]) -> List[str]:\n    \"\"\"\n    Converts a list of numerical GPAs to a list of letter grades based on a predefined scale.\n    It raises InvalidGPAError if any input GPA is outside the valid range [0.0, 4.0].\n    \"\"\"\n    controller = GradeController()\n    return controller.numerical_letter_grade(grades)"}
{"task_id": "HumanEval/81", "solution": "from dataclasses import dataclass\nGRADE_SCALE_RANGES: list[tuple[float, str]] = [\n    (3.7, \"A\"),\n    (3.3, \"A-\"),\n    (3.0, \"B+\"),\n    (2.7, \"B\"),\n    (2.3, \"B-\"),\n    (2.0, \"C+\"),\n    (1.7, \"C\"),\n    (1.3, \"C-\"),\n    (1.0, \"D+\"),\n    (0.7, \"D\"),\n    (0.0, \"D-\"),\n]\nclass GradeScale:\n    \"\"\"Manages the entire grading scale, including special cases and range-based lookups.\n    It provides the core logic for converting a single GPA to a letter grade.\"\"\"\n    _entries: list[GradeScaleEntry]\n    _exact_4_0_grade: str = \"A+\"\n    _exact_0_0_grade: str = \"E\"\n\n    def __init__(self, scale_data: list[tuple[float, str]]):\n        # Sort entries by lower_bound_exclusive in descending order for efficient lookup.\n        self._entries = sorted(\n            [GradeScaleEntry(lb, grade) for lb, grade in scale_data],\n            key=lambda entry: entry.lower_bound_exclusive,\n            reverse=True\n        )\n\n    def get_letter_grade(self, gpa: float) -> str:\n        \"\"\"Converts a single numerical GPA into its corresponding letter grade.\n        Handles special cases for 4.0 and 0.0, and raises ValueError for negative input.\"\"\"\n        if gpa < 0.0:\n            raise ValueError(f\"Invalid GPA: {gpa}. GPA must be non-negative.\")\n        if gpa == 4.0:\n            return self._exact_4_0_grade\n        if gpa == 0.0:\n            return self._exact_0_0_grade\n\n        for entry in self._entries:\n            if gpa > entry.lower_bound_exclusive:\n                return entry.letter_grade\n        \n        # This part should not be reached with a comprehensive scale and valid non-negative GPAs.\n        raise ValueError(f\"GPA {gpa} did not match any grade in the scale.\")\nclass GradeConversionService:\n    \"\"\"Provides the business logic for converting one or more GPAs.\n    It orchestrates the conversion using an injected GradeScale instance.\"\"\"\n    _grade_scale: GradeScale\n\n    def __init__(self, grade_scale: GradeScale):\n        self._grade_scale = grade_scale\n\n    def convert_gpa_to_letter(self, gpa: float) -> str:\n        \"\"\"Delegates the conversion of a single GPA to the GradeScale.\"\"\"\n        return self._grade_scale.get_letter_grade(gpa)\n\n    def convert_gpas_to_letters(self, gpas: list[float]) -> list[str]:\n        \"\"\"Converts a list of numerical GPAs to a list of letter grades.\n        Any invalid GPA in the list will raise a ValueError.\"\"\"\n        return [self.convert_gpa_to_letter(gpa) for gpa in gpas]\ndef numerical_letter_grade(grades: list[float]) -> list[str]:\n    \"\"\"Converts a list of numerical GPAs to a list of letter grades.\n    It uses a predefined grading scale to perform the conversion.\"\"\"\n    grade_scale = GradeScale(GRADE_SCALE_RANGES)\n    conversion_service = GradeConversionService(grade_scale)\n    return conversion_service.convert_gpas_to_letters(grades)"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"Converts a list of numerical GPAs to letter grades.\n    Handles non-numeric values and out-of-scale GPAs with \"N/A\".\n    \"\"\"\n    GRADING_RULES = [\n        (4.0, \"A+\", \"EQ\"),\n        (3.7, \"A\", \"GT\"),\n        (3.3, \"A-\", \"GT\"),\n        (3.0, \"B+\", \"GT\"),\n        (2.7, \"B\", \"GT\"),\n        (2.3, \"B-\", \"GT\"),\n        (2.0, \"C+\", \"GT\"),\n        (1.7, \"C\", \"GT\"),\n        (1.3, \"C-\", \"GT\"),\n        (1.0, \"D+\", \"GT\"),\n        (0.7, \"D\", \"GT\"),\n        (0.0, \"D-\", \"GT\"),\n        (0.0, \"E\", \"EQ\"),\n    ]\n\n    def _convert_single_gpa(gpa_value):\n        try:\n            gpa_float = float(gpa_value)\n        except (ValueError, TypeError):\n            return \"N/A\"\n\n        for threshold, letter_grade, comp_type in GRADING_RULES:\n            if comp_type == \"EQ\" and gpa_float == threshold:\n                return letter_grade\n            elif comp_type == \"GT\" and gpa_float > threshold:\n                return letter_grade\n        return \"N/A\"\n\n    return [_convert_single_gpa(gpa) for gpa in grades]"}
{"task_id": "HumanEval/81", "solution": "from typing import List, Tuple, Callable\nGradingRule = Tuple[Callable[[float], bool], str]\nGRADING_RULES: List[GradingRule] = [\n    (lambda gpa: gpa == 4.0, \"A+\"),\n    (lambda gpa: gpa > 3.7, \"A\"),\n    (lambda gpa: gpa > 3.3, \"A-\"),\n    (lambda gpa: gpa > 3.0, \"B+\"),\n    (lambda gpa: gpa > 2.7, \"B\"),\n    (lambda gpa: gpa > 2.3, \"B-\"),\n    (lambda gpa: gpa > 2.0, \"C+\"),\n    (lambda gpa: gpa > 1.7, \"C\"),\n    (lambda gpa: gpa > 1.3, \"C-\"),\n    (lambda gpa: gpa > 1.0, \"D+\"),\n    (lambda gpa: gpa > 0.7, \"D\"),\n    (lambda gpa: gpa > 0.0, \"D-\"),\n    (lambda gpa: gpa == 0.0, \"E\"),\n]\nclass GradeConverter:\n    \"\"\"\n    Service for converting numerical GPAs to letter grades.\n    It uses a predefined scale to perform the conversion.\n    \"\"\"\n    def __init__(self, grading_rules: List[GradingRule]) -> None:\n        self._grading_rules = grading_rules\n\n    def convert_gpa_to_letter_grade(self, gpa: float) -> str:\n        \"\"\"\n        Converts a single numerical GPA to its corresponding letter grade.\n        Raises ValueError for negative GPAs and returns \"N/A\" if no match.\n        \"\"\"\n        if gpa < 0.0:\n            raise ValueError(\"GPA cannot be negative.\")\n\n        for condition, letter_grade in self._grading_rules:\n            if condition(gpa):\n                return letter_grade\n        \n        return \"N/A\"\n\n    def convert_gpas_to_letter_grades(self, gpas: List[float]) -> List[str]:\n        \"\"\"\n        Converts a list of numerical GPAs to a list of letter grades.\n        Each GPA is converted individually using the single GPA method.\n        \"\"\"\n        return [self.convert_gpa_to_letter_grade(gpa) for gpa in gpas]\ndef numerical_letter_grade(grades: List[float]) -> List[str]:\n    \"\"\"\n    It is the last week of the semester and the teacher has to give the grades\n    to students. The teacher has been making her own algorithm for grading.\n    The only problem is, she has lost the code she used for grading.\n    She has given you a list of GPAs for some students and you have to write \n    a function that can output a list of letter grades using the following table:\n             GPA       |    Letter grade\n              4.0                A+\n            > 3.7                A \n            > 3.3                A- \n            > 3.0                B+\n            > 2.7                B \n            > 2.3                B-\n            > 2.0                C+\n            > 1.7                C\n            > 1.3                C-\n            > 1.0                D+ \n            > 0.7                D \n            > 0.0                D-\n              0.0                E\n    \n\n    Example:\n    grade_equation([4.0, 3, 1.7, 2, 3.5]) ==> ['A+', 'B', 'C-', 'C', 'A-']\n    \"\"\"\n    converter = GradeConverter(GRADING_RULES)\n    return converter.convert_gpas_to_letter_grades(grades)"}
