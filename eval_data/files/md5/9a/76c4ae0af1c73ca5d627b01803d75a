{"task_id": "HumanEval/119", "solution": "def _is_balanced(s: str) -> bool:\n    \"\"\"\n    Checks if a string of parentheses is balanced.\n    A string is balanced if its running balance never drops below zero and the final balance is zero.\n    \"\"\"\n    balance = 0\n    for char in s:\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n        if balance < 0:\n            return False\n    return balance == 0\ndef match_parens(lst: list[str]) -> str:\n    \"\"\"\n    Determines if two given strings of parentheses can be concatenated in any order to form a balanced string.\n    Checks both s1+s2 and s2+s1 using a helper function.\n    \"\"\"\n    s1, s2 = lst[0], lst[1]\n\n    if _is_balanced(s1 + s2):\n        return 'Yes'\n    \n    if _is_balanced(s2 + s1):\n        return 'Yes'\n    \n    return 'No'"}
{"task_id": "HumanEval/119", "solution": "def match_parens(lst: list[str]) -> str:\n    \"\"\"\n    Checks if concatenating two strings of parentheses in any order\n    results in a balanced string.\n    \"\"\"\n    def _is_balanced(s: str) -> bool:\n        \"\"\"\n        Determines if a given string 's' of parentheses is balanced.\n        It counts open and close parentheses, ensuring balance never drops below zero.\n        \"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    s1, s2 = lst[0], lst[1]\n\n    # Check s1 + s2\n    if _is_balanced(s1 + s2):\n        return 'Yes'\n\n    # Check s2 + s1\n    if _is_balanced(s2 + s1):\n        return 'Yes'\n\n    return 'No'"}
{"task_id": "HumanEval/119", "solution": "def _is_balanced(s):\n    \"\"\"\n    Checks if a string of parentheses is balanced. It uses a balance counter, incrementing for '(' and decrementing for ')', ensuring the counter never drops below zero and ends at zero.\n    \"\"\"\n    balance = 0\n    for char in s:\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n        if balance < 0:\n            return False  # Too many closing parentheses\n    return balance == 0  # All opened parentheses must be closed\ndef match_parens(lst):\n    \"\"\"\n    Checks if two given strings can form a balanced parentheses string when concatenated in any order. The function returns 'Yes' if a balanced string can be formed, otherwise 'No'.\n    \"\"\"\n    s1, s2 = lst[0], lst[1]\n\n    # Check first concatenation order: s1 + s2\n    if _is_balanced(s1 + s2):\n        return 'Yes'\n\n    # Check second concatenation order: s2 + s1\n    if _is_balanced(s2 + s1):\n        return 'Yes'\n\n    return 'No'"}
{"task_id": "HumanEval/120", "solution": "import heapq\nfrom typing import List\ndef maximum(arr: List[int], k: int) -> List[int]:\n    \"\"\"\n    Finds the k largest numbers from a list of integers and returns them sorted.\n    This utility function identifies the top k values and sorts them in ascending order.\n    \"\"\"\n    if k == 0:\n        return []\n\n    # Use heapq.nlargest to efficiently get the k largest elements.\n    largest_elements = heapq.nlargest(k, arr)\n\n    # Sort the result in ascending order as required.\n    return sorted(largest_elements)"}
{"task_id": "HumanEval/119", "solution": "def is_balanced(s: str) -> bool:\n    \"\"\"\n    Checks if the given string of parentheses is balanced.\n    It verifies that '(' and ')' counts match and balance never drops below zero.\n    \"\"\"\n    balance = 0\n    for char in s:\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n        if balance < 0:\n            return False\n    return balance == 0\ndef match_parens(lst: list[str]) -> str:\n    \"\"\"\n    Determines if two parentheses strings can form a balanced string by concatenation.\n    It checks both possible concatenation orders for balance.\n    \"\"\"\n    s1 = lst[0] + lst[1]\n    s2 = lst[1] + lst[0]\n\n    if is_balanced(s1) or is_balanced(s2):\n        return 'Yes'\n    else:\n        return 'No'"}
{"task_id": "HumanEval/120", "solution": "import heapq\nfrom typing import List\ndef maximum(arr: List[int], k: int) -> List[int]:\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list\n    of length k with the maximum k numbers in arr.\n\n    Example 1:\n\n        Input: arr = [-3, -4, 5], k = 3\n        Output: [-4, -3, 5]\n\n    Example 2:\n\n        Input: arr = [4, -4, 4], k = 2\n        Output: [4, 4]\n\n    Example 3:\n\n        Input: arr = [-3, 2, 1, 2, -1, -2, 1], k = 1\n        Output: [2]\n\n    Note:\n        1. The length of the array will be in the range of [1, 1000].\n        2. The elements in the array will be in the range of [-1000, 1000].\n        3. 0 <= k <= len(arr)\n    \"\"\"\n    if k == 0:\n        return []\n\n    # heapq.nlargest returns elements in descending order.\n    # The requirement is for ascending order.\n    k_largest_unsorted = heapq.nlargest(k, arr)\n    k_largest_unsorted.sort()\n\n    return k_largest_unsorted"}
