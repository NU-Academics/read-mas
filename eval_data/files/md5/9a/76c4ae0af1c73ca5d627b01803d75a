{"task_id": "HumanEval/19", "solution": "from typing import List, Dict\nclass InvalidNumberWordError(Exception):\n    \"\"\"Custom exception indicating an unsupported or invalid number word.\n    It carries the `word` that caused the error for context.\"\"\"\n    def __init__(self, word: str, message: str = \"Invalid number word encountered.\"):\n        super().__init__(message)\n        self.word = word\nNUMBER_WORD_MAP_WORD_TO_INT: Dict[str, int] = {\n    \"zero\": 0, \"one\": 1, \"two\": 2, \"three\": 3, \"four\": 4,\n    \"five\": 5, \"six\": 6, \"seven\": 7, \"eight\": 8, \"nine\": 9\n}\nNUMBER_WORD_MAP_INT_TO_WORD: Dict[int, str] = {\n    0: \"zero\", 1: \"one\", 2: \"two\", 3: \"three\", 4: \"four\",\n    5: \"five\", 6: \"six\", 7: \"seven\", 8: \"eight\", 9: \"nine\"\n}\ndef sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Valid choices are 'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight' and 'nine'.\n    Return the string with numbers sorted from smallest to largest\n    >>> sort_numbers('three one five')\n    'one three five'\n    \"\"\"\n\n    if not numbers.strip():\n        return \"\"\n\n    words_list: List[str] = numbers.lower().split()\n    numeric_values: List[int] = []\n\n    # Convert words to integers, raising InvalidNumberWordError for unknown words.\n    for word in words_list:\n        integer_value = NUMBER_WORD_MAP_WORD_TO_INT.get(word)\n        if integer_value is None:\n            raise InvalidNumberWordError(word)\n        numeric_values.append(integer_value)\n\n    # Sort the collected integer values in ascending order.\n    numeric_values.sort()\n\n    # Convert sorted integers back to their corresponding number words.\n    sorted_word_list: List[str] = []\n    for num in numeric_values:\n        word_value = NUMBER_WORD_MAP_INT_TO_WORD.get(num)\n        if word_value is None:\n            # This case should ideally not be reached if numbers were originally valid words\n            raise ValueError(f\"Integer {num} not found in word map for conversion.\")\n        sorted_word_list.append(word_value)\n\n    return \" \".join(sorted_word_list)"}
