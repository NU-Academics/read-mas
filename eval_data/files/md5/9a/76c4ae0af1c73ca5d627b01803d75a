{"task_id": "HumanEval/25", "solution": "from typing import List\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input to the factorization service.\n    It inherits from ValueError to provide a standard base exception.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef factorize(n: int) -> List[int]:\n    \"\"\"Return a list of prime factors for a positive integer n.\n    Factors are ordered from smallest to largest, including correct multiplicities.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise InvalidInputError(\"Input must be a positive integer.\")\n    if n == 1:\n        return []\n\n    factors: List[int] = []\n    temp_n = n\n\n    # Handle factor 2\n    while temp_n % 2 == 0:\n        factors.append(2)\n        temp_n //= 2\n\n    # Handle odd factors starting from 3\n    d = 3\n    while d * d <= temp_n:\n        while temp_n % d == 0:\n            factors.append(d)\n            temp_n //= d\n        d += 2\n\n    # If temp_n is still greater than 1, it must be a prime factor itself\n    if temp_n > 1:\n        factors.append(temp_n)\n\n    return factors"}
{"task_id": "HumanEval/25", "solution": "from typing import List\ndef factorize(n: int) -> List[int]:\n    \"\"\"Return a list of prime factors of the given integer n, ordered from smallest to largest.\n    Each factor appears the number of times corresponding to its multiplicity.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input must be an integer.\")\n    if n < 1:\n        raise ValueError(\"Input must be a positive integer (n >= 1).\")\n    if n == 1:\n        return []\n\n    factors: List[int] = []\n    d = 2\n    temp_n = n\n\n    while d * d <= temp_n:\n        while temp_n % d == 0:\n            factors.append(d)\n            temp_n //= d\n        d += 1\n\n    if temp_n > 1:\n        factors.append(temp_n)\n\n    return factors"}
