{"task_id": "HumanEval/79", "solution": "def decimal_to_binary(decimal):\n    \"\"\"Converts a decimal number to its binary string representation, formatted with 'db' prefix and suffix.\n    Raises ValueError if the input is not a non-negative integer.\"\"\"\n\n    # Validate input as a non-negative integer.\n    if not isinstance(decimal, int):\n        raise ValueError(\"Input must be an integer.\")\n    if decimal < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n\n    # Convert the non-negative integer to its raw binary string.\n    if decimal == 0:\n        binary_str = \"0\"\n    else:\n        binary_parts = []\n        temp_num = decimal\n        while temp_num > 0:\n            binary_parts.append(str(temp_num % 2))\n            temp_num //= 2\n        binary_str = \"\".join(reversed(binary_parts))\n\n    # Apply the specified prefix and suffix.\n    BINARY_PREFIX = \"db\"\n    BINARY_SUFFIX = \"db\"\n    return f\"{BINARY_PREFIX}{binary_str}{BINARY_SUFFIX}\""}
{"task_id": "HumanEval/79", "solution": "def decimal_to_binary(decimal):\n    \"\"\"\n    Converts a non-negative decimal integer to its binary string representation.\n    The output is formatted with \"db\" at the beginning and end, e.g., decimal_to_binary(15) returns \"db1111db\".\n    \"\"\"\n    if not isinstance(decimal, int):\n        raise ValueError(\"Input must be an integer.\")\n    if decimal < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n\n    # Convert to raw binary string; handle 0 explicitly, slice '0b' prefix otherwise.\n    if decimal == 0:\n        binary_str = \"0\"\n    else:\n        binary_str = bin(decimal)[2:]\n\n    prefix = \"db\"\n    suffix = \"db\"\n    return f\"{prefix}{binary_str}{suffix}\""}
{"task_id": "HumanEval/80", "solution": "def is_happy(s):\n    \"\"\"\n    Checks if a string is 'happy'.\n    A string is happy if its length is at least 3 and every 3 consecutive letters are distinct.\n    \"\"\"\n    if len(s) < 3:\n        return False\n\n    # Iterate through all possible 3-character consecutive sequences.\n    for i in range(len(s) - 2):\n        # Check if the three consecutive characters are distinct.\n        if not (s[i] != s[i+1] and s[i+1] != s[i+2] and s[i] != s[i+2]):\n            return False\n    return True"}
