{"task_id": "HumanEval/86", "solution": "import re\ndef anti_shuffle(s: str) -> str:\n    \"\"\"\n    Sorts characters within each word of a string, preserving word and space order.\n    Characters within each word are sorted in ascending ASCII order.\n    \"\"\"\n    if not s:\n        return \"\"\n\n    # Split the string into words (non-space sequences) and space sequences.\n    # The regex `(\\s+|\\S+)` captures both types of segments.\n    segments = re.findall(r'(\\s+|\\S+)', s)\n\n    processed_segments = []\n    for segment in segments:\n        if segment.isspace():\n            processed_segments.append(segment)\n        else:\n            # Sort characters within the word and append.\n            processed_segments.append(\"\".join(sorted(segment)))\n    \n    return \"\".join(processed_segments)"}
{"task_id": "HumanEval/86", "solution": "import re\ndef anti_shuffle(s):\n    \"\"\"\n    Takes a string and returns an ordered version of it.\n    Characters within each word are sorted by ASCII value; word order and spaces are preserved.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n\n    # Split the string by spaces, keeping the spaces as separate tokens.\n    tokens = re.split(r'(\\s+)', s)\n    \n    result_tokens = []\n    for token in tokens:\n        # If the token is a word (non-empty and not just spaces), sort its characters.\n        if token and not token.isspace():\n            result_tokens.append(\"\".join(sorted(token)))\n        else:\n            # Otherwise, it's a space or an empty string, keep it as is.\n            result_tokens.append(token)\n    \n    return \"\".join(result_tokens)"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds all occurrences of x in a nested list lst and returns a list of (row, column) tuples.\n    The output list is sorted primarily by row in ascending order, and secondarily by column in descending order.\n    \"\"\"\n    occurrences = []\n    for row_idx, row_list in enumerate(lst):\n        for col_idx, element in enumerate(row_list):\n            if element == x:\n                occurrences.append((row_idx, col_idx))\n\n    # Sort primarily by row (ascending), secondary by column (descending)\n    occurrences.sort(key=lambda coord: (coord[0], -coord[1]))\n    return occurrences"}
{"task_id": "HumanEval/87", "solution": "from typing import List, Tuple\nclass CoordinateFinder:\n    def _find_all(self, data: List[List[int]], target: int) -> List[Tuple[int, int]]:\n        \"\"\"\n        Finds all occurrences of 'target' in the 2D list 'data' and returns their coordinates.\n        \"\"\"\n        found_coordinates: List[Tuple[int, int]] = []\n        for r_idx, row in enumerate(data):\n            for c_idx, val in enumerate(row):\n                if val == target:\n                    found_coordinates.append((r_idx, c_idx))\n        return found_coordinates\n\n    def _sort_results(self, coordinates: List[Tuple[int, int]]) -> List[Tuple[int, int]]:\n        \"\"\"\n        Sorts coordinates: primary by row (ascending), secondary by column (descending).\n        \"\"\"\n        return sorted(coordinates, key=lambda coord: (coord[0], -coord[1]))\ndef get_row(lst, x):\n    \"\"\"\n    You are given a 2 dimensional data, as a nested lists,\n    which is similar to matrix, however, unlike matrices,\n    each row may contain a different number of columns.\n    Given lst, and integer x, find integers x in the list,\n    and return list of tuples, [(x1, y1), (x2, y2) ...] such that\n    each tuple is a coordinate - (row, columns), starting with 0.\n    Sort coordinates initially by rows in ascending order.\n    Also, sort coordinates of the row by columns in descending order.\n    \n    Examples:\n    get_row([\n      [1,2,3,4,5,6],\n      [1,2,3,4,1,6],\n      [1,2,3,4,5,1]\n    ], 1) == [(0, 0), (1, 4), (1, 0), (2, 5), (2, 0)]\n    get_row([], 1) == []\n    get_row([[], [1], [1, 2, 3]], 3) == [(2, 2)]\n    \"\"\"\n    finder = CoordinateFinder()\n    found_coords = finder._find_all(lst, x)\n    sorted_coords = finder._sort_results(found_coords)\n    return sorted_coords"}
