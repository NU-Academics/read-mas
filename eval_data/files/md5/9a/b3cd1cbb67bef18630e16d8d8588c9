{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    largest_factor = 1\n    d = 2\n    temp_n = n\n\n    while d * d <= temp_n:\n        if temp_n % d == 0:\n            largest_factor = d\n            while temp_n % d == 0:\n                temp_n //= d\n        d += 1\n\n    if temp_n > 1:\n        largest_factor = temp_n\n\n    return largest_factor"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True if list elements are monotonically increasing or decreasing.\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    \"\"\"\n    if len(l) <= 1:\n        return True\n\n    # Check if the list is non-decreasing.\n    is_non_decreasing = True\n    for i in range(len(l) - 1):\n        if l[i] > l[i+1]:\n            is_non_decreasing = False\n            break\n    \n    if is_non_decreasing:\n        return True\n\n    # If not non-decreasing, check if the list is non-increasing.\n    is_non_increasing = True\n    for i in range(len(l) - 1):\n        if l[i] < l[i+1]:\n            is_non_increasing = False\n            break\n    \n    return is_non_increasing"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True if list elements are monotonically increasing or decreasing.\n    This checks for non-decreasing or non-increasing trends.\n    \"\"\"\n\n    if len(l) <= 1:\n        return True\n\n    # Check for non-decreasing trend\n    is_non_decreasing = True\n    for i in range(len(l) - 1):\n        if l[i] > l[i+1]:\n            is_non_decreasing = False\n            break\n\n    if is_non_decreasing:\n        return True\n\n    # If not non-decreasing, check for non-increasing trend\n    is_non_increasing = True\n    for i in range(len(l) - 1):\n        if l[i] < l[i+1]:\n            is_non_increasing = False\n            break\n\n    return is_non_increasing"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n.\n    Assumes n > 1 and is not a prime.\n    \"\"\"\n    largest_factor = -1\n    d = 2\n\n    # Divide by 2 until n is odd\n    while n % d == 0:\n        largest_factor = d\n        n //= d\n\n    # Check for odd factors from 3 up to sqrt(n)\n    d = 3\n    while d * d <= n:\n        while n % d == 0:\n            largest_factor = d\n            n //= d\n        d += 2 # Increment by 2 to check only odd numbers\n\n    # If n is still greater than 1, it must be a prime factor itself\n    if n > 1:\n        largest_factor = n\n\n    return largest_factor"}
