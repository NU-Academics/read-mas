{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"It is the last week of the semester and the teacher has to give the grades\n    to students. The teacher has been making her own algorithm for grading.\n    The only problem is, she has lost the code she used for grading.\n    She has given you a list of GPAs for some students and you have to write \n    a function that can output a list of letter grades using the following table:\n             GPA       |    Letter grade\n              4.0                A+\n            > 3.7                A \n            > 3.3                A- \n            > 3.0                B+\n            > 2.7                B \n            > 2.3                B-\n            > 2.0                C+\n            > 1.7                C\n            > 1.3                C-\n            > 1.0                D+ \n            > 0.7                D \n            > 0.0                D-\n              0.0                E\n    \n\n    Example:\n    grade_equation([4.0, 3, 1.7, 2, 3.5]) ==> ['A+', 'B', 'C-', 'C', 'A-']\n    \"\"\"\n    \n    # Define the grading scale as (gpa_threshold, letter_grade) tuples, sorted descending.\n    # This directly implements the grading rules and logic from the design specification.\n    grading_scale = [\n        (4.0, \"A+\"),\n        (3.7, \"A\"),\n        (3.3, \"A-\"),\n        (3.0, \"B+\"),\n        (2.7, \"B\"),\n        (2.3, \"B-\"),\n        (2.0, \"C+\"),\n        (1.7, \"C\"),\n        (1.3, \"C-\"),\n        (1.0, \"D+\"),\n        (0.7, \"D\"),\n        (0.0, \"D-\"),\n        (-0.1, \"E\") # A sentinel to catch any GPA values below 0.0.\n    ]\n\n    converted_grades = []\n    for gpa in grades:\n        if gpa == 0.0: # Explicitly handles GPA of 0.0 to be 'E' as specified.\n            converted_grades.append(\"E\")\n            continue\n        \n        # Iterate through the sorted scale to find the first matching threshold (GPA >= threshold).\n        current_letter_grade = \"E\" \n        for threshold, letter in grading_scale:\n            if gpa >= threshold:\n                current_letter_grade = letter\n                break\n        converted_grades.append(current_letter_grade)\n            \n    return converted_grades"}
{"task_id": "HumanEval/84", "solution": "def solve(N: int) -> str:\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    Constraints: 0 <= N <= 10000.\n    \"\"\"\n    sum_of_digits = 0\n    # Convert N to string to iterate over digits, then sum them up.\n    for digit_char in str(N):\n        sum_of_digits += int(digit_char)\n\n    # Convert the calculated sum of digits to its binary representation.\n    # Python's bin() function returns a string prefixed with \"0b\".\n    if sum_of_digits == 0:\n        return \"0\"\n    else:\n        return bin(sum_of_digits)[2:]"}
{"task_id": "HumanEval/85", "solution": "def add(lst):\n    \"\"\"Given a non-empty list of integers lst, add the even elements that are at odd indices.\n    For example: add([4, 2, 6, 7]) returns 2.\n    \"\"\"\n    total_sum = 0\n    for i in range(len(lst)):\n        # Check if the index is odd (1, 3, 5, ...) and the element is even\n        if i % 2 != 0 and lst[i] % 2 == 0:\n            total_sum += lst[i]\n    return total_sum"}
{"task_id": "HumanEval/86", "solution": "import re\ndef anti_shuffle(s):\n    \"\"\"\n    Takes a string and returns an ordered version of it by sorting characters within each word.\n    The original word order and spacing are preserved in the output string.\n    \"\"\"\n    parts = re.split(r'(\\s+)', s)\n    processed_parts = []\n    for part in parts:\n        if part.strip():\n            processed_parts.append(\"\".join(sorted(part)))\n        else:\n            processed_parts.append(part)\n    return \"\".join(processed_parts)"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds integer x in the 2D list and returns its (row, column) coordinates.\n    Coordinates are sorted by row ascending, then by column descending.\n    \"\"\"\n    occurrences = []\n\n    if not lst:\n        return []\n\n    for r_idx, row in enumerate(lst):\n        for c_idx, val in enumerate(row):\n            if val == x:\n                occurrences.append((r_idx, c_idx))\n\n    if not occurrences:\n        return []\n\n    # Sort primarily by row (ascending), then by column (descending).\n    # Sorting by -coord[1] effectively sorts column in descending order.\n    return sorted(occurrences, key=lambda coord: (coord[0], -coord[1]))"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Sorts a copy of the array based on the parity of the sum of its first and last elements.\n    Returns a new array sorted ascending if sum is odd, or descending if sum is even.\n    \"\"\"\n    if not array:\n        return []\n\n    copied_array = list(array)\n\n    if len(copied_array) == 1:\n        return copied_array\n\n    first_element = copied_array[0]\n    last_element = copied_array[-1]\n    sum_first_last = first_element + last_element\n\n    if sum_first_last % 2 != 0:\n        copied_array.sort()\n    else:\n        copied_array.sort(reverse=True)\n\n    return copied_array"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"\n    Encrypts a string by rotating alphabetic characters down by 4 positions.\n    Non-alphabetic characters remain unchanged, and case is preserved.\n    \"\"\"\n    encrypted_chars = []\n    SHIFT_AMOUNT = 4\n    for char in s:\n        processed_char = char\n        if 'a' <= char <= 'z':\n            start = ord('a')\n            processed_char = chr(start + (ord(char) - start + SHIFT_AMOUNT) % 26)\n        elif 'A' <= char <= 'Z':\n            start = ord('A')\n            processed_char = chr(start + (ord(char) - start + SHIFT_AMOUNT) % 26)\n        encrypted_chars.append(processed_char)\n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Sorts an array of non-negative integers based on the parity of its first and last elements' sum.\n    Returns a new, sorted copy of the array without modifying the original.\n    \"\"\"\n    if not array:\n        return []\n\n    if len(array) == 1:\n        # Return a copy to ensure the original array remains unchanged, as per requirements.\n        return list(array)\n\n    first_element = array[0]\n    last_element = array[-1]\n    sum_first_last = first_element + last_element\n\n    # Determine sorting order: True for descending if sum is even, False for ascending if sum is odd.\n    is_descending = (sum_first_last % 2 == 0)\n\n    # Create a copy of the array and sort it using Python's built-in sorting function.\n    sorted_copy = sorted(array, reverse=is_descending)\n    return sorted_copy"}
{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Reorders characters within each word of a string alphabetically by ASCII value.\n    The original word order and spacing are preserved in the output.\n    \"\"\"\n    if not s:\n        return \"\"\n\n    parts = []\n    last_idx = 0\n    for i, char in enumerate(s):\n        if char == ' ':\n            if i > last_idx:\n                parts.append(s[last_idx:i])\n            parts.append(' ')\n            last_idx = i + 1\n    if last_idx < len(s):\n        parts.append(s[last_idx:])\n\n    result_parts = []\n    for part in parts:\n        if part == ' ':\n            result_parts.append(part)\n        else:\n            result_parts.append(\"\".join(sorted(part)))\n    \n    return \"\".join(result_parts)"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds occurrences of integer x in a 2D list and returns their 0-indexed (row, column) coordinates.\n    Coordinates are sorted by row ascending, then by column descending.\n    \"\"\"\n    found_coords = []\n    for r_idx, row in enumerate(lst):\n        for c_idx, val in enumerate(row):\n            if val == x:\n                found_coords.append((r_idx, c_idx))\n\n    # Sort coordinates by row (ascending) then by column (descending)\n    return sorted(found_coords, key=lambda coord: (coord[0], -coord[1]))"}
{"task_id": "HumanEval/90", "solution": "def next_smallest(lst):\n    \"\"\"\n    Returns the 2nd smallest unique element of the list.\n    Returns None if there is no such element.\n    \"\"\"\n    unique_elements = sorted(list(set(lst)))\n\n    if len(unique_elements) < 2:\n        return None\n    else:\n        return unique_elements[1]"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by rotating alphabetic characters. Letters shift down by four places, preserving case and non-alphabetic characters.\"\"\"\n\n    LOWERCASE_ALPHABET = \"abcdefghijklmnopqrstuvwxyz\"\n    UPPERCASE_ALPHABET = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"\n    SHIFT_AMOUNT = 4 # Shift amount is 2 multiplied by 2\n\n    def _rotate_char(char: str, alphabet: str, shift: int) -> str:\n        \"\"\"Rotates a single character within a given alphabet.\"\"\"\n        index = alphabet.index(char)\n        rotated_index = (index + shift) % len(alphabet)\n        return alphabet[rotated_index]\n\n    encrypted_chars = []\n    for char in s:\n        if 'a' <= char <= 'z':\n            encrypted_chars.append(_rotate_char(char, LOWERCASE_ALPHABET, SHIFT_AMOUNT))\n        elif 'A' <= char <= 'Z':\n            encrypted_chars.append(_rotate_char(char, UPPERCASE_ALPHABET, SHIFT_AMOUNT))\n        else:\n            encrypted_chars.append(char) # Non-alphabetic characters remain unchanged\n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/90", "solution": "def next_smallest(lst: list[int]) -> int | None:\n    \"\"\"\n    Returns the 2nd smallest distinct element of the list.\n    Returns None if there is no such element.\n    \"\"\"\n    if not lst:\n        return None\n\n    unique_sorted_elements = sorted(list(set(lst)))\n\n    if len(unique_sorted_elements) < 2:\n        return None\n    else:\n        return unique_sorted_elements[1]"}
