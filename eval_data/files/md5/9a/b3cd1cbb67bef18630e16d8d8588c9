{"task_id": "HumanEval/75", "solution": "import math\nfrom itertools import combinations\ndef _is_prime(n):\n    \"\"\"Checks if n is a prime number. Assumes n is an integer >= 2.\"\"\"\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        if n % i == 0:\n            return False\n    return True\ndef _generate_primes_up_to(limit):\n    \"\"\"Generates a list of all prime numbers less than or equal to limit.\"\"\"\n    primes = []\n    for num in range(2, limit + 1):\n        if _is_prime(num):\n            primes.append(num)\n    return primes\ndef is_multiply_prime(a):\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100.\"\"\"\n    primes = _generate_primes_up_to(a)\n\n    # Assumes distinct prime factors based on specification's example (2 * 3 * 5).\n    for p1, p2, p3 in combinations(primes, 3):\n        if p1 * p2 * p3 == a:\n            return True\n    return False"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Checks if a number x is a simple power of n.\n    x is a simple power of n if n**k = x for some non-negative integer k.\n    \"\"\"\n    if n <= 0:\n        # As per FR1, n must be greater than or equal to 1.\n        return False\n    if x < 0:\n        # As per FR1, x must be greater than or equal to 0.\n        return False\n    if x == 1:\n        return True  # n^0 = 1 for any n >= 1\n    if n == 1:\n        return x == 1  # Only 1 is a power of 1\n\n    current_power = n\n    while current_power < x:\n        current_power *= n\n    return current_power == x"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    \"\"\"\n    Checks if an integer 'a' is a perfect cube of another integer.\n    This function handles positive, negative, and zero inputs efficiently.\n    \"\"\"\n    if a == 0:\n        return True\n    \n    # Calculate the cube root of the absolute value, then round to the nearest integer.\n    cube_root_approx = round(abs(a)**(1/3))\n    \n    # Verify by cubing the approximation and comparing with the original number, respecting its sign.\n    if a > 0:\n        return cube_root_approx**3 == a\n    else: # a < 0\n        return (-cube_root_approx)**3 == a"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    \"\"\"Checks if an integer 'a' is a perfect cube.\n    It returns True if 'a' is a perfect cube, False otherwise.\"\"\"\n    if a == 0:\n        return True\n    \n    root = round(abs(a)**(1/3))\n    \n    if a > 0:\n        return root * root * root == a\n    else:\n        return -root * -root * -root == a"}
{"task_id": "HumanEval/76", "solution": "import math\ndef is_simple_power(x, n):\n    \"\"\"\n    Checks if x is a simple power of n, meaning n^k = x for a non-negative integer k.\n    Accounts for floating-point precision issues.\n    \"\"\"\n    EPSILON = 1e-9\n\n    if n == 1:\n        return x == 1\n    if n <= 0:\n        return False\n    if x == 1:\n        return True\n    if x <= 0:\n        return False\n\n    try:\n        # Calculate log_n(x) to find the potential power k.\n        power = math.log(x, n)\n        # Check if k is an integer (within tolerance) AND non-negative.\n        return math.isclose(power, round(power), abs_tol=EPSILON) and power >= -EPSILON\n    except ValueError:\n        return False"}
