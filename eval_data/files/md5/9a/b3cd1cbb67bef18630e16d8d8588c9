{"task_id": "HumanEval/34", "solution": "class ListDeduplicator:\n    \"\"\"Handles removing duplicate elements from a list.\"\"\"\n\n    def deduplicate(self, input_list: list) -> list:\n        # Using set for efficient deduplication.\n        return list(set(input_list))\nclass ListSorter:\n    \"\"\"Handles sorting elements in a list.\"\"\"\n\n    def sort(self, input_list: list) -> list:\n        # Using built-in sorted() for stable sorting.\n        return sorted(input_list)\nclass UniqueListService:\n    \"\"\"Orchestrates deduplication and sorting.\"\"\"\n\n    def __init__(self, deduplicator: ListDeduplicator, sorter: ListSorter):\n        self.deduplicator = deduplicator\n        self.sorter = sorter\n\n    def process(self, input_list: list) -> list:\n        unique_elements = self.deduplicator.deduplicate(input_list)\n        sorted_unique_elements = self.sorter.sort(unique_elements)\n        return sorted_unique_elements\n_deduplicator = ListDeduplicator()\n_sorter = ListSorter()\n_unique_list_service = UniqueListService(_deduplicator, _sorter)\ndef unique(l: list):\n    \"\"\"Return sorted unique elements in a list.\n    >>> unique([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [0, 2, 3, 5, 9, 123]\n    \"\"\"\n    return _unique_list_service.process(l)"}
{"task_id": "HumanEval/32", "solution": "import math\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    \"\"\"\n    DEFAULT_TOLERANCE = 1e-6\n    MAX_ITERATIONS = 100\n\n    # Calculate coefficients for the derivative polynomial.\n    derivative_coeffs = [i * coeff for i, coeff in enumerate(xs) if i > 0]\n\n    # Define a helper to evaluate the derivative polynomial.\n    def derivative_poly_eval(coefficients_d, val_d):\n        return sum([coeff_d * math.pow(val_d, i_d) for i_d, coeff_d in enumerate(coefficients_d)])\n\n    x = 0.0  # Initial guess for the root.\n\n    for _ in range(MAX_ITERATIONS):\n        fx = poly(xs, x)\n        if abs(fx) < DEFAULT_TOLERANCE:\n            return x\n\n        f_prime_x = derivative_poly_eval(derivative_coeffs, x)\n        \n        # Proceed with Newton-Raphson step, trusting caller's input implies f_prime_x will not cause division by zero.\n        x = x - fx / f_prime_x\n\n    # If convergence is not met, return the last approximation, trusting a solution is guaranteed.\n    return x"}
{"task_id": "HumanEval/32", "solution": "import math\ndef poly(xs: list, x: float):\n    \"\"\"Evaluates polynomial with coefficients xs at point x.\n    Returns xs[0] + xs[1] * x + ... + xs[n] * x^n.\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\ndef find_zero(xs: list):\n    \"\"\"Finds a single zero of a polynomial with coefficients xs.\n    The function assumes a root exists and returns one such zero.\n    \"\"\"\n    MAX_ITERATIONS = 1000\n    TOLERANCE = 1e-6\n\n    a, b = -10.0, 10.0\n\n    # Check if a boundary is already a root within tolerance.\n    if abs(poly(xs, a)) < TOLERANCE:\n        return a\n    if abs(poly(xs, b)) < TOLERANCE:\n        return b\n\n    low, high = a, b\n    for _ in range(MAX_ITERATIONS):\n        mid = (low + high) / 2\n        mid_val = poly(xs, mid)\n\n        if abs(mid_val) < TOLERANCE:\n            return mid\n\n        # Determine which half of the interval contains the root.\n        if poly(xs, low) * mid_val < 0:\n            high = mid\n        else:\n            low = mid\n\n    # If no root is found within iterations, return the last midpoint.\n    return (low + high) / 2"}
{"task_id": "HumanEval/35", "solution": "class MaxFinderError(Exception):\n    \"\"\"Base exception for the max_finder package.\n    It provides a base for all custom errors within this utility.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\nclass EmptyListError(MaxFinderError):\n    \"\"\"Raised when an operation requires a non-empty list but receives an empty one.\n    This typically occurs when trying to find an element in an empty collection.\"\"\"\n    def __init__(self, message: str = \"Input list cannot be empty.\"):\n        super().__init__(message)\ndef max_element(l: list):\n    \"\"\"Return maximum element in the list.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    if not l:\n        raise EmptyListError(\"Input list cannot be empty.\")\n\n    max_val = l[0]\n    for element in l[1:]:\n        if element > max_val:\n            max_val = element\n    return max_val"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list) -> list:\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    if not l:\n        return []\n\n    even_elements = [l[i] for i in range(0, len(l), 2)]\n    even_elements.sort()\n\n    result = l[:]\n    even_idx_counter = 0\n    for i in range(0, len(result), 2):\n        result[i] = even_elements[even_idx_counter]\n        even_idx_counter += 1\n\n    return result"}
{"task_id": "HumanEval/36", "solution": "class DigitCounter:\n    TARGET_DIGIT: int = 7\n\n    def count_digit(self, number: int, digit: int) -> int:\n        \"\"\"Counts how many times a specified digit appears in a number.\n        Handles negative numbers by taking their absolute value.\"\"\"\n        s_number = str(abs(number))\n        return s_number.count(str(digit))\nclass FizzBuzzCounter:\n    def __init__(self, digit_counter: DigitCounter = None):\n        \"\"\"Initializes the FizzBuzzCounter, optionally injecting a DigitCounter.\"\"\"\n        self._digit_counter = digit_counter if digit_counter is not None else DigitCounter()\n\n    def count_sevens_in_fizzbuzz(self, n: int) -> int:\n        \"\"\"Return the number of times the digit 7 appears in integers less than n\n        which are divisible by 11 or 13.\"\"\"\n        total_sevens = 0\n        for i in range(1, n):\n            if (i % 11 == 0) or (i % 13 == 0):\n                total_sevens += self._digit_counter.count_digit(i, DigitCounter.TARGET_DIGIT)\n        return total_sevens\ndef fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    counter = FizzBuzzCounter()\n    return counter.count_sevens_in_fizzbuzz(n)"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    TARGET_DIGIT = \"7\"\n    DIVISOR_ONE = 11\n    DIVISOR_TWO = 13\n\n    total_seven_count = 0\n    for i in range(1, n):\n        if i % DIVISOR_ONE == 0 or i % DIVISOR_TWO == 0:\n            total_seven_count += str(i).count(TARGET_DIGIT)\n    return total_seven_count"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    Takes an encoded string and returns its original form.\n    It reverses the cyclic shift of groups of three characters.\n    \"\"\"\n    # Split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # Cycle elements in each group to the right. Groups with fewer than 3 elements remain unchanged.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    even_elements = [l[i] for i in range(0, len(l), 2)]\n    even_elements.sort()\n\n    result = l[:]\n    even_idx_counter = 0\n    for i in range(0, len(l), 2):\n        result[i] = even_elements[even_idx_counter]\n        even_idx_counter += 1\n    return result"}
{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n\n    memoized_primes = {2, 3, 5, 7} # Cache for prime numbers to optimize checks.\n\n    def is_prime(num: int) -> bool:\n        # Checks if a number is prime using trial division and memoization.\n        if num < 2:\n            return False\n        if num in memoized_primes:\n            return True\n        if num % 2 == 0:\n            return False\n        \n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        \n        memoized_primes.add(num) # Add new prime to the cache.\n        return True\n\n    prime_fib_count = 0\n    current_fib, next_fib = 0, 1 # Initialize Fibonacci sequence.\n\n    while True:\n        fib_number = current_fib\n        current_fib, next_fib = next_fib, current_fib + next_fib\n\n        # Skip numbers less than or equal to 1, as they are not prime.\n        if fib_number <= 1:\n            continue\n\n        if is_prime(fib_number):\n            prime_fib_count += 1\n            if prime_fib_count == n:\n                return fib_number"}
