{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    \"\"\"\n    Calculates the sum of squares of odd, positive integers in the list.\n    Ignores numbers that are negative or not integers.\n    \"\"\"\n    if not lst:\n        return 0\n\n    total_sum_of_squares = 0\n    for item in lst:\n        # Check if the item is a positive integer.\n        if isinstance(item, int) and item > 0:\n            # Check if the positive integer is odd.\n            if item % 2 != 0:\n                # Square the number and add to the total.\n                total_sum_of_squares += item * item\n    return total_sum_of_squares"}
{"task_id": "HumanEval/154", "solution": "def _generate_rotations(s: str) -> list[str]:\n    \"\"\"Generates all unique cyclic rotations of a string.\"\"\"\n    if not s:\n        return [\"\"] \n    rotations = set()\n    n = len(s)\n    for i in range(n):\n        rotated_s = s[i:] + s[:i]\n        rotations.add(rotated_s)\n    return list(rotations)\ndef cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\"\"\"\n    if not b:\n        return True\n    \n    if not a:\n        return False\n    \n    rotations = _generate_rotations(b)\n    for rot in rotations:\n        if rot in a:\n            return True\n    return False"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension for a given class name based on CAP - SM strength calculation.\n    In case of a tie, the first extension in the list is chosen.\n    \"\"\"\n    strongest_extension_name = extensions[0]\n\n    cap_count_first = sum(1 for char in extensions[0] if 'A' <= char <= 'Z')\n    sm_count_first = sum(1 for char in extensions[0] if 'a' <= char <= 'z')\n    max_strength = cap_count_first - sm_count_first\n\n    for extension in extensions[1:]:\n        cap_count = sum(1 for char in extension if 'A' <= char <= 'Z')\n        sm_count = sum(1 for char in extension if 'a' <= char <= 'z')\n        current_strength = cap_count - sm_count\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = extension\n\n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"This function finds the strongest extension based on CAP-SM strength.\n    In case of ties, the first extension in the list is chosen.\n    \"\"\"\n\n    # Initialize with the first extension's strength and name, as per the tie-breaking rule.\n    # It is assumed that 'extensions' is a non-empty list of strings.\n    initial_ext_name = extensions[0]\n    cap_count_initial = sum(1 for char in initial_ext_name if 'A' <= char <= 'Z')\n    sm_count_initial = sum(1 for char in initial_ext_name if 'a' <= char <= 'z')\n    \n    strongest_strength = cap_count_initial - sm_count_initial\n    strongest_extension_name = initial_ext_name\n\n    # Iterate through the rest of the extensions, starting from the second element.\n    for ext_name in extensions[1:]:\n        # Calculate strength for the current extension.\n        cap_count = sum(1 for char in ext_name if 'A' <= char <= 'Z')\n        sm_count = sum(1 for char in ext_name if 'a' <= char <= 'z')\n        current_strength = cap_count - sm_count\n\n        # If the current extension is strictly stronger, update the strongest found.\n        # If strengths are equal, the existing 'strongest_extension_name' (which appeared earlier) is preserved.\n        if current_strength > strongest_strength:\n            strongest_strength = current_strength\n            strongest_extension_name = ext_name\n            \n    # Format and return the result string.\n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer, returns a tuple with the count of its even and odd digits.\n    The sign of the input number is ignored; only the absolute value's digits are analyzed.\n    \"\"\"\n    s_num = str(abs(num))\n    even_count = 0\n    odd_count = 0\n\n    for digit_char in s_num:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\n    cycpattern_check(\"abcd\",\"abd\") => False\n    cycpattern_check(\"hello\",\"ell\") => True\n    cycpattern_check(\"whassup\",\"psus\") => False\n    cycpattern_check(\"abab\",\"baa\") => True\n    cycpattern_check(\"efef\",\"eeff\") => False\n    cycpattern_check(\"himenss\",\"simen\") => True\n\n    \"\"\"\n    if not b:\n        return True\n\n    if len(b) > len(a):\n        return False\n\n    n = len(b)\n    double_b = b + b\n    for i in range(n):\n        rotation = double_b[i : i + n]\n        if rotation in a:\n            return True\n\n    return False"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer, return a tuple that has the number of even and odd digits respectively.\n     Example: even_odd_count(-12) ==> (1, 1)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    if num == 0:\n        return (1, 0)\n\n    # Process the absolute value of the number to ignore its sign.\n    abs_num_str = str(abs(num))\n\n    for digit_char in abs_num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its Roman numeral equivalent as a string,\n    and return it in lowercase. The input number is restricted to the range 1 to 1000.\n    \"\"\"\n    roman_map = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'), (1, 'I')\n    ]\n\n    roman_numeral = []\n    temp_num = number\n\n    for value, symbol in roman_map:\n        while temp_num >= value:\n            roman_numeral.append(symbol)\n            temp_num -= value\n\n    return \"\".join(roman_numeral).lower()"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    \"\"\"\n    Determines if three given side lengths form a right-angled triangle.\n    It applies the triangle inequality theorem and the Pythagorean theorem.\n    \"\"\"\n    # Check if the sides can form a valid triangle (Triangle Inequality Theorem - FR3)\n    if not ((a + b > c) and (a + c > b) and (b + c > a)):\n        return False\n        \n    # Check if the triangle is right-angled (Pythagorean Theorem - FR2)\n    # Sort the sides to easily identify the two shorter sides and the longest side (hypotenuse).\n    sides = sorted([a, b, c])\n    \n    # Use a small epsilon for floating point comparisons to account for precision errors (NFR2, Assumptions)\n    epsilon = 1e-9 \n    \n    # Check if the square of the two shorter sides sum up to the square of the longest side.\n    return abs(sides[0]**2 + sides[1]**2 - sides[2]**2) < epsilon"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    \"\"\"\n    ROMAN_MAP = {\n        1000: 'm', 900: 'cm', 500: 'd', 400: 'cd', 100: 'c',\n        90: 'xc', 50: 'l', 40: 'xl', 10: 'x', 9: 'ix',\n        5: 'v', 4: 'iv', 1: 'i'\n    }\n\n    roman_numeral_parts = []\n    temp_num = number\n    for value, symbol in ROMAN_MAP.items():\n        while temp_num >= value:\n            roman_numeral_parts.append(symbol)\n            temp_num -= value\n    return \"\".join(roman_numeral_parts)"}
{"task_id": "HumanEval/157", "solution": "import math\nFLOAT_TOLERANCE = 1e-9\ndef right_angle_triangle(a, b, c):\n    \"\"\"\n    Given three side lengths, return True if they form a right-angled triangle,\n    False otherwise, using the Pythagorean theorem with float tolerance.\n    \"\"\"\n    sides = sorted([a, b, c])\n    # Check if the square of the longest side equals the sum of the squares of the other two.\n    return math.isclose(sides[0]**2 + sides[1]**2, sides[2]**2, rel_tol=FLOAT_TOLERANCE)"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates carrots eaten and remaining after a rabbit's meal.\n    The rabbit eats the minimum of its need and available stock.\n    \"\"\"\n    carrots_eaten_in_meal = min(need, remaining)\n    total_eaten_carrots = number + carrots_eaten_in_meal\n    carrots_left_in_stock = remaining - carrots_eaten_in_meal\n    return [total_eaten_carrots, carrots_left_in_stock]"}
{"task_id": "HumanEval/158", "solution": "def find_max(words: list[str]) -> str:\n    \"\"\"\n    Finds the string with the maximum number of unique characters from a list.\n    In case of a tie, the lexicographically smallest string is returned.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        # Calculate the number of unique characters in the current word.\n        current_unique_count = len(set(word))\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            # If unique counts are tied, choose the lexicographically smaller word.\n            if word < result_word:\n                result_word = word\n    return result_word"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates rabbit carrot consumption and remaining stock. Returns total eaten carrots and carrots left.\n    \"\"\"\n    eaten_this_meal = min(need, remaining)\n    total_eaten = number + eaten_this_meal\n    carrots_left = remaining - eaten_this_meal\n    return [total_eaten, carrots_left]"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Finds the string with the maximum unique characters, breaking ties lexicographically.\n    Returns an empty string for an empty input list.\"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_candidates = []\n\n    for word in words:\n        current_unique_count = len(set(word))\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_candidates = [word]\n        elif current_unique_count == max_unique_count:\n            result_candidates.append(word)\n        \n    return sorted(result_candidates)[0]"}
{"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its MD5 hash equivalent as a hexadecimal string.\n    Returns None if 'text' is an empty string.\n    \"\"\"\n    if not text:\n        return None\n    return hashlib.md5(text.encode('utf-8')).hexdigest()"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Constructs and evaluates an algebraic expression from lists of operators and operands.\n    It respects standard mathematical operator precedence.\n    \"\"\"\n    expression_parts = []\n    for i in range(len(operand)):\n        expression_parts.append(str(operand[i]))\n        if i < len(operator):\n            expression_parts.append(operator[i])\n    expression_string = \" \".join(expression_parts)\n\n    # Safely evaluate the constructed expression string using controlled built-ins.\n    allowed_builtins = {\n        'abs': abs, 'min': min, 'max': max, 'round': round,\n        'pow': pow, 'int': int, 'float': float\n    }\n    return eval(expression_string, {\"__builtins__\": allowed_builtins}, {})"}
{"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    # Encode the string to bytes and compute its MD5 hash, returning the hexadecimal digest.\n    return hashlib.md5(text.encode('utf-8')).hexdigest()"}
{"task_id": "HumanEval/161", "solution": "def has_letters(s: str) -> bool:\n    \"\"\"Checks if the string contains any alphabetic characters.\"\"\"\n    return any(c.isalpha() for c in s)\ndef reverse_case(s: str) -> str:\n    \"\"\"Reverses the case of letters in the string, keeping non-letters as is.\"\"\"\n    return \"\".join([c.swapcase() if c.isalpha() else c for c in s])\ndef reverse_string(s: str) -> str:\n    \"\"\"Reverses the entire string.\"\"\"\n    return s[::-1]\ndef solve(s):\n    \"\"\"Processes a string by reversing letter cases or reversing the whole string if it contains no letters.\"\"\"\n    if has_letters(s):\n        return reverse_case(s)\n    else:\n        return reverse_string(s)"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Given lists of operators and operands, this function constructs an algebraic expression.\n    It then evaluates the expression respecting standard precedence and returns the integer result.\n    \"\"\"\n    expression_parts = []\n    # Interleave operands and operators to form the expression string.\n    for i in range(len(operand)):\n        expression_parts.append(str(operand[i]))\n        if i < len(operator):\n            expression_parts.append(operator[i])\n\n    expression_string = \" \".join(expression_parts)\n\n    # Evaluate the constructed expression using Python's built-in eval,\n    # which inherently handles standard operator precedence.\n    result = eval(expression_string)\n\n    return int(result)"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the single-digit even numbers (2, 4, 6, 8)\n    that fall within the inclusive range defined by min(a, b) and max(a, b).\n    The result will be in ascending order.\n    \"\"\"\n    EVEN_DIGITS = [2, 4, 6, 8]\n\n    min_val = min(a, b)\n    max_val = max(a, b)\n\n    result = []\n    for digit in EVEN_DIGITS:\n        if min_val <= digit <= max_val:\n            result.append(digit)\n            \n    return result"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa, \n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    Examples\n    solve(\"1234\") = \"4321\"\n    solve(\"ab\") = \"AB\"\n    solve(\"#a@C\") = \"#A@c\"\n    \"\"\"\n\n    def _has_letters(input_str: str) -> bool:\n        \"\"\"Checks if the string contains any alphabetic characters.\"\"\"\n        return any(c.isalpha() for c in input_str)\n\n    def _reverse_case(input_str: str) -> str:\n        \"\"\"Reverses the case of alphabetic characters in a string.\"\"\"\n        transformed_chars = []\n        for char in input_str:\n            if char.isalpha():\n                if char.islower():\n                    transformed_chars.append(char.upper())\n                else:  # char is uppercase\n                    transformed_chars.append(char.lower())\n            else:\n                transformed_chars.append(char)\n        return \"\".join(transformed_chars)\n\n    if not _has_letters(s):\n        return s[::-1]\n    else:\n        return _reverse_case(s)"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    start = min(a, b)\n    end = max(a, b)\n    \n    even_numbers = []\n    # Collect all even numbers within the inclusive range [start, end].\n    for i in range(start, end + 1):\n        if i % 2 == 0:\n            even_numbers.append(i)\n    \n    return even_numbers"}
{"task_id": "HumanEval/150", "solution": "def x_or_y(n, x, y):\n    \"\"\"Returns x if n is a prime number, and y otherwise.\n    The primality check is implemented directly within this function.\n    \"\"\"\n    # Determine if n is prime based on the functional requirements.\n    if n <= 1:\n        is_n_prime = False\n    elif n == 2:\n        is_n_prime = True\n    elif n % 2 == 0: # Even numbers greater than 2 are not prime.\n        is_n_prime = False\n    else:\n        # Check for odd divisors from 3 up to the square root of n.\n        is_n_prime = True\n        # Using n**0.5 for square root to avoid external module imports.\n        # The loop limit includes the integer part of the square root.\n        limit = int(n**0.5) + 1\n        for i in range(3, limit, 2):\n            if n % i == 0:\n                is_n_prime = False\n                break\n    \n    # Return x if n is prime, or y otherwise.\n    if is_n_prime:\n        return x\n    else:\n        return y"}
