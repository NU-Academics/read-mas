{"task_id": "HumanEval/2", "solution": "def truncate_number(number: float) -> float:\n    \"\"\"Extracts the decimal part of a positive floating-point number.\n    It returns the leftover part after subtracting the largest integer less than or equal to the number.\n    \"\"\"\n    integer_part = int(number)\n    decimal_part = number - integer_part\n    return decimal_part"}
{"task_id": "HumanEval/3", "solution": "from typing import List\ndef below_zero(operations: List[int]) -> bool:\n    \"\"\"\n    Detects if the account balance, starting at zero, falls below zero at any point during operations.\n    Returns True if it falls below zero, False otherwise.\n    \"\"\"\n    current_balance = 0\n    for op in operations:\n        current_balance += op\n        if current_balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/2", "solution": "import math\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    an integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1). Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    return number - math.floor(number)"}
{"task_id": "HumanEval/0", "solution": "from typing import List\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\"\n    Check if any two numbers in the given list are closer to each other than the specified threshold.\n    Returns True if such a pair exists, False otherwise.\n    \"\"\"\n    if len(numbers) < 2:\n        return False\n\n    # Sorting allows for O(N log N) complexity instead of O(N^2)\n    # by only comparing adjacent elements after sorting.\n    sorted_numbers = sorted(numbers)\n\n    for i in range(len(sorted_numbers) - 1):\n        if sorted_numbers[i+1] - sorted_numbers[i] < threshold:\n            return True\n    return False"}
{"task_id": "HumanEval/0", "solution": "from typing import List\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\"Check if any two numbers in the list are closer than the threshold.\n    This function uses sorting for O(N log N) efficiency.\n    \"\"\"\n    n = len(numbers)\n    if n < 2:\n        return False\n\n    # Sort the list to find close elements efficiently by checking only adjacent pairs.\n    sorted_numbers = sorted(numbers)\n\n    for i in range(n - 1):\n        if abs(sorted_numbers[i+1] - sorted_numbers[i]) < threshold:\n            return True\n    return False"}
{"task_id": "HumanEval/1", "solution": "from typing import List\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"Separates groups of nested parentheses into separate strings.\n    Each returned group is balanced and not nested within others.\n    \"\"\"\n    cleaned_string = paren_string.replace(' ', '')\n        \n    result: List[str] = []\n    current_group_start = 0\n    balance = 0\n\n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n\n        if balance == 0 and current_group_start <= i:\n            # Found a balanced group.\n            result.append(cleaned_string[current_group_start : i + 1])\n            current_group_start = i + 1\n    \n    return result"}
