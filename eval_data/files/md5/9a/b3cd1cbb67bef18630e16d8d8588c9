{"task_id": "HumanEval/1", "solution": "from typing import List\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"Separates distinct, balanced, and non-nested parenthesis groups from an input string. Non-parenthesis characters and spaces are ignored during parsing and group formation.\"\"\"\n\n    # Filter out all non-parenthesis characters, including spaces, to prepare the string for parsing.\n    # This aligns with the definition of a \"group\" as a sequence of parentheses and example outputs.\n    cleaned_string = \"\".join(char for char in paren_string if char == '(' or char == ')')\n\n    groups: List[str] = []\n    balance = 0\n    group_start_index = -1  # Index where the current potential top-level group started.\n\n    for i, char in enumerate(cleaned_string):\n        if char == '(':\n            if balance == 0:  # If balance is zero, this '(' starts a new top-level group.\n                group_start_index = i\n            balance += 1\n        elif char == ')':\n            balance -= 1\n\n        # If balance returns to 0 and a group was actively being tracked, it's a complete, balanced top-level group.\n        if balance == 0 and group_start_index != -1:\n            groups.append(cleaned_string[group_start_index : i + 1])\n            group_start_index = -1  # Reset to search for the next top-level group.\n        # If balance drops below zero, an unmatched ')' occurred, invalidating any current group.\n        elif balance < 0:\n            balance = 0          # Reset balance to continue searching from the next character.\n            group_start_index = -1 # Discard any started group segment.\n\n    return groups"}
{"task_id": "HumanEval/4", "solution": "from typing import List\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    data_mean = sum(numbers) / len(numbers)\n    absolute_differences = [abs(x - data_mean) for x in numbers]\n    mad = sum(absolute_differences) / len(numbers)\n    return mad"}
{"task_id": "HumanEval/4", "solution": "from typing import List\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    if not numbers:\n        return 0.0\n\n    mean = sum(numbers) / len(numbers)\n    absolute_differences = [abs(x - mean) for x in numbers]\n    mad = sum(absolute_differences) / len(absolute_differences)\n    return mad"}
{"task_id": "HumanEval/5", "solution": "from typing import List\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/5", "solution": "from typing import List\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers`\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/6", "solution": "from typing import List\ndef _calculate_max_nesting(group_string: str) -> int:\n    \"\"\"Calculates the deepest nesting level for a single parentheses group string.\n    It handles malformed groups by returning the maximum valid nesting or 0.\n    \"\"\"\n    max_nesting = 0\n    current_nesting = 0\n    for char in group_string:\n        if char == '(':\n            current_nesting += 1\n            max_nesting = max(max_nesting, current_nesting)\n        elif char == ')':\n            current_nesting -= 1\n            if current_nesting < 0:\n                current_nesting = 0\n    return max_nesting\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"Parses a string of space-separated parentheses groups to find the deepest nesting level for each.\n    It returns a list of these maximum nesting depths.\n    \"\"\"\n    if not paren_string.strip():\n        return []\n\n    groups = paren_string.split(' ')\n    results = []\n    for group in groups:\n        if group:\n            results.append(_calculate_max_nesting(group))\n    return results"}
