{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\"Calculates the sum and product of a list of integers.\n    Handles empty lists by returning (0, 1).\n    \"\"\"\n    if not numbers:\n        return (0, 1)\n\n    total_sum = 0\n    total_product = 1\n\n    for num in numbers:\n        total_sum += num\n        total_product *= num\n\n    return (total_sum, total_product)"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    current_sum = 0\n    current_product = 1\n\n    if not numbers:\n        return (current_sum, current_product)\n\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n\n    return (current_sum, current_product)"}
{"task_id": "HumanEval/6", "solution": "from typing import List\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    \"\"\"\n    if not paren_string.strip():\n        return []\n\n    groups = paren_string.split(' ')\n    results = []\n    for group in groups:\n        if group:  # Only process non-empty groups after splitting\n            current_depth = 0\n            max_depth = 0\n            for char in group:\n                if char == '(':\n                    current_depth += 1\n                    max_depth = max(max_depth, current_depth)\n                elif char == ')':\n                    current_depth -= 1\n            results.append(max_depth)\n    return results"}
{"task_id": "HumanEval/9", "solution": "from typing import List\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element\n    found until the given moment in the sequence.\n    \"\"\"\n    if not numbers:\n        return []\n\n    rolling_max_list: List[int] = []\n    current_max: int = numbers[0]\n\n    rolling_max_list.append(current_max)\n\n    for number in numbers[1:]:\n        current_max = max(current_max, number)\n        rolling_max_list.append(current_max)\n\n    return rolling_max_list"}
{"task_id": "HumanEval/9", "solution": "from typing import List\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\"Calculates the rolling maximum for a list of integers.\n    The rolling maximum at any given index `i` is the maximum value from index 0 to `i` (inclusive).\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result: List[int] = []\n    current_max: int = numbers[0] # Initialize with the first element for robust comparison.\n\n    for number in numbers:\n        if number > current_max:\n            current_max = number\n        result.append(current_max)\n\n    return result"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\"Returns the longest string from a list, preferring the first one encountered in case of ties. It returns None if the input list is empty.\n    >>> longest([])\n\n    >>> longest(['a', 'b', 'c'])\n    'a'\n    >>> longest(['a', 'bb', 'ccc'])\n    'ccc'\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_str = \"\"\n    max_length = -1\n\n    for s in strings:\n        if len(s) > max_length:\n            longest_str = s\n            max_length = len(s)\n    return longest_str"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    \"\"\"\n    len_a, len_b = len(a), len(b)\n\n    # Pad the shorter string with leading '0's to match the length of the longer string.\n    if len_a < len_b:\n        a = '0' * (len_b - len_a) + a\n    elif len_b < len_a:\n        b = '0' * (len_a - len_b) + b\n\n    result_chars = []\n    for i in range(len(a)):\n        if a[i] != b[i]:\n            result_chars.append('1')\n        else:\n            result_chars.append('0')\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/11", "solution": "from typing import List\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    result_chars = []\n    for i in range(len(a)):\n        xor_result = int(a[i]) ^ int(b[i])\n        result_chars.append(str(xor_result))\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome. \"\"\"\n    return string == string[::-1]\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string. \"\"\"\n\n    def _find_longest_palindromic_suffix(text: str) -> str:\n        \"\"\" Finds the longest suffix of a string that is a palindrome. \"\"\"\n        n = len(text)\n        for i in range(n):\n            suffix = text[i:]\n            if suffix == suffix[::-1]:\n                return suffix\n        return \"\"\n\n    if is_palindrome(string):\n        return string\n\n    longest_pal_suffix = _find_longest_palindromic_suffix(string)\n\n    prefix_to_reverse = string[:len(string) - len(longest_pal_suffix)]\n\n    return string + prefix_to_reverse[::-1]"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    \"\"\"\n    if not strings:\n        return None\n\n    longest_str = None\n    max_length = -1\n\n    for s in strings:\n        if longest_str is None or len(s) > max_length:\n            longest_str = s\n            max_length = len(s)\n    return longest_str"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b.\n    It handles negative and zero inputs by operating on their absolute values.\n    \"\"\"\n    a_abs = abs(a)\n    b_abs = abs(b)\n\n    while b_abs:\n        a_abs, b_abs = b_abs, a_abs % b_abs\n    return a_abs"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    a = abs(a)\n    b = abs(b)\n    while b:\n        a, b = b, a % b\n    return a"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\"Test if a given string is a palindrome.\n    It compares the string with its reverse.\n    \"\"\"\n    return string == string[::-1]\ndef make_palindrome(string: str) -> str:\n    \"\"\"Find the shortest palindrome that begins with a supplied string.\n    It finds the longest palindromic suffix and appends the reversed prefix.\n    \"\"\"\n    if not string:\n        return \"\"\n\n    n = len(string)\n    # Iterate to find the starting index `i` of the longest palindromic suffix.\n    # The smallest `i` corresponds to the longest suffix `string[i:]`.\n    for i in range(n + 1):\n        suffix = string[i:]\n        if is_palindrome(suffix):\n            prefix_to_reverse = string[:i]\n            return string + prefix_to_reverse[::-1]\n    # This line should theoretically not be reached for non-empty strings\n    # because the empty string \"\" is always a palindrome and will be found at `i=n`.\n    return string"}
