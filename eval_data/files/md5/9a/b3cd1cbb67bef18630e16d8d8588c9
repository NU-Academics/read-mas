{"task_id": "HumanEval/16", "solution": "def count_distinct_characters(string: str) -> int:\n    \"\"\" Given a string, find out how many distinct characters (regardless of case) does it consist of\n    >>> count_distinct_characters('xyzXYZ')\n    3\n    >>> count_distinct_characters('Jerry')\n    4\n    \"\"\"\n    # Convert the string to lowercase to handle case-insensitivity.\n    lower_cased_string = string.lower()\n    \n    # Use a set to store and count distinct characters.\n    distinct_chars_set = set(lower_cased_string)\n            \n    return len(distinct_chars_set)"}
{"task_id": "HumanEval/18", "solution": "def how_many_times(string: str, substring: str) -> int:\n    \"\"\"Find how many times a given substring can be found in the original string.\n    Count overlapping cases as specified in business rules.\n    \"\"\"\n    if not substring:\n        return len(string) + 1\n\n    count = 0\n    # The loop naturally handles cases where substring is longer than string by making range empty.\n    for i in range(len(string) - len(substring) + 1):\n        if string[i:i+len(substring)] == substring:\n            count += 1\n    return count"}
{"task_id": "HumanEval/18", "solution": "def how_many_times(string: str, substring: str) -> int:\n    \"\"\"\n    Find how many times a given substring can be found in the original string.\n    Count overlapping cases.\n    \"\"\"\n    if not substring:\n        return 0\n    if not string:\n        return 0\n\n    count = 0\n    # Iterate through the main string to find all possible starting positions for the substring.\n    for i in range(len(string) - len(substring) + 1):\n        if string[i : i + len(substring)] == substring:\n            count += 1\n    return count"}
{"task_id": "HumanEval/17", "solution": "from typing import List\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\"\n    Parses a string of ASCII musical notation into a list of beat durations.\n    Each symbol corresponds to a specific beat length as per the music legend.\n    \"\"\"\n    NOTE_MAPPING = {\n        'o': 4,   # whole note\n        'o|': 2,  # half note\n        '.|': 1   # quarter note\n    }\n\n    # Split the music string by whitespace.\n    note_symbols = music_string.split()\n    \n    beat_durations: List[int] = []\n\n    for symbol in note_symbols:\n        # Trusting caller's input, all symbols are assumed to be valid keys in NOTE_MAPPING.\n        beat_durations.append(NOTE_MAPPING[symbol])\n\n    return beat_durations"}
{"task_id": "HumanEval/20", "solution": "from typing import List, Tuple\ndef find_closest_elements(numbers: List[float]) -> Tuple[float, float]:\n    \"\"\" From a supplied list of numbers (of length at least two) select and return two that are the closest to each\n    other and return them in order (smaller number, larger number).\n    \"\"\"\n    sorted_numbers = sorted(numbers)\n\n    min_diff = float('inf')\n    closest_pair = (0.0, 0.0)\n\n    for i in range(len(sorted_numbers) - 1):\n        diff = sorted_numbers[i+1] - sorted_numbers[i]\n        if diff < min_diff:\n            min_diff = diff\n            closest_pair = (sorted_numbers[i], sorted_numbers[i+1])\n\n    return closest_pair"}
{"task_id": "HumanEval/19", "solution": "_WORD_TO_INT_MAP = {\n    \"zero\": 0, \"one\": 1, \"two\": 2, \"three\": 3, \"four\": 4,\n    \"five\": 5, \"six\": 6, \"seven\": 7, \"eight\": 8, \"nine\": 9\n}\n_INT_TO_WORD_MAP = {\n    0: \"zero\", 1: \"one\", 2: \"two\", 3: \"three\", 4: \"four\",\n    5: \"five\", 6: \"six\", 7: \"seven\", 8: \"eight\", 9: \"nine\"\n}\ndef sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Return the string with numbers sorted from smallest to largest.\n    \"\"\"\n    if not numbers:\n        return \"\"\n\n    words = numbers.split(' ')\n    \n    # Convert number words to their integer values.\n    int_numbers = [_WORD_TO_INT_MAP[word] for word in words]\n\n    # Sort the list of integers in ascending order.\n    int_numbers.sort()\n\n    # Convert the sorted integers back to their number word strings.\n    sorted_words = [_INT_TO_WORD_MAP[num] for num in int_numbers]\n\n    # Join the sorted number words into a single space-delimited string.\n    return ' '.join(sorted_words)"}
{"task_id": "HumanEval/19", "solution": "from typing import List\ndef sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Valid choices are 'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight' and 'nine'.\n    Return the string with numbers sorted from smallest to largest\n    >>> sort_numbers('three one five')\n    'one three five'\n    \"\"\"\n    word_to_int_map = {\n        \"zero\": 0, \"one\": 1, \"two\": 2, \"three\": 3, \"four\": 4,\n        \"five\": 5, \"six\": 6, \"seven\": 7, \"eight\": 8, \"nine\": 9\n    }\n    int_to_word_map = {\n        0: \"zero\", 1: \"one\", 2: \"two\", 3: \"three\", 4: \"four\",\n        5: \"five\", 6: \"six\", 7: \"seven\", 8: \"eight\", 9: \"nine\"\n    }\n\n    words: List[str] = numbers.split(' ')\n    \n    numbers_as_int: List[int] = [word_to_int_map[word] for word in words]\n    numbers_as_int.sort()\n    \n    sorted_words: List[str] = [int_to_word_map[num] for num in numbers_as_int]\n            \n    return ' '.join(sorted_words)"}
{"task_id": "HumanEval/17", "solution": "from typing import List\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\" Input to this function is a string representing musical notes in a special ASCII format.\n    Your task is to parse this string and return list of integers corresponding to how many beats does each\n    not last.\n\n    Here is a legend:\n    'o' - whole note, lasts four beats\n    'o|' - half note, lasts two beats\n    '.|' - quater note, lasts one beat\n\n    >>> parse_music('o o| .| o| o| .| .| .| .| o o')\n    [4, 2, 1, 2, 2, 1, 1, 1, 1, 4, 4]\n    \"\"\"\n    NOTE_MAPPING = {\n        'o': 4,\n        'o|': 2,\n        '.|': 1\n    }\n\n    beat_durations: List[int] = []\n    i = 0\n    while i < len(music_string):\n        # Try matching 2-character notes first (greedy matching)\n        if i + 1 < len(music_string):\n            two_char_slice = music_string[i:i+2]\n            if two_char_slice in NOTE_MAPPING:\n                beat_durations.append(NOTE_MAPPING[two_char_slice])\n                i += 2\n                continue  # Move to the next character after matching\n        \n        # Try matching 1-character notes\n        one_char_slice = music_string[i]\n        if one_char_slice in NOTE_MAPPING:\n            beat_durations.append(NOTE_MAPPING[one_char_slice])\n            i += 1\n            continue  # Move to the next character after matching\n\n        # Skip whitespace characters\n        if one_char_slice.isspace():\n            i += 1\n            continue  # Move to the next character\n\n        # If no known note or whitespace matched, skip the unrecognized character\n        i += 1\n            \n    return beat_durations"}
{"task_id": "HumanEval/20", "solution": "from typing import List, Tuple\ndef find_closest_elements(numbers: List[float]) -> Tuple[float, float]:\n    \"\"\" From a supplied list of numbers (of length at least two) select and return two that are the closest to each\n    other and return them in order (smaller number, larger number).\n    \"\"\"\n    sorted_numbers = sorted(numbers)\n\n    min_diff = float('inf')\n    closest_pair = (0.0, 0.0)\n\n    for i in range(len(sorted_numbers) - 1):\n        diff = sorted_numbers[i+1] - sorted_numbers[i]\n        if diff < min_diff:\n            min_diff = diff\n            closest_pair = (sorted_numbers[i], sorted_numbers[i+1])\n    \n    return closest_pair"}
{"task_id": "HumanEval/21", "solution": "from typing import List\ndef rescale_to_unit(numbers: List[float]) -> List[float]:\n    \"\"\" Given list of numbers, apply a linear transform such that the smallest becomes 0 and the largest becomes 1.\n    This function trusts the input and does not perform explicit validation for list length.\n    \"\"\"\n    min_val = min(numbers)\n    max_val = max(numbers)\n\n    if max_val == min_val:\n        return [0.0] * len(numbers)\n    else:\n        scale_factor = 1.0 / (max_val - min_val)\n        return [(x - min_val) * scale_factor for x in numbers]"}
{"task_id": "HumanEval/21", "solution": "from typing import List\ndef rescale_to_unit(numbers: List[float]) -> List[float]:\n    \"\"\"Given a list of numbers (of at least two elements), apply a linear transform to that list,\n    such that the smallest number will become 0 and the largest will become 1.\"\"\"\n    min_val = min(numbers)\n    max_val = max(numbers)\n\n    if min_val == max_val:\n        return [0.0] * len(numbers)\n\n    rescaled_numbers = [\n        (x - min_val) / (max_val - min_val) for x in numbers\n    ]\n    return rescaled_numbers"}
