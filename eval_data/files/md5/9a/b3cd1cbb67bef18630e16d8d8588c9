{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"Write a function that takes a string and returns True if the string\n    length is a prime number or False otherwise\n    Examples\n    prime_length('Hello') == True\n    prime_length('abcdcba') == True\n    prime_length('kittens') == True\n    prime_length('orange') == False\n    \"\"\"\n\n    def _is_prime(n: int) -> bool:\n        \"\"\"Determines if a given integer n is a prime number.\"\"\"\n        if n < 2:\n            return False\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 1\n        return True\n\n    length = len(string)\n    return _is_prime(length)"}
{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"Write a function that takes a string and returns True if the string\n    length is a prime number or False otherwise\n    Examples\n    prime_length('Hello') == True\n    prime_length('abcdcba') == True\n    prime_length('kittens') == True\n    prime_length('orange') == False\n    \"\"\"\n    n = len(string)\n\n    if n < 2:\n        return False\n    i = 2\n    # Check for divisors up to the square root of n.\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 1\n    return True"}
{"task_id": "HumanEval/75", "solution": "_PRIMES_CACHE: list[int] = []\n_MAX_CACHED_PRIME: int = 1\nclass PrimeUtils:\n    \"\"\"Utility functions for prime number operations.\"\"\"\n\n    @staticmethod\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if a given integer n is a prime number.\n        Handles numbers less than 2 as not prime.\"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    @staticmethod\n    def get_primes_up_to_n(n: int) -> list[int]:\n        \"\"\"Generates a list of all prime numbers up to n, using a cache.\n        The cache is populated incrementally.\"\"\"\n        global _PRIMES_CACHE\n        global _MAX_CACHED_PRIME\n\n        # Ensure cache is up-to-date for requested 'n'\n        if n > _MAX_CACHED_PRIME:\n            start_check = _MAX_CACHED_PRIME + 1 if _PRIMES_CACHE else 2\n            for num in range(start_check, n + 1):\n                if PrimeUtils.is_prime(num):\n                    _PRIMES_CACHE.append(num)\n            _MAX_CACHED_PRIME = n\n            _PRIMES_CACHE.sort()\n\n        # Return primes from cache up to 'n'\n        return [p for p in _PRIMES_CACHE if p <= n]\nclass MultiplyPrimeChecker:\n    \"\"\"Core logic for checking if a number is the product of three primes.\"\"\"\n\n    @staticmethod\n    def is_multiply_prime(a: int) -> bool:\n        \"\"\"Checks if 'a' is the product of exactly three prime numbers.\n        Assumes 'a' is an integer between 0 and 100 (exclusive).\"\"\"\n        # Smallest number that is a product of 3 primes is 2*2*2 = 8.\n        if a < 8:\n            return False\n\n        # Generate primes up to a reasonable upper limit for a factor.\n        # For a = p1 * p2 * p3, p1, p2, p3 >= 2. Thus, p3 <= a / (2 * 2) = a / 4.\n        # For a < 100, the maximum prime factor needed is for a=92 (2*2*23), so 23.\n        # Using a // 2 ensures all factors up to 49 are available, which is safe.\n        primes_list = PrimeUtils.get_primes_up_to_n(a // 2)\n\n        # Iterate through combinations of three primes (p1, p2, p3)\n        n_primes = len(primes_list)\n        for i in range(n_primes):\n            p1 = primes_list[i]\n            # Optimization: If p1^3 > a, no combination with this p1 or larger can work.\n            if p1 * p1 * p1 > a:\n                break\n\n            for j in range(i, n_primes): # p2 >= p1 allows for repeated prime factors\n                p2 = primes_list[j]\n                # Optimization: If p1*p2^2 > a, no combination with this p2 or larger can work.\n                if p1 * p2 * p2 > a:\n                    break\n                \n                # Check if a is divisible by p1*p2 to find the third factor.\n                if a % (p1 * p2) == 0:\n                    p3_candidate = a // (p1 * p2)\n                    \n                    # The third factor must be prime and greater than or equal to p2.\n                    if p3_candidate >= p2 and PrimeUtils.is_prime(p3_candidate):\n                        return True\n        return False\ndef is_multiply_prime(a: int) -> bool:\n    \"\"\"Checks if the given number 'a' is the product of exactly three prime numbers.\"\"\"\n    return MultiplyPrimeChecker.is_multiply_prime(a)"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    if n == 1:\n        return 1\n    else:\n        # Applies the inclusion-exclusion principle for n-digit numbers:\n        # (starts with 1) + (ends with 1) - (starts and ends with 1)\n        # = 10^(n-1) + 9*10^(n-2) - 10^(n-2) = 18 * 10^(n-2)\n        return 18 * (10**(n - 2))"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"Converts a list of numerical GPAs into corresponding letter grades based on a predefined scale.\n    This function processes each GPA individually and collects the results into a new list.\n    \"\"\"\n    letter_grades = []\n    for gpa in grades:\n        if gpa == 4.0:\n            letter_grades.append(\"A+\")\n        elif gpa > 3.7:\n            letter_grades.append(\"A\")\n        elif gpa > 3.3:\n            letter_grades.append(\"A-\")\n        elif gpa > 3.0:\n            letter_grades.append(\"B+\")\n        elif gpa > 2.7:\n            letter_grades.append(\"B\")\n        elif gpa > 2.3:\n            letter_grades.append(\"B-\")\n        elif gpa > 2.0:\n            letter_grades.append(\"C+\")\n        elif gpa > 1.7:\n            letter_grades.append(\"C\")\n        elif gpa > 1.3:\n            letter_grades.append(\"C-\")\n        elif gpa > 1.0:\n            letter_grades.append(\"D+\")\n        elif gpa > 0.7:\n            letter_grades.append(\"D\")\n        elif gpa > 0.0:\n            letter_grades.append(\"D-\")\n        elif gpa == 0.0:\n            letter_grades.append(\"E\")\n        else:\n            letter_grades.append(\"E\") # Default to E for any value less than 0.0\n    return letter_grades"}
{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    \n    Constraints: 0 \u2264 N \u2264 10000.\n    \"\"\"\n    sum_val = 0\n    if N == 0:\n        sum_val = 0\n    else:\n        temp_N = N\n        while temp_N > 0:\n            sum_val += temp_N % 10\n            temp_N //= 10\n\n    if sum_val == 0:\n        return \"0\"\n    return bin(sum_val)[2:]"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of n-digit positive integers that start or end with 1.\n    Calculates using the principle of inclusion-exclusion.\n    \"\"\"\n    # Count of n-digit numbers that start with 1.\n    count_starts_with_1 = 10**(n - 1)\n\n    # Count of n-digit numbers that end with 1.\n    if n == 1:\n        count_ends_with_1 = 1\n    else:\n        count_ends_with_1 = 9 * (10**(n - 2))\n\n    # Count of n-digit numbers that start AND end with 1.\n    if n == 1:\n        count_starts_and_ends_with_1 = 1\n    else:\n        count_starts_and_ends_with_1 = 10**(n - 2)\n\n    return count_starts_with_1 + count_ends_with_1 - count_starts_and_ends_with_1"}
