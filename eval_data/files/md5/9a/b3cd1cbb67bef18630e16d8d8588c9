{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Counts triples (a[i], a[j], a[k]) from an array a (where a[i] = i*i - i + 1)\n    such that i < j < k and their sum is a multiple of 3.\n    The calculation is optimized by categorizing elements by their remainder modulo 3.\n    \"\"\"\n\n    def combinations(n_comb, k_comb):\n        \"\"\"Calculates 'n choose k' (C(n, k)). Returns 0 if k > n or k < 0.\"\"\"\n        if k_comb < 0 or k_comb > n_comb:\n            return 0\n        if k_comb == 0 or k_comb == n_comb:\n            return 1\n        if k_comb > n_comb // 2:\n            k_comb = n_comb - k_comb\n\n        res = 1\n        for i in range(k_comb):\n            res = res * (n_comb - i) // (i + 1)\n        return res\n\n    # Elements a[i] = i * i - i + 1 always have a remainder of 0 or 1 when divided by 3.\n    # Specifically, a[i] % 3 == 0 if i % 3 == 2. Otherwise, a[i] % 3 == 1.\n    counts_mod_3 = {0: 0, 1: 0}\n    for i in range(1, n + 1):\n        if i % 3 == 2:\n            counts_mod_3[0] += 1\n        else:\n            counts_mod_3[1] += 1\n\n    count_0 = counts_mod_3.get(0, 0)\n    count_1 = counts_mod_3.get(1, 0)\n\n    # A sum of three numbers is a multiple of 3 if all three have remainder 0,\n    # or all three have remainder 1.\n    num_0_triples = combinations(count_0, 3)\n    num_1_triples = combinations(count_1, 3)\n\n    return num_0_triples + num_1_triples"}
{"task_id": "HumanEval/148", "solution": "_SOLAR_SYSTEM_PLANETS = [\n    \"Mercury\", \"Venus\", \"Earth\", \"Mars\",\n    \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n]\ndef bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun \n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn, \n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2. \n    The function should return a tuple containing all planets whose orbits are \n    located between the orbit of planet1 and the orbit of planet2, sorted by \n    the proximity to the sun. \n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names. \n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    try:\n        idx1 = _SOLAR_SYSTEM_PLANETS.index(planet1)\n        idx2 = _SOLAR_SYSTEM_PLANETS.index(planet2)\n    except ValueError:\n        return ()\n\n    start_idx = min(idx1, idx2)\n    end_idx = max(idx1, idx2)\n\n    intermediate_planets = _SOLAR_SYSTEM_PLANETS[start_idx + 1: end_idx]\n    return tuple(intermediate_planets)"}
{"task_id": "HumanEval/148", "solution": "class PlanetOrder:\n    SOLAR_SYSTEM_PLANETS: tuple[str, ...] = (\n        \"Mercury\", \"Venus\", \"Earth\", \"Mars\",\n        \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n    )\n\n    @staticmethod\n    def get_planet_index(planet_name: str) -> int:\n        \"\"\"\n        Returns the 0-based index of a planet, or -1 if the planet is not found.\n        This method uses a linear search over the predefined planet list.\n        \"\"\"\n        try:\n            return PlanetOrder.SOLAR_SYSTEM_PLANETS.index(planet_name)\n        except ValueError:\n            return -1\nclass PlanetaryService:\n    @staticmethod\n    def get_planets_between(planet1: str, planet2: str) -> tuple[str, ...]:\n        \"\"\"\n        Identifies planets located between two specified planets, handling invalid names and order.\n        It returns an empty tuple if either input planet name is not valid.\n        \"\"\"\n        idx1 = PlanetOrder.get_planet_index(planet1)\n        idx2 = PlanetOrder.get_planet_index(planet2)\n\n        if idx1 == -1 or idx2 == -1:\n            return ()\n\n        # Ensure correct slicing order by determining min and max indices.\n        start_idx = min(idx1, idx2)\n        end_idx = max(idx1, idx2)\n\n        # Return planets between, excluding the start and end planets themselves.\n        return PlanetOrder.SOLAR_SYSTEM_PLANETS[start_idx + 1:end_idx]\ndef bf(planet1: str, planet2: str) -> tuple[str, ...]:\n    \"\"\"\n    Returns a tuple of planets whose orbits are between planet1 and planet2,\n    sorted by proximity to the Sun. Returns an empty tuple for invalid planet names.\n    \"\"\"\n    return PlanetaryService.get_planets_between(planet1, planet2)"}
{"task_id": "HumanEval/150", "solution": "def is_prime(n):\n    \"\"\"Determines if the given integer n is a prime number.\n    Uses trial division up to the square root of n.\"\"\"\n    if n < 2:\n        return False\n    for i in range(2, int(n**0.5) + 1):\n        if n % i == 0:\n            return False\n    return True\ndef x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\"\"\"\n    if is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n\n    double_the_difference([1, 3, 2, 0]) == 1 + 9 + 0 + 0 = 10\n    double_the_difference([-1, -2, 0]) == 0\n    double_the_difference([9, -2]) == 81\n    double_the_difference([0]) == 0\n\n    If the input list is empty, return 0.\n    '''\n    total_sum = 0\n    for item in lst:\n        # Filter out elements that are not integers.\n        if not isinstance(item, int):\n            continue\n        # Filter out elements that are negative.\n        if item < 0:\n            continue\n        # Filter out elements that are even.\n        if item % 2 == 0:\n            continue\n        # Square the remaining odd, positive integer and add to sum.\n        total_sum += item * item\n    return total_sum"}
