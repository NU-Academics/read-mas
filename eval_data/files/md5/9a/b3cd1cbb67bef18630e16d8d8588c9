{"task_id": "HumanEval/61", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"(\" and \")\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n        else: # Encountered a character that is not '(' or ')'\n            return False\n        if balance < 0: # Closing bracket without a corresponding open one\n            return False\n    return balance == 0"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\"Calculates the derivative of a polynomial where `xs[i]` is the coefficient of x^i.\n    Returns the derivative in the same coefficient list form.\n    >>> derivative([3, 1, 2, 4, 5])\n    [1, 4, 12, 20]\n    >>> derivative([1, 2, 3])\n    [2, 6]\n    \"\"\"\n    if not xs or len(xs) == 1:\n        return []\n\n    derived_coeffs = []\n    for i in range(1, len(xs)):\n        derived_coeffs.append(xs[i] * i)\n    \n    return derived_coeffs"}
{"task_id": "HumanEval/63", "solution": "_fibfib_memo = {\n    0: 0,\n    1: 0,\n    2: 1\n}\ndef fibfib(n: int):\n    \"\"\"The FibFib number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fibfib(0) == 0\n    fibfib(1) == 0\n    fibfib(2) == 1\n    fibfib(n) == fibfib(n-1) + fibfib(n-2) + fibfib(n-3).\n    Please write a function to efficiently compute the n-th element of the fibfib number sequence.\n    >>> fibfib(1)\n    0\n    >>> fibfib(5)\n    4\n    >>> fibfib(8)\n    24\n    \"\"\"\n    if n in _fibfib_memo:\n        return _fibfib_memo[n]\n\n    # Compute recursively using the defined recurrence relation and store the result.\n    # This ensures efficient O(n) computation through memoization.\n    result = fibfib(n - 1) + fibfib(n - 2) + fibfib(n - 3)\n    _fibfib_memo[n] = result\n    return result"}
{"task_id": "HumanEval/63", "solution": "_fibfib_memo = {\n    0: 0,\n    1: 0,\n    2: 1\n}\ndef fibfib(n: int) -> int:\n    \"\"\"Computes the n-th FibFib number efficiently using memoization.\n    It follows the recurrence: fibfib(n) = fibfib(n-1) + fibfib(n-2) + fibfib(n-3).\n    \"\"\"\n    if n in _fibfib_memo:\n        return _fibfib_memo[n]\n\n    result = (\n        fibfib(n - 1) +\n        fibfib(n - 2) +\n        fibfib(n - 3)\n    )\n    _fibfib_memo[n] = result\n    return result"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s: str) -> int:\n    \"\"\"Counts vowels in a string, case-insensitively.\n    'y' is a vowel only when it is the last character of the word.\"\"\"\n\n    if not s:\n        return 0\n\n    count = 0\n    s_lower = s.lower()\n    VOWELS_SET = {'a', 'e', 'i', 'o', 'u'}\n\n    for i, char in enumerate(s_lower):\n        if char in VOWELS_SET:\n            count += 1\n        elif char == 'y' and i == len(s_lower) - 1:\n            count += 1\n            \n    return count"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Counts the number of vowels in a string, where 'y' is a vowel only if it's the last character.\n    Vowels 'a', 'e', 'i', 'o', 'u' are always counted case-insensitively.\n    \"\"\"\n    count = 0\n    standard_vowels = {'a', 'e', 'i', 'o', 'u'}\n    \n    lower_s = s.lower()\n    word_length = len(lower_s)\n\n    for i, char in enumerate(lower_s):\n        if char in standard_vowels:\n            count += 1\n        elif char == 'y' and i == word_length - 1:\n            count += 1\n            \n    return count"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"\n    Returns the sum of the ASCII values of uppercase characters in the input string.\n    Returns 0 if the string is empty or contains no uppercase characters.\n    \"\"\"\n    total_sum = 0\n    for char in s:\n        if 'A' <= char <= 'Z':\n            total_sum += ord(char)\n    return total_sum"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    >>> circular_shift(12, 1)\n    \"21\"\n    >>> circular_shift(12, 2)\n    \"12\"\n    \"\"\"\n\n    def _int_to_digit_string(val):\n        return str(abs(val))\n\n    def _reverse_string(s_val):\n        return s_val[::-1]\n\n    def _circular_right_shift_string(s_val, shift_amount_val):\n        n_val = len(s_val)\n        effective_shift_val = shift_amount_val % n_val\n        return s_val[n_val - effective_shift_val:] + s_val[:n_val - effective_shift_val]\n\n    digit_string = _int_to_digit_string(x)\n    num_digits = len(digit_string)\n\n    # Handle the special case for shift > number of digits as per specification.\n    if shift > num_digits:\n        return _reverse_string(digit_string)\n    else:\n        # Perform standard circular right shift otherwise.\n        return _circular_right_shift_string(digit_string, shift)"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"\n    Calculates the sum of ASCII codes of only the uppercase characters in the input string.\n\n    Examples:\n        digitSum(\"\") => 0\n        digitSum(\"abAB\") => 131\n        digitSum(\"abcCd\") => 67\n        digitSum(\"helloE\") => 69\n        digitSum(\"woArBld\") => 131\n        digitSum(\"aAaaaXa\") => 153\n    \"\"\"\n    total_sum = 0\n    for char in s:\n        if char.isupper():\n            total_sum += ord(char)\n    return total_sum"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even non-negative integer node in an array and returns its value and index.\n    If multiple nodes share the smallest even value, the one with the smallest index is returned;\n    an empty list is returned if no even values or the array is empty.\n    \"\"\"\n    smallest_even_value = None\n    smallest_even_index = -1\n\n    for i, value in enumerate(arr):\n        if value % 2 == 0:\n            if smallest_even_value is None or value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = i\n            elif value == smallest_even_value and i < smallest_even_index:\n                smallest_even_index = i\n\n    if smallest_even_value is not None:\n        return [smallest_even_value, smallest_even_index]\n    else:\n        return []"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift digits of x right by shift, returning result as string.\n    If shift > number of digits, the digits are reversed.\n    \"\"\"\n    s = str(x)\n    \n    sign = ''\n    digits_only = s\n    if s.startswith('-'):\n        sign = '-'\n        digits_only = s[1:]\n\n    num_digits = len(digits_only)\n\n    if shift > num_digits:\n        # Reverse the digits if shift exceeds number of digits\n        reversed_digits = digits_only[::-1]\n        return sign + reversed_digits\n    else:\n        # Perform circular right shift\n        effective_shift = shift % num_digits\n        shifted_digits = digits_only[-effective_shift:] + digits_only[:-effective_shift]\n        return sign + shifted_digits"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Identifies and returns the node with the smallest even value and its smallest index.\n    Returns an empty list if no even values are found or the array is empty.\n    \"\"\"\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for i, num in enumerate(arr):\n        if num % 2 == 0:\n            if num < smallest_even_value:\n                smallest_even_value = num\n                smallest_even_index = i\n            # If num == smallest_even_value, the current smallest_even_index (from an earlier position)\n            # is already the one with the smallest index, so no update is needed.\n    \n    if smallest_even_index != -1:\n        return [int(smallest_even_value), smallest_even_index]\n    else:\n        return []"}
{"task_id": "HumanEval/67", "solution": "import re\ndef fruit_distribution(s,n):\n    \"\"\"\n    Calculates the number of mango fruits in a basket given a string describing apples and oranges\n    and the total number of fruits. It extracts apple and orange counts using a regex pattern.\n    \"\"\"\n    FRUIT_STRING_PATTERN = r\"(\\d+)\\s+apples\\s+and\\s+(\\d+)\\s+oranges\"\n\n    match = re.search(FRUIT_STRING_PATTERN, s)\n    \n    apples = int(match.group(1))\n    oranges = int(match.group(2))\n    \n    total_known_fruits = apples + oranges\n    \n    mangoes = n - total_known_fruits\n    \n    return mangoes"}
{"task_id": "HumanEval/69", "solution": "from collections import Counter\ndef search(lst):\n    \"\"\"\n    Finds the greatest positive integer whose frequency in the list is greater than or equal to its value.\n    Returns -1 if no such integer exists.\n    \"\"\"\n    frequencies = Counter(lst)\n    \n    candidates = []\n    for num, freq in frequencies.items():\n        if num > 0 and freq >= num:\n            candidates.append(num)\n    \n    if not candidates:\n        return -1\n    \n    return max(candidates)"}
{"task_id": "HumanEval/69", "solution": "from collections import Counter\ndef search(lst):\n    \"\"\"\n    Find the greatest positive integer in the list whose frequency is greater than or equal to its value.\n    Return -1 if no such integer exists.\n    \"\"\"\n    frequency_map = Counter(lst)\n\n    qualifying_integers = []\n    for num, freq in frequency_map.items():\n        if freq >= num:\n            qualifying_integers.append(num)\n\n    if not qualifying_integers:\n        return -1\n\n    return max(qualifying_integers)"}
{"task_id": "HumanEval/67", "solution": "import re\ndef fruit_distribution(s, n):\n    \"\"\"\n    Calculates the number of mango fruits in a basket.\n    Parses apple and orange counts from 's' and subtracts them from total 'n'.\n    \"\"\"\n    # Define the regex pattern to extract counts from the string.\n    FRUIT_PATTERN = r\"(\\d+)\\s*apples\\s*and\\s*(\\d+)\\s*oranges\"\n    \n    # Search for the pattern in the input string.\n    # As per critical requirements, assume the match is always successful.\n    match = re.search(FRUIT_PATTERN, s)\n    \n    # Extract apple and orange counts, converting them to integers.\n    # As per critical requirements, trust inputs and do not raise exceptions.\n    apples = int(match.group(1))\n    oranges = int(match.group(2))\n    \n    # Calculate the number of mangoes.\n    # As per critical requirements, do not raise exceptions for impossible scenarios.\n    mangoes = n - apples - oranges\n    \n    return mangoes"}
{"task_id": "HumanEval/71", "solution": "import math\ndef triangle_area(a, b, c):\n    \"\"\"\n    Calculates the area of a triangle given its three side lengths.\n    Returns the rounded area or -1 if the sides do not form a valid triangle.\n    \"\"\"\n    # Validate if the sides form a valid triangle\n    if not (a > 0 and b > 0 and c > 0):\n        return -1\n    if not (a + b > c and a + c > b and b + c > a):\n        return -1\n\n    # Calculate the semi-perimeter\n    s = (a + b + c) / 2\n\n    # Apply Heron's formula\n    area_squared = s * (s - a) * (s - b) * (s - c)\n    \n    # Handle potential floating-point inaccuracies where area_squared might be slightly negative\n    if area_squared < 0:\n        area_squared = 0.0\n        \n    area = math.sqrt(area_squared)\n\n    # Round the area to two decimal places\n    return round(area, 2)"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Sorts a list of integers in a min-max-min-max alternating pattern.\n    It repeatedly takes the minimum, then the maximum of the remaining elements, and so on.\n    '''\n    if not lst:\n        return []\n\n    sorted_list = sorted(lst)\n    result = []\n    left, right = 0, len(sorted_list) - 1\n    is_min_turn = True\n\n    while left <= right:\n        if is_min_turn:\n            result.append(sorted_list[left])\n            left += 1\n        else:\n            result.append(sorted_list[right])\n            right -= 1\n        is_min_turn = not is_min_turn\n    return result"}
{"task_id": "HumanEval/72", "solution": "def _is_palindrome(q):\n    \"\"\"\n    Checks if a list is a palindrome.\n    Compares the list with its reversed version.\n    \"\"\"\n    return q == q[::-1]\ndef will_it_fly(q, w):\n    \"\"\"\n    Determines if the object q will fly.\n    An object flies if it is a palindromic list and its total weight is within limits.\n    \"\"\"\n    if not _is_palindrome(q):\n        return False\n\n    total_weight = sum(q)\n    if total_weight > w:\n        return False\n\n    return True"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst: list[int]) -> list[int]:\n    \"\"\"Sorts a list of integers into a strange alternating min-max order.\n    Starts with the minimum, then maximum of the remaining, then minimum, and so on.\n    \"\"\"\n    if not lst:\n        return []\n\n    # Create a sorted copy of the input list.\n    # This list will be modified by pop operations.\n    sorted_copy = sorted(lst)\n    result = []\n    is_min_turn = True\n\n    # Alternate taking the minimum and maximum remaining elements.\n    while sorted_copy:\n        if is_min_turn:\n            # Remove and append the smallest element.\n            element = sorted_copy.pop(0)\n        else:\n            # Remove and append the largest element.\n            element = sorted_copy.pop()\n        result.append(element)\n        is_min_turn = not is_min_turn\n            \n    return result"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    \"\"\"\n    Returns True if the object q will fly, and False otherwise.\n    An object flies if it's balanced (a palindromic list) and its total weight (sum of elements)\n    is less than or equal to the maximum allowed weight w.\n    \"\"\"\n    is_balanced = (q == q[::-1])\n    total_weight = sum(q)\n    is_within_weight_limit = (total_weight <= w)\n    \n    return is_balanced and is_within_weight_limit"}
{"task_id": "HumanEval/71", "solution": "import math\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater \n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    '''\n    # Check if all side lengths are positive and satisfy the triangle inequality.\n    if not (a > 0 and b > 0 and c > 0 and\n            a + b > c and a + c > b and b + c > a):\n        return -1.0\n\n    # Calculate the semi-perimeter and then the area using Heron's formula.\n    s = (a + b + c) / 2\n    area = math.sqrt(s * (s - a) * (s - b) * (s - c))\n    \n    # Round the calculated area to two decimal places.\n    return round(area, 2)"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic.\n    \"\"\"\n    n = len(arr)\n    # An array with 0 or 1 element is always palindromic.\n    if n <= 1:\n        return 0\n\n    changes_count = 0\n    left_ptr = 0\n    right_ptr = n - 1\n\n    # Compare elements from both ends and increment count for each mismatch.\n    while left_ptr < right_ptr:\n        if arr[left_ptr] != arr[right_ptr]:\n            changes_count += 1\n        left_ptr += 1\n        right_ptr -= 1\n    return changes_count"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic.\n    \"\"\"\n    n = len(arr)\n    changes = 0\n    left = 0\n    right = n - 1\n\n    while left < right:\n        if arr[left] != arr[right]:\n            changes += 1\n        left += 1\n        right -= 1\n    return changes"}
