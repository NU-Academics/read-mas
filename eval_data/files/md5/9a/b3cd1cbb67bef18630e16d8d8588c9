{"task_id": "HumanEval/91", "solution": "def is_bored(S):\n    \"\"\"\n    Counts the number of sentences that start with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    boredom_count = 0\n\n    # Replace sentence delimiters with a unique marker for splitting.\n    temp_text = S.replace('.', '|').replace('?', '|').replace('!', '|')\n    # Split the text into potential sentences, stripping whitespace and filtering empty strings.\n    sentences = [s.strip() for s in temp_text.split('|') if s.strip()]\n\n    for sentence in sentences:\n        cleaned_sentence = sentence.strip()\n        # A sentence is a \"boredom\" if it starts with \"I \" or is just \"I\".\n        if cleaned_sentence.startswith(\"I \") or cleaned_sentence == \"I\":\n            boredom_count += 1\n            \n    return boredom_count"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    \"\"\"\n    Checks if one of the numbers is equal to the sum of the other two.\n    As per the problem statement, a True result implies all inputs are integers.\n    \"\"\"\n    return (x == y + z) or \\\n           (y == x + z) or \\\n           (z == x + y)"}
{"task_id": "HumanEval/91", "solution": "import re\ndef is_bored(S: str) -> int:\n    \"\"\"\n    Counts the number of boredoms in a string.\n    A boredom is a sentence that starts with the word \"I\".\n    \"\"\"\n\n    class SentenceSplitter:\n        # Splits text into sentences using '.', '?', '!' as delimiters.\n        def split(self, text: str) -> list[str]:\n            # Use regex to split by one or more occurrences of '.', '?', or '!'\n            sentences = re.split(r'[.?!]+', text)\n            # Strip whitespace from each sentence and filter out any empty results.\n            return [s.strip() for s in sentences if s.strip()]\n\n    class WordChecker:\n        # Determines if a sentence starts with the word \"I\".\n        def starts_with_i(self, sentence: str) -> bool:\n            cleaned_sentence = sentence.strip()\n            if not cleaned_sentence:\n                return False\n            \n            # Use regex to find the first word (alphanumeric sequence) in the sentence.\n            # \\b ensures word boundaries, matching the first actual word and skipping leading punctuation.\n            match = re.search(r'\\b(\\w+)\\b', cleaned_sentence)\n            if match:\n                first_word = match.group(1)\n                return first_word == \"I\"\n            return False\n\n    class BoredomCounterService:\n        # Orchestrates sentence splitting and boredom checking.\n        def __init__(self, sentence_splitter: SentenceSplitter, word_checker: WordChecker):\n            self._sentence_splitter = sentence_splitter\n            self._word_checker = word_checker\n\n        def count_boredoms(self, text: str) -> int:\n            sentences = self._sentence_splitter.split(text)\n            boredom_count = 0\n            for sentence in sentences:\n                if self._word_checker.starts_with_i(sentence):\n                    boredom_count += 1\n            return boredom_count\n\n    # Initialize and execute the boredom counting process.\n    sentence_splitter = SentenceSplitter()\n    word_checker = WordChecker()\n    boredom_service = BoredomCounterService(sentence_splitter, word_checker)\n    \n    return boredom_service.count_boredoms(S)"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Write a function that takes a message, and encodes in such a\n    way that it swaps case of all letters, replaces all vowels in\n    the message with the letter that appears 2 places ahead of that\n    vowel in the english alphabet.\n    Assume only letters.\n\n    Examples:\n    >>> encode('test')\n    'TGST'\n    >>> encode('This is a message')\n    'tHKS KS C MGSSCGG'\n    \"\"\"\n    VOWELS_LOWERCASE = \"aeiou\"\n    VOWELS_UPPERCASE = \"AEIOU\"\n    ALPHABET_LOWERCASE = \"abcdefghijklmnopqrstuvwxyz\"\n    ALPHABET_UPPERCASE = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"\n\n    encoded_chars = []\n    for char in message:\n        # Step 1: Swap case of letters; non-letters remain unchanged.\n        if char.isalpha():\n            swapped_char = char.swapcase()\n        else:\n            swapped_char = char\n\n        # Step 2: Replace vowels if applicable, based on the swapped character.\n        is_vowel_flag = False\n        if swapped_char.islower() and swapped_char in VOWELS_LOWERCASE:\n            is_vowel_flag = True\n        elif swapped_char.isupper() and swapped_char in VOWELS_UPPERCASE:\n            is_vowel_flag = True\n\n        if is_vowel_flag:\n            # Find the character two places ahead, preserving case and wrapping around.\n            if swapped_char.islower():\n                alphabet = ALPHABET_LOWERCASE\n            else: # It must be an uppercase vowel.\n                alphabet = ALPHABET_UPPERCASE\n\n            index = alphabet.index(swapped_char)\n            new_index = (index + 2) % len(alphabet)\n            replaced_char = alphabet[new_index]\n            encoded_chars.append(replaced_char)\n        else:\n            # If not a vowel, or not a letter, append the character as it is (after case swap).\n            encoded_chars.append(swapped_char)\n\n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/94", "solution": "import math\ndef is_prime(n: int) -> bool:\n    \"\"\"Checks if a non-negative integer is a prime number.\n    It optimizes by checking divisibility only up to the square root of n.\n    \"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        if n % i == 0:\n            return False\n    return True\ndef find_largest_prime(numbers: list[int]) -> int | None:\n    \"\"\"Finds the largest prime number within a list of integers.\n    Returns None if no prime numbers are found in the list.\n    \"\"\"\n    largest_prime = None\n    for num in numbers:\n        if is_prime(num):\n            if largest_prime is None or num > largest_prime:\n                largest_prime = num\n    return largest_prime\ndef sum_digits(n: int) -> int:\n    \"\"\"Calculates the sum of the digits of a non-negative integer.\n    It processes digits by repeatedly taking the remainder and performing integer division.\n    \"\"\"\n    s = 0\n    while n > 0:\n        s += n % 10\n        n //= 10\n    return s\ndef skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n    largest_prime = find_largest_prime(lst)\n    if largest_prime is None:\n        return 0\n    return sum_digits(largest_prime)"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst: list[int]) -> int:\n    \"\"\"Finds the largest prime in a list and returns the sum of its digits.\n    Returns 0 if no primes are found.\"\"\"\n\n    def _is_prime_local(n: int) -> bool:\n        \"\"\"Checks if an integer n is a prime number. Handles positive integers only.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def _sum_digits_local(n: int) -> int:\n        \"\"\"Calculates the sum of the absolute value of digits of an integer n.\"\"\"\n        s = 0\n        n = abs(n)\n        while n > 0:\n            s += n % 10\n            n //= 10\n        return s\n\n    largest_prime = 0\n    for num in lst:\n        if _is_prime_local(num):\n            if num > largest_prime:\n                largest_prime = num\n    \n    if largest_prime > 0:\n        return _sum_digits_local(largest_prime)\n    return 0"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by swapping letter case and replacing vowels.\n    Vowels are replaced by the letter two places ahead in the alphabet, preserving case.\n    \"\"\"\n    VOWELS_SET = {'a', 'e', 'i', 'o', 'u'}\n    ALPHABET_LOWER = \"abcdefghijklmnopqrstuvwxyz\"\n    ALPHABET_UPPER = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"\n\n    encoded_chars = []\n\n    for char in message:\n        swapped_char = char\n\n        # Step 1: Swap case of alphabetic characters (FR1)\n        if 'a' <= char <= 'z':\n            swapped_char = char.upper()\n        elif 'A' <= char <= 'Z':\n            swapped_char = char.lower()\n        # Non-alphabetic characters remain unchanged by default `swapped_char = char`\n\n        # Step 2: Replace vowels in the *swapped* character (FR2)\n        if swapped_char.lower() in VOWELS_SET:\n            if 'a' <= swapped_char <= 'z':\n                idx = ALPHABET_LOWER.find(swapped_char)\n                swapped_char = ALPHABET_LOWER[(idx + 2) % len(ALPHABET_LOWER)]\n            elif 'A' <= swapped_char <= 'Z':\n                idx = ALPHABET_UPPER.find(swapped_char)\n                swapped_char = ALPHABET_UPPER[(idx + 2) % len(ALPHABET_UPPER)]\n            # If a character somehow passes `VOWELS_SET` check but isn't in alphabet, it's preserved.\n\n        encoded_chars.append(swapped_char)\n\n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dictionary):\n    \"\"\"\n    Checks if all keys in a dictionary are consistently cased (all lowercase or all uppercase).\n    Returns False for empty dictionaries or mixed casing.\n    \"\"\"\n    if not dictionary:\n        return False\n\n    all_keys_are_lowercase = True\n    all_keys_are_uppercase = True\n    \n    for key in dictionary.keys():\n        # Critical requirements forbid isinstance() checks.\n        # This function assumes all keys are strings; non-string keys will raise an AttributeError.\n        if not key.islower():\n            all_keys_are_lowercase = False\n        \n        if not key.isupper():\n            all_keys_are_uppercase = False\n        \n    return all_keys_are_lowercase or all_keys_are_uppercase"}
{"task_id": "HumanEval/97", "solution": "def multiply(a, b):\n    \"\"\"\n    Calculates the product of the unit digits of two integers.\n    The unit digit is obtained by taking the absolute value modulo 10.\n    \"\"\"\n    unit_digit_a = abs(a) % 10\n    unit_digit_b = abs(b) % 10\n    return unit_digit_a * unit_digit_b"}
{"task_id": "HumanEval/97", "solution": "def multiply(a, b):\n    \"\"\"Complete the function that takes two integers and returns \n    the product of their unit digits.\n    Assume the input is always valid.\n    Examples:\n    multiply(148, 412) should return 16.\n    multiply(19, 28) should return 72.\n    multiply(2020, 1851) should return 0.\n    multiply(14,-15) should return 20.\n    \"\"\"\n    unit_digit_a = abs(a) % 10\n    unit_digit_b = abs(b) % 10\n    return unit_digit_a * unit_digit_b"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower\n    case or all keys are strings in upper case, else return False.\n    \"\"\"\n    if not dict:\n        return False\n\n    all_lower = True\n    all_upper = True\n\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False\n        \n        # Check if all keys are consistently lowercase or uppercase\n        if not key.islower():\n            all_lower = False\n        if not key.isupper():\n            all_upper = False\n\n    return all_lower or all_upper"}
{"task_id": "HumanEval/96", "solution": "import math\ndef count_up_to(n):\n    \"\"\"Calculates and returns a list of all prime numbers strictly less than n.\n    Utilizes a nested helper function for primality testing.\"\"\"\n\n    if n <= 2:\n        return []\n\n    def is_prime(num):\n        \"\"\"Determines if a given integer num is a prime number.\"\"\"\n        if num <= 1:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(num)) + 1, 2):\n            if num % i == 0:\n                return False\n        return True\n\n    primes = []\n    for i in range(2, n):\n        if is_prime(i):\n            primes.append(i)\n    return primes"}
