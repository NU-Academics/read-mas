{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n    \"\"\"\n\n    def _standard_factorial(k):\n        # Calculates the standard factorial of a positive integer k.\n        # This is an inline helper function for special_factorial.\n        res = 1\n        for i_fact in range(1, k + 1):\n            res *= i_fact\n        return res\n\n    special_fact_result = 1\n    for i in range(1, n + 1):\n        special_fact_result *= _standard_factorial(i)\n    \n    return special_fact_result"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers.\n    Returns True if n meets the criteria, False otherwise.\n    \"\"\"\n    # A number must be even and greater than or equal to 8 (2+2+2+2) to meet the criteria.\n    return n % 2 == 0 and n >= 8"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    \"\"\"\n    Checks if a string of square brackets contains a contiguous substring that is a valid\n    bracket sequence with a nesting depth greater than 1.\n    \"\"\"\n\n    def is_valid_bracket_sequence(s):\n        \"\"\"Checks if the given string 's' is a valid bracket sequence.\"\"\"\n        stack = []\n        for char in s:\n            if char == '[':\n                stack.append(char)\n            elif char == ']':\n                if not stack:\n                    return False\n                stack.pop()\n        return not stack\n\n    def get_max_nesting_depth(s):\n        \"\"\"Calculates the maximum nesting depth for a valid bracket sequence 's'.\"\"\"\n        max_depth = 0\n        current_depth = 0\n        for char in s:\n            if char == '[':\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif char == ']':\n                current_depth -= 1\n        return max_depth\n\n    n = len(string)\n    for i in range(n):\n        for j in range(i, n):\n            sub = string[i : j + 1]\n            if is_valid_bracket_sequence(sub):\n                if get_max_nesting_depth(sub) > 1:\n                    return True\n    return False"}
{"task_id": "HumanEval/139", "solution": "def _calculate_standard_factorial(k):\n    \"\"\"Calculates the standard factorial of a positive integer k.\"\"\"\n    result = 1\n    for i in range(1, k + 1):\n        result *= i\n    return result\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    special_fact_result = 1\n    for i in range(1, n + 1):\n        current_factorial = _calculate_standard_factorial(i)\n        special_fact_result *= current_factorial\n    return special_fact_result"}
{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores, \n    and if a string has more than 2 consecutive spaces, \n    then replace all consecutive spaces with - \n    \n    fix_spaces(\"Example\") == \"Example\"\n    fix_spaces(\"Example 1\") == \"Example_1\"\n    fix_spaces(\" Example 2\") == \"_Example_2\"\n    fix_spaces(\" Example   3\") == \"_Example-3\"\n    \"\"\"\n    # First, replace sequences of 3 or more spaces with a single hyphen.\n    # This step is crucial before handling single spaces to correctly apply the rules.\n    text = re.sub(r' {3,}', '-', text)\n    \n    # Then, replace all remaining single spaces with underscores.\n    # This handles original single spaces and also sequences of exactly two spaces.\n    text = text.replace(' ', '_')\n    \n    return text"}
{"task_id": "HumanEval/137", "solution": "def _to_float(value):\n    \"\"\"\n    Converts a value to its float representation, handling comma decimal separators.\n    This function processes int, float, and string inputs uniformly.\n    \"\"\"\n    return float(str(value).replace(',', '.'))\ndef compare_one(a, b):\n    \"\"\"\n    Compares two real numbers (int, float, or string) and returns the larger original value.\n    Returns None if the numerical values are equal, supporting comma or dot decimals in strings.\n    \"\"\"\n    original_a = a\n    original_b = b\n\n    float_a = _to_float(a)\n    float_b = _to_float(b)\n\n    if float_a > float_b:\n        return original_a\n    elif float_b > float_a:\n        return original_b\n    else: # float_a == float_b\n        return None"}
{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text: str) -> str:\n    \"\"\"\n    Replaces single spaces with underscores and sequences of three or more spaces with a hyphen.\n    This ensures consistent text formatting according to defined rules.\n    \"\"\"\n    # First, replace sequences of 3 or more spaces with a single hyphen.\n    # This must happen before replacing single spaces to avoid incorrect transformations.\n    processed_text = re.sub(r' {3,}', '-', text)\n    \n    # Then, replace all remaining single spaces with underscores.\n    processed_text = processed_text.replace(' ', '_')\n    \n    return processed_text"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"\n    Checks if a file's name is valid based on specific criteria.\n    Returns 'Yes' if valid, 'No' otherwise.\n    \"\"\"\n    digit_count = 0\n    for char in file_name:\n        if char.isdigit():\n            digit_count += 1\n    if digit_count > 3:\n        return 'No'\n\n    if file_name.count('.') != 1:\n        return 'No'\n\n    parts = file_name.split('.')\n    prefix = parts[0]\n    extension = parts[1]\n\n    if not prefix or not prefix[0].isalpha():\n        return 'No'\n\n    allowed_extensions = ['txt', 'exe', 'dll']\n    if extension not in allowed_extensions:\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/137", "solution": "def compare_one(a, b):\n    \"\"\"\n    Compares two values and returns the larger one in its original type.\n    Returns None if the values are numerically equal.\n    \"\"\"\n\n    # Inline helper function for converting values to a comparable float.\n    # This handles string representations that use a comma as a decimal separator.\n    def _to_float_numeric(value):\n        string_repr = str(value)\n        normalized_string = string_repr.replace(',', '.')\n        return float(normalized_string)\n\n    numeric_a = _to_float_numeric(a)\n    numeric_b = _to_float_numeric(b)\n\n    if numeric_a > numeric_b:\n        return a\n    elif numeric_b > numeric_a:\n        return b\n    else:  # numeric_a == numeric_b\n        return None"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    \"\"\"\n    \n    VALID_EXTENSIONS = ['txt', 'exe', 'dll']\n\n    # Rule: The file's name contains exactly one dot '.'\n    if file_name.count('.') != 1:\n        return 'No'\n\n    parts = file_name.rsplit('.', 1)\n    prefix = parts[0]\n    suffix = parts[1]\n\n    # Rule: The substring before the dot should not be empty, and it starts with a letter.\n    if not prefix or not prefix[0].isalpha():\n        return 'No'\n\n    # Rule: The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    if suffix not in VALID_EXTENSIONS:\n        return 'No'\n\n    # Rule: There should not be more than three digits ('0'-'9') in the file's name.\n    digit_count = sum(1 for char in file_name if char.isdigit())\n    if digit_count > 3:\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a \n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not \n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries. \n    \"\"\"\n    total_sum = 0\n    for i, num in enumerate(lst):\n        if i % 3 == 0:\n            total_sum += num * num\n        elif i % 4 == 0: \n            total_sum += num * num * num\n        else:\n            total_sum += num\n    return total_sum"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\"\n    This function takes a list of integers and returns the sum of its elements\n    after applying conditional transformations based on their indices.\n    \"\"\"\n    total_sum = 0\n    for i, num in enumerate(lst):\n        if i % 3 == 0:\n            total_sum += num * num\n        elif i % 4 == 0:\n            total_sum += num * num * num\n        else:\n            total_sum += num\n    return total_sum"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Filters words from a sentence, returning only those with prime lengths.\n    Words are separated by spaces, and their original order is maintained.\n    \"\"\"\n\n    class PrimeChecker:\n        \"\"\"\n        Utility to efficiently check if a number is prime using memoization.\n        It caches results for previously checked numbers.\n        \"\"\"\n        def __init__(self):\n            self.memo = {0: False, 1: False, 2: True, 3: True}\n\n        def is_prime(self, n: int) -> bool:\n            \"\"\"\n            Determines if a given integer n is a prime number.\n            Uses memoization to avoid recomputing for the same number.\n            \"\"\"\n            if n in self.memo:\n                return self.memo[n]\n            if n < 2 or n % 2 == 0:\n                self.memo[n] = False\n                return False\n            i = 3\n            while i * i <= n:\n                if n % i == 0:\n                    self.memo[n] = False\n                    return False\n                i += 2\n            self.memo[n] = True\n            return True\n\n    # Instantiate the PrimeChecker locally within the function scope.\n    prime_checker = PrimeChecker()\n\n    # Split the sentence into individual words.\n    words = sentence.split(' ')\n    filtered_words = []\n\n    # Iterate through each word, check its length for primality, and collect if prime.\n    for word in words:\n        if prime_checker.is_prime(len(word)):\n            filtered_words.append(word)\n\n    # Join the collected words back into a single space-separated string.\n    return ' '.join(filtered_words)"}
{"task_id": "HumanEval/145", "solution": "def _calculate_digit_sum(num: int) -> int:\n    \"\"\"\n    Calculates the sum of the absolute digits of an integer.\n    For example, _calculate_digit_sum(-12) returns 3.\n    \"\"\"\n    s = 0\n    num_abs = abs(num)\n    if num_abs == 0:\n        return 0\n    while num_abs > 0:\n        s += num_abs % 10\n        num_abs //= 10\n    return s\ndef order_by_points(nums):\n    \"\"\"\n    Sorts the given list of integers in ascending order according to the sum of their digits.\n    If there are several items with similar sum of their digits,\n    order them based on their index in the original list.\n    \"\"\"\n    decorated_list = []\n    for i, num in enumerate(nums):\n        sum_digits = _calculate_digit_sum(num)\n        decorated_list.append((sum_digits, i, num))\n\n    decorated_list.sort()\n\n    return [item[2] for item in decorated_list]"}
{"task_id": "HumanEval/144", "solution": "class Fraction:\n    def __init__(self, numerator: int, denominator: int):\n        self._numerator = numerator\n        self._denominator = denominator\n\n    @property\n    def numerator(self) -> int:\n        return self._numerator\n\n    @property\n    def denominator(self) -> int:\n        return self._denominator\n\n    def multiply(self, other: 'Fraction') -> 'Fraction':\n        new_numerator = self.numerator * other.numerator\n        new_denominator = self.denominator * other.denominator\n        return Fraction(new_numerator, new_denominator)\n\n    def is_whole_number(self) -> bool:\n        return self.numerator % self.denominator == 0\n\n    def __str__(self) -> str:\n        return f\"{self.numerator}/{self.denominator}\"\n\n    def __repr__(self) -> str:\n        return f\"Fraction({self.numerator}, {self.denominator})\"\nclass FractionParser:\n    def parse(self, fraction_str: str) -> Fraction:\n        # Parses a string \"numerator/denominator\" into a Fraction object.\n        # Assumes valid string format with positive integer parts.\n        parts = fraction_str.split('/')\n        numerator = int(parts[0])\n        denominator = int(parts[1])\n        return Fraction(numerator, denominator)\ndef simplify(x: str, n: str) -> bool:\n    \"\"\"\n    Determines if the product of two fractions (x * n) is a whole number.\n    Assumes valid fraction string inputs as \"numerator/denominator\" with positive integers.\n    \"\"\"\n    parser = FractionParser()\n    fraction_x = parser.parse(x)\n    fraction_n = parser.parse(n)\n    product = fraction_x.multiply(fraction_n)\n    return product.is_whole_number()"}
{"task_id": "HumanEval/144", "solution": "import math\ndef simplify(x, n):\n    \"\"\"This function determines if the product of two fractions is a whole number.\n    It parses fraction strings, multiplies them, and checks the product.\n    \"\"\"\n\n    class Fraction:\n        def __init__(self, numerator: int, denominator: int):\n            self.numerator = numerator\n            self.denominator = denominator\n\n        def __str__(self) -> str:\n            return f\"{self.numerator}/{self.denominator}\"\n\n        def __repr__(self) -> str:\n            return f\"Fraction({self.numerator}, {self.denominator})\"\n\n        def __eq__(self, other: object) -> bool:\n            # Compares two Fraction objects for equality using cross-multiplication.\n            return self.numerator * other.denominator == other.numerator * self.denominator\n\n    class FractionParser:\n        @staticmethod\n        def parse(fraction_str: str) -> Fraction:\n            # Parses a string \"num/den\" into a Fraction object.\n            parts = fraction_str.split('/')\n            numerator = int(parts[0])\n            denominator = int(parts[1])\n            return Fraction(numerator, denominator)\n\n    class FractionCalculator:\n        @staticmethod\n        def _gcd(a: int, b: int) -> int:\n            # Calculates the greatest common divisor of two integers.\n            return math.gcd(a, b)\n\n        @staticmethod\n        def multiply(f1: Fraction, f2: Fraction) -> Fraction:\n            # Multiplies two Fraction objects to get their product.\n            new_numerator = f1.numerator * f2.numerator\n            new_denominator = f1.denominator * f2.denominator\n            return Fraction(new_numerator, new_denominator)\n\n        @staticmethod\n        def is_whole_number(f: Fraction) -> bool:\n            # Checks if a fraction is a whole number after simplification.\n            common_divisor = FractionCalculator._gcd(f.numerator, f.denominator)\n            simplified_denominator = f.denominator // common_divisor\n            return simplified_denominator == 1\n\n    # Main orchestration logic\n    parser = FractionParser()\n    calculator = FractionCalculator()\n\n    fraction_x = parser.parse(x)\n    fraction_n = parser.parse(n)\n    \n    product = calculator.multiply(fraction_x, fraction_n)\n    \n    return calculator.is_whole_number(product)"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"\n    Filters a list of numbers based on specific criteria and returns a count.\n    Counts numbers greater than 10 with odd first and last digits.\n    \"\"\"\n\n    def is_odd(digit: int) -> bool:\n        \"\"\"Checks if a given digit is odd.\"\"\"\n        return digit in (1, 3, 5, 7, 9)\n\n    def get_first_digit(num: int) -> int:\n        \"\"\"Extracts the first digit of an integer using its absolute value.\"\"\"\n        num_str = str(abs(num))\n        return int(num_str[0])\n\n    def get_last_digit(num: int) -> int:\n        \"\"\"Extracts the last digit of an integer using its absolute value.\"\"\"\n        num_str = str(abs(num))\n        return int(num_str[-1])\n\n    count = 0\n    for num in nums:\n        if num > 10:\n            first_digit = get_first_digit(num)\n            last_digit = get_last_digit(num)\n            if is_odd(first_digit) and is_odd(last_digit):\n                count += 1\n    return count"}
{"task_id": "HumanEval/143", "solution": "_primes_cache = {}\ndef is_prime(number: int) -> bool:\n    \"\"\"Checks if a number is prime, using a cache for efficiency.\"\"\"\n    if number in _primes_cache:\n        return _primes_cache[number]\n\n    if number < 2:\n        _primes_cache[number] = False\n        return False\n    for i in range(2, int(number**0.5) + 1):\n        if number % i == 0:\n            _primes_cache[number] = False\n            return False\n    _primes_cache[number] = True\n    return True\ndef words_in_sentence(sentence: str) -> str:\n    \"\"\"\n    Filters words from a sentence, returning only those with prime lengths.\n    Maintains the original order of words.\n    \"\"\"\n    words = sentence.split(' ')\n    filtered_words = []\n    for word in words:\n        if is_prime(len(word)):\n            filtered_words.append(word)\n    return ' '.join(filtered_words)"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"This function counts numbers greater than 10 whose first and last digits are odd.\n    It processes a list of integers, applying these criteria to each number.\"\"\"\n    count = 0\n    for num in nums:\n        if num > 10:\n            abs_num_str = str(abs(num))\n            \n            first_digit = int(abs_num_str[0])\n            is_first_digit_odd = first_digit % 2 != 0\n            \n            last_digit = int(abs_num_str[-1])\n            is_last_digit_odd = last_digit % 2 != 0\n            \n            if is_first_digit_odd and is_last_digit_odd:\n                count += 1\n    return count"}
{"task_id": "HumanEval/145", "solution": "from typing import List\ndef order_by_points(nums: List[int]) -> List[int]:\n    \"\"\"Sorts a list of integers by their digit sum, then by original index for ties.\n    Handles positive, negative, and zero integers correctly.\"\"\"\n\n    def calculate_digit_sum(n: int) -> int:\n        \"\"\"Calculates the sum of the absolute value of digits for an integer.\"\"\"\n        if n == 0:\n            return 0\n        return sum(int(digit) for digit in str(abs(n)))\n\n    if not nums:\n        return []\n\n    # Each item stores (original_value, digit_sum, original_index).\n    items_to_sort: List[tuple[int, int, int]] = []\n    for i, num in enumerate(nums):\n        digit_sum = calculate_digit_sum(num)\n        items_to_sort.append((num, digit_sum, i))\n\n    # Sort primarily by digit_sum (index 1), secondarily by original_index (index 2).\n    sorted_items = sorted(items_to_sort, key=lambda item: (item[1], item[2]))\n\n    # Extract and return the original values from the sorted items.\n    return [item[0] for item in sorted_items]"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Counts triples (a[i], a[j], a[k]) from a generated array whose sum is a multiple of 3.\n    Applies a combinatorial approach using remainders modulo 3 for efficiency.\n    \"\"\"\n    if n < 3:\n        return 0\n\n    array_a = [i * i - i + 1 for i in range(1, n + 1)]\n\n    counts_mod_3 = [0, 0, 0]\n    for x in array_a:\n        counts_mod_3[x % 3] += 1\n\n    c0, c1, c2 = counts_mod_3\n    count = 0\n\n    # Case 1: (0, 0, 0) - sum is 0 (mod 3)\n    if c0 >= 3:\n        count += (c0 * (c0 - 1) * (c0 - 2)) // 6\n\n    # Case 2: (1, 1, 1) - sum is 3 (mod 3) = 0 (mod 3)\n    if c1 >= 3:\n        count += (c1 * (c1 - 1) * (c1 - 2)) // 6\n\n    # Case 3: (2, 2, 2) - sum is 6 (mod 3) = 0 (mod 3)\n    if c2 >= 3:\n        count += (c2 * (c2 - 1) * (c2 - 2)) // 6\n\n    # Case 4: (0, 1, 2) - sum is 3 (mod 3) = 0 (mod 3)\n    count += c0 * c1 * c2\n\n    return count"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Filters a list of strings by even length and sorts them.\n    Strings are sorted primarily by length ascending, then alphabetically.\n    \"\"\"\n    filtered_list = []\n    for s in lst:\n        if len(s) % 2 == 0:\n            filtered_list.append(s)\n\n    sorted_result = sorted(filtered_list, key=lambda s: (len(s), s))\n\n    return sorted_result"}
