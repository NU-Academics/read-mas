   Uses a modified Kadane's algorithm to track the minimum subarray sum ending at each position.\n\n    Raises:\n        ValueError: if nums is empty.\n    \"\"\"\n    if not nums:\n        raise ValueError(\"nums must be a non-empty list\")\n\n    current_min = min_so_far = nums[0]\n    for num in nums[1:]:\n        current_min = min(num, current_min + num)\n        min_so_far = min(min_so_far, current_min)\n\n    return min_so_far", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/115": [{"task_id": "HumanEval/115", "solution": "def max_fill(grid, capacity):\n    \"\"\"\n    Calculate the total number of times buckets must be lowered to empty all wells.\n\n    Args:\n        grid: Iterable of iterables representing rows; each element is 0 or 1.\n        capacity: int, bucket capacity (must be >= 1).\n\n    Returns:\n        int: total number of bucket lowers required.\n    \"\"\"\n    if capacity < 1:\n        raise ValueError(\"capacity must be >= 1\")\n\n    total_lowers = 0\n    for row in grid:\n        if row is None:\n            continue\n        water_units = 0\n        for cell in row:\n            if cell == 1:\n                water_units += 1\n        if water_units:\n            total_lowers += (water_units + capacity - 1) // capacity\n\n    return total_lowers", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/115", "solution": "def max_fill(grid, capacity):\n    \"\"\"\n    Calculate the total number of times buckets must be lowered to remove all water units.\n    Each row in `grid` is a well; each 1 is one unit of water. Each well has a bucket of\n    the same integer `capacity`. Uses integer arithmetic.\n\n    Args:\n        grid (list[list[int]]): 2D list of 0/1 values.\n        capacity (int): Positive integer bucket capacity.\n\n    Returns:\n        int: Total number of bucket lowerings required.\n\n    Raises:\n        TypeError: If input types are incorrect.\n        ValueError: If values are out of expected ranges.\n    \"\"\"\n    # Basic input validation\n    if not isinstance(grid, list):\n        raise TypeError(\"grid must be a list of lists\")\n    if not isinstance(capacity, int) or capacity <= 0:\n        raise ValueError(\"capacity must be a positive integer\")\n\n    total_lowerings = 0\n    for row in grid:\n        if not isinstance(row, list):\n            raise TypeError(\"grid must be a 2D list (list of lists)\")\n        # Sum units in the well while validating entries\n        water_in_well = 0\n        for cell in row:\n            if cell not in (0, 1):\n                raise ValueError(\"grid cells must be 0 or 1\")\n            water_in_well += cell\n        if water_in_well:\n            # Integer ceiling division: (water + capacity - 1) // capacity\n            total_lowerings += (water_in_well + capacity - 1) // capacity\n\n    return total_lowerings", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/119": [{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    s1, s2 = lst[0], lst[1]\n\n    def is_good(s):\n        bal = 0\n        for ch in s:\n            if ch == '(':\n                bal += 1\n            else:\n                bal -= 1\n            if bal < 0:\n                return False\n        return bal == 0\n\n    return 'Yes' if is_good(s1 + s2) or is_good(s2 + s1) else 'No'", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    \"\"\"\n    Checks if concatenating two strings in either order yields a balanced parentheses string.\n    A string is balanced if its prefix counts never drop below zero and the total balance is zero.\n    \"\"\"\n    def is_balanced(s):\n        \"\"\"\n        Helper function to determine if a given parentheses string 's' is balanced.\n  