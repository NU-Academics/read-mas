"\"\n    if not words:\n        return \"\"\n    best_word = None\n    best_count = -1\n    for word in words:\n        unique_count = len(set(word))\n        if unique_count > best_count:\n            best_count = unique_count\n            best_word = word\n        elif unique_count == best_count:\n            if word < best_word:\n                best_word = word\n    return best_word if best_word is not None else \"\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/160": [{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and\n    the second list is a list of integers. Use the two given lists to build the algebric\n    expression and return the evaluation of this expression.\n    \"\"\"\n    # Validation\n    if not isinstance(operator, (list, tuple)):\n        raise ValueError(\"operator must be a list or tuple\")\n    if not isinstance(operand, (list, tuple)):\n        raise ValueError(\"operand must be a list or tuple\")\n    if len(operand) < 2 or len(operator) < 1:\n        raise ValueError(\"operand must have at least 2 items and operator at least 1\")\n    if len(operator) != len(operand) - 1:\n        raise ValueError(\"operator and operand lists lengths are incompatible\")\n\n    # Allowed operators\n    allowed_ops = {'+', '-', '*', '//', '**'}\n    for op in operator:\n        if op not in allowed_ops:\n            raise ValueError(f\"Invalid operator: {op}\")\n    for v in operand:\n        if not isinstance(v, int) or v < 0:\n            raise ValueError(\"Operands must be non-negative integers\")\n\n    # Precedence and associativity\n    precedence = {'**': 3, '*': 2, '//': 2, '+': 1, '-': 1}\n    associativity = {'**': 'right', '*': 'left', '//': 'left', '+': 'left', '-': 'left'}\n\n    # Operator implementations\n    def apply_op(op, a, b):\n        if op == '+':\n            return a + b\n        if op == '-':\n            return a - b\n        if op == '*':\n            return a * b\n        if op == '//':\n            if b == 0:\n                raise ZeroDivisionError(\"integer division by zero\")\n            return a // b\n        if op == '**':\n            return a ** b\n        raise ValueError(f\"Unsupported operator: {op}\")\n\n    # Build token sequence: operand0, op0, operand1, op1, ...\n    tokens = []\n    for i in range(len(operand)):\n        tokens.append(operand[i])\n        if i < len(operator):\n            tokens.append(operator[i])\n\n    # Shunting-yard to produce RPN\n    op_stack = []\n    output_queue = []\n\n    for token in tokens:\n        if isinstance(token, int):\n            output_queue.append(token)\n        else:\n            o1 = token\n            while op_stack:\n                o2 = op_stack[-1]\n                if ((associativity[o1] == 'left' and precedence[o1] <= precedence[o2]) or\n                        (associativity[o1] == 'right' and precedence[o1] < precedence[o2])):\n                    output_queue.append(op_stack.pop())\n                else:\n                    break\n            op_stack.append(o1)\n\n    while op_stack:\n        output_queue.append(op_stack.pop())\n\n    # Evaluate RPN\n    eval_stack = []\n    for token in output_queue:\n        if isinstance(token, int):\n            eval_stack.append(token)\n        else:\n            b = eval_stack.pop()\n            a = eval_stack.pop()\n            eval_stack.append(apply_op(token, a, b))\n\n    return eval_stack[0]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator and operand, build and evaluate the algebraic expression\n    defined by interleaving operands with operators, respecting operator precedence\n    and associativity.\n\n    Operators supported: '+', '-', '*', '//', '**'\n    \"\"\"\n    # Validation\n    if not isinstance(operator, (list, tuple)) or not isinstance(operand, (list, tuple)):\n        raise TypeError(\"operator and operand must be lists or tuples\")\n    if len(operator) != len(operand) - 1:\n        raise ValueError(\"Length of operator list must be exactly one less than operand list\")\n    allowed_ops = {'+', '-', '*', '//', '**'}\n    for op in operator:\n        if op not in allowed_ops:\n            raise ValueError(f\"Unsupported operator: {op}\")\n\n    def precedence(op):\n        if op == '**':\n            return 3\n        if op in ('*', '//'):\n            return 2\n        if op in ('+', '-'):\n            return 1\n        return 0\n\n    def is_right_associative(op):\n        return op == '**'\n\n    def apply_op(op, a, b):\n        if op == '+':\n            return a + b\n        if op == '-':\n            return a - b\n        if op == '*':\n            return a * b\n        if op == '//':\n            if b == 0:\n                raise ZeroDivisionError(\"integer division by zero\")\n            return a // b\n        if op == '**':\n            return a ** b\n        raise ValueError(f\"Unsupported operator: {op}\")\n\n    # Two-stack evaluation\n    operand_stack = []\n    operator_stack = []\n\n    # push first operand\n    operand_stack.append(operand[0])\n\n    for i, op in enumerate(operator):\n        cur_operand = operand[i + 1]\n        # While there is an operator on the stack with greater precedence, or equal precedence\n        # and the current operator is left-associative, apply the top operator first.\n        while operator_stack:\n            top_op = operator_stack[-1]\n            if (precedence(top_op) > precedence(op)) or (\n                precedence(top_op) == precedence(op) and not is_right_associative(op)\n            ):\n                operator_stack.pop()\n                b = operand_stack.pop()\n                a = operand_stack.pop()\n                operand_stack.append(apply_op(top_op, a, b))\n            else:\n                break\n\n        operator_stack.append(op)\n        operand_stack.append(cur_operand)\n\n    # Apply remaining operators\n    while operator_stack:\n        top_op = operator_stack.pop()\n        b = operand_stack.pop()\n        a = operand_stack.pop()\n        operand_stack.append(apply_op(top_op, a, b))\n\n    return operand_stack[0]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/161": [{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"Reverses letter case or reverses the string if no letters are present.\n    Non-letter characters remain unchanged in case-reversal mode.\"\"\"\n\n    contains_letters = any(char.isalpha() for char in s)\n\n    if contains_letters:\n        return \"\".join(char.swapcase() if char.isalpha() else char for char in s)\n    else:\n        return s[::-1]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"\n    Reverses the case of letters in a string; otherwise, reverses the whole string if no letters.\n    Returns the modified string.\n    \"\"\"\n    has_letters = False\n    for char in s:\n        if char.isalpha():\n            has_letters = True\n            break\n\n    if has_letters:\n        modified_chars = []\n        for char in s:\n            if char.isalpha():\n                if char.islower():\n                    modified_chars.append(char.upper())\n                else:\n                    modified_chars.append(char.lower())\n            else:\n                modified_chars.append(char)\n        return \"\".join(modified_chars)\n    else:\n        return s[::-1]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/162": [{"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_t