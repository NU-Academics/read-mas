or large n using matrix exponentiation (O(log n) multiplications).\n    Uses a small-n iterative fallback to avoid overhead.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 1\n\n    # Small-n iterative fallback (low overhead)\n    if n < 30:\n        a, b, c = 0, 0, 1\n        for _ in range(3, n + 1):\n            a, b, c = b, c, a + b + c\n        return c\n\n    # Matrix exponentiation for O(log n) performance.\n    # Companion matrix M such that:\n    # [f(n)  ]   [1 1 1] [f(n-1)]\n    # [f(n-1)] = [1 0 0] [f(n-2)]\n    # [f(n-2)]   [0 1 0] [f(n-3)]\n    def mul_mat(A, B):\n        # Multiply two 3x3 matrices.\n        return [\n            [\n                A[0][0] * B[0][0] + A[0][1] * B[1][0] + A[0][2] * B[2][0],\n                A[0][0] * B[0][1] + A[0][1] * B[1][1] + A[0][2] * B[2][1],\n                A[0][0] * B[0][2] + A[0][1] * B[1][2] + A[0][2] * B[2][2],\n            ],\n            [\n                A[1][0] * B[0][0] + A[1][1] * B[1][0] + A[1][2] * B[2][0],\n                A[1][0] * B[0][1] + A[1][1] * B[1][1] + A[1][2] * B[2][1],\n                A[1][0] * B[0][2] + A[1][1] * B[1][2] + A[1][2] * B[2][2],\n            ],\n            [\n                A[2][0] * B[0][0] + A[2][1] * B[1][0] + A[2][2] * B[2][0],\n                A[2][0] * B[0][1] + A[2][1] * B[1][1] + A[2][2] * B[2][1],\n                A[2][0] * B[0][2] + A[2][1] * B[1][2] + A[2][2] * B[2][2],\n            ],\n        ]\n\n    def mat_pow(M, exp):\n        # Exponentiation by squaring for 3x3 matrix\n        # Start with identity\n        result = [[1, 0, 0], [0, 1, 0], [0, 0, 1]]\n        base = M\n        while exp > 0:\n            if exp & 1:\n                result = mul_mat(result, base)\n            base = mul_mat(base, base)\n            exp >>= 1\n        return result\n\n    M = [[1, 1, 1],\n         [1, 0, 0],\n         [0, 1, 0]]\n\n    # 