ation\n    dataset = Dataset(numbers)\n\n    calculator = MeanAbsoluteDeviationCalculator()\n    mad_value = calculator.compute_mad(dataset)\n\n    # Wrap the computed value in a Result object as per design, then return its value\n    final_result = Result(mad_value)\n    return final_result.mad", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/8": [{"task_id": "HumanEval/8", "solution": "def sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    total_sum = 0\n    total_product = 1\n    for num in numbers:\n        total_sum += num\n        total_product *= num\n    return (total_sum, total_product)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/13": [{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    def _euclidean_gcd(x: int, y: int) -> int:\n        \"\"\"Helper function to compute the GCD using the Euclidean algorithm.\"\"\"\n        while y:\n            x, y = y, x % y\n        return x\n\n    # The greatest common divisor is typically defined as a positive integer.\n    # We take the absolute values of the inputs before applying the Euclidean algorithm.\n    return _euclidean_gcd(abs(a), abs(b))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/12": [{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    >>> longest([])\n\n    >>> longest(['a', 'b', 'c'])\n    'a'\n    >>> longest(['a', 'bb', 'ccc'])\n    'ccc'\n    \"\"\"\n    if not strings:\n        return None\n\n    # Initialize with the first string to handle tie-breaking correctly by returning the first occurrence.\n    current_longest_string = strings[0]\n    max_length = len(strings[0])\n\n    # Iterate from the second string onwards to find a potentially longer string.\n    for s in strings[1:]:\n        if len(s) > max_length:\n            max_length = len(s)\n            current_longest_string = s\n            \n    return current_longest_string", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/9": [{"task_id": "HumanEval/9", "solution": "from typing import List, Tuple\nclass InputList:\n    def __init__(self, elements: List[int]) -> None:\n        self.elements: List[int] = elements\nclass OutputList:\n    def __init__(self, elements: List[int]) -> None:\n        self.elements: List[int] = elements\nclass MaxTracker:\n    def __init__(self) -> None:\n        self._current_max: int | None = None\n\n    def update(self, value: int) -> None:\n        if self._current_max is None or value > self._current_max:\n            self._current_max = value\n\n    def get(self) -> int:\n        assert self._current_max is not None\n        return self._current_max\nclass RollingMaxService:\n    def rolling_max(self, numbers: List[int]) -> List[int]:\n        input_holder = InputList(elements=numbers)\n        output_holder = OutputList(elements=[])\n        tracker = MaxTracker()\n\n        for v in input_holder.elements:\n            tracker.update(v)\n            output_holder.elements.append(tracker.get())\n\n        return list(output_holder.elements)\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    service = RollingMaxService()\n    return service.rolling_max(numbers)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/11": [{"task_id": "HumanEval/11", "solution": "from typing import List\nclass BinaryString:\n    \"\"\"A value object representing a binary string.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the binary string.\"\"\"\n        return len(self.value)\n\n    def is_binary(self) -> bool:\n        \"\"\"Checks if the string consists only of '0' and '1'.\"\"\"\n        return all(c in '01' for c in self.value)\nclass ValidationResult:\n    \"\"\"A value object for storing validation outcomes.\"\"\"\n    def __init__(self, is_valid: bool, errors: List[str]):\n        self.is_valid = is_valid\n        self.errors = errors\nclass Validator:\n    \"\"\"Encapsulates input validation logic.\"\"\"\n    def validate(self, a: BinaryString, b: BinaryString) -> ValidationResult:\n        \"\"\"Validates two BinaryString objects for binary content and equal length.\"\"\"\n        errors: List[str] = []\n        if not a.is_binary():\n            errors.append(f\"Input 'a' contains non-binary characters: '{a.value}'\")\n        if not b.is_binary():\n            errors.append(f\"Input 'b' contains non-binary characters: '{b.value}'\")\n        \n        # Only check length if they are both binary, otherwise the above errors are more fundamental.\n        # This order is consistent with typical validation flow.\n        if not errors and a.length() != b.length():\n            errors.append(f\"Inputs have unequal length: {a.length()} != {b.length()}\")\n            \n        return ValidationResult(not bool(errors), errors)\nclass XORProcessor:\n    \"\"\"Encapsulates XOR computation logic.\"\"\"\n    def compute(self, a: BinaryString, b: BinaryString) -> str:\n        \"\"\"Performs bitwise XOR on two BinaryString objects.\"\"\"\n        result_bits: List[str] = []\n        for i in range(a.length()):\n            bit_a = int(a.value[i])\n            bit_b = int(b.value[i])\n            xor_result = bit_a ^ bit_b\n            result_bits.append(str(xor_result))\n        return \"\".join(result_bits)\ndef _join_errors(errors: List[str]) -> str:\n    \"\"\"Joins a list of error messages into a single string.\"\"\"\n    return \"; \".join(errors)\nclass StringXorService:\n    \"\"\"Coordinates validation and XOR processing.\"\"\"\n    def __init__(self):\n        self._validator = Validator()\n        self._processor = XORProcessor()\n\n    def string_xor(self, a: str, b: str) -> str:\n        \"\"\"Validates inputs and performs binary XOR, raising ValueError on invalid input.\"\"\"\n        a_bin = BinaryString(a)\n        b_bin = BinaryString(b)\n\n        validation_result = self._validator.validate(a_bin, b_bin)\n\n        if not validation_result.is_valid:\n            raise ValueError(_join_errors(validation_result.errors))\n\n        return self._processor.compute(a_bin, b_bin)\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    service = StringXorService()\n    return service.string_xor(a, b)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/14": [{"task_id": "HumanEval/14", "solution": "from typing import List\ndef all_prefixes(string: str) -> List[str]:\n    \"\"\" Return list of all prefixes from shortest to longest of the input string\n    >>> all_prefixes('abc')\n    ['a', 'ab',