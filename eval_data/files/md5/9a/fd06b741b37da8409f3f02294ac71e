def apply(self, input: 'InputArray', criteria: 'FilterCriteria') -> int:\n        result = Result(count=0)\n\n        for num_value in input.numbers:\n            number_obj = Number(num_value)\n            if criteria.matches(number_obj):\n                result.count += 1\n        return result.count\ndef specialFilter(nums):\n    \"\"\"Write a function that takes an array of numbers as input and returns \n    the number of elements in the array that are greater than 10 and both \n    first and last digits of a number are odd (1, 3, 5, 7, 9).\n    For example:\n    specialFilter([15, -73, 14, -15]) => 1 \n    specialFilter([33, -2, -3, 45, 21, 109]) => 2\n    \"\"\"\n    input_array = InputArray(numbers=nums)\n    criteria = FilterCriteria()\n    domain_service = DomainSpecialFilter()\n    return domain_service.apply(input_array, criteria)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/147": [{"task_id": "HumanEval/147", "solution": "from typing import List, Dict\nclass Input:\n    def __init__(self, n: int):\n        self.n = n\n\n    def validate(self) -> bool:\n        \"\"\"Return True if n is an integer and n >= 1; otherwise False.\"\"\"\n        return (isinstance(self.n, int) and self.n >= 1)\nclass ArrayElement:\n    def __init__(self, index: int, value: int, residue: int) -> None:\n        self.index = index\n        self.value = value\n        self.residue = residue\nclass Array:\n    def __init__(self, elements: List[ArrayElement]):\n        self.elements = elements\n\n    @classmethod\n    def construct(cls, n: int) -> 'Array':\n        \"\"\"Constructs an Array of ArrayElement instances for i=1 to n.\"\"\"\n        elements = []\n        for i in range(1, n + 1):\n            value = i * i - i + 1\n            residue = value % 3\n            elements.append(ArrayElement(i, value, residue))\n        return cls(elements)\nclass ResidueCounter:\n    def countResidues(self, array: Array) -> Dict