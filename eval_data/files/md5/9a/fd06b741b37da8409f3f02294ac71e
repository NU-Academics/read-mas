     current_depth -= 1\n        return max_depth\n\n    def __repr__(self) -> str:\n        return f\"ParenthesisGroup(content='{self.content}', order={self.order}, nestingDepth={self.nestingDepth})\"\nclass Validator:\n    \"\"\"Validates normalized string for allowed characters and top-level balance.\"\"\"\n    def validate_chars(self, s: str) -> bool:\n        \"\"\"Returns True if the string contains only '(' and ')', False otherwise.\"\"\"\n        return all(char in '()' for char in s)\n\n    def validate_balanced_top_level(self, s: str) -> bool:\n        \"\"\"Returns True if the string is a valid concatenation of balanced groups (never negative balance, ends at zero).\"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\nclass Parser:\n    \"\"\"Scans a validated normalized string and extracts top-level balanced parenthesis groups.\"\"\"\n    def parse(self, s: str) -> List[ParenthesisGroup]:\n        \"\"\"Extracts top-level balanced groups into ParenthesisGroup objects.\"\"\"\n        groups: List[ParenthesisGroup] = []\n        balance = 0\n        group_start_index = -1\n        group_order = 0\n\n        for i, char in enumerate(s):\n            if char == '(':\n                balance += 1\n                if balance == 1:  # Transition from 0 to 1, start of a new top-level group\n                    group_start_index = i\n            elif char == ')':\n                balance -= 1\n\n            if balance == 0 and group_start_index != -1:\n                # Balance returned to 0, end of a top-level group\n                group_order += 1\n                group_content = s[group_start_index : i + 1]\n                groups.append(ParenthesisGroup(group_content, group_order))\n                group_start_index = -1  # Reset for the next group\n\n        return groups\nclass OutputList:\n    \"\"\"Converts ParenthesisGroup instances to the final List[str] output.\"\"\"\n    def __init__(self, groups: List[ParenthesisGroup]):\n        self.groups = groups\n\n    def as_list(self) -> List[str]:\n        \"\"\"Returns a list of content strings from the ParenthesisGroup objects.\"\"\"\n        return [group.content for group in self.groups]\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Separates multiple groups of nested parentheses into a list of separate strings.\n    Each returned string is a balanced group with nesting preserved and no whitespace.\n    \"\"\"\n    input_obj = InputString(raw=paren_string)\n    normalized = input_obj.normalize()\n\n    validator = Validator()\n    if not validator.validate_chars(normalized):\n        raise ValueError(\"Input contains invalid characters; only '(' , ')' and whitespace allowed.\")\n    if not validator.validate_balanced_top_level(normalized):\n        raise ValueError(\"Input contains unbalanced top-level parenthesis groups.\")\n\n    parser = Parser()\n    groups_data = parser.parse(normalized)  # List[ParenthesisGroup]\n\n    output_list_formatter = OutputList(groups_data)\n    return output_list_formatter.as_list()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/2": [{"task_id": "HumanEval/2", "solution": "import math\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    # Use math.modf to get the fractional part of the number.\n    # math.modf returns a tuple (fractional_part, integer_part).\n    decimal_part, _ = math.modf(number)\n    return decimal_part", "base_status": "pass", "plus_s