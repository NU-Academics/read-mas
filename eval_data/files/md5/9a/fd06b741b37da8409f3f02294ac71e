n                break\n        \n        return trimmed_text[:first_space_idx]\n\n    def startsWithI(self) -> bool:\n        \"\"\"Determines if the sentence starts with the exact word 'I' (case-sensitive).\"\"\"\n        return self.firstToken() == \"I\"\nDELIMITERS: tuple[str, ...] = ('.', '?', '!')\nclass BoredomCounter:\n    \"\"\"Application service for splitting and counting boredoms.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def is_bored(self, S: InputString) -> int:\n        \"\"\"Coordinates sentence splitting and boredom counting for an InputString.\"\"\"\n        sentences = self.splitIntoSentences(S)\n        return self.count(sentences)\n\n    def splitIntoSentences(self, S: InputString) -> list[Sentence]:\n        \"\"\"Splits an InputString into Sentence objects based on defined delimiters.\"\"\"\n        sentences = []\n        start_index = 0\n        content_length = S.length()\n\n        for i in range(content_length):\n            if S.content[i] in DELIMITERS:\n                fragment_text = S.content[start_index:i]\n                if fragment_text.strip():\n                    sentences.append(Sentence(fragment_text))\n                start_index = i + 1\n        \n        final_fragment_text = S.content[start_index:]\n        if final_fragment_text.strip():\n            sentences.append(Sentence(final_fragment_text))\n            \n        return sentences\n\n    def count(self, sentences: list[Sentence]) -> int:\n        \"\"\"Counts sentences that start with 'I' from a list of Sentence objects.\"\"\"\n        boredoms = 0\n        for sentence in sentences:\n            if sentence.startsWithI():\n                boredoms += 1\n        return boredoms\ndef is_bored(S):\n    \"\"\"\n    Counts the number of \"boredoms\" in a string.\n    A boredom is a sentence that starts with the word \"I\".\n    \"\"\"\n    input_string = InputString(content=S)\n    counter = BoredomCounter()\n    return counter.is_bored(input_string)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["I"]]}], "HumanEval/92": [{"task_id": "HumanEval/92", "solution": "class IntegerValidator:\n    \"\"\"Determines if a value is an integer based on specific rules.\"\"\"\n    def is_integer(self, value) -> bool:\n        # Booleans are explicitly treated as non-integers per design\n        if isinstance(value, bool):\n            return False\n        # Regular integers\n        if isinstance(value, int):\n            return True\n        # Floats that represent whole numbers are considered integers\n        if isinstance(value, float):\n            return value == int(value)\n        # All other types are not considered integers\n        return False\nclass InputValue:\n    \"\"\"Data model for a single input value.\"\"\"\n    def __init__(self, raw_value):\n        self.raw_value = raw_value\n        self.inferred_type = type(raw_value)\n        self.is_integer = False # To be set by IntegerValidator\nclass Result:\n    \"\"\"Data model representing the boolean outcome.\"\"\"\n    def __init__(self, value: bool):\n        self.value = value\n\n    def as_bool(self) -> bool:\n        return self.value\nclass AnyIntFunction:\n    \"\"\"Orchestrates validation and sum checking.\"\"\"\n    def __init__(self, validator: IntegerValidator):\n        self._validator = validator\n\n    def any_int(self, x, y, z) -> Result:\n        # Create InputValue objects and validate them\n        input_x = InputValue(x)\n        input_y = InputValue(y)\n        input_z = InputValue(z)\n\n        input_x.is_integer = self._validator.is_integer(input_x.raw_value)\n        input_y.is_integer = self._validator.is_integer(input_y.raw_value)\n        input_z.is_integer = self._validator.is_integer(input_z.raw_value)\n\n        # Early return if any input is not an integer\n        if not (input_x.is_integer and input_y.is_integer and input_z.is_integer):\n            return Result(False)\n\n        # All inputs are integers, now check the sum condition\n        x_val = input_x.raw_value\n        y_val = input_y.raw_value\n        z_val = input_z.raw_value\n\n        condition1 = x_val == y_val + z_val\n        condition2 = y_val == x_val + z_val\n        condition3 = z_val == x_val + y_val\n\n        if condition1 or condition2 or condition3:\n            return Result(True)\n        else:\n            return Result(False)\ndef any_int(x, y, z):\n    \"\"\"\n    Checks if one of the numbers is the sum of the other two, and all are integers.\n    \"\"\"\n    validator = IntegerValidator()\n    interactor = AnyIntFunction(validator)\n    result_obj = interactor.any_int(x, y, z)\n    return result_obj.as_bool()", "base_status": "fail", "plus_status": "pass", "base_fail_tests": [[3.0, 4, 7]], "plus_fail_tests": []}], "HumanEval/93": [{"task_id": "HumanEval/93", "solution": "class Message:\n    def __init__(self, text: str):\n        self.text = text\n    def length(self) -> int:\n        return len(self.text)\nclass EncodedMessage:\n    def __init__(self, text: str):\n        self.text = text\n    def length(self) -> int:\n        return len(self.text)\nclass VowelMapper:\n    def __init__(self):\n        self.mapping: dict = {'a':'c','e':'g','i':'k','o':'q','u':'w'}\n        self.mappingUpper: dict = {'A':'C','E':'G','I':'K','O':'Q','U':'W'}\n    \n    def map(self, v: str) -> str:\n        \"\"\"For lowercase vowel returns mapped lowercase char; otherwise returns input unchanged.\"\"\"\n        return self.mapping.get(v, v)\n    \n    def mapUpper(self, v: str) -> str:\n        \"\"\"For uppercase vowel returns mapped uppercase char; otherwise returns input unchanged.\"\"\"\n        return self.mappingUpper.get(v, v)\nclass Encoder:\n    def __init__(self):\n        self.vowelMapper: VowelMapper = VowelMapper()\n    \n    def swapCase(self, s: str) -> str:\n        \"\"\"Swap case of every alphabetic character in s, preserving non-letters unchanged.\"\"\"\n        result = []\n        for char in s:\n            if 'a' <= char <= 'z':\n                result.append(char.upper())\n            elif 'A' <= char <= 'Z':\n                result.append(char.lower())\n            else:\n                result.append(char)\n        return \"\".join(result)\n    \n    def replaceVowels(self, s: str) -> str:\n        \"\"\"For each character in s, replace vowels using vowelMapper.map / mapUpper and copy non-letters unchanged.\"\"\"\n        result = []\n        for char in s:\n            if 'a' <= char <= 'z':\n                mapped_char = self.vowelMapper.map(char)\n                result.append(mapped_char)\n            elif 'A' <= char <= 'Z':\n                mapped_char = self.vowelMapper.mapUpper(char)\n                result.append(mapped_char)\n            else:\n                result.append(char)\n        return \"\".join(result)\n    \n    def encode(self, message: str) -> str:\n        \"\"\"Primary API method on the class; orchestrates Message creation, swapCase, replaceVowels, and returns encoded string.\"\"\"\n        input_message_obj = Message(text=message)\n        \n        swapped_case_message = self.swapCase(input_message_obj.text)\n        encoded_message_text = self.replaceVowels(swapped_case_message)\n        \n        output_message_obj = EncodedMessage(text=encoded_message_text)\n        \n        return output_message_obj.text\ndef encode(message):\n    \"\"\"\n    Write a function that takes a message, and encodes in such a \n    way that it swaps case of all letters, replaces all vowels in \n    the message with the letter that appears 2 places ahead of that \n    vowel in the english alphabet. \n    Assume only letters. \n    \n    Examples:\n    >>> encode('test')\n    'TGST'\n    >>> encode('This is a message')\n    'tHKS KS C MGSSCGG'\n    \"\"\"\n    return Encoder().encode(message)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/97": [{"task_id": "HumanEval/97", "solution": "def multiply(a, b):\n    \"\"\"Complete the function that takes two integers and returns \n    the product of their unit digits.\n    Assume the input is always valid.\n    Examples:\n    multiply(148, 412) should return 16.\n    multiply(19, 28) should return 72.\n    multiply(2020, 1851) should return 0.\n    multiply(14,-15) should return 20.\n    \"\"\"\n    unit_a = abs(a) % 10\n    unit_b = abs(b) % 10\n    return unit_a * unit_b", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/95": [{"task_id": "HumanEval/95", "solution": "class Key:\n    \"\"\"Encapsulates raw key and provides case-checking methods.\"\"\"\n    def __init__(self, raw_key: object) -> None:\n        self.text = raw_key\n\n    def is_string(self) -> bool:\n        \"\"\"Returns True if the key is a string.\"\"\"\n        return isinstance(self.text, str)\n\n    def is_lower(self) -> bool:\n        \"\"\"Returns True if the key is a string and all characters are lowercase.\"\"\"\n        return self.is_string() and self.text.islower()\n\n    def is_upper(self) -> bool:\n        \"\"\"Returns True if the key is a string and all characters are uppercase.\"\"\"\n        return self.is_string() and self.text.isupper()\nclass Value:\n    \"\"\"Holds raw value; not used in decision logic.\"\"\"\n    def __init__(self, raw_value: object) -> None:\n        self.data = raw_value\nclass KeyValue:\n    \"\"\"Encapsulates a key/value pair using Key and Value wrappers.\"\"\"\n    def __init__(self, key_raw: object, value_raw: object) -> None:\n        self.key = Key(key_raw)\n        self.value = Value(value_raw)\nclass DictionaryInput:\n    \"\"\"Adapter around a Python dict with helper methods for size and emptiness.\"\"\"\n    def __init__(self, input_dict: dict) -> None:\n        self.items = [KeyValue(k, v) for k, v in input_dict.items()]\n\n    def size(self) -> int:\n        \"\"\"Returns the number of items