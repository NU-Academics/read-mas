ce.\n\n    idx1_open = -1\n    for i in range(n):\n        if string[i] == '[':\n            idx1_open = i\n            break\n    if idx1_open == -1 or idx1_open > n - 4:\n        return False\n\n    idx2_open = -1\n    for i in range(idx1_open + 1, n):\n        if string[i] == '[':\n            idx2_open = i\n            break\n    if idx2_open == -1 or idx2_open > n - 3:\n        return False\n\n    idx1_close = -1\n    for i in range(idx2_open + 1, n):\n        if string[i] == ']':\n            idx1_close = i\n            break\n    if idx1_close == -1 or idx1_close > n - 2:\n        return False\n\n    idx2_close = -1\n    for i in range(idx1_close + 1, n):\n        if string[i] == ']':\n            idx2_close = i\n            break\n    if idx2_close == -1:\n        return False\n\n    return True", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["[][][]"]]}], "HumanEval/138": [{"task_id": "HumanEval/138", "solution": "class Number:\n    \"\"\"Represents a numeric value with properties like evenness and positivity.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def isEven(self) -> bool:\n        \"\"\"Checks if the number is even.\"\"\"\n        return self.value % 2 == 0\n\n    def isPositive(self) -> bool:\n        \"\"\"Checks if the number is positive.\"\"\"\n        return self.value > 0\nclass Validator:\n    \"\"\"Validates raw input to ensure it's an integer-like numeric type.\"\"\"\n    def validate(self, n) -> bool:\n        \"\"\"Returns True if n is an integer or a float representing an integer.\"\"\"\n        if isinstance(n, int):\n            return True\n        if isinstance(n, float):\n            return n == int(n)\n        return False\nclass Evaluator:\n    \"\"\"Evaluates if a Number meets the criteria for being a sum of 4 positive even numbers.\"\"\"\n    def minPossibleSum(self) -> int:\n        \"\"\"Returns the minimum possible sum of 4 positive even numbers.\"\"\"\n        return 8 # 2 + 2 + 2 + 2\n\n    def evaluate(self, number: Number) -> bool:\n        \"\"\"Returns True if the number is even and greater than or equal to the minimum possible sum.\"\"\"\n        return number.isEven() and number.value >= self.minPossibleSum()\ndef is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers.\"\"\"\n    validator = Validator()\n    if not validator.validate(n):\n        return False\n\n    number = Number(int(n))\n    evaluator = Evaluator()\n    return evaluator.evaluate(number)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/137": [{"task_id": "HumanEval/137", "solution": "class Parser:\n    def parse_string(self, s: str) -> float:\n        \"\"\"Parses a string allowing '.' or ',' as decimal separator.\"\"\"\n        s = str(s).replace(',', '.')\n        return float(s)\nclass InputValue:\n    def __init__(self, original_value):\n        \"\"\"Wraps an input value, preserving its original form and providing numeric conversion.\"\"\"\n        self.original_value = original_value\n        self.original_type = type(original_value).__name__\n        self.original_representation = str(original_value)\n        self._numeric_cache = None\n\n    def is_string(self) -> bool:\n        \"\"\"Checks if the original value is a string.\"\"\"\n        return isinstance(self.original_value, str)\n\n    def to_numeric(self) -> float:\n        \"\"\"Converts the original value to a float, using Parser for strings.\"\"\"\n        if self._numeric_cache is not None:\n            return self._numeric_cache\n\n        if self.is_string():\n            parser = Parser()\n            self._numeric_cache = parser.parse_string(self.original_value)\n        else:\n            self._numeric_cache = float(self.original_value)\n        return self._numeric_cache\nclass CompareOneEngine:\n    def compare(self, a: InputValue, b: InputValue) -> InputValue | None:\n        \"\"\"Compares two InputValue objects numerically and returns the larger, or None if equal.\"\"\"\n        a_numeric = a.to_numeric()\n        b_numeric = b.to_numeric()\n\n        if a_numeric > b_numeric:\n            return a\n        elif b_numeric > a_numeric:\n            return b\n        else:\n            return None\ndef compare_one(a, b):\n    \"\"\"\n    Create a function that takes integers, floats, or strings representing\n    real numbers, and returns the larger variable in its given variable type.\n    Return None if the values are equal.\n    Note: If a real number is represented as a string, the floating point might be . or ,\n    \"\"\"\n    a_input = InputValue(a)\n    b_input = InputValue(b)\n    engine = CompareOneEngine()\n    winner_input = engine.compare(a_input, b_input)\n    if winner_input is None:\n        return None\n    return winner_input.original_value", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/141": [{"task_id": "HumanEval/141", "solution": "from typing import List, Optional\nclass FileName:\n    \"\"\"Domain entity holding raw input, parsed prefix/extension, dot_count, and digit_count.\"\"\"\n    def __init__(self, raw: str) -> None:\n        self.raw = raw\n        self.prefix = ''\n        self.extension = ''\n        self.dot_count = self.raw.count('.')\n        self.digit_count = sum(1 for char in self.raw if char.isdigit())\n\n    def parse(self) -> None:\n        \"\"\"Parses the raw file name into prefix and extension if exactly one dot exists.\"\"\"\n        if self.dot_count == 1:\n            parts = self.raw.split('.', 1)\n            self.prefix = parts[0]\n            self.extension = parts[1]\n        # If dot_count != 1, prefix and extension remain empty as initialized.\nclass ValidationResult:\n    \"\"\"Value object representing validation outcome and optional failure reasons.\"\"\"\n    def __init__(self, is_valid: bool, reasons: List[str] = None) -> None:\n        self.is_valid = is_valid\n        self.reasons = reasons if reasons is not None else []\nclass Validator:\n    \"\"\"Domain service implementing business rules for file name validation.\"\"\"\n    ALLOWED_EXTENSIONS = {'txt', 'exe', 'dll'}\n\n    def has_exactly_one_dot(self, f: FileName) -> bool:\n        \"\"\"Checks if the file name contains exactly one dot.\"\"\"\n        return f.dot_count == 1\n\n    def prefix_non_empty(self, f: FileName) -> bool:\n        \"\"\"Checks if the substring before the dot is not empty.\"\"\"\n        return f.prefix != ''\n\n    def prefix_starts_with_latin_letter(self, f: FileName) -> bool:\n        \"\"\"Checks if the substring before the dot starts with a latin alphabet letter.\"\"\"\n        return bool(f.prefix) and f.prefix[0].isalpha()\n\n    def extension_allowed(self, f: FileName) -> bool:\n        \"\"\"Checks if the substring after the dot is one of the allowed extensions.\"\"\"\n        return f.extension in self.ALLOWED_EXTENSIONS\n\n    def digit_count_at_most_three(self, f: FileName) -> bool:\n        \"\"\"Checks if there are not more than three digits in the file's name.\"\"\"\n        return f.digit_count <= 3\n\n    def validate(self, f: FileName) -> ValidationResult:\n        \"\"\"Validates the FileName object against all defined business rules.\"\"\"\n        reasons = []\n\n        if not self.digit_count_at_most_three(f):\n            reasons.append(\"File name should not have more than three digits.\")\n\n        if not self.has_exactly_one_dot(f):\n            reasons.append(\"File name must contain exactly one dot.\")\n        \n        # These checks depend on prefix/extension being correctly parsed.\n        # If dot_count is not 1, prefix/extension will be empty, causing these checks to fail.\n        if not self.prefix_non_empty(f):\n            reasons.append(\"The substring before the dot should not be empty.\")\n        elif not self.prefix_starts_with_latin_letter(f):\n            reasons.append(\"The substring before the dot must start with a latin alphabet letter.\")\n\n        if not self.extension_allowed(f):\n            reasons.append(\"The substring after the dot should be one of ['txt', 'exe', 'dll'].\")\n\n        is_valid = not bool(reasons)\n        return ValidationResult(is_valid, reasons)\ndef file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions \n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n    - The file's name contains exactly one dot '.'\n    - The substring before the dot should not be empty, and it starts with a letter from \n    the latin alphapet ('a'-'z' and 'A'-'Z').\n    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    Examples:\n    file_name_check(\"example.txt\") # => 'Yes'\n    file_name_check(\"1example.dll\") # => 'No' (the name should start with a latin alphapet letter)\n    \"\"\"\n    f = FileName(file_name)\n    f.parse()\n\n    validator = Validator()\n    result = validator.validate(f)\n\n    return 'Yes' if result.is_valid else 'No'", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/140": [{"task_id": "HumanEval/140", "solution": "from typing import List\nclass InputString:\n    \"\"\"Encapsulates the input string value; exposes length() and hasSpaces() for ASCII space detection.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        return len(self.value)\n\n    def hasSpaces(self) -> bool:\n        return ' ' in self.value\nclass SpaceSequence:\n    \"\"\"Represents a contiguous run of ASCII spaces.\"\"\"\n    def __init__(self, startIndex: int, length: int):\n        self.startIndex = startIndex\n        self.length = length\n\n    def isConsecutive(self) -> bool:\n        # A SpaceSequence by design represents a run, thus its length is always >= 1.\n        return self.length >= 1\nclass ReplacementRule:\n    \"\"\"Represents a trigger pattern and replacement string; determines applicability to a SpaceSequence.\"\"\"\n    def __init__(self, triggerPattern: str, replacement: str):\n        self.triggerPattern = triggerPattern\n        self.replacement = replacement\n\n    def appliesTo(self, seq: SpaceSequence) -> bool:\n        if self.triggerPattern == 'run_ge_3':\n            return seq.length >= 3\n        elif self.triggerPattern == 'run_2':\n            return seq.length == 2\n        elif self.triggerPattern == 'run_1':\n            return seq.length == 1\n        return False\nclass OutputString:\n    \"\"\"Holds the transformed string result.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        return len(self.value)\nclass Transformer:\n    \"\"\"Identifies contiguous ASCII-space sequences and applies ReplacementRule instances to produce an OutputString.\"\"\"\n    def __init__(self):\n        self.replacement_rules: List[ReplacementRule] = [\n            ReplacementRule('run_ge_3', '-'),\n            ReplacementRule('run_2', '__'),\n            ReplacementRule('run_1', '_')\n        ]\n\n    def identifySpaceSequences(self, inp: InputString) -> List[SpaceSequence]:\n        sequences = []\n        in_space_run = False\n        current_start = -1\n        current_length = 0\n        input_value = inp.value\n\n        for i, char in enumerate(input_value):\n            if char == ' ':\n                if not in_space_run:\n                    current_start = i\n                    in_space_run = True\n                current_length += 1\n            else:\n                if in_space_run:\n                    sequences.append(SpaceSequence(current_start, current_length))\n                    in_space_run = False\n                    current_length = 0\n        \n        if in_space_run: # Handle trailing spaces\n            sequences.append(SpaceSequence(current_start, current_length))\n\n        return sequences\n\n    def applyRules(self, inp: InputString) -> OutputString:\n        if not inp.hasSpaces():\n            return OutputString(inp.value)\n\n        space_sequences = self.identifySpaceSequences(inp)\n        result_parts = []\n        last_index = 0\n\n        for seq in space_sequences:\n            # Append non-space part before the current sequence\n            if seq.startIndex > last_index:\n                result_parts.append(inp.value[last_index : seq.startIndex])\n            \n            # Find the applicable replacement rule and append its replacement\n            applicable_rule = None\n            for rule in self.replacement_rules:\n                if rule.appliesTo(seq):\n                    applicable_rule = rule\n                    break\n            \n            if applicable_rule: # Rules are exhaustive for space sequences\n                result_parts.append(applicable_rule.replacement)\n\n            last_index = seq.startIndex + seq.length\n        \n        # Append any remaining non-space part after the last sequence\n        if last_index < inp.length():\n            result_parts.append(inp.value[last_index:])\n\n        assembled_string = \"\".join(result_parts)\n        return OutputString(assembled_string)\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores, \n    and if a string has more than 2 consecutive spaces, \n    then replace all consecutive spaces with - \n    \"\"\"\n    input_string = InputString(value=text)\n    transformer = Transformer()\n    output_string = transformer.applyRules(input_string)\n    return output_string.value", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/142": [{"task_id": "HumanEval/142", "solution": "def _square(value: int) -> int:\n    \"\"\"Helper to square an integer.\"\"\"\n    return value * value\ndef _cube(value: int) -> int:\n    \"\"\"Helper to cube an integer.\"\"\"\n    return value * value * value\nclass TransformationRule:\n    \"\"\"Encapsulates a single transformation operation.\"\"\"\n    def __init__(self, name: str, precedence: int, operation_func):\n        self.name = name\n        self.precedence = precedence\n        self._operation_func = operation_func\n\n    def apply(self, value: int) -> int:\n        \"\"\"Applies the stored operation function to the given value.\"\"\"\n        return self._operation_func(value)\nclass Element:\n    \"\"\"Holds an element's index, original value, and transformed value.\"\"\"\n    def __init__(self, index: int, original_value: int):\n        self.index = index\n        self.originalValue = original_value\n        self.transformedValue = original_value\n\n    def apply_transformed(self, value: int):\n        \"\"\"Sets the transformed value for this element.\"\"\"\n        self.transformedValue = value\nclass InputList:\n    \"\"\"Represents the input list as a collection of Element objects.\"\"\"\n    def __init__(self, raw_list: list):\n        self.elements = [Element(i, val) for i, val in enumerate(raw_list)]\n        self.length = len(raw_list)\n\n    def __len__(self) -> int:\n        return self.length\n\n    def __iter__(self):\n        return iter(self.elements)\nclass Transformer:\n    \"\"\"Applies transformation rules to an Element based on its index.\"\"\"\n    def __init__(self):\n        self.square_rule = TransformationRule('square', 1, _square)\n        self.cube_rule = TransformationRule('cube', 2, _cube)\n\n    def transform(self, e: Element) -> int:\n        \"\"\"Determines and applies the correct transformation rule based on the element's index.\"\"\"\n        if e.index % 3 == 0:\n            return self.square_rule.apply(e.originalValue)\n        elif e.index % 4 == 0:\n            return self.cube_rule.apply(e.originalValue)\n        else:\n            return e.originalValue\nclass Result:\n    \"\"\"Container for the final aggregated sum.\"\"\"\n    def __init__(self, value: int):\n        self.sum = value\ndef sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a \n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not \n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries. \n    \n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    if not lst:\n        return 0\n\n    input_list = InputList(lst)\n    transformer = Transformer()\n\n    for element in input_list:\n        transformed_val = transformer.transform(element)\n        element.apply_transformed(transformed_val)\n\n    total_sum = sum(element.transformedValue for element in input_list)\n\n    result = Result(total_sum)\n    return result.sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/143": [{"task_id": "HumanEval/143", "solution": "class _Word:\n    \"\"\"Represents a single word token.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n        self.length = 0\n        self.is_prime_length = False\n\n    def computeLength(self):\n        \"\"\"Computes and sets the word's length.\"\"\"\n        self.length = len(self.text)\n        return self.length\nclass _Validator:\n    \"\"\"Validates the input sentence string.\"\"\"\n    def validateLength(self, text: str) -> bool:\n        \"\"\"Checks if the sentence length is between 1 and 100 characters.\"\"\"\n        return 1 <= len(text) <= 100\n\n    def validateCharacters(self, text: str) -> bool:\n        \"\"\"Checks if the sentence contains only ASCII letters and spaces.\"\"\"\n        return all(c.isalpha() or c.isspace() for c in text)\n\n    def validateSpacing(self, text: str) -> bool:\n        \"\"\"Checks for no leading/trailing spaces or multiple consecutive spaces.\"\"\"\n        return text.strip() == text and \"  \" not in text\n\n    def validate(self, text: str) -> bool:\n        \"\"\"Orchestrates all validation checks for the sentence.\"\"\"\n        return self.validateLength(text) and \\\n               self.validateCharacters(text) and \\\n               self.validateSpacing(text)\nclass _Parser:\n    \"\"\"Parses a validated sentence string into _Word objects.\"\"\"\n    def parse(self, text: str) -> list[_Word]:\n        \"\"\"Splits the sentence by space into a list of _Word objects.\"\"\"\n        return [_Word(word_text) for word_text in text.split(' ')]\nclass _PrimeChecker:\n    \"\"\"Determines if an integer is a prime number.\"\"\"\n    def isPrime(self, n: int) -> bool:\n        \"\"\"Checks if a number n is prime using trial division.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\nclass _Filter:\n    \"\"\"Filters a list of _Word objects based on their prime length status.\"\"\"\n    def select_prime_length_words(self, words: list[_Word]) -> list[_Word]:\n        \"\"\"Returns a new list containing only words with prime lengths.\"\"\"\n        return [word for word in words if word.is_prime_length]\nclass _ResultFormatter:\n    \"\"\"Formats a list of selected _Word objects into the final output string.\"\"\"\n    def format(self, selected_words: list[_Word]) -> str:\n        \"\"\"Joins the text of selected words with single spaces.\"\"\"\n        return \" \".join([word.text for word in selected_words])\ndef words_in_sentence(sentence):\n    \"\"\"\n    Returns a string containing words from the original sentence whose lengths are prime numbers.\n    The order of words is preserved.\n    \"\"\"\n    validator = _Validator()\n    if not validator.validate(sentence):\n        raise ValueError(\"Invalid input: must be 1..100 chars, letters and single spaces only.\")\n\n    parser = _Parser()\n    words = parser.parse(sentence)\n\n    prime_checker = _PrimeChecker()\n    for word_obj in words:\n        word_obj.computeLength()\n        word_obj.is_prime_length = prime_checker.isPrime(word_obj.length)\n\n    filterer = _Filter()\n    selected_words = filterer.select_prime_length_words(words)\n\n    result_formatter = _ResultFormatter()\n    return result_formatter.format(selected_words)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/144": [{"task_id": "HumanEval/144", "solution": "class Fraction:\n    \"\"\"Represents a fraction and provides arithmetic operations.\"\"\"\n    def __init__(self, numerator: int, denominator: int):\n        self.numerator = numerator\n        self.denominator = denominator\n\n    @staticmethod\n    def parse(s: str) -> 'Fraction':\n        \"\"\"Parses a string \"<numerator>/<denominator>\" into a Fraction.\"\"\"\n        parts = s.split('/')\n        return Fraction(int(parts[0]), int(parts[1]))\n\n    def multiply(self, other: 'Fraction') -> 'Fraction':\n        \"\"\"Multiplies this fraction by another fraction.\"\"\"\n        new_numerator = self.numerator * other.numerator\n        new_denominator = self.denominator * other.denominator\n        return Fraction(new_numerator, new_denominator)\n\n    def isWhole(self) -> bool:\n        \"\"\"Checks if the fraction evaluates to a whole number.\"\"\"\n        return self.numerator % self.denominator == 0\n\n    def toString(self) -> str:\n        \"\"\"Returns the string representation of the fraction.\"\"\"\n        return f\"{self.numerator}/{self.denominator}\"\nclass Parser:\n    \"\"\"Parses fraction strings into Fraction objects.\"\"\"\n    def parseFraction(self, s: str) -> Fraction:\n        \"\"\"Parses a fraction string into a Fraction instance.\"\"\"\n        return Fraction.parse(s)\nclass Simplifier:\n    \"\"\"Coordinates the simplification process for two fraction strings.\"\"\"\n    def __init__(self):\n        self.parser = Parser()\n\n    def simplify(self, x: str, n: str) -> bool:\n        \"\"\"Parses, multiplies, and checks if the product of two fractions is a whole number.\"\"\"\n        fraction_x = self.parser.parseFraction(x)\n        fraction_n = self.parser.parseFraction(n)\n        product_fraction = fraction_x.multiply(fraction_n)\n        return product_fraction.isWhole()\ndef simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n\n    You can assume that x, and n are valid fractions, and do not have zero as denominator.\n\n    simplify(\"1/5\", \"5/1\") = True\n    simplify(\"1/6\", \"2/1\") = False\n    simplify(\"7/10\", \"10/2\") = False\n    \"\"\"\n    simplifier = Simplifier()\n    return simplifier.simplify(x, n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/145": [{"task_id": "HumanEval/145", "solution": "import math\nfrom typing import List\nclass IntegerItem:\n    \"\"\"Represents an integer with metadata for sorting.\"\"\"\n    def __init__(self, value: int, originalIndex: int) -> None:\n        self.value = value\n        self.originalIndex = originalIndex\n        self.digitSum = 0\n\n    def computeDigitSum(self) -> int:\n        \"\"\"Computes and sets the sum of decimal digits of the absolute value.\"\"\"\n        abs_value = abs(self.value)\n        s = 0\n        if abs_value == 0:\n            s = 0\n        else:\n            while abs_value > 0:\n                s += abs_value % 10\n                abs_value //= 10\n        self.digitSum = s\n        return self.digitSum\nclass OrderByPointsService:\n    \"\"\"Handles the core logic for sorting integers by digit sum.\"\"\"\n    def order_by_points(self, nums: List[int]) -> List[int]:\n        \"\"\"Orchestrates the sorting process.\"\"\"\n        if not nums:\n            return []\n\n        items = self._wrap_items(nums)\n        self._compute_digit_sums(items)\n        sorted_items = self._sort_items(items)\n        return [item.value for item in sorted_items]\n\n    def _wrap_items(self, nums: List[int]) -> List[IntegerItem]:\n        \"\"\"Wraps input integers into IntegerItem objects.\"\"\"\n        return [IntegerItem(value, i) for i, value in enumerate(nums)]\n\n    def _compute_digit_sums(self, items: List[IntegerItem]) -> None:\n        \"\"\"Computes digit sums for all IntegerItem objects.\"\"\"\n        for item in items:\n            item.computeDigitSum()\n\n    def _sort_items(self, items: List[IntegerItem]) -> List[IntegerItem]:\n        \"\"\"Sorts IntegerItem objects based on digit sum.\"\"\"\n        # Python's sorted is stable, preserving original order for ties.\n        return sorted(items, key=lambda item: item.digitSum)\ndef order_by_points(nums: List[int]) -> List[int]:\n    \"\"\"\n    Sorts the given list of integers in ascending order according to the sum of their digits.\n    Note: if there are several items with similar sum of their digits,\n    order them based on their index in original list.\n    \"\"\"\n    service = OrderByPointsService()\n    return service.order_by_points(nums)", "base_status