nts)\n    \n    result_obj = Result(triple_count)\n    \n    return result_obj.tripleCount", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/149": [{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Write a function that accepts a list of strings as a parameter,\n    deletes the strings that have odd lengths from it,\n    and returns the resulted list with a sorted order,\n    The list is always a list of strings and never an array of numbers,\n    and it may contain duplicates.\n    The order of the list should be ascending by length of each word, and you\n    should return the list sorted by that rule.\n    If two words have the same length, sort the list alphabetically.\n    The function should return a list of strings in sorted order.\n    You may assume that all words will have the same length.\n    For example:\n    assert list_sort([\"aa\", \"a\", \"aaa\"]) => [\"aa\"]\n    assert list_sort([\"ab\", \"a\", \"aaa\", \"cd\"]) => [\"ab\", \"cd\"]\n    \"\"\"\n    even_length_strings = []\n    for s in lst:\n        if len(s) % 2 == 0:\n            even_length_strings.append(s)\n\n    # Sort by length first (ascending), then alphabetically for ties (ascending).\n    even_length_strings.sort(key=lambda x: (len(x), x))\n    return even_length_strings", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/148": [{"task_id": "HumanEval/148", "solution": "from typing import List, Optional, Dict, Tuple\nclass Planet:\n    \"\"\"Represents a planet with its name and order from the Sun.\"\"\"\n    def __init__(self, name: str, orderFromSun: int) -> None:\n        self.name = name\n        self.orderFromSun = orderFromSun\n\n    def __repr__(self) -> str:\n        return f\"Planet('{self.name}', {self.orderFromSun})\"\nclass SolarSystem:\n    \"\"\"Manages the canonical list of planets and provides lookup/range operations.\"\"\"\n    def __init__(self) -> None:\n        planet_names = [\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"]\n        self.planets: List[Planet] = []\n        self._index_by_name: Dict[str, int] = {}\n\n        for i, name in enumerate(planet_names):\n            planet = Planet(name, i + 1)\n            self.planets.append(planet)\n            self._index_by_name[name] = i\n\n    def getPlanetByName(self, name: str) -> Optional[Planet]:\n        \"\"\"Returns a Planet object if the name is valid, otherwise None.\"\"\"\n        index = self._index_by_name.get(name)\n        if index is not None:\n            return self.planets[index]\n        return None\n\n    def getPlanetsBetween(self, name1: str, name2: str) -> List[Planet]:\n        \"\"\"Returns a list of planets whose orbits are strictly between name1 and name2.\"\"\"\n        idx1 = self._index_by_name.get(name1)\n        idx2 = self._index_by_name.get(name2)\n\n        if idx1 is None or idx2 is None:\n            return []\n\n        # Determine the effective start and end indices for slicing (exclusive of inputs)\n        start_idx = min(idx1, idx2) + 1\n        end_idx = max(idx1, idx2) - 1\n\n        if start_idx > end_idx:\n            return []\n\n        return self.planets[start_idx : end_idx + 1]\nsolar_system = SolarSystem()\ndef bf(planet1: str, planet2: str) -> Tuple[str, ...]:\n    \"\"\"\n    Returns a tuple of planets whose orbits are strictly between planet1 and planet2,\n    sorted by proximity to the Sun.\n    \"\"\"\n    p_list = solar_system.getPlanetsBetween(planet1, planet2)\n    return tuple(p.name for p in p_list)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/150": [{"task_id": "HumanEval/150", "solution": "import math\nfrom typing import Any\nclass ValidationError(Exception):\n    \"\"\"Deterministic exception type raised on input validation failures.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\nclass PrimalityTest:\n    \"\"\"Provides the isPrime algorithm that determines whether an integer n is prime.\"\"\"\n    method: str = 'trial_division'\n\n    @staticmethod\n    def isPrime(n: int) -> bool:\n        \"\"\"Return True if n is prime, otherwise False. For n <= 1, return False.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\nclass Number:\n    \"\"\"Typed wrapper for the integer input.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def isPrime(self) -> bool:\n        \"\"\"Delegates to PrimalityTest.isPrime for primality check.\"\"\"\n        return PrimalityTest.isPrime(self.value)\nclass Result:\n    \"\"\"Encapsulates the output value returned by x_or_y.\"\"\"\n    def __init__(self, value: Any):\n        self.value = value\nclass XorYFunction:\n    \"\"\"Encapsulates input validation and orchestration of the primality test.\"\"\"\n    def validateInputs(self, n, x, y) -> None:\n        \"\"\"Validates that n is an integer; raises ValidationError on failure.\"\"\"\n        if not isinstance(n, int):\n            raise ValidationError(\"Input 'n' must be an integer.\")\n        # The design implies 'x' and 'y' are present by being arguments.\n        # No specific type or nullability validation is specified for x, y.\n\n    def call(self, n, x, y) -> Any:\n        \"\"\"Orchestrates validation, primality check, and returns x or y.\"\"\"\n        self.validateInputs(n, x, y)\n        \n        number_obj = Number(n)\n        is_prime = number_obj.isPrime()\n\n        if is_prime:\n            return Result(x).value\n        else:\n            return Result(y).value\ndef x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is \n    a prime number and should return the value of y otherwise.\n\n    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n    \n    \"\"\"\n    return XorYFunction().call(n, x, y)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/151": [{"task_id": "HumanEval/151", "solution": "class NumberElement:\n    \"\"\"Represents a single numeric element and provides predicates and square computation.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n    def isInteger(self) -> bool:\n        \"\"\"Returns True if the element's value is a Python int.\"\"\"\n        return type(self.value) is int\n\n    def isNegative(self) -> bool:\n        \"\"\"Returns True if the element's value is less than 0.\"\"\"\n        return self.value < 0\n\n    def isOdd(self) -> bool:\n        \"\"\"Returns True if the element is an integer and its value is odd.\"\"\"\n        return self.isInteger() and self.value % 2 != 0\n\n    def square(self):\n        \"\"\"Returns the square of the element's value.\"\"\"\n        return self.value * self.value\nclass InputList:\n    \"\"\"Container for a list of numbers, converting raw items to NumberElement instances.\"\"\"\n    def __init__(self, raw_list):\n        self.elements = [NumberElement(item) for item in raw_list]\n\n    def __iter__(self):\n        \"\"\"Allows iteration over the contained NumberElement instances.\"\"\"\n        return iter(self.elements)\nclass Result:\n    \"\"\"Container for the accumulated sum of squares, with a default initial value of 0.\"\"\"\n    def __init__(self, initial_value=0):\n        self.sum_of_squares = initial_value\n\n    def add(self, contribution):\n        \"\"\"Adds a contribution to the accumulated sum of squares.\"\"\"\n        self.sum_of_squares += contribution\nclass DoubleDifferenceService:\n    \"\"\"Orchestrates processing to calculate the sum of squares of eligible odd integers.\"\"\"\n    def double_the_difference(self, lst: list):\n        input_list = InputList(lst)\n        result = Result(0)\n        for element in input_list:\n            if not element.isNegative() and element.isInteger() and element.isOdd():\n                result.add(element.square())\n        return result.sum_of_squares\ndef double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    '''\n    service = DoubleDifferenceService()\n    return service.double_the_difference(lst)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[[true, true, false, false, true, false, false, false, false, false]]]}], "HumanEval/152": [{"task_id": "HumanEval/152", "solution": "import math\nfrom typing import List, Union, Any\nclass ValidationError:\n    \"\"\"Encapsulates validation failure information.\"\"\"\n    def __init__(self, code: str, message: str) -> None:\n        self.code = code\n        self.message = message\n\n    def to_dict(self) -> dict:\n        return {\"code\": self.code, \"message\": self.message}\nclass Validator:\n    \"\"\"Validates input arrays for type, content, and length.\"\"\"\n    def validateIsArray(self, a: Any) -> bool:\n        \"\"\"Checks if the input is a list.\"\"\"\n        return isinstance(a, list)\n\n    def validateAllNumeric(self, a: List[Any]) -> bool:\n        \"\"\"Checks if all elements in the list are numeric (int or float).\"\"\"\n        return all(isinstance(x, (int, float)) for x in a)\n\n    def validateEqualLength(self, a: List[Any], b: List[Any]) -> bool:\n        \"\"\"Checks if two lists have equal length.\"\"\"\n        return len(a) == len(b)\n\n    def validate_all(self, game: Any, guess: Any) -> tuple[bool, Union[ValidationError, None]]:\n        \"\"\"Orchestrates all validation checks for game and guess inputs.\"\"\"\n        if not self.validateIsArray(game):\n            return False, ValidationError(\"TYPE_ERROR\", \"Game input must be an array.\")\n        if not self.validateIsArray(guess):\n            return False, ValidationError(\"TYPE_ERROR\", \"Guess input must be an array.\")\n        \n        if not self.validateAllNumeric(game):\n            return False, ValidationError(\"NON_NUMERIC\", \"All elements in game array must be numeric.\")\n        if not self.validateAllNumeric(guess):\n            return False, ValidationError(\"NON_NUMERIC\", \"All elements in guess array must be numeric.\")\n        \n        if not self.validateEqualLength(game, guess):\n            return False, ValidationError(\"LENGTH_MISMATCH\", \"Game and guess arrays must have equal length.\")\n        \n        return True, None\nclass Comparator:\n    \"\"\"Compares game scores and guesses to determine differences.\"\"\"\n    def compare(self, game: List[Union[int, float]], guess: List[Union[int, float]]) -> List[Union[int, float]]:\n        \"\"\"Computes the absolute difference for each pair of scores, or 0 if they match.\"\"\"\n        result = []\n        for i in range(len(game)):\n            if game[i] == guess[i]:\n                result.append(0)\n            else:\n                result.append(abs(game[i] - guess[i]))\n        return result\ndef compare(game: Any, guess: Any) -> Union[List[Union[int, float]], ValidationError]:\n    \"\"\"Compares game scores to guesses, returning an array of differences or a validation error.\"\"\"\n    validator = Validator()\n    ok, error = validator.validate_all(game, guess)\n\n    if not ok:\n        return error\n    \n    comparator = Comparator()\n    return comparator.compare(game, guess)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/154": [{"task_id": "HumanEval/154", "solution": "class InputString:\n    \"\"\"Represents the source string 'a'.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\nclass PatternString:\n    \"\"\"Represents the pattern string 'b'.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\nclass Rotation:\n    \"\"\"Represents a single cyclic rotation of the pattern.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\nclass RotationGenerator:\n    \"\"\"Generates all cyclic rotations of a PatternString.\"\"\"\n    def generate(self, pattern: PatternString) -> list[Rotation]:\n        if not pattern.value:\n            return []\n        rotations = []\n        n = len(pattern.value)\n        for i in range(n):\n            rotated_str = pattern.value[i:] + pattern.value[:i]\n            rotations.append(Rotation(rotated_str))\n        return rotations\nclass SubstringChecker:\n    \"\"\"Checks if a candidate Rotation is a substring of an InputString.\"\"\"\n    def contains(self, source: InputString, candidate: Rotation) -> bool:\n        return candidate.value in source.value\ndef cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\"\"\"\n    if not isinstance(a, str) or not isinstance(b, str):\n        raise TypeError(\"cycpattern_check precondition failed: both a and b must be str\")\n\n    source = InputString(a)\n    pattern = PatternString(b)\n\n    rotation_generator = RotationGenerator()\n    rotations = rotation_generator.generate(pattern)\n\n    substring_checker = SubstringChecker()\n    for rot in rotations:\n        if substring_checker.contains(source, rot):\n            return True\n\n    return False", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["", ""]]}], "HumanEval/155": [{"task_id": "HumanEval/155", "solution": "class Digit:\n    \"\"\"Immutable value object representing a digit and its parity.\"\"\"\n    def __init__(self, position: int, value: int, parity: str):\n        self.position = position\n        self.value = value\n        self.parity = parity\nclass Result:\n    \"\"\"Holds aggregated even and odd digit counts.\"\"\"\n    def __init__(self, even_count: int, odd_count: int):\n        self.even_count = even_count\n        self.odd_count = odd_count\n\n    def as_tuple(self) -> tuple[int, int]:\n        \"\"\"Returns the counts as a tuple.\"\"\"\n        return (self.even_count, self.odd_count)\ndef _digit_parity(value: int) -> str:\n    \"\"\"Returns 'even' or 'odd' for a given digit value.\"\"\"\n    return 'even' if value % 2 == 0 else 'odd'\ndef _extract_decimal_digits(value: int) -> list[int]:\n    \"\"\"Extracts decimal digits from an absolute integer value.\"\"\"\n    if value == 0:\n        return [0]\n    return [int(d) for d in str(value)]\nclass InputNumber:\n    \"\"\"Represents the input integer and provides methods to extract its digits.\"\"\"\n    def __init__(self, originalValue: int):\n        self.originalValue = originalValue\n        self.absoluteValue = abs(originalValue)\n\n    def getDigits(self) -> list[Digit]:\n        \"\"\"Produces a list of Digit instances for the absolute value's decimal digits.\"\"\"\n        digit_values = _extract_decimal_digits(self.absoluteValue)\n        digits = []\n        # Position is 0-based from least-significant digit.\n        # _extract_decimal_digits gives most-significant first.\n        # Reverse and enumerate for correct position.\n        for i, val in enumerate(reversed(digit_values)):\n            parity = _digit_parity(val)\n            digits.append(Digit(i, val, parity))\n        # The design implies `even_odd_count` iterates this list,\n        # so the order of digits itself within the list doesn't strictly matter\n        # for counting purposes, only their properties.\n        # Returning in order of extraction from string is simpler for this context.\n        # The position field is an implementation detail and not directly used by even_odd_count.\n        return [Digit(i, val, _digit_parity(val)) for i, val in enumerate(digit_values)]\ndef even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    if not isinstance(num, int):\n        raise TypeError(\"Input 'num' must be an integer.\")\n\n    input_num = InputNumber(num)\n    digits = input_num.getDigits()\n\n    even_count = 0\n    odd_count = 0\n\n    for digit in digits:\n        if digit.parity == 'even':\n            even_count += 1\n        else:\n            odd_count += 1\n\n    result = Result(even_count, odd_count)\n    return result.as_tuple()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/153": [{"task_id": "HumanEval/153", "solution": "from typing import List\nclass ClassEntity:\n    def __init__(self, name: str) -> None:\n        self.name = name\n        self.extensions: List['Extension'] = []\n\n    def getName(self) -> str:\n        return self.name\n\n    def addExtension(self, ext: 'Extension') -> None:\n        self.extensions.append(ext)\nclass Extension:\n    def __init__(self, name: str) -> None:\n        self.name = name\n        self.cap: int = 0\n        self.sm: int = 0\n        self.strength: int = 0\n\n    def countLetters(self) -> None:\n        for c in self.name:\n            if not c.isalpha():\n                continue\n            if c.isupper():\n                self.cap += 1\n            elif c.islower():\n                self.sm += 1\n\n    def computeStrength(self) -> None:\n        self.strength = self.cap - self.sm\nclass StrengthCalculator:\n    def computeForAll(self, extensions: List[Extension]) -> None:\n        for ext in extensions:\n            ext.countLetters()\n            ext.computeStrength()\n\n    def selectStrongest(self, extensions: List[Extension]) -> Extension:\n        if not extensions:\n            # As per design notes, behavior for empty list is unspecified.\n            # Returning a dummy Extension or raising an error would be options.\n            # For this exercise, assuming at least one extension based on examples\n            # and problem statement. If an empty list can occur, this would need refinement.\n            raise ValueError(\"Extensions list cannot be empty.\")\n\n        strongest_ext = extensions[0]\n        max_strength = extensions[0].strength\n\n        for i in range(1, len(extensions)):\n            current_ext = extensions[i]\n            if current_ext.strength > max_strength:\n                max_strength = current_ext.strength\n                strongest_ext = current_ext\n            # Tie-breaker: choose the one that comes first in the list\n            # The current logic inherently handles this by only updating if strength is *greater*\n            # and not equal, thus preserving the earlier element on ties.\n        \n        return strongest_ext\nclass Result:\n    def __init__(self) -> None:\n        self.formatted: str = \"\"\n\n    def format(self, className: str, extensionName: str) -> str:\n        self.formatted = className + '.' + extensionName\n        return self.formatted\ndef Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension based on CAP - SM strength and returns it in ClassName.StrongestExtensionName format.\"\"\"\n    entity = ClassEntity(class_name)\n    for name in extensions:\n        ext = Extension(name)\n        entity.addExtension(ext)\n\n    calc = StrengthCalculator()\n    calc.computeForAll(entity.extensions)\n    strongest = calc.selectStrongest(entity.extensions)\n\n    return Result().format(entity.getName(), strongest.name)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/157": [{"task_id": "HumanEval/157", "solution": "from typing import Tuple\nEPSILON: float = 1e-9\nclass Triangle:\n    \"\"\"Represents a triangle with three side lengths.\"\"\"\n    def __init__(self, a: float, b: float, c: float) -> None:\n        self.a: float = float(a)\n        self.b: float = float(b)\n        self.c: float = float(c)\n        self.is_valid: bool = False\n\n    def validate(self) -> bool:\n        \"\"\"Checks if the sides form a valid triangle based on positive lengths and triangle inequality.\"\"\"\n        # BR2: Side lengths must be > 0.\n        if not (self.a > 0 and self.b > 0 and self.c > 0):\n            self.is_valid = False\n            return False\n\n        # BR3: Triangle inequality required.\n        if not (self.a < self.b + self.c and\n                self.b < self.a + self.c and\n                self.c < self.a + self.b):\n            self.is_valid = False\n            return False\n\n        self.is_valid = True\n        return True\n\n    def hypotenuse(self) -> float:\n        \"\"\"Returns the length of the longest side, which is the candidate hypotenuse.\"\"\"\n        return max(self.a, self.b, self.c)\n\n    def other_sides(self) -> Tuple[float, float]:\n        \"\"\"Returns the lengths of the two non-hypotenuse sides.\"\"\"\n        sides = sorted([self.a, self.b, self.c])\n        return (sides[0], sides[1])\n\n    def is_right_angled(self, epsilon: float) -> bool:\n        \"\"\"Checks if the triangle is right-angled using the Pythagorean theorem within a given epsilon.\"\"\"\n        h = self.hypotenuse()\n        s1, s2 = self.other_sides()\n        # BR5: Right-angled iff other_side1^2 + other_side2^2 == hypotenuse^2 within EPSILON.\n        return abs((s1**2 + s2**2) - h**2) <= epsilon\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or\n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    # Convert inputs to float and construct a Triangle object.\n    triangle = Triangle(float(a), float(b), float(c))\n\n    # Validate the triangle for positive sides and triangle inequality.\n    if not triangle.validate():\n        return False\n\n    # Check if the valid triangle is right-angled using the defined epsilon.\n    return triangle.is_right_angled(EPSILON)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/156": [{"task_id": "HumanEval/156", "solution": "class Error(Exception):\n    \"\"\"Represents a validation error with a code and message.\"\"\"\n    def __init__(self, code: str, message: str):\n        self.code = code\n        self.message = message\n        super().__init__(f\"[{code}] {message}\")\nclass IntegerInput:\n    \"\"\"Value object for integer input, providing validation checks.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n    def isInteger(self) -> bool:\n        return isinstance(self.value, int)\n\n    def inRange(self, min_val: int, max_val: int) -> bool:\n        return min_val <= self.value <= max_val\nclass ValidationResult:\n    \"\"\"DTO for validation outcomes.\"\"\"\n    def __init__(self, isValid: bool, errorCode: str = None, errorMessage: str = None):\n        self.isValid = isValid\n        self.errorCode = errorCode\n        self.errorMessage = errorMessage\nclass Validator:\n    \"\"\"Validates IntegerInput objects.\"\"\"\n    @staticmethod\n    def validate(input_obj: IntegerInput) -> ValidationResult:\n        if not input_obj.isInteger():\n            return ValidationResult(False, 'TYPE_ERROR', 'Input must be integer')\n        if not input_obj.inRange(1, 1000):\n            return ValidationResult(False, 'RANGE_ERROR', 'Input must be in 1..1000')\n        return ValidationResult(True)\nclass ConversionRule:\n    \"\"\"Represents a Roman symbol and its integer value.\"\"\"\n    def __init__(self, symbol: str, value: int):\n        self.symbol = symbol\n        self.value = value\nclass RomanNumeral:\n    \"\"\"Represents a Roman numeral string and provides formatting.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def toLowercase(self) -> str:\n        return self.value.lower()\nclass Converter:\n    \"\"\"Converts a validated integer to a RomanNumeral object.\"\"\"\n    RULES = [\n        ConversionRule('M', 1000), ConversionRule('CM', 900), ConversionRule('D', 500), ConversionRule('CD', 400),\n        ConversionRule('C', 100), ConversionRule('XC', 90), ConversionRule('L', 50), ConversionRule('XL', 40),\n        ConversionRule('X', 10), ConversionRule('IX', 9), ConversionRule('V', 5), ConversionRule('IV', 4),\n        ConversionRule('I', 1)\n    ]\n\n    @staticmethod\n    def convert(value: int) -> RomanNumeral:\n        roman_numerals = []\n        remaining_value = value\n        for rule in Converter.RULES:\n            while remaining_value >= rule.value:\n                roman_numerals.append(rule.symbol)\n                remaining_value -= rule.value\n        return RomanNumeral(\"\".join(roman_numerals))\ndef int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    input_obj = IntegerInput(number)\n    validation = Validator.validate(input_obj)\n\n    if not validation.isValid:\n        raise Error(validation.errorCode, validation.errorMessage)\n\n    roman_obj = Converter.convert(number)\n    return roman_obj.toLowercase()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/83": [{"task_id": "HumanEval/83", "solution": "class InputParameter:\n    \"\"\"Helper class to encapsulate and validate the input parameter n.\"\"\"\n    def __init__(self, n):\n        self.n = n\n\n    def is_integer(self) -> bool:\n        \"\"\"Checks if n is an integer.\"\"\"\n        return isinstance(self.n, int)\n\n    def is_positive(self) -> bool:\n        \"\"\"Checks if n is a positive number.\"\"\"\n        return self.n > 0\nclass CalculationRule:\n    \"\"\"Helper class to apply the closed-form computation rules.\"\"\"\n    def apply(self, n: int) -> int:\n        \"\"\"Applies the calculation rule based on n.\"\"\"\n        if n == 1:\n            return 1\n        else:\n            return 18 * 10 ** (n - 2)\ndef starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    ip = InputParameter(n)\n    if not ip.is_integer() or not ip.is_positive():\n        raise ValueError('n must be a positive integer')\n\n    return CalculationRule().apply(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/159": [{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    You're a hungry rabbit, and you already have eaten a certain number of carrots,\n    but now you need to eat more carrots to complete the day's meals.\n    you should return an array of [ total number of eaten carrots after your meals,\n                                    the number of carrots left after your meals ]\n    if there are not enough remaining carrots, you will eat all remaining carrots, but will still be hungry.\n    \n    Example:\n    * eat(5, 6, 10) -> [11, 4]\n    * eat(4, 8, 9) -> [12, 1]\n    * eat(1, 10, 10) -> [11, 0]\n    * eat(2, 11, 5) -> [7, 0]\n    \n    Variables:\n    @number : integer\n        the number of carrots that you have eaten.\n    @need : integer\n        the number of carrots that you need to eat.\n    @remaining : integer\n        the number of remaining carrots thet exist in stock\n    \n    Constrain:\n    * 0 <= number <= 1000\n    * 0 <= need <= 1000\n    * 0 <= remaining <= 1000\n\n    Have fun :)\n    \"\"\"\n    if remaining >= need:\n        total_eaten = number + need\n        remaining_after_meals = remaining - need\n    else:\n        total_eaten = number + remaining\n        remaining_after_meals = 0\n    \n    return [total_eaten, remaining_after_meals]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/158": [{"task_id": "HumanEval/158", "solution": "from typing import List\nclass Word:\n    \"\"\"Domain model representing a single input word and its unique-character computation.\"\"\"\n    def __init__(self, text: str) -> None:\n        self.text = text\n        self.uniqueCount = 0\n\n    def computeUniqueCount(self) -> int:\n        \"\"\"Computes the number of unique characters for the word, stores it, and returns it.\"\"\"\n        self.uniqueCount = len(set(self.text))\n        return self.uniqueCount\nclass WordList:\n    \"\"\"In-memory container for Word instances.\"\"\"\n    def __init__(self) -> None:\n        self.words: List[Word] = []\n\n    def add(self, word: Word) -> None:\n        \"\"\"Adds a Word instance to the internal list.\"\"\"\n        self.words.append(word)\n\n    def getAll(self) -> List[Word]:\n        \"\"\"Returns the internal list of Word instances.\"\"\"\n        return self.words\ndef find_max(words: List[str]) -> str:\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n    \"\"\"\n    word_list_container = WordList()\n\n    for word_str in words:\n        word_obj = Word(word_str)\n        word_obj.computeUniqueCount()\n        word_list_container.add(word_obj)\n\n    all_processed_words = word_list_container.getAll()\n\n    # Precondition: input 'words' list is non-empty, so 'all_processed_words' will also be non-empty.\n    # Find the maximum unique character count among all words.\n    max_unique_count = max(w.uniqueCount for w in all_processed_words)\n\n    # Filter for all words that have this maximum unique character count.\n    tied_words = [w for w in all_processed_words if w.uniqueCount == max_unique_count]\n\n    # Sort the tied words lexicographically by their text.\n    tied_words.sort(key=lambda w: w.text)\n\n    # Return the text of the first word in the sorted tied list.\n    return tied_words[0].text", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/160": [{"task_id": "HumanEval/160", "solution": "class ValidationError(ValueError):\n    \"\"\"Domain-specific error for validation failures, subclasses ValueError.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\nclass Operand:\n    \"\"\"Represents an operand with its value and original index.\"\"\"\n    def __init__(self, value: int, idx: int):\n        self.value = value\n        self.idx = idx\nclass Operator:\n    \"\"\"Represents an operator with its symbol and original index.\"\"\"\n    def __init__(self, symbol: str, idx: int):\n        self.symbol = symbol\n        self.idx = idx\nclass Expression:\n    \"\"\"Represents an algebraic expression as lists of operands and operators.\"\"\"\n    def __init__(self, operands: list[Operand], operators: list[Operator]):\n        self.operands = operands\n        self.operators = operators\n\n    def to_string(self) -> str:\n        \"\"\"Returns a string representation of the expression.\"\"\"\n        parts = []\n        for i in range(len(self.operators)):\n            parts.append(str(self.operands[i].value))\n            parts.append(self.operators[i].symbol)\n        parts.append(str(self.operands[-1].value))\n        return ' '.join(parts)\nclass Validator:\n    \"\"\"Validates the input lists operator and operand.\"\"\"\n    supported_operators = {'+', '-', '*', '//', '**'}\n\n    def validate_lengths(self, operator: list, operand: list) -> None:\n        \"\"\"Ensures length relationship and minimum counts; raises ValidationError on failure.\"\"\"\n        if not (len(operator) == len(operand) - 1):\n            raise ValidationError(\"Operator list length must be one less than operand list length.\")\n        if not (len(operator) >= 1 and len(operand) >= 2):\n            raise ValidationError(\"Operator list must have at least one operator, and operand list at least two operands.\")\n\n    def validate_operands(self, operand: list) -> None:\n        \"\"\"Ensures each operand is a non-negative integer; raises ValidationError on failure.\"\"\"\n        for i, val in enumerate(operand):\n            if not isinstance(val, int) or val < 0:\n                raise ValidationError(f\"Operand at index {i} must be a non-negative integer.\")\n\n    def validate_operators(self, operator: list) -> None:\n        \"\"\"Ensures each operator is supported; raises ValidationError on failure.\"\"\"\n        for i, op_symbol in enumerate(operator):\n            if op_symbol not in self.supported_operators:\n                raise ValidationError(f\"Operator '{op_symbol}' at index {i} is not supported.\")\nclass ExpressionBuilder:\n    \"\"\"Builds an Expression object from input lists.\"\"\"\n    def build_expression(self, operator_symbols: list[str], operand_values: list[int]) -> Expression:\n        \"\"\"Creates Operand and Operator objects and returns an Expression.\"\"\"\n        operands = [Operand(value, i) for i, value in enumerate(operand_values)]\n        operators = [Operator(symbol, i) for i, symbol in enumerate(operator_symbols)]\n        return Expression(operands, operators)\nclass Evaluator:\n    \"\"\"Evaluates an Expression object applying operator precedence and associativity.\"\"\"\n    def evaluate(self, expr: Expression) -> int:\n        \"\"\"Evaluates the expression; raises ZeroDivisionError on floor-division by zero.\"\"\"\n\n        def apply_op(op_symbol: str, val1: int, val2: int) -> int:\n            \"\"\"Applies a given operator to two integer values.\"\"\"\n            if op_symbol == '+': return val1 + val2\n            if op_symbol == '-': return val1 - val2\n            if op_symbol == '*': return val1 * val2\n            if op_symbol == '//':\n                if val2 == 0:\n                    raise ZeroDivisionError(\"Division by zero\")\n                return val1 // val2\n            if op_symbol == '**': return val1 ** val2\n            raise ValueError(f\"Unsupported operator encountered during evaluation: {op_symbol}\")\n\n        # Build initial flat list of interleaved operands and operators\n        current_elements: list[int | str] = []\n        for i in range(len(expr.operators)):\n            current_elements.append(expr.operands[i].value)\n            current_elements.append(expr.operators[i].symbol)\n        current_elements.append(expr.operands[-1].value)\n\n        # Pass 1: Exponentiation (**) - Right-associative\n        # Iterate right-to-left for right-associativity\n        i = len(current_elements) - 1\n        while i >= 0:\n            if current_elements[i] == '**':\n                val2 = current_elements[i+1]\n                op_symbol = current_elements[i]\n                val1 = current_elements[i-1]\n                result = apply_op(str(op_symbol), int(val1), int(val2))\n                current_elements[i-1:i+2] = [result] # Replace [val1, '**', val2] with [result]\n                i -= 2 # Adjust index: 3 elements reduced to 1, move cursor back by 2 for next operator check\n            else:\n                i -= 1\n\n        # Pass 2: Multiplication (*), Floor Division (//) - Left-associative\n        # Iterate left-to-right\n        i = 0\n        while i < len(current_elements):\n            if current_elements[i] in {'*', '//'}:\n                val1 = current_elements[i-1]\n                op_symbol = current_elements[i]\n                val2 = current_elements[i+1]\n                result = apply_op(str(op_symbol), int(val1), int(val2))\n                current_elements[i-1:i+2] = [result]\n                i -= 1 # Adjust index: 3 elements reduced to 1. The new result is at i-1.\n                       # Loop's i+=1 will then move to the element after the result.\n            else:\n                i += 1\n        \n        # Pass 3: Addition (+), Subtraction (-) - Left-associative\n        # Iterate left-to-right\n        i = 0\n        while i < len(current_elements):\n            if current_elements[i] in {'+', '-'}:\n                val1 = current_elements[i-1]\n                op_symbol = current_elements[i]\n                val2 = current_elements[i+1]\n                result = apply_op(str(op_symbol), int(val1), int(val2))\n                current_elements[i-1:i+2] = [result]\n                i -= 1 # Same adjustment logic as for multiplication/division\n            else:\n                i += 1\n        \n        return int(current_elements[0])\ndef do_algebra(operator: list, operand: list) -> int:\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and \n    the second list is a list of integers. Use the two given lists to build the algebric \n    expression and return the evaluation of this expression.\n    \"\"\"\n    validator = Validator()\n    validator.validate_lengths(operator, operand)\n    validator.validate_operands(operand)\n    validator.validate_operators(operator)\n\n    builder = ExpressionBuilder()\n    expr = builder.build_expression(operator, operand)\n\n    evaluator = Evaluator()\n    return evaluator.evaluate(expr)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/162": [{"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    \n    return hashlib.md5(text.encode('utf-8')).hexdigest()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/161": [{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"You are given a string s.\n    if s[i] is a letter, reverse its case from lower to upper or vise versa, \n    otherwise keep it as it is.\n    If the string contains no letters, reverse the string.\n    The function should return the resulted string.\n    Examples\n    solve(\"1234\") = \"4321\"\n    solve(\"ab\") = \"AB\"\n    \"#a@C\" = \"#A@c\"\n    \"\"\"\n    \n    has_letters = False\n    for char in s:\n        if char.isalpha():\n            has_letters = True\n            break\n\n    if has_letters:\n        result_chars = []\n        for char in s:\n            if char.isalpha():\n                if char.islower():\n                    result_chars.append(char.upper())\n                else: # char is an uppercase letter\n                    result_chars.append(char.lower())\n            else:\n                result_chars.append(char)\n        return \"\".join(result_chars)\n    else:\n        return s[::-1]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/163": [{"task_id": "HumanEval/163", "solution": "from typing import List\nclass InputValidationError(Exception):\n    \"\"\"\n    Represents a validation error when inputs violate BR1/BR10 (non-integer or non-positive).\n    \"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\nclass InputParameters:\n    \"\"\"\n    Represent input pair (a, b) and validate them per BR1/BR10/NFR1.\n    \"\"\"\n    def __init__(self, a, b):\n        self.a = a\n        self.b = b\n\n    def validate(self) -> bool:\n        \"\"\"\n        Ensure a and b are both of int type and > 0. Returns True when valid; False otherwise.\n        \"\"\"\n        return isinstance(self.a, int) and isinstance(self.b, int) and self.a > 0 and self.b > 0\nclass Range:\n    \"\"\"\n    Compute and represent inclusive range [min, max] from two integers.\n    \"\"\"\n    def __init__(self, min_val: int, max_val: int):\n        self.min = min_val\n        self.max = max_val\n\n    @staticmethod\n    def compute(a: int, b: int) -> 'Range':\n        \"\"\"\n        Create and return a Range instance where min = min(a, b) and max = max(a, b). Inclusive boundaries.\n        \"\"\"\n        return Range(min(a, b), max(a, b))\nclass CandidateDigit:\n    \"\"\"\n    Represent a candidate digit and evaluate if it lies within a Range.\n    \"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def isWithin(self, r: 'Range') -> bool:\n        \"\"\"\n        Return True iff r.min <= self.value <= r.max (inclusive).\n        \"\"\"\n        return r.min <= self.value <= r.max\nclass ResultList:\n    \"\"\"\n    Collect selected digits, enforce uniqueness and ordering, and produce the final list of ints.\n    \"\"\"\n    def __init__(self):\n        self.items: List[int] = []\n\n    def add(self, value: int) -> None:\n        \"\"\"\n        Append a candidate value.\n        \"\"\"\n        self.items.append(value)\n\n    def unique(self) -> None:\n        \"\"\"\n        Remove duplicates from items, preserving numeric uniqueness.\n        \"\"\"\n        self.items = list(set(self.items))\n\n    def sortAscending(self) -> None:\n        \"\"\"\n        Sort items ascending (numeric order).\n        \"\"\"\n        self.items.sort()\n\n    def to_list(self) -> List[int]:\n        \"\"\"\n        Return items as a List[int].\n        \"\"\"\n        return self.items\nCANDIDATE_SET = {0, 2, 4, 6, 8}\ndef generate_integers(a, b) -> List[int]:\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    ip = InputParameters(a, b)\n    if not ip.validate():\n        raise InputValidationError('a and b must be positive integers')\n\n    r = Range.compute(a, b)\n    rl = ResultList()\n\n    for candidate_value in sorted(CANDIDATE_SET):\n        cd = CandidateDigit(candidate_value)\n        if cd.isWithin(r):\n            rl.add(candidate_value)\n\n    # The design specifies unique() and sortAscending() even if the loop already processes CANDIDATE_SET in order.\n    # This ensures consistency with the ResultList contract.\n    rl.unique()\n    rl.sortAscending()\n    return rl.to_list()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/129": [{"task_id": "HumanEval/129", "solution": "from typing import List\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input data.\"\"\"\n    pass\nclass ProcessingError(Exception):\n    \"\"\"Exception raised for internal processing failures.\"\"\"\n    pass\nclass Cell:\n    \"\"\"Represents a single cell in the grid.\"\"\"\n    def __init__(self, value: int, row: int, col: int):\n        self.value = value\n        self.row = row\n        self.col = col\n\n    def neighbors(self, grid: 'Grid') -> List['Cell']:\n        \"\"\"Returns orthogonally adjacent cells in deterministic order (up, left, right, down).\"\"\"\n        neighbors_list = []\n        N = grid.N\n        moves = [(-1, 0), (0, -1), (0, 1), (1, 0)] # dr, dc: Up, Left, Right, Down\n        for dr, dc in moves:\n            nr, nc = self.row + dr, self.col + dc\n            if 0 <= nr < N and 0 <= nc < N:\n                neighbors_list.append(grid.getCell(nr, nc))\n        return neighbors_list\n\n    def __eq__(self, other):\n        \"\"\"Compares cells based on their value, row, and column.\"\"\"\n        return isinstance(other, Cell) and self.value == other.value and self.row == other.row and self.col == other.col\n\n    def __hash__(self):\n        \"\"\"Returns a hash for the cell.\"\"\"\n        return hash((self.value, self.row, self.col))\nclass Grid:\n    \"\"\"Represents the entire grid structure.\"\"\"\n    def __init__(self, N: int, cells: List[List['Cell']]):\n        self.N = N\n        self.cells = cells # 0-based indexing\n\n    def validateSquare(self) -> None:\n        \"\"\"Ensures N >= 2 and the grid's dimensions are square.\"\"\"\n        if self.N < 2:\n            raise ValidationError(f\"Grid size N must be at least 2, got {self.N}\")\n        if not all(len(row) == self.N for row in self.cells):\n            raise ValidationError(\"Grid is not square.\")\n\n    def validateUniqueValues(self) -> None:\n        \"\"\"Ensures grid values form a permutation of 1..N*N.\"\"\"\n        expected_values = set(range(1, self.N * self.N + 1))\n        actual_values = set()\n        for r in range(self.N):\n            for c in range(self.N):\n                cell_value = self.cells[r][c].value\n                if cell_value in actual_values:\n                    raise ValidationError(f\"Duplicate value {cell_value} found in grid.\")\n                actual_values.add(cell_value)\n        if actual_values != expected_values:\n            raise ValidationError(\"Grid values do not form a permutation of 1 to N*N.\")\n\n    def getCell(self, row: int, col: int) -> 'Cell':\n        \"\"\"Returns the Cell at the given 0-based coordinates.\"\"\"\n        return self.cells[row][col]\nclass Path:\n    \"\"\"Represents a sequence of visited cells.\"\"\"\n    def __init__(self, k: int, initial_cell: 'Cell' = None):\n        self.k = k\n        self.steps: List['Cell'] = []\n        if initial_cell:\n            self.append(initial_cell)\n\n    def append(self, cell: 'Cell') -> None:\n        \"\"\"Appends a cell to the path.\"\"\"\n        self.steps.append(cell)\n\n    def values(self) -> List[int]:\n        \"\"\"Returns a list of values from the cells in the path.\"\"\"\n        return [cell.value for cell in self.steps]\n\n    def lexCompare(self, other: 'Path') -> int:\n        \"\"\"Compares this path lexicographically with another path.\"\"\"\n        for i in range(min(len(self.steps), len(other.steps))):\n            if self.steps[i].value < other.steps[i].value:\n                return -1\n            elif self.steps[i].value > other.steps[i].value:\n                return 1\n        if len(self.steps) < len(other.steps):\n            return -1\n        elif len(self.steps) > len(other.steps):\n            return 1\n        return 0\nclass InputValidator:\n    \"\"\"Validates the raw input grid and k value.\"\"\"\n    def __init__(self):\n        pass\n\n    def validate_grid(self, grid_input: List[List[int]]) -> None:\n        \"\"\"Validates grid structure: non-empty list of lists, square, and integer values.\"\"\"\n        if not isinstance(grid_input, List) or not grid_input:\n            raise ValidationError(\"Grid must be a non-empty list of lists.\")\n\n        N = len(grid_input)\n        if N < 1: \n            raise ValidationError(\"Grid cannot be empty.\")\n\n        for row_list in grid_input:\n            if not isinstance(row_list, List) or len(row_list) != N:\n                raise ValidationError(\"Grid is not square or rows have inconsistent length.\")\n            for val in row_list:\n                if not isinstance(val, int):\n                    raise ValidationError(\"Grid values must be integers.\")\n\n    def validate_k(self, k: int) -> None:\n        \"\"\"Validates that k is a positive integer.\"\"\"\n        if not isinstance(k, int) or k <= 0:\n            raise ValidationError(f\"Path length k must be a positive integer, got {k}.\")\nclass GridStore:\n    \"\"\"Converts raw grid values into a structured Grid object.\"\"\"\n    def __init__(self):\n        pass\n\n    def from_grid_values(self, grid_input: List[List[int]]) -> 'Grid':\n        \"\"\"Constructs a Grid instance from the raw input values.\"\"\"\n        N = len(grid_input)\n        cells_matrix: List[List[Cell]] = [[Non