j.getDigits()\n\n    sum_calculator = DigitSumCalculator()\n    digit_sum = sum_calculator.compute(digits_list)\n\n    binary_converter = BinaryConverter()\n    binary_string = binary_converter.toBinary(digit_sum)\n\n    return binary_string", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/89": [{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by shifting each letter forward by four positions in the alphabet,\n    wrapping from 'z' to 'a' if necessary.\n    \"\"\"\n    shifted_chars = []\n    for char in s:\n        # Calculate the 0-based index of the character in the alphabet\n        char_index = ord(char) - ord('a')\n        # Apply the shift of 4 and use modulo 26 for wrapping\n        new_index = (char_index + 4) % 26\n        # Convert the new index back to a character\n        shifted_char = chr(ord('a') + new_index)\n        shifted_chars.append(shifted_char)\n    return \"\".join(shifted_chars)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["test123"]]}], "HumanEval/86": [{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Write a function that takes a string and returns an ordered version of it.\n    Ordered version of string, is a string where all words (separated by space)\n    are replaced by a new word where all the characters arranged in\n    ascending order based on ascii value.\n    Note: You should keep the order of words and blank spaces in the sentence.\n\n    For example:\n    anti_shuffle('Hi') returns 'Hi'\n    anti_shuffle('hello') returns 'ehllo'\n    anti_shuffle('Hello World!!!') returns 'Hello !!!Wdlor'\n    \"\"\"\n    def _sort_chars_by_ascii(word: str) -> str:\n        \"\"\"Sorts characters of a word by their ASCII values in ascending order.\"\"\"\n        return \"\".join(sorted(word))\n\n    def _tokenize_preserve_spaces(s: str) -> list[str]:\n        \"\"\"Tokenizes a string into words and space sequences, preserving order.\"\"\"\n        tokens = []\n        if not s:\n            return tokens\n\n        in_space_run = s[0].isspace()\n        start_index = 0\n\n        for i in range(1, len(s)):\n            current_char_is_space = s[i].isspace()\n\n            if current_char_is_space != in_space_run:\n                tokens.append(s[start_index:i])\n                start_index = i\n                in_space_run = current_char_is_space\n\n        tokens.append(s[start_index:])\n        return tokens\n\n    if not s:\n        return \"\"\n\n    tokens = _tokenize_preserve_spaces(s)\n    processed_tokens = []\n    for token in tokens:\n        # If the token consists entirely of space characters, keep it as is.\n        # Otherwise, it's a \"word\" token, so sort its characters.\n        if token.isspace():\n            processed_tokens.append(token)\n        else:\n            processed_tokens.append(_sort_chars_by_ascii(token))\n\n    return \"\".join(processed_tokens)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [["\n\n123 456\n789\n"]]}], "HumanEval/90": [{"task_id": "HumanEval/90", "solution": "def next_smallest(lst):\n    \"\"\"\n    Returns the 2nd smallest element of the list, or None if there is no such element.\n    This function handles input validation internally and removes duplicate values.\n    \"\"\"\n    def _validate_input(lst_to_validate):\n        \"\"\"Validates that the input is a list of integers.\"\"\"\n        if not isinstance(lst_to_validate, list):\n            raise TypeError(\"Input must be a list.\")\n        for item in lst_to_validate:\n            if not isinstance(item, int):\n                raise TypeError(\"All elements in the list must be integers.\")\n\n    def _distinct_sorted(lst_to_sort):\n        \"\"\"Extracts distinct integer values and returns them as a sorted ascending list.\"\"\"\n        return sorted(list(set(lst_to_sort)))\n\n    _validate_input(lst)\n    \n    distinct_sorted_list = _distinct_sorted(lst)\n    \n    if len(distinct_sorted_list) < 2:\n        return None\n    else:\n        return distinct_sorted_list[1]", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[""]]}], "HumanEval/88": [{"task_id": "HumanEval/88", "solution": "from typing import List\nclass InputArray:\n    \"\"\"Encapsulates input array elements and provides utility methods.\"\"\"\n    def __init__(self, elements: List[int]) -> None:\n        self.elements = list(elements) # Create a copy to ensure immutability of original\n\n    def length(self) -> int:\n        return len(self.elements)\n\n    def first(self) -> int:\n        if not self.elements:\n            raise IndexError(\"InputArray is empty\")\n        return self.elements[0]\n\n    def last(self) -> int:\n        if not self.elements:\n            raise IndexError(\"InputArray is empty\")\n        return self.elements[-1]\n\n    def copy_elements(self) -> List[int]:\n        return list(self.elements)\nclass Validator:\n    \"\"\"Validates elements of an InputArray.\"\"\"\n    def is_non_negative_integers(self, input_array: InputArray) -> bool:\n        \"\"\"Checks if all elements are non-negative integers.\"\"\"\n        for element in input_array.elements:\n            if not isinstance(element, int) or element < 0:\n                return False\n        return True\n\n    def validate_or_raise(self, input_array: InputArray) -> None:\n        \"\"\"Raises ValueError if any element is not a non-negative integer.\"\"\"\n        for element in input_array.elements:\n            if not isinstance(element, int):\n                raise ValueError(\"Array must contain only integers.\")\n            if element < 0:\n                raise ValueError(\"Array must contain only non-negative integers.\")\nclass SumCalculator:\n    \"\"\"Calculates the sum of the first and last elements of an InputArray.\"\"\"\n    def compute_sum(self, input_array: InputArray) -> int:\n        \"\"\"Returns the sum of the first and last elements.\"\"\"\n        # Per design, empty array is handled earlier, so length is at least 1 here.\n        return input_array.first() + input_array.last()\nclass SortingService:\n    \"\"\"Provides sorting primitives and applies the parity-based sorting rule.\"\"\"\n    def sort_ascending(self, elements: List[int]) -> List[int]:\n        \"\"\"Returns a new list sorted in ascending order.\"\"\"\n        return sorted(elements)\n\n    def sort_descending(self, elements: List[int]) -> List[int]:\n        \"\"\"Returns a new list sorted in descending order.\"\"\"\n        return sorted(elements, reverse=True)\n\n    def sort_by_parity_rule(self, input_array: InputArray) -> List[int]:\n        \"\"\"Sorts a copy of elements based on the parity of (first + last).\"\"\"\n        sum_calculator = SumCalculator()\n        s = sum_calculator.compute_sum(input_array)\n        \n        elements_copy = input_array.copy_elements() # Work on a copy\n        \n        if s % 2 == 1:  # Odd sum\n            return self.sort_ascending(elements_copy)\n        else:  # Even sum\n            return self.sort_descending(elements_copy)\ndef sort_array(array: List[int]) -> List[int]:\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n\n    Note:\n    * don't change the given array.\n\n    Examples:\n    * sort_array([]) => []\n    * sort_array([5]) => [5]\n    * sort_array([2, 4, 3, 0, 1, 5]) => [0, 1, 2, 3, 4, 5]\n    * sort_array([2, 4, 3, 0, 1, 5, 6]) => [6, 5, 4, 3, 2, 1, 0]\n    \"\"\"\n    if not array:\n        return []\n\n    input_arr = InputArray(array)\n    Validator().validate_or_raise(input_arr)\n    \n    return SortingService().sort_by_parity_rule(input_arr)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/87": [{"task_id": "HumanEval/87", "solution": "from typing import List, Tuple\nclass SearchRequest:\n    \"\"\"Encapsulates input contract (lst and x).\"\"\"\n    def __init__(self, lst: List[List[int]], x: int) -> None:\n        self.lst = lst\n        self.x = x\nclass Row:\n    \"\"\"Represent a single row of integer elements.\"\"\"\n    def __init__(self, index: int, elements: List[int]) -> None:\n        self.index = index\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the row.\"\"\"\n        return len(self.elements)\n\n    def __len__(self) -> int:\n        \"\"\"Returns the number of elements in the row.\"\"\"\n        return len(self.elements)\n\n    def __getitem__(self, idx: int) -> int:\n        \"\"\"Returns the element at the given column index.\"\"\"\n        return self.elements[idx]\nclass NestedList:\n    \"\"\"Conceptual wrapper for ragged 2D input; provide row accessors.\"\"\"\n    def __init__(self, rows_data: List[List[int]]) -> None:\n        self.rows: List[Row] = [Row(i, row_elements) for i, row_elements in enumerate(rows_data)]\n\n    def get_row(self, i: int) -> 'Row':\n        \"\"\"Returns a Row object for the given index.\"\"\"\n        return self.rows[i]\n\n    def __len__(self) -> int:\n        \"\"\"Returns the number of rows.\"\"\"\n        return len(self.rows)\nclass Occurrence:\n    \"\"\"Value object for a single found match with zero-based indices.\"\"\"\n    def __init__(self, row_index: int, col_index: int) -> None:\n        self.row_index = row_index\n        self.col_index = col_index\n\n    def __iter__(self):\n        \"\"\"Allows unpacking as (row_index, col_index).\"\"\"\n        yield self.row_index\n        yield self.col_index\nclass Result:\n    \"\"\"Hold collection of Occurrence objects produced by SearchEngine.\"\"\"\n    def __init__(self, occurrences: List[Occurrence]) -> None:\n        self.occurrences = occurrences\n\n    def as_tuples(self) -> List[Tuple[int, int]]:\n        \"\"\"Converts the list of Occurrence objects to a list of (row, col) tuples.\"\"\"\n        return [(o.row_index, o.col_index) for o in self.occurrences]\nclass SearchEngine:\n    \"\"\"Orchestrate searching and sorting of occurrences.\"\"\"\n    def __init__(self, request: SearchRequest) -> None:\n        self.request = request\n        self._occurrences: List[Occurrence] = []\n\n    def search(self, request: SearchRequest) -> Result:\n        \"\"\"Performs find_occurrences() then sort_occurrences() and returns Result.\"\"\"\n        self.find_occurrences()\n        sorted_occ = self.sort_occurrences(self._occurrences)\n        return Result(sorted_occ)\n\n    def find_occurrences(self) -> List[Occurrence]:\n        \"\"\"Scan request.lst and collect Occurrence objects.\"\"\"\n        found_occurrences: List[Occurrence] = []\n        nested_list = NestedList(self.request.lst)\n\n        for r_idx in range(len(nested_list)):\n            row = nested_list.get_row(r_idx)\n            for c_idx in range(len(row)):\n                if row[c_idx] == self.request.x:\n                    found_occurrences.append(Occurrence(r_idx, c_idx))\n        self._occurrences = found_occurrences\n        return found_occurrences\n\n    def sort_occurrences(self, occ: List[Occurrence]) -> List[Occurrence]:\n        \"\"\"Sort by row ascending and column descending.\"\"\"\n        return sorted(occ, key=lambda o: (o.row_index, -o.col_index))\ndef get_row(lst, x):\n    \"\"\"\n    Find integers x in the list and return list of coordinate tuples (row, columns).\n    Sort coordinates by rows in ascending order, then by columns in descending order.\n    \"\"\"\n    request = SearchRequest(lst=lst, x=x)\n    engine = SearchEngine(request)\n    result = engine.search(request)\n    return result.as_tuples()", 