 -> int:\n        \"\"\"Computes the n-th Fib4 number iteratively.\"\"\"\n        # Handle the base cases as defined for the sequence.\n        if n == 0:\n            return 0\n        if n == 1:\n            return 0\n        if n == 2:\n            return 2\n        if n == 3:\n            return 0\n        \n        # Initialize the four rolling state variables with the base values:\n        # a = fib4(k-4), b = fib4(k-3), c = fib4(k-2), d = fib4(k-1).\n        # These correspond to fib4(0), fib4(1), fib4(2), fib4(3) for the start of the loop (k=4).\n        a, b, c, d = 0, 0, 2, 0\n\n        # Iterate from the 4th element up to the desired n-th element.\n        for _ in range(4, n + 1):\n            next_val = d + c + b + a\n            # Update the rolling variables for the next iteration.\n            a = b\n            b = c\n            c = d\n            d = next_val\n        \n        return d\ndef fib4(n: int):\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    Please write a function to efficiently compute the n-th element of the fib4 number sequence.  Do not use recursion.\n    >>> fib4(5)\n    4\n    >>> fib4(6)\n    8\n    >>> fib4(7)\n    14\n    \"\"\"\n    # Validate that the input 'n' is an integer.\n    # As per design, a TypeError is raised for non-integer inputs.\n    if not Validation.is_integer(n):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    \n    # Create an instance of the calculator and compute the n-th Fib4 number.\n    calculator = Fib4Calculator()\n    return calculator.fib4(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/51": [{"task_id": "HumanEval/51", "solution": "from dataclasses import dataclass\nfrom typing import FrozenSet\nVOWEL_CHARS: FrozenSet[s