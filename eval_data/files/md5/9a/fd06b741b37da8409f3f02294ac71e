"Age\":\"36\", \"City\":\"Houston\"}) should return False.\n    check_dict_case({\"STATE\":\"NC\", \"ZIP\":\"12345\" }) should return True.\n    \"\"\"\n    evaluator = CheckDictCase(dict)\n    return evaluator.check()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/99": [{"task_id": "HumanEval/99", "solution": "import math\nfrom decimal import Decimal\nfrom dataclasses import dataclass\nclass Parser:\n    def _to_decimal(self, s: str) -> Decimal:\n        \"\"\"Internal helper to convert string to Decimal for precise parsing.\"\"\"\n        return Decimal(s)\n\n    def parse(self, s: str) -> float:\n        \"\"\"Parses a string representation of a number into a float.\"\"\"\n        decimal_value = self._to_decimal(s)\n        return float(decimal_value)\nclass Rounder:\n    EPSILON = 1e-9 # Tolerance for detecting exact 0.5 fractional part\n\n    def roundAwayFromZero(self, value: float) -> int:\n        \"\"\"Rounds a number away from zero.\"\"\"\n        if value >= 0:\n            return int(math.ceil(value))\n        else:\n            return int(math.floor(value))\n\n    def roundNearest(self, value: float) -> int:\n        \"\"\"\n        Rounds a number to the nearest integer,\n        rounding away from zero for exact 0.5 fractional parts.\n        \"\"\"\n        abs_value = abs(value)\n        floor_abs = math.floor(abs_value)\n        fractional_part_abs = abs_value - floor_abs\n\n        # Check for 0.5 tie case using epsilon\n        if abs(fractional_part_abs - 0.5) <= self.EPSILON:\n            return self.roundAwayFromZero(value)\n        else:\n            # Standard rounding to nearest for non-tie cases\n            if value >= 0:\n                return int(math.floor(value + 0.5))\n            else:\n                return int(math.ceil(value - 0.5))\ndef closest_integer(value):\n    '''\n    Create a function that takes a value (string) representing a number\n    and returns the closest integer to it. If the number is equidistant\n    from two integers, round it away from zero.\n\n    Examples\n    >>> closest_integer(\"10\")\n    10\n    >>> closest_integer(\"15.3\")\n    15\n\n    Note:\n    Rounding away from zero means that if the given number is equidistant\n    from two integers, the one you should return is the one that is the\n    farthest from zero. For example closest_integer(\"14.5\") should\n    return 15 and closest_integer(\"-14.5\") should return -15.\n    '''\n    parser = Parser()\n    parsed_value = parser.parse(value)\n    \n    parsed = ParsedNumber(value=parsed_value)\n    \n    rounder = Rounder()\n    result_int = rounder.roundNearest(parsed.value)\n    \n    rounded_result_obj = RoundedResult(value=result_int)\n    return rounded_result_obj.value", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [["10"]], "plus_fail_tests": [["-2.8"]]}], "HumanEval/98": [{"task_id": "HumanEval/98", "solution": "class InputString:\n    \"\"\"Domain value object for the input string.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n        self.length = len(value)\nclass Character:\n    \"\"\"Represent a character at a specific index and provide predicates.\"\"\"\n    def __init__(self, value: str, index: int) -> None:\n        self.value = value\n        self.index = index\n\n    def is_uppercase(self) -> bool:\n        \"\"\"Checks if the character is an uppercase letter.\"\"\"\n        return self.value.isupper()\n\n    def is_vowel(self) -> bool:\n        \"\"\"Checks if the character is one of the uppercase vowels.\"\"\"\n        return self.value in {'A', 'E', 'I', 'O', 'U'}\nclass VowelCounter:\n    \"\"\"Encapsulate the counting algorithm and uppercase-vowel set.\"\"\"\n    def __init__(self) -> None:\n        self.uppercase_vowels = {'A', 'E', 'I', 'O', 'U'}\n\n    def count_upper(self, s: str) -> int:\n        \"\"\"\n        Iterates through the input string at even indices to count