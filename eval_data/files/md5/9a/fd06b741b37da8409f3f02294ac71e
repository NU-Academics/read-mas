apts an array of integers into a tree branch concept.\"\"\"\n    def __init__(self, nodes: List[int]):\n        self.nodes: List[int] = nodes\n    def length(self) -> int:\n        return len(self.nodes)\n    def getNode(self, index: int) -> Node:\n        return Node(self.nodes[index], index)\nclass PluckResult:\n    \"\"\"Encapsulates the value and index of the plucked node.\"\"\"\n    def __init__(self, value: int, index: int):\n        self.value = value\n        self.index = index\n    def as_list(self) -> list:\n        return [self.value, self.index]\nclass PluckService:\n    \"\"\"Provides business logic for validating input and selecting the plucked node.\"\"\"\n    def pluck(self, branch: Branch) -> Optional[PluckResult]:\n        \"\"\"Orchestrates validation and selection.\"\"\"\n        if not self.validateInput(branch):\n            return None\n        return self.selectSmallestEven(branch)\n\n    def validateInput(self, branch: Branch) -> bool:\n        \"\"\"Validates branch length and node values.\"\"\"\n        if not (0 <= branch.length() <= 10000):\n            return False\n        for i in range(branch.length()):\n            node = branch.getNode(i)\n            if not (node.value >= 0): # Assuming node.value is int as per problem description\n                return False\n        return True\n\n    def selectSmallestEven(self, branch: Branch) -> Optional[PluckResult]:\n        \"\"\"Finds the smallest even value with the smallest index tie-breaker.\"\"\"\n        smallest_even_value = float('inf')\n        smallest_even_index = -1\n\n        for i in range(branch.length()):\n            node = branch.getNode(i)\n            if node.value % 2 == 0:\n                if node.value < smallest_even_value:\n                    smallest_even_value = node.value\n                    smallest_even_index = node.index\n\n        if smallest_even_index == -1:\n            return None\n        else:\n            return PluckResult(smallest_even_value, smallest_even_index)\ndef pluck(arr):\n    \"\"\"\n    Plucks the smallest even node from an array, returning its value and index.\n    \"\"\"\n    branch = Branch(arr)\n    service = PluckService()\n    result = service.pluck(branch)\n\n    if result is None:\n        return []\n    else:\n        return result.as_list()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/71": [{"task_id": "HumanEval/71", "solution": "import math\nclass Triangle:\n    \"\"\"Represents a triangle with three side lengths.\"\"\"\n    def __init__(self, a: float, b: float, c: float) -> None:\n        self.a = a\n        self.b = b\n        self.c = c\n\n    def isValid(self) -> bool:\n        \"\"\"Checks if the three sides form a valid triangle.\"\"\"\n        return (self.a + self.b > self.c and\n                self.a + self.c > self.b and\n                self.b + self.c > self.a and\n                self.a > 0 and self.b > 0 and self.c > 0)\n\n    def perimeter(self) -> float:\n        \"\"\"Calculates the perimeter of the triangle.\"\"\"\n        return self.a + self.b + self.c\nclass TriangleValidator:\n    \"\"\"Validates if a given Triangle instance is valid.\"\"\"\n    def validate(self, triangle: Triangle) -> bool:\n        \"\"\"Returns True if the triangle's sides satisfy the triangle inequality and are positive.\"\"\"\n        return triangle.isValid()\nclass AreaCalculator:\n    \"\"\"Computes the area of a triangle using Heron's formula.\"\"\"\n    def compute(self, triangle: Triangle) -> float:\n        \"\"\"Calculates the area of the triangle.\"\"\"\n        s = triangle.perimeter() / 2\n        # Ensure the value under square root is non-negative\n        # for float precision issues, though isValid() should prevent negative\n        arg = s * (s - triangle.a) * (s - triangle.b) * (s - triangle.c)\n        return math.sqrt(max(0.0, arg))\n\n    def compute_and_round(self, triangle: Triangle) -> float:\n        \"\"\"Computes the area and rounds it to two decimal places.\"\"\"\n        area = self.compute(triangle)\n        return round(area, 2)\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater \n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    '''\n    tri = Triangle(a, b, c)\n    validator = TriangleValidator()\n    if not validator.validate(tri):\n        return -1\n    \n    calculator = AreaCalculator()\n    rounded_area = calculator.compute_and_round(tri)\n    return rounded_area", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/69": [{"task_id": "HumanEval/69", "solution": "from typing import List, Dict\nfrom collections import Counter\nclass FrequencyCounter:\n    \"\"\"Computes frequency counts for integers in a list.\"\"\"\n    def computeCounts(self, lst: List[int]) -> Dict[int, int]:\n        \"\"\"Returns a dictionary mapping each integer to its frequency.\"\"\"\n        return Counter(lst)\nclass CandidateSelector:\n    \"\"\"Filters candidates and selects the greatest.\"\"\"\n    def filterByFrequency(self, counts: Dict[int, int]) -> List[int]:\n        \"\"\"Filters integers where frequency is greater than or equal to the integer's value and the integer is positive.\"\"\"\n        return [x for x in counts.keys() if x > 0 and counts[x] >= x]\n\n    def selectGreatest(self, candidates: List[int]) -> int:\n        \"\"\"Returns the greatest candidate or -1 if the list is empty.\"\"\"\n        if not candidates:\n            return -1\n        return max(candidates)\nclass SearchFunction:\n    \"\"\"Orchestrates frequency counting and candidate selection.\"\"\"\n    def search(self, lst: Li