 cases for x=1 and n=1, returning (is_edge, result_if_edge).\"\"\"\n    if x == 1:\n        if n > 0: # Per design's sequence diagram for (1,4)\n            return (True, True)\n    if n == 1:\n        # 1^k = x. This is only true if x is 1. If x=1, it's handled above if n>0.\n        # So if n=1 and x!=1, it's false.\n        return (True, False)\n    return (False, False)\ndef _validate_inputs(x, n):\n    \"\"\"Validates inputs for calculation, returning True if valid to proceed.\"\"\"\n    if n == 0:\n        # 0^k = x is only possible if x is 0 (for k>0) or x is 1 (for k=0).\n        return x == 0 or x == 1\n    if x == 0:\n        # If n is not 0, then n^k is never 0.\n        return False\n    if x < 0 and n > 0:\n        # If n is positive, n^k is always positive. Cannot equal negative x.\n        return False\n    return True\ndef _calculate_power_relationship(x, n):\n    \"\"\"Calculates if x is an integer power of n for integer k (k>=0 or k<0 leading to integer x).\"\"\"\n    \n    # Handle k=0 case: n^0 = 1 for any n != 0 (and 0^0=1 convention).\n    if x == 1:\n        return True\n\n    # Handle n=0, where _validate_inputs ensured x is 0.\n    if n == 0:\n        return x == 0 # (x=0 here implies 0^k=0 for k>0)\n\n    # Handle n = -1: (-1)^k = x. True if x is -1 (for odd k) or 1 (for even k, already caught above).\n    if n == -1:\n        return x == -1\n\n    # General case for abs(n) >= 2. Check for integer powers k >= 1 using division.\n    if x % n != 0:\n        return False\n\n    current_x = x\n    while current_x % n == 0:\n        current_x //= n\n    \n    # If current_x becomes 1, it means x was n^k for some k >= 1.\n    return current_x == 1", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/78": [{"task_id": "HumanEval/78", "solution": "def hex_key(num):\n    \"\"\"Counts the number of prime hexadecimal digits in a given hexadecimal string.\n    Prime hexadecimal digits are 2, 3, 5, 7