to the power of 'digits'.\n        Assumes 'digits' is a non-negative integer.\n        \"\"\"\n        return 10**digits\n\n    def handle_overlap_case(self, n: int) -> int:\n        \"\"\"\n        Calculates the count of n-digit numbers that start and end with 1.\n        Special handling for n=1 is included.\n        \"\"\"\n        if n == 1:\n            return 1\n        return self.calculate_digit_count(n - 2)\nclass DigitCounter:\n    \"\"\"\n    DigitCounter class orchestrates counting logic for n-digit numbers.\n    It counts numbers starting with 1, ending with 1, and calculates the total.\n    \"\"\"\n    def __init__(self):\n        \"\"\"Initializes DigitCounter with necessary utility instances.\"\"\"\n        self._calculator = MathematicalCalculator()\n        self._validator = InputValidator() \n\n    def count_starting_with_one(self, n: int) -> int:\n        \"\"\"\n        Counts n-digit numbers that start with the digit 1.\n        This uses the formula 10^(n-1).\n        \"\"\"\n        return self._calculator.calculate_digit_count(n - 1)\n\n    def count_ending_with_one(self, n: int) -> int:\n        \"\"\"\n        Counts n-digit numbers that end with the digit 1.\n        Special handling for n=1 is needed.\n        \"\"\"\n        if n == 1:\n            return 1\n        return 9 * self._calculator.calculate_digit_count(n - 2)\n\n    def calculate_total(self, n: int) -> int:\n        \"\"\"\n        Calculates the total count of n-digit numbers starting or ending with 1.\n        It applies the inclusion-exclusion principle.\n        \"\"\"\n        # The validator call here is a no-op due to critical requirements.\n        self._validator.is_positive_integer(n)\n        self._validator.validate_range(n)\n\n        count_starts = self.count_starting_with_one(n)\n        count_ends = self.count_ending_with_one(n)\n        count_overlap = self._calculator.handle_overlap_case(n)\n\n        return count_starts + count_ends - count_overlap\ndef