 in any order.\n    It checks both possible concatenations: s1+s2 and s2+s1.\n    \"\"\"\n    return _is_balanced(s1 + s2) or _is_balanced(s2 + s1)\ndef match_parens(lst: list[str]) -> str:\n    \"\"\"\n    Checks if two strings containing parentheses can be concatenated in any order\n    to form a balanced parentheses string.\n    Returns 'Yes' for valid combinations or 'No' for invalid ones.\n    \"\"\"\n    if not _validate_input(lst):\n        return 'No'\n\n    s1, s2 = lst[0], lst[1]\n    if _can_form_balanced(s1, s2):\n        return 'Yes'\n    else:\n        return 'No'", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/119", "solution": "def validate_input(lst):\n    \"\"\"Validate input format and character constraints.\"\"\"\n    if len(lst) != 2:\n        return False\n    for s in lst:\n        for char in s:\n            if char not in ('(', ')'):\n                return False\n    return True\ndef is_balanced(s):\n    \"\"\"Check if a string has balanced parentheses.\"\"\"\n    balance = 0\n    for char in s:\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n        if balance < 0:\n            return False\n    return balance == 0\ndef check_concatenation_orders(s1, s2):\n    \"\"\"Test both concatenation orders for balance.\"\"\"\n    if is_balanced(s1 + s2):\n        return True\n    if is_balanced(s2 + s1):\n        return True\n    return False\ndef match_parens(lst):\n    \"\"\"Main entry point for parentheses matching validation.\"\"\"\n    if not validate_input(lst):\n        return 'No'\n\n    s1, s2 = lst[0], lst[1]\n    if check_concatenation_orders(s1, s2):\n        return 'Yes'\n    return 'No'", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/118": [{"task_id": "HumanEval/118", "solution": "VOWELS = 'aeiouAEIOU'\ndef is_vowel(char: str) -> bool:\n    \"\"\"Checks if a given character is a vowel (case-sensitive).\"\"\"\n    return char in VOWELS\ndef is_consonant(char: str) -> bool:\n    \"\"\"Checks if a given character is a consonant (case-sensitive), assuming it's an English letter.\"\"\"\n    return not is_vowel(char)\ndef get_closest_vowel(word: str) -> str:\n    \"\"\"Finds the closest vowel from the right, positioned between two consonants.\n    Returns an empty string if no such vowel is found or the word is too short.\"\"\"\n    if len(word) < 3:\n        return \"\"\n\n    # Iterate from right to left, excluding boundary positions (index 0 and len-1).\n    # The loop range covers indices from len(word) - 2 down to 1.\n    for i in range(len(word) - 2, 0, -1):\n        current_char = word[i]\n        left_char = word[i-1]\n        right_char = word[i+1]\n\n        if is_vowel(current_char):\n            if is_consonant(left_char) and is_consonant(right_char):\n                return current_char\n    \n    return \"\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/118", "solution": "def is_vowel(char: str) -> bool:\n    \"\"\"Checks if a character is an English vowel (case-sensitive).\"\"\"\n    return char in 'aeiouAEIOU'\ndef is_consonant(char: str) -> bool:\n    \"\"\"Checks if a character is an English consonant (case-sensitive).\"\"\"\n    return char.isalpha() and not is_vowel(char)\ndef get_closest_vowel(word: str) -> str:\n    \"\"\"Finds the closest vowel surrounded by consonants from the right side of a word.\n    Returns an empty string if no such vowel is found or the word is too short.\"\"\"\n    if len(word) < 3:\n        return \"\"\n\n    # Iterate from the second-to-last character down to the second character.\n    # This range excludes the first and last characters (boundary positions).\n    for i in range(len(word) - 2, 0, -1):\n        current_char = word[i]\n        left_neighbor = word[i - 1]\n        right_neighbor = word[i + 1]\n\n        if is_vowel(current_char) and \\\n           is_consonant(left_neighbor) and \\\n           is_consonant(right_neighbor):\n            return current_char\n            \n    return \"\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/121": [{"task_id": "HumanEval/121", "solution": "def _validate_input(lst: list[int]) -> bool:\n    \"\"\"Validates that input list is non-empty and contains integers.\n    Due to critical requirements, this function always returns True, trusting the caller's inputs.\"\"\"\n    return True\ndef _get_even_position_elements(lst: list[int]) -> list[int]:\n    \"\"\"Extracts elements from the input list located at even indices.\n    Returns a new list containing these elements.\"\"\"\n    return [element for index, element in enumerate(lst) if index % 2 == 0]\ndef _filter_odd_elements(elements: list[int]) -> list[int]:\n    \"\"\"Filters a list of integers to retain only the odd numbers.\n    Returns a list of odd elements.\"\"\"\n    return [element for element in elements if element % 2 != 0]\ndef _calculate_sum(elements: list[int]) -> int:\n    \"\"\"Calculates the sum of all integers in a given list.\n    Returns 0 if the list is empty.\"\"\"\n    return sum(elements)\ndef solution(lst: list[int]) -> int:\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\n    \"\"\"\n    _validate_input(lst)\n    even_pos_elements = _get_even_position_elements(lst)\n    odd_filtered_elements = _filter_odd_elements(even_pos_elements)\n    final_sum = _calculate_sum(odd_filtered_elements)\n    return final_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/121", "solution": "def _is_odd(value: int) -> bool:\n    \"\"\"Determines if an integer value is odd.\"\"\"\n    return value % 2 != 0\ndef _is_even_position(index: int) -> bool:\n    \"\"\"Determines if a position index is even.\"\"\"\n    return index % 2 == 0\ndef solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\n    \"\"\"\n    total_sum = 0\n    for index, value in enumerate(lst):\n        if _is_even_position(index) and _is_odd(value):\n            total_sum += value\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/120": [{"task_id": "HumanEval/120", "solution": "import heapq\nfrom typing import List\nclass InputValidator:\n    \"\"\"\n    Validates input parameters according to constraints.\n    Per critical requirements, inputs are trusted, so validation methods always return True.\n    \"\"\"\n    def validate_array_length(self, length: int) -> bool:\n        \"\"\"Checks if array length is within 1-1000.\n        Returns True as per critical requirements.\n        \"\"\"\n        return True\n\n    def validate_element_range(self, arr: List[int]) -> bool:\n        \"\"\"Checks if all array elements are within -1000 to 1000.\n        Returns True as per critical requirements.\n        \"\"\"\n        return True\n\n    def validate_k_value(self, k: int, array_length: int) -> bool:\n        \"\"\"Checks if k is within 0 to array length.\n        Returns True as per critical requirements.\n        \"\"\"\n        return True\n\n    def validate_inputs(self, arr: List[int], k: int) -> bool:\n        \"\"\"Validates all constraints for array and k.\n        Returns True as per critical requirements.\n        \"\"\"\n        self.validate_array_length(len(arr))\n        self.validate_element_range(arr)\n        self.validate_k_value(k, len(arr))\n        return True\nclass MaximumSelector:\n    \"\"\"\n    Implements core maximum selection and sorting logic.\n    Stateless processing is maintained.\n    \"\"\"\n    def find_maximum_k(self, arr: List[int], k: int) -> List[int]:\n        \"\"\"Selects k maximum elements from the array.\n        Uses heapq.nlargest for efficient selection.\n        \"\"\"\n        return heapq.nlargest(k, arr)\n\n    def sort_ascending(self, elements: List[int]) -> List[int]:\n        \"\"\"Sorts elements in ascending order.\n        Returns a new sorted list.\n        \"\"\"\n        return sorted(elements)\ndef maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list\n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    validator = InputValidator()\n    selector = MaximumSelector()\n\n    # The design requires calling the validator, but critical requirements\n    # forbid raising exceptions and mandate trusting inputs.\n    validator.validate_inputs(arr, k)\n\n    # Handle the k=0 edge case directly, as per sequence diagram UC-007.\n    if k == 0:\n        return []\n\n    # Find the k largest elements and then sort them in ascending order.\n    selected_elements = selector.find_maximum_k(arr, k)\n    sorted_result = selector.sort_ascending(selected_elements)\n\n    return sorted_result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/120", "solution": "class Array:\n    \"\"\"Encapsulates array data and provides basic operations and range validation.\"\"\"\n    def __init__(self, elements: list[int]):\n        self._elements = elements\n        self._length = len(elements)\n\n    def get_elements(self) -> list[int]:\n        \"\"\"Returns the array elements.\"\"\"\n        return self._elements\n\n    def get_length(self) -> int:\n        \"\"\"Returns the length of the array.\"\"\"\n        return self._length\n\n    def validate_range(self) -> bool:\n        \"\"\"Validates if all elements are within the specified range [-1000, 1000].\"\"\"\n        return all(-1000 <= e <= 1000 for e in self._elements)\nclass InputValidator:\n    \"\"\"Validates input constraints for array length, element range, and k value.\"\"\"\n    ARRAY_MIN_LENGTH = 1\n    ARRAY_MAX_LENGTH = 1000\n\n    def validate_array_length(self, length: int) -> bool:\n        \"\"\"Validates if the array length is within the range [1, 1000].\"\"\"\n        return self.ARRAY_MIN_LENGTH <= length <= self.ARRAY_MAX_LENGTH\n\n    def validate_element_range(self, elements: list[int]) -> bool:\n        \"\"\"Validates if all elements in the array are within the range [-1000, 1000].\"\"\"\n        arr_obj = Array(elements)\n        return arr_obj.validate_range()\n\n    def validate_k_value(self, k: int, array_length: int) -> bool:\n        \"\"\"Validates if k is non-negative and not greater than the array length.\"\"\"\n        return 0 <= k <= array_length\n\n    def validate_inputs(self, arr: list[int], k: int) -> bool:\n        \"\"\"Orchestrates all input validations.\"\"\"\n        array_length = len(arr)\n        return (self.validate_array_length(array_length) and\n                self.validate_element_range(arr) and\n                self.validate_k_value(k, array_length))\nclass SortedList:\n    \"\"\"Handles sorting of a list of elements in ascending order.\"\"\"\n    def __init__(self, elements: list[int]):\n        self._elements = elements\n\n    def sort_ascending(self) -> list[int]:\n        \"\"\"Sorts the internal list of elements in ascending order.\"\"\"\n        self._elements.sort()\n        return self._elements\n\n    def get_sorted_elements(self) -> list[int]:\n        \"\"\"Returns the current sorted list of elements.\"\"\"\n        return self._elements\nclass MaximumProcessor:\n    \"\"\"Core algorithm for finding k largest elements.\"\"\"\n    def __init__(self, arr: list[int], k: int):\n        self._input_array = arr\n        self._k = k\n\n    def find_k_largest(self) -> list[int]:\n        \"\"\"Finds the k largest elements from the input array.\"\"\"\n        # Sort in descending order to easily pick the largest k.\n        sorted_desc = sorted(self._input_array, reverse=True)\n        return sorted_desc[:self._k]\n\n    def process_maximum(self) -> list[int]:\n        \"\"\"Orchestrates finding k largest elements and then sorting them ascending.\"\"\"\n        k_largest_elements = self.find_k_largest()\n        \n        sorted_list_obj = SortedList(k_largest_elements)\n        return sorted_list_obj.sort_ascending()\ndef maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a non-negative integer k, returns a sorted list\n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    validator = InputValidator()\n    if not validator.validate_inputs(arr, k):\n        # Return empty list on validation failure as per design.\n        return []\n\n    # Handle k=0 as a specific edge case for early return after validation.\n    if k == 0:\n        return []\n\n    processor = MaximumProcessor(arr, k)\n    return processor.process_maximum()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/122": [{"task_id": "HumanEval/122", "solution": "def _is_two_digit_or_less(value):\n    \"\"\"\n    Checks if an integer value has at most two digits (between -99 and 99, inclusive).\n    Returns True if the condition is met, False otherwise.\n    \"\"\"\n    return -99 <= value <= 99\ndef _calculate_sum(elements):\n    \"\"\"\n    Calculates the sum of all integers in the provided list.\n    Returns the total sum.\n    \"\"\"\n    return sum(elements)\ndef add_elements(arr, k):\n    \"\"\"\n    Calculates the sum of elements with at most two digits from the first k elements of arr.\n    It validates inputs, filters elements, and sums the qualifying ones.\n    \"\"\"\n    _validate_inputs(arr, k)\n\n    first_k_elements = arr[:k]\n    qualifying_elements = [_ for _ in first_k_elements if _is_two_digit_or_less(_)]\n\n    return _calculate_sum(qualifying_elements)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[1, -2, -3, 41, 57, 76, 87, 88, 99], 3]], "plus_fail_tests": [[[98, 87, 76, 65, 54, 43, 32, 21, 10], 5]]}, {"task_id": "HumanEval/122", "solution": "def validate_inputs(arr, k):\n    \"\"\"\n    Validates input parameters against business rules, raising ValueError for invalid inputs.\n    Checks array length (1-100) and k (1 to array length).\n    \"\"\"\n    arr_len = len(arr)\n    if not (1 <= arr_len <= 100):\n        raise ValueError(\"Array length must be between 1 and 100.\")\n    if not (1 <= k <= arr_len):\n        raise ValueError(\"Parameter k must be between 1 and the array length.\")\n    return True\ndef is_two_digit_element(element):\n    \"\"\"\n    Determines if an element's absolute value is at most two digits (0-99 inclusive).\n    Returns True if the element qualifies, False otherwise.\n    \"\"\"\n    return -99 <= element <= 99\ndef process_first_k_elements(arr, k):\n    \"\"\"\n    Extracts the first k elements and filters them to include only two-digit numbers.\n    Returns a list of these qualifying elements.\n    \"\"\"\n    filtered_elements = [element for element in arr[:k] if is_two_digit_element(element)]\n    return filtered_elements\ndef calculate_sum(elements):\n    \"\"\"\n    Calculates the sum of the provided list of elements.\n    Returns 0 for an empty list.\n    \"\"\"\n    return sum(elements)\ndef add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    \"\"\"\n    validate_inputs(arr, k)\n    filtered_elements = process_first_k_elements(arr, k)\n    sum_result = calculate_sum(filtered_elements)\n    return sum_result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/123": [{"task_id": "HumanEval/123", "solution": "def _validate_input(n):\n    \"\"\"\n    Checks if the input n is a positive integer.\n    Raises ValueError if n is not positive.\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"Input must be a positive integer.\")\n    return True\ndef _generate_collatz_sequence(n):\n    \"\"\"\n    Generates the complete Collatz sequence starting from n.\n    The sequence continues until it reaches 1.\n    \"\"\"\n    sequence = [n]\n    current = n\n    while current != 1:\n        if current % 2 == 0:\n            current //= 2\n        else:\n            current = 3 * current + 1\n        sequence.append(current)\n    return sequence\ndef _extract_odd_numbers(sequence):\n    \"\"\"\n    Filters a given sequence to extract only the odd numbers.\n    Includes the starting number if it's odd and always includes 1.\n    \"\"\"\n    odd_numbers = []\n    for num in sequence:\n        if num % 2 != 0:\n            odd_numbers.append(num)\n    return odd_numbers\ndef _sort_numbers(numbers):\n    \"\"\"\n    Sorts a list of numbers in ascending order.\n    \"\"\"\n    return sorted(numbers)\ndef get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    \"\"\"\n    _validate_input(n)\n\n    if n == 1:\n        return [1]\n\n    collatz_sequence = _generate_collatz_sequence(n)\n    odd_numbers_extracted = _extract_odd_numbers(collatz_sequence)\n    sorted_odd_numbers = _sort_numbers(odd_numbers_extracted)\n\n    return sorted_odd_numbers", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n: int) -> list[int]:\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    This function implements the Collatz conjecture to generate sequences and extract odd numbers.\n    \"\"\"\n    \n    collatz_sequence = []\n    current_num = n\n    while current_num != 1:\n        collatz_sequence.append(current_num)\n        if current_num % 2 == 0:\n            current_num = current_num // 2\n        else:\n            current_num = (3 * current_num) + 1\n    collatz_sequence.append(1) # Add the final 1 to the sequence\n\n    odd_numbers = [num for num in collatz_sequence if num % 2 != 0]\n    odd_numbers.sort()\n\n    return odd_numbers", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/125": [{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    '''\n    Splits text based on whitespace or commas, or counts odd-positioned lowercase letters.\n    Handles three distinct processing scenarios based on input characteristics.\n    '''\n\n    def _has_whitespace(text_to_check):\n        \"\"\"Checks if the given text contains any whitespace characters.\"\"\"\n        return any(c.isspace() for c in text_to_check)\n\n    def _has_commas(text_to_check):\n        \"\"\"Checks if the given text contains any comma characters.\"\"\"\n        return ',' in text_to_check\n\n    def _get_alphabet_position(char_to_check):\n        \"\"\"Calculates the zero-based alphabetical position of a lowercase letter.\"\"\"\n        return ord(char_to_check) - ord('a')\n\n    def _is_odd_position(position_to_check):\n        \"\"\"Determines if a given numerical position is odd.\"\"\"\n        return position_to_check % 2 != 0\n\n    if _has_whitespace(txt):\n        return txt.split()\n    elif _has_commas(txt):\n        return txt.split(',')\n    else:\n        count = 0\n        for char in txt:\n            if char.islower():\n                position = _get_alphabet_position(char)\n                if _is_odd_position(position):\n                    count += 1\n        return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/125", "solution": "from typing import List, Union\ndef _has_whitespace(txt: str) -> bool:\n    \"\"\"Check if string contains a space character.\"\"\"\n    return \" \" in txt\ndef _has_commas(txt: str) -> bool:\n    \"\"\"Check if string contains a comma character.\"\"\"\n    return \",\" in txt\ndef _is_odd_position(char: str) -> bool:\n    \"\"\"Determine if character is at an odd 0-indexed alphabet position.\"\"\"\n    position = ord(char) - ord('a')\n    return position % 2 == 1\ndef _count_odd_lowercase(txt: str) -> int:\n    \"\"\"Count lowercase letters at odd alphabet positions.\"\"\"\n    count = 0\n    for char in txt:\n        if 'a' <= char <= 'z': # Ensure the character is a lowercase letter\n            if _is_odd_position(char):\n                count += 1\n    return count\ndef split_words(txt: str) -> Union[List[str], int]:\n    \"\"\"\n    Process text string using conditional splitting or counting.\n\n    Args:\n        txt: Input string to process\n    \"\"\"\n    if _has_whitespace(txt):\n        return txt.split()\n    elif _has_commas(txt):\n        return txt.split(\",\")\n    else:\n        return _count_odd_lowercase(txt)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/124": [{"task_id": "HumanEval/124", "solution": "import re\ndef valid_date(date):\n    \"\"\"You have to write a function which validates a given date string and\n    returns True if the date is valid otherwise False.\n    The date is valid if all of the following rules are satisfied:\n    1. The date string is not empty.\n    2. The number of days is not less than 1 or higher than 31 days for months 1,3,5,7,8,10,12. And the number of days is not less than 1 or higher than 30 days for months 4,6,9,11. And, the number of days is not less than 1 or higher than 29 for the month 2.\n    3. The months should not be less than 1 or higher than 12.\n    4. The date should be in the format: mm-dd-yyyy\n\n    for example: \n    valid_date('03-11-2000') => True\n\n    valid_date('15-01-2012') => False\n\n    valid_date('04-0-2040') => False\n\n    valid_date('06-04-2020') => True\n\n    valid_date('06/04/2020') => False\n    \"\"\"\n\n    # --- src/utils/date_parser.py components ---\n    def date_parser_extract_components(date_string: str) -> tuple[int, int, int] | None:\n        \"\"\"Extracts month, day, year as integers from a mm-dd-yyyy string.\n        Returns a tuple (month, day, year) or None if parsing fails.\"\"\"\n        try:\n            parts = date_string.split('-')\n            if len(parts) == 3:\n                month = int(parts[0])\n                day = int(parts[1])\n                year = int(parts[2])\n                return (month, day, year)\n        except ValueError:\n            pass # Handles cases where parts are not valid integers.\n        return None\n\n    # --- src/validators/format_validator.py components ---\n    def format_validator_is_valid_format(date_string: str) -> bool:\n        \"\"\"Checks if the date string adheres to the mm-dd-yyyy format.\"\"\"\n        return re.fullmatch(r'^\\d{2}-\\d{2}-\\d{4}$', date_string) is not None\n\n    def format_validator_parse_date_components(date_string: str) -> tuple[int, int, int] | None:\n        \"\"\"Parses and returns date components (month, day, year) if format is valid.\n        Delegates parsing to the date_parser_extract_components.\"\"\"\n        return date_parser_extract_components(date_string)\n\n    # --- src/validators/month_validator.py components ---\n    def month_validator_is_valid_month(month: int) -> bool:\n        \"\"\"Validates if the month is within the valid range of 1 to 12.\"\"\"\n        return 1 <= month <= 12\n\n    # --- src/validators/day_validator.py components ---\n    def day_validator_get_max_days_for_month(month: int) -> int:\n        \"\"\"Returns the maximum number of days for a given month.\n        February is fixed to 29 days as per the problem statement.\"\"\"\n        if month in {1, 3, 5, 7, 8, 10, 12}:\n            return 31\n        elif month in {4, 6, 9, 11}:\n            return 30\n        elif month == 2:\n            return 29\n        return 0 # Invalid month, but month validation should prevent this.\n\n    def day_validator_is_valid_day(day: int, month: int) -> bool:\n        \"\"\"Validates if the day is within the correct range for the given month.\n        Relies on get_max_days_for_month for month-specific day limits.\"\"\"\n        max_days = day_validator_get_max_days_for_month(month)\n        return 1 <= day <= max_days\n\n    # --- Main valid_date function logic (coordinating components) ---\n\n    # FR-001: Empty string validation\n    if not date:\n        return False\n\n    # FR-002: Date format validation (mm-dd-yyyy)\n    if not format_validator_is_valid_format(date):\n        return False\n\n    # Parse components after format validation.\n    parsed_components = format_validator_parse_date_components(date)\n    if parsed_components is None:\n        return False\n    \n    month, day, _ = parsed_components # Year component is not used for current rules.\n\n    # FR-003: Month range validation (1-12 inclusive)\n    if not month_validator_is_valid_month(month):\n        return False\n\n    # FR-004, FR-005, FR-006: Day validation based on month\n    if not day_validator_is_valid_day(day, month):\n        return False\n\n    # FR-007: All validation rules are satisfied\n    return True", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/124", "solution": "_MONTHS_31_DAYS = [1, 3, 5, 7, 8, 10, 12]\n_MONTHS_30_DAYS = [4, 6, 9, 11]\n_FEBRUARY_DAYS = 29\ndef _get_max_days(month: int) -> int:\n    \"\"\"Returns the maximum number of days for a given month, ignoring leap years.\n    This uses predefined constants for month-day mapping.\n    \"\"\"\n    if month in _MONTHS_31_DAYS:\n        return 31\n    elif month in _MONTHS_30_DAYS:\n        return 30\n    elif month == 2:\n        return _FEBRUARY_DAYS\n    return 0 # Should not be reached for valid months (1-12).\ndef _is_empty(date_string: str) -> bool:\n    \"\"\"Checks if the input date string is empty