    def _get_sort_key(num):\n        \"\"\"\n        Generates a sort key tuple (binary_ones_count, decimal_value) for a given integer.\n        The ones count is determined by the absolute value's binary representation.\n        \"\"\"\n        ones = _count_ones(num)\n        return (ones, num)\n\n    return sorted(arr, key=_get_sort_key)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/116", "solution": "def count_ones_in_binary(num: int) -> int:\n    \"\"\"Count number of ones in binary representation.\"\"\"\n    # For non-negative numbers, count ones in their binary string.\n    return bin(num).count('1')\ndef get_sort_key(num: int) -> tuple:\n    \"\"\"Generate sort key tuple for given number.\"\"\"\n    # Negative numbers are sorted first by their decimal value.\n    # Non-negative numbers are sorted by ones count, then decimal value.\n    if num < 0:\n        return (0, 0, num)\n    else:\n        return (1, count_ones_in_binary(num), num)\ndef sort_array(arr: list) -> list:\n    \"\"\"Sort array by binary ones count, then by decimal value.\"\"\"\n    # Uses a custom key function to sort based on the defined criteria.\n    return sorted(arr, key=get_sort_key)", "base_status": "fail", "plus_status": "pass", "base_fail_tests": [[[-2, -3, -4, -5, -6]]], "plus_fail_tests": []}], "HumanEval/117": [{"task_id": "HumanEval/117", "solution": "_VOWELS = \"aeiouAEIOU\"\ndef _is_consonant(char: str) -> bool:\n    \"\"\"Determines if a character is a consonant.\"\"\"\n    return char.isalpha() and char not in _VOWELS\ndef _count_consonants(word: str) -> int:\n    \"\"\"Counts the number of consonants in a given word.\"\"\"\n    count = 0\n    for char in word:\n        if _is_consonant(char):\n            count += 1\n    return count\ndef _split_words(s: str) -> list[str]:\n    \"\"\"Splits an input string into individual words.\"\"\"\n    return [word for word in s.split() if word]\ndef select_words(s: str, n: int) -> list[str]:\n    \"\"\"Given a string s and a natural number n, returns a list of words from s \n    that contain exactly n consonants, maintaining original order.\"\"\"\n    if not s:\n        return []\n\n    words = _split_words(s)\n    \n    filtered_words = []\n    for word in words:\n        if _count_consonants(word) == n:\n            filtered_words.append(word)\n            \n    return filtered_words", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/117", "solution": "class ConsonantCounter:\n    \"\"\"Provides consonant counting logic and vowel detection.\"\"\"\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    def is_vowel(self, char: str) -> bool:\n        \"\"\"Checks if a character is a vowel.\"\"\"\n        return char.lower() in ConsonantCounter.VOWELS\n\n    def is_consonant(self, char: str) -> bool:\n        \"\"\"Checks if a character is a consonant.\"\"\"\n        return char.isalpha() and not self.is_vowel(char)\n\n    def count(self, word: str) -> int:\n        \"\"\"Counts consonants in a word.\"\"\"\n        consonant_count = 0\n        for char in word:\n            if self.is_consonant(char):\n                consonant_count += 1\n        return consonant_count\nclass Word:\n    \"\"\"Represents a word with its text, position, and calculated consonant count.\"\"\"\n    def __init__(self, text: str, position: int):\n        self.text = text\n        self.position = position\n        self.consonant_count = self._calculate_consonants()\n\n    def _calculate_consonants(self) -> int:\n        \"\"\"Calculates the number of consonants in the word's text.\"\"\"\n        counter = ConsonantCounter()\n        return counter.count(self.text)\nclass WordProcessor:\n    \"\"\"Orchestrates word processing and filtering operations.\"\"\"\n    def split_into_words(self, text: str) -> list[str]:\n        \"\"\"Splits an input string into a list of words using space delimiters.