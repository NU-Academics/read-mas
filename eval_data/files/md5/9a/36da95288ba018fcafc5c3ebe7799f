 triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or \n    90 degree.\n    '''\n    # Identify the potential hypotenuse by finding the longest side.\n    # The sum of squares of the two shorter sides should equal the square of the longest side.\n    sides = sorted([a, b, c])\n    \n    # Calculate the squares of the sides.\n    side1_sq = sides[0] * sides[0]\n    side2_sq = sides[1] * sides[1]\n    hypotenuse_sq = sides[2] * sides[2]\n    \n    # Compare the sum of squares of the two shorter sides with the square of the longest side.\n    # Use a small tolerance for floating-point comparisons.\n    epsilon = 1e-9 \n    return abs((side1_sq + side2_sq) - hypotenuse_sq) < epsilon", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}, {"task_id": "HumanEval/157", "solution": "EPSILON = 1e-9\ndef _compare_with_tolerance(val1, val2):\n    \"\"\"Compares two floating-point values with a predefined tolerance.\"\"\"\n    return abs(val1 - val2) < EPSILON\ndef _validate_pythagorean_theorem(sides):\n    \"\"\"Checks if any permutation of the given sides satisfies the Pythagorean theorem.\"\"\"\n    s1, s2, s3 = sides\n    return (_compare_with_tolerance(s1**2 + s2**2, s3**2) or\n            _compare_with_tolerance(s1**2 + s3**2, s2**2) or\n            _compare_with_tolerance(s2**2 + s3**2, s1**2))\ndef right_angle_triangle(a, b, c):\n    \"\"\"\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    \"\"\"\n    return _validate_pythagorean_theorem((a, b, c))", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/158": [{"task_id": "HumanEval/158", "solution": "from typing import List\ndef count_unique_chars(word: str) -> int:\n    \"\"\"Counts unique characters in a string using a set.\"\"\"\n    return len(set(word))\ndef find_lexicographicall