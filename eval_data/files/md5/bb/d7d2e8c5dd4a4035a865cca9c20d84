{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n):\n    \"\"\"Finds the smallest power of 2 greater than or equal to n. Assumes n is a non-negative integer.\"\"\"\n    if n == 0:\n        return 1\n\n    # Check if n is already a power of two (for n > 0).\n    # A number is a power of two if it's positive and (n & (n - 1)) == 0.\n    if (n & (n - 1)) == 0:\n        return n\n\n    # Otherwise, compute the smallest power of two strictly greater than n.\n    # This bit manipulation trick sets all bits to the right of the MSB to 1, then adding 1 results in the next power of 2.\n    n |= n >> 1\n    n |= n >> 2\n    n |= n >> 4\n    n |= n >> 8\n    n |= n >> 16\n    n |= n >> 32\n    return n + 1"}
{"task_id": "Mbpp/170", "solution": "class SumResult:\n    def __init__(self, value):\n        self.value = value\n\nclass IndexRange:\n    def __init__(self, start: int, end: int):\n        self.start = start\n        self.end = end\n\n    def is_valid(self) -> bool:\n        # Checks if start index is less than or equal to end index.\n        return self.start <= self.end\n\nclass NumericList:\n    def __init__(self, elements: list):\n        if not isinstance(elements, list):\n            raise TypeError(\"Input 'numbers' must be a list.\")\n        self.elements = elements\n        self.length = len(elements)\n\n    def __len__(self) -> int:\n        return self.length\n\n    def get_slice(self, start: int, end: int) -> list:\n        # Returns a slice from the list, inclusive of both start and end indices.\n        return self.elements[start : end + 1]\n\nclass SumRangeFunction:\n    def __init__(self, numbers: list, start_index: int, end_index: int):\n        self.numeric_list = NumericList(numbers)\n        self.start_index = start_index\n        self.end_index = end_index\n        self.sum_result = None\n\n    def validate_indices(self) -> None:\n        # Validates types and bounds of indices, raising appropriate errors.\n        if not isinstance(self.start_index, int) or not isinstance(self.end_index, int):\n            raise TypeError(\"start_index and end_index must be integers.\")\n\n        index_range = IndexRange(self.start_index, self.end_index)\n        if not index_range.is_valid():\n            raise ValueError(\"start_index must be less than or equal to end_index.\")\n\n        list_length = len(self.numeric_list)\n        if self.start_index < 0 or self.end_index < 0:\n            raise IndexError(\"Negative indices are invalid.\")\n        if not (self.start_index < list_length and self.end_index < list_length):\n            raise IndexError(\"Indices must be within the bounds of the list (0 to len(numbers)-1).\")\n\n    def compute_sum(self) -> float:\n        # Computes the sum of elements within the specified range, checking for numeric types.\n        current_sum = 0\n        has_float = False\n        selected_elements = self.numeric_list.get_slice(self.start_index, self.end_index)\n\n        for element in selected_elements:\n            if not isinstance(element, (int, float)):\n                raise TypeError(\"All elements in the specified range must be numeric (int or float).\")\n            if isinstance(element, float):\n                has_float = True\n            current_sum += element\n\n        if has_float:\n            self.sum_result = SumResult(float(current_sum))\n        else:\n            self.sum_result = SumResult(int(current_sum))\n        return self.sum_result.value\n\ndef sum_range_list(numbers, start_index, end_index):\n    \"\"\"Return inclusive sum of numbers[start_index..end_index].\n\n    Raises:\n      TypeError: if numbers is not list, indices not ints, or a non-numeric element is encountered in range\n      ValueError: if start_index > end_index\n      IndexError: if indices out of allowed bounds (0..len(numbers)-1) or negative\n    \"\"\"\n    sum_calculator = SumRangeFunction(numbers, start_index, end_index)\n    sum_calculator.validate_indices()\n    return sum_calculator.compute_sum()"}
{"task_id": "Mbpp/222", "solution": "def check_type(inputTuple: tuple) -> bool:\n    \"\"\"\n    Checks if all elements in the given tuple have the same data type.\n    Returns True for empty or single-element tuples.\n    \"\"\"\n    if not isinstance(inputTuple, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n\n    if len(inputTuple) <= 1:\n        return True\n\n    first_element_type = type(inputTuple[0])\n    for i in range(1, len(inputTuple)):\n        if type(inputTuple[i]) is not first_element_type:\n            return False\n    return True"}
