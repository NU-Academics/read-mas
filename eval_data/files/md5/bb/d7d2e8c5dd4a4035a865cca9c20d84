{"task_id": "Mbpp/439", "solution": "from dataclasses import dataclass\nfrom typing import List\n\nclass InputValidator:\n    \"\"\"Validates the input for multiple_to_single function.\"\"\"\n    @staticmethod\n    def validate(list_of_integers: List[int]) -> bool:\n        \"\"\"Checks if the input is a list of integers.\"\"\"\n        if not isinstance(list_of_integers, list):\n            return False\n        for item in list_of_integers:\n            if not isinstance(item, int):\n                return False\n        return True\n\n    @staticmethod\n    def validate_or_raise(list_of_integers: List[int]) -> None:\n        \"\"\"Raises ValueError if the input is not a list of integers.\"\"\"\n        if not isinstance(list_of_integers, list):\n            raise ValueError(\"Input must be a list.\")\n        for item in list_of_integers:\n            if not isinstance(item, int):\n                raise ValueError(\"All elements in the list must be integers.\")\n\n@dataclass\nclass IntegerList:\n    \"\"\"Represents the input list of integers.\"\"\"\n    values: List[int]\n\n@dataclass\nclass ConcatenatedInteger:\n    \"\"\"Represents the single integer output.\"\"\"\n    value: int\n\ndef multiple_to_single(list_of_integers: List[int]) -> int:\n    \"\"\"\n    Joins a list of multiple integers into a single integer.\n    E.g., [11, 33, 50] becomes 113350.\n    \"\"\"\n    InputValidator.validate_or_raise(list_of_integers)\n\n    input_data = IntegerList(values=list_of_integers)\n\n    string_parts = [str(x) for x in input_data.values]\n    concatenated_string = \"\".join(string_parts)\n    \n    # Handle empty list case explicitly before converting to int, though \"\" -> 0 is default behavior for int()\n    if not concatenated_string:\n        result_int = 0\n    else:\n        result_int = int(concatenated_string)\n\n    output_data = ConcatenatedInteger(value=result_int)\n    return output_data.value"}
{"task_id": "Mbpp/446", "solution": "def count_Occurrence(t: tuple, l: list) -> int:\n    \"\"\"Return total number of occurrences in tuple t of elements present in list l.\n\n    Comparison uses Python's == operator to determine matches.\n    \"\"\"\n    count = 0\n    for element in t:\n        for candidate in l:\n            if element == candidate:\n                count += 1\n                break\n    return count"}
{"task_id": "Mbpp/445", "solution": "class ValidationError(Exception):\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass Validator:\n    def validate_top_level_length(self, a: tuple, b: tuple) -> None:\n        if len(a) != len(b):\n            raise ValidationError(\"Top-level tuples must have the same length.\")\n\n    def validate_nested_lengths(self, a: tuple, b: tuple) -> None:\n        for i in range(len(a)):\n            if len(a[i]) != len(b[i]):\n                raise ValidationError(f\"Nested tuples at index {i} must have the same length.\")\n\n    def validate_element_types(self, a: tuple, b: tuple) -> None:\n        for i in range(len(a)):\n            for j in range(len(a[i])):\n                if not isinstance(a[i][j], (int, float)) or not isinstance(b[i][j], (int, float)):\n                    raise ValidationError(f\"Elements at [{i}][{j}] must be numeric (int or float).\")\n\nclass Multiplier:\n    def multiply_pair(self, nested_a: tuple, nested_b: tuple) -> tuple:\n        return tuple(nested_a[j] * nested_b[j] for j in range(len(nested_a)))\n\nclass ResultTuple:\n    @staticmethod\n    def from_nested_tuples(nested_results: list[tuple]) -> tuple:\n        return tuple(nested_results)\n\ndef index_multiplication(tuple_a: tuple, tuple_b: tuple) -> tuple:\n    \"\"\"\n    Performs index-wise multiplication of tuple elements in two given tuples.\n    It validates inputs, computes element-wise products, and returns a new tuple of tuples.\n    \"\"\"\n    validator = Validator()\n    validator.validate_top_level_length(tuple_a, tuple_b)\n    validator.validate_nested_lengths(tuple_a, tuple_b)\n    validator.validate_element_types(tuple_a, tuple_b)\n\n    multiplier = Multiplier()\n    nested_results = [multiplier.multiply_pair(tuple_a[i], tuple_b[i]) for i in range(len(tuple_a))]\n    return ResultTuple.from_nested_tuples(nested_results)"}
{"task_id": "Mbpp/447", "solution": "def cube_nums(input_list: List[Union[int, float]]) -> List[Union[int, float]]:\n    \"\"\"Calculates the cube of each numeric element in a list.\n    Assumes input_list is a list containing only numeric types (int or float).\"\"\"\n    return [x ** 3 for x in input_list]"}
{"task_id": "Mbpp/440", "solution": "import re\n\nclass AdverbResult:\n    \"\"\"\n    Value object for adverb detection outcome.\n    \"\"\"\n    def __init__(self, start_index: int, end_index: int, adverb: str):\n        self.start_index = start_index\n        self.end_index = end_index\n        self.adverb = adverb\n\nclass Token:\n    \"\"\"\n    Represents a candidate token with start/end offsets and provides punctuation-stripping.\n    \"\"\"\n    def __init__(self, text: str, start: int, end: int):\n        self.text = text\n        self.start = start # start index in original sentence (inclusive)\n        self.end = end   # end index in original sentence (exclusive)\n\n    def get_stripped_info(self) -> tuple[str, int, int]:\n        \"\"\"\n        Removes leading/trailing non-word characters and returns the stripped text\n        along with its absolute start and end indices in the original sentence.\n        \"\"\"\n        match_start = re.search(r'\\w', self.text, flags=re.UNICODE)\n        if not match_start:\n            return \"\", self.start, self.start # Token contains no word characters\n\n        stripped_start_in_token = match_start.start()\n        \n        match_end_rev = re.search(r'\\w', self.text[::-1], flags=re.UNICODE)\n        stripped_end_in_token = len(self.text) - match_end_rev.start()\n\n        stripped_text = self.text[stripped_start_in_token:stripped_end_in_token]\n        \n        absolute_stripped_start = self.start + stripped_start_in_token\n        absolute_stripped_end = self.start + stripped_end_in_token\n\n        return stripped_text, absolute_stripped_start, absolute_stripped_end\n\nclass Sentence:\n    \"\"\"\n    Represents the input sentence and produces Token objects via tokenize().\n    \"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\n    def tokenize(self) -> list['Token']:\n        \"\"\"\n        Splits the sentence into tokens, preserving their original offsets.\n        Tokens are defined as sequences of non-whitespace characters.\n        \"\"\"\n        tokens = []\n        for match in re.finditer(r'\\S+', self.text, flags=re.UNICODE):\n            tokens.append(Token(match.group(0), match.start(), match.end()))\n        return tokens\n\nclass AdverbCandidate:\n    \"\"\"\n    Wraps a Token and decides if it is an adverb based on detection rules.\n    \"\"\"\n    def __init__(self, token: 'Token'):\n        self.token = token\n\n    def isAdverb(self) -> bool:\n        \"\"\"\n        Detects adverbs using the minimum rule: stripped text ends with 'ly' (case-insensitive).\n        \"\"\"\n        stripped_text, _, _ = self.token.get_stripped_info()\n        return stripped_text.lower().endswith('ly')\n\nclass AdverbFinder:\n    \"\"\"\n    Stateless orchestrator for tokenization, punctuation stripping, adverb detection,\n    and result construction.\n    \"\"\"\n    def find_adverb_position(self, sentence: 'Sentence') -> 'AdverbResult' or None:\n        \"\"\"\n        Finds the first adverb in the given Sentence object.\n        \"\"\"\n        tokens = sentence.tokenize()\n        for token in tokens:\n            candidate = AdverbCandidate(token)\n            if candidate.isAdverb():\n                stripped_adverb_text, absolute_start_index, absolute_end_index = token.get_stripped_info()\n                return AdverbResult(absolute_start_index, absolute_end_index, stripped_adverb_text)\n        return None\n\ndef find_adverb_position(sentence: str) -> tuple[int, int, str]:\n    \"\"\"\n    Finds the first adverb and its positions in a given sentence.\n    BR10: Returns a sentinel tuple (-1, -1, \"\") if no adverb is found,\n          adhering to the strict return type signature.\n    \"\"\"\n    sentence_obj = Sentence(sentence)\n    finder = AdverbFinder()\n    result = finder.find_adverb_position(sentence_obj)\n    if result:\n        return (result.start_index, result.end_index, result.adverb)\n    return (-1, -1, \"\")"}
{"task_id": "Mbpp/448", "solution": "def cal_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of Perrin numbers from P0 up to Pn, inclusive.\n    Assumes n is a non-negative integer based on constraints.\n    \"\"\"\n    class PerrinCalculator:\n        \"\"\"Computes Perrin numbers and their sums using an internal cache.\"\"\"\n        def __init__(self):\n            # Base cases for Perrin sequence: P0=3, P1=0, P2=2\n            self._sequence = [3, 0, 2]\n\n        def computePerrin(self, k: int) -> int:\n            \"\"\"Returns the k-th Perrin number, computing and caching if necessary.\"\"\"\n            # Expand the sequence until Pk is available\n            while len(self._sequence) <= k:\n                i = len(self._sequence)\n                # Perrin recurrence relation: Pn = Pn-2 + Pn-3 for n >= 3\n                next_perrin = self._sequence[i - 2] + self._sequence[i - 3]\n                self._sequence.append(next_perrin)\n            return self._sequence[k]\n\n        def cal_sum(self, n: int) -> int:\n            \"\"\"Sums Perrin numbers from P0 to Pn, inclusive.\"\"\"\n            total_sum = 0\n            for i in range(n + 1):\n                total_sum += self.computePerrin(i)\n            return total_sum\n\n    calculator = PerrinCalculator()\n    return calculator.cal_sum(n)"}
{"task_id": "Mbpp/450", "solution": "def extract_string(list_of_strings, size):\n    \"\"\"Extracts strings of a specified length from a list.\n    Raises TypeError if inputs are not of the expected type.\"\"\"\n    if not isinstance(list_of_strings, list):\n        raise TypeError('list_of_strings must be a list')\n    if not isinstance(size, int):\n        raise TypeError('size must be an int')\n\n    result = []\n    for item in list_of_strings:\n        if isinstance(item, str) and len(item) == size:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/451", "solution": "def remove_whitespaces(input: str) -> str:\n    \"\"\"Removes all whitespace characters from the given string, preserving the order of non-whitespace characters.\"\"\"\n    return ''.join(ch for ch in input if not ch.isspace())"}
{"task_id": "Mbpp/455", "solution": "class Month:\n    \"\"\"Represents a month number and whether it has 31 days.\"\"\"\n    def __init__(self, monthNumber: int, has31Days: bool) -> None:\n        self.monthNumber = monthNumber\n        self.has31Days = has31Days\n\nclass Result:\n    \"\"\"A simple data transfer object for boolean results.\"\"\"\n    def __init__(self, value: bool) -> None:\n        self.value = value\n\nclass CheckMonthFunction:\n    \"\"\"Encapsulates the logic for checking if a month has 31 days.\"\"\"\n    name: str = \"check_monthnumb_number\"\n\n    def execute(self, monthNumber: int) -> bool:\n        \"\"\"Determines if the given month number has 31 days.\n        It returns True for months {1, 3, 5, 7, 8, 10, 12}, False otherwise.\"\"\"\n        months_with_31_days = {1, 3, 5, 7, 8, 10, 12}\n        return monthNumber in months_with_31_days\n\ndef check_monthnumb_number(monthNumber: int) -> bool:\n    \"\"\"\n    Checks whether the given month number contains 31 days.\n    This function delegates to an internal service class to perform the check.\n    \"\"\"\n    service = CheckMonthFunction()\n    return service.execute(monthNumber)"}
{"task_id": "Mbpp/453", "solution": "def sumofFactors(n: int) -> int:\n    \"\"\"\n    Calculates the sum of all even positive divisors of a given number n.\n    Handles n <= 0 by considering its absolute value for divisor enumeration.\n    \"\"\"\n    if n == 0:\n        return 0\n\n    all_divisors = _enumerate_positive_divisors(n)\n    \n    even_divisors_sum = 0\n    for divisor in all_divisors:\n        if _is_even(divisor):\n            even_divisors_sum += divisor\n            \n    return even_divisors_sum\n\ndef _enumerate_positive_divisors(n: int) -> list:\n    \"\"\"\n    Enumerates all positive divisors of a given number n.\n    Uses the absolute value of n to find positive divisors.\n    \"\"\"\n    divisors = set()\n    num = abs(n)\n    if num == 0:\n        return []\n\n    for i in range(1, int(num**0.5) + 1):\n        if num % i == 0:\n            divisors.add(i)\n            divisors.add(num // i)\n    \n    return sorted(list(divisors))\n\ndef _is_even(d: int) -> bool:\n    \"\"\"\n    Checks if a given integer d is an even number.\n    \"\"\"\n    return d % 2 == 0"}
{"task_id": "Mbpp/454", "solution": "from typing import List, Optional\nimport string\n\nclass TextInput:\n    \"\"\"Represents the incoming raw text.\"\"\"\n    def __init__(self, raw_text: str) -> None:\n        self._raw_text = raw_text\n\n    def raw_text(self) -> str:\n        \"\"\"Returns the original raw text.\"\"\"\n        return self._raw_text\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the raw text.\"\"\"\n        return len(self._raw_text)\n\nclass Word:\n    \"\"\"Represents a token, handling punctuation stripping and 'z' checking.\"\"\"\n    def __init__(self, raw_value: str) -> None:\n        # Strips adjacent punctuation from the raw value to get the cleaned word.\n        self.value = self._strip_punctuation(raw_value)\n\n    def _strip_punctuation(self, text: str) -> str:\n        # Removes leading and trailing punctuation characters.\n        punctuation_set = string.punctuation\n\n        start_index = 0\n        for char in text:\n            if char in punctuation_set:\n                start_index += 1\n            else:\n                break\n        \n        end_index = len(text)\n        for i in range(len(text) - 1, -1, -1):\n            if text[i] in punctuation_set:\n                end_index -= 1\n            else:\n                break\n        \n        return text[start_index:end_index]\n\n    def containsZ(self) -> bool:\n        \"\"\"Checks if the cleaned word contains the lowercase 'z' (case-sensitive).\"\"\"\n        return 'z' in self.value\n\nclass Tokenizer:\n    \"\"\"Splits raw text into Word objects.\"\"\"\n    def __init__(self) -> None:\n        pass # This Tokenizer simply splits and delegates cleaning to Word objects.\n\n    def tokenize(self, raw_text: str) -> List[Word]:\n        \"\"\"Tokenizes raw text by splitting on whitespace and creating Word objects.\"\"\"\n        tokens = raw_text.split()\n        word_objects = [Word(token) for token in tokens]\n        return word_objects\n\nclass MatchResult:\n    \"\"\"Summarizes the outcome of a text match operation.\"\"\"\n    def __init__(self, matched: bool, matched_word: Optional[str] = None) -> None:\n        self.matched = matched\n        self.matched_word = matched_word\n\nclass TextMatcher:\n    \"\"\"Evaluates a list of Word objects to find a match.\"\"\"\n    def __init__(self) -> None:\n        pass # The matcher is stateless for this operation.\n\n    def match(self, words: List[Word]) -> MatchResult:\n        \"\"\"Iterates through words, returning a match result if 'z' is found.\"\"\"\n        for word in words:\n            if word.containsZ():\n                return MatchResult(True, word.value)\n        return MatchResult(False)\n\ndef text_match_wordz(text: str) -> bool:\n    \"\"\"\n    Checks if any word in the input text contains the character 'z' after stripping punctuation.\n    Splits text on whitespace, strips adjacent punctuation, and performs a case-sensitive 'z' check.\n    \"\"\"\n    text_input = TextInput(text)\n    tokenizer = Tokenizer()\n    words = tokenizer.tokenize(text_input.raw_text())\n    matcher = TextMatcher()\n    match_result = matcher.match(words)\n    return match_result.matched"}
{"task_id": "Mbpp/456", "solution": "from typing import List\n\nclass StringElement:\n    \"\"\"Models a single string element and provides a character-wise reversal operation.\"\"\"\n    def __init__(self, value: str, position: int):\n        self.value = value\n        self.position = position\n\n    def reverse(self) -> str:\n        \"\"\"Returns the character-wise reversed version of the string value.\"\"\"\n        return self.value[::-1]\n\nclass StringList:\n    \"\"\"A container for ordered StringElement objects with conversion helpers.\"\"\"\n    def __init__(self, elements: List[StringElement]):\n        self._elements = elements\n\n    @staticmethod\n    def from_string_list(input_list: List[str]) -> 'StringList':\n        \"\"\"Creates a StringList instance from a native Python list of strings.\"\"\"\n        elements = [StringElement(value, i) for i, value in enumerate(input_list)]\n        return StringList(elements)\n\n    def to_string_list(self) -> List[str]:\n        \"\"\"Converts the internal list of StringElement objects back to a list of strings.\"\"\"\n        return [element.value for element in self._elements]\n\n    def __len__(self) -> int:\n        \"\"\"Returns the number of elements in the StringList.\"\"\"\n        return len(self._elements)\n\nclass ReverseStringListFunction:\n    \"\"\"Encapsulates the algorithm for reversing strings within a list.\"\"\"\n    def reverse(self, input_list: List[str]) -> List[str]:\n        \"\"\"Reverses each string in the input list and returns a new list.\"\"\"\n        string_list = StringList.from_string_list(input_list)\n        reversed_values = []\n        for element in string_list._elements:\n            reversed_values.append(element.reverse())\n        return reversed_values\n\ndef reverse_string_list(input_list: List[str]) -> List[str]:\n    \"\"\"Reverses each string in the given list of string values, preserving order.\"\"\"\n    reverser = ReverseStringListFunction()\n    return reverser.reverse(input_list)"}
{"task_id": "Mbpp/457", "solution": "def Find_Min(input_sublists):\n    \"\"\"\n    Finds the sublist with the minimum length from a list of sublists.\n    Returns the first-occurring sublist with minimal length.\n    \"\"\"\n    min_sublist = input_sublists[0]\n    min_length = len(input_sublists[0])\n\n    for sublist in input_sublists[1:]:\n        current_length = len(sublist)\n        if current_length < min_length:\n            min_length = current_length\n            min_sublist = sublist\n            \n    return min_sublist"}
