{"task_id": "Mbpp/124", "solution": "import math\n\ndef angle_complex(*args) -> float:\n    \"\"\"\n    Calculates the angle (argument) of a complex number in radians.\n    Accepts either a single complex number or two numeric parameters (real, imag).\n    \"\"\"\n\n    class ComplexNumber:\n        \"\"\"Data container for internal complex number representation.\"\"\"\n        def __init__(self, real: float, imag: float):\n            self.real = real\n            self.imag = imag\n\n    class MathUtils:\n        \"\"\"Encapsulates deterministic math operations, specifically atan2.\"\"\"\n        @staticmethod\n        def atan2(y: float, x: float) -> float:\n            return math.atan2(y, x)\n\n    class InputValidator:\n        \"\"\"Validates caller inputs and coerces into ComplexNumber instances.\"\"\"\n        def validate_single_arg(self, value) -> ComplexNumber:\n            \"\"\"Validates and converts a single argument (complex number).\"\"\"\n            if isinstance(value, complex):\n                return ComplexNumber(float(value.real), float(value.imag))\n            raise TypeError(\"Single argument must be a complex number (e.g., 1j, 1+2j).\")\n\n        def validate_two_args(self, real, imag) -> ComplexNumber:\n            \"\"\"Validates and converts two arguments (real, imag components).\"\"\"\n            if isinstance(real, (int, float)) and isinstance(imag, (int, float)):\n                return ComplexNumber(float(real), float(imag))\n            raise TypeError(\"Both arguments for (real, imag) must be numeric (int or float).\")\n\n    class AngleCalculator:\n        \"\"\"Computes the angle (argument) of a ComplexNumber.\"\"\"\n        def calculate(self, value: ComplexNumber) -> float:\n            \"\"\"Calculates the angle in radians using MathUtils.atan2.\"\"\"\n            return MathUtils.atan2(value.imag, value.real)\n\n    # Instantiate the helper components as designed\n    input_validator = InputValidator()\n    angle_calculator = AngleCalculator()\n\n    # Route and validate inputs based on argument count\n    if len(args) == 1:\n        complex_num_obj = input_validator.validate_single_arg(args[0])\n    elif len(args) == 2:\n        complex_num_obj = input_validator.validate_two_args(args[0], args[1])\n    else:\n        raise TypeError(\"angle_complex expects 1 (complex number) or 2 (real, imag) arguments.\")\n\n    # Calculate and return the angle\n    return angle_calculator.calculate(complex_num_obj)"}
{"task_id": "Mbpp/126", "solution": "import math\nimport builtins # To explicitly refer to the built-in sum to avoid recursion\n\ndef sum(a: int, b: int) -> int:\n    \"\"\"\n    Calculates the sum of common positive divisors of two given numbers.\n    This function intentionally shadows the Python built-in `sum`.\n    \"\"\"\n\n    def _divisors(n: int) -> set[int]:\n        # This helper finds all positive divisors of n.\n        divs = set()\n        for i in range(1, int(math.sqrt(n)) + 1):\n            if n % i == 0:\n                divs.add(i)\n                divs.add(n // i)\n        return divs\n\n    def _common_divisors(a: int, b: int) -> set[int]:\n        # This helper computes the set of common positive divisors for a and b.\n        divs_a = _divisors(a)\n        divs_b = _divisors(b)\n        return divs_a.intersection(divs_b)\n\n    common = _common_divisors(a, b)\n    return builtins.sum(common)"}
{"task_id": "Mbpp/128", "solution": "class Word:\n    def __init__(self, text: str, position: int):\n        self.text = text\n        self.position = position\n\n    def length(self) -> int:\n        \"\"\"Returns the character length of the word.\"\"\"\n        return len(self.text)\n\nclass ResultList:\n    def __init__(self, items: list[str]):\n        self.items = items\n\nclass Validator:\n    @staticmethod\n    def validate_n(n) -> None:\n        \"\"\"Raises TypeError if n is not an integer.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"n must be an integer\")\n\nclass Parser:\n    @staticmethod\n    def parse(words) -> list:\n        \"\"\"Parses words input (string or list/tuple) into a list of Word objects.\"\"\"\n        parsed_words = []\n        if isinstance(words, str):\n            tokens = words.split()\n            for i, token in enumerate(tokens):\n                parsed_words.append(Word(token, i))\n        elif isinstance(words, (list, tuple)):\n            for i, token in enumerate(words):\n                parsed_words.append(Word(str(token), i)) # Convert to string to ensure consistent Word creation\n        return parsed_words\n\ndef long_words(n, words) -> list:\n    \"\"\"Finds words that are longer than n characters from a given list of words.\n    Orchestrates validation, parsing, filtering, and returns an ordered list of matching words.\n    \"\"\"\n    Validator.validate_n(n)\n    word_objects = Parser.parse(words)\n    filtered_texts = []\n    for word_obj in word_objects:\n        if word_obj.length() > n:\n            filtered_texts.append(word_obj.text)\n    result_list = ResultList(filtered_texts)\n    return result_list.items"}
{"task_id": "Mbpp/130", "solution": "def max_occurrences(items: list) -> object:\n    from typing import Any, List, Tuple\n\n    class FrequencyCounter:\n        \"\"\"Helper class to count occurrences using Python's == operator.\"\"\"\n        def count(self, items_to_count: List[Any]) -> List[Tuple[Any, int]]:\n            \"\"\"Returns a list of (item, frequency) tuples in first-seen order.\"\"\"\n            distinct: List[Tuple[Any,int]] = []\n            for x in items_to_count:\n                found = False\n                for i, (val, freq) in enumerate(distinct):\n                    if x == val:\n                        distinct[i] = (val, freq + 1)\n                        found = True\n                        break\n                if not found:\n                    distinct.append((x, 1))\n            return distinct\n\n    counter = FrequencyCounter()\n    pairs = counter.count(items)\n\n    # Assumes 'items' is non-empty, thus 'pairs' will also be non-empty.\n    # Tie-breaking: returns the first-seen item with the maximum frequency.\n    max_item, max_freq = pairs[0]\n    for item, freq in pairs:\n        if freq > max_freq:\n            max_item, max_freq = item, freq\n    return max_item"}
{"task_id": "Mbpp/129", "solution": "class Matrix:\n    def __init__(self, rows: list[list]) -> None:\n        self.rows = rows\n        self.n = len(rows) if rows else 0\n\n    def get_element(self, i: int, j: int) -> int | None:\n        if 0 <= i < self.n and 0 <= j < self.n:\n            row = self.rows[i]\n            if 0 <= j < len(row): # Ensure column exists in this row\n                return row[j]\n        return None\n\n    def is_square(self) -> bool:\n        if not self.rows:\n            return False # An empty matrix is not a valid square.\n        \n        n = self.n\n        for row in self.rows:\n            if len(row) != n:\n                return False\n        return True\n\nclass Cell:\n    def __init__(self, value: int, row: int, col: int) -> None:\n        self.value = value\n        self.row = row\n        self.col = col\n\nclass MagicSquareTester:\n    def magic_square_test(self, matrix_obj: Matrix) -> bool:\n        # Orchestrates validation and various checks to determine if the matrix is a magic square.\n        if not self.validate(matrix_obj):\n            return False\n        \n        target_sum = self.compute_target_sum(matrix_obj)\n        \n        if not self.check_rows(matrix_obj, target_sum):\n            return False\n        if not self.check_columns(matrix_obj, target_sum):\n            return False\n        if not self.check_diagonals(matrix_obj, target_sum):\n            return False\n        if not self.check_uniqueness(matrix_obj):\n            return False\n            \n        return True\n\n    def validate(self, matrix: Matrix) -> bool:\n        # Ensures the input matrix is non-empty, square, and contains only integers.\n        if not matrix.rows:\n            return False\n\n        if not matrix.is_square():\n            return False\n\n        n = matrix.n\n        for i in range(n):\n            for j in range(n):\n                element = matrix.get_element(i, j)\n                if element is None or not isinstance(element, int):\n                    return False\n        return True\n\n    def compute_target_sum(self, matrix: Matrix) -> int:\n        # Calculates the magic constant (target sum) from the first row.\n        if not matrix.rows: \n            return 0 # Should be guarded by validation.\n        return sum(matrix.rows[0])\n\n    def check_rows(self, matrix: Matrix, target: int) -> bool:\n        # Verifies that the sum of elements in each row equals the target sum.\n        for row in matrix.rows:\n            if sum(row) != target:\n                return False\n        return True\n\n    def check_columns(self, matrix: Matrix, target: int) -> bool:\n        # Verifies that the sum of elements in each column equals the target sum.\n        n = matrix.n\n        for j in range(n):\n            col_sum = 0\n            for i in range(n):\n                col_sum += matrix.get_element(i, j)\n            if col_sum != target:\n                return False\n        return True\n\n    def check_diagonals(self, matrix: Matrix, target: int) -> bool:\n        # Verifies that the sum of elements in both main diagonals equals the target sum.\n        n = matrix.n\n        main_diag_sum = 0\n        anti_diag_sum = 0\n        for i in range(n):\n            main_diag_sum += matrix.get_element(i, i)\n            anti_diag_sum += matrix.get_element(i, n - 1 - i)\n            \n        if main_diag_sum != target or anti_diag_sum != target:\n            return False\n        return True\n\n    def check_uniqueness(self, matrix: Matrix) -> bool:\n        # Verifies that the matrix contains each integer from 1 to n*n exactly once.\n        n = matrix.n\n        if n == 0:\n            return False \n\n        required_max_value = n * n\n        \n        seen_values = [False] * (required_max_value + 1)\n        \n        for i in range(n):\n            for j in range(n):\n                value = matrix.get_element(i, j)\n                \n                if not (1 <= value <= required_max_value):\n                    return False\n                \n                if seen_values[value]:\n                    return False\n                seen_values[value] = True\n        \n        return True\n\ndef magic_square_test(matrix: list[list]) -> bool:\n    # Determines if a given matrix (list of lists) is a magic square.\n    matrix_obj = Matrix(rows=matrix)\n    tester = MagicSquareTester()\n    return tester.magic_square_test(matrix_obj)"}
{"task_id": "Mbpp/131", "solution": "def reverse_vowels(input: str) -> str:\n    \"\"\"Return a new string where only vowels (a,e,i,o,u and their uppercase equivalents) have been reversed in order.\n    Non-vowel characters remain at their original indices and unchanged.\n    \"\"\"\n    VOWEL_SET = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n\n    if not input:\n        return \"\"\n\n    s_list = list(input)\n    vowel_indices = []\n    vowel_chars = []\n\n    for i, char in enumerate(s_list):\n        if char in VOWEL_SET:\n            vowel_indices.append(i)\n            vowel_chars.append(char)\n\n    if not vowel_chars:\n        return input\n\n    vowel_chars.reverse()\n\n    for i, original_vowel_index in enumerate(vowel_indices):\n        s_list[original_vowel_index] = vowel_chars[i]\n\n    return \"\".join(s_list)"}
