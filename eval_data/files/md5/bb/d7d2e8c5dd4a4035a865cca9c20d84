{"task_id": "Mbpp/16", "solution": "import re\nfrom datetime import datetime\nfrom typing import Optional\n\nPATTERN_REGEX: str = \"[a-z]+_[a-z]+\"\n\nclass InputString:\n    \"\"\"Wraps an input string and provides basic string operations.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the wrapped string.\"\"\"\n        return len(self.value)\n\nclass Pattern:\n    \"\"\"Represents a regular expression pattern with an optional description.\"\"\"\n    def __init__(self, regex: str = PATTERN_REGEX, description: Optional[str] = None) -> None:\n        self.regex = regex\n        self.description = description\n\nclass MatchResult:\n    \"\"\"Encapsulates the result of a pattern matching operation.\"\"\"\n    def __init__(self, matches: bool, checked_at: Optional[datetime] = None) -> None:\n        self.matches = matches\n        self.checked_at = checked_at if checked_at is not None else datetime.now()\n\nclass PatternMatcher:\n    \"\"\"Performs pattern matching against an InputString using a given Pattern.\"\"\"\n    def __init__(self, pattern: Pattern) -> None:\n        self.pattern = pattern\n\n    def containsMatch(self, input_obj: InputString) -> MatchResult:\n        \"\"\"Checks if the input string contains any match for the pattern.\"\"\"\n        match = re.search(self.pattern.regex, input_obj.value)\n        return MatchResult(matches=bool(match))\n\ndef text_lowercase_underscore(input: str) -> bool:\n    \"\"\"\n    Returns true if the input string contains sequences of lowercase letters\n    joined with an underscore and false otherwise.\n    \"\"\"\n    input_obj = InputString(input)\n    pattern_obj = Pattern(PATTERN_REGEX)\n    matcher = PatternMatcher(pattern_obj)\n    result = matcher.containsMatch(input_obj)\n    return result.matches"}
{"task_id": "Mbpp/12", "solution": "def sort_matrix(matrix: List[List[Union[int, float]]]) -> List[List[Union[int, float]]]:\n    \"\"\"\n    Sorts a given matrix in ascending order according to the sum of its rows.\n    Returns a new matrix with rows reordered.\n    \"\"\"\n    # Imports for typing and copying objects, placed inside the function\n    # to adhere to the strict \"output starting with def line\" constraint\n    # and \"helpers defined inline\" for everything called.\n    from typing import List, Union\n    import copy\n\n    class Row:\n        \"\"\"Represents a single row of the matrix with its original index and sum.\"\"\"\n        def __init__(self, original_index: int, elements: List[Union[int, float]]):\n            self.original_index = original_index\n            # Store a copy of elements to ensure input row is not modified if elements list is passed by reference.\n            self.elements = list(elements)\n            self.sum = self.compute_sum()\n\n        def compute_sum(self) -> Union[int, float]:\n            \"\"\"Computes and returns the sum of the row's elements.\"\"\"\n            return sum(self.elements)\n\n    class Matrix:\n        \"\"\"Encapsulates a collection of Row objects.\"\"\"\n        def __init__(self, rows: List[Row]):\n            self.rows = rows\n\n        def get_row_sums(self) -> List[Union[int, float]]:\n            \"\"\"Returns a list of sums for each row.\"\"\"\n            # This method is part of the design but not explicitly used in the main flow's current implementation.\n            return [row.sum for row in self.rows]\n\n        def to_list_of_lists(self) -> List[List[Union[int, float]]]:\n            \"\"\"Converts the Matrix object back to a list of lists representation.\"\"\"\n            # Creates a new list for the matrix, and new lists for each row's elements, maintaining immutability.\n            return [copy.copy(row.elements) for row in self.rows]\n\n    class SortFunction:\n        \"\"\"Provides the logic for sorting a Matrix.\"\"\"\n        @staticmethod\n        def sort_matrix(matrix_obj: Matrix) -> Matrix:\n            \"\"\"\n            Performs a stable ascending sort of the matrix rows by their sum.\n            Returns a new Matrix object with sorted rows.\n            \"\"\"\n            # Python's built-in sorted() is stable by default.\n            # It returns a new list of Row objects, ensuring the original Matrix's rows list is not modified.\n            sorted_rows = sorted(matrix_obj.rows, key=lambda r: r.sum)\n            return Matrix(sorted_rows)\n\n    # Per \"Do NOT add isinstance() checks or raise exceptions for edge cases\",\n    # input validation is omitted; input is assumed to conform to type hints.\n\n    if not matrix:\n        return []\n\n    # Step 1: Create Row objects for each row in the input matrix.\n    # Each Row object computes and stores its sum during initialization.\n    matrix_rows = [Row(i, row_data) for i, row_data in enumerate(matrix)]\n    matrix_obj = Matrix(matrix_rows)\n\n    # Step 2: Use SortFunction to obtain a new Matrix object with its rows sorted.\n    sorted_matrix_obj = SortFunction.sort_matrix(matrix_obj)\n\n    # Step 3: Convert the sorted Matrix object back into the required list of lists format.\n    result_list_of_lists = sorted_matrix_obj.to_list_of_lists()\n\n    # Step 4: Return the newly sorted list of lists.\n    return result_list_of_lists"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(m: int) -> bool:\n    \"\"\"Checks if the given number is a Woodall number.\"\"\"\n    if m < 1:\n        return False\n\n    k = 1\n    while True:\n        candidate_value = k * (2**k) - 1\n        if candidate_value == m:\n            return True\n        elif candidate_value > m:\n            return False\n        k += 1"}
{"task_id": "Mbpp/56", "solution": "class InputNumber:\n    def __init__(self, value: int):\n        self.value: int = value\n    def reverseDigits(self) -> int:\n        \"\"\"Reverse decimal digits of self.value and return integer with leading zeros dropped.\"\"\"\n        abs_value_str = str(abs(self.value))\n        reversed_str = abs_value_str[::-1]\n        return int(reversed_str)\n\nclass ReversedNumber:\n    def __init__(self, value: int):\n        self.value: int = value\n\nclass Checker:\n    def __init__(self):\n        pass\n    def check(self, value: int) -> bool:\n        \"\"\"Return True iff value == (2 * reversed_integer) - 1.\"\"\"\n        input_number = InputNumber(value)\n        reversed_value = input_number.reverseDigits()\n        candidate = (2 * reversed_value) - 1\n        return value == candidate\n\ndef check(value) -> bool:\n    \"\"\"Public API: accepts single argument and returns boolean. Delegates to Checker.check(value).\"\"\"\n    checker = Checker()\n    return checker.check(value)"}
{"task_id": "Mbpp/19", "solution": "def test_duplicate(array):\n    \"\"\"\n    Checks if the given array of integers contains any duplicate element.\n    Returns True if duplicates exist, False otherwise.\n    \"\"\"\n    seen_elements = set()\n    for element in array:\n        if element in seen_elements:\n            return True\n        seen_elements.add(element)\n    return False"}
{"task_id": "Mbpp/58", "solution": "def opposite_Signs(a, b):\n    \"\"\"\n    Determine whether two integers have opposite signs.\n\n    Args:\n        a: int - first integer operand (behavior for non-integers is unspecified per SRS)\n        b: int - second integer operand (behavior for non-integers is unspecified per SRS)\n\n    Returns:\n        bool - True iff one of a and b is > 0 and the other is < 0; otherwise False.\n    \"\"\"\n    return (a > 0 and b < 0) or (a < 0 and b > 0)"}
{"task_id": "Mbpp/62", "solution": "from typing import List, Union\n\ndef smallest_num(numbers: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"Return the smallest numeric value in numbers.\n\n    Raises:\n        ValueError: if numbers is empty.\n    \"\"\"\n    if not numbers:\n        raise ValueError(\"input list must be non-empty\")\n    min_val = numbers[0]\n    for v in numbers[1:]:\n        if v < min_val:\n            min_val = v\n    return min_val"}
{"task_id": "Mbpp/61", "solution": "class Digit:\n    \"\"\"A value object for a decimal digit.\"\"\"\n    def __init__(self, value: int, position: int = 0):\n        self.value = value\n        self.position = position\n\nclass Substring:\n    \"\"\"Encapsulates a substring's data and computations.\"\"\"\n    def __init__(self, start: int, end: int, value: str):\n        self.start = start\n        self.end = end\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the substring.\"\"\"\n        return len(self.value)\n\n    def digitSum(self) -> int:\n        \"\"\"Computes the sum of digits in the substring.\"\"\"\n        return sum(int(char) for char in self.value)\n\nclass InputString:\n    \"\"\"Represents the input string and generates its substrings.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the input string.\"\"\"\n        return len(self.value)\n\n    def generate_substrings(self):\n        \"\"\"Yields tuples of (start, end (exclusive), substring_value) for all non-empty contiguous substrings.\"\"\"\n        n = self.length()\n        for i in range(n):\n            for j in range(i + 1, n + 1):\n                yield i, j, self.value[i:j]\n\nclass CountResult:\n    \"\"\"Encapsulates the total count of matching substrings.\"\"\"\n    def __init__(self):\n        self.totalCount = 0\n\n    def as_int(self) -> int:\n        \"\"\"Returns the total count as an integer.\"\"\"\n        return self.totalCount\n\ndef count_Substrings(input_string: str) -> int:\n    \"\"\"\n    Counts the number of non-empty contiguous substrings whose digit-sum equals their length.\n    Raises ValueError if input_string contains non-digit characters. Returns 0 for an empty string.\n    \"\"\"\n    if not input_string:\n        return 0\n\n    for char in input_string:\n        if not '0' <= char <= '9':\n            raise ValueError(\"Input string must contain only decimal digits.\")\n\n    input_obj = InputString(input_string)\n    count_result = CountResult()\n\n    for start, end, sub_value in input_obj.generate_substrings():\n        substring_obj = Substring(start, end, sub_value)\n        if substring_obj.digitSum() == substring_obj.length():\n            count_result.totalCount += 1\n\n    return count_result.as_int()"}
{"task_id": "Mbpp/59", "solution": "def is_octagonal(n: int) -> int:\n    \"\"\"Calculates the nth octagonal number using the formula n * (3 * n - 2).\"\"\"\n\n    # As per design context, defining OctagonalCalculator inline to satisfy\n    # \"DO NOT call any helper that is not defined inline in your response\"\n    # and the output format constraint (starting with 'def').\n    class OctagonalCalculator:\n        def calculate(self, n_val: int) -> int:\n            \"\"\"Compute and return octagonal(n_val) using formula().\"\"\"\n            return self.formula(n_val)\n\n        def formula(self, n_val: int) -> int:\n            \"\"\"Return n_val * (3 * n_val - 2).\"\"\"\n            return n_val * (3 * n_val - 2)\n\n    # Validation and error handling are skipped as per the \"REQUIREMENTS\" section:\n    # \"DO NOT add isinstance() checks or raise exceptions for edge cases\".\n\n    calculator = OctagonalCalculator()\n    return calculator.calculate(n)"}
{"task_id": "Mbpp/57", "solution": "class Validator:\n    \"\"\"Validates the input list of digits, raising ValueError for invalid elements.\"\"\"\n    def validate_digits(self, digits) -> bool:\n        if not isinstance(digits, (list, tuple)):\n            raise ValueError(\"Input must be a list or tuple of digits.\")\n        for digit in digits:\n            if not isinstance(digit, int):\n                raise ValueError(f\"Each element must be an integer, but found {type(digit).__name__}.\")\n            if not (0 <= digit <= 9):\n                raise ValueError(f\"Each digit must be between 0 and 9, but found {digit}.\")\n        return True\n\nclass Digit:\n    \"\"\"Represents a single digit, holding its integer value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n    def __int__(self) -> int:\n        return self.value\n\nclass DigitList:\n    \"\"\"Manages a list of digits, providing operations like sorting.\"\"\"\n    def __init__(self, digits: list):\n        self._digits = list(digits) # Store a copy of the validated digits.\n\n    def sorted_desc(self) -> list:\n        \"\"\"Returns the digits sorted in descending numeric order.\"\"\"\n        return sorted(self._digits, reverse=True)\n\nclass ResultNumber:\n    \"\"\"Constructs and holds the final integer result from a list of digits.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    @classmethod\n    def from_digits(cls, digits: list) -> 'ResultNumber':\n        \"\"\"Creates a ResultNumber by concatenating digits and converting to an integer.\"\"\"\n        if not digits:\n            return cls(0) # Per BR8: An empty list of digits forms the number 0.\n        num_str = \"\".join(str(d) for d in digits)\n        return cls(int(num_str))\n\n    def to_int(self) -> int:\n        \"\"\"Returns the formed integer number.\"\"\"\n        return self._value\n\ndef find_Max_Num(digits: list) -> int:\n    \"\"\"Orchestrates validation, sorting of digits in descending order, and forming the largest number.\n    Raises ValueError on invalid input per validation rules.\n    \"\"\"\n    validator = Validator()\n    validator.validate_digits(digits)\n\n    digit_list_obj = DigitList(digits)\n    sorted_digits = digit_list_obj.sorted_desc()\n\n    result_number_obj = ResultNumber.from_digits(sorted_digits)\n    return result_number_obj.to_int()"}
{"task_id": "Mbpp/65", "solution": "def recursive_list_sum(input_list):\n    \"\"\"\n    Recursively traverse input_list and return the sum of all integer elements.\n    \"\"\"\n    accumulator = 0\n    for element in input_list:\n        if isinstance(element, int):\n            accumulator += element\n        elif isinstance(element, list):\n            accumulator += recursive_list_sum(element)\n    return accumulator"}
{"task_id": "Mbpp/64", "solution": "def subject_marks(list_of_tuples: list) -> list:\n    \"\"\"\n    Sorts a list of tuples based on the second element (score) in ascending order.\n    Validates input and raises ValueError for invalid types or structure.\n    \"\"\"\n\n    def validateInput(data: list) -> bool:\n        \"\"\"\n        Validates the input list of tuples, raising ValueError on failure and returning True on success.\n        \"\"\"\n        if not isinstance(data, list):\n            raise ValueError(\"Input must be a list.\")\n        for i, item in enumerate(data):\n            if not isinstance(item, tuple):\n                raise ValueError(f\"Element at index {i} must be a tuple, got {type(item).__name__}.\")\n            if len(item) != 2:\n                raise ValueError(f\"Tuple at index {i} must have length 2, got length {len(item)}.\")\n            if not isinstance(item[0], str):\n                raise ValueError(f\"First element of tuple at index {i} must be a string, got {type(item[0]).__name__}.\")\n            if not isinstance(item[1], (int, float)):\n                raise ValueError(f\"Second element of tuple at index {i} must be numeric (int or float), got {type(item[1]).__name__}.\")\n        return True\n\n    def sortByScore(data: list) -> list:\n        \"\"\"\n        Returns a new list of tuples sorted by the numeric second element (score) in ascending order.\n        \"\"\"\n        return sorted(data, key=lambda t: t[1])\n\n    validateInput(list_of_tuples)\n    return sortByScore(list_of_tuples)"}
{"task_id": "Mbpp/63", "solution": "from typing import Sequence, Tuple, Optional, Union\n\nNumber = Union[int, float]\n\nclass ValidationError(Exception):\n    \"\"\"Custom exception for validation failures.\"\"\"\n    pass\n\nclass Pair:\n    \"\"\"Typed holder for two numeric values and computes its absolute difference.\"\"\"\n    def __init__(self, a: Number, b: Number) -> None:\n        self.a = a\n        self.b = b\n\n    def absolute_difference(self) -> Number:\n        \"\"\"Calculates the absolute difference between a and b.\"\"\"\n        return abs(self.a - self.b)\n\ndef _as_pair(obj: Sequence) -> Pair:\n    \"\"\"Normalizes an input element to a Pair, validating its length and numeric types.\"\"\"\n    if not isinstance(obj, Sequence) or len(obj) != 2:\n        raise ValidationError(f\"Each element must be a 2-element sequence, got: {obj}\")\n    a, b = obj\n    if not isinstance(a, (int, float)) or not isinstance(b, (int, float)):\n        raise ValidationError(f\"Elements within a pair must be numeric, got: ({a}, {b})\")\n    return Pair(a, b)\n\nclass MaxDifferenceFunction:\n    \"\"\"Encapsulates validation and one-pass computation of maximum absolute difference.\"\"\"\n    def __init__(self, pairs: Sequence[Sequence[Number]]) -> None:\n        self._raw_pairs = pairs\n        self._validated_pairs: Sequence[Pair] = []\n        self._max: Optional[Number] = None\n\n    def validate_input(self) -> None:\n        \"\"\"Validates the input 'pairs' and converts them to Pair objects.\"\"\"\n        if not isinstance(self._raw_pairs, Sequence):\n            raise TypeError(f\"Input 'pairs' must be a sequence, got {type(self._raw_pairs)}\")\n\n        validated_list: list[Pair] = []\n        for i, pair_obj in enumerate(self._raw_pairs):\n            try:\n                validated_list.append(_as_pair(pair_obj))\n            except ValidationError as e:\n                raise ValueError(f\"Invalid pair at index {i}: {e.args[0]}\") from e\n            except Exception as e:\n                raise TypeError(f\"Element at index {i} is not a valid pair: {type(pair_obj)}\") from e\n\n        self._validated_pairs = validated_list\n\n    def compute(self) -> Number:\n        \"\"\"Computes the maximum absolute difference among the validated pairs.\"\"\"\n        if not self._validated_pairs:\n            raise ValueError(\"max_difference() undefined for empty input\")\n\n        # Initialize _max with the difference of the first pair\n        self._max = self._validated_pairs[0].absolute_difference()\n\n        # Iterate from the second pair onwards\n        for pair in self._validated_pairs[1:]:\n            diff = pair.absolute_difference()\n            if diff > self._max: # type: ignore [operator] # _max is guaranteed not None here\n                self._max = diff\n        \n        return self._max # type: ignore [return-value] # _max is guaranteed not None here\n\ndef max_difference(pairs: Sequence[Sequence[Number]]) -> Number:\n    \"\"\"\n    Finds the maximum absolute difference between available pairs in the given tuple list.\n    Raises ValueError for invalid input elements or an empty input sequence.\n    \"\"\"\n    m = MaxDifferenceFunction(pairs)\n    m.validate_input()\n    return m.compute()"}
