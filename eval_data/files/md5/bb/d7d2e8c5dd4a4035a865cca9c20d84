{"task_id": "Mbpp/235", "solution": "class BitMask:\n    def generate(self, bits: int) -> int:\n        \"\"\"\n        Generates an integer mask with even-positioned bits set to 1.\n        Bits are counted from 1 (LSB).\n        \"\"\"\n        mask = 0\n        for pos in range(2, bits + 1, 2):\n            mask |= (1 << (pos - 1))\n        return mask\n\nclass EvenBitSetter:\n    def even_bit_set_number(self, n: int) -> int:\n        \"\"\"\n        Computes the number with all even-positioned bits of 'n' set to 1.\n        Uses a BitMask to generate the required mask and applies it.\n        \"\"\"\n        # Determine the number of bits required to represent n, or at least 1 for n=0.\n        bit_length = n.bit_length() if n != 0 else 1\n\n        bitmask_generator = BitMask()\n        mask = bitmask_generator.generate(bit_length)\n\n        # Apply the mask using a bitwise OR operation.\n        return n | mask\n\ndef even_bit_set_number(n: int) -> int:\n    \"\"\"\n    Sets all even-positioned bits of a given integer 'n' to 1.\n    Positions are counted from 1 for the Least Significant Bit (LSB).\n    \"\"\"\n    setter = EvenBitSetter()\n    return setter.even_bit_set_number(n)"}
{"task_id": "Mbpp/238", "solution": "def number_of_substrings(s: str) -> int:\n    \"\"\"Counts the number of non-empty substrings in the given string.\n    The count is computed using the formula n * (n + 1) // 2, where n is the length of the string.\n    \"\"\"\n    n = len(s)\n    return n * (n + 1) // 2"}
{"task_id": "Mbpp/237", "solution": "from typing import List, Tuple, Dict, Any\n\ndef _validate_input(tuples: List[Tuple[Any, Any]]) -> None:\n    \"\"\"\n    Validates the input list and its 2-element tuple elements.\n    Raises ValueError for invalid input types or non-comparable tuple elements.\n    \"\"\"\n    if not isinstance(tuples, list):\n        raise ValueError(\"Input must be a list\")\n    for elem in tuples:\n        if not isinstance(elem, tuple) or len(elem) != 2:\n            raise ValueError(\"Each element must be a 2-element tuple\")\n        try:\n            _ = elem[0] <= elem[1] # Check for comparability\n        except TypeError:\n            raise ValueError(\"Tuple elements must be comparable\")\n\ndef _normalize_tuple(t: Tuple[Any, Any]) -> Tuple[Any, Any]:\n    \"\"\"Returns a canonical ascending-ordered tuple (a <= b).\"\"\"\n    return tuple(sorted(t))\n\ndef _increment_count(result: Dict[Tuple[Any, Any], int], key: Tuple[Any, Any]) -> None:\n    \"\"\"Increments integer count in result for key; sets to 1 if absent.\"\"\"\n    result[key] = result.get(key, 0) + 1\n\ndef check_occurences(list_of_tuples: List[Tuple[Any, Any]]) -> Dict[Tuple[Any, Any], int]:\n    \"\"\"\n    Calculates occurrences of normalized tuples in a list.\n    Normalizes each 2-element tuple to ascending order before counting.\n    \"\"\"\n    _validate_input(list_of_tuples)\n    counts: Dict[Tuple[Any, Any], int] = {}\n    for t in list_of_tuples:\n        normalized_t = _normalize_tuple(t)\n        _increment_count(counts, normalized_t)\n    return counts"}
