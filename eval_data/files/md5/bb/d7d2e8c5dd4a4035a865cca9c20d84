{"task_id": "Mbpp/87", "solution": "def merge_dictionaries_three(a: dict, b: dict, c: dict) -> dict:\n    \"\"\"Return a new dict containing the union of keys from a, b, c.\n    Precedence: if key in a: use a[key]; elif key in b: use b[key]; else use c[key] if present.\n    \"\"\"\n    if not isinstance(a, dict) or not isinstance(b, dict) or not isinstance(c, dict):\n        raise TypeError(\"All three inputs must be dict instances\")\n\n    result = {}\n    \n    # Collect all unique keys, maintaining left-to-right precedence for conflict resolution.\n    # Keys from 'a' come first, then keys from 'b' not in 'a', then keys from 'c' not in 'a' or 'b'.\n    keys = list(a.keys()) + [k for k in b.keys() if k not in a] + [k for k in c.keys() if k not in a and k not in b]\n    \n    for k in keys:\n        # Resolve the value for key 'k' based on precedence (a > b > c).\n        if k in a:\n            result[k] = a[k]\n        elif k in b:\n            result[k] = b[k]\n        else:\n            # If k is not in 'a' or 'b', it must be in 'c' based on 'keys' list construction.\n            result[k] = c.get(k)\n            \n    return result"}
{"task_id": "Mbpp/88", "solution": "def freq_count(input_list):\n    \"\"\"\n    Compute and return a built-in dict mapping elements to counts.\n\n    Args:\n        input_list: list of hashable elements\n\n    Returns:\n        dict: mapping element -> int count\n    \"\"\"\n    counts = {}\n    for element in input_list:\n        counts[element] = counts.get(element, 0) + 1\n    return counts"}
{"task_id": "Mbpp/90", "solution": "def _validate_input(words: list) -> None:\n    \"\"\"Validates that the input is a list of strings.\"\"\"\n    if not isinstance(words, list):\n        raise TypeError(\"Input 'words' must be a list.\")\n    for word in words:\n        if not isinstance(word, str):\n            raise TypeError(\"All elements in 'words' list must be strings.\")\n\ndef _compute_lengths(words: list) -> list[int]:\n    \"\"\"Computes the length for each word in the list.\"\"\"\n    return [len(w) for w in words]\n\ndef len_log(words: list) -> int:\n    \"\"\"Finds the length of the longest word in a list of words.\"\"\"\n    _validate_input(words)\n    lengths = _compute_lengths(words)\n    return int(max(lengths)) if lengths else int(0)"}
