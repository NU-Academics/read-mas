{"task_id": "Mbpp/630", "solution": "def get_coordinates(coord: tuple) -> list[list[int]]:\n    \"\"\"\n    Extracts all adjacent coordinates (3x3 grid) of the given coordinate tuple.\n    The output is ordered with x varying from x-1 to x+1, then y from y-1 to y+1.\n    \"\"\"\n    if not isinstance(coord, tuple) or len(coord) != 2 or \\\n       not all(isinstance(c, int) for c in coord):\n        raise ValueError(\"Input must be a tuple of two integers\")\n\n    center_x, center_y = coord\n    adjacent_coords = []\n\n    for x_offset in range(-1, 2):\n        for y_offset in range(-1, 2):\n            adjacent_coords.append([center_x + x_offset, center_y + y_offset])\n\n    return adjacent_coords"}
{"task_id": "Mbpp/631", "solution": "def replace_spaces(input: str) -> str:\n    \"\"\"\n    Replaces whitespaces with underscores or vice versa in a given string based on content.\n    Whitespace conversion takes precedence over underscore conversion.\n    \"\"\"\n    if not input:\n        return \"\"\n\n    contains_whitespace = False\n    contains_underscore = False\n\n    # First pass to determine the conversion direction (O(N))\n    for char in input:\n        if char.isspace():\n            contains_whitespace = True\n        elif char == '_':\n            contains_underscore = True\n        # Optimization: if both are found, whitespace conversion takes precedence,\n        # so we can stop searching.\n        if contains_whitespace:\n            break\n\n    # Determine conversion direction\n    direction = \"NO_OP\"\n    if contains_whitespace:\n        direction = \"SPACE_TO_UNDERSCORE\"\n    elif contains_underscore:\n        direction = \"UNDERSCORE_TO_SPACE\"\n\n    if direction == \"NO_OP\":\n        return input\n\n    # Second pass for transformation based on the determined direction (O(N))\n    transformed_chars = []\n    if direction == \"SPACE_TO_UNDERSCORE\":\n        for char in input:\n            if char.isspace():\n                transformed_chars.append('_')\n            else:\n                transformed_chars.append(char)\n    elif direction == \"UNDERSCORE_TO_SPACE\":\n        for char in input:\n            if char == '_':\n                transformed_chars.append(' ')\n            else:\n                transformed_chars.append(char)\n\n    return \"\".join(transformed_chars)"}
{"task_id": "Mbpp/635", "solution": "def heap_sort(input: list) -> list:\n    \"\"\"Sorts a list in ascending order using the heap sort algorithm.\n\n    Returns a new list containing the sorted elements.\n    \"\"\"\n    arr = list(input)  # Create a mutable copy of the input list\n    n = len(arr)\n\n    # Build a max-heap (rearrange array)\n    # Start from the last non-leaf node and go up to the root\n    for i in range(n // 2 - 1, -1, -1):\n        # heapify a subtree rooted with node i\n        # n is the size of the heap\n        # i is the index of the root of the subtree to heapify\n        def _heapify(arr_local, n_local, i_local):\n            largest = i_local  # Initialize largest as root\n            left = 2 * i_local + 1  # left child\n            right = 2 * i_local + 2  # right child\n\n            # See if left child of root exists and is greater than root\n            if left < n_local and arr_local[left] > arr_local[largest]:\n                largest = left\n\n            # See if right child of root exists and is greater than current largest\n            if right < n_local and arr_local[right] > arr_local[largest]:\n                largest = right\n\n            # Change root, if needed\n            if largest != i_local:\n                arr_local[i_local], arr_local[largest] = arr_local[largest], arr_local[i_local]  # swap\n                # Heapify the root.\n                _heapify(arr_local, n_local, largest)\n\n        _heapify(arr, n, i)\n\n    # One by one extract elements\n    for i in range(n - 1, 0, -1):\n        arr[i], arr[0] = arr[0], arr[i]  # Swap root (max element) with current last element\n        # heapify the root of the diminished heap\n        # i is now the size of the heap to consider\n        _heapify(arr, i, 0)\n    \n    return arr"}
