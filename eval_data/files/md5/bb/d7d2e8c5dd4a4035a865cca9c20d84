{"task_id": "Mbpp/427", "solution": "class DateString:\n    \"\"\"Holds and parses a yyyy-mm-dd input string and provides accessors and an output assembler.\"\"\"\n    def __init__(self, value: str, format: str = \"yyyy-mm-dd\") -> None:\n        self.value = value\n        self.format = format\n\n    def getYear(self) -> str:\n        \"\"\"Returns the 4-digit year substring.\"\"\"\n        return self.value[0:4]\n\n    def getMonth(self) -> str:\n        \"\"\"Returns the 2-digit month substring, preserving leading zero.\"\"\"\n        return self.value[5:7]\n\n    def getDay(self) -> str:\n        \"\"\"Returns the 2-digit day substring, preserving leading zero.\"\"\"\n        return self.value[8:10]\n\n    def toDDMMYYYY(self) -> str:\n        \"\"\"Assembles and returns the date in dd-mm-yyyy format.\"\"\"\n        return f\"{self.getDay()}-{self.getMonth()}-{self.getYear()}\"\n\nclass DateFormatter:\n    \"\"\"Provides the date conversion operation.\"\"\"\n    def change_date_format(self, dateStr: str) -> str:\n        \"\"\"Converts a yyyy-mm-dd date string to dd-mm-yyyy format.\"\"\"\n        date_obj = DateString(value=dateStr)\n        return date_obj.toDDMMYYYY()\n\ndef change_date_format(dateStr: str) -> str:\n    \"\"\"Converts a date of yyyy-mm-dd format to dd-mm-yyyy format.\"\"\"\n    formatter = DateFormatter()\n    return formatter.change_date_format(dateStr)"}
