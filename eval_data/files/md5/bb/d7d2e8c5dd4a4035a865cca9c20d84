{"task_id": "Mbpp/751", "solution": "def check_min_heap(arr: list) -> bool:\n    \"\"\"\n    Checks if the given array represents a min-heap according to 0-based indexing rules.\n    This function ensures that each parent node's value is less than or equal to its children's values.\n    \"\"\"\n    # Validate input type as specified in the design context.\n    if not isinstance(arr, list):\n        raise TypeError('arr must be a list')\n\n    n = len(arr)\n\n    # Empty or single-element arrays are considered valid min-heaps.\n    if n <= 1:\n        return True\n\n    # Iterate through all possible parent nodes. The last parent is at index floor((n-2)/2).\n    max_parent_index = (n - 2) // 2\n\n    for i in range(max_parent_index + 1):\n        left_child_index = 2 * i + 1\n        right_child_index = 2 * i + 2\n\n        # Check left child. If it exists and violates the min-heap property, return False.\n        if left_child_index < n:\n            if not (arr[i] <= arr[left_child_index]):\n                return False\n\n        # Check right child. If it exists and violates the min-heap property, return False.\n        if right_child_index < n:\n            if not (arr[i] <= arr[right_child_index]):\n                return False\n\n    # If no violations were found after checking all parents, the array is a min-heap.\n    return True"}
{"task_id": "Mbpp/752", "solution": "from dataclasses import dataclass\nfrom datetime import datetime\nfrom typing import Optional\n\nclass InputParameter:\n    def __init__(self, n: object) -> None:\n        self._n = n\n\n    def validate(self) -> bool:\n        return isinstance(self._n, int) and self._n >= 0\n\nclass JacobsthalFunction:\n    def compute(self, n: int) -> int:\n        if n == 0:\n            return 0\n        elif n == 1:\n            return 1\n        \n        a, b = 0, 1  # J(0), J(1)\n        for _ in range(2, n + 1):\n            next_jacobsthal = b + 2 * a\n            a = b\n            b = next_jacobsthal\n        return b\n\n@dataclass\nclass JacobsthalNumber:\n    index: int\n    value: int\n\n@dataclass\nclass ComputationRecord:\n    id: Optional[int]\n    input_n: int\n    result: int\n    computed_at: datetime\n\n@dataclass\nclass ErrorResponse:\n    message: str\n    code: int\n\ndef jacobsthal_num(n: object) -> int:\n    \"\"\"\n    Computes the nth Jacobsthal number using 0-based indexing.\n    Validates input and creates an in-memory computation record.\n    \"\"\"\n    input_param = InputParameter(n)\n    if not input_param.validate():\n        error_response = ErrorResponse(\n            message=\"Input n must be a non-negative integer.\",\n            code=400\n        )\n        raise ValueError(error_response.message)\n\n    jacobsthal_calculator = JacobsthalFunction()\n    result = jacobsthal_calculator.compute(n)\n\n    jacobsthal_number_obj = JacobsthalNumber(index=n, value=result)\n    computation_record = ComputationRecord(\n        id=None,\n        input_n=n,\n        result=result,\n        computed_at=datetime.now()\n    )\n\n    return result"}
{"task_id": "Mbpp/753", "solution": "def _select_k_smallest(records_with_indices: list, k: int) -> list:\n    # records_with_indices is a list of (value, original_index, original_tuple).\n    # This function selects up to k records, sorting them by value then original_index for stability.\n    if k <= 0:\n        return []\n    \n    # Sort all records by value then original_index. Python's sorted() is stable.\n    # Sorting by (value, index) implicitly handles ties by preserving original order.\n    sorted_records = sorted(records_with_indices, key=lambda x: (x[0], x[1]))\n    \n    # Return the first k elements.\n    return sorted_records[:k]\n\ndef _stable_sort(selected_indexed_records: list) -> list:\n    # selected_indexed_records is a list of (value, original_index, original_tuple)\n    # that are already sorted. This function extracts the original tuples.\n    return [record[2] for record in selected_indexed_records]\n\ndef min_k(records: list, k: int) -> list:\n    \"\"\"\n    Finds the minimum k records from a list of (name, value) tuples.\n    The records are sorted by value, maintaining original order for ties.\n    \"\"\"\n    if k <= 0:\n        return []\n\n    # Create a decorated list of (value, original_index, original_tuple)\n    # This allows sorting by value and using original_index for stable tie-breaking.\n    decorated_records = []\n    for i, record in enumerate(records):\n        decorated_records.append((record[1], i, record))\n\n    # Select up to k smallest records; these will be sorted by value and original_index.\n    selected_and_sorted_records = _select_k_smallest(decorated_records, k)\n\n    # Extract the original tuples from the selected and sorted list.\n    result = _stable_sort(selected_and_sorted_records)\n\n    return result"}
{"task_id": "Mbpp/754", "solution": "from typing import Any, List, Sequence\n\nclass InputList:\n    \"\"\"Adapter over a Sequence providing length() and get(index).\"\"\"\n    def __init__(self, elements: Sequence):\n        self._elements: Sequence = elements\n\n    def length(self) -> int:\n        return len(self._elements)\n\n    def get(self, index: int) -> Any:\n        return self._elements[index]\n\nclass ResultList:\n    \"\"\"Collect matched element values preserving order; return final Python list.\"\"\"\n    def __init__(self):\n        self._elements: List[Any] = []\n\n    def append(self, e: Any) -> None:\n        self._elements.append(e)\n\n    def toList(self) -> List[Any]:\n        return list(self._elements)\n\nclass Comparator:\n    \"\"\"Stateless equality checker using language equality semantics.\"\"\"\n    @staticmethod\n    def areEqual(a: Any, b: Any, c: Any) -> bool:\n        return (a == b == c)\n\nclass ExtractIndexListFunction:\n    \"\"\"Orchestrates iteration, comparison, and collection of matches.\"\"\"\n    def execute(self, l1: Sequence, l2: Sequence, l3: Sequence) -> List:\n        \"\"\"Perform single-pass comparison up to shortest length and return list of matches.\"\"\"\n        # As per design notes, validateInputs effectively trusts inputs given constraints.\n        self.validateInputs(l1, l2, l3) \n\n        input_list1 = InputList(l1)\n        input_list2 = InputList(l2)\n        input_list3 = InputList(l3)\n        result_list = ResultList()\n\n        min_len = min(input_list1.length(), input_list2.length(), input_list3.length())\n\n        for i in range(min_len):\n            val1 = input_list1.get(i)\n            val2 = input_list2.get(i)\n            val3 = input_list3.get(i)\n\n            if Comparator.areEqual(val1, val2, val3):\n                result_list.append(val1)\n\n        return result_list.toList()\n\n    def validateInputs(self, l1: Sequence, l2: Sequence, l3: Sequence) -> bool:\n        \"\"\"Minimal validation: ensure objects support __len__ and __getitem__. Returns True if safe.\"\"\"\n        # Constraints dictate not to add isinstance() checks or raise exceptions.\n        # Therefore, this method always returns True, assuming valid Sequence inputs.\n        return True\n\ndef extract_index_list(l1: Sequence, l2: Sequence, l3: Sequence) -> List:\n    \"\"\"Public API. Delegates to ExtractIndexListFunction.execute and returns resulting list.\"\"\"\n    function_executor = ExtractIndexListFunction()\n    return function_executor.execute(l1, l2, l3)"}
{"task_id": "Mbpp/759", "solution": "import re\n\ndef is_decimal(input: str) -> bool:\n    \"\"\"Checks if the given string represents a decimal number with a precision of 2.\n    Returns True for valid strings like '123.11', False otherwise.\"\"\"\n    # The pattern matches one or more digits before a literal dot, followed by exactly two digits.\n    # The fullmatch ensures the entire string matches the pattern.\n    pattern = r\"^\\d+\\.\\d{2}$\"\n\n    # As per design context, non-string inputs should return False.\n    if not isinstance(input, str):\n        return False\n\n    return bool(re.fullmatch(pattern, input))"}
{"task_id": "Mbpp/757", "solution": "from typing import List\n\ndef count_reverse_pairs(strings: List[str]) -> int:\n    \"\"\"Counts pairs of reverse strings in the input list, following i < j semantics.\n    The input list is treated as read-only and is not modified.\n    \"\"\"\n    def _is_reverse(s1: str, s2: str) -> bool:\n        \"\"\"Return True if s2 is the reverse of s1.\"\"\"\n        return s2 == s1[::-1]\n\n    pair_count = 0\n    n = len(strings)\n\n    for i in range(n):\n        for j in range(i + 1, n):\n            if _is_reverse(strings[i], strings[j]):\n                pair_count += 1\n    return pair_count"}
{"task_id": "Mbpp/758", "solution": "def unique_sublists(input_list):\n    \"\"\"Return dict mapping tuple(sublist) -> count. Side-effect free.\"\"\"\n    if not input_list:\n        return {}\n\n    counts = {}\n    for sublist in input_list:\n        # Convert the sublist to a tuple to use it as a dictionary key.\n        sublist_as_tuple = tuple(sublist)\n        counts[sublist_as_tuple] = counts.get(sublist_as_tuple, 0) + 1\n    return counts"}
{"task_id": "Mbpp/760", "solution": "def unique_Element(numbers):\n    \"\"\"\n    Checks if a list of numbers contains only one distinct element.\n    Returns True if all elements are identical, False otherwise.\n    \"\"\"\n    try:\n        # Use a set for efficient distinct element checking for hashable types\n        distinct_elements = set(numbers)\n        return len(distinct_elements) == 1\n    except TypeError:\n        # Fallback for unhashable elements, though inputs are assumed numeric\n        seen_elements = []\n        for element in numbers:\n            is_new = True\n            for seen_element in seen_elements:\n                if element == seen_element:\n                    is_new = False\n                    break\n            if is_new:\n                seen_elements.append(element)\n                if len(seen_elements) > 1:\n                    return False  # More than one distinct element found\n        return len(seen_elements) == 1"}
{"task_id": "Mbpp/764", "solution": "def number_ctr(input: str) -> int:\n    \"\"\"Counts the number of ASCII digits in a given string.\"\"\"\n\n    # Helper class defined inline to satisfy \"DO NOT call any helper that is not defined inline in your response\"\n    # and the requirement that the output must start with the 'def' line.\n    class NumberCounter:\n        \"\"\"Helper class to encapsulate digit counting logic and state.\"\"\"\n        def __init__(self):\n            # _last_count is maintained as per design, though not used externally in this specific setup.\n            self._last_count: int = 0\n\n        def _is_ascii_digit(self, ch: str) -> bool:\n            \"\"\"Checks if a character is an ASCII digit ('0'-'9').\"\"\"\n            return '0' <= ch <= '9'\n\n        def _count_digits(self, value: str) -> int:\n            \"\"\"Iterates through the string and counts occurrences of ASCII digits.\"\"\"\n            count = 0\n            for char in value:\n                if self._is_ascii_digit(char):\n                    count += 1\n            return count\n\n        def count_and_validate(self, input_value: str) -> int:\n            \"\"\"Validates input type and delegates to _count_digits.\"\"\"\n            if not isinstance(input_value, str):\n                raise TypeError(\"Input must be a string.\")\n            \n            self._last_count = self._count_digits(input_value)\n            return self._last_count\n\n    # Instantiate the inline helper class and use its method to perform the count.\n    counter = NumberCounter()\n    return counter.count_and_validate(input)"}
{"task_id": "Mbpp/762", "solution": "def check_monthnumber_number(month: int) -> bool:\n    \"\"\"\n    Checks whether the given month number (1-12) contains 30 days.\n    Returns True for months 4, 6, 9, 11; False otherwise.\n    \"\"\"\n    months_with_30_days = {4, 6, 9, 11}\n    return month in months_with_30_days"}
{"task_id": "Mbpp/763", "solution": "def find_min_diff(sequence, n):\n    \"\"\"\n    Finds the minimum difference between any two elements among the first n elements of the sequence.\n    The function assumes valid numeric input and n within the appropriate bounds as per design.\n    \"\"\"\n    # Extract the first n elements and convert to float for consistent numeric operations.\n    values = [float(x) for x in sequence[:n]]\n\n    # Sort the extracted values to easily find minimum adjacent differences.\n    values_sorted = sorted(values)\n\n    # Compute the minimum difference by scanning adjacent elements in the sorted list.\n    min_diff = float('inf')\n    for i in range(len(values_sorted) - 1):\n        diff = values_sorted[i+1] - values_sorted[i]\n        if diff < min_diff:\n            min_diff = diff\n\n    return min_diff"}
{"task_id": "Mbpp/766", "solution": "def pair_wise(input_list):\n    \"\"\"\n    Returns a list of all pairs of consecutive items in the given list.\n    Handles lists with less than two items by returning an empty list.\n    \"\"\"\n    result = []\n    for i in range(len(input_list) - 1):\n        result.append((input_list[i], input_list[i+1]))\n    return result"}
{"task_id": "Mbpp/765", "solution": "class InputParameter:\n    \"\"\"Encapsulates input validation for n (BR-1, BR-5).\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n\n    def validate(self) -> None:\n        \"\"\"Raises ValueError if n is not an integer or n < 1.\"\"\"\n        if not isinstance(self.n, int):\n            raise ValueError(\"Input 'n' must be an integer.\")\n        if self.n < 1:\n            raise ValueError(\"Input 'n' must be a positive integer (n >= 1).\")\n\nclass Sequence:\n    \"\"\"Maintains ascending list of polite integer values and provides 1-based access.\"\"\"\n    def __init__(self):\n        self._numbers: list[int] = []\n\n    def append(self, p: int) -> None:\n        \"\"\"Appends a polite number to the sequence.\"\"\"\n        self._numbers.append(p)\n\n    def get(self, index: int) -> int:\n        \"\"\"Returns the polite number at the 1-based index.\"\"\"\n        if not (1 <= index <= len(self._numbers)):\n            raise IndexError(\"Sequence index out of range.\")\n        return self._numbers[index - 1]\n\n    def size(self) -> int:\n        \"\"\"Returns the number of elements in the sequence.\"\"\"\n        return len(self._numbers)\n\nclass PoliteNumber:\n    \"\"\"Determines whether a candidate integer value can be expressed as a sum of two or more consecutive positive integers.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def isPolite(self) -> bool:\n        \"\"\"Returns True if the encapsulated value is polite (not a power of 2), otherwise False.\"\"\"\n        # A positive integer is polite if and only if it is not a power of 2.\n        if self.value <= 0:  # Polite numbers are positive integers.\n            return False\n        return not (self.value > 0 and (self.value & (self.value - 1) == 0))\n\nclass PoliteGenerator:\n    \"\"\"Generates an ascending sequence of polite numbers and returns the n-th polite number.\"\"\"\n    def __init__(self):\n        self._sequence: Sequence = Sequence()\n        self._last_checked: int = 0\n\n    def findNth(self, n: int) -> int:\n        \"\"\"Drives generation until Sequence.size() == n and returns Sequence.get(n).\"\"\"\n        while self._sequence.size() < n:\n            self._last_checked += 1\n            polite_num_candidate = PoliteNumber(self._last_checked)\n            if polite_num_candidate.isPolite():\n                self._sequence.append(self._last_checked)\n        return self._sequence.get(n)\n\n    def generate_up_to(self, limit: int) -> None:\n        \"\"\"Generates polite numbers up to given numeric limit and appends to _sequence.\"\"\"\n        # This method is not directly used by is_polite per the design's sequence diagram for findNth.\n        # It's included as per the component design.\n        current = self._last_checked\n        while current <= limit:\n            current += 1\n            polite_num_candidate = PoliteNumber(current)\n            if polite_num_candidate.isPolite():\n                self._sequence.append(current)\n        self._last_checked = max(self._last_checked, limit)\n\ndef is_polite(n):\n    \"\"\"\n    Finds and returns the n-th polite number.\n    A polite number is a positive integer that can be expressed as a sum of two or more consecutive positive integers.\n    \"\"\"\n    ip = InputParameter(n)\n    ip.validate()\n    gen = PoliteGenerator()\n    return gen.findNth(n)"}
{"task_id": "Mbpp/767", "solution": "from typing import List, Union\n\ndef get_pairs_count(list_of_numbers: List[Union[int, float]], target_sum: Union[int, float]) -> int:\n    \"\"\"Validate inputs and return number of unordered index pairs i<j with sum == target_sum.\n\n    Raises:\n      TypeError: If list_of_numbers is not a list or if target_sum is not int or float.\n    \"\"\"\n    def validate_input(lst: List, s: Union[int, float]) -> bool:\n        \"\"\"Raise TypeError if first argument is not a list or second arg not int/float; return True otherwise.\"\"\"\n        if not isinstance(lst, list):\n            raise TypeError(\"first argument must be a list\")\n        if not isinstance(s, (int, float)):\n            raise TypeError(\"target_sum must be int or float\")\n        return True\n\n    def count_pairs(lst: List[Union[int, float]], s: Union[int, float]) -> int:\n        \"\"\"Enumerate index pairs i<j and count pairs where list_of_numbers[i] + list_of_numbers[j] == target_sum.\"\"\"\n        n = len(lst)\n        count = 0\n        for i in range(n - 1):\n            for j in range(i + 1, n):\n                if lst[i] + lst[j] == s:\n                    count += 1\n        return count\n\n    validate_input(list_of_numbers, target_sum)\n    if len(list_of_numbers) < 2:\n        return 0\n    return count_pairs(list_of_numbers, target_sum)"}
{"task_id": "Mbpp/770", "solution": "class OddNumberSequence:\n    def __init__(self, n: int) -> None:\n        self.n = n\n    def generate(self) -> list[int]:\n        \"\"\"Generates a list of the first n odd natural numbers.\"\"\"\n        return [2*k - 1 for k in range(1, self.n + 1)]\n\nclass SumCalculator:\n    def __init__(self) -> None:\n        pass\n    def computeFourthPowerSum(self, numbers: list[int]) -> int:\n        \"\"\"Computes the sum of the fourth powers of numbers in a list.\"\"\"\n        return sum(x**4 for x in numbers)\n\ndef odd_num_sum(n: int) -> int:\n    \"\"\"\n    Finds the sum of the fourth power of the first n odd natural numbers.\n    Composes OddNumberSequence and SumCalculator for calculation.\n    \"\"\"\n    seq = OddNumberSequence(n)\n    numbers = seq.generate()\n    calc = SumCalculator()\n    return calc.computeFourthPowerSum(numbers)"}
{"task_id": "Mbpp/769", "solution": "def _element_in_list(elem, lst) -> bool:\n    \"\"\"Return True if any item in lst == elem; otherwise False.\"\"\"\n    for item in lst:\n        if item == elem:\n            return True\n    return False\n\ndef Diff(first, second) -> list:\n    \"\"\"Return a Python list with elements from `first` not present in `second` (using ==).\"\"\"\n    result = []\n    for elem in first:\n        if not _element_in_list(elem, second):\n            result.append(elem)\n    return result"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(source: str, substring: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Finds the first occurrence of a substring within a source string.\n    Returns a tuple (matched_substring, start_index, end_index) or None if no match.\n    \"\"\"\n    start_index = source.find(substring)\n\n    if start_index == -1:\n        return None\n    else:\n        end_index = start_index + len(substring)\n        return (substring, start_index, end_index)"}
{"task_id": "Mbpp/771", "solution": "# Constants for bracket classification and matching\nOPENING = {'(', '{', '['}\nCLOSING = {')', '}', ']'}\nMATCH_PAIRS = {'(': ')', '{': '}', '[': ']'}\n\nclass Bracket:\n    \"\"\"Represents a bracket character and provides classification and matching.\"\"\"\n    def __init__(self, symbol: str):\n        self.symbol = symbol\n\n    @property\n    def is_opening(self) -> bool:\n        \"\"\"Returns True if the symbol is an opening bracket.\"\"\"\n        return self.symbol in OPENING\n\n    @property\n    def is_closing(self) -> bool:\n        \"\"\"Returns True if the symbol is a closing bracket.\"\"\"\n        return self.symbol in CLOSING\n\n    def matchingSymbol(self) -> str:\n        \"\"\"Returns the corresponding closing symbol for an opening bracket.\"\"\"\n        return MATCH_PAIRS.get(self.symbol, '')\n\nclass Stack:\n    \"\"\"A simple LIFO stack implementation for Bracket instances.\"\"\"\n    def __init__(self):\n        self._items = []\n\n    def push(self, item: Bracket) -> None:\n        \"\"\"Adds an item to the top of the stack.\"\"\"\n        self._items.append(item)\n\n    def pop(self) -> Bracket:\n        \"\"\"Removes and returns the item from the top of the stack.\"\"\"\n        if self.is_empty():\n            raise IndexError(\"pop from empty stack\")\n        return self._items.pop()\n\n    def peek(self) -> Bracket:\n        \"\"\"Returns the item at the top of the stack without removing it.\"\"\"\n        if self.is_empty():\n            raise IndexError(\"peek from empty stack\")\n        return self._items[-1]\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the stack is empty.\"\"\"\n        return len(self._items) == 0\n\ndef check_expression(expression: str) -> bool:\n    \"\"\"\n    Checks if the given expression has balanced brackets ((), {}, []).\n    Non-bracket characters are ignored; an empty string is considered balanced.\n    \"\"\"\n    stack = Stack()\n\n    for char in expression:\n        if char in OPENING:\n            stack.push(Bracket(char))\n        elif char in CLOSING:\n            if stack.is_empty():\n                return False  # Closing bracket found, but no opening bracket on stack\n            \n            top_bracket = stack.peek()\n            # If the current closing bracket matches the expected closing for the top opening bracket\n            if top_bracket.matchingSymbol() == char:\n                stack.pop()\n            else:\n                return False  # Mismatched closing bracket type\n        # Else: character is not a bracket, so it's ignored as per design.\n            \n    return stack.is_empty() # If stack is empty, all opening brackets were matched."}
{"task_id": "Mbpp/772", "solution": "from typing import List\n\nclass WordToken:\n    \"\"\"Represents a word token and provides its length.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\n    def length(self) -> int:\n        return len(self.text)\n\nclass Tokenizer:\n    \"\"\"Tokenizes an input string into a list of WordToken objects.\"\"\"\n    def tokenize(self, input_str: str) -> List[WordToken]:\n        words = input_str.split()\n        return [WordToken(word) for word in words]\n\nclass Filter:\n    \"\"\"Filters a list of WordToken objects based on their length.\"\"\"\n    def filterByLength(self, tokens: List[WordToken], k: int) -> List[WordToken]:\n        return [token for token in tokens if token.length() != k]\n\nclass Joiner:\n    \"\"\"Joins a list of WordToken objects into a single string.\"\"\"\n    def join(self, tokens: List[WordToken]) -> str:\n        return ' '.join([token.text for token in tokens])\n\nclass RemoveLengthFunction:\n    \"\"\"Orchestrates the process of tokenizing, filtering, and joining words.\"\"\"\n    def __init__(self):\n        self.tokenizer = Tokenizer()\n        self.filter = Filter()\n        self.joiner = Joiner()\n\n    def remove_length(self, input_str: str, k: int) -> str:\n        tokens = self.tokenizer.tokenize(input_str)\n        filtered_tokens = self.filter.filterByLength(tokens, k)\n        result = self.joiner.join(filtered_tokens)\n        return result\n\ndef remove_length(input: str, k: int) -> str:\n    \"\"\"Removes all words of a specific length from the given string.\"\"\"\n    worker = RemoveLengthFunction()\n    return worker.remove_length(input, k)"}
{"task_id": "Mbpp/777", "solution": "def find_sum(input_list):\n    \"\"\"Compute the sum of distinct elements.\n\n    Returns: numeric sum (int or float depending on elements).\n    \"\"\"\n    unique_elements = set(input_list)\n    return sum(unique_elements)"}
{"task_id": "Mbpp/775", "solution": "class IntegerElement:\n    \"\"\"Encapsulates an integer value and provides an oddness check.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def isOdd(self) -> bool:\n        \"\"\"Returns True if the encapsulated integer is odd.\"\"\"\n        return self._value % 2 != 0\n\nclass Index:\n    \"\"\"Encapsulates an index position and provides an oddness check for the index itself.\"\"\"\n    def __init__(self, position: int):\n        self._position = position\n\n    def isOddIndex(self) -> bool:\n        \"\"\"Returns True if the encapsulated index is odd (0-based).\"\"\"\n        return self._position % 2 != 0\n\nclass InputList:\n    \"\"\"A lightweight wrapper around a list of integers, providing size and element access.\"\"\"\n    def __init__(self, elements: list[int]):\n        self._elements = elements\n\n    def get_integer_element(self, index: int) -> IntegerElement:\n        \"\"\"Retrieves an IntegerElement at the specified index.\"\"\"\n        return IntegerElement(self._elements[index])\n\n    def get_size(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self._elements)\n\ndef checkOddAtOddIndices(input_list_raw: list[int]) -> bool:\n    \"\"\"Helper to verify that all odd-indexed elements in a list are odd numbers.\"\"\"\n    input_list = InputList(input_list_raw)\n    size = input_list.get_size()\n    for i in range(size):\n        idx = Index(i)\n        if idx.isOddIndex():\n            element = input_list.get_integer_element(i)\n            if not element.isOdd():\n                return False\n    return True\n\ndef odd_position(input_list: list[int]) -> bool:\n    \"\"\"Checks if every odd index contains an odd number in the given list.\"\"\"\n    return checkOddAtOddIndices(input_list)"}
{"task_id": "Mbpp/780", "solution": "from typing import Sequence, Tuple, List\n\ndef find_combinations(tuple_list: Sequence[Tuple[float, float]]) -> List[Tuple[float, float]]:\n    \"\"\"\n    Compute component-wise sums for each unique unordered pair (i < j).\n    Returns an empty list if there are fewer than two tuples in the input.\n    \"\"\"\n    n = len(tuple_list)\n    if n < 2:\n        return []\n\n    result_sums: List[Tuple[float, float]] = []\n    for i in range(n):\n        for j in range(i + 1, n):\n            tuple1 = tuple_list[i]\n            tuple2 = tuple_list[j]\n            sum_tuple = (tuple1[0] + tuple2[0], tuple1[1] + tuple2[1])\n            result_sums.append(sum_tuple)\n    return result_sums"}
{"task_id": "Mbpp/778", "solution": "from typing import Any, List\n\ndef pack_consecutive_duplicates(lst: List[Any]) -> List[List[Any]]:\n    \"\"\"Return a new list of sublists where each sublist is a maximal consecutive run of equal elements.\n    The function does not mutate the input list.\n    \"\"\"\n    if not lst:\n        return []\n\n    packed_list: List[List[Any]] = []\n    current_sublist: List[Any] = [lst[0]]\n\n    for i in range(1, len(lst)):\n        if lst[i] == lst[i-1]:\n            current_sublist.append(lst[i])\n        else:\n            packed_list.append(current_sublist)\n            current_sublist = [lst[i]]\n\n    packed_list.append(current_sublist)\n    return packed_list"}
{"task_id": "Mbpp/782", "solution": "from typing import List\n\nclass Array:\n    \"\"\"A lightweight runtime holder for input elements.\"\"\"\n    def __init__(self, elements: List[int]) -> None:\n        self.elements = elements\n\nclass Subarray:\n    \"\"\"Represents a contiguous subarray and provides its sum.\"\"\"\n    def __init__(self, start_index: int, elements: List[int]) -> None:\n        self.start_index = start_index\n        self.elements = elements\n        self.length = len(elements)\n\n    def sum(self) -> int:\n        \"\"\"Calculates the sum of the elements in this subarray.\"\"\"\n        return sum(self.elements)\n\nclass Result:\n    \"\"\"Holds the aggregated integer result.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass OddLengthSubarrayCalculator:\n    \"\"\"Calculates the sum of all odd-length contiguous subarrays.\"\"\"\n    def compute(self, arr: List[int]) -> Result:\n        \"\"\"Enumerates and sums all odd-length subarrays.\"\"\"\n        total_sum = 0\n        n = len(arr)\n\n        for i in range(n):\n            for length in range(1, n - i + 1, 2):  # Iterate odd lengths: 1, 3, 5, ...\n                subarray_elements = arr[i : i + length]\n                current_subarray = Subarray(i, subarray_elements)\n                total_sum += current_subarray.sum()\n        return Result(total_sum)\n\ndef odd_length_sum(arr: List[int]) -> int:\n    \"\"\"\n    Finds the sum of all odd length contiguous subarrays in the given array.\n    This function delegates the computation to an internal calculator class.\n    \"\"\"\n    calculator = OddLengthSubarrayCalculator()\n    result = calculator.compute(arr)\n    return result.value"}
{"task_id": "Mbpp/784", "solution": "def mul_even_odd(input_list: list[int]) -> int:\n    \"\"\"\n    Finds the product of the first even and first odd number in a given list.\n    Raises ValueError if either an odd or an even integer is missing.\n    \"\"\"\n    first_odd = None\n    first_even = None\n\n    for num in input_list:\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        \n        # Optimization: if both are found, we can stop searching.\n        if first_odd is not None and first_even is not None:\n            break\n\n    if first_odd is None:\n        raise ValueError(\"missing odd integer\")\n    if first_even is None:\n        raise ValueError(\"missing even integer\")\n\n    return first_odd * first_even"}
{"task_id": "Mbpp/781", "solution": "import math\n\ndef count_divisors(n: int) -> bool:\n    \"\"\"Checks if the count of positive divisors for n is an even number.\n    This includes 1 and n itself as divisors.\"\"\"\n    \n    count = 0\n    # Iterate from 1 up to the integer square root of n to find divisors.\n    limit = math.isqrt(n)\n    for i in range(1, limit + 1):\n        if n % i == 0:\n            if i * i == n:\n                count += 1  # 'i' is the square root, counts as one unique divisor.\n            else:\n                count += 2  # 'i' and 'n/i' are two distinct divisors, count both.\n    \n    return count % 2 == 0"}
{"task_id": "Mbpp/785", "solution": "class TupleString:\n    def __init__(self, raw: str) -> None:\n        self.raw = raw\n\nclass IntegerTuple:\n    def __init__(self, values: list[int]) -> None:\n        self.values = values\n    def as_tuple(self) -> tuple[int, ...]:\n        return tuple(self.values)\n\nclass ParsingException(Exception):\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\nclass Parser:\n    @staticmethod\n    def _tokenize(s: str) -> list[str]:\n        # Remove surrounding parentheses and split on commas.\n        s = s.strip()\n        if not (s.startswith('(') and s.endswith(')')):\n            raise ParsingException(\"Input string must be enclosed in parentheses.\")\n\n        content = s[1:-1].strip()\n        if not content:\n            return []\n        return content.split(',')\n\n    @staticmethod\n    def _validate_and_convert(tokens: list[str]) -> list[int]:\n        # Trim tokens, validate numeric form, convert to int, raise ParsingException on invalid token.\n        parsed_integers = []\n        for token in tokens:\n            stripped_token = token.strip()\n            if not stripped_token:\n                raise ParsingException(\"Empty value found between commas.\")\n            try:\n                parsed_integers.append(int(stripped_token))\n            except ValueError:\n                raise ParsingException(f\"Invalid integer token: {token}\")\n        return parsed_integers\n\n    @staticmethod\n    def tuple_str_int(s: str) -> tuple[int, ...]:\n        \"\"\"Parse s and return tuple of ints or raise ParsingException.\"\"\"\n        tokens = Parser._tokenize(s)\n        int_values = Parser._validate_and_convert(tokens)\n        integer_tuple_obj = IntegerTuple(int_values)\n        return integer_tuple_obj.as_tuple()\n\ndef tuple_str_int(s: str) -> tuple[int, ...]:\n    \"\"\"Public API function that delegates to Parser.tuple_str_int.\n    Converts a tuple string like \"(7, 8, 9)\" to an integer tuple (7, 8, 9).\n    \"\"\"\n    return Parser.tuple_str_int(s)"}
