{"task_id": "Mbpp/109", "solution": "def odd_Equivalent(binary_string: str, rotations: int) -> int:\n    \"\"\"\n    Counts how many left-cyclic rotations of a binary string result in an odd number.\n    Raises ValueError for invalid binary_string characters or invalid rotations count.\n    \"\"\"\n\n    class Validator:\n        \"\"\"Handles input validation for binary strings and rotation counts.\"\"\"\n        @staticmethod\n        def validate_binary_string(s: str) -> None:\n            if not all(char in ('0', '1') for char in s):\n                raise ValueError(\"binary_string must contain only '0' or '1' characters.\")\n\n        @staticmethod\n        def validate_rotations(r: int) -> None:\n            if not isinstance(r, int) or r < 0:\n                raise ValueError(\"rotations must be a non-negative integer.\")\n\n    class BinaryString:\n        \"\"\"Encapsulates a binary string and provides rotation functionality.\"\"\"\n        def __init__(self, value: str) -> None:\n            self.value = value\n\n        def length(self) -> int:\n            return len(self.value)\n\n        def rotateLeft(self, k: int) -> str:\n            if not self.value:\n                return ''\n            length = self.length()\n            k_mod = k % length\n            return self.value[k_mod:] + self.value[:k_mod]\n\n    class RotationResult:\n        \"\"\"Represents a single rotated state and provides an odd parity check.\"\"\"\n        def __init__(self, index: int, rotated_string: str) -> None:\n            self.index = index\n            self.rotated_string = rotated_string\n\n        def is_odd(self) -> bool:\n            # A binary number is odd if its least significant bit (LSB) is '1'.\n            return self.rotated_string != '' and self.rotated_string[-1] == '1'\n\n    class RotationOperation:\n        \"\"\"Generates RotationResult objects for a specified number of rotations.\"\"\"\n        def __init__(self, rotations: int) -> None:\n            self.rotations = rotations\n\n        def execute(self, bs: BinaryString) -> 'Iterator[RotationResult]':\n            for i in range(self.rotations):\n                yield RotationResult(index=i, rotated_string=bs.rotateLeft(i))\n\n    class Counter:\n        \"\"\"Aggregates RotationResult objects to count odd values.\"\"\"\n        def count_odd(self, results: 'Iterable[RotationResult]') -> int:\n            odd_count = 0\n            for result in results:\n                if result.is_odd():\n                    odd_count += 1\n            return odd_count\n\n    Validator.validate_binary_string(binary_string)\n    Validator.validate_rotations(rotations)\n\n    bs = BinaryString(binary_string)\n    rot_op = RotationOperation(rotations)\n    results_iterator = rot_op.execute(bs)\n\n    counter = Counter()\n    return counter.count_odd(results_iterator)"}
{"task_id": "Mbpp/116", "solution": "def _validate_input(input_tuple: tuple) -> None:\n    \"\"\"Validates that the input is a tuple.\"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"input must be a tuple\")\n\ndef _validate_elements(input_tuple: tuple) -> None:\n    \"\"\"Validates that all elements are positive integers and the tuple is not empty.\"\"\"\n    if len(input_tuple) == 0:\n        raise ValueError(\"input tuple must contain at least one positive integer\")\n    for element in input_tuple:\n        if not isinstance(element, int) or element <= 0:\n            raise ValueError(\"each element must be a positive integer\")\n\ndef _element_to_decimal_string(element: int) -> str:\n    \"\"\"Converts an integer element to its decimal string representation.\"\"\"\n    return str(element)\n\ndef _concatenate_decimal_strings(input_tuple: tuple) -> str:\n    \"\"\"Concatenates decimal string representations of tuple elements.\"\"\"\n    return ''.join(_element_to_decimal_string(e) for e in input_tuple)\n\ndef tuple_to_int(input_tuple: tuple) -> int:\n    \"\"\"\n    Converts a tuple of positive integers into a single integer by decimal concatenation.\n    Raises TypeError for non-tuple input, ValueError for empty tuple or invalid elements.\n    \"\"\"\n    _validate_input(input_tuple)\n    _validate_elements(input_tuple)\n    \n    decimal_string = _concatenate_decimal_strings(input_tuple)\n    \n    return int(decimal_string)"}
{"task_id": "Mbpp/119", "solution": "from dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass InputArray:\n    \"\"\"Represents the input container.\"\"\"\n    elements: List[int]\n\n@dataclass\nclass Element:\n    \"\"\"Conceptual representation of a distinct element and its count.\"\"\"\n    value: int\n    count: int\n\n@dataclass\nclass SearchResult:\n    \"\"\"Represents the computed search result.\"\"\"\n    value: int\n\ndef validate(nums: List[int]) -> None:\n    \"\"\"Raise ValueError if nums is not a valid input per functional requirements.\"\"\"\n    n = len(nums)\n    if n == 0:\n        raise ValueError(\"Input array cannot be empty.\")\n    if n % 2 == 0:\n        raise ValueError(\"Input array length must be odd to have a single unique element.\")\n\n    for i in range(n - 1):\n        if nums[i] > nums[i+1]:\n            raise ValueError(\"Input array must be sorted in non-decreasing order.\")\n\n    # Check for exactly one unique element conforming to the pattern\n    unique_count = 0\n    i = 0\n    while i < n:\n        if i == n - 1 or nums[i] != nums[i+1]:\n            unique_count += 1\n            i += 1\n        else: # nums[i] == nums[i+1]\n            i += 2\n    \n    if unique_count != 1:\n        raise ValueError(\"Input array does not conform to the duplicate-everything-except-one pattern (exactly one unique element expected).\")\n\n\ndef binarySearchUnique(nums: List[int]) -> int:\n    \"\"\"Return the unique integer assuming nums is valid; expected O(log n).\"\"\"\n    low = 0\n    high = len(nums) - 1\n\n    while low < high:\n        mid = low + (high - low) // 2\n        \n        if mid % 2 == 0: # mid is an even index\n            if nums[mid] == nums[mid + 1]:\n                # The pair (nums[mid], nums[mid+1]) is intact. Unique is to the right.\n                low = mid + 2\n            else:\n                # nums[mid] is unique or starts a broken pair. Unique is in the left half (including mid).\n                high = mid\n        else: # mid is an odd index\n            if nums[mid] == nums[mid - 1]:\n                # The pair (nums[mid-1], nums[mid]) is intact. Unique is to the right.\n                low = mid + 1\n            else:\n                # nums[mid-1] is unique or starts a broken pair. Unique is in the left half (excluding mid).\n                high = mid - 1\n            \n    return nums[low]\n\ndef search(nums: List[int]) -> int:\n    \"\"\"Public API: validate and return the unique integer.\n    Raises: ValueError if validation fails.\n    \"\"\"\n    validate(nums)\n    return binarySearchUnique(nums)"}
{"task_id": "Mbpp/120", "solution": "from typing import List, Tuple, Union\n\nNumber = Union[int, float]\n\nclass Tuple2:\n    \"\"\"Helper class to represent a 2-element tuple.\"\"\"\n    def __init__(self, a: Number, b: Number):\n        self.a = a\n        self.b = b\n\n    def product(self) -> Number:\n        \"\"\"Calculates the product of its two elements.\"\"\"\n        return self.a * self.b\n\ndef computeAbsoluteProduct(t: Tuple2) -> Number:\n    \"\"\"Computes the absolute value of the product of a Tuple2's elements.\"\"\"\n    return abs(t.product())\n\ndef max_product_tuple(input_list: List[Tuple[Number, Number]]) -> Number:\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples within a given list.\n    \"\"\"\n    list_of_absolute_products: List[Number] = []\n    for item in input_list:\n        a, b = item\n        tuple2_instance = Tuple2(a, b)\n        absolute_product = computeAbsoluteProduct(tuple2_instance)\n        list_of_absolute_products.append(absolute_product)\n    \n    return max(list_of_absolute_products)"}
{"task_id": "Mbpp/123", "solution": "def amicable_numbers_sum(limit: int) -> int:\n    \"\"\"\n    Sums all amicable numbers from 1 to a specified number.\n    e.g., amicable_numbers_sum(999) == 504 (which is 220 + 284)\n    \"\"\"\n    import math\n\n    class DivisorSumCalculator:\n        \"\"\"Calculates the sum of proper divisors for a given positive integer.\"\"\"\n\n        def sumOfProperDivisors(self, n: int) -> int:\n            \"\"\"Returns the sum of positive divisors of n strictly less than n.\"\"\"\n            if n <= 0:\n                return 0\n            if n == 1:\n                return 0\n\n            divisor_sum = 1\n            for i in range(2, int(math.sqrt(n)) + 1):\n                if n % i == 0:\n                    divisor_sum += i\n                    if i * i != n:\n                        divisor_sum += n // i\n            return divisor_sum\n\n    class AmicableNumbersService:\n        \"\"\"Orchestrates the identification and summation of amicable numbers.\"\"\"\n        def __init__(self, calculator: DivisorSumCalculator):\n            self.calculator = calculator\n\n        def amicable_numbers_sum(self, limit: int) -> int:\n            \"\"\"Calculates the sum of all amicable numbers in the range [1, limit].\"\"\"\n            amicable_numbers_set = set()\n\n            for n in range(1, limit + 1):\n                sum_div_n = self.calculator.sumOfProperDivisors(n)\n\n                # Skip if n is a perfect number, if its potential partner is out of bounds,\n                # or if we've already processed this pair (by checking n < sum_div_n).\n                if sum_div_n == n or sum_div_n > limit or sum_div_n < n:\n                    continue\n\n                sum_div_sum_div_n = self.calculator.sumOfProperDivisors(sum_div_n)\n\n                # If sum_div_sum_div_n equals n, we found an amicable pair\n                if sum_div_sum_div_n == n:\n                    amicable_numbers_set.add(n)\n                    amicable_numbers_set.add(sum_div_n)\n            \n            return sum(amicable_numbers_set)\n\n    calculator = DivisorSumCalculator()\n    service = AmicableNumbersService(calculator)\n    return service.amicable_numbers_sum(limit)"}
{"task_id": "Mbpp/125", "solution": "def find_length(binary_string: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and 1s in any substring.\n    Maps '0' to +1 and '1' to -1, then applies Kadane's algorithm.\n    \"\"\"\n\n    class BinaryString:\n        \"\"\"Encapsulates the input binary string and provides validation.\"\"\"\n        def __init__(self, value: str):\n            self.value = value\n\n        def isValid(self) -> bool:\n            \"\"\"Checks if the string is non-empty and contains only '0' or '1' characters.\"\"\"\n            if not self.value:\n                return False\n            return all(c in ('0', '1') for c in self.value)\n\n        def length(self) -> int:\n            \"\"\"Returns the length of the binary string.\"\"\"\n            return len(self.value)\n\n    class Finder:\n        \"\"\"Handles mapping and computes the maximum subarray sum using Kadane's algorithm.\"\"\"\n        def mapStringToValues(self, s: str) -> list[int]:\n            \"\"\"Maps '0' to +1 and '1' to -1 for the given string.\"\"\"\n            return [1 if char == '0' else -1 for char in s]\n\n        def computeMaxDifference(self, mapped_values: list[int]) -> int:\n            \"\"\"Applies Kadane's algorithm to find the maximum subarray sum.\"\"\"\n            # Per design, mapped_values will not be empty due to BinaryString.isValid check.\n            current_max = mapped_values[0]\n            global_max = mapped_values[0]\n\n            for i in range(1, len(mapped_values)):\n                current_max = max(mapped_values[i], current_max + mapped_values[i])\n                global_max = max(global_max, current_max)\n\n            return global_max\n\n    # Workflow for find_length function\n    bs = BinaryString(binary_string)\n    if not bs.isValid():\n        raise ValueError(\"input contains invalid characters\")\n\n    finder = Finder()\n    mapped_values = finder.mapStringToValues(binary_string)\n    max_difference = finder.computeMaxDifference(mapped_values)\n\n    return max_difference"}
