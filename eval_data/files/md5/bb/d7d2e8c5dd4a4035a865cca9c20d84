{"task_id": "Mbpp/244", "solution": "import math\n\ndef next_Perfect_Square(n: int) -> int:\n    \"\"\"\n    Finds the next perfect square strictly greater than the given number n.\n    \"\"\"\n    # Calculate the integer square root of n.\n    # math.isqrt(n) returns floor(sqrt(n)) for n >= 0.\n    r = math.isqrt(n)\n\n    # If the current square (r*r) is less than or equal to n,\n    # then the root for the next perfect square must be r + 1.\n    # Otherwise, r*r is already strictly greater than n, so r is the correct root.\n    if r * r <= n:\n        r = r + 1\n    \n    return r * r"}
{"task_id": "Mbpp/239", "solution": "from typing import List, Optional\n\nclass Validator:\n    \"\"\"Centralized Validator for input checks.\"\"\"\n    @staticmethod\n    def validatePositiveInteger(value) -> bool:\n        \"\"\"Checks if a value is a positive integer.\"\"\"\n        return isinstance(value, int) and value >= 1\n\n    @staticmethod\n    def raiseInvalidParameterError() -> None:\n        \"\"\"Raises a ValueError for invalid parameters.\"\"\"\n        raise ValueError('Invalid parameter: m and n must be positive integers')\n\nclass ParameterSet:\n    \"\"\"Encapsulates m and n and delegates validation.\"\"\"\n    def __init__(self, m: int, n: int):\n        self._m = m\n        self._n = n\n\n    @property\n    def m(self) -> int:\n        return self._m\n\n    @property\n    def n(self) -> int:\n        return self._n\n\n    def validate(self) -> None:\n        \"\"\"Validates m and n using Validator.\"\"\"\n        if not Validator.validatePositiveInteger(self.m) or not Validator.validatePositiveInteger(self.n):\n            Validator.raiseInvalidParameterError()\n\nclass SequenceElement:\n    \"\"\"Domain class representing a single sequence element value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass Sequence:\n    \"\"\"Sequence domain class responsible for counting using memoization.\"\"\"\n    def __init__(self, length: int, parameter_set: ParameterSet, elements: Optional[List[SequenceElement]] = None):\n        self.length = length\n        self.parameter_set = parameter_set\n        self._memo = {}  # Cache keyed by (position, previous_element_value)\n\n    def _count_recursive(self, current_pos: int, prev_value: Optional[int]) -> int:\n        \"\"\"Recursive helper with memoization to count valid sequences.\"\"\"\n        if current_pos == self.length:\n            return 1 # A complete valid sequence of desired length found\n\n        memo_key = (current_pos, prev_value)\n        if memo_key in self._memo:\n            return self._memo[memo_key]\n\n        count = 0\n        if current_pos == 0:\n            # For the first element, it can be any positive integer up to m.\n            for first_val in range(1, self.parameter_set.m + 1):\n                count += self._count_recursive(current_pos + 1, first_val)\n        else:\n            # For subsequent elements, it must be >= 2 * prev_value and <= m.\n            min_next_val = 2 * prev_value\n            for next_val in range(min_next_val, self.parameter_set.m + 1):\n                count += self._count_recursive(current_pos + 1, next_val)\n        \n        self._memo[memo_key] = count\n        return count\n\n    def countVariants(self) -> int:\n        \"\"\"Returns the total number of valid sequences.\"\"\"\n        return self._count_recursive(0, None) # Start recursion for position 0 with no previous value\n\nclass Result:\n    \"\"\"Result domain class holding the total count.\"\"\"\n    def __init__(self, totalCount: int):\n        self.totalCount = totalCount\n\ndef get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Finds the number of possible sequences of length n,\n    such that each element is a positive integer and is greater than or equal to\n    twice the previous element but less than or equal to m.\n    \"\"\"\n    parameter_set = ParameterSet(m, n)\n    parameter_set.validate()\n\n    if n == 1:\n        return m\n\n    seq = Sequence(length=n, parameter_set=parameter_set)\n    total_count = seq.countVariants()\n    \n    result = Result(total_count)\n    return result.totalCount"}
{"task_id": "Mbpp/245", "solution": "from typing import List, Sequence\n\nclass ArrayInput:\n    \"\"\"Wraps and validates the input ordered list/array of numeric elements.\"\"\"\n    def __init__(self, elements: List[float]) -> None:\n        self.elements = elements\n\nclass Subsequence:\n    \"\"\"Represents a subsequence derived from ArrayInput and provides its sum.\"\"\"\n    def __init__(self, elements: List[float]) -> None:\n        self.elements = elements\n    \n    def sum(self) -> float:\n        return float(sum(self.elements))\n\nclass BitonicSubsequence(Subsequence):\n    \"\"\"Represents candidate subsequences that are first increasing then decreasing and detects bitonic property.\"\"\"\n    def isBitonic(self) -> bool:\n        if not self.elements:\n            return True # An empty sequence or single element sequence is considered bitonic.\n        \n        n = len(self.elements)\n        if n == 1:\n            return True\n\n        peak_idx = 0\n        # Find the peak: strictly increasing phase\n        while peak_idx < n - 1 and self.elements[peak_idx] < self.elements[peak_idx + 1]:\n            peak_idx += 1\n        \n        # Check if the increasing part is strictly increasing\n        for i in range(peak_idx):\n            if self.elements[i] >= self.elements[i+1]:\n                return False\n\n        # Check if the decreasing part is strictly decreasing\n        for i in range(peak_idx, n - 1):\n            if self.elements[i] <= self.elements[i+1]:\n                return False\n        \n        return True\n\nclass Result:\n    \"\"\"DTO holding computed maximum sum.\"\"\"\n    def __init__(self, maxSum: float) -> None:\n        self.maxSum = maxSum\n\nclass MaxSumAlgorithm:\n    \"\"\"Computes the maximum-sum bitonic subsequence using dynamic programming.\"\"\"\n    def _compute_increasing_sums(self, array: ArrayInput) -> List[float]:\n        n = len(array.elements)\n        if n == 0:\n            return []\n\n        msis = [0.0] * n # Maximum sum increasing subsequence ending at index i\n        for i in range(n):\n            msis[i] = array.elements[i]\n            for j in range(i):\n                if array.elements[j] < array.elements[i]:\n                    msis[i] = max(msis[i], msis[j] + array.elements[i])\n        return msis\n\n    def _compute_decreasing_sums(self, array: ArrayInput) -> List[float]:\n        n = len(array.elements)\n        if n == 0:\n            return []\n\n        msds = [0.0] * n # Maximum sum decreasing subsequence starting at index i\n        for i in range(n - 1, -1, -1):\n            msds[i] = array.elements[i]\n            for j in range(n - 1, i, -1): # Iterate from right to i+1\n                if array.elements[j] < array.elements[i]:\n                    msds[i] = max(msds[i], msds[j] + array.elements[i])\n        return msds\n\n    def max_sum(self, array: ArrayInput) -> Result:\n        \"\"\"Computes the maximum sum of a bitonic subsequence for the given ArrayInput.\"\"\"\n        n = len(array.elements)\n        if n == 0:\n            # This case should ideally be handled by the top-level max_sum function.\n            # Returning -inf here to propagate an invalid state.\n            return Result(float('-inf')) \n\n        msis = self._compute_increasing_sums(array)\n        msds = self._compute_decreasing_sums(array)\n\n        max_bitonic_sum = float('-inf')\n\n        # A single element is considered a bitonic subsequence.\n        # If the array has only one element, msis[0] + msds[0] - array.elements[0] correctly gives array.elements[0].\n        # For non-empty arrays, max_bitonic_sum will always be updated to a valid sum.\n        for i in range(n):\n            current_sum = msis[i] + msds[i] - array.elements[i]\n            max_bitonic_sum = max(max_bitonic_sum, current_sum)\n        \n        return Result(max_bitonic_sum)\n\ndef max_sum(array: Sequence[float]) -> int:\n    \"\"\"\n    Calculates the maximum sum of a bitonic subsequence for the given array.\n    A sequence is bitonic if it is first strictly increasing and then strictly decreasing.\n    \"\"\"\n    if not isinstance(array, (list, tuple)):\n        raise TypeError(\"Input must be a list or tuple of numbers.\")\n\n    processed_array: List[float] = []\n    for x in array:\n        if not isinstance(x, (int, float)):\n            raise TypeError(\"All elements in the array must be numbers.\")\n        processed_array.append(float(x))\n\n    if not processed_array:\n        raise ValueError(\"Input array cannot be empty.\")\n\n    array_input = ArrayInput(processed_array)\n    algorithm = MaxSumAlgorithm()\n    result = algorithm.max_sum(array_input)\n    \n    return int(round(result.maxSum))"}
{"task_id": "Mbpp/251", "solution": "def insert_element(input_list, element):\n    \"\"\"Return a new list where element appears immediately before each item in input_list.\n\n    Args:\n        input_list: list\n        element: any\n\n    Returns:\n        list\n    \"\"\"\n    result = []\n    for item in input_list:\n        result.append(element)\n        result.append(item)\n    return result"}
{"task_id": "Mbpp/247", "solution": "def lps(input: str) -> int:\n    \"\"\"\n    Finds the length of the longest palindromic subsequence in the given string.\n    Uses dynamic programming to compute the LPS length.\n    \"\"\"\n    n = len(input)\n\n    # dp[i][j] stores the length of the longest palindromic subsequence\n    # of the substring input[i...j]\n    dp = [[0] * n for _ in range(n)]\n\n    # All substrings of length 1 have LPS length 1\n    for i in range(n):\n        dp[i][i] = 1\n\n    # Fill the table for substrings of length 2 to n\n    for length in range(2, n + 1):\n        for i in range(n - length + 1):\n            j = i + length - 1\n            if input[i] == input[j]:\n                # If characters match, add 2 (for current i and j)\n                # plus the LPS of the inner substring input[i+1...j-1].\n                # dp[i+1][j-1] will be 0 if i+1 > j-1 (i.e., length is 2).\n                dp[i][j] = 2 + dp[i+1][j-1]\n            else:\n                # If characters don't match, take the maximum of\n                # LPS of input[i+1...j] (excluding input[i])\n                # and LPS of input[i...j-1] (excluding input[j]).\n                dp[i][j] = max(dp[i+1][j], dp[i][j-1])\n\n    # The result for the entire string is stored in dp[0][n-1]\n    return dp[0][n-1]"}
{"task_id": "Mbpp/252", "solution": "def convert(number):\n    \"\"\"Converts a complex number to polar coordinates (r, theta).\"\"\"\n    import math\n\n    class ComplexNumber:\n        \"\"\"Represents a complex number and provides polar conversion operations.\"\"\"\n        def __init__(self, real: float, imag: float):\n            self.real = real\n            self.imag = imag\n\n        def abs(self) -> float:\n            \"\"\"Computes the modulus (r) of the complex number.\"\"\"\n            return math.hypot(self.real, self.imag)\n\n        def arg(self) -> float:\n            \"\"\"Computes the argument (theta) of the complex number in radians.\"\"\"\n            return math.atan2(self.imag, self.real)\n\n    class Converter:\n        \"\"\"Encapsulates the logic for converting numbers to polar coordinates.\"\"\"\n        def convert(self, number) -> tuple[float, float]:\n            \"\"\"Normalizes input and performs the conversion to (r, theta).\"\"\"\n            real: float\n            imag: float\n\n            if isinstance(number, complex):\n                real = number.real\n                imag = number.imag\n            else:\n                real = float(number)\n                imag = 0.0\n\n            complex_num = ComplexNumber(real, imag)\n            r = complex_num.abs()\n            theta = complex_num.arg()\n            return (float(r), float(theta))\n\n    return Converter().convert(number)"}
{"task_id": "Mbpp/250", "solution": "from typing import Any\n\ndef count_X(t: tuple, x: Any) -> int:\n    \"\"\"Counts the occurrences of an element in a tuple. Iterates through the tuple and increments a counter for each match.\"\"\"\n    count = 0\n    for item in t:\n        if item == x:\n            count += 1\n    return count"}
{"task_id": "Mbpp/253", "solution": "def count_integer(lst):\n    \"\"\"Return the number of elements in lst whose type is exactly int.\n\n    Args:\n        lst: Python list to inspect.\n\n    Returns:\n        int: number of elements e in lst where type(e) == int.\n\n    Raises:\n        TypeError: if lst is not a list.\n    \"\"\"\n    if type(lst) is not list:\n        raise TypeError(\"count_integer requires a list\")\n    count = 0\n    for e in lst:\n        if type(e) == int:\n            count += 1\n    return count"}
{"task_id": "Mbpp/255", "solution": "class InputValidator:\n    \"\"\"Provides static methods for validating input parameters.\"\"\"\n    @staticmethod\n    def validate_items(items):\n        \"\"\"Checks if the given items argument is a list.\"\"\"\n        return isinstance(items, list)\n\n    @staticmethod\n    def validate_n(n):\n        \"\"\"Checks if n is an integer and is greater than or equal to 1.\"\"\"\n        return isinstance(n, int) and n >= 1\n\nclass ItemList:\n    \"\"\"Wraps a list of items for use by the generator.\"\"\"\n    def __init__(self, items):\n        self.items = items\n\n    def length(self):\n        \"\"\"Returns the number of items in the list.\"\"\"\n        return len(self.items)\n\nclass Combination:\n    \"\"\"Represents a single combination as an immutable tuple.\"\"\"\n    def __init__(self, elements):\n        self.elements = tuple(elements)\n\n    def to_tuple(self):\n        \"\"\"Returns the combination as a tuple.\"\"\"\n        return self.elements\n\nclass CombinationList:\n    \"\"\"Manages a list of Combination objects.\"\"\"\n    def __init__(self):\n        self.combinations = []\n\n    def add(self, combination):\n        \"\"\"Adds a Combination object to the list.\"\"\"\n        self.combinations.append(combination)\n\n    def to_list(self):\n        \"\"\"Converts the internal list of Combination objects to a list of tuples.\"\"\"\n        return [c.to_tuple() for c in self.combinations]\n\nclass CombinationGenerator:\n    \"\"\"Generates all combinations with repetition of length n from a given list of items.\"\"\"\n    def __init__(self, items, n):\n        self.items_list = ItemList(items)\n        self.n = n\n\n    def generate(self):\n        \"\"\"Produces all combinations with repetition and returns them in a CombinationList.\"\"\"\n        result_list = CombinationList()\n        m = self.items_list.length()\n\n        if self.n == 1:\n            for item in self.items_list.items:\n                result_list.add(Combination((item,)))\n            return result_list\n\n        indices = [0] * self.n\n\n        while True:\n            current_combination_elements = []\n            for i in range(self.n):\n                current_combination_elements.append(self.items_list.items[indices[i]])\n            result_list.add(Combination(tuple(current_combination_elements)))\n\n            k = self.n - 1\n            while k >= 0:\n                indices[k] += 1\n                if indices[k] < m:\n                    break\n                indices[k] = 0\n                k -= 1\n\n            if k < 0:\n                break\n        \n        return result_list\n\ndef combinations_colors(items, n):\n    \"\"\"\n    Generates all combinations (with repetition) of the elements of the list and \n    returns a list with a tuple for each combination.\n    \"\"\"\n    if not InputValidator.validate_items(items):\n        raise ValueError('items must be a list')\n    if not InputValidator.validate_n(n):\n        raise ValueError('n must be an integer >= 1')\n    \n    gen = CombinationGenerator(items, n)\n    comb_list = gen.generate()\n    return comb_list.to_list()"}
