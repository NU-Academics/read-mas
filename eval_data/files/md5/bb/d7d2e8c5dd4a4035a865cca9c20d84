{"task_id": "Mbpp/749", "solution": "class NumericString:\n    \"\"\"Encapsulates a raw input string and provides conversion to integer.\"\"\"\n    def __init__(self, rawValue: str):\n        self.rawValue = rawValue\n\n    def toInteger(self) -> int:\n        \"\"\"Parses the rawValue as a base-10 integer, raising ValueError on failure.\"\"\"\n        return int(self.rawValue)\n\nclass SortNumericStrings:\n    \"\"\"Coordinates conversion of input strings to integers and performs numeric ascending sort.\"\"\"\n    def execute(self, input_list: list[str]) -> list[int]:\n        \"\"\"Converts and sorts input elements, returning a sorted list of integers.\"\"\"\n        int_values = []\n        for raw in input_list:\n            ns = NumericString(raw)\n            value = ns.toInteger()\n            int_values.append(value)\n        sorted_list = sorted(int_values)\n        return sorted_list\n\ndef sort_numeric_strings(inputList: list[str]) -> list[int]:\n    \"\"\"Sorts a list of strings of numbers numerically, returning a list of integers.\"\"\"\n    orchestrator = SortNumericStrings()\n    return orchestrator.execute(inputList)"}
{"task_id": "Mbpp/748", "solution": "from typing import Optional\n\ndef _should_insert_space(prev_char: Optional[str], curr_char: str, next_char: Optional[str]) -> bool:\n    \"\"\"\n    Determines if a space should be inserted before curr_char based on word break and acronym rules.\n    This helper applies rules from BR7 interpretation.\n    \"\"\"\n    # Rule 1: Do not insert a space at the beginning of the string (index 0).\n    if prev_char is None:\n        return False\n\n    # Rule 2: Only consider inserting a space if the current character is an uppercase letter.\n    if not curr_char.isupper():\n        return False\n\n    # Rule 3: Insert if the previous character was a lowercase letter or a digit.\n    # This handles cases like \"helloWorld\" -> \"hello World\" or \"word1Word\" -> \"word1 Word\".\n    if prev_char.islower() or prev_char.isdigit():\n        return True\n\n    # Rule 4: Handle acronym splits, e.g., \"HTTPServer\" -> \"HTTP Server\".\n    # Insert if the previous character was uppercase, the current is uppercase,\n    # and the next character (if it exists) is lowercase.\n    if prev_char.isupper() and next_char is not None and next_char.islower():\n        return True\n\n    return False\n\ndef capital_words_spaces(input_string: str) -> str:\n    \"\"\"\n    Inserts spaces between words starting with capital letters in a given string,\n    adhering to specified word break and acronym rules.\n    \"\"\"\n    if not input_string:\n        return \"\"\n\n    result_chars = []\n    n = len(input_string)\n\n    for i in range(n):\n        curr_char = input_string[i]\n        prev_char = input_string[i-1] if i > 0 else None\n        next_char = input_string[i+1] if i < n - 1 else None\n\n        if _should_insert_space(prev_char, curr_char, next_char):\n            result_chars.append(' ')\n        result_chars.append(curr_char)\n\n    return \"\".join(result_chars)"}
