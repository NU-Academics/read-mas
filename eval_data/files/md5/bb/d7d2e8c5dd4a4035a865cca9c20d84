{"task_id": "Mbpp/790", "solution": "from typing import List\n\nclass IntegerElement:\n    \"\"\"Represents an integer element and provides an evenness check.\"\"\"\n    def __init__(self, value: int) -> None:\n        self._value: int = value\n    def is_even(self) -> bool:\n        return (self._value % 2) == 0\n\nclass IntegerList:\n    \"\"\"Wraps a list of integers for indexed access and length.\"\"\"\n    def __init__(self, elements: List[int]) -> None:\n        self._elements: List[int] = elements\n    def get(self, index: int) -> int:\n        return self._elements[index]\n    def length(self) -> int:\n        return len(self._elements)\n\ndef even_position(items: List[int]) -> bool:\n    \"\"\"Checks if every element at an even index in the list is an even number.\"\"\"\n    integer_list = IntegerList(items)\n    n = integer_list.length()\n    i = 0\n    while i < n:\n        value = integer_list.get(i)\n        elem = IntegerElement(value)\n        if not elem.is_even():\n            return False\n        i += 2\n    return True"}
{"task_id": "Mbpp/791", "solution": "from dataclasses import dataclass\nfrom typing import Any, List, Tuple\n\n@dataclass\nclass InputTuple:\n    elements: List[Any]\n    def __init__(self, elements: Tuple[Any, ...] | List[Any]):\n        self.elements = list(elements)\n\n@dataclass\nclass Element:\n    value: Any\n    type: type\n    is_tuple: bool\n    def __init__(self, value: Any):\n        self.value = value\n        self.type = type(value)\n        self.is_tuple = isinstance(value, tuple)\n\n@dataclass\nclass OutputTuple:\n    elements: List[Any]\n    def __init__(self) -> None:\n        self.elements = []\n    def append(self, value: Any) -> None:\n        self.elements.append(value)\n    def to_tuple(self) -> tuple:\n        return tuple(self.elements)\n\ndef remove_nested(input: tuple) -> tuple:\n    \"\"\"\n    Removes top-level tuple elements from the given input tuple.\n    Non-tuple elements are preserved in their original order.\n    \"\"\"\n    it = InputTuple(input)\n    ot = OutputTuple()\n    for v in it.elements:\n        el = Element(v)\n        if not el.is_tuple:\n            ot.append(el.value)\n    return ot.to_tuple()"}
