{"task_id": "Mbpp/409", "solution": "from typing import List, Tuple, Any\n\nclass ValidationError(Exception):\n    \"\"\"Custom exception for validation errors in input.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass TuplePair:\n    \"\"\"Represents a validated two-element tuple and computes its product.\"\"\"\n    def __init__(self, a: int, b: int) -> None:\n        self.a = a\n        self.b = b\n\n    def product(self) -> int:\n        \"\"\"Computes the product of the two elements.\"\"\"\n        return self.a * self.b\n\nclass ProductCollection:\n    \"\"\"Collects per-tuple products and returns the minimum product.\"\"\"\n    def __init__(self) -> None:\n        self.products: List[int] = []\n\n    def add(self, product: int) -> None:\n        \"\"\"Adds a product to the collection.\"\"\"\n        self.products.append(product)\n\n    def getMin(self) -> int:\n        \"\"\"Returns the minimum product. Raises ValidationError if the collection is empty.\"\"\"\n        if not self.products:\n            raise ValidationError(\"No products to compute a minimum from. Input list might have been empty or contained no valid pairs.\")\n        return min(self.products)\n\nclass InputList:\n    \"\"\"Validates raw input list and produces validated TuplePair instances.\"\"\"\n    def __init__(self, tuples_raw: Any) -> None:\n        self.tuples_raw = tuples_raw\n        self.tuples: List[TuplePair] = []\n\n    def validate(self) -> None:\n        \"\"\"Validates the raw input and populates self.tuples or raises ValidationError.\"\"\"\n        if not isinstance(self.tuples_raw, list):\n            raise ValidationError(\"Input must be a list.\")\n        \n        for i, element in enumerate(self.tuples_raw):\n            if not isinstance(element, tuple):\n                raise ValidationError(f\"Element at index {i} is not a tuple. All elements in the input list must be tuples.\")\n            if len(element) != 2:\n                raise ValidationError(f\"Tuple at index {i} does not have exactly two elements. Each tuple must contain exactly two elements.\")\n            if not all(isinstance(x, int) for x in element):\n                raise ValidationError(f\"Elements within tuple at index {i} are not all integers. All elements within each tuple must be integers.\")\n            \n            self.tuples.append(TuplePair(element[0], element[1]))\n\ndef min_product_tuple(input_list: List[Tuple[int, int]]) -> int:\n    \"\"\"\n    Finds the minimum product from the pairs of tuples within a given list.\n    Validates input and computes the minimum product, raising ValidationError for invalid inputs.\n    \"\"\"\n    input_list_obj = InputList(input_list)\n    input_list_obj.validate()\n\n    product_collection = ProductCollection()\n    for tuple_pair in input_list_obj.tuples:\n        product_collection.add(tuple_pair.product())\n\n    return product_collection.getMin()"}
{"task_id": "Mbpp/412", "solution": "class Filter:\n    \"\"\"\n    Encapsulates the filtering algorithm to extract even numbers.\n    \"\"\"\n    def apply(self, nums: list) -> list:\n        \"\"\"\n        Iterates through the input list and returns a new list containing only even integers.\n        \"\"\"\n        even_numbers = []\n        for num in nums:\n            if num % 2 == 0:\n                even_numbers.append(num)\n        return even_numbers\n\ndef remove_odd(nums: list) -> list:\n    \"\"\"\n    Removes odd numbers from a given list, preserving the order of even numbers.\n    \"\"\"\n    filter_instance = Filter()\n    return filter_instance.apply(nums)"}
{"task_id": "Mbpp/410", "solution": "from typing import Iterator, Iterable, Optional, Union\n\nNumber = Union[int, float]\n\ndef _filter_numeric(iterable: Iterable) -> Iterator[Number]:\n    \"\"\"Yields only numeric elements (int or float) from the input iterable.\"\"\"\n    for item in iterable:\n        if isinstance(item, (int, float)):\n            yield item\n\ndef _find_min(numeric_iterable: Iterator[Number]) -> Optional[Number]:\n    \"\"\"Finds the minimum value in a numeric iterator, returning None if empty.\"\"\"\n    min_val_found = None\n    first_item = True\n    for num in numeric_iterable:\n        if first_item:\n            min_val_found = num\n            first_item = False\n        elif num < min_val_found:\n            min_val_found = num\n    return min_val_found\n\ndef min_val(input_list: list) -> Optional[Number]:\n    \"\"\"\n    Finds the minimum numeric value in a heterogeneous list.\n    Ignores non-numeric elements and returns None if no numeric elements are found.\n    \"\"\"\n    numeric_elements = _filter_numeric(input_list)\n    result = _find_min(numeric_elements)\n    return result"}
{"task_id": "Mbpp/413", "solution": "def extract_nth_element(lst, n):\n    \"\"\"\n    Extracts the nth element from each tuple in a list of tuples.\n    Returns a new list with the extracted elements, preserving order.\n    \"\"\"\n    extracted_elements = []\n    for item_tuple in lst:\n        extracted_elements.append(item_tuple[n])\n    return extracted_elements"}
