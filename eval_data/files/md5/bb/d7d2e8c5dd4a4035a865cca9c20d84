{"task_id": "Mbpp/422", "solution": "def find_Average_Of_Cube(n):\n    \"\"\"\n    Finds the average of cubes of the first n natural numbers.\n    Raises ValueError if n is not a positive integer.\n    \"\"\"\n\n    class InputValidator:\n        \"\"\"Validates input n is a positive integer.\"\"\"\n        @staticmethod\n        def validate_n(n) -> None:\n            if not isinstance(n, int) or n < 1:\n                raise ValueError(\"n must be an integer >= 1\")\n\n    class CubeCalculator:\n        \"\"\"Calculates the sum of cubes of first n natural numbers.\"\"\"\n        @staticmethod\n        def compute_sum_of_cubes(n) -> int:\n            # Identity for sum of cubes: (n*(n+1)/2)^2\n            sum_of_naturals = n * (n + 1) // 2\n            return sum_of_naturals ** 2\n\n    class AverageCalculator:\n        \"\"\"Calculates the average of a sum of cubes and n.\"\"\"\n        @staticmethod\n        def compute_average(sum_cubes: int, n: int) -> float:\n            return float(sum_cubes) / float(n)\n\n    class AverageResult:\n        \"\"\"Data holder for the average result.\"\"\"\n        def __init__(self, value: float):\n            self.value = value\n\n    InputValidator.validate_n(n)\n    sum_of_cubes = CubeCalculator.compute_sum_of_cubes(n)\n    average = AverageCalculator.compute_average(sum_of_cubes, n)\n    result = AverageResult(average)\n    return result.value"}
