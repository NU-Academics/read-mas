{"task_id": "Mbpp/94", "solution": "def index_minimum(input_list):\n    \"\"\"\n    Given a list of tuples, returns the first value of the tuple with the smallest second value.\n    This function performs input validation and stable tie-breaking.\n    \"\"\"\n\n    def _validate_input(lst):\n        \"\"\"\n        Validates the input list for type, emptiness, and item format.\n        Raises ValueError if lst is empty. Raises TypeError for invalid type or malformed items.\n        \"\"\"\n        if lst is None:\n            raise TypeError(\"Input list cannot be None.\")\n\n        # Try to get length, assuming list/tuple or something with __len__\n        try:\n            length = len(lst)\n        except TypeError:\n            raise TypeError(\"Input must be a list or tuple.\")\n\n        if length == 0:\n            raise ValueError(\"Input list cannot be empty.\")\n\n        for idx, item in enumerate(lst):\n            if not isinstance(item, (list, tuple)):\n                raise TypeError(f'Item at index {idx} is not a 2-element tuple or list.')\n            if len(item) != 2:\n                raise TypeError(f'Item at index {idx} is not a 2-element tuple or list.')\n\n    _validate_input(input_list)\n\n    iterator = iter(input_list)\n    first_item = next(iterator)\n\n    selected_first = first_item[0]\n    selected_second = first_item[1]\n\n    for item in iterator:\n        second_value = item[1]\n        if second_value < selected_second:\n            selected_second = second_value\n            selected_first = item[0]\n\n    return selected_first"}
{"task_id": "Mbpp/95", "solution": "def Find_Min_Length(input_list_of_lists):\n    \"\"\"\n    Finds the length of the smallest list within a list of lists.\n    Raises ValueError if the input list of lists is empty.\n    \"\"\"\n    if not input_list_of_lists:\n        raise ValueError('input_list_of_lists must contain at least one inner list')\n    \n    lengths = [len(inner_list) for inner_list in input_list_of_lists]\n    return min(lengths)"}
{"task_id": "Mbpp/96", "solution": "def divisor(n: int) -> int:\n    \"\"\"\n    Calculates the number of positive divisors for a given integer n.\n    It efficiently counts divisors by iterating up to the square root of n.\n    \"\"\"\n    count = 0\n    i = 1\n    while i * i <= n:\n        if n % i == 0:\n            if i * i == n:\n                count += 1\n            else:\n                count += 2\n        i += 1\n    return count"}
{"task_id": "Mbpp/92", "solution": "def is_undulating(n: int) -> bool:\n    \"\"\"Public API per FR1: raise TypeError if not int; example: assert is_undulating(1212121) == True\"\"\"\n\n    class NumberInput:\n        def __init__(self, value: int) -> None:\n            if not isinstance(value, int):\n                raise TypeError(\"Input must be an integer.\")\n            self.value = value\n            self._abs_value = abs(value)\n\n        def is_valid(self) -> bool:\n            return isinstance(self.value, int)\n\n        def to_digit_string(self) -> str:\n            return str(self._abs_value)\n\n    class DigitSequence:\n        def __init__(self, digit_string: str) -> None:\n            self.digits = [int(d) for d in digit_string]\n            self.length = len(self.digits)\n\n        def get(self, index: int) -> int:\n            return self.digits[index]\n\n    class UndulatingResult:\n        def __init__(self, is_undulating: bool, reason: str = \"\") -> None:\n            self.is_undulating = is_undulating\n            self.reason = reason\n\n    class UndulatingChecker:\n        def evaluate(self, digit_sequence: DigitSequence) -> UndulatingResult:\n            if digit_sequence.length < 2:\n                return UndulatingResult(False, \"single-digit input\")\n\n            uniform_parity_0 = self.check_parity_group(digit_sequence, 0)\n            if not uniform_parity_0:\n                return UndulatingResult(False, \"Even-indexed digits not uniform\")\n\n            uniform_parity_1 = self.check_parity_group(digit_sequence, 1)\n            if not uniform_parity_1:\n                return UndulatingResult(False, \"Odd-indexed digits not uniform\")\n\n            representative_0 = digit_sequence.get(0)\n            representative_1 = digit_sequence.get(1)\n\n            if representative_0 == representative_1:\n                return UndulatingResult(False, \"Alternating digits are not distinct\")\n\n            return UndulatingResult(True)\n\n        def check_parity_group(self, digit_sequence: DigitSequence, parity: int) -> bool:\n            group_digits = []\n            for i in range(parity, digit_sequence.length, 2):\n                group_digits.append(digit_sequence.get(i))\n\n            if len(group_digits) < 2:\n                return True\n\n            first_digit = group_digits[0]\n            for digit in group_digits:\n                if digit != first_digit:\n                    return False\n            return True\n\n    number_input = NumberInput(n)\n    digit_string = number_input.to_digit_string()\n    digit_sequence = DigitSequence(digit_string)\n\n    checker = UndulatingChecker()\n    result = checker.evaluate(digit_sequence)\n\n    return result.is_undulating"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(value: int) -> str:\n    \"\"\"\n    Converts a decimal integer to its binary equivalent, represented as a string.\n    Returns \"0\" for an input of 0, and a binary string with no leading zeros for positive integers.\n    \"\"\"\n    if value == 0:\n        return '0'\n\n    binary_digits = []\n    current_value = value\n    while current_value > 0:\n        binary_digits.append(str(current_value % 2))\n        current_value //= 2\n    return \"\".join(reversed(binary_digits))"}
{"task_id": "Mbpp/97", "solution": "from typing import Any, List, Iterator\n\ndef frequency_lists(input: List[List[Any]]) -> dict:\n    \"\"\"\n    Public API: Accepts a list of lists and returns a dict mapping element -> int count.\n    Raises TypeError if 'input' is not a list or contains non-list sub-elements.\n    \"\"\"\n\n    def _validate_input(input_data) -> None:\n        \"\"\"Raise TypeError if input is not a list of lists.\"\"\"\n        if not isinstance(input_data, list):\n            raise TypeError(\"Input must be a list.\")\n        for sublist in input_data:\n            if not isinstance(sublist, list):\n                raise TypeError(\"All elements of the input list must be lists.\")\n\n    def _flatten_sublists(input_data) -> Iterator[Any]:\n        \"\"\"Yield each element from every sublist in 'input_data'.\"\"\"\n        for sublist in input_data:\n            yield from sublist\n\n    def _count_elements(iterable) -> dict:\n        \"\"\"Return a dict mapping each element from iterable to an int count.\"\"\"\n        counts = {}\n        for element in iterable:\n            counts[element] = counts.get(element, 0) + 1\n        return counts\n\n    _validate_input(input)\n    flattened_elements = _flatten_sublists(input)\n    return _count_elements(flattened_elements)"}
{"task_id": "Mbpp/98", "solution": "def multiply_num(numbers):\n    \"\"\"\n    Multiplies all numbers in a list or tuple and divides by its length, returning a float.\n    An empty input will lead to a ZeroDivisionError as per strict completion requirements.\n    \"\"\"\n    product = 1\n    for num in numbers:\n        product *= num\n    \n    length = len(numbers)\n    \n    result = float(product) / length\n    return result"}
{"task_id": "Mbpp/101", "solution": "def kth_element(array, k):\n    \"\"\"Return element at 1-based index k from array.\n\n    Raises:\n        Error: if validation fails (InvalidArray, InvalidIndexType, IndexOutOfRange).\n    \"\"\"\n    # InputValidator and Error are expected to be imported from src.validator and src.errors\n    # by the environment where this function is executed, as per the design context.\n    validator = InputValidator()\n    validator.validate(array, k)\n    return array[k - 1]"}
{"task_id": "Mbpp/102", "solution": "def snake_to_camel(input_str: str) -> str:\n    # Splits the input string into words and capitalizes each word.\n    # Then joins them without separators to form a CamelCase string.\n    tokens = input_str.split('_')\n    capitalized_tokens = []\n    for token in tokens:\n        if token:\n            capitalized_tokens.append(token[0].upper() + token[1:])\n        else:\n            capitalized_tokens.append('')\n    return ''.join(capitalized_tokens)"}
{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(value: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome of a specified integer, returned as an integer.\n    It uses a mirror-and-increment approach to efficiently determine the next palindrome.\n    \"\"\"\n\n    def _get_mirrored_palindrome_candidate(left_half_base_str: str, total_length: int) -> str:\n        \"\"\"\n        Constructs a palindrome string from a left half base string and a desired total length.\n        The right half is created by reversing the left half, adjusted for odd total lengths.\n        \"\"\"\n        # For odd total_length, the middle digit (first char of reversed left_half_base_str) is not mirrored.\n        mirrored_right_half = left_half_base_str[::-1][total_length % 2 :]\n        return left_half_base_str + mirrored_right_half\n\n    s_value = str(value)\n    length = len(s_value)\n\n    # Determine the left half of the original number (including the middle digit for odd lengths).\n    left_half = s_value[: (length + 1) // 2]\n\n    # Generate an initial palindrome candidate by mirroring this left half.\n    candidate_str = _get_mirrored_palindrome_candidate(left_half, length)\n    candidate = int(candidate_str)\n\n    # If the generated candidate is not strictly greater than the input value,\n    # we need to increment the left half and re-mirror.\n    if candidate <= value:\n        incremented_left_half_int = int(left_half) + 1\n        incremented_left_half_str = str(incremented_left_half_int)\n\n        # Check if incrementing the left half caused its length to increase.\n        # This typically happens when the left half was composed entirely of '9's (e.g., '9' -> '10').\n        if len(incremented_left_half_str) > len(left_half):\n            # This indicates an \"all-9s\" scenario (e.g., 9 -> 11, 99 -> 101, 999 -> 1001).\n            # The new palindrome will have an increased length (original length + 1).\n            # The new `left_half_base_str` is `incremented_left_half_str` (e.g., \"10\" for 99).\n            # The new `total_length` is `length + 1`.\n            candidate = int(_get_mirrored_palindrome_candidate(incremented_left_half_str, length + 1))\n        else:\n            # The left half's length did not change upon increment.\n            # The new palindrome will retain the original `length`.\n            candidate = int(_get_mirrored_palindrome_candidate(incremented_left_half_str, length))\n\n    return candidate"}
{"task_id": "Mbpp/104", "solution": "def sort_sublists(collection):\n    \"\"\"\n    Sorts each sublist of strings in a given list of lists lexicographically.\n    Output is a list of lists.\n    \"\"\"\n    if len(collection) == 0:\n        return []\n\n    output = []\n    for sublist in collection:\n        if len(sublist) == 0:\n            output.append([])\n        else:\n            output.append(list(sorted(sublist)))\n    return output"}
