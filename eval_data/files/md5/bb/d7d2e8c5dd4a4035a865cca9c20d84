{"task_id": "Mbpp/286", "solution": "def kadane(list):\n    \"\"\"\n    Computes the maximum contiguous subarray sum for a single sequence.\n    Handles arrays with all negative numbers by returning the largest element.\n    \"\"\"\n    # Assuming list is non-empty based on external validation.\n    max_so_far = list[0]\n    current_max = list[0]\n\n    for i in range(1, len(list)):\n        current_max = max(list[i], current_max + list[i])\n        max_so_far = max(max_so_far, current_max)\n    return max_so_far\n\ndef kadane_spanning(list, k):\n    \"\"\"\n    Calculates the maximum subarray sum for a conceptual array repeated k times (k >= 2).\n    It considers subarrays entirely within one block and those spanning across repetitions.\n    \"\"\"\n    # Assuming list is non-empty based on external validation.\n\n    # 1. Max sum within a single block (non-spanning)\n    max_single_kadane = kadane(list)\n\n    # 2. Total sum of the original array\n    total_sum = sum(list)\n\n    # 3. Max prefix sum\n    current_prefix_sum = 0\n    max_prefix_sum = float('-inf')\n    for x in list:\n        current_prefix_sum += x\n        max_prefix_sum = max(max_prefix_sum, current_prefix_sum)\n\n    # 4. Max suffix sum\n    current_suffix_sum = 0\n    max_suffix_sum = float('-inf')\n    for x in reversed(list):\n        current_suffix_sum += x\n        max_suffix_sum = max(max_suffix_sum, current_suffix_sum)\n\n    # Initialize overall maximum with the best from a single block\n    max_overall = max_single_kadane\n\n    # Candidate spanning one boundary (for k >= 2)\n    # This covers cases like [...suffix][prefix...]\n    max_overall = max(max_overall, max_prefix_sum + max_suffix_sum)\n\n    # Candidate spanning multiple boundaries (for k > 2 and positive total_sum)\n    # This covers [...suffix][full_block...full_block][prefix...]\n    if k > 2 and total_sum > 0:\n        max_overall = max(max_overall, max_suffix_sum + total_sum * (k - 2) + max_prefix_sum)\n\n    return max_overall\n\ndef max_sub_array_sum_repeated(arr, n, k):\n    \"\"\"\n    Finds the largest sum of a contiguous subarray in an array formed by repeating `arr` `k` times.\n    This function orchestrates helper functions to avoid materializing the repeated array.\n    \"\"\"\n    # Per instructions, omit explicit validation for edge cases like empty arr or k < 1.\n    # These are assumed to be handled by external layers as per design context,\n    # guaranteeing arr is non-empty and k >= 1 for this function's execution.\n\n    if k == 1:\n        return kadane(arr)\n    else: # k >= 2\n        return kadane_spanning(arr, k)"}
{"task_id": "Mbpp/294", "solution": "def max_val(input_list):\n    \"\"\"\n    Finds the maximum numeric value (int or float) in a heterogeneous list.\n    If no numeric elements are found, it returns None.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"input_list must be a list\")\n\n    def _is_numeric(value):\n        \"\"\"\n        Internal helper to determine if a value is an integer or a float,\n        explicitly excluding boolean values.\n        \"\"\"\n        return type(value) is int or type(value) is float\n\n    numeric_values = []\n    for item in input_list:\n        if _is_numeric(item):\n            numeric_values.append(item)\n\n    if not numeric_values:\n        return None\n    else:\n        return max(numeric_values)"}
{"task_id": "Mbpp/293", "solution": "import math\n\ndef sqrt(x: float) -> float:\n    \"\"\"Provides the square root primitive.\"\"\"\n    return math.sqrt(x)\n\nclass RightAngledTriangle:\n    \"\"\"Represents a right-angled triangle and computes its hypotenuse.\"\"\"\n    def __init__(self, a: float, b: float) -> None:\n        self.a = a\n        self.b = b\n    def hypotenuse(self) -> float:\n        \"\"\"Computes the hypotenuse using the Pythagorean theorem.\"\"\"\n        return sqrt(self.a * self.a + self.b * self.b)\n\nclass TriangleCalculator:\n    \"\"\"Orchestrates the calculation of the hypotenuse.\"\"\"\n    @staticmethod\n    def otherside_rightangle(a, b) -> float:\n        triangle = RightAngledTriangle(a, b)\n        return triangle.hypotenuse()\n\ndef otherside_rightangle(a, b):\n    \"\"\"\n    Finds the third side (hypotenuse) of a right-angled triangle given two other sides.\n    \"\"\"\n    return TriangleCalculator.otherside_rightangle(a, b)"}
{"task_id": "Mbpp/296", "solution": "from dataclasses import dataclass\n\ndef get_Inv_Count(array):\n    \"\"\"Public API required by SRS, returns integer count of inversions.\"\"\"\n\n    @dataclass\n    class Array:\n        elements: list\n        def length(self) -> int:\n            return len(self.elements)\n\n    @dataclass\n    class Inversion:\n        i: int\n        j: int\n\n    class InversionCounter:\n        def get_Inv_Count(self, array: list) -> int:\n            \"\"\"Computes inversion count without mutating the input array.\"\"\"\n            n = len(array)\n            if n <= 1:\n                return 0\n\n            inversion_count = 0\n            for i in range(n):\n                for j in range(i + 1, n):\n                    if array[i] > array[j]:\n                        inversion_count += 1\n            return inversion_count\n\n    return InversionCounter().get_Inv_Count(array)"}
{"task_id": "Mbpp/299", "solution": "from typing import List, Tuple, Dict, Union\n\nclass TupleEntry:\n    \"\"\"Domain carrier for a single input tuple (name, value).\"\"\"\n    def __init__(self, name: str, value: Union[int, float]):\n        self.name = name\n        self.value = value\n\nclass AggregatedTotal:\n    \"\"\"Domain carrier for aggregated totals per name.\"\"\"\n    def __init__(self, name: str, total: Union[int, float]):\n        self.name = name\n        self.total = total\n\nclass MaxAggregateFunction:\n    \"\"\"Encapsulates aggregation and selection logic.\"\"\"\n    def max_aggregate(self, entries: List[Tuple[str, Union[int, float]]]) -> Tuple[str, Union[int, float]]:\n        \"\"\"Orchestrates aggregation and selection to find the maximum aggregated total.\"\"\"\n        tuple_entries = [TupleEntry(name, value) for name, value in entries]\n        aggregated_data = self.aggregateByName(tuple_entries)\n        max_result = self.findMax(aggregated_data)\n        return max_result\n\n    def aggregateByName(self, entries: List[TupleEntry]) -> Dict[str, Union[int, float]]:\n        \"\"\"Aggregates values by name from a list of TupleEntry objects.\"\"\"\n        aggregates: Dict[str, Union[int, float]] = {}\n        for entry in entries:\n            aggregates[entry.name] = aggregates.get(entry.name, 0) + entry.value\n        return aggregates\n\n    def findMax(self, aggregates: Dict[str, Union[int, float]]) -> Tuple[str, Union[int, float]]:\n        \"\"\"Finds the name and total with the maximum aggregated total.\"\"\"\n        if not aggregates:\n            return (\"\", 0)\n\n        max_name: str = \"\"\n        max_total: Union[int, float] = float('-inf')\n\n        for name, total in aggregates.items():\n            if total > max_total:\n                max_total = total\n                max_name = name\n        return (max_name, max_total)\n\ndef max_aggregate(entries: List[Tuple[str, Union[int, float]]]) -> Tuple[str, Union[int, float]]:\n    \"\"\"Calculates the maximum aggregate from a list of tuples.\"\"\"\n    return MaxAggregateFunction().max_aggregate(entries)"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(input_list) -> list:\n    \"\"\"Public API. Validates input; returns flattened list.\"\"\"\n\n    # Helper for Validator\n    def _raise_type_error(msg):\n        raise TypeError(msg)\n\n    class Validator:\n        def is_list(self, obj) -> bool:\n            return isinstance(obj, list)\n        def validate(self, obj) -> None:\n            if not self.is_list(obj):\n                _raise_type_error(\"input must be a list\")\n\n    class Element:\n        def __init__(self, value):\n            self.value = value\n            self.type = type(value).__name__\n\n    class ResultList:\n        def __init__(self):\n            self._elements = []\n        def append(self, element: 'Element') -> None:\n            self._elements.append(element)\n        def to_list(self) -> list:\n            return [e.value for e in self._elements]\n\n    class RecursiveProcessor:\n        def process(self, node, result_list: 'ResultList') -> None:\n            if isinstance(node, list):\n                for item in node:\n                    self.process(item, result_list)\n            else:\n                result_list.append(Element(node))\n\n    validator = Validator()\n    validator.validate(input_list)\n    result = ResultList()\n    processor = RecursiveProcessor()\n    processor.process(input_list, result)\n    return result.to_list()"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(input_dict):\n    \"\"\"\n    Computes the nesting depth of dictionaries.\n    Outermost dictionary counts as depth 1.\n    \"\"\"\n    if not isinstance(input_dict, dict):\n        raise TypeError(\"Input must be a dictionary.\")\n\n    max_child_depth = 0\n    for value in input_dict.values():\n        if isinstance(value, dict):\n            max_child_depth = max(max_child_depth, dict_depth(value))\n\n    return 1 + max_child_depth"}
{"task_id": "Mbpp/300", "solution": "import math\n\ndef _validate_n(n):\n    \"\"\"\n    Validates the input 'n' to ensure it's a non-negative integer.\n    Raises ValueError for invalid inputs.\n    \"\"\"\n    if isinstance(n, bool) or not isinstance(n, int):\n        raise ValueError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be non-negative.\")\n\ndef _compute_using_identity(n):\n    \"\"\"\n    Computes C(2n, n) using math.comb, which represents the required count.\n    \"\"\"\n    return math.comb(2 * n, n)\n\ndef count_binary_seq(n: int) -> float:\n    \"\"\"\n    Calculates the count of binary sequences of length 2n where the sum of the\n    first n bits equals the sum of the last n bits.\n    \"\"\"\n    _validate_n(n)\n    count_int = _compute_using_identity(n)\n    return float(count_int)"}
{"task_id": "Mbpp/305", "solution": "from typing import List, Tuple\nfrom dataclasses import dataclass\n\n@dataclass\nclass Word:\n    text: str\n\n    def starts_with_p(self) -> bool:\n        \"\"\"Checks if the word starts with 'p' or 'P'.\"\"\"\n        return self.text and self.text[0].lower() == 'p'\n\n@dataclass\nclass ResultTuple:\n    first: str\n    second: str\n\ndef start_withp(list_of_strings: List[str]) -> Tuple[str, str]:\n    \"\"\"\n    Returns two words from a list of strings that start with 'p' (case-insensitive).\n    Raises ValueError if fewer than two matching words are found.\n    \"\"\"\n    p_words: List[Word] = []\n    for s in list_of_strings:\n        tokens = s.split()\n        for token in tokens:\n            word = Word(text=token)\n            if word.starts_with_p():\n                p_words.append(word)\n                if len(p_words) == 2:\n                    return (p_words[0].text, p_words[1].text)\n\n    raise ValueError(\"Fewer than two tokens starting with 'p' found\")"}
{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(arr, n, i, k):\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence ending at arr[k],\n    composed of elements from arr[0..i] and arr[k].\n    \"\"\"\n    if not (n == len(arr) and 0 <= i < n and 0 <= k < n and k > i):\n        raise ValueError(\"Invalid input parameters: n must equal len(arr), 0 <= i < n, 0 <= k < n, and k > i.\")\n\n    # dp[j] stores the maximum sum of an increasing subsequence ending at arr[j]\n    # considering only elements from arr[0...j].\n    dp = [0] * (i + 1)\n\n    for j in range(i + 1):\n        dp[j] = arr[j]  # Initialize with the element itself\n        for l in range(j):\n            if arr[l] < arr[j]:\n                dp[j] = max(dp[j], dp[l] + arr[j])\n\n    max_prefix_sum = 0\n    found_candidate = False\n    for j in range(i + 1):\n        if arr[j] < arr[k]:\n            max_prefix_sum = max(max_prefix_sum, dp[j])\n            found_candidate = True\n\n    if not found_candidate:\n        return arr[k]\n    else:\n        return max_prefix_sum + arr[k]"}
{"task_id": "Mbpp/309", "solution": "```python\nfrom typing import Union\n\ndef maximum(arg1: Union[int, float], arg2: Union[int, float]) -> Union[int, float]:\n    \"\"\"Return the greater of arg1 and arg2. Behavior for non-numeric inputs is unspecified by SRS.\"\"\"\n    if arg1 >= arg2:\n        return arg1\n    return arg2\n```"}
{"task_id": "Mbpp/308", "solution": "from dataclasses import dataclass\nfrom typing import Iterator, List, Union\n\n@dataclass\nclass ProductPair:\n    \"\"\"Represents a pair of factors and can compute their product.\"\"\"\n    left_value: Union[int, float]\n    right_value: Union[int, float]\n\n    def product(self) -> Union[int, float]:\n        \"\"\"Computes the product of the left and right values.\"\"\"\n        return self.left_value * self.right_value\n\nclass LargeProductService:\n    \"\"\"Service class to orchestrate finding largest products.\"\"\"\n\n    def large_product(self, list1: List[Union[int, float]], list2: List[Union[int, float]], k: int) -> List[Union[int, float]]:\n        \"\"\"\n        Computes and returns up to k largest product values from two lists.\n        The products are sorted in descending order, preserving duplicates.\n        \"\"\"\n        all_products: List[Union[int, float]] = []\n        for pair in self.generate_pairs(list1, list2):\n            all_products.append(pair.product())\n\n        sorted_products = self.sort_descending(all_products)\n        return self.select_top_k(sorted_products, k)\n\n    def generate_pairs(self, list1: List[Union[int, float]], list2: List[Union[int, float]]) -> Iterator[ProductPair]:\n        \"\"\"Yields ProductPair for each combination of elements from list1 and list2.\"\"\"\n        for x in list1:\n            for y in list2:\n                yield ProductPair(x, y)\n\n    def sort_descending(self, products: List[Union[int, float]]) -> List[Union[int, float]]:\n        \"\"\"Returns the list of products sorted in descending order.\"\"\"\n        return sorted(products, reverse=True)\n\n    def select_top_k(self, sorted_products: List[Union[int, float]], k: int) -> List[Union[int, float]]:\n        \"\"\"Returns the first min(k, len(sorted_products)) elements.\"\"\"\n        return sorted_products[:k]\n\ndef large_product(list1: List[Union[int, float]], list2: List[Union[int, float]], k: int) -> List[Union[int, float]]:\n    \"\"\"\n    Finds the specified number of largest products from two given lists,\n    selecting one factor from each list.\n    \"\"\"\n    service = LargeProductService()\n    return service.large_product(list1, list2, k)"}
{"task_id": "Mbpp/312", "solution": "import math\n\nclass Cone:\n    \"\"\"Holds input parameters radius and height.\"\"\"\n    def __init__(self, radius: float, height: float) -> None:\n        self.radius = radius\n        self.height = height\n\nclass MathConstants:\n    \"\"\"Provides the PI constant.\"\"\"\n    PI: float = math.pi\n\nclass VolumeCalculator:\n    \"\"\"Encapsulates cone volume calculation.\"\"\"\n    def volume_cone(self, radius: float, height: float) -> float:\n        \"\"\"Compute (PI * radius**2 * height) / 3 and return Python float.\"\"\"\n        return (MathConstants.PI * (radius ** 2) * height) / 3.0\n\ndef volume_cone(radius: float, height: float) -> float:\n    \"\"\"Public API for calculating the volume of a cone.\"\"\"\n    return VolumeCalculator().volume_cone(radius, height)"}
{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(value: int) -> int:\n    \"\"\"\n    Sets the left-most unset bit in the given integer value.\n    Precondition: value must be an int; recommended non-negative.\n    \"\"\"\n    if not isinstance(value, int):\n        raise TypeError(\"Input 'value' must be an integer.\")\n    if value < 0:\n        raise ValueError(\"Input 'value' must be a non-negative integer.\")\n\n    class IntegerValue:\n        def __init__(self, value: int):\n            self.value = value\n\n        def bit_width(self) -> int:\n            # Returns the minimal number of bits required to represent the value.\n            if self.value == 0:\n                return 1\n            return self.value.bit_length()\n\n        def bit_representation(self) -> str:\n            # Returns the minimal-width binary string representation.\n            if self.value == 0:\n                return '0'\n            return bin(self.value)[2:]\n\n    class BitRepresentation:\n        def __init__(self, bits: str):\n            self.bits = bits\n            self.width = len(bits)\n\n        def most_significant_set_bit(self) -> int:\n            # Returns the 0-based index (LSB=0) of the most significant set bit.\n            if not self.bits or self.bits == '0':\n                return -1\n            return int(self.bits, 2).bit_length() - 1\n\n        def left_most_unset_bit(self) -> int:\n            # Searches for the left-most (most significant) zero bit and returns its LSB-based index.\n            # If no zero is found within the current width, returns the width to indicate extension.\n            for i in range(self.width):\n                if self.bits[i] == '0':\n                    return (self.width - 1) - i\n            return self.width\n\n    class ResultValue:\n        def __init__(self, value: int):\n            self.value = value\n\n    class SetLeftMostUnsetBit:\n        def set_left_most_unset_bit(self, value: int) -> int:\n            integer_value = IntegerValue(value)\n            bit_rep_str = integer_value.bit_representation()\n            bit_representation = BitRepresentation(bit_rep_str)\n\n            unset_bit_index = bit_representation.left_most_unset_bit()\n\n            # The result is computed by setting the bit at the determined index.\n            return value | (1 << unset_bit_index)\n\n    orchestrator = SetLeftMostUnsetBit()\n    return orchestrator.set_left_most_unset_bit(value)"}
{"task_id": "Mbpp/310", "solution": "def string_to_tuple(s: str) -> tuple:\n    \"\"\"\n    Converts a string to a tuple of its characters, removing spaces.\n    Raises TypeError if the input is not a string.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"string_to_tuple expects a str argument\")\n\n    # Filter out ASCII space characters (U+0020) and build a list of characters.\n    filtered_chars = [char for char in s if char != ' ']\n\n    # Convert the list of characters to a tuple.\n    return tuple(filtered_chars)"}
{"task_id": "Mbpp/388", "solution": "def _validate_integer(n):\n    \"\"\"Validates if n is an integer and is positive.\n    Raises TypeError if not an int, ValueError if less than 1.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 1:\n        raise ValueError(\"Input 'n' must be greater than or equal to 1.\")\n\ndef _compute_highest_power_of_2(n):\n    \"\"\"Computes the highest power of 2 less than or equal to n, assuming n is a validated integer >= 1.\"\"\"\n    power = 1\n    while power * 2 <= n:\n        power *= 2\n    return power\n\ndef highest_Power_of_2(n):\n    \"\"\"\n    Finds the highest power of 2 that is less than or equal to n.\n    For example, highest_Power_of_2(10) == 8.\n    \"\"\"\n    _validate_integer(n)\n    return _compute_highest_power_of_2(n)"}
{"task_id": "Mbpp/390", "solution": "def add_string(items_list, format_string):\n    \"\"\"Return a new list of strings created by substituting each element's string representation into format_string at '{0}'.\n\n    Args:\n        items_list: sequence of elements (any type with string representation)\n        format_string: string containing a single '{0}' placeholder\n\n    Returns:\n        list of strings (same length and order as items_list)\n\n    Raises:\n        ValueError: if format_string does not contain '{0}'\n    \"\"\"\n    def _validate_format_string(format_string):\n        \"\"\"Internal helper that raises ValueError if '{0}' is not present.\"\"\"\n        if '{0}' not in format_string:\n            raise ValueError(\"format_string must contain '{0}'\")\n\n    _validate_format_string(format_string)\n\n    output_list = []\n    for element in items_list:\n        element_str = str(element)\n        formatted = format_string.replace('{0}', element_str)\n        output_list.append(formatted)\n\n    return output_list"}
{"task_id": "Mbpp/389", "solution": "L0: int = 2\nL1: int = 1\n\ndef validate(n: int) -> bool:\n    \"\"\"Returns True if n is an integer and n >= 0, otherwise False.\"\"\"\n    return isinstance(n, int) and n >= 0\n\ndef find_lucas(n: int) -> int:\n    \"\"\"Calculates the n'th Lucas number using an iterative approach.\"\"\"\n    if not validate(n):\n        raise ValueError(\"n must be a non-negative integer\")\n\n    if n == 0:\n        return L0\n    if n == 1:\n        return L1\n\n    a = L0\n    b = L1\n    for _ in range(2, n + 1):\n        next_lucas = a + b\n        a = b\n        b = next_lucas\n    return b"}
{"task_id": "Mbpp/391", "solution": "def convert_list_dictionary(list1, list2, list3):\n    \"\"\"\n    Converts three parallel lists into an ordered list of nested dictionaries.\n    Example: convert_list_dictionary([\"S001\"], [\"Adina\"], [85]) == [{'S001': {'Adina': 85}}]\n    \"\"\"\n\n    class _Converter:\n        \"\"\"Internal helper for validating and building the nested dictionary list.\"\"\"\n\n        def _validate_lengths(self, list1, list2, list3):\n            \"\"\"Raises ValueError if input lists have unequal lengths.\"\"\"\n            len1, len2, len3 = len(list1), len(list2), len(list3)\n            if not (len1 == len2 == len3):\n                raise ValueError(\"Input lists must have equal lengths.\")\n\n        def _build_result(self, list1, list2, list3):\n            \"\"\"Builds the list of nested dictionaries in a single pass.\"\"\"\n            result = []\n            n = len(list1)\n            for i in range(n):\n                inner_dict = {list2[i]: list3[i]}\n                outer_dict = {list1[i]: inner_dict}\n                result.append(outer_dict)\n            return result\n\n    converter = _Converter()\n    converter._validate_lengths(list1, list2, list3)\n    return converter._build_result(list1, list2, list3)"}
{"task_id": "Mbpp/395", "solution": "from typing import Optional, Dict\n\nclass FrequencyMap:\n    \"\"\"Helper class to count character occurrences.\"\"\"\n    def __init__(self) -> None:\n        self.counts: Dict[str, int] = {}\n\n    def increment(self, c: str) -> None:\n        \"\"\"Increments the count for a given character.\"\"\"\n        self.counts[c] = self.counts.get(c, 0) + 1\n\n    def get_count(self, c: str) -> int:\n        \"\"\"Returns the occurrence count for a character.\"\"\"\n        return self.counts.get(c, 0)\n\ndef first_non_repeating_character(input_string: str) -> Optional[str]:\n    \"\"\"\n    Finds the first non-repeated character in the given string.\n    Returns the character as a single-character string or None if no such character exists.\n    \"\"\"\n    frequency_map = FrequencyMap()\n\n    for char in input_string:\n        frequency_map.increment(char)\n\n    for char in input_string:\n        if frequency_map.get_count(char) == 1:\n            return char\n\n    return None"}
{"task_id": "Mbpp/392", "solution": "def get_max_sum(n: int) -> int:\n    \"\"\"\n    Computes the maximum sum for n using the recurrence f(n) = max( (f(n/2) + f(n/3) + f(n/4) + f(n/5)), n).\n    Uses a function attribute for memoization to store computed results.\n    \"\"\"\n    # Initialize memoization cache as a function attribute on the first call.\n    if not hasattr(get_max_sum, \"_memo_cache\"):\n        get_max_sum._memo_cache = {}\n\n    memo = get_max_sum._memo_cache\n\n    if n in memo:\n        return memo[n]\n\n    # Base case: For n=0, the sum of parts (f(0) for each) would lead to infinite recursion.\n    # f(0) = max(f(0)*4, 0) implies f(0) = 0.\n    if n == 0:\n        memo[0] = 0\n        return 0\n    \n    # Compute parts using integer division and recursively call get_max_sum for each part.\n    sum_of_parts = get_max_sum(n // 2) + \\\n                   get_max_sum(n // 3) + \\\n                   get_max_sum(n // 4) + \\\n                   get_max_sum(n // 5)\n    \n    result = max(sum_of_parts, n)\n    memo[n] = result\n    return result"}
{"task_id": "Mbpp/394", "solution": "def check_distinct(tuple_input: tuple) -> bool:\n    \"\"\"Return True iff all elements in the provided tuple are distinct using equality comparisons.\n\n    Do not mutate the input tuple; compare elements using equality (==).\n    \"\"\"\n    n = len(tuple_input)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if tuple_input[i] == tuple_input[j]:\n                return False\n    return True"}
{"task_id": "Mbpp/397", "solution": "from dataclasses import dataclass\nfrom numbers import Number\n\nclass ValidationError(Exception):\n    \"\"\"Custom exception for invalid input conditions encountered during validation.\"\"\"\n    pass\n\n@dataclass\nclass NumericInput:\n    \"\"\"Represents a numeric input, providing validation capabilities.\"\"\"\n    value: Number\n    type: str\n\n    def is_numeric(self) -> bool:\n        \"\"\"Checks if the stored value is an integer or a float.\"\"\"\n        return isinstance(self.value, (int, float))\n\n@dataclass\nclass Result:\n    \"\"\"Represents the final median value, ensuring it is a float.\"\"\"\n    value: float\n\ndef median_numbers(a: Number, b: Number, c: Number) -> float:\n    \"\"\"\n    Computes the median of three numeric values, ensuring validation and float return type.\n    Raises ValidationError if any input is non-numeric.\n    \"\"\"\n    inputs = [\n        NumericInput(a, str(type(a))),\n        NumericInput(b, str(type(b))),\n        NumericInput(c, str(type(c))),\n    ]\n\n    for input_obj in inputs:\n        if not input_obj.is_numeric():\n            raise ValidationError(f\"Non-numeric input: {input_obj.value}\")\n\n    numeric_values = [input_obj.value for input_obj in inputs]\n    sorted_values = sorted(numeric_values)\n    \n    median_value = sorted_values[1]\n    result_obj = Result(value=float(median_value))\n    return result_obj.value"}
{"task_id": "Mbpp/398", "solution": "def sum_of_digits(numbers):\n    \"\"\"\n    Computes the sum of digits of each number in a given list.\n    Digits are summed from the absolute value of each number.\n    \"\"\"\n    total_sum = 0\n    for number in numbers:\n        # Take the absolute value of the number\n        abs_num = abs(number)\n        # Convert the number to a string to iterate through its digits\n        for digit_char in str(abs_num):\n            total_sum += int(digit_char)\n    return total_sum"}
{"task_id": "Mbpp/405", "solution": "def check_tuplex(tuple_input, element):\n    \"\"\"Return True if element exists in tuple_input, else False. Do not modify tuple_input.\"\"\"\n    return element in tuple_input"}
{"task_id": "Mbpp/404", "solution": "from typing import Any\n\ndef minimum(a: Any, b: Any):\n    \"\"\"Return the numerically smaller of a and b after validation.\n    Returns a if a == b for deterministic tie-breaking.\n    \"\"\"\n    def validate_args(a: Any, b: Any) -> None:\n        \"\"\"Raise TypeError if a or b is not numeric (int or float).\"\"\"\n        if not isinstance(a, (int, float)) or not isinstance(b, (int, float)):\n            raise TypeError(\"Both arguments must be numeric (int or float).\")\n\n    validate_args(a, b)\n\n    if a <= b:\n        return a\n    else:\n        return b"}
