{"task_id": "Mbpp/479", "solution": "def first_Digit(n: int) -> int:\n    \"\"\"Return the most significant (first) digit of integer n as an int.\n    Operate on absolute value; handle n == 0 -> return 0.\n    \"\"\"\n    if n == 0:\n        return 0\n    n = abs(n)\n    while n >= 10:\n        n //= 10\n    return n"}
{"task_id": "Mbpp/478", "solution": "def remove_lowercase(input: str) -> str:\n    \"\"\"Removes contiguous substrings of ASCII lowercase letters from the input string.\n    Raises TypeError if the input is not a string.\"\"\"\n    if not isinstance(input, str):\n        raise TypeError(\"Input must be a string.\")\n\n    output_chars = []\n    i = 0\n    while i < len(input):\n        char = input[i]\n        # Check if the current character is an ASCII lowercase letter\n        if 'a' <= char <= 'z':\n            # If it is, skip all contiguous lowercase letters\n            j = i\n            while j < len(input) and 'a' <= input[j] <= 'z':\n                j += 1\n            i = j  # Advance index 'i' past the entire lowercase run\n        else:\n            # If not a lowercase letter, append it to the result and move to the next character\n            output_chars.append(char)\n            i += 1\n    \n    return \"\".join(output_chars)"}
{"task_id": "Mbpp/555", "solution": "def validate(n) -> None:\n    \"\"\"Raise ValueError if n is not an integer >= 1.\"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"Input 'n' must be a positive integer (n >= 1).\")\n\ndef compute_sum_cubes(n: int) -> int:\n    \"\"\"Return sum_{i=1..n} i**3 using the closed-form formula.\"\"\"\n    # The sum of cubes of the first n natural numbers is (n * (n + 1) / 2)^2.\n    sum_of_first_n_numbers = n * (n + 1) // 2\n    return sum_of_first_n_numbers * sum_of_first_n_numbers\n\ndef compute_sum(n: int) -> int:\n    \"\"\"Return sum_{i=1..n} i using the closed-form formula.\"\"\"\n    # The sum of the first n natural numbers is n * (n + 1) / 2.\n    return n * (n + 1) // 2\n\ndef difference(n: int) -> int:\n    \"\"\"Validate n; compute SumCubes and SumNumbers; return SumCubes - SumNumbers.\n    Raises: ValueError if n is not a positive integer (n < 1 or not int).\n    \"\"\"\n    validate(n)\n    sum_cubes = compute_sum_cubes(n)\n    sum_numbers = compute_sum(n)\n    return sum_cubes - sum_numbers"}
{"task_id": "Mbpp/554", "solution": "def Split(input_list: list) -> list:\n    \"\"\"Return a new list containing only the odd integers from input_list, preserving order.\n\n    The SRS assumes elements are integers; behavior for non-integers is unspecified.\n    \"\"\"\n    odd_numbers = []\n    for number in input_list:\n        if number % 2 != 0:\n            odd_numbers.append(number)\n    return odd_numbers"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(a: int, b: int) -> int:\n    \"\"\"Compute the sum of absolute per-digit differences between integers a and b.\"\"\"\n\n    def _integer_number_digits(n: int) -> list:\n        \"\"\"Converts an integer to a list of its digits, with units at index 0.\"\"\"\n        if n == 0:\n            return [0]\n        digits = []\n        current_n = n\n        while current_n > 0:\n            digits.append(current_n % 10)\n            current_n //= 10\n        return digits\n\n    def _pair_digits(da: list, db: list) -> list:\n        \"\"\"Pairs digits from two lists by positional index, padding with zeros for shorter lists.\"\"\"\n        max_len = max(len(da), len(db))\n        paired_digits = []\n        for i in range(max_len):\n            d_a = da[i] if i < len(da) else 0\n            d_b = db[i] if i < len(db) else 0\n            paired_digits.append((d_a, d_b))\n        return paired_digits\n\n    # Take absolute values of inputs as per design decision for unspecified negative integer behavior.\n    abs_a = abs(a)\n    abs_b = abs(b)\n\n    digits_a = _integer_number_digits(abs_a)\n    digits_b = _integer_number_digits(abs_b)\n\n    paired_digits = _pair_digits(digits_a, digits_b)\n\n    total_diff = 0\n    for d_a, d_b in paired_digits:\n        total_diff += abs(d_a - d_b)\n\n    return total_diff"}
{"task_id": "Mbpp/557", "solution": "class Character:\n    \"\"\"Encapsulates character-level classification and toggle behavior.\"\"\"\n    def __init__(self, char: str) -> None:\n        self.char = char\n\n    def isUpper(self) -> bool:\n        return self.char.isupper()\n\n    def isLower(self) -> bool:\n        return self.char.islower()\n\n    def isCased(self) -> bool:\n        # A character is considered 'cased' if it is an alphabet letter.\n        return self.char.isalpha()\n\n    def toggle(self) -> str:\n        if self.isUpper():\n            return self.char.lower()\n        elif self.isLower():\n            return self.char.upper()\n        return self.char # Non-cased characters remain unchanged.\n\nclass InputString:\n    \"\"\"Represents and provides accessors for the input string.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        return len(self.value)\n\n    def __iter__(self):\n        return iter(self.value)\n\nclass OutputString:\n    \"\"\"Represents the resulting string produced by toggle operation.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        return len(self.value)\n\nclass ToggleStringService:\n    \"\"\"Provides the core operation to toggle character cases in a string.\"\"\"\n    def toggle_string(self, input_value: str) -> str:\n        if not input_value:\n            return \"\"\n\n        input_string_obj = InputString(input_value)\n        toggled_chars_list = []\n        for char_value in input_string_obj:\n            character_obj = Character(char_value)\n            toggled_chars_list.append(character_obj.toggle())\n\n        result_str = \"\".join(toggled_chars_list)\n        output_string_obj = OutputString(result_str)\n        return output_string_obj.value\n\ndef toggle_string(input: str) -> str:\n    \"\"\"Public API function. Delegates to ToggleStringService().toggle_string(input).\"\"\"\n    return ToggleStringService().toggle_string(input)"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(arr, n):\n    \"\"\"\n    Counts pairs (i, j) with 0 <= i < j < n_eff where arr[i] XOR arr[j] is odd.\n    n is internally clamped to the valid range for arr.\n    \"\"\"\n    def _validate_n(arr_local, n_local):\n        \"\"\"Clamps n to the range [0, len(arr)] for safe slicing.\"\"\"\n        n_int = int(n_local)\n        return min(max(0, n_int), len(arr_local))\n\n    def _count_parity(slice_arr_local):\n        \"\"\"Counts even and odd numbers in the given array slice.\"\"\"\n        count_even = 0\n        count_odd = 0\n        for x in slice_arr_local:\n            if x % 2 == 0:\n                count_even += 1\n            else:\n                count_odd += 1\n        return count_even, count_odd\n\n    n_eff = _validate_n(arr, n)\n    \n    slice_arr = arr[:n_eff]\n    \n    count_even, count_odd = _count_parity(slice_arr)\n    \n    return count_even * count_odd"}
{"task_id": "Mbpp/560", "solution": "from typing import Any, Tuple\n\nclass TupleInput:\n    \"\"\"A simple wrapper for an input tuple.\"\"\"\n    def __init__(self, elements: Tuple[Any, ...]) -> None:\n        self.elements = elements\n\nclass ResultTuple:\n    \"\"\"A wrapper for the resulting tuple.\"\"\"\n    def __init__(self, elements: Tuple[Any, ...]) -> None:\n        self.elements = elements\n\nclass UnionFunction:\n    \"\"\"Stateless class encapsulating validation and union computation.\"\"\"\n    @staticmethod\n    def validate_inputs(t1: Any, t2: Any) -> None:\n        \"\"\"Validates that both inputs are tuples.\"\"\"\n        if not isinstance(t1, tuple) or not isinstance(t2, tuple):\n            raise TypeError(\"Inputs must be tuples.\")\n\n    @staticmethod\n    def union_elements(t1: 'TupleInput', t2: 'TupleInput') -> 'ResultTuple':\n        \"\"\"Combines, deduplicates, and sorts elements from two TupleInput objects.\"\"\"\n        combined = list(t1.elements) + list(t2.elements)\n        unique = set(combined)\n        try:\n            sorted_unique = tuple(sorted(unique))\n        except TypeError:\n            raise TypeError(\"Elements not comparable for ordering.\")\n        return ResultTuple(sorted_unique)\n\ndef union_elements(t1: tuple, t2: tuple) -> tuple:\n    \"\"\"\n    Finds the union of elements from two tuples, returning them in sorted order.\n    It validates inputs, combines, deduplicates, and sorts the elements.\n    \"\"\"\n    UnionFunction.validate_inputs(t1, t2)\n    a = TupleInput(t1)\n    b = TupleInput(t2)\n    result = UnionFunction.union_elements(a, b)\n    return result.elements"}
{"task_id": "Mbpp/559", "solution": "from typing import List\n\nclass InputList:\n    \"\"\"Holds the input list elements and its expected length.\"\"\"\n    def __init__(self, elements: List[int], length: int) -> None:\n        self.elements = elements\n        self.length = length\n\nclass Sublist:\n    \"\"\"Conceptual holder for contiguous sublist metadata.\"\"\"\n    def __init__(self, startIndex: int, endIndex: int, sum: int) -> None:\n        self.startIndex = startIndex\n        self.endIndex = endIndex\n        self.sum = sum\n\nclass Result:\n    \"\"\"Holds the computed integer result.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass Function:\n    \"\"\"Coordinates validation and computation using Kadane's algorithm.\"\"\"\n    def max_sub_array_sum(self, input_list: InputList) -> int:\n        \"\"\"Validates input and computes the maximum sub-array sum.\"\"\"\n        self._validate_input(input_list)\n        result = self._compute_max_subarray(input_list)\n        return result.value\n\n    def _validate_input(self, input_list: InputList) -> None:\n        \"\"\"Validates that the provided length matches the actual list length.\"\"\"\n        if input_list.length != len(input_list.elements):\n            raise ValueError(\"Provided length does not match the actual list length.\")\n\n    def _compute_max_subarray(self, input_list: InputList) -> Result:\n        \"\"\"Computes the maximum sum of a contiguous sub-array using Kadane's algorithm.\"\"\"\n        elements = input_list.elements\n\n        current_max = elements[0]\n        global_max = elements[0]\n\n        for i in range(1, len(elements)):\n            current_max = max(elements[i], current_max + elements[i])\n            global_max = max(global_max, current_max)\n\n        return Result(global_max)\n\ndef max_sub_array_sum(list_of_integers: List[int], length_integer: int) -> int:\n    \"\"\"\n    Finds the sum of the largest contiguous sublist in the given list using Kadane's algorithm.\n    Validates the list length and returns the maximum sum.\n    \"\"\"\n    input_list = InputList(list_of_integers, length_integer)\n    func = Function()\n    return func.max_sub_array_sum(input_list)"}
{"task_id": "Mbpp/562", "solution": "```python\ndef Find_Max_Length(sublists) -> int:\n    \"\"\"\n    Compute and return the length of the longest sublist in 'sublists'.\n    Returns: int (0 if outer list is empty).\n    \"\"\"\n    if not sublists:\n        return 0\n\n    max_length = 0\n    for sublist in sublists:\n        current_length = len(sublist)\n        if current_length > max_length:\n            max_length = current_length\n            \n    return max_length\n```"}
{"task_id": "Mbpp/566", "solution": "from typing import List\n\nclass InputValidator:\n    \"\"\"\n    Responsibility: validate input is a non-negative integer.\n    \"\"\"\n    def validate(self, n: int) -> bool:\n        \"\"\"\n        Returns True if n is int and n >= 0; otherwise False.\n        \"\"\"\n        return isinstance(n, int) and n >= 0\n\nclass Digit:\n    \"\"\"\n    Responsibility: represent a single decimal digit (0..9).\n    \"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass InputNumber:\n    \"\"\"\n    Responsibility: wrap the input integer value.\n    \"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass DigitExtractor:\n    \"\"\"\n    Responsibility: extract decimal digits from an InputNumber into a list of Digit objects.\n    \"\"\"\n    def extract(self, n: int) -> List[Digit]:\n        \"\"\"\n        Extracts decimal digits from an integer into a list of Digit objects.\n        For n == 0 returns [Digit(0)].\n        \"\"\"\n        if n == 0:\n            return [Digit(0)]\n        \n        digits_list: List[Digit] = []\n        for char_digit in str(n):\n            digits_list.append(Digit(int(char_digit)))\n        return digits_list\n\nclass DigitAdder:\n    \"\"\"\n    Responsibility: sum a list of Digit objects and return an integer total.\n    \"\"\"\n    def sum(self, digits: List[Digit]) -> int:\n        \"\"\"\n        Sums the values of a list of Digit objects.\n        \"\"\"\n        total = 0\n        for digit in digits:\n            total += digit.value\n        return total\n\nclass SumResult:\n    \"\"\"\n    Responsibility: container for computed total.\n    \"\"\"\n    def __init__(self, total: int):\n        self.total = total\n\ndef sum_digits(n: int) -> int:\n    \"\"\"\n    Orchestrates validation, digit extraction, summation, and returns sum of decimal digits.\n    \"\"\"\n    validator = InputValidator()\n    if not validator.validate(n):\n        raise ValueError(\"Input must be a non-negative integer\")\n\n    extractor = DigitExtractor()\n    digits = extractor.extract(n)\n\n    adder = DigitAdder()\n    total = adder.sum(digits)\n\n    result_obj = SumResult(total)\n    return result_obj.total"}
{"task_id": "Mbpp/563", "solution": "from typing import List\nfrom dataclasses import dataclass\nimport re\n\n@dataclass\nclass QuotedValue:\n    value: str\n    position: int\n\n@dataclass\nclass ResultList:\n    items: List[str]\n    def count(self) -> int:\n        return len(self.items)\n\ndef _parse_quoted_values(input_string: str) -> List[QuotedValue]:\n    \"\"\"Uses regex to find double-quoted matches and returns QuotedValue objects.\n    Escaped quotes are treated literally per design.\"\"\"\n    # Pattern captures content between double quotes, without including the quotes themselves.\n    pattern = r'\"([^\"]*)\"'\n    matches = re.finditer(pattern, input_string)\n    \n    quoted_values = []\n    for i, match in enumerate(matches):\n        # group(1) contains the content captured by the first (and only) capturing group.\n        quoted_values.append(QuotedValue(value=match.group(1), position=i))\n    return quoted_values\n\ndef extract_values(input: str) -> List[str]:\n    \"\"\"Extracts values between double quotation marks from a string, trimming whitespace.\n    It preserves the order of the extracted values.\"\"\"\n    \n    parsed_values = _parse_quoted_values(input)\n    \n    extracted_items = []\n    for qv in parsed_values:\n        extracted_items.append(qv.value.strip())\n        \n    result_list = ResultList(items=extracted_items)\n    \n    return result_list.items"}
{"task_id": "Mbpp/565", "solution": "from dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass StringInput:\n    \"\"\"Value object wrapper for an input string with derived length accessor.\"\"\"\n    value: str\n\n    def length(self) -> int:\n        return len(self.value)\n\n@dataclass\nclass CharacterList:\n    \"\"\"Container for output one-character strings; provides length() accessor.\"\"\"\n    items: list\n\n    def length(self) -> int:\n        return len(self.items)\n\nclass SplitFunction:\n    \"\"\"Delegates string input validation and character splitting logic.\"\"\"\n\n    def validateInput(self, input: object) -> str:\n        \"\"\"Treat the argument as a string and return the coerced string.\"\"\"\n        return str(input)\n\n    def split(self, input: str) -> list:\n        \"\"\"Return a list of one-character strings for input, preserving order.\"\"\"\n        validated_string = self.validateInput(input)\n        \n        # Following the design's use of StringInput (even if not strictly necessary for simple list conversion)\n        StringInput(value=validated_string) \n        \n        characters = list(validated_string) # Splits the string into a list of characters\n        \n        # Following the design's use of CharacterList\n        character_list_obj = CharacterList(items=characters)\n        \n        return character_list_obj.items\n\n\ndef split(input) -> list:\n    \"\"\"Public API that delegates to SplitFunction.split and returns a Python list of 1-char strings.\"\"\"\n    splitter = SplitFunction()\n    return splitter.split(input)"}
{"task_id": "Mbpp/567", "solution": "def issort_list(lst):\n    \"\"\"\n    Checks if a list is sorted in non-decreasing order.\n    Returns True for empty or single-element lists.\n    \"\"\"\n    n = len(lst)\n    if n <= 1:\n        return True\n\n    for i in range(n - 1):\n        if lst[i] > lst[i+1]:\n            return False\n    return True"}
{"task_id": "Mbpp/564", "solution": "from typing import List\nimport collections\n\nclass Validator:\n    \"\"\"\n    Validates input types and preconditions for arr and n, returning effective_n.\n    \"\"\"\n    def validate(self, arr: List[int], n: int) -> int:\n        if not isinstance(arr, list):\n            raise ValueError(\"arr must be a list\")\n        if not isinstance(n, int) or n < 0:\n            raise ValueError(\"n must be a non-negative integer\")\n        return min(n, len(arr))\n\nclass PairCounter:\n    \"\"\"\n    Computes the number of unordered unequal pairs using frequency counts.\n    \"\"\"\n    def count_Pairs(self, arr: List[int], effective_n: int) -> int:\n        if effective_n <= 1:\n            return 0\n\n        arr_slice = arr[:effective_n]\n        \n        # Total possible pairs from effective_n elements\n        total_possible_pairs = effective_n * (effective_n - 1) // 2\n\n        equal_value_pairs = 0\n        frequencies = collections.Counter(arr_slice)\n        for count in frequencies.values():\n            if count > 1:\n                # Pairs with equal values: k * (k - 1) / 2 for k occurrences\n                equal_value_pairs += count * (count - 1) // 2\n        \n        return total_possible_pairs - equal_value_pairs\n\ndef count_Pairs(arr: List[int], n: int) -> int:\n    \"\"\"\n    Counts unordered pairs where both elements are unequal, validating inputs.\n    \"\"\"\n    validator = Validator()\n    effective_n = validator.validate(arr, n)\n\n    counter = PairCounter()\n    count = counter.count_Pairs(arr, effective_n)\n\n    return count"}
{"task_id": "Mbpp/568", "solution": "def empty_list(N):\n    \"\"\"Create a list of N empty dictionaries.\"\"\"\n    return [{} for _ in range(N)]"}
{"task_id": "Mbpp/572", "solution": "def two_unique_nums(items: list[int]) -> list[int]:\n    \"\"\"Return the integers that appear exactly once in items, preserving their original relative order.\n\n    Args:\n      items: list[int] -- input list of integers\n\n    Returns:\n      list[int] -- list of integers from items that occur exactly once, in original order\n    \"\"\"\n    counts = {}\n    for item in items:\n        counts[item] = counts.get(item, 0) + 1\n\n    result = []\n    for item in items:\n        if counts[item] == 1:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/569", "solution": "from typing import List\n\ndef sort_sublists(input_list: List[List[str]]) -> List[List[str]]:\n    \"\"\"\n    Accepts a list of lists of strings and returns a new list of lists where\n    each inner list is sorted in ascending lexicographical order.\n    Returns a new list; does not mutate input_list.\n    \"\"\"\n    return [sorted(sublist) for sublist in input_list]"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n):\n    \"\"\"\n    Compute and return the last decimal digit (0..9) of n! for non-negative integer n.\n\n    Parameters:\n    - n: int -- the non-negative integer whose factorial's last digit is requested.\n\n    Returns:\n    - int -- the last decimal digit (0..9) of n!.\n\n    Raises:\n    - TypeError: if n is not an int.\n    - ValueError: if n is a negative integer.\n    \"\"\"\n    def _validate_type(n_param) -> None:\n        \"\"\"Raises TypeError if n_param is not an integer.\"\"\"\n        if not isinstance(n_param, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n\n    def _validate_non_negative(n_param) -> None:\n        \"\"\"Raises ValueError if n_param is a negative integer.\"\"\"\n        if n_param < 0:\n            raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    def _compute_last_digit(n_param) -> int:\n        \"\"\"Computes the last decimal digit of n_param! efficiently.\"\"\"\n        if n_param == 0 or n_param == 1:\n            return 1\n        if n_param >= 5:\n            return 0  # Factorials of numbers >= 5 end in 0.\n        \n        # Calculate for n_param = 2, 3, 4\n        if n_param == 2:\n            return 2\n        if n_param == 3:\n            return 6\n        if n_param == 4:\n            return 4\n\n    _validate_type(n)\n    _validate_non_negative(n)\n    return _compute_last_digit(n)"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(source, target):\n    \"\"\"\n    Checks if 'target' is a contiguous sublist of 'source'.\n    Returns True if target is empty, False if target is longer than source, or if no match is found.\n    \"\"\"\n    len_source = len(source)\n    len_target = len(target)\n\n    if len_target == 0:\n        return True\n    if len_target > len_source:\n        return False\n\n    for i in range(len_source - len_target + 1):\n        match = True\n        for j in range(len_target):\n            if source[i + j] != target[j]:\n                match = False\n                break\n        if match:\n            return True\n\n    return False"}
{"task_id": "Mbpp/573", "solution": "def unique_product(numbers: list):\n    \"\"\"\n    Calculates the product of the unique numbers in a given list.\n    Non-numeric elements will cause a TypeError during calculation.\n    \"\"\"\n    unique_elements = set(numbers)\n\n    product = 1\n    for value in unique_elements:\n        product *= value\n    return product"}
{"task_id": "Mbpp/578", "solution": "class InputList:\n    def __init__(self, elements: list) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        return len(self.elements)\n\nclass ResultList:\n    def __init__(self, elements: list) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        return len(self.elements)\n\nclass Interleaver:\n    def interleave(self, input1: InputList, input2: InputList, input3: InputList) -> ResultList:\n        \"\"\"\n        Interleaves elements from three InputList objects into a new ResultList.\n        Raises ValueError if input lists have different lengths.\n        \"\"\"\n        len1 = input1.length()\n        len2 = input2.length()\n        len3 = input3.length()\n\n        if not (len1 == len2 == len3):\n            raise ValueError(\"Input lists must have equal length.\")\n\n        result_elements = []\n        for i in range(len1):\n            result_elements.append(input1.elements[i])\n            result_elements.append(input2.elements[i])\n            result_elements.append(input3.elements[i])\n\n        return ResultList(elements=result_elements)\n\ndef interleave_lists(list1, list2, list3):\n    \"\"\"\n    API function to interleave three lists of the same length into a single flat list.\n    Raises ValueError if lengths differ; returns a native list of length 3 * n; does not mutate inputs.\n    \"\"\"\n    input_list1 = InputList(list1)\n    input_list2 = InputList(list2)\n    input_list3 = InputList(list3)\n\n    interleaver = Interleaver()\n    result_obj = interleaver.interleave(input_list1, input_list2, input_list3)\n\n    return result_obj.elements"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple_a: tuple, tuple_b: tuple) -> tuple:\n    \"\"\"Return a tuple containing elements that appear in exactly one input tuple.\n\n    Elements unique to tuple_a appear first (preserving order), then elements unique to tuple_b (preserving order).\n    \"\"\"\n    result_list = []\n\n    for item_a in tuple_a:\n        if item_a not in tuple_b:\n            result_list.append(item_a)\n\n    for item_b in tuple_b:\n        if item_b not in tuple_a:\n            result_list.append(item_b)\n\n    return tuple(result_list)"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input: tuple) -> tuple:\n    \"\"\"\n    Validate input is a tuple. Return a new tuple with all odd integers removed from input and any nested tuples.\n    Behavior per SRS/BRs:\n      - Top-level input must be a tuple; raise TypeError if not.\n      - Evenness: integer % 2 == 0 keeps element (preserve 0 and negative even integers).\n      - Recursively process nested tuples to arbitrary depth.\n      - Preserve empty nested tuples (return () when all nested elements removed).\n      - Do not mutate the input; construct and return new tuple instances.\n    \"\"\"\n    if not isinstance(input, tuple):\n        raise TypeError(\"Top-level input must be a tuple.\")\n\n    def _reconstruct_tuple(elements: list) -> tuple:\n        \"\"\"\n        Convert list of elements (ints and nested tuples) into a tuple instance to ensure new tuple objects are returned.\n        \"\"\"\n        return tuple(elements)\n\n    def _process_element(elem: object) -> tuple | int | None:\n        \"\"\"\n        Internal helper: Processes an element, returning it if it's an even integer or a processed tuple, else None.\n        \"\"\"\n        if isinstance(elem, int):\n            if elem % 2 == 0:\n                return elem\n            else:\n                return None\n        elif isinstance(elem, tuple):\n            processed_nested_elements = []\n            for nested_elem in elem:\n                result = _process_element(nested_elem)\n                if result is not None:\n                    processed_nested_elements.append(result)\n            return _reconstruct_tuple(processed_nested_elements)\n        else:\n            # Elements that are neither int nor tuple are preserved as they are not 'uneven'.\n            return elem\n\n    kept_elements = []\n    for element in input:\n        processed_element = _process_element(element)\n        if processed_element is not None:\n            kept_elements.append(processed_element)\n\n    return _reconstruct_tuple(kept_elements)"}
{"task_id": "Mbpp/583", "solution": "class Validator:\n    \"\"\"\n    Validates input parameters for Catalan number computation.\n    \"\"\"\n    def is_non_negative_integer(self, n):\n        \"\"\"Checks if n is a non-negative integer.\"\"\"\n        return isinstance(n, int) and n >= 0\n\nclass CatalanFunction:\n    \"\"\"\n    Computes nth Catalan number using integer-exact algorithms.\n    \"\"\"\n    def catalan_number(self, n):\n        \"\"\"Public method to get the nth Catalan number, delegates to dynamic programming.\"\"\"\n        return self._compute_dp(n)\n\n    def _compute_dp(self, n):\n        \"\"\"\n        Computes the nth Catalan number using dynamic programming.\n        C[0]=1, C[i+1] = sum_{j=0..i} C[j]*C[i-j].\n        \"\"\"\n        if n == 0:\n            return 1\n\n        catalan = [0] * (n + 1)\n        catalan[0] = 1\n\n        for i in range(n):\n            current_sum = 0\n            for j in range(i + 1):\n                current_sum += catalan[j] * catalan[i - j]\n            catalan[i + 1] = current_sum\n        return catalan[n]\n\nclass Input:\n    \"\"\"\n    Data holder for the input parameter n.\n    \"\"\"\n    def __init__(self, n):\n        self.n = n\n\nclass Output:\n    \"\"\"\n    Data holder for the computation result.\n    \"\"\"\n    def __init__(self, value):\n        self.value = value\n\nclass TestCase:\n    \"\"\"\n    Represents a test case with input and expected value, capable of assertion.\n    \"\"\"\n    def __init__(self, id, input_n, expected_value):\n        self.id = id\n        self.input_n = input_n\n        self.expected_value = expected_value\n\n    def run_and_assert(self):\n        \"\"\"Executes the test case by calling catalan_number and asserts equality.\"\"\"\n        value = catalan_number(self.input_n)\n        assert value == self.expected_value\n        return True\n\ndef catalan_number(n):\n    \"\"\"\n    Returns the nth Catalan number, validating input and using dynamic programming.\n    \"\"\"\n    validator = Validator()\n    if not validator.is_non_negative_integer(n):\n        raise ValueError(\"n must be a non-negative integer\")\n\n    catalan_calculator = CatalanFunction()\n    result = catalan_calculator.catalan_number(n)\n\n    return result"}
{"task_id": "Mbpp/581", "solution": "def surface_Area(base_edge, height):\n    \"\"\"\n    Calculates the surface area of a square pyramid.\n    The 'height' parameter is interpreted as the slant height.\n    \"\"\"\n    slant_height = height\n    base_area = base_edge ** 2\n    lateral_area = 2 * base_edge * slant_height\n    total_surface_area = base_area + lateral_area\n    return float(total_surface_area)"}
{"task_id": "Mbpp/586", "solution": "def split_Arr(input_list, n):\n    \"\"\"\n    Splits a list at the nth element and moves the first part to the end.\n    Performs a left rotation of the list by n positions.\n    \"\"\"\n    def _validate_inputs(input_list, n):\n        \"\"\"Internal helper to validate input types, raising TypeError if invalid.\"\"\"\n        if not isinstance(input_list, list) or not isinstance(n, int):\n            raise TypeError(\"input_list must be list; n must be int\")\n\n    def _normalize_n(n, length):\n        \"\"\"Internal helper to normalize n using modulo for deterministic offset.\"\"\"\n        if length == 0:\n            return 0 # Handle empty list case before modulo\n        return n % length\n\n    _validate_inputs(input_list, n)\n\n    if not input_list:\n        return []\n\n    n_mod = _normalize_n(n, len(input_list))\n    result = input_list[n_mod:] + input_list[:n_mod]\n    return result"}
{"task_id": "Mbpp/585", "solution": "def expensive_items(dataset, n):\n    \"\"\"\n    Finds the n most expensive items in a dataset, ordered by price descending.\n    Preserves original order for items with equal prices.\n    \"\"\"\n    if n == 0 or not dataset:\n        return []\n\n    indexed_items = list(enumerate(dataset))\n\n    sorted_indexed_items = sorted(\n        indexed_items,\n        key=lambda x: (-x[1]['price'], x[0])\n    )\n\n    result_items = [item for original_index, item in sorted_indexed_items[:n]]\n\n    return result_items"}
{"task_id": "Mbpp/587", "solution": "def list_tuple(input_list: list) -> tuple:\n    \"\"\"Converts a list to a tuple, raising TypeError for non-list inputs.\"\"\"\n\n    def validate_input(input_value) -> bool:\n        \"\"\"Strictly validates if the input is a built-in list.\"\"\"\n        return type(input_value) is list\n\n    def convert(input_list: list) -> tuple:\n        \"\"\"Performs the conversion from list to tuple.\"\"\"\n        return tuple(input_list)\n\n    if not validate_input(input_list):\n        raise TypeError(\"list_tuple expects a list argument\")\n\n    return convert(input_list)"}
{"task_id": "Mbpp/588", "solution": "from typing import List\nfrom numbers import Number\n\ndef big_diff(numbers: List[Number]) -> Number:\n    \"\"\"Finds the difference between the largest and smallest value in a given list.\"\"\"\n    return max(numbers) - min(numbers)"}
{"task_id": "Mbpp/589", "solution": "import math\nfrom typing import List, Iterator\n\ndef perfect_squares(start: int, end: int) -> List[int]:\n    \"\"\"\n    Finds perfect squares between two given numbers (inclusive).\n    Returns an empty list if no perfect squares are found or if start > end.\n    \"\"\"\n\n    if start > end:\n        return []\n\n    # Helper function _integer_candidate_roots_inline:\n    # Generates integer roots k such that k*k may fall within [start, end].\n    def _integer_candidate_roots_inline(current_start: int, current_end: int) -> Iterator[int]:\n        lower_bound_sqrt = math.ceil(math.sqrt(max(0, current_start)))\n        upper_bound_sqrt = math.floor(math.sqrt(max(0, current_end)))\n        \n        # Ensure the range for roots is valid; if not, return an empty iterator.\n        if lower_bound_sqrt > upper_bound_sqrt:\n            return iter([])\n\n        return iter(range(int(lower_bound_sqrt), int(upper_bound_sqrt) + 1))\n\n    results = []\n    \n    # Iterate through candidate integer roots and collect their squares within the specified range.\n    for k in _integer_candidate_roots_inline(start, end):\n        square = k * k\n        if start <= square <= end:\n            results.append(square)\n            \n    return results"}
{"task_id": "Mbpp/591", "solution": "def _validate_input(input_list):\n    \"\"\"Raises TypeError if input_list is not an instance of list.\"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"swap_List expects a list\")\n\ndef _perform_swap(input_list):\n    \"\"\"Returns a new list with first and last elements swapped; preserves intermediate elements.\"\"\"\n    # Construct explicitly to ensure a new list without mutating the original.\n    return [input_list[-1]] + input_list[1:-1] + [input_list[0]]\n\ndef swap_List(input_list):\n    \"\"\"\n    swap_List(input_list) -> list\n\n    Args:\n        input_list: a Python list whose first and last elements will be interchanged in the returned list.\n\n    Returns:\n        list: a new list with first and last elements swapped when len(input_list) >= 2, otherwise returns a shallow copy of input_list.\n\n    Raises:\n        TypeError: if input_list is not a Python list.\n    \"\"\"\n    _validate_input(input_list)\n    \n    if len(input_list) < 2:\n        return input_list.copy() # Return a shallow copy for non-mutation.\n    else:\n        return _perform_swap(input_list)"}
{"task_id": "Mbpp/592", "solution": "def _binomial_coefficient(n_val: int, k_val: int) -> int:\n    \"\"\"\n    Calculates the binomial coefficient C(n_val, k_val).\n    Returns 0 if k_val is out of range, otherwise computes n_val! / (k_val! * (n_val - k_val)!).\n    \"\"\"\n    if k_val < 0 or k_val > n_val:\n        return 0\n    if k_val == 0 or k_val == n_val:\n        return 1\n    # Optimize by using C(n, k) = C(n, n-k)\n    if k_val > n_val // 2:\n        k_val = n_val - k_val\n    \n    res = 1\n    for i in range(k_val):\n        res = res * (n_val - i) // (i + 1)\n    return res\n\ndef sum_Of_product(n: int) -> int:\n    \"\"\"\n    Finds the sum of the product of consecutive binomial coefficients.\n    Calculates S = sum_{k=0}^{n-1} C(n,k) * C(n,k+1).\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n\n    total_sum = 0\n    # The sum iterates for k from 0 to n-1 inclusive.\n    for k in range(n):\n        coeff_k = _binomial_coefficient(n, k)\n        coeff_k_plus_1 = _binomial_coefficient(n, k + 1)\n        total_sum += coeff_k * coeff_k_plus_1\n        \n    return total_sum"}
