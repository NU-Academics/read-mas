{"task_id": "Mbpp/274", "solution": "def even_binomial_Coeff_Sum(n):\n    \"\"\"\n    Calculates the sum of binomial coefficients C(n, k) where k is an even index.\n    Validates n to be a positive integer and computes exact integer results.\n    \"\"\"\n    def _validate_positive_integer(val):\n        \"\"\"Ensures the input value is an integer strictly greater than 0.\"\"\"\n        if not isinstance(val, int):\n            raise ValueError(\"n must be an integer.\")\n        if val <= 0:\n            raise ValueError(\"n must be a positive integer > 0.\")\n\n    def _binomial_coefficient(num_n, num_k):\n        \"\"\"Computes the binomial coefficient C(n, k) using integer arithmetic.\"\"\"\n        if num_k < 0 or num_k > num_n:\n            return 0\n        if num_k == 0 or num_k == num_n:\n            return 1\n        if num_k > num_n // 2:\n            num_k = num_n - num_k\n        \n        res = 1\n        for i in range(num_k):\n            res = res * (num_n - i) // (i + 1)\n        return res\n\n    _validate_positive_integer(n)\n\n    total_sum = 0\n    for k in range(n + 1):\n        if k % 2 == 0:  # Check if k is an even index\n            coeff = _binomial_coefficient(n, k)\n            total_sum += coeff\n            \n    return total_sum"}
{"task_id": "Mbpp/277", "solution": "def dict_filter(input_dict: dict, n: int) -> dict:\n    \"\"\"\n    Filters a dictionary to include only entries with values greater than or equal to n.\n    Returns a new dictionary with the matching entries.\n    \"\"\"\n    result = {}\n    for k, v in input_dict.items():\n        if v >= n:\n            result[k] = v\n    return result"}
{"task_id": "Mbpp/273", "solution": "def substract_elements(t1, t2):\n    \"\"\"\n    Subtracts elements of the first tuple by elements of the second tuple at the same index.\n    \"\"\"\n\n    class LengthMismatchError(Exception):\n        \"\"\"Custom exception for tuple length mismatches.\"\"\"\n        def __init__(self, message: str) -> None:\n            super().__init__(message)\n\n    class NumericElement:\n        \"\"\"Domain wrapper for a single numeric element, validating its type.\"\"\"\n        def __init__(self, value) -> None:\n            if not isinstance(value, (int, float)):\n                raise TypeError(f\"Element must be numeric (int or float), but got {type(value).__name__}: {value}\")\n            self.value = value\n            self.type = type(value).__name__\n\n    class Tuple:\n        \"\"\"Domain wrapper for an input tuple, enforcing numeric elements and tuple type.\"\"\"\n        def __init__(self, elements: tuple) -> None:\n            if not isinstance(elements, tuple):\n                raise TypeError(f\"Input must be a tuple, but got {type(elements).__name__}\")\n            # NumericElement.__init__ validates each element's type, raising TypeError if non-numeric.\n            self._elements = [NumericElement(e) for e in elements]\n            self.length = len(self._elements)\n\n        def get_element(self, i: int) -> NumericElement:\n            \"\"\"Returns the NumericElement at the specified index.\"\"\"\n            return self._elements[i]\n\n        def to_native(self) -> tuple:\n            \"\"\"Converts the domain tuple back to a native Python tuple of values.\"\"\"\n            return tuple(ne.value for ne in self._elements)\n\n    class SubstractFunction:\n        \"\"\"Orchestrates validation and element-wise subtraction logic.\"\"\"\n        def substract_elements(self, t1_domain: Tuple, t2_domain: Tuple) -> Tuple:\n            \"\"\"Performs the main element-wise subtraction operation using domain objects.\"\"\"\n            self.validate_lengths(t1_domain, t2_domain)\n            # Element type validation is handled during Tuple and NumericElement instantiation.\n            return self.compute_elementwise(t1_domain, t2_domain)\n\n        def validate_lengths(self, t1_domain: Tuple, t2_domain: Tuple) -> None:\n            \"\"\"Validates that both domain tuples have identical lengths, raising LengthMismatchError if not.\"\"\"\n            if t1_domain.length != t2_domain.length:\n                raise LengthMismatchError(f\"Tuple lengths differ: {t1_domain.length} != {t2_domain.length}\")\n\n        def validate_numeric_elements(self, t_domain: Tuple) -> None:\n            \"\"\"Ensures all elements in the domain tuple are numeric.\"\"\"\n            # This method exists per design, but validation is already ensured by NumericElement.__init__.\n            pass\n\n        def compute_elementwise(self, t1_domain: Tuple, t2_domain: Tuple) -> Tuple:\n            \"\"\"Computes the element-wise subtraction and returns a new domain Tuple.\"\"\"\n            results_numeric_elements = []\n            for i in range(t1_domain.length):\n                val1 = t1_domain.get_element(i).value\n                val2 = t2_domain.get_element(i).value\n                results_numeric_elements.append(NumericElement(val1 - val2))\n            # Create a new domain Tuple from the computed numeric elements' values.\n            return Tuple(tuple(ne.value for ne in results_numeric_elements))\n\n    # Wrap native Python tuples into domain Tuple objects.\n    # This step implicitly performs input type and element type validation via Tuple.__init__\n    # and NumericElement.__init__, raising TypeError if validation fails.\n    domain_t1 = Tuple(t1)\n    domain_t2 = Tuple(t2)\n\n    # Instantiate the SubstractFunction orchestrator.\n    sub_func_orchestrator = SubstractFunction()\n\n    # Delegate the core subtraction operation to the orchestrator.\n    result_domain_tuple = sub_func_orchestrator.substract_elements(domain_t1, domain_t2)\n\n    # Convert the result domain Tuple back to a native Python tuple as the final output.\n    return result_domain_tuple.to_native()"}
