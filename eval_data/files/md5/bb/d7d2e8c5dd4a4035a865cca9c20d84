{"task_id": "Mbpp/227", "solution": "def min_of_three(a, b, c):\n    \"\"\"Validate inputs a, b, c are int or float; return the numeric minimum value. Raises TypeError if validation fails.\"\"\"\n    if not isinstance(a, (int, float)):\n        raise TypeError(\"Argument 'a' must be an int or float.\")\n    if not isinstance(b, (int, float)):\n        raise TypeError(\"Argument 'b' must be an int or float.\")\n    if not isinstance(c, (int, float)):\n        raise TypeError(\"Argument 'c' must be an int or float.\")\n\n    return min(a, b, c)"}
{"task_id": "Mbpp/223", "solution": "def is_majority(array, n, element):\n    \"\"\"\n    Checks if an element is the majority element in a sorted array\n    by finding its first and last occurrences using binary search.\n    \"\"\"\n\n    class InputValidator:\n        \"\"\"Handles validation of input parameters for the majority check.\"\"\"\n        @staticmethod\n        def _is_integer(value):\n            \"\"\"Checks if a value is an integer and not a boolean.\"\"\"\n            return isinstance(value, int) and not isinstance(value, bool)\n\n        @staticmethod\n        def validate(array_param, n_param, element_param):\n            \"\"\"Validates n for type and bounds against the array length.\"\"\"\n            if not InputValidator._is_integer(n_param):\n                raise ValueError(\"n must be an integer.\")\n            if n_param < 0:\n                raise ValueError(\"n cannot be negative.\")\n            if n_param > len(array_param):\n                raise ValueError(\"n cannot be greater than the length of the array.\")\n\n    class MajorityChecker:\n        \"\"\"Performs binary searches to find element occurrences and determine majority.\"\"\"\n        def _find_first(self, array_param, n_param, element_param):\n            \"\"\"Finds the index of the first occurrence of the element in array[0:n-1].\"\"\"\n            low = 0\n            high = n_param - 1\n            result = -1\n            while low <= high:\n                mid = low + (high - low) // 2\n                if array_param[mid] == element_param:\n                    result = mid\n                    high = mid - 1  # Search left for an earlier occurrence\n                elif array_param[mid] < element_param:\n                    low = mid + 1\n                else: # array_param[mid] > element_param\n                    high = mid - 1\n            return result\n\n        def _find_last(self, array_param, n_param, element_param):\n            \"\"\"Finds the index of the last occurrence of the element in array[0:n-1].\"\"\"\n            low = 0\n            high = n_param - 1\n            result = -1\n            while low <= high:\n                mid = low + (high - low) // 2\n                if array_param[mid] == element_param:\n                    result = mid\n                    low = mid + 1  # Search right for a later occurrence\n                elif array_param[mid] < element_param:\n                    low = mid + 1\n                else: # array_param[mid] > element_param\n                    high = mid - 1\n            return result\n\n        def is_majority(self, array_param, n_param, element_param):\n            \"\"\"Checks if the given element is a majority element within the first n_param elements.\"\"\"\n            first_occurrence = self._find_first(array_param, n_param, element_param)\n            \n            if first_occurrence == -1:\n                return False  # Element not found in the array\n\n            last_occurrence = self._find_last(array_param, n_param, element_param)\n\n            count = last_occurrence - first_occurrence + 1\n            return count > n_param // 2\n\n    # --- Main is_majority function logic orchestration ---\n    InputValidator.validate(array, n, element)\n\n    if n == 0:\n        return False\n\n    checker = MajorityChecker()\n    return checker.is_majority(array, n, element)"}
