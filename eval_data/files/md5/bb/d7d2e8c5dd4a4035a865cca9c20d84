{"task_id": "Mbpp/133", "solution": "class Number:\n    \"\"\"Lightweight wrapper for a numeric value with an is_negative check.\"\"\"\n    def __init__(self, value: float):\n        self._value = value\n\n    def is_negative(self) -> bool:\n        \"\"\"Checks if the wrapped numeric value is negative.\"\"\"\n        return self._value < 0\n\n    @property\n    def value(self) -> float:\n        \"\"\"Returns the wrapped numeric value.\"\"\"\n        return self._value\n\nclass NumberList:\n    \"\"\"Converts input list of numeric primitives into Number objects and provides negative filtering.\"\"\"\n    def __init__(self, numbers: list):\n        self._numbers = [Number(float(n)) for n in numbers]\n\n    def get_negatives(self) -> list:\n        \"\"\"Returns a list of Number objects that are negative.\"\"\"\n        return [n for n in self._numbers if n.is_negative()]\n\nclass Result:\n    \"\"\"Holds the aggregated numeric sum of negative numbers.\"\"\"\n    def __init__(self, sum_value: float):\n        self.sum = sum_value\n\ndef _to_number_list(numbers) -> NumberList:\n    \"\"\"Internal helper to create NumberList from an input list without modifying the input.\"\"\"\n    return NumberList(numbers)\n\ndef sum_negativenum(numbers):\n    \"\"\"Compute and return numeric sum of values < 0 from provided list.\n    Parameters:\n    - numbers: list of numeric values (int | float)\n    Returns:\n    - numeric sum (float or int). Returns 0 when list empty or no negative values.\"\"\"\n    if not numbers:\n        return 0\n\n    number_list = _to_number_list(numbers)\n    negatives = number_list.get_negatives()\n\n    total_sum = sum(n.value for n in negatives)\n    \n    # The design specifies returning a Result object, but the assert expects a float/int.\n    # Adhering to the assert, we return the numeric sum directly.\n    # The Result class is designed but its usage within sum_negativenum implies\n    # it's for internal structure or a conceptual 'result container'.\n    # If the intention was to return a Result object, the assert would fail.\n    # Since the assert dictates output type, we return the sum directly.\n    return total_sum"}
{"task_id": "Mbpp/139", "solution": "class MathConstants:\n    \"\"\"Provides mathematical constants.\"\"\"\n    PI: float = 3.141592653589793\n\nclass InputValidator:\n    \"\"\"Provides methods for validating input values.\"\"\"\n    @staticmethod\n    def is_numeric(value) -> bool:\n        \"\"\"Checks if a value is a valid numeric type (int or float) and not NaN or infinity.\"\"\"\n        return isinstance(value, (int, float)) and not (isinstance(value, float) and (value != value or value in (float('inf'), float('-inf'))))\n\nclass Circle:\n    \"\"\"Represents a circle with a given radius.\"\"\"\n    def __init__(self, radius: float):\n        \"\"\"Initializes a Circle with a radius.\"\"\"\n        self.radius = radius\n\n    def circumference(self) -> float:\n        \"\"\"Calculates the circumference of the circle.\"\"\"\n        return 2.0 * MathConstants.PI * self.radius\n\nclass CircleService:\n    \"\"\"Provides service methods related to circles, including circumference calculation.\"\"\"\n    def circle_circumference(self, radius) -> float:\n        \"\"\"Validates input and computes the circumference for a given radius.\"\"\"\n        if not InputValidator.is_numeric(radius):\n            raise TypeError(\"radius must be numeric\")\n        c = Circle(float(radius))\n        return 2.0 * MathConstants.PI * c.radius\n\ndef circle_circumference(radius):\n    \"\"\"Calculates the circumference of a circle given its radius.\"\"\"\n    service = CircleService()\n    return service.circle_circumference(radius)"}
{"task_id": "Mbpp/137", "solution": "from dataclasses import dataclass\nfrom typing import List, Union\n\n@dataclass\nclass InputArray:\n    elements: List[int]\n    def length(self) -> int:\n        return len(self.elements)\n\n@dataclass\nclass IntegerElement:\n    value: int\n    def isZero(self) -> bool:\n        return self.value == 0\n\n@dataclass\nclass ZeroCountResult:\n    zeroCount: int\n    nonZeroCount: int\n    ratio: float\n\ndef countZeros(input_array: 'InputArray | List[int]') -> int:\n    \"\"\"Counts elements equal to 0.\"\"\"\n    elements = input_array.elements if isinstance(input_array, InputArray) else input_array\n    return sum(1 for x in elements if x == 0)\n\ndef countNonZeros(input_array: 'InputArray | List[int]') -> int:\n    \"\"\"Counts elements not equal to 0.\"\"\"\n    elements = input_array.elements if isinstance(input_array, InputArray) else input_array\n    return sum(1 for x in elements if x != 0)\n\ndef computeRatio(zeros: int, nonZeros: int) -> float:\n    \"\"\"Computes the ratio of zeros to non-zeros, handling edge cases.\"\"\"\n    if nonZeros > 0:\n        return float(zeros) / nonZeros\n    elif zeros > 0: # All elements are zeros\n        return float('inf')\n    else: # Empty input (zeros == 0 and nonZeros == 0)\n        return 0.0\n\ndef zero_count(input_array: 'InputArray | List[int]', *, as_struct: bool = False) -> Union[float, ZeroCountResult]:\n    \"\"\"\n    Finds the ratio of zeroes to non-zeroes in an array of integers.\n    Handles all-zeros (returns float('inf')) and empty input (returns 0.0).\n    \"\"\"\n    zeros = countZeros(input_array)\n    non_zeros = countNonZeros(input_array)\n    ratio = computeRatio(zeros, non_zeros)\n\n    if as_struct:\n        return ZeroCountResult(zeroCount=zeros, nonZeroCount=non_zeros, ratio=ratio)\n    else:\n        return ratio"}
{"task_id": "Mbpp/140", "solution": "class ExtractSinglyFunction:\n    def execute(self, input_list):\n        \"\"\"Orchestrate validation, flattening and deduplication; return iterable of unique numbers.\"\"\"\n        self.validate_input(input_list)\n        flattened = self.flatten(input_list)\n        unique_iterable = self.deduplicate(flattened)\n        return unique_iterable\n\n    def validate_input(self, input_list):\n        \"\"\"Placeholder for input validation as explicit checks are disallowed by requirements.\"\"\"\n        pass\n\n    def flatten(self, input_list):\n        \"\"\"Return an iterable of numbers flattened from input_list.\"\"\"\n        for sublist in input_list:\n            for item in sublist:\n                yield item\n\n    def deduplicate(self, iterable_of_numbers):\n        \"\"\"Return an iterable containing each numeric value only once.\"\"\"\n        return set(iterable_of_numbers)\n\ndef extract_singly(input_list):\n    \"\"\"Top-level public function accepts a list of sequences of numbers and returns an iterable of unique numbers.\"\"\"\n    interactor = ExtractSinglyFunction()\n    return interactor.execute(input_list)"}
{"task_id": "Mbpp/138", "solution": "def is_Sum_Of_Powers_Of_Two(n: int) -> bool:\n    \"\"\"\n    Checks if an integer can be represented as a sum of distinct non-zero powers of 2 (2^k, k >= 1).\n    Returns False for n <= 0 or if n is odd, as 2^0 (1) is not allowed.\n    \"\"\"\n    if n <= 0:\n        return False\n    # If n is odd, it requires 2^0 (1) in its binary representation, which is not allowed.\n    # Otherwise, if n is positive and even, all its constituent powers of two are >= 2^1.\n    return n % 2 == 0"}
{"task_id": "Mbpp/145", "solution": "from typing import Sequence, Union, List\n\nclass SequenceInput:\n    \"\"\"Thin validation and wrapper for sequence input, ensuring all elements are numeric.\"\"\"\n    def __init__(self, seq: Sequence[Union[int, float]]) -> None:\n        if not isinstance(seq, (list, tuple)):\n            raise TypeError(\"Input must be a list or tuple.\")\n\n        normalized_elements: List[float] = []\n        for i, element in enumerate(seq):\n            if not isinstance(element, (int, float)):\n                raise ValueError(f\"Sequence elements must be numeric, found non-numeric at index {i}.\")\n            normalized_elements.append(float(element))\n\n        self._elements = normalized_elements\n        self._length = len(normalized_elements)\n\n    @property\n    def elements(self) -> List[float]:\n        return self._elements\n\n    @property\n    def length(self) -> int:\n        return self._length\n\nclass Element:\n    \"\"\"Minimal value/index representation for a sequence element.\"\"\"\n    def __init__(self, value: float, index: int) -> None:\n        self.value = value\n        self.index = index\n\nclass Result:\n    \"\"\"Container for the numeric result (maximum difference).\"\"\"\n    def __init__(self, max_diff: float) -> None:\n        self.max_diff = max_diff\n\ndef max_Abs_Diff(seq: Sequence[Union[int, float]]) -> Union[int, float]:\n    \"\"\"\n    Computes the maximum absolute difference between any two numeric elements in a given Python sequence.\n    Returns 0.0 for empty or single-element sequences.\n    \"\"\"\n    # Validate and normalize input using the SequenceInput helper class\n    sequence_input = SequenceInput(seq)\n    elements = sequence_input.elements\n    length = sequence_input.length\n\n    # Handle edge cases for empty or single-element sequences as per design\n    if length <= 1:\n        return 0.0\n\n    # Implement O(n) algorithm to find min and max in a single pass\n    min_val = elements[0]\n    max_val = elements[0]\n\n    for i in range(1, length):\n        current_element = elements[i]\n        if current_element < min_val:\n            min_val = current_element\n        if current_element > max_val:\n            max_val = current_element\n\n    # The maximum absolute difference is the difference between the maximum and minimum values\n    return max_val - min_val"}
{"task_id": "Mbpp/142", "solution": "class InputLists:\n    \"\"\"Encapsulates the three input lists and computes the minimum valid comparison length.\"\"\"\n    def __init__(self, list1, list2, list3):\n        self.list1 = list1\n        self.list2 = list2\n        self.list3 = list3\n\n    def getMinLength(self) -> int:\n        \"\"\"Returns the minimum length among the three encapsulated lists.\"\"\"\n        return min(len(self.list1), len(self.list2), len(self.list3))\n\nclass Comparator:\n    \"\"\"Compares three items for equality using the language standard equality operator.\"\"\"\n    def areEqual(self, a, b, c) -> bool:\n        \"\"\"Checks if all three provided items are equal.\"\"\"\n        return (a == b) and (b == c)\n\nclass Counter:\n    \"\"\"Iterates and counts identical items at the same position across lists.\"\"\"\n    def __init__(self, comparator: Comparator):\n        self.comparator = comparator\n\n    def countSamePair(self, lists: InputLists) -> int:\n        \"\"\"Counts the number of indices where list1[i] == list2[i] == list3[i].\"\"\"\n        count = 0\n        min_length = lists.getMinLength()\n        for i in range(min_length):\n            item1 = lists.list1[i]\n            item2 = lists.list2[i]\n            item3 = lists.list3[i]\n            if self.comparator.areEqual(item1, item2, item3):\n                count += 1\n        return count\n\nclass Result:\n    \"\"\"A container for the integer count result.\"\"\"\n    def __init__(self, count: int):\n        self.count = count\n\ndef count_samepair(list1, list2, list3) -> int:\n    \"\"\"\n    Counts the number of items that are identical in the same position of three given lists.\n    Comparisons are limited to indices present in all three lists.\n    \"\"\"\n    lists = InputLists(list1, list2, list3)\n    comparator = Comparator()\n    counter = Counter(comparator)\n    result_count = counter.countSamePair(lists)\n    return result_count"}
{"task_id": "Mbpp/141", "solution": "class NonComparableElementsError(Exception):\n    \"\"\"Raised when elements in input_list are not mutually comparable using default operators.\"\"\"\n    pass\n\ndef _flip(a: list, k: int) -> None:\n    \"\"\"Reverse prefix a[0:k] in-place.\"\"\"\n    start = 0\n    end = k - 1\n    while start < end:\n        a[start], a[end] = a[end], a[start]\n        start += 1\n        end -= 1\n\ndef pancake_sort(input_list: list) -> list:\n    \"\"\"Public API. Returns a new list sorted in non-decreasing (ascending) order.\n    If elements are not mutually comparable, raises NonComparableElementsError.\n    \"\"\"\n    arr = list(input_list)\n    n = len(arr)\n\n    if n <= 1:\n        return arr\n\n    for current_size in range(n, 1, -1):\n        max_element_index = 0\n        try:\n            for i in range(1, current_size):\n                if arr[i] > arr[max_element_index]:\n                    max_element_index = i\n        except TypeError:\n            raise NonComparableElementsError(\"Elements in the list are not mutually comparable.\")\n\n        if max_element_index != current_size - 1:\n            _flip(arr, max_element_index + 1)\n            _flip(arr, current_size)\n            \n    return arr"}
{"task_id": "Mbpp/160", "solution": "class DiophantineEquation:\n    \"\"\"Encapsulates coefficients a, b, n of a Diophantine equation ax + by = n.\"\"\"\n    def __init__(self, a: int, b: int, n: int):\n        self.a = a\n        self.b = b\n        self.n = n\n\n    def validate(self) -> bool:\n        \"\"\"Verifies that a, b, n are integers (assumed valid per type hints).\"\"\"\n        return True\n\nclass Solution:\n    \"\"\"Represents an integer solution (x, y) for a Diophantine equation.\"\"\"\n    def __init__(self, x: int, y: int):\n        self.x = x\n        self.y = y\n\n    def isValid(self, eq: DiophantineEquation) -> bool:\n        \"\"\"Checks if this solution satisfies the given equation.\"\"\"\n        return eq.a * self.x + eq.b * self.y == eq.n\n\nclass Solver:\n    \"\"\"Stateless service to find integer solutions for Diophantine equations.\"\"\"\n\n    def _run_extended_euclidean_algorithm(self, a: int, b: int) -> tuple[int, int, int]:\n        \"\"\"\n        Computes gcd(a, b) and coefficients x, y such that ax + by = gcd(a, b).\n        Uses the iterative extended Euclidean algorithm and handles signed integers.\n        \"\"\"\n        r_prev, r_curr = a, b\n        s_prev, s_curr = 1, 0\n        t_prev, t_curr = 0, 1\n\n        while r_curr != 0:\n            q = r_prev // r_curr\n            r_prev, r_curr = r_curr, r_prev - q * r_curr\n            s_prev, s_curr = s_curr, s_prev - q * s_curr\n            t_prev, t_curr = t_curr, t_prev - q * t_curr\n        \n        return (r_prev, s_prev, t_prev)\n\n    def compute_gcd(self, a: int, b: int) -> int:\n        \"\"\"Computes the greatest common divisor of a and b.\"\"\"\n        g, _, _ = self._run_extended_euclidean_algorithm(a, b)\n        return g\n\n    def construct_particular_solution(self, a: int, b: int, n: int, g: int) -> tuple[int, int]:\n        \"\"\"\n        Constructs a particular solution (x0, y0) for ax + by = n.\n        It re-computes the Bezout coefficients from the extended Euclidean algorithm for a and b.\n        \"\"\"\n        _, x_g, y_g = self._run_extended_euclidean_algorithm(a, b)\n        \n        # Scale the Bezout identity a*x_g + b*y_g = g by n/g to get a solution for ax + by = n.\n        factor = n // g\n        x0 = x_g * factor\n        y0 = y_g * factor\n        return (x0, y0)\n\n    def find_solution(self, a: int, b: int, n: int) -> tuple[int, int] | None:\n        \"\"\"\n        Finds integers x and y satisfying ax + by = n, handling edge cases for zero coefficients.\n        Returns (x, y) if a solution exists, otherwise returns None.\n        \"\"\"\n        # Handle edge cases where a or b (or both) are zero.\n        if a == 0 and b == 0:\n            return (0, 0) if n == 0 else None\n        \n        if a == 0: # Equation simplifies to by = n\n            return (0, n // b) if n % b == 0 else None\n        \n        if b == 0: # Equation simplifies to ax = n\n            return (n // a, 0) if n % a == 0 else None\n\n        # General case where a and b are non-zero.\n        g = self.compute_gcd(a, b)\n\n        # A solution exists if and only if n is divisible by gcd(a, b).\n        if n % g != 0:\n            return None # No integer solution exists.\n\n        # Construct a particular solution using the previously computed gcd.\n        x0, y0 = self.construct_particular_solution(a, b, n, g)\n        \n        return (x0, y0)\n\ndef find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"\n    Finds integers x and y that satisfy the linear Diophantine equation ax + by = n.\n    Returns (x, y) as a tuple if a solution exists, otherwise returns None.\n    \"\"\"\n    # The public API function delegates the work to a Solver instance.\n    solver = Solver()\n    return solver.find_solution(a, b, n)"}
{"task_id": "Mbpp/162", "solution": "def sum_series(self, n: int) -> int:\n    \"\"\"Calculates the sum of the series (n - 2*i) for i from 0 to n // 2.\"\"\"\n    total_sum = 0\n    # Iterate from i=0 up to n // 2 (inclusive)\n    for i in range(n // 2 + 1):\n        term = n - (2 * i)\n        total_sum += term\n    return total_sum"}
{"task_id": "Mbpp/161", "solution": "class EqualityComparator:\n    def equals(self, a: any, b: any) -> bool:\n        \"\"\"\n        Compares two items for equality using Python's default equality semantics.\n        \"\"\"\n        return a == b\n\nclass Element:\n    def __init__(self, value: any):\n        \"\"\"\n        Wraps a value, providing an equality comparison method.\n        \"\"\"\n        self.value = value\n\n    def equals(self, other: 'Element') -> bool:\n        \"\"\"\n        Compares this Element's value to another Element's value.\n        \"\"\"\n        return self.value == other.value\n\nclass ResultList:\n    def __init__(self):\n        \"\"\"\n        Stores elements that are to be included in the final result.\n        \"\"\"\n        self.elements = []\n\n    def append(self, e: 'Element') -> None:\n        \"\"\"\n        Appends the value of an Element to the internal list.\n        \"\"\"\n        self.elements.append(e.value)\n\n    def to_list(self) -> list:\n        \"\"\"\n        Returns a new list containing the collected elements.\n        \"\"\"\n        return list(self.elements)\n\ndef remove_elements(source: list, to_remove: list) -> list:\n    \"\"\"\n    Removes all elements from the source list that are present in the to_remove list.\n    Preserves the order of the remaining elements.\n    \"\"\"\n    comparator = EqualityComparator()\n    result_list = ResultList()\n\n    for s_elem in source:\n        should_remove = False\n        for t_elem in to_remove:\n            if comparator.equals(s_elem, t_elem):\n                should_remove = True\n                break\n        \n        if not should_remove:\n            result_list.append(Element(s_elem))\n            \n    return result_list.to_list()"}
{"task_id": "Mbpp/166", "solution": "from typing import List\n\ndef find_even_pair(values: List[int]) -> int:\n    \"\"\"\n    Counts the number of pairs of integers in a list that XOR to an even number.\n    An XOR sum is even if and only if both numbers have the same parity.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    for value in values:\n        if value % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    # The number of pairs C(n, 2) is n * (n - 1) // 2\n    pairs_from_evens = even_count * (even_count - 1) // 2\n    pairs_from_odds = odd_count * (odd_count - 1) // 2\n\n    return pairs_from_evens + pairs_from_odds"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(input: str) -> int:\n    \"\"\"\n    Return integer count of characters that match their 1-based English alphabet positions.\n    \"\"\"\n    ALPHABET = 'abcdefghijklmnopqrstuvwxyz'\n    count = 0\n    \n    # Iterate through the input string, considering up to the first 26 characters.\n    for i in range(min(len(input), 26)):\n        char_from_input = input[i]\n        \n        # Convert character to lowercase and check if it's an ASCII letter.\n        lower_char = char_from_input.lower()\n        if 'a' <= lower_char <= 'z':\n            # Compare with the corresponding letter in the alphabet at the same 0-based index.\n            if lower_char == ALPHABET[i]:\n                count += 1\n                \n    return count"}
