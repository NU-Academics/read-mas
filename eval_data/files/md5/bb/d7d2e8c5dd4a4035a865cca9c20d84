{"task_id": "Mbpp/459", "solution": "def remove_uppercase(input: str) -> str:\n    \"\"\"Removes ASCII uppercase characters from the input string and applies business rules.\"\"\"\n\n    class _Character:\n        \"\"\"Represents a single character and whether it is ASCII uppercase.\"\"\"\n        def __init__(self, value: str):\n            self.value = value\n\n        def isUppercase(self) -> bool:\n            \"\"\"Checks if the character is an ASCII uppercase letter.\"\"\"\n            return 'A' <= self.value <= 'Z'\n\n    class _CharacterFilter:\n        \"\"\"Encapsulates detection of ASCII uppercase characters and filtering logic.\"\"\"\n        def isUppercase(self, ch: str) -> bool:\n            \"\"\"Checks if a given character is ASCII uppercase.\"\"\"\n            return _Character(ch).isUppercase()\n\n        def filter(self, s: str) -> str:\n            \"\"\"Returns the string with all ASCII uppercase characters removed.\"\"\"\n            filtered_chars = []\n            for char_val in s:\n                if not self.isUppercase(char_val):\n                    filtered_chars.append(char_val)\n            return \"\".join(filtered_chars)\n\n    class _InputString:\n        \"\"\"Value object encapsulating the raw input string and its length.\"\"\"\n        def __init__(self, raw: str):\n            self.raw = raw\n            self.length = len(raw)\n\n    class _OutputString:\n        \"\"\"Value object encapsulating the produced output string and its length.\"\"\"\n        def __init__(self, result: str):\n            self.result = result\n            self.length = len(result)\n\n    class _RemoveUppercaseFunction:\n        \"\"\"Orchestrator that accepts InputString, uses CharacterFilter, and applies business rules.\"\"\"\n        def __init__(self, name: str):\n            self.name = name\n            self._character_filter = _CharacterFilter()\n\n        def execute(self, input_obj: _InputString) -> _OutputString:\n            \"\"\"Executes the uppercase removal and applies post-filtering business rules.\"\"\"\n            # FR-05: if input is empty, return empty string.\n            # This is implicitly handled by _CharacterFilter.filter returning \"\" for \"\" input.\n            filtered_str = self._character_filter.filter(input_obj.raw)\n\n            # FR-06: if after removal no lowercase letters remain, return empty string.\n            has_lowercase = False\n            for char_val in filtered_str:\n                if 'a' <= char_val <= 'z':\n                    has_lowercase = True\n                    break\n\n            if not has_lowercase and filtered_str:\n                return _OutputString(\"\")\n            else:\n                return _OutputString(filtered_str)\n\n    # Public API wrapper: constructs InputString, delegates to RemoveUppercaseFunction.execute,\n    # and returns OutputString.result.\n    input_object = _InputString(input)\n    remove_func = _RemoveUppercaseFunction(name=\"remove_uppercase\")\n    output_object = remove_func.execute(input_object)\n    return output_object.result"}
{"task_id": "Mbpp/460", "solution": "def Extract(inputList):\n    \"\"\"\n    Parameters:\n      inputList: iterable of iterables (sublists)\n    Returns:\n      list: first elements of each non-empty sublist, in order\n    Raises:\n      TypeError: on invalid inputs per FR6\n    \"\"\"\n    try:\n        # Validate top-level input is iterable\n        input_iterator = iter(inputList)\n    except TypeError:\n        raise TypeError(\"inputList must be an iterable\")\n\n    result = []\n    for sublist in input_iterator:\n        try:\n            # Validate each sublist is iterable\n            sub_iterator = iter(sublist)\n            # Attempt to get the first element\n            first_element = next(sub_iterator)\n            result.append(first_element)\n        except StopIteration:\n            # Sublist is empty, skip it\n            pass\n        except TypeError:\n            # Sublist is not iterable\n            raise TypeError(\"Elements within inputList must be iterables (sublists)\")\n    return result"}
