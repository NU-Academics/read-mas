{"task_id": "Mbpp/415", "solution": "class Pair:\n    \"\"\"Internal representation of a candidate pair and convenience methods.\"\"\"\n    def __init__(self, a: int, b: int):\n        self.a = a\n        self.b = b\n\n    def product(self) -> int:\n        \"\"\"Returns the product of the pair's elements.\"\"\"\n        return self.a * self.b\n\n    def sum(self) -> int:\n        \"\"\"Returns the sum of the pair's elements.\"\"\"\n        return self.a + self.b\n\n    def as_ordered_tuple(self) -> tuple[int, int]:\n        \"\"\"Returns the pair's elements as an ascendingly ordered tuple.\"\"\"\n        return (min(self.a, self.b), max(self.a, self.b))\n\ndef _validate_input(input_list: list) -> None:\n    \"\"\"Validates the input list for length and element types.\"\"\"\n    if len(input_list) < 2:\n        raise ValueError(\"Input list must contain at least two elements.\")\n    for element in input_list:\n        if not isinstance(element, int):\n            raise TypeError(\"All elements in the input list must be integers.\")\n\ndef _apply_tie_breakers(candidates: list[Pair]) -> Pair:\n    \"\"\"Selects the best pair from candidates based on tie-breaking rules.\"\"\"\n    # Sort by sum (descending), then by lexicographically smallest ordered tuple (ascending).\n    candidates.sort(key=lambda p: (-p.sum(), p.as_ordered_tuple()))\n    return candidates[0]\n\ndef _compute_best_pair(elements: list[int]) -> Pair:\n    \"\"\"Enumerates index-distinct pairs, computes products, and finds the best pair.\"\"\"\n    max_product = -float('inf')\n    candidate_pairs: list[Pair] = []\n\n    for i in range(len(elements)):\n        for j in range(i + 1, len(elements)):\n            num1, num2 = elements[i], elements[j]\n            current_pair = Pair(num1, num2)\n            current_product = current_pair.product()\n\n            if current_product > max_product:\n                max_product = current_product\n                candidate_pairs = [current_pair]\n            elif current_product == max_product:\n                candidate_pairs.append(current_pair)\n    \n    return _apply_tie_breakers(candidate_pairs)\n\ndef _ordered_tuple(pair: Pair) -> tuple[int, int]:\n    \"\"\"Converts a Pair object to an ascendingly ordered tuple.\"\"\"\n    return pair.as_ordered_tuple()\n\ndef max_Product(list_of_integers: list[int]) -> tuple[int, int]:\n    \"\"\"\n    Finds a pair with the highest product from a given array of integers.\n    Applies tie-breaking rules for equal products and returns an ordered tuple.\n    \"\"\"\n    _validate_input(list_of_integers)\n    best_pair = _compute_best_pair(list_of_integers)\n    return _ordered_tuple(best_pair)"}
{"task_id": "Mbpp/420", "solution": "def cube_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the cube sum of the first n even natural numbers.\n    Returns 0 if n is 0.\n    \"\"\"\n    if n == 0:\n        return 0\n\n    total_sum = 0\n    for i in range(1, n + 1):\n        even_number = 2 * i\n        total_sum += even_number ** 3\n    return total_sum"}
{"task_id": "Mbpp/419", "solution": "from typing import List\n\nclass Printer:\n    \"\"\"Emits integer value to stdout with newline.\"\"\"\n    def print(self, value: int) -> None:\n        print(value)\n\ndef _bankers_round(n: float) -> int:\n    \"\"\"Private helper implementing banker's rounding (round half to even).\"\"\"\n    return int(round(n))\n\ndef round_and_sum(numbers: List[float]) -> int:\n    \"\"\"Primary API: accepts a list of numbers, returns int. Also prints result to stdout.\"\"\"\n    rounded_sum = 0\n    for num in numbers:\n        rounded_sum += _bankers_round(num)\n\n    # Multiply by the length of the original input list\n    result = rounded_sum * len(numbers)\n\n    # Print the result using the Printer class\n    printer = Printer()\n    printer.print(result)\n\n    return result"}
