{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(arr, n):\n    \"\"\"Compute sum of XOR for all unique unordered pairs among first n elements of arr.\"\"\"\n    \n    def _validate_and_clip_n(arr, n):\n        \"\"\"Return effective n to be used (clip to len(arr), ensure non-negative).\"\"\"\n        if n < 0:\n            return 0\n        return min(n, len(arr))\n\n    def _sum_pairwise_xors(arr, n):\n        \"\"\"Perform nested-loop pairwise XOR and accumulate sum for 0 <= i < j < n.\"\"\"\n        total = 0\n        for i in range(0, n - 1):\n            for j in range(i + 1, n):\n                total += arr[i] ^ arr[j]\n        return total\n\n    effective_n = _validate_and_clip_n(arr, n)\n\n    if effective_n < 2:\n        return 0\n\n    return _sum_pairwise_xors(arr, effective_n)"}
{"task_id": "Mbpp/632", "solution": "def move_zero(input_list: list) -> list:\n    \"\"\"Moves all zeroes to the end of the given list, preserving the relative order of non-zero elements.\"\"\"\n    non_zero_elements = []\n    zero_elements = []\n    for item in input_list:\n        if item == 0:\n            zero_elements.append(item)\n        else:\n            non_zero_elements.append(item)\n    return non_zero_elements + zero_elements"}
{"task_id": "Mbpp/638", "solution": "import math\nfrom datetime import datetime\nfrom typing import Optional\n\nclass ValidationError(Exception):\n    \"\"\"Custom exception for input validation errors.\"\"\"\n    pass\n\nclass InputValidator:\n    \"\"\"Validates input parameters for wind chill calculations.\"\"\"\n    @staticmethod\n    def validate_numeric(value) -> bool:\n        \"\"\"Checks if a value is numeric (int or float).\"\"\"\n        return isinstance(value, (int, float))\n\n    @staticmethod\n    def validate_measurement(velocity_kmh, temperature_celsius) -> None:\n        \"\"\"Validates if velocity and temperature are numeric, raising ValidationError if not.\"\"\"\n        if not InputValidator.validate_numeric(velocity_kmh):\n            raise ValidationError(\"Velocity must be a numeric value.\")\n        if not InputValidator.validate_numeric(temperature_celsius):\n            raise ValidationError(\"Temperature must be a numeric value.\")\n\nclass FormulaEngine:\n    \"\"\"Calculates the raw wind chill value using the specified formula.\"\"\"\n    @staticmethod\n    def evaluate(V: float, T: float) -> float:\n        \"\"\"Applies the wind chill formula: 13.12 + 0.6215*T - 11.37*V**0.16 + 0.3965*T*V**0.16.\"\"\"\n        return 13.12 + 0.6215 * T - 11.37 * (V ** 0.16) + 0.3965 * T * (V ** 0.16)\n\nclass Rounder:\n    \"\"\"Rounds a float value to the nearest integer.\"\"\"\n    @staticmethod\n    def round_to_int(value: float) -> int:\n        \"\"\"Rounds a float to the nearest integer using standard rounding rules.\"\"\"\n        return int(round(value))\n\nclass Measurement:\n    \"\"\"A data container for wind velocity and temperature.\"\"\"\n    def __init__(self, velocity_kmh: float, temperature_celsius: float, timestamp: Optional[datetime] = None):\n        self.velocity_kmh = velocity_kmh\n        self.temperature_celsius = temperature_celsius\n        self.timestamp = timestamp\n\nclass WindChillResult:\n    \"\"\"A data container for the calculated wind chill values.\"\"\"\n    def __init__(self, value: int, raw_value: float, units: str = \"\u00b0C\"):\n        self.value = value\n        self.raw_value = raw_value\n        self.units = units\n\nclass WindChillCalculator:\n    \"\"\"Orchestrates the calculation of wind chill from inputs.\"\"\"\n    def __init__(self, formula_engine: FormulaEngine = None, rounder: Rounder = None, validator: InputValidator = None):\n        self.formula_engine = formula_engine if formula_engine is not None else FormulaEngine()\n        self.rounder = rounder if rounder is not None else Rounder()\n        self.validator = validator if validator is not None else InputValidator()\n\n    def compute_from_values(self, velocity_kmh, temperature_celsius) -> WindChillResult:\n        \"\"\"Computes wind chill from individual velocity and temperature values.\"\"\"\n        self.validator.validate_measurement(velocity_kmh, temperature_celsius)\n        \n        raw_value = self.formula_engine.evaluate(float(velocity_kmh), float(temperature_celsius))\n        integer_value = self.rounder.round_to_int(raw_value)\n        \n        return WindChillResult(value=integer_value, raw_value=raw_value)\n\n    def compute_from_measurement(self, measurement: Measurement) -> WindChillResult:\n        \"\"\"Computes wind chill from a Measurement object.\"\"\"\n        return self.compute_from_values(measurement.velocity_kmh, measurement.temperature_celsius)\n\ndef wind_chill(velocity_kmh, temperature_celsius) -> int:\n    \"\"\"Calculates the wind chill index rounded to the nearest integer.\"\"\"\n    InputValidator.validate_measurement(velocity_kmh, temperature_celsius)\n    \n    calculator = WindChillCalculator()\n    result = calculator.compute_from_values(velocity_kmh, temperature_celsius)\n    \n    return result.value"}
{"task_id": "Mbpp/641", "solution": "class InputValidator:\n    \"\"\"Utility for validating input parameters.\"\"\"\n    @staticmethod\n    def validate_positive_integer(n: int) -> bool:\n        \"\"\"Validates if n is a positive integer (n >= 1).\"\"\"\n        if not isinstance(n, int):\n            raise ValueError(\"Input 'n' must be an integer.\")\n        if n < 1:\n            raise ValueError(\"Input 'n' must be greater than or equal to 1.\")\n        return True\n\nclass NonagonalNumber:\n    \"\"\"Encapsulates the nth nonagonal number computation.\"\"\"\n    def __init__(self, n: int) -> None:\n        \"\"\"Initializes with the index n.\"\"\"\n        self.n = n\n        self.value = 0\n\n    def computeValue(self) -> int:\n        \"\"\"Computes the nonagonal number using the formula (7*n^2 - 5*n)/2.\"\"\"\n        self.value = (7 * self.n**2 - 5 * self.n) // 2\n        return self.value\n\ndef is_nonagonal(n: int) -> int:\n    \"\"\"\n    Computes the nth nonagonal number.\n\n    Validates input n and then calculates the nonagonal number using its\n    mathematical formula.\n    \"\"\"\n    InputValidator.validate_positive_integer(n)\n    nn = NonagonalNumber(n)\n    return nn.computeValue()"}
{"task_id": "Mbpp/639", "solution": "from typing import List\n\nclass Name:\n    \"\"\"Represents a single name with methods for its properties.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def firstChar(self) -> str:\n        \"\"\"Returns the first character of the name, or an empty string if the name is empty.\"\"\"\n        return self.value[0] if self.value else ''\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the name string.\"\"\"\n        return len(self.value)\n\n    def isFirstCharLowercase(self) -> bool:\n        \"\"\"Checks if the first character of the name is an ASCII lowercase letter (a-z).\"\"\"\n        first_char = self.firstChar()\n        return 'a' <= first_char <= 'z'\n\nclass NameList:\n    \"\"\"Manages a list of Name objects, providing filtering and summation capabilities.\"\"\"\n    def __init__(self, names: List[Name]) -> None:\n        self.names = names\n\n    def filterOutLowercaseStart(self) -> List[Name]:\n        \"\"\"Filters out names that start with a lowercase letter.\"\"\"\n        return [name for name in self.names if not name.isFirstCharLowercase()]\n\n    def sumLengths(self) -> int:\n        \"\"\"Calculates the sum of lengths of all names in the list.\"\"\"\n        return sum(name.length() for name in self.names)\n\ndef sample_nam(names: List[str]) -> int:\n    \"\"\"\n    Sums the length of names after removing those that start with a lowercase letter.\n    \"\"\"\n    name_objects = [Name(name_str) for name_str in names]\n    original_name_list = NameList(name_objects)\n    filtered_name_objects = original_name_list.filterOutLowercaseStart()\n    filtered_name_list_for_summation = NameList(filtered_name_objects)\n    total_length = filtered_name_list_for_summation.sumLengths()\n    return total_length"}
{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(input_list: list, k: int) -> list:\n    \"\"\"Reverses the first k elements of the input_list and returns the modified list.\n    The elements from index k onwards remain in their original order.\"\"\"\n    reversed_prefix = input_list[:k][::-1]\n    suffix = input_list[k:]\n    return reversed_prefix + suffix"}
{"task_id": "Mbpp/643", "solution": "def text_match_wordz_middle(text: str) -> bool:\n    \"\"\"\n    Checks if any word in a string contains 'z' (lowercase) not at its start or end.\n    A word is a maximal contiguous sequence of ASCII letters.\n    \"\"\"\n    if not text:\n        return False\n\n    def is_ascii_letter(char_to_check: str) -> bool:\n        \"\"\"Returns True if the character is an ASCII letter (A-Z or a-z).\"\"\"\n        return 'a' <= char_to_check <= 'z' or 'A' <= char_to_check <= 'Z'\n\n    words = []\n    current_word_chars = []\n    for char in text:\n        if is_ascii_letter(char):\n            current_word_chars.append(char)\n        else:\n            if current_word_chars:\n                words.append(\"\".join(current_word_chars))\n                current_word_chars = []\n    if current_word_chars:\n        words.append(\"\".join(current_word_chars))\n\n    for word_text in words:\n        # A word must have at least 3 characters for 'z' to be in an interior position.\n        if len(word_text) >= 3:\n            # Check characters from index 1 to len-2 (inclusive) for 'z'.\n            for i in range(1, len(word_text) - 1):\n                if word_text[i] == 'z':\n                    return True  # Short-circuit on the first interior 'z' found.\n\n    return False"}
{"task_id": "Mbpp/720", "solution": "def _validate_types(input_tuple, input_dict):\n    \"\"\"Raise TypeError if types are invalid.\"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"First argument must be a tuple.\")\n    if not isinstance(input_dict, dict):\n        raise TypeError(\"Second argument must be a dictionary.\")\n\ndef add_dict_to_tuple(input_tuple, input_dict):\n    \"\"\"Validate parameters and return new tuple consisting of input_tuple elements followed by input_dict as final element.\n\n    Raises:\n        TypeError: if input_tuple is not a tuple or input_dict is not a dict.\n    \"\"\"\n    _validate_types(input_tuple, input_dict)\n    return input_tuple + (input_dict,)"}
{"task_id": "Mbpp/722", "solution": "def filter_data(students: dict, min_height: float, min_weight: float) -> dict:\n    \"\"\"\n    Filters a dictionary of students, returning only those whose height and weight\n    are above or equal to the specified minimums.\n    \"\"\"\n    filtered_students = {}\n    for name, (height, weight) in students.items():\n        if height >= min_height and weight >= min_weight:\n            filtered_students[name] = (height, weight)\n    return filtered_students"}
{"task_id": "Mbpp/723", "solution": "def count_same_pair(a: list, b: list) -> int:\n    \"\"\"Counts indices where two lists have the same values. Raises ValueError if lists have different lengths.\"\"\"\n    if len(a) != len(b):\n        raise ValueError(\"Input lists must be of the same length.\")\n\n    match_count = 0\n    # Iterate through corresponding elements and increment count on a match.\n    for i in range(len(a)):\n        if a[i] == b[i]:\n            match_count += 1\n            \n    return match_count"}
{"task_id": "Mbpp/721", "solution": "class Cell:\n    \"\"\"Represents a single cell coordinate and its cost.\"\"\"\n    def __init__(self, row: int, col: int, cost: float) -> None:\n        self.row = row\n        self.col = col\n        self.cost = cost\n\nclass Matrix:\n    \"\"\"Encapsulates an N x N matrix and provides basic validation and access.\"\"\"\n    def __init__(self, rows: list) -> None:\n        self.rows_raw = rows\n        self.size = len(rows)\n        self.cells: list = [] # Stores List[List[Cell]]\n        if self.size > 0:\n            for r_idx, row_list in enumerate(rows):\n                cell_row = []\n                for c_idx, cost_val in enumerate(row_list):\n                    cell_row.append(Cell(r_idx, c_idx, float(cost_val)))\n                self.cells.append(cell_row)\n\n    def isSquare(self) -> bool:\n        \"\"\"Returns True if the matrix is square (N x N), False otherwise.\"\"\"\n        if self.size == 0:\n            return True\n        return all(len(row) == self.size for row in self.rows_raw)\n\n    def get(self, row: int, col: int) -> Cell:\n        \"\"\"Returns the Cell object at the given row and column.\"\"\"\n        return self.cells[row][col]\n\nclass Path:\n    \"\"\"Represents an ordered sequence of Cells and computes path metrics.\"\"\"\n    def __init__(self, cells: list) -> None: # cells: List[Cell]\n        self.cells = cells\n\n    def totalCost(self) -> float:\n        \"\"\"Calculates the sum of costs for all cells in the path.\"\"\"\n        return sum(cell.cost for cell in self.cells)\n\n    def length(self) -> int:\n        \"\"\"Returns the number of cells in the path.\"\"\"\n        return len(self.cells)\n\n    def average(self) -> float:\n        \"\"\"Computes the average cost per cell for the path.\"\"\"\n        path_length = self.length()\n        if path_length == 0:\n            return 0.0\n        return self.totalCost() / path_length\n\nclass MaxAverageCalculator:\n    \"\"\"Orchestrates matrix validation, path generation, and maximum average selection.\"\"\"\n    def maxAverageOfPath(self, matrix: Matrix) -> float:\n        \"\"\"Validates the matrix, enumerates paths, computes averages, and returns the maximum average.\n        Raises ValueError if validation fails according to design specification.\n        \"\"\"\n        if not self.validateMatrix(matrix):\n            raise ValueError(\"Invalid matrix: must be non-empty, square, and contain numeric cells.\")\n\n        all_paths = self.generatePaths(matrix)\n        \n        max_avg = -float('inf')\n        for path in all_paths:\n            max_avg = max(max_avg, path.average())\n        return max_avg\n\n    def generatePaths(self, matrix: Matrix) -> list: # Returns List[Path]\n        \"\"\"Generates all valid paths from (0,0) to (N-1, N-1) using only right and down moves.\"\"\"\n        paths: list = [] # List[Path]\n        N = matrix.size\n\n        def _dfs(row: int, col: int, current_path_cells: list): # current_path_cells: List[Cell]\n            current_path_cells.append(matrix.get(row, col))\n\n            if row == N - 1 and col == N - 1:\n                paths.append(Path(list(current_path_cells)))\n            else:\n                if col + 1 < N:\n                    _dfs(row, col + 1, current_path_cells)\n                if row + 1 < N:\n                    _dfs(row + 1, col, current_path_cells)\n            \n            current_path_cells.pop()\n\n        if N > 0:\n            _dfs(0, 0, [])\n        \n        return paths\n\n    def validateMatrix(self, matrix: Matrix) -> bool:\n        \"\"\"Returns True if the matrix is non-empty, square, and all cells contain numeric values; False otherwise.\"\"\"\n        if matrix.size == 0:\n            return False\n        if not matrix.isSquare():\n            return False\n        \n        for r in range(matrix.size):\n            for c in range(matrix.size):\n                cost_value_raw = matrix.rows_raw[r][c]\n                if not isinstance(cost_value_raw, (int, float)):\n                    return False\n        return True\n\ndef maxAverageOfPath(matrix: list) -> float:\n    \"\"\"Public API. Accepts list-of-lists representing an N x N numeric matrix.\n    It constructs domain objects and delegates to MaxAverageCalculator to find the maximum average.\n    \"\"\"\n    m = Matrix(matrix)\n    calc = MaxAverageCalculator()\n    return calc.maxAverageOfPath(m)"}
{"task_id": "Mbpp/725", "solution": "def extract_quotation(input: str) -> list:\n    \"\"\"Parse input and return a list of substrings enclosed in double quotes.\n    Preconditions: input is a string. Postcondition: returns list of strings without surrounding quotes.\n    \"\"\"\n    extracted_quotes = []\n    in_quote = False\n    start_index = -1\n\n    for i, char in enumerate(input):\n        if char == '\"':\n            if not in_quote:\n                # Found opening quote\n                in_quote = True\n                start_index = i + 1\n            else:\n                # Found closing quote\n                in_quote = False\n                extracted_quotes.append(input[start_index:i])\n                start_index = -1 # Reset for next quote pair\n\n    return extracted_quotes"}
{"task_id": "Mbpp/724", "solution": "def power_base_sum(base: int, power: int) -> int:\n    \"\"\"Calculates base to the specified power and sums all digits of the result.\"\"\"\n    # Compute the power. Python's int handles arbitrary precision.\n    number = base ** power\n    \n    # Convert the absolute value of the number to a string to extract digits.\n    # The problem description and example imply positive results or summing digits of abs(result).\n    # Since base and power are usually positive for this kind of problem, abs() is a safe default.\n    s_number = str(abs(number))\n    \n    # Sum the integer value of each digit character.\n    digit_sum = 0\n    for digit_char in s_number:\n        digit_sum += int(digit_char)\n        \n    return digit_sum"}
{"task_id": "Mbpp/726", "solution": "from typing import Any, Iterable, Iterator, Tuple, Union\n\nNumber = Union[int, float]\n\nclass InvalidInputException(Exception):\n    \"\"\"Exception raised for invalid input to the multiply_elements function.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(self.message)\n\nclass InputTuple:\n    \"\"\"Encapsulates the raw input for validation and processing, storing elements as a tuple.\"\"\"\n    def __init__(self, raw: Any) -> None:\n        self._raw_input = raw # Store raw input to check its original type in ValidationService\n        try:\n            # Construct InputTuple from raw input, storing elements as a tuple as per design.\n            # This conversion may raise TypeError if raw is not iterable.\n            self.elements: Tuple[Number, ...] = tuple(raw)\n        except TypeError:\n            # If raw is not iterable (e.g., an int), it cannot become a tuple.\n            # This case falls under \"input is not a tuple\" conceptually.\n            raise InvalidInputException(\"Input must be a tuple or an iterable that can be converted to a tuple.\")\n\n    def __len__(self) -> int:\n        return len(self.elements)\n\n    def __iter__(self) -> Iterator[Number]:\n        return iter(self.elements)\n\nclass Element:\n    \"\"\"Represents a single input element with its numeric value and position.\"\"\"\n    def __init__(self, value: Number, position: int) -> None:\n        self.value = value\n        self.position = position\n\nclass OutputTuple:\n    \"\"\"Holds ordered products computed from adjacent pairs and exposes an immutable tuple.\"\"\"\n    def __init__(self, products: Iterable[Number]) -> None:\n        self._products: Tuple[Number, ...] = tuple(products)\n\n    def __len__(self) -> int:\n        return len(self._products)\n\n    def as_tuple(self) -> Tuple[Number, ...]:\n        \"\"\"Returns the computed products as an immutable tuple.\"\"\"\n        return self._products\n\nclass ValidationService:\n    \"\"\"Validates an InputTuple against type, length, and element content rules.\"\"\"\n    def validate(self, input_tuple: InputTuple) -> None:\n        # Check if the original raw input was actually a tuple (not just any iterable)\n        if not isinstance(input_tuple._raw_input, tuple):\n            raise InvalidInputException(\"Input must be a tuple.\")\n        \n        # Check length\n        if len(input_tuple.elements) < 2:\n            raise InvalidInputException(\"Input tuple must contain at least 2 elements.\")\n\n        # Check all elements are numeric\n        for element in input_tuple.elements:\n            if not isinstance(element, (int, float)):\n                raise InvalidInputException(\"All elements in the input tuple must be numbers (int or float).\")\n\nclass MultiplyService:\n    \"\"\"Computes adjacent pairwise products and produces an OutputTuple.\"\"\"\n    def __init__(self, validation: ValidationService = None) -> None:\n        self.validation = validation if validation is not None else ValidationService()\n\n    def multiply_elements(self, input_tuple: InputTuple) -> OutputTuple:\n        \"\"\"Validates the input and computes pairwise products.\"\"\"\n        self.validation.validate(input_tuple)\n\n        products: list[Number] = []\n        for i in range(len(input_tuple.elements) - 1):\n            product = input_tuple.elements[i] * input_tuple.elements[i+1]\n            products.append(product)\n\n        return OutputTuple(products)\n\ndef multiply_elements(input_tuple_raw: Any) -> Tuple[Number, ...]:\n    \"\"\"\n    Takes a tuple of numbers (t_1,...,t_{N+1}) and returns a tuple of length N\n    where the i-th element is t_i * t_{i+1}.\n    \"\"\"\n    # Construct InputTuple, handling initial conversion to tuple and catching non-iterable inputs.\n    input_obj = InputTuple(input_tuple_raw)\n    \n    # Initialize MultiplyService, which internally uses ValidationService.\n    service = MultiplyService()\n    \n    # Delegate the core logic to MultiplyService.\n    output_obj = service.multiply_elements(input_obj)\n    \n    # Return the result as an immutable tuple.\n    return output_obj.as_tuple()"}
{"task_id": "Mbpp/728", "solution": "from typing import List, Sequence, Union\n\nclass ListElement:\n    \"\"\"Represents a single list element with an index and a float value.\"\"\"\n    def __init__(self, index: int, value: float) -> None:\n        self.index = index\n        self.value = value\n\n    def __repr__(self) -> str:\n        return f\"ListElement(index={self.index}, value={self.value})\"\n\nclass InputList:\n    \"\"\"Adapter holding a sequence of ListElement instances for an input list.\"\"\"\n    def __init__(self, values: Sequence[float]) -> None:\n        self.elements: List[ListElement] = []\n        for i, val in enumerate(values):\n            try:\n                numeric_val = float(val)\n                self.elements.append(ListElement(i, numeric_val))\n            except (TypeError, ValueError) as e:\n                raise ValueError(f\"Input list contains non-numeric element at index {i}: {val}\") from e\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.elements)\n\n    def get_value(self, index: int) -> float:\n        \"\"\"Returns the float value of the element at the given index.\"\"\"\n        return self.elements[index].value\n\n    def to_list(self) -> List[float]:\n        \"\"\"Converts the InputList back to a native Python list of floats.\"\"\"\n        return [elem.value for elem in self.elements]\n\nclass OutputList:\n    \"\"\"Adapter holding a sequence of ListElement instances for an output list.\"\"\"\n    def __init__(self, elements: List[ListElement]) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.elements)\n\n    def to_list(self) -> List[float]:\n        \"\"\"Converts the OutputList to a native Python list of floats.\"\"\"\n        return [elem.value for elem in self.elements]\n\nclass SumListFunction:\n    \"\"\"Encapsulates the core element-wise summation algorithm.\"\"\"\n    @staticmethod\n    def sum_list(a: InputList, b: InputList) -> OutputList:\n        \"\"\"Performs element-wise summation of two InputLists, raising ValueError on unequal lengths.\"\"\"\n        if a.length() != b.length():\n            raise ValueError(\n                f\"Input lists must have equal length. Got lengths {a.length()} and {b.length()}.\"\n            )\n\n        result_elements: List[ListElement] = []\n        for i in range(a.length()):\n            sum_val = a.get_value(i) + b.get_value(i)\n            result_elements.append(ListElement(i, sum_val))\n        \n        return OutputList(result_elements)\n\ndef sum_list(a: Union[Sequence[float], InputList], b: Union[Sequence[float], InputList]) -> List[float]:\n    \"\"\"\n    Takes two lists and returns a new list containing the element-wise sums.\n    Raises ValueError if inputs contain non-numeric elements or have unequal lengths.\n    \"\"\"\n    input_a: InputList\n    input_b: InputList\n\n    if isinstance(a, InputList):\n        input_a = a\n    else:\n        input_a = InputList(a)\n\n    if isinstance(b, InputList):\n        input_b = b\n    else:\n        input_b = InputList(b)\n\n    output_list = SumListFunction.sum_list(input_a, input_b)\n    return output_list.to_list()"}
{"task_id": "Mbpp/730", "solution": "from typing import Any, List\n\ndef consecutive_duplicates(input_list: List[Any]) -> List[Any]:\n    \"\"\"Return a list that contains the first element of each maximal run of equal adjacent elements from input_list.\"\"\"\n    if not input_list:\n        return []\n\n    result = [input_list[0]]\n    for i in range(1, len(input_list)):\n        if input_list[i] != result[-1]:\n            result.append(input_list[i])\n    return result"}
{"task_id": "Mbpp/731", "solution": "import math\n\nclass MathConstants:\n    PI: float = math.pi\n\nclass Input:\n    def __init__(self, r, h) -> None:\n        self.r = r\n        self.h = h\n\n    def validate(self) -> bool:\n        return isinstance(self.r, (int, float)) and isinstance(self.h, (int, float))\n\nclass Cone:\n    def __init__(self, radius: float, height: float) -> None:\n        self.radius = radius\n        self.height = height\n        self.slantHeight: float = 0.0\n        self.lateralSurfaceArea: float = 0.0\n\n    def computeSlantHeight(self) -> float:\n        self.slantHeight = math.sqrt(self.radius**2 + self.height**2)\n        return self.slantHeight\n\n    def computeLateralSurfaceArea(self) -> float:\n        # Ensures slantHeight is computed before use.\n        if self.slantHeight == 0.0:\n            self.computeSlantHeight()\n        self.lateralSurfaceArea = MathConstants.PI * self.radius * self.slantHeight\n        return self.lateralSurfaceArea\n\nclass Result:\n    def __init__(self, value: float) -> None:\n        self.value = value\n\ndef lateralsurface_cone(r, h):\n    \"\"\"Calculates the lateral surface area of a cone given its radius and height.\"\"\"\n    input_obj = Input(r, h)\n    if not input_obj.validate():\n        raise ValueError(\"Inputs must be numeric\")\n\n    cone = Cone(float(r), float(h))\n    cone.computeSlantHeight()\n    value = cone.computeLateralSurfaceArea()\n\n    result = Result(value)\n    return result.value"}
{"task_id": "Mbpp/732", "solution": "def replace_specialchar(input: str) -> str:\n    \"\"\"Return a string where every space ' ', comma ',', and dot '.' in input is replaced with ':'. Preserves all other characters and order.\"\"\"\n    result_chars = []\n    for char in input:\n        if char == ' ' or char == ',' or char == '.':\n            result_chars.append(':')\n        else:\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/733", "solution": "from typing import List\n\nclass InputArray:\n    \"\"\"Encapsulates a numeric sequence for search operations.\"\"\"\n    def __init__(self, numbers: List[float]) -> None:\n        self.numbers = numbers\n\n    def length(self) -> int:\n        return len(self.numbers)\n\n    def isEmpty(self) -> bool:\n        return self.length() == 0\n\n    def isSortedNonDecreasing(self) -> bool:\n        # This method is part of the design but not strictly required\n        # for the current implementation given the assumption of sorted input.\n        return True # Assumed sorted by design context\n\nclass Target:\n    \"\"\"Encapsulates the numeric search target.\"\"\"\n    def __init__(self, value: float) -> None:\n        self.value = value\n\nclass SearchResult:\n    \"\"\"Represents the outcome of a search operation.\"\"\"\n    def __init__(self, index: int) -> None:\n        self.index = index\n\nclass FindFirstOccurrence:\n    \"\"\"Implements a left-biased binary search to find the first occurrence.\"\"\"\n    def find_first_occurrence(self, array: InputArray, target: Target) -> int:\n        if array.isEmpty():\n            return -1\n\n        low = 0\n        high = array.length() - 1\n        result_index = -1\n\n        while low <= high:\n            mid = low + (high - low) // 2\n            mid_val = array.numbers[mid]\n\n            if mid_val == target.value:\n                result_index = mid  # Store current index as a potential answer\n                high = mid - 1      # Try to find an earlier occurrence in the left half\n            elif mid_val < target.value:\n                low = mid + 1\n            else:  # mid_val > target.value\n                high = mid - 1\n        return result_index\n\ndef find_first_occurrence(array: List[float], target: float) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a given number in a sorted array.\n    \"\"\"\n    input_array_obj = InputArray(array)\n    target_obj = Target(target)\n    \n    finder = FindFirstOccurrence()\n    index = finder.find_first_occurrence(input_array_obj, target_obj)\n    \n    return index"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(input_list):\n    \"\"\"\n    Calculates the sum of products of all possible contiguous sublists of the given list.\n    Returns 0 for an empty input list.\n    \"\"\"\n    n = len(input_list)\n    total_sum = 0\n\n    if n == 0:\n        return 0\n\n    for i in range(n):\n        current_product = 1\n        for j in range(i, n):\n            current_product *= input_list[j]\n            total_sum += current_product\n            \n    return total_sum"}
{"task_id": "Mbpp/737", "solution": "import re\nfrom dataclasses import dataclass\n\n_DEFAULT_PATTERN: str = r'^[aeiou]'\n\n@dataclass\nclass InputString:\n    value: str\n\n@dataclass\nclass RegexPattern:\n    pattern: str\n\n@dataclass\nclass Result:\n    isVowelStart: bool\n\ndef check_str(input: str) -> bool:\n    \"\"\"Return True if input starts with a lowercase vowel [a,e,i,o,u] using a regex anchored at the start of the string.\"\"\"\n    _input = InputString(value=input)\n    _pattern = RegexPattern(pattern=_DEFAULT_PATTERN)\n    match = re.match(_pattern.pattern, _input.value)\n    result = Result(isVowelStart=(match is not None))\n    return result.isVowelStart"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(value: int) -> int:\n    \"\"\"\n    Toggles bits of the number strictly between the most-significant and least-significant set bits.\n    Preserves the MSB and LSB. If fewer than two distinct set bits, returns the original value.\n    \"\"\"\n    # Input validation: Ensure value is a non-negative integer as per design.\n    if not isinstance(value, int) or value < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n\n    # If the value is 0, there are no set bits to toggle, so return 0.\n    if value == 0:\n        return 0\n\n    # Determine the index of the most significant set bit (MSB).\n    # value.bit_length() gives the position of the MSB + 1 (for 0-indexed bits).\n    first_idx = value.bit_length() - 1\n\n    # Determine the index of the least significant set bit (LSB).\n    # The expression (value & -value) isolates the LSB. For example, 9 (0b1001) & -9 results in 1 (0b0001).\n    # Then bit_length() of this result gives its position + 1.\n    last_idx = (value & -value).bit_length() - 1\n\n    # If the MSB and LSB are the same or adjacent (difference <= 1),\n    # there are no \"middle\" bits to toggle, so return the original value.\n    if first_idx - last_idx <= 1:\n        return value\n\n    # Calculate the number of bits strictly between the MSB and LSB.\n    num_bits_to_toggle = first_idx - last_idx - 1\n\n    # Construct the toggle mask.\n    # A sequence of `n` ones is (1 << n) - 1.\n    # This sequence is then shifted left by (last_idx + 1) to align it correctly\n    # between the LSB and MSB.\n    mask = ((1 << num_bits_to_toggle) - 1) << (last_idx + 1)\n\n    # Apply the mask using a bitwise XOR operation to toggle the middle bits.\n    return value ^ mask"}
{"task_id": "Mbpp/739", "solution": "def find_Index(n: int) -> int:\n    \"\"\"Validate n and return minimal k such that digits(compute(k)) == n.\"\"\"\n\n    # Helper function definitions as per design context, nested to satisfy \"inline\" requirement.\n    def validate(val):\n        \"\"\"Raise ValueError if val is not a positive integer (val >= 1).\"\"\"\n        if not isinstance(val, int) or val < 1:\n            raise ValueError(\"n must be a positive integer\")\n\n    def compute(k_val: int) -> int:\n        \"\"\"Return triangular number T(k) using integer arithmetic: k*(k+1)//2.\"\"\"\n        return k_val * (k_val + 1) // 2\n\n    def digit_count(value_val: int) -> int:\n        \"\"\"Return number of decimal digits in value using integer-only methods.\"\"\"\n        return len(str(value_val))\n\n    # Orchestration logic for find_Index\n    validate(n)\n    \n    k = 1\n    while True:\n        triangular_num = compute(k)\n        num_digits = digit_count(triangular_num)\n        \n        if num_digits == n:\n            return k\n        \n        k += 1"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(sequence, value):\n    \"\"\"Return index i (int) in range [0, len(sequence)] such that inserting value at i preserves ascending order and places value before equal elements.\"\"\"\n\n    def _binary_search_left(seq, val):\n        \"\"\"Internal helper returning index as described; returns len(sequence) if value > all elements.\"\"\"\n        low = 0\n        high = len(seq)\n        while low < high:\n            mid = (low + high) // 2\n            if seq[mid] < val:\n                low = mid + 1\n            else:\n                high = mid\n        return low\n\n    return _binary_search_left(sequence, value)"}
{"task_id": "Mbpp/741", "solution": "def all_Characters_Same(s: str) -> bool:\n    \"\"\"Return True if every character in s is identical (exact Unicode code-point equality).\"\"\"\n    if len(s) <= 1:\n        return True\n    \n    first_char = s[0]\n    for char in s[1:]:\n        if char != first_char:\n            return False\n            \n    return True"}
{"task_id": "Mbpp/740", "solution": "def tuple_to_dict(input_tuple) -> dict:\n    \"\"\"Converts a tuple of adjacent elements into a key-value dictionary.\n    Raises TypeError or ValueError based on validation rules.\"\"\"\n\n    def _validate_input(input_tuple) -> None:\n        \"\"\"Validates the input_tuple type and length.\"\"\"\n        if not isinstance(input_tuple, tuple):\n            raise TypeError(\"Input must be a tuple.\")\n        if len(input_tuple) % 2 != 0:\n            raise ValueError(\"Tuple length must be even.\")\n\n    def _convert_pairs(input_tuple) -> dict:\n        \"\"\"Constructs a dictionary from adjacent tuple elements.\"\"\"\n        result_dict = {}\n        for i in range(0, len(input_tuple), 2):\n            key = input_tuple[i]\n            value = input_tuple[i + 1]\n            result_dict[key] = value\n        return result_dict\n\n    _validate_input(input_tuple)\n    return _convert_pairs(input_tuple)"}
{"task_id": "Mbpp/743", "solution": "def rotate_right(list, count):\n    \"\"\"Return a new list rotated right by count positions.\n    Does not mutate the input list.\n    \"\"\"\n    if not list:\n        return []\n\n    n = len(list)\n    effective = count % n\n\n    if effective == 0:\n        return list[:] # Return a shallow copy if no effective rotation\n\n    # Slice the list into two parts and concatenate them in the rotated order\n    return list[-effective:] + list[:-effective]"}
{"task_id": "Mbpp/745", "solution": "from typing import List\n\ndef _digits_of(n: int) -> List[int]:\n    \"\"\"Returns a list of decimal digits for the given integer n.\"\"\"\n    return [int(d) for d in str(n)]\n\ndef _contains_zero_digit(n: int) -> bool:\n    \"\"\"Returns True if the integer n contains the digit 0.\"\"\"\n    return '0' in str(n)\n\ndef _all_digits_divide(n: int) -> bool:\n    \"\"\"Returns True if every digit of n divides n evenly.\"\"\"\n    # This function assumes n does not contain the digit 0.\n    for digit in _digits_of(n):\n        if n % digit != 0:\n            return False\n    return True\n\ndef divisible_by_digits(startnum: int, endnum: int) -> List[int]:\n    \"\"\"\n    Finds numbers within a given range where every number is divisible by every digit it contains.\n    Numbers containing the digit 0 are excluded.\n    \"\"\"\n    result = []\n    for n in range(startnum, endnum + 1):\n        if _contains_zero_digit(n):\n            continue\n        if _all_digits_divide(n):\n            result.append(n)\n    return result"}
{"task_id": "Mbpp/744", "solution": "def check_none(input_tuple: tuple) -> bool:\n    \"\"\"Return True if any element of input_tuple is None, False otherwise.\n    This function performs a shallow element-wise check without modifying the input tuple.\n    \"\"\"\n    for element in input_tuple:\n        if element is None:\n            return True\n    return False"}
{"task_id": "Mbpp/742", "solution": "import math\n\nclass Tetrahedron:\n    def __init__(self, side_length: float):\n        self.side_length = float(side_length)\n\n    def calculateSurfaceArea(self) -> float:\n        \"\"\"Computes the surface area of the tetrahedron.\"\"\"\n        return math.sqrt(3) * (self.side_length ** 2)\n\nclass TetrahedronCalculator:\n    def __init__(self):\n        pass\n\n    def area_tetrahedron(self, side_length) -> float:\n        \"\"\"Constructs a Tetrahedron and calculates its surface area.\"\"\"\n        tetra = Tetrahedron(side_length)\n        return tetra.calculateSurfaceArea()\n\ndef area_tetrahedron(side_length) -> float:\n    \"\"\"Calculates the surface area of a regular tetrahedron.\"\"\"\n    calc = TetrahedronCalculator()\n    return calc.area_tetrahedron(side_length)"}
