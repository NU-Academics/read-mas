{"task_id": "Mbpp/799", "solution": "def left_rotate(number, d):\n    \"\"\"\n    Performs a 32-bit left bit rotation on the given number by d positions.\n    The input number is treated as an unsigned 32-bit integer.\n    \"\"\"\n    WIDTH = 32\n    MASK = (1 << WIDTH) - 1\n\n    # Mask the input number to ensure it's treated as a 32-bit unsigned integer.\n    value = number & MASK\n\n    # Normalize the rotation count to be within [0, WIDTH-1].\n    effective_d = d % WIDTH\n\n    # If the effective rotation count is 0, return the masked original value.\n    if effective_d == 0:\n        return value\n\n    # Perform the left shift, masking to keep only bits within the 32-bit range.\n    left_part = (value << effective_d) & MASK\n\n    # Perform the right shift for the bits that wrapped around from the left.\n    wrap_part = (value >> (WIDTH - effective_d)) & MASK\n\n    # Combine the left-shifted part and the wrapped-around part, then mask the final result.\n    result = (left_part | wrap_part) & MASK\n    return result"}
{"task_id": "Mbpp/803", "solution": "import math\n\ndef is_perfect_square(n):\n    \"\"\"\n    Checks if a given number is a perfect square.\n    Returns True if n is a perfect square, False otherwise.\n    \"\"\"\n    if n < 0:\n        return False\n    k = math.isqrt(n)\n    return k * k == n"}
{"task_id": "Mbpp/804", "solution": "from typing import List, Any\n\nclass NumberElement:\n    \"\"\"Represents a numeric element and its position in a list.\"\"\"\n    def __init__(self, value: Any, index: int):\n        self.value = value\n        self.index = index\n\nclass NumberList:\n    \"\"\"Represents an input sequence of numeric elements.\"\"\"\n    def __init__(self, numbers: List[Any]):\n        self.numbers = [NumberElement(value, i) for i, value in enumerate(numbers)]\n\nclass ProductResult:\n    \"\"\"Represents the computed product and its parity result.\"\"\"\n    def __init__(self, product: Any, is_even: bool):\n        self.product = product\n        self.is_even = is_even\n\nclass ProductChecker:\n    \"\"\"Computes whether the product of a list of numbers is even.\"\"\"\n\n    def is_product_even(self, numbers: List[Any]) -> bool:\n        \"\"\"\n        Checks if the product of numbers in a list is even.\n        It short-circuits by returning True if any element is zero or even.\n        \"\"\"\n        for num in numbers:\n            if num == 0:\n                return True\n            # Checks if the number is even (e.g., 2, 4.0).\n            if num % 2 == 0:\n                return True\n        return False\n\ndef is_product_even(numbers: List[Any]) -> bool:\n    \"\"\"\n    Checks whether the product of numbers in a list is even or not.\n    This public API delegates the core logic to ProductChecker.\n    \"\"\"\n    checker = ProductChecker()\n    return checker.is_product_even(numbers)"}
{"task_id": "Mbpp/805", "solution": "from typing import List\n\ndef max_sum_list(list_of_lists: List[List[int]]) -> List[int]:\n    \"\"\"\n    Returns the list in a list of lists whose sum of elements is the highest.\n    If multiple lists have the same highest sum, the first one encountered is returned.\n    \"\"\"\n    max_list = list_of_lists[0]\n    max_sum = sum(max_list)\n\n    for current_list in list_of_lists[1:]:\n        current_sum = sum(current_list)\n        if current_sum > max_sum:\n            max_sum = current_sum\n            max_list = current_list\n            \n    return max_list"}
{"task_id": "Mbpp/801", "solution": "def test_three_equal(a: int, b: int, c: int) -> int:\n    \"\"\"Counts the number of equal integers from three given inputs.\n    Returns 3 if all are equal, 2 if exactly two are equal, and 0 if all are different.\n    \"\"\"\n    if a == b == c:\n        return 3\n    elif a == b or a == c or b == c:\n        return 2\n    else:\n        return 0"}
{"task_id": "Mbpp/806", "solution": "def max_run_uppercase(input_string: str) -> int:\n    \"\"\"\n    Finds the maximum run of uppercase characters in the given string.\n    Returns 0 for an empty string or if no uppercase characters are present.\n    \"\"\"\n    max_run = 0\n    current_run = 0\n    for char in input_string:\n        if char.isupper():\n            current_run += 1\n            if current_run > max_run:\n                max_run = current_run\n        else:\n            current_run = 0\n    return max_run"}
{"task_id": "Mbpp/807", "solution": "from typing import List, Iterator, Optional, Union\n\nclass Number:\n    \"\"\"Encapsulates a numeric value and provides an oddness predicate.\"\"\"\n    def __init__(self, value: Union[int, float]) -> None:\n        self.value = value\n\n    def is_odd(self) -> bool:\n        \"\"\"Determines if the number is odd based on integer modulus.\"\"\"\n        # Non-integer floats are treated as not odd per design.\n        if isinstance(self.value, int):\n            return self.value % 2 != 0\n        elif isinstance(self.value, float) and self.value == int(self.value):\n            return int(self.value) % 2 != 0\n        return False\n\nclass NumberList:\n    \"\"\"Wraps a list of raw values into Number objects for iteration.\"\"\"\n    def __init__(self, raw_values: List[Union[int, float]]) -> None:\n        self.values: List[Number] = [Number(val) for val in raw_values]\n\n    def __iter__(self) -> Iterator[Number]:\n        \"\"\"Returns an iterator over the Number objects.\"\"\"\n        return iter(self.values)\n\nclass Result:\n    \"\"\"A thin wrapper holding the computed result (value or None).\"\"\"\n    def __init__(self, value: Optional[Union[int, float]]) -> None:\n        self.value = value\n\ndef first_odd(numbers: list) -> Optional[int]:\n    \"\"\"\n    Finds the first odd number in a given list of numbers.\n    Returns the first odd integer found, or None if no odd number exists.\n    \"\"\"\n    number_list_wrapper = NumberList(numbers)\n\n    for num_obj in number_list_wrapper:\n        if num_obj.is_odd():\n            result_container = Result(num_obj.value)\n            # Ensure the returned value is an integer as per the signature.\n            if isinstance(result_container.value, float):\n                return int(result_container.value)\n            return result_container.value\n    \n    result_container = Result(None)\n    return result_container.value"}
