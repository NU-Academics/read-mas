{"task_id": "Mbpp/593", "solution": "def removezero_ip(ip: str) -> str:\n    # Splits the IP address into octets, normalizes each octet, and rejoins them.\n    # Normalization involves converting to int to remove leading zeros, then back to string.\n    octets = ip.split('.')\n    normalized_octets = [str(int(octet)) for octet in octets]\n    return '.'.join(normalized_octets)"}
{"task_id": "Mbpp/594", "solution": "def diff_even_odd(numbers: list[int]) -> int:\n    \"\"\"Finds the difference between the first even and first odd number in a list.\"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in numbers:\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n\n        if first_even is not None and first_odd is not None:\n            break\n            \n    return first_even - first_odd"}
{"task_id": "Mbpp/590", "solution": "import math\nfrom typing import Tuple\n\nDEFAULT_TOLERANCE: float = 1e-12\n\ndef polar_rect(a: float, b: float, interpretation: str, tolerance: float = DEFAULT_TOLERANCE) -> Tuple[Tuple[float, float], complex]:\n    \"\"\"\n    Converts between polar and rectangular coordinates based on the interpretation.\n    Supports 'cartesian' (x,y -> r,theta) or 'polar' (r,theta -> x,y) interpretation.\n    \"\"\"\n\n    class Coordinate:\n        \"\"\"Abstract base class for coordinate systems.\"\"\"\n        def toPolar(self) -> Tuple[float, float]:\n            raise NotImplementedError\n        def toRectangular(self) -> 'RectangularCoordinate':\n            raise NotImplementedError\n\n    class RectangularCoordinate(Coordinate):\n        \"\"\"Represents coordinates in rectangular (Cartesian) form.\"\"\"\n        def __init__(self, x: float, y: float) -> None:\n            self.x = float(x)\n            self.y = float(y)\n\n        def toPolar(self) -> Tuple[float, float]:\n            \"\"\"Converts rectangular coordinates to polar (r, theta).\"\"\"\n            r = math.sqrt(self.x*self.x + self.y*self.y)\n            theta = math.atan2(self.y, self.x)\n            return (r, theta)\n\n        def toRectangular(self) -> 'RectangularCoordinate':\n            \"\"\"Returns itself as it is already rectangular.\"\"\"\n            return self\n\n    class PolarCoordinate(Coordinate):\n        \"\"\"Represents coordinates in polar (r, theta) form.\"\"\"\n        def __init__(self, r: float, theta: float) -> None:\n            self.r = float(r)\n            self.theta = float(theta)\n\n        def toPolar(self) -> Tuple[float, float]:\n            \"\"\"Returns itself as it is already polar.\"\"\"\n            return (self.r, self.theta)\n\n        def toRectangular(self) -> RectangularCoordinate:\n            \"\"\"Converts polar coordinates to rectangular (x, y).\"\"\"\n            x = self.r * math.cos(self.theta)\n            y = self.r * math.sin(self.theta)\n            return RectangularCoordinate(x, y)\n\n    class Converter:\n        \"\"\"Handles validation and orchestration of coordinate conversions.\"\"\"\n        def validate_input(self, a: object, b: object) -> bool:\n            \"\"\"Checks if inputs are valid numbers (int or float, finite).\"\"\"\n            if not isinstance(a, (int, float)) or not isinstance(b, (int, float)):\n                raise TypeError(\"Inputs 'a' and 'b' must be numeric (int or float).\")\n            if not math.isfinite(a) or not math.isfinite(b):\n                raise ValueError(\"Inputs 'a' and 'b' must be finite numbers (not NaN or Inf).\")\n            return True\n\n        def to_complex(self, rc: RectangularCoordinate) -> complex:\n            \"\"\"Converts a RectangularCoordinate object to a complex number.\"\"\"\n            return complex(rc.x, rc.y)\n\n        def polar_rect(self, a: float, b: float, interpretation: str, tolerance: float = DEFAULT_TOLERANCE) -> Tuple[Tuple[float, float], complex]:\n            \"\"\"Performs coordinate conversion based on interpretation.\"\"\"\n            self.validate_input(a, b)\n\n            if interpretation not in ('cartesian', 'polar'):\n                raise ValueError(f\"Interpretation must be 'cartesian' or 'polar', got '{interpretation}'.\")\n\n            if interpretation == 'cartesian':\n                rc = RectangularCoordinate(a, b)\n                polar_tuple = rc.toPolar()\n                rectangular_complex = self.to_complex(rc)\n                return (polar_tuple, rectangular_complex)\n            else:  # interpretation == 'polar'\n                if a < 0:\n                    raise ValueError(\"Polar 'r' (first argument) cannot be negative.\")\n                pc = PolarCoordinate(a, b)\n                rc = pc.toRectangular()\n                polar_tuple = (pc.r, pc.theta)\n                rectangular_complex = self.to_complex(rc)\n                return (polar_tuple, rectangular_complex)\n\n    converter = Converter()\n    return converter.polar_rect(a, b, interpretation, tolerance)"}
{"task_id": "Mbpp/597", "solution": "def find_kth(arr1: list, arr2: list, k: int):\n    \"\"\"\n    Finds the k-th smallest element from two sorted arrays using a merge-pointer approach.\n    Raises IndexError if k is out of bounds.\n    \"\"\"\n    n1 = len(arr1)\n    n2 = len(arr2)\n    total_len = n1 + n2\n\n    if k < 1 or k > total_len:\n        raise IndexError(\"k is out of bounds\")\n\n    p1 = 0  # Pointer for arr1\n    p2 = 0  # Pointer for arr2\n    \n    # Iterate k times to find the k-th element\n    for _ in range(k):\n        # Choose from arr1 if arr2 is exhausted OR arr1 has elements AND arr1[p1] is smaller or equal\n        if p1 < n1 and (p2 >= n2 or arr1[p1] <= arr2[p2]):\n            result = arr1[p1]\n            p1 += 1\n        # Otherwise, choose from arr2\n        else:\n            result = arr2[p2]\n            p2 += 1\n            \n    return result"}
{"task_id": "Mbpp/598", "solution": "def armstrong_number(n: int) -> bool:\n    \"\"\"Checks if a given number is an Armstrong number.\"\"\"\n\n    def calculate_digit_power_sum(num: int) -> int:\n        \"\"\"Calculates the sum of each digit raised to the power of the total number of digits.\"\"\"\n        s_num = str(num)\n        num_digits = len(s_num)\n        digit_power_sum = 0\n        for digit_char in s_num:\n            digit = int(digit_char)\n            digit_power_sum += digit ** num_digits\n        return digit_power_sum\n\n    return n == calculate_digit_power_sum(n)"}
{"task_id": "Mbpp/599", "solution": "def sum_average(n: int) -> tuple[int, float]:\n    \"\"\"Validate n and return (sum, average) for integers 1..n.\n    Raises ValueError if n is not int or n < 1.\"\"\"\n\n    def _validate_n(num) -> None:\n        \"\"\"Raise ValueError if num is not int or num < 1.\"\"\"\n        if not isinstance(num, int) or num < 1:\n            raise ValueError(\"n must be an integer and n >= 1\")\n\n    def _compute_sum(num: int) -> int:\n        \"\"\"Return integer sum of 1..num using the arithmetic series formula.\"\"\"\n        return num * (num + 1) // 2\n\n    def _compute_average(total: int, num: int) -> float:\n        \"\"\"Return float(total) / num, ensuring a floating-point result.\"\"\"\n        return float(total) / num\n\n    _validate_n(n)\n    total_sum = _compute_sum(n)\n    avg = _compute_average(total_sum, n)\n\n    return (total_sum, avg)"}
{"task_id": "Mbpp/600", "solution": "def is_Even(value: int) -> bool:\n    \"\"\"Checks if the given integer is even.\"\"\"\n    return value % 2 == 0"}
{"task_id": "Mbpp/602", "solution": "def first_repeated_char(s: str) -> str | None:\n    \"\"\"SRS-specified API: accept exactly one string and return first repeated character or None.\"\"\"\n    from typing import Optional, Dict\n    from dataclasses import dataclass\n\n    @dataclass\n    class Character:\n        char: str\n        first_index: int\n        count: int\n\n        def __init__(self, char: str, first_index: int) -> None:\n            self.char = char\n            self.first_index = first_index\n            self.count = 1 # Initialize count to 1 for the first occurrence\n\n        def increment(self) -> None:\n            self.count += 1\n\n    char_tracker: Dict[str, Character] = {}\n    \n    for index, char in enumerate(s):\n        if char not in char_tracker:\n            char_tracker[char] = Character(char, index)\n        else:\n            char_tracker[char].increment()\n\n    earliest_repeated_char: Optional[Character] = None\n\n    for char_obj in char_tracker.values():\n        if char_obj.count > 1:\n            if earliest_repeated_char is None or char_obj.first_index < earliest_repeated_char.first_index:\n                earliest_repeated_char = char_obj\n    \n    if earliest_repeated_char:\n        return earliest_repeated_char.char\n    else:\n        return None"}
{"task_id": "Mbpp/605", "solution": "import math\n\ndef prime_num(n: int) -> bool:\n    \"\"\"Checks if an integer is a prime number using trial division.\"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    for i in range(3, math.isqrt(n) + 1, 2):\n        if n % i == 0:\n            return False\n    return True"}
{"task_id": "Mbpp/604", "solution": "def reverse_words(input: str) -> str:\n    \"\"\"Reverses the order of words separated by spaces in a given string.\n    This function splits the input string, reverses the list of words, and joins them back.\"\"\"\n\n    def _split_by_space(s: str) -> list:\n        \"\"\"Splits the string by ASCII space, producing empty tokens for multiple or leading/trailing spaces.\"\"\"\n        return s.split(' ')\n\n    def _reverse_list(items: list) -> list:\n        \"\"\"Returns a new list with elements in reverse order.\"\"\"\n        return items[::-1]\n\n    def _join_with_single_space(words: list) -> str:\n        \"\"\"Joins a list of words with a single ASCII space.\"\"\"\n        return ' '.join(words)\n\n    words = _split_by_space(input)\n    reversed_words = _reverse_list(words)\n    result = _join_with_single_space(reversed_words)\n    return result"}
{"task_id": "Mbpp/603", "solution": "class InputParameter:\n    \"\"\"Represents the input parameter and provides validation behavior.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n    def isValid(self) -> bool:\n        \"\"\"Returns True if the value is an integer.\"\"\"\n        return isinstance(self.value, int)\n\nclass LudicNumber:\n    \"\"\"Represents a single ludic number value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass ResultList:\n    \"\"\"Holds a list of ludic numbers and provides sorting functionality.\"\"\"\n    def __init__(self, numbers: list[int]):\n        self.numbers = numbers\n\n    def sort(self) -> None:\n        \"\"\"Sorts numbers in-place ascending and enforces uniqueness.\"\"\"\n        self.numbers = sorted(list(set(self.numbers)))\n\nclass LudicService:\n    \"\"\"Encapsulates validation and ludic-number generation.\"\"\"\n\n    def get_ludic(self, n: int) -> list[int]:\n        \"\"\"Returns a sorted list of unique ludic numbers up to n.\"\"\"\n        if n < 1:\n            return []\n\n        raw_ludic_numbers = self._generate_ludic(n)\n        result_list = ResultList(raw_ludic_numbers)\n        result_list.sort()\n        return result_list.numbers\n\n    def validate(self, n) -> bool:\n        \"\"\"Returns True if n is an integer.\"\"\"\n        param = InputParameter(n)\n        return param.isValid()\n\n    def _generate_ludic(self, n: int) -> list[int]:\n        \"\"\"Generates raw ludic numbers up to n based on the problem's example.\"\"\"\n        if n < 1:\n            return []\n\n        ludic_numbers = [1]\n\n        if n < 2:\n            return ludic_numbers\n\n        # Implements a sieve to find prime numbers (as required by the example)\n        is_prime = [True] * (n + 1)\n        is_prime[0] = is_prime[1] = False\n\n        p = 2\n        while p * p <= n:\n            if is_prime[p]:\n                for multiple in range(p * p, n + 1, p):\n                    is_prime[multiple] = False\n            p += 1\n\n        for num in range(2, n + 1):\n            if is_prime[num]:\n                ludic_numbers.append(num)\n\n        return ludic_numbers\n\ndef get_ludic(n) -> list[int]:\n    \"\"\"Returns all lucid numbers smaller than or equal to a given integer n.\"\"\"\n    service = LudicService()\n    if not service.validate(n):\n        raise TypeError(\"n must be an integer\")\n    return service.get_ludic(n)"}
