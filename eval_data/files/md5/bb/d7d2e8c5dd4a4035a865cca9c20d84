{"task_id": "Mbpp/607", "solution": "from dataclasses import dataclass\nimport re\nfrom typing import Tuple\n\n@dataclass(frozen=True)\nclass _MatchResult:\n    substring: str\n    start: int\n    end: int\n\n    def as_tuple(self) -> Tuple[str, int, int]:\n        return (self.substring, self.start, self.end)\n\ndef find_literals(text: str, pattern: str) -> Tuple[str, int, int]:\n    \"\"\"Search `text` for the first substring matching `pattern` interpreted as a regular expression.\n    Returns a tuple (substring, start_index, end_index) where indices are 0-based and end_index is exclusive.\n    \"\"\"\n    compiled = re.compile(pattern)\n    m = compiled.search(text)\n    if m:\n        r = _MatchResult(m.group(0), m.start(), m.end())\n        return r.as_tuple()\n    raise RuntimeError('No match behavior unspecified by SRS')"}
{"task_id": "Mbpp/608", "solution": "def compute_bell_row(n: int) -> list:\n    \"\"\"\n    Computes Bell numbers up to n using the Bell triangle dynamic programming method.\n    Returns a list where the i-th element is the i-th Bell number B(i).\n    \"\"\"\n    bell_numbers = [0] * (n + 1)\n    if n == 0:\n        return [1]\n\n    bell_numbers[0] = 1\n\n    # dp_row stores T(k, j) for the current k.\n    # T(k,j) = T(k,j-1) + T(k-1,j-1), with T(k,0) = T(k-1,k-1).\n    dp_row = [0] * (n + 1)\n    dp_row[0] = 1 # Initialize T(0,0) = 1\n\n    for k in range(1, n + 1):\n        # new_first_element stores T(k-1, k-1) which becomes T(k,0).\n        new_first_element = dp_row[k-1]\n\n        # temp_prev_from_old_row tracks T(k-1, j-1) as j iterates.\n        temp_prev_from_old_row = dp_row[0] # Initial T(k-1,0)\n        dp_row[0] = new_first_element # Set T(k,0)\n\n        for j in range(1, k + 1):\n            old_val_at_j = dp_row[j] # This is T(k-1, j)\n            dp_row[j] = dp_row[j-1] + temp_prev_from_old_row\n            temp_prev_from_old_row = old_val_at_j\n            \n        bell_numbers[k] = dp_row[0] # B(k) is T(k,0)\n\n    return bell_numbers\n\ndef bell_Number(n: int) -> int:\n    \"\"\"\n    Finds the nth Bell number.\n    It counts the number of partitions of a set with n elements.\n    \"\"\"\n    # Assuming n is a non-negative integer as per direct requirement \"Do NOT add isinstance() checks or raise exceptions\".\n    \n    computed_bells = compute_bell_row(n)\n    return computed_bells[n]"}
{"task_id": "Mbpp/610", "solution": "def remove_kth_element(input_list, k):\n    \"\"\"\n    Removes the k'th element (1-based index) from the input list and returns a new list.\n    Preserves order and treats duplicates as distinct positions; behavior for out-of-range k is to return a copy of the original list.\n    \"\"\"\n    target_index = k - 1\n    new_list = []\n    for i, item in enumerate(input_list):\n        if i != target_index:\n            new_list.append(item)\n    return new_list"}
{"task_id": "Mbpp/614", "solution": "def cummulative_sum(tuple_list):\n    \"\"\"\n    Accepts a list of tuples and returns the numeric sum of all numeric elements.\n    Raises TypeError if input is not a list of tuples of numeric values.\n    \"\"\"\n    if not isinstance(tuple_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    total = 0\n    for sub_tuple in tuple_list:\n        if not isinstance(sub_tuple, tuple):\n            raise TypeError(\"All elements in the input list must be tuples.\")\n        for item in sub_tuple:\n            if not isinstance(item, (int, float)):\n                raise TypeError(\"All elements within tuples must be numeric (int or float).\")\n            total += item\n    return total"}
{"task_id": "Mbpp/611", "solution": "def max_of_nth(matrix: list[list[object]], n: int) -> object:\n    \"\"\"\n    Computes the maximum value in the n-th column of matrix.\n    Assumes matrix is a list-of-lists and each row contains an element at index n.\n    \"\"\"\n    max_val = matrix[0][n]\n    for i in range(1, len(matrix)):\n        current_val = matrix[i][n]\n        if current_val > max_val:\n            max_val = current_val\n    return max_val"}
{"task_id": "Mbpp/612", "solution": "def _validate_input(input_list):\n    \"\"\"Module-private: raises ValueError if input is not valid per SRS (any sublist length != 2).\"\"\"\n    for sublist in input_list:\n        if len(sublist) != 2:\n            raise ValueError(\"Each sublist must contain exactly two elements.\")\n\ndef _extract_elements(input_list):\n    \"\"\"Module-private: returns (first_list, second_list) extracted in input order.\"\"\"\n    first_elements_list = []\n    second_elements_list = []\n    for sublist in input_list:\n        first_elements_list.append(sublist[0])\n        second_elements_list.append(sublist[1])\n    return (first_elements_list, second_elements_list)\n\ndef merge(input_list):\n    \"\"\"Public API. Accepts a list of sublists (each of length 2) and returns [first_list, second_list].\n    Raises ValueError if any sublist length != 2.\n    \"\"\"\n    _validate_input(input_list)\n    first_list, second_list = _extract_elements(input_list)\n    return [first_list, second_list]"}
{"task_id": "Mbpp/615", "solution": "def _validate_input(input: tuple) -> None:\n    \"\"\"\n    This helper is designed to validate input structure and types.\n    Per strict requirements, explicit checks and exception raising are omitted.\n    \"\"\"\n    pass\n\ndef _compute_average(inner: tuple) -> float:\n    \"\"\"\n    This helper computes the arithmetic mean for a given tuple of numbers.\n    It assumes the input tuple is non-empty and contains only numeric elements.\n    \"\"\"\n    return float(sum(inner) / len(inner))\n\ndef average_tuple(input: tuple) -> list:\n    \"\"\"\n    Computes the average for each inner tuple in the input.\n    This function processes a tuple of tuples, returning a list of averages.\n    \"\"\"\n    _validate_input(input)\n    result_averages = []\n    for inner_tuple in input:\n        average = _compute_average(inner_tuple)\n        result_averages.append(average)\n    return result_averages"}
{"task_id": "Mbpp/616", "solution": "class LengthValidator:\n    \"\"\"Validates that two tuples have identical lengths, raising ValueError if not.\"\"\"\n    def validate(self, a: tuple, b: tuple) -> bool:\n        if len(a) != len(b):\n            raise ValueError(\"Input tuples must have the same length\")\n        return True\n\nclass ZeroDivValidator:\n    \"\"\"Validates that no element of the second tuple is zero, raising ZeroDivisionError if found.\"\"\"\n    def validate(self, b: tuple) -> bool:\n        if any(element == 0 for element in b):\n            raise ZeroDivisionError(\"Divisor tuple contains zero\")\n        return True\n\ndef compute_elementwise_mod(a: tuple, b: tuple) -> tuple:\n    \"\"\"Computes element-wise modulo results a[i] % b[i] and returns a tuple of results.\"\"\"\n    return tuple(a[i] % b[i] for i in range(len(a)))\n\ndef tuple_modulo(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise modulo operation on two tuples of the same length.\n    Raises ValueError if lengths differ, or ZeroDivisionError if any divisor is zero.\n    \"\"\"\n    LengthValidator().validate(a, b)\n    ZeroDivValidator().validate(b)\n    return compute_elementwise_mod(a, b)"}
{"task_id": "Mbpp/619", "solution": "def move_num(s: str) -> str:\n    \"\"\"\n    Moves all contiguous number sequences to the end of the given string, preserving relative order.\n    Non-digit characters maintain their relative order, followed by the concatenated digit sequences.\n    \"\"\"\n    non_digit_parts = []\n    digit_sequences = []\n    current_digit_segment = []\n\n    for char in s:\n        if '0' <= char <= '9':\n            current_digit_segment.append(char)\n        else:\n            if current_digit_segment:\n                digit_sequences.append(\"\".join(current_digit_segment))\n                current_digit_segment = []\n            non_digit_parts.append(char)\n\n    # Append any remaining digit segment after the loop\n    if current_digit_segment:\n        digit_sequences.append(\"\".join(current_digit_segment))\n\n    return \"\".join(non_digit_parts) + \"\".join(digit_sequences)"}
{"task_id": "Mbpp/618", "solution": "class Validator:\n    \"\"\"Stateless validation helper centralizing all checks.\"\"\"\n\n    @staticmethod\n    def validate_types(a: list, b: list) -> None:\n        \"\"\"Raises TypeError if inputs are not lists or contain non-numeric elements.\"\"\"\n        if not isinstance(a, list):\n            raise TypeError(\"Input 'a' must be a list.\")\n        if not isinstance(b, list):\n            raise TypeError(\"Input 'b' must be a list.\")\n\n        for i, x in enumerate(a):\n            if not isinstance(x, (int, float)):\n                raise TypeError(f\"Element at index {i} in list 'a' is not numeric (int or float).\")\n        for i, x in enumerate(b):\n            if not isinstance(x, (int, float)):\n                raise TypeError(f\"Element at index {i} in list 'b' is not numeric (int or float).\")\n\n    @staticmethod\n    def validate_lengths(a: list, b: list) -> None:\n        \"\"\"Raises ValueError if input lists have differing lengths.\"\"\"\n        if len(a) != len(b):\n            raise ValueError(\"Input lists 'a' and 'b' must have the same length.\")\n\n    @staticmethod\n    def validate_no_zero_denominator(b: list) -> None:\n        \"\"\"Raises ZeroDivisionError if any element of b is zero.\"\"\"\n        for i, x in enumerate(b):\n            if x == 0:\n                raise ZeroDivisionError(f\"Denominator at index {i} in list 'b' is zero.\")\n\n\ndef div_list(a: list, b: list) -> list:\n    \"\"\"\n    Public API: Performs validation and returns element-wise division results as list[float].\n    \"\"\"\n    Validator.validate_types(a, b)\n    Validator.validate_lengths(a, b)\n    Validator.validate_no_zero_denominator(b)\n    return [float(a[i] / b[i]) for i in range(len(a))]"}
{"task_id": "Mbpp/620", "solution": "def largest_subset(numbers: list[int]) -> int:\n    \"\"\"Finds the size of the largest subset where every pair of numbers is divisible by each other.\n    It uses a dynamic programming approach after sorting the input numbers.\"\"\"\n\n    def _divisible(a: int, b: int) -> bool:\n        # Checks if a is divisible by b or b is divisible by a.\n        # Handles zero divisors gracefully to prevent ZeroDivisionError.\n        if b == 0:\n            return a == 0\n        if a == 0:\n            return True\n        return a % b == 0 or b % a == 0\n\n    if not numbers:\n        return 0\n\n    # Sort the numbers to enable dynamic programming.\n    # This helps build divisible chains by considering numbers in a specific order.\n    numbers.sort()\n\n    n = len(numbers)\n    # dp[i] stores the size of the largest divisible subset ending with numbers[i].\n    dp = [1] * n\n\n    max_size = 0\n\n    for i in range(n):\n        for j in range(i):\n            if _divisible(numbers[i], numbers[j]):\n                dp[i] = max(dp[i], dp[j] + 1)\n        max_size = max(max_size, dp[i])\n\n    return max_size"}
{"task_id": "Mbpp/623", "solution": "def nth_nums(input_list, n):\n    from typing import Union, Sequence, List, Any\n\n    def is_numeric(value: Any) -> bool:\n        \"\"\"Checks if a value is an integer or a float.\"\"\"\n        return isinstance(value, (int, float))\n\n    class Validator:\n        \"\"\"Validates inputs according to specified business rules.\"\"\"\n        @staticmethod\n        def validate_args(input_list: Any, n: Any) -> None:\n            \"\"\"Validates the input list and exponent, raising TypeError on invalid inputs.\"\"\"\n            if not isinstance(input_list, (list, tuple)):\n                raise TypeError(\"Input list must be a sequence (list or tuple).\")\n            if not isinstance(n, int):\n                raise TypeError(\"Exponent 'n' must be an integer.\")\n            for i, item in enumerate(input_list):\n                if not is_numeric(item):\n                    raise TypeError(f\"Element at index {i} in the input list must be numeric (int or float), but got {type(item).__name__}.\")\n\n    class Number:\n        \"\"\"Represents a numeric value with its original index.\"\"\"\n        def __init__(self, value: Union[int, float], index: int) -> None:\n            self.value = value\n            self.index = index\n\n        def to_primitive(self) -> Union[int, float]:\n            \"\"\"Returns the primitive numeric value.\"\"\"\n            return self.value\n\n    class NumberList:\n        \"\"\"A collection of Number objects, preserving order.\"\"\"\n        def __init__(self, values: Sequence[Union[int, float]]) -> None:\n            self.items = [Number(value, i) for i, value in enumerate(values)]\n\n        def length(self) -> int:\n            \"\"\"Returns the number of elements in the list.\"\"\"\n            return len(self.items)\n\n        def get(self, index: int) -> Number:\n            \"\"\"Retrieves a Number object by its index.\"\"\"\n            return self.items[index]\n\n    class PowerOperation:\n        \"\"\"Encapsulates the exponentiation logic.\"\"\"\n        def __init__(self, exponent: int) -> None:\n            self.exponent = exponent\n\n        def apply(self, value: Union[int, float]) -> Union[int, float]:\n            \"\"\"Applies the exponentiation to a given value.\"\"\"\n            return value ** self.exponent\n\n    # Orchestrate validation, domain construction, and power application.\n    Validator.validate_args(input_list, n)\n\n    if not input_list:\n        return []\n\n    number_list = NumberList(input_list)\n    power_op = PowerOperation(n)\n    \n    result_list = []\n    for i in range(number_list.length()):\n        num_obj = number_list.get(i)\n        computed_value = power_op.apply(num_obj.to_primitive())\n        result_list.append(computed_value)\n\n    return result_list"}
