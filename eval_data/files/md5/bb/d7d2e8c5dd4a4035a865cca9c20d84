{"task_id": "Mbpp/256", "solution": "def _is_valid_input(n) -> bool:\n    \"\"\"Checks if the input n is a non-negative numeric type.\"\"\"\n    if not isinstance(n, (int, float)):\n        return False\n    return n >= 0\n\ndef _count_primes_sieve(limit: int) -> int:\n    \"\"\"\n    Counts prime numbers strictly less than 'limit' using the Sieve of Eratosthenes.\n    Returns 0 if limit is 2 or less, as no primes are strictly less than these values.\n    \"\"\"\n    if limit <= 2:\n        return 0\n\n    is_prime = [True] * limit\n    is_prime[0] = is_prime[1] = False\n\n    for p in range(2, int(limit**0.5) + 1):\n        if is_prime[p]:\n            for multiple in range(p * p, limit, p):\n                is_prime[multiple] = False\n\n    count = 0\n    for i in range(2, limit):\n        if is_prime[i]:\n            count += 1\n    return count\n\ndef count_Primes_nums(n):\n    \"\"\"\n    Counts the number of prime numbers strictly less than a given non-negative number n.\n    Raises ValueError if n is negative or not a numeric type.\n    \"\"\"\n    if not _is_valid_input(n):\n        raise ValueError(\"Input must be a non-negative number.\")\n\n    limit_for_sieve = int(n)\n\n    return _count_primes_sieve(limit_for_sieve)"}
{"task_id": "Mbpp/259", "solution": "def maximize_elements(\n    input1: Tuple[Tuple[int, int], ...],\n    input2: Tuple[Tuple[int, int], ...]\n) -> Tuple[Tuple[int, int], ...]:\n    \"\"\"\n    Validate that len(input1) == len(input2). If not, raise ValidationError.\n    Compute element-wise maxima for first and second elements of each pair and return an immutable tuple of two-element tuples.\n    \"\"\"\n    if len(input1) != len(input2):\n        # ValidationError is expected to be imported from src.errors as per design context.\n        class ValidationError(Exception): # Define ValidationError inline to satisfy \"Do NOT call any helper that is not defined inline\".\n            def __init__(self, message: str) -> None:\n                super().__init__(message)\n                self.message = message\n        raise ValidationError(\"input sequences must have equal length\")\n\n    result_list = []\n    for pair1, pair2 in zip(input1, input2):\n        max_first = max(pair1[0], pair2[0])\n        max_second = max(pair1[1], pair2[1])\n        result_list.append((max_first, max_second))\n\n    return tuple(result_list)"}
{"task_id": "Mbpp/262", "solution": "def split_two_parts(input_list, L):\n    \"\"\"\n    Splits a list into two parts based on the specified length L for the first part.\n    Raises TypeError or ValueError for invalid inputs.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"input_list must be a list\")\n    if not isinstance(L, int):\n        raise TypeError(\"L must be an integer\")\n    if L < 0 or L > len(input_list):\n        raise ValueError(\"L out of range\")\n\n    first_list = list(input_list[0:L])\n    second_list = list(input_list[L:])\n    return (first_list, second_list)"}
{"task_id": "Mbpp/264", "solution": "def dog_age(human_years):\n    \"\"\"Compute and return dog's age in dog years.\n\n    Uses a specific conversion rule for human_years <= 2 and otherwise.\n    \"\"\"\n    if human_years <= 2:\n        return human_years * 10.5\n    else:\n        return 21 + (human_years - 2) * 4"}
{"task_id": "Mbpp/261", "solution": "class ValidationException(Exception):\n    \"\"\"Base exception for validation errors.\"\"\"\n    pass\n\nclass TypeValidationException(ValidationException):\n    \"\"\"Raised when inputs are not tuples.\"\"\"\n    pass\n\nclass LengthMismatchException(ValidationException):\n    \"\"\"Raised when tuple lengths differ.\"\"\"\n    pass\n\nclass ElementTypeException(ValidationException):\n    \"\"\"Raised when any element is non-numeric.\"\"\"\n    pass\n\nclass DivisionByZeroException(ValidationException):\n    \"\"\"Raised when a divisor in the second tuple is zero.\"\"\"\n    pass\n\ndef validateInputs(a, b) -> None:\n    \"\"\"Ensures both inputs are tuple instances.\"\"\"\n    if not isinstance(a, tuple) or not isinstance(b, tuple):\n        raise TypeValidationException(\"Both inputs must be tuples.\")\n\ndef validateLengths(a, b) -> None:\n    \"\"\"Ensures both input tuples have the same length.\"\"\"\n    if len(a) != len(b):\n        raise LengthMismatchException(\"Input tuples must have the same length.\")\n\ndef validateElementsNumeric(a, b) -> None:\n    \"\"\"Ensures all elements in both tuples are numeric (int or float).\"\"\"\n    for val_a, val_b in zip(a, b):\n        if not isinstance(val_a, (int, float)) or not isinstance(val_b, (int, float)):\n            raise ElementTypeException(\"All tuple elements must be numeric (int or float).\")\n\ndef checkZeroDivisors(b) -> None:\n    \"\"\"Ensures no element in the second tuple is zero.\"\"\"\n    for val_b in b:\n        if val_b == 0:\n            raise DivisionByZeroException(\"Division by zero is not allowed.\")\n\ndef computeElementWiseDivision(a, b) -> tuple:\n    \"\"\"Performs element-wise division and returns the result as a tuple.\"\"\"\n    return tuple(val_a / val_b for val_a, val_b in zip(a, b))\n\ndef division_elements(tuple_a, tuple_b) -> tuple:\n    \"\"\"\n    Performs mathematical division operation element-wise across two given tuples.\n    Validates inputs and handles potential errors like type mismatches, length differences, non-numeric elements, and division by zero.\n    \"\"\"\n    validateInputs(tuple_a, tuple_b)\n    validateLengths(tuple_a, tuple_b)\n    validateElementsNumeric(tuple_a, tuple_b)\n    checkZeroDivisors(tuple_b)\n    return computeElementWiseDivision(tuple_a, tuple_b)"}
{"task_id": "Mbpp/260", "solution": "import math\n\nclass InputValidator:\n    \"\"\"Validates that input n is an integer and n >= 1.\"\"\"\n    def validate_n(self, n: int) -> None:\n        \"\"\"Raises TypeError for non-integer types or ValueError for n < 1.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n        if n < 1:\n            raise ValueError(\"Input 'n' must be greater than or equal to 1.\")\n\nclass NewmanShanksWilliamsSequence:\n    \"\"\"Produces NSW sequence terms per recurrence S(n)=2*S(n-1)+S(n-2) and caches them.\"\"\"\n    def __init__(self):\n        self._terms: list[int] = [1, 1]  # S(0) and S(1)\n\n    def generate_next(self) -> int:\n        \"\"\"Computes the next term in the NSW sequence and appends it to the cache.\"\"\"\n        n_minus_1_val = self._terms[-1]\n        n_minus_2_val = self._terms[-2]\n        next_val = 2 * n_minus_1_val + n_minus_2_val\n        self._terms.append(next_val)\n        return next_val\n\n    def get_term(self, index: int) -> int:\n        \"\"\"Returns the NSW term at the given index, generating terms as needed.\"\"\"\n        while len(self._terms) <= index:\n            self.generate_next()\n        return self._terms[index]\n\nclass PrimeTester:\n    \"\"\"Determines whether a given integer is prime using a trial division algorithm.\"\"\"\n    def __init__(self, algorithm: str = 'default'):\n        # The algorithm parameter is for design compliance; current implementation uses trial division.\n        self._algorithm = algorithm\n\n    def is_prime(self, number: int) -> bool:\n        \"\"\"Checks if a number is prime using trial division up to its square root.\"\"\"\n        if number < 2:\n            return False\n        if number == 2:\n            return True\n        if number % 2 == 0:\n            return False\n        \n        # Check for odd divisors from 3 up to the integer square root of the number.\n        limit = int(number**0.5) + 1\n        for i in range(3, limit, 2):\n            if number % i == 0:\n                return False\n        return True\n\nclass NewmanPrimeService:\n    \"\"\"Coordinates validation, sequence generation, and primality testing to find the nth NSW prime.\"\"\"\n    def __init__(self, sequence: NewmanShanksWilliamsSequence, prime_tester: PrimeTester, validator: InputValidator):\n        self._sequence = sequence\n        self._prime_tester = prime_tester\n        self._validator = validator\n\n    def newman_prime(self, n: int) -> int:\n        \"\"\"Locates and returns the nth Newman-Shanks-Williams prime number.\"\"\"\n        self._validator.validate_n(n)\n\n        prime_count = 0\n        current_nsw_index = 0\n        while True:\n            nsw_value = self._sequence.get_term(current_nsw_index)\n            if self._prime_tester.is_prime(nsw_value):\n                prime_count += 1\n                if prime_count == n:\n                    return nsw_value\n            current_nsw_index += 1\n\ndef newman_prime(n: int) -> int:\n    \"\"\"\n    Finds the nth Newman\u2013Shanks\u2013Williams prime number.\n    The sequence is defined by S(0)=1, S(1)=1, S(n)=2*S(n-1)+S(n-2).\n    \"\"\"\n    validator = InputValidator()\n    sequence = NewmanShanksWilliamsSequence()\n    prime_tester = PrimeTester()\n    service = NewmanPrimeService(sequence, prime_tester, validator)\n    return service.newman_prime(n)"}
{"task_id": "Mbpp/266", "solution": "def lateralsurface_cube(side: float) -> float:\n    \"\"\"\n    Calculates the lateral surface area of a cube given its side length.\n    Raises ValueError if the side is not numeric or is negative.\n    \"\"\"\n    if not isinstance(side, (int, float)) or side < 0:\n        raise ValueError(\"Invalid input: side must be numeric and non-negative\")\n\n    # Lateral surface area of a cube is 4 * side * side\n    lateral_surface_area = 4 * side * side\n    return float(lateral_surface_area)"}
{"task_id": "Mbpp/265", "solution": "class InvalidNException(Exception):\n    \"\"\"Exception raised when n is not a positive integer.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\ndef list_split(input_list, n):\n    \"\"\"\n    Splits a list into n sublists, distributing elements cyclically.\n    Elements at index k are placed into sublist k % n, preserving relative order within sublists.\n    \"\"\"\n    if n < 1:\n        raise InvalidNException('n must be a positive integer')\n\n    result = [[] for _ in range(n)]\n    for k, element in enumerate(input_list):\n        result[k % n].append(element)\n    return result"}
{"task_id": "Mbpp/267", "solution": "from typing import List\n\nclass Parameter:\n    \"\"\"Lightweight container for the input parameter value.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value: int = value\n\nclass OddNumber:\n    \"\"\"Represent a single odd natural number.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value: int = value\n\nclass Sequence:\n    \"\"\"Generate the first n odd natural numbers.\"\"\"\n    def __init__(self) -> None:\n        self.numbers: List[int] = []\n\n    def generate(self, n: int) -> List[int]:\n        \"\"\"Returns a list of the first n odd natural numbers.\"\"\"\n        generated_numbers = []\n        for k in range(1, n + 1):\n            odd_num = 2 * k - 1\n            generated_numbers.append(odd_num)\n        self.numbers = generated_numbers\n        return generated_numbers\n\nclass CalculationResult:\n    \"\"\"Container for the integer result.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value: int = value\n\nclass TestCase:\n    \"\"\"Encapsulate a test assertion and provide run() to execute it.\"\"\"\n    def __init__(self, assertion: str) -> None:\n        self.assertion: str = assertion\n\n    def run(self) -> bool:\n        \"\"\"Placeholder for running the test assertion.\"\"\"\n        # This class is for domain modeling completeness; actual test logic is external.\n        return True\n\ndef square_Sum(n):\n    \"\"\"Compute sum of squares of first n odd natural numbers and return int.\"\"\"\n    sequence_generator = Sequence()\n    odd_numbers = sequence_generator.generate(n)\n\n    total_sum = 0\n    for num in odd_numbers:\n        total_sum += num ** 2\n\n    result = CalculationResult(total_sum)\n    return result.value"}
{"task_id": "Mbpp/268", "solution": "def find_star_num(n) -> int:\n    \"\"\"\n    Validate n and return the n-th star number as integer.\n    Raises ValueError if n is not a positive integer.\n    \"\"\"\n\n    class InputValidator:\n        def is_positive_integer(self, n) -> bool:\n            return isinstance(n, int) and n >= 1\n\n    class StarNumberCalculator:\n        def find_star_num(self, n) -> int:\n            return self.compute_star_number(n)\n\n        def compute_star_number(self, n) -> int:\n            return 6 * n * (n - 1) + 1\n\n    validator = InputValidator()\n    if not validator.is_positive_integer(n):\n        raise ValueError(\"n must be a positive integer\")\n\n    calculator = StarNumberCalculator()\n    value = calculator.find_star_num(n)\n    return value"}
{"task_id": "Mbpp/269", "solution": "def ascii_value(c: str) -> int:\n    \"\"\"Provides ascii_value(c: str) -> int as specified in the SRS. Raises ValueError for invalid input per FR4.\"\"\"\n    if not isinstance(c, str):\n        raise ValueError(\"input must be a single character string\")\n    if len(c) != 1:\n        raise ValueError(\"input must be a single character\")\n    code = ord(c)\n    if code > 127:\n        raise ValueError(\"input character is not ASCII\")\n    return code"}
{"task_id": "Mbpp/270", "solution": "def sum_even_and_even_index(input_list: list[int]) -> int:\n    \"\"\"\n    Calculates the sum of even numbers at even positions in a list of integers.\n    Raises TypeError if the input is not a list or contains non-integer elements.\n    \"\"\"\n    class InputList:\n        def __init__(self, values: list) -> None:\n            self.values = values\n\n        def validate(self) -> bool:\n            if not isinstance(self.values, list):\n                return False\n            for item in self.values:\n                if not isinstance(item, int):\n                    return False\n            return True\n\n    class IntegerElement:\n        def __init__(self, value: int, index: int) -> None:\n            self.value = value\n            self.index = index\n\n        def isEven(self) -> bool:\n            return self.value % 2 == 0\n\n    class SumResult:\n        def __init__(self, total: int = 0) -> None:\n            self.total = total\n\n        def add(self, v: int) -> None:\n            self.total += v\n\n    input_validator = InputList(input_list)\n    if not input_validator.validate():\n        raise TypeError(\"Input must be a list of integers.\")\n\n    result_accumulator = SumResult(0)\n    for index, value in enumerate(input_validator.values):\n        element = IntegerElement(value, index)\n        if index % 2 == 0 and element.isEven():\n            result_accumulator.add(value)\n\n    return result_accumulator.total"}
{"task_id": "Mbpp/271", "solution": "def _validate_input(n):\n    \"\"\"Raise TypeError if n is not int; raise ValueError if n < 0.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError('n must be int')\n    if n < 0:\n        raise ValueError('n must be >= 0')\n\ndef even_Power_Sum(n: int) -> int:\n    \"\"\"\n    Validates n and computes the sum of the first n even natural numbers raised to the fifth power.\n    Raises TypeError for non-integer n or ValueError for negative n.\n    \"\"\"\n    _validate_input(n)\n    \n    total_sum = 0\n    for k in range(1, n + 1):\n        total_sum += (2 * k) ** 5\n    return total_sum"}
