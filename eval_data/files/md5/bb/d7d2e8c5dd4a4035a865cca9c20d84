{"task_id": "Mbpp/67", "solution": "def bell_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Bell number, which is the number of ways to partition a set of n elements.\n    Validates input and delegates computation to BellNumberCalculator.\n    \"\"\"\n\n    class InvalidInputException(Exception):\n        \"\"\"Exception raised for invalid input to the Bell number calculator.\"\"\"\n        def __init__(self, message=\"Invalid input: n must be a non-negative integer.\"):\n            self.message = message\n            super().__init__(self.message)\n\n    class InputParameter:\n        \"\"\"Encapsulates and validates the input parameter n.\"\"\"\n        def __init__(self, value):\n            self.value = value\n\n        def validate(self) -> bool:\n            \"\"\"Validates if the value is a non-negative integer.\"\"\"\n            return isinstance(self.value, int) and self.value >= 0\n\n    class BellNumberCalculator:\n        \"\"\"Calculates Bell numbers using the Bell triangle method.\"\"\"\n        def bell_number(self, n_val: int) -> int:\n            \"\"\"Public method to compute the Bell number for n.\"\"\"\n            return self.compute_using_triangle(n_val)\n\n        def compute_using_triangle(self, n_val: int) -> int:\n            \"\"\"\n            Computes the nth Bell number using the Bell triangle algorithm.\n            B_n is the number of partitions of a set of size n.\n            \"\"\"\n            if n_val == 0:\n                return 1\n\n            # Initialize a 2D list for the Bell triangle.\n            # triangle[i][0] will store B_i.\n            triangle = [[0] * (i + 1) for i in range(n_val + 1)]\n            triangle[0][0] = 1\n\n            for i in range(1, n_val + 1):\n                # The first element of each row is the last element of the previous row.\n                triangle[i][0] = triangle[i-1][i-1]\n                for j in range(1, i + 1):\n                    # Other elements are the sum of the element to their left in the current row\n                    # and the element above them in the previous row.\n                    triangle[i][j] = triangle[i][j-1] + triangle[i-1][j-1]\n\n            # The nth Bell number is the first element of the nth row.\n            return triangle[n_val][0]\n\n    param = InputParameter(n)\n    if not param.validate():\n        raise InvalidInputException(\"n must be a non-negative integer\")\n\n    calculator = BellNumberCalculator()\n    return calculator.bell_number(n)"}
{"task_id": "Mbpp/68", "solution": "from typing import List, Any\n\nclass MonotonicChecker:\n    \"\"\"Encapsulates the logic for checking monotonicity of a sequence.\"\"\"\n\n    @staticmethod\n    def _check_non_decreasing(seq: List[Any]) -> bool:\n        \"\"\"Checks if the sequence is non-decreasing (each element <= next).\"\"\"\n        for i in range(len(seq) - 1):\n            if seq[i] > seq[i+1]:\n                return False\n        return True\n\n    @staticmethod\n    def _check_non_increasing(seq: List[Any]) -> bool:\n        \"\"\"Checks if the sequence is non-increasing (each element >= next).\"\"\"\n        for i in range(len(seq) - 1):\n            if seq[i] < seq[i+1]:\n                return False\n        return True\n\ndef is_Monotonic(array: List[Any]) -> bool:\n    \"\"\"Checks if the given array is monotonic, meaning it is entirely non-decreasing or entirely non-increasing.\"\"\"\n    if len(array) <= 1:\n        return True\n\n    # Uses MonotonicChecker to evaluate monotonicity by calling its internal checks.\n    return MonotonicChecker._check_non_decreasing(array) or MonotonicChecker._check_non_increasing(array)"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(source_list, sublist) -> bool:\n    \"\"\"Checks if a list contains the given sublist as a contiguous sequence.\"\"\"\n    n = len(source_list)\n    m = len(sublist)\n\n    if m == 0:\n        return True\n    if m > n:\n        return False\n\n    for i in range(n - m + 1):\n        if source_list[i : i + m] == sublist:\n            return True\n            \n    return False"}
{"task_id": "Mbpp/71", "solution": "def comb_sort(list):\n    \"\"\"Sorts a list of elements using the comb sort algorithm.\n\n    The algorithm uses a gap shrink factor of 1.3 and terminates when the gap is 1 and no swaps occur during a pass.\n    Raises TypeError if elements are not mutually comparable.\n    \"\"\"\n    arr = list[:]  # Create a mutable copy of the input list\n    n = len(arr)\n\n    if n <= 1:\n        return arr\n\n    gap = n\n    shrink_factor = 1.3\n    swapped = True\n\n    while gap > 1 or swapped:\n        # Calculate new gap\n        gap = int(gap / shrink_factor)\n        if gap < 1:\n            gap = 1\n\n        swapped = False\n        \n        # Compare all elements with current gap\n        for i in range(n - gap):\n            try:\n                if arr[i] > arr[i + gap]:\n                    arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                    swapped = True\n            except TypeError:\n                raise TypeError(\"comb_sort: elements are not mutually comparable\")\n\n    return arr"}
{"task_id": "Mbpp/74", "solution": "import collections\nfrom typing import List, Dict, Optional, Iterable, Tuple\n\nclass Sequence:\n    \"\"\"Holds a sequence of elements.\"\"\"\n    def __init__(self, elements: List[str]) -> None:\n        self.elements = elements\n\n    def get_length(self) -> int:\n        \"\"\"Returns the length of the sequence.\"\"\"\n        return len(self.elements)\n\nclass Pattern:\n    \"\"\"Holds a pattern of tokens.\"\"\"\n    def __init__(self, tokens: List[str]) -> None:\n        self.tokens = tokens\n\n    def get_length(self) -> int:\n        \"\"\"Returns the length of the pattern.\"\"\"\n        return len(self.tokens)\n\nclass Mapping:\n    \"\"\"Manages the mapping from pattern tokens to sequence elements.\"\"\"\n    def __init__(self) -> None:\n        self.map: Dict[str, str] = {}\n\n    def add(self, pattern_token: str, sequence_element: str) -> None:\n        \"\"\"Adds a mapping from a pattern token to a sequence element.\"\"\"\n        self.map[pattern_token] = sequence_element\n\n    def get(self, pattern_token: str) -> Optional[str]:\n        \"\"\"Retrieves the sequence element mapped to a pattern token, or None.\"\"\"\n        return self.map.get(pattern_token)\n\n    def items(self) -> Iterable[Tuple[str, str]]:\n        \"\"\"Returns an iterable of (pattern_token, sequence_element) pairs.\"\"\"\n        return self.map.items()\n\nclass ComparisonResult:\n    \"\"\"Encapsulates the result of a pattern comparison.\"\"\"\n    def __init__(self, matches: bool, mapping: Mapping) -> None:\n        self.matches = matches\n        self.mapping = mapping\n\nclass PatternComparator:\n    \"\"\"Compares a sequence against a pattern based on structural equivalence.\"\"\"\n    def is_samepatterns(self, sequence: Sequence, pattern: Pattern) -> bool:\n        \"\"\"Determines if the sequence follows the pattern's structural rules.\"\"\"\n        if not self._validate_lengths(sequence, pattern):\n            return False\n\n        mapping = self._build_mapping(sequence, pattern)\n        if mapping is None:  # Inconsistent mapping detected during build\n            return False\n\n        return self._validate_equivalence(mapping, sequence, pattern)\n\n    def _validate_lengths(self, sequence: Sequence, pattern: Pattern) -> bool:\n        \"\"\"Checks if the sequence and pattern have the same length.\"\"\"\n        return sequence.get_length() == pattern.get_length()\n\n    def _build_mapping(self, sequence: Sequence, pattern: Pattern) -> Optional[Mapping]:\n        \"\"\"\n        Builds a consistent pattern-to-sequence mapping.\n        Returns None if a pattern token attempts to map to different sequence elements.\n        \"\"\"\n        mapping = Mapping()\n        length = sequence.get_length()\n\n        for i in range(length):\n            p_token = pattern.tokens[i]\n            s_element = sequence.elements[i]\n\n            existing_s_element = mapping.get(p_token)\n            if existing_s_element is None:\n                mapping.add(p_token, s_element)\n            elif existing_s_element != s_element:\n                # A pattern token maps to different sequence elements, indicating inconsistency.\n                return None\n        return mapping\n\n    def _validate_equivalence(self, mapping: Mapping, sequence: Sequence, pattern: Pattern) -> bool:\n        \"\"\"\n        Validates the 'iff' equivalence rule: sequence[i] == sequence[j] iff pattern[i] == pattern[j].\n        This ensures that identical sequence elements must map to identical pattern tokens,\n        and identical pattern tokens must map to identical sequence elements.\n        \"\"\"\n        length = sequence.get_length()\n        for i in range(length):\n            for j in range(length):\n                s_i = sequence.elements[i]\n                s_j = sequence.elements[j]\n                p_i = pattern.tokens[i]\n                p_j = pattern.tokens[j]\n\n                # Check (sequence[i] == sequence[j]) implies (pattern[i] == pattern[j])\n                if s_i == s_j and p_i != p_j:\n                    return False\n                \n                # Check (pattern[i] == pattern[j]) implies (sequence[i] == sequence[j])\n                # This is equivalent to checking: if s_i != s_j, then p_i != p_j\n                if s_i != s_j and p_i == p_j:\n                    return False\n        \n        return True\n\ndef is_samepatterns(sequence: List[str], pattern: List[str]) -> bool:\n    \"\"\"\n    Checks if a sequence structurally follows a given pattern.\n    The 'iff' equivalence rule is applied: sequence[i] == sequence[j] iff pattern[i] == pattern[j].\n    \"\"\"\n    domain_sequence = Sequence(sequence)\n    domain_pattern = Pattern(pattern)\n    \n    comparator = PatternComparator()\n    return comparator.is_samepatterns(domain_sequence, domain_pattern)"}
