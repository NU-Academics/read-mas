{"task_id": "Mbpp/7", "solution": "from typing import List, Iterator, Set\n\nclass InputString:\n    \"\"\"Encapsulates the input string for tokenization.\"\"\"\n    def __init__(self, text: str) -> None:\n        self.text = text\n\n    def tokenize(self) -> List[str]:\n        \"\"\"Splits the input text by whitespace into a list of token strings.\"\"\"\n        return self.text.split()\n\nclass Word:\n    \"\"\"Represents a single token and provides length evaluation.\"\"\"\n    def __init__(self, text: str) -> None:\n        self.text = text\n\n    @property\n    def length(self) -> int:\n        \"\"\"Returns the length of the word's text.\"\"\"\n        return len(self.text)\n\n    def is_long(self) -> bool:\n        \"\"\"Checks if the word's length is at least 4 characters.\"\"\"\n        return self.length >= 4\n\nclass ResultCollection:\n    \"\"\"Container for selected word texts, preserving original casing and being iterable.\"\"\"\n    def __init__(self, words: List[str]) -> None:\n        self.words = words\n\n    def to_set(self) -> Set[str]:\n        \"\"\"Returns a set of the contained words.\"\"\"\n        return set(self.words)\n\n    def __iter__(self) -> Iterator[str]:\n        \"\"\"Enables iteration over the words in the collection.\"\"\"\n        return iter(self.words)\n\n    def __len__(self) -> int:\n        \"\"\"Returns the number of words in the collection.\"\"\"\n        return len(self.words)\n\nclass Finder:\n    \"\"\"Encapsulates logic to parse, filter, and collect long words.\"\"\"\n    def find_char_long(self, s: str) -> ResultCollection:\n        \"\"\"Finds all words at least 4 characters long in the input string.\"\"\"\n        input_string = InputString(s)\n        tokens = input_string.tokenize()\n        \n        word_objects = [Word(token) for token in tokens]\n        long_words = [word.text for word in word_objects if word.is_long()]\n        \n        return ResultCollection(long_words)\n\ndef find_char_long(s: str) -> ResultCollection:\n    \"\"\"\n    Finds all words which are at least 4 characters long in a string.\n    This function delegates the core logic to the Finder class.\n    \"\"\"\n    finder = Finder()\n    return finder.find_char_long(s)"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_str: str, ch: str) -> str:\n    \"\"\"\n    Removes the first and last occurrence of a given character from the string.\n    Handles cases for zero, one, or multiple occurrences of the character.\n    \"\"\"\n    first_idx = input_str.find(ch)\n\n    if first_idx == -1:\n        # Character not found, return original string\n        return input_str\n\n    last_idx = input_str.rfind(ch)\n\n    if first_idx == last_idx:\n        # Character occurs exactly once, remove that occurrence\n        return input_str[:first_idx] + input_str[first_idx+1:]\n    else:\n        # Character occurs two or more times, remove the first and last occurrences\n        return input_str[:first_idx] + input_str[first_idx+1:last_idx] + input_str[last_idx+1:]"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(s: str) -> int:\n    \"\"\"Finds the minimum positive number of rotations to get the original string.\"\"\"\n    n = len(s)\n    # Iterate through possible rotation counts from 1 to n (inclusive).\n    for k in range(1, n + 1):\n        # Perform a cyclic shift by k positions.\n        rotated_s = s[k:] + s[:k]\n        # If the rotated string matches the original, k is the minimum rotation count.\n        if s == rotated_s:\n            return k\n    # This line should theoretically not be reached for non-empty strings,\n    # as rotating by n positions always restores the original string."}
{"task_id": "Mbpp/2", "solution": "def similar_elements(seqA, seqB) -> list:\n    \"\"\"\n    Finds elements that are present in both input sequences.\n    Returns a list of unique shared elements.\n    \"\"\"\n    all_matches = []\n\n    for item_a in seqA:\n        found_this_item_a_in_seqB = False\n        for item_b in seqB:\n            if item_a == item_b:\n                found_this_item_a_in_seqB = True\n                break\n        \n        if found_this_item_a_in_seqB:\n            all_matches.append(item_a)\n\n    unique_shared_elements = []\n    for match in all_matches:\n        if match not in unique_shared_elements:\n            unique_shared_elements.append(match)\n\n    return unique_shared_elements"}
{"task_id": "Mbpp/4", "solution": "import heapq\n\nclass InvalidInputError(ValueError):\n    \"\"\"Exception raised for invalid input types or values.\"\"\"\n\nclass Validator:\n    \"\"\"Validates function inputs based on specified rules.\"\"\"\n    @staticmethod\n    def validate_input_list(input_list: list) -> None:\n        \"\"\"Ensures the input_list is a list of integers.\"\"\"\n        if not isinstance(input_list, list):\n            raise InvalidInputError(\"Input list must be a list.\")\n        for item in input_list:\n            if not isinstance(item, int):\n                raise InvalidInputError(\"All elements in the input list must be integers.\")\n\n    @staticmethod\n    def validate_n(n: int) -> None:\n        \"\"\"Ensures n is an integer.\"\"\"\n        if not isinstance(n, int):\n            raise InvalidInputError(\"n must be an integer.\")\n\n    @staticmethod\n    def validate_all(input_list: list, n: int) -> None:\n        \"\"\"Performs all input validations.\"\"\"\n        Validator.validate_input_list(input_list)\n        Validator.validate_n(n)\n\nclass MinHeap:\n    \"\"\"A min-heap implementation using Python's heapq module.\"\"\"\n    def __init__(self):\n        self._data = []\n\n    def push(self, value: int) -> None:\n        \"\"\"Pushes a value onto the heap.\"\"\"\n        heapq.heappush(self._data, value)\n\n    def pop(self) -> int:\n        \"\"\"Removes and returns the smallest item from the heap.\"\"\"\n        return heapq.heappop(self._data)\n\n    def size(self) -> int:\n        \"\"\"Returns the number of items in the heap.\"\"\"\n        return len(self._data)\n\n    def peek_min(self) -> int:\n        \"\"\"Returns the smallest item without removing it.\"\"\"\n        return self._data[0]\n\nclass Selector:\n    \"\"\"Selects the n largest integers using a min-heap.\"\"\"\n    def __init__(self, n: int):\n        self._n = n\n        self._heap = MinHeap()\n\n    def feed(self, value: int) -> None:\n        \"\"\"Feeds a value to the selector, maintaining the n largest in the heap.\"\"\"\n        if self._n <= 0:\n            return\n        if self._heap.size() < self._n:\n            self._heap.push(value)\n        elif value > self._heap.peek_min():\n            self._heap.pop()\n            self._heap.push(value)\n\n    def get_selected(self) -> list[int]:\n        \"\"\"Returns the current contents of the heap as a list.\"\"\"\n        return self._heap._data[:]\n\nclass ResultBuilder:\n    \"\"\"Builds the final result list by sorting.\"\"\"\n    @staticmethod\n    def build_result(selected: list[int], n: int) -> list[int]:\n        \"\"\"Sorts the selected items in descending order.\"\"\"\n        selected.sort(reverse=True)\n        return selected\n\nclass HeapQueueLargestFunction:\n    \"\"\"Orchestrates the process of finding the n largest integers.\"\"\"\n    def __init__(self, input_list: list, n: int):\n        self.input_list = input_list\n        self.n = n\n\n    def compute(self) -> list:\n        \"\"\"Executes the logic to find and return the n largest integers.\"\"\"\n        Validator.validate_all(self.input_list, self.n)\n\n        if self.n <= 0:\n            return []\n\n        selector = Selector(self.n)\n        for value in self.input_list:\n            selector.feed(value)\n\n        selected_candidates = selector.get_selected()\n        result = ResultBuilder.build_result(selected_candidates, self.n)\n        return result\n\ndef heap_queue_largest(list_of_integers: list, n: int) -> list:\n    \"\"\"\n    Finds the n largest integers from a given list of numbers, returned in descending order.\n    Orchestrates validation, selection, and result building.\n    \"\"\"\n    interactor = HeapQueueLargestFunction(list_of_integers, n)\n    return interactor.compute()"}
{"task_id": "Mbpp/18", "solution": "def remove_dirty_chars(source: str, filter: str) -> str:\n    \"\"\"\n    Removes characters from the first string which are present in the second string, preserving order.\n    Characters are removed case-sensitively and globally.\n    \"\"\"\n    filter_set = set(filter)\n    result_chars = []\n    for char in source:\n        if char not in filter_set:\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
