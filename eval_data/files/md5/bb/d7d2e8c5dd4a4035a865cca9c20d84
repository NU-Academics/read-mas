{"task_id": "Mbpp/463", "solution": "def max_subarray_product(arr: list) -> Union[int, float]:\n    \"\"\"\n    Finds the maximum product of any contiguous subarray within a given list of integers.\n    This algorithm handles positive, negative, and zero values efficiently.\n    \"\"\"\n    if not arr:\n        return 0\n\n    max_so_far = arr[0]\n    current_max_prod = arr[0]\n    current_min_prod = arr[0]\n\n    for i in range(1, len(arr)):\n        num = arr[i]\n\n        if num == 0:\n            # If the current number is 0, any product sequence ending here is 0.\n            # Reset current_max_prod and current_min_prod to 1 for the next sequence\n            # (effectively starting a new subarray product calculation).\n            # Update max_so_far with 0 if it's larger than current max.\n            current_max_prod = 1\n            current_min_prod = 1\n            max_so_far = max(max_so_far, 0)\n        else:\n            # Calculate potential new max and min products ending at the current position.\n            # A negative number can turn a small negative product into a large positive one,\n            # so we consider num, current_max_prod * num, and current_min_prod * num.\n            temp_max_prod = max(num, current_max_prod * num, current_min_prod * num)\n            temp_min_prod = min(num, current_max_prod * num, current_min_prod * num)\n\n            current_max_prod = temp_max_prod\n            current_min_prod = temp_min_prod\n\n            # Update the overall maximum product found across all subarrays.\n            max_so_far = max(max_so_far, current_max_prod)\n\n    return max_so_far"}
{"task_id": "Mbpp/470", "solution": "def add_pairwise(input: tuple) -> tuple:\n    \"\"\"Validate input and return tuple of pairwise sums of neighboring numeric elements.\"\"\"\n    if not isinstance(input, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n\n    for element in input:\n        if not isinstance(element, (int, float)):\n            raise ValueError(\"All elements in the input tuple must be numeric (int or float).\")\n\n    if len(input) < 2:\n        return ()\n\n    sums = []\n    for i in range(len(input) - 1):\n        sums.append(input[i] + input[i+1])\n\n    return tuple(sums)"}
{"task_id": "Mbpp/468", "solution": "class Array:\n    \"\"\"A lightweight container for input numeric values.\"\"\"\n    def __init__(self, values):\n        self.values = list(values)\n\nclass Element:\n    \"\"\"Represents a domain element with its value and original position.\"\"\"\n    def __init__(self, value: float, position: int):\n        self.value = value\n        self.position = position\n\nclass Subsequence:\n    \"\"\"Represents a candidate increasing subsequence and computes its product.\"\"\"\n    def __init__(self, elements: list):\n        self.elements = elements\n\n    def product(self) -> float:\n        \"\"\"Calculates the multiplicative product of elements in the subsequence.\"\"\"\n        if not self.elements:\n            return 0.0 # An empty subsequence product depends on context, but DP will always have at least one element.\n        p = 1.0\n        for element in self.elements:\n            p *= element.value\n        return p\n\nclass ProductResult:\n    \"\"\"Encapsulates the final numeric product result.\"\"\"\n    def __init__(self, value: float):\n        self.value = value\n\nclass MaxProductCalculator:\n    \"\"\"Computes the maximum product of an increasing subsequence using dynamic programming.\"\"\"\n    def max_product(self, array_values: list) -> float:\n        \"\"\"\n        Calculates the maximum product of a strictly increasing subsequence.\n        Uses dynamic programming to track the maximum product ending at each index.\n        \"\"\"\n        if not array_values:\n            return 0.0\n\n        n = len(array_values)\n        # dp[i] stores the maximum product of an increasing subsequence ending at index i.\n        # Initialize dp[i] with array_values[i], as a single element is a valid subsequence.\n        dp = [float(val) for val in array_values]\n\n        # Overall maximum product found across all subsequences.\n        overall_max_product = max(dp)\n\n        for i in range(n):\n            for j in range(i):\n                if array_values[i] > array_values[j]:\n                    # If current element can extend a subsequence ending at j,\n                    # update dp[i] if a larger product is found.\n                    new_product = dp[j] * array_values[i]\n                    if new_product > dp[i]:\n                        dp[i] = new_product\n            \n            # Update the global maximum after considering all subsequences ending at i.\n            if dp[i] > overall_max_product:\n                overall_max_product = dp[i]\n\n        return overall_max_product\n\ndef max_product(array: list) -> float:\n    \"\"\"\n    Finds the maximum product formed by multiplying numbers of an increasing subsequence.\n    Delegates the core computation to the MaxProductCalculator.\n    \"\"\"\n    calculator = MaxProductCalculator()\n    return calculator.max_product(array)"}
{"task_id": "Mbpp/471", "solution": "def find_remainder(array: list[int], n: int) -> int:\n    \"\"\"\n    Finds the product of array elements modulo n, ensuring input validity.\n    This function orchestrates validation, product calculation, and modulo reduction.\n    \"\"\"\n\n    def validate_inputs(array_param, n_param) -> None:\n        \"\"\"Validates input types and values for array and modulus n.\"\"\"\n        if not isinstance(array_param, list):\n            raise TypeError(\"Input 'array' must be a list.\")\n        for item in array_param:\n            if not isinstance(item, int):\n                raise TypeError(\"All elements in 'array' must be integers.\")\n        if not isinstance(n_param, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n        if n_param == 0:\n            raise ValueError(\"Input 'n' cannot be zero.\")\n\n    def compute_product(array_param: list[int]) -> int:\n        \"\"\"Computes the product of all elements in the array. Product starts at 1 for empty arrays.\"\"\"\n        product = 1\n        for item in array_param:\n            product *= item\n        return product\n\n    def compute_modulo(product_param: int, n_param: int) -> int:\n        \"\"\"Computes the remainder of product modulo n, ensuring result is 0 <= R < n.\"\"\"\n        return product_param % n_param\n\n    validate_inputs(array, n)\n    product_result = compute_product(array)\n    remainder = compute_modulo(product_result, n)\n    return remainder"}
{"task_id": "Mbpp/462", "solution": "import collections\nfrom typing import Any, List\n\ndef combinations_list(input_list: List[Any]) -> List[List[Any]]:\n    \"\"\"\n    Finds all possible combinations of elements from a given list, including the empty list.\n    Generates combinations using a deterministic left-to-right prepend and append algorithm.\n    \"\"\"\n    all_combinations: List[List[Any]] = [[]]  # Start with the empty combination\n\n    for element in input_list:\n        # Create new combinations by prepending the current element to existing combinations\n        new_combinations = [[element] + existing_combo for existing_combo in all_combinations]\n        # Append these new combinations to the overall list\n        all_combinations.extend(new_combinations)\n\n    return all_combinations"}
{"task_id": "Mbpp/472", "solution": "def check_Consecutive(elements):\n    \"\"\"\n    Checks if the given list contains strictly consecutive numbers.\n    Raises TypeError for invalid input types.\n    \"\"\"\n    if not isinstance(elements, list):\n        raise TypeError(\"Input must be a list.\")\n\n    if not all(isinstance(item, int) for item in elements):\n        raise TypeError(\"All elements in the list must be integers.\")\n\n    if len(elements) < 2:\n        return True\n\n    for i in range(len(elements) - 1):\n        if elements[i+1] != elements[i] + 1:\n            return False\n\n    return True"}
{"task_id": "Mbpp/474", "solution": "def replace_char(original: str, target: str, replacement: str) -> str:\n    \"\"\"Replaces all occurrences of a target character with a replacement character in a string.\n    It returns a new string with the replacements.\"\"\"\n\n    if not original:\n        return \"\"\n\n    if target not in original:\n        return original\n\n    result_chars = []\n    for char in original:\n        if char == target:\n            result_chars.append(replacement)\n        else:\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/473", "solution": "class UnorderedPair:\n    \"\"\"A minimal class to represent an unordered pair and return its canonical form.\"\"\"\n    def __init__(self, a, b):\n        self.a = a\n        self.b = b\n\n    def canonicalize(self):\n        \"\"\"Returns the pair as a 2-element tuple in ascending order.\"\"\"\n        try:\n            return (min(self.a, self.b), max(self.a, self.b))\n        except TypeError as e:\n            raise TypeError(f\"Elements '{self.a}' and '{self.b}' are not comparable.\") from e\n\ndef _canonicalize_pair(pair):\n    \"\"\"Returns the canonical ordered tuple for a 2-element pair using UnorderedPair.\"\"\"\n    u_pair = UnorderedPair(pair[0], pair[1])\n    return u_pair.canonicalize()\n\ndef _validate_and_canonicalize_iterable(iterable):\n    \"\"\"Validates elements of an iterable and returns a set of canonical 2-element tuples.\"\"\"\n    canonical_set = set()\n    for item in iterable:\n        if not isinstance(item, tuple) or len(item) != 2:\n            raise ValueError(f\"Input element '{item}' must be a tuple of length two.\")\n        canonical_set.add(_canonicalize_pair(item))\n    return canonical_set\n\ndef tuple_intersection(iterableA, iterableB):\n    \"\"\"\n    Finds the tuple intersection of elements in two tuple lists,\n    treating tuples as unordered pairs irrespective of their order.\n    \"\"\"\n    setA = _validate_and_canonicalize_iterable(iterableA)\n    setB = _validate_and_canonicalize_iterable(iterableB)\n    return setA.intersection(setB)"}
{"task_id": "Mbpp/475", "solution": "def sort_counter(counter: dict) -> list:\n    \"\"\"Accepts a dictionary with string keys and integer values and returns a list of\n    (key, value) tuples sorted descending by value.\n    \"\"\"\n    items = list(counter.items())\n    items.sort(key=lambda kv: kv[1], reverse=True)\n    return items"}
{"task_id": "Mbpp/476", "solution": "def big_sum(values):\n    \"\"\"\n    API: big_sum(values) -> number; expects non-empty list of numeric values (int or float);\n    raises ValueError if values is empty.\n    \"\"\"\n    if not values:\n        raise ValueError(\"Input list cannot be empty.\")\n    \n    min_value = min(values)\n    max_value = max(values)\n    \n    return min_value + max_value"}
