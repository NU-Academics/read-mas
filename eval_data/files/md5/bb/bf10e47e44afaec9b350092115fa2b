{"task_id": "HumanEval/32", "solution": "import math\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    if len(xs) % 2 != 0:\n        raise ValueError(\"The list of coefficients must have an even number of elements.\")\n\n    # Handle linear polynomials explicitly for precision and speed.\n    if len(xs) == 2:\n        return -xs[0] / xs[1]\n\n    # Use the bisection method for higher degree odd polynomials.\n    # An odd-degree polynomial (len(xs) is even, so degree = len(xs)-1 is odd)\n    # is guaranteed to have at least one real root.\n    \n    low = -1.0\n    high = 1.0\n    scale_factor = 2.0 \n    \n    val_low = poly(xs, low)\n    val_high = poly(xs, high)\n\n    # Expand the interval until a sign change is found or the interval is very large.\n    # The problem guarantees a solution, so a sign change will eventually be found within reasonable bounds.\n    max_search_range = 1e100 # Maximum search range to prevent infinite loops for extreme cases.\n    while math.copysign(1, val_low) == math.copysign(1, val_high) and high - low < max_search_range:\n        if abs(val_low) < 1e-7: # Check if current 'low' is already a root\n            return low\n        if abs(val_high) < 1e-7: # Check if current 'high' is already a root\n            return high\n\n        low *= scale_factor\n        high *= scale_factor\n        val_low = poly(xs, low)\n        val_high = poly(xs, high)\n        \n    # Bisection method to refine the root within the bracketed interval.\n    tolerance = 1e-7\n    for _ in range(200): \n        mid = (low + high) / 2.0\n        val_mid = poly(xs, mid)\n\n        if abs(val_mid) < tolerance:\n            return mid\n\n        if math.copysign(1, val_mid) == math.copysign(1, val_low):\n            low = mid\n            val_low = val_mid\n        else:\n            high = mid\n            val_high = val_mid\n\n    # Return the midpoint of the final interval as the approximate root.\n    return (low + high) / 2.0"}
{"task_id": "HumanEval/36", "solution": "class Number:\n    \"\"\"Represents a candidate integer and checks its divisibility.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def is_divisible_by_11_or_13(self) -> bool:\n        \"\"\"Checks if the number is divisible by 11 or 13.\"\"\"\n        return (self.value % 11 == 0) or (self.value % 13 == 0)\nclass DigitCounter:\n    \"\"\"Counts occurrences of specific digits in a number.\"\"\"\n    @staticmethod\n    def count7(number: int) -> int:\n        \"\"\"Counts the occurrences of the digit '7' in the given integer.\"\"\"\n        count = 0\n        s_num = str(number)\n        for digit_char in s_num:\n            if digit_char == '7':\n                count += 1\n        return count\nclass FizzBuzzCalculator:\n    \"\"\"Orchestrates the filtering of numbers and counting of the digit 7.\"\"\"\n    def calculate(self, n: int) -> int:\n        \"\"\"Calculates the total occurrences of the digit 7 in relevant numbers.\"\"\"\n        total_sevens = 0\n        for i in range(1, n):\n            num_obj = Number(i)\n            if num_obj.is_divisible_by_11_or_13():\n                total_sevens += DigitCounter.count7(i)\n        return total_sevens\ndef fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    if n <= 0:\n        return 0\n\n    calculator = FizzBuzzCalculator()\n    return calculator.calculate(n)"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # cycle elements in each group back. Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/37", "solution": "class IntegerList:\n    def __init__(self, values: list[int]):\n        \"\"\"Initializes the IntegerList with a list of values.\"\"\"\n        self.values = list(values) # Create a copy to ensure immutability of the original passed list\n\n    def get_even_indices(self) -> list[int]:\n        \"\"\"Returns a list of elements at even indices.\"\"\"\n        return [self.values[i] for i in range(0, len(self.values), 2)]\n\n    def get_odd_indices(self) -> list[int]:\n        \"\"\"Returns a list of elements at odd indices.\"\"\"\n        return [self.values[i] for i in range(1, len(self.values), 2)]\n\n    def sort_even_indices(self) -> 'IntegerList':\n        \"\"\"Sorts the elements at even indices and reconstructs the list.\"\"\"\n        sorted_even_elements = sorted(self.get_even_indices())\n        odd_elements = self.get_odd_indices()\n\n        result = [0] * len(self.values) # Pre-allocate list for performance\n        even_idx_ptr, odd_idx_ptr = 0, 0\n\n        for i in range(len(self.values)):\n            if i % 2 == 0:\n                result[i] = sorted_even_elements[even_idx_ptr]\n                even_idx_ptr += 1\n            else:\n                result[i] = odd_elements[odd_idx_ptr]\n                odd_idx_ptr += 1\n        return IntegerList(result)\ndef sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    original_integer_list = IntegerList(l)\n    sorted_integer_list = original_integer_list.sort_even_indices()\n    return sorted_integer_list.values"}
