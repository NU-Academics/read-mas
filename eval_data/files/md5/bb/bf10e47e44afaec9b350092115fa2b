{"task_id": "HumanEval/137", "solution": "def compare_one(a, b):\n    \"\"\"\n    Create a function that takes integers, floats, or strings representing\n    real numbers, and returns the larger variable in its given variable type.\n    Return None if the values are equal.\n    Note: If a real number is represented as a string, the floating point might be . or ,\n    \"\"\"\n\n    def _parse_value(value):\n        \"\"\"Helper to parse a value into a float, handling string formats.\"\"\"\n        if isinstance(value, (int, float)):\n            return float(value)\n        elif isinstance(value, str):\n            # Replace comma with dot for consistent float conversion\n            s_value = value.replace(',', '.')\n            return float(s_value)\n        else:\n            # This case should ideally be handled by a _validate_type before _parse_value\n            # but per instructions, we omit explicit isinstance checks/exceptions here\n            return float(value) # Attempt conversion, might raise TypeError/ValueError\n\n    # Parse both inputs to float for comparison\n    parsed_a = _parse_value(a)\n    parsed_b = _parse_value(b)\n\n    if parsed_a > parsed_b:\n        return a\n    elif parsed_b > parsed_a:\n        return b\n    else:\n        # If values are equal, return None as per requirement FR5\n        return None"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    result = 1\n    current_factorial = 1\n    for i in range(1, n + 1):\n        current_factorial *= i\n        result *= current_factorial\n    return result"}
{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text):\n    \"\"\"\n    Replaces spaces in the text: 3+ consecutive spaces become '-', 2 become '__', 1 becomes '_'.\n    \"\"\"\n    # Replace sequences of 3 or more spaces with a single hyphen\n    text = re.sub(r' {3,}', '-', text)\n    # Replace sequences of exactly 2 spaces with two underscores\n    text = re.sub(r' {2}', '__', text)\n    # Replace single spaces with a single underscore\n    text = re.sub(r' ', '_', text)\n    return text"}
{"task_id": "HumanEval/160", "solution": "import operator as op_module\ndef do_algebra(operator, operand):\n    \"\"\"\n    Evaluates an algebraic expression from a list of operators and operands.\n    The expression is built by interleaving operands with operators.\n    \"\"\"\n    expression_str = str(operand[0])\n    for i in range(len(operator)):\n        expression_str += operator[i] + str(operand[i+1])\n    \n    # Python's eval function handles operator precedence and associativity correctly.\n    # It is safe to use here because the input comes from specified lists of\n    # numbers and operators, preventing arbitrary code injection.\n    return eval(expression_str)"}
{"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if not text:\n        return None\n    md5_hash = hashlib.md5(text.encode('utf-8')).hexdigest()\n    return md5_hash"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    start = min(a, b)\n    end = max(a, b)\n    \n    even_digits_in_range = []\n    \n    # The only positive even digits are 2, 4, 6, 8.\n    for digit in [2, 4, 6, 8]:\n        if start <= digit <= end:\n            even_digits_in_range.append(digit)\n            \n    return even_digits_in_range"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    while b:\n        a, b = b, a % b\n    return abs(a)"}
{"task_id": "HumanEval/17", "solution": "def parse_music(music_string: str) -> List[int]:\n    \"\"\" Input to this function is a string representing musical notes in a special ASCII format.\n    Your task is to parse this string and return list of integers corresponding to how many beats does each\n    not last.\n    \"\"\"\n    TOKEN_TO_BEATS = {\n        'o': 4,\n        'o|': 2,\n        '.|': 1\n    }\n    tokens = music_string.split()\n    beats = []\n    for token in tokens:\n        beats.append(TOKEN_TO_BEATS[token])\n    return beats"}
{"task_id": "HumanEval/9", "solution": "from typing import List, Tuple\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    max_so_far = numbers[0]\n    result = [max_so_far]\n\n    for num in numbers[1:]:\n        max_so_far = max(max_so_far, num)\n        result.append(max_so_far)\n\n    return result"}
{"task_id": "HumanEval/16", "solution": "def count_distinct_characters(string: str) -> int:\n    \"\"\" Given a string, find out how many distinct characters (regardless of case) does it consist of\n    >>> count_distinct_characters('xyzXYZ')\n    3\n    >>> count_distinct_characters('Jerry')\n    4\n    \"\"\"\n    normalized_string = string.lower()\n    distinct_chars = set()\n    for char in normalized_string:\n        distinct_chars.add(char)\n    return len(distinct_chars)"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\"Return the longest string from a list of strings. If multiple strings share the maximum length,\n    the first one in the list is returned; None is returned for an empty list.\n    \"\"\"\n    if not strings:\n        return None\n\n    max_len = 0\n    longest_str = None\n    for s in strings:\n        if len(s) > max_len:\n            max_len = len(s)\n            longest_str = s\n    return longest_str"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    result = []\n    for char_a, char_b in zip(a, b):\n        if char_a == char_b:\n            result.append('0')\n        else:\n            result.append('1')\n    return \"\".join(result)"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\nclass IntegerList:\n    \"\"\"Encapsulates a list of integers for calculation.\"\"\"\n    def __init__(self, values: List[int]):\n        self._values = values\n\n    def get_values(self) -> List[int]:\n        \"\"\"Returns the encapsulated list of integers.\"\"\"\n        return self._values\n\n    def get_size(self) -> int:\n        \"\"\"Returns the number of integers in the list.\"\"\"\n        return len(self._values)\nclass ResultTuple:\n    \"\"\"A data container for the calculated sum and product.\"\"\"\n    def __init__(self, sum_val: int, product_val: int):\n        self.sum = sum_val\n        self.product = product_val\nclass SumProductCalculator:\n    \"\"\"Performs the calculation of sum and product for an IntegerList.\"\"\"\n    def calculate(self, integer_list: IntegerList) -> ResultTuple:\n        \"\"\"Computes the sum and product of the given IntegerList.\"\"\"\n        current_sum = 0\n        current_product = 1\n        for num in integer_list.get_values():\n            current_sum += num\n            current_product *= num\n        return ResultTuple(current_sum, current_product)\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    integer_list = IntegerList(numbers)\n    calculator = SumProductCalculator()\n    result = calculator.calculate(integer_list)\n    return (result.sum, result.product)"}
{"task_id": "HumanEval/18", "solution": "def how_many_times(string: str, substring: str) -> int:\n    \"\"\" Find how many times a given substring can be found in the original string. Count overlaping cases.\n    >>> how_many_times('', 'a')\n    0\n    >>> how_many_times('aaa', 'a')\n    3\n    >>> how_many_times('aaaa', 'aa')\n    3\n    \"\"\"\n    count = 0\n    n = len(string)\n    m = len(substring)\n\n    if m == 0:\n        return 0\n\n    for i in range(n - m + 1):\n        if string[i:i+m] == substring:\n            count += 1\n    return count"}
{"task_id": "HumanEval/19", "solution": "def sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Valid choices are 'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight' and 'nine'.\n    Return the string with numbers sorted from smallest to largest\n    >>> sort_numbers('three one five')\n    'one three five'\n    \"\"\"\n    word_to_int = {\n        'zero': 0, 'one': 1, 'two': 2, 'three': 3, 'four': 4,\n        'five': 5, 'six': 6, 'seven': 7, 'eight': 8, 'nine': 9\n    }\n    int_to_word = {\n        0: 'zero', 1: 'one', 2: 'two', 3: 'three', 4: 'four',\n        5: 'five', 6: 'six', 7: 'seven', 8: 'eight', 9: 'nine'\n    }\n\n    if not numbers:\n        return \"\"\n\n    # Split the input string into individual number words\n    number_words = numbers.split(' ')\n\n    # Convert words to integers\n    numeric_values = [word_to_int[word] for word in number_words]\n\n    # Sort the numeric values\n    numeric_values.sort()\n\n    # Convert sorted numeric values back to words\n    sorted_words = [int_to_word[val] for val in numeric_values]\n\n    # Join the sorted words back into a space-delimited string\n    return ' '.join(sorted_words)"}
