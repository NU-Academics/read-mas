{"task_id": "HumanEval/38", "solution": "```python\ndef decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # reverse cycle elements in each group. Unless group has fewer elements than 3.\n    # To reverse the cyclic shift (e.g., 'abc' -> 'bca' -> 'abc'), perform a right shift.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)\n```"}
{"task_id": "HumanEval/40", "solution": "```python\ndef triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    # Sort the list to efficiently find triplets using the two-pointer approach.\n    sorted_l = sorted(l)\n\n    # Iterate through the array, fixing one element (sorted_l[i]) and using two pointers.\n    for i in range(n - 2):\n        left = i + 1\n        right = n - 1\n        while left < right:\n            current_sum = sorted_l[i] + sorted_l[left] + sorted_l[right]\n            if current_sum == 0:\n                return True\n            elif current_sum < 0:\n                left += 1\n            else:\n                right -= 1\n    return False\n```"}
{"task_id": "HumanEval/32", "solution": "```python\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    tolerance = 1e-6\n    max_iterations = 1000\n    search_range = 100.0\n\n    a = -search_range\n    b = search_range\n\n    # Initial function evaluations at the bounds of the search range.\n    fa = poly(xs, a)\n    fb = poly(xs, b)\n\n    # If a root is already at or very close to an initial boundary, return it.\n    if abs(fa) < tolerance:\n        return a\n    if abs(fb) < tolerance:\n        return b\n\n    # The problem guarantees a solution for the specified polynomial types,\n    # implying that a root is bracketed within a sufficiently wide range.\n    # We proceed with the bisection method.\n    for _ in range(max_iterations):\n        c = (a + b) / 2\n        fc = poly(xs, c)\n\n        # If the function value at midpoint is close enough to zero, we found a root.\n        if abs(fc) < tolerance:\n            return c\n\n        # Narrow down the interval based on the signs of fa and fc.\n        if fa * fc < 0:\n            # Root is in the left half [a, c]\n            b = c\n            fb = fc\n        else:\n            # Root is in the right half [c, b]\n            a = c\n            fa = fc\n\n    # If the bisection method did not converge within max_iterations,\n    # return the last calculated midpoint as the best approximation.\n    return c\n```"}
{"task_id": "HumanEval/37", "solution": "```python\ndef sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    if not l:\n        return []\n\n    even_elements = []\n    for i in range(0, len(l), 2):\n        even_elements.append(l[i])\n\n    even_elements.sort()\n\n    result_list = [None] * len(l)\n    sorted_even_idx = 0\n    for i in range(len(l)):\n        if i % 2 == 0:\n            result_list[i] = even_elements[sorted_even_idx]\n            sorted_even_idx += 1\n        else:\n            result_list[i] = l[i]\n\n    return result_list\n```"}
{"task_id": "HumanEval/43", "solution": "```python\ndef pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    >>> pairs_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> pairs_sum_to_zero([1, 3, -2, 1])\n    False\n    >>> pairs_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> pairs_sum_to_zero([2, 4, -5, 3, 5, 7])\n    True\n    >>> pairs_sum_to_zero([1])\n    False\n    \"\"\"\n    if len(l) < 2:\n        return False\n\n    seen_numbers = set()\n    for number in l:\n        complement = -number\n        if complement in seen_numbers:\n            return True\n        seen_numbers.add(number)\n    return False\n```"}
{"task_id": "HumanEval/44", "solution": "```python\ndef change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    if x == 0:\n        return \"0\"\n\n    result = []\n    current_x = x\n    while current_x > 0:\n        remainder = current_x % base\n        result.append(str(remainder))\n        current_x //= base\n\n    return \"\".join(reversed(result))\n```"}
{"task_id": "HumanEval/45", "solution": "```python\ndef triangle_area(a, h):\n    \"\"\"Given length of a side and high return area for a triangle.\n    >>> triangle_area(5, 3)\n    7.5\n    \"\"\"\n    def _validate_positive_number(value, name):\n        \"\"\"Validates that a given value is a positive number. Raises ValueError if the value is not a number or is not positive.\"\"\"\n        if not isinstance(value, (int, float)):\n            raise ValueError(f\"{name} must be a number.\")\n        if value <= 0:\n            raise ValueError(f\"{name} must be a positive number.\")\n\n    _validate_positive_number(a, \"a\")\n    _validate_positive_number(h, \"h\")\n    return 0.5 * a * h\n```"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    This function efficiently computes the n-th element of the fib4 number sequence using an iterative approach.\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # Initialize a list to store Fib4 numbers, where dp[i] stores fib4(i).\n    dp = [0] * (n + 1)\n    dp[0] = 0\n    dp[1] = 0\n    dp[2] = 2\n    dp[3] = 0\n\n    # Calculate Fib4 numbers iteratively for n > 3.\n    for i in range(4, n + 1):\n        dp[i] = dp[i-1] + dp[i-2] + dp[i-3] + dp[i-4]\n\n    return dp[n]"}
{"task_id": "HumanEval/48", "solution": "```python\nimport re\n\n\ndef is_palindrome(text: str):\n    \"\"\"\n    Checks if given string is a palindrome\n    >>> is_palindrome('')\n    True\n    >>> is_palindrome('aba')\n    True\n    >>> is_palindrome('aaaaa')\n    True\n    >>> is_palindrome('zbcd')\n    False\n    \"\"\"\n    # Normalize the string by converting to lowercase and removing non-alphanumeric characters.\n    normalized_text = re.sub(r'[^a-zA-Z0-9]', '', text).lower()\n\n    # Compare the normalized string with its reverse to determine if it's a palindrome.\n    return normalized_text == normalized_text[::-1]\n```"}
