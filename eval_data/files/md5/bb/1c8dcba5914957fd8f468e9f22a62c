{"task_id": "HumanEval/19", "solution": "from typing import List, Dict\n\n\nclass NumberWordMapper:\n    \"\"\"Provides a bidirectional mapping between number words and their integer representations.\"\"\"\n    _NUMBER_WORD_MAP: Dict[str, int] = {\n        \"zero\": 0, \"one\": 1, \"two\": 2, \"three\": 3, \"four\": 4,\n        \"five\": 5, \"six\": 6, \"seven\": 7, \"eight\": 8, \"nine\": 9\n    }\n\n    _INT_WORD_MAP: Dict[int, str] = {\n        0: \"zero\", 1: \"one\", 2: \"two\", 3: \"three\", 4: \"four\",\n        5: \"five\", 6: \"six\", 7: \"seven\", 8: \"eight\", 9: \"nine\"\n    }\n\n    def word_to_int(self, word: str) -> int:\n        \"\"\"Converts a number word string to its integer equivalent.\"\"\"\n        return self._NUMBER_WORD_MAP[word]\n\n    def int_to_word(self, num: int) -> str:\n        \"\"\"Converts an integer to its number word string equivalent.\"\"\"\n        return self._INT_WORD_MAP[num]\n\n\nclass NumberSorterService:\n    \"\"\"Encapsulates the core business logic for sorting number words.\"\"\"\n    def __init__(self, mapper: NumberWordMapper):\n        self._mapper = mapper\n\n    def sort(self, number_words_str: str) -> str:\n        \"\"\"Sorts a space-delimited string of number words from smallest to largest.\"\"\"\n        if not number_words_str:\n            return \"\"\n\n        words = self._parse_words(number_words_str)\n        numbers = self._convert_words_to_ints(words)\n        numbers.sort()\n        sorted_words = self._convert_ints_to_words(numbers)\n        return \" \".join(sorted_words)\n\n    def _parse_words(self, number_words_str: str) -> List[str]:\n        \"\"\"Splits the input string into a list of words.\"\"\"\n        return number_words_str.split(' ')\n\n    def _convert_words_to_ints(self, words: List[str]) -> List[int]:\n        \"\"\"Converts a list of number words to a list of integers.\"\"\"\n        return [self._mapper.word_to_int(word) for word in words]\n\n    def _convert_ints_to_words(self, numbers: List[int]) -> List[str]:\n        \"\"\"Converts a list of integers to a list of number words.\"\"\"\n        return [self._mapper.int_to_word(num) for num in numbers]\n\n\ndef sort_numbers(numbers: str) -> str:\n    \"\"\" Input is a space-delimited string of numberals from 'zero' to 'nine'.\n    Valid choices are 'zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight' and 'nine'.\n    Return the string with numbers sorted from smallest to largest\n    >>> sort_numbers('three one five')\n    'one three five'\n    \"\"\"\n    mapper = NumberWordMapper()\n    sorter_service = NumberSorterService(mapper)\n    return sorter_service.sort(numbers)"}
{"task_id": "HumanEval/30", "solution": "def get_positive(l: list):\n    \"\"\"Return only positive numbers in the list.\n    >>> get_positive([-1, 2, -4, 5, 6])\n    [2, 5, 6]\n    >>> get_positive([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    [5, 3, 2, 3, 9, 123, 1]\n    \"\"\"\n    return [x for x in l if x > 0]"}
