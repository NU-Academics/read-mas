{"task_id": "HumanEval/93", "solution": "```python\ndef encode(message):\n    \"\"\"\n    Encodes a message by swapping case and replacing vowels.\n    Vowels are replaced by the letter two places ahead in the alphabet, with wrap-around.\n    \"\"\"\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n    ALPHABET_LOWER = 'abcdefghijklmnopqrstuvwxyz'\n    ALPHABET_UPPER = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'\n\n    encoded_chars = []\n    for char in message:\n        # First, swap case\n        if 'a' <= char <= 'z':\n            swapped_char = char.upper()\n        elif 'A' <= char <= 'Z':\n            swapped_char = char.lower()\n        else:\n            swapped_char = char # Should not happen based on constraints\n\n        # Then, replace vowels in the swapped character\n        is_upper = swapped_char.isupper()\n        lower_swapped_char = swapped_char.lower()\n\n        if lower_swapped_char in VOWELS:\n            alphabet = ALPHABET_UPPER if is_upper else ALPHABET_LOWER\n            index = alphabet.index(swapped_char)\n            new_index = (index + 2) % len(alphabet)\n            final_char = alphabet[new_index]\n        else:\n            final_char = swapped_char\n\n        encoded_chars.append(final_char)\n\n    return \"\".join(encoded_chars)\n```\n"}
{"task_id": "HumanEval/86", "solution": "```python\nimport re\n\ndef anti_shuffle(s):\n    \"\"\"\n    Sorts characters within each word of a string based on ASCII values,\n    preserving word and space order.\n    \"\"\"\n    if not s:\n        return \"\"\n\n    # Split the string by one or more spaces, capturing the spaces themselves.\n    # This results in a list where alternating elements are words and spaces (or empty strings).\n    segments = re.split(r'(\\s+)', s)\n\n    processed_segments = []\n    for segment in segments:\n        # A segment is considered a \"word\" if it's not empty and not just whitespace.\n        if segment and segment.strip() != '':\n            processed_segments.append(\"\".join(sorted(segment)))\n        else: # It's a sequence of spaces or an empty string from the split\n            processed_segments.append(segment)\n\n    return \"\".join(processed_segments)\n```"}
{"task_id": "HumanEval/91", "solution": "```python\ndef is_bored(S):\n    \"\"\"\n    You'll be given a string of words, and your task is to count the number\n    of boredoms. A boredom is a sentence that starts with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    from typing import List\n\n    class SentenceSplitter:\n        def split(self, text: str) -> List[str]:\n            if not text:\n                return []\n\n            delimiters = ['.', '?', '!']\n            sentences = []\n            current_sentence_chars = []\n\n            for char in text:\n                current_sentence_chars.append(char)\n                if char in delimiters:\n                    sentence = \"\".join(current_sentence_chars).strip()\n                    if sentence: # Avoid adding empty strings from multiple delimiters or leading delimiters\n                        sentences.append(sentence)\n                    current_sentence_chars = []\n\n            # Add any remaining text as a sentence if no trailing delimiter\n            if current_sentence_chars:\n                sentence = \"\".join(current_sentence_chars).strip()\n                if sentence:\n                    sentences.append(sentence)\n\n            return sentences\n\n    class WordChecker:\n        def starts_with_i(self, sentence: str) -> bool:\n            trimmed_sentence = sentence.strip()\n            if not trimmed_sentence:\n                return False\n\n            # Find the first word\n            first_space_index = trimmed_sentence.find(' ')\n            if first_space_index == -1: # Single word sentence\n                first_word = trimmed_sentence\n            else:\n                first_word = trimmed_sentence[:first_space_index]\n\n            return first_word == \"I\"\n\n    class BoredomCounterService:\n        def __init__(self, sentence_splitter: SentenceSplitter, word_checker: WordChecker):\n            self._sentence_splitter = sentence_splitter\n            self._word_checker = word_checker\n\n        def count_boredoms(self, text: str) -> int:\n            boredom_count = 0\n            sentences = self._sentence_splitter.split(text)\n\n            for sentence in sentences:\n                if self._word_checker.starts_with_i(sentence):\n                    boredom_count += 1\n\n            return boredom_count\n\n    splitter = SentenceSplitter()\n    checker = WordChecker()\n    service = BoredomCounterService(splitter, checker)\n    return service.count_boredoms(S)\n```"}
{"task_id": "HumanEval/94", "solution": "```python\ndef skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"Checks if a number is prime.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def sum_digits(n):\n        \"\"\"Calculates the sum of digits of a number.\"\"\"\n        s = 0\n        while n:\n            s += n % 10\n            n //= 10\n        return s\n\n    largest_prime = 0\n    for num in lst:\n        if is_prime(num):\n            if num > largest_prime:\n                largest_prime = num\n\n    if largest_prime == 0:\n        return 0\n\n    return sum_digits(largest_prime)\n```"}
