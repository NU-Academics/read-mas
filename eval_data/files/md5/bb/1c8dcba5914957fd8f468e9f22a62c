{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"Calculates the Brazilian factorial of n, which is n! * (n-1)! * ... * 1!.\"\"\"\n\n    def _factorial(k):\n        \"\"\"Calculates the factorial of a non-negative integer k.\"\"\"\n        if k == 0:\n            return 1\n        res = 1\n        for i in range(1, k + 1):\n            res *= i\n        return res\n\n    special_fact_res = 1\n    for i in range(1, n + 1):\n        special_fact_res *= _factorial(i)\n    return special_fact_res"}
{"task_id": "HumanEval/137", "solution": "```python\ndef compare_one(a, b):\n    \"\"\"\n    Compares two numbers (int, float, or string representations) and returns the larger in its original type, or None if equal.\n    Handles ',' or '.' as decimal separators in strings.\n    \"\"\"\n\n    def _to_float(value):\n        \"\"\"Converts an integer, float, or string representing a real number to a float.\"\"\"\n        if isinstance(value, (int, float)):\n            return float(value)\n        elif isinstance(value, str):\n            # Replace comma with dot for consistent float conversion\n            normalized_value = value.replace(',', '.')\n            try:\n                return float(normalized_value)\n            except ValueError:\n                # Raise ValueError if the string cannot be converted to a float.\n                raise ValueError(f\"Cannot convert string '{value}' to a float.\")\n        else:\n            # Raise TypeError for unsupported input types.\n            raise TypeError(f\"Unsupported type for conversion: {type(value)}\")\n\n    float_a = _to_float(a)\n    float_b = _to_float(b)\n\n    if float_a > float_b:\n        return a\n    elif float_b > float_a:\n        return b\n    else:\n        return None\n```"}
{"task_id": "HumanEval/142", "solution": "```python\ndef sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a\n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not\n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries.\n\n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    processed_elements = []\n    for i, num in enumerate(lst):\n        if i % 3 == 0:\n            processed_elements.append(num * num)\n        elif i % 4 == 0:\n            processed_elements.append(num * num * num)\n        else:\n            processed_elements.append(num)\n    return sum(processed_elements)\n```"}
{"task_id": "HumanEval/141", "solution": "```python\ndef file_name_check(file_name):\n    \"\"\"Checks if a file name is valid based on specific criteria.\"\"\"\n\n    # Rule 1: Not more than three digits\n    digit_count = 0\n    for char in file_name:\n        if '0' <= char <= '9':\n            digit_count += 1\n    if digit_count > 3:\n        return 'No'\n\n    # Rule 2: Exactly one dot\n    if file_name.count('.') != 1:\n        return 'No'\n\n    # Split into name_part and extension_part\n    parts = file_name.split('.')\n    name_part = parts[0]\n    extension_part = parts[1]\n\n    # Rule 3: Substring before dot should not be empty\n    if not name_part:\n        return 'No'\n\n    # Rule 4: Substring before dot starts with a letter from the latin alphapet\n    if not ('a' <= name_part[0] <= 'z' or 'A' <= name_part[0] <= 'Z'):\n        return 'No'\n\n    # Rule 5: Substring after the dot should be one of ['txt', 'exe', 'dll']\n    allowed_extensions = ['txt', 'exe', 'dll']\n    if extension_part not in allowed_extensions:\n        return 'No'\n\n    return 'Yes'\n```\n"}
{"task_id": "HumanEval/140", "solution": "import re\n\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores,\n    and if a string has more than 2 consecutive spaces,\n    then replace all consecutive spaces with -\n    \"\"\"\n    # First, replace sequences of 2 or more spaces with a hyphen.\n    # This must be done before single spaces to avoid incorrect replacements.\n    fixed_text = re.sub(r' {2,}', '-', text)\n    # Then, replace any remaining single spaces with an underscore.\n    fixed_text = fixed_text.replace(' ', '_')\n    return fixed_text"}
{"task_id": "HumanEval/143", "solution": "```python\ndef words_in_sentence(sentence):\n    \"\"\"\n    Filters words from a sentence, returning only those whose lengths\n    are prime numbers, maintaining original order.\n    \"\"\"\n    def is_prime(n: int) -> bool:\n        \"\"\"Determines if an integer is a prime number.\"\"\"\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    words = sentence.split()\n    prime_length_words = []\n    for word in words:\n        if is_prime(len(word)):\n            prime_length_words.append(word)\n    return \" \".join(prime_length_words)\n```"}
{"task_id": "HumanEval/144", "solution": "def simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n    \"\"\"\n\n    class Fraction:\n        def __init__(self, numerator: int, denominator: int):\n            self._numerator = numerator\n            self._denominator = denominator\n\n        def multiply(self, other: 'Fraction') -> 'Fraction':\n            new_numerator = self._numerator * other._numerator\n            new_denominator = self._denominator * other._denominator\n            return Fraction(new_numerator, new_denominator)\n\n        def is_whole_number(self) -> bool:\n            return self._numerator % self._denominator == 0\n\n        def get_numerator(self) -> int:\n            return self._numerator\n\n        def get_denominator(self) -> int:\n            return self._denominator\n\n    class FractionParser:\n        @staticmethod\n        def parse(fraction_str: str) -> Fraction:\n            parts = fraction_str.split('/')\n            numerator = int(parts[0])\n            denominator = int(parts[1])\n            return Fraction(numerator, denominator)\n\n    fraction_x = FractionParser.parse(x)\n    fraction_n = FractionParser.parse(n)\n    product_fraction = fraction_x.multiply(fraction_n)\n    return product_fraction.is_whole_number()"}
{"task_id": "HumanEval/146", "solution": "```python\ndef specialFilter(nums):\n    \"\"\"Counts numbers in an array that are greater than 10 and have both first and last digits odd.\"\"\"\n\n    def _is_odd(digit: int) -> bool:\n        \"\"\"Checks if a given digit is odd.\"\"\"\n        return digit % 2 != 0\n\n    def _get_first_digit(num: int) -> int:\n        \"\"\"Extracts the first digit of an integer using its absolute value.\"\"\"\n        abs_num = abs(num)\n        if abs_num == 0:\n            return 0\n        while abs_num >= 10:\n            abs_num //= 10\n        return abs_num\n\n    def _get_last_digit(num: int) -> int:\n        \"\"\"Extracts the last digit of an integer using its absolute value.\"\"\"\n        return abs(num) % 10\n\n    count = 0\n    for num in nums:\n        if num <= 10:\n            continue\n\n        first_digit = _get_first_digit(num)\n        last_digit = _get_last_digit(num)\n\n        if _is_odd(first_digit) and _is_odd(last_digit):\n            count += 1\n\n    return count\n```"}
{"task_id": "HumanEval/145", "solution": "def _sum_digits(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the digits of the absolute value of an integer.\n    \"\"\"\n    s = 0\n    for digit in str(abs(n)):\n        s += int(digit)\n    return s\n\ndef order_by_points(nums: list[int]) -> list[int]:\n    \"\"\"\n    Write a function which sorts the given list of integers\n    in ascending order according to the sum of their digits.\n    Note: if there are several items with similar sum of their digits,\n    order them based on their index in original list.\n\n    For example:\n    >>> order_by_points([1, 11, -1, -11, -12]) == [-1, -11, 1, -12, 11]\n    >>> order_by_points([]) == []\n    \"\"\"\n    # Pair each number with its original index for tie-breaking.\n    indexed_nums = [(num, i) for i, num in enumerate(nums)]\n\n    # Sort based on a compound key: (sum_of_digits, original_index).\n    sorted_indexed_nums = sorted(indexed_nums, key=lambda item: (_sum_digits(item[0]), item[1]))\n\n    # Extract the sorted numbers from the paired list.\n    return [item[0] for item in sorted_indexed_nums]"}
{"task_id": "HumanEval/148", "solution": "```python\ndef bf(planet1, planet2):\n    planets_ordered = (\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\")\n\n    # Helper to get the case-insensitive index of a planet\n    def _get_planet_index(planet_name):\n        try:\n            return [p.lower() for p in planets_ordered].index(planet_name.lower())\n        except ValueError:\n            return -1\n\n    idx1 = _get_planet_index(planet1)\n    idx2 = _get_planet_index(planet2)\n\n    # Return empty tuple if either planet is not found\n    if idx1 == -1 or idx2 == -1:\n        return ()\n\n    # Ensure min_idx is always less than max_idx for slicing\n    min_idx = min(idx1, idx2)\n    max_idx = max(idx1, idx2)\n\n    # Slice the list to get planets between the two indices, excluding the start and end planets themselves\n    intermediate_planets = planets_ordered[min_idx + 1:max_idx]\n\n    return tuple(intermediate_planets)\n```"}
{"task_id": "HumanEval/129", "solution": "```python\nclass Coordinate:\n    def __init__(self, row: int, col: int):\n        self.row = row\n        self.col = col\n\n    def __eq__(self, other: object) -> bool:\n        if not isinstance(other, Coordinate):\n            return NotImplemented\n        return self.row == other.row and self.col == other.col\n\n    def __hash__(self) -> int:\n        return hash((self.row, self.col))\n\nclass Path:\n    def __init__(self, values: list[int], coordinates: list[Coordinate]):\n        self._values = list(values)\n        self._coordinates = list(coordinates)\n\n    def add_step(self, value: int, coord: Coordinate) -> 'Path':\n        \"\"\"Returns a new Path object extending the current path by one step.\"\"\"\n        return Path(self._values + [value], self._coordinates + [coord])\n\n    def get_values(self) -> list[int]:\n        \"\"\"Returns the ordered list of values on the cells visited.\"\"\"\n        return self._values\n\n    def get_last_coordinate(self) -> Coordinate:\n        \"\"\"Returns the Coordinate of the last cell visited in the path.\"\"\"\n        return self._coordinates[-1]\n\n    def get_length(self) -> int:\n        \"\"\"Returns the number of cells visited in the path.\"\"\"\n        return len(self._values)\n\n    def __lt__(self, other: 'Path') -> bool:\n        \"\"\"Compares two paths lexicographically based on their values.\"\"\"\n        return self._values < other._values\n\ndef is_valid_coordinate(grid_size: int, coord: Coordinate) -> bool:\n    \"\"\"Checks if a given coordinate is within the grid boundaries.\"\"\"\n    return 0 <= coord.row < grid_size and 0 <= coord.col < grid_size\n\ndef get_neighbors(grid_size: int, coord: Coordinate) -> list[Coordinate]:\n    \"\"\"Returns a list of valid neighbor coordinates (up, down, left, right).\"\"\"\n    neighbors = []\n    directions = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Up, Down, Left, Right\n\n    for dr, dc in directions:\n        new_row, new_col = coord.row + dr, coord.col + dc\n        new_coord = Coordinate(new_row, new_col)\n        if is_valid_coordinate(grid_size, new_coord):\n            neighbors.append(new_coord)\n    return neighbors\n\nclass PathFinderService:\n    def __init__(self, grid: list[list[int]], k: int):\n        self._grid = grid\n        self._grid_size = len(grid)\n        self._k = k\n        self._min_path_values: list[int] | None = None\n\n    def find_min_path(self) -> list[int]:\n        \"\"\"Initiates the pathfinding process from all possible starting cells.\"\"\"\n        for r in range(self._grid_size):\n            for c in range(self._grid_size):\n                start_coord = Coordinate(r, c)\n                initial_path = Path([self._grid[r][c]], [start_coord])\n                self._explore_paths(initial_path)\n\n        if self._min_path_values is None:\n            raise RuntimeError(\"No path found, this should not happen given problem constraints.\")\n        return self._min_path_values\n\n    def _explore_paths(self, current_path: Path) -> None:\n        \"\"\"Recursively explores paths using Depth-First Search with pruning.\"\"\"\n        if current_path.get_length() == self._k:\n            current_path_values = current_path.get_values()\n            if self._min_path_values is None or current_path_values < self._min_path_values:\n                self._min_path_values = current_path_values\n            return\n\n        # Pruning 1: Path is already too long\n        if current_path.get_length() > self._k:\n            return\n\n        # Pruning 2: If current path's prefix is already lexicographically worse than or equal to the best path found so far\n        if self._min_path_values is not None:\n             current_prefix_len = current_path.get_length()\n             # Compare current path's values to the known minimum path's prefix of the same length\n             # If current is greater or equal, this branch cannot lead to a better path.\n             if current_path.get_values() >= self._min_path_values[:current_prefix_len]:\n                 return\n\n        last_coord = current_path.get_last_coordinate()\n        neighbors = get_neighbors(self._grid_size, last_coord)\n\n        # To ensure consistent exploration order for uniqueness, sort neighbors.\n        # This isn't strictly necessary for correctness due to uniqueness guarantee,\n        # but could help in debugging or if the uniqueness guarantee was relaxed.\n        # Sorting by (row, col) implicitly.\n        neighbors.sort(key=lambda c: (c.row, c.col))\n\n        for neighbor_coord in neighbors:\n            value = self._grid[neighbor_coord.row][neighbor_coord.col]\n            new_path = current_path.add_step(value, neighbor_coord)\n            self._explore_paths(new_path)\n\ndef minPath(grid, k):\n    \"\"\"\n    Given a grid with N rows and N columns (N >= 2) and a positive integer k,\n    each cell of the grid contains a value. Every integer in the range [1, N * N]\n    inclusive appears exactly once on the cells of the grid.\n\n    You have to find the minimum path of length k in the grid. You can start\n    from any cell, and in each step you can move to any of the neighbor cells,\n    in other words, you can go to cells which share an edge with you current\n    cell.\n    Please note that a path of length k means visiting exactly k cells (not\n    necessarily distinct).\n    You CANNOT go off the grid.\n    A path A (of length k) is considered less than a path B (of length k) if\n    after making the ordered lists of the values on the cells that A and B go\n    through (let's call them lst_A and lst_B), lst_A is lexicographically less\n    than lst_B, in other words, there exist an integer index i (1 <= i <= k)\n    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have\n    lst_A[j] = lst_B[j].\n    It is guaranteed that the answer is unique.\n    Return an ordered list of the values on the cells that the minimum path go through.\n    \"\"\"\n    if not isinstance(grid, list) or not all(isinstance(row, list) for row in grid):\n        raise ValueError(\"Grid must be a list of lists.\")\n\n    n = len(grid)\n    if n < 2 or not all(len(row) == n for row in grid):\n        raise ValueError(\"Grid must be an N x N matrix with N >= 2.\")\n\n    if not isinstance(k, int) or k < 1:\n        raise ValueError(\"k must be a positive integer.\")\n\n    service = PathFinderService(grid, k)\n    return service.find_min_path()\n```"}
{"task_id": "HumanEval/150", "solution": "```python\nimport math\n\ndef x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is\n    a prime number and should return the value of y otherwise.\n    \"\"\"\n    # Determine if n is a prime number.\n    if n <= 1:\n        is_prime_result = False\n    elif n == 2:\n        is_prime_result = True\n    elif n % 2 == 0:\n        is_prime_result = False\n    else:\n        # Check for odd divisors from 3 up to the square root of n.\n        is_prime_result = True\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                is_prime_result = False\n                break\n\n    if is_prime_result:\n        return x\n    else:\n        return y\n```"}
{"task_id": "HumanEval/149", "solution": "```python\ndef sorted_list_sum(lst):\n    \"\"\"Filters a list of strings, keeping only even-length ones, then sorts them by length and alphabetically.\"\"\"\n    even_length_strings = []\n    for s in lst:\n        if len(s) % 2 == 0:\n            even_length_strings.append(s)\n\n    even_length_strings.sort(key=lambda s: (len(s), s))\n\n    return even_length_strings\n```"}
{"task_id": "HumanEval/151", "solution": "```python\ndef double_the_difference(lst):\n    \"\"\"\n    Calculates the sum of squares of odd, positive integers in the input list.\n    Floats, negative numbers, zeros, and non-integers are ignored.\n    \"\"\"\n    total_sum = 0\n    for num in lst:\n        # Check if the number is an integer, positive, and odd.\n        if isinstance(num, int) and num > 0 and num % 2 != 0:\n            total_sum += num * num\n    return total_sum\n```"}
{"task_id": "HumanEval/147", "solution": "```python\nimport math\n\ndef get_max_triples(n):\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) from the sequence a[x] = x*x - x + 1\n    such that i < j < k and the sum a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n\n    # counts[0] stores the count of elements a[x] such that a[x] % 3 == 0.\n    # counts[1] stores the count of elements a[x] such that a[x] % 3 == 1.\n    # counts[2] stores the count of elements a[x] such that a[x] % 3 == 2.\n    counts = [0, 0, 0]\n\n    for i in range(1, n + 1):\n        # The pattern for (i*i - i + 1) % 3 is 0 if i % 3 == 2, and 1 otherwise.\n        # It never results in 2 modulo 3.\n        val_mod_3 = (i * i - i + 1) % 3\n        counts[val_mod_3] += 1\n\n    count_0 = counts[0]\n    count_1 = counts[1]\n    count_2 = counts[2]\n\n    total_triples = 0\n\n    # A sum (A + B + C) is a multiple of 3 if the sum of their remainders (A%3 + B%3 + C%3) is a multiple of 3.\n    # This can occur in four ways:\n\n    # Case 1: All three elements have a remainder of 0 (mod 3).\n    total_triples += math.comb(count_0, 3)\n\n    # Case 2: All three elements have a remainder of 1 (mod 3).\n    total_triples += math.comb(count_1, 3)\n\n    # Case 3: All three elements have a remainder of 2 (mod 3).\n    # Based on the formula a[i], count_2 will always be 0, so this adds 0.\n    total_triples += math.comb(count_2, 3)\n\n    # Case 4: One element has remainder 0, one has remainder 1, and one has remainder 2 (mod 3).\n    # Based on the formula a[i], count_2 will always be 0, so this adds 0.\n    total_triples += count_0 * count_1 * count_2\n\n    return total_triples"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    # Process the absolute value of the number to count digits\n    abs_num_str = str(abs(num))\n\n    for char_digit in abs_num_str:\n        digit = int(char_digit)\n        if digit % 2 == 0:  # Check if the digit is even (0 is even)\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/153", "solution": "```python\ndef Strongest_Extension(class_name, extensions):\n    \"\"\"This function identifies the strongest extension based on a CAP - SM strength calculation.\n    It returns the class name with the strongest extension, handling ties by choosing the first occurrence.\"\"\"\n\n    if not extensions:\n        return class_name\n\n    max_strength = -float('inf')\n    strongest_ext_name = \"\"\n\n    for ext_name in extensions:\n        cap_count = 0\n        sm_count = 0\n        for char in ext_name:\n            if 'A' <= char <= 'Z':\n                cap_count += 1\n            elif 'a' <= char <= 'z':\n                sm_count += 1\n        current_strength = cap_count - sm_count\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_ext_name = ext_name\n        # If current_strength == max_strength, we keep the existing strongest_ext_name\n        # because it appeared earlier in the list, satisfying the tie-breaking rule.\n\n    return f\"{class_name}.{strongest_ext_name}\"\n```"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n\n    ROMAN_MAP = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'),\n        (1, 'I')\n    ]\n\n    result = []\n\n    for value, symbol in ROMAN_MAP:\n        while number >= value:\n            result.append(symbol)\n            number -= value\n\n    return \"\".join(result).lower()"}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\n    cycpattern_check(\"abcd\",\"abd\") => False\n    cycpattern_check(\"hello\",\"ell\") => True\n    cycpattern_check(\"whassup\",\"psus\") => False\n    cycpattern_check(\"abab\",\"baa\") => True\n    cycpattern_check(\"efef\",\"eeff\") => False\n    cycpattern_check(\"himenss\",\"simen\") => True\n\n    \"\"\"\n\n    def _generate_rotations(s: str) -> list[str]:\n        \"\"\"Generates all unique cyclic rotations of a string.\"\"\"\n        if not s:\n            return [\"\"]\n        rotations = set()\n        n = len(s)\n        for i in range(n):\n            rotated_s = s[i:] + s[:i]\n            rotations.add(rotated_s)\n        return list(rotations)\n\n    if not b:\n        return True # An empty string is considered a substring of any string.\n    if len(b) > len(a):\n        return False # A longer string cannot be a substring of a shorter one.\n\n    rotations_of_b = _generate_rotations(b)\n\n    for rotation in rotations_of_b:\n        if rotation in a:\n            return True\n    return False"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or\n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    # Sort the sides to easily identify the two shorter sides and the longest side (potential hypotenuse).\n    sides = sorted([a, b, c])\n    x, y, z = sides[0], sides[1], sides[2]\n\n    # Use a small epsilon for floating-point comparison to account for precision issues.\n    EPSILON = 1e-9\n\n    # Check if the square of the longest side is approximately equal to the sum of the squares of the other two sides.\n    return abs(x**2 + y**2 - z**2) < EPSILON"}
{"task_id": "HumanEval/158", "solution": "```python\ndef find_max(words):\n    \"\"\"Finds the word with the maximum number of unique characters.\n    If multiple strings have the maximum number of unique characters, returns the one which comes first in lexicographical order.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_count = len(set(word))\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            if not result_word or word < result_word:  # Tie-breaking: lexicographical order\n                result_word = word\n\n    return result_word\n```"}
{"task_id": "HumanEval/161", "solution": "```python\ndef solve(s):\n    \"\"\"Reverses case of letters or reverses the entire string if no letters are present.\"\"\"\n    has_letters = False\n    for char in s:\n        if char.isalpha():\n            has_letters = True\n            break\n\n    if not has_letters:\n        return s[::-1]\n    else:\n        result_chars = []\n        for char in s:\n            if char.isalpha():\n                if char.islower():\n                    result_chars.append(char.upper())\n                else:\n                    result_chars.append(char.lower())\n            else:\n                result_chars.append(char)\n        return \"\".join(result_chars)\n```"}
{"task_id": "HumanEval/152", "solution": "```python\ndef compare(game,guess):\n    \"\"\"Calculates the absolute difference between corresponding scores and guesses.\n    Returns 0 if the guess is correct, otherwise the absolute difference.\n    \"\"\"\n    differences = []\n    for i in range(len(game)):\n        if game[i] == guess[i]:\n            differences.append(0)\n        else:\n            differences.append(abs(game[i] - guess[i]))\n    return differences\n```"}
{"task_id": "HumanEval/159", "solution": "```python\ndef eat(number, need, remaining):\n    \"\"\"\n    Calculates the total number of carrots eaten by the rabbit and\n    the number of carrots left in stock after its meal.\n    \"\"\"\n    carrots_to_eat_from_stock = min(need, remaining)\n\n    total_eaten_carrots = number + carrots_to_eat_from_stock\n    carrots_left_after_meals = remaining - carrots_to_eat_from_stock\n\n    return [total_eaten_carrots, carrots_left_after_meals]\n```"}
{"task_id": "HumanEval/162", "solution": "```python\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    import hashlib\n\n    if not text:\n        return None\n\n    md5_hash = hashlib.md5(text.encode('utf-8')).hexdigest()\n    return md5_hash\n```"}
{"task_id": "HumanEval/163", "solution": "```python\ndef generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    min_val = min(a, b)\n    max_val = max(a, b)\n\n    result = []\n    for i in range(min_val, max_val + 1):\n        # Check if it's an even number and a single-digit even (2, 4, 6, 8)\n        if i % 2 == 0 and 0 <= i <= 9 and i != 0:\n            result.append(i)\n\n    return sorted(result)\n```"}
