{"task_id": "Mbpp/721", "solution": "def maxAverageOfPath(matrix):\n    n = len(matrix)\n    # dp[i][j] = (max_sum, path_length) for reaching cell (i,j)\n    dp = [[(0, 0) for _ in range(n)] for _ in range(n)]\n    \n    # Initialize first cell\n    dp[0][0] = (matrix[0][0], 1)\n    \n    # Fill first row\n    for j in range(1, n):\n        prev_sum, prev_len = dp[0][j-1]\n        dp[0][j] = (prev_sum + matrix[0][j], prev_len + 1)\n    \n    # Fill first column\n    for i in range(1, n):\n        prev_sum, prev_len = dp[i-1][0]\n        dp[i][0] = (prev_sum + matrix[i][0], prev_len + 1)\n    \n    # Fill remaining cells\n    for i in range(1, n):\n        for j in range(1, n):\n            from_top = dp[i-1][j]\n            from_left = dp[i][j-1]\n            \n            top_avg = from_top[0] / from_top[1]\n            left_avg = from_left[0] / from_left[1]\n            \n            if top_avg >= left_avg:\n                dp[i][j] = (from_top[0] + matrix[i][j], from_top[1] + 1)\n            else:\n                dp[i][j] = (from_left[0] + matrix[i][j], from_left[1] + 1)\n    \n    final_sum, final_len = dp[n-1][n-1]\n    return final_sum / final_len"}
{"task_id": "Mbpp/721", "solution": "def maxAverageOfPath(grid):\n    n = len(grid)\n    # dp[i][j] stores (max_sum, path_length) for paths ending at (i, j)\n    dp = [[(0, 0) for _ in range(n)] for _ in range(n)]\n    \n    # Initialize first cell\n    dp[0][0] = (grid[0][0], 1)\n    \n    # Fill first row\n    for j in range(1, n):\n        prev_sum, prev_len = dp[0][j-1]\n        dp[0][j] = (prev_sum + grid[0][j], prev_len + 1)\n    \n    # Fill first column\n    for i in range(1, n):\n        prev_sum, prev_len = dp[i-1][0]\n        dp[i][0] = (prev_sum + grid[i][0], prev_len + 1)\n    \n    # Fill rest of the matrix\n    for i in range(1, n):\n        for j in range(1, n):\n            # Get paths from top and left\n            top_sum, top_len = dp[i-1][j]\n            left_sum, left_len = dp[i][j-1]\n            \n            # Choose path with better average after adding current cell\n            top_avg = (top_sum + grid[i][j]) / (top_len + 1)\n            left_avg = (left_sum + grid[i][j]) / (left_len + 1)\n            \n            if top_avg >= left_avg:\n                dp[i][j] = (top_sum + grid[i][j], top_len + 1)\n            else:\n                dp[i][j] = (left_sum + grid[i][j], left_len + 1)\n    \n    final_sum, final_len = dp[n-1][n-1]\n    return final_sum / final_len"}
