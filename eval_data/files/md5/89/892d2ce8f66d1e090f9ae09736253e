{"task_id": "HumanEval/25", "solution": "def factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    \"\"\"\n    factors = []\n    \n    # Handle factor 2\n    while n % 2 == 0:\n        factors.append(2)\n        n //= 2\n        \n    # Handle odd factors starting from 3\n    d = 3\n    while d * d <= n:\n        while n % d == 0:\n            factors.append(d)\n            n //= d\n        d += 2  # Move to the next odd number\n        \n    # If n is still greater than 1, it must be a prime factor itself\n    if n > 1:\n        factors.append(n)\n        \n    return factors"}
{"task_id": "HumanEval/24", "solution": "def largest_divisor(n: int) -> int:\n    \"\"\" For a given number n, find the largest number that divides n evenly, smaller than n\n    >>> largest_divisor(15)\n    5\n    \"\"\"\n    if n <= 1:\n        return 0\n\n    # Iterate from 2 up to the square root of n to find the smallest factor.\n    # If a factor i is found, then n // i is the largest divisor less than n.\n    i = 2\n    while i * i <= n:\n        if n % i == 0:\n            return n // i\n        i += 1\n\n    # If no factors are found up to sqrt(n), n is a prime number.\n    # For prime numbers, the largest divisor smaller than n is 1.\n    return 1"}
{"task_id": "HumanEval/26", "solution": "def remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    >>> remove_duplicates([1, 2, 3, 2, 4])\n    [1, 3, 4]\n    \"\"\"\n    import collections\n\n    # Count occurrences of each number in the input list.\n    counts = collections.Counter(numbers)\n    result = []\n    # Iterate through the original list and add numbers with a count of 1 to the result.\n    for num in numbers:\n        if counts[num] == 1:\n            result.append(num)\n    return result"}
