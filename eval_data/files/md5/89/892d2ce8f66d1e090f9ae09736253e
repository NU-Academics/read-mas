{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    n = len(l)\n    \n    # Extract elements at even indices\n    even_elements = []\n    for i in range(n):\n        if i % 2 == 0:\n            even_elements.append(l[i])\n            \n    # Sort the extracted even elements\n    even_elements.sort()\n    \n    # Create the new list, populating with sorted even elements and original odd elements\n    result_list = [0] * n  # Initialize with dummy values\n    even_idx_count = 0\n    for i in range(n):\n        if i % 2 == 0:\n            result_list[i] = even_elements[even_idx_count]\n            even_idx_count += 1\n        else:\n            result_list[i] = l[i]\n            \n    return result_list"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # Split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # Reverse cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/36", "solution": "def _is_positive(number: int) -> bool:\n    \"\"\"Determines if the number is greater than 0.\"\"\"\n    return number > 0\ndef _is_divisible_by_11_or_13(number: int) -> bool:\n    \"\"\"Determines if the number is divisible by 11 or by 13.\"\"\"\n    return (number % 11 == 0) or (number % 13 == 0)\ndef _count_digit_7(number: int) -> int:\n    \"\"\"Counts how many times the digit '7' appears in the number.\"\"\"\n    return str(number).count('7')\ndef fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    total_sum = 0\n    # Iterate through positive integers less than n\n    for i in range(1, n):\n        if _is_positive(i): # Checks if the number is positive (ensured by range(1,n))\n            if _is_divisible_by_11_or_13(i):\n                total_sum += _count_digit_7(i)\n    return total_sum"}
{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    # Helper function to check if a number is prime.\n    # It tests divisibility by numbers from 2 up to the square root of num.\n    def is_prime(num: int) -> bool:\n        if num < 2:\n            return False\n        i = 2\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 1\n        return True\n\n    # Initialize the first two Fibonacci numbers (F_0 and F_1).\n    # The loop will generate subsequent Fibonacci numbers, starting with F_2.\n    a, b = 0, 1\n    prime_fib_count = 0\n\n    # Continuously generate Fibonacci numbers until the n-th prime Fibonacci is found.\n    while True:\n        # Calculate the next Fibonacci number in the sequence.\n        next_fib = a + b\n        # Update the sequence for the next iteration.\n        a, b = b, next_fib\n\n        # We are interested in Fibonacci numbers that are also prime.\n        # The first Fibonacci numbers 0 and 1 are not prime.\n        # Check if the generated Fibonacci number is prime.\n        if is_prime(next_fib):\n            prime_fib_count += 1\n            # If we have found the n-th prime Fibonacci number, return it.\n            if prime_fib_count == n:\n                return next_fib"}
