{"task_id": "Mbpp/63", "solution": "```python\ndef max_difference(data: list[tuple[int | float, int | float]]) -> int | float:\n    \"\"\"Calculates the maximum absolute difference between elements within pairs in a list of tuples.\n    Performs robust input validation according to specified requirements.\n    \"\"\"\n    if not isinstance(data, list):\n        raise ValueError(\"Input must be a list.\")\n\n    if not data:\n        return 0\n    \n    # Iterate and validate each item to ensure it's a two-element tuple with numeric elements.\n    for item in data:\n        if not isinstance(item, tuple) or len(item) != 2:\n            raise ValueError(\"Each element in the list must be a two-element tuple.\")\n            \n        if not all(isinstance(x, (int, float)) for x in item):\n            raise TypeError(\"Tuple elements must be numbers (int or float).\")\n\n    # Calculate the maximum absolute difference among all valid tuples.\n    max_diff = 0\n    for a, b in data:\n        diff = abs(a - b)\n        if diff > max_diff:\n            max_diff = diff\n            \n    return max_diff\n```"}
{"task_id": "Mbpp/61", "solution": "```python\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input strings.\n    It carries a descriptive message for the error.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\ndef count_Substrings(input_string: str) -> int:\n    \"\"\"\n    Counts substrings in input_string where the sum of digits equals the substring's length.\n    This function efficiently processes input strings up to 1000 characters using prefix sums.\n    \"\"\"\n    if not isinstance(input_string, str):\n        raise InvalidInputError(\"Input must be a string.\")\n    if not input_string.isdigit() and input_string != \"\":\n        raise InvalidInputError(\"Input string must contain only digits.\")\n\n    n = len(input_string)\n    count = 0\n\n    if n == 0:\n        return 0\n\n    # Precompute prefix sums of digits for O(1) sum calculation\n    prefix_sums = [0] * (n + 1)\n    for k in range(n):\n        prefix_sums[k+1] = prefix_sums[k] + int(input_string[k])\n\n    for i in range(n):\n        for j in range(i, n):\n            # Calculate substring length\n            substring_length = j - i + 1\n            \n            # Calculate sum of digits for the current substring using prefix sums\n            sum_of_digits = prefix_sums[j+1] - prefix_sums[i]\n\n            if sum_of_digits == substring_length:\n                count += 1\n                \n    return count\n```"}
{"task_id": "Mbpp/63", "solution": "```python\ndef max_difference(tuple_list: list[tuple[int | float, int | float]]) -> int | float:\n    \"\"\"Calculates the maximum absolute difference between numbers in pairs.\"\"\"\n    if not isinstance(tuple_list, list):\n        raise TypeError(\"Input must be a list.\")\n    \n    if not tuple_list:\n        return 0.0\n\n    max_diff = 0.0\n    for pair in tuple_list:\n        if not isinstance(pair, tuple):\n            raise TypeError(f\"Expected a tuple, got {type(pair).__name__}\")\n        if len(pair) != 2:\n            raise ValueError(f\"Expected a tuple of two elements, got {len(pair)}\")\n        \n        num1, num2 = pair\n        if not isinstance(num1, (int, float)) or not isinstance(num2, (int, float)):\n            raise TypeError(f\"Expected numeric values in tuple, got {type(num1).__name__}, {type(num2).__name__}\")\n        \n        diff = abs(num1 - num2)\n        if diff > max_diff:\n            max_diff = diff\n    return max_diff\n```"}
{"task_id": "Mbpp/65", "solution": "```python\ndef recursive_list_sum(input_list: list) -> (int | float):\n    \"\"\"\n    Flattens a potentially nested list and sums all its numeric elements.\n    Raises TypeError if the input is not a list.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    total_sum = 0\n    for item in input_list:\n        if isinstance(item, list):\n            total_sum += recursive_list_sum(item)\n        elif isinstance(item, (int, float)):\n            total_sum += item\n    return total_sum\n```"}
