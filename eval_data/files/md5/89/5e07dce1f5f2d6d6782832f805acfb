{"task_id": "Mbpp/631", "solution": "```python\n_TEMP_SWAP_PLACEHOLDER = \"_TEMP_SWAP_\"\n\ndef replace_spaces(input_string: str) -> str:\n    \"\"\"Swaps spaces with underscores and vice-versa in the input string.\n    Raises TypeError if input_string is not a string.\n    \"\"\"\n    if not isinstance(input_string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    # Temporarily replace spaces to avoid conflict with underscore replacement.\n    temp_string = input_string.replace(' ', _TEMP_SWAP_PLACEHOLDER)\n    \n    # Replace actual underscores with spaces.\n    swapped_underscores = temp_string.replace('_', ' ')\n    \n    # Finally, replace the temporary placeholder with underscores.\n    final_string = swapped_underscores.replace(_TEMP_SWAP_PLACEHOLDER, '_')\n\n    return final_string\n```"}
{"task_id": "Mbpp/632", "solution": "```python\ndef move_zero(numbers_list: list[int | float]) -> list[int | float]:\n    \"\"\"Moves all zero elements to the end of the list, preserving the order of non-zero elements.\n    Returns a new list, leaving the original list unchanged.\n    \"\"\"\n    if not isinstance(numbers_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    non_zeros = []\n    zero_count = 0\n\n    for num in numbers_list:\n        if num == 0:\n            zero_count += 1\n        else:\n            non_zeros.append(num)\n\n    return non_zeros + [0] * zero_count\n```"}
{"task_id": "Mbpp/632", "solution": "```python\ndef move_zero(data_list: list) -> None:\n    \"\"\"\n    Reorders the list in-place, moving all zero elements to its end.\n    The relative order of non-zero elements is preserved.\n    \"\"\"\n    if not isinstance(data_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    if not data_list:\n        return\n\n    non_zero_ptr = 0\n    for current_ptr in range(len(data_list)):\n        if data_list[current_ptr] != 0:\n            data_list[non_zero_ptr], data_list[current_ptr] = data_list[current_ptr], data_list[non_zero_ptr]\n            non_zero_ptr += 1\n\n```"}
{"task_id": "Mbpp/633", "solution": "```python\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input types or values.\"\"\"\n    pass\n\nclass LengthMismatchError(ValueError):\n    \"\"\"Custom exception for when provided length does not match actual list length.\"\"\"\n    pass\n\nMAX_BIT_LENGTH = 31\n\ndef pair_xor_Sum(numbers: list[int], length: int) -> int:\n    \"\"\"\n    Calculates the sum of XOR of all unique pairs in the given list of numbers.\n    It first validates the input list and its length before computation.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise InvalidInputError(\"Input 'numbers' must be a list.\")\n    if not isinstance(length, int):\n        raise InvalidInputError(\"Input 'length' must be an integer.\")\n    \n    for i, num in enumerate(numbers):\n        if not isinstance(num, int):\n            raise InvalidInputError(f\"Element at index {i} ('{num}') is not an integer.\")\n        if num < 0:\n            raise InvalidInputError(f\"Element at index {i} ('{num}') must be a non-negative integer.\")\n\n    if len(numbers) != length:\n        raise LengthMismatchError(f\"Length mismatch. Provided length ({length}) does not match actual list length ({len(numbers)}).\")\n\n    n = len(numbers)\n    if n < 2:\n        return 0\n\n    total_xor_sum = 0\n\n    for i in range(MAX_BIT_LENGTH):\n        count_set_bits = 0\n        for num in numbers:\n            if (num >> i) & 1:\n                count_set_bits += 1\n        \n        count_unset_bits = n - count_set_bits\n        \n        # Each pair with a differing bit at this position contributes (1 << i) to the sum.\n        total_xor_sum += (count_set_bits * count_unset_bits) * (1 << i)\n            \n    return total_xor_sum\n```"}
{"task_id": "Mbpp/633", "solution": "```python\ndef pair_xor_Sum(numbers, n_elements):\n    \"\"\"Calculates the sum of XOR of all unique pairs in a list of numbers.\n    It uses a bit manipulation approach for efficiency.\"\"\"\n\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input 'numbers' must be a list.\")\n    if not isinstance(n_elements, int):\n        raise TypeError(\"Input 'n_elements' must be an integer.\")\n    if n_elements != len(numbers):\n        raise ValueError(\"The 'n_elements' parameter must match the length of the 'numbers' list.\")\n\n    for num in numbers:\n        if not isinstance(num, int):\n            raise ValueError(\"All elements in the 'numbers' list must be integers.\")\n\n    if n_elements < 2:\n        return 0\n\n    total_sum = 0\n    # Iterates through bit positions, typically up to 32 for common integer sizes.\n    MAX_BITS = 32 \n\n    for i in range(MAX_BITS):\n        count_set_bit = 0\n        for num in numbers:\n            if (num >> i) & 1:\n                count_set_bit += 1\n        \n        count_unset_bit = n_elements - count_set_bit\n        \n        total_sum += (count_set_bit * count_unset_bit) * (1 << i)\n    \n    return total_sum\n```"}
{"task_id": "Mbpp/635", "solution": "```python\ndef _heapify(data: list, n: int, i: int) -> None:\n    \"\"\"\n    Maintains the max-heap property in a subtree rooted at index i.\n    Assumes subtrees rooted at left_child and right_child are already heaps.\n    \"\"\"\n    largest = i\n    left_child = 2 * i + 1\n    right_child = 2 * i + 2\n\n    if left_child < n and data[largest] < data[left_child]:\n        largest = left_child\n\n    if right_child < n and data[largest] < data[right_child]:\n        largest = right_child\n\n    if largest != i:\n        data[i], data[largest] = data[largest], data[i]\n        _heapify(data, n, largest)\n\n\ndef _build_max_heap(data: list) -> None:\n    \"\"\"\n    Converts an arbitrary list into a max-heap.\n    It does this by calling _heapify on all non-leaf nodes, starting from the last.\n    \"\"\"\n    n = len(data)\n    for i in range(n // 2 - 1, -1, -1):\n        _heapify(data, n, i)\n\n\ndef heap_sort(data: list) -> None:\n    \"\"\"\n    Sorts a list of comparable elements in ascending order using the heap sort algorithm, in-place.\n    It first builds a max-heap and then repeatedly extracts the maximum element.\n    \"\"\"\n    if not isinstance(data, list):\n        raise TypeError(\"Input 'data' must be a list.\")\n\n    n = len(data)\n\n    _build_max_heap(data)\n\n    for i in range(n - 1, 0, -1):\n        data[i], data[0] = data[0], data[i]\n        _heapify(data, i, 0)\n\n```"}
{"task_id": "Mbpp/635", "solution": "```python\ndef heap_sort(data_list: list) -> None:\n    \"\"\"Sorts a list in ascending order using the Heap Sort algorithm. The sorting is performed in-place.\"\"\"\n\n    def _heapify(data_list: list, n: int, i: int) -> None:\n        \"\"\"Performs the heapify operation on a subtree rooted at index i, ensuring it's a max-heap.\"\"\"\n        largest = i\n        left = 2 * i + 1\n        right = 2 * i + 2\n\n        if left < n and data_list[largest] < data_list[left]:\n            largest = left\n\n        if right < n and data_list[largest] < data_list[right]:\n            largest = right\n\n        if largest != i:\n            data_list[i], data_list[largest] = data_list[largest], data_list[i]\n            _heapify(data_list, n, largest)\n\n    n = len(data_list)\n\n    # Build a maxheap.\n    for i in range(n // 2 - 1, -1, -1):\n        _heapify(data_list, n, i)\n\n    # One by one extract elements.\n    for i in range(n - 1, 0, -1):\n        data_list[i], data_list[0] = data_list[0], data_list[i]\n        _heapify(data_list, i, 0)\n```"}
