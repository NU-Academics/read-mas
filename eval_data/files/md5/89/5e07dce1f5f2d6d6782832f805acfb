{"task_id": "Mbpp/279", "solution": "def is_num_decagonal(n: int) -> int:\n    \"\"\"Calculates the nth decagonal number.\n    'n' must be a positive integer.\"\"\"\n    # Custom exception for invalid input parameters.\n    class InvalidInputError(ValueError):\n        \"\"\"Custom exception for invalid input parameters.\n        It provides a descriptive message for the error.\"\"\"\n        def __init__(self, message: str):\n            super().__init__(message)\n            self.message = message\n\n    # Helper function to validate if a value is a positive integer.\n    def _validate_positive_integer(value: Any, name: str) -> None:\n        \"\"\"Checks if 'value' is an integer strictly greater than 0.\n        Raises InvalidInputError if the validation fails.\"\"\"\n        if not isinstance(value, int) or value <= 0:\n            raise InvalidInputError(f\"'{name}' must be a positive integer.\")\n\n    _validate_positive_integer(n, \"n\")\n    return n * (4 * n - 3)"}
