{"task_id": "Mbpp/94", "solution": "```python\ndef index_minimum(data_list: list[tuple]) -> any:\n    \"\"\"\n    Identifies the first element of a tuple with the smallest second value in a list of tuples.\n    Handles various input validation errors and returns the first element on success.\n    \"\"\"\n    if not isinstance(data_list, list):\n        raise TypeError(\"Input must be a list.\")\n    if not data_list:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    min_value = float('inf')\n    result = None\n\n    for item in data_list:\n        if not isinstance(item, tuple):\n            raise TypeError(f\"List elements must be tuples, but found {type(item).__name__}.\")\n        if len(item) < 2:\n            raise IndexError(\"Each tuple must have at least two elements.\")\n\n        current_value = item[1]\n        # The first tuple encountered with the smallest second value takes precedence.\n        if current_value < min_value:\n            min_value = current_value\n            result = item[0]\n            \n    return result\n```"}
{"task_id": "Mbpp/94", "solution": "```python\nfrom typing import List, Tuple\n\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input data format or content.\"\"\"\n    pass\n\ndef index_minimum(data: List[Tuple[str, int]]) -> str:\n    \"\"\"\n    Identifies the item string from a list of (string, integer) tuples\n    that has the smallest associated integer value. The first such item is returned if ties occur.\n    \"\"\"\n    if not isinstance(data, list):\n        raise TypeError(\"Input 'data' must be a list.\")\n\n    if not data:\n        raise ValueError(\"Input 'data' list cannot be empty.\")\n\n    min_tuple = None\n    for item in data:\n        if not isinstance(item, tuple) or len(item) != 2:\n            raise InvalidInputError(\n                f\"Each element in 'data' must be a tuple of (str, int). Found: {item}\"\n            )\n        if not isinstance(item[0], str) or not isinstance(item[1], int):\n            raise InvalidInputError(\n                f\"Each tuple must contain (str, int). Found: ({type(item[0]).__name__}, {type(item[1]).__name__})\"\n            )\n\n        if min_tuple is None or item[1] < min_tuple[1]:\n            min_tuple = item\n        \n    # This check is defensive; min_tuple should not be None if data was validated as non-empty.\n    if min_tuple is None:\n        raise ValueError(\"No valid tuples found after initial checks, which should not happen.\")\n\n    return min_tuple[0]\n```"}
{"task_id": "Mbpp/97", "solution": "```python\nfrom collections import Counter\nfrom typing import Any, List, Dict\n\ndef frequency_lists(nested_list: List[Any]) -> Dict[Any, int]:\n    \"\"\"Flattens a list of lists and returns the frequency of each element.\n    Raises TypeError if input is not a list or if elements are unhashable.\n    \"\"\"\n    if not isinstance(nested_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    def _flatten_list(current_list: List[Any]) -> List[Any]:\n        \"\"\"Recursively flattens a list of lists into a single-dimensional list.\"\"\"\n        flat = []\n        for item in current_list:\n            if isinstance(item, list):\n                flat.extend(_flatten_list(item))\n            else:\n                flat.append(item)\n        return flat\n\n    flattened = _flatten_list(nested_list)\n    return dict(Counter(flattened))\n```"}
{"task_id": "Mbpp/97", "solution": "from collections import Counter\nfrom typing import Any, List, Dict\n\ndef frequency_lists(list_of_lists: List[List[Any]]) -> Dict[Any, int]:\n    \"\"\"\n    Calculates the frequency of each element in a flattened list of lists.\n    It returns a dictionary where keys are unique elements and values are their counts.\n    \"\"\"\n    if not isinstance(list_of_lists, list):\n        raise TypeError(\"Input must be a list.\")\n\n    flattened_list = []\n    for sublist in list_of_lists:\n        if not isinstance(sublist, list):\n            raise TypeError(\"All elements in the input list must be lists.\")\n        flattened_list.extend(sublist)\n\n    return dict(Counter(flattened_list))"}
{"task_id": "Mbpp/96", "solution": "```python\nimport math\n\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input values.\n    It inherits from Python's built-in ValueError.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\ndef divisor(n: int) -> int:\n    \"\"\"Calculates the total number of divisors for a positive integer n.\n    It performs input validation and uses an optimized square root iteration method.\n    \"\"\"\n    # Validate input: must be an integer and positive as per FR1 and NFR3.\n    if not isinstance(n, int):\n        raise InvalidInputError(f\"Input must be an integer, but got {type(n).__name__}.\")\n    if n < 1:  # MIN_INTEGER_VALUE is 1 from the design.\n        raise InvalidInputError(f\"Input must be a positive integer (>= 1), but got {n}.\")\n\n    if n == 1:\n        return 1\n\n    count = 0\n    # Iterate from 1 up to the square root of n.\n    for i in range(1, int(math.sqrt(n)) + 1):\n        if n % i == 0:\n            if i * i == n:\n                count += 1  # If i is the square root, it's a single divisor.\n            else:\n                count += 2  # Otherwise, i and n/i are two distinct divisors.\n    return count\n```"}
{"task_id": "Mbpp/96", "solution": "```python\ndef divisor(number: int) -> int:\n    \"\"\"Calculates the number of positive divisors for a given integer.\n    Raises ValueError if the input is not a positive integer.\n    \"\"\"\n    if not isinstance(number, int) or number <= 0:\n        raise ValueError(\"Input must be a positive integer.\")\n\n    count = 0\n    i = 1\n    while i * i <= number:\n        if number % i == 0:\n            if i * i == number:\n                count += 1  # 'i' is the square root, so it's counted once.\n            else:\n                count += 2  # 'i' and 'number/i' are two distinct divisors.\n        i += 1\n    return count\n```"}
{"task_id": "Mbpp/95", "solution": "```python\ndef Find_Min_Length(list_of_lists):\n    \"\"\"\n    Finds the length of the smallest list in a list of lists.\n\n    Args:\n        list_of_lists: A list where each element is expected to be another list.\n\n    Returns:\n        The integer length of the smallest inner list.\n\n    Raises:\n        TypeError: If the input is not a list or if any element within\n                   the input list is not a list.\n        ValueError: If the input list of lists is empty.\n    \"\"\"\n    if not isinstance(list_of_lists, list):\n        raise TypeError(\"Input must be a list.\")\n\n    if not list_of_lists:\n        raise ValueError(\"Input list of lists cannot be empty.\")\n\n    min_len = float('inf')\n    for inner_list in list_of_lists:\n        if not isinstance(inner_list, list):\n            raise TypeError(\"All elements in the input must be lists.\")\n        min_len = min(min_len, len(inner_list))\n    return min_len\n```"}
{"task_id": "Mbpp/98", "solution": "```python\ndef multiply_num(numbers: list[float | int]) -> float:\n    \"\"\"\n    Calculates the product of numbers in a list and divides by the list's length.\n    Raises ValueError for empty lists or TypeError for non-numeric elements.\n    \"\"\"\n    if not numbers:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    product = 1.0\n    for num in numbers:\n        if not isinstance(num, (int, float)):\n            raise TypeError(\"All elements in the list must be numeric.\")\n        product *= num\n\n    return product / len(numbers)\n```"}
{"task_id": "Mbpp/99", "solution": "```python\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input to conversion functions.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\ndef decimal_to_binary(decimal_number: int) -> str:\n    \"\"\"\n    Converts a non-negative decimal integer to its binary string representation.\n    Raises InvalidInputError for invalid inputs.\n    \"\"\"\n    if not isinstance(decimal_number, int):\n        raise InvalidInputError(\"Invalid input: must be an integer.\")\n    if decimal_number < 0:\n        raise InvalidInputError(\"Invalid input: must be a non-negative integer.\")\n    \n    if decimal_number == 0:\n        return \"0\"\n\n    binary_string = \"\"\n    temp_number = decimal_number\n    while temp_number > 0:\n        remainder = temp_number % 2\n        binary_string = str(remainder) + binary_string\n        temp_number //= 2\n    \n    return binary_string\n```"}
{"task_id": "Mbpp/99", "solution": "```python\ndef decimal_to_binary(decimal_num: int) -> str:\n    \"\"\"Converts a non-negative decimal integer to its binary string representation.\n    Raises ValueError for negative or non-integer inputs.\n    \"\"\"\n    if not isinstance(decimal_num, int) or decimal_num < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n\n    if decimal_num == 0:\n        return \"0\"\n\n    binary_representation = \"\"\n    while decimal_num > 0:\n        remainder = decimal_num % 2\n        binary_representation = str(remainder) + binary_representation\n        decimal_num //= 2\n    \n    return binary_representation\n```"}
{"task_id": "Mbpp/100", "solution": "```python\ndef _is_palindrome(s: str) -> bool:\n    \"\"\"Checks if a given string is a palindrome.\"\"\"\n    return s == s[::-1]\n\ndef _increment_string_number(s: str) -> str:\n    \"\"\"Increments a string representation of a number by one, handling carry-overs.\"\"\"\n    num = int(s) + 1\n    return str(num)\n\ndef next_smallest_palindrome(n: int) -> int:\n    \"\"\"\n    Calculates and returns the next smallest palindrome strictly greater than n.\n    Raises ValueError if n is not an integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input must be an integer.\")\n    \n    current_num_str = str(n + 1)\n    while not _is_palindrome(current_num_str):\n        current_num_str = _increment_string_number(current_num_str)\n    return int(current_num_str)\n```"}
{"task_id": "Mbpp/102", "solution": "```python\ndef snake_to_camel(snake_case_string: str) -> str:\n    \"\"\"Converts a snake_case string to a PascalCase string.\n    This function handles empty strings, multiple underscores, and leading/trailing underscores.\n    \"\"\"\n    if not isinstance(snake_case_string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    words = snake_case_string.split('_')\n    camel_case_words = [word.capitalize() for word in words if word]\n    return \"\".join(camel_case_words)\n```"}
{"task_id": "Mbpp/101", "solution": "```python\nfrom typing import Any, List\n\nclass KthElementError(Exception):\n    \"\"\"Custom exception for errors finding the kth element.\n    It indicates issues with the provided index k or an empty array.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\ndef kth_element(array: List[Any], k: int) -> Any:\n    \"\"\"Finds the element at the 1-based kth position in the array.\n    Raises KthElementError if k is out of bounds or the array is empty.\"\"\"\n    if not array:\n        raise KthElementError(\"Cannot find kth element in an empty array.\")\n    if not (1 <= k <= len(array)):\n        raise KthElementError(\n            f\"Index k ({k}) is out of bounds for array of length {len(array)}. \"\n            \"k must be between 1 and len(array) inclusive.\"\n        )\n    return array[k - 1]\n```"}
{"task_id": "Mbpp/101", "solution": "```python\ndef kth_element(array: list, k: int) -> any:\n    \"\"\"\n    Finds the kth element (1-based indexing) in the given array after sorting.\n    It ensures `k` is within bounds and the array is not empty.\n    \"\"\"\n    if not array:\n        raise ValueError(\"Input array cannot be empty.\")\n    if not (1 <= k <= len(array)):\n        raise IndexError(f\"k ({k}) is out of bounds for array of length {len(array)}.\")\n\n    sorted_array = sorted(array)\n    return sorted_array[k - 1]\n```"}
{"task_id": "Mbpp/102", "solution": "```python\ndef snake_to_camel(snake_str: str) -> str:\n    \"\"\"Converts a snake_case string to CamelCase.\"\"\"\n    if not isinstance(snake_str, str):\n        raise TypeError(\"Input must be a string.\")\n\n    components = snake_str.split('_')\n    # Capitalize each word and join them, filtering out empty parts.\n    return \"\".join(word.capitalize() for word in components if word)\n```"}
{"task_id": "Mbpp/100", "solution": "def _is_palindrome(n: int) -> bool:\n    \"\"\"Checks if an integer is a palindrome.\n    Negative numbers are not considered palindromes here.\"\"\"\n    if n < 0:\n        return False\n    s = str(n)\n    return s == s[::-1]\n\ndef next_smallest_palindrome(n: int) -> int:\n    \"\"\"Finds the next smallest palindrome strictly greater than the given integer n.\n    Raises TypeError if input is not an integer.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n\n    # Determine the starting number to check.\n    # If n is negative, the next palindrome must be non-negative.\n    current_num = 0 if n < 0 else n + 1\n\n    while True:\n        if _is_palindrome(current_num):\n            return current_num\n        current_num += 1"}
