{"task_id": "Mbpp/306", "solution": "```python\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\ndef max_sum_increasing_subseq(arr: list[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Calculates the maximum sum of an increasing subsequence from arr[0...i]\n    and also including the element at index k (where k > i).\n    \"\"\"\n    # Validate input parameters n, i, and k.\n    if not (0 <= i < n):\n        raise InvalidInputError(f\"Index i ({i}) is out of bounds for array of length {n}.\")\n    if not (i < k < n):\n        raise InvalidInputError(f\"Index k ({k}) must be greater than i ({i}) and less than array length {n}.\")\n\n    # Compute the maximum sum of an increasing subsequence (MSIS) for all prefixes ending at each index j from 0 to i.\n    dp_sums = [0] * (i + 1)\n    for x in range(i + 1):\n        dp_sums[x] = arr[x]\n        for y in range(x):\n            if arr[x] > arr[y]:\n                dp_sums[x] = max(dp_sums[x], dp_sums[y] + arr[x])\n\n    # Initialize max_prefix_sum to 0.\n    max_prefix_sum = 0\n    # Iterate through the computed MSIS sums for indices j from 0 to i.\n    for j in range(i + 1):\n        # If arr[j] is less than arr[k], update max_prefix_sum.\n        if arr[j] < arr[k]:\n            max_prefix_sum = max(max_prefix_sum, dp_sums[j])\n    \n    # The total sum includes arr[k].\n    return max_prefix_sum + arr[k]\n```"}
{"task_id": "Mbpp/308", "solution": "```python\ndef validate_inputs(list1: list, list2: list, n: int) -> None:\n    \"\"\"\n    Validates the input lists and the number 'n'.\n    Raises ValueError for invalid inputs.\n    \"\"\"\n    if not list1:\n        raise ValueError(\"The first list (list1) cannot be empty.\")\n    if not list2:\n        raise ValueError(\"The second list (list2) cannot be empty.\")\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"The number 'n' must be a positive integer.\")\n\nclass ProductFinderService:\n    \"\"\"\n    Service class for finding the largest products from two lists.\n    It encapsulates the core business logic.\n    \"\"\"\n\n    def find_largest_products(self, list1: list[int | float], list2: list[int | float], n: int) -> list[int | float]:\n        \"\"\"\n        Calculates and returns the 'n' largest products from two lists.\n        Products are returned in descending order.\n        \"\"\"\n        all_products = self._generate_all_products(list1, list2)\n        all_products.sort(reverse=True)\n        return all_products[:n]\n\n    def _generate_all_products(self, list1: list[int | float], list2: list[int | float]) -> list[int | float]:\n        \"\"\"\n        Generates all possible products from list1 and list2.\n        Each product is formed by one factor from each list.\n        \"\"\"\n        products = []\n        for x in list1:\n            for y in list2:\n                products.append(x * y)\n        return products\n\ndef large_product(list1: list[int | float], list2: list[int | float], n: int) -> list[int | float]:\n    \"\"\"\n    Finds the specified number of largest products from two given lists.\n    It selects one factor from each list.\n    \"\"\"\n    validate_inputs(list1, list2, n)\n    service = ProductFinderService()\n    return service.find_largest_products(list1, list2, n)\n```"}
{"task_id": "Mbpp/306", "solution": "```python\ndef max_sum_increasing_subseq(arr: list[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Calculates the maximum sum of an increasing subsequence from arr[0...i], including arr[k].\n    All elements in the prefix subsequence must be strictly less than arr[k].\n    \"\"\"\n\n    class InvalidInputError(Exception):\n        \"\"\"Custom exception for invalid input conditions.\n        This class is used to signal specific input validation failures.\n        \"\"\"\n        def __init__(self, message: str):\n            super().__init__(message)\n            self.message = message\n\n    def _validate_inputs(arr: list[int], n: int, i: int, k: int) -> None:\n        \"\"\"Validates all input parameters according to business rules.\n        Raises InvalidInputError if any validation fails.\n        \"\"\"\n        if not isinstance(arr, list) or not all(isinstance(x, int) for x in arr):\n            raise InvalidInputError(\"Input array 'arr' must be a list of integers.\")\n        if n != len(arr):\n            raise InvalidInputError(\"Input 'n' must be the length of 'arr'.\")\n        if not (0 <= i < n):\n            raise InvalidInputError(f\"Index 'i' ({i}) is out of bounds [0, {n-1}].\")\n        if not (0 <= k < n):\n            raise InvalidInputError(f\"Index 'k' ({k}) is out of bounds [0, {n-1}].\")\n        if k <= i:\n            raise InvalidInputError(f\"Index 'k' ({k}) must be strictly greater than 'i' ({i}).\")\n\n    def _calculate_max_sum_prefix(arr: list[int], i: int, k_val: int) -> int:\n        \"\"\"Calculates the maximum sum of an increasing subsequence from arr[0...i] where all elements are less than k_val.\n        This uses a dynamic programming approach to find the optimal sum.\n        \"\"\"\n        if i < 0:\n            return 0\n\n        # dp[j] stores the maximum sum of an increasing subsequence ending at arr[j],\n        # with all elements in the subsequence strictly less than k_val.\n        dp = [0] * (i + 1)\n        max_prefix_sum = 0\n\n        for j in range(i + 1):\n            # Only consider arr[j] if it's strictly less than k_val.\n            if arr[j] < k_val:\n                dp[j] = arr[j] # Base case: subsequence contains only arr[j].\n                for x in range(j):\n                    # If arr[j] can extend an increasing subsequence ending at arr[x].\n                    # dp[x] already accounts for elements being less than k_val.\n                    if arr[j] > arr[x]:\n                        dp[j] = max(dp[j], dp[x] + arr[j])\n                max_prefix_sum = max(max_prefix_sum, dp[j])\n\n        return max_prefix_sum\n\n    _validate_inputs(arr, n, i, k)\n\n    k_val = arr[k]\n    max_prefix_sum = _calculate_max_sum_prefix(arr, i, k_val)\n\n    return max_prefix_sum + k_val\n```\n"}
