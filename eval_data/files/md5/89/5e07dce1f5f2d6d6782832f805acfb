{"task_id": "Mbpp/479", "solution": "```python\nfrom typing import Union\n\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input types or values.\"\"\"\n    pass\n\ndef first_Digit(number: Union[int, float]) -> int:\n    \"\"\"\n    Finds the first digit of a given number (integer or float).\n    Handles positive, negative, and zero values; for floats, it uses the integer part.\n    \"\"\"\n    if not isinstance(number, (int, float)):\n        raise InvalidInputError(\"Input must be an integer or a float.\")\n\n    # Explicitly handle zero values as its first digit is 0.\n    if number == 0:\n        return 0\n\n    # Convert the absolute value of the number to a string.\n    abs_number_str = str(abs(number))\n\n    # If it's a float, take only the integer part before the decimal point.\n    if '.' in abs_number_str:\n        abs_number_str = abs_number_str.split('.')[0]\n\n    # Return the first character converted to an integer.\n    return int(abs_number_str[0])\n```"}
{"task_id": "Mbpp/555", "solution": "```python\ndef difference(n: int) -> int:\n    \"\"\"\n    Calculates the difference between the sum of cubes of the first 'n' natural numbers\n    and the sum of the first 'n' natural numbers.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    # Calculate the sum of the first n natural numbers.\n    sum_n = n * (n + 1) // 2\n\n    # Calculate the sum of cubes of the first n natural numbers.\n    sum_cubes_n = sum_n * sum_n\n\n    return sum_cubes_n - sum_n\n```"}
{"task_id": "Mbpp/476", "solution": "```python\ndef big_sum(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the sum of the largest and smallest elements in a given array.\n\n    Args:\n        arr: A list of integers.\n\n    Returns:\n        The sum of the minimum and maximum elements.\n\n    Raises:\n        TypeError: If the input is not a list.\n        ValueError: If the list contains non-integer elements or is empty.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input must be a list.\")\n    if not all(isinstance(x, int) for x in arr):\n        raise ValueError(\"All elements in the list must be integers.\")\n    if not arr:\n        # Python's min() and max() raise ValueError for empty sequences,\n        # which aligns with the design's intent for EmptyArrayError conceptually.\n        raise ValueError(\"Input array cannot be empty.\")\n\n    min_val = min(arr)\n    max_val = max(arr)\n    return min_val + max_val\n```"}
{"task_id": "Mbpp/554", "solution": "```python\nfrom typing import List\n\ndef Split(integer_list: List[int]) -> List[int]:\n    \"\"\"\n    Filters a list of integers, retaining only the odd numbers.\n    Raises TypeError or ValueError for invalid input or non-integer elements.\n    \"\"\"\n    if not isinstance(integer_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    odd_numbers = []\n    for number in integer_list:\n        if not isinstance(number, int):\n            raise ValueError(f\"List element '{number}' is not an integer.\")\n        if number % 2 != 0:\n            odd_numbers.append(number)\n    return odd_numbers\n```"}
{"task_id": "Mbpp/555", "solution": "```python\ndef _sum_natural_numbers(n: int) -> int:\n    \"\"\"Calculates the sum of the first n natural numbers.\"\"\"\n    return n * (n + 1) // 2\n\ndef _sum_cubes(n: int) -> int:\n    \"\"\"Calculates the sum of the cubes of the first n natural numbers.\"\"\"\n    sum_n = _sum_natural_numbers(n)\n    return sum_n * sum_n\n\ndef difference(n: int) -> int:\n    \"\"\"\n    Calculates the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers. Raises ValueError for invalid input.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    sum_of_cubes = _sum_cubes(n)\n    sum_of_numbers = _sum_natural_numbers(n)\n\n    return sum_of_cubes - sum_of_numbers\n```"}
{"task_id": "Mbpp/557", "solution": "```python\ndef toggle_string(input_string: str) -> str:\n    \"\"\"Toggles the case of alphabetic characters in a string.\n    Non-alphabetic characters remain unchanged, and a TypeError is raised for non-string inputs.\"\"\"\n    if not isinstance(input_string, str):\n        raise TypeError(\"Input must be a string.\")\n    return input_string.swapcase()\n```"}
{"task_id": "Mbpp/557", "solution": "```python\ndef toggle_string(input_string: str) -> str:\n    \"\"\"\n    Toggles the case of all alphabetic characters in a string.\n    Non-alphabetic characters remain unchanged.\n    \"\"\"\n    toggled_chars = []\n    for char in input_string:\n        if char.islower():\n            toggled_chars.append(char.upper())\n        elif char.isupper():\n            toggled_chars.append(char.lower())\n        else:\n            toggled_chars.append(char)\n    return \"\".join(toggled_chars)\n```"}
{"task_id": "Mbpp/556", "solution": "```python\ndef find_Odd_Pair(numbers: list[int], n: int) -> int:\n    \"\"\"\n    Counts pairs of numbers from a list whose bitwise XOR sum is odd.\n    A pair (a, b) has an odd XOR sum if one number is even and the other is odd.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise ValueError(\"Input 'numbers' must be a list.\")\n    if not isinstance(n, int):\n        raise ValueError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' cannot be negative.\")\n    if len(numbers) != n:\n        raise ValueError(f\"Input 'n' ({n}) does not match the length of 'numbers' ({len(numbers)}).\")\n\n    even_count = 0\n    odd_count = 0\n\n    for num in numbers:\n        if not isinstance(num, int):\n            raise TypeError(f\"All elements in 'numbers' must be integers, found type {type(num)}.\")\n        if num % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return even_count * odd_count\n\n```"}
{"task_id": "Mbpp/556", "solution": "```python\ndef find_Odd_Pair(numbers: list[int], length: int) -> int:\n    \"\"\"\n    Counts pairs of integers in a list whose bitwise XOR sum is odd.\n    An XOR sum is odd if one number is odd and the other is even.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input 'numbers' must be a list.\")\n    # The 'length' parameter is redundant and is ignored as list length can be determined.\n\n    odd_count = 0\n    even_count = 0\n\n    for i, num in enumerate(numbers):\n        if not isinstance(num, int):\n            raise ValueError(f\"List element at index {i} is not an integer: {num}\")\n        if num % 2 != 0:\n            odd_count += 1\n        else:\n            even_count += 1\n    \n    # The XOR sum (a ^ b) is odd if and only if one of 'a' or 'b' is odd and the other is even.\n    return odd_count * even_count\n```"}
{"task_id": "Mbpp/558", "solution": "```python\ndef digit_distance_nums(num1: int, num2: int) -> int:\n    \"\"\"\n    Computes the sum of absolute differences between corresponding digits of two integers.\n    Shorter numbers are conceptually padded with leading zeros for comparison.\n    \"\"\"\n    s_num1 = str(num1)\n    s_num2 = str(num2)\n\n    max_len = max(len(s_num1), len(s_num2))\n\n    s_num1 = s_num1.zfill(max_len)\n    s_num2 = s_num2.zfill(max_len)\n\n    total_diff = 0\n    for i in range(max_len):\n        digit1 = int(s_num1[i])\n        digit2 = int(s_num2[i])\n        total_diff += abs(digit1 - digit2)\n\n    return total_diff\n```"}
{"task_id": "Mbpp/558", "solution": "```python\ndef digit_distance_nums(num1: int, num2: int) -> int:\n    \"\"\"\n    Calculates the sum of per-digit absolute differences between two non-negative integers.\n    The shorter number is conceptually padded with leading zeros for comparison.\n    \"\"\"\n    s_num1 = str(num1)\n    s_num2 = str(num2)\n\n    # Pad the shorter string with leading zeros to match the length of the longer string.\n    max_len = max(len(s_num1), len(s_num2))\n    padded_s_num1 = s_num1.zfill(max_len)\n    padded_s_num2 = s_num2.zfill(max_len)\n\n    # Sum the absolute differences for each corresponding digit.\n    total_difference = 0\n    for i in range(max_len):\n        digit1 = int(padded_s_num1[i])\n        digit2 = int(padded_s_num2[i])\n        total_difference += abs(digit1 - digit2)\n    return total_difference\n```"}
{"task_id": "Mbpp/560", "solution": "```python\ndef union_elements(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Computes the union of elements from two given tuples and returns them in sorted order.\n    Raises TypeError if inputs are not tuples or if elements are not comparable.\n    \"\"\"\n    if not isinstance(tuple1, tuple) or not isinstance(tuple2, tuple):\n        raise TypeError(\"Both inputs must be tuples.\")\n\n    combined_set = set(tuple1) | set(tuple2)\n    sorted_list = sorted(list(combined_set))\n\n    return tuple(sorted_list)\n```"}
{"task_id": "Mbpp/559", "solution": "```python\ndef max_sub_array_sum(nums: list[int | float], n: int) -> int | float:\n    \"\"\"\n    Finds the sum of the largest contiguous sublist in the given list using Kadane's algorithm.\n    It returns 0 if the list is empty, or the largest negative number if all numbers are negative.\n    \"\"\"\n    if not nums:\n        return 0\n\n    max_so_far = float('-inf')\n    current_max = 0\n\n    # Using len(nums) as authoritative length as per design FR1.\n    for i in range(len(nums)):\n        current_max += nums[i]\n        if current_max > max_so_far:\n            max_so_far = current_max\n        if current_max < 0:\n            current_max = 0\n            \n    # Handle case where all numbers are negative or list was empty (though empty is caught above).\n    if max_so_far == float('-inf') or (all(x < 0 for x in nums) and max_so_far == 0):\n        return max(nums) if nums else 0\n\n    return max_so_far\n```\n"}
{"task_id": "Mbpp/559", "solution": "```python\n\"\"\"\nThis module contains the implementation of Kadane's algorithm\nto find the maximum sum of a contiguous sublist.\n\"\"\"\n\n\ndef max_sub_array_sum(arr: list[int | float], n: int) -> int | float:\n    \"\"\"\n    Finds the maximum sum of a contiguous sublist in the given list.\n\n    Args:\n        arr: The input list of numbers (integers or floats).\n        n: The length of the input list. This parameter is advisory;\n           the function uses len(arr) for actual iteration.\n\n    Returns:\n        The maximum sum of a contiguous sublist. Returns 0 if the list is empty.\n    \"\"\"\n    if not arr:\n        return 0\n\n    max_so_far = arr[0]\n    current_max = arr[0]\n\n    for i in range(1, len(arr)):\n        current_max = max(arr[i], current_max + arr[i])\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far\n```"}
{"task_id": "Mbpp/562", "solution": "```python\nclass InvalidInputTypeError(TypeError):\n    \"\"\"Custom exception for invalid input type to the analyzer.\n    Inherits from Python's built-in TypeError.\"\"\"\n    pass\n\nclass InvalidSublistTypeError(ValueError):\n    \"\"\"Custom exception for invalid sublist type within the input list.\n    Inherits from Python's built-in ValueError.\"\"\"\n    pass\n\ndef Find_Max_Length(input_list: list) -> int:\n    \"\"\"\n    Finds the length of the longest sublist within a given list of lists.\n    Raises custom exceptions for invalid input or sublist types.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise InvalidInputTypeError(\"Input must be a list.\")\n\n    max_length = 0\n    for sublist in input_list:\n        if not isinstance(sublist, list):\n            raise InvalidSublistTypeError(\"All elements in the input list must be lists.\")\n        max_length = max(max_length, len(sublist))\n    return max_length\n```"}
