{"task_id": "Mbpp/74", "solution": "```python\ndef is_samepatterns(colors: list[str], patterns: list[str]) -> bool:\n    \"\"\"\n    Compares two lists for pattern consistency based on a one-to-one mapping.\n    Returns True if the lists follow the same pattern, False otherwise.\n    \"\"\"\n    if len(colors) != len(patterns):\n        return False\n\n    color_to_pattern = {}\n    pattern_to_color = {}\n\n    for color, pattern in zip(colors, patterns):\n        if color in color_to_pattern:\n            if color_to_pattern[color] != pattern:\n                return False\n        else:\n            color_to_pattern[color] = pattern\n\n        if pattern in pattern_to_color:\n            if pattern_to_color[pattern] != color:\n                return False\n        else:\n            pattern_to_color[pattern] = color\n\n    return True\n```"}
{"task_id": "Mbpp/71", "solution": "```python\ndef comb_sort(data: list[float | int]) -> list[float | int]:\n    \"\"\"Sorts a list of numbers in ascending order using the comb sort algorithm.\n    Modifies the list in-place and returns a reference to it.\n    \"\"\"\n    # Input validation: check if 'data' is a list and contains only numbers.\n    if not isinstance(data, list):\n        raise TypeError(\"Input must be a list.\")\n    for item in data:\n        if not isinstance(item, (int, float)):\n            raise ValueError(\"All elements in the list must be numbers.\")\n\n    n = len(data)\n    if n <= 1:\n        return data\n\n    SHRINK_FACTOR = 1.3  # The factor by which the gap is reduced.\n    gap = n\n    swapped = True\n\n    # Main comb sort algorithm logic.\n    while gap > 1 or swapped:\n        if gap > 1:\n            gap = int(gap / SHRINK_FACTOR)\n        \n        swapped = False\n        for i in range(n - gap):\n            if data[i] > data[i + gap]:\n                data[i], data[i + gap] = data[i + gap], data[i]  # Swap elements.\n                swapped = True\n    return data\n```\n"}
{"task_id": "Mbpp/72", "solution": "```python\ndef dif_Square(number: int) -> bool:\n    \"\"\"\n    Checks if an integer can be expressed as the difference of two squares.\n    An integer n can be represented as a^2 - b^2 if and only if abs(n) is odd or a multiple of 4.\n    \"\"\"\n    if not isinstance(number, int):\n        raise ValueError(\"Input must be an integer.\")\n\n    # The mathematical property holds for the absolute value.\n    # An integer n can be represented as the difference of two squares if and only if n % 4 != 2.\n    return abs(number) % 4 != 2\n```"}
{"task_id": "Mbpp/71", "solution": "```python\nfrom typing import Union\n\nSHRINK_FACTOR: float = 1.3\n\ndef comb_sort(data: list[Union[int, float]]) -> None:\n    \"\"\"\n    Sorts a list of numbers in-place using the Comb Sort algorithm.\n    It validates input and reduces the gap between compared elements by a shrink factor.\n    \"\"\"\n    # Input validation (adhering to FR2 and FR3, inlined for \"bare function\" requirement)\n    if not isinstance(data, list):\n        raise TypeError(\"Input must be a list.\")\n    for item in data:\n        if not isinstance(item, (int, float)):\n            raise ValueError(\"All elements in the list must be numeric (int or float).\")\n\n    n = len(data)\n    if n <= 1:\n        return\n\n    gap = n\n    swapped = True\n\n    while gap > 1 or swapped:\n        if gap > 1:\n            gap = int(gap / SHRINK_FACTOR)\n            if gap < 1:  # Ensure gap doesn't become 0, minimum is 1 for final bubble sort pass\n                gap = 1\n\n        swapped = False\n        for i in range(n - gap):\n            if data[i] > data[i + gap]:\n                data[i], data[i + gap] = data[i + gap], data[i]\n                swapped = True\n    # The function returns None implicitly as it sorts in-place (FR4).\n```"}
{"task_id": "Mbpp/75", "solution": "```python\ndef find_tuples(list_of_tuples: list[tuple[int, ...]], k: int) -> list[tuple[int, ...]]:\n    \"\"\"\n    Finds tuples in a list where all elements are divisible by k.\n    A new list containing only the tuples where all elements are divisible by k is returned.\n    \"\"\"\n    filtered_tuples = []\n    for current_tuple in list_of_tuples:\n        if all(element % k == 0 for element in current_tuple):\n            filtered_tuples.append(current_tuple)\n    return filtered_tuples\n```"}
{"task_id": "Mbpp/74", "solution": "```python\ndef is_samepatterns(words: list[str], patterns: list[str]) -> bool:\n    \"\"\"\n    Determines if a list of words follows the sequence given by a pattern list.\n    It establishes a one-to-one mapping between unique words and unique pattern characters.\n    \"\"\"\n    if not isinstance(words, list) or not isinstance(patterns, list):\n        raise TypeError(\"Inputs 'words' and 'patterns' must be lists.\")\n\n    if len(words) != len(patterns):\n        return False\n\n    word_to_char_map = {}\n    char_to_word_map = {}\n\n    for i in range(len(words)):\n        word = words[i]\n        char = patterns[i]\n\n        if not isinstance(word, str) or not isinstance(char, str):\n            raise TypeError(\"Elements in 'words' and 'patterns' must be strings.\")\n\n        # Ensure consistent mapping from word to character.\n        if word in word_to_char_map:\n            if word_to_char_map[word] != char:\n                return False\n        else:\n            word_to_char_map[word] = char\n\n        # Ensure consistent mapping from character to word.\n        if char in char_to_word_map:\n            if char_to_word_map[char] != word:\n                return False\n        else:\n            char_to_word_map[char] = word\n\n    return True\n```"}
