{"task_id": "Mbpp/419", "solution": "```python\nfrom typing import List, Union, Any\n\nclass InputValidator:\n    \"\"\"Provides static methods for validating input data.\"\"\"\n\n    @staticmethod\n    def validate_list_of_numbers(data: Any) -> None:\n        \"\"\"Validates if the input is a list and all its elements are numbers.\"\"\"\n        if not isinstance(data, list):\n            raise TypeError(\"Input must be a list.\")\n        for item in data:\n            if not isinstance(item, (int, float)):\n                raise TypeError(\"All elements in the list must be numbers (int or float).\")\n\nclass MathUtils:\n    \"\"\"Provides static utility methods for basic mathematical operations.\"\"\"\n\n    @staticmethod\n    def round_number(num: Union[float, int]) -> int:\n        \"\"\"Rounds a single number to the nearest integer.\"\"\"\n        return round(num)\n\n    @staticmethod\n    def sum_numbers(numbers: List[int]) -> int:\n        \"\"\"Calculates the sum of a list of integers.\"\"\"\n        return sum(numbers)\n\n    @staticmethod\n    def multiply(a: int, b: int) -> int:\n        \"\"\"Multiplies two integers.\"\"\"\n        return a * b\n\ndef round_and_sum(numbers: List[Union[float, int]]) -> int:\n    \"\"\"Rounds each number in a list, sums the rounded values, and then multiplies the sum by the original list's length.\n\n    Args:\n        numbers: A list of numbers (integers or floats).\n\n    Returns:\n        The total sum of rounded numbers multiplied by the length of the original list.\n\n    Raises:\n        TypeError: If the input is not a list or contains non-numeric elements.\n    \"\"\"\n    InputValidator.validate_list_of_numbers(numbers)\n\n    rounded_numbers = [MathUtils.round_number(num) for num in numbers]\n    total_sum = MathUtils.sum_numbers(rounded_numbers)\n    \n    list_length = len(numbers)\n    \n    final_result = MathUtils.multiply(total_sum, list_length)\n    return final_result\n```"}
{"task_id": "Mbpp/418", "solution": "```python\nfrom typing import Any\n\ndef Find_Max(items: list) -> Any:\n    \"\"\"\n    Finds the element with the maximum length in a list.\n    Raises ValueError if the list is empty, or TypeError if an item doesn't support len().\n    \"\"\"\n    if not items:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    max_length_item = items[0]\n    max_length = len(items[0])\n\n    for item in items[1:]:\n        current_length = len(item)\n        if current_length > max_length:\n            max_length = current_length\n            max_length_item = item\n    return max_length_item\n```"}
{"task_id": "Mbpp/420", "solution": "```python\ndef cube_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of cubes of the first 'n' even natural numbers.\n    Input 'n' must be a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    total_sum = 0\n    for i in range(1, n + 1):\n        even_number = 2 * i\n        total_sum += even_number ** 3\n    return total_sum\n```"}
