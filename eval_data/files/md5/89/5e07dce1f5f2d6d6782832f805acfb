{"task_id": "Mbpp/245", "solution": "from typing import List\n\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to the bitonic subsequence solver.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\ndef _validate_input(arr: List[int]) -> None:\n    \"\"\"Validates that the input is a list of integers.\"\"\"\n    if not isinstance(arr, list):\n        raise InvalidInputError(\"Input must be a list.\")\n    for item in arr:\n        if not isinstance(item, int):\n            raise InvalidInputError(\"All elements in the list must be integers.\")\n\ndef _get_lis_sums(arr: List[int]) -> List[int]:\n    \"\"\"\n    Computes the maximum sum of an increasing subsequence ending at each index.\n    Each element `arr[i]` contributes to `lis_sums[i]` if it extends a previous increasing subsequence.\n    \"\"\"\n    n = len(arr)\n    lis_sums = [0] * n\n    for i in range(n):\n        lis_sums[i] = arr[i]\n        for j in range(i):\n            if arr[i] > arr[j] and lis_sums[i] < lis_sums[j] + arr[i]:\n                lis_sums[i] = lis_sums[j] + arr[i]\n    return lis_sums\n\ndef _get_lds_sums(arr: List[int]) -> List[int]:\n    \"\"\"\n    Computes the maximum sum of a decreasing subsequence starting at each index.\n    This is achieved by reversing the array and finding LIS, then reversing the results.\n    \"\"\"\n    n = len(arr)\n    lds_sums_reversed = [0] * n\n    reversed_arr = arr[::-1]\n\n    for i in range(n):\n        lds_sums_reversed[i] = reversed_arr[i]\n        for j in range(i):\n            if reversed_arr[i] > reversed_arr[j] and lds_sums_reversed[i] < lds_sums_reversed[j] + reversed_arr[i]:\n                lds_sums_reversed[i] = lds_sums_reversed[j] + reversed_arr[i]\n    \n    return lds_sums_reversed[::-1]\n\ndef max_sum(arr: List[int]) -> int:\n    \"\"\"\n    Calculates the maximum sum of a bitonic subsequence within the given array.\n    A bitonic subsequence strictly increases then strictly decreases, or is purely increasing/decreasing.\n    \"\"\"\n    _validate_input(arr)\n\n    n = len(arr)\n    if n == 0:\n        return 0\n    if n == 1:\n        return arr[0]\n\n    lis_sums = _get_lis_sums(arr)\n    lds_sums = _get_lds_sums(arr)\n\n    # Initialize with negative infinity as sums can be negative.\n    # Any single element is a valid bitonic subsequence, so this will be updated correctly.\n    max_bitonic_sum = float('-inf') \n\n    for i in range(n):\n        # Combine LIS sum ending at i and LDS sum starting at i.\n        # Subtract arr[i] once as it's counted in both LIS and LDS sums.\n        current_bitonic_sum = lis_sums[i] + lds_sums[i] - arr[i]\n        if current_bitonic_sum > max_bitonic_sum:\n            max_bitonic_sum = current_bitonic_sum\n            \n    return int(max_bitonic_sum)"}
