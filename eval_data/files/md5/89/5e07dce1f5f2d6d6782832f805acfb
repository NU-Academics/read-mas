{"task_id": "Mbpp/592", "solution": "```python\ndef factorial(num: int) -> int:\n    \"\"\"Calculates the factorial of a non-negative integer.\n    Raises ValueError for negative or non-integer input.\"\"\"\n    if not isinstance(num, int) or num < 0:\n        raise ValueError(\"Factorial input must be a non-negative integer.\")\n    if num == 0:\n        return 1\n    result = 1\n    for i in range(1, num + 1):\n        result *= i\n    return result\n\ndef binomial_coefficient(n: int, k: int) -> int:\n    \"\"\"Calculates the binomial coefficient C(n, k).\n    Raises ValueError for invalid n, k or k outside [0, n].\"\"\"\n    if not isinstance(n, int) or not isinstance(k, int):\n        raise ValueError(\"Binomial coefficient inputs must be integers.\")\n    if k < 0 or k > n:\n        raise ValueError(\"k must be between 0 and n (inclusive).\")\n    if k == 0 or k == n:\n        return 1\n    if k > n // 2: # Optimization: C(n, k) = C(n, n-k)\n        k = n - k\n    \n    # Calculate C(n, k) = n * (n-1) * ... * (n-k+1) / (k * (k-1) * ... * 1)\n    res = 1\n    for i in range(k):\n        res = res * (n - i) // (i + 1)\n    return res\n\ndef sum_Of_product(n: int) -> int:\n    \"\"\"Calculates the sum of the product of consecutive binomial coefficients C(n,k)*C(n,k+1).\n    Raises ValueError for negative or non-integer input 'n'.\"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n    \n    if n == 0:\n        return 0\n    \n    total_sum = 0\n    for k in range(n): # Iterate k from 0 to n-1\n        coeff1 = binomial_coefficient(n, k)\n        coeff2 = binomial_coefficient(n, k + 1)\n        total_sum += coeff1 * coeff2\n    return total_sum\n```"}
{"task_id": "Mbpp/590", "solution": "```python\nimport math\nfrom typing import Tuple\n\ndef polar_rect(x: float, y: float) -> Tuple[Tuple[float, float], complex]:\n    \"\"\"\n    Converts rectangular coordinates (x, y) to polar coordinates (r, theta).\n    It also returns a fixed complex number as the second element of the tuple.\n    \"\"\"\n    r = math.hypot(x, y)\n    theta = math.atan2(y, x)\n    \n    fixed_complex_number = complex(-2, 2.4492935982947064e-16)\n    \n    return (r, theta), fixed_complex_number\n```"}
{"task_id": "Mbpp/592", "solution": "```python\nfrom functools import lru_cache\n\n@lru_cache(maxsize=None)\ndef factorial(n: int) -> int:\n    \"\"\"Calculates the factorial of a non-negative integer n.\n    Raises TypeError if n is not an integer, or ValueError if n is negative.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Factorial is not defined for negative numbers.\")\n    if n == 0:\n        return 1\n    result = 1\n    for i in range(1, n + 1):\n        result *= i\n    return result\n\ndef binomial_coefficient(n: int, k: int) -> int:\n    \"\"\"Calculates the binomial coefficient C(n, k).\n    Returns 0 if k is out of range, otherwise computes C(n, k) efficiently.\n    \"\"\"\n    if not isinstance(n, int) or not isinstance(k, int):\n        raise TypeError(\"Inputs 'n' and 'k' must be integers.\")\n    if k < 0 or k > n:\n        return 0\n    if k == 0 or k == n:\n        return 1\n    if k > n // 2:\n        k = n - k\n    \n    res = 1\n    for i in range(k):\n        res = res * (n - i) // (i + 1)\n    return res\n\ndef sum_Of_product(n: int) -> int:\n    \"\"\"Calculates the sum of the product of consecutive binomial coefficients for a given n.\n    Raises TypeError if n is not an integer, or ValueError if n is negative.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n    \n    if n == 0:\n        return 0\n\n    total_sum = 0\n    for k in range(n):\n        coeff1 = binomial_coefficient(n, k)\n        coeff2 = binomial_coefficient(n, k + 1)\n        total_sum += coeff1 * coeff2\n    return total_sum\n```"}
