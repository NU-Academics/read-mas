{"task_id": "Mbpp/618", "solution": "```python\nfrom typing import List, Union\n\ndef div_list(list1: List[Union[int, float]], list2: List[Union[int, float]]) -> List[float]:\n    \"\"\"\n    Divides two lists element-wise, returning a new list of float results.\n    It performs extensive validation for types, lengths, non-numeric values, and zero divisors.\n    \"\"\"\n    if not isinstance(list1, list) or not isinstance(list2, list):\n        raise TypeError(\"Both inputs must be lists.\")\n\n    if len(list1) != len(list2):\n        raise ValueError(\"Input lists must have the same length.\")\n\n    if not list1:\n        raise ValueError(\"Input lists cannot be empty.\")\n\n    results: List[float] = []\n    for i in range(len(list1)):\n        dividend = list1[i]\n        divisor = list2[i]\n\n        if not isinstance(dividend, (int, float)):\n            raise TypeError(f\"Element at index {i} in list1 is not a number: {dividend}\")\n        if not isinstance(divisor, (int, float)):\n            raise TypeError(f\"Element at index {i} in list2 is not a number: {divisor}\")\n\n        if divisor == 0:\n            raise ZeroDivisionError(f\"Cannot divide by zero at index {i}.\")\n\n        results.append(float(dividend) / float(divisor))\n    return results\n```\n"}
{"task_id": "Mbpp/618", "solution": "```python\nfrom typing import List, Union\n\nclass ListOperationError(Exception):\n    \"\"\"Base exception for errors in list operations.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass ListLengthMismatchError(ListOperationError):\n    \"\"\"Exception raised when lists have different lengths for element-wise operations.\"\"\"\n    pass\n\nclass DivisionByZeroError(ListOperationError):\n    \"\"\"Exception raised when an attempt is made to divide by zero.\"\"\"\n    pass\n\ndef div_list(list_a: List[Union[float, int]], list_b: List[Union[float, int]]) -> List[float]:\n    \"\"\"Divides elements of list_a by corresponding elements of list_b element-wise.\n    Handles length mismatch, division by zero, and non-numeric elements.\n    \"\"\"\n    if len(list_a) != len(list_b):\n        raise ListLengthMismatchError(f\"Lists must be of equal length. Got {len(list_a)} and {len(list_b)}.\")\n\n    results: List[float] = []\n    for i in range(len(list_a)):\n        numerator = list_a[i]\n        denominator = list_b[i]\n\n        if not isinstance(numerator, (int, float)) or not isinstance(denominator, (int, float)):\n            raise TypeError(f\"List elements must be numeric. Found non-numeric at index {i}.\")\n\n        if denominator == 0:\n            raise DivisionByZeroError(f\"Division by zero encountered at index {i}.\")\n\n        results.append(float(numerator) / float(denominator))\n    return results\n```"}
{"task_id": "Mbpp/622", "solution": "def get_median(list1: list[int], list2: list[int], n: int) -> float:\n    \"\"\"\n    Finds the median of two sorted lists of the same size.\n    The median for 2*n elements is the average of the n-th and (n+1)-th elements (0-indexed) of the merged list.\n    \"\"\"\n    i = 0\n    j = 0\n    m1 = -1\n    m2 = -1\n\n    for count in range(n + 1):\n        m1 = m2\n        if i == n:\n            m2 = list2[j]\n            j += 1\n        elif j == n:\n            m2 = list1[i]\n            i += 1\n        elif list1[i] <= list2[j]:\n            m2 = list1[i]\n            i += 1\n        else:\n            m2 = list2[j]\n            j += 1\n\n    return (float(m1) + float(m2)) / 2.0"}
{"task_id": "Mbpp/620", "solution": "```python\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to the largest divisible subset function.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\n\ndef largest_subset(numbers: list[int]) -> int:\n    \"\"\"\n    Finds the size of the largest divisible subset within a given list of integers.\n    A subset is divisible if for any two elements a and b, a % b == 0 or b % a == 0.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise InvalidInputError(\"Input must be a list.\")\n    if not all(isinstance(x, int) for x in numbers):\n        raise InvalidInputError(\"All elements in the list must be integers.\")\n\n    if not numbers:\n        return 0\n\n    # Sort the numbers to simplify divisibility checks and apply dynamic programming.\n    numbers.sort()\n    n = len(numbers)\n\n    # dp[i] stores the size of the largest divisible subset ending with numbers[i].\n    dp = [1] * n\n\n    for i in range(n):\n        for j in range(i):\n            if numbers[i] % numbers[j] == 0:\n                dp[i] = max(dp[i], dp[j] + 1)\n    \n    return max(dp) if dp else 0\n```"}
