{"task_id": "Mbpp/129", "solution": "```python\nfrom typing import List, Union\n\nclass InvalidMatrixError(Exception):\n    \"\"\"Custom exception for invalid matrix input.\"\"\"\n    pass\n\nclass MagicSquareChecker:\n    \"\"\"\n    Encapsulates logic to validate if a matrix is a magic square.\n    It checks matrix structure, element types, and calculates all required sums.\n    \"\"\"\n    def __init__(self, matrix: List[List[Union[int, float]]]):\n        if not isinstance(matrix, list) or any(not isinstance(row, list) for row in matrix):\n            raise InvalidMatrixError(\"Input must be a list of lists.\")\n        if not matrix:\n            self._matrix = []\n            self._size = 0\n            self._magic_sum = 0\n            return\n\n        self._matrix = matrix\n        self._size = len(matrix)\n        self._magic_sum = 0\n\n    def _is_square(self) -> bool:\n        \"\"\"Checks if the matrix is square (N x N) and all rows have same length.\"\"\"\n        if self._size == 0:\n            return False\n        for row in self._matrix:\n            if len(row) != self._size:\n                return False\n        return True\n\n    def _is_numeric(self) -> bool:\n        \"\"\"Checks if all elements in the matrix are numeric (int or float).\"\"\"\n        for row in self._matrix:\n            for element in row:\n                if not isinstance(element, (int, float)):\n                    return False\n        return True\n\n    def _calculate_row_sums(self) -> List[Union[int, float]]:\n        \"\"\"Calculates the sum of each row in the matrix.\"\"\"\n        return [sum(row) for row in self._matrix]\n\n    def _calculate_col_sums(self) -> List[Union[int, float]]:\n        \"\"\"Calculates the sum of each column in the matrix.\"\"\"\n        col_sums = [0] * self._size\n        for i in range(self._size):\n            for j in range(self._size):\n                col_sums[j] += self._matrix[i][j]\n        return col_sums\n\n    def _calculate_main_diagonal_sum(self) -> Union[int, float]:\n        \"\"\"Calculates the sum of the main diagonal (top-left to bottom-right).\"\"\"\n        return sum(self._matrix[i][i] for i in range(self._size))\n\n    def _calculate_anti_diagonal_sum(self) -> Union[int, float]:\n        \"\"\"Calculates the sum of the anti-diagonal (top-right to bottom-left).\"\"\"\n        return sum(self._matrix[i][self._size - 1 - i] for i in range(self._size))\n\n    def is_magic_square(self) -> bool:\n        \"\"\"\n        Determines if the matrix is a magic square by orchestrating all checks and sum calculations.\n        Returns True if it's a magic square, False otherwise.\n        \"\"\"\n        if self._size == 0:\n            return False\n        if not self._is_square():\n            return False\n        if not self._is_numeric():\n            return False\n\n        row_sums = self._calculate_row_sums()\n        self._magic_sum = row_sums[0]\n\n        if not all(s == self._magic_sum for s in row_sums):\n            return False\n\n        col_sums = self._calculate_col_sums()\n        if not all(s == self._magic_sum for s in col_sums):\n            return False\n\n        if self._calculate_main_diagonal_sum() != self._magic_sum:\n            return False\n\n        if self._calculate_anti_diagonal_sum() != self._magic_sum:\n            return False\n\n        return True\n\ndef magic_square_test(matrix: List[List[Union[int, float]]]) -> bool:\n    \"\"\"\n    Determines if a given matrix (list of lists) is a magic square.\n    Returns True if the matrix is a magic square, False otherwise.\n    \"\"\"\n    try:\n        checker = MagicSquareChecker(matrix)\n        return checker.is_magic_square()\n    except InvalidMatrixError:\n        return False\n    except Exception:\n        return False\n```"}
{"task_id": "Mbpp/130", "solution": "```python\nfrom collections import Counter\nfrom typing import Any, List, Optional\n\ndef max_occurrences(data_list: List[Any]) -> Optional[Any]:\n    \"\"\"\n    Finds the item with the maximum frequency in the given list.\n    Returns the first encountered item in case of ties or None for an empty list.\n    \"\"\"\n    if not data_list:\n        return None\n\n    try:\n        # Count item frequencies, raising TypeError for non-hashable items.\n        counts = Counter(data_list)\n    except TypeError as e:\n        raise TypeError(f\"List contains non-hashable items: {e}\") from e\n\n    max_item = None\n    max_count = -1\n\n    # Iterate to find the item with the highest count,\n    # preserving insertion order for tie-breaking in Python 3.7+.\n    for item, count in counts.items():\n        if count > max_count:\n            max_count = count\n            max_item = item\n\n    return max_item\n```"}
{"task_id": "Mbpp/129", "solution": "```python\nclass MagicSquareError(Exception):\n    \"\"\"Base exception for magic square validation errors.\"\"\"\n    pass\n\nclass InvalidMatrixTypeError(MagicSquareError):\n    \"\"\"Raised when the input matrix is not a list of lists or contains non-list rows.\"\"\"\n    pass\n\nclass NotSquareMatrixError(MagicSquareError):\n    \"\"\"Raised when the input matrix is not a square matrix or has inconsistent row lengths.\"\"\"\n    pass\n\nclass NonNumericMatrixValueError(MagicSquareError):\n    \"\"\"Raised when the matrix contains non-numeric values.\"\"\"\n    pass\n\nclass MagicSquareValidator:\n    def __init__(self, matrix: list[list[int]]):\n        self._matrix = matrix\n        self._size = 0\n        self._validate_matrix_elements()\n        if not self._is_square_matrix():\n            raise NotSquareMatrixError(\"Matrix is not a square matrix.\")\n\n    def _validate_matrix_elements(self) -> None:\n        if not isinstance(self._matrix, list):\n            raise InvalidMatrixTypeError(\"Input must be a list.\")\n        if not self._matrix:\n            self._size = 0\n            return\n\n        self._size = len(self._matrix)\n        for row in self._matrix:\n            if not isinstance(row, list):\n                raise InvalidMatrixTypeError(\"Each row in the matrix must be a list.\")\n            if len(row) != self._size:\n                raise NotSquareMatrixError(\"Rows have inconsistent lengths, not a square matrix.\")\n            for element in row:\n                if not isinstance(element, (int, float)):\n                    raise NonNumericMatrixValueError(\"Matrix elements must be numeric.\")\n\n    def _is_square_matrix(self) -> bool:\n        if self._size == 0:\n            return True\n        return all(len(row) == self._size for row in self._matrix)\n\n    def _get_row_sums(self) -> list[int]:\n        return [sum(row) for row in self._matrix]\n\n    def _get_col_sums(self) -> list[int]:\n        if self._size == 0:\n            return []\n        col_sums = [0] * self._size\n        for r_idx in range(self._size):\n            for c_idx in range(self._size):\n                col_sums[c_idx] += self._matrix[r_idx][c_idx]\n        return col_sums\n\n    def _get_main_diagonal_sum(self) -> int:\n        if self._size == 0:\n            return 0\n        return sum(self._matrix[i][i] for i in range(self._size))\n\n    def _get_anti_diagonal_sum(self) -> int:\n        if self._size == 0:\n            return 0\n        return sum(self._matrix[i][self._size - 1 - i] for i in range(self._size))\n\n    def is_magic_square(self) -> bool:\n        if self._size == 0:\n            return True\n        \n        row_sums = self._get_row_sums()\n        col_sums = self._get_col_sums()\n        main_diag_sum = self._get_main_diagonal_sum()\n        anti_diag_sum = self._get_anti_diagonal_sum()\n\n        expected_sum = row_sums[0]\n\n        if not all(s == expected_sum for s in row_sums):\n            return False\n        if not all(s == expected_sum for s in col_sums):\n            return False\n        if main_diag_sum != expected_sum:\n            return False\n        if anti_diag_sum != expected_sum:\n            return False\n\n        return True\n\ndef magic_square_test(matrix: list[list[int]]) -> bool:\n    \"\"\"\n    Checks if a given matrix is a magic square.\n    A magic square is a square matrix where the sum of the numbers in each row,\n    each column, and both main diagonals are the same.\n\n    Args:\n        matrix: A list of lists representing the matrix.\n\n    Returns:\n        True if the matrix is a magic square, False otherwise.\n\n    Raises:\n        InvalidMatrixTypeError: If the input is not a list of lists or contains non-list rows.\n        NotSquareMatrixError: If the matrix is not a square matrix or has inconsistent row lengths.\n        NonNumericMatrixValueError: If any element in the matrix is not numeric.\n    \"\"\"\n    validator = MagicSquareValidator(matrix)\n    return validator.is_magic_square()\n```\n"}
