{"task_id": "Mbpp/67", "solution": "```python\n_combinations_memo = {}\n\ndef combinations(n: int, k: int) -> int:\n    \"\"\"\n    Calculates the binomial coefficient \"n choose k\" (C(n, k)).\n    Uses memoization for efficiency.\n    \"\"\"\n    if k < 0 or k > n:\n        raise ValueError(\"k must be between 0 and n, inclusive.\")\n    if k == 0 or k == n:\n        return 1\n    if k > n // 2:\n        k = n - k\n\n    if (n, k) in _combinations_memo:\n        return _combinations_memo[(n, k)]\n\n    res = 1\n    for i in range(k):\n        res = res * (n - i) // (i + 1)\n    _combinations_memo[(n, k)] = res\n    return res\n\nclass BellNumberCalculator:\n    def __init__(self):\n        \"\"\"\n        Initializes the calculator with base cases for Bell numbers.\n        Stores previously computed Bell numbers in _memo.\n        \"\"\"\n        self._memo = {0: 1, 1: 1}\n\n    def calculate(self, n: int) -> int:\n        \"\"\"\n        Computes the nth Bell number using memoization and recurrence.\n        Raises ValueError for invalid input n.\n        \"\"\"\n        if not isinstance(n, int) or n < 0:\n            raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n        if n in self._memo:\n            return self._memo[n]\n        \n        # B(n) = sum(k=0 to n-1) C(n-1, k) * B(k)\n        result = 0\n        for k in range(n):\n            result += combinations(n - 1, k) * self.calculate(k)\n        \n        self._memo[n] = result\n        return result\n\n_calculator = BellNumberCalculator()\n\ndef bell_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Bell number.\n    Raises ValueError if n is not a non-negative integer.\n    \"\"\"\n    return _calculator.calculate(n)\n```\n"}
{"task_id": "Mbpp/68", "solution": "```python\ndef is_Monotonic(array):\n    \"\"\"\n    Checks if the given array is monotonic (either increasing or decreasing).\n    An empty array or an array with one element is considered monotonic.\n    \"\"\"\n    if len(array) <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(1, len(array)):\n        if array[i] < array[i-1]:\n            is_increasing = False\n        if array[i] > array[i-1]:\n            is_decreasing = False\n\n    return is_increasing or is_decreasing\n```"}
