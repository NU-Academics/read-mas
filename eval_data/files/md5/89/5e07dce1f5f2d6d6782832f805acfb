{"task_id": "Mbpp/745", "solution": "```python\ndef divisible_by_digits(startnum: int, endnum: int) -> list[int]:\n    \"\"\"\n    Finds numbers within a given range where each number is divisible by all its non-zero digits.\n    Raises TypeError if inputs are not integers.\n    \"\"\"\n    if not isinstance(startnum, int) or not isinstance(endnum, int):\n        raise TypeError(\"startnum and endnum must be integers.\")\n\n    if startnum > endnum:\n        return []\n\n    result = []\n\n    def _is_divisible_by_all_digits(number: int) -> bool:\n        \"\"\"\n        Checks if a single number is divisible by every non-zero digit it contains.\n        Zero digits are ignored for divisibility checks.\n        \"\"\"\n        if number == 0:\n            return True # As per design, 0 is considered divisible by its (non-existent) non-zero digits.\n        \n        temp_num = number\n        while temp_num > 0:\n            digit = temp_num % 10\n            if digit == 0:\n                # Skip zero digits as division by zero is not permitted.\n                pass\n            elif number % digit != 0:\n                return False\n            temp_num //= 10\n        return True\n\n    for number in range(startnum, endnum + 1):\n        if _is_divisible_by_all_digits(number):\n            result.append(number)\n            \n    return result\n```"}
{"task_id": "Mbpp/745", "solution": "```python\ndef divisible_by_digits(startnum: int, endnum: int) -> list[int]:\n    \"\"\"\n    Finds numbers in a range where each is divisible by its non-zero digits.\n    Numbers containing '0' are skipped.\n    \"\"\"\n    if not isinstance(startnum, int) or not isinstance(endnum, int):\n        raise ValueError(\"startnum and endnum must be integers.\")\n    if startnum > endnum:\n        raise ValueError(\"startnum cannot be greater than endnum.\")\n    if startnum < 0 or endnum < 0:\n        raise ValueError(\"startnum and endnum must be non-negative.\")\n\n    result = []\n\n    def _is_divisible_by_all_digits_helper(num_to_check: int) -> bool:\n        \"\"\"Checks if a number is divisible by all its constituent digits.\n        This helper assumes the number does not contain '0'.\"\"\"\n        s_num = str(num_to_check)\n        for char_digit in s_num:\n            digit = int(char_digit)\n            # Since numbers containing '0' are already filtered out, 'digit' will not be zero here.\n            if num_to_check % digit != 0:\n                return False\n        return True\n\n    for num in range(startnum, endnum + 1):\n        if '0' in str(num):  # Exclude numbers containing the digit '0'\n            continue\n\n        if _is_divisible_by_all_digits_helper(num):\n            result.append(num)\n\n    return result\n```"}
{"task_id": "Mbpp/749", "solution": "```python\ndef sort_numeric_strings(data_list: list[str]) -> list[int]:\n    \"\"\"Converts a list of numeric strings to integers and sorts them numerically.\"\"\"\n    if not isinstance(data_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    numeric_list = []\n    for item in data_list:\n        try:\n            numeric_list.append(int(item))\n        except ValueError:\n            raise ValueError(f\"Cannot convert '{item}' to an integer. All list elements must be numeric strings.\")\n    \n    numeric_list.sort()\n    return numeric_list\n```"}
{"task_id": "Mbpp/749", "solution": "```python\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to the sorting utility.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\ndef sort_numeric_strings(numeric_strings: list[str]) -> list[int]:\n    \"\"\"\n    Sorts a list of numeric strings numerically in ascending order.\n    Raises InvalidInputError for invalid input types or non-numeric strings.\n    \"\"\"\n    if not isinstance(numeric_strings, list):\n        raise InvalidInputError(\"Input must be a list.\")\n\n    converted_numbers: list[int] = []\n    for s in numeric_strings:\n        try:\n            converted_numbers.append(int(s))\n        except (ValueError, TypeError) as e:\n            raise InvalidInputError(f\"All elements must be numeric strings. Failed on \\'{s}\\': {e}\")\n\n    converted_numbers.sort() # Sorts the list of integers numerically in ascending order.\n    return converted_numbers\n```"}
{"task_id": "Mbpp/728", "solution": "```python\nfrom typing import List, Union\n\ndef sum_list(list1: List[Union[int, float]], list2: List[Union[int, float]]) -> List[Union[int, float]]:\n    \"\"\"\n    Calculates the element-wise sum of two input lists.\n    Raises ValueError if lengths differ, TypeError if non-numeric elements are found.\n    \"\"\"\n    if len(list1) != len(list2):\n        raise ValueError(\"Input lists must have the same length.\")\n\n    result = []\n    for i in range(len(list1)):\n        if not isinstance(list1[i], (int, float)) or not isinstance(list2[i], (int, float)):\n            raise TypeError(\"All elements in the input lists must be numbers.\")\n        result.append(list1[i] + list2[i])\n    return result\n```"}
