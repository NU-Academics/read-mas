{"task_id": "Mbpp/470", "solution": "```python\ndef add_pairwise(input_tuple: tuple[int | float, ...]) -> tuple[int | float, ...]:\n    \"\"\"\n    Calculates the sum of neighboring elements in a tuple.\n    Returns an empty tuple if the input has fewer than two elements.\n    \"\"\"\n    if len(input_tuple) < 2:\n        return ()\n\n    result = []\n    for i in range(len(input_tuple) - 1):\n        result.append(input_tuple[i] + input_tuple[i+1])\n    return tuple(result)\n```"}
{"task_id": "Mbpp/471", "solution": "```python\ndef find_remainder(arr: list[int], n: int) -> int:\n    \"\"\"\n    Calculates the product of array elements modulo n.\n    Raises ValueError if n is not a positive integer.\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"Modulus 'n' must be a positive integer.\")\n\n    if not arr:\n        return 1\n\n    product = 1\n    for x in arr:\n        product = (product * x) % n\n    return product\n```"}
{"task_id": "Mbpp/470", "solution": "```python\nfrom typing import Tuple, Union\n\ndef add_pairwise(data: Tuple[Union[int, float], ...]) -> Tuple[Union[int, float], ...]:\n    \"\"\"\n    Calculates the sum of each adjacent pair of elements in a numeric tuple.\n    It performs validation for tuple type and element types, handling small tuples gracefully.\n    \"\"\"\n    if not isinstance(data, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n\n    for item in data:\n        if not isinstance(item, (int, float)):\n            raise ValueError(\"All tuple elements must be numeric (int or float).\")\n\n    if len(data) < 2:\n        return ()\n\n    result = []\n    for i in range(len(data) - 1):\n        result.append(data[i] + data[i+1])\n\n    return tuple(result)\n```"}
{"task_id": "Mbpp/468", "solution": "```python\ndef max_product(arr: list[int]) -> int:\n    # Validate input: ensure arr is a list containing only integers.\n    if not isinstance(arr, list) or any(not isinstance(item, int) for item in arr):\n        raise TypeError(\"Input must be a list of integers.\")\n\n    n = len(arr)\n    # Handle empty array case as per FR5.\n    if n == 0:\n        return 0\n\n    # dp[i] stores the maximum product of an increasing subsequence ending at arr[i].\n    # Initialize dp with each element, as it forms a subsequence of length one (FR6).\n    dp = list(arr)\n\n    for i in range(n):\n        for j in range(i):\n            # If arr[i] can extend an increasing subsequence ending at arr[j] (BR1).\n            if arr[i] > arr[j]:\n                # Update dp[i] to maximize product for subsequences ending at arr[i].\n                dp[i] = max(dp[i], dp[j] * arr[i])\n    \n    # Return the largest product found among all increasing subsequences (FR4).\n    return max(dp)\n```"}
{"task_id": "Mbpp/472", "solution": "```python\nfrom typing import List\n\ndef check_Consecutive(numbers: List[int]) -> bool:\n    \"\"\"\n    Checks if the given list of integers contains at least one sequence of consecutive numbers.\n    The list is sorted, and then adjacent elements are compared.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n    if len(numbers) < 2:\n        return False\n\n    sorted_numbers = sorted(numbers)\n\n    for i in range(len(sorted_numbers) - 1):\n        if sorted_numbers[i] + 1 == sorted_numbers[i+1]:\n            return True\n    return False\n```"}
{"task_id": "Mbpp/471", "solution": "```python\ndef find_remainder(arr: list[int], n: int) -> int:\n    \"\"\"Calculates the product of all elements in the input list `arr` modulo `n`.\n    This function includes robust input validation.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Modulus 'n' must be a positive integer.\")\n\n    product = 1\n    for x in arr:\n        if not isinstance(x, int):\n            raise TypeError(\"All elements in 'arr' must be integers.\")\n        product = (product * x) % n\n    return product\n```"}
{"task_id": "Mbpp/468", "solution": "```python\nfrom typing import List\n\ndef max_product(arr: List[int]) -> int:\n    \"\"\"\n    Calculates the maximum product of an increasing subsequence.\n    Performs input validation and handles various numerical scenarios.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input must be a list.\")\n    if not all(isinstance(x, int) for x in arr):\n        raise ValueError(\"All elements in the list must be integers.\")\n\n    n = len(arr)\n    if n == 0:\n        return 0\n    if n == 1:\n        return arr[0]\n\n    # dp[i] stores the max product of an increasing subsequence ending at index i.\n    # Initialize with individual elements as they are single-element subsequences.\n    dp = list(arr) \n\n    # Iterate to find the maximum product for subsequences ending at each index.\n    # The O(n^2) dynamic programming approach ensures all valid subsequences are considered.\n    for i in range(n):\n        for j in range(i):\n            if arr[i] > arr[j]:\n                dp[i] = max(dp[i], dp[j] * arr[i])\n        \n    # The maximum value in the dp array is the overall maximum product.\n    # This correctly handles cases with negative numbers and single-element subsequences.\n    return max(dp)\n```\n"}
{"task_id": "Mbpp/472", "solution": "```python\ndef check_Consecutive(numbers: list[int | float]) -> bool:\n    \"\"\"\n    Checks if the given list contains consecutive numbers.\n    It raises TypeError for non-list input or ValueError for non-numeric elements.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n\n    if not all(isinstance(n, (int, float)) for n in numbers):\n        raise ValueError(\"List must contain only numeric elements (int or float).\")\n\n    if len(numbers) < 2:\n        return False\n\n    sorted_numbers = sorted(numbers)\n\n    for i in range(len(sorted_numbers) - 1):\n        if abs(sorted_numbers[i] - sorted_numbers[i+1]) == 1:\n            return True\n    return False\n```"}
