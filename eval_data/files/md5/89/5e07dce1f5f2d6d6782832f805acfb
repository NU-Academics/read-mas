{"task_id": "Mbpp/450", "solution": "```python\ndef extract_string(string_list: list[str], size: int) -> list[str]:\n    \"\"\"\n    Filters a list of strings, returning only those with an exact specified length.\n    Raises TypeError for invalid input types or ValueError for negative size.\n    \"\"\"\n    if not isinstance(string_list, list):\n        raise TypeError(\"Input 'string_list' must be a list.\")\n    if not all(isinstance(s, str) for s in string_list):\n        raise TypeError(\"All elements in 'string_list' must be strings.\")\n    if not isinstance(size, int):\n        raise TypeError(\"Input 'size' must be an integer.\")\n    if size < 0:\n        raise ValueError(\"Input 'size' cannot be negative.\")\n\n    return [s for s in string_list if len(s) == size]\n```"}
{"task_id": "Mbpp/450", "solution": "```python\nfrom typing import List\n\ndef extract_string(string_list: List[str], target_length: int) -> List[str]:\n    \"\"\"\n    Extracts strings of a specific length from a list.\n    Non-string elements in the input list are gracefully ignored.\n    \"\"\"\n    if not isinstance(string_list, list):\n        raise TypeError(\"string_list must be a list.\")\n    if not isinstance(target_length, int):\n        raise TypeError(\"target_length must be an integer.\")\n    if target_length < 0:\n        raise ValueError(\"target_length cannot be negative.\")\n\n    result = []\n    for item in string_list:\n        if isinstance(item, str) and len(item) == target_length:\n            result.append(item)\n    return result\n```"}
{"task_id": "Mbpp/448", "solution": "```python\nfrom typing import Dict\n\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input parameters.\n    It carries a descriptive message about the error.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\n# Global memoization dictionary to store already calculated Perrin numbers.\n# This optimizes performance by avoiding redundant calculations.\n_perrin_memo: Dict[int, int] = {\n    0: 3,\n    1: 0,\n    2: 2\n}\n\ndef _get_perrin_number(k: int) -> int:\n    \"\"\"Recursively calculates the k-th Perrin number using memoization.\n    P(0)=3, P(1)=0, P(2)=2, P(k) = P(k-2) + P(k-3) for k >= 3.\n    \"\"\"\n    if k < 0:\n        # This case should not be reached with non-negative 'n' input.\n        raise InvalidInputError(\"Internal error: Perrin number index must be non-negative.\")\n\n    if k in _perrin_memo:\n        return _perrin_memo[k]\n\n    # Calculate recursively and store in memo for future use.\n    perrin_k = _get_perrin_number(k - 2) + _get_perrin_number(k - 3)\n    _perrin_memo[k] = perrin_k\n    return perrin_k\n\ndef cal_sum(n: int) -> int:\n    \"\"\"Calculates the sum of Perrin numbers from P(0) to P(n).\n    It handles input validation and utilizes a memoized helper function.\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise InvalidInputError(\"Input 'n' must be a non-negative integer.\")\n\n    total_sum = 0\n    # Iterate from 0 to n (inclusive) to sum Perrin numbers.\n    for i in range(n + 1):\n        total_sum += _get_perrin_number(i)\n    return total_sum\n```"}
{"task_id": "Mbpp/451", "solution": "```python\ndef remove_whitespaces(input_string: str) -> str:\n    \"\"\"Removes all standard whitespace characters from the input string.\n    Raises TypeError if the input is not a string.\"\"\"\n    if not isinstance(input_string, str):\n        raise TypeError(\"Input must be a string.\")\n    return input_string.replace(\" \", \"\").replace(\"\\t\", \"\").replace(\"\\n\", \"\").replace(\"\\r\", \"\").replace(\"\\f\", \"\").replace(\"\\v\", \"\")\n```"}
{"task_id": "Mbpp/425", "solution": "```python\n# src/list_utils/exceptions.py\nclass ListUtilsError(Exception):\n    \"\"\"Base exception for errors in the list_utils package.\n    It stores a descriptive error message.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass InvalidInputError(ListUtilsError):\n    \"\"\"Exception raised for invalid input types or structures.\n    It inherits from ListUtilsError.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\n# src/list_utils/counter.py\nfrom typing import Any\nfrom .exceptions import InvalidInputError\n\ndef count_element_in_list(list_of_lists: list[list[Any]], element: Any) -> int:\n    \"\"\"\n    Counts the number of sublists containing a particular element.\n    It validates input types and raises InvalidInputError for malformed inputs.\n    \"\"\"\n    if not isinstance(list_of_lists, list):\n        raise InvalidInputError(\"Input 'list_of_lists' must be a list.\")\n\n    count = 0\n    for i, sublist in enumerate(list_of_lists):\n        if not isinstance(sublist, list):\n            raise InvalidInputError(f\"Item at index {i} in 'list_of_lists' is not a list.\")\n        if element in sublist:\n            count += 1\n    return count\n```"}
{"task_id": "Mbpp/453", "solution": "```python\ndef sumofFactors(number: int) -> int:\n    \"\"\"\n    Calculates the sum of all even factors of a given integer.\n    It handles negative numbers by considering their absolute value.\n    \"\"\"\n    if not isinstance(number, int):\n        raise TypeError(\"Input 'number' must be an integer.\")\n\n    if number == 0:\n        return 0\n    \n    # Consider absolute value for factor calculation.\n    abs_number = abs(number)\n    \n    total_sum = 0\n    for i in range(1, abs_number + 1):\n        if abs_number % i == 0:  # Check if i is a factor.\n            if i % 2 == 0:      # Check if i is an even factor.\n                total_sum += i\n    return total_sum\n```"}
{"task_id": "Mbpp/453", "solution": "```python\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\ndef sumofFactors(number: int) -> int:\n    \"\"\"\n    Calculates the sum of all even factors of a given integer.\n    Raises InvalidInputError if the input is not a positive integer.\n    \"\"\"\n    if not isinstance(number, int) or number < 1:\n        raise InvalidInputError(\"Input must be a positive integer.\")\n\n    total_sum = 0\n    for i in range(1, number + 1):\n        if number % i == 0 and i % 2 == 0:\n            total_sum += i\n    return total_sum\n```"}
{"task_id": "Mbpp/454", "solution": "```python\ndef text_match_wordz(text: str) -> bool:\n    \"\"\"\n    Checks if the input string contains the lowercase letter 'z'.\n    Raises TypeError if the input text is not a string.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input 'text' must be a string.\")\n    return 'z' in text\n```"}
{"task_id": "Mbpp/454", "solution": "```python\ndef text_match_wordz(text: str) -> bool:\n    \"\"\"Checks if any word in the text contains 'z' (case-insensitive).\n    Raises TypeError if the input is not a string.\"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input 'text' must be a string.\")\n\n    words = text.split()\n    for word in words:\n        if 'z' in word.lower():\n            return True\n    return False\n```"}
{"task_id": "Mbpp/455", "solution": "MONTHS_WITH_31_DAYS = {1, 3, 5, 7, 8, 10, 12}\n\ndef check_monthnumb_number(monthnumb_number: int) -> bool:\n    \"\"\"\n    Checks if the given month number corresponds to a month with 31 days.\n    Raises ValueError if the input is not a valid month number (1-12).\n    \"\"\"\n    if not isinstance(monthnumb_number, int):\n        raise ValueError(\"monthnumb_number must be an integer.\")\n    if not (1 <= monthnumb_number <= 12):\n        raise ValueError(\"monthnumb_number must be between 1 and 12.\")\n\n    return monthnumb_number in MONTHS_WITH_31_DAYS"}
{"task_id": "Mbpp/456", "solution": "```python\ndef reverse_string_list(string_list: list[str]) -> list[str]:\n    \"\"\"Reverses each string in the provided list, returning a new list with the reversed strings.\n    Raises TypeError if input is not a list or contains non-string elements.\n    \"\"\"\n    if not isinstance(string_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    reversed_list = []\n    for s in string_list:\n        if not isinstance(s, str):\n            raise TypeError(f\"All elements in the list must be strings, but found type {type(s).__name__}.\")\n        reversed_list.append(s[::-1])\n    return reversed_list\n```"}
{"task_id": "Mbpp/455", "solution": "```python\ndef check_monthnumb_number(month_number: int) -> bool:\n    \"\"\"\n    Checks if the given month number corresponds to a month with 31 days.\n    Raises InvalidMonthNumberError if the month number is invalid.\n    \"\"\"\n    MONTHS_WITH_31_DAYS = {1, 3, 5, 7, 8, 10, 12}\n    class InvalidMonthNumberError(ValueError):\n        \"\"\"Custom exception raised for invalid month numbers.\"\"\"\n        def __init__(self, message: str = \"Month number must be between 1 and 12.\"):\n            self.message = message\n            super().__init__(self.message)\n\n    if not isinstance(month_number, int) or not (1 <= month_number <= 12):\n        raise InvalidMonthNumberError(\n            f\"Invalid month number: {month_number}. Month number must be an integer between 1 and 12.\"\n        )\n    return month_number in MONTHS_WITH_31_DAYS\n\n```"}
{"task_id": "Mbpp/456", "solution": "```python\ndef reverse_string_list(input_list: list[str]) -> list[str]:\n    \"\"\"\n    Reverses each string in the input list, converting non-string elements to string before reversal.\n    Returns a new list with the reversed string representations.\n    \"\"\"\n    reversed_strings = []\n    for item in input_list:\n        s = str(item)\n        reversed_strings.append(s[::-1])\n    return reversed_strings\n```"}
