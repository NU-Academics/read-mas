{"task_id": "Mbpp/126", "solution": "```python\ndef sum(num1: int, num2: int) -> int:\n    \"\"\"Calculates the sum of all common positive divisors of two given positive integers.\n    Raises ValueError for invalid inputs.\"\"\"\n\n    # Validate inputs based on FR1 and BR1\n    for num, param_name in [(num1, \"num1\"), (num2, \"num2\")]:\n        if not isinstance(num, int):\n            raise ValueError(f\"Parameter '{param_name}' must be an integer.\")\n        if num <= 0:\n            raise ValueError(f\"Parameter '{param_name}' must be a positive integer.\")\n\n    # Helper function to find all positive divisors of a number (from DivisorCalculator.find_divisors)\n    def _find_divisors(n: int) -> list[int]:\n        divs = []\n        for i in range(1, int(n**0.5) + 1):\n            if n % i == 0:\n                divs.append(i)\n                if i * i != n:\n                    divs.append(n // i)\n        return sorted(divs)\n\n    # Find common divisors (from DivisorCalculator.find_common_divisors)\n    divs1 = set(_find_divisors(num1))\n    divs2 = set(_find_divisors(num2))\n    common_divs = sorted(list(divs1.intersection(divs2)))\n\n    # Calculate and return the sum of common divisors (FR3, FR4)\n    return sum(common_divs)\n```"}
{"task_id": "Mbpp/128", "solution": "```python\ndef long_words(n: int, text: str) -> list[str]:\n    \"\"\"Filters a given text string and returns words strictly longer than n characters. Raises TypeError or ValueError for invalid inputs.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer.\")\n    if not isinstance(text, str):\n        raise TypeError(\"text must be a string.\")\n    if n < 0:\n        raise ValueError(\"n cannot be negative.\")\n\n    words = text.split()\n    return [word for word in words if len(word) > n]\n```"}
{"task_id": "Mbpp/128", "solution": "```python\nimport re\nfrom typing import List\n\ndef long_words(n: int, text: str) -> List[str]:\n    \"\"\"\n    Filters a string for words strictly longer than `n` characters.\n    Punctuation is stripped from word boundaries before length check.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer.\")\n    if not isinstance(text, str):\n        raise TypeError(\"text must be a string.\")\n\n    words = text.split()\n    long_words_list = []\n    for word in words:\n        cleaned_word = re.sub(r'^\\W+|\\W+$', '', word)\n        if len(cleaned_word) > n:\n            long_words_list.append(cleaned_word)\n    return long_words_list\n```"}
{"task_id": "Mbpp/130", "solution": "```python\nfrom collections import Counter\n\nclass EmptyListError(Exception):\n    \"\"\"Custom exception raised when an empty list is provided.\n    It indicates that an operation requires at least one element.\n    \"\"\"\n    def __init__(self, message=\"Input list cannot be empty.\"):\n        self.message = message\n        super().__init__(self.message)\n\nclass MaxOccurrencesFinder:\n    @staticmethod\n    def find(data_list: list) -> any:\n        \"\"\"Finds the item with the highest frequency in a list.\n        Raises TypeError for non-list input, EmptyListError for empty lists.\n        \"\"\"\n        if not isinstance(data_list, list):\n            raise TypeError(\"Input must be a list.\")\n        if not data_list:\n            raise EmptyListError()\n\n        counts = Counter(data_list)\n        # most_common(1) returns a list of tuples: [('item', count)]\n        most_common_item, _ = counts.most_common(1)[0]\n        return most_common_item\n\ndef max_occurrences(data_list: list) -> any:\n    \"\"\"Finds the item with the maximum frequency in a given list.\n    Handles type checking and empty list errors.\n    \"\"\"\n    return MaxOccurrencesFinder.find(data_list)\n```"}
