{"task_id": "Mbpp/775", "solution": "```python\nfrom typing import List\n\ndef odd_position(data_list: List[int]) -> bool:\n    \"\"\"\n    Checks if every element at an odd index in `data_list` is an odd number.\n    Raises TypeError for invalid input types or non-integer elements.\n    \"\"\"\n    if not isinstance(data_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    if not data_list:\n        return True\n\n    for i, element in enumerate(data_list):\n        if not isinstance(element, int):\n            raise TypeError(f\"List elements must be integers, found {type(element).__name__} at index {i}.\")\n\n        if i % 2 != 0:  # Check if index is odd\n            if element % 2 == 0:  # Check if number at odd index is even\n                return False\n\n    return True\n\n```"}
{"task_id": "Mbpp/777", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input to list analysis functions.\"\"\"\n    pass\n\nfrom typing import List, Union, Set\n\ndef find_sum(data_list: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"\n    Calculates the sum of all unique numerical elements in the provided list.\n    Raises InvalidInputError if input is not a list or contains non-numerical elements.\n    \"\"\"\n    if not isinstance(data_list, list):\n        raise InvalidInputError(\"Input must be a list.\")\n\n    unique_elements: Set[Union[int, float]] = set()\n    for item in data_list:\n        if not isinstance(item, (int, float)):\n            raise InvalidInputError(\"List must contain only numbers.\")\n        unique_elements.add(item)\n\n    return sum(unique_elements)\n"}
{"task_id": "Mbpp/778", "solution": "```python\ndef pack_consecutive_duplicates(input_list: list) -> list[list]:\n    \"\"\"\n    Packs consecutive duplicate elements of a list into sublists.\n    This function processes the list in O(n) time complexity.\n    \"\"\"\n    if not input_list:\n        return []\n\n    packed_list = []\n    current_sublist = [input_list[0]] # Initialize with the first element.\n\n    for i in range(1, len(input_list)):\n        if input_list[i] == input_list[i-1]:\n            current_sublist.append(input_list[i])\n        else:\n            packed_list.append(current_sublist)\n            current_sublist = [input_list[i]] # Start a new sublist.\n    \n    packed_list.append(current_sublist) # Append the last collected sublist.\n    return packed_list\n```"}
{"task_id": "Mbpp/777", "solution": "```python\nfrom collections import Counter\n\ndef find_sum(input_list: list) -> int | float:\n    \"\"\"\n    Calculates the sum of elements that appear exactly once in a given list of numbers.\n    \"\"\"\n    if not input_list:\n        return 0\n\n    element_counts = Counter(input_list)\n\n    total_sum = 0\n    for element, count in element_counts.items():\n        if count == 1:\n            total_sum += element\n\n    return total_sum\n```"}
{"task_id": "Mbpp/778", "solution": "from typing import List, Any\n\ndef pack_consecutive_duplicates(data_list: List[Any]) -> List[List[Any]]:\n    \"\"\"Packs consecutive duplicate elements of a list into sublists. Raises TypeError if input is not a list.\"\"\"\n    if not isinstance(data_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    if not data_list:\n        return []\n\n    packed_list: List[List[Any]] = []\n    current_group: List[Any] = []\n\n    for item in data_list:\n        if not current_group or item == current_group[0]:\n            current_group.append(item)\n        else:\n            packed_list.append(current_group)\n            current_group = [item]\n\n    if current_group:\n        packed_list.append(current_group)\n\n    return packed_list\n"}
{"task_id": "Mbpp/781", "solution": "```python\nimport math\n\ndef count_divisors(n: int) -> bool:\n    \"\"\"\n    Determines if the number of positive divisors for integer 'n' is even.\n    It leverages the property that only perfect squares have an odd number of positive divisors.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n\n    if n == 0:\n        return True  # 0 positive divisors is an even count\n\n    abs_n = abs(n)\n    sqrt_abs_n = math.isqrt(abs_n)\n\n    # If abs_n is a perfect square, it has an odd number of divisors.\n    # Otherwise, it has an even number of divisors.\n    is_perfect_square = (sqrt_abs_n * sqrt_abs_n == abs_n)\n    return not is_perfect_square\n```"}
{"task_id": "Mbpp/780", "solution": "```python\ndef find_combinations(tuple_list: list[tuple]) -> list[tuple]:\n    \"\"\"\n    Calculates the element-wise sum of all unique pairs of tuples from an input list.\n    Validates input and returns an empty list if fewer than two tuples are provided.\n\n    Args:\n        tuple_list: A list of tuples, where each inner tuple contains numeric elements.\n\n    Returns:\n        A list of tuples, each representing the element-wise sum of two distinct\n        tuples from tuple_list. Returns an empty list if tuple_list has\n        fewer than two elements.\n\n    Raises:\n        ValueError: If the tuple_list or its elements are invalid.\n    \"\"\"\n    import itertools\n\n    # Input Validation: Check if the input is a list.\n    if not isinstance(tuple_list, list):\n        raise ValueError(\"Input must be a list.\")\n\n    # Return an empty list if there are fewer than two tuples to combine.\n    if len(tuple_list) < 2:\n        return []\n\n    # Input Validation: Check if all elements in the list are tuples.\n    for i, item in enumerate(tuple_list):\n        if not isinstance(item, tuple):\n            raise ValueError(f\"Element at index {i} is not a tuple: {item}\")\n\n    # Input Validation: Check if all tuples have the same length.\n    first_tuple_len = len(tuple_list[0])\n    for i, item in enumerate(tuple_list):\n        if len(item) != first_tuple_len:\n            raise ValueError(\n                f\"Tuple at index {i} has inconsistent length. Expected {first_tuple_len}, got {len(item)}.\"\n            )\n\n    # Input Validation: Check if all elements within tuples are numeric.\n    for i, tpl in enumerate(tuple_list):\n        for j, element in enumerate(tpl):\n            if not isinstance(element, (int, float)):\n                raise ValueError(\n                    f\"Element at tuple index {i}, position {j} is not numeric: {element}\"\n                )\n\n    result_sums = []\n    # Use itertools.combinations to get unique pairs of tuples\n    for tuple_a, tuple_b in itertools.combinations(tuple_list, 2):\n        # Perform element-wise summation\n        sum_tuple = tuple(a + b for a, b in zip(tuple_a, tuple_b))\n        result_sums.append(sum_tuple)\n\n    return result_sums\n```"}
{"task_id": "Mbpp/782", "solution": "```python\ndef odd_length_sum(arr: list[int]) -> int:\n    \"\"\"Calculates the sum of all elements across all possible odd-length subarrays of the input list.\n    Each element's contribution is determined by the number of odd-length subarrays it belongs to.\n    \"\"\"\n    total_sum = 0\n    n = len(arr)\n    for i in range(n):\n        # Calculate how many odd-length subarrays arr[i] is part of.\n        occurrences = ((i + 1) * (n - i) + 1) // 2\n        total_sum += arr[i] * occurrences\n    return total_sum\n```"}
{"task_id": "Mbpp/781", "solution": "```python\nimport math\n\ndef count_divisors(number: int) -> bool:\n    \"\"\"Checks if the count of divisors for a positive integer is even.\n    Raises ValueError if the input is not a positive integer.\"\"\"\n    \n    if not isinstance(number, int) or number <= 0:\n        raise ValueError(\"Number must be a positive integer.\")\n\n    divisor_count = 0\n    # Calculate the total count of divisors using the square root method.\n    for i in range(1, int(math.sqrt(number)) + 1):\n        if number % i == 0:\n            if i * i == number:\n                divisor_count += 1\n            else:\n                divisor_count += 2\n    \n    # Determine if the calculated divisor count is even.\n    return divisor_count % 2 == 0\n```"}
{"task_id": "Mbpp/780", "solution": "from itertools import combinations\n\ndef find_combinations(tuple_list: list[tuple[int | float, int | float]]) -> list[tuple[int | float, int | float]]:\n    \"\"\"\n    Finds combinations of sums with tuples in the given tuple list.\n\n    Args:\n        tuple_list: A list of two-element numeric tuples. Each inner tuple\n                    must contain exactly two numeric values (integers or floats).\n                    The list must contain at least two tuples for combinations.\n\n    Returns:\n        A list of tuples, where each tuple is the element-wise sum of two\n        distinct tuples from the input list. The order of sums in the output\n        list corresponds to the order of combinations generated by itertools.\n\n    Raises:\n        ValueError: If the input is not a list, contains fewer than two tuples,\n                    or if any element is not a two-element tuple of numbers.\n    \"\"\"\n    # Input Validation\n    if not isinstance(tuple_list, list):\n        raise ValueError(\"Input must be a list.\")\n    if len(tuple_list) < 2:\n        raise ValueError(\"Input list must contain at least two tuples for combinations.\")\n    for i, item in enumerate(tuple_list):\n        if not isinstance(item, tuple) or len(item) != 2:\n            raise ValueError(f\"Element at index {i} must be a two-element tuple.\")\n        if not all(isinstance(x, (int, float)) for x in item):\n            raise ValueError(f\"Elements in tuple at index {i} must be numbers (int or float).\")\n\n    # Combination and Sum Logic\n    result_combinations = []\n    for t1, t2 in combinations(tuple_list, 2):\n        sum_tuple = (t1[0] + t2[0], t1[1] + t2[1])\n        result_combinations.append(sum_tuple)\n\n    return result_combinations"}
{"task_id": "Mbpp/763", "solution": "```python\nfrom typing import Tuple\n\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input parameters.\n    It inherits from Python's built-in Exception class.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\ndef find_min_diff(arr: Tuple[int, ...], n: int) -> int:\n    \"\"\"\n    Finds the minimum absolute difference between any two elements in an array.\n    Raises InvalidInputError if the array has fewer than two elements.\n    \"\"\"\n    if n < 2:\n        raise InvalidInputError(\"Input array must contain at least two elements.\")\n\n    sorted_arr = sorted(arr)\n    min_diff = float('inf')\n\n    for i in range(n - 1):\n        current_diff = abs(sorted_arr[i + 1] - sorted_arr[i])\n        min_diff = min(min_diff, current_diff)\n        \n    return int(min_diff)\n```"}
{"task_id": "Mbpp/784", "solution": "```python\ndef mul_even_odd(numbers: list[int]) -> int | None:\n    \"\"\"\n    Calculates the product of the first even and first odd number in 'numbers'.\n    Returns None if either number is not found; raises TypeError for invalid input.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n\n    first_even = None\n    first_odd = None\n\n    for num in numbers:\n        if not isinstance(num, int):\n            raise TypeError(\"List must contain only integers.\")\n\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        elif first_odd is None and num % 2 != 0:\n            first_odd = num\n\n        if first_even is not None and first_odd is not None:\n            break\n\n    if first_even is not None and first_odd is not None:\n        return first_even * first_odd\n    else:\n        return None\n```"}
{"task_id": "Mbpp/786", "solution": "```python\nfrom typing import List, Any\n\ndef right_insertion(sorted_list: List[Any], value: Any) -> int:\n    \"\"\"\n    Locates the right insertion point for a value in a sorted list.\n    The function returns the index where the value should be inserted to maintain\n    sorted order, ensuring that elements equal to the value are placed to its left.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low\n```"}
{"task_id": "Mbpp/785", "solution": "```python\nclass InvalidTupleStringError(ValueError):\n    \"\"\"Custom exception raised when a string cannot be converted to an integer tuple.\n    It provides a descriptive message explaining the failure cause.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\ndef tuple_str_int(tuple_string: str) -> tuple[int, ...]:\n    \"\"\"Converts a string representation of an integer tuple into an actual Python tuple of integers.\n    Raises InvalidTupleStringError if the input string is not a valid format.\"\"\"\n    if not isinstance(tuple_string, str) or not tuple_string.strip():\n        raise InvalidTupleStringError(\"Input must be a non-empty string.\")\n\n    stripped_string = tuple_string.strip()\n\n    if not (stripped_string.startswith('(') and stripped_string.endswith(')')):\n        raise InvalidTupleStringError(\"Input string must start and end with parentheses.\")\n\n    content = stripped_string[1:-1].strip()\n\n    if not content: # Handles \"()\"\n        return ()\n\n    elements = content.split(',')\n    int_elements: list[int] = []\n\n    for element_str in elements:\n        try:\n            int_elements.append(int(element_str.strip()))\n        except ValueError as e:\n            raise InvalidTupleStringError(\n                f\"Element '{element_str.strip()}' is not a valid integer.\"\n            ) from e\n\n    return tuple(int_elements)\n```"}
{"task_id": "Mbpp/784", "solution": "```python\ndef mul_even_odd(numbers: list) -> int:\n    \"\"\"Calculates the product of the first even and first odd number in a list.\n    It raises ValueError exceptions if either number is not found.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in numbers:\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n        # Stop iteration early once both numbers are identified.\n        if first_even is not None and first_odd is not None:\n            break\n\n    if first_even is None:\n        raise ValueError(\"No even number found in the list.\")\n    if first_odd is None:\n        raise ValueError(\"No odd number found in the list.\")\n\n    return first_even * first_odd\n```"}
{"task_id": "Mbpp/785", "solution": "```python\nclass ConversionError(Exception):\n    \"\"\"Custom exception for errors during string to tuple conversion.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass StringParser:\n    \"\"\"\n    Utility class for parsing string elements from tuple-like content.\n    It splits content by commas and strips whitespace from each element.\n    \"\"\"\n\n    @staticmethod\n    def parse_tuple_elements(tuple_content: str) -> list[str]:\n        \"\"\"\n        Parses the content of a tuple string into a list of element strings.\n        Returns an empty list if the content is empty or only whitespace.\n        \"\"\"\n        if not tuple_content.strip():\n            return []\n        return [element.strip() for element in tuple_content.split(',')]\n\nclass TupleConverterService:\n    \"\"\"\n    Service for converting string representations of tuples into actual tuples of integers.\n    It handles validation and element conversion, raising specific errors for failures.\n    \"\"\"\n\n    def convert_string_to_tuple(self, tuple_string: str) -> tuple[int, ...]:\n        \"\"\"\n        Converts a string representation of a tuple (e.g., \"(7, 8, 9)\")\n        into an actual tuple of integers (e.g., (7, 8, 9)).\n        \"\"\"\n        if not isinstance(tuple_string, str):\n            raise ConversionError(\"Input must be a string.\")\n\n        if not (tuple_string.startswith('(') and tuple_string.endswith(')')):\n            raise ConversionError(f\"Invalid tuple format: '{tuple_string}'. Must start with '(' and end with ')'.\")\n\n        content = tuple_string[1:-1] # Remove parentheses\n\n        element_strings = StringParser.parse_tuple_elements(content)\n\n        if not element_strings: # Handles \"()\" or \"( )\"\n            return ()\n\n        converted_elements: list[int] = []\n        for element_str in element_strings:\n            try:\n                if not element_str.strip(): # Handles cases like \"(1,,3)\" or \"(1, ,3)\"\n                    raise ValueError(\"Empty element found in tuple string.\")\n                converted_elements.append(int(element_str))\n            except ValueError as e:\n                raise ConversionError(f\"Could not convert element '{element_str}' to integer: {e}\") from e\n\n        return tuple(converted_elements)\n\ndef tuple_str_int(tuple_string: str) -> tuple[int, ...]:\n    \"\"\"\n    Converts a string representation of an integer tuple to an actual Python tuple.\n    Raises ConversionError for invalid formats or non-integer elements.\n    \"\"\"\n    converter = TupleConverterService()\n    return converter.convert_string_to_tuple(tuple_string)\n```"}
