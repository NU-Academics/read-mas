{"task_id": "Mbpp/723", "solution": "```python\ndef count_same_pair(list1: list, list2: list) -> int:\n    \"\"\"Counts the number of indices where elements in list1 and list2 are identical.\n    Handles None inputs and length mismatches by raising ValueError, and returns 0 for empty lists.\n    \"\"\"\n    if list1 is None or list2 is None:\n        raise ValueError(\"Input lists cannot be None.\")\n    if len(list1) != len(list2):\n        raise ValueError(\"Input lists must have the same length.\")\n    if not list1:  # If lists are empty, count is 0.\n        return 0\n\n    same_pair_count = 0\n    for i in range(len(list1)):\n        if list1[i] == list2[i]:\n            same_pair_count += 1\n    return same_pair_count\n```"}
{"task_id": "Mbpp/724", "solution": "```python\ndef power_base_sum(base: int, power: int) -> int:\n    \"\"\"Calculates the sum of digits of 'base' raised to 'power'.\n    Raises ValueError for invalid input types or negative values.\n    \"\"\"\n    if not isinstance(base, int) or not isinstance(power, int):\n        raise ValueError(\"Base and power must be integers.\")\n    if base < 0 or power < 0:\n        raise ValueError(\"Base and power must be non-negative.\")\n\n    result = base ** power\n    sum_of_digits = sum(int(digit) for digit in str(result))\n    return sum_of_digits\n```"}
{"task_id": "Mbpp/721", "solution": "import math\nfrom typing import List, Tuple, Optional\n\nclass Matrix:\n    \"\"\"Represents the input square matrix as a data object.\"\"\"\n    def __init__(self, data: List[List[int]]) -> None:\n        self.data = data\n        self.size = len(data)\n\n    def get_cost(self, r: int, c: int) -> int:\n        \"\"\"Retrieves the cost of a cell at specific coordinates.\"\"\"\n        return self.data[r][c]\n\nclass Path:\n    \"\"\"Represents a single path through the matrix.\"\"\"\n    def __init__(self, initial_coordinates: Optional[List[Tuple[int, int]]] = None) -> None:\n        self.coordinates: List[Tuple[int, int]] = []\n        self.total_cost: int = 0\n        self.num_cells: int = 0\n        self.average_cost: float = 0.0\n\n    @classmethod\n    def from_coordinates_and_matrix(cls, coords: List[Tuple[int, int]], matrix_obj: Matrix) -> 'Path':\n        \"\"\"Creates a Path object from a list of coordinates and calculates its properties.\"\"\"\n        path = cls()\n        for r, c in coords:\n            cost = matrix_obj.get_cost(r, c)\n            path.add_coordinate(r, c, cost)\n        path.calculate_average()\n        return path\n\n    def add_coordinate(self, r: int, c: int, cost: int) -> None:\n        \"\"\"Adds a new cell's coordinate and cost to the path, updating totals.\"\"\"\n        self.coordinates.append((r, c))\n        self.total_cost += cost\n        self.num_cells += 1\n\n    def calculate_average(self) -> None:\n        \"\"\"Computes and sets the average_cost attribute.\"\"\"\n        if self.num_cells > 0:\n            self.average_cost = float(self.total_cost) / self.num_cells\n        else:\n            self.average_cost = 0.0\n\nclass MatrixValidator:\n    \"\"\"Provides static methods for validating raw matrix inputs.\"\"\"\n    def validate_square_matrix(self, raw_matrix: List[List[int]]) -> None:\n        \"\"\"Checks if the input raw_matrix is a valid square matrix of integers.\"\"\"\n        if not isinstance(raw_matrix, list) or not raw_matrix:\n            raise ValueError(\"Input matrix cannot be empty or not a list.\")\n\n        n = len(raw_matrix)\n        for row in raw_matrix:\n            if not isinstance(row, list) or len(row) != n:\n                raise ValueError(\"Input matrix must be square (N*N) with all rows of length N.\")\n            for cell in row:\n                if not isinstance(cell, int):\n                    raise ValueError(\"All matrix cells must contain integers.\")\n\nclass PathFinderService:\n    \"\"\"Implements the core business logic for path finding and average calculation.\"\"\"\n    def find_max_average_path(self, matrix_obj: Matrix) -> float:\n        \"\"\"Initiates the recursive path-finding process and returns the highest average.\"\"\"\n        all_paths_coords: List[List[Tuple[int, int]]] = []\n        self._find_all_paths_recursive(matrix_obj, 0, 0, [], all_paths_coords)\n\n        if not all_paths_coords:\n            return 0.0 # Should not happen for valid N*N matrix, as at least one path exists.\n\n        max_average = -math.inf\n        for path_coords in all_paths_coords:\n            path_obj = Path.from_coordinates_and_matrix(path_coords, matrix_obj)\n            if path_obj.average_cost > max_average:\n                max_average = path_obj.average_cost\n        return max_average\n\n    def _find_all_paths_recursive(self, matrix_obj: Matrix, r: int, c: int,\n                                 current_path_coords: List[Tuple[int, int]],\n                                 all_paths_coords: List[List[Tuple[int, int]]]) -> None:\n        \"\"\"Recursive helper to explore all paths from (r, c) to the bottom-right.\"\"\"\n        current_path_coords.append((r, c))\n\n        if r == matrix_obj.size - 1 and c == matrix_obj.size - 1:\n            all_paths_coords.append(list(current_path_coords)) # A full path found, append a copy.\n        else:\n            if c + 1 < matrix_obj.size: # Move right\n                self._find_all_paths_recursive(matrix_obj, r, c + 1, current_path_coords, all_paths_coords)\n            if r + 1 < matrix_obj.size: # Move down\n                self._find_all_paths_recursive(matrix_obj, r + 1, c, current_path_coords, all_paths_coords)\n\n        current_path_coords.pop() # Backtrack: remove current cell for other path explorations.\n\nclass MatrixController:\n    \"\"\"Acts as the public interface for the application, handling input and orchestrating.\"\"\"\n    def __init__(self, path_finder_service: Optional[PathFinderService] = None,\n                 matrix_validator: Optional[MatrixValidator] = None) -> None:\n        self.path_finder_service = path_finder_service if path_finder_service is not None else PathFinderService()\n        self.matrix_validator = matrix_validator if matrix_validator is not None else MatrixValidator()\n\n    def max_average_of_path(self, raw_matrix: List[List[int]]) -> float:\n        \"\"\"Main entry point: Validates input, converts to Matrix, finds max average path.\"\"\"\n        self.matrix_validator.validate_square_matrix(raw_matrix)\n        matrix_obj = Matrix(raw_matrix)\n        return self.path_finder_service.find_max_average_path(matrix_obj)\n\ndef maxAverageOfPath(raw_matrix: List[List[int]]) -> float:\n    \"\"\"\n    Finds the path with the highest average cost in a square matrix.\n    Movement is restricted to only 'right' or 'down' from the top-left to bottom-right cell.\n    \"\"\"\n    controller = MatrixController()\n    return controller.max_average_of_path(raw_matrix)"}
{"task_id": "Mbpp/722", "solution": "```python\ndef filter_data(student_data: dict[str, tuple[float, float]], minimal_height: float, minimal_weight: float) -> dict[str, tuple[float, float]]:\n    \"\"\"Filters students based on minimum height and weight criteria.\n    Only students strictly exceeding both minimal_height and minimal_weight are included.\n    \"\"\"\n    if not isinstance(student_data, dict):\n        raise TypeError(\"student_data must be a dictionary.\")\n    if not isinstance(minimal_height, (int, float)):\n        raise TypeError(\"minimal_height must be a float or int.\")\n    if not isinstance(minimal_weight, (int, float)):\n        raise TypeError(\"minimal_weight must be a float or int.\")\n\n    filtered_students = {}\n    for name, attributes in student_data.items():\n        if not isinstance(attributes, tuple) or len(attributes) != 2:\n            raise ValueError(f\"Student '{name}' data is malformed. Expected a tuple of two elements.\")\n        \n        height, weight = attributes\n\n        if not isinstance(height, (int, float)) or not isinstance(weight, (int, float)):\n            raise ValueError(f\"Student '{name}' has malformed height/weight data: ({height}, {weight}). Expected (float, float).\")\n\n        if height > minimal_height and weight > minimal_weight:\n            filtered_students[name] = (height, weight)\n    return filtered_students\n```"}
{"task_id": "Mbpp/724", "solution": "```python\ndef power_base_sum(base: int, power: int) -> int:\n    \"\"\"\n    Calculates the sum of all digits of the base to the specified power.\n    It raises TypeError for non-integer inputs or ValueError for negative power.\n    \"\"\"\n    if not isinstance(base, int) or not isinstance(power, int):\n        raise TypeError(\"Base and power must be integers.\")\n    if power < 0:\n        raise ValueError(\"Power must be a non-negative integer.\")\n\n    result = base ** power\n    sum_of_digits = sum(int(digit) for digit in str(result) if digit.isdigit())\n    return sum_of_digits\n```"}
