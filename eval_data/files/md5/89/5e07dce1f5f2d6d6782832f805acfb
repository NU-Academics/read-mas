{"task_id": "Mbpp/793", "solution": "```python\ndef last(arr: list[int], x: int) -> int:\n    \"\"\"Finds the last index of element x in the sorted array arr. Returns -1 if x is not found.\"\"\"\n    n = len(arr)\n    low = 0\n    high = n - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if arr[mid] == x:\n            result = mid\n            low = mid + 1  # Search right for the last occurrence.\n        elif arr[mid] < x:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return result\n```"}
{"task_id": "Mbpp/794", "solution": "```python\nimport re\n\n\ndef text_starta_endb(text: str) -> bool:\n    \"\"\"\n    Checks if the input string starts with 'a', is followed by any characters,\n    and ends with 'b'. Raises TypeError if input is not a string.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input 'text' must be a string.\")\n    \n    # Matches strings that start with 'a', contain zero or more characters, and end with 'b'.\n    return bool(re.fullmatch(r'^a.*b$', text))\n```"}
{"task_id": "Mbpp/793", "solution": "def find_last_position(arr: list[int], target: int) -> int:\n    \"\"\"\n    Finds the last index of a target element in a sorted array using binary search.\n    Returns the last index of the target if found, otherwise -1.\n    \"\"\"\n    low = 0\n    high = len(arr) - 1\n    last_index = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if arr[mid] == target:\n            last_index = mid\n            low = mid + 1  # Search in the right half for a potentially later occurrence.\n        elif arr[mid] < target:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return last_index"}
{"task_id": "Mbpp/794", "solution": "```python\nimport re\n\n# The regular expression pattern to match strings starting with 'a' and ending with 'b'.\nREGEX_PATTERN = r'^a.*b$'\n\ndef text_starta_endb(text: str) -> bool:\n    \"\"\"Checks if a string starts with 'a', contains any characters, and ends with 'b'.\n    Raises TypeError if the input is not a string.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input 'text' must be a string.\")\n        \n    return re.match(REGEX_PATTERN, text) is not None\n```"}
{"task_id": "Mbpp/796", "solution": "from typing import Union\n\ndef return_sum(data: dict) -> Union[int, float]:\n    \"\"\"\n    Calculates the sum of all numeric values in the given dictionary.\n    Raises TypeError if any value is not numeric.\n    \"\"\"\n    total = 0\n    for key, value in data.items():\n        if not isinstance(value, (int, float)):\n            raise TypeError(f\"Value for key '{key}' is not numeric: {type(value)}\")\n        total += value\n    return total"}
{"task_id": "Mbpp/796", "solution": "```python\nfrom typing import Dict, Union\n\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input data.\n    Raised when the input dictionary or its values are not as expected.\"\"\"\n    pass\n\ndef return_sum(data: Dict[str, Union[int, float]]) -> Union[int, float]:\n    \"\"\"Calculates the sum of all numeric values in a dictionary.\n    Raises InvalidInputError if input is not a dictionary or contains non-numeric values.\"\"\"\n    if not isinstance(data, dict):\n        raise InvalidInputError(\"Input must be a dictionary.\")\n\n    total_sum: Union[int, float] = 0\n\n    for key, value in data.items():\n        if not isinstance(value, (int, float)):\n            raise InvalidInputError(\n                f\"Invalid input: Value '{value}' for key '{key}' is not numeric.\"\n            )\n        total_sum += value\n    return total_sum\n```"}
{"task_id": "Mbpp/797", "solution": "```python\ndef sum_in_range(l: int, r: int) -> int:\n    \"\"\"\n    Calculates the sum of all odd natural numbers within the inclusive range [l, r].\n    Returns 0 if the input range is invalid (l > r or l < 1).\n    \"\"\"\n    if l > r or l < 1:\n        # As per the specification, return 0 for invalid input ranges.\n        return 0\n\n    current_sum = 0\n    # Determine the first odd number that is within the range [l, r].\n    start = l if l % 2 != 0 else l + 1\n\n    # Iterate through odd numbers from 'start' up to 'r' (inclusive), stepping by 2.\n    for num in range(start, r + 1, 2):\n        current_sum += num\n    return current_sum\n```"}
{"task_id": "Mbpp/797", "solution": "```python\ndef sum_in_range(l: int, r: int) -> int:\n    \"\"\"\n    Calculates the sum of all odd natural numbers within the inclusive range [l, r].\n    Natural numbers are considered positive integers (1, 2, 3, ...).\n    \"\"\"\n    if l > r:\n        return 0\n\n    # Helper to sum odd natural numbers up to k.\n    def _sum_up_to_odd_natural(k: int) -> int:\n        if k < 1:\n            return 0\n        # Count of odd numbers up to k.\n        num_odd_numbers = (k + 1) // 2\n        return num_odd_numbers * num_odd_numbers\n\n    # Ensure lower bound is at least 1 for natural numbers.\n    actual_l = max(1, l)\n    actual_r = r\n\n    # Calculate sum using difference of sums up to actual_r and (actual_l - 1).\n    total_sum = _sum_up_to_odd_natural(actual_r) - _sum_up_to_odd_natural(actual_l - 1)\n    return total_sum\n```"}
{"task_id": "Mbpp/798", "solution": "```python\nfrom typing import List, Union, Any\n\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input data.\n    Raised when non-numeric elements are found or input is not a list.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\ndef is_numeric(value: Any) -> bool:\n    \"\"\"Checks if a given value is an integer or a float.\"\"\"\n    return isinstance(value, (int, float))\n\ndef _sum(array: List[Any]) -> Union[int, float]:\n    \"\"\"Calculates the sum of all numeric elements in a list.\n    Raises InvalidInputError for non-numeric elements or non-list input.\n    \"\"\"\n    total_sum: Union[int, float] = 0\n\n    if not isinstance(array, list):\n        raise InvalidInputError(\"Input must be a list.\")\n\n    if not array:\n        return 0\n\n    for element in array:\n        if not is_numeric(element):\n            raise InvalidInputError(f\"Non-numeric element found: {element}\")\n        total_sum += element\n\n    return total_sum\n```"}
{"task_id": "Mbpp/798", "solution": "from typing import List, Union\n\ndef _sum(arr: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"Calculates the sum of all numeric elements in a list.\n    Raises TypeError for non-list input or non-numeric elements.\"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input must be a list.\")\n\n    total_sum: Union[int, float] = 0\n    for num in arr:\n        if not isinstance(num, (int, float)):\n            raise TypeError(f\"All elements in the list must be numbers, got {type(num).__name__}.\")\n        total_sum += num\n    return total_sum"}
{"task_id": "Mbpp/799", "solution": "```python\ndef left_rotate(num: int, d: int) -> int:\n    \"\"\"Rotates the bits of a 32-bit number to the left by 'd' positions. Returns the 32-bit integer after left rotation.\"\"\"\n    d = d % 32\n    num &= 0xFFFFFFFF\n    return ((num << d) | (num >> (32 - d))) & 0xFFFFFFFF\n```"}
{"task_id": "Mbpp/799", "solution": "BITS_IN_INT = 32\nMAX_32_BIT_VALUE = 0xFFFFFFFF # Represents 2^32 - 1\n\ndef left_rotate(n: int, d: int) -> int:\n    \"\"\"\n    Rotates the bits of a 32-bit unsigned integer 'n' to the left by 'd' positions.\n    Handles input validation and ensures the result is a 32-bit unsigned integer.\n    \"\"\"\n    if not isinstance(n, int) or not isinstance(d, int):\n        raise TypeError(\"Both n and d must be integers.\")\n    if not (0 <= n <= MAX_32_BIT_VALUE):\n        raise ValueError(f\"n must be a 32-bit unsigned integer (0 to {MAX_32_BIT_VALUE}).\")\n\n    effective_d = d % BITS_IN_INT\n    # Perform the left rotation by combining left-shifted and right-shifted parts.\n    rotated_n = ((n << effective_d) | (n >> (BITS_IN_INT - effective_d)))\n    \n    # Mask the result to ensure it stays within 32 bits.\n    return rotated_n & MAX_32_BIT_VALUE"}
