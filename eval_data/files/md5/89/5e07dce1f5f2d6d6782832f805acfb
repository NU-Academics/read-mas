{"task_id": "Mbpp/116", "solution": "```python\nclass NonPositiveIntegerError(ValueError):\n    \"\"\"Custom exception for non-positive integer elements.\n    Inherits from ValueError for consistency with standard error types.\"\"\"\n    pass\n\ndef tuple_to_int(input_tuple: tuple[int]) -> int:\n    \"\"\"Converts a tuple of positive integers into a single concatenated integer.\n    Raises TypeError or NonPositiveIntegerError for invalid inputs.\"\"\"\n\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n\n    if not input_tuple:\n        return 0\n\n    string_parts = []\n    for element in input_tuple:\n        # Validate each element to be a positive integer.\n        if not isinstance(element, int) or element <= 0:\n            raise NonPositiveIntegerError(\n                f\"All elements in the tuple must be positive integers. Found: {element}\"\n            )\n        string_parts.append(str(element))\n\n    return int(\"\".join(string_parts))\n```"}
{"task_id": "Mbpp/119", "solution": "```python\ndef search(nums: list[int]) -> int:\n    \"\"\"Finds the unique element in a sorted array where all others appear twice.\n    Raises ValueError if the input array is empty.\n    \"\"\"\n    if not nums:\n        raise ValueError(\"Input array cannot be empty.\")\n\n    low, high = 0, len(nums) - 1\n    while low < high:\n        mid = (low + high) // 2\n        # Check if nums[mid] is part of a valid pair pattern based on its index.\n        # If the pattern is intact, the unique element must be in the right half.\n        if (mid % 2 == 0 and nums[mid] == nums[mid + 1]) or \\\n           (mid % 2 == 1 and nums[mid] == nums[mid - 1]):\n            low = mid + 1\n        else:\n            # If the pattern is broken, the unique element is at or to the left of mid.\n            high = mid\n    return nums[low]\n```"}
{"task_id": "Mbpp/120", "solution": "```python\nimport math\n\ndef max_product_tuple(data_list: list[tuple[int | float, int | float]]) -> int | float:\n    \"\"\"Calculates the maximum absolute product from pairs of numbers in a list of tuples.\n    Raises TypeError or ValueError for invalid inputs, returns 0 for an empty list.\n    \"\"\"\n    if not isinstance(data_list, list):\n        raise TypeError(\"Input 'data_list' must be a list.\")\n\n    if not data_list:\n        return 0\n\n    max_abs_product = -math.inf\n\n    for i, item_tuple in enumerate(data_list):\n        if not isinstance(item_tuple, tuple):\n            raise ValueError(f\"Element at index {i} must be a tuple, got {type(item_tuple).__name__}.\")\n        if len(item_tuple) != 2:\n            raise ValueError(f\"Tuple at index {i} must contain exactly two elements, got {len(item_tuple)}.\")\n\n        num1, num2 = item_tuple\n        if not isinstance(num1, (int, float)) or not isinstance(num2, (int, float)):\n            raise TypeError(f\"Elements in tuple at index {i} must be numeric, got {type(num1).__name__}, {type(num2).__name__}.\")\n\n        current_product = num1 * num2\n        max_abs_product = max(max_abs_product, abs(current_product))\n\n    return max_abs_product\n```"}
{"task_id": "Mbpp/120", "solution": "```python\nfrom typing import List, Tuple, Union\n\ndef max_product_tuple(data: List[Tuple[Union[int, float], Union[int, float]]]) -> int:\n    \"\"\"\n    Calculates the maximum absolute product between numbers in pairs of tuples\n    within a given list. Returns 0 if the input list is empty.\n    \"\"\"\n    if not isinstance(data, list):\n        raise TypeError(\"Input 'data' must be a list.\")\n\n    if not data:\n        return 0\n\n    max_abs_product = 0.0\n\n    for item in data:\n        if not isinstance(item, tuple) or len(item) != 2:\n            raise ValueError(\"Each element in the list must be a tuple of two numbers.\")\n        \n        num1, num2 = item\n        if not isinstance(num1, (int, float)) or not isinstance(num2, (int, float)):\n            raise ValueError(\"Each element in the tuple must be a number (int or float).\")\n\n        current_product = abs(num1 * num2)\n        if current_product > max_abs_product:\n            max_abs_product = current_product\n    \n    return int(max_abs_product)\n```"}
{"task_id": "Mbpp/119", "solution": "```python\ndef search(arr: list[int]) -> int:\n    \"\"\"\n    Finds the single unique element in a sorted list where all others appear twice.\n    Raises TypeError or ValueError for invalid input or pattern violation.\n    \"\"\"\n    # Validate input type: must be a list of integers.\n    if not isinstance(arr, list):\n        raise TypeError(\"Input must be a list.\")\n    if not all(isinstance(x, int) for x in arr):\n        raise TypeError(\"All elements in the list must be integers.\")\n    \n    # Handle empty list gracefully.\n    if not arr:\n        raise ValueError(\"Input list cannot be empty.\")\n    \n    # Ensure the input list is sorted in ascending order.\n    if len(arr) > 1 and any(arr[i] > arr[i+1] for i in range(len(arr) - 1)):\n        raise ValueError(\"Input list must be sorted.\")\n    \n    # If the list has an even length (and is not empty), it violates the \"exactly one unique\" pattern\n    # as per problem statement and NFR1 for O(log n) solution.\n    if len(arr) % 2 == 0:\n        raise ValueError(\"Input list pattern violated: even length implies no unique element based on problem constraints.\")\n        \n    # If the list contains only one element, it is the unique element.\n    if len(arr) == 1:\n        return arr[0]\n\n    # Use binary search to find the unique element with O(log n) time complexity.\n    left, right = 0, len(arr) - 1\n    \n    while left < right:\n        mid = (left + right) // 2\n        \n        # Check if the element at 'mid' is part of a pair based on its index parity.\n        # If arr[mid] is paired, the unique element must be in the right subarray.\n        # This logic works because if an element is unique, the pairs on its left\n        # will maintain (even, odd) indices for identical elements. After the unique element,\n        # the pairing indices will flip to (odd, even) for identical elements.\n        if (mid % 2 == 0 and arr[mid] == arr[mid + 1]) or \\\n           (mid % 2 == 1 and arr[mid] == arr[mid - 1]):\n            left = mid + 1\n        else:\n            # If arr[mid] is not paired, it might be the unique element or it's to the left.\n            # We set right = mid because the unique element could be at `mid` itself.\n            right = mid\n\n    # After the loop, 'left' points to the index of the unique element.\n    return arr[left]\n```"}
{"task_id": "Mbpp/123", "solution": "```python\nimport functools\nfrom typing import Set\n\n@functools.lru_cache(maxsize=None)\ndef _sum_proper_divisors(n: int) -> int:\n    \"\"\"Calculates the sum of proper divisors for a positive integer n.\n    Raises ValueError if n is not positive.\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    if n == 1:\n        return 0\n\n    s = 1\n    for i in range(2, int(n**0.5) + 1):\n        if n % i == 0:\n            s += i\n            if i * i != n:\n                s += n // i\n    return s\n\ndef amicable_numbers_sum(limit: int) -> int:\n    \"\"\"Calculates the sum of all amicable numbers up to a specified limit.\n    Raises ValueError if the limit is not a positive integer.\n    \"\"\"\n    if limit <= 0:\n        raise ValueError(\"Limit must be a positive integer.\")\n\n    total_sum = 0\n    found_amicable_numbers: Set[int] = set()\n\n    for i in range(1, limit + 1):\n        if i in found_amicable_numbers:\n            continue\n\n        sum_div_i = _sum_proper_divisors(i)\n\n        if sum_div_i > i and sum_div_i <= limit:\n            sum_div_sum_div_i = _sum_proper_divisors(sum_div_i)\n            if sum_div_sum_div_i == i:\n                total_sum += i + sum_div_i\n                found_amicable_numbers.add(i)\n                found_amicable_numbers.add(sum_div_i)\n    return total_sum\n```\n"}
