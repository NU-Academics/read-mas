{"task_id": "Mbpp/437", "solution": "```python\ndef remove_odd(text: str) -> str:\n    \"\"\"Removes characters at odd 1-based positions from the input string.\n    This retains characters at even 1-based positions (odd 0-based indices).\"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input must be a string.\")\n\n    result = []\n    # Iterate through the string, retaining characters if their 0-based index is odd.\n    for i in range(len(text)):\n        if i % 2 != 0:\n            result.append(text[i])\n    return \"\".join(result)\n```"}
{"task_id": "Mbpp/437", "solution": "```python\ndef remove_odd(input_string: str) -> str:\n    \"\"\"Removes characters at odd indices from a string, keeping those at even indices.\n    Raises TypeError if input is not a string.\"\"\"\n    if not isinstance(input_string, str):\n        raise TypeError(\"Input must be a string.\")\n    \n    result_chars = []\n    for i in range(len(input_string)):\n        if i % 2 == 0:  # Select characters at even indices (0, 2, 4, ...)\n            result_chars.append(input_string[i])\n    return \"\".join(result_chars)\n```"}
{"task_id": "Mbpp/436", "solution": "```python\nfrom typing import List, Union, Any\n\ndef neg_nos(numbers: List[Union[int, float]]) -> List[Union[int, float]]:\n    \"\"\"\n    Identifies and returns all negative numbers from a given list.\n    Raises TypeError if input is not a list, ValueError if elements are not numbers.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n\n    for item in numbers:\n        if not isinstance(item, (int, float)):\n            raise ValueError(f\"All elements in the list must be numbers. Found: {type(item).__name__}\")\n\n    negative_numbers = [num for num in numbers if num < 0]\n    return negative_numbers\n```"}
{"task_id": "Mbpp/439", "solution": "```python\nclass IntegerJoinerError(Exception):\n    \"\"\"Custom exception for errors in the integer joining utility.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nDEFAULT_EMPTY_LIST_RETURN_VALUE = 0\n\ndef _validate_integer_list(numbers: list) -> None:\n    \"\"\"Validates if the input is a list of non-negative integers.\n    Raises IntegerJoinerError if validation fails.\"\"\"\n    if not isinstance(numbers, list):\n        raise IntegerJoinerError(\"Input must be a list.\")\n    for item in numbers:\n        if not isinstance(item, int):\n            raise IntegerJoinerError(f\"List element '{item}' is not an integer.\")\n        if item < 0:\n            raise IntegerJoinerError(f\"List element '{item}' is a negative integer. Only non-negative integers are allowed.\")\n\ndef multiple_to_single(numbers: list[int]) -> int:\n    \"\"\"Concatenates a list of non-negative integers into a single integer.\n    Raises IntegerJoinerError for invalid inputs.\"\"\"\n    _validate_integer_list(numbers)\n\n    if not numbers:\n        return DEFAULT_EMPTY_LIST_RETURN_VALUE\n\n    joined_string = \"\".join(str(num) for num in numbers)\n    return int(joined_string)\n```"}
{"task_id": "Mbpp/439", "solution": "```python\ndef multiple_to_single(numbers: list[int]) -> int:\n    \"\"\"\n    Joins a list of integers into a single integer by concatenating their string representations.\n    Raises TypeError for invalid input types or if any element is not an integer.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list of integers.\")\n\n    if not numbers:\n        return 0\n\n    string_parts = []\n    for num in numbers:\n        if not isinstance(num, int):\n            raise TypeError(\"All elements in the list must be integers.\")\n        string_parts.append(str(abs(num)))\n\n    joined_string = \"\".join(string_parts)\n    return int(joined_string)\n```"}
{"task_id": "Mbpp/441", "solution": "```python\nfrom typing import Any\n\ndef surfacearea_cube(size: Any) -> float:\n    \"\"\"Calculates the surface area of a cube given its side length.\n    Raises ValueError for non-numeric or negative side lengths.\"\"\"\n    \n    try:\n        validated_size = float(size)\n    except (TypeError, ValueError) as e:\n        raise ValueError(\"size must be a numeric value.\") from e\n    \n    if validated_size < 0:\n        raise ValueError(\"size must be a non-negative number.\")\n    \n    return 6 * (validated_size ** 2)\n```"}
{"task_id": "Mbpp/440", "solution": "import re\n\nclass AdverbMatcher:\n    COMMON_ADVERBS = [\n        \"very\", \"always\", \"never\", \"often\", \"seldom\", \"well\", \"fast\", \"hard\", \"late\", \"early\", \"just\", \"already\", \"still\", \"yet\", \"ago\", \"soon\", \"today\", \"tomorrow\", \"yesterday\", \"here\", \"there\", \"everywhere\", \"somewhere\", \"anywhere\", \"nowhere\", \"up\", \"down\", \"in\", \"out\", \"on\", \"off\", \"away\", \"back\", \"forward\", \"home\", \"abroad\", \"alone\", \"together\", \"apart\", \"indeed\", \"perhaps\", \"maybe\", \"rather\", \"quite\", \"too\", \"enough\", \"also\", \"even\", \"only\", \"almost\", \"nearly\", \"scarcely\", \"hardly\", \"barely\", \"much\", \"more\", \"most\", \"less\", \"least\", \"so\", \"such\", \"how\", \"what\", \"when\", \"where\", \"why\", \"whether\", \"if\", \"though\", \"although\", \"unless\", \"until\", \"while\", \"since\", \"before\", \"after\", \"as\", \"than\", \"that\", \"for\", \"because\", \"lest\", \"ere\", \"whilst\", \"whence\", \"whereby\", \"wherefore\", \"wherein\", \"whereof\", \"whereon\", \"whereupon\", \"wherever\", \"wherewith\", \"whither\", \"whyever\"\n    ]\n    ADVERB_SUFFIXES = [\"ly\", \"ward\", \"wards\", \"wise\"]\n\n    def is_adverb(self, word: str) -> bool:\n        \"\"\"\n        Checks if the given word is considered an adverb based on predefined lists and suffix rules.\n        This includes checking against common adverbs and common adverbial suffixes.\n        \"\"\"\n        word_lower = word.lower()\n        if word_lower in self.COMMON_ADVERBS:\n            return True\n        for suffix in self.ADVERB_SUFFIXES:\n            if word_lower.endswith(suffix) and len(word_lower) > len(suffix):\n                return True\n        return False\n\nclass AdverbFinder:\n    def __init__(self):\n        \"\"\"Initializes the AdverbFinder with an instance of AdverbMatcher.\"\"\"\n        self._adverb_matcher = AdverbMatcher()\n\n    def find_adverb_position(self, sentence: str) -> tuple[int, int, str] | None:\n        \"\"\"\n        Identifies the first adverb in a given sentence and returns its position and the adverb itself.\n        Raises TypeError or ValueError for invalid input.\n        \"\"\"\n        if not isinstance(sentence, str):\n            raise TypeError(\"Input 'sentence' must be a string.\")\n        if not sentence:\n            raise ValueError(\"Input 'sentence' cannot be empty.\")\n\n        # Use regex to find words, handling contractions but generally ignoring other punctuation\n        words_with_indices = []\n        for match in re.finditer(r\"\\b\\w+(?:'\\w+)?\\b\", sentence):\n            words_with_indices.append((match.group(0), match.start(), match.end()))\n\n        for word, start_index, end_index in words_with_indices:\n            if self._adverb_matcher.is_adverb(word):\n                return (start_index, end_index, word)\n        return None\n\n# Module-level instance for the AdverbFinder to adhere to the stateless design for the public function.\n_adverb_finder_instance = AdverbFinder()\n\ndef find_adverb_position(sentence: str) -> tuple[int, int, str] | None:\n    \"\"\"\n    Provides a utility to programmatically extract the first adverb and its position from text.\n    It leverages an internal AdverbFinder instance for the core logic.\n    \"\"\"\n    return _adverb_finder_instance.find_adverb_position(sentence)"}
{"task_id": "Mbpp/441", "solution": "```python\nfrom typing import Any\n\ndef surfacearea_cube(size: Any) -> float:\n    \"\"\"\n    Calculates the surface area of a cube of a given size.\n\n    Args:\n        size: The length of one side of the cube. Can be an int, float, or a string\n              that can be converted to a float.\n\n    Returns:\n        The calculated surface area as a float.\n\n    Raises:\n        ValueError: If size is not a number or is negative.\n    \"\"\"\n    try:\n        num_size = float(size)\n    except (TypeError, ValueError):\n        raise ValueError(\"size must be a number.\")\n\n    if num_size < 0:\n        raise ValueError(\"size must be a non-negative number.\")\n    \n    return 6 * num_size * num_size\n```"}
{"task_id": "Mbpp/446", "solution": "```python\ndef count_Occurrence(target_tuple: tuple, search_list: list) -> int:\n    \"\"\"\n    Counts the total occurrences of elements from a search_list within a target_tuple.\n    Raises TypeError for incorrect input types and returns 0 for empty collections.\n    \"\"\"\n    if not isinstance(target_tuple, tuple):\n        raise TypeError(\"target_tuple must be a tuple\")\n    if not isinstance(search_list, list):\n        raise TypeError(\"search_list must be a list\")\n\n    total_count = 0\n    for item_to_find in search_list:\n        total_count += target_tuple.count(item_to_find)\n    return total_count\n```"}
{"task_id": "Mbpp/445", "solution": "```python\ndef index_multiplication(\n    tuple1: tuple[tuple[int | float, ...], ...],\n    tuple2: tuple[tuple[int | float, ...], ...]\n) -> tuple[tuple[int | float, ...], ...]:\n    \"\"\"\n    Performs index-wise multiplication of elements in two nested tuples.\n    It includes strict validation on input types, dimensions, and element types.\n    \"\"\"\n    if not isinstance(tuple1, tuple) or not isinstance(tuple2, tuple):\n        raise TypeError(\"Both inputs must be tuples.\")\n\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Input tuples must have the same number of inner tuples.\")\n\n    result_outer_tuple = []\n    for i in range(len(tuple1)):\n        inner_tuple1 = tuple1[i]\n        inner_tuple2 = tuple2[i]\n\n        if not isinstance(inner_tuple1, tuple) or not isinstance(inner_tuple2, tuple):\n            raise TypeError(f\"Inner elements at index {i} must be tuples.\")\n\n        if len(inner_tuple1) != len(inner_tuple2):\n            raise ValueError(f\"Inner tuples at index {i} must have the same number of elements.\")\n\n        result_inner_tuple = []\n        for j in range(len(inner_tuple1)):\n            elem1 = inner_tuple1[j]\n            elem2 = inner_tuple2[j]\n\n            if not isinstance(elem1, (int, float)) or not isinstance(elem2, (int, float)):\n                raise TypeError(f\"All elements must be numeric (int or float). Found non-numeric at outer index {i}, inner index {j}.\")\n\n            result_inner_tuple.append(elem1 * elem2)\n        result_outer_tuple.append(tuple(result_inner_tuple))\n\n    return tuple(result_outer_tuple)\n```"}
{"task_id": "Mbpp/440", "solution": "import re\nimport nltk\nfrom nltk.tag import pos_tag\nimport string\n\n# Handle NLTK data downloads. These lines ensure the necessary tagger data is available.\ntry:\n    nltk.data.find('taggers/averaged_perceptron_tagger')\nexcept nltk.downloader.DownloadError:\n    nltk.download('averaged_perceptron_tagger')\ntry:\n    nltk.data.find('tokenizers/punkt')\nexcept nltk.downloader.DownloadError:\n    nltk.download('punkt')\n\n\nclass Utils:\n    \"\"\"Provides general utility functions.\"\"\"\n    @staticmethod\n    def is_valid_sentence(sentence: str) -> bool:\n        \"\"\"Checks if the input is a non-empty string.\"\"\"\n        return isinstance(sentence, str) and bool(sentence.strip())\n\n\nclass SentenceTokenizer:\n    \"\"\"Breaks a sentence into words and tracks their original start and end indices.\"\"\"\n    def tokenize_with_positions(self, sentence: str) -> list[tuple[str, int, int]]:\n        \"\"\"Tokenizes the input sentence into words and records their start/end indices.\"\"\"\n        tokens_with_positions = []\n        # Matches any sequence of non-whitespace characters to capture words with attached punctuation.\n        for match in re.finditer(r'\\S+', sentence):\n            word = match.group(0)\n            start_index = match.start()\n            end_index = match.end()\n            tokens_with_positions.append((word, start_index, end_index))\n        return tokens_with_positions\n\n\nclass POSTagger:\n    \"\"\"Provides an adapter for an external POS tagging library (e.g., NLTK).\"\"\"\n    def __init__(self):\n        # NLTK data downloads are handled at the top-level for convenience.\n        pass\n\n    def tag_sentence(self, tokens: list[str]) -> list[tuple[str, str]]:\n        \"\"\"Tags a list of word tokens with their Part-of-Speech.\"\"\"\n        return pos_tag(tokens)\n\n\nclass AdverbDetectorService:\n    \"\"\"Orchestrates the process of finding the first adverb and its position in a sentence.\"\"\"\n    ADVERB_POS_TAGS = ['RB', 'RBR', 'RBS'] # Penn Treebank tags for Adverb, Adverb (comparative), Adverb (superlative).\n\n    def __init__(self, pos_tagger: POSTagger, tokenizer: SentenceTokenizer):\n        \"\"\"Initializes with required POS tagger and tokenizer dependencies.\"\"\"\n        self._pos_tagger = pos_tagger\n        self._tokenizer = tokenizer\n\n    def find_adverb_position(self, sentence: str) -> tuple[int, int, str] | None:\n        \"\"\"\n        Finds the first adverb and its position in the given sentence.\n        Adjusts the adverb string and end index to strip trailing punctuation\n        to match the specific assertion requirement.\n        \"\"\"\n        if not Utils.is_valid_sentence(sentence):\n            raise ValueError(\"Input must be a non-empty string.\")\n\n        tokens_with_pos = self._tokenizer.tokenize_with_positions(sentence)\n        if not tokens_with_pos:\n            return None\n\n        words_only = [token_info[0] for token_info in tokens_with_pos]\n        tagged_words = self._pos_tagger.tag_sentence(words_only)\n\n        for i, (word_from_tagger, tag) in enumerate(tagged_words):\n            if tag in self.ADVERB_POS_TAGS:\n                original_token_with_punctuation = tokens_with_pos[i][0]\n                start_index = tokens_with_pos[i][1]\n\n                # Strip trailing punctuation to match the user's assert example\n                cleaned_adverb = original_token_with_punctuation.rstrip(string.punctuation)\n\n                # The end_index should correspond to the cleaned adverb\n                # It's the original start_index plus the length of the cleaned adverb\n                end_index = start_index + len(cleaned_adverb)\n\n                # If stripping punctuation results in an empty string (e.g., token was just \"!!\"),\n                # continue to the next token.\n                if not cleaned_adverb:\n                    continue\n\n                return (start_index, end_index, cleaned_adverb)\n        return None\n\n\ndef find_adverb_position(sentence: str) -> tuple[int, int, str] | None:\n    \"\"\"\n    Identifies the first adverb in a given sentence and returns its exact position and the adverb itself.\n    This function orchestrates tokenization, POS tagging, and adverb identification.\n    It returns a tuple (start_index, end_index, adverb_word), where adverb_word is stripped of trailing punctuation,\n    and the indices correspond to the stripped word.\n    Example: find_adverb_position(\"clearly!! we can see the sky\") == (0, 7, 'clearly')\n    \"\"\"\n    pos_tagger = POSTagger()\n    tokenizer = SentenceTokenizer()\n    detector = AdverbDetectorService(pos_tagger, tokenizer)\n    return detector.find_adverb_position(sentence)"}
{"task_id": "Mbpp/445", "solution": "```python\ndef index_multiplication(tuple1: tuple[tuple[int | float, ...], ...], tuple2: tuple[tuple[int | float, ...], ...]) -> tuple[tuple[int | float, ...], ...]:\n    \"\"\"\n    Performs index-wise multiplication of elements in two nested tuples.\n    This function validates inputs for type and length consistency before multiplying.\n    \"\"\"\n    if not isinstance(tuple1, tuple) or not isinstance(tuple2, tuple):\n        raise TypeError(\"Both inputs must be tuples.\")\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Input tuples must have the same number of inner tuples.\")\n\n    result = []\n    for i in range(len(tuple1)):\n        inner_tuple1 = tuple1[i]\n        inner_tuple2 = tuple2[i]\n\n        if not isinstance(inner_tuple1, tuple) or not isinstance(inner_tuple2, tuple):\n            raise TypeError(f\"Elements at index {i} must be inner tuples.\")\n        if len(inner_tuple1) != len(inner_tuple2):\n            raise ValueError(f\"Inner tuples at index {i} must have the same length.\")\n\n        inner_result = []\n        for j in range(len(inner_tuple1)):\n            val1 = inner_tuple1[j]\n            val2 = inner_tuple2[j]\n            if not isinstance(val1, (int, float)) or not isinstance(val2, (int, float)):\n                raise TypeError(f\"Elements at index ({i}, {j}) must be numeric.\")\n            inner_result.append(val1 * val2)\n        result.append(tuple(inner_result))\n    return tuple(result)\n```"}
{"task_id": "Mbpp/446", "solution": "```python\ndef count_Occurrence(data_tuple: tuple, elements_to_count: list) -> int:\n    \"\"\"\n    Counts total occurrences of elements from a list within a tuple.\n    It optimizes lookups by converting the list to a set.\n    \"\"\"\n    total_count = 0\n    elements_set = set(elements_to_count)\n    for item in data_tuple:\n        if item in elements_set:\n            total_count += 1\n    return total_count\n```"}
{"task_id": "Mbpp/447", "solution": "```python\nfrom typing import List, Union\n\ndef cube_nums(numbers: List[Union[int, float]]) -> List[Union[int, float]]:\n    \"\"\"Calculates the cube of each numeric element in a list.\n    Returns a new list with the cubed values, raising TypeError for invalid inputs.\"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n\n    cubed_numbers = []\n    for num in numbers:\n        if not isinstance(num, (int, float)):\n            raise TypeError(f\"List elements must be numbers (int or float), but found {type(num).__name__}.\")\n        cubed_numbers.append(num ** 3)\n    \n    return cubed_numbers\n```"}
{"task_id": "Mbpp/447", "solution": "```python\ndef cube_nums(numbers_list: list[int | float]) -> list[int | float]:\n    \"\"\"Calculates the cube of each number in a list, returning a new list of cubed values.\n    Raises TypeError if the input is not a list or contains non-numeric elements.\n    \"\"\"\n    if not isinstance(numbers_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    cubed_list = []\n    for number in numbers_list:\n        if not isinstance(number, (int, float)):\n            raise TypeError(f\"All elements in the list must be numbers, got {type(number).__name__}.\")\n        cubed_list.append(number ** 3)\n    return cubed_list\n```"}
