{"task_id": "Mbpp/603", "solution": "```python\ndef get_ludic(n: int) -> list[int]:\n    \"\"\"\n    Calculates Ludic numbers up to a given integer n using a sieve method.\n    Returns an empty list if n is less than 1.\n    \"\"\"\n    if n < 1:\n        return []\n\n    numbers = list(range(1, n + 1))\n    ludic_numbers = []\n\n    while numbers:\n        l = numbers.pop(0)\n        ludic_numbers.append(l)\n\n        if l == 1:\n            continue\n\n        new_numbers = []\n        count = 0\n        for num in numbers:\n            count += 1\n            if count % l != 0:\n                new_numbers.append(num)\n        numbers = new_numbers\n    return ludic_numbers\n```"}
{"task_id": "Mbpp/607", "solution": "```python\nimport re\nfrom typing import Optional, Tuple\n\nclass InvalidPatternError(Exception):\n    \"\"\"Custom exception raised for invalid regular expression patterns.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\ndef find_literals(text: str, pattern: str) -> Optional[Tuple[str, int, int]]:\n    \"\"\"\n    Searches a string for a regex pattern and returns the first matching substring,\n    its start, and end indices.\n    Raises InvalidPatternError if the pattern is not a valid regular expression.\n    \"\"\"\n    try:\n        compiled_pattern = re.compile(pattern)\n    except re.error as e:\n        raise InvalidPatternError(f\"Invalid regex pattern: {pattern}. Error: {e}\") from e\n\n    match = compiled_pattern.search(text)\n    if match:\n        return match.group(0), match.start(), match.end()\n    return None\n```"}
{"task_id": "Mbpp/607", "solution": "import re\nfrom typing import Optional, Tuple\n\ndef find_literals(target_string: str, pattern: str) -> Optional[Tuple[str, int, int]]:\n    \"\"\"\n    Searches the target_string for the first occurrence of the regular expression pattern.\n    Returns a tuple (matched substring, start index, end index) or None; raises `re.error` for invalid patterns.\n    \"\"\"\n    match = re.search(pattern, target_string)\n    if match:\n        return match.group(0), match.start(), match.end()\n    return None"}
{"task_id": "Mbpp/610", "solution": "```python\ndef remove_kth_element(input_list: list, k: int) -> list:\n    \"\"\"\n    Returns a new list with the k-th element removed.\n    Raises IndexError if k is out of bounds for the input_list.\n    \"\"\"\n    if not (0 <= k < len(input_list)):\n        raise IndexError(f\"Index {k} is out of bounds for list of length {len(input_list)}\")\n\n    return input_list[:k] + input_list[k+1:]\n```"}
{"task_id": "Mbpp/610", "solution": "```python\ndef remove_kth_element(input_list: list, k: int) -> list:\n    \"\"\"\n    Removes the k-th (1-indexed) element from a list and returns a new list.\n    Raises IndexError if k is out of bounds.\n    \"\"\"\n    if not (1 <= k <= len(input_list)):\n        raise IndexError(f\"k ({k}) is out of bounds for the list of length {len(input_list)}.\")\n    \n    # Python lists are 0-indexed, so the k-th element is at index k-1.\n    return input_list[:k-1] + input_list[k:]\n```"}
{"task_id": "Mbpp/608", "solution": "```python\ndef bell_Number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Bell number for a non-negative integer n.\n    Raises ValueError for invalid input as per specification.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    if n == 0:\n        return 1\n\n    # Computes Bell numbers using a dynamic programming approach (Bell triangle).\n    # The value `bell[i][0]` in the first column stores the ith Bell number `B(i)`.\n    bell = [[0 for _ in range(n + 1)] for _ in range(n + 1)]\n\n    bell[0][0] = 1\n\n    for i in range(1, n + 1):\n        bell[i][0] = bell[i - 1][i - 1]\n        for j in range(1, i + 1):\n            bell[i][j] = bell[i - 1][j - 1] + bell[i][j - 1]\n\n    return bell[n][0]\n```"}
{"task_id": "Mbpp/611", "solution": "```python\ndef max_of_nth(matrix: list[list[int]], n: int) -> int:\n    \"\"\"\n    Finds the maximum value in the specified column of a matrix.\n    The matrix is represented as a list of lists of integers.\n    \"\"\"\n    if not matrix:\n        raise ValueError(\"Input matrix cannot be empty.\")\n\n    num_rows = len(matrix)\n    num_cols = len(matrix[0])\n\n    for row in matrix:\n        if len(row) != num_cols:\n            raise ValueError(\"All rows in the matrix must have the same length.\")\n\n    if not (0 <= n < num_cols):\n        raise IndexError(f\"Column index {n} is out of bounds for a matrix with {num_cols} columns.\")\n\n    max_val = matrix[0][n]\n    for i in range(1, num_rows):\n        if matrix[i][n] > max_val:\n            max_val = matrix[i][n]\n    return max_val\n```"}
{"task_id": "Mbpp/608", "solution": "```python\ndef bell_Number(n):\n    \"\"\"Calculates the nth Bell number for a non-negative integer n.\n    This function uses a dynamic programming approach based on the Bell triangle.\n    \"\"\"\n    try:\n        n_val = int(n)\n    except (TypeError, ValueError):\n        raise ValueError(\"Input 'n' must be an integer.\")\n    \n    if n_val < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    if n_val == 0 or n_val == 1:\n        return 1\n\n    # Initialize the Bell triangle table.\n    bell = [[0 for _ in range(n_val + 1)] for _ in range(n_val + 1)]\n    bell[0][0] = 1\n\n    for i in range(1, n_val + 1):\n        bell[i][0] = bell[i - 1][i - 1]\n        for j in range(1, i + 1):\n            bell[i][j] = bell[i][j - 1] + bell[i - 1][j - 1]\n    \n    return bell[n_val][0]\n```"}
{"task_id": "Mbpp/612", "solution": "```python\nfrom typing import Any, List\n\ndef merge(data: List[List[Any]]) -> List[List[Any]]:\n    \"\"\"\n    Splits a list of two-element sublists into two separate lists.\n\n    The first returned list contains all the first elements from the input sublists,\n    and the second returned list contains all the second elements.\n\n    Args:\n        data: A list of lists, where each sublist must contain exactly two elements.\n\n    Returns:\n        A list containing two lists:\n        - The first inner list contains all first elements.\n        - The second inner list contains all second elements.\n\n    Raises:\n        ValueError: If the input data is not a list of lists, or if any\n                    inner list does not have exactly two elements.\n\n    Example:\n        >>> merge([['x', 'y'], ['a', 'b'], ['m', 'n']])\n        [['x', 'a', 'm'], ['y', 'b', 'n']]\n    \"\"\"\n    if not isinstance(data, list):\n        raise ValueError(\"Input 'data' must be a list.\")\n\n    first_elements: List[Any] = []\n    second_elements: List[Any] = []\n\n    for i, pair in enumerate(data):\n        if not isinstance(pair, list):\n            raise ValueError(f\"Element at index {i} is not a list: {pair}\")\n        if len(pair) != 2:\n            raise ValueError(\n                f\"Inner list at index {i} does not have exactly two elements: {pair}\"\n            )\n        first_elements.append(pair[0])\n        second_elements.append(pair[1])\n\n    return [first_elements, second_elements]\n```"}
{"task_id": "Mbpp/612", "solution": "```python\nfrom typing import Any, List\n\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception raised for invalid input data formats.\"\"\"\n    pass\n\ndef merge(data: List[List[Any]]) -> List[List[Any]]:\n    \"\"\"\n    Transforms a list of two-element sublists into two separate lists.\n    The function validates input for structure and element count.\n    \"\"\"\n    if not isinstance(data, list):\n        raise InvalidInputError(\"Input must be a list.\")\n\n    first_elements: List[Any] = []\n    second_elements: List[Any] = []\n\n    for i, sublist in enumerate(data):\n        if not isinstance(sublist, list):\n            raise InvalidInputError(f\"Element at index {i} is not a list.\")\n        if len(sublist) != 2:\n            raise InvalidInputError(\n                f\"Sublist at index {i} must contain exactly two elements, but found {len(sublist)}.\"\n            )\n        first_elements.append(sublist[0])\n        second_elements.append(sublist[1])\n\n    return [first_elements, second_elements]\n```"}
