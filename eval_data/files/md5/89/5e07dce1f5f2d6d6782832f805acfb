{"task_id": "Mbpp/223", "solution": "def _find_first_occurrence(arr: list[int], low: int, high: int, x: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of x in a sorted array using binary search.\n    It returns -1 if the element is not found.\n    \"\"\"\n    result = -1\n    while low <= high:\n        mid = (low + high) // 2\n        if arr[mid] == x:\n            result = mid\n            high = mid - 1  # Look for an earlier occurrence\n        elif arr[mid] < x:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return result\n\ndef _find_last_occurrence(arr: list[int], low: int, high: int, x: int) -> int:\n    \"\"\"\n    Finds the index of the last occurrence of x in a sorted array using binary search.\n    It returns -1 if the element is not found.\n    \"\"\"\n    result = -1\n    while low <= high:\n        mid = (low + high) // 2\n        if arr[mid] == x:\n            result = mid\n            low = mid + 1  # Look for a later occurrence\n        elif arr[mid] < x:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return result\n\ndef is_majority(arr: list[int], n: int, x: int) -> bool:\n    \"\"\"\n    Checks if an element x is the majority element in a given sorted array.\n    A majority element occurs strictly more than n/2 times.\n    \"\"\"\n    if n == 0:\n        return False\n\n    first_idx = _find_first_occurrence(arr, 0, n - 1, x)\n\n    if first_idx == -1:\n        return False  # Element not found in the array\n\n    last_idx = _find_last_occurrence(arr, 0, n - 1, x)\n    count = last_idx - first_idx + 1\n\n    return count > n / 2"}
{"task_id": "Mbpp/224", "solution": "```python\nclass InvalidInputError(Exception):\n    \"\"\"\n    Custom exception raised for invalid input parameters.\n    It stores a descriptive message about the error.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\ndef count_Set_Bits(number: int) -> int:\n    \"\"\"\n    Counts the number of set bits (1s) in the binary representation of an integer.\n    For negative numbers, it counts bits in their absolute value.\n    \"\"\"\n    if not isinstance(number, int):\n        raise InvalidInputError(\"Input must be an integer.\")\n\n    count = 0\n    # Apply Brian Kernighan's algorithm to the absolute value.\n    temp_num = abs(number)\n    while temp_num > 0:\n        temp_num &= (temp_num - 1)\n        count += 1\n    return count\n```"}
{"task_id": "Mbpp/226", "solution": "```python\ndef odd_values_string(s: str) -> str:\n    \"\"\"\n    Removes characters from a string that have odd index values (0-based).\n    Returns a new string with characters from even index positions only.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n\n    result_chars = []\n    for i in range(len(s)):\n        if i % 2 == 0:  # Select characters at even index positions (0, 2, 4, ...)\n            result_chars.append(s[i])\n    return \"\".join(result_chars)\n```"}
{"task_id": "Mbpp/223", "solution": "def is_majority(arr: list[int], n: int, x: int) -> bool:\n    \"\"\"Determines if x is a majority element in the sorted array arr, occurring strictly more than n/2 times.\"\"\"\n\n    if n == 0:\n        return False\n\n    # Find the first occurrence of x using binary search.\n    low, high = 0, n - 1\n    first_idx = -1\n    while low <= high:\n        mid = (low + high) // 2\n        if arr[mid] == x:\n            first_idx = mid\n            high = mid - 1  # Look for earlier occurrences.\n        elif arr[mid] < x:\n            low = mid + 1\n        else:\n            high = mid - 1\n\n    if first_idx == -1:\n        return False  # Element not found in the array.\n\n    # Find the last occurrence of x using binary search.\n    low, high = 0, n - 1\n    last_idx = -1\n    while low <= high:\n        mid = (low + high) // 2\n        if arr[mid] == x:\n            last_idx = mid\n            low = mid + 1  # Look for later occurrences.\n        elif arr[mid] < x:\n            low = mid + 1\n        else:\n            high = mid - 1\n    \n    count = last_idx - first_idx + 1\n    return count > n / 2"}
