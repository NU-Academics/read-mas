{"task_id": "Mbpp/803", "solution": "```python\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input values.\"\"\"\n    pass\n\nimport math\n\ndef is_perfect_square(number: int) -> bool:\n    \"\"\"Checks if the given non-negative integer is a perfect square.\n    Raises InvalidInputError for negative or non-integer inputs.\n    \"\"\"\n    if not isinstance(number, int):\n        raise InvalidInputError(\"Input must be an integer.\")\n    if number < 0:\n        raise InvalidInputError(\"Input must be a non-negative integer.\")\n\n    if number == 0:\n        return True\n\n    root = math.isqrt(number)\n    return root * root == number\n```"}
{"task_id": "Mbpp/804", "solution": "```python\ndef is_product_even(numbers: list[int]) -> bool:\n    \"\"\"Determines if the product of a list of integers is an even number. Raises TypeError for invalid types or ValueError for an empty list.\"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n    if not numbers:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    for num in numbers:\n        if not isinstance(num, int):\n            raise TypeError(f\"All elements in the list must be integers, but found {type(num).__name__}.\")\n        # The product is even if any number in the list is even (this includes zero).\n        if num % 2 == 0:\n            return True\n    return False  # If no even numbers were found, the product is odd.\n```"}
{"task_id": "Mbpp/804", "solution": "```python\ndef is_product_even(numbers: list[int]) -> bool:\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    Returns True if at least one number is even, False otherwise (including empty lists).\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n\n    if not numbers:\n        return False  # Product of an empty list is 1 (odd).\n\n    for num in numbers:\n        if not isinstance(num, int):\n            raise TypeError(\"List must contain only integers.\")\n        if num % 2 == 0:\n            return True  # Product is even if any number is even.\n    return False\n```"}
{"task_id": "Mbpp/805", "solution": "```python\ndef max_sum_list(list_of_lists: list[list[int | float]]) -> list[int | float]:\n    \"\"\"\n    Identifies the sublist with the highest sum from a given list of lists.\n    Returns the first sublist found with the maximum sum, or an empty list if the input is empty.\n    \"\"\"\n    if not isinstance(list_of_lists, list):\n        raise TypeError(\"Input must be a list of lists.\")\n\n    if not list_of_lists:\n        return []\n\n    max_sum = float('-inf')\n    max_sum_list_result: list[int | float] = []\n\n    for sublist in list_of_lists:\n        if not isinstance(sublist, list):\n            raise TypeError(f\"Inner element '{sublist}' is not a list.\")\n        \n        current_sum = 0.0\n        for item in sublist:\n            if not isinstance(item, (int, float)):\n                raise ValueError(f\"List element '{item}' is not a number.\")\n            current_sum += item\n        \n        if current_sum > max_sum:\n            max_sum = current_sum\n            max_sum_list_result = sublist\n    \n    return max_sum_list_result\n```"}
{"task_id": "Mbpp/806", "solution": "```python\ndef max_run_uppercase(input_string: str) -> int:\n    \"\"\"\n    Calculates the maximum number of consecutive uppercase characters in a string.\n    Raises TypeError if the input is not a string.\n    \"\"\"\n    if not isinstance(input_string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    max_run = 0\n    current_run = 0\n    for char in input_string:\n        if char.isupper():\n            current_run += 1\n        else:\n            current_run = 0\n        max_run = max(max_run, current_run)\n    return max_run\n```"}
{"task_id": "Mbpp/806", "solution": "```python\nclass InvalidInputError(TypeError):\n    \"\"\"Custom exception for invalid input types or values.\n    It inherits from TypeError for consistency with built-in type errors.\"\"\"\n    pass\n\ndef max_run_uppercase(text: str) -> int:\n    \"\"\"\n    Calculates the maximum number of consecutive uppercase characters in the given string.\n    Raises InvalidInputError if the input 'text' is not a string.\n    \"\"\"\n    if not isinstance(text, str):\n        raise InvalidInputError(\"Input must be a string.\")\n\n    max_run = 0\n    current_run = 0\n\n    for char in text:\n        if char.isupper():\n            current_run += 1\n        else:\n            current_run = 0\n        max_run = max(max_run, current_run)\n\n    return max_run\n```"}
