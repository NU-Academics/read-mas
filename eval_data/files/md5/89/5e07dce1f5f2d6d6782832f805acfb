{"task_id": "Mbpp/598", "solution": "def armstrong_number(number: int) -> bool:\n    \"\"\"\n    Checks if a given non-negative integer is an Armstrong number.\n    An Armstrong number is equal to the sum of its digits, each raised to the power of the number of digits.\n    \"\"\"\n    if not isinstance(number, int) or number < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n\n    if number == 0:\n        return True\n\n    # Convert the number to a string to easily count digits and extract them.\n    num_str = str(number)\n    num_digits = len(num_str)\n    \n    sum_of_powers = 0\n    for digit_char in num_str:\n        digit = int(digit_char)\n        sum_of_powers += digit ** num_digits\n        \n    return sum_of_powers == number\n"}
{"task_id": "Mbpp/597", "solution": "def find_kth(list1: list[int], list2: list[int], k: int) -> int:\n    \"\"\"Finds the k-th smallest element from two sorted lists.\n    Raises ValueError if k is out of bounds.\"\"\"\n    m, n = len(list1), len(list2)\n\n    if not (1 <= k <= m + n):\n        raise ValueError(\"k is out of bounds for the combined lists.\")\n\n    # Ensure list1 is the shorter list for binary search optimization\n    if m > n:\n        list1, list2 = list2, list1\n        m, n = n, m\n\n    low, high = max(0, k - n), min(k, m)\n\n    while low <= high:\n        partition1 = (low + high) // 2\n        partition2 = k - partition1\n\n        max_left1 = float('-inf') if partition1 == 0 else list1[partition1 - 1]\n        min_right1 = float('inf') if partition1 == m else list1[partition1]\n\n        max_left2 = float('-inf') if partition2 == 0 else list2[partition2 - 1]\n        min_right2 = float('inf') if partition2 == n else list2[partition2]\n\n        if max_left1 <= min_right2 and max_left2 <= min_right1:\n            return max(max_left1, max_left2)\n        elif max_left1 > min_right2:\n            high = partition1 - 1\n        else:\n            low = partition1 + 1\n    \n    # This part should ideally not be reached if k is valid and lists are sorted\n    raise RuntimeError(\"Algorithm error: k-th element not found.\")\n"}
{"task_id": "Mbpp/593", "solution": "```python\ndef removezero_ip(ip_address: str) -> str:\n    \"\"\"Removes leading zeros from each octet of an IPv4 address string.\n    Raises TypeError for non-string input, ValueError for invalid IPv4 formats or out-of-range octets.\"\"\"\n    if not isinstance(ip_address, str):\n        raise TypeError(\"Input must be a string.\")\n\n    octets = ip_address.split('.')\n    if len(octets) != 4:\n        raise ValueError(\"Invalid IPv4 address format: must have 4 octets.\")\n\n    formatted_octets = []\n    for octet_str in octets:\n        try:\n            octet_int = int(octet_str)\n            if not (0 <= octet_int <= 255):\n                raise ValueError(f\"Octet '{octet_str}' is out of range (0-255).\")\n            formatted_octets.append(str(octet_int))\n        except ValueError:\n            raise ValueError(f\"Invalid octet '{octet_str}' in IP address.\")\n\n    return \".\".join(formatted_octets)\n```\n"}
{"task_id": "Mbpp/594", "solution": "```python\nfrom typing import List, Optional\n\nclass ListUtils:\n    \"\"\"Utility class for list processing, specifically finding numbers.\n    It provides static methods to locate the first even or odd number.\"\"\"\n\n    @staticmethod\n    def find_first_even(numbers: List[int]) -> Optional[int]:\n        \"\"\"Finds the first even number in a list.\n        Raises TypeError if input is not a list, ValueError if elements are not integers.\"\"\"\n        if not isinstance(numbers, list):\n            raise TypeError(\"Input must be a list.\")\n        for num in numbers:\n            if not isinstance(num, int):\n                raise ValueError(\"List elements must be integers.\")\n            if num % 2 == 0:\n                return num\n        return None\n\n    @staticmethod\n    def find_first_odd(numbers: List[int]) -> Optional[int]:\n        \"\"\"Finds the first odd number in a list.\n        Raises TypeError if input is not a list, ValueError if elements are not integers.\"\"\"\n        if not isinstance(numbers, list):\n            raise TypeError(\"Input must be a list.\")\n        for num in numbers:\n            if not isinstance(num, int):\n                raise ValueError(\"List elements must be integers.\")\n            if num % 2 != 0:\n                return num\n        return None\n\ndef diff_even_odd(numbers: List[int]) -> int:\n    \"\"\"Calculates the absolute difference between the first even and first odd number in a list.\n    Raises TypeError or ValueError for invalid input or if required numbers are not found.\"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input 'numbers' must be a list.\")\n    \n    first_even = ListUtils.find_first_even(numbers)\n    first_odd = ListUtils.find_first_odd(numbers)\n\n    if first_even is None:\n        raise ValueError(\"No even number found in the list.\")\n    if first_odd is None:\n        raise ValueError(\"No odd number found in the list.\")\n\n    return abs(first_even - first_odd)\n```"}
{"task_id": "Mbpp/594", "solution": "```python\ndef diff_even_odd(numbers: list[int]) -> int:\n    \"\"\"\n    Finds the absolute difference between the first even and first odd number in a list.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in numbers:\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n        \n        # Optimization: if both are found, no need to continue iterating\n        if first_even is not None and first_odd is not None:\n            break\n\n    return abs(first_even - first_odd)\n```\n"}
{"task_id": "Mbpp/599", "solution": "```python\ndef sum_average(n: int) -> tuple[int, float]:\n    \"\"\"Calculates the sum and average of the first 'n' natural numbers.\n    Raises TypeError if n is not an integer, ValueError if n is not positive.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    # Calculate sum using the direct formula n * (n + 1) / 2.\n    total_sum = n * (n + 1) // 2\n\n    # Calculate average by dividing the sum by n.\n    average = total_sum / n\n\n    return (total_sum, average)\n```"}
