{"task_id": "Mbpp/259", "solution": "```python\ndef maximize_elements(\n    tuple1: tuple[tuple[int | float, ...], ...],\n    tuple2: tuple[tuple[int | float, ...], ...]\n) -> tuple[tuple[int | float, ...], ...]:\n    \"\"\"\n    Compares corresponding elements from two tuples of tuples, returning a new tuple of tuples\n    with the maximum values. Validates input types and dimensions, raising TypeErrors or ValueErrors as needed.\n    \"\"\"\n    if not isinstance(tuple1, tuple) or not isinstance(tuple2, tuple):\n        raise TypeError(\"Both inputs must be tuples.\")\n    if not all(isinstance(t, tuple) for t in tuple1) or not all(isinstance(t, tuple) for t in tuple2):\n        raise TypeError(\"Both inputs must be tuples of tuples.\")\n\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Input tuples must have the same number of inner tuples.\")\n\n    result_tuples = []\n    for i in range(len(tuple1)):\n        inner_tuple1 = tuple1[i]\n        inner_tuple2 = tuple2[i]\n\n        if len(inner_tuple1) != len(inner_tuple2):\n            raise ValueError(f\"Inner tuples at index {i} have different lengths: {len(inner_tuple1)} vs {len(inner_tuple2)}.\")\n\n        max_inner_tuple = []\n        for j in range(len(inner_tuple1)):\n            try:\n                max_inner_tuple.append(max(inner_tuple1[j], inner_tuple2[j]))\n            except TypeError as e:\n                raise TypeError(f\"Elements at index ({i}, {j}) are not comparable: {inner_tuple1[j]}, {inner_tuple2[j]}. Original error: {e}\")\n\n        result_tuples.append(tuple(max_inner_tuple))\n\n    return tuple(result_tuples)\n```\n"}
{"task_id": "Mbpp/259", "solution": "```python\ndef maximize_elements(\n    tuple1: tuple[tuple[int, ...], ...],\n    tuple2: tuple[tuple[int, ...], ...]\n) -> tuple[tuple[int, ...], ...]:\n    \"\"\"\n    Compares corresponding nested tuple elements and returns a new tuple of tuples with maximized values.\n    Raises ValueError if input structures (outer or inner tuple lengths) do not match.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Input tuples must have the same number of inner tuples.\")\n\n    result = []\n    for i in range(len(tuple1)):\n        inner_tuple1 = tuple1[i]\n        inner_tuple2 = tuple2[i]\n\n        if len(inner_tuple1) != len(inner_tuple2):\n            raise ValueError(f\"Corresponding inner tuples at index {i} must have the same length.\")\n\n        maximized_inner_tuple = tuple(max(e1, e2) for e1, e2 in zip(inner_tuple1, inner_tuple2))\n        result.append(maximized_inner_tuple)\n\n    return tuple(result)\n```"}
{"task_id": "Mbpp/235", "solution": "```python\ndef even_bit_set_number(number: int) -> int:\n    \"\"\"Sets all even-indexed bits (0, 2, 4, ...) of the given non-negative integer to 1.\n    If the input is negative, a ValueError is raised as per specification.\n    \"\"\"\n    if number < 0:\n        raise ValueError(\"Input number must be non-negative.\")\n\n    # Special case for 0, where only bit 0 is set, resulting in 1.\n    if number == 0:\n        return 1\n\n    # Determine the number of bits required to represent the integer.\n    # This helps construct a mask that covers the significant bits of the input.\n    num_bits = number.bit_length()\n\n    mask = 0\n    # Construct a mask by setting 1s at all even bit positions up to num_bits.\n    for i in range(0, num_bits, 2):\n        mask |= (1 << i)\n\n    # Apply the mask to the original number using a bitwise OR operation.\n    return number | mask\n```"}
{"task_id": "Mbpp/261", "solution": "class TupleLengthMismatchError(ValueError):\n    \"\"\"Exception raised when two tuples have different lengths for an element-wise operation.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass DivisionByZeroError(ValueError):\n    \"\"\"Exception raised when an attempt is made to divide by zero in a tuple operation, including the index.\"\"\"\n    def __init__(self, message: str, index: int):\n        super().__init__(message)\n        self.index = index\n\ndef division_elements(tuple1: tuple[int|float, ...], tuple2: tuple[int|float, ...]) -> tuple[float, ...]:\n    \"\"\"\n    Performs element-wise division of two tuples, validating inputs and handling errors.\n    Returns a new tuple with the float results of the division.\n    \"\"\"\n    if not isinstance(tuple1, tuple) or not isinstance(tuple2, tuple):\n        raise TypeError(\"Both inputs must be tuples.\")\n\n    # Validate all elements in both tuples are numeric.\n    for element in tuple1 + tuple2:\n        if not isinstance(element, (int, float)):\n            raise TypeError(\"All tuple elements must be numeric (int or float).\")\n\n    if len(tuple1) != len(tuple2):\n        raise TupleLengthMismatchError(\"Input tuples must have the same length for element-wise division.\")\n\n    results = []\n    for i in range(len(tuple1)):\n        if tuple2[i] == 0:\n            raise DivisionByZeroError(f\"Division by zero at index {i}.\", i)\n        division_result = tuple1[i] / tuple2[i]\n        if division_result.is_integer():\n            results.append(int(division_result))\n        else:\n            results.append(division_result)\n\n    return tuple(results)"}
{"task_id": "Mbpp/261", "solution": "```python\nclass InvalidTupleLengthError(ValueError):\n    \"\"\"Exception raised for errors in the input tuple lengths.\"\"\"\n    def __init__(self, message=\"Input tuples must have the same length.\"):\n        self.message = message\n        super().__init__(self.message)\n\nclass DivisionByZeroError(ValueError):\n    \"\"\"Exception raised for division by zero in tuple elements.\"\"\"\n    def __init__(self, message=\"Cannot divide by zero.\"):\n        self.message = message\n        super().__init__(self.message)\n\ndef division_elements(tuple1: tuple[int | float, ...], tuple2: tuple[int | float, ...]) -> tuple[int | float, ...]:\n    \"\"\"\n    Performs element-wise division of two numerical tuples.\n    Raises InvalidTupleLengthError if tuples have different lengths or DivisionByZeroError if a denominator is zero.\n    \"\"\"\n    if len(tuple1) != len(tuple2):\n        raise InvalidTupleLengthError(\"Input tuples must have the same length for element-wise division.\")\n\n    results = []\n    for i in range(len(tuple1)):\n        if tuple2[i] == 0:\n            raise DivisionByZeroError(f\"Cannot divide by zero at index {i}.\")\n        \n        result = tuple1[i] / tuple2[i]\n        # Convert to int if the result is a whole number, otherwise keep as float.\n        if result == int(result):\n            results.append(int(result))\n        else:\n            results.append(result)\n    \n    return tuple(results)\n```\n"}
{"task_id": "Mbpp/262", "solution": "```python\ndef split_two_parts(input_list: list, L: int) -> tuple[list, list]:\n    \"\"\"Splits a list into two parts based on a specified length L for the first part.\n    Raises TypeError for invalid input types, ValueError if L is negative.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"input_list must be a list\")\n    if not isinstance(L, int):\n        raise TypeError(\"L must be an integer\")\n    if L < 0:\n        raise ValueError(\"L cannot be negative\")\n\n    first_part = input_list[:L]\n    second_part = input_list[L:]\n    return (first_part, second_part)\n```"}
{"task_id": "Mbpp/262", "solution": "```python\nclass InvalidSplitLengthError(Exception):\n    \"\"\"Custom exception for invalid split length L. Stores a descriptive error message.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\ndef split_two_parts(input_list: list, L: int) -> tuple[list, list]:\n    \"\"\"\n    Splits a list into two parts at a specified length L.\n    Raises InvalidSplitLengthError if L is negative or exceeds the list's length.\n    \"\"\"\n    if not isinstance(L, int) or L < 0 or L > len(input_list):\n        raise InvalidSplitLengthError(\n            f\"Invalid split length L: {L}. L must be a non-negative integer \"\n            f\"and not exceed the list length ({len(input_list)}).\"\n        )\n\n    first_part = input_list[:L]\n    second_part = input_list[L:]\n    return (first_part, second_part)\n```"}
