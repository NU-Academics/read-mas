{"task_id": "Mbpp/61", "solution": "```python\ndef calculate_digit_sum(s: str) -> int:\n    \"\"\"Calculates the sum of digits in a string.\n    Raises ValueError if the string contains non-digit characters.\"\"\"\n    total_sum = 0\n    for char in s:\n        total_sum += int(char)\n    return total_sum\n\ndef count_Substrings(input_string: str) -> int:\n    \"\"\"Counts substrings where the sum of digits equals their length.\n    Propagates TypeError for non-string input and ValueError for non-digit characters.\"\"\"\n    if not isinstance(input_string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    count = 0\n    n = len(input_string)\n\n    for i in range(n):\n        for j in range(i, n):\n            substring = input_string[i : j + 1]\n            substring_length = len(substring)\n            \n            try:\n                sum_of_digits = calculate_digit_sum(substring)\n            except ValueError:\n                raise ValueError(f\"Substring '{substring}' contains non-digit characters.\")\n\n            if sum_of_digits == substring_length:\n                count += 1\n    return count\n```"}
{"task_id": "Mbpp/62", "solution": "```python\nfrom typing import Union\n\nclass EmptyListError(ValueError):\n    \"\"\"Exception raised when an operation is performed on an empty list.\"\"\"\n    def __init__(self, message=\"Input list cannot be empty.\"):\n        self.message = message\n        super().__init__(self.message)\n\nclass InvalidInputError(TypeError):\n    \"\"\"Exception raised when a list contains non-numeric elements.\"\"\"\n    def __init__(self, message=\"Input list must contain only numbers (int or float).\"):\n        self.message = message\n        super().__init__(self.message)\n\ndef smallest_num(numbers: list) -> Union[int, float]:\n    \"\"\"\n    Finds the smallest number in a list of integers or floats.\n    Raises EmptyListError or InvalidInputError for invalid inputs.\n    \"\"\"\n    if not numbers:\n        raise EmptyListError()\n\n    min_value: Union[int, float, None] = None\n\n    for item in numbers:\n        if not isinstance(item, (int, float)):\n            raise InvalidInputError(f\"Invalid element type found: {type(item)}. Expected int or float.\")\n\n        if min_value is None or item < min_value:\n            min_value = item\n\n    # This cast is safe because EmptyListError is raised above if numbers is empty,\n    # and InvalidInputError is raised if any element is non-numeric.\n    return min_value # type: ignore\n```"}
{"task_id": "Mbpp/62", "solution": "```python\nfrom typing import List, Union\n\nclass EmptyListError(Exception):\n    \"\"\"Custom exception raised when an input list is empty.\n    It provides a default or custom message for the error.\"\"\"\n    def __init__(self, message=\"Input list cannot be empty.\"):\n        self.message = message\n        super().__init__(self.message)\n\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception raised when an input list contains non-numeric elements.\n    It provides a default or custom message for the error.\"\"\"\n    def __init__(self, message=\"List must contain only numbers.\"):\n        self.message = message\n        super().__init__(self.message)\n\ndef smallest_num(data_list: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"Finds the smallest number in a list of numbers.\n    It iterates through the list, validating types and tracking the minimum value.\"\"\"\n    if not data_list:\n        raise EmptyListError()\n\n    smallest = None\n    for item in data_list:\n        if not isinstance(item, (int, float)):\n            raise InvalidInputError(f\"List must contain only numbers, found '{type(item).__name__}'.\")\n        \n        if smallest is None or item < smallest:\n            smallest = item\n    \n    # This final check for 'smallest is None' is theoretically unreachable given prior checks.\n    # It ensures a value is returned if the list passed all initial validations.\n    if smallest is None: \n        raise EmptyListError(\"No valid numbers found in the list after filtering.\")\n\n    return smallest\n```\n"}
