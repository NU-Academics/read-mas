{"task_id": "Mbpp/733", "solution": "```python\ndef find_first_occurrence(array: list[int], target: int) -> int:\n    \"\"\"Finds the index of the first occurrence of a target in a sorted array using a binary search variant.\n    Returns the lowest index if found, otherwise -1.\"\"\"\n    low = 0\n    high = len(array) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == target:\n            result = mid\n            high = mid - 1  # Search in the left half for an earlier occurrence.\n        elif array[mid] < target:\n            low = mid + 1\n        else:  # array[mid] > target\n            high = mid - 1\n    return result\n```"}
{"task_id": "Mbpp/734", "solution": "```python\nfrom typing import List\n\n\ndef sum_Of_Subarray_Prod(numbers: List[int]) -> int:\n    \"\"\"\n    Calculates the sum of products of all possible sublists of a given list.\n    Example: [1, 2, 3] -> (1) + (2) + (3) + (1*2) + (2*3) + (1*2*3) = 20.\n    \"\"\"\n\n    def _product_of_list(sublist: List[int]) -> int:\n        \"\"\"Calculates the product of all elements in a list. Returns 1 for an empty list.\"\"\"\n        product = 1\n        for num in sublist:\n            product *= num\n        return product\n\n    def _get_all_sublists(lst: List[int]) -> List[List[int]]:\n        \"\"\"Generates all contiguous sublists of the given list.\"\"\"\n        sublists = []\n        n = len(lst)\n        for i in range(n):\n            for j in range(i, n):\n                sublists.append(lst[i : j + 1])\n        return sublists\n\n    if not numbers:\n        return 0\n\n    all_sublists = _get_all_sublists(numbers)\n    total_sum = 0\n    for sublist in all_sublists:\n        total_sum += _product_of_list(sublist)\n    return total_sum\n```\n"}
{"task_id": "Mbpp/734", "solution": "```python\nfrom typing import List\n\ndef sum_Of_Subarray_Prod(numbers: List[int]) -> int:\n    \"\"\"Calculates the sum of products of all contiguous sublists of a given list of integers.\n    Performs input validation for type and content, returning 0 for an empty list.\"\"\"\n\n    def _product_helper(sublist_numbers: List[int]) -> int:\n        \"\"\"Calculates the product of all elements in a list, returning 1 for an empty list.\"\"\"\n        if not sublist_numbers:\n            return 1\n        res = 1\n        for num in sublist_numbers:\n            res *= num\n        return res\n\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n    if not all(isinstance(n, int) for n in numbers):\n        raise TypeError(\"All elements in the list must be integers.\")\n\n    if not numbers:\n        return 0\n\n    total_sum = 0\n    n = len(numbers)\n\n    for i in range(n):\n        for j in range(i, n):\n            sublist = numbers[i : j + 1]\n            total_sum += _product_helper(sublist)\n\n    return total_sum\n```"}
{"task_id": "Mbpp/736", "solution": "```python\nfrom typing import Any, List\n\ndef left_insertion(sorted_list: List[Any], value: Any) -> int:\n    \"\"\"\n    Locates the left insertion point for a specified value in a sorted list.\n    This function returns an index such that all elements to its left are less than 'value'.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low\n```"}
{"task_id": "Mbpp/736", "solution": "```python\ndef left_insertion(sorted_list: list[int], value: int) -> int:\n    \"\"\"\n    Locates the left insertion point for a specified value in a sorted list.\n    Returns the index where 'value' should be inserted to maintain sorted order.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low\n```"}
{"task_id": "Mbpp/735", "solution": "```python\ndef toggle_middle_bits(n: int) -> int:\n    \"\"\"Toggles all bits of the number except the most significant bit (MSB) and the least significant bit (LSB).\n    Raises ValueError if input n is negative.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n\n    length = n.bit_length()\n\n    if length <= 2:\n        return n\n\n    middle_bits_mask = ((1 << (length - 2)) - 1) << 1\n\n    return n ^ middle_bits_mask\n```"}
{"task_id": "Mbpp/735", "solution": "```python\ndef toggle_middle_bits(number: int) -> int:\n    \"\"\"Toggles all bits of a non-negative integer except its most significant bit (MSB) and least significant bit (LSB).\n    Returns the original number if it has 0, 1, or 2 bits.\"\"\"\n\n    if not isinstance(number, int) or number < 0:\n        raise ValueError(\"Input 'number' must be a non-negative integer.\")\n\n    bit_length = number.bit_length()\n\n    if bit_length <= 2:\n        return number\n\n    # Construct a mask with 1s only for the middle bits.\n    # This involves setting all bits to 1, then unsetting the MSB and LSB.\n    all_ones_mask = (1 << bit_length) - 1\n    msb_mask = (1 << (bit_length - 1))\n    lsb_mask = 1\n\n    middle_bits_mask = all_ones_mask ^ msb_mask ^ lsb_mask\n\n    # XOR with the mask to toggle only the middle bits.\n    return number ^ middle_bits_mask\n```"}
{"task_id": "Mbpp/739", "solution": "```python\nimport math\n\ndef find_index(n: int) -> int:\n    \"\"\"\n    Finds the index (k) of the smallest triangular number (T_k) with 'n' digits.\n    Input 'n' must be a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    min_value_n_digits = 10**(n - 1)\n\n    # Solve k * (k + 1) / 2 >= min_value_n_digits for k.\n    # This leads to k^2 + k - 2 * min_value_n_digits >= 0.\n    discriminant = 1 + 8 * min_value_n_digits\n    k_float = (-1 + math.sqrt(discriminant)) / 2\n    \n    return math.ceil(k_float)\n```"}
