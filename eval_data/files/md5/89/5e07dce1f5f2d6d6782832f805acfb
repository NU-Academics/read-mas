{"task_id": "Mbpp/271", "solution": "```python\ndef even_Power_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the first n even natural numbers raised to the fifth power.\n    Raises ValueError if n is not a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    total_sum = 0\n    # Iterate from 1 to n, calculating (2*i)^5 for each and adding to the sum.\n    for i in range(1, n + 1):\n        even_number = 2 * i\n        total_sum += even_number ** 5\n    return total_sum\n```"}
{"task_id": "Mbpp/270", "solution": "```python\ndef sum_even_and_even_index(numbers: list[int]) -> int:\n    \"\"\"Calculates the sum of even numbers found at even 0-based indices in a list.\"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n\n    total_sum = 0\n    for index, value in enumerate(numbers):\n        if not isinstance(value, int):\n            try:\n                value = int(value)\n            except (TypeError, ValueError) as e:\n                raise ValueError(f\"List element at index {index} is not an integer: {value}\") from e\n\n        if value % 2 == 0 and index % 2 == 0:\n            total_sum += value\n    return total_sum\n```"}
{"task_id": "Mbpp/272", "solution": "```python\ndef rear_extract(data: list[tuple]) -> list[any]:\n    \"\"\"\n    Extracts the last element from each tuple in a list.\n    Raises TypeError for invalid input types or IndexError for empty tuples.\n    \"\"\"\n    if not isinstance(data, list):\n        raise TypeError(\"Input must be a list.\")\n\n    result = []\n    for item in data:\n        if not isinstance(item, tuple):\n            raise TypeError(\"All elements in the list must be tuples.\")\n        if not item:\n            raise IndexError(\"Tuples cannot be empty.\")\n        result.append(item[-1])\n    return result\n```"}
{"task_id": "Mbpp/271", "solution": "```python\ndef even_Power_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the first n even natural numbers, each raised to the fifth power.\n    Returns 0 if n is non-positive, as the loop for summation will not execute.\n    \"\"\"\n    total_sum = 0\n    for i in range(1, n + 1):\n        current_even_number = 2 * i\n        total_sum += current_even_number ** 5\n    return total_sum\n```"}
{"task_id": "Mbpp/270", "solution": "```python\nfrom typing import List\n\ndef sum_even_and_even_index(numbers: List[int]) -> int:\n    \"\"\"\n    Calculates the sum of even numbers located at even positions (0-indexed) within a list.\n\n    Args:\n        numbers: A list of integers.\n\n    Returns:\n        The sum of even numbers found at even positions.\n\n    Raises:\n        ValueError: If the input is not a list or contains non-integer elements.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise ValueError(\"Input must be a list.\")\n    if not all(isinstance(n, int) for n in numbers):\n        raise ValueError(\"All elements in the list must be integers.\")\n\n    total_sum = 0\n    for i, number in enumerate(numbers):\n        if i % 2 == 0 and number % 2 == 0:\n            total_sum += number\n    return total_sum\n```"}
{"task_id": "Mbpp/272", "solution": "```python\nfrom typing import List, Tuple, Any\n\ndef rear_extract(data: List[Tuple[Any, ...]]) -> List[Any]:\n    \"\"\"\n    Extracts the last element from each tuple within a list of tuples.\n    Raises TypeError or IndexError for invalid inputs.\n    \"\"\"\n    if not isinstance(data, list):\n        raise TypeError(\"Input must be a list.\")\n    \n    for i, item in enumerate(data):\n        if not isinstance(item, tuple):\n            raise TypeError(f\"Element at index {i} is not a tuple.\")\n        if not item: # Checks if the tuple is empty\n            raise IndexError(f\"Tuple at index {i} is empty.\")\n            \n    return [item[-1] for item in data]\n```"}
{"task_id": "Mbpp/274", "solution": "```python\ndef even_binomial_Coeff_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of even-indexed binomial coefficients for a given positive integer n.\n    This sum is mathematically equivalent to 2^(n-1).\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n    return pow(2, n - 1)\n```"}
{"task_id": "Mbpp/273", "solution": "```python\ndef subtract_elements(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"Subtracts elements of the second tuple from the first at corresponding indices.\n    Raises ValueError for length mismatch or TypeError for non-numeric or non-tuple inputs.\n    \"\"\"\n    if not isinstance(tuple1, tuple) or not isinstance(tuple2, tuple):\n        raise TypeError(\"Both inputs must be tuples.\")\n\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Input tuples must have the same length.\")\n\n    result = []\n    for i in range(len(tuple1)):\n        try:\n            result.append(tuple1[i] - tuple2[i])\n        except TypeError:\n            raise TypeError(\"Tuple elements must be numeric (int or float).\")\n\n    return tuple(result)\n```"}
{"task_id": "Mbpp/274", "solution": "```python\ndef even_binomial_Coeff_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of even-indexed binomial coefficients for a positive integer n.\n    It applies the identity that this sum is equal to 2^(n-1) for n > 0.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input n must be a positive integer.\")\n    return 2**(n - 1)\n```"}
{"task_id": "Mbpp/273", "solution": "```python\nclass TupleMathError(Exception):\n    \"\"\"Base exception for errors in tuple operations.\n    It provides a common base for specific tuple-related errors.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass InvalidTupleLengthError(TupleMathError):\n    \"\"\"Raised when input tuples have different lengths for element-wise operations.\n    The default message indicates a length mismatch requirement.\n    \"\"\"\n    def __init__(self, message: str = \"Input tuples must have the same length.\"):\n        super().__init__(message)\n\nclass NonNumericTupleElementError(TupleMathError):\n    \"\"\"Raised when a tuple contains non-numeric elements for mathematical operations.\n    It ensures all elements are integers or floats.\n    \"\"\"\n    def __init__(self, message: str = \"All tuple elements must be numeric (int or float).\"):\n        super().__init__(message)\n\ndef subtract_elements(tuple1: tuple[int | float, ...], tuple2: tuple[int | float, ...]) -> tuple[int | float, ...]:\n    \"\"\"\n    Subtracts elements of the second tuple from the first tuple element-wise.\n    Performs validation for input types, lengths, and element types.\n    \"\"\"\n    if not isinstance(tuple1, tuple) or not isinstance(tuple2, tuple):\n        raise TypeError(\"Both inputs must be tuples.\")\n\n    if len(tuple1) != len(tuple2):\n        raise InvalidTupleLengthError(\n            f\"Tuples must have the same length. Got {len(tuple1)} and {len(tuple2)}.\"\n        )\n\n    result_elements = []\n    for i in range(len(tuple1)):\n        val1 = tuple1[i]\n        val2 = tuple2[i]\n\n        if not isinstance(val1, (int, float)) or not isinstance(val2, (int, float)):\n            raise NonNumericTupleElementError(\n                f\"All elements must be numeric. Found non-numeric at index {i}.\"\n            )\n        result_elements.append(val1 - val2)\n\n    return tuple(result_elements)\n```"}
{"task_id": "Mbpp/276", "solution": "```python\nimport math\n\ndef volume_cylinder(radius: float, height: float) -> float:\n    \"\"\"Calculates the volume of a cylinder given its radius and height.\n    Raises ValueError if radius or height are not positive numbers.\n    \"\"\"\n    if not isinstance(radius, (int, float)) or radius <= 0:\n        raise ValueError(\"Radius must be a positive number.\")\n    if not isinstance(height, (int, float)) or height <= 0:\n        raise ValueError(\"Height must be a positive number.\")\n\n    volume = math.pi * (radius ** 2) * height\n    return volume\n```"}
{"task_id": "Mbpp/276", "solution": "```python\nimport math\n\ndef volume_cylinder(radius: float, height: float) -> float:\n    \"\"\"\n    Calculates the volume of a cylinder given its radius and height.\n    Raises ValueError if radius or height are not positive numbers.\n    \"\"\"\n    if not isinstance(radius, (int, float)) or radius <= 0:\n        raise ValueError(\"Radius must be a positive number.\")\n    if not isinstance(height, (int, float)) or height <= 0:\n        raise ValueError(\"Height must be a positive number.\")\n\n    return math.pi * (radius ** 2) * height\n```"}
