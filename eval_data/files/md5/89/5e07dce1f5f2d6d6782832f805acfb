{"task_id": "Mbpp/111", "solution": "```python\nfrom typing import Any, List, Set\n\ndef common_in_nested_lists(nested_list: List[List[Any]]) -> Set[Any]:\n    \"\"\"\n    Identifies elements common to all sublists within a nested list.\n    Returns an empty set if the input is empty or no common elements exist.\n    \"\"\"\n    if not nested_list:\n        return set()\n\n    # Initialize with elements from the first sublist.\n    common_elements = set(nested_list[0])\n\n    # Intersect with subsequent sublists to find elements present in all.\n    for sublist in nested_list[1:]:\n        common_elements.intersection_update(sublist)\n\n    return common_elements\n```"}
{"task_id": "Mbpp/109", "solution": "```python\nclass BinaryConverter:\n    \"\"\"Utility for converting binary strings to decimal and checking for oddness. It can also validate if a string is a valid binary.\"\"\"\n    def is_odd_binary(self, binary_string: str) -> bool:\n        \"\"\"Determines if the decimal equivalent of a binary string is odd. It efficiently checks the least significant bit for '1'.\"\"\"\n        if not self._is_valid_binary(binary_string):\n            raise ValueError(\"Input must be a valid binary string.\")\n        if not binary_string:\n            return False\n        return binary_string[-1] == '1'\n\n    def binary_to_decimal(self, binary_string: str) -> int:\n        \"\"\"Converts a valid binary string to its decimal integer equivalent.\"\"\"\n        if not self._is_valid_binary(binary_string):\n            raise ValueError(\"Input must be a valid binary string.\")\n        if not binary_string:\n            return 0\n        return int(binary_string, 2)\n\n    def _is_valid_binary(self, binary_string: str) -> bool:\n        \"\"\"Internal helper to check if a string contains only '0' and '1' characters.\"\"\"\n        return isinstance(binary_string, str) and all(c in '01' for c in binary_string)\n\nclass StringRotator:\n    \"\"\"Provides utility methods for performing circular right rotations on strings.\"\"\"\n    def rotate_right(self, s: str) -> str:\n        \"\"\"Rotates the input string one position to the right circularly.\"\"\"\n        if not s:\n            return s\n        return s[-1] + s[:-1]\n\nclass OddEquivalentCalculator:\n    \"\"\"Orchestrates the process of counting odd decimal equivalents for rotated binary strings. It validates inputs and delegates tasks.\"\"\"\n    def __init__(self, string_rotator: StringRotator, binary_converter: BinaryConverter):\n        \"\"\"Initializes the calculator with instances of StringRotator and BinaryConverter for dependency injection.\"\"\"\n        self._string_rotator = string_rotator\n        self._binary_converter = binary_converter\n\n    def calculate_odd_equivalent(self, binary_string: str, num_rotations: int) -> int:\n        \"\"\"Calculates and returns the count of odd decimal equivalents after rotating the binary string a specified number of times.\"\"\"\n        self._validate_inputs(binary_string, num_rotations)\n\n        odd_count = 0\n        current_binary_string = binary_string\n\n        for _ in range(num_rotations):\n            if self._binary_converter.is_odd_binary(current_binary_string):\n                odd_count += 1\n            current_binary_string = self._string_rotator.rotate_right(current_binary_string)\n\n        return odd_count\n\n    def _validate_inputs(self, binary_string: str, num_rotations: int) -> None:\n        \"\"\"Validates the input binary_string for '0' and '1' characters and num_rotations as a non-negative integer. Raises ValueError on invalid inputs.\"\"\"\n        if not isinstance(binary_string, str) or not all(c in '01' for c in binary_string):\n            raise ValueError(\"binary_string must be a string containing only '0' and '1'.\")\n        if not isinstance(num_rotations, int) or num_rotations < 0:\n            raise ValueError(\"num_rotations must be a non-negative integer.\")\n\ndef odd_Equivalent(binary_string: str, num_rotations: int) -> int:\n    \"\"\"Calculates the number of odd decimal equivalents when rotating a binary string. It instantiates the calculator and returns the result.\"\"\"\n    calculator = OddEquivalentCalculator(StringRotator(), BinaryConverter())\n    return calculator.calculate_odd_equivalent(binary_string, num_rotations)\n```"}
{"task_id": "Mbpp/116", "solution": "```python\ndef tuple_to_int(input_tuple: tuple[int, ...]) -> int:\n    \"\"\"\n    Converts a tuple of positive integers into a single integer.\n    Returns 0 for an empty tuple.\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise ValueError(\"Input must be a tuple\")\n\n    if not input_tuple:\n        return 0\n\n    str_elements = []\n    for element in input_tuple:\n        if not isinstance(element, int):\n            raise ValueError(\"Tuple elements must be integers\")\n        if element < 0:\n            raise ValueError(\"Tuple elements must be positive integers\")\n        str_elements.append(str(element))\n\n    return int(\"\".join(str_elements))\n```"}
