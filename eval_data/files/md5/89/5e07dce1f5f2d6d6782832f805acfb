{"task_id": "Mbpp/569", "solution": "```python\ndef sort_sublists(list_of_lists: list[list[str]]) -> list[list[str]]:\n    \"\"\"Sorts each sublist of strings in a given list of lists alphabetically.\n    Returns a new list of lists with each inner list sorted, leaving the original unchanged.\"\"\"\n    if not isinstance(list_of_lists, list):\n        raise TypeError(\"Input must be a list.\")\n\n    sorted_outer_list = []\n    for sublist in list_of_lists:\n        if not isinstance(sublist, list):\n            raise TypeError(\"All elements of the outer list must be lists.\")\n        for item in sublist:\n            if not isinstance(item, str):\n                raise TypeError(\"All elements within sublists must be strings.\")\n        sorted_outer_list.append(sorted(sublist))\n    return sorted_outer_list\n```"}
{"task_id": "Mbpp/572", "solution": "```python\nfrom collections import Counter\nfrom typing import List, Union\n\ndef two_unique_nums(numbers: List[Union[int, float]]) -> List[Union[int, float]]:\n    \"\"\"\n    Identifies and returns numbers that appear exactly once in the input list.\n    This function processes lists efficiently using a counter.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n\n    counts = Counter(numbers)\n    unique_numbers = [num for num in numbers if counts[num] == 1]\n    return unique_numbers\n```"}
{"task_id": "Mbpp/569", "solution": "```python\nfrom typing import List\n\ndef sort_sublists(list_of_lists: List[List[str]]) -> List[List[str]]:\n    \"\"\"\n    Sorts each sublist of strings in a given list of lists alphabetically, returning a new list.\n    Raises TypeError for incorrect list structure or ValueError for non-string sublist elements.\n    \"\"\"\n    if not isinstance(list_of_lists, list):\n        raise TypeError(\"Input must be a list.\")\n    \n    sorted_result = []\n    for sublist in list_of_lists:\n        if not isinstance(sublist, list):\n            raise TypeError(\"All elements in the input list must be lists.\")\n        \n        # Validate all elements in sublist are strings.\n        if not all(isinstance(item, str) for item in sublist):\n            raise ValueError(\"All elements within sublists must be strings.\")\n        \n        sorted_result.append(sorted(sublist))\n    return sorted_result\n```"}
{"task_id": "Mbpp/572", "solution": "```python\nfrom collections import Counter\n\ndef two_unique_nums(numbers: list[int]) -> list[int]:\n    \"\"\"Identifies and returns numbers that appear exactly once in the input list, preserving order.\n    Raises TypeError or ValueError for invalid input types.\"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n    \n    for num in numbers:\n        if not isinstance(num, int):\n            raise ValueError(\"All elements in the list must be integers.\")\n\n    counts = Counter(numbers)\n    unique_numbers = [num for num in numbers if counts[num] == 1]\n    return unique_numbers\n```"}
{"task_id": "Mbpp/573", "solution": "```python\ndef unique_product(numbers: list) -> [int, float]:\n    \"\"\"\n    Calculates the product of unique numbers in the provided list.\n\n    Raises TypeError if input is not a list or contains non-numeric types.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n\n    for item in numbers:\n        if not isinstance(item, (int, float)):\n            raise TypeError(\"List must contain only numbers (int or float).\")\n\n    if not numbers:\n        return 1\n\n    unique_nums = set(numbers)\n    product_result = 1\n    for num in unique_nums:\n        product_result *= num\n    return product_result\n```"}
{"task_id": "Mbpp/576", "solution": "```python\ndef is_Sub_Array(main_list: list, sub_list: list) -> bool:\n    \"\"\"\n    Checks if `sub_list` is a contiguous sublist of `main_list`.\n    Returns `True` if found, `False` otherwise.\n    \"\"\"\n    n = len(main_list)\n    m = len(sub_list)\n\n    if m == 0:\n        return True\n\n    if m > n:\n        return False\n\n    for i in range(n - m + 1):\n        if main_list[i:i+m] == sub_list:\n            return True\n    return False\n```"}
{"task_id": "Mbpp/573", "solution": "```python\ndef unique_product(numbers: list) -> int:\n    \"\"\"\n    Calculates the product of unique numbers in the given list.\n    Returns 1 if the list is empty or contains no valid unique numbers.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n\n    # Validate each element's type, raising TypeError for non-numeric items.\n    for item in numbers:\n        if not isinstance(item, (int, float)):\n            raise TypeError(f\"All elements in the list must be numbers (int or float), but found {type(item).__name__}.\")\n\n    unique_numbers = set(numbers)\n    \n    # If no unique numbers are found, return 1 as per business rule.\n    if not unique_numbers:\n        return 1\n\n    product = 1\n    for num in unique_numbers:\n        product *= num\n    return product\n```"}
{"task_id": "Mbpp/576", "solution": "```python\ndef is_Sub_Array(main_list: list, sublist: list) -> bool:\n    \"\"\"Checks if 'sublist' is a contiguous sublist of 'main_list'. Handles empty sublists and type validation.\"\"\"\n    if not isinstance(main_list, list) or not isinstance(sublist, list):\n        raise TypeError(\"Both main_list and sublist must be lists.\")\n\n    n = len(main_list)\n    m = len(sublist)\n\n    if m == 0:\n        return True  # An empty list is always a sublist.\n    if m > n:\n        return False # Sublist cannot be longer than main list.\n\n    for i in range(n - m + 1):\n        if main_list[i:i + m] == sublist:\n            return True\n    return False\n```"}
{"task_id": "Mbpp/577", "solution": "```python\ndef last_Digit_Factorial(num: int) -> int:\n    \"\"\"\n    Calculates the last digit of the factorial of a given non-negative number.\n    Returns an integer (0-9) representing the last digit of num!.\n    \"\"\"\n    if num < 0:\n        raise ValueError(\"Factorial is not defined for negative numbers.\")\n    elif num == 0 or num == 1:\n        return 1\n    elif num >= 5:\n        return 0  # Factorials of numbers >= 5 always end in 0.\n    else:\n        # Handle 2!, 3!, 4! directly.\n        if num == 2:\n            return 2\n        elif num == 3:\n            return 6\n        elif num == 4:\n            return 4\n    return 0 # Should not be reached\n```"}
{"task_id": "Mbpp/578", "solution": "class ListLengthMismatchError(ValueError):\n    \"\"\"Custom exception raised when input lists for interleaving have different lengths.\n    It indicates that the lengths of the provided lists do not match.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\ndef interleave_lists(list1: list, list2: list, list3: list) -> list:\n    \"\"\"\n    Interleaves three lists of the same length into a single flat list.\n    Raises ListLengthMismatchError if input lists have different lengths.\n    \"\"\"\n    len1, len2, len3 = len(list1), len(list2), len(list3)\n\n    if not (len1 == len2 == len3):\n        raise ListLengthMismatchError(\n            f\"Input lists must have the same length. Got: {len1}, {len2}, {len3}\"\n        )\n\n    result = []\n    for i in range(len1):\n        result.append(list1[i])\n        result.append(list2[i])\n        result.append(list3[i])\n    return result\n"}
{"task_id": "Mbpp/577", "solution": "```python\ndef last_Digit_Factorial(n: int) -> int:\n    \"\"\"Calculates the last digit of n!.\n    Handles non-negative integer inputs efficiently based on mathematical properties.\"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n\n    if n >= 5:\n        return 0\n    elif n == 0 or n == 1:\n        return 1\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 6\n    elif n == 4:\n        return 4\n\n```"}
{"task_id": "Mbpp/578", "solution": "class InterleaveError(Exception):\n    \"\"\"Custom exception for errors during list interleaving.\n    Raised when input lists do not meet length requirements.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\ndef interleave_lists(list1: list, list2: list, list3: list) -> list:\n    \"\"\"Interleaves three lists of the same length into a single flat list.\n    Raises InterleaveError if the input lists do not have the same length.\"\"\"\n    if not (len(list1) == len(list2) == len(list3)):\n        raise InterleaveError(\"Input lists must have equal length.\")\n\n    interleaved_list = []\n    for i in range(len(list1)):\n        interleaved_list.append(list1[i])\n        interleaved_list.append(list2[i])\n        interleaved_list.append(list3[i])\n    return interleaved_list"}
