{"task_id": "Mbpp/740", "solution": "```python\ndef tuple_to_dict(input_tuple: tuple) -> dict:\n    \"\"\"Converts a tuple into a dictionary using adjacent elements as key-value pairs.\n    Raises TypeError if input is not a tuple, or ValueError if the tuple has an odd number of elements.\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n    if len(input_tuple) % 2 != 0:\n        raise ValueError(\"Tuple must have an even number of elements to form key-value pairs.\")\n\n    return dict(zip(input_tuple[::2], input_tuple[1::2]))\n```"}
{"task_id": "Mbpp/758", "solution": "```python\nfrom collections import Counter as ListCounter\n\ndef unique_sublists(input_list: list[list]) -> dict[tuple, int]:\n    \"\"\"\n    Counts the occurrences of each unique sublist within a list of lists.\n    Each sublist is converted to a tuple to be used as a dictionary key.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    tuple_list = []\n    for item in input_list:\n        if not isinstance(item, list):\n            raise TypeError(\"All elements in the input list must be lists.\")\n        tuple_list.append(tuple(item))\n\n    return dict(ListCounter(tuple_list))\n```"}
{"task_id": "Mbpp/757", "solution": "```python\ndef count_reverse_pairs(string_list: list[str]) -> int:\n    \"\"\"\n    Counts pairs of strings where one is the reverse of the other.\n    Palindromes are not counted as pairs even if duplicated.\n    \"\"\"\n    \n    unique_input_strings = set(string_list)\n    processed_candidates = set()\n    reverse_pairs_count = 0\n\n    for s in string_list:\n        if s in processed_candidates:\n            continue\n\n        reversed_s = s[::-1]\n\n        # A pair is counted only if s and its reverse are distinct strings,\n        # and the reverse exists in the original list.\n        if reversed_s != s and reversed_s in unique_input_strings:\n            reverse_pairs_count += 1\n            processed_candidates.add(reversed_s)\n        \n        processed_candidates.add(s)\n\n    return reverse_pairs_count\n```"}
{"task_id": "Mbpp/759", "solution": "```python\nimport re\n\ndef is_decimal(s: str) -> bool:\n    \"\"\"\n    Validates if the string represents a decimal number with exactly two decimal places.\n    Returns True for valid formats like '123.45', '0.00', '-10.99'.\n    \"\"\"\n    if not isinstance(s, str):\n        return False\n    # Regex matches an optional sign, one or more digits, a decimal point, and exactly two digits after it.\n    pattern = re.compile(r\"^[+-]?\\d+\\.\\d{2}$\")\n    return bool(pattern.match(s))\n```"}
{"task_id": "Mbpp/757", "solution": "```python\nimport collections\n\ndef count_reverse_pairs(string_list: list) -> int:\n    \"\"\"\n    Counts unique reverse string pairs in the input list, handling duplicates and self-reverse strings.\n    It raises TypeError for invalid input types.\n    \"\"\"\n    if not isinstance(string_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    for s in string_list:\n        if not isinstance(s, str):\n            raise TypeError(\"All elements in the list must be strings.\")\n\n    # Use collections.Counter to efficiently count string occurrences.\n    string_counts = collections.Counter(string_list)\n    \n    count = 0\n    # The 'visited' set tracks strings already processed as part of a unique pair.\n    visited = set()\n\n    for s in string_list:\n        if s in visited:\n            continue\n\n        reversed_s = s[::-1] # Reverse the current string.\n\n        if s == reversed_s:\n            # For self-reverse strings, count as a pair if it appears at least twice.\n            if string_counts[s] >= 2:\n                count += 1\n            visited.add(s) # Mark as visited to avoid re-processing this instance.\n        elif reversed_s in string_counts and reversed_s not in visited:\n            # If a distinct reverse string exists and hasn't been part of a pair yet.\n            count += 1\n            visited.add(s)\n            visited.add(reversed_s) # Mark both original and its reverse as visited.\n    \n    return count\n```"}
{"task_id": "Mbpp/760", "solution": "from typing import Union\n\nclass InvalidInputError(TypeError):\n    \"\"\"Custom exception for invalid input to unique_Element function.\n    Inherits from TypeError to align with FR1 error handling.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\ndef unique_Element(numbers_list: list[Union[int, float]]) -> bool:\n    \"\"\"Checks if a list of numbers contains only one distinct element.\n    Returns True for empty lists, single-element lists, or lists with all identical elements.\n    \"\"\"\n    if not isinstance(numbers_list, list):\n        raise InvalidInputError(\"Input must be a list.\")\n\n    if not numbers_list:\n        return True\n\n    for item in numbers_list:\n        if not isinstance(item, (int, float)):\n            raise InvalidInputError(\"All elements in the list must be numeric.\")\n\n    distinct_elements = set(numbers_list)\n    return len(distinct_elements) <= 1"}
{"task_id": "Mbpp/760", "solution": "```python\nfrom typing import List, Union\n\ndef unique_Element(numbers: List[Union[int, float]]) -> bool:\n    \"\"\"Checks if a list of numbers contains only one distinct element.\n    Returns True if all elements are identical or if the list is empty/contains a single element; raises TypeError for invalid input.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n\n    if not all(isinstance(x, (int, float)) for x in numbers):\n        raise TypeError(\"All elements in the list must be numbers (int or float).\")\n\n    if not numbers:\n        return True\n\n    return len(set(numbers)) <= 1\n```"}
