{"task_id": "Mbpp/414", "solution": "```python\nfrom typing import Sequence, Hashable\n\ndef overlapping(seq1: Sequence[Hashable], seq2: Sequence[Hashable]) -> bool:\n    \"\"\"Checks if any element in seq1 is also present in seq2.\n    Optimizes performance by converting the smaller sequence to a set.\n    \"\"\"\n    if not seq1 or not seq2:\n        return False\n\n    # Convert the smaller sequence to a set for O(1) average-case lookup.\n    if len(seq1) < len(seq2):\n        smaller_set = set(seq1)\n        larger_seq = seq2\n    else:\n        smaller_set = set(seq2)\n        larger_seq = seq1\n\n    for item in larger_seq:\n        if item in smaller_set:\n            return True\n    return False\n```"}
{"task_id": "Mbpp/409", "solution": "```python\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to the min product calculator.\n    It carries a descriptive message about the error.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass MinProductCalculator:\n    \"\"\"Encapsulates the core logic for input validation and minimum product calculation.\n    It validates input and computes the smallest product from pairs within tuples.\n    \"\"\"\n    def calculate_min_product(self, list_of_tuples: list[tuple[int | float, int | float]]) -> int | float:\n        \"\"\"Validates input and computes the minimum product.\n        Raises InvalidInputError if input is invalid.\n        \"\"\"\n        self._validate_input(list_of_tuples)\n\n        min_product = float('inf')\n        for a, b in list_of_tuples:\n            product = a * b\n            if product < min_product:\n                min_product = product\n        return min_product\n\n    def _validate_input(self, list_of_tuples: list[tuple[int | float, int | float]]) -> None:\n        \"\"\"Performs comprehensive validation on the list of tuples.\n        Raises InvalidInputError with specific messages for various validation failures.\n        \"\"\"\n        if not isinstance(list_of_tuples, list):\n            raise InvalidInputError(\"Input must be a list.\")\n        if not list_of_tuples:\n            raise InvalidInputError(\"Input list cannot be empty.\")\n        for i, item in enumerate(list_of_tuples):\n            if not isinstance(item, tuple):\n                raise InvalidInputError(f\"Element at index {i} is not a tuple.\")\n            if len(item) != 2:\n                raise InvalidInputError(f\"Tuple at index {i} must contain exactly two elements.\")\n            if not all(isinstance(x, (int, float)) for x in item):\n                raise InvalidInputError(f\"Elements in tuple at index {i} must be numeric.\")\n\ndef min_product_tuple(list_of_tuples: list[tuple[int | float, int | float]]) -> int | float:\n    \"\"\"Calculates the minimum product from pairs of numbers within a list of tuples.\n\n    Args:\n        list_of_tuples: A list of tuples, where each tuple contains two numeric values.\n\n    Returns:\n        The minimum product found.\n\n    Raises:\n        InvalidInputError: If the input is not a valid list of numeric tuples.\n    \"\"\"\n    calculator = MinProductCalculator()\n    return calculator.calculate_min_product(list_of_tuples)\n```"}
{"task_id": "Mbpp/413", "solution": "```python\nclass InvalidNValueError(ValueError):\n    \"\"\"Custom exception for invalid 'n' values in extraction operations.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\ndef extract_nth_element(data: list[tuple], n: int) -> list:\n    \"\"\"\n    Extracts the nth element from each tuple in a given list of tuples.\n    Raises InvalidNValueError if 'n' is negative or out of bounds for any tuple.\n    \"\"\"\n    if not isinstance(data, list):\n        raise TypeError(\"Input 'data' must be a list.\")\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise InvalidNValueError(\"The index 'n' must be a non-negative integer.\")\n\n    extracted_elements = []\n    for i, item_tuple in enumerate(data):\n        if not isinstance(item_tuple, tuple):\n            raise TypeError(f\"Element at index {i} in 'data' is not a tuple.\")\n        try:\n            extracted_elements.append(item_tuple[n])\n        except IndexError:\n            raise InvalidNValueError(\n                f\"Tuple at index {i} does not have an element at position {n}. \"\n                f\"Tuple: {item_tuple}, n: {n}\"\n            ) from None\n    return extracted_elements\n```"}
{"task_id": "Mbpp/415", "solution": "```python\ndef max_Product(numbers: list[int]) -> tuple[int, int]:\n    \"\"\"\n    Finds the two numbers in the input array whose product is the highest.\n    Handles edge cases and negative numbers efficiently in O(N) time.\n    \"\"\"\n    if len(numbers) < 2:\n        raise ValueError(\"Input array must contain at least two numbers.\")\n\n    # Find the two largest and two smallest numbers in a single pass.\n    # This handles cases where two smallest negatives give the largest product.\n    largest = [float('-inf'), float('-inf')]\n    smallest = [float('inf'), float('inf')]\n\n    for num in numbers:\n        if num > largest[0]:\n            largest[1] = largest[0]\n            largest[0] = num\n        elif num > largest[1]:\n            largest[1] = num\n\n        if num < smallest[0]:\n            smallest[1] = smallest[0]\n            smallest[0] = num\n        elif num < smallest[1]:\n            smallest[1] = num\n    \n    # Compare the product of the two largest with the product of the two smallest.\n    prod_largest = largest[0] * largest[1]\n    prod_smallest = smallest[0] * smallest[1]\n\n    if prod_largest >= prod_smallest:\n        return (largest[0], largest[1])\n    else:\n        return (smallest[0], smallest[1])\n```"}
{"task_id": "Mbpp/420", "solution": "```python\ndef cube_Sum(n: int) -> int:\n    \"\"\"Calculates the sum of cubes of the first 'n' even natural numbers.\n    Raises ValueError if 'n' is not a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"Input 'n' must be a positive integer (>= 1).\")\n\n    total_sum = 0\n    for i in range(1, n + 1):\n        even_number = 2 * i\n        total_sum += even_number ** 3\n    return total_sum\n```"}
