ax_value\n```"}
{"task_id": "Mbpp/615", "solution": "```python\ndef average_tuple(data: tuple[tuple[int | float, ...], ...]) -> list[float]:\n    \"\"\"Calculates the average for each inner tuple in `data`. It returns a list of floats, handling empty tuples with `0.0` and raising errors for invalid types.\"\"\"\n    if not isinstance(data, tuple):\n        raise TypeError(\"Input must be a tuple of tuples.\")\n\n    averages = []\n    for inner_tuple in data:\n        if not isinstance(inner_tuple, tuple):\n            raise TypeError(\"All elements of the outer tuple must be tuples.\")\n\n        if not inner_tuple:\n            averages.append(0.0)\n            continue\n\n        current_sum = 0.0\n        for item in inner_tuple:\n            if not isinstance(item, (int, float)):\n                raise ValueError(f\"All elements within inner tuples must be numbers, got {type(item).__name__}.\")\n            current_sum += item\n        averages.append(current_sum / len(inner_tuple))\n    return averages\n```"}
{"task_id": "Mbpp/615", "solution": "```python\nfrom typing import Union, Tuple, List\n\nclass AveragingError(Exception):\n    \"\"\"Custom exception for errors during the averaging process.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\ndef average_tuple(data: Tuple[Tuple[Union[int, float], ...], ...]) -> List[float]:\n    \"\"\"\n    Computes the average of numeric values for each inner tuple within the provided data.\n    Raises TypeError for invalid input type or AveragingError for non-numeric inner tuple values.\n    \"\"\"\n    if not isinstance(data, tuple) or not all(isinstance(t, tuple) for t in data):\n        raise TypeError(\"Input must be a tuple of tuples.\")\n\n    results: List[float] = []\n    for inner_tuple in data:\n        numeric_elements = [x for x in inner_tuple if isinstance(x, (int, float))]\n        if len(numeric_elements) != len(inner_tuple):\n            raise AveragingError(f\"Inner tuple contains non-numeric values: {inner_tuple}\")\n\n        if not numeric_elements:\n            results.append(0.0)\n        else:\n            results.append(sum(numeric_elements) / len(numeric_elements))\n    return results\n```"}
{"task_id": "Mbpp/616", "solution": "```python\nclass TupleLengthMismatchError(Exception):\n    \"\"\"Custom exception for when tuple lengths do not match.\"\"\"\n    def __init__(self, message=\"Input tuples must have the same length.\"):\n        self.message = message\n        super().__init__(self.message)\n\nclass ZeroDivisionInTupleError(Exception):\n    \"\"\"Custom exception for when a modulo by zero is attempted within a tuple.\"\"\"\n    def __init__(self, message=\"Cannot perform modulo by zero for elements in the second tuple.\"):\n        self.message = message\n        super().__init__(self.message)\n\ndef tuple_modulo(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise modulo on two input tuples.\n    Raises specific errors for invalid input types, length mismatches, or zero divisors.\n    \"\"\"\n    if not isinstance(tuple1, tuple) or not isinstance(tuple2, tuple):\n        raise TypeError(\"Both inputs must be tuples.\")\n\n    if len(tuple1) != len(tuple2):\n        raise TupleLengthMismatchError(\"Input tuples must have the same length.\")\n\n    results = []\n    for i in range(len(tuple1)):\n        if tuple2[i] == 0:\n            raise ZeroDivisionInTupleError(f\"Cannot perform modulo by zero at index {i}.\")\n        results.append(tuple1[i] % tuple2[i])\n\n    return tuple(results)\n```"}
{"task_id": "Mbpp/616", "solution": "```python\ndef tuple_modulo(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"Performs element-wise modulo operation on two tuples of the same length.\n    Raises TypeError, ValueError, or ZeroDivisionError for invalid inputs.\n    \"\"\"\n    if not isinstance(tuple1, tuple) or not isinstance(tuple2, tuple):\n        raise TypeError(\"Both arguments must be tuples.\")\n\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Input tuples must be of the same length.\")\n\n    results = []\n    for i in range(len(tuple1)):\n        if tuple2[i] == 0:\n            raise ZeroDivisionError(\"Modulo by zero is not allowed.\")\n        results.append(tuple1[i] % tuple2[i])\n\n    return tuple(results)\n```"}
{"task_id": "Mbpp/619", "solution": "```python\ndef move_num(input_string: str) -> str:\n    \"\"\"\n    Moves all numeric characters to the end of the string, preserving relative order.\n    Raises TypeError if the input is not a string.\n    \"\"\"\n    if not isinstance(input_string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    non_numeric_chars = []\n    numeric_chars = []\n\n    for char in input_string:\n        if char.isdigit():\n            numeric_chars.append(char)\n        else:\n            non_numeric_chars.append(char)\n\n    return \"\".join(non_numeric_chars) + \"\".join(numeric_chars)\n```"}
