{"task_id": "Mbpp/3", "solution": "```python\nimport math\n\ndef is_not_prime(n: int) -> bool:\n    \"\"\"\n    Determines if a given integer is a non-prime number.\n    Returns True if n is non-prime, False otherwise.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n\n    if n <= 1:\n        return False\n    if n == 2:\n        return False\n    if n % 2 == 0:\n        return True\n\n    # Check for odd divisors from 3 up to sqrt(n)\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        if n % i == 0:\n            return True\n    return False\n```"}
{"task_id": "Mbpp/3", "solution": "```python\nimport math\n\ndef is_not_prime(number: int) -> bool:\n    \"\"\"\n    Determines if the input number is a non-prime number.\n    Returns True if non-prime, False if prime.\n    \"\"\"\n    if not isinstance(number, int):\n        raise TypeError(\"Input must be an integer.\")\n\n    if number <= 1:\n        return True  # Numbers <= 1 are not prime.\n    if number == 2:\n        return False # 2 is prime.\n    if number % 2 == 0:\n        return True  # Even numbers greater than 2 are not prime.\n\n    # Check for odd divisors from 3 up to the square root of the number.\n    for i in range(3, int(math.sqrt(number)) + 1, 2):\n        if number % i == 0:\n            return True\n    return False # No divisors found, so it's prime.\n```"}
{"task_id": "Mbpp/6", "solution": "```python\ndef differ_At_One_Bit_Pos(num1: int, num2: int) -> bool:\n    \"\"\"Checks if two integers differ by exactly one bit position.\n    Returns True if the numbers differ by exactly one bit, False otherwise.\"\"\"\n    xor_result = num1 ^ num2\n    return xor_result != 0 and (xor_result & (xor_result - 1)) == 0\n```"}
{"task_id": "Mbpp/2", "solution": "```python\ndef similar_elements(list1: list, list2: list) -> list:\n    \"\"\"Finds common elements between two lists, preserving duplicates based on occurrences.\n    Raises TypeError if inputs are not lists.\"\"\"\n    if not isinstance(list1, list) or not isinstance(list2, list):\n        raise TypeError(\"Both inputs must be lists.\")\n\n    shared_elements = []\n    # Create a mutable copy of list2 to allow removal of found elements for duplicate handling.\n    temp_list2 = list(list2)\n    \n    for item1 in list1:\n        try:\n            # Find and remove item1 from temp_list2 to ensure each match uses a unique instance.\n            index = temp_list2.index(item1)\n            shared_elements.append(item1)\n            temp_list2.pop(index)\n        except ValueError:\n            # item1 was not found in the remaining elements of temp_list2.\n            pass\n            \n    return shared_elements\n```"}
{"task_id": "Mbpp/2", "solution": "```python\nfrom typing import Iterable, Set\n\ndef similar_elements(list1: Iterable, list2: Iterable) -> Set:\n    \"\"\"\n    Finds and returns the unique common elements from two iterables.\n    Raises TypeError if inputs are not iterables (excluding strings/bytes).\n    \"\"\"\n    if not isinstance(list1, Iterable) or isinstance(list1, (str, bytes)):\n        raise TypeError(\"list1 must be an iterable (excluding strings/bytes).\")\n    if not isinstance(list2, Iterable) or isinstance(list2, (str, bytes)):\n        raise TypeError(\"list2 must be an iterable (excluding strings/bytes).\")\n\n    return set(list1) & set(list2)\n```"}
{"task_id": "Mbpp/6", "solution": "```python\ndef differ_At_One_Bit_Pos(num1: int, num2: int) -> bool:\n    \"\"\"\n    Checks if two integers differ at exactly one bit position.\n    Raises TypeError if num1 or num2 are not integers.\n    \"\"\"\n    if not isinstance(num1, int) or not isinstance(num2, int):\n        raise TypeError(\"Both num1 and num2 must be integers.\")\n\n    xor_result = num1 ^ num2\n    # Count set bits using Brian Kernighan's algorithm.\n    count = 0\n    while xor_result > 0:\n        xor_result &= (xor_result - 1)\n        count += 1\n    return count == 1\n```"}
{"task_id": "Mbpp/4", "solution": "```python\nimport heapq\n\ndef heap_queue_largest(numbers: list[int], n: int) -> list[int]:\n    \"\"\"Finds the n largest integers from a list, returned in descending order.\n    It uses a min-heap for efficient tracking of elements.\n    \"\"\"\n    if not numbers:\n        raise ValueError(\"Input list 'numbers' cannot be empty.\")\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n    if n > len(numbers):\n        raise ValueError(f\"Input 'n' ({n}) cannot be greater than the length of the list ({len(numbers)}).\")\n\n    if not all(isinstance(x, int) for x in numbers):\n        raise TypeError(\"All elements in 'numbers' must be integers.\")\n\n    min_heap = []\n    for num in numbers:\n        if len(min_heap) < n:\n            heapq.heappush(min_heap, num)\n        elif num > min_heap[0]:\n            heapq.heapreplace(min_heap, num)\n\n    return sorted(min_heap, reverse=True)\n```"}
{"task_id": "Mbpp/4", "solution": "```python\nimport heapq\n\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input parameters.\n    It signals issues with input types or values.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\ndef heap_queue_largest(numbers: list[int], n: int) -> list[int]:\n    \"\"\"Finds the n largest integers from a list, using a heap, and returns them in descending order.\n    Raises `InvalidInputError` for invalid input types or values.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise InvalidInputError(\"Input 'numbers' must be a list.\")\n    if not all(isinstance(x, int) for x in numbers):\n        raise InvalidInputError(\"All elements in 'numbers' must be integers.\")\n    if not isinstance(n, int) or n < 0:\n        raise InvalidInputError(\"Input 'n' must be a non-negative integer.\")\n\n    if n == 0 or not numbers:\n        return []\n\n    largest_n = heapq.nlargest(n, numbers)\n    \n    return largest_n\n```"}
{"task_id": "Mbpp/8", "solution": "```python\nfrom typing import List, Union\n\ndef square_nums(numbers: List[Union[int, float]]) -> List[Union[int, float]]:\n    \"\"\"\n    Calculates the square of each number in a list.\n\n    Args:\n        numbers: A list of integers or floats.\n\n    Returns:\n        A new list containing the squares of each number from the input list.\n\n    Raises:\n        TypeError: If the input is not a list or contains non-numeric elements.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n\n    # Validate each element is a number before squaring.\n    for num in numbers:\n        if not isinstance(num, (int, float)):\n            raise TypeError(f\"All elements in the list must be numbers, but found type {type(num).__name__}.\")\n\n    # Use a list comprehension for efficient squaring.\n    return [num * num for num in numbers]\n```\n"}
{"task_id": "Mbpp/7", "solution": "import string\n\ndef find_char_long(text: str) -> set[str]:\n    \"\"\"Finds all words which are at least 4 characters long in a string.\n\n    Args:\n        text: The input string.\n\n    Returns:\n        A set of unique words from the input string that are at least 4 characters long.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input 'text' must be a string.\")\n\n    min_length = 4\n    long_words = set()\n    words = text.split()\n\n    for word in words:\n        cleaned_word = word.strip(string.punctuation)\n        if len(cleaned_word) >= min_length:\n            long_words.add(cleaned_word)\n    return long_words"}
{"task_id": "Mbpp/11", "solution": "```python\ndef remove_Occ(input_string: str, char_to_remove: str) -> str:\n    \"\"\"Removes the first and last occurrences of a given character from the string.\n    Raises ValueError if `char_to_remove` is not a single character.\n    \"\"\"\n    if not isinstance(char_to_remove, str) or len(char_to_remove) != 1:\n        raise ValueError(\"The character to remove must be a single character string.\")\n\n    first_idx = input_string.find(char_to_remove)\n    if first_idx == -1:\n        return input_string\n\n    temp_string = input_string[:first_idx] + input_string[first_idx + 1:]\n\n    last_idx = temp_string.rfind(char_to_remove)\n    if last_idx == -1:\n        return temp_string\n\n    return temp_string[:last_idx] + temp_string[last_idx + 1:]\n```"}
{"task_id": "Mbpp/7", "solution": "```python\nimport re\n\ndef find_char_long(text: str) -> set[str]:\n    \"\"\"\n    Extracts unique words from a string that are at least 4 characters long.\n    Words are converted to lowercase and cleaned of leading/trailing non-alphanumeric characters.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input must be a string.\")\n\n    MIN_WORD_LENGTH = 4\n    long_words: set[str] = set()\n\n    # Split the text into potential word tokens using non-alphanumeric characters as delimiters.\n    raw_words = re.split(r'[^a-zA-Z0-9]+', text)\n\n    for raw_word in raw_words:\n        # Strip non-alphanumeric from start/end and convert to lowercase.\n        cleaned_word = re.sub(r'^[^a-zA-Z0-9]+|[^a-zA-Z0-9]+$', '', raw_word).lower()\n        if len(cleaned_word) >= MIN_WORD_LENGTH:\n            long_words.add(cleaned_word)\n\n    return long_words\n```"}
{"task_id": "Mbpp/8", "solution": "```python\nfrom typing import List, Union\n\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to math utility functions.\n    It carries a descriptive message about the error.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\ndef square_nums(numbers: List[Union[int, float]]) -> List[Union[int, float]]:\n    \"\"\"\n    Calculates the square of each number in a list.\n    Raises InvalidInputError for invalid input types.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise InvalidInputError(\"Input must be a list of numbers.\")\n\n    squared_list: List[Union[int, float]] = []\n    for num in numbers:\n        if not isinstance(num, (int, float)):\n            raise InvalidInputError(\"All elements in the list must be numbers.\")\n        squared_list.append(num * num)\n    return squared_list\n```"}
{"task_id": "Mbpp/9", "solution": "```python\ndef find_Rotations(s: str) -> int:\n    \"\"\"Calculates the minimum non-zero rotations for a string to return to its original form.\"\"\"\n    if not isinstance(s, str):\n        raise ValueError(\"Input must be a string.\")\n    if not s:\n        raise ValueError(\"Input string cannot be empty.\")\n\n    n = len(s)\n    if n <= 1:\n        return 1 # Single character strings (or empty, caught above) require 1 rotation.\n\n    # Concatenate the string with itself to effectively create all possible rotations.\n    # The 'find' method efficiently locates the first occurrence of 's' starting from index 1.\n    return (s + s).find(s, 1)\n```"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(s: str) -> int:\n    \"\"\"\n    Finds the minimum number of rotations (greater than 0) required to get the same string.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n    if not s:\n        raise ValueError(\"Input string cannot be empty.\")\n\n    n = len(s)\n    if n == 1:\n        return 1\n\n    for k in range(1, n + 1):\n        rotated_s = s[k:] + s[:k]\n        if s == rotated_s:\n            return k\n    return n"}
