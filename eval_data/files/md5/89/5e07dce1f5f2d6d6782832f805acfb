{"task_id": "Mbpp/728", "solution": "```python\nfrom typing import Union\n\nclass ListOperationError(Exception):\n    \"\"\"Base exception for errors in list operations.\n    It provides a descriptive error message.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass InputLengthMismatchError(ListOperationError):\n    \"\"\"Raised when input lists have different lengths.\n    It indicates a mismatch in the number of elements.\"\"\"\n    def __init__(self, message: str = \"Input lists must have the same length.\"):\n        super().__init__(message)\n\nclass InvalidInputTypeError(ListOperationError):\n    \"\"\"Raised when input types are incorrect.\n    This includes non-list inputs or non-numeric elements.\"\"\"\n    def __init__(self, message: str = \"Input must be lists of numeric types.\"):\n        super().__init__(message)\n\ndef sum_list(list_a: list[Union[int, float]], list_b: list[Union[int, float]]) -> list[Union[int, float]]:\n    \"\"\"Computes the element-wise sum of two input lists.\n    It ensures inputs are valid lists of equal length with numeric elements.\"\"\"\n    if not isinstance(list_a, list) or not isinstance(list_b, list):\n        raise InvalidInputTypeError(\"Inputs must be lists.\")\n\n    if len(list_a) != len(list_b):\n        raise InputLengthMismatchError(\"Input lists must have the same length.\")\n\n    result_list: list[Union[int, float]] = []\n    for i in range(len(list_a)):\n        val_a = list_a[i]\n        val_b = list_b[i]\n\n        if not isinstance(val_a, (int, float)) or not isinstance(val_b, (int, float)):\n            raise InvalidInputTypeError(\"List elements must be numeric (int or float).\")\n\n        result_list.append(val_a + val_b)\n\n    return result_list\n```"}
{"task_id": "Mbpp/730", "solution": "```python\ndef consecutive_duplicates(input_list: list) -> list:\n    \"\"\"\n    Removes consecutive duplicate elements from a list.\n    It returns a new list with consecutive duplicates removed.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    if not input_list:\n        return []\n\n    result = [input_list[0]]\n    for item in input_list[1:]:\n        if item != result[-1]:\n            result.append(item)\n    return result\n```"}
{"task_id": "Mbpp/731", "solution": "```python\nimport math\n\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\ndef lateralsurface_cone(r: float, h: float) -> float:\n    \"\"\"Calculates the lateral surface area of a cone.\"\"\"\n    if not isinstance(r, (int, float)) or r <= 0:\n        raise InvalidInputError(\"Radius must be a positive number.\")\n    if not isinstance(h, (int, float)) or h <= 0:\n        raise InvalidInputError(\"Height must be a positive number.\")\n\n    slant_height = math.sqrt(math.pow(r, 2) + math.pow(h, 2))\n    lateral_area = math.pi * r * slant_height\n    return lateral_area\n```"}
{"task_id": "Mbpp/732", "solution": "```python\ndef replace_specialchar(input_string: str) -> str:\n    \"\"\"\n    Replaces spaces, commas, and dots with colons in the input string.\n    Raises TypeError if the input is not a string.\n    \"\"\"\n    if not isinstance(input_string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    # Define characters to be replaced and the replacement character.\n    special_chars_to_replace = [' ', ',', '.']\n    replacement_char = ':'\n\n    modified_string = input_string\n    for char in special_chars_to_replace:\n        modified_string = modified_string.replace(char, replacement_char)\n\n    return modified_string\n```"}
{"task_id": "Mbpp/731", "solution": "```python\nimport math\n\nPI: float = math.pi\n\ndef calculate_slant_height(r: float, h: float) -> float:\n    \"\"\"Calculates the slant height of a cone using radius and height.\n    It applies the Pythagorean theorem: l = sqrt(r^2 + h^2).\n    \"\"\"\n    return math.sqrt(r**2 + h**2)\n\ndef lateralsurface_cone(r: float, h: float) -> float:\n    \"\"\"Calculates the lateral surface area of a cone.\n    This function uses the cone's radius and height to find the area.\n    \"\"\"\n    l = calculate_slant_height(r, h)\n    return PI * r * l\n```"}
