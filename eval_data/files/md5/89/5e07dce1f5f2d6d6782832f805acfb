{"task_id": "Mbpp/67", "solution": "```python\ndef bell_number(n: int) -> int:\n    class InvalidInputError(ValueError):\n        \"\"\"Custom exception for invalid input values.\"\"\"\n        pass\n\n    class StirlingCalculator:\n        \"\"\"Computes and caches Stirling numbers of the second kind, S(n, k), using dynamic programming.\"\"\"\n        def __init__(self):\n            self.memo: list[list[int]] = []\n\n        def get_stirling_s(self, n_val: int, k_val: int) -> int:\n            \"\"\"Public interface to retrieve S(n, k), handling memoization table resizing.\"\"\"\n            # Ensure memoization table is large enough for n_val\n            while len(self.memo) <= n_val:\n                # Initialize new rows with a placeholder value (-1) for uncomputed S(i,j).\n                self.memo.append([-1] * (len(self.memo) + 1))\n            # Ensure the row for n_val is large enough for k_val\n            while len(self.memo[n_val]) <= k_val:\n                self.memo[n_val].append(-1)\n\n            if self.memo[n_val][k_val] != -1:\n                return self.memo[n_val][k_val]\n\n            result = self._compute_stirling_s(n_val, k_val)\n            self.memo[n_val][k_val] = result\n            return result\n\n        def _compute_stirling_s(self, n_val: int, k_val: int) -> int:\n            \"\"\"Recursively computes S(n, k) based on recurrence relation and base cases.\"\"\"\n            # Base cases for Stirling numbers of the second kind.\n            if k_val == 0:\n                return 0 if n_val >= 1 else 1 # S(n,0)=0 for n>=1, S(0,0)=1.\n            if k_val == n_val:\n                return 1 # S(n,n)=1 for n>=0.\n            if k_val > n_val:\n                return 0 # S(n,k)=0 if k > n.\n\n            # Recurrence relation: S(n, k) = S(n-1, k-1) + k * S(n-1, k).\n            s_n_minus_1_k_minus_1 = self.get_stirling_s(n_val - 1, k_val - 1)\n            s_n_minus_1_k = self.get_stirling_s(n_val - 1, k_val)\n            \n            return s_n_minus_1_k_minus_1 + k_val * s_n_minus_1_k\n\n    class BellNumberService:\n        \"\"\"Orchestrates the calculation of the nth Bell number.\"\"\"\n        def __init__(self, stirling_calculator_instance: StirlingCalculator):\n            self.stirling_calculator = stirling_calculator_instance\n\n        def calculate_bell_number(self, n_val: int) -> int:\n            \"\"\"Computes the nth Bell number by summing S(n, k) for k from 0 to n.\"\"\"\n            bell_n = 0\n            for k in range(n_val + 1):\n                bell_n += self.stirling_calculator.get_stirling_s(n_val, k)\n            return bell_n\n\n    \"\"\"\n    Calculates the nth Bell number.\n\n    Args:\n        n: A non-negative integer.\n\n    Returns:\n        The nth Bell number.\n\n    Raises:\n        InvalidInputError: If n is a negative integer or not an integer.\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise InvalidInputError(\"Input 'n' must be a non-negative integer.\")\n    \n    if n == 0:\n        return 1\n\n    stirling_calculator_instance = StirlingCalculator()\n    bell_service_instance = BellNumberService(stirling_calculator_instance)\n    return bell_service_instance.calculate_bell_number(n)\n\n```\n"}
