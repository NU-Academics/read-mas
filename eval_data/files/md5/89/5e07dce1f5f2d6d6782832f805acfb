{"task_id": "Mbpp/140", "solution": "```python\nfrom typing import Iterable, List, Set, TypeVar\n\nT = TypeVar('T')\n\ndef extract_singly(list_of_iterables: List[Iterable[T]]) -> Set[T]:\n    \"\"\"\n    Flattens a list of iterables into a single set of unique elements.\n    This function performs a shallow flattening and requires all elements to be hashable.\n    \"\"\"\n    result_set: Set[T] = set()\n    for inner_iterable in list_of_iterables:\n        for element in inner_iterable:\n            result_set.add(element)\n    return result_set\n```"}
{"task_id": "Mbpp/141", "solution": "```python\ndef _flip(arr: list, i: int) -> None:\n    \"\"\"Reverses the order of elements from index 0 to i (inclusive) in the given array.\"\"\"\n    start = 0\n    while start < i:\n        arr[start], arr[i] = arr[i], arr[start]\n        start += 1\n        i -= 1\n\ndef _find_max_index(arr: list, n: int) -> int:\n    \"\"\"Finds the index of the maximum element in the first n elements of the given array.\"\"\"\n    max_idx = 0\n    for i in range(n):\n        if arr[i] > arr[max_idx]:\n            max_idx = i\n    return max_idx\n\ndef pancake_sort(data_list: list) -> list:\n    \"\"\"Sorts a list of comparable elements in ascending order using the pancake sort algorithm.\n    It returns a new sorted list, leaving the original input list unchanged.\"\"\"\n    if not isinstance(data_list, list):\n        raise TypeError(\"Input must be a list.\")\n    \n    arr = list(data_list) # Work on a copy to avoid modifying the original list.\n    n = len(arr)\n\n    for curr_size in range(n, 1, -1):\n        # Find index of the maximum element in the current sub-array.\n        max_idx = _find_max_index(arr, curr_size)\n\n        # If the maximum element is not already at the end of the current sub-array, move it.\n        if max_idx != curr_size - 1:\n            # First, flip to bring the maximum element to the beginning.\n            _flip(arr, max_idx)\n            # Second, flip to move the maximum element to its correct sorted position.\n            _flip(arr, curr_size - 1)\n    return arr\n```"}
{"task_id": "Mbpp/140", "solution": "```python\nfrom typing import Any, List, Set, Tuple, Union\n\ndef extract_singly(data: List[Tuple[Any, ...]]) -> Set[Union[int, float]]:\n    \"\"\"\n    Extracts unique integer and float numbers from a list of tuples.\n    Non-numerical elements are ignored during extraction.\n    \"\"\"\n    result_set: Set[Union[int, float]] = set()\n    for item_tuple in data:\n        for element in item_tuple:\n            if isinstance(element, (int, float)):\n                result_set.add(element)\n    return result_set\n```"}
{"task_id": "Mbpp/142", "solution": "```python\ndef count_samepair(list1: list, list2: list, list3: list) -> int:\n    \"\"\"\n    Counts positions where elements are identical across three lists.\n    Compares elements up to the length of the shortest list, raising TypeError for non-list inputs.\n    \"\"\"\n    if not isinstance(list1, list) or \\\n       not isinstance(list2, list) or \\\n       not isinstance(list3, list):\n        raise TypeError(\"All inputs must be lists.\")\n\n    min_length = min(len(list1), len(list2), len(list3))\n    count = 0\n    for i in range(min_length):\n        if list1[i] == list2[i] == list3[i]:\n            count += 1\n    return count\n```"}
{"task_id": "Mbpp/142", "solution": "```python\ndef count_samepair(list1: list, list2: list, list3: list) -> int:\n    \"\"\"\n    Counts items identical at the same position across three lists.\n    Compares elements up to the length of the shortest list.\n    \"\"\"\n    count = 0\n    min_length = min(len(list1), len(list2), len(list3))\n\n    for i in range(min_length):\n        if list1[i] == list2[i] and list2[i] == list3[i]:\n            count += 1\n    return count\n```"}
{"task_id": "Mbpp/141", "solution": "```python\ndef _find_max_index(arr: list[int], n: int) -> int:\n    \"\"\"Finds the index of the maximum element in arr[0...n-1].\n    This helper identifies the largest element in a given sub-array.\n    \"\"\"\n    max_idx = 0\n    for i in range(1, n):\n        if arr[i] > arr[max_idx]:\n            max_idx = i\n    return max_idx\n\ndef _flip(arr: list[int], i: int) -> None:\n    \"\"\"Reverses the order of elements from index 0 to i (inclusive) in the list.\n    This operation simulates a pancake flip on the sub-array.\n    \"\"\"\n    start = 0\n    while start < i:\n        arr[start], arr[i] = arr[i], arr[start]\n        start += 1\n        i -= 1\n\ndef pancake_sort(arr: list[int]) -> list[int]:\n    \"\"\"\n    Sorts a list of integers in ascending order using the pancake sort algorithm.\n    It performs validation for input type and element types.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input must be a list.\")\n    if not all(isinstance(x, int) for x in arr):\n        raise ValueError(\"All elements in the list must be integers.\")\n\n    n = len(arr)\n    if n <= 1:\n        return arr\n\n    # Iterate from the end of the list down to the second element.\n    # In each step, place the largest element of the unsorted part to its correct position.\n    for current_size in range(n, 1, -1):\n        # Find index of the maximum element in the current unsorted sublist arr[0...current_size-1].\n        max_idx = _find_max_index(arr, current_size)\n\n        # If the maximum element is not already at its correct position.\n        if max_idx != current_size - 1:\n            # Move the maximum element to the beginning of the sublist.\n            _flip(arr, max_idx)\n\n            # Move the maximum element from the beginning to its correct position\n            # at the end of the current sublist.\n            _flip(arr, current_size - 1)\n    \n    return arr\n```"}
{"task_id": "Mbpp/145", "solution": "```python\ndef max_Abs_Diff(arr: tuple) -> int:\n    \"\"\"Calculates the maximum absolute difference between any two elements in the given array.\n    Returns 0 if the input tuple has fewer than two elements.\"\"\"\n    if len(arr) < 2:\n        return 0\n\n    min_val = min(arr)\n    max_val = max(arr)\n\n    return int(abs(max_val - min_val))\n```"}
{"task_id": "Mbpp/145", "solution": "```python\ndef max_Abs_Diff(numbers: list[int | float]) -> int | float:\n    \"\"\"Calculates the maximum absolute difference between any two elements in a list.\n    Returns 0 for empty or single-element lists, and raises errors for invalid inputs.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n    if not all(isinstance(n, (int, float)) for n in numbers):\n        raise ValueError(\"All elements in the list must be numbers.\")\n\n    if len(numbers) < 2:\n        return 0\n\n    min_val = numbers[0]\n    max_val = numbers[0]\n\n    for num in numbers:\n        if num < min_val:\n            min_val = num\n        if num > max_val:\n            max_val = num\n\n    return abs(max_val - min_val)\n```"}
{"task_id": "Mbpp/161", "solution": "```python\ndef remove_elements(source_list: list, elements_to_remove: list) -> list:\n    \"\"\"Removes all elements from source_list that are present in elements_to_remove.\n    Returns a new list without modifying the originals, raising TypeError for non-list inputs.\n    \"\"\"\n    if not isinstance(source_list, list) or not isinstance(elements_to_remove, list):\n        raise TypeError(\"Both source_list and elements_to_remove must be lists.\")\n\n    # Convert elements_to_remove to a set for efficient O(1) average time complexity lookups.\n    elements_to_remove_set = set(elements_to_remove)\n\n    # Build the new list with elements from source_list not found in the set.\n    new_list = [item for item in source_list if item not in elements_to_remove_set]\n\n    return new_list\n```"}
{"task_id": "Mbpp/125", "solution": "import re\n\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to binary string analysis.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\ndef find_length(binary_string: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and 1s\n    in any substring of the given binary string.\n\n    Args:\n        binary_string: The input binary string (e.g., \"11000010001\").\n\n    Returns:\n        The maximum difference as an integer.\n\n    Raises:\n        InvalidInputError: If the input string is empty or contains\n                           non-binary characters.\n    \"\"\"\n    def _is_binary_string(s: str) -> bool:\n        \"\"\"Checks if the given string is non-empty and contains only '0' and '1'.\"\"\"\n        if not s:\n            return False\n        return bool(re.fullmatch(\"[01]+\", s))\n\n    def _convert_to_kadane_array(s: str) -> list[int]:\n        \"\"\"\n        Converts a binary string to an integer array: '0' -> 1, '1' -> -1.\n        This prepares the array for Kadane's algorithm.\n        \"\"\"\n        return [1 if char == '0' else -1 for char in s]\n\n    def _kadane_algorithm(arr: list[int]) -> int:\n        \"\"\"\n        Implements Kadane's algorithm to find the maximum subarray sum.\n        This sum represents the maximum difference.\n        \"\"\"\n        max_so_far = 0\n        current_max = 0\n\n        for x in arr:\n            current_max += x\n            if current_max < 0:\n                current_max = 0\n            max_so_far = max(max_so_far, current_max)\n        return max_so_far\n\n    if not _is_binary_string(binary_string):\n        raise InvalidInputError(\"Input string must be non-empty and contain only '0's and '1's.\")\n\n    kadane_array = _convert_to_kadane_array(binary_string)\n    return _kadane_algorithm(kadane_array)"}
{"task_id": "Mbpp/160", "solution": "```python\ndef extended_gcd(a: int, b: int) -> tuple[int, int, int]:\n    r\"\"\"\n    Implements the Extended Euclidean Algorithm.\n    Returns (gcd, x, y) such that ax + by = gcd(a, b).\n    \"\"\"\n    if a == 0:\n        return b, 0, 1\n    gcd_val, x1, y1 = extended_gcd(b % a, a)\n    x = y1 - (b // a) * x1\n    y = x1\n    return gcd_val, x, y\n\ndef find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    r\"\"\"\n    Finds a particular integer solution (x, y) for the linear Diophantine equation ax + by = n.\n    Returns a tuple (x, y) if a solution exists, otherwise None.\n    \"\"\"\n    # Handle the special case where both a and b are zero.\n    if a == 0 and b == 0:\n        if n == 0:\n            # If a=0, b=0, n=0, then 0x + 0y = 0 is true for any x,y.\n            # We return (0,0) as a valid particular solution.\n            return (0, 0)\n        else:\n            # If a=0, b=0, n!=0, then 0x + 0y = n has no solution.\n            return None\n\n    # Use the Extended Euclidean Algorithm to find gcd(a, b) and initial Bezout coefficients.\n    gcd_val, x0, y0 = extended_gcd(a, b)\n\n    # A solution exists if and only if n is divisible by gcd(a, b).\n    if n % gcd_val != 0:\n        return None\n\n    # Scale the particular solution from ax0 + by0 = gcd(a, b) to ax + by = n.\n    k = n // gcd_val\n    x = x0 * k\n    y = y0 * k\n\n    return (x, y)\n```"}
{"task_id": "Mbpp/160", "solution": "```python\ndef find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"\n    Finds integer solutions (x, y) for the linear Diophantine equation ax + by = n.\n    Returns (x, y) as a tuple if a solution exists, otherwise None.\n    \"\"\"\n    def _extended_gcd(a_val: int, b_val: int) -> tuple[int, int, int]:\n        \"\"\"\n        Calculates gcd(a_val, b_val) and Bezout coefficients x, y such that a_val*x + b_val*y = gcd.\n        This is a recursive implementation of the Extended Euclidean Algorithm.\n        \"\"\"\n        if a_val == 0:\n            return (b_val, 0, 1)\n        \n        gcd_val, x1, y1 = _extended_gcd(b_val % a_val, a_val)\n        x = y1 - (b_val // a_val) * x1\n        y = x1\n        return (gcd_val, x, y)\n\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n\n    gcd_val, x0, y0 = _extended_gcd(a, b)\n\n    if n % gcd_val != 0:\n        return None\n\n    k = n // gcd_val\n    x = x0 * k\n    y = y0 * k\n    \n    return (x, y)\n```"}
{"task_id": "Mbpp/161", "solution": "```python\ndef remove_elements(source_list: list, elements_to_remove: list) -> list:\n    \"\"\"\n    Removes all occurrences of elements from source_list that are present in elements_to_remove.\n    Returns a new list, leaving the original source_list unchanged.\n    \"\"\"\n    if not isinstance(source_list, list) or not isinstance(elements_to_remove, list):\n        raise TypeError(\"Both source_list and elements_to_remove must be lists.\")\n\n    # Convert elements_to_remove to a set for efficient O(1) average time complexity lookups.\n    elements_to_remove_set = set(elements_to_remove)\n\n    # Filter source_list, including only items not found in the removal set.\n    new_list = [item for item in source_list if item not in elements_to_remove_set]\n\n    return new_list\n```"}
{"task_id": "Mbpp/162", "solution": "```python\ndef sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the series n + (n-2) + (n-4) + ...\n    Terms must be strictly positive.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n\n    total_sum = 0\n    current_term = n\n    while current_term > 0:\n        total_sum += current_term\n        current_term -= 2\n    return total_sum\n```"}
{"task_id": "Mbpp/162", "solution": "```python\ndef sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the series (n - 2*i) for i from 0 to n // 2.\n    Raises ValueError if n is negative.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    total_sum = 0\n    # The loop goes from i=0 to n // 2 (inclusive).\n    for i in range(n // 2 + 1):\n        term = n - 2 * i\n        total_sum += term\n    return total_sum\n```"}
{"task_id": "Mbpp/165", "solution": "```python\ndef count_char_position(input_string: str) -> int:\n    \"\"\"\n    Counts characters in a string where their position matches their 0-indexed alphabetical position (case-insensitive).\n    Raises TypeError if the input is not a string.\n    \"\"\"\n    if not isinstance(input_string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    count = 0\n    alphabet_start_ord = ord('a')\n\n    for index, char in enumerate(input_string):\n        if char.isalpha():\n            lower_char = char.lower()\n            alphabet_position = ord(lower_char) - alphabet_start_ord\n            if alphabet_position == index:\n                count += 1\n    return count\n```"}
{"task_id": "Mbpp/167", "solution": "```python\ndef next_power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the smallest power of 2 greater than or equal to n.\n\n    Raises:\n        TypeError: If n is not an integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n\n    if n <= 0:\n        return 1\n\n    # Decrement n by 1 to correctly handle cases where n is already a power of 2.\n    n -= 1\n    n |= n >> 1\n    n |= n >> 2\n    n |= n >> 4\n    n |= n >> 8\n    n |= n >> 16\n    n += 1\n    return n\n```"}
{"task_id": "Mbpp/165", "solution": "```python\ndef count_char_position(input_string: str) -> int:\n    \"\"\"\n    Counts characters where their 1-based alphabetical position matches their 1-based string position.\n    Raises TypeError if input is not a string.\n    \"\"\"\n    if not isinstance(input_string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    count = 0\n    # Iterate through the string to compare character and index positions.\n    for index, char in enumerate(input_string):\n        upper_char = char.upper()\n        if 'A' <= upper_char <= 'Z':\n            # Calculate 1-based alphabetical position.\n            alpha_pos = ord(upper_char) - ord('A') + 1\n            # Calculate 1-based string position.\n            string_pos = index + 1\n\n            if alpha_pos == string_pos:\n                count += 1\n    return count\n```"}
{"task_id": "Mbpp/166", "solution": "```python\ndef find_even_pair(numbers: list[int]) -> int:\n    \"\"\"Counts pairs of integers in a list whose bitwise XOR sum is an even number.\n    An XOR sum is even if and only if both numbers have the same parity.\"\"\"\n    count_even = 0\n    count_odd = 0\n\n    for num in numbers:\n        if num % 2 == 0:\n            count_even += 1\n        else:\n            count_odd += 1\n\n    pairs_even_even = (count_even * (count_even - 1)) // 2\n    pairs_odd_odd = (count_odd * (count_odd - 1)) // 2\n\n    return pairs_even_even + pairs_odd_odd\n```"}
