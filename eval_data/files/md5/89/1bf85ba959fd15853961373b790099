{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    \"\"\"\n    collatz_sequence = []\n    current_n = n\n    \n    while True:\n        collatz_sequence.append(current_n)\n        if current_n == 1:\n            break\n        if current_n % 2 == 0:\n            current_n //= 2\n        else:\n            current_n = 3 * current_n + 1\n            \n    odd_numbers = [x for x in collatz_sequence if x % 2 == 1]\n    return sorted(odd_numbers)"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Computes the Collatz sequence for n, filters for odd numbers, and returns them sorted.\n    \"\"\"\n    odd_numbers = set()\n    current = n\n\n    while current != 1:\n        if current % 2 != 0:\n            odd_numbers.add(current)\n        if current % 2 == 0:\n            current = current // 2\n        else:\n            current = 3 * current + 1\n    \n    odd_numbers.add(1) # Ensure 1 is always included for any sequence ending at 1\n    \n    return sorted(list(odd_numbers))"}
{"task_id": "HumanEval/124", "solution": "def valid_date(date):\n    \"\"\"Validates a given date string in 'mm-dd-yyyy' format.\"\"\"\n\n    if not date:\n        return False\n\n    parts = date.split('-')\n    if len(parts) != 3:\n        return False\n\n    # Rule 4: Check strict format mm-dd-yyyy\n    if len(parts[0]) != 2 or len(parts[1]) != 2 or len(parts[2]) != 4:\n        return False\n\n    try:\n        month = int(parts[0])\n        day = int(parts[1])\n        year = int(parts[2])\n    except ValueError:\n        return False\n\n    # Helper function for leap year calculation\n    def is_leap_year(yr):\n        return (yr % 4 == 0 and yr % 100 != 0) or (yr % 400 == 0)\n\n    # Rule 3: Months should not be less than 1 or higher than 12.\n    if not (1 <= month <= 12):\n        return False\n\n    # Rule 2: Days validation based on month and leap year rules.\n    if month in {1, 3, 5, 7, 8, 10, 12}:\n        max_day = 31\n    elif month in {4, 6, 9, 11}:\n        max_day = 30\n    else:  # month == 2 (February)\n        max_day = 29 if is_leap_year(year) else 28\n\n    return 1 <= day <= max_day"}
{"task_id": "HumanEval/124", "solution": "import re\n\ndef valid_date(date):\n    \"\"\"Validates a given date string according to specific rules.\"\"\"\n    # Rule 1: The date string is not empty.\n    if not date:\n        return False\n\n    # Rule 4: The date should be in the format: mm-dd-yyyy\n    date_pattern = re.compile(r\"^(\\d{2})-(\\d{2})-(\\d{4})$\")\n    match = date_pattern.match(date)\n    if not match:\n        return False\n\n    try:\n        month_str, day_str, year_str = match.groups()\n        month = int(month_str)\n        day = int(day_str)\n        year = int(year_str)\n    except ValueError:\n        # Should not be reached if regex only matches digits, but for robustness\n        return False\n\n    # Rule 3: The months should not be less than 1 or higher than 12.\n    if not (1 <= month <= 12):\n        return False\n\n    # Define max days for each month (February is a special case)\n    days_in_month = {\n        1: 31, 3: 31, 5: 31, 7: 31, 8: 31, 10: 31, 12: 31, # Months with 31 days\n        4: 30, 6: 30, 9: 30, 11: 30,                     # Months with 30 days\n        2: 28                                            # February's base days\n    }\n\n    max_day = days_in_month.get(month)\n\n    # If month is 2 (February), check for leap year\n    if month == 2:\n        # Leap year rule: divisible by 4 and (not divisible by 100 unless divisible by 400)\n        is_leap_year = (year % 4 == 0 and year % 100 != 0) or (year % 400 == 0)\n        if is_leap_year:\n            max_day = 29 # Rule 2: 29 days for month 2 in a leap year\n\n    # Rule 2: The number of days is not less than 1 or higher than max_day\n    if not (1 <= day <= max_day):\n        return False\n\n    return True"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    '''\n    Splits a string based on whitespace, then commas, or counts odd-indexed lowercase letters.\n    '''\n    # Check for whitespace\n    has_whitespace = any(c.isspace() for c in txt)\n    if has_whitespace:\n        return txt.split()\n\n    # Check for commas\n    has_commas = ',' in txt\n    if has_commas:\n        return txt.split(',')\n\n    # Count lower-case letters with odd alphabetical order\n    odd_count = 0\n    for c in txt:\n        if 'a' <= c <= 'z':\n            # ord('a') = 0, ord('b') = 1, ...\n            alphabet_order = ord(c) - ord('a')\n            if alphabet_order % 2 == 1:\n                odd_count += 1\n    return odd_count"}
{"task_id": "HumanEval/125", "solution": "```python\ndef split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    '''\n    \n    # Check for whitespace\n    if any(c.isspace() for c in txt):\n        return txt.split()\n\n    # Check for commas\n    if ',' in txt:\n        return txt.split(',')\n\n    # Count lower-case letters with odd order in the alphabet\n    odd_order_count = 0\n    for char in txt:\n        if 'a' <= char <= 'z':\n            order = ord(char) - ord('a')\n            if order % 2 != 0:\n                odd_order_count += 1\n    return odd_order_count\n\n```"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    \"\"\"\n    Checks if a list is sorted in ascending order with at most one duplicate of any number.\n    Returns False if any number appears more than twice.\n    \"\"\"\n    duplicates = {}\n    prev = None\n\n    for x in lst:\n        if prev is not None and x < prev:\n            return False\n\n        duplicates[x] = duplicates.get(x, 0) + 1\n        if duplicates[x] > 2:  # More than one duplicate means count > 2 (i.e., 3 or more occurrences)\n            return False\n\n        prev = x\n\n    return True"}
{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"\n    Checks if the length of the intersection of two intervals is a prime number.\n    Returns \"YES\" if prime, otherwise \"NO\". Returns \"NO\" if no intersection.\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"Checks if a non-negative integer is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    # Calculate the intersection interval\n    intersection_start = max(start1, start2)\n    intersection_end = min(end1, end2)\n\n    # If the intersection is empty\n    if intersection_start > intersection_end:\n        return \"NO\"\n\n    # Calculate the length of the intersection\n    intersection_length = intersection_end - intersection_start + 1\n\n    # Check if the length is a prime number\n    if is_prime(intersection_length):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/126", "solution": "from typing import List\n\ndef is_sorted(lst: List[int]) -> bool:\n    \"\"\"\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False.\n    \"\"\"\n    if not lst:\n        return True\n\n    last = lst[0]\n    seen = {last}\n    duplicate = False\n\n    for num in lst[1:]:\n        if num < last:\n            return False\n        if num == last:\n            if duplicate:\n                return False\n            duplicate = True\n        else:\n            duplicate = False\n            if num in seen:\n                return False\n            seen.add(num)\n        last = num\n    return True"}
{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"Determines if the length of the intersection of two intervals is a prime number.\n    Returns \"YES\" if the length is prime, \"NO\" otherwise (including no intersection).\n    \"\"\"\n\n    def is_prime(n):\n        # Note: For this problem's examples, 2 is not considered a \"prime length\".\n        if n <= 1:\n            return False\n        if n == 2:\n            return False # Special case for problem samples; standard definition considers 2 prime.\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    start1, end1 = interval1\n    start2, end2 = interval2\n\n    # Calculate the intersection boundaries\n    intersection_start = max(start1, start2)\n    intersection_end = min(end1, end2)\n\n    # If intersection_start is greater than intersection_end, intervals do not intersect\n    if intersection_start > intersection_end:\n        return \"NO\"\n\n    # Calculate the length of the intersection (inclusive)\n    intersection_length = intersection_end - intersection_start + 1\n\n    # Check if the intersection length is a prime number\n    if is_prime(intersection_length):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Calculates the sum of magnitudes of integers multiplied by the product of their signs.\n    Returns None for an empty array.\n    \"\"\"\n    if not arr:\n        return None\n\n    def get_sign(num):\n        \"\"\"Returns the sign of a number: 1 for positive, -1 for negative, 0 for zero.\"\"\"\n        if num > 0:\n            return 1\n        elif num < 0:\n            return -1\n        else:\n            return 0\n\n    product_of_signs = 1\n    for x in arr:\n        product_of_signs *= get_sign(x)\n        # Optimization: if product of signs becomes 0, it will stay 0.\n        if product_of_signs == 0:\n            break\n\n    sum_of_magnitudes = sum(abs(x) for x in arr)\n\n    return sum_of_magnitudes * product_of_signs"}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Calculates the sum of magnitudes multiplied by the product of signs of numbers in an array.\n    Returns None for an empty array.\n    \"\"\"\n    if not arr:\n        return None\n\n    magnitude_sum = 0\n    negative_count = 0\n    has_zero = False\n\n    for x in arr:\n        magnitude_sum += abs(x)\n        if x == 0:\n            has_zero = True\n        elif x < 0:\n            negative_count += 1\n\n    if has_zero:\n        sign_product = 0\n    elif negative_count % 2 == 1:\n        sign_product = -1\n    else:\n        sign_product = 1\n\n    return magnitude_sum * sign_product"}
{"task_id": "HumanEval/129", "solution": "class Cell:\n    \"\"\"Represents a cell in the grid.\"\"\"\n    def __init__(self, row: int, col: int, value: int):\n        self.row = row\n        self.col = col\n        self.value = value\n\n    def __repr__(self):\n        return f\"Cell(value={self.value}, row={self.row}, col={self.col})\"\n\n    def __eq__(self, other):\n        if not isinstance(other, Cell):\n            return NotImplemented\n        return self.row == other.row and self.col == other.col\n\n    def __hash__(self):\n        return hash((self.row, self.col))\n\nclass Grid:\n    \"\"\"Encapsulates the grid matrix and provides neighbor lookup.\"\"\"\n    def __init__(self, matrix: list[list[int]]):\n        self.size = len(matrix)\n        self.cells = [[None for _ in range(self.size)] for _ in range(self.size)]\n        for r in range(self.size):\n            for c in range(self.size):\n                self.cells[r][c] = Cell(r, c, matrix[r][c])\n\n    def get_cell(self, row: int, col: int) -> Cell:\n        return self.cells[row][col]\n\n    def neighbors(self, cell: Cell) -> list[Cell]:\n        \"\"\"Returns orthogonal neighbors (up, down, left, right) within bounds.\"\"\"\n        nb_cells = []\n        r, c = cell.row, cell.col\n        \n        moves = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Up, Down, Left, Right\n\n        for dr, dc in moves:\n            nr, nc = r + dr, c + dc\n            if 0 <= nr < self.size and 0 <= nc < self.size:\n                nb_cells.append(self.get_cell(nr, nc))\n        return nb_cells\n\ndef lex_compare(a: list[int], b: list[int]) -> int:\n    \"\"\"Compares two lists lexicographically, returning -1 if a < b, 1 if a > b, 0 if equal.\"\"\"\n    if a < b:\n        return -1\n    elif a > b:\n        return 1\n    else:\n        return 0\n\ndef minPath(grid, k):\n    \"\"\"\n    Given a grid and a positive integer k, find the minimum path of length k in the grid.\n    Returns an ordered list of the values on the cells that the minimum path goes through.\n    \"\"\"\n    g = Grid(grid)\n    N = g.size\n\n    # dp[length_idx][row][col] stores the lexicographically smallest path\n    # of `length_idx + 1` cells, ending at (row, col).\n    # length_idx ranges from 0 to k-1.\n    dp = [[[None for _ in range(N)] for _ in range(N)] for _ in range(k)]\n\n    # Base case: paths of length 1 (length_idx = 0)\n    for r in range(N):\n        for c in range(N):\n            cell = g.get_cell(r, c)\n            dp[0][r][c] = [cell.value]\n\n    # Fill DP table for lengths 2 to k\n    for length_idx in range(1, k): # `length_idx` corresponds to actual path length `length_idx + 1`\n        for r in range(N):\n            for c in range(N):\n                current_cell = g.get_cell(r, c)\n                best_path_for_current_cell = None\n\n                # To find the path of length `length_idx + 1` ending at `(r, c)`,\n                # consider all neighbors `neighbor_cell` from which we could have arrived.\n                for neighbor_cell in g.neighbors(current_cell):\n                    # `prev_path` is the best path of length `length_idx` ending at `neighbor_cell`.\n                    prev_path = dp[length_idx - 1][neighbor_cell.row][neighbor_cell.col]\n                    \n                    # A candidate path of length `length_idx + 1` is `prev_path`\n                    # extended by the value of `current_cell`.\n                    candidate_path = prev_path + [current_cell.value]\n\n                    if best_path_for_current_cell is None or lex_compare(candidate_path, best_path_for_current_cell) < 0:\n                        best_path_for_current_cell = candidate_path\n                \n                dp[length_idx][r][c] = best_path_for_current_cell\n\n    # After filling the DP table, find the overall minimal path among all cells at length k\n    minimal_path_overall = None\n    for r in range(N):\n        for c in range(N):\n            path = dp[k - 1][r][c] # This is a path of length k ending at (r,c)\n            if minimal_path_overall is None or lex_compare(path, minimal_path_overall) < 0:\n                minimal_path_overall = path\n\n    return minimal_path_overall"}
{"task_id": "HumanEval/129", "solution": "import collections\nfrom typing import List, Tuple, Optional, Dict\n\nclass Grid:\n    \"\"\"Represents the grid, providing cell values and neighbor access.\"\"\"\n    def __init__(self, cells: List[List[int]]) -> None:\n        self._cells = cells\n        self._size = len(cells)\n\n    @property\n    def size(self) -> int:\n        return self._size\n\n    def get_value(self, row: int, col: int) -> int:\n        return self._cells[row][col]\n\n    def neighbors(self, row: int, col: int) -> List[Tuple[int, int]]:\n        \"\"\"Returns valid orthogonal neighbors for a given cell.\"\"\"\n        dirs = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Up, Down, Left, Right\n        result = []\n        for dr, dc in dirs:\n            nr, nc = row + dr, col + dc\n            if 0 <= nr < self._size and 0 <= nc < self._size:\n                result.append((nr, nc))\n        return result\n\ndef minPath(grid: List[List[int]], k: int) -> List[int]:\n    \"\"\"\n    Finds the minimum path of length k in the grid lexicographically.\n    Assumes valid input grid and k based on problem guarantees.\n    \"\"\"\n    grid_obj = Grid(grid)\n    N = grid_obj.size\n\n    # Memoization table for DFS results: (row, col, steps_left) -> Optional[List[int]]\n    memo: Dict[Tuple[int, int, int], Optional[List[int]]] = {}\n\n    def dfs(row: int, col: int, steps_left: int) -> Optional[List[int]]:\n        \"\"\"\n        Performs a Depth-First Search to find the lexicographically smallest path\n        of `steps_left` cells starting from `(row, col)`.\n        \"\"\"\n        # Base case: If only one step is left, the path is just the current cell's value.\n        if steps_left == 1:\n            return [grid_obj.get_value(row, col)]\n\n        key = (row, col, steps_left)\n        if key in memo:\n            return memo[key]\n\n        best_sub_path: Optional[List[int]] = None\n\n        # Get neighbors and sort them by their cell values for lexicographical order.\n        neighbors_with_values = []\n        for nr, nc in grid_obj.neighbors(row, col):\n            neighbors_with_values.append((grid_obj.get_value(nr, nc), nr, nc))\n\n        # Iterate through neighbors in ascending order of their values.\n        for _, nr, nc in sorted(neighbors_with_values):\n            # Recursively find the best path for the remaining `steps_left - 1` steps.\n            candidate_suffix = dfs(nr, nc, steps_left - 1)\n\n            if candidate_suffix is None:\n                continue # No valid path found from this neighbor.\n\n            # Construct the full path from the current cell `(row, col)`.\n            current_full_path = [grid_obj.get_value(row, col)] + candidate_suffix\n\n            # Update the best_sub_path if the current path is lexicographically smaller.\n            if best_sub_path is None or current_full_path < best_sub_path:\n                best_sub_path = current_full_path\n        \n        # Store the result in memoization table before returning.\n        memo[key] = best_sub_path\n        return best_sub_path\n\n    # Initialize the overall best path to None.\n    best_overall_path: Optional[List[int]] = None\n\n    # Iterate through every cell in the grid, considering each as a potential starting point.\n    for r in range(N):\n        for c in range(N):\n            # Find the best path of length `k` starting from `(r, c)`.\n            path_from_start = dfs(r, c, k)\n\n            if path_from_start is None:\n                continue # No path of length k found from this starting cell.\n\n            # Update the overall best path if the current path is lexicographically smaller.\n            if best_overall_path is None or path_from_start < best_overall_path:\n                best_overall_path = path_from_start\n    \n    # The problem guarantees a unique answer and that a path always exists.\n    return best_overall_path"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Computes the Tribonacci sequence up to the n-th term using memoization.\n\n    Returns a list of the first n + 1 Tribonacci numbers [tri(0), ..., tri(n)].\n    \"\"\"\n    memo = {}\n\n    def _get_tri_value(k):\n        if k in memo:\n            return memo[k]\n\n        if k == 0:\n            result = 1\n        elif k == 1:\n            result = 3\n        elif k % 2 == 0:  # k is even\n            result = 1 + k // 2\n        else:  # k is odd\n            # tri(k) = tri(k-1) + tri(k-2) + tri(k+1)\n            result = _get_tri_value(k - 1) + _get_tri_value(k - 2) + _get_tri_value(k + 1)\n        \n        memo[k] = result\n        return result\n\n    result_list = []\n    for i in range(n + 1):\n        result_list.append(_get_tri_value(i))\n\n    return result_list"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"\n    Calculates the first n+1 numbers of the Tribonacci sequence.\n    It uses memoization to efficiently compute the recursive terms.\n    \"\"\"\n    memo = {}\n\n    def _calculate_tri(k):\n        if k in memo:\n            return memo[k]\n\n        if k == 0:\n            value = 1\n        elif k == 1:\n            value = 3\n        elif k % 2 == 0:  # k is even\n            value = 1 + k // 2\n        else:  # k is odd\n            value = _calculate_tri(k - 1) + _calculate_tri(k - 2) + _calculate_tri(k + 1)\n\n        memo[k] = value\n        return value\n\n    result = [_calculate_tri(i) for i in range(n + 1)]\n    return result"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n    product = 1\n    has_odd = False\n    for char_digit in str(n):\n        digit = int(char_digit)\n        if digit % 2 != 0:  # Check if the digit is odd\n            product *= digit\n            has_odd = True\n    return product if has_odd else 0"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n    product = 1\n    has_odd = False\n    for digit in str(n):\n        d = int(digit)\n        if d % 2 == 1:\n            product *= d\n            has_odd = True\n    return product if has_odd else 0"}
{"task_id": "HumanEval/132", "solution": "```python\ndef is_nested(string):\n    \"\"\"\n    Checks if the input string contains a valid subsequence of brackets where at least one bracket is nested.\n    The algorithm runs in O(n) time and O(1) additional space.\n    \"\"\"\n    balance = 0\n    current_sequence_is_nested = False\n\n    for char in string:\n        if char == '[':\n            balance += 1\n            if balance > 1:\n                # If balance exceeds 1, we have encountered `[[`, indicating nesting.\n                current_sequence_is_nested = True\n        else:  # char == ']'\n            balance -= 1\n            if balance == 0:\n                # A complete, balanced segment just ended.\n                # If it was nested, we found our answer.\n                if current_sequence_is_nested:\n                    return True\n                # Reset nesting flag for the next potential segment.\n                current_sequence_is_nested = False\n            elif balance < 0:\n                # An unmatched closing bracket, invalidates the current path.\n                # Reset balance and nesting flag to start checking for a new valid subsequence.\n                balance = 0\n                current_sequence_is_nested = False\n    \n    # If the loop completes, no fully balanced and nested subsequence was found.\n    # (Because if it was, we would have returned True inside the loop.)\n    return False\n```"}
{"task_id": "HumanEval/133", "solution": "import math\n\ndef sum_squares(lst):\n    \"\"\"\n    Calculates the sum of squared numbers in a list after rounding each element up to the nearest integer.\n    \"\"\"\n    total_sum = 0\n    for number in lst:\n        ceiled_number = math.ceil(number)\n        total_sum += ceiled_number ** 2\n    return total_sum"}
{"task_id": "HumanEval/132", "solution": "```python\ndef is_nested(string):\n    \"\"\"\n    Checks if the input string contains a valid subsequence of brackets where at least one bracket is nested.\n\n    A subsequence is considered 'nested' if it can be represented as `[A]` where `A` is a non-empty,\n    balanced bracket sequence.\n    \"\"\"\n    open_brackets_stack = []  # Stores (index, balance_at_open_index) for '['\n    current_balance = 0\n    \n    for i, char in enumerate(string):\n        if char == '[':\n            open_brackets_stack.append((i, current_balance))\n            current_balance += 1\n        elif char == ']':\n            if open_brackets_stack:\n                open_idx, balance_at_open_idx = open_brackets_stack.pop()\n                current_balance -= 1\n\n                # A candidate valid pair `string[open_idx ... i]` is found.\n                # The content `A` is `string[open_idx + 1 : i]`.\n                # Condition for nesting:\n                # 1. `A` must be non-empty (i.e., `i - open_idx > 1`).\n                # 2. `A` must be a balanced bracket sequence.\n                # The second condition is met if `current_balance == balance_at_open_idx`.\n                # This ensures that all brackets between `open_idx` and `i` (excluding them)\n                # have formed balanced pairs and haven't dropped balance below the starting point.\n                if i - open_idx > 1 and current_balance == balance_at_open_idx:\n                    return True\n            else:\n                # Mismatched closing bracket for current sequence.\n                # Reset balance as this segment cannot form a valid sequence from this point.\n                current_balance = 0\n                \n    return False\n\n```"}
{"task_id": "HumanEval/133", "solution": "import math\n\ndef sum_squares(lst):\n    \"\"\"You are given a list of numbers.\n    You need to return the sum of squared numbers in the given list,\n    round each element in the list to the upper int(Ceiling) first.\n    Examples:\n    For lst = [1,2,3] the output should be 14\n    For lst = [1,4,9] the output should be 98\n    For lst = [1,3,5,7] the output should be 84\n    For lst = [1.4,4.2,0] the output should be 29\n    For lst = [-2.4,1,1] the output should be 6\n    \n\n    \"\"\"\n    total_sum = 0\n    for num in lst:\n        ceiled_num = math.ceil(num)\n        total_sum += ceiled_num * ceiled_num\n    return total_sum"}
{"task_id": "HumanEval/134", "solution": "import string\n\ndef check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Returns True if the last character of a given string is an alphabetical character\n    and is a standalone single-character word, False otherwise.\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    # Check if the last character is an ASCII letter.\n    if last_char not in string.ascii_letters:\n        return False\n\n    # If the string contains only one character, and it's a letter, it's a standalone word.\n    if len(txt) == 1:\n        return True\n\n    # Otherwise, check if the character preceding the last one is a space.\n    # This indicates the last character is a single-letter word.\n    preceding_char = txt[-2]\n    if preceding_char == ' ':\n        return True\n    \n    # If the preceding character is not a space, the last letter is part of a longer word.\n    return False"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Returns True if the last character of txt is an alphabetical character\n    and is not part of a word, and False otherwise.\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    if len(txt) == 1:\n        return True\n\n    # A letter is not part of a word if it's preceded by a space.\n    return txt[-2] == ' '"}
