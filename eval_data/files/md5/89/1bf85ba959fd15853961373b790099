{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"Reverses the case of letters in a string, or reverses the string if no letters are present.\"\"\"\n    \n    # Check if the string contains any letters\n    has_letters = False\n    for char_s in s:\n        if char_s.isalpha():\n            has_letters = True\n            break\n\n    if not has_letters:\n        # If no letters, reverse the entire string\n        return s[::-1]\n    else:\n        # If letters are present, reverse their case\n        transformed_chars = []\n        for char_s in s:\n            if char_s.isalpha():\n                if char_s.islower():\n                    transformed_chars.append(char_s.upper())\n                else:\n                    transformed_chars.append(char_s.lower())\n            else:\n                # Keep non-letter characters as they are\n                transformed_chars.append(char_s)\n        return \"\".join(transformed_chars)"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand, build and evaluate the algebraic expression.\n    Operations with higher precedence modify the current term, while lower precedence\n    operations add new terms to be summed.\n    \"\"\"\n    terms = [operand[0]]\n\n    for i in range(len(operator)):\n        op = operator[i]\n        num = operand[i + 1]\n\n        if op == \"**\":\n            terms[-1] **= num\n        elif op == \"*\":\n            terms[-1] *= num\n        elif op == \"//\":\n            terms[-1] //= num\n        elif op == \"+\":\n            terms.append(num)\n        elif op == \"-\":\n            terms.append(-num)\n    \n    return sum(terms)"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"Reverses case of letters if present, otherwise reverses the string.\"\"\"\n    has_alpha = any(c.isalpha() for c in s)\n    if has_alpha:\n        return ''.join(c.swapcase() if c.isalpha() else c for c in s)\n    else:\n        return s[::-1]"}
