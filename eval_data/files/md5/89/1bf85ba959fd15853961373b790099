{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # reverse cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # cycle elements in each group back to original position. Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/39", "solution": "import math\n\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    \"\"\"\n\n    class FibonacciGenerator:\n        \"\"\"Generates Fibonacci numbers.\"\"\"\n        def __init__(self) -> None:\n            self._a = 1\n            self._b = 1\n\n        def __iter__(self):\n            return self\n\n        def __next__(self) -> int:\n            value = self._a\n            self._a, self._b = self._b, self._a + self._b\n            return value\n\n    class PrimeChecker:\n        \"\"\"Checks if a given number is prime using trial division.\"\"\"\n        def is_prime(self, num: int) -> bool:\n            if num < 2:\n                return False\n            if num == 2:\n                return True\n            if num % 2 == 0:\n                return False\n            for i in range(3, math.isqrt(num) + 1, 2):\n                if num % i == 0:\n                    return False\n            return True\n\n    fib_gen = FibonacciGenerator()\n    prime_chk = PrimeChecker()\n    found_primes_count = 0\n\n    while True:\n        fib_num = next(fib_gen)\n        if prime_chk.is_prime(fib_num):\n            found_primes_count += 1\n            if found_primes_count == n:\n                return fib_num"}
{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n\n    def is_prime(num: int) -> bool:\n        \"\"\"Checks if a number is prime.\"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    def fibonacci_generator():\n        \"\"\"Generates an infinite sequence of Fibonacci numbers.\"\"\"\n        a, b = 0, 1\n        yield a\n        yield b\n        while True:\n            a, b = b, a + b\n            yield b\n\n    prime_count = 0\n    for fib_num in fibonacci_generator():\n        if is_prime(fib_num):\n            prime_count += 1\n            if prime_count == n:\n                return fib_num"}
{"task_id": "HumanEval/40", "solution": "import collections\n\ndef triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n\n    >>> triples_sum_to_zero([1, 3, 5, 0])\n    False\n    >>> triples_sum_to_zero([1, 3, -2, 1])\n    True\n    >>> triples_sum_to_zero([1, 2, 3, 7])\n    False\n    >>> triples_sum_to_zero([2, 4, -5, 3, 9, 7])\n    True\n    >>> triples_sum_to_zero([1])\n    False\n    \"\"\"\n    if len(l) < 3:\n        return False\n\n    # Create a frequency map to count occurrences of each number.\n    # This allows checking for the third element while ensuring distinct indices.\n    freq_map = collections.Counter(l)\n\n    # Iterate through all unique pairs (l[i], l[j])\n    for i in range(len(l)):\n        for j in range(i + 1, len(l)):\n            n1 = l[i]\n            n2 = l[j]\n            n3_needed = -(n1 + n2)\n\n            # Check if the third required number exists in the list.\n            if n3_needed in freq_map:\n                # Calculate the available count for n3_needed,\n                # considering n1 and n2 might be equal to n3_needed.\n                count = freq_map[n3_needed]\n                if n3_needed == n1:\n                    count -= 1\n                if n3_needed == n2:\n                    count -= 1\n\n                # If count is still positive, a third number distinct from indices i and j exists.\n                if count > 0:\n                    return True\n\n    return False"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    sorted_l = sorted(l)\n\n    for i in range(n - 2):\n        left, right = i + 1, n - 1\n        while left < right:\n            current_sum = sorted_l[i] + sorted_l[left] + sorted_l[right]\n            if current_sum == 0:\n                return True\n            elif current_sum < 0:\n                left += 1\n            else:\n                right -= 1\n    return False"}
