{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by swapping the case of all letters and replacing\n    all vowels with the letter two places ahead in the alphabet, wrapping around.\n    \"\"\"\n    \n    def _swap_case(text):\n        \"\"\"Swaps the case of all letters in the given text.\"\"\"\n        return text.swapcase()\n\n    def _replace_vowels(text):\n        \"\"\"Replaces vowels in text with the letter two places ahead, handling wrap-around.\"\"\"\n        vowel_map = {\n            'a': 'c', 'e': 'g', 'i': 'k', 'o': 'q', 'u': 'a',\n            'A': 'C', 'E': 'G', 'I': 'K', 'O': 'Q', 'U': 'A',\n        }\n        encoded_chars = []\n        for char in text:\n            encoded_chars.append(vowel_map.get(char, char))\n        return \"\".join(encoded_chars)\n\n    swapped_case_message = _swap_case(message)\n    final_encoded_message = _replace_vowels(swapped_case_message)\n    return final_encoded_message"}
{"task_id": "HumanEval/93", "solution": "```python\ndef encode(message):\n    \"\"\"\n    Swaps case of letters, then replaces vowels with the letter\n    2 places ahead in the alphabet, preserving non-alphabetic characters.\n    \"\"\"\n    VOWEL_MAP = {\n        'a': 'c', 'e': 'g', 'i': 'k', 'o': 'q', 'u': 'w',\n        'A': 'C', 'E': 'G', 'I': 'K', 'O': 'Q', 'U': 'W'\n    }\n    encoded_chars = []\n    for char in message:\n        if char.isalpha():\n            # First, swap the case\n            swapped_char = char.swapcase()\n            # Then, check if the swapped character is a vowel to replace it\n            if swapped_char in VOWEL_MAP:\n                encoded_chars.append(VOWEL_MAP[swapped_char])\n            else:\n                encoded_chars.append(swapped_char)\n        else:\n            # If not a letter, keep it as is (e.g., spaces)\n            encoded_chars.append(char)\n    return \"\".join(encoded_chars)\n```"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"Finds the largest prime value in a list and returns the sum of its digits.\n    If no prime is found, it returns 0.\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"Checks if a number is prime.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def digit_sum(n):\n        \"\"\"Calculates the sum of the digits of a number.\"\"\"\n        return sum(int(d) for d in str(abs(n)))\n\n    largest_prime = 0\n    for num in lst:\n        if is_prime(num):\n            if num > largest_prime:\n                largest_prime = num\n\n    if largest_prime == 0:\n        return 0\n    else:\n        return digit_sum(largest_prime)"}
{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"Finds the largest prime number in a list and returns the sum of its digits.\"\"\"\n\n    def is_prime(n):\n        \"\"\"Checks if a number is prime.\"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    def sum_digits(n):\n        \"\"\"Calculates the sum of the digits of a number.\"\"\"\n        digit_sum = 0\n        while n > 0:\n            digit_sum += n % 10\n            n //= 10\n        return digit_sum\n\n    largest_prime = 0\n\n    for num in lst:\n        if num > largest_prime and is_prime(num):\n            largest_prime = num\n\n    if largest_prime == 0:\n        return 0\n    else:\n        return sum_digits(largest_prime)"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Checks if all dictionary keys are strings and consistently lower or upper case.\n    Returns False if the dictionary is empty or contains non-string/mixed-case keys.\n    \"\"\"\n    if not dict:  # Handles empty dictionary case\n        return False\n\n    keys = list(dict.keys())\n\n    # Check if all keys are strings\n    if not all(isinstance(k, str) for k in keys):\n        return False\n\n    first_key = keys[0]\n    is_all_lower = first_key.islower()\n    is_all_upper = first_key.isupper()\n\n    # If the first key is neither purely lower nor purely upper (e.g., mixed case, digits only)\n    if not (is_all_lower or is_all_upper):\n        return False\n\n    # Check the remaining keys for consistency\n    for key in keys[1:]:\n        if is_all_lower and not key.islower():\n            return False\n        if is_all_upper and not key.isupper():\n            return False\n            \n    return True"}
{"task_id": "HumanEval/95", "solution": "```python\ndef check_dict_case(dict):\n    \"\"\"\n    Checks if all keys are strings and are either all lower case or all upper case.\n    Returns False if the dictionary is empty or contains non-string keys.\n    \"\"\"\n    if not dict:\n        return False\n\n    keys = list(dict.keys())\n\n    # Check if all keys are strings\n    if not all(isinstance(k, str) for k in keys):\n        return False\n\n    # Check if all keys are lowercase or all keys are uppercase\n    all_lower = True\n    all_upper = True\n\n    for key in keys:\n        if not key.islower():\n            all_lower = False\n        if not key.isupper():\n            all_upper = False\n        \n        # Optimization: if both flags are false, we can stop early\n        if not all_lower and not all_upper:\n            return False\n\n    return all_lower or all_upper\n```"}
{"task_id": "HumanEval/96", "solution": "def count_up_to(n):\n    \"\"\"Returns an array of prime numbers less than n.\"\"\"\n\n    def is_prime(candidate: int) -> bool:\n        \"\"\"Checks if a number is prime.\"\"\"\n        if candidate <= 1:\n            return False\n        if candidate <= 3:\n            return True\n        if candidate % 2 == 0 or candidate % 3 == 0:\n            return False\n        i = 5\n        while i * i <= candidate:\n            if candidate % i == 0 or candidate % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    primes = []\n    for num in range(2, n):\n        if is_prime(num):\n            primes.append(num)\n    return primes"}
{"task_id": "HumanEval/96", "solution": "def count_up_to(n):\n    \"\"\"Returns an array of prime numbers less than n using the Sieve of Eratosthenes.\"\"\"\n    if n < 2:\n        return []\n\n    is_prime = [True] * n\n    is_prime[0:2] = [False, False]  # 0 and 1 are not prime\n\n    for p in range(2, int(n**0.5) + 1):\n        if is_prime[p]:\n            # Mark multiples of p as not prime, starting from p*p\n            for multiple in range(p*p, n, p):\n                is_prime[multiple] = False\n\n    return [i for i, prime in enumerate(is_prime) if prime]"}
