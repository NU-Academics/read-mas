{"task_id": "HumanEval/17", "solution": "def parse_music(music_string: str) -> List[int]:\n    \"\"\" Parses a musical string into a list of beat durations. \"\"\"\n    beats = []\n    # Split the input string into individual note tokens\n    note_tokens = music_string.split()\n\n    # Map each token to its corresponding beat value\n    for token in note_tokens:\n        if token == 'o':\n            beats.append(4)\n        elif token == 'o|':\n            beats.append(2)\n        elif token == '.|':\n            beats.append(1)\n        # As per instructions, do not raise exceptions for edge cases (invalid tokens)\n        # The problem statement implies only valid tokens will be in the input based on the example.\n    return beats"}
{"task_id": "HumanEval/17", "solution": "def parse_music(music_string: str) -> List[int]:\n    \"\"\"Parses a music string to return a list of beat durations.\n\n    Each note token is mapped to its corresponding beat value.\n    \"\"\"\n    note_beats_map = {\n        'o': 4,   # whole note\n        'o|': 2,  # half note\n        '.|': 1   # quarter note\n    }\n\n    # Split the string by spaces, removing any empty strings that might result from multiple spaces\n    # or leading/trailing spaces.\n    tokens = [token for token in music_string.strip().split(' ') if token]\n\n    # Map each token to its beat value using the predefined dictionary\n    beats_list = [note_beats_map[token] for token in tokens]\n\n    return beats_list"}
{"task_id": "HumanEval/18", "solution": "def how_many_times(string: str, substring: str) -> int:\n    \"\"\" Find how many times a given substring can be found in the original string. Count overlaping cases.\n    >>> how_many_times('', 'a')\n    0\n    >>> how_many_times('aaa', 'a')\n    3\n    >>> how_many_times('aaaa', 'aa')\n    3\n    \"\"\"\n    if not substring:\n        return 0\n    \n    count = 0\n    sub_len = len(substring)\n    for i in range(len(string) - sub_len + 1):\n        if string[i:i + sub_len] == substring:\n            count += 1\n    return count"}
