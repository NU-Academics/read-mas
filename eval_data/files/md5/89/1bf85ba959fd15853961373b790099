{"task_id": "HumanEval/6", "solution": "def parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n\n    def compute_depth(group: str) -> int:\n        \"\"\"Return the maximum depth of nested parentheses in `group`.\"\"\"\n        depth = 0\n        max_depth = 0\n        for ch in group:\n            if ch == '(':\n                depth += 1\n                max_depth = max(max_depth, depth)\n            elif ch == ')':\n                depth -= 1\n        return max_depth\n\n    groups = [g for g in paren_string.split(' ') if g]\n    depths = [compute_depth(group) for group in groups]\n    return depths"}
{"task_id": "HumanEval/6", "solution": "from typing import List\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    result_depths = []\n    # Split the input string into individual groups, filtering out any empty strings resulting from multiple spaces.\n    groups = [group for group in paren_string.split(' ') if group]\n\n    for group in groups:\n        current_depth = 0\n        max_depth = 0\n        # Iterate through each character in the group to determine the maximum nesting depth.\n        for char in group:\n            if char == '(':\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif char == ')':\n                current_depth -= 1\n        result_depths.append(max_depth)\n\n    return result_depths"}
