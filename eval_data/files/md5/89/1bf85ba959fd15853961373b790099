{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension based on CAP - SM metric and returns\n    the class name concatenated with the strongest extension name.\n    \"\"\"\n\n    def _calculate_strength(ext_name):\n        \"\"\"Calculates the strength of an extension name.\"\"\"\n        cap_count = 0\n        sm_count = 0\n        for char in ext_name:\n            if 'A' <= char <= 'Z':  # char.isupper()\n                cap_count += 1\n            elif 'a' <= char <= 'z':  # char.islower()\n                sm_count += 1\n        return cap_count - sm_count\n\n    # Initialize with the first extension\n    strongest_extension_name = extensions[0]\n    max_strength = _calculate_strength(strongest_extension_name)\n\n    # Iterate through the rest of the extensions\n    for i in range(1, len(extensions)):\n        current_extension_name = extensions[i]\n        current_strength = _calculate_strength(current_extension_name)\n\n        # If current strength is strictly greater, update\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = current_extension_name\n\n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"\n    Checks if the second word or any of its cyclic rotations is a substring in the first word.\n    \"\"\"\n    if not b: # An empty pattern cannot be a substring\n        return False\n    if not a: # An empty text cannot contain any pattern\n        return False\n    if len(b) > len(a):\n        return False\n\n    # Generate all cyclic rotations of 'b'\n    b_extended = b + b\n    \n    # Check if any rotation is a substring of 'a'\n    for i in range(len(b)):\n        rotation = b_extended[i : i + len(b)]\n        if rotation in a:\n            return True\n            \n    return False"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    def _compute_strength(ext_name):\n        \"\"\"Calculates the strength of an extension name (CAP - SM).\"\"\"\n        cap_count = sum(1 for char in ext_name if 'A' <= char <= 'Z')\n        sm_count = sum(1 for char in ext_name if 'a' <= char <= 'z')\n        return cap_count - sm_count\n\n    strongest_extension_name = extensions[0]\n    max_strength = _compute_strength(extensions[0])\n\n    for i in range(1, len(extensions)):\n        current_extension_name = extensions[i]\n        current_strength = _compute_strength(current_extension_name)\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = current_extension_name\n\n    return f\"{class_name}.{strongest_extension_name}\""}
