{"task_id": "HumanEval/91", "solution": "import re\n\ndef is_bored(S):\n    \"\"\"\n    Counts the number of sentences that start with \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n    \"\"\"\n    if not S:\n        return 0\n\n    # Split the string into sentences using '.', '?', or '!' followed by optional whitespace as delimiters.\n    # re.split will remove the delimiters from the resulting list of strings.\n    sentences = re.split(r'[.!?]\\s*', S)\n\n    boredom_count = 0\n    for sentence in sentences:\n        # Strip leading/trailing whitespace from the potential sentence fragment.\n        cleaned_sentence = sentence.strip()\n        # Count if the cleaned sentence starts with the capital letter 'I'.\n        if cleaned_sentence.startswith(\"I\"):\n            boredom_count += 1\n            \n    return boredom_count"}
{"task_id": "HumanEval/91", "solution": "import re\n\ndef is_bored(S):\n    \"\"\"\n    Counts sentences starting with \"I\", delimited by '.', '?' or '!'.\n    Sentences are trimmed before checking the first word.\n    \"\"\"\n    if S is None:\n        raise ValueError(\"Input text cannot be None\")\n\n    boredom_count = 0\n    # Split the string by any of the delimiters, keeping the parts in between.\n    # re.split will discard the delimiters themselves.\n    # The pattern r'[.?!]' means split by '.', '?', or '!'.\n    sentences_raw = re.split(r'[.?!]', S)\n\n    for sentence_part in sentences_raw:\n        # Strip leading/trailing whitespace from each part.\n        stripped_sentence = sentence_part.strip()\n        # A boredom is a non-empty sentence that starts with \"I\".\n        if stripped_sentence and stripped_sentence.startswith(\"I\"):\n            boredom_count += 1\n            \n    return boredom_count"}
