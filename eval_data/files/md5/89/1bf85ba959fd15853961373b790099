{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or \n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    \n    # Define a small tolerance for floating-point comparisons\n    TOLERANCE = 1e-9\n\n    def is_close(val1, val2, tol=TOLERANCE):\n        \"\"\"Compares two float values for approximate equality.\"\"\"\n        return abs(val1 - val2) < tol\n\n    # Sort the sides to easily identify the two shorter sides and the hypotenuse.\n    sides = sorted([a, b, c])\n    side1, side2, hypotenuse = sides[0], sides[1], sides[2]\n\n    # Check if the square of the hypotenuse is approximately equal to the sum of the squares of the other two sides.\n    return is_close(hypotenuse**2, side1**2 + side2**2)"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"\n    Finds the word with the maximum number of unique characters.\n    In case of a tie, the lexicographically smallest word is returned.\n    \"\"\"\n    best_word = words[0]\n    max_unique_count = len(set(words[0]))\n\n    for i in range(1, len(words)):\n        current_word = words[i]\n        current_unique_count = len(set(current_word))\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            best_word = current_word\n        elif current_unique_count == max_unique_count:\n            # If counts are equal, choose the lexicographically smaller word\n            if current_word < best_word:\n                best_word = current_word\n    \n    return best_word"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"\n    Finds the word with the maximum number of unique characters.\n    In case of a tie, returns the lexicographically smallest word.\n    \"\"\"\n    max_unique_chars_found = -1\n    current_best_word = \"\"\n\n    for word in words:\n        current_word_unique_chars = len(set(word))\n\n        if current_word_unique_chars > max_unique_chars_found:\n            max_unique_chars_found = current_word_unique_chars\n            current_best_word = word\n        elif current_word_unique_chars == max_unique_chars_found:\n            # If unique character count is the same, apply lexicographical tie-breaking.\n            if word < current_best_word:\n                current_best_word = word\n    \n    return current_best_word"}
