{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    # Check for divisors from 3 up to sqrt(n), skipping even numbers\n    limit = int(n**0.5) + 1\n    for i in range(3, limit, 2):\n        if n % i == 0:\n            return False\n    return True"}
{"task_id": "HumanEval/32", "solution": "    TOLERANCE = 1e-10\n    MAX_ITER = 1000\n\n    # Find initial bounds [a, b] with opposite signs using an expanding interval.\n    # The odd degree polynomial (due to even len(xs)) guarantees a real root exists.\n    limit = 1.0\n    a, b = -limit, limit\n    fa, fb = poly(xs, a), poly(xs, b)\n\n    # Check if a root is exactly at the initial bounds\n    if abs(fa) < TOLERANCE:\n        return a\n    if abs(fb) < TOLERANCE:\n        return b\n\n    # Expand interval until poly(a) and poly(b) have opposite signs\n    while fa * fb > 0 and limit < 1e18:  # Upper bound for limit to prevent infinite loops\n        limit *= 2\n        a, b = -limit, limit\n        fa, fb = poly(xs, a), poly(xs, b)\n        if abs(fa) < TOLERANCE: return a\n        if abs(fb) < TOLERANCE: return b\n    \n    # Perform bisection method\n    for _ in range(MAX_ITER):\n        mid = (a + b) / 2\n        fm = poly(xs, mid)\n\n        if abs(fm) < TOLERANCE:\n            return mid\n\n        if fa * fm < 0:\n            b = mid\n            fb = fm\n        else:\n            a = mid\n            fa = fm\n    \n    # Return the midpoint of the final interval if max iterations reached.\n    return (a + b) / 2"}
{"task_id": "HumanEval/32", "solution": "    # Implements a bisection method to find a real root of the polynomial.\n    # The search interval is initialized to [-10, 10] as per design context,\n    # and a solution is guaranteed for the given input constraints.\n    lo, hi = -10.0, 10.0\n    tolerance = 1e-7  # A common tolerance for bisection convergence.\n    max_iterations = 100  # Maximum iterations to ensure convergence or reasonable termination.\n\n    p_lo = poly(xs, lo)\n    p_hi = poly(xs, hi)\n\n    # If the interval bounds are already very close to a root, return them.\n    if abs(p_lo) < tolerance:\n        return lo\n    if abs(p_hi) < tolerance:\n        return hi\n\n    for _ in range(max_iterations):\n        mid = (lo + hi) / 2\n        p_mid = poly(xs, mid)\n\n        if abs(p_mid) < tolerance:\n            return mid\n\n        # Determine which half of the interval contains a sign change.\n        if p_lo * p_mid < 0:\n            hi = mid\n            p_hi = p_mid  # Update p_hi to avoid re-evaluating poly(hi)\n        else:\n            lo = mid\n            p_lo = p_mid  # Update p_lo to avoid re-evaluating poly(lo)\n\n    # After max_iterations, return the midpoint of the final interval.\n    # This interval should be sufficiently small to approximate a root.\n    return (lo + hi) / 2"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    if not l:\n        return []\n\n    # Create a mutable copy of the input list.\n    result = list(l)\n\n    # Collect values at indices divisible by three.\n    third_elements = []\n    for i in range(len(l)):\n        if i % 3 == 0:\n            third_elements.append(l[i])\n\n    # Sort the collected elements.\n    third_elements.sort()\n\n    # Place the sorted elements back into the result list at their original positions.\n    sorted_idx = 0\n    for i in range(len(l)):\n        if i % 3 == 0:\n            result[i] = third_elements[sorted_idx]\n            sorted_idx += 1\n            \n    return result"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    result = l.copy()\n    \n    indices_to_sort = [i for i in range(len(l)) if i % 3 == 0]\n    values_to_sort = [l[i] for i in indices_to_sort]\n    \n    sorted_values = sorted(values_to_sort)\n    \n    for i, val in zip(indices_to_sort, sorted_values):\n        result[i] = val\n        \n    return result"}
