{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"It is the last week of the semester and the teacher has to give the grades\n    to students. The teacher has been making her own algorithm for grading.\n    The only problem is, she has lost the code she used for grading.\n    She has given you a list of GPAs for some students and you have to write \n    a function that can output a list of letter grades using the following table:\n             GPA       |    Letter grade\n              4.0                A+\n            > 3.7                A \n            > 3.3                A- \n            > 3.0                B+\n            > 2.7                B \n            > 2.3                B-\n            > 2.0                C+\n            > 1.7                C\n            > 1.3                C-\n            > 1.0                D+ \n            > 0.7                D \n            > 0.0                D-\n              0.0                E\n    \n\n    Example:\n    grade_equation([4.0, 3, 1.7, 2, 3.5]) ==> ['A+', 'B', 'C-', 'C', 'A-']\n    \"\"\"\n    result_grades = []\n    for gpa_value in grades:\n        # Round GPA to one decimal place before comparison, as per design context.\n        rounded_gpa = round(float(gpa_value), 1)\n\n        if rounded_gpa == 4.0:\n            result_grades.append(\"A+\")\n        elif rounded_gpa > 3.7:\n            result_grades.append(\"A\")\n        elif rounded_gpa > 3.3:\n            result_grades.append(\"A-\")\n        elif rounded_gpa > 3.0:\n            result_grades.append(\"B+\")\n        elif rounded_gpa > 2.7:\n            result_grades.append(\"B\")\n        elif rounded_gpa > 2.3:\n            result_grades.append(\"B-\")\n        elif rounded_gpa > 2.0:\n            result_grades.append(\"C+\")\n        elif rounded_gpa > 1.7:\n            result_grades.append(\"C\")\n        elif rounded_gpa > 1.3:\n            result_grades.append(\"C-\")\n        elif rounded_gpa > 1.0:\n            result_grades.append(\"D+\")\n        elif rounded_gpa > 0.7:\n            result_grades.append(\"D\")\n        elif rounded_gpa > 0.0:\n            result_grades.append(\"D-\")\n        else:  # This condition covers rounded_gpa == 0.0\n            result_grades.append(\"E\")\n    return result_grades"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"Converts a list of numerical GPAs into a list of corresponding letter grades\n    based on a predefined grading scale, with GPAs rounded to two decimal places.\n    \"\"\"\n    letter_grades = []\n    for gpa_raw in grades:\n        gpa = round(gpa_raw, 2) # Round GPA to two decimal places before comparison.\n\n        if gpa == 4.0:\n            letter = 'A+'\n        elif gpa > 3.7:\n            letter = 'A'\n        elif gpa > 3.3:\n            letter = 'A-'\n        elif gpa > 3.0:\n            letter = 'B+'\n        elif gpa > 2.7:\n            letter = 'B'\n        elif gpa > 2.3:\n            letter = 'B-'\n        elif gpa > 2.0:\n            letter = 'C+'\n        elif gpa > 1.7:\n            letter = 'C'\n        elif gpa > 1.3:\n            letter = 'C-'\n        elif gpa > 1.0:\n            letter = 'D+'\n        elif gpa > 0.7:\n            letter = 'D'\n        elif gpa > 0.0:\n            letter = 'D-'\n        elif gpa == 0.0:\n            letter = 'E'\n        else: # Handle GPAs less than 0.0 as the lowest grade.\n            letter = 'E'\n        letter_grades.append(letter)\n    return letter_grades"}
{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"Checks if the length of the string is a prime number.\"\"\"\n    def is_prime(n: int) -> bool:\n        \"\"\"Return True if n is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    length = len(string)\n    return is_prime(length)"}
{"task_id": "HumanEval/82", "solution": "import math\n\ndef prime_length(string):\n    \"\"\"\n    Returns True if the string's length is a prime number, False otherwise.\n    Includes an inline helper function for primality testing.\n    \"\"\"\n    def _is_prime(n: int) -> bool:\n        \"\"\"Determines if an integer n is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    return _is_prime(len(string))"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    if n == 1:\n        return 1\n    # For n > 1:\n    # Numbers starting with 1: 1 followed by (n-1) digits (10^(n-1) options)\n    # Numbers ending with 1: (n-1) digits followed by 1 (9*10^(n-2) options, as first digit cannot be 0)\n    # Numbers starting AND ending with 1: 1 followed by (n-2) digits followed by 1 (10^(n-2) options)\n    # Using inclusion-exclusion: P(start with 1) + P(end with 1) - P(start AND end with 1)\n    # 10**(n - 1) + 9 * (10**(n - 2)) - 10**(n - 2)\n    # = 10**(n - 1) + 8 * (10**(n - 2))\n    return pow(10, n - 1) + 8 * pow(10, n - 2)"}
{"task_id": "HumanEval/83", "solution": "    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    if n == 1:\n        return 1\n    # For n > 1, use the Principle of Inclusion-Exclusion.\n    # Count of numbers starting with 1: 10**(n-1)\n    # Count of numbers ending with 1: 9 * 10**(n-2) (first digit cannot be 0)\n    # Count of numbers starting AND ending with 1: 1 * 10**(n-2)\n    return 10**(n - 1) + 8 * 10**(n - 2)"}
