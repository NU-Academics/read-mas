{"task_id": "HumanEval/115", "solution": "import math\n\ndef max_fill(grid, capacity):\n    \"\"\"\n    Calculates the minimum number of times buckets need to be lowered to empty all wells.\n    Iterates through each well, counts water, and applies bucket capacity to find drops.\n    \"\"\"\n    total_drops = 0\n    for well_row in grid:\n        water_in_well = sum(well_row)\n        if water_in_well > 0:\n            drops_for_well = math.ceil(water_in_well / capacity)\n            total_drops += drops_for_well\n    return total_drops"}
{"task_id": "HumanEval/116", "solution": "def sort_array(arr):\n    \"\"\"\n    Sorts an array of integers by the number of ones in their binary representation,\n    then by decimal value for ties. Negative numbers are sorted by decimal value only.\n    \"\"\"\n\n    def count_ones(n: int) -> int:\n        \"\"\"\n        Counts the set bits for non-negative integers.\n        For negative numbers, returns 0 as per design.\n        \"\"\"\n        if n < 0:\n            return 0\n        return bin(n).count('1')\n\n    def sorting_key(n: int):\n        \"\"\"\n        Generates a tuple key for sorting.\n        Primary key: number of ones (or 0 for negatives).\n        Secondary key: the decimal value of the number itself.\n        \"\"\"\n        return (count_ones(n), n)\n\n    return sorted(arr, key=sorting_key)"}
{"task_id": "HumanEval/116", "solution": "```python\ndef sort_array(arr):\n    \"\"\"\n    Sorts an array of integers by the number of set bits in their binary representation,\n    then by decimal value for ties. Negative numbers are treated as 32-bit two's complement.\n    \"\"\"\n    def count_ones(n):\n        if n >= 0:\n            return bin(n).count('1')\n        else:\n            # For negative numbers, use 32-bit two's complement representation\n            return bin(n & 0xFFFFFFFF).count('1')\n\n    return sorted(arr, key=lambda x: (count_ones(x), x))\n```"}
{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"Returns a list of words from string s that contain exactly n consonants.\"\"\"\n\n    def is_consonant(char):\n        \"\"\"Checks if a character is a consonant.\"\"\"\n        return char.isalpha() and char.lower() not in 'aeiou'\n\n    def count_consonants(word):\n        \"\"\"Counts the number of consonants in a given word.\"\"\"\n        count = 0\n        for char in word:\n            if is_consonant(char):\n                count += 1\n        return count\n\n    if not s:\n        return []\n\n    words = s.split()\n    result = []\n    for word in words:\n        if count_consonants(word) == n:\n            result.append(word)\n    return result"}
{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"Given a string s and a natural number n, you have been tasked to implement \n    a function that returns a list of all words from string s that contain exactly \n    n consonants, in order these words appear in the string s.\n    If the string s is empty then the function should return an empty list.\n    \"\"\"\n\n    if not s:\n        return []\n\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    def count_consonants(word):\n        \"\"\"Counts consonants in a given word, treating 'y' as a consonant.\"\"\"\n        consonant_count = 0\n        for char in word:\n            lower_char = char.lower()\n            if lower_char.isalpha() and lower_char not in VOWELS:\n                consonant_count += 1\n        return consonant_count\n\n    result = []\n    words = s.split()\n\n    for word in words:\n        if count_consonants(word) == n:\n            result.append(word)\n\n    return result"}
{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"Finds the closest vowel surrounded by two consonants from the right side of the word.\"\"\"\n\n    VOWELS = {'A', 'E', 'I', 'O', 'U', 'a', 'e', 'i', 'o', 'u'}\n\n    def is_vowel(char):\n        return char in VOWELS\n\n    def is_consonant(char):\n        return char.isalpha() and char not in VOWELS\n\n    # Scan from right to left.\n    # The loop iterates from the second-to-last character (index len(word) - 2)\n    # down to the second character (index 1), inclusive.\n    # This automatically ignores potential vowels at the very beginning or end of the word.\n    for i in range(len(word) - 2, 0, -1):\n        ch = word[i]\n        if is_vowel(ch):\n            left_neighbor = word[i - 1]\n            right_neighbor = word[i + 1]\n\n            # Check if both neighbors are consonants.\n            if is_consonant(left_neighbor) and is_consonant(right_neighbor):\n                return ch\n    return \"\""}
{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"Finds the closest vowel that stands between two consonants from the right side.\"\"\"\n    \n    def is_vowel(char):\n        \"\"\"Checks if a character is an English vowel (case-sensitive).\"\"\"\n        return char in \"aeiouAEIOU\"\n\n    def is_consonant(char):\n        \"\"\"Checks if a character is an English consonant (case-sensitive).\"\"\"\n        return char.isalpha() and not is_vowel(char)\n\n    if len(word) < 3:\n        return \"\"\n\n    # Iterate from the second-to-last character down to the second character.\n    # This range excludes the first and last characters of the word.\n    for i in range(len(word) - 2, 0, -1):\n        current_char = word[i]\n        \n        if is_vowel(current_char):\n            left_char = word[i - 1]\n            right_char = word[i + 1]\n            \n            if is_consonant(left_char) and is_consonant(right_char):\n                return current_char\n                \n    return \"\""}
{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    '''\n    Checks if concatenating two strings in any order results in balanced parentheses.\n    '''\n    def is_balanced(s):\n        \"\"\"Checks if a given string of parentheses is balanced.\"\"\"\n        count = 0\n        for char in s:\n            if char == '(':\n                count += 1\n            else:  # char == ')'\n                count -= 1\n                if count < 0:\n                    return False\n        return count == 0\n\n    s1, s2 = lst\n    \n    # Try the first order: s1 + s2\n    if is_balanced(s1 + s2):\n        return 'Yes'\n    \n    # Try the second order: s2 + s1\n    if is_balanced(s2 + s1):\n        return 'Yes'\n        \n    return 'No'"}
{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    '''\n    Checks if it's possible to concatenate two strings in some order\n    to form a balanced parentheses string.\n    '''\n    def is_balanced(s):\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            else:  # char == ')'\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    s1, s2 = lst\n\n    if is_balanced(s1 + s2) or is_balanced(s2 + s1):\n        return 'Yes'\n    else:\n        return 'No'"}
{"task_id": "HumanEval/120", "solution": "import heapq\n\ndef maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a positive integer k, return a sorted list \n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    if k == 0:\n        return []\n\n    min_heap = []\n    for num in arr:\n        if len(min_heap) < k:\n            heapq.heappush(min_heap, num)\n        elif num > min_heap[0]:\n            heapq.heapreplace(min_heap, num)\n            \n    min_heap.sort()\n    return min_heap"}
