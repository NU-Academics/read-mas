{"task_id": "HumanEval/85", "solution": "def add(lst):\n    \"\"\"Given a non-empty list of integers lst. add the even elements that are at odd indices..\"\"\"\n    def is_even(n: int) -> bool:\n        \"\"\"Checks if a number is even.\"\"\"\n        return n % 2 == 0\n\n    def is_odd_index(idx: int) -> bool:\n        \"\"\"Checks if an index is odd.\"\"\"\n        return idx % 2 == 1\n\n    total = 0\n    for idx, val in enumerate(lst):\n        if is_odd_index(idx) and is_even(val):\n            total += val\n    return total"}
{"task_id": "HumanEval/86", "solution": "import re\n\ndef anti_shuffle(s):\n    \"\"\"\n    Returns an ordered version of a string where all words have their characters\n    arranged in ascending order based on ascii value, preserving word order and spaces.\n    \"\"\"\n    parts = re.split(r'(\\s+)', s)\n    processed_parts = []\n    for part in parts:\n        if part.isspace():\n            processed_parts.append(part)\n        else:\n            processed_parts.append(\"\".join(sorted(part)))\n    return \"\".join(processed_parts)"}
{"task_id": "HumanEval/86", "solution": "import re\n\ndef anti_shuffle(s):\n    \"\"\"\n    Sorts characters within each word of a string based on ASCII value,\n    preserving word order and blank spaces.\n    \"\"\"\n    if not s:\n        return \"\"\n\n    # Split the string into segments of non-whitespace (words) and whitespace.\n    # This regex ensures that both words and sequences of spaces are captured\n    # as separate items in the list, preserving their original order.\n    segments = re.findall(r'(\\S+|\\s+)', s)\n\n    result_segments = []\n    for segment in segments:\n        if segment.isspace():\n            # If the segment is entirely whitespace, keep it as is.\n            result_segments.append(segment)\n        else:\n            # If it's a non-whitespace segment (a word), sort its characters\n            # based on ASCII value.\n            result_segments.append(\"\".join(sorted(segment)))\n                \n    return \"\".join(result_segments)"}
{"task_id": "HumanEval/87", "solution": "```python\ndef get_row(lst, x):\n    \"\"\"\n    Finds occurrences of x in a 2D list and returns their coordinates.\n    Coordinates are sorted by row ascending, then column descending.\n    \"\"\"\n    coordinates = []\n    for r_idx, row in enumerate(lst):\n        for c_idx, val in enumerate(row):\n            if val == x:\n                coordinates.append((r_idx, c_idx))\n\n    # Sort coordinates by row ascending, then column descending\n    coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n\n    return coordinates\n```"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds integer x in the 2D list and returns a list of its coordinates (row, column).\n    Coordinates are sorted by row ascending, then by column descending.\n    \"\"\"\n    coordinates = []\n    for r_idx, row in enumerate(lst):\n        for c_idx, val in enumerate(row):\n            if val == x:\n                coordinates.append((r_idx, c_idx))\n\n    # Sort coordinates: first by row in ascending order (coord[0]),\n    # then by column in descending order (-coord[1]).\n    coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n\n    return coordinates"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n\n    Note:\n    * don't change the given array.\n\n    Examples:\n    * sort_array([]) => []\n    * sort_array([5]) => [5]\n    * sort_array([2, 4, 3, 0, 1, 5]) => [0, 1, 2, 3, 4, 5]\n    * sort_array([2, 4, 3, 0, 1, 5, 6]) => [6, 5, 4, 3, 2, 1, 0]\n    \"\"\"\n    if not array:\n        return []\n\n    # Calculate the sum of the first and last elements\n    first_element = array[0]\n    last_element = array[-1]\n    elements_sum = first_element + last_element\n\n    # Determine sorting order based on the sum's parity\n    if elements_sum % 2 == 1:  # Odd sum: sort in ascending order\n        return sorted(array)\n    else:  # Even sum: sort in descending order\n        return sorted(array, reverse=True)"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n    \"\"\"\n    if not array:\n        return []\n    if len(array) == 1:\n        return list(array)\n\n    # Determine sorting order based on the sum of the first and last elements\n    first_val = array[0]\n    last_val = array[-1]\n    sum_first_last = first_val + last_val\n\n    # If the sum is odd, sort ascending (reverse=False)\n    # If the sum is even, sort descending (reverse=True)\n    reverse_order = (sum_first_last % 2 == 0)\n\n    # Return a new sorted list, ensuring the original array is not modified\n    return sorted(list(array), reverse=reverse_order)"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by shifting each lowercase alphabetic character forward by 4 positions.\"\"\"\n    result = []\n    for char in s:\n        # Calculate the 0-based index of the character (0 for 'a', 1 for 'b', etc.)\n        char_index = ord(char) - ord('a')\n        # Apply the shift and wrap around using modulo 26\n        shifted_index = (char_index + 4) % 26\n        # Convert the new index back to a character\n        shifted_char = chr(shifted_index + ord('a'))\n        result.append(shifted_char)\n    return \"\".join(result)"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by shifting each lowercase alphabetic character by 4 positions.\"\"\"\n    result = []\n    for char in s:\n        if 'a' <= char <= 'z':\n            # Calculate the shifted position, handling wrap-around from 'z' to 'a'\n            shifted_char_code = ord('a') + (ord(char) - ord('a') + 4) % 26\n            result.append(chr(shifted_char_code))\n        else:\n            # Non-alphabetic characters are left unchanged\n            result.append(char)\n    return \"\".join(result)"}
