{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    def factorial(k):\n        \"\"\"Return k! for a non-negative integer k.\"\"\"\n        res = 1\n        for i in range(2, k + 1):\n            res *= i\n        return res\n\n    total = 1\n    for i in range(1, n + 1):\n        total *= factorial(i)\n    return total"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    def _factorial(k):\n        \"\"\"Calculates the standard factorial of k.\"\"\"\n        product = 1\n        for j in range(1, k + 1):\n            product *= j\n        return product\n\n    brazilian_fact_result = 1\n    for i in range(1, n + 1):\n        brazilian_fact_result *= _factorial(i)\n    return brazilian_fact_result"}
{"task_id": "HumanEval/140", "solution": "def fix_spaces(text):\n    \"\"\"\n    Replaces spaces in a string: single spaces become underscores,\n    and three or more consecutive spaces become a single hyphen.\n    \"\"\"\n    result = []\n    space_count = 0\n    for ch in text:\n        if ch == \" \":\n            space_count += 1\n        else:\n            if space_count >= 3:\n                result.append(\"-\")\n            elif space_count == 2:\n                result.extend([\"_\", \"_\"])\n            elif space_count == 1:\n                result.append(\"_\")\n            space_count = 0\n            result.append(ch)\n    \n    # Handle any trailing spaces\n    if space_count >= 3:\n        result.append(\"-\")\n    elif space_count == 2:\n        result.extend([\"_\", \"_\"])\n    elif space_count == 1:\n        result.append(\"_\")\n        \n    return \"\".join(result)"}
{"task_id": "HumanEval/140", "solution": "import re\n\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores, \n    and if a string has more than 2 consecutive spaces, \n    then replace all consecutive spaces with -\n    \"\"\"\n    # First, replace sequences of three or more consecutive spaces with a single hyphen.\n    # The regex r' {3,}' matches three or more space characters.\n    text = re.sub(r' {3,}', '-', text)\n\n    # Second, replace any remaining single space characters with an underscore.\n    # At this stage, any remaining ' ' must be a single space (or part of a two-space sequence\n    # which effectively becomes two underscores, like \"  \" -> \"__\").\n    text = re.sub(r' ', '_', text)\n\n    return text"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Checks if a file name is valid based on specific rules.\"\"\"\n    \n    # Condition 1: Check for exactly one dot\n    if file_name.count('.') != 1:\n        return 'No'\n\n    parts = file_name.split('.')\n    prefix = parts[0]\n    suffix = parts[1]\n\n    # Condition 2: Check for not more than three digits\n    digit_count = sum(1 for char in file_name if '0' <= char <= '9')\n    if digit_count > 3:\n        return 'No'\n\n    # Condition 3: Substring before the dot should not be empty and start with a letter\n    if not prefix or not prefix[0].isalpha():\n        return 'No'\n\n    # Condition 4: Substring after the dot should be one of ['txt', 'exe', 'dll']\n    allowed_suffixes = ['txt', 'exe', 'dll']\n    if suffix not in allowed_suffixes:\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/141", "solution": "```python\ndef file_name_check(file_name):\n    \"\"\"Checks if a file's name is valid according to specific rules.\"\"\"\n    \n    # Rule 1: There should not be more than three digits ('0'-'9') in the file's name.\n    digit_count = 0\n    for char in file_name:\n        if '0' <= char <= '9':\n            digit_count += 1\n    if digit_count > 3:\n        return 'No'\n\n    # Rule 2: The file's name contains exactly one dot '.'\n    if file_name.count('.') != 1:\n        return 'No'\n\n    # Split the file name into name and extension parts\n    parts = file_name.split('.')\n    name_part = parts[0]\n    ext_part = parts[1]\n\n    # Rule 3: The substring before the dot should not be empty, and it starts with a letter.\n    if not name_part:  # Check if the name part is empty\n        return 'No'\n    # Check if the first character is a latin alphabet letter\n    if not ('a' <= name_part[0] <= 'z' or 'A' <= name_part[0] <= 'Z'):\n        return 'No'\n\n    # Rule 4: The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    allowed_extensions = ['txt', 'exe', 'dll']\n    if ext_part not in allowed_extensions:\n        return 'No'\n\n    # If all conditions are met\n    return 'Yes'\n```"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    Squares integer entries if their index is a multiple of 3, cubes entries\n    if their index is a multiple of 4 and not 3, then returns the sum.\n    \"\"\"\n    total_sum = 0\n    for i, num in enumerate(lst):\n        if i % 3 == 0:\n            total_sum += num ** 2\n        elif i % 4 == 0:  # This condition implies i % 3 != 0 due to the 'elif'\n            total_sum += num ** 3\n        else:\n            total_sum += num\n    return total_sum"}
