{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Filters words from a sentence, returning only those whose lengths are prime numbers.\n    The order of words is preserved.\n    \"\"\"\n    def is_prime(n):\n        \"\"\"Checks if a number is prime.\"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    words = sentence.split(\" \")\n    prime_words = []\n    for word in words:\n        if is_prime(len(word)):\n            prime_words.append(word)\n    return \" \".join(prime_words)"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Returns a string containing words from the original sentence whose lengths are prime numbers.\n    The order of words is preserved.\n    \"\"\"\n    def _is_prime(n):\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    words = sentence.split(\" \")\n    prime_length_words = [word for word in words if _is_prime(len(word))]\n    return \" \".join(prime_length_words)"}
{"task_id": "HumanEval/144", "solution": "import math\n\ndef simplify(x, n):\n    \"\"\"\n    Checks if the product of two fraction strings x and n evaluates to a whole number.\n    Fractions are in \"numerator/denominator\" format.\n    \"\"\"\n\n    def _gcd(a, b):\n        \"\"\"Calculates the greatest common divisor of two integers.\"\"\"\n        while b:\n            a, b = b, a % b\n        return a\n\n    class _Fraction:\n        \"\"\"Represents a rational number and provides arithmetic helpers.\"\"\"\n        def __init__(self, numerator, denominator):\n            self.numerator = numerator\n            self.denominator = denominator\n\n        @classmethod\n        def parse(cls, s: str) -> \"F_Fraction\":\n            \"\"\"Parses a string like '3/4' into a _Fraction.\"\"\"\n            num_str, den_str = s.split(\"/\")\n            return cls(int(num_str), int(den_str))\n\n        def reduce(self) -> \"F_Fraction\":\n            \"\"\"Divides numerator and denominator by their GCD.\"\"\"\n            common = _gcd(self.numerator, self.denominator)\n            return _Fraction(self.numerator // common, self.denominator // common)\n\n        def multiply(self, other: \"F_Fraction\") -> \"F_Fraction\":\n            \"\"\"Multiplies this fraction by another fraction.\"\"\"\n            new_numerator = self.numerator * other.numerator\n            new_denominator = self.denominator * other.denominator\n            return _Fraction(new_numerator, new_denominator)\n\n    # Core logic from SimplifierService.is_product_whole\n    fx = _Fraction.parse(x)\n    fn = _Fraction.parse(n)\n    \n    product = fx.multiply(fn).reduce()\n    \n    return product.denominator == 1"}
{"task_id": "HumanEval/144", "solution": "def simplify(x, n):\n    \"\"\"Checks if the product of two fractions, x and n, is a whole number.\n\n    Args:\n        x: A string representation of the first fraction (e.g., \"1/2\").\n        n: A string representation of the second fraction (e.g., \"3/4\").\n\n    Returns:\n        True if x * n evaluates to a whole number, False otherwise.\n    \"\"\"\n    \n    # Parse the first fraction x\n    num1_str, den1_str = x.split('/')\n    num1 = int(num1_str)\n    den1 = int(den1_str)\n\n    # Parse the second fraction n\n    num2_str, den2_str = n.split('/')\n    num2 = int(num2_str)\n    den2 = int(den2_str)\n\n    # Multiply the fractions\n    product_numerator = num1 * num2\n    product_denominator = den1 * den2\n\n    # Check if the product is a whole number\n    return product_numerator % product_denominator == 0"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers based on the sum of their digits,\n    using the original index for tie-breaking.\n    \"\"\"\n\n    def _calculate_digit_sum(n):\n        \"\"\"Calculates the sum of digits for an integer's absolute value.\"\"\"\n        return sum(int(digit) for digit in str(abs(n)))\n\n    # Create a list of tuples: (digit_sum, original_index, number)\n    # The original_index ensures stable sorting when digit_sums are equal.\n    decorated_list = []\n    for i, num in enumerate(nums):\n        digit_sum = _calculate_digit_sum(num)\n        decorated_list.append((digit_sum, i, num))\n\n    # Sort the decorated list. Python's list.sort() is stable.\n    # It sorts primarily by digit_sum, then by original_index.\n    decorated_list.sort()\n\n    # Extract the original numbers from the sorted list\n    return [item[2] for item in decorated_list]"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts the given list of integers by the sum of their digits,\n    maintaining original order for items with similar digit sums.\n    \"\"\"\n\n    def digit_sum(number):\n        \"\"\"Calculates the sum of the absolute digits of a number.\"\"\"\n        return sum(int(d) for d in str(abs(number)))\n\n    class SortableItem:\n        \"\"\"Helper class to store value, digit sum, and original index for sorting.\"\"\"\n        def __init__(self, value, digit_sum_val, original_index):\n            self.value = value\n            self.digit_sum = digit_sum_val\n            self.index = original_index\n\n        def __lt__(self, other):\n            # Compare by digit_sum primarily\n            if self.digit_sum != other.digit_sum:\n                return self.digit_sum < other.digit_sum\n            # If digit_sums are equal, compare by original index for stability\n            return self.index < other.index\n\n    if not nums:\n        return []\n\n    items = [SortableItem(num, digit_sum(num), i) for i, num in enumerate(nums)]\n    items.sort()  # Uses the custom __lt__ method\n\n    return [item.value for item in items]"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"\n    Counts elements greater than 10 where the first and last digits are odd.\n    Digits are extracted from the absolute value of the number.\n    \"\"\"\n\n    def _is_odd_digit(digit: int) -> bool:\n        \"\"\"Checks if a given digit (0-9) is odd.\"\"\"\n        return digit in {1, 3, 5, 7, 9}\n\n    def _get_last_digit(number: int) -> int:\n        \"\"\"Extracts the last digit of a number, ignoring its sign.\"\"\"\n        return abs(number) % 10\n\n    def _get_first_digit(number: int) -> int:\n        \"\"\"Extracts the first digit of a number, ignoring its sign.\"\"\"\n        num_abs = abs(number)\n        while num_abs >= 10:\n            num_abs //= 10\n        return num_abs\n\n    count = 0\n    for num in nums:\n        if num <= 10:\n            continue\n\n        first_digit = _get_first_digit(num)\n        last_digit = _get_last_digit(num)\n\n        if _is_odd_digit(first_digit) and _is_odd_digit(last_digit):\n            count += 1\n            \n    return count"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"\n    Returns the count of elements greater than 10 with odd first and last digits.\n    Digits are checked on the absolute value of the number.\n    \"\"\"\n\n    def _is_odd_digit(d):\n        \"\"\"Checks if a given digit is odd.\"\"\"\n        return d in {1, 3, 5, 7, 9}\n\n    count = 0\n    for n in nums:\n        if n <= 10:\n            continue\n\n        # Extract digits from the absolute value of the number\n        s_n = str(abs(n))\n        first_digit_val = int(s_n[0])\n        last_digit_val = int(s_n[-1])\n\n        if _is_odd_digit(first_digit_val) and _is_odd_digit(last_digit_val):\n            count += 1\n    return count"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Counts the number of triples (a[i], a[j], a[k]) from the generated array a\n    where i < j < k and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n    \n    def combinations(n_val, k_val):\n        if k_val < 0 or k_val > n_val:\n            return 0\n        if k_val == 0 or k_val == n_val:\n            return 1\n        if k_val > n_val // 2:\n            k_val = n_val - k_val\n        \n        res = 1\n        for i in range(k_val):\n            res = res * (n_val - i) // (i + 1)\n        return res\n\n    # Count elements based on their value modulo 3\n    # The value a[x] = x*x - x + 1 (for 1-based x) has the following pattern modulo 3:\n    # If x % 3 == 0, a[x] % 3 == 1\n    # If x % 3 == 1, a[x] % 3 == 1\n    # If x % 3 == 2, a[x] % 3 == 0\n\n    # For 0-based index `idx` (corresponding to 1-based `idx+1`):\n    # a[idx] = (idx+1)*(idx+1) - (idx+1) + 1\n    # If (idx+1) % 3 == 0  => idx % 3 == 2 => a[idx] % 3 == 1\n    # If (idx+1) % 3 == 1  => idx % 3 == 0 => a[idx] % 3 == 1\n    # If (idx+1) % 3 == 2  => idx % 3 == 1 => a[idx] % 3 == 0\n\n    # Simplified pattern for arr[idx] % 3 based on idx % 3:\n    # If idx % 3 == 0, then a[idx] % 3 == 1\n    # If idx % 3 == 1, then a[idx] % 3 == 0\n    # If idx % 3 == 2, then a[idx] % 3 == 1\n\n    count_mod_0 = 0  # number of elements a[i] such that a[i] % 3 == 0\n    count_mod_1 = 0  # number of elements a[i] such that a[i] % 3 == 1\n\n    for idx in range(n):\n        if idx % 3 == 1:  # This corresponds to a[idx] % 3 == 0\n            count_mod_0 += 1\n        else:  # This corresponds to a[idx] % 3 == 1 (idx % 3 == 0 or idx % 3 == 2)\n            count_mod_1 += 1\n\n    # A sum a[i] + a[j] + a[k] is divisible by 3 if:\n    # 1. All three elements are 0 (mod 3) -> (0 + 0 + 0) % 3 == 0\n    # 2. All three elements are 1 (mod 3) -> (1 + 1 + 1) % 3 == 0\n    # (Note: no element can be 2 (mod 3) based on the derived pattern for a[i])\n\n    total_triples = combinations(count_mod_0, 3) + combinations(count_mod_1, 3)\n    \n    return total_triples"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) where i < j < k,\n    and a[i] + a[j] + a[k] is a multiple of 3, based on a[i] = i*i - i + 1.\n    \"\"\"\n    a = []\n    for i in range(1, n + 1):\n        a.append(i * i - i + 1)\n\n    count = 0\n    # Iterate through all possible triples (a[i], a[j], a[k]) such that i < j < k\n    # Using 0-based indexing for the list 'a'\n    for i in range(n - 2):\n        for j in range(i + 1, n - 1):\n            for k in range(j + 1, n):\n                # Check if the sum of the triple is a multiple of 3\n                if (a[i] + a[j] + a[k]) % 3 == 0:\n                    count += 1\n    return count"}
{"task_id": "HumanEval/148", "solution": "PLANETS = [\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"]\n\ndef bf(planet1, planet2):\n    \"\"\"\n    Returns a tuple of planets whose orbits are between planet1 and planet2,\n    sorted by proximity to the sun. Returns an empty tuple for invalid names.\n    \"\"\"\n    \n    # Normalize planet names to title case for lookup\n    normalized_planet1 = planet1.title()\n    normalized_planet2 = planet2.title()\n\n    if normalized_planet1 not in PLANETS or normalized_planet2 not in PLANETS:\n        return ()\n\n    idx1 = PLANETS.index(normalized_planet1)\n    idx2 = PLANETS.index(normalized_planet2)\n\n    if idx1 == idx2:\n        return ()\n\n    # Determine the start and end indices for slicing, ensuring correct order\n    start_idx = min(idx1, idx2)\n    end_idx = max(idx1, idx2)\n\n    # Slice the list to get planets between the two, exclusive of the two input planets\n    return tuple(PLANETS[start_idx + 1:end_idx])"}
{"task_id": "HumanEval/148", "solution": "PLANETS = (\n    \"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n)\n\ndef bf(planet1, planet2):\n    \"\"\"\n    Returns a tuple of planets located between planet1 and planet2, sorted by proximity to the sun.\n    Returns an empty tuple if planet1 or planet2 are not valid planet names.\n    \"\"\"\n    \n    planet_map = {planet.lower(): planet for planet in PLANETS}\n\n    p1_lower = planet1.lower()\n    p2_lower = planet2.lower()\n\n    if p1_lower not in planet_map or p2_lower not in planet_map:\n        return ()\n\n    idx1 = PLANETS.index(planet_map[p1_lower])\n    idx2 = PLANETS.index(planet_map[p2_lower])\n\n    start_idx, end_idx = sorted((idx1, idx2))\n\n    # Slice the tuple to get planets between (exclusive of start_idx and end_idx)\n    return PLANETS[start_idx + 1:end_idx]"}
