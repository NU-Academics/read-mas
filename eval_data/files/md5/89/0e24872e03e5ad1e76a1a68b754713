, y=1 if num2>=0, y=-1 if num2<0.\n            return (abs(num2), 0, 1 if num2 >= 0 else -1)\n        else:\n            # Recursive step\n            gcd, x, y = _extended_gcd(num2 % num1, num1)\n            # Ensure gcd is non-negative and adjust x, y accordingly if it became negative\n            if gcd < 0:\n                gcd = -gcd\n                x = -x\n                y = -y\n            return (gcd, y - (num2 // num1) * x, x)\n\n    # Calculate gcd(a, b) and initial x0, y0 such that a*x0 + b*y0 = gcd(a, b)\n    g, x0, y0 = _extended_gcd(a, b)\n\n    # Handle the special case where both a and b are zero\n    if g == 0:\n        if n == 0:\n            # If 0*x + 0*y = 0, any (x, y) is a solution, e.g., (0, 0)\n            return (0, 0)\n        else:\n            # If 0*x + 0*y = n where n != 0, no solution exists\n            return None\n\n    # Check if n is divisible by gcd(a, b)\n    if n % g != 0:\n        return None  # No integer solution exists\n\n    # Scale the particular solution by n/g\n    k = n // g\n    x = x0 * k\n    y = y0 * k\n    \n    return (x, y)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[2, 3, 7]], "plus_fail_tests": [[25, 10, 500]]}], "Mbpp/168": [{"task_id": "Mbpp/168", "solution": "def frequency(numbers: list[int], target: int) -> int:\n    \"\"\"\n    Counts the occurrences of a target number in a list.\n    Iterates through the list, incrementing a counter for each match.\n    \"\"\"\n    count = 0\n    for number in numbers:\n        if number == target:\n            count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/165": [{"task_id": "Mbpp/165", "solution": "def count_char_position(input_string: str) -> int:\n    \"\"\"Counts characters in a string matching their alphabetical position (case insensitive).\"\"\"\n\n    class Alphabet:\n        \"\"\"Manages the 1-based positions of English alphabet letters.\"\"\"\n      