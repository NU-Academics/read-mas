{"task_id": "Mbpp/643", "solution": "from typing import List\nfrom dataclasses import dataclass\n\n@dataclass\nclass Text:\n    content: str\n    length: int\n\n    def __post_init__(self):\n        self.length = len(self.content)\n\n@dataclass\nclass Word:\n    value: str\n    startIndex: int\n    endIndex: int\n\n@dataclass\nclass Character:\n    c: str\n    index: int\n\n@dataclass\nclass MatchResult:\n    matched: bool\n\nclass TextProcessor:\n    def isAlphabetic(self, c_obj: 'Character') -> bool:\n        \"\"\"Return True when c_obj.c is ASCII alphabetic A-Z or a-z; False otherwise.\"\"\"\n        c = c_obj.c\n        return ('a' <= c <= 'z') or ('A' <= c <= 'Z')\n\n    def tokenize(self, text: 'Text') -> List['Word']:\n        \"\"\"Split Text.content into Word tokens using ASCII alphabetic sequences; non-alphabetic chars are boundaries.\"\"\"\n        words = []\n        in_word = False\n        word_start_index = 0\n\n        for i in range(text.length):\n            char_obj = Character(c=text.content[i], index=i)\n            is_alpha = self.isAlphabetic(char_obj)\n\n            if is_alpha and not in_word:\n                word_start_index = i\n                in_word = True\n            elif not is_alpha and in_word:\n                word_value = text.content[word_start_index:i]\n                words.append(Word(value=word_value, startIndex=word_start_index, endIndex=i))\n                in_word = False\n        \n        if in_word: # Handle case where text ends with an alphabetic sequence\n            word_value = text.content[word_start_index:text.length]\n            words.append(Word(value=word_value, startIndex=word_start_index, endIndex=text.length))\n            \n        return words\n\n    def wordHasMiddleZ(self, word: 'Word') -> bool:\n        \"\"\"Return True if word.value contains at least one lowercase 'z' that is not the first or last character.\"\"\"\n        if len(word.value) < 3: # A middle 'z' requires at least 3 characters (e.g., \"azb\")\n            return False\n\n        for i in range(1, len(word.value) - 1): # Iterate from second character to second-to-last\n            if word.value[i] == 'z':\n                return True\n        return False\n\n    def text_match_wordz_middle(self, text: 'Text') -> 'MatchResult':\n        \"\"\"Tokenize and inspect words; return MatchResult(matched=True) if any Word satisfies wordHasMiddleZ; otherwise MatchResult(matched=False).\"\"\"\n        words = self.tokenize(text)\n        for word in words:\n            if self.wordHasMiddleZ(word):\n                return MatchResult(matched=True)\n        return MatchResult(matched=False)\n\ndef text_match_wordz_middle(text: str) -> bool:\n    \"\"\"Checks if a string contains 'z' except at the start and end of a word.\"\"\"\n    t = Text(content=text)\n    tp = TextProcessor()\n    result = tp.text_match_wordz_middle(t)\n    return result.matched"}
