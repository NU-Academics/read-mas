{"task_id": "Mbpp/7", "solution": "class InputString:\n    \"\"\"Encapsulates raw input text and provides tokenization.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\n    def getWords(self) -> list[str]:\n        \"\"\"Splits the text on whitespace and returns a list of tokens.\"\"\"\n        return self.text.split()\n\nclass Word:\n    \"\"\"Represents a single token and computes its character length.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the word string.\"\"\"\n        return len(self.text)\n\nclass WordCollection:\n    \"\"\"A container for Word objects that can filter them by minimum length.\"\"\"\n    def __init__(self, words: list[Word]):\n        self.words = words\n\n    def filterByMinLength(self, min_len: int) -> list[Word]:\n        \"\"\"Returns a list of Word objects whose length is at least min_len.\"\"\"\n        return [word for word in self.words if word.length() >= min_len]\n\nclass FindCharLong:\n    \"\"\"Orchestrates tokenization and filtering to return a list of qualifying token strings.\"\"\"\n    def find_char_long(self, text: str) -> list[str]:\n        \"\"\"Finds words at least 4 characters long from the input string.\"\"\"\n        input_string = InputString(text)\n        tokens = input_string.getWords()\n        \n        word_objects = [Word(token) for token in tokens]\n        word_collection = WordCollection(word_objects)\n        \n        filtered_words = word_collection.filterByMinLength(4)\n        \n        return [word.text for word in filtered_words]\n\ndef find_char_long(text: str) -> list[str]:\n    \"\"\"\n    Finds all words which are at least 4 characters long in a string.\n    Words are separated by whitespace, and original casing is preserved.\n    \"\"\"\n    orchestrator = FindCharLong()\n    return orchestrator.find_char_long(text)"}
{"task_id": "Mbpp/9", "solution": "class StringInput:\n    \"\"\"Wraps the input string and provides length() accessor.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the wrapped string.\"\"\"\n        return len(self.value)\n\nclass RotationOperation:\n    \"\"\"Provides rotation semantics (cyclic left rotation) and identity check.\"\"\"\n    @staticmethod\n    def rotate(s: str, k: int) -> str:\n        \"\"\"Performs a cyclic left rotation on string s by k positions.\"\"\"\n        return s[k:] + s[:k]\n\n    @staticmethod\n    def is_identity(s: str, k: int) -> bool:\n        \"\"\"Checks if rotating string s by k positions results in the original string.\"\"\"\n        return RotationOperation.rotate(s, k) == s\n\nclass RotationResult:\n    \"\"\"A value object holding the result k.\"\"\"\n    def __init__(self, k: int) -> None:\n        self.k = k\n\ndef find_Rotations(s: str) -> int:\n    \"\"\"\n    Finds the minimum number of rotations (greater than 0) required to get the same string.\n    It returns the smallest k (1..n-1) such that s rotated by k positions equals s,\n    otherwise returns n (length of s).\n    \"\"\"\n    string_input = StringInput(s)\n    n = string_input.length()\n\n    if n == 1:\n        return 1\n\n    for k in range(1, n):\n        if RotationOperation.is_identity(s, k):\n            return k\n\n    # If no rotation from 1 to n-1 yields the original string,\n    # it means the smallest number of rotations to get the same string is n.\n    return n"}
