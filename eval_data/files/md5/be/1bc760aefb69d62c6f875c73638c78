{"task_id": "Mbpp/395", "solution": "from typing import Optional, Dict\n\nclass InputString:\n    \"\"\"Encapsulates the input string and provides its length.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the encapsulated string.\"\"\"\n        return len(self.value)\n\nclass CharacterFrequency:\n    \"\"\"Calculates character frequencies for a given string.\"\"\"\n    def __init__(self):\n        pass\n\n    def count_characters(self, s: str) -> Dict[str, int]:\n        \"\"\"Counts the occurrences of each character in a string.\"\"\"\n        counts: Dict[str, int] = {}\n        for char in s:\n            counts[char] = counts.get(char, 0) + 1\n        return counts\n\ndef first_non_repeating_character(input: str) -> Optional[str]:\n    input_str_obj = InputString(input)\n\n    if input_str_obj.length() == 0:\n        return None\n\n    freq_counter = CharacterFrequency()\n    char_counts = freq_counter.count_characters(input_str_obj.value)\n\n    for char in input_str_obj.value:\n        if char_counts[char] == 1:\n            return char\n\n    return None"}
{"task_id": "Mbpp/398", "solution": "from typing import List\n\ndef _split_digits(n: int) -> List[int]:\n    \"\"\"Extracts base-10 digits of an integer.\"\"\"\n    if n == 0:\n        return [0]\n    return [int(digit) for digit in str(abs(n))]\n\ndef sum_of_digits(input: List[int]) -> int:\n    \"\"\"Computes the sum of digits for each number in a list and returns the combined total.\"\"\"\n    total_combined_sum = 0\n    for number in input:\n        total_combined_sum += sum(_split_digits(number))\n    return total_combined_sum"}
