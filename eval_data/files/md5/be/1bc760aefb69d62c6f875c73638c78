{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(n: int) -> int:\n    \"\"\"\n    Sets the left-most (most significant) unset bit in a non-negative integer.\n    If all bits up to the highest set bit are already set, it sets the bit at msb_pos + 1.\n    \"\"\"\n\n    def _validate_input(val: int) -> None:\n        \"\"\"Validates that the input is a non-negative integer.\"\"\"\n        if not isinstance(val, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n        if val < 0:\n            raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    def find_highest_set_bit(val: int) -> int:\n        \"\"\"Returns the zero-based position of the highest set bit. For n=0, returns 0.\"\"\"\n        if val == 0:\n            return 0\n        return val.bit_length() - 1\n\n    def find_left_most_unset_at_or_below(val: int, msb_pos: int) -> int:\n        \"\"\"\n        Finds the left-most (most significant) unset bit at or below msb_pos.\n        Returns its position, or -1 if no such bit is found.\n        \"\"\"\n        for i in range(msb_pos, -1, -1):\n            if not (val & (1 << i)):  # Check if the i-th bit is 0\n                return i\n        return -1\n\n    def set_bit(val: int, pos: int) -> int:\n        \"\"\"Returns the integer with the bit at 'pos' set to 1.\"\"\"\n        return val | (1 << pos)\n\n    _validate_input(n)\n\n    msb_pos = find_highest_set_bit(n)\n    target_pos = find_left_most_unset_at_or_below(n, msb_pos)\n\n    if target_pos != -1:\n        return set_bit(n, target_pos)\n    else:\n        # All bits up to msb_pos are set. Set the bit at msb_pos + 1.\n        return set_bit(n, msb_pos + 1)"}
{"task_id": "Mbpp/389", "solution": "class InputParameter:\n    \"\"\"Simple holder for input parameter n.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n\nclass Result:\n    \"\"\"Simple holder for returned value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass LucasSequence:\n    \"\"\"Encapsulates Lucas sequence definition and computation algorithm.\"\"\"\n    L0: int = 2\n    L1: int = 1\n\n    def compute(self, n: int) -> int:\n        \"\"\"Computes the nth Lucas number iteratively based on L(0)=2, L(1)=1, and L(n)=L(n-1)+L(n-2).\"\"\"\n        if n == 0:\n            return self.L0\n        elif n == 1:\n            return self.L1\n        else:\n            current_L_n_minus_1 = self.L1  # L(1)\n            current_L_n_minus_2 = self.L0  # L(0)\n\n            for _ in range(2, n + 1):\n                next_L = current_L_n_minus_1 + current_L_n_minus_2\n                current_L_n_minus_2 = current_L_n_minus_1\n                current_L_n_minus_1 = next_L\n            return current_L_n_minus_1\n\ndef find_lucas(n: int) -> int:\n    \"\"\"Finds the n'th Lucas number using an iterative approach delegated to an internal sequence calculator.\"\"\"\n    input_param = InputParameter(n)\n    sequence_calculator = LucasSequence()\n    lucas_number = sequence_calculator.compute(input_param.n)\n    result_holder = Result(lucas_number)\n    return result_holder.value"}
