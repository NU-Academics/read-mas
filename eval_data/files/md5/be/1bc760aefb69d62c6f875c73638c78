{"task_id": "Mbpp/113", "solution": "def check_integer(input_str: str) -> bool:\n    \"\"\"Checks if a string represents an integer, consisting solely of ASCII digits '0'-'9'.\n    Returns True if the string is non-empty and contains only digits, False otherwise.\"\"\"\n    if not input_str:\n        return False\n    for char in input_str:\n        if not ('0' <= char <= '9'):\n            return False\n    return True"}
{"task_id": "Mbpp/111", "solution": "from typing import List, Any\n\ndef _unique_preserve_order(lst: List[Any]) -> List[Any]:\n    \"\"\"Return a list with first-seen unique elements using equality-based checks (internal helper).\"\"\"\n    seen = []\n    for item in lst:\n        if item not in seen:\n            seen.append(item)\n    return seen\n\ndef common_in_nested_lists(nested_list: List[List[Any]]) -> List[Any]:\n    \"\"\"Accepts nested_list (outer list of inner lists) and returns an iterable of unique elements present in every inner list.\"\"\"\n    if not nested_list:\n        return []\n\n    # Get unique candidates from the first inner list, preserving their order\n    candidates = _unique_preserve_order(nested_list[0])\n\n    common_elements = []\n    # Check each candidate against all other inner lists\n    for candidate in candidates:\n        is_common = True\n        # Iterate through the rest of the inner lists (starting from the second one)\n        for inner_list in nested_list[1:]:\n            if candidate not in inner_list:\n                is_common = False\n                break  # Candidate not found in this inner list, so it's not common\n        \n        if is_common:\n            common_elements.append(candidate)\n            \n    return common_elements"}
{"task_id": "Mbpp/109", "solution": "import collections\n\nclass BinaryString:\n    \"\"\"Encapsulates a binary string and provides character access.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n        self.length = len(value)\n\n    def charAt(self, idx: int) -> str:\n        \"\"\"Returns the character at the specified index.\"\"\"\n        return self.value[idx]\n\nclass Rotation:\n    \"\"\"Logical holder for a rotation instance.\"\"\"\n    def __init__(self, index: int, value: str, is_odd: bool):\n        self.index = index\n        self.value = value\n        self.isOdd = is_odd\n\nclass RotationEngine:\n    \"\"\"Computes rotations (conceptually) for a BinaryString.\"\"\"\n    def rotateLeftOnce(self, b: BinaryString) -> Rotation:\n        \"\"\"Returns a Rotation object for a single left rotation.\"\"\"\n        return self.rotateAtOffset(b, 1)\n\n    def rotateAtOffset(self, b: BinaryString, offset: int) -> Rotation:\n        \"\"\"Computes the logical rotation at a given offset.\"\"\"\n        if b.length == 0:\n            return Rotation(offset, \"\", False)\n        \n        # Calculate the index of the last character in the rotated string\n        # Original string: s[0] s[1] ... s[L-1]\n        # Rotated by `offset`: s[offset] ... s[L-1] s[0] ... s[offset-1]\n        # The last character of the rotated string is s[(offset - 1 + L) % L] if offset > 0\n        # For the original string (offset=0), the last char is s[L-1]\n        \n        # More straightforward: The LSB of the string rotated `offset` times\n        # is the character at index `(offset + b.length - 1) % b.length` in the original string.\n        lsb_original_idx = (offset + b.length - 1) % b.length\n        \n        lsb_char = b.charAt(lsb_original_idx)\n        is_odd = (lsb_char == '1')\n        \n        # The full value of the rotation is not strictly needed for counting,\n        # but the design specifies Rotation having a 'value' property.\n        # Constructing it for correctness, though for performance only LSB is used.\n        if b.length == 0:\n            rotated_value = \"\"\n        else:\n            actual_offset = offset % b.length\n            rotated_value = b.value[actual_offset:] + b.value[:actual_offset]\n            \n        return Rotation(offset, rotated_value, is_odd)\n\nclass Evaluator:\n    \"\"\"Determines whether a Rotation is odd.\"\"\"\n    def isOdd(self, r: Rotation) -> bool:\n        \"\"\"Checks if the rotation is odd based on its least significant bit.\"\"\"\n        return r.isOdd\n\nclass InputValidator:\n    \"\"\"Validates input binary string and integer k.\"\"\"\n    def isValidBinary(self, s: str) -> bool:\n        \"\"\"Checks if the string contains only '0' and '1'.\"\"\"\n        return all(char in ('0', '1') for char in s)\n\n    def isValidK(self, k: int) -> bool:\n        \"\"\"Checks if k is a non-negative integer.\"\"\"\n        return isinstance(k, int) and k >= 0\n\nclass Counter:\n    \"\"\"Counts rotations whose LSB is '1'.\"\"\"\n    def countOdd(self, binary_string: BinaryString, k: int) -> int:\n        \"\"\"Iterates over k rotations and counts how many are odd.\"\"\"\n        if k == 0:\n            return 0\n        \n        odd_count = 0\n        rotation_engine = RotationEngine()\n        evaluator = Evaluator()\n\n        for i in range(k):\n            rotation = rotation_engine.rotateAtOffset(binary_string, i)\n            if evaluator.isOdd(rotation):\n                odd_count += 1\n        return odd_count\n\ndef odd_Equivalent(s: str, k: int) -> int:\n    \"\"\"\n    Finds the number of numbers with an odd value when rotating a binary string \n    the given number of times.\n    \"\"\"\n    validator = InputValidator()\n    if not validator.isValidBinary(s) or not validator.isValidK(k):\n        raise ValueError(\"Invalid input: s must be a binary string and k a non-negative integer.\")\n\n    if k == 0:\n        return 0\n\n    binary_string = BinaryString(s)\n    counter = Counter()\n    return counter.countOdd(binary_string, k)"}
