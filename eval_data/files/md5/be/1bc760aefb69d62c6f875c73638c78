{"task_id": "Mbpp/597", "solution": "class ValidationError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\ndef find_kth(array1, array2, k):\n    \"\"\"\n    Finds the k-th smallest element from two sorted arrays.\n    Assumes array1 and array2 are sorted; k is 1-based.\n    \"\"\"\n    n1 = len(array1)\n    n2 = len(array2)\n    total_length = n1 + n2\n\n    if not (1 <= k <= total_length):\n        raise ValidationError(f\"k must be between 1 and {total_length}, but got {k}\")\n\n    p1 = 0\n    p2 = 0\n    kth_element = None\n\n    for _ in range(k):\n        if p1 == n1:\n            kth_element = array2[p2]\n            p2 += 1\n        elif p2 == n2:\n            kth_element = array1[p1]\n            p1 += 1\n        elif array1[p1] <= array2[p2]:\n            kth_element = array1[p1]\n            p1 += 1\n        else:\n            kth_element = array2[p2]\n            p2 += 1\n    \n    return kth_element"}
{"task_id": "Mbpp/598", "solution": "class Number:\n    \"\"\"Encapsulates an integer and provides digit parsing and digit count operations.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def digit_count(self) -> int:\n        \"\"\"Returns the number of digits in the encapsulated value.\"\"\"\n        return len(str(self.value))\n\n    def digits(self) -> list[int]:\n        \"\"\"Returns a list of individual digits of the encapsulated value.\"\"\"\n        return [int(d) for d in str(self.value)]\n\nclass Digit:\n    \"\"\"Represents a single decimal digit and computes digit^exponent.\"\"\"\n    def __init__(self, value: int, position: int) -> None:\n        self.value = value\n        self.position = position\n\n    def power(self, exponent: int) -> int:\n        \"\"\"Computes the digit's value raised to the given exponent.\"\"\"\n        return self.value ** exponent\n\nclass ArmstrongChecker:\n    \"\"\"Computes the Armstrong sum and determines Armstrong-ness.\"\"\"\n    def armstrong_number(self, n: int) -> bool:\n        \"\"\"Determines if the given number is an Armstrong number.\"\"\"\n        number_obj = Number(n)\n        computed_sum = self._compute_sum(number_obj)\n        return computed_sum == n\n\n    def _compute_sum(self, number: Number) -> int:\n        \"\"\"Computes the sum of digits raised to the power of the digit count.\"\"\"\n        digit_count = number.digit_count()\n        total_sum = 0\n        for i, digit_val in enumerate(number.digits()):\n            digit_obj = Digit(digit_val, i)\n            total_sum += digit_obj.power(digit_count)\n        return total_sum\n\ndef armstrong_number(n: int) -> bool:\n    \"\"\"Checks if a given number is an Armstrong number.\"\"\"\n    checker = ArmstrongChecker()\n    return checker.armstrong_number(n)"}
{"task_id": "Mbpp/593", "solution": "import re\nfrom typing import List\n\nclass Octet:\n    \"\"\"\n    Represents a single octet of an IPv4 address, computing its integer value\n    and normalized string form (removing leading zeros, converting \"00\" to \"0\").\n    \"\"\"\n    def __init__(self, raw: str, position: int) -> None:\n        self.raw: str = raw\n        self.value: int = 0\n        self.normalized: str = \"\"\n\n    def normalize(self) -> None:\n        \"\"\"\n        Computes the integer value and normalized string form of the octet.\n        Removes leading zeros and ensures '00' becomes '0'.\n        \"\"\"\n        self.value = int(self.raw)\n        self.normalized = str(self.value)\n\nclass IPAddress:\n    \"\"\"\n    Represents an IPv4 address, handling parsing of a raw string into octets,\n    validation, orchestration of octet normalization, and assembly of the\n    final normalized IP string.\n    \"\"\"\n    def __init__(self, raw: str) -> None:\n        self.raw: str = raw\n        self.normalized: str = \"\"\n        self.octets: List[Octet] = []\n\n    def parse(self) -> None:\n        \"\"\"\n        Parses the raw IP string into individual octet tokens,\n        validates the format (four tokens, each 1-3 digits),\n        and creates Octet instances. Raises ValueError for invalid formats.\n        \"\"\"\n        tokens = self.raw.split('.')\n        if len(tokens) != 4:\n            raise ValueError('invalid IPv4 format')\n\n        for i, token in enumerate(tokens):\n            if not token.isdigit() or not (1 <= len(token) <= 3):\n                raise ValueError('invalid IPv4 format')\n            self.octets.append(Octet(token, i))\n\n    def normalize(self) -> None:\n        \"\"\"\n        Orchestrates the normalization of each individual octet and\n        then assembles the fully normalized IPv4 string.\n        \"\"\"\n        for octet in self.octets:\n            octet.normalize()\n        self.normalized = '.'.join(o.normalized for o in self.octets)\n\nclass RemoveZeroIPFunction:\n    \"\"\"\n    Orchestrates the entire process of parsing, validating, and normalizing\n    an IPv4 address string by delegating to IPAddress and Octet domain models.\n    \"\"\"\n    def __init__(self, input: str) -> None:\n        self.input: str = input\n        self.output: str = \"\"\n\n    def normalizeIP(self) -> str:\n        \"\"\"\n        Executes the IP address normalization workflow:\n        parses the input, normalizes each octet, and returns the result.\n        \"\"\"\n        addr = IPAddress(self.input)\n        addr.parse()\n        addr.normalize()\n        self.output = addr.normalized\n        return self.output\n\ndef removezero_ip(input: str) -> str:\n    \"\"\"\n    Removes leading zeros from each octet of an IPv4 address string,\n    converting all-zero octets to '0'.\n    e.g., \"216.08.094.196\" becomes \"216.8.94.196\".\n    Raises ValueError for invalid IPv4 formats.\n    \"\"\"\n    normalizer = RemoveZeroIPFunction(input)\n    return normalizer.normalizeIP()"}
