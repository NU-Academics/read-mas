{"task_id": "Mbpp/256", "solution": "import math\nimport numbers\n\nclass InputValidator:\n    \"\"\"\n    Handles validation and normalization of input values.\n    \"\"\"\n    def is_non_negative(self, value) -> bool:\n        \"\"\"\n        Returns True if value is numeric and value >= 0, else False.\n        \"\"\"\n        if isinstance(value, numbers.Number):\n            return value >= 0\n        return False\n\n    def normalize_input(self, value) -> int:\n        \"\"\"\n        Converts a numeric value to an integer by truncation toward zero using int(value).\n        \"\"\"\n        return int(value)\n\nclass PrimeCounter:\n    \"\"\"\n    Provides methods for counting primes and checking primality.\n    \"\"\"\n    def is_prime(self, n) -> bool:\n        \"\"\"\n        Checks if a given number n is prime using trial division.\n        \"\"\"\n        if n < 2:\n            return False\n        if n in (2, 3):\n            return True\n        if n % 2 == 0:\n            return False\n\n        limit = int(math.sqrt(n))\n        for d in range(3, limit + 1, 2):\n            if n % d == 0:\n                return False\n        return True\n\n    def count_Primes_nums(self, limit) -> int:\n        \"\"\"\n        Counts the number of prime numbers less than the given limit.\n        \"\"\"\n        count = 0\n        for n in range(2, limit):\n            if self.is_prime(n):\n                count += 1\n        return count\n\ndef count_Primes_nums(limit):\n    \"\"\"\n    Counts the number of prime numbers strictly less than the given non-negative number.\n    Returns 0 for invalid (non-numeric) or non-positive inputs after normalization.\n    \"\"\"\n    validator = InputValidator()\n\n    if not validator.is_non_negative(limit):\n        return 0\n\n    integer_limit = validator.normalize_input(limit)\n\n    if integer_limit <= 2:\n        return 0\n\n    prime_counter = PrimeCounter()\n    return prime_counter.count_Primes_nums(integer_limit)"}
{"task_id": "Mbpp/259", "solution": "class Validator:\n    @staticmethod\n    def is_two_element_numeric_tuple(obj) -> bool:\n        \"\"\"Checks if an object is a 2-element tuple with numeric elements.\"\"\"\n        return isinstance(obj, tuple) and \\\n               len(obj) == 2 and \\\n               isinstance(obj[0], (int, float)) and \\\n               isinstance(obj[1], (int, float))\n\n    @staticmethod\n    def have_equal_length(t1, t2) -> bool:\n        \"\"\"Checks if two objects are tuples of equal length.\"\"\"\n        return isinstance(t1, tuple) and \\\n               isinstance(t2, tuple) and \\\n               len(t1) == len(t2)\n\ndef maximize_elements(input1: tuple, input2: tuple) -> tuple:\n    \"\"\"\n    Maximizes elements of two tuples of 2-element numeric tuples.\n    Returns a new tuple with element-wise maximums, raising ValueError for invalid inputs.\n    \"\"\"\n    if not Validator.have_equal_length(input1, input2):\n        raise ValueError(\"Input tuples must have equal length.\")\n\n    result_elements = []\n    for i in range(len(input1)):\n        elem1 = input1[i]\n        elem2 = input2[i]\n\n        if not Validator.is_two_element_numeric_tuple(elem1):\n            raise ValueError(f\"Element at index {i} of input1 is not a 2-element numeric tuple.\")\n        if not Validator.is_two_element_numeric_tuple(elem2):\n            raise ValueError(f\"Element at index {i} of input2 is not a 2-element numeric tuple.\")\n\n        max_first = max(elem1[0], elem2[0])\n        max_second = max(elem1[1], elem2[1])\n        result_elements.append((max_first, max_second))\n\n    return tuple(result_elements)"}
{"task_id": "Mbpp/262", "solution": "def _validate_L(input_list, L):\n    \"\"\"\n    Internal: raise ValueError if L is not an int or not in range 0..len(input_list).\n    \"\"\"\n    if not isinstance(L, int):\n        raise ValueError(\"L must be an integer.\")\n    if not (0 <= L <= len(input_list)):\n        raise ValueError(f\"L must be between 0 and the length of the list ({len(input_list)}), inclusive.\")\n\ndef split_two_parts(input_list, L):\n    \"\"\"\n    Validate L and split input_list into two parts.\n    Returns: tuple (firstPart, secondPart).\n    \"\"\"\n    _validate_L(input_list, L)\n    first_part = input_list[0:L]\n    second_part = input_list[L:]\n    return (first_part, second_part)"}
{"task_id": "Mbpp/260", "solution": "from .newman_service import NewmanPrimeService\nfrom .validator import InputValidator\nfrom .generator import SequenceGenerator\nfrom .primality import PrimalityTester\nfrom .cache import PrimeCache\n\ndef newman_prime(n: int) -> int:\n    \"\"\"\n    Finds the nth Newman\u2013Shanks\u2013Williams prime number using the orchestrated service.\n    This function acts as the public API entry point.\n    \"\"\"\n    validator = InputValidator()\n    generator = SequenceGenerator()\n    tester = PrimalityTester()\n    cache = PrimeCache()\n    service = NewmanPrimeService(validator=validator, generator=generator, tester=tester, cache=cache)\n    return service.newman_prime(n)"}
{"task_id": "Mbpp/264", "solution": "class DogAgeService:\n    def dog_age(self, humanYears: float) -> int:\n        \"\"\"Calculates a dog's age in dog years based on the specified algorithm and rounds to the nearest integer.\"\"\"\n        if not isinstance(humanYears, (int, float)):\n            raise TypeError(\"humanYears must be a numeric value.\")\n\n        dog_years_calculated = 0.0\n        if humanYears > 0:\n            if humanYears <= 2:\n                dog_years_calculated = humanYears * 10.5\n            else:\n                dog_years_calculated = (2 * 10.5) + ((humanYears - 2) * 4)\n        \n        return round(dog_years_calculated)\n\ndef dog_age(humanYears: float) -> int:\n    \"\"\"Calculates a dog's age in dog years by delegating to DogAgeService.\"\"\"\n    return DogAgeService().dog_age(humanYears)"}
{"task_id": "Mbpp/261", "solution": "class TupleInput:\n    \"\"\"Holds an input tuple and provides its length.\"\"\"\n    def __init__(self, elements: tuple):\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the encapsulated tuple.\"\"\"\n        return len(self.elements)\n\nclass NumericElement:\n    \"\"\"Wraps a single value to check if it's numeric.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n    def is_numeric(self) -> bool:\n        \"\"\"Checks if the wrapped value is an int or float.\"\"\"\n        return isinstance(self.value, (int, float))\n\nclass Validator:\n    \"\"\"Stateless helper for performing validation checks.\"\"\"\n    @staticmethod\n    def validate_length(numer: 'TupleInput', denom: 'TupleInput') -> None:\n        \"\"\"Raises ValueError if tuple lengths differ.\"\"\"\n        if numer.length() != denom.length():\n            raise ValueError(\"Input tuples must have the same length.\")\n\n    @staticmethod\n    def validate_nonzero(denom: 'TupleInput') -> None:\n        \"\"\"Raises ZeroDivisionError if any denominator element is zero.\"\"\"\n        for element in denom.elements:\n            if element == 0:\n                raise ZeroDivisionError(\"Denominator tuple contains zero.\")\n\n    @staticmethod\n    def validate_numeric(elem: 'NumericElement') -> None:\n        \"\"\"Raises ValueError if the element is not numeric.\"\"\"\n        if not elem.is_numeric():\n            raise ValueError(\"Tuple elements must be numeric (int or float).\")\n\ndef division_elements(numerator_tuple: tuple, denominator_tuple: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise division of two tuples, validating inputs.\n    Raises ValueError for non-numeric elements or length mismatch, ZeroDivisionError for zero denominators.\n    \"\"\"\n    numer_wrapper = TupleInput(numerator_tuple)\n    denom_wrapper = TupleInput(denominator_tuple)\n\n    Validator.validate_length(numer_wrapper, denom_wrapper)\n\n    results = []\n    for i in range(numer_wrapper.length()):\n        current_numer_element = numer_wrapper.elements[i]\n        current_denom_element = denom_wrapper.elements[i]\n\n        Validator.validate_numeric(NumericElement(current_numer_element))\n        Validator.validate_numeric(NumericElement(current_denom_element))\n\n        if current_denom_element == 0:\n            raise ZeroDivisionError(\"Denominator tuple contains zero.\")\n\n        quotient = current_numer_element / current_denom_element\n        results.append(quotient)\n\n    return tuple(results)"}
