{"task_id": "Mbpp/589", "solution": "import math\nfrom typing import Iterator\n\nclass InputValidator:\n    \"\"\"Ensures inputs are integers, raising TypeError if not.\"\"\"\n    @staticmethod\n    def ensure_integers(start: int, end: int) -> None:\n        if not isinstance(start, int) or not isinstance(end, int):\n            raise TypeError(\"Inputs 'start' and 'end' must be integers.\")\n\nclass NumberRange:\n    \"\"\"Represents an inclusive integer range [start, end].\"\"\"\n    def __init__(self, start: int, end: int) -> None:\n        self.start = start\n        self.end = end\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the range is empty (start > end).\"\"\"\n        return self.start > self.end\n\nclass OutputList:\n    \"\"\"A container for collected perfect square integers, preserving order.\"\"\"\n    def __init__(self, values: list[int] = None) -> None:\n        self.values = values if values is not None else []\n\n    def append(self, value: int) -> None:\n        \"\"\"Adds a value to the list.\"\"\"\n        self.values.append(value)\n\n    def to_list(self) -> list[int]:\n        \"\"\"Returns a native Python list of the collected values.\"\"\"\n        return list(self.values)\n\nclass IsPerfectSquareTester:\n    \"\"\"Evaluates if a given integer candidate is a perfect square.\"\"\"\n    @staticmethod\n    def isPerfectSquare(candidate: 'IntegerCandidate') -> bool:\n        value = candidate.value\n        if value < 0:\n            return False\n        root = int(math.sqrt(value))\n        return root * root == value\n\nclass IntegerCandidate:\n    \"\"\"Wraps a single integer value as a candidate for being a perfect square.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def isPerfectSquare(self) -> bool:\n        \"\"\"Delegates to IsPerfectSquareTester to check if the value is a perfect square.\"\"\"\n        return IsPerfectSquareTester.isPerfectSquare(self)\n\nclass IntegerCandidateScanner:\n    \"\"\"Iterates through a NumberRange, yielding IntegerCandidate instances.\"\"\"\n    @staticmethod\n    def scan(number_range: NumberRange) -> Iterator[IntegerCandidate]:\n        if number_range.is_empty():\n            return\n        for value in range(number_range.start, number_range.end + 1):\n            yield IntegerCandidate(value)\n\nclass OutputCollector:\n    \"\"\"Collects IntegerCandidate values that are perfect squares.\"\"\"\n    def __init__(self) -> None:\n        self._values: list[int] = []\n\n    def collect(self, candidate: IntegerCandidate) -> None:\n        \"\"\"Appends the candidate's value to the internal list.\"\"\"\n        self._values.append(candidate.value)\n\n    def result(self) -> OutputList:\n        \"\"\"Returns an OutputList containing the collected perfect squares.\"\"\"\n        return OutputList(self._values)\n\nclass PerfectSquaresFunction:\n    \"\"\"Orchestrates the process of finding perfect squares within a range.\"\"\"\n    def __init__(self, start: int, end: int) -> None:\n        self.start = start\n        self.end = end\n\n    def compute(self) -> list[int]:\n        \"\"\"Computes and returns a list of perfect squares within the initialized range.\"\"\"\n        number_range = NumberRange(self.start, self.end)\n        collector = OutputCollector()\n\n        for candidate in IntegerCandidateScanner.scan(number_range):\n            if candidate.isPerfectSquare():\n                collector.collect(candidate)\n\n        return collector.result().to_list()\n\ndef perfect_squares(start: int, end: int) -> list:\n    \"\"\"\n    Finds perfect squares between two given numbers, inclusive.\n    The function validates inputs, then delegates computation to internal components.\n    \"\"\"\n    InputValidator.ensure_integers(start, end)\n    pf = PerfectSquaresFunction(start, end)\n    return pf.compute()"}
{"task_id": "Mbpp/591", "solution": "def swap_List(L):\n    \"\"\"Swap first and last elements of a Python list L.\n\n    Returns the original list if its length is less than 2, otherwise returns a new list with\n    the first and last elements interchanged.\n    \"\"\"\n    if len(L) < 2:\n        return L\n    else:\n        return [L[-1]] + L[1:-1] + [L[0]]"}
{"task_id": "Mbpp/592", "solution": "import math\n\nclass Validator:\n    \"\"\"Helper to validate input parameters.\"\"\"\n    @staticmethod\n    def validate(n):\n        if not isinstance(n, int):\n            raise ValueError(\"Input 'n' must be an integer.\")\n        if n < 0:\n            raise ValueError(\"Input 'n' must be non-negative.\")\n\nclass BinomialCoefficient:\n    \"\"\"Helper to compute binomial coefficients.\"\"\"\n    @staticmethod\n    def compute(n, k):\n        return math.comb(n, k)\n\nclass ProductCalculator:\n    \"\"\"Helper to calculate the product of two integers.\"\"\"\n    @staticmethod\n    def product(a, b):\n        return a * b\n\nclass Accumulator:\n    \"\"\"Helper to accumulate a sum.\"\"\"\n    @staticmethod\n    def accumulate(total, value):\n        return total + value\n\ndef sum_Of_product(n):\n    \"\"\"\n    Computes the sum of the product of consecutive binomial coefficients.\n    Calculates sum_{k=0}^{n-1} C(n,k) * C(n,k+1).\n    \"\"\"\n    Validator.validate(n)\n\n    # For n=0 and n=1, the sum should be 0 as per boundary case requirements.\n    # The loop for n=0 naturally yields 0, but for n=1, C(1,0)*C(1,1)=1.\n    if n < 2:\n        return 0\n\n    total = 0\n    for k in range(n):  # Iterates k from 0 to n-1\n        binom_n_k = BinomialCoefficient.compute(n, k)\n        binom_n_k1 = BinomialCoefficient.compute(n, k + 1)\n        product_k = ProductCalculator.product(binom_n_k, binom_n_k1)\n        total = Accumulator.accumulate(total, product_k)\n\n    return total"}
{"task_id": "Mbpp/590", "solution": "import math\nimport numbers\n\ndef is_numeric(value) -> bool:\n    \"\"\"Returns True if value is an instance of numbers.Real; otherwise False.\"\"\"\n    return isinstance(value, numbers.Real)\n\ndef cos(theta) -> float:\n    \"\"\"Delegates to math.cos; returns Python float.\"\"\"\n    return math.cos(theta)\n\ndef sin(theta) -> float:\n    \"\"\"Delegates to math.sin; returns Python float.\"\"\"\n    return math.sin(theta)\n\ndef polar_rect(r, theta):\n    \"\"\"\n    Converts polar coordinates (r, theta) to rectangular coordinates (x, y).\n    Raises TypeError if r or theta are not real numeric types.\n    \"\"\"\n    if not is_numeric(r) or not is_numeric(theta):\n        raise TypeError(\"r and theta must be real numeric types\")\n\n    cos_v = cos(theta)\n    sin_v = sin(theta)\n    \n    x = float(r) * cos_v\n    y = float(r) * sin_v\n    \n    return (x, y)"}
{"task_id": "Mbpp/594", "solution": "import collections\n\nclass IntegerElement:\n    \"\"\"Lightweight value object representing a list element with parity helpers.\"\"\"\n    def __init__(self, value: int, index: int) -> None:\n        self.value = value\n        self.index = index\n\n    def is_even(self) -> bool:\n        return self.value % 2 == 0\n\n    def is_odd(self) -> bool:\n        return self.value % 2 != 0\n\nclass Result:\n    \"\"\"Simple container for the computed integer result.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass DiffEvenOdd:\n    \"\"\"Internal processor implementing scanning and computation.\"\"\"\n    def __init__(self, input_list: list[int]) -> None:\n        self.input_list = input_list\n        self._first_odd_value: int | None = None\n        self._first_even_value: int | None = None\n\n    def execute(self) -> int:\n        for i, val in enumerate(self.input_list):\n            element = IntegerElement(val, i)\n            if self._first_odd_value is None and element.is_odd():\n                self._first_odd_value = element.value\n            if self._first_even_value is None and element.is_even():\n                self._first_even_value = element.value\n            \n            # Stop scanning if both are found\n            if self._first_odd_value is not None and self._first_even_value is not None:\n                break\n        \n        # The design document does not specify behavior if one parity is missing.\n        # Assuming inputs always contain both based on the assert example.\n        result_value = self._first_even_value - self._first_odd_value\n        return Result(result_value).value\n\ndef diff_even_odd(input_list: list[int]) -> int:\n    \"\"\"\n    Public API entry point; accepts a list of integers and returns (first even) - (first odd).\n    Routes work to DiffEvenOdd processor for scanning and computation.\n    \"\"\"\n    processor = DiffEvenOdd(input_list)\n    return processor.execute()"}
