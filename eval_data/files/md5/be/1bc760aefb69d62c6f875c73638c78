{"task_id": "Mbpp/607", "solution": "import re\n\n# Domain data classes (src/models.py)\nclass Text:\n    \"\"\"Holds input text content.\"\"\"\n    def __init__(self, content: str) -> None:\n        self.content = content\n\nclass Pattern:\n    \"\"\"Holds regex pattern string.\"\"\"\n    def __init__(self, regex: str) -> None:\n        self.regex = regex\n\nclass MatchResult:\n    \"\"\"Holds match substring and indices.\"\"\"\n    def __init__(self, substring: str, start_index: int, end_index: int) -> None:\n        self.substring = substring\n        self.start_index = start_index\n        self.end_index = end_index\n\n# Regex engine implementation (src/regex_engine.py)\nclass RegexEngine:\n    \"\"\"Performs regex search and produces MatchResult.\"\"\"\n    def find(self, text_content: str, pattern_regex: str) -> MatchResult | None:\n        \"\"\"Search text for regex pattern and return MatchResult with zero-based start_index and exclusive end_index.\"\"\"\n        match = re.search(pattern_regex, text_content)\n        if match:\n            substring = match.group(0)\n            start_index = match.start()\n            end_index = match.end()\n            return MatchResult(substring, start_index, end_index)\n        return None\n\n# Public API function (src/find_literals.py)\ndef find_literals(text: str, pattern: str) -> tuple[str | None, int, int]:\n    \"\"\"\n    Searches a string for a regex pattern, returning the matching substring, start index, and end index.\n    Returns (None, -1, -1) if no match is found.\n    \"\"\"\n    engine = RegexEngine()\n    match_result = engine.find(text, pattern)\n\n    if match_result:\n        return (match_result.substring, match_result.start_index, match_result.end_index)\n    else:\n        return (None, -1, -1)"}
{"task_id": "Mbpp/611", "solution": "from typing import List, Any\n\nclass Element:\n    \"\"\"Represents a single element in the matrix.\"\"\"\n    def __init__(self, value: Any):\n        self.value = value\n\nclass Row:\n    \"\"\"Represents a single row of elements.\"\"\"\n    def __init__(self, elements: List[Any]):\n        self.elements = [Element(val) for val in elements]\n\n    def get_element(self, n: int) -> Any:\n        \"\"\"Returns the value of the element at the specified column index.\"\"\"\n        # This will raise IndexError if n is out of bounds for self.elements.\n        return self.elements[n].value\n\nclass Matrix:\n    \"\"\"Represents a matrix as a list of Row objects.\"\"\"\n    def __init__(self, rows: List[Row]):\n        self.rows = rows\n\n    def validate_column_exists(self, n: int) -> None:\n        \"\"\"Checks if all rows contain an element at the specified column index.\"\"\"\n        for row in self.rows:\n            # Attempting to get the element will raise IndexError if it's missing.\n            _ = row.get_element(n)\n\n    def get_column(self, n: int) -> List[Any]:\n        \"\"\"Returns a list of all elements in the specified column.\"\"\"\n        column_values = []\n        for row in self.rows:\n            # Assumes validate_column_exists has already been called successfully.\n            column_values.append(row.get_element(n))\n        return column_values\n\ndef _to_matrix(matrix_list_of_lists: List[List[Any]]) -> Matrix:\n    \"\"\"Converts a list-of-lists into a Matrix object representation.\"\"\"\n    rows = [Row(row_list) for row_list in matrix_list_of_lists]\n    return Matrix(rows)\n\ndef max_of_nth(matrix: List[List[Any]], n: int) -> Any:\n    \"\"\"\n    Given a matrix as a list of lists, returns the maximum value in the n'th column.\n    Raises IndexError if any row does not contain an element at index n.\n    \"\"\"\n    matrix_obj = _to_matrix(matrix)\n    matrix_obj.validate_column_exists(n)\n    column_values = matrix_obj.get_column(n)\n    return max(column_values)"}
{"task_id": "Mbpp/608", "solution": "def _validate_n(n: int) -> None:\n    \"\"\"Validates that n is a non-negative integer.\n    Raises ValueError for invalid inputs.\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n\ndef _compute_bell_via_bell_triangle(n: int) -> int:\n    \"\"\"Computes the nth Bell number using the Bell triangle method.\n    Returns the exact integer result.\n    \"\"\"\n    # Initialize a 2D list for the Bell triangle.\n    # triangle[i][j] stores the j-th element of row i.\n    # We need n+1 rows (from 0 to n).\n    triangle = [[0] * (i + 1) for i in range(n + 1)]\n\n    # Base case: B(0) = 1, which is the first element of row 0.\n    triangle[0][0] = 1\n\n    # Build the Bell triangle row by row for i from 1 to n.\n    for i in range(1, n + 1):\n        # The first element of the current row (i) is the last element of the previous row (i-1).\n        triangle[i][0] = triangle[i-1][i-1]\n        \n        # Calculate subsequent elements in the current row.\n        for j in range(1, i + 1):\n            # Each element is the sum of the element to its left in the current row\n            # and the element diagonally above-left from the previous row.\n            triangle[i][j] = triangle[i][j-1] + triangle[i-1][j-1]\n            \n    # The nth Bell number is the first element of the nth row (index n).\n    return triangle[n][0]\n\ndef bell_Number(n: int) -> int:\n    \"\"\"\n    Finds the nth Bell number.\n    Raises ValueError if n is not a non-negative integer.\n    \"\"\"\n    _validate_n(n)\n    return _compute_bell_via_bell_triangle(n)"}
{"task_id": "Mbpp/610", "solution": "def remove_kth_element(input_list, k):\n    \"\"\"\n    Remove the k'th element (1-based) from input_list and return a new list.\n    This function does not mutate the input list.\n    \"\"\"\n    return input_list[:k-1] + input_list[k:]"}
{"task_id": "Mbpp/612", "solution": "def _validate_input(input_list):\n    \"\"\"\n    Validates the input list for the merge function.\n    Raises TypeError or ValueError for invalid input formats.\n    \"\"\"\n    if not isinstance(input_list, (list, tuple)):\n        raise TypeError(\"input_list must be a list or sequence of two-element sequences\")\n\n    for pair in input_list:\n        if not isinstance(pair, (list, tuple)) or len(pair) != 2:\n            raise ValueError(\"each element of input_list must be a sequence of length 2\")\n\ndef merge(input_list):\n    \"\"\"\n    Transforms a list of two-element sublists into a list of two lists,\n    collecting first and second elements separately.\n    \"\"\"\n    _validate_input(input_list)\n\n    if not input_list:\n        return [[], []]\n\n    first_elements = []\n    second_elements = []\n\n    for item_pair in input_list:\n        first_elements.append(item_pair[0])\n        second_elements.append(item_pair[1])\n\n    return [first_elements, second_elements]"}
{"task_id": "Mbpp/614", "solution": "class ValidationError(Exception):\n    \"\"\"Domain-specific exception for validation failures.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\n    def __str__(self) -> str:\n        return self.message\n\ndef validate_input(input_list) -> bool:\n    \"\"\"Validates the input_list structure and element types, raising ValidationError on invalidity.\"\"\"\n    if not isinstance(input_list, list):\n        raise ValidationError(\"Input must be a list.\")\n\n    for i, item in enumerate(input_list):\n        if not isinstance(item, tuple):\n            raise ValidationError(f\"List element at index {i} must be a tuple, got {type(item).__name__}.\")\n        for j, val in enumerate(item):\n            if not isinstance(val, int):\n                raise ValidationError(f\"Tuple element at index ({i}, {j}) must be an integer, got {type(val).__name__}.\")\n    return True\n\ndef cummulative_sum(input_list: list[tuple[int, ...]]) -> int:\n    \"\"\"\n    Calculates the cumulative sum of all integers within a list of tuples.\n    Raises ValidationError for invalid input types or structures.\n    \"\"\"\n    validate_input(input_list)\n\n    if not input_list:\n        return 0\n\n    total_sum = 0\n    for tpl in input_list:\n        for num in tpl:\n            total_sum += num\n    return total_sum"}
{"task_id": "Mbpp/618", "solution": "class LengthMismatchException(Exception):\n    \"\"\"\n    Exception raised when input lists to div_list have differing lengths.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\n    def __str__(self) -> str:\n        return self.message\n\ndef div_list(list1, list2):\n    \"\"\"\n    Divides two lists element-wise, returning a new list of float results.\n    Raises LengthMismatchException if the input lists have different lengths.\n    \"\"\"\n    if len(list1) != len(list2):\n        raise LengthMismatchException(f\"Input lists have differing lengths: {len(list1)} != {len(list2)}\")\n    \n    return [float(a) / float(b) for a, b in zip(list1, list2)]"}
{"task_id": "Mbpp/616", "solution": "def validateTypes(a: tuple, b: tuple) -> None:\n    \"\"\"Verifies both inputs are of Python type tuple. Raises TypeError if not.\"\"\"\n    if not isinstance(a, tuple) or not isinstance(b, tuple):\n        raise TypeError(\"Both inputs must be tuples.\")\n\ndef validateLength(a: tuple, b: tuple) -> None:\n    \"\"\"Verifies both tuples have equal length. Raises ValueError on mismatch.\"\"\"\n    if len(a) != len(b):\n        raise ValueError(\"Input tuples must have the same length.\")\n\ndef checkZeroDivisor(b: tuple) -> None:\n    \"\"\"Ensures no element in divisor tuple b is zero. Raises ZeroDivisionError when a zero divisor is found.\"\"\"\n    if 0 in b:\n        raise ZeroDivisionError(\"Divisor tuple cannot contain zero.\")\n\ndef computeModulo(a: tuple, b: tuple) -> tuple:\n    \"\"\"Computes element-wise modulo and returns a new tuple. Does not mutate inputs.\"\"\"\n    return tuple(elem_a % elem_b for elem_a, elem_b in zip(a, b))\n\ndef tuple_modulo(a: tuple, b: tuple) -> tuple:\n    \"\"\"Performs element-wise modulo on two tuples after validating inputs.\"\"\"\n    validateTypes(a, b)\n    validateLength(a, b)\n    checkZeroDivisor(b)\n    return computeModulo(a, b)"}
{"task_id": "Mbpp/615", "solution": "from typing import Tuple, List, Any\n\ndef _is_numeric(value: Any) -> bool:\n    \"\"\"Return True if value is an int or float.\"\"\"\n    return isinstance(value, (int, float))\n\ndef _validate_inner(inner_tuple: tuple) -> None:\n    \"\"\"Raise TypeError if inner is not a tuple or contains non-numeric; raise ValueError if empty.\"\"\"\n    if not isinstance(inner_tuple, tuple):\n        raise TypeError(\"inner elements must be tuples\")\n    if not inner_tuple:\n        raise ValueError(\"inner tuple must not be empty\")\n    for element in inner_tuple:\n        if not _is_numeric(element):\n            raise TypeError(\"inner elements must be numeric\")\n\ndef _validate_outer(tuple_of_tuples: tuple) -> None:\n    \"\"\"Raise TypeError if outer container is not a tuple.\"\"\"\n    if not isinstance(tuple_of_tuples, tuple):\n        raise TypeError(\"outer container must be a tuple\")\n\ndef _mean_of_tuple(inner_tuple: tuple) -> float:\n    \"\"\"Return arithmetic mean of inner_tuple using Python float division.\"\"\"\n    return sum(inner_tuple) / len(inner_tuple)\n\ndef average_tuple(tuple_of_tuples: tuple) -> list:\n    \"\"\"\n    Validates input (a tuple of tuples with numeric elements) and returns a list of float averages for each inner tuple.\n    Raises TypeError for incorrect types or non-numeric elements, and ValueError for empty inner tuples.\n    \"\"\"\n    _validate_outer(tuple_of_tuples)\n    \n    averages: List[float] = []\n    for inner_tuple in tuple_of_tuples:\n        _validate_inner(inner_tuple)\n        averages.append(_mean_of_tuple(inner_tuple))\n            \n    return averages"}
{"task_id": "Mbpp/619", "solution": "class Character:\n    \"\"\"Represents a single character from the input string.\"\"\"\n    def __init__(self, value: str, originalIndex: int):\n        self.value = value\n        self.originalIndex = originalIndex\n\n    def isDigit(self) -> bool:\n        \"\"\"Determines if the character is a digit ('0'-'9').\"\"\"\n        return '0' <= self.value <= '9'\n\nclass DigitCharacter(Character):\n    \"\"\"Marker class for characters that are digits.\"\"\"\n    pass\n\nclass NonDigitCharacter(Character):\n    \"\"\"Marker class for characters that are not digits.\"\"\"\n    pass\n\n\ndef move_num(s: str) -> str:\n    non_digit_objects = []\n    digit_objects = []\n\n    for i, char_val in enumerate(s):\n        # Instantiate specific Character types as per design.\n        # Use Character's method for classification.\n        if Character(char_val, i).isDigit():\n            digit_objects.append(DigitCharacter(char_val, i))\n        else:\n            non_digit_objects.append(NonDigitCharacter(char_val, i))\n\n    # Extract values from the collected objects and concatenate.\n    return \"\".join([obj.value for obj in non_digit_objects]) + \\\n           \"\".join([obj.value for obj in digit_objects])"}
{"task_id": "Mbpp/624", "solution": "def is_upper(input: str) -> str:\n    \"\"\"Return uppercase version of input string.\"\"\"\n    return input.upper()"}
{"task_id": "Mbpp/622", "solution": "import math\nfrom typing import List, Tuple, Union\n\nclass ValidationError(Exception):\n    \"\"\"\n    Exception raised on validation failures.\n    Carries a message and an optional error code.\n    \"\"\"\n    def __init__(self, message: str, code: int = None):\n        super().__init__(message)\n        self.code = code\n\nclass InputList:\n    \"\"\"\n    Value object for an input list, providing methods for size and sorted status.\n    It encapsulates the elements and verifies their properties.\n    \"\"\"\n    def __init__(self, elements: List[Union[int, float]]):\n        self.elements = elements\n\n    def is_sorted(self) -> bool:\n        \"\"\"\n        Checks if the list elements are sorted in non-decreasing order.\n        Returns True if sorted, False otherwise.\n        \"\"\"\n        if not self.elements:\n            return True\n        for i in range(len(self.elements) - 1):\n            if not isinstance(self.elements[i], (int, float)):\n                raise ValidationError(f\"List contains non-numeric element: {self.elements[i]}\")\n            if self.elements[i] > self.elements[i+1]:\n                return False\n        if not isinstance(self.elements[-1], (int, float)): # Check last element\n            raise ValidationError(f\"List contains non-numeric element: {self.elements[-1]}\")\n        return True\n\n    def size(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.elements)\n\nclass NumericElement:\n    \"\"\"\n    A lightweight wrapper/descriptor for numeric element type checks.\n    Ensures the wrapped value is an integer or a float.\n    \"\"\"\n    def __init__(self, value: Union[int, float]):\n        if not isinstance(value, (int, float)):\n            raise ValidationError(f\"Element is not numeric: {value}\")\n        self.value = value\n\n    def type_name(self) -> str:\n        \"\"\"Returns the string name of the numeric type ('int' or 'float').\"\"\"\n        return type(self.value).__name__\n\nclass MedianService:\n    \"\"\"\n    Encapsulates the business logic for validating inputs and computing the median\n    of two sorted lists of equal size.\n    \"\"\"\n    def get_median(self, list1: List[Union[int, float]], list2: List[Union[int, float]], n: int) -> float:\n        \"\"\"\n        Validates inputs and computes the median of two sorted lists.\n        Raises ValidationError on invalid inputs.\n        \"\"\"\n        self.validate_inputs(list1, list2, n)\n        \n        # In a combined list of 2n elements, the median is the average of the\n        # nth and (n+1)th smallest elements (1-indexed).\n        # We need to find the element at index n-1 and n (0-indexed).\n        \n        nth_smallest, n_plus_1th_smallest = self.merge_or_select_elements(list1, list2, n)\n        return (nth_smallest + n_plus_1th_smallest) / 2.0\n\n    def validate_inputs(self, list1: List[Union[int, float]], list2: List[Union[int, float]], n: int) -> None:\n        \"\"\"\n        Performs comprehensive validation on the input lists and size n.\n        Raises ValidationError for any validation failure.\n        \"\"\"\n        if not isinstance(n, int) or n <= 0:\n            raise ValidationError(\"n must be a positive integer.\")\n\n        if len(list1) != n or len(list2) != n:\n            raise ValidationError(f\"Both lists must have exactly n ({n}) elements.\")\n\n        input_list1 = InputList(list1)\n        input_list2 = InputList(list2)\n\n        if not input_list1.is_sorted():\n            raise ValidationError(\"List 1 is not sorted in non-decreasing order.\")\n        if not input_list2.is_sorted():\n            raise ValidationError(\"List 2 is not sorted in non-decreasing order.\")\n        \n        # Numeric checks are primarily done by InputList during is_sorted,\n        # but a final check on empty lists if they were passed, or just for robustness.\n        # However, InputList handles the elements, so this is covered.\n\n    def merge_or_select_elements(self, list1: List[Union[int, float]], list2: List[Union[int, float]], n: int) -> Tuple[Union[int, float], Union[int, float]]:\n        \"\"\"\n        Finds the nth and (n+1)th smallest elements from two sorted lists.\n        This is done by simulating a merge without explicitly creating a new list.\n        \"\"\"\n        i = 0  # pointer for list1\n        j = 0  # pointer for list2\n        count = 0  # count of elements processed so far\n        \n        # Variables to store the nth and (n+1)th smallest elements\n        nth_smallest = None\n        n_plus_1th_smallest = None\n\n        while count <= n: # We need up to the (n+1)th smallest element\n            current_element = None\n            if i < n and j < n:\n                if list1[i] <= list2[j]:\n                    current_element = list1[i]\n                    i += 1\n                else:\n                    current_element = list2[j]\n                    j += 1\n            elif i < n: # list2 is exhausted\n                current_element = list1[i]\n                i += 1\n            elif j < n: # list1 is exhausted\n                current_element = list2[j]\n                j += 1\n            else:\n                # Should not happen if n is consistent with list lengths.\n                # All elements processed or an edge case not covered.\n                break \n\n            if count == n - 1: # This is the nth smallest element (0-indexed n-1)\n                nth_smallest = current_element\n            if count == n: # This is the (n+1)th smallest element (0-indexed n)\n                n_plus_1th_smallest = current_element\n                break # We found both, can stop.\n\n            count += 1\n        \n        # Handle cases where n_plus_1th_smallest might not be set if n=0 or other issues (pre-validated n>0, so this path is mostly for sanity)\n        if nth_smallest is None or n_plus_1th_smallest is None:\n            # This should ideally not be reached if validation passes\n            raise ValidationError(\"Could not find required median elements, possibly due to unexpected list states.\")\n\n        return nth_smallest, n_plus_1th_smallest\n\ndef get_median(list1: List[Union[int, float]], list2: List[Union[int, float]], n: int) -> float:\n    \"\"\"\n    Finds the median of two sorted lists of the same size n.\n    It delegates to MedianService for validation and computation.\n    \"\"\"\n    svc = MedianService()\n    return svc.get_median(list1, list2, n)"}
{"task_id": "Mbpp/620", "solution": "import collections\n\nclass IntegerElement:\n    \"\"\"Domain value object for a single integer.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def __repr__(self) -> str:\n        return f\"IntegerElement({self.value})\"\n\n    def __eq__(self, other):\n        if not isinstance(other, IntegerElement):\n            return NotImplemented\n        return self.value == other.value\n\n    def __hash__(self):\n        return hash(self.value)\n\nclass IntegerList:\n    \"\"\"Domain wrapper for a sequence of IntegerElement instances, sorted by value.\"\"\"\n    def __init__(self, values: list[int]):\n        # Sort raw values first to facilitate algorithms like LIS for divisible subsets\n        sorted_values = sorted(values)\n        self.elements = [IntegerElement(v) for v in sorted_values]\n\n    def length(self) -> int:\n        return len(self.elements)\n\n    def __getitem__(self, index):\n        return self.elements[index]\n\n    def __len__(self):\n        return len(self.elements)\n\nclass DivisibilityRelation:\n    \"\"\"Implements divides predicate with modulo semantics.\"\"\"\n    def divides(self, a: IntegerElement, b: IntegerElement) -> bool:\n        \"\"\"Returns True iff b.value % a.value == 0. Assumes a.value != 0.\"\"\"\n        # a.value is guaranteed to be non-zero by Validator.\n        return b.value % a.value == 0\n\nclass LargestSubsetFinder:\n    \"\"\"Encapsulates algorithmic logic for finding largest subset size.\"\"\"\n    def __init__(self, divisibility: DivisibilityRelation):\n        self.divisibility = divisibility\n\n    def find_max_size(self, integer_list: IntegerList) -> int:\n        \"\"\"\n        Finds the size of the largest divisible subset using dynamic programming.\n        Assumes integer_list.elements is sorted by value.\n        \"\"\"\n        n = integer_list.length()\n        if n == 0:\n            return 0\n        \n        dp = [1] * n  # dp[i] stores the length of the longest divisible chain ending at integer_list[i]\n\n        for i in range(n):\n            current_element = integer_list[i]\n            for j in range(i):\n                previous_element = integer_list[j]\n                # If the current element is divisible by a previous element,\n                # it can extend the chain ending at the previous element.\n                if self.divisibility.divides(previous_element, current_element):\n                    dp[i] = max(dp[i], 1 + dp[j])\n        \n        return max(dp)\n\nclass LargestSubsetAlgorithm:\n    \"\"\"Application interactor orchestrating the use case.\"\"\"\n    def compute(self, input_list: IntegerList) -> int:\n        \"\"\"Computes the size of the largest divisible subset.\"\"\"\n        divisibility_relation = DivisibilityRelation()\n        finder = LargestSubsetFinder(divisibility_relation)\n        return finder.find_max_size(input_list)\n\nclass Validator:\n    \"\"\"Validates external input and enforces policy (integers only, no zeros).\"\"\"\n    def validate_list_of_ints(self, obj) -> IntegerList:\n        \"\"\"\n        Validates input is an iterable of non-zero integers and returns an IntegerList.\n        Raises TypeError or ValueError for invalid inputs.\n        \"\"\"\n        if not isinstance(obj, collections.abc.Iterable):\n            raise TypeError(\"Input must be an iterable.\")\n        \n        processed_values = []\n        for item in obj:\n            if not isinstance(item, int):\n                raise ValueError(f\"List elements must be integers. Found: {type(item).__name__}\")\n            if item == 0:\n                raise ValueError(\"List elements cannot be zero.\")\n            processed_values.append(item)\n            \n        return IntegerList(processed_values)\n\n\ndef largest_subset(input_list) -> int:\n    \"\"\"\n    Finds the size of the largest subset of a list of numbers so that every pair is divisible.\n    The divisibility implies a chain, e.g., a | b | c ...\n    \"\"\"\n    validator = Validator()\n    integer_list = validator.validate_list_of_ints(input_list)\n    \n    algo = LargestSubsetAlgorithm()\n    return algo.compute(integer_list)"}
{"task_id": "Mbpp/623", "solution": "from typing import List, Union\n\nNumber = Union[int, float]\n\ndef validate_input(numbers: List[Number], n: int) -> None:\n    \"\"\"Validates input types and raises ValueError on failure.\"\"\"\n    if not isinstance(numbers, list):\n        raise ValueError(\"invalid numbers list\")\n    if any(not isinstance(x, (int, float)) for x in numbers):\n        raise ValueError(\"non-numeric element in numbers\")\n    if not isinstance(n, int):\n        raise ValueError(\"invalid exponent\")\n\ndef compute_power(numbers: List[Number], n: int) -> List[Number]:\n    \"\"\"Computes the n-th power for each number in the list.\"\"\"\n    return [x ** n for x in numbers]\n\ndef nth_nums(numbers: List[Number], n: int) -> List[Number]:\n    \"\"\"Computes the n-th power of each number in a list.\"\"\"\n    validate_input(numbers, n)\n    return compute_power(numbers, n)"}
{"task_id": "Mbpp/626", "solution": "def triangle_area(radius):\n    \"\"\"Return area equal to radius**2 when radius >= 0, otherwise return None for radius < 0.\"\"\"\n    if radius < 0:\n        return None\n    else:\n        return radius * radius"}
{"task_id": "Mbpp/628", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass InputString:\n    value: str\n\n@dataclass\nclass OutputString:\n    value: str\n\n@dataclass\nclass ReplacementRule:\n    target: str\n    replacement: str\n\ndef _apply_replacement_rule(value: str, rule: ReplacementRule) -> str:\n    \"\"\"Replace every ASCII space character in value with rule.replacement and return the new string.\"\"\"\n    return value.replace(rule.target, rule.replacement)\n\nclass ReplaceSpacesService:\n    \"\"\"Encapsulates replacement behavior; holds a ReplacementRule and exposes replace(input: InputString) -> OutputString.\"\"\"\n    def __init__(self, rule: ReplacementRule):\n        self._rule = rule\n\n    def replace(self, input_obj: InputString) -> OutputString:\n        replaced_value = _apply_replacement_rule(input_obj.value, self._rule)\n        return OutputString(replaced_value)\n\ndef replace_spaces(input_str: str) -> str:\n    \"\"\"Public API; pure function that returns input with spaces replaced by '%20'.\"\"\"\n    rule = ReplacementRule(target=' ', replacement='%20')\n    service = ReplaceSpacesService(rule)\n    input_obj = InputString(value=input_str)\n    output_obj = service.replace(input_obj)\n    return output_obj.value"}
{"task_id": "Mbpp/629", "solution": "from typing import List\n\nclass Validator:\n    \"\"\"Validate that a provided argument is a list of integers, raising TypeError if invalid.\"\"\"\n    @staticmethod\n    def is_valid_list_of_ints(value):\n        \"\"\"Validates value is a list and all elements are int. Raises TypeError if invalid.\"\"\"\n        if not isinstance(value, list):\n            raise TypeError(\"Input must be a list.\")\n        for item in value:\n            if not isinstance(item, int):\n                raise TypeError(\"All elements in the list must be integers.\")\n\nclass Number:\n    \"\"\"Value wrapper representing an integer with a convenience method is_even().\"\"\"\n    def __init__(self, value):\n        self.value: int = value\n\n    def is_even(self) -> bool:\n        \"\"\"Returns True if the stored value is an even number.\"\"\"\n        return (self.value % 2) == 0\n\nclass ResultList:\n    \"\"\"Container for collected even integers, preserving insertion order.\"\"\"\n    def __init__(self):\n        self.items: List[int] = []\n\n    def append(self, value: int):\n        \"\"\"Appends an integer value to the list of items.\"\"\"\n        self.items.append(value)\n\n    def to_list(self) -> List[int]:\n        \"\"\"Returns a shallow copy of the internal list of items.\"\"\"\n        return list(self.items)\n\nclass EvenFilter:\n    \"\"\"Provides filtering operation to collect even integers from an iterable.\"\"\"\n    @staticmethod\n    def filter(input_iterable) -> ResultList:\n        \"\"\"Iterates input_iterable and returns a ResultList containing even ints in order.\"\"\"\n        result_list = ResultList()\n        for item in input_iterable:\n            number = Number(value=item)\n            if number.is_even():\n                result_list.append(item)\n        return result_list\n\ndef Split(input_list):\n    \"\"\"\n    Public API to find even numbers from a list of numbers.\n    Validates input and returns a new list of even integers preserving input order.\n    \"\"\"\n    Validator.is_valid_list_of_ints(input_list)\n    filtered_evens = EvenFilter.filter(input_list)\n    return filtered_evens.to_list()"}
{"task_id": "Mbpp/630", "solution": "def get_coordinates(coord: tuple) -> list:\n    \"\"\"\n    Extracts all nine adjacent coordinates (including the center) of the given coordinate tuple.\n    The output list contains two-element lists in a deterministic order.\n    \"\"\"\n    row, col = coord\n    adjacent_coords = []\n    row_offsets = [-1, 0, 1]\n    col_offsets = [-1, 0, 1]\n\n    for ro in row_offsets:\n        for co in col_offsets:\n            adjacent_coords.append([row + ro, col + co])\n\n    return adjacent_coords"}
{"task_id": "Mbpp/631", "solution": "def processChar(c: str) -> str:\n    \"\"\"Maps a single input character to its output character based on rules.\"\"\"\n    if c.isspace():\n        return '_'\n    elif c == '_':\n        return ' '\n    else:\n        return c\n\ndef replace_spaces(input_str: str) -> str:\n    \"\"\"Replaces whitespaces with underscores and vice versa in a given string.\"\"\"\n    if not input_str:\n        return \"\"\n\n    processed_chars = []\n    for char in input_str:\n        processed_chars.append(processChar(char))\n\n    return \"\".join(processed_chars)"}
{"task_id": "Mbpp/632", "solution": "def move_zero(input_list):\n    \"\"\"Accept exactly one parameter (a Python list) and return a list with zeros moved to the end (per SRS).\"\"\"\n    non_zeros = []\n    zero_count = 0\n    for element in input_list:\n        if element == 0:\n            zero_count += 1\n        else:\n            non_zeros.append(element)\n    non_zeros.extend([0] * zero_count)\n    return non_zeros"}
{"task_id": "Mbpp/635", "solution": "```python\ndef heap_sort(input_list):\n    \"\"\"\n    Sorts a list in ascending order using the heap sort algorithm.\n    This implementation first builds a max-heap, then extracts elements to sort the list.\n    \"\"\"\n    def _heapify(arr, n, i):\n        \"\"\"\n        Maintains the max-heap property for a subtree rooted at index i.\n        n is the size of the heap.\n        \"\"\"\n        largest = i\n        left = 2 * i + 1\n        right = 2 * i + 2\n\n        if left < n and arr[largest] < arr[left]:\n            largest = left\n\n        if right < n and arr[largest] < arr[right]:\n            largest = right\n\n        if largest != i:\n            arr[i], arr[largest] = arr[largest], arr[i]\n            _heapify(arr, n, largest)\n\n    def _build_heap(arr):\n        \"\"\"\n        Builds a max-heap from an unsorted list in-place.\n        \"\"\"\n        n = len(arr)\n        # Start from the last non-leaf node and heapify upwards\n        for i in range(n // 2 - 1, -1, -1):\n            _heapify(arr, n, i)\n\n    # Make a mutable copy to perform in-place sorting\n    arr_copy = list(input_list)\n    n = len(arr_copy)\n\n    # Build a max-heap\n    _build_heap(arr_copy)\n\n    # Extract elements one by one from the heap\n    for i in range(n - 1, 0, -1):\n        arr_copy[i], arr_copy[0] = arr_copy[0], arr_copy[i]  # Move current root to end\n        _heapify(arr_copy, i, 0)  # Call max heapify on the reduced heap\n\n    return arr_copy\n```"}
{"task_id": "Mbpp/633", "solution": "class Array:\n    \"\"\"Encapsulates the input list and provides indexed access.\"\"\"\n    def __init__(self, elements):\n        self.elements = elements\n\n    def get(self, i):\n        \"\"\"Returns the element at index i.\"\"\"\n        return self.elements[i]\n\nclass XOROperation:\n    \"\"\"Computes bitwise XOR for two integers.\"\"\"\n    def compute(self, a, b):\n        \"\"\"Returns the bitwise XOR of a and b.\"\"\"\n        return a ^ b\n\nclass Result:\n    \"\"\"Accumulates the sum of XOR results.\"\"\"\n    def __init__(self):\n        self.sum = 0\n\n    def add(self, value):\n        \"\"\"Adds a value to the accumulated sum.\"\"\"\n        self.sum += value\n\n    def value(self):\n        \"\"\"Returns the current accumulated sum.\"\"\"\n        return self.sum\n\nclass InputValidator:\n    \"\"\"Validates input n per SRS business rules.\"\"\"\n    def validate(self, arr, n):\n        \"\"\"Returns False if n < 2, otherwise True.\"\"\"\n        if n < 2:\n            return False\n        return True\n\ndef pair_xor_Sum(arr, n):\n    \"\"\"\n    Finds the sum of XOR of all pairs of numbers in the given list.\n    Calculates sum_{0<=i<j<n}(arr[i] ^ arr[j]).\n    \"\"\"\n    validator = InputValidator()\n    if not validator.validate(arr, n):\n        return 0\n\n    array_wrapper = Array(arr)\n    result_accumulator = Result()\n    xor_calculator = XOROperation()\n\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            a = array_wrapper.get(i)\n            b = array_wrapper.get(j)\n            xor_value = xor_calculator.compute(a, b)\n            result_accumulator.add(xor_value)\n\n    return result_accumulator.value()"}
{"task_id": "Mbpp/638", "solution": "import math\n\nclass WindChillResult:\n    \"\"\"Data container for raw and rounded wind chill values and formula metadata.\"\"\"\n    def __init__(self, raw_value: float, rounded_value: int, formula_version: str = \"SRS:v1\"):\n        self.raw_value = raw_value\n        self.rounded_value = rounded_value\n        self.formula_version = formula_version\n\nclass Temperature:\n    \"\"\"Value object for temperature.\"\"\"\n    def __init__(self, value: float, unit: str = \"C\"):\n        self.value = value\n        self.unit = unit\n\nclass WindVelocity:\n    \"\"\"Value object for wind velocity.\"\"\"\n    def __init__(self, value: float, unit: str = \"km/h\"):\n        self.value = value\n        self.unit = unit\n\nclass WindChillCalculator:\n    \"\"\"Encapsulates computation of raw wind chill value and rounding behavior.\"\"\"\n    def wind_chill(self, velocity_kmh: float, temperature_celsius: float) -> int:\n        temperature = Temperature(temperature_celsius)\n        velocity = WindVelocity(velocity_kmh)\n\n        raw_wind_chill = self._compute_raw_wind_chill(temperature.value, velocity.value)\n        rounded_wind_chill = int(round(raw_wind_chill))\n\n        # WindChillResult is created internally for data retention but not returned by this public method.\n        _ = WindChillResult(raw_wind_chill, rounded_wind_chill)\n        \n        return rounded_wind_chill\n\n    def _compute_raw_wind_chill(self, T: float, V: float) -> float:\n        \"\"\"Computes the raw wind chill index (T_wc) using the formula.\"\"\"\n        # T_wc = 13.12 + 0.6215 * T - 11.37 * V**0.16 + 0.3965 * T * V**0.16\n        term1 = 13.12\n        term2 = 0.6215 * T\n        term3 = 11.37 * (V**0.16)\n        term4 = 0.3965 * T * (V**0.16)\n        \n        return term1 + term2 - term3 + term4\n\ndef wind_chill(velocity_kmh, temperature_celsius):\n    \"\"\"Return integer wind chill. Delegates to WindChillCalculator.wind_chill(...).\"\"\"\n    calculator = WindChillCalculator()\n    return calculator.wind_chill(velocity_kmh, temperature_celsius)"}
{"task_id": "Mbpp/637", "solution": "class NoProfitNoLoss:\n    \"\"\"\n    Encapsulates the business logic for determining no profit and no loss.\n    \"\"\"\n    @staticmethod\n    def noprofit_noloss(selling_price, cost_price) -> bool:\n        \"\"\"\n        Checks if the selling price is equal to the cost price, indicating no profit or loss.\n        \"\"\"\n        return selling_price == cost_price\n\ndef noprofit_noloss(selling_price, cost_price) -> bool:\n    \"\"\"\n    Checks if the given amount has no profit and no loss.\n    Delegates the core logic to the NoProfitNoLoss class.\n    \"\"\"\n    return NoProfitNoLoss.noprofit_noloss(selling_price, cost_price)"}
{"task_id": "Mbpp/639", "solution": "from typing import List\n\nclass Name:\n    \"\"\"Represents a single name string and provides utility methods.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the name string.\"\"\"\n        return len(self.value)\n\n    def startsWithLowercase(self) -> bool:\n        \"\"\"Checks if the name starts with an ASCII lowercase letter (a-z).\"\"\"\n        if not self.value:\n            return False\n        first_char = self.value[0]\n        return 'a' <= first_char <= 'z'\n\nclass NameList:\n    \"\"\"Manages a collection of Name objects and provides filtering capabilities.\"\"\"\n    def __init__(self, names: List[str]):\n        self._names: List[Name] = [Name(name_str) for name_str in names]\n\n    def filterLowercase(self) -> List[Name]:\n        \"\"\"Returns a list of Name objects that do not start with a lowercase letter.\"\"\"\n        return [name_obj for name_obj in self._names if not name_obj.startsWithLowercase()]\n\nclass Result:\n    \"\"\"A value object to hold the aggregated sum.\"\"\"\n    def __init__(self, sum_val: int):\n        self.sum = sum_val\n\nclass SampleNamFunction:\n    \"\"\"Orchestrates the filtering and summing logic for a list of names.\"\"\"\n    def computeSum(self, names: List[str]) -> int:\n        \"\"\"Processes the list of names, filters, sums lengths, and returns the result.\"\"\"\n        name_list_obj = NameList(names)\n        filtered_names = name_list_obj.filterLowercase()\n        \n        total_length = 0\n        for name_obj in filtered_names:\n            total_length += name_obj.length()\n        \n        result_obj = Result(total_length)\n        return result_obj.sum\n\ndef sample_nam(names: List[str]) -> int:\n    \"\"\"\n    Sums the length of names after removing those that start with a lowercase letter.\n    \"\"\"\n    processor = SampleNamFunction()\n    return processor.computeSum(names)"}
{"task_id": "Mbpp/641", "solution": "class InputValidator:\n    \"\"\"Provides static methods for input validation.\"\"\"\n    @staticmethod\n    def validate(n: int) -> None:\n        if not isinstance(n, int):\n            raise ValueError(\"n must be an integer >= 1\")\n        if n < 1:\n            raise ValueError(\"n must be >= 1\")\n\nclass NonagonalCalculator:\n    \"\"\"Calculates nonagonal numbers.\"\"\"\n    def compute(self, n: int) -> int:\n        # formula N = n * (7*n - 5) / 2\n        numerator = n * (7 * n - 5)\n        return numerator // 2\n\ndef is_nonagonal(n: int) -> int:\n    \"\"\"Validate and compute nth nonagonal number. Raises ValueError on invalid input.\"\"\"\n    InputValidator.validate(n)\n    return NonagonalCalculator().compute(n)"}
