{"task_id": "Mbpp/59", "solution": "def _validate_n(n: int) -> None:\n    \"\"\"Validates the input n for octagonal number computation.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 1:\n        raise ValueError(\"n must be >= 1\")\n\ndef _compute_formula(n: int) -> int:\n    \"\"\"Computes the octagonal number using its formula.\"\"\"\n    return n * (3 * n - 2)\n\ndef is_octagonal(n: int) -> int:\n    \"\"\"\n    Finds the nth octagonal number.\n    The function validates input n, then computes and returns the result.\n    \"\"\"\n    _validate_n(n)\n    return _compute_formula(n)"}
{"task_id": "Mbpp/57", "solution": "import functools\n\nclass ValidationError(Exception):\n    \"\"\"Exception raised for invalid input to find_Max_Num.\"\"\"\n    def __init__(self, message):\n        self.message = message\n        super().__init__(self.message)\n\ndef _validate_input(input_list):\n    \"\"\"Validates the input list of digits, raising ValidationError for invalid inputs.\"\"\"\n    if not isinstance(input_list, list):\n        raise ValidationError(\"Input must be a list.\")\n    if not input_list:\n        raise ValidationError(\"Input list cannot be empty.\")\n\n    for i, item in enumerate(input_list):\n        if not isinstance(item, int):\n            raise ValidationError(f\"Element at index {i} is not an integer.\")\n        if not (0 <= item <= 9):\n            raise ValidationError(f\"Element at index {i} is not a digit (0-9).\")\n    return input_list\n\ndef _compare_digits_for_max_num(a, b):\n    \"\"\"Compares two digits to determine their order for forming the largest concatenated number.\"\"\"\n    str_a = str(a)\n    str_b = str(b)\n    # If str_a + str_b forms a larger number than str_b + str_a,\n    # then 'a' should come before 'b'. Return -1 to indicate 'a' is \"less than\" 'b' in sort order.\n    if int(str_a + str_b) > int(str_b + str_a):\n        return -1\n    # If str_a + str_b forms a smaller number, then 'b' should come before 'a'.\n    # Return 1 to indicate 'a' is \"greater than\" 'b' in sort order.\n    elif int(str_a + str_b) < int(str_b + str_a):\n        return 1\n    else:\n        return 0\n\ndef _compute_max_concatenation(digits):\n    \"\"\"Sorts digits to form the largest possible number and returns it as an integer.\"\"\"\n    if not digits:\n        return 0\n    \n    str_digits = [str(d) for d in digits]\n    str_digits.sort(key=functools.cmp_to_key(_compare_digits_for_max_num))\n    \n    result_str = \"\".join(str_digits)\n    return int(result_str)\n\ndef find_Max_Num(input_list):\n    \"\"\"\n    Finds the largest number that can be formed with the given list of digits.\n    Raises ValidationError for invalid inputs.\n    \"\"\"\n    validated_digits = _validate_input(input_list)\n    return _compute_max_concatenation(validated_digits)"}
{"task_id": "Mbpp/61", "solution": "import collections\nimport functools\nimport itertools\nfrom typing import Iterator, Tuple\n\ndef count_Substrings(s: str) -> int:\n    \"\"\"\n    Counts substrings where the sum of digits equals the substring's length.\n    Propagates ValueError if input string contains non-digit characters.\n    \"\"\"\n    _validate_input(s)\n    count = 0\n    for _, length, substring in _enumerate_substrings(s):\n        current_sum = _sum_digits(substring)\n        if current_sum == length:\n            count += 1\n    return count\n\ndef _validate_input(s: str) -> None:\n    \"\"\"Checks if the string contains only digit characters, raising ValueError if not.\"\"\"\n    if not s.isdigit() and len(s) > 0: # s.isdigit() returns False for empty string, but empty string is valid\n        if not all(c.isdigit() for c in s): # Explicit check for non-digit characters\n            raise ValueError(\"Input string must contain only digit characters '0'-'9'.\")\n\ndef _enumerate_substrings(s: str) -> Iterator[Tuple[int, int, str]]:\n    \"\"\"Yields (startIndex, length, substringValue) for all contiguous substrings.\"\"\"\n    n = len(s)\n    for i in range(n):\n        for j in range(i, n):\n            substring = s[i:j+1]\n            yield i, len(substring), substring\n\ndef _sum_digits(sub: str) -> int:\n    \"\"\"Calculates the sum of integer values of digit characters in a substring.\"\"\"\n    return sum(int(digit) for digit in sub)"}
