{"task_id": "Mbpp/797", "solution": "class Range:\n    \"\"\"Represent inclusive integer bounds and support membership test.\"\"\"\n    def __init__(self, l: int, r: int):\n        self.l = l\n        self.r = r\n\n    def contains(self, n: int) -> bool:\n        \"\"\"True if self.l <= n <= self.r.\"\"\"\n        return self.l <= n <= self.r\n\nclass Number:\n    \"\"\"Encapsulate integer value and provide predicates.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def isOdd(self) -> bool:\n        \"\"\"True if value % 2 != 0.\"\"\"\n        return self.value % 2 != 0\n\n    def isNatural(self) -> bool:\n        \"\"\"True if value >= 1.\"\"\"\n        return self.value >= 1\n\nclass Validator:\n    \"\"\"Stateless helper providing validation and normalization utilities.\"\"\"\n    def is_integer(self, x) -> bool:\n        \"\"\"True if x is an instance of int.\"\"\"\n        return isinstance(x, int)\n\n    def is_natural(self, n: int) -> bool:\n        \"\"\"True if n >= 1.\"\"\"\n        return n >= 1\n\n    def normalize_range(self, l: int, r: int) -> Range:\n        \"\"\"Intersects [l, r] with [1, \u221e) and returns a Range(effective_l, effective_r).\n        If empty, returns sentinel Range(1, 0).\n        \"\"\"\n        effective_l = max(1, l)\n        effective_r = r\n        if effective_l > effective_r:\n            return Range(1, 0)  # Sentinel for empty range\n        return Range(effective_l, effective_r)\n\nclass Result:\n    \"\"\"Simple data container for computed sum.\"\"\"\n    def __init__(self, sum_val: int):\n        self.sum = sum_val\n\nclass SumInRangeFunction:\n    \"\"\"Encapsulate computation of the sum of odd natural numbers for a given integer range.\"\"\"\n    def compute(self, l: int, r: int) -> int:\n        \"\"\"Validates inputs, normalizes the range, and computes the sum of odd natural numbers.\"\"\"\n        validator = Validator()\n\n        # Input validation for non-integer types as per design\n        if not validator.is_integer(l) or not validator.is_integer(r):\n            raise TypeError(\"Inputs l and r must be integers.\")\n\n        effective_range = validator.normalize_range(l, r)\n\n        current_sum = 0\n        # If the normalized range is empty (e.g., [1,0]), return 0\n        if effective_range.l > effective_range.r:\n            result = Result(0)\n            return result.sum\n\n        for n in range(effective_range.l, effective_range.r + 1):\n            number = Number(n)\n            # Check isNatural() and isOdd() as per sequence diagram, though isNatural() is\n            # implicitly handled by normalize_range ensuring l >= 1.\n            if number.isNatural() and number.isOdd():\n                current_sum += n\n        \n        result = Result(current_sum)\n        return result.sum\n\ndef sum_in_range(l: int, r: int) -> int:\n    \"\"\"\n    Find the sum of all odd natural numbers within the range l and r.\n    assert sum_in_range(2,5) == 8\n    \"\"\"\n    return SumInRangeFunction().compute(l, r)"}
{"task_id": "Mbpp/801", "solution": "def test_three_equal(a: int, b: int, c: int) -> int:\n    \"\"\"Return how many of the three integer inputs are equal.\n\n    Returns:\n        int: 3 if all three are equal, 2 if exactly two are equal, 0 if all are distinct.\n    \"\"\"\n    if a == b and b == c:\n        return 3\n    elif a == b or a == c or b == c:\n        return 2\n    else:\n        return 0"}
{"task_id": "Mbpp/799", "solution": "MASK: int = 0xFFFFFFFF\n\ndef left_rotate(value: int, d: int) -> int:\n    \"\"\"\n    Rotates the bits of a 32-bit unsigned number to the left by d positions.\n    Bits shifted out from the left re-enter from the right.\n    \"\"\"\n    raw_value = value\n    masked_value = raw_value & MASK\n    d_mod_32 = d % 32\n\n    if d_mod_32 == 0:\n        return masked_value\n\n    left_part = (masked_value << d_mod_32) & MASK\n    wrap_part = masked_value >> (32 - d_mod_32)\n    result = (left_part | wrap_part) & MASK\n    return result"}
