{"task_id": "Mbpp/803", "solution": "class Number:\n    \"\"\"Encapsulates an integer for square root computations.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def sqrt_floor(self) -> int:\n        \"\"\"Computes the integer floor of the square root using binary search.\"\"\"\n        if self.value < 2:\n            return self.value\n\n        low = 0\n        high = self.value // 2 + 1\n        ans = 0\n\n        while low <= high:\n            mid = (low + high) // 2\n            mid_sq = mid * mid\n\n            if mid_sq == self.value:\n                return mid\n            elif mid_sq < self.value:\n                ans = mid\n                low = mid + 1\n            else:\n                high = mid - 1\n        return ans\n\ndef is_perfect_square(n: int) -> bool:\n    \"\"\"Checks if a given integer is a perfect square using an integer-safe algorithm.\"\"\"\n    if n < 0:\n        return False\n    \n    num_obj = Number(n)\n    root = num_obj.sqrt_floor()\n    \n    return (root * root) == n"}
{"task_id": "Mbpp/804", "solution": "from typing import List\n\ndef is_product_even(numbers: List[int]) -> bool:\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    The product is even if at least one number in the list is even.\n    \"\"\"\n    for num in numbers:\n        if num % 2 == 0:\n            return True\n    return False"}
{"task_id": "Mbpp/805", "solution": "from typing import List, Union\n\nclass Number:\n    \"\"\"Typed wrapper for a numeric value.\"\"\"\n    def __init__(self, value: Union[int, float]):\n        self.value = float(value)\n\nclass InnerList:\n    \"\"\"Represents an inner list of numeric elements and computes its arithmetic sum.\"\"\"\n    def __init__(self, elements: List[Number]):\n        self.elements = elements\n\n    def sum(self) -> float:\n        \"\"\"Calculates the arithmetic sum of the numeric elements within this list.\"\"\"\n        return sum(n.value for n in self.elements)\n\nclass ListOfLists:\n    \"\"\"Represents an ordered collection of InnerList instances.\"\"\"\n    def __init__(self, lists: List[InnerList]):\n        self.lists = lists\n\n    def count(self) -> int:\n        \"\"\"Returns the number of inner lists contained in this collection.\"\"\"\n        return len(self.lists)\n\nclass Result:\n    \"\"\"Represents the selection result; contains the selected InnerList.\"\"\"\n    def __init__(self, selected_list: InnerList):\n        self.selected_list = selected_list\n\nclass MaxSumFunction:\n    \"\"\"Executes selection logic over a ListOfLists to find the inner list with the highest sum.\"\"\"\n    def execute(self, listOfLists: ListOfLists) -> Result:\n        \"\"\"Computes per-inner-list sums and returns a Result containing the InnerList with the highest sum.\"\"\"\n        max_inner_list = max(listOfLists.lists, key=lambda inner_list: inner_list.sum())\n        return Result(max_inner_list)\n\ndef max_sum_list(list_of_lists: List[List[Union[int, float]]]) -> List[Union[int, float]]:\n    \"\"\"Public API. Accepts a list (sequence) of inner sequences of numeric values and returns the inner sequence with maximal sum.\"\"\"\n    inner_lists_domain = []\n    for inner_list_raw in list_of_lists:\n        numbers_domain = [Number(element) for element in inner_list_raw]\n        inner_lists_domain.append(InnerList(numbers_domain))\n    \n    list_of_lists_domain = ListOfLists(inner_lists_domain)\n    \n    max_sum_executor = MaxSumFunction()\n    result = max_sum_executor.execute(list_of_lists_domain)\n    \n    return [n.value for n in result.selected_list.elements]"}
{"task_id": "Mbpp/806", "solution": "class MaxRunUppercaseFunction:\n    \"\"\"\n    Implements the scanning logic to compute the maximum contiguous run length\n    of ASCII uppercase letters.\n    \"\"\"\n    def execute(self, input_string: str) -> int:\n        \"\"\"\n        Orchestrates computation and returns the integer result.\n        \"\"\"\n        return self.findMaxRun(input_string)\n\n    def findMaxRun(self, input_string: str) -> int:\n        \"\"\"\n        Core O(n) scanning algorithm to find the longest contiguous uppercase sequence.\n        \"\"\"\n        max_run = 0\n        current_run = 0\n        for char in input_string:\n            # Check if character is an ASCII uppercase letter (A-Z)\n            if 'A' <= char <= 'Z':\n                current_run += 1\n            else:\n                # Character is not uppercase, so the run is broken\n                max_run = max(max_run, current_run)\n                current_run = 0\n        \n        # After the loop, check if the last run was the longest\n        max_run = max(max_run, current_run)\n        return max_run\n\n\ndef max_run_uppercase(input_string: str) -> int:\n    \"\"\"\n    Finds the maximum run of uppercase characters in the given string.\n    \"\"\"\n    calculator = MaxRunUppercaseFunction()\n    result = calculator.execute(input_string)\n    return result"}
{"task_id": "Mbpp/808", "solution": "def check_K(tuple_input, k) -> bool:\n    \"\"\"\n    Checks if the given value k is present in the tuple_input.\n    Returns True if k is found, False otherwise.\n    \"\"\"\n    return k in tuple_input"}
{"task_id": "Mbpp/807", "solution": "from typing import List\n\ndef first_odd(numbers: List[int]) -> int | None:\n    \"\"\"Iterate numbers left-to-right and return the first number where number % 2 != 0, else return None.\"\"\"\n    for number in numbers:\n        if number % 2 != 0:\n            return number\n    return None"}
{"task_id": "Mbpp/809", "solution": "def check_smaller(first_tuple, second_tuple):\n    \"\"\"\n    Checks if each element of second tuple is strictly smaller than its corresponding\n    element in the first tuple.\n    \"\"\"\n    if len(second_tuple) > len(first_tuple):\n        return False\n\n    for i in range(len(second_tuple)):\n        if second_tuple[i] >= first_tuple[i]:\n            return False\n    return True"}
