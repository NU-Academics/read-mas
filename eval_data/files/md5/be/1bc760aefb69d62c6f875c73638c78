{"task_id": "Mbpp/140", "solution": "def extract_singly(input: list) -> set:\n    \"\"\"Accepts a list of inner sequences (tuples/lists) of numbers and returns a set of unique numbers.\n    It flattens the input list of lists into a single set of numbers, handling deduplication automatically.\"\"\"\n    result = set()\n    for seq in input:\n        for item in seq:\n            result.add(item)\n    return result"}
{"task_id": "Mbpp/141", "solution": "def pancake_sort(lst: list) -> list:\n    \"\"\"\n    Sorts a list of elements using the pancake sort algorithm.\n    Returns a new list with elements sorted in non-decreasing order.\n    \"\"\"\n    work_list = lst.copy()\n    n = len(work_list)\n\n    def _find_max_index(arr: list, limit: int) -> int:\n        \"\"\"Finds the index of the maximum element in the prefix arr[0:limit].\"\"\"\n        max_idx = 0\n        for i in range(1, limit):\n            if arr[i] > arr[max_idx]:\n                max_idx = i\n        return max_idx\n\n    def _flip(arr: list, k: int) -> None:\n        \"\"\"Reverses the prefix arr[0:k+1] in-place.\"\"\"\n        start = 0\n        end = k\n        while start < end:\n            arr[start], arr[end] = arr[end], arr[start]\n            start += 1\n            end -= 1\n\n    for curr_size in range(n, 1, -1):\n        # Find index of the maximum element in the current unsorted prefix\n        max_idx = _find_max_index(work_list, curr_size)\n\n        # If max element is not already at its correct sorted position\n        if max_idx != curr_size - 1:\n            # Move the maximum element to the front of the list\n            _flip(work_list, max_idx)\n            # Move the maximum element from the front to its correct position\n            _flip(work_list, curr_size - 1)\n            \n    return work_list"}
{"task_id": "Mbpp/142", "solution": "def _validate_lists(listA, listB, listC) -> None:\n    \"\"\"Validates that each input is a list, raising TypeError otherwise.\"\"\"\n    if not isinstance(listA, list) or not isinstance(listB, list) or not isinstance(listC, list):\n        raise TypeError(\"All inputs must be lists.\")\n\ndef _min_length(listA, listB, listC) -> int:\n    \"\"\"Returns the minimum length among the three input lists.\"\"\"\n    return min(len(listA), len(listB), len(listC))\n\ndef count_samepair(listA, listB, listC) -> int:\n    \"\"\"Return int count of positions where listA[i] == listB[i] == listC[i.\n    Raises: TypeError if any input is not a list.\n    \"\"\"\n    _validate_lists(listA, listB, listC)\n    min_len = _min_length(listA, listB, listC)\n    match_count = 0\n    for i in range(min_len):\n        if listA[i] == listB[i] == listC[i]:\n            match_count += 1\n    return match_count"}
{"task_id": "Mbpp/145", "solution": "def _is_numeric(value):\n    \"\"\"\n    Checks if a value is an integer or a float.\n    \"\"\"\n    return isinstance(value, (int, float))\n\ndef _validate_seq(seq):\n    \"\"\"\n    Validates the input sequence for type, length, and element types.\n    Raises TypeError or ValueError on invalid input.\n    \"\"\"\n    if not isinstance(seq, (list, tuple)):\n        raise TypeError(\"Input must be a list or tuple.\")\n    \n    if len(seq) < 2:\n        raise ValueError(\"Input sequence must contain at least two elements.\")\n    \n    for element in seq:\n        if not _is_numeric(element):\n            raise TypeError(\"All elements in the sequence must be numeric (int or float).\")\n\ndef max_Abs_Diff(seq):\n    \"\"\"\n    Finds the maximum difference between any two elements in a given array.\n    \"\"\"\n    _validate_seq(seq)\n    \n    return max(seq) - min(seq)"}
{"task_id": "Mbpp/160", "solution": "def find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"\n    Finds integers x and y that satisfy ax + by = n as a tuple,\n    or returns None if no solution exists.\n    \"\"\"\n\n    def _extended_gcd(a_val: int, b_val: int) -> tuple[int, int, int]:\n        \"\"\"\n        Computes (g, x, y) such that a_val * x + b_val * y = g = gcd(a_val, b_val).\n        Handles various zero inputs correctly according to standard definitions.\n        \"\"\"\n        if a_val == 0 and b_val == 0:\n            return (0, 0, 0) \n\n        if a_val == 0:\n            return (abs(b_val), 0, 1 if b_val >= 0 else -1)\n        \n        if b_val == 0:\n            return (abs(a_val), 1 if a_val >= 0 else -1, 0)\n\n        r0, r1 = a_val, b_val\n        x0, y0 = 1, 0\n        x1, y1 = 0, 1\n\n        while r1 != 0:\n            q = r0 // r1\n            r0, r1 = r1, r0 - q * r1\n            x0, x1 = x1, x0 - q * x1\n            y0, y1 = y1, y0 - q * y1\n        \n        return (r0, x0, y0)\n\n    class EquationSolver:\n        \"\"\"\n        Internal solver class for linear Diophantine equations.\n        It uses the extended Euclidean algorithm to find a particular solution.\n        \"\"\"\n        def find_solution(self, a_val: int, b_val: int, n_val: int) -> tuple[int, int] | None:\n            \"\"\"\n            Finds integer solutions (x, y) to a_val*x + b_val*y = n_val.\n            Returns a tuple (x, y) if a solution exists, otherwise None.\n            \"\"\"\n            if a_val == 0 and b_val == 0:\n                return (0, 0) if n_val == 0 else None\n            \n            if a_val == 0:\n                if n_val % b_val == 0:\n                    return (0, n_val // b_val)\n                else:\n                    return None\n            \n            if b_val == 0:\n                if n_val % a_val == 0:\n                    return (n_val // a_val, 0)\n                else:\n                    return None\n\n            g, x0, y0 = _extended_gcd(a_val, b_val)\n\n            if n_val % g != 0:\n                return None\n\n            k = n_val // g\n            x_p = x0 * k\n            y_p = y0 * k\n            \n            return (x_p, y_p)\n            \n    solver = EquationSolver()\n    return solver.find_solution(a, b, n)"}
{"task_id": "Mbpp/161", "solution": "def remove_elements(firstList, secondList):\n    \"\"\"Return a new list containing elements from firstList not present in secondList.\n\n    Preserves order of retained elements and removes all occurrences.\n    \"\"\"\n    if not firstList:\n        return []\n    if not secondList:\n        return list(firstList)\n\n    elements_to_remove_set = set(secondList)\n    result = []\n    for element in firstList:\n        if element not in elements_to_remove_set:\n            result.append(element)\n    return result"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the series n + (n-2) + (n-4) + ...\n    only including positive terms.\n    \"\"\"\n    if n <= 0:\n        return 0\n\n    total_sum = 0\n    # The loop should go from i=0 up to n // 2.\n    # The term is n - 2*i. We stop when the term becomes non-positive.\n    for i in range(n // 2 + 1):\n        term = n - 2 * i\n        if term > 0:\n            total_sum += term\n        else:\n            # Terms will only decrease, so if term <= 0, subsequent terms will also be <= 0.\n            break\n    return total_sum"}
{"task_id": "Mbpp/167", "solution": "def is_power_of_two(n: int) -> bool:\n    \"\"\"Return True iff n is a power of two (2^k with k >= 0).\n    Assumes n is a non-negative integer.\n    \"\"\"\n    return n > 0 and (n & (n - 1)) == 0\n\ndef next_power_of_2(n: int) -> int:\n    \"\"\"Return the minimal integer p that is a power of two and p >= n.\n    Assumes n is a non-negative integer.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    if is_power_of_two(n):\n        return n\n\n    # Find the next power of two using a bit manipulation trick.\n    # This trick smears the bits to the right of the most significant bit.\n    n -= 1\n    n |= n >> 1\n    n |= n >> 2\n    n |= n >> 4\n    n |= n >> 8\n    n |= n >> 16\n    n |= n >> 32\n    n |= n >> 64 # Covers large integer sizes in Python\n\n    return n + 1"}
{"task_id": "Mbpp/165", "solution": "class InputString:\n    \"\"\"Provides read-only accessors for the caller-supplied string and its length.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n\n    def charAt(self, index: int) -> str:\n        \"\"\"Returns the character at the specified zero-based index.\"\"\"\n        return self._value[index]\n\n    def __len__(self) -> int:\n        \"\"\"Returns the length of the string.\"\"\"\n        return len(self._value)\n\nclass Character:\n    \"\"\"Holds derived properties for a single char in the input used by CountCharPositionFunction.\"\"\"\n    def __init__(self, value: str, position_zero_based: int):\n        self.value = value\n        self.positionInString = position_zero_based + 1 # 1-based string position\n\nclass CountCharPositionFunction:\n    \"\"\"Encapsulates processing logic to evaluate characters of an InputString and produce matching count.\"\"\"\n    def count(self, input_str_val: str) -> int:\n        \"\"\"Counts characters that match their alphabet position in the input string.\"\"\"\n        matched_count = 0\n        input_string_obj = InputString(input_str_val)\n\n        for zero_based_index in range(len(input_string_obj)):\n            char_value = input_string_obj.charAt(zero_based_index)\n            # Instantiate Character object as per sequence diagram, though its computed properties are not directly used here\n            # because CountCharPositionFunction itself has the comparison methods.\n            Character(char_value, zero_based_index) \n\n            string_pos_one_based = self.indexBasedOnOne(zero_based_index)\n\n            if self.isLetter(char_value):\n                alphabet_pos = self.alphabetPosition(char_value)\n                if alphabet_pos == string_pos_one_based:\n                    matched_count += 1\n        return matched_count\n\n    def isLetter(self, c: str) -> bool:\n        \"\"\"Checks if the character is an English letter (A-Z, a-z).\"\"\"\n        return c.isalpha()\n\n    def alphabetPosition(self, c: str) -> int:\n        \"\"\"Returns the 1-based alphabet position of a letter (case-insensitive).\"\"\"\n        return ord(c.lower()) - ord('a') + 1\n\n    def indexBasedOnOne(self, zeroBasedIndex: int) -> int:\n        \"\"\"Converts a zero-based index to a one-based index.\"\"\"\n        return zeroBasedIndex + 1\n\ndef count_char_position(input: str) -> int:\n    \"\"\"\n    Counts characters in a string that occur at the same position in the string \n    as in the English alphabet (case insensitive).\n    \"\"\"\n    return CountCharPositionFunction().count(input)"}
{"task_id": "Mbpp/168", "solution": "from typing import Any, List\n\nclass EqualityComparator:\n    \"\"\"Encapsulates equality comparison logic using runtime default.\"\"\"\n    def equals(self, a: Any, b: Any) -> bool:\n        return a == b\n\nclass FrequencyResult:\n    \"\"\"Value object holding the integer count.\"\"\"\n    def __init__(self, count: int):\n        self.count = count\n\nclass InputList:\n    \"\"\"Conceptual typed wrapper around the provided list.\"\"\"\n    def __init__(self, elements: List[Any]):\n        self.elements = elements\n\nclass Element:\n    \"\"\"Conceptual wrapper for a single list element.\"\"\"\n    def __init__(self, value: Any):\n        self.value = value\n\nclass FrequencyService:\n    \"\"\"Stateless domain service that iterates elements and counts matches.\"\"\"\n    def frequency(self, elements: List[Any], value: Any) -> int:\n        count = 0\n        comparator = EqualityComparator()\n        for element in elements:\n            if comparator.equals(element, value):\n                count += 1\n        _ = FrequencyResult(count) # Create result object for traceability as per design.\n        return count\n\ndef frequency(list, value) -> int:\n    \"\"\"\n    Counts the number of occurrences of a number in a given list.\n    Delegates to an internal FrequencyService for computation.\n    \"\"\"\n    service = FrequencyService()\n    return service.frequency(list, value)"}
{"task_id": "Mbpp/166", "solution": "from typing import List\n\nclass InputList:\n    \"\"\"Represents the input list of integers as a domain value object and provides length.\"\"\"\n    def __init__(self, elements: List[int]) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        return len(self.elements)\n\nclass IntegerElement:\n    \"\"\"Represents a single integer element with its index.\"\"\"\n    def __init__(self, value: int, index: int) -> None:\n        self.value = value\n        self.index = index\n\nclass Pair:\n    \"\"\"Represents an unordered pair of IntegerElements and computes XOR and parity.\"\"\"\n    def __init__(self, i: int, j: int, a_value: int, b_value: int) -> None:\n        self.i = i\n        self.j = j\n        self.xor_value = a_value ^ b_value\n\n    def is_even(self) -> bool:\n        \"\"\"Returns True if the XOR value of the pair is even, False otherwise.\"\"\"\n        return self.xor_value % 2 == 0\n\nclass PairCounter:\n    \"\"\"Maintains and provides the count of even-xor pairs.\"\"\"\n    def __init__(self) -> None:\n        self.count = 0\n\n    def increment(self, delta: int = 1) -> None:\n        self.count += delta\n\n    def value(self) -> int:\n        return self.count\n\nclass Finder:\n    \"\"\"Encapsulates algorithm to compute number of unordered index pairs (i < j) with even XOR.\"\"\"\n    def find_even_pair(self, values: List[int]) -> int:\n        input_list = InputList(values)\n        if input_list.length() < 2:\n            return 0\n\n        pair_counter = PairCounter()\n\n        # Iterate through all unique unordered pairs (i, j) with i < j.\n        for i in range(input_list.length() - 1):\n            for j in range(i + 1, input_list.length()):\n                val_a = input_list.elements[i]\n                val_b = input_list.elements[j]\n\n                # Create a Pair object and check if its XOR sum is even.\n                pair = Pair(i, j, val_a, val_b)\n                if pair.is_even():\n                    pair_counter.increment()\n\n        return pair_counter.value()\n\ndef find_even_pair(values: List[int]) -> int:\n    \"\"\"\n    Counts the number of pairs of integers in a list that xor to an even number.\n    Delegates the computation to the Finder class.\n    \"\"\"\n    finder = Finder()\n    return finder.find_even_pair(values)"}
{"task_id": "Mbpp/171", "solution": "from typing import Optional\n\nclass Measurement:\n    \"\"\"Lightweight container for a numeric value and optional unit.\"\"\"\n    def __init__(self, value: float, unit: Optional[str] = None) -> None:\n        self.value = float(value)\n        self.unit = unit\n\nclass Pentagon:\n    \"\"\"Domain entity encapsulating a regular pentagon's side length and perimeter.\"\"\"\n    def __init__(self, side_length: float, unit: Optional[str] = None) -> None:\n        self.side_length = float(side_length)\n        self.unit = unit\n        self.perimeter = 0.0\n\n    def compute_perimeter(self) -> float:\n        \"\"\"Computes and sets the perimeter based on side_length.\"\"\"\n        self.perimeter = 5 * self.side_length\n        return self.perimeter\n\ndef perimeter_pentagon(side_length: float) -> float:\n    \"\"\"\n    Computes and returns the perimeter of a regular pentagon from its side length.\n    It instantiates a Pentagon object and uses its compute_perimeter method.\n    \"\"\"\n    p = Pentagon(side_length)\n    return p.compute_perimeter()"}
{"task_id": "Mbpp/170", "solution": "class IndexValidator:\n    \"\"\"\n    Validates if start_index and end_index are within the bounds of a list.\n    Assumes indices are integers and does not perform type checking.\n    \"\"\"\n    def validate(self, start_index: int, end_index: int, length: int) -> bool:\n        # Per prompt: \"Do NOT add isinstance() checks or raise exceptions for edge cases\".\n        # Therefore, assuming start_index and end_index are integers.\n        # This validator checks if the proposed range is logically valid for list slicing.\n        if not (0 <= start_index and start_index <= end_index and end_index < length):\n            return False\n        return True\n\nclass SumRangeService:\n    \"\"\"\n    Orchestrates index validation and computes the sum of elements within a specified range.\n    Delegates index validation to IndexValidator.\n    \"\"\"\n    def __init__(self):\n        self._validator = IndexValidator()\n\n    def sum_range_list(self, lst: list, start_index: int, end_index: int):\n        # Per prompt: \"Do NOT add isinstance() checks or raise exceptions for edge cases\".\n        # Therefore, if validation fails, we cannot explicitly raise IndexError.\n        # Python's list slicing will naturally raise IndexError if indices are out of bounds.\n        self._validator.validate(start_index, end_index, len(lst)) # Validator still called for design adherence\n\n        # Compute inclusive sum: sum(lst[start_index:end_index + 1])\n        return sum(lst[start_index : end_index + 1])\n\n\ndef sum_range_list(lst: list, start_index: int, end_index: int):\n    \"\"\"\n    Calculates the sum of numbers in a list within a specified range (inclusive).\n    Delegates to SumRangeService for logic and (limited) validation.\n    \"\"\"\n    return SumRangeService().sum_range_list(lst, start_index, end_index)"}
