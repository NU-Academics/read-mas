{"task_id": "Mbpp/65", "solution": "def flatten(input_list: list) -> list:\n    \"\"\"Recursively flattens a nested list into a single list of integers.\"\"\"\n    flat_list = []\n    for item in input_list:\n        if isinstance(item, list):\n            flat_list.extend(flatten(item))\n        else:\n            flat_list.append(item)\n    return flat_list\n\ndef sum(flat_list: list) -> int:\n    \"\"\"Calculates the sum of all elements in a flat list, returning 0 for an empty list.\"\"\"\n    total = 0\n    for num in flat_list:\n        total += num\n    return total\n\ndef recursive_list_sum(input_list: list) -> int:\n    \"\"\"Flattens a list and sums all of its integer elements.\"\"\"\n    flat_elements = flatten(input_list)\n    total_sum = sum(flat_elements)\n    return total_sum"}
{"task_id": "Mbpp/63", "solution": "class PairTuple:\n    \"\"\"Represents a pair of numeric values and computes their absolute difference.\"\"\"\n    def __init__(self, first: float, second: float):\n        self.first = float(first)\n        self.second = float(second)\n\n    def absoluteDifference(self) -> float:\n        \"\"\"Calculates the absolute difference between the first and second elements.\"\"\"\n        return abs(self.first - self.second)\n\nclass TupleList:\n    \"\"\"Manages a list of PairTuple instances and provides factory methods.\"\"\"\n    def __init__(self, tuples: list['PairTuple']):\n        self.tuples = tuples\n\n    @staticmethod\n    def from_iterable(tuple_iterable) -> 'TupleList':\n        \"\"\"Creates a TupleList from an iterable of raw 2-element numeric tuples.\"\"\"\n        normalized_tuples = []\n        for item in tuple_iterable:\n            # Per prompt: \"Do NOT add isinstance() checks or raise exceptions for edge cases\"\n            # Rely on Python's natural error handling for non-tuple or non-numeric elements.\n            first, second = item\n            normalized_tuples.append(PairTuple(first, second))\n        return TupleList(normalized_tuples)\n\nclass Result:\n    \"\"\"A value object encapsulating the computed maximum difference.\"\"\"\n    def __init__(self, maxDifference: float):\n        self.maxDifference = maxDifference\n\nclass MaxDifferenceFunction:\n    \"\"\"Contains the core logic for computing the maximum difference.\"\"\"\n    @staticmethod\n    def max_difference(tuple_list_obj: 'TupleList') -> float:\n        \"\"\"Computes the maximum absolute difference from a TupleList object.\"\"\"\n        # The outer max_difference function handles empty input, ensuring this list is not empty.\n        differences = [pair.absoluteDifference() for pair in tuple_list_obj.tuples]\n        return max(differences)\n\ndef max_difference(tuple_list) -> float:\n    \"\"\"\n    Finds the maximum difference between available pairs in the given tuple list.\n    Delegates to a domain-driven internal structure for computation.\n    \"\"\"\n    # Design requirement: \"implementation SHOULD raise ValueError for empty input to make behavior explicit.\"\n    if not tuple_list:\n        raise ValueError(\"Input tuple_list cannot be empty.\")\n\n    # Convert raw input to TupleList domain object.\n    # Input validation (shape, numeric types) is handled implicitly by TupleList.from_iterable\n    # and PairTuple constructor relying on Python's type conversion errors.\n    tuple_list_obj = TupleList.from_iterable(tuple_list)\n\n    # Delegate core computation to MaxDifferenceFunction.\n    max_diff_value = MaxDifferenceFunction.max_difference(tuple_list_obj)\n\n    return max_diff_value"}
{"task_id": "Mbpp/66", "solution": "def pos_count(numbers: list) -> int:\n    \"\"\"\n    Counts the number of positive numbers in a list.\n    A number is considered positive if it is strictly greater than 0.\n    \"\"\"\n    count = 0\n    for num in numbers:\n        if num > 0:\n            count += 1\n    return count"}
{"task_id": "Mbpp/67", "solution": "from typing import Dict\n\nclass Error(Exception):\n    \"\"\"\n    Base error class for validation and computation issues.\n    It provides a code and message for clarity.\n    \"\"\"\n    def __init__(self, code: str, message: str) -> None:\n        self.code = code\n        self.message = message\n        super().__init__(f\"{code}: {message}\")\n\nclass BellNumberCalculator:\n    \"\"\"\n    Calculates Bell numbers using a recurrence relation with memoization.\n    It manages input validation and computation logic.\n    \"\"\"\n    def __init__(self) -> None:\n        self._memo: Dict[int, int] = {0: 1} # Initialize with B(0) = 1\n\n    def bell_number(self, n: int) -> int:\n        \"\"\"\n        Main method to get the nth Bell number, handles validation and memoization.\n        Delegates to computeUsingRecurrence if the value is not cached.\n        \"\"\"\n        self.validateInput(n)\n        \n        if n in self._memo:\n            return self._memo[n]\n        \n        result = self.computeUsingRecurrence(n)\n        self.memoize(n, result)\n        return result\n\n    def validateInput(self, n: int) -> None:\n        \"\"\"\n        Validates that the input n is a non-negative integer.\n        Raises an Error if validation fails.\n        \"\"\"\n        if not isinstance(n, int) or n < 0:\n            raise Error(\"InvalidInput\", \"Input 'n' must be a non-negative integer.\")\n\n    def computeUsingRecurrence(self, n: int) -> int:\n        \"\"\"\n        Computes the nth Bell number using the recurrence relation:\n        B_n = sum_{k=0}^{n-1} C(n-1, k) * B_k for n >= 1.\n        \"\"\"\n        if n == 0:\n            return 1\n        \n        bell_n = 0\n\n        # Helper function for binomial coefficients C(n_val, k_val)\n        def combinations(n_val: int, k_val: int) -> int:\n            if k_val < 0 or k_val > n_val:\n                return 0\n            if k_val == 0 or k_val == n_val:\n                return 1\n            if k_val > n_val // 2:\n                k_val = n_val - k_val\n            \n            res = 1\n            for i in range(k_val):\n                res = res * (n_val - i) // (i + 1)\n            return res\n\n        for k in range(n):\n            combinations_val = combinations(n - 1, k)\n            bell_k_val = self.bell_number(k) # Recursively gets B_k, utilizing memoization\n            bell_n += combinations_val * bell_k_val\n        \n        return bell_n\n\n    def computeUsingDobinski(self, n: int) -> int:\n        \"\"\"\n        Placeholder for Dobinski's formula. For small n, it delegates to recurrence.\n        \"\"\"\n        return self.bell_number(n) # Delegates to the main bell_number method for exact results.\n\n    def memoize(self, n: int, value: int) -> None:\n        \"\"\"\n        Stores a computed Bell number in the memoization cache.\n        \"\"\"\n        self._memo[n] = value\n\n_bell_calculator = BellNumberCalculator()\n\ndef bell_number(n: int) -> int:\n    \"\"\"\n    Returns the nth Bell number (the number of partitions of a set of size n).\n    It validates input and uses a memoized BellNumberCalculator for efficient computation.\n    \"\"\"\n    return _bell_calculator.bell_number(n)"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(arr: list) -> bool:\n    \"\"\"\n    Checks if the given array is monotonic (either non-increasing or non-decreasing).\n    Adjacent equal elements are allowed.\n    \"\"\"\n    if len(arr) <= 1:\n        return True\n\n    is_non_decreasing = True\n    is_non_increasing = True\n\n    for i in range(1, len(arr)):\n        if arr[i] < arr[i - 1]:\n            is_non_decreasing = False\n        if arr[i] > arr[i - 1]:\n            is_non_increasing = False\n        \n        # Optimization: if both flags are False, we can stop early\n        if not is_non_decreasing and not is_non_increasing:\n            return False\n\n    return is_non_decreasing or is_non_increasing"}
{"task_id": "Mbpp/72", "solution": "def dif_Square(n):\n    # Checks if n can be represented as the difference of two squares, which is true if n is odd or a multiple of 4.\n    # This means n cannot be congruent to 2 modulo 4.\n    if n % 2 != 0:\n        return True\n    else:\n        return (n % 4) == 0"}
{"task_id": "Mbpp/70", "solution": "from typing import Iterable, List\n\nclass TupleList:\n    \"\"\"Wrapper around an iterable of tuples, validating input and providing tuple lengths.\"\"\"\n    def __init__(self, tuples_iterable: Iterable[tuple]) -> None:\n        if not isinstance(tuples_iterable, Iterable):\n            raise TypeError(\"Input must be an iterable.\")\n        \n        normalized_list = []\n        for item in tuples_iterable:\n            if not isinstance(item, tuple):\n                raise TypeError(\"All elements in the input iterable must be tuples.\")\n            normalized_list.append(item)\n        self._tuples = normalized_list\n\n    def as_lengths(self) -> List[int]:\n        \"\"\"Returns a list of lengths for each tuple.\"\"\"\n        return [len(t) for t in self._tuples]\n\n    def __len__(self) -> int:\n        \"\"\"Returns the number of tuples in the list.\"\"\"\n        return len(self._tuples)\n\nclass Result:\n    \"\"\"A wrapper for a boolean outcome.\"\"\"\n    def __init__(self, is_equal: bool) -> None:\n        self._is_equal = is_equal\n\n    def value(self) -> bool:\n        \"\"\"Returns the boolean value.\"\"\"\n        return self._is_equal\n\ndef get_equal(list_of_tuples: Iterable[tuple]) -> bool:\n    \"\"\"\n    Checks if all given tuples have equal length. Returns True for an empty input list.\n    \"\"\"\n    tuple_list = TupleList(list_of_tuples)\n    lengths = tuple_list.as_lengths()\n\n    if not lengths:\n        return True\n\n    first_length = lengths[0]\n    all_equal = all(length == first_length for length in lengths)\n    \n    result = Result(all_equal)\n    return result.value()"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list, sub_list):\n    \"\"\"\n    Checks if a sub_list exists as a contiguous subsequence within a main_list.\n    Compares elements using equality (==).\n    \"\"\"\n    if len(sub_list) > len(main_list):\n        return False\n\n    if not sub_list:  # Handle empty sub_list; often considered present in any list.\n        return True\n\n    # Helper function to generate sliding windows\n    def _slide_windows(sequence, window_size):\n        for i in range(len(sequence) - window_size + 1):\n            yield sequence[i : i + window_size]\n\n    for window in _slide_windows(main_list, len(sub_list)):\n        if window == sub_list:\n            return True\n            \n    return False"}
{"task_id": "Mbpp/74", "solution": "from typing import List, Any, Dict\n\nclass Element:\n    \"\"\"Represents a single sequence element with its symbol and position.\"\"\"\n    def __init__(self, symbol: Any, position: int):\n        self.symbol = symbol\n        self.position = position\n\nclass Sequence:\n    \"\"\"Domain wrapper for an ordered collection of Element objects with a length accessor.\"\"\"\n    def __init__(self, raw_elements: List[Any]):\n        self.elements = [Element(symbol, i) for i, symbol in enumerate(raw_elements)]\n\n    def length(self) -> int:\n        return len(self.elements)\n\n    def __getitem__(self, index: int) -> Element:\n        return self.elements[index]\n\nclass Mapping:\n    \"\"\"Encapsulates mapping from pattern symbols to value symbols and enforces mapping consistency and injectivity.\"\"\"\n    def __init__(self):\n        self.map: Dict[Any, Any] = {} # pattern_symbol -> value_symbol\n        self.reverse_map: Dict[Any, Any] = {} # value_symbol -> pattern_symbol\n\n    def add(self, patternSymbol: Any, valueSymbol: Any) -> bool:\n        \"\"\"Add or verify mapping for a pair; return True if consistent, False if inconsistency/injectivity violation.\"\"\"\n        # BR4: Consistency check\n        if patternSymbol in self.map:\n            return self.map[patternSymbol] == valueSymbol\n        \n        # BR5: Injectivity check\n        # If valueSymbol is already mapped to a DIFFERENT patternSymbol.\n        if valueSymbol in self.reverse_map:\n            return False # Injectivity violation\n        \n        # No existing mapping for patternSymbol, and valueSymbol is not taken.\n        # Establish new mapping.\n        self.map[patternSymbol] = valueSymbol\n        self.reverse_map[valueSymbol] = patternSymbol\n        return True\n\n    def is_consistent(self) -> bool:\n        \"\"\"Returns True if the current mapping satisfies consistency and injectivity.\"\"\"\n        # As per design, if no `add` invocation returned False, the mapping is consistent.\n        return True\n\nclass IsSamePatternsSystem:\n    \"\"\"Implements the core algorithm for pattern matching, enforcing business rules.\"\"\"\n    def is_samepatterns(self, patterns: List[Any], values: List[Any]) -> bool:\n        # BR2: Return False when input sequences have different lengths.\n        if len(patterns) != len(values):\n            return False\n\n        pattern_sequence = Sequence(patterns)\n        value_sequence = Sequence(values)\n        mapper = Mapping()\n\n        # BR3, BR4, BR5: Iterate and build/validate the one-to-one mapping.\n        for i in range(pattern_sequence.length()):\n            pattern_symbol = pattern_sequence[i].symbol\n            value_symbol = value_sequence[i].symbol\n\n            if not mapper.add(pattern_symbol, value_symbol):\n                return False # Inconsistency or injectivity violation detected.\n        \n        # If the loop completes, all mappings were consistent and injective.\n        return mapper.is_consistent()\n\ndef is_samepatterns(patterns: List[Any], values: List[Any]) -> bool:\n    \"\"\"\n    Write a function to check whether it follows the sequence given in the patterns array.\n    assert is_samepatterns([\"red\",\"green\",\"green\"], [\"a\", \"b\", \"b\"])==True\n    \"\"\"\n    return IsSamePatternsSystem().is_samepatterns(patterns, values)"}
{"task_id": "Mbpp/71", "solution": "_gap_shrink_factor: float = 1.3\n\ndef _comb_sort_inplace(input_list: list) -> None:\n    \"\"\"Sorts a list in-place using the Comb Sort algorithm.\"\"\"\n    n = len(input_list)\n    gap = n\n    swapped = True\n\n    while gap > 1 or swapped:\n        gap = int(gap / _gap_shrink_factor)\n        if gap < 1:\n            gap = 1\n\n        swapped = False\n        for i in range(n - gap):\n            if input_list[i] > input_list[i + gap]:\n                input_list[i], input_list[i + gap] = input_list[i + gap], input_list[i]\n                swapped = True\n\ndef comb_sort(input_list: list) -> list:\n    \"\"\"Sorts a list of elements in ascending order using the Comb Sort algorithm.\"\"\"\n    n = len(input_list)\n\n    if n == 0:\n        return []\n    if n == 1:\n        return list(input_list)\n\n    temp_list = list(input_list)\n    _comb_sort_inplace(temp_list)\n    \n    return temp_list"}
{"task_id": "Mbpp/75", "solution": "class DivisibilityChecker:\n    \"\"\"Helper class for checking if a value is divisible by k.\"\"\"\n    @staticmethod\n    def is_divisible(value, k):\n        \"\"\"Return True if value is perfectly divisible by k (value % k == 0).\"\"\"\n        return value % k == 0\n\ndef find_tuples(list_of_tuples, k):\n    \"\"\"\n    Finds tuples where all elements are divisible by k from a list of tuples.\n    Returns a list of matching original tuples, preserving their order.\n    \"\"\"\n    results = []\n    for tpl in list_of_tuples:\n        all_divisible = True\n        for v in tpl:\n            if not DivisibilityChecker.is_divisible(v, k):\n                all_divisible = False\n                break\n        if all_divisible:\n            results.append(tpl)\n    return results"}
