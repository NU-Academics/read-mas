{"task_id": "Mbpp/392", "solution": "from typing import Optional\n\nclass MemoizationCache:\n    \"\"\"A simple in-memory cache for memoization.\"\"\"\n    def __init__(self) -> None:\n        self._cache: dict[int, int] = {}\n\n    def get(self, n: int) -> Optional[int]:\n        \"\"\"Retrieves a cached value for n.\"\"\"\n        return self._cache.get(n)\n\n    def put(self, n: int, value: int) -> None:\n        \"\"\"Stores a value for n in the cache.\"\"\"\n        self._cache[n] = value\n\n    def contains(self, n: int) -> bool:\n        \"\"\"Checks if n is present in the cache.\"\"\"\n        return n in self._cache\n\nclass GetMaxSumFunction:\n    \"\"\"Computes f(n) using memoization based on the recurrence relation.\"\"\"\n    def __init__(self, cache: MemoizationCache | None = None) -> None:\n        self._cache = cache if cache is not None else MemoizationCache()\n\n    def get_max_sum(self, n: int) -> int:\n        \"\"\"Public method to compute the maximum sum for n using memoization.\"\"\"\n        if self._cache.contains(n):\n            return self._cache.get(n) # type: ignore\n\n        result = self._compute(n)\n        self._cache.put(n, result)\n        return result\n\n    def _compute(self, n: int) -> int:\n        \"\"\"Internal recursive computation of f(n) without direct cache lookup.\"\"\"\n        if n == 0:\n            return 0\n\n        # Recursively call the public-facing method that handles caching for subproblems\n        val_n_div_2 = self.get_max_sum(n // 2)\n        val_n_div_3 = self.get_max_sum(n // 3)\n        val_n_div_4 = self.get_max_sum(n // 4)\n        val_n_div_5 = self.get_max_sum(n // 5)\n\n        sum_children = val_n_div_2 + val_n_div_3 + val_n_div_4 + val_n_div_5\n        \n        return max(sum_children, n)\n\n# Instantiate the calculator once at the module level to maintain a persistent cache.\n_get_max_sum_calculator = GetMaxSumFunction()\n\ndef get_max_sum(n: int) -> int:\n    \"\"\"\n    Finds the maximum sum using the equation f(n) = max((f(n/2) + f(n/3) + f(n/4) + f(n/5)), n).\n    Uses memoization for efficient computation with base case f(0)=0.\n    \"\"\"\n    return _get_max_sum_calculator.get_max_sum(n)"}
