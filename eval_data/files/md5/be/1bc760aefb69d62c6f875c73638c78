{"task_id": "Mbpp/723", "solution": "def count_same_pair(listA, listB):\n    \"\"\"\n    Counts indices where two lists of the same length have equal values.\n    Raises ValueError if the input lists do not have the same length.\n    \"\"\"\n    if len(listA) != len(listB):\n        raise ValueError(\"Input lists must have the same length\")\n\n    count = 0\n    for i in range(len(listA)):\n        if listA[i] == listB[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/722", "solution": "def _is_numeric(value) -> bool:\n    \"\"\"Checks if a value is a non-boolean integer or float.\"\"\"\n    return isinstance(value, (int, float)) and not isinstance(value, bool)\n\ndef _validate_inputs(students, minHeight, minWeight) -> None:\n    \"\"\"Validates the types and structure of input parameters.\"\"\"\n    if not isinstance(students, dict):\n        raise TypeError(\"Input 'students' must be a dictionary.\")\n\n    if not _is_numeric(minHeight):\n        raise TypeError(\"Input 'minHeight' must be a numeric value.\")\n    if not _is_numeric(minWeight):\n        raise TypeError(\"Input 'minWeight' must be a numeric value.\")\n\n    for name, data in students.items():\n        if not isinstance(name, str):\n            raise TypeError(f\"Student name '{name}' must be a string.\")\n        if not isinstance(data, tuple):\n            raise TypeError(f\"Value for student '{name}' must be a tuple.\")\n        if len(data) != 2:\n            raise ValueError(f\"Tuple for student '{name}' must contain exactly two elements (height, weight).\")\n        height, weight = data\n        if not _is_numeric(height) or not _is_numeric(weight):\n            raise TypeError(f\"Height and weight for student '{name}' must be numeric.\")\n\ndef filter_data(students: dict, minHeight: float, minWeight: float) -> dict:\n    \"\"\"\n    Filters a dictionary of students, returning only those whose height and weight\n    are above or equal to the specified minimums.\n    \"\"\"\n    _validate_inputs(students, minHeight, minWeight)\n\n    filtered_students = {}\n    for name, data in students.items():\n        height, weight = data\n        if height >= minHeight and weight >= minWeight:\n            filtered_students[name] = data\n    return filtered_students"}
{"task_id": "Mbpp/725", "solution": "from typing import List\nimport re\n\ndef extract_quotation(input: str) -> List[str]:\n    \"\"\"\n    Extracts all substrings enclosed by double quotation marks from the input string.\n    Returns a list of these substrings, excluding the quotation marks themselves, in order of appearance.\n    \"\"\"\n    return re.findall(r'\"([^\"]*)\"', input)"}
{"task_id": "Mbpp/724", "solution": "from src.domain import InputParameters, PowerComputation, DigitSumCalculator, Result\n\ndef power_base_sum(base, power):\n    \"\"\"\n    Calculates the sum of all digits of the base to the specified power.\n    \"\"\"\n    input_params = InputParameters(base, power)\n    input_params.validate()\n\n    power_calculator = PowerComputation()\n    power_calculator.compute(base, power)\n\n    digit_sum_calculator = DigitSumCalculator()\n    digit_sum_calculator.computeSum(power_calculator.value)\n\n    result_obj = Result(digit_sum_calculator.sum)\n    return result_obj.toInt()"}
{"task_id": "Mbpp/721", "solution": "class Cell:\n    \"\"\"Represents a cell in the matrix with its row, column, and cost.\"\"\"\n    def __init__(self, row: int, col: int, cost: float):\n        self.row = row\n        self.col = col\n        self.cost = cost\n\nclass Matrix:\n    \"\"\"\n    Represents the square matrix, holding Cell objects.\n    Provides methods for access and structure validation.\n    \"\"\"\n    def __init__(self, cells_data: list[list['Cell']]):\n        self._cells = cells_data\n        self.size = len(cells_data) if cells_data else 0\n\n    @classmethod\n    def from_list(cls, matrix_list: list) -> 'Matrix':\n        \"\"\"Constructs a Matrix instance from a list of lists.\"\"\"\n        if not matrix_list:\n            return cls([])\n\n        n_rows = len(matrix_list)\n        cells_data: list[list[Cell]] = []\n        for r_idx in range(n_rows):\n            current_row_list = matrix_list[r_idx]\n            row_cells = []\n            for c_idx in range(len(current_row_list)):\n                row_cells.append(Cell(r_idx, c_idx, current_row_list[c_idx]))\n            cells_data.append(row_cells)\n        return cls(cells_data)\n\n    def getCell(self, row: int, col: int) -> 'Cell':\n        \"\"\"Retrieves the Cell at the specified row and column.\"\"\"\n        return self._cells[row][col]\n\n    def isSquare(self) -> bool:\n        \"\"\"Checks if the matrix is square (N*N with N >= 1).\"\"\"\n        if not self._cells or self.size == 0:\n            return False\n        \n        for row_cells in self._cells:\n            if len(row_cells) != self.size:\n                return False\n        return True\n\n    @property\n    def all_cells(self) -> list['Cell']:\n        \"\"\"Returns a flattened list of all cells in the matrix.\"\"\"\n        flat_cells = []\n        for row in self._cells:\n            flat_cells.extend(row)\n        return flat_cells\n\nclass Path:\n    \"\"\"Represents a path through the matrix as an ordered list of Cell objects.\"\"\"\n    def __init__(self, cells: list['Cell']):\n        self._cells = cells\n\n    def length(self) -> int:\n        \"\"\"Returns the number of cells in the path.\"\"\"\n        return len(self._cells)\n\n    def totalCost(self) -> float:\n        \"\"\"Calculates the sum of costs of all cells in the path.\"\"\"\n        return sum(cell.cost for cell in self._cells)\n\n    def average(self) -> float:\n        \"\"\"Calculates the average cost per cell for the path.\"\"\"\n        path_length = self.length()\n        if path_length == 0:\n            return 0.0 # A path is guaranteed to have at least one cell.\n        return self.totalCost() / path_length\n\nclass Validator:\n    \"\"\"Provides methods to validate the structure and content of a Matrix.\"\"\"\n    def validateMatrix(self, m: 'Matrix') -> bool:\n        \"\"\"Validates if the matrix is non-empty and square (N*N, N >= 1).\"\"\"\n        if m.size == 0 or not m.isSquare():\n            return False\n        return True\n\n    def validateCellTypes(self, m: 'Matrix') -> bool:\n        \"\"\"Validates if all cell costs in the matrix are numeric (int or float).\"\"\"\n        for cell in m.all_cells:\n            if not isinstance(cell.cost, (int, float)):\n                return False\n        return True\n\nclass PathEnumerator:\n    \"\"\"Enumerates all valid paths (right or down moves) from top-left to bottom-right.\"\"\"\n    def enumeratePaths(self, m: 'Matrix') -> list['Path']:\n        \"\"\"Generates a list of all possible valid paths within the matrix.\"\"\"\n        all_paths: list[Path] = []\n        if m.size == 0:\n            return all_paths\n\n        N = m.size\n        \n        def _dfs(r: int, c: int, current_path_cells: list['Cell']):\n            cell = m.getCell(r, c)\n            current_path_cells.append(cell)\n\n            if r == N - 1 and c == N - 1:\n                all_paths.append(Path(list(current_path_cells))) # Store a copy of the path\n                current_path_cells.pop() # Backtrack\n                return\n\n            # Move right\n            if c + 1 < N:\n                _dfs(r, c + 1, current_path_cells)\n            \n            # Move down\n            if r + 1 < N:\n                _dfs(r + 1, c, current_path_cells)\n            \n            current_path_cells.pop() # Backtrack\n\n        _dfs(0, 0, [])\n        return all_paths\n\nclass AverageCalculator:\n    \"\"\"Provides methods to compute total cost and average cost for a given path.\"\"\"\n    def computeTotal(self, path: 'Path') -> float:\n        \"\"\"Computes the total cost of a path.\"\"\"\n        return path.totalCost()\n\n    def computeAverage(self, path: 'Path') -> float:\n        \"\"\"Computes the average cost of a path.\"\"\"\n        return path.average()\n\nclass Result:\n    \"\"\"A data transfer object to hold the maximum average found and its corresponding path.\"\"\"\n    def __init__(self, maxAverage: float, maxPath: 'Path' = None):\n        self.maxAverage = maxAverage\n        self.maxPath = maxPath\n\n\ndef maxAverageOfPath(matrix: list) -> float:\n    \"\"\"\n    Given a square matrix, finds the path from top-left to bottom-right \n    (moving only right or down) with the maximum average cost.\n    \"\"\"\n    m = Matrix.from_list(matrix)\n    \n    validator = Validator()\n    if not validator.validateMatrix(m) or not validator.validateCellTypes(m):\n        raise ValueError(\"input must be non-empty square matrix with numeric cells\")\n    \n    enumerator = PathEnumerator()\n    paths = enumerator.enumeratePaths(m)\n    \n    avg_calc = AverageCalculator()\n    best = Result(maxAverage=float('-inf'), maxPath=None)\n    \n    for p in paths:\n        avg = avg_calc.computeAverage(p)\n        if avg > best.maxAverage:\n            best.maxAverage = avg\n            best.maxPath = p\n            \n    return best.maxAverage"}
{"task_id": "Mbpp/728", "solution": "from typing import List, Union, Sequence\n\nNumber = Union[int, float]\n\ndef validate_equal_length(a: Sequence, b: Sequence) -> bool:\n    \"\"\"Checks if two sequences have the same length.\"\"\"\n    return len(a) == len(b)\n\ndef sum_list(a: List[Number], b: List[Number]) -> List[Number]:\n    \"\"\"\n    Computes the element-wise sum of two lists.\n    Raises ValueError if input lists have different lengths.\n    \"\"\"\n    if not validate_equal_length(a, b):\n        raise ValueError(\"Input lists must be of equal length.\")\n\n    result: List[Number] = []\n    for x, y in zip(a, b):\n        result.append(x + y)\n    return result"}
{"task_id": "Mbpp/730", "solution": "def consecutive_duplicates(input_list):\n    \"\"\"\n    Removes consecutive duplicates from a list, preserving the order of unique elements.\n    Returns a new list with each contiguous run of equal adjacent elements represented by one element.\n    \"\"\"\n    if not input_list:\n        return []\n\n    result = []\n    for item in input_list:\n        if not result or item != result[-1]:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/731", "solution": "from math import sqrt, pi\n\ndef compute_slant_height(r: float, h: float) -> float:\n    \"\"\"Calculates the slant height of a cone.\"\"\"\n    return sqrt(r*r + h*h)\n\ndef compute_lateral_surface_area(r: float, l: float) -> float:\n    \"\"\"Calculates the lateral surface area of a cone.\"\"\"\n    return pi * r * l\n\ndef lateralsurface_cone(r, h):\n    \"\"\"\n    Finds the lateral surface area of a cone given radius r and height h.\n    \"\"\"\n    slant_height = compute_slant_height(r, h)\n    area = compute_lateral_surface_area(r, slant_height)\n    return area"}
{"task_id": "Mbpp/726", "solution": "from typing import Tuple, Union\n\nNumber = Union[int, float]\n\nclass Error(ValueError):\n    \"\"\"Represents an error condition, inheriting from ValueError as specified.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(message)\n\nclass Element:\n    \"\"\"Lightweight holder for a single element value and position.\"\"\"\n    def __init__(self, value: Number, position: int):\n        self.value = value\n        self.position = position\n\nclass InputTuple:\n    \"\"\"Represent and provide read access to the input ordered collection and its length.\"\"\"\n    def __init__(self, elements: Tuple[Number, ...]):\n        self._elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the input tuple.\"\"\"\n        return len(self._elements)\n\n    @property\n    def elements(self) -> Tuple[Number, ...]:\n        \"\"\"Provides read access to the raw elements.\"\"\"\n        return self._elements\n\nclass OutputTuple:\n    \"\"\"Represent computed output tuple and its length.\"\"\"\n    def __init__(self, elements: Tuple[Number, ...]):\n        self._elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the output tuple.\"\"\"\n        return len(self._elements)\n\n    @property\n    def elements(self) -> Tuple[Number, ...]:\n        \"\"\"Provides read access to the computed elements.\"\"\"\n        return self._elements\n\nclass Validator:\n    \"\"\"Validates preconditions: length >= 2 and element types numeric (int or float).\"\"\"\n    @staticmethod\n    def validate_length(input_tuple: InputTuple) -> bool:\n        \"\"\"Validates if the input tuple has at least 2 elements.\"\"\"\n        if input_tuple.length() < 2:\n            raise Error(\"input length must be >= 2\")\n        return True\n\n    @staticmethod\n    def validate_types(input_tuple: InputTuple) -> bool:\n        \"\"\"Validates if all elements in the input tuple are numeric (int or float).\"\"\"\n        for element in input_tuple.elements:\n            if not isinstance(element, (int, float)):\n                raise Error(\"all elements must be numeric\")\n        return True\n\nclass MultiplyElementsService:\n    \"\"\"Computes pairwise products for a validated InputTuple and produces an OutputTuple.\"\"\"\n    @staticmethod\n    def multiply_elements(input_tuple: InputTuple) -> OutputTuple:\n        \"\"\"Calculates products of adjacent elements.\"\"\"\n        products = []\n        elements_data = input_tuple.elements\n        for i in range(input_tuple.length() - 1):\n            products.append(elements_data[i] * elements_data[i+1])\n        return OutputTuple(tuple(products))\n\ndef multiply_elements(t_input: Tuple[Number, ...]) -> Tuple[Number, ...]:\n    \"\"\"Public API: Accepts a tuple of numeric values and returns a tuple of adjacent products.\n    Raises ValueError on invalid input per FR8/BR7.\n    \"\"\"\n    input_obj = InputTuple(t_input)\n\n    Validator.validate_length(input_obj)\n    Validator.validate_types(input_obj)\n\n    output_obj = MultiplyElementsService.multiply_elements(input_obj)\n\n    return output_obj.elements"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(input_list):\n    \"\"\"\n    Validates input, computes sum of products of all non-empty contiguous subarrays, and returns the numeric result.\n    For an empty input_list, it returns 0.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    for element in input_list:\n        if not isinstance(element, (int, float)):\n            raise TypeError(\"All elements in the list must be numeric (int or float).\")\n\n    if not input_list:\n        return 0\n\n    total_sum = 0\n    n = len(input_list)\n\n    for i in range(n):\n        current_product = 1\n        for j in range(i, n):\n            current_product *= input_list[j]\n            total_sum += current_product\n\n    return total_sum"}
{"task_id": "Mbpp/732", "solution": "from dataclasses import dataclass\nfrom typing import List\n\n@dataclass\nclass CharacterRule:\n    target: str\n    replacement: str\n\nRULES: List[CharacterRule] = [\n    CharacterRule(target=' ', replacement=':'),\n    CharacterRule(target=',', replacement=':'),\n    CharacterRule(target='.', replacement=':')\n]\n\ndef replace_specialchar(input: str) -> str:\n    # Replaces spaces, commas, and dots with colons as per rules.\n    # Builds the result character by character for efficiency.\n    target_chars = {rule.target for rule in RULES}\n    result_chars = []\n    for char in input:\n        if char in target_chars:\n            result_chars.append(':')\n        else:\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(array, target) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a target in a sorted array.\n    Uses an iterative binary search variant to find the leftmost match.\n    \"\"\"\n    low, high = 0, len(array) - 1\n    ans = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == target:\n            ans = mid  # Store potential answer\n            high = mid - 1  # Search for an earlier occurrence in the left half\n        elif array[mid] < target:\n            low = mid + 1\n        else:  # array[mid] > target\n            high = mid - 1\n            \n    return ans"}
{"task_id": "Mbpp/735", "solution": "def _compute_lsb_pos(n: int) -> int:\n    \"\"\"Returns 0-based index of the least significant set bit. Returns -1 for n == 0.\"\"\"\n    if n == 0:\n        return -1\n    return (n & -n).bit_length() - 1\n\ndef _compute_msb_pos(n: int) -> int:\n    \"\"\"Returns 0-based index of the most significant set bit. Returns -1 for n == 0.\"\"\"\n    if n == 0:\n        return -1\n    return n.bit_length() - 1\n\ndef _create_mask(start: int, end: int) -> int:\n    \"\"\"Creates an integer mask with ones strictly between the start (MSB) and end (LSB) positions. Returns 0 if no middle bits exist.\"\"\"\n    if (start - end) <= 1:\n        return 0\n    # The number of bits to toggle is (start - end - 1).\n    # A mask of '1's for these bits can be created by (1 << count) - 1.\n    # Then shift this mask to the correct position, which is (end + 1).\n    return ((1 << (start - end - 1)) - 1) << (end + 1)\n\ndef _apply_toggle(n: int, mask: int) -> int:\n    \"\"\"Toggles bits of n using the given mask (n XOR mask).\"\"\"\n    return n ^ mask\n\ndef toggle_middle_bits(n: int) -> int:\n    \"\"\"\n    Toggles bits of the number except the first (MSB) and the last (LSB) bit.\n    Returns n unchanged if n is 0 or if there are no bits strictly between MSB and LSB.\n    \"\"\"\n    if n == 0:\n        return 0\n\n    lsb_pos = _compute_lsb_pos(n)\n    msb_pos = _compute_msb_pos(n)\n\n    # If there are no middle bits (e.g., n has 0, 1, or 2 set bits where MSB and LSB are adjacent or same)\n    if (msb_pos - lsb_pos) <= 1:\n        return n\n\n    mask = _create_mask(msb_pos, lsb_pos)\n    return _apply_toggle(n, mask)"}
{"task_id": "Mbpp/736", "solution": "from typing import Sequence, Any\n\ndef left_insertion(sorted_list: Sequence[Any], value: Any) -> int:\n    \"\"\"\n    Return the leftmost index i in [0, len(sorted_list)] such that\n    either i == len(sorted_list) or sorted_list[i] >= value.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/737", "solution": "import re\n\n# Module-level constant for the regex pattern\nVOWEL_PATTERN = r\"^[aeiouAEIOU]\" # The design document specified lowercase, but common sense and tests might include uppercase. However, the design states \"lowercase vowels a, e, i, o, u\". Let's stick to the design. The pattern `^[aeiou]` will only match lowercase. If `check_str(\"Annie\")` should return True, then either the pattern needs to be `^[aeiouAEIOU]` or the input string needs to be lowercased before matching. The design mentions \"lowercase vowels a, e, i, o, u\" in the requirements, but the regex `^[aeiou]` itself. It also doesn't specify lowercasing the input.\n# Re-reading: \"Behavior: returns a boolean indicating whether the provided string starts with one of the lowercase vowels a, e, i, o, u (FR2, FR3).\" This strongly implies case-sensitive for *lowercase* vowels. So `^[aeiou]` is correct.\n\nclass InputString:\n    \"\"\"Represents an input string and provides utility methods.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def firstChar(self) -> str:\n        \"\"\"Returns the first character of the string, or an empty string if empty.\"\"\"\n        return self.value[0] if self.value else \"\"\n\n    def isEmpty(self) -> bool:\n        \"\"\"Checks if the string is empty.\"\"\"\n        return not bool(self.value)\n\nclass RegexPattern:\n    \"\"\"Encapsulates a regular expression pattern and its matching logic.\"\"\"\n    def __init__(self, pattern_string: str) -> None:\n        self.pattern_string = pattern_string\n        self._compiled = re.compile(self.pattern_string)\n\n    def matches(self, s: str) -> bool:\n        \"\"\"Checks if the given string matches the compiled regex from the beginning.\"\"\"\n        return bool(self._compiled.match(s))\n\nclass CheckResult:\n    \"\"\"Encapsulates the boolean result of a vowel check.\"\"\"\n    def __init__(self, is_vowel: bool) -> None:\n        self._is_vowel = is_vowel\n\n    @property\n    def isVowel(self) -> bool:\n        \"\"\"Returns the boolean result.\"\"\"\n        return self._is_vowel\n\nclass VowelChecker:\n    \"\"\"Checks if a string starts with a vowel using a RegexPattern.\"\"\"\n    def __init__(self, pattern: RegexPattern) -> None:\n        self.pattern = pattern\n\n    def check_str(self, inputString: InputString) -> CheckResult:\n        \"\"\"Performs the vowel check on the given InputString.\"\"\"\n        match = self.pattern.matches(inputString.value)\n        return CheckResult(is_vowel=match)\n\ndef check_str(input_string):\n    \"\"\"\n    Checks whether the given string is starting with a lowercase vowel (a, e, i, o, u) or not using regex.\n    \"\"\"\n    if not isinstance(input_string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    input_str_obj = InputString(input_string)\n    regex_pattern_obj = RegexPattern(VOWEL_PATTERN)\n    vowel_checker_obj = VowelChecker(pattern=regex_pattern_obj)\n    check_result_obj = vowel_checker_obj.check_str(input_str_obj)\n\n    return check_result_obj.isVowel"}
{"task_id": "Mbpp/740", "solution": "def tuple_to_dict(t: tuple) -> dict:\n    \"\"\"\n    Converts a tuple to a dictionary using adjacent elements as key-value pairs.\n    Pairs elements at indices (0,1), (2,3), etc., ignoring any trailing unpaired element.\n    \"\"\"\n    result = {}\n    for i in range(0, len(t) - 1, 2):\n        key = t[i]\n        value = t[i+1]\n        result[key] = value\n    return result"}
{"task_id": "Mbpp/739", "solution": "class InputValidator:\n    def validate(self, n):\n        \"\"\"Validates if n is an integer >= 1.\"\"\"\n        if not isinstance(n, int) or n < 1:\n            raise ValueError(\"n must be an integer >= 1\")\n\nclass TriangularNumber:\n    def __init__(self, k: int):\n        self.k = k\n\n    def value(self) -> int:\n        \"\"\"Computes the triangular number T_k = k*(k+1)//2.\"\"\"\n        return self.k * (self.k + 1) // 2\n\n    def digit_count(self) -> int:\n        \"\"\"Determines the number of decimal digits in the triangular number.\"\"\"\n        return len(str(self.value()))\n\ndef _find_first_k_with_digits(n: int) -> int:\n    \"\"\"Iteratively finds the smallest k such that TriangularNumber(k) has n digits.\"\"\"\n    k = 1\n    while True:\n        t = TriangularNumber(k)\n        if t.digit_count() == n:\n            return k\n        k += 1\n\ndef find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with n digits.\n    Validates input n and then searches for the smallest k such that T_k has n digits.\n    \"\"\"\n    validator = InputValidator()\n    validator.validate(n)\n    return _find_first_k_with_digits(n)"}
{"task_id": "Mbpp/741", "solution": "def all_Characters_Same(input_str: str) -> bool:\n    \"\"\"\n    Checks if all characters in the input string are identical.\n    Returns True for empty or single-character strings.\n    \"\"\"\n    if not input_str:\n        return True\n    first_char = input_str[0]\n    for char in input_str:\n        if char != first_char:\n            return False\n    return True"}
{"task_id": "Mbpp/744", "solution": "def check_none(input_tuple) -> bool:\n    \"\"\"\n    Checks if the given tuple contains any None values.\n    Raises TypeError if the input is not a tuple.\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"input must be a tuple\")\n\n    for element in input_tuple:\n        if element is None:\n            return True\n    return False"}
{"task_id": "Mbpp/742", "solution": "from math import sqrt\n\nclass Tetrahedron:\n    def __init__(self, edge_length: float) -> None:\n        self._edge_length = edge_length\n        self._surface_area = None\n\n    def computeSurfaceArea(self) -> float:\n        \"\"\"Computes the surface area of the tetrahedron and returns it.\"\"\"\n        self._surface_area = sqrt(3) * (self._edge_length ** 2)\n        return self._surface_area\n\nclass GeometryService:\n    @staticmethod\n    def area_tetrahedron(edge_length: float) -> float:\n        \"\"\"Calculates the surface area of a regular tetrahedron.\"\"\"\n        tetra = Tetrahedron(edge_length)\n        return tetra.computeSurfaceArea()\n\ndef area_tetrahedron(edge_length):\n    \"\"\"Calculates the surface area of a regular tetrahedron.\"\"\"\n    return GeometryService.area_tetrahedron(edge_length)"}
{"task_id": "Mbpp/743", "solution": "def rotate_right(list, k):\n    \"\"\"Return a list with elements rotated to the right by k positions.\n    Handles empty lists, k=0, and k > list length.\n    \"\"\"\n    n = len(list)\n\n    if n == 0:\n        return []\n\n    effective_k = k % n\n\n    if effective_k == 0:\n        return list\n\n    # The last effective_k elements move to the front\n    tail = list[n - effective_k:]\n    # The remaining n - effective_k elements follow\n    head = list[:n - effective_k]\n\n    return tail + head"}
{"task_id": "Mbpp/748", "solution": "def _is_upper_letter(ch: str) -> bool:\n    \"\"\"Determines if a character is an uppercase ASCII letter.\"\"\"\n    return 'A' <= ch <= 'Z'\n\nclass InputString:\n    \"\"\"Holds the input string for processing.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\n    def length(self) -> int:\n        \"\"\"Returns the length of the input string.\"\"\"\n        return len(self.value)\n\nclass OutputString:\n    \"\"\"Holds the output string produced by the transformation.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\nclass CapitalWordsSpacesFunction:\n    \"\"\"Encapsulates the core logic for inserting spaces before capital words.\"\"\"\n    def process(self, input: str) -> str:\n        \"\"\"\n        Transforms the input string by inserting spaces before uppercase letters\n        that start words, except for the first character of the input.\n        \"\"\"\n        result_chars = []\n        for i, c in enumerate(input):\n            if i == 0:\n                result_chars.append(c)\n            else:\n                if _is_upper_letter(c):\n                    result_chars.append(' ')\n                result_chars.append(c)\n        return ''.join(result_chars)\n\ndef capital_words_spaces(input: str) -> str:\n    \"\"\"\n    Inserts spaces before words starting with capital letters in a given string.\n    The first character of the input string is not preceded by a space.\n    \"\"\"\n    impl = CapitalWordsSpacesFunction()\n    return impl.process(input)"}
{"task_id": "Mbpp/749", "solution": "from typing import List\nfrom .domain import InputList, StringNumber, Sorter, ResultList\n\ndef sort_numeric_strings(strings: List[str]) -> List[int]:\n    \"\"\"Primary API required by SRS (FR1).\"\"\"\n    input_list = InputList(strings)\n    \n    converted_ints = []\n    for value in input_list:\n        num = StringNumber(value).toInteger()\n        converted_ints.append(num.value)\n        \n    sorted_ints = Sorter().sortAscending(converted_ints)\n    \n    return ResultList(sorted_ints).as_list()"}
{"task_id": "Mbpp/745", "solution": "from typing import List, Iterator, Tuple, Optional\n\nclass Digit:\n    \"\"\"Represents a single digit.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass NumberRange:\n    \"\"\"Represents an inclusive range of numbers.\"\"\"\n    def __init__(self, startnum: int, endnum: int):\n        self.startnum = startnum\n        self.endnum = endnum\n\nclass ResultList:\n    \"\"\"A list of integers that can be sorted.\"\"\"\n    def __init__(self, numbers: List[int]):\n        self.numbers = numbers\n\n    def sort_ascending(self) -> None:\n        \"\"\"Sorts the internal list of numbers in ascending order.\"\"\"\n        self.numbers.sort()\n\n    def as_list(self) -> List[int]:\n        \"\"\"Returns the internal list of numbers.\"\"\"\n        return self.numbers\n\nclass InputValidator:\n    \"\"\"Validates input numbers for type and order.\"\"\"\n    def validate(self, startnum, endnum) -> Tuple[bool, Optional[str]]:\n        \"\"\"\n        Validates if inputs are integers and if startnum is not greater than endnum.\n        Raises ValueError for non-integer inputs.\n        \"\"\"\n        if not isinstance(startnum, int) or not isinstance(endnum, int):\n            raise ValueError(\"Inputs must be integers.\")\n        if startnum > endnum:\n            return False, \"startnum cannot be greater than endnum\"\n        return True, None\n\nclass RangeGenerator:\n    \"\"\"Generates a sequence of integers within a given range.\"\"\"\n    def generate(self, number_range: NumberRange) -> Iterator[int]:\n        \"\"\"Yields each integer from startnum to endnum, inclusive.\"\"\"\n        for i in range(number_range.startnum, number_range.endnum + 1):\n            yield i\n\nclass DigitExtractor:\n    \"\"\"Extracts digits from an integer.\"\"\"\n    def extract(self, value: int) -> List[Digit]:\n        \"\"\"\n        Extracts individual digits from the absolute value of an integer\n        and returns them as a list of Digit objects.\n        \"\"\"\n        digits_list: List[Digit] = []\n        if value == 0:\n            return [Digit(0)]\n        temp_value = abs(value)\n        while temp_value > 0:\n            digits_list.append(Digit(temp_value % 10))\n            temp_value //= 10\n        # Reverse to get digits in their natural order (e.g., 123 -> [1, 2, 3])\n        return digits_list[::-1]\n\nclass Filterer:\n    \"\"\"Filters numbers based on divisibility rules and digit presence.\"\"\"\n    def contains_zero(self, digits: List[Digit]) -> bool:\n        \"\"\"Checks if any digit in the list is zero.\"\"\"\n        for digit in digits:\n            if digit.value == 0:\n                return True\n        return False\n\n    def divisible_by_all_digits(self, value: int, digits: List[Digit]) -> bool:\n        \"\"\"Checks if a number is divisible by all its non-zero digits.\"\"\"\n        for digit in digits:\n            if digit.value == 0:\n                continue\n            if value % digit.value != 0:\n                return False\n        return True\n\nclass ResultAssemblerSorter:\n    \"\"\"Collects qualifying integers and returns them sorted ascending.\"\"\"\n    def __init__(self):\n        self._numbers: List[int] = []\n\n    def add(self, value: int) -> None:\n        \"\"\"Adds a qualifying integer to the internal list.\"\"\"\n        self._numbers.append(value)\n\n    def sorted_result(self) -> List[int]:\n        \"\"\"Returns the collected numbers, sorted in ascending order.\"\"\"\n        result_list_obj = ResultList(self._numbers)\n        result_list_obj.sort_ascending()\n        return result_list_obj.as_list()\n\nclass DivisibilityService:\n    \"\"\"Orchestrates the process of finding numbers divisible by their digits.\"\"\"\n    def __init__(self):\n        self.validator = InputValidator()\n        self.range_generator = RangeGenerator()\n        self.digit_extractor = DigitExtractor()\n        self.filterer = Filterer()\n        self.assembler_sorter = ResultAssemblerSorter()\n\n    def divisible_by_digits(self, startnum: int, endnum: int) -> List[int]:\n        \"\"\"\n        Finds numbers in the specified range (inclusive) that are divisible\n        by every non-zero digit they contain.\n        \"\"\"\n        is_valid, _ = self.validator.validate(startnum, endnum)\n        if not is_valid:\n            return []\n\n        num_range = NumberRange(startnum, endnum)\n        \n        for n in self.range_generator.generate(num_range):\n            digits = self.digit_extractor.extract(n)\n            \n            if self.filterer.contains_zero(digits):\n                continue\n            \n            if self.filterer.divisible_by_all_digits(n, digits):\n                self.assembler_sorter.add(n)\n        \n        return self.assembler_sorter.sorted_result()\n\ndef divisible_by_digits(startnum, endnum) -> List[int]:\n    \"\"\"\n    Finds numbers within a given range (startnum to endnum) where every number\n    is divisible by every non-zero digit it contains.\n    \"\"\"\n    service = DivisibilityService()\n    return service.divisible_by_digits(startnum, endnum)"}
