{"task_id": "Mbpp/129", "solution": "from typing import List, Optional, Set\n\nclass Matrix:\n    \"\"\"\n    Represent an n x n matrix; provide shape and aggregate sum operations.\n    \"\"\"\n    def __init__(self, cells: List[List]):\n        self.cells = cells\n        self.n = 0\n        if cells:\n            self.n = len(cells)\n            # Check if all rows are lists and have the same length as the number of rows\n            if any(not isinstance(row, list) for row in cells) or any(len(row) != self.n for row in cells):\n                self.n = 0 # Invalid n if not a list of lists or not square\n\n    def is_square(self) -> bool:\n        \"\"\"Checks if the matrix is n x n.\"\"\"\n        if self.n == 0:\n            # An empty list or a list of empty lists is not considered a square matrix for magic square purposes.\n            return False\n        # If n was set to 0 in __init__ due to malformed input, it's not square.\n        # Otherwise, n is already consistent with len(cells) and len(row) for all rows.\n        return True\n\n    def _get_value(self, r: int, c: int):\n        \"\"\"Safely gets a value from the matrix at (r, c).\"\"\"\n        # This method assumes matrix.n has been validated by is_square()\n        # and that self.cells[r] exists and self.cells[r][c] is accessible.\n        # The MagicSquareTester will have already performed comprehensive type and presence checks.\n        return self.cells[r][c]\n\n    def _sum_items(self, items: List) -> Optional[int]:\n        \"\"\"Sums a list of items, assuming all are integers as pre-validated.\"\"\"\n        current_sum = 0\n        for item in items:\n            # This check is redundant if MagicSquareTester pre-validates all entries,\n            # but serves as a safeguard as per design notes.\n            if not isinstance(item, int):\n                return None\n            current_sum += item\n        return current_sum\n\n    def sum_row(self, i: int) -> Optional[int]:\n        \"\"\"Calculates the sum of a specific row.\"\"\"\n        if not (0 <= i < self.n):\n            return None # Out of bounds row index\n        return self._sum_items(self.cells[i])\n\n    def sum_col(self, j: int) -> Optional[int]:\n        \"\"\"Calculates the sum of a specific column.\"\"\"\n        if not (0 <= j < self.n):\n            return None # Out of bounds column index\n        col_values = [self._get_value(r, j) for r in range(self.n)]\n        return self._sum_items(col_values)\n\n    def sum_main_diagonal(self) -> Optional[int]:\n        \"\"\"Calculates the sum of the main diagonal.\"\"\"\n        diag_values = [self._get_value(i, i) for i in range(self.n)]\n        return self._sum_items(diag_values)\n\n    def sum_secondary_diagonal(self) -> Optional[int]:\n        \"\"\"Calculates the sum of the secondary diagonal.\"\"\"\n        diag_values = [self._get_value(i, self.n - 1 - i) for i in range(self.n)]\n        return self._sum_items(diag_values)\n\nclass ValidationResult:\n    \"\"\"Holds validation outcome and human-readable error messages.\"\"\"\n    def __init__(self, is_magic: bool = False, errors: Optional[List[str]] = None):\n        self.is_magic = is_magic\n        self.errors = errors if errors is not None else []\n\nclass MagicSquareTester:\n    \"\"\"Orchestrates validation checks and produces ValidationResult.\"\"\"\n    def validate(self, matrix: Matrix) -> ValidationResult:\n        \"\"\"Performs all magic square validation checks.\"\"\"\n        result = ValidationResult()\n\n        if not matrix.is_square():\n            result.errors.append(\"Matrix is not square (n x n).\")\n            return result\n\n        n_squared = matrix.n * matrix.n\n\n        # Check for non-integer entries and collect all values\n        all_values = []\n        for r in range(matrix.n):\n            for c in range(matrix.n):\n                val = matrix._get_value(r, c)\n                if not isinstance(val, int):\n                    result.errors.append(f\"Entry at ({r},{c}) is not an integer or is missing.\")\n                    return result\n                all_values.append(val)\n        \n        # Handle the special case of a 0x0 matrix (empty list [])\n        # An empty matrix, while technically square, is typically not considered a magic square.\n        # The `is_square()` check above already handles this by returning False for `matrix.n == 0`.\n        # However, if `matrix.n == 0` for other reasons, it also fails.\n        # If matrix.n == 0 after `is_square()` and `all_values` check (which implies it's malformed), \n        # then n_squared will be 0.\n        # We handle `n=0` by failing `is_square` early.\n        # The logic below relies on `matrix.n > 0`.\n\n        # Calculate target sum from the first row\n        target_sum = matrix.sum_row(0)\n        if target_sum is None: # This should only happen if first row is out of bounds or _sum_items failed\n            result.errors.append(\"Could not calculate target sum from the first row.\")\n            return result\n\n        # Verify every row's sum\n        for i in range(matrix.n):\n            row_sum = matrix.sum_row(i)\n            if row_sum is None or row_sum != target_sum:\n                result.errors.append(f\"Row {i} sum ({row_sum}) does not equal target sum ({target_sum}).\")\n                return result\n\n        # Verify every column's sum\n        for j in range(matrix.n):\n            col_sum = matrix.sum_col(j)\n            if col_sum is None or col_sum != target_sum:\n                result.errors.append(f\"Column {j} sum ({col_sum}) does not equal target sum ({target_sum}).\")\n                return result\n\n        # Verify main and secondary diagonal sums\n        main_diag_sum = matrix.sum_main_diagonal()\n        if main_diag_sum is None or main_diag_sum != target_sum:\n            result.errors.append(f\"Main diagonal sum ({main_diag_sum}) does not equal target sum ({target_sum}).\")\n            return result\n\n        secondary_diag_sum = matrix.sum_secondary_diagonal()\n        if secondary_diag_sum is None or secondary_diag_sum != target_sum:\n            result.errors.append(f\"Secondary diagonal sum ({secondary_diag_sum}) does not equal target sum ({target_sum}).\")\n            return result\n\n        # Verify matrix contains exactly the integers 1..n^2 (each exactly once)\n        expected_values_set = set(range(1, n_squared + 1))\n        actual_values_set = set(all_values)\n\n        if actual_values_set != expected_values_set:\n            result.errors.append(f\"Matrix does not contain exactly integers 1 to {n_squared} (missing or extraneous values).\")\n            return result\n        \n        # Check for duplicates if set comparison passed but original list lengths differ\n        if len(all_values) != n_squared:\n            result.errors.append(f\"Matrix values count ({len(all_values)}) does not equal n^2 ({n_squared}), implying duplicates or incorrect size.\")\n            return result\n\n        result.is_magic = True\n        return result\n\ndef magic_square_test(matrix: List[List]) -> bool:\n    \"\"\"\n    Checks if a given matrix is a magic square.\n    It constructs a Matrix object, validates it using MagicSquareTester, and returns the result.\n    \"\"\"\n    m = Matrix(matrix)\n    tester = MagicSquareTester()\n    result = tester.validate(m)\n    return result.is_magic"}
{"task_id": "Mbpp/131", "solution": "class VowelSet:\n    \"\"\"Provides the canonical vowel set and a membership test for characters.\"\"\"\n    _vowels = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n\n    def is_vowel(self, c: str) -> bool:\n        \"\"\"Returns True if the single-character string c is a vowel.\"\"\"\n        return c in self._vowels\n\ndef reverse_vowels(s: str) -> str:\n    \"\"\"Reverses only the vowels of a given string (where y is not a vowel).\"\"\"\n    if not s:\n        return \"\"\n\n    char_list = list(s)\n    vowel_checker = VowelSet()\n    \n    vowel_indices = []\n    extracted_vowels = []\n\n    for i, char in enumerate(char_list):\n        if vowel_checker.is_vowel(char):\n            vowel_indices.append(i)\n            extracted_vowels.append(char)\n    \n    extracted_vowels.reverse()\n    \n    for i, vowel_idx in enumerate(vowel_indices):\n        char_list[vowel_idx] = extracted_vowels[i]\n            \n    return \"\".join(char_list)"}
{"task_id": "Mbpp/135", "solution": "class HexagonalNumberResult:\n    \"\"\"Holder for computed integer value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass InputParameter:\n    \"\"\"Simple data holder for input n.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n\nclass HexagonalNumberCalculator:\n    \"\"\"Computes hexagonal numbers using H(n) = n * (2 * n - 1).\"\"\"\n    def hexagonal_num(self, n: int) -> HexagonalNumberResult:\n        # Instantiate InputParameter to fulfill the design's \"uses\" relationship.\n        _ = InputParameter(n)\n        value = n * (2 * n - 1)\n        return HexagonalNumberResult(value)\n\ndef hexagonal_num(n: int) -> int:\n    \"\"\"\n    Calculates the nth hexagonal number.\n    Validates input and delegates computation.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"Input 'n' must be a positive integer (n >= 1).\")\n\n    calculator = HexagonalNumberCalculator()\n    result_obj = calculator.hexagonal_num(n)\n    return result_obj.value"}
{"task_id": "Mbpp/133", "solution": "from typing import List, Union\n\nNumber = Union[int, float]\n\ndef filterNegatives(numbers: List[Number]) -> List[Number]:\n    \"\"\"Returns a new list containing only elements where value < 0, without mutating the input.\"\"\"\n    return [x for x in numbers if x < 0]\n\ndef _sum_list(numbers: List[Number]) -> Number:\n    \"\"\"Returns the arithmetic sum of a given list of numbers. Returns 0 for an empty list.\"\"\"\n    total = 0\n    for x in numbers:\n        total += x\n    return total\n\ndef sum_negativenum(numbers: List[Number]) -> Number:\n    \"\"\"Calculates the sum of the negative numbers of a given list of numbers.\"\"\"\n    negatives = filterNegatives(numbers)\n    if not negatives:\n        return 0\n    return _sum_list(negatives)"}
{"task_id": "Mbpp/137", "solution": "from typing import List, TypeAlias\n\nIntegerList: TypeAlias = List[int]\n\ndef zero_count(input_list: IntegerList) -> float:\n    \"\"\"\n    Compute ratio (zeros / nonZeros) and return as float. Performs a single-pass traversal\n    to compute zeros and nonZeros. If nonZeros == 0, ZeroDivisionError will be raised.\n    \"\"\"\n    zeros = 0\n    non_zeros = 0\n\n    for num in input_list:\n        if num == 0:\n            zeros += 1\n        else:\n            non_zeros += 1\n\n    # Python's default division handles the ZeroDivisionError if non_zeros is 0,\n    # as per design decision.\n    return float(zeros / non_zeros)"}
{"task_id": "Mbpp/138", "solution": "def _validate_input(n) -> None:\n    \"\"\"Raise TypeError if n is not an int.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n\ndef _is_even_and_positive(n) -> bool:\n    \"\"\"Return True if n > 0 and n % 2 == 0.\"\"\"\n    return n > 0 and (n % 2 == 0)\n\ndef is_Sum_Of_Powers_Of_Two(n) -> bool:\n    \"\"\"Return True if n can be represented as sum of one or more non-zero powers of two (2^k, k>0).\n\n    Raises:\n        TypeError: if n is not an int.\n    \"\"\"\n    _validate_input(n)\n    if n <= 0:\n        return False\n    return _is_even_and_positive(n)"}
