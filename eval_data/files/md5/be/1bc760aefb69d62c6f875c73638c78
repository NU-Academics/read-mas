{"task_id": "Mbpp/82", "solution": "import math\n\nclass MathConstants:\n    \"\"\"Holds static mathematical constants.\"\"\"\n    PI = math.pi\n\nclass Sphere:\n    \"\"\"Encapsulates sphere properties and volume computation.\"\"\"\n    def __init__(self, radius):\n        self.radius = float(radius)\n\n    def computeVolume(self) -> float:\n        \"\"\"Computes the volume of the sphere.\"\"\"\n        return (4.0/3.0) * MathConstants.PI * (self.radius ** 3)\n\nclass VolumeResult:\n    \"\"\"A container for a computed volume value and its unit.\"\"\"\n    def __init__(self, value: float, unit: str = 'cubic units'):\n        self.value = value\n        self.unit = unit\n\ndef volume_sphere(radius):\n    \"\"\"\n    Calculates the volume of a sphere given its radius.\n    The volume is computed using the formula (4/3) * \u03c0 * radius^3.\n    \"\"\"\n    sphere = Sphere(radius)\n    value = sphere.computeVolume()\n    _ = VolumeResult(value) # Internal use as per design\n    return float(value)"}
{"task_id": "Mbpp/85", "solution": "import math\nfrom dataclasses import dataclass\nfrom numbers import Real\nfrom typing import Optional\n\nPI: float = math.pi\n\n@dataclass\nclass Sphere:\n    radius: float\n    surface_area: Optional[float] = None\n\n    def compute_surface_area(self) -> float:\n        self.surface_area = 4.0 * PI * (float(self.radius) * float(self.radius))\n        return self.surface_area\n\ndef surfacearea_sphere(radius) -> float:\n    \"\"\"Validate radius and return surface area as float.\n\n    Raises:\n      TypeError: if radius is not a numeric value (numbers.Real).\n    \"\"\"\n    if not isinstance(radius, Real):\n        raise TypeError(\"radius must be a numeric value\")\n    r = float(radius)\n    sphere = Sphere(radius=r)\n    return float(sphere.compute_surface_area())"}
{"task_id": "Mbpp/84", "solution": "_memo = {1: 1, 2: 1}\n\ndef sequence(n):\n    \"\"\"\n    Computes the nth number in the Newman-Conway sequence using memoization.\n    Assumes n is an integer >= 1 as per design constraints for this implementation.\n    \"\"\"\n    if n in _memo:\n        return _memo[n]\n\n    val_n_minus_1 = sequence(n - 1)\n    result = sequence(val_n_minus_1) + sequence(n - val_n_minus_1)\n    \n    _memo[n] = result\n    return result"}
{"task_id": "Mbpp/86", "solution": "class InputParameter:\n    \"\"\"Holds the input parameter n and provides validation.\"\"\"\n    def __init__(self, n: any) -> None:\n        self.n = n\n\n    def validate(self) -> None:\n        \"\"\"Validates the type and range of n, raising TypeError or ValueError.\"\"\"\n        if not isinstance(self.n, int):\n            raise TypeError(\"n must be an integer.\")\n        if self.n < 1:\n            raise ValueError(\"n must be greater than or equal to 1.\")\n\nclass CenteredHexagonalNumber:\n    \"\"\"A data holder for the computed centered hexagonal number value.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass CenteredHexagonalCalculator:\n    \"\"\"Stateless calculator for centered hexagonal numbers, orchestrating validation and computation.\"\"\"\n    def centered_hexagonal_number(self, n: int) -> int:\n        \"\"\"Calculates the nth centered hexagonal number after validating input.\"\"\"\n        param = InputParameter(n)\n        param.validate()\n        computed_value = self._compute(n)\n        result_obj = CenteredHexagonalNumber(computed_value)\n        return result_obj.value\n\n    def _compute(self, n: int) -> int:\n        \"\"\"Computes the nth centered hexagonal number using the formula.\"\"\"\n        return 3 * n * (n - 1) + 1\n\ndef centered_hexagonal_number(n: int) -> int:\n    \"\"\"\n    Computes the nth centered hexagonal number using validation and integer arithmetic.\n    Raises TypeError if n is not an int, or ValueError if n < 1.\n    \"\"\"\n    calculator = CenteredHexagonalCalculator()\n    return calculator.centered_hexagonal_number(n)"}
{"task_id": "Mbpp/87", "solution": "class MergeFunction:\n    @staticmethod\n    def merge(dict1: dict, dict2: dict, dict3: dict) -> dict:\n        \"\"\"\n        Merges three dictionaries into a single dictionary with right-most precedence.\n        Keys present in later dictionaries will override values from earlier ones.\n        \"\"\"\n        # The ** operator unpacks dictionaries. When multiple dictionaries\n        # are unpacked into a new dictionary literal, values from later dictionaries\n        # for duplicate keys override values from earlier ones, fulfilling the\n        # right-most precedence rule (dict3 > dict2 > dict1).\n        return {**dict1, **dict2, **dict3}\n\ndef merge_dictionaries_three(dict1, dict2, dict3):\n    \"\"\"\n    Merges three dictionaries into a single dictionary, delegating to MergeFunction's logic.\n    \"\"\"\n    return MergeFunction.merge(dict1, dict2, dict3)"}
