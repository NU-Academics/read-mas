{"task_id": "Mbpp/3", "solution": "import math\n\nclass PrimeChecker:\n    \"\"\"Encapsulates primality-checking logic.\"\"\"\n    def check(self, n: int) -> bool:\n        \"\"\"Returns True if n is prime, False otherwise.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        # Check for odd divisors up to the square root of n\n        for i in range(3, int(math.isqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\n\nclass IntegerInput:\n    \"\"\"Represents the integer input domain concept.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass Result:\n    \"\"\"Represents the boolean result domain concept (is_not_prime).\"\"\"\n    def __init__(self, is_not_prime: bool) -> None:\n        self.is_not_prime = is_not_prime\n\ndef is_not_prime(n: int) -> bool:\n    \"\"\"Identifies non-prime numbers, returning True if n is not prime, False if n is prime.\"\"\"\n    integer_input = IntegerInput(n)\n    prime_checker = PrimeChecker()\n    is_prime_value = prime_checker.check(integer_input.value)\n    result = Result(not is_prime_value)\n    return result.is_not_prime"}
{"task_id": "Mbpp/6", "solution": "class XORResult:\n    \"\"\"Represents XOR value and provides set-bit counting utilities.\"\"\"\n    def __init__(self, xor_value: int) -> None:\n        self._xor_value = xor_value\n\n    def count_set_bits(self) -> int:\n        \"\"\"Return population count for _xor_value.\"\"\"\n        # Use int.bit_count() if available (Python 3.10+).\n        if hasattr(self._xor_value, 'bit_count'):\n            return self._xor_value.bit_count()\n        else:\n            # Fallback for older Python versions: count set bits in the absolute value.\n            # This handles 0 correctly and interprets negative XOR results by their magnitude.\n            return bin(abs(self._xor_value)).count('1')\n\n    def has_single_set_bit(self) -> bool:\n        \"\"\"Return True iff count_set_bits() == 1.\"\"\"\n        return self.count_set_bits() == 1\n\ndef differ_At_One_Bit_Pos(a: int, b: int) -> bool:\n    \"\"\"Return True iff a and b (Python ints) differ in exactly one bit position.\n\n    Computes xor = a ^ b and returns True iff xor has exactly one set bit.\n    \"\"\"\n    xor_value = a ^ b\n    xr = XORResult(xor_value)\n    return xr.has_single_set_bit()"}
{"task_id": "Mbpp/2", "solution": "from typing import Iterable, Any\nfrom src.validation import validate_sequence\nfrom src.result_collection import ResultCollection\n\ndef similar_elements(seq1: Iterable[Any], seq2: Iterable[Any]) -> ResultCollection:\n    \"\"\"\n    Finds shared elements between two sequences, validating inputs and returning a ResultCollection.\n    \"\"\"\n    if not validate_sequence(seq1) or not validate_sequence(seq2):\n        return ResultCollection([])\n\n    shared_elements_list = []\n    for item1 in seq1:\n        for item2 in seq2:\n            if item1 == item2:\n                shared_elements_list.append(item1)\n                # The design allows for duplicates in the raw collection;\n                # the set conversion (via ResultCollection.to_set or external set() call)\n                # will handle deduplication for acceptance checks.\n    \n    return ResultCollection(shared_elements_list)"}
{"task_id": "Mbpp/4", "solution": "import heapq\nfrom typing import List, Any\n\nclass Number:\n    \"\"\"Wraps a numeric value and provides integer conversion.\"\"\"\n    def __init__(self, value: Any):\n        self._value = value\n\n    def to_int(self) -> int:\n        \"\"\"Converts the wrapped value to an integer, truncating towards zero.\"\"\"\n        return int(self._value)\n\nclass InputList:\n    \"\"\"Validates and provides access to input items.\"\"\"\n    def __init__(self, items: List[Any]):\n        self._items = items\n\n    def validate(self) -> bool:\n        \"\"\"Performs input validation (assumed to pass as per constraints).\"\"\"\n        return True\n\n    @property\n    def items(self) -> List[Any]:\n        \"\"\"Accessor for the input items.\"\"\"\n        return self._items\n\nclass ResultList:\n    \"\"\"Holds integer result values and sorts them in descending order.\"\"\"\n    def __init__(self, items: List[int]):\n        self._items = list(items) # Ensure we have a mutable copy\n\n    def sort_desc(self) -> None:\n        \"\"\"Sorts the stored items in descending order.\"\"\"\n        self._items.sort(reverse=True)\n\n    def to_list(self) -> List[int]:\n        \"\"\"Returns the current list of items.\"\"\"\n        return self._items\n\nclass HeapQueueLargest:\n    \"\"\"Orchestrates selection, conversion, and packaging of top-n elements.\"\"\"\n    def __init__(self, numbers: List[Any], n: int):\n        self._numbers = numbers\n        self._n = n\n\n    def execute(self) -> List[int]:\n        \"\"\"Selects the n largest elements, converts to integers, and sorts descending.\"\"\"\n        selected_values = heapq.nlargest(self._n, self._numbers)\n        converted_ints = [Number(val).to_int() for val in selected_values]\n        result_list = ResultList(converted_ints)\n        result_list.sort_desc()\n        return result_list.to_list()\n\ndef heap_queue_largest(items: List[Any], n: int) -> List[int]:\n    \"\"\"\n    Finds the n largest integers from a given list of numbers, returned in descending order.\n    All numeric outputs are converted to int via Python int() (truncation toward zero).\n    \"\"\"\n    input_list = InputList(items)\n    input_list.validate() \n\n    heap_op = HeapQueueLargest(input_list.items, n)\n    return heap_op.execute()"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string, character):\n    if len(character) != 1:\n        raise ValueError(\"character parameter must be a single character\")\n\n    first_idx = input_string.find(character)\n    last_idx = input_string.rfind(character)\n\n    if first_idx == -1:\n        return input_string\n    elif first_idx == last_idx:\n        # Remove the single occurrence\n        return input_string[:first_idx] + input_string[first_idx+1:]\n    else:\n        # Remove the first and last occurrences\n        result_chars = []\n        for i, char in enumerate(input_string):\n            if i != first_idx and i != last_idx:\n                result_chars.append(char)\n        return \"\".join(result_chars)"}
{"task_id": "Mbpp/12", "solution": "from typing import List, Any\n\ndef _row_sum(row: List[Any]) -> Any:\n    \"\"\"Return numeric sum of row elements.\"\"\"\n    return sum(row)\n\ndef sort_matrix(matrix: List[List[Any]]) -> List[List[Any]]:\n    \"\"\"Accepts matrix (list of rows); returns matrix sorted ascending by row sums.\"\"\"\n    return sorted(matrix, key=_row_sum)"}
{"task_id": "Mbpp/16", "solution": "import re\n\nPATTERN_REGEX: str = r'^[a-z]+_[a-z]+$'\n\ndef text_lowercase_underscore(input_string: str) -> bool:\n    \"\"\"\n    Returns true if the input string contains sequences of lowercase letters joined with an underscore and false otherwise.\n    Raises TypeError if input_string is not a string.\n    \"\"\"\n    if not isinstance(input_string, str):\n        raise TypeError(\"input_string must be a str\")\n    return re.fullmatch(PATTERN_REGEX, input_string) is not None"}
{"task_id": "Mbpp/17", "solution": "def square_perimeter(side_length: float) -> float:\n    \"\"\"\n    Calculates the perimeter of a square given its side length.\n    The perimeter is calculated as 4 times the side length.\n    \"\"\"\n    return 4 * side_length"}
{"task_id": "Mbpp/18", "solution": "def _build_dirty_chars_set(second: str) -> set[str]:\n    \"\"\"Return a set of single-character strings from 'second'.\"\"\"\n    return set(second)\n\ndef _filter_using_set(first: str, dirty_set: set[str]) -> str:\n    \"\"\"Return characters of 'first' not in dirty_set, preserving order.\"\"\"\n    result_chars = []\n    for char in first:\n        if char not in dirty_set:\n            result_chars.append(char)\n    return \"\".join(result_chars)\n\ndef remove_dirty_chars(first: str, second: str) -> str:\n    \"\"\"Removes characters from the first string which are present in the second string.\"\"\"\n    dirty_set = _build_dirty_chars_set(second)\n    return _filter_using_set(first, dirty_set)"}
{"task_id": "Mbpp/19", "solution": "from typing import List\n\ndef _contains_duplicate(arr: List[int]) -> bool:\n    \"\"\"\n    Internal helper to check if an array contains duplicate elements.\n    Uses a set for efficient lookup of seen elements.\n    \"\"\"\n    seen = set()\n    for x in arr:\n        if x in seen:\n            return True\n        seen.add(x)\n    return False\n\ndef test_duplicate(arr: List[int]) -> bool:\n    \"\"\"\n    Checks if the given array of integers contains any duplicate element.\n    It delegates the actual duplicate detection to an internal helper function.\n    \"\"\"\n    return _contains_duplicate(arr)"}
{"task_id": "Mbpp/14", "solution": "class TriangularPrism:\n    \"\"\"Represents a triangular prism and computes its volume.\"\"\"\n    def __init__(self, base, height, length):\n        self.base = float(base)\n        self.height = float(height)\n        self.length = float(length)\n\n    def compute_volume(self) -> float:\n        \"\"\"Computes and returns the volume of the triangular prism.\"\"\"\n        return 0.5 * self.base * self.height * self.length\n\nclass VolumeCalculator:\n    \"\"\"Orchestrates volume computation for a triangular prism.\"\"\"\n    def __init__(self):\n        # InputValidator is not used due to the constraint \"Do NOT add isinstance() checks\".\n        pass\n\n    def find_Volume(self, base, height, length) -> float:\n        \"\"\"Calculates the volume of a triangular prism using a domain object.\"\"\"\n        prism = TriangularPrism(base, height, length)\n        return prism.compute_volume()\n\ndef find_Volume(base, height, length) -> float:\n    \"\"\"\n    Calculates the volume of a triangular prism.\n    Delegates to VolumeCalculator for orchestration.\n    \"\"\"\n    calculator = VolumeCalculator()\n    return calculator.find_Volume(base, height, length)"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(n: int) -> bool:\n    \"\"\"\n    Checks if the given number is a Woodall number.\n    A Woodall number n is of the form k * 2^k - 1 for some integer k >= 1.\n    \"\"\"\n    # Woodall numbers are defined for k >= 1, leading to n >= 1.\n    # Non-positive numbers cannot be Woodall numbers.\n    if n < 1:\n        return False\n\n    k = 1\n    while True:\n        woodall_candidate = k * (2**k) - 1\n        \n        if woodall_candidate == n:\n            return True\n        elif woodall_candidate > n:\n            # Since k * 2^k - 1 is an increasing function for k >= 1,\n            # if the current candidate exceeds n, no larger k will match.\n            return False\n        \n        k += 1"}
{"task_id": "Mbpp/56", "solution": "def check(n):\n    \"\"\"\n    Checks if a given number is one less than twice its reverse.\n    The reverse is computed by reversing its base-10 digits, dropping leading zeros.\n    \"\"\"\n    # Calculate the reverse of the number.\n    # Convert n to a string, reverse the string, then convert back to an integer.\n    # This handles dropping leading zeros in the reversed number (e.g., str(70)[::-1] is \"07\", int(\"07\") is 7).\n    reversed_n = int(str(n)[::-1])\n\n    # Check if the original number is one less than twice its reverse.\n    return n == (2 * reversed_n - 1)"}
