{"task_id": "Mbpp/283", "solution": "import collections\nimport math\nfrom typing import List, Dict\n\nclass IntegerInput:\n    \"\"\"Encapsulates integer input and provides digit extraction.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def get_digits(self) -> List[int]:\n        \"\"\"Returns digits from abs(value) in most- to least-significant order.\"\"\"\n        abs_value = abs(self.value)\n        if abs_value == 0:\n            return [0]\n        \n        digits = []\n        temp_value = abs_value\n        while temp_value > 0:\n            digits.append(temp_value % 10)\n            temp_value //= 10\n        return digits[::-1] # Reverse to get most- to least-significant\n\nclass DigitFrequency:\n    \"\"\"Represents a digit and its occurrence count.\"\"\"\n    def __init__(self, digit: int, count: int):\n        self.digit = digit\n        self.count = count\n\nclass ValidationResult:\n    \"\"\"Represents outcome of validation.\"\"\"\n    def __init__(self, is_valid: bool, failing_digits: List[int]):\n        self.is_valid = is_valid\n        self.failing_digits = failing_digits\n\nclass Validator:\n    \"\"\"Encapsulates validation algorithm and business rules.\"\"\"\n    def validate_integer(self, value: int) -> bool:\n        \"\"\"\n        Validates whether the frequency of each digit in the integer is less than or equal to the digit itself.\n        Raises TypeError if the input is not an integer.\n        \"\"\"\n        if not isinstance(value, int):\n            raise TypeError(\"Input must be an integer.\")\n\n        integer_input = IntegerInput(value)\n        digits = integer_input.get_digits()\n\n        digit_counts: Dict[int, int] = collections.Counter(digits)\n        \n        failing_digits: List[int] = []\n        is_valid = True\n\n        for digit, count in digit_counts.items():\n            if count > digit:\n                is_valid = False\n                failing_digits.append(digit)\n            # Special rule: digit 0 fails if present (count >= 1 and 0 numeric value)\n            if digit == 0 and count >= 1:\n                is_valid = False\n                if 0 not in failing_digits: # Avoid duplicates if 0 already failed by count > digit\n                    failing_digits.append(0)\n\n        return ValidationResult(is_valid, failing_digits).is_valid\n\ndef validate(value: int) -> bool:\n    \"\"\"\n    Checks if the frequency of each digit in the integer is less than or equal to the digit itself.\n    Delegates validation logic to the Validator class.\n    \"\"\"\n    validator = Validator()\n    return validator.validate_integer(value)"}
{"task_id": "Mbpp/285", "solution": "import re\n\nclass TextInput:\n    \"\"\"Data container for input text.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n\nclass MatchResult:\n    \"\"\"Encapsulate whether a match was found and what substring matched.\"\"\"\n    def __init__(self, matched: bool, matched_substring: str | None = None):\n        self.matched = matched\n        self.matched_substring = matched_substring\n\nclass PatternMatcher:\n    \"\"\"Detect 'abb' or 'abbb' in provided text.\"\"\"\n    def text_match_two_three(self, text: str) -> bool:\n        \"\"\"Return True if text contains 'abb' or 'abbb', else False.\"\"\"\n        result = self.find_match(text)\n        return result.matched\n\n    def find_match(self, text: str) -> MatchResult:\n        \"\"\"Return MatchResult describing the first match if any.\"\"\"\n        # Using a regex to find 'a' followed by exactly two or three 'b' characters.\n        # 'abbb?' matches 'abb' or 'abbb', prioritizing 'abbb' if it's the exact match.\n        match = re.search(r'abbb?', text)\n        if match:\n            return MatchResult(True, match.group(0))\n        else:\n            return MatchResult(False, None)\n\ndef text_match_two_three(text):\n    \"\"\"Checks whether a string contains the 'a' character followed by two or three 'b' characters.\"\"\"\n    matcher = PatternMatcher()\n    return matcher.text_match_two_three(text)"}
{"task_id": "Mbpp/287", "solution": "from typing import List\n\nclass EvenNumberSequence:\n    \"\"\"Generates a sequence of the first n even natural numbers.\"\"\"\n    def generate(self, n: int) -> List[int]:\n        \"\"\"Returns a list containing the first n even natural numbers.\"\"\"\n        return [2 * k for k in range(1, n + 1)]\n\nclass Number:\n    \"\"\"Represents an integer and provides its square.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def square(self) -> int:\n        \"\"\"Returns the square of the number's value.\"\"\"\n        return self.value * self.value\n\nclass Result:\n    \"\"\"A simple data holder for an integer result.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\ndef square_Sum(n: int) -> int:\n    \"\"\"\n    Computes the sum of squares of the first n even natural numbers.\n    For n=2, it calculates (2^2) + (4^2) = 4 + 16 = 20.\n    \"\"\"\n    even_sequence_generator = EvenNumberSequence()\n    even_numbers = even_sequence_generator.generate(n)\n\n    total_sum_of_squares = 0\n    for num_val in even_numbers:\n        number_obj = Number(num_val)\n        total_sum_of_squares += number_obj.square()\n\n    final_result = Result(total_sum_of_squares)\n    return final_result.value"}
{"task_id": "Mbpp/292", "solution": "import math\n\ndef find(dividend, divisor) -> int:\n    \"\"\"\n    Computes the quotient of two numbers, rounded down to the nearest integer (floor division).\n    Raises ZeroDivisionError if the divisor is zero.\n    \"\"\"\n    if divisor == 0:\n        raise ZeroDivisionError(\"divisor cannot be zero\")\n    return math.floor(dividend / divisor)"}
{"task_id": "Mbpp/290", "solution": "from typing import List, Tuple\n\ndef _validate_input(list_of_lists: List[List]) -> None:\n    \"\"\"Validates that the input is a list of lists.\n    Raises TypeError if the input structure is malformed.\"\"\"\n    if not isinstance(list_of_lists, list):\n        raise TypeError(\"Input must be a list.\")\n    for inner_list in list_of_lists:\n        if not isinstance(inner_list, list):\n            raise TypeError(\"All elements in the input list must be lists.\")\n\ndef _compute_first_max(list_of_lists: List[List]) -> Tuple[int, List]:\n    \"\"\"Computes the maximum length and returns the first list with that length.\n    Handles an empty input list by returning (0, []).\"\"\"\n    if not list_of_lists:\n        return 0, []\n\n    max_len = -1\n    longest_list = []\n\n    for inner_list in list_of_lists:\n        current_len = len(inner_list)\n        if current_len > max_len:\n            max_len = current_len\n            longest_list = inner_list\n    return max_len, longest_list\n\ndef max_length(list_of_lists: List[List]) -> Tuple[int, List]:\n    \"\"\"Finds the list of maximum length in a list of lists.\n    Returns a tuple containing the maximum length and the first list encountered with that length.\"\"\"\n    _validate_input(list_of_lists)\n    return _compute_first_max(list_of_lists)"}
{"task_id": "Mbpp/286", "solution": "from validator import validate_inputs\n\ndef _kadane(arr_segment):\n    \"\"\"\n    Computes the maximum contiguous subarray sum using Kadane's algorithm.\n    Assumes arr_segment is non-empty.\n    \"\"\"\n    max_current = arr_segment[0]\n    global_max = arr_segment[0]\n    \n    for i in range(1, len(arr_segment)):\n        max_current = max(arr_segment[i], max_current + arr_segment[i])\n        global_max = max(global_max, max_current)\n    return global_max\n\ndef _max_prefix_sum(arr):\n    \"\"\"\n    Computes the maximum prefix sum of the given array.\n    Assumes arr is non-empty.\n    \"\"\"\n    max_p_sum = float('-inf')\n    current_p_sum = 0\n    for x in arr:\n        current_p_sum += x\n        max_p_sum = max(max_p_sum, current_p_sum)\n    return max_p_sum\n\ndef _max_suffix_sum(arr):\n    \"\"\"\n    Computes the maximum suffix sum of the given array.\n    Assumes arr is non-empty.\n    \"\"\"\n    max_s_sum = float('-inf')\n    current_s_sum = 0\n    for i in range(len(arr) - 1, -1, -1):\n        current_s_sum += arr[i]\n        max_s_sum = max(max_s_sum, current_s_sum)\n    return max_s_sum\n\ndef max_sub_array_sum_repeated(arr, n, k):\n    \"\"\"\n    Finds the largest sum of a contiguous array in the modified array\n    formed by repeating the given array k times.\n    \"\"\"\n    validate_inputs(arr, n, k)\n\n    if n == 0:\n        return 0\n\n    # Max sum entirely within a single occurrence of the array (using Kadane's).\n    max_overall_sum = _kadane(arr)\n\n    # If k is 1, no further processing is needed.\n    if k == 1:\n        return max_overall_sum\n\n    # For k > 1, consider sums that span across multiple repetitions.\n    total_arr_sum = sum(arr)\n    max_prefix = _max_prefix_sum(arr)\n    max_suffix = _max_suffix_sum(arr)\n\n    # Max sum spanning two arrays (suffix of first + prefix of second).\n    max_overall_sum = max(max_overall_sum, max_prefix + max_suffix)\n\n    # For k > 2, also consider sums that include (k-2) full repetitions in the middle.\n    # This is only beneficial if the total_arr_sum is positive.\n    if k > 2 and total_arr_sum > 0:\n        max_overall_sum = max(max_overall_sum, max_prefix + (k - 2) * total_arr_sum + max_suffix)\n\n    return max_overall_sum"}
{"task_id": "Mbpp/296", "solution": "def get_Inv_Count(arr: list[int]) -> int:\n    \"\"\"\n    Counts the number of inversions in an array.\n    An inversion is a pair (i, j) such that i < j and arr[i] > arr[j].\n    \"\"\"\n    inv_count = 0\n    n = len(arr)\n\n    if n < 2:\n        return 0\n\n    for i in range(n - 1):\n        for j in range(i + 1, n):\n            if arr[i] > arr[j]:\n                inv_count += 1\n    return inv_count"}
{"task_id": "Mbpp/294", "solution": "class InputList:\n    \"\"\"Encapsulates caller-provided iterable and exposes elements.\"\"\"\n    def __init__(self, elements: list) -> None:\n        self._elements = elements\n\n    def get_elements(self) -> list:\n        return self._elements\n\nclass Element:\n    \"\"\"Base class for list elements, providing raw value storage.\"\"\"\n    def __init__(self, raw_value: any) -> None:\n        self.raw_value = raw_value\n\n    def is_numeric(self) -> bool:\n        raise NotImplementedError(\"is_numeric must be implemented by subclasses\")\n\n    def numeric_value(self): # float | int\n        raise NotImplementedError(\"numeric_value must be implemented by subclasses\")\n\nclass NumericElement(Element):\n    \"\"\"Represents a numeric item (int or float, not bool).\"\"\"\n    def __init__(self, value: (float | int)) -> None:\n        super().__init__(value)\n        self.value = value\n\n    def is_numeric(self) -> bool:\n        return True\n\n    def numeric_value(self) -> (float | int):\n        return self.value\n\nclass NonNumericElement(Element):\n    \"\"\"Represents a non-numeric item.\"\"\"\n    def __init__(self, value: any) -> None:\n        super().__init__(value)\n        self.value = value\n\n    def is_numeric(self) -> bool:\n        return False\n\n    def numeric_value(self):\n        # As per design, this should not be called for NonNumericElement when computing max.\n        raise TypeError(\"Cannot retrieve numeric value from a non-numeric element.\")\n\nclass Result:\n    \"\"\"Container for a computed maximum value.\"\"\"\n    def __init__(self, max_value: (float | int)) -> None:\n        self.max_value = max_value\n\ndef max_val(list: list):\n    \"\"\"\n    Finds the maximum numeric value in a heterogeneous list, ignoring non-numeric elements.\n    Raises ValueError if no numeric elements are present in the list.\n    \"\"\"\n    input_list_wrapper = InputList(list)\n    numeric_values = []\n\n    for raw_element in input_list_wrapper.get_elements():\n        # Classify the element based on design rules:\n        # numeric if isinstance(raw_value, (int, float)) and not isinstance(raw_value, bool).\n        is_raw_numeric = isinstance(raw_element, (int, float)) and not isinstance(raw_element, bool)\n\n        if is_raw_numeric:\n            element = NumericElement(raw_element)\n        else:\n            element = NonNumericElement(raw_element)\n\n        if element.is_numeric():\n            numeric_values.append(element.numeric_value())\n\n    if not numeric_values:\n        raise ValueError(\"no numeric elements in input list\")\n    else:\n        return max(numeric_values)"}
{"task_id": "Mbpp/293", "solution": "from math import sqrt\n\ndef otherside_rightangle(a, b) -> float:\n    # Calculates the hypotenuse of a right-angled triangle given two legs.\n    # Uses the Pythagorean theorem: c = sqrt(a^2 + b^2).\n    hypotenuse_squared = a*a + b*b\n    hypotenuse = sqrt(hypotenuse_squared)\n    return hypotenuse"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(nested_list):\n    \"\"\"Accepts a nested Python list and returns a flat Python list of non-list elements.\n\n    Raises TypeError if the input is not a list.\n    \"\"\"\n    if not isinstance(nested_list, list):\n        raise TypeError(\"flatten_list expects a list as its single argument\")\n\n    flat_result = []\n\n    def _flatten_recursive(current_list):\n        for item in current_list:\n            if isinstance(item, list):\n                _flatten_recursive(item)\n            else:\n                flat_result.append(item)\n\n    _flatten_recursive(nested_list)\n    return flat_result"}
{"task_id": "Mbpp/301", "solution": "class DepthCalculator:\n    \"\"\"Encapsulates the recursive algorithm to compute maximum dictionary nesting depth.\"\"\"\n\n    def dict_depth(self, d: dict) -> int:\n        \"\"\"Public algorithm entry point, initializes recursion with depth 1.\"\"\"\n        return self._depth_recursive(d, 1)\n\n    def _depth_recursive(self, d: dict, current_depth: int) -> int:\n        \"\"\"Performs recursive depth-first traversal, counting dict values for depth.\"\"\"\n        max_nested_depth = current_depth\n        for value in d.values():\n            if isinstance(value, dict):\n                nested_depth = self._depth_recursive(value, current_depth + 1)\n                max_nested_depth = max(max_nested_depth, nested_depth)\n        return max_nested_depth\n\n\ndef dict_depth(obj) -> int:\n    \"\"\"\n    Calculates the maximum nesting depth of a dictionary.\n    Top-level dictionary counts as depth 1.\n    \"\"\"\n    calc = DepthCalculator()\n    return calc.dict_depth(obj)"}
{"task_id": "Mbpp/299", "solution": "from typing import Dict, List, Tuple, Optional\n\nclass AggregationStore:\n    \"\"\"Manages an in-memory map of aggregates by name.\"\"\"\n    def __init__(self):\n        self._aggregates: Dict[str, int] = {}\n\n    def add(self, name: str, value: int) -> None:\n        \"\"\"Adds a value to the aggregate for a given name.\"\"\"\n        self._aggregates[name] = self._aggregates.get(name, 0) + value\n\n    def get_all(self) -> Dict[str, int]:\n        \"\"\"Returns a shallow copy of the current aggregates map.\"\"\"\n        return self._aggregates.copy()\n\nclass AggregatorService:\n    \"\"\"Orchestrates aggregation and selection of the maximum aggregate.\"\"\"\n    def __init__(self, store: Optional[AggregationStore] = None):\n        self._store = store or AggregationStore()\n\n    def aggregate(self, tuples: List[Tuple[str, int]]) -> Dict[str, int]:\n        \"\"\"Iterates input tuples to compute per-name sums using AggregationStore.\"\"\"\n        for name, value in tuples:\n            self._store.add(name, value)\n        return self._store.get_all()\n\n    def find_max(self, aggregates: Dict[str, int]) -> Tuple[str, int]:\n        \"\"\"Identifies and returns the (name, aggregate_value) with the maximum aggregate.\"\"\"\n        if not aggregates:\n            return (\"\", 0) # Return default for empty input, as behavior is unspecified.\n\n        max_name = None\n        max_value = -float('inf')\n\n        for name, value in aggregates.items():\n            if value > max_value:\n                max_value = value\n                max_name = name\n        \n        return (max_name, max_value) if max_name is not None else (\"\", 0)\n\n    def max_aggregate(self, tuples: List[Tuple[str, int]]) -> Tuple[str, int]:\n        \"\"\"Orchestrates the aggregation and subsequent selection of the maximum aggregate.\"\"\"\n        aggregated_data = self.aggregate(tuples)\n        return self.find_max(aggregated_data)\n\ndef max_aggregate(tuples: List[Tuple[str, int]]) -> Tuple[str, int]:\n    \"\"\"Calculates the maximum aggregate from a list of (name, value) tuples.\"\"\"\n    return AggregatorService().max_aggregate(tuples)"}
{"task_id": "Mbpp/300", "solution": "import math\n\ndef count_binary_seq(n: int) -> int:\n    \"\"\"\n    Counts binary sequences of length 2n where the sum of the first n bits equals the sum of the last n bits.\n    This count is equivalent to the central binomial coefficient C(2n, n).\n    \"\"\"\n    return math.comb(2 * n, n)"}
{"task_id": "Mbpp/305", "solution": "from typing import List, Tuple\n\ndef split_to_words(s: str) -> List[str]:\n    \"\"\"Splits a string by whitespace into a list of words.\"\"\"\n    return s.split()\n\ndef filter_starts_with_p(words: List[str]) -> List[str]:\n    \"\"\"Filters words, returning those that start with 'p' or 'P'.\"\"\"\n    return [word for word in words if word and word[0].lower() == 'p']\n\ndef start_withp(strings: List[str]) -> Tuple[str, str]:\n    \"\"\"\n    Returns two words from a list of strings that start with 'p' (case-insensitive),\n    scanning left-to-right.\n    \"\"\"\n    found_words: List[str] = []\n    for s in strings:\n        words_in_s = split_to_words(s)\n        p_words = filter_starts_with_p(words_in_s)\n        found_words.extend(p_words)\n        if len(found_words) >= 2:\n            return (found_words[0], found_words[1])\n    # Based on the prompt's assertion, it's implied that at least two words will always be found.\n    # If not, the behavior is unspecified, so we'll assume the happy path for now.\n    return (found_words[0], found_words[1]) # This line assumes at least two words are found, as per design context implications."}
