{"task_id": "Mbpp/252", "solution": "import math\nfrom typing import Tuple, Union\n\ndef _coerce_to_complex(z: Union[int, float, complex]) -> Tuple[float, float]:\n    \"\"\"Coerces numeric input to a (real, imag) float tuple.\"\"\"\n    if isinstance(z, complex):\n        return (z.real, z.imag)\n    else:\n        return (float(z), 0.0)\n\ndef _compute_magnitude(real: float, imag: float) -> float:\n    \"\"\"Computes the magnitude (r) from real and imaginary parts.\"\"\"\n    return math.hypot(real, imag)\n\ndef _compute_angle(real: float, imag: float) -> float:\n    \"\"\"Computes the angle (theta) in radians from real and imaginary parts.\"\"\"\n    return math.atan2(imag, real)\n\ndef convert(z: Union[int, float, complex]) -> Tuple[float, float]:\n    \"\"\"Converts a complex number (or int/float) to polar coordinates (r, theta).\"\"\"\n    real, imag = _coerce_to_complex(z)\n    r = _compute_magnitude(real, imag)\n    theta = _compute_angle(real, imag)\n    return (r, theta)"}
{"task_id": "Mbpp/255", "solution": "class ValidationError(Exception):\n    \"\"\"Domain-specific exception for validation failures.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(message)\n\nclass Validator:\n    \"\"\"Validates parameters for combination generation.\"\"\"\n    def validate_n(self, n) -> bool:\n        \"\"\"Returns True if n is an integer >= 0, else False.\"\"\"\n        return isinstance(n, int) and n >= 0\n\nclass CombinationGenerator:\n    \"\"\"Generates combinations with repetition from a list of items.\"\"\"\n\n    @staticmethod\n    def combinations_colors(items: list, n: int) -> list[tuple]:\n        \"\"\"Generates all combinations (with repetition) of length n from items.\"\"\"\n        if n == 0:\n            return [()]\n        if not items and n > 0:\n            return []\n\n        results = []\n        \n        def _generate_combinations_recursive(current_combination_elements, depth):\n            if depth == n:\n                results.append(tuple(current_combination_elements))\n                return\n\n            for item in items:\n                current_combination_elements.append(item)\n                _generate_combinations_recursive(current_combination_elements, depth + 1)\n                current_combination_elements.pop() # Backtrack\n\n        _generate_combinations_recursive([], 0)\n        return results\n\ndef combinations_colors(items, n):\n    \"\"\"\n    Generates all combinations (with repetition) of length n from the elements of the list.\n\n    Returns a list with a tuple for each combination.\n    \"\"\"\n    validator = Validator()\n    if not validator.validate_n(n):\n        raise ValidationError(f\"Invalid n: {n}; expected integer >= 0\")\n    \n    return CombinationGenerator.combinations_colors(items, n)"}
