{"task_id": "Mbpp/233", "solution": "from math import pi\n\nclass Validator:\n    \"\"\"Helper for input validation.\"\"\"\n    def isNumeric(self, value) -> bool:\n        \"\"\"Checks if a value is numeric (int or float).\"\"\"\n        return isinstance(value, (int, float))\n\n    def isPositive(self, value) -> bool:\n        \"\"\"Checks if a value is positive.\"\"\"\n        return self.isNumeric(value) and value > 0\n\nclass MathLib:\n    \"\"\"Provides mathematical constants.\"\"\"\n    pi: float = pi\n\nclass CalculationResult:\n    \"\"\"Holds a computed value and its units.\"\"\"\n    def __init__(self, value: float, units: str = \"\"):\n        self.value = value\n        self.units = units\n\nclass Cylinder:\n    \"\"\"Represents a cylinder and computes its lateral surface area.\"\"\"\n    def __init__(self, radius: float, height: float):\n        self.radius = radius\n        self.height = height\n        self.lateralSurfaceArea: float = 0.0\n\n    def computeLateralSurface(self) -> float:\n        \"\"\"Computes the lateral surface area using 2 * pi * radius * height.\"\"\"\n        self.lateralSurfaceArea = 2 * MathLib.pi * self.radius * self.height\n        return self.lateralSurfaceArea\n\ndef lateralsuface_cylinder(radius, height) -> float:\n    \"\"\"\n    Calculates the lateral surface area of a cylinder.\n    Raises TypeError if inputs are non-numeric.\n    \"\"\"\n    v = Validator()\n    if not v.isNumeric(radius) or not v.isNumeric(height):\n        raise TypeError(\"radius and height must be numeric\")\n\n    cylinder = Cylinder(float(radius), float(height))\n    result_value = cylinder.computeLateralSurface()\n    return float(result_value)"}
{"task_id": "Mbpp/234", "solution": "class InputValidator:\n    @staticmethod\n    def is_numeric(value) -> bool:\n        \"\"\"Checks if the given value is numeric (int or float).\"\"\"\n        return isinstance(value, (int, float))\n\nclass Cube:\n    def __init__(self, side_length: float):\n        \"\"\"Initializes a Cube with a given side length.\"\"\"\n        self.side_length = float(side_length)\n        self.volume = None\n\n    def compute_volume(self) -> float:\n        \"\"\"Computes and returns the volume of the cube.\"\"\"\n        self.volume = self.side_length * self.side_length * self.side_length\n        return self.volume\n\nclass VolumeCalculator:\n    @staticmethod\n    def volume_cube(side_length: float) -> float:\n        \"\"\"Calculates the volume of a cube, validating input.\"\"\"\n        if not InputValidator.is_numeric(side_length):\n            raise TypeError(\"non-numeric side_length\")\n        cube = Cube(side_length)\n        return cube.compute_volume()\n\ndef volume_cube(side_length):\n    \"\"\"\n    Calculates the volume of a cube given its side length.\n    Delegates to internal VolumeCalculator for validation and computation.\n    \"\"\"\n    return VolumeCalculator.volume_cube(side_length)"}
{"task_id": "Mbpp/235", "solution": "class BitPosition:\n    def __init__(self, index: int):\n        self.index = index\n\n    def isEven(self) -> bool:\n        \"\"\"Returns True if the 1-based bit index is even.\"\"\"\n        return self.index % 2 == 0\n\nclass BitMask:\n    def generateEvenBitMask(self, numBits: int) -> int:\n        \"\"\"Generates an integer mask with 1s at even bit positions (1-indexed) up to numBits.\"\"\"\n        mask = 0\n        for i in range(1, numBits + 1):\n            bit_pos = BitPosition(i)\n            if bit_pos.isEven():\n                mask |= (1 << (i - 1))\n        return mask\n\ndef even_bit_set_number(input: int) -> int:\n    \"\"\"Sets all even bits of a given number, preserving odd bits.\"\"\"\n    # Determine the effective bit length of the input, at least 1 for 0.\n    num_bits = input.bit_length() or 1\n    \n    # Generate a mask with 1s at all even bit positions up to num_bits.\n    mask_generator = BitMask()\n    even_bits_mask = mask_generator.generateEvenBitMask(num_bits)\n    \n    # Apply the mask using a bitwise OR to set even bits while preserving odd bits.\n    return input | even_bits_mask"}
{"task_id": "Mbpp/238", "solution": "def _validate_input_is_str(s):\n    \"\"\"\n    Validates if the input is a string.\n    Raises TypeError if the input is not an instance of str.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n\ndef _count_substrings_by_formula(s):\n    \"\"\"\n    Calculates the number of non-empty substrings using the combinatorial formula.\n    Assumes the input string s is non-empty.\n    \"\"\"\n    length = len(s)\n    return length * (length + 1) // 2\n\ndef number_of_substrings(s):\n    \"\"\"\n    Counts the number of non-empty contiguous substrings of a given string.\n    Uses a combinatorial formula for efficient calculation.\n    \"\"\"\n    _validate_input_is_str(s)\n    \n    if len(s) == 0:\n        return 0\n    \n    return _count_substrings_by_formula(s)"}
{"task_id": "Mbpp/239", "solution": "def get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Finds the number of possible sequences of length n, such that each element is a positive integer,\n    is greater than or equal to twice the previous element, and is less than or equal to m.\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return m\n\n    # dp[k][val] stores the number of sequences of length k\n    # where the first element of the sequence is 'val'.\n    # We use m+1 for 1-based indexing for values up to m.\n    dp = [[0] * (m + 1) for _ in range(n + 1)]\n\n    # Base case: For sequences of length 1, any integer from 1 to m is a valid sequence.\n    for val in range(1, m + 1):\n        dp[1][val] = 1\n\n    # Fill the DP table for lengths from 2 to n.\n    for k in range(2, n + 1):\n        # Calculate suffix sums for dp[k-1].\n        # suffix_sum_prev[x] will store sum(dp[k-1][j] for j from x to m).\n        suffix_sum_prev = [0] * (m + 2)  # m+2 to handle val+1 for m and have a sentinel at m+1\n        for val in range(m, 0, -1):  # Iterate backwards from m down to 1\n            suffix_sum_prev[val] = dp[k-1][val] + suffix_sum_prev[val+1]\n\n        for val in range(1, m + 1):\n            next_min_val = 2 * val\n            if next_min_val > m:\n                # If 2 * val exceeds m, no valid next element can be chosen.\n                dp[k][val] = 0\n            else:\n                # The number of sequences of length k starting with 'val'\n                # is the sum of sequences of length k-1 starting with 'next_val'\n                # where 'next_val' must be >= 2 * 'val'.\n                dp[k][val] = suffix_sum_prev[next_min_val]\n\n    # The total number of sequences of length n is the sum of all dp[n][val]\n    # for all possible starting values 'val' from 1 to m.\n    total_count = sum(dp[n][val] for val in range(1, m + 1))\n\n    return total_count"}
