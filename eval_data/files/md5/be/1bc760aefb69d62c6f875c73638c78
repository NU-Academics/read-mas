{"task_id": "Mbpp/751", "solution": "class IndexMath:\n    \"\"\"Utility class for calculating child indices in a zero-based binary heap.\"\"\"\n    @staticmethod\n    def left(i: int) -> int:\n        \"\"\"Returns the index of the left child of node i.\"\"\"\n        return 2 * i + 1\n\n    @staticmethod\n    def right(i: int) -> int:\n        \"\"\"Returns the index of the right child of node i.\"\"\"\n        return 2 * i + 2\n\nclass Array:\n    \"\"\"Adapter for an indexable sequence, providing length and element access.\"\"\"\n    def __init__(self, elements):\n        self._elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the array.\"\"\"\n        return len(self._elements)\n\n    def get(self, index: int):\n        \"\"\"Returns the element at the specified index.\"\"\"\n        return self._elements[index]\n\nclass MinHeapChecker:\n    \"\"\"Core logic to verify if an array represents a min-heap.\"\"\"\n    @staticmethod\n    def check_min_heap(array) -> bool:\n        \"\"\"Checks if the given array satisfies the min-heap property.\"\"\"\n        arr_adapter = Array(array)\n        n = arr_adapter.length()\n\n        # An empty or single-element array is always a min-heap.\n        if n <= 1:\n            return True\n\n        # Iterate only through parent nodes, from index 0 up to floor(n/2) - 1.\n        for i in range(n // 2):\n            parent_val = arr_adapter.get(i)\n\n            # Check left child. A left child always exists if i is a parent in this loop range.\n            left_child_idx = IndexMath.left(i)\n            left_child_val = arr_adapter.get(left_child_idx)\n            if parent_val > left_child_val:\n                return False\n\n            # Check right child. A right child may not exist.\n            right_child_idx = IndexMath.right(i)\n            if right_child_idx < n:\n                right_child_val = arr_adapter.get(right_child_idx)\n                if parent_val > right_child_val:\n                    return False\n        \n        return True\n\ndef check_min_heap(array) -> bool:\n    \"\"\"\n    Checks if the given array represents a min-heap.\n    The function delegates to the MinHeapChecker class for verification.\n    \"\"\"\n    return MinHeapChecker.check_min_heap(array)"}
{"task_id": "Mbpp/753", "solution": "def min_k(records, k):\n    \"\"\"\n    Returns the k tuples with the smallest numeric values from the input list,\n    sorted in ascending order by the numeric value.\n    \"\"\"\n    sorted_records = sorted(records, key=lambda t: t[1])\n    return sorted_records[:k]"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1, l2, l3):\n    \"\"\"Return a list of elements equal across l1, l2, l3 at the same indices.\n\n    If any input list has length 0, an empty list is returned.\n    \"\"\"\n    if not l1 or not l2 or not l3:\n        return []\n\n    result = []\n    min_len = min(len(l1), len(l2), len(l3))\n\n    for i in range(min_len):\n        if l1[i] == l2[i] == l3[i]:\n            result.append(l1[i])\n\n    return result"}
{"task_id": "Mbpp/752", "solution": "_CACHE_STORE: dict[int, int] = {}\n\ndef cache_get(index: int) -> int | None:\n    \"\"\"Retrieves a cached Jacobsthal number.\"\"\"\n    return _CACHE_STORE.get(index)\n\ndef cache_save(index: int, value: int) -> None:\n    \"\"\"Saves a Jacobsthal number to the cache.\"\"\"\n    _CACHE_STORE[index] = value\n\ndef _validate_input(n: int) -> None:\n    \"\"\"Validates that n is a non-negative integer, raising ValueError if invalid.\"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"invalid input: n must be a non-negative integer\")\n\ndef jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Computes the nth Jacobsthal number iteratively.\n    Uses zero-based indexing and the recurrence Jn = Jn-1 + 2 * Jn-2 for n >= 2.\n    \"\"\"\n    _validate_input(n)\n\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n\n    # Check cache first\n    cached_value = cache_get(n)\n    if cached_value is not None:\n        return cached_value\n\n    # Compute iteratively if not in cache\n    j_n_minus_2 = 0  # J0\n    j_n_minus_1 = 1  # J1\n    current_j = 0\n\n    for i in range(2, n + 1):\n        current_j = j_n_minus_1 + 2 * j_n_minus_2\n        j_n_minus_2 = j_n_minus_1\n        j_n_minus_1 = current_j\n\n    # Save to cache before returning\n    cache_save(n, current_j)\n    return current_j"}
{"task_id": "Mbpp/755", "solution": "from typing import List\n\ndef second_smallest(numbers: List[float]) -> float:\n    \"\"\"\n    Finds the second smallest distinct number in a list.\n    Raises ValueError if fewer than two distinct numbers are present.\n    \"\"\"\n    distinct_numbers = sorted(list(set(numbers)))\n    if len(distinct_numbers) < 2:\n        raise ValueError(\"List must contain at least two distinct numbers.\")\n    return distinct_numbers[1]"}
{"task_id": "Mbpp/757", "solution": "from typing import List, Dict\nfrom dataclasses import dataclass\n\n@dataclass\nclass StringItem:\n    \"\"\"Lightweight value object representing a string and its 0-based position.\"\"\"\n    value: str\n    position: int\n\n    def reverse(self) -> str:\n        \"\"\"Returns the character-wise reverse of the string value.\"\"\"\n        return self.value[::-1]\n\n@dataclass\nclass ReversePair:\n    \"\"\"Data container representing an unordered pair of two StringItem instances.\"\"\"\n    item_a: StringItem\n    item_b: StringItem\n    # Convention: item_a.position < item_b.position\n\nclass ReversePairCounter:\n    \"\"\"Implements algorithm to count unordered reverse-string pairs (i < j).\"\"\"\n    def count_reverse_pairs(self, items: List[str]) -> int:\n        \"\"\"\n        Given a validated list of strings, return the integer count of unordered index pairs (i < j)\n        where items[j] == reverse(items[i]).\n        \"\"\"\n        reverse_pairs_count = 0\n        # Tracks counts of string values encountered so far, keyed by the string.\n        # This allows efficient lookup for reversed strings.\n        seen_values_counts: Dict[str, int] = {} \n\n        for j, current_value in enumerate(items):\n            reversed_current_value = StringItem(current_value, j).reverse()\n            \n            # If the reversed form of the current string was seen previously,\n            # increment the total count by the number of times it was seen.\n            if reversed_current_value in seen_values_counts:\n                reverse_pairs_count += seen_values_counts[reversed_current_value]\n            \n            # Add the current string to the counts of seen values.\n            seen_values_counts[current_value] = seen_values_counts.get(current_value, 0) + 1\n            \n        return reverse_pairs_count\n\ndef _validate_input_is_list_of_strings(items) -> None:\n    \"\"\"Raises ValueError if items is not a list or contains non-string elements.\"\"\"\n    if not isinstance(items, list):\n        raise ValueError(\"Input 'items' must be a list.\")\n    for item in items:\n        if not isinstance(item, str):\n            raise ValueError(\"All elements in 'items' must be strings.\")\n\ndef count_reverse_pairs(items):\n    \"\"\"\n    Public API: validate input, delegate to ReversePairCounter, return integer count.\n    Raises ValueError on invalid input.\n    \"\"\"\n    _validate_input_is_list_of_strings(items)\n    counter = ReversePairCounter()\n    return counter.count_reverse_pairs(items)"}
{"task_id": "Mbpp/758", "solution": "def unique_sublists(list_of_sublists):\n    \"\"\"\n    Counts occurrences of sublists within a list, converting each sublist to a tuple key.\n    Returns a dictionary mapping these tuple keys to their integer occurrence counts.\n    \"\"\"\n    counts = {}\n    for sublist in list_of_sublists:\n        tuple_key = tuple(sublist)\n        counts[tuple_key] = counts.get(tuple_key, 0) + 1\n    return counts"}
{"task_id": "Mbpp/759", "solution": "import re\n\nclass InputString:\n    \"\"\"A simple holder for the input string value.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\nclass ValidationResult:\n    \"\"\"A holder representing the boolean result of validation.\"\"\"\n    def __init__(self, is_valid: bool) -> None:\n        self.is_valid = is_valid\n\nclass DecimalValidator:\n    \"\"\"Encapsulates the regex pattern and validates strings against it.\"\"\"\n    _pattern: str = r\"^\\d+\\.\\d{2}$\"\n\n    def is_decimal(self, input_str: str) -> bool:\n        \"\"\"Returns True if input_str matches _pattern exactly, otherwise False.\"\"\"\n        return re.fullmatch(self._pattern, input_str) is not None\n\ndef is_decimal(input_str):\n    \"\"\"Checks whether a given string is a decimal number with a precision of 2.\"\"\"\n    validator = DecimalValidator()\n    return validator.is_decimal(input_str)"}
