{"task_id": "Mbpp/572", "solution": "from collections import Counter\nfrom typing import List, Dict, Tuple\n\ndef concatenate(lists: Tuple[List[int], ...]) -> List[int]:\n    \"\"\"Concatenates provided lists into a single list.\"\"\"\n    result = []\n    for lst in lists:\n        result.extend(lst)\n    return result\n\ndef countFrequencies(concatenated: List[int]) -> Dict[int, int]:\n    \"\"\"Counts the occurrences of each integer in the concatenated list.\"\"\"\n    return Counter(concatenated)\n\ndef filterUnique(frequencies: Dict[int, int], concatenated: List[int]) -> List[int]:\n    \"\"\"Filters integers that appear exactly once, preserving first-appearance order.\"\"\"\n    unique_elements = []\n    for num in concatenated:\n        if frequencies[num] == 1:\n            unique_elements.append(num)\n    return unique_elements\n\ndef two_unique_nums(*lists: List[int]) -> List[int]:\n    \"\"\"\n    Removes duplicate numbers from a given number of lists, returning numbers that appear exactly once.\n    The order of the unique numbers is preserved based on their first appearance across all input lists.\n    \"\"\"\n    all_elements = concatenate(lists)\n    frequencies = countFrequencies(all_elements)\n    result = filterUnique(frequencies, all_elements)\n    return result"}
{"task_id": "Mbpp/567", "solution": "from typing import Any\n\ndef issort_list(lst: list[Any]) -> bool:\n    \"\"\"Return True if lst is sorted in non-decreasing order, otherwise False.\n\n    Args:\n        lst: a Python list (expected numeric elements per SRS)\n    Returns:\n        bool\n    Raises:\n        Any exception raised by element comparisons (propagated)\n    \"\"\"\n    if len(lst) <= 1:\n        return True\n\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n            \n    return True"}
{"task_id": "Mbpp/569", "solution": "import dataclasses\nfrom typing import List\n\n@dataclasses.dataclass\nclass StringElement:\n    value: str\n    position: int # Not used in final implementation logic, kept for design consistency\n\n@dataclasses.dataclass\nclass Sublist:\n    elements: List[StringElement]\n    position: int # Not used in final implementation logic, kept for design consistency\n\n@dataclasses.dataclass\nclass InputList:\n    sublists: List[Sublist]\n\n@dataclasses.dataclass\nclass OutputList:\n    sublists: List[Sublist] # Not used in final implementation logic, kept for design consistency\n\ndef _validate_input(input_list: List[List[str]]) -> None:\n    \"\"\"\n    Validates that the input is a list of lists of strings, raising TypeError on invalid input.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n    for i, sublist in enumerate(input_list):\n        if not isinstance(sublist, list):\n            raise TypeError(f\"Element at index {i} must be a list.\")\n        for j, element in enumerate(sublist):\n            if not isinstance(element, str):\n                raise TypeError(f\"Element at index [{i}][{j}] must be a string.\")\n\ndef _sort_sublist(sublist_elements: List[str]) -> List[str]:\n    \"\"\"\n    Returns a new list with elements sorted in ascending lexicographical order.\n    \"\"\"\n    return sorted(sublist_elements)\n\ndef _assemble_output(processed_sublists: List[List[str]]) -> List[List[str]]:\n    \"\"\"\n    Converts a list of processed sublists (as List[List[str]]) into the final output format.\n    \"\"\"\n    return processed_sublists\n\ndef sort_sublists(input_list: List[List[str]]) -> List[List[str]]:\n    \"\"\"\n    Sorts each sublist of strings in a given list of lists lexicographically ascending.\n    Preserves the order of the outer list.\n    \"\"\"\n    _validate_input(input_list)\n\n    # Data transformation to internal dataclass representation (InputList not strictly necessary for this simple sort,\n    # but kept for consistency with the detailed design which includes position tracking if needed for more complex ops).\n    # For this specific problem, direct processing of List[List[str]] is more straightforward.\n    \n    # Process each sublist\n    sorted_outer_list = []\n    for sublist_index, inner_list_data in enumerate(input_list):\n        # Create StringElement objects (position tracking not used for simple sort)\n        string_elements = [StringElement(value=s, position=i) for i, s in enumerate(inner_list_data)]\n        # Extract values for sorting\n        values_to_sort = [se.value for se in string_elements]\n        \n        # Sort the sublist\n        sorted_values = _sort_sublist(values_to_sort)\n        sorted_outer_list.append(sorted_values)\n\n    # Assemble and return the final output\n    return _assemble_output(sorted_outer_list)"}
{"task_id": "Mbpp/573", "solution": "def unique_product(numbers):\n    \"\"\"\n    Calculates the product of unique numbers in a given list.\n    Helper functions handle parsing, deduplication, and multiplication.\n    \"\"\"\n\n    def _parse_input(input_numbers):\n        \"\"\"Converts input to a list, handling various iterable types.\"\"\"\n        if isinstance(input_numbers, list):\n            return input_numbers\n        return list(input_numbers)\n\n    def _deduplicate(parsed_numbers):\n        \"\"\"Returns a list of unique values based on Python's equality (==).\"\"\"\n        unique_values = []\n        for num in parsed_numbers:\n            if num not in unique_values:\n                unique_values.append(num)\n        return unique_values\n\n    def _multiply(values):\n        \"\"\"Calculates the product of a list of numbers, returning 1 for an empty list.\"\"\"\n        product = 1\n        for val in values:\n            product *= val\n        return product\n\n    parsed_numbers = _parse_input(numbers)\n    unique_nums = _deduplicate(parsed_numbers)\n    final_product = _multiply(unique_nums)\n    return final_product"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n):\n    \"\"\"Finds the last digit of n! for a given non-negative integer n.\"\"\"\n    if n >= 10:\n        return 0\n\n    # Precomputed last digits for 0! through 9!\n    # The last digit of n! for n >= 5 is 0.\n    last_digits_lookup = [1, 1, 2, 6, 4, 0, 0, 0, 0, 0]\n    \n    return last_digits_lookup[n]"}
{"task_id": "Mbpp/576", "solution": "def _matches_at(source, start_index, target):\n    \"\"\"\n    Checks if a segment of source, starting at start_index, matches target element-wise.\n    \"\"\"\n    target_length = len(target)\n    for i in range(target_length):\n        if source[start_index + i] != target[i]:\n            return False\n    return True\n\ndef is_Sub_Array(source, target):\n    \"\"\"\n    Checks if 'target' is a contiguous sublist of 'source'.\n    \"\"\"\n    if len(target) == 0:\n        return True\n    if len(target) > len(source):\n        return False\n\n    # Iterate through all possible starting positions in the source list\n    for i in range(len(source) - len(target) + 1):\n        if _matches_at(source, i, target):\n            return True\n            \n    return False"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1, tuple2):\n    \"\"\"\n    Finds elements present in exactly one of the input tuples.\n    Returns a tuple with elements unique to tuple1 first (preserving order), then unique to tuple2 (preserving order).\n    \"\"\"\n    if not isinstance(tuple1, tuple) or not isinstance(tuple2, tuple):\n        raise TypeError(\"Both inputs must be tuples\")\n\n    result_list = []\n\n    for e in tuple1:\n        if e not in tuple2:\n            result_list.append(e)\n\n    for e in tuple2:\n        if e not in tuple1:\n            result_list.append(e)\n\n    return tuple(result_list)"}
{"task_id": "Mbpp/580", "solution": "```python\ndef extract_even(input: tuple) -> tuple:\n    \"\"\"Return a tuple preserving nesting and order with only even integers from input.\"\"\"\n    result = []\n    for item in input:\n        if isinstance(item, int):\n            if item % 2 == 0:\n                result.append(item)\n        elif isinstance(item, tuple):\n            nested_result = extract_even(item)\n            if nested_result: # Only append if the nested tuple contains elements\n                result.append(nested_result)\n            elif not item: # Preserve empty tuples if they were originally empty\n                result.append(nested_result)\n    return tuple(result)\n```"}
{"task_id": "Mbpp/578", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass InputList:\n    \"\"\"Represents an input list with its elements and cached length.\"\"\"\n    elements: list\n    length: int\n\n    def __init__(self, elements: list) -> None:\n        self.elements = elements\n        self.length = len(elements)\n\n@dataclass\nclass ResultList:\n    \"\"\"Represents the interleaved result list with its elements and cached length.\"\"\"\n    elements: list\n    length: int\n\n    def __init__(self, elements: list) -> None:\n        self.elements = elements\n        self.length = len(elements)\n\nclass Validator:\n    \"\"\"Validates preconditions on input lists, such as length equality.\"\"\"\n    def validate_same_length(self, list1: list, list2: list, list3: list) -> bool:\n        \"\"\"Raises ValueError if the input lists do not have the same length.\"\"\"\n        len1, len2, len3 = len(list1), len(list2), len(list3)\n        if not (len1 == len2 == len3):\n            raise ValueError(\"Input lists must have the same length\")\n        return True\n\nclass Processor:\n    \"\"\"Constructs the flat interleaved result list.\"\"\"\n    def build_result(self, list1: list, list2: list, list3: list) -> ResultList:\n        \"\"\"Iterates and appends elements from each list in sequence to form a flat list.\"\"\"\n        result_elements = []\n        n = len(list1)\n        for i in range(n):\n            result_elements.append(list1[i])\n            result_elements.append(list2[i])\n            result_elements.append(list3[i])\n        return ResultList(result_elements)\n\nclass Interleaver:\n    \"\"\"Coordinates validation and processing to produce the interleaved list.\"\"\"\n    def __init__(self, validator: Validator = None, processor: Processor = None) -> None:\n        self.validator = validator if validator is not None else Validator()\n        self.processor = processor if processor is not None else Processor()\n\n    def interleave(self, list1: list, list2: list, list3: list) -> list:\n        \"\"\"Performs validation and then interleaving, returning the flat list.\"\"\"\n        self.validator.validate_same_length(list1, list2, list3)\n        result_list = self.processor.build_result(list1, list2, list3)\n        return result_list.elements\n\ndef interleave_lists(list1: list, list2: list, list3: list) -> list:\n    \"\"\"\n    Interleaves three lists of the same length into a single flat list.\n    Raises ValueError if input lists have different lengths.\n    \"\"\"\n    interleaver = Interleaver()\n    return interleaver.interleave(list1, list2, list3)"}
{"task_id": "Mbpp/581", "solution": "from typing import Union\n\nclass Parameters:\n    \"\"\"Holds base_edge and height values for computations.\"\"\"\n    def __init__(self, base_edge: float, height: float):\n        self.base_edge = base_edge\n        self.height = height\n\nclass Calculation:\n    \"\"\"Encapsulates the surface area formula.\"\"\"\n    _formula: str = 'base_edge**2 + 2 * base_edge * height'\n\n    def computeSurfaceArea(self, base_edge: float, height: float) -> float:\n        \"\"\"Computes the surface area of the square pyramid.\"\"\"\n        return base_edge**2 + 2 * base_edge * height\n\nclass Result:\n    \"\"\"Holds the computed surface area value.\"\"\"\n    def __init__(self, value: float):\n        self.value = value\n\nclass SquarePyramidFunction:\n    \"\"\"Coordinates delegation and returns the computed result.\"\"\"\n    def __init__(self, language: str = 'Python'):\n        self.language = language\n\n    def surface_Area(self, base_edge: float, height: float) -> Union[int, float]:\n        \"\"\"Delegates computation and formats the result.\"\"\"\n        calc = Calculation()\n        computed = calc.computeSurfaceArea(base_edge, height)\n        return int(computed) if float(computed).is_integer() else computed\n\ndef surface_Area(base_edge, height) -> Union[int, float]:\n    \"\"\"\n    Finds the surface area of a square pyramid given its base edge and slant height.\n    Delegates computation to internal classes.\n    \"\"\"\n    # Input validation (type and non-negativity) has been omitted as per instructions.\n    \n    params = Parameters(float(base_edge), float(height))\n    sp = SquarePyramidFunction(language='Python')\n    return sp.surface_Area(params.base_edge, params.height)"}
{"task_id": "Mbpp/583", "solution": "def factorial(k: int) -> int:\n    \"\"\"Computes the factorial of a non-negative integer k.\"\"\"\n    res = 1\n    for i in range(1, k + 1):\n        res *= i\n    return res\n\ndef _validate_n(n) -> None:\n    \"\"\"Validates that n is a non-negative integer.\"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"n must be a non-negative integer\")\n\ndef compute_catalan(n: int) -> int:\n    \"\"\"Computes the nth Catalan number using the factorial formula.\"\"\"\n    # Catalan(n) = factorial(2*n) // (factorial(n) * factorial(n) * (n + 1))\n    num = factorial(2 * n)\n    den = factorial(n) * factorial(n) * (n + 1)\n    return num // den\n\ndef catalan_number(n: int) -> int:\n    \"\"\"\n    Returns the nth Catalan number.\n    Validates n and computes the Catalan number using exact integer arithmetic.\n    \"\"\"\n    _validate_n(n)\n    return compute_catalan(n)"}
{"task_id": "Mbpp/587", "solution": "def list_tuple(input: list) -> tuple:\n    \"\"\"Convert a Python list to a tuple without mutating the input list.\n\n    Parameters:\n        input: list -- the input Python list to convert (precondition: caller supplies a list)\n    Returns:\n        tuple -- a tuple containing the same elements in the same order as the input list\n    \"\"\"\n    return tuple(input)"}
{"task_id": "Mbpp/585", "solution": "from typing import List, Dict, Any\n\nclass ValidationError(Exception):\n    \"\"\"Custom exception for validation errors.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\ndef _validate_dataset(dataset: List[Dict[str, Any]]) -> None:\n    \"\"\"Validates the structure and content of the dataset.\"\"\"\n    if not isinstance(dataset, list):\n        raise ValidationError(\"Dataset must be a list.\")\n    for i, item in enumerate(dataset):\n        if not isinstance(item, dict):\n            raise ValidationError(f\"Item at index {i} must be a dictionary.\")\n        if 'name' not in item or 'price' not in item:\n            raise ValidationError(f\"Item at index {i} must contain 'name' and 'price' keys.\")\n        if not isinstance(item['price'], (int, float)):\n            raise ValidationError(f\"Price for item at index {i} must be a numeric value.\")\n\ndef _validate_n(n: int) -> None:\n    \"\"\"Validates that n is a non-negative integer.\"\"\"\n    if not isinstance(n, int):\n        raise ValidationError(\"n must be an integer.\")\n    if n < 0:\n        raise ValidationError(\"n must be a non-negative integer.\")\n\ndef _price_key(item: Dict[str, Any]) -> float:\n    \"\"\"Helper function to extract the price for sorting.\"\"\"\n    return item['price']\n\ndef expensive_items(dataset: List[Dict[str, Any]], n: int) -> List[Dict[str, Any]]:\n    \"\"\"\n    Finds the n most expensive items in a given dataset.\n\n    Validates inputs, sorts items by price in descending order, and returns the top n.\n    \"\"\"\n    _validate_dataset(dataset)\n    _validate_n(n)\n\n    if n == 0:\n        return []\n\n    sorted_items = sorted(dataset, key=_price_key, reverse=True)\n\n    return sorted_items[:n]"}
