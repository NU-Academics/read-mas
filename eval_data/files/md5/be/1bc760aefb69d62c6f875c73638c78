{"task_id": "Mbpp/94", "solution": "from typing import Any, List, Tuple\n\ndef index_minimum(tuple_list: list) -> Any:\n    \"\"\"Returns the first element of the tuple with the smallest second value, ensuring stable tie-breaking.\"\"\"\n    # Initialize with the first tuple's values, assuming tuple_list is non-empty\n    # and its tuples have at least two elements, as per constraints.\n    min_second_value = tuple_list[0][1]\n    result_first_value = tuple_list[0][0]\n\n    # Iterate through the rest of the list to find the minimum.\n    # Strict inequality '<' ensures that the first encountered minimum is kept (stable tie-breaking).\n    for current_tuple in tuple_list[1:]:\n        current_first_value = current_tuple[0]\n        current_second_value = current_tuple[1]\n\n        if current_second_value < min_second_value:\n            min_second_value = current_second_value\n            result_first_value = current_first_value\n\n    return result_first_value"}
{"task_id": "Mbpp/92", "solution": "class IntegerInput:\n    \"\"\"Encapsulates an integer input and provides its absolute value.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n    def absolute_value(self):\n        \"\"\"Returns the absolute value of the encapsulated integer.\"\"\"\n        return abs(self.value)\n\nclass DigitSequence:\n    \"\"\"Provides an iterator for decimal digits of a non-negative integer from most-significant to least-significant.\"\"\"\n    def __init__(self, value):\n        self._value = value\n        self._length = None\n        self._highest_divisor = None\n\n    def length(self) -> int:\n        \"\"\"Calculates and returns the number of decimal digits.\"\"\"\n        if self._length is None:\n            if self._value == 0:\n                self._length = 1\n            else:\n                temp = self._value\n                count = 0\n                while temp > 0:\n                    temp //= 10\n                    count += 1\n                self._length = count\n        return self._length\n\n    def _get_highest_divisor(self):\n        \"\"\"Computes the highest power of 10 for the most significant digit.\"\"\"\n        if self._highest_divisor is None:\n            if self._value == 0:\n                self._highest_divisor = 1\n            else:\n                self._highest_divisor = 10**(self.length() - 1)\n        return self._highest_divisor\n\n    def iter_digits(self):\n        \"\"\"Yields digits from most-significant to least-significant.\"\"\"\n        if self._value == 0:\n            yield 0\n            return\n\n        current_value = self._value\n        divisor = self._get_highest_divisor()\n\n        while divisor > 0:\n            digit = current_value // divisor\n            yield digit\n            current_value %= divisor\n            divisor //= 10\n\nclass AlternationChecker:\n    \"\"\"Checks if a sequence of digits alternates between two distinct digits.\"\"\"\n    def __init__(self):\n        pass\n\n    def check_alternation(self, ds: DigitSequence) -> bool:\n        \"\"\"Performs a single-pass check for the undulating pattern.\"\"\"\n        it = ds.iter_digits()\n\n        first = None\n        try:\n            first = next(it)  # Odd position A\n        except StopIteration:\n            return False  # Empty sequence or non-positive input (should be handled by abs())\n\n        second = None\n        try:\n            second = next(it)  # Even position B\n        except StopIteration:\n            # Only one digit found, which by design is not undulating.\n            return False\n\n        if first == second:\n            return False # Undulating requires distinct digits A != B\n\n        pos = 3 # Current position, starting after first two digits\n        for d in it:\n            if pos % 2 == 1: # Odd position\n                if d != first:\n                    return False\n            else: # Even position\n                if d != second:\n                    return False\n            pos += 1\n        return True # All digits matched the alternation pattern\n\ndef is_undulating(n):\n    \"\"\"Validate input type and return boolean indicating undulating status.\n\n    If n is not an int, raise TypeError. Uses abs(n). Returns: bool\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"input must be an int\")\n\n    inp = IntegerInput(n)\n    abs_n = inp.absolute_value()\n    ds = DigitSequence(abs_n)\n    checker = AlternationChecker()\n    return checker.check_alternation(ds)"}
{"task_id": "Mbpp/95", "solution": "def Find_Min_Length(list_of_lists):\n    \"\"\"\n    Finds the length of the smallest list in a list of lists.\n    Raises ValueError if the outer list is empty.\n    \"\"\"\n    if not list_of_lists:\n        raise ValueError(\"Find_Min_Length received empty outer list; minimum undefined\")\n    \n    min_length = min(len(inner) for inner in list_of_lists)\n    return min_length"}
{"task_id": "Mbpp/96", "solution": "def divisor(n):\n    \"\"\"Return the number of positive divisors of integer n.\n    This implementation iterates up to the square root of n to count divisors efficiently.\"\"\"\n    if n == 1:\n        return 1\n    \n    count = 0\n    i = 1\n    while i * i <= n:\n        if n % i == 0:\n            if i * i == n:\n                count += 1\n            else:\n                count += 2\n        i += 1\n    return count"}
{"task_id": "Mbpp/99", "solution": "class ConversionError(Exception):\n    \"\"\"Custom exception for conversion-related errors.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass DecimalInput:\n    \"\"\"Models the decimal integer input.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def is_non_negative(self) -> bool:\n        \"\"\"Checks if the decimal input value is non-negative.\"\"\"\n        return self.value >= 0\n\nclass BinaryOutput:\n    \"\"\"Models the binary string output.\"\"\"\n    def __init__(self, bits: str) -> None:\n        self.bits = bits\n\nclass Validator:\n    \"\"\"Validates if an input is a single non-negative integer.\"\"\"\n    def validate(self, input: object) -> bool:\n        \"\"\"Returns True if input is int and input >= 0; otherwise False.\"\"\"\n        return isinstance(input, int) and input >= 0\n\nclass DecimalToBinaryConverter:\n    \"\"\"Converts a DecimalInput to its binary equivalent.\"\"\"\n    def convert(self, input: DecimalInput) -> BinaryOutput:\n        \"\"\"Converts DecimalInput to BinaryOutput, handling zero and no leading zeros.\"\"\"\n        if input.value == 0:\n            return BinaryOutput(\"0\")\n\n        binary_digits = []\n        temp_value = input.value\n        while temp_value > 0:\n            remainder = temp_value % 2\n            binary_digits.append(str(remainder))\n            temp_value //= 2\n        \n        return BinaryOutput(\"\".join(binary_digits[::-1]))\n\ndef decimal_to_binary(input_value) -> str:\n    \"\"\"Converts a decimal number to its binary equivalent, represented as a string.\"\"\"\n    validator = Validator()\n    if not validator.validate(input_value):\n        raise ValueError(\"Invalid input: must be a single non-negative integer\")\n    \n    decimal_input = DecimalInput(input_value)\n    converter = DecimalToBinaryConverter()\n    binary_output = converter.convert(decimal_input)\n    \n    return binary_output.bits"}
{"task_id": "Mbpp/97", "solution": "from typing import Any, List, Dict\n\nclass FrequencyCalculator:\n    \"\"\"\n    Utility class for flattening lists and calculating element frequencies.\n    \"\"\"\n\n    @staticmethod\n    def _flatten(list_of_lists: List[List[Any]]) -> List[Any]:\n        \"\"\"Flattens a list of lists by one level into a single list.\"\"\"\n        flattened_elements = []\n        for sublist in list_of_lists:\n            for item in sublist:\n                flattened_elements.append(item)\n        return flattened_elements\n\n    @staticmethod\n    def _count(elements: List[Any]) -> Dict[Any, int]:\n        \"\"\"Counts the frequency of each element in a list.\"\"\"\n        frequency_map = {}\n        for element in elements:\n            frequency_map[element] = frequency_map.get(element, 0) + 1\n        return frequency_map\n\n    @classmethod\n    def frequency_lists(cls, list_of_lists: List[List[Any]]) -> Dict[Any, int]:\n        \"\"\"\n        Orchestrates flattening and counting elements in a list of lists.\n        \"\"\"\n        flattened = cls._flatten(list_of_lists)\n        return cls._count(flattened)\n\ndef frequency_lists(list_of_lists: List[List[Any]]) -> Dict[Any, int]:\n    \"\"\"\n    Finds the frequency of each element in a flattened list of lists, returned in a dictionary.\n    This function delegates the flattening and counting logic to an internal FrequencyCalculator.\n    \"\"\"\n    return FrequencyCalculator.frequency_lists(list_of_lists)"}
{"task_id": "Mbpp/102", "solution": "def snake_to_camel(s: str) -> str:\n    \"\"\"\n    Converts a snake_case string to CamelCase (PascalCase).\n    Removes underscores and capitalizes the first letter of each word.\n    \"\"\"\n    words = s.split('_')\n    camel_case_words = [word.capitalize() for word in words]\n    return \"\".join(camel_case_words)"}
{"task_id": "Mbpp/100", "solution": "def _is_palindrome(s: str) -> bool:\n    \"\"\"Checks if a string is a palindrome.\"\"\"\n    return s == s[::-1]\n\ndef _next_palindrome_number(n: int) -> int:\n    \"\"\"Finds the smallest palindrome strictly greater than n by incrementing and checking.\"\"\"\n    candidate = n + 1\n    while True:\n        if _is_palindrome(str(candidate)):\n            return candidate\n        candidate += 1\n\ndef next_smallest_palindrome(input: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome of a specified integer, returned as an integer.\n    It delegates the actual computation to a private helper function.\n    \"\"\"\n    return _next_palindrome_number(input)"}
{"task_id": "Mbpp/98", "solution": "import math\n\nclass ValidationError(Exception):\n    \"\"\"Base exception for validation errors.\"\"\"\n    pass\n\nclass EmptySequenceError(ValidationError):\n    \"\"\"Raised when the input sequence is empty.\"\"\"\n    pass\n\nclass InvalidElementError(ValidationError):\n    \"\"\"Raised when a non-numeric element is found in the sequence.\"\"\"\n    pass\n\nclass NumberElement:\n    \"\"\"Represents a numeric element with its value and original position.\"\"\"\n    def __init__(self, value, position):\n        self.value = float(value) # Ensure value is stored as float\n        self.position = position\n\nclass NumericSequence:\n    \"\"\"Represents a validated sequence of numeric elements.\"\"\"\n    def __init__(self, raw_sequence):\n        if not isinstance(raw_sequence, (list, tuple)):\n            raise TypeError(\"Input sequence must be a list or tuple.\")\n        if not raw_sequence:\n            raise EmptySequenceError(\"Input sequence cannot be empty.\")\n\n        self._elements = []\n        for i, item in enumerate(raw_sequence):\n            if not isinstance(item, (int, float)):\n                raise InvalidElementError(f\"Element at position {i} is not a number: {item}\")\n            self._elements.append(NumberElement(item, i))\n\n    def length(self):\n        \"\"\"Returns the number of elements in the sequence.\"\"\"\n        return len(self._elements)\n\n    def __iter__(self):\n        \"\"\"Allows iteration over NumberElement instances.\"\"\"\n        return iter(self._elements)\n\n    def get_values(self):\n        \"\"\"Returns a list of float values from the elements.\"\"\"\n        return [element.value for element in self._elements]\n\nclass Result:\n    \"\"\"Encapsulates the final computed result value.\"\"\"\n    def __init__(self, value):\n        self.value = float(value)\n        self.value_type = \"float\"\n\ndef _validate_sequence(sequence) -> NumericSequence:\n    \"\"\"Validates the input sequence and constructs a NumericSequence object.\"\"\"\n    return NumericSequence(sequence)\n\ndef _compute_product(numeric_sequence: NumericSequence) -> float:\n    \"\"\"Computes the product of all numbers in the NumericSequence.\"\"\"\n    product = 1.0\n    for element in numeric_sequence:\n        product *= element.value\n    return product\n\ndef multiply_num(sequence):\n    \"\"\"\n    Multiplies all numbers in a list or tuple and divides the product by the length of the sequence.\n    Raises EmptySequenceError or InvalidElementError for invalid input.\n    \"\"\"\n    numeric_sequence = _validate_sequence(sequence)\n    \n    product = _compute_product(numeric_sequence)\n    \n    length = numeric_sequence.length()\n    if length == 0: # Should be caught by EmptySequenceError during validation, but as a safeguard\n        raise EmptySequenceError(\"Sequence length is zero, cannot divide.\")\n\n    quotient = product / length\n    \n    return Result(quotient).value"}
{"task_id": "Mbpp/101", "solution": "def _validate_k(array, k):\n    \"\"\"\n    Validates array and k for the kth_element function.\n    Raises TypeError or IndexError on invalid inputs.\n    \"\"\"\n    if not hasattr(array, '__len__') or not hasattr(array, '__getitem__'):\n        raise TypeError(\"Array must be a sequence (support len() and indexing).\")\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an integer.\")\n    if not (1 <= k <= len(array)):\n        raise IndexError(f\"k ({k}) is out of 1-based range [1, {len(array)}].\")\n\ndef kth_element(array, k):\n    \"\"\"\n    Finds the kth element in the given array using 1-based indexing.\n    Validates inputs and raises exceptions for invalid array or k.\n    \"\"\"\n    _validate_k(array, k)\n    # Convert 1-based index k to 0-based index\n    zero_based_index = k - 1\n    return array[zero_based_index]"}
{"task_id": "Mbpp/103", "solution": "class InputParameters:\n    \"\"\"Holds the two integer input parameters n and m.\"\"\"\n    def __init__(self, n: int, m: int) -> None:\n        self.n = n\n        self.m = m\n\nclass ValidationResult:\n    \"\"\"Represents result of validating InputParameters.\"\"\"\n    def __init__(self, isValid: bool, errorMessage: str = \"\") -> None:\n        self.isValid = isValid\n        self.errorMessage = errorMessage\n\nclass ValidationError(Exception):\n    \"\"\"Exception raised when validation fails.\"\"\"\n    def __init__(self, message: str) -> None:\n        self.message = message\n        super().__init__(message)\n\nclass EulerianNumber:\n    \"\"\"Container for computed Eulerian number value.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\ndef _validate_inputs(params: InputParameters) -> ValidationResult:\n    \"\"\"Enforces validation rules for n and m.\"\"\"\n    if not isinstance(params.n, int) or not isinstance(params.m, int):\n        return ValidationResult(isValid=False, errorMessage=\"Inputs n and m must be integers.\")\n    if params.n < 0:\n        return ValidationResult(isValid=False, errorMessage=\"Input n must be non-negative.\")\n    if params.n == 0:\n        if params.m == 0:\n            return ValidationResult(isValid=True)\n        else:\n            return ValidationResult(isValid=False, errorMessage=\"For n=0, m must be 0.\")\n    # For n > 0\n    if not (0 <= params.m < params.n):\n        return ValidationResult(isValid=False, errorMessage=f\"For n={params.n}, m must be in range [0, n-1).\")\n    return ValidationResult(isValid=True)\n\ndef _compute_eulerian(n: int, m: int) -> int:\n    \"\"\"Computes Eulerian number a(n, m) using dynamic programming.\"\"\"\n    # A(n,m) = (n - m) * A(n-1, m-1) + (m + 1) * A(n-1, m)\n    # Base case A(0,0) = 1\n    if n == 0 and m == 0:\n        return 1\n\n    # Initialize a 2D DP table.\n    # dp[i][j] will store A(i, j)\n    dp = [[0] * (n + 1) for _ in range(n + 1)]\n\n    # Base case: A(0,0) = 1\n    dp[0][0] = 1\n\n    for i in range(1, n + 1):\n        for j in range(i): # m must be < n, so j goes up to i-1\n            term1 = (i - j) * dp[i - 1][j - 1] if j > 0 else 0\n            term2 = (j + 1) * dp[i - 1][j]\n            dp[i][j] = term1 + term2\n    \n    return dp[n][m]\n\ndef eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Computes the Eulerian number a(n, m).\n    Raises ValidationError for invalid inputs.\n    \"\"\"\n    params = InputParameters(n, m)\n    validation_result = _validate_inputs(params)\n\n    if not validation_result.isValid:\n        raise ValidationError(validation_result.errorMessage)\n\n    return _compute_eulerian(n, m)"}
{"task_id": "Mbpp/104", "solution": "def sort_sublists(input_collection):\n    \"\"\"Accepts a list or tuple of sublists (each sublist is a sequence of strings) and returns a list\n    of sublists where each sublist's strings are sorted in ascending lexicographical order.\n    \"\"\"\n    result = []\n    for sublist in input_collection:\n        sorted_sublist = list(sorted(sublist))\n        result.append(sorted_sublist)\n    return result"}
