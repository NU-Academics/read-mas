{"task_id": "Mbpp/457", "solution": "def Find_Min(input_list):\n    \"\"\"\n    Accepts: input_list (list) -- a list of sublists (sequence-like).\n    Returns: a single sublist (the first encountered sublist that has minimal length).\n    \"\"\"\n    min_sublist = None\n    min_length = float('inf')\n\n    for sublist in input_list:\n        current_length = len(sublist)\n        if current_length < min_length:\n            min_length = current_length\n            min_sublist = sublist\n            \n    return min_sublist"}
{"task_id": "Mbpp/459", "solution": "def _is_uppercase(c: str) -> bool:\n    \"\"\"Return True if c is a single-character string in ASCII range 'A'..'Z'.\"\"\"\n    return 'A' <= c <= 'Z'\n\ndef remove_uppercase(input: str) -> str:\n    \"\"\"\n    Remove ASCII uppercase characters (A-Z) from input and return resulting string.\n\n    Behavior: only ASCII A-Z removed; other characters preserved in original order; returns \"\" for empty input or when no characters remain.\n    \"\"\"\n    result_chars = []\n    for char in input:\n        if not _is_uppercase(char):\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/460", "solution": "def _validate_input(obj):\n    \"\"\"\n    Internal helper to validate that the input is a list and contains only lists.\n    \"\"\"\n    if not isinstance(obj, list):\n        raise TypeError(\"Input must be a list.\")\n    for i, item in enumerate(obj):\n        if not isinstance(item, list):\n            raise TypeError(f\"Item at index {i} is not a list.\")\n\ndef _validate_sublist(sublist, index):\n    \"\"\"\n    Internal helper to validate that a sublist is not empty.\n    \"\"\"\n    if not sublist:\n        raise ValueError(f\"Sublist at index {index} cannot be empty.\")\n\ndef Extract(input):\n    \"\"\"\n    Extracts the first element from each sublist in a list of sublists.\n    Raises TypeError for invalid input types, ValueError for empty sublists.\n    \"\"\"\n    _validate_input(input)\n\n    result = []\n    for i, sublist in enumerate(input):\n        _validate_sublist(sublist, i)\n        result.append(sublist[0])\n    return result"}
{"task_id": "Mbpp/462", "solution": "def combinations_list(input_list):\n    \"\"\"\n    Public function to find all possible combinations of the elements of a given list.\n    \"\"\"\n    def _prepend(element, combo):\n        \"\"\"\n        Helper to return a new list with element prepended to combo.\n        \"\"\"\n        return [element] + combo\n\n    def _generate(input_list):\n        \"\"\"\n        Internal helper implementing the iterative-prepend algorithm.\n        \"\"\"\n        result = [[]]\n        for element in input_list:\n            # Take a snapshot copy of result to iterate over existing combinations\n            snapshot = list(result)\n            for combo in snapshot:\n                new_combo = _prepend(element, combo)\n                result.append(new_combo)\n        return result\n\n    return _generate(input_list)"}
