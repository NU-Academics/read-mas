{"task_id": "Mbpp/440", "solution": "import re\n\nclass Token:\n    \"\"\"\n    Represents a token with its text, absolute start and end indices, and type.\n    \"\"\"\n    def __init__(self, text: str, start_index: int, end_index: int, type: str):\n        self.text = text\n        self.start_index = start_index\n        self.end_index = end_index\n        self.type = type\n\ndef tokenize_for_adverb_finder(sentence: str) -> list[Token]:\n    \"\"\"\n    Tokenizes the sentence into word-like units (sequences of non-whitespace characters),\n    including any attached punctuation.\n    \"\"\"\n    tokens = []\n    for match in re.finditer(r'\\S+', sentence):\n        tokens.append(Token(match.group(0), match.start(), match.end(), \"word_candidate\"))\n    return tokens\n\ndef is_adverb_rule(token_clean_text: str) -> bool:\n    \"\"\"\n    Determines if a cleaned token text is an adverb based on the '-ly' suffix rule.\n    \"\"\"\n    return token_clean_text.lower().endswith('ly')\n\ndef find_adverb_position(sentence: str) -> (int, int, str):\n    \"\"\"\n    Finds the first adverb and its positions in a given sentence,\n    stripping immediately adjacent punctuation.\n    \"\"\"\n    tokens = tokenize_for_adverb_finder(sentence)\n\n    for token in tokens:\n        # Determine the actual start and end indices of the core word within the token's span,\n        # by stripping leading/trailing non-alphanumeric characters from the original sentence.\n        \n        current_start = token.start_index\n        current_end = token.end_index\n\n        # Adjust start index: move right past any leading non-alphanumeric characters\n        while current_start < current_end and not sentence[current_start].isalnum():\n            current_start += 1\n        \n        # Adjust end index: move left past any trailing non-alphanumeric characters\n        while current_end > current_start and not sentence[current_end - 1].isalnum():\n            current_end -= 1\n        \n        # If the stripped segment is empty, it's not a valid word, so skip.\n        if current_start >= current_end:\n            continue\n\n        cleaned_adverb_text = sentence[current_start:current_end]\n\n        if is_adverb_rule(cleaned_adverb_text):\n            # Return the first found adverb's (start_index, end_index, adverb_text)\n            return (current_start, current_end, cleaned_adverb_text)\n    \n    # Behavior when no adverb is found is unspecified by the design.\n    # Returning None or an empty tuple is a common convention for \"not found\".\n    return None"}
{"task_id": "Mbpp/447", "solution": "from typing import List, Union\n\nNumber = Union[int, float]\n\ndef cube_nums(input_list: List[Number]) -> List[Number]:\n    \"\"\"\n    Calculates the cube of each number in the input list and returns a new list with the results.\n    Preserves input order and does not modify the original list.\n    \"\"\"\n    cubed_numbers = []\n    for number in input_list:\n        cubed_numbers.append(number ** 3)\n    return cubed_numbers"}
{"task_id": "Mbpp/446", "solution": "from typing import Any, Tuple, List\n\ndef count_Occurrence(source_tuple: Tuple[Any, ...], elements_list: List[Any]) -> int:\n    \"\"\"\n    Count occurrences of any element from elements_list in source_tuple.\n    It iterates through the tuple and increments a counter for each match.\n    \"\"\"\n    count = 0\n    elements_to_find = set(elements_list) # Optimize lookup for efficiency\n\n    for item in source_tuple:\n        if item in elements_to_find:\n            count += 1\n    return count"}
{"task_id": "Mbpp/451", "solution": "def _is_whitespace(c: str) -> bool:\n    \"\"\"Checks if a character is a space, tab, or newline.\"\"\"\n    return c == ' ' or c == '\\t' or c == '\\n'\n\ndef remove_whitespaces(input: str) -> str:\n    \"\"\"Removes all specified whitespace characters from the input string.\"\"\"\n    result_chars = []\n    for char in input:\n        if not _is_whitespace(char):\n            result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/450", "solution": "from typing import List\n\nclass StringItem:\n    \"\"\"Hold a single string value and its length.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n        self.length = len(value)\n\nclass StringList:\n    \"\"\"Represent an ordered collection of StringItem objects.\"\"\"\n    def __init__(self, items: List[str]):\n        self.items = [StringItem(item) for item in items]\n\nclass ResultList:\n    \"\"\"Represent the filtered result list of StringItem objects.\"\"\"\n    def __init__(self):\n        self.items: List[StringItem] = []\n\n    def add(self, item: StringItem):\n        self.items.append(item)\n\nclass ExtractorFunction:\n    \"\"\"Encapsulate filtering behavior.\"\"\"\n\n    def extract_string(self, list_of_strings: List[str], size: int) -> List[str]:\n        \"\"\"Return list of strings whose length equals size; preserves input order.\"\"\"\n        string_list = StringList(list_of_strings)\n        result_list = ResultList()\n\n        for item in string_list.items:\n            if item.length == size:\n                result_list.add(item)\n\n        return [item.value for item in result_list.items]\n\n    def filterByLength(self, list_of_strings: List[str], size: int) -> List[str]:\n        \"\"\"Return filtered list of strings (len == size).\"\"\"\n        return [s for s in list_of_strings if len(s) == size]\n\ndef filterByLength(list_of_strings: List[str], size: int) -> List[str]:\n    \"\"\"Stateless helper that returns list of strings where len(string) == size.\"\"\"\n    return [s for s in list_of_strings if len(s) == size]\n\ndef extract_string(list_of_strings: List[str], size: int) -> List[str]:\n    \"\"\"Return list of strings from list_of_strings whose length == size.\"\"\"\n    extractor = ExtractorFunction()\n    return extractor.extract_string(list_of_strings, size)"}
{"task_id": "Mbpp/445", "solution": "class Validator:\n    \"\"\"Stateless utility for validating tuple structures and lengths.\"\"\"\n    def ensure_outer_lengths_equal(self, a: tuple, b: tuple) -> None:\n        if len(a) != len(b):\n            raise ValueError(f\"Outer tuples must have equal length. Got {len(a)} and {len(b)}.\")\n\n    def ensure_inner_types_are_tuples(self, x, y) -> None:\n        if not isinstance(x, tuple) or not isinstance(y, tuple):\n            raise TypeError(f\"Inner elements must be tuples. Got types {type(x)} and {type(y)}.\")\n\n    def ensure_inner_lengths_equal(self, x: tuple, y: tuple) -> None:\n        if len(x) != len(y):\n            raise ValueError(f\"Inner tuples must have equal length. Got {len(x)} and {len(y)}.\")\n\nclass IndexMultiplicationFunction:\n    \"\"\"Encapsulates validation and multiplication logic for index-wise tuple multiplication.\"\"\"\n    def __init__(self):\n        self.validator = Validator()\n\n    def index_multiplication(self, a: tuple, b: tuple) -> tuple:\n        self.validate_outer_length(a, b)\n\n        result_outer = []\n        for i in range(len(a)):\n            inner_a, inner_b = a[i], b[i]\n            self.validate_inner_type(inner_a, inner_b)\n            self.validate_inner_length(inner_a, inner_b)\n            \n            inner_result = self.multiply_inner_tuples(inner_a, inner_b)\n            result_outer.append(inner_result)\n            \n        return tuple(result_outer)\n\n    def validate_outer_length(self, a: tuple, b: tuple) -> None:\n        self.validator.ensure_outer_lengths_equal(a, b)\n\n    def validate_inner_type(self, inner_a, inner_b) -> None:\n        self.validator.ensure_inner_types_are_tuples(inner_a, inner_b)\n\n    def validate_inner_length(self, inner_a: tuple, inner_b: tuple) -> None:\n        self.validator.ensure_inner_lengths_equal(inner_a, inner_b)\n\n    def multiply_inner_tuples(self, inner_a: tuple, inner_b: tuple) -> tuple:\n        result_inner = []\n        for elem_a, elem_b in zip(inner_a, inner_b):\n            try:\n                product = elem_a * elem_b\n                result_inner.append(product)\n            except TypeError as e:\n                raise TypeError(f\"Unsupported operand type(s) for *: '{type(elem_a)}' and '{type(elem_b)}'\") from e\n        return tuple(result_inner)\n\ndef index_multiplication(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Performs index-wise multiplication of tuple elements in two given tuples.\n    It validates input structures and types, raising ValueError or TypeError on mismatch.\n    \"\"\"\n    impl = IndexMultiplicationFunction()\n    return impl.index_multiplication(a, b)"}
{"task_id": "Mbpp/448", "solution": "from typing import List\n\nclass InputValidator:\n    \"\"\"Validates input parameters for Perrin number calculations.\"\"\"\n    @staticmethod\n    def validate(n: int) -> None:\n        \"\"\"Raises ValueError if n is not a non-negative integer.\"\"\"\n        if not isinstance(n, int) or n < 0:\n            raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\nclass SequenceCalculator:\n    \"\"\"Calculates Perrin numbers and sequences.\"\"\"\n    def computePerrin(self, n: int) -> int:\n        \"\"\"Computes the nth Perrin number using base cases and recurrence.\"\"\"\n        if n == 0:\n            return 3\n        elif n == 1:\n            return 0\n        elif n == 2:\n            return 2\n        else:\n            # Iterative computation to find P(n)\n            p = [3, 0, 2] # P(0), P(1), P(2)\n            for i in range(3, n + 1):\n                p.append(p[i-2] + p[i-3])\n            return p[n]\n\n    def computeSequence(self, n: int) -> List[int]:\n        \"\"\"Computes a list of Perrin numbers from P(0) to P(n) iteratively.\"\"\"\n        if n < 0:\n            return []\n        \n        if n == 0:\n            return [3]\n        if n == 1:\n            return [3, 0]\n        if n == 2:\n            return [3, 0, 2]\n\n        perrin_sequence = [3, 0, 2] # Initialize with P(0), P(1), P(2)\n        for i in range(3, n + 1):\n            perrin_sequence.append(perrin_sequence[i-2] + perrin_sequence[i-3])\n            \n        return perrin_sequence\n\nclass SumAccumulator:\n    \"\"\"Aggregates numerical sequences.\"\"\"\n    def sum(self, sequence: List[int]) -> int:\n        \"\"\"Returns the sum of all integers in the provided sequence.\"\"\"\n        return sum(sequence)\n\ndef cal_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of Perrin numbers from P(0) to P(n).\n    It validates the input, generates the Perrin sequence, and sums it.\n    \"\"\"\n    InputValidator.validate(n)\n    \n    sequence_calculator = SequenceCalculator()\n    perrin_sequence = sequence_calculator.computeSequence(n)\n    \n    sum_accumulator = SumAccumulator()\n    result = sum_accumulator.sum(perrin_sequence)\n    \n    return result"}
{"task_id": "Mbpp/453", "solution": "def sumofFactors(n: int) -> int:\n    \"\"\"Compute and return the sum of all even positive divisors of n.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"sumofFactors requires an integer input\")\n\n    if n <= 0:\n        return 0\n\n    total_sum = 0\n    # Iterate up to the square root of n to find factors\n    for i in range(1, int(n**0.5) + 1):\n        if n % i == 0:\n            factor1 = i\n            factor2 = n // i\n\n            # Check if the first factor is even\n            if factor1 % 2 == 0:\n                total_sum += factor1\n\n            # Check if the second factor is even and different from the first\n            if factor2 % 2 == 0 and factor1 != factor2:\n                total_sum += factor2\n\n    return total_sum"}
{"task_id": "Mbpp/454", "solution": "import re\nimport string\n\nclass TextInput:\n    \"\"\"Represents the raw input string for detection.\"\"\"\n    def __init__(self, raw_text: str) -> None:\n        self.raw_text = raw_text\n\nclass Word:\n    \"\"\"Represents a tokenized word and encapsulates 'z'-detection logic.\"\"\"\n    def __init__(self, token: str) -> None:\n        self.token = token\n\n    def hasZ(self) -> bool:\n        \"\"\"Checks if the word token contains the character 'z'.\"\"\"\n        return 'z' in self.token\n\nclass MatchResult:\n    \"\"\"Represents the overall boolean detection result.\"\"\"\n    def __init__(self, matched: bool) -> None:\n        self.matched = matched\n\nclass Tokenizer:\n    \"\"\"Tokenizes raw text into Word tokens, removing adjacent punctuation.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def tokenize(self, text: str) -> list[Word]:\n        \"\"\"Splits text into words, stripping punctuation from ends.\"\"\"\n        tokens = []\n        for word_part in text.split():\n            clean_word = word_part.strip(string.punctuation)\n            if clean_word:\n                tokens.append(Word(clean_word))\n        return tokens\n\nclass TextProcessor:\n    \"\"\"Orchestrates tokenization and evaluation of tokens for 'z' presence.\"\"\"\n    def __init__(self, tokenizer: Tokenizer = None) -> None:\n        self._tokenizer = tokenizer if tokenizer is not None else Tokenizer()\n\n    def text_match_wordz(self, text: str) -> bool:\n        \"\"\"Tokenizes text and checks if any word contains 'z'.\"\"\"\n        words = self._tokenizer.tokenize(text)\n        for word in words:\n            if word.hasZ():\n                # According to design, a MatchResult object might be created internally\n                # MatchResult(matched=True)\n                return True\n        # MatchResult(matched=False)\n        return False\n\ndef text_match_wordz(text: str) -> bool:\n    \"\"\"Checks if the input text contains at least one word with 'z'.\"\"\"\n    processor = TextProcessor()\n    return processor.text_match_wordz(text)"}
{"task_id": "Mbpp/455", "solution": "from dataclasses import dataclass\nfrom datetime import datetime\n\n@dataclass\nclass Month:\n    \"\"\"Domain entity representing a calendar month.\"\"\"\n    number: int\n    name: str\n    days: int\n\n@dataclass\nclass CheckInvocation:\n    \"\"\"Optional record of an invocation to check_monthnumb_number.\"\"\"\n    inputMonth: int\n    result: bool\n    timestamp: datetime\n\nMONTH_DATA: dict[int, Month] = {\n    1: Month(1, \"January\", 31),\n    2: Month(2, \"February\", 28), # Assuming a non-leap year\n    3: Month(3, \"March\", 31),\n    4: Month(4, \"April\", 30),\n    5: Month(5, \"May\", 31),\n    6: Month(6, \"June\", 30),\n    7: Month(7, \"July\", 31),\n    8: Month(8, \"August\", 31),\n    9: Month(9, \"September\", 30),\n    10: Month(10, \"October\", 31),\n    11: Month(11, \"November\", 30),\n    12: Month(12, \"December\", 31),\n}\n\nclass MonthChecker:\n    \"\"\"Encapsulates the business logic for checking month days and optionally recording invocations.\"\"\"\n    def __init__(self, month_store: dict[int, Month] = None) -> None:\n        self.month_store = month_store if month_store is not None else MONTH_DATA\n        self.invocation_log: list[CheckInvocation] = []\n\n    def check_monthnumb_number(self, month_num: int) -> bool:\n        \"\"\"Checks if the given month number corresponds to a month with 31 days.\"\"\"\n        month_info = self.month_store.get(month_num)\n        result = False\n        if month_info:\n            result = month_info.days == 31\n        \n        self.invocation_log.append(CheckInvocation(\n            inputMonth=month_num,\n            result=result,\n            timestamp=datetime.now()\n        ))\n        return result\n\n_month_checker_instance = MonthChecker()\n\ndef check_monthnumb_number(month: int) -> bool:\n    \"\"\"\n    Checks whether the given month number contains 31 days or not.\n    Delegates to the internal MonthChecker service.\n    \"\"\"\n    return _month_checker_instance.check_monthnumb_number(month)"}
