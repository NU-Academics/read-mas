{"task_id": "Mbpp/118", "solution": "from typing import List, Any\n\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception raised for invalid input types.\"\"\"\n    def __init__(self, message: str = \"input must be a string\"):\n        super().__init__(message)\n\ndef _validate_input(input: Any) -> None:\n    \"\"\"Validates that the input is a string, raising InvalidInputError if not.\"\"\"\n    if not isinstance(input, str):\n        raise InvalidInputError()\n\ndef string_to_list(input: str) -> List[str]:\n    \"\"\"\n    Converts a string to a list of strings by splitting on the space character.\n    Raises InvalidInputError if the input is not a string.\n    \"\"\"\n    _validate_input(input)\n    return input.split(' ')"}
{"task_id": "Mbpp/119", "solution": "def search(sorted_list):\n    \"\"\"\n    Finds the element that appears only once in a sorted array where all other\n    elements appear exactly twice.\n    \"\"\"\n    low = 0\n    high = len(sorted_list) - 1\n\n    while low < high:\n        mid = low + (high - low) // 2\n\n        # Check if mid is part of a pair\n        # If mid is even, its pair should be at mid + 1\n        # If mid is odd, its pair should be at mid - 1\n        if mid % 2 == 0:  # mid is an even index\n            if sorted_list[mid] == sorted_list[mid + 1]:\n                # The pair is correctly formed, so the unique element is to the right\n                low = mid + 2\n            else:\n                # The pair is broken or mid is the unique element\n                # The unique element is at mid or to its left\n                high = mid\n        else:  # mid is an odd index\n            if sorted_list[mid] == sorted_list[mid - 1]:\n                # The pair is correctly formed, so the unique element is to the right\n                low = mid + 1\n            else:\n                # The pair is broken or mid is the unique element\n                # The unique element is at mid or to its left\n                high = mid - 1\n    \n    # When low == high, this is the index of the unique element\n    return sorted_list[low]"}
{"task_id": "Mbpp/120", "solution": "import math\nfrom typing import List, Tuple, Iterable, Union, Optional\n\nclass ValidationResult:\n    \"\"\"Represents the outcome of an input validation.\"\"\"\n    def __init__(self, is_valid: bool, errors: Optional[List[str]] = None) -> None:\n        self.is_valid = is_valid\n        self.errors = errors if errors is not None else []\n\nclass TuplePair:\n    \"\"\"Represents a 2-element numeric pair and computes its product.\"\"\"\n    def __init__(self, a: Union[int, float], b: Union[int, float]) -> None:\n        self.a = a\n        self.b = b\n\n    def product(self) -> Union[int, float]:\n        \"\"\"Computes the product of the two elements.\"\"\"\n        return self.a * self.b\n\nclass InputList:\n    \"\"\"Represents the input collection and performs structural validation.\"\"\"\n    def __init__(self, pairs: Iterable[Tuple[Union[int, float], Union[int, float]]]) -> None:\n        self.tuples: List[TuplePair] = []\n        self._raw_pairs = pairs\n\n    def validate(self) -> ValidationResult:\n        \"\"\"Validates the input structure and elements.\"\"\"\n        errors: List[str] = []\n        \n        if not isinstance(self._raw_pairs, Iterable):\n            return ValidationResult(False, [\"Input is not an iterable.\"])\n\n        try:\n            for i, item in enumerate(self._raw_pairs):\n                if not isinstance(item, Tuple):\n                    errors.append(f\"Element at index {i} is not a tuple.\")\n                    continue\n                if len(item) != 2:\n                    errors.append(f\"Tuple at index {i} does not have 2 elements.\")\n                    continue\n                \n                a, b = item\n                if not isinstance(a, (int, float)) or not isinstance(b, (int, float)):\n                    errors.append(f\"Elements in tuple at index {i} are not numeric.\")\n                    continue\n                self.tuples.append(TuplePair(a, b))\n        except TypeError: # Catches issues if _raw_pairs is an iterable but elements aren't properly iterable for tuples\n             errors.append(\"Input iterable contains non-tuple items or items that cannot be unpacked.\")\n        \n        if errors:\n            return ValidationResult(False, errors)\n        \n        return ValidationResult(True)\n\nclass TupleProduct:\n    \"\"\"Wraps a product value and provides its absolute value.\"\"\"\n    def __init__(self, value: Union[int, float]) -> None:\n        self.value = value\n\n    def absValue(self) -> Union[int, float]:\n        \"\"\"Returns the absolute value of the product.\"\"\"\n        return abs(self.value)\n\nclass MaxProductResult:\n    \"\"\"Represents the final result, the maximum absolute product.\"\"\"\n    def __init__(self, maxAbsProduct: Union[int, float]) -> None:\n        self.maxAbsProduct = maxAbsProduct\n\ndef max_product_tuple(pairs: Iterable[Tuple[Union[int, float], Union[int, float]]]) -> Union[int, float]:\n    \"\"\"\n    Finds the maximum absolute product between numbers in pairs of tuples within a given list.\n    Raises ValueError if input is invalid or no valid tuples are found.\n    \"\"\"\n    input_list = InputList(pairs)\n    vr = input_list.validate()\n\n    if not vr.is_valid:\n        raise ValueError(\"Invalid input: \" + \"; \".join(vr.errors))\n    \n    if not input_list.tuples:\n        raise ValueError(\"No valid tuples found after validation.\")\n\n    products = [TupleProduct(tp.product()) for tp in input_list.tuples]\n    abs_values = [p.absValue() for p in products]\n\n    if not abs_values:\n        raise ValueError(\"No products could be calculated from the valid tuples.\")\n\n    max_abs = max(abs_values)\n    return MaxProductResult(max_abs).maxAbsProduct"}
{"task_id": "Mbpp/123", "solution": "import math\nfrom typing import List, Dict, Set\n\nclass NumberRecord:\n    \"\"\"Stores computed proper-divisor sums and amicable flag.\"\"\"\n    def __init__(self, value: int, sumProperDivisors: int, isAmicable: bool=False) -> None:\n        self.value = value\n        self.sumProperDivisors = sumProperDivisors\n        self.isAmicable = isAmicable\n\nclass AmicablePair:\n    \"\"\"Immutable value object representing an amicable pair.\"\"\"\n    def __init__(self, a: int, b: int) -> None:\n        self.a = a\n        self.b = b\n\nclass CalculationResult:\n    \"\"\"DTO for total and amicableNumbers list.\"\"\"\n    def __init__(self, total: int, amicableNumbers: List[int]) -> None:\n        self.total = total\n        self.amicableNumbers = amicableNumbers\n\nclass AmicableCalculator:\n    \"\"\"Encapsulates computation and state for a single amicable number calculation.\"\"\"\n    def __init__(self, upperBound: int) -> None:\n        self.upperBound = upperBound\n        self._number_records: Dict[int, NumberRecord] = {}\n\n    def sum_of_proper_divisors(self, x: int) -> int:\n        \"\"\"Computes the sum of proper divisors of x, caching results.\"\"\"\n        if x in self._number_records:\n            return self._number_records[x].sumProperDivisors\n        \n        if x <= 1:\n            self._number_records[x] = NumberRecord(x, 0)\n            return 0\n\n        total_sum = 1  # 1 is always a proper divisor for x > 1\n        for i in range(2, int(math.sqrt(x)) + 1):\n            if x % i == 0:\n                total_sum += i\n                if i * i != x:\n                    total_sum += x // i\n        \n        self._number_records[x] = NumberRecord(x, total_sum)\n        return total_sum\n\n    def find_amicable_pairs(self, n: int) -> List[AmicablePair]:\n        \"\"\"Identifies amicable pairs where both members are within 1..n.\"\"\"\n        pairs: List[AmicablePair] = []\n        for a in range(1, n + 1):\n            if a not in self._number_records:\n                self.sum_of_proper_divisors(a)\n            \n            b = self._number_records[a].sumProperDivisors\n            \n            if a < b and b <= n: # Ensure a < b to avoid duplicate pairs and b is within range\n                if b not in self._number_records:\n                    self.sum_of_proper_divisors(b)\n                \n                sum_of_proper_divisors_b = self._number_records[b].sumProperDivisors\n                \n                if sum_of_proper_divisors_b == a:\n                    pairs.append(AmicablePair(a, b))\n                    # Mark numbers as amicable in records\n                    self._number_records[a].isAmicable = True\n                    self._number_records[b].isAmicable = True\n        return pairs\n\n    def amicable_numbers_sum(self, n: int) -> int:\n        \"\"\"Computes and returns the sum of unique amicable numbers in 1..n.\"\"\"\n        if n <= 0:\n            return 0\n            \n        # Pre-compute all proper divisor sums up to n\n        for i in range(1, n + 1):\n            if i not in self._number_records:\n                self.sum_of_proper_divisors(i)\n\n        amicable_pairs = self.find_amicable_pairs(n)\n        \n        unique_amicable_numbers: Set[int] = set()\n        for pair in amicable_pairs:\n            unique_amicable_numbers.add(pair.a)\n            unique_amicable_numbers.add(pair.b)\n        \n        total_sum = sum(unique_amicable_numbers)\n        return total_sum\n\ndef amicable_numbers_sum(n: int) -> int:\n    \"\"\"Sums all amicable numbers from 1 to a specified number.\"\"\"\n    calculator = AmicableCalculator(n)\n    return calculator.amicable_numbers_sum(n)"}
{"task_id": "Mbpp/124", "solution": "import math\nfrom typing import Tuple, Any\n\nclass AngleCalculator:\n    \"\"\"\n    Encapsulates validation and computation logic for complex number angles.\n    It is stateless and performs quadrant-aware calculations.\n    \"\"\"\n    def _validate_numeric(self, value: Any) -> float:\n        \"\"\"\n        Validates if the value is numeric (int, float, or purely real/imaginary complex)\n        and returns its float representation, or raises TypeError.\n        \"\"\"\n        if isinstance(value, (int, float)):\n            return float(value)\n        elif isinstance(value, complex):\n            if value.imag == 0:\n                return float(value.real)\n            elif value.real == 0:\n                return float(value.imag)\n            else:\n                raise TypeError(\"Complex numbers with both real and imaginary parts are not supported as separate real/imag arguments.\")\n        else:\n            raise TypeError(\"Input must be an int, float, or purely real/imaginary complex number.\")\n\n    def _to_parts(self, *args) -> Tuple[float, float]:\n        \"\"\"\n        Canonicalizes input arguments into a (real, imag) float tuple for computation.\n        It handles single complex arguments or two numeric arguments.\n        \"\"\"\n        if len(args) == 1:\n            if isinstance(args[0], complex):\n                return (float(args[0].real), float(args[0].imag))\n            else:\n                raise TypeError(\"Single argument must be a complex number.\")\n        elif len(args) == 2:\n            real = self._validate_numeric(args[0])\n            imag = self._validate_numeric(args[1])\n            return (real, imag)\n        else:\n            raise TypeError(\"Function accepts either one complex argument or two numeric (real, imag) arguments.\")\n\n    def angle_complex(self, *args) -> float:\n        \"\"\"\n        Computes the argument (angle) of a complex number in radians.\n        This method delegates input handling and validation to internal helpers.\n        \"\"\"\n        real, imag = self._to_parts(*args)\n        return math.atan2(imag, real)\n\ndef angle_complex(*args) -> float:\n    \"\"\"\n    Computes the argument (angle) of a complex number in radians.\n    Accepts a single complex number or two numeric arguments (real, imag).\n    \"\"\"\n    calculator = AngleCalculator()\n    return calculator.angle_complex(*args)"}
{"task_id": "Mbpp/127", "solution": "def validate_inputs(a: object, b: object) -> bool:\n    \"\"\"\n    Verifies both a and b are integers; raises TypeError if not.\n    This helper centralizes type checking as required by the design.\n    \"\"\"\n    if not isinstance(a, int) or not isinstance(b, int):\n        raise TypeError(\"Both inputs must be integers.\")\n    return True\n\ndef multiply_int(a: int, b: int) -> int:\n    \"\"\"\n    Multiplies two integers after validating their types.\n    Raises TypeError if inputs are not integers as per design.\n    \"\"\"\n    validate_inputs(a, b)\n    return a * b"}
{"task_id": "Mbpp/125", "solution": "def find_length(input_string: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and 1s in any substring of the given binary string.\n    Uses Kadane's algorithm on a transformed array where '0' is +1 and '1' is -1.\n    \"\"\"\n    # Validate input: Ensure string contains only '0' or '1' characters.\n    for char in input_string:\n        if char not in '01':\n            raise ValueError(\"Input string must contain only '0' or '1' characters.\")\n\n    # Handle empty input string as per design: return 0.\n    if not input_string:\n        return 0\n\n    # Transform the binary string: '0' becomes 1, '1' becomes -1.\n    # This converts the problem into finding the maximum subarray sum.\n    transformed_numbers = [1 if char == '0' else -1 for char in input_string]\n\n    # Apply Kadane's algorithm to find the maximum sum of a contiguous subarray.\n    # This variant considers an empty subarray sum of 0 if all other sums are negative.\n    max_so_far = 0\n    current_max = 0\n\n    for num in transformed_numbers:\n        current_max += num\n        # Reset current_max to 0 if it becomes negative, effectively starting a new subarray.\n        current_max = max(0, current_max)\n        # Update the overall maximum sum found so far.\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
{"task_id": "Mbpp/126", "solution": "from typing import List\n\nclass Divisor:\n    \"\"\"Represents a single positive divisor and provides divisibility predicate.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def is_divisor(self, of: int) -> bool:\n        \"\"\"Checks if this divisor divides the given number.\"\"\"\n        return of % self.value == 0\n\nclass CommonDivisorSet:\n    \"\"\"Computes and holds the list of positive common divisors and provides sum operation.\"\"\"\n    def __init__(self, divisors: List[int]) -> None:\n        self.divisors = divisors\n\n    @classmethod\n    def compute(cls, a: int, b: int) -> 'CommonDivisorSet':\n        \"\"\"Computes common positive divisors for two numbers.\"\"\"\n        common_divs = []\n        limit = min(abs(a), abs(b))\n        for d_val in range(1, limit + 1):\n            divisor = Divisor(d_val)\n            if divisor.is_divisor(a) and divisor.is_divisor(b):\n                common_divs.append(d_val)\n        return cls(common_divs)\n\n    def sum(self) -> int:\n        \"\"\"Returns the sum of the common divisors in the set.\"\"\"\n        return __builtins__.sum(self.divisors)\n\nclass FunctionImplementation:\n    \"\"\"Metadata container and execute wrapper for the sum function.\"\"\"\n    def __init__(self) -> None:\n        self.name: str = \"sum\"\n        self.language: str = \"Python\"\n\n    def execute(self, a: int, b: int) -> int:\n        \"\"\"Executes the module-level sum function.\"\"\"\n        return sum(a, b) # Calls the module-level 'sum' function\n\nclass TestCase:\n    \"\"\"Represents and runs a single test case.\"\"\"\n    def __init__(self, a: int, b: int, expected: int) -> None:\n        self.a = a\n        self.b = b\n        self.expected = expected\n\n    def run(self) -> bool:\n        \"\"\"Runs the test case and compares the result to the expected value.\"\"\"\n        result = sum(self.a, self.b)\n        return result == self.expected\n\n__all__ = ['sum']\n\ndef sum(a: int, b: int) -> int:\n    \"\"\"\n    Finds the sum of common positive divisors of two given numbers.\n    Note: This function shadows the built-in 'sum' function.\n    \"\"\"\n    common_divisor_set = CommonDivisorSet.compute(a, b)\n    return common_divisor_set.sum()"}
{"task_id": "Mbpp/128", "solution": "def long_words(n, words):\n    \"\"\"\n    Finds words longer than n characters from a given list of words or a string.\n    Splits string input on one-or-more whitespace characters.\n    \"\"\"\n    def split_on_whitespace(s):\n        \"\"\"Splits a string into a list of words using one or more whitespace characters as delimiters.\"\"\"\n        return s.split()\n\n    def is_longer_than(token, n):\n        \"\"\"Checks if the length of a token is strictly greater than n.\"\"\"\n        return len(token) > n\n\n    # The result_count helper is not strictly needed for this implementation logic\n    # but is part of the design, so we define it.\n    def result_count(results):\n        \"\"\"Returns the number of items in the results list.\"\"\"\n        return len(results)\n\n    if isinstance(words, str):\n        tokens = split_on_whitespace(words)\n    else:  # Assume list/array of strings\n        tokens = words\n\n    results = [t for t in tokens if is_longer_than(t, n)]\n    return results"}
{"task_id": "Mbpp/130", "solution": "class FrequencyCounter:\n    \"\"\"\n    Tracks element frequencies and their order of first appearance.\n    Used internally to determine the most frequent element with tie-breaking.\n    \"\"\"\n    def __init__(self):\n        self._counts = {}            # Maps element values to integer counts.\n        self._order = []             # Stores elements in order of their first appearance.\n\n    def increment(self, element):\n        \"\"\"Increments the count for an element, adding it to order tracking if new.\"\"\"\n        if element not in self._counts:\n            self._counts[element] = 1\n            self._order.append(element)\n        else:\n            self._counts[element] += 1\n\n    def most_frequent(self):\n        \"\"\"Returns the element with the highest frequency, using first-seen for ties.\"\"\"\n        if not self._counts:\n            return None # Returns None if no elements were incremented (e.g., empty input list)\n\n        max_count = -1\n        most_frequent_element = None\n\n        # Iterate through elements in their order of first appearance to resolve ties.\n        for element in self._order:\n            current_count = self._counts[element]\n            if current_count > max_count:\n                max_count = current_count\n                most_frequent_element = element\n            # If current_count == max_count, the existing most_frequent_element\n            # is kept, adhering to the first-seen tie-breaking rule.\n\n        return most_frequent_element\n\n\ndef max_occurrences(list):\n    \"\"\"\n    Finds the item with maximum frequency in a given list.\n    Tie-breaking is resolved by returning the first-seen element among those with maximum frequency.\n    \"\"\"\n    # Input validation (e.g., for non-list argument or empty list) is omitted as per specific prompt instructions.\n\n    fc = FrequencyCounter()\n    for element in list:\n        fc.increment(element)\n\n    return fc.most_frequent()"}
