{"task_id": "Mbpp/237", "solution": "from typing import List, Tuple, Dict\n\nclass TuplePair:\n    \"\"\"Encapsulates an input tuple for normalization.\"\"\"\n    def __init__(self, a: int, b: int) -> None:\n        self.a = a\n        self.b = b\n\n    def normalize(self) -> 'NormalizedTuple':\n        \"\"\"Normalizes the tuple elements to ascending order.\"\"\"\n        return NormalizedTuple(min(self.a, self.b), max(self.a, self.b))\n\nclass NormalizedTuple:\n    \"\"\"Represents a tuple with its elements in ascending order.\"\"\"\n    def __init__(self, first: int, second: int) -> None:\n        self.first = first\n        self.second = second\n\n    def as_tuple(self) -> Tuple[int, int]:\n        \"\"\"Returns the normalized elements as a built-in tuple.\"\"\"\n        return (self.first, self.second)\n\nclass OccurrenceDictionary:\n    \"\"\"Aggregates counts for normalized tuples.\"\"\"\n    def __init__(self) -> None:\n        self._entries: Dict[Tuple[int, int], int] = {}\n\n    def increment(self, key: NormalizedTuple) -> None:\n        \"\"\"Increments the count for a given normalized tuple key.\"\"\"\n        tuple_key = key.as_tuple()\n        self._entries[tuple_key] = self._entries.get(tuple_key, 0) + 1\n\n    def to_dict(self) -> Dict[Tuple[int, int], int]:\n        \"\"\"Returns the dictionary mapping normalized tuples to their counts.\"\"\"\n        return self._entries\n\ndef check_occurences(input_list: list) -> dict:\n    \"\"\"\n    Counts occurrences of unique tuples in a list after normalizing them.\n    Tuples (a,b) and (b,a) are treated as equivalent and normalized to (min(a,b), max(a,b)).\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    occurrences = OccurrenceDictionary()\n\n    for item in input_list:\n        if not isinstance(item, tuple):\n            raise TypeError(f\"List elements must be tuples, got {type(item)}.\")\n        if len(item) != 2:\n            raise ValueError(f\"Tuples must have exactly 2 elements, got {len(item)}.\")\n        \n        a, b = item\n        if not isinstance(a, int) or not isinstance(b, int):\n            raise TypeError(f\"Tuple elements must be integers, got types {type(a)}, {type(b)}.\")\n        \n        tuple_pair = TuplePair(a, b)\n        normalized_key = tuple_pair.normalize()\n        occurrences.increment(normalized_key)\n            \n    return occurrences.to_dict()"}
{"task_id": "Mbpp/244", "solution": "import math\n\nclass ValidationError(TypeError):\n    \"\"\"Custom exception for input validation errors, subclassing TypeError.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\nclass IntegerInput:\n    \"\"\"Encapsulates an input value and provides a method to validate if it's an integer.\"\"\"\n    def __init__(self, value):\n        self.value = value\n\n    def validate(self) -> bool:\n        \"\"\"Checks if the encapsulated value is an integer.\"\"\"\n        return isinstance(self.value, int)\n\nclass PerfectSquareResult:\n    \"\"\"Represents a computed perfect square and provides introspection.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def isPerfectSquare(self) -> bool:\n        \"\"\"Checks if the encapsulated value is a perfect square using math.isqrt.\"\"\"\n        if self.value < 0:\n            return False\n        root = math.isqrt(self.value)\n        return root * root == self.value\n\ndef next_Perfect_Square(n: int) -> int:\n    \"\"\"Finds the next perfect square strictly greater than a given number n.\"\"\"\n    input_validator = IntegerInput(n)\n    if not input_validator.validate():\n        raise ValidationError(\"input must be int\")\n\n    if n < 0:\n        return 0\n\n    # Calculate the integer square root of n.\n    r = math.isqrt(n)\n    \n    # If n is a perfect square or r*r is less than n, increment r to find the next root.\n    if r * r <= n:\n        r = r + 1\n    \n    # The next perfect square is r squared.\n    result_value = r * r\n    \n    # Instantiate PerfectSquareResult as per design, then return its value.\n    _ = PerfectSquareResult(result_value) # Design indicates construction, but value is returned directly.\n    return result_value"}
{"task_id": "Mbpp/245", "solution": "from typing import List\n\ndef max_sum(array: List[int]) -> int:\n    \"\"\"\n    Computes the maximum sum of a bitonic subsequence in the given array.\n    A bitonic subsequence is first increasing and then decreasing.\n    \"\"\"\n    n = len(array)\n\n    if n == 0:\n        return 0\n    if n == 1:\n        return array[0]\n\n    # computeMSIS: maximum sum of an increasing subsequence ending at i\n    msis = [0] * n\n    for i in range(n):\n        msis[i] = array[i]\n        for j in range(i):\n            if array[i] > array[j]:\n                msis[i] = max(msis[i], msis[j] + array[i])\n\n    # computeMSDS: maximum sum of a decreasing subsequence starting at i\n    msds = [0] * n\n    for i in range(n - 1, -1, -1):\n        msds[i] = array[i]\n        for j in range(n - 1, i, -1):\n            if array[i] > array[j]:\n                msds[i] = max(msds[i], msds[j] + array[i])\n\n    # Combine MSIS and MSDS to find the maximum bitonic sum\n    # A bitonic subsequence has a peak element. The sum for a bitonic sequence\n    # where array[i] is the peak is MSIS[i] + MSDS[i] - array[i] (array[i] is counted twice).\n    max_bitonic_sum = 0\n    for i in range(n):\n        max_bitonic_sum = max(max_bitonic_sum, msis[i] + msds[i] - array[i])\n\n    return max_bitonic_sum"}
