{"task_id": "Mbpp/265", "solution": "from typing import Any, List\n\nclass ValidationError(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\nclass ListSplitter:\n    def __init__(self, input_list: List[Any], n: int) -> None:\n        self._input_list = input_list\n        self._n = n\n\n    def validate_n(self, n: int) -> None:\n        \"\"\"Validates that n is a positive integer as required.\"\"\"\n        if not isinstance(n, int) or n <= 0:\n            raise ValidationError(\"n must be a positive integer.\")\n\n    def split(self) -> List[List[Any]]:\n        \"\"\"Splits the input list into n sublists according to the k mod n rule.\"\"\"\n        sublists: List[List[Any]] = [[] for _ in range(self._n)]\n\n        for k, element in enumerate(self._input_list):\n            sublists[k % self._n].append(element)\n\n        return sublists\n\ndef list_split(input_list: List[Any], n: int) -> List[List[Any]]:\n    \"\"\"Splits a list for every nth element, returning a list of the resulting lists.\"\"\"\n    ls = ListSplitter(input_list, n)\n    ls.validate_n(n)\n    return ls.split()"}
{"task_id": "Mbpp/267", "solution": "from src.odd_sequence import OddSequence\nfrom src.calculation import Calculation\n\ndef square_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the squares of the first n odd natural numbers.\n    Precondition: n is an integer. Behavior for non-integer or negative n is unspecified.\n    \"\"\"\n    odd_sequence_generator = OddSequence()\n    odd_numbers = odd_sequence_generator.generate(n)\n\n    calculator = Calculation()\n    sum_of_squares = calculator.sumSquares(odd_numbers)\n\n    return sum_of_squares"}
{"task_id": "Mbpp/269", "solution": "class Character:\n    \"\"\"A lightweight container for a single character, enforcing its length.\"\"\"\n    def __init__(self, value: str) -> None:\n        if not isinstance(value, str) or len(value) != 1:\n            raise ValueError(\"Input must be a single character string.\")\n        self.value = value\n\nclass AsciiConverter:\n    \"\"\"Stateless component for ASCII value conversion.\"\"\"\n    def ascii_value(self, single_char_str: str) -> int:\n        \"\"\"Converts a single character string to its ASCII integer code, assuming valid input.\"\"\"\n        # This method assumes the input string has already been validated to be a single character.\n        return ord(single_char_str)\n\ndef ascii_value(input_char: str) -> int:\n    \"\"\"\n    Finds the ASCII integer value of a single character.\n    Raises ValueError if the input is not a single character string.\n    \"\"\"\n    # Create and validate a Character object; this handles input length validation.\n    char_obj = Character(input_char)\n\n    # Delegate the conversion to an AsciiConverter instance.\n    converter = AsciiConverter()\n    return converter.ascii_value(char_obj.value)"}
{"task_id": "Mbpp/271", "solution": "class EvenNumberSequence:\n    def generate(self, n):\n        \"\"\"Generates a list of the first n even natural numbers.\"\"\"\n        return [2 * i for i in range(1, n + 1)]\n\nclass PowerCalculator:\n    def pow(self, base, exp):\n        \"\"\"Computes the base raised to the exponent.\"\"\"\n        return base ** exp\n\nclass Summation:\n    def sum(self, values):\n        \"\"\"Sums an iterable of integer values.\"\"\"\n        return sum(values)\n\nclass Result:\n    def __init__(self, value: int) -> None:\n        \"\"\"Initializes the Result container with an integer value.\"\"\"\n        self._value = value\n\n    def __int__(self) -> int:\n        \"\"\"Allows conversion of the Result object to an an integer.\"\"\"\n        return self._value\n\ndef even_Power_Sum(n):\n    \"\"\"\n    Calculates the sum of the first n even natural numbers raised to the fifth power.\n    This function orchestrates helper classes for sequence generation, power computation, and summation.\n    \"\"\"\n    even_seq_gen = EvenNumberSequence()\n    power_calc = PowerCalculator()\n    summer = Summation()\n\n    even_numbers = even_seq_gen.generate(n)\n\n    powered_values = []\n    for even_num in even_numbers:\n        powered_values.append(power_calc.pow(even_num, 5))\n\n    total_sum = summer.sum(powered_values)\n\n    final_result_obj = Result(total_sum)\n    return int(final_result_obj)"}
{"task_id": "Mbpp/268", "solution": "class ValidationError(Exception):\n    def __init__(self, message: str):\n        super().__init__(message)\n\nclass StarNumberResult:\n    def __init__(self, value: int):\n        self.value = value\n\nclass StarNumberCalculator:\n    def find_star_num(self, n: int) -> StarNumberResult:\n        \"\"\"Validates input and computes the n'th star number, returning it in a StarNumberResult object.\"\"\"\n        self._validate(n)\n        value = self._compute(n)\n        return StarNumberResult(value)\n\n    def _validate(self, n) -> None:\n        \"\"\"Ensures n is an integer and n >= 1, raising ValidationError if not.\"\"\"\n        if not isinstance(n, int):\n            raise ValidationError(\"Input 'n' must be an integer.\")\n        if n < 1:\n            raise ValidationError(\"Input 'n' must be an integer greater than or equal to 1.\")\n\n    def _compute(self, n: int) -> int:\n        \"\"\"Computes the n'th star number using the formula 6 * n * (n - 1) + 1.\"\"\"\n        return 6 * n * (n - 1) + 1\n\ndef find_star_num(n: int) -> int:\n    \"\"\"\n    Finds the n'th star number.\n    Delegates to StarNumberCalculator for validation and computation.\n    \"\"\"\n    calculator = StarNumberCalculator()\n    result_obj = calculator.find_star_num(n)\n    return result_obj.value"}
{"task_id": "Mbpp/270", "solution": "from typing import List\n\ndef sum_even_and_even_index(lst: List[int]) -> int:\n    \"\"\"Compute sum of elements that are even and at even indices.\n\n    Returns the sum of qualifying elements (0 if none).\n    \"\"\"\n    total = 0\n    for i in range(len(lst)):\n        if i % 2 == 0:  # check if index is even\n            v = lst[i]\n            if v % 2 == 0:  # check if value is even\n                total += v\n    return total"}
