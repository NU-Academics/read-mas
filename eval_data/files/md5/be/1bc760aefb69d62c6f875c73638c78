{"task_id": "Mbpp/308", "solution": "from typing import Sequence, List, Iterator\n\ndef _is_numeric(value) -> bool:\n    \"\"\"Checks if a value is numeric (int or float).\"\"\"\n    return isinstance(value, (int, float))\n\nclass Validator:\n    \"\"\"Validates input lists and k value.\"\"\"\n    def validate_lists(self, list1: Sequence, list2: Sequence) -> None:\n        \"\"\"Validates that lists are sequences and contain only numeric elements.\"\"\"\n        if not isinstance(list1, Sequence) or not isinstance(list2, Sequence):\n            raise ValueError(\"list1 and list2 must be sequences.\")\n        for lst, name in [(list1, 'list1'), (list2, 'list2')]:\n            for item in lst:\n                if not _is_numeric(item):\n                    raise ValueError(f\"All elements in {name} must be numeric.\")\n\n    def validate_k(self, k: int) -> None:\n        \"\"\"Validates that k is a non-negative integer.\"\"\"\n        if not isinstance(k, int) or k < 0:\n            raise ValueError(\"k must be a non-negative integer.\")\n\nclass InputList:\n    \"\"\"A lightweight wrapper for list elements.\"\"\"\n    def __init__(self, elements: Sequence[float | int]) -> None:\n        self.elements = list(elements)\n    def __len__(self) -> int:\n        return len(self.elements)\n    def __iter__(self) -> Iterator[float | int]:\n        return iter(self.elements)\n\nclass ProductPair:\n    \"\"\"Holds a factor pair and computes its product.\"\"\"\n    def __init__(self, a: float | int, b: float | int) -> None:\n        self.a = a\n        self.b = b\n    def product(self) -> float:\n        \"\"\"Returns the product of the two factors.\"\"\"\n        return float(self.a * self.b)\n\nclass ProductResult:\n    \"\"\"Aggregates product values, provides sorting and top-k retrieval.\"\"\"\n    def __init__(self, products: Sequence[float]) -> None:\n        self.products = list(products)\n    def sort_desc(self) -> None:\n        \"\"\"Sorts the products in descending order.\"\"\"\n        self.products.sort(reverse=True)\n    def top(self, k: int) -> List[float]:\n        \"\"\"Returns the top k products from the sorted list.\"\"\"\n        return self.products[:k]\n\ndef _compute_pairwise_products(list1: Sequence[float | int], list2: Sequence[float | int]) -> List[float]:\n    \"\"\"Computes all pairwise products between elements of two lists.\"\"\"\n    products = []\n    for a in list1:\n        for b in list2:\n            pair = ProductPair(a, b)\n            products.append(pair.product())\n    return products\n\ndef large_product(list1: Sequence[float | int], list2: Sequence[float | int], k: int) -> List[float]:\n    \"\"\"\n    Finds the specified number of largest products from two given lists,\n    selecting one factor from each list. Raises ValueError for invalid inputs.\n    \"\"\"\n    validator = Validator()\n    validator.validate_lists(list1, list2)\n    validator.validate_k(k)\n\n    if not list1 or not list2 or k == 0:\n        return []\n\n    products = _compute_pairwise_products(list1, list2)\n    result = ProductResult(products)\n    result.sort_desc()\n    return result.top(k)"}
{"task_id": "Mbpp/306", "solution": "from typing import List\n\nclass ValidationError(Exception):\n    \"\"\"Exception to signal input validation failures.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(message)\n\nclass Array:\n    \"\"\"Represents an input array and its asserted length.\"\"\"\n    def __init__(self, elements: List[int], n: int):\n        self.elements = elements\n        self.n = n\n\nclass FunctionInput:\n    \"\"\"Encapsulates call inputs for validation and tracing.\"\"\"\n    def __init__(self, arr: List[int], n: int, i: int, k: int):\n        self.arr = arr\n        self.n = n\n        self.i = i\n        self.k = k\n\nclass Subsequence:\n    \"\"\"Represents candidate subsequences, computes sum and tracks inclusion of k.\"\"\"\n    def __init__(self, indices: List[int], elements: List[int]):\n        self.indices = indices\n        self.elements = elements\n        self.sum = sum(elements)\n        self.includes_k = False\n\n    def last_value(self) -> int:\n        \"\"\"Returns the last element's value in the subsequence.\"\"\"\n        if not self.elements:\n            raise ValueError(\"Subsequence is empty, cannot get last value.\")\n        return self.elements[-1]\n\ndef max_sum_increasing_subseq(arr: List[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence from prefix until ith index,\n    including a given kth element where k > i.\n    \"\"\"\n    # Validate inputs according to the design specifications.\n    if n != len(arr):\n        raise ValidationError(\"n must equal len(arr)\")\n    if not (0 <= i < k < n):\n        raise ValidationError(\"index constraints violated (require 0 <= i < k < n)\")\n\n    # Initialize a DP array to store the maximum sum of an increasing subsequence\n    # ending at each index j within the prefix arr[0...i].\n    best_sum = [0] * (i + 1)\n\n    # Compute best_sum[] for prefix indices 0..i.\n    for j in range(i + 1):\n        best_sum[j] = arr[j]  # The element itself forms a subsequence of sum arr[j].\n        for p in range(j):\n            if arr[p] < arr[j]:\n                best_sum[j] = max(best_sum[j], best_sum[p] + arr[j])\n\n    # Build candidate sums that include arr[k].\n    # arr[k] alone is a valid subsequence per the design.\n    candidates = [arr[k]]\n\n    # For each index j in the prefix 0..i, if arr[j] is less than arr[k],\n    # we can potentially extend the increasing subsequence ending at arr[j] with arr[k].\n    for j in range(i + 1):\n        if arr[j] < arr[k]:\n            candidates.append(best_sum[j] + arr[k])\n\n    # Return the maximum sum found among all valid candidates.\n    return max(candidates)"}
{"task_id": "Mbpp/310", "solution": "def string_to_tuple(input: str) -> tuple:\n    \"\"\"Converts a string to a tuple of characters, excluding ASCII spaces.\"\"\"\n\n    if not isinstance(input, str):\n        raise TypeError(\"Input must be a string.\")\n\n    collected_chars = []\n    for char in input:\n        if char != ' ':  # Exclude ASCII space (U+0020)\n            collected_chars.append(char)\n            \n    return tuple(collected_chars)"}
