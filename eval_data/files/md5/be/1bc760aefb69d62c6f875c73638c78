{"task_id": "Mbpp/602", "solution": "def first_repeated_char(s: str) -> str:\n    \"\"\"\n    Finds the first character that repeats in a string, scanning left-to-right.\n    Raises ValueError if no repeating character is found.\n    \"\"\"\n    seen = set()\n    for char in s:\n        if char in seen:\n            return char\n        seen.add(char)\n    raise ValueError(\"no repeating character found\")"}
{"task_id": "Mbpp/599", "solution": "class InputValidator:\n    \"\"\"Handles validation of input parameters.\"\"\"\n    @staticmethod\n    def isPositiveInteger(n):\n        \"\"\"Checks if n is a positive integer (>= 1).\"\"\"\n        return isinstance(n, int) and n >= 1\n\n    @staticmethod\n    def raiseError(message):\n        \"\"\"Raises a ValueError with the given message.\"\"\"\n        raise ValueError(message)\n\nclass ResultTuple:\n    \"\"\"A model for the result, containing sum and average.\"\"\"\n    def __init__(self, sum_val: int, average_val: float):\n        self.sum = sum_val\n        self.average = average_val\n\nclass NaturalNumberSequence:\n    \"\"\"Generates a sequence of natural numbers.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n\n    def generate(self) -> list[int]:\n        \"\"\"Returns a list of natural numbers from 1 to n.\"\"\"\n        return list(range(1, self.n + 1))\n\nclass SumAverageFunction:\n    \"\"\"Manages the computation of sum and average.\"\"\"\n    def computeSum(self, n: int) -> int:\n        \"\"\"Computes the sum of the first n natural numbers.\"\"\"\n        return n * (n + 1) // 2\n\n    def computeAverage(self, sum_val: int, n: int) -> float:\n        \"\"\"Computes the average of the sum and n.\"\"\"\n        return sum_val / float(n)\n\n    def execute(self, n: int) -> tuple[int, float]:\n        \"\"\"Executes the sum and average calculation.\"\"\"\n        s = self.computeSum(n)\n        a = self.computeAverage(s, n)\n        return (s, a)\n\ndef sum_average(n):\n    \"\"\"\n    Finds the sum and average of the first n natural numbers.\n    It validates input and uses helper classes for computation.\n    \"\"\"\n    if not InputValidator.isPositiveInteger(n):\n        InputValidator.raiseError(\"n must be an integer >= 1\")\n\n    calculator = SumAverageFunction()\n    return calculator.execute(n)"}
{"task_id": "Mbpp/604", "solution": "def reverse_words(input: str) -> str:\n    \"\"\"\n    Splits the input string into words, reverses their order, and joins them back with spaces.\n    Word boundaries are determined strictly by the single space character.\n    \"\"\"\n    words = input.split(' ')\n    reversed_words = words[::-1]\n    return ' '.join(reversed_words)"}
{"task_id": "Mbpp/603", "solution": "from typing import List\n\nclass InputParameter:\n    \"\"\"Encapsulates integer input.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass LudicNumber:\n    \"\"\"Represents a single ludic number.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\nclass LudicList:\n    \"\"\"Ordered collection of ludic numbers.\"\"\"\n    def __init__(self, numbers: List[int]) -> None:\n        self.numbers = sorted(numbers)\n\n    def to_list(self) -> List[int]:\n        \"\"\"Returns the list of ludic numbers.\"\"\"\n        return self.numbers\n\nclass SieveAlgorithm:\n    \"\"\"Stateless algorithm to compute ludic numbers.\"\"\"\n    def compute(self, n: int) -> List[int]:\n        \"\"\"\n        Computes and returns a list of ludic numbers <= n in ascending order.\n        \"\"\"\n        if n < 1:\n            return []\n\n        numbers_list = list(range(1, n + 1))\n        ludic_numbers_result = []\n\n        while numbers_list:\n            current_ludic_num = numbers_list.pop(0)\n            ludic_numbers_result.append(current_ludic_num)\n\n            if current_ludic_num == 1:\n                continue\n\n            index_to_remove = current_ludic_num - 1\n            while index_to_remove < len(numbers_list):\n                numbers_list.pop(index_to_remove)\n                index_to_remove += (current_ludic_num - 1)\n\n        return ludic_numbers_result\n\nclass LudicService:\n    \"\"\"Orchestrates computation of ludic numbers.\"\"\"\n    def __init__(self, algorithm: SieveAlgorithm = None) -> None:\n        self.algorithm = algorithm if algorithm is not None else SieveAlgorithm()\n\n    def get_ludic(self, n: int) -> List[int]:\n        \"\"\"\n        Computes ludic numbers and returns them as an ascending list.\n        \"\"\"\n        computed_numbers = self.algorithm.compute(n)\n        ludic_list_obj = LudicList(computed_numbers)\n        return ludic_list_obj.to_list()\n\ndef get_ludic(n: int) -> List[int]:\n    \"\"\"\n    Gets all lucid numbers smaller than or equal to a given integer.\n    \"\"\"\n    service_instance = LudicService()\n    return service_instance.get_ludic(n)"}
{"task_id": "Mbpp/605", "solution": "import math\n\ndef prime_num(n: int) -> bool:\n    \"\"\"\n    Checks if the given integer is a prime number.\n    A prime number is a natural number greater than 1 that has no positive divisors other than 1 and itself.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    \n    # Check for factors from 3 up to the square root of n, incrementing by 2\n    limit = math.isqrt(n)\n    for i in range(3, limit + 1, 2):\n        if n % i == 0:\n            return False\n            \n    return True"}
