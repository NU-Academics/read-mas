{"task_id": "Mbpp/409", "solution": "def _product_of_pair(pair):\n    \"\"\"Computes the product of two elements in a pair.\"\"\"\n    return pair[0] * pair[1]\n\ndef min_product_tuple(input_list):\n    \"\"\"\n    Finds the minimum product from the pairs of tuples within a given list.\n    Calculates a*b for each 2-element tuple and returns the minimum product.\n    \"\"\"\n    # Assumes input_list is a non-empty list of 2-element numeric tuples,\n    # adhering to the \"DO NOT add isinstance() checks or raise exceptions for edge cases\" requirement.\n    \n    return min(_product_of_pair(pair) for pair in input_list)"}
{"task_id": "Mbpp/410", "solution": "from typing import List, Any, Optional\n\nclass Element:\n    \"\"\"Represents a single item from the input list and provides numeric classification.\"\"\"\n    def __init__(self, value: Any):\n        self.value = value\n\n    def is_numeric(self) -> bool:\n        \"\"\"Checks if the element's value is an integer or a float.\"\"\"\n        return isinstance(self.value, (int, float))\n\nclass NumericElement(Element):\n    \"\"\"Represents a numeric element, storing its value as a float.\"\"\"\n    def __init__(self, value: int | float):\n        super().__init__(value)\n        self.number: float = float(value)\n\nclass NonNumericElement(Element):\n    \"\"\"Represents a non-numeric element.\"\"\"\n    def __init__(self, raw_value: Any):\n        super().__init__(raw_value)\n        self.raw = raw_value\n\nclass InputList:\n    \"\"\"A lightweight wrapper for the raw input list, containing Element instances.\"\"\"\n    def __init__(self, raw_elements: list):\n        self.elements: List[Element] = [Element(item) for item in raw_elements]\n\n    def __iter__(self):\n        return iter(self.elements)\n\nclass Result:\n    \"\"\"A container for the computed minimum value, or None if no numeric values were found.\"\"\"\n    def __init__(self, min_value: Optional[float]):\n        self.min_value = min_value\n\ndef min_val(input_list: list) -> Optional[float]:\n    \"\"\"\n    Finds the minimum numeric value in a given heterogeneous list, ignoring non-numeric elements.\n    Returns None if no numeric elements are found in the list.\n    \"\"\"\n    parsed_list = InputList(input_list)\n    numeric_values: List[float] = []\n\n    for element in parsed_list:\n        if element.is_numeric():\n            # Create a NumericElement to consistently store and compare numeric values as floats.\n            numeric_values.append(NumericElement(element.value).number)\n\n    if not numeric_values:\n        result_obj = Result(None)\n    else:\n        minimum = min(numeric_values)\n        result_obj = Result(minimum)\n\n    return result_obj.min_value"}
{"task_id": "Mbpp/412", "solution": "from typing import List\n\nclass EvenNumber:\n    \"\"\"Helper class to check if a number is even.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def is_even(self) -> bool:\n        \"\"\"Checks if the number is even.\"\"\"\n        return self.value % 2 == 0\n\nclass IntegerList:\n    \"\"\"Wrapper class for a list of integers.\"\"\"\n    def __init__(self, elements: List[int]) -> None:\n        self.elements = elements\n\n    def size(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self.elements)\n\n    def is_empty(self) -> bool:\n        \"\"\"Checks if the list is empty.\"\"\"\n        return len(self.elements) == 0\n\ndef remove_odd(input_list: List[int]) -> List[int]:\n    \"\"\"\n    Filters a list to remove odd numbers, returning a new list with only even numbers.\n    Preserves the original order of even numbers.\n    \"\"\"\n    integer_list_obj = IntegerList(input_list)\n    result = []\n\n    for number in integer_list_obj.elements:\n        if EvenNumber(number).is_even():\n            result.append(number)\n            \n    return result"}
{"task_id": "Mbpp/413", "solution": "from typing import List, Tuple, Any, Iterable\n\ndef _validate_inputs(tuple_list: Iterable[Tuple], n: int) -> None:\n    \"\"\"\n    Validates input types for 'tuple_list' and 'n'.\n    Raises TypeError if types are incorrect or n is negative.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(f\"Index 'n' must be an integer, but got {type(n).__name__}.\")\n    if n < 0:\n        raise TypeError(f\"Index 'n' must be a non-negative integer, but got {n}.\") \n    \n    if not isinstance(tuple_list, Iterable):\n        raise TypeError(f\"First argument 'tuple_list' must be an iterable, but got {type(tuple_list).__name__}.\")\n\ndef _element_at(tpl: Tuple, n: int) -> Any:\n    \"\"\"\n    Returns the element at index n from a tuple.\n    Allows IndexError to propagate if the index is out of bounds.\n    \"\"\"\n    return tpl[n]\n\ndef extract_nth_element(tuple_list: Iterable[Tuple], n: int) -> List[Any]:\n    \"\"\"\n    Extracts the nth element from each tuple in a given list of tuples.\n    Performs input validation and collects elements, propagating specific errors.\n    \"\"\"\n    _validate_inputs(tuple_list, n)\n\n    result = []\n    for i, tpl in enumerate(tuple_list):\n        if not isinstance(tpl, Tuple):\n            raise TypeError(f\"Element at index {i} in 'tuple_list' is not a tuple, but got {type(tpl).__name__}.\")\n        \n        result.append(_element_at(tpl, n))\n            \n    return result"}
{"task_id": "Mbpp/418", "solution": "def Find_Max(input_list):\n    \"\"\"\n    Accepts a single argument `input_list` (a Python list). Returns one element from `input_list`\n    that has maximum length as computed by len().\n    \"\"\"\n    max_elem = input_list[0]\n    max_len = len(max_elem)\n    for elem in input_list[1:]:\n        cur_len = len(elem)\n        if cur_len > max_len:\n            max_len = cur_len\n            max_elem = elem\n    return max_elem"}
{"task_id": "Mbpp/414", "solution": "from typing import Any, Iterable\n\nclass OverlapChecker:\n    \"\"\"A stateless domain service for checking overlapping elements between sequences.\"\"\"\n    def overlapping(self, seq1: Iterable[Any], seq2: Iterable[Any]) -> bool:\n        \"\"\"\n        Checks if any element in seq1 is equal to any element in seq2.\n        Uses nested iteration for comparison.\n        \"\"\"\n        for x in seq1:\n            for y in seq2:\n                if x == y:\n                    return True\n        return False\n\ndef overlapping(seq1: Iterable[Any], seq2: Iterable[Any]) -> bool:\n    \"\"\"\n    Checks whether any value in the first sequence exists in the second sequence.\n    Delegates the check to an OverlapChecker instance.\n    \"\"\"\n    checker = OverlapChecker()\n    return checker.overlapping(seq1, seq2)"}
{"task_id": "Mbpp/420", "solution": "def _validate_n(n):\n    \"\"\"Validates that n is a non-negative integer.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer.\")\n    if n < 0:\n        raise ValueError(\"n must be a non-negative integer.\")\n\ndef _generate_even_values(n):\n    \"\"\"Generates the sequence of first n even natural numbers.\"\"\"\n    for k in range(1, n + 1):\n        yield 2 * k\n\ndef _sum_cubes_of_evens(n):\n    \"\"\"Computes the sum of cubes for given n by iterating even values.\"\"\"\n    total_sum = 0\n    for even_num in _generate_even_values(n):\n        total_sum += even_num ** 3\n    return total_sum\n\ndef cube_Sum(n):\n    \"\"\"\n    Calculates the sum of cubes of the first n even natural numbers.\n    Raises TypeError if n is not an int, ValueError if n < 0.\n    \"\"\"\n    _validate_n(n)\n    return _sum_cubes_of_evens(n)"}
{"task_id": "Mbpp/415", "solution": "def max_Product(arr):\n    \"\"\"Return tuple (a, b) of two integers from arr whose product is maximal.\n    Precondition: arr has at least two integers (otherwise ValueError).\n    Tie-breaking: smallest first index, then smallest second index.\n    \"\"\"\n    if len(arr) < 2:\n        raise ValueError(\"Input array must contain at least two integers.\")\n\n    # Initialize largest and smallest value-index pairs (value, index)\n    l1 = (-float('inf'), -1)  # Largest value, smallest index if values are equal\n    l2 = (-float('inf'), -1)  # Second largest value, smallest index if values are equal\n\n    s1 = (float('inf'), -1)   # Smallest value, smallest index if values are equal\n    s2 = (float('inf'), -1)   # Second smallest value, smallest index if values are equal\n\n    for idx, val in enumerate(arr):\n        current_pair = (val, idx)\n\n        # Update largest candidates\n        # If current_pair is 'better' than l1 (larger value, or same value with smaller index)\n        if current_pair[0] > l1[0] or (current_pair[0] == l1[0] and current_pair[1] < l1[1]):\n            # If it's the exact same element (same value AND same index), skip\n            if current_pair[1] == l1[1] and current_pair[0] == l1[0]:\n                continue\n            l2 = l1\n            l1 = current_pair\n        # Else if current_pair is distinct from l1 and 'better' than l2\n        elif current_pair[1] != l1[1] and \\\n             (current_pair[0] > l2[0] or (current_pair[0] == l2[0] and current_pair[1] < l2[1])):\n            l2 = current_pair\n\n        # Update smallest candidates (mirror logic to largest)\n        # If current_pair is 'better' than s1 (smaller value, or same value with smaller index)\n        if current_pair[0] < s1[0] or (current_pair[0] == s1[0] and current_pair[1] < s1[1]):\n            # If it's the exact same element, skip\n            if current_pair[1] == s1[1] and current_pair[0] == s1[0]:\n                continue\n            s2 = s1\n            s1 = current_pair\n        # Else if current_pair is distinct from s1 and 'better' than s2\n        elif current_pair[1] != s1[1] and \\\n             (current_pair[0] < s2[0] or (current_pair[0] == s2[0] and current_pair[1] < s2[1])):\n            s2 = current_pair\n            \n    # Calculate candidate products\n    product_l = l1[0] * l2[0]\n    product_s = s1[0] * s2[0]\n\n    # Prepare result details for tie-breaking and output\n    \n    # For largest pair: ensure indices are ordered for tie-breaking, values sorted for output\n    val_l1, idx_l1 = l1\n    val_l2, idx_l2 = l2\n    if idx_l1 > idx_l2: \n        val_l1, val_l2 = val_l2, val_l1\n        idx_l1, idx_l2 = idx_l2, idx_l1\n    l_output_values = tuple(sorted((val_l1, val_l2)))\n    l_tie_break_indices = (idx_l1, idx_l2)\n\n    # For smallest pair: ensure indices are ordered for tie-breaking, values sorted for output\n    val_s1, idx_s1 = s1\n    val_s2, idx_s2 = s2\n    if idx_s1 > idx_s2:\n        val_s1, val_s2 = val_s2, val_s1\n        idx_s1, idx_s2 = idx_s2, idx_s1\n    s_output_values = tuple(sorted((val_s1, val_s2)))\n    s_tie_break_indices = (idx_s1, idx_s2)\n\n    # Determine the final pair based on product, then tie-breaking rules\n    if product_l > product_s:\n        return l_output_values\n    elif product_s > product_l:\n        return s_output_values\n    else: # Products are equal, apply tie-breaking rules based on indices\n        # Compare (idx1, idx2) lexicographically\n        if l_tie_break_indices < s_tie_break_indices:\n            return l_output_values\n        else: # If indices are also equal (or s_tie_break_indices is smaller), prefer s_output_values for determinism\n            return s_output_values"}
{"task_id": "Mbpp/419", "solution": "from typing import List\nfrom dataclasses import dataclass, field\n\n@dataclass\nclass NumberItem:\n    \"\"\"Represents an individual number with its original and rounded values.\"\"\"\n    original_value: float\n    rounded_value: int\n\n@dataclass\nclass NumberList:\n    \"\"\"Holds the list of original numbers and computes its length.\"\"\"\n    values: List[float]\n    length: int = field(init=False)\n\n    def __post_init__(self):\n        self.length = len(self.values)\n\n@dataclass\nclass SumResult:\n    \"\"\"Stores the sum of rounded numbers and the final multiplied result.\"\"\"\n    sum_of_rounded: int\n    multiplied_result: int\n\ndef round_and_sum(numbers: List[float]) -> int:\n    \"\"\"\n    Rounds every number in a list using round-half-to-even,\n    then sums the rounded numbers and multiplies by the list's length.\n    Returns 0 for an empty input list as per design.\n    \"\"\"\n    if not numbers:\n        return 0\n\n    number_list_instance = NumberList(values=numbers)\n\n    number_items: List[NumberItem] = []\n    for original_value in number_list_instance.values:\n        rounded_value = int(round(original_value))\n        number_items.append(NumberItem(original_value=original_value, rounded_value=rounded_value))\n\n    sum_of_rounded = sum(item.rounded_value for item in number_items)\n\n    multiplied_result = sum_of_rounded * number_list_instance.length\n\n    sum_result_instance = SumResult(sum_of_rounded=sum_of_rounded, multiplied_result=multiplied_result)\n\n    return sum_result_instance.multiplied_result"}
{"task_id": "Mbpp/421", "solution": "def _validate_is_tuple(input_tuple) -> None:\n    \"\"\"Validates that the input is a tuple.\"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"input must be a tuple\")\n\ndef _convert_elements_to_strings(input_tuple) -> list:\n    \"\"\"Converts each element of the tuple to its string representation.\"\"\"\n    return [str(e) for e in input_tuple]\n\ndef _join_strings(strings, delimiter) -> str:\n    \"\"\"Joins a list of strings with the given delimiter.\"\"\"\n    return delimiter.join(strings)\n\ndef concatenate_tuple(input_tuple, delimiter='-') -> str:\n    \"\"\"Validate input is tuple, convert elements via str(), and join using delimiter (default '-').\"\"\"\n    _validate_is_tuple(input_tuple)\n    string_elements = _convert_elements_to_strings(input_tuple)\n    return _join_strings(string_elements, delimiter)"}
{"task_id": "Mbpp/424", "solution": "from typing import Tuple, List\n\ndef extract_rear(input_tuple: Tuple[str, ...]) -> List[str]:\n    \"\"\"Return a list of the last character (as single-character strings) of each string in input_tuple.\n    SRS acceptance: extract_rear(('Mers', 'for', 'Vers')) == ['s', 'r', 's']\n    \"\"\"\n    result: List[str] = []\n    for s in input_tuple:\n        result.append(s[-1])\n    return result"}
{"task_id": "Mbpp/422", "solution": "class Validator:\n    \"\"\"Helper class for input validation.\"\"\"\n    @staticmethod\n    def validate_integer_positive(n):\n        \"\"\"Validates if n is an integer and n >= 1, raising ValueError if not.\"\"\"\n        if not isinstance(n, int) or n < 1:\n            raise ValueError(\"n must be an integer >= 1\")\n\nclass CubeComputation:\n    \"\"\"Helper class for cube sum computations.\"\"\"\n    @staticmethod\n    def sum_of_cubes_formula(n):\n        \"\"\"Computes the sum of cubes of first n natural numbers using the closed-form formula.\"\"\"\n        sum_of_naturals = n * (n + 1) // 2\n        return sum_of_naturals ** 2\n\nclass AverageResult:\n    \"\"\"Conceptual data holder for an average value as a float.\"\"\"\n    def __init__(self, value: float):\n        self.value = value\n    def __float__(self):\n        return float(self.value)\n\ndef find_Average_Of_Cube(n):\n    \"\"\"\n    Finds the average of cubes of the first n natural numbers.\n    Raises ValueError if n is not an integer >= 1.\n    \"\"\"\n    Validator.validate_integer_positive(n)\n    total_sum_of_cubes = CubeComputation.sum_of_cubes_formula(n)\n    average = total_sum_of_cubes / n\n    return float(average)"}
{"task_id": "Mbpp/425", "solution": "def count_element_in_list(outer_list, target):\n    \"\"\"\n    Counts the number of sublists in outer_list that contain the target element.\n    Each sublist is checked for the target, and if found, contributes one to the total count.\n    \"\"\"\n    count = 0\n    for sublist in outer_list:\n        if target in sublist:\n            count += 1\n    return count"}
{"task_id": "Mbpp/426", "solution": "from typing import List\n\nclass IntegerValue:\n    \"\"\"Wraps an integer and provides an oddness check.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    def isOdd(self) -> bool:\n        \"\"\"Returns True if the wrapped value is odd.\"\"\"\n        return (self._value % 2 != 0)\n\n    @property\n    def value(self) -> int:\n        \"\"\"Returns the wrapped integer value.\"\"\"\n        return self._value\n\nclass IntegerList:\n    \"\"\"A lightweight wrapper for a list of integers.\"\"\"\n    def __init__(self, items: List[int]):\n        self._items = items\n\n    def isEmpty(self) -> bool:\n        \"\"\"Checks if the list is empty.\"\"\"\n        return not self._items\n\n    @property\n    def items(self) -> List[int]:\n        \"\"\"Returns the wrapped list of integers.\"\"\"\n        return self._items\n\nclass FilterOddNumbers:\n    \"\"\"Encapsulates the filtering algorithm to extract odd numbers.\"\"\"\n    def __init__(self, preserveOrder: bool = True):\n        self.preserveOrder = preserveOrder\n\n    def filter(self, input_list: List[int]) -> List[int]:\n        \"\"\"Returns a new list containing only odd integers from input_list in original order.\"\"\"\n        integer_list_wrapper = IntegerList(input_list)\n        if integer_list_wrapper.isEmpty():\n            return []\n\n        filtered_results = []\n        for item_value in integer_list_wrapper.items:\n            integer_value_wrapper = IntegerValue(item_value)\n            if integer_value_wrapper.isOdd():\n                filtered_results.append(integer_value_wrapper.value)\n        return filtered_results\n\ndef filter_oddnumbers(input_list: List[int]) -> List[int]:\n    \"\"\"Return a new list containing only odd integers from input_list in original order.\"\"\"\n    engine = FilterOddNumbers(preserveOrder=True)\n    return engine.filter(input_list)"}
{"task_id": "Mbpp/427", "solution": "def change_date_format(raw: str) -> str:\n    \"\"\"\n    Converts a date string from 'yyyy-mm-dd' format to 'dd-mm-yyyy' format.\n    Preserves leading zeros for day and month.\n    \"\"\"\n    parts = raw.split('-')\n    year = parts[0]\n    month = parts[1]\n    day = parts[2]\n    return f\"{day}-{month}-{year}\""}
{"task_id": "Mbpp/428", "solution": "from typing import List\n\nclass ShellSort:\n    \"\"\"Encapsulates the Shell sort algorithm and its helper operations.\"\"\"\n\n    algorithm: str = \"Shell\"\n\n    def computeGaps(self, n: int) -> List[int]:\n        \"\"\"\n        Computes the gap sequence for Shell sort using a standard halving approach.\n        Returns gaps in descending order.\n        \"\"\"\n        gaps = []\n        gap = n // 2\n        while gap > 0:\n            gaps.append(gap)\n            gap //= 2\n        return gaps\n\n    def gapInsertionSort(self, arr: List[int], gap: int) -> None:\n        \"\"\"\n        Performs a gap-based insertion sort pass on the array for the provided gap.\n        Modifies arr in-place.\n        \"\"\"\n        for i in range(gap, len(arr)):\n            temp = arr[i]\n            j = i\n            while j >= gap and arr[j - gap] > temp:\n                arr[j] = arr[j - gap]\n                j -= gap\n            arr[j] = temp\n\n    def shell_sort(self, arr: List[int]) -> List[int]:\n        \"\"\"\n        Performs Shell sort on a copy of the input list and returns the sorted list.\n        Operates in-place on the copy using computed gaps and gap-based insertion sort.\n        \"\"\"\n        n_arr = list(arr)  # Create a copy to avoid mutating the original\n        n = len(n_arr)\n        gaps = self.computeGaps(n)\n\n        for gap in gaps:\n            self.gapInsertionSort(n_arr, gap)\n        return n_arr\n\ndef shell_sort(arr: List[int]) -> List[int]:\n    \"\"\"\n    Sorts a list of integers using the Shell sort algorithm.\n    Delegates the sorting operation to an internal ShellSort class instance.\n    \"\"\"\n    sorter = ShellSort()\n    return sorter.shell_sort(arr)"}
{"task_id": "Mbpp/429", "solution": "def validateLengths(tuple_a: tuple, tuple_b: tuple) -> bool:\n    \"\"\"Validates that the lengths of the two input tuples are equal.\"\"\"\n    if len(tuple_a) != len(tuple_b):\n        raise ValueError(\"tuple lengths differ\")\n    return True\n\ndef validateTypes(tuple_a: tuple, tuple_b: tuple) -> bool:\n    \"\"\"Validates that inputs are tuples and all elements are integers.\"\"\"\n    if not isinstance(tuple_a, tuple) or not isinstance(tuple_b, tuple):\n        raise TypeError(\"inputs must be tuples of ints\")\n    \n    for val in tuple_a:\n        if not isinstance(val, int):\n            raise TypeError(\"inputs must be tuples of ints\")\n            \n    for val in tuple_b:\n        if not isinstance(val, int):\n            raise TypeError(\"inputs must be tuples of ints\")\n            \n    return True\n\ndef computeAnd(tuple_a: tuple, tuple_b: tuple) -> tuple:\n    \"\"\"Computes the elementwise bitwise AND of two tuples.\"\"\"\n    return tuple(a & b for a, b in zip(tuple_a, tuple_b))\n\ndef and_tuples(tuple_a: tuple, tuple_b: tuple) -> tuple:\n    \"\"\"\n    Extracts the elementwise bitwise AND results from two given tuples.\n    Raises TypeError if inputs are not tuples of integers, or ValueError if lengths differ.\n    \"\"\"\n    validateLengths(tuple_a, tuple_b)\n    validateTypes(tuple_a, tuple_b)\n    return computeAnd(tuple_a, tuple_b)"}
{"task_id": "Mbpp/433", "solution": "from typing import Iterable, Union\n\ndef check_greater(array: Iterable[Union[int, float]], number: Union[int, float]) -> bool:\n    \"\"\"\n    Checks if the entered number is strictly greater than every element of the given array.\n    Returns True if number is strictly greater than all elements, False otherwise.\n    \"\"\"\n    for element in array:\n        if number <= element:\n            return False\n    return True"}
{"task_id": "Mbpp/432", "solution": "class Trapezium:\n    def __init__(self, base1: float, base2: float, extraParam: float) -> None:\n        self.base1 = base1\n        self.base2 = base2\n        self.extraParam = extraParam\n        self.median = None\n\n    def computeMedian(self) -> float:\n        # Delegates to MedianCalculator for the actual computation.\n        calculator = MedianCalculator()\n        self.median = calculator.compute(self.base1, self.base2)\n        return self.median\n\nclass MedianCalculator:\n    def compute(self, base1: float, base2: float) -> float:\n        # Calculates the median of a trapezium given its two bases.\n        return (base1 + base2) / 2\n\ndef median_trapezium(base1: float, base2: float, param3: float) -> float:\n    # Computes the median length of a trapezium.\n    # The third parameter is ignored as per the trapezium median definition.\n    trapezium_entity = Trapezium(base1, base2, param3)\n    return trapezium_entity.computeMedian()"}
{"task_id": "Mbpp/436", "solution": "def _is_negative(value) -> bool:\n    \"\"\"Helper function to check if a value is negative.\"\"\"\n    return value < 0\n\ndef neg_nos(numbers: list) -> list:\n    \"\"\"Returns a new list containing only the negative numbers from the input list, preserving order.\"\"\"\n    return [x for x in numbers if _is_negative(x)]"}
{"task_id": "Mbpp/435", "solution": "def last_Digit(n: int) -> int:\n    \"\"\"Compute the last decimal digit of integer n. Raises TypeError if n is not an int, returning a digit in 0-9.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    return abs(n) % 10"}
{"task_id": "Mbpp/437", "solution": "def remove_odd(input: str) -> str:\n    \"\"\"\n    Returns a new string composed of characters from the input that are at 1-based even positions\n    (0-based indices 1, 3, 5, ...).\n    \"\"\"\n    selected_chars = []\n    for i in range(len(input)):\n        if i % 2 == 1:  # Check for 0-based odd index\n            selected_chars.append(input[i])\n    return \"\".join(selected_chars)"}
{"task_id": "Mbpp/439", "solution": "from typing import List\n\ndef multiple_to_single(nums: List[int]) -> int:\n    \"\"\"Joins a list of integers into a single integer by concatenating their decimal representations.\n    Returns 0 for an empty list.\"\"\"\n    if not nums:\n        return 0\n    concatenated_string = \"\".join(str(n) for n in nums)\n    return int(concatenated_string)"}
{"task_id": "Mbpp/430", "solution": "class Coefficients:\n    \"\"\"Holds the coefficients a, b, and c of a parabola y = a*x^2 + b*x + c.\"\"\"\n    def __init__(self, a, b, c):\n        self.a = a\n        self.b = b\n        self.c = c\n\nclass Validator:\n    \"\"\"Provides static methods for validating parabola coefficients.\"\"\"\n    @staticmethod\n    def validate_types(coeffs: Coefficients) -> None:\n        \"\"\"Raises TypeError if any coefficient is not numeric.\"\"\"\n        if not all(isinstance(arg, (int, float)) for arg in [coeffs.a, coeffs.b, coeffs.c]):\n            raise TypeError(\"All coefficients (a, b, c) must be numeric (int or float).\")\n\n    @staticmethod\n    def validate_a_nonzero(coeffs: Coefficients) -> None:\n        \"\"\"Raises ValueError if coefficient 'a' is zero.\"\"\"\n        if coeffs.a == 0:\n            raise ValueError(\"Coefficient 'a' cannot be zero, as it would not be a parabola.\")\n\nclass CalculationEngine:\n    \"\"\"Encapsulates numerical computations for parabola properties.\"\"\"\n    @staticmethod\n    def compute_directrix(coeffs: Coefficients) -> float:\n        \"\"\"Computes the y-coordinate of the directrix using the canonical formula.\"\"\"\n        return coeffs.c - (coeffs.b**2 + 1) / (4 * coeffs.a)\n\ndef parabola_directrix(a, b, c):\n    \"\"\"\n    Computes the y-coordinate of the directrix for a parabola y = a*x^2 + b*x + c.\n\n    Parameters:\n      a (numeric), b (numeric), c (numeric)\n    Returns:\n      numeric y-coordinate (float or int) of the directrix.\n    Exceptions:\n      TypeError for non-numeric inputs; ValueError when a == 0 (not a parabola).\n    \"\"\"\n    coeffs = Coefficients(a, b, c)\n    Validator.validate_types(coeffs)\n    Validator.validate_a_nonzero(coeffs)\n    result = CalculationEngine.compute_directrix(coeffs)\n    return result"}
