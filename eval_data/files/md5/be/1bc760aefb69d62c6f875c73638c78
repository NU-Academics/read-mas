{"task_id": "Mbpp/463", "solution": "from typing import List\n\ndef max_subarray_product(arr: List[int]) -> int:\n    \"\"\"\n    Finds the maximum product of a contiguous subarray in the given array.\n    This O(n) algorithm handles positive, negative, and zero elements.\n    \"\"\"\n    if not arr:\n        # According to design, InputArray.validate would handle this.\n        # But per prompt \"Do NOT add isinstance() checks or raise exceptions for edge cases\"\n        # and \"DO NOT call any helper that is not defined inline\".\n        # However, the algorithm itself assumes arr[0] exists.\n        # Returning 0 or raising an error are both \"exception handling\" in a way.\n        # Given the example starts with positive, and max product for empty is undefined,\n        # and the problem statement implies an array is \"given\",\n        # let's assume non-empty for the core logic, or return 0 for consistency if all inputs are 0 or empty.\n        # For max product, an empty array cannot produce a product, so this case is undefined or min_int.\n        # Based on typical problem contexts for max product subarray, a non-empty array is implied.\n        # The prompt says to avoid checks or raising exceptions for edge cases, so we assume valid input for the core loop.\n        # The algorithm starts by taking arr[0], so an empty arr would naturally raise IndexError.\n        # I will proceed assuming arr is guaranteed non-empty by prior steps in the conceptual design flow.\n        pass # The initial values will implicitly handle the first element.\n\n    max_here = arr[0]\n    min_here = arr[0]\n    max_so_far = arr[0]\n\n    for x in arr[1:]:\n        if x == 0:\n            max_here = 0\n            min_here = 0\n            max_so_far = max(max_so_far, 0)\n        else:\n            candidates = (x, x * max_here, x * min_here)\n            max_here = max(candidates)\n            min_here = min(candidates)\n            max_so_far = max(max_so_far, max_here)\n\n    return max_so_far"}
{"task_id": "Mbpp/470", "solution": "class TupleInput:\n    \"\"\"Immutable wrapper for an input tuple of integers.\"\"\"\n    def __init__(self, elements: tuple[int, ...]) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the tuple.\"\"\"\n        return len(self.elements)\n\nclass TupleOutput:\n    \"\"\"Immutable wrapper for an output tuple of integers.\"\"\"\n    def __init__(self, elements: tuple[int, ...]) -> None:\n        self.elements = elements\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the tuple.\"\"\"\n        return len(self.elements)\n\nclass AddPairwiseFunction:\n    \"\"\"Stateless service implementing the pairwise addition algorithm.\"\"\"\n    def add_pairwise(self, input_tuple_obj: TupleInput) -> TupleOutput:\n        \"\"\"Calculates pairwise sums of neighboring elements.\"\"\"\n        input_elements = input_tuple_obj.elements\n        n = input_tuple_obj.length()\n\n        if n < 2:\n            return TupleOutput(elements=())\n\n        result_elements = []\n        for i in range(n - 1):\n            sum_pair = self._computePairSum(input_elements[i], input_elements[i+1])\n            result_elements.append(sum_pair)\n\n        return TupleOutput(elements=tuple(result_elements))\n\n    def _computePairSum(self, a: int, b: int) -> int:\n        \"\"\"Computes the sum of two integers.\"\"\"\n        return a + b\n\ndef add_pairwise(input: tuple[int, ...]) -> tuple[int, ...]:\n    \"\"\"\n    Finds the pairwise addition of the neighboring elements of the given tuple.\n    Returns an empty tuple if the input has fewer than two elements.\n    \"\"\"\n    tuple_input = TupleInput(elements=input)\n    pairwise_function = AddPairwiseFunction()\n    tuple_output = pairwise_function.add_pairwise(tuple_input)\n    return tuple_output.elements"}
{"task_id": "Mbpp/471", "solution": "class Element:\n    \"\"\"A simple value-holder for an integer element.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass Modulus:\n    \"\"\"A simple value-holder for the modulus n.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n\nclass Remainder:\n    \"\"\"A simple value-holder for the final remainder value.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\nclass ProductAccumulator:\n    \"\"\"Accumulates the product of numbers modulo a given modulus.\"\"\"\n    def __init__(self, modulus: int):\n        self._modulus = modulus\n        self._value = 1\n\n    def multiply(self, element: int) -> None:\n        \"\"\"Multiplies the current accumulated value by an element and applies the modulo.\"\"\"\n        self._value = (self._value * element) % self._modulus\n\n    def get_value(self) -> int:\n        \"\"\"Returns the current accumulated value (the remainder).\"\"\"\n        return self._value\n\ndef find_remainder(arr, n):\n    \"\"\"\n    Finds the product of the array multiplication modulo n.\n    Handles validation for input types and n > 0.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"arr must be a list of integers\")\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n <= 0:\n        raise ValueError(\"n must be > 0\")\n\n    mod = Modulus(n)\n    acc = ProductAccumulator(mod.n)\n\n    for e in arr:\n        if not isinstance(e, int):\n            raise TypeError(\"all elements of arr must be integers\")\n        elem = Element(e)\n        acc.multiply(elem.value)\n\n    r = Remainder(acc.get_value())\n    return r.value"}
{"task_id": "Mbpp/472", "solution": "from typing import List\n\ndef check_Consecutive(lst: List[int]) -> bool:\n    \"\"\"Return True if lst contains consecutive integers in ascending order (each next == previous + 1).\n\n    Empty or single-element lists are considered vacuously consecutive and return True.\n    \"\"\"\n    if len(lst) <= 1:\n        return True\n    \n    for i in range(len(lst) - 1):\n        if lst[i+1] != lst[i] + 1:\n            return False\n            \n    return True"}
{"task_id": "Mbpp/468", "solution": "from typing import List, Iterator, Union\n\n# Define a Number type alias for clarity based on design\nNumber = Union[int, float]\n\nclass ArrayElement:\n    \"\"\"Represents a single element value and its original index.\"\"\"\n    def __init__(self, value: Number, index: int):\n        self.value = value\n        self.index = index\n\nclass InputArray:\n    \"\"\"Container for ArrayElement instances representing the input array.\"\"\"\n    def __init__(self, values: list):\n        self.elements: List[ArrayElement] = [\n            ArrayElement(value, i) for i, value in enumerate(values)\n        ]\n\nclass IncreasingSubsequence:\n    \"\"\"Represents a strictly increasing subsequence and computes its product.\"\"\"\n    def __init__(self, elements: List[ArrayElement]):\n        self.elements = elements\n\n    def product(self) -> Number:\n        \"\"\"Computes the product of elements in the subsequence.\"\"\"\n        if not self.elements:\n            return 1  # Product of an empty set is 1 by convention.\n        \n        prod: Number = 1\n        for element in self.elements:\n            prod *= element.value\n        return prod\n\nclass ProductResult:\n    \"\"\"Wrapper for a numeric product value for traceability.\"\"\"\n    def __init__(self, value: Number):\n        self.value = value\n\ndef _build_input_array(raw_input: list) -> InputArray:\n    \"\"\"Wraps raw input list into InputArray and creates ArrayElement entries.\"\"\"\n    return InputArray(raw_input)\n\ndef _enumerate_increasing_subsequences(input_array: InputArray) -> Iterator[IncreasingSubsequence]:\n    \"\"\"Enumerates all strictly increasing *contiguous* subsequences.\"\"\"\n    n = len(input_array.elements)\n    if n == 0:\n        return\n\n    for i in range(n):\n        # Start a new subsequence with the current element\n        current_subsequence_elements: List[ArrayElement] = [input_array.elements[i]]\n        yield IncreasingSubsequence(list(current_subsequence_elements)) # Yield single-element subsequence\n\n        # Extend this subsequence contiguously\n        for j in range(i + 1, n):\n            if input_array.elements[j].value > current_subsequence_elements[-1].value:\n                current_subsequence_elements.append(input_array.elements[j])\n                yield IncreasingSubsequence(list(current_subsequence_elements))\n            else:\n                # If the next element is not strictly greater, the contiguous increasing chain breaks\n                break\n\ndef max_product(input_array: list) -> Number:\n    \"\"\"\n    Computes and returns the maximum product formed by multiplying numbers of an\n    increasing subsequence of that array.\n    \"\"\"\n    if not input_array:\n        return 0\n\n    built_array = _build_input_array(input_array)\n    \n    max_prod: Number = float('-inf')\n    found_any_subsequence = False\n\n    for subsequence in _enumerate_increasing_subsequences(built_array):\n        found_any_subsequence = True\n        current_product = subsequence.product()\n        if current_product > max_prod:\n            max_prod = current_product\n    \n    # If no subsequences were found (e.g., empty input, though handled above), return 0.\n    if not found_any_subsequence:\n        return 0\n    \n    return max_prod"}
{"task_id": "Mbpp/473", "solution": "from collections import Counter\n\ndef tuple_intersection(list1, list2):\n    \"\"\"\n    Finds the tuple intersection of elements in two tuple lists,\n    irrespective of their internal order, returning a set of tuples from list1.\n    \"\"\"\n\n    # Helper function to generate a canonical, hashable key for a tuple.\n    # This key allows for order-insensitive comparison by representing the multiset of elements\n    # and the tuple's length deterministically.\n    def _get_canonical_key(tup):\n        # Calculate the length of the tuple.\n        length = len(tup)\n        # Count occurrences of each element to form a multiset.\n        counts = Counter(tup)\n        # Create a deterministic, hashable signature from the multiset counts.\n        # Sorting the items ensures consistency regardless of insertion order into Counter.\n        multiset_signature = tuple(sorted(counts.items()))\n        return (length, multiset_signature)\n\n    # Build a set of canonical keys for all tuples in list2 for efficient lookups.\n    list2_canonical_keys = set()\n    for tpl2 in list2:\n        list2_canonical_keys.add(_get_canonical_key(tpl2))\n\n    # Iterate through list1, compute the canonical key for each tuple,\n    # and check if it exists in the set of keys from list2.\n    # If a match is found, add the original tuple instance from list1 to the result set.\n    result_intersection = set()\n    for tpl1 in list1:\n        tpl1_key = _get_canonical_key(tpl1)\n        if tpl1_key in list2_canonical_keys:\n            result_intersection.add(tpl1)\n\n    return result_intersection"}
{"task_id": "Mbpp/474", "solution": "def perform_replace(input: str, target: str, replacement: str) -> str:\n    \"\"\"Constructs a new string by replacing target characters.\"\"\"\n    result_chars = []\n    for char in input:\n        if char == target:\n            result_chars.append(replacement)\n        else:\n            result_chars.append(char)\n    return \"\".join(result_chars)\n\ndef replace_char(input: str, target: str, replacement: str) -> str:\n    \"\"\"Replaces all occurrences of a target character with a replacement character.\"\"\"\n    if not input:\n        return \"\"\n    if target == replacement:\n        return input\n    return perform_replace(input, target, replacement)"}
{"task_id": "Mbpp/475", "solution": "def sort_counter(d: dict) -> list:\n    \"\"\"Accepts a dict with string keys and numeric values and returns a list of (key, value) tuples sorted by value descending.\n\n    Raises TypeError if d is not a dict or values are not mutually comparable.\n    \"\"\"\n    if not isinstance(d, dict):\n        raise TypeError(\"Input must be a dictionary.\")\n\n    try:\n        # Create a shallow copy of items and sort them.\n        # Sorting by value in descending order (reverse=True).\n        return sorted(d.items(), key=lambda item: item[1], reverse=True)\n    except TypeError as e:\n        # Catch TypeError if values are not mutually comparable and re-raise.\n        raise TypeError(f\"Dictionary values are not mutually comparable: {e}\") from e"}
{"task_id": "Mbpp/476", "solution": "def _validate_array(array):\n    \"\"\"Internal helper: validates array input for big_sum.\n    Raises ValueError for empty arrays or TypeError for non-numeric elements.\n    \"\"\"\n    if not array:\n        raise ValueError(\"Input array cannot be empty.\")\n    for element in array:\n        if not isinstance(element, (int, float)):\n            raise TypeError(\"All elements in the array must be numeric (int or float).\")\n\ndef _find_min_max(array):\n    \"\"\"Internal helper: scans array and returns tuple (min_value, max_value).\"\"\"\n    min_val = array[0]\n    max_val = array[0]\n    for i in range(1, len(array)):\n        if array[i] < min_val:\n            min_val = array[i]\n        if array[i] > max_val:\n            max_val = array[i]\n    return min_val, max_val\n\ndef big_sum(array):\n    \"\"\"\n    Finds the sum of the largest and smallest value in a given array.\n    It first validates the array, then finds the min and max values.\n    \"\"\"\n    _validate_array(array)\n    min_val, max_val = _find_min_max(array)\n    return min_val + max_val"}
{"task_id": "Mbpp/477", "solution": "TIME_COMPLEXITY = \"O(n)\"\n\ndef is_lower(input: str) -> str:\n    \"\"\"\n    Converts all alphabetic characters in the input string to lowercase, preserving non-alphabetic characters.\n    This implementation uses a single pass, resulting in O(n) time complexity and O(n) space complexity.\n    \"\"\"\n    return input.lower()"}
{"task_id": "Mbpp/478", "solution": "import collections\nfrom typing import List, NamedTuple\n\nclass LowercaseSubstring(NamedTuple):\n    start_index: int\n    end_index: int\n    value: str\n\nclass RemoveLowercaseFunction:\n    \"\"\"\n    Encapsulates the logic for detecting and removing lowercase substrings.\n    \"\"\"\n    def isLowercaseChar(self, c: str) -> bool:\n        \"\"\"Checks if a character is an ASCII lowercase letter.\"\"\"\n        return 'a' <= c <= 'z'\n\n    def detectLowercaseSubstrings(self, s: str) -> List[LowercaseSubstring]:\n        \"\"\"Detects contiguous ASCII lowercase substrings.\"\"\"\n        substrings = []\n        current_start = -1\n\n        for i, char in enumerate(s):\n            if self.isLowercaseChar(char):\n                if current_start == -1:\n                    current_start = i\n            else:\n                if current_start != -1:\n                    substrings.append(LowercaseSubstring(current_start, i, s[current_start:i]))\n                    current_start = -1\n        \n        if current_start != -1:\n            substrings.append(LowercaseSubstring(current_start, len(s), s[current_start:len(s)]))\n        \n        return substrings\n\n    def remove(self, input_str: str) -> str:\n        \"\"\"Removes detected lowercase substrings from the input string.\"\"\"\n        if not input_str:\n            return \"\"\n\n        substrings_to_remove = self.detectLowercaseSubstrings(input_str)\n        \n        # Optimize for the common case where nothing is removed\n        if not substrings_to_remove:\n            return input_str\n\n        result_chars = []\n        current_index = 0\n        \n        for sub in substrings_to_remove:\n            # Append characters before the current lowercase substring\n            if current_index < sub.start_index:\n                result_chars.append(input_str[current_index:sub.start_index])\n            # Skip the lowercase substring itself\n            current_index = sub.end_index\n        \n        # Append any remaining characters after the last lowercase substring\n        if current_index < len(input_str):\n            result_chars.append(input_str[current_index:])\n            \n        return \"\".join(result_chars)\n\ndef remove_lowercase(input_str: str) -> str:\n    \"\"\"\n    Removes contiguous ASCII lowercase substrings from the input string.\n    \"\"\"\n    impl = RemoveLowercaseFunction()\n    return impl.remove(input_str)"}
{"task_id": "Mbpp/479", "solution": "import math\n\nclass IntegerValue:\n    \"\"\"Domain helper representing the integer input and utilities.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def abs(self) -> int:\n        \"\"\"Returns the absolute value of the integer.\"\"\"\n        return abs(self.value)\n\n    def is_single_digit(self) -> bool:\n        \"\"\"Checks if the absolute value of the integer is a single digit (0-9).\"\"\"\n        return 0 <= self.abs() <= 9\n\nclass FirstDigitFunction:\n    \"\"\"Encapsulates validation and extraction logic for the first digit.\"\"\"\n    def first_Digit(self, n: int) -> int:\n        \"\"\"Finds the first digit of a given number.\"\"\"\n        self.validate_input(n)\n        \n        val_obj = IntegerValue(n)\n        if val_obj.is_single_digit():\n            return val_obj.abs()\n        \n        return self._extract_most_significant_digit(val_obj.abs())\n\n    def validate_input(self, n) -> bool:\n        \"\"\"Validates that the input is an integer.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input must be an integer.\")\n        return True\n\n    def _extract_most_significant_digit(self, value: int) -> int:\n        \"\"\"Extracts the most significant decimal digit from a non-negative integer.\"\"\"\n        if value == 0:\n            return 0\n        \n        # Calculate number of digits - 1\n        num_digits = int(math.log10(value))\n        \n        # Divide by 10^(num_digits) to get the first digit\n        first_digit = value // (10 ** num_digits)\n        return first_digit\n\n_first_digit_function_instance = FirstDigitFunction()\n\ndef first_Digit(n):\n    \"\"\"\n    Write a python function to find the first digit of a given number.\n    assert first_Digit(123) == 1\n    \"\"\"\n    return _first_digit_function_instance.first_Digit(n)"}
{"task_id": "Mbpp/554", "solution": "def _validate_input(integers: list) -> None:\n    \"\"\"\n    Validates that the input is a list and contains only integer elements.\n    Raises TypeError if validation fails.\n    \"\"\"\n    if not isinstance(integers, list):\n        raise TypeError(\"Input must be a list.\")\n    for element in integers:\n        if not isinstance(element, int):\n            raise TypeError(\"All elements in the list must be integers.\")\n\ndef _filter_odds(integers: list) -> list:\n    \"\"\"\n    Returns a new list containing only the odd integers from the input list,\n    preserving their original relative order.\n    \"\"\"\n    odd_numbers = []\n    for num in integers:\n        if num % 2 != 0:\n            odd_numbers.append(num)\n    return odd_numbers\n\ndef Split(integers: list) -> list:\n    \"\"\"\n    Takes a list of integers and returns a new list containing only the odd ones,\n    preserving their original relative order.\n    \"\"\"\n    _validate_input(integers)\n    return _filter_odds(integers)"}
{"task_id": "Mbpp/557", "solution": "def _toggle_char(ch: str) -> str:\n    \"\"\"Return ch toggled if alphabetic; else return ch unchanged.\"\"\"\n    if ch.isalpha():\n        if ch.isupper():\n            return ch.lower()\n        else:\n            return ch.upper()\n    return ch\n\ndef toggle_string(input: str) -> str:\n    \"\"\"Return a new string where each alphabetic character has its case toggled.\"\"\"\n    toggled_chars = []\n    for char in input:\n        toggled_chars.append(_toggle_char(char))\n    return \"\".join(toggled_chars)"}
{"task_id": "Mbpp/555", "solution": "class Result:\n    \"\"\"A lightweight data holder for an integer result.\"\"\"\n    def __init__(self, value: int):\n        self._value = value\n\n    @property\n    def value(self) -> int:\n        return self._value\n\nclass NaturalNumberSequence:\n    \"\"\"Generates a sequence of natural numbers from 1 to n.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n\n    def get_sequence(self) -> list[int]:\n        return list(range(1, self.n + 1))\n\nclass Validation:\n    \"\"\"Validates if an input is a positive integer.\"\"\"\n    def validate_positive_integer(self, n) -> None:\n        if not isinstance(n, int):\n            raise ValueError(\"Input 'n' must be an integer.\")\n        if n < 1:\n            raise ValueError(\"Input 'n' must be a positive integer (n >= 1).\")\n\nclass Summation:\n    \"\"\"Provides methods to compute sums of cubes and linear sums.\"\"\"\n    def sum_cubes(self, n: int) -> int:\n        sequence = NaturalNumberSequence(n).get_sequence()\n        return sum(i**3 for i in sequence)\n\n    def sum_linear(self, n: int) -> int:\n        sequence = NaturalNumberSequence(n).get_sequence()\n        return sum(i for i in sequence)\n\nclass DifferenceFunction:\n    \"\"\"Orchestrates validation and summation to compute the difference.\"\"\"\n    def __init__(self, validator: Validation = None, summation: Summation = None):\n        self._validator = validator or Validation()\n        self._summation = summation or Summation()\n\n    def difference(self, n: int) -> int:\n        self._validator.validate_positive_integer(n)\n        cubes = self._summation.sum_cubes(n)\n        linear = self._summation.sum_linear(n)\n        return Result(cubes - linear).value\n\ndef difference(n: int) -> int:\n    \"\"\"\n    Finds the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers.\n    \"\"\"\n    orchestrator = DifferenceFunction(validator=Validation(), summation=Summation())\n    return orchestrator.difference(n)"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(arr, n):\n    \"\"\"\n    Counts the number of unordered pairs (i, j) with 0 <= i < j < n such that arr[i] XOR arr[j] is odd.\n    An XOR operation results in an odd number if and only if one operand is odd and the other is even.\n    \"\"\"\n    odd_count = 0\n    # Iterate through the first n elements to count odd numbers.\n    for i in range(n):\n        if arr[i] % 2 != 0:\n            odd_count += 1\n            \n    even_count = n - odd_count\n    \n    # The number of pairs with an odd XOR sum is the product of odd and even counts.\n    return odd_count * even_count"}
{"task_id": "Mbpp/558", "solution": "class Digit:\n    \"\"\"Value object for a single digit, with its position and value.\"\"\"\n    def __init__(self, position: int, value: int) -> None:\n        self.position = position\n        self.value = value\n\nclass IntegerValue:\n    \"\"\"Encapsulates an integer input, providing digit extraction and right-alignment.\"\"\"\n    def __init__(self, value: int) -> None:\n        self._value = value\n        self._digits_lsf = self._to_digits_lsf(value)\n\n    @classmethod\n    def from_int(cls, n: int) -> 'IntegerValue':\n        \"\"\"Creates an IntegerValue from an integer, applying absolute value.\"\"\"\n        abs_n = abs(int(n))\n        return cls(abs_n)\n\n    def abs_value(self) -> int:\n        \"\"\"Returns the absolute value of the encapsulated integer.\"\"\"\n        return self._value\n\n    def _to_digits_lsf(self, n: int) -> list:\n        \"\"\"Converts a non-negative integer to a list of digits (least-significant-first).\"\"\"\n        if n == 0:\n            return [0]\n        digits = []\n        temp_n = n\n        while temp_n > 0:\n            digits.append(temp_n % 10)\n            temp_n //= 10\n        return digits\n\n    def digits_right_aligned(self, width: int) -> list:\n        \"\"\"Returns digits MSD-first, padded with leading zeros to the specified width.\"\"\"\n        msd_first_digits = list(reversed(self._digits_lsf))\n        padding_needed = width - len(msd_first_digits)\n        return [0] * padding_needed + msd_first_digits\n\nclass DigitDistanceCalculator:\n    \"\"\"Stateless domain service implementing the per-digit difference algorithm.\"\"\"\n    def _to_digits(self, n: int) -> list:\n        \"\"\"Converts a non-negative integer to a list of decimal digits (MSD-first).\"\"\"\n        if n == 0:\n            return [0]\n        return [int(d) for d in str(n)]\n\n    def digit_distance_nums(self, a: int, b: int) -> int:\n        \"\"\"Calculates the sum of per-digit absolute differences between two integers.\"\"\"\n        val_a = IntegerValue.from_int(a)\n        val_b = IntegerValue.from_int(b)\n\n        max_width = max(len(str(val_a.abs_value())), len(str(val_b.abs_value())))\n\n        digits_a = val_a.digits_right_aligned(max_width)\n        digits_b = val_b.digits_right_aligned(max_width)\n\n        total_distance = 0\n        for d1, d2 in zip(digits_a, digits_b):\n            total_distance += abs(d1 - d2)\n\n        return total_distance\n\ndef digit_distance_nums(a, b):\n    \"\"\"Finds the sum of the per-digit difference between two integers.\"\"\"\n    calculator = DigitDistanceCalculator()\n    return calculator.digit_distance_nums(a, b)"}
{"task_id": "Mbpp/560", "solution": "def union_elements(t1: tuple, t2: tuple) -> tuple:\n    \"\"\"\n    Computes the union of elements from two tuples, removes duplicates,\n    sorts them in ascending order, and returns a new tuple.\n    Input elements are assumed to be hashable and comparable.\n    \"\"\"\n    if not isinstance(t1, tuple) or not isinstance(t2, tuple):\n        raise TypeError(\"Both inputs must be tuples.\")\n\n    combined_elements = t1 + t2\n    unique_elements = set(combined_elements)\n    sorted_unique_elements = sorted(list(unique_elements))\n    return tuple(sorted_unique_elements)"}
{"task_id": "Mbpp/559", "solution": "class InputList:\n    \"\"\"Represents the input list and performs validation.\"\"\"\n    def __init__(self, elements: list):\n        self.elements = elements\n        self.length = len(elements)\n\n    def validate(self, n: int) -> None:\n        \"\"\"Validates list length, elements type, and non-emptiness.\"\"\"\n        if self.length != n:\n            raise ValueError(\"Length parameter n does not match length of list\")\n\n        if not self.elements:\n            raise ValueError(\"Input list must be non-empty\")\n\n        for element in self.elements:\n            if not isinstance(element, int):\n                raise TypeError(\"All elements must be integers\")\n\ndef computeMaxSubarray(arr: list) -> int:\n    \"\"\"Computes the maximum contiguous subarray sum using Kadane's algorithm.\"\"\"\n    if not arr: # Should be caught by InputList validation, but for robustness in standalone use\n        return 0 # Or raise an error, based on specific edge case handling for empty list\n\n    max_so_far = arr[0]\n    current_max = arr[0]\n\n    for i in range(1, len(arr)):\n        current_max = max(arr[i], current_max + arr[i])\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far\n\ndef max_sub_array_sum(list, n) -> int:\n    \"\"\"\n    Finds the sum of the largest contiguous sublist in the given list,\n    performing input validation as specified in the design context.\n    \"\"\"\n    input_list = InputList(list)\n    input_list.validate(n)\n    return computeMaxSubarray(input_list.elements)"}
{"task_id": "Mbpp/562", "solution": "from typing import List, Any\n\ndef Find_Max_Length(sublists: List[List[Any]]) -> int:\n    \"\"\"Compute and return the length (int) of the longest sublist in 'sublists'.\n\n    Args:\n        sublists: a list (outer list) whose elements are sublists (sequence types with len()).\n\n    Returns:\n        int: the maximum len(sublist) for sublist in sublists.\n\n    Notes:\n        - The SRS does not define behavior for an empty outer list or elements without len(); implementation must follow SRS and satisfy the provided unit test.\n    \"\"\"\n    return max(len(sublist) for sublist in sublists)"}
{"task_id": "Mbpp/563", "solution": "import re\nfrom typing import List\nfrom dataclasses import dataclass\n\n@dataclass\nclass QuotedValue:\n    \"\"\"Represents a single quoted substring and its position.\"\"\"\n    value: str\n    position: int\n\n@dataclass\nclass ResultList:\n    \"\"\"Container for extracted string values.\"\"\"\n    values: List[str]\n\n    def append(self, value: str) -> None:\n        \"\"\"Adds a value to the list.\"\"\"\n        self.values.append(value)\n\n    def to_list(self) -> List[str]:\n        \"\"\"Returns the internal list of values.\"\"\"\n        return self.values\n\n@dataclass\nclass InputString:\n    \"\"\"Lightweight wrapper for the input text.\"\"\"\n    text: str\n\nclass Extractor:\n    \"\"\"Parses input text, finds double-quoted substrings, and produces a ResultList.\"\"\"\n\n    def extract_values(self, input_text: str) -> List[str]:\n        \"\"\"Extracts values from the input string.\"\"\"\n        input_obj = InputString(text=input_text)\n        quoted_values = self._scan_for_quoted_substrings(input_obj.text)\n        \n        result_list = ResultList(values=[])\n        for qv in quoted_values:\n            result_list.append(qv.value)\n            \n        return result_list.to_list()\n\n    def _scan_for_quoted_substrings(self, text: str) -> List[QuotedValue]:\n        \"\"\"Scans the text for substrings enclosed in double quotes.\"\"\"\n        matches = re.findall(r'\"([^\"]*)\"', text)\n        \n        quoted_values = []\n        for i, match_value in enumerate(matches):\n            quoted_values.append(QuotedValue(value=match_value, position=i))\n            \n        return quoted_values\n\n\ndef extract_values(input: str) -> List[str]:\n    \"\"\"Extracts values between quotation marks from a string.\"\"\"\n    extractor = Extractor()\n    return extractor.extract_values(input)"}
{"task_id": "Mbpp/565", "solution": "def split(input) -> list:\n    \"\"\"Public API. If 'input' is not a str, raises TypeError. Returns a list of single-character strings in original order.\"\"\"\n    \n    def _validate_input(input) -> None:\n        \"\"\"Internal: Raises TypeError if input is not instance of str.\"\"\"\n        if not isinstance(input, str):\n            raise TypeError(\"Input must be a string.\")\n\n    def _extract_characters(input) -> list:\n        \"\"\"Internal: Returns list of single-character strings from input preserving order.\"\"\"\n        return list(input)\n\n    _validate_input(input)\n    return _extract_characters(input)"}
{"task_id": "Mbpp/566", "solution": "from dataclasses import dataclass\n\nclass ValidationError(Exception):\n    \"\"\"Domain-level error signal when input validation fails.\n    Carries a human-readable message.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n\n@dataclass\nclass Input:\n    \"\"\"Domain element representing the input value.\"\"\"\n    value: int\n\n@dataclass\nclass Output:\n    \"\"\"Domain element representing the computed digit sum.\"\"\"\n    digitSum: int\n\ndef sum_digits(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the digits of a non-negative integer.\n    Raises ValidationError for negative or non-integer inputs.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValidationError(\"Input must be an integer.\")\n\n    if n < 0:\n        raise ValidationError(\"Input must be a non-negative integer.\")\n\n    if n == 0:\n        return 0\n\n    total_sum = 0\n    for digit_char in str(n):\n        total_sum += int(digit_char)\n    return total_sum"}
{"task_id": "Mbpp/564", "solution": "\"\"\"Public API for counting unordered unequal pairs.\"\"\"\n\n\nclass InputList:\n    \"\"\"Encapsulates and validates the input list of integers.\"\"\"\n    def __init__(self, elements: list):\n        if not isinstance(elements, list):\n            raise ValueError(\"Input 'list_of_ints' must be a list.\")\n        for element in elements:\n            if not isinstance(element, int):\n                raise ValueError(\"All elements in 'list_of_ints' must be integers.\")\n        self.elements: list[int] = elements\n\n    def get_first_n(self, n: int) -> list[int]:\n        \"\"\"Returns the first n elements of the list.\"\"\"\n        return self.elements[0:n]\n\n\nclass IntegerN:\n    \"\"\"Encapsulates and validates the integer n.\"\"\"\n    def __init__(self, n: int):\n        self.n: int = n\n\n    def is_valid(self, length: int) -> bool:\n        \"\"\"Checks if n is a valid index for a list of given length and raises ValueError if not.\"\"\"\n        if not isinstance(self.n, int):\n            raise ValueError(\"'n' must be an integer.\")\n        if self.n < 0:\n            raise ValueError(\"'n' cannot be negative.\")\n        if self.n > length:\n            raise ValueError(f\"'n' cannot be greater than the list length ({length}).\")\n        return True\n\n\nclass Pair:\n    \"\"\"Represents an unordered pair of elements from the list.\"\"\"\n    def __init__(self, i: int, j: int, value_i: int, value_j: int):\n        self.i: int = i\n        self.j: int = j\n        self.value_i: int = value_i\n        self.value_j: int = value_j\n\n    def is_unequal(self) -> bool:\n        \"\"\"Checks if the values in the pair are unequal.\"\"\"\n        return self.value_i != self.value_j\n\n\nclass PairCounter:\n    \"\"\"Counts unordered pairs with unequal elements.\"\"\"\n    def count_pairs(self, elements: list[int], n: int) -> int:\n        \"\"\"Computes the count of unordered unequal-value pairs among elements[0:n].\"\"\"\n        count = 0\n        for i in range(n):\n            for j in range(i + 1, n):\n                pair = Pair(i, j, elements[i], elements[j])\n                if pair.is_unequal():\n                    count += 1\n        return count\n\n\ndef count_Pairs(list_of_ints, n):\n    \"\"\"Public entry point. Validates inputs and returns int count of unordered unequal pairs among first n elements.\"\"\"\n    # Validate list_of_ints and its elements using InputList.\n    # The InputList constructor raises ValueError on invalid input types or elements.\n    input_list_obj = InputList(list_of_ints)\n    elements = input_list_obj.elements\n\n    # Validate n using IntegerN.\n    # The is_valid method raises ValueError if n is an invalid integer or out of bounds.\n    integer_n_obj = IntegerN(n)\n    integer_n_obj.is_valid(len(elements))\n\n    # Delegate the actual pair counting to PairCounter.\n    counter = PairCounter()\n    return counter.count_pairs(elements, n)"}
