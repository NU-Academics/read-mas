{"task_id": "Mbpp/273", "solution": "import numbers\n\nclass LengthMismatchError(Exception):\n    \"\"\"Exception raised when input tuples have different lengths.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\n\n    def __str__(self) -> str:\n        return self.message\n\ndef validate_elements_numeric(a: tuple, b: tuple) -> None:\n    \"\"\"Ensures all elements in both tuples are numeric.\"\"\"\n    for i, element in enumerate(a):\n        if not isinstance(element, numbers.Number):\n            raise TypeError(f\"Element at index {i} in the first tuple is not numeric: {element} (type: {type(element).__name__})\")\n    for i, element in enumerate(b):\n        if not isinstance(element, numbers.Number):\n            raise TypeError(f\"Element at index {i} in the second tuple is not numeric: {element} (type: {type(element).__name__})\")\n\ndef validate_lengths(a: tuple, b: tuple) -> None:\n    \"\"\"Compares lengths of two tuples and raises LengthMismatchError on mismatch.\"\"\"\n    if len(a) != len(b):\n        raise LengthMismatchError(f\"Input tuples have different lengths: len(a)={len(a)} len(b)={len(b)}\")\n\ndef substract_elements(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Subtracts elements of the first tuple by elements of the second tuple with the same index.\n    Performs validation for tuple types, numeric elements, and equal lengths.\n    \"\"\"\n    if not isinstance(a, tuple):\n        raise TypeError(f\"First input must be a tuple, but got {type(a).__name__}\")\n    if not isinstance(b, tuple):\n        raise TypeError(f\"Second input must be a tuple, but got {type(b).__name__}\")\n\n    validate_elements_numeric(a, b)\n    validate_lengths(a, b)\n\n    result_list = [a[i] - b[i] for i in range(len(a))]\n    return tuple(result_list)"}
{"task_id": "Mbpp/274", "solution": "class ComputationEngine:\n    \"\"\"Computes the sum of even-indexed binomial coefficients.\"\"\"\n    def sum_even_indices(self, n: int) -> int:\n        \"\"\"Calculates the sum of C(n, k) for even k using the identity 2**(n-1).\"\"\"\n        return 2**(n - 1)\n\ndef even_binomial_Coeff_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of C(n, k) for all even k (0 <= k <= n).\n    Validates input n and uses a ComputationEngine to find the sum.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input n must be a positive integer (n >= 1).\")\n\n    engine = ComputationEngine()\n    result = engine.sum_even_indices(n)\n    return result"}
{"task_id": "Mbpp/276", "solution": "import math\n\ndef volume_cylinder(radius, height):\n    \"\"\"\n    Calculates the volume of a cylinder given its radius and height.\n    The volume is computed using the formula V = \u03c0 * radius^2 * height.\n    \"\"\"\n    # Ensure inputs are treated as floats for calculation\n    r = float(radius)\n    h = float(height)\n    volume = math.pi * (r ** 2) * h\n    return volume"}
{"task_id": "Mbpp/277", "solution": "from typing import Mapping, Dict, Any\n\ndef dict_filter(input_dict: Mapping[Any, Any], n: int) -> Dict[Any, Any]:\n    \"\"\"Filters a dictionary to include only entries with values greater than or equal to n.\"\"\"\n    filtered_dict: Dict[Any, Any] = {}\n    for key, value in input_dict.items():\n        if value >= n:\n            filtered_dict[key] = value\n    return filtered_dict"}
{"task_id": "Mbpp/281", "solution": "def all_unique(lst):\n    \"\"\"\n    Determine whether all elements in lst are unique using pairwise comparisons.\n    The input list is not modified, and an empty list is considered unique.\n    \"\"\"\n    n = len(lst)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if lst[i] == lst[j]:\n                return False\n    return True"}
{"task_id": "Mbpp/279", "solution": "class InvalidInputException(Exception):\n    \"\"\"Exception raised for invalid input to decagonal number calculations.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\n\nclass InputValidator:\n    \"\"\"Validates input for decagonal number calculations.\"\"\"\n    def isPositiveInteger(self, value) -> bool:\n        \"\"\"Checks if the given value is a positive integer.\"\"\"\n        return isinstance(value, int) and value >= 1\n\n    def assertPositiveInteger(self, value) -> None:\n        \"\"\"Asserts that the value is a positive integer, raising an exception if not.\"\"\"\n        if not self.isPositiveInteger(value):\n            raise InvalidInputException(\"Input 'n' must be a positive integer (n >= 1).\")\n\nclass DecagonalNumber:\n    \"\"\"Data holder for a decagonal number, storing n and its calculated value.\"\"\"\n    def __init__(self, n: int, value: int):\n        self.n = n\n        self.value = value\n\nclass DecagonalNumberCalculator:\n    \"\"\"Calculates decagonal numbers after validating input.\"\"\"\n    def __init__(self):\n        self._validator = InputValidator()\n\n    def _applyFormula(self, n: int) -> int:\n        \"\"\"Applies the decagonal number formula: 4*n*n - 3*n.\"\"\"\n        return 4 * n * n - 3 * n\n\n    def calculate(self, n: int) -> int:\n        \"\"\"Validates input and computes the nth decagonal number.\"\"\"\n        self._validator.assertPositiveInteger(n)\n        calculated_value = self._applyFormula(n)\n        return calculated_value\n\ndef is_num_decagonal(n) -> int:\n    \"\"\"\n    Calculates the nth decagonal number.\n    Input n must be a positive integer (n >= 1).\n    \"\"\"\n    calculator = DecagonalNumberCalculator()\n    return calculator.calculate(n)"}
{"task_id": "Mbpp/280", "solution": "def sequential_search(array, element):\n    \"\"\"\n    Search array for element using language-standard equality operator.\n\n    Returns (found: bool, index: int) where index is 0-based first occurrence or -1 if not found.\n    \"\"\"\n    for i, item in enumerate(array):\n        if item == element:\n            return (True, i)\n    return (False, -1)"}
{"task_id": "Mbpp/278", "solution": "def count_first_elements(input_tuple: tuple) -> int:\n    # Validate that the input is a tuple as per design requirements.\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"input_tuple must be a tuple\")\n\n    count = 0\n    for element in input_tuple:\n        # Stop and return the count if the current element is a tuple.\n        if isinstance(element, tuple):\n            return count\n        count += 1\n    # If no top-level tuple is found, return the total length of the input tuple.\n    return count"}
{"task_id": "Mbpp/282", "solution": "from typing import List, Union, TypeAlias\n\nNumber: TypeAlias = Union[int, float]\nNumericList: TypeAlias = List[Number]\nResultList: TypeAlias = List[Number]\n\ndef sub_list(a: NumericList, b: NumericList) -> ResultList:\n    \"\"\"Compute element-wise subtraction: result[i] = a[i] - b[i].\n    Raises ValueError if input lists have unequal length, otherwise returns a new list of differences.\n    \"\"\"\n    if len(a) != len(b):\n        raise ValueError('input lists must have equal length')\n    \n    result: ResultList = []\n    for i in range(len(a)):\n        result.append(a[i] - b[i])\n        \n    return result"}
