{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    if not l:\n        return []\n\n    indices_to_sort = [i for i in range(len(l)) if i % 3 == 0]\n    elements_to_sort = [l[i] for i in indices_to_sort]\n    sorted_elements = sorted(elements_to_sort)\n\n    result = list(l) # Create a shallow copy of the list\n    \n    for i, original_index in enumerate(indices_to_sort):\n        result[original_index] = sorted_elements[i]\n        \n    return result"}
{"task_id": "HumanEval/36", "solution": "from __future__ import annotations\n\nclass DigitCounter:\n    \"\"\"Utility to count occurrences of digit 7 in an integer.\"\"\"\n    @staticmethod\n    def count_digit7(number: int) -> int:\n        return str(number).count('7')\n\n\nclass Number:\n    \"\"\"Represents an integer with divisibility flags and digit count.\"\"\"\n    def __init__(self, value: int):\n        self.value: int = value\n        self.div_by_11: bool = (value % 11 == 0)\n        self.div_by_13: bool = (value % 13 == 0)\n        self.digit7_count: int = 0\n\n    def evaluate(self, counter: DigitCounter) -> None:\n        if self.div_by_11 or self.div_by_13:\n            self.digit7_count = counter.count_digit7(self.value)\n\n\nclass Result:\n    \"\"\"Aggregates digit7 counts from a list of Number objects.\"\"\"\n    def __init__(self):\n        self.total_count: int = 0\n\n    def add(self, number: Number) -> None:\n        self.total_count += number.digit7_count\n\n    def get_total(self) -> int:\n        return self.total_count\n\n\ndef fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    counter = DigitCounter()\n    result = Result()\n\n    for i in range(1, n):\n        num = Number(i)\n        num.evaluate(counter)\n        result.add(num)\n\n    return result.get_total()"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # Split string to groups of length 3, same as encoding.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # Reverse the cyclic shift: move the last character to the front for groups of 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/32", "solution": "def find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    n = len(xs)\n\n    # Validate inputs based on design context: even number of coefficients and non-zero leading coefficient.\n    if n % 2 != 0:\n        raise ValueError(\"Number of coefficients must be even.\")\n    if n == 0 or xs[n - 1] == 0:\n        raise ValueError(\"Leading coefficient cannot be zero.\")\n\n    # Handle the linear case (n=2 coefficients) directly.\n    if n == 2:\n        # For f(x) = c0 + c1*x = 0, the root is x = -c0 / c1.\n        return -float(xs[0]) / xs[1]\n\n    # For higher-degree odd polynomials, use a bisection method to find a root.\n    # An odd-degree polynomial is guaranteed to have at least one real root.\n    # We choose a sufficiently large initial interval for the search.\n    low, high = -1000.0, 1000.0\n    \n    # Check if the root happens to be exactly at the initial bounds (rare but good for robustness).\n    tolerance = 1e-7\n    if abs(poly(xs, low)) < tolerance:\n        return low\n    if abs(poly(xs, high)) < tolerance:\n        return high\n\n    # Perform bisection for a fixed number of iterations to achieve desired precision.\n    for _ in range(100): # 100 iterations provide high precision for typical float ranges.\n        mid = (low + high) / 2.0\n        val_mid = poly(xs, mid)\n\n        if abs(val_mid) < tolerance: # Found a root within the specified tolerance.\n            return mid\n\n        # Narrow down the interval based on the sign of poly(mid).\n        if poly(xs, low) * val_mid < 0:\n            high = mid\n        else:\n            low = mid\n            \n    # After iterations, 'low' and 'high' will be very close to a root; return their average.\n    return (low + high) / 2.0"}
{"task_id": "HumanEval/34", "solution": "def unique(l: list) -> list:\n    \"\"\"Return sorted unique elements in a list\n    >>> unique([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [0, 2, 3, 5, 9, 123]\n    \"\"\"\n    unique_elements = set(l)\n    return sorted(unique_elements)"}
{"task_id": "HumanEval/39", "solution": "def _is_prime(num: int) -> bool:\n    \"\"\"Return True if num is a prime number, False otherwise.\"\"\"\n    if num <= 1:\n        return False\n    if num <= 3:\n        return True\n    if num % 2 == 0 or num % 3 == 0:\n        return False\n    i = 5\n    while i * i <= num:\n        if num % i == 0 or num % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    a, b = 1, 1\n    count = 0\n\n    while True:\n        if _is_prime(a):\n            count += 1\n            if count == n:\n                return a\n        a, b = b, a + b"}
{"task_id": "HumanEval/42", "solution": "def incr_list(l: list):\n    \"\"\"Return list with elements incremented by 1.\n    >>> incr_list([1, 2, 3])\n    [2, 3, 4]\n    >>> incr_list([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [6, 4, 6, 3, 4, 4, 10, 1, 124]\n    \"\"\"\n    return [x + 1 for x in l]"}
{"task_id": "HumanEval/40", "solution": "import collections\n\ndef triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    if len(l) < 3:\n        return False\n\n    l.sort()  # Sort the list to use the two-pointer approach\n\n    n = len(l)\n    for i in range(n - 2):\n        # Optimization: if l[i] is positive, sum with two other positives cannot be zero\n        # Unless there are zeros and negative numbers after it, but if all remaining are positive.\n        # This optimization is mainly for finding unique triplets, not just existence.\n        # For simple existence, we just proceed.\n        \n        # Initialize two pointers\n        left = i + 1\n        right = n - 1\n\n        while left < right:\n            current_sum = l[i] + l[left] + l[right]\n\n            if current_sum == 0:\n                return True  # Found a triple that sums to zero\n            elif current_sum < 0:\n                left += 1  # Need a larger sum, move left pointer right\n            else:\n                right -= 1 # Need a smaller sum, move right pointer left\n    \n    return False # No such triple found"}
{"task_id": "HumanEval/41", "solution": "def car_race_collision(n: int):\n    \"\"\"\n    Calculates the number of collisions between two sets of n cars.\n    Each of the n cars moving left collides with each of the n cars moving right.\n    \"\"\"\n    return n * n"}
{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    if len(l) < 2:\n        return False\n\n    seen_numbers = set()\n    for num in l:\n        complement = -num\n        if complement in seen_numbers:\n            return True\n        seen_numbers.add(num)\n    return False"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    if x == 0:\n        return \"0\"\n\n    res = \"\"\n    current_x = x\n    while current_x > 0:\n        remainder = current_x % base\n        res = str(remainder) + res\n        current_x = current_x // base\n    return res"}
{"task_id": "HumanEval/45", "solution": "def triangle_area(a, h):\n    \"\"\"Given length of a side and high return area for a triangle.\n    >>> triangle_area(5, 3)\n    7.5\n    \"\"\"\n    return 0.5 * a * h"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"Computes the n-th element of the Fib4 number sequence iteratively.\"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 0\n\n    # Initialize with the base values for fib4(0), fib4(1), fib4(2), fib4(3)\n    # The variable 'd' will hold the current fib4(i) value in the loop\n    # a = fib4(i-4), b = fib4(i-3), c = fib4(i-2), d = fib4(i-1)\n    a, b, c, d = 0, 0, 2, 0\n\n    for _ in range(4, n + 1):\n        # Calculate the next Fib4 number\n        next_fib4 = a + b + c + d\n        # Shift the window: a becomes b, b becomes c, c becomes d, d becomes next_fib4\n        a, b, c, d = b, c, d, next_fib4\n        \n    return d"}
{"task_id": "HumanEval/48", "solution": "def is_palindrome(text: str):\n    \"\"\"\n    Checks if given string is a palindrome\n    >>> is_palindrome('')\n    True\n    >>> is_palindrome('aba')\n    True\n    >>> is_palindrome('aaaaa')\n    True\n    >>> is_palindrome('zbcd')\n    False\n    \"\"\"\n    return text == text[::-1]"}
{"task_id": "HumanEval/47", "solution": "\ndef median(l: list):\n    \"\"\"Return median of elements in the list l.\n    \"\"\"\n    n = len(l)\n    s = sorted(l)\n    if n % 2 == 1:\n        return s[n // 2]\n    else:\n        return (s[n // 2 - 1] + s[n // 2]) / 2"}
{"task_id": "HumanEval/49", "solution": "def modp(n: int, p: int):\n    \"\"\"Return 2^n modulo p (be aware of numerics).\"\"\"\n\n    class ModularExponentiationService:\n        \"\"\"Service to compute modular exponentiation, as per design.\"\"\"\n        def __init__(self, n_val: int, p_val: int):\n            self.n = n_val\n            self.p = p_val\n\n        def compute(self) -> int:\n            \"\"\"Uses Python's efficient built-in pow function.\"\"\"\n            return pow(2, self.n, self.p)\n\n    class Result:\n        \"\"\"Data holder for the computation result, as per design.\"\"\"\n        def __init__(self, value: int):\n            self.value = value\n\n    # Input validation and exception handling (e.g., InputValidator) are omitted as per explicit requirements.\n\n    service = ModularExponentiationService(n, p)\n    computed_value = service.compute()\n    \n    result_obj = Result(computed_value)\n    return result_obj.value"}
{"task_id": "HumanEval/50", "solution": "def decode_shift(s: str):\n    \"\"\"\n    takes as input string encoded with encode_shift function. Returns decoded string.\n    \"\"\"\n    return \"\".join([chr(((ord(ch) - 5 - ord(\"a\")) % 26) + ord(\"a\")) for ch in s])"}
{"task_id": "HumanEval/52", "solution": "def below_threshold(l: list, t: int):\n    \"\"\"Return True if all numbers in the list l are below threshold t.\n    >>> below_threshold([1, 2, 4, 10], 100)\n    True\n    >>> below_threshold([1, 20, 4, 10], 5)\n    False\n    \"\"\"\n    for num in l:\n        if num >= t:\n            return False\n    return True"}
