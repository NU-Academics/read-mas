{"task_id": "Mbpp/259", "solution": "class MaxOperation:\n    \"\"\"Encapsulates element-wise maximum computation.\"\"\"\n    def compute(self, a_elem, b_elem):\n        \"\"\"Returns the maximum of two elements.\"\"\"\n        return max(a_elem, b_elem)\n\nclass Validator:\n    \"\"\"Encapsulates validation logic for tuple operations.\"\"\"\n    def validate_lengths(self, a, b):\n        \"\"\"Raises ValueError if outer sequences have different lengths.\"\"\"\n        if len(a) != len(b):\n            raise ValueError(\"Outer sequences must have same length\")\n\n    def validate_element_compatibility(self, a_item, b_item):\n        \"\"\"\n        Raises ValueError if inner tuples have different lengths or if elements are not comparable.\n        \"\"\"\n        if len(a_item) != len(b_item):\n            raise ValueError(\"Inner tuples must have same length\")\n        for x, y in zip(a_item, b_item):\n            try:\n                _ = max(x, y)\n            except TypeError:\n                raise ValueError(\"Elements at position j are not comparable\")\n\ndef maximize_elements(a, b):\n    \"\"\"\n    Computes the element-wise maximum of two sequences of tuples.\n    Validates input and returns a tuple of tuples.\n    \"\"\"\n    validator = Validator()\n    validator.validate_lengths(a, b)\n    maxop = MaxOperation()\n    result_inner = []\n    for a_item, b_item in zip(a, b):\n        validator.validate_element_compatibility(a_item, b_item)\n        inner_maxima = tuple(maxop.compute(x, y) for x, y in zip(a_item, b_item))\n        result_inner.append(inner_maxima)\n    return tuple(result_inner)"}
{"task_id": "Mbpp/262", "solution": "def split_two_parts(input_list, L):\n    \"\"\"\n    Splits a list into two parts based on a given length L for the first part.\n    Returns the two resulting lists as a tuple.\n    \"\"\"\n    if not isinstance(input_list, list) or not isinstance(L, int):\n        raise TypeError(\"Input must be a list and L must be an integer.\")\n\n    if L <= 0:\n        first_part = []\n        second_part = input_list.copy()\n    elif L >= len(input_list):\n        first_part = input_list.copy()\n        second_part = []\n    else:\n        first_part = input_list[:L]\n        second_part = input_list[L:]\n\n    return (first_part, second_part)"}
{"task_id": "Mbpp/264", "solution": "\"\"\"\nWrite a function to calculate a dog's age in dog's years.\nassert dog_age(12)==61\n\"\"\"\n\ndef _round_half_up(value: float) -> int:\n    \"\"\"Rounds a float to the nearest integer, with .5 rounding up.\"\"\"\n    return int(value + 0.5)\n\nclass DogAgeRequest:\n    \"\"\"Encapsulates input human_years for dog age calculation.\"\"\"\n    def __init__(self, human_years: int) -> None:\n        self.human_years = human_years\n\nclass DogAgeResponse:\n    \"\"\"Encapsulates output dog_years from dog age calculation.\"\"\"\n    def __init__(self, dog_years: int) -> None:\n        self.dog_years = dog_years\n\nclass Validator:\n    \"\"\"Validates DogAgeRequest per business rules (non-negative integer).\"\"\"\n    def is_valid(self, request: DogAgeRequest) -> bool:\n        \"\"\"Returns True if human_years is a non-negative integer, otherwise False.\"\"\"\n        return isinstance(request.human_years, int) and request.human_years >= 0\n\nclass DogAgeCalculator:\n    \"\"\"Computes a dog's age in dog years based on the specified formula.\"\"\"\n    def calculate(self, request: DogAgeRequest) -> DogAgeResponse:\n        \"\"\"Calculates dog's age and returns it in a DogAgeResponse.\"\"\"\n        human_years = request.human_years\n        \n        if human_years <= 0:\n            numeric_dog_years = 0.0\n        elif human_years == 1:\n            numeric_dog_years = 10.5\n        elif human_years == 2:\n            numeric_dog_years = 21.0\n        else:\n            numeric_dog_years = 21.0 + (human_years - 2) * 4.0\n            \n        int_dog_years = _round_half_up(numeric_dog_years)\n        return DogAgeResponse(int_dog_years)\n\ndef dog_age(human_years: int) -> int:\n    \"\"\"\n    Calculates a dog's age in dog years based on a specific formula.\n    \n    The first two human years count as 10.5 dog years each, and each\n    additional human year counts as 4 dog years.\n    \"\"\"\n    request = DogAgeRequest(human_years)\n    validator = Validator()\n    if not validator.is_valid(request):\n        raise ValueError(\"invalid human_years: must be a non-negative integer\")\n    \n    calculator = DogAgeCalculator()\n    response = calculator.calculate(request)\n    return response.dog_years"}
{"task_id": "Mbpp/261", "solution": "from typing import Tuple, Union, Any\n\ndef is_numeric(value: Any) -> bool:\n    \"\"\"Checks if a value is an integer or a float.\"\"\"\n    return isinstance(value, (int, float))\n\ndef validate_inputs(a: tuple, b: tuple) -> None:\n    \"\"\"Validates input tuples for type, length, element types, and zero divisors.\"\"\"\n    if not isinstance(a, tuple) or not isinstance(b, tuple):\n        raise TypeError(\"Both inputs must be tuples.\")\n    if len(a) != len(b):\n        raise ValueError(\"Input tuples must have the same length.\")\n    for i in range(len(a)):\n        if not is_numeric(a[i]) or not is_numeric(b[i]):\n            raise TypeError(\"All elements in the tuples must be numeric (int or float).\")\n        if b[i] == 0:\n            raise ZeroDivisionError(f\"Cannot divide by zero at index {i}.\")\n\ndef element_division(a_elem: Union[int, float], b_elem: Union[int, float]) -> float:\n    \"\"\"Performs standard division of two numeric elements.\"\"\"\n    return a_elem / b_elem\n\ndef format_quotient(q: float) -> Union[int, float]:\n    \"\"\"Formats a float quotient to an integer if it is mathematically whole.\"\"\"\n    if q.is_integer():\n        return int(q)\n    return q\n\ndef division_elements(a: tuple, b: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise mathematical division on two input tuples.\n    Inputs are validated for type, length, numeric elements, and non-zero divisors.\n    \"\"\"\n    validate_inputs(a, b)\n    \n    results = []\n    for i in range(len(a)):\n        raw_quotient = element_division(a[i], b[i])\n        formatted_quotient = format_quotient(raw_quotient)\n        results.append(formatted_quotient)\n        \n    return tuple(results)"}
{"task_id": "Mbpp/266", "solution": "class Cube:\n    def __init__(self, side_length: float) -> None:\n        self.side_length: float = side_length\n\nclass LateralSurfaceCalculator:\n    def calculate(self, side_length: float) -> float:\n        \"\"\"Calculates the lateral surface area using the formula 4 * side_length^2.\"\"\"\n        return 4 * (side_length ** 2)\n\ndef lateralsurface_cube(side_length: float) -> float:\n    \"\"\"\n    Calculates the lateral surface area of a cube given its side length.\n    It uses helper classes Cube and LateralSurfaceCalculator for the computation.\n    \"\"\"\n    cube = Cube(side_length)\n    calculator = LateralSurfaceCalculator()\n    result = calculator.calculate(cube.side_length)\n    return result"}
{"task_id": "Mbpp/265", "solution": "def list_split(lst, n):\n    \"\"\"\n    Splits a list into n sublists, distributing elements by their original index modulo n.\n    Each element at index i is appended to the sublist at result[i % n].\n    \"\"\"\n    result = [[] for _ in range(n)]\n\n    for i, element in enumerate(lst):\n        result[i % n].append(element)\n\n    return result"}
{"task_id": "Mbpp/260", "solution": "import math\n\nclass InputValidator:\n    \"\"\"Validates the caller-supplied parameter n according to BR-3 and BR-7.\"\"\"\n    def validate(self, n: int) -> None:\n        \"\"\"\n        Raises ValueError with meaningful message for invalid inputs (non-int or n <= 0).\n        Returns None for valid input.\n        \"\"\"\n        if not isinstance(n, int):\n            raise ValueError(\"Input 'n' must be an integer.\")\n        if n <= 0:\n            raise ValueError(\"Input 'n' must be a positive integer.\")\n\nclass NSWGenerator:\n    \"\"\"Generates Newman\u2013Shanks\u2013Williams numbers sequentially on demand.\"\"\"\n    def __init__(self) -> None:\n        self._index = 0\n        # NSW(0) = 1, NSW(1) = 1. Recurrence starts from NSW(2).\n        self._prev_values = (1, 1) # (NSW(k-2), NSW(k-1))\n\n    def generate_next(self) -> int:\n        \"\"\"Return the next Newman\u2013Shanks\u2013Williams number, increment internal index.\"\"\"\n        if self._index == 0:\n            self._index += 1\n            return 1 # NSW(0)\n        elif self._index == 1:\n            self._index += 1\n            return 1 # NSW(1)\n        else:\n            nsw_k_minus_2, nsw_k_minus_1 = self._prev_values\n            nsw_k = 2 * nsw_k_minus_1 + nsw_k_minus_2\n            self._prev_values = (nsw_k_minus_1, nsw_k)\n            self._index += 1\n            return nsw_k\n\n    def generate_up_to_count(self, count: int) -> list[int]:\n        \"\"\"Produce and return list of newly produced NSW numbers (implementation convenience).\"\"\"\n        generated_list = []\n        for _ in range(count):\n            generated_list.append(self.generate_next())\n        return generated_list\n\n\nclass PrimeChecker:\n    \"\"\"Provides primality checking utility.\"\"\"\n    def is_prime(self, x: int) -> bool:\n        \"\"\"Return True if x is prime, False otherwise.\"\"\"\n        if x <= 1:\n            return False\n        if x <= 3:\n            return True # 2 and 3 are prime\n        if x % 2 == 0 or x % 3 == 0:\n            return False\n        i = 5\n        while i * i <= x:\n            if x % i == 0 or x % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\nclass Result:\n    \"\"\"Lightweight data holder for API result.\"\"\"\n    def __init__(self, n: int, value: int) -> None:\n        self.n = n\n        self.value = value\n\nclass NewmanPrimeService:\n    \"\"\"\n    Orchestrates finding the nth Newman\u2013Shanks\u2013Williams prime number.\n    Validates input, requests NSW numbers, checks primality, and returns the nth NSW prime.\n    \"\"\"\n    def __init__(self) -> None:\n        self._validator = InputValidator()\n        self._generator = NSWGenerator()\n        self._checker = PrimeChecker()\n\n    def newman_prime(self, n: int) -> int:\n        \"\"\"\n        Finds the nth Newman\u2013Shanks\u2013Williams prime number.\n        Returns the integer value of the nth NSW prime.\n        \"\"\"\n        self._validator.validate(n)\n\n        found_primes_count = 0 # 1-based count for the 'nth' prime\n        current_nsw_prime = None\n\n        while True:\n            nsw_number = self._generator.generate_next()\n            if self._checker.is_prime(nsw_number):\n                found_primes_count += 1\n                if found_primes_count == n:\n                    current_nsw_prime = nsw_number\n                    break\n        \n        return current_nsw_prime\n\ndef newman_prime(n: int) -> int:\n    \"\"\"\n    Public API entry exposing function newman_prime(n).\n    Finds the nth Newman\u2013Shanks\u2013Williams prime number.\n    \"\"\"\n    svc = NewmanPrimeService()\n    return svc.newman_prime(n)"}
{"task_id": "Mbpp/267", "solution": "def square_Sum(n):\n    \"\"\"\n    Calculates the sum of the squares of the first n odd natural numbers.\n    Assumes n is a non-negative integer.\n    \"\"\"\n    if n <= 0:\n        return 0\n\n    total_sum = 0\n    for i in range(n):\n        odd_number = 2 * i + 1\n        total_sum += odd_number * odd_number\n    return total_sum"}
{"task_id": "Mbpp/268", "solution": "class ValidationError(Exception):\n    \"\"\"Exception raised for invalid input to star number functions.\"\"\"\n    def __init__(self, message):\n        super().__init__(message)\n\ndef validate(n):\n    \"\"\"Validates that n is an integer and n >= 1, raising ValidationError on failure.\"\"\"\n    if not isinstance(n, int):\n        raise ValidationError(\"Input 'n' must be an integer.\")\n    if n < 1:\n        raise ValidationError(\"Input 'n' must be a positive integer (n >= 1).\")\n\ndef compute(n):\n    \"\"\"Computes the n'th star number using the formula S(n) = 6 * n * (n - 1) + 1.\"\"\"\n    return 6 * n * (n - 1) + 1\n\ndef find_star_num(n):\n    \"\"\"\n    Finds the n'th star number.\n\n    Validates input 'n' and computes the star number S(n) = 6 * n * (n - 1) + 1.\n    \"\"\"\n    validate(n)\n    return compute(n)"}
{"task_id": "Mbpp/269", "solution": "class ValidationError(Exception):\n    \"\"\"Exception raised for validation errors with a descriptive message.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(message)\n\n    def __str__(self) -> str:\n        return self.message\n\nclass CharacterInput:\n    \"\"\"Validates if an input is a single ASCII character string.\"\"\"\n    def __init__(self, char):\n        self.char = char\n\n    def is_valid(self) -> bool:\n        \"\"\"Checks if the input is a single character string within ASCII range.\"\"\"\n        if not isinstance(self.char, str):\n            return False\n        if len(self.char) != 1:\n            return False\n        if ord(self.char) > 127:\n            return False\n        return True\n\n    def validation_error_message(self) -> str:\n        \"\"\"Provides a descriptive error message for invalid inputs.\"\"\"\n        if not isinstance(self.char, str):\n            return \"Input must be a string.\"\n        if len(self.char) == 0:\n            return \"Input string cannot be empty.\"\n        if len(self.char) > 1:\n            return \"Input string must contain exactly one character.\"\n        if ord(self.char) > 127:\n            return \"Input character must have an ASCII code point (0-127).\"\n        return \"Unknown validation error.\"\n\nclass AsciiConverter:\n    \"\"\"Converts a single character string to its ASCII integer value.\"\"\"\n    @staticmethod\n    def to_ascii(c: str) -> int:\n        \"\"\"Returns the integer ASCII code for the given character.\"\"\"\n        return ord(c)\n\ndef ascii_value(c):\n    \"\"\"\n    Validate input and return the ASCII integer code for a character.\n    Raises ValidationError for invalid inputs.\n    \"\"\"\n    ci = CharacterInput(c)\n    if not ci.is_valid():\n        raise ValidationError(ci.validation_error_message())\n    return AsciiConverter.to_ascii(c)"}
{"task_id": "Mbpp/270", "solution": "def sum_even_and_even_index(lst: list) -> int:\n    \"\"\"Return sum of items in lst that are even integers and at even indices (0-based).\"\"\"\n    total_sum = 0\n    for index, value in enumerate(lst):\n        if index % 2 == 0 and value % 2 == 0:\n            total_sum += value\n    return total_sum"}
{"task_id": "Mbpp/272", "solution": "from typing import List, Tuple, Any\n\nInputList = List[Tuple[Any, ...]]\nTupleAlias = Tuple[Any, ...]\nResultList = List[Any]\n\ndef rear_extract(input_list: InputList) -> ResultList:\n    \"\"\"Return a list containing the last element of each tuple in input_list.\n\n    If input_list is empty, returns an empty list.\n    \"\"\"\n    result = []\n    for tup in input_list:\n        result.append(tup[-1])\n    return result"}
{"task_id": "Mbpp/271", "solution": "class Validation:\n    \"\"\"Helper class for input validation.\"\"\"\n    @staticmethod\n    def is_valid(n) -> bool:\n        \"\"\"Checks if n is a non-negative integer.\"\"\"\n        return isinstance(n, int) and n >= 0\n\ndef _compute_sum(n: int) -> int:\n    \"\"\"Computes the sum of the first n even natural numbers raised to the fifth power.\"\"\"\n    total_sum = 0\n    for k in range(1, n + 1):\n        total_sum += (2 * k) ** 5\n    return total_sum\n\ndef even_Power_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the first n even natural numbers raised to the fifth power.\n    Raises ValueError if n is not a non-negative integer.\n    \"\"\"\n    if not Validation.is_valid(n):\n        raise ValueError(\"Input n must be a non-negative integer.\")\n    \n    return _compute_sum(n)"}
{"task_id": "Mbpp/273", "solution": "def substract_elements(tuple1, tuple2):\n    \"\"\"\n    Subtracts elements of the second tuple from the elements of the first tuple\n    at corresponding indices.\n    \"\"\"\n    if not isinstance(tuple1, tuple) or not isinstance(tuple2, tuple):\n        raise TypeError(\"Both arguments must be tuples.\")\n\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Input tuples must have the same length.\")\n\n    result_elements = []\n    for i in range(len(tuple1)):\n        result_elements.append(tuple1[i] - tuple2[i])\n\n    return tuple(result_elements)"}
{"task_id": "Mbpp/274", "solution": "class Validator:\n    \"\"\"Validates input 'n' to ensure it's a positive integer.\"\"\"\n    def validate(self, n) -> None:\n        \"\"\"Raises ValueError if n is not an integer or is not positive.\"\"\"\n        if not isinstance(n, int):\n            raise ValueError(\"Input 'n' must be an integer.\")\n        if n <= 0:\n            raise ValueError(\"Input 'n' must be a positive integer (n > 0).\")\n\nclass BinomialCoefficient:\n    \"\"\"Computes binomial coefficients C(n, k) using integer arithmetic.\"\"\"\n    def C(self, n: int, k: int) -> int:\n        \"\"\"Calculates C(n, k) using a multiplicative method.\"\"\"\n        if k < 0 or k > n:\n            return 0\n        if k == 0 or k == n:\n            return 1\n        if k > n // 2:\n            k = n - k\n\n        res = 1\n        for i in range(k):\n            res = res * (n - i) // (i + 1)\n        return res\n\nclass Accumulator:\n    \"\"\"Maintains a running total of integers.\"\"\"\n    def __init__(self):\n        \"\"\"Initializes the total to zero.\"\"\"\n        self.total: int = 0\n\n    def add(self, value: int) -> None:\n        \"\"\"Adds a value to the running total.\"\"\"\n        self.total += value\n\ndef even_binomial_Coeff_Sum(n) -> int:\n    \"\"\"\n    Calculates the sum of even-indexed binomial coefficients for a given n.\n    C(n,0) + C(n,2) + C(n,4) + ...\n    \"\"\"\n    validator = Validator()\n    validator.validate(n)\n\n    bc = BinomialCoefficient()\n    accumulator = Accumulator()\n\n    for k in range(n + 1):\n        if k % 2 == 0:\n            coefficient = bc.C(n, k)\n            accumulator.add(coefficient)\n\n    return accumulator.total"}
{"task_id": "Mbpp/276", "solution": "import math\nfrom typing import Union\n\nclass MathConstants:\n    \"\"\"Holds mathematical constants.\"\"\"\n    PI: float = 3.141592653589793\n\nclass InputValidator:\n    \"\"\"Validates if inputs are numeric and finite.\"\"\"\n    def validateNumeric(self, radius: Union[int, float], height: Union[int, float]) -> bool:\n        \"\"\"Returns True if both radius and height are numeric and finite, False otherwise.\"\"\"\n        if not isinstance(radius, (int, float)) or not isinstance(height, (int, float)):\n            return False\n        if not math.isfinite(radius) or not math.isfinite(height):\n            return False\n        return True\n\nclass VolumeCalculator:\n    \"\"\"Calculates the volume of a cylinder.\"\"\"\n    def calculateVolume(self, radius: Union[int, float], height: Union[int, float]) -> float:\n        \"\"\"Computes the cylinder volume using PI * radius^2 * height.\"\"\"\n        return MathConstants.PI * (radius ** 2) * height\n\ndef volume_cylinder(radius: Union[int, float], height: Union[int, float]) -> float:\n    \"\"\"\n    Calculates the volume of a cylinder given its radius and height.\n    Raises ValueError if radius or height are not numeric or finite.\n    \"\"\"\n    validator = InputValidator()\n    if not validator.validateNumeric(radius, height):\n        raise ValueError(\"radius and height must be numeric and finite\")\n\n    calculator = VolumeCalculator()\n    computed_volume = calculator.calculateVolume(radius, height)\n\n    return float(computed_volume)"}
{"task_id": "Mbpp/277", "solution": "from typing import Dict, List\n\n# Type alias for clarity, aligning with SRS terminology.\nDictionary = Dict[str, int]\n\nclass KeyValuePair:\n    \"\"\"Represents a key-value pair from the input dictionary.\"\"\"\n    def __init__(self, key: str, value: int):\n        self.key = key\n        self.value = value\n\n    def __repr__(self) -> str:\n        return f\"KeyValuePair(key='{self.key}', value={self.value})\"\n\nclass FilterCriterion:\n    \"\"\"Encapsulates the filtering logic for values.\"\"\"\n    def __init__(self, threshold: int):\n        self.threshold = threshold\n\n    def matches(self, kv: KeyValuePair) -> bool:\n        \"\"\"Checks if a KeyValuePair's value meets the threshold.\"\"\"\n        return kv.value >= self.threshold\n\nclass ResultDictionary:\n    \"\"\"Aggregates filtered KeyValuePairs and converts to a dictionary.\"\"\"\n    def __init__(self):\n        self._entries: List[KeyValuePair] = []\n\n    def add(self, kv: KeyValuePair) -> None:\n        \"\"\"Adds a KeyValuePair to the result collection.\"\"\"\n        self._entries.append(kv)\n\n    def as_dict(self) -> Dictionary:\n        \"\"\"Converts the collected KeyValuePairs into a dictionary.\"\"\"\n        return {kv.key: kv.value for kv in self._entries}\n\ndef dict_filter(inputDict: Dictionary, n: int) -> Dictionary:\n    \"\"\"\n    Filters a dictionary to include only entries with values greater than or equal to n.\n    Returns a new dictionary with the filtered key-value pairs.\n    \"\"\"\n    criterion = FilterCriterion(n)\n    result = ResultDictionary()\n    for key, value in inputDict.items():\n        kv = KeyValuePair(key, value)\n        if criterion.matches(kv):\n            result.add(kv)\n    return result.as_dict()"}
{"task_id": "Mbpp/278", "solution": "import collections\nfrom typing import Any\n\ndef count_first_elements(input_value: Any) -> int:\n    \"\"\"Public API. Validates input and returns the count of top-level elements before first top-level tuple element.\n    Raises:\n        TypeError: if input_value is not a tuple.\n    \"\"\"\n    def _validate_input(input_value: Any) -> None:\n        \"\"\"Raises TypeError if input_value is not a tuple.\"\"\"\n        if not isinstance(input_value, tuple):\n            raise TypeError(\"Input must be a tuple.\")\n\n    def _find_first_tuple_index(input_value: tuple) -> int:\n        \"\"\"Return the count of elements before first top-level tuple; 0 if none.\"\"\"\n        count = 0\n        for element in input_value:\n            if isinstance(element, tuple):\n                return count\n            count += 1\n        return count\n\n    _validate_input(input_value)\n    return _find_first_tuple_index(input_value)"}
{"task_id": "Mbpp/279", "solution": "class InvalidInputError(Exception):\n    \"\"\"Domain exception type for validation failures.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n\nclass InputValidator:\n    \"\"\"Validates input 'n' to ensure it's an integer and non-negative.\"\"\"\n    def validate(self, n) -> None:\n        if not isinstance(n, int):\n            raise InvalidInputError(\"Input must be an integer.\")\n        if n < 1:\n            raise InvalidInputError(\"Input must be greater than or equal to 1.\")\n\nclass DecagonalNumberCalculator:\n    \"\"\"Calculates the nth decagonal number using the specified formula.\"\"\"\n    def compute(self, n: int) -> int:\n        \"\"\"Return the nth decagonal number computed by n * (4*n - 3).\"\"\"\n        return self._formula(n)\n\n    def _formula(self, n: int) -> int:\n        \"\"\"Internal helper implementing the formula.\"\"\"\n        return n * (4 * n - 3)\n\ndef is_num_decagonal(n) -> int:\n    \"\"\"Public API per FR1; validates and computes nth decagonal or raises InvalidInputError.\"\"\"\n    validator = InputValidator()\n    validator.validate(n)\n    calc = DecagonalNumberCalculator()\n    result = calc.compute(n)\n    return int(result)"}
{"task_id": "Mbpp/281", "solution": "def all_unique(input_list):\n    \"\"\"Return True if all elements of input_list are unique according to Python's ==, else False.\n    This implementation uses a pairwise comparison to avoid relying on element hashability.\"\"\"\n    n = len(input_list)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if input_list[i] == input_list[j]:\n                return False\n    return True"}
{"task_id": "Mbpp/280", "solution": "def sequential_search(array, element) -> tuple:\n    \"\"\"\n    Performs a sequential scan and returns (found: bool, index: int).\n    Returns (False, -1) if the element is not found.\n    \"\"\"\n    for i, item in enumerate(array):\n        if item == element:\n            return (True, i)\n    return (False, -1)"}
{"task_id": "Mbpp/282", "solution": "def validate_inputs(a: list, b: list) -> None:\n    \"\"\"Validates that input lists have equal length and contain subtractable elements.\"\"\"\n    if len(a) != len(b):\n        raise ValueError(\"Input lists must have equal length.\")\n\n    for i in range(len(a)):\n        try:\n            _ = a[i] - b[i]\n        except TypeError:\n            raise TypeError(\"Elements in lists must support subtraction (e.g., numeric).\")\n\ndef sub_list(a: list, b: list) -> list:\n    \"\"\"Subtracts two lists element-wise, returning a new list.\"\"\"\n    validate_inputs(a, b)\n    result = []\n    for i in range(len(a)):\n        result.append(a[i] - b[i])\n    return result"}
{"task_id": "Mbpp/284", "solution": "def check_element(input_list, element):\n    \"\"\"Return True if every item in input_list equals element (using ==); otherwise return False.\n\n    Preconditions: SRS does not specify input validation; inputs are expected to support iteration and equality (==).\n    \"\"\"\n    for item in input_list:\n        if item != element:\n            return False\n    return True"}
{"task_id": "Mbpp/283", "solution": "import collections\n\nclass IntegerValue:\n    \"\"\"Holds an integer value and provides its normalized string representation.\"\"\"\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def normalized_str(self) -> str:\n        \"\"\"Returns the absolute value of the integer as a string.\"\"\"\n        return str(abs(self.value))\n\nclass DigitCount:\n    \"\"\"Data holder for a digit and its frequency count.\"\"\"\n    def __init__(self, digit: int, count: int) -> None:\n        self.digit = digit\n        self.count = count\n\nclass ValidationResult:\n    \"\"\"Data holder for the boolean outcome of the validation.\"\"\"\n    def __init__(self, is_valid: bool) -> None:\n        self.is_valid = is_valid\n\ndef validate(n: int) -> bool:\n    \"\"\"\n    Checks if the frequency of each digit in the integer is less than or equal to the digit itself.\n    Uses absolute value of the input for validation.\n    \"\"\"\n    int_value_obj = IntegerValue(n)\n    normalized_s = int_value_obj.normalized_str()\n\n    digit_frequencies = collections.Counter(normalized_s)\n\n    is_valid = True\n    for digit_char, count in digit_frequencies.items():\n        digit_val = int(digit_char)\n        if not (count <= digit_val):\n            is_valid = False\n            break\n\n    return is_valid"}
{"task_id": "Mbpp/285", "solution": "class InputString:\n    \"\"\"Encapsulates the raw input string and provides helpers.\"\"\"\n    def __init__(self, value: str):\n        self.value = value\n        self._length = len(value)\n\n    def length(self) -> int:\n        return self._length\n\ndef allowed_patterns() -> list[str]:\n    \"\"\"Provides canonical allowed patterns: ['abb', 'abbb'].\"\"\"\n    return ['abb', 'abbb']\n\nclass MatchResult:\n    \"\"\"Represents match outcome and optional metadata.\"\"\"\n    def __init__(self, matched: bool, match_type: str = None, matched_substring: str = None, start_index: int = None, end_index: int = None):\n        self.matched = matched\n        self.match_type = match_type\n        self.matched_substring = matched_substring\n        self.start_index = start_index\n        self.end_index = end_index\n\nclass Scanner:\n    \"\"\"Scans the InputString and yields candidate indices for matching.\"\"\"\n    def scan_positions(self, input_string: InputString):\n        \"\"\"Yields positions where 'a' occurs and remaining length is sufficient for 'abb'.\"\"\"\n        for i in range(input_string.length()):\n            if input_string.value[i] == 'a' and i + 3 <= input_string.length():\n                yield i\n\nclass Matcher:\n    \"\"\"Detects 'abb' or 'abbb' at given positions and returns MatchResult.\"\"\"\n    def find_match_at(self, input_string: InputString, position: int) -> MatchResult | None:\n        \"\"\"Checks for 'abb' or 'abbb' at the given position.\"\"\"\n        patterns = allowed_patterns()\n\n        for pattern_str in patterns:\n            pattern_len = len(pattern_str)\n            if position + pattern_len <= input_string.length():\n                substring = input_string.value[position : position + pattern_len]\n                if substring == pattern_str:\n                    return MatchResult(\n                        matched=True,\n                        match_type=pattern_str,\n                        matched_substring=substring,\n                        start_index=position,\n                        end_index=position + pattern_len\n                    )\n        return None\n\nclass TextMatchService:\n    \"\"\"Orchestrates scanning and matching to determine whether input contains 'abb' or 'abbb'.\"\"\"\n    def __init__(self):\n        self._scanner = Scanner()\n        self._matcher = Matcher()\n\n    def _execute_match(self, input_str_val: str) -> bool:\n        \"\"\"Internal method to perform the matching logic.\"\"\"\n        input_string = InputString(input_str_val)\n\n        for position in self._scanner.scan_positions(input_string):\n            match_result = self._matcher.find_match_at(input_string, position)\n            if match_result and match_result.matched:\n                return True\n        return False\n\ndef text_match_two_three(input: str) -> bool:\n    \"\"\"\n    Checks whether a string contains the 'a' character followed by two or three 'b' characters.\n    Returns True if 'abb' or 'abbb' is found, False otherwise.\n    \"\"\"\n    service = TextMatchService()\n    return service._execute_match(input)"}
{"task_id": "Mbpp/290", "solution": "from typing import Any, List, Tuple\n\ndef max_length(input_list: List[List[Any]]) -> Tuple[int, List[Any]]:\n    \"\"\"\n    Finds the sublist with the maximum length in a list of lists.\n    Returns a tuple of (max_length, longest_sublist).\n    \"\"\"\n    max_len = 0\n    longest_sublist: List[Any] = []\n\n    for sublist in input_list:\n        current_len = len(sublist)\n        if current_len > max_len:\n            max_len = current_len\n            longest_sublist = sublist\n            \n    return (max_len, longest_sublist)"}
{"task_id": "Mbpp/287", "solution": "def generate_even_sequence(n: int) -> list:\n    \"\"\"Generates a list of the first n even natural numbers.\"\"\"\n    return [2 * k for k in range(1, n + 1)]\n\ndef compute_squares(sequence: list) -> list:\n    \"\"\"Computes the square of each number in a sequence.\"\"\"\n    return [x * x for x in sequence]\n\ndef sum_squares(squares: list) -> int:\n    \"\"\"Calculates the sum of a list of numbers.\"\"\"\n    return sum(squares)\n\ndef square_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of squares of the first n even natural numbers.\n    Returns 0 if n is not positive.\n    \"\"\"\n    if n <= 0:\n        return 0\n\n    even_numbers = generate_even_sequence(n)\n    squared_evens = compute_squares(even_numbers)\n    total_sum = sum_squares(squared_evens)\n    \n    return total_sum"}
{"task_id": "Mbpp/292", "solution": "import math\nfrom dataclasses import dataclass\n\n@dataclass\nclass NumericValue:\n    \"\"\"Data holder for a numeric value.\"\"\"\n    value: float\n\n@dataclass\nclass Result:\n    \"\"\"Data holder for the integer result.\"\"\"\n    value: int\n\nclass FloorOperation:\n    \"\"\"Encapsulates math.floor semantics.\"\"\"\n    def apply(self, value: float) -> int:\n        \"\"\"Applies mathematical floor to a float and returns an integer.\"\"\"\n        return int(math.floor(value))\n\ndef validate_inputs(dividend, divisor):\n    \"\"\"\n    Performs minimal input validation.\n    Type and zero-division checks are omitted due to specific completion constraints.\n    \"\"\"\n    pass\n\ndef find(dividend, divisor) -> int:\n    \"\"\"\n    Computes the quotient of two numbers, rounded down to the nearest integer (mathematical floor).\n    \"\"\"\n    validate_inputs(dividend, divisor)\n    \n    quotient = dividend / divisor\n    \n    floor_op = FloorOperation()\n    floored_quotient = floor_op.apply(quotient)\n    \n    return Result(value=floored_quotient).value"}
{"task_id": "Mbpp/286", "solution": "from typing import List\n\nclass Array:\n    \"\"\"\n    Encapsulates base-array metrics computation for a single arr.\n    \"\"\"\n    def __init__(self, elements: List[int], length: int):\n        self.elements = elements\n        self.length = length\n\n    def totalSum(self) -> int:\n        \"\"\"Returns the sum of all elements in the array.\"\"\"\n        return sum(self.elements)\n\n    def maxSubarraySum(self) -> int:\n        \"\"\"Computes the maximum contiguous subarray sum using Kadane's algorithm.\"\"\"\n        if not self.elements:\n            return 0\n        \n        max_so_far = self.elements[0]\n        current_max = self.elements[0]\n\n        for i in range(1, self.length):\n            current_max = max(self.elements[i], current_max + self.elements[i])\n            max_so_far = max(max_so_far, current_max)\n        \n        return max_so_far\n\n    def maxPrefixSum(self) -> int:\n        \"\"\"Computes the maximum sum of any prefix (including an empty prefix with sum 0).\"\"\"\n        if not self.elements:\n            return 0\n        \n        max_prefix = 0\n        current_sum = 0\n        for x in self.elements:\n            current_sum += x\n            max_prefix = max(max_prefix, current_sum)\n        return max_prefix\n\n    def maxSuffixSum(self) -> int:\n        \"\"\"Computes the maximum sum of any suffix (including an empty suffix with sum 0).\"\"\"\n        if not self.elements:\n            return 0\n        \n        max_suffix = 0\n        current_sum = 0\n        for x in reversed(self.elements):\n            current_sum += x\n            max_suffix = max(max_suffix, current_sum)\n        return max_suffix\n\nclass RepeatedArray:\n    \"\"\"\n    Combines Array metrics across k repetitions to compute the maximum contiguous\n    subarray sum over arr repeated k times without materializing the full repeated array.\n    \"\"\"\n    def __init__(self, base: Array, k: int):\n        self.base = base\n        self.k = k\n        self.totalLength = base.length * k\n\n    def totalSum(self) -> int:\n        \"\"\"Returns the total sum of the repeated array.\"\"\"\n        return self.base.totalSum() * self.k\n\n    def maxSubarraySumRepeated(self) -> int:\n        \"\"\"Computes the final maximum contiguous subarray sum using base metrics and combination rules.\"\"\"\n        base_max = self.base.maxSubarraySum()\n        prefix = self.base.maxPrefixSum()\n        suffix = self.base.maxSuffixSum()\n        total = self.base.totalSum()\n\n        if self.k == 1:\n            return base_max\n        \n        # Consider subarrays spanning across copies\n        # 1. Subarray entirely within one copy (handled by base_max)\n        # 2. Subarray spanning exactly two copies (suffix of first + prefix of second)\n        candidate_cross = suffix + prefix\n        \n        answer = base_max\n        if self.k > 0: # If k is 0, we already handled it\n            answer = max(answer, candidate_cross)\n\n        # 3. Subarray spanning more than two copies (suffix + (k-2)*total + prefix)\n        if total > 0:\n            if self.k > 1: # Only applies if there's at least one full copy between prefix and suffix\n                candidate_extend = suffix + (self.k - 2) * total + prefix\n                answer = max(answer, candidate_extend)\n        \n        return answer\n\nclass Subarray:\n    \"\"\"\n    Represents a candidate contiguous subarray (conceptual).\n    \"\"\"\n    def __init__(self, startIndex: int, endIndex: int, sum: int):\n        self.startIndex = startIndex\n        self.endIndex = endIndex\n        self.sum = sum\n\nclass Result:\n    \"\"\"\n    Container for final computed maximum sum.\n    \"\"\"\n    def __init__(self, maxSum: int):\n        self.maxSum = maxSum\n\ndef max_sub_array_sum_repeated(arr, n, k) -> int:\n    \"\"\"\n    Finds the largest sum of a contiguous array in the modified array which is\n    formed by repeating the given array k times.\n    \"\"\"\n    # Input validation\n    if not isinstance(arr, (list, tuple)) or any(not isinstance(x, int) for x in arr):\n        raise ValueError('arr must be a list of integers')\n    if not isinstance(n, int) or not isinstance(k, int):\n        raise ValueError('n and k must be integers')\n    if n != len(arr):\n        raise ValueError('n does not match length of arr')\n    \n    # Chosen behavior for k <= 0\n    if k <= 0:\n        return 0\n    \n    # Handle empty array case\n    if n == 0:\n        return 0\n\n    base_array = Array(elements=list(arr), length=n)\n    repeated_array = RepeatedArray(base=base_array, k=k)\n    \n    final_max_sum = repeated_array.maxSubarraySumRepeated()\n    \n    return Result(maxSum=final_max_sum).maxSum"}
{"task_id": "Mbpp/293", "solution": "import math\n\ndef otherside_rightangle(a, b):\n    # Calculates the hypotenuse of a right-angled triangle using the Pythagorean theorem.\n    # Assumes a and b are valid non-negative numeric inputs as per external requirements.\n    a_squared = a * a\n    b_squared = b * b\n    hypotenuse_squared = a_squared + b_squared\n    hypotenuse = math.sqrt(hypotenuse_squared)\n    return hypotenuse"}
{"task_id": "Mbpp/294", "solution": "from typing import Any, Optional, Union, List\n\nclass Element:\n    \"\"\"\n    Represents an element from the input list, providing methods to check its type.\n    \"\"\"\n    def __init__(self, raw_value: Any) -> None:\n        self.raw_value = raw_value\n\n    def is_numeric(self) -> bool:\n        \"\"\"\n        Checks if the element is a numeric type (int or float) and not a boolean.\n        \"\"\"\n        return isinstance(self.raw_value, (int, float)) and not isinstance(self.raw_value, bool)\n\n    def as_number(self) -> Optional[Union[int, float]]:\n        \"\"\"\n        Returns the raw value as a number if it's numeric, otherwise None.\n        \"\"\"\n        if self.is_numeric():\n            return self.raw_value\n        return None\n\nclass NumericElement(Element):\n    \"\"\"\n    Conceptual representation of a numeric element.\n    \"\"\"\n    pass\n\nclass NonNumericElement(Element):\n    \"\"\"\n    Conceptual representation of a non-numeric element.\n    \"\"\"\n    pass\n\nclass ListInput:\n    \"\"\"\n    Wraps the input list and provides iteration over Element instances.\n    \"\"\"\n    def __init__(self, elements: list) -> None:\n        self.elements = elements  # Shallow reference as per design\n\n    def length(self) -> int:\n        \"\"\"\n        Returns the number of elements in the wrapped list.\n        \"\"\"\n        return len(self.elements)\n\n    def __iter__(self):\n        \"\"\"\n        Yields Element instances for each item in the wrapped list.\n        \"\"\"\n        for item in self.elements:\n            yield Element(item)\n\nclass Result:\n    \"\"\"\n    Encapsulates the result of the maximum value computation.\n    \"\"\"\n    def __init__(self, max_value: Optional[Union[int, float]], has_numeric: bool) -> None:\n        self.max_value = max_value\n        self.has_numeric = has_numeric\n\n    def __repr__(self) -> str:\n        \"\"\"\n        Provides a string representation of the Result object.\n        \"\"\"\n        return f\"Result(max_value={self.max_value}, has_numeric={self.has_numeric})\"\n\n\ndef max_val(input_list: List[Any]) -> Optional[Union[int, float]]:\n    \"\"\"\n    Finds the maximum numeric value (int or float) in a given heterogeneous list,\n    ignoring non-numeric elements and treating booleans as non-numeric.\n    Returns None if no numeric values are found.\n    \"\"\"\n    list_input_wrapper = ListInput(input_list)\n    numeric_values: List[Union[int, float]] = []\n\n    for element_wrapper in list_input_wrapper:\n        if element_wrapper.is_numeric():\n            # as_number() is guaranteed to return Union[int, float] here due to is_numeric() check.\n            numeric_values.append(element_wrapper.as_number()) # type: ignore\n\n    if not numeric_values:\n        result_obj = Result(max_value=None, has_numeric=False)\n        return result_obj.max_value\n    else:\n        computed_max = max(numeric_values)\n        result_obj = Result(max_value=computed_max, has_numeric=True)\n        return result_obj.max_value"}
{"task_id": "Mbpp/296", "solution": "def _merge_sort_count(arr):\n    \"\"\"\n    Recursively sorts the array segment and counts inversions.\n    Returns a tuple: (sorted_list, inversion_count).\n    \"\"\"\n    n = len(arr)\n    if n <= 1:\n        return arr, 0\n\n    mid = n // 2\n    left_half = arr[:mid]\n    right_half = arr[mid:]\n\n    sorted_left, inv_left = _merge_sort_count(left_half)\n    sorted_right, inv_right = _merge_sort_count(right_half)\n\n    merged_arr = []\n    cross_inversions = 0\n    i = j = 0\n    len_left = len(sorted_left)\n    len_right = len(sorted_right)\n\n    while i < len_left and j < len_right:\n        if sorted_left[i] <= sorted_right[j]:\n            merged_arr.append(sorted_left[i])\n            i += 1\n        else:\n            merged_arr.append(sorted_right[j])\n            cross_inversions += (len_left - i)\n            j += 1\n\n    merged_arr.extend(sorted_left[i:])\n    merged_arr.extend(sorted_right[j:])\n\n    total_inversions = inv_left + inv_right + cross_inversions\n    return merged_arr, total_inversions\n\nclass InversionCounter:\n    \"\"\"\n    Encapsulates inversion-counting logic using merge-sort.\n    \"\"\"\n    def __init__(self):\n        self._array = None\n        self._count = 0\n\n    def get_Inv_Count(self, array) -> int:\n        \"\"\"\n        A convenience method for InversionCounter to delegate the counting.\n        \"\"\"\n        self._array = array\n        self._count = self.compute_using_merge_sort(array)\n        return self._count\n\n    def compute_using_merge_sort(self, array) -> int:\n        \"\"\"\n        Implements merge-sort counting algorithm, returning inversion count.\n        \"\"\"\n        _, count = _merge_sort_count(array)\n        return count\n\ndef get_Inv_Count(array) -> int:\n    \"\"\"\n    Counts inversions in an array using a merge-sort based algorithm.\n    \"\"\"\n    if not isinstance(array, list):\n        raise TypeError(\"Input must be a list.\")\n\n    if len(array) <= 1:\n        return 0\n\n    counter = InversionCounter()\n    return counter.get_Inv_Count(array)"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(input_list):\n    \"\"\"Flattens a given nested list structure of integers. Preserves the left-to-right order of elements.\"\"\"\n    \n    out = []\n\n    def _walk(lst):\n        for elem in lst:\n            if isinstance(elem, int):\n                out.append(elem)\n            elif isinstance(elem, list):\n                _walk(elem)\n\n    _walk(input_list)\n    return out"}
{"task_id": "Mbpp/300", "solution": "class CombinationCalculator:\n    \"\"\"Provides static methods for combinatorial calculations.\"\"\"\n\n    @staticmethod\n    def binomial(n, k):\n        \"\"\"Calculates the binomial coefficient C(n, k).\"\"\"\n        if not (0 <= k <= n):\n            return 0\n\n        if k > n // 2:\n            k = n - k\n\n        if k == 0:\n            return 1\n\n        result = 1\n        for i in range(1, k + 1):\n            result = result * (n - k + i) // i\n        return result\n\n    @staticmethod\n    def central_binomial(n):\n        \"\"\"Calculates the central binomial coefficient C(2n, n).\"\"\"\n        return CombinationCalculator.binomial(2 * n, n)\n\n\nclass CountBinarySeq:\n    \"\"\"Orchestrates validation and calculation for binary sequence counts.\"\"\"\n\n    def __init__(self, n_val):\n        self.n = n_val\n\n    def validate_input(self):\n        \"\"\"Validates that n is a non-negative integer or exact-integer float.\"\"\"\n        if isinstance(self.n, int):\n            if self.n < 0:\n                raise ValueError(\"n must be non-negative\")\n        elif isinstance(self.n, float):\n            if self.n.is_integer():\n                self.n = int(self.n)\n            else:\n                raise TypeError(\"n must be an integer or exact-integer float\")\n        else:\n            raise TypeError(\"n must be an integer or exact-integer float\")\n\n    def calculate(self):\n        \"\"\"Delegates to CombinationCalculator to compute C(2n, n).\"\"\"\n        return CombinationCalculator.central_binomial(self.n)\n\n\ndef count_binary_seq(n):\n    \"\"\"\n    Counts binary sequences of length 2n where the sum of first n bits\n    is the same as the sum of last n bits.\n    \"\"\"\n    executor = CountBinarySeq(n)\n    executor.validate_input()\n    return executor.calculate()"}
{"task_id": "Mbpp/299", "solution": "from typing import List, Tuple, Optional, Union\n\nclass InputEntry:\n    \"\"\"Represents a single input tuple (name, value).\"\"\"\n    def __init__(self, name: str, value: Union[int, float]):\n        self.name = name\n        self.value = value\n\nclass AggregateResult:\n    \"\"\"Represents the selected result (name, total).\"\"\"\n    def __init__(self, name: str, total: Union[int, float]):\n        self.name = name\n        self.total = total\n\n    def as_tuple(self) -> Tuple[str, Union[int, float]]:\n        \"\"\"Returns the result as a 2-tuple.\"\"\"\n        return (self.name, self.total)\n\nclass AggregationStore:\n    \"\"\"In-memory mapping name -> total; accumulates values and finds the maximum.\"\"\"\n    def __init__(self):\n        self.totals: dict[str, Union[int, float]] = {}\n\n    def addEntry(self, name: str, value: Union[int, float]) -> None:\n        \"\"\"Adds value to totals[name], promoting to float if any component is float.\"\"\"\n        current_total = self.totals.get(name, 0)\n        \n        if isinstance(current_total, float) or isinstance(value, float):\n            self.totals[name] = float(current_total) + float(value)\n        else:\n            self.totals[name] = current_total + value\n\n    def getTotal(self, name: str) -> Optional[Union[int, float]]:\n        \"\"\"Returns total for name or None if not present.\"\"\"\n        return self.totals.get(name)\n\n    def getMax(self) -> Optional[AggregateResult]:\n        \"\"\"Scans totals and returns an AggregateResult for a name with the highest total.\"\"\"\n        if not self.totals:\n            return None\n\n        max_name = None\n        max_total: Union[int, float] = -float('inf')\n\n        for name, total in self.totals.items():\n            if total > max_total:\n                max_total = total\n                max_name = name\n        \n        # Convert float total to int if it represents an exact integer value.\n        if isinstance(max_total, float) and max_total.is_integer():\n            max_total = int(max_total)\n\n        return AggregateResult(max_name, max_total)\n\nclass AggregatorFunction:\n    \"\"\"Orchestrates building AggregationStore, computing aggregates, and selecting maximum.\"\"\"\n    @staticmethod\n    def max_aggregate(entries: List[Tuple[str, Union[int, float]]]) -> Tuple[str, Union[int, float]]:\n        \"\"\"\n        Accumulates values and returns the maximum aggregate, handling empty input by returning a default.\n        \"\"\"\n        aggregation_store = AggregationStore()\n\n        for entry in entries:\n            name, value = entry # Assume entries are well-formed (2-tuple, str name, numeric value).\n            aggregation_store.addEntry(name, value)\n\n        result = aggregation_store.getMax()\n\n        if result is None:\n            # If no entries were processed, return a default empty aggregate tuple.\n            return ('', 0)\n\n        return result.as_tuple()\n\ndef max_aggregate(entries: List[Tuple[str, Union[int, float]]]) -> Tuple[str, Union[int, float]]:\n    \"\"\"\n    Calculates the maximum aggregate from a list of (name, value) tuples.\n    It sums values for each name and returns the name with the highest total.\n    \"\"\"\n    return AggregatorFunction.max_aggregate(entries)"}
{"task_id": "Mbpp/301", "solution": "def _validate_input(input_obj):\n    \"\"\"Validates that the input object is a dictionary.\"\"\"\n    if not isinstance(input_obj, dict):\n        raise TypeError(\"Input must be a dictionary.\")\n\ndef dict_depth(input_dict: dict) -> int:\n    \"\"\"\n    Calculates the maximum nesting depth of dictionaries within the input dictionary.\n    The top-level dictionary counts as depth 1.\n    \"\"\"\n    _validate_input(input_dict)\n\n    max_child_depth = 0\n    for value in input_dict.values():\n        if isinstance(value, dict):\n            # Recursively calculate depth for nested dictionaries\n            max_child_depth = max(max_child_depth, dict_depth(value))\n\n    # The depth of the current dictionary is 1 (for itself) + the maximum depth of its children.\n    return 1 + max_child_depth"}
{"task_id": "Mbpp/305", "solution": "class Word:\n    \"\"\"Represents a single word token.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\n    def startsWithP(self) -> bool:\n        \"\"\"Checks if the word starts with 'p' (case-insensitive).\"\"\"\n        return self.text.lower().startswith('p')\n\nclass Tokenizer:\n    \"\"\"Splits raw strings into tokens based on whitespace.\"\"\"\n    def tokenize(self, raw: str) -> list[str]:\n        \"\"\"Returns a list of tokens from the raw string.\"\"\"\n        return raw.split()\n\nclass Matcher:\n    \"\"\"Filters a list of Word objects for those starting with 'p'.\"\"\"\n    def filter_p_words(self, words: list[Word]) -> list[Word]:\n        \"\"\"Returns ordered Word instances that start with 'p'.\"\"\"\n        return [word for word in words if word.startsWithP()]\n\nclass Result:\n    \"\"\"Encapsulates the two-word tuple result.\"\"\"\n    def __init__(self, words: tuple[str, str]):\n        self.words = words\n\n    def as_tuple(self) -> tuple[str, str]:\n        \"\"\"Returns the contained tuple of words.\"\"\"\n        return self.words\n\nclass StartWithP:\n    \"\"\"Coordinates tokenization, matching, and result assembly.\"\"\"\n    def __init__(self, input_strings: list):\n        self.inputStrings = input_strings\n\n    def execute(self) -> tuple:\n        \"\"\"Orchestrates processing to find and return the first two 'p' words.\"\"\"\n        tokenizer = Tokenizer()\n        matcher = Matcher()\n        \n        found_p_words_text = []\n\n        for raw_string in self.inputStrings:\n            tokens = tokenizer.tokenize(raw_string)\n            word_objects = [Word(token) for token in tokens]\n            \n            p_matching_word_objects = matcher.filter_p_words(word_objects)\n            \n            for p_word_obj in p_matching_word_objects:\n                found_p_words_text.append(p_word_obj.text)\n                if len(found_p_words_text) == 2:\n                    result = Result((found_p_words_text[0], found_p_words_text[1]))\n                    return result.as_tuple()\n        \n        # According to the design's precondition, inputs are assumed to contain at least two matching words.\n        # Therefore, this point should not be reached during normal execution, as the function will return within the loop.\n\ndef start_withp(input_list: list) -> tuple:\n    \"\"\"Returns two words from a list of words starting with 'p'.\"\"\"\n    coordinator = StartWithP(input_list)\n    return coordinator.execute()"}
{"task_id": "Mbpp/309", "solution": "def maximum(a, b):\n    \"\"\"\n    Return the larger of two numeric values a and b.\n\n    Signature (exact): maximum(a, b)\n\n    Parameters:\n    - a: int | float\n    - b: int | float\n\n    Return:\n    - the numerically greater of a and b (type: int or float as per Python semantics)\n    \"\"\"\n    if a >= b:\n        return a\n    else:\n        return b"}
{"task_id": "Mbpp/306", "solution": "class ValidationError(Exception):\n    \"\"\"Exception raised for invalid input parameters.\"\"\"\n    pass\n\ndef _validate_inputs(arr, n, i, k):\n    \"\"\"Validates input parameters for max_sum_increasing_subseq.\"\"\"\n    if arr is None or not isinstance(arr, list) or len(arr) == 0:\n        raise ValidationError('arr is empty')\n    if not isinstance(n, int) or n <= 0:\n        raise ValidationError('n must be > 0')\n    if n != len(arr):\n        raise ValidationError('n must equal len(arr)')\n    if not isinstance(i, int) or i < 0 or i >= n:\n        raise ValidationError('i out of bounds')\n    if not isinstance(k, int) or k < 0 or k >= n:\n        raise ValidationError('k out of bounds')\n    if k <= i:\n        raise ValidationError('k must be greater than i')\n\ndef _compute_prefix_best_sums(values: list[int], i: int) -> list[int]:\n    \"\"\"Computes the maximum sum of an increasing subsequence ending at each index up to i.\"\"\"\n    dp = [0] * (i + 1)\n    for j in range(i + 1):\n        dp[j] = values[j]\n        for t in range(j):\n            if values[t] < values[j] and dp[t] + values[j] > dp[j]:\n                dp[j] = dp[t] + values[j]\n    return dp\n\ndef max_sum_increasing_subseq(arr, n, i, k) -> int:\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence from arr[0...i] \n    and including the element arr[k], where k > i.\n    \"\"\"\n    _validate_inputs(arr, n, i, k)\n\n    # Compute maximum sum of increasing subsequences ending at each index j in 0..i\n    dp = _compute_prefix_best_sums(arr, i)\n\n    # Initialize best_sum with arr[k] itself, as it's the minimum possible sum.\n    # This handles the case where no prefix element can precede arr[k].\n    best_sum = arr[k]\n\n    # Iterate through the prefix elements (0 to i) to find candidates for arr[k]\n    for j in range(i + 1):\n        if arr[j] < arr[k]:\n            candidate_sum = dp[j] + arr[k]\n            best_sum = max(best_sum, candidate_sum)\n            \n    return best_sum"}
{"task_id": "Mbpp/308", "solution": "from typing import List, Sequence, Optional, Union\nfrom dataclasses import dataclass\n\n@dataclass\nclass FactorPair:\n    \"\"\"Represents a pair of numeric factors.\"\"\"\n    a: float\n    b: float\n\n    def compute_product(self) -> float:\n        \"\"\"Computes the product of the two factors.\"\"\"\n        return self.a * self.b\n\n@dataclass\nclass Product:\n    \"\"\"Holds a computed product numeric value and reference to source pair.\"\"\"\n    value: float\n    source_pair: Optional[FactorPair]\n\nclass ProductMultiset:\n    \"\"\"Manages collection of Product objects, supporting sorting and top-k selection.\"\"\"\n    def __init__(self) -> None:\n        self._products: List[Product] = []\n\n    def add(self, product: Product) -> None:\n        \"\"\"Adds a product to the collection.\"\"\"\n        self._products.append(product)\n\n    def sort_descending(self) -> None:\n        \"\"\"Sorts products in-place by value in descending order.\"\"\"\n        self._products.sort(key=lambda p: p.value, reverse=True)\n\n    def top(self, k: int) -> List[float]:\n        \"\"\"Returns numeric values of the top k products (or all if fewer).\"\"\"\n        return [p.value for p in self._products[:k]]\n\ndef large_product(list_a: Sequence[Union[int, float]], list_b: Sequence[Union[int, float]], k: int) -> List[Union[int, float]]:\n    \"\"\"\n    Finds the specified number of largest products from two given lists,\n    selecting one factor from each list.\n    \"\"\"\n    if not isinstance(k, int) or k <= 0:\n        return []\n\n    if not list_a or not list_b:\n        return []\n\n    product_multiset = ProductMultiset()\n    for a_val in list_a:\n        for b_val in list_b:\n            factor_pair = FactorPair(float(a_val), float(b_val))\n            product_value = factor_pair.compute_product()\n            product_obj = Product(value=product_value, source_pair=factor_pair)\n            product_multiset.add(product_obj)\n\n    product_multiset.sort_descending()\n    return product_multiset.top(k)"}
{"task_id": "Mbpp/310", "solution": "def string_to_tuple(input: str) -> tuple:\n    \"\"\"Convert input string to a tuple of characters excluding ASCII space characters (' ').\n\n    Parameters:\n        input (str): input string as required by FR-1.\n\n    Returns:\n        tuple: tuple of single-character strings (non-space), preserving original order.\n    \"\"\"\n    return tuple(ch for ch in input if ch != ' ')"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n):\n    \"\"\"Return the largest power of two less than or equal to n.\n    For n <= 0, this function returns 0.\n    \"\"\"\n    n |= n >> 1\n    n |= n >> 2\n    n |= n >> 4\n    n |= n >> 8\n    n |= n >> 16\n    return (n + 1) >> 1"}
{"task_id": "Mbpp/312", "solution": "import math\n\nclass MathConstants:\n    \"\"\"Provides mathematical constants.\"\"\"\n    pi: float = math.pi\n\nclass InputValidator:\n    \"\"\"Validates input types.\"\"\"\n    @staticmethod\n    def is_numeric(value) -> bool:\n        \"\"\"Return True if value is an instance of int or float.\"\"\"\n        return isinstance(value, (int, float))\n\nclass Cone:\n    \"\"\"Represents a cone and calculates its volume.\"\"\"\n    def __init__(self, radius: float, height: float):\n        self.radius = float(radius)\n        self.height = float(height)\n\n    def compute_volume(self, pi: float) -> float:\n        \"\"\"Return (1.0/3.0) * pi * (self.radius ** 2) * self.height.\"\"\"\n        return (1.0/3.0) * pi * (self.radius ** 2) * self.height\n\nclass VolumeCalculator:\n    \"\"\"Orchestrates the calculation of a cone's volume.\"\"\"\n    @staticmethod\n    def volume_cone(radius, height) -> float:\n        \"\"\"Validates inputs, creates a Cone, and computes its volume.\"\"\"\n        if not InputValidator.is_numeric(radius) or not InputValidator.is_numeric(height):\n            raise TypeError('radius and height must be numeric')\n        cone = Cone(radius, height)\n        return VolumeCalculator._compute_from_cone(cone, MathConstants.pi)\n\n    @staticmethod\n    def _compute_from_cone(cone: Cone, pi: float) -> float:\n        \"\"\"Computes the volume for a given Cone instance.\"\"\"\n        return cone.compute_volume(pi)\n\ndef volume_cone(radius, height) -> float:\n    \"\"\"Validate inputs and return (1/3) * math.pi * radius**2 * height as float.\"\"\"\n    return VolumeCalculator.volume_cone(radius, height)"}
{"task_id": "Mbpp/389", "solution": "class Validator:\n    \"\"\"Validates the input 'n' for Lucas number calculations.\"\"\"\n    def validate_n(self, n) -> None:\n        \"\"\"Raises ValueError if n is not a non-negative integer.\"\"\"\n        if not isinstance(n, int):\n            raise ValueError(\"n must be an integer\")\n        if n < 0:\n            raise ValueError(\"n must be non-negative\")\n        return None\n\nclass LucasSequence:\n    \"\"\"Calculates Lucas numbers using zero-based indexing.\"\"\"\n    BASE0 = 2\n    BASE1 = 1\n\n    def find_lucas(self, n: int) -> int:\n        \"\"\"Returns the n'th Lucas number, handling base cases directly.\"\"\"\n        if n == 0:\n            return self.BASE0\n        elif n == 1:\n            return self.BASE1\n        else:\n            return self._compute_iterative(n)\n\n    def _compute_iterative(self, n: int) -> int:\n        \"\"\"Computes the n'th Lucas number iteratively for n > 1.\"\"\"\n        prev = self.BASE0\n        curr = self.BASE1\n        for _ in range(2, n + 1):\n            prev, curr = curr, prev + curr\n        return curr\n\ndef find_lucas(n: int) -> int:\n    \"\"\"\n    Finds the n'th Lucas number using zero-based indexing (L(0)=2, L(1)=1).\n    Validates input to be a non-negative integer and computes iteratively.\n    \"\"\"\n    validator = Validator()\n    validator.validate_n(n)\n\n    engine = LucasSequence()\n    return engine.find_lucas(n)"}
{"task_id": "Mbpp/390", "solution": "def add_string(items, fmt):\n    \"\"\"Apply format pattern fmt to each element in items and return a list of strings.\n\n    The function uses standard string formatting `fmt.format(str(e))` for each element `e`.\n    \"\"\"\n    return [fmt.format(str(e)) for e in items]"}
{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(n):\n    # Sets the most significant unset bit (0) in a non-negative integer n.\n    # If n is 0, it returns 1. If all bits from MSB down to 0 are set, it returns n unchanged.\n    if n == 0:\n        return 1\n    \n    msb = n.bit_length() - 1\n    \n    for pos in range(msb, -1, -1):\n        # Check if the bit at 'pos' is unset (0)\n        if not ((n >> pos) & 1):\n            # If unset, set the bit at 'pos' and return the new number\n            return n | (1 << pos)\n            \n    # If no unset bit is found in the range from MSB down to 0, return the original number\n    return n"}
{"task_id": "Mbpp/394", "solution": "def check_distinct(t: tuple) -> bool:\n    \"\"\"Return True if tuple t contains no duplicate elements; False otherwise.\n    Preconditions: caller should provide a tuple per SRS. Behavior for non-tuple inputs is unspecified by the SRS.\n    \"\"\"\n    return len(t) == len(set(t))"}
