{"task_id": "Mbpp/245", "solution": "import math\nfrom typing import List, Iterator\n\nclass InputArray:\n    \"\"\"Represents the input ordered list of numeric elements.\"\"\"\n    def __init__(self, elements: List[float]) -> None:\n        self.elements = elements\n\n    def __iter__(self) -> Iterator[float]:\n        return iter(self.elements)\n\n    def __len__(self) -> int:\n        return len(self.elements)\n\n    def __getitem__(self, index: int) -> float:\n        return self.elements[index]\n\nclass Subsequence:\n    \"\"\"Represents an ordered subsequence and provides sum and bitonic classification.\"\"\"\n    def __init__(self, elements: List[float]) -> None:\n        self.elements = elements\n        self.length = len(elements)\n\n    def sum(self) -> float:\n        return float(sum(self.elements))\n\n    def isBitonic(self) -> bool:\n        \"\"\"\n        Determines if the subsequence is bitonic.\n        A subsequence is bitonic if it first strictly increases and then strictly decreases.\n        This definition requires at least one increasing step and one decreasing step, hence length >= 3.\n        \"\"\"\n        n = self.length\n        if n < 3:\n            return False\n\n        # Find the peak index: the point where the sequence stops strictly increasing.\n        peak_idx = 0\n        while peak_idx < n - 1 and self.elements[peak_idx] < self.elements[peak_idx + 1]:\n            peak_idx += 1\n\n        # For a sequence to be bitonic, it must have had an increasing part (peak_idx > 0)\n        # and it must have a decreasing part (peak_idx < n - 1).\n        if peak_idx == 0 or peak_idx == n - 1:\n            return False\n\n        # Check if the remaining part is strictly decreasing after the peak.\n        decreasing = True\n        for i in range(peak_idx, n - 1):\n            if self.elements[i] <= self.elements[i + 1]:\n                decreasing = False\n                break\n        return decreasing\n\nclass BitonicSubsequence(Subsequence):\n    \"\"\"Thin subclass of Subsequence used to mark bitonic subsequences for traceability.\"\"\"\n    def __init__(self, elements: List[float]) -> None:\n        super().__init__(elements)\n\nclass Result:\n    \"\"\"Value object representing computed maximum sum.\"\"\"\n    def __init__(self, maxSum: float) -> None:\n        self.maxSum = maxSum\n\nclass MaxSumFunction:\n    \"\"\"Orchestrates algorithm to compute maximum sum of any bitonic subsequence.\"\"\"\n    def max_sum(self, arr_input: InputArray) -> float:\n        elements = arr_input.elements\n        n = len(elements)\n\n        if n == 0:\n            return 0.0\n\n        # inc_sums[i] stores the maximum sum of an increasing subsequence ending at elements[i].\n        # It's initialized with elements[i] itself, meaning a subsequence of length 1.\n        inc_sums = [0.0] * n\n        for i in range(n):\n            inc_sums[i] = elements[i]\n            for j in range(i):\n                if elements[j] < elements[i]:\n                    inc_sums[i] = max(inc_sums[i], inc_sums[j] + elements[i])\n\n        # dec_sums[i] stores the maximum sum of a decreasing subsequence starting at elements[i].\n        # It's initialized with elements[i] itself, meaning a subsequence of length 1.\n        dec_sums = [0.0] * n\n        for i in range(n - 1, -1, -1):\n            dec_sums[i] = elements[i]\n            for j in range(n - 1, i, -1):\n                if elements[j] < elements[i]:\n                    dec_sums[i] = max(dec_sums[i], dec_sums[j] + elements[i])\n\n        max_bitonic_sum = 0.0\n\n        # Iterate through each element as a potential peak of a bitonic subsequence.\n        # A valid bitonic subsequence must have both an increasing part (before the peak)\n        # and a decreasing part (after the peak). This implies:\n        # 1. inc_sums[i] must be strictly greater than elements[i] (meaning an actual predecessor exists).\n        # 2. dec_sums[i] must be strictly greater than elements[i] (meaning an actual successor exists).\n        # These conditions ensure the bitonic subsequence has length at least 3.\n        for i in range(n):\n            if inc_sums[i] > elements[i] and dec_sums[i] > elements[i]:\n                current_bitonic_sum = inc_sums[i] + dec_sums[i] - elements[i]\n                max_bitonic_sum = max(max_bitonic_sum, current_bitonic_sum)\n\n        return max_bitonic_sum\n\ndef max_sum(arr: List[float]) -> float:\n    \"\"\"\n    Computes the maximum sum of a bitonic subsequence in the given array.\n    Delegates to MaxSumFunction.max_sum.\n    \"\"\"\n    input_array = InputArray([float(x) for x in arr])\n    max_sum_calculator = MaxSumFunction()\n    result = max_sum_calculator.max_sum(input_array)\n    return result"}
{"task_id": "Mbpp/251", "solution": "from typing import List, Any\n\nclass InsertElementFunction:\n    \"\"\"\n    Domain-class implementing insertion logic; stateless.\n    Iterates over the input list and builds a new list with the element inserted before each item.\n    \"\"\"\n    def execute(self, inputList: List, element: Any) -> List:\n        \"\"\"\n        Inserts the given element before each element in the input list.\n        Returns a new list with the transformed result.\n        \"\"\"\n        result_list = []\n        for item in inputList:\n            result_list.append(element)\n            result_list.append(item)\n        return result_list\n\ndef insert_element(inputList: List, element: Any) -> List:\n    \"\"\"\n    Inserts an element before each element in a list and returns the resulting list.\n    Delegates the core logic to InsertElementFunction.\n    \"\"\"\n    return InsertElementFunction().execute(inputList, element)"}
{"task_id": "Mbpp/247", "solution": "from typing import Any\n\ndef validateInput(input: Any) -> None:\n    \"\"\"Validates the input is a string. Raises TypeError for non-string input.\"\"\"\n    if not isinstance(input, str):\n        raise TypeError(\"input must be a string\")\n\ndef computeLPS(input: str) -> int:\n    \"\"\"Computes the length of the longest palindromic subsequence using dynamic programming.\"\"\"\n    n = len(input)\n    if n == 0:\n        return 0\n\n    # dp[i][j] stores the length of the LPS for substring input[i...j]\n    dp = [[0 for _ in range(n)] for _ in range(n)]\n\n    # All single characters are palindromes of length 1\n    for i in range(n):\n        dp[i][i] = 1\n\n    # Fill the table for lengths from 2 to n\n    for length in range(2, n + 1):\n        for i in range(n - length + 1):\n            j = i + length - 1\n            if input[i] == input[j]:\n                if length == 2:\n                    dp[i][j] = 2\n                else:\n                    # If characters match, add 2 to LPS of the inner substring\n                    dp[i][j] = dp[i + 1][j - 1] + 2\n            else:\n                # If characters don't match, take the maximum of excluding s[i] or s[j]\n                dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])\n    \n    return dp[0][n - 1]\n\ndef lps(input: Any) -> int:\n    \"\"\"\n    Calculates the length of the longest palindromic subsequence in the given string.\n    Raises TypeError if input is not a string, returns 0 for an empty string.\n    \"\"\"\n    validateInput(input)\n\n    if input == \"\":\n        return 0\n        \n    return computeLPS(input)"}
{"task_id": "Mbpp/252", "solution": "import math\nfrom typing import Tuple\n\ndef convert(input) -> Tuple[float, float]:\n    \"\"\"Converts a numeric value (int, float, or complex) to polar coordinates (magnitude, angle).\"\"\"\n    if isinstance(input, complex):\n        real = input.real\n        imag = input.imag\n    else:\n        real = float(input)\n        imag = 0.0\n\n    r = math.sqrt(real * real + imag * imag)\n    theta = math.atan2(imag, real)\n\n    return (float(r), float(theta))"}
{"task_id": "Mbpp/253", "solution": "from typing import Any\ndef count_integer(input_list: list[Any]) -> int:\n    \"\"\"Count number of elements in input_list that are instances of Python's int type.\n\n    Raises:\n        TypeError: if input_list is not an instance of list.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"input_list must be a list\")\n    count = 0\n    for element in input_list:\n        if isinstance(element, int):\n            count += 1\n    return count"}
{"task_id": "Mbpp/255", "solution": "from typing import List, Tuple, Any\n\ndef combinations_colors(input_list: List[Any], n: int) -> List[Tuple]:\n    \"\"\"\n    Generates all combinations (with repetition) of elements from the input list\n    and returns a list of tuples, each representing a combination.\n    \"\"\"\n    # Handle edge case for n == 0: a single empty tuple combination.\n    if n == 0:\n        return [()]\n\n    # Handle edge case for an empty input list when n > 0: no combinations possible.\n    if not input_list:\n        return []\n\n    result: List[Tuple] = []\n    \n    # Recursive helper function to build combinations.\n    def generate_recursive(current_combination_tuple: Tuple):\n        if len(current_combination_tuple) == n:\n            result.append(current_combination_tuple)\n            return\n\n        for item in input_list:\n            generate_recursive(current_combination_tuple + (item,))\n\n    generate_recursive(())\n    return result"}
{"task_id": "Mbpp/256", "solution": "import numbers\nimport math\nfrom dataclasses import dataclass\n\ndef _is_prime(k: int) -> bool:\n    \"\"\"Checks if an integer k is prime using trial division.\"\"\"\n    if k < 2:\n        return False\n    if k == 2:\n        return True\n    if k % 2 == 0:\n        return False\n    for i in range(3, int(math.sqrt(k)) + 1, 2):\n        if k % i == 0:\n            return False\n    return True\n\n@dataclass\nclass Result:\n    \"\"\"Holds the integer result value.\"\"\"\n    value: int\n\nclass InputValidator:\n    \"\"\"Validates if the input number is non-negative.\"\"\"\n    def validateNonNegative(self, n: 'numbers.Real') -> bool:\n        return n >= 0\n\nclass PrimeCounter:\n    \"\"\"Computes the number of prime integers less than a given number.\"\"\"\n    def count_Primes_nums(self, n: 'numbers.Real') -> Result:\n        prime_count = 0\n        # Iterates k in range(2, int(floor(n))) as specified in design, which is exclusive of int(floor(n)).\n        upper_bound_exclusive = int(math.floor(n))\n        for k in range(2, upper_bound_exclusive):\n            if _is_prime(k):\n                prime_count += 1\n        return Result(prime_count)\n\ndef count_Primes_nums(n: 'numbers.Real') -> int:\n    \"\"\"\n    Counts the number of prime numbers strictly less than n.\n    Handles non-negative real numbers as input according to design.\n    \"\"\"\n    if n < 2:\n        return 0\n\n    prime_counter_calculator = PrimeCounter()\n    result_obj = prime_counter_calculator.count_Primes_nums(n)\n    return result_obj.value"}
