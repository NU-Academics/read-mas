{"task_id": "Mbpp/14", "solution": "def find_Volume(base, triangle_height, prism_length):\n    \"\"\"\n    Calculates the volume of a triangular prism.\n    It uses helper functions to compute the triangular base area and then the prism volume.\n    \"\"\"\n    def compute_triangular_base_area(base, triangle_height):\n        \"\"\"Calculates the area of the triangular base.\"\"\"\n        return 0.5 * base * triangle_height\n\n    def compute_prism_volume(triangular_base_area, prism_length):\n        \"\"\"Calculates the volume of the prism given its base area and length.\"\"\"\n        return triangular_base_area * prism_length\n\n    triangular_base_area = compute_triangular_base_area(base, triangle_height)\n    volume = compute_prism_volume(triangular_base_area, prism_length)\n    return volume"}
{"task_id": "Mbpp/18", "solution": "def _chars_to_set(chars_to_remove: str) -> set[str]:\n    \"\"\"Converts a string of characters into a set of unique characters.\"\"\"\n    return set(chars_to_remove)\n\ndef remove_dirty_chars(source: str, chars_to_remove: str) -> str:\n    \"\"\"\n    Removes characters from the source string that are present in the chars_to_remove string.\n    The order of remaining characters in the source string is preserved.\n    \"\"\"\n    chars_to_remove_set = _chars_to_set(chars_to_remove)\n    \n    result_chars = []\n    for char in source:\n        if char not in chars_to_remove_set:\n            result_chars.append(char)\n            \n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/12", "solution": "from typing import List, Union\n\n# Define Number type as per design context\nNumber = Union[int, float]\n\n# Define Row class as per design context, as sort_matrix uses it\nclass Row:\n    \"\"\"Wraps a list of numeric elements, computes sum and length.\"\"\"\n    def __init__(self, elements: List[Number], original_index: int):\n        self.elements = elements\n        self.original_index = original_index\n\n    def sum(self) -> Number:\n        \"\"\"Returns the arithmetic sum of the elements in the row.\"\"\"\n        return sum(self.elements)\n\n    def length(self) -> int:\n        \"\"\"Returns the number of elements in the row.\"\"\"\n        return len(self.elements)\n\ndef sort_matrix(matrix: List[List[Number]]) -> List[List[Number]]:\n    \"\"\"\n    Sorts a given matrix in ascending order according to the sum of its rows.\n    \"\"\"\n    # Create Row wrapper objects for each row in the input matrix,\n    # preserving the original row and its index.\n    rows_with_wrappers = [Row(elements=row, original_index=idx) for idx, row in enumerate(matrix)]\n\n    # Sort the Row wrapper objects based on their sum.\n    # Python's `sorted()` is stable by default, fulfilling the requirement\n    # that equal-sum rows preserve their original relative order.\n    sorted_rows_wrappers = sorted(rows_with_wrappers, key=lambda r: r.sum())\n\n    # Construct the result matrix from the sorted Row wrappers.\n    # This creates a new outer list and uses the original inner row lists,\n    # ensuring the input matrix itself is not mutated and element order within rows is preserved.\n    result_matrix = [row_wrapper.elements for row_wrapper in sorted_rows_wrappers]\n\n    return result_matrix"}
{"task_id": "Mbpp/19", "solution": "from typing import List, Union\n\n# Define IntegerArray and is_integer_array inline as per the instruction\n# \"DO NOT call any helper that is not defined inline in your response\".\n# The design document indicates these would typically be in a separate 'types' module,\n# but for this response, they are placed here.\n\nIntegerArray = List[int]\n\ndef is_integer_array(arr: Union[list, tuple]) -> bool:\n    \"\"\"\n    Checks if the input is a sequence (list or tuple) containing only integers.\n    \"\"\"\n    if not isinstance(arr, (list, tuple)):\n        return False\n    for item in arr:\n        if not isinstance(item, int):\n            return False\n    return True\n\ndef test_duplicate(arr: IntegerArray) -> bool:\n    \"\"\"\n    Checks if an array of integers contains any duplicate element.\n    Raises TypeError if input is not an array of integers as per design.\n    \"\"\"\n    if not is_integer_array(arr):\n        raise TypeError(\"Input must be an array of integers\")\n\n    seen = set()\n    for x in arr:\n        if x in seen:\n            return True\n        seen.add(x)\n    return False"}
{"task_id": "Mbpp/56", "solution": "from typing import List\n\nclass Number:\n    \"\"\"Represent an integer input and provide digit-level accessors.\"\"\"\n    value: int\n\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def getDigits(self) -> List[int]:\n        \"\"\"Returns base-10 digits of the absolute value, most-significant-first.\"\"\"\n        abs_value = abs(self.value)\n        if abs_value == 0:\n            return [0]\n        return [int(d) for d in str(abs_value)]\n\n    def toString(self) -> str:\n        \"\"\"Returns the decimal string representation of the number.\"\"\"\n        return str(self.value)\n\nclass ReverseCalculator:\n    \"\"\"Compute integer obtained by reversing the base-10 digits of a provided integer.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def computeReverse(self, n: int) -> int:\n        \"\"\"Returns integer of reversed digits; leading zeros in reversed representation are dropped.\"\"\"\n        is_negative = n < 0\n        \n        number_obj = Number(n) # Number's getDigits will operate on abs(value)\n        digits = number_obj.getDigits()\n        \n        reversed_digits = digits[::-1]\n        \n        # Convert reversed digits back to an integer, handling leading zeros\n        reversed_str = \"\".join(map(str, reversed_digits))\n        reversed_int = int(reversed_str)\n        \n        return -reversed_int if is_negative else reversed_int\n\ndef check(n: int) -> bool:\n    \"\"\"Return True iff n == 2 * reverse(n) - 1\"\"\"\n    calculator = ReverseCalculator()\n    reversed_n = calculator.computeReverse(n)\n    return n == (2 * reversed_n - 1)"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(number):\n    \"\"\"\n    Checks if the given number is a Woodall number.\n    A Woodall number X is defined as n * 2^n - 1 for some integer n >= 1.\n    \"\"\"\n    if number < 1:\n        return False\n\n    n = 1\n    while True:\n        computed_value = n * (2 ** n) - 1\n        if computed_value == number:\n            return True\n        if computed_value > number:\n            return False\n        n += 1"}
{"task_id": "Mbpp/58", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass IntegerPair:\n    a: int\n    b: int\n\n@dataclass\nclass Result:\n    isOpposite: bool\n\nclass OppositeSignsService:\n    \"\"\"Service to determine if two integers have opposite signs.\"\"\"\n    @staticmethod\n    def opposite_Signs(a: int, b: int) -> bool:\n        \"\"\"\n        Checks if two integers have opposite signs.\n        Returns True if one is positive and the other negative; otherwise False.\n        \"\"\"\n        return (a > 0 and b < 0) or (a < 0 and b > 0)\n\ndef opposite_Signs(a: int, b: int) -> bool:\n    \"\"\"\n    Checks if two integers have opposite signs.\n    Delegates the logic to OppositeSignsService.\n    \"\"\"\n    return OppositeSignsService.opposite_Signs(a, b)"}
{"task_id": "Mbpp/62", "solution": "def smallest_num(list_of_numbers):\n    \"\"\"\n    Return the smallest numeric value from list_of_numbers.\n\n    Parameters:\n        list_of_numbers: list-like container of numeric values\n    Returns:\n        numeric value (int or float) equal to the smallest element in the list\n    Raises:\n        ValueError if list_of_numbers is empty\n    \"\"\"\n    if not list_of_numbers:\n        raise ValueError(\"Input list cannot be empty.\")\n    return min(list_of_numbers)"}
{"task_id": "Mbpp/59", "solution": "class InputValidator:\n    \"\"\"Validates that n is an integer and n >= 1.\"\"\"\n    def validate(self, n) -> bool:\n        \"\"\"Returns True if n is a positive integer, False otherwise.\"\"\"\n        return isinstance(n, int) and n >= 1\n\nclass OctagonalNumber:\n    \"\"\"Encapsulates the octagonal number formula and computation.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n        self.value = None\n\n    def compute(self) -> int:\n        \"\"\"Computes and returns the nth octagonal number.\"\"\"\n        self.value = 3 * (self.n ** 2) - 2 * self.n\n        return int(self.value)\n\nclass IsOctagonalFunction:\n    \"\"\"Orchestrates input validation and octagonal number computation.\"\"\"\n    def is_octagonal(self, n: int) -> int:\n        \"\"\"Validates input n and computes the nth octagonal number.\"\"\"\n        validator = InputValidator()\n        if not validator.validate(n):\n            raise ValueError(\"n must be an integer >= 1\")\n        oct_n = OctagonalNumber(n)\n        return oct_n.compute()\n\ndef is_octagonal(n):\n    \"\"\"\n    Computes and returns the nth octagonal number.\n    Raises ValueError if n is not an integer or is less than 1.\n    \"\"\"\n    return IsOctagonalFunction().is_octagonal(n)"}
{"task_id": "Mbpp/57", "solution": "from typing import List\nfrom dataclasses import dataclass\n\nclass Validator:\n    \"\"\"Responsibility: Validate that input is a list of integer digits in range 0..9.\"\"\"\n    def validate_digits(self, digits: list) -> bool:\n        \"\"\"Returns True if valid; raises ValueError on invalid input.\"\"\"\n        if not isinstance(digits, list):\n            raise ValueError(\"Input must be a list.\")\n        \n        # An empty list is considered valid input, representing the number 0.\n        if not digits:\n            return True\n\n        for digit in digits:\n            if not isinstance(digit, int):\n                raise ValueError(f\"All elements in the list must be integers, but found type '{type(digit).__name__}'.\")\n            if not (0 <= digit <= 9):\n                raise ValueError(f\"All elements must be single digits (0-9), but found {digit}.\")\n        return True\n\nclass Sorter:\n    \"\"\"Responsibility: Sort digits in descending order to maximize numeric concatenation.\"\"\"\n    def sort_descending(self, digits: List[int]) -> List[int]:\n        \"\"\"Sorts a list of single-digit integers in descending order.\"\"\"\n        return sorted(digits, reverse=True)\n\nclass Concatenator:\n    \"\"\"Responsibility: Concatenate a list of single-digit integers into an integer.\"\"\"\n    def concatenate(self, digits: List[int]) -> int:\n        \"\"\"Converts a list of integers into a single integer by concatenation.\"\"\"\n        if not digits:\n            return 0 # If no digits, the formed number is 0.\n\n        # Convert each digit to a string, join them, and convert back to an integer.\n        return int(\"\".join(str(d) for d in digits))\n\n@dataclass\nclass Digit:\n    \"\"\"Lightweight representation of a single digit (0..9).\"\"\"\n    value: int\n\n@dataclass\nclass ResultNumber:\n    \"\"\"Lightweight representation of the integer result.\"\"\"\n    value: int\n\ndef find_Max_Num(digits: list) -> int:\n    \"\"\"Validate digits, compute and return largest integer formed by concatenation.\"\"\"\n    validator = Validator()\n    sorter = Sorter()\n    concatenator = Concatenator()\n\n    # 1. Validate the input list of digits.\n    validator.validate_digits(digits)\n\n    # 2. Sort the digits in descending order to form the largest number.\n    sorted_digits = sorter.sort_descending(digits)\n\n    # 3. Concatenate the sorted digits into a single integer.\n    result_int = concatenator.concatenate(sorted_digits)\n\n    return result_int"}
{"task_id": "Mbpp/65", "solution": "def recursive_list_sum(inputList):\n    \"\"\"\n    Recursively flattens a list and sums all of its integer elements.\n    Assumes elements are either integers or nested lists containing integers or further nested lists.\n    \"\"\"\n    total_sum = 0\n    for item in inputList:\n        if isinstance(item, list):\n            total_sum += recursive_list_sum(item)\n        else:\n            total_sum += item\n    return total_sum"}
{"task_id": "Mbpp/63", "solution": "def max_difference(tuples: list[tuple]) -> int:\n    \"\"\"\n    Calculates the maximum absolute difference between elements in each pair of the given tuple list.\n    Returns the largest such difference as an integer.\n    \"\"\"\n    if not tuples:\n        return 0\n\n    max_diff = 0\n    for a, b in tuples:\n        current_diff = abs(a - b)\n        if current_diff > max_diff:\n            max_diff = current_diff\n\n    return max_diff"}
{"task_id": "Mbpp/61", "solution": "def count_Substrings(s: str) -> int:\n    \"\"\"\n    Counts the number of contiguous substrings in a digit string where\n    the sum of the digits in the substring equals its length.\n    \"\"\"\n    if not s.isdigit() and s != \"\":\n        raise ValueError(\"Input string must contain only digits.\")\n\n    match_count = 0\n    n = len(s)\n\n    for i in range(n):\n        current_sum = 0\n        for j in range(i, n):\n            current_sum += int(s[j])\n            current_length = j - i + 1\n            if current_sum == current_length:\n                match_count += 1\n    return match_count"}
{"task_id": "Mbpp/64", "solution": "from typing import List, Tuple\n\ndef subject_marks(input_list: List[Tuple[str, int]]) -> List[Tuple[str, int]]:\n    \"\"\"\n    Sorts a list of tuples by the second element of each tuple.\n    Raises TypeError or ValueError for malformed inputs.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError('input_list must be a list')\n\n    for idx, e in enumerate(input_list):\n        if not isinstance(e, tuple):\n            raise TypeError(f'element at index {idx} must be a tuple')\n        if len(e) != 2:\n            raise ValueError(f'tuple at index {idx} must be length 2')\n        if not isinstance(e[0], str):\n            raise TypeError(f'tuple[0] at index {idx} must be str')\n        if not isinstance(e[1], (int, float)):\n            raise TypeError(f'tuple[1] at index {idx} must be numeric (int or float)')\n\n    return sorted(input_list, key=lambda t: t[1])"}
{"task_id": "Mbpp/66", "solution": "def pos_count(lst):\n    \"\"\"Return the number of elements in lst that are strictly greater than 0.\n\n    Parameters:\n      lst: expected to be a Python list of numeric elements (int/float).\n    \"\"\"\n    count = 0\n    for element in lst:\n        if element > 0:\n            count += 1\n    return count"}
{"task_id": "Mbpp/70", "solution": "from typing import Iterable, Sequence, List, Tuple as TypingTuple, Any\n\nclass Tuple:\n    \"\"\"\n    Wrapper for a native tuple, providing its length.\n    \"\"\"\n    def __init__(self, elements: TypingTuple[Any, ...]) -> None:\n        self._elements = elements\n\n    def length(self) -> int:\n        \"\"\"\n        Returns the length of the encapsulated tuple.\n        \"\"\"\n        return len(self._elements)\n\nclass TupleCollection:\n    \"\"\"\n    A collection of Tuple objects, providing methods to count and get all lengths.\n    \"\"\"\n    def __init__(self, items: Iterable[TypingTuple[Any, ...]]) -> None:\n        self._tuples: List[Tuple] = [Tuple(item) for item in items]\n\n    def count(self) -> int:\n        \"\"\"\n        Returns the number of tuples in the collection.\n        \"\"\"\n        return len(self._tuples)\n\n    def get_lengths(self) -> List[int]:\n        \"\"\"\n        Returns a list of lengths for all tuples in the collection.\n        \"\"\"\n        return [t.length() for t in self._tuples]\n\nclass Result:\n    \"\"\"\n    A simple value object to hold the boolean outcome.\n    \"\"\"\n    def __init__(self, value: bool) -> None:\n        self.value = value\n\nclass GetEqualService:\n    \"\"\"\n    Service responsible for determining if all tuples in a collection have equal length.\n    \"\"\"\n    def get_equal(self, items: Iterable[TypingTuple[Any, ...]]) -> bool:\n        \"\"\"\n        Checks if all tuples in the given collection have equal length.\n        \"\"\"\n        collection = TupleCollection(items)\n        lengths = collection.get_lengths()\n        \n        # If the collection is empty or contains only one tuple, all lengths are considered equal.\n        # Otherwise, check if all lengths are the same by converting to a set.\n        are_all_equal = len(set(lengths)) <= 1\n        \n        result = Result(are_all_equal)\n        return result.value\n\ndef get_equal(items: Iterable[TypingTuple[Any, ...]]) -> bool:\n    \"\"\"\n    Determines whether all tuples in the given collection have equal length.\n    Returns True if all tuple lengths are the same, False otherwise.\n    \"\"\"\n    service = GetEqualService()\n    return service.get_equal(items)"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(haystack, sublist):\n    \"\"\"Return True if `sublist` occurs as a contiguous subsequence in `haystack`; otherwise False.\n\n    Must not modify `haystack` or `sublist`.\n    \"\"\"\n    len_haystack = len(haystack)\n    len_sublist = len(sublist)\n\n    if len_sublist > len_haystack:\n        return False\n    \n    # An empty sublist is considered a sublist of any list, including an empty one.\n    # The loop below naturally handles this: if len_sublist is 0,\n    # then range(len_haystack + 1) will run, and haystack[i:i] (which is []) == [] will be true.\n    \n    for i in range(len_haystack - len_sublist + 1):\n        if haystack[i : i + len_sublist] == sublist:\n            return True\n            \n    return False"}
{"task_id": "Mbpp/67", "solution": "class Error(Exception):\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n\nclass InputValidator:\n    def validate(self, n: int) -> None:\n        \"\"\"Validates that n is a non-negative integer.\"\"\"\n        if not isinstance(n, int):\n            raise Error(\"Input 'n' must be an integer.\")\n        if n < 0:\n            raise Error(\"Input 'n' must be a non-negative integer.\")\n\nclass BellCalculator:\n    _cache = {}\n\n    def bell_number(self, n: int) -> int:\n        \"\"\"Computes the nth Bell number, utilizing a cache.\"\"\"\n        if n in self._cache:\n            return self._cache[n]\n        \n        result = self.compute_by_dp(n)\n        self._cache[n] = result\n        return result\n\n    def compute_by_dp(self, n: int) -> int:\n        \"\"\"\n        Computes the nth Bell number using dynamic programming based on Stirling numbers of the second kind.\n        B_n = sum_{k=0 to n} S(n, k)\n        \"\"\"\n        if n == 0:\n            return 1\n\n        # stirling[i][j] will store S(i, j)\n        stirling = [[0] * (n + 1) for _ in range(n + 1)]\n\n        # Base case S(0,0) = 1\n        stirling[0][0] = 1\n\n        for i in range(1, n + 1):\n            for j in range(1, i + 1):\n                if j == i:\n                    stirling[i][j] = 1 # S(i, i) = 1\n                else:\n                    stirling[i][j] = stirling[i-1][j-1] + j * stirling[i-1][j]\n        \n        # Bell number B_n is the sum of S(n, k) for k from 0 to n\n        bell_n = sum(stirling[n][k] for k in range(n + 1))\n        return bell_n\n\ndef bell_number(n: int) -> int:\n    \"\"\"\n    Computes the nth Bell number, representing the number of ways\n    to partition a set of n elements.\n    \"\"\"\n    validator = InputValidator()\n    validator.validate(n)\n    \n    calculator = BellCalculator()\n    return calculator.bell_number(n)"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(arr):\n    \"\"\"\n    Checks if the given array is monotonic (either entirely non-increasing or entirely non-decreasing).\n    Equality of adjacent elements is allowed.\n    \"\"\"\n\n    def _is_non_decreasing(array):\n        # Returns True if the array is non-decreasing (each element is less than or equal to the next).\n        for i in range(len(array) - 1):\n            if array[i] > array[i+1]:\n                return False\n        return True\n\n    def _is_non_increasing(array):\n        # Returns True if the array is non-increasing (each element is greater than or equal to the next).\n        for i in range(len(array) - 1):\n            if array[i] < array[i+1]:\n                return False\n        return True\n\n    if len(arr) <= 1:\n        return True\n\n    return _is_non_decreasing(arr) or _is_non_increasing(arr)"}
{"task_id": "Mbpp/72", "solution": "class InputNumber:\n    \"\"\"Validates and stores an integer input n. Raises TypeError for non-integer inputs.\"\"\"\n    def __init__(self, n: int) -> None:\n        if not isinstance(n, int):\n            raise TypeError(\"dif_Square expects an integer input\")\n        self.value = n\n\nclass Result:\n    \"\"\"Value object representing a boolean outcome.\"\"\"\n    def __init__(self, can_be: bool) -> None:\n        self.canBeDifference = bool(can_be)\n\nclass ModuloChecker:\n    \"\"\"Encapsulates the modulo-4 business rule.\"\"\"\n    @staticmethod\n    def check_mod4(n: int) -> bool:\n        \"\"\"Returns False if n % 4 == 2, otherwise True.\"\"\"\n        return not (n % 4 == 2)\n\nclass DifSquareFunction:\n    \"\"\"Orchestrates input validation and business-rule checks.\"\"\"\n    @staticmethod\n    def dif_Square(n: int) -> bool:\n        \"\"\"Determines if an integer can be represented as a difference of two squares.\"\"\"\n        inp = InputNumber(n)\n        ok = ModuloChecker.check_mod4(inp.value)\n        return Result(ok).canBeDifference\n\ndef dif_Square(n: int) -> bool:\n    \"\"\"\n    Checks if the given number can be represented as the difference of two squares.\n    Raises TypeError for non-integer inputs.\n    \"\"\"\n    return DifSquareFunction.dif_Square(n)"}
{"task_id": "Mbpp/74", "solution": "import typing\n\nclass Sequence:\n    \"\"\"Represents an ordered collection of sequence input.\"\"\"\n    def __init__(self, elements: typing.List[typing.Any]):\n        self.elements = elements\n\n    def length(self) -> int:\n        return len(self.elements)\n\n    def get(self, index: int) -> typing.Any:\n        return self.elements[index]\n\nclass Pattern:\n    \"\"\"Represents an ordered collection of pattern input.\"\"\"\n    def __init__(self, elements: typing.List[typing.Any]):\n        self.elements = elements\n\n    def length(self) -> int:\n        return len(self.elements)\n\n    def get(self, index: int) -> typing.Any:\n        return self.elements[index]\n\nclass Mapping:\n    \"\"\"Manages mapping pattern element -> sequence element and enforces injectivity.\"\"\"\n    def __init__(self):\n        self.map: typing.Dict[typing.Any, typing.Any] = {}\n        self.used_values: typing.Set[typing.Any] = set()\n\n    def add(self, pattern_elem: typing.Any, seq_elem: typing.Any) -> bool:\n        \"\"\"Adds a mapping, returning False on conflict (inconsistent mapping or injective violation).\"\"\"\n        if pattern_elem in self.map:\n            # Check for inconsistent mapping\n            return self.map[pattern_elem] == seq_elem\n        else:\n            # Check for injective violation\n            if seq_elem in self.used_values:\n                return False\n            self.map[pattern_elem] = seq_elem\n            self.used_values.add(seq_elem)\n            return True\n\n    def get(self, pattern_elem: typing.Any) -> typing.Optional[typing.Any]:\n        return self.map.get(pattern_elem)\n\n    def contains_value(self, seq_elem: typing.Any) -> bool:\n        return seq_elem in self.used_values\n\nclass Result:\n    \"\"\"A wrapper for a boolean result.\"\"\"\n    def __init__(self, value: bool):\n        self.value = value\n\n    def get(self) -> bool:\n        return self.value\n\nclass PatternMatcher:\n    \"\"\"Encapsulates the matching algorithm and implements is_samepatterns behavior.\"\"\"\n    def is_samepatterns(self, sequence_list: typing.List[typing.Any], pattern_list: typing.List[typing.Any]) -> bool:\n        seq = Sequence(sequence_list)\n        pat = Pattern(pattern_list)\n\n        if not self._validate_lengths(seq, pat):\n            return False\n\n        mapping = self._build_mapping(seq, pat)\n        if mapping is None:\n            return False\n\n        # The Mapping.add method already enforces injectivity and consistency during build.\n        # The checkInjective method is no longer strictly necessary if buildMapping is robust.\n        # But for traceability/explicitness as per design:\n        # if not self._check_injective(mapping):\n        #     return False\n\n        return True\n\n    def _validate_lengths(self, sequence: Sequence, pattern: Pattern) -> bool:\n        \"\"\"Validates that sequence and pattern have the same length.\"\"\"\n        return sequence.length() == pattern.length()\n\n    def _build_mapping(self, sequence: Sequence, pattern: Pattern) -> typing.Optional[Mapping]:\n        \"\"\"Builds the mapping from pattern elements to sequence elements, enforcing consistency and injectivity.\"\"\"\n        mapping = Mapping()\n        for i in range(sequence.length()):\n            pattern_elem = pattern.get(i)\n            seq_elem = sequence.get(i)\n\n            if not mapping.add(pattern_elem, seq_elem):\n                return None # Inconsistent mapping or injective violation detected\n\n        return mapping\n\n    def _check_injective(self, mapping: Mapping) -> bool:\n        \"\"\"Checks if the mapping is injective (distinct pattern elements map to distinct sequence elements).\n        Note: The Mapping.add method already enforces this during construction.\"\"\"\n        # This method is primarily for conceptual completeness as the add method handles it.\n        # It could perform an additional check by ensuring len(mapping.map) == len(mapping.used_values)\n        # if pattern_elements are guaranteed to be distinct (which they are not in the general case).\n        # Given the `add` method's behavior, this method should always return True if buildMapping succeeded.\n        return True\n\ndef is_samepatterns(sequence: typing.List[typing.Any], pattern: typing.List[typing.Any]) -> bool:\n    \"\"\"\n    Checks whether a sequence follows the pattern given in the patterns array.\n    This function delegates the actual logic to an internal PatternMatcher instance.\n    \"\"\"\n    matcher = PatternMatcher()\n    return matcher.is_samepatterns(sequence, pattern)"}
{"task_id": "Mbpp/71", "solution": "class CombSortAlgorithm:\n    \"\"\"Encapsulates comb sort parameters and provides gap sequence generation.\"\"\"\n    def __init__(self, shrinkFactor: float = 1.3):\n        self.shrinkFactor = shrinkFactor\n\n    def gapSequence(self, length: int):\n        \"\"\"Yields integer gaps reducing from an initial calculated gap down to 1.\"\"\"\n        gap = length\n        while True:\n            gap = int(gap / self.shrinkFactor)\n            if gap < 1:\n                gap = 1\n            yield gap\n            if gap == 1:\n                break # Sequence has reached 1, stop generating further gaps.\n\ndef comb_sort(lst):\n    \"\"\"Sorts `lst` using comb sort and returns a sorted list.\"\"\"\n    if not lst:\n        return []\n\n    arr = list(lst)\n    n = len(arr)\n\n    if n <= 1:\n        return arr\n\n    algorithm = CombSortAlgorithm()\n\n    # The outer loop of Comb Sort manages gap reduction and repeats gap=1 passes.\n    gap = n\n    swapped = True # Ensures the loop runs at least once\n\n    while gap > 1 or swapped:\n        # Calculate the next gap based on the shrink factor.\n        # This step implicitly uses the CombSortAlgorithm's shrinkFactor.\n        gap = int(gap / algorithm.shrinkFactor)\n        if gap < 1:\n            gap = 1\n\n        swapped = False # Reset for the current pass\n\n        # Perform a pass (comparison and swapping) for the current gap\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True\n                \n    return arr"}
{"task_id": "Mbpp/75", "solution": "def find_tuples(input_list, k):\n    \"\"\"Return a list of tuples from input_list where every element is divisible by k.\n\n    Parameters:\n      input_list: list of tuples (each tuple consisting of integer elements) -- per SRS assumptions\n      k: int (divisor)\n\n    Returns:\n      list of tuples (subset of input_list) preserving relative order\n    \"\"\"\n    result = []\n    for tpl in input_list:\n        all_divisible = True\n        for element in tpl:\n            if element % k != 0:\n                all_divisible = False\n                break\n        if all_divisible:\n            result.append(tpl)\n    return result"}
