{"task_id": "Mbpp/116", "solution": "from dataclasses import dataclass\n\n@dataclass\nclass TupleInput:\n    elements: tuple[int, ...]\n\n@dataclass\nclass IntegerResult:\n    value: int\n\nclass TupleConverter:\n    \"\"\"\n    Validates and converts a TupleInput into an IntegerResult by concatenating elements.\n    Raises ValueError for invalid inputs.\n    \"\"\"\n    def tuple_to_int(self, tuple_input: TupleInput) -> IntegerResult:\n        if not isinstance(tuple_input.elements, tuple):\n            raise ValueError(\"invalid input: must be a tuple of positive integers\")\n        \n        if not tuple_input.elements:\n            raise ValueError(\"invalid input: empty tuple is not allowed\")\n\n        for element in tuple_input.elements:\n            if not isinstance(element, int) or element <= 0:\n                raise ValueError(\"invalid input: all elements must be positive integers\")\n        \n        str_elements = [str(e) for e in tuple_input.elements]\n        concatenated_string = \"\".join(str_elements)\n        result_int = int(concatenated_string)\n        \n        return IntegerResult(value=result_int)\n\ndef tuple_to_int(tuple_input) -> int:\n    \"\"\"\n    Converts a tuple of positive integers into a single integer.\n    Raises ValueError for invalid inputs.\n    \"\"\"\n    domain_tuple_input = TupleInput(elements=tuple_input)\n    converter = TupleConverter()\n    integer_result = converter.tuple_to_int(domain_tuple_input)\n    return integer_result.value"}
{"task_id": "Mbpp/109", "solution": "class BinaryString:\n    def __init__(self, value):\n        self.value = value\n        self.length = len(value)\n\n    def get_char(self, pos) -> str:\n        \"\"\"Returns the character at the specified position.\"\"\"\n        return self.value[pos]\n\n\nclass Validator:\n    def validate_binary_string(self, s):\n        \"\"\"Validates if s is a non-empty string composed only of '0' and '1'.\"\"\"\n        if not isinstance(s, str):\n            raise ValueError(\"s must be a string\")\n        if not s:\n            raise ValueError(\"s must be non-empty\")\n        if not all(char in '01' for char in s):\n            raise ValueError(\"s must only contain '0' or '1'\")\n\n    def validate_non_negative_int(self, k):\n        \"\"\"Validates if k is a non-negative integer.\"\"\"\n        if not isinstance(k, int):\n            raise ValueError(\"k must be an integer\")\n        if k < 0:\n            raise ValueError(\"k must be non-negative\")\n\n\nclass RotationEngine:\n    def rotate_left(self, s, shift) -> str:\n        \"\"\"Rotates string s left by 'shift' positions.\"\"\"\n        n = len(s)\n        if n == 0:\n            return \"\"\n        effective_shift = shift % n\n        return s[effective_shift:] + s[:effective_shift]\n\n    def period(self, s) -> int:\n        \"\"\"Returns the length of the string, which is the rotation period.\"\"\"\n        return len(s)\n\n\nclass ParityChecker:\n    def is_odd(self, binary_str) -> bool:\n        \"\"\"Determines if a binary string interpreted as an integer is odd.\"\"\"\n        if not binary_str:\n            return False\n        return binary_str[-1] == '1'\n\n\nclass Counter:\n    def count_odds(self, s, k) -> int:\n        \"\"\"Counts odd rotations among the first k cyclic left-rotations of s.\"\"\"\n        n = len(s)\n        if n == 0 or k == 0:\n            return 0\n\n        # The number of '1's in 's' is the count of odd rotations in one full period.\n        odd_count_in_period = s.count('1')\n\n        full_periods = k // n\n        remainder_rotations = k % n\n\n        total_odd_count = full_periods * odd_count_in_period\n\n        # For the remaining rotations (from 0 to remainder_rotations - 1),\n        # the least significant bit (LSB) of rotation 'r' is s[(r - 1 + n) % n].\n        for r in range(remainder_rotations):\n            lsb_index = (r - 1 + n) % n\n            if s[lsb_index] == '1':\n                total_odd_count += 1\n        \n        return total_odd_count\n\n\nclass Result:\n    def __init__(self, odd_count):\n        self.odd_count = odd_count\n\n\ndef odd_Equivalent(s, k):\n    \"\"\"\n    Counts how many of the first k cyclic left-rotations of a binary string s\n    evaluate to an odd integer.\n\n    Parameters:\n        s (str): A non-empty binary string composed only of characters '0' and '1'.\n        k (int): A non-negative integer specifying the number of rotations to evaluate,\n                 covering rotations indexed 0 to k-1 (rotation 0 is the original string).\n\n    Returns:\n        int: The number of rotations among the first k whose interpreted integer value is odd.\n\n    Raises:\n        ValueError: If s is not a non-empty binary string or if k is not a non-negative integer.\n    \"\"\"\n    validator = Validator()\n    validator.validate_binary_string(s)\n    validator.validate_non_negative_int(k)\n\n    counter = Counter()\n    return counter.count_odds(s, k)"}
{"task_id": "Mbpp/119", "solution": "def search(nums):\n    \"\"\"Accepts a sorted list of integers `nums` and returns the integer that appears only once.\n\n    Preconditions (validated at runtime):\n    - nums is a list (Python list) of integers\n    - nums is sorted in non-decreasing order\n    - len(nums) is odd\n    - exactly one integer appears once; all other integers appear exactly twice\n\n    Returns:\n        int: the unique integer value that appears only once in nums\n\n    Raises:\n        ValueError: if any precondition is violated\n    \"\"\"\n    # 1. Validate type and length\n    if not isinstance(nums, list):\n        raise ValueError(\"Input 'nums' must be a list.\")\n    if len(nums) == 0:\n        raise ValueError(\"Input list 'nums' cannot be empty.\")\n    if len(nums) % 2 == 0:\n        raise ValueError(\"Input list 'nums' must have an odd length.\")\n\n    # 2. Validate elements are integers, sorted, and occurrence counts conform to the pattern\n    unique_elements_found = 0\n    i = 0\n    while i < len(nums):\n        current_num = nums[i]\n\n        # Check if element is an integer\n        if not isinstance(current_num, int):\n            raise ValueError(\"All elements in 'nums' must be integers.\")\n\n        # Check sorted property (compared to the previous element if `i > 0`)\n        if i > 0 and current_num < nums[i-1]:\n            raise ValueError(\"Input list 'nums' must be sorted in non-decreasing order.\")\n\n        # Count occurrences of the current distinct number\n        count = 0\n        j = i\n        while j < len(nums) and nums[j] == current_num:\n            count += 1\n            j += 1\n\n        if count == 1:\n            unique_elements_found += 1\n        elif count != 2:\n            raise ValueError(f\"Element {current_num} appears {count} times, but must appear once or twice.\")\n\n        i = j  # Move index 'i' to the start of the next distinct element\n\n    if unique_elements_found != 1:\n        raise ValueError(\"Input list 'nums' must contain exactly one element appearing once.\")\n\n    # 3. Binary search to find the single element\n    low = 0\n    high = len(nums) - 1\n\n    while low < high:\n        mid = (low + high) // 2\n\n        # Ensure 'mid' always points to an even index. If 'mid' is odd, decrement it\n        # to ensure it's the start of a potential pair (or the unique element itself).\n        if mid % 2 == 1:\n            mid -= 1\n\n        # If elements at 'mid' and 'mid+1' are equal, the unique element is in the right half.\n        if nums[mid] == nums[mid + 1]:\n            low = mid + 2\n        # Otherwise, the unique element is either at 'mid' or in the left half before 'mid'.\n        else:\n            high = mid\n\n    return nums[low]"}
{"task_id": "Mbpp/120", "solution": "from typing import List, Tuple, Union\nimport numbers\nfrom dataclasses import dataclass\n\n@dataclass\nclass TuplePair:\n    a: numbers.Number\n    b: numbers.Number\n\n    def product(self) -> numbers.Number:\n        return self.a * self.b\n\n    def abs_product(self) -> numbers.Number:\n        return abs(self.product())\n\n@dataclass\nclass MaxProductResult:\n    value: numbers.Number\n\ndef max_product_tuple(input_list: List[Union[Tuple[numbers.Number, numbers.Number], TuplePair]]) -> numbers.Number:\n    \"\"\"Compute and return the maximum absolute product among 2-element numeric tuples in input_list.\n\n    Preconditions (per SRS): input_list is a list of 2-element tuples of numeric values (or TuplePair instances).\n    Returns: numbers.Number (maximum absolute product).\n    \"\"\"\n    max_abs_product_value = float('-inf')\n\n    for item in input_list:\n        current_abs_product: numbers.Number\n        if isinstance(item, TuplePair):\n            current_abs_product = item.abs_product()\n        else:\n            current_abs_product = abs(item[0] * item[1])\n        \n        if current_abs_product > max_abs_product_value:\n            max_abs_product_value = current_abs_product\n\n    return max_abs_product_value"}
{"task_id": "Mbpp/125", "solution": "class BinaryString:\n    \"\"\"Represents an input binary string and provides validation.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n        self.length = len(value)\n\n    def validate(self) -> bool:\n        \"\"\"Returns True if value contains only '0' and '1', otherwise False.\"\"\"\n        if not isinstance(self.value, str):\n            return False\n        return all(c in '01' for c in self.value)\n\nclass Result:\n    \"\"\"Value object holding the maximum difference output.\"\"\"\n    def __init__(self, maxDifference: int) -> None:\n        self.maxDifference = maxDifference\n\ndef find_length(binary_string: str) -> int:\n    \"\"\"\n    Finds the maximum difference between the number of 0s and number of 1s\n    in any sub-string of the given binary string.\n    \"\"\"\n    bs = BinaryString(binary_string)\n    if not bs.validate():\n        raise ValueError(\"Input must be a binary string containing only '0' and '1'.\")\n\n    if bs.length == 0:\n        return 0\n\n    # Transform characters: '0' -> +1, '1' -> -1.\n    transformed_values = [1 if char == '0' else -1 for char in bs.value]\n\n    # Apply Kadane-like algorithm to find the maximum contiguous sum.\n    # This variant ensures a non-negative maximum, treating an empty subarray as having sum 0.\n    max_overall = 0\n    current_max = 0\n\n    for val in transformed_values:\n        current_max += val\n        max_overall = max(max_overall, current_max)\n        if current_max < 0:\n            current_max = 0\n\n    # The design specifies returning an int.\n    return max_overall"}
