{"task_id": "HumanEval/6", "solution": "```python\nfrom typing import List\n\nclass ParenthesesParser:\n    \"\"\"\n    Calculates the maximum nesting depth for a single string of parentheses.\n    \"\"\"\n    def calculate_depth(self, group_string: str) -> int:\n        current_depth = 0\n        max_depth = 0\n        for char in group_string:\n            if char == '(':\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif char == ')':\n                current_depth -= 1\n                if current_depth < 0: # Reset if an unmatched closing parenthesis is found.\n                    current_depth = 0\n        return max_depth\n\nclass ParenthesesAnalyzer:\n    \"\"\"\n    Analyzes a string with multiple space-separated parentheses groups.\n    \"\"\"\n    def __init__(self):\n        self._parser = ParenthesesParser()\n\n    def parse_groups(self, paren_string: str) -> List[int]:\n        if not paren_string.strip():\n            return []\n        \n        # Splits by single space, retaining empty strings for multiple spaces.\n        groups = paren_string.split(' ')\n        depths = []\n        for group_string in groups:\n            if group_string: # Process non-empty parts.\n                depths.append(self._parser.calculate_depth(group_string))\n            else: # For empty strings resulting from multiple spaces, depth is 0.\n                depths.append(0)\n        return depths\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    analyzer = ParenthesesAnalyzer()\n    return analyzer.parse_groups(paren_string)\n```"}
{"task_id": "HumanEval/9", "solution": "```python\nfrom typing import List\n\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\"\n    From a given list of integers, generate a list of rolling maximum elements\n    found until the given moment in the sequence.\n    \"\"\"\n    if not numbers:\n        return []\n\n    rolling_max_list: List[int] = []\n    current_max: int = numbers[0]\n\n    # The first element's rolling maximum is itself.\n    rolling_max_list.append(current_max)\n\n    # Iterate from the second element, updating the current maximum.\n    for number in numbers[1:]:\n        if number > current_max:\n            current_max = number\n        rolling_max_list.append(current_max)\n\n    return rolling_max_list\n```"}
{"task_id": "HumanEval/11", "solution": "```python\ndef string_xor(a: str, b: str) -> str:\n    \"\"\"\n    Performs binary XOR on two input strings consisting only of '1's and '0's.\n    Returns the result also as a string.\n    \"\"\"\n    result_list = []\n    for i in range(len(a)):\n        xor_bit = str(int(a[i]) ^ int(b[i]))\n        result_list.append(xor_bit)\n    return \"\".join(result_list)\n```"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\n\n\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\"\n    Finds the longest string in a list, returning the first one encountered if multiple\n    strings share the maximum length. Returns None if the input list is empty.\n    \"\"\"\n    if not strings:\n        return None\n\n    max_length_string: Optional[str] = None\n    max_length: int = -1\n\n    for s in strings:\n        if len(s) > max_length:\n            max_length = len(s)\n            max_length_string = s\n    return max_length_string"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome. \"\"\"\n    return string == string[::-1]\n\n\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Appends the reverse of the prefix preceding the longest palindromic suffix.\n    \"\"\"\n    for j in range(len(string) + 1):\n        suffix = string[j:]\n        if is_palindrome(suffix):\n            prefix_to_reverse = string[:j]\n            return string + prefix_to_reverse[::-1]"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome.\n    Compares the string with its reverse for identity.\n    \"\"\"\n    return string == string[::-1]\n\n\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Identifies the longest palindromic suffix and appends the reverse of the preceding prefix.\n    \"\"\"\n    if not string:\n        return \"\"\n\n    # Iterate from the beginning of the string to find the longest palindromic suffix.\n    # The smallest `i` for which `string[i:]` is a palindrome yields the longest such suffix.\n    for i in range(len(string)):\n        suffix = string[i:]\n        if is_palindrome(suffix):\n            # `string[:i]` is the prefix that needs to be reversed.\n            prefix_to_reverse = string[:i]\n            return string + prefix_to_reverse[::-1]"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\"Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    \"\"\"\n    result_list = []\n    for i in range(len(a)):\n        # Convert characters to integers, perform XOR, and convert back to string.\n        xor_result = int(a[i]) ^ int(b[i])\n        result_list.append(str(xor_result))\n    return \"\".join(result_list)"}
{"task_id": "HumanEval/9", "solution": "```python\nfrom typing import List\n\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    rolling_max_list: List[int] = []\n    current_max: int = numbers[0]\n    rolling_max_list.append(current_max)\n\n    for number in numbers[1:]:\n        current_max = max(current_max, number)\n        rolling_max_list.append(current_max)\n    return rolling_max_list\n```"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    a = abs(a)\n    b = abs(b)\n\n    while b:\n        a, b = b, a % b\n    return a"}
