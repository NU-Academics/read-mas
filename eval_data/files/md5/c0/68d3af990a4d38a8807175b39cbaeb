{"task_id": "HumanEval/32", "solution": "```python\n# pyproject.toml\n[project]\nname = \"polynomial-solver\"\nversion = \"0.1.0\"\ndescription = \"A mathematical utility library for polynomial manipulation.\"\nauthors = [\n    { name = \"Your Name\", email = \"your.email@example.com\" }\n]\nrequires-python = \">=3.9\"\nreadme = \"README.md\"\nlicense = { text = \"MIT\" }\n\n[build-system]\nrequires = [\"setuptools>=61.0\"]\nbuild-backend = \"setuptools.build_meta\"\n\n[tool.setuptools.packages.find]\nwhere = [\"src\"]\n```\n\n```python\n# src/__init__.py\n\"\"\"\nInitializes the src package for the polynomial solver library.\n\"\"\"\n```\n\n```python\n# src/models.py\n\"\"\"\nData model for representing a polynomial with its coefficients.\n\"\"\"\n\nclass Polynomial:\n    def __init__(self, coefficients: list[float]) -> None:\n        \"\"\"\n        Initializes the polynomial with a list of coefficients.\n        Raises ValueError if coefficients are not a list or contain non-numeric values.\n        \"\"\"\n        if not isinstance(coefficients, list) or not all(isinstance(c, (int, float)) for c in coefficients):\n            raise ValueError(\"Coefficients must be a list of numbers.\")\n        self._coefficients = [float(c) for c in coefficients]\n\n    def get_coefficients(self) -> list[float]:\n        \"\"\"Returns the list of coefficients.\"\"\"\n        return self._coefficients\n\n    def get_degree(self) -> int:\n        \"\"\"Returns the degree of the polynomial (length of coefficients - 1).\"\"\"\n        return len(self._coefficients) - 1\n\n    def __str__(self) -> str:\n        \"\"\"Returns a string representation of the polynomial.\"\"\"\n        terms = []\n        for i, coeff in enumerate(self._coefficients):\n            if coeff == 0:\n                continue\n            coeff_str = f\"{coeff}\" if coeff != 1 or i == 0 else \"\" # Don't show '1' for x or x^2\n            if i == 0:\n                terms.append(f\"{coeff_str}\")\n            elif i == 1:\n                terms.append(f\"{coeff_str}x\")\n            else:\n                terms.append(f\"{coeff_str}x^{i}\")\n        \n        # Format for nicer output, handling negative coefficients\n        formatted_terms = []\n        for term in terms:\n            if term.startswith('-'):\n                formatted_terms.append(term)\n            else:\n                formatted_terms.append(f\"+ {term}\")\n        \n        result = \" \".join(formatted_terms).strip()\n        if result.startswith('+ '):\n            result = result[2:]\n        return result if result else \"0\"\n\n```\n\n```python\n# src/solver.py\n\"\"\"\nCore mathematical algorithms for polynomial evaluation and zero-finding.\n\"\"\"\nimport math\n\nclass PolynomialSolver:\n    BISECTION_TOLERANCE: float = 1e-6\n    BISECTION_MAX_ITERATIONS: int = 100\n    BISECTION_INITIAL_LOW: float = -1000.0\n    BISECTION_INITIAL_HIGH: float = 1000.0\n\n    @staticmethod\n    def poly(xs: list[float], x: float) -> float:\n        \"\"\"\n        Evaluates polynomial with coefficients xs at point x.\n        Returns xs[0] + xs[1] * x + xs[2] * x^2 + .... xs[n] * x^n.\n        \"\"\"\n        if not isinstance(xs, list) or not all(isinstance(c, (int, float)) for c in xs):\n            raise TypeError(\"Coefficients must be a list of numbers.\")\n        if not isinstance(x, (int, float)):\n            raise TypeError(\"x must be a number.\")\n        return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\n\n    @staticmethod\n    def find_zero(xs: list[float]) -> float:\n        \"\"\"\n        Finds a single zero x such that poly(x) = 0 for a polynomial defined by xs.\n        This method uses bisection and requires an even number of coefficients (odd degree).\n        \"\"\"\n        if not isinstance(xs, list) or not all(isinstance(c, (int, float)) for c in xs):\n            raise TypeError(\"Coefficients must be a list of numbers.\")\n        if len(xs) % 2 != 0:\n            raise ValueError(\"find_zero requires an even number of coefficients (odd degree).\")\n        if not xs:\n            raise ValueError(\"Polynomial must have at least one coefficient.\")\n\n        low, high = PolynomialSolver.BISECTION_INITIAL_LOW, PolynomialSolver.BISECTION_INITIAL_HIGH\n        \n        # The problem statement guarantees a solution for specified inputs.\n        # For simplicity, we assume the default bounds are sufficient for valid cases.\n\n        for _ in range(PolynomialSolver.BISECTION_MAX_ITERATIONS):\n            mid = (low + high) / 2\n            val_mid = PolynomialSolver.poly(xs, mid)\n\n            if abs(val_mid) < PolynomialSolver.BISECTION_TOLERANCE:\n                return mid\n\n            val_low = PolynomialSolver.poly(xs, low)\n            if val_low * val_mid < 0:\n                high = mid\n            else:\n                low = mid\n        \n        raise ValueError(\"Bisection method failed to converge within max iterations.\")\n\n```\n\n```python\n# src/services.py\n\"\"\"\nProvides a higher-level interface for polynomial operations, orchestrating calls to PolynomialSolver.\n\"\"\"\nfrom src.models import Polynomial\nfrom src.solver import PolynomialSolver\n\nclass PolynomialService:\n    def __init__(self, solver: PolynomialSolver) -> None:\n        \"\"\"Initializes the service with a PolynomialSolver instance.\"\"\"\n        self._solver = solver\n\n    def evaluate_polynomial(self, poly: Polynomial, x: float) -> float:\n        \"\"\"Evaluates a given Polynomial object at point x.\"\"\"\n        if not isinstance(poly, Polynomial):\n            raise TypeError(\"poly must be an instance of Polynomial.\")\n        if not isinstance(x, (int, float)):\n            raise TypeError(\"x must be a number.\")\n        return self._solver.poly(poly.get_coefficients(), x)\n\n    def find_polynomial_zero(self, poly: Polynomial) -> float:\n        \"\"\"Finds a single zero for a given Polynomial object.\"\"\"\n        if not isinstance(poly, Polynomial):\n            raise TypeError(\"poly must be an instance of Polynomial.\")\n        return self._solver.find_zero(poly.get_coefficients())\n\n```\n\n```python\n# src/main.py\n\"\"\"\nExample usage of the PolynomialService to demonstrate its functionalities.\n\"\"\"\nfrom src.models import Polynomial\nfrom src.services import PolynomialService\nfrom src.solver import PolynomialSolver\n\ndef run_example():\n    \"\"\"Runs a series of examples demonstrating polynomial evaluation and zero-finding.\"\"\"\n    # Initialize the solver and service\n    solver = PolynomialSolver()\n    service = PolynomialService(solver)\n\n    print(\"--- Polynomial Solver Examples ---\")\n\n    # Example 1: Linear polynomial f(x) = 1 + 2x\n    linear_coeffs = [1, 2]  # Coefficients for 1 + 2x\n    linear_poly = Polynomial(linear_coeffs)\n    print(f\"\\nPolynomial: {linear_poly} (degree {linear_poly.get_degree()})\")\n    print(f\"Evaluate at x=0: {service.evaluate_polynomial(linear_poly, 0)}\")  # Expected: 1\n    print(f\"Evaluate at x=1: {service.evaluate_polynomial(linear_poly, 1)}\")  # Expected: 3\n    print(f\"Find zero: {round(service.find_polynomial_zero(linear_poly), 2)}\")  # Expected: -0.5\n    print(\"-\" * 40)\n\n    # Example 2: Cubic polynomial (x - 1) * (x - 2) * (x - 3) = x^3 - 6x^2 + 11x - 6\n    # Coefficients for -6 + 11x - 6x^2 + x^3\n    cubic_coeffs = [-6, 11, -6, 1] \n    cubic_poly = Polynomial(cubic_coeffs)\n    print(f\"\\nPolynomial: {cubic_poly} (degree {cubic_poly.get_degree()})\")\n    print(f\"Evaluate at x=1: {service.evaluate_polynomial(cubic_poly, 1)}\")  # Expected: 0\n    print(f\"Evaluate at x=2: {service.evaluate_polynomial(cubic_poly, 2)}\")  # Expected: 0\n    print(f\"Evaluate at x=3: {service.evaluate_polynomial(cubic_poly, 3)}\")  # Expected: 0\n    # The bisection method finds one root based on its interval. For [-1000, 1000], it might find 1.0 or another.\n    print(f\"Find zero: {round(service.find_polynomial_zero(cubic_poly), 2)}\")  # Expected: e.g., 1.0\n    print(\"-\" * 40)\n\n    # Example 3: Polynomial with odd number of coefficients (even degree) for find_zero\n    # f(x) = 1 + 2x + x^2\n    invalid_coeffs_for_zero = [1, 2, 1] \n    try:\n        invalid_poly = Polynomial(invalid_coeffs_for_zero)\n        print(f\"\\nAttempting to find zero for: {invalid_poly} (degree {invalid_poly.get_degree()})\")\n        service.find_polynomial_zero(invalid_poly)\n    except ValueError as e:\n        print(f\"Caught expected error: {e}\")\n    print(\"-\" * 40)\n\n    # Example 4: Invalid input type for evaluate_polynomial\n    try:\n        print(f\"\\nAttempting to evaluate {linear_poly} with invalid x type.\")\n        service.evaluate_polynomial(linear_poly, \"invalid_x\")\n    except TypeError as e:\n        print(f\"Caught expected error: {e}\")\n    print(\"-\" * 40)\n\n    # Example 5: Invalid coefficients list for Polynomial creation\n    try:\n        print(\"\\nAttempting to create Polynomial with invalid coefficients.\")\n        Polynomial([1, \"a\", 3])\n    except ValueError as e:\n        print(f\"Caught expected error: {e}\")\n    print(\"-\" * 40)\n\nif __name__ == \"__main__\":\n    run_example()\n\n```"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    total_count = 0\n    # Iterate through numbers from 1 up to (but not including) n.\n    for i in range(1, n):\n        # Check if the current number is divisible by 11 or 13.\n        if (i % 11 == 0) or (i % 13 == 0):\n            # If it qualifies, count occurrences of the digit '7'.\n            total_count += str(i).count('7')\n    return total_count"}
