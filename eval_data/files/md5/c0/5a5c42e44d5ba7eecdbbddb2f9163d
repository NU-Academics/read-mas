{"task_id": "HumanEval/121", "solution": "def solution(lst):\n    \"\"\"Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.\"\"\"\n\n    class IntegerList:\n        \"\"\"Manages the input list, ensuring it's non-empty and providing indexed access.\"\"\"\n        def __init__(self, lst_data):\n            self._elements = lst_data\n            self._size = len(lst_data)\n\n        def get_element(self, position):\n            \"\"\"Returns the element at the specified 0-indexed position.\"\"\"\n            return self._elements[position]\n\n        def get_size(self):\n            \"\"\"Returns the total number of elements in the list.\"\"\"\n            return self._size\n\n    class Element:\n        \"\"\"Represents a single data point from the list with its value and position, providing methods to check its properties.\"\"\"\n        def __init__(self, value, position):\n            self._value = value\n            self._position = position\n\n        def is_odd(self):\n            \"\"\"Checks if the element's value is odd.\"\"\"\n            return self._value % 2 != 0\n\n        def is_even_position(self):\n            \"\"\"Checks if the element's position is even.\"\"\"\n            return self._position % 2 == 0\n\n        def get_value(self):\n            \"\"\"Returns the element's value.\"\"\"\n            return self._value\n\n    class Result:\n        \"\"\"Stores and provides access to the final calculated sum.\"\"\"\n        def __init__(self, sum_value):\n            self._sum_value = sum_value\n\n        def get_sum_value(self):\n            \"\"\"Returns the final sum.\"\"\"\n            return self._sum_value\n\n    integer_list_obj = IntegerList(lst)\n    running_sum = 0\n\n    for position in range(integer_list_obj.get_size()):\n        element_value = integer_list_obj.get_element(position)\n        element_obj = Element(element_value, position)\n\n        if element_obj.is_odd() and element_obj.is_even_position():\n            running_sum += element_obj.get_value()\n            \n    result_obj = Result(running_sum)\n    return result_obj.get_sum_value()"}
{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    '''\n    Checks if two strings can be concatenated to form a balanced parentheses string.\n    '''\n    def _is_balanced(s: str) -> bool:\n        \"\"\"\n        Checks if a string of parentheses is balanced. Balance must never drop below zero and must end at zero.\n        \"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    def _validate_input_strings(strings: list[str]) -> bool:\n        \"\"\"\n        Validates that all characters in the input strings are either '(' or ')'. Returns True if valid, False otherwise.\n        \"\"\"\n        for s_val in strings:\n            for char in s_val:\n                if char not in ('(', ')'):\n                    return False\n        return True\n\n    # Per design, validate input characters first. If invalid, it cannot form a good string.\n    if not _validate_input_strings(lst):\n        return 'No'\n\n    s1 = lst[0]\n    s2 = lst[1]\n\n    # Check concatenation order 1: s1 + s2\n    if _is_balanced(s1 + s2):\n        return 'Yes'\n\n    # Check concatenation order 2: s2 + s1\n    if _is_balanced(s2 + s1):\n        return 'Yes'\n\n    # If neither order results in a balanced string\n    return 'No'"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    \"\"\"\n\n    if n == 1:\n        return [1]\n\n    class CollatzSequenceGenerator:\n        \"\"\"Generates the Collatz sequence for a given number.\"\"\"\n        def generate(self, start_n: int) -> list[int]:\n            sequence = []\n            current = start_n\n            while True:\n                sequence.append(current)\n                if current == 1:\n                    break\n                if current % 2 == 0:\n                    current //= 2\n                else:\n                    current = 3 * current + 1\n            return sequence\n\n    class OddNumberExtractor:\n        \"\"\"Extracts odd numbers from a list of integers.\"\"\"\n        @staticmethod\n        def extract(numbers: list[int]) -> list[int]:\n            return [num for num in numbers if num % 2 != 0]\n\n    class NumberListSorter:\n        \"\"\"Sorts a list of numbers in ascending order.\"\"\"\n        @staticmethod\n        def sort_ascending(numbers: list[int]) -> list[int]:\n            return sorted(numbers)\n\n    generator = CollatzSequenceGenerator()\n    collatz_sequence = generator.generate(n)\n\n    odd_numbers = OddNumberExtractor.extract(collatz_sequence)\n\n    sorted_odd_numbers = NumberListSorter.sort_ascending(odd_numbers)\n\n    return sorted_odd_numbers"}
{"task_id": "HumanEval/124", "solution": "def valid_date(date):\n    \"\"\"You have to write a function which validates a given date string and\n    returns True if the date is valid otherwise False.\n    The date is valid if all of the following rules are satisfied:\n    1. The date string is not empty.\n    2. The number of days is not less than 1 or higher than 31 days for months 1,3,5,7,8,10,12. And the number of days is not less than 1 or higher than 30 days for months 4,6,9,11. And, the number of days is not less than 1 or higher than 29 for the month 2.\n    3. The months should not be less than 1 or higher than 12.\n    4. The date should be in the format: mm-dd-yyyy\n\n    for example: \n    valid_date('03-11-2000') => True\n\n    valid_date('15-01-2012') => False\n\n    valid_date('04-0-2040') => False\n\n    valid_date('06-04-2020') => True\n\n    valid_date('06/04/2020') => False\n    \"\"\"\n    # Rule 1: The date string is not empty.\n    if not date:\n        return False\n\n    # Rule 4: The date should be in the format: mm-dd-yyyy\n    parts = date.split('-')\n    if len(parts) != 3:\n        return False\n\n    mm_str, dd_str, yyyy_str = parts\n\n    # Enforce exact length for each part (e.g., '0' is not valid for 'dd')\n    if len(mm_str) != 2 or len(dd_str) != 2 or len(yyyy_str) != 4:\n        return False\n\n    try:\n        month = int(mm_str)\n        day = int(dd_str)\n        year = int(yyyy_str)\n    except ValueError:\n        # If any part cannot be converted to an integer, it's an invalid format.\n        return False\n\n    # Rule 3: The months should not be less than 1 or higher than 12.\n    if not (1 <= month <= 12):\n        return False\n\n    # Rule 2: The number of days is not less than 1.\n    if not (1 <= day):\n        return False\n\n    # Rule 2: Validate day upper bound based on the month.\n    long_months = [1, 3, 5, 7, 8, 10, 12]\n    short_months = [4, 6, 9, 11]\n\n    if month in long_months:\n        max_days = 31\n    elif month in short_months:\n        max_days = 30\n    elif month == 2:  # February\n        max_days = 29  # As per rule, no leap year handling is specified.\n    else:\n        # This case should ideally not be reached if month validation (1-12) passed,\n        # but serves as a failsafe.\n        return False\n\n    if day > max_days:\n        return False\n\n    # All validation rules are satisfied.\n    return True"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n    '''\n    def _validate_input(lst_to_validate):\n        # Checks if all numbers in the list are non-negative integers.\n        for x in lst_to_validate:\n            # Assuming input is guaranteed to be list of numbers as per context,\n            # but specific design requires checking for non-negative integers.\n            if not isinstance(x, int) or x < 0:\n                return False\n        return True\n\n    def _is_ascending_sorted(lst_to_check):\n        # Determines if the input list is sorted in ascending order.\n        if len(lst_to_check) <= 1:\n            return True\n        for i in range(1, len(lst_to_check)):\n            if lst_to_check[i] < lst_to_check[i-1]:\n                return False\n        return True\n\n    def _calculate_frequencies(lst_to_count):\n        # Calculates the frequency of each number in the input list.\n        frequencies = {}\n        for x in lst_to_count:\n            frequencies[x] = frequencies.get(x, 0) + 1\n        return frequencies\n\n    def _has_excessive_duplicates(frequencies_map):\n        # Checks if any number in the frequency map appears three or more times.\n        for count in frequencies_map.values():\n            if count >= 3:\n                return True\n        return False\n\n    if not _validate_input(lst):\n        return False\n\n    if not _is_ascending_sorted(lst):\n        return False\n\n    frequencies = _calculate_frequencies(lst)\n    if _has_excessive_duplicates(frequencies):\n        return False\n\n    return True"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    '''\n    Given a string of words, return a list of words split on whitespace, if no whitespaces exists in the text you\n    should split on commas ',' if no commas exists you should return the number of lower-case letters with odd order in the\n    alphabet, ord('a') = 0, ord('b') = 1, ... ord('z') = 25\n    Examples\n    split_words(\"Hello world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"Hello,world!\") \u279e [\"Hello\", \"world!\"]\n    split_words(\"abcdef\") == 3 \n    '''\n    if any(c.isspace() for c in txt):\n        return txt.split()\n\n    if ',' in txt:\n        return txt.split(',')\n\n    odd_order_count = 0\n    for char in txt:\n        if 'a' <= char <= 'z':\n            # Calculate the 0-indexed alphabetical order of the lowercase letter.\n            order = ord(char) - ord('a')\n            if order % 2 != 0:\n                odd_order_count += 1\n    return odd_order_count"}
{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    \"\"\"Determines if the length of the intersection of two intervals is a prime number.\n    Returns \"YES\" if prime, \"NO\" otherwise or if there's no intersection.\n    \"\"\"\n\n    def _calculate_intersection_interval(i1, i2):\n        \"\"\"Calculates the intersection of two intervals, returning (start, end) or None.\"\"\"\n        start1, end1 = i1\n        start2, end2 = i2\n\n        inter_start = max(start1, start2)\n        inter_end = min(end1, end2)\n\n        if inter_start <= inter_end:\n            return (inter_start, inter_end)\n        else:\n            return None\n\n    def _calculate_interval_length(interval):\n        \"\"\"Calculates the length of a given interval (start, end).\"\"\"\n        start, end = interval\n        return end - start + 1\n\n    def _is_prime(number):\n        \"\"\"Checks if a given integer is a prime number.\"\"\"\n        if number <= 1:\n            return False\n        if number == 2:\n            return True\n        if number % 2 == 0:\n            return False\n        i = 3\n        while i * i <= number:\n            if number % i == 0:\n                return False\n            i += 2\n        return True\n\n    intersection_result = _calculate_intersection_interval(interval1, interval2)\n\n    if intersection_result is None:\n        return \"NO\"\n    else:\n        length = _calculate_interval_length(intersection_result)\n        if _is_prime(length):\n            return \"YES\"\n        else:\n            return \"NO\""}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Calculates the sum of magnitudes of integers multiplied by the product of all signs.\n    Returns None for an empty array.\n    \"\"\"\n    if not arr:\n        return None\n\n    def _get_magnitude(number):\n        \"\"\"Returns the absolute value of an integer.\"\"\"\n        return abs(number)\n\n    def _get_sign(number):\n        \"\"\"Returns the sign of an integer: 1 for positive, -1 for negative, 0 for zero.\"\"\"\n        if number > 0:\n            return 1\n        elif number < 0:\n            return -1\n        else:\n            return 0\n\n    sum_magnitudes = 0\n    product_signs = 1\n\n    for number in arr:\n        sum_magnitudes += _get_magnitude(number)\n        product_signs *= _get_sign(number)\n\n    return sum_magnitudes * product_signs"}
{"task_id": "HumanEval/129", "solution": "class Cell:\n    \"\"\"Represents a single cell in the grid with its coordinates and value.\"\"\"\n    def __init__(self, row: int, col: int, value: int) -> None:\n        self.row = row\n        self.col = col\n        self.value = value\n\n    def __eq__(self, other) -> bool:\n        if not isinstance(other, Cell):\n            return NotImplemented\n        return self.row == other.row and self.col == other.col\n\n    def __hash__(self) -> int:\n        return hash((self.row, self.col))\nclass Path:\n    \"\"\"Represents a sequence of cell values forming a path and provides lexicographical comparison.\"\"\"\n    def __init__(self, initial_values: list[int] = None) -> None:\n        # Create a copy of initial_values to prevent modification issues from external references.\n        self.sequence_of_values = list(initial_values) if initial_values is not None else []\n\n    def add_value(self, value: int) -> None:\n        self.sequence_of_values.append(value)\n\n    def __lt__(self, other: 'Path') -> bool:\n        # Compares two paths lexicographically.\n        len_self = len(self.sequence_of_values)\n        len_other = len(other.sequence_of_values)\n        \n        min_len = min(len_self, len_other)\n        for i in range(min_len):\n            if self.sequence_of_values[i] < other.sequence_of_values[i]:\n                return True\n            if self.sequence_of_values[i] > other.sequence_of_values[i]:\n                return False\n        \n        # If one path is a prefix of the other, the shorter one is lexicographically smaller.\n        return len_self < len_other\n\n    def __len__(self) -> int:\n        return len(self.sequence_of_values)\nclass Grid:\n    \"\"\"Manages the grid structure, provides access to cells, and identifies neighbors.\"\"\"\n    def __init__(self, grid_data: list[list[int]]) -> None:\n        self.N = len(grid_data)\n        self._cells: list[list[Cell]] = []\n        for r in range(self.N):\n            row_cells = []\n            for c in range(self.N):\n                row_cells.append(Cell(r, c, grid_data[r][c]))\n            self._cells.append(row_cells)\n\n    def get_cell(self, row: int, col: int) -> Cell | None:\n        if self.is_valid_coordinate(row, col):\n            return self._cells[row][col]\n        return None\n\n    def get_neighbor_cells(self, cell: Cell) -> list[Cell]:\n        neighbors = []\n        # Define directions for moving: Up, Down, Left, Right\n        directions = [(-1, 0), (1, 0), (0, -1), (0, 1)] \n        for dr, dc in directions:\n            new_row, new_col = cell.row + dr, cell.col + dc\n            if self.is_valid_coordinate(new_row, new_col):\n                neighbors.append(self._cells[new_row][new_col])\n        return neighbors\n\n    def is_valid_coordinate(self, row: int, col: int) -> bool:\n        return 0 <= row < self.N and 0 <= col < self.N\ndef minPath(grid: list[list[int]], k: int) -> list[int]:\n    \"\"\"\n    Given a grid and a positive integer k, find the minimum path of length k in the grid.\n    \"\"\"\n    N = len(grid)\n    grid_obj = Grid(grid)\n\n    # Initialize min_path_obj with a path of length k containing maximum possible values\n    # for lexicographical comparison. Any valid path will be lexicographically smaller.\n    min_path_obj = Path([float('inf')] * k) \n\n    def _find_paths_recursive(\n        current_cell: Cell,\n        current_path_values: list[int],\n        depth: int,\n        k_target: int,\n        grid_instance: Grid,\n        min_path_reference: Path # This object's values will be updated by reference\n    ) -> None:\n        # Base case: if path length k_target is reached\n        if depth == k_target:\n            temp_path_obj = Path(current_path_values)\n            if temp_path_obj < min_path_reference:\n                # Update the sequence of values in the min_path_reference object.\n                min_path_reference.sequence_of_values = temp_path_obj.sequence_of_values\n            return\n\n        # Recursive step: explore neighbor cells\n        neighbors = grid_instance.get_neighbor_cells(current_cell)\n        for neighbor in neighbors:\n            current_path_values.append(neighbor.value)\n            _find_paths_recursive(neighbor, current_path_values, depth + 1, k_target, grid_instance, min_path_reference)\n            current_path_values.pop() # Backtrack: remove the last added value for sibling paths\n\n    # Iterate through all possible starting cells in the grid\n    for r in range(N):\n        for c in range(N):\n            start_cell = grid_obj.get_cell(r, c)\n            # Start the recursive search from each cell.\n            # current_path_values starts with the value of the start_cell, depth is 1.\n            _find_paths_recursive(start_cell, [start_cell.value], 1, k, grid_obj, min_path_obj)\n    \n    return min_path_obj.sequence_of_values"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n    product = 1\n    found_odd_digit = False\n\n    while n > 0:\n        last_digit = n % 10\n        if last_digit % 2 != 0:  # Check if the digit is odd\n            product *= last_digit\n            found_odd_digit = True\n        n //= 10\n\n    if not found_odd_digit:\n        return 0\n    return product"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Everyone knows Fibonacci sequence, it was studied deeply by mathematicians in\n    the last couple centuries. However, what people don't know is Tribonacci sequence.\n    Tribonacci sequence is defined by the recurrence:\n    tri(1) = 3\n    tri(n) = 1 + n / 2, if n is even.\n    tri(n) =  tri(n - 1) + tri(n - 2) + tri(n + 1), if n is odd.\n    For example:\n    tri(2) = 1 + (2 / 2) = 2\n    tri(4) = 3\n    tri(3) = tri(2) + tri(1) + tri(4)\n           = 2 + 3 + 3 = 8\n    You are given a non-negative integer number n, you have to a return a list of the\n    first n + 1 numbers of the Tribonacci sequence.\n    Examples:\n    tri(3) = [1, 3, 2, 8]\n    \"\"\"\n    memo = {0: 1, 1: 3}\n    result_sequence = []\n\n    def _calculate_tri_k(k_val):\n        # Helper function to compute tri(k_val) with memoization.\n        if k_val in memo:\n            return memo[k_val]\n\n        if k_val % 2 == 0:  # Even k_val\n            val = 1 + k_val / 2\n        else:  # Odd k_val (k_val must be > 1 due to memo[1] base case)\n            # Handles the forward dependency tri(k_val + 1) recursively.\n            val = _calculate_tri_k(k_val - 1) + _calculate_tri_k(k_val - 2) + _calculate_tri_k(k_val + 1)\n\n        memo[k_val] = val\n        return val\n\n    for i in range(n + 1):\n        result_sequence.append(int(_calculate_tri_k(i)))\n\n    return result_sequence"}
{"task_id": "HumanEval/133", "solution": "import math\ndef sum_squares(lst):\n    \"\"\"You are given a list of numbers.\n    You need to return the sum of squared numbers in the given list,\n    round each element in the list to the upper int(Ceiling) first.\n    Examples:\n    For lst = [1,2,3] the output should be 14\n    For lst = [1,4,9] the output should be 98\n    For lst = [1,3,5,7] the output should be 84\n    For lst = [1.4,4.2,0] the output should be 29\n    For lst = [-2.4,1,1] the output should be 6\n    \"\"\"\n\n    class Number:\n        \"\"\"Encapsulates a single numerical value and provides operations for rounding up and squaring.\"\"\"\n        def __init__(self, value: float):\n            self._value = value\n\n        def round_up(self) -> int:\n            \"\"\"Rounds the internal value up to the nearest integer using the ceiling function.\"\"\"\n            return math.ceil(self._value)\n\n        def square(self, rounded_value: int) -> int:\n            \"\"\"Squares a given integer value.\"\"\"\n            return rounded_value * rounded_value\n\n    class SumOfSquaresResult:\n        \"\"\"A simple data class to hold the final calculated sum.\"\"\"\n        def __init__(self, total_sum: int):\n            self.total_sum = total_sum\n\n    class NumberList:\n        \"\"\"Manages a collection of Number objects and orchestrates their processing.\"\"\"\n        def __init__(self, numbers: list[float]):\n            self._numbers = [Number(value) for value in numbers]\n\n        def process_and_sum(self) -> SumOfSquaresResult:\n            \"\"\"Iterates, rounds up, squares, and accumulates the sum, returning a SumOfSquaresResult.\"\"\"\n            total_sum = 0\n            for num_obj in self._numbers:\n                rounded_val = num_obj.round_up()\n                squared_val = num_obj.square(rounded_val)\n                total_sum += squared_val\n            return SumOfSquaresResult(total_sum)\n\n    number_list_processor = NumberList(lst)\n    result_obj = number_list_processor.process_and_sum()\n    return result_obj.total_sum"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"Create a function which returns the largest index of an element which\n    is not greater than or equal to the element immediately preceding it. If\n    no such element exists then return -1. The given array will not contain\n    duplicate values.\n    \"\"\"\n    largest_out_of_order_index = -1\n    # Iterate from the second element to compare each with its predecessor.\n    for i in range(1, len(arr)):\n        if arr[i] < arr[i-1]:\n            largest_out_of_order_index = i\n    return largest_out_of_order_index"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Checks if the last character of a string is an alphabetical character and is not part of a word.\n    A \"word\" is defined as a group of characters separated by space.\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    # Check if the last character is a letter\n    if not last_char.isalpha():\n        return False\n\n    # Check if the string has only one character or the second to last character is a space\n    if len(txt) == 1 or txt[-2] == ' ':\n        return True\n    else:\n        # The last character is a letter but is part of a word\n        return False"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    '''\n    Checks if the string contains a valid subsequence of brackets with at least one nested structure.\n    A nested structure implies a maximum nesting depth of 2 or more.\n    '''\n    current_depth = 0\n    max_depth = 0\n\n    for char in string:\n        if char == '[':\n            current_depth += 1\n            max_depth = max(max_depth, current_depth)\n        elif char == ']':\n            current_depth -= 1\n            # We don't clamp current_depth to 0 here because unmatched closing brackets\n            # can signify that no proper nesting occurred for prior opening brackets.\n\n    return max_depth >= 2"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    '''\n    Create a function that returns a tuple (a, b), where 'a' is\n    the largest of negative integers, and 'b' is the smallest\n    of positive integers in a list.\n    If there is no negative or positive integers, return them as None.\n    '''\n    largest_negative = None\n    smallest_positive = None\n\n    for num in lst:\n        if num < 0:\n            if largest_negative is None or num > largest_negative:\n                largest_negative = num\n        elif num > 0:\n            if smallest_positive is None or num < smallest_positive:\n                smallest_positive = num\n\n    return (largest_negative, smallest_positive)"}
{"task_id": "HumanEval/137", "solution": "def compare_one(a, b):\n    \"\"\"\n    Create a function that takes integers, floats, or strings representing\n    real numbers, and returns the larger variable in its given variable type.\n    Return None if the values are equal.\n    Note: If a real number is represented as a string, the floating point might be . or ,\n    \"\"\"\n\n    def _parse_value_to_float(value):\n        \"\"\"Converts an input value (int, float, or string) to a float for comparison.\"\"\"\n        if isinstance(value, (int, float)):\n            return float(value)\n        elif isinstance(value, str):\n            cleaned_value = value.replace(',', '.')\n            return float(cleaned_value)\n        # The design context states not to add isinstance() checks or raise exceptions for edge cases\n        # not explicitly handled, but the _parse_value_to_float in design included error handling.\n        # I will follow the explicit instruction not to add checks or raise exceptions.\n        # However, the design context's _parse_value_to_float *did* include `raise ValueError`\n        # and `raise TypeError`. This creates a conflict with \"Do NOT add isinstance() checks or raise exceptions for edge cases\".\n        # I will stick to the provided helper implementation in the design, which includes these.\n        # Let's re-evaluate: \"Do NOT add isinstance() checks or raise exceptions for edge cases\"\n        # refers to *my additions*. The design context itself *provides* those checks and raises.\n        # So, I should include the provided helper as is.\n        # Update: Re-reading, \"Do NOT add isinstance() checks or raise exceptions for edge cases\"\n        # implies that if the design context itself were to provide a simpler version without these,\n        # I should not add them back. But since the design *does* provide them, I will include them.\n        # The prompt says \"use as implementation guidance only\", and \"Do NOT add isinstance() checks or raise exceptions for edge cases\"\n        # is a hard requirement. The conflict needs to be resolved.\n        # I will follow the hard requirement: \"Do NOT add isinstance() checks or raise exceptions for edge cases\".\n        # This implies I should simplify the _parse_value_to_float to only handle the expected types\n        # without explicit error checking for unsupported types or unparsable strings,\n        # relying on implicit Python errors if types are unexpected, or on the problem statement's\n        # implicit guarantee that inputs will be valid per specification.\n\n        # Revised _parse_value_to_float without explicit error handling, relying on specification:\n        if isinstance(value, (int, float)):\n            return float(value)\n        elif isinstance(value, str):\n            cleaned_value = value.replace(',', '.')\n            return float(cleaned_value)\n        # For other types, float(value) would likely raise a TypeError, which aligns\n        # with not *adding* explicit checks.\n\n    def _get_original_type(value):\n        \"\"\"Returns the original Python type of the input value.\"\"\"\n        return type(value)\n\n    # Main logic\n    num_a = _parse_value_to_float(a)\n    num_b = _parse_value_to_float(b)\n\n    if num_a > num_b:\n        return a\n    elif num_b > num_a:\n        return b\n    else:\n        return None"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n    def factorial(k):\n        \"\"\"Calculates the standard factorial of an integer k.\"\"\"\n        res = 1\n        for i in range(1, k + 1):\n            res *= i\n        return res\n\n    total_product = 1\n    for i in range(1, n + 1):\n        total_product *= factorial(i)\n    return total_product"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers.\n    This is true if n is an even number and n is greater than or equal to 8.\"\"\"\n    if n % 2 != 0:\n        return False\n    if n < 8:\n        return False\n    return True"}
{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores, \n    and if a string has more than 2 consecutive spaces, \n    then replace all consecutive spaces with - \n    \"\"\"\n    # First, replace sequences of 3 or more spaces with a single hyphen.\n    # This handles the most specific and longest space sequences.\n    text = re.sub(r' {3,}', '-', text)\n    \n    # Next, replace sequences of exactly 2 spaces with two underscores.\n    # This must be done after the 3+ spaces rule to prevent incorrect replacement.\n    text = re.sub(r' {2}', '__', text)\n    \n    # Finally, replace any remaining single spaces with a single underscore.\n    text = text.replace(' ', '_')\n    \n    return text"}
{"task_id": "HumanEval/144", "solution": "class Fraction:\n    \"\"\"Encapsulates a fraction's numerator and denominator, and provides parsing functionality.\"\"\"\n    def __init__(self, numerator: int, denominator: int):\n        self.numerator = numerator\n        self.denominator = denominator\n\n    @staticmethod\n    def parse(fraction_string: str) -> 'Fraction':\n        \"\"\"Parses a string in \"<numerator>/<denominator>\" format into a Fraction object.\"\"\"\n        numerator_str, denominator_str = fraction_string.split('/')\n        return Fraction(int(numerator_str), int(denominator_str))\nclass FractionProduct:\n    \"\"\"Calculates the product of two Fraction objects and determines if the resulting product is a whole number.\"\"\"\n    def __init__(self, fraction1: Fraction, fraction2: Fraction):\n        self.numerator = fraction1.numerator * fraction2.numerator\n        self.denominator = fraction1.denominator * fraction2.denominator\n\n    def is_whole_number(self) -> bool:\n        \"\"\"Returns True if the product's numerator is perfectly divisible by its denominator.\"\"\"\n        return self.numerator % self.denominator == 0\ndef simplify(x, n):\n    \"\"\"Determines if the expression x * n evaluates to a whole number.\n    x and n are string representations of fractions.\"\"\"\n    fraction_x = Fraction.parse(x)\n    fraction_n = Fraction.parse(n)\n    \n    product = FractionProduct(fraction_x, fraction_n)\n    \n    return product.is_whole_number()"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a \n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not \n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries. \n    \n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    total_sum = 0\n    for i, entry in enumerate(lst):\n        if i % 3 == 0:\n            total_sum += entry * entry\n        elif i % 4 == 0: # This condition implicitly means i % 3 != 0 because of the preceding if-statement.\n            total_sum += entry * entry * entry\n        else:\n            total_sum += entry\n    return total_sum"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    A file's name is considered to be valid if and only if all the following conditions \n    are met:\n    - There should not be more than three digits ('0'-'9') in the file's name.\n    - The file's name contains exactly one dot '.'\n    - The substring before the dot should not be empty, and it starts with a letter from \n    the latin alphapet ('a'-'z' and 'A'-'Z').\n    - The substring after the dot should be one of these: ['txt', 'exe', 'dll']\n    Examples:\n    file_name_check(\"example.txt\") # => 'Yes'\n    file_name_check(\"1example.dll\") # => 'No' (the name should start with a latin alphapet letter)\n    \"\"\"\n\n    class FileName:\n        \"\"\"Represents a file name and encapsulates its validation logic.\"\"\"\n\n        VALID_SUFFIXES = {'txt', 'exe', 'dll'}\n\n        def __init__(self, file_name: str):\n            self._name = file_name\n            self._prefix = ''\n            self._suffix = ''\n            self._digit_count = 0\n            self._dot_count = 0\n            self._parse_name()\n\n        def _parse_name(self):\n            \"\"\"Parses the file name to extract components and counts.\"\"\"\n            self._digit_count = sum(1 for char in self._name if char.isdigit())\n            self._dot_count = self._name.count('.')\n\n            if self._dot_count == 1:\n                parts = self._name.split('.', 1)\n                self._prefix = parts[0]\n                self._suffix = parts[1]\n\n        def _validate_digit_count(self) -> bool:\n            \"\"\"BR1: Not more than three digits.\"\"\"\n            return self._digit_count <= 3\n\n        def _validate_dot_count(self) -> bool:\n            \"\"\"BR2: Exactly one dot.\"\"\"\n            return self._dot_count == 1\n\n        def _validate_prefix_not_empty(self) -> bool:\n            \"\"\"BR3: Substring before dot not empty.\"\"\"\n            return bool(self._prefix)\n\n        def _validate_prefix_starts_with_letter(self) -> bool:\n            \"\"\"BR4: Substring before dot starts with a latin alphabet letter.\"\"\"\n            if not self._prefix:\n                return False # Covered by _validate_prefix_not_empty, but good for robustness\n            return self._prefix[0].isalpha()\n\n        def _validate_suffix_type(self) -> bool:\n            \"\"\"BR5: Substring after dot is one of ['txt', 'exe', 'dll'].\"\"\"\n            return self._suffix.lower() in self.VALID_SUFFIXES\n\n        def is_valid(self) -> bool:\n            \"\"\"BR6: A file's name is valid if and only if all conditions are met.\"\"\"\n            # Order of checks matters for efficiency and dependency (e.g., dot count before prefix/suffix)\n            if not self._validate_dot_count():\n                return False\n            if not self._validate_prefix_not_empty():\n                return False\n            if not self._validate_prefix_starts_with_letter():\n                return False\n            if not self._validate_suffix_type():\n                return False\n            if not self._validate_digit_count():\n                return False\n\n            return True\n\n    file_obj = FileName(file_name)\n    if file_obj.is_valid():\n        return 'Yes'\n    else:\n        return 'No'"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    You are given a string representing a sentence,\n    the sentence contains some words separated by a space,\n    and you have to return a string that contains the words from the original sentence,\n    whose lengths are prime numbers,\n    the order of the words in the new string should be the same as the original one.\n\n    Example 1:\n        Input: sentence = \"This is a test\"\n        Output: \"is\"\n\n    Example 2:\n        Input: sentence = \"lets go for swimming\"\n        Output: \"go for\"\n\n    Constraints:\n        * 1 <= len(sentence) <= 100\n        * sentence contains only letters\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"Determines if a given integer is a prime number.\"\"\"\n        if n < 2:\n            return False\n        for i in range(2, int(n**0.5) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    words = [word for word in sentence.split(' ') if word]\n    filtered_words = [word for word in words if is_prime(len(word))]\n    result_string = \" \".join(filtered_words)\n    \n    return result_string"}
{"task_id": "HumanEval/145", "solution": "class _DigitSumCalculator:\n    \"\"\"Utility class to calculate the sum of absolute digits for an integer.\"\"\"\n    @classmethod\n    def calculate(cls, number: int) -> int:\n        \"\"\"\n        Calculates the sum of the absolute values of the digits of a number.\n        \"\"\"\n        s = str(abs(number))\n        digit_sum = 0\n        for digit_char in s:\n            digit_sum += int(digit_char)\n        return digit_sum\nclass _SortableInteger:\n    \"\"\"Encapsulates an integer, its original index, and its digit sum for sorting.\"\"\"\n    def __init__(self, value: int, original_index: int):\n        self._value = value\n        self._original_index = original_index\n        self._digit_sum = _DigitSumCalculator.calculate(value)\n\n    def __lt__(self, other: '_SortableInteger') -> bool:\n        \"\"\"\n        Compares two _SortableInteger objects for sorting based on digit sum and original index.\n        \"\"\"\n        if self._digit_sum != other._digit_sum:\n            return self._digit_sum < other._digit_sum\n        return self._original_index < other._original_index\n\n    def get_value(self) -> int:\n        \"\"\"\n        Returns the original integer value.\n        \"\"\"\n        return self._value\ndef order_by_points(nums: list[int]) -> list[int]:\n    \"\"\"\n    Sorts the given list of integers in ascending order according to the sum of their digits.\n    If there are several items with similar sum of their digits, order them based on their\n    index in the original list.\n    \"\"\"\n    if not nums:\n        return []\n\n    sortable_items = [\n        _SortableInteger(value, index) for index, value in enumerate(nums)\n    ]\n\n    sortable_items.sort()\n\n    return [item.get_value() for item in sortable_items]"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"Write a function that takes an array of numbers as input and returns \n    the number of elements in the array that are greater than 10 and both \n    first and last digits of a number are odd (1, 3, 5, 7, 9).\n    \"\"\"\n\n    def _get_absolute_value(num: int) -> int:\n        \"\"\"Returns the absolute value of an integer.\"\"\"\n        return abs(num)\n\n    def _get_first_digit(num: int) -> int:\n        \"\"\"Extracts the first digit of a non-negative integer.\"\"\"\n        if num == 0:\n            return 0\n        return int(str(num)[0])\n\n    def _get_last_digit(num: int) -> int:\n        \"\"\"Extracts the last digit of a non-negative integer.\"\"\"\n        return num % 10\n\n    def _is_odd(digit: int) -> bool:\n        \"\"\"Checks if a single digit is odd.\"\"\"\n        return digit % 2 != 0\n\n    def _is_greater_than_ten(num: int) -> bool:\n        \"\"\"Checks if an integer is strictly greater than 10.\"\"\"\n        return num > 10\n\n    count = 0\n    for num in nums:\n        if _is_greater_than_ten(num):\n            abs_num = _get_absolute_value(num)\n            first_digit = _get_first_digit(abs_num)\n            last_digit = _get_last_digit(abs_num)\n\n            is_first_odd = _is_odd(first_digit)\n            is_last_odd = _is_odd(last_digit)\n\n            if is_first_odd and is_last_odd:\n                count += 1\n    return count"}
{"task_id": "HumanEval/148", "solution": "class Planet:\n    def __init__(self, name: str, order_from_sun: int):\n        self.name = name\n        self.order_from_sun = order_from_sun\nclass SolarSystem:\n    def __init__(self):\n        self._planets_in_order = [\n            Planet(\"Mercury\", 0),\n            Planet(\"Venus\", 1),\n            Planet(\"Earth\", 2),\n            Planet(\"Mars\", 3),\n            Planet(\"Jupiter\", 4),\n            Planet(\"Saturn\", 5),\n            Planet(\"Uranus\", 6),\n            Planet(\"Neptune\", 7),\n        ]\n        self._planet_to_index = {\n            planet.name: i for i, planet in enumerate(self._planets_in_order)\n        }\n\n    def get_planets_between(self, planet1: str, planet2: str) -> list[str]:\n        if planet1 not in self._planet_to_index or planet2 not in self._planet_to_index:\n            return []\n\n        idx1 = self._planet_to_index[planet1]\n        idx2 = self._planet_to_index[planet2]\n\n        start_idx = min(idx1, idx2) + 1\n        end_idx = max(idx1, idx2)\n\n        between_planets = self._planets_in_order[start_idx:end_idx]\n        return [planet.name for planet in between_planets]\n_solar_system = SolarSystem()\ndef bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun \n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn, \n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2. \n    The function should return a tuple containing all planets whose orbits are \n    located between the orbit of planet1 and the orbit of planet2, sorted by \n    the proximity to the sun. \n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names. \n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    result_list = _solar_system.get_planets_between(planet1, planet2)\n    return tuple(result_list)"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Filters a list of strings by removing odd-length strings and sorts the remaining strings.\n    Sorting is first by length (ascending) then alphabetically (ascending).\n    \"\"\"\n    filtered_list = []\n    for s in lst:\n        if len(s) % 2 == 0:\n            filtered_list.append(s)\n\n    # Sort primarily by length, secondarily by alphabetical order\n    filtered_list.sort(key=lambda x: (len(x), x))\n    return filtered_list"}
{"task_id": "HumanEval/150", "solution": "def x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is\n    a prime number and should return the value of y otherwise.\n\n    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n\n    \"\"\"\n    def is_prime(num: int) -> bool:\n        \"\"\"Determines if a given integer is a prime number.\"\"\"\n        if num <= 1:\n            return False\n        if num <= 3:\n            return True\n        if num % 2 == 0 or num % 3 == 0:\n            return False\n        i = 5\n        while i * i <= num:\n            if num % i == 0 or num % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    if is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    You are given a positive integer n. You have to create an integer array a of length n.\n        For each i (1 \u2264 i \u2264 n), the value of a[i] = i * i - i + 1.\n        Return the number of triples (a[i], a[j], a[k]) of a where i < j < k, \n    and a[i] + a[j] + a[k] is a multiple of 3.\n    \"\"\"\n    if n < 3:\n        return 0\n\n    a_values = [0] * n  # 0-indexed list to store values a[1]...a[n]\n    for i in range(n):\n        # Calculate a[i+1] based on the problem's 1-based indexing formula\n        # a[i] = i*i - i + 1  -> a_values[idx] = (idx+1)*(idx+1) - (idx+1) + 1\n        original_i = i + 1\n        a_values[i] = original_i * original_i - original_i + 1\n\n    count = 0\n    for i in range(n - 2):\n        for j in range(i + 1, n - 1):\n            for k in range(j + 1, n):\n                if (a_values[i] + a_values[j] + a_values[k]) % 3 == 0:\n                    count += 1\n    return count"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    '''\n    Given a list of numbers, return the sum of squares of the numbers\n    in the list that are odd. Ignore numbers that are negative or not integers.\n    \n    double_the_difference([1, 3, 2, 0]) == 1 + 9 + 0 + 0 = 10\n    double_the_difference([-1, -2, 0]) == 0\n    double_the_difference([9, -2]) == 81\n    double_the_difference([0]) == 0  \n   \n    If the input list is empty, return 0.\n    '''\n    def _is_valid_odd_non_negative_integer(num):\n        \"\"\"Checks if a number is a non-negative, odd integer.\"\"\"\n        # Check if the number is an integer type (float means it's not a pure integer)\n        if not isinstance(num, int):\n            return False\n        # Check if non-negative and odd\n        return num >= 0 and num % 2 != 0\n\n    def _square(num):\n        \"\"\"Calculates the square of an integer.\"\"\"\n        return num * num\n\n    sum_of_squares = 0\n    for number in lst:\n        if _is_valid_odd_non_negative_integer(number):\n            sum_of_squares += _square(number)\n    return sum_of_squares"}
{"task_id": "HumanEval/152", "solution": "def compare(game: list[int], guess: list[int]) -> list[int]:\n    \"\"\"Given two arrays of scores and guesses, return an array of the same length denoting how far off each guess was.\n    If guessed correctly, the value is 0; otherwise, it's the absolute difference.\n    \"\"\"\n    differences = []\n    for i in range(len(game)):\n        if game[i] == guess[i]:\n            differences.append(0)\n        else:\n            differences.append(abs(game[i] - guess[i]))\n    return differences"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n    \"\"\"\n    _roman_map = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'), (1, 'I')\n    ]\n\n    result = []\n    num = number\n    for value, numeral in _roman_map:\n        while num >= value:\n            result.append(numeral)\n            num -= value\n    return \"\".join(result).lower()"}
{"task_id": "HumanEval/157", "solution": "import math\ndef right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or \n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    a_sq = a * a\n    b_sq = b * b\n    c_sq = c * c\n    epsilon = 1e-9 # Tolerance for floating-point comparisons.\n\n    # Check all permutations for the Pythagorean theorem: s1^2 + s2^2 = s3^2.\n    # A triangle is right-angled if the sum of squares of two sides equals the square of the third side.\n    return (math.isclose(a_sq + b_sq, c_sq, rel_tol=epsilon) or\n            math.isclose(a_sq + c_sq, b_sq, rel_tol=epsilon) or\n            math.isclose(b_sq + c_sq, a_sq, rel_tol=epsilon))"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"\n    Finds the strongest extension based on CAP - SM count and formats the result.\n    If strengths are equal, the first extension in the list is chosen.\n    \"\"\"\n    strongest_extension_name = \"\"\n    max_strength = float('-inf')\n\n    for extension_name in extensions:\n        cap_count = 0\n        sm_count = 0\n        for char in extension_name:\n            if char.isupper():\n                cap_count += 1\n            elif char.islower():\n                sm_count += 1\n        \n        current_strength = cap_count - sm_count\n\n        # Update if the current extension is strictly stronger,\n        # which implicitly handles the \"first in list\" tie-breaking rule.\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = extension_name\n\n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    # Convert the absolute value of the number to a string to iterate through digits.\n    abs_num_str = str(abs(num))\n\n    for digit_char in abs_num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/154", "solution": "def _generate_rotations(s: str) -> list[str]:\n    \"\"\"Generates all unique cyclic rotations of a given input string.\"\"\"\n    rotations = []\n    n = len(s)\n    if n == 0:\n        return [\"\"]\n    for i in range(n):\n        rotated_s = s[i:] + s[:i]\n        rotations.append(rotated_s)\n    return rotations\ndef cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word\n    cycpattern_check(\"abcd\",\"abd\") => False\n    cycpattern_check(\"hello\",\"ell\") => True\n    cycpattern_check(\"whassup\",\"psus\") => False\n    cycpattern_check(\"abab\",\"baa\") => True\n    cycpattern_check(\"efef\",\"eeff\") => False\n    cycpattern_check(\"himenss\",\"simen\") => True\n\n    \"\"\"\n    # An empty string is a substring of any string.\n    if not b:\n        return True\n\n    rotations_b = _generate_rotations(b)\n\n    for rotation in rotations_b:\n        if rotation in a:\n            return True\n            \n    return False"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates the total carrots eaten and carrots left after a meal.\n    The rabbit eats the required amount or all remaining carrots, whichever is less.\n    \"\"\"\n    carrots_eaten_in_meal = min(need, remaining)\n    total_eaten_carrots = number + carrots_eaten_in_meal\n    carrots_left_in_stock = remaining - carrots_eaten_in_meal\n    \n    return [total_eaten_carrots, carrots_left_in_stock]"}
{"task_id": "HumanEval/158", "solution": "def _calculate_unique_chars_count(word: str) -> int:\n    \"\"\"Calculates the number of unique characters in a word.\"\"\"\n    return len(set(word))\ndef find_max(words: list[str]) -> str:\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_word = \"\"\n    max_unique_count = -1\n\n    for word in words:\n        current_unique_count = _calculate_unique_chars_count(word)\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            max_word = word\n        elif current_unique_count == max_unique_count:\n            # If unique counts are equal, choose the one that comes first lexicographically.\n            if word < max_word:\n                max_word = word\n    \n    return max_word"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Constructs and evaluates an algebraic expression from lists of operators and operands.\n    The evaluation respects standard operator precedence.\n    \"\"\"\n    \n    expression_parts = []\n    \n    # Start with the first operand\n    expression_parts.append(str(operand[0]))\n    \n    # Alternate operators and operands\n    for i in range(len(operator)):\n        expression_parts.append(operator[i])\n        expression_parts.append(str(operand[i + 1]))\n            \n    expression_string = \"\".join(expression_parts)\n    \n    # Evaluate the constructed expression string\n    result = eval(expression_string)\n    \n    return int(result)"}
{"task_id": "HumanEval/162", "solution": "def string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    import hashlib\n    if not text:\n        return None\n    return hashlib.md5(text.encode('utf-8')).hexdigest()"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"Reverses case of letters or reverses the whole string if no letters are present.\"\"\"\n\n    def _has_letters(s_local):\n        \"\"\"Checks if the string contains any letters.\"\"\"\n        for char in s_local:\n            if 'a' <= char <= 'z' or 'A' <= char <= 'Z':\n                return True\n        return False\n\n    def _reverse_case(char_local):\n        \"\"\"Reverses the case of a letter; otherwise, returns it unchanged.\"\"\"\n        if 'a' <= char_local <= 'z':\n            return chr(ord(char_local) - 32)  # Convert to uppercase\n        elif 'A' <= char_local <= 'Z':\n            return chr(ord(char_local) + 32)  # Convert to lowercase\n        return char_local\n\n    if not _has_letters(s):\n        return s[::-1]\n    else:\n        result = []\n        for char in s:\n            result.append(_reverse_case(char))\n        return \"\".join(result)"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n    \"\"\"\n    # Determine the inclusive range defined by min(a, b) and max(a, b).\n    min_val = min(a, b)\n    max_val = max(a, b)\n\n    # The list of all single-digit even integers to check against the range.\n    all_even_digits = [0, 2, 4, 6, 8]\n\n    # Collect digits from `all_even_digits` that fall within the determined range.\n    result = []\n    for digit in all_even_digits:\n        if min_val <= digit <= max_val:\n            result.append(digit)\n\n    return result"}
