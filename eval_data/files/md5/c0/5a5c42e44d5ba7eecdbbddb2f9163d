{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    if not l:\n        return []\n\n    even_elements = [l[i] for i in range(0, len(l), 2)]\n    sorted_even_elements = sorted(even_elements)\n\n    result_list = list(l) # Create a copy to preserve odd-indexed elements implicitly.\n\n    even_idx_counter = 0\n    for i in range(0, len(l), 2):\n        result_list[i] = sorted_even_elements[even_idx_counter]\n        even_idx_counter += 1\n\n    return result_list"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # reverse cycle elements in each group if it has 3 elements.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/32", "solution": "def find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    # Validate coefficients as per design context\n    if len(xs) % 2 != 0:\n        raise ValueError(\"Coefficients list must have an even number of elements.\")\n    if not xs:\n        raise ValueError(\"Coefficients list cannot be empty.\")\n    if xs[-1] == 0:\n        raise ValueError(\"The largest coefficient (coefficient of the highest degree term) cannot be zero.\")\n\n    # Bisection method parameters\n    epsilon = 1e-8   # Tolerance for convergence\n    max_iter = 1000  # Maximum iterations for bisection loop\n\n    # Step 1: Find a bracketing interval [low_bound, high_bound]\n    # For odd-degree polynomials (even number of coefficients), a real root is guaranteed.\n    # We expand the interval until poly(low_bound) and poly(high_bound) have opposite signs.\n    low_bound = -1.0\n    high_bound = 1.0\n    y_low = poly(xs, low_bound)\n    y_high = poly(xs, high_bound)\n\n    max_expansions = 100\n    for _ in range(max_expansions):\n        if abs(y_low) < epsilon:\n            return low_bound\n        if abs(y_high) < epsilon:\n            return high_bound\n        if y_low * y_high < 0:\n            break # Found a bracketing interval\n        \n        # Expand the interval exponentially\n        low_bound *= 2.0\n        high_bound *= 2.0\n        y_low = poly(xs, low_bound)\n        y_high = poly(xs, high_bound)\n    \n    # Step 2: Perform bisection within the found bracket\n    for _ in range(max_iter):\n        mid = (low_bound + high_bound) / 2.0\n        y_mid = poly(xs, mid)\n\n        if abs(y_mid) < epsilon:\n            return mid\n\n        # Determine which half contains the root based on sign change\n        if y_low * y_mid < 0:\n            high_bound = mid\n            y_high = y_mid\n        else:\n            low_bound = mid\n            y_low = y_mid\n\n    # If max_iter reached, return the midpoint of the final interval as the approximation\n    return (low_bound + high_bound) / 2.0"}
{"task_id": "HumanEval/39", "solution": "import math\ndef _is_square(n: int) -> bool:\n    \"\"\"Helper to check if a number is a perfect square.\"\"\"\n    if n < 0:\n        return False\n    s = int(math.sqrt(n))\n    return s * s == n\ndef is_fibonacci(num: int) -> bool:\n    \"\"\"\n    Determines if a given integer is a Fibonacci number.\n    Uses the property that a positive integer n is Fibonacci if 5n^2 + 4 or 5n^2 - 4 is a perfect square.\n    \"\"\"\n    if num < 0:\n        return False\n    if num == 0 or num == 1:\n        return True\n    \n    return _is_square(5 * num * num + 4) or _is_square(5 * num * num - 4)\ndef is_prime(num: int) -> bool:\n    \"\"\"\n    Determines if a given integer is a prime number.\n    Checks for divisibility up to the square root of the number.\n    \"\"\"\n    if num <= 1:\n        return False\n    if num == 2:\n        return True\n    if num % 2 == 0:\n        return False\n    for i in range(3, int(math.sqrt(num)) + 1, 2):\n        if num % i == 0:\n            return False\n    return True\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    count = 0\n    current_num = 1 \n\n    while True:\n        current_num += 1\n        \n        if is_fibonacci(current_num):\n            if is_prime(current_num):\n                count += 1\n                if count == n:\n                    return current_num"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n\n    def _is_divisible(num: int, divisor: int) -> bool:\n        \"\"\"Checks if a number is perfectly divisible by a given divisor.\"\"\"\n        return num % divisor == 0\n\n    def _count_digit_occurrences(num: int, digit: int) -> int:\n        \"\"\"Counts how many times a specific digit appears in a number.\"\"\"\n        return str(num).count(str(digit))\n\n    total_sevens_count = 0\n    target_digit = 7\n\n    for i in range(1, n):\n        if _is_divisible(i, 11) or _is_divisible(i, 13):\n            total_sevens_count += _count_digit_occurrences(i, target_digit)\n\n    return total_sevens_count"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    it returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    if len(l) < 3:\n        return False\n\n    n = len(l)\n    for i in range(n):\n        for j in range(i + 1, n):\n            for k in range(j + 1, n):\n                current_sum = l[i] + l[j] + l[k]\n                if current_sum == 0:\n                    return True\n\n    return False"}
