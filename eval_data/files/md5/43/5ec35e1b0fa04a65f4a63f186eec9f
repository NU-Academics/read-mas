{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n\n    For example:\n    >>> special_factorial(4)\n    288\n\n    The function will receive an integer as input and should return the special\n    factorial of this integer.\n    \"\"\"\n\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n    if n <= 0:\n        raise ValueError(\"Input must be greater than 0.\")\n\n    def factorial(k):\n        \"\"\"Calculates the standard factorial of an integer k.\"\"\"\n        if k == 0:\n            return 1\n        res = 1\n        for i in range(1, k + 1):\n            res *= i\n        return res\n\n    special_fact_result = 1\n    for i in range(1, n + 1):\n        special_fact_result *= factorial(i)\n\n    return special_fact_result"}
{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores,\n    and if a string has more than 2 consecutive spaces,\n    then replace all consecutive spaces with -\n    \"\"\"\n    # First, replace sequences of two or more spaces with a hyphen.\n    intermediate_text = re.sub(r'\\s{2,}', '-', text)\n    # Then, replace any remaining single spaces (which were not part of 2+ consecutive spaces) with an underscore.\n    final_text = re.sub(r'\\s', '_', intermediate_text)\n    return final_text"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    This function processes a list of integers, applying index-based transformations, and returns the sum of the modified entries.\n    \"\"\"\n    total_sum = 0\n    for index, value in enumerate(lst):\n        if index % 3 == 0:\n            total_sum += value ** 2\n        elif index % 4 == 0:\n            total_sum += value ** 3\n        else:\n            total_sum += value\n    return total_sum"}
{"task_id": "HumanEval/141", "solution": "def _has_valid_digit_count(name: str) -> bool:\n    \"\"\"Checks if the string contains no more than three digits.\"\"\"\n    digit_count = 0\n    for char in name:\n        if '0' <= char <= '9':\n            digit_count += 1\n    return digit_count <= 3\ndef _has_exactly_one_dot(name: str) -> bool:\n    \"\"\"Checks if the string contains exactly one dot.\"\"\"\n    return name.count('.') == 1\ndef _has_valid_name_part_format(name_part: str) -> bool:\n    \"\"\"Checks if the name part is not empty and starts with a Latin alphabet letter.\"\"\"\n    if not name_part:\n        return False\n    return 'a' <= name_part[0] <= 'z' or 'A' <= name_part[0] <= 'Z'\ndef _has_valid_extension_type(extension_part: str) -> bool:\n    \"\"\"Checks if the extension part is one of the allowed types.\"\"\"\n    allowed_extensions = ['txt', 'exe', 'dll']\n    return extension_part in allowed_extensions\ndef file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    \"\"\"\n    if not _has_exactly_one_dot(file_name):\n        return 'No'\n\n    parts = file_name.split('.', 1)\n    name_part = parts[0]\n    extension_part = parts[1]\n\n    if not _has_valid_digit_count(file_name):\n        return 'No'\n\n    if not _has_valid_name_part_format(name_part):\n        return 'No'\n\n    if not _has_valid_extension_type(extension_part):\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/144", "solution": "class Fraction:\n    \"\"\"Represents a mathematical fraction with a numerator and a denominator.\"\"\"\n    def __init__(self, numerator: int, denominator: int):\n        self.numerator = numerator\n        self.denominator = denominator\n\n    @staticmethod\n    def from_string(fraction_str: str) -> 'Fraction':\n        \"\"\"Parses a string '<numerator>/<denominator>' into a Fraction object.\"\"\"\n        num_str, den_str = fraction_str.split('/')\n        return Fraction(int(num_str), int(den_str))\n\n    def multiply(self, other: 'Fraction') -> 'Fraction':\n        \"\"\"Multiplies this fraction by another fraction.\"\"\"\n        new_numerator = self.numerator * other.numerator\n        new_denominator = self.denominator * other.denominator\n        return Fraction(new_numerator, new_denominator)\n\n    def is_whole_number(self) -> bool:\n        \"\"\"Determines if the fraction represents a whole number.\"\"\"\n        return self.numerator % self.denominator == 0\ndef simplify(x, n):\n    \"\"\"Your task is to implement a function that will simplify the expression\n    x * n. The function returns True if x * n evaluates to a whole number and False\n    otherwise. Both x and n, are string representation of a fraction, and have the following format,\n    <numerator>/<denominator> where both numerator and denominator are positive whole numbers.\n\n    You can assume that x, and n are valid fractions, and do not have zero as denominator.\n\n    simplify(\"1/5\", \"5/1\") = True\n    simplify(\"1/6\", \"2/1\") = False\n    simplify(\"7/10\", \"10/2\") = False\n    \"\"\"\n    # Parse the input fraction strings into Fraction objects.\n    frac_x = Fraction.from_string(x)\n    frac_n = Fraction.from_string(n)\n\n    # Multiply the two fractions to get the product.\n    product_fraction = frac_x.multiply(frac_n)\n\n    # Check if the product fraction is a whole number.\n    return product_fraction.is_whole_number()"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Filters words in a sentence, keeping only those whose lengths are prime numbers.\n    The order of words is preserved in the output string.\n    \"\"\"\n    def is_prime(n):\n        \"\"\"Checks if a given integer n is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    words = sentence.split()\n    prime_length_words = []\n    for word in words:\n        if is_prime(len(word)):\n            prime_length_words.append(word)\n\n    return \" \".join(prime_length_words)"}
