{"task_id": "HumanEval/3", "solution": "def below_zero(operations: List[int]) -> bool:\n    \"\"\" Checks if a bank account balance, starting at zero, ever falls below zero after a sequence of operations. \"\"\"\n    balance = 0\n    for op in operations:\n        balance += op\n        if balance < 0:\n            return True\n    return False"}
{"task_id": "HumanEval/0", "solution": "from typing import List\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    \"\"\"\n    n = len(numbers)\n\n    # Handle empty or single-element list, as no two distinct numbers can be found.\n    if n < 2:\n        return False\n\n    # A non-positive threshold means no positive absolute difference can be strictly less than it.\n    if threshold <= 0:\n        return False\n\n    # Sort the list to efficiently check only adjacent elements for proximity.\n    sorted_numbers = sorted(numbers)\n\n    for i in range(n - 1):\n        if abs(sorted_numbers[i] - sorted_numbers[i+1]) < threshold:\n            return True\n\n    return False"}
{"task_id": "HumanEval/2", "solution": "def truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    import math\n    return number - math.floor(number)"}
{"task_id": "HumanEval/5", "solution": "from typing import List\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'.\n    >>> intersperse([], 4)\n    []\n    >>> intersperse([1, 2, 3], 4)\n    [1, 4, 2, 4, 3]\n    \"\"\"\n    if not numbers:\n        return []\n\n    result = []\n    for i, num in enumerate(numbers):\n        result.append(num)\n        if i < len(numbers) - 1:\n            result.append(delimeter)\n    return result"}
{"task_id": "HumanEval/4", "solution": "from typing import List\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    if not numbers:\n        return 0.0\n\n    # Helper function to calculate the mean of a list of numbers.\n    def _calculate_mean(data: List[float]) -> float:\n        return sum(data) / len(data)\n\n    # Helper function to calculate absolute differences from the mean.\n    def _calculate_absolute_differences(data: List[float], mean_val: float) -> List[float]:\n        return [abs(x - mean_val) for x in data]\n\n    # Helper function to calculate the average of a list of numbers.\n    def _calculate_average(data: List[float]) -> float:\n        return sum(data) / len(data)\n\n    data_mean = _calculate_mean(numbers)\n    abs_diffs = _calculate_absolute_differences(numbers, data_mean)\n    mad = _calculate_average(abs_diffs)\n    return mad"}
{"task_id": "HumanEval/1", "solution": "from typing import List\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n\n    def _remove_spaces(s: str) -> str:\n        \"\"\"Removes all space characters from a given string.\"\"\"\n        return s.replace(' ', '')\n\n    def _find_balanced_groups(s: str) -> List[str]:\n        \"\"\"Identifies and extracts top-level, balanced, non-nested parenthesis groups from a string.\"\"\"\n        results: List[str] = []\n        current_group_chars: List[str] = []\n        balance: int = 0\n\n        for char in s:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n\n            # Only collect characters if we are currently inside a potential group\n            # (balance > 0 implies an open group, or we're closing the last char of a top-level group)\n            if balance > 0 or (char == ')' and len(current_group_chars) > 0):\n                current_group_chars.append(char)\n\n            # If balance returns to 0 and we have collected characters, a complete top-level group has ended.\n            if balance == 0 and len(current_group_chars) > 0:\n                results.append(\"\".join(current_group_chars))\n                current_group_chars = [] # Reset for the next group\n\n        return results\n\n    cleaned_string = _remove_spaces(paren_string)\n    return _find_balanced_groups(cleaned_string)"}
{"task_id": "HumanEval/7", "solution": "from typing import List\ndef filter_by_substring(strings: List[str], substring: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that contain given substring\n    >>> filter_by_substring([], 'a')\n    []\n    >>> filter_by_substring(['abc', 'bacd', 'cde', 'array'], 'a')\n    ['abc', 'bacd', 'array']\n    \"\"\"\n    filtered_strings = []\n    for s in strings:\n        if substring in s:\n            filtered_strings.append(s)\n    return filtered_strings"}
{"task_id": "HumanEval/9", "solution": "def rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    current_max = float('-inf')\n    result = []\n    for num in numbers:\n        current_max = max(current_max, num)\n        result.append(current_max)\n    return result"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    current_sum = 0\n    current_product = 1\n\n    for number in numbers:\n        current_sum += number\n        current_product *= number\n\n    return (current_sum, current_product)"}
{"task_id": "HumanEval/6", "solution": "from typing import List\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    def _calculate_group_nesting(group_string: str) -> int:\n        \"\"\"Calculates the deepest nesting level for a single parentheses group.\"\"\"\n        current_depth = 0\n        max_depth = 0\n        for char in group_string:\n            if char == '(':\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif char == ')':\n                current_depth -= 1\n        return max_depth\n\n    if not paren_string.strip():\n        return []\n\n    paren_groups = paren_string.split(' ')\n    result_list: List[int] = []\n\n    for group in paren_groups:\n        if group:  # Ensure the group is not an empty string (e.g., from multiple spaces)\n            nesting_level = _calculate_group_nesting(group)\n            result_list.append(nesting_level)\n\n    return result_list"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    result = []\n    for char_a, char_b in zip(a, b):\n        if char_a == char_b:\n            result.append('0')\n        else:\n            result.append('1')\n    return \"\".join(result)"}
{"task_id": "HumanEval/10", "solution": "def make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    \"\"\"\n    def _reverse_string(s: str) -> str:\n        \"\"\"Helper to reverse a string.\"\"\"\n        return s[::-1]\n\n    def is_palindrome(s: str) -> bool:\n        \"\"\" Test if given string is a palindrome \"\"\"\n        return s == _reverse_string(s)\n\n    def _find_longest_palindromic_postfix(s: str) -> str:\n        \"\"\"Helper to find the longest palindromic postfix of a string.\"\"\"\n        if not s:\n            return \"\"\n        for i in range(len(s)):\n            postfix = s[i:]\n            if is_palindrome(postfix):\n                return postfix\n        return \"\" # This should not be reached for non-empty strings.\n\n    if not string:\n        return \"\"\n\n    longest_pal_postfix = _find_longest_palindromic_postfix(string)\n\n    prefix_before_postfix = string[:len(string) - len(longest_pal_postfix)]\n\n    return string + _reverse_string(prefix_before_postfix)"}
{"task_id": "HumanEval/14", "solution": "def all_prefixes(string: str) -> List[str]:\n    \"\"\" Return list of all prefixes from shortest to longest of the input string\n    >>> all_prefixes('abc')\n    ['a', 'ab', 'abc']\n    \"\"\"\n    prefixes: List[str] = []\n    for i in range(1, len(string) + 1):\n        prefixes.append(string[0:i])\n    return prefixes"}
{"task_id": "HumanEval/15", "solution": "def string_sequence(n: int) -> str:\n    \"\"\" Return a string containing space-delimited numbers starting from 0 upto n inclusive.\n    \"\"\"\n    return \" \".join(str(i) for i in range(n + 1))"}
{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    \"\"\"\n    if not strings:\n        return None\n\n    max_length_string = strings[0]\n    for s in strings[1:]:\n        if len(s) > len(max_length_string):\n            max_length_string = s\n    return max_length_string"}
{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    a = abs(a)\n    b = abs(b)\n    while b:\n        a, b = b, a % b\n    return a"}
{"task_id": "HumanEval/16", "solution": "def count_distinct_characters(string: str) -> int:\n    \"\"\" Given a string, find out how many distinct characters (regardless of case) does it consist of\n    >>> count_distinct_characters('xyzXYZ')\n    3\n    >>> count_distinct_characters('Jerry')\n    4\n    \"\"\"\n    # Convert the input string to lowercase to handle case-insensitivity.\n    lower_string = string.lower()\n    # Use a set to store unique characters.\n    distinct_chars = set()\n    for char in lower_string:\n        distinct_chars.add(char)\n    return len(distinct_chars)"}
