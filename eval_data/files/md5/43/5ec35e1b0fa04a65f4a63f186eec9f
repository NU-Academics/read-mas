{"task_id": "HumanEval/145", "solution": "from typing import List\nfrom dataclasses import dataclass\ndef _calculate_absolute_digit_sum(number: int) -> int:\n    \"\"\"Calculates the sum of the absolute values of the digits of an integer.\"\"\"\n    s = 0\n    for digit in str(abs(number)):\n        s += int(digit)\n    return s\ndef order_by_points(nums: List[int]) -> List[int]:\n    \"\"\"\n    Sorts the given list of integers in ascending order according to the sum of their digits.\n    Note: if there are several items with similar sum of their digits,\n    order them based on their index in original list.\n    \"\"\"\n    if not nums:\n        return []\n\n    entries = []\n    for i, num in enumerate(nums):\n        digit_sum = _calculate_absolute_digit_sum(num)\n        entries.append(DigitSumEntry(value=num, absolute_digit_sum=digit_sum, original_index=i))\n\n    entries.sort(key=lambda entry: (entry.absolute_digit_sum, entry.original_index))\n\n    return [entry.value for entry in entries]"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"\n    Counts elements greater than 10 with odd first and last digits.\n    Digits are extracted from the absolute value of the number.\n    \"\"\"\n\n    def _is_greater_than_10(num):\n        \"\"\"Checks if a number is strictly greater than 10.\"\"\"\n        return num > 10\n\n    def _get_first_digit(num):\n        \"\"\"Extracts the first digit of a number's absolute value.\"\"\"\n        abs_num = abs(num)\n        if abs_num == 0:\n            return 0\n        while abs_num >= 10:\n            abs_num //= 10\n        return abs_num\n\n    def _get_last_digit(num):\n        \"\"\"Extracts the last digit of a number's absolute value.\"\"\"\n        return abs(num) % 10\n\n    def _is_odd(digit):\n        \"\"\"Checks if a given digit is odd (1, 3, 5, 7, 9).\"\"\"\n        return digit in (1, 3, 5, 7, 9)\n\n    count = 0\n    for num in nums:\n        if _is_greater_than_10(num):\n            first_digit = _get_first_digit(num)\n            last_digit = _get_last_digit(num)\n            if _is_odd(first_digit) and _is_odd(last_digit):\n                count += 1\n    return count"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Calculates the number of triples (a[i], a[j], a[k]) such that i < j < k and their sum is a multiple of 3.\n    It first generates array 'a' where a[x] = x*x - x + 1 for 1-based index x.\n    \"\"\"\n\n    def _calculate_array_element(index):\n        \"\"\"Calculates the value of an array element for a given 1-based index.\"\"\"\n        return index * index - index + 1\n\n    def _is_sum_multiple_of_3(val1, val2, val3):\n        \"\"\"Checks if the sum of three integer values is a multiple of 3.\"\"\"\n        return (val1 + val2 + val3) % 3 == 0\n\n    a_values = []\n    for i in range(1, n + 1):\n        a_values.append(_calculate_array_element(i))\n\n    valid_triples_count = 0\n    # Iterate through all possible combinations of three distinct indices i, j, k such that i < j < k.\n    # These indices are 0-based for list access.\n    for i in range(n - 2):\n        for j in range(i + 1, n - 1):\n            for k in range(j + 1, n):\n                if _is_sum_multiple_of_3(a_values[i], a_values[j], a_values[k]):\n                    valid_triples_count += 1\n\n    return valid_triples_count"}
{"task_id": "HumanEval/148", "solution": "import functools\nfrom typing import List, Dict, Tuple, Optional\nclass SolarSystem:\n    \"\"\"Manages the collection of planets and provides methods for planet-related queries.\"\"\"\n    _instance: Optional['SolarSystem'] = None\n\n    def __new__(cls):\n        if cls._instance is None:\n            cls._instance = super(SolarSystem, cls).__new__(cls)\n            cls._instance._initialize_planets()\n        return cls._instance\n\n    def _initialize_planets(self):\n        planet_data = [\n            (\"Mercury\", 1),\n            (\"Venus\", 2),\n            (\"Earth\", 3),\n            (\"Mars\", 4),\n            (\"Jupiter\", 5),\n            (\"Saturn\", 6),\n            (\"Uranus\", 7),\n            (\"Neptune\", 8),\n        ]\n        self._planets_by_name: Dict[str, Planet] = {}\n        self._planets_ordered: List[Planet] = []\n\n        for name, order in planet_data:\n            planet = Planet(name, order)\n            self._planets_by_name[name] = planet\n            self._planets_ordered.append(planet)\n\n        self._planets_ordered.sort()\n\n    def get_planet_by_name(self, name: str) -> Optional[Planet]:\n        \"\"\"Retrieves a Planet object by its name.\"\"\"\n        return self._planets_by_name.get(name)\n\n    def get_planets_between(self, planet1_name: str, planet2_name: str) -> Tuple[str, ...]:\n        \"\"\"Identifies and returns sorted planet names strictly between two given planets.\"\"\"\n        planet1_obj = self.get_planet_by_name(planet1_name)\n        planet2_obj = self.get_planet_by_name(planet2_name)\n\n        min_order = min(planet1_obj.order, planet2_obj.order)\n        max_order = max(planet1_obj.order, planet2_obj.order)\n\n        between_planets: List[str] = [\n            p.name for p in self._planets_ordered\n            if min_order < p.order < max_order\n        ]\n        return tuple(between_planets)\n_solar_system_instance = SolarSystem()\ndef bf(planet1, planet2):\n    '''\n    There are eight planets in our solar system: the closerst to the Sun\n    is Mercury, the next one is Venus, then Earth, Mars, Jupiter, Saturn,\n    Uranus, Neptune.\n    Write a function that takes two planet names as strings planet1 and planet2.\n    The function should return a tuple containing all planets whose orbits are\n    located between the orbit of planet1 and the orbit of planet2, sorted by\n    the proximity to the sun.\n    The function should return an empty tuple if planet1 or planet2\n    are not correct planet names.\n    Examples\n    bf(\"Jupiter\", \"Neptune\") ==> (\"Saturn\", \"Uranus\")\n    bf(\"Earth\", \"Mercury\") ==> (\"Venus\")\n    bf(\"Mercury\", \"Uranus\") ==> (\"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\")\n    '''\n    p1_obj = _solar_system_instance.get_planet_by_name(planet1)\n    p2_obj = _solar_system_instance.get_planet_by_name(planet2)\n\n    if p1_obj is None or p2_obj is None:\n        return ()\n\n    return _solar_system_instance.get_planets_between(planet1, planet2)"}
{"task_id": "HumanEval/149", "solution": "def sorted_list_sum(lst):\n    \"\"\"Deletes strings with odd lengths from the list, then returns the result sorted by length ascending, and alphabetically for ties.\"\"\"\n    even_length_strings = []\n    for s in lst:\n        if len(s) % 2 == 0:\n            even_length_strings.append(s)\n\n    even_length_strings.sort(key=lambda x: (len(x), x))\n\n    return even_length_strings"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension based on CAP - SM strength and returns the formatted class and extension name.\"\"\"\n\n    max_strength = -float('inf')\n    strongest_extension_name = \"\"\n\n    for extension_name in extensions:\n        cap_count = 0\n        sm_count = 0\n        for char in extension_name:\n            if 'A' <= char <= 'Z':\n                cap_count += 1\n            elif 'a' <= char <= 'z':\n                sm_count += 1\n\n        current_strength = cap_count - sm_count\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = extension_name\n\n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/150", "solution": "def is_prime(num):\n    \"\"\"Checks if a number is prime.\"\"\"\n    if num <= 1:\n        return False\n    if num == 2:\n        return True\n    if num % 2 == 0:\n        return False\n    i = 3\n    while i * i <= num:\n        if num % i == 0:\n            return False\n        i += 2\n    return True\ndef x_or_y(n, x, y):\n    \"\"\"A simple program which should return the value of x if n is\n    a prime number and should return the value of y otherwise.\n\n    Examples:\n    for x_or_y(7, 34, 12) == 34\n    for x_or_y(15, 8, 5) == 5\n\n    \"\"\"\n    if is_prime(n):\n        return x\n    else:\n        return y"}
{"task_id": "HumanEval/151", "solution": "def double_the_difference(lst):\n    \"\"\"\n    Calculates the sum of squares of odd, positive integers in the input list.\n    Ignores negative numbers and non-integer values, returning 0 if the list is empty.\n    \"\"\"\n    sum_of_squares = 0\n    if not lst:\n        return 0\n\n    for num in lst:\n        # Check if it's an integer, positive, and odd\n        if isinstance(num, int) and num > 0 and num % 2 != 0:\n            sum_of_squares += num * num\n\n    return sum_of_squares"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer, return a tuple that has the number of even and odd digits respectively.\"\"\"\n    even_count = 0\n    odd_count = 0\n\n    if num == 0:\n        return (1, 0) # The digit 0 is even.\n\n    num = abs(num) # Process the absolute value of the number.\n\n    while num > 0:\n        digit = num % 10\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n        num //= 10\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase.\n    Restrictions: 1 <= num <= 1000\n\n    Examples:\n    >>> int_to_mini_roman(19) == 'xix'\n    >>> int_to_mini_roman(152) == 'clii'\n    >>> int_to_mini_roman(426) == 'cdxxvi'\n    \"\"\"\n    if not (1 <= number <= 1000):\n        raise ValueError(\"Input number must be between 1 and 1000, inclusive.\")\n\n    roman_map = [\n        (1000, 'm'), (900, 'cm'), (500, 'd'), (400, 'cd'),\n        (100, 'c'), (90, 'xc'), (50, 'l'), (40, 'xl'),\n        (10, 'x'), (9, 'ix'), (5, 'v'), (4, 'iv'),\n        (1, 'i')\n    ]\n\n    result = []\n    for value, numeral in roman_map:\n        while number >= value:\n            result.append(numeral)\n            number -= value\n    return \"\".join(result)"}
{"task_id": "HumanEval/152", "solution": "def compare(game,guess):\n    \"\"\"Returns an array of the same length denoting how far off each guess was.\n    If guessed correctly, the value is 0, otherwise it's the absolute difference.\n    \"\"\"\n\n    class MatchComparison:\n        \"\"\"Encapsulates logic for a single match comparison, calculating its absolute difference.\"\"\"\n        def __init__(self, actual_score: int, player_guess: int):\n            self._actual_score = actual_score\n            self._player_guess = player_guess\n            if self._actual_score == self._player_guess:\n                self._difference = 0\n            else:\n                self._difference = abs(self._actual_score - self._player_guess)\n\n        def get_difference(self) -> int:\n            \"\"\"Returns the calculated difference for this match.\"\"\"\n            return self._difference\n\n    class OverallComparisonResult:\n        \"\"\"Aggregates multiple MatchComparison objects and provides the final report of all differences.\"\"\"\n        def __init__(self):\n            self._match_comparisons: list[MatchComparison] = []\n\n        def add_match_comparison(self, match_comparison: MatchComparison):\n            \"\"\"Adds a single MatchComparison object to the aggregated results.\"\"\"\n            self._match_comparisons.append(match_comparison)\n\n        def generate_comparison_report(self) -> list[int]:\n            \"\"\"Iterates through aggregated MatchComparison objects and returns a list of their differences.\"\"\"\n            return [mc.get_difference() for mc in self._match_comparisons]\n\n    overall_result = OverallComparisonResult()\n    for actual_score, player_guess in zip(game, guess):\n        match_comp = MatchComparison(actual_score, player_guess)\n        overall_result.add_match_comparison(match_comp)\n\n    return overall_result.generate_comparison_report()"}
{"task_id": "HumanEval/154", "solution": "def _generate_rotations(s: str) -> list[str]:\n    \"\"\"Generates all unique cyclic rotations of the input string s.\"\"\"\n    if not s:\n        return [\"\"]\n\n    rotations_set = set()\n    for i in range(len(s)):\n        rotations_set.add(s[i:] + s[:i])\n    return list(rotations_set)\ndef _is_substring(text: str, pattern: str) -> bool:\n    \"\"\"Checks if 'pattern' is a substring of 'text'.\"\"\"\n    return pattern in text\ndef cycpattern_check(a: str, b: str) -> bool:\n    \"\"\"Checks if any cyclic rotation of string 'b' is a substring of string 'a'.\"\"\"\n\n    rotations_b = _generate_rotations(b)\n\n    for rotation in rotations_b:\n        if _is_substring(a, rotation):\n            return True\n\n    return False"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or\n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    '''\n    sides = [a, b, c]\n    sides.sort()\n    s1, s2, s3 = sides[0], sides[1], sides[2]\n    return (s1**2 + s2**2 == s3**2)"}
{"task_id": "HumanEval/158", "solution": "def _count_unique_chars(word):\n    \"\"\"Calculates the number of unique characters in a given string.\"\"\"\n    return len(set(word))\ndef find_max(words):\n    \"\"\"Finds the word with the maximum number of unique characters from a list of strings.\n    If multiple strings have the maximum number of unique characters, it returns the one\n    which comes first in lexicographical order.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_unique_count = -1\n    result_word = \"\"\n\n    for word in words:\n        current_unique_count = _count_unique_chars(word)\n\n        if current_unique_count > max_unique_count:\n            max_unique_count = current_unique_count\n            result_word = word\n        elif current_unique_count == max_unique_count:\n            # Tie-breaking: return the one which comes first in lexicographical order\n            if result_word == \"\" or word < result_word:\n                result_word = word\n\n    return result_word"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    You're a hungry rabbit, and you already have eaten a certain number of carrots,\n    but now you need to eat more carrots to complete the day's meals.\n    you should return an array of [ total number of eaten carrots after your meals,\n                                    the number of carrots left after your meals ]\n    if there are not enough remaining carrots, you will eat all remaining carrots, but will still be hungry.\n\n    Example:\n    * eat(5, 6, 10) -> [11, 4]\n    * eat(4, 8, 9) -> [12, 1]\n    * eat(1, 10, 10) -> [11, 0]\n    * eat(2, 11, 5) -> [7, 0]\n\n    Variables:\n    @number : integer\n        the number of carrots that you have eaten.\n    @need : integer\n        the number of carrots that you need to eat.\n    @remaining : integer\n        the number of remaining carrots thet exist in stock\n\n    Constrain:\n    * 0 <= number <= 1000\n    * 0 <= need <= 1000\n    * 0 <= remaining <= 1000\n\n    Have fun :)\n    \"\"\"\n    if remaining >= need:\n        carrots_eaten_in_meal = need\n        carrots_left = remaining - need\n    else:\n        carrots_eaten_in_meal = remaining\n        carrots_left = 0\n\n    total_eaten = number + carrots_eaten_in_meal\n\n    return [total_eaten, carrots_left]"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    # Helper function to check if the string contains any letters.\n    def _has_letters(s_local):\n        for char in s_local:\n            if char.isalpha():\n                return True\n        return False\n\n    # Helper function to process a single character: reverse its case if it's a letter, otherwise keep unchanged.\n    def _process_char(char_local):\n        if char_local.isalpha():\n            if char_local.islower():\n                return char_local.upper()\n            else:\n                return char_local.lower()\n        return char_local\n\n    # Helper function to reverse the entire string.\n    def _reverse_string(s_local):\n        return s_local[::-1]\n\n    if _has_letters(s):\n        processed_chars = []\n        for char in s:\n            processed_chars.append(_process_char(char))\n        return \"\".join(processed_chars)\n    else:\n        return _reverse_string(s)"}
{"task_id": "HumanEval/162", "solution": "import hashlib\nfrom typing import Optional\ndef string_to_md5(text: str) -> Optional[str]:\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n\n    >>> string_to_md5('Hello world') == '3e25960a79dbc69b674cd4ec67a72c62'\n    \"\"\"\n    if not text:\n        return None\n    # Encode the string to bytes before hashing.\n    md5_hash = hashlib.md5(text.encode('utf-8'))\n    return md5_hash.hexdigest()"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Evaluates an algebraic expression built from a list of operators and operands.\n    The expression respects standard operator precedence.\n    \"\"\"\n\n    class Operand:\n        def __init__(self, value: int):\n            self.value = value\n\n    class Operator:\n        def __init__(self, symbol: str):\n            self.symbol = symbol\n\n    class Expression:\n        def __init__(self, operators: list[Operator], operands: list[Operand]):\n            self._expression_string = self._build_expression_string(operators, operands)\n\n        def _build_expression_string(self, operators: list[Operator], operands: list[Operand]) -> str:\n            # Constructs the expression string in infix notation.\n            parts = []\n            for i in range(len(operators)):\n                parts.append(str(operands[i].value))\n                parts.append(operators[i].symbol)\n            parts.append(str(operands[-1].value))\n            return \" \".join(parts)\n\n        def evaluate(self) -> int:\n            # Evaluates the constructed expression string using Python's eval().\n            return eval(self._expression_string)\n\n    # Input validation, as per design, would typically be in a helper.\n    # For this completion, we assume inputs conform to the problem description constraints.\n\n    # Convert raw lists to domain objects\n    operand_objs = [Operand(val) for val in operand]\n    operator_objs = [Operator(op) for op in operator]\n\n    # Create and evaluate the expression\n    expr = Expression(operator_objs, operand_objs)\n    return expr.evaluate()"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a\n    and b, in ascending order.\n\n    For example:\n    generate_integers(2, 8) => [2, 4, 6, 8]\n    generate_integers(8, 2) => [2, 4, 6, 8]\n    generate_integers(10, 14) => []\n    \"\"\"\n    lower_bound = min(a, b)\n    upper_bound = max(a, b)\n\n    result = []\n    for i in range(lower_bound, upper_bound + 1):\n        # Check if the number is a single digit (0-9) and even.\n        if 0 <= i <= 9 and i % 2 == 0:\n            result.append(i)\n\n    return result"}
