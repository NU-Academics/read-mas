{"task_id": "HumanEval/36", "solution": "def _is_divisible_by_11_or_13(num: int) -> bool:\n    \"\"\"Checks if a number is divisible by 11 or 13.\"\"\"\n    return (num % 11 == 0) or (num % 13 == 0)\ndef _count_digit_seven(num: int) -> int:\n    \"\"\"Counts occurrences of the digit '7' in a number.\"\"\"\n    count = 0\n    for digit_char in str(num):\n        if digit_char == '7':\n            count += 1\n    return count\ndef fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    total_sevens_count = 0\n    for i in range(1, n):\n        if _is_divisible_by_11_or_13(i):\n            total_sevens_count += _count_digit_seven(i)\n    return total_sevens_count"}
{"task_id": "HumanEval/32", "solution": "import math\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluates polynomial with coefficients xs at point x.\n    return xs[0] + xs[1] * x + xs[1] * x^2 + .... xs[n] * x^n\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\ndef find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n\n    tolerance = 1e-7\n    step_size = 0.001\n    max_search_magnitude = 100.0\n    max_iterations_bisection = 100\n\n    if abs(poly(xs, 0.0)) < tolerance:\n        return 0.0\n\n    found_bracket = False\n    low = high = 0.0\n\n    x_curr_scan = 0.0\n    p_x_prev_scan = poly(xs, x_curr_scan)\n\n    x_step_val = step_size\n    while x_step_val <= max_search_magnitude:\n        x_curr_scan = x_step_val\n        p_x_curr_scan = poly(xs, x_curr_scan)\n\n        if abs(p_x_curr_scan) < tolerance:\n            return x_curr_scan\n\n        if p_x_prev_scan * p_x_curr_scan < 0:\n            low = x_curr_scan - step_size\n            high = x_curr_scan\n            found_bracket = True\n            break\n\n        p_x_prev_scan = p_x_curr_scan\n        x_step_val += step_size\n\n    if not found_bracket:\n        x_curr_scan = 0.0\n        p_x_prev_scan = poly(xs, x_curr_scan)\n\n        x_step_val = -step_size\n        while x_step_val >= -max_search_magnitude:\n            x_curr_scan = x_step_val\n            p_x_curr_scan = poly(xs, x_curr_scan)\n\n            if abs(p_x_curr_scan) < tolerance:\n                return x_curr_scan\n\n            if p_x_prev_scan * p_x_curr_scan < 0:\n                low = x_curr_scan\n                high = x_curr_scan + step_size\n                found_bracket = True\n                break\n\n            p_x_prev_scan = p_x_curr_scan\n            x_step_val -= step_size\n\n    if not found_bracket:\n        low = -1000.0\n        high = 1000.0\n        p_low_initial = poly(xs, low)\n        p_high_initial = poly(xs, high)\n        if abs(p_low_initial) < tolerance: return low\n        if abs(p_high_initial) < tolerance: return high\n\n    p_low_val = poly(xs, low)\n    p_high_val = poly(xs, high)\n\n    for _ in range(max_iterations_bisection):\n        mid = (low + high) / 2.0\n        p_mid_val = poly(xs, mid)\n\n        if abs(p_mid_val) < tolerance:\n            return mid\n\n        if p_low_val * p_mid_val < 0:\n            high = mid\n            p_high_val = p_mid_val\n        else:\n            low = mid\n            p_low_val = p_mid_val\n\n    return (low + high) / 2.0"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    list_length = len(l)\n    even_elements_to_sort = []\n    output_list = [None] * list_length\n\n    # First Pass: Separate even-indexed elements and preserve odd-indexed elements\n    for i in range(list_length):\n        if i % 2 == 0:  # Even index\n            even_elements_to_sort.append(l[i])\n        else:  # Odd index\n            output_list[i] = l[i]\n\n    # Sort the collected even-indexed elements\n    even_elements_to_sort.sort()\n\n    # Second Pass: Place sorted even-indexed elements back into output_list\n    sorted_even_index = 0\n    for i in range(list_length):\n        if i % 2 == 0:  # Even index\n            output_list[i] = even_elements_to_sort[sorted_even_index]\n            sorted_even_index += 1\n\n    return output_list"}
