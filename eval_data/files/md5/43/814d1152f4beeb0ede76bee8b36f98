{"task_id": "HumanEval/22", "solution": "def filter_integers(values: List[Any]) -> List[int]:\n    \"\"\" Filter given list of any python values only for integers\n    >>> filter_integers(['a', 3.14, 5])\n    [5]\n    >>> filter_integers([1, 2, 3, 'abc', {}, []])\n    [1, 2, 3]\n    \"\"\"\n    return [v for v in values if isinstance(v, int)]"}
{"task_id": "HumanEval/27", "solution": "def flip_case(string: str) -> str:\n    \"\"\" For a given string, flip lowercase characters to uppercase and uppercase to lowercase.\n    >>> flip_case('Hello')\n    'hELLO'\n    \"\"\"\n    return string.swapcase()"}
{"task_id": "HumanEval/24", "solution": "import math\n\ndef largest_divisor(n: int) -> int:\n    \"\"\" For a given number n, find the largest number that divides n evenly, smaller than n\n    >>> largest_divisor(15)\n    5\n    \"\"\"\n    # Iterate from 2 up to the square root of n to find the smallest factor.\n    # If a factor 'i' is found, 'n // i' will be the largest divisor.\n    for i in range(2, math.isqrt(n) + 1):\n        if n % i == 0:\n            return n // i\n    # If no factor is found, n is a prime number, so its largest divisor is 1.\n    return 1"}
{"task_id": "HumanEval/25", "solution": "import math\n\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    factors = []\n    d = 2\n    temp_n = n\n\n    while d * d <= temp_n:\n        while temp_n % d == 0:\n            factors.append(d)\n            temp_n //= d\n        d += 1\n\n    if temp_n > 1:\n        factors.append(temp_n)\n    \n    return factors"}
{"task_id": "HumanEval/26", "solution": "from typing import List\n\n\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    >>> remove_duplicates([1, 2, 3, 2, 4])\n    [1, 3, 4]\n    \"\"\"\n    counts = {}\n    for n in numbers:\n        counts[n] = counts.get(n, 0) + 1\n\n    result = []\n    for n in numbers:\n        if counts[n] == 1:\n            result.append(n)\n    return result"}
{"task_id": "HumanEval/28", "solution": "def concatenate(strings: List[str]) -> str:\n    \"\"\" Concatenate list of strings into a single string\n    >>> concatenate([])\n    ''\n    >>> concatenate(['a', 'b', 'c'])\n    'abc'\n    \"\"\"\n    return \"\".join(strings)"}
{"task_id": "HumanEval/29", "solution": "def filter_by_prefix(strings: List[str], prefix: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that start with a given prefix.\n    >>> filter_by_prefix([], 'a')\n    []\n    >>> filter_by_prefix(['abc', 'bcd', 'cde', 'array'], 'a')\n    ['abc', 'array']\n    \"\"\"\n    return [s for s in strings if s.startswith(prefix)]"}
{"task_id": "HumanEval/30", "solution": "def get_positive(l: list):\n    \"\"\"Return only positive numbers in the list.\"\"\"\n    return [x for x in l if x > 0]"}
{"task_id": "HumanEval/31", "solution": "import math\n\ndef is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    This implementation uses trial division up to the square root of n.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    \n    # Check for factors from 3 up to sqrt(n)\n    # We only need to check odd numbers as even numbers were handled\n    limit = int(math.sqrt(n))\n    for i in range(3, limit + 1, 2):\n        if n % i == 0:\n            return False\n            \n    return True"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    if not l:\n        return []\n\n    # Extract elements at indices divisible by three\n    third_elements = []\n    third_indices = []\n    for i in range(len(l)):\n        if i % 3 == 0:\n            third_elements.append(l[i])\n            third_indices.append(i)\n\n    # Sort the extracted elements\n    third_elements.sort()\n\n    # Create a new list and insert sorted elements back\n    result = list(l) # Create a mutable copy of the input list\n    for i, original_index in enumerate(third_indices):\n        result[original_index] = third_elements[i]\n\n    return result"}
{"task_id": "HumanEval/34", "solution": "class UniqueProcessor:\n    \"\"\"Encapsulates the logic for deduplication and sorting.\"\"\"\n    def unique(self, input_list: list) -> list:\n        \"\"\"Removes duplicates and sorts a list.\"\"\"\n        return sorted(list(set(input_list)))\n\ndef unique(l: list) -> list:\n    \"\"\"Return sorted unique elements in a list\n    >>> unique([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [0, 2, 3, 5, 9, 123]\n    \"\"\"\n    processor = UniqueProcessor()\n    return processor.unique(l)"}
{"task_id": "HumanEval/32", "solution": "def find_zero(xs: list):\n    \"\"\" xs are coefficients of a polynomial.\n    find_zero find x such that poly(x) = 0.\n    find_zero returns only only zero point, even if there are many.\n    Moreover, find_zero only takes list xs having even number of coefficients\n    and largest non zero coefficient as it guarantees\n    a solution.\n    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x\n    -0.5\n    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3\n    1.0\n    \"\"\"\n    # Use the bisection method to find a root.\n    # Initial search range is set broadly to guarantee bracketing a root for odd-degree polynomials.\n    low = -10000.0\n    high = 10000.0\n\n    # Iterate a fixed number of times to achieve desired precision.\n    # 100 iterations significantly reduces the interval size.\n    for _ in range(100):\n        mid = (low + high) / 2.0\n        \n        val_low = poly(xs, low)\n        val_mid = poly(xs, mid)\n        \n        # If the mid-point is the root, return it immediately.\n        if val_mid == 0:\n            return mid\n        \n        # If the root is in the lower half of the interval [low, mid]\n        if val_low * val_mid < 0:\n            high = mid\n        # Otherwise, the root is in the upper half [mid, high]\n        else:\n            low = mid\n            \n    # Return the approximate root after iterations.\n    return (low + high) / 2.0"}
{"task_id": "HumanEval/35", "solution": "def max_element(l: list):\n    \"\"\"Return maximum element in the list.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    if not l:\n        raise ValueError(\"Input list must contain at least one element.\")\n    return max(l)"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    total_seven_count = 0\n    for i in range(1, n):\n        if i % 11 == 0 or i % 13 == 0:\n            total_seven_count += str(i).count('7')\n    return total_seven_count"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    if len(l) <= 1:\n        return list(l) # Return a copy for consistency, though not strictly required by BR4 for 0/1 elements\n\n    result_list = list(l) # Create a shallow copy of the input list\n\n    even_indexed_values = []\n    even_indices = []\n\n    # Extract values and store indices for even positions\n    for i in range(0, len(l), 2):\n        even_indexed_values.append(l[i])\n        even_indices.append(i)\n\n    # Sort the extracted values\n    even_indexed_values.sort()\n\n    # Place the sorted values back into the even positions of the result list\n    for i in range(len(even_indices)):\n        result_list[even_indices[i]] = even_indexed_values[i]\n\n    return result_list"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # cycle elements in each group back to original. Unless group has fewer elements than 3.\n    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    def is_prime(num: int) -> bool:\n        \"\"\"Checks if a number is prime.\"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    count = 0\n    a, b = 0, 1 # Initialize for Fibonacci sequence F(0)=0, F(1)=1\n\n    while True:\n        # 'b' represents the current Fibonacci number\n        \n        if b > 1 and is_prime(b):\n            count += 1\n            if count == n:\n                return b\n        \n        # Calculate the next Fibonacci number in the sequence\n        a, b = b, a + b"}
