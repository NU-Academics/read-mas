{"task_id": "HumanEval/67", "solution": "import re\n\n\ndef fruit_distribution(s, n):\n    \"\"\"\n    Calculates the number of mango fruits in a basket given a string with apple and orange counts and the total fruits.\n    \"\"\"\n    pattern = r\"(\\d+) apples and (\\d+) oranges\"\n    match = re.search(pattern, s)\n    \n    # Assuming valid input based on problem description and examples,\n    # the match will always be found and groups will be convertible to int.\n    apples = int(match.group(1))\n    oranges = int(match.group(2))\n    \n    mangoes = n - apples - oranges\n    return mangoes"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even value and its smallest index in an array.\n    Returns [value, index] or an empty list if no even values are found.\n    \"\"\"\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for i, num in enumerate(arr):\n        if num % 2 == 0:  # Check if the number is even\n            if num < smallest_even_value:\n                smallest_even_value = num\n                smallest_even_index = i\n            # If num == smallest_even_value, we do nothing because we prioritize the smallest index,\n            # and our iteration order naturally ensures the first occurrence's index is kept.\n\n    if smallest_even_index != -1:  # An even value was found\n        return [smallest_even_value, smallest_even_index]\n    else:  # No even values found or array was empty\n        return []"}
{"task_id": "HumanEval/69", "solution": "import collections\n\ndef search(lst):\n    '''\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than \n    zero, and has a frequency greater than or equal to the value of the integer itself. \n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    Examples:\n        search([4, 1, 2, 2, 3, 1]) == 2\n        search([1, 2, 2, 3, 3, 3, 4, 4, 4]) == 3\n        search([5, 5, 4, 4, 4]) == -1\n    '''\n    frequency_map = collections.Counter(lst)\n    \n    greatest_qualifying_integer = -1\n    \n    # Iterate through unique values in descending order to find the greatest qualifying one efficiently\n    # The problem implies positive integers, so we sort them from largest to smallest.\n    # The `frequency_map` might contain keys that are not present in the original `lst` if we used\n    # a different approach, but `collections.Counter` only creates keys for elements it sees.\n    # We iterate over the unique elements present in the original list.\n    unique_sorted_values = sorted(frequency_map.keys(), reverse=True)\n\n    for value in unique_sorted_values:\n        # Check if the integer value is positive and its frequency meets the condition.\n        # The problem statement implies positive integers in the input list, so `value > 0`\n        # is implicitly handled by the input constraints, but we keep it explicit per definition.\n        if value > 0 and frequency_map[value] >= value:\n            greatest_qualifying_integer = value\n            break # Since we are iterating in descending order, the first one found is the greatest.\n            \n    return greatest_qualifying_integer"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n    '''\n    if not lst:\n        return []\n\n    sorted_lst = sorted(lst)\n    result = []\n    min_idx = 0\n    max_idx = len(sorted_lst) - 1\n\n    while min_idx <= max_idx:\n        result.append(sorted_lst[min_idx])\n        min_idx += 1\n        if min_idx <= max_idx:\n            result.append(sorted_lst[max_idx])\n            max_idx -= 1\n    return result"}
{"task_id": "HumanEval/71", "solution": "import math\n\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle. \n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater \n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    '''\n    # Check if sides are positive and satisfy the triangle inequality.\n    if not (a > 0 and b > 0 and c > 0 and\n            a + b > c and\n            a + c > b and\n            b + c > a):\n        return -1\n\n    # Calculate the semi-perimeter.\n    s = (a + b + c) / 2\n\n    # Calculate the area using Heron's formula.\n    area = math.sqrt(s * (s - a) * (s - b) * (s - c))\n\n    return round(area, 2)"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    \"\"\"\n    Checks if the object q will fly based on palindromic balance and weight constraint.\n    Returns True if q is a palindrome and its sum is less than or equal to w, False otherwise.\n    \"\"\"\n    is_palindrome = (q == q[::-1])\n    current_weight = sum(q)\n    is_within_weight_limit = (current_weight <= w)\n    \n    return is_palindrome and is_within_weight_limit"}
