{"task_id": "HumanEval/59", "solution": "import math\n\nclass FactorizationService:\n    \"\"\"Internal service to encapsulate factorization logic.\"\"\"\n    def _is_prime(self, n: int) -> bool:\n        \"\"\"Helper to test primality of a number.\"\"\"\n        if n < 2:\n            return False\n        for i in range(2, int(math.sqrt(n)) + 1):\n            if n % i == 0:\n                return False\n        return True\n\n    def _prime_factors(self, n: int) -> list[int]:\n        \"\"\"Helper to generate all prime factors of n.\"\"\"\n        factors = set()\n        d = 2\n        temp_n = n\n        while d * d <= temp_n:\n            if temp_n % d == 0:\n                factors.add(d)\n                while temp_n % d == 0:\n                    temp_n //= d\n            d += 1\n        if temp_n > 1:\n            factors.add(temp_n)\n        return sorted(list(factors))\n\n    def largest_prime_factor(self, n: int) -> int:\n        \"\"\"Computes and returns the largest prime factor of n.\"\"\"\n        factors = self._prime_factors(n)\n        return factors[-1]\n\ndef largest_prime_factor(n: int) -> int:\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    service = FactorizationService()\n    # The problem statement guarantees n > 1 and is not prime,\n    # so input validation from design context is omitted.\n    return service.largest_prime_factor(n)"}
{"task_id": "HumanEval/61", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"(\" and \")\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n        \n        # If balance drops below zero, a closing bracket appeared without a matching open one\n        if balance < 0:\n            return False\n            \n    # After iterating, if balance is zero, all brackets are correctly matched\n    return balance == 0"}
