{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Checks if the given number is the product of exactly three prime numbers.\n    The input number 'a' is less than 100.\n    \"\"\"\n    if a < 2 or a >= 100:\n        return False\n\n    factors = []\n    d = 2\n    temp_a = a\n\n    while d * d <= temp_a:\n        while temp_a % d == 0:\n            factors.append(d)\n            temp_a //= d\n        d += 1\n\n    if temp_a > 1:\n        factors.append(temp_a)\n\n    return len(factors) == 3"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    '''\n    Write a function that takes an integer a and returns True \n    if this ingeger is a cube of some integer number.\n    Note: you may assume the input is always valid.\n    Examples:\n    iscube(1) ==> True\n    iscube(2) ==> False\n    iscube(-1) ==> True\n    iscube(64) ==> True\n    iscube(0) ==> True\n    iscube(180) ==> False\n    '''\n    root = round(abs(a)**(1/3))\n    return root**3 == abs(a)"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Returns True if x is a simple power of n (x = n**k for some integer k),\n    otherwise False. Returns False when n == 1.\"\"\"\n    if n == 1:\n        return False\n    if x < 1 or n < 2:\n        return False\n    power = 1\n    while power < x:\n        power *= n\n    return power == x"}
{"task_id": "HumanEval/79", "solution": "```python\ndef decimal_to_binary(decimal):\n    \"\"\"Converts a decimal number to its binary string representation,\n    prefixed and suffixed with 'db'.\n    \"\"\"\n    if decimal == 0:\n        return \"db0db\"\n    \n    binary_representation = []\n    temp_decimal = decimal\n    while temp_decimal > 0:\n        binary_representation.append(str(temp_decimal % 2))\n        temp_decimal //= 2\n    \n    # The list is built in reverse order, so we need to reverse it to get the correct binary string.\n    binary_string = \"\".join(binary_representation[::-1])\n    \n    return \"db\" + binary_string + \"db\"\n```"}
{"task_id": "HumanEval/80", "solution": "def is_happy(s):\n    \"\"\"\n    Checks if a string is happy. A string is happy if its length is at least 3\n    and every 3 consecutive letters are distinct.\n    \"\"\"\n    if len(s) < 3:\n        return False\n\n    for i in range(len(s) - 2):\n        if s[i] == s[i+1] or s[i] == s[i+2] or s[i+1] == s[i+2]:\n            return False\n            \n    return True"}
