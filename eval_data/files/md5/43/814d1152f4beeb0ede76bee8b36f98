{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"It is the last week of the semester and the teacher has to give the grades\n    to students. The teacher has been making her own algorithm for grading.\n    The only problem is, she has lost the code she used for grading.\n    She has given you a list of GPAs for some students and you have to write \n    a function that can output a list of letter grades using the following table:\n             GPA       |    Letter grade\n              4.0                A+\n            > 3.7                A \n            > 3.3                A- \n            > 3.0                B+\n            > 2.7                B \n            > 2.3                B-\n            > 2.0                C+\n            > 1.7                C\n            > 1.3                C-\n            > 1.0                D+ \n            > 0.7                D \n            > 0.0                D-\n              0.0                E\n    \n\n    Example:\n    grade_equation([4.0, 3, 1.7, 2, 3.5]) ==> ['A+', 'B', 'C-', 'C', 'A-']\n    \"\"\"\n    letter_grades = []\n    for gpa in grades:\n        if gpa == 4.0:\n            letter_grades.append(\"A+\")\n        elif gpa > 3.7:\n            letter_grades.append(\"A\")\n        elif gpa > 3.3:\n            letter_grades.append(\"A-\")\n        elif gpa > 3.0:\n            letter_grades.append(\"B+\")\n        elif gpa > 2.7:\n            letter_grades.append(\"B\")\n        elif gpa > 2.3:\n            letter_grades.append(\"B-\")\n        elif gpa > 2.0:\n            letter_grades.append(\"C+\")\n        elif gpa > 1.7:\n            letter_grades.append(\"C\")\n        elif gpa > 1.3:\n            letter_grades.append(\"C-\")\n        elif gpa > 1.0:\n            letter_grades.append(\"D+\")\n        elif gpa > 0.7:\n            letter_grades.append(\"D\")\n        elif gpa > 0.0:\n            letter_grades.append(\"D-\")\n        else: # gpa must be 0.0\n            letter_grades.append(\"E\")\n    return letter_grades"}
{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"Checks if the length of the string is a prime number.\"\"\"\n    length = len(string)\n\n    if length <= 1:\n        return False\n    if length == 2:\n        return True\n    if length % 2 == 0:\n        return False\n\n    i = 3\n    while i * i <= length:\n        if length % i == 0:\n            return False\n        i += 2\n    return True"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    if n == 1:\n        return 1\n    else:\n        # For n > 1, the formula is 18 * 10^(n-2).\n        return 18 * (10**(n - 2))"}
{"task_id": "HumanEval/85", "solution": "import typing\n\ndef add(lst: typing.List[int]) -> int:\n    \"\"\"Given a non-empty list of integers lst. add the even elements that are at odd indices..\n\n    Examples:\n        add([4, 2, 6, 7]) ==> 2 \n    \"\"\"\n    total_sum = 0\n    # Iterate through the list with both index and element.\n    for i, num in enumerate(lst):\n        # Add the element to the sum if its index is odd and the element itself is even.\n        if i % 2 != 0 and num % 2 == 0:\n            total_sum += num\n    return total_sum"}
{"task_id": "HumanEval/84", "solution": "class InputNumber:\n    \"\"\"Represents an input number, with a validation method.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def validate(self) -> bool:\n        \"\"\"Checks if the number is an integer within the allowed range.\"\"\"\n        return isinstance(self.value, int) and 0 <= self.value <= 10000\n\nclass DigitSumCalculator:\n    \"\"\"Calculates the sum of decimal digits of an InputNumber.\"\"\"\n    @staticmethod\n    def calculate_sum(n: InputNumber) -> int:\n        return sum(int(d) for d in str(n.value))\n\nclass BinaryConverter:\n    \"\"\"Converts an integer sum to its binary string representation.\"\"\"\n    @staticmethod\n    def to_binary(total: int) -> str:\n        return bin(total)[2:] # strip '0b' prefix\n\ndef solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\"\"\"\n    number = InputNumber(N)\n    # Validation is omitted here as per specific instruction: \"DO NOT add isinstance() checks or raise exceptions for edge cases\"\n    digit_sum = DigitSumCalculator.calculate_sum(number)\n    return BinaryConverter.to_binary(digit_sum)"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Sorts a copy of the given array based on the parity of the sum of its first and last elements.\n    \"\"\"\n    if len(array) <= 1:\n        return array[:]\n\n    first_val = array[0]\n    last_val = array[-1]\n    sum_first_last = first_val + last_val\n\n    copied_array = array[:]\n\n    if sum_first_last % 2 != 0:  # Odd sum\n        copied_array.sort()\n    else:  # Even sum\n        copied_array.sort(reverse=True)\n\n    return copied_array"}
{"task_id": "HumanEval/86", "solution": "import re\n\ndef anti_shuffle(s):\n    \"\"\"\n    Write a function that takes a string and returns an ordered version of it.\n    Ordered version of string, is a string where all words (separated by space)\n    are replaced by a new word where all the characters arranged in\n    ascending order based on ascii value.\n    Note: You should keep the order of words and blank spaces in the sentence.\n\n    For example:\n    anti_shuffle('Hi') returns 'Hi'\n    anti_shuffle('hello') returns 'ehllo'\n    anti_shuffle('Hello World!!!') returns 'Hello !!!Wdlor'\n    \"\"\"\n    # Split the string into words and spaces, preserving spaces as separate tokens.\n    # The regex r'(\\s+)' captures one or more whitespace characters, ensuring they are\n    # included in the resulting list of tokens.\n    tokens = re.split(r'(\\s+)', s)\n\n    processed_tokens = []\n    for token in tokens:\n        # If the token consists only of whitespace characters or is an empty string,\n        # it is preserved as is. Otherwise, it is treated as a word (potentially\n        # including punctuation) and its characters are sorted.\n        if not token or token.isspace():\n            processed_tokens.append(token)\n        else:\n            processed_tokens.append(\"\".join(sorted(token)))\n            \n    return \"\".join(processed_tokens)"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    You are given a 2 dimensional data, as a nested lists,\n    which is similar to matrix, however, unlike matrices,\n    each row may contain a different number of columns.\n    Given lst, and integer x, find integers x in the list,\n    and return list of tuples, [(x1, y1), (x2, y2) ...] such that\n    each tuple is a coordinate - (row, columns), starting with 0.\n    Sort coordinates initially by rows in ascending order.\n    Also, sort coordinates of the row by columns in descending order.\n    \n    Examples:\n    get_row([\n      [1,2,3,4,5,6],\n      [1,2,3,4,1,6],\n      [1,2,3,4,5,1]\n    ], 1) == [(0, 0), (1, 4), (1, 0), (2, 5), (2, 0)]\n    get_row([], 1) == []\n    get_row([[], [1], [1, 2, 3]], 3) == [(2, 2)]\n    \"\"\"\n    found_coordinates = []\n    for row_idx, row in enumerate(lst):\n        for col_idx, item in enumerate(row):\n            if item == x:\n                found_coordinates.append((row_idx, col_idx))\n    \n    # Sort coordinates: primary by row ascending, secondary by column descending.\n    # A key of (row_idx, -col_idx) achieves this:\n    # Python sorts tuples element by element. row_idx is ascending.\n    # For equal row_idx, -col_idx is sorted ascending, which means col_idx is sorted descending.\n    found_coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n    \n    return found_coordinates"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by shifting each alphabetic character four positions forward in the English alphabet.\n    Preserves case, leaves non-alphabetic characters unchanged, and wraps around cyclically.\n    \"\"\"\n    result = []\n    shift_amount = 4  # Shift by \"two multiplied to two places\" means 4\n\n    def _rotate_char(char, shift):\n        if 'a' <= char <= 'z':\n            start = ord('a')\n            return chr((ord(char) - start + shift) % 26 + start)\n        elif 'A' <= char <= 'Z':\n            start = ord('A')\n            return chr((ord(char) - start + shift) % 26 + start)\n        else:\n            return char\n\n    for char in s:\n        result.append(_rotate_char(char, shift_amount))\n\n    return \"\".join(result)"}
{"task_id": "HumanEval/90", "solution": "from typing import List, Optional\n\ndef next_smallest(lst: List[int]) -> Optional[int]:\n    \"\"\"\n    Returns the 2nd smallest distinct element of the list.\n    Returns None if there is no such element.\n    \"\"\"\n    if not lst:\n        return None\n\n    smallest = float('inf')\n    second_smallest = float('inf')\n\n    for x in lst:\n        if x < smallest:\n            second_smallest = smallest\n            smallest = x\n        elif x < second_smallest and x != smallest:\n            second_smallest = x\n    \n    if second_smallest == float('inf'):\n        return None\n    else:\n        return second_smallest"}
{"task_id": "HumanEval/91", "solution": "import re\n\nclass Sentence:\n    def __init__(self, text):\n        self.text = text\n\n    def starts_with_I(self):\n        \"\"\"Checks if the sentence starts with the word 'I' (case-sensitive).\"\"\"\n        trimmed_text = self.text.strip()\n        if not trimmed_text:\n            return False\n        \n        # Use regex to match 'I' as a whole word at the beginning of the trimmed text.\n        return re.match(r'^I\\b', trimmed_text) is not None\n\nclass Text:\n    def __init__(self, content):\n        self.content = content\n\n    def get_sentences(self):\n        \"\"\"Splits the text into a list of Sentence objects using delimiters.\"\"\"\n        # Splits the string at sentence delimiters ('.', '?', '!')\n        # and captures the delimiter, keeping it as part of the preceding sentence.\n        sentence_parts = re.split(r'(?<=[.?!])\\s*', self.content)\n        \n        sentences = []\n        for part in sentence_parts:\n            # Only create a Sentence object if the part is not empty after stripping whitespace.\n            if part.strip():\n                sentences.append(Sentence(part))\n        return sentences\n\ndef is_bored(S):\n    \"\"\"\n    Counts the number of \"boredoms\" in a string S.\n    A boredom is a sentence that starts with the word \"I\".\n    \"\"\"\n    text_obj = Text(S)\n    sentences = text_obj.get_sentences()\n    \n    boredom_count = 0\n    for sentence in sentences:\n        if sentence.starts_with_I():\n            boredom_count += 1\n            \n    return boredom_count"}
{"task_id": "HumanEval/92", "solution": "def any_int(x, y, z):\n    '''\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns false in any other cases.\n    '''\n    return (isinstance(x, int) and isinstance(y, int) and isinstance(z, int)) and \\\n           ((x == y + z) or (y == x + z) or (z == x + y))"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encodes a message by swapping the case of all letters and replacing vowels\n    with the letter two places ahead in the alphabet. Non-alphabetic characters\n    are preserved as is.\n    \"\"\"\n    LOWER_VOWELS = {'a', 'e', 'i', 'o', 'u'}\n    VOWEL_REPLACEMENTS = {\n        'a': 'c', 'e': 'g', 'i': 'k', 'o': 'q', 'u': 'w'\n    }\n    \n    encoded_chars = []\n    \n    for char in message:\n        if char.isalpha():\n            is_upper = char.isupper()\n            lower_char = char.lower()\n            \n            # Determine the character after vowel replacement (if applicable),\n            # maintaining its original case.\n            char_after_vowel_processing = char\n            if lower_char in LOWER_VOWELS:\n                replaced_char_lower = VOWEL_REPLACEMENTS[lower_char]\n                if is_upper:\n                    char_after_vowel_processing = replaced_char_lower.upper()\n                else:\n                    char_after_vowel_processing = replaced_char_lower\n            \n            # Then, swap the case of the resulting character.\n            final_char = char_after_vowel_processing.swapcase()\n            encoded_chars.append(final_char)\n        else:\n            # Non-alphabetic characters are appended as they are.\n            encoded_chars.append(char)\n            \n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/94", "solution": "import math\n\ndef skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"Checks if a number is prime. Returns True for primes, False otherwise.\"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\n\n    def sum_digits(n):\n        \"\"\"Calculates the sum of the decimal digits of a given non-negative integer.\"\"\"\n        s = 0\n        while n:\n            s += n % 10\n            n //= 10\n        return s\n\n    largest_prime_found = 0\n\n    for num in lst:\n        if is_prime(num):\n            if num > largest_prime_found:\n                largest_prime_found = num\n\n    if largest_prime_found == 0:\n        return 0\n    else:\n        return sum_digits(largest_prime_found)"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower \n    case or all keys are strings in upper case, else return False.\n    \"\"\"\n    if not dict:\n        return False\n\n    all_lower = True\n    all_upper = True\n\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False\n        \n        if not key.islower():\n            all_lower = False\n        \n        if not key.isupper():\n            all_upper = False\n            \n    return all_lower or all_upper"}
{"task_id": "HumanEval/96", "solution": "from typing import List\n\nclass PrimeNumberGenerator:\n    \"\"\"\n    Core algorithm for generating prime numbers less than a given integer.\n    \"\"\"\n\n    @staticmethod\n    def count_up_to(n: int) -> List[int]:\n        \"\"\"\n        Return all prime numbers less than n in ascending order.\n        \"\"\"\n        if n <= 2:\n            return []\n\n        primes = []\n        for candidate in range(2, n):\n            is_prime = True\n            for p in primes:\n                if p * p > candidate:\n                    break\n                if candidate % p == 0:\n                    is_prime = False\n                    break\n            if is_prime:\n                primes.append(candidate)\n        return primes\n\ndef count_up_to(n):\n    \"\"\"Implement a function that takes a non-negative integer and returns an array of the first n\n    integers that are prime numbers and less than n.\n    \"\"\"\n    return PrimeNumberGenerator.count_up_to(n)"}
{"task_id": "HumanEval/97", "solution": "def multiply(a, b):\n    \"\"\"Complete the function that takes two integers and returns \n    the product of their unit digits.\n    Assume the input is always valid.\n    Examples:\n    multiply(148, 412) should return 16.\n    multiply(19, 28) should return 72.\n    multiply(2020, 1851) should return 0.\n    multiply(14,-15) should return 20.\n    \"\"\"\n    unit_a = abs(a) % 10\n    unit_b = abs(b) % 10\n    return unit_a * unit_b"}
{"task_id": "HumanEval/98", "solution": "def count_upper(s):\n    \"\"\"\n    Given a string s, count the number of uppercase vowels in even indices.\n    \n    For example:\n    count_upper('aBCdEf') returns 1\n    count_upper('abcdefg') returns 0\n    count_upper('dBBE') returns 0\n    \"\"\"\n    \n    vowels = {'A', 'E', 'I', 'O', 'U'}\n    count = 0\n    for i, char in enumerate(s):\n        if i % 2 == 0 and char.isupper() and char in vowels:\n            count += 1\n    return count"}
{"task_id": "HumanEval/99", "solution": "import math\n\n\ndef closest_integer(value):\n    '''\n    Create a function that takes a value (string) representing a number\n    and returns the closest integer to it. If the number is equidistant\n    from two integers, round it away from zero.\n    '''\n    num = float(value)\n\n    floor_val = math.floor(num)\n    ceil_val = math.ceil(num)\n\n    dist_to_floor = abs(num - floor_val)\n    dist_to_ceil = abs(num - ceil_val)\n\n    if dist_to_floor < dist_to_ceil:\n        return int(floor_val)\n    elif dist_to_ceil < dist_to_floor:\n        return int(ceil_val)\n    else:  # Equidistant, number ends in .5\n        if num >= 0:  # For non-negative numbers, round up (towards positive infinity, away from zero)\n            return int(ceil_val)\n        else:  # For negative numbers, round down (towards negative infinity, away from zero)\n            return int(floor_val)"}
{"task_id": "HumanEval/100", "solution": "def make_a_pile(n):\n    \"\"\"\n    Given a positive integer n, you have to make a pile of n levels of stones.\n    The first level has n stones.\n    The number of stones in the next level is:\n        - the next odd number if n is odd.\n        - the next even number if n is even.\n    Return the number of stones in each level in a list, where element at index\n    i represents the number of stones in the level (i+1).\n    \"\"\"\n    pile = []\n    current_stones = n\n    for _ in range(n):\n        pile.append(current_stones)\n        current_stones += 2\n    return pile"}
