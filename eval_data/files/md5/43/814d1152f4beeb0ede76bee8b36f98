{"task_id": "HumanEval/57", "solution": "from typing import List, Any\n\nclass MonotonicChecker:\n    @staticmethod\n    def isMonotonic(lst: List[Any]) -> bool:\n        \"\"\"\n        Checks if a list is monotonically increasing or decreasing.\n        Handles empty or single-element lists as trivially monotonic.\n        \"\"\"\n        if len(lst) < 2:\n            return True\n\n        increasing = True\n        decreasing = True\n\n        for i in range(1, len(lst)):\n            if lst[i] > lst[i - 1]:\n                decreasing = False\n            elif lst[i] < lst[i - 1]:\n                increasing = False\n\n            if not increasing and not decreasing:\n                return False\n        return True\n\n\ndef monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    \"\"\"\n    return MonotonicChecker.isMonotonic(l)"}
{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n\n    >>> correct_bracketing(\"<\")\n    False\n    >>> correct_bracketing(\"<>\")\n    True\n    >>> correct_bracketing(\"<<><>>\")\n    True\n    >>> correct_bracketing(\"><<>\")\n    False\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '<':\n            balance += 1\n        elif char == '>':\n            balance -= 1\n        if balance < 0:\n            return False\n    return balance == 0"}
{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\n    >>> common([1, 4, 3, 34, 653, 2, 5], [5, 7, 1, 5, 9, 653, 121])\n    [1, 5, 653]\n    >>> common([5, 3, 2, 8], [3, 2])\n    [2, 3]\n\n    \"\"\"\n    class CommonFunction:\n        def __init__(self, list1, list2):\n            self.l1 = list1\n            self.l2 = list2\n\n        def compute(self):\n            # Convert lists to sets for efficient intersection and automatic deduplication.\n            set1 = set(self.l1)\n            set2 = set(self.l2)\n            common_set = set1.intersection(set2)\n            \n            # Convert the resulting set to a list and sort it as required.\n            result_list = list(common_set)\n            result_list.sort()\n            return result_list\n\n    # Instantiate the domain entity and delegate the computation.\n    cf_instance = CommonFunction(l1, l2)\n    return cf_instance.compute()"}
