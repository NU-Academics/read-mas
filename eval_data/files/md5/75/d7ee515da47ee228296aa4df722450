{"task_id": "Mbpp/476", "solution": "from typing import List, Union\nclass EmptyArrayError(ValueError):\n    \"\"\"Custom exception raised when an input array is empty.\"\"\"\n    def __init__(self, message=\"Input array cannot be empty.\"):\n        super().__init__(message)\nclass NonNumericInputError(TypeError):\n    \"\"\"Custom exception raised when an array contains non-numeric elements.\"\"\"\n    def __init__(self, message=\"Array contains non-numeric elements.\"):\n        super().__init__(message)\ndef big_sum(numbers: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"\n    Calculates the sum of the largest and smallest values in a given array.\n    Handles empty and single-element arrays, and validates input types.\n    \"\"\"\n    if not numbers:\n        raise EmptyArrayError()\n\n    for num in numbers:\n        if not isinstance(num, (int, float)):\n            raise NonNumericInputError()\n\n    if len(numbers) == 1:\n        return numbers[0] * 2\n\n    min_val = min(numbers)\n    max_val = max(numbers)\n    return min_val + max_val"}
