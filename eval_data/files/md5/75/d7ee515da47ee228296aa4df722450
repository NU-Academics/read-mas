{"task_id": "Mbpp/145", "solution": "from typing import Sequence, Union\ndef max_Abs_Diff(array: Sequence[Union[int, float]]) -> Union[int, float]:\n    \"\"\"\n    Calculates the maximum absolute difference between any two elements in the given array.\n    This is achieved by finding the minimum and maximum elements and returning their absolute difference.\n    \"\"\"\n    if not array:\n        raise ValueError(\"Input array cannot be empty.\")\n\n    if not all(isinstance(x, (int, float)) for x in array):\n        raise TypeError(\"Input array must contain only numeric elements.\")\n\n    min_val = min(array)\n    max_val = max(array)\n\n    return abs(max_val - min_val)"}
{"task_id": "Mbpp/141", "solution": "class NonComparableError(TypeError):\n    \"\"\"Custom exception raised when elements in a list are not comparable.\"\"\"\n    def __init__(self, message: str = \"List contains non-comparable elements.\"):\n        super().__init__(message)\ndef pancake_sort(data: list) -> list:\n    \"\"\"\n    Sorts a list of comparable elements in ascending order using the pancake sort algorithm.\n    Returns a new sorted list, leaving the original list unchanged.\n    \"\"\"\n    def _flip(arr: list, k: int) -> None:\n        \"\"\"Reverses the order of the first k elements in the list (in-place).\"\"\"\n        start = 0\n        end = k - 1\n        while start < end:\n            arr[start], arr[end] = arr[end], arr[start]\n            start += 1\n            end -= 1\n\n    def _find_max_index(arr: list, n: int) -> int:\n        \"\"\"Finds the index of the maximum element within the first n elements.\"\"\"\n        max_val = arr[0]\n        max_idx = 0\n        for i in range(1, n):\n            # Comparison might raise TypeError if elements are non-comparable.\n            if arr[i] > max_val:\n                max_val = arr[i]\n                max_idx = i\n        return max_idx\n\n    n = len(data)\n    if n <= 1:\n        return list(data) # Handle empty and single-element lists.\n\n    arr = list(data) # Work on a copy of the list to preserve original.\n\n    for current_size in range(n, 1, -1):\n        try:\n            # Find index of the maximum element in the current sub-array.\n            max_idx = _find_max_index(arr, current_size)\n\n            # If the maximum element is not already at the end of the current sub-array:\n            if max_idx != current_size - 1:\n                # Move the maximum element to the beginning of the sub-array.\n                _flip(arr, max_idx + 1)\n                # Move the maximum element from the beginning to its correct sorted position.\n                _flip(arr, current_size)\n        except TypeError as e:\n            # Catch TypeError during comparison and re-raise as NonComparableError.\n            raise NonComparableError(f\"Comparison failed: {e}. Ensure all elements are comparable.\") from e\n    return arr"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(list1: list, list2: list, list3: list) -> int:\n    \"\"\"Counts positions where elements are identical across all three input lists.\n    A TypeError is raised if inputs are not lists.\n    \"\"\"\n    if not all(isinstance(lst, list) for lst in [list1, list2, list3]):\n        raise TypeError(\"All inputs must be lists.\")\n\n    count = 0\n    min_length = min(len(list1), len(list2), len(list3))\n\n    for i in range(min_length):\n        if list1[i] == list2[i] == list3[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/145", "solution": "def max_Abs_Diff(arr: tuple) -> int:\n    \"\"\"Calculates the maximum absolute difference between any two elements in a tuple.\n    Handles type validation, edge cases for length, and ensures numeric elements.\n    \"\"\"\n    if not isinstance(arr, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n\n    if len(arr) < 2:\n        return 0\n\n    min_val = float('-inf')\n    max_val = float('inf')\n\n    # Find initial min and max from the first two elements\n    # and then iterate through the rest to avoid issue with float('inf') and float('-inf') when array contains only one or two elements.\n    if arr[0] < arr[1]:\n        min_val = arr[0]\n        max_val = arr[1]\n    else:\n        min_val = arr[1]\n        max_val = arr[0]\n\n    for item in arr[2:]:\n        if not isinstance(item, (int, float)):\n            raise TypeError(\"All elements in the tuple must be numeric (int or float).\")\n        if item < min_val:\n            min_val = item\n        if item > max_val:\n            max_val = item\n    \n    return int(abs(max_val - min_val))"}
