{"task_id": "Mbpp/301", "solution": "from typing import Any\ndef dict_depth(data: Any) -> int:\n    \"\"\"\n    Calculates the maximum nesting depth of the given data object.\n    Returns 0 for non-dictionaries, and 1 plus max nested depth for dictionary values.\n    \"\"\"\n    if not isinstance(data, dict):\n        return 0\n\n    max_current_depth = 1\n    for value in data.values():\n        if isinstance(value, dict):\n            # Recursively call for dictionary values and add 1 for the current level.\n            current_nested_depth = dict_depth(value)\n            max_current_depth = max(max_current_depth, 1 + current_nested_depth)\n    return max_current_depth"}
{"task_id": "Mbpp/308", "solution": "def large_product(list1, list2, k):\n    \"\"\"Finds the k largest products formed by selecting one factor from each of two lists.\n    Raises ValueError for empty input lists or non-positive k.\"\"\"\n\n    # FR1: Input validation ensures lists are not empty and k is a positive integer.\n    if not list1 or not list2:\n        raise ValueError(\"Input lists cannot be empty.\")\n    if not isinstance(k, int) or k <= 0:\n        raise ValueError(\"k must be a positive integer.\")\n\n    # FR2: Calculate all possible products by pairing one element from each list.\n    all_products = []\n    for num1 in list1:\n        for num2 in list2:\n            all_products.append(num1 * num2)\n\n    # FR3: Sort all products in descending order to identify the largest ones.\n    all_products.sort(reverse=True)\n\n    # FR4: Return the k largest products, handling cases where k exceeds total products.\n    return all_products[:k]"}
{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(arr: list[int], n: int, i: int, k: int) -> int:\n    \"\"\"\n    Calculates the maximum sum of an increasing subsequence from arr[0...i] that includes arr[k].\n    Input validation ensures parameters are within bounds and k > i.\n    \"\"\"\n    if not arr or n != len(arr):\n        raise ValueError(\"Array 'arr' cannot be None or empty, and 'n' must match its length.\")\n    if not (0 <= i < n):\n        raise ValueError(f\"Index 'i' ({i}) is out of bounds for array of length {n}.\")\n    if not (i < k < n):\n        raise ValueError(f\"Index 'k' ({k}) must be greater than 'i' ({i}) and within bounds for array of length {n}.\")\n\n    # dp[j] stores the maximum sum of an increasing subsequence ending at index j,\n    # considering only elements from arr[0] up to arr[j].\n    dp = [0] * (i + 1)\n\n    # Calculate dp values for the prefix arr[0...i].\n    for current_idx in range(i + 1):\n        dp[current_idx] = arr[current_idx]\n        for prev_idx in range(current_idx):\n            if arr[current_idx] > arr[prev_idx]:\n                dp[current_idx] = max(dp[current_idx], dp[prev_idx] + arr[current_idx])\n\n    max_prefix_sum = 0\n    # Find the maximum sum from dp[j] for j in [0, i] such that arr[j] < arr[k].\n    for j in range(i + 1):\n        if arr[j] < arr[k]:\n            max_prefix_sum = max(max_prefix_sum, dp[j])\n\n    # The final sum includes arr[k] and the maximum valid prefix sum found.\n    return max_prefix_sum + arr[k]"}
