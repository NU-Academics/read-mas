{"task_id": "Mbpp/94", "solution": "from typing import Any, List, Tuple, Optional\ndef index_minimum(data: List[Tuple[Any, Any]]) -> Optional[Any]:\n    \"\"\"\n    Finds the first element of the tuple with the smallest second value.\n    Returns None if the input list is empty.\n    \"\"\"\n    if not data:\n        return None\n\n    min_val = data[0][1]\n    res_val = data[0][0]\n\n    for item in data:\n        if item[1] < min_val:\n            min_val = item[1]\n            res_val = item[0]\n    return res_val"}
{"task_id": "Mbpp/96", "solution": "import math\ndef divisor(number: int) -> int:\n    \"\"\"\n    Calculates the number of positive divisors for a given integer.\n    Raises ValueError for non-positive or non-integer input.\n    \"\"\"\n    if not isinstance(number, int):\n        raise ValueError(\"Input must be an integer.\")\n    if number <= 0:\n        raise ValueError(\"Input must be a positive integer.\")\n\n    count = 0\n    # Iterate from 1 up to the square root of the number.\n    for i in range(1, int(math.sqrt(number)) + 1):\n        if number % i == 0:\n            # If i is a divisor, number/i is also a divisor.\n            if i * i == number:\n                count += 1\n            else:\n                count += 2\n    return count"}
{"task_id": "Mbpp/95", "solution": "from typing import List, Any\ndef Find_Min_Length(list_of_lists: List[List[Any]]) -> int:\n    \"\"\"\n    Calculates the length of the shortest sublist within a given list of lists.\n    Raises TypeError if the input or its elements are not lists.\n    \"\"\"\n    if not isinstance(list_of_lists, list):\n        raise TypeError(\"Input 'list_of_lists' must be a list.\")\n\n    if not list_of_lists:\n        return 0\n\n    min_length = float('inf')\n    for sublist in list_of_lists:\n        if not isinstance(sublist, list):\n            raise TypeError(\"All elements in 'list_of_lists' must be lists.\")\n        min_length = min(min_length, len(sublist))\n\n    # If min_length remains infinity, it implies no actual lists were found,\n    # which should be prevented by preceding type checks.\n    return int(min_length) if min_length != float('inf') else 0"}
{"task_id": "Mbpp/95", "solution": "def Find_Min_Length(list_of_lists: list[list[any]]) -> int:\n    \"\"\"\n    Finds the length of the smallest list in a list of lists.\n\n    Args:\n        list_of_lists: A list where each element is expected to be a list.\n\n    Returns:\n        An integer representing the length of the smallest sublist.\n\n    Raises:\n        TypeError: If list_of_lists is not a list, or if any element within\n                   list_of_lists is not a list or does not support len().\n        ValueError: If list_of_lists is an empty list.\n    \"\"\"\n    if not isinstance(list_of_lists, list):\n        raise TypeError(\"Input must be a list of lists.\")\n    if not list_of_lists:\n        raise ValueError(\"Input list_of_lists cannot be empty.\")\n\n    min_len = float('inf')\n    for sublist in list_of_lists:\n        if not isinstance(sublist, list):\n            # Attempt to get length, if it fails, raise TypeError\n            try:\n                current_len = len(sublist)\n            except TypeError:\n                raise TypeError(f\"Element '{sublist}' in list_of_lists is not a list and does not support len().\")\n        else:\n            current_len = len(sublist)\n        min_len = min(min_len, current_len)\n\n    return int(min_len)"}
{"task_id": "Mbpp/94", "solution": "from typing import Any, List, Tuple\ndef index_minimum(data: List[Tuple[Any, Any]]) -> Any | None:\n    \"\"\"\n    Finds the first element of the tuple with the smallest second value in a list of tuples.\n    Returns None for an empty list, and raises errors for invalid input.\n    \"\"\"\n    if not isinstance(data, list):\n        raise TypeError(\"Input 'data' must be a list.\")\n\n    if not data:\n        return None\n\n    min_value = float('inf')\n    result = None\n\n    for item in data:\n        if not isinstance(item, tuple) or len(item) < 2:\n            raise ValueError(\n                f\"Invalid tuple format: {item}. Each item must be a tuple with at least two elements.\"\n            )\n        try:\n            current_second_value = item[1]\n            if current_second_value < min_value:\n                min_value = current_second_value\n                result = item[0]\n        except TypeError as e:\n            raise ValueError(\n                f\"Non-comparable second element found in tuple {item}: {e}\"\n            ) from e\n\n    return result"}
{"task_id": "Mbpp/97", "solution": "from collections import Counter\nfrom typing import Any, List, Dict\ndef frequency_lists(list_of_lists: List[List[Any]]) -> Dict[Any, int]:\n    \"\"\"Calculates the frequency of each element in a flattened list of lists. Raises TypeError for invalid input types.\"\"\"\n    if not isinstance(list_of_lists, list):\n        raise TypeError(\"Input must be a list.\")\n    for inner_list in list_of_lists:\n        if not isinstance(inner_list, list):\n            raise TypeError(\"All elements in the outer list must be lists.\")\n\n    # Flatten the list of lists using a list comprehension.\n    flat_list: List[Any] = [item for sublist in list_of_lists for item in sublist]\n\n    # Use collections.Counter for efficient frequency counting.\n    return dict(Counter(flat_list))"}
{"task_id": "Mbpp/96", "solution": "import math\ndef divisor(number: int) -> int:\n    \"\"\"\n    Calculates the number of positive divisors for a given integer.\n    Raises ValueError if the input number is not a positive integer.\n    \"\"\"\n    if number <= 0:\n        raise ValueError(\"Number must be a positive integer.\")\n\n    count = 0\n    sqrt_n = int(math.sqrt(number))\n\n    for i in range(1, sqrt_n + 1):\n        if number % i == 0:\n            if i * i == number:\n                count += 1\n            else:\n                count += 2\n    return count"}
{"task_id": "Mbpp/97", "solution": "from collections import Counter\nfrom itertools import chain\nfrom typing import Any, List, Dict\ndef frequency_lists(list_of_lists: List[List[Any]]) -> Dict[Any, int]:\n    \"\"\"\n    Calculates the frequency of each element in a flattened list of lists.\n    Elements within the inner lists must be hashable.\n    \"\"\"\n    if not isinstance(list_of_lists, list):\n        raise TypeError(\"Input must be a list of lists.\")\n        \n    flattened_list = list(chain.from_iterable(list_of_lists))\n    return dict(Counter(flattened_list))"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(num: int) -> str:\n    \"\"\"Converts a non-negative decimal integer to its binary string representation.\n    Raises TypeError for non-integer input and ValueError for negative input.\n    \"\"\"\n    if not isinstance(num, int):\n        raise TypeError(\"Input must be an integer.\")\n    if num < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n    if num == 0:\n        return \"0\"\n\n    binary_string = \"\"\n    while num > 0:\n        remainder = num % 2\n        binary_string = str(remainder) + binary_string\n        num //= 2\n    return binary_string"}
{"task_id": "Mbpp/98", "solution": "def multiply_num(numbers: tuple[int | float, ...]) -> float:\n    \"\"\"\n    Multiplies all numbers in the given iterable and divides the product by its length.\n    Raises TypeError for invalid input types or non-numeric elements, ValueError for empty input.\n    \"\"\"\n    if not isinstance(numbers, (list, tuple)):\n        raise TypeError(\"Input must be a list or tuple of numbers.\")\n    if not numbers:\n        raise ValueError(\"Input list/tuple cannot be empty.\")\n\n    product = 1.0\n    for num in numbers:\n        if not isinstance(num, (int, float)):\n            raise TypeError(\"All elements in the input must be numbers (int or float).\")\n        product *= num\n\n    length = len(numbers)\n    return product / length"}
{"task_id": "Mbpp/98", "solution": "def multiply_num(numbers: list[float | int]) -> float:\n    \"\"\"Calculates the product of numbers in a list and divides by the list's length.\n    Raises ValueError for empty lists or TypeError for non-numeric elements.\"\"\"\n\n    if not numbers:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    product = 1.0\n    for num in numbers:\n        if not isinstance(num, (int, float)):\n            raise TypeError(\"All elements in the list must be numeric (int or float).\")\n        product *= num\n\n    return product / len(numbers)"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(number):\n    \"\"\"\n    Converts a non-negative decimal integer to its binary string representation with no leading zeros.\n    \"\"\"\n    if number == 0:\n        return '0'\n\n    binary_str = \"\"\n    while number > 0:\n        remainder = number % 2\n        binary_str = str(remainder) + binary_str\n        number //= 2\n\n    return binary_str"}
{"task_id": "Mbpp/101", "solution": "def kth_element(arr: list, k: int) -> any:\n    \"\"\"\n    Finds the kth element in the given array using 1-based indexing.\n    Raises IndexError if k is out of bounds or the array is empty.\n    \"\"\"\n    if not arr:\n        raise IndexError(\"Array is empty.\")\n    if not (1 <= k <= len(arr)):\n        raise IndexError(f\"k ({k}) is out of bounds for array of length {len(arr)}.\")\n    return arr[k - 1]"}
{"task_id": "Mbpp/101", "solution": "from typing import Any, List\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to kth_element operations.\n    It carries a descriptive message about the error.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef kth_element(arr: List[Any], k: int) -> Any:\n    \"\"\"Finds the element at the kth (1-based) position in the given array.\n    This function performs robust input validation and returns the element at the calculated 0-based index.\"\"\"\n    if not isinstance(arr, list):\n        raise InvalidInputError(\"Input 'arr' must be a list.\")\n    if not arr:\n        raise InvalidInputError(\"Input array cannot be empty.\")\n    if not isinstance(k, int):\n        raise InvalidInputError(\"Input 'k' must be an integer.\")\n    if k <= 0:\n        raise InvalidInputError(\"Input 'k' must be a positive integer (1-based index).\")\n    if k > len(arr):\n        raise InvalidInputError(f\"Input 'k' ({k}) is out of bounds for array of length {len(arr)}.\")\n\n    zero_based_index = k - 1\n    return arr[zero_based_index]"}
{"task_id": "Mbpp/102", "solution": "def snake_to_camel(snake_case_string: str) -> str:\n    \"\"\"Converts a snake_case string to its CamelCase equivalent.\n    Raises TypeError if input is not a string.\"\"\"\n    if not isinstance(snake_case_string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    if not snake_case_string:\n        return \"\"\n\n    words = [word.capitalize() for word in snake_case_string.split('_') if word]\n    return \"\".join(words)"}
{"task_id": "Mbpp/102", "solution": "def snake_to_camel(snake_case_string: str) -> str:\n    \"\"\"Converts a snake_case string to a CamelCase string.\n    Raises TypeError if input is not a string.\"\"\"\n    if not isinstance(snake_case_string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    if not snake_case_string:\n        return \"\"\n\n    words = snake_case_string.split('_')\n    camel_case_words = [word.capitalize() for word in words if word]\n    return \"\".join(camel_case_words)"}
{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(num: int) -> int:\n    \"\"\"\n    Finds the next smallest palindrome of a specified integer, returned as an integer.\n\n    Args:\n        num: The input integer.\n\n    Returns:\n        The next smallest palindrome greater than 'num'.\n\n    Raises:\n        TypeError: If the input is not an integer.\n        ValueError: If the input is a negative integer.\n    \"\"\"\n\n    def is_palindrome(n: int) -> bool:\n        \"\"\"\n        Checks if a given non-negative integer n is a palindrome.\n        \"\"\"\n        s = str(n)\n        return s == s[::-1]\n\n    if not isinstance(num, int):\n        raise TypeError(\"Input must be an integer.\")\n    if num < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n\n    current_num = num + 1\n    while not is_palindrome(current_num):\n        current_num += 1\n    return current_num"}
{"task_id": "Mbpp/100", "solution": "def _get_left_half(s: str) -> str:\n    \"\"\"Extracts the left half of a string.\"\"\"\n    return s[:len(s) // 2]\ndef _get_middle_char(s: str) -> str | None:\n    \"\"\"Extracts the middle character for odd length strings, otherwise returns None.\"\"\"\n    return s[len(s) // 2] if len(s) % 2 == 1 else None\ndef _mirror_left_to_right(left_half: str, middle_char: str | None) -> str:\n    \"\"\"Constructs a palindrome by mirroring the left half.\"\"\"\n    reversed_left = left_half[::-1]\n    if middle_char is not None:\n        return left_half + middle_char + reversed_left\n    return left_half + reversed_left\ndef _increment_half(half_str: str) -> str:\n    \"\"\"Increments a string representation of a number, handling carry-overs.\"\"\"\n    return str(int(half_str) + 1)\ndef _all_nines(s: str) -> bool:\n    \"\"\"Checks if a string consists entirely of '9' characters.\"\"\"\n    return all(c == '9' for c in s)\ndef next_smallest_palindrome(n: int) -> int:\n    \"\"\"Calculates the next smallest palindrome for a given integer.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n\n    if n < 9:\n        return n + 1\n\n    s = str(n)\n    length = len(s)\n\n    if _all_nines(s):\n        return int('1' + '0' * (length - 1) + '1')\n\n    left_half = _get_left_half(s)\n    middle_char = _get_middle_char(s)\n\n    candidate_palindrome_str = _mirror_left_to_right(left_half, middle_char)\n    candidate_palindrome_int = int(candidate_palindrome_str)\n\n    if candidate_palindrome_int > n:\n        return candidate_palindrome_int\n    else:\n        new_left_half = \"\"\n        new_middle_char = None\n\n        if middle_char is not None:\n            combined_half_for_increment = left_half + middle_char\n            incremented_combined_half = _increment_half(combined_half_for_increment)\n            new_left_half = incremented_combined_half[:-1]\n            new_middle_char = incremented_combined_half[-1]\n        else:\n            new_left_half = _increment_half(left_half)\n            new_middle_char = None\n\n        return int(_mirror_left_to_right(new_left_half, new_middle_char))"}
{"task_id": "Mbpp/103", "solution": "import functools\ndef eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Computes the Eulerian number A(n, m) using a recursive approach with memoization.\n    Raises ValueError if n or m are negative.\n    \"\"\"\n    if n < 0 or m < 0:\n        raise ValueError(\"n and m must be non-negative integers.\")\n\n    @functools.lru_cache(None)\n    def _eulerian_num_recursive(current_n: int, current_m: int) -> int:\n        \"\"\"\n        Private recursive helper to compute Eulerian numbers with memoization.\n        Handles base cases and the recurrence relation.\n        \"\"\"\n        if current_m == 0:\n            return 1\n        elif current_m >= current_n or current_m < 0:\n            return 0\n        else:\n            return (current_m + 1) * _eulerian_num_recursive(current_n - 1, current_m) + \\\n                   (current_n - current_m) * _eulerian_num_recursive(current_n - 1, current_m - 1)\n\n    return _eulerian_num_recursive(n, m)"}
{"task_id": "Mbpp/104", "solution": "def sort_sublists(input_list_of_lists: list[list[str]]) -> list[list[str]]:\n    \"\"\"\n    Sorts each sublist of strings in a given list of lists alphabetically.\n    Returns a new list of lists with each sublist sorted.\n    \"\"\"\n    if not isinstance(input_list_of_lists, list):\n        raise TypeError(\"Input must be a list of lists.\")\n\n    sorted_outer_list = []\n    for sublist in input_list_of_lists:\n        if not isinstance(sublist, list):\n            raise TypeError(\"All elements in the outer list must be lists.\")\n        sorted_sublist = sorted(sublist)\n        sorted_outer_list.append(sorted_sublist)\n    return sorted_outer_list"}
{"task_id": "Mbpp/105", "solution": "def count(data_list: list) -> int:\n    \"\"\"Counts the number of strictly True boolean values in a list.\n    Raises TypeError if the input is not a list.\n    \"\"\"\n    if not isinstance(data_list, list):\n        raise TypeError(\"Input 'data_list' must be a list.\")\n\n    true_count = 0\n    for item in data_list:\n        # Only count elements that are strictly the boolean value True.\n        if isinstance(item, bool) and item is True:\n            true_count += 1\n    return true_count"}
