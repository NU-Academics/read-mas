{"task_id": "Mbpp/473", "solution": "def _normalize_tuple(t: tuple) -> tuple:\n    \"\"\"\n    Converts a tuple into a canonical representation by sorting its elements.\n    This allows for order-agnostic comparison for set operations.\n    \"\"\"\n    if not isinstance(t, tuple):\n        raise TypeError(f\"Expected a tuple, but got {type(t)}\")\n    return tuple(sorted(t))\ndef tuple_intersection(list1: list[tuple], list2: list[tuple]) -> set[tuple]:\n    \"\"\"\n    Calculates the intersection of two lists of tuples, treating tuples\n    with the same elements but different order as identical. Returns a set\n    of sorted tuples common to both input lists.\n    \"\"\"\n    if not isinstance(list1, list):\n        raise TypeError(f\"Expected list1 to be a list, but got {type(list1)}\")\n    if not isinstance(list2, list):\n        raise TypeError(f\"Expected list2 to be a list, but got {type(list2)}\")\n\n    normalized_set1 = set()\n    for t in list1:\n        normalized_set1.add(_normalize_tuple(t))\n\n    normalized_set2 = set()\n    for t in list2:\n        normalized_set2.add(_normalize_tuple(t))\n\n    return normalized_set1.intersection(normalized_set2)"}
{"task_id": "Mbpp/473", "solution": "def normalize_tuple(t: tuple) -> tuple:\n    \"\"\"\n    Normalizes a tuple by sorting its elements.\n    This ensures that (a, b) and (b, a) are treated as identical.\n    \"\"\"\n    return tuple(sorted(t))\ndef tuple_intersection(list1: list[tuple], list2: list[tuple]) -> set[tuple]:\n    \"\"\"\n    Computes the intersection of two lists of tuples,\n    considering tuples as equal irrespective of their element order.\n    \"\"\"\n    normalized_set1 = {normalize_tuple(t) for t in list1}\n    normalized_set2 = {normalize_tuple(t) for t in list2}\n    return normalized_set1.intersection(normalized_set2)"}
{"task_id": "Mbpp/457", "solution": "from typing import Any, List\ndef Find_Min(list_of_lists: List[List[Any]]) -> List[Any]:\n    \"\"\"Finds the sublist with the minimum length from a list of lists.\n    If multiple sublists have the same minimum length, the first one encountered is returned.\n    \"\"\"\n    if not isinstance(list_of_lists, list):\n        raise TypeError(\"Input must be a list.\")\n    if not list_of_lists:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    min_length = float('inf')\n    min_sublist: List[Any] = [] # This will be overwritten by the first valid sublist.\n\n    for sublist in list_of_lists:\n        if not isinstance(sublist, list):\n            raise TypeError(\"All elements in the input list must be lists.\")\n\n        if len(sublist) < min_length:\n            min_length = len(sublist)\n            min_sublist = sublist\n            \n    return min_sublist"}
{"task_id": "Mbpp/474", "solution": "def replace_char(original_string: str, char_to_replace: str, replacement_char: str) -> str:\n    \"\"\"Replaces all occurrences of a specified character with a replacement character.\n    Raises TypeError or ValueError for invalid inputs according to the specification.\"\"\"\n    if original_string is None:\n        raise TypeError(\"original_string cannot be None\")\n\n    if not (isinstance(char_to_replace, str) and len(char_to_replace) == 1):\n        raise ValueError(\"char_to_replace must be a single character string.\")\n\n    if not (isinstance(replacement_char, str) and len(replacement_char) == 1):\n        raise ValueError(\"replacement_char must be a single character string.\")\n\n    return original_string.replace(char_to_replace, replacement_char)"}
