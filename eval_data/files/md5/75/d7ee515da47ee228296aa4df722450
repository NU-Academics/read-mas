{"task_id": "Mbpp/111", "solution": "from typing import List, Any, Set\ndef common_in_nested_lists(nested_lists: List[List[Any]]) -> Set[Any]:\n    \"\"\"\n    Identifies elements present in all input lists.\n    Returns an empty set if input is empty or no common elements exist.\n    \"\"\"\n    if not nested_lists:\n        return set()\n\n    # Initialize common_set with elements from the first list.\n    common_set = set(nested_lists[0])\n\n    # Intersect with subsequent lists, optimizing by early exit if common_set becomes empty.\n    for sublist in nested_lists[1:]:\n        common_set = common_set.intersection(set(sublist))\n        if not common_set:\n            break\n    \n    return common_set"}
{"task_id": "Mbpp/109", "solution": "def _rotate_string(s: str) -> str:\n    \"\"\"Performs a single left rotation on a given string.\n    The first character moves to the end of the string.\"\"\"\n    if not s:\n        return \"\"\n    return s[1:] + s[0]\ndef _is_odd(binary_s: str) -> bool:\n    \"\"\"Determines if the decimal equivalent of a binary string is an odd number.\n    This is efficiently done by checking its least significant bit.\"\"\"\n    if not binary_s:\n        return False\n    return binary_s[-1] == '1'\ndef odd_Equivalent(binary_string: str, rotations: int) -> int:\n    \"\"\"Calculates the number of times a rotated binary string represents an odd decimal number.\n    It performs 'rotations' left rotations and counts odd equivalents.\"\"\"\n    _validate_inputs(binary_string, rotations)\n\n    if not binary_string:\n        return 0\n\n    odd_count = 0\n    current_string = binary_string\n\n    for _ in range(rotations):\n        current_string = _rotate_string(current_string)\n        if _is_odd(current_string):\n            odd_count += 1\n    return odd_count"}
{"task_id": "Mbpp/109", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    pass\nclass InputValidator:\n    \"\"\"Provides utility methods for validating function inputs.\"\"\"\n    @staticmethod\n    def validate_binary_string(s: str) -> None:\n        if not isinstance(s, str):\n            raise InvalidInputError(\"Input 'binary_string' must be a string.\")\n        if not s:\n            raise InvalidInputError(\"Input 'binary_string' cannot be empty.\")\n        if not all(char in '01' for char in s):\n            raise InvalidInputError(\"Input 'binary_string' must contain only '0's and '1's.\")\n\n    @staticmethod\n    def validate_rotations(n: int) -> None:\n        if not isinstance(n, int):\n            raise InvalidInputError(\"Input 'rotations' must be an integer.\")\n        if n < 0:\n            raise InvalidInputError(\"Input 'rotations' cannot be negative.\")\ndef _rotate_string(s: str) -> str:\n    \"\"\"Rotates a string one position to the right (cyclically).\"\"\"\n    if not s:\n        return s\n    return s[-1] + s[:-1]\ndef _is_odd(binary_s: str) -> bool:\n    \"\"\"Checks if the decimal equivalent of a binary string is odd.\"\"\"\n    if not binary_s:\n        return False\n    return binary_s[-1] == '1'\ndef odd_Equivalent(binary_string: str, rotations: int) -> int:\n    \"\"\"\n    Calculates the number of odd decimal equivalents resulting from rotating a binary string.\n    Inputs are validated for correctness and type.\n    \"\"\"\n    InputValidator.validate_binary_string(binary_string)\n    InputValidator.validate_rotations(rotations)\n\n    if not binary_string:\n        return 0\n\n    odd_count = 0\n    current_string = binary_string\n\n    for _ in range(rotations):\n        if _is_odd(current_string):\n            odd_count += 1\n        current_string = _rotate_string(current_string)\n    \n    return odd_count"}
{"task_id": "Mbpp/111", "solution": "from typing import Iterable, List, Set, TypeVar\nT = TypeVar('T')\nclass ICommonElementsFinder:\n    \"\"\"\n    Interface for finding common elements in nested iterables.\n    \"\"\"\n    def find_common(self, nested_lists: List[Iterable[T]]) -> Set[T]:\n        \"\"\"\n        Abstract method to find common elements across a list of iterables.\n        \"\"\"\n        raise NotImplementedError\nclass CommonElementsFinder(ICommonElementsFinder):\n    \"\"\"\n    Implements the logic to find common elements across a collection of iterables.\n    \"\"\"\n    def _validate_input(self, nested_lists: List[Iterable[T]]) -> None:\n        \"\"\"\n        Validates that the input 'nested_lists' is a list of iterables.\n        \"\"\"\n        if not isinstance(nested_lists, list):\n            raise TypeError(\"Input 'nested_lists' must be a list.\")\n        for i, sublist in enumerate(nested_lists):\n            if not isinstance(sublist, Iterable):\n                raise TypeError(f\"Element at index {i} in 'nested_lists' must be an iterable.\")\n\n    def find_common(self, nested_lists: List[Iterable[T]]) -> Set[T]:\n        \"\"\"\n        Finds and returns the set of elements common to all iterables within 'nested_lists'.\n        It validates input and uses set intersections for efficiency.\n\n        Args:\n            nested_lists: A list where each element is an iterable (e.g., a list).\n\n        Returns:\n            A set containing the elements that are present in all inner iterables.\n\n        Raises:\n            TypeError: If input is invalid or elements are not hashable.\n        \"\"\"\n        self._validate_input(nested_lists)\n\n        if not nested_lists:\n            return set()\n\n        # Initialize common_elements with the first list's elements\n        try:\n            common_elements = set(nested_lists[0])\n        except TypeError as e:\n            raise TypeError(f\"Elements in the first iterable must be hashable: {e}\")\n\n        if not common_elements: # If the first iterable was empty, no common elements possible\n            return set()\n\n        # Iterate through the rest of the lists and find intersections\n        for i, current_iterable in enumerate(nested_lists[1:]):\n            try:\n                common_elements = common_elements.intersection(set(current_iterable))\n            except TypeError as e:\n                raise TypeError(f\"Elements in iterable at index {i+1} must be hashable: {e}\")\n            if not common_elements: # Optimization: if intersection is empty, no need to continue\n                break\n        return common_elements\ndef common_in_nested_lists(nested_lists: List[Iterable[T]]) -> Set[T]:\n    \"\"\"\n    Finds the common elements in a given list of nested iterables.\n    This function acts as a facade to the CommonElementsFinder class.\n\n    Args:\n        nested_lists: A list where each element is an iterable (e.g., a list).\n\n    Returns:\n        A set containing the elements that are present in all inner iterables.\n    \"\"\"\n    finder = CommonElementsFinder()\n    return finder.find_common(nested_lists)"}
