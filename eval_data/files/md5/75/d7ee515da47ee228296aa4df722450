{"task_id": "Mbpp/638", "solution": "import math\ndef wind_chill(wind_velocity: float, temperature: float) -> int:\n    \"\"\"\n    Calculates the wind chill index using the standard formula for given wind velocity and temperature.\n    The result is rounded to the nearest integer.\n    \"\"\"\n    # Formula coefficients as defined in the design specification.\n    COEFFICIENT_A = 13.12\n    COEFFICIENT_B = 0.6215\n    COEFFICIENT_C = 11.37\n    COEFFICIENT_D = 0.3965\n    EXPONENT_V = 0.16\n\n    # Basic input validation as specified in the design.\n    if not isinstance(wind_velocity, (int, float)) or not isinstance(temperature, (int, float)):\n        raise TypeError(\"wind_velocity and temperature must be numerical.\")\n    if wind_velocity < 0:\n        raise ValueError(\"wind_velocity cannot be negative.\")\n\n    # Apply the wind chill formula: Twc = A + B*Ta - C*V^E + D*Ta*V^E\n    # Here, Ta is temperature and V is wind_velocity.\n    twc = (\n        COEFFICIENT_A\n        + (COEFFICIENT_B * temperature)\n        - (COEFFICIENT_C * (wind_velocity ** EXPONENT_V))\n        + (COEFFICIENT_D * temperature * (wind_velocity ** EXPONENT_V))\n    )\n\n    return round(twc)"}
{"task_id": "Mbpp/639", "solution": "def sum_valid_name_lengths(names: list[str]) -> int:\n    \"\"\"Calculates the sum of lengths of names after filtering them by capitalization. Names starting with a lowercase letter are excluded from the sum.\"\"\"\n    total_length = 0\n    for name in names:\n        # Check if the name is not empty and its first character is not lowercase.\n        if name and not name[0].islower():\n            total_length += len(name)\n    return total_length"}
{"task_id": "Mbpp/639", "solution": "def sample_nam(names: list[str]) -> int:\n    \"\"\"\n    Sums the lengths of names that start with an uppercase letter.\n    Names starting with a lowercase letter or empty strings are excluded.\n    \"\"\"\n    total_sum = 0\n    for name in names:\n        if name and name[0].isupper():\n            total_sum += len(name)\n    return total_sum"}
{"task_id": "Mbpp/638", "solution": "import math\nC1: float = 13.12\nC2: float = 0.6215\nC3: float = 11.37\nC4: float = 0.3965\nEXPONENT: float = 0.16\ndef wind_chill(velocity: float, temperature: float) -> int:\n    \"\"\"\n    Calculates the wind chill index rounded to the nearest integer.\n    Raises ValueError if velocity is negative.\n    \"\"\"\n    if velocity < 0:\n        raise ValueError(\"Wind velocity cannot be negative.\")\n\n    if velocity == 0:\n        return round(temperature)\n\n    # Apply the standard wind chill formula.\n    wci_raw = (\n        C1\n        + (C2 * temperature)\n        - (C3 * (velocity ** EXPONENT))\n        + (C4 * temperature * (velocity ** EXPONENT))\n    )\n\n    return round(wci_raw)"}
