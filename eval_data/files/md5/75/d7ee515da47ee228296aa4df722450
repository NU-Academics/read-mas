{"task_id": "Mbpp/427", "solution": "import re\nclass InvalidDateFormatError(Exception):\n    \"\"\"Custom exception for invalid date format.\n    It provides a descriptive message for the error.\"\"\"\n    def __init__(self, message: str = \"Invalid date format. Expected yyyy-mm-dd.\"):\n        self.message = message\n        super().__init__(self.message)\ndef change_date_format(date_string: str) -> str:\n    \"\"\"\n    Converts a date string from \"yyyy-mm-dd\" format to \"dd-mm-yyyy\" format.\n    Raises InvalidDateFormatError for invalid input formats or non-string inputs.\n    \"\"\"\n    if not isinstance(date_string, str):\n        raise InvalidDateFormatError(\"Input must be a string.\")\n\n    # Regex to validate yyyy-mm-dd format and capture year, month, day groups.\n    match = re.fullmatch(r\"(\\d{4})-(\\d{2})-(\\d{2})\", date_string)\n\n    if not match:\n        raise InvalidDateFormatError(\n            f\"Invalid date format: '{date_string}'. Expected yyyy-mm-dd.\"\n        )\n\n    year, month, day = match.groups()\n    return f\"{day}-{month}-{year}\""}
{"task_id": "Mbpp/428", "solution": "def shell_sort(arr: list) -> list:\n    \"\"\"Sorts the given array in ascending order using the Shell Sort algorithm.\n    Modifies the input array in-place and returns the sorted array.\n    \"\"\"\n    n = len(arr)\n    gap = n // 2\n\n    while gap > 0:\n        for i in range(gap, n):\n            # Store arr[i] in temp, as we'll shift elements to the right.\n            temp = arr[i]\n            j = i\n            # Shift elements that are greater than temp to the right.\n            while j >= gap and arr[j - gap] > temp:\n                arr[j] = arr[j - gap]\n                j -= gap\n            # Place temp in its correct position.\n            arr[j] = temp\n        # Reduce the gap for the next pass.\n        gap //= 2\n    return arr"}
{"task_id": "Mbpp/427", "solution": "import re\nclass InvalidDateFormatError(ValueError):\n    \"\"\"Custom exception for invalid date string formats.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef change_date_format(date_string: str) -> str:\n    \"\"\"Converts a date string from \"yyyy-mm-dd\" format to \"dd-mm-yyyy\" format.\n    Raises InvalidDateFormatError if the input format is incorrect.\"\"\"\n\n    if not isinstance(date_string, str):\n        raise InvalidDateFormatError(\"Input date must be a string.\")\n\n    match = re.fullmatch(r\"(\\d{4})-(\\d{2})-(\\d{2})\", date_string)\n\n    if not match:\n        raise InvalidDateFormatError(\n            f\"Invalid date format: '{date_string}'. Expected 'yyyy-mm-dd'.\"\n        )\n\n    year, month, day = match.groups()\n    return f\"{day}-{month}-{year}\""}
{"task_id": "Mbpp/424", "solution": "from typing import Tuple, List\ndef extract_rear(strings: Tuple[str, ...]) -> List[str]:\n    \"\"\"\n    Extracts the last character from each string in the given tuple.\n    Returns an empty string for any empty input string.\n    \"\"\"\n    if not isinstance(strings, tuple):\n        raise TypeError(\"Input must be a tuple of strings.\")\n\n    extracted_chars = []\n    for s in strings:\n        if not isinstance(s, str):\n            raise TypeError(f\"All elements in the input tuple must be strings, got {type(s)}.\")\n        extracted_chars.append(s[-1] if s else \"\")\n    return extracted_chars"}
