{"task_id": "Mbpp/422", "solution": "def find_Average_Of_Cube(n: int) -> float:\n    \"\"\"Calculates the average of the cubes of the first 'n' natural numbers.\n    Raises ValueError if 'n' is not a positive integer.\"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n    \n    # Sum of cubes of first n natural numbers using the formula.\n    sum_of_cubes = (n * (n + 1) / 2) ** 2\n    \n    # Average is the sum divided by n.\n    average = sum_of_cubes / n\n    \n    return average"}
{"task_id": "Mbpp/420", "solution": "def cube_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of cubes of the first 'n' even natural numbers.\n    For n=3, this is (2^3) + (4^3) + (6^3) = 8 + 64 + 216 = 288.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    total_sum = 0\n    for i in range(1, n + 1):\n        even_number = 2 * i\n        total_sum += even_number ** 3\n    return total_sum"}
{"task_id": "Mbpp/419", "solution": "def round_and_sum(numbers: list[float | int]) -> int | float:\n    \"\"\"\n    Rounds every number of a given list of numbers, calculates their sum,\n    and returns the total sum multiplied by the length of the list.\n\n    Args:\n        numbers: A list of numbers (integers or floats).\n\n    Returns:\n        The total sum of rounded numbers multiplied by the length of the original list.\n\n    Raises:\n        TypeError: If the input is not a list or contains non-numeric elements.\n    \"\"\"\n\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list of numbers.\")\n\n    for n in numbers:\n        if not isinstance(n, (int, float)):\n            raise TypeError(\"All elements in the list must be numbers.\")\n\n    rounded_numbers = [round(n) for n in numbers]\n    total_sum = sum(rounded_numbers)\n    \n    list_length = len(numbers)\n    \n    result = total_sum * list_length\n    return result"}
{"task_id": "Mbpp/422", "solution": "def find_Average_Of_Cube(n: int) -> float:\n    \"\"\"Calculates the average of the cubes of the first 'n' natural numbers.\n    Raises ValueError if n is not a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    sum_of_cubes = 0\n    for i in range(1, n + 1):\n        sum_of_cubes += i ** 3\n\n    return sum_of_cubes / n"}
{"task_id": "Mbpp/420", "solution": "def cube_Sum(n):\n    \"\"\"\n    Finds the cube sum of the first n even natural numbers.\n\n    Args:\n        n: A positive integer representing the number of even natural numbers.\n\n    Returns:\n        The sum of the cubes of the first n even natural numbers.\n\n    Raises:\n        ValueError: If n is not a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    total_sum = 0\n    for i in range(1, n + 1):\n        even_number = 2 * i\n        total_sum += even_number ** 3\n    return total_sum"}
