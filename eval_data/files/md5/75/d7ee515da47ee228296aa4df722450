{"task_id": "Mbpp/743", "solution": "class InvalidInputError(TypeError):\n    \"\"\"Custom exception for invalid input types or values.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef rotate_right(input_list: list, n: int) -> list:\n    \"\"\"\n    Rotates a list to the right by n positions, wrapping elements.\n    Raises InvalidInputError if input_list is not a list or n is not an integer.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise InvalidInputError(\"Input 'input_list' must be a list.\")\n    if not isinstance(n, int):\n        raise InvalidInputError(\"Input 'n' must be an integer.\")\n\n    if not input_list:\n        return []\n\n    list_length = len(input_list)\n    effective_n = n % list_length\n\n    # Convert negative effective_n (from negative n input) to a positive right rotation.\n    if effective_n < 0:\n        effective_n += list_length\n\n    # Perform rotation using slicing and concatenation for O(N) complexity.\n    return input_list[-effective_n:] + input_list[:-effective_n]"}
{"task_id": "Mbpp/744", "solution": "def check_none(input_tuple: tuple) -> bool:\n    \"\"\"\n    Checks if the given tuple contains any None values.\n    Raises TypeError if the input is not a tuple.\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n\n    for item in input_tuple:\n        if item is None:\n            return True\n    return False"}
{"task_id": "Mbpp/745", "solution": "def divisible_by_digits(startnum: int, endnum: int) -> list[int]:\n    \"\"\"\n    Finds numbers within a range where each is divisible by its non-zero digits.\n    The range [startnum, endnum] is inclusive.\n    \"\"\"\n\n    def _get_digits(number: int) -> list[int]:\n        \"\"\"\n        Extracts all individual digits from an integer. Handles 0 and negative numbers.\n        \"\"\"\n        if number == 0:\n            return [0]\n        \n        digits = []\n        abs_number = abs(number)\n        while abs_number > 0:\n            digits.append(abs_number % 10)\n            abs_number //= 10\n        return digits[::-1] # Reverse to get digits in order\n\n    def _is_divisible_by_all_digits(number: int) -> bool:\n        \"\"\"\n        Checks if a number is divisible by all its non-zero digits. Skips 0 and considers 0 itself as valid.\n        \"\"\"\n        if number == 0:\n            return True # 0 has no non-zero digits, so it satisfies the condition\n            \n        digits = _get_digits(number)\n        for digit in digits:\n            if digit == 0:\n                continue # Skip division by zero\n            if number % digit != 0:\n                return False\n        return True\n\n    result = []\n    for num in range(startnum, endnum + 1):\n        if _is_divisible_by_all_digits(num):\n            result.append(num)\n    return result"}
{"task_id": "Mbpp/748", "solution": "import re\ndef capital_words_spaces(text: str) -> str:\n    \"\"\"Inserts spaces before capital letters in a string, except for the first character. Raises TypeError if input is not a string.\"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input must be a string.\")\n    return re.sub(r'(?<!^)([A-Z])', r' \\1', text)"}
{"task_id": "Mbpp/748", "solution": "import re\ndef capital_words_spaces(text: str) -> str:\n    \"\"\"Inserts spaces before each uppercase letter that is not the first character of the string.\n    It handles consecutive uppercase letters (acronyms) and numbers appropriately as per specified examples.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input must be a string.\")\n\n    # Insert a space before an uppercase letter if it's preceded by a lowercase letter or a digit.\n    # E.g., \"HelloWorld\" -> \"Hello World\", \"Version1Point0\" -> \"Version1 Point0\"\n    result = re.sub(r'(?<=[a-z0-9])([A-Z])', r' \\1', text)\n\n    # Insert a space before an uppercase letter if it's preceded by one or more uppercase letters\n    # and then followed by a lowercase letter. This handles acronyms followed by a new word.\n    # E.g., \"HTTPResponse\" -> \"HTTP Response\", \"MyAPIKey\" -> \"My API Key\"\n    result = re.sub(r'([A-Z]+)([A-Z][a-z])', r'\\1 \\2', result)\n\n    return result"}
{"task_id": "Mbpp/749", "solution": "def sort_numeric_strings(string_numbers: list[str]) -> list[int]:\n    \"\"\"Converts a list of string numbers to integers, sorts them numerically,\n    and returns the sorted list of integers. Raises ValueError for non-integer strings or TypeError for invalid input types.\"\"\"\n    if not isinstance(string_numbers, list):\n        raise TypeError(\"Input must be a list of strings.\")\n\n    converted_numbers = []\n    for s in string_numbers:\n        if not isinstance(s, str):\n            raise TypeError(f\"All elements in the list must be strings, but found type {type(s).__name__}.\")\n        try:\n            converted_numbers.append(int(s))\n        except ValueError as e:\n            raise ValueError(f\"Could not convert '{s}' to an integer. {e}\") from e\n\n    return sorted(converted_numbers)"}
{"task_id": "Mbpp/745", "solution": "from typing import List\ndef _get_digits(number: int) -> List[int]:\n    \"\"\"Extracts individual digits from a number.\"\"\"\n    if number == 0:\n        return [0]\n    digits = []\n    temp_num = abs(number)\n    while temp_num > 0:\n        digits.append(temp_num % 10)\n        temp_num //= 10\n    return digits[::-1] # Return in original order.\ndef _is_divisible_by_all_digits(number: int) -> bool:\n    \"\"\"Checks if a number is divisible by all its non-zero digits.\"\"\"\n    if number == 0:\n        return True # 0 is vacuously true.\n    \n    digits = _get_digits(number)\n    for digit in digits:\n        if digit == 0:\n            continue # Ignore zero digits.\n        if number % digit != 0:\n            return False\n    return True\ndef divisible_by_digits(startnum: int, endnum: int) -> List[int]:\n    \"\"\"\n    Finds numbers within a given range (inclusive) where every number\n    is divisible by every non-zero digit it contains.\n    \"\"\"\n    if not isinstance(startnum, int) or not isinstance(endnum, int):\n        raise ValueError(\"startnum and endnum must be integers.\")\n    if startnum > endnum:\n        raise ValueError(\"startnum cannot be greater than endnum.\")\n\n    result = []\n    for number in range(startnum, endnum + 1):\n        if _is_divisible_by_all_digits(number):\n            result.append(number)\n    return result"}
{"task_id": "Mbpp/749", "solution": "def sort_numeric_strings(string_list: list[str]) -> list[int]:\n    \"\"\"\n    Converts a list of numeric strings to integers and sorts them numerically.\n    Raises TypeError if input is not a list, ValueError if any string cannot be converted to an integer.\n    \"\"\"\n    if not isinstance(string_list, list):\n        raise TypeError(\"Input must be a list of strings.\")\n\n    integer_list = []\n    for s in string_list:\n        try:\n            integer_list.append(int(s))\n        except ValueError as e:\n            raise ValueError(f\"Could not convert '{s}' to an integer.\") from e\n\n    integer_list.sort()\n    return integer_list"}
