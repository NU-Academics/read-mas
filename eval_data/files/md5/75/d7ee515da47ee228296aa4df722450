{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(n: int) -> int:\n    \"\"\"Sets the leftmost unset bit in a non-negative integer n. Raises ValueError for negative inputs.\"\"\"\n    if n < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n\n    if n == 0:\n        return 1\n\n    msb_pos = n.bit_length() - 1\n\n    for i in range(msb_pos, -1, -1):\n        if not (n & (1 << i)):\n            return n | (1 << i)\n\n    return n | (1 << (msb_pos + 1))"}
{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(n: int) -> int:\n    \"\"\"Sets the leftmost unset bit of a non-negative integer.\n    The leftmost unset bit is the highest-indexed 0-bit; if all lower bits are set, the next higher bit is set.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    if n == 0:\n        return 1  # For 0, the 0-th bit is the leftmost unset bit.\n\n    msb_pos = n.bit_length() - 1\n\n    # Iterate from the MSB down to 0 to find the first unset bit.\n    for i in range(msb_pos, -1, -1):\n        if not (n >> i) & 1:  # Check if the i-th bit is 0.\n            return n | (1 << i)\n\n    # If all bits up to msb_pos are set, set the bit at msb_pos + 1.\n    return n | (1 << (msb_pos + 1))"}
{"task_id": "Mbpp/388", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input. It stores a descriptive message.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef highest_Power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the highest power of 2 less than or equal to n.\n    Raises InvalidInputError if n is not a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise InvalidInputError(\"Input 'n' must be a positive integer.\")\n\n    power = 1\n    # Keep shifting left until the next power of 2 exceeds n.\n    while (power << 1) <= n:\n        power <<= 1\n    return power"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n: int) -> int:\n    \"\"\"Calculates the highest power of 2 that is less than or equal to n.\n    Raises ValueError if n is not a positive integer.\"\"\"\n    \n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n    \n    power = 1\n    while (power << 1) <= n:\n        power <<= 1\n        \n    return power"}
{"task_id": "Mbpp/389", "solution": "def find_lucas(n):\n    \"\"\"\n    Computes the n-th Lucas number iteratively.\n    Lucas numbers are defined as L(0)=2, L(1)=1, and L(n)=L(n-1)+L(n-2) for n > 1.\n    \"\"\"\n    if n == 0:\n        return 2\n    if n == 1:\n        return 1\n\n    a, b = 2, 1  # Initialize with L(0) and L(1)\n    for _ in range(2, n + 1):\n        a, b = b, a + b\n    return b"}
{"task_id": "Mbpp/391", "solution": "def convert_list_dictionary(\n    keys_outer: list[str],\n    keys_inner: list[str],\n    values: list[int]\n) -> list[dict[str, dict[str, int]]]:\n    \"\"\"\n    Converts three parallel lists into a list of nested dictionaries.\n    Each dictionary in the output list will have the structure: {outer_key: {inner_key: value}}.\n    \"\"\"\n    if not (len(keys_outer) == len(keys_inner) == len(values)):\n        raise ValueError(\"All input lists must have the same length.\")\n\n    result = []\n    for i in range(len(keys_outer)):\n        outer_key = keys_outer[i]\n        inner_key = keys_inner[i]\n        value = values[i]\n        result.append({outer_key: {inner_key: value}})\n    return result"}
