{"task_id": "Mbpp/792", "solution": "def count_list(given_lists: list) -> int:\n    \"\"\"\n    Counts the number of lists directly contained within a given list.\n\n    Args:\n        given_lists: The list to search for sub-lists.\n\n    Returns:\n        The total count of sub-lists.\n    \"\"\"\n    count = 0\n    for item in given_lists:\n        if isinstance(item, list):\n            count += 1\n    return count"}
{"task_id": "Mbpp/793", "solution": "def last(arr: list[int], target: int) -> int:\n    \"\"\"\n    Finds the last (highest) index of the target element in a sorted array.\n    Returns the highest index if found, otherwise -1.\n    \"\"\"\n    if not arr:\n        return -1\n\n    low, high = 0, len(arr) - 1\n    last_pos = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if arr[mid] == target:\n            last_pos = mid\n            low = mid + 1  # Try to find further occurrences to the right\n        elif arr[mid] < target:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return last_pos"}
{"task_id": "Mbpp/793", "solution": "def last(arr: list[int], target: int) -> int:\n    \"\"\"\n    Finds the last position (highest index) of an element in a sorted array.\n    Returns the highest index of the target if found, otherwise -1.\n    \"\"\"\n    n = len(arr)\n    if n == 0:\n        return -1\n\n    low, high = 0, n - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if arr[mid] == target:\n            result = mid\n            low = mid + 1  # Search right for later occurrences.\n        elif arr[mid] < target:\n            low = mid + 1\n        else:  # arr[mid] > target\n            high = mid - 1\n    return result"}
