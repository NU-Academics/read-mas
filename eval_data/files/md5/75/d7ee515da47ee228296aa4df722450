{"task_id": "Mbpp/57", "solution": "import functools\nfrom src.exceptions import InvalidDigitError, InvalidInputTypeError\ndef _compare_digits(d1: str, d2: str) -> int:\n    \"\"\"Compares two digit strings to determine concatenation order for the largest number.\n    Returns -1 if d1+d2 > d2+d1, 1 if d1+d2 < d2+d1, and 0 otherwise.\n    \"\"\"\n    if d1 + d2 > d2 + d1:\n        return -1\n    elif d1 + d2 < d2 + d1:\n        return 1\n    else:\n        return 0\ndef find_Max_Num(digits: list[int]) -> str:\n    \"\"\"Constructs the largest possible number from a given collection of digits.\n    It validates input, sorts digits using a custom comparison, and concatenates them.\n    \"\"\"\n    _validate_input(digits)\n\n    if not digits:\n        return \"\"\n\n    str_digits = [str(d) for d in digits]\n\n    # Sort in descending order based on the custom comparison logic\n    str_digits.sort(key=functools.cmp_to_key(_compare_digits), reverse=True)\n\n    return \"\".join(str_digits)"}
{"task_id": "Mbpp/57", "solution": "import functools\ndef find_Max_Num(digits: list[int]) -> int:\n    \"\"\"\n    Forms the largest number by concatenating a given list of digits.\n    Handles empty lists, single digits, duplicates, and zeros correctly.\n    \"\"\"\n    if not digits:\n        return 0\n\n    str_digits = [str(d) for d in digits]\n\n    # Custom comparison sorts strings such that 'a' comes before 'b'\n    # if 'a + b' forms a lexicographically larger number than 'b + a'.\n    def compare(a: str, b: str) -> int:\n        if (a + b) > (b + a):\n            return -1\n        elif (a + b) < (b + a):\n            return 1\n        else:\n            return 0\n\n    str_digits.sort(key=functools.cmp_to_key(compare))\n\n    result_str = \"\".join(str_digits)\n    \n    # Python's int() handles leading zeros correctly (e.g., \"007\" -> 7, \"000\" -> 0).\n    return int(result_str)"}
{"task_id": "Mbpp/59", "solution": "def is_octagonal(n: int) -> int:\n    \"\"\"\n    Calculates the nth octagonal number.\n\n    Args:\n        n: The position of the octagonal number (non-negative integer).\n\n    Returns:\n        The nth octagonal number.\n\n    Raises:\n        ValueError: If n is not a non-negative integer.\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n    return n * (3 * n - 2)"}
{"task_id": "Mbpp/61", "solution": "def count_Substrings(s: str) -> int:\n    \"\"\"\n    Counts substrings where the sum of digits equals their length.\n    It validates the input string for non-emptiness and digit-only content.\n    \"\"\"\n    if not s:\n        raise ValueError(\"Input string cannot be empty.\")\n    if not s.isdigit():\n        raise ValueError(\"Input must contain only digits.\")\n\n    count = 0\n    n = len(s)\n\n    for i in range(n):\n        current_sum = 0\n        for j in range(i, n):\n            current_sum += int(s[j])\n            current_length = j - i + 1\n            if current_sum == current_length:\n                count += 1\n    return count"}
{"task_id": "Mbpp/62", "solution": "from typing import List, Union\nclass MinFinderError(Exception):\n    \"\"\"Base exception for MinFinder errors.\n    All custom errors related to finding the minimum value inherit from this class.\"\"\"\n    pass\nclass EmptyListError(MinFinderError):\n    \"\"\"Raised when an empty list is provided.\n    This indicates that no smallest number can be determined.\"\"\"\n    pass\nclass InvalidInputTypeError(MinFinderError):\n    \"\"\"Raised when input is not a list or contains non-numeric types.\n    Ensures that only valid numeric lists are processed.\"\"\"\n    pass\ndef smallest_num(numbers: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"Finds the smallest number in a list of integers or floats.\n    This function performs strict input validation and returns the minimum value.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise InvalidInputTypeError(\"Input must be a list.\")\n\n    if not numbers:\n        raise EmptyListError(\"Input list cannot be empty.\")\n\n    # Initializes 'smallest' to positive infinity to correctly find the minimum value.\n    smallest = float('inf') \n    for num in numbers:\n        if not isinstance(num, (int, float)):\n            raise InvalidInputTypeError(\"List must contain only numeric types (int or float).\")\n        if num < smallest:\n            smallest = num\n    return smallest"}
{"task_id": "Mbpp/61", "solution": "def count_Substrings(s: str) -> int:\n    \"\"\"\n    Counts substrings where the sum of digits equals their length.\n    Raises ValueError for invalid input (non-string or non-digit characters).\n    \"\"\"\n    if not isinstance(s, str):\n        raise ValueError(\"Input must be a string.\")\n\n    # An empty string is valid input and should return 0 as per business rules.\n    if not s:\n        return 0\n\n    # For non-empty strings, ensure all characters are digits.\n    if not s.isdigit():\n        raise ValueError(\"Input string must contain only digits.\")\n\n    count = 0\n    n = len(s)\n\n    # Iterate through all possible starting positions of substrings.\n    for i in range(n):\n        current_sum = 0\n        # Iterate through all possible ending positions for substrings starting at i.\n        for j in range(i, n):\n            # Incrementally calculate the sum of digits for the current substring s[i:j+1].\n            current_sum += int(s[j])\n            \n            # The length of the current substring is (j - i + 1).\n            length = j - i + 1\n\n            # If the sum of digits equals the length, increment the counter.\n            if current_sum == length:\n                count += 1\n                \n    return count"}
{"task_id": "Mbpp/63", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input.\n    Raised when the input data does not meet the required format.\n    \"\"\"\n    pass\ndef max_difference(data: list[tuple[int | float, int | float]]) -> int | float:\n    \"\"\"Calculates the maximum difference (b - a) from a list of (a, b) tuples.\n    Raises InvalidInputError for malformed or empty input.\n    \"\"\"\n    if not isinstance(data, list):\n        raise InvalidInputError(\"Input must be a list.\")\n    if not data:\n        raise InvalidInputError(\"Input list cannot be empty.\")\n\n    differences = []\n    for item in data:\n        if not isinstance(item, tuple) or len(item) != 2:\n            raise InvalidInputError(\"Each element in the list must be a tuple of two numbers.\")\n        \n        a, b = item\n        if not isinstance(a, (int, float)) or not isinstance(b, (int, float)):\n            raise InvalidInputError(\"Tuple elements must be numbers (int or float).\")\n        \n        differences.append(b - a)\n    \n    return max(differences)"}
