{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(main_list: list, sub_list: list) -> bool:\n    \"\"\"\n    Checks if 'sub_list' is a contiguous sublist of 'main_list'.\n    Returns True if sub_list is found, False otherwise.\n    \"\"\"\n    if not sub_list:\n        return True\n    if len(sub_list) > len(main_list):\n        return False\n\n    n = len(main_list)\n    m = len(sub_list)\n\n    for i in range(n - m + 1):\n        if main_list[i:i + m] == sub_list:\n            return True\n    return False"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(main_list: list, sub_list: list) -> bool:\n    \"\"\"\n    Checks if 'sub_list' is a contiguous sublist of 'main_list'.\n    Returns True if found, False otherwise.\n    \"\"\"\n    if not sub_list:\n        return True\n    if not main_list:\n        return False\n\n    n = len(main_list)\n    m = len(sub_list)\n\n    if m > n:\n        return False\n\n    for i in range(n - m + 1):\n        if main_list[i:i+m] == sub_list:\n            return True\n    return False"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n: int) -> int:\n    \"\"\"Calculates the last digit of n!. Raises ValueError if n is negative.\"\"\"\n    if n < 0:\n        raise ValueError(\"Input number cannot be negative.\")\n    if n >= 5:\n        return 0  # Factorials of 5 or greater always end in 0\n    \n    # Calculate factorial's last digit for small numbers\n    if n == 0:\n        return 1\n    elif n == 1:\n        return 1\n    elif n == 2:\n        return 2\n    elif n == 3:\n        return 6\n    elif n == 4:\n        return 4"}
{"task_id": "Mbpp/578", "solution": "from typing import List, Any\nclass ListLengthMismatchError(Exception):\n    \"\"\"Custom exception raised when input lists for interleaving have different lengths.\n    It carries a descriptive message about the mismatch.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef interleave_lists(list1: List[Any], list2: List[Any], list3: List[Any]) -> List[Any]:\n    \"\"\"\n    Interleaves three lists of the same length into a single flat list.\n    Raises ListLengthMismatchError if input lists have different lengths.\n    \"\"\"\n    len1, len2, len3 = len(list1), len(list2), len(list3)\n\n    if not (len1 == len2 == len3):\n        raise ListLengthMismatchError(\"Input lists must have the same length.\")\n\n    interleaved_result: List[Any] = []\n    # Iterate and append elements from each list in sequence.\n    for i in range(len1):\n        interleaved_result.append(list1[i])\n        interleaved_result.append(list2[i])\n        interleaved_result.append(list3[i])\n\n    return interleaved_result"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(list1: list[int], list2: list[int], list3: list[int]) -> list[int]:\n    \"\"\"\n    Interleaves three lists of the same length into a single flat list, returning the new combined list.\n    Raises ValueError if input lists have different lengths.\n    \"\"\"\n    if not (len(list1) == len(list2) == len(list3)):\n        raise ValueError(\"All input lists must have the same length.\")\n\n    interleaved_list = []\n    for i in range(len(list1)):\n        interleaved_list.append(list1[i])\n        interleaved_list.append(list2[i])\n        interleaved_list.append(list3[i])\n    return interleaved_list"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Identifies elements present in one input tuple but not in the other.\n    Returns a new tuple containing these dissimilar elements.\n    \"\"\"\n    set1 = set(tuple1)\n    set2 = set(tuple2)\n    dissimilar_set = set1 ^ set2  # Compute the symmetric difference.\n    return tuple(dissimilar_set)"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n: int) -> int:\n    \"\"\"\n    Calculates the last digit of the factorial of a given non-negative integer.\n    Raises TypeError if input is not an integer, ValueError if negative.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n\n    if n == 0 or n == 1:\n        return 1\n    if n >= 5:\n        return 0  # Factorials of 5 and greater always end in 0.\n\n    # For n = 2, 3, 4, calculate the actual factorial and get the last digit.\n    if n == 2:\n        return 2\n    if n == 3:\n        return 6\n    if n == 4:\n        return 4"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"Recursively filters even integers from a tuple, preserving nested tuple structure.\"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n\n    result = []\n    for item in input_tuple:\n        if isinstance(item, int):\n            if item % 2 == 0:\n                result.append(item)\n        elif isinstance(item, tuple):\n            nested_filtered = extract_even(item)\n            if nested_filtered:\n                result.append(nested_filtered)\n    return tuple(result)"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(t1: tuple, t2: tuple) -> tuple:\n    \"\"\"\n    Finds elements that are present in either of the two tuples but not in their intersection.\n\n    Args:\n        t1: The first tuple.\n        t2: The second tuple.\n\n    Returns:\n        A tuple containing the dissimilar elements.\n    \"\"\"\n    set1 = set(t1)\n    set2 = set(t2)\n\n    dissimilar_elements_set = (set1 - set2) | (set2 - set1)\n\n    return tuple(sorted(list(dissimilar_elements_set)))"}
{"task_id": "Mbpp/581", "solution": "import math\ndef surface_Area(base_edge: float, height: float) -> float:\n    \"\"\"\n    Calculates the total surface area of a square pyramid.\n    Raises ValueError if base_edge or height are not positive.\n    \"\"\"\n    if base_edge <= 0:\n        raise ValueError(\"base_edge must be a positive number.\")\n    if height <= 0:\n        raise ValueError(\"height must be a positive number.\")\n\n    half_base_edge = base_edge / 2\n    slant_height = math.sqrt(height**2 + half_base_edge**2)\n\n    base_area = base_edge**2\n    lateral_surface_area = 2 * base_edge * slant_height\n\n    total_surface_area = base_area + lateral_surface_area\n    return total_surface_area"}
{"task_id": "Mbpp/580", "solution": "def extract_even(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Recursively extracts even numbers from a nested tuple, preserving its structure.\n    It returns a new tuple containing only even integers, maintaining the nested structure.\n    \"\"\"\n    result = []\n    for item in input_tuple:\n        if isinstance(item, tuple):\n            nested_result = extract_even(item)\n            if nested_result:\n                result.append(nested_result)\n        elif isinstance(item, int) and item % 2 == 0:\n            result.append(item)\n    return tuple(result)"}
{"task_id": "Mbpp/583", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    pass\nclass CatalanCalculator:\n    \"\"\"Calculates Catalan numbers using memoization.\"\"\"\n    def __init__(self):\n        self.memo = {}\n\n    def catalan_number(self, n: int) -> int:\n        \"\"\"\n        Computes the nth Catalan number.\n        Raises InvalidInputError if n is negative.\n        \"\"\"\n        if n < 0:\n            raise InvalidInputError(\"Input 'n' must be a non-negative integer.\")\n        \n        if n in self.memo:\n            return self.memo[n]\n\n        if n == 0:\n            return 1\n        \n        # C_n = sum(C_i * C_{n-1-i}) for i from 0 to n-1\n        result = 0\n        for i in range(n):\n            result += self.catalan_number(i) * self.catalan_number(n - 1 - i)\n        \n        self.memo[n] = result\n        return result\n_calculator = CatalanCalculator()\ndef catalan_number(n: int) -> int:\n    \"\"\"\n    Computes the nth Catalan number.\n    Raises InvalidInputError if n is negative.\n    \"\"\"\n    return _calculator.catalan_number(n)"}
{"task_id": "Mbpp/573", "solution": "from typing import List, Union, Any\ndef unique_product(numbers: list[Union[int, float]]) -> Union[int, float]:\n    \"\"\"\n    Calculates the product of unique numbers in a list.\n    Returns 1 if the list is empty or contains no unique numbers.\n    \"\"\"\n    _validate_numeric_list(numbers)\n\n    if not numbers:\n        return 1\n\n    unique_numbers = set(numbers)\n    product = 1\n    for num in unique_numbers:\n        product *= num\n    return product"}
{"task_id": "Mbpp/581", "solution": "import math\ndef surface_Area(base_edge: float, height: float) -> float:\n    \"\"\"\n    Calculates the total surface area of a square pyramid given its base edge and height.\n    This function validates inputs and uses standard geometric formulas.\n    \"\"\"\n    if not isinstance(base_edge, (int, float)) or base_edge <= 0:\n        raise ValueError(\"base_edge must be a positive number.\")\n    if not isinstance(height, (int, float)) or height <= 0:\n        raise ValueError(\"height must be a positive number.\")\n\n    # Calculate slant height (s) using the Pythagorean theorem.\n    slant_height = math.sqrt((base_edge / 2)**2 + height**2)\n\n    # Calculate the area of the square base.\n    base_area = base_edge**2\n\n    # Calculate the lateral surface area from the base edge and slant height.\n    lateral_area = 2 * base_edge * slant_height\n\n    # Sum the base and lateral areas for the total surface area.\n    return base_area + lateral_area"}
{"task_id": "Mbpp/583", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef catalan_number(n: int) -> int:\n    \"\"\"\n    Calculates the nth Catalan number.\n    Raises InvalidInputError if n is negative.\n    \"\"\"\n    if n < 0:\n        raise InvalidInputError(\"Input 'n' must be a non-negative integer.\")\n    \n    if n == 0:\n        return 1\n    \n    # Computes C_n using the recurrence relation: C_i = C_{i-1} * (4i - 2) / (i + 1).\n    # This method is efficient and ensures mathematically correct integer results.\n    catalans = [0] * (n + 1)\n    catalans[0] = 1\n\n    for i in range(1, n + 1):\n        catalans[i] = catalans[i-1] * (4 * i - 2) // (i + 1)\n        \n    return catalans[n]"}
{"task_id": "Mbpp/585", "solution": "from typing import List, TypedDict, Union\nclass Item(TypedDict):\n    \"\"\"\n    Represents an item with a name and a price.\n    \"\"\"\n    name: str\n    price: float\nclass InvalidInputError(ValueError):\n    \"\"\"\n    Custom exception raised for invalid input parameters or malformed item data.\n    \"\"\"\n    pass\ndef expensive_items(items: List[Item], n: int) -> List[Item]:\n    \"\"\"\n    Finds the n most expensive items from a given list, sorted by price in descending order.\n    Raises InvalidInputError for invalid inputs or malformed items.\n    \"\"\"\n    # Validate top-level inputs: items must be a list, n must be a non-negative integer.\n    if not isinstance(items, list):\n        raise InvalidInputError(\"Input 'items' must be a list.\")\n    if not isinstance(n, int):\n        raise InvalidInputError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise InvalidInputError(\"Input 'n' cannot be negative.\")\n\n    # Return an empty list if n is zero as per FR6.\n    if n == 0:\n        return []\n\n    # Validate each item's structure and types as per FR1.\n    for item in items:\n        if not isinstance(item, dict):\n            raise InvalidInputError(\"Each item in the list must be a dictionary.\")\n        if 'name' not in item or not isinstance(item['name'], str):\n            raise InvalidInputError(\"Each item must have a 'name' (string) key.\")\n        if 'price' not in item or not isinstance(item['price'], (int, float)):\n            raise InvalidInputError(\"Each item must have a 'price' (numeric) key.\")\n        if item['price'] < 0:\n            raise InvalidInputError(\"Item 'price' cannot be negative.\")\n\n    # Sort items by price in descending order (FR1.3, FR4).\n    sorted_items = sorted(items, key=lambda x: x['price'], reverse=True)\n\n    # Return the first n items (FR1.4), handling cases where n > total items (FR5).\n    return sorted_items[:n]"}
