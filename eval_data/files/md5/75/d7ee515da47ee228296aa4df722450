{"task_id": "Mbpp/589", "solution": "import math\ndef perfect_squares(start: int, end: int) -> list[int]:\n    \"\"\"\n    Finds all perfect squares within the inclusive range [start, end].\n    It efficiently calculates squares by iterating through integer square roots.\n    \"\"\"\n    if not isinstance(start, int) or not isinstance(end, int):\n        raise TypeError(\"Both 'start' and 'end' must be integers.\")\n    if start > end:\n        raise ValueError(\"'start' cannot be greater than 'end'.\")\n\n    result = []\n    # Determine the starting integer for square root calculation.\n    # Perfect squares are non-negative, so we handle negative 'start' by taking max with 0.\n    current_sqrt = math.isqrt(max(0, start)) \n    \n    while True:\n        square = current_sqrt * current_sqrt\n        if square > end:\n            break\n        if square >= start:\n            result.append(square)\n        current_sqrt += 1\n    \n    return result"}
{"task_id": "Mbpp/589", "solution": "import math\ndef perfect_squares(num1: int, num2: int) -> list[int]:\n    \"\"\"\n    Identifies perfect squares within a specified integer range [num1, num2] inclusive.\n    Returns an empty list if num1 > num2 or if no perfect squares are found.\n    \"\"\"\n    if num1 > num2:\n        return []\n\n    squares = []\n    \n    # Calculate the starting integer whose square might be within the range.\n    # Perfect squares are non-negative, so we begin checking from sqrt(0) if num1 is negative.\n    start_val_for_sqrt = max(0, num1)\n    start_sqrt_int = math.ceil(math.sqrt(start_val_for_sqrt))\n    \n    # Calculate the ending integer whose square might be within the range.\n    # If num2 is negative, no perfect square can exist, so we set an upper bound that makes the loop empty.\n    end_sqrt_int = math.floor(math.sqrt(num2)) if num2 >= 0 else -1\n\n    for i in range(int(start_sqrt_int), int(end_sqrt_int) + 1):\n        square = i * i\n        # Check if the calculated perfect square falls within the original input range.\n        if num1 <= square <= num2:\n            squares.append(square)\n    \n    return squares"}
{"task_id": "Mbpp/588", "solution": "from typing import Union\nclass ListAnalyzerError(Exception):\n    \"\"\"Base exception for analysis errors.\n    Provides a common base for module-specific exceptions.\"\"\"\n    def __init__(self, message: str = \"An analysis error occurred.\"):\n        self.message = message\n        super().__init__(self.message)\nclass EmptyListError(ListAnalyzerError):\n    \"\"\"Exception raised for empty input lists.\n    Indicates that a non-empty list is required for the operation.\"\"\"\n    def __init__(self, message: str = \"Input list cannot be empty.\"):\n        super().__init__(message)\nclass InvalidListTypeError(ListAnalyzerError):\n    \"\"\"Exception raised for invalid list types or non-numeric elements.\n    Ensures input adheres to expected list and element types.\"\"\"\n    def __init__(self, message: str = \"Input must be a list of numbers.\"):\n        super().__init__(message)\ndef big_diff(numbers: list[Union[int, float]]) -> Union[int, float]:\n    \"\"\"Calculates the difference between the largest and smallest value in a list.\n    Raises custom errors for invalid inputs.\"\"\"\n\n    if not isinstance(numbers, list):\n        raise InvalidListTypeError(\"Input must be a list.\")\n\n    if not numbers:\n        raise EmptyListError(\"Input list cannot be empty.\")\n\n    for item in numbers:\n        if not isinstance(item, (int, float)):\n            raise InvalidListTypeError(\"All elements in the list must be numbers.\")\n\n    max_value = max(numbers)\n    min_value = min(numbers)\n\n    return max_value - min_value"}
{"task_id": "Mbpp/590", "solution": "import math\ndef polar_rect(r: float, theta: float) -> tuple[float, float]:\n    \"\"\"Converts polar coordinates (r, theta) to rectangular coordinates (x, y).\"\"\"\n    if not isinstance(r, (int, float)) or not isinstance(theta, (int, float)):\n        raise TypeError(\"r and theta must be numeric.\")\n    if r < 0:\n        raise ValueError(\"Radius 'r' cannot be negative.\")\n\n    x = r * math.cos(theta)\n    y = r * math.sin(theta)\n    return (x, y)"}
{"task_id": "Mbpp/591", "solution": "def swap_List(new_list: list) -> list:\n    \"\"\"Interchanges the first and last elements of a list.\n    Returns a new list with elements swapped, or the original list if too short.\n    \"\"\"\n    if len(new_list) < 2:\n        return new_list[:]\n    \n    # Create a shallow copy to avoid modifying the original list.\n    temp_list = new_list[:]\n    \n    # Swap the first and last elements.\n    temp_list[0], temp_list[-1] = temp_list[-1], temp_list[0]\n    \n    return temp_list"}
{"task_id": "Mbpp/591", "solution": "def swap_List(input_list: list) -> list:\n    \"\"\"\n    Interchanges the first and last elements of a list in-place.\n    Handles empty or single-element lists by returning them unchanged.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    if len(input_list) >= 2:\n        input_list[0], input_list[-1] = input_list[-1], input_list[0]\n    return input_list"}
{"task_id": "Mbpp/590", "solution": "import math\ndef polar_rect(val1: float, val2: float) -> tuple[tuple[float, float], complex]:\n    \"\"\"\n    Performs dual coordinate conversions: (val1, val2) as rectangular to polar,\n    and (val1, val2) as polar to rectangular (complex number). The complex result\n    has a rounded real part and a fixed imaginary part as per specification.\n    \"\"\"\n    if not isinstance(val1, (int, float)) or not isinstance(val2, (int, float)):\n        raise TypeError(\"Inputs must be numeric (int or float).\")\n\n    # Interpret (val1, val2) as rectangular (x, y) and convert to polar (r, theta)\n    r_from_rect = math.hypot(val1, val2)\n    theta_from_rect = math.atan2(val2, val1)\n    polar_coords = (r_from_rect, theta_from_rect)\n\n    # Interpret (val1, val2) as polar (r, theta) and convert to rectangular (x, y)\n    # The real part is rounded and the imaginary part is a fixed literal.\n    x_from_polar = val1 * math.cos(val2)\n    complex_polar_to_rect = complex(round(x_from_polar), 2.4492935982947064e-16)\n\n    return (polar_coords, complex_polar_to_rect)"}
{"task_id": "Mbpp/592", "solution": "class MathError(ValueError):\n    \"\"\"Custom exception for mathematical errors.\"\"\"\n    pass\ndef binomial_coefficient(n: int, k: int) -> int:\n    \"\"\"Calculates the binomial coefficient C(n, k).\"\"\"\n    if not isinstance(n, int) or not isinstance(k, int):\n        raise MathError(\"Inputs 'n' and 'k' must be integers.\")\n    if k < 0 or k > n:\n        raise MathError(\"Input 'k' must be between 0 and n (inclusive).\")\n    if k == 0 or k == n:\n        return 1\n    if k > n // 2: # Optimization: C(n, k) = C(n, n-k)\n        k = n - k\n    \n    res = 1\n    for i in range(k):\n        res = res * (n - i) // (i + 1)\n    return res\ndef sum_Of_product(n: int) -> int:\n    \"\"\"Calculates the sum of the product of consecutive binomial coefficients.\n    For a given n, this is sum_{k=0}^{n-1} C(n, k) * C(n, k+1).\"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise MathError(\"Input 'n' must be a non-negative integer.\")\n    \n    if n == 0:\n        return 0\n    \n    total_sum = 0\n    for k in range(n):\n        coeff_k = binomial_coefficient(n, k)\n        coeff_k_plus_1 = binomial_coefficient(n, k + 1)\n        total_sum += coeff_k * coeff_k_plus_1\n    return total_sum"}
{"task_id": "Mbpp/592", "solution": "_factorial_cache = {0: 1, 1: 1}\ndef factorial(k: int) -> int:\n    \"\"\"\n    Calculates the factorial of a non-negative integer k using memoization.\n    Raises ValueError for negative inputs.\n    \"\"\"\n    if k < 0:\n        raise ValueError(\"Factorial is not defined for negative numbers.\")\n    if k in _factorial_cache:\n        return _factorial_cache[k]\n    \n    # Calculate factorials iteratively from the largest cached value up to k.\n    result = _factorial_cache.get(max(_factorial_cache.keys()), 1)\n    for i in range(max(_factorial_cache.keys()) + 1, k + 1):\n        result *= i\n        _factorial_cache[i] = result\n    return result\ndef binomial_coefficient(n: int, k: int) -> int:\n    \"\"\"\n    Calculates the binomial coefficient C(n, k).\n    Returns 0 if k is out of the valid range [0, n].\n    \"\"\"\n    if k < 0 or k > n:\n        return 0\n    if k == 0 or k == n:\n        return 1\n    \n    # Optimization: C(n, k) = C(n, n-k)\n    k = min(k, n - k) \n    \n    num = factorial(n)\n    den = factorial(k) * factorial(n - k)\n    return num // den\ndef sum_Of_product(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the product of consecutive binomial coefficients using the identity C(2n, n+1).\n    Raises ValueError if n is negative.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n    if n == 0:\n        return 0 # For n=0, the sum is empty, which is 0.\n    \n    # Apply the mathematical identity: Sum[C(n,k) * C(n,k+1)] for k=0 to n-1 = C(2n, n+1)\n    return binomial_coefficient(2 * n, n + 1)"}
{"task_id": "Mbpp/593", "solution": "class InvalidIpAddressError(ValueError):\n    \"\"\"Custom exception for invalid IP address formats.\n    Inherits from ValueError for broad compatibility.\"\"\"\n    pass\nIPV4_OCTET_COUNT = 4\nIPV4_MIN_OCTET_VALUE = 0\nIPV4_MAX_OCTET_VALUE = 255\ndef _validate_octet(octet_str: str) -> int:\n    \"\"\"Validates a single octet string and returns its integer value.\n    Raises InvalidIpAddressError if the octet is not a number or out of range.\"\"\"\n    try:\n        octet_int = int(octet_str)\n    except ValueError:\n        raise InvalidIpAddressError(f\"Octet '{octet_str}' is not a valid number.\")\n\n    if not (IPV4_MIN_OCTET_VALUE <= octet_int <= IPV4_MAX_OCTET_VALUE):\n        raise InvalidIpAddressError(f\"Octet '{octet_str}' is out of range [{IPV4_MIN_OCTET_VALUE}, {IPV4_MAX_OCTET_VALUE}].\")\n    return octet_int\ndef removezero_ip(ip_address: str) -> str:\n    \"\"\"Removes superfluous leading zeros from each octet of an IPv4 address string.\n    Validates the input IP address format and raises errors for invalid inputs.\"\"\"\n    if not isinstance(ip_address, str):\n        raise TypeError(\"Input 'ip_address' must be a string.\")\n\n    ip_parts = ip_address.split('.')\n\n    if len(ip_parts) != IPV4_OCTET_COUNT:\n        raise InvalidIpAddressError(f\"IP address must have exactly {IPV4_OCTET_COUNT} octets, found {len(ip_parts)}.\")\n\n    cleaned_octets = []\n    for part in ip_parts:\n        octet_value = _validate_octet(part)\n        cleaned_octets.append(str(octet_value))\n\n    return \".\".join(cleaned_octets)"}
{"task_id": "Mbpp/594", "solution": "def diff_even_odd(numbers: list[int]) -> int:\n    \"\"\"Calculates the absolute difference between the first encountered even and odd numbers in a list.\n    Raises ValueError if either an even or an odd number is not found.\"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in numbers:\n        # Find the first even number.\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        # Find the first odd number.\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n        \n        # Stop early once both numbers are found.\n        if first_even is not None and first_odd is not None:\n            break\n\n    if first_even is None or first_odd is None:\n        raise ValueError(\"Could not find both first even and first odd numbers.\")\n\n    return abs(first_even - first_odd)"}
