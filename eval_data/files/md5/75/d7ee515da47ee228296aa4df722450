{"task_id": "Mbpp/610", "solution": "def remove_kth_element(input_list: list, k: int) -> list:\n    \"\"\"\n    Returns a new list with the k-th element (1-indexed) removed.\n    Handles various error conditions for invalid inputs.\n\n    Args:\n        input_list: The original list.\n        k: The 1-indexed position of the element to remove.\n\n    Returns:\n        A new list with the k-th element removed.\n\n    Raises:\n        ValueError: If input_list is empty.\n        TypeError: If k is not an integer.\n        IndexError: If k is out of the valid range [1, len(input_list)].\n    \"\"\"\n    if not input_list:\n        raise ValueError(\"Input list cannot be empty.\")\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an integer.\")\n    if not (1 <= k <= len(input_list)):\n        raise IndexError(f\"k ({k}) is out of range for list of length {len(input_list)}. Must be between 1 and {len(input_list)} (inclusive).\")\n\n    # k is 1-indexed, so convert to 0-indexed for Python list operations.\n    index_to_remove = k - 1\n    \n    # Create a new list by slicing.\n    return input_list[:index_to_remove] + input_list[index_to_remove + 1:]"}
{"task_id": "Mbpp/611", "solution": "def max_of_nth(matrix: list[list[int]], n: int) -> int:\n    \"\"\"Calculates and returns the maximum integer value found in the n-th column of the input matrix.\n    Raises ValueError for empty/ragged matrices or IndexError if n is out of bounds.\n    \"\"\"\n    if not matrix:\n        raise ValueError(\"Matrix cannot be empty.\")\n\n    num_rows = len(matrix)\n    num_cols = len(matrix[0])\n\n    for row in matrix:\n        if len(row) != num_cols:\n            raise ValueError(\"All rows in the matrix must have the same length.\")\n\n    if not (0 <= n < num_cols):\n        raise IndexError(f\"Column index {n} is out of bounds for a matrix with {num_cols} columns.\")\n\n    max_val = matrix[0][n]\n    for i in range(1, num_rows):\n        if matrix[i][n] > max_val:\n            max_val = matrix[i][n]\n    return max_val"}
{"task_id": "Mbpp/614", "solution": "from typing import Union, List, Tuple\nclass InvalidInputError(ValueError):\n    \"\"\"Exception raised for invalid input to the cumulative sum function.\"\"\"\n    pass\ndef cummulative_sum(data: List[Tuple[Union[int, float], ...]]) -> Union[int, float]:\n    \"\"\"Calculates the cumulative sum of all numeric values within a list of tuples.\n    Raises InvalidInputError for invalid input types or non-numeric elements.\n    \"\"\"\n    if not isinstance(data, list):\n        raise InvalidInputError(\"Input must be a list.\")\n\n    total_sum: Union[int, float] = 0\n\n    for i, current_tuple in enumerate(data):\n        if not isinstance(current_tuple, tuple):\n            raise InvalidInputError(f\"Element at index {i} is not a tuple: {type(current_tuple)}\")\n        \n        for j, element in enumerate(current_tuple):\n            if not isinstance(element, (int, float)):\n                raise InvalidInputError(\n                    f\"Non-numeric element found at tuple index {i}, element index {j}: \"\n                    f\"'{element}' of type {type(element)}.\"\n                )\n            total_sum += element\n            \n    return total_sum"}
{"task_id": "Mbpp/612", "solution": "from typing import Any, List\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to transformation functions.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef merge(data: List[List[Any]]) -> List[List[Any]]:\n    \"\"\"Transforms a list of two-element sublists into two separate lists.\n    The first returned list contains all first elements, and the second contains all second elements.\n    \"\"\"\n    if not isinstance(data, list):\n        raise InvalidInputError(\"Input must be a list.\")\n\n    first_elements = []\n    second_elements = []\n\n    for i, sublist in enumerate(data):\n        if not isinstance(sublist, list):\n            raise InvalidInputError(f\"Element at index {i} is not a list: {sublist}\")\n        if len(sublist) != 2:\n            raise InvalidInputError(f\"Sublist at index {i} must contain exactly two elements, but found {len(sublist)}: {sublist}\")\n        first_elements.append(sublist[0])\n        second_elements.append(sublist[1])\n\n    return [first_elements, second_elements]"}
{"task_id": "Mbpp/612", "solution": "def merge(input_list):\n    \"\"\"\n    Transforms a list of two-element sublists into two separate lists.\n    The first output list contains all first elements, and the second contains all second elements.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    first_elements = []\n    second_elements = []\n\n    for i, sublist in enumerate(input_list):\n        if not isinstance(sublist, list):\n            raise ValueError(f\"Element at index {i} is not a list: {sublist}\")\n        if len(sublist) != 2:\n            raise ValueError(f\"Sublist at index {i} must contain exactly two elements, but found {len(sublist)}: {sublist}\")\n        first_elements.append(sublist[0])\n        second_elements.append(sublist[1])\n\n    return [first_elements, second_elements]"}
{"task_id": "Mbpp/611", "solution": "from typing import List, Any, Optional\ndef max_of_nth(matrix: List[List[Any]], n: int) -> Optional[Any]:\n    \"\"\"\n    Returns the maximum value of the n-th column in a matrix.\n\n    Handles edge cases like empty matrix or invalid column index.\n    \"\"\"\n    if not matrix:\n        return None\n    if n < 0:\n        return None\n\n    max_val: Optional[Any] = None\n    found_comparable_element = False\n\n    for row in matrix:\n        if len(row) > n:\n            current_element = row[n]\n            if not found_comparable_element:\n                max_val = current_element\n                found_comparable_element = True\n            elif current_element is not None and (max_val is None or current_element > max_val):\n                max_val = current_element\n    \n    if not found_comparable_element:\n        return None\n\n    return max_val"}
{"task_id": "Mbpp/614", "solution": "from typing import List, Tuple, Union\ndef cummulative_sum(tuple_list: List[Tuple[Union[int, float], ...]]) -> Union[int, float]:\n    \"\"\"\n    Calculates the sum of all numeric values across a list of tuples.\n    It iterates through each tuple and sums its numeric elements.\n    \"\"\"\n    total_sum: Union[int, float] = 0\n    for inner_tuple in tuple_list:\n        for item in inner_tuple:\n            total_sum += item\n    return total_sum"}
{"task_id": "Mbpp/615", "solution": "from typing import List, Tuple, Union\ndef average_tuple(data: Tuple[Tuple[Union[int, float], ...], ...]) -> List[float]:\n    \"\"\"\n    Calculates the average value for each inner tuple in a tuple of tuples.\n    Returns 0.0 for empty inner tuples as per requirements.\n    \"\"\"\n    results: List[float] = []\n    for inner_tuple in data:\n        if not inner_tuple:\n            results.append(0.0)\n        else:\n            results.append(sum(inner_tuple) / len(inner_tuple))\n    return results"}
{"task_id": "Mbpp/615", "solution": "def average_tuple(data: tuple[tuple[int | float, ...], ...]) -> list[float]:\n    \"\"\"Calculates the average for each inner tuple in a tuple of tuples.\n    Raises `TypeError` for invalid input types or `ZeroDivisionError` for empty inner tuples.\n    \"\"\"\n    if not isinstance(data, tuple) or not all(isinstance(t, tuple) for t in data):\n        raise TypeError(\"Input must be a tuple of tuples.\")\n\n    results = []\n    for inner_tuple in data:\n        if not inner_tuple:\n            raise ZeroDivisionError(\"Inner tuple cannot be empty.\")\n\n        if not all(isinstance(x, (int, float)) for x in inner_tuple):\n            raise TypeError(\"Inner tuple must contain only numbers.\")\n\n        current_sum = sum(inner_tuple)\n        current_count = len(inner_tuple)\n        results.append(current_sum / current_count)\n    return results"}
{"task_id": "Mbpp/616", "solution": "def tuple_modulo(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise modulo operation on two tuples of the same length.\n    It validates inputs for type, length, numeric elements, and zero divisors.\n    \"\"\"\n    if not isinstance(tuple1, tuple) or not isinstance(tuple2, tuple):\n        raise TypeError(\"Both inputs must be tuples.\")\n\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Tuples must be of the same length.\")\n\n    result_list = []\n    for val1, val2 in zip(tuple1, tuple2):\n        if not isinstance(val1, (int, float)) or not isinstance(val2, (int, float)):\n            raise TypeError(\"All elements in tuples must be numeric (int or float).\")\n\n        if val2 == 0:\n            raise ZeroDivisionError(\"Modulo by zero is not allowed.\")\n\n        result_list.append(val1 % val2)\n\n    return tuple(result_list)"}
{"task_id": "Mbpp/618", "solution": "def div_list(list1: list[float | int], list2: list[float | int]) -> list[float]:\n    \"\"\"Divides each element of list1 by the corresponding element of list2, handling various error conditions.\"\"\"\n    if not list1 or not list2:\n        raise ValueError(\"Input lists cannot be empty.\")\n    if len(list1) != len(list2):\n        raise ValueError(\"Input lists must have the same length.\")\n\n    result: list[float] = []\n    for i in range(len(list1)):\n        # Validate that elements are numbers before division.\n        if not isinstance(list1[i], (int, float)) or not isinstance(list2[i], (int, float)):\n            raise TypeError(\"All elements in input lists must be numbers (int or float).\")\n        if list2[i] == 0:\n            raise ZeroDivisionError(f\"Cannot divide by zero at index {i}.\")\n        result.append(float(list1[i]) / list2[i])\n    return result"}
{"task_id": "Mbpp/618", "solution": "from typing import List, Union\nclass ListOperationsError(Exception):\n    \"\"\"Base exception for list operations.\"\"\"\n    def __init__(self, message: str):\n        self.message = message\n        super().__init__(self.message)\nclass ListLengthMismatchError(ListOperationsError):\n    \"\"\"Raised when two lists have different lengths for element-wise operations.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\nclass DivisionByZeroError(ListOperationsError):\n    \"\"\"Raised when an attempt is made to divide by zero.\"\"\"\n    def __init__(self, message: str, index: int):\n        self.index = index\n        super().__init__(f\"{message} at index {index}\")\ndef div_list(list1: List[Union[int, float]], list2: List[Union[int, float]]) -> List[float]:\n    \"\"\"\n    Divides elements of list1 by corresponding elements of list2 element-wise.\n    Raises errors for type, length, or division by zero issues.\n    \"\"\"\n    if not isinstance(list1, list) or not isinstance(list2, list):\n        raise TypeError(\"Both inputs must be lists.\")\n\n    if len(list1) != len(list2):\n        raise ListLengthMismatchError(\"Lists must have the same length for element-wise division.\")\n\n    result = []\n    for i in range(len(list1)):\n        if list2[i] == 0:\n            raise DivisionByZeroError(\"Cannot divide by zero\", i)\n        try:\n            result.append(float(list1[i]) / list2[i])\n        except TypeError:\n            raise TypeError(f\"Non-numeric element found at index {i} in one of the lists.\")\n    return result"}
{"task_id": "Mbpp/616", "solution": "def tuple_modulo(tuple1, tuple2):\n    \"\"\"\n    Performs element-wise modulo operation on two tuples of numbers.\n    Raises TypeError, ValueError, or ZeroDivisionError for invalid inputs.\n    \"\"\"\n    if not isinstance(tuple1, tuple) or not isinstance(tuple2, tuple):\n        raise TypeError(\"Both inputs must be tuples.\")\n\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Input tuples must have the same length.\")\n\n    result = []\n    for i in range(len(tuple1)):\n        val1 = tuple1[i]\n        val2 = tuple2[i]\n\n        if not isinstance(val1, (int, float)) or not isinstance(val2, (int, float)):\n            raise TypeError(\"All tuple elements must be numeric (int or float).\")\n        \n        # Python's % operator handles float modulo and raises ZeroDivisionError correctly.\n        result.append(val1 % val2)\n    \n    return tuple(result)"}
{"task_id": "Mbpp/619", "solution": "def move_num(input_string: str) -> str:\n    \"\"\"Moves all numeric characters to the end of the string, preserving relative order.\n    Digits '0'-'9' are considered numeric; others are non-numeric.\"\"\"\n    non_numeric_chars = []\n    numeric_chars = []\n    for char in input_string:\n        if '0' <= char <= '9':\n            numeric_chars.append(char)\n        else:\n            non_numeric_chars.append(char)\n    return \"\".join(non_numeric_chars) + \"\".join(numeric_chars)"}
{"task_id": "Mbpp/619", "solution": "def move_num(input_string: str) -> str:\n    \"\"\"\n    Relocates all numeric characters to the end of the input string,\n    preserving the relative order of both non-numeric and numeric characters.\n    \"\"\"\n    if not isinstance(input_string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    non_numeric_chars = []\n    numeric_chars = []\n\n    for char in input_string:\n        if '0' <= char <= '9':\n            numeric_chars.append(char)\n        else:\n            non_numeric_chars.append(char)\n\n    return \"\".join(non_numeric_chars) + \"\".join(numeric_chars)"}
{"task_id": "Mbpp/620", "solution": "def largest_subset(numbers: list[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset where every pair (a, b) satisfies a % b == 0 or b % a == 0.\n    Raises TypeError for invalid input type or ValueError for non-positive integers.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n    if not all(isinstance(n, int) for n in numbers):\n        raise TypeError(\"All elements in the list must be integers.\")\n    if any(n <= 0 for n in numbers):\n        raise ValueError(\"All numbers in the list must be positive integers.\")\n\n    n = len(numbers)\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n\n    numbers.sort()\n    dp = [1] * n\n\n    for i in range(n):\n        for j in range(i):\n            if numbers[i] % numbers[j] == 0:\n                dp[i] = max(dp[i], dp[j] + 1)\n\n    return max(dp)"}
{"task_id": "Mbpp/622", "solution": "def get_median(list1: list[int], list2: list[int], n: int) -> float:\n    \"\"\"Calculates the median of two sorted lists of the same size n.\n    It iterates through both lists to find the n-th and (n+1)-th elements of the combined sorted sequence.\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Size 'n' must be a non-negative integer.\")\n    if len(list1) != n or len(list2) != n:\n        raise ValueError(\"List lengths must match the provided size 'n'.\")\n    if n == 0:\n        return 0.0 # Returns 0.0 for empty lists as per design decision.\n\n    i = 0  # Pointer for list1\n    j = 0  # Pointer for list2\n    m1 = -1 # Stores the n-th element encountered\n    m2 = -1 # Stores the (n+1)-th element encountered\n\n    # Iterate n + 1 times to find the n-th and (n+1)-th elements.\n    for _ in range(n + 1):\n        if i == n: # list1 exhausted, take from list2\n            m1 = m2\n            m2 = list2[j]\n            j += 1\n        elif j == n: # list2 exhausted, take from list1\n            m1 = m2\n            m2 = list1[i]\n            i += 1\n        elif list1[i] <= list2[j]: # Compare and take smaller element\n            m1 = m2\n            m2 = list1[i]\n            i += 1\n        else: # Compare and take smaller element\n            m1 = m2\n            m2 = list2[j]\n            j += 1\n    return (float(m1) + float(m2)) / 2.0"}
{"task_id": "Mbpp/623", "solution": "from typing import List, Union\ndef nth_nums(numbers: List[Union[int, float]], n: int) -> List[Union[int, float]]:\n    \"\"\"\n    Computes the n-th power of each number in a list.\n    Raises TypeError for invalid input types or non-numeric list elements.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input 'numbers' must be a list.\")\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n\n    result = []\n    for num in numbers:\n        if not isinstance(num, (int, float)):\n            raise TypeError(f\"All elements in 'numbers' must be integers or floats, got {type(num).__name__}.\")\n        result.append(num ** n)\n    return result"}
{"task_id": "Mbpp/620", "solution": "def largest_subset(numbers: list[int]) -> int:\n    \"\"\"\n    Finds the size of the largest divisible subset from a list of numbers.\n    A subset is divisible if for any two numbers 'a', 'b', either 'a % b == 0' or 'b % a == 0'.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n    if not all(isinstance(x, int) for x in numbers):\n        raise TypeError(\"All elements in the list must be integers.\")\n\n    if not numbers:\n        return 0\n\n    # Sort the numbers to simplify divisibility checks.\n    # dp[i] stores the size of the largest divisible subset ending with sorted_numbers[i].\n    sorted_numbers = sorted(numbers)\n    n = len(sorted_numbers)\n    dp = [1] * n\n\n    for i in range(n):\n        for j in range(i):\n            # Skip if the potential divisor is zero to prevent ZeroDivisionError.\n            # If sorted_numbers[i] is 0, it can't be divided by anything except itself.\n            # If sorted_numbers[j] is 0, it can't divide other numbers (except 0 by 0 is undefined, but usually not considered here).\n            # For this problem, we usually assume positive integers, but handling 0 explicitly.\n            if sorted_numbers[j] == 0:\n                continue\n            if sorted_numbers[i] % sorted_numbers[j] == 0:\n                dp[i] = max(dp[i], dp[j] + 1)\n\n    return max(dp)"}
{"task_id": "Mbpp/622", "solution": "from typing import List, Union\ndef get_median(list1: List[Union[int, float]], list2: List[Union[int, float]], n: int) -> float:\n    \"\"\"\n    Finds the median of two sorted lists of the same size.\n    It uses a linear time complexity approach to find the middle elements.\n    \"\"\"\n    _validate_inputs(list1, list2, n)\n\n    if n == 0:\n        return 0.0\n\n    i = 0 # Pointer for list1\n    j = 0 # Pointer for list2\n    m1 = -1.0 # To store the (n-1)-th element.\n    m2 = -1.0 # To store the n-th element.\n\n    # The combined list has 2*n elements. The median is the average of\n    # the (n-1)-th and n-th elements (0-indexed) if sorted.\n    for count in range(n + 1):\n        if i == n: # list1 is exhausted.\n            m1 = m2\n            m2 = float(list2[j])\n            j += 1\n        elif j == n: # list2 is exhausted.\n            m1 = m2\n            m2 = float(list1[i])\n            i += 1\n        elif list1[i] <= list2[j]:\n            m1 = m2\n            m2 = float(list1[i])\n            i += 1\n        else: # list2[j] < list1[i].\n            m1 = m2\n            m2 = float(list2[j])\n            j += 1\n    \n    return (m1 + m2) / 2.0"}
