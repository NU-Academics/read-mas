{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the series (n - 2*i) for i from 0 up to n // 2.\n    Only terms greater than 0 are included in the sum.\n    \"\"\"\n    if n < 0:\n        return 0\n\n    total_sum = 0\n    for i in range(n // 2 + 1):\n        term = n - (2 * i)\n        if term > 0:\n            total_sum += term\n        else:\n            break\n    return total_sum"}
{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"Calculates the sum of the series n, n-2, n-4, ... where each term is strictly positive.\n    Raises ValueError for invalid n.\n    \"\"\"\n    if not isinstance(n, int):\n        raise ValueError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    total_sum = 0\n    current_term = n\n    while current_term > 0:\n        total_sum += current_term\n        current_term -= 2\n    return total_sum"}
{"task_id": "Mbpp/160", "solution": "from typing import Tuple, Optional\nclass MathUtils:\n    @staticmethod\n    def gcd(a: int, b: int) -> int:\n        \"\"\"Computes the greatest common divisor of two integers using the Euclidean algorithm.\"\"\"\n        while b:\n            a, b = b, a % b\n        return abs(a)\n\n    @staticmethod\n    def extended_gcd(a: int, b: int) -> Tuple[int, int, int]:\n        \"\"\"\n        Implements the Extended Euclidean Algorithm to find g = gcd(a, b) and integers x, y\n        such that ax + by = g.\n        \"\"\"\n        if a == 0:\n            return b, 0, 1\n        g, x, y = MathUtils.extended_gcd(b % a, a)\n        return g, y - (b // a) * x, x\ndef find_solution(a: int, b: int, n: int) -> Optional[Tuple[int, int]]:\n    \"\"\"\n    Finds a particular integer solution (x, y) for the equation ax + by = n.\n    Returns None if no integer solution exists.\n    \"\"\"\n    g, x_prime, y_prime = MathUtils.extended_gcd(a, b)\n\n    if n % g != 0:\n        return None\n    \n    k = n // g\n    x = x_prime * k\n    y = y_prime * k\n    return x, y"}
{"task_id": "Mbpp/165", "solution": "ALPHABET_POSITIONS = {\n    'A': 1, 'B': 2, 'C': 3, 'D': 4, 'E': 5, 'F': 6, 'G': 7, 'H': 8, 'I': 9,\n    'J': 10, 'K': 11, 'L': 12, 'M': 13, 'N': 14, 'O': 15, 'P': 16, 'Q': 17,\n    'R': 18, 'S': 19, 'T': 20, 'U': 21, 'V': 22, 'W': 23, 'X': 24, 'Y': 25,\n    'Z': 26\n}\ndef count_char_position(input_string: str) -> int:\n    \"\"\"\n    Counts characters where their 1-based string position matches their 1-based alphabetical position (case-insensitive).\n    Non-alphabetic characters are ignored.\n    \"\"\"\n    match_count = 0\n    upper_input_string = input_string.upper()\n\n    for i, char in enumerate(upper_input_string):\n        string_position = i + 1  # 1-based index\n        \n        if char in ALPHABET_POSITIONS:\n            alphabet_position = ALPHABET_POSITIONS[char]\n            if string_position == alphabet_position:\n                match_count += 1\n    return match_count"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(numbers: list[int]) -> int:\n    \"\"\"\n    Counts pairs of integers in a list that XOR to an even number.\n    This occurs when both numbers in a pair are even, or both are odd.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    for num in numbers:\n        if num % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    # Calculate pairs of even numbers and odd numbers.\n    even_even_pairs = (even_count * (even_count - 1)) // 2\n    odd_odd_pairs = (odd_count * (odd_count - 1)) // 2\n\n    return even_even_pairs + odd_odd_pairs"}
{"task_id": "Mbpp/165", "solution": "ALPHABET_START_ORD = ord('a')\ndef _get_alphabet_position(char: str) -> int:\n    \"\"\"\n    Determines the 1-based alphabetical position of a character.\n    Returns 0 if the character is not an alphabet letter.\n    \"\"\"\n    if not char.isalpha():\n        return 0\n    return ord(char.lower()) - ALPHABET_START_ORD + 1\ndef count_char_position(text: str) -> int:\n    \"\"\"\n    Counts characters where string position matches 1-based alphabet position.\n    Comparison is case-insensitive, non-alphabetic characters are ignored.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input must be a string.\")\n\n    count = 0\n    for i, char in enumerate(text):\n        string_position = i + 1  # 1-based index\n        alphabet_position = _get_alphabet_position(char)\n\n        if alphabet_position > 0 and string_position == alphabet_position:\n            count += 1\n    return count"}
{"task_id": "Mbpp/166", "solution": "from typing import List\ndef find_even_pair(nums: List[int]) -> int:\n    \"\"\"\n    Counts pairs of integers in a list whose bitwise XOR sum is an even number.\n    Pairs (A, B) have an even XOR sum if A and B have the same parity.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    for num in nums:\n        if num % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    # Calculate pairs from even numbers and odd numbers independently.\n    # The formula n * (n - 1) // 2 gives combinations of 2 items from n.\n    even_pairs = even_count * (even_count - 1) // 2\n    odd_pairs = odd_count * (odd_count - 1) // 2\n\n    return even_pairs + odd_pairs"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Calculates the smallest power of 2 that is greater than or equal to n.\n    Raises ValueError if n is negative.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n    if n <= 1:\n        return 1\n    \n    # Decrement n to correctly handle cases where n is already a power of 2.\n    # This ensures the bitwise operations yield n itself, not 2*n.\n    n -= 1\n    \n    # Set all bits below the most significant bit.\n    # This efficiently \"fills in\" the bits to create a mask.\n    n |= n >> 1\n    n |= n >> 2\n    n |= n >> 4\n    n |= n >> 8\n    n |= n >> 16 # Extends coverage for larger numbers.\n    n |= n >> 32 # Covers numbers up to 2^64-1, and Python handles arbitrary size.\n    \n    # Increment by 1 to get the next power of 2.\n    return n + 1"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Calculates the smallest power of 2 (2^k) greater than or equal to n.\n    Input n must be a non-negative integer.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n    if n == 0:\n        return 1\n    \n    # Check if n is already a power of 2.\n    if (n & (n - 1)) == 0:\n        return n\n\n    # The algorithm computes the next highest power of 2 for n > 0.\n    # It fills all bits to the right of the most significant bit.\n    n -= 1\n    n |= n >> 1\n    n |= n >> 2\n    n |= n >> 4\n    n |= n >> 8\n    n |= n >> 16\n    n |= n >> 32 \n    \n    return n + 1"}
