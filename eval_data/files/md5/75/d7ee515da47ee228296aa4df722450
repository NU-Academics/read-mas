{"task_id": "Mbpp/410", "solution": "def min_val(data_list: list) -> int | float:\n    \"\"\"\n    Finds the minimum numeric value (integer or float) within a heterogeneous list.\n    Ignores non-numeric types and raises ValueError if no numeric values are present.\n    \"\"\"\n    numeric_values = []\n    for item in data_list:\n        if isinstance(item, (int, float)):\n            numeric_values.append(item)\n\n    if not numeric_values:\n        raise ValueError(\"No numeric values found in the list.\")\n\n    return min(numeric_values)"}
{"task_id": "Mbpp/412", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to list filtering functions.\n    It carries a descriptive message about the error encountered.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef remove_odd(data_list: list[int]) -> list[int]:\n    \"\"\"Removes odd numbers from a list, returning a new list with only even integers.\n    Raises InvalidInputError if the input is not a list or contains non-integer elements.\"\"\"\n    if not isinstance(data_list, list):\n        raise InvalidInputError(\"Input must be a list.\")\n\n    even_numbers = []\n    for item in data_list:\n        if not isinstance(item, int):\n            raise InvalidInputError(f\"List elements must be integers, found {type(item).__name__}.\")\n        if item % 2 == 0:\n            even_numbers.append(item)\n    return even_numbers"}
{"task_id": "Mbpp/412", "solution": "from typing import List, Union\ndef remove_odd(numbers: List[Union[int, float]]) -> List[Union[int, float]]:\n    \"\"\"\n    Filters a list, returning a new list containing only the even numbers.\n    Raises TypeError if input is not a list or contains non-numeric elements.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n\n    even_numbers = []\n    for num in numbers:\n        if not isinstance(num, (int, float)):\n            raise TypeError(f\"List elements must be numbers, got {type(num).__name__}.\")\n        # An even number is defined as any number perfectly divisible by 2.\n        if num % 2 == 0:\n            even_numbers.append(num)\n    return even_numbers"}
{"task_id": "Mbpp/409", "solution": "from typing import List, Tuple, Union\ndef min_product_tuple(data: List[Tuple[Union[int, float], Union[int, float]]]) -> Union[int, float, None]:\n    \"\"\"Calculates the minimum product from a list of two-number tuples.\n    Returns None if the input list is empty, otherwise the smallest product found.\n    \"\"\"\n    if not isinstance(data, list):\n        raise ValueError(\"Input 'data' must be a list.\")\n\n    if not data:\n        return None\n\n    min_product = float('inf')\n    for item in data:\n        if not isinstance(item, tuple) or len(item) != 2:\n            raise ValueError(\"Each element in the list must be a tuple of two numbers.\")\n\n        num1, num2 = item\n        if not isinstance(num1, (int, float)) or not isinstance(num2, (int, float)):\n            raise ValueError(\"Each element within a tuple must be a number (int or float).\")\n\n        product = num1 * num2\n        if product < min_product:\n            min_product = product\n    return min_product"}
