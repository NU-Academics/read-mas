{"task_id": "Mbpp/266", "solution": "def lateralsurface_cube(side_length: float) -> float:\n    \"\"\"Calculates the lateral surface area of a cube.\n    Raises ValueError if side_length is not a positive number.\n    \"\"\"\n    if not isinstance(side_length, (int, float)):\n        raise ValueError(\"Side length must be a numeric value.\")\n    if side_length <= 0:\n        raise ValueError(\"Side length must be a positive number.\")\n    return 4 * (side_length ** 2)"}
{"task_id": "Mbpp/266", "solution": "def lateralsurface_cube(side: float) -> float:\n    \"\"\"Calculates the lateral surface area of a cube given its side length.\n    Raises ValueError if the side length is negative.\"\"\"\n    if side < 0:\n        raise ValueError(\"Side length cannot be negative.\")\n    return 4 * side * side"}
{"task_id": "Mbpp/264", "solution": "def dog_age(human_age: int) -> float:\n    \"\"\"Calculates a dog's age in \"dog years\" based on its human age.\n    Raises ValueError for negative input or TypeError for non-integer input.\n    \"\"\"\n    if not isinstance(human_age, int):\n        raise TypeError(\"human_age must be an integer.\")\n    if human_age < 0:\n        raise ValueError(\"human_age cannot be negative.\")\n\n    if human_age == 0:\n        return 0.0\n    elif human_age == 1:\n        return 10.5\n    elif human_age == 2:\n        return 21.0\n    else:\n        return 21.0 + (human_age - 2) * 4.0"}
{"task_id": "Mbpp/265", "solution": "from typing import List, Any\ndef list_split(input_list: List[Any], n: int) -> List[List[Any]]:\n    \"\"\"\n    Splits a list into 'n' sublists, distributing elements column-wise.\n    The i-th element of the input_list goes into the (i % n)-th sublist.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer.\")\n\n    if not input_list:\n        return [[] for _ in range(n)]\n\n    # Initialize n empty sublists.\n    result: List[List[Any]] = [[] for _ in range(n)]\n\n    # Distribute elements according to the i % n pattern.\n    for i, item in enumerate(input_list):\n        result[i % n].append(item)\n\n    return result"}
{"task_id": "Mbpp/267", "solution": "def square_Sum(n: int) -> int:\n    \"\"\"Calculates the sum of the squares of the first n odd natural numbers.\n    Raises ValueError if n is not a positive integer.\"\"\"\n\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    total_sum = 0\n    for i in range(1, n + 1):\n        odd_number = 2 * i - 1\n        total_sum += odd_number ** 2\n    return total_sum"}
{"task_id": "Mbpp/262", "solution": "def split_two_parts(data_list: list, L: int) -> tuple[list, list]:\n    \"\"\"\n    Splits a given list into two sub-lists at a specified index L.\n    The first sub-list contains elements up to index L (exclusive), the second contains the rest.\n    \"\"\"\n    if not isinstance(data_list, list):\n        raise TypeError(\"Input 'data_list' must be a list.\")\n    if not isinstance(L, int):\n        raise TypeError(\"Input 'L' must be an integer.\")\n\n    if not data_list:\n        return ([], [])\n\n    if L <= 0:\n        return ([], data_list)\n\n    if L >= len(data_list):\n        return (data_list, [])\n\n    first_part = data_list[:L]\n    second_part = data_list[L:]\n    return (first_part, second_part)"}
{"task_id": "Mbpp/265", "solution": "def list_split(input_list: list, n: int) -> list:\n    \"\"\"\n    Splits a list into 'n' sublists, where each sublist contains elements\n    from the original list at 'n'-th intervals. Handles type and value errors for invalid inputs.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"input_list must be a list.\")\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer.\")\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer.\")\n\n    result_lists = [[] for _ in range(n)]\n    for i, item in enumerate(input_list):\n        result_lists[i % n].append(item)\n    return result_lists"}
