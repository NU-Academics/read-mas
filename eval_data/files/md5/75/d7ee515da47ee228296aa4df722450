{"task_id": "Mbpp/597", "solution": "def find_kth(arr1: list[int], arr2: list[int], k: int) -> int:\n    \"\"\"\n    Finds the k-th smallest element from two sorted arrays.\n    Raises ValueError or TypeError for invalid inputs.\n    \"\"\"\n    if not isinstance(arr1, list) or not isinstance(arr2, list):\n        raise TypeError(\"arr1 and arr2 must be lists.\")\n    if not all(isinstance(x, int) for x in arr1) or not all(isinstance(x, int) for x in arr2):\n        raise TypeError(\"Arrays must contain only integers.\")\n\n    len1, len2 = len(arr1), len(arr2)\n    if not (1 <= k <= len1 + len2):\n        raise ValueError(f\"k must be between 1 and {len1 + len2} (inclusive).\")\n\n    # Ensure arr1 is the shorter array for optimization.\n    if len1 > len2:\n        arr1, arr2 = arr2, arr1\n        len1, len2 = len2, len1\n\n    low, high = max(0, k - len2), min(k, len1)\n\n    while low <= high:\n        partition1 = (low + high) // 2\n        partition2 = k - partition1\n\n        max_left1 = arr1[partition1 - 1] if partition1 > 0 else float('-inf')\n        min_right1 = arr1[partition1] if partition1 < len1 else float('inf')\n\n        max_left2 = arr2[partition2 - 1] if partition2 > 0 else float('-inf')\n        min_right2 = arr2[partition2] if partition2 < len2 else float('inf')\n\n        if max_left1 <= min_right2 and max_left2 <= min_right1:\n            return max(max_left1, max_left2)\n        elif max_left1 > min_right2:\n            high = partition1 - 1\n        else:\n            low = partition1 + 1\n    \n    # This part should ideally not be reached if k is valid and arrays are sorted.\n    # It's a fallback for type hinting completeness.\n    raise RuntimeError(\"Algorithm failed to find k-th element.\")"}
{"task_id": "Mbpp/597", "solution": "def find_kth(arr1: list[int], arr2: list[int], k: int) -> int:\n    \"\"\"\n    Finds the k-th smallest element from two sorted arrays.\n    Raises ValueError if k is out of the valid range.\n    \"\"\"\n    m, n = len(arr1), len(arr2)\n\n    if not (1 <= k <= m + n):\n        raise ValueError(f\"k must be between 1 and {m + n}, but got {k}\")\n\n    # Ensure arr1 is the shorter array for optimized binary search.\n    if m > n:\n        return find_kth(arr2, arr1, k)\n\n    low = max(0, k - n)\n    high = min(k, m)\n\n    while low <= high:\n        partition_arr1 = (low + high) // 2\n        partition_arr2 = k - partition_arr1\n\n        max_left_arr1 = arr1[partition_arr1 - 1] if partition_arr1 > 0 else float('-inf')\n        min_right_arr1 = arr1[partition_arr1] if partition_arr1 < m else float('inf')\n\n        max_left_arr2 = arr2[partition_arr2 - 1] if partition_arr2 > 0 else float('-inf')\n        min_right_arr2 = arr2[partition_arr2] if partition_arr2 < n else float('inf')\n\n        if max_left_arr1 <= min_right_arr2 and max_left_arr2 <= min_right_arr1:\n            # Correct partition found, return the k-th element.\n            return max(max_left_arr1, max_left_arr2)\n        elif max_left_arr1 > min_right_arr2:\n            high = partition_arr1 - 1\n        else:\n            low = partition_arr1 + 1\n    \n    # This line should ideally not be reached given valid inputs and a correct algorithm.\n    raise RuntimeError(\"Algorithm error: Should have found k-th element.\")"}
{"task_id": "Mbpp/598", "solution": "def armstrong_number(number: int) -> bool:\n    \"\"\"Checks if an integer is an Armstrong number.\n    Returns True if it's an Armstrong number, False otherwise, and raises TypeError for non-integers.\"\"\"\n    if not isinstance(number, int):\n        raise TypeError(\"Input must be an integer.\")\n\n    if number < 0:\n        return False\n    if number == 0:\n        return True\n\n    num_str = str(number)\n    num_digits = len(num_str)\n    sum_of_powers = 0\n    for digit_char in num_str:\n        digit = int(digit_char)\n        sum_of_powers += digit ** num_digits\n\n    return sum_of_powers == number"}
{"task_id": "Mbpp/598", "solution": "def armstrong_number(number: int) -> bool:\n    \"\"\"Checks if a given integer is an Armstrong number.\n    Raises TypeError for non-integers, ValueError for negative integers.\n    \"\"\"\n    if not isinstance(number, int):\n        raise TypeError(\"Input must be an integer.\")\n    if number < 0:\n        raise ValueError(\"Input must be a positive integer.\")\n        \n    if number == 0:\n        return True\n\n    num_str = str(number)\n    num_digits = len(num_str)\n    sum_of_powers = 0\n    temp_num = number\n\n    while temp_num > 0:\n        digit = temp_num % 10\n        sum_of_powers += digit ** num_digits\n        temp_num //= 10\n\n    return sum_of_powers == number"}
{"task_id": "Mbpp/599", "solution": "def sum_average(n: int) -> tuple[int, float]:\n    \"\"\"Calculates the sum and average of the first 'n' natural numbers.\n    Raises ValueError if 'n' is not a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    total_sum = n * (n + 1) // 2\n    average = total_sum / n\n    return total_sum, average"}
