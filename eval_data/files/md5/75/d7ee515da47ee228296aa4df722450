{"task_id": "Mbpp/808", "solution": "def check_K(tup: tuple, k: int) -> bool:\n    \"\"\"\n    Checks if an integer k is present within the given tuple.\n    Raises TypeError for invalid input types.\n    \"\"\"\n    if not isinstance(tup, tuple):\n        raise TypeError(\"tup must be a tuple.\")\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an integer.\")\n\n    return k in tup"}
{"task_id": "Mbpp/808", "solution": "def check_K(input_tuple: tuple, k: int) -> bool:\n    \"\"\"\n    Checks if the integer k is present in the given tuple.\n    Raises TypeError if input_tuple is not a tuple or k is not an integer.\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"input_tuple must be a tuple.\")\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an integer.\")\n\n    return k in input_tuple"}
{"task_id": "Mbpp/809", "solution": "from typing import Tuple, Any\nclass TupleComparisonError(Exception):\n    \"\"\"Custom exception for tuple comparison errors.\n    Raised for conditions like length mismatch.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef check_smaller(tuple1: Tuple[Any, ...], tuple2: Tuple[Any, ...]) -> bool:\n    \"\"\"Checks if each element of tuple2 is strictly smaller than its corresponding element in tuple1.\n    Raises TypeError or TupleComparisonError for invalid inputs.\"\"\"\n    if not isinstance(tuple1, tuple) or not isinstance(tuple2, tuple):\n        raise TypeError(\"Both inputs must be tuples.\")\n\n    if len(tuple1) != len(tuple2):\n        raise TupleComparisonError(\"Tuples must have the same length for element-wise comparison.\")\n\n    for i in range(len(tuple1)):\n        if not (tuple2[i] < tuple1[i]):\n            return False\n    return True"}
{"task_id": "Mbpp/809", "solution": "def check_smaller(tuple1: tuple, tuple2: tuple) -> bool:\n    \"\"\"\n    Checks if every element of the second tuple is strictly smaller than its corresponding element in the first tuple.\n    Raises TypeError if inputs are not tuples, or ValueError if tuples have different lengths.\n    \"\"\"\n    if not isinstance(tuple1, tuple) or not isinstance(tuple2, tuple):\n        raise TypeError(\"Both inputs must be tuples.\")\n\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Tuples must have the same length for comparison.\")\n\n    for i in range(len(tuple1)):\n        if not (tuple2[i] < tuple1[i]):\n            return False\n    return True"}
