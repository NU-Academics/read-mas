{"task_id": "Mbpp/224", "solution": "def count_Set_Bits(number: int) -> int:\n    \"\"\"\n    Counts the number of set bits (1s) in the binary representation of a given integer.\n    Uses Brian Kernighan's algorithm.\n    \"\"\"\n    count = 0\n    # Python's bitwise operations on negative numbers correctly use two's complement.\n    while number != 0:\n        number &= (number - 1)  # Clear the least significant set bit\n        count += 1\n    return count"}
{"task_id": "Mbpp/224", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to bit counting functions.\n    It indicates that a provided input parameter is not valid.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef count_Set_Bits(number: int) -> int:\n    \"\"\"Counts set bits (1s) in the binary representation of a given integer.\n    Raises InvalidInputError if the input is not a non-negative integer.\n    \"\"\"\n    if not isinstance(number, int) or number < 0:\n        raise InvalidInputError(\"Input must be a non-negative integer.\")\n    return bin(number).count('1')"}
{"task_id": "Mbpp/223", "solution": "def _find_first_occurrence(arr: list[int], n: int, x: int) -> int:\n    \"\"\"Finds the index of the first occurrence of x in arr using binary search.\"\"\"\n    low, high = 0, n - 1\n    result = -1\n    while low <= high:\n        mid = (low + high) // 2\n        if arr[mid] == x:\n            result = mid\n            high = mid - 1\n        elif arr[mid] < x:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return result\ndef _find_last_occurrence(arr: list[int], n: int, x: int) -> int:\n    \"\"\"Finds the index of the last occurrence of x in arr using binary search.\"\"\"\n    low, high = 0, n - 1\n    result = -1\n    while low <= high:\n        mid = (low + high) // 2\n        if arr[mid] == x:\n            result = mid\n            low = mid + 1\n        elif arr[mid] < x:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return result\ndef is_majority(arr: list[int], n: int, x: int) -> bool:\n    \"\"\"\n    Checks if an element x is the majority element in a given sorted array.\n\n    Args:\n        arr: The sorted array of integers.\n        n: The length of the array.\n        x: The element to check.\n\n    Returns:\n        True if x is the majority element, False otherwise.\n    \"\"\"\n    if n == 0:\n        return False\n\n    first_idx = _find_first_occurrence(arr, n, x)\n\n    if first_idx == -1:\n        return False\n\n    last_idx = _find_last_occurrence(arr, n, x)\n\n    count = last_idx - first_idx + 1\n\n    return count > n / 2"}
