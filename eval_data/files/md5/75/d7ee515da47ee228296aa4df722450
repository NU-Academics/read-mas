{"task_id": "Mbpp/140", "solution": "def extract_singly(nested_collection: list[list[int | float] | tuple[int | float, ...]]) -> set[int | float]:\n    \"\"\"\n    Flattens a list of lists/tuples into a single set of unique numbers.\n    Each number is added to a set, ensuring uniqueness and handling mixed inner collection types.\n    \"\"\"\n    result_set = set()\n    for inner_collection in nested_collection:\n        for number in inner_collection:\n            result_set.add(number)\n    return result_set"}
{"task_id": "Mbpp/140", "solution": "from typing import List, Union, Set, Tuple\ndef extract_singly(list_of_lists: List[Union[int, float, List[Union[int, float]], Tuple[int, float]]]) -> Set[Union[int, float]]:\n    \"\"\"\n    Flattens a list of lists (or tuples) into a set of unique numbers, ignoring non-numeric values.\n    Raises TypeError if the top-level input is not a list.\n    \"\"\"\n    if not isinstance(list_of_lists, list):\n        raise TypeError(\"Input must be a list.\")\n\n    unique_numbers = set()\n    for item in list_of_lists:\n        if isinstance(item, (int, float)):\n            unique_numbers.add(item)\n        elif isinstance(item, (list, tuple)):\n            for sub_item in item:\n                if isinstance(sub_item, (int, float)):\n                    unique_numbers.add(sub_item)\n    return unique_numbers"}
{"task_id": "Mbpp/142", "solution": "def count_samepair(list1: list, list2: list, list3: list) -> int:\n    \"\"\"Counts the number of positions where elements in three lists are identical.\n    It iterates up to the length of the shortest list, comparing elements at corresponding indices.\"\"\"\n    count = 0\n    min_length = min(len(list1), len(list2), len(list3))\n\n    for i in range(min_length):\n        if list1[i] == list2[i] == list3[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/141", "solution": "def _find_max_index(arr: list[int], n: int) -> int:\n    \"\"\"Finds the index of the maximum element within the first n elements of the list.\n    Returns the index of the largest element found.\"\"\"\n    max_idx = 0\n    for i in range(1, n):\n        if arr[i] > arr[max_idx]:\n            max_idx = i\n    return max_idx\ndef pancake_sort(data: list[int]) -> list[int]:\n    \"\"\"Sorts a list of integers in ascending order using the pancake sort algorithm.\n    Returns a new list containing the sorted integers.\"\"\"\n    if not isinstance(data, list):\n        raise TypeError(\"Input must be a list.\")\n\n    for item in data:\n        if not isinstance(item, int):\n            raise ValueError(\"All elements in the list must be integers.\")\n\n    arr = list(data)  # Work on a copy to avoid modifying the original list\n    n = len(arr)\n\n    for curr_size in range(n, 1, -1):\n        max_idx = _find_max_index(arr, curr_size)\n\n        if max_idx != curr_size - 1:\n            _flip(arr, max_idx)\n            _flip(arr, curr_size - 1)\n    return arr"}
