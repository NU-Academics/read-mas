{"task_id": "Mbpp/607", "solution": "import re\nfrom typing import Optional, Tuple\ndef find_literals(text: str, pattern: str) -> Optional[Tuple[str, int, int]]:\n    \"\"\"\n    Searches the text for the first occurrence of the pattern (regular expression).\n    Returns the matched substring, its start index, and its end index (exclusive), or None if no match is found.\n    \"\"\"\n    if not isinstance(text, str) or not isinstance(pattern, str):\n        raise TypeError(\"Both 'text' and 'pattern' must be strings.\")\n    try:\n        match = re.search(pattern, text)\n        if match:\n            return match.group(0), match.start(0), match.end(0)\n        return None\n    except re.error as e:\n        raise ValueError(f\"Invalid regex pattern: {pattern}. Error: {e}\") from e"}
{"task_id": "Mbpp/603", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef get_ludic(n: int) -> list[int]:\n    \"\"\"\n    Calculates all 'lucid numbers' less than or equal to a given integer n using a sieve process.\n    The process identifies and removes every p-th element from candidates based on its current index.\n    \"\"\"\n    # Input 'n' must be a positive integer (>= 1).\n    if not isinstance(n, int) or n < 1:\n        raise InvalidInputError(f\"Input 'n' must be a positive integer (>= 1). Got: {n}\")\n\n    if n == 1:\n        return [1]\n\n    candidates = list(range(1, n + 1))\n    ludic_numbers = []\n    sieve_factor_index = 0\n\n    while sieve_factor_index < len(candidates):\n        current_ludic = candidates[sieve_factor_index]\n        ludic_numbers.append(current_ludic)\n\n        if current_ludic == 1:\n            # The number 1 does not trigger any removals in the sieve.\n            sieve_factor_index += 1\n            continue\n\n        to_remove_indices = []\n        # Collect indices of elements to remove based on current_ludic.\n        k = 1\n        while True:\n            idx_to_remove = sieve_factor_index + k * current_ludic\n            if idx_to_remove >= len(candidates):\n                break\n            to_remove_indices.append(idx_to_remove)\n            k += 1\n\n        # Remove elements in reverse order to maintain correct indices during iteration.\n        for idx in sorted(to_remove_indices, reverse=True):\n            del candidates[idx]\n\n        sieve_factor_index += 1\n\n    return ludic_numbers"}
{"task_id": "Mbpp/608", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input to Bell number calculations.\n    It inherits from ValueError.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef bell_Number(n: int) -> int:\n    \"\"\"Calculates the nth Bell number using dynamic programming.\n    Raises InvalidInputError if n is not a non-negative integer.\"\"\"\n\n    if not isinstance(n, int) or n < 0:\n        raise InvalidInputError(\"Input 'n' must be a non-negative integer.\")\n\n    if n == 0:\n        return 1\n\n    # Initialize a 2D list `bell` for dynamic programming, where bell[i][j] follows Aitken's array construction.\n    bell = [[0 for _ in range(n + 1)] for _ in range(n + 1)]\n\n    bell[0][0] = 1 # Base case: B_0 = 1.\n\n    # Fill the Bell triangle using the recurrence relation.\n    for i in range(1, n + 1):\n        bell[i][0] = bell[i-1][i-1] # The first element of a row is the last element of the previous row.\n        for j in range(1, i + 1):\n            bell[i][j] = bell[i-1][j-1] + bell[i][j-1] # Subsequent elements are sums of two preceding elements.\n    \n    return bell[n][0] # The nth Bell number is found at bell[n][0] in this construction."}
{"task_id": "Mbpp/608", "solution": "def bell_Number(n: int) -> int:\n    \"\"\"Calculates the nth Bell number using dynamic programming based on the Bell triangle.\n    Raises ValueError for non-integer or negative input 'n'.\"\"\"\n\n    # Preconditions: n must be a non-negative integer.\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    if n == 0:\n        return 1\n\n    # Initialize a 2D array to store Bell triangle values (Stirling numbers of the second kind).\n    bell = [[0 for _ in range(n + 1)] for _ in range(n + 1)]\n\n    # Base case: B(0) = 1.\n    bell[0][0] = 1\n\n    # Fill the Bell triangle using the recurrence relation.\n    for i in range(1, n + 1):\n        bell[i][0] = bell[i-1][i-1]  # First element of current row is last of previous.\n        for j in range(1, i + 1):\n            bell[i][j] = bell[i-1][j-1] + bell[i][j-1] # Recurrence: S(n,k) = S(n-1,k-1) + k*S(n-1,k) (this is the alternative definition of Bell numbers using Stirling numbers, the current DP is for S(n,k) in bell[i][j] and B_n = sum(S(n,k) for k=0 to n) which is bell[n][0] in this specific DP table layout)\n\n    return bell[n][0] # The nth Bell number is found at bell[n][0]."}
