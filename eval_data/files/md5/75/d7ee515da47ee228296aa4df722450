{"task_id": "Mbpp/593", "solution": "def _is_valid_octet(octet_str: str) -> bool:\n    \"\"\"Checks if a string represents a valid IPv4 octet (0-255).\"\"\"\n    try:\n        octet_int = int(octet_str)\n        return 0 <= octet_int <= 255\n    except ValueError:\n        return False\ndef _is_valid_ip_format(ip_address: str) -> bool:\n    \"\"\"Checks if the overall IP address string has a valid IPv4 structure. It validates each octet.\"\"\"\n    octets = ip_address.split('.')\n    if len(octets) != 4:\n        return False\n    for octet in octets:\n        if not _is_valid_octet(octet):\n            return False\n    return True\ndef removezero_ip(ip_address: str) -> str:\n    \"\"\"\n    Removes leading zeros from each octet of an IPv4 address string.\n\n    Args:\n        ip_address: The IPv4 address string (e.g., \"216.08.094.196\").\n\n    Returns:\n        The IP address string with leading zeros removed (e.g., \"216.8.94.196\").\n\n    Raises:\n        ValueError: If the input is not a valid IPv4 address format.\n    \"\"\"\n    if not isinstance(ip_address, str) or not ip_address:\n        raise ValueError(\"IP address must be a non-empty string.\")\n    \n    if not _is_valid_ip_format(ip_address):\n        raise ValueError(f\"Invalid IPv4 address format: '{ip_address}'\")\n\n    octets = ip_address.split('.')\n    normalized_octets = [str(int(octet)) for octet in octets]\n    return \".\".join(normalized_octets)"}
{"task_id": "Mbpp/594", "solution": "class NoEvenNumberFoundError(Exception):\n    \"\"\"Custom exception raised when no even number is found in a list.\"\"\"\n    def __init__(self, message: str = \"No even number found in the list.\"):\n        super().__init__(message)\nclass NoOddNumberFoundError(Exception):\n    \"\"\"Custom exception raised when no odd number is found in a list.\"\"\"\n    def __init__(self, message: str = \"No odd number found in the list.\"):\n        super().__init__(message)\ndef _find_first_even(numbers: list[int | float]) -> int | float:\n    \"\"\"Finds the first even number in a list. Raises NoEvenNumberFoundError if none found.\"\"\"\n    for num in numbers:\n        if num % 2 == 0:\n            return num\n    raise NoEvenNumberFoundError()\ndef _find_first_odd(numbers: list[int | float]) -> int | float:\n    \"\"\"Finds the first odd number in a list. Raises NoOddNumberFoundError if none found.\"\"\"\n    for num in numbers:\n        if num % 2 != 0:\n            return num\n    raise NoOddNumberFoundError()\ndef diff_even_odd(numbers: list) -> int | float:\n    \"\"\"Calculates the absolute difference between the first even and first odd number in the list.\n    Raises ValueError, NoEvenNumberFoundError, or NoOddNumberFoundError on failure.\"\"\"\n    if not numbers:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    first_even = _find_first_even(numbers)\n    first_odd = _find_first_odd(numbers)\n\n    return abs(first_even - first_odd)"}
