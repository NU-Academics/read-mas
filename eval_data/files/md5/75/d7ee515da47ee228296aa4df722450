{"task_id": "Mbpp/270", "solution": "from typing import List, Union\ndef sum_even_and_even_index(numbers_list: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"Calculates the sum of even numbers at even positions in a list.\n    Handles type validation for the input list and its numeric elements.\n    \"\"\"\n    if not isinstance(numbers_list, list):\n        raise TypeError(\"Input 'numbers_list' must be a list.\")\n\n    total_sum: Union[int, float] = 0\n\n    for index, value in enumerate(numbers_list):\n        if not isinstance(value, (int, float)):\n            raise TypeError(f\"List element at index {index} is not a number: {value}\")\n        \n        # Check if the current index is even and the value itself is even.\n        # This correctly applies the modulo operation to both integers and relevant floats.\n        if index % 2 == 0 and value % 2 == 0:\n            total_sum += value\n    \n    return total_sum"}
