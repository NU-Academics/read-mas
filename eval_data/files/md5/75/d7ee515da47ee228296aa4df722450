{"task_id": "Mbpp/450", "solution": "def extract_string(input_list: list[str], target_length: int) -> list[str]:\n    \"\"\"\n    Extracts strings of a specified length from a list of strings.\n    Raises TypeError or ValueError for invalid inputs.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n    for item in input_list:\n        if not isinstance(item, str):\n            raise TypeError(\"All elements in the list must be strings.\")\n    if not isinstance(target_length, int):\n        raise ValueError(\"Target length must be an integer.\")\n    if target_length <= 0:\n        raise ValueError(\"Target length must be a positive integer.\")\n\n    result_list: list[str] = [s for s in input_list if len(s) == target_length]\n    return result_list"}
{"task_id": "Mbpp/450", "solution": "def extract_string(string_list, desired_length):\n    \"\"\"Filters a list, returning only strings that exactly match the desired length.\n    Non-string elements are ignored, and `desired_length` must be a positive integer.\n    \"\"\"\n    if not isinstance(desired_length, int) or desired_length <= 0:\n        raise ValueError(\"desired_length must be a positive integer.\")\n\n    result = []\n    for item in string_list:\n        if isinstance(item, str) and len(item) == desired_length:\n            result.append(item)\n    return result"}
