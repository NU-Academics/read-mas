{"task_id": "Mbpp/803", "solution": "import math\ndef is_perfect_square(number: int) -> bool:\n    \"\"\"Checks if a non-negative integer is a perfect square.\n    Raises ValueError for invalid input types or negative numbers.\"\"\"\n    if not isinstance(number, int):\n        raise ValueError(\"Input must be an integer.\")\n    if number < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n\n    if number == 0:\n        return True\n\n    # Calculate the integer square root and compare its square to the original number.\n    sqrt_num = int(math.sqrt(number))\n    return sqrt_num * sqrt_num == number"}
{"task_id": "Mbpp/803", "solution": "import math\ndef is_perfect_square(number: int) -> bool:\n    \"\"\"\n    Determines if the given integer is a perfect square.\n    This handles negative numbers by returning False and zero by returning True.\n    \"\"\"\n    if number < 0:\n        return False\n    if number == 0:\n        return True\n    \n    # Using integer square root for efficiency and precision.\n    root = math.isqrt(number)\n    return root * root == number"}
{"task_id": "Mbpp/804", "solution": "from typing import List, Union\ndef is_product_even(numbers: List[Union[int, float]]) -> bool:\n    \"\"\"\n    Determines if the product of numbers in a list is even.\n    The product is even if any factor is even; an empty list's product is odd.\n    \"\"\"\n    if not numbers:\n        return False\n\n    for num in numbers:\n        if not isinstance(num, (int, float)):\n            raise TypeError(f\"All elements in the list must be numeric, got {type(num).__name__}\")\n        \n        # Check if the number is even.\n        if isinstance(num, int) and num % 2 == 0:\n            return True\n        elif isinstance(num, float) and num == int(num) and int(num) % 2 == 0:\n            return True\n            \n    return False"}
{"task_id": "Mbpp/804", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to product checker functions.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef is_product_even(numbers: list[int]) -> bool:\n    \"\"\"\n    Checks if the product of numbers in a list is even.\n    An even number in the list makes the product even.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise InvalidInputError(\"Input must be a list.\")\n    if not numbers:\n        raise InvalidInputError(\"Input list cannot be empty.\")\n\n    for num in numbers:\n        if not isinstance(num, int):\n            raise InvalidInputError(f\"All elements must be integers. Found: {type(num).__name__}\")\n        if num % 2 == 0:\n            return True\n    return False"}
{"task_id": "Mbpp/805", "solution": "def max_sum_list(list_of_lists: list[list[int]]) -> list[int]:\n    \"\"\"Identifies and returns the sublist with the highest sum of elements.\n    If multiple lists have the same highest sum, the first one encountered is returned; an empty list is returned for empty input.\"\"\"\n    \n    if not list_of_lists:\n        return []\n\n    max_sum = float('-inf')\n    result_list = []\n\n    for inner_list in list_of_lists:\n        current_sum = sum(inner_list)\n        if current_sum > max_sum:\n            max_sum = current_sum\n            result_list = inner_list\n            \n    return result_list"}
