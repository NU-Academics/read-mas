{"task_id": "Mbpp/125", "solution": "def find_length(binary_string: str) -> int:\n    \"\"\"\n    Calculates the maximum difference between '0's and '1's in any substring.\n    It treats '0' as +1 and '1' as -1, applying Kadane's algorithm.\n    Assumes the input binary_string is a valid string containing only '0's and '1's.\n    \"\"\"\n    if not binary_string:\n        return 0\n\n    max_so_far = 0\n    current_max = 0\n\n    for char in binary_string:\n        value = 1 if char == '0' else -1\n        current_max += value\n\n        if current_max < 0:\n            current_max = 0\n        \n        max_so_far = max(max_so_far, current_max)\n    \n    return max_so_far"}
{"task_id": "Mbpp/126", "solution": "def sum(num1, num2):\n    \"\"\"Calculates the sum of common divisors for two positive integers.\n    This function adheres to the specified validation and performance requirements.\n    \"\"\"\n    # Input validation ensures num1 and num2 are positive integers (FR1, BR1, NFR3).\n    if not isinstance(num1, int):\n        raise ValueError(\"num1 must be an integer.\")\n    if num1 <= 0:\n        raise ValueError(\"num1 must be a positive integer.\")\n    if not isinstance(num2, int):\n        raise ValueError(\"num2 must be an integer.\")\n    if num2 <= 0:\n        raise ValueError(\"num2 must be a positive integer.\")\n\n    # Helper function to find all divisors of a single number, using sqrt optimization for efficiency (NFR1).\n    def _get_divisors_for_one_num(number: int) -> set[int]:\n        divs = set()\n        for i in range(1, int(number**0.5) + 1):\n            if number % i == 0:\n                divs.add(i)\n                divs.add(number // i)\n        return divs\n\n    # Find common divisors by intersecting the sets of divisors for both numbers (FR2).\n    divisors_num1 = _get_divisors_for_one_num(num1)\n    divisors_num2 = _get_divisors_for_one_num(num2)\n    common_divisors_set = divisors_num1.intersection(divisors_num2)\n\n    # Calculate the sum of identified common divisors (FR3, FR4).\n    total_sum_of_divisors = 0\n    for d in common_divisors_set:\n        total_sum_of_divisors += d\n    return total_sum_of_divisors"}
{"task_id": "Mbpp/125", "solution": "class InvalidBinaryStringError(Exception):\n    \"\"\"Custom exception for invalid binary string input.\n    It carries a descriptive message about the error.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef find_length(binary_string: str) -> int:\n    \"\"\"Calculates the maximum difference between '0's and '1's in any substring.\n    The difference is defined as (count of '0's - count of '1's).\"\"\"\n\n    # Validate input type and content.\n    if not isinstance(binary_string, str):\n        raise InvalidBinaryStringError(\"Input must be a string.\")\n    if not all(char in ('0', '1') for char in binary_string):\n        raise InvalidBinaryStringError(\"Binary string must contain only '0' or '1'.\")\n\n    # Return 0 for an empty string as per requirements.\n    if not binary_string:\n        return 0\n\n    # Transform '0' to 1 and '1' to -1 to apply a variant of Kadane's algorithm.\n    # This converts the problem into finding the maximum subarray sum.\n    transformed_array = [1 if char == '0' else -1 for char in binary_string]\n\n    # First pass of Kadane's algorithm: find max non-negative sum.\n    # This variant resets current_max to 0 if it becomes negative.\n    max_so_far = 0\n    current_max = 0\n\n    for num in transformed_array:\n        current_max += num\n        if current_max < 0:\n            current_max = 0\n        max_so_far = max(max_so_far, current_max)\n\n    # If the first pass resulted in 0 (meaning no positive sum found) and there are negative numbers,\n    # re-run Kadane's to correctly find the largest (least negative) sum.\n    if max_so_far == 0 and any(x < 0 for x in transformed_array):\n        max_global = transformed_array[0]\n        max_current = transformed_array[0]\n\n        for i in range(1, len(transformed_array)):\n            max_current = max(transformed_array[i], max_current + transformed_array[i])\n            max_global = max(max_global, max_current)\n        return max_global\n\n    return max_so_far"}
{"task_id": "Mbpp/128", "solution": "import re\ndef _clean_and_tokenize(text: str) -> list[str]:\n    \"\"\"Removes non-alphanumeric characters and tokenizes text into words.\"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input 'text' must be a string.\")\n    cleaned_text = re.sub(r'[^a-zA-Z0-9\\s]', '', text)\n    words = cleaned_text.split()\n    return [word for word in words if word]\ndef long_words(n: int, text: str) -> list[str]:\n    \"\"\"Identifies words longer than n characters in the given text.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if not isinstance(text, str):\n        raise TypeError(\"Input 'text' must be a string.\")\n\n    words = _clean_and_tokenize(text)\n    return [word for word in words if len(word) > n]"}
{"task_id": "Mbpp/130", "solution": "from collections import Counter\ndef max_occurrences(input_list: list) -> any:\n    \"\"\"\n    Finds the item with the maximum frequency in a given list.\n    Returns one of the most frequent items, or None if the list is empty.\n    \"\"\"\n    if not input_list:\n        return None\n\n    counts = Counter(input_list)\n    \n    # Use most_common(1) for efficiency as it directly returns the highest frequency item(s).\n    # It returns a list of (item, count) tuples. If empty, most_common returns an empty list.\n    most_common_items = counts.most_common(1)\n\n    if most_common_items:\n        # most_common_items will be like [('item', count)]\n        return most_common_items[0][0]\n    else:\n        # This case technically shouldn't be reached if input_list is not empty,\n        # but it handles an edge case where Counter might be empty (e.g., if it were called with an empty iterable).\n        return None"}
{"task_id": "Mbpp/130", "solution": "from collections import Counter\nfrom typing import Any, List, Optional\ndef max_occurrences(data_list: List[Any]) -> Optional[Any]:\n    \"\"\"\n    Finds the item with the maximum frequency in a list, returning the earliest-appearing one in case of ties.\n    Returns None if the list is empty, and raises TypeError if input is not a list.\n    \"\"\"\n    if not isinstance(data_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    if not data_list:\n        return None\n\n    counts = Counter(data_list)\n\n    max_count = 0\n    max_item = None\n    \n    # Iterate through the original list to handle ties by first appearance.\n    for item in data_list:\n        current_count = counts[item]\n        if current_count > max_count:\n            max_count = current_count\n            max_item = item\n\n    return max_item"}
{"task_id": "Mbpp/129", "solution": "def magic_square_test(matrix: list[list[int]]) -> bool:\n    \"\"\"\n    Determines if a given matrix is a magic square.\n    A magic square has equal sums for all rows, columns, and both main diagonals.\n\n    Args:\n        matrix: A list of lists representing the square matrix.\n\n    Returns:\n        True if the matrix is a magic square, False otherwise.\n    \"\"\"\n\n    def _is_square_matrix(mat: list[list[int]]) -> bool:\n        \"\"\"Checks if the input matrix is a valid square matrix.\"\"\"\n        if not mat or not isinstance(mat, list):\n            return False\n        size = len(mat)\n        if size == 0:\n            return False\n        for row in mat:\n            if not isinstance(row, list) or len(row) != size:\n                return False\n        return True\n\n    def _contains_only_integers(mat: list[list[int]]) -> bool:\n        \"\"\"Checks if all elements within the matrix are integers.\"\"\"\n        for row in mat:\n            for item in row:\n                if not isinstance(item, int):\n                    return False\n        return True\n\n    if not _is_square_matrix(matrix):\n        return False\n    if not _contains_only_integers(matrix):\n        return False\n\n    size = len(matrix)\n\n    # Calculate row sums\n    row_sums = [sum(row) for row in matrix]\n\n    # Calculate column sums\n    col_sums = [0] * size\n    for r in range(size):\n        for c in range(size):\n            col_sums[c] += matrix[r][c]\n\n    # Calculate main diagonal sum\n    main_diag_sum = sum(matrix[i][i] for i in range(size))\n\n    # Calculate anti-diagonal sum\n    anti_diag_sum = sum(matrix[i][size - 1 - i] for i in range(size))\n\n    # All sums must be equal to the first row sum\n    # If the matrix is valid (non-empty square matrix with integers), row_sums will have at least one element.\n    magic_sum = row_sums[0]\n\n    if not all(s == magic_sum for s in row_sums):\n        return False\n    if not all(s == magic_sum for s in col_sums):\n        return False\n    if main_diag_sum != magic_sum:\n        return False\n    if anti_diag_sum != magic_sum:\n        return False\n\n    return True"}
{"task_id": "Mbpp/129", "solution": "from typing import List, Union\nclass InvalidMatrixError(Exception):\n    \"\"\"Custom exception for invalid matrix inputs.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nMatrix = List[List[Union[int, float]]]\nclass MagicSquareValidator:\n    \"\"\"Encapsulates logic to determine if a matrix is a magic square.\"\"\"\n    def __init__(self, matrix: Matrix):\n        if not isinstance(matrix, list):\n            raise InvalidMatrixError(\"Input must be a list of lists.\")\n        if not matrix:\n            raise InvalidMatrixError(\"Matrix cannot be empty.\")\n\n        self._matrix = matrix\n        self._size = len(matrix)\n\n        if not self._is_square():\n            raise InvalidMatrixError(\"Matrix is not square or contains malformed rows.\")\n        if not self._check_numeric_elements():\n            raise InvalidMatrixError(\"Matrix contains non-numeric elements.\")\n\n    def _is_square(self) -> bool:\n        \"\"\"Checks if the matrix is square (N x N) with consistent row lengths.\"\"\"\n        if any(not isinstance(row, list) for row in self._matrix):\n            return False\n        if any(len(row) != self._size for row in self._matrix):\n            return False\n        return True\n\n    def _check_numeric_elements(self) -> bool:\n        \"\"\"Ensures all matrix elements are integers or floats.\"\"\"\n        for row in self._matrix:\n            for element in row:\n                if not isinstance(element, (int, float)):\n                    return False\n        return True\n\n    def _get_row_sums(self) -> List[Union[int, float]]:\n        \"\"\"Calculates the sum of each row.\"\"\"\n        return [sum(row) for row in self._matrix]\n\n    def _get_column_sums(self) -> List[Union[int, float]]:\n        \"\"\"Calculates the sum of each column.\"\"\"\n        sums = [0] * self._size\n        for i in range(self._size):\n            for j in range(self._size):\n                sums[j] += self._matrix[i][j]\n        return sums\n\n    def _get_main_diagonal_sum(self) -> Union[int, float]:\n        \"\"\"Calculates the sum of the main diagonal (top-left to bottom-right).\"\"\"\n        return sum(self._matrix[i][i] for i in range(self._size))\n\n    def _get_anti_diagonal_sum(self) -> Union[int, float]:\n        \"\"\"Calculates the sum of the anti-diagonal (top-right to bottom-left).\"\"\"\n        return sum(self._matrix[i][self._size - 1 - i] for i in range(self._size))\n\n    def _all_sums_equal(self, sums: List[Union[int, float]]) -> bool:\n        \"\"\"Helper to check if all sums in a list are identical.\"\"\"\n        if not sums:\n            return True # Trivial case, should not happen with valid matrices\n        first_sum = sums[0]\n        return all(s == first_sum for s in sums)\n\n    def is_magic_square(self) -> bool:\n        \"\"\"Determines if the matrix meets all magic square criteria.\"\"\"\n        row_sums = self._get_row_sums()\n        col_sums = self._get_column_sums()\n        main_diag_sum = self._get_main_diagonal_sum()\n        anti_diag_sum = self._get_anti_diagonal_sum()\n\n        all_sums_to_check = row_sums + col_sums + [main_diag_sum, anti_diag_sum]\n        return self._all_sums_equal(all_sums_to_check)\ndef magic_square_test(matrix: Matrix) -> bool:\n    \"\"\"\n    Checks if a given matrix is a magic square.\n    This function validates matrix structure and numeric content, then sums rows, columns, and diagonals.\n    \"\"\"\n    validator = MagicSquareValidator(matrix)\n    return validator.is_magic_square()"}
{"task_id": "Mbpp/132", "solution": "def tup_string(input_tuple: tuple) -> str:\n    \"\"\"Converts a tuple of characters or strings into a single concatenated string.\n    Raises TypeError for invalid input types or non-string tuple elements.\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n\n    for item in input_tuple:\n        if not isinstance(item, str):\n            raise TypeError(\"All tuple elements must be strings or characters.\")\n\n    return \"\".join(input_tuple)"}
{"task_id": "Mbpp/131", "solution": "def reverse_vowels(s: str) -> str:\n    \"\"\"\n    Reverses only the vowels in the input string, where 'y' is not a vowel and vowels are case-insensitive.\n    Non-vowel characters maintain their original positions.\n    \"\"\"\n    VOWELS = \"aeiouAEIOU\"\n    s_list = list(s)\n    left, right = 0, len(s_list) - 1\n\n    while left < right:\n        # Move left pointer until a vowel is found.\n        while left < right and s_list[left] not in VOWELS:\n            left += 1\n        # Move right pointer until a vowel is found.\n        while left < right and s_list[right] not in VOWELS:\n            right -= 1\n\n        # If both pointers found vowels and haven't crossed, swap them.\n        if left < right:\n            s_list[left], s_list[right] = s_list[right], s_list[left]\n            left += 1\n            right += 1\n            \n    return \"\".join(s_list)"}
{"task_id": "Mbpp/132", "solution": "def tup_string(data: tuple) -> str:\n    \"\"\"\n    Converts a tuple of elements into a single concatenated string.\n    Raises TypeError if input is not a tuple or elements cannot be converted.\n    \"\"\"\n    if not isinstance(data, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n    try:\n        return \"\".join(str(item) for item in data)\n    except TypeError as e:\n        # Re-raises TypeError if elements cannot be implicitly converted to string.\n        raise TypeError(f\"Elements in the tuple must be convertible to strings: {e}\")"}
{"task_id": "Mbpp/131", "solution": "_VOWELS_SET = {'a', 'e', 'i', 'o', 'u'}\ndef reverse_vowels(s: str) -> str:\n    \"\"\"\n    Reverses the positions of only the vowels in the input string.\n    'y' is not considered a vowel.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n\n    s_list = list(s)\n    vowel_indices = []\n    vowels_found = []\n\n    for i, char in enumerate(s_list):\n        if char.lower() in _VOWELS_SET:\n            vowel_indices.append(i)\n            vowels_found.append(char)\n\n    # Reverse the collected vowels to prepare for re-insertion.\n    vowels_found.reverse()\n\n    for i, original_index in enumerate(vowel_indices):\n        s_list[original_index] = vowels_found[i]\n\n    return \"\".join(s_list)"}
{"task_id": "Mbpp/133", "solution": "def sum_negativenum(numbers: list[int | float]) -> int | float:\n    \"\"\"\n    Calculates the sum of all negative numbers in a given list.\n    Returns 0 if the list is empty or contains no negative numbers.\n    \"\"\"\n    total_sum = 0\n    for num in numbers:\n        if num < 0:\n            total_sum += num\n    return total_sum"}
