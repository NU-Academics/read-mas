{"task_id": "Mbpp/272", "solution": "from typing import Any, List, Tuple\ndef rear_extract(data: List[Tuple[Any, ...]]) -> List[Any]:\n    \"\"\"Extracts the last element from each tuple in a list of tuples.\n    Raises TypeError for invalid input types or IndexError for empty tuples.\n    \"\"\"\n    if not isinstance(data, list):\n        raise TypeError(\"Input 'data' must be a list.\")\n\n    result = []\n    for item in data:\n        if not isinstance(item, tuple):\n            raise TypeError(f\"All elements in 'data' must be tuples, but found type {type(item).__name__}.\")\n        if not item:\n            raise IndexError(\"Cannot extract from an empty tuple.\")\n        result.append(item[-1])\n    return result"}
{"task_id": "Mbpp/273", "solution": "def subtract_elements(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"Subtracts elements of the second tuple from the first tuple at corresponding indices.\n    Raises TypeError or ValueError for invalid inputs according to spec.\"\"\"\n    if not isinstance(tuple1, tuple) or not isinstance(tuple2, tuple):\n        raise TypeError(\"Both inputs must be tuples.\")\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Input tuples must have the same length.\")\n\n    result = []\n    for i in range(len(tuple1)):\n        element1 = tuple1[i]\n        element2 = tuple2[i]\n        if not isinstance(element1, (int, float)) or not isinstance(element2, (int, float)):\n            raise TypeError(\"All tuple elements must be numeric (int or float).\")\n        result.append(element1 - element2)\n    return tuple(result)"}
{"task_id": "Mbpp/272", "solution": "from typing import Any, List, Tuple\nclass InvalidInputTypeError(TypeError):\n    \"\"\"Custom exception for invalid input types.\n    It inherits from TypeError for consistency with Python's type checking errors.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef rear_extract(data: List[Tuple[Any, ...]]) -> List[Any]:\n    \"\"\"\n    Extracts the last element from each tuple in a list.\n    Raises `InvalidInputTypeError` for invalid input or `IndexError` for empty tuples.\n    \"\"\"\n    if not isinstance(data, list):\n        raise InvalidInputTypeError(\"Input must be a list.\")\n\n    result = []\n    for item in data:\n        if not isinstance(item, tuple):\n            raise InvalidInputTypeError(f\"Expected tuple, got {type(item).__name__} in list.\")\n        if not item:\n            raise IndexError(\"Tuple in list is empty.\")\n        result.append(item[-1])\n    return result"}
{"task_id": "Mbpp/276", "solution": "import math\ndef volume_cylinder(radius, height):\n    \"\"\"Calculates the volume of a cylinder given its radius and height.\n    Raises ValueError if radius or height are non-positive or non-numeric.\n    \"\"\"\n    if not isinstance(radius, (int, float)) or radius <= 0:\n        raise ValueError(\"Radius must be a positive number.\")\n    if not isinstance(height, (int, float)) or height <= 0:\n        raise ValueError(\"Height must be a positive number.\")\n\n    volume = math.pi * (radius ** 2) * height\n    return volume"}
{"task_id": "Mbpp/274", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\nMIN_N_VALUE = 1\ndef even_binomial_Coeff_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of even-indexed binomial coefficients for a positive integer n.\n    This function leverages the mathematical identity: sum(C(n, k) for k even) = 2^(n-1).\n    \"\"\"\n    if not isinstance(n, int):\n        raise InvalidInputError(\"Input 'n' must be an integer.\")\n    if n < MIN_N_VALUE:\n        raise InvalidInputError(f\"Input 'n' must be a positive integer (>= {MIN_N_VALUE}).\")\n\n    return 2**(n - 1)"}
{"task_id": "Mbpp/273", "solution": "def substract_elements(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Subtracts elements of the second tuple from the first tuple at corresponding indices.\n    Raises TypeError or ValueError for invalid inputs.\n    \"\"\"\n    if not isinstance(tuple1, tuple) or not isinstance(tuple2, tuple):\n        raise TypeError(\"Both inputs must be tuples.\")\n\n    if len(tuple1) != len(tuple2):\n        raise ValueError(\"Tuples must have the same length.\")\n\n    result = []\n    for i in range(len(tuple1)):\n        try:\n            result.append(tuple1[i] - tuple2[i])\n        except TypeError:\n            raise TypeError(f\"Elements at index {i} are not subtractable: '{tuple1[i]}' (type {type(tuple1[i]).__name__}) and '{tuple2[i]}' (type {type(tuple2[i]).__name__})\")\n    \n    return tuple(result)"}
{"task_id": "Mbpp/274", "solution": "def even_binomial_Coeff_Sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of even-indexed binomial coefficients for a given positive integer n.\n    This sum is mathematically equivalent to 2^(n-1).\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n    return 2**(n - 1)"}
