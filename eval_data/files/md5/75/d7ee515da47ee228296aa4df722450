{"task_id": "Mbpp/255", "solution": "from typing import Any, List, Tuple\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef combinations_colors(items: List[Any], n: int) -> List[Tuple[Any, ...]]:\n    \"\"\"Generates all combinations with repetition of elements from 'items' of length 'n'.\n    Each combination is a tuple in the returned list.\"\"\"\n    if not isinstance(items, list):\n        raise InvalidInputError(\"Input 'items' must be a list.\")\n    if not isinstance(n, int) or n < 0:\n        raise InvalidInputError(\"Input 'n' must be a non-negative integer.\")\n\n    if n == 0:\n        return [()]\n    if not items and n > 0:\n        return []\n\n    result: List[Tuple[Any, ...]] = []\n\n    def _generate_recursive(\n        current_n: int,\n        current_combination: List[Any],\n        start_index: int,\n    ) -> None:\n        \"\"\"Recursive helper to build combinations with repetition, appending results to the outer 'result' list.\"\"\"\n        if current_n == 0:\n            result.append(tuple(current_combination))\n            return\n\n        for i in range(start_index, len(items)):\n            current_combination.append(items[i])\n            _generate_recursive(current_n - 1, current_combination, i)\n            current_combination.pop() # Backtrack\n\n    _generate_recursive(n, [], 0)\n    return result"}
{"task_id": "Mbpp/255", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    pass\ndef combinations_colors(colors: list, n: int) -> list[tuple]:\n    \"\"\"Generates all combinations with repetition of a specified length from a list of elements.\"\"\"\n    if n < 0:\n        raise InvalidInputError(\"Length cannot be negative.\")\n    if n == 0:\n        return [()]\n    if not colors and n > 0:\n        return []\n\n    result = []\n    num_elements = len(colors)\n\n    def _recursive_generate(current_combination: list, start_index: int):\n        if len(current_combination) == n:\n            result.append(tuple(current_combination))\n            return\n\n        for i in range(start_index, num_elements):\n            current_combination.append(colors[i])\n            _recursive_generate(current_combination, i)\n            current_combination.pop()\n\n    _recursive_generate([], 0)\n    return result"}
{"task_id": "Mbpp/256", "solution": "def count_Primes_nums(N: int) -> int:\n    \"\"\"\n    Counts prime numbers strictly less than N using the Sieve of Eratosthenes.\n    Returns 0 for N less than or equal to 2 or if N is negative.\n    \"\"\"\n    if N <= 2:\n        return 0\n\n    # Initialize a boolean array where is_prime[i] is True if i is potentially prime.\n    is_prime = [True] * N\n    is_prime[0] = False  # 0 is not prime.\n    is_prime[1] = False  # 1 is not prime.\n\n    # Apply the Sieve of Eratosthenes to mark composites.\n    for p in range(2, int(N**0.5) + 1):\n        if is_prime[p]:\n            for multiple in range(p*p, N, p):\n                is_prime[multiple] = False\n\n    # Count all numbers that remain marked as prime.\n    prime_count = 0\n    for i in range(2, N):\n        if is_prime[i]:\n            prime_count += 1\n\n    return prime_count"}
{"task_id": "Mbpp/256", "solution": "def _is_prime(num: int) -> bool:\n    \"\"\"Checks if a given integer is a prime number.\n    Raises ValueError for non-integer or negative inputs.\"\"\"\n    if not isinstance(num, int):\n        raise ValueError(\"Input must be an integer.\")\n    if num < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n    if num < 2:\n        return False\n    # Optimize trial division by checking divisors up to the square root.\n    for i in range(2, int(num**0.5) + 1):\n        if num % i == 0:\n            return False\n    return True\ndef count_Primes_nums(limit: int) -> int:\n    \"\"\"Counts prime numbers strictly less than the given limit.\n    Raises ValueError if limit is not a non-negative integer.\"\"\"\n    if not isinstance(limit, int) or limit < 0:\n        raise ValueError(\"Limit must be a non-negative integer.\")\n\n    count = 0\n    # Iterate from 2 up to, but not including, the limit.\n    for num in range(2, limit):\n        if _is_prime(num):\n            count += 1\n    return count"}
