{"task_id": "Mbpp/290", "solution": "def max_length(list_of_lists: list[list]) -> tuple[int, list]:\n    \"\"\"Identifies the sublist with the maximum length and returns its length and the sublist itself.\n    Handles input validation and empty lists as per specification.\n    \"\"\"\n    if not isinstance(list_of_lists, list):\n        raise TypeError(\"Input must be a list.\")\n\n    if not list_of_lists:\n        return (0, [])\n\n    max_len = 0\n    longest_list = []\n\n    for sublist in list_of_lists:\n        if not isinstance(sublist, list):\n            raise TypeError(\"All elements in the input list must be lists.\")\n        if len(sublist) > max_len:\n            max_len = len(sublist)\n            longest_list = sublist\n    \n    return (max_len, longest_list)"}
{"task_id": "Mbpp/290", "solution": "from typing import Any, List, Tuple\ndef max_length(list_of_lists: List[List[Any]]) -> Tuple[int, List[Any]]:\n    \"\"\"\n    Finds the list with the maximum length from a list of lists.\n    Returns the first encountered if multiple lists share the max length, or (0, []) for an empty input.\n    \"\"\"\n    if not list_of_lists:\n        return 0, []\n\n    max_length = 0\n    longest_list: List[Any] = []\n\n    for sublist in list_of_lists:\n        current_length = len(sublist)\n        if current_length > max_length:\n            max_length = current_length\n            longest_list = sublist\n    \n    return max_length, longest_list"}
{"task_id": "Mbpp/292", "solution": "class DivisionByZeroError(Exception):\n    \"\"\"Custom exception raised when an attempt to divide by zero occurs.\"\"\"\n    def __init__(self, message: str = \"Cannot divide by zero.\"):\n        super().__init__(message)\n        self.message = message\ndef find(numerator: int, denominator: int) -> int:\n    \"\"\"\n    Calculates the integer quotient of two numbers, rounded down.\n    Raises DivisionByZeroError if the denominator is zero.\n    \"\"\"\n    if denominator == 0:\n        raise DivisionByZeroError()\n    return numerator // denominator"}
{"task_id": "Mbpp/293", "solution": "import math\ndef otherside_rightangle(leg1: float, leg2: float) -> float:\n    \"\"\"Calculates the hypotenuse of a right-angled triangle given the lengths of its two legs.\n    Side lengths must be positive, otherwise a ValueError is raised.\"\"\"\n    if leg1 <= 0 or leg2 <= 0:\n        raise ValueError(\"Side lengths must be positive.\")\n    return math.sqrt(leg1**2 + leg2**2)"}
{"task_id": "Mbpp/286", "solution": "import math\ndef _kadane(arr: list[int]) -> int:\n    \"\"\"\n    Implements Kadane's algorithm to find the maximum contiguous subarray sum.\n    If the array is empty, it returns 0. If all numbers are negative, it returns the largest single element.\n    \"\"\"\n    if not arr:\n        return 0\n    \n    max_so_far = -math.inf\n    current_max = 0\n    \n    # Check if any non-negative number exists\n    has_positive_or_zero = False\n    for x in arr:\n        if x >= 0:\n            has_positive_or_zero = True\n            break\n    \n    # If all numbers are negative, the maximum sum is the largest (least negative) single element.\n    if not has_positive_or_zero:\n        return max(arr)\n\n    # Standard Kadane's algorithm to find the maximum sum.\n    # The `current_max = 0` reset ensures that if a subarray sum becomes negative,\n    # we start a new potential subarray from the next element, implicitly ensuring a non-negative result\n    # if positive elements are present and contribute to a sum.\n    for x in arr:\n        current_max += x\n        if current_max < 0:\n            current_max = 0\n        max_so_far = max(max_so_far, current_max)\n    \n    return max_so_far\ndef _max_prefix_sum(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the maximum prefix sum of the given array.\n    Returns 0 if the array is empty or if all prefix sums are negative (favoring an empty prefix).\n    \"\"\"\n    if not arr:\n        return 0\n    max_prefix = 0\n    current_sum = 0\n    for x in arr:\n        current_sum += x\n        max_prefix = max(max_prefix, current_sum)\n    return max_prefix\ndef _max_suffix_sum(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the maximum suffix sum of the given array.\n    Returns 0 if the array is empty or if all suffix sums are negative (favoring an empty suffix).\n    \"\"\"\n    if not arr:\n        return 0\n    max_suffix = 0\n    current_sum = 0\n    for x in reversed(arr):\n        current_sum += x\n        max_suffix = max(max_suffix, current_sum)\n    return max_suffix\ndef max_sub_array_sum_repeated(arr: list[int], n: int, k: int) -> int:\n    \"\"\"\n    Calculates the largest sum of a contiguous subarray in the modified array\n    formed by repeating `arr` `k` times.\n    \"\"\"\n    if k < 1:\n        raise ValueError(\"k must be a positive integer.\")\n    if not arr:\n        return 0\n    \n    # Case 1: k = 1. Apply Kadane's algorithm to the original array.\n    if k == 1:\n        return _kadane(arr)\n    \n    # Case 2: k > 1. Consider three types of maximum sums.\n    # The maximum sum within two repetitions (arr + arr) covers subarrays\n    # entirely within one block, or spanning across the boundary of two blocks.\n    max_sum_double = _kadane(arr + arr)\n    total_sum_arr = sum(arr)\n    \n    # If the total sum of `arr` is negative, including more full repetitions\n    # would only decrease the maximum sum. So, `max_sum_double` is sufficient.\n    if total_sum_arr < 0:\n        return max_sum_double\n    \n    # If the total sum of `arr` is non-negative, including more full repetitions\n    # can potentially increase the sum. The maximum sum could be:\n    # 1. `max_sum_double` (covering cases within two blocks).\n    # 2. `max_prefix` + `(k-2)` * `total_sum_arr` + `max_suffix`. This accounts\n    #    for taking the best prefix, all middle (k-2) full arrays, and the best suffix.\n    max_prefix = _max_prefix_sum(arr)\n    max_suffix = _max_suffix_sum(arr)\n    \n    # For k=2, `(k-2) * total_sum_arr` is 0, so it simplifies to `max_prefix + max_suffix`.\n    return max(max_sum_double, max_prefix + max_suffix + (k - 2) * total_sum_arr)"}
{"task_id": "Mbpp/293", "solution": "import math\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef otherside_rightangle(side1: float, side2: float) -> float:\n    \"\"\"Calculates the hypotenuse of a right-angled triangle.\n    Raises InvalidInputError if inputs are not positive numbers.\n    \"\"\"\n    if not isinstance(side1, (int, float)) or not isinstance(side2, (int, float)):\n        raise InvalidInputError(\"Side lengths must be numeric.\")\n    if side1 <= 0 or side2 <= 0:\n        raise InvalidInputError(\"Side lengths must be positive.\")\n\n    hypotenuse_squared = side1**2 + side2**2\n    return math.sqrt(hypotenuse_squared)"}
{"task_id": "Mbpp/294", "solution": "from typing import List, Union\ndef max_val(data_list: List[any]) -> Union[int, float, None]:\n    \"\"\"\n    Finds the maximum numeric value in a list, ignoring non-numeric elements.\n    Returns the maximum integer or float, or None if no numeric values are present.\n    \"\"\"\n    numeric_values = [item for item in data_list if isinstance(item, (int, float))]\n    if not numeric_values:\n        return None\n    return max(numeric_values)"}
{"task_id": "Mbpp/294", "solution": "from typing import List, Union\ndef max_val(data_list: List[any]) -> Union[int, float, None]:\n    \"\"\"\n    Finds the maximum numerical value in a heterogeneous list.\n    The maximum int or float found in the list is returned, or None if no numerical values are present.\n    \"\"\"\n    max_numeric = None\n    found_numeric = False\n\n    for item in data_list:\n        if isinstance(item, (int, float)):\n            if not found_numeric:\n                max_numeric = item\n                found_numeric = True\n            elif item > max_numeric:\n                max_numeric = item\n    return max_numeric"}
{"task_id": "Mbpp/286", "solution": "import math\ndef _kadane_find_max_sum(arr: list[int]) -> int:\n    \"\"\"Implements Kadane's algorithm to find the maximum sum of a contiguous subarray.\n    Handles empty arrays by raising a ValueError.\n    \"\"\"\n    if not arr:\n        raise ValueError(\"Input array cannot be empty\")\n\n    max_so_far = arr[0]\n    current_max = arr[0]\n\n    for i in range(1, len(arr)):\n        current_max = max(arr[i], current_max + arr[i])\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far\ndef _calculate_max_prefix_sum(arr: list[int]) -> int:\n    \"\"\"Calculates the maximum prefix sum of a given array.\n    Handles empty arrays by returning negative infinity.\n    \"\"\"\n    if not arr:\n        return -math.inf # Or raise error if strict, but for calculation, -inf is safer.\n                         # The main function will already check for empty arr.\n    current_sum = 0\n    max_p_sum = -math.inf\n    for x in arr:\n        current_sum += x\n        max_p_sum = max(max_p_sum, current_sum)\n    return max_p_sum\ndef _calculate_max_suffix_sum(arr: list[int]) -> int:\n    \"\"\"Calculates the maximum suffix sum of a given array.\n    Handles empty arrays by returning negative infinity.\n    \"\"\"\n    if not arr:\n        return -math.inf # Similar to prefix sum, -inf for empty.\n    current_sum = 0\n    max_s_sum = -math.inf\n    for x in reversed(arr):\n        current_sum += x\n        max_s_sum = max(max_s_sum, current_sum)\n    return max_s_sum\ndef max_sub_array_sum_repeated(arr: list[int], n: int, k: int) -> int:\n    \"\"\"Calculates the largest sum of a contiguous subarray in an array formed by repeating `arr` `k` times.\n    It uses Kadane's algorithm and handles different `k` and array sum scenarios efficiently.\n    \"\"\"\n    if not arr:\n        raise ValueError(\"Input array cannot be empty\")\n    if k <= 0:\n        raise ValueError(\"Repetition factor k must be positive\")\n    if n != len(arr):\n        raise ValueError(\"n must be the length of arr\")\n\n    # Case 1: k = 1 (FR1)\n    if k == 1:\n        return _kadane_find_max_sum(arr)\n\n    # Calculate total sum of the original array\n    arr_sum = sum(arr)\n    \n    # Calculate max sum for the array repeated twice (arr + arr) (FR2, part of FR3)\n    # This covers cases where the max subarray spans across the boundary of two arrays.\n    max_sum_double_arr = _kadane_find_max_sum(arr + arr)\n\n    # Case 2: k > 1 and sum(arr) < 0 (FR2)\n    if arr_sum < 0:\n        # If the total sum is negative, repeating the array further will only decrease the sum.\n        # The maximum sum will be found within the first two repetitions.\n        return max_sum_double_arr\n    else:\n        # Case 3: k > 1 and sum(arr) >= 0 (FR3)\n        # If the total sum is non-negative, the maximum sum can include (k-2) full array sums.\n        max_prefix = _calculate_max_prefix_sum(arr)\n        max_suffix = _calculate_max_suffix_sum(arr)\n        \n        # Consider the sum formed by max suffix, (k-2) full arrays, and max prefix.\n        max_sum_with_full_arrays = max_prefix + (k - 2) * arr_sum + max_suffix\n        \n        # The overall maximum is either within two repetitions or includes full arrays.\n        return max(max_sum_double_arr, max_sum_with_full_arrays)"}
{"task_id": "Mbpp/296", "solution": "class InputValidationError(Exception):\n    \"\"\"Custom exception for invalid input to inversion counting functions.\n    It provides a descriptive message for the validation failure.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass ArrayValidator:\n    \"\"\"Provides utility methods for validating array inputs.\n    It checks for list type and numeric elements.\"\"\"\n    @staticmethod\n    def validate_numeric_array(arr: any) -> None:\n        \"\"\"Validates if the input is a list of numbers.\n        Raises InputValidationError if validation fails.\"\"\"\n        if not isinstance(arr, list):\n            raise InputValidationError(\"Input 'arr' must be a list.\")\n        for element in arr:\n            if not isinstance(element, (int, float)):\n                raise InputValidationError(\"All elements in 'arr' must be numeric (int or float).\")\ndef get_Inv_Count(arr: list[int | float]) -> int:\n    \"\"\"Calculates the total number of inversions in the input array.\n    An inversion is a pair (arr[i], arr[j]) such that i < j and arr[i] > arr[j].\"\"\"\n    ArrayValidator.validate_numeric_array(arr)\n\n    inversion_count = 0\n    n = len(arr)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if arr[i] > arr[j]:\n                inversion_count += 1\n    return inversion_count"}
{"task_id": "Mbpp/296", "solution": "def _merge_and_count(left: list, right: list) -> tuple[int, list]:\n    \"\"\"Merges two sorted sub-arrays, counting inversions where left[i] > right[j].\n    Returns the count of inversions and the combined sorted array.\"\"\"\n    i, j, inversions = 0, 0, 0\n    merged = []\n    \n    while i < len(left) and j < len(right):\n        if left[i] <= right[j]:\n            merged.append(left[i])\n            i += 1\n        else:\n            merged.append(right[j])\n            # If left[i] > right[j], then all remaining elements in left (from i to end)\n            # are also greater than right[j] because both left and right are sorted.\n            inversions += (len(left) - i) \n            j += 1\n    \n    merged.extend(left[i:])\n    merged.extend(right[j:])\n    \n    return inversions, merged\ndef _merge_sort_and_count(arr: list) -> tuple[int, list]:\n    \"\"\"Recursively sorts an array and counts inversions using a divide-and-conquer approach.\n    Returns the total inversion count and the sorted array.\"\"\"\n    n = len(arr)\n    if n < 2:\n        return 0, arr\n\n    mid = n // 2\n    left_arr = arr[:mid]\n    right_arr = arr[mid:]\n\n    left_count, sorted_left = _merge_sort_and_count(left_arr)\n    right_count, sorted_right = _merge_sort_and_count(right_arr)\n    \n    merge_count, merged_arr = _merge_and_count(sorted_left, sorted_right)\n    \n    return left_count + right_count + merge_count, merged_arr\ndef get_Inv_Count(arr: list) -> int:\n    \"\"\"Calculates the total number of inversions in a given array.\n    Raises TypeError if the input is not a list or elements are not comparable.\"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input must be a list.\")\n            \n    count, _ = _merge_sort_and_count(arr)\n    return count"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(nested_list: list) -> list:\n    \"\"\"\n    Flattens an arbitrarily nested list into a single-level list.\n    Raises TypeError if nested_list is not a list.\n    \"\"\"\n    if not isinstance(nested_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    flattened = []\n\n    def _flatten_recursive(current_list):\n        for item in current_list:\n            if isinstance(item, list):\n                _flatten_recursive(item)\n            else:\n                flattened.append(item)\n\n    _flatten_recursive(nested_list)\n    return flattened"}
{"task_id": "Mbpp/297", "solution": "from typing import List, Union\ndef flatten_list(nested_list: List[Union[int, List]]) -> List[int]:\n    \"\"\"\n    Flattens a nested list structure into a single-level list.\n    It processes elements recursively, preserving order and handling non-list inputs.\n    \"\"\"\n    if not isinstance(nested_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    result: List[int] = []\n    for item in nested_list:\n        if isinstance(item, list):\n            result.extend(flatten_list(item))\n        else:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/300", "solution": "import math\ndef count_binary_seq(n: int) -> float:\n    \"\"\"\n    Calculates the count of binary sequences of length 2n where the sum of the first n bits equals the sum of the last n bits.\n    This is equivalent to `(2n choose n)`.\n    Raises ValueError if n is a negative integer.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n    \n    return float(math.comb(2 * n, n))"}
{"task_id": "Mbpp/301", "solution": "from typing import Any\ndef dict_depth(data: Any) -> int:\n    \"\"\"Calculates the maximum nesting level of dictionary data structures.\n    Returns 0 if the input is not a dictionary, or 1 for an empty dictionary.\n    \"\"\"\n    if not isinstance(data, dict):\n        return 0\n\n    if not data: # Handles empty dictionary {}\n        return 1\n\n    max_depth = 1\n    for key, value in data.items():\n        if isinstance(value, dict):\n            current_depth = 1 + dict_depth(value)\n            max_depth = max(max_depth, current_depth)\n    return max_depth"}
{"task_id": "Mbpp/299", "solution": "from collections import defaultdict\nfrom typing import List, Tuple, Optional\ndef max_aggregate(data: List[Tuple[str, int]]) -> Optional[Tuple[str, int]]:\n    \"\"\"\n    Aggregates scores by name and identifies the name with the highest total score.\n    Returns None if the input list is empty.\n    \"\"\"\n    if not data:\n        return None\n\n    aggregated_scores = defaultdict(int)\n    for name, score in data:\n        aggregated_scores[name] += score\n\n    max_name = None\n    max_score = -float('inf')\n\n    for name, score in aggregated_scores.items():\n        if score > max_score:\n            max_score = score\n            max_name = name\n\n    return (max_name, max_score)"}
{"task_id": "Mbpp/300", "solution": "import math\ndef count_binary_seq(n: int) -> int:\n    \"\"\"\n    Calculates the total number of binary sequences of length 2n\n    where the sum of the first n bits equals the sum of the last n bits.\n    This is equivalent to calculating (2n)Cn.\n    \"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n    \n    return math.comb(2 * n, n)"}
{"task_id": "Mbpp/299", "solution": "from collections import defaultdict\nfrom typing import List, Tuple, Optional\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input data to the aggregator.\n    It inherits from ValueError for type-specific error handling.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef max_aggregate(data: List[Tuple[str, int]]) -> Tuple[Optional[str], int]:\n    \"\"\"\n    Calculates the maximum aggregate score from a list of (name, score) tuples.\n    Returns (None, 0) for an empty list, or raises InvalidInputError for bad input.\n    \"\"\"\n    if not isinstance(data, list):\n        raise InvalidInputError(\"Input must be a list.\")\n\n    if not data:\n        return (None, 0)\n\n    aggregated_scores = defaultdict(int)\n\n    for item in data:\n        if not isinstance(item, tuple) or len(item) != 2:\n            raise InvalidInputError(\n                f\"Each item in the list must be a tuple of (str, int), but got: {item}\"\n            )\n        name, score = item\n        if not isinstance(name, str) or not isinstance(score, int):\n            raise InvalidInputError(\n                f\"Each tuple must contain a string name and an integer score, but got: ({type(name).__name__}, {type(score).__name__})\"\n            )\n        aggregated_scores[name] += score\n\n    max_name: Optional[str] = None\n    max_score: int = 0\n\n    first_entry = True\n    for name, score in aggregated_scores.items():\n        if first_entry:\n            max_name = name\n            max_score = score\n            first_entry = False\n        elif score > max_score:\n            max_name = name\n            max_score = score\n            \n    return (max_name, max_score)"}
{"task_id": "Mbpp/305", "solution": "def start_withp(word_list: list[str]) -> tuple[str, ...]:\n    \"\"\"\n    Extracts the first two words starting with 'p' (case-insensitive) from a list of strings.\n    Each input string may contain multiple space-separated words.\n    \"\"\"\n    found_words = []\n    for item in word_list:\n        if not isinstance(item, str):\n            continue\n        \n        for word in item.split():\n            if word.lower().startswith('p'):\n                found_words.append(word)\n                if len(found_words) == 2:\n                    return tuple(found_words)\n\n    return tuple(found_words)"}
