{"task_id": "Mbpp/397", "solution": "from typing import Union\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input types in median calculation.\n    It provides a descriptive error message.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef median_numbers(num1: Union[int, float], num2: Union[int, float], num3: Union[int, float]) -> float:\n    \"\"\"Calculates the median of three given numbers.\n    Raises InvalidInputError if any input is not an int or float.\"\"\"\n    \n    # Validate inputs to ensure they are numbers.\n    if not all(isinstance(arg, (int, float)) for arg in [num1, num2, num3]):\n        raise InvalidInputError(\"All inputs must be numbers.\")\n\n    # Sort the numbers to find the middle value, ensuring float return type.\n    numbers = sorted([float(num1), float(num2), float(num3)])\n    return numbers[1]"}
{"task_id": "Mbpp/390", "solution": "from typing import List, Union\ndef add_string(numbers: List[Union[int, float]], format_string: str) -> List[str]:\n    \"\"\"\n    Applies a given format string to each number in the input list.\n    Returns a new list where each element is the result of applying the format string.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input 'numbers' must be a list.\")\n    if not isinstance(format_string, str):\n        raise TypeError(\"Input 'format_string' must be a string.\")\n\n    formatted_list = []\n    for number in numbers:\n        formatted_list.append(format_string.format(number))\n    return formatted_list"}
{"task_id": "Mbpp/390", "solution": "from typing import Any, List\nclass FormattingError(Exception):\n    \"\"\"Custom exception for errors during list element formatting.\n    It encapsulates the original exception and the problematic element.\"\"\"\n    def __init__(self, message: str, original_exception: Exception, element: object):\n        super().__init__(message)\n        self.original_exception = original_exception\n        self.element = element\n\n    def __str__(self):\n        return (f\"{super().__str__()} (Element: {self.element!r}, \"\n                f\"Original Error: {type(self.original_exception).__name__}: \"\n                f\"{self.original_exception})\")\ndef add_string(input_list: List[Any], format_string: str) -> List[str]:\n    \"\"\"Applies a format string to each element in a list and returns a new list of formatted strings.\n    It validates inputs and raises specific errors for unformattable elements.\"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input 'input_list' must be a list.\")\n    if not isinstance(format_string, str):\n        raise TypeError(\"Input 'format_string' must be a string.\")\n\n    formatted_list: List[str] = []\n    for element in input_list:\n        try:\n            formatted_list.append(format_string.format(element))\n        except (ValueError, TypeError) as e:\n            raise FormattingError(\n                f\"Failed to format element: {element!r}\",\n                original_exception=e,\n                element=element\n            ) from e\n    return formatted_list"}
