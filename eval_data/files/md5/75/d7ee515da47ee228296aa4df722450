{"task_id": "Mbpp/781", "solution": "import math\ndef _get_divisor_count(num: int) -> int:\n    \"\"\"Calculates the total number of positive divisors for a given integer.\n    Raises ValueError if input is not a positive integer.\"\"\"\n    if not isinstance(num, int) or num <= 0:\n        raise ValueError(\"Input 'num' must be a positive integer.\")\n\n    count = 0\n    # Iterate up to the square root to find divisors efficiently.\n    for i in range(1, int(math.sqrt(num)) + 1):\n        if num % i == 0:\n            if i * i == num:\n                count += 1  # Count square root once if it's a perfect square.\n            else:\n                count += 2  # Count i and num/i as two distinct divisors.\n    return count\ndef count_divisors(num: int) -> bool:\n    \"\"\"Checks if the number of positive divisors for a given integer is even.\n    Returns True if the count is even, False otherwise.\"\"\"\n    divisor_count = _get_divisor_count(num)\n    return divisor_count % 2 == 0"}
{"task_id": "Mbpp/780", "solution": "def find_combinations(tuple_list: list[tuple[int, int]]) -> list[tuple[int, int]]:\n    \"\"\"Calculates all possible unique pairwise sums of 2-element integer tuples from the input list.\n    It iterates through the list, summing each tuple with subsequent tuples to form unique pairs.\"\"\"\n    if not isinstance(tuple_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    for i, t in enumerate(tuple_list):\n        if not isinstance(t, tuple) or len(t) != 2:\n            raise ValueError(f\"Element at index {i} is not a 2-element tuple: {t}\")\n        if not all(isinstance(x, int) for x in t):\n            raise TypeError(f\"Elements within tuple at index {i} must be integers: {t}\")\n\n    results = []\n    n = len(tuple_list)\n    for i in range(n):\n        t1 = tuple_list[i]\n        for j in range(i + 1, n):\n            t2 = tuple_list[j]\n            results.append((t1[0] + t2[0], t1[1] + t2[1]))\n    return results"}
{"task_id": "Mbpp/781", "solution": "import math\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\n    Inherits from ValueError for common exception handling.\"\"\"\n    pass\ndef count_divisors(n: int) -> bool:\n    \"\"\"\n    Checks if the count of divisors for a given positive integer n is even.\n    A number has an odd number of divisors if and only if it is a perfect square.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise InvalidInputError(\"Input must be a positive integer.\")\n\n    # Determine if n is a perfect square.\n    # Perfect squares have an odd number of divisors; other positive integers have an even number.\n    sqrt_n = int(math.isqrt(n))\n    is_perfect_square = (sqrt_n * sqrt_n == n)\n\n    # The count of divisors is even if n is not a perfect square.\n    return not is_perfect_square"}
{"task_id": "Mbpp/782", "solution": "from typing import List\ndef odd_length_sum(arr: List[int]) -> int:\n    \"\"\"\n    Calculates the sum of all odd-length subarrays from the input array.\n    It efficiently computes each element's contribution to the total sum.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input must be a list.\")\n    if not all(isinstance(x, int) for x in arr):\n        raise TypeError(\"All elements in the list must be integers.\")\n\n    total_sum = 0\n    n = len(arr)\n\n    for i in range(n):\n        # Calculate how many times arr[i] contributes to an odd-length subarray.\n        # This uses the count of even/odd distance starting and ending points.\n        count_left = i + 1\n        count_right = n - i\n\n        # Number of start positions (s <= i) such that (i - s) is even/odd\n        count_left_even = (count_left + 1) // 2\n        count_left_odd = count_left // 2\n\n        # Number of end positions (e >= i) such that (e - i) is even/odd\n        count_right_even = (count_right + 1) // 2\n        count_right_odd = count_right // 2\n\n        # Total contributions for arr[i] from odd-length subarrays.\n        # (i-s) and (e-i) must both be even or both be odd for (e-s) to be even.\n        contributions = (count_left_even * count_right_even) + \\\n                        (count_left_odd * count_right_odd)\n        \n        total_sum += arr[i] * contributions\n        \n    return total_sum"}
{"task_id": "Mbpp/784", "solution": "def mul_even_odd(numbers: list[int]) -> int | None:\n    \"\"\"\n    Calculates the product of the first encountered even and odd numbers.\n    Returns None if either number is not found in the list.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in numbers:\n        if first_odd is None and num % 2 != 0:\n            first_odd = num\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        \n        if first_even is not None and first_odd is not None:\n            break\n\n    if first_even is not None and first_odd is not None:\n        return first_even * first_odd\n    return None"}
{"task_id": "Mbpp/782", "solution": "from typing import List\ndef odd_length_sum(arr: List[int]) -> int:\n    \"\"\"\n    Calculates the sum of all odd-length subarrays for a given array.\n    This function handles input validation and uses an O(N) approach.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input 'arr' must be a list.\")\n\n    total_sum = 0\n    n = len(arr)\n\n    for i in range(n):\n        if not isinstance(arr[i], int):\n            raise ValueError(f\"List element at index {i} is not an integer.\")\n        \n        # Calculate the number of odd-length subarrays containing arr[i].\n        # This count is ceil(((i + 1) * (n - i)) / 2).\n        count = ((i + 1) * (n - i) + 1) // 2 \n        total_sum += arr[i] * count\n\n    return total_sum"}
{"task_id": "Mbpp/785", "solution": "import ast\ndef tuple_str_int(tuple_string: str) -> tuple[int, ...]:\n    \"\"\"Converts a string representation of a tuple into a tuple of integers.\n    Raises TypeError if input is not string, or ValueError for invalid tuple format or non-integer elements.\"\"\"\n    if not isinstance(tuple_string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    try:\n        parsed_tuple = ast.literal_eval(tuple_string)\n    except (ValueError, SyntaxError) as e:\n        raise ValueError(f\"Invalid tuple format: {e}\") from e\n\n    if not isinstance(parsed_tuple, tuple):\n        raise ValueError(\"Input string does not represent a tuple.\")\n\n    integer_elements = []\n    for item in parsed_tuple:\n        try:\n            integer_elements.append(int(item))\n        except (ValueError, TypeError) as e:\n            raise ValueError(f\"Tuple contains non-integer element: '{item}'\") from e\n\n    return tuple(integer_elements)"}
{"task_id": "Mbpp/784", "solution": "class NoEvenNumberFoundError(ValueError):\n    \"\"\"Custom exception raised when no even number is found in a list.\n    It indicates a specific failure condition for number search.\n    \"\"\"\n    def __init__(self, message: str = \"No even number found in the list.\") -> None:\n        super().__init__(message)\nclass NoOddNumberFoundError(ValueError):\n    \"\"\"Custom exception raised when no odd number is found in a list.\n    It signals that an expected odd number was absent from the sequence.\n    \"\"\"\n    def __init__(self, message: str = \"No odd number found in the list.\") -> None:\n        super().__init__(message)\ndef _find_first_even(numbers: list[int]) -> int:\n    \"\"\"Finds the first even number in a list.\n    It iterates through the list and returns the first number divisible by 2.\n    \"\"\"\n    for num in numbers:\n        if num % 2 == 0:\n            return num\n    raise NoEvenNumberFoundError()\ndef _find_first_odd(numbers: list[int]) -> int:\n    \"\"\"Finds the first odd number in a list.\n    It iterates through the list and returns the first number not divisible by 2.\n    \"\"\"\n    for num in numbers:\n        if num % 2 != 0:\n            return num\n    raise NoOddNumberFoundError()\ndef mul_even_odd(numbers: list[int]) -> int:\n    \"\"\"\n    Finds the product of the first even and first odd number in a given list.\n    This utility function is suitable for intermediate data processing steps.\n    \"\"\"\n    _validate_input(numbers)\n    first_even = _find_first_even(numbers)\n    first_odd = _find_first_odd(numbers)\n    return first_even * first_odd"}
{"task_id": "Mbpp/785", "solution": "class InvalidTupleStringError(ValueError):\n    \"\"\"Custom exception for invalid tuple string formats.\n    It provides a descriptive message explaining the reason for the error.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef tuple_str_int(tuple_string: str) -> tuple[int, ...]:\n    \"\"\"Converts a string representation of an integer tuple to an actual integer tuple.\n    Raises InvalidTupleStringError for malformed inputs or non-integer elements.\n    \"\"\"\n    if not isinstance(tuple_string, str):\n        raise InvalidTupleStringError(\"Input must be a string.\")\n\n    stripped_string = tuple_string.strip()\n    if not stripped_string.startswith('(') or not stripped_string.endswith(')'):\n        raise InvalidTupleStringError(\"Tuple string must start and end with parentheses.\")\n\n    content = stripped_string[1:-1].strip()\n\n    if not content:\n        return ()\n\n    elements = []\n    for item_str in content.split(','):\n        cleaned_item_str = item_str.strip()\n        try:\n            elements.append(int(cleaned_item_str))\n        except ValueError:\n            raise InvalidTupleStringError(f\"Invalid element '{cleaned_item_str}'. All elements must be integers.\")\n    \n    return tuple(elements)"}
{"task_id": "Mbpp/786", "solution": "def right_insertion(sorted_list, value):\n    \"\"\"\n    Locates the rightmost insertion point for a specified value in a sorted list.\n    If the value is already present, the insertion point will be after the last\n    occurrence of that value.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n    while low < high:\n        mid = (low + high) // 2\n        if value < sorted_list[mid]:\n            high = mid\n        else:\n            low = mid + 1\n    return low"}
