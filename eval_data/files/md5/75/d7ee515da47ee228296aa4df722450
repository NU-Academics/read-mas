{"task_id": "Mbpp/796", "solution": "from typing import Dict, Union\ndef return_sum(data_dict: Dict[str, Union[int, float]]) -> Union[int, float]:\n    \"\"\"Calculates the sum of all numeric values in the input dictionary.\n    Raises TypeError if input is not a dictionary or contains non-numeric values.\n    \"\"\"\n    if not isinstance(data_dict, dict):\n        raise TypeError(\"Input must be a dictionary.\")\n\n    total_sum = 0\n    # Iterates through dictionary values and sums only numeric ones.\n    for key, value in data_dict.items():\n        if not isinstance(value, (int, float)):\n            raise TypeError(f\"Value for key '{key}' is not numeric. Got type {type(value).__name__}.\")\n        total_sum += value\n    return total_sum"}
{"task_id": "Mbpp/794", "solution": "import re\ndef text_starta_endb(text: str) -> bool:\n    \"\"\"\n    Checks if a string starts with 'a', contains anything, and ends with 'b'.\n    Raises TypeError if the input is not a string.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input 'text' must be a string.\")\n\n    # The pattern matches strings starting with 'a', followed by any characters (zero or more), ending with 'b'.\n    pattern = r\"^a.*b$\"\n    return re.match(pattern, text) is not None"}
{"task_id": "Mbpp/796", "solution": "def return_sum(data):\n    \"\"\"\n    Calculates the sum of all numeric (int or float) values in a dictionary.\n    Non-numeric values are ignored from the summation.\n    \"\"\"\n    if not isinstance(data, dict):\n        raise TypeError(\"Input must be a dictionary.\")\n\n    total = 0\n    for value in data.values():\n        if isinstance(value, (int, float)):\n            total += value\n    return total"}
{"task_id": "Mbpp/797", "solution": "def sum_in_range(l: int, r: int) -> int:\n    \"\"\"Calculates the sum of all odd natural numbers within the inclusive range [l, r].\n    Raises ValueError for invalid inputs based on natural number rules.\n    \"\"\"\n    if not isinstance(l, int) or not isinstance(r, int):\n        raise ValueError(\"Both l and r must be integers.\")\n    if l > r:\n        raise ValueError(\"Lower bound 'l' cannot be greater than upper bound 'r'.\")\n    if l < 1:\n        raise ValueError(\"Lower bound 'l' must be a natural number (>= 1).\")\n\n    total_sum = 0\n    for num in range(l, r + 1):\n        if num % 2 != 0:  # Check if the number is odd\n            total_sum += num\n    return total_sum"}
{"task_id": "Mbpp/797", "solution": "def sum_in_range(l: int, r: int) -> int:\n    \"\"\"\n    Calculates the sum of all odd natural numbers within the inclusive range [l, r].\n    Validates inputs for integer type, natural number range (>=1), and l <= r.\n    \"\"\"\n    if not isinstance(l, int) or not isinstance(r, int):\n        raise ValueError(\"Both l and r must be integers.\")\n    if l < 1 or r < 1:\n        raise ValueError(\"Both l and r must be natural numbers (>= 1).\")\n    if l > r:\n        raise ValueError(\"Lower bound (l) cannot be greater than upper bound (r).\")\n\n    def _sum_odd_up_to_n(n: int) -> int:\n        \"\"\"Helper to calculate the sum of odd numbers from 1 up to n.\"\"\"\n        if n <= 0:\n            return 0\n        num_odds = (n + 1) // 2\n        return num_odds * num_odds\n\n    return _sum_odd_up_to_n(r) - _sum_odd_up_to_n(l - 1)"}
{"task_id": "Mbpp/798", "solution": "from typing import List, Union\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to array summation functions.\n    It provides a descriptive error message for invalid input conditions.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef _sum(arr: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"Calculates the sum of all numeric elements in the input array.\n    Raises InvalidInputError for non-iterable or non-numeric inputs.\n    \"\"\"\n    if not isinstance(arr, (list, tuple)):\n        raise InvalidInputError(\"Input must be an iterable (list or tuple).\")\n\n    total_sum = 0\n    for item in arr:\n        if not isinstance(item, (int, float)):\n            raise InvalidInputError(f\"All elements in the array must be numeric. Found: {type(item).__name__}\")\n        total_sum += item\n    return total_sum"}
{"task_id": "Mbpp/798", "solution": "from typing import List, Union\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input. Raised when input is None or contains non-numeric elements.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef _sum(arr: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"Calculates the sum of numbers in a list. Handles None, non-numeric items, and empty lists.\"\"\"\n    if arr is None:\n        raise InvalidInputError(\"Input list cannot be None.\")\n\n    total_sum: Union[int, float] = 0\n    for num in arr:\n        if not isinstance(num, (int, float)):\n            raise InvalidInputError(f\"Input list contains non-numeric element: {num}\")\n        total_sum += num\n    return total_sum"}
{"task_id": "Mbpp/799", "solution": "BIT_WIDTH = 32\nMAX_32BIT_VALUE = 0xFFFFFFFF\ndef left_rotate(number: int, d: int) -> int:\n    \"\"\"\n    Performs a left bit rotation on a 32-bit unsigned integer.\n    Raises ValueError for invalid input `number` or negative `d`.\n    \"\"\"\n    if not (0 <= number <= MAX_32BIT_VALUE):\n        raise ValueError(f\"Number must be a 32-bit unsigned integer (0 to {MAX_32BIT_VALUE}).\")\n    if d < 0:\n        raise ValueError(\"Rotation amount 'd' cannot be negative.\")\n\n    d_effective = d % BIT_WIDTH\n    \n    # Combine left-shifted and wrapped-around bits using bitwise OR.\n    rotated_number = ((number << d_effective) | \n                      (number >> (BIT_WIDTH - d_effective)))\n    \n    # Mask the result to ensure it stays within 32 bits.\n    return rotated_number & MAX_32BIT_VALUE"}
