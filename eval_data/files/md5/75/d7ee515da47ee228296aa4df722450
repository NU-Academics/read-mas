{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(numbers: list[int], target: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a given number in a sorted list.\n    Returns the 0-based index of the first occurrence of the target, or -1 if not found.\n    \"\"\"\n    low = 0\n    high = len(numbers) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if numbers[mid] == target:\n            result = mid\n            high = mid - 1  # Try to find an earlier occurrence\n        elif numbers[mid] < target:\n            low = mid + 1\n        else:  # numbers[mid] > target\n            high = mid - 1\n    return result"}
{"task_id": "Mbpp/720", "solution": "from typing import Tuple, Dict, Any\ndef add_dict_to_tuple(input_tuple: Tuple[Any, ...], input_dict: Dict[Any, Any]) -> Tuple[Any, ...]:\n    \"\"\"\n    Appends a dictionary to the end of a tuple, returning a new tuple.\n    This function performs explicit type checking for its inputs.\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"input_tuple must be a tuple\")\n    if not isinstance(input_dict, dict):\n        raise TypeError(\"input_dict must be a dictionary\")\n    return input_tuple + (input_dict,)"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(arr: list[int], target: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a given number in a sorted array.\n    Returns the 0-based index or -1 if not found or the array is empty.\n    \"\"\"\n    if not arr:\n        return -1\n\n    low, high = 0, len(arr) - 1\n    first_occurrence_index = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2  # Prevents potential overflow for very large low/high values.\n        if arr[mid] == target:\n            first_occurrence_index = mid\n            high = mid - 1  # Continue searching in the left half for an earlier occurrence.\n        elif arr[mid] < target:\n            low = mid + 1\n        else:  # arr[mid] > target\n            high = mid - 1\n    return first_occurrence_index"}
{"task_id": "Mbpp/734", "solution": "from typing import List, Union\ndef sum_Of_Subarray_Prod(numbers: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"Calculates the sum of products of all contiguous sublists within the input list.\n    Raises TypeError or ValueError for invalid input types or non-numeric elements.\"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n\n    total_sum = 0\n    n = len(numbers)\n\n    for i in range(n):\n        current_product = 1\n        for j in range(i, n):\n            if not isinstance(numbers[j], (int, float)):\n                raise ValueError(\"List elements must be numbers.\")\n            current_product *= numbers[j]\n            total_sum += current_product\n    return total_sum"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(number: int) -> int:\n    \"\"\"Toggles bits of the number, excluding the most significant and least significant bits.\n    Raises ValueError for negative input or TypeError for non-integer input.\n    \"\"\"\n    if not isinstance(number, int):\n        raise TypeError(\"Input must be an integer.\")\n    if number < 0:\n        raise ValueError(\"Input number must be non-negative.\")\n\n    # Determine the number of bits required to represent the number.\n    if number == 0:\n        bit_length = 0\n    else:\n        bit_length = number.bit_length()\n\n    if bit_length < 3:\n        return number  # Numbers with fewer than 3 bits have no middle bits to toggle.\n\n    # Create a mask with all bits set from 0 to bit_length-1.\n    all_bits_mask = (1 << bit_length) - 1\n    # Create a mask for the most significant bit.\n    msb_mask = 1 << (bit_length - 1)\n    # Create a mask for the least significant bit.\n    lsb_mask = 1\n\n    # The middle bits mask is formed by clearing MSB and LSB from the all_bits_mask.\n    middle_bits_mask = all_bits_mask ^ msb_mask ^ lsb_mask\n\n    # Apply a bitwise XOR operation to toggle only the middle bits.\n    return number ^ middle_bits_mask"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(sorted_list: list[int], value: int) -> int:\n    \"\"\"\n    Locates the left insertion point for a specified value in a sorted list.\n    This function uses a binary search approach to find the first index i where sorted_list[i] >= value.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/736", "solution": "from typing import Any, List\ndef left_insertion(sorted_list: List[Any], value: Any) -> int:\n    \"\"\"\n    Locates the leftmost index in a sorted list where a value can be inserted to maintain sorted order.\n    This method implements a binary search algorithm for O(log n) performance.\n    \"\"\"\n    low = 0\n    high = len(sorted_list)\n\n    while low < high:\n        mid = (low + high) // 2\n        if sorted_list[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(n: int) -> int:\n    \"\"\"\n    Toggles all bits of the number except the most significant bit (MSB) and the least significant bit (LSB).\n    For numbers with 0, 1, or 2 bits, it returns the number unchanged.\n    \"\"\"\n    if n < 0:\n        # Assumes non-negative input as per design specification.\n        return n\n\n    bit_length = n.bit_length()\n\n    if bit_length <= 2:\n        # No middle bits for numbers with 0, 1, or 2 bits.\n        return n\n\n    full_mask = (1 << bit_length) - 1\n    msb_mask = 1 << (bit_length - 1)\n    lsb_mask = 1 << 0\n    middle_bits_mask = full_mask ^ msb_mask ^ lsb_mask\n\n    return n ^ middle_bits_mask"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(input_list: list[int]) -> int:\n    \"\"\"Calculates the sum of products of all possible sublists of a given list.\n    Raises TypeError if the input is not a list or contains non-integer elements.\"\"\"\n\n    # Validate input: ensure it's a list and all its elements are integers.\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n    for item in input_list:\n        if not isinstance(item, int):\n            raise TypeError(\"All elements in the list must be integers.\")\n\n    total_sum = 0\n    n = len(input_list)\n\n    # Iterate through all possible start and end indices to generate sublists.\n    for i in range(n):\n        for j in range(i, n):\n            # Extract the current sublist.\n            sublist = input_list[i : j + 1]\n\n            # Calculate the product of elements within the current sublist.\n            product_for_current_sublist = 1\n            for element in sublist:\n                # Re-validate elements for robustness during product calculation as per spec.\n                if not isinstance(element, int):\n                    raise TypeError(\"Sublist elements must be integers during product calculation.\")\n                product_for_current_sublist *= element\n            \n            # Add the sublist's product to the total sum.\n            total_sum += product_for_current_sublist\n            \n    return total_sum"}
{"task_id": "Mbpp/737", "solution": "import re\ndef check_str(input_string: str) -> bool:\n    \"\"\"\n    Checks if the given string starts with a vowel (a, e, i, o, u), case-insensitively.\n    Returns True if the string starts with a vowel, False otherwise.\n    \"\"\"\n    # Regex to match the start of the string (^) with any of the vowels (aeiou), case-insensitive.\n    return bool(re.match(r\"^[aeiou]\", input_string, re.IGNORECASE))"}
{"task_id": "Mbpp/737", "solution": "import re\nVOWEL_REGEX_PATTERN = r\"^[aeiouAEIOU]\"\ndef check_str(text: str) -> bool:\n    \"\"\"\n    Checks if the given string starts with an English vowel (a, e, i, o, u), case-insensitive.\n    Raises TypeError if the input is not a string.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input 'text' must be a string.\")\n    return bool(re.match(VOWEL_REGEX_PATTERN, text))"}
{"task_id": "Mbpp/740", "solution": "from typing import Any, Tuple, Dict\ndef tuple_to_dict(input_tuple: Tuple[Any, ...]) -> Dict[Any, Any]:\n    \"\"\"\n    Converts a tuple to a key-value dictionary using adjacent elements.\n    Raises ValueError if the input tuple has an odd number of elements.\n    \"\"\"\n    if len(input_tuple) % 2 != 0:\n        raise ValueError(\"Input tuple must have an even number of elements.\")\n\n    return {input_tuple[i]: input_tuple[i+1] for i in range(0, len(input_tuple), 2)}"}
{"task_id": "Mbpp/740", "solution": "from typing import Any, Dict, Tuple\ndef tuple_to_dict(data_tuple: Tuple[Any, ...]) -> Dict[Any, Any]:\n    \"\"\"\n    Converts an even-length tuple into a dictionary where adjacent elements form key-value pairs.\n    Raises ValueError if the input tuple has an odd number of elements.\n    \"\"\"\n    if len(data_tuple) % 2 != 0:\n        raise ValueError(\"Input tuple must have an even number of elements to form key-value pairs.\")\n\n    result_dict = {}\n    for i in range(0, len(data_tuple), 2):\n        key = data_tuple[i]\n        value = data_tuple[i + 1]\n        result_dict[key] = value\n    return result_dict"}
{"task_id": "Mbpp/739", "solution": "import math\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef find_Index(n: int) -> int:\n    \"\"\"\n    Calculates the index 'k' of the smallest triangular number T_k with exactly 'n' digits.\n    Raises `InvalidInputError` if `n` is not a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise InvalidInputError(\"Input 'n' must be a positive integer.\")\n\n    lower_bound = 10**(n - 1)\n    discriminant = 1 + 8 * lower_bound\n    k_float = (-1 + math.sqrt(discriminant)) / 2\n    k = math.ceil(k_float)\n\n    return int(k)"}
{"task_id": "Mbpp/739", "solution": "def find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index k of the smallest triangular number T_k that has exactly n digits.\n\n    Args:\n        n: The desired number of digits (a positive integer).\n\n    Returns:\n        The integer index k.\n\n    Raises:\n        ValueError: If n is not a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input for n must be a positive integer.\")\n\n    k = 0\n    triangular_number = 0\n    min_value = 10**(n - 1)\n    max_value = (10**n) - 1\n\n    while True:\n        k += 1\n        triangular_number = k * (k + 1) // 2\n\n        if triangular_number >= min_value:\n            if triangular_number <= max_value:\n                return k"}
{"task_id": "Mbpp/742", "solution": "import math\ndef area_tetrahedron(side_length: float) -> float:\n    \"\"\"\n    Calculates the total surface area of a regular tetrahedron given its side length.\n    Raises ValueError for non-numeric or negative side lengths.\n    \"\"\"\n    if not isinstance(side_length, (int, float)):\n        raise ValueError(\"Side length must be a numeric value.\")\n    if side_length < 0:\n        raise ValueError(\"Side length cannot be negative.\")\n\n    # Formula for the surface area of a regular tetrahedron.\n    return math.sqrt(3) * (side_length ** 2)"}
{"task_id": "Mbpp/741", "solution": "def all_Characters_Same(input_string: str) -> bool:\n    \"\"\"\n    Checks if all characters in the given string are identical.\n    Returns True for empty or single-character strings; raises TypeError for non-string input.\n    \"\"\"\n    if not isinstance(input_string, str):\n        raise TypeError(\"Input must be a string.\")\n    if len(input_string) <= 1:\n        return True\n    \n    first_char = input_string[0]\n    for char in input_string:\n        if char != first_char:\n            return False\n    return True"}
{"task_id": "Mbpp/742", "solution": "import math\ndef area_tetrahedron(side_length: float) -> float:\n    \"\"\"Calculates the total surface area of a regular tetrahedron.\n    Raises ValueError for non-positive side lengths, TypeError for non-numeric input.\n    \"\"\"\n    if not isinstance(side_length, (int, float)):\n        raise TypeError(\"Side length must be a number.\")\n    if side_length <= 0:\n        raise ValueError(\"Side length must be a positive number.\")\n\n    # Formula for the total surface area of a regular tetrahedron.\n    area = math.sqrt(3) * (side_length ** 2)\n    return area"}
{"task_id": "Mbpp/743", "solution": "from typing import List, Any\ndef rotate_right(input_list: List[Any], num_rotations: int) -> List[Any]:\n    \"\"\"Rotates a list to the right by a specified number of items.\n    Returns a new list with elements rotated, leaving the original unchanged.\"\"\"\n    if not input_list:\n        return []\n\n    list_length = len(input_list)\n    effective_rotations = num_rotations % list_length\n\n    if effective_rotations == 0:\n        return list(input_list)\n\n    return input_list[-effective_rotations:] + input_list[:-effective_rotations]"}
{"task_id": "Mbpp/741", "solution": "def all_Characters_Same(text: str) -> bool:\n    if not isinstance(text, str):\n        raise TypeError(\"Input must be a string.\")\n    if len(text) <= 1:\n        return True\n    first_char = text[0]\n    for char in text:\n        if char != first_char:\n            return False\n    return True"}
