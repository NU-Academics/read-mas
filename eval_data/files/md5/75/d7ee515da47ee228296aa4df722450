{"task_id": "Mbpp/643", "solution": "def text_match_wordz_middle(text: str) -> bool:\n    \"\"\"Checks if 'z' is in the string, excluding the first and last positions.\"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input 'text' must be a string.\")\n    \n    if len(text) < 3:\n        return False\n    \n    # Searches for 'z' within the string slice from the second to the second-to-last character.\n    return 'z' in text[1:-1]"}
{"task_id": "Mbpp/641", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input values.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef is_nonagonal(n: int) -> int:\n    \"\"\"\n    Calculates the nth nonagonal number.\n    Raises InvalidInputError if n is not a positive integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise InvalidInputError(\"Parameter 'n' must be an integer.\")\n    if n <= 0:\n        raise InvalidInputError(\"Parameter 'n' must be a positive integer.\")\n\n    # Formula for the nth nonagonal number: N_n = n * (7 * n - 5) / 2\n    nonagonal_number = n * (7 * n - 5) // 2\n    return nonagonal_number"}
{"task_id": "Mbpp/643", "solution": "def text_match_wordz_middle(text: str) -> bool:\n    \"\"\"\n    Checks if 'z' is present in the middle of the string, excluding first and last characters.\n    Raises TypeError if input is not a string.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input must be a string.\")\n\n    if len(text) < 3:\n        return False\n\n    target_char = 'z'\n    return target_char in text[1:-1]"}
{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(arr: list, k: int) -> list:\n    \"\"\"Reverses elements of a list `arr` from index 0 up to `k` (0-indexed) in place.\n    Handles type validation, negative `k`, and `k` exceeding array bounds.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input 'arr' must be a list.\")\n    if not isinstance(k, int):\n        raise TypeError(\"Input 'k' must be an integer.\")\n    if k < 0:\n        raise ValueError(\"Position 'k' cannot be negative.\")\n\n    # Adjusts k if it's out of bounds (>= array length), ensuring the entire array is reversed if k is too large.\n    # If `arr` is empty, `len(arr) - 1` is -1, preventing reversal loop.\n    effective_k = min(k, len(arr) - 1)\n\n    # Perform in-place reversal using two pointers.\n    left = 0\n    right = effective_k\n\n    while left < right:\n        arr[left], arr[right] = arr[right], arr[left]\n        left += 1\n        right -= 1\n    \n    return arr"}
{"task_id": "Mbpp/720", "solution": "def add_dict_to_tuple(input_tuple: tuple, input_dict: dict) -> tuple:\n    \"\"\"\n    Appends a dictionary as a single element to an existing tuple, returning a new tuple.\n    Raises TypeError if input_tuple is not a tuple or input_dict is not a dictionary.\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"input_tuple must be a tuple\")\n    if not isinstance(input_dict, dict):\n        raise TypeError(\"input_dict must be a dictionary\")\n\n    return input_tuple + (input_dict,)"}
{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(arr: list, k: int) -> None:\n    \"\"\"\n    Reverses the elements of a list from index 0 up to a given position (inclusive) in-place.\n    Raises TypeError if inputs are invalid, or IndexError if k is out of bounds.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input 'arr' must be a list.\")\n    if not isinstance(k, int):\n        raise TypeError(\"Input 'k' must be an integer.\")\n\n    if k < 0 or k >= len(arr):\n        raise IndexError(f\"Position {k} is out of bounds for array of length {len(arr)}.\")\n\n    start = 0\n    end = k\n\n    while start < end:\n        arr[start], arr[end] = arr[end], arr[start]\n        start += 1\n        end -= 1"}
{"task_id": "Mbpp/722", "solution": "def filter_data(students_data: dict[str, tuple[float, float]], minimal_height: float, minimal_weight: float) -> dict[str, tuple[float, float]]:\n    \"\"\"Filters student data based on minimum height and weight criteria.\n    Returns a dictionary of students who meet both the height and weight conditions.\n    \"\"\"\n    if not isinstance(students_data, dict):\n        raise ValueError(\"students_data must be a dictionary.\")\n    if not isinstance(minimal_height, (int, float)) or minimal_height < 0:\n        raise ValueError(\"minimal_height must be a non-negative number.\")\n    if not isinstance(minimal_weight, (int, float)) or minimal_weight < 0:\n        raise ValueError(\"minimal_weight must be a non-negative number.\")\n\n    filtered_results = {}\n    for name, data_tuple in students_data.items():\n        try:\n            if not isinstance(data_tuple, tuple) or len(data_tuple) != 2:\n                print(f\"Warning: Skipping invalid student entry for '{name}': Value is not a tuple of (height, weight).\")\n                continue\n\n            height, weight = data_tuple\n            if not isinstance(height, (int, float)) or height <= 0:\n                print(f\"Warning: Skipping invalid student entry for '{name}': Height '{height}' is not a positive number.\")\n                continue\n            if not isinstance(weight, (int, float)) or weight <= 0:\n                print(f\"Warning: Skipping invalid student entry for '{name}': Weight '{weight}' is not a positive number.\")\n                continue\n\n            # Convert to float for consistent type handling and comparison.\n            height = float(height)\n            weight = float(weight)\n\n            if height >= minimal_height and weight >= minimal_weight:\n                filtered_results[name] = (height, weight)\n        except Exception as e:\n            # Catches unexpected errors during processing of individual student data.\n            print(f\"Warning: An unexpected error occurred while processing student '{name}': {e}. Skipping entry.\")\n            continue\n            \n    return filtered_results"}
{"task_id": "Mbpp/721", "solution": "from typing import List\nclass InvalidMatrixError(Exception):\n    \"\"\"Custom exception for invalid matrix inputs.\"\"\"\n    pass\nclass Matrix:\n    \"\"\"Represents the square matrix of costs with validation and safe access.\"\"\"\n    def __init__(self, data: List[List[int]]) -> None:\n        self._validate_matrix(data)\n        self._data = data\n        self._size = len(data)\n\n    def _validate_matrix(self, data: List[List[int]]) -> None:\n        \"\"\"Ensures the input data is a valid square matrix of integers.\"\"\"\n        if not isinstance(data, list) or not data:\n            raise InvalidMatrixError(\"Matrix cannot be empty or not a list.\")\n        \n        size = len(data)\n        for row in data:\n            if not isinstance(row, list):\n                raise InvalidMatrixError(\"Matrix rows must be lists.\")\n            if len(row) != size:\n                raise InvalidMatrixError(\"Matrix must be square.\")\n            for cell in row:\n                if not isinstance(cell, int):\n                    raise InvalidMatrixError(\"Matrix cells must be integers.\")\n\n    def get_size(self) -> int:\n        \"\"\"Returns the dimension N of the matrix.\"\"\"\n        return self._size\n\n    def get_cell_cost(self, row: int, col: int) -> int:\n        \"\"\"Returns the cost of the cell at the specified row and column.\"\"\"\n        if not (0 <= row < self._size and 0 <= col < self._size):\n            raise IndexError(\"Cell coordinates out of bounds.\")\n        return self._data[row][col]\nclass PathFinderService:\n    \"\"\"Encapsulates business logic for finding the path with maximum average cost.\"\"\"\n    def find_max_average_path(self, matrix: Matrix) -> float:\n        \"\"\"Calculates the maximum average path cost for a given Matrix.\"\"\"\n        max_sum = self._calculate_max_sum_path(matrix)\n        size = matrix.get_size()\n        \n        # Any valid path from (0,0) to (N-1, N-1) has 2N - 1 cells.\n        num_cells = (2 * size) - 1\n        \n        if num_cells == 0:\n            return 0.0\n            \n        return float(max_sum) / num_cells\n\n    def _calculate_max_sum_path(self, matrix: Matrix) -> int:\n        \"\"\"Computes the maximum sum path using dynamic programming.\"\"\"\n        size = matrix.get_size()\n        if size == 0:\n            return 0\n\n        dp = [[0] * size for _ in range(size)]\n\n        # Initialize top-left cell\n        dp[0][0] = matrix.get_cell_cost(0, 0)\n\n        # Initialize first row and column sums\n        for j in range(1, size):\n            dp[0][j] = dp[0][j-1] + matrix.get_cell_cost(0, j)\n        for i in range(1, size):\n            dp[i][0] = dp[i-1][0] + matrix.get_cell_cost(i, 0)\n\n        # Fill the rest of the DP table\n        for i in range(1, size):\n            for j in range(1, size):\n                dp[i][j] = matrix.get_cell_cost(i, j) + max(dp[i-1][j], dp[i][j-1])\n\n        return dp[size-1][size-1]\nclass MatrixController:\n    \"\"\"Primary interface, handles input, creates Matrix, and invokes PathFinderService.\"\"\"\n    def __init__(self) -> None:\n        self._path_finder_service = PathFinderService()\n\n    def calculate_max_average(self, matrix_data: List[List[int]]) -> float:\n        \"\"\"Orchestrates finding the maximum average path from raw matrix data.\"\"\"\n        try:\n            matrix = Matrix(matrix_data)\n            max_average = self._path_finder_service.find_max_average_path(matrix)\n            return max_average\n        except InvalidMatrixError:\n            raise # Re-raise for client to handle\ndef maxAverageOfPath(matrix: List[List[int]]) -> float:\n    \"\"\"\n    Calculates the path with the maximum average cost within a given square matrix.\n    A path is defined as a specific sequence of cells that starts from the top-left cell\n    move only right or down and ends on bottom right cell. Average is computed as\n    total cost divided by the number of cells visited in the path.\n    \"\"\"\n    controller = MatrixController()\n    return controller.calculate_max_average(matrix)"}
{"task_id": "Mbpp/722", "solution": "from typing import Dict, Tuple\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    pass\ndef filter_data(student_data: Dict[str, Tuple[float, float]], min_height: float, min_weight: float) -> Dict[str, Tuple[float, float]]:\n    \"\"\"\n    Filters student records by minimum height and weight.\n    This function raises InvalidInputError if inputs are malformed or invalid.\n    \"\"\"\n    # Validate main input types.\n    if not isinstance(student_data, dict):\n        raise InvalidInputError(\"student_data must be a dictionary.\")\n    if not isinstance(min_height, (float, int)):\n        raise InvalidInputError(\"min_height must be a float or an integer.\")\n    if not isinstance(min_weight, (float, int)):\n        raise InvalidInputError(\"min_weight must be a float or an integer.\")\n\n    # Validate minimum values are non-negative.\n    if min_height < 0 or min_weight < 0:\n        raise InvalidInputError(\"Minimum height and weight cannot be negative.\")\n\n    filtered_students: Dict[str, Tuple[float, float]] = {}\n    for name, data in student_data.items():\n        # Validate individual student entry format and values.\n        if not isinstance(name, str):\n            raise InvalidInputError(f\"Student name '{name}' must be a string.\")\n        if not isinstance(data, tuple) or len(data) != 2:\n            raise InvalidInputError(f\"Student data for '{name}' must be a tuple of (height, weight).\")\n        \n        height, weight = data\n        if not isinstance(height, (float, int)) or not isinstance(weight, (float, int)):\n            raise InvalidInputError(f\"Height and weight for '{name}' must be floats or integers.\")\n        if height < 0 or weight < 0:\n            raise InvalidInputError(f\"Height and weight for '{name}' cannot be negative.\")\n\n        # Apply filtering criteria.\n        if height >= min_height and weight >= min_weight:\n            filtered_students[name] = (float(height), float(weight))\n            \n    return filtered_students"}
{"task_id": "Mbpp/721", "solution": "def maxAverageOfPath(matrix: list[list[int]]) -> float:\n    \"\"\"\n    Finds the maximum average cost of a path from the top-left to the bottom-right\n    cell in a square matrix, moving only right or down.\n    \"\"\"\n    def _validate_square_matrix(matrix_to_validate: list[list[int]]) -> None:\n        \"\"\"Validates if the input is a non-empty square matrix of integers.\"\"\"\n        if not matrix_to_validate:\n            raise ValueError(\"Matrix cannot be empty.\")\n\n        n_val = len(matrix_to_validate)\n        for r_idx, row in enumerate(matrix_to_validate):\n            if not isinstance(row, list):\n                raise ValueError(f\"Matrix row at index {r_idx} is not a list.\")\n            if len(row) != n_val:\n                raise ValueError(f\"Matrix must be square (N*N), but row {r_idx} has length {len(row)} instead of {n_val}.\")\n            for c_idx, item in enumerate(row):\n                if not isinstance(item, int):\n                    raise ValueError(f\"Matrix element at ({r_idx}, {c_idx}) must be an integer, but got {type(item).__name__}.\")\n\n    def _can_achieve_average(matrix_for_check: list[list[int]], target_avg: float) -> bool:\n        \"\"\"Checks if a path exists with an average cost >= target_avg using dynamic programming.\"\"\"\n        n_check = len(matrix_for_check)\n        \n        # Create a modified matrix where each cell value is (original_cost - target_avg)\n        modified_matrix = [[0.0] * n_check for _ in range(n_check)]\n        for r in range(n_check):\n            for c in range(n_check):\n                modified_matrix[r][c] = float(matrix_for_check[r][c]) - target_avg\n\n        # Dynamic programming to find the maximum path sum in the modified matrix\n        dp = [[0.0] * n_check for _ in range(n_check)]\n        dp[0][0] = modified_matrix[0][0]\n\n        # Initialize first row\n        for c in range(1, n_check):\n            dp[0][c] = dp[0][c-1] + modified_matrix[0][c]\n        \n        # Initialize first column\n        for r in range(1, n_check):\n            dp[r][0] = dp[r-1][0] + modified_matrix[r][0]\n\n        # Fill the rest of the DP table\n        for r in range(1, n_check):\n            for c in range(1, n_check):\n                dp[r][c] = modified_matrix[r][c] + max(dp[r-1][c], dp[r][c-1])\n        \n        # If the maximum path sum to the bottom-right cell is non-negative,\n        # it means we can achieve or exceed the target_avg.\n        return dp[n_check-1][n_check-1] >= 0\n\n    _validate_square_matrix(matrix)\n\n    n = len(matrix)\n    if n == 1:\n        return float(matrix[0][0])\n\n    # Determine the search range for binary search\n    min_val = float(matrix[0][0])\n    max_val = float(matrix[0][0])\n    for r in range(n):\n        for c in range(n):\n            min_val = min(min_val, float(matrix[r][c]))\n            max_val = max(max_val, float(matrix[r][c]))\n\n    low, high = min_val, max_val\n    ans = min_val\n    PRECISION = 1e-5\n\n    # Binary search for the maximum average\n    while high - low > PRECISION:\n        mid_avg = (low + high) / 2\n        if _can_achieve_average(matrix, mid_avg):\n            ans = mid_avg\n            low = mid_avg\n        else:\n            high = mid_avg\n            \n    return ans"}
{"task_id": "Mbpp/723", "solution": "def count_same_pair(list1: list, list2: list) -> int:\n    \"\"\"Counts indices where values in two lists are identical.\n    Raises ValueError if lists have different lengths.\"\"\"\n    if len(list1) != len(list2):\n        raise ValueError(\"Lists must have the same length.\")\n\n    same_pair_count = 0\n    for i in range(len(list1)):\n        if list1[i] == list2[i]:\n            same_pair_count += 1\n            \n    return same_pair_count"}
{"task_id": "Mbpp/723", "solution": "class ListLengthMismatchError(Exception):\n    \"\"\"\n    Custom exception raised when two lists being compared do not have the same length.\n    It provides a clear error message for such discrepancies.\n    \"\"\"\n    def __init__(self, message: str = \"Lists must be of the same length.\"):\n        super().__init__(message)\ndef count_same_pair(list1: list, list2: list) -> int:\n    \"\"\"\n    Counts identical values at corresponding indices in two lists.\n    Raises ListLengthMismatchError if the lists have different lengths.\n    \"\"\"\n    if len(list1) != len(list2):\n        raise ListLengthMismatchError()\n\n    count = 0\n    # Iterate through both lists simultaneously to compare elements.\n    for i in range(len(list1)):\n        if list1[i] == list2[i]:\n            count += 1\n    return count"}
{"task_id": "Mbpp/724", "solution": "def power_base_sum(base: int, power: int) -> int:\n    \"\"\"\n    Calculates the sum of digits of a base raised to a specified power.\n    Handles large integer results using Python's arbitrary-precision integers.\n    \"\"\"\n    if not isinstance(base, int) or not isinstance(power, int):\n        raise TypeError(\"Base and power must be integers.\")\n\n    result = base ** power\n    total_sum = sum(int(digit) for digit in str(result))\n    return total_sum"}
{"task_id": "Mbpp/724", "solution": "def power_base_sum(base: int, power: int) -> int:\n    \"\"\"\n    Calculates the sum of all digits of the base to the specified power.\n\n    Args:\n        base: The base number (integer).\n        power: The power to raise the base to (integer).\n\n    Returns:\n        The sum of the digits of the calculated power.\n\n    Raises:\n        TypeError: If base or power are not integers.\n        ValueError: If base or power are negative.\n    \"\"\"\n    if not isinstance(base, int) or not isinstance(power, int):\n        raise TypeError(\"Base and power must be integers.\")\n    if base < 0 or power < 0:\n        raise ValueError(\"Base and power must be non-negative.\")\n\n    result = base ** power\n    return sum(int(digit) for digit in str(result))"}
{"task_id": "Mbpp/725", "solution": "import re\ndef extract_quotation(text: str) -> list[str]:\n    \"\"\"\n    Extracts all substrings enclosed in double quotation marks from the input string.\n    Raises TypeError if the input 'text' is not a string.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input 'text' must be a string.\")\n\n    # Finds all non-greedy matches between double quotes, capturing the content.\n    return re.findall(r'\"([^\"]*)\"', text)"}
{"task_id": "Mbpp/725", "solution": "import re\ndef extract_quotation(text: str) -> list[str]:\n    \"\"\"\n    Extracts all substrings found between double quotation marks in the input text.\n    Raises TypeError if the input 'text' is not a string.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input 'text' must be a string.\")\n\n    # Use regex to find content inside double quotes, capturing the inner part.\n    return re.findall(r'\"([^\"]*)\"', text)"}
{"task_id": "Mbpp/726", "solution": "def multiply_elements(input_tuple: tuple) -> tuple:\n    # Check if input is a tuple as per FR1.\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n    \n    # Handle tuples with fewer than two elements as per FR2.\n    if len(input_tuple) < 2:\n        return ()\n\n    result = []\n    # Calculate product of adjacent elements as per FR2.\n    for i in range(len(input_tuple) - 1):\n        try:\n            product = input_tuple[i] * input_tuple[i+1]\n            result.append(product)\n        except TypeError:\n            # Handle non-numeric elements as per FR2.\n            raise ValueError(\"Tuple must contain only numeric elements.\")\n    return tuple(result)"}
{"task_id": "Mbpp/726", "solution": "def multiply_elements(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Takes a tuple of numbers and returns a new tuple with products of adjacent elements.\n    Handles validation for tuple type and numeric elements.\n    \"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n\n    if len(input_tuple) < 2:\n        return ()\n\n    result = []\n    for i in range(len(input_tuple) - 1):\n        t_i = input_tuple[i]\n        t_i_plus_1 = input_tuple[i + 1]\n\n        if not isinstance(t_i, (int, float)) or not isinstance(t_i_plus_1, (int, float)):\n            raise TypeError(\"All elements in the tuple must be numbers (int or float).\")\n\n        result.append(t_i * t_i_plus_1)\n\n    return tuple(result)"}
{"task_id": "Mbpp/728", "solution": "from typing import Union\ndef sum_list(list_a: list[Union[int, float]], list_b: list[Union[int, float]]) -> list[Union[int, float]]:\n    \"\"\"\n    Performs element-wise summation of two numerical lists.\n    Raises TypeError or ValueError for invalid inputs according to the design specification.\n    \"\"\"\n    # Validate that both inputs are lists.\n    if not isinstance(list_a, list) or not isinstance(list_b, list):\n        raise TypeError(\"Both inputs must be lists.\")\n\n    # Validate that the lists have the same length.\n    if len(list_a) != len(list_b):\n        raise ValueError(\"Input lists must have the same length.\")\n\n    # Validate that all elements in list_a are numbers (int or float).\n    for i, item in enumerate(list_a):\n        if not isinstance(item, (int, float)):\n            raise TypeError(f\"Element at index {i} in list_a is not a number. Found: {type(item).__name__}\")\n\n    # Validate that all elements in list_b are numbers (int or float).\n    for i, item in enumerate(list_b):\n        if not isinstance(item, (int, float)):\n            raise TypeError(f\"Element at index {i} in list_b is not a number. Found: {type(item).__name__}\")\n\n    # Perform element-wise summation.\n    result = []\n    for i in range(len(list_a)):\n        result.append(list_a[i] + list_b[i])\n\n    return result"}
{"task_id": "Mbpp/730", "solution": "def consecutive_duplicates(data_list: list) -> list:\n    \"\"\"\n    Removes consecutive duplicate elements from a list, returning a new list.\n    The order of unique elements is preserved, and the original list is not modified.\n    \"\"\"\n    if not data_list:\n        return []\n\n    result = [data_list[0]]\n    for i in range(1, len(data_list)):\n        if data_list[i] != data_list[i-1]:\n            result.append(data_list[i])\n    return result"}
{"task_id": "Mbpp/728", "solution": "class ListOperationError(Exception):\n    \"\"\"Base exception for list operations.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass ListLengthMismatchError(ListOperationError):\n    \"\"\"Exception raised when input lists have different lengths.\"\"\"\n    pass\nclass InvalidInputTypeError(ListOperationError):\n    \"\"\"Exception raised when input types are invalid (e.g., not lists, non-numeric elements).\"\"\"\n    pass\ndef sum_list(list_a, list_b):\n    \"\"\"Performs element-wise summation of two numerical lists.\n    Raises ListLengthMismatchError or InvalidInputTypeError on invalid inputs.\"\"\"\n\n    if not isinstance(list_a, list) or not isinstance(list_b, list):\n        raise InvalidInputTypeError(\"Inputs must be lists.\")\n\n    if len(list_a) != len(list_b):\n        raise ListLengthMismatchError(\"Input lists must have the same length.\")\n\n    for element in list_a:\n        if not isinstance(element, (int, float)):\n            raise InvalidInputTypeError(\"List elements must be numbers (int or float).\")\n\n    for element in list_b:\n        if not isinstance(element, (int, float)):\n            raise InvalidInputTypeError(\"List elements must be numbers (int or float).\")\n\n    result = [a + b for a, b in zip(list_a, list_b)]\n    return result"}
{"task_id": "Mbpp/730", "solution": "def consecutive_duplicates(data_list: list) -> list:\n    \"\"\"Removes consecutive duplicate elements from a list.\n    A new list is returned with consecutive duplicates removed.\n    \"\"\"\n    if not isinstance(data_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    if not data_list:\n        return []\n\n    result = [data_list[0]]\n    for item in data_list[1:]:\n        if item != result[-1]:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/731", "solution": "import math\ndef lateralsurface_cone(r: float, h: float) -> float:\n    \"\"\"Calculates the lateral surface area of a cone given its radius and height.\n    Raises ValueError if r or h are negative.\n    \"\"\"\n    if r < 0 or h < 0:\n        raise ValueError(\"Radius and height must be non-negative values.\")\n\n    slant_height = math.sqrt(r**2 + h**2) # Calculate the slant height.\n    lateral_area = math.pi * r * slant_height # Compute the lateral surface area.\n    return lateral_area"}
{"task_id": "Mbpp/731", "solution": "import math\ndef lateralsurface_cone(r: float, h: float) -> float:\n    \"\"\"Calculates the lateral surface area of a cone given its radius and height.\n    Raises ValueError if radius or height are not positive numbers.\"\"\"\n    if r <= 0 or h <= 0:\n        raise ValueError(\"Radius and height must be positive numbers.\")\n\n    slant_height = math.sqrt(r**2 + h**2)\n    lateral_area = math.pi * r * slant_height\n    return lateral_area"}
