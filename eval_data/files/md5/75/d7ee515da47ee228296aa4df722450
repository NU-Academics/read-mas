{"task_id": "Mbpp/554", "solution": "def Split(numbers: list[int]) -> list[int]:\n    \"\"\"\n    Filters a list of integers, returning a new list containing only the odd numbers.\n    Raises TypeError if the input is not a list or contains non-integer elements.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n\n    odd_numbers = []\n    for num in numbers:\n        if not isinstance(num, int):\n            raise TypeError(f\"List element '{num}' is not an integer.\")\n        if num % 2 != 0:\n            odd_numbers.append(num)\n    return odd_numbers"}
{"task_id": "Mbpp/479", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input to the first digit finder.\"\"\"\n    pass\ndef first_Digit(number: int) -> int:\n    \"\"\"\n    Finds the first digit of a given number.\n\n    Args:\n        number: The integer whose first digit is to be found.\n\n    Returns:\n        The first digit of the number (0-9).\n\n    Raises:\n        InvalidInputError: If the input is not an integer.\n    \"\"\"\n    if not isinstance(number, int):\n        raise InvalidInputError(\"Input must be an integer.\")\n\n    if number == 0:\n        return 0\n\n    # Convert to absolute value string to handle negative numbers.\n    first_char = str(abs(number))[0]\n    return int(first_char)"}
{"task_id": "Mbpp/554", "solution": "def Split(numbers: list[int]) -> list[int]:\n    \"\"\"\n    Filters a list of integers, returning only the odd ones.\n    Raises TypeError if input is not a list, ValueError if elements are not integers.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n\n    odd_numbers = []\n    for number in numbers:\n        if not isinstance(number, int):\n            raise ValueError(\"All elements in the list must be integers.\")\n        if number % 2 != 0:  # Check if the number is odd\n            odd_numbers.append(number)\n    return odd_numbers"}
{"task_id": "Mbpp/555", "solution": "def difference(n: int) -> int:\n    \"\"\"Calculates the difference between the sum of cubes of the first n natural numbers and the sum of the first n natural numbers.\n    Input 'n' must be a positive integer.\"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    # Calculate sum of first n natural numbers (S_n) and then the difference.\n    # The difference is S_n^2 - S_n, which simplifies to S_n * (S_n - 1).\n    sum_n = n * (n + 1) // 2\n    return sum_n * (sum_n - 1)"}
{"task_id": "Mbpp/555", "solution": "def difference(n: int) -> int:\n    \"\"\"\n    Calculates the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers. Raises ValueError if n is negative.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    sum_natural_numbers = n * (n + 1) // 2\n    sum_cubes = sum_natural_numbers * sum_natural_numbers\n\n    return sum_cubes - sum_natural_numbers"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(arr: list[int], n: int) -> int:\n    \"\"\"\n    Counts pairs (a, b) from arr such that their bitwise XOR sum (a ^ b) is odd.\n    An XOR sum is odd if and only if one number is even and the other is odd.\n    \"\"\"\n    if n <= 1:\n        return 0\n\n    count_even = 0\n    count_odd = 0\n\n    for i in range(n):\n        if arr[i] % 2 == 0:\n            count_even += 1\n        else:\n            count_odd += 1\n    \n    return count_even * count_odd"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input_str: str) -> str:\n    \"\"\"Toggles the case of alphabetic characters in a string.\n    Uppercase letters become lowercase, lowercase become uppercase; non-alphabetic characters remain unchanged.\n    \"\"\"\n    if not isinstance(input_str, str):\n        raise TypeError(\"Input must be a string.\")\n\n    toggled_chars = []\n    for char in input_str:\n        if 'a' <= char <= 'z':\n            toggled_chars.append(char.upper())\n        elif 'A' <= char <= 'Z':\n            toggled_chars.append(char.lower())\n        else:\n            toggled_chars.append(char)\n    return \"\".join(toggled_chars)"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(arr: list[int], n: int) -> int:\n    \"\"\"\n    Counts pairs (arr[i], arr[j]) where i < j and their bitwise XOR sum is odd.\n    An XOR sum is odd if one operand is odd and the other is even.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input 'arr' must be a list.\")\n    if not all(isinstance(x, int) for x in arr):\n        raise TypeError(\"All elements in 'arr' must be integers.\")\n    if not isinstance(n, int):\n        raise ValueError(\"Input 'n' must be an integer.\")\n    if n != len(arr):\n        raise ValueError(\"Input 'n' must be equal to the length of 'arr'.\")\n\n    odd_count = 0\n    even_count = 0\n    for x in arr:\n        if x % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n    \n    # We need to count pairs of (odd_number, even_number).\n    return odd_count * even_count"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input_string: str) -> str:\n    \"\"\"Toggles the case of alphabetic characters in a string.\n    Non-alphabetic characters remain unchanged.\"\"\"\n    if not isinstance(input_string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    toggled_chars = []\n    for char in input_string:\n        if char.islower():\n            toggled_chars.append(char.upper())\n        elif char.isupper():\n            toggled_chars.append(char.lower())\n        else:\n            toggled_chars.append(char)\n    return \"\".join(toggled_chars)"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(num1: int, num2: int) -> int:\n    \"\"\"Calculates the sum of per-digit absolute differences between two integers.\n    The shorter number is padded with leading zeros for comparison.\n    \"\"\"\n    s1 = str(num1)\n    s2 = str(num2)\n\n    # Pad numbers with leading zeros to equal length\n    max_len = max(len(s1), len(s2))\n    padded_s1 = s1.zfill(max_len)\n    padded_s2 = s2.zfill(max_len)\n\n    total_diff = 0\n    for d1, d2 in zip(padded_s1, padded_s2):\n        total_diff += abs(int(d1) - int(d2))\n    return total_diff"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(num1: int, num2: int) -> int:\n    \"\"\"\n    Calculates the sum of absolute per-digit differences between two non-negative integers.\n    The shorter number is implicitly padded with leading zeros for comparison.\n    \"\"\"\n    str_num1 = str(num1)\n    str_num2 = str(num2)\n\n    max_len = max(len(str_num1), len(str_num2))\n\n    padded_str_num1 = str_num1.zfill(max_len)\n    padded_str_num2 = str_num2.zfill(max_len)\n\n    total_difference = 0\n    for i in range(max_len):\n        digit1 = int(padded_str_num1[i])\n        digit2 = int(padded_str_num2[i])\n        total_difference += abs(digit1 - digit2)\n    return total_difference"}
{"task_id": "Mbpp/559", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef max_sub_array_sum(arr: list, n: int) -> int:\n    \"\"\"\n    Calculates the maximum sum of a contiguous sublist within `arr` of length `n`.\n    Raises InvalidInputError for any input validation failures.\n    \"\"\"\n    # Input validation\n    if arr is None:\n        raise InvalidInputError(\"Input list 'arr' cannot be None.\")\n    if not isinstance(arr, list):\n        raise InvalidInputError(\"Input 'arr' must be a list.\")\n    if not all(isinstance(x, int) for x in arr):\n        raise InvalidInputError(\"All elements in 'arr' must be integers.\")\n    if not isinstance(n, int):\n        raise InvalidInputError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise InvalidInputError(\"Input 'n' cannot be negative.\")\n    if n != len(arr):\n        raise InvalidInputError(f\"Input 'n' ({n}) does not match the actual length of 'arr' ({len(arr)}).\")\n\n    # Handle empty list case\n    if n == 0:\n        return 0\n\n    # Kadane's algorithm implementation\n    max_so_far = arr[0]\n    current_max = arr[0]\n\n    for i in range(1, n):\n        current_max = max(arr[i], current_max + arr[i])\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far"}
{"task_id": "Mbpp/559", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass KadaneSolver:\n    \"\"\"Implements Kadane's algorithm to find the maximum sum of a contiguous sub-array.\"\"\"\n    def solve(self, arr: list[int]) -> int:\n        if not arr:\n            return 0\n\n        # Handles cases where all numbers in arr are negative, returning the largest (least negative) single number.\n        if all(x < 0 for x in arr):\n            return max(arr)\n\n        max_so_far = 0\n        current_max = 0\n\n        for x in arr:\n            current_max += x\n            if current_max < 0:\n                current_max = 0\n            max_so_far = max(max_so_far, current_max)\n        \n        return max_so_far\ndef max_sub_array_sum(arr: list[int], n: int) -> int:\n    \"\"\"\n    Finds the sum of the largest contiguous sublist in the given list.\n    It validates input and delegates to Kadane's algorithm.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise InvalidInputError(\"Input 'arr' must be a list.\")\n    if not isinstance(n, int):\n        raise InvalidInputError(\"Input 'n' must be an integer.\")\n    if n != len(arr):\n        raise InvalidInputError(f\"Input 'n' ({n}) must match the length of 'arr' ({len(arr)}).\")\n\n    if n == 0:\n        return 0\n\n    solver = KadaneSolver()\n    return solver.solve(arr)"}
{"task_id": "Mbpp/560", "solution": "def union_elements(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"Computes the unique and sorted union of elements from two input tuples.\n    Raises TypeError if either input is not a tuple.\n    \"\"\"\n    if not isinstance(tuple1, tuple) or not isinstance(tuple2, tuple):\n        raise TypeError(\"Both inputs must be tuples.\")\n\n    # Combine elements, use a set for uniqueness, then sort and convert to tuple\n    combined_elements = set(tuple1 + tuple2)\n    sorted_unique_elements = sorted(list(combined_elements))\n    return tuple(sorted_unique_elements)"}
{"task_id": "Mbpp/560", "solution": "def union_elements(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Computes the union of unique elements from two tuples and returns them in sorted order.\n    Raises `TypeError` for invalid input types or non-comparable elements.\n    \"\"\"\n    if not isinstance(tuple1, tuple) or not isinstance(tuple2, tuple):\n        raise TypeError(\"Both inputs must be tuples.\")\n\n    # Combine elements and use a set to get unique elements.\n    combined_set = set(tuple1).union(set(tuple2))\n\n    # Convert to a list for sorting, then back to a tuple.\n    try:\n        sorted_list = sorted(list(combined_set))\n    except TypeError as e:\n        raise TypeError(f\"Elements in tuples are not comparable for sorting: {e}\") from e\n\n    return tuple(sorted_list)"}
{"task_id": "Mbpp/562", "solution": "def Find_Max_Length(list_of_lists: list[list]) -> int:\n    \"\"\"\n    Calculates the length of the longest sublist within a list of lists.\n    It handles type validation and returns 0 for empty inputs or empty sublists.\n    \"\"\"\n    if not isinstance(list_of_lists, list):\n        raise TypeError(\"Input must be a list.\")\n\n    max_length = 0\n    for sublist in list_of_lists:\n        if not isinstance(sublist, list):\n            raise TypeError(\"All elements in the input list must be lists.\")\n        if len(sublist) > max_length:\n            max_length = len(sublist)\n    return max_length"}
{"task_id": "Mbpp/563", "solution": "import re\nfrom typing import List\ndef extract_values(input_string: str) -> List[str]:\n    \"\"\"\n    Extracts all substrings enclosed in double quotation marks from the input string.\n    Returns a list of extracted values, without the surrounding quotation marks.\n    \"\"\"\n    pattern = r'\\\"([^\\\"]*)\\\"'\n    return re.findall(pattern, input_string)"}
{"task_id": "Mbpp/562", "solution": "from typing import Any, List\ndef Find_Max_Length(list_of_lists: List[List[Any]]) -> int:\n    \"\"\"Finds the length of the longest sublist.\n    Returns 0 for empty inputs or if no valid sublists are found.\"\"\"\n    if not isinstance(list_of_lists, list):\n        raise TypeError(\"Input must be a list.\")\n\n    # Generate lengths for actual sublists, ignoring non-list elements.\n    lengths = (len(sublist) for sublist in list_of_lists if isinstance(sublist, list))\n\n    # Return the maximum length, or 0 if no valid sublists were found.\n    return max(lengths, default=0)"}
{"task_id": "Mbpp/563", "solution": "import re\nfrom typing import List\ndef extract_values(text: str) -> List[str]:\n    \"\"\"\n    Extracts all substrings enclosed by double quotation marks from the input text.\n    Raises TypeError if input is not a string.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input must be a string.\")\n    \n    # Compile the regex pattern to efficiently find content between double quotes.\n    # It captures any character that is not a double quote, enclosed by double quotes.\n    pattern = re.compile(r'\"([^\"]*)\"')\n    \n    return pattern.findall(text)"}
