{"task_id": "Mbpp/468", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input.\n    Raised by the max_product function for invalid types or elements.\"\"\"\n    pass\ndef max_product(numbers: list[int]) -> int:\n    \"\"\"Calculates the maximum product of an increasing subsequence within a list of integers.\n    Raises InvalidInputError if the input is not a list or contains non-integer elements.\"\"\"\n    if not isinstance(numbers, list):\n        raise InvalidInputError(\"Input must be a list.\")\n    if not all(isinstance(n, int) for n in numbers):\n        raise InvalidInputError(\"All elements in the list must be integers.\")\n\n    if not numbers:\n        return 1  # Product of an empty set is 1 as per mathematical convention.\n\n    # dp_products[i] stores the maximum product of an increasing subsequence ending at index i.\n    # Initialize with the number itself, as a single element forms a subsequence.\n    dp_products = [num for num in numbers]\n\n    for i in range(len(numbers)):\n        for j in range(i):\n            if numbers[i] > numbers[j]:\n                # If numbers[i] can extend a subsequence ending at numbers[j],\n                # update dp_products[i] if a larger product is found.\n                dp_products[i] = max(dp_products[i], dp_products[j] * numbers[i])\n\n    return max(dp_products)"}
{"task_id": "Mbpp/470", "solution": "from typing import Tuple, Union\ndef add_pairwise(data_tuple: Tuple[Union[int, float]]) -> Tuple[Union[int, float]]:\n    \"\"\"\n    Calculates the pairwise addition of neighboring elements in a given tuple.\n    Returns an empty tuple if the input has fewer than two elements.\n    \"\"\"\n    if not isinstance(data_tuple, tuple):\n        raise TypeError(\"Input must be a tuple.\")\n\n    if len(data_tuple) < 2:\n        return ()\n\n    result = []\n    for i in range(len(data_tuple) - 1):\n        try:\n            # Attempt to add elements, catching TypeError for non-numeric types.\n            sum_val = data_tuple[i] + data_tuple[i+1]\n            result.append(sum_val)\n        except TypeError as e:\n            raise TypeError(\"All elements in the tuple must be numeric.\") from e\n\n    return tuple(result)"}
{"task_id": "Mbpp/470", "solution": "from typing import Tuple, Union\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input to the pairwise adder.\"\"\"\n    pass\ndef add_pairwise(data_tuple: Tuple[Union[int, float], ...]) -> Tuple[Union[int, float], ...]:\n    \"\"\"\n    Calculates the pairwise sum of neighboring elements in the given tuple.\n    Raises InvalidInputError for invalid input types, lengths, or non-numeric elements.\n    \"\"\"\n    if not isinstance(data_tuple, tuple):\n        raise InvalidInputError(\"Input must be a tuple.\")\n    if len(data_tuple) < 2:\n        raise InvalidInputError(\"Input tuple must have at least two elements for pairwise addition.\")\n\n    result = []\n    for i in range(len(data_tuple) - 1):\n        try:\n            sum_val = data_tuple[i] + data_tuple[i+1]\n            result.append(sum_val)\n        except TypeError:\n            raise InvalidInputError(\"Input tuple must contain only numeric elements.\")\n    return tuple(result)"}
{"task_id": "Mbpp/471", "solution": "def find_remainder(numbers: list, n: int) -> int:\n    \"\"\"Calculates the product of array elements modulo n, preventing overflow.\n    'n' must be a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Modulus 'n' must be a positive integer.\")\n\n    if not numbers:\n        return 1 % n\n\n    product = 1\n    for num in numbers:\n        product = (product * num) % n\n    return product"}
{"task_id": "Mbpp/472", "solution": "from typing import List, Union\ndef check_Consecutive(input_list: List[Union[int, float]]) -> bool:\n    \"\"\"Checks if the numbers in the given list are consecutive.\n    Returns True if consecutive, False otherwise.\"\"\"\n    if not input_list or len(input_list) < 2:\n        return True\n\n    sorted_list = sorted(input_list)\n\n    for i in range(len(sorted_list) - 1):\n        if sorted_list[i+1] - sorted_list[i] != 1:\n            return False\n    return True"}
{"task_id": "Mbpp/468", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef max_product(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the maximum product of an increasing subsequence from a given array.\n    It uses dynamic programming and validates input for positive integers.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise InvalidInputError(\"Input must be a list.\")\n    if not all(isinstance(x, int) and x > 0 for x in arr):\n        raise InvalidInputError(\"All elements in the list must be positive integers.\")\n\n    n = len(arr)\n    if n == 0:\n        return 0\n    if n == 1:\n        return arr[0]\n\n    # dp[i] stores the maximum product of an increasing subsequence ending at arr[i].\n    dp = list(arr)\n\n    for i in range(n):\n        for j in range(i):\n            if arr[i] > arr[j]:\n                dp[i] = max(dp[i], dp[j] * arr[i])\n\n    return max(dp)"}
{"task_id": "Mbpp/471", "solution": "class InvalidModulusError(Exception):\n    \"\"\"Custom exception for invalid modulus values.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef find_remainder(array: list[int], n: int) -> int:\n    \"\"\"\n    Calculates the product of numbers in a list modulo n.\n    Handles empty arrays, negative numbers, and modulus validation.\n    \"\"\"\n    # Modulus must be a positive integer as per FR1 and BR1.\n    if not isinstance(n, int) or n <= 0:\n        raise InvalidModulusError(\"Modulus must be a positive integer.\")\n\n    # Handle an empty input list by returning 1 modulo n (FR4).\n    if not array:\n        return 1 % n\n\n    current_product = 1\n    # Compute product with modular reduction at each step (NFR1).\n    for num in array:\n        # Handle negative numbers by normalizing to [0, n-1] (FR5).\n        normalized_num = (num % n + n) % n\n        current_product = (current_product * normalized_num) % n\n    \n    # Return the final product modulo n (FR3).\n    return current_product"}
{"task_id": "Mbpp/472", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to the consecutive checker.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\nFLOAT_EPSILON = 1e-9\ndef check_Consecutive(numbers: list) -> bool:\n    \"\"\"\n    Checks if a list of numbers contains consecutive elements after sorting.\n    Raises InvalidInputError for non-list inputs or non-numeric elements.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise InvalidInputError(\"Input must be a list.\")\n\n    if len(numbers) < 2:\n        return False\n\n    processed_numbers = []\n    for num in numbers:\n        if not isinstance(num, (int, float)):\n            raise InvalidInputError(\"All elements in the list must be numbers (int or float).\")\n        processed_numbers.append(num)\n\n    processed_numbers.sort()\n\n    for i in range(len(processed_numbers) - 1):\n        diff = processed_numbers[i+1] - processed_numbers[i]\n        # Check if the difference is approximately 1, accounting for float precision.\n        if abs(diff - 1) < FLOAT_EPSILON:\n            return True\n    return False"}
