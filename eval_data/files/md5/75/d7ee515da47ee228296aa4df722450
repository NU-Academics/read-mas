{"task_id": "Mbpp/790", "solution": "class InvalidListInputError(ValueError):\n    \"\"\"Custom exception for invalid list input. Indicates issues with input type or element types.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef even_position(data_list: list) -> bool:\n    \"\"\"Checks if numbers at even indices in a list are even. Raises InvalidListInputError for bad input.\"\"\"\n    if not isinstance(data_list, list):\n        raise InvalidListInputError(\"Input must be a list.\")\n\n    for i in range(0, len(data_list), 2):\n        element = data_list[i]\n        if not isinstance(element, (int, float)):\n            raise InvalidListInputError(\n                f\"Element at index {i} is not a number. Found type: {type(element).__name__}\"\n            )\n        if element % 2 != 0:\n            return False\n    return True"}
{"task_id": "Mbpp/790", "solution": "def even_position(input_list: list) -> bool:\n    \"\"\"\n    Checks if every even index in the given list contains an even number.\n    Raises TypeError if an element at an even index is not a number.\n    \"\"\"\n    for i in range(0, len(input_list), 2):\n        element = input_list[i]\n        # Verify if the element is a number (integer or float).\n        if not isinstance(element, (int, float)):\n            raise TypeError(f\"Element at index {i} is not a number: {element}\")\n        \n        # Determine if the numeric element is odd.\n        if element % 2 != 0:\n            return False\n    return True"}
