{"task_id": "Mbpp/119", "solution": "def search(arr: list[int]) -> int | None:\n    \"\"\"Finds the single element that appears only once in a sorted array,\n    where all other elements appear exactly twice. Returns None if the array is empty.\"\"\"\n    if not arr:\n        return None\n\n    left, right = 0, len(arr) - 1\n    while left < right:\n        mid = (left + right) // 2\n        # Adjust mid to be the start of a potential pair to ensure consistent comparison.\n        if mid % 2 == 1:\n            mid -= 1\n\n        # If the pair matches, the unique element is to the right. Otherwise, it's to the left or at mid.\n        if arr[mid] == arr[mid + 1]:\n            left = mid + 2\n        else:\n            right = mid\n            \n    return arr[left]"}
{"task_id": "Mbpp/119", "solution": "def search(arr: list[int]) -> int:\n    \"\"\"Finds the single element that appears only once in a sorted array.\n    All other elements appear exactly twice.\"\"\"\n\n    if not arr:\n        raise ValueError(\"Input array cannot be empty.\")\n    \n    # An array with exactly one unique element and all others appearing twice must have an odd length.\n    if len(arr) % 2 == 0:\n        raise ValueError(\"Input array length must be odd to fit the unique element pattern.\")\n\n    low, high = 0, len(arr) - 1\n\n    while low < high:\n        mid = low + (high - low) // 2\n        \n        # Ensure 'mid' is an even index; adjust if odd to maintain pair-checking logic.\n        if mid % 2 == 1:\n            mid -= 1\n\n        # If arr[mid] and arr[mid+1] are a pair, the unique element is to their right.\n        if arr[mid] == arr[mid+1]:\n            low = mid + 2\n        # Otherwise, the unique element is at or to the left of arr[mid].\n        else:\n            high = mid\n            \n    return arr[low]"}
{"task_id": "Mbpp/123", "solution": "def _sum_proper_divisors(num: int) -> int:\n    \"\"\"\n    Calculates the sum of all proper divisors for a given positive integer.\n    Raises ValueError if input is not a positive integer.\n    \"\"\"\n    if not isinstance(num, int) or num <= 0:\n        raise ValueError(\"Input 'num' must be a positive integer.\")\n    if num == 1:\n        return 0\n\n    total = 1  # 1 is always a proper divisor for num > 1.\n    for i in range(2, int(num**0.5) + 1):\n        if num % i == 0:\n            total += i\n            if i * i != num:  # Add the complementary divisor if it's not the square root.\n                total += num // i\n    return total\ndef amicable_numbers_sum(limit: int) -> int:\n    \"\"\"\n    Calculates the sum of all amicable numbers from 1 up to the specified limit.\n    Raises ValueError if the limit is not a positive integer.\n    \"\"\"\n    if not isinstance(limit, int) or limit <= 0:\n        raise ValueError(\"Input 'limit' must be a positive integer.\")\n\n    total_sum = 0\n    found_amicable_numbers = set()\n\n    for a in range(1, limit + 1):\n        if a in found_amicable_numbers:\n            continue\n\n        sum_divisors_a = _sum_proper_divisors(a)\n        b = sum_divisors_a\n\n        # Check if 'a' and 'b' form an amicable pair within the limit.\n        if a != b and b <= limit:\n            sum_divisors_b = _sum_proper_divisors(b)\n            if sum_divisors_b == a:\n                total_sum += a\n                total_sum += b\n                found_amicable_numbers.add(a)\n                found_amicable_numbers.add(b)\n    return total_sum"}
{"task_id": "Mbpp/120", "solution": "from typing import List, Tuple, Union\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input data.\n    It indicates that the provided input does not meet the required format or type.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef max_product_tuple(data: List[Tuple[Union[int, float], Union[int, float]]]) -> Union[int, float]:\n    \"\"\"Calculates the maximum absolute product from a list of number pairs.\n    It processes each valid tuple and returns the largest absolute product found.\n    \"\"\"\n    if not isinstance(data, list):\n        raise InvalidInputError(\"Input must be a list.\")\n\n    max_abs_product = 0.0\n\n    for i, item in enumerate(data):\n        if not isinstance(item, tuple):\n            raise InvalidInputError(f\"Element at index {i} is not a tuple: {item}\")\n        if len(item) != 2:\n            raise InvalidInputError(f\"Tuple at index {i} does not contain exactly two elements: {item}\")\n\n        a, b = item\n        if not isinstance(a, (int, float)) or not isinstance(b, (int, float)):\n            raise InvalidInputError(f\"Elements in tuple at index {i} must be numeric: {item}\")\n\n        current_product = abs(a * b)\n        max_abs_product = max(max_abs_product, current_product)\n\n    return max_abs_product"}
{"task_id": "Mbpp/120", "solution": "from typing import List, Tuple, Union\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input to the product calculator.\"\"\"\n    pass\ndef max_product_tuple(data: List[Tuple[Union[int, float], Union[int, float]]]) -> Union[int, float]:\n    \"\"\"\n    Calculates the maximum absolute product from a list of numeric pairs.\n    Handles input validation and returns 0 for an empty list as per requirements.\n    \"\"\"\n    # Validate input type and structure as per FR1.\n    if not isinstance(data, list):\n        raise InvalidInputError(\"Input must be a list.\")\n    for item in data:\n        if not isinstance(item, tuple) or len(item) != 2:\n            raise InvalidInputError(\"Each item in the list must be a 2-element tuple.\")\n        if not all(isinstance(x, (int, float)) for x in item):\n            raise InvalidInputError(\"Each element within a tuple must be a number (int or float).\")\n\n    # Handle empty list case as per FR4 error handling.\n    if not data:\n        return 0\n\n    max_abs_prod: Union[int, float] = 0\n\n    for a, b in data:\n        # Calculate product (FR2) and its absolute value (FR3, BR1).\n        current_product = a * b\n        abs_current_product = abs(current_product)\n        # Update maximum absolute product found (FR4).\n        if abs_current_product > max_abs_prod:\n            max_abs_prod = abs_current_product\n            \n    return max_abs_prod"}
