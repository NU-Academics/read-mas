{"task_id": "Mbpp/252", "solution": "import math\ndef convert(z: complex) -> tuple[float, float]:\n    \"\"\"Converts a complex number to its polar coordinates (magnitude, phase).\n    Raises TypeError if input 'z' is not a complex number.\n    \"\"\"\n    if not isinstance(z, complex):\n        # The prompt's example 'convert(1)' implies that an integer should be treated as a complex number with an imaginary part of 0.\n        # Python's complex() constructor handles this gracefully: complex(1) -> (1+0j)\n        # So, we'll convert non-complex numbers to complex numbers if possible, rather than raising a TypeError immediately for numeric types.\n        try:\n            z = complex(z)\n        except TypeError:\n            raise TypeError(\"Input must be a complex number or a type coercible to complex (e.g., int, float).\")\n\n\n    magnitude = math.hypot(z.real, z.imag)\n    phase = math.atan2(z.imag, z.real)\n    return magnitude, phase"}
{"task_id": "Mbpp/252", "solution": "import cmath\ndef convert(complex_num):\n    \"\"\"\n    Converts a complex number to its polar coordinates (magnitude, phase).\n\n    Args:\n        complex_num: The complex number to convert. Can be an int, float, or complex.\n\n    Returns:\n        A tuple (magnitude, phase) where magnitude is a float and phase is a float in radians.\n    \"\"\"\n    # Ensure the input is treated as a complex number.\n    # This handles int and float inputs gracefully (e.g., 1 becomes 1+0j).\n    c = complex(complex_num)\n    magnitude, phase = cmath.polar(c)\n    return (magnitude, phase)"}
{"task_id": "Mbpp/253", "solution": "def count_integer(input_list: list) -> int:\n    \"\"\"Counts the number of integer elements in a given list. Raises TypeError if input is not a list.\"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    count = 0\n    for element in input_list:\n        if isinstance(element, int):\n            count += 1\n    return count"}
