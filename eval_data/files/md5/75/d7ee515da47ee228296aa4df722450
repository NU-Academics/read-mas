{"task_id": "Mbpp/453", "solution": "def sumofFactors(number: int) -> int:\n    \"\"\"Calculates the sum of all even factors for a given positive integer.\n    Raises ValueError if the input is not a positive integer.\n    \"\"\"\n    if not isinstance(number, int) or number <= 0:\n        raise ValueError(\"Input 'number' must be a positive integer.\")\n\n    total_even_factors = 0\n    for i in range(1, number + 1):\n        if number % i == 0 and i % 2 == 0:\n            total_even_factors += i\n    return total_even_factors"}
{"task_id": "Mbpp/454", "solution": "import re\n_Z_WORD_PATTERN = re.compile(r'\\b\\w*z\\w*\\b', re.IGNORECASE)\ndef text_match_wordz(text: str) -> bool:\n    \"\"\"\n    Checks if any word within the given text contains the letter 'z' (case-insensitive).\n    Returns True if a word containing 'z' is found, False otherwise.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input 'text' must be a string.\")\n    return bool(_Z_WORD_PATTERN.search(text))"}
{"task_id": "Mbpp/453", "solution": "def sumofFactors(number: int) -> int:\n    \"\"\"\n    Calculates the sum of all even factors for a given positive integer.\n    It first finds all positive integer factors and then sums only the even ones.\n    \"\"\"\n    factors = []\n    for i in range(1, int(number**0.5) + 1):\n        if number % i == 0:\n            factors.append(i)\n            if i * i != number:\n                factors.append(number // i)\n    \n    return sum(f for f in factors if f % 2 == 0)"}
{"task_id": "Mbpp/454", "solution": "import re\ndef text_match_wordz(text: str) -> bool:\n    \"\"\"Determines if a given input string contains at least one word that includes the character 'z'.\n\n    This function acts as a convenient package-level entry point.\n\n    Args:\n        text: The string to search within.\n\n    Returns:\n        True if a word containing 'z' is found, False otherwise.\n\n    Raises:\n        TypeError: If the input text is not a string.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input 'text' must be a string.\")\n\n    # Pattern for finding a word containing 'z' (case-insensitive).\n    # \\b ensures whole word matching, \\w* allows alphanumeric characters around 'z'.\n    WORD_WITH_Z_PATTERN = r'\\b\\w*z\\w*\\b'\n\n    # Search for the pattern using re.IGNORECASE for case-insensitivity.\n    return re.search(WORD_WITH_Z_PATTERN, text, re.IGNORECASE) is not None"}
{"task_id": "Mbpp/455", "solution": "MONTHS_WITH_31_DAYS: set[int] = {1, 3, 5, 7, 8, 10, 12}\nclass InvalidMonthNumberError(ValueError):\n    \"\"\"Custom exception for invalid month numbers.\n    It indicates that the provided month number is out of range.\"\"\"\n    pass\ndef check_monthnumb_number(month_number: int) -> bool:\n    \"\"\"Checks if the given month number corresponds to a month with 31 days.\n    Raises InvalidMonthNumberError for input outside the 1-12 range.\"\"\"\n    if not (1 <= month_number <= 12):\n        raise InvalidMonthNumberError(\n            f\"Month number must be between 1 and 12, but got {month_number}.\"\n        )\n    return month_number in MONTHS_WITH_31_DAYS"}
{"task_id": "Mbpp/455", "solution": "MONTHS_WITH_31_DAYS = {1, 3, 5, 7, 8, 10, 12}\ndef check_monthnumb_number(month_number: int) -> bool:\n    \"\"\"\n    Checks if the given month number corresponds to a month with 31 days.\n    Raises ValueError if month_number is not an integer or is out of range [1, 12].\n    \"\"\"\n    if not isinstance(month_number, int):\n        raise ValueError(\"month_number must be an integer.\")\n    if not (1 <= month_number <= 12):\n        raise ValueError(\"month_number must be between 1 and 12.\")\n\n    return month_number in MONTHS_WITH_31_DAYS"}
