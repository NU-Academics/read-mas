{"task_id": "Mbpp/426", "solution": "def filter_oddnumbers(numbers: list[int]) -> list[int]:\n    \"\"\"Filters a list of integers, returning a new list containing only the odd numbers.\n    It validates input types, raising TypeError or ValueError for invalid inputs.\"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n\n    odd_numbers = []\n    for number in numbers:\n        if not isinstance(number, int):\n            raise ValueError(f\"All elements in the list must be integers, but found {type(number).__name__}.\")\n        if number % 2 != 0:\n            odd_numbers.append(number)\n    return odd_numbers"}
{"task_id": "Mbpp/426", "solution": "class InvalidInputTypeError(TypeError):\n    \"\"\"Custom exception for invalid input type.\"\"\"\n    pass\nclass InvalidListElementError(ValueError):\n    \"\"\"Custom exception for invalid element type within a list.\"\"\"\n    pass\ndef filter_oddnumbers(numbers: list[int]) -> list[int]:\n    \"\"\"\n    Filters a list of integers, returning a new list containing only the odd numbers.\n    Raises InvalidInputTypeError if input is not a list, InvalidListElementError if any element is not an integer.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise InvalidInputTypeError(\"Input must be a list.\")\n\n    odd_numbers_result = []\n    for number in numbers:\n        # Strict type check: must be an int, excluding bools (which are int subclasses).\n        if not isinstance(number, int) or isinstance(number, bool):\n            raise InvalidListElementError(f\"List element '{number}' is not an integer.\")\n        \n        if number % 2 != 0:  # Check if the number is odd.\n            odd_numbers_result.append(number)\n            \n    return odd_numbers_result"}
