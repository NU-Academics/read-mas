{"task_id": "Mbpp/116", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input to the tuple conversion utility.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef tuple_to_int(input_tuple: tuple[int, ...]) -> int:\n    \"\"\"Converts a tuple of positive integers into a single integer. Example: (1, 2, 3) -> 123.\"\"\"\n    if not isinstance(input_tuple, tuple):\n        raise InvalidInputError(\"Input must be a tuple.\")\n\n    if not input_tuple:\n        return 0\n\n    string_parts = []\n    for element in input_tuple:\n        if not isinstance(element, int) or element <= 0:\n            raise InvalidInputError(\"All elements in the tuple must be positive integers.\")\n        string_parts.append(str(element))\n\n    return int(\"\".join(string_parts))"}
