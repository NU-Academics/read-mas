{"task_id": "Mbpp/160", "solution": "def _egcd(a: int, b: int) -> tuple[int, int, int]:\n    \"\"\"\n    Implements the Extended Euclidean Algorithm.\n    Returns (gcd, x, y) such that ax + by = gcd(a, b).\n    \"\"\"\n    if b == 0:\n        return (a, 1, 0)\n    gcd, x1, y1 = _egcd(b, a % b)\n    x = y1\n    y = x1 - (a // b) * y1\n    return (gcd, x, y)\ndef find_solution(a: int, b: int, n: int) -> tuple[int, int] | None:\n    \"\"\"\n    Finds integer solutions (x, y) for the linear Diophantine equation ax + by = n.\n    Returns a tuple (x, y) if a solution exists, otherwise None.\n    \"\"\"\n    if a == 0 and b == 0:\n        return (0, 0) if n == 0 else None\n    if a == 0:\n        return (0, n // b) if n % b == 0 else None\n    if b == 0:\n        return (n // a, 0) if n % a == 0 else None\n\n    g, x_g, y_g = _egcd(abs(a), abs(b))\n\n    if n % g != 0:\n        return None\n\n    k = n // g\n    x_particular = x_g * k\n    y_particular = y_g * k\n\n    x_raw = x_particular * (1 if a >= 0 else -1)\n    y_raw = y_particular * (1 if b >= 0 else -1)\n\n    x_step = b // g\n    y_step = a // g\n\n    # Normalize solution to a canonical form, e.g., to match (2, 1) for (2, 3, 7).\n    # This adjusts the solution to be within one \"period\" of the general solution.\n    # The general solution is (x_raw + t * (b/g), y_raw - t * (a/g))\n    # We find 't' such that x_result (or y_result) is \"smallest\" or \"most positive\".\n    # Here, we aim to get x_result in range [0, abs(b/g) - 1) or similar.\n    # The choice of `t` to normalize x_raw such that 0 <= x_result < abs(b/g)\n    # or to match positive assertion (2,1) for (2,3,7).\n    # The current normalization uses `x_raw // x_step` which essentially shifts\n    # x_raw to be in a certain range relative to x_step.\n    t = x_raw // x_step\n    x_result = x_raw - t * x_step\n    y_result = y_raw + t * y_step\n\n    return (x_result, y_result)"}
{"task_id": "Mbpp/235", "solution": "EVEN_BITS_MASK = 0x5555555555555555\ndef even_bit_set_number(number: int) -> int:\n    \"\"\"\n    Sets all even-indexed bits (0, 2, 4, ...) of a given number to 1.\n    Bit positions are 0-indexed from the right.\n\n    Args:\n        number: The input integer.\n\n    Returns:\n        The integer with all its even-indexed bits set to 1.\n    \"\"\"\n    return number | EVEN_BITS_MASK"}
{"task_id": "Mbpp/235", "solution": "def even_bit_set_number(number: int) -> int:\n    \"\"\"\n    Sets all even-indexed bits of a non-negative integer to 1.\n    Raises ValueError for negative input.\n    \"\"\"\n    if number < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n    if number == 0:\n        return 0\n\n    mask = 0\n    # Create a mask with 1s at all even bit positions up to the number's highest bit.\n    for i in range(number.bit_length()):\n        if i % 2 == 0:\n            mask |= (1 << i)\n    \n    return number | mask"}
{"task_id": "Mbpp/237", "solution": "from collections import Counter\nfrom typing import List, Tuple, Any, Dict\ndef check_occurences(data: List[Tuple[Any, ...]]) -> Dict[Tuple[Any, ...], int]:\n    \"\"\"\n    Counts occurrences of normalized tuples in a list, where tuples are normalized by sorting their elements.\n    It processes each tuple by sorting its internal elements to determine uniqueness before counting.\n    \"\"\"\n    normalized_tuples = []\n    for tpl in data:\n        # Normalize the tuple by sorting its elements and converting back to a tuple.\n        normalized_tuples.append(tuple(sorted(tpl)))\n    return dict(Counter(normalized_tuples))"}
{"task_id": "Mbpp/237", "solution": "from collections import defaultdict\ndef _normalize_tuple(input_tuple: tuple) -> tuple:\n    \"\"\"\n    Normalizes a tuple by sorting its elements.\n    Propagates TypeError if elements are not sortable.\n    \"\"\"\n    return tuple(sorted(input_tuple))\ndef check_occurences(list_of_tuples: list[tuple]) -> dict[tuple, int]:\n    \"\"\"\n    Counts the occurrences of normalized tuples in a list.\n    Raises TypeError for non-tuple list elements or unsortable tuple elements.\n    \"\"\"\n    occurrences = defaultdict(int)\n    for tpl in list_of_tuples:\n        if not isinstance(tpl, tuple):\n            raise TypeError(f\"Expected a tuple in the list, but got {type(tpl)}\")\n        normalized_tpl = _normalize_tuple(tpl)\n        occurrences[normalized_tpl] += 1\n    return dict(occurrences)"}
