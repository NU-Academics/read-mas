{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list: list, sublist: list) -> bool:\n    \"\"\"\n    Checks if a sublist is found anywhere contiguously within the main list.\n    An empty sublist is considered a sublist of any main list.\n    \"\"\"\n    if not sublist:\n        return True\n\n    len_main = len(main_list)\n    len_sub = len(sublist)\n\n    if len_sub > len_main:\n        return False\n\n    for i in range(len_main - len_sub + 1):\n        if main_list[i : i + len_sub] == sublist:\n            return True\n\n    return False"}
{"task_id": "Mbpp/67", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input values.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\n_bell_cache = {0: 1, 1: 1}\n_stirling_cache = {}\ndef _stirling_second_kind(n: int, k: int) -> int:\n    \"\"\"Calculates the Stirling number of the second kind S(n, k) using recursion and memoization.\"\"\"\n    if k < 0 or k > n:\n        return 0\n    if k == 0:\n        return 1 if n == 0 else 0\n    if k == n:\n        return 1\n    if k == 1:\n        return 1 # S(n, 1) = 1 for n > 0\n    if (n, k) in _stirling_cache:\n        return _stirling_cache[(n, k)]\n\n    result = k * _stirling_second_kind(n - 1, k) + _stirling_second_kind(n - 1, k - 1)\n    _stirling_cache[(n, k)] = result\n    return result\ndef bell_number(n: int) -> int:\n    \"\"\"\n    Calculates the n-th Bell number.\n\n    The Bell number B(n) is the number of ways to partition a set of n elements.\n    It is calculated as the sum of Stirling numbers of the second kind:\n    B(n) = sum(S(n, k) for k from 0 to n)\n\n    Args:\n        n (int): A non-negative integer representing the number of elements in the set.\n\n    Returns:\n        int: The n-th Bell number.\n\n    Raises:\n        InvalidInputError: If n is a negative integer.\n    \"\"\"\n    if not isinstance(n, int):\n        raise InvalidInputError(\"Parameter 'n' must be an integer.\")\n    if n < 0:\n        raise InvalidInputError(\"Parameter 'n' must be a non-negative integer.\")\n\n    if n in _bell_cache:\n        return _bell_cache[n]\n\n    bell_n = 0\n    for k in range(n + 1):\n        bell_n += _stirling_second_kind(n, k)\n    \n    _bell_cache[n] = bell_n\n    return bell_n"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(main_list: list, sub_list: list) -> bool:\n    \"\"\"\n    Checks if a sub_list is present as a contiguous sequence within a main_list.\n    Returns True if sub_list is found, False otherwise.\n    \"\"\"\n    if not sub_list:\n        return True\n\n    n = len(main_list)\n    m = len(sub_list)\n\n    if m > n:\n        return False\n\n    for i in range(n - m + 1):\n        if main_list[i : i + m] == sub_list:\n            return True\n    return False"}
{"task_id": "Mbpp/70", "solution": "def get_equal(tuple_list: list[tuple]) -> bool:\n    \"\"\"Checks if all tuples in the given list have the same length.\n    Raises TypeError if the input is not a list or contains non-tuple elements.\n    \"\"\"\n    if not isinstance(tuple_list, list):\n        raise TypeError(\"Input must be a list of tuples.\")\n\n    if not tuple_list:\n        return True\n\n    first_tuple_length = None\n    for i, item in enumerate(tuple_list):\n        if not isinstance(item, tuple):\n            raise TypeError(f\"Element at index {i} is not a tuple.\")\n        \n        if first_tuple_length is None:\n            first_tuple_length = len(item)\n        elif len(item) != first_tuple_length:\n            return False\n    return True"}
{"task_id": "Mbpp/70", "solution": "class InvalidInputError(TypeError):\n    \"\"\"Custom exception for invalid input types or structures.\"\"\"\n    pass\ndef get_equal(list_of_tuples: list[tuple]) -> bool:\n    \"\"\"\n    Checks if all tuples in the given list have the same length.\n    Raises InvalidInputError for non-list input or non-tuple elements.\n    \"\"\"\n    if not isinstance(list_of_tuples, list):\n        raise InvalidInputError(\"Input must be a list.\")\n\n    if not list_of_tuples:\n        return True\n\n    first_tuple_length = None\n    for i, item in enumerate(list_of_tuples):\n        if not isinstance(item, tuple):\n            raise InvalidInputError(f\"Element at index {i} is not a tuple.\")\n\n        current_length = len(item)\n        if first_tuple_length is None:\n            first_tuple_length = current_length\n        elif current_length != first_tuple_length:\n            return False\n    \n    return True"}
{"task_id": "Mbpp/71", "solution": "from typing import List\nclass CombSortService:\n    SHRINK_FACTOR: float = 1.3\n\n    def sort(self, data_list: List[int]) -> List[int]:\n        # Validates input for type and elements as per requirements.\n        # It then creates a copy and delegates to the private sorting method.\n        if not isinstance(data_list, list):\n            raise TypeError(\"Input must be a list.\")\n        if not all(isinstance(x, int) for x in data_list):\n            raise TypeError(\"All elements in the list must be integers.\")\n\n        # Create a copy to avoid modifying the original list.\n        arr = list(data_list)\n        n = len(arr)\n\n        if n <= 1:\n            return arr\n\n        return self._private_comb_sort(arr)\n\n    def _private_comb_sort(self, arr: List[int]) -> List[int]:\n        n = len(arr)\n        gap = n\n        swapped = True \n\n        # Applies the comb sort algorithm to arrange elements in ascending order.\n        # It repeatedly reduces the gap and performs comparisons and swaps.\n        while gap > 1 or swapped:\n            if gap > 1:\n                gap = int(gap / self.SHRINK_FACTOR)\n            \n            swapped = False\n            for i in range(n - gap):\n                if arr[i] > arr[i + gap]:\n                    arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                    swapped = True\n        return arr\ndef comb_sort(data_list: List[int]) -> List[int]:\n    \"\"\"\n    Sorts a list of integers using the Comb Sort algorithm.\n    It returns a new list containing the sorted integers in ascending order.\n    \"\"\"\n    service = CombSortService()\n    return service.sort(data_list)"}
{"task_id": "Mbpp/72", "solution": "def dif_Square(n: int) -> bool:\n    \"\"\"\n    Checks if the given integer 'n' can be represented as the difference of two squares.\n    An integer 'n' can be represented as a^2 - b^2 if and only if 'n' is odd or 'n' is a multiple of 4.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n\n    # This property allows an O(1) check based on divisibility by 2 and 4.\n    return n % 2 != 0 or n % 4 == 0"}
