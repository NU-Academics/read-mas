{"task_id": "Mbpp/799", "solution": "BITS_IN_NUMBER = 32\nMAX_32BIT_VALUE = (2**BITS_IN_NUMBER - 1)\ndef left_rotate(number: int, d: int) -> int:\n    \"\"\"\n    Performs a left bit rotation on a 32-bit unsigned integer.\n    Raises ValueError for invalid input 'number' or 'd'.\n    \"\"\"\n    if not (0 <= number <= MAX_32BIT_VALUE):\n        raise ValueError(f\"Number must be a 32-bit unsigned integer (0 to {MAX_32BIT_VALUE}). Got {number}\")\n    if not (0 <= d < BITS_IN_NUMBER):\n        raise ValueError(f\"Rotation amount 'd' must be between 0 and {BITS_IN_NUMBER - 1}. Got {d}\")\n\n    # Calculate the left-rotated value using bitwise operations.\n    rotated_value = (number << d) | (number >> (BITS_IN_NUMBER - d))\n    \n    # Mask to ensure the result remains within the 32-bit unsigned integer range.\n    return rotated_value & MAX_32BIT_VALUE"}
{"task_id": "Mbpp/801", "solution": "def test_three_equal(a: int, b: int, c: int) -> int:\n    \"\"\"Counts the number of equal integers among three given inputs. Raises TypeError if inputs are not integers.\"\"\"\n    if not all(isinstance(arg, int) for arg in [a, b, c]):\n        raise TypeError(\"All inputs must be integers.\")\n\n    if a == b and b == c:\n        return 3\n    elif a == b or b == c or a == c:\n        return 2\n    else:\n        return 0"}
