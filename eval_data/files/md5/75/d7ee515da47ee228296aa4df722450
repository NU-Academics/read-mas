{"task_id": "Mbpp/586", "solution": "def split_Arr(arr: list, n: int) -> list:\n    \"\"\"\n    Splits a list at the nth element and moves the first part to the end.\n    Returns a new reordered list, leaving the original unchanged.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer.\")\n    if not arr:\n        raise ValueError(\"Input list cannot be empty.\")\n    if not (0 <= n < len(arr)):\n        raise ValueError(f\"n ({n}) is out of bounds for list of length {len(arr)}.\")\n\n    first_part = arr[:n]\n    second_part = arr[n:]\n    return second_part + first_part"}
{"task_id": "Mbpp/586", "solution": "class InvalidSplitIndexError(Exception):\n    \"\"\"Custom exception raised when the split index 'n' is invalid.\n    It indicates 'n' is negative or exceeds the list's length.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef split_Arr(arr: list, n: int) -> list:\n    \"\"\"Splits a list at index 'n', moving the initial segment to the end.\n    A new list is returned, leaving the original list unchanged.\"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Split index 'n' must be an integer.\")\n\n    if n < 0:\n        raise InvalidSplitIndexError(\"Split index 'n' cannot be negative.\")\n\n    if n > len(arr):\n        raise InvalidSplitIndexError(\n            f\"Split index 'n' ({n}) cannot be greater than the list length ({len(arr)}).\"\n        )\n\n    if n == 0 or n == len(arr):\n        return list(arr)\n\n    first_part = arr[:n]\n    second_part = arr[n:]\n\n    return second_part + first_part"}
