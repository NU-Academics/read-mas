{"task_id": "Mbpp/763", "solution": "import math\nclass MinDiffError(Exception):\n    pass\nMIN_ARRAY_LENGTH = 2\ndef find_min_diff(arr: tuple[int, ...], length: int) -> int:\n    \"\"\"\n    Calculates the minimum absolute difference between any two elements in the array.\n    Raises MinDiffError for invalid inputs or insufficient elements.\n    \"\"\"\n    # Validate input types and array length against specifications.\n    if not isinstance(arr, tuple):\n        raise MinDiffError(\"Input 'arr' must be a tuple.\")\n    if not all(isinstance(x, int) for x in arr):\n        raise MinDiffError(\"All elements in 'arr' must be integers.\")\n    if not isinstance(length, int):\n        raise MinDiffError(\"Input 'length' must be an integer.\")\n    if len(arr) != length:\n        raise MinDiffError(f\"Provided length {length} does not match actual array length {len(arr)}.\")\n    if length < MIN_ARRAY_LENGTH:\n        raise MinDiffError(f\"Array must contain at least {MIN_ARRAY_LENGTH} elements to find a difference.\")\n\n    # Sort the array to efficiently find differences between adjacent elements.\n    sorted_arr = sorted(list(arr))\n    min_diff = math.inf\n\n    # Iterate through the sorted array to find the smallest absolute difference.\n    for i in range(length - 1):\n        diff = abs(sorted_arr[i+1] - sorted_arr[i])\n        if diff < min_diff:\n            min_diff = diff\n            \n    return int(min_diff)"}
{"task_id": "Mbpp/763", "solution": "import math\ndef find_min_diff(arr: tuple, n: int) -> int:\n    \"\"\"\n    Calculates the minimum absolute difference between any two elements in a given array.\n    Returns 0 if the array has fewer than two elements, as no comparison is possible.\n    \"\"\"\n    if n < 2:\n        return 0\n\n    # Sort the array to efficiently find the minimum difference between adjacent elements.\n    # This creates a new list from the input iterable.\n    sorted_arr = sorted(arr) \n\n    min_diff = math.inf\n\n    for i in range(n - 1):\n        diff = abs(sorted_arr[i+1] - sorted_arr[i])\n        min_diff = min(min_diff, diff)\n    \n    # Cast to int as per the design specification's return type.\n    return int(min_diff)"}
{"task_id": "Mbpp/766", "solution": "from typing import Any, List, Tuple\ndef pair_wise(input_list: List[Any]) -> List[Tuple[Any, Any]]:\n    \"\"\"\n    Returns a list of all pairs of consecutive items in a given list.\n    Returns an empty list if the input list has fewer than two elements.\n    \"\"\"\n    if len(input_list) < 2:\n        return []\n    \n    return [(input_list[i], input_list[i+1]) for i in range(len(input_list) - 1)]"}
{"task_id": "Mbpp/766", "solution": "from typing import Any, List, Tuple\ndef pair_wise(input_list: List[Any]) -> List[Tuple[Any, Any]]:\n    \"\"\"Returns a list of all pairs of consecutive items from the input list.\n    Raises TypeError if the input is not a list, and returns an empty list for lists with fewer than two elements.\"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    if len(input_list) < 2:\n        return []\n\n    result: List[Tuple[Any, Any]] = []\n    for i in range(len(input_list) - 1):\n        result.append((input_list[i], input_list[i+1]))\n    return result"}
{"task_id": "Mbpp/765", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    pass\ndef _is_power_of_two(num: int) -> bool:\n    \"\"\"Checks if a number is a power of two.\"\"\"\n    if num <= 0:\n        return False\n    return (num & (num - 1)) == 0\ndef is_polite(n: int) -> int:\n    \"\"\"\n    Finds the Nth polite number.\n    Raises InvalidInputError if n is not a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise InvalidInputError(\"Input 'n' must be a positive integer.\")\n\n    polite_count = 0\n    current_num = 1\n    while True:\n        if not _is_power_of_two(current_num):\n            polite_count += 1\n            if polite_count == n:\n                return current_num\n        current_num += 1"}
{"task_id": "Mbpp/765", "solution": "def is_polite(n: int) -> int:\n    \"\"\"\n    Finds the nth polite number.\n    A polite number is a positive integer that is not a power of two.\n\n    Args:\n        n: The index of the polite number to find (1-based).\n\n    Returns:\n        The nth polite number.\n\n    Raises:\n        ValueError: If n is not a positive integer.\n    \"\"\"\n    def _is_power_of_two(num: int) -> bool:\n        \"\"\"Checks if a positive integer is a power of two.\"\"\"\n        return num > 0 and (num & (num - 1) == 0)\n\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer.\")\n\n    count = 0\n    num = 1\n    while True:\n        if not _is_power_of_two(num):\n            count += 1\n            if count == n:\n                return num\n        num += 1"}
{"task_id": "Mbpp/767", "solution": "class InvalidInputError(TypeError):\n    \"\"\"Custom exception for invalid input parameters.\n    It provides specific messages for validation failures.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef get_pairs_count(numbers: list[int], sum: int) -> int:\n    \"\"\"Counts pairs in a list that sum up to a target value.\n    It raises InvalidInputError for invalid input types or values.\"\"\"\n\n    # Validate inputs as per design specifications.\n    if not isinstance(numbers, list):\n        raise InvalidInputError(\"Input 'numbers' must be a list.\")\n    if not all(isinstance(num, int) for num in numbers):\n        raise InvalidInputError(\"All elements in 'numbers' must be integers.\")\n    if not isinstance(sum, int):\n        raise InvalidInputError(\"Input 'sum' must be an integer.\")\n\n    count = 0\n    n = len(numbers)\n    # Iterate through all distinct pairs of indices (i, j) where i < j.\n    for i in range(n):\n        for j in range(i + 1, n):\n            if numbers[i] + numbers[j] == sum:\n                count += 1\n    return count"}
{"task_id": "Mbpp/767", "solution": "from collections import defaultdict\ndef get_pairs_count(numbers: list[int], target_sum: int) -> int:\n    \"\"\"Counts pairs in `numbers` that sum to `target_sum`, treating each element by index as distinct.\"\"\"\n    count = 0\n    # Use a dictionary to store frequencies of numbers encountered so far, for O(1) lookup for the complement.\n    freq_map = defaultdict(int)\n\n    for num in numbers:\n        complement = target_sum - num\n        # If complement is in map, add its frequency to count, then update current number's frequency.\n        count += freq_map[complement]\n        freq_map[num] += 1\n    return count"}
{"task_id": "Mbpp/769", "solution": "def Diff(list1: list, list2: list) -> list:\n    \"\"\"\n    Calculates the difference between two lists (elements in list1 but not in list2).\n    For efficiency, list2 is converted to a set for O(1) average lookup time.\n    \"\"\"\n    set2 = set(list2)\n    result = [item for item in list1 if item not in set2]\n    return result"}
{"task_id": "Mbpp/770", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    pass\ndef odd_num_sum(n: int) -> int:\n    \"\"\"Calculates the sum of the fourth power of the first n odd natural numbers.\n    Raises InvalidInputError if n is not a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise InvalidInputError(\"Input 'n' must be a positive integer.\")\n\n    total_sum = 0\n    for i in range(1, n + 1):\n        odd_number = (2 * i) - 1\n        total_sum += odd_number ** 4\n    return total_sum"}
{"task_id": "Mbpp/769", "solution": "def Diff(list1: list, list2: list) -> list:\n    \"\"\"\n    Computes the difference between two lists, returning elements present in list1 but not in list2.\n    The order of elements from list1 is preserved in the result.\n    \"\"\"\n    if not isinstance(list1, list) or not isinstance(list2, list):\n        raise TypeError(\"Both arguments must be lists.\")\n\n    set2 = set(list2)\n    result = []\n    for item in list1:\n        if item not in set2:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the fourth power of the first n odd natural numbers.\n    Raises ValueError if n is not a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer.\")\n\n    total_sum = 0\n    for i in range(1, n + 1):\n        odd_number = 2 * i - 1\n        total_sum += odd_number ** 4\n    return total_sum"}
{"task_id": "Mbpp/771", "solution": "class InvalidExpressionError(Exception):\n    \"\"\"Custom exception for invalid expression input.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef check_expression(expression: str) -> bool:\n    \"\"\"\n    Checks if a string expression has balanced parentheses, brackets, and braces.\n    Raises InvalidExpressionError if input is not a string.\n    \"\"\"\n    OPENING_DELIMITERS = \"([{\"\n    CLOSING_DELIMITERS = \")]}\"\n    DELIMITER_MAP = {\n        \"(\": \")\",\n        \"[\": \"]\",\n        \"{\": \"}\"\n    }\n\n    if not isinstance(expression, str):\n        raise InvalidExpressionError(\"Input must be a string.\")\n\n    stack = []\n    for char in expression:\n        if char in OPENING_DELIMITERS:\n            stack.append(char)\n        elif char in CLOSING_DELIMITERS:\n            # If stack is empty or the last opening delimiter doesn't match, it's unbalanced.\n            if not stack or DELIMITER_MAP.get(stack[-1]) != char:\n                return False\n            stack.pop() # A matching opening delimiter is found and removed.\n    \n    # The expression is balanced if the stack is empty after processing all characters.\n    return not stack"}
{"task_id": "Mbpp/771", "solution": "def check_expression(expression: str) -> bool:\n    \"\"\"Checks if the delimiters in the given expression are balanced.\n    It uses a stack to track opening delimiters and validates closing ones.\n    \"\"\"\n    delimiter_map = {\n        '(': ')',\n        '{': '}',\n        '[': ']'\n    }\n    opening_delimiters = set(delimiter_map.keys())\n    closing_delimiters = set(delimiter_map.values())\n\n    stack = []\n    for char in expression:\n        if char in opening_delimiters:\n            stack.append(char)\n        elif char in closing_delimiters:\n            if not stack:\n                return False # No opening delimiter found for this closing one.\n            \n            last_opening = stack.pop()\n            if delimiter_map[last_opening] != char:\n                return False # Mismatched closing delimiter.\n        # Characters not in opening_delimiters or closing_delimiters are ignored.\n\n    return not stack # Expression is balanced if the stack is empty at the end."}
{"task_id": "Mbpp/772", "solution": "def remove_length(input_string: str, k: int) -> str:\n    \"\"\"Removes all words of a specific length 'k' from the given string.\n    Raises ValueError if 'k' is negative, and TypeError for incorrect input types.\"\"\"\n\n    if not isinstance(input_string, str):\n        raise TypeError(\"input_string must be a string.\")\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an integer.\")\n\n    if k < 0:\n        raise ValueError(\"k cannot be negative.\")\n\n    # Split the input string into words based on whitespace.\n    words = input_string.split()\n\n    # Filter out words whose length is equal to 'k'.\n    filtered_words = [word for word in words if len(word) != k]\n\n    # Join the remaining words back into a single string with single spaces.\n    return \" \".join(filtered_words)"}
{"task_id": "Mbpp/772", "solution": "def remove_length(text: str, k: int) -> str:\n    \"\"\"Removes all words of a specified length k from the input text.\n    Words are delimited by whitespace, and punctuation is considered part of the word length.\"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input 'text' must be a string.\")\n    if not isinstance(k, int):\n        raise TypeError(\"Input 'k' must be an integer.\")\n    if k <= 0:\n        raise ValueError(\"Length 'k' must be a positive integer.\")\n\n    words = text.split()\n    filtered_words = [word for word in words if len(word) != k]\n    return \" \".join(filtered_words)"}
{"task_id": "Mbpp/775", "solution": "def odd_position(data_list: list[int]) -> bool:\n    \"\"\"\n    Checks if every element at an odd index in the list is an odd number.\n    Returns True if all odd-indexed elements are odd, False otherwise.\n    \"\"\"\n    for i in range(len(data_list)):\n        # If the index is odd and the element at that index is even, return False.\n        if (i % 2 != 0) and (data_list[i] % 2 == 0):\n            return False\n    return True"}
{"task_id": "Mbpp/775", "solution": "def odd_position(data_list: list[int]) -> bool:\n    \"\"\"\n    Checks if every number at an odd index in the given list is an odd number.\n    Returns True for empty lists or lists with no odd indices.\n    \"\"\"\n    for i in range(1, len(data_list), 2):  # Iterate through odd indices (1, 3, 5, ...)\n        if data_list[i] % 2 == 0:  # Check if the element at the odd index is even\n            return False\n    return True"}
{"task_id": "Mbpp/773", "solution": "class SubstringSearchResult:\n    \"\"\"A data transfer object to hold the result of a substring search.\"\"\"\n    def __init__(self, substring: str, start_index: int, end_index: int):\n        self.substring = substring\n        self.start_index = start_index\n        self.end_index = end_index\n\n    def __eq__(self, other):\n        if not isinstance(other, SubstringSearchResult):\n            return NotImplemented\n        return (self.substring == other.substring and\n                self.start_index == other.start_index and\n                self.end_index == other.end_index)\n\n    def __repr__(self):\n        return f\"SubstringSearchResult(substring='{self.substring}', start_index={self.start_index}, end_index={self.end_index})\"\nclass StringSearchService:\n    \"\"\"Encapsulates the core logic for performing substring searches.\"\"\"\n    @staticmethod\n    def search(main_string: str, sub_string: str) -> SubstringSearchResult | None:\n        \"\"\"Implements the algorithm to find the first occurrence of `sub_string` in `main_string`.\"\"\"\n        if not main_string or not sub_string:\n            return None\n        \n        start_index = main_string.find(sub_string)\n        if start_index != -1:\n            end_index = start_index + len(sub_string)\n            return SubstringSearchResult(sub_string, start_index, end_index)\n        return None\nclass SubstringSearcher:\n    \"\"\"Provides the public interface for finding substring occurrences.\"\"\"\n    @staticmethod\n    def find_first_occurrence(main_string: str, sub_string: str) -> tuple[str, int, int] | None:\n        \"\"\"Searches for the first occurrence of `sub_string` within `main_string`.\"\"\"\n        result = StringSearchService.search(main_string, sub_string)\n        if result:\n            return (result.substring, result.start_index, result.end_index)\n        return None\ndef occurance_substring(main_string: str, sub_string: str) -> tuple[str, int, int] | None:\n    \"\"\"Finds the first occurrence of a substring within a main string.\"\"\"\n    return SubstringSearcher.find_first_occurrence(main_string, sub_string)"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(text: str, substring: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Finds the first occurrence of a substring within a text string.\n    Returns a tuple (substring, start_index, end_index) if found, otherwise None.\n    \"\"\"\n    if not text or not substring:\n        raise ValueError(\"Text and substring cannot be empty.\")\n\n    index = text.find(substring)\n\n    if index == -1:\n        return None\n    else:\n        end_index = index + len(substring)\n        return (substring, index, end_index)"}
{"task_id": "Mbpp/777", "solution": "from collections import Counter\nfrom typing import List, Union\nclass InvalidInputError(TypeError):\n    \"\"\"Custom exception for signaling invalid input conditions.\"\"\"\n    pass\nclass InputValidator:\n    \"\"\"Provides methods for validating input data structures and types.\"\"\"\n    def validate_list_of_numbers(self, data_list: List) -> None:\n        \"\"\"Validates if the input is a list and all its elements are numeric.\"\"\"\n        if not isinstance(data_list, list):\n            raise InvalidInputError(\"Input must be a list.\")\n        for item in data_list:\n            if not isinstance(item, (int, float)):\n                raise InvalidInputError(\"All elements in the list must be numbers (int or float).\")\nclass UniqueSumCalculator:\n    \"\"\"Encapsulates the core business logic for identifying non-repeated elements and calculating their sum.\"\"\"\n    def __init__(self, validator: InputValidator):\n        self.validator = validator\n\n    def calculate(self, data_list: List) -> Union[int, float]:\n        \"\"\"Calculates the sum of non-repeated elements in the given list.\"\"\"\n        self.validator.validate_list_of_numbers(data_list)\n\n        counts = Counter(data_list)\n        unique_sum = 0\n        for element, count in counts.items():\n            if count == 1:\n                unique_sum += element\n        return unique_sum\ndef find_sum(data_list: List) -> Union[int, float]:\n    \"\"\"\n    Calculates the sum of non-repeated elements in a given list.\n    It identifies elements appearing exactly once and sums them.\n    \"\"\"\n    validator = InputValidator()\n    calculator = UniqueSumCalculator(validator)\n    return calculator.calculate(data_list)"}
{"task_id": "Mbpp/777", "solution": "from collections import Counter\ndef find_sum(input_list: list[int]) -> int:\n    \"\"\"\n    Calculates the sum of elements that appear exactly once in the input_list.\n    Raises TypeError if input_list is not a list or contains non-integer elements.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n    \n    for item in input_list:\n        if not isinstance(item, int):\n            raise TypeError(f\"List elements must be integers, found: {type(item).__name__}\")\n\n    counts = Counter(input_list)\n    sum_non_repeated = 0\n    for element, count in counts.items():\n        if count == 1:\n            sum_non_repeated += element\n    return sum_non_repeated"}
{"task_id": "Mbpp/778", "solution": "from typing import List, Any\ndef pack_consecutive_duplicates(data_list: list) -> List[List[Any]]:\n    \"\"\"\n    Packs consecutive duplicate elements of a list into sublists.\n    Raises TypeError if input is not a list.\n    \"\"\"\n    if not isinstance(data_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    if not data_list:\n        return []\n\n    packed_list: List[List[Any]] = []\n    current_group: List[Any] = []\n\n    for item in data_list:\n        if not current_group or item == current_group[0]:\n            current_group.append(item)\n        else:\n            packed_list.append(current_group)\n            current_group = [item]\n    \n    if current_group:\n        packed_list.append(current_group)\n\n    return packed_list"}
{"task_id": "Mbpp/778", "solution": "from typing import Any, List\ndef pack_consecutive_duplicates(input_list: List[Any]) -> List[List[Any]]:\n    \"\"\"\n    Groups identical, consecutive elements within a list into sublists.\n    It returns a new list where each sublist contains these grouped elements.\n    \"\"\"\n    if not input_list:\n        return []\n\n    packed_list: List[List[Any]] = []\n    current_sublist: List[Any] = []\n\n    for item in input_list:\n        if not current_sublist or item == current_sublist[-1]:\n            current_sublist.append(item)\n        else:\n            packed_list.append(current_sublist)\n            current_sublist = [item]\n    \n    # Add the last accumulated sublist after the loop finishes.\n    if current_sublist:\n        packed_list.append(current_sublist)\n\n    return packed_list"}
