{"task_id": "Mbpp/564", "solution": "from collections import Counter\ndef count_Pairs(numbers: list[int]) -> int:\n    \"\"\"\n    Calculates the number of unordered pairs (a, b) from `numbers` where `a != b`.\n    This is done by finding total combinations and subtracting pairs of identical elements.\n    \"\"\"\n    n = len(numbers)\n    if n < 2:\n        return 0\n\n    total_possible_pairs = n * (n - 1) // 2 # Calculate total possible pairs (n choose 2).\n\n    counts = Counter(numbers) # Count frequencies of each number.\n\n    invalid_equal_pairs = 0 # Subtract pairs formed by identical elements.\n    for count in counts.values(): # For each number 'x' appearing 'k' times, k * (k - 1) // 2 pairs of (x,x) exist.\n        if count >= 2:\n            invalid_equal_pairs += count * (count - 1) // 2\n\n    return total_possible_pairs - invalid_equal_pairs"}
{"task_id": "Mbpp/564", "solution": "from collections import Counter\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input data.\n    It stores a descriptive error message.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef count_Pairs(data: list[int]) -> int:\n    \"\"\"Counts unequal unordered pairs in a list of integers.\n    Raises InvalidInputError for non-list or non-integer inputs.\"\"\"\n    if not isinstance(data, list):\n        raise InvalidInputError(\"Input must be a list.\")\n    if not all(isinstance(x, int) for x in data):\n        raise InvalidInputError(\"All elements in the list must be integers.\")\n\n    n = len(data)\n    if n < 2:\n        return 0\n\n    # Calculate total possible unordered pairs.\n    total_possible_pairs = n * (n - 1) // 2\n\n    # Count occurrences and sum pairs of equal elements.\n    counts = Counter(data)\n    equal_pairs = 0\n    for count in counts.values():\n        if count >= 2:\n            equal_pairs += count * (count - 1) // 2\n\n    return total_possible_pairs - equal_pairs"}
{"task_id": "Mbpp/566", "solution": "def sum_digits(number: int) -> int:\n    \"\"\"Calculates the sum of the digits of a non-negative integer.\n    Raises TypeError for non-integers and ValueError for negative integers.\n    \"\"\"\n    if not isinstance(number, int):\n        raise TypeError(\"Input must be an integer.\")\n    if number < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n    \n    if number == 0:\n        return 0\n    \n    total_sum = 0\n    for digit_char in str(number):\n        total_sum += int(digit_char)\n    \n    return total_sum"}
{"task_id": "Mbpp/566", "solution": "def sum_digits(number: int) -> int:\n    \"\"\"\n    Calculates the sum of the digits of a non-negative integer.\n    Raises ValueError if the input is not an integer or is negative.\n    \"\"\"\n    if not isinstance(number, int):\n        raise ValueError(\"Input must be an integer.\")\n    if number < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n    \n    total_sum = 0\n    for digit_char in str(number):\n        total_sum += int(digit_char)\n    return total_sum"}
{"task_id": "Mbpp/567", "solution": "def issort_list(data: list) -> bool:\n    \"\"\"Checks if a list is sorted in ascending order.\n    Returns True if sorted, False otherwise.\n    \"\"\"\n    if not data or len(data) == 1:\n        return True\n\n    for i in range(len(data) - 1):\n        if data[i] > data[i+1]:\n            return False\n    return True"}
{"task_id": "Mbpp/567", "solution": "def issort_list(input_list: list) -> bool:\n    \"\"\"\n    Checks if a list is sorted in non-decreasing (ascending) order.\n    Returns True if sorted, False otherwise.\n    \"\"\"\n    if len(input_list) <= 1:\n        return True\n    for i in range(len(input_list) - 1):\n        if input_list[i] > input_list[i+1]:\n            return False\n    return True"}
{"task_id": "Mbpp/568", "solution": "def empty_list(N: int) -> list[dict]:\n    \"\"\"\n    Creates a list of N distinct empty dictionaries.\n    Raises ValueError if N is negative, TypeError if N is not an integer.\n    \"\"\"\n    if not isinstance(N, int):\n        raise TypeError(\"N must be an integer.\")\n    if N < 0:\n        raise ValueError(\"N cannot be negative.\")\n    return [{} for _ in range(N)]"}
{"task_id": "Mbpp/568", "solution": "from typing import List, Dict\ndef empty_list(N: int) -> List[Dict]:\n    \"\"\"\n    Creates a list of N distinct empty dictionaries.\n    Handles invalid N gracefully.\n    \"\"\"\n    if not isinstance(N, int):\n        raise TypeError(\"N must be an integer.\")\n    \n    if N < 0:\n        return []\n        \n    return [{} for _ in range(N)]"}
{"task_id": "Mbpp/569", "solution": "from typing import List\ndef sort_sublists(data: List[List[str]]) -> List[List[str]]:\n    \"\"\"\n    Sorts each sublist of strings in a given list of lists alphabetically.\n    Returns a new list of lists with each sublist sorted.\n    \"\"\"\n    if not isinstance(data, list):\n        raise TypeError(\"Input 'data' must be a list.\")\n\n    sorted_data = []\n    for sublist in data:\n        if not isinstance(sublist, list):\n            raise TypeError(\"Elements of 'data' must be lists.\")\n        \n        # Ensure all elements in sublist are strings before sorting.\n        for item in sublist:\n            if not isinstance(item, str):\n                raise TypeError(\"Elements within sublists must be strings.\")\n\n        sorted_sublist = sorted(sublist)\n        sorted_data.append(sorted_sublist)\n    return sorted_data"}
{"task_id": "Mbpp/569", "solution": "def sort_sublists(list_of_lists: list[list[str]]) -> list[list[str]]:\n    \"\"\"\n    Sorts each sublist of strings in a given list of lists.\n\n    Args:\n        list_of_lists: A list of lists, where each inner list contains strings.\n\n    Returns:\n        A new list of lists with each sublist sorted in ascending lexicographical order.\n        The original input list of lists remains unchanged.\n    \"\"\"\n    return [sorted(sublist) for sublist in list_of_lists]"}
{"task_id": "Mbpp/572", "solution": "from collections import Counter\ndef two_unique_nums(numbers: list[int | float]) -> list[int | float]:\n    \"\"\"\n    Filters a list of numbers, returning a new list containing only those that appear exactly once,\n    preserving their original order. Raises TypeError for non-list input or ValueError for non-numeric elements.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n\n    for num in numbers:\n        if not isinstance(num, (int, float)):\n            raise ValueError(\"List elements must be numbers (int or float).\")\n\n    counts = Counter(numbers)\n    unique_elements = [num for num in numbers if counts[num] == 1]\n    return unique_elements"}
{"task_id": "Mbpp/572", "solution": "from collections import Counter\ndef two_unique_nums(numbers: list[int]) -> list[int]:\n    \"\"\"\n    Identifies and returns numbers that appear exactly once in a given list of integers.\n    Raises TypeError if the input is not a list or contains non-integer elements.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n    if not all(isinstance(n, int) for n in numbers):\n        raise TypeError(\"All elements in the list must be integers.\")\n\n    counts = Counter(numbers)\n    # Filter elements that appear exactly once, preserving their original order.\n    unique_numbers = [num for num in numbers if counts[num] == 1]\n    return unique_numbers"}
{"task_id": "Mbpp/573", "solution": "from typing import List, Union\ndef unique_product(numbers: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"Calculates the product of unique numbers in a list.\n    Raises TypeError for non-list input or non-numeric elements within.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list of numbers.\")\n\n    if not numbers:\n        return 1\n\n    unique_elements = set()\n    for num in numbers:\n        if not isinstance(num, (int, float)):\n            raise TypeError(\"All elements in the list must be numbers (int or float).\")\n        unique_elements.add(num)\n\n    product: Union[int, float] = 1\n    for unique_num in unique_elements:\n        product *= unique_num\n\n    return product"}
