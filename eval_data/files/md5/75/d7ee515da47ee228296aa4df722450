{"task_id": "Mbpp/103", "solution": "import math\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters in Eulerian number calculation.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Calculates the Eulerian number A(n, m).\n    Raises InvalidInputError for invalid inputs according to the specification.\n    \"\"\"\n    if not isinstance(n, int) or not isinstance(m, int):\n        raise InvalidInputError(\"Inputs n and m must be integers.\")\n    if n < 0 or m < 0:\n        raise InvalidInputError(\"Inputs n and m must be non-negative.\")\n    if m >= n:\n        raise InvalidInputError(\"Input m must be strictly less than n (m < n).\")\n\n    # Base cases for A(n, m) = 1\n    if m == 0 or m == n - 1:\n        return 1\n\n    # Define _combinations as a local helper, as per design's intent for a utility function.\n    def _combinations(N: int, K: int) -> int:\n        \"\"\"Calculates binomial coefficient C(N, K) using math.comb.\"\"\"\n        if K < 0 or K > N:\n            return 0\n        return math.comb(N, K)\n\n    eulerian_sum = 0\n    for k in range(m + 1):\n        term = ((-1)**k) * \\\n               _combinations(n + 1, k) * \\\n               ((m + 1 - k)**n)\n        eulerian_sum += term\n    return eulerian_sum"}
{"task_id": "Mbpp/104", "solution": "from typing import List\ndef sort_sublists(data: List[List[str]]) -> List[List[str]]:\n    \"\"\"\n    Sorts each sublist of strings in a given list of lists alphabetically.\n    Returns a new list of lists where each sublist is sorted alphabetically; the original input is not modified.\n    \"\"\"\n    if not isinstance(data, list):\n        raise TypeError(\"Input 'data' must be a list.\")\n\n    sorted_data = []\n    for sublist in data:\n        if not isinstance(sublist, list):\n            raise TypeError(\"All elements in 'data' must be lists.\")\n        \n        # Ensure all elements within the sublist are strings before sorting.\n        for item in sublist:\n            if not isinstance(item, str):\n                raise TypeError(\"All elements within sublists must be strings.\")\n        \n        sorted_data.append(sorted(sublist))\n    return sorted_data"}
