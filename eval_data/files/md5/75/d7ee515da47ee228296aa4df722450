{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(num1: int, num2: int) -> bool:\n    \"\"\"\n    Checks if two integers differ by exactly one bit position.\n    Raises TypeError if inputs are not integers.\n    \"\"\"\n    if not isinstance(num1, int) or not isinstance(num2, int):\n        raise TypeError(\"Both arguments must be integers.\")\n\n    xor_result = num1 ^ num2\n    # A number is a power of 2 if it's positive and has only one bit set.\n    return xor_result > 0 and (xor_result & (xor_result - 1)) == 0"}
{"task_id": "Mbpp/2", "solution": "def similar_elements(list1: list, list2: list) -> list:\n    \"\"\"\n    Finds and returns a list of elements common to both list1 and list2.\n    Duplicates in input lists result in a single occurrence in the output.\n    \"\"\"\n    set1 = set(list1)\n    set2 = set(list2)\n    return list(set1.intersection(set2))"}
{"task_id": "Mbpp/2", "solution": "def similar_elements(list1: list, list2: list) -> list:\n    \"\"\"\n    Finds unique elements common to both input lists.\n    It leverages sets for efficient intersection finding.\n    \"\"\"\n    set1 = set(list1)\n    set2 = set(list2)\n    shared_elements_set = set1.intersection(set2)\n    return list(shared_elements_set)"}
{"task_id": "Mbpp/3", "solution": "import math\ndef is_not_prime(number: int) -> bool:\n    \"\"\"\n    Determines if a given positive integer is a non-prime number.\n    Raises ValueError if the input is not a positive integer.\n    \"\"\"\n    if not isinstance(number, int) or number <= 0:\n        raise ValueError(\"Input must be a positive integer.\")\n\n    if number == 1:\n        return True  # 1 is considered non-prime for this function.\n    if number == 2:\n        return False # 2 is the smallest prime number.\n    if number % 2 == 0:\n        return True  # All other even numbers are non-prime.\n\n    # Check for odd divisors from 3 up to the square root of the number.\n    for i in range(3, int(math.sqrt(number)) + 1, 2):\n        if number % i == 0:\n            return True\n    return False"}
{"task_id": "Mbpp/6", "solution": "def differ_At_One_Bit_Pos(num1: int, num2: int) -> bool:\n    \"\"\"Checks if two non-negative integers differ by exactly one bit position.\n    Raises ValueError if inputs are not non-negative integers.\n    \"\"\"\n    if not isinstance(num1, int) or not isinstance(num2, int):\n        raise ValueError(\"Inputs must be integers.\")\n    if num1 < 0 or num2 < 0:\n        raise ValueError(\"Inputs must be non-negative integers.\")\n\n    xor_result = num1 ^ num2\n\n    # Check if xor_result is a power of two (inlined helper logic)\n    if xor_result <= 0:\n        return False\n    return (xor_result & (xor_result - 1)) == 0"}
{"task_id": "Mbpp/4", "solution": "import heapq\nfrom typing import List\nclass InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef heap_queue_largest(numbers: List[int], n: int) -> List[int]:\n    \"\"\"\n    Finds the n largest integers from a list, returned in descending order.\n    Handles various edge cases like empty lists, n <= 0, and n >= list length.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise InvalidInputError(\"numbers must be a list.\")\n    if not all(isinstance(item, int) for item in numbers):\n        raise InvalidInputError(\"All elements in numbers must be integers.\")\n\n    if not isinstance(n, int):\n        raise InvalidInputError(\"n must be an integer.\")\n\n    # Return empty list if n is non-positive or input list is empty.\n    if n <= 0 or not numbers:\n        return []\n\n    # If n is larger than or equal to the list length, return all elements sorted descending.\n    if n >= len(numbers):\n        return sorted(numbers, reverse=True)\n\n    # Use heapq.nlargest for efficient retrieval of the n largest elements.\n    # heapq.nlargest naturally returns elements in descending order.\n    return heapq.nlargest(n, numbers)"}
{"task_id": "Mbpp/4", "solution": "import heapq\nfrom typing import List, Union\nclass LargestNumbersService:\n    \"\"\"Service to find the n largest numbers from a list.\"\"\"\n\n    def find_largest(self, numbers: List[Union[int, float]], n: int) -> List[Union[int, float]]:\n        \"\"\"\n        Finds the n largest numbers from a list, returned in descending order.\n        It uses validation functions and heapq.nlargest for efficiency.\n        \"\"\"\n        validate_list_and_n(numbers, n)\n        validate_numeric_list(numbers)\n\n        if n == 0 or not numbers:\n            return []\n\n        return heapq.nlargest(n, numbers)\ndef heap_queue_largest(numbers: List[Union[int, float]], n: int) -> List[Union[int, float]]:\n    \"\"\"\n    Finds the n largest numbers from a list, returned in descending order.\n    This function serves as the public entry point to the service logic.\n    \"\"\"\n    service = LargestNumbersService()\n    return service.find_largest(numbers, n)"}
{"task_id": "Mbpp/7", "solution": "import re\ndef find_char_long(text: str) -> set[str]:\n    \"\"\"Extracts words from text that are at least 4 characters long.\n    Words are sequences of alphanumeric characters, preserving original case.\"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input 'text' must be a string.\")\n\n    # Tokenize the text by finding sequences of alphanumeric characters.\n    words = re.findall(r'\\b[a-zA-Z0-9]+\\b', text)\n    \n    # Filter the tokenized words, keeping only those at least 4 characters long.\n    long_words = {word for word in words if len(word) >= 4}\n    return long_words"}
{"task_id": "Mbpp/8", "solution": "def square_nums(numbers: list[int | float]) -> list[int | float]:\n    \"\"\"\n    Calculates the square of each number in the input list.\n    Returns a new list containing the squared values, raising TypeError for invalid inputs.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n\n    squared_list = []\n    for num in numbers:\n        if not isinstance(num, (int, float)):\n            raise TypeError(\"All elements in the list must be numbers.\")\n        squared_list.append(num * num)\n    return squared_list"}
{"task_id": "Mbpp/3", "solution": "import math\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for signaling invalid input conditions.\n    It carries a descriptive error message.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef is_not_prime(number: int) -> bool:\n    \"\"\"\n    Determines if the given number is a non-prime number.\n    Raises InvalidInputError if number is not a positive integer.\n    \"\"\"\n    if not isinstance(number, int) or number <= 0:\n        raise InvalidInputError(\"Input number must be a positive integer.\")\n    if number == 1:\n        return False\n    if number == 2:\n        return False\n    if number % 2 == 0:\n        return True\n\n    # Check for odd divisors from 3 up to the square root of the number.\n    for i in range(3, int(math.sqrt(number)) + 1, 2):\n        if number % i == 0:\n            return True\n    return False"}
{"task_id": "Mbpp/8", "solution": "def square_nums(numbers: list[int | float]) -> list[int | float]:\n    \"\"\"\n    Calculates the square of each number in a list, returning a new list with the results.\n    Raises TypeError for non-list input or non-numeric elements.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n\n    squared_numbers = []\n    for num in numbers:\n        if not isinstance(num, (int, float)):\n            raise TypeError(\"List elements must be numbers (int or float).\")\n        squared_numbers.append(num * num)\n    return squared_numbers"}
{"task_id": "Mbpp/7", "solution": "import re\nfrom typing import Set, List\nMIN_WORD_LENGTH: int = 4\ndef _tokenize(text: str) -> List[str]:\n    \"\"\"\n    Tokenizes the input string into words using a regular expression.\n    Words are sequences of alphanumeric characters.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input must be a string.\")\n    return re.findall(r'\\b[a-zA-Z0-9]+\\b', text.lower())\ndef find_char_long(text: str) -> Set[str]:\n    \"\"\"\n    Identifies and returns all unique words from a string that are\n    at least MIN_WORD_LENGTH characters long.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input must be a string.\")\n\n    raw_words = _tokenize(text)\n    long_words = {word for word in raw_words if len(word) >= MIN_WORD_LENGTH}\n    return long_words"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(input_string: str) -> int:\n    \"\"\"\n    Calculates the minimum rotations (greater than 0) required to restore a string.\n    Handles empty and single-character strings as per requirements.\n    \"\"\"\n    n = len(input_string)\n    if n == 0 or n == 1:\n        return 1\n\n    for k in range(1, n):\n        rotated_s = input_string[k:] + input_string[:k]\n        if rotated_s == input_string:\n            return k\n    \n    # If no smaller rotation works, the string itself is the smallest non-trivial period.\n    return n"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(input_string: str) -> int:\n    \"\"\"\n    Calculates the minimum number of rotations (greater than 0) required for a string\n    to return to its original form. Raises ValueError if the input string is empty.\n    \"\"\"\n    if not input_string:\n        raise ValueError(\"Input string cannot be empty.\")\n\n    n = len(input_string)\n    if n == 1:\n        return 1\n\n    for k in range(1, n):\n        rotated_string = input_string[k:] + input_string[:k]\n        if rotated_string == input_string:\n            return k\n    \n    return n"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string: str, char_to_remove: str) -> str:\n    \"\"\"\n    Removes the first and last occurrences of a given character from the string.\n    Handles type and length validation for the input character.\n    \"\"\"\n    if not isinstance(input_string, str):\n        raise TypeError(\"input_string must be a string.\")\n    if not isinstance(char_to_remove, str):\n        raise TypeError(\"char_to_remove must be a string.\")\n    if len(char_to_remove) != 1:\n        raise ValueError(\"char_to_remove must be a single character string.\")\n\n    first_idx = input_string.find(char_to_remove)\n    if first_idx == -1:\n        return input_string\n\n    last_idx = input_string.rfind(char_to_remove)\n\n    if first_idx == last_idx:\n        return input_string[:first_idx] + input_string[first_idx + 1:]\n    else:\n        # Remove first occurrence\n        temp_string = input_string[:first_idx] + input_string[first_idx + 1:]\n        # Find and remove the last occurrence in the temporary string\n        adjusted_last_idx = temp_string.rfind(char_to_remove)\n        return temp_string[:adjusted_last_idx] + temp_string[adjusted_last_idx + 1:]"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(input_string: str, char_to_remove: str) -> str:\n    \"\"\"Removes the first and last occurrences of a specified character from a string.\n    Raises ValueError if char_to_remove is not a single character.\"\"\"\n    if not isinstance(char_to_remove, str) or len(char_to_remove) != 1:\n        raise ValueError(\"char_to_remove must be a single character string.\")\n\n    first_idx = input_string.find(char_to_remove)\n    last_idx = input_string.rfind(char_to_remove)\n\n    if first_idx == -1:  # Character not found\n        return input_string\n\n    if first_idx == last_idx:  # Only one occurrence\n        return input_string[:first_idx] + input_string[first_idx + 1:]\n    else:\n        # Remove last occurrence first to avoid shifting indices of earlier characters.\n        temp_string = input_string[:last_idx] + input_string[last_idx + 1:]\n        # Remove first occurrence from the modified string.\n        return temp_string[:first_idx] + temp_string[first_idx + 1:]"}
{"task_id": "Mbpp/14", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input parameters.\n    It signifies that one or more input dimensions are not positive numbers.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef find_Volume(base: float, height: float, length: float) -> float:\n    \"\"\"\n    Calculates the volume of a triangular prism.\n    Raises InvalidInputError if any dimension (base, height, or length) is not a positive number.\n    \"\"\"\n    if not all(isinstance(arg, (int, float)) and arg > 0 for arg in [base, height, length]):\n        raise InvalidInputError(\"All dimensions (base, height, length) must be positive numbers.\")\n\n    volume = 0.5 * base * height * length\n    return volume"}
{"task_id": "Mbpp/14", "solution": "def find_Volume(base: float, height: float, length: float) -> float:\n    \"\"\"Calculates the volume of a triangular prism, validating inputs.\n    Raises ValueError if any dimension is not a positive number.\n    \"\"\"\n    if not all(isinstance(dim, (int, float)) and dim > 0 for dim in [base, height, length]):\n        raise ValueError(\"All dimensions (base, height, length) must be positive numbers.\")\n    return 0.5 * base * height * length"}
{"task_id": "Mbpp/12", "solution": "def _calculate_row_sum(row: list[int | float]) -> int | float:\n    \"\"\"Calculates the sum of elements in a single row, validating its contents.\n    Raises TypeError if the row is not a list or contains non-numeric elements.\n    \"\"\"\n    if not isinstance(row, list):\n        raise TypeError(\"Row must be a list.\")\n    for item in row:\n        if not isinstance(item, (int, float)):\n            raise TypeError(\"Row elements must be numbers (int or float).\")\n    return sum(row)\ndef sort_matrix(matrix: list[list[int | float]]) -> list[list[int | float]]:\n    \"\"\"Sorts a matrix (list of lists) in ascending order based on the sum of its rows.\n    Raises TypeError for invalid matrix structure or non-numeric elements.\n    \"\"\"\n    if not isinstance(matrix, list):\n        raise TypeError(\"Input matrix must be a list of lists.\")\n    \n    if not matrix:\n        return []\n\n    row_sums_with_rows = []\n    for i, row in enumerate(matrix):\n        if not isinstance(row, list):\n            raise TypeError(f\"Matrix row at index {i} must be a list.\")\n        try:\n            row_sum = _calculate_row_sum(row)\n            row_sums_with_rows.append((row_sum, row))\n        except TypeError as e:\n            raise TypeError(f\"Error in row {i}: {e}\")\n\n    sorted_rows = sorted(row_sums_with_rows, key=lambda item: item[0])\n\n    return [row for _, row in sorted_rows]"}
{"task_id": "Mbpp/12", "solution": "from typing import List, Union, Any\ndef _calculate_row_sums(matrix: List[List[Union[int, float]]]) -> List[tuple[List[Union[int, float]], Union[int, float]]]:\n    \"\"\"Calculates the sum for each row and pairs it with the original row.\"\"\"\n    rows_with_sums = []\n    for row in matrix:\n        row_sum = sum(row)\n        rows_with_sums.append((row, row_sum))\n    return rows_with_sums\ndef sort_matrix(matrix: List[List[Union[int, float]]]) -> List[List[Union[int, float]]]:\n    \"\"\"Sorts a matrix by the sum of its rows in ascending order.\"\"\"\n    _validate_matrix(matrix)\n\n    if not matrix:\n        return []\n\n    rows_with_sums = _calculate_row_sums(matrix)\n    sorted_rows_with_sums = sorted(rows_with_sums, key=lambda item: item[1])\n\n    sorted_matrix = [row for row, _ in sorted_rows_with_sums]\n    return sorted_matrix"}
{"task_id": "Mbpp/16", "solution": "import re\nLOWERCASE_UNDERSCORE_PATTERN = r\"^[a-z]+(_[a-z]+)*$\"\n_compiled_pattern = re.compile(LOWERCASE_UNDERSCORE_PATTERN)\ndef text_lowercase_underscore(input_string: str) -> bool:\n    \"\"\"\n    Checks if the input string contains sequences of lowercase letters joined by an underscore.\n    Raises TypeError if the input is not a string.\n    \"\"\"\n    if not isinstance(input_string, str):\n        raise TypeError(\"Input must be a string.\")\n    return bool(_compiled_pattern.fullmatch(input_string))"}
