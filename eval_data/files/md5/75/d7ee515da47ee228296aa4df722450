{"task_id": "Mbpp/17", "solution": "from typing import Any\nclass InputValidator:\n    def validate_positive_number(self, value: Any, param_name: str) -> float:\n        \"\"\"\n        Validates if a given value is a non-negative number.\n        Raises TypeError if not numeric, ValueError if negative.\n        \"\"\"\n        if not isinstance(value, (int, float)):\n            raise TypeError(f\"{param_name} must be a number, got {type(value).__name__}\")\n        if value < 0:\n            raise ValueError(f\"{param_name} cannot be negative, got {value}\")\n        return float(value)\nclass Square:\n    def __init__(self, side_length: float):\n        \"\"\"\n        Initializes a Square object with a given side length.\n        The side length is stored privately.\n        \"\"\"\n        self._side_length = side_length\n\n    def get_side_length(self) -> float:\n        \"\"\"\n        Returns the side length of the square.\n        This provides controlled access to the private attribute.\n        \"\"\"\n        return self._side_length\nclass PerimeterCalculator:\n    def calculate(self, square: Square) -> float:\n        \"\"\"\n        Calculates the perimeter of a square instance.\n        Uses the square's side length for computation.\n        \"\"\"\n        return 4 * square.get_side_length()\ndef square_perimeter(side_length: float) -> float:\n    \"\"\"\n    Calculates the perimeter of a square given its side length.\n    It orchestrates input validation, square modeling, and perimeter calculation.\n    \"\"\"\n    validator = InputValidator()\n    validated_side_length = validator.validate_positive_number(side_length, \"side_length\")\n\n    square = Square(validated_side_length)\n    calculator = PerimeterCalculator()\n    return calculator.calculate(square)"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(number: int) -> bool:\n    \"\"\"\n    Checks if the given number is a Woodall number (n * 2^n - 1).\n    Raises ValueError if input is not a positive integer.\n    \"\"\"\n    if not isinstance(number, int) or number <= 0:\n        raise ValueError(\"Input must be a positive integer.\")\n\n    n = 1\n    while True:\n        woodall_n = n * (2**n) - 1\n        if woodall_n == number:\n            return True\n        elif woodall_n > number:\n            return False\n        n += 1"}
{"task_id": "Mbpp/56", "solution": "def _reverse_number(number: int) -> int:\n    \"\"\"Reverses the digits of an integer, preserving its sign.\"\"\"\n    if number == 0:\n        return 0\n    \n    sign = -1 if number < 0 else 1\n    abs_number_str = str(abs(number))\n    reversed_abs_number_str = abs_number_str[::-1]\n    return sign * int(reversed_abs_number_str)\ndef check(number: int) -> bool:\n    \"\"\"\n    Checks if a given number is one less than twice its reverse.\n    Raises TypeError if the input is not an integer.\n    \"\"\"\n    if not isinstance(number, int):\n        raise TypeError(\"Input must be an integer.\")\n            \n    reversed_num = _reverse_number(number)\n    return number == (2 * reversed_num) - 1"}
