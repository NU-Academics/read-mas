{"task_id": "Mbpp/257", "solution": "from typing import Tuple, Union\nclass InvalidInputError(Exception):\n    \"\"\"\n    Custom exception raised when an input argument is of an invalid type.\n    It provides a descriptive error message for the invalid input.\n    \"\"\"\n    def __init__(self, message: str = \"Invalid input provided.\"):\n        self.message = message\n        super().__init__(self.message)\ndef swap_numbers(num1: Union[int, float], num2: Union[int, float]) -> Tuple[Union[int, float], Union[int, float]]:\n    \"\"\"\n    Swaps two numbers and returns them as a tuple in reversed order.\n    Raises InvalidInputError if either num1 or num2 is not a numeric type.\n    \"\"\"\n    if not isinstance(num1, (int, float)) or not isinstance(num2, (int, float)):\n        raise InvalidInputError(\"Invalid input type. Both arguments must be numeric (int or float).\")\n    return (num2, num1)"}
{"task_id": "Mbpp/259", "solution": "from typing import Tuple\ndef maximize_elements(\n    tup1: Tuple[Tuple[int, int], ...],\n    tup2: Tuple[Tuple[int, int], ...]\n) -> Tuple[Tuple[int, int], ...]:\n    \"\"\"\n    Performs element-wise maximization on two tuples of tuples, returning a new result tuple.\n    It rigorously validates input types, lengths, and element structures, raising errors on invalid input.\n    \"\"\"\n    if not isinstance(tup1, tuple) or not isinstance(tup2, tuple):\n        raise TypeError(\"Both inputs must be tuples.\")\n\n    # Input tuples must be non-empty as per FR1 precondition and test case expectation.\n    if not tup1 or not tup2:\n        raise ValueError(\"Input tuples must not be empty.\")\n\n    if len(tup1) != len(tup2):\n        raise ValueError(\"Input tuples must have the same length.\")\n\n    result = []\n    for i in range(len(tup1)):\n        inner_tuple1 = tup1[i]\n        inner_tuple2 = tup2[i]\n\n        if not isinstance(inner_tuple1, tuple) or not isinstance(inner_tuple2, tuple):\n            raise TypeError(f\"Inner elements at index {i} must be tuples.\")\n\n        if len(inner_tuple1) != 2 or len(inner_tuple2) != 2:\n            raise ValueError(f\"Inner tuples at index {i} must contain exactly two elements.\")\n\n        if not all(isinstance(x, int) for x in inner_tuple1) or \\\n           not all(isinstance(x, int) for x in inner_tuple2):\n            raise TypeError(f\"Inner tuple elements at index {i} must be integers.\")\n\n        max_first = max(inner_tuple1[0], inner_tuple2[0])\n        max_second = max(inner_tuple1[1], inner_tuple2[1])\n        result.append((max_first, max_second))\n\n    return tuple(result)"}
{"task_id": "Mbpp/259", "solution": "from typing import Tuple, Any\nclass TupleMaximizerError(Exception):\n    \"\"\"Custom exception for errors during tuple maximization.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef maximize_elements(\n    tuple1: Tuple[Tuple[Any, ...], ...],\n    tuple2: Tuple[Tuple[Any, ...], ...]\n) -> Tuple[Tuple[Any, ...], ...]:\n    \"\"\"\n    Maximizes elements of two input tuples of tuples element-wise.\n    Raises TypeError for invalid input types, TupleMaximizerError for structural mismatches.\n    \"\"\"\n    if not isinstance(tuple1, tuple) or not all(isinstance(t, tuple) for t in tuple1):\n        raise TypeError(\"tuple1 must be a tuple of tuples.\")\n    if not isinstance(tuple2, tuple) or not all(isinstance(t, tuple) for t in tuple2):\n        raise TypeError(\"tuple2 must be a tuple of tuples.\")\n\n    if len(tuple1) != len(tuple2):\n        raise TupleMaximizerError(\"Input tuples must have the same number of inner tuples.\")\n\n    result_outer_tuple = []\n    for i in range(len(tuple1)):\n        inner_tuple1 = tuple1[i]\n        inner_tuple2 = tuple2[i]\n\n        if len(inner_tuple1) != len(inner_tuple2):\n            raise TupleMaximizerError(\n                f\"Inner tuple at index {i} has mismatched lengths: \"\n                f\"{len(inner_tuple1)} vs {len(inner_tuple2)}.\"\n            )\n\n        result_inner_tuple = []\n        for j in range(len(inner_tuple1)):\n            result_inner_tuple.append(max(inner_tuple1[j], inner_tuple2[j]))\n        result_outer_tuple.append(tuple(result_inner_tuple))\n\n    return tuple(result_outer_tuple)"}
{"task_id": "Mbpp/260", "solution": "import math\nimport collections\nclass NSWCalculator:\n    \"\"\"Calculates Newman-Shanks-Williams numbers.\"\"\"\n\n    # Using a cache for performance as NSW numbers can be repeatedly requested for different 'k'.\n    # NFR1: Performance requirement suggests efficiency.\n    _cache = collections.defaultdict(int)\n    _cache[0] = 1\n    _cache[1] = 1\n\n    def get_nsw_number(self, n: int) -> int:\n        \"\"\"Computes the n-th NSW number iteratively using memoization.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n        if n < 0:\n            raise ValueError(\"Input 'n' cannot be negative.\")\n\n        if n in self._cache:\n            return self._cache[n]\n\n        # Calculate iteratively and store in cache\n        # The cache already has S0 and S1\n        s_prev2 = self._cache[0]\n        s_prev1 = self._cache[1]\n\n        for i in range(2, n + 1):\n            if i in self._cache:\n                s_prev2, s_prev1 = self._cache[i-2], self._cache[i-1] # Update for potential gaps\n                continue # Already computed\n\n            current_s = 2 * s_prev1 + s_prev2\n            self._cache[i] = current_s\n            s_prev2 = s_prev1\n            s_prev1 = current_s\n        \n        return self._cache[n]\nclass PrimeChecker:\n    \"\"\"Determines if a given integer is a prime number.\"\"\"\n\n    def is_prime(self, num: int) -> bool:\n        \"\"\"Checks if a number is prime using trial division.\"\"\"\n        if not isinstance(num, int):\n            raise TypeError(\"Input 'num' must be an integer.\")\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n\n        # Check for divisibility by odd numbers up to the square root of num.\n        for i in range(3, int(math.sqrt(num)) + 1, 2):\n            if num % i == 0:\n                return False\n        return True\nclass NSWPrimeFinder:\n    \"\"\"Orchestrates finding the nth Newman-Shanks-Williams prime number.\"\"\"\n\n    def __init__(self, nsw_calculator: NSWCalculator, prime_checker: PrimeChecker):\n        \"\"\"Initializes the finder with NSW calculator and prime checker instances.\"\"\"\n        self._nsw_calculator = nsw_calculator\n        self._prime_checker = prime_checker\n\n    def find_nth_nsw_prime(self, n: int) -> int:\n        \"\"\"Finds the n-th NSW prime number.\"\"\"\n        if not isinstance(n, int):\n            raise TypeError(\"Input 'n' must be an integer.\")\n        if n <= 0:\n            raise ValueError(\"Input 'n' must be a positive integer (1-based index).\")\n\n        found_primes_count = 0\n        k = 0  # Index for NSW numbers S_k\n\n        while True:\n            nsw_number = self._nsw_calculator.get_nsw_number(k)\n            if self._prime_checker.is_prime(nsw_number):\n                found_primes_count += 1\n                if found_primes_count == n:\n                    return nsw_number\n            k += 1\ndef newman_prime(n: int) -> int:\n    \"\"\"\n    Finds the nth Newman-Shanks-Williams prime number.\n    \"\"\"\n    nsw_calculator = NSWCalculator()\n    prime_checker = PrimeChecker()\n    nsw_prime_finder = NSWPrimeFinder(nsw_calculator, prime_checker)\n    return nsw_prime_finder.find_nth_nsw_prime(n)"}
{"task_id": "Mbpp/260", "solution": "import math\nfrom typing import Generator\nclass NoNSWPrimeFoundError(Exception):\n    \"\"\"\n    Custom exception for when the nth NSW prime cannot be found.\n    This may occur if n is too large or a computational limit is reached.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\nclass PrimeChecker:\n    \"\"\"\n    Utility class to check if a number is prime.\n    It uses a basic trial division algorithm for primality testing.\n    \"\"\"\n    def is_prime(self, number: int) -> bool:\n        \"\"\"\n        Checks if the given number is prime using trial division.\n        Raises ValueError if the number is negative.\n        \"\"\"\n        if number < 0:\n            raise ValueError(\"Number must be non-negative.\")\n        if number < 2:\n            return False\n        if number == 2:\n            return True\n        if number % 2 == 0:\n            return False\n        i = 3\n        while i * i <= number:\n            if number % i == 0:\n                return False\n            i += 2\n        return True\nclass NSWCalculator:\n    \"\"\"\n    Generates Newman-Shanks-Williams (NSW) numbers and finds the nth prime among them.\n    It utilizes a PrimeChecker for primality tests.\n    \"\"\"\n    def __init__(self):\n        self._prime_checker = PrimeChecker()\n\n    def _generate_nsw_numbers(self) -> Generator[int, None, None]:\n        \"\"\"\n        A private generator method that yields NSW numbers indefinitely.\n        Starts with S_0 = 1, S_1 = 1, then S_k = 2*S_{k-1} + S_{k-2}.\n        \"\"\"\n        s_prev_prev = 1  # S_0\n        s_prev = 1       # S_1\n        yield s_prev_prev\n        yield s_prev\n        while True:\n            s_current = 2 * s_prev + s_prev_prev\n            yield s_current\n            s_prev_prev = s_prev\n            s_prev = s_current\n\n    def find_nth_nsw_prime(self, n: int) -> int:\n        \"\"\"\n        Calculates and returns the nth NSW prime number.\n        Raises ValueError if n is less than 1, or NoNSWPrimeFoundError if the prime is not found.\n        \"\"\"\n        if n < 1:\n            raise ValueError(\"n must be a positive integer.\")\n\n        nsw_numbers_generator = self._generate_nsw_numbers()\n        prime_count = 0\n        current_nsw_prime = None\n\n        # Skip S_0=1 and S_1=1 as they are not prime\n        next(nsw_numbers_generator) # S_0\n        next(nsw_numbers_generator) # S_1\n\n        for nsw_num in nsw_numbers_generator:\n            if self._prime_checker.is_prime(nsw_num):\n                prime_count += 1\n                if prime_count == n:\n                    current_nsw_prime = nsw_num\n                    break\n            # Add a safety break for extremely large n to prevent infinite loops.\n            # NSW numbers grow very fast, so this prevents unreasonable computation.\n            if nsw_num > 10**18 and n > 10:\n                 raise NoNSWPrimeFoundError(f\"Could not find the {n}th NSW prime within a reasonable limit.\")\n\n        if current_nsw_prime is None:\n            raise NoNSWPrimeFoundError(f\"Could not find the {n}th NSW prime.\")\n\n        return current_nsw_prime\ndef newman_prime(n: int) -> int:\n    \"\"\"\n    Finds the nth Newman-Shanks-Williams prime number.\n    It acts as a facade to the NSWCalculator class.\n    \"\"\"\n    calculator = NSWCalculator()\n    return calculator.find_nth_nsw_prime(n)"}
{"task_id": "Mbpp/261", "solution": "class TupleLengthMismatchError(Exception):\n    \"\"\"Exception raised when two tuples have different lengths for element-wise operations.\"\"\"\n    pass\nclass DivisionByZeroError(Exception):\n    \"\"\"Exception raised when an attempt is made to divide by zero during element-wise operations.\"\"\"\n    pass\ndef division_elements(tuple1: tuple, tuple2: tuple) -> tuple:\n    \"\"\"\n    Performs element-wise division of two tuples.\n    Raises specific exceptions for invalid inputs like type, length, or division by zero.\n    \"\"\"\n    if not isinstance(tuple1, tuple) or not isinstance(tuple2, tuple):\n        raise TypeError(\"Both inputs must be tuples.\")\n\n    if len(tuple1) != len(tuple2):\n        raise TupleLengthMismatchError(\"Tuples must have the same length for element-wise division.\")\n\n    results = []\n    for i in range(len(tuple1)):\n        if not isinstance(tuple1[i], (int, float)) or not isinstance(tuple2[i], (int, float)):\n            raise TypeError(f\"Elements at index {i} must be numeric (int or float).\")\n        if tuple2[i] == 0:\n            raise DivisionByZeroError(f\"Division by zero at index {i}.\")\n        results.append(tuple1[i] / tuple2[i])\n\n    return tuple(results)"}
{"task_id": "Mbpp/262", "solution": "def split_two_parts(input_list: list, L: int) -> tuple[list, list]:\n    \"\"\"Splits a list into two parts, where the first part has length L.\n    Raises ValueError if L is negative.\n    \"\"\"\n    if L < 0:\n        raise ValueError(\"L cannot be negative.\")\n    \n    first_part = input_list[:L]\n    second_part = input_list[L:]\n    return (first_part, second_part)"}
{"task_id": "Mbpp/227", "solution": "from typing import Union\ndef min_of_three(num1: Union[int, float], num2: Union[int, float], num3: Union[int, float]) -> Union[int, float]:\n    \"\"\"\n    Finds the minimum of three given numerical inputs.\n    Raises TypeError if any input is not numeric (int or float).\n    \"\"\"\n    if not all(isinstance(arg, (int, float)) for arg in [num1, num2, num3]):\n        raise TypeError(\"All inputs must be numeric (int or float).\")\n\n    return min(num1, num2, num3)"}
{"task_id": "Mbpp/261", "solution": "from typing import Tuple, Union\ndef division_elements(tuple1: Tuple[Union[int, float], ...], tuple2: Tuple[Union[int, float], ...]) -> Tuple[float, ...]:\n    \"\"\"\n    Performs element-wise division of tuple1 by tuple2.\n    Returns a new tuple containing the quotients as floats.\n    \"\"\"\n    return tuple(float(a) / b for a, b in zip(tuple1, tuple2))"}
{"task_id": "Mbpp/170", "solution": "def sum_range_list(numbers: list[float | int], start_index: int, end_index: int) -> float | int:\n    \"\"\"Calculates the sum of numbers within a specified inclusive range of a list.\n    Handles out-of-bounds indices by clamping and returns 0 for empty ranges.\n    \"\"\"\n    if not numbers:\n        return 0\n\n    # Clamp indices to be within the valid range of the list\n    clamped_start = max(0, min(start_index, len(numbers) - 1))\n    clamped_end = max(0, min(end_index, len(numbers) - 1))\n\n    # If the effective start index is greater than the effective end index, return 0\n    if clamped_start > clamped_end:\n        return 0\n\n    current_sum = 0\n    for i in range(clamped_start, clamped_end + 1):\n        current_sum += numbers[i]\n    return current_sum"}
{"task_id": "Mbpp/233", "solution": "import math\ndef lateralsuface_cylinder(radius: float, height: float) -> float:\n    \"\"\"\n    Calculates the lateral surface area of a cylinder.\n    Raises ValueError if radius or height are non-positive.\n    \"\"\"\n    if radius <= 0 or height <= 0:\n        raise ValueError(\"Radius and height must be positive numbers.\")\n    return 2 * math.pi * radius * height"}
{"task_id": "Mbpp/232", "solution": "from typing import List, Any\ndef larg_nnum(items: List[Any], n: int) -> List[Any]:\n    \"\"\"\n    Returns a new list containing the n largest items from the input list.\n    Handles various edge cases for n and an empty input list.\n    \"\"\"\n    if not isinstance(items, list):\n        raise TypeError(\"Input 'items' must be a list.\")\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n\n    if n <= 0 or not items:\n        return []\n\n    if n >= len(items):\n        return sorted(items, reverse=True)\n\n    sorted_items = sorted(items, reverse=True)\n    return sorted_items[:n]"}
{"task_id": "Mbpp/232", "solution": "from typing import List, Union\ndef larg_nnum(input_list: List[Union[int, float]], n: int) -> List[Union[int, float]]:\n    \"\"\"\n    Identifies and returns the 'n' largest unique numbers from a given list, sorted in descending order.\n    Handles edge cases like empty input lists or non-positive 'n' values.\n    \"\"\"\n    if n <= 0 or not input_list:\n        return []\n\n    # Remove duplicates while preserving original insertion order for unique elements.\n    unique_list = list(dict.fromkeys(input_list))\n\n    # Sort the unique numbers in descending order.\n    sorted_unique_list = sorted(unique_list, reverse=True)\n\n    # Return the first 'n' elements from the sorted unique list.\n    return sorted_unique_list[:n]"}
