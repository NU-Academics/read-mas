{"task_id": "Mbpp/629", "solution": "from typing import List\ndef Split(numbers: List[int]) -> List[int]:\n    \"\"\"\n    Filters a list of integers, returning only the even numbers.\n    Raises TypeError if input is not a list, or ValueError if elements are not integers.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n\n    even_numbers = []\n    for number in numbers:\n        if not isinstance(number, int):\n            raise ValueError(f\"All elements in the list must be integers, found: {type(number)}\")\n        if number % 2 == 0:\n            even_numbers.append(number)\n    return even_numbers"}
{"task_id": "Mbpp/630", "solution": "def get_coordinates(coord: tuple[int, int]) -> list[list[int]]:\n    \"\"\"\n    Extracts all 8 adjacent coordinates (including diagonals) and the original\n    coordinate itself for a given coordinate tuple (x, y). The result includes the\n    original coordinate and all 8 surrounding coordinates.\n    \"\"\"\n    x, y = coord\n    adjacent = []\n    for dx in [-1, 0, 1]:\n        for dy in [-1, 0, 1]:\n            adjacent.append([x + dx, y + dy])\n    return adjacent"}
{"task_id": "Mbpp/631", "solution": "def replace_spaces(input_string: str) -> str:\n    \"\"\"\n    Replaces spaces with underscores, or underscores with spaces, acting as a toggle.\n    Prioritizes replacing spaces if both are present.\n    \"\"\"\n    if not isinstance(input_string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    if ' ' in input_string:\n        return input_string.replace(' ', '_')\n    elif '_' in input_string:\n        return input_string.replace('_', ' ')\n    else:\n        return input_string"}
{"task_id": "Mbpp/630", "solution": "def get_coordinates(point: tuple[int, int]) -> list[list[int]]:\n    \"\"\"\n    Calculates all coordinates in a 3x3 grid centered around the input point.\n    It includes the input point itself, as per the example in the problem statement.\n    \"\"\"\n    x, y = point\n    adjacent_coords = []\n    for dx in [-1, 0, 1]:\n        for dy in [-1, 0, 1]:\n            adjacent_coords.append([x + dx, y + dy])\n    return adjacent_coords"}
{"task_id": "Mbpp/632", "solution": "def move_zero(data_list: list) -> list:\n    \"\"\"\n    Moves all zero elements to the end of the list in-place, preserving the relative order of non-zero elements.\n    Returns the modified list.\n    \"\"\"\n    if not isinstance(data_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    non_zero_ptr = 0\n    # Iterate through the list, copying non-zero elements to the front\n    for i in range(len(data_list)):\n        if data_list[i] != 0:\n            data_list[non_zero_ptr] = data_list[i]\n            non_zero_ptr += 1\n\n    # Fill the remaining positions with zeroes\n    for i in range(non_zero_ptr, len(data_list)):\n        data_list[i] = 0\n        \n    return data_list"}
{"task_id": "Mbpp/632", "solution": "def move_zero(lst: list[int | float]) -> list[int | float]:\n    \"\"\"\n    Moves all zero elements to the end of the given list while maintaining\n    the relative order of non-zero elements.\n\n    Args:\n        lst: The input list of numbers (integers or floats).\n\n    Returns:\n        A new list with all zero elements moved to the end.\n\n    Raises:\n        TypeError: If the input 'lst' is not a list.\n    \"\"\"\n    if not isinstance(lst, list):\n        raise TypeError(\"Input 'lst' must be a list.\")\n\n    non_zero_elements = []\n    zero_count = 0\n\n    for item in lst:\n        if item == 0:\n            zero_count += 1\n        else:\n            non_zero_elements.append(item)\n\n    return non_zero_elements + [0] * zero_count"}
{"task_id": "Mbpp/631", "solution": "import re\ndef replace_spaces(text: str) -> str:\n    \"\"\"\n    Transforms a string by replacing whitespaces with underscores, or underscores with spaces.\n    Prioritizes replacing whitespace if present, otherwise replaces underscores.\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"Input text must be a string.\")\n\n    if re.search(r'\\s', text):\n        # If whitespace is present, replace all whitespace sequences with a single underscore.\n        return re.sub(r'\\s+', '_', text)\n    elif '_' in text:\n        # If no whitespace but underscores are present, replace all underscores with single spaces.\n        return text.replace('_', ' ')\n    else:\n        # If neither condition met, return the original string.\n        return text"}
{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(numbers: list[int], n: int) -> int:\n    \"\"\"\n    Calculates the sum of XOR of all unique pairs in a list of integers.\n    Uses an optimized bit manipulation approach to achieve O(N * log(max_val)) complexity.\n    \"\"\"\n    if not numbers or len(numbers) < 2:\n        return 0\n\n    # The 'n' parameter from the original problem statement is implicitly equal\n    # to len(numbers) as per the example. We use len(numbers) for calculation.\n    n_actual = len(numbers) \n\n    total_xor_sum = 0\n    max_val = max(abs(x) for x in numbers) if numbers else 0\n\n    # Determine the maximum number of bits needed. Python integers handle arbitrary precision.\n    max_bits = max_val.bit_length() if max_val > 0 else 1 \n\n    for i in range(max_bits + 1): # Iterate through each bit position.\n        count_set_bit = 0\n        for num in numbers:\n            if (num >> i) & 1:\n                count_set_bit += 1\n        \n        # For each bit position 'i', count_set_bit * (n_actual - count_set_bit) pairs\n        # will have this bit set in their XOR sum.\n        total_xor_sum += (count_set_bit * (n_actual - count_set_bit)) * (1 << i)\n    \n    return total_xor_sum"}
{"task_id": "Mbpp/633", "solution": "def pair_xor_Sum(numbers, length):\n    \"\"\"\n    Calculates the sum of XOR of all unique pairs in the given list.\n    The `length` parameter indicates the number of elements in the `numbers` list.\n    \"\"\"\n    total_xor_sum = 0\n    # Using len(numbers) for loop bounds as per the core algorithm's design.\n    n = len(numbers)\n    for i in range(n):\n        for j in range(i + 1, n):\n            total_xor_sum += (numbers[i] ^ numbers[j])\n    return total_xor_sum"}
