{"task_id": "Mbpp/63", "solution": "from typing import List, Tuple\ndef max_difference(data: List[Tuple[int, int]]) -> int:\n    \"\"\"\n    Calculates the maximum absolute difference between elements in each tuple within a list.\n    Raises ValueError for invalid input types or structures.\n    \"\"\"\n    if not isinstance(data, list):\n        raise ValueError(\"Input must be a list.\")\n\n    for i, item in enumerate(data):\n        if not isinstance(item, tuple):\n            raise ValueError(f\"Element at index {i} is not a tuple.\")\n        if len(item) != 2:\n            raise ValueError(f\"Tuple at index {i} must contain exactly two elements.\")\n        if not all(isinstance(x, int) for x in item):\n            raise ValueError(f\"Elements in tuple at index {i} must be integers.\")\n\n    if not data:\n        return 0\n\n    max_diff = 0\n    for a, b in data:\n        current_diff = abs(a - b)\n        if current_diff > max_diff:\n            max_diff = current_diff\n    return max_diff"}
{"task_id": "Mbpp/64", "solution": "def subject_marks(data: list[tuple]) -> list[tuple]:\n    \"\"\"\n    Sorts a list of tuples based on their second element in ascending order.\n    Raises TypeError or IndexError for invalid input types or malformed tuples.\n    \"\"\"\n    if not isinstance(data, list):\n        raise TypeError(\"Input 'data' must be a list.\")\n    \n    # This implicitly handles TypeError for non-tuple elements and IndexError for tuples\n    # lacking a second element when accessing 'item[1]'.\n    return sorted(data, key=lambda item: item[1])"}
{"task_id": "Mbpp/65", "solution": "def recursive_list_sum(input_list: list) -> int:\n    \"\"\"\n    Flattens a list and sums all of its integer elements recursively.\n    Raises TypeError if an element is neither an integer nor a list.\n    \"\"\"\n    total_sum = 0\n    for element in input_list:\n        if isinstance(element, int):\n            total_sum += element\n        elif isinstance(element, list):\n            total_sum += recursive_list_sum(element)\n        else:\n            raise TypeError(f\"Unsupported element type: {type(element)}. Only integers and lists are allowed.\")\n    return total_sum"}
{"task_id": "Mbpp/65", "solution": "from typing import List, Union\ndef recursive_list_sum(input_list: List) -> Union[int, float]:\n    \"\"\"Recursively flattens a list and sums all its numerical elements.\n    Raises `TypeError` for invalid input types or non-numeric/non-list elements.\"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    total_sum: Union[int, float] = 0\n    for item in input_list:\n        if isinstance(item, list):\n            total_sum += recursive_list_sum(item)\n        elif isinstance(item, (int, float)):\n            total_sum += item\n        else:\n            raise TypeError(f\"Unsupported element type: {type(item)}. Elements must be numbers or lists.\")\n    return total_sum"}
{"task_id": "Mbpp/64", "solution": "from typing import List, Tuple, Any\ndef subject_marks(data: List[Tuple[Any, ...]]) -> List[Tuple[Any, ...]]:\n    \"\"\"Sorts a list of tuples based on the second element of each tuple in ascending order.\n    It performs comprehensive input validation as specified.\"\"\"\n    if not isinstance(data, list):\n        raise TypeError(\"Input 'data' must be a list.\")\n\n    for i, item in enumerate(data):\n        if not isinstance(item, tuple):\n            raise TypeError(f\"Element at index {i} is not a tuple: {item}\")\n        if len(item) < 2:\n            raise TypeError(f\"Tuple at index {i} has fewer than two elements: {item}\")\n\n    try:\n        return sorted(data, key=lambda x: x[1])\n    except TypeError as e:\n        raise ValueError(f\"Second elements of tuples are not comparable: {e}\") from e"}
{"task_id": "Mbpp/66", "solution": "def pos_count(numbers_list: list[int | float]) -> int:\n    \"\"\"\n    Counts the number of positive numbers in a list.\n    Raises TypeError if input is not a list, or if a non-numeric element cannot be compared.\n    \"\"\"\n    if not isinstance(numbers_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    count = 0\n    for number in numbers_list:\n        if number > 0:\n            count += 1\n    return count"}
{"task_id": "Mbpp/68", "solution": "def is_Monotonic(arr: list[int | float]) -> bool:\n    \"\"\"\n    Checks if a given array is monotonic (either increasing or decreasing).\n    An empty or single-element array is considered monotonic.\n    \"\"\"\n    if len(arr) <= 1:\n        return True\n\n    is_increasing = True\n    is_decreasing = True\n\n    for i in range(len(arr) - 1):\n        if arr[i] > arr[i+1]:\n            is_increasing = False\n        if arr[i] < arr[i+1]:\n            is_decreasing = False\n\n    return is_increasing or is_decreasing"}
{"task_id": "Mbpp/68", "solution": "from typing import List, Union\ndef is_Monotonic(array: List[Union[int, float]]) -> bool:\n    \"\"\"Checks if an array of numbers is monotonic.\n    An array is monotonic if it is either monotonically increasing or decreasing.\n    \"\"\"\n    if not isinstance(array, list):\n        raise TypeError(\"Input must be a list.\")\n    for item in array:\n        if not isinstance(item, (int, float)):\n            raise TypeError(\"All elements in the array must be numbers.\")\n\n    if len(array) <= 1:\n        return True\n\n    # Check if the array is monotonically increasing.\n    is_increasing = True\n    for i in range(len(array) - 1):\n        if array[i] > array[i+1]:\n            is_increasing = False\n            break\n\n    # Check if the array is monotonically decreasing.\n    is_decreasing = True\n    for i in range(len(array) - 1):\n        if array[i] < array[i+1]:\n            is_decreasing = False\n            break\n\n    return is_increasing or is_decreasing"}
