{"task_id": "Mbpp/413", "solution": "class ExtractionError(Exception):\n    \"\"\"Custom exception for errors during data extraction.\n    It carries a descriptive message about the extraction failure.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef extract_nth_element(data_list: list[tuple], n: int) -> list:\n    \"\"\"Extracts the Nth element from each tuple in a given list of tuples.\n    Raises TypeError, ValueError, or ExtractionError for invalid inputs or data.\n    \"\"\"\n    if not isinstance(data_list, list):\n        raise TypeError(\"Input 'data_list' must be a list.\")\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n\n    extracted_elements = []\n    for i, item in enumerate(data_list):\n        if not isinstance(item, tuple):\n            raise TypeError(f\"Element at index {i} in 'data_list' is not a tuple.\")\n        if len(item) <= n:\n            raise ExtractionError(\n                f\"Tuple at index {i} has length {len(item)}, which is too short to extract element at index {n}.\"\n            )\n        extracted_elements.append(item[n])\n    return extracted_elements"}
{"task_id": "Mbpp/414", "solution": "from typing import Iterable, Any\ndef overlapping(sequence1: Iterable[Any], sequence2: Iterable[Any]) -> bool:\n    \"\"\"\n    Checks if any element from the first sequence is present in the second.\n    Optimizes performance by converting the second sequence to a set for efficient lookups.\n    \"\"\"\n    # Convert the second sequence to a set for O(1) average time complexity lookups.\n    set2 = set(sequence2)\n    for item in sequence1:\n        if item in set2:\n            return True\n    return False"}
{"task_id": "Mbpp/413", "solution": "from typing import Any, List, Tuple\ndef extract_nth_element(data: List[Tuple[Any, ...]], n: int) -> List[Any | None]:\n    \"\"\"\n    Extracts the nth element from each tuple in a list of tuples.\n    Returns a new list with extracted elements or None for invalid positions.\n    \"\"\"\n    result = []\n    for item in data:\n        try:\n            if isinstance(item, tuple):\n                result.append(item[n])\n            else:\n                result.append(None)\n        except IndexError:\n            result.append(None)\n        except TypeError:\n            result.append(None)\n    return result"}
{"task_id": "Mbpp/414", "solution": "from typing import Iterable\ndef overlapping(seq1: Iterable, seq2: Iterable) -> bool:\n    \"\"\"Checks if any element from one sequence exists in another. Returns True if a common element is found, False otherwise.\"\"\"\n    if not seq1 or not seq2:\n        return False\n\n    # Convert the smaller sequence to a set for O(1) average time lookups.\n    # This avoids converting the potentially much larger sequence if it's not a set.\n    if len(seq1) <= len(seq2):\n        lookup_set = set(seq1)\n        for item in seq2:\n            if item in lookup_set:\n                return True\n    else:\n        lookup_set = set(seq2)\n        for item in seq1:\n            if item in lookup_set:\n                return True\n    return False"}
{"task_id": "Mbpp/415", "solution": "def max_Product(numbers: list[int]) -> tuple[int, int]:\n    \"\"\"\n    Finds the pair of integers in the input list that yields the maximum product.\n    Returns an empty tuple if the input list has fewer than two elements.\n    \"\"\"\n    if len(numbers) < 2:\n        return ()\n    if len(numbers) == 2:\n        return tuple(sorted(numbers))\n\n    # Initialize with extreme values to find two largest and two smallest numbers\n    max1, max2 = float('-inf'), float('-inf')\n    min1, min2 = float('inf'), float('inf')\n\n    for num in numbers:\n        # Update largest two numbers\n        if num > max1:\n            max2 = max1\n            max1 = num\n        elif num > max2:\n            max2 = num\n\n        # Update smallest two (most negative) numbers\n        if num < min1:\n            min2 = min1\n            min1 = num\n        elif num < min2:\n            min2 = num\n\n    # Calculate products of potential highest pairs\n    product_of_max_positives = max1 * max2\n    product_of_min_negatives = min1 * min2\n\n    # Compare products and return the pair with the highest product, ensuring ascending order.\n    if product_of_max_positives >= product_of_min_negatives:\n        return (max2, max1) if max2 <= max1 else (max1, max2)\n    else:\n        return (min1, min2) if min1 <= min2 else (min2, min1)"}
{"task_id": "Mbpp/415", "solution": "def max_Product(arr: list[int]) -> tuple[int, int]:\n    \"\"\"\n    Finds the pair of integers within a given array that yields the maximum product.\n    Handles positive, negative, zero, and duplicate numbers efficiently.\n    \"\"\"\n    if len(arr) < 2:\n        raise ValueError(\"Input list must contain at least two integers.\")\n\n    # Sort the array to easily identify potential candidates for the maximum product.\n    # The highest product will come from either the two largest numbers or the two smallest (most negative).\n    arr.sort()\n\n    # Calculate product of the two largest numbers.\n    product_largest_positives = arr[-1] * arr[-2]\n    pair_largest_positives = (arr[-2], arr[-1])\n\n    # Calculate product of the two smallest (most negative) numbers.\n    product_smallest_negatives = arr[0] * arr[1]\n    pair_smallest_negatives = (arr[0], arr[1])\n\n    if product_largest_positives >= product_smallest_negatives:\n        return pair_largest_positives\n    else:\n        return pair_smallest_negatives"}
{"task_id": "Mbpp/410", "solution": "from typing import Union\nclass NoNumericValueError(Exception):\n    \"\"\"\n    Custom exception raised when no numeric values are found in a list.\n    \"\"\"\n    def __init__(self, message: str = \"No numeric values found in the list.\"):\n        super().__init__(message)\ndef min_val(data_list: list) -> Union[int, float]:\n    \"\"\"\n    Finds the minimum numeric value in a heterogeneous list.\n\n    Args:\n        data_list: A list containing heterogeneous data types.\n\n    Returns:\n        The minimum numeric value (int or float) found in the list.\n\n    Raises:\n        NoNumericValueError: If no numeric values are present in the list.\n    \"\"\"\n    numeric_values = []\n    for item in data_list:\n        if isinstance(item, (int, float)):\n            numeric_values.append(item)\n\n    if not numeric_values:\n        raise NoNumericValueError()\n\n    return min(numeric_values)"}
{"task_id": "Mbpp/409", "solution": "from typing import List, Tuple, Union\ndef min_product_tuple(data: List[Tuple[Union[int, float], ...]]) -> Union[int, float]:\n    \"\"\"\n    Calculates the minimum product from a list of tuples. The product of an empty tuple is 1.\n    \"\"\"\n    if not isinstance(data, list):\n        raise TypeError(\"Input 'data' must be a list.\")\n    if not data:\n        raise ValueError(\"Input list cannot be empty.\")\n\n    products = []\n    for tup in data:\n        if not isinstance(tup, tuple):\n            raise TypeError(f\"List element '{tup}' is not a tuple.\")\n        \n        current_product = 1\n        if not tup: # Handle empty tuple case, product is 1 as per BR2\n            products.append(1)\n            continue\n\n        for item in tup:\n            if not isinstance(item, (int, float)):\n                raise TypeError(f\"Tuple element '{item}' is not a number.\")\n            current_product *= item\n        products.append(current_product)\n    \n    return min(products)"}
{"task_id": "Mbpp/418", "solution": "from typing import List, Any\ndef Find_Max(input_list: List[List[Any]]) -> List[Any]:\n    \"\"\"Finds the sublist with the maximum length from a list of lists.\n    Raises TypeError if the input is not a list of lists.\"\"\"\n\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list of lists.\")\n    for item in input_list:\n        if not isinstance(item, list):\n            raise TypeError(\"All elements in the input list must be lists.\")\n\n    if not input_list:\n        return []\n\n    max_sublist = []\n    max_length = -1\n\n    for sublist in input_list:\n        if len(sublist) > max_length:\n            max_length = len(sublist)\n            max_sublist = sublist\n    return max_sublist"}
{"task_id": "Mbpp/418", "solution": "class InvalidInputError(TypeError):\n    \"\"\"Custom exception for invalid input to the Find_Max function.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef Find_Max(input_list: list[list[any]]) -> list[any] | None:\n    \"\"\"\n    Finds the sublist with the maximum length from a list of lists.\n    Raises InvalidInputError for invalid input types or structures.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise InvalidInputError(\"Input must be a list.\")\n    \n    for i, item in enumerate(input_list):\n        if not isinstance(item, list):\n            raise InvalidInputError(f\"Element at index {i} is not a list.\")\n\n    if not input_list:\n        return None\n\n    longest_sublist = None\n    max_length = -1\n\n    for sublist in input_list:\n        current_length = len(sublist)\n        if current_length > max_length:\n            max_length = current_length\n            longest_sublist = sublist\n    \n    return longest_sublist"}
{"task_id": "Mbpp/419", "solution": "def round_and_sum(numbers: list[float | int]) -> int:\n    \"\"\"Rounds each number in the list, sums them, and multiplies by the original list's length.\n    Raises TypeError for non-list input or non-numeric elements.\"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n    if not all(isinstance(n, (int, float)) for n in numbers):\n        raise TypeError(\"All elements in the list must be numbers (int or float).\")\n\n    if not numbers:\n        return 0\n\n    rounded_numbers = [round(num) for num in numbers]\n    sum_rounded = sum(rounded_numbers)\n    list_length = len(numbers)\n    final_product = sum_rounded * list_length\n    return final_product"}
