{"task_id": "Mbpp/244", "solution": "import math\ndef next_Perfect_Square(n):\n    \"\"\"\n    Finds the smallest perfect square strictly greater than the given number n.\n    Raises TypeError if n is not an integer, or ValueError if n is negative.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input must be non-negative.\")\n\n    # Calculate the integer part of the square root of n.\n    sqrt_n_int = int(math.sqrt(n))\n\n    # The next perfect square is (sqrt_n_int + 1) squared.\n    next_root = sqrt_n_int + 1\n    return next_root * next_root"}
{"task_id": "Mbpp/244", "solution": "import math\ndef next_Perfect_Square(number: int) -> int:\n    \"\"\"Finds the next perfect square strictly greater than the given number.\n    For negative inputs, the smallest perfect square greater than it is 0.\"\"\"\n    if number < 0:\n        return 0\n    \n    sqrt_val = math.isqrt(number)\n    return (sqrt_val + 1) * (sqrt_val + 1)"}
{"task_id": "Mbpp/245", "solution": "def max_sum(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the maximum sum of a bitonic subsequence in the given array.\n    A bitonic sequence is first increasing and then decreasing (or only increasing/decreasing).\n    \"\"\"\n    if not isinstance(arr, list):\n        raise ValueError(\"Input must be a list.\")\n    if not all(isinstance(x, int) for x in arr):\n        raise ValueError(\"All elements in the list must be integers.\")\n\n    n = len(arr)\n    if n == 0:\n        return 0\n    if n == 1:\n        return arr[0]\n\n    def _calculate_lis_sums(sequence: list[int]) -> list[int]:\n        \"\"\"Calculates the maximum sum of an increasing subsequence ending at each position.\"\"\"\n        lis_sums = list(sequence)\n        for i in range(n):\n            for j in range(i):\n                if sequence[i] > sequence[j] and lis_sums[i] < lis_sums[j] + sequence[i]:\n                    lis_sums[i] = lis_sums[j] + sequence[i]\n        return lis_sums\n\n    def _calculate_lds_sums(sequence: list[int]) -> list[int]:\n        \"\"\"Calculates the maximum sum of a decreasing subsequence starting at each position.\"\"\"\n        lds_sums = list(sequence)\n        for i in range(n - 1, -1, -1):\n            for j in range(n - 1, i, -1):\n                if sequence[i] > sequence[j] and lds_sums[i] < lds_sums[j] + sequence[i]:\n                    lds_sums[i] = lds_sums[j] + sequence[i]\n        return lds_sums\n\n    lis_sums = _calculate_lis_sums(arr)\n    lds_sums = _calculate_lds_sums(arr)\n\n    max_bitonic_sum = float('-inf')\n\n    for i in range(n):\n        # The element arr[i] acts as the peak, included in both LIS ending at i and LDS starting at i.\n        # It must be subtracted once to avoid double counting.\n        current_bitonic_sum = lis_sums[i] + lds_sums[i] - arr[i]\n        if current_bitonic_sum > max_bitonic_sum:\n            max_bitonic_sum = current_bitonic_sum\n            \n    return max_bitonic_sum"}
{"task_id": "Mbpp/245", "solution": "def max_sum(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the maximum sum of a bitonic subsequence within the given array.\n    A bitonic subsequence is first strictly increasing and then strictly decreasing.\n    \"\"\"\n    if not arr:\n        return 0\n    if not all(isinstance(x, (int, float)) for x in arr):\n        raise ValueError(\"Array must contain only numbers.\")\n\n    n = len(arr)\n    \n    # Calculate LIS (Longest Increasing Subsequence) sum ending at each position.\n    lis = [0] * n\n    for i in range(n):\n        lis[i] = arr[i]\n        for j in range(i):\n            if arr[i] > arr[j] and lis[i] < lis[j] + arr[i]:\n                lis[i] = lis[j] + arr[i]\n\n    # Calculate LDS (Longest Decreasing Subsequence) sum starting at each position.\n    lds = [0] * n\n    for i in range(n - 1, -1, -1):\n        lds[i] = arr[i]\n        for j in range(n - 1, i, -1):\n            if arr[i] > arr[j] and lds[i] < lds[j] + arr[i]:\n                lds[i] = lds[j] + arr[i]\n    \n    max_bitonic_sum = float('-inf') \n\n    for i in range(n):\n        # The current element arr[i] is considered the peak of the bitonic subsequence.\n        # Its sum is the LIS ending at i plus the LDS starting at i, minus arr[i] (to avoid double counting).\n        current_bitonic_sum = lis[i] + lds[i] - arr[i]\n        if current_bitonic_sum > max_bitonic_sum:\n            max_bitonic_sum = current_bitonic_sum\n    \n    # If all subsequence sums are negative, return the maximum single element.\n    if max_bitonic_sum == float('-inf') and n > 0:\n        return max(arr)\n    \n    return max_bitonic_sum"}
{"task_id": "Mbpp/247", "solution": "def lps(s: str) -> int:\n    \"\"\"\n    Calculates the length of the longest palindromic subsequence of the input string `s`.\n    Uses dynamic programming with O(n^2) time and space complexity.\n    \"\"\"\n    if not isinstance(s, str):\n        raise TypeError(\"Input must be a string.\")\n    \n    n = len(s)\n    if n == 0:\n        return 0\n\n    # dp[i][j] stores the length of the longest palindromic subsequence of s[i...j]\n    dp = [[0] * n for _ in range(n)]\n\n    # All single characters are palindromes of length 1.\n    for i in range(n):\n        dp[i][i] = 1\n\n    # Fill the table for lengths from 2 to n.\n    for length in range(2, n + 1):\n        for i in range(n - length + 1):\n            j = i + length - 1\n            if s[i] == s[j]:\n                if length == 2:\n                    dp[i][j] = 2\n                else:\n                    dp[i][j] = 2 + dp[i + 1][j - 1]\n            else:\n                dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])\n\n    return dp[0][n - 1]"}
{"task_id": "Mbpp/247", "solution": "def lps(input_string: str) -> int:\n    \"\"\"Computes the length of the longest palindromic subsequence of the input string using dynamic programming.\n    Raises TypeError if the input is not a string.\"\"\"\n    if not isinstance(input_string, str):\n        raise TypeError(\"Input must be a string.\")\n\n    n = len(input_string)\n\n    if n == 0:\n        return 0\n\n    dp = [[0 for _ in range(n)] for _ in range(n)]\n\n    for i in range(n):\n        dp[i][i] = 1\n\n    for L in range(2, n + 1):\n        for i in range(n - L + 1):\n            j = i + L - 1\n            if input_string[i] == input_string[j]:\n                if L == 2:\n                    dp[i][j] = 2\n                else:\n                    dp[i][j] = 2 + dp[i + 1][j - 1]\n            else:\n                dp[i][j] = max(dp[i][j - 1], dp[i + 1][j])\n\n    return dp[0][n - 1]"}
