{"task_id": "Mbpp/74", "solution": "def is_samepatterns(items: list, patterns: list) -> bool:\n    \"\"\"Checks if two lists follow the same sequence pattern with consistent bidirectional mapping.\n    Returns True if patterns match, False otherwise.\"\"\"\n    if len(items) != len(patterns):\n        return False\n\n    if not items:\n        return True\n\n    item_to_pattern_map = {}\n    pattern_to_item_map = {}\n\n    for i in range(len(items)):\n        current_item = items[i]\n        current_pattern = patterns[i]\n\n        if current_item in item_to_pattern_map:\n            if item_to_pattern_map[current_item] != current_pattern:\n                return False\n        else:\n            item_to_pattern_map[current_item] = current_pattern\n\n        if current_pattern in pattern_to_item_map:\n            if pattern_to_item_map[current_pattern] != current_item:\n                return False\n        else:\n            pattern_to_item_map[current_pattern] = current_item\n\n    return True"}
{"task_id": "Mbpp/59", "solution": "class InvalidInputError(Exception):\n    \"\"\"Custom exception for invalid input parameters.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef is_octagonal(n: int) -> int:\n    \"\"\"Calculates the nth octagonal number.\n    Raises InvalidInputError if n is not a non-negative integer.\"\"\"\n    if not isinstance(n, int) or n < 0:\n        raise InvalidInputError(\"Input 'n' must be a non-negative integer.\")\n    return n * (3 * n - 2)"}
{"task_id": "Mbpp/71", "solution": "from typing import List, Union\ndef comb_sort(data: List[Union[int, float]]) -> List[Union[int, float]]:\n    \"\"\"Sorts a list of numbers in ascending order using the comb sort algorithm.\n    The sort is performed in-place, modifying the input list.\"\"\"\n    if not isinstance(data, list):\n        raise TypeError(\"Input 'data' must be a list.\")\n\n    n = len(data)\n    if n <= 1:\n        return data\n\n    for item in data:\n        if not isinstance(item, (int, float)):\n            raise ValueError(\"List elements must be numbers (int or float).\")\n\n    SHRINK_FACTOR = 1.3 # Constant for gap reduction, per design.\n\n    gap = n\n    swapped = True\n\n    while gap > 1 or swapped:\n        if gap > 1:\n            gap = int(gap / SHRINK_FACTOR)\n            if gap < 1:\n                gap = 1\n\n        swapped = False\n        for i in range(n - gap):\n            if data[i] > data[i + gap]:\n                data[i], data[i + gap] = data[i + gap], data[i]\n                swapped = True\n    return data"}
{"task_id": "Mbpp/75", "solution": "def find_tuples(list_of_tuples: list[tuple[int, ...]], k: int) -> list[tuple[int, ...]]:\n    \"\"\"\n    Filters a list of tuples, returning only those where all elements are divisible by k.\n    Raises ValueError if k is 0, or TypeError for incorrect input types.\n    \"\"\"\n    if k == 0:\n        raise ValueError(\"Divisor 'k' cannot be zero.\")\n\n    if not isinstance(list_of_tuples, list):\n        raise TypeError(\"Input 'list_of_tuples' must be a list.\")\n\n    result_tuples = []\n    for current_tuple in list_of_tuples:\n        if not isinstance(current_tuple, tuple):\n            raise TypeError(f\"Expected a tuple, but found {type(current_tuple)} in the list.\")\n\n        all_elements_divisible = True\n        for element in current_tuple:\n            if not isinstance(element, int):\n                raise TypeError(f\"Expected an integer, but found {type(element)} in tuple {current_tuple}.\")\n            if element % k != 0:\n                all_elements_divisible = False\n                break\n        if all_elements_divisible:\n            result_tuples.append(current_tuple)\n    return result_tuples"}
{"task_id": "Mbpp/74", "solution": "class InvalidInputError(Exception):\n    \"\"\"\n    Custom exception for invalid input conditions.\n    Signals errors like empty sequences or differing lengths.\n    \"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef is_samepatterns(words: list[str], pattern: list[str]) -> bool:\n    \"\"\"\n    Checks if a list of words follows the sequence given in a pattern list.\n    Returns True if the words follow the pattern, False otherwise.\n    \"\"\"\n    if not words or not pattern or len(words) != len(pattern):\n        raise InvalidInputError(\"Input sequences must have same non-zero length.\")\n\n    word_to_pattern_map = {}\n    pattern_to_word_map = {}\n\n    for i in range(len(words)):\n        current_word = words[i]\n        current_pattern_char = pattern[i]\n\n        if current_word in word_to_pattern_map:\n            if word_to_pattern_map[current_word] != current_pattern_char:\n                return False\n        else:\n            word_to_pattern_map[current_word] = current_pattern_char\n\n        if current_pattern_char in pattern_to_word_map:\n            if pattern_to_word_map[current_pattern_char] != current_word:\n                return False\n        else:\n            pattern_to_word_map[current_pattern_char] = current_word\n\n    return True"}
{"task_id": "Mbpp/75", "solution": "from typing import List, Tuple\ndef find_tuples(list_of_tuples: List[Tuple[int, ...]], k: int) -> List[Tuple[int, ...]]:\n    \"\"\"\n    Finds tuples in a list where all elements are divisible by k.\n    This function includes robust input validation.\n    \"\"\"\n    if k == 0:\n        raise ValueError(\"Divisor 'k' cannot be zero.\")\n\n    if not isinstance(list_of_tuples, list):\n        raise TypeError(\"Input 'list_of_tuples' must be a list.\")\n\n    result_tuples: List[Tuple[int, ...]] = []\n    for tup in list_of_tuples:\n        if not isinstance(tup, tuple):\n            raise TypeError(f\"Element '{tup}' in list_of_tuples is not a tuple.\")\n\n        is_current_tuple_divisible = True\n        for element in tup:\n            if not isinstance(element, int):\n                raise TypeError(f\"Element '{element}' in tuple '{tup}' is not an integer.\")\n            if element % k != 0:\n                is_current_tuple_divisible = False\n                break\n        \n        if is_current_tuple_divisible:\n            result_tuples.append(tup)\n            \n    return result_tuples"}
{"task_id": "Mbpp/77", "solution": "def is_Diff(number: int) -> bool:\n    \"\"\"Checks if a number is divisible by 11 using the alternating sum of digits rule.\n    Returns True if divisible by 11, False otherwise.\"\"\"\n    \n    if not isinstance(number, int):\n        raise TypeError(\"Input must be an integer.\")\n\n    if number == 0:\n        return True\n\n    s_num = str(abs(number))\n    alternating_sum = 0\n    \n    for i, digit_char in enumerate(s_num):\n        digit = int(digit_char)\n        if i % 2 == 0:\n            alternating_sum += digit\n        else:\n            alternating_sum -= digit\n    \n    return alternating_sum % 11 == 0"}
