{"task_id": "Mbpp/239", "solution": "from typing import Dict, Tuple\ndef get_total_number_of_sequences(m: int, n: int) -> int:\n    \"\"\"\n    Calculates the number of sequences of length n, where each element is a positive integer,\n    greater than or equal to twice the previous element, and less than or equal to m.\n    It performs input validation and uses dynamic programming with memoization.\n    \"\"\"\n    if not isinstance(m, int) or not isinstance(n, int):\n        raise TypeError(\"m and n must be integers.\")\n    if m <= 0 or n <= 0:\n        raise ValueError(\"m and n must be positive integers.\")\n\n    memo: Dict[Tuple[int, int], int] = {}\n\n    def _count_recursive(length_remaining: int, prev_val: int) -> int:\n        \"\"\"\n        Recursive helper to count valid sub-sequences. It uses the memoization table\n        to store and retrieve results for subproblems, improving performance.\n        \"\"\"\n        if length_remaining == 0:\n            return 1\n\n        if (length_remaining, prev_val) in memo:\n            return memo[(length_remaining, prev_val)]\n\n        count = 0\n        start_next_val = 2 * prev_val\n        for current_val in range(start_next_val, m + 1):\n            count += _count_recursive(length_remaining - 1, current_val)\n\n        memo[(length_remaining, prev_val)] = count\n        return count\n\n    total_sequences = 0\n    for first_element in range(1, m + 1):\n        total_sequences += _count_recursive(n - 1, first_element)\n\n    return total_sequences"}
{"task_id": "Mbpp/240", "solution": "def replace_list(list1: list, list2: list) -> list:\n    \"\"\"\n    Replaces the last element of list1 with the elements of list2, modifying list1 in-place.\n    If list1 is empty, list2's elements are appended to list1.\n    \"\"\"\n    if not list1:\n        list1.extend(list2)\n        return list1\n    \n    list1.pop()\n    list1.extend(list2)\n    return list1"}
