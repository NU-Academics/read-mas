{"task_id": "Mbpp/460", "solution": "from typing import Any, List\ndef Extract(data_list: List[List[Any]]) -> List[Any]:\n    \"\"\"\n    Extracts the first element from each sublist within a given list of lists.\n    Raises TypeError for invalid input types or IndexError for empty sublists.\n    \"\"\"\n    if not isinstance(data_list, list):\n        raise TypeError(\"Input 'data_list' must be a list.\")\n\n    result = []\n    for i, sublist in enumerate(data_list):\n        if not isinstance(sublist, list):\n            raise TypeError(f\"Element at index {i} in 'data_list' is not a list.\")\n        if not sublist:\n            raise IndexError(f\"Sublist at index {i} in 'data_list' is empty.\")\n        result.append(sublist[0])\n    return result"}
{"task_id": "Mbpp/460", "solution": "from typing import List, Any\ndef Extract(list_of_lists: List[List[Any]]) -> List[Any]:\n    \"\"\"\n    Extracts the first element from each sublist in a list of lists.\n    Raises TypeError for invalid input types, ValueError for empty sublists.\n    \"\"\"\n    if not isinstance(list_of_lists, list):\n        raise TypeError(\"Input 'list_of_lists' must be a list.\")\n\n    result = []\n    for i, sublist in enumerate(list_of_lists):\n        if not isinstance(sublist, list):\n            raise TypeError(f\"Element at index {i} is not a list: {sublist}\")\n        if not sublist:\n            raise ValueError(f\"Sublist at index {i} is empty.\")\n        result.append(sublist[0])\n    return result"}
{"task_id": "Mbpp/462", "solution": "from typing import Any, List\ndef combinations_list(input_list: List[Any]) -> List[List[Any]]:\n    \"\"\"\n    Generates all possible combinations of the elements of a given list.\n    Raises TypeError if the input is not a list.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    if not input_list:\n        return [[]]\n\n    first_element = input_list[0]\n    rest_of_list = input_list[1:]\n\n    # Recursively get combinations of the rest of the list.\n    combinations_without_first = combinations_list(rest_of_list)\n\n    # Create new combinations by adding the first element to each.\n    combinations_with_first = []\n    for combo in combinations_without_first:\n        combinations_with_first.append([first_element] + combo)\n\n    return combinations_without_first + combinations_with_first"}
{"task_id": "Mbpp/465", "solution": "def drop_empty(input_dict: dict) -> dict:\n    \"\"\"Removes entries with None values from the input dictionary, returning a new dictionary. Raises TypeError if the input is not a dictionary.\"\"\"\n    if not isinstance(input_dict, dict):\n        raise TypeError(\"Input must be a dictionary.\")\n\n    return {key: value for key, value in input_dict.items() if value is not None}"}
{"task_id": "Mbpp/463", "solution": "class InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input to the max product subarray function.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\ndef max_subarray_product(numbers: list[float | int]) -> float | int:\n    \"\"\"\n    Calculates the maximum product of a contiguous subarray within a given array.\n    Raises InvalidInputError if the input is not a list, is empty, or contains non-numeric elements.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise InvalidInputError(\"Input must be a list.\")\n    if not numbers:\n        raise InvalidInputError(\"Input list cannot be empty.\")\n    for item in numbers:\n        if not isinstance(item, (int, float)):\n            raise InvalidInputError(\"All elements in the list must be numbers (int or float).\")\n\n    # Initialize variables to track the maximum product ending at the current position,\n    # the minimum product ending at the current position, and the overall maximum product found.\n    max_so_far = numbers[0]\n    min_so_far = numbers[0]\n    result = numbers[0]\n\n    for i in range(1, len(numbers)):\n        curr = numbers[i]\n        \n        # Calculate potential new maximum and minimum products ending at 'curr'.\n        # We need to consider 'curr' itself, and 'curr' multiplied by previous max_so_far and min_so_far.\n        temp_max = max(curr, max_so_far * curr, min_so_far * curr)\n        min_so_far = min(curr, max_so_far * curr, min_so_far * curr)\n\n        max_so_far = temp_max\n        \n        # Update the overall maximum product.\n        result = max(result, max_so_far)\n    \n    return result"}
{"task_id": "Mbpp/463", "solution": "from typing import List, Union\nclass InvalidInputError(ValueError):\n    \"\"\"Custom exception for invalid input.\n    Raised when input is not a list of numbers.\"\"\"\n    def __init__(self, message: str):\n        super().__init__(message)\n        self.message = message\ndef max_subarray_product(arr: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"Calculates the maximum product of a contiguous subarray.\n    Handles positive, negative, and zero values efficiently.\"\"\"\n\n    if not isinstance(arr, list):\n        raise InvalidInputError(\"Input must be a list of numbers (int or float).\")\n    for item in arr:\n        if not isinstance(item, (int, float)):\n            raise InvalidInputError(\"Input must be a list of numbers (int or float).\")\n\n    if not arr:\n        return 0\n    \n    if len(arr) == 1:\n        return arr[0]\n\n    max_so_far: Union[int, float] = arr[0]\n    max_ending_here: Union[int, float] = arr[0]\n    min_ending_here: Union[int, float] = arr[0]\n\n    for i in range(1, len(arr)):\n        num = arr[i]\n\n        if num == 0:\n            # Reset current product range, consider 0 as a possible max product.\n            max_ending_here = 1\n            min_ending_here = 1\n            max_so_far = max(max_so_far, 0)\n            continue\n\n        temp_max = max_ending_here * num\n        temp_min = min_ending_here * num\n\n        # max_ending_here can be num itself, or product with previous max/min.\n        max_ending_here = max(num, temp_max, temp_min)\n        # min_ending_here can be num itself, or product with previous max/min.\n        min_ending_here = min(num, temp_max, temp_min)\n\n        max_so_far = max(max_so_far, max_ending_here)\n\n    return max_so_far"}
{"task_id": "Mbpp/462", "solution": "import itertools\ndef combinations_list(input_list: list) -> list[list]:\n    \"\"\"Generates all unique combinations of elements from an input list,\n    following a specific order and internal combination structure from the example.\n    Raises TypeError if the input is not a list.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    # This list will store combinations in the order they are generated.\n    # It starts with the empty combination.\n    all_combinations_raw = [[]]\n\n    # Use a set to track seen combinations (as tuples) to ensure uniqueness\n    # while preserving the first encountered order from the generation process.\n    seen_combinations = {tuple()}\n\n    for element in input_list:\n        # Create new combinations by prepending the current element to existing ones.\n        # We must iterate over `all_combinations_raw` as it was *before* adding\n        # new combinations in the current iteration to avoid modifying the list\n        # while iterating over it directly.\n        combinations_at_start_of_round = list(all_combinations_raw) \n        \n        for existing_combo in combinations_at_start_of_round:\n            new_combo = [element] + existing_combo\n            combo_tuple = tuple(new_combo)\n            if combo_tuple not in seen_combinations:\n                all_combinations_raw.append(new_combo)\n                seen_combinations.add(combo_tuple)\n\n    # The `all_combinations_raw` list now contains all unique combinations\n    # in the specific order required by the example.\n    return all_combinations_raw"}
