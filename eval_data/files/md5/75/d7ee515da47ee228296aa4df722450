{"task_id": "Mbpp/751", "solution": "def check_min_heap(arr: list[int]) -> bool:\n    \"\"\"Checks if the given array of integers `arr` satisfies the min-heap property.\n    An empty or single-element array is considered a valid min-heap.\"\"\"\n    n = len(arr)\n    if n <= 1:\n        return True\n\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        if left_child_idx < n and arr[i] > arr[left_child_idx]:\n            return False\n\n        if right_child_idx < n and arr[i] > arr[right_child_idx]:\n            return False\n    return True"}
{"task_id": "Mbpp/751", "solution": "def check_min_heap(arr: list) -> bool:\n    \"\"\"Checks if the array represents a min-heap according to 0-indexed array rules.\n    Returns True if valid, False otherwise.\"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"Input must be a list.\")\n\n    n = len(arr)\n    # Only parent nodes need to be checked. The last parent is at index (n // 2) - 1.\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check left child if it exists and violates the min-heap property.\n        if left_child_idx < n and arr[i] > arr[left_child_idx]:\n            return False\n\n        # Check right child if it exists and violates the min-heap property.\n        if right_child_idx < n and arr[i] > arr[right_child_idx]:\n            return False\n    return True"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n: int) -> int:\n    \"\"\"Calculates the nth Jacobsthal number.\n    Raises ValueError for negative n, TypeError for non-integer n.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise ValueError(\"Input 'n' must be a non-negative integer.\")\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n\n    j0, j1 = 0, 1  # J(0), J(1)\n    for _ in range(2, n + 1):\n        j0, j1 = j1, j0 + 2 * j1\n    return j1"}
{"task_id": "Mbpp/752", "solution": "class JacobsthalError(Exception):\n    \"\"\"Base exception for the jacobsthal package.\"\"\"\n    pass\nclass JacobsthalInputError(JacobsthalError):\n    \"\"\"Exception raised for invalid input to Jacobsthal functions.\"\"\"\n    pass\ndef jacobsthal_num(n: int) -> int:\n    \"\"\"Calculates the nth Jacobsthal number for a non-negative integer n. Raises JacobsthalInputError for invalid input.\"\"\"\n    if not isinstance(n, int):\n        raise JacobsthalInputError(\"Input 'n' must be an integer.\")\n    if n < 0:\n        raise JacobsthalInputError(\"Input 'n' must be a non-negative integer.\")\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n\n    a, b = 0, 1  # J(0), J(1)\n    for _ in range(2, n + 1):\n        next_jacobsthal = b + 2 * a\n        a, b = b, next_jacobsthal\n    return b"}
{"task_id": "Mbpp/753", "solution": "import heapq\nfrom typing import List, Tuple\ndef min_k(records: List[Tuple[str, int]], k: int) -> List[Tuple[str, int]]:\n    \"\"\"\n    Finds the k tuples with the smallest integer values from a list of tuples.\n    Handles edge cases like k <= 0 or an empty records list.\n    \"\"\"\n    if k <= 0 or not records:\n        return []\n\n    return heapq.nsmallest(k, records, key=lambda x: x[1])"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1: list, l2: list, l3: list) -> list:\n    \"\"\"\n    Finds elements common to three lists at the same index.\n    Compares elements up to the length of the shortest list.\n    \"\"\"\n    common_elements = []\n    min_length = min(len(l1), len(l2), len(l3))\n\n    for i in range(min_length):\n        if l1[i] == l2[i] == l3[i]:\n            common_elements.append(l1[i])\n    return common_elements"}
{"task_id": "Mbpp/753", "solution": "def min_k(data: list[tuple[str, int]], k: int) -> list[tuple[str, int]]:\n    \"\"\"\n    Identifies and retrieves the 'k' smallest records from a list of (string, integer) tuples.\n    Returns a new list containing these 'k' tuples, sorted by their integer values.\n    \"\"\"\n    if not data or k <= 0:\n        return []\n\n    # Sort the list of tuples based on the integer value (second element).\n    sorted_data = sorted(data, key=lambda x: x[1])\n\n    # Return the first k elements, handling cases where k exceeds list length.\n    return sorted_data[:k]"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1: list, l2: list, l3: list) -> list:\n    \"\"\"Finds elements common across three lists at the same index.\n    Raises TypeError if any input is not a list.\"\"\"\n    if not all(isinstance(lst, list) for lst in [l1, l2, l3]):\n        raise TypeError(\"All inputs must be lists.\")\n\n    common_elements = []\n    min_length = min(len(l1), len(l2), len(l3))\n\n    for i in range(min_length):\n        if l1[i] == l2[i] == l3[i]:\n            common_elements.append(l1[i])\n    return common_elements"}
{"task_id": "Mbpp/755", "solution": "from typing import List, Union\ndef second_smallest(numbers: List[Union[int, float]]) -> Union[int, float]:\n    \"\"\"Finds the second smallest distinct number in a list of numbers.\n    Raises TypeError for invalid input types, or ValueError if not enough distinct numbers.\"\"\"\n\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n\n    for num in numbers:\n        if not isinstance(num, (int, float)):\n            raise TypeError(\"All elements in the list must be numbers.\")\n\n    unique_numbers = sorted(list(set(numbers)))\n\n    if len(unique_numbers) < 2:\n        raise ValueError(\"List must contain at least two distinct numbers.\")\n\n    return unique_numbers[1]"}
{"task_id": "Mbpp/755", "solution": "def second_smallest(numbers: list[int | float]) -> int | float:\n    \"\"\"\n    Finds the second smallest unique number in a list of numbers.\n    It returns the second smallest unique number, or raises an error if not possible.\n    \"\"\"\n    if not isinstance(numbers, list):\n        raise TypeError(\"Input must be a list.\")\n\n    unique_numbers = []\n    for num in numbers:\n        if not isinstance(num, (int, float)):\n            raise TypeError(\"All elements in the list must be numbers (int or float).\")\n        if num not in unique_numbers:\n            unique_numbers.append(num)\n\n    unique_numbers.sort()\n\n    if len(unique_numbers) < 2:\n        raise ValueError(\"List must contain at least two unique numbers to find the second smallest.\")\n\n    return unique_numbers[1]"}
{"task_id": "Mbpp/757", "solution": "def count_reverse_pairs(string_list: list[str]) -> int:\n    \"\"\"Counts unique reverse string pairs in a list.\n    Handles type validation, case-sensitivity, and ensures each unique pair is counted once.\n    \"\"\"\n    if not isinstance(string_list, list):\n        raise TypeError(\"Input must be a list.\")\n    \n    seen_strings = set()\n    pair_count = 0\n\n    for s in string_list:\n        if not isinstance(s, str):\n            raise TypeError(\"All elements in the list must be strings.\")\n        \n        reversed_s = s[::-1]\n        \n        # Check if the reversed string has been seen and is not the same as the original string.\n        if reversed_s in seen_strings and s != reversed_s:\n            pair_count += 1\n            # Remove the reversed_s from seen_strings to prevent re-counting with duplicates.\n            seen_strings.remove(reversed_s)\n        else:\n            seen_strings.add(s)\n    \n    return pair_count"}
{"task_id": "Mbpp/758", "solution": "from collections import Counter\nfrom typing import Any, List, Dict, Tuple\ndef unique_sublists(input_list: List[List[Any]]) -> Dict[Tuple[Any, ...], int]:\n    \"\"\"Counts occurrences of unique sublists, converting them to tuples for keys.\n    Raises TypeError if input_list or its elements are not lists.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    tuple_list: List[Tuple[Any, ...]] = []\n    for sublist in input_list:\n        if not isinstance(sublist, list):\n            raise TypeError(\"All elements in the input list must be lists.\")\n        tuple_list.append(tuple(sublist))\n    \n    return dict(Counter(tuple_list))"}
{"task_id": "Mbpp/759", "solution": "import re\ndef is_decimal(input_string: str) -> bool:\n    \"\"\"\n    Checks if the given input_string represents a valid decimal number\n    with exactly two digits after the decimal point.\n    \"\"\"\n    if not isinstance(input_string, str):\n        return False\n\n    # Regex for an optional sign, one or more digits, a decimal point, and exactly two digits.\n    pattern = r\"^-?\\\\d+\\\\.\\\\d{2}$\"\n    return bool(re.fullmatch(pattern, input_string))"}
{"task_id": "Mbpp/757", "solution": "def count_reverse_pairs(string_list: list[str]) -> int:\n    \"\"\"\n    Counts unique reverse string pairs in a list, respecting case-sensitivity and palindrome rules.\n    Raises TypeError for invalid input types or non-string list elements.\n    \"\"\"\n    if not isinstance(string_list, list):\n        raise TypeError(\"Input must be a list of strings.\")\n\n    # Use a set for efficient O(1) average-case lookups, crucial for performance with large lists.\n    string_set_for_lookup = set()\n    for s in string_list:\n        if not isinstance(s, str):\n            raise TypeError(\"All elements in the list must be strings.\")\n        string_set_for_lookup.add(s)\n    \n    # Tracks strings already processed or part of a counted pair, ensuring uniqueness as per BR2.\n    processed_strings = set()\n    pair_count = 0\n\n    for s in string_set_for_lookup: # Iterate through unique strings from the original list\n        if s in processed_strings:\n            continue\n\n        s_reversed = s[::-1]\n\n        # Check conditions for a valid reverse pair (BR1, FR5):\n        # 1. The reversed string must exist in the input list (checked efficiently via string_set_for_lookup).\n        # 2. The string must not be a palindrome (s != s_reversed).\n        # 3. The reversed string must not have been processed or part of another pair.\n        if s_reversed in string_set_for_lookup and s != s_reversed and s_reversed not in processed_strings:\n            pair_count += 1\n            # Mark both original and reversed strings as processed to prevent re-counting (BR2).\n            processed_strings.add(s)\n            processed_strings.add(s_reversed)\n        else:\n            # Mark string as processed even if no pair is found to avoid redundant checks.\n            processed_strings.add(s)\n\n    return pair_count"}
{"task_id": "Mbpp/759", "solution": "import re\ndef is_decimal(input_string: str) -> bool:\n    \"\"\"\n    Checks if the input_string represents a decimal number with exactly two\n    digits after the decimal point, ignoring leading/trailing whitespace.\n    \"\"\"\n    if not isinstance(input_string, str):\n        return False\n\n    cleaned_string = input_string.strip()\n\n    # Regex matches an optional sign, one or more digits, a decimal point, and exactly two digits.\n    pattern = r\"^-?\\d+\\.\\d{2}$\"\n    return bool(re.fullmatch(pattern, cleaned_string))"}
{"task_id": "Mbpp/758", "solution": "from collections import defaultdict\nfrom typing import Any, Dict, List, Tuple\ndef unique_sublists(input_list: List[Any]) -> Dict[Tuple[Any, ...], int]:\n    \"\"\"\n    Counts occurrences of unique sublists within `input_list`.\n    Non-list elements are ignored, and sublists are converted to tuples for counting.\n    \"\"\"\n    if not isinstance(input_list, list):\n        raise TypeError(\"Input must be a list.\")\n\n    counts: Dict[Tuple[Any, ...], int] = defaultdict(int)\n\n    for item in input_list:\n        if isinstance(item, list):\n            sublist_as_tuple = tuple(item)\n            counts[sublist_as_tuple] += 1\n    return dict(counts)"}
