{"task_id": "HumanEval/75", "solution": "import itertools\ndef is_prime(n):\n    \"\"\"Checks if a number is prime. Handles numbers less than 2 by returning False.\"\"\"\n    if n < 2:\n        return False\n    for i in range(2, int(n**0.5) + 1):\n        if n % i == 0:\n            return False\n    return True\ndef get_primes_up_to_n(n):\n    \"\"\"Generates a list of prime numbers up to n. Returns an empty list if n is less than 2.\"\"\"\n    if n < 2:\n        return []\n    primes = []\n    for i in range(2, n + 1):\n        if is_prime(i):\n            primes.append(i)\n    return primes\ndef is_multiply_prime(a):\n    \"\"\"\n    Determines if the given number 'a' is the product of exactly three distinct prime numbers.\n    It assumes 'a' is an integer between 1 and 100 (exclusive).\n    \"\"\"\n    primes = get_primes_up_to_n(a)\n\n    if len(primes) < 3:\n        return False\n\n    for p1, p2, p3 in itertools.combinations(primes, 3):\n        if p1 * p2 * p3 == a:\n            return True\n    return False"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    \"\"\"Checks if an integer 'a' is a perfect cube. Assumes 'a' is a valid integer.\"\"\"\n    if a == 0:\n        return True\n    \n    abs_a = abs(a)\n    cbrt_candidate = round(abs_a**(1/3))\n    \n    if a < 0:\n        return (-cbrt_candidate * -cbrt_candidate * -cbrt_candidate) == a\n    else:\n        return (cbrt_candidate * cbrt_candidate * cbrt_candidate) == a"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    \"\"\"\n    Checks if an integer 'a' is a perfect cube.\n    It calculates the integer cube root and verifies if its cube matches 'a'.\n    \"\"\"\n    if a == 0:\n        return True\n\n    sign = 1 if a >= 0 else -1\n    abs_a = abs(a)\n\n    # Calculate the integer cube root of the absolute value.\n    # Input abs_a is guaranteed non-negative as per design.\n    root = round(abs_a**(1/3))\n\n    # Check if cubing the root (with original sign) yields the original number.\n    return (sign * root * root * root) == a"}
{"task_id": "HumanEval/75", "solution": "def get_primes_up_to(limit: int) -> list[int]:\n    \"\"\"Generates a list of primes up to a given limit using the Sieve of Eratosthenes.\n    This function is optimized for limits typical in this problem (less than 100).\"\"\"\n    primes = []\n    if limit < 2:\n        return primes\n    is_prime_sieve = [True] * (limit + 1)\n    is_prime_sieve[0] = is_prime_sieve[1] = False\n    for p in range(2, int(limit**0.5) + 1):\n        if is_prime_sieve[p]:\n            for multiple in range(p * p, limit + 1, p):\n                is_prime_sieve[multiple] = False\n    for p in range(2, limit + 1):\n        if is_prime_sieve[p]:\n            primes.append(p)\n    return primes\ndef is_multiply_prime(a):\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100.\n    Example:\n    is_multiply_prime(30) == True\n    30 = 2 * 3 * 5\n    \"\"\"\n    # Per the problem specification, assume 'a' is an integer such that 0 < a < 100.\n    # The smallest product of three primes is 2*2*2 = 8, so numbers smaller than 8 can't be products of three primes.\n    if a < 8:\n        return False\n\n    primes = get_primes_up_to(a) # Get all primes up to 'a'.\n    n = len(primes)\n\n    # Iterate through all combinations of three primes (p1, p2, p3) allowing for repetition.\n    for i in range(n):\n        p1 = primes[i]\n        # Optimization: if p1 alone is too large, subsequent products with larger p2, p3 will also be too large.\n        # This check is implicitly covered by the inner product checks, but can be added for early exit.\n        if p1 > a:\n             break # No need to continue if the first prime is already too large\n\n        for j in range(i, n): # Start from 'i' to allow p1=p2 (repetition is allowed).\n            p2 = primes[j]\n            product_p1_p2 = p1 * p2\n            if product_p1_p2 > a: # Optimization: If product of two primes already exceeds 'a', break inner loop.\n                break\n\n            for k in range(j, n): # Start from 'j' to allow p2=p3 (repetition is allowed).\n                p3 = primes[k]\n                product = product_p1_p2 * p3\n\n                if product == a:\n                    return True\n                elif product > a:\n                    # Optimization: Products will only increase as p3 increases, so break this inner-most loop.\n                    break\n    return False"}
{"task_id": "HumanEval/78", "solution": "def hex_key(num):\n    \"\"\"Counts prime hexadecimal digits in a given string.\n    Prime digits are 2, 3, 5, 7, B (11), D (13).\"\"\"\n    prime_hex_decimals = {2, 3, 5, 7, 11, 13}\n    count = 0\n    for char in num:\n        decimal_value = int(char, 16)\n        if decimal_value in prime_hex_decimals:\n            count += 1\n    return count"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Checks if a number x is a simple power of n.\n    x is a simple power of n if n**k = x for some integer k.\n    \"\"\"\n    if x <= 0:\n        return False\n    if x == 1:\n        return True  # Any positive n to the power of 0 is 1.\n\n    if n == 1:\n        return False # If x is not 1, it cannot be a power of 1.\n\n    current_x = x\n    while current_x % n == 0:\n        current_x //= n\n    return current_x == 1"}
{"task_id": "HumanEval/78", "solution": "PRIME_HEX_DIGITS = {'2', '3', '5', '7', 'B', 'D'}\ndef hex_key(num: str) -> int:\n    \"\"\"Counts the number of prime hexadecimal digits in the input string.\n    The function iterates through the string and checks each digit against a predefined set of prime hexadecimal digits.\n    \"\"\"\n    count = 0\n    for digit in num:\n        if digit in PRIME_HEX_DIGITS:\n            count += 1\n    return count"}
{"task_id": "HumanEval/80", "solution": "def is_happy(s):\n    \"\"\"You are given a string s.\n    Your task is to check if the string is happy or not.\n    A string is happy if its length is at least 3 and every 3 consecutive letters are distinct\n    For example:\n    is_happy(a) => False\n    is_happy(aa) => False\n    is_happy(abcd) => True\n    is_happy(aabb) => False\n    is_happy(adb) => True\n    is_happy(xyy) => False\n    \"\"\"\n    if len(s) < 3:\n        return False\n\n    for i in range(len(s) - 2):\n        if s[i] == s[i+1] or s[i] == s[i+2] or s[i+1] == s[i+2]:\n            return False\n    return True"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n    \"\"\"Checks if x is a simple power of n (n**k = x for non-negative k).\n    Handles edge cases like n=0, n=1, x=0, x=1 per specification.\n    \"\"\"\n    if n == 0:\n        # As per design's tests and assumptions, 0 is not a simple power of 0 in this context.\n        # Also, 1 is not a power of 0.\n        return False\n    \n    if n == 1:\n        # 1 raised to any power is 1.\n        return x == 1\n    \n    if x == 1:\n        # Any non-zero base (n != 0, n != 1 already checked) to the power of 0 is 1.\n        return True\n    \n    if x <= 0:\n        # Positive 'x' is required for powers of positive 'n' (n > 1) or negative 'n'.\n        return False\n\n    # For positive x and n > 1 (or n < -1 in some cases, which the loop handles).\n    # Repeatedly divide x by n until it's no longer divisible.\n    while x % n == 0:\n        x //= n\n    return x == 1"}
