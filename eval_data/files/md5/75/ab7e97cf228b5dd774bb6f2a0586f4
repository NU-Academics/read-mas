{"task_id": "HumanEval/99", "solution": "import math\ndef closest_integer(value):\n    '''\n    Create a function that takes a value (string) representing a number\n    and returns the closest integer to it. If the number is equidistant\n    from two integers, round it away from zero.\n    '''\n    float_val = float(value)\n\n    floor_val = math.floor(float_val)\n    ceil_val = math.ceil(float_val)\n\n    if float_val == floor_val:\n        return int(float_val)\n\n    diff_floor = float_val - floor_val\n    diff_ceil = ceil_val - float_val\n\n    if diff_floor == 0.5 and diff_ceil == 0.5:\n        if float_val >= 0:\n            return int(ceil_val)\n        else:\n            return int(floor_val)\n    elif diff_floor < diff_ceil:\n        return int(floor_val)\n    else:\n        return int(ceil_val)"}
{"task_id": "HumanEval/100", "solution": "def make_a_pile(n):\n    \"\"\"\n    Calculates stone counts for `n` levels.\n    The first level has `n` stones, and subsequent levels add 2 stones each.\n    \"\"\"\n    pile = [n]\n    current_stones = n\n    for _ in range(1, n):\n        current_stones += 2\n        pile.append(current_stones)\n    return pile"}
{"task_id": "HumanEval/103", "solution": "def rounded_avg(n, m):\n    \"\"\"Computes the rounded average of integers in a range and returns its binary representation.\n    If n is greater than m, it returns -1.\n    \"\"\"\n    if n > m:\n        return -1\n\n    count = m - n + 1\n    # Calculate sum using arithmetic progression formula for efficiency.\n    total_sum = (count * (n + m)) // 2\n\n    average_value = total_sum / count\n    rounded_avg_int = round(average_value)\n\n    return bin(rounded_avg_int)"}
{"task_id": "HumanEval/104", "solution": "def unique_digits(x):\n    \"\"\"Given a list of positive integers x. return a sorted list of all \n    elements that hasn't any even digit.\n    \n    Note: Returned list should be sorted in increasing order.\n    \"\"\"\n\n    def _has_even_digit(number: int) -> bool:\n        \"\"\"Checks if an integer contains any even digit (0, 2, 4, 6, 8).\"\"\"\n        for digit_char in str(number):\n            if digit_char in '02468':\n                return True\n        return False\n\n    filtered_numbers = []\n    for number in x:\n        if not _has_even_digit(number):\n            filtered_numbers.append(number)\n    \n    filtered_numbers.sort()\n    return filtered_numbers"}
{"task_id": "HumanEval/103", "solution": "def rounded_avg(n, m):\n    \"\"\"\n    Computes the rounded average of a range of integers and converts it to binary.\n    Returns -1 if the starting integer n is greater than the ending integer m.\n    \"\"\"\n    if n > m:\n        return -1\n\n    # Calculate the sum of integers from n to m (inclusive) using the arithmetic series formula.\n    count = m - n + 1\n    sum_val = (count * (n + m)) // 2\n\n    # Compute the average of the integers.\n    average = sum_val / count\n    \n    # Round the computed average to the nearest integer (round half to even).\n    rounded_avg_int = round(average)\n    \n    # Convert the rounded integer average to its binary string representation.\n    binary_str = bin(rounded_avg_int)\n    \n    return binary_str"}
{"task_id": "HumanEval/104", "solution": "class DigitUtils:\n    ODD_DIGITS = {1, 3, 5, 7, 9}\n\n    def has_even_digit(self, number: int) -> bool:\n        \"\"\"Checks if a positive integer contains any even digit.\n        Zero is considered an even digit.\n        \"\"\"\n        if number == 0:\n            return True\n\n        temp_num = number\n        while temp_num > 0:\n            digit = temp_num % 10\n            if digit not in self.ODD_DIGITS:\n                return True\n            temp_num //= 10\n        return False\nclass DigitFilterService:\n    def __init__(self, digit_utils=None):\n        \"\"\"Initializes the service, setting up a DigitUtils instance.\"\"\"\n        self._digit_utils = digit_utils if digit_utils is not None else DigitUtils()\n\n    def filter_and_sort(self, numbers: list[int]) -> list[int]:\n        \"\"\"Filters a list of positive integers, keeping only those with no even digits.\n        The result is sorted in increasing order.\n        \"\"\"\n        filtered_numbers = []\n        for num in numbers:\n            # Assumed num is a positive integer as per specification.\n            if not self._digit_utils.has_even_digit(num):\n                filtered_numbers.append(num)\n        \n        filtered_numbers.sort()\n        return filtered_numbers\ndef unique_digits(x: list[int]) -> list[int]:\n    \"\"\"Given a list of positive integers x. return a sorted list of all \n    elements that hasn't any even digit.\n    \"\"\"\n    service = DigitFilterService()\n    return service.filter_and_sort(x)"}
{"task_id": "HumanEval/105", "solution": "DIGIT_TO_WORD_MAP = {\n    1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n    6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\",\n}\ndef _filter_and_sort(arr: list) -> list[int]:\n    \"\"\"Filters numbers to be between 1 and 9 inclusive, then sorts them.\"\"\"\n    valid_numbers = [num for num in arr if 1 <= num <= 9]\n    valid_numbers.sort()\n    return valid_numbers\ndef _reverse_list(arr: list[int]) -> list[int]:\n    \"\"\"Reverses the order of elements in a list.\"\"\"\n    return arr[::-1]\ndef _map_to_words(arr: list[int]) -> list[str]:\n    \"\"\"Maps integers to their corresponding word representations.\"\"\"\n    return [DIGIT_TO_WORD_MAP[num] for num in arr]\ndef by_length(arr):\n    \"\"\"\n    Transforms an array of integers by filtering, sorting, reversing,\n    and mapping specific numbers to their English word equivalents.\n    \"\"\"\n    filtered_and_sorted = _filter_and_sort(arr)\n    reversed_list = _reverse_list(filtered_and_sorted)\n    result = _map_to_words(reversed_list)\n    return result"}
{"task_id": "HumanEval/105", "solution": "def by_length(arr):\n    \"\"\"\n    Processes an array of integers by filtering, sorting, reversing,\n    and mapping digits (1-9) to their English word names.\n    \"\"\"\n    if not arr:\n        return []\n\n    # Define the digit to name mapping directly within the function.\n    digit_to_name_mapping = {\n        1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n        6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\"\n    }\n\n    # Filter to include only integers between 1 and 9 inclusive.\n    filtered_arr = [num for num in arr if 1 <= num <= 9]\n\n    # Sort the filtered integers in ascending order.\n    filtered_arr.sort()\n\n    # Reverse the sorted array to get descending order.\n    filtered_arr.reverse()\n\n    # Map each digit to its corresponding English word name.\n    result = [digit_to_name_mapping[digit] for digit in filtered_arr]\n    \n    return result"}
{"task_id": "HumanEval/106", "solution": "def f(n):\n    \"\"\"\n    Generates a list of n elements based on 1-based index rules.\n    Even indices get factorial, odd indices get sum up to the index.\n    \"\"\"\n\n    def factorial(k_val: int) -> int:\n        \"\"\"Calculates the factorial of a positive integer.\"\"\"\n        res = 1\n        for j in range(1, k_val + 1):\n            res *= j\n        return res\n\n    def sum_up_to(k_val: int) -> int:\n        \"\"\"Calculates the sum of numbers from 1 up to a positive integer.\"\"\"\n        return k_val * (k_val + 1) // 2\n\n    if n <= 0:\n        return []\n\n    result_list = []\n    for i in range(1, n + 1):\n        if i % 2 == 0:  # Even 1-based index\n            result_list.append(factorial(i))\n        else:  # Odd 1-based index\n            result_list.append(sum_up_to(i))\n    return result_list"}
{"task_id": "HumanEval/106", "solution": "def f(n):\n    \"\"\"\n    Generates a list of n elements based on their 1-based index parity.\n    Even indices get factorial, odd indices get sum of numbers up to the index.\n    \"\"\"\n\n    def _calculate_factorial(k: int) -> int:\n        \"\"\"Computes the factorial of a given non-negative integer k.\n        Assumes k is non-negative as per critical requirements.\n        \"\"\"\n        if k == 0:\n            return 1\n        result = 1\n        for i in range(1, k + 1):\n            result *= i\n        return result\n\n    def _calculate_sum_up_to(k: int) -> int:\n        \"\"\"Computes the sum of integers from 1 to k.\n        Assumes k is non-negative as per critical requirements.\n        \"\"\"\n        return k * (k + 1) // 2\n\n    # Critical requirements forbid raising exceptions for edge cases like n < 0.\n    # Therefore, trust the caller's input and proceed with direct logic.\n\n    result_list = []\n    for i in range(1, n + 1):  # i is 1-based index\n        if i % 2 == 0:  # Even index\n            result_list.append(_calculate_factorial(i))\n        else:  # Odd index\n            result_list.append(_calculate_sum_up_to(i))\n    return result_list"}
{"task_id": "HumanEval/107", "solution": "def even_odd_palindrome(n):\n    \"\"\"\n    Given a positive integer n, return a tuple that has the number of even and odd\n    integer palindromes that fall within the range(1, n), inclusive.\n    \"\"\"\n    def is_palindrome(num):\n        \"\"\"Checks if an integer is a palindrome.\"\"\"\n        s = str(num)\n        return s == s[::-1]\n\n    def is_even(num):\n        \"\"\"Checks if an integer is even.\"\"\"\n        return num % 2 == 0\n\n    even_count = 0\n    odd_count = 0\n    for i in range(1, n + 1):\n        if is_palindrome(i):\n            if is_even(i):\n                even_count += 1\n            else:\n                odd_count += 1\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/107", "solution": "def even_odd_palindrome(n):\n    \"\"\"\n    Given a positive integer n, return a tuple that has the number of even and odd\n    integer palindromes that fall within the range(1, n), inclusive.\n    \"\"\"\n\n    def is_palindrome(num: int) -> bool:\n        \"\"\"\n        Checks if a given integer is a palindrome by comparing its string representation with its reverse.\n        \"\"\"\n        s_num = str(num)\n        return s_num == s_num[::-1]\n\n    even_count = 0\n    odd_count = 0\n    for i in range(1, n + 1):\n        if is_palindrome(i):\n            if i % 2 == 0:\n                even_count += 1\n            else:\n                odd_count += 1\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/110", "solution": "def exchange(lst1, lst2):\n    \"\"\"\n    Determines if lst1 can become all even by exchanging elements with lst2.\n    Returns \"YES\" if possible, \"NO\" otherwise.\n    \"\"\"\n    odd_count_lst1 = sum(1 for x in lst1 if x % 2 != 0)\n    even_count_lst2 = sum(1 for x in lst2 if x % 2 == 0)\n\n    if odd_count_lst1 <= even_count_lst2:\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/108", "solution": "def count_nums(arr):\n    \"\"\"\n    Counts elements in an array where the sum of their digits is greater than 0.\n    For negative numbers, the first signed digit is negative (e.g., -123 -> -1, 2, 3).\n    \"\"\"\n    count = 0\n    for num in arr:\n        current_digit_sum = 0\n        if num == 0:\n            current_digit_sum = 0\n        else:\n            s = str(num)\n            if s[0] == '-':\n                current_digit_sum += int(s[1]) * -1\n                for digit_char in s[2:]:\n                    current_digit_sum += int(digit_char)\n            else:\n                for digit_char in s:\n                    current_digit_sum += int(digit_char)\n\n        if current_digit_sum > 0:\n            count += 1\n            \n    return count"}
{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr):\n    \"\"\"Determines if an array can be sorted by right shifts.\n    Returns True if sortable, False otherwise; True for empty arrays.\n    \"\"\"\n    if not arr:\n        return True\n\n    n = len(arr)\n    sorted_arr = sorted(arr)\n    current_arr = list(arr) # Create a mutable copy of the input array\n\n    for _ in range(n):\n        # If the current array is already sorted, we're done.\n        if current_arr == sorted_arr:\n            return True\n        \n        # Perform a single right shift: move the last element to the front.\n        current_arr = [current_arr[-1]] + current_arr[:-1]\n    \n    # After trying all possible N shifts, if none resulted in a sorted array, return False.\n    return False"}
{"task_id": "HumanEval/110", "solution": "def exchange(lst1, lst2):\n    \"\"\"In this problem, you will implement a function that takes two lists of numbers,\n    and determines whether it is possible to perform an exchange of elements\n    between them to make lst1 a list of only even numbers.\n    \"\"\"\n    num_odd_in_lst1 = sum(1 for x in lst1 if x % 2 != 0) # Count odd elements in lst1.\n    num_even_in_lst2 = sum(1 for x in lst2 if x % 2 == 0) # Count even elements in lst2.\n\n    # Check if enough even numbers from lst2 can replace all odd numbers in lst1.\n    if num_odd_in_lst1 <= num_even_in_lst2:\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr):\n    \"\"\"Determines if an array can be sorted in non-decreasing order by right-shifting its elements.\n    An empty or single-element array is considered sorted.\"\"\"\n    n = len(arr)\n    if n <= 1:\n        return True\n\n    break_point_count = 0\n\n    for i in range(n - 1):\n        if arr[i] > arr[i+1]:\n            break_point_count += 1\n\n    if break_point_count == 0:\n        return True\n    elif break_point_count == 1:\n        return arr[n-1] <= arr[0]\n    else:\n        return False"}
{"task_id": "HumanEval/108", "solution": "def count_nums(arr):\n    \"\"\"\n    Counts numbers in an array with a digit sum strictly greater than zero.\n    For negative numbers, the first digit is considered negative in the sum.\n    \"\"\"\n\n    def _extract_signed_digits(number: int) -> list[int]:\n        \"\"\"\n        Extracts signed digits from an integer.\n        For negative numbers, the first digit is negative (e.g. -123 -> [-1, 2, 3]).\n        \"\"\"\n        if number == 0:\n            return [0]\n\n        s_num = str(number)\n        digits = []\n        if s_num[0] == '-':\n            digits.append(int(s_num[0] + s_num[1]))\n            for char in s_num[2:]:\n                digits.append(int(char))\n        else:\n            for char in s_num:\n                digits.append(int(char))\n        return digits\n\n    count = 0\n    for number in arr:\n        sum_of_digits = sum(_extract_signed_digits(number))\n        if sum_of_digits > 0:\n            count += 1\n    return count"}
{"task_id": "HumanEval/111", "solution": "def histogram(test):\n    \"\"\"Given a string of space-separated lowercase letters, return a dictionary\n    of letter(s) with the most repetition and their corresponding count.\n    If several letters have the same occurrence, all are returned.\"\"\"\n\n    # Split the input string by spaces and filter out any empty strings.\n    letters = [letter for letter in test.split(' ') if letter]\n\n    # If no letters are found after parsing, return an empty dictionary.\n    if not letters:\n        return {}\n\n    # Manually count the occurrences of each letter.\n    counts = {}\n    for letter in letters:\n        counts[letter] = counts.get(letter, 0) + 1\n\n    # Determine the highest frequency count among all letters.\n    max_count = max(counts.values())\n\n    # Create the result dictionary, including only letters with the maximum frequency.\n    result_dict = {}\n    for letter, count in counts.items():\n        if count == max_count:\n            result_dict[letter] = count\n\n    return result_dict"}
{"task_id": "HumanEval/111", "solution": "from collections import Counter\ndef histogram(test):\n    \"\"\"Given a string representing a space separated lowercase letters, return a dictionary\n    of the letter with the most repetition and containing the corresponding count.\n    If several letters have the same occurrence, return all of them.\n    \"\"\"\n    analyzer = HistogramAnalyzer()\n    return analyzer.analyze(test)\nclass HistogramAnalyzer:\n    def analyze(self, text: str) -> dict[str, int]:\n        if not text.strip():\n            return {}\n\n        # Split the string into individual letters, filtering out empty strings from multiple spaces.\n        letters = [char for char in text.split(' ') if char]\n        \n        if not letters:\n            return {}\n\n        letter_counts = self._count_letters(letters)\n        return self._get_most_frequent(letter_counts)\n\n    def _count_letters(self, letters: list[str]) -> dict[str, int]:\n        return dict(Counter(letters))\n\n    def _get_most_frequent(self, counts: dict[str, int]) -> dict[str, int]:\n        if not counts:\n            return {}\n\n        max_count = 0\n        for count in counts.values():\n            if count > max_count:\n                max_count = count\n        \n        most_frequent_letters = {}\n        for letter, count in counts.items():\n            if count == max_count:\n                most_frequent_letters[letter] = count\n        \n        return most_frequent_letters"}
{"task_id": "HumanEval/112", "solution": "def reverse_delete(s,c):\n    \"\"\"\n    Deletes all characters from 's' that are present in 'c', then checks if the resulting string is a palindrome.\n    Returns a tuple of the modified string and the palindrome check result.\n    \"\"\"\n    chars_to_delete = set(c)\n    result_s_chars = []\n    for char_s in s:\n        if char_s not in chars_to_delete:\n            result_s_chars.append(char_s)\n    result_s = \"\".join(result_s_chars)\n\n    is_pal = result_s == result_s[::-1]\n\n    return (result_s, is_pal)"}
{"task_id": "HumanEval/112", "solution": "def _is_palindrome(s: str) -> bool:\n    \"\"\"\n    Checks if a string is a palindrome.\n    \"\"\"\n    return s == s[::-1]\ndef reverse_delete(s, c):\n    \"\"\"\n    Deletes characters from s present in c, then checks if the result is a palindrome.\n    Returns the modified string and the palindrome check result.\n    \"\"\"\n    chars_to_delete = set(c)\n    result_s_chars = [char for char in s if char not in chars_to_delete]\n    result_s = \"\".join(result_s_chars)\n\n    is_palindrome = _is_palindrome(result_s)\n\n    return (result_s, is_palindrome)"}
{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums):\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty sub-array.\n    This function implements a variant of Kadane's algorithm for minimum sum.\n    \"\"\"\n    min_current_sum = nums[0]\n    min_overall_sum = nums[0]\n\n    for i in range(1, len(nums)):\n        min_current_sum = min(nums[i], min_current_sum + nums[i])\n        min_overall_sum = min(min_overall_sum, min_current_sum)\n\n    return min_overall_sum"}
{"task_id": "HumanEval/113", "solution": "def odd_count(lst):\n    \"\"\"Given a list of strings of digits, return a list of formatted strings.\n    Each output string embeds the count of odd digits from the corresponding input string by replacing 'i's in a template.\n    \"\"\"\n    OUTPUT_TEMPLATE = \"the number of odd elements in the str of the nput.\"\n    results = []\n\n    for s in lst:\n        # Count odd digits in the current string\n        odd_digit_count = 0\n        for char in s:\n            if int(char) % 2 != 0:\n                odd_digit_count += 1\n        \n        # Format the output string by replacing 'i' with the count\n        formatted_string = OUTPUT_TEMPLATE.replace('i', str(odd_digit_count))\n        results.append(formatted_string)\n        \n    return results"}
{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums):\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty sub-array\n    of nums.\n    \"\"\"\n    min_so_far = nums[0]\n    current_min = nums[0]\n\n    for i in range(1, len(nums)):\n        current_min = min(nums[i], current_min + nums[i])\n        min_so_far = min(min_so_far, current_min)\n\n    return min_so_far"}
{"task_id": "HumanEval/115", "solution": "import math\ndef max_fill(grid, capacity):\n    \"\"\"\n    Calculates the minimum bucket operations to empty all wells in a grid.\n    Each '1' is a unit of water; operations are rounded up by bucket capacity.\n    \"\"\"\n    total_operations = 0\n    for well_row in grid:\n        water_units = sum(well_row)\n        if water_units > 0:\n            operations_for_well = math.ceil(water_units / capacity)\n            total_operations += operations_for_well\n    return total_operations"}
{"task_id": "HumanEval/115", "solution": "import math\ndef ceil_division(numerator, denominator):\n    # Performs ceiling division, rounding up the result to the nearest whole number.\n    # Assumes denominator is positive as per problem constraints.\n    return int(math.ceil(numerator / denominator))\ndef max_fill(grid, capacity):\n    \"\"\"\n    Calculates the minimum bucket lowering operations required to empty all wells in a grid.\n    Each '1' represents a water unit; all buckets have the same 'capacity'.\n    \"\"\"\n    total_bucket_lowerings = 0\n    for row in grid:\n        water_in_well = sum(row)\n        buckets_for_well = ceil_division(water_in_well, capacity)\n        total_bucket_lowerings += buckets_for_well\n    return total_bucket_lowerings"}
{"task_id": "HumanEval/113", "solution": "OUTPUT_TEMPLATE = \"the number of odd elements <count>n the str<count>ng <count> of the <count>nput.\"\ndef _count_odd_digits(digit_string: str) -> int:\n    \"\"\"Counts the number of odd digits in a string.\n    Assumes the input string contains only digits.\n    \"\"\"\n    odd_count_val = 0\n    for digit_char in digit_string:\n        if int(digit_char) % 2 != 0:\n            odd_count_val += 1\n    return odd_count_val\ndef _format_output_string(odd_count_val: int) -> str:\n    \"\"\"Formats the output string by replacing 'i' with the odd digit count.\n    Uses the globally defined OUTPUT_TEMPLATE.\n    \"\"\"\n    return OUTPUT_TEMPLATE.replace('i', str(odd_count_val))\ndef odd_count(lst: list[str]) -> list[str]:\n    \"\"\"Processes a list of digit-only strings, counting odd digits in each.\n    Returns a list of formatted descriptions with counts embedded.\n    \"\"\"\n    result = []\n    for item in lst:\n        odd_count_val = _count_odd_digits(item)\n        formatted_string = _format_output_string(odd_count_val)\n        result.append(formatted_string)\n    return result"}
{"task_id": "HumanEval/116", "solution": "def sort_array(arr):\n    \"\"\"\n    Sorts an array of non-negative integers by set bit count, then decimal value.\n    Negative numbers are sorted by decimal value and appear first.\n    \"\"\"\n\n    def _count_set_bits_inline(n):\n        \"\"\"Counts set bits in a non-negative integer using Brian Kernighan's algorithm.\"\"\"\n        count = 0\n        while n > 0:\n            n &= (n - 1)\n            count += 1\n        return count\n\n    def _get_sort_key_inline(n):\n        \"\"\"Generates a sorting key for an integer based on its sign and bit count.\"\"\"\n        if n >= 0:\n            return (_count_set_bits_inline(n), n)\n        else:\n            return (-1, n)\n\n    return sorted(arr, key=_get_sort_key_inline)"}
{"task_id": "HumanEval/117", "solution": "VOWELS = {'a', 'e', 'i', 'o', 'u'}\ndef _is_consonant(char: str) -> bool:\n    \"\"\"Checks if a character is a consonant.\"\"\"\n    char_lower = char.lower()\n    return char_lower.isalpha() and char_lower not in VOWELS\ndef _count_consonants_in_word(word: str) -> int:\n    \"\"\"Counts consonants in a single word.\"\"\"\n    count = 0\n    for char in word:\n        if _is_consonant(char):\n            count += 1\n    return count\ndef select_words(s, n):\n    \"\"\"\n    Returns a list of words from string s that contain exactly n consonants.\n    Words are returned in their original order.\n    \"\"\"\n    if not s:\n        return []\n\n    words = s.split()\n    result = []\n    for word in words:\n        if _count_consonants_in_word(word) == n:\n            result.append(word)\n    return result"}
{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"Finds the closest vowel surrounded by two consonants from the right side of the word.\n    Returns an empty string if no such vowel is found, preserving original case.\"\"\"\n\n    VOWELS = {'a', 'e', 'i', 'o', 'u'}\n\n    def is_vowel(char: str) -> bool:\n        \"\"\"Checks if a character is a vowel (case-insensitive).\"\"\"\n        return char.lower() in VOWELS\n\n    def is_consonant(char: str) -> bool:\n        \"\"\"Checks if a character is a consonant, assuming it's an English letter.\"\"\"\n        return char.isalpha() and not is_vowel(char)\n\n    n = len(word)\n    if n < 3:\n        return \"\"\n\n    # Iterate from the second-to-last character down to the second character.\n    # This range (n - 2, 0, -1) correctly skips the first and last characters.\n    for i in range(n - 2, 0, -1):\n        current_char = word[i]\n        left_char = word[i - 1]\n        right_char = word[i + 1]\n\n        if (is_vowel(current_char) and\n                is_consonant(left_char) and\n                is_consonant(right_char)):\n            return current_char\n            \n    return \"\""}
{"task_id": "HumanEval/116", "solution": "def sort_array(arr):\n    \"\"\"\n    Sorts an array of integers by the count of '1's in their binary representation,\n    then by their decimal value for ties.\n    \"\"\"\n\n    def _count_set_bits(n: int) -> int:\n        \"\"\"Counts set bits in an integer, using its absolute value for negative numbers.\"\"\"\n        if n == 0:\n            return 0\n        num = abs(n)\n        count = 0\n        while num > 0:\n            num &= (num - 1)  # Brian Kernighan's algorithm\n            count += 1\n        return count\n\n    def _get_sort_key(num: int) -> tuple[int, int]:\n        \"\"\"Generates a tuple (set_bit_count, decimal_value) for sorting.\"\"\"\n        set_bit_count = _count_set_bits(num)\n        return (set_bit_count, num)\n\n    return sorted(arr, key=_get_sort_key)"}
{"task_id": "HumanEval/118", "solution": "VOWELS_LOWER_CONSTANT = \"aeiou\"\ndef _is_vowel(char: str) -> bool:\n    \"\"\"Checks if a character is an English vowel (case-insensitive).\"\"\"\n    return char.lower() in VOWELS_LOWER_CONSTANT\ndef _is_consonant(char: str) -> bool:\n    \"\"\"Checks if a character is an English consonant (case-insensitive).\"\"\"\n    return char.isalpha() and not _is_vowel(char)\ndef get_closest_vowel(word: str) -> str:\n    \"\"\"Finds the closest vowel from the right, surrounded by two consonants, preserving case.\n    Vowels at the beginning or end of the word do not count; returns an empty string if no such vowel is found.\n    \"\"\"\n    n = len(word)\n    if n < 3:\n        return \"\"\n\n    for i in range(n - 2, 0, -1): # Iterate from right to left, excluding the first and last characters.\n        current_char = word[i]\n        left_char = word[i - 1]\n        right_char = word[i + 1]\n\n        if _is_vowel(current_char) and _is_consonant(left_char) and _is_consonant(right_char):\n            return current_char # Return the first qualifying vowel found, preserving its original case.\n            \n    return \"\" # Return an empty string if no qualifying vowel is found."}
{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"Given a string s and a natural number n, returns a list of all words\n    that contain exactly n consonants, preserving order.\n    \"\"\"\n    if not s:\n        return []\n\n    def _count_consonants(word):\n        \"\"\"Counts consonants in a word, ignoring non-alphabetic characters.\"\"\"\n        VOWELS = \"aeiou\"\n        count = 0\n        for char in word:\n            lower_char = char.lower()\n            if 'a' <= lower_char <= 'z' and lower_char not in VOWELS:\n                count += 1\n        return count\n\n    words = s.split()\n    result = []\n    for word in words:\n        consonant_count = _count_consonants(word)\n        if consonant_count == n:\n            result.append(word)\n    return result"}
{"task_id": "HumanEval/119", "solution": "class ParenthesesBalancer:\n    \"\"\"Utility to check if a single string of parentheses is balanced.\"\"\"\n    def is_balanced(self, s: str) -> bool:\n        \"\"\"Checks if the given string 's' is a balanced parentheses string.\"\"\"\n        balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            elif char == ')':\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\nclass ParenthesesMatcher:\n    \"\"\"Orchestrates the matching logic for two parentheses strings.\"\"\"\n    def __init__(self, balancer: ParenthesesBalancer):\n        self.balancer = balancer\n\n    def check_possible(self, s1: str, s2: str) -> bool:\n        \"\"\"Checks if concatenating s1 and s2 in either order results in a balanced string.\"\"\"\n        if self.balancer.is_balanced(s1 + s2):\n            return True\n        if self.balancer.is_balanced(s2 + s1):\n            return True\n        return False\ndef match_parens(lst):\n    \"\"\"\n    Checks if two strings of parentheses can be concatenated in any order\n    to form a balanced string.\n    \"\"\"\n    s1, s2 = lst\n    \n    balancer = ParenthesesBalancer()\n    matcher = ParenthesesMatcher(balancer)\n\n    if matcher.check_possible(s1, s2):\n        return 'Yes'\n    else:\n        return 'No'"}
{"task_id": "HumanEval/120", "solution": "def maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a non-negative integer k,\n    return a sorted list of length k with the maximum k numbers in arr.\n    \"\"\"\n    if k == 0:\n        return []\n\n    arr.sort(reverse=True)\n    top_k_elements = arr[:k]\n    top_k_elements.sort()\n\n    return top_k_elements"}
{"task_id": "HumanEval/120", "solution": "def maximum(arr, k):\n    \"\"\"\n    Given an array arr of integers and a non-negative integer k, return a sorted list\n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    if k == 0:\n        return []\n\n    # Sort the array in descending order to easily pick the largest k elements.\n    sorted_arr_desc = sorted(arr, reverse=True)\n\n    # Take the first k elements (which are the largest), then sort them ascending.\n    top_k_elements = sorted_arr_desc[:k]\n    return sorted(top_k_elements)"}
{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    \"\"\"\n    Checks if two given strings of parentheses can form a balanced string\n    when concatenated in any order.\n    \"\"\"\n\n    def _calculate_balance_properties(s: str) -> tuple[int, int]:\n        \"\"\"Calculates net balance and minimum prefix balance for a string.\"\"\"\n        balance = 0\n        min_balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            else:\n                balance -= 1\n            min_balance = min(min_balance, balance)\n        return balance, min_balance\n\n    def _is_concatenation_balanced(s1_props: tuple[int, int], s2_props: tuple[int, int]) -> bool:\n        \"\"\"Checks if s1 followed by s2 forms a balanced string.\"\"\"\n        net_bal_s1, min_bal_s1 = s1_props\n        net_bal_s2, min_bal_s2 = s2_props\n\n        # The total net balance of the concatenated string must be zero.\n        if net_bal_s1 + net_bal_s2 != 0:\n            return False\n\n        # The balance must never drop below zero at any point during the first string.\n        if min_bal_s1 < 0:\n            return False\n\n        # The balance must never drop below zero at any point during the second string,\n        # relative to the balance accumulated from the first string.\n        if net_bal_s1 + min_bal_s2 < 0:\n            return False\n\n        return True\n\n    s1, s2 = lst[0], lst[1]\n\n    # Calculate properties for both strings.\n    s1_props = _calculate_balance_properties(s1)\n    s2_props = _calculate_balance_properties(s2)\n\n    # Check if s1 + s2 forms a balanced string.\n    if _is_concatenation_balanced(s1_props, s2_props):\n        return 'Yes'\n\n    # Check if s2 + s1 forms a balanced string.\n    if _is_concatenation_balanced(s2_props, s1_props):\n        return 'Yes'\n\n    return 'No'"}
