{"task_id": "HumanEval/39", "solution": "import math\nfrom typing import Iterator\ndef _is_prime(num: int) -> bool:\n    \"\"\"Checks if a given number is prime.\n    It handles numbers less than 2, 2, even numbers, and then odd divisors up to the square root.\"\"\"\n    if num < 2:\n        return False\n    if num == 2:\n        return True\n    if num % 2 == 0:\n        return False\n    for i in range(3, int(math.sqrt(num)) + 1, 2):\n        if num % i == 0:\n            return False\n    return True\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    prime_fib_count = 0\n    fib_gen = _fibonacci_generator()\n\n    # Skip initial Fibonacci numbers 0, 1, 1 to align with the problem's examples.\n    # The first prime Fibonacci number is 2 (F(3)).\n    next(fib_gen) # Skips 0 (F(0))\n    next(fib_gen) # Skips 1 (F(1))\n    next(fib_gen) # Skips 1 (F(2))\n\n    while True:\n        fib_num = next(fib_gen)\n        if _is_prime(fib_num):\n            prime_fib_count += 1\n            if prime_fib_count == n:\n                return fib_num"}
{"task_id": "HumanEval/39", "solution": "def prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    \"\"\"\n\n    fib_cache = {1: 1, 2: 1} # Stores already computed Fibonacci numbers for memoization.\n\n    def get_nth_fib_internal(k: int) -> int:\n        \"\"\"Calculates the Kth Fibonacci number, using and updating the fib_cache.\"\"\"\n        if k in fib_cache:\n            return fib_cache[k]\n\n        # Calculate iteratively to fill cache up to k\n        for i in range(max(fib_cache.keys()) + 1, k + 1):\n            fib_cache[i] = fib_cache[i-1] + fib_cache[i-2]\n        return fib_cache[k]\n\n    prime_cache = {0: False, 1: False, 2: True, 3: True} # Stores primality results for memoization.\n\n    def is_prime_internal(num: int) -> bool:\n        \"\"\"Determines if a number is prime, using and updating the prime_cache.\"\"\"\n        if num in prime_cache:\n            return prime_cache[num]\n\n        if num < 2:\n            prime_cache[num] = False\n            return False\n        if num % 2 == 0:\n            prime_cache[num] = False\n            return False\n\n        # Check for odd divisors from 3 up to the square root of num.\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                prime_cache[num] = False\n                return False\n            i += 2\n\n        prime_cache[num] = True\n        return True\n\n    prime_fib_count = 0\n    fib_index = 1\n    while True:\n        fib_number = get_nth_fib_internal(fib_index)\n        \n        # Numbers less than 2 (0, 1) are not prime by definition.\n        if fib_number < 2:\n            fib_index += 1\n            continue\n            \n        if is_prime_internal(fib_number):\n            prime_fib_count += 1\n            if prime_fib_count == n:\n                return fib_number\n        fib_index += 1"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list) -> bool:\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    It returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    if len(l) < 3:\n        return False\n\n    # Sort the list to efficiently find triplets using the two-pointer approach.\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    for i in range(n - 2):\n        # Skip duplicate elements for the first number to avoid redundant calculations.\n        if i > 0 and sorted_l[i] == sorted_l[i-1]:\n            continue\n\n        left, right = i + 1, n - 1\n        while left < right:\n            current_sum = sorted_l[i] + sorted_l[left] + sorted_l[right]\n            if current_sum == 0:\n                return True\n            elif current_sum < 0:\n                left += 1\n            else:\n                right -= 1\n    return False"}
