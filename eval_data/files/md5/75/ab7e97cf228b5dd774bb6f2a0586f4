{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int) -> int:\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    largest_factor = 1\n    d = 2\n    temp_n = n\n    while d * d <= temp_n:\n        if temp_n % d == 0:\n            largest_factor = d\n            while temp_n % d == 0:\n                temp_n //= d\n        d += 1\n    if temp_n > 1:\n        largest_factor = temp_n\n    return largest_factor"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\n     Return derivative of this polynomial in the same form.\n    >>> derivative([3, 1, 2, 4, 5])\n    [1, 4, 12, 20]\n    >>> derivative([1, 2, 3])\n    [2, 6]\n    \"\"\"\n    if not xs or len(xs) == 1:\n        return []\n\n    derivative_coeffs = []\n    for i in range(1, len(xs)):\n        derivative_coeffs.append(xs[i] * i)\n    return derivative_coeffs"}
{"task_id": "HumanEval/63", "solution": "_memo = {}\ndef fibfib(n: int):\n    \"\"\"Computes the n-th element of the FibFib number sequence using memoization.\n    It handles base cases for n=0, 1, 2 and recursively calculates for n > 2.\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 1\n\n    if n in _memo:\n        return _memo[n]\n\n    result = fibfib(n - 1) + fibfib(n - 2) + fibfib(n - 3)\n    _memo[n] = result\n    return result"}
{"task_id": "HumanEval/61", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"(\" and \")\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n    balance = 0\n    for char in brackets:\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n        if balance < 0:\n            return False\n            \n    return balance == 0"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Counts the number of vowels in a word, including 'y' if at the end.\n    Vowel checks are case-insensitive.\"\"\"\n    vowel_count = 0\n    standard_vowels = {'a', 'e', 'i', 'o', 'u'}\n    word_length = len(s)\n\n    for i, char in enumerate(s):\n        lower_char = char.lower()\n        if lower_char in standard_vowels:\n            vowel_count += 1\n        elif lower_char == 'y' and i == word_length - 1:\n            vowel_count += 1\n            \n    return vowel_count"}
{"task_id": "HumanEval/63", "solution": "_fibfib_memo: dict[int, int] = {\n    0: 0,\n    1: 0,\n    2: 1\n}\ndef fibfib(n: int) -> int:\n    \"\"\"Computes the n-th element of the FibFib sequence using memoization.\n    It calculates recursive values and stores them in a cache for efficiency.\n    \"\"\"\n    if n in _fibfib_memo:\n        return _fibfib_memo[n]\n\n    result = fibfib(n - 1) + fibfib(n - 2) + fibfib(n - 3)\n    _fibfib_memo[n] = result\n    return result"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\" xs represent coefficients of a polynomial.\n    xs[0] + xs[1] * x + xs[2] * x^2 + ....\n     Return derivative of this polynomial in the same form.\n    >>> derivative([3, 1, 2, 4, 5])\n    [1, 4, 12, 20]\n    >>> derivative([1, 2, 3])\n    [2, 6]\n    \"\"\"\n    if not xs or len(xs) == 1:\n        return []\n\n    derived_coefficients = []\n    for i in range(1, len(xs)):\n        derived_coefficients.append(xs[i] * i)\n\n    return derived_coefficients"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string. If shift > number of digits, return digits reversed.\n    \"\"\"\n    is_negative = x < 0\n    x_str = str(abs(x))\n    num_digits = len(x_str)\n\n    if shift > num_digits:\n        shifted_str = x_str[::-1]\n    else:\n        effective_shift = shift % num_digits\n        shifted_str = x_str[-effective_shift:] + x_str[:-effective_shift]\n    \n    if is_negative:\n        return \"-\" + shifted_str\n    return shifted_str"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s: str) -> int:\n    \"\"\"Write a function vowels_count which takes a string representing\n    a word as input and returns the number of vowels in the string.\n    Vowels in this case are 'a', 'e', 'i', 'o', 'u'. Here, 'y' is also a\n    vowel, but only when it is at the end of the given word.\n    \"\"\"\n    count = 0\n    standard_vowels = {'a', 'e', 'i', 'o', 'u'}\n    \n    # Handle empty strings as per FR5.\n    if not s:\n        return 0\n\n    # Iterate through the string to identify and count vowels case-insensitively.\n    for i, char in enumerate(s):\n        char_lower = char.lower()\n        \n        if char_lower in standard_vowels:  # FR1: Count standard vowels.\n            count += 1\n        elif char_lower == 'y' and i == len(s) - 1:  # FR2: Count 'y' if it is the last character.\n            count += 1\n            \n    return count"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"Calculates the sum of the ASCII codes of only the uppercase characters in a string.\n    The function iterates through the input string and adds the ASCII value of each uppercase character to a running total.\n    \"\"\"\n    total_sum = 0\n    for char in s:\n        if char.isupper():\n            total_sum += ord(char)\n    return total_sum"}
{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"Calculates the sum of the ASCII codes of only the uppercase characters in an input string `s`.\n    It iterates through the string, summing the ordinal values of uppercase letters.\"\"\"\n    total_sum = 0\n    for char in s:\n        if char.isupper():\n            total_sum += ord(char)\n    return total_sum"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    \"\"\"\n    s = str(abs(x))\n    n = len(s)\n\n    if shift > n:\n        return s[::-1]\n    else:\n        effective_shift = shift % n\n        return s[-effective_shift:] + s[:-effective_shift]"}
{"task_id": "HumanEval/67", "solution": "import re\ndef fruit_distribution(s,n):\n    \"\"\"\n    Calculates the number of mangoes given a string describing apples and oranges\n    and the total number of fruits.\n    \"\"\"\n    # Parse the number of apples from the string.\n    # Critical: Trusting input, no error handling for missing patterns.\n    apples_match = re.search(r\"(\\d+)\\s*apples\", s)\n    apples = int(apples_match.group(1))\n\n    # Parse the number of oranges from the string.\n    # Critical: Trusting input, no error handling for missing patterns.\n    oranges_match = re.search(r\"(\\d+)\\s*oranges\", s)\n    oranges = int(oranges_match.group(1))\n\n    # Calculate the sum of apples and oranges.\n    total_known_fruits = apples + oranges\n\n    # Calculate and return the number of mangoes.\n    # Critical: Trusting input, no error handling for negative mangoes.\n    return n - total_known_fruits"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even value and its index from an array of non-negative integers.\n    Returns `[value, index]` or `[]` if no even values are found or the array is empty.\n    \"\"\"\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for i, value in enumerate(arr):\n        if value % 2 == 0:  # Check if the value is even\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = i\n            elif value == smallest_even_value and i < smallest_even_index:\n                # If values are equal, prioritize the smallest index\n                smallest_even_index = i\n    \n    if smallest_even_index == -1:\n        return []\n    else:\n        return [smallest_even_value, smallest_even_index]"}
{"task_id": "HumanEval/67", "solution": "import re\nclass FruitParser:\n    # Regular expression to match fruit counts.\n    REGEX_FRUIT_COUNTS = r\"(\\d+)\\s*apples\\s*and\\s*(\\d+)\\s*oranges\"\n\n    def parse(self, s):\n        # Parses the input string to extract apple and orange counts.\n        match = re.search(self.REGEX_FRUIT_COUNTS, s)\n        apples = int(match.group(1))\n        oranges = int(match.group(2))\n        return apples, oranges\nclass FruitCalculator:\n    def calculate_mangoes(self, total_fruits, apples, oranges):\n        # Calculates the number of mango fruits.\n        sum_apples_oranges = apples + oranges\n        return total_fruits - sum_apples_oranges\ndef fruit_distribution(s,n):\n    \"\"\"\n    In this task, you will be given a string that represents a number of apples and oranges \n    that are distributed in a basket of fruit this basket contains \n    apples, oranges, and mango fruits. Given the string that represents the total number of \n    the oranges and apples and an integer that represent the total number of the fruits \n    in the basket return the number of the mango fruits in the basket.\n    for examble:\n    fruit_distribution(\"5 apples and 6 oranges\", 19) ->19 - 5 - 6 = 8\n    fruit_distribution(\"0 apples and 1 oranges\",3) -> 3 - 0 - 1 = 2\n    fruit_distribution(\"2 apples and 3 oranges\", 100) -> 100 - 2 - 3 = 95\n    fruit_distribution(\"100 apples and 1 oranges\",120) -> 120 - 100 - 1 = 19\n    \"\"\"\n    # Orchestrates parsing and calculation to find the number of mangoes.\n    parser = FruitParser()\n    apples, oranges = parser.parse(s)\n    \n    calculator = FruitCalculator()\n    mangoes = calculator.calculate_mangoes(n, apples, oranges)\n    \n    return mangoes"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even-valued node in an array.\n    If multiple nodes have the same smallest even value, the one with the smallest index is chosen.\n    \"\"\"\n    if not arr:\n        return []\n\n    smallest_even_value = None\n    smallest_even_index = None\n\n    for i, num in enumerate(arr):\n        if num % 2 == 0:  # Check if the number is even\n            if smallest_even_value is None or num < smallest_even_value:\n                # First even number or a new smaller even number found\n                smallest_even_value = num\n                smallest_even_index = i\n            elif num == smallest_even_value and i < smallest_even_index:\n                # Same smallest even value, but current index is smaller\n                smallest_even_index = i\n    \n    if smallest_even_value is not None:\n        return [smallest_even_value, smallest_even_index]\n    else:\n        # No even numbers were found in the array\n        return []"}
{"task_id": "HumanEval/69", "solution": "from collections import Counter\ndef search(lst):\n    \"\"\"\n    Returns the greatest integer that is greater than zero and has a frequency\n    greater than or equal to the value of the integer itself.\n    If no such a value exists, returns -1.\n    \"\"\"\n    frequency_map = Counter(lst)\n    \n    # Iterate through unique numbers in descending order to efficiently find the greatest.\n    sorted_unique_numbers = sorted(frequency_map.keys(), reverse=True)\n\n    for num in sorted_unique_numbers:\n        # Check if the number's frequency meets the condition.\n        # All input numbers are positive as per problem constraints.\n        if frequency_map[num] >= num:\n            return num\n    \n    # If no qualifying number is found after checking all, return -1.\n    return -1"}
{"task_id": "HumanEval/69", "solution": "from collections import Counter\ndef search(lst):\n    \"\"\"\n    Finds the greatest integer in a list whose frequency is greater than or equal to its value.\n    Returns -1 if no such integer exists.\n    \"\"\"\n    frequencies = Counter(lst)\n\n    qualifying_integers = []\n    for num, freq in frequencies.items():\n        # Integers are guaranteed to be positive; check if frequency meets the criteria.\n        if freq >= num:\n            qualifying_integers.append(num)\n\n    if not qualifying_integers:\n        return -1\n\n    return max(qualifying_integers)"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    \"\"\"\n    Given list of integers, return list in strange order.\n    Strange sorting starts with the minimum, then maximum of remaining, and so on.\n    \"\"\"\n    if not lst:\n        return []\n\n    # Create a sorted copy of the list.\n    sorted_copy = sorted(lst)\n    result = []\n    is_min_turn = True\n\n    # Alternate taking the smallest and largest remaining elements.\n    while sorted_copy:\n        if is_min_turn:\n            result.append(sorted_copy.pop(0))\n        else:\n            result.append(sorted_copy.pop())\n        is_min_turn = not is_min_turn\n\n    return result"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    \"\"\"\n    Given a list of integers, return a new list sorted such that it alternates\n    between the minimum and maximum remaining elements.\n    \"\"\"\n    if not lst:\n        return []\n\n    # Create a sorted copy of the input list.\n    sorted_data = sorted(lst)\n    result = []\n\n    left = 0\n    right = len(sorted_data) - 1\n    is_min_turn = True\n\n    while left <= right:\n        if is_min_turn:\n            result.append(sorted_data[left])\n            left += 1\n        else:\n            result.append(sorted_data[right])\n            right -= 1\n        is_min_turn = not is_min_turn\n    return result"}
{"task_id": "HumanEval/71", "solution": "import math\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle, return its area.\n    Returns -1 if sides do not form a valid triangle, otherwise area rounded to 2 decimal points.\n    '''\n    # Validate if sides are positive and satisfy triangle inequality.\n    if a <= 0 or b <= 0 or c <= 0 or \\\n       not ((a + b > c) and (a + c > b) and (b + c > a)):\n        return -1.0\n\n    # Calculate semi-perimeter and then area using Heron's formula.\n    s = (a + b + c) / 2\n    area_squared = s * (s - a) * (s - b) * (s - c)\n\n    # Handle potential floating point inaccuracies for near-invalid triangles.\n    if area_squared < 0:\n        return -1.0\n\n    area = math.sqrt(area_squared)\n    return round(area, 2)"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr: list[int]) -> int:\n    \"\"\"Calculates the minimum changes to make an array palindromic, where a change is altering one element.\n    A palindromic array reads the same forwards and backwards.\n    \"\"\"\n    changes_count = 0\n    left, right = 0, len(arr) - 1\n\n    while left < right:\n        if arr[left] != arr[right]:\n            changes_count += 1\n        left += 1\n        right -= 1\n    return changes_count"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    \"\"\"\n    Determines if the object q will fly based on balance (palindromic list)\n    and total weight being less than or equal to the maximum allowed weight w.\n    \"\"\"\n    is_balanced = q == q[::-1]\n    total_weight = sum(q)\n    is_within_weight_limit = total_weight <= w\n    return is_balanced and is_within_weight_limit"}
{"task_id": "HumanEval/71", "solution": "def triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle, calculate its area.\n    Returns the area rounded to 2 decimal points, or -1.0 if invalid.\n    '''\n    # Validate triangle: all sides must be positive and satisfy triangle inequality.\n    if not (a > 0 and b > 0 and c > 0 and a + b > c and a + c > b and b + c > a):\n        return -1.0\n    \n    # Calculate semi-perimeter\n    s = (a + b + c) / 2\n    \n    # Calculate area using Heron's formula.\n    # Handle potential floating point inaccuracies by capping area_squared at zero.\n    area_squared = s * (s - a) * (s - b) * (s - c)\n    if area_squared < 0:\n        area_squared = 0.0\n        \n    area = area_squared**0.5\n    \n    return round(area, 2)"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Calculates the minimum number of changes needed to make an array palindromic.\n    One change involves altering a single element.\n    \"\"\"\n    n = len(arr)\n    changes = 0\n    for i in range(n // 2):\n        if arr[i] != arr[n - 1 - i]:\n            changes += 1\n    return changes"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    '''\n    Checks if an object q will fly based on it being a palindromic list and its sum of elements being less than or equal to w.\n    Assumes q is a list and w is a number.\n    '''\n    is_palindromic = (q == q[::-1])\n    total_weight = sum(q)\n    is_within_weight_limit = (total_weight <= w)\n\n    return is_palindromic and is_within_weight_limit"}
