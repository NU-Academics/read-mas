{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Write a function that takes a message, and encodes in such a \n    way that it swaps case of all letters, replaces all vowels in \n    the message with the letter that appears 2 places ahead of that \n    vowel in the english alphabet. \n    Assume only letters. \n    \"\"\"\n    VOWELS_LOWER = {'a', 'e', 'i', 'o', 'u'}\n    ALPHABET_LOWER = \"abcdefghijklmnopqrstuvwxyz\"\n    ALPHABET_UPPER = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"\n\n    ALPHABET_MAP_LOWER = {\n        ALPHABET_LOWER[i]: ALPHABET_LOWER[(i + 2) % len(ALPHABET_LOWER)]\n        for i in range(len(ALPHABET_LOWER))\n    }\n    ALPHABET_MAP_UPPER = {\n        ALPHABET_UPPER[i]: ALPHABET_UPPER[(i + 2) % len(ALPHABET_UPPER)]\n        for i in range(len(ALPHABET_UPPER))\n    }\n\n    encoded_chars = []\n    for char in message:\n        if not char.isalpha():\n            encoded_chars.append(char)\n            continue\n\n        original_char_is_lower = char.islower()\n        \n        # Step 1: Swap case of the letter.\n        case_swapped_char = char.swapcase()\n\n        # Step 2: Replace original vowels with shifted letters, maintaining case.\n        is_original_vowel = (char.lower() in VOWELS_LOWER)\n        \n        if is_original_vowel:\n            if original_char_is_lower:\n                # Original was lowercase vowel, case-swapped is uppercase. Use uppercase map.\n                shifted_char = ALPHABET_MAP_UPPER[case_swapped_char]\n            else:\n                # Original was uppercase vowel, case-swapped is lowercase. Use lowercase map.\n                shifted_char = ALPHABET_MAP_LOWER[case_swapped_char]\n            encoded_chars.append(shifted_char)\n        else:\n            encoded_chars.append(case_swapped_char)\n    \n    return \"\".join(encoded_chars)"}
{"task_id": "HumanEval/94", "solution": "def is_prime(n: int) -> bool:\n    # Checks if the given integer n is a prime number.\n    # Returns True if prime, False otherwise.\n    if n < 2:\n        return False\n    i = 2\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 1\n    return True\ndef sum_digits(n: int) -> int:\n    # Calculates the sum of the absolute value of the digits of the given integer n.\n    # It repeatedly adds the last digit and removes it until n becomes 0.\n    digit_sum = 0\n    abs_n = abs(n)\n    while abs_n > 0:\n        digit_sum += abs_n % 10\n        abs_n //= 10\n    return digit_sum\ndef find_largest_prime(numbers: list[int]) -> int | None:\n    # Finds the largest prime number within a list of integers.\n    # Returns the largest prime or None if no primes are found.\n    largest_prime = None\n    for num in numbers:\n        if is_prime(num):\n            if largest_prime is None or num > largest_prime:\n                largest_prime = num\n    return largest_prime\ndef skjkasdkd(lst: list[int]) -> int:\n    \"\"\"Finds the largest prime in a list and returns the sum of its digits.\n    Returns 0 if no prime numbers are found in the list.\"\"\"\n    largest_prime = find_largest_prime(lst)\n    if largest_prime is None:\n        return 0\n    return sum_digits(largest_prime)"}
