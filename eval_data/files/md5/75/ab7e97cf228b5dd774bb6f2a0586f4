{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n\n    which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    total_count = 0\n    for i in range(1, n):\n        if i % 11 == 0 or i % 13 == 0:\n            total_count += str(i).count('7')\n    return total_count"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list) -> list:\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    \n    even_elements = []\n    for i in range(len(l)):\n        if i % 2 == 0:\n            even_elements.append(l[i])\n\n    even_elements.sort()\n\n    result_list = list(l)\n\n    even_idx_counter = 0\n    for i in range(len(result_list)):\n        if i % 2 == 0:\n            result_list[i] = even_elements[even_idx_counter]\n            even_idx_counter += 1\n            \n    return result_list"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    Takes a string encoded with encode_cyclic and returns the original string.\n    Groups with fewer than three characters are unchanged.\n    \"\"\"\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    decoded_groups = []\n    for group in groups:\n        if len(group) == 3:\n            decoded_groups.append(group[-1] + group[:-1])\n        else:\n            decoded_groups.append(group)\n    return \"\".join(decoded_groups)"}
{"task_id": "HumanEval/32", "solution": "import math\ndef poly(xs: list, x: float):\n    \"\"\"Evaluates polynomial with coefficients xs at point x.\n    Returns xs[0] + xs[1] * x + xs[2] * x^2 + ... + xs[n] * x^n.\n    \"\"\"\n    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])\ndef find_zero(xs: list):\n    \"\"\"Finds a single real zero point x such that poly(x) = 0.\n    This function applies to polynomials with an even number of coefficients, guaranteeing a solution.\n    \"\"\"\n    \n    tolerance = 1e-6\n    max_iterations = 100\n\n    func = lambda val: poly(xs, val)\n\n    # Initial search interval for bisection.\n    # For odd-degree polynomials (implied by an even number of coefficients),\n    # a sufficiently wide range guarantees at least one real root is bracketed.\n    # The problem statement guarantees a solution for these polynomial types.\n    a, b = -100000.0, 100000.0\n\n    fa = func(a)\n    fb = func(b)\n\n    # Immediately check if the boundaries are already roots.\n    if abs(fa) < tolerance:\n        return a\n    if abs(fb) < tolerance:\n        return b\n    \n    # Proceed with bisection, trusting that a root is bracketed for the given polynomial types.\n    for _ in range(max_iterations):\n        mid = (a + b) / 2\n        f_mid = func(mid)\n\n        # Check for convergence: midpoint is close to zero or interval is sufficiently small.\n        if abs(f_mid) < tolerance or (b - a) / 2 < tolerance:\n            return mid\n\n        # Adjust the interval based on the sign of f_mid.\n        # This relies on fa and fb (or subsequent updated values) maintaining opposite signs.\n        if fa * f_mid < 0:  # Root is in the left half [a, mid]\n            b = mid\n            fb = f_mid\n        else:  # Root is in the right half [mid, b]\n            a = mid\n            fa = f_mid\n\n    # If maximum iterations reached, return the current midpoint as the best approximation.\n    return (a + b) / 2"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # split string to groups. Each of length 3.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n    # reverse cycle elements in each group. Unless group has fewer elements than 3.\n    groups = [(group[2] + group[0] + group[1]) if len(group) == 3 else group for group in groups]\n    return \"\".join(groups)"}
{"task_id": "HumanEval/36", "solution": "class DigitCounter:\n    def count_digit_in_number(self, number: int, digit: int) -> int:\n        \"\"\"Counts occurrences of a specific digit in a number.\"\"\"\n        count = 0\n        num_str = str(number)\n        for char in num_str:\n            if int(char) == digit:\n                count += 1\n        return count\nTARGET_DIGIT = 7\nDIVISOR_1 = 11\nDIVISOR_2 = 13\nclass FizzBuzzCalculator:\n    def __init__(self):\n        self.digit_counter = DigitCounter()\n\n    def calculate(self, n: int) -> int:\n        \"\"\"\n        Counts occurrences of the digit 7 in numbers less than n, divisible by 11 or 13.\n        It iterates from 1 up to n-1, checks divisibility, and sums digit counts.\n        \"\"\"\n        total_sevens = 0\n        for i in range(1, n):\n            if (i % DIVISOR_1 == 0) or (i % DIVISOR_2 == 0):\n                total_sevens += self.digit_counter.count_digit_in_number(i, TARGET_DIGIT)\n        return total_sevens\ndef fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n\n    which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    calculator = FizzBuzzCalculator()\n    return calculator.calculate(n)"}
