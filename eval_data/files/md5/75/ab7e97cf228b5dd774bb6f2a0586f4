{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"The Fib4 number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fib4(0) -> 0\n    fib4(1) -> 0\n    fib4(2) -> 2\n    fib4(3) -> 0\n    fib4(n) -> fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4).\n    Please write a function to efficiently compute the n-th element of the fib4 number sequence.  Do not use recursion.\n    >>> fib4(5)\n    4\n    >>> fib4(6)\n    8\n    >>> fib4(7)\n    14\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # For n > 3, compute iteratively using dynamic programming.\n    # We store the last four computed values to sum for the next term.\n    a, b, c, d = 0, 0, 2, 0 # Corresponds to fib4(i-4), fib4(i-3), fib4(i-2), fib4(i-1) initially for i=4\n\n    for _ in range(4, n + 1):\n        next_fib = a + b + c + d\n        a, b, c, d = b, c, d, next_fib\n\n    return d"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int) -> int:\n    \"\"\"Computes the n-th element of the Fib4 number sequence iteratively.\n    This function avoids recursion for efficiency as required.\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # Initialize with the base values: [fib4(0), fib4(1), fib4(2), fib4(3)]\n    last_four = [0, 0, 2, 0]\n\n    for i in range(4, n + 1):\n        # Calculate the next Fib4 number using the sum of the last four\n        next_fib4 = sum(last_four)\n        # Shift the window: remove the oldest, add the newest\n        last_four.pop(0)\n        last_four.append(next_fib4)\n\n    # The last element in the list is fib4(n)\n    return last_four[3]"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    if n % 2 == 1:\n        return sorted_l[n // 2]\n    else:\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        return (mid1 + mid2) / 2.0"}
