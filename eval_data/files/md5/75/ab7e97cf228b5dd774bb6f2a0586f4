{"task_id": "HumanEval/148", "solution": "class PlanetOrder:\n    # Contains the names of the eight planets in order from the Sun.\n    PLANET_NAMES: list[str] = [\n        \"Mercury\", \"Venus\", \"Earth\", \"Mars\",\n        \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n    ]\n\n    def get_index(self, planet_name: str) -> int | None:\n        # Returns the 0-based index of a planet name, or None if not found.\n        try:\n            return self.PLANET_NAMES.index(planet_name.title())\n        except ValueError:\n            return None\n\n    def get_planet_by_index(self, index: int) -> str | None:\n        # Returns the planet name at a given index, or None if out of bounds.\n        if 0 <= index < len(self.PLANET_NAMES):\n            return self.PLANET_NAMES[index]\n        return None\n\n    def get_all_planets(self) -> tuple[str, ...]:\n        # Returns a tuple of all planet names in their defined order.\n        return tuple(self.PLANET_NAMES)\nclass PlanetService:\n    def __init__(self, planet_order: 'PlanetOrder'):\n        # Constructor, injects the PlanetOrder dependency.\n        self._planet_order = planet_order\n\n    def get_planets_between(self, planet1: str, planet2: str) -> tuple[str, ...]:\n        # Calculates and returns a tuple of planet names strictly between planet1 and planet2.\n        idx1 = self._planet_order.get_index(planet1)\n        idx2 = self._planet_order.get_index(planet2)\n\n        if idx1 is None or idx2 is None:\n            return ()\n\n        # Ensure start_idx is always the smaller index for consistent slicing.\n        start_idx = min(idx1, idx2)\n        end_idx = max(idx1, idx2)\n\n        # Return empty tuple if no planets are strictly between (adjacent or same).\n        if end_idx - start_idx <= 1:\n            return ()\n\n        intermediate_planets = self._planet_order.PLANET_NAMES[start_idx + 1:end_idx]\n        return tuple(intermediate_planets)\ndef bf(planet1, planet2):\n    '''\n    Returns a tuple containing all planets whose orbits are located strictly between\n    the orbit of planet1 and the orbit of planet2, sorted by proximity to the sun.\n    Returns an empty tuple if planet1 or planet2 are not correct planet names.\n    '''\n    planet_order_instance = PlanetOrder()\n    planet_service = PlanetService(planet_order_instance)\n    return planet_service.get_planets_between(planet1, planet2)"}
