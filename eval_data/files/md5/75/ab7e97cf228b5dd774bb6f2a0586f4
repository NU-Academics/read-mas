{"task_id": "HumanEval/91", "solution": "import re\nclass SentenceSplitter:\n    \"\"\"Splits text into sentences based on delimiters.\"\"\"\n    def split_sentences(self, text: str) -> list[str]:\n        if not text:\n            return []\n        # Splits by '.', '?', '!' and filters out any empty strings.\n        sentences = re.split(r'[.?!]', text)\n        return [s.strip() for s in sentences if s.strip()]\nclass WordChecker:\n    \"\"\"Checks if a sentence starts with the specific word \"I\".\"\"\"\n    def starts_with_i(self, sentence: str) -> bool:\n        if not sentence:\n            return False\n        # Splits the sentence into words and checks if the first word is \"I\".\n        words = sentence.split()\n        return words[0] == \"I\" if words else False\nclass BoredomCounter:\n    \"\"\"Orchestrates counting \"boredom\" sentences using SentenceSplitter and WordChecker.\"\"\"\n    def __init__(self, sentence_splitter: SentenceSplitter, word_checker: WordChecker):\n        self.sentence_splitter = sentence_splitter\n        self.word_checker = word_checker\n\n    def count_boredoms(self, text: str) -> int:\n        sentences = self.sentence_splitter.split_sentences(text)\n        boredom_count = 0\n        for sentence in sentences:\n            if self.word_checker.starts_with_i(sentence):\n                boredom_count += 1\n        return boredom_count\ndef is_bored(S):\n    \"\"\"\n    Counts the number of 'boredom' sentences in a string.\n    A boredom is a sentence that starts with the word \"I\".\n    \"\"\"\n    splitter = SentenceSplitter()\n    checker = WordChecker()\n    counter = BoredomCounter(splitter, checker)\n    return counter.count_boredoms(S)"}
{"task_id": "HumanEval/91", "solution": "import re\ndef is_bored(S):\n    \"\"\"\n    Counts the number of \"boredoms\" in a string.\n    A boredom is a sentence that starts with the word \"I\", delimited by '.', '?' or '!'.\n    \"\"\"\n    \n    # Split the input string into potential sentences using '.', '?', or '!' as delimiters.\n    sentences_raw = re.split(r'[.?!]', S)\n    \n    cleaned_sentences = []\n    for s_raw in sentences_raw:\n        # Trim leading/trailing whitespace from each potential sentence.\n        trimmed_sentence = s_raw.strip()\n        # Add to the list only if the sentence is not empty after trimming.\n        if trimmed_sentence:\n            cleaned_sentences.append(trimmed_sentence)\n            \n    boredom_count = 0\n    \n    for sentence in cleaned_sentences:\n        # Check if the sentence starts with 'I' or 'i' followed by a word boundary.\n        # The word boundary (\\b) ensures 'I' is a standalone word (e.g., 'I am', not 'I'm').\n        if re.match(r'^[Ii]\\b', sentence):\n            boredom_count += 1\n            \n    return boredom_count"}
