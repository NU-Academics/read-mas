{"task_id": "HumanEval/94", "solution": "def skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n    import math\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Determines if an integer n is a prime number.\n        Numbers less than or equal to 1 are not considered prime.\n        \"\"\"\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\n\n    def sum_digits(n: int) -> int:\n        \"\"\"Calculates the sum of the digits of an integer n.\n        It processes the absolute value of the number to sum its digits.\n        \"\"\"\n        s = 0\n        n = abs(n)\n        while n > 0:\n            s += n % 10\n            n //= 10\n        return s\n\n    largest_prime = 0\n    for num in lst:\n        if is_prime(num):\n            if num > largest_prime:\n                largest_prime = num\n    \n    if largest_prime > 0:\n        return sum_digits(largest_prime)\n    return 0"}
{"task_id": "HumanEval/96", "solution": "def count_up_to(n):\n    \"\"\"\n    Returns a list of all prime numbers strictly less than n.\n    This function efficiently identifies primes using an optimized trial division.\n    \"\"\"\n\n    def is_prime_helper(num):\n        \"\"\"\n        Determines if a given integer is a prime number.\n        Checks divisibility by odd numbers up to its square root.\n        \"\"\"\n        if num < 2:\n            return False\n        if num == 2:\n            return True\n        if num % 2 == 0:\n            return False\n        i = 3\n        while i * i <= num:\n            if num % i == 0:\n                return False\n            i += 2\n        return True\n\n    if n <= 2:\n        return []\n\n    primes = []\n    for num in range(2, n):\n        if is_prime_helper(num):\n            primes.append(num)\n    return primes"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower\n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    \"\"\"\n    if not dict:\n        return False\n\n    # Check if all keys are strings.\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False\n\n    all_lower_keys = True\n    all_upper_keys = True\n\n    for key_str in dict.keys():\n        # A key is considered all lowercase if `islower()` is true and it contains at least one alphabetic character.\n        is_current_key_lower = key_str.islower() and any(c.isalpha() for c in key_str)\n        if not is_current_key_lower:\n            all_lower_keys = False\n\n        # A key is considered all uppercase if `isupper()` is true and it contains at least one alphabetic character.\n        is_current_key_upper = key_str.isupper() and any(c.isalpha() for c in key_str)\n        if not is_current_key_upper:\n            all_upper_keys = False\n            \n        # Optimization: if neither case is possible, we can return early.\n        if not all_lower_keys and not all_upper_keys:\n            return False\n\n    return all_lower_keys or all_upper_keys"}
{"task_id": "HumanEval/96", "solution": "def count_up_to(n):\n    \"\"\"\n    Returns a list of all prime numbers strictly less than n.\n    Primes are identified using trial division up to the square root.\n    \"\"\"\n    def _is_prime(num):\n        \"\"\"\n        Determines if a given integer is a prime number.\n        Assumes num is a non-negative integer.\n        \"\"\"\n        if num < 2:\n            return False\n        for i in range(2, int(num**0.5) + 1):\n            if num % i == 0:\n                return False\n        return True\n\n    if n <= 1:\n        return []\n\n    primes = []\n    for num in range(2, n):\n        if _is_prime(num):\n            primes.append(num)\n    return primes"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Checks if all string keys in a dictionary are uniformly cased (all lowercase or all uppercase).\n    Returns False if the dictionary is empty or contains non-string keys or mixed casing.\n    \"\"\"\n    if not dict:\n        return False\n\n    string_keys = []\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False\n        string_keys.append(key)\n\n    # Check if all string keys are lowercase\n    all_lower = True\n    for key in string_keys:\n        if key != key.lower():\n            all_lower = False\n            break\n\n    if all_lower:\n        return True\n\n    # Check if all string keys are uppercase\n    all_upper = True\n    for key in string_keys:\n        if key != key.upper():\n            all_upper = False\n            break\n\n    if all_upper:\n        return True\n\n    return False"}
