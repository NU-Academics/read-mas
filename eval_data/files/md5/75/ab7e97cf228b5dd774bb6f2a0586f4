{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer. return a tuple that has the number of even and odd digits respectively.\n\n     Example:\n        even_odd_count(-12) ==> (1, 1)\n        even_odd_count(123) ==> (1, 2)\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n    \n    # Process the absolute value of the number.\n    abs_num_str = str(abs(num))\n\n    for digit_char in abs_num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n    \n    return (even_count, odd_count)"}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"Checks if the second word or any of its rotations is a substring in the first word.\"\"\"\n    if not b:\n        return True\n    \n    if len(b) > len(a):\n        return False\n\n    rotations = []\n    n = len(b)\n    for i in range(n):\n        rotated_b = b[i:] + b[:i]\n        rotations.append(rotated_b)\n    \n    for rot in rotations:\n        if rot in a:\n            return True\n            \n    return False"}
{"task_id": "HumanEval/154", "solution": "def _generate_rotations(s):\n    \"\"\"Generates all unique cyclic rotations of the input string s.\n    Returns a list of unique rotated strings.\"\"\"\n    if not s:\n        return [\"\"]\n\n    rotations = set()\n    n = len(s)\n    for i in range(n):\n        rotated_s = s[i:] + s[:i]\n        rotations.add(rotated_s)\n    return list(rotations)\ndef cycpattern_check(a , b):\n    \"\"\"\n    Checks if string 'b' or any of its cyclic rotations is a substring of string 'a'.\n    Returns True if a match is found, False otherwise.\n    \"\"\"\n    # Business rule: An empty string 'b' is a substring of any string 'a'.\n    if not b:\n        return True\n\n    # Business rule: If 'b' is longer than 'a', it cannot be a substring.\n    if len(b) > len(a):\n        return False\n\n    rotations_of_b = _generate_rotations(b)\n\n    for rotation in rotations_of_b:\n        if rotation in a:\n            return True\n    return False"}
{"task_id": "HumanEval/156", "solution": "ROMAN_MAP = [\n    (1000, 'm'), (900, 'cm'), (500, 'd'), (400, 'cd'),\n    (100, 'c'), (90, 'xc'), (50, 'l'), (40, 'xl'),\n    (10, 'x'), (9, 'ix'), (5, 'v'), (4, 'iv'), (1, 'i')\n]\ndef int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, obtain its roman numeral equivalent as a string,\n    and return it in lowercase. Restrictions: 1 <= num <= 1000\n    \"\"\"\n    roman_numeral_parts = []\n    temp_num = number\n    for value, symbol in ROMAN_MAP:\n        while temp_num >= value:\n            roman_numeral_parts.append(symbol)\n            temp_num -= value\n    return \"\".join(roman_numeral_parts)"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer, return its lowercase Roman numeral equivalent.\n    Assumes input number is within the range 1 to 1000 inclusive.\n    \"\"\"\n    roman_map = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'), (1, 'I')\n    ]\n\n    roman_numeral_parts = []\n    temp_num = number\n    for value, symbol in roman_map:\n        while temp_num >= value:\n            roman_numeral_parts.append(symbol)\n            temp_num -= value\n            \n    return \"\".join(roman_numeral_parts).lower()"}
