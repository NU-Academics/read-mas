{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Calculates the sum of decimal digits of N and returns it as a binary string.\n    N is a positive integer within the range 0 to 10000.\n    \"\"\"\n\n    def _calculate_digit_sum_inline(num: int) -> int:\n        \"\"\"Calculates the sum of the decimal digits of num.\"\"\"\n        total_sum = 0\n        s_num = str(num)\n        for digit_char in s_num:\n            total_sum += int(digit_char)\n        return total_sum\n\n    def _decimal_to_binary_inline(decimal_num: int) -> str:\n        \"\"\"Converts a non-negative decimal integer to its binary string representation.\"\"\"\n        if decimal_num == 0:\n            return \"0\"\n        return bin(decimal_num)[2:]\n\n    sum_of_digits = _calculate_digit_sum_inline(N)\n    binary_representation = _decimal_to_binary_inline(sum_of_digits)\n    return binary_representation"}
{"task_id": "HumanEval/82", "solution": "def prime_length(string):\n    \"\"\"Checks if the length of the input string is a prime number.\n    Returns True if the string length is prime, False otherwise.\"\"\"\n\n    def _is_prime(n):\n        \"\"\"Determines if an integer is a prime number.\"\"\"\n        if n < 2:\n            return False\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 1\n        return True\n\n    length = len(string)\n    return _is_prime(length)"}
{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    Constraints: 0 <= N <= 10000.\n    \"\"\"\n    decimal_sum = 0\n    # Calculate the sum of decimal digits by iterating through string representation.\n    for digit_char in str(N):\n        decimal_sum += int(digit_char)\n\n    # Convert the calculated decimal sum to its binary string representation.\n    return bin(decimal_sum)[2:]"}
{"task_id": "HumanEval/81", "solution": "def numerical_letter_grade(grades):\n    \"\"\"Converts a list of numerical GPAs into corresponding letter grades based on a predefined grading scale.\"\"\"\n    \n    result_grades = []\n    for gpa in grades:\n        # Apply the grading scale conditions sequentially from highest GPA to lowest.\n        if gpa == 4.0:\n            letter_grade = \"A+\"\n        elif gpa > 3.7:\n            letter_grade = \"A\"\n        elif gpa > 3.3:\n            letter_grade = \"A-\"\n        elif gpa > 3.0:\n            letter_grade = \"B+\"\n        elif gpa > 2.7:\n            letter_grade = \"B\"\n        elif gpa > 2.3:\n            letter_grade = \"B-\"\n        elif gpa > 2.0:\n            letter_grade = \"C+\"\n        elif gpa > 1.7:\n            letter_grade = \"C\"\n        elif gpa > 1.3:\n            letter_grade = \"C-\"\n        elif gpa > 1.0:\n            letter_grade = \"D+\"\n        elif gpa > 0.7:\n            letter_grade = \"D\"\n        elif gpa > 0.0:\n            letter_grade = \"D-\"\n        elif gpa == 0.0:\n            letter_grade = \"E\"\n        # The problem statement implies inputs will be within the defined grading scale.\n        # No explicit error handling for out-of-range or invalid inputs is added as per critical requirements.\n        result_grades.append(letter_grade)\n    return result_grades"}
{"task_id": "HumanEval/85", "solution": "def add(lst):\n    \"\"\"Given a non-empty list of integers lst. add the even elements that are at odd indices..\n\n    Examples:\n        add([4, 2, 6, 7]) ==> 2\n    \"\"\"\n    total_sum = 0\n    for i, num in enumerate(lst):\n        if i % 2 != 0 and num % 2 == 0:\n            total_sum += num\n    return total_sum"}
{"task_id": "HumanEval/81", "solution": "GRADING_SCALE = [\n    (4.0, \"A+\"),\n    (3.7, \"A\"),\n    (3.3, \"A-\"),\n    (3.0, \"B+\"),\n    (2.7, \"B\"),\n    (2.3, \"B-\"),\n    (2.0, \"C+\"),\n    (1.7, \"C\"),\n    (1.3, \"C-\"),\n    (1.0, \"D+\"),\n    (0.7, \"D\"),\n    (0.000001, \"D-\"),\n    (0.0, \"E\")\n]\ndef numerical_letter_grade(grades):\n    \"\"\"Converts a list of GPAs to a list of letter grades based on a predefined scale.\n    It iterates through the sorted grading scale, assigning the first matching grade.\n    \"\"\"\n    \n    result_grades = []\n    for gpa in grades:\n        letter_grade = \"E\"\n        for threshold, grade in GRADING_SCALE:\n            if gpa >= threshold:\n                letter_grade = grade\n                break\n        result_grades.append(letter_grade)\n    return result_grades"}
{"task_id": "HumanEval/85", "solution": "def add(lst):\n    \"\"\"Given a non-empty list of integers lst. add the even elements that are at odd indices.\n\n    Examples:\n        add([4, 2, 6, 7]) ==> 2\n    \"\"\"\n    total_sum = 0\n    for i, num in enumerate(lst):\n        # Check if the index is odd and the number is even.\n        if i % 2 != 0 and num % 2 == 0:\n            total_sum += num\n    return total_sum"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds all occurrences of integer x in the nested list lst and returns their (row, column) coordinates.\n    Coordinates are sorted by row ascending, then by column descending.\n    \"\"\"\n    found_coordinates = []\n    for r_idx, row in enumerate(lst):\n        for c_idx, val in enumerate(row):\n            if val == x:\n                found_coordinates.append((r_idx, c_idx))\n\n    # Sort by row ascending, then by column descending using a single key.\n    found_coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n    return found_coordinates"}
{"task_id": "HumanEval/86", "solution": "import re\ndef anti_shuffle(s):\n    \"\"\"\n    Takes a string and returns an ordered version of it.\n    Characters within each word are sorted alphabetically by ASCII value.\n    \"\"\"\n    if not s:\n        return \"\"\n\n    # Split the string by sequences of spaces, preserving the spaces themselves.\n    parts = re.split(r'(\\s+)', s)\n\n    result_parts = []\n    for part in parts:\n        if part.strip() == '':  # If the part consists only of spaces\n            result_parts.append(part)\n        else:  # It's a word, sort its characters\n            result_parts.append(\"\".join(sorted(part)))\n    \n    return \"\".join(result_parts)"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds occurrences of `x` in the 2D list `lst` and returns their 0-indexed `(row, column)` coordinates.\n    The coordinates are sorted by row ascending, then by column descending.\n    \"\"\"\n    coordinates = []\n    for r_idx, row in enumerate(lst):\n        for c_idx, val in enumerate(row):\n            if val == x:\n                coordinates.append((r_idx, c_idx))\n\n    coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n    return coordinates"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n    \"\"\"\n    if not array or len(array) <= 1:\n        return array[:]\n\n    copied_array = array[:]\n\n    first_element = copied_array[0]\n    last_element = copied_array[len(copied_array) - 1]\n    sum_first_last = first_element + last_element\n\n    if sum_first_last % 2 != 0:\n        copied_array.sort()\n    else:\n        copied_array.sort(reverse=True)\n\n    return copied_array"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Sorts an array of non-negative integers based on the parity of the sum of its first and last elements.\n    Returns a sorted copy in ascending order if the sum is odd, or descending if the sum is even.\n    \"\"\"\n    if not array or len(array) == 1:\n        return list(array)\n\n    array_copy = list(array)\n    first_element = array_copy[0]\n    last_element = array_copy[-1]\n\n    sum_is_odd = (first_element + last_element) % 2 != 0\n\n    if sum_is_odd:\n        array_copy.sort()\n    else:\n        array_copy.sort(reverse=True)\n\n    return array_copy"}
{"task_id": "HumanEval/86", "solution": "import re\ndef anti_shuffle(s):\n    \"\"\"\n    Takes a string and returns an ordered version of it.\n    Characters within each word are sorted alphabetically (ASCII-based),\n    while preserving word order and all spaces.\n    \"\"\"\n    parts = re.split(r'(\\s+)', s)\n    processed_parts = []\n    for part in parts:\n        if part.strip() == '':\n            processed_parts.append(part)\n        else:\n            processed_parts.append(\"\".join(sorted(part)))\n    return \"\".join(processed_parts)"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by rotating alphabetic characters by four places.\n    Non-alphabetic characters are preserved, and case is maintained.\"\"\"\n    \n    shift = 4\n    encrypted_chars = []\n    for char in s:\n        if 'a' <= char <= 'z':\n            start = ord('a')\n            encrypted_chars.append(chr(start + (ord(char) - start + shift) % 26))\n        elif 'A' <= char <= 'Z':\n            start = ord('A')\n            encrypted_chars.append(chr(start + (ord(char) - start + shift) % 26))\n        else:\n            encrypted_chars.append(char)\n    return \"\".join(encrypted_chars)"}
