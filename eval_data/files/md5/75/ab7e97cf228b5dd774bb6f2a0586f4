{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    The sequence is generated by halving even numbers or multiplying odd numbers by 3 and adding 1, until 1 is reached.\n    \"\"\"\n    current_num = n\n    odd_numbers_set = set()\n\n    # Generate the Collatz sequence and collect odd numbers.\n    while current_num != 1:\n        if current_num % 2 != 0:  # Check if current_num is odd\n            odd_numbers_set.add(current_num)\n            current_num = 3 * current_num + 1\n        else:  # current_num is even\n            current_num = current_num // 2\n    \n    # 1 is always part of the sequence and is an odd number.\n    odd_numbers_set.add(1) \n\n    # Convert the set to a list and sort it in increasing order.\n    return sorted(list(odd_numbers_set))"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list of unique odd numbers from its Collatz sequence.\n    The sequence is generated by halving even numbers and applying 3*n+1 to odd numbers, until 1 is reached.\n    \"\"\"\n    if n == 1:\n        return [1]\n\n    odd_numbers = set()\n    current = n\n    while current != 1:\n        if current % 2 != 0:\n            odd_numbers.add(current)\n\n        if current % 2 == 0:\n            current //= 2\n        else:\n            current = 3 * current + 1\n    \n    odd_numbers.add(1)  # Ensure 1 is always included as it's the termination point and an odd number\n    \n    return sorted(list(odd_numbers))"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    \"\"\"\n    Splits a string by whitespace, then by commas if no whitespace,\n    else counts odd-ordered lowercase letters.\n    \"\"\"\n    if ' ' in txt or '\\t' in txt or '\\n' in txt or '\\r' in txt:\n        return txt.split()\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        count = 0\n        for char in txt:\n            if 'a' <= char <= 'z':\n                order = ord(char) - ord('a')\n                if order % 2 != 0:\n                    count += 1\n        return count"}
{"task_id": "HumanEval/124", "solution": "def valid_date(date):\n    \"\"\"\n    Validates a given date string according to specific format and range rules.\n    Returns True if the date is valid, False otherwise.\n    \"\"\"\n    if not date:\n        return False\n\n    parts = date.split('-')\n    if len(parts) != 3:\n        return False\n\n    m_str, d_str, y_str = parts\n\n    # Ensure each component matches the mm-dd-yyyy length requirement\n    if len(m_str) != 2 or len(d_str) != 2 or len(y_str) != 4:\n        return False\n\n    try:\n        month = int(m_str)\n        day = int(d_str)\n        # Year is parsed but no specific range validation for it is required\n        _ = int(y_str)\n    except ValueError:\n        # If any component is not an integer, it's an invalid date format\n        return False\n\n    # Validate month range (Rule 3)\n    if not (1 <= month <= 12):\n        return False\n\n    # Define maximum days for each month (Rule 2)\n    days_in_month_map = {\n        1: 31, 3: 31, 5: 31, 7: 31, 8: 31, 10: 31, 12: 31,\n        4: 30, 6: 30, 9: 30, 11: 30,\n        2: 29  # February is capped at 29 days, without explicit leap year logic.\n    }\n\n    # Validate day range based on the month\n    if month not in days_in_month_map:\n        return False # Should not happen if month is 1-12\n    \n    max_days = days_in_month_map[month]\n    if not (1 <= day <= max_days):\n        return False\n\n    return True"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    \"\"\"Splits a string by whitespace, then commas if no whitespace. If neither, it counts lowercase letters with odd alphabetical order (a=0, b=1, ...).\"\"\"\n    \n    if any(c.isspace() for c in txt):\n        return txt.split()\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        count = 0\n        for char in txt:\n            if 'a' <= char <= 'z':\n                order = ord(char) - ord('a')\n                if order % 2 != 0:\n                    count += 1\n        return count"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n    '''\n\n    # FR1: Check if the list is sorted in ascending order.\n    # An empty or single-element list is implicitly sorted, as the loop won't execute.\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    # FR2: Check if any number appears more than twice.\n    # Manually count occurrences as external utilities are forbidden.\n    counts = {}\n    for x in lst:\n        counts[x] = counts.get(x, 0) + 1\n    \n    for count in counts.values():\n        if count > 2: # Condition: no number appears more than twice.\n            return False\n            \n    # FR3/FR4: If both conditions are met, the list is valid.\n    return True"}
{"task_id": "HumanEval/124", "solution": "def valid_date(date):\n    \"\"\"Validates a date string in 'mm-dd-yyyy' format.\n    Checks for non-empty string, correct format, month range, and day range for the given month.\n    \"\"\"\n    if not date:\n        return False\n\n    # Validate for 'mm-dd-yyyy' format by length and separators.\n    if len(date) != 10:\n        return False\n    if date[2] != '-' or date[5] != '-':\n        return False\n    \n    month_str = date[0:2]\n    day_str = date[3:5]\n    year_str = date[6:10]\n\n    # Check if extracted components are digits before conversion.\n    if not (month_str.isdigit() and day_str.isdigit() and year_str.isdigit()):\n        return False\n\n    month = int(month_str)\n    day = int(day_str)\n    # Year validation is not specified beyond format; no need to store or use the year integer.\n\n    # Validate month range (1 to 12 inclusive).\n    if not (1 <= month <= 12):\n        return False\n\n    # Define month day limits locally as constants.\n    DAYS_IN_MONTH_31 = [1, 3, 5, 7, 8, 10, 12]\n    DAYS_IN_MONTH_30 = [4, 6, 9, 11]\n    MONTH_FEBRUARY = 2\n\n    # Validate day range based on the month.\n    if month in DAYS_IN_MONTH_31:\n        if not (1 <= day <= 31):\n            return False\n    elif month in DAYS_IN_MONTH_30:\n        if not (1 <= day <= 30):\n            return False\n    elif month == MONTH_FEBRUARY:\n        if not (1 <= day <= 29): # Max 29 days for February as per rules.\n            return False\n    \n    return True"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    \"\"\"\n    Checks if a list of non-negative integers is sorted in ascending order\n    and does not contain more than one duplicate of any number.\n    Returns True if both conditions are met, False otherwise.\n    \"\"\"\n    if len(lst) <= 1:\n        return True\n\n    # Check for ascending order\n    for i in range(len(lst) - 1):\n        if lst[i] > lst[i+1]:\n            return False\n\n    # Check if any number appears more than twice (more than 1 duplicate)\n    counts = {}\n    for num in lst:\n        counts[num] = counts.get(num, 0) + 1\n\n    for count in counts.values():\n        if count > 2:\n            return False\n\n    return True"}
{"task_id": "HumanEval/127", "solution": "import math\nfrom typing import Tuple\nclass PrimeChecker:\n    \"\"\"Checks if a given integer is a prime number.\n    It implements a basic trial division algorithm up to the square root of n.\n    \"\"\"\n    def is_prime(self, n: int) -> bool:\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\nclass IntervalService:\n    \"\"\"Handles operations related to integer intervals, including intersection length calculation.\"\"\"\n    def __init__(self, prime_checker: PrimeChecker):\n        self._prime_checker = prime_checker\n\n    def calculate_intersection_length(self, interval1: Tuple[int, int], interval2: Tuple[int, int]) -> int:\n        \"\"\"Calculates the length of the intersection of two closed integer intervals.\"\"\"\n        start1, end1 = interval1\n        start2, end2 = interval2\n\n        intersect_start = max(start1, start2)\n        intersect_end = min(end1, end2)\n\n        if intersect_start > intersect_end:\n            return 0\n        return intersect_end - intersect_start\n\n    def is_intersection_length_prime(self, interval1: Tuple[int, int], interval2: Tuple[int, int]) -> bool:\n        \"\"\"Calculates the intersection length and determines if it is a prime number.\"\"\"\n        length = self.calculate_intersection_length(interval1, interval2)\n        return self._prime_checker.is_prime(length)\n_prime_checker = PrimeChecker()\n_interval_service = IntervalService(prime_checker=_prime_checker)\ndef intersection(interval1: Tuple[int, int], interval2: Tuple[int, int]) -> str:\n    \"\"\"Determines whether the length of the intersection of two intervals is a prime number.\n    Returns \"YES\" if the length is prime, \"NO\" otherwise.\n    \"\"\"\n    if _interval_service.is_intersection_length_prime(interval1, interval2):\n        return \"YES\"\n    return \"NO\""}
{"task_id": "HumanEval/128", "solution": "def _calculate_sign(num: int) -> int:\n    \"\"\"\n    Determines the sign of a single integer.\n    Returns 1 for positive, -1 for negative, and 0 for zero.\n    \"\"\"\n    if num > 0:\n        return 1\n    elif num < 0:\n        return -1\n    else:\n        return 0\ndef _calculate_product_of_signs(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the product of the signs of all integers in the array.\n    Optimized to return 0 early if any number's sign is 0.\n    \"\"\"\n    product = 1\n    for num in arr:\n        sign = _calculate_sign(num)\n        product *= sign\n        if product == 0:\n            return 0\n    return product\ndef _calculate_sum_of_magnitudes(arr: list[int]) -> int:\n    \"\"\"\n    Calculates the sum of the absolute values (magnitudes) of all integers.\n    \"\"\"\n    total_magnitude = 0\n    for num in arr:\n        total_magnitude += abs(num)\n    return total_magnitude\ndef prod_signs(arr: list[int]) -> int | None:\n    \"\"\"\n    You are given an array arr of integers and you need to return\n    sum of magnitudes of integers multiplied by product of all signs\n    of each number in the array, represented by 1, -1 or 0.\n    Note: return None for empty arr.\n    \"\"\"\n    if not arr:\n        return None\n\n    product_of_signs = _calculate_product_of_signs(arr)\n    sum_of_magnitudes = _calculate_sum_of_magnitudes(arr)\n\n    return product_of_signs * sum_of_magnitudes"}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Computes the sum of magnitudes multiplied by the product of signs for an array of integers.\n    Returns None if the input array is empty.\n    \"\"\"\n    if not arr:\n        return None\n\n    product_of_signs = 1\n    sum_of_magnitudes = 0\n\n    for num in arr:\n        # Determine the sign of the current number\n        current_sign = 0\n        if num > 0:\n            current_sign = 1\n        elif num < 0:\n            current_sign = -1\n        \n        # Determine the magnitude (absolute value) of the current number\n        current_magnitude = abs(num)\n\n        # Update the product of signs and sum of magnitudes\n        product_of_signs *= current_sign\n        sum_of_magnitudes += current_magnitude\n\n    return sum_of_magnitudes * product_of_signs"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of its odd digits.\n    Return 0 if all digits are even.\"\"\"\n    product = 1\n    found_odd_digit = False\n\n    for digit_char in str(n):\n        digit = int(digit_char)\n        if digit % 2 != 0:\n            product *= digit\n            found_odd_digit = True\n\n    if not found_odd_digit:\n        return 0\n    else:\n        return product"}
{"task_id": "HumanEval/127", "solution": "import math\nfrom typing import Optional\nclass Interval:\n    \"\"\"Represents a closed integer interval [start, end].\"\"\"\n    def __init__(self, start: int, end: int):\n        self.start = start\n        self.end = end\ndef is_prime(n: int) -> bool:\n    \"\"\"Checks if a given non-negative integer is a prime number.\"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    for i in range(3, int(math.sqrt(n)) + 1, 2):\n        if n % i == 0:\n            return False\n    return True\ndef calculate_intersection_interval(interval1: Interval, interval2: Interval) -> Optional[Interval]:\n    \"\"\"Calculates the intersection of two intervals. Returns an Interval object or None.\"\"\"\n    max_start = max(interval1.start, interval2.start)\n    min_end = min(interval1.end, interval2.end)\n\n    if max_start <= min_end:\n        return Interval(max_start, min_end)\n    return None\ndef calculate_interval_length(interval: Interval) -> int:\n    \"\"\"Calculates the length of an interval as end - start, based on examples.\"\"\"\n    return interval.end - interval.start\ndef intersection(interval1, interval2):\n    \"\"\"\n    Determines whether the length of the intersection of two intervals is a prime number.\n    Returns \"YES\" if the length is prime, \"NO\" otherwise or if no intersection.\n    \"\"\"\n    obj_interval1 = Interval(interval1[0], interval1[1])\n    obj_interval2 = Interval(interval2[0], interval2[1])\n\n    intersection_result = calculate_intersection_interval(obj_interval1, obj_interval2)\n\n    if intersection_result is None:\n        return \"NO\"\n    \n    length = calculate_interval_length(intersection_result)\n\n    if is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Calculates the first n + 1 Tribonacci numbers using the defined recurrence relations and memoization.\"\"\"\n    memo = {}\n\n    def _calculate_tribonacci_single(k, memo_cache):\n        \"\"\"Recursively calculates a single Tribonacci number tri(k), storing results in the memoization cache.\"\"\"\n        if k in memo_cache:\n            return memo_cache[k]\n\n        result = 0.0\n\n        if k == 0:\n            result = 1.0\n        elif k == 1:\n            result = 3.0\n        elif k % 2 == 0:  # k is even and k > 1\n            result = 1.0 + k / 2.0\n        else:  # k is odd and k > 1\n            tri_k_minus_1 = _calculate_tribonacci_single(k - 1, memo_cache)\n            tri_k_minus_2 = _calculate_tribonacci_single(k - 2, memo_cache)\n            tri_k_plus_1 = _calculate_tribonacci_single(k + 1, memo_cache)\n            result = tri_k_minus_1 + tri_k_minus_2 + tri_k_plus_1\n        \n        memo_cache[k] = result\n        return result\n\n    sequence = []\n    for i in range(n + 1):\n        sequence.append(_calculate_tribonacci_single(i, memo))\n        \n    return sequence"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of the odd digits.\n    Return 0 if all digits are even.\n    \"\"\"\n    product = 1\n    found_odd = False\n    for digit_char in str(n):\n        digit = int(digit_char)\n        if digit % 2 != 0:\n            product *= digit\n            found_odd = True\n\n    return product if found_odd else 0"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Calculates the first n + 1 numbers of the Tribonacci sequence.\n    Uses memoization for efficiency during term calculations.\n    \"\"\"\n    memo = {}\n\n    def _get_term(k):\n        if k in memo:\n            return memo[k]\n\n        if k == 0:\n            result = 1\n        elif k == 1:\n            result = 3\n        elif k % 2 == 0:  # k is even and k > 1\n            result = 1 + k // 2\n        else:  # k is odd and k > 1\n            term_k_minus_1 = _get_term(k - 1)\n            term_k_minus_2 = _get_term(k - 2)\n            term_k_plus_1 = _get_term(k + 1)\n            result = term_k_minus_1 + term_k_minus_2 + term_k_plus_1\n        \n        memo[k] = result\n        return result\n\n    sequence = []\n    for i in range(n + 1):\n        sequence.append(_get_term(i))\n    \n    return sequence"}
{"task_id": "HumanEval/129", "solution": "class Coordinate:\n    \"\"\"Represents a specific cell's location (row, column) within the grid.\"\"\"\n    def __init__(self, row: int, col: int):\n        self.row = row\n        self.col = col\n\n    def __eq__(self, other: object) -> bool:\n        if not isinstance(other, Coordinate):\n            return NotImplemented\n        return self.row == other.row and self.col == other.col\n\n    def __hash__(self) -> int:\n        return hash((self.row, self.col))\n\n    def __repr__(self) -> str:\n        return f\"Coordinate({self.row}, {self.col})\"\nclass Path:\n    \"\"\"Encapsulates a sequence of cell values forming a path.\"\"\"\n    def __init__(self, values: list[int] = None):\n        self._values = list(values) if values is not None else []\n\n    def append_value(self, value: int) -> None:\n        self._values.append(value)\n\n    def remove_last_value(self) -> None:\n        # Removes the last value from the path, used for backtracking.\n        # Assumes this is not called on an empty path based on DFS logic.\n        if self._values:\n            self._values.pop()\n\n    def get_values(self) -> list[int]:\n        return list(self._values) # Return a copy\n\n    def get_length(self) -> int:\n        return len(self._values)\n\n    def __lt__(self, other: 'Path') -> bool:\n        # Implements lexicographical comparison between two paths.\n        len_self = len(self._values)\n        len_other = len(other._values)\n        min_len = min(len_self, len_other)\n\n        for i in range(min_len):\n            if self._values[i] < other._values[i]:\n                return True\n            if self._values[i] > other._values[i]:\n                return False\n        \n        # If one is a prefix of the other, the shorter one is lexicographically smaller.\n        return len_self < len_other\n\n    def __repr__(self) -> str:\n        return f\"Path({self._values})\"\nclass GridManager:\n    \"\"\"Provides an interface for interacting with the grid data.\"\"\"\n    def __init__(self, grid_data: list[list[int]]):\n        self._grid_data = grid_data\n        self._N = len(grid_data)\n\n    def get_value(self, coord: Coordinate) -> int:\n        return self._grid_data[coord.row][coord.col]\n\n    def get_dimensions(self) -> tuple[int, int]:\n        return self._N, self._N\n\n    def get_neighbors(self, coord: Coordinate) -> list[Coordinate]:\n        # Returns a list of valid adjacent coordinates within grid boundaries.\n        neighbors = []\n        directions = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Up, Down, Left, Right\n\n        for dr, dc in directions:\n            new_row, new_col = coord.row + dr, coord.col + dc\n            if self._is_valid_coordinate(new_row, new_col):\n                neighbors.append(Coordinate(new_row, new_col))\n        return neighbors\n\n    def _is_valid_coordinate(self, row: int, col: int) -> bool:\n        return 0 <= row < self._N and 0 <= col < self._N\nclass PathFinderService:\n    \"\"\"Implements the core algorithm to find the lexicographically smallest path.\"\"\"\n    def __init__(self, grid_manager: GridManager):\n        self._grid_manager = grid_manager\n        # Initial value will be overwritten in find_min_path based on k.\n        self._min_path = Path([float('inf')]) \n        self._k = 0 \n\n    def find_min_path(self, k: int) -> list[int]:\n        self._k = k\n        N, _ = self._grid_manager.get_dimensions()\n\n        # Initialize _min_path with values guaranteed to be larger than any grid value.\n        self._min_path = Path([N * N + 1] * k) \n        \n        for r in range(N):\n            for c in range(N):\n                start_coord = Coordinate(r, c)\n                initial_value = self._grid_manager.get_value(start_coord)\n                current_path = Path([initial_value])\n                self._dfs(current_path, start_coord)\n        \n        return self._min_path.get_values()\n\n    def _dfs(self, current_path: Path, current_coord: Coordinate) -> None:\n        # Base case: if current path length equals k, compare and update min_path.\n        if current_path.get_length() == self._k:\n            if current_path < self._min_path:\n                self._min_path = Path(current_path.get_values()) # Deep copy to preserve state\n            return\n\n        # Pruning: if a full path has been found and current prefix is already greater.\n        if self._min_path.get_length() == self._k:\n            temp_min_path_prefix = Path(self._min_path.get_values()[:current_path.get_length()])\n            if not (current_path < temp_min_path_prefix): \n                return # Prune this branch, it cannot lead to a smaller path\n\n        neighbors = self._grid_manager.get_neighbors(current_coord)\n        for neighbor_coord in neighbors:\n            neighbor_value = self._grid_manager.get_value(neighbor_coord)\n            current_path.append_value(neighbor_value)\n            self._dfs(current_path, neighbor_coord)\n            current_path.remove_last_value() # Backtrack\ndef minPath(grid: list[list[int]], k: int) -> list[int]:\n    \"\"\"\n    Finds the lexicographically smallest path of length k in the grid.\n    This function initializes grid management and pathfinding services.\n    \"\"\"\n    grid_manager = GridManager(grid)\n    path_finder_service = PathFinderService(grid_manager)\n    return path_finder_service.find_min_path(k)"}
{"task_id": "HumanEval/132", "solution": "def _is_valid_bracket_sequence(s: str) -> bool:\n    \"\"\"Checks if a string forms a valid and balanced sequence of square brackets.\n    It uses a balance counter to track open and close brackets.\"\"\"\n    balance = 0\n    for char in s:\n        if char == '[':\n            balance += 1\n        elif char == ']':\n            balance -= 1\n        if balance < 0:\n            return False\n    return balance == 0\ndef is_nested(string: str) -> bool:\n    \"\"\"\n    Checks if a string contains a valid subsequence of brackets where at least\n    one bracket in the subsequence is nested. It iterates all substrings and\n    uses a helper to validate them and their inner content.\n    \"\"\"\n    n = len(string)\n    for i in range(n):\n        for j in range(i + 1, n):\n            sub = string[i : j + 1]\n            if _is_valid_bracket_sequence(sub):\n                inner_content = sub[1:-1]\n                if len(inner_content) > 0 and _is_valid_bracket_sequence(inner_content):\n                    return True\n    return False"}
{"task_id": "HumanEval/129", "solution": "import heapq\nfrom typing import List, Tuple\ndef minPath(grid: List[List[int]], k: int) -> List[int]:\n    \"\"\"\n    Finds the lexicographically smallest path of length k in the grid.\n    Utilizes a priority queue (min-heap) to explore paths efficiently.\n    \"\"\"\n    DIRECTIONS = [(0, 1), (0, -1), (1, 0), (-1, 0)]\n\n    class PathState:\n        \"\"\"Represents a path state for the priority queue.\"\"\"\n        def __init__(self, path_values: List[int], current_r: int, current_c: int, length: int):\n            self.path_values = path_values\n            self.current_r = current_r\n            self.current_c = current_c\n            self.length = length\n\n        def __lt__(self, other: 'PathState') -> bool:\n            \"\"\"Lexicographical comparison for priority queue.\"\"\"\n            return self.path_values < other.path_values\n\n        def __eq__(self, other: object) -> bool:\n            # Per critical requirement: \"Do NOT add isinstance() checks, type guards, or raise exceptions for edge cases.\"\n            return (self.path_values == other.path_values and\n                    self.current_r == other.current_r and\n                    self.current_c == other.current_c and\n                    self.length == other.length)\n\n        def __hash__(self) -> int:\n            return hash((tuple(self.path_values), self.current_r, self.current_c, self.length))\n\n    class Grid:\n        \"\"\"Encapsulates grid data and operations.\"\"\"\n        def __init__(self, grid_data: List[List[int]]):\n            self._grid_data = grid_data\n            self._N = len(grid_data)\n\n        def get_value(self, row: int, col: int) -> int:\n            return self._grid_data[row][col]\n\n        def get_dimensions(self) -> Tuple[int, int]:\n            return self._N, self._N\n\n        def is_valid_coord(self, row: int, col: int) -> bool:\n            return 0 <= row < self._N and 0 <= col < self._N\n\n        def get_neighbors(self, row: int, col: int) -> List[Tuple[int, int]]:\n            neighbors = []\n            for dr, dc in DIRECTIONS:\n                nr, nc = row + dr, col + dc\n                if self.is_valid_coord(nr, nc):\n                    neighbors.append((nr, nc))\n            return neighbors\n\n    class GridValidator:\n        \"\"\"Provides static methods for validating grid and k inputs.\"\"\"\n        @staticmethod\n        def validate_grid(grid_input: List[List[int]]) -> None:\n            # Per critical requirement, input validation logic is omitted.\n            pass\n\n        @staticmethod\n        def validate_k(k_input: int) -> None:\n            # Per critical requirement, input validation logic is omitted.\n            pass\n\n    class MinPathFinderService:\n        \"\"\"Service to find the lexicographically smallest path.\"\"\"\n        def __init__(self, grid_obj: Grid, k_param: int):\n            self.grid_obj = grid_obj\n            self.k = k_param\n            self.N, _ = grid_obj.get_dimensions()\n\n        def find_min_path(self) -> List[int]:\n            priority_queue: List[PathState] = []\n\n            # Initialize priority queue with all possible starting cells.\n            for r in range(self.N):\n                for c in range(self.N):\n                    initial_value = self.grid_obj.get_value(r, c)\n                    heapq.heappush(priority_queue, PathState([initial_value], r, c, 1))\n\n            while priority_queue:\n                current_path_state = heapq.heappop(priority_queue)\n\n                if current_path_state.length == self.k:\n                    return current_path_state.path_values\n\n                # Explore neighbors for paths not yet of length k.\n                neighbors = self.grid_obj.get_neighbors(current_path_state.current_r, current_path_state.current_c)\n                for nr, nc in neighbors:\n                    neighbor_value = self.grid_obj.get_value(nr, nc)\n                    new_path_values = current_path_state.path_values + [neighbor_value]\n                    new_path_state = PathState(new_path_values, nr, nc, current_path_state.length + 1)\n                    heapq.heappush(priority_queue, new_path_state)\n            \n            # This point should not be reached as the problem guarantees a unique answer.\n            return []\n\n    # --- Main function logic ---\n    GridValidator.validate_grid(grid)\n    GridValidator.validate_k(k)\n\n    grid_obj = Grid(grid)\n    finder = MinPathFinderService(grid_obj, k)\n    return finder.find_min_path()"}
{"task_id": "HumanEval/133", "solution": "import math\ndef sum_squares(lst: list[float | int]) -> int:\n    \"\"\"\n    Calculates the sum of squared numbers in the given list,\n    rounding each element to the upper integer (Ceiling) first.\n    \"\"\"\n    total_sum = 0\n    for num in lst:\n        rounded_num = math.ceil(num)\n        total_sum += rounded_num ** 2\n    return total_sum"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt):\n    \"\"\"\n    Checks if the last character of a string is an alphabetical character and is not part of a word.\n    A \"word\" is defined as a group of characters separated by space.\n    \"\"\"\n    if not txt:\n        return False\n\n    last_char = txt[-1]\n\n    if not last_char.isalpha():\n        return False\n\n    # Check if it's an isolated letter (preceded by a space or is the only character).\n    if len(txt) == 1:\n        return True\n    else:\n        char_before_last = txt[-2]\n        return char_before_last == ' '"}
{"task_id": "HumanEval/133", "solution": "import math\ndef sum_squares(lst):\n    \"\"\"Calculates the sum of squares of ceiling-rounded numbers in the given list.\n    Each number is rounded up to the nearest integer before squaring.\n    \"\"\"\n    total_sum = 0\n    for num in lst:\n        rounded_num = math.ceil(num)\n        total_sum += rounded_num * rounded_num\n    return total_sum"}
{"task_id": "HumanEval/134", "solution": "def check_if_last_char_is_a_letter(txt: str) -> bool:\n    '''\n    Returns True if the last character of a string is alphabetical and not part of a word.\n    A \"word\" is a group of characters separated by space.\n    '''\n    if not txt:\n        return False\n    \n    last_char = txt[-1]\n    \n    if not last_char.isalpha():\n        return False\n        \n    if len(txt) == 1:\n        return True\n            \n    # Check if the character before the last one is a space.\n    # If it is, then the last char is not part of a word.\n    return txt[-2] == ' '"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr: list[int]) -> int:\n    \"\"\"Returns the largest index `i` where `arr[i] < arr[i-1]`.\n    If no such index exists, returns -1.\n    \"\"\"\n    largest_inversion_index = -1\n    if len(arr) < 2:\n        return -1\n\n    for i in range(1, len(arr)):\n        if arr[i] < arr[i-1]:\n            largest_inversion_index = i\n    return largest_inversion_index"}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    \"\"\"\n    Checks if a string of square brackets contains at least one nested subsequence.\n    Nesting is determined by the maximum balance of open brackets exceeding one.\n    \"\"\"\n    if not string:\n        return False\n\n    balance = 0\n    max_balance = 0\n\n    for char in string:\n        if char == '[':\n            balance += 1\n        elif char == ']':\n            balance -= 1\n\n        max_balance = max(max_balance, balance)\n\n        # If balance drops below zero, it's an invalid sequence\n        # and cannot contain a valid nested subsequence.\n        if balance < 0:\n            return False\n\n    return max_balance > 1"}
{"task_id": "HumanEval/136", "solution": "from typing import List, Optional, Tuple\ndef largest_smallest_integers(lst: List[int]) -> Tuple[Optional[int], Optional[int]]:\n    \"\"\"\n    Finds the largest negative and smallest positive integers in a list.\n    Returns (largest_negative, smallest_positive), with None if either type of number is not found.\n    \"\"\"\n    largest_neg: Optional[int] = None\n    smallest_pos: Optional[int] = None\n\n    for num in lst:\n        if num < 0:\n            if largest_neg is None or num > largest_neg:\n                largest_neg = num\n        elif num > 0:\n            if smallest_pos is None or num < smallest_pos:\n                smallest_pos = num\n    \n    return (largest_neg, smallest_pos)"}
{"task_id": "HumanEval/135", "solution": "def can_arrange(arr):\n    \"\"\"Create a function which returns the largest index of an element which\n    is not greater than or equal to the element immediately preceding it. If\n    no such element exists then return -1.\n    \"\"\"\n    largest_violating_index = -1\n    for i in range(1, len(arr)):\n        if arr[i] < arr[i-1]:\n            largest_violating_index = i\n    return largest_violating_index"}
{"task_id": "HumanEval/136", "solution": "def largest_smallest_integers(lst):\n    \"\"\"\n    Finds the largest negative and smallest positive integers in a list.\n    Returns a tuple `(largest_negative, smallest_positive)`, using `None` if no such integers are found.\n    \"\"\"\n    largest_negative = None\n    smallest_positive = None\n\n    for num in lst:\n        if num < 0:\n            if largest_negative is None or num > largest_negative:\n                largest_negative = num\n        elif num > 0:\n            if smallest_positive is None or num < smallest_positive:\n                smallest_positive = num\n    return (largest_negative, smallest_positive)"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers\n    Example\n    is_equal_to_sum_even(4) == False\n    is_equal_to_sum_even(6) == False\n    is_equal_to_sum_even(8) == True\n    \"\"\"\n    # The sum of four positive even numbers must be an even number and at least 2+2+2+2=8.\n    return n >= 8 and n % 2 == 0"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether n can be written as the sum of exactly 4 positive even numbers.\n    Returns True if n meets the criteria, False otherwise.\"\"\"\n    if n < 8:  # Minimum sum of 4 positive even numbers is 2+2+2+2 = 8.\n        return False\n    if n % 2 != 0:  # The sum of even numbers must be even.\n        return False\n    return True  # Any even number >= 8 can be represented as (n-6) + 2 + 2 + 2."}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"Calculates the Brazilian factorial (special factorial) of n.\n    This is defined as n! * (n-1)! * (n-2)! * ... * 1! for n > 0.\n    \"\"\"\n\n    def _calculate_standard_factorial(k):\n        \"\"\"Calculates k! for a positive integer k.\"\"\"\n        if k == 0 or k == 1:\n            return 1\n        res = 1\n        for i in range(2, k + 1):\n            res *= i\n        return res\n\n    result = 1\n    for i in range(1, n + 1):\n        result *= _calculate_standard_factorial(i)\n    return result"}
{"task_id": "HumanEval/137", "solution": "def compare_one(a, b):\n    \"\"\"Compares two values, returning the numerically larger original value or None if equal.\"\"\"\n\n    def _to_float_comparable(value):\n        \"\"\"Converts values to float, handling string representations with comma or dot decimals.\"\"\"\n        if isinstance(value, (int, float)):\n            return float(value)\n        elif isinstance(value, str):\n            cleaned_value = value.replace(',', '.')\n            return float(cleaned_value)\n\n    a_numeric = _to_float_comparable(a)\n    b_numeric = _to_float_comparable(b)\n\n    if a_numeric > b_numeric:\n        return a\n    elif b_numeric > a_numeric:\n        return b\n    else:\n        return None"}
{"task_id": "HumanEval/140", "solution": "def fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores,\n    and if a string has more than 2 consecutive spaces,\n    then replace all consecutive spaces with -\n\n    fix_spaces(\"Example\") == \"Example\"\n    fix_spaces(\"Example 1\") == \"Example_1\"\n    fix_spaces(\" Example 2\") == \"_Example_2\"\n    fix_spaces(\" Example   3\") == \"_Example-3\"\n    \"\"\"\n    result = []\n    i = 0\n    n = len(text)\n    while i < n:\n        if text[i] == ' ':\n            space_count = 0\n            j = i\n            while j < n and text[j] == ' ':\n                space_count += 1\n                j += 1\n            \n            if space_count == 1:\n                result.append('_')\n            else: # space_count >= 2\n                result.append('-')\n            i = j\n        else:\n            result.append(text[i])\n            i += 1\n    return \"\".join(result)"}
{"task_id": "HumanEval/139", "solution": "def _factorial(k: int) -> int:\n    \"\"\"Calculates the standard factorial of k (k!).\n    Assumes k is a non-negative integer.\n    \"\"\"\n    res = 1\n    for i in range(1, k + 1):\n        res *= i\n    return res\ndef special_factorial(n: int) -> int:\n    \"\"\"Calculates the special factorial for n, defined as n! * (n-1)! * ... * 1!.\n    The input n is assumed to be a positive integer.\n    \"\"\"\n    total_product = 1\n    for i in range(1, n + 1):\n        total_product *= _factorial(i)\n    return total_product"}
{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text):\n    \"\"\"\n    Replaces single spaces with underscores. Sequences of three or more consecutive\n    spaces are replaced by a single hyphen, which takes precedence.\n    \"\"\"\n    text = re.sub(r' {3,}', '-', text)\n    text = text.replace(' ', '_')\n    return text"}
{"task_id": "HumanEval/137", "solution": "def compare_one(a, b):\n    \"\"\"Compares two numbers (int, float, or string) and returns the larger one in its original type.\n    Returns None if numerically equal, handling ',' or '.' as decimal separators in strings.\n    \"\"\"\n    float_a = float(str(a).replace(',', '.'))\n    float_b = float(str(b).replace(',', '.'))\n\n    if float_a > float_b:\n        return a\n    elif float_b > float_a:\n        return b\n    else:\n        return None"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    Transforms list elements based on their index and returns their sum.\n    Elements are squared if index is a multiple of 3, cubed if index is a multiple of 4 (but not 3), otherwise unchanged.\n    \"\"\"\n    if not lst:\n        return 0\n\n    total_sum = 0\n    for index, value in enumerate(lst):\n        if index % 3 == 0:\n            total_sum += value * value\n        elif index % 4 == 0:  # This condition implies index % 3 != 0 due to the preceding 'if'.\n            total_sum += value * value * value\n        else:\n            total_sum += value\n    return total_sum"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Checks if a file's name is valid based on specific conditions.\n    Returns 'Yes' if valid, 'No' otherwise.\"\"\"\n\n    ALLOWED_EXTENSIONS = ['txt', 'exe', 'dll']\n\n    # FR2: Count digits ('0'-'9')\n    digit_count = 0\n    for char in file_name:\n        if '0' <= char <= '9':\n            digit_count += 1\n    # FR6: Check if digit count is not more than three\n    if digit_count > 3:\n        return 'No'\n\n    # FR3: Count dots ('.')\n    dot_count = 0\n    for char in file_name:\n        if char == '.':\n            dot_count += 1\n    # FR7: Check if dot count is exactly one\n    if dot_count != 1:\n        return 'No'\n\n    # FR4, FR5: Extract prefix and extension.\n    # We already confirmed exactly one dot, so split will always work as expected.\n    parts = file_name.split('.', 1)\n    prefix = parts[0]\n    extension = parts[1]\n\n    # FR8: Check if the substring before the dot is not empty.\n    if not prefix:\n        return 'No'\n\n    # FR9: Check if the substring before the dot starts with a latin alphabet letter.\n    first_char = prefix[0]\n    is_letter = False\n    if ('a' <= first_char <= 'z') or ('A' <= first_char <= 'Z'):\n        is_letter = True\n    if not is_letter:\n        return 'No'\n\n    # FR10: Check if the extension is one of ['txt', 'exe', 'dll'].\n    if extension not in ALLOWED_EXTENSIONS:\n        return 'No'\n\n    # FR11: All conditions met.\n    return 'Yes'"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"Create a function which takes a string representing a file's name, and returns\n    'Yes' if the the file's name is valid, and returns 'No' otherwise.\n    \"\"\"\n    max_digits_allowed = 3\n    allowed_extensions = ['txt', 'exe', 'dll']\n\n    # Rule: There should not be more than three digits ('0'-'9')\n    digit_count = 0\n    for char in file_name:\n        if '0' <= char <= '9':\n            digit_count += 1\n    if digit_count > max_digits_allowed:\n        return 'No'\n\n    # Rule: The file's name contains exactly one dot '.'\n    if file_name.count('.') != 1:\n        return 'No'\n\n    # Split the file name into prefix and suffix\n    parts = file_name.split('.')\n    prefix = parts[0]\n    suffix = parts[1]\n\n    # Rule: The substring before the dot should not be empty\n    if not prefix:\n        return 'No'\n    \n    # Rule: The substring before the dot starts with a letter from the latin alphapet\n    first_char = prefix[0]\n    if not ('a' <= first_char <= 'z' or 'A' <= first_char <= 'Z'):\n        return 'No'\n\n    # Rule: The substring after the dot should be one of ['txt', 'exe', 'dll']\n    if suffix not in allowed_extensions:\n        return 'No'\n\n    # If all conditions are met\n    return 'Yes'"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Filters words from a sentence, keeping only those with prime lengths.\n    Words in the output maintain their original order.\n    \"\"\"\n\n    def is_prime(n: int) -> bool:\n        \"\"\"Checks if an integer is a prime number.\"\"\"\n        if n < 2:\n            return False\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 1\n        return True\n\n    if not sentence:\n        return \"\"\n\n    words = sentence.split(' ')\n    filtered_words = []\n\n    for word in words:\n        if is_prime(len(word)):\n            filtered_words.append(word)\n\n    return ' '.join(filtered_words)"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a \n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not \n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries. \n    \n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    if not lst:\n        return 0\n\n    # Create a mutable copy to apply transformations.\n    modified_list = list(lst)\n\n    for i in range(len(modified_list)):\n        if i % 3 == 0:\n            modified_list[i] *= modified_list[i] # Square if index is a multiple of 3.\n        elif i % 4 == 0:\n            modified_list[i] *= modified_list[i] * modified_list[i] # Cube if index is a multiple of 4 and not a multiple of 3.\n        # Elements at other indices remain unchanged.\n\n    return sum(modified_list)"}
{"task_id": "HumanEval/144", "solution": "class Fraction:\n    \"\"\"Represents a mathematical fraction with a numerator and a denominator.\"\"\"\n    def __init__(self, numerator: int, denominator: int):\n        self.numerator = numerator\n        self.denominator = denominator\n\n    def __mul__(self, other: 'Fraction') -> 'Fraction':\n        \"\"\"Multiplies this fraction by another Fraction object.\"\"\"\n        new_numerator = self.numerator * other.numerator\n        new_denominator = self.denominator * other.denominator\n        return Fraction(new_numerator, new_denominator)\n\n    def is_whole_number(self) -> bool:\n        \"\"\"Checks if the fraction represents a whole number.\"\"\"\n        return self.numerator % self.denominator == 0\nclass FractionParser:\n    \"\"\"Provides a static method to parse string representations of fractions.\"\"\"\n    @staticmethod\n    def parse_fraction_string(fraction_str: str) -> Fraction:\n        parts = fraction_str.split('/')\n        numerator = int(parts[0])\n        denominator = int(parts[1])\n        return Fraction(numerator, denominator)\nclass FractionService:\n    \"\"\"Encapsulates business logic for combining fraction operations.\"\"\"\n    def multiply_and_check_whole(self, fraction1: Fraction, fraction2: Fraction) -> bool:\n        result_fraction = fraction1 * fraction2\n        return result_fraction.is_whole_number()\ndef simplify(x: str, n: str) -> bool:\n    \"\"\"Simplifies the expression x * n and returns True if it's a whole number.\n    This function parses fraction strings, multiplies them, and checks if the product is a whole number.\"\"\"\n    fraction_x = FractionParser.parse_fraction_string(x)\n    fraction_n = FractionParser.parse_fraction_string(n)\n    \n    service = FractionService()\n    return service.multiply_and_check_whole(fraction_x, fraction_n)"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Filters words from a sentence, returning only those whose lengths are prime numbers.\n    The order of words is preserved.\n    \"\"\"\n    import math\n\n    def is_prime(n: int) -> bool:\n        \"\"\"\n        Checks if a given integer is a prime number.\n        This helper is defined inline as required by the design.\n        \"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(n)) + 1, 2):\n            if n % i == 0:\n                return False\n        return True\n\n    words = sentence.split()\n    prime_length_words = []\n    for word in words:\n        if is_prime(len(word)):\n            prime_length_words.append(word)\n    return \" \".join(prime_length_words)"}
{"task_id": "HumanEval/145", "solution": "def _calculate_digit_sum(num: int) -> int:\n    \"\"\"\n    Calculates the sum of the absolute value of digits for a given integer.\n    \"\"\"\n    s = 0\n    num_str = str(abs(num))\n    for digit in num_str:\n        s += int(digit)\n    return s\ndef order_by_points(nums):\n    \"\"\"\n    Sorts the given list of integers based on the sum of their digits and original index.\n    Returns a new list with the sorted integers.\n    \"\"\"\n    if not nums:\n        return []\n\n    decorated_list = []\n    for index, num in enumerate(nums):\n        digit_sum = _calculate_digit_sum(num)\n        decorated_list.append((digit_sum, index, num))\n\n    decorated_list.sort()\n\n    sorted_nums = [item[2] for item in decorated_list]\n    return sorted_nums"}
{"task_id": "HumanEval/146", "solution": "def is_odd(digit: int) -> bool:\n    \"\"\"Checks if a digit is odd.\"\"\"\n    return digit % 2 != 0\ndef get_first_digit(num: int) -> int:\n    \"\"\"Extracts the first digit of a number, handling absolute value.\"\"\"\n    abs_num = abs(num)\n    if abs_num == 0:\n        return 0\n    while abs_num >= 10:\n        abs_num //= 10\n    return abs_num\ndef get_last_digit(num: int) -> int:\n    \"\"\"Extracts the last digit of a number, handling absolute value.\"\"\"\n    return abs(num) % 10\ndef specialFilter(nums):\n    \"\"\"Filters a list of numbers based on specific criteria and returns a count.\"\"\"\n    count = 0\n    for num in nums:\n        if num > 10:\n            first_digit = get_first_digit(num)\n            last_digit = get_last_digit(num)\n            if is_odd(first_digit) and is_odd(last_digit):\n                count += 1\n    return count"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"Counts numbers greater than 10 with both first and last digits odd.\"\"\"\n\n    def _is_odd(digit: int) -> bool:\n        return digit in (1, 3, 5, 7, 9)\n\n    def _get_first_digit(num: int) -> int:\n        # Extracts the first digit of an integer, using its absolute value.\n        abs_num = abs(num)\n        if abs_num == 0:\n            return 0\n        while abs_num >= 10:\n            abs_num //= 10\n        return abs_num\n\n    def _get_last_digit(num: int) -> int:\n        # Extracts the last digit of an integer, using its absolute value.\n        return abs(num) % 10\n\n    count = 0\n    for num in nums:\n        if num > 10:\n            first_digit = _get_first_digit(num)\n            last_digit = _get_last_digit(num)\n\n            if _is_odd(first_digit) and _is_odd(last_digit):\n                count += 1\n    return count"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sorts a list of integers by the sum of their digits, then by original index.\n    Digit sum for negative numbers uses their absolute value.\n    \"\"\"\n    def _calculate_digit_sum(num: int) -> int:\n        \"\"\"Calculates the sum of absolute digits for an integer.\n        Handles both positive and negative numbers by taking the absolute value.\"\"\"\n        s = 0\n        num_abs = abs(num)\n        while num_abs > 0:\n            s += num_abs % 10\n            num_abs //= 10\n        return s\n\n    if not nums:\n        return []\n\n    decorated_list = []\n    for i, num in enumerate(nums):\n        digit_sum = _calculate_digit_sum(num)\n        decorated_list.append((digit_sum, i, num))\n\n    decorated_list.sort()\n\n    return [item[2] for item in decorated_list]"}
{"task_id": "HumanEval/147", "solution": "import math\ndef get_max_triples(n):\n    \"\"\"\n    Counts triples (a[i], a[j], a[k]) from array a where a[x] = x*x - x + 1,\n    such that i < j < k and their sum is a multiple of 3.\n    \"\"\"\n\n    def nCr(n_val, r_val):\n        \"\"\"Calculates n choose r, the number of combinations.\"\"\"\n        if r_val < 0 or r_val > n_val:\n            return 0\n        if r_val == 0 or r_val == n_val:\n            return 1\n        if r_val > n_val // 2:\n            r_val = n_val - r_val\n        return math.comb(n_val, r_val)\n\n    count0 = 0  # Count of a[i] where a[i] % 3 == 0\n    count1 = 0  # Count of a[i] where a[i] % 3 == 1\n\n    for i in range(1, n + 1):\n        # The remainder of a[i] = i*i - i + 1 when divided by 3 depends on i % 3.\n        # If i % 3 == 2, then a[i] % 3 == 0. Otherwise, a[i] % 3 == 1.\n        remainder_i = i % 3\n        if remainder_i == 2:\n            count0 += 1\n        else:\n            count1 += 1\n    \n    # A triple (a[i], a[j], a[k]) sums to a multiple of 3 if:\n    # 1. All three elements have a remainder of 0 (e.g., 0+0+0 = 0 mod 3).\n    # 2. All three elements have a remainder of 1 (e.g., 1+1+1 = 3 = 0 mod 3).\n    triples_rem0 = nCr(count0, 3)\n    triples_rem1 = nCr(count1, 3)\n    \n    return triples_rem0 + triples_rem1"}
{"task_id": "HumanEval/148", "solution": "PLANETS_ORDER = [\n    \"Mercury\", \"Venus\", \"Earth\", \"Mars\",\n    \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"\n]\ndef bf(planet1, planet2):\n    \"\"\"\n    Returns planets whose orbits are between planet1 and planet2, sorted by proximity to the Sun.\n    Returns an empty tuple if planet names are invalid or no planets are between them.\n    \"\"\"\n    try:\n        idx1 = PLANETS_ORDER.index(planet1)\n        idx2 = PLANETS_ORDER.index(planet2)\n    except ValueError:\n        return ()\n\n    start_idx = min(idx1, idx2)\n    end_idx = max(idx1, idx2)\n\n    between_planets = PLANETS_ORDER[start_idx + 1 : end_idx]\n    return tuple(between_planets)"}
{"task_id": "HumanEval/144", "solution": "def simplify(x, n):\n    \"\"\"\n    Determines if the product of two given fraction strings is a whole number.\n    It parses, multiplies, simplifies fractions, and checks the final denominator.\n    \"\"\"\n\n    class Fraction:\n        \"\"\"Represents a mathematical fraction with an immutable numerator and denominator.\n        Assumes positive integer inputs based on problem constraints.\n        \"\"\"\n        def __init__(self, numerator: int, denominator: int):\n            self._numerator = numerator\n            self._denominator = denominator\n\n        def get_numerator(self) -> int:\n            return self._numerator\n\n        def get_denominator(self) -> int:\n            return self._denominator\n\n        def __eq__(self, other: object) -> bool:\n            # Compares two Fraction objects for value equality.\n            # Assumes 'other' is also a Fraction object for simplicity.\n            return self._numerator == other._numerator and self._denominator == other._denominator\n\n        def __repr__(self) -> str:\n            return f\"{self._numerator}/{self._denominator}\"\n\n    class math_utils:\n        \"\"\"Provides common mathematical utility functions.\n        Specifically for calculating the greatest common divisor (GCD).\n        \"\"\"\n        @staticmethod\n        def gcd(a: int, b: int) -> int:\n            # Implements the Euclidean algorithm to find the greatest common divisor.\n            # Assumes non-negative integer inputs.\n            while b:\n                a, b = b, a % b\n            return a\n\n    class FractionParser:\n        \"\"\"Parses a string representation of a fraction into a Fraction object.\n        This is a stateless utility class.\n        \"\"\"\n        @staticmethod\n        def parse_fraction_string(fraction_str: str) -> Fraction:\n            # Parses a fraction string \"N/D\" into a Fraction object.\n            # Assumes valid string format and integer parts.\n            parts = fraction_str.split('/')\n            numerator = int(parts[0])\n            denominator = int(parts[1])\n            return Fraction(numerator, denominator)\n\n    class FractionService:\n        \"\"\"Encapsulates the core business logic for fraction arithmetic and whole number checks.\n        This is a stateless service.\n        \"\"\"\n        def multiply(self, f1: Fraction, f2: Fraction) -> Fraction:\n            # Multiplies two Fraction objects to produce a new Fraction.\n            # It computes the product of numerators and denominators respectively.\n            new_numerator = f1.get_numerator() * f2.get_numerator()\n            new_denominator = f1.get_denominator() * f2.get_denominator()\n            return Fraction(new_numerator, new_denominator)\n\n        def simplify_fraction(self, f: Fraction) -> Fraction:\n            # Simplifies a given Fraction object to its lowest terms using GCD.\n            # Returns a new simplified Fraction.\n            common_divisor = math_utils.gcd(f.get_numerator(), f.get_denominator())\n            simplified_numerator = f.get_numerator() // common_divisor\n            simplified_denominator = f.get_denominator() // common_divisor\n            return Fraction(simplified_numerator, simplified_denominator)\n\n        def is_whole_number(self, f: Fraction) -> bool:\n            # Checks if a Fraction object (assumed to be simplified) represents a whole number.\n            # This is true if the denominator is 1.\n            return f.get_denominator() == 1\n\n    # Instantiate services and execute main logic\n    fraction_parser_instance = FractionParser()\n    fraction_service_instance = FractionService()\n\n    f_x = fraction_parser_instance.parse_fraction_string(x)\n    f_n = fraction_parser_instance.parse_fraction_string(n)\n\n    f_product = fraction_service_instance.multiply(f_x, f_n)\n    f_simplified = fraction_service_instance.simplify_fraction(f_product)\n\n    return fraction_service_instance.is_whole_number(f_simplified)"}
