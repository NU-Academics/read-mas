{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension from a list based on character casing.\n    The strength is calculated as (uppercase count - lowercase count), with ties broken by first appearance.\"\"\"\n    strongest_extension_name = \"\"\n    max_strength = -float('inf')\n\n    for extension in extensions:\n        cap_count = sum(1 for char in extension if char.isupper())\n        sm_count = sum(1 for char in extension if char.islower())\n        current_strength = cap_count - sm_count\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = extension\n            \n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Finds the strongest extension based on CAP - SM strength and returns it formatted with the class name.\n    In case of a tie, the first-occurring extension in the list is chosen.\n    \"\"\"\n\n    # Assuming 'extensions' list is not empty based on \"Trust the caller's inputs\"\n    # and the implicit requirement for a 'StrongestExtensionName' in the return format.\n    \n    strongest_extension_name = extensions[0]\n    \n    # Calculate initial strength for the first extension in the list\n    cap_count_initial = 0\n    sm_count_initial = 0\n    for char in strongest_extension_name:\n        if char.isupper():\n            cap_count_initial += 1\n        elif char.islower():\n            sm_count_initial += 1\n    max_strength = cap_count_initial - sm_count_initial\n\n    # Iterate through the remaining extensions to find the one with the highest strength\n    for extension_name in extensions[1:]:\n        cap_count = 0\n        sm_count = 0\n        for char in extension_name:\n            if char.isupper():\n                cap_count += 1\n            elif char.islower():\n                sm_count += 1\n        \n        current_strength = cap_count - sm_count\n        \n        # Update if a stronger extension is found.\n        # If strengths are equal, the first-occurring (current strongest_extension_name) is retained.\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = extension_name\n            \n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    '''\n    EPSILON = 1e-9\n\n    # Convert inputs to float for consistent calculations.\n    side1, side2, side3 = float(a), float(b), float(c)\n\n    # Sort the sides to easily identify the potential hypotenuse.\n    s1, s2, s3 = sorted([side1, side2, side3])\n\n    # Check the Pythagorean theorem using a small epsilon for floating-point precision.\n    return abs(s1**2 + s2**2 - s3**2) < EPSILON"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    '''\n    EPSILON = 1e-9 # Epsilon for floating-point comparisons.\n\n    sides = sorted([a, b, c])\n    s1, s2, s3 = sides[0], sides[1], sides[2]\n\n    # Check Triangle Inequality Theorem\n    if not (s1 + s2 > s3):\n        return False\n\n    # Apply Pythagorean theorem: a^2 + b^2 = c^2\n    return abs(s1**2 + s2**2 - s3**2) < EPSILON"}
