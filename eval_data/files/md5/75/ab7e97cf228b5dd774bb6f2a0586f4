{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"\n    Return true if a given number is prime, and false otherwise.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True"}
{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\"\"\"\n    # The function expects an integer input.\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    \n    # Check for divisibility by odd numbers up to the square root of n.\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True"}
{"task_id": "HumanEval/34", "solution": "def unique(l: list) -> list:\n    \"\"\"Return sorted unique elements in a list.\n    This function identifies all unique elements and sorts them in ascending order.\n\n    >>> unique([5, 3, 5, 2, 3, 3, 9, 0, 123])\n    [0, 2, 3, 5, 9, 123]\n    >>> unique([])\n    []\n    >>> unique([1, 1, 1, 1])\n    [1]\n    \"\"\"\n    # Use a set for efficient uniqueness, then convert to list and sort.\n    return sorted(list(set(l)))"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list) -> list:\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three,\n    while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    indices_to_sort = []\n    values_to_sort = []\n\n    for i in range(len(l)):\n        if i % 3 == 0:\n            indices_to_sort.append(i)\n            values_to_sort.append(l[i])\n\n    values_to_sort.sort()\n\n    result_list = list(l)\n\n    for i, original_index in enumerate(indices_to_sort):\n        result_list[original_index] = values_to_sort[i]\n\n    return result_list"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"Sorts elements in list `l` whose indices are divisible by three.\n    Returns a new list with these elements sorted, others unchanged.\n    \"\"\"\n    third_elements = []\n    third_indices = []\n\n    for i in range(len(l)):\n        if i % 3 == 0:\n            third_elements.append(l[i])\n            third_indices.append(i)\n\n    third_elements.sort()\n\n    result_list = l[:]\n\n    for i, sorted_val in zip(third_indices, third_elements):\n        result_list[i] = sorted_val\n\n    return result_list"}
