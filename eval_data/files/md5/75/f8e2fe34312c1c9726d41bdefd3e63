m, and total sum\n    max_kadane = -math.inf\n    current_kadane_sum = 0\n    \n    max_prefix_sum = -math.inf\n    current_prefix_sum = 0\n    \n    max_suffix_sum = -math.inf\n    current_suffix_sum = 0\n\n    total_sum = 0\n\n    for i, num in enumerate(array):\n        # Kadane's for max subarray sum\n        current_kadane_sum = max(num, current_kadane_sum + num)\n        max_kadane = max(max_kadane, current_kadane_sum)\n\n        # Max prefix sum\n        current_prefix_sum += num\n        max_prefix_sum = max(max_prefix_sum, current_prefix_sum)\n        \n        # Max suffix sum (calculated from the end, but can be done linearly too)\n        # To calculate max suffix sum in a single pass, we can use a reversed approach mentally\n        # A simpler way is to iterate and keep track of sums starting from the end,\n        # or calculate prefix sums and then total_sum - prefix_sum_up_to_i to get suffix sum\n        # The design document's pseudo-code for max_suffix seems to compute a 'suffix' if the array were processed in reverse\n        # Let's adjust for max_suffix_sum if iterating linearly\n        # A more standard way for max suffix sum during a single pass is to calculate it after total_sum\n        # For now, let's keep the design's interpretation which seems to be max subarray ending at current position.\n        # However, a true max_suffix_sum is the maximum sum of any contiguous subarray that *ends* at the last element,\n        # or generally, ends at any element from the perspective of the reversed array.\n        # Let's align with the pseudo-code's simple interpretation of max(suffix sum of one block)\n        if i == 0:\n            current_suffix_sum = num\n            max_suffix_sum = num\n        else:\n            current_suffix_sum = max(num, current_suffix_sum + num)\n            max_suffix_sum = max(max_suffix_sum, current_suffix_sum)\n\n\n        total_sum += num\n    \n    # Handle the case where all elements are negative. max_kadane