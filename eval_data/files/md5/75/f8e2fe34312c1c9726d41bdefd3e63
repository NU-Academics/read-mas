blocks (i.e., array + array).\n    # This is effectively max_kadane from a single block, or max_suffix_sum from the first block + max_prefix_sum from the second block.\n    # Note: max_suffix_sum is the max sum ending at the end of the first block, max_prefix_sum is the max sum starting at the beginning of the second block.\n    else:\n        # The maximum sum could be max_kadane (within a single array),\n        # or it could be a segment that spans two copies of the array.\n        # The spanning segment would be max_suffix_sum + max_prefix_sum.\n        # We take max with 0 because we only want to add this spanning sum if it's positive.\n        # If max_suffix_sum + max_prefix_sum is negative, it's better to stick with max_kadane.\n        return max(max_kadane, max_suffix_sum + max_prefix_sum)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[10, 20, -30, -1], 4, 3]], "plus_fail_tests": [[[5, -2, 10, 4, -7, 3], 6, 5]]}], "Mbpp/290": [{"task_id": "Mbpp/290", "solution": "def max_length(list_of_lists):\n    \"\"\"\n    Finds the list of maximum length in a list of lists.\n    Returns a tuple containing the maximum length and the first list with that length.\n    \"\"\"\n    if not list_of_lists:\n        return (0, [])\n\n    max_len = 0\n    max_list = []\n\n    for sublist in list_of_lists:\n        if len(sublist) > max_len:\n            max_len = len(sublist)\n            max_list = sublist\n    \n    return (max_len, max_list)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/283": [{"task_id": "Mbpp/283", "solution": "import collections\ndef validate(number: int) -> bool:\n    \"\"\"Return True if each digit's frequency <= digit value.\"\"\"\n    s = str(abs(number))\n    freq = collections.Counter(s)\n    for digit_char, count in freq.items():\n        digit_val = int(digit_char)\n        if digit_val == 0 or count > digit_val:\n            return False\n    return True", "base_status