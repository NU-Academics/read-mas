twice the previous, and at most m.\n    \"\"\"\n    # dp_prev stores counts for sequences of the previous length, prefix_sum_prev stores their running sums.\n    dp_prev = [0] * (m + 1)\n    prefix_sum_prev = [0] * (m + 1)\n\n    # Initialize for sequences of length 1, where any value from 1 to m is valid.\n    for v in range(1, m + 1):\n        dp_prev[v] = 1\n        prefix_sum_prev[v] = prefix_sum_prev[v-1] + dp_prev[v]\n\n    # Iterate for lengths k from 2 up to n\n    for k in range(2, n + 1):\n        dp_current = [0] * (m + 1)\n        prefix_sum_current = [0] * (m + 1)\n        \n        # Iterate for possible ending values v for sequences of length k\n        for v in range(1, m + 1):\n            # Count current sequences ending with v by summing valid previous sequences using prefix sums.\n            max_prev_val = v // 2\n            if max_prev_val >= 1:\n                dp_current[v] = prefix_sum_prev[max_prev_val]\n            \n            prefix_sum_current[v] = prefix_sum_current[v-1] + dp_current[v]\n        \n        # Update tables for the next length iteration.\n        dp_prev = dp_current\n        prefix_sum_prev = prefix_sum_current\n    \n    # The final result is the total count for length n, stored in prefix_sum_prev[m].\n    return prefix_sum_prev[m]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/251": [{"task_id": "Mbpp/251", "solution": "def insert_element(lst, element):\n    \"\"\"\n    Return a new list with `element` inserted before each element of `lst`.\n    A new list is created, and the original list is not modified.\n    \"\"\"\n    return [item for pair in zip([element]*len(lst), lst) for item in pair]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "Mbpp/253": [{"task_id": "Mbpp/253", "solution": "def count_integer(lst):\n    \"\"\"\n    Returns the number of integer elements in a given list.\n    \"\"\"\n    count = 0\n   