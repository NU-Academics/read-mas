ndidate_strings.append(sw)\n\n        # FR5: Sort candidate strings lexicographically if multiple exist.\n        if len(candidate_strings) > 1:\n            candidate_strings.sort()\n\n        # FR6, FR7: Select and return the first string.\n        selected_sw = candidate_strings[0]\n        return selected_sw.get_lexicographical_value()\n\ndef find_max(words: list[str]) -> str:\n    \"\"\"\n    Finds the word with the maximum number of unique characters.\n    If multiple strings have maximum unique characters, return the one\n    which comes first in lexicographical order.\n    \"\"\"\n    analyzer = StringAnalyzer()\n    return analyzer.find_max(words)\n```"}
