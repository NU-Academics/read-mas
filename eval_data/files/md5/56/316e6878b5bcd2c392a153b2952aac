{"task_id": "HumanEval/11", "solution": "```python\nfrom typing import List\n\n\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n\n    # Class: BinaryString\n    # Encapsulates a binary string value and provides access to its value and length.\n    class BinaryString:\n        def __init__(self, value: str):\n            # As per critical requirements, validation is skipped; trust caller's input.\n            self._value = value\n            self._length = len(value)\n\n        def get_value(self) -> str:\n            return self._value\n\n        def get_length(self) -> int:\n            return self._length\n\n    # Class: XORCalculator\n    # Performs character-by-character bitwise XOR operation on BinaryString objects.\n    class XORCalculator:\n        def calculate(self, a: BinaryString, b: BinaryString) -> BinaryString:\n            # As per critical requirements, length validation is skipped; trust caller's input.\n            result_chars = []\n            for i in range(a.get_length()):\n                char_a = a.get_value()[i]\n                char_b = b.get_value()[i]\n                if char_a == char_b:\n                    result_chars.append('0')\n                else:\n                    result_chars.append('1')\n            return BinaryString(\"\".join(result_chars))\n\n    # string_xor function implementation body\n    binary_a = BinaryString(a)\n    binary_b = BinaryString(b)\n\n    calculator = XORCalculator()\n    result_binary_string = calculator.calculate(binary_a, binary_b)\n\n    return result_binary_string.get_value()\n```"}
{"task_id": "HumanEval/10", "solution": "```python\ndef is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    return string == string[::-1]\n\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string. \"\"\"\n    if not string:\n        return ''\n\n    # Find the starting index of the longest palindromic postfix.\n    longest_pal_postfix_start_idx = 0\n    for i in range(len(string)):\n        if is_palindrome(string[i:]):\n            longest_pal_postfix_start_idx = i\n            break\n\n    # Append the reversed prefix to the original string.\n    prefix_to_reverse = string[:longest_pal_postfix_start_idx]\n    return string + prefix_to_reverse[::-1]\n```"}
{"task_id": "HumanEval/12", "solution": "```python\nfrom typing import List, Optional\n\n\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    >>> longest([])\n\n    >>> longest(['a', 'b', 'c'])\n    'a'\n    >>> longest(['a', 'bb', 'ccc'])\n    'ccc'\n    \"\"\"\n    if not strings:\n        return None\n\n    current_longest = strings[0]\n    for s in strings[1:]:\n        if len(s) > len(current_longest):\n            current_longest = s\n    return current_longest\n```\n"}
{"task_id": "HumanEval/10", "solution": "```python\ndef is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome \"\"\"\n    return string == string[::-1]\n\n\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string.\n    Algorithm idea is simple:\n    - Find the longest postfix of supplied string that is a palindrome.\n    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.\n    >>> make_palindrome('')\n    ''\n    >>> make_palindrome('cat')\n    'catac'\n    >>> make_palindrome('cata')\n    'catac'\n    \"\"\"\n    if not string:\n        return \"\"\n\n    # Find the longest postfix of supplied string that is a palindrome.\n    longest_palindromic_postfix = \"\"\n    for i in range(len(string)):\n        postfix = string[i:]\n        if is_palindrome(postfix):\n            longest_palindromic_postfix = postfix\n            break\n\n    # Determine the prefix that comes before the palindromic suffix.\n    prefix_to_reverse = string[:len(string) - len(longest_palindromic_postfix)]\n\n    # Append to the end of the string reverse of a string prefix.\n    reversed_prefix = prefix_to_reverse[::-1]\n\n    return string + reversed_prefix\n\n```"}
{"task_id": "HumanEval/11", "solution": "```python\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    \"\"\"\n    result_chars = []\n    for char_a, char_b in zip(a, b):\n        xor_result = str(int(char_a) ^ int(char_b))\n        result_chars.append(xor_result)\n    return \"\".join(result_chars)\n```"}
{"task_id": "HumanEval/1", "solution": "```python\nfrom typing import List\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input is a string of nested parentheses; separate distinct, balanced, top-level groups.\n    Ignores spaces and returns a list of these separated group strings.\n    \"\"\"\n\n    def _remove_spaces(s: str) -> str:\n        \"\"\"Removes all space characters from the input string.\"\"\"\n        return s.replace(\" \", \"\")\n\n    def _is_balanced(group_str: str) -> bool:\n        \"\"\"Checks if a string of parentheses is properly balanced.\"\"\"\n        balance_count = 0\n        for char in group_str:\n            if char == '(':\n                balance_count += 1\n            elif char == ')':\n                balance_count -= 1\n            if balance_count < 0:\n                return False\n        return balance_count == 0\n\n    cleaned_string = _remove_spaces(paren_string)\n    result = []\n    balance_counter = 0\n    start_index = 0\n\n    for i in range(len(cleaned_string)):\n        char = cleaned_string[i]\n        if char == '(':\n            balance_counter += 1\n        elif char == ')':\n            balance_counter -= 1\n\n        if balance_counter == 0:\n            potential_group_str = cleaned_string[start_index : i + 1]\n            if _is_balanced(potential_group_str):\n                result.append(potential_group_str)\n            start_index = i + 1\n\n    return result\n```"}
