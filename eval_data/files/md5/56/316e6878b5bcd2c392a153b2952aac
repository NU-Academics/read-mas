{"task_id": "HumanEval/80", "solution": "```python\ndef is_happy(s):\n    \"\"\"Determines if a string is \\'happy\\' based on its length and distinct consecutive characters.\n    A string is happy if its length is at least 3 and every sequence of 3 consecutive characters is distinct.\n    \"\"\"\n    if len(s) < 3:\n        return False\n\n    for i in range(len(s) - 2):\n        char1 = s[i]\n        char2 = s[i+1]\n        char3 = s[i+2]\n\n        if char1 == char2 or char1 == char3 or char2 == char3:\n            return False\n\n    return True\n```"}
{"task_id": "HumanEval/74", "solution": "```python\ndef total_match(lst1, lst2):\n    \"\"\"Compares two lists of strings by their total character counts.\n    Returns the list with fewer total characters, or the first list on a tie.\n    \"\"\"\n    count1 = sum(len(s) for s in lst1)\n    count2 = sum(len(s) for s in lst2)\n\n    if count1 <= count2:\n        return lst1\n    else:\n        return lst2\n```"}
{"task_id": "HumanEval/82", "solution": "```python\ndef prime_length(string):\n    \"\"\"Write a function that takes a string and returns True if the string\n    length is a prime number or False otherwise\n    \"\"\"\n\n    def _is_prime(n):\n        \"\"\"Checks if a given integer n is a prime number.\"\"\"\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n\n        # Check for factors from 3 up to the square root of n\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    length = len(string)\n    return _is_prime(length)\n```"}
{"task_id": "HumanEval/83", "solution": "```python\ndef starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    \"\"\"\n    if n == 1:\n        return 1\n    else:\n        # For n > 1, calculate (starts with 1) + (ends with 1) - (starts and ends with 1).\n        # This simplifies to 18 * 10^(n-2).\n        return 18 * (10**(n-2))\n```"}
{"task_id": "HumanEval/81", "solution": "```python\ndef _get_letter_grade(gpa: float) -> str:\n    \"\"\"Converts a single GPA value to its corresponding letter grade.\n    This function implements the specified grading scale.\n    \"\"\"\n    if gpa == 4.0:\n        return 'A+'\n    elif gpa > 3.7:\n        return 'A'\n    elif gpa > 3.3:\n        return 'A-'\n    elif gpa > 3.0:\n        return 'B+'\n    elif gpa > 2.7:\n        return 'B'\n    elif gpa > 2.3:\n        return 'B-'\n    elif gpa > 2.0:\n        return 'C+'\n    elif gpa > 1.7:\n        return 'C'\n    elif gpa > 1.3:\n        return 'C-'\n    elif gpa > 1.0:\n        return 'D+'\n    elif gpa > 0.7:\n        return 'D'\n    elif gpa > 0.0:\n        return 'D-'\n    return 'E'\n\n\ndef numerical_letter_grade(grades: list[float]) -> list[str]:\n    \"\"\"It is the last week of the semester and the teacher has to give the grades\n    to students. The teacher has been making her own algorithm for grading.\n    The only problem is, she has lost the code she used for grading.\n    She has given you a list of GPAs for some students and you have to write\n    a function that can output a list of letter grades using the following table:\n             GPA       |    Letter grade\n              4.0                A+\n            > 3.7                A\n            > 3.3                A-\n            > 3.0                B+\n            > 2.7                B\n            > 2.3                B-\n            > 2.0                C+\n            > 1.7                C\n            > 1.3                C-\n            > 1.0                D+\n            > 0.7                D\n            > 0.0                D-\n              0.0                E\n\n\n    Example:\n    grade_equation([4.0, 3, 1.7, 2, 3.5]) ==> ['A+', 'B', 'C-', 'C', 'A-']\n    \"\"\"\n    letter_grades = []\n    for gpa in grades:\n        letter_grades.append(_get_letter_grade(gpa))\n    return letter_grades\n```"}
{"task_id": "HumanEval/82", "solution": "```python\ndef _is_prime(n: int) -> bool:\n    \"\"\"Checks if a number is prime.\n    Returns True if n is prime, False otherwise, adhering to BR1.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n\ndef prime_length(string):\n    \"\"\"Write a function that takes a string and returns True if the string\n    length is a prime number or False otherwise\n    Examples\n    prime_length('Hello') == True\n    prime_length('abcdcba') == True\n    prime_length('kittens') == True\n    prime_length('orange') == False\n    \"\"\"\n    length = len(string)\n    return _is_prime(length)\n```"}
{"task_id": "HumanEval/83", "solution": "```python\ndef starts_one_ends(n):\n    \"\"\"\n    Calculates the count of n-digit positive integers that start or end with 1.\n    The logic handles n=1 as a base case and uses an optimized formula for n > 1.\n    \"\"\"\n    if n == 1:\n        return 1\n    else:\n        # For n > 1, the count is derived from inclusion-exclusion:\n        # (Numbers starting with 1) + (Numbers ending with 1) - (Numbers starting AND ending with 1)\n        # which simplifies to 10^(n-1) + 9*10^(n-2) - 10^(n-2) = 18 * 10^(n-2)\n        return 18 * (10 ** (n - 2))\n```"}
{"task_id": "HumanEval/84", "solution": "```python\ndef solve(N):\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n\n    Example\n        For N = 1000, the sum of digits will be 1 the output should be \"1\".\n        For N = 150, the sum of digits will be 6 the output should be \"110\".\n        For N = 147, the sum of digits will be 12 the output should be \"1100\".\n\n    Variables:\n        @N integer\n             Constraints: 0 \u2264 N \u2264 10000.\n    Output:\n         a string of binary number\n    \"\"\"\n    digit_sum = 0\n    n_string = str(N)\n    for char_digit in n_string:\n        digit = int(char_digit)\n        digit_sum += digit\n    binary_raw = bin(digit_sum)\n    binary_result = binary_raw[2:]\n    return binary_result\n```"}
{"task_id": "HumanEval/84", "solution": "```python\ndef _validate_input(N: any) -> int:\n    \"\"\"Validates N: must be an integer between 0 and 10000.\n    Raises ValueError for invalid inputs.\"\"\"\n    if not isinstance(N, int):\n        raise ValueError(\"Invalid input: N must be an integer.\")\n    if not (0 <= N <= 10000):\n        raise ValueError(\"Invalid input: N must be between 0 and 10000 (inclusive).\")\n    return N\n\ndef _calculate_sum_of_digits(n: int) -> int:\n    \"\"\"Calculates the sum of decimal digits for a given integer n.\n    Converts the number to a string and sums its digits.\"\"\"\n    sum_digits = 0\n    for digit_char in str(n):\n        sum_digits += int(digit_char)\n    return sum_digits\n\ndef _to_binary_string(decimal_sum: int) -> str:\n    \"\"\"Converts a decimal integer sum into its binary string representation.\n    Uses the built-in bin() function and removes the '0b' prefix.\"\"\"\n    if decimal_sum == 0:\n        return \"0\"\n    return bin(decimal_sum)[2:]\n\ndef solve(N: int) -> str:\n    \"\"\"Given a positive integer N, return the total sum of its digits in binary.\n    Orchestrates validation, digit sum calculation, and binary conversion.\"\"\"\n    validated_N = _validate_input(N)\n    decimal_sum = _calculate_sum_of_digits(validated_N)\n    binary_result = _to_binary_string(decimal_sum)\n    return binary_result\n```"}
{"task_id": "HumanEval/85", "solution": "```python\ndef add(lst):\n    \"\"\"Adds even elements found at odd (0-based) indices in a list of integers.\n    Example: `add([4, 2, 6, 7])` returns `2`.\n    \"\"\"\n    total_sum = 0\n    for index, value in enumerate(lst):\n        # Check if the 0-based index is odd\n        if index % 2 != 0:\n            # Check if the element value is even\n            if value % 2 == 0:\n                total_sum += value\n    return total_sum\n```"}
{"task_id": "HumanEval/85", "solution": "```python\ndef _is_even(number):\n    \"\"\"Checks if a number is even.\"\"\"\n    return number % 2 == 0\n\ndef _is_odd_index(index):\n    \"\"\"Checks if an index is odd (0-based).\"\"\"\n    return index % 2 != 0\n\ndef add(lst):\n    \"\"\"Calculates the sum of even elements located at odd indices in the list.\n    Assumes `lst` is a non-empty list of integers.\n    \"\"\"\n    total_sum = 0\n    for index, element in enumerate(lst):\n        if _is_odd_index(index) and _is_even(element):\n            total_sum += element\n    return total_sum\n```\n"}
{"task_id": "HumanEval/86", "solution": "```python\ndef anti_shuffle(s):\n    \"\"\"\n    Reorders characters within each word of a string based on their ASCII values in ascending order.\n    Preserves original word order and spacing.\n    \"\"\"\n    result_parts = []\n    current_word_chars = []\n\n    for char in s:\n        if char == ' ':\n            if current_word_chars:\n                # Sort accumulated word characters and append to result_parts\n                sorted_word_str = ''.join(sorted(current_word_chars))\n                result_parts.append(sorted_word_str)\n                current_word_chars = [] # Reset for the next word\n            result_parts.append(char) # Append the space character\n        else:\n            current_word_chars.append(char) # Accumulate characters for the current word\n\n    # After the loop, handle any remaining characters for the last word\n    if current_word_chars:\n        sorted_word_str = ''.join(sorted(current_word_chars))\n        result_parts.append(sorted_word_str)\n\n    return ''.join(result_parts)\n```\n"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Finds occurrences of integer x in a nested list lst and returns their\n    (row, column) coordinates, sorted by row ascending and column descending.\n    \"\"\"\n    if not lst:\n        return []\n\n    coordinates = []\n    for row_idx, current_row in enumerate(lst):\n        for col_idx, current_element in enumerate(current_row):\n            if current_element == x:\n                coordinates.append((row_idx, col_idx))\n\n    if not coordinates:\n        return []\n\n    # Sort primarily by row in ascending order, secondarily by column in descending order.\n    coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n\n    return coordinates"}
{"task_id": "HumanEval/87", "solution": "```python\ndef get_row(lst: list[list[int]], x: int) -> list[tuple[int, int]]:\n    \"\"\"\n    Finds all occurrences of x in a nested list and returns their (row, column) coordinates.\n    The coordinates are sorted primarily by row (ascending) and secondarily by column (descending).\n    \"\"\"\n    found_coordinates = []\n\n    if not lst:\n        return []\n\n    for row_index, row in enumerate(lst):\n        for col_index, element in enumerate(row):\n            if element == x:\n                found_coordinates.append((row_index, col_index))\n\n    if not found_coordinates:\n        return []\n\n    # Sort primarily by row ascending, then by column descending\n    found_coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n\n    return found_coordinates\n```"}
{"task_id": "HumanEval/80", "solution": "```python\ndef is_happy(s):\n    \"\"\"You are given a string s.\n    Your task is to check if the string is happy or not.\n    \"\"\"\n    if len(s) < 3:\n        return False\n\n    # Iterate through all consecutive substrings of length 3\n    # The loop runs up to len(s) - 3 to ensure s[i+2] is a valid index.\n    for i in range(len(s) - 2):\n        # Extract the three characters\n        char1 = s[i]\n        char2 = s[i+1]\n        char3 = s[i+2]\n\n        # Check if the three characters are distinct\n        # A set naturally stores only unique elements. If its size is 3, they are distinct.\n        if len({char1, char2, char3}) != 3:\n            return False\n\n    # If the loop completes, all 3-character substrings were distinct,\\n    # and the string\\'s length was at least 3.\n    return True\n```"}
{"task_id": "HumanEval/88", "solution": "```python\ndef sort_array(array):\n    \"\"\"\n    Sorts an array of non-negative integers based on the sum of its first and last elements.\n    Returns a new array sorted ascending if the sum is odd, descending if even, without modifying the original.\n    \"\"\"\n    if not array:\n        return []\n\n    if len(array) == 1:\n        return list(array)\n\n    copied_array = list(array)\n    first_element = copied_array[0]\n    last_element = copied_array[-1]\n    sum_of_elements = first_element + last_element\n\n    if sum_of_elements % 2 != 0:\n        copied_array.sort(reverse=False)\n    else:\n        copied_array.sort(reverse=True)\n\n    return copied_array\n```"}
{"task_id": "HumanEval/88", "solution": "```python\ndef sort_array(array):\n    \"\"\"\n    Sorts an array of non-negative integers based on the parity of the sum of its first and last elements.\n    Returns a new sorted array, leaving the original unchanged.\n    \"\"\"\n    if not array:\n        return []\n\n    if len(array) == 1:\n        return list(array)\n\n    copied_array = list(array)\n\n    first_element = copied_array[0]\n    last_element = copied_array[-1]\n    sum_first_last = first_element + last_element\n\n    if sum_first_last % 2 != 0:\n        copied_array.sort()\n    else:\n        copied_array.sort(reverse=True)\n\n    return copied_array\n```"}
