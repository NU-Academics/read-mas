{"task_id": "HumanEval/75", "solution": "```python\ndef _is_prime(n: int) -> bool:\n    \"\"\"\n    Determines if a given integer n is a prime number.\n    Handles base cases and checks for divisibility by 2 and odd numbers up to its square root.\n    \"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    # Check for odd divisors from 3 up to sqrt(n)\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n\ndef _get_prime_factors(n: int) -> list[int]:\n    \"\"\"\n    Finds all prime factors of a given integer n.\n    It repeatedly divides by 2, then by odd numbers up to its square root.\n    \"\"\"\n    factors = []\n    # Count the number of 2s that divide n\n    while n % 2 == 0:\n        factors.append(2)\n        n //= 2\n\n    # n must be odd now, so we can skip even numbers\n    i = 3\n    # Check for odd factors from 3 up to sqrt(n)\n    while i * i <= n:\n        while n % i == 0:\n            factors.append(i)\n            n //= i\n        i += 2\n\n    # If n is still greater than 2, then it must be a prime number itself\n    if n > 2:\n        factors.append(n)\n    return factors\n\ndef is_multiply_prime(a: int) -> bool:\n    \"\"\"\n    Returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    \"\"\"\n    # Validate input 'a' against the NFR (a < 100) and ensure it's positive.\n    if a < 1 or a >= 100:\n        return False\n\n    prime_factors = _get_prime_factors(a)\n    return len(prime_factors) == 3\n```"}
{"task_id": "HumanEval/74", "solution": "```python\nfrom typing import List\n\ndef _calculate_total_char_count(string_list: List[str]) -> int:\n    \"\"\"Calculates the sum of lengths of all strings in a list.\n    This is a private helper function for total_match.\"\"\"\n    total_count = 0\n    for s in string_list:\n        total_count += len(s)\n    return total_count\n\ndef total_match(lst1: List[str], lst2: List[str]) -> List[str]:\n    \"\"\"Compares two lists of strings based on total character counts.\n    Returns the list with fewer characters, or lst1 in case of a tie.\"\"\"\n\n    count1 = _calculate_total_char_count(lst1)\n    count2 = _calculate_total_char_count(lst2)\n\n    if count1 <= count2:\n        return lst1\n    else:\n        return lst2\n```\n"}
