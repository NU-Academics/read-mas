{"task_id": "HumanEval/91", "solution": "```python\ndef _split_into_sentences(text: str) -> list[str]:\n    \"\"\"\n    Splits the input text into a list of sentences based on delimiters.\n    Delimiters are '.', '?', '!'.\n    \"\"\"\n    sentences = []\n    current_sentence_start = 0\n    for i, char in enumerate(text):\n        if char in ['.', '?', '!']:\n            sentence = text[current_sentence_start : i + 1].strip()\n            if sentence:\n                sentences.append(sentence)\n            current_sentence_start = i + 1\n\n    remaining_part = text[current_sentence_start:].strip()\n    if remaining_part:\n        sentences.append(remaining_part)\n\n    return sentences\n\ndef _starts_with_i(sentence_text: str) -> bool:\n    \"\"\"\n    Checks if a sentence starts with the exact word \"I\" (case-sensitive).\n    This ensures \"I'm\" or \"In\" are not counted.\n    \"\"\"\n    trimmed = sentence_text.lstrip()\n\n    if not trimmed.startswith(\"I\"):\n        return False\n\n    if len(trimmed) == 1:\n        return True\n\n    char_after_I = trimmed[1]\n    if char_after_I == ' ' or char_after_I in ['.', '?', '!']:\n        return True\n\n    return False\n\ndef is_bored(S: str) -> int:\n    \"\"\"\n    You'll be given a string of words, and your task is to count the number\n    of boredoms. A boredom is a sentence that starts with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n\n    For example:\n    >>> is_bored(\"Hello world\")\n    0\n    >>> is_bored(\"The sky is blue. The sun is shining. I love this weather\")\n    1\n    \"\"\"\n    boredom_count = 0\n    sentences = _split_into_sentences(S)\n\n    for sentence in sentences:\n        if _starts_with_i(sentence):\n            boredom_count += 1\n\n    return boredom_count\n```"}
{"task_id": "HumanEval/92", "solution": "```python\ndef any_int(x, y, z):\n    '''\n    Checks if three numbers are all integers and if one is the sum of the other two.\\n    Returns True only if both conditions are met, otherwise False.\n    '''\n    # Verify that all three arguments are integers as per the design.\n    if not (isinstance(x, int) and isinstance(y, int) and isinstance(z, int)):\n        return False\n\n    # If all numbers are integers, check if any one is the sum of the other two.\n    return (x == y + z) or (y == x + z) or (z == x + y)\n```"}
{"task_id": "HumanEval/93", "solution": "```python\ndef encode(message: str) -> str:\n    \"\"\"Encodes a message by swapping letter cases. If a case-swapped character is a vowel, it is replaced by the letter two places ahead; non-alphabetic characters are retained.\"\"\"\n    encoded_chars = []\n    LOWERCASE_VOWELS = {'a', 'e', 'i', 'o', 'u'}\n    UPPERCASE_VOWELS = {'A', 'E', 'I', 'O', 'U'}\n    LOWERCASE_VOWEL_MAP = {'a': 'c', 'e': 'g', 'i': 'k', 'o': 'q', 'u': 'w'}\n    UPPERCASE_VOWEL_MAP = {'A': 'C', 'E': 'G', 'I': 'K', 'O': 'Q', 'U': 'W'}\n\n    for char in message:\n        if char.isalpha():\n            swapped_char = char.swapcase()\n            if swapped_char in LOWERCASE_VOWELS:\n                encoded_chars.append(LOWERCASE_VOWEL_MAP[swapped_char])\n            elif swapped_char in UPPERCASE_VOWELS:\n                encoded_chars.append(UPPERCASE_VOWEL_MAP[swapped_char])\n            else:\n                encoded_chars.append(swapped_char)\n        else:\n            encoded_chars.append(char)\n\n    return ''.join(encoded_chars)\n```"}
{"task_id": "HumanEval/93", "solution": "```python\ndef _is_vowel(char: str) -> bool:\n    \"\"\"Determines if a character is an English vowel (case-insensitive).\"\"\"\n    return char.lower() in 'aeiou'\n\ndef _get_char_offset(char: str, offset: int) -> str:\n    \"\"\"Returns the character a specified offset ahead in the alphabet, maintaining case.\"\"\"\n    if 'a' <= char <= 'z':\n        start_char_ord = ord('a')\n    elif 'A' <= char <= 'Z':\n        start_char_ord = ord('A')\n    else:\n        return char # Non-alphabetic characters are returned as is (though spec implies only letters)\n\n    current_pos = ord(char) - start_char_ord\n    new_pos = (current_pos + offset) % 26\n    return chr(start_char_ord + new_pos)\n\ndef _swap_case_char(char: str) -> str:\n    \"\"\"Swaps the case of a single alphabetic character.\"\"\"\n    return char.swapcase()\n\ndef encode(message: str) -> str:\n    \"\"\"\n    Encodes a message by replacing vowels and then swapping the case of all letters.\n    Assumes the input message contains only letters.\n    \"\"\"\n    encoded_chars_vowel_replaced = []\n    for original_char in message:\n        if _is_vowel(original_char):\n            replacement_char = _get_char_offset(original_char, 2)\n            encoded_chars_vowel_replaced.append(replacement_char)\n        else:\n            encoded_chars_vowel_replaced.append(original_char)\n    intermediate_string = \"\".join(encoded_chars_vowel_replaced)\n\n    final_encoded_chars = []\n    for char in intermediate_string:\n        swapped_char = _swap_case_char(char)\n        final_encoded_chars.append(swapped_char)\n\n    return \"\".join(final_encoded_chars)\n```\n"}
{"task_id": "HumanEval/94", "solution": "```python\ndef is_prime(n: int) -> bool:\n    \"\"\"Determines if a given integer is a prime number.\n    Handles numbers less than 2, and efficiently checks for divisibility.\"\"\"\n    if n < 2:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n\ndef sum_digits(n: int) -> int:\n    \"\"\"Calculates the sum of the digits of a given integer.\n    Converts the number to its positive form to sum digits correctly.\"\"\"\n    total_sum = 0\n    # Assuming positive integers as per prime number context.\n    while n > 0:\n        total_sum += n % 10\n        n //= 10\n    return total_sum\n\ndef skjkasdkd(lst: list[int]) -> int:\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n\n    Examples:\n    For lst = [0,3,2,1,3,5,7,4,5,5,5,2,181,32,4,32,3,2,32,324,4,3] the output should be 10\n    For lst = [1,0,1,8,2,4597,2,1,3,40,1,2,1,2,4,2,5,1] the output should be 25\n    For lst = [1,3,1,32,5107,34,83278,109,163,23,2323,32,30,1,9,3] the output should be 13\n    For lst = [0,724,32,71,99,32,6,0,5,91,83,0,5,6] the output should be 11\n    For lst = [0,81,12,3,1,21] the output should be 3\n    For lst = [0,8,1,2,1,7] the output should be 7\n    \"\"\"\n    largest_prime = 0\n    for number in lst:\n        if is_prime(number) and number > largest_prime:\n            largest_prime = number\n\n    if largest_prime == 0:\n        return 0\n    else:\n        return sum_digits(largest_prime)\n\n```"}
{"task_id": "HumanEval/94", "solution": "```python\ndef skjkasdkd(lst):\n    \"\"\"You are given a list of integers.\n    You need to find the largest prime value and return the sum of its digits.\n    \"\"\"\n\n    def _is_prime(number):\n        \"\"\"Determines if a given integer is a prime number.\"\"\"\n        if number <= 1:\n            return False\n        i = 2\n        while i * i <= number:\n            if number % i == 0:\n                return False\n            i += 1\n        return True\n\n    def _find_largest_prime(lst):\n        \"\"\"Identifies the largest prime number from a list.\"\"\"\n        largest_prime = 0\n        for number in lst:\n            if _is_prime(number) and number > largest_prime:\n                largest_prime = number\n        return largest_prime\n\n    def _sum_digits(number):\n        \"\"\"Calculates the sum of the digits of a given integer.\"\"\"\n        digit_sum = 0\n        for digit_char in str(number):\n            digit_sum += int(digit_char)\n        return digit_sum\n\n    largest_prime_val = _find_largest_prime(lst)\n\n    if largest_prime_val == 0:\n        return 0\n    else:\n        return _sum_digits(largest_prime_val)\n```"}
{"task_id": "HumanEval/95", "solution": "```python\ndef check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower\n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    \"\"\"\n    if not dict:\n        return False\n\n    has_lowercase_keys = False\n    has_uppercase_keys = False\n\n    for key in dict:\n        if not isinstance(key, str):\n            return False\n\n        if key.islower():\n            has_lowercase_keys = True\n        elif key.isupper():\n            has_uppercase_keys = True\n        else: # Key is a mixed-case string (e.g., \\\"Name\\\")\n            return False\n\n        if has_lowercase_keys and has_uppercase_keys:\n            return False\n\n    return True\n```"}
{"task_id": "HumanEval/95", "solution": "```python\ndef check_dict_case(dict):\n    \"\"\"\n    Checks if all dictionary keys are consistently lowercase or consistently uppercase.\n    Returns False if the dictionary is empty.\n    \"\"\"\n    if not dict:\n        return False\n\n    all_lowercase = all(key.islower() for key in dict.keys())\n    all_uppercase = all(key.isupper() for key in dict.keys())\n\n    return all_lowercase or all_uppercase\n```"}
{"task_id": "HumanEval/97", "solution": "```python\ndef multiply(a, b):\\\n    \"\"\"Complete the function that takes two integers and returns\n    the product of their unit digits.\n    Assume the input is always valid.\n    Examples:\n    multiply(148, 412) should return 16.\n    multiply(19, 28) should return 72.\n    multiply(2020, 1851) should return 0.\n    multiply(14,-15) should return 20.\n    \"\"\"\n    unit_digit_a = abs(a) % 10\n    unit_digit_b = abs(b) % 10\n    product = unit_digit_a * unit_digit_b\n    return product\n```"}
{"task_id": "HumanEval/96", "solution": "```python\ndef _is_prime(num: int) -> bool:\n    \"\"\"Helper function to determine if a number is prime.\n    It uses an optimized trial division method up to the square root of the number.\"\"\"\n    if num < 2:\n        return False\n    if num == 2:\n        return True\n    if num % 2 == 0:\n        return False\n    # Check for divisors from 3 up to sqrt(num), only odd numbers\n    i = 3\n    while i * i <= num:\n        if num % i == 0:\n            return False\n        i += 2\n    return True\n\ndef count_up_to(n: int) -> list[int]:\n    \"\"\"Returns a list of all prime numbers strictly less than n.\n    Handles edge cases for n less than 3 by returning an empty list.\"\"\"\n    primes = []\n    if n < 3:  # No primes strictly less than 0, 1, or 2\n        return primes\n\n    for num in range(2, n):\n        if _is_prime(num):\n            primes.append(num)\n    return primes\n```"}
{"task_id": "HumanEval/98", "solution": "```python\ndef _is_uppercase_vowel(char):\n    \"\"\"Checks if a character is an uppercase vowel (A, E, I, O, U).\"\"\"\n    return char in 'AEIOU'\n\ndef count_upper(s):\n    \"\"\"\n    Counts the number of uppercase vowels located at even indices in the input string s.\n    It iterates through the string, checking both index parity and character type.\n    \"\"\"\n    count = 0\n    for i, char in enumerate(s):\n        if i % 2 == 0:\n            if _is_uppercase_vowel(char):\n                count += 1\n    return count\n```"}
