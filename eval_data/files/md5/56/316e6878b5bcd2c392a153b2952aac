{"task_id": "HumanEval/137", "solution": "```python\nclass Value:\n    def __init__(self, data):\n        self.original_data = data\n        # Converts any input (int, float, str) to its string representation,\n        # normalizes the decimal separator, and then converts to a float.\n        self.numeric_representation = Value._convert_string_to_float(str(data))\n\n    def get_numeric_representation(self):\n        return self.numeric_representation\n\n    def get_original_data(self):\n        return self.original_data\n\n    @staticmethod\n    def _convert_string_to_float(s: str) -> float:\n        # Replaces comma with a dot for decimal separation and converts the string to a float.\n        return float(s.replace(',', '.'))\n\ndef compare_one(a, b):\n    \"\"\"\n    Create a function that takes integers, floats, or strings representing\n    real numbers, and returns the larger variable in its given variable type.\n    Return None if the values are equal.\n    Note: If a real number is represented as a string, the floating point might be . or ,\n    \"\"\"\n    # Encapsulate inputs into Value objects to obtain their normalized numeric representation.\n    value_a = Value(a)\n    value_b = Value(b)\n\n    num_a = value_a.get_numeric_representation()\n    num_b = value_b.get_numeric_representation()\n\n    if num_a > num_b:\n        return value_a.get_original_data()\n    elif num_b > num_a:\n        return value_b.get_original_data()\n    else:\n        return None\n```"}
{"task_id": "HumanEval/139", "solution": "```python\ndef special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as:\n    brazilian_factorial(n) = n! * (n-1)! * (n-2)! * ... * 1!\n    where n > 0\n    \"\"\"\n    def _calculate_factorial(k):\n        \"\"\"Calculates the factorial of a given integer k.\"\"\"\n        fact = 1\n        for i in range(1, k + 1):\n            fact *= i\n        return fact\n\n    if n <= 0:\n        raise ValueError(\"Input n must be greater than 0\")\n\n    special_fact_result = 1\n    for k in range(1, n + 1):\n        special_fact_result *= _calculate_factorial(k)\n\n    return special_fact_result\n```"}
{"task_id": "HumanEval/140", "solution": "```python\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores,\n    and if a string has more than 2 consecutive spaces,\n    then replace all consecutive spaces with -\n\n    fix_spaces(\"Example\") == \"Example\"\n    fix_spaces(\"Example 1\") == \"Example_1\"\n    fix_spaces(\" Example 2\") == \"_Example_2\"\n    fix_spaces(\" Example   3\") == \"_Example-3\"\n    \"\"\"\n    result = []\n    i = 0\n    n = len(text)\n    while i < n:\n        if text[i] == ' ':\n            space_count = 0\n            j = i\n            while j < n and text[j] == ' ':\n                space_count += 1\n                j += 1\n\n            if space_count >= 3:\n                result.append('-')\n            elif space_count == 2:\n                result.append('__')\n            else: # space_count == 1\n                result.append('_')\n\n            i = j\n        else:\n            result.append(text[i])\n            i += 1\n    return \"\".join(result)\n```"}
{"task_id": "HumanEval/140", "solution": "```python\nimport re\n\ndef fix_spaces(text):\n    \"\"\"\n    Standardize space formatting by replacing multiple spaces then single spaces.\n    Sequences of three or more spaces become hyphens, and remaining single spaces become underscores.\n    \"\"\"\n    text_with_hyphens = re.sub(r' {3,}', '-', text)\n    final_text = text_with_hyphens.replace(' ', '_')\n    return final_text\n```"}
{"task_id": "HumanEval/132", "solution": "def is_nested(s):\n    \"\"\"\n    Checks if the input string contains at least one valid subsequence of brackets\n    that exhibits a nested structure.\n    \"\"\"\n\n    def _is_valid_input_string(s_val):\n        \"\"\"Checks if the string contains only square brackets.\"\"\"\n        return all(char in ('[', ']') for char in s_val)\n\n    def _is_valid_bracket_sequence(sequence):\n        \"\"\"\n        Checks if a bracket sequence is valid (balanced and correctly ordered).\n        It returns True if `sequence` is a valid bracket sequence, False otherwise.\n        \"\"\"\n        balance = 0\n        for char in sequence:\n            if char == '[':\n                balance += 1\n            elif char == ']':\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    def _has_nested_structure(sequence):\n        \"\"\"\n        Checks if a valid bracket sequence exhibits a nested structure.\n        A sequence is considered nested if its maximum bracket depth is greater than 1.\n        \"\"\"\n        # Smallest nested sequence is '[[]]' which has length 4.\n        # This check is an optimization and ensures a minimal structure for nesting.\n        if len(sequence) < 4:\n            return False\n\n        balance = 0\n        max_balance = 0\n        for char in sequence:\n            if char == '[':\n                balance += 1\n            elif char == ']':\n                balance -= 1\n            max_balance = max(max_balance, balance)\n\n        # For a valid bracket sequence, a max_balance > 1 indicates nesting.\n        # For example, '[[]]' has max_balance = 2, while '[][][]' has max_balance = 1.\n        return max_balance > 1\n\n    # --- Main is_nested logic ---\n    if not _is_valid_input_string(s):\n        return False\n\n    n = len(s)\n\n    # Iterate through all possible subsequences using bit manipulation.\n    # Each bit in `i` indicates whether to include the character at that index.\n    for i in range(1, 1 << n):  # `1 << n` is 2^n. `range(1, ...)` skips the empty subsequence.\n        current_subsequence_chars = []\n        for j in range(n):\n            if (i >> j) & 1:  # If the j-th bit of `i` is set\n                current_subsequence_chars.append(s[j])\n\n        subsequence = \"\".join(current_subsequence_chars)\n\n        # Optimization: A nested sequence must have at least 4 characters.\n        # For instance, '[[]]' is the smallest nested valid sequence.\n        if len(subsequence) < 4:\n            continue\n\n        if _is_valid_bracket_sequence(subsequence):\n            if _has_nested_structure(subsequence):\n                return True\n\n    return False```"}
{"task_id": "HumanEval/141", "solution": "```python\nclass FileNameValidator:\n    \"\"\"Validates a file name against a set of predefined rules.\"\"\"\n    def __init__(self, file_name: str):\n        self.file_name = file_name\n        self._cached_prefix = None\n        self._cached_suffix = None\n\n    def _count_digits(self) -> bool:\n        \"\"\"Checks if the file name contains no more than three digits.\"\"\"\n        digit_count = 0\n        for char in self.file_name:\n            if '0' <= char <= '9':\n                digit_count += 1\n        return digit_count <= 3\n\n    def _count_dots(self) -> bool:\n        \"\"\"Checks if the file name contains exactly one dot.\"\"\"\n        return self.file_name.count('.') == 1\n\n    def _get_prefix(self) -> str:\n        \"\"\"Extracts the substring before the dot.\"\"\"\n        if self._cached_prefix is None:\n            self._cached_prefix = self.file_name.split('.')[0]\n        return self._cached_prefix\n\n    def _get_suffix(self) -> str:\n        \"\"\"Extracts the substring after the dot.\"\"\"\n        if self._cached_suffix is None:\n            self._cached_suffix = self.file_name.split('.')[1]\n        return self._cached_suffix\n\n    def _is_prefix_not_empty(self) -> bool:\n        \"\"\"Checks if the extracted prefix is not empty.\"\"\"\n        return len(self._get_prefix()) > 0\n\n    def _starts_with_latin_letter(self) -> bool:\n        \"\"\"Checks if the prefix starts with a letter from the Latin alphabet.\"\"\"\n        prefix = self._get_prefix()\n        if not prefix:\n            return False\n        first_char = prefix[0]\n        return ('a' <= first_char <= 'z') or ('A' <= first_char <= 'Z')\n\n    def _is_valid_extension(self) -> bool:\n        \"\"\"Checks if the extracted suffix is one of 'txt', 'exe', or 'dll'.\"\"\"\n        return self._get_suffix() in ['txt', 'exe', 'dll']\n\n    def is_valid(self) -> bool:\n        \"\"\"Orchestrates all validation checks and returns True if all pass, False otherwise.\"\"\"\n        if not self._count_digits():\n            return False\n\n        if not self._count_dots():\n            return False\n\n        # Prefix and suffix dependent checks can now safely proceed\n        if not self._is_prefix_not_empty():\n            return False\n        if not self._starts_with_latin_letter():\n            return False\n        if not self._is_valid_extension():\n            return False\n\n        return True\n\n\ndef file_name_check(file_name):\n    \"\"\"Checks if a file name is valid according to predefined rules.\n    Returns 'Yes' for a valid name, 'No' otherwise.\"\"\"\n    validator = FileNameValidator(file_name)\n    if validator.is_valid():\n        return 'Yes'\n    else:\n        return 'No'\n```"}
{"task_id": "HumanEval/141", "solution": "_ALLOWED_EXTENSIONS = {'txt', 'exe', 'dll'}\n\ndef _count_digits(s: str) -> int:\n    \"\"\"Counts the number of digits in the input string.\n    Iterates through characters to find '0'-'9'.\n    \"\"\"\n    count = 0\n    for char in s:\n        if '0' <= char <= '9':\n            count += 1\n    return count\n\ndef _starts_with_latin_letter(s: str) -> bool:\n    \"\"\"Checks if the first character of the string is a Latin letter.\n    Returns False for empty strings or non-alphabetic first characters.\n    \"\"\"\n    if not s:\n        return False\n    first_char = s[0]\n    return ('a' <= first_char <= 'z') or ('A' <= first_char <= 'Z')\n\ndef _is_valid_extension(ext: str) -> bool:\n    \"\"\"Checks if the given extension is one of the allowed types.\n    Compares the extension against a predefined set of valid extensions.\n    \"\"\"\n    return ext in _ALLOWED_EXTENSIONS\n\ndef file_name_check(file_name):\n    \"\"\"Checks if a file name is valid based on several criteria.\n    Returns 'Yes' if all conditions are met, otherwise 'No'.\n    \"\"\"\n    if file_name.count('.') != 1:\n        return 'No'\n\n    name_part, extension_part = file_name.split('.', 1)\n\n    if not name_part:\n        return 'No'\n\n    if not _starts_with_latin_letter(name_part):\n        return 'No'\n\n    if not _is_valid_extension(extension_part):\n        return 'No'\n\n    if _count_digits(file_name) > 3:\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/142", "solution": "```python\ndef sum_squares(lst):\n    \"\"\"\n    This function processes a list of integers, modifying entries based on their index.\n    It returns the sum of all modified (or original) entries.\n    \"\"\"\n    if not lst:\n        return 0\n\n    total_sum = 0\n    for index, value in enumerate(lst):\n        if index % 3 == 0:\n            # Square if index is a multiple of 3\n            total_sum += value * value\n        elif index % 4 == 0:\n            # Cube if index is a multiple of 4 and not a multiple of 3\n            total_sum += value * value * value\n        else:\n            # Otherwise, add the value unchanged\n            total_sum += value\n    return total_sum\n```"}
{"task_id": "HumanEval/142", "solution": "```python\ndef sum_squares(lst):\n    \"\"\"\"\n    This function will take a list of integers. For all entries in the list, the function shall square the integer entry if its index is a\n    multiple of 3 and will cube the integer entry if its index is a multiple of 4 and not a multiple of 3. The function will not\n    change the entries in the list whose indexes are not a multiple of 3 or 4. The function shall then return the sum of all entries.\n\n    Examples:\n    For lst = [1,2,3] the output should be 6\n    For lst = []  the output should be 0\n    For lst = [-1,-5,2,-1,-5]  the output should be -126\n    \"\"\"\n    total_sum = 0\n    for i, entry in enumerate(lst):\n        if i % 3 == 0:\n            total_sum += entry * entry\n        elif i % 4 == 0:\n            total_sum += entry * entry * entry\n        else:\n            total_sum += entry\n    return total_sum\n```"}
{"task_id": "HumanEval/143", "solution": "```python\nimport math\n\ndef _validate_sentence(sentence: str) -> None:\n    \"\"\"\n    Validates the input sentence for length and character constraints.\n    Raises ValueError if validation fails according to NFR1 and NFR2.\n    \"\"\"\n    if not (1 <= len(sentence) <= 100):\n        raise ValueError(\"Sentence length must be between 1 and 100 characters.\")\n    for char in sentence:\n        if not (char.isalpha() or char == ' '):\n            raise ValueError(\"Sentence must contain only letters and spaces.\")\n\ndef _is_prime(n: int) -> bool:\n    \"\"\"\n    Determines if a given integer n is a prime number.\n    Handles edge cases for primality testing efficiently.\n    \"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n\ndef words_in_sentence(sentence: str) -> str:\n    \"\"\"\n    Filters words from a sentence, returning only those whose lengths are prime numbers.\n    Maintains the original order of words in the new string.\n    \"\"\"\n    _validate_sentence(sentence)\n\n    filtered_words = []\n    words = sentence.split(' ')\n\n    for word in words:\n        if word: # Handle potential multiple spaces leading to empty strings\n            word_length = len(word)\n            if _is_prime(word_length):\n                filtered_words.append(word)\n\n    return ' '.join(filtered_words)\n```"}
{"task_id": "HumanEval/144", "solution": "```python\ndef gcd(a, b):\n    \"\"\"Calculates the greatest common divisor of two integers using the Euclidean algorithm.\"\"\"\n    while b:\n        a, b = b, a % b\n    return a\n\nclass Fraction:\n    \"\"\"Represents a fraction with a numerator and a denominator.\"\"\"\n\n    def __init__(self, numerator, denominator):\n        self.numerator = numerator\n        self.denominator = denominator\n\n    @staticmethod\n    def parse(fractionString):\n        \"\"\"Parses a fraction string into a Fraction object.\"\"\"\n        num_str, den_str = fractionString.split('/')\n        return Fraction(int(num_str), int(den_str))\n\n    def multiply(self, otherFraction):\n        \"\"\"Multiplies this fraction by another fraction to create a new product fraction.\"\"\"\n        new_numerator = self.numerator * otherFraction.numerator\n        new_denominator = self.denominator * otherFraction.denominator\n        return Fraction(new_numerator, new_denominator)\n\n    def is_whole_number(self):\n        \"\"\"Checks if the fraction represents a whole number after simplification.\"\"\"\n        common_divisor = gcd(self.numerator, self.denominator)\n        simplified_denominator = self.denominator // common_divisor\n        return simplified_denominator == 1\n\ndef simplify(x, n):\n    \"\"\"Determines if the product of two fractions evaluates to a whole number.\"\"\"\n    fraction_x = Fraction.parse(x)\n    fraction_n = Fraction.parse(n)\n    product_fraction = fraction_x.multiply(fraction_n)\n    return product_fraction.is_whole_number()\n```"}
{"task_id": "HumanEval/143", "solution": "class PrimeNumberChecker:\n    \"\"\"Utility class to check if a number is prime.\"\"\"\n    @staticmethod\n    def is_prime(number: int) -> bool:\n        if number < 2:\n            return False\n        # Check for divisibility from 2 up to half the number.\n        for i in range(2, (number // 2) + 1):\n            if number % i == 0:\n                return False\n        return True\n\n\nclass Word:\n    \"\"\"Represents a single word, storing its text and length.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n        self.length = len(text)\n\n    def is_length_prime(self) -> bool:\n        \"\"\"Checks if the word's length is a prime number.\"\"\"\n        return PrimeNumberChecker.is_prime(self.length)\n\n\nclass Sentence:\n    \"\"\"Represents a sentence, managing its text and contained words.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n        self.length = len(text)\n        self.words: list[Word] = []\n\n    def split_into_words(self) -> list[Word]:\n        \"\"\"Splits the sentence text into individual Word objects.\"\"\"\n        # Split by space and filter out any empty strings resulting from multiple spaces.\n        word_texts = self.text.split(' ')\n        self.words = [Word(wt) for wt in word_texts if wt]\n        return self.words\n\n\nclass SentenceProcessor:\n    \"\"\"Orchestrates the filtering logic to find words with prime lengths.\"\"\"\n    def words_in_sentence(self, sentence: str) -> str:\n        # Validate sentence length against NFR1.\n        if not (1 <= len(sentence) <= 100):\n            raise ValueError(\"Sentence length must be between 1 and 100 characters, inclusive.\")\n        # Validate sentence characters against NFR2.\n        if not all(c.isalpha() or c.isspace() for c in sentence):\n            raise ValueError(\"Sentence must contain only letters (a-z, A-Z) and spaces.\")\n\n        sentence_obj = Sentence(sentence)\n        all_words = sentence_obj.split_into_words()\n\n        # Filter words whose lengths are prime numbers, preserving original order.\n        filtered_words_texts = [word.text for word in all_words if word.is_length_prime()]\n\n        return \" \".join(filtered_words_texts)\n\n\ndef words_in_sentence(sentence: str) -> str:\n    \"\"\"\n    Returns a string containing words from the original sentence whose lengths are prime numbers.\n    The order of the words in the new string should be the same as the original one.\n    \"\"\"\n    processor = SentenceProcessor()\n    return processor.words_in_sentence(sentence)"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums: list[int]) -> list[int]:\n    \"\"\"Sorts a list of integers by the sum of their digits, then by original index.\n    Returns an empty list for an empty input.\n    \"\"\"\n    if not nums:\n        return []\n\n    def _calculate_sum_of_digits(number: int) -> int:\n        \"\"\"Calculates the sum of digits for a number, treating it as positive.\n        This helper is used for the primary sorting criterion.\n        \"\"\"\n        s = 0\n        n = abs(number)\n        while n > 0:\n            s += n % 10\n            n //= 10\n        return s\n\n    class _DigitSumInteger:\n        \"\"\"Helper class to encapsulate an integer, its original index, and digit sum.\n        It defines custom comparison logic for sorting based on design requirements.\n        \"\"\"\n        def __init__(self, value: int, original_index: int, sum_of_digits: int):\n            self.value = value\n            self.original_index = original_index\n            self.sum_of_digits = sum_of_digits\n\n        def __lt__(self, other) -> bool:\n            \"\"\"Compares objects by digit sum (ascending) then original index (ascending).\"\"\"\n            if self.sum_of_digits != other.sum_of_digits:\n                return self.sum_of_digits < other.sum_of_digits\n            return self.original_index < other.original_index\n\n    processed_nums = []\n    for i, num in enumerate(nums):\n        sum_of_digits = _calculate_sum_of_digits(num)\n        processed_nums.append(_DigitSumInteger(num, i, sum_of_digits))\n\n    processed_nums.sort()\n\n    return [item.value for item in processed_nums]"}
{"task_id": "HumanEval/145", "solution": "```python\ndef order_by_points(nums: list[int]) -> list[int]:\n    \"\"\"\n    Sorts a list of integers by the sum of absolute values of their digits.\n    Ties are broken by the original index of the numbers.\n    \"\"\"\n\n    def _calculate_digit_sum(number: int) -> int:\n        \"\"\"Calculates the sum of the absolute values of the digits of a number.\"\"\"\n        return sum(int(digit) for digit in str(abs(number)))\n\n    if not nums:\n        return []\n\n    # Create intermediate data as tuples: (digit_sum, original_index, value)\n    intermediate_data = []\n    for original_index, value in enumerate(nums):\n        digit_sum = _calculate_digit_sum(value)\n        intermediate_data.append((digit_sum, original_index, value))\n\n    # Sort the intermediate data using a lambda key for primary and secondary sorting.\n    intermediate_data.sort(key=lambda item: (item[0], item[1]))\n\n    # Extract only the original numbers from the sorted intermediate data.\n    sorted_result = [item[2] for item in intermediate_data]\n\n    return sorted_result\n```\n"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"Calculates the Brazilian factorial, which is the product of factorials from n down to 1.\n    Assumes n is a positive integer.\n    \"\"\"\n    special_fact_result = 1\n    # Iterate from n down to 1 to compute the product of factorials.\n    for i in range(n, 0, -1):\n        current_factorial = 1\n        # Calculate the factorial of the current number i.\n        for j in range(1, i + 1):\n            current_factorial *= j\n        special_fact_result *= current_factorial\n    return special_fact_result"}
{"task_id": "HumanEval/138", "solution": "```python\ndef is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether the given number n can be written as the sum of exactly 4 positive even numbers.\n    Example\n    is_equal_to_sum_even(4) == False\n    is_equal_to_sum_even(6) == False\n    is_equal_to_sum_even(8) == True\n    \"\"\"\n    # BR6: Minimum sum is 8 (2+2+2+2).\n    # BR7: Sum of four even numbers must be even.\n    if n < 8 or n % 2 != 0:\n        return False\n    # For any even n >= 8, it can always be expressed as (n-6) + 2 + 2 + 2.\n    return True\n```"}
{"task_id": "HumanEval/148", "solution": "```python\nPLANETS = [\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"]\n\ndef bf(planet1, planet2):\n    '''\n    Returns a tuple of planets located between planet1 and planet2, sorted by proximity to the Sun.\n    Returns an empty tuple if either input planet name is invalid.\n    '''\n    if planet1 not in PLANETS or planet2 not in PLANETS:\n        return ()\n\n    idx1 = PLANETS.index(planet1)\n    idx2 = PLANETS.index(planet2)\n\n    start_index = min(idx1, idx2)\n    end_index = max(idx1, idx2)\n\n    # Slice the PLANETS list, excluding the start and end planets themselves.\n    return tuple(PLANETS[start_index + 1 : end_index])\n```"}
{"task_id": "HumanEval/148", "solution": "```python\nclass Planet:\n    \"\"\"Represents a planet with its name and order from the Sun.\"\"\"\n    def __init__(self, name: str, order_from_sun: int):\n        self.name = name\n        self.order_from_sun = order_from_sun\n\nclass SolarSystem:\n    \"\"\"Manages solar system planet data and provides methods to query them.\"\"\"\n    def __init__(self):\n        \"\"\"Initializes the SolarSystem with planet data and their orders.\"\"\"\n        self._planets_data: list[Planet] = []\n        self._planet_names_to_order: dict[str, int] = {}\n\n        planets_raw_data = [\n            (\"Mercury\", 1), (\"Venus\", 2), (\"Earth\", 3), (\"Mars\", 4),\n            (\"Jupiter\", 5), (\"Saturn\", 6), (\"Uranus\", 7), (\"Neptune\", 8)\n        ]\n\n        for name, order in planets_raw_data:\n            self._planets_data.append(Planet(name, order))\n            self._planet_names_to_order[name] = order\n\n    def get_planets_between(self, planet1_name: str, planet2_name: str) -> list[str]:\n        \"\"\"Returns names of planets strictly between two given planets, sorted by proximity to the Sun.\"\"\"\n        if planet1_name not in self._planet_names_to_order or \\\n           planet2_name not in self._planet_names_to_order:\n            return []\n\n        order1 = self._planet_names_to_order[planet1_name]\n        order2 = self._planet_names_to_order[planet2_name]\n\n        start_order = min(order1, order2)\n        end_order = max(order1, order2)\n\n        intermediate_planets = []\n        for planet in self._planets_data:\n            if start_order < planet.order_from_sun < end_order:\n                intermediate_planets.append(planet.name)\n\n        return intermediate_planets\n\n# Instantiate SolarSystem once as a module-level variable to manage planet data.\n_solar_system_instance = SolarSystem()\n\ndef bf(planet1, planet2):\n    \"\"\"\n    Finds planets whose orbits are strictly between planet1 and planet2, sorted by proximity to the Sun.\n    Returns an empty tuple if planet names are invalid or no planets are found between them.\n    \"\"\"\n    return tuple(_solar_system_instance.get_planets_between(planet1, planet2))\n```"}
{"task_id": "HumanEval/147", "solution": "```python\ndef get_max_triples(n: int) -> int:\n    \"\"\"\n    You are given a positive integer n. You have to create an integer array a of length n.\n        For each i (1 \u2264 i \u2264 n), the value of a[i] = i * i - i + 1.\n        Return the number of triples (a[i], a[j], a[k]) of a where i < j < k,\n    and a[i] + a[j] + a[k] is a multiple of 3.\n\n    Example :\n        Input: n = 5\n        Output: 1\n        Explanation:\n        a = [1, 3, 7, 13, 21]\n        The only valid triple is (1, 7, 13).\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input 'n' must be a positive integer.\")\n\n    # Generate array 'a' based on the formula a[i] = i * i - i + 1\n    # Note: array 'a' is 0-indexed in Python, while 'i' in the formula is 1-indexed.\n    # So, a[idx] corresponds to (idx + 1) in the formula.\n    a = [(i + 1) * (i + 1) - (i + 1) + 1 for i in range(n)]\n\n    valid_triples_count = 0\n    # Iterate through all possible unique triples (a[i], a[j], a[k]) such that i < j < k\n    for i_idx in range(n - 2):\n        for j_idx in range(i_idx + 1, n - 1):\n            for k_idx in range(j_idx + 1, n):\n                current_sum = a[i_idx] + a[j_idx] + a[k_idx]\n                if current_sum % 3 == 0:\n                    valid_triples_count += 1\n\n    return valid_triples_count\n```"}
{"task_id": "HumanEval/146", "solution": "```python\ndef _is_greater_than_10(num: int | float) -> bool:\n    \"\"\"Checks if the absolute value of a number is strictly greater than 10.\"\"\"\n    return abs(num) > 10\n\ndef _get_first_digit(num: int | float) -> int:\n    \"\"\"Extracts the first digit of the absolute value of a number.\n    Converts the integer part of the number to a string to get the first digit.\n    \"\"\"\n    abs_num_str = str(int(abs(num)))\n    return int(abs_num_str[0])\n\ndef _get_last_digit(num: int | float) -> int:\n    \"\"\"Extracts the last digit of the absolute value of a number.\n    Handles floats by taking the integer part.\n    \"\"\"\n    return int(abs(num)) % 10\n\ndef _is_odd(digit: int) -> bool:\n    \"\"\"Checks if a given digit is odd (1, 3, 5, 7, 9).\"\"\"\n    return digit in {1, 3, 5, 7, 9}\n\ndef specialFilter(nums: list[int | float]) -> int:\n    \"\"\"Counts numbers in the array strictly greater than 10.\n    Both the first and last digits (absolute value) must also be odd (1, 3, 5, 7, 9).\n    \"\"\"\n    special_numbers_count = 0\n    for num in nums:\n        if (\n            _is_greater_than_10(num) and\n            _is_odd(_get_first_digit(num)) and\n            _is_odd(_get_last_digit(num))\n        ):\n            special_numbers_count += 1\n    return special_numbers_count\n```"}
