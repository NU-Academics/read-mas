{"task_id": "HumanEval/89", "solution": "def _rotate_char(char):\n    \"\"\"Rotates a lowercase English letter by four positions, wrapping around the alphabet.\"\"\"\n    start_char_code = ord('a')\n    char_code = ord(char)\n    rotated_code = start_char_code + (char_code - start_char_code + 4) % 26\n    return chr(rotated_code)\n\ndef encrypt(s):\n    \"\"\"Encrypts a string by rotating lowercase English letters four places down the alphabet.\"\"\"\n    encrypted_chars = []\n    for char in s:\n        if 'a' <= char <= 'z':\n            encrypted_chars.append(_rotate_char(char))\n        else:\n            encrypted_chars.append(char)\n    return \"\".join(encrypted_chars)"}
{"task_id": "HumanEval/89", "solution": "```python\ndef encrypt(s):\n    \"\"\"Encrypts a string using a Caesar cipher with a shift of 4.\n    Alphabetic characters are shifted, non-alphabetic characters remain unchanged.\n    \"\"\"\n    encrypted_chars = []\n    SHIFT_AMOUNT = 4\n\n    for char in s:\n        if 'a' <= char <= 'z':\n            # Calculate shifted lowercase character\n            shifted_code = (ord(char) - ord('a') + SHIFT_AMOUNT) % 26 + ord('a')\n            encrypted_chars.append(chr(shifted_code))\n        elif 'A' <= char <= 'Z':\n            # Calculate shifted uppercase character\n            shifted_code = (ord(char) - ord('A') + SHIFT_AMOUNT) % 26 + ord('A')\n            encrypted_chars.append(chr(shifted_code))\n        else:\n            # Append non-alphabetic characters directly\n            encrypted_chars.append(char)\n\n    return \"\".join(encrypted_chars)\n```"}
{"task_id": "HumanEval/81", "solution": "```python\ndef _convert_single_gpa(gpa: float) -> str:\n    \"\"\"Converts a single GPA to its corresponding letter grade.\n    Applies a predefined grading scale using if-elif-else logic.\"\"\"\n    if gpa == 4.0:\n        return 'A+'\n    elif gpa > 3.7:\n        return 'A'\n    elif gpa > 3.3:\n        return 'A-'\n    elif gpa > 3.0:\n        return 'B+'\n    elif gpa > 2.7:\n        return 'B'\n    elif gpa > 2.3:\n        return 'B-'\n    elif gpa > 2.0:\n        return 'C+'\n    elif gpa > 1.7:\n        return 'C'\n    elif gpa > 1.3:\n        return 'C-'\n    elif gpa > 1.0:\n        return 'D+'\n    elif gpa > 0.7:\n        return 'D'\n    elif gpa > 0.0:\n        return 'D-'\n    elif gpa == 0.0:\n        return 'E'\n    # Per constraints, invalid GPA values (e.g., negative) are not expected,\n    # and no error handling is required.\n    return 'E'\n\n\ndef numerical_letter_grade(grades: list[float]) -> list[str]:\n    \"\"\"Converts a list of numerical GPAs into a list of corresponding letter grades.\n    It iterates through the input and uses a helper to convert each GPA.\"\"\"\n    letter_grades = []\n    for gpa in grades:\n        letter_grades.append(_convert_single_gpa(gpa))\n    return letter_grades\n```\n```"}
{"task_id": "HumanEval/90", "solution": "```python\ndef next_smallest(lst):\n    \"\"\"\n    You are given a list of integers.\n    Write a function next_smallest() that returns the 2nd smallest element of the list.\n    Return None if there is no such element.\n\n    next_smallest([1, 2, 3, 4, 5]) == 2\n    next_smallest([5, 1, 4, 3, 2]) == 2\n    next_smallest([]) == None\n    next_smallest([1, 1]) == None\n    \"\"\"\n    unique_elements = sorted(list(set(lst)))\n\n    if len(unique_elements) < 2:\n        return None\n    else:\n        return unique_elements[1]\n```"}
