{"task_id": "HumanEval/75", "solution": "```python\ndef is_prime(n: int) -> bool:\n    \"\"\"Checks if a number n is prime.\n    Uses an optimized trial division method.\"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n\ndef get_prime_factors(n: int) -> list[int]:\n    \"\"\"Returns a list of prime factors for a number n, including repetitions.\n    Employs trial division starting from 2.\"\"\"\n    factors = []\n    # Handle factor 2\n    while n % 2 == 0:\n        factors.append(2)\n        n //= 2\n    # Handle odd factors\n    i = 3\n    while i * i <= n:\n        while n % i == 0:\n            factors.append(i)\n            n //= i\n        i += 2\n    # If n is still greater than 2, it must be a prime factor itself\n    if n > 2:\n        factors.append(n)\n    return factors\n\ndef is_multiply_prime(a: int) -> bool:\n    \"\"\"Write a function that returns true if the given number is the multiplication of 3 prime numbers\n    and false otherwise.\n    Knowing that (a) is less then 100.\"\"\"\n    # Input Validation: 'a' must be within the valid range (2 to 99 inclusive).\n    if a <= 1 or a >= 100:\n        return False\n\n    prime_factors = get_prime_factors(a)\n    return len(prime_factors) == 3\n```"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    '''\n    Checks if an integer 'a' is a perfect cube.\n    Handles positive, negative, and zero inputs using cube root and rounding.\n    '''\n    if a == 0:\n        return True\n\n    # Calculate the cube root, ensuring proper handling for negative numbers.\n    # The result of (1/3) is a float, so rounding is crucial to get the closest integer.\n    if a < 0:\n        potential_root = -int(round(abs(a)**(1/3)))\n    else:\n        potential_root = int(round(a**(1/3)))\n\n    # Verify if cubing the potential integer root yields the original number 'a'.\n    return potential_root * potential_root * potential_root == a"}
{"task_id": "HumanEval/77", "solution": "```python\ndef iscube(a: int) -> bool:\n    \"\"\"\n    Checks if an integer 'a' is a perfect cube.\n    Handles positive, negative, and zero inputs using an integer-only binary search.\n    \"\"\"\n    if a == 0:\n        return True\n\n    abs_a = abs(a)\n\n    # Determine an upper bound for the cube root without using floats directly for arbitrary-precision integers.\n    # 'high' is doubled until x*x*x is greater than or equal to abs_a.\n    low = 0\n    high = 1\n    while high * high * high < abs_a:\n        high *= 2\n\n    # Perform binary search within the determined range [low, high]\n    candidate_root = 0\n    while low <= high:\n        mid = (low + high) // 2\n        cube = mid * mid * mid\n\n        if cube == abs_a:\n            candidate_root = mid\n            break\n        elif cube < abs_a:\n            low = mid + 1\n        else:  # cube > abs_a\n            high = mid - 1\n\n    # Verify the found candidate root. If 'a' is a perfect cube, then candidate_root^3 must equal abs_a.\n    return candidate_root * candidate_root * candidate_root == abs_a\n```"}
{"task_id": "HumanEval/78", "solution": "```python\nclass HexadecimalDigit:\n    \"\"\"Encapsulates a single hexadecimal digit, storing its symbol and decimal value.\"\"\"\n    def __init__(self, symbol: str):\n        self.symbol = symbol\n        self.decimal_value = int(symbol, 16)\n\nclass PrimeHexDigitChecker:\n    \"\"\"Determines if a HexadecimalDigit's decimal equivalent is a predefined prime number.\"\"\"\n    _PRIME_DECIMAL_VALUES = {2, 3, 5, 7, 11, 13}\n\n    def __init__(self):\n        pass\n\n    def is_hex_digit_prime(self, digit: HexadecimalDigit) -> bool:\n        \"\"\"Checks if the decimal value of a given hexadecimal digit is prime.\"\"\"\n        return digit.decimal_value in self._PRIME_DECIMAL_VALUES\n\nclass PrimeHexDigitCounter:\n    \"\"\"Manages the overall logic for counting prime hexadecimal digits in a string.\"\"\"\n    def __init__(self, prime_checker: PrimeHexDigitChecker):\n        self.prime_checker = prime_checker\n\n    def count_primes(self, hex_num_str: str) -> int:\n        \"\"\"Iterates through a hexadecimal string, counting prime digits.\"\"\"\n        count = 0\n        for char in hex_num_str:\n            digit = HexadecimalDigit(char)\n            if self.prime_checker.is_hex_digit_prime(digit):\n                count += 1\n        return count\n\ndef hex_key(num: str) -> int:\n    \"\"\"\n    Counts the number of prime hexadecimal digits within a given hexadecimal number string.\n    The predefined prime hexadecimal digits are 2, 3, 5, 7, B (decimal 11), and D (decimal 13).\n    \"\"\"\n    prime_checker = PrimeHexDigitChecker()\n    counter = PrimeHexDigitCounter(prime_checker)\n    return counter.count_primes(num)\n```"}
{"task_id": "HumanEval/76", "solution": "```python\ndef is_simple_power(x, n):\n    \"\"\"Checks if x is a simple power of n, i.e., n**k = x for some integer k.\n    Handles various numerical inputs including floats and negative numbers.\"\"\"\n\n    # Floating point comparison tolerance\n    tolerance = 1e-9\n\n    # Handle x == 1 first (n**0 = 1 for any n, including 0 in Python)\n    if abs(x - 1) < tolerance:\n        return True\n\n    # Handle x == 0\n    if abs(x) < tolerance:\n        # Only 0**k = 0 for k > 0. True if n is also 0, False otherwise.\n        return abs(n) < tolerance\n\n    # Handle n == 1 (x is not 1, so 1**k can't be x)\n    if abs(n - 1) < tolerance:\n        return False\n\n    # Handle n == -1 (x is not 1, so must be -1 for simple power)\n    if abs(n + 1) < tolerance:\n        return abs(x + 1) < tolerance\n\n    # Handle n == 0 (x is not 0 or 1, so 0**k can't be x)\n    if abs(n) < tolerance:\n        return False\n\n    # At this point: x is not 0 or 1. n is not 0, 1, or -1.\n    max_iterations = 200 # A safety limit for loops to prevent infinite execution\n\n    # Case 1: n > 0 (and n != 1)\n    if n > 0:\n        if x < 0: # Positive base cannot produce a negative result (x not 0)\n            return False\n\n        # Try to find integer k for n**k = x\n        current_val = 1.0 # Represents n**0\n\n        # Iterate for positive k (k >= 0, multiplying by n)\n        for _ in range(max_iterations):\n            if abs(current_val - x) < tolerance:\n                return True\n            # Break if current_val overshoots (for n>1) or undershoots (for 0<n<1)\n            if (n > 1 and current_val > x + tolerance) or \\\n               (n < 1 and current_val < x - tolerance):\n                break\n            # Handle numerical instability (underflow to 0 or overflow to inf)\n            if abs(current_val) < tolerance and abs(x) > tolerance: break\n            if current_val == float('inf') and x != float('inf'): break\n\n            current_val *= n\n\n        current_val = 1.0 # Reset for negative k\n        # Iterate for negative k (k < 0, dividing by n)\n        for _ in range(max_iterations):\n            if abs(current_val - x) < tolerance:\n                return True\n            # Break if current_val undershoots (for n>1) or overshoots (for 0<n<1)\n            if (n > 1 and current_val < x - tolerance) or \\\n               (n < 1 and current_val > x + tolerance):\n                break\n            # Handle numerical instability\n            if abs(current_val) < tolerance and abs(x) > tolerance: break\n            if current_val == float('inf') and x != float('inf'): break\n\n            current_val /= n\n\n        return False\n\n    # Case 2: n < 0 (and n != -1)\n    # n is negative. x can be positive or negative.\n    # We need n**k = x. This implies abs(n)**k = abs(x).\n    # If k is even, n**k is positive. If k is odd, n**k is negative.\n\n    abs_n = abs(n)\n    current_k_val = 0 # To store the found exponent for abs(n)**k = abs(x)\n    found_abs_power = False\n\n    # Check for k >= 0 (on absolute values)\n    current_val_abs = 1.0\n    for k_abs in range(max_iterations):\n        if abs(current_val_abs - abs(x)) < tolerance:\n            found_abs_power = True\n            current_k_val = k_abs\n            break\n        if current_val_abs > abs(x) + tolerance: # Overshot target\n            break\n        if abs(current_val_abs) < tolerance and abs(x) > tolerance: break\n        if current_val_abs == float('inf') and abs(x) != float('inf'): break\n\n        current_val_abs *= abs_n\n\n    if not found_abs_power:\n        # Check for k < 0 (on absolute values)\n        current_val_abs = 1.0\n        for k_abs_neg in range(1, max_iterations + 1): # k_abs_neg starts from 1 for negative exponents\n            if abs(current_val_abs - abs(x)) < tolerance:\n                found_abs_power = True\n                current_k_val = -k_abs_neg\n                break\n            if current_val_abs < abs(x) - tolerance: # Undershot target\n                break\n            if abs(current_val_abs) < tolerance and abs(x) > tolerance: break\n            if current_val_abs == float('inf') and abs(x) != float('inf'): break\n\n            current_val_abs /= abs_n\n\n    if found_abs_power:\n        # Check the sign based on the exponent k_val\n        if x > 0: # Target x is positive, so k must be even\n            return current_k_val % 2 == 0\n        else: # Target x is negative, so k must be odd\n            return current_k_val % 2 != 0\n\n    return False\n```"}
{"task_id": "HumanEval/76", "solution": "```python\ndef is_simple_power(x: float, n: float) -> bool:\n    \"\"\"Checks if x can be expressed as n raised to a non-negative integer power.\n    This means checking if x = n^k for some integer k >= 0.\n    \"\"\"\n    EPSILON = 1e-9  # Tolerance for floating-point comparisons.\n\n    # Handle x = 1.0 (corresponds to k = 0, as n^0 = 1 for most n).\n    if abs(x - 1.0) < EPSILON:\n        return True\n\n    # Handle n = 1.0 (and x != 1.0).\n    # If n is 1, then 1^k = 1. Since x is not 1.0, it cannot be a power of n.\n    if abs(n - 1.0) < EPSILON:\n        return False\n\n    # Handle n = 0.0 (and x != 1.0).\n    # If n is 0, then 0^k = 0 for k > 0. Only x = 0.0 can be a power of n here.\n    if abs(n - 0.0) < EPSILON:\n        return abs(x - 0.0) < EPSILON\n\n    # Iterate powers of n for k >= 1.\n    current_power = n\n    while abs(current_power) < abs(x) + EPSILON:\n        if abs(current_power - x) < EPSILON:\n            return True\n\n        # Compute the next power: n^(k+1) = n^k * n.\n        current_power *= n\n\n        # Exit if power calculation results in overflow or underflow.\n        if abs(current_power) == float('inf') or (abs(current_power) < EPSILON and abs(x) > EPSILON):\n            return False\n\n    return False\n```"}
