0:\n                return False\n            i += 2\n        return True\ndef intersection(interval1, interval2):\n    \"\"\"You are given two intervals,\n    where each interval is a pair of integers. For example, interval = (start, end) = (1, 2).\n    The given intervals are closed which means that the interval (start, end)\n    includes both start and end.\n    For each given interval, it is assumed that its start is less or equal its end.\n    Your task is to determine whether the length of intersection of these two\n    intervals is a prime number.\n    Example, the intersection of the intervals (1, 3), (2, 4) is (2, 3)\n    which its length is 1, which not a prime number.\n    If the length of the intersection is a prime number, return \"YES\",\n    otherwise, return \"NO\".\n    If the two intervals don't intersect, return \"NO\".\n\n\n    [input/output] samples:\n    intersection((1, 2), (2, 3)) ==> \"NO\"\n    intersection((-1, 1), (0, 4)) ==> \"NO\"\n    intersection((-3, -1), (-5, 5)) ==> \"YES\"\n    \"\"\"\n    service = IntervalService()\n\n    i_obj1 = Interval(interval1[0], interval1[1])\n    i_obj2 = Interval(interval2[0], interval2[1])\n\n    intersection_interval = service.calculate_intersection(i_obj1, i_obj2)\n\n    length = intersection_interval.get_length()\n\n    if service.is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\"", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/129": [{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Finds the lexicographically smallest path of length k in the grid.\n    Uses a priority queue to explore paths, ensuring lexicographical order.\n    \"\"\"\n    import heapq\n\n    class Cell:\n        def __init__(self, row: int, col: int, value: int) -> None:\n            self._row = row\n            self._col = col\n            self._value = value\n\n        def get_row(self) -> int:\n            return self._row\n\n        def get_col(self) -> int:\n            return self._col\n\n        def get_value(self) -> int:\n            return self._value\n\n    class Grid:\n        def __init__(self, data: list[list[int]]) -> None:\n            self._data = data\n            self._N = len(data)\n\n        def get_N(self) -> int:\n            return self._N\n\n        def get_value(self, row: int, col: int) -> int:\n            if not self.is_valid_coordinate(row, col):\n                raise IndexError(f\"Coordinates ({row}, {col}) are out of bounds for grid of size {self._N}.\")\n            return self._data[row][col]\n\n        def get_cell(self, row: int, col: int) -> Cell:\n            if not self.is_valid_coordinate(row, col):\n                raise IndexError(f\"Coordinates ({row}, {col}) are out of bounds for grid of size {self._N}.\")\n            return Cell(row, col, self._data[row][col])\n\n        def get_neighbors(self, row: int, col: int) -> list[tuple[int, int]]:\n            neighbors = []\n            directions = [(-1, 0), (1, 0), (0, -1), (0, 1)] # Up, Down, Left, Right\n            for dr, dc in directions:\n                nr, nc = row + dr, col + dc\n                if self.is_valid_coordinate(nr, nc):\n                    neighbors.append((nr, nc))\n            return neighbors\n\n        def is_valid_coordinate(self, row: int, col: int) -> bool:\n            return 0 <= row < self._N and 0 <= col < self._N\n\n    def validate_grid(grid_data: list[list[int]]) -> None:\n        if not isinstance(grid_data, list) or not grid_data:\n            raise ValueError(\"Grid must be a non-empty list of lists.\")\n\n        N = len(grid_data)\n        if N < 2:\n            raise ValueError(\"Grid dimension N must be at least 2.\")\n\n        seen_values = set()\n        for r_idx, row in enumerate(grid_data):\n            if not isinstance(row, list) or len(row) != N:\n                raise ValueError(\"Grid must be a square matrix.\")\n            for c_idx, val in enumerate(row):\n                if not isinstance(val, int):\n                    raise ValueError(f\"Grid cell value at ({r_idx}, {c_idx}) is not an integer.\")\n                if not (1 <= val <= N * N):\n                    raise ValueError(f\"Grid cell value {val} at ({r_idx}, {c_idx}) is out of range [1, N*N].\")\n                if val in seen_values:\n                    raise ValueError(f\"Grid contains duplicate value {val}.\")\n                seen_values.add(val)\n\n        if len(seen_values) != N * N:\n             raise ValueError(\"Grid does not contain all unique values from 1 to N*N.\")\n\n    def validate_k(path_length_k: int) -> None:\n        if not isinstance(path_length_k, int) or path_length_k <= 0:\n            raise ValueError(\"Path length k must be a positive integer.\")\n\n    class PathFinderService:\n        def find_min_path(self, grid_obj: 'Grid', path_length_k: int) -> list[int]:\n            N = grid_obj.get_N()\n            priority_queue = [] # Stores (path_tuple, current_row, current_col)\n\n            # Initialize with paths of length 1 from every cell\n            for r in range(N):\n                for c in range(N):\n                    initial_path = (grid_obj.get_value(r, c),)\n                    heapq.heappush(priority_queue, (initial_path, r, c))\n\n            while priority_queue:\n                current_path_tuple, r, c = heapq.heappop(priority_queue)\n\n                if len(current_path_tuple) == path_length_k:\n                    return list(current_path_tuple)\n\n                # Only extend if path length is less than k\n                if len(current_path_tuple) < path_length_k:\n                    for nr, nc in grid_obj.get_neighbors(r, c):\n                        new_path_tuple = current_path_tuple + (grid_obj.get_value(nr, nc),)\n                        heapq.heappush(priority_queue, (new_path_tuple, nr, nc))\n\n            # This part should ideally not be reached given the problem guarantees\n            return []\n\n    validate_grid(grid)\n    validate_k(k)\n\n    grid_obj = Grid(grid)\n    path_finder = PathFinderService()\n\n    return path_finder.find_min_path(grid_obj, k)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/133": [{"task_id": "HumanEval/133", "solution": "import math\ndef sum_squares(lst):\n    \"\"\"Calculates the sum of squared numbers after rounding each element up to the nearest integer.\"\"\"\n\n    # Round each number up to its ceiling, square it, and then sum the results.\n    return sum(math.ceil(x) ** 2 for x in lst)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/132": [{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    '''\n    Create a function that takes a string as input which contains only square brackets.\n    The function should return True if and only if there is a valid subsequence of brackets\n    where at least one bracket in the subsequence is nested.\n    '''\n    n = len(string)\n    if n < 4:\n        return False\n\n    first_open_idx = -1\n    second_open_idx = -1\n\n    for i in range(n):\n        if string[i] == '[':\n            if first_open_idx == -1:\n                first_open_idx = i\n            else:\n                second_open_idx = i\n                # Found two opening brackets. Now search for two closing brackets after the second open.\n                for k in range(second_open_idx + 1, n):\n                    if string[k] == ']':\n                        # Found the first closing bracket. Now search for the second closing bracket.\n                        for l in range(k + 1, n):\n                            if string[l] == ']':\n                                # Found the required subsequence: s[first_open_idx] < s[second_open_idx] < s[k] < s[l]\n                                return True\n    return False", "base_status": "pass", "plus_status": "fa