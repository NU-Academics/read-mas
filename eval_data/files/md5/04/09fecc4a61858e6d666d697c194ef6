{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Given an array of non-negative integers, return [smallest_even_value, index]\n    for the smallest even value in the array. If multiple have the same value,\n    return the one with the smallest index. If no even values or empty array, return [].\n    \"\"\"\n    smallest_even_value = None\n    smallest_even_index = -1\n\n    for i, num in enumerate(arr):\n        if num % 2 == 0:\n            if smallest_even_value is None or num < smallest_even_value:\n                smallest_even_value = num\n                smallest_even_index = i\n\n    if smallest_even_value is None:\n        return []\n    return [smallest_even_value, smallest_even_index]"}
{"task_id": "HumanEval/67", "solution": "def fruit_distribution(s,n):\n    \"\"\"\n    Given a string s describing counts of apples and oranges (e.g. \"5 apples and 6 oranges\")\n    and an integer n for total fruits, return the number of mangoes: n - apples - oranges.\n    \"\"\"\n    import re\n\n    if not isinstance(s, str):\n        raise TypeError(\"s must be a string\")\n    # Prefer explicit labeled matches\n    apples_m = re.search(r'(\\d+)\\s*apples?', s, flags=re.IGNORECASE)\n    oranges_m = re.search(r'(\\d+)\\s*oranges?', s, flags=re.IGNORECASE)\n\n    if apples_m and oranges_m:\n        apples = int(apples_m.group(1))\n        oranges = int(oranges_m.group(1))\n    else:\n        # Fallback: extract first two integers in the string\n        nums = re.findall(r'(-?\\d+)', s)\n        if len(nums) >= 2:\n            apples = int(nums[0])\n            oranges = int(nums[1])\n        else:\n            raise ValueError(\"Could not parse apples and oranges counts from input string\")\n\n    if not isinstance(n, int):\n        if isinstance(n, float) and n.is_integer():\n            n = int(n)\n        else:\n            raise TypeError(\"n must be an integer\")\n\n    return n - apples - oranges"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even-valued node and its index in the array.\n    Returns [] if no even values or if the array is empty.\n    \"\"\"\n    best_val = None\n    best_idx = -1\n\n    for idx, value in enumerate(arr):\n        if value % 2 == 0:  # Check if the value is even\n            if best_val is None or value < best_val:\n                best_val = value\n                best_idx = idx\n\n    if best_val is None:\n        return []\n    else:\n        return [best_val, best_idx]"}
{"task_id": "HumanEval/67", "solution": "import re\ndef fruit_distribution(s,n):\n    \"\"\"\n    In this task, you will be given a string that represents a number of apples and oranges\n    and an integer that represent the total number of the fruits. Return the number of\n    mango fruits in the basket.\n    \"\"\"\n    # Validate inputs\n    if not isinstance(s, str):\n        raise TypeError(\"s must be a string\")\n    try:\n        n = int(n)\n    except Exception:\n        raise TypeError(\"n must be an integer or convertible to int\")\n\n    # Extract integers from the string; use first two as apples and oranges\n    int_counts = re.findall(r\"-?\\d+\", s)\n    if len(int_counts) < 2:\n        raise ValueError(\"Input string must contain at least two integers for apples and oranges\")\n\n    apples = int(int_counts[0])\n    oranges = int(int_counts[1])\n\n    if apples < 0 or oranges < 0:\n        raise ValueError(\"Apple and orange counts must be non-negative\")\n\n    return n - apples - oranges"}
{"task_id": "HumanEval/69", "solution": "def search(lst):\n    \"\"\"\n    Finds the greatest integer whose frequency is greater than or equal to its value.\n    Returns -1 if no such integer exists.\n    \"\"\"\n    frequencies = {}\n    for num in lst:\n        frequencies[num] = frequencies.get(num, 0) + 1\n\n    max_valid_num = -1\n    for num, count in frequencies.items():\n        if count >= num:\n            if num > max_valid_num:\n                max_valid_num = num\n\n    return max_valid_num"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n\n    Examples:\n    strange_sort_list([1, 2, 3, 4]) == [1, 4, 2, 3]\n    strange_sort_list([5, 5, 5, 5]) == [5, 5, 5, 5]\n    strange_sort_list([]) == []\n    '''\n    if not lst:\n        return []\n\n    try:\n        sorted_lst = sorted(lst)\n    except TypeError:\n        raise TypeError(\"lst must be an iterable of comparable elements\")\n\n    result = []\n    left, right = 0, len(sorted_lst) - 1\n\n    while left <= right:\n        result.append(sorted_lst[left])\n        left += 1\n        if left <= right:\n            result.append(sorted_lst[right])\n            right -= 1\n\n    return result"}
{"task_id": "HumanEval/69", "solution": "def search(lst):\n    \"\"\"\n    Return the greatest positive integer whose frequency in lst is >= its value.\n    If no such integer exists, return -1.\n    \"\"\"\n    from collections import Counter\n\n    counts = Counter(lst)\n    candidates = [num for num, freq in counts.items() if num > 0 and freq >= num]\n    return max(candidates) if candidates else -1"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Starts with min, then max of remaining, then min and so on.\n    '''\n    sorted_lst = sorted(lst)\n    result = []\n    left, right = 0, len(sorted_lst) - 1\n    is_min_turn = True\n\n    while left <= right:\n        if is_min_turn:\n            result.append(sorted_lst[left])\n            left += 1\n        else:\n            result.append(sorted_lst[right])\n            right -= 1\n        is_min_turn = not is_min_turn\n\n    return result"}
{"task_id": "HumanEval/71", "solution": "import math\ndef triangle_area(a, b, c):\n    \"\"\"\n    Calculates the area of a triangle given its three side lengths.\n    Returns the area rounded to 2 decimal places if valid, otherwise -1.\n    \"\"\"\n    # Validate that all sides are positive.\n    if not (a > 0 and b > 0 and c > 0):\n        return -1\n\n    # Validate triangle inequality theorem.\n    if not (a + b > c and a + c > b and b + c > a):\n        return -1\n\n    # Calculate semi-perimeter.\n    s = (a + b + c) / 2\n\n    # Calculate the area using Heron's formula.\n    # Use max(0, ...) to handle potential floating point inaccuracies that might\n    # result in a slightly negative value for term_under_sqrt for degenerate triangles.\n    area = math.sqrt(max(0, s * (s - a) * (s - b) * (s - c)))\n\n    # Round the area to 2 decimal places.\n    return round(area, 2)"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q, w):\n    \"\"\"\n    Checks if an object q will fly based on being palindromic and its sum being within weight w.\n    Assumes q is a list of numbers and w is a number.\n    \"\"\"\n    # Validate types\n    if not isinstance(q, list):\n        raise TypeError(\"q must be a list of numeric values\")\n    if not isinstance(w, (int, float)):\n        raise TypeError(\"w must be a numeric value (int or float)\")\n\n    # Validate list elements\n    for i, item in enumerate(q):\n        if not isinstance(item, (int, float)):\n            raise TypeError(f\"All elements of q must be numeric (int or float). Invalid element at index {i}: {item!r}\")\n\n    # Check palindrome and weight\n    is_palindromic = (q == q[::-1])\n    total_weight = sum(q)\n\n    return is_palindromic and (total_weight <= w)"}
{"task_id": "HumanEval/71", "solution": "def triangle_area(a, b, c):\n    \"\"\"\n    Given the lengths of the three sides of a triangle, return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle.\n    Otherwise return -1.\n    \"\"\"\n    import math\n\n    # Validate that sides are numbers and positive\n    try:\n        a = float(a)\n        b = float(b)\n        c = float(c)\n    except (TypeError, ValueError):\n        return -1\n\n    if a <= 0 or b <= 0 or c <= 0:\n        return -1\n\n    # Triangle inequality: sum of any two sides must be greater than the third\n    if not (a + b > c and a + c > b and b + c > a):\n        return -1\n\n    # Heron's formula with numeric stability guard\n    s = (a + b + c) / 2.0\n    area_sq = s * (s - a) * (s - b) * (s - c)\n\n    # Guard against tiny negative values caused by floating-point errors\n    if area_sq < 0 and area_sq > -1e-12:\n        area_sq = 0.0\n    if area_sq < 0:\n        return -1  # Degenerate or invalid due to numerical issues\n\n    area = math.sqrt(area_sq)\n    return round(area, 2)"}
