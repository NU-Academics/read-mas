{"task_id": "HumanEval/99", "solution": "def closest_integer(value):\n    \"\"\"\n    Create a function that takes a value (string) representing a number\n    and returns the closest integer to it. If the number is equidistant\n    from two integers, round it away from zero.\n    \"\"\"\n    from decimal import Decimal, ROUND_FLOOR, ROUND_CEILING, InvalidOperation\n\n    s = value.strip() if isinstance(value, str) else str(value)\n    try:\n        d = Decimal(s)\n    except (InvalidOperation, ValueError):\n        raise ValueError(f\"Invalid numeric value: {value!r}\")\n\n    if d >= 0:\n        rounded = (d + Decimal(\"0.5\")).quantize(Decimal(\"1\"), rounding=ROUND_FLOOR)\n    else:\n        rounded = (d - Decimal(\"0.5\")).quantize(Decimal(\"1\"), rounding=ROUND_CEILING)\n\n    return int(rounded)"}
{"task_id": "HumanEval/101", "solution": "def words_string(s):\n    \"\"\"\n    Split a string into words separated by commas and/or whitespace.\n    Returns a list of words. Empty or whitespace-only input returns [].\n    \"\"\"\n    import re\n    if s is None:\n        return []\n    if not isinstance(s, str):\n        s = str(s)\n    s = s.strip()\n    if not s:\n        return []\n    parts = re.split(r'[,\\s]+', s)\n    return [p for p in parts if p]"}
{"task_id": "HumanEval/101", "solution": "def words_string(s):\n    \"\"\"\n    Splits a string of words separated by commas or spaces into a list of words.\n    Commas are replaced by spaces, then the string is split by any whitespace.\n    \"\"\"\n    s = s.replace(\",\", \" \")\n    return s.split()"}
{"task_id": "HumanEval/102", "solution": "def choose_num(x, y):\n    \"\"\"Return the largest even integer in the inclusive range [x, y].\n    If no such integer exists, return -1.\n    \"\"\"\n    import math\n\n    # If range is empty\n    if x > y:\n        return -1\n\n    # Largest integer <= y\n    upper = math.floor(y)\n    # Make it even\n    if upper % 2 != 0:\n        upper -= 1\n\n    # Smallest integer >= x\n    lower = math.ceil(x)\n\n    if upper < lower:\n        return -1\n\n    return int(upper)"}
{"task_id": "HumanEval/102", "solution": "import math\ndef choose_num(x, y):\n    \"\"\"\n    Returns the largest even integer within the inclusive range [x, y].\n    Returns -1 if none exists or the range is invalid.\n    \"\"\"\n    if not (isinstance(x, (int, float)) and isinstance(y, (int, float))):\n        raise TypeError(\"x and y must be numeric (int or float)\")\n\n    if x > y:\n        return -1\n\n    low = math.ceil(x)\n    high = math.floor(y)\n\n    if low > high:\n        return -1\n\n    if high % 2 == 0:\n        candidate = int(high)\n    else:\n        candidate = int(high - 1)\n\n    if candidate >= low:\n        return candidate\n    else:\n        return -1"}
{"task_id": "HumanEval/103", "solution": "def rounded_avg(n, m):\n    \"\"\"Computes the average of integers from n to m, rounds to nearest tie-to-even, and returns as binary string.\n    Returns -1 if n > m.\"\"\"\n    if n > m:\n        return -1\n\n    s = n + m\n    q, r = divmod(s, 2)\n\n    rounded_value = q\n    if r == 1:  # fractional part .5\n        # tie-to-even: if q is odd, round up; if q is even, stay\n        if q % 2 != 0:\n            rounded_value = q + 1\n\n    return bin(rounded_value)"}
{"task_id": "HumanEval/103", "solution": "def rounded_avg(n, m):\n    \"\"\"Computes the average of integers from n through m, rounds it to the nearest even,\n    and returns its binary representation. Returns -1 if n > m.\"\"\"\n    if n > m:\n        return -1\n\n    s = n + m\n    if s % 2 == 0:\n        avg_int = s // 2\n    else:\n        q = s // 2\n        # If q is even, round down (q); if q is odd, round up (q+1)\n        if q % 2 == 0:\n            avg_int = q\n        else:\n            avg_int = q + 1\n\n    return bin(avg_int)"}
{"task_id": "HumanEval/104", "solution": "def unique_digits(x):\n    \"\"\"Given a list of positive integers x. return a sorted list of all\n    elements that hasn't any even digit.\n\n    Note: Returned list should be sorted in increasing order.\n\n    For example:\n    >>> unique_digits([15, 33, 1422, 1])\n    [1, 15, 33]\n    >>> unique_digits([152, 323, 1422, 10])\n    []\n    \"\"\"\n    result = []\n    for number in x:\n        # Work with absolute value to be robust to negatives,\n        # and ensure integer behavior.\n        n = abs(int(number))\n        # 0 contains an even digit (0), so skip it.\n        if n == 0:\n            continue\n        has_even = False\n        while n > 0:\n            if (n % 10) % 2 == 0:\n                has_even = True\n                break\n            n //= 10\n        if not has_even:\n            result.append(int(number))\n    return sorted(result)"}
{"task_id": "HumanEval/104", "solution": "def unique_digits(x):\n    \"\"\"Given a list of positive integers x, return a sorted list of all elements that have no even digit.\n\n    Args:\n        x: iterable of integers (expected non-negative).\n\n    Returns:\n        A new list of integers from x whose decimal digits are all odd, sorted in increasing order.\n\n    Raises:\n        TypeError: if x is not iterable or contains non-integers.\n        ValueError: if any integer in x is negative.\n    \"\"\"\n    # Basic iterable check\n    try:\n        iterator = iter(x)\n    except TypeError:\n        raise TypeError(\"Input must be an iterable of integers\")\n\n    result = []\n    for n in iterator:\n        if not isinstance(n, int):\n            raise TypeError(\"All elements must be integers\")\n        if n < 0:\n            raise ValueError(\"All integers must be non-negative\")\n\n        # 0 contains an even digit -> exclude\n        if n == 0:\n            continue\n\n        tmp = n\n        all_odd = True\n        while tmp:\n            if (tmp % 10) % 2 == 0:\n                all_odd = False\n                break\n            tmp //= 10\n\n        if all_odd:\n            result.append(n)\n\n    result.sort()\n    return result"}
{"task_id": "HumanEval/105", "solution": "def by_length(arr):\n    \"\"\"\n    Given an array-like of values, keep only integers between 1 and 9 inclusive,\n    sort them ascending, reverse the result, and map each digit to its word name.\n\n    Mapping:\n      1 -> \"One\", 2 -> \"Two\", 3 -> \"Three\", 4 -> \"Four\", 5 -> \"Five\",\n      6 -> \"Six\", 7 -> \"Seven\", 8 -> \"Eight\", 9 -> \"Nine\"\n    \"\"\"\n    digit_to_word = {\n        1: \"One\", 2: \"Two\", 3: \"Three\", 4: \"Four\", 5: \"Five\",\n        6: \"Six\", 7: \"Seven\", 8: \"Eight\", 9: \"Nine\"\n    }\n\n    # Filter only integer values in the inclusive range [1, 9]\n    filtered = [x for x in arr if isinstance(x, int) and 1 <= x <= 9]\n\n    # Sort ascending then reverse (or sort with reverse=True)\n    filtered_sorted_desc = sorted(filtered, reverse=True)\n\n    # Map to words\n    return [digit_to_word[x] for x in filtered_sorted_desc]"}
{"task_id": "HumanEval/105", "solution": "def by_length(arr):\n    \"\"\"\n    Filter integers in the range 1..9 from arr, sort them in descending order,\n    and map each digit to its English name (\"One\"..\"Nine\").\n    Non-integers, booleans, and numbers outside 1..9 are ignored.\n    \"\"\"\n    if not arr:\n        return []\n    names = [\"One\", \"Two\", \"Three\", \"Four\", \"Five\", \"Six\", \"Seven\", \"Eight\", \"Nine\"]\n    filtered = [x for x in arr if type(x) is int and 1 <= x <= 9]\n    filtered.sort(reverse=True)\n    return [names[x - 1] for x in filtered]"}
{"task_id": "HumanEval/106", "solution": "def f(n):\n    \"\"\"Return a list of length n where element at 1-based index i is:\n    - factorial(i) if i is even\n    - sum of numbers from 1 to i if i is odd\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n <= 0:\n        return []\n\n    result = []\n    fact = 1\n    for i in range(1, n + 1):\n        fact *= i  # factorial of i\n        if i % 2 == 0:\n            result.append(fact)\n        else:\n            result.append((i * (i + 1)) // 2)\n    return result"}
{"task_id": "HumanEval/107", "solution": "def even_odd_palindrome(n):\n    \"\"\"\n    Counts even and odd integer palindromes within the range [1, n].\n    Returns a tuple with the counts of even and odd palindromes respectively.\n    \"\"\"\n    even_palindromes = 0\n    odd_palindromes = 0\n\n    for i in range(1, n + 1):\n        s = str(i)\n        if s == s[::-1]:\n            if i % 2 == 0:\n                even_palindromes += 1\n            else:\n                odd_palindromes += 1\n\n    return (even_palindromes, odd_palindromes)"}
{"task_id": "HumanEval/108", "solution": "def count_nums(arr):\n    \"\"\"\n    Write a function count_nums which takes an array of integers and returns\n    the number of elements which has a sum of digits > 0.\n    If a number is negative, then its first signed digit will be negative:\n    e.g. -123 has signed digits -1, 2, and 3.\n    \"\"\"\n    count = 0\n    for num in arr:\n        if num == 0:\n            s = 0\n        elif num > 0:\n            s = 0\n            temp = num\n            while temp:\n                s += temp % 10\n                temp //= 10\n        else:  # num < 0\n            abs_num = abs(num)\n            s_abs = 0\n            temp = abs_num\n            while temp:\n                s_abs += temp % 10\n                temp //= 10\n            # compute first (most significant) digit\n            first = abs_num\n            while first >= 10:\n                first //= 10\n            s = s_abs - 2 * first\n        if s > 0:\n            count += 1\n    return count"}
{"task_id": "HumanEval/107", "solution": "def even_odd_palindrome(n):\n    \"\"\"\n    Counts even and odd integer palindromes in the range [1, n].\n    Handles n < 1 by returning (0, 0).\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n\n    for i in range(1, n + 1):\n        s = str(i)\n        if s == s[::-1]:\n            if i % 2 == 0:\n                even_count += 1\n            else:\n                odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/106", "solution": "def f(n):\n    \"\"\"Implement the function f that takes n and returns a list of length n.\n    For 1-based index i, if i is even, value is factorial(i); if i is odd, value is sum from 1 to i.\"\"\"\n    if n <= 0:\n        return []\n\n    result = []\n    fact = 1  # Initializes fact to 1 for factorial(0) or as base for factorial(1)\n\n    for i in range(1, n + 1):\n        fact *= i  # fact now holds factorial(i)\n        if i % 2 == 0:  # If i is even\n            result.append(fact)\n        else:  # If i is odd\n            sum_i = i * (i + 1) // 2\n            result.append(sum_i)\n\n    return result"}
{"task_id": "HumanEval/108", "solution": "def count_nums(arr):\n    \"\"\"\n    Counts elements where the sum of signed digits is greater than 0.\n    Negative numbers treat the most significant digit as negative.\n    \"\"\"\n    count = 0\n    for n in arr:\n        ssum = 0\n        if n == 0:\n            ssum = 0\n        else:\n            digits_str = str(abs(n))\n            if n < 0:\n                ssum = -int(digits_str[0]) + sum(int(d) for d in digits_str[1:])\n            else:  # n > 0\n                ssum = sum(int(d) for d in digits_str)\n\n        if ssum > 0:\n            count += 1\n    return count"}
{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr):\n    \"\"\"Checks if an array can be sorted by right circular shifts.\n    It counts \"drops\" where arr[i] > arr[i+1] (wrapping around) and returns True if there's at most one drop.\n    \"\"\"\n    if not arr:\n        return True\n\n    n = len(arr)\n    drops = 0\n    for i in range(n):\n        if arr[i] > arr[(i + 1) % n]:\n            drops += 1\n            if drops > 1:\n                return False\n    return True"}
{"task_id": "HumanEval/109", "solution": "def move_one_ball(arr):\n    \"\"\"Determines if a list can be sorted non-decreasingly by right rotations.\n    Handles empty/single-element lists as already sorted.\"\"\"\n    n = len(arr)\n\n    if n <= 1:\n        return True\n\n    breaks_count = 0\n    for i in range(n - 1):\n        if arr[i] > arr[i+1]:\n            breaks_count += 1\n            if breaks_count > 1:\n                return False  # More than one decrease, cannot be a single rotation of sorted.\n\n    if breaks_count == 0:\n        return True  # Already sorted.\n    else:  # breaks_count == 1\n        # For a single break, the tail must be less than or equal to the head for it to be a rotation.\n        return arr[-1] <= arr[0]"}
{"task_id": "HumanEval/110", "solution": "def exchange(lst1, lst2):\n    \"\"\"Determines if lst1 can become all even by exchanging elements with lst2.\n    Counts odd numbers in lst1 and even numbers in lst2 to check if enough replacements are available.\"\"\"\n\n    odd_in_lst1 = sum(1 for x in lst1 if x % 2 != 0)\n    even_in_lst2 = sum(1 for x in lst2 if x % 2 == 0)\n\n    if odd_in_lst1 <= even_in_lst2:\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/111", "solution": "def histogram(test):\n    \"\"\"Given a string of space-separated lowercase letters, return a dictionary of letters with the most repetitions and their counts.\n    If multiple letters have the same maximum occurrence, include all of them.\n    \"\"\"\n    counts = {}\n    for letter in test.split():\n        counts[letter] = counts.get(letter, 0) + 1\n\n    if not counts:\n        return {}\n\n    max_count = 0\n    for count in counts.values():\n        if count > max_count:\n            max_count = count\n\n    result = {}\n    for letter, count in counts.items():\n        if count == max_count:\n            result[letter] = count\n\n    return result"}
{"task_id": "HumanEval/111", "solution": "from collections import Counter\ndef histogram(test):\n    \"\"\"Returns a dictionary of letters with the highest occurrence and their counts.\n    Includes all letters that tie for the maximum count.\n    \"\"\"\n    tokens = test.split()\n\n    if not tokens:\n        return {}\n\n    counts = Counter(tokens)\n\n    if not counts:\n        return {}\n\n    max_count = max(counts.values())\n\n    result = {}\n    for token, count in counts.items():\n        if count == max_count:\n            result[token] = count\n\n    return result"}
{"task_id": "HumanEval/112", "solution": "def reverse_delete(s, c):\n    \"\"\"\n    Deletes characters from s that appear in c, then checks if the resulting string is a palindrome.\n    Returns a tuple of the result string and a boolean indicating if it's a palindrome.\n    \"\"\"\n    if not isinstance(s, str) or not isinstance(c, str):\n        raise TypeError(\"Both s and c must be strings\")\n\n    chars_to_remove = set(c)\n    kept_chars = [char for char in s if char not in chars_to_remove]\n    result_string = \"\".join(kept_chars)\n\n    is_palindrome = (result_string == result_string[::-1])\n\n    return (result_string, is_palindrome)"}
{"task_id": "HumanEval/112", "solution": "def reverse_delete(s,c):\n    \"\"\"Deletes characters from s present in c and checks if the resulting string is a palindrome.\"\"\"\n    chars_to_delete = set(c)\n    result_string_chars = []\n    for char_s in s:\n        if char_s not in chars_to_delete:\n            result_string_chars.append(char_s)\n\n    final_string = \"\".join(result_string_chars)\n    is_palindrome = final_string == final_string[::-1]\n\n    return (final_string, is_palindrome)"}
{"task_id": "HumanEval/113", "solution": "def odd_count(lst):\n    \"\"\"Counts odd digits in each string and formats output according to a template.\n    Replaces all 'i' characters in the template with the count of odd digits.\n    \"\"\"\n    result = []\n    for s in lst:\n        odd_digit_count = 0\n        for char_digit in s:\n            if int(char_digit) % 2 != 0:\n                odd_digit_count += 1\n\n        # Original template with 'i' to be replaced\n        formatted_string = \"the number of odd elements in the string i of the input.\"\n        # Replace all lowercase 'i' with the decimal representation of the count\n        formatted_string = formatted_string.replace('i', str(odd_digit_count))\n        result.append(formatted_string)\n    return result"}
{"task_id": "HumanEval/113", "solution": "def odd_count(lst):\n    \"\"\"Given a list of strings of digits, return a list where each element is the\n    template sentence with every lowercase 'i' replaced by the count of odd digits\n    in the corresponding input string.\n    \"\"\"\n    template = \"the number of odd elements in the string i of the input.\"\n    result = []\n    odd_chars = set(\"13579\")\n    for s in lst:\n        count = sum(1 for ch in s if ch in odd_chars)\n        result.append(template.replace('i', str(count)))\n    return result"}
{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums):\n    \"\"\"\n    Given an array of integers nums, find the minimum sum of any non-empty sub-array\n    of nums.\n    \"\"\"\n    current_min = nums[0]\n    global_min = nums[0]\n\n    for i in range(1, len(nums)):\n        num = nums[i]\n        current_min = min(num, current_min + num)\n        global_min = min(global_min, current_min)\n\n    return global_min"}
{"task_id": "HumanEval/114", "solution": "def minSubArraySum(nums: list[int]) -> int:\n    \"\"\"\n    Finds the minimum sum of any non-empty contiguous subarray.\n    Raises ValueError if nums is empty, as a non-empty subarray is required.\n    \"\"\"\n    if not nums:\n        raise ValueError(\"nums must be non-empty\")\n\n    current_min = nums[0]\n    global_min = nums[0]\n\n    for x in nums[1:]:\n        # Decide whether to start a new subarray at x or extend the current one.\n        current_min = min(x, current_min + x)\n        # Update the overall minimum subarray sum found so far.\n        global_min = min(global_min, current_min)\n\n    return global_min"}
{"task_id": "HumanEval/115", "solution": "def max_fill(grid, capacity):\n    \"\"\"Computes the total number of times buckets must be lowered to empty all wells.\n    Each row in grid is a well; each 1 is one unit of water. All buckets have identical capacity.\n    \"\"\"\n    total_lowers = 0\n\n    if not grid:\n        return 0\n\n    for row in grid:\n        units = sum(row)\n        lowers = (units + capacity - 1) // capacity\n        total_lowers += lowers\n\n    return total_lowers"}
{"task_id": "HumanEval/115", "solution": "def max_fill(grid, capacity):\n    \"\"\"\n    Compute the number of times buckets must be lowered to empty all wells.\n\n    Args:\n        grid: iterable of iterables representing wells (rows). Each element must be 0 or 1.\n        capacity: positive integer bucket capacity.\n\n    Returns:\n        int: total number of bucket-lowering operations required.\n\n    Raises:\n        ValueError: if capacity is not a positive integer or grid elements are invalid.\n    \"\"\"\n    if not isinstance(capacity, int) or capacity < 1:\n        raise ValueError(\"capacity must be an integer >= 1\")\n\n    total_operations = 0\n    for row in grid:\n        try:\n            iter(row)\n        except TypeError:\n            raise ValueError(\"grid must be a 2D iterable (iterable of iterables)\")\n\n        ones = 0\n        for v in row:\n            if v not in (0, 1):\n                raise ValueError(\"grid elements must be 0 or 1\")\n            ones += v\n\n        # ceil division: (ones + capacity - 1) // capacity handles ones == 0 correctly\n        total_operations += (ones + capacity - 1) // capacity\n\n    return total_operations"}
{"task_id": "HumanEval/116", "solution": "def sort_array(arr):\n    \"\"\"Sorts an array of integers by the number of set bits in their absolute value, then by numeric value.\"\"\"\n    def _get_bit_count(n):\n        \"\"\"Counts 1 bits in the absolute value of n, with fallback for older Python versions.\"\"\"\n        abs_n = abs(n)\n        try:\n            return abs_n.bit_count()\n        except AttributeError:\n            return bin(abs_n).count('1')\n\n    return sorted(arr, key=lambda x: (_get_bit_count(x), x))"}
{"task_id": "HumanEval/117", "solution": "def select_words(s, n):\n    \"\"\"Selects words from a string that contain exactly n consonants.\n    Words are processed in their original order and case is ignored for consonant counting.\"\"\"\n    if not s:\n        return []\n\n    consonants = \"bcdfghjklmnpqrstvwxyz\"\n    selected_words = []\n\n    words = s.split()\n\n    for word in words:\n        consonant_count = 0\n        for char in word:\n            if char.lower() in consonants:\n                consonant_count += 1\n\n        if consonant_count == n:\n            selected_words.append(word)\n\n    return selected_words"}
