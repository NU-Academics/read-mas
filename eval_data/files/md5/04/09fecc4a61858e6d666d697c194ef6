{"task_id": "HumanEval/100", "solution": "def make_a_pile(n):\n    \"\"\"\n    Given a positive integer n, return a list of length n where the first element\n    is n and each subsequent element is the next number with the same parity\n    (i.e., increments by 2).\n\n    Example:\n    >>> make_a_pile(3)\n    [3, 5, 7]\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n    return [n + 2 * i for i in range(n)]"}
{"task_id": "HumanEval/98", "solution": "def count_upper(s):\n    \"\"\"\n    Counts uppercase vowel characters (A, E, I, O, U) at even indices in the string s.\n    Returns the total count.\n    \"\"\"\n    if not s:\n        return 0\n\n    UPPER_VOWELS = {'A', 'E', 'I', 'O', 'U'}\n    count = 0\n\n    for i, ch in enumerate(s):\n        if i % 2 == 0:\n            if ch in UPPER_VOWELS:\n                count += 1\n\n    return count"}
{"task_id": "HumanEval/98", "solution": "def count_upper(s):\n    \"\"\"\n    Counts uppercase vowels at even indices in a string.\n    Iterates through the string, checking index parity and character against uppercase vowels.\n    \"\"\"\n    count = 0\n    UPPERCASE_VOWELS = {'A', 'E', 'I', 'O', 'U'}\n    for i in range(len(s)):\n        if i % 2 == 0 and s[i] in UPPERCASE_VOWELS:\n            count += 1\n    return count"}
{"task_id": "HumanEval/99", "solution": "def closest_integer(value):\n    \"\"\"\n    Take a string representing a number and return the closest integer.\n    If the number is exactly halfway between two integers, round away from zero.\n\n    Raises:\n        ValueError: if the input is not a valid finite numeric string.\n    \"\"\"\n    from decimal import Decimal, InvalidOperation\n\n    # Accept non-str by converting to str (be permissive), but preserve expected behavior.\n    try:\n        s = value.strip() if isinstance(value, str) else str(value).strip()\n    except Exception:\n        raise ValueError(\"Invalid numeric input\")\n\n    try:\n        d = Decimal(s)\n    except (InvalidOperation, ValueError):\n        raise ValueError(\"Invalid numeric input\")\n\n    if not d.is_finite():\n        raise ValueError(\"Invalid numeric input\")\n\n    # If already an integer, return directly\n    if d == d.to_integral_value():\n        return int(d)\n\n    sign = 1 if d > 0 else -1\n    abs_d = d.copy_abs()\n\n    # lower is floor(abs_d) because abs_d is non-negative\n    lower = int(abs_d)\n    frac = abs_d - Decimal(lower)\n\n    # If fractional part < 0.5, round down (toward zero for negatives).\n    # If fractional part >= 0.5 (including exact 0.5), round up (away from zero).\n    if frac < Decimal('0.5'):\n        result_abs = lower\n    else:\n        result_abs = lower + 1\n\n    return int(result_abs * sign)"}
