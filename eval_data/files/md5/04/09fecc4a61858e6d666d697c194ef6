{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Given a non-empty array of integers arr and an integer k, return\n    the sum of the elements with at most two digits from the first k elements of arr.\n    \"\"\"\n    if not isinstance(arr, list):\n        raise TypeError(\"arr must be a list of integers\")\n    if not isinstance(k, int):\n        raise TypeError(\"k must be an integer\")\n\n    n = len(arr)\n    if n == 0:\n        raise ValueError(\"arr must be non-empty\")\n    if not (1 <= k <= n):\n        raise ValueError(\"k must satisfy 1 <= k <= len(arr)\")\n\n    total = 0\n    for x in arr[:k]:\n        if not isinstance(x, int):\n            raise TypeError(\"all elements in arr must be integers\")\n        if -99 <= x <= 99:\n            total += x\n    return total"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.\n    The list is sorted in increasing order.\n    \"\"\"\n    if not isinstance(n, int) or n < 1:\n        raise ValueError(\"n must be a positive integer\")\n\n    odd_numbers = set()\n    current = n\n    while True:\n        if current % 2 != 0:\n            odd_numbers.add(current)\n        if current == 1:\n            break\n        if current % 2 == 0:\n            current //= 2\n        else:\n            current = 3 * current + 1\n\n    return sorted(odd_numbers)"}
{"task_id": "HumanEval/122", "solution": "def add_elements(arr, k):\n    \"\"\"\n    Computes the sum of elements among the first k elements of arr that have at most two digits.\n    \"\"\"\n    total = 0\n    for i in range(k):\n        n = arr[i]\n        if abs(n) <= 99:\n            total += n\n    return total"}
{"task_id": "HumanEval/124", "solution": "def valid_date(date):\n    \"\"\"Validates a date string against specific rules.\n    Returns True if the date is valid, otherwise False.\"\"\"\n\n    # Rule 1: The date string is not empty.\n    if not date:\n        return False\n\n    # Rule 4: The date should be in the format: mm-dd-yyyy\n    if len(date) != 10:\n        return False\n    if date[2] != '-' or date[5] != '-':\n        return False\n\n    month_str = date[0:2]\n    day_str = date[3:5]\n    year_str = date[6:10]\n\n    # Check if all parts are digits\n    if not (month_str.isdigit() and day_str.isdigit() and year_str.isdigit()):\n        return False\n\n    month = int(month_str)\n    day = int(day_str)\n\n    # Rule 3: The months should not be less than 1 or higher than 12.\n    if not (1 <= month <= 12):\n        return False\n\n    # Rule 2: Day validity based on month\n    if month in [1, 3, 5, 7, 8, 10, 12]:\n        if not (1 <= day <= 31):\n            return False\n    elif month in [4, 6, 9, 11]:\n        if not (1 <= day <= 30):\n            return False\n    elif month == 2:  # February\n        if not (1 <= day <= 29):\n            return False\n\n    return True"}
{"task_id": "HumanEval/123", "solution": "def get_odd_collatz(n):\n    \"\"\"\n    Returns a sorted list of distinct odd numbers in the Collatz sequence starting at n.\n    The list includes 1, as the sequence always reaches 1.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n\n    current = n\n    odds = set()\n\n    while True:\n        if current % 2 != 0:  # current is odd\n            odds.add(current)\n            if current == 1:\n                break  # We've reached 1 and added it.\n            current = 3 * current + 1\n        else:  # current is even\n            current = current // 2\n\n    return sorted(list(odds))"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    \"\"\"\n    Splits a string by whitespace, then by commas, or counts odd-ordered lowercase letters.\n    The splitting logic follows a specific precedence: whitespace, then commas, then a character count.\n    \"\"\"\n    # Check if any whitespace character exists in the text.\n    if any(char.isspace() for char in txt):\n        return txt.split()\n    # If no whitespaces, check if commas exist.\n    elif ',' in txt:\n        return txt.split(',')\n    # If no whitespaces and no commas, count lowercase letters with odd order.\n    else:\n        count = 0\n        for char in txt:\n            if 'a' <= char <= 'z':  # Check if the character is a lowercase letter.\n                order = ord(char) - ord('a')  # Calculate its 0-indexed order in the alphabet.\n                if order % 2 != 0:  # Check if the order is odd.\n                    count += 1\n        return count"}
{"task_id": "HumanEval/124", "solution": "import re\ndef valid_date(date):\n    \"\"\"Validates a date string against specific format and range rules.\n    Returns True if the date is valid, False otherwise.\n    \"\"\"\n    if not isinstance(date, str):\n        return False\n\n    date = date.strip()\n    if not date:\n        return False\n\n    # Regex to enforce mm-dd-yyyy format strictly\n    match = re.fullmatch(r\"^(\\d{2})-(\\d{2})-(\\d{4})$\", date)\n    if not match:\n        return False\n\n    month_str, day_str, year_str = match.groups()\n\n    month = int(month_str)\n    day = int(day_str)\n    # Year is parsed but not otherwise validated beyond format\n    # year = int(year_str)\n\n    # Validate month range\n    if not (1 <= month <= 12):\n        return False\n\n    # Determine maximum days based on month\n    if month in {1, 3, 5, 7, 8, 10, 12}:\n        max_day = 31\n    elif month in {4, 6, 9, 11}:\n        max_day = 30\n    else:  # month == 2\n        max_day = 29  # Allow up to 29 for February, regardless of leap year\n\n    # Validate day range\n    if not (1 <= day <= max_day):\n        return False\n\n    return True"}
{"task_id": "HumanEval/125", "solution": "def split_words(txt):\n    \"\"\"\n    Splits a string based on whitespace or commas, or counts odd-order lowercase letters.\n    Handles empty strings, comma-only strings, and ignores non-lowercase for counting.\n    \"\"\"\n    if any(c.isspace() for c in txt):\n        return txt.split()\n    elif ',' in txt:\n        return txt.split(',')\n    else:\n        return sum(1 for char in txt if 'a' <= char <= 'z' and (ord(char) - ord('a')) % 2 == 1)"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    \"\"\"\n    Given a list of non-negative integers, return True if the list is sorted\n    in non-decreasing (ascending) order and no number appears more than twice.\n    Otherwise return False.\n    \"\"\"\n    n = len(lst)\n    if n <= 1:\n        return True\n\n    counts = {}\n    prev = lst[0]\n    counts[prev] = 1\n\n    for i in range(1, n):\n        current = lst[i]\n\n        # Check ascending (non-decreasing) order\n        if current < prev:\n            return False\n\n        # Update counts and ensure no number appears more than twice\n        counts[current] = counts.get(current, 0) + 1\n        if counts[current] > 2:\n            return False\n\n        prev = current\n\n    return True"}
{"task_id": "HumanEval/126", "solution": "def is_sorted(lst):\n    '''\n    Given a list of numbers, return whether or not they are sorted\n    in ascending order. If list has more than 1 duplicate of the same\n    number, return False. Assume no negative numbers and only integers.\n    '''\n    if len(lst) <= 1:\n        return True\n\n    counts = {}\n    for num in lst:\n        counts[num] = counts.get(num, 0) + 1\n        if counts[num] > 2:\n            return False\n\n    for i in range(1, len(lst)):\n        if lst[i] < lst[i-1]:\n            return False\n\n    return True"}
{"task_id": "HumanEval/127", "solution": "def intersection(interval1, interval2):\n    a, b = interval1\n    c, d = interval2\n    left = max(a, c)\n    right = min(b, d)\n    if left > right:\n        return \"NO\"\n    length = right - left\n\n    def is_prime(n):\n        if n <= 1:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        import math\n        r = math.isqrt(n)\n        for i in range(3, r + 1, 2):\n            if n % i == 0:\n                return False\n        return True\n\n    return \"YES\" if is_prime(length) else \"NO\""}
{"task_id": "HumanEval/127", "solution": "def is_prime(n):\n    \"\"\"Checks if a number n is prime using trial division up to sqrt(n).\n    Assumes n is an integer greater than or equal to 2.\"\"\"\n    if n % 2 == 0:\n        return n == 2\n    r = int(n**0.5)\n    for i in range(3, r + 1, 2):\n        if n % i == 0:\n            return False\n    return True\ndef intersection(interval1, interval2):\n    \"\"\"Determines if the length of the intersection of two closed integer intervals is a prime number.\"\"\"\n    a, b = interval1\n    c, d = interval2\n\n    start = max(a, c)\n    end = min(b, d)\n\n    if start > end:\n        return \"NO\"\n\n    length = end - start\n\n    if length < 2:\n        return \"NO\"\n\n    if is_prime(length):\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Finds the lexicographically smallest path of length k in a grid.\n    Paths can start anywhere and move to edge-sharing neighbors, revisiting cells is allowed.\n    \"\"\"\n    N = len(grid)\n    if N == 0 or k <= 0:\n        return []\n\n    # Directions for neighbors: up, down, left, right.\n    dr = [-1, 1, 0, 0]\n    dc = [0, 0, -1, 1]\n\n    # prev_dp[r][c] stores the lexicographically smallest path (list of values)\n    # of current length ending at (r, c). Initialize for length 1.\n    prev_dp = [[None for _ in range(N)] for _ in range(N)]\n    for r in range(N):\n        for c in range(N):\n            prev_dp[r][c] = [grid[r][c]]\n\n    # Build up paths for lengths 2..k\n    for curr_k in range(2, k + 1):\n        dp = [[None for _ in range(N)] for _ in range(N)]\n        for r in range(N):\n            for c in range(N):\n                current_value = grid[r][c]\n                # Consider arriving from each neighbor (pr, pc)\n                for i in range(4):\n                    pr, pc = r + dr[i], c + dc[i]\n                    if 0 <= pr < N and 0 <= pc < N and prev_dp[pr][pc] is not None:\n                        candidate = prev_dp[pr][pc] + [current_value]\n                        if dp[r][c] is None or candidate < dp[r][c]:\n                            dp[r][c] = candidate\n        prev_dp = dp\n\n    # Choose the overall lexicographically smallest path among all end cells\n    final_min = None\n    for r in range(N):\n        for c in range(N):\n            if prev_dp[r][c] is not None:\n                if final_min is None or prev_dp[r][c] < final_min:\n                    final_min = prev_dp[r][c]\n\n    return final_min"}
{"task_id": "HumanEval/129", "solution": "def minPath(grid, k):\n    \"\"\"\n    Finds the lexicographically smallest path of length k in the grid.\n    A greedy approach selects the smallest available value at each step.\n    \"\"\"\n    N = len(grid)\n    answer = []\n\n    # Initialize cur_positions with all cells, as we can start anywhere.\n    cur_positions = set()\n    for r in range(N):\n        for c in range(N):\n            cur_positions.add((r, c))\n\n    # Define 4-directional movements: up, down, left, right.\n    dr = [-1, 1, 0, 0]\n    dc = [0, 0, -1, 1]\n\n    for _ in range(k):\n        # Find the minimum value among the current possible positions.\n        min_val = float('inf')\n        for r, c in cur_positions:\n            min_val = min(min_val, grid[r][c])\n\n        answer.append(min_val)\n\n        # Prepare next_positions by finding neighbors of cells that achieved min_val.\n        next_positions = set()\n        for r, c in cur_positions:\n            if grid[r][c] == min_val:\n                # Add all valid 4-directional neighbors.\n                for i in range(4):\n                    nr, nc = r + dr[i], c + dc[i]\n                    if 0 <= nr < N and 0 <= nc < N:\n                        next_positions.add((nr, nc))\n\n        # Update cur_positions for the next iteration.\n        cur_positions = next_positions\n\n    return answer"}
{"task_id": "HumanEval/131", "solution": "def digits(n):\n    \"\"\"Given a positive integer n, return the product of its odd digits.\n    Return 0 if all digits are even.\"\"\"\n    product = 1\n    found_odd = False\n    while n > 0:\n        digit = n % 10\n        if digit % 2 != 0:\n            product *= digit\n            found_odd = True\n        n //= 10\n    return product if found_odd else 0"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Calculates the Tribonacci sequence up to index n and returns a list of length n+1.\"\"\"\n    # Allocate space up to n+1 because odd-index recurrence depends on tri(n+1).\n    dp = [None] * (n + 2)\n\n    # Base cases (tri(0) inferred from example, tri(1) given)\n    dp[0] = 1\n    dp[1] = 3\n\n    # Compute all even indices (including up to n+1) using the explicit formula.\n    for i in range(2, n + 2):\n        if i % 2 == 0:\n            dp[i] = 1 + i // 2\n\n    # Compute odd indices using the recurrence that depends on tri(i+1) (which is even and already set).\n    for i in range(3, n + 1, 2):\n        dp[i] = dp[i - 1] + dp[i - 2] + dp[i + 1]\n\n    return dp[0 : n + 1]"}
{"task_id": "HumanEval/130", "solution": "def tri(n):\n    \"\"\"Calculates the Tribonacci sequence defined by specific rules and returns a list of its first n+1 numbers.\n    The definition for odd n is modified by substituting tri(n+1) = 1 + (n+1)/2.\"\"\"\n\n    trib_sequence = [0] * (n + 1)\n\n    if n >= 0:\n        trib_sequence[0] = 1\n    if n >= 1:\n        trib_sequence[1] = 3\n\n    for k in range(2, n + 1):\n        if k % 2 == 0:  # k is even\n            trib_sequence[k] = 1 + k // 2\n        else:  # k is odd\n            # Derived from tri(k) = tri(k - 1) + tri(k - 2) + tri(k + 1)\n            # where tri(k + 1) = 1 + (k + 1) // 2 since k+1 is even.\n            trib_sequence[k] = trib_sequence[k - 1] + trib_sequence[k - 2] + (1 + (k + 1) // 2)\n\n    return trib_sequence"}
