{"task_id": "HumanEval/63", "solution": "def fibfib(n: int):\n    \"\"\"Compute the n-th FibFib number.\n\n    The sequence is defined as:\n      fibfib(0) == 0\n      fibfib(1) == 0\n      fibfib(2) == 1\n      fibfib(n) == fibfib(n-1) + fibfib(n-2) + fibfib(n-3) for n >= 3\n\n    Args:\n        n: non-negative integer index\n\n    Returns:\n        The n-th FibFib number as an int.\n\n    Raises:\n        TypeError: if n is not an int.\n        ValueError: if n is negative.\n\n    Examples:\n        >>> fibfib(1)\n        0\n        >>> fibfib(5)\n        4\n        >>> fibfib(8)\n        24\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 1\n\n    a, b, c = 0, 0, 1  # fibfib(i-3), fibfib(i-2), fibfib(i-1)\n    for _ in range(3, n + 1):\n        a, b, c = b, c, a + b + c\n    return c"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Counts vowels in a string, where 'y' is a vowel only at the end.\n    Vowels include 'a', 'e', 'i', 'o', 'u' (case-insensitive).\n    \"\"\"\n    s_lower = s.lower()\n    vowels = {'a', 'e', 'i', 'o', 'u'}\n    count = 0\n\n    # Count vowels in all but the last character\n    for char in s_lower[:-1]:\n        if char in vowels:\n            count += 1\n\n    # Check the last character (if any): it's a vowel or 'y'\n    if s_lower:\n        last_char = s_lower[-1]\n        if last_char in vowels or last_char == 'y':\n            count += 1\n\n    return count"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Counts vowels in a string, including 'y' only if it's at the end of the word.\n    Vowels are 'a', 'e', 'i', 'o', 'u' (case-insensitive).\n    \"\"\"\n    count = 0\n    vowels = set(\"aeiou\")\n    s_lower = s.lower()\n\n    for i, char in enumerate(s_lower):\n        if char in vowels:\n            count += 1\n        elif char == 'y' and i == len(s_lower) - 1:\n            count += 1\n    return count"}
{"task_id": "HumanEval/63", "solution": "def fibfib(n: int) -> int:\n    \"\"\"Compute the n-th FibFib number where:\n       fibfib(0) = 0, fibfib(1) = 0, fibfib(2) = 1, and\n       fibfib(n) = fibfib(n-1) + fibfib(n-2) + fibfib(n-3) for n >= 3.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 1\n\n    def _multiply_matrices(A, B):\n        return [\n            [\n                A[0][0] * B[0][0] + A[0][1] * B[1][0] + A[0][2] * B[2][0],\n                A[0][0] * B[0][1] + A[0][1] * B[1][1] + A[0][2] * B[2][1],\n                A[0][0] * B[0][2] + A[0][1] * B[1][2] + A[0][2] * B[2][2],\n            ],\n            [\n                A[1][0] * B[0][0] + A[1][1] * B[1][0] + A[1][2] * B[2][0],\n                A[1][0] * B[0][1] + A[1][1] * B[1][1] + A[1][2] * B[2][1],\n                A[1][0] * B[0][2] + A[1][1] * B[1][2] + A[1][2] * B[2][2],\n            ],\n            [\n                A[2][0] * B[0][0] + A[2][1] * B[1][0] + A[2][2] * B[2][0],\n                A[2][0] * B[0][1] + A[2][1] * B[1][1] + A[2][2] * B[2][1],\n                A[2][0] * B[0][2] + A[2][1] * B[1][2] + A[2][2] * B[2][2],\n            ],\n        ]\n\n    def _matrix_power(M, power):\n        # Binary exponentiation\n        result = [[1, 0, 0], [0, 1, 0], [0, 0, 1]]\n        base = M\n        p = power\n        while p > 0:\n            if p & 1:\n                result = _multiply_matrices(result, base)\n            base = _multiply_matrices(base, base)\n            p >>= 1\n        return result\n\n    # Transformation matrix:\n    # [1 1 1]\n    # [1 0 0]\n    # [0 1 0]\n    T = [[1, 1, 1], [1, 0, 0], [0, 1, 0]]\n    T_exp = _matrix_power(T, n - 2)\n\n    # initial vector [fibfib(2), fibfib(1), fibfib(0)] = [1, 0, 0]\n    # fibfib(n) is the first component of T_exp * initial_vector which is T_exp[0][0]\n    return T_exp[0][0]"}
{"task_id": "HumanEval/62", "solution": "def derivative(xs: list):\n    \"\"\"Calculates the derivative of a polynomial represented by coefficients.\n    The input list xs[i] is the coefficient of x^i.\n    \"\"\"\n    if not xs or len(xs) == 1:\n        return []\n    return [(i + 1) * xs[i + 1] for i in range(len(xs) - 1)]"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of integer x right by 'shift' positions.\n    If 'shift' exceeds number of digits, digits are reversed.\n    \"\"\"\n    # Input validation\n    if not isinstance(x, int):\n        raise TypeError(\"x must be an integer\")\n    if not isinstance(shift, int):\n        raise TypeError(\"shift must be an integer\")\n    if shift < 0:\n        raise ValueError(\"shift must be non-negative\")\n\n    is_negative = x < 0\n    digits = str(abs(x))\n    n = len(digits)\n\n    if n == 0:\n        result_digits = \"\"\n    elif shift == 0:\n        result_digits = digits\n    elif shift > n:\n        result_digits = digits[::-1]  # Reverse string\n    else:  # 0 < shift <= n\n        s = shift\n        result_digits = digits[-s:] + digits[:-s]\n\n    if is_negative:\n        result_digits = '-' + result_digits\n\n    return result_digits"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    >>> circular_shift(12, 1)\n    \"21\"\n    >>> circular_shift(12, 2)\n    \"12\"\n    \"\"\"\n    if not isinstance(x, int):\n        raise TypeError(\"x must be an integer\")\n    if not isinstance(shift, int):\n        raise TypeError(\"shift must be an integer\")\n    if shift < 0:\n        raise ValueError(\"shift must be non-negative\")\n\n    is_negative = x < 0\n    s = str(abs(x))\n    n = len(s)\n\n    # If shift greater than number of digits, return reversed digits\n    if shift > n:\n        shifted = s[::-1]\n    else:\n        # effective rotation (shift == n or shift % n == 0 -> original)\n        effective = shift % n if n else 0\n        if effective == 0:\n            shifted = s\n        else:\n            shifted = s[-effective:] + s[:-effective]\n\n    return (\"-\" + shifted) if is_negative else shifted"}
