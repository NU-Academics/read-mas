{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"Finds the closest vowel from the right that is surrounded by consonants (case sensitive).\n    Vowels at the beginning or end of the word do not count. Returns empty string if none found.\n    \"\"\"\n    vowels = \"aeiouAEIOU\"\n    # Iterate from second-to-last index down to index 1 (inclusive), skipping first and last chars\n    for i in range(len(word) - 2, 0, -1):\n        ch = word[i]\n        if ch in vowels:\n            if (word[i - 1] not in vowels) and (word[i + 1] not in vowels):\n                return ch\n    return \"\""}
{"task_id": "HumanEval/116", "solution": "def sort_array(arr):\n    \"\"\"\n    Sorts an array of integers primarily by the count of ones in their binary representation (popcount) ascending.\n    Elements with the same popcount are sorted by their numeric value ascending.\n    \"\"\"\n    return sorted(arr, key=lambda x: (bin(x).count('1'), x))"}
{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    '''\n    You are given a list of two strings, both strings consist of open\n    parentheses '(' or close parentheses ')' only.\n    Your job is to check if it is possible to concatenate the two strings in\n    some order, that the resulting string will be good.\n    A string S is considered to be good if and only if all parentheses in S\n    are balanced. For example: the string '(())()' is good, while the string\n    '())' is not.\n    Return 'Yes' if there's a way to make a good string, and return 'No' otherwise.\n\n    Examples:\n    match_parens(['()(', ')']) == 'Yes'\n    match_parens([')', ')']) == 'No'\n    '''\n\n    def _compute_balance_and_min_prefix(s):\n        '''Computes total balance and minimum prefix balance for a string.'''\n        balance = 0\n        min_prefix_balance = 0\n        for char in s:\n            if char == '(':\n                balance += 1\n            else:\n                balance -= 1\n            min_prefix_balance = min(min_prefix_balance, balance)\n        return balance, min_prefix_balance\n\n    def _valid_concat(b_left, m_left, b_right, m_right):\n        '''Checks if two strings can form a balanced string when concatenated in a specific order.'''\n        return (m_left >= 0 and\n                m_right + b_left >= 0 and\n                b_left + b_right == 0)\n\n    s0, s1 = lst[0], lst[1]\n\n    b0, m0 = _compute_balance_and_min_prefix(s0)\n    b1, m1 = _compute_balance_and_min_prefix(s1)\n\n    # Check order s0 + s1\n    if _valid_concat(b0, m0, b1, m1):\n        return 'Yes'\n\n    # Check order s1 + s0\n    if _valid_concat(b1, m1, b0, m0):\n        return 'Yes'\n\n    return 'No'"}
{"task_id": "HumanEval/119", "solution": "def match_parens(lst):\n    def is_balanced(s):\n        balance = 0\n        for ch in s:\n            if ch == '(':\n                balance += 1\n            else:\n                balance -= 1\n            if balance < 0:\n                return False\n        return balance == 0\n\n    s1, s2 = lst[0], lst[1]\n    if is_balanced(s1 + s2) or is_balanced(s2 + s1):\n        return 'Yes'\n    return 'No'"}
{"task_id": "HumanEval/120", "solution": "def maximum(arr, k):\n    \"\"\"\n    Returns a sorted list of the k largest integers from the input list arr.\n    Uses a heap-based approach for efficiency.\n    \"\"\"\n    import heapq\n\n    if k == 0:\n        return []\n\n    # If k is equal to the length of the array, return the entire sorted array.\n    if k == len(arr):\n        return sorted(arr)\n\n    # Use heapq.nlargest to get the k largest elements efficiently.\n    # This returns elements in arbitrary order, so sort them before returning.\n    largest_elements = heapq.nlargest(k, arr)\n    largest_elements.sort()\n    return largest_elements"}
{"task_id": "HumanEval/120", "solution": "def maximum(arr, k):\n    \"\"\"\n    Given an array arr and a positive integer k, return a sorted list\n    of length k with the maximum k numbers in arr.\n    \"\"\"\n    # Handle k == 0 explicitly\n    if k == 0:\n        return []\n    sorted_arr = sorted(arr)\n    return sorted_arr[-k:]"}
