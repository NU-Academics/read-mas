{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"Calculates the Brazilian factorial, which is the product of factorials from 1! up to n!.\n    n must be a positive integer.\n    \"\"\"\n    special_fact_result = 1\n    current_factorial = 1\n    for i in range(1, n + 1):\n        current_factorial *= i\n        special_fact_result *= current_factorial\n    return special_fact_result"}
{"task_id": "HumanEval/137", "solution": "def compare_one(a, b):\n    \"\"\"\n    Create a function that takes integers, floats, or strings representing\n    real numbers, and returns the larger variable in its given variable type.\n    Return None if the values are equal.\n    Note: If a real number is represented as a string, the floating point might be . or ,\n    \"\"\"\n    def parse_to_float(val):\n        # If it's already an int or float, convert directly to float\n        if isinstance(val, (int, float)):\n            return float(val)\n        # For strings: strip whitespace, replace comma with dot, then parse\n        if isinstance(val, str):\n            s = val.strip()\n            # Replace comma decimal separator with dot\n            s = s.replace(',', '.')\n            try:\n                return float(s)\n            except ValueError:\n                # If parsing fails, raise a clear error\n                raise ValueError(f\"Cannot parse '{val}' as a real number\")\n        # Unsupported type\n        raise TypeError(f\"Unsupported type: {type(val)}\")\n\n    fa = parse_to_float(a)\n    fb = parse_to_float(b)\n\n    if fa == fb:\n        return None\n    return a if fa > fb else b"}
{"task_id": "HumanEval/137", "solution": "def compare_one(a, b):\n    \"\"\"\n    Compare two values (int, float, or string representing a real number).\n    Return the larger argument in its original type, or None if numerically equal.\n\n    String inputs may use '.' or ',' as the decimal separator and may contain\n    leading/trailing whitespace and an optional sign. Raises ValueError for\n    invalid numeric strings and TypeError for unsupported types.\n    \"\"\"\n    EPSILON = 1e-9\n\n    def to_numeric(x):\n        if isinstance(x, str):\n            s = x.strip().replace(',', '.')\n            try:\n                # float() will raise ValueError for invalid formats\n                return float(s)\n            except ValueError:\n                raise ValueError(f\"Invalid numeric string: {x!r}\")\n        if isinstance(x, (int, float)):\n            return float(x)\n        raise TypeError(f\"Unsupported type: {type(x).__name__}\")\n\n    na = to_numeric(a)\n    nb = to_numeric(b)\n\n    # Handle NaN explicitly (treat as invalid)\n    if na != na or nb != nb:\n        raise ValueError(\"NaN encountered in input\")\n\n    if abs(na - nb) <= EPSILON:\n        return None\n    return a if na > nb else b"}
{"task_id": "HumanEval/138", "solution": "def is_equal_to_sum_even(n):\n    \"\"\"Evaluate whether n can be written as the sum of exactly 4 positive even numbers.\n    Returns True if n is an even integer >= 8, False otherwise.\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an integer\")\n    return n % 2 == 0 and n >= 8"}
{"task_id": "HumanEval/139", "solution": "def special_factorial(n):\n    \"\"\"The Brazilian factorial is defined as: n! * (n-1)! * ... * 1!.\n    This function computes the special factorial for a positive integer n.\n    \"\"\"\n    result = 1\n    running_fact = 1\n    for k in range(1, n + 1):\n        running_fact *= k\n        result *= running_fact\n    return result"}
{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text):\n    \"\"\"Replaces single spaces with underscores, runs of two spaces with two underscores, and runs of three or more spaces with a hyphen.\"\"\"\n    def replacer(match):\n        s = match.group(0)\n        if len(s) >= 3:\n            return '-'\n        return '_' * len(s)\n    return re.sub(r' +', replacer, text)"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    Squares elements at indices that are multiples of 3, cubes elements at indices that are\n    multiples of 4 (but not 3), and sums the modified values.\n    \"\"\"\n    return sum(\n        x * x if i % 3 == 0 else\n        x * x * x if i % 4 == 0 else\n        x\n        for i, x in enumerate(lst)\n    )"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    You are given a string representing a sentence,\n    the sentence contains some words separated by a space,\n    and you have to return a string that contains the words from the original sentence,\n    whose lengths are prime numbers,\n    the order of the words in the new string should be the same as the original one.\n    \"\"\"\n    def is_prime(n):\n        if n < 2:\n            return False\n        if n == 2:\n            return True\n        if n % 2 == 0:\n            return False\n        i = 3\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 2\n        return True\n\n    words = sentence.split()\n    filtered = [w for w in words if is_prime(len(w))]\n    return \" \".join(filtered)"}
{"task_id": "HumanEval/142", "solution": "def sum_squares(lst):\n    \"\"\"\n    Calculates a sum based on element's index: square if index is multiple of 3, cube if index is multiple of 4 and not 3, else unchanged.\n    Returns the sum of processed elements.\n    \"\"\"\n    total = 0\n    for i, x in enumerate(lst):\n        if i % 3 == 0:\n            total += x * x\n        elif i % 4 == 0:\n            total += x * x * x\n        else:\n            total += x\n    return total"}
{"task_id": "HumanEval/141", "solution": "def file_name_check(file_name):\n    \"\"\"\n    Checks if a file name is valid based on a set of rules.\n    Returns 'Yes' if valid, 'No' otherwise.\n    \"\"\"\n    digit_count = 0\n    for char in file_name:\n        if '0' <= char <= '9':\n            digit_count += 1\n    if digit_count > 3:\n        return 'No'\n\n    if file_name.count('.') != 1:\n        return 'No'\n\n    parts = file_name.split('.')\n    prefix = parts[0]\n    suffix = parts[1]\n\n    if not prefix:\n        return 'No'\n\n    first_char = prefix[0]\n    if not ('a' <= first_char <= 'z' or 'A' <= first_char <= 'Z'):\n        return 'No'\n\n    allowed_extensions = ['txt', 'exe', 'dll']\n    if suffix not in allowed_extensions:\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/143", "solution": "def words_in_sentence(sentence):\n    \"\"\"\n    Returns a string containing words from the original sentence\n    whose lengths are prime numbers, preserving their order.\n    \"\"\"\n\n    def is_prime(n):\n        \"\"\"Checks if a given number n is prime.\"\"\"\n        if n < 2:\n            return False\n        i = 2\n        while i * i <= n:\n            if n % i == 0:\n                return False\n            i += 1\n        return True\n\n    words = sentence.split()\n    result_words = []\n    for word in words:\n        if is_prime(len(word)):\n            result_words.append(word)\n\n    return \" \".join(result_words)"}
{"task_id": "HumanEval/144", "solution": "def simplify(x, n):\n    \"\"\"Checks if the product of two string fractions is a whole number.\"\"\"\n    def _gcd(a, b):\n        while b:\n            a, b = b, a % b\n        return a\n\n    num_x_str, den_x_str = x.split('/')\n    num_x = int(num_x_str)\n    den_x = int(den_x_str)\n\n    num_n_str, den_n_str = n.split('/')\n    num_n = int(num_n_str)\n    den_n = int(den_n_str)\n\n    common_divisor_1 = _gcd(num_x, den_n)\n    num_x //= common_divisor_1\n    den_n //= common_divisor_1\n\n    common_divisor_2 = _gcd(num_n, den_x)\n    num_n //= common_divisor_2\n    den_x //= common_divisor_2\n\n    final_numerator = num_x * num_n\n    final_denominator = den_x * den_n\n\n    common_divisor_final = _gcd(final_numerator, final_denominator)\n    simplified_denominator = final_denominator // common_divisor_final\n\n    return simplified_denominator == 1"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Write a function which sorts the given list of integers\n    in ascending order according to the sum of their digits.\n    Note: if there are several items with similar sum of their digits,\n    order them based on their index in original list.\n    \"\"\"\n    def digit_sum(n):\n        return sum(int(ch) for ch in str(abs(n)))\n    return sorted(nums, key=digit_sum)"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"Write a function that takes an array of numbers as input and returns\n    the number of elements in the array that are greater than 10 and both\n    first and last digits of a number are odd (1, 3, 5, 7, 9).\n    For example:\n    specialFilter([15, -73, 14, -15]) => 1\n    specialFilter([33, -2, -3, 45, 21, 109]) => 2\n    \"\"\"\n    import math\n\n    # Validate iterable\n    try:\n        iter(nums)\n    except TypeError:\n        raise TypeError(\"nums must be an iterable\")\n\n    count = 0\n    for x in nums:\n        # Skip booleans (subclass of int) and non-numeric types\n        if isinstance(x, bool):\n            continue\n        if not isinstance(x, (int, float)):\n            continue\n        # Skip non-finite floats (inf, -inf, nan)\n        if isinstance(x, float) and not math.isfinite(x):\n            continue\n        # Must be strictly greater than 10\n        if x <= 10:\n            continue\n\n        # Use absolute integer part for digit extraction\n        n = abs(int(x))\n\n        # If integer part is 0, digits are 0 -> not odd\n        if n == 0:\n            continue\n\n        last = n % 10\n        first = n\n        while first >= 10:\n            first //= 10\n\n        if first % 2 == 1 and last % 2 == 1:\n            count += 1\n\n    return count"}
{"task_id": "HumanEval/145", "solution": "def order_by_points(nums):\n    \"\"\"\n    Sort the given list of integers in ascending order according to the\n    sum of their digits (computed from the absolute value). For tie-breaking,\n    preserve the original order (by using the original index).\n\n    Note: This implementation matches the example behavior where non-negative\n    numbers get +1 offset and negative numbers get -1 offset to their digit\n    sums when computing the sort key.\n    \"\"\"\n    if not nums:\n        return []\n\n    def sum_digits_abs(n: int) -> int:\n        n = abs(n)\n        if n == 0:\n            return 0\n        s = 0\n        while n:\n            s += n % 10\n            n //= 10\n        return s\n\n    indexed = list(enumerate(nums))  # (index, num)\n    # sort by (points, original_index) where points = sum_digits_abs +/- 1\n    sorted_pairs = sorted(\n        indexed,\n        key=lambda pair: (\n            (sum_digits_abs(pair[1]) - 1) if pair[1] < 0 else (sum_digits_abs(pair[1]) + 1),\n            pair[0],\n        ),\n    )\n    return [num for _, num in sorted_pairs]"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Counts triples (a[i], a[j], a[k]) where i < j < k and their sum is a multiple of 3.\n    It categorizes elements of array `a` based on their values modulo 3.\n    \"\"\"\n    rem_0_count = 0  # Count of a[x] such that a[x] % 3 == 0\n    rem_1_count = 0  # Count of a[x] such that a[x] % 3 == 1\n\n    for i in range(1, n + 1):\n        # We analyze a[i] = i * i - i + 1 modulo 3.\n        # a[i] % 3 is 0 if i % 3 == 2, and 1 otherwise (i.e., if i % 3 == 0 or i % 3 == 1).\n        if i % 3 == 2:\n            rem_0_count += 1\n        else:\n            rem_1_count += 1\n\n    # A sum a[i] + a[j] + a[k] is a multiple of 3 if (a[i]%3 + a[j]%3 + a[k]%3) % 3 == 0.\n    # Since a[x]%3 can only be 0 or 1, the only valid combinations of remainders are (0,0,0) or (1,1,1).\n\n    count_000 = 0\n    if rem_0_count >= 3:\n        # Calculate C(rem_0_count, 3)\n        count_000 = rem_0_count * (rem_0_count - 1) * (rem_0_count - 2) // 6\n\n    count_111 = 0\n    if rem_1_count >= 3:\n        # Calculate C(rem_1_count, 3)\n        count_111 = rem_1_count * (rem_1_count - 1) * (rem_1_count - 2) // 6\n\n    return count_000 + count_111"}
{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    \"\"\"\n    Returns a tuple of planets between planet1 and planet2, sorted by proximity to the sun.\n    Returns an empty tuple if either input planet name is invalid.\n    \"\"\"\n    planets = (\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\")\n\n    if planet1 not in planets or planet2 not in planets:\n        return ()\n\n    idx1 = planets.index(planet1)\n    idx2 = planets.index(planet2)\n\n    if idx1 > idx2:\n        start_idx = idx2 + 1\n        end_idx = idx1\n    else:\n        start_idx = idx1 + 1\n        end_idx = idx2\n\n    return planets[start_idx:end_idx]"}
{"task_id": "HumanEval/148", "solution": "def bf(planet1, planet2):\n    \"\"\"\n    Returns a tuple of planets located between planet1 and planet2, sorted by proximity to the sun.\n    Returns an empty tuple if planet names are incorrect.\n    \"\"\"\n    planets_order = [\"Mercury\", \"Venus\", \"Earth\", \"Mars\", \"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"]\n\n    try:\n        idx1 = planets_order.index(planet1)\n        idx2 = planets_order.index(planet2)\n    except ValueError:\n        return ()\n\n    if idx1 < idx2:\n        return tuple(planets_order[idx1 + 1:idx2])\n    else:\n        return tuple(planets_order[idx2 + 1:idx1])"}
{"task_id": "HumanEval/147", "solution": "def get_max_triples(n):\n    \"\"\"\n    Counts triples (i, j, k) where i < j < k and a[i] + a[j] + a[k] is a multiple of 3.\n    a[i] = i*i - i + 1\n    \"\"\"\n    if n < 3:\n        return 0\n\n    # cnt0: number of indices i with i % 3 == 2 => a[i] % 3 == 0\n    cnt0 = n // 3 + (1 if n % 3 >= 2 else 0)\n    cnt1 = n - cnt0  # remaining indices have a[i] % 3 == 1\n\n    def combinations_3(count):\n        if count < 3:\n            return 0\n        return (count * (count - 1) * (count - 2)) // 6\n\n    return combinations_3(cnt0) + combinations_3(cnt1)"}
