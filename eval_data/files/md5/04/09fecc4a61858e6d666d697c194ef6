{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Checks if a number is a product of three prime numbers.\n    The number 'a' is less than 100, and primes may repeat.\n    \"\"\"\n    # The smallest product of three primes (2*2*2) is 8.\n    if a < 8:\n        return False\n\n    factors_count = 0\n    temp_a = a\n    d = 2\n\n    # Iterate through potential prime factors up to the square root of temp_a.\n    while d * d <= temp_a:\n        if temp_a % d == 0:\n            while temp_a % d == 0:\n                factors_count += 1\n                temp_a //= d\n                # If more than 3 factors are found, it's not a product of exactly 3.\n                if factors_count > 3:\n                    return False\n        d += 1\n\n    # If temp_a is still greater than 1, it is the remaining prime factor.\n    if temp_a > 1:\n        factors_count += 1\n\n    return factors_count == 3"}
{"task_id": "HumanEval/76", "solution": "def is_simple_power(x, n):\n  \"\"\"Checks if x is an integer power of n (n**k == x for k >= 0).\n  Handles special bases and negative numbers correctly.\"\"\"\n  if not isinstance(x, int) or not isinstance(n, int):\n    return False\n\n  if x == 1:\n    return True\n\n  if n == 1:\n    return x == 1\n  if n == -1:\n    return x == 1 or x == -1\n  if n == 0:\n    return x == 0 or x == 1\n\n  # For x == 0 here, n is not 0. No non-zero base power can be zero.\n  if x == 0:\n    return False\n\n  # If base is positive and target x is negative, it's impossible.\n  if n > 0 and x < 0:\n    return False\n\n  current = x\n  while current % n == 0:\n    current = current // n\n    if current == 1:\n      return True\n  return False"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    \"\"\"\n    Return True if integer a is a perfect cube of some integer, else False.\n    \"\"\"\n    if a == 0:\n        return True\n\n    x = abs(a)\n    lo, hi = 0, x if x >= 1 else 1\n\n    while lo <= hi:\n        mid = (lo + hi) // 2\n        cube = mid * mid * mid\n        if cube == x:\n            return True\n        if cube < x:\n            lo = mid + 1\n        else:\n            hi = mid - 1\n\n    return False"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    \"\"\"\n    Checks if an integer 'a' is a perfect cube of some integer.\n    Uses binary search on the absolute value after an exponential expansion to find the search range.\n    \"\"\"\n    if a == 0:\n        return True\n\n    abs_a = abs(a)\n\n    # Exponential expansion to find an upper bound for the cube root.\n    high = 1\n    while high * high * high < abs_a:\n        high *= 2\n\n    # Binary search within the determined range [0, high].\n    low = 0\n    while low <= high:\n        mid = (low + high) // 2\n        mid_cubed = mid * mid * mid\n\n        if mid_cubed == abs_a:\n            return True\n        elif mid_cubed < abs_a:\n            low = mid + 1\n        else:  # mid_cubed > abs_a\n            high = mid - 1\n\n    return False"}
