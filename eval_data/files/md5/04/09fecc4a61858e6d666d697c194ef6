{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the indicies that are not divisible by three, while its values at the indicies that are divisible by three are equal\n    to the values of the corresponding indicies of l, but sorted.\n    >>> sort_third([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_third([5, 6, 3, 4, 8, 9, 2])\n    [2, 6, 3, 4, 8, 9, 5]\n    \"\"\"\n    result_list = l[:]  # shallow copy to avoid mutating input\n\n    # collect elements at indices divisible by 3\n    third_elements = [l[i] for i in range(len(l)) if i % 3 == 0]\n    third_elements.sort()\n\n    # replace elements at indices divisible by 3 with sorted values\n    it = iter(third_elements)\n    for i in range(len(result_list)):\n        if i % 3 == 0:\n            result_list[i] = next(it)\n\n    return result_list"}
{"task_id": "HumanEval/33", "solution": "def sort_third(l: list):\n    \"\"\"Sorts elements at indices divisible by three in a list.\n    Other elements remain in their original positions.\"\"\"\n    third_elements = []\n    third_indices = []\n\n    for i, x in enumerate(l):\n        if i % 3 == 0:\n            third_elements.append(x)\n            third_indices.append(i)\n\n    third_elements.sort()\n\n    result_list = list(l)  # Create a mutable copy of the input list\n\n    for j, idx in enumerate(third_indices):\n        result_list[idx] = third_elements[j]\n\n    return result_list"}
{"task_id": "HumanEval/32", "solution": "def find_zero(xs: list):\n    # Tolerances and iteration limits\n    eps = 1e-12\n    xtol = 1e-14\n    max_bis = 100\n    max_samples = 400\n    max_newton = 50\n\n    if xs is None or len(xs) == 0:\n        raise ValueError(\"Coefficient list is empty\")\n\n    # Work on a copy and strip trailing zero coefficients (highest-degree zeros)\n    coeffs = list(xs)\n    while len(coeffs) > 1 and abs(coeffs[-1]) == 0.0:\n        coeffs.pop()\n\n    # After stripping, handle simple cases\n    if len(coeffs) == 1:\n        # constant polynomial\n        if abs(coeffs[0]) <= eps:\n            return 0.0\n        raise ValueError(\"Polynomial is constant non-zero; no real root\")\n    if len(coeffs) == 2:\n        # linear: a0 + a1*x = 0 -> x = -a0/a1\n        a0, a1 = coeffs[0], coeffs[1]\n        if abs(a1) <= eps:\n            raise ValueError(\"Degenerate linear polynomial\")\n        return -a0 / a1\n\n    # Horner evaluation and derivative (single-pass)\n    def eval_poly(x: float) -> float:\n        res = 0.0\n        for a in reversed(coeffs):\n            res = res * x + a\n        return res\n\n    def eval_poly_and_deriv(x: float):\n        # p = a_n; dp = 0; for k = n-1..0: dp = dp*x + p; p = p*x + a_k\n        p = coeffs[-1]\n        dp = 0.0\n        for k in range(len(coeffs) - 2, -1, -1):\n            dp = dp * x + p\n            p = p * x + coeffs[k]\n        return p, dp\n\n    # Cauchy bound for root radius\n    an = coeffs[-1]\n    if abs(an) <= eps:\n        R = 1.0\n    else:\n        max_other = max((abs(a) for a in coeffs[:-1]), default=0.0)\n        R = 1.0 + max_other / abs(an)\n    if R <= 0:\n        R = 1.0\n\n    # Bracketing by sampling in [-R, R]\n    a, b = -R, R\n    fa = eval_poly(a)\n    if abs(fa) <= eps:\n        return a\n    last_x, last_f = a, fa\n    best_x = None\n    best_abs = float(\"inf\")\n    found_bracket = False\n    lo = hi = None\n\n    for i in range(1, max_samples + 1):\n        x = a + (b - a) * i / max_samples\n        fx = eval_poly(x)\n        if abs(fx) <= eps:\n            return x\n        if last_f * fx < 0:\n            lo, hi = last_x, x\n            found_bracket = True\n            break\n        if abs(fx) < best_abs:\n            best_abs = abs(fx)\n            best_x = x\n        last_x, last_f = x, fx\n\n    # If not found, try expanding radius a few times\n    if not found_bracket:\n        factor = 2.0\n        for _ in range(5):\n            R *= factor\n            a, b = -R, R\n            last_x, last_f = a, eval_poly(a)\n            if abs(last_f) <= eps:\n                return a\n            for i in range(1, max_samples + 1):\n                x = a + (b - a) * i / max_samples\n                fx = eval_poly(x)\n                if abs(fx) <= eps:\n                    return x\n                if last_f * fx < 0:\n                    lo, hi = last_x, x\n                    found_bracket = True\n                    break\n                if abs(fx) < best_abs:\n                    best_abs = abs(fx)\n                    best_x = x\n                last_x, last_f = x, fx\n            if found_bracket:\n                break\n\n    # If bracket found, use bisection\n    if found_bracket:\n        lo_f = eval_poly(lo)\n        hi_f = eval_poly(hi)\n        root = 0.5 * (lo + hi)\n        for _ in range(max_bis):\n            mid = 0.5 * (lo + hi)\n            fm = eval_poly(mid)\n            if abs(fm) <= eps or (hi - lo) / 2 <= xtol:\n                root = mid\n                break\n            if lo_f * fm <= 0:\n                hi = mid\n                hi_f = fm\n            else:\n                lo = mid\n                lo_f = fm\n            root = mid\n    else:\n        # No bracket found: fall back to Newton starting at the best sampled point or 0\n        start = best_x if best_x is not None else 0.0\n        root = float(start)\n        for _ in range(max_newton):\n            p, dp = eval_poly_and_deriv(root)\n            if abs(p) <= eps:\n                break\n            if abs(dp) <= eps:\n                break\n            root = root - p / dp\n\n    # Final Newton refinement (safeguarded)\n    for _ in range(20):\n        p, dp = eval_poly_and_deriv(root)\n        if abs(p) <= eps:\n            return root\n        if abs(dp) <= eps:\n            break\n        new_root = root - p / dp\n        if abs(new_root - root) <= xtol:\n            return new_root\n        root = new_root\n\n    return root"}
{"task_id": "HumanEval/35", "solution": "def max_element(l: list):\n    \"\"\"Return maximum element in the list.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    # Validate that the input is a list, as specified.\n    if not isinstance(l, list):\n        raise TypeError(\"l must be a list\")\n\n    # Handle empty list case by raising ValueError.\n    if not l:\n        raise ValueError(\"max_element() arg is an empty list\")\n\n    max_val = l[0]\n    # Iterate through the list from the second element to find the maximum.\n    for i in range(1, len(l)):\n        try:\n            if l[i] > max_val:\n                max_val = l[i]\n        except TypeError:\n            # Re-raise TypeError with context for non-comparable elements.\n            raise TypeError(\n                f\"Elements at index 0 (type {type(l[0]).__name__}) \"\n                f\"and index {i} (type {type(l[i]).__name__}) \"\n                \"are not mutually comparable.\"\n            ) from None\n\n    return max_val"}
{"task_id": "HumanEval/34", "solution": "def unique(l: list):\n    \"\"\"Return sorted unique elements in a list.\n    Handles unhashable items and incomparable types by falling back to robust sorting and deduplication.\n    \"\"\"\n    deduplicated_items = []\n\n    try:\n        # Primary fast path: use set for deduplication (O(n) average)\n        uniques_set = set(l)\n        deduplicated_items = list(uniques_set)\n    except TypeError:\n        # Fallback for unhashable elements: O(n^2) list-based deduplication with equality checks\n        seen_list = []\n        for x in l:\n            is_seen = False\n            for y in seen_list:\n                try:\n                    # Try normal equality comparison\n                    if x == y:\n                        is_seen = True\n                        break\n                except Exception:\n                    # If equality comparison raises, fall back to identity comparison\n                    if x is y:\n                        is_seen = True\n                        break\n            if not is_seen:\n                seen_list.append(x)\n        deduplicated_items = seen_list\n\n    # Sort the deduplicated items\n    try:\n        # Try natural sorting (O(k log k))\n        return sorted(deduplicated_items)\n    except TypeError:\n        # Fallback for incomparable types: sort using a deterministic key based on type name and repr\n        return sorted(deduplicated_items, key=lambda v: (type(v).__name__, repr(v)))"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\"\"\"\n    count = 0\n    for num in range(1, n):\n        if num % 11 == 0 or num % 13 == 0:\n            count += str(num).count('7')\n    return count"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    result = l.copy()  # Create a shallow copy to store the result, preserving odd-indexed values.\n\n    even_values = [l[i] for i in range(0, len(l), 2)]  # Extract values from even indices.\n\n    sorted_even_values = sorted(even_values)  # Sort the extracted even values.\n\n    even_idx_in_sorted = 0\n    for i in range(0, len(l), 2):\n        result[i] = sorted_even_values[even_idx_in_sorted]  # Place sorted values back at even indices.\n        even_idx_in_sorted += 1\n\n    return result"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    Decodes a string that was encoded using the encode_cyclic function.\n    Reverses the cyclic shift for groups of three characters.\n    \"\"\"\n    # Split the encoded string back into groups of 3 characters.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n\n    # Reverse the cyclic shift for groups that were modified.\n    decoded_groups = []\n    for group in groups:\n        if len(group) == 3:\n            # Perform a right rotation to reverse the left rotation.\n            decoded_groups.append(group[-1] + group[:-1])\n        else:\n            # Groups shorter than 3 were not modified, so keep them as is.\n            decoded_groups.append(group)\n\n    return \"\".join(decoded_groups)"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    Checks if there are three distinct elements in the list that sum to zero.\n    Returns True if such a triplet exists, False otherwise.\n    \"\"\"\n    n = len(l)\n    if n < 3:\n        return False\n\n    l.sort()  # Sort the list to use the two-pointer approach effectively.\n\n    for i in range(n - 2):\n        left = i + 1\n        right = n - 1\n        while left < right:\n            current_sum = l[i] + l[left] + l[right]\n            if current_sum == 0:\n                return True\n            elif current_sum < 0:\n                left += 1\n            else:\n                right -= 1\n    return False"}
{"task_id": "HumanEval/40", "solution": "def triples_sum_to_zero(l: list):\n    \"\"\"\n    Checks if there are three distinct elements in the list that sum to zero.\n    It sorts the list and uses a two-pointer approach to find such a triplet efficiently.\n    \"\"\"\n    nums = sorted(l)\n    n = len(nums)\n\n    if n < 3:\n        return False\n\n    for i in range(n - 2):\n        left = i + 1\n        right = n - 1\n\n        while left < right:\n            current_sum = nums[i] + nums[left] + nums[right]\n\n            if current_sum == 0:\n                return True\n            elif current_sum < 0:\n                left += 1\n            else:  # current_sum > 0\n                right -= 1\n\n    return False"}
