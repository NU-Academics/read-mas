{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\n    >>> common([1, 4, 3, 34, 653, 2, 5], [5, 7, 1, 5, 9, 653, 121])\n    [1, 5, 653]\n    >>> common([5, 3, 2, 8], [3, 2])\n    [2, 3]\n    \"\"\"\n    # Fast path: use sets for hashable elements\n    try:\n        s1 = set(l1)\n        s2 = set(l2)\n        common_elements = list(s1 & s2)\n    except TypeError:\n        # Fallback for unhashable elements (e.g., lists, dicts)\n        common_elements = []\n        for a in l1:\n            # skip if already recorded\n            if any(a == x for x in common_elements):\n                continue\n            for b in l2:\n                try:\n                    if a == b:\n                        common_elements.append(a)\n                        break\n                except Exception:\n                    # If equality comparison fails, ignore that pair\n                    continue\n\n    # Try to return a sorted list; handle unorderable/mixed-type elements gracefully\n    try:\n        return sorted(common_elements)\n    except TypeError:\n        # Deterministic fallback: sort by type name then string representation\n        try:\n            return sorted(common_elements, key=lambda x: (type(x).__name__, str(x)))\n        except Exception:\n            # Last resort: preserve first-seen order with uniqueness\n            unique = []\n            for x in common_elements:\n                if not any(x == y for y in unique):\n                    unique.append(x)\n            return unique"}
{"task_id": "HumanEval/57", "solution": "def monotonic(l: list):\n    \"\"\"Return True if list elements are monotonically increasing or decreasing.\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    \"\"\"\n    if len(l) < 2:\n        return True\n\n    is_non_decreasing = True\n    is_non_increasing = True\n\n    for i in range(1, len(l)):\n        if l[i] > l[i - 1]:\n            is_non_increasing = False\n        elif l[i] < l[i - 1]:\n            is_non_decreasing = False\n\n        if not is_non_decreasing and not is_non_increasing:\n            return False\n\n    return is_non_decreasing or is_non_increasing"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n.\n    Assumes n > 1 and handles both non-prime and prime inputs correctly.\n    \"\"\"\n    largest_prime = 1\n\n    # Divide by 2 until n is odd, updating largest_prime if 2 is a factor.\n    while n % 2 == 0:\n        largest_prime = 2\n        n //= 2\n\n    # Check for odd factors from 3 up to the square root of n.\n    d = 3\n    while d * d <= n:\n        while n % d == 0:\n            largest_prime = d\n            n //= d\n        d += 2\n\n    # If n is still greater than 1, it must be the largest prime factor itself.\n    if n > 1:\n        largest_prime = n\n\n    return largest_prime"}
{"task_id": "HumanEval/60", "solution": "def sum_to_n(n: int) -> int:\n    \"\"\"sum_to_n is a function that sums numbers from 1 to n.\n    >>> sum_to_n(30)\n    465\n    >>> sum_to_n(100)\n    5050\n    >>> sum_to_n(5)\n    15\n    >>> sum_to_n(10)\n    55\n    >>> sum_to_n(1)\n    1\n    \"\"\"\n    return n * (n + 1) // 2"}
{"task_id": "HumanEval/59", "solution": "def largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    largest_factor = 1\n\n    while n % 2 == 0:\n        largest_factor = 2\n        n //= 2\n\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            largest_factor = i\n            while n % i == 0:\n                n //= i\n        i += 2\n\n    if n > 1:\n        largest_factor = n\n\n    return largest_factor"}
