{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Write a function that takes a string and returns an ordered version of it.\n    Ordered version of string, is a string where all words (separated by space)\n    are replaced by a new word where all the characters arranged in\n    ascending order based on ascii value.\n    \"\"\"\n    if not s:\n        return ''\n\n    result_parts = []\n    i = 0\n    n = len(s)\n\n    while i < n:\n        if s[i] == ' ':\n            j = i\n            while j < n and s[j] == ' ':\n                j += 1\n            result_parts.append(s[i:j])\n            i = j\n        else:\n            j = i\n            while j < n and s[j] != ' ':\n                j += 1\n            word = s[i:j]\n            sorted_word = ''.join(sorted(word))\n            result_parts.append(sorted_word)\n            i = j\n\n    return ''.join(result_parts)"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Sorts an array of non-negative integers based on the sum of its first and last elements.\n    Returns a new list, sorted ascending if the sum is odd, or descending if the sum is even.\n    \"\"\"\n    if not array:\n        return []\n\n    s = array[0] + array[-1]\n\n    if s % 2 == 1:\n        return sorted(array)\n    else:\n        return sorted(array, reverse=True)"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string by shifting alphabetic characters down by 4 places, wrapping around the alphabet.\n    Non-alphabetic characters remain unchanged, and case is preserved.\"\"\"\n    result = []\n    shift = 4\n    for char in s:\n        if 'a' <= char <= 'z':\n            # Handle lowercase letters\n            result.append(chr(((ord(char) - ord('a')) + shift) % 26 + ord('a')))\n        elif 'A' <= char <= 'Z':\n            # Handle uppercase letters\n            result.append(chr(((ord(char) - ord('A')) + shift) % 26 + ord('A')))\n        else:\n            # Non-alphabetic characters are unchanged\n            result.append(char)\n    return \"\".join(result)"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Find all occurrences of x in a jagged 2D list `lst` and return their\n    coordinates as a list of (row, col) tuples. Coordinates are sorted by\n    row ascending and by column descending within each row.\n    \"\"\"\n    found_coordinates = []\n    for r_idx, row in enumerate(lst):\n        for c_idx, val in enumerate(row):\n            if val == x:\n                found_coordinates.append((r_idx, c_idx))\n\n    found_coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n    return found_coordinates"}
