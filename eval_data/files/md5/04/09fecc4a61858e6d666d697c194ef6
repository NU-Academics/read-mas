{"task_id": "HumanEval/30", "solution": "def get_positive(l: list):\n    \"\"\"Return only positive numbers in the list.\n    >>> get_positive([-1, 2, -4, 5, 6])\n    [2, 5, 6]\n    >>> get_positive([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    [5, 3, 2, 3, 9, 123, 1]\n    \"\"\"\n    result = []\n    for item in l:\n        # Include item if it's an int or float, not a boolean, and greater than 0.\n        if isinstance(item, (int, float)) and not isinstance(item, bool) and item > 0:\n            result.append(item)\n    return result"}
{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    \"\"\"\n    # Only integers > 1 can be prime. Exclude booleans which are subclasses of int.\n    if not isinstance(n, int) or isinstance(n, bool):\n        return False\n    if n <= 1:\n        return False\n    if n <= 3:\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True"}
{"task_id": "HumanEval/31", "solution": "def is_prime(n):\n    \"\"\"Return true if a given number is prime, and false otherwise.\n    >>> is_prime(6)\n    False\n    >>> is_prime(101)\n    True\n    >>> is_prime(11)\n    True\n    >>> is_prime(13441)\n    True\n    >>> is_prime(61)\n    True\n    >>> is_prime(4)\n    False\n    >>> is_prime(1)\n    False\n    \"\"\"\n    if n <= 1:\n        return False\n    if n <= 3:  # 2 and 3 are prime\n        return True\n    if n % 2 == 0 or n % 3 == 0:\n        return False\n\n    i = 5\n    while i * i <= n:\n        if n % i == 0 or n % (i + 2) == 0:\n            return False\n        i += 6\n    return True"}
{"task_id": "HumanEval/32", "solution": "import math\nfrom typing import List\ndef poly(xs: list, x: float):\n    \"\"\"\n    Evaluate a polynomial at x using Horner's method.\n\n    Coefficients xs are in increasing order:\n      P(x) = xs[0] + xs[1]*x + xs[2]*x^2 + ... + xs[n]*x^n\n\n    Args:\n        xs: list of numeric coefficients (length >= 1).\n        x: point at which to evaluate the polynomial.\n\n    Returns:\n        The polynomial value P(x) as a float.\n\n    Raises:\n        ValueError: if xs is empty or contains non-numeric entries.\n    \"\"\"\n    if not isinstance(xs, list):\n        raise ValueError(\"xs must be a list of coefficients\")\n    if len(xs) == 0:\n        raise ValueError(\"xs must be non-empty\")\n\n    # Convert and validate coefficients to floats\n    try:\n        # We keep original list unchanged; create a sequence of floats\n        coeffs = [float(c) for c in xs]\n    except Exception as e:\n        raise ValueError(\"All coefficients in xs must be numeric\") from e\n\n    # Horner's method: start from highest-degree coefficient\n    res = coeffs[-1]\n    for coef in reversed(coeffs[:-1]):\n        res = res * x + coef\n    return float(res)\ndef find_zero(xs: list):\n    \"\"\"\n    Find and return a single real root of the polynomial defined by coefficients xs.\n\n    - Coefficients xs are in increasing order:\n        P(x) = xs[0] + xs[1]*x + ... + xs[n]*x^n\n    - This function expects xs to have an even number of coefficients (so the degree n is odd),\n      and the polynomial's leading coefficient (after trimming trailing zero coefficients) must be non-zero.\n    - The algorithm:\n        1. Validate and trim trailing zeros.\n        2. Ensure the trimmed coefficient list length is even (odd degree).\n        3. Find an interval [-R, R] where P(-R) and P(R) have opposite signs by exponential expansion.\n        4. Use the bisection method on that interval until the absolute function value or interval width\n           meets the tolerance.\n\n    Args:\n        xs: list of numeric coefficients.\n\n    Returns:\n        A float x such that P(x) is approximately 0.\n\n    Raises:\n        ValueError: for invalid input (empty list, non-numeric coefficients, zero polynomial),\n                    or if the preconditions (even number of coefficients after trimming) are not met,\n                    or if a bracketing interval cannot be found within limits.\n    Examples:\n        >>> round(find_zero([1, 2]), 2)   # f(x) = 1 + 2x\n        -0.5\n        >>> round(find_zero([-6, 11, -6, 1]), 2)  # (x-1)*(x-2)*(x-3)\n        1.0\n    \"\"\"\n    # Basic validation\n    if not isinstance(xs, list):\n        raise ValueError(\"xs must be a list of coefficients\")\n    if len(xs) == 0:\n        raise ValueError(\"xs must be non-empty\")\n\n    # Convert to floats and validate\n    try:\n        coeffs = [float(c) for c in xs]\n    except Exception as e:\n        raise ValueError(\"All coefficients in xs must be numeric\") from e\n\n    # Trim trailing zeros (highest-degree zero coefficients)\n    # Keep at least one coefficient (to detect zero polynomial).\n    while len(coeffs) > 1 and coeffs[-1] == 0.0:\n        coeffs.pop()\n\n    # After trimming, check for zero polynomial\n    if len(coeffs) == 1 and coeffs[0] == 0.0:\n        raise ValueError(\"Zero polynomial: infinitely many roots\")\n\n    # Ensure leading coefficient is non-zero\n    if coeffs[-1] == 0.0:\n        raise ValueError(\"Leading coefficient is zero after trimming; invalid input\")\n\n    # The problem states find_zero will be called only with even number of coefficients\n    # (so degree is odd). Enforce this precondition.\n    if len(coeffs) % 2 != 0:\n        raise ValueError(\n            \"find_zero requires an even number of coefficients (so polynomial degree is odd) after trimming\"\n        )\n\n    # Function to evaluate polynomial using Horner (reuse poly)\n    def f(x_val: float) -> float:\n        return poly(coeffs, x_val)\n\n    # Bisection parameters\n    abs_tol = 1e-12  # absolute tolerance on function value\n    rel_tol = 1e-12  # relative tolerance on interval width\n    max_bisect_iter = 200\n    max_expansions = 200\n\n    # Bracketing: start with [-1, 1] and expand exponentially until sign change\n    scale = 1.0\n    a = -scale\n    b = scale\n    fa = f(a)\n    if math.isfinite(fa) and abs(fa) <= abs_tol:\n        return a\n    fb = f(b)\n    if math.isfinite(fb) and abs(fb) <= abs_tol:\n        return b\n\n    expansions = 0\n    # For odd-degree polynomials, as x->-inf and x->inf, signs will differ, so expansion should succeed\n    while fa * fb > 0:\n        expansions += 1\n        if expansions > max_expansions:\n            raise ValueError(\"Failed to bracket a root after many expansions\")\n        scale *= 2.0\n        a = -scale\n        b = scale\n        fa = f(a)\n        if math.isfinite(fa) and abs(fa) <= abs_tol:\n            return a\n        fb = f(b)\n        if math.isfinite(fb) and abs(fb) <= abs_tol:\n            return b\n        # Safety: avoid overflow\n        if not (math.isfinite(a) and math.isfinite(b)):\n            raise ValueError(\"Interval expansion overflowed before bracketing a root\")\n\n    # Bisection loop\n    low, high = a, b\n    f_low, f_high = fa, fb\n    for _ in range(max_bisect_iter):\n        mid = (low + high) / 2.0\n        f_mid = f(mid)\n\n        # If function value is NaN/inf, abort\n        if not math.isfinite(f_mid):\n            raise ValueError(\"Non-finite polynomial evaluation encountered during bisection\")\n\n        # Check convergence by function value\n        if abs(f_mid) <= abs_tol:\n            return mid\n\n        # Check convergence by interval width\n        if abs(high - low) <= max(abs(low), abs(high), 1.0) * rel_tol:\n            return mid\n\n        # Narrow interval\n        if f_low * f_mid <= 0:\n            high = mid\n            f_high = f_mid\n        else:\n            low = mid\n            f_low = f_mid\n\n    # If we exit loop without meeting tolerances, return midpoint as best estimate\n    return (low + high) / 2.0"}
