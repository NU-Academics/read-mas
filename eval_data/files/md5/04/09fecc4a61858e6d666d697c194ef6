{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Checks if the number is a product of exactly three prime numbers, counting multiplicity.\"\"\"\n    if not isinstance(a, int) or a < 2:\n        return False\n    n = a\n    count = 0\n    p = 2\n    while p * p <= n:\n        while n % p == 0:\n            count += 1\n            n //= p\n            if count > 3:\n                return False\n        p += 1 if p == 2 else 2\n    if n > 1:\n        count += 1\n    return count == 3"}
{"task_id": "HumanEval/83", "solution": "def starts_one_ends(n):\n    \"\"\"\n    Given a positive integer n, return the count of n-digit positive integers\n    that start or end with 1.\n    \"\"\"\n    if n == 1:\n        return 1\n    else:\n        # For n > 1, the count is the sum of numbers starting with 1 and numbers ending with 1,\n        # minus numbers that both start and end with 1 (inclusion-exclusion principle).\n        # This simplifies to 18 * 10^(n-2).\n        return 18 * (10**(n - 2))"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Given an array arr of integers, find the minimum number of elements that\n    need to be changed to make the array palindromic. A palindromic array is an array that\n    is read the same backwards and forwards. In one change, you can change one element to any other element.\n    \"\"\"\n    changes = 0\n    left, right = 0, len(arr) - 1\n    while left < right:\n        if arr[left] != arr[right]:\n            changes += 1\n        left += 1\n        right -= 1\n    return changes"}
{"task_id": "HumanEval/73", "solution": "def smallest_change(arr):\n    \"\"\"\n    Calculates the minimum number of element changes required to make the array palindromic.\n    \"\"\"\n    n = len(arr)\n    changes = 0\n    for i in range(n // 2):\n        if arr[i] != arr[n - 1 - i]:\n            changes += 1\n    return changes"}
{"task_id": "HumanEval/54", "solution": "def same_chars(s0: str, s1: str):\n    \"\"\"\n    Check if two words have the same characters.\n    >>> same_chars('eabcdzzzz', 'dddzzzzzzzddeddabc')\n    True\n    >>> same_chars('abcd', 'dddddddabc')\n    True\n    >>> same_chars('dddddddabc', 'abcd')\n    True\n    >>> same_chars('eabcd', 'dddddddabc')\n    False\n    >>> same_chars('abcd', 'dddddddabce')\n    False\n    >>> same_chars('eabcdzzzz', 'dddzzzzzzzddddabc')\n    False\n    \"\"\"\n    return set(s0) == set(s1)"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting.\n    Sort ascending if the sum of the first and last elements is odd, otherwise sort descending.\n    The original array is not modified.\n\n    Examples:\n    * sort_array([]) => []\n    * sort_array([5]) => [5]\n    * sort_array([2, 4, 3, 0, 1, 5]) => [0, 1, 2, 3, 4, 5]\n    * sort_array([2, 4, 3, 0, 1, 5, 6]) => [6, 5, 4, 3, 2, 1, 0]\n    \"\"\"\n    # Return a new list for empty input\n    if not array:\n        return []\n\n    total = array[0] + array[-1]\n    if total % 2 == 1:  # odd -> ascending\n        return sorted(array)\n    else:  # even -> descending\n        return sorted(array, reverse=True)"}
{"task_id": "HumanEval/89", "solution": "def encrypt(s):\n    \"\"\"Encrypts a string using a Caesar cipher, shifting letters forward by 4 positions.\n    Case and non-letter characters are preserved.\"\"\"\n    result_chars = []\n    for c in s:\n        if 'a' <= c <= 'z':\n            # Calculate shifted ordinal for lowercase letters\n            shifted_ord = ((ord(c) - ord('a') + 4) % 26) + ord('a')\n            result_chars.append(chr(shifted_ord))\n        elif 'A' <= c <= 'Z':\n            # Calculate shifted ordinal for uppercase letters\n            shifted_ord = ((ord(c) - ord('A') + 4) % 26) + ord('A')\n            result_chars.append(chr(shifted_ord))\n        else:\n            # Preserve non-letter characters\n            result_chars.append(c)\n    return \"\".join(result_chars)"}
{"task_id": "HumanEval/90", "solution": "def next_smallest(lst):\n    \"\"\"\n    Returns the second smallest distinct element in a list of integers.\n    Returns None if there are fewer than two distinct elements.\n    \"\"\"\n    distinct_elements = sorted(list(set(lst)))\n\n    if len(distinct_elements) >= 2:\n        return distinct_elements[1]\n    else:\n        return None"}
{"task_id": "HumanEval/110", "solution": "def exchange(lst1, lst2):\n    \"\"\"Determines if lst1 can become all even by exchanging elements with lst2.\"\"\"\n    odd_elements_in_lst1 = sum(1 for x in lst1 if x % 2 != 0)\n    even_elements_in_lst2 = sum(1 for x in lst2 if x % 2 == 0)\n\n    if odd_elements_in_lst1 <= even_elements_in_lst2:\n        return \"YES\"\n    else:\n        return \"NO\""}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Encode a message by swapping the case of all letters and replacing vowels\n    with the letter two places ahead in the English alphabet (a->c, e->g, i->k, o->q, u->w).\n    Non-letter characters are preserved.\n    \"\"\"\n    vowels = set('aeiou')\n    result = []\n\n    for ch in message:\n        if ch.isalpha():\n            is_lower = ch.islower()\n            base = ch.lower()\n            if base in vowels:\n                # shift vowel two places ahead with wrap\n                shifted_ord = (ord(base) - ord('a') + 2) % 26 + ord('a')\n                shifted = chr(shifted_ord)\n            else:\n                shifted = base\n            # swap case relative to original character\n            result.append(shifted.upper() if is_lower else shifted.lower())\n        else:\n            result.append(ch)\n\n    return ''.join(result)"}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Calculates the sum of magnitudes multiplied by the product of signs of numbers in the array.\n    Returns None for an empty array.\n    \"\"\"\n    if not arr:\n        return None\n\n    product_of_signs = 1\n    sum_of_magnitudes = 0\n\n    for num in arr:\n        if num == 0:\n            product_of_signs = 0\n            # If any number is 0, the product of signs is 0, so we can short-circuit.\n            # We still need to calculate the sum of magnitudes for all numbers.\n        elif num < 0:\n            product_of_signs *= -1\n        # If num > 0, product_of_signs remains unchanged.\n\n        sum_of_magnitudes += abs(num)\n\n    return sum_of_magnitudes * product_of_signs"}
{"task_id": "HumanEval/128", "solution": "def prod_signs(arr):\n    \"\"\"\n    Calculates the sum of magnitudes of integers multiplied by the product of their signs.\n    Returns None for an empty array, and 0 if any number in the array is zero.\n    \"\"\"\n    if not arr:\n        return None\n\n    sign_product = 1\n    magnitude_sum = 0\n\n    for num in arr:\n        if num == 0:\n            return 0\n        elif num < 0:\n            sign_product *= -1\n\n        magnitude_sum += abs(num)\n\n    return magnitude_sum * sign_product"}
{"task_id": "HumanEval/118", "solution": "def get_closest_vowel(word):\n    \"\"\"Finds the closest vowel from the right surrounded by consonants, excluding word ends.\n    Returns the vowel if found, otherwise an empty string.\n    \"\"\"\n    vowels = {'a', 'e', 'i', 'o', 'u', 'A', 'E', 'I', 'O', 'U'}\n\n    # Iterate from the second-to-last character down to the second character (index 1).\n    # This ensures there are characters at word[i-1] and word[i+1].\n    for i in range(len(word) - 2, 0, -1):\n        char = word[i]\n        if char in vowels:\n            # Check if both preceding and succeeding characters are consonants.\n            if word[i - 1] not in vowels and word[i + 1] not in vowels:\n                return char\n\n    return \"\""}
{"task_id": "HumanEval/132", "solution": "def is_nested(string):\n    \"\"\"\n    Checks if a string containing only square brackets has a nested balanced subsequence.\n    A nested subsequence requires at least one opening bracket to be preceded by another opening bracket\n    and followed by at least two closing brackets.\n    \"\"\"\n    n = len(string)\n    if n < 4:\n        return False\n\n    # Compute prefix_open_before[j]: number of '[' strictly before index j.\n    prefix_open_before = [0] * n\n    open_count = 0\n    for i in range(n):\n        prefix_open_before[i] = open_count\n        if string[i] == '[':\n            open_count += 1\n\n    # Compute suffix_close_after[j]: number of ']' strictly after index j.\n    suffix_close_after = [0] * n\n    close_count = 0\n    for i in range(n - 1, -1, -1):\n        suffix_close_after[i] = close_count\n        if string[i] == ']':\n            close_count += 1\n\n    # For each index j where string[j]=='[', check the condition.\n    for j in range(n):\n        if string[j] == '[':\n            if prefix_open_before[j] >= 1 and suffix_close_after[j] >= 2:\n                return True\n\n    return False"}
{"task_id": "HumanEval/140", "solution": "import re\ndef fix_spaces(text):\n    \"\"\"\n    Given a string text, replace all spaces in it with underscores,\n    and if a string has more than 2 consecutive spaces (3 or more),\n    replace that entire consecutive run with a single hyphen '-'.\n    \"\"\"\n    # Replace sequences of 3 or more spaces with a single hyphen\n    text = re.sub(r' {3,}', '-', text)\n    # Replace remaining single spaces with underscores\n    return text.replace(' ', '_')"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Calculates the total eaten carrots and remaining stock after a meal.\n    The rabbit eats up to 'need' carrots from 'remaining' stock.\n    \"\"\"\n    carrots_to_take = min(need, remaining)\n    total_eaten = number + carrots_to_take\n    carrots_left = remaining - carrots_to_take\n    return [total_eaten, carrots_left]"}
{"task_id": "HumanEval/141", "solution": "import string\ndef file_name_check(file_name):\n    \"\"\"\n    Checks if a file's name is valid based on specific criteria.\n    Returns 'Yes' for valid names, 'No' otherwise.\n    \"\"\"\n    # 1. Verify input is a string.\n    if not isinstance(file_name, str):\n        return 'No'\n\n    # 2. Ensure there is exactly one dot '.' in the file_name.\n    if file_name.count('.') != 1:\n        return 'No'\n\n    # 3. Count digits in the entire file_name; must be <= 3.\n    if sum(c.isdigit() for c in file_name) > 3:\n        return 'No'\n\n    # 4. Split into name and extension at the dot (first occurrence).\n    name, ext = file_name.split('.', 1)\n    if not name:  # name should not be empty\n        return 'No'\n\n    # 5. Ensure the first character of name is a latin letter (a-z or A-Z).\n    if name[0] not in string.ascii_letters:\n        return 'No'\n\n    # 6. Ensure the extension (case-insensitive) is one of {'txt','exe','dll'}.\n    if ext.lower() not in {'txt', 'exe', 'dll'}:\n        return 'No'\n\n    return 'Yes'"}
{"task_id": "HumanEval/144", "solution": "import math\ndef simplify(x, n):\n    \"\"\"Checks if the product of two fractions x and n is a whole number.\n    Returns True if x * n is a whole number, False otherwise.\n    \"\"\"\n    # Parse input strings into numerators and denominators (a/b and c/d).\n    a, b = map(int, x.split('/'))\n    c, d = map(int, n.split('/'))\n\n    # Reduce each fraction to its lowest terms.\n    g1 = math.gcd(a, b)\n    a //= g1\n    b //= g1\n\n    g2 = math.gcd(c, d)\n    c //= g2\n    d //= g2\n\n    # Cancel cross common factors between numerators and opposite denominators.\n    g3 = math.gcd(a, d)\n    a //= g3\n    d //= g3\n\n    g4 = math.gcd(c, b)\n    c //= g4\n    b //= g4\n\n    # After cancellation, compute the final product's numerator and denominator.\n    final_numerator = a * c\n    final_denominator = b * d\n\n    # If the remaining denominator divides the remaining numerator exactly, the product is a whole number.\n    return final_numerator % final_denominator == 0"}
{"task_id": "HumanEval/146", "solution": "def specialFilter(nums):\n    \"\"\"\n    Counts numbers greater than 10 where both first and last digits are odd.\n    Handles negative numbers by considering their absolute value for digit extraction.\n    \"\"\"\n    count = 0\n    for num in nums:\n        if num > 10:\n            s_num = str(abs(num))\n            first_digit = int(s_num[0])\n            last_digit = int(s_num[-1])\n            if first_digit % 2 != 0 and last_digit % 2 != 0:\n                count += 1\n    return count"}
{"task_id": "HumanEval/35", "solution": "def max_element(l: list):\n    \"\"\"Return maximum element in the list.\n    >>> max_element([1, 2, 3])\n    3\n    >>> max_element([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    123\n    \"\"\"\n    if not isinstance(l, list):\n        raise TypeError(\"max_element() expected a list\")\n    if len(l) == 0:\n        raise ValueError(\"max_element() arg is an empty list\")\n\n    max_val = l[0]\n    for element in l[1:]:\n        try:\n            if element > max_val:\n                max_val = element\n        except TypeError:\n            raise TypeError(\"Elements in the list are not comparable\") from None\n    return max_val"}
{"task_id": "HumanEval/84", "solution": "def solve(N):\n    \"\"\"Calculates the sum of decimal digits of N and returns it as a binary string.\"\"\"\n    digit_sum = 0\n    for digit_char in str(N):\n        digit_sum += int(digit_char)\n    return bin(digit_sum)[2:]"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    total_sevens_count = 0\n    for i in range(1, n):\n        if i % 11 == 0 or i % 13 == 0:\n            total_sevens_count += str(i).count('7')\n    return total_sevens_count"}
{"task_id": "HumanEval/86", "solution": "import re\ndef anti_shuffle(s):\n    \"\"\"\n    Sorts characters within each word of a string based on ASCII value,\n    preserving whitespace sequence and count.\n    \"\"\"\n    tokens = re.split(r\"(\\s+)\", s)\n    result_tokens = []\n    for token in tokens:\n        if token.isspace():\n            result_tokens.append(token)\n        else:\n            result_tokens.append(\"\".join(sorted(token)))\n    return \"\".join(result_tokens)"}
