{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    \"\"\"Calculates the strength of each extension and returns the class name concatenated with the strongest extension.\n    Strength is determined by (uppercase letters - lowercase letters); the first strongest is chosen in case of a tie.\n    \"\"\"\n    strongest_extension_name = \"\"\n    max_strength = float('-inf')\n\n    for extension in extensions:\n        cap_count = 0\n        sm_count = 0\n        for char in extension:\n            if 'A' <= char <= 'Z':\n                cap_count += 1\n            elif 'a' <= char <= 'z':\n                sm_count += 1\n\n        current_strength = cap_count - sm_count\n\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = extension\n\n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"Checks if b or any of its cyclic rotations is a substring in a. Returns True if found, False otherwise.\"\"\"\n    if not isinstance(a, str) or not isinstance(b, str):\n        raise TypeError(\"Both a and b must be strings\")\n\n    m = len(b)\n\n    # Empty pattern is considered a substring of any string\n    if m == 0:\n        return True\n    # If b is longer than a, no rotation can be a substring\n    if m > len(a):\n        return False\n\n    s = b + b\n    for i in range(m):\n        if s[i:i + m] in a:\n            return True\n    return False"}
{"task_id": "HumanEval/154", "solution": "def cycpattern_check(a , b):\n    \"\"\"You are given 2 words. You need to return True if the second word b or any of its rotations is a substring in the first word a.\"\"\"\n    if not isinstance(a, str) or not isinstance(b, str):\n        raise TypeError(\"Both a and b must be strings\")\n    if b == \"\":\n        return True\n    for i in range(len(b)):\n        rotated_b = b[i:] + b[:i]\n        if rotated_b in a:\n            return True\n    return False"}
{"task_id": "HumanEval/153", "solution": "def Strongest_Extension(class_name, extensions):\n    max_strength = float('-inf')\n    strongest_extension_name = \"\"\n    for extension in extensions:\n        cap_count = sum(1 for c in extension if c.isupper())\n        sm_count = sum(1 for c in extension if c.islower())\n        current_strength = cap_count - sm_count\n        if current_strength > max_strength:\n            max_strength = current_strength\n            strongest_extension_name = extension\n    return f\"{class_name}.{strongest_extension_name}\""}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Converts a positive integer to its lowercase Roman numeral equivalent.\n    Uses a greedy mapping approach with subtractive forms.\n    \"\"\"\n    roman_map = [\n        (1000, 'M'), (900, 'CM'), (500, 'D'), (400, 'CD'),\n        (100, 'C'), (90, 'XC'), (50, 'L'), (40, 'XL'),\n        (10, 'X'), (9, 'IX'), (5, 'V'), (4, 'IV'),\n        (1, 'I')\n    ]\n\n    result = []\n    for value, numeral in roman_map:\n        while number >= value:\n            result.append(numeral)\n            number -= value\n\n    return \"\".join(result).lower()"}
{"task_id": "HumanEval/156", "solution": "def int_to_mini_roman(number):\n    \"\"\"\n    Given a positive integer (1..1000), return its Roman numeral representation as a lowercase string.\n\n    Args:\n        number (int): integer between 1 and 1000 inclusive.\n\n    Returns:\n        str: Roman numeral in lowercase.\n\n    Raises:\n        TypeError: if number is not an int.\n        ValueError: if number is outside the range 1..1000.\n    \"\"\"\n    if not isinstance(number, int):\n        raise TypeError(\"number must be an integer\")\n    if not (1 <= number <= 1000):\n        raise ValueError(\"number must be between 1 and 1000 inclusive\")\n\n    roman_map = [\n        (1000, \"M\"), (900, \"CM\"), (500, \"D\"), (400, \"CD\"),\n        (100, \"C\"), (90, \"XC\"), (50, \"L\"), (40, \"XL\"),\n        (10, \"X\"), (9, \"IX\"), (5, \"V\"), (4, \"IV\"), (1, \"I\"),\n    ]\n\n    parts = []\n    n = number\n    for value, numeral in roman_map:\n        if n == 0:\n            break\n        count = n // value\n        if count:\n            parts.append(numeral * count)\n            n -= value * count\n\n    return \"\".join(parts).lower()"}
{"task_id": "HumanEval/155", "solution": "def even_odd_count(num):\n    \"\"\"Given an integer, return a tuple with the count of even and odd digits.\n    The sign of the number is ignored.\n    \"\"\"\n    even_count = 0\n    odd_count = 0\n    # Convert to absolute string to handle negative numbers and iterate digits\n    num_str = str(abs(num))\n\n    for digit_char in num_str:\n        digit = int(digit_char)\n        if digit % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    return (even_count, odd_count)"}
{"task_id": "HumanEval/157", "solution": "def right_angle_triangle(a, b, c):\n    \"\"\"\n    Given the lengths of the three sides of a triangle, return True if the sides\n    form a right-angled triangle, False otherwise.\n    \"\"\"\n    import math\n\n    try:\n        a = float(a)\n        b = float(b)\n        c = float(c)\n    except (TypeError, ValueError):\n        return False\n\n    # All sides must be positive\n    if not (a > 0 and b > 0 and c > 0):\n        return False\n\n    # Triangle inequality: sum of any two sides must be greater than the third\n    if a + b <= c or a + c <= b or b + c <= a:\n        return False\n\n    a2 = a * a\n    b2 = b * b\n    c2 = c * c\n\n    # Use math.isclose to handle floating point imprecision\n    rel_tol = 1e-9\n    abs_tol = 1e-12\n\n    if math.isclose(a2 + b2, c2, rel_tol=rel_tol, abs_tol=abs_tol):\n        return True\n    if math.isclose(a2 + c2, b2, rel_tol=rel_tol, abs_tol=abs_tol):\n        return True\n    if math.isclose(b2 + c2, a2, rel_tol=rel_tol, abs_tol=abs_tol):\n        return True\n\n    return False"}
{"task_id": "HumanEval/159", "solution": "def eat(number, need, remaining):\n    \"\"\"\n    Computes updated carrot totals after a rabbit eats based on need and stock.\n    Returns [total_eaten_carrots, remaining_carrots_in_stock].\n    \"\"\"\n    carrots_to_eat = min(need, remaining)\n\n    total_eaten = number + carrots_to_eat\n    remaining_after = remaining - carrots_to_eat\n\n    return [total_eaten, remaining_after]"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"\n    Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n    \"\"\"\n    if not words:\n        return \"\"\n\n    max_word = words[0]\n    max_unique_count = len(set(max_word))\n\n    for word in words[1:]:\n        current_unique_count = len(set(word))\n        if current_unique_count > max_unique_count or (\n            current_unique_count == max_unique_count and word < max_word\n        ):\n            max_word = word\n            max_unique_count = current_unique_count\n\n    return max_word"}
{"task_id": "HumanEval/157", "solution": "import math\ndef right_angle_triangle(a, b, c):\n    \"\"\"\n    Given the lengths of the three sides of a triangle. Return True if the three\n    sides form a right-angled triangle, False otherwise.\n    A right-angled triangle is a triangle in which one angle is right angle or\n    90 degree.\n    Example:\n    right_angle_triangle(3, 4, 5) == True\n    right_angle_triangle(1, 2, 3) == False\n    \"\"\"\n    try:\n        fa, fb, fc = float(a), float(b), float(c)\n    except (ValueError, TypeError):\n        return False\n\n    if not (math.isfinite(fa) and fa > 0 and\n            math.isfinite(fb) and fb > 0 and\n            math.isfinite(fc) and fc > 0):\n        return False\n\n    sides = sorted([fa, fb, fc])\n    x, y, z = sides[0], sides[1], sides[2]\n\n    # triangle inequality: strict to avoid degenerate triangles\n    if not (x + y > z):\n        return False\n\n    return math.isclose(x*x + y*y, z*z, rel_tol=1e-9, abs_tol=1e-12)"}
{"task_id": "HumanEval/158", "solution": "def find_max(words):\n    \"\"\"Write a function that accepts a list of strings.\n    The list contains different words. Return the word with maximum number\n    of unique characters. If multiple strings have maximum number of unique\n    characters, return the one which comes first in lexicographical order.\n    \"\"\"\n    if not words:\n        return \"\"\n    return min(words, key=lambda w: (-len(set(w)), w))"}
{"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n    \"\"\"\n    if text == \"\":\n        return None\n    if not isinstance(text, (str, bytes)):\n        raise TypeError(\"text must be a str or bytes\")\n    if isinstance(text, str):\n        data = text.encode(\"utf-8\")\n    else:\n        data = text\n    return hashlib.md5(data).hexdigest()"}
{"task_id": "HumanEval/162", "solution": "import hashlib\ndef string_to_md5(text):\n    \"\"\"\n    Given a string 'text', return its md5 hash equivalent string.\n    If 'text' is an empty string, return None.\n\n    >>> string_to_md5('Hello world') == '3e25960a79dbc69b674cd4ec67a72c62'\n    \"\"\"\n    if not isinstance(text, str):\n        raise TypeError(\"text must be a str\")\n    if text == \"\":\n        return None\n    return hashlib.md5(text.encode(\"utf-8\")).hexdigest()"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"Reverses the case of letters in a string, or reverses the entire string if no letters are present.\n    Non-letter characters remain unchanged unless the string is fully reversed.\n    \"\"\"\n    modified_chars = []\n    has_letters = False\n    for char in s:\n        if char.isalpha():\n            has_letters = True\n            if char.islower():\n                modified_chars.append(char.upper())\n            else:\n                modified_chars.append(char.lower())\n        else:\n            modified_chars.append(char)\n\n    if not has_letters:\n        return s[::-1]\n    else:\n        return \"\".join(modified_chars)"}
{"task_id": "HumanEval/161", "solution": "def solve(s):\n    \"\"\"Reverses the case of letters in a string, or reverses the whole string if no letters are present.\"\"\"\n    modified_chars = []\n    has_letters = False\n    for char in s:\n        if 'a' <= char <= 'z':\n            modified_chars.append(chr(ord(char) - 32))  # Convert lowercase to uppercase\n            has_letters = True\n        elif 'A' <= char <= 'Z':\n            modified_chars.append(chr(ord(char) + 32))  # Convert uppercase to lowercase\n            has_letters = True\n        else:\n            modified_chars.append(char)\n\n    if not has_letters:\n        return s[::-1]\n    else:\n        return \"\".join(modified_chars)"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Build and evaluate an algebraic expression from operator and operand lists.\n\n    operator: list of operator strings ('+', '-', '*', '//', '**')\n    operand: list of integers\n\n    Returns: integer result of the expression.\n\n    Raises:\n      ValueError: for invalid input shapes or values\n      ZeroDivisionError: for floor-division by zero during evaluation\n    \"\"\"\n    # Validation\n    if not isinstance(operator, list) or not isinstance(operand, list):\n        raise ValueError(\"operator and operand must be lists\")\n    if len(operand) < 2:\n        raise ValueError(\"operand list must contain at least two elements\")\n    if len(operator) != len(operand) - 1:\n        raise ValueError(\"Length of operator must be length of operand minus one\")\n\n    allowed_ops = {'+', '-', '*', '//', '**'}\n    for op in operator:\n        if op not in allowed_ops:\n            raise ValueError(f\"Invalid operator '{op}'. Allowed operators: {sorted(allowed_ops)}\")\n    for i, val in enumerate(operand):\n        if not isinstance(val, int):\n            raise ValueError(f\"Operand at index {i} is not an int: {val!r}\")\n\n    # Precedence and associativity\n    precedence = {'**': 3, '*': 2, '//': 2, '+': 1, '-': 1}\n    associativity = {'**': 'right', '*': 'left', '//': 'left', '+': 'left', '-': 'left'}\n\n    # Tokenize: interleave operands and operators -> [operand0, op0, operand1, op1, ...]\n    tokens = []\n    for i, op in enumerate(operator):\n        tokens.append(operand[i])\n        tokens.append(op)\n    tokens.append(operand[-1])\n\n    # Shunting-yard: convert infix tokens to RPN (output_queue)\n    output_queue = []\n    op_stack = []\n\n    for token in tokens:\n        if isinstance(token, str) and token in precedence:\n            o1 = token\n            while op_stack:\n                o2 = op_stack[-1]\n                # o2 should always be an operator string here\n                if not (isinstance(o2, str) and o2 in precedence):\n                    break\n                p1, p2 = precedence[o1], precedence[o2]\n                assoc1 = associativity[o1]\n                if (assoc1 == 'left' and p1 <= p2) or (assoc1 == 'right' and p1 < p2):\n                    output_queue.append(op_stack.pop())\n                else:\n                    break\n            op_stack.append(o1)\n        else:\n            # token must be an operand (int)\n            output_queue.append(token)\n\n    while op_stack:\n        output_queue.append(op_stack.pop())\n\n    # Evaluate RPN\n    eval_stack = []\n    for token in output_queue:\n        if isinstance(token, str) and token in precedence:\n            if len(eval_stack) < 2:\n                raise ValueError(\"Invalid expression: insufficient values in evaluation stack\")\n            rhs = eval_stack.pop()\n            lhs = eval_stack.pop()\n            if token == '+':\n                res = lhs + rhs\n            elif token == '-':\n                res = lhs - rhs\n            elif token == '*':\n                res = lhs * rhs\n            elif token == '//':\n                if rhs == 0:\n                    raise ZeroDivisionError(\"integer division or modulo by zero\")\n                # Python's // already does floor division for ints\n                res = lhs // rhs\n            elif token == '**':\n                res = lhs ** rhs\n            eval_stack.append(res)\n        else:\n            eval_stack.append(token)\n\n    if len(eval_stack) != 1:\n        raise ValueError(\"Invalid expression: evaluation did not result in a single value\")\n\n    return eval_stack[0]"}
{"task_id": "HumanEval/160", "solution": "def do_algebra(operator, operand):\n    \"\"\"\n    Given two lists operator, and operand. The first list has basic algebra operations, and\n    the second list is a list of integers. Use the two given lists to build the algebric\n    expression and return the evaluation of this expression.\n    \"\"\"\n    # Validate inputs\n    if not isinstance(operator, (list, tuple)):\n        raise ValueError(\"operator must be a list or tuple\")\n    if not isinstance(operand, (list, tuple)):\n        raise ValueError(\"operand must be a list or tuple\")\n    if len(operand) < 2:\n        raise ValueError(\"operand must contain at least two elements\")\n    if len(operator) != len(operand) - 1:\n        raise ValueError(\"operator length must be len(operand) - 1\")\n\n    valid_ops = {'+', '-', '*', '//', '**'}\n    for op in operator:\n        if op not in valid_ops:\n            raise ValueError(f\"invalid operator: {op}\")\n    for val in operand:\n        if not isinstance(val, int) or val < 0:\n            raise ValueError(\"operands must be non-negative integers\")\n\n    precedence = {'+': 1, '-': 1, '*': 2, '//': 2, '**': 3}\n    associativity = {'+': 'left', '-': 'left', '*': 'left', '//': 'left', '**': 'right'}\n\n    # Build interleaved token list: [operand0, operator0, operand1, operator1, operand2, ...]\n    tokens = [operand[0]]\n    for i in range(len(operator)):\n        tokens.append(operator[i])\n        tokens.append(operand[i + 1])\n\n    output_queue = []\n    op_stack = []\n\n    # Shunting-Yard algorithm to convert to RPN\n    for token in tokens:\n        if token in precedence:  # operator\n            o1 = token\n            while op_stack and op_stack[-1] in precedence:\n                o2 = op_stack[-1]\n                if (associativity[o1] == 'left' and precedence[o1] <= precedence[o2]) or \\\n                   (associativity[o1] == 'right' and precedence[o1] < precedence[o2]):\n                    output_queue.append(op_stack.pop())\n                else:\n                    break\n            op_stack.append(o1)\n        else:  # operand\n            output_queue.append(token)\n\n    while op_stack:\n        output_queue.append(op_stack.pop())\n\n    # Evaluate RPN\n    eval_stack = []\n    for token in output_queue:\n        if token in precedence:\n            if len(eval_stack) < 2:\n                raise RuntimeError(\"invalid expression\")\n            b = eval_stack.pop()\n            a = eval_stack.pop()\n            if token == '+':\n                res = a + b\n            elif token == '-':\n                res = a - b\n            elif token == '*':\n                res = a * b\n            elif token == '//':\n                res = a // b\n            elif token == '**':\n                res = a ** b\n            eval_stack.append(res)\n        else:\n            eval_stack.append(token)\n\n    if len(eval_stack) != 1:\n        raise RuntimeError(\"invalid evaluation state\")\n    return eval_stack[0]"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Returns even integers between a and b (inclusive), in ascending order.\n    The order of a and b does not affect the range.\n    \"\"\"\n    start = min(a, b)\n    end = max(a, b)\n    result = []\n    for i in range(start, end + 1):\n        if i % 2 == 0:\n            result.append(i)\n    return result"}
{"task_id": "HumanEval/163", "solution": "def generate_integers(a, b):\n    \"\"\"\n    Given two positive integers a and b, return the even digits between a and b (inclusive),\n    in ascending order. The function treats 'even digits' as the single-digit even numbers\n    {0, 2, 4, 6, 8}. If a > b, the range is considered from min(a, b) to max(a, b).\n\n    Raises:\n        ValueError: if a or b is not an integer or is not positive.\n    \"\"\"\n    def _is_int_non_bool(x):\n        return isinstance(x, int) and not isinstance(x, bool)\n\n    if not _is_int_non_bool(a) or not _is_int_non_bool(b):\n        raise ValueError(\"a and b must be integers\")\n    if a <= 0 or b <= 0:\n        raise ValueError(\"a and b must be positive integers\")\n\n    lo, hi = min(a, b), max(a, b)\n    even_digits = [0, 2, 4, 6, 8]\n\n    return [d for d in even_digits if lo <= d <= hi]"}
{"task_id": "HumanEval/29", "solution": "from typing import List\ndef filter_by_prefix(strings: List[str], prefix: str) -> List[str]:\n    \"\"\" Filter an input list of strings only for ones that start with a given prefix.\n    >>> filter_by_prefix([], 'a')\n    []\n    >>> filter_by_prefix(['abc', 'bcd', 'cde', 'array'], 'a')\n    ['abc', 'array']\n    \"\"\"\n    result: List[str] = []\n    for s in strings:\n        if s.startswith(prefix):\n            result.append(s)\n    return result"}
{"task_id": "HumanEval/26", "solution": "def remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    >>> remove_duplicates([1, 2, 3, 2, 4])\n    [1, 3, 4]\n    \"\"\"\n    counts = {}\n    for num in numbers:\n        counts[num] = counts.get(num, 0) + 1\n    return [num for num in numbers if counts[num] == 1]"}
{"task_id": "HumanEval/18", "solution": "def how_many_times(string: str, substring: str) -> int:\n    \"\"\" Find how many times a given substring can be found in the original string. Count overlapping cases.\n    >>> how_many_times('', 'a')\n    0\n    >>> how_many_times('aaa', 'a')\n    3\n    >>> how_many_times('aaaa', 'aa')\n    3\n    \"\"\"\n    if not substring:\n        return 0\n\n    count = 0\n    start = 0\n    while True:\n        pos = string.find(substring, start)\n        if pos == -1:\n            break\n        count += 1\n        start = pos + 1  # advance one position after the found occurrence to allow overlaps\n    return count"}
{"task_id": "HumanEval/8", "solution": "from typing import List, Tuple\ndef sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    \"\"\"\n    sum_accumulator = 0\n    product_accumulator = 1\n\n    for number in numbers:\n        sum_accumulator += number\n        product_accumulator *= number\n\n    return (sum_accumulator, product_accumulator)"}
{"task_id": "HumanEval/6", "solution": "def parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\"Input is a string containing multiple groups of parentheses separated by whitespace.\n    For each group, return the deepest level of nesting of parentheses.\n\n    Behavior:\n    - Groups are split on any whitespace. Extra whitespace is ignored.\n    - Empty input -> returns [].\n    - If a group contains any character other than '(' or ')', raises ValueError.\n    - If parentheses in a group are unbalanced (more closing or more opening), raises ValueError.\n\n    Example:\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    results: List[int] = []\n\n    # Split on any whitespace to handle extra spaces/tabs/newlines\n    groups = paren_string.split()\n    if not groups:\n        return results\n\n    for idx, group in enumerate(groups, start=1):\n        current_depth = 0\n        max_depth = 0\n\n        for pos, ch in enumerate(group, start=1):\n            if ch == '(':\n                current_depth += 1\n                if current_depth > max_depth:\n                    max_depth = current_depth\n            elif ch == ')':\n                if current_depth == 0:\n                    raise ValueError(f\"Unbalanced parentheses in group {idx} ('{group}'): \"\n                                     f\"extra ')' at position {pos}\")\n                current_depth -= 1\n            else:\n                raise ValueError(f\"Invalid character in group {idx} ('{group}'): \"\n                                 f\"'{ch}' at position {pos}; only '(' and ')' allowed\")\n\n        if current_depth != 0:\n            raise ValueError(f\"Unbalanced parentheses in group {idx} ('{group}'): \"\n                             f\"{current_depth} unclosed '('\")\n\n        results.append(max_depth)\n\n    return results"}
{"task_id": "HumanEval/17", "solution": "from typing import List\ndef parse_music(music_string: str) -> List[int]:\n    \"\"\"Parses a musical note string into a list of beat durations.\n    Raises ValueError for unknown tokens.\n    \"\"\"\n    if not music_string.strip():\n        return []\n\n    note_beats_map = {\n        'o': 4,\n        'o|': 2,\n        '.|': 1\n    }\n\n    tokens = music_string.split()\n    result = []\n\n    for token in tokens:\n        if token not in note_beats_map:\n            raise ValueError(f\"Unknown musical token: '{token}'\")\n        result.append(note_beats_map[token])\n\n    return result"}
{"task_id": "HumanEval/30", "solution": "def get_positive(l: list):\n    \"\"\"Return only positive numbers in the list.\n    >>> get_positive([-1, 2, -4, 5, 6])\n    [2, 5, 6]\n    >>> get_positive([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])\n    [5, 3, 2, 3, 9, 123, 1]\n    \"\"\"\n    from numbers import Number\n\n    result = []\n    for item in l:\n        # Accept numeric types (int, float, and subclasses of Number),\n        # but exclude bool and skip values that cannot be ordered (e.g., complex).\n        if isinstance(item, Number) and not isinstance(item, bool):\n            try:\n                if item > 0:\n                    result.append(item)\n            except TypeError:\n                # Skip types that cannot be compared to 0\n                continue\n    return result"}
{"task_id": "HumanEval/38", "solution": "def decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # Split the encoded string into groups of 3 characters.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n\n    decoded_groups = []\n    for group in groups:\n        if len(group) == 3:\n            # For groups of three, reverse the cycle by moving the last character to the front.\n            decoded_groups.append(group[-1] + group[:-1])\n        else:\n            # Groups with fewer than 3 characters were not cycled during encoding.\n            decoded_groups.append(group)\n\n    return \"\".join(decoded_groups)"}
{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    if not isinstance(x, int) or not isinstance(base, int):\n        raise TypeError(\"x and base must be integers\")\n\n    if base < 2 or base >= 10:\n        raise ValueError(\"base must be an integer between 2 and 9 inclusive\")\n\n    if x == 0:\n        return \"0\"\n\n    is_negative = x < 0\n    x = -x if is_negative else x\n\n    digits = []\n    while x > 0:\n        digits.append(str(x % base))\n        x //= base\n\n    digits.reverse()\n    result = \"\".join(digits)\n    return \"-\" + result if is_negative else result"}
{"task_id": "HumanEval/42", "solution": "def incr_list(l: list):\n    \"\"\"Return list with elements incremented by 1.\n    Each numeric element in the input list `l` is increased by one.\n    \"\"\"\n    return [x + 1 for x in l]"}
{"task_id": "HumanEval/43", "solution": "def pairs_sum_to_zero(l):\n    \"\"\"\n    Checks if there are two distinct elements in the list that sum to zero.\n    Uses a set to track seen numbers for O(n) average time complexity.\n    \"\"\"\n    seen_numbers = set()\n    for num in l:\n        if -num in seen_numbers:\n            return True\n        seen_numbers.add(num)\n    return False"}
{"task_id": "HumanEval/37", "solution": "def sort_even(l: list) -> list:\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    \"\"\"\n    n = len(l)\n    if n <= 1:\n        return list(l)  # Return a shallow copy for immutability\n\n    # Extract elements at even indices\n    evens = [l[i] for i in range(0, n, 2)]\n\n    # Sort the extracted even-indexed elements\n    evens.sort()\n\n    # Create a new list for the result, copying all elements from l\n    result = list(l)\n\n    # Place the sorted even-indexed elements back into their original even positions\n    ev_idx = 0\n    for i in range(0, n, 2):\n        result[i] = evens[ev_idx]\n        ev_idx += 1\n\n    return result"}
