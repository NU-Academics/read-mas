{"task_id": "HumanEval/45", "solution": "def triangle_area(a: float, h: float) -> float:\n    \"\"\"Given length of a side and high return area for a triangle.\n    >>> triangle_area(5, 3)\n    7.5\n    \"\"\"\n    import numbers\n    import math\n    import decimal\n\n    for name, value in ((\"a\", a), (\"h\", h)):\n        if isinstance(value, bool) or not isinstance(value, numbers.Real):\n            raise TypeError(f\"{name} must be a real number (int, float, Decimal, etc.)\")\n        # Finite check for float and Decimal\n        if isinstance(value, float):\n            if not math.isfinite(value):\n                raise ValueError(f\"{name} must be finite\")\n        elif isinstance(value, decimal.Decimal):\n            if not value.is_finite():\n                raise ValueError(f\"{name} must be finite\")\n        # Non-negative check\n        if value < 0:\n            raise ValueError(f\"{name} must be non-negative\")\n\n    # Use arithmetic that works with Decimal and other Real types\n    return (a * h) / 2"}
{"task_id": "HumanEval/46", "solution": "def fib4(n: int):\n    \"\"\"Compute the n-th element of the fib4 sequence without recursion.\n\n    Sequence:\n      fib4(0) = 0\n      fib4(1) = 0\n      fib4(2) = 2\n      fib4(3) = 0\n      fib4(n) = fib4(n-1) + fib4(n-2) + fib4(n-3) + fib4(n-4) for n >= 4\n\n    Args:\n        n (int): index (must be a non-negative integer)\n\n    Returns:\n        int: the n-th fib4 value\n\n    Raises:\n        TypeError: if n is not an int\n        ValueError: if n is negative\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 2\n    if n == 3:\n        return 0\n\n    # Initialize previous four values: fib4(0), fib4(1), fib4(2), fib4(3)\n    prev4, prev3, prev2, prev1 = 0, 0, 2, 0\n\n    for _ in range(4, n + 1):\n        curr = prev1 + prev2 + prev3 + prev4\n        prev4, prev3, prev2, prev1 = prev3, prev2, prev1, curr\n\n    return prev1"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    # Create a sorted copy of the input list.\n    arr = sorted(list(l))\n    n = len(arr)\n    if n == 0:\n        raise ValueError(\"median() arg is an empty list\")\n    mid = n // 2\n\n    # Return the middle element for odd length, or mean of two middle for even.\n    if n % 2 == 1:\n        return arr[mid]\n    else:\n        return (arr[mid - 1] + arr[mid]) / 2"}
{"task_id": "HumanEval/47", "solution": "def median(l: list):\n    \"\"\"Return median of elements in the list l.\n    Assumes numerical elements; calculates median for odd and even lengths.\n    \"\"\"\n    sorted_l = sorted(l)\n    n = len(sorted_l)\n\n    if n % 2 == 1:\n        # Odd length list, median is the middle element\n        return sorted_l[n // 2]\n    else:\n        # Even length list, median is the average of the two middle elements\n        mid1 = sorted_l[n // 2 - 1]\n        mid2 = sorted_l[n // 2]\n        return (mid1 + mid2) / 2"}
