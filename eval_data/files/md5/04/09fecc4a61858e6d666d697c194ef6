{"task_id": "HumanEval/22", "solution": "def filter_integers(values: List[Any]) -> List[int]:\n    \"\"\" Filter given list of any python values only for integers\n    >>> filter_integers(['a', 3.14, 5])\n    [5]\n    >>> filter_integers([1, 2, 3, 'abc', {}, []])\n    [1, 2, 3]\n    \"\"\"\n    import numbers\n\n    result: List[int] = []\n    for item in values:\n        # Exclude booleans (bool is a subclass of int)\n        if isinstance(item, bool):\n            continue\n        # Accept Python ints, int subclasses, and numeric-integral types (e.g., numpy integers)\n        if isinstance(item, numbers.Integral):\n            result.append(int(item))\n    return result"}
{"task_id": "HumanEval/26", "solution": "from typing import List\nfrom collections import Counter\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\" From a list of integers, remove all elements that occur more than once. Keep order of elements left the same as in the input. \"\"\"\n    counts = Counter(numbers)\n    result = []\n    for num in numbers:\n        if counts[num] == 1:\n            result.append(num)\n    return result"}
{"task_id": "HumanEval/25", "solution": "def factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    if n <= 1:\n        return []\n\n    factors: List[int] = []\n\n    # factor out 2s\n    while n % 2 == 0:\n        factors.append(2)\n        n //= 2\n\n    # factor out odd divisors\n    d = 3\n    while d * d <= n:\n        while n % d == 0:\n            factors.append(d)\n            n //= d\n        d += 2\n\n    if n > 1:\n        factors.append(n)\n\n    return factors"}
{"task_id": "HumanEval/24", "solution": "def largest_divisor(n: int) -> int:\n    \"\"\"Return the largest proper divisor of n (an integer less than n that divides n evenly).\n\n    Args:\n        n: Integer greater than 1.\n\n    Returns:\n        The largest integer d < n such that n % d == 0.\n\n    Raises:\n        TypeError: If n is not an int.\n        ValueError: If n <= 1.\n\n    Examples:\n        >>> largest_divisor(15)\n        5\n        >>> largest_divisor(13)  # prime\n        1\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n <= 1:\n        raise ValueError(\"n must be greater than 1\")\n\n    import math\n\n    # If n is prime, the largest proper divisor is 1.\n    # The largest proper divisor equals n // (smallest prime factor > 1).\n    limit = math.isqrt(n)\n    for d in range(2, limit + 1):\n        if n % d == 0:\n            return n // d\n    return 1"}
{"task_id": "HumanEval/25", "solution": "def factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    if n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n    if n == 1:\n        return []\n\n    factors: List[int] = []\n\n    # factor out 2s\n    while n % 2 == 0:\n        factors.append(2)\n        n //= 2\n\n    # factor out odd factors\n    d = 3\n    while d * d <= n:\n        while n % d == 0:\n            factors.append(d)\n            n //= d\n        d += 2\n\n    # if remaining n is a prime > 1\n    if n > 1:\n        factors.append(n)\n\n    return factors"}
{"task_id": "HumanEval/24", "solution": "def largest_divisor(n: int) -> int:\n    \"\"\"For a given integer n > 1, return the largest integer < n that divides n evenly.\n\n    Raises:\n        TypeError: if n is not an int.\n        ValueError: if n <= 1.\n\n    Examples:\n        largest_divisor(15) -> 5\n        largest_divisor(13) -> 1\n    \"\"\"\n    if not isinstance(n, int):\n        raise TypeError(\"n must be an int\")\n    if n <= 1:\n        raise ValueError(\"n must be greater than 1\")\n\n    # Quick check for even numbers: largest proper divisor is n // 2\n    if n % 2 == 0:\n        return n // 2\n\n    from math import isqrt\n    limit = isqrt(n)\n\n    # Look for the smallest factor > 1 (odd factors only since even handled)\n    for i in range(3, limit + 1, 2):\n        if n % i == 0:\n            return n // i\n\n    # n is prime\n    return 1"}
