{"task_id": "Mbpp/235", "solution": "def even_bit_set_number(value: int) -> int:\n    \"\"\"\n    Set all even\u2011indexed bits of `value` to 1 while preserving odd bits.\n    The mask covers up to 64 bits or the highest bit of the input value.\n    \"\"\"\n    even_mask = 0\n    bit_position = 0\n    while (1 << bit_position) <= value or bit_position < 64:\n        even_mask |= (1 << bit_position)\n        bit_position += 2\n    return value | even_mask"}
{"task_id": "Mbpp/237", "solution": "from typing import List, Tuple, Dict\nfrom collections import defaultdict\ndef check_occurences(tuples: List[Tuple[int, int]]) -> Dict[Tuple[int, int], int]:\n    # Helper class to represent a tuple pair, enabling comparison and hashing for dictionary keys.\n    class TuplePair:\n        def __init__(self, a: int, b: int):\n            self.first = a\n            self.second = b\n\n        # Returns a new TuplePair with its elements sorted in ascending order.\n        def sorted(self) -> 'TuplePair':\n            return TuplePair(min(self.first, self.second), max(self.first, self.second))\n\n        # Defines equality for TuplePair objects.\n        def __eq__(self, other):\n            if not isinstance(other, TuplePair):\n                return NotImplemented\n            return self.first == other.first and self.second == other.second\n\n        # Makes TuplePair objects hashable, allowing them to be used as dictionary keys.\n        def __hash__(self):\n            return hash((self.first, self.second))\n\n    # Helper class to manage counts of TuplePair instances.\n    class TupleCountMap:\n        def __init__(self):\n            self.counts = defaultdict(int)\n\n        # Increments the count for a given TuplePair.\n        def add(self, p: TuplePair):\n            self.counts[p] += 1\n\n    tuple_counts = TupleCountMap()\n\n    # Process each tuple from the input list.\n    for t_val in tuples:\n        current_pair = TuplePair(t_val[0], t_val[1])\n        sorted_pair = current_pair.sorted()\n        tuple_counts.add(sorted_pair)\n\n    # Build the final result dictionary with standard Python tuples as keys.\n    result_dict: Dict[Tuple[int, int], int] = {}\n    for pair_key, count in tuple_counts.counts.items():\n        result_dict[(pair_key.first, pair_key.second)] = count\n\n    return result_dict"}
