{"task_id": "Mbpp/792", "solution": "from typing import List, Any\nclass ListCounter:\n    \"\"\"Domain logic for counting sub\u2011lists.\"\"\"\n    @staticmethod\n    def count_list(lists: List[List[Any]]) -> int:\n        if not isinstance(lists, list):\n            raise TypeError(\"Input must be a list.\")\n        return len(lists)\ndef count_list(lists: List[List[Any]]) -> int:\n    \"\"\"Public API that delegates to ListCounter.\"\"\"\n    return ListCounter.count_list(lists)"}
{"task_id": "Mbpp/793", "solution": "from typing import List\ndef last(array: List[int], target: int) -> int:\n    \"\"\"\n    Finds the last position of an element in a sorted array using binary search.\n    Returns -1 if the target is not found.\n    \"\"\"\n    left, right = 0, len(array) - 1\n    result = -1\n    while left <= right:\n        mid = (left + right) // 2\n        if array[mid] == target:\n            result = mid  # Record potential last occurrence\n            left = mid + 1  # Continue searching to the right for a later occurrence\n        elif array[mid] < target:\n            left = mid + 1\n        else:\n            right = mid - 1\n    return result"}
