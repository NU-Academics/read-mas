{"task_id": "Mbpp/797", "solution": "def sum_in_range(l, r) -> int:\n    \"\"\"\n    Calculates the sum of all odd natural numbers within the inclusive range [l, r].\n    Returns 0 if the range is invalid (l > r) or contains no odd numbers.\n    \"\"\"\n    if l > r:\n        return 0\n\n    # Determine the first odd number within the range [l, r]\n    first_odd = l if l % 2 == 1 else l + 1\n    # Determine the last odd number within the range [l, r]\n    last_odd = r if r % 2 == 1 else r - 1\n\n    # If the effective range for odd numbers is invalid, there are no odd numbers\n    if first_odd > last_odd:\n        return 0\n\n    # Calculate the count of odd numbers in the arithmetic series\n    # The common difference is 2\n    count = ((last_odd - first_odd) // 2) + 1\n\n    # Calculate the sum of the arithmetic series\n    total_sum = (count * (first_odd + last_odd)) // 2\n    return total_sum"}
{"task_id": "Mbpp/799", "solution": "def left_rotate(number, d):\n    # Rotates bits of a 32-bit integer left by d positions.\n    # The final result is a 32-bit signed integer.\n    BIT_WIDTH = 32\n    MASK = 0xFFFFFFFF\n\n    rotated = ((number << d) | (number >> (BIT_WIDTH - d))) & MASK\n\n    # Convert the 32-bit unsigned result to a signed 32-bit integer.\n    if rotated & 0x80000000:\n        rotated -= (1 << BIT_WIDTH)\n    return rotated"}
{"task_id": "Mbpp/800", "solution": "def remove_all_spaces(input_string):\n    \"\"\"\n    Removes all whitespace characters from the input string.\n    Iterates through the string, appending non-whitespace characters to a new list.\n    \"\"\"\n    cleaned_chars = []\n    for char in input_string:\n        if not char.isspace():\n            cleaned_chars.append(char)\n    return \"\".join(cleaned_chars)"}
{"task_id": "Mbpp/803", "solution": "def is_perfect_square(n):\n    \"\"\"\n    Checks if the given number is a perfect square.\n    Returns false for negative inputs.\n    \"\"\"\n    if n < 0:\n        return False\n    if n == 0 or n == 1:\n        return True\n    \n    # Calculate the integer square root\n    root = int(n**0.5)\n    \n    # Check if the square of the root equals the original number\n    return root * root == n"}
{"task_id": "Mbpp/801", "solution": "def test_three_equal(a, b, c):\n    \"\"\"Counts the number of equal numbers among three given integers.\"\"\"\n    if a == b == c:\n        return 3\n    if a == b or a == c or b == c:\n        return 2\n    return 0"}
{"task_id": "Mbpp/805", "solution": "from typing import List\ndef max_sum_list(lists: List[List[int]]) -> List[int]:\n    \"\"\"\n    Returns the sublist with the highest sum of elements.\n    Assumes input is a non-empty list of non-empty lists of integers.\n    \"\"\"\n    max_sublist = lists[0]\n    max_sum = sum(lists[0])\n\n    for sublist in lists[1:]:\n        current_sum = sum(sublist)\n        if current_sum > max_sum:\n            max_sum = current_sum\n            max_sublist = sublist\n\n    return max_sublist"}
