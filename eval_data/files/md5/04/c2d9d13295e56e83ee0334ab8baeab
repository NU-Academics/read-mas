{"task_id": "Mbpp/765", "solution": "def is_polite(n: int) -> int:\n    \"\"\"Returns the nth polite number.\"\"\"\n    count = 0\n    num = 1\n    while count < n:\n        if not (num & (num - 1)) == 0:  # Check if num is not a power of two.\n            count += 1\n        num += 1\n    return num - 1"}
{"task_id": "Mbpp/763", "solution": "def find_min_diff(sequence, n):\n    \"\"\"\n    Compute the minimum absolute difference between any two distinct elements\n    in `sequence`.\n    \"\"\"\n    if n != len(sequence):\n        raise ValueError(f\"n ({n}) does not match sequence length ({len(sequence)}).\")\n    if len(sequence) < 2:\n        raise ValueError(\"Sequence must contain at least two elements.\")\n\n    sorted_seq = sorted(sequence)\n    min_diff = abs(sorted_seq[1] - sorted_seq[0])\n    for i in range(2, len(sorted_seq)):\n        diff = abs(sorted_seq[i] - sorted_seq[i - 1])\n        if diff < min_diff:\n            min_diff = diff\n    return min_diff"}
{"task_id": "Mbpp/766", "solution": "def pair_wise(input_list):\n    \"\"\"\n    Generates a list of all consecutive pairs from the input list.\n    Returns an empty list if the input list has fewer than two elements.\n    \"\"\"\n    if len(input_list) < 2:\n        return []\n    return [(input_list[i], input_list[i + 1]) for i in range(len(input_list) - 1)]"}
{"task_id": "Mbpp/767", "solution": "from collections import Counter\nfrom typing import List\ndef get_pairs_count(numbers: List[int], target: int) -> int:\n    \"\"\"\n    Count unordered pairs of integers in `numbers` that sum to `target`.\n    This implementation uses a hash map for O(n) time and space complexity.\n    \"\"\"\n    freq = Counter(numbers)\n    count = 0\n    for x in list(freq):\n        y = target - x\n        if y not in freq:\n            continue\n        if x == y:\n            count += freq[x] * (freq[x] - 1) // 2\n        elif x < y:\n            count += freq[x] * freq[y]\n    return count"}
{"task_id": "Mbpp/769", "solution": "def Diff(list1, list2):\n    \"\"\"\n    Returns a new list containing elements from list1 that are not present in list2,\n    preserving the order of list1.\n    \"\"\"\n    set2 = set(list2)\n    result = []\n    for item in list1:\n        if item not in set2:\n            result.append(item)\n    return result"}
{"task_id": "Mbpp/770", "solution": "def odd_num_sum(n: int) -> int:\n    \"\"\"Calculates the sum of the fourth power of the first n odd natural numbers.\n\n    Validates input n to be a positive integer and delegates computation to a helper class.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"n must be a positive integer\")\n\n    class OddNumberSequence:\n        \"\"\"Encapsulates the logic for summing fourth powers of odd numbers.\"\"\"\n        def getFourthPowerSum(self, num_terms: int) -> int:\n            \"\"\"Computes the sum of (2k-1)^4 for k from 1 to num_terms.\"\"\"\n            total_sum = 0\n            for k in range(1, num_terms + 1):\n                odd_num = 2 * k - 1\n                total_sum += odd_num ** 4\n            return total_sum\n\n    calculator = OddNumberSequence()\n    return calculator.getFourthPowerSum(n)"}
{"task_id": "Mbpp/771", "solution": "def check_expression(expr: str) -> bool:\n    \"\"\"\n    Checks if the given expression has balanced brackets using a stack-based algorithm.\n    Ignores non-bracket characters and treats an empty string as balanced.\n    \"\"\"\n    stack = []\n    bracket_map = {')': '(', '}': '{', ']': '['}\n    opening_brackets = set(bracket_map.values())\n\n    for char in expr:\n        if char in opening_brackets:\n            stack.append(char)\n        elif char in bracket_map:\n            if not stack or stack.pop() != bracket_map[char]:\n                return False\n    \n    return not stack"}
{"task_id": "Mbpp/772", "solution": "def remove_length(input: str, k: int) -> str:\n    \"\"\"Removes all words of length `k` from the input string, joining remaining words with a single space. Raises `ValueError` if `k` is negative; returns an empty string if no words remain.\"\"\"\n    if k < 0:\n        raise ValueError(\"k must be non\u2011negative\")\n\n    # Tokenize on any whitespace\n    tokens = input.split()\n    # Filter out words of length k\n    filtered = [t for t in tokens if len(t) != k]\n    # Join remaining words with single spaces\n    return \" \".join(filtered)"}
{"task_id": "Mbpp/773", "solution": "def occurance_substring(text: str, pattern: str) -> tuple[str, int, int] | None:\n    \"\"\"\n    Find the first occurrence and position of the substring within a string.\n    Returns None if there is no match.\n    \"\"\"\n    if not pattern:\n        return None\n\n    start = text.find(pattern)\n    if start == -1:\n        return None\n\n    length = len(pattern)\n    return (pattern, start, length)"}
{"task_id": "Mbpp/775", "solution": "def odd_position(lst):\n    \"\"\"\n    Checks if every odd index in the list contains an odd number.\n    Returns True if all odd-indexed elements are odd, otherwise False.\n    \"\"\"\n    for idx, val in enumerate(lst):\n        if idx % 2 == 1 and val % 2 == 0:\n            return False\n    return True"}
{"task_id": "Mbpp/778", "solution": "def pack_consecutive_duplicates(lst):\n    \"\"\"\n    Packs consecutive duplicate elements of a list into sublists.\n    Returns an empty list for an empty input list.\n    \"\"\"\n    if not lst:\n        return []\n\n    packed_list = []\n    current_sublist = [lst[0]]\n\n    for i in range(1, len(lst)):\n        if lst[i] == current_sublist[-1]:\n            current_sublist.append(lst[i])\n        else:\n            packed_list.append(current_sublist)\n            current_sublist = [lst[i]]\n    \n    packed_list.append(current_sublist)\n    return packed_list"}
{"task_id": "Mbpp/777", "solution": "def find_sum(lst: list) -> int:\n    \"\"\"\n    Return the sum of all elements that appear exactly once in the input list.\n\n    Parameters\n    ----------\n    lst : list\n        A list of integers to process.\n\n    Returns\n    -------\n    int\n        Sum of unique integers.\n    \"\"\"\n    from collections import Counter\n\n    counts = Counter(lst)\n    unique_sum = 0\n    for element, count in counts.items():\n        if count == 1:\n            unique_sum += element\n    return unique_sum"}
{"task_id": "Mbpp/780", "solution": "def find_combinations(tuples):\n    \"\"\"\n    Finds the element-wise sum of all distinct unordered pairs of tuples from the input list.\n    \"\"\"\n    n = len(tuples)\n    if n < 2:\n        return []\n\n    result = []\n    for i in range(n):\n        t1_x, t1_y = tuples[i]\n        for j in range(i + 1, n):\n            t2_x, t2_y = tuples[j]\n            result.append((t1_x + t2_x, t1_y + t2_y))\n\n    return result"}
{"task_id": "Mbpp/781", "solution": "def count_divisors(n: int) -> bool:\n    \"\"\"\n    Checks if the total count of divisors for a given integer n is even.\n    Raises ValueError if n is not a positive integer.\n    \"\"\"\n    if not isinstance(n, int) or n <= 0:\n        raise ValueError(\"Input must be a positive integer.\")\n\n    count = 0\n    i = 1\n    while i * i <= n:\n        if n % i == 0:\n            if i * i == n:\n                count += 1\n            else:\n                count += 2\n        i += 1\n    return count % 2 == 0"}
{"task_id": "Mbpp/782", "solution": "def odd_length_sum(lst):\n    \"\"\"\n    Calculates the sum of all odd-length contiguous subarrays in a given list,\n    following a component-based design described in the context.\n    \"\"\"\n    \n    class IntegerList:\n        def __init__(self, elements):\n            self.elements = elements\n\n    class OddLengthSumCalculator:\n        def compute(self, integer_list):\n            total_sum = 0\n            n = len(integer_list.elements)\n            for i in range(n):\n                for j in range(i, n):\n                    subarray_len = j - i + 1\n                    if subarray_len % 2 == 1:\n                        for k in range(i, j + 1):\n                            total_sum += integer_list.elements[k]\n            return total_sum\n\n    integer_list_instance = IntegerList(lst)\n    calculator = OddLengthSumCalculator()\n    result_sum = calculator.compute(integer_list_instance)\n    \n    return result_sum"}
{"task_id": "Mbpp/784", "solution": "from typing import List, Optional\ndef mul_even_odd(numbers: List[int]) -> Optional[int]:\n    \"\"\"\n    Return the product of the first even and first odd numbers in the list.\n    If either an even or an odd number is missing, return None.\n    \"\"\"\n    first_even = None\n    first_odd = None\n\n    for num in numbers:\n        if first_even is None and num % 2 == 0:\n            first_even = num\n        elif first_odd is None and num % 2 != 0:\n            first_odd = num\n\n        if first_even is not None and first_odd is not None:\n            break\n\n    if first_even is None or first_odd is None:\n        return None\n\n    return first_even * first_odd"}
{"task_id": "Mbpp/786", "solution": "def right_insertion(arr: list[int], value: int) -> int:\n    \"\"\"\n    Locates the right insertion point for a value in a sorted list using binary search.\n    This function finds the index where 'value' can be inserted while maintaining sorted order.\n    \"\"\"\n    low = 0\n    high = len(arr)\n\n    while low < high:\n        mid = (low + high) // 2\n        if arr[mid] <= value:  # If middle element is less than or equal to value, look in the right half\n            low = mid + 1\n        else:  # Otherwise, look in the left half\n            high = mid\n    return low"}
{"task_id": "Mbpp/785", "solution": "import re\nfrom typing import Tuple\ndef tuple_str_int(input: str) -> Tuple[int, ...]:\n    \"\"\"\n    Converts a string representation of an integer tuple into an actual Python tuple of integers.\n    Raises ValueError for malformed inputs based on a specific pattern.\n    \"\"\"\n    pattern = r\"^\\(\\s*\\d+\\s*(,\\s*\\d+\\s*)*\\)$\"\n    if not re.fullmatch(pattern, input):\n        raise ValueError(\"Invalid tuple string format\")\n\n    # Remove parentheses and split by comma\n    content = input[1:-1]\n    if not content.strip(): # Handle cases like \"()\" or \"( )\" which are invalid by regex but would yield empty string here\n        return tuple() # This case should ideally not be reached if regex is strict.\n                       # Based on the regex, content will always have at least one number.\n    \n    parts = content.split(',')\n    \n    # Convert each part to an integer and build the tuple\n    result = tuple(int(part.strip()) for part in parts)\n    \n    return result"}
