{"task_id": "Mbpp/555", "solution": "class NumberSequence:\n    \"\"\"Helper class to calculate sums of numbers and cubes, and their difference.\"\"\"\n    def __init__(self, n: int):\n        self.n = n\n        self.sum_cubes = 0\n        self.sum_numbers = 0\n        self.difference = 0\n\n    def calculate_sum_cubes(self) -> None:\n        \"\"\"Calculates the sum of cubes of the first n natural numbers.\"\"\"\n        self.sum_cubes = sum(i ** 3 for i in range(1, self.n + 1))\n\n    def calculate_sum_numbers(self) -> None:\n        \"\"\"Calculates the sum of the first n natural numbers.\"\"\"\n        self.sum_numbers = sum(i for i in range(1, self.n + 1))\n\n    def calculate_difference(self) -> None:\n        \"\"\"Calculates the difference between sum of cubes and sum of numbers.\"\"\"\n        self.difference = self.sum_cubes - self.sum_numbers\nclass MathCalculator:\n    \"\"\"Provides a static method to calculate the required difference.\"\"\"\n    @staticmethod\n    def difference(n: int) -> int:\n        \"\"\"Orchestrates the calculation of the difference using NumberSequence.\"\"\"\n        seq = NumberSequence(n)\n        seq.calculate_sum_cubes()\n        seq.calculate_sum_numbers()\n        seq.calculate_difference()\n        return seq.difference\ndef difference(n: int) -> int:\n    \"\"\"\n    Calculates the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers.\n    \"\"\"\n    return MathCalculator.difference(n)"}
{"task_id": "Mbpp/557", "solution": "def toggle_string(input_string: str) -> str:\n    \"\"\"Toggles the case of all alphabetic characters in a string.\"\"\"\n\n    class StringProcessor:\n        \"\"\"Processes strings to toggle character cases.\"\"\"\n        def toggleString(self, input_str: str) -> str:\n            toggled_chars = []\n            for char in input_str:\n                if char.islower():\n                    toggled_chars.append(char.upper())\n                elif char.isupper():\n                    toggled_chars.append(char.lower())\n                else:\n                    toggled_chars.append(char)\n            return \"\".join(toggled_chars)\n\n    processor = StringProcessor()\n    return processor.toggleString(input_string)"}
{"task_id": "Mbpp/558", "solution": "def digit_distance_nums(a: int, b: int) -> int:\n    \"\"\"\n    Calculates the sum of per-digit absolute differences between two integers.\n    Numbers are processed using their absolute values and aligned from the right.\n    \"\"\"\n    abs_a = abs(a)\n    abs_b = abs(b)\n\n    str_a = str(abs_a)\n    str_b = str(abs_b)\n\n    # Convert digit strings to lists of integers, reversed for right-alignment\n    digits_a = [int(d) for d in str_a[::-1]]\n    digits_b = [int(d) for d in str_b[::-1]]\n\n    total_distance = 0\n    max_len = max(len(digits_a), len(digits_b))\n\n    # Iterate through digits, padding shorter number with implicit zeros\n    for i in range(max_len):\n        digit_a = digits_a[i] if i < len(digits_a) else 0\n        digit_b = digits_b[i] if i < len(digits_b) else 0\n        total_distance += abs(digit_a - digit_b)\n\n    return total_distance"}
{"task_id": "Mbpp/556", "solution": "def find_Odd_Pair(values,n):\n    \"\"\"\n    Counts pairs in the first n elements of the list whose XOR sum is odd.\n    An XOR sum is odd only if one number is odd and the other is even.\n    \"\"\"\n    odd_count = 0\n    even_count = 0\n\n    for i in range(min(n, len(values))):\n        if values[i] % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n            \n    return odd_count * even_count"}
{"task_id": "Mbpp/559", "solution": "def max_sub_array_sum(elements, length):\n    max_so_far = elements[0]\n    current_max = elements[0]\n\n    for i in range(1, length):\n        current_max = max(elements[i], current_max + elements[i])\n        max_so_far = max(max_so_far, current_max)\n        \n    return max_so_far"}
