{"task_id": "Mbpp/726", "solution": "def multiply_elements(t: tuple) -> tuple:\n    \"\"\"\n    Returns a tuple containing the product of each consecutive pair of elements\n    in the input tuple.\n    \"\"\"\n    if len(t) < 2:\n        raise ValueError(\"Input tuple must contain at least two elements.\")\n\n    products = tuple(t[i] * t[i + 1] for i in range(len(t) - 1))\n    return products"}
{"task_id": "Mbpp/724", "solution": "def power_base_sum(base, power):\n    \"\"\"Calculate the sum of all digits of the base to the specified power.\n    This function computes base raised to power and then sums its decimal digits.\"\"\"\n    \n    result = base ** power\n    digit_sum = sum(int(digit) for digit in str(result))\n    return digit_sum"}
{"task_id": "Mbpp/725", "solution": "def extract_quotation(text: str) -> list[str]:\n    \"\"\"\n    Extracts all substrings enclosed in double quotation marks from the given string.\n    Processes the string with a linear scan, accumulating characters between quotes.\n    \"\"\"\n    result = []\n    current_substring = []\n    in_quote = False\n\n    for char in text:\n        if char == '\"':\n            if in_quote:\n                result.append(\"\".join(current_substring))\n                current_substring = []\n                in_quote = False\n            else:\n                in_quote = True\n        elif in_quote:\n            current_substring.append(char)\n    return result"}
{"task_id": "Mbpp/730", "solution": "def consecutive_duplicates(inputList):\n    \"\"\"\n    Removes consecutive duplicate elements from a list, preserving order and immutability.\n    Returns a new list with duplicates removed; the original list is unchanged.\n    \"\"\"\n    if not inputList:\n        return []\n\n    result = [inputList[0]]\n    for i in range(1, len(inputList)):\n        if inputList[i] != result[-1]:\n            result.append(inputList[i])\n    return result"}
{"task_id": "Mbpp/728", "solution": "def sum_list(a, b):\n    \"\"\"\n    Computes the element-wise sum of two lists.\n    Assumes lists are of equal length and contain numbers.\n    \"\"\"\n    result = []\n    for i in range(len(a)):\n        result.append(a[i] + b[i])\n    return result"}
{"task_id": "Mbpp/731", "solution": "def lateralsurface_cone(r, h):\n    \"\"\"\n    Calculates the lateral surface area of a cone.\n    Uses the formula pi * r * sqrt(r^2 + h^2).\n    \"\"\"\n    import math\n    slant_height = math.sqrt(r**2 + h**2)\n    area = math.pi * r * slant_height\n    return area"}
{"task_id": "Mbpp/732", "solution": "def replace_specialchar(text):\n    \"\"\"Replaces spaces, commas, or dots in a string with colons.\"\"\"\n    text = text.replace(' ', ':')\n    text = text.replace(',', ':')\n    text = text.replace('.', ':')\n    return text"}
{"task_id": "Mbpp/733", "solution": "def find_first_occurrence(array: list[int], target: int) -> int:\n    \"\"\"\n    Finds the index of the first occurrence of a given number in a sorted array.\n    Returns -1 if the number is not found.\n    \"\"\"\n    left, right = 0, len(array) - 1\n    result = -1\n\n    while left <= right:\n        mid = (left + right) // 2\n        if array[mid] == target:\n            result = mid\n            right = mid - 1  # Continue searching in the left half for an earlier occurrence\n        elif array[mid] < target:\n            left = mid + 1\n        else:  # array[mid] > target\n            right = mid - 1\n\n    return result"}
{"task_id": "Mbpp/734", "solution": "def sum_Of_Subarray_Prod(lst: list) -> int:\n    \"\"\"\n    Calculates the sum of products of all contiguous sublists of a given list.\n    \"\"\"\n    total_sum = 0\n    n = len(lst)\n\n    for i in range(n):\n        current_product = 1\n        for j in range(i, n):\n            current_product *= lst[j]\n            total_sum += current_product\n    return total_sum"}
{"task_id": "Mbpp/735", "solution": "def toggle_middle_bits(number: int) -> int:\n    \"\"\"\n    Toggles all bits of the number except the first (MSB) and the last (LSB) bit.\n    Returns the original number if its binary representation has fewer than 3 bits.\n    \"\"\"\n    binary_str = bin(number)[2:]\n\n    if len(binary_str) < 3:\n        return number\n\n    msb = binary_str[0]\n    lsb = binary_str[-1]\n    middle_bits = binary_str[1:-1]\n\n    inverted_middle_bits = \"\".join('1' if bit == '0' else '0' for bit in middle_bits)\n\n    result_binary_str = msb + inverted_middle_bits + lsb\n    return int(result_binary_str, 2)"}
{"task_id": "Mbpp/736", "solution": "def left_insertion(lst: list[int], value: int) -> int:\n    \"\"\"Finds the leftmost insertion point for `value` in `lst` to maintain sorted order. Raises ValueError if `lst` is not sorted.\"\"\"\n    for i in range(1, len(lst)):\n        if lst[i] < lst[i - 1]:\n            raise ValueError(\"Input list must be sorted in ascending order\")\n\n    low, high = 0, len(lst)\n    while low < high:\n        mid = (low + high) // 2\n        if lst[mid] < value:\n            low = mid + 1\n        else:\n            high = mid\n    return low"}
