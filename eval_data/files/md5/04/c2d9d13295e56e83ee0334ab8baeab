{"task_id": "Mbpp/311", "solution": "def set_left_most_unset_bit(value: int) -> int:\n    \"\"\"Set the leftmost unset bit of a non-negative integer.\"\"\"\n\n    # Handle the special case where value is 0.\n    # For 0, the leftmost unset bit is at position 0, setting it results in 1.\n    if value == 0:\n        return 1\n\n    # Check if all bits up to the value's bit_length are already set.\n    # If `value` is `(1 << value.bit_length()) - 1`, it means all bits from 0\n    # up to `value.bit_length() - 1` are 1. In this case, there are no unset bits\n    # within its current representation, so return the value unchanged.\n    # Example: 0xFFFFFFFF (all 32 bits set) should return 0xFFFFFFFF.\n    all_ones_mask = (1 << value.bit_length()) - 1\n    if value == all_ones_mask:\n        return value\n\n    # Find the leftmost unset bit.\n    # We iterate from the most significant bit of the `value` downwards to 0.\n    # The `value.bit_length() - 1` gives the index of the most significant bit.\n    # Example: for 10 (binary 1010), bit_length() is 4, so MSB is at index 3.\n    mask = 1 << (value.bit_length() - 1)\n    while mask > 0:\n        # If the bit at the current mask position is 0 (unset) in `value`,\n        # then this is the leftmost unset bit we need to set.\n        if (value & mask) == 0:\n            return value | mask\n        # If the bit is set, move to the next bit position to the right.\n        mask >>= 1\n    \n    # This part should theoretically not be reached for positive `value` that is not all-ones,\n    # as an unset bit would have been found and returned.\n    # However, for Python's arbitrary precision, this logic works.\n    return value"}
{"task_id": "Mbpp/388", "solution": "def highest_Power_of_2(n: int) -> int:\n    \"\"\"\n    Finds the highest power of 2 that is less than or equal to n.\n    Returns 0 if n is less than 1.\n    \"\"\"\n    if n < 1:\n        return 0\n\n    result = 1\n    # Continuously double the result using a left shift\n    # until the next power of 2 would exceed n.\n    while (result << 1) <= n:\n        result <<= 1\n    return result"}
{"task_id": "Mbpp/389", "solution": "def find_lucas(n: int) -> int:\n    \"\"\"\n    Calculates the n'th Lucas number using an iterative approach.\n    Raises ValueError for negative input.\n    \"\"\"\n    if n < 0:\n        raise ValueError(\"Input must be a non-negative integer.\")\n    if n == 0:\n        return 2\n    if n == 1:\n        return 1\n\n    a, b = 2, 1  # L(0), L(1)\n    for _ in range(2, n + 1):\n        a, b = b, a + b\n    return b"}
{"task_id": "Mbpp/392", "solution": "def get_max_sum(n: int, memo: dict[int, int] | None = None) -> int:\n    \"\"\"Calculates the maximum sum based on the recurrence relation f(n) = max( (f(n/2) + f(n/3) + f(n/4) + f(n/5)), n), using memoization.\"\"\"\n    if memo is None:\n        memo = {}\n    if n <= 0:\n        return 0\n    if n < 2:\n        return n\n    if n in memo:\n        return memo[n]\n    result = max(\n        get_max_sum(n // 2, memo) +\n        get_max_sum(n // 3, memo) +\n        get_max_sum(n // 4, memo) +\n        get_max_sum(n // 5, memo),\n        n\n    )\n    memo[n] = result\n    return result"}
