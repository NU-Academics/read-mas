{"task_id": "Mbpp/3", "solution": "import math\ndef is_not_prime(n: int) -> bool:\n    \"\"\"\n    Determines if an integer is a non-prime number.\n    Returns True if n is not prime, False if n is prime.\n    \"\"\"\n    if n <= 1:\n        return True\n    if n == 2:\n        return False\n    if n % 2 == 0:  # Optimization: handle even numbers greater than 2\n        return True\n    \n    # Iterate from 3 up to sqrt(n), skipping even numbers\n    limit = int(math.isqrt(n)) + 1\n    for i in range(3, limit, 2):\n        if n % i == 0:\n            return True\n            \n    return False"}
{"task_id": "Mbpp/2", "solution": "from typing import Iterable, Hashable, Set\ndef similar_elements(seq1: Iterable[Hashable], seq2: Iterable[Hashable]) -> Set[Hashable]:\n    \"\"\"\n    Return a set of elements that appear in both seq1 and seq2.\n\n    Parameters\n    ----------\n    seq1 : Iterable[Hashable]\n        First input sequence.\n    seq2 : Iterable[Hashable]\n        Second input sequence.\n\n    Returns\n    -------\n    Set[Hashable]\n        Set of common elements. Empty if no common elements or either input is empty.\n    \"\"\"\n    # Convert first sequence to a set for O(1) membership tests\n    set1 = set(seq1)\n    # Build result set by intersecting with second sequence\n    result = {item for item in seq2 if item in set1}\n    return result"}
{"task_id": "Mbpp/9", "solution": "def find_Rotations(s: str) -> int:\n    \"\"\"\n    Calculates the minimum positive number of rotations to make a string identical to its original form.\n    It iterates through all possible rotation counts from 1 up to the string's length.\n    \"\"\"\n    n = len(s)\n    # Assuming non-empty strings (n >= 1) based on problem context and assertion.\n    # If n is 0, the loop range(1, 1) is empty and no value would be returned.\n\n    for k in range(1, n + 1):\n        rotated_s = s[k:] + s[:k]\n        if rotated_s == s:\n            return k"}
