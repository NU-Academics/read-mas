{"task_id": "Mbpp/18", "solution": "def remove_dirty_chars(first: str, second: str) -> str:\n    \"\"\"Return a new string containing only characters from `first` that are not present in `second`.\"\"\"\n    if not first:\n        return \"\"\n    if not second:\n        return first\n    # Build a set of characters to remove for O(1) look-ups.\n    remove_set = set(second)\n    # Preserve order of remaining characters.\n    result_chars = [c for c in first if c not in remove_set]\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/20", "solution": "def is_woodall(n: int) -> bool:\n    \"\"\"Checks if the given number `n` is a Woodall number.\n    A Woodall number is a natural number of the form `n * 2**n - 1`.\"\"\"\n    if n <= 1:\n        return False\n    \n    # Iterate through potential 'k' values to see if n matches the Woodall form k * 2**k - 1\n    # Since n = k * 2**k - 1, we know that k * 2**k approx n.\n    # And k must be less than or equal to n.\n    # We can optimize by noting that 2**k grows quickly.\n    # We can iterate k from 1 up to a reasonable limit where k * 2**k - 1 could be n.\n    # For large n, k will be much smaller than n.\n    \n    k = 1\n    while True:\n        woodall_candidate = k * (2**k) - 1\n        if woodall_candidate == n:\n            return True\n        elif woodall_candidate > n: # The candidate surpassed n, so n is not a Woodall number\n            return False\n        k += 1"}
