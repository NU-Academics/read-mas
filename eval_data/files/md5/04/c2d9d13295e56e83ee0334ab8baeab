{"task_id": "Mbpp/296", "solution": "def get_Inv_Count(arr):\n    \"\"\"Counts inversions in an array using a merge-sort based approach with O(n log n) complexity.\"\"\"\n\n    def _merge_sort_and_count(sub_arr):\n        n = len(sub_arr)\n        if n <= 1:\n            return sub_arr, 0\n\n        mid = n // 2\n        left_half = sub_arr[:mid]\n        right_half = sub_arr[mid:]\n\n        sorted_left, left_inv_count = _merge_sort_and_count(left_half)\n        sorted_right, right_inv_count = _merge_sort_and_count(right_half)\n\n        merged_arr = []\n        i, j = 0, 0\n        split_inv_count = 0\n\n        while i < len(sorted_left) and j < len(sorted_right):\n            if sorted_left[i] <= sorted_right[j]:\n                merged_arr.append(sorted_left[i])\n                i += 1\n            else:\n                # If an element from the right half is smaller, it forms inversions\n                # with all remaining elements in the current left half.\n                merged_arr.append(sorted_right[j])\n                split_inv_count += (len(sorted_left) - i)\n                j += 1\n        \n        merged_arr.extend(sorted_left[i:])\n        merged_arr.extend(sorted_right[j:])\n\n        total_inv_count = left_inv_count + right_inv_count + split_inv_count\n        return merged_arr, total_inv_count\n\n    _, total_inversions = _merge_sort_and_count(arr)\n    return total_inversions"}
{"task_id": "Mbpp/297", "solution": "def flatten_list(input_list):\n    \"\"\"Recursively flattens a nested list structure into a single list.\n    Elements are processed in order, appending integers and recursing into sublists.\n    \"\"\"\n    flat_list = []\n\n    def _flatten(sublist):\n        for item in sublist:\n            if isinstance(item, list):\n                _flatten(item)\n            else:\n                flat_list.append(item)\n\n    _flatten(input_list)\n    return flat_list"}
{"task_id": "Mbpp/301", "solution": "def dict_depth(d: dict) -> int:\n    \"\"\"\n    Computes the maximum depth of nested dictionaries.\n\n    The depth is defined as the maximum number of nested dictionaries,\n    where a dictionary itself contributes 1 to the depth.\n    \"\"\"\n    if not isinstance(d, dict):\n        raise TypeError(\"Input must be a dictionary.\")\n\n    def _calculate_depth(current_dict: dict, current_level: int) -> int:\n        max_depth = current_level\n        for value in current_dict.values():\n            if isinstance(value, dict):\n                # Recurse for nested dictionaries, increasing the level\n                max_depth = max(max_depth, _calculate_depth(value, current_level + 1))\n        return max_depth\n\n    # Start the calculation with the initial dictionary at level 1\n    return _calculate_depth(d, 1)"}
{"task_id": "Mbpp/299", "solution": "def max_aggregate(tuples):\n    \"\"\"\n    Calculates the maximum aggregate from a list of (name, value) tuples.\n    Aggregates values for each unique name and returns the name with the highest sum.\n    \"\"\"\n    aggregates = {}\n    for name, value in tuples:\n        aggregates[name] = aggregates.get(name, 0) + value\n\n    if not aggregates:\n        return None  # Or raise an error, based on specific edge case handling policy\n\n    max_name, max_value = max(aggregates.items(), key=lambda item: item[1])\n    return (max_name, max_value)"}
{"task_id": "Mbpp/300", "solution": "def count_binary_seq(n: int) -> int:\n    \"\"\"\n    Counts binary sequences of length 2n where the sum of first n bits equals\n    the sum of last n bits, using the sum of squared binomial coefficients.\n    \"\"\"\n    import math\n\n    total = 0\n    for k in range(n + 1):\n        coeff = math.comb(n, k)\n        total += coeff * coeff\n    return total"}
{"task_id": "Mbpp/305", "solution": "def start_withp(word_list):\n    \"\"\"\n    Returns the first two words from a list of strings that start with 'p' (case-insensitive).\n    \"\"\"\n    p_words_found = []\n    for sentence in word_list:\n        words = sentence.split()\n        for word in words:\n            if word.lower().startswith('p'):\n                p_words_found.append(word)\n                if len(p_words_found) == 2:\n                    return tuple(p_words_found)\n    return tuple(p_words_found)"}
{"task_id": "Mbpp/306", "solution": "def max_sum_increasing_subseq(arr, n, i, k):\n    \"\"\"\n    Finds the maximum sum of an increasing subsequence that starts at an index <= i\n    and includes the element at index k, where k > i.\n    \"\"\"\n    if not (0 <= i < k < n):\n        return -1\n\n    # Coordinate Compression\n    unique_values = sorted(list(set(arr)))\n    val_to_rank = {val: r for r, val in enumerate(unique_values)}\n    num_ranks = len(unique_values)\n\n    # Fenwick Tree (BIT) for range maximum query and point update\n    # bit[x] stores the maximum sum of an increasing subsequence ending with a value\n    # whose rank corresponds to the index x-1.\n    # Initialized with 0, meaning no positive sums have been recorded yet.\n    bit = [0] * (num_ranks + 1)\n\n    def update_bit(rank_idx, value):\n        \"\"\"Updates the BIT with a new maximum value for a given rank.\"\"\"\n        bit_idx = rank_idx + 1\n        while bit_idx <= num_ranks:\n            bit[bit_idx] = max(bit[bit_idx], value)\n            bit_idx += bit_idx & (-bit_idx)\n\n    def query_bit(rank_idx):\n        \"\"\"Queries the maximum sum for ranks from 0 up to rank_idx.\"\"\"\n        max_val = 0\n        bit_idx = rank_idx + 1\n        while bit_idx > 0:\n            max_val = max(max_val, bit[bit_idx])\n            bit_idx -= bit_idx & (-bit_idx)\n        return max_val\n\n    # dp_prefix[j] stores the maximum sum of an increasing subsequence ending at index j\n    # where all elements of the subsequence are chosen from arr[0...i], and the\n    # subsequence itself starts at an index <= i.\n    dp_prefix = [float('-inf')] * (i + 1)\n\n    for j in range(i + 1): # Only iterate up to index i\n        current_val = arr[j]\n        rank_j = val_to_rank[current_val]\n\n        # Max sum if starting a new subsequence at arr[j]\n        current_max_sum_for_j = current_val\n\n        # Query BIT for max sum of subsequences ending with a value strictly less than current_val\n        # The query range is for ranks 0 to rank_j - 1.\n        prev_max_sum_from_bit = query_bit(rank_j - 1)\n\n        # If a valid previous subsequence sum exists (positive)\n        if prev_max_sum_from_bit > 0:\n            current_max_sum_for_j = max(current_max_sum_for_j, prev_max_sum_from_bit + current_val)\n\n        dp_prefix[j] = current_max_sum_for_j\n        \n        # Only update BIT if dp_prefix[j] is a valid positive sum to avoid propagating float('-inf') or negative sums as max\n        if dp_prefix[j] > 0: \n            update_bit(rank_j, dp_prefix[j])\n\n    # Now find the maximum sum of a prefix subsequence that can precede arr[k]\n    # This subsequence must end with an element arr[j] such that j <= i and arr[j] < arr[k].\n    final_max_prefix_sum = float('-inf')\n    arr_k_val = arr[k]\n\n    for j_prefix in range(i + 1):\n        if arr[j_prefix] < arr_k_val and dp_prefix[j_prefix] != float('-inf'):\n            final_max_prefix_sum = max(final_max_prefix_sum, dp_prefix[j_prefix])\n    \n    # If no valid prefix subsequence could be found, return -1.\n    # arr[k] cannot be the first element because k > i.\n    if final_max_prefix_sum == float('-inf'):\n        return -1\n    else:\n        return final_max_prefix_sum + arr_k_val"}
{"task_id": "Mbpp/308", "solution": "import heapq\nclass IntegerList:\n    \"\"\"Encapsulates a list of integers, providing size and indexed access.\"\"\"\n    def __init__(self, elements: list[int]):\n        self._elements = elements\n\n    def size(self) -> int:\n        \"\"\"Returns the number of elements in the list.\"\"\"\n        return len(self._elements)\n\n    def get(self, index: int) -> int:\n        \"\"\"Returns the element at the specified index.\"\"\"\n        return self._elements[index]\nclass ProductCalculator:\n    \"\"\"Calculates and extracts the largest products from two IntegerList instances.\"\"\"\n    def computeLargestProducts(self, list1: IntegerList, list2: IntegerList, k: int) -> list[int]:\n        \"\"\"\n        Computes the k largest products from two IntegerList instances using a min-heap.\n        The result is a list of integers sorted in descending order.\n        \"\"\"\n        if k == 0 or list1.size() == 0 or list2.size() == 0:\n            return []\n\n        min_heap = [] # Stores products as integers\n\n        for i in range(list1.size()):\n            for j in range(list2.size()):\n                prod_value = list1.get(i) * list2.get(j)\n\n                if len(min_heap) < k:\n                    heapq.heappush(min_heap, prod_value)\n                elif prod_value > min_heap[0]:\n                    heapq.heapreplace(min_heap, prod_value)\n        \n        # Convert the min-heap to a list and sort in descending order\n        result = sorted(min_heap, reverse=True)\n        return result\ndef large_product(list1: list[int], list2: list[int], k: int) -> list[int]:\n    \"\"\"\n    Finds the specified number of largest products from two given lists,\n    selecting one factor from each list.\n    \"\"\"\n    if not isinstance(k, int) or k < 0:\n        raise ValueError(\"k must be a non-negative integer.\")\n\n    if not list1 or not list2:\n        return []\n    \n    integer_list1 = IntegerList(list1)\n    integer_list2 = IntegerList(list2)\n    calculator = ProductCalculator()\n\n    return calculator.computeLargestProducts(integer_list1, integer_list2, k)"}
