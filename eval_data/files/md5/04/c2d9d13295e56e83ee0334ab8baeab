{"task_id": "Mbpp/454", "solution": "import re\nclass Word:\n    \"\"\"Represents a single word and provides methods to check its content.\"\"\"\n    def __init__(self, text: str):\n        self.text = text\n\n    def contains_z(self) -> bool:\n        \"\"\"Checks if the word contains the letter 'z' (case-insensitive).\"\"\"\n        return 'z' in self.text.lower()\nclass Text:\n    \"\"\"Domain entity representing the input text for word extraction.\"\"\"\n    def __init__(self, content: str):\n        self.content = content\n\n    def get_words(self) -> list[Word]:\n        \"\"\"Extracts alphabetic words from the text and returns them as Word objects.\"\"\"\n        words = re.findall(r\"[A-Za-z]+\", self.content)\n        return [Word(w) for w in words]\ndef text_match_wordz(text: str) -> bool:\n    \"\"\"Checks if the input text contains at least one word with the letter 'z' (case-insensitive).\"\"\"\n    txt = Text(text)\n    return any(word.contains_z() for word in txt.get_words())"}
