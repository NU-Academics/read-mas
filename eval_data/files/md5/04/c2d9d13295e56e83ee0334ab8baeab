{"task_id": "Mbpp/440", "solution": "import re\nfrom typing import Optional, Tuple\ndef find_adverb_position(sentence: str) -> Optional[Tuple[int, int, str]]:\n    \"\"\"\n    Find the first adverb and its positions in a given sentence.\n    Returns (start_index, end_index, adverb) or None.\n    \"\"\"\n    trimmed_sentence = sentence.strip()\n    tokens = trimmed_sentence.split()\n\n    if not tokens:\n        return None\n\n    current_search_start = 0\n\n    for token in tokens:\n        # Remove surrounding punctuation for adverb detection\n        clean_token = re.sub(r'^\\W+|\\W+$', '', token)\n\n        # Embedded _is_adverb logic\n        is_adverb = clean_token.lower().endswith('ly') and clean_token.islower()\n\n        if is_adverb:\n            # Find the actual start index of the original token in the sentence\n            start_of_full_token = sentence.find(token, current_search_start)\n\n            # Defensive check, though find should succeed if token came from split\n            if start_of_full_token == -1:\n                current_search_start += len(token) + 1 # Advance heuristically\n                continue\n\n            # Calculate end index for the *cleaned adverb* (exclusive end)\n            end_of_cleaned_adverb = start_of_full_token + len(clean_token)\n\n            return (start_of_full_token, end_of_cleaned_adverb, clean_token)\n\n        # Update current_search_start to prepare for the next token search\n        token_start_in_sentence = sentence.find(token, current_search_start)\n        if token_start_in_sentence != -1:\n            current_search_start = token_start_in_sentence + len(token) + 1\n        else:\n            # Fallback if find fails, to ensure loop progresses\n            current_search_start += len(token) + 1\n\n    return None"}
{"task_id": "Mbpp/441", "solution": "def surfacearea_cube(size):\n    \"\"\"\n    Calculates the surface area of a cube given its side length.\n    Delegates the calculation to an inner Cube class as per design.\n    \"\"\"\n    class Cube:\n        \"\"\"\n        Represents a cube and provides a method to compute its surface area.\n        \"\"\"\n        def __init__(self, size_param):\n            self.size = size_param\n\n        def computeSurfaceArea(self):\n            \"\"\"\n            Computes the surface area of the cube using the formula 6 * size^2.\n            \"\"\"\n            return 6 * (self.size ** 2)\n\n    cube_instance = Cube(size)\n    return cube_instance.computeSurfaceArea()"}
