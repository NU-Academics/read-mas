{"task_id": "Mbpp/619", "solution": "def move_num(input_string: str) -> str:\n    \"\"\"\n    Moves all numeric characters to the end of the given string, preserving relative order.\n    It iterates once over the string, separating digits from other characters.\n    \"\"\"\n    non_numeric_chars = []\n    numeric_chars = []\n\n    for char in input_string:\n        if char.isdigit():\n            numeric_chars.append(char)\n        else:\n            non_numeric_chars.append(char)\n\n    return \"\".join(non_numeric_chars) + \"\".join(numeric_chars)"}
{"task_id": "Mbpp/620", "solution": "def largest_subset(numbers: List[int]) -> int:\n    \"\"\"\n    Finds the size of the largest subset of numbers where every pair is divisible.\n    Uses dynamic programming after sorting the input list.\n    \"\"\"\n    nums = list(numbers)  # Create a copy to preserve the original list\n\n    if not nums:\n        return 0\n\n    nums.sort()  # Sort the numbers to simplify divisibility checks\n\n    # dp[i] stores the size of the largest divisible subset ending with nums[i]\n    dp = [1] * len(nums)\n    max_size = 1\n\n    for i in range(len(nums)):\n        for j in range(i):\n            if nums[i] % nums[j] == 0:\n                dp[i] = max(dp[i], dp[j] + 1)\n        max_size = max(max_size, dp[i])\n\n    return max_size"}
{"task_id": "Mbpp/622", "solution": "def get_median(list1, list2, n):\n    \"\"\"\n    Finds the median of two sorted lists of the same size.\n    The median is the average of the n-th and (n+1)-th elements from the combined sorted list.\n    \"\"\"\n    i = 0  # Current index for list1\n    j = 0  # Current index for list2\n    \n    # m1 stores the (k-1)-th element, m2 stores the k-th element from the merged sequence.\n    # We need the n-th and (n+1)-th elements (1-indexed).\n    m1 = -1\n    m2 = -1\n    \n    # Iterate n+1 times to find the n-th and (n+1)-th smallest elements.\n    for count in range(n + 1):\n        m1 = m2 # m1 takes the value of the previously found m2 (k-th element)\n        \n        # Compare current elements from both lists and pick the smaller one.\n        # Handle cases where one list might be exhausted.\n        if i < n and (j == n or list1[i] <= list2[j]):\n            m2 = list1[i]\n            i += 1\n        else:\n            m2 = list2[j]\n            j += 1\n            \n    # After the loop, m1 holds the n-th smallest element and m2 holds the (n+1)-th smallest element.\n    # The median is the average of these two elements.\n    return (m1 + m2) / 2.0"}
