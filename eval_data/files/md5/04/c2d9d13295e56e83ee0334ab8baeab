{"task_id": "Mbpp/96", "solution": "def divisor(n):\n    \"\"\"\n    Calculates the number of positive divisors for a given integer n.\n    Returns 0 for non-positive integers.\n    \"\"\"\n    if n <= 0:\n        return 0\n\n    count = 0\n    # Iterate from 1 up to the square root of n\n    for i in range(1, int(n**0.5) + 1):\n        if n % i == 0:\n            # If i*i is n, it's a perfect square root, so count only one divisor (i)\n            if i * i == n:\n                count += 1\n            # Otherwise, i and n/i are two distinct divisors\n            else:\n                count += 2\n    return count"}
{"task_id": "Mbpp/97", "solution": "def frequency_lists(list_of_lists):\n    \"\"\"\n    Calculates the frequency of each element in a flattened list of lists.\n    Returns a dictionary where keys are elements and values are their counts.\n    \"\"\"\n    frequency_map = {}\n    for sublist in list_of_lists:\n        for item in sublist:\n            frequency_map[item] = frequency_map.get(item, 0) + 1\n    return frequency_map"}
{"task_id": "Mbpp/98", "solution": "def multiply_num(sequence: 'Iterable[Union[int, float]]') -> float:\n    \"\"\"\n    Multiplies all numbers in the input sequence and divides the product\n    by the length of the sequence.\n\n    Raises:\n        DivisionByZeroError: If the input sequence is empty.\n    \"\"\"\n    from typing import Iterable, Union, List\n\n    class DivisionByZeroError(Exception):\n        \"\"\"Raised when attempting to divide by zero (empty sequence).\"\"\"\n        pass\n\n    class Result:\n        def __init__(self, value: float):\n            self.value = value\n\n    class NumberSequence:\n        def __init__(self, numbers: Iterable[float]):\n            self.numbers: List[float] = list(numbers)\n\n        def multiply(self) -> float:\n            product = 1.0\n            for n in self.numbers:\n                product *= n\n            return product\n\n        def divide_by_length(self) -> float:\n            if not self.numbers:\n                raise ValueError(\"Sequence is empty\")\n            return self.multiply() / len(self.numbers)\n\n    ns = NumberSequence(sequence)\n    if not ns.numbers:\n        raise DivisionByZeroError(\"Cannot divide by zero length sequence.\")\n    final_result = ns.divide_by_length()\n    return float(final_result)"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(n: int) -> str:\n    \"\"\"Converts a non-negative integer to its binary string representation.\"\"\"\n    if n == 0:\n        return \"0\"\n    bits = []\n    while n > 0:\n        bits.append(str(n & 1))\n        n >>= 1\n    return \"\".join(reversed(bits))"}
{"task_id": "Mbpp/100", "solution": "def next_smallest_palindrome(n: int) -> int:\n    \"\"\"Return the smallest palindrome integer strictly greater than *n*.\"\"\"\n    s = str(n)\n    L = len(s)\n\n    # Special case: if n consists of all 9s (e.g., 9, 99, 999)\n    # The next palindrome is 10...01 (1 followed by L-1 zeros and a 1)\n    if all(c == '9' for c in s):\n        return 10**L + 1\n\n    mid = L // 2\n    is_odd_length = (L % 2 == 1)\n\n    left_half = s[:mid]\n    \n    # Construct an initial candidate palindrome by mirroring the left half\n    # For odd length numbers, include the middle digit from the original number\n    if is_odd_length:\n        middle_digit = s[mid]\n        candidate_palindrome_str = left_half + middle_digit + left_half[::-1]\n    else:\n        candidate_palindrome_str = left_half + left_half[::-1]\n\n    # If this candidate is strictly greater than n, it's the answer\n    if int(candidate_palindrome_str) > n:\n        return int(candidate_palindrome_str)\n    \n    # Otherwise, we need to increment the 'left part' and re-mirror.\n    # The 'left part' includes the left_half and the middle_digit if length is odd.\n    prefix_to_increment_str = s[:mid + (1 if is_odd_length else 0)]\n    \n    incremented_prefix_val = int(prefix_to_increment_str) + 1\n    incremented_prefix_str = str(incremented_prefix_val)\n\n    # Form the new palindrome from the incremented prefix\n    # The new_left_half for mirroring is the first 'mid' characters of incremented_prefix_str\n    new_left_half_for_mirror = incremented_prefix_str[:mid]\n    \n    if is_odd_length:\n        # The new middle digit is the character at 'mid' index of incremented_prefix_str\n        new_middle_digit = incremented_prefix_str[mid]\n        final_palindrome_str = new_left_half_for_mirror + new_middle_digit + new_left_half_for_mirror[::-1]\n    else:\n        final_palindrome_str = new_left_half_for_mirror + new_left_half_for_mirror[::-1]\n\n    return int(final_palindrome_str)"}
