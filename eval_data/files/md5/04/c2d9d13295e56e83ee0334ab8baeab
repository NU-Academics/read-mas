{"task_id": "Mbpp/395", "solution": "from typing import Optional\nclass StringProcessor:\n    \"\"\"Helper class to encapsulate string processing logic.\"\"\"\n\n    def first_non_repeating_character(self, s: str) -> Optional[str]:\n        \"\"\"Finds the first non-repeating character in the given string.\"\"\"\n        char_counts = {}\n        for char in s:\n            char_counts[char] = char_counts.get(char, 0) + 1\n\n        for char in s:\n            if char_counts[char] == 1:\n                return char\n        return None\ndef first_non_repeating_character(s: str) -> Optional[str]:\n    \"\"\"Finds the first non-repeating character in a given string.\"\"\"\n    processor = StringProcessor()\n    return processor.first_non_repeating_character(s)"}
