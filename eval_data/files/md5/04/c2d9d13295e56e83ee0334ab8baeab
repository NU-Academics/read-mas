{"task_id": "Mbpp/739", "solution": "def find_Index(n: int) -> int:\n    \"\"\"\n    Finds the index of the smallest triangular number with exactly n digits.\n    Iteratively computes triangular numbers and checks their digit count.\n    \"\"\"\n    k = 1\n    while True:\n        triangular_number = k * (k + 1) // 2\n        if len(str(triangular_number)) == n:\n            return k\n        k += 1"}
{"task_id": "Mbpp/740", "solution": "def tuple_to_dict(t: Tuple[Any, ...]) -> Dict[Any, Any]:\n    \"\"\"\n    Convert a tuple of even length into a dictionary by pairing adjacent elements.\n\n    Parameters\n    ----------\n    t : Tuple[Any, ...]\n        Input tuple containing an even number of elements.\n\n    Returns\n    -------\n    Dict[Any, Any]\n        Dictionary where each key is an element at an odd index and its value\n        is the following element.\n\n    Raises\n    ------\n    TypeError\n        If the input is not a tuple.\n    ValueError\n        If the input tuple has an odd number of elements.\n    \"\"\"\n    if not isinstance(t, tuple):\n        raise TypeError(f\"Expected tuple, got {type(t).__name__}\")\n\n    if len(t) % 2 != 0:\n        raise ValueError(\"Tuple must contain an even number of elements\")\n\n    return {t[i]: t[i + 1] for i in range(0, len(t), 2)}"}
{"task_id": "Mbpp/743", "solution": "def rotate_right(lst, n):\n    \"\"\"\n    Rotates a list to the right by n positions.\n    Handles empty lists and normalizes n for rotations greater than list length.\n    \"\"\"\n    length = len(lst)\n    if length == 0:\n        return []\n\n    effective_n = n % length\n    return lst[-effective_n:] + lst[:-effective_n]"}
{"task_id": "Mbpp/741", "solution": "def all_Characters_Same(input_string):\n    \"\"\"Check if all characters in the given string are identical.\"\"\"\n    if len(input_string) <= 1:\n        return True\n    first_char = input_string[0]\n    for ch in input_string[1:]:\n        if ch != first_char:\n            return False\n    return True"}
{"task_id": "Mbpp/742", "solution": "def area_tetrahedron(side):\n    \"\"\"\n    Calculates the surface area of a regular tetrahedron given its side length.\n    Raises ValueError if the side length is not a positive number.\n    \"\"\"\n    import math\n\n    if not isinstance(side, (int, float)) or side <= 0:\n        raise ValueError(\"Side length must be a positive number.\")\n\n    area = math.sqrt(3) * (side ** 2)\n    return area"}
{"task_id": "Mbpp/744", "solution": "def check_none(t):\n    \"\"\"Checks if the given tuple has any None value.\"\"\"\n    return any(item is None for item in t)"}
{"task_id": "Mbpp/748", "solution": "def capital_words_spaces(text: str) -> str:\n    \"\"\"\n    Inserts spaces between words starting with capital letters in a given string.\n    A space is inserted if a capital letter is not the first character and not preceded by a space.\n    \"\"\"\n    result_chars = []\n    for i, char in enumerate(text):\n        # Insert a space if the current character is an uppercase letter,\n        # it's not the first character, and the previous character was not a space.\n        if char.isupper() and i > 0 and text[i - 1] != ' ':\n            result_chars.append(' ')\n        result_chars.append(char)\n    return \"\".join(result_chars)"}
{"task_id": "Mbpp/745", "solution": "def divisible_by_digits(startnum, endnum):\n    \"\"\"\n    Finds numbers within a given range where every number is divisible by every digit it contains.\n    Numbers containing the digit 0 are skipped.\n    \"\"\"\n    result = []\n    if startnum > endnum:\n        return result\n\n    for num in range(startnum, endnum + 1):\n        s_num = str(num)\n        \n        current_num_digits = []\n        has_zero = False\n        for char_digit in s_num:\n            digit = int(char_digit)\n            if digit == 0:\n                has_zero = True\n                break\n            current_num_digits.append(digit)\n        \n        if has_zero:\n            continue\n\n        is_divisible_by_all_digits = True\n        for digit in current_num_digits:\n            if num % digit != 0:\n                is_divisible_by_all_digits = False\n                break\n        \n        if is_divisible_by_all_digits:\n            result.append(num)\n            \n    return result"}
{"task_id": "Mbpp/749", "solution": "from typing import List\nclass NumericString:\n    \"\"\"Encapsulates a numeric string and provides conversion to int.\"\"\"\n    def __init__(self, value: str):\n        self._value = value\n\n    def toInt(self) -> int:\n        \"\"\"Converts the string value to an integer, raising ValueError if invalid.\"\"\"\n        try:\n            return int(self._value)\n        except ValueError:\n            raise ValueError(f\"Invalid numeric string: '{self._value}'\")\nclass Sorter:\n    \"\"\"Handles the logic for sorting a list of numeric strings.\"\"\"\n    def sort_numeric_strings(self, numbers: List[str]) -> List[int]:\n        \"\"\"\n        Converts and sorts a list of numeric strings into a numerically sorted list of integers.\n        Raises ValueError if any input string is not a valid number.\n        \"\"\"\n        converted_numbers = []\n        for num_str in numbers:\n            numeric_str_obj = NumericString(num_str)\n            converted_numbers.append(numeric_str_obj.toInt())\n        \n        converted_numbers.sort()\n        return converted_numbers\ndef sort_numeric_strings(numbers: List[str]) -> List[int]:\n    \"\"\"\n    Sorts a list of strings of numbers numerically.\n    Raises ValueError if any string in the input list cannot be converted to an integer.\n    \"\"\"\n    sorter = Sorter()\n    return sorter.sort_numeric_strings(numbers)"}
