{"task_id": "Mbpp/605", "solution": "import math\nclass PrimeNumber:\n    \"\"\"Encapsulates an integer value and provides a method to check its primality.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def isPrime(self) -> bool:\n        \"\"\"Determines if the encapsulated integer is a prime number.\"\"\"\n        if self.value <= 1:\n            return False\n        if self.value == 2:\n            return True\n        if self.value % 2 == 0:\n            return False\n        for i in range(3, int(math.sqrt(self.value)) + 1, 2):\n            if self.value % i == 0:\n                return False\n        return True\ndef prime_num(n: int) -> bool:\n    \"\"\"Checks if the given integer is a prime number by using the PrimeNumber entity.\"\"\"\n    prime_entity = PrimeNumber(n)\n    return prime_entity.isPrime()"}
{"task_id": "Mbpp/603", "solution": "def get_ludic(n):\n    \"\"\"\n    Calculates all lucid numbers up to a given integer n.\n    Lucid numbers are defined as 1 and all prime numbers.\n    \"\"\"\n    if n < 1:\n        return []\n\n    lucid_numbers = [1]\n\n    if n == 1:\n        return lucid_numbers\n\n    # Use Sieve of Eratosthenes to find primes up to n\n    is_prime = [True] * (n + 1)\n    is_prime[0] = False\n    is_prime[1] = False\n\n    for p in range(2, int(n**0.5) + 1):\n        if is_prime[p]:\n            for multiple in range(p * p, n + 1, p):\n                is_prime[multiple] = False\n\n    # Collect primes and append to lucid_numbers\n    for i in range(2, n + 1):\n        if is_prime[i]:\n            lucid_numbers.append(i)\n\n    return lucid_numbers"}
{"task_id": "Mbpp/607", "solution": "import re\nfrom typing import Optional, Tuple\ndef find_literals(target: str, pattern: str) -> Optional[Tuple[str, int, int]]:\n    \"\"\"\n    Searches a string for a regex pattern and returns the matching substring,\n    its start index (inclusive), and end index (exclusive).\n    \"\"\"\n    try:\n        compiled_pattern = re.compile(pattern)\n    except re.error as e:\n        raise ValueError(f\"Invalid regex pattern: {e}\") from e\n\n    match = compiled_pattern.search(target)\n    if match:\n        return match.group(0), match.start(), match.end()\n    return None"}
{"task_id": "Mbpp/611", "solution": "def max_of_nth(matrix: list[list[int]], n: int) -> int:\n    \"\"\"Finds the maximum value in the nth column of a given matrix.\n    Assumes a non-empty matrix with consistent row lengths and a valid column index.\n    \"\"\"\n    max_val = matrix[0][n]\n    for i in range(1, len(matrix)):\n        if matrix[i][n] > max_val:\n            max_val = matrix[i][n]\n    return max_val"}
{"task_id": "Mbpp/608", "solution": "def bell_Number(n: int) -> int:\n    # Handles the base case: the 0th Bell number is 1.\n    if n == 0:\n        return 1\n\n    # Initialize 'previous_row' to represent the values of T(i-1, k) in the Bell triangle.\n    # For i=1, this will store T(0,k), where T(0,0) is 1.\n    previous_row = [0] * (n + 1)\n    previous_row[0] = 1\n\n    # Initialize 'current_row' to store the values of T(i, k).\n    current_row = [0] * (n + 1)\n\n    # Iteratively compute rows of the Bell triangle from row 1 up to row 'n'.\n    for i in range(1, n + 1):\n        # The first element of the current row T(i,0) is the last element of the previous row T(i-1, i-1).\n        current_row[0] = previous_row[i-1]\n\n        # Compute the remaining elements in the current row using the recurrence T(i,j) = T(i,j-1) + T(i-1,j-1).\n        for j in range(1, i + 1):\n            current_row[j] = current_row[j-1] + previous_row[j-1]\n        \n        # The newly computed current_row becomes the previous_row for the next iteration.\n        previous_row = current_row[:]\n\n    # The nth Bell number, B(n), is the first element of the nth row in the Bell triangle.\n    return previous_row[0]"}
