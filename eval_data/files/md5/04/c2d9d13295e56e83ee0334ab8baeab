{"task_id": "Mbpp/428", "solution": "def shell_sort(array):\n    \"\"\"Sorts a list of integers using the Shell sort algorithm.\"\"\"\n    n_arr = list(array)  # Create a copy to avoid modifying the original list\n    n = len(n_arr)\n\n    gap = n // 2\n    while gap > 0:\n        for i in range(gap, n):\n            temp = n_arr[i]\n            j = i\n            while j >= gap and n_arr[j - gap] > temp:\n                n_arr[j] = n_arr[j - gap]\n                j -= gap\n            n_arr[j] = temp\n        gap //= 2\n    return n_arr"}
{"task_id": "Mbpp/427", "solution": "import re\nclass InvalidDateFormatException(ValueError):\n    \"\"\"Raised when the input date string does not match yyyy-mm-dd format.\"\"\"\n    pass\nDATE_PATTERN = re.compile(r\"^(?P<year>\\d{4})-(?P<month>\\d{2})-(?P<day>\\d{2})$\")\ndef change_date_format(date_str: str) -> str:\n    \"\"\"Convert a date string from yyyy-mm-dd to dd-mm-yyyy.\n\n    Raises InvalidDateFormatException if the input does not match the expected format.\n    \"\"\"\n    match = DATE_PATTERN.match(date_str)\n    if not match:\n        raise InvalidDateFormatException(\n            f\"Invalid date format: {date_str!r}. Expected 'yyyy-mm-dd'.\"\n        )\n    day = match.group(\"day\")\n    month = match.group(\"month\")\n    year = match.group(\"year\")\n    return f\"{day}-{month}-{year}\""}
