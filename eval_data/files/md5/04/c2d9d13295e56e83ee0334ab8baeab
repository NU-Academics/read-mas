{"task_id": "Mbpp/643", "solution": "import re\nfrom typing import List\ndef _split_into_words(text: str) -> List[str]:\n    \"\"\"\n    Split the input text into words, defined as contiguous alphabetic sequences.\n    Leading and trailing punctuation is ignored.\n    \"\"\"\n    return re.findall(r\"[A-Za-z]+\", text)\ndef _has_middle_z(word: str) -> bool:\n    \"\"\"\n    Return True if the word contains a lowercase 'z' that is not the first\n    or last character.\n    \"\"\"\n    if len(word) < 3:\n        return False\n    return 'z' in word[1:-1]\ndef text_match_wordz_middle(input_string: str) -> bool:\n    \"\"\"\n    Determine whether the input string contains a 'z' in the middle of any word.\n    Words are sequences of alphabetic characters separated by whitespace or punctuation.\n    \"\"\"\n    words = _split_into_words(input_string)\n    for word in words:\n        if _has_middle_z(word):\n            return True\n    return False"}
{"task_id": "Mbpp/644", "solution": "def reverse_Array_Upto_K(array: list, k: int) -> list:\n    \"\"\"\n    Return a new list with the first k elements of `array` reversed.\n    The original `array` remains unchanged.\n    \"\"\"\n    if k > len(array):\n        raise ValueError(f\"k ({k}) cannot be greater than array length ({len(array)}).\")\n\n    reversed_part = list(reversed(array[:k]))\n    return reversed_part + array[k:]"}
