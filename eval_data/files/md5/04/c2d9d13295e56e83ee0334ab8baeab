{"task_id": "Mbpp/597", "solution": "from typing import List\ndef find_kth(arr1: List[int], arr2: List[int], k: int) -> int:\n    \"\"\"Return the k\u2011th smallest element from two sorted integer arrays.\n    Raises IndexError if k is out of bounds.\"\"\"\n    _validate_inputs(arr1, arr2, k)\n\n    m, n = len(arr1), len(arr2)\n    # Ensure arr1 is the smaller array for binary search optimization\n    if m > n:\n        return find_kth(arr2, arr1, k)\n\n    low, high = 0, min(k, m)\n    while low <= high:\n        i = (low + high) // 2\n        j = k - i\n\n        arr1_left = arr1[i - 1] if i > 0 else float('-inf')\n        arr1_right = arr1[i] if i < m else float('inf')\n        arr2_left = arr2[j - 1] if j > 0 else float('-inf')\n        arr2_right = arr2[j] if j < n else float('inf')\n\n        if arr1_left <= arr2_right and arr2_left <= arr1_right:\n            return max(arr1_left, arr2_left)\n        elif arr1_left > arr2_right:\n            high = i - 1\n        else: # arr2_left > arr1_right\n            low = i + 1"}
{"task_id": "Mbpp/599", "solution": "from typing import Tuple\nclass NumberSequence:\n    def __init__(self, n: int):\n        self.n = n\n\n    def sum(self) -> int:\n        return self.n * (self.n + 1) // 2\n\n    def average(self) -> float:\n        return self.sum() / self.n\nclass Result:\n    def __init__(self, sum_: int, average_: float):\n        self.sum = sum_\n        self.average = average_\ndef sum_average(n: int) -> Tuple[int, float]:\n    seq = NumberSequence(n)\n    result = Result(seq.sum(), seq.average())\n    return (result.sum, result.average)"}
