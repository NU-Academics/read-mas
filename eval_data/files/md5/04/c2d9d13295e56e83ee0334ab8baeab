{"task_id": "Mbpp/751", "solution": "def check_min_heap(arr):\n    n = len(arr)\n    # An empty array or an array with one element is considered a valid min-heap.\n    if n <= 1:\n        return True\n\n    # Iterate only through parent nodes.\n    # Parent nodes are at indices from 0 up to (n // 2) - 1.\n    for i in range(n // 2):\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        # Check if the parent is greater than its left child\n        if arr[i] > arr[left_child_idx]:\n            return False\n\n        # Check if the right child exists and if the parent is greater than its right child\n        if right_child_idx < n and arr[i] > arr[right_child_idx]:\n            return False\n\n    return True"}
{"task_id": "Mbpp/752", "solution": "def jacobsthal_num(n):\n    \"\"\"\n    Calculates the nth Jacobsthal number using an iterative approach.\n    The sequence is defined by J(0)=0, J(1)=1, and J(n) = J(n-1) + 2*J(n-2) for n > 1.\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 1\n    else:\n        prev2 = 0  # Represents J(i-2)\n        prev1 = 1  # Represents J(i-1)\n        for _ in range(2, n + 1):\n            current = prev1 + 2 * prev2\n            prev2 = prev1\n            prev1 = current\n        return prev1"}
{"task_id": "Mbpp/753", "solution": "from typing import List, Tuple\nimport heapq\ndef min_k(records: List[Tuple[str, int]], k: int) -> List[Tuple[str, int]]:\n    \"\"\"\n    Return the k tuples with the smallest second element, sorted ascending.\n    Handles edge cases for k and empty records.\n    \"\"\"\n    if k <= 0 or not records:\n        return []\n\n    if k >= len(records):\n        return sorted(records, key=lambda x: x[1])\n\n    return heapq.nsmallest(k, records, key=lambda x: x[1])"}
{"task_id": "Mbpp/754", "solution": "def extract_index_list(l1, l2, l3):\n    \"\"\"\n    Finds elements that appear in all three lists under the same index.\n    Returns a list of these common elements in index order.\n    \"\"\"\n    common_elements = []\n    min_len = min(len(l1), len(l2), len(l3))\n\n    for i in range(min_len):\n        if l1[i] == l2[i] == l3[i]:\n            common_elements.append(l1[i])\n\n    return common_elements"}
{"task_id": "Mbpp/755", "solution": "def second_smallest(numbers):\n    \"\"\"\n    Finds the second smallest distinct number in a list.\n    Assumes the input list contains at least two distinct numeric values.\n    \"\"\"\n    min_val = None\n    second_min = None\n    for n in numbers:\n        if min_val is None or n < min_val:\n            second_min = min_val\n            min_val = n\n        elif n != min_val and (second_min is None or n < second_min):\n            second_min = n\n    return second_min"}
{"task_id": "Mbpp/757", "solution": "def count_reverse_pairs(strings: List[str]) -> int:\n    freq = {}\n    for s in strings:\n        key = s.lower()\n        freq[key] = freq.get(key, 0) + 1\n\n    count = 0\n    processed = set()\n    for s, f in freq.items():\n        rev = s[::-1]\n        if rev in freq and rev not in processed:\n            if s == rev:  # Palindrome\n                count += f * (f - 1) // 2\n            else:  # Non-palindrome pair\n                count += f * freq[rev]\n        processed.add(s)\n    return count"}
{"task_id": "Mbpp/758", "solution": "def unique_sublists(input_list):\n    \"\"\"Counts occurrences of unique sublists, converting them to tuples as dictionary keys.\"\"\"\n    counts = {}\n    for sublist in input_list:\n        sublist_tuple = tuple(sublist)\n        counts[sublist_tuple] = counts.get(sublist_tuple, 0) + 1\n    return counts"}
{"task_id": "Mbpp/759", "solution": "import re\ndef is_decimal(input_string):\n    \"\"\"\n    Checks if the input string is a decimal number with exactly two decimal places.\n    The string must not have leading/trailing whitespace after trimming.\n    \"\"\"\n    trimmed_string = input_string.strip()\n    pattern = re.compile(r\"^\\d+\\.\\d{2}$\")\n    return bool(pattern.match(trimmed_string))"}
{"task_id": "Mbpp/760", "solution": "class NumberList:\n    \"\"\"Represents a list of numbers for analysis.\"\"\"\n    def __init__(self, elements: list):\n        self.elements = elements\nclass UniqueElementChecker:\n    \"\"\"Checks if a NumberList contains only one distinct element.\"\"\"\n    def check(self, number_list: NumberList) -> bool:\n        \"\"\"Determines if the provided NumberList has only one unique element.\"\"\"\n        return len(set(number_list.elements)) == 1\ndef unique_Element(numbers: list) -> bool:\n    \"\"\"\n    Checks if a list of numbers contains only one distinct element.\n    It utilizes NumberList and UniqueElementChecker classes internally.\n    \"\"\"\n    number_list_obj = NumberList(numbers)\n    return UniqueElementChecker().check(number_list_obj)"}
{"task_id": "Mbpp/762", "solution": "from typing import Set\n_30_DAY_MONTHS: Set[int] = {4, 6, 9, 11}\ndef check_monthnumber_number(month: int) -> bool:\n    \"\"\"\n    Determine whether the given month number contains 30 days.\n    Raises TypeError for non-integer input or ValueError for out-of-range values.\n    \"\"\"\n    if not isinstance(month, int):\n        raise TypeError(f\"Month must be an integer, got {type(month).__name__}\")\n\n    if not 1 <= month <= 12:\n        raise ValueError(f\"Month must be between 1 and 12 inclusive, got {month}\")\n\n    return month in _30_DAY_MONTHS"}
