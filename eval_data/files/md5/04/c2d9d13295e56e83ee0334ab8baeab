{"task_id": "Mbpp/566", "solution": "def sum_digits(value):\n    \"\"\"Calculates the sum of the digits of a non-negative integer.\"\"\"\n    total_sum = 0\n    while value > 0:\n        total_sum += value % 10\n        value //= 10\n    return total_sum"}
{"task_id": "Mbpp/576", "solution": "def is_Sub_Array(main_list, sub_list):\n    \"\"\"\n    Checks if `sub_list` is a contiguous sublist of `main_list`.\n    Returns True if `sub_list` is found, False otherwise.\n    \"\"\"\n    n = len(main_list)\n    m = len(sub_list)\n\n    if m == 0:\n        return True\n    if m > n:\n        return False\n\n    for i in range(n - m + 1):\n        if main_list[i:i+m] == sub_list:\n            return True\n    return False"}
{"task_id": "Mbpp/577", "solution": "def last_Digit_Factorial(n: int) -> int:\n    \"\"\"\n    Finds the last decimal digit of n!.\n    For n >= 5, the last digit is 0.\n    \"\"\"\n    if n < 5:\n        # Calculate factorial directly for small n\n        fact = 1\n        for i in range(2, n + 1):\n            fact *= i\n        return fact % 10\n    else:\n        # For n >= 5, n! will always end in 0.\n        return 0"}
{"task_id": "Mbpp/578", "solution": "def interleave_lists(list1, list2, list3):\n    \"\"\"\n    Interleaves three lists of the same length into a single flat list.\n    Raises ValueError if input lists are not of equal length.\n    \"\"\"\n    len1 = len(list1)\n    if len1 != len(list2) or len1 != len(list3):\n        raise ValueError(\"Input lists must be of equal length.\")\n\n    result = []\n    for i in range(len1):\n        result.append(list1[i])\n        result.append(list2[i])\n        result.append(list3[i])\n    return result"}
{"task_id": "Mbpp/579", "solution": "def find_dissimilar(tuple1, tuple2):\n    \"\"\"\n    Finds elements that are present in one tuple but not in the other,\n    preserving the order of first appearance and removing duplicates.\n    \"\"\"\n    set1 = set(tuple1)\n    set2 = set(tuple2)\n    \n    dissimilar_elements = []\n    seen = set()\n    \n    # Add elements from tuple1 that are not in tuple2\n    for item in tuple1:\n        if item not in set2 and item not in seen:\n            dissimilar_elements.append(item)\n            seen.add(item)\n            \n    # Add elements from tuple2 that are not in tuple1\n    for item in tuple2:\n        if item not in set1 and item not in seen:\n            dissimilar_elements.append(item)\n            seen.add(item)\n            \n    return tuple(dissimilar_elements)"}
{"task_id": "Mbpp/580", "solution": "def extract_even(data):\n    \"\"\"\n    Removes uneven elements from a nested mixed tuple, preserving the nested structure for even integers.\n    Non-integer elements are ignored.\n    \"\"\"\n    result = []\n    for item in data:\n        if isinstance(item, int):\n            if item % 2 == 0:\n                result.append(item)\n        elif isinstance(item, tuple):\n            sub_tuple_result = extract_even(item)\n            if sub_tuple_result:\n                result.append(sub_tuple_result)\n    return tuple(result)"}
{"task_id": "Mbpp/581", "solution": "import math\ndef surface_Area(base_edge: float, height: float) -> float:\n    \"\"\"\n    Calculates the surface area of a square pyramid given its base edge and height.\n    Raises ValueError for non-positive base_edge or height.\n    \"\"\"\n    if base_edge <= 0 or height <= 0:\n        raise ValueError(\"Base edge and height must be positive values.\")\n\n    # Base area: a^2\n    base_area = base_edge ** 2\n\n    # Slant height: sqrt((a/2)^2 + h^2)\n    slant_height = math.sqrt((base_edge / 2) ** 2 + height ** 2)\n\n    # Lateral surface area: 2 * a * l (sum of 4 triangular faces)\n    lateral_surface_area = 2 * base_edge * slant_height\n\n    # Total surface area = base area + lateral surface area\n    total_surface_area = base_area + lateral_surface_area\n\n    return total_surface_area"}
{"task_id": "Mbpp/583", "solution": "_catalan_memo = {0: 1}\ndef catalan_number(n: int) -> int:\n    \"\"\"\n    Returns the nth Catalan number using memoization.\n    Calculates C_n using the recurrence C_n = sum(C_i * C_{n-1-i}) for i from 0 to n-1.\n    \"\"\"\n    if n in _catalan_memo:\n        return _catalan_memo[n]\n\n    total = 0\n    for i in range(n):\n        total += catalan_number(i) * catalan_number(n - 1 - i)\n\n    _catalan_memo[n] = total\n    return total"}
{"task_id": "Mbpp/585", "solution": "def expensive_items(items, n):\n    \"\"\"\n    Finds the n most expensive items in a list of dictionaries, sorted by price in descending order.\n    Validates input and raises ValueError for invalid data.\n    \"\"\"\n    if not isinstance(items, list):\n        raise ValueError(\"Input 'items' must be a list.\")\n    if not all(isinstance(item, dict) and 'name' in item and 'price' in item for item in items):\n        raise ValueError(\"Each item in 'items' must be a dictionary with 'name' and 'price' keys.\")\n    if not all(isinstance(item['price'], (int, float)) for item in items):\n        raise ValueError(\"Item 'price' must be a numeric value.\")\n    if not isinstance(n, int) or n < 0:\n        raise ValueError(\"'n' must be a non-negative integer.\")\n    if n > len(items):\n        raise ValueError(\"'n' cannot be greater than the number of items.\")\n\n    sorted_items = sorted(items, key=lambda x: x['price'], reverse=True)\n    return sorted_items[:n]"}
