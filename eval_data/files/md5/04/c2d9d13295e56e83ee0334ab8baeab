{"task_id": "Mbpp/4", "solution": "import heapq\ndef heap_queue_largest(numbers: list, n: int) -> list:\n    \"\"\"Finds the n largest integers from a list, returned in descending order.\"\"\"\n    if not numbers or n <= 0:\n        return []\n    \n    if n >= len(numbers):\n        return sorted(numbers, reverse=True)\n    \n    return heapq.nlargest(n, numbers)"}
{"task_id": "Mbpp/7", "solution": "import string\ndef find_char_long(text):\n    \"\"\"\n    Finds all unique words at least 4 characters long in a given string,\n    stripping leading/trailing punctuation.\n    \"\"\"\n    long_words = set()\n    punctuation_chars = string.punctuation\n    words = text.split()\n    for word in words:\n        cleaned_word = word.strip(punctuation_chars)\n        if len(cleaned_word) >= 4:\n            long_words.add(cleaned_word)\n    return long_words"}
{"task_id": "Mbpp/11", "solution": "def remove_Occ(string: str, char: str) -> str:\n    \"\"\"Removes the first and last occurrence of a given character from the string.\"\"\"\n    if len(char) != 1:\n        raise ValueError(\"The 'char' argument must be a single character.\")\n\n    first_index = string.find(char)\n    if first_index == -1:\n        return string\n\n    last_index = string.rfind(char)\n\n    if first_index == last_index:\n        # Only one occurrence of the character\n        return string[:first_index] + string[first_index+1:]\n    else:\n        # Multiple occurrences: remove first and last\n        s_without_first = string[:first_index] + string[first_index+1:]\n        # The last_index needs to be adjusted because the string has changed length by 1\n        # if the original last_index was after the original first_index.\n        # However, it's safer and cleaner to find rfind again on the new string.\n        # But if we consider the relative position to the start of the string,\n        # the original last_index will be `last_index - 1` in the `s_without_first` string\n        # only if the last_index was greater than first_index.\n        # A simpler approach is to work with parts.\n        \n        # This implementation strategy is prone to indexing errors for last_index.\n        # Let's consider a robust way:\n        \n        # First, remove the last occurrence to avoid shifting issues with the first one.\n        # This is not what the current approach does (it removes first then tries to remove last on modified).\n        # Let's stick to the current approach to fulfill \"remove first and last occurrence\" sequentially.\n        \n        # Re-evaluating the current approach:\n        # string[:first_index] + string[first_index+1:last_index] + string[last_index+1:]\n        # This works if first_index and last_index are distinct.\n        # Example: \"banana\", \"a\"\n        # first_index = 1, last_index = 5\n        # \"b\" + \"nana\" + \"\" = \"bnana\"\n        # Wait, this is not removing the *first and last*, it's removing *everything between* first and last.\n        # The correct logic for removing the first and last separate occurrences is:\n        # Remove first: string[:first_index] + string[first_index+1:]\n        # In this new string, find the last occurrence of char.\n        # This is more complex than it needs to be.\n        \n        # A simpler way is to construct the string by identifying the characters to keep.\n        # The problem asks to remove the first and last occurrence.\n        #\n        # Let's retry with the simpler, direct logic for distinct first and last indices.\n        # Example: \"hello\", \"l\"\n        # first_index = 2 ('l' at index 2)\n        # last_index = 3 ('l' at index 3)\n        # We need \"he\" + \"o\" = \"heo\"\n        #\n        # string[:first_index] -> \"he\"\n        # string[first_index+1:last_index] -> \"\" (empty string, as 3 is not greater than 3) -> this is wrong\n        # string[last_index+1:] -> \"o\"\n        # So \"he\" + \"\" + \"o\" = \"heo\"\n        # This logic actually works for \"hello\", \"l\" == \"heo\".\n        #\n        # Let's test \"banana\", \"a\"\n        # first_index = 1\n        # last_index = 5\n        # string[:first_index] -> \"b\"\n        # string[first_index+1:last_index] -> \"nan\"\n        # string[last_index+1:] -> \"\"\n        # Result: \"bnan\" -- This is correct. \"banana\" -> \"bnaa\" -> \"bna\"\n        # \"b\" + \"anana\" -> \"bnana\" -> \"bnan\"\n        \n        # It seems the logic `string[:first_index] + string[first_index+1:last_index] + string[last_index+1:]`\n        # is indeed the correct one when first_index != last_index.\n        return string[:first_index] + string[first_index+1:last_index] + string[last_index+1:]"}
