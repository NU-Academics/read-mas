{"task_id": "Mbpp/162", "solution": "def sum_series(n: int) -> int:\n    \"\"\"\n    Calculates the sum of the series n + (n-2) + (n-4) + ... until the term is <= 0.\n    Returns 0 if n is less than or equal to 0.\n    \"\"\"\n    if n <= 0:\n        return 0\n\n    total = 0\n    current = n\n    while current > 0:\n        total += current\n        current -= 2\n    return total"}
{"task_id": "Mbpp/165", "solution": "def count_char_position(value: str) -> int:\n    \"\"\"\n    Counts characters in a string that match their English alphabet position (1-based, case-insensitive).\n    \"\"\"\n    count = 0\n    lower_value = value.lower()\n    for i, char in enumerate(lower_value):\n        if 'a' <= char <= 'z':\n            # Calculate 1-based alphabet position\n            alphabet_pos = ord(char) - ord('a') + 1\n            # Compare with 1-based string position\n            if alphabet_pos == (i + 1):\n                count += 1\n    return count"}
{"task_id": "Mbpp/167", "solution": "def next_power_of_2(n: int) -> int:\n    \"\"\"\n    Return the smallest power of two greater than or equal to n.\n    Handles n == 0 by returning 1.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    if (n & (n - 1)) == 0:  # Check if n is already a power of two\n        return n\n\n    return 1 << n.bit_length()"}
{"task_id": "Mbpp/166", "solution": "def find_even_pair(numbers: list[int]) -> int:\n    \"\"\"\n    Counts pairs in a list that XOR to an even number.\n    Pairs XOR to an even number if they have the same parity.\n    \"\"\"\n    n = len(numbers)\n    if n < 2:\n        return 0\n\n    even_count = 0\n    odd_count = 0\n\n    for num in numbers:\n        if num % 2 == 0:\n            even_count += 1\n        else:\n            odd_count += 1\n\n    # C(n, 2) = n * (n - 1) / 2\n    pairs_with_even_xor = (even_count * (even_count - 1)) // 2 + \\\n                          (odd_count * (odd_count - 1)) // 2\n\n    return pairs_with_even_xor"}
