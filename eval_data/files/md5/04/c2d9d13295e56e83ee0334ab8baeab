{"task_id": "Mbpp/414", "solution": "def overlapping(seq1, seq2):\n    \"\"\"\n    Checks if any value in seq1 exists in seq2.\n    Uses set conversion for efficient lookup, optimizing for the smaller sequence.\n    \"\"\"\n    if len(seq1) < len(seq2):\n        smaller_seq = seq1\n        larger_seq = seq2\n    else:\n        smaller_seq = seq2\n        larger_seq = seq1\n\n    smaller_set = set(smaller_seq)\n\n    for item in larger_seq:\n        if item in smaller_set:\n            return True\n    return False"}
{"task_id": "Mbpp/418", "solution": "from typing import List, Any\ndef Find_Max(elements: List[List[Any]]) -> List[Any]:\n    \"\"\"\n    Finds the element with the maximum length in a list of elements.\n    Each element is expected to be a list itself.\n    \"\"\"\n    max_elem = elements[0]\n    max_len = len(max_elem)\n    for elem in elements[1:]:\n        if len(elem) > max_len:\n            max_elem = elem\n            max_len = len(elem)\n    return max_elem"}
{"task_id": "Mbpp/419", "solution": "def round_and_sum(numbers):\n    \"\"\"\n    Rounds each number in the list, sums them, and multiplies the sum by the list's length.\n    Returns 0 for an empty list.\n    \"\"\"\n    if not numbers:\n        return 0\n\n    total_rounded_sum = 0\n    for num in numbers:\n        total_rounded_sum += round(num)\n\n    return int(total_rounded_sum * len(numbers))"}
{"task_id": "Mbpp/415", "solution": "def max_Product(arr):\n    \"\"\"\n    Finds a pair of integers with the highest product from a given array.\n    This implementation runs in O(n) time and O(1) space.\n    \"\"\"\n    if len(arr) < 2:\n        raise ValueError(\"Input array must contain at least two elements.\")\n\n    max1 = -float('inf')\n    max2 = -float('inf')\n    min1 = float('inf')\n    min2 = float('inf')\n\n    for num in arr:\n        # Update the two largest numbers\n        if num >= max1:\n            max2 = max1\n            max1 = num\n        elif num > max2:\n            max2 = num\n\n        # Update the two smallest numbers\n        if num <= min1:\n            min2 = min1\n            min1 = num\n        elif num < min2:\n            min2 = num\n\n    product_of_max_positives = max1 * max2\n    product_of_min_negatives = min1 * min2\n\n    if product_of_max_positives >= product_of_min_negatives:\n        return tuple(sorted((max1, max2)))\n    else:\n        return tuple(sorted((min1, min2)))"}
{"task_id": "Mbpp/420", "solution": "def cube_Sum(n: int) -> int:\n    \"\"\"\n    Return the sum of cubes of the first n even natural numbers.\n    The function calculates the sum of (2k)^3 for k from 1 to n.\n    \"\"\"\n    total = 0\n    for k in range(1, n + 1):\n        even = 2 * k\n        total += even ** 3\n    return total"}
