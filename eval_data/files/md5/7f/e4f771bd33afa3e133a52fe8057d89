ents current depth.\"\"\"\n        self._current -= 1\n\n    def reset(self) -> None:\n        \"\"\"Resets current and maximum depth to zero.\"\"\"\n        self._current = 0\n        self._max = 0\n\n    def get_max(self) -> int:\n        \"\"\"Returns the maximum depth observed.\"\"\"\n        return self._max\nclass ParenthesisGroup:\n    \"\"\"Encapsulates a single group string and computes its maximum nesting depth.\"\"\"\n    def __init__(self, group_string: str) -> None:\n        self.group_string = group_string\n\n    def compute_max_depth(self) -> int:\n        \"\"\"Computes the maximum nesting depth for the group's string.\"\"\"\n        depth_counter = DepthCounter()\n        for char in self.group_string:\n            if char == '(':\n                depth_counter.inc()\n            elif char == ')':\n                depth_counter.dec()\n        return depth_counter.get_max()\nclass ResultList:\n    \"\"\"Collects per-group depths and provides the typed list result.\"\"\"\n    def __init__(self) -> None:\n        self.depths: List[int] = []\n\n    def append(self, depth: int) -> None:\n        \"\"\"Appends a depth value to the list.\"\"\"\n        self.depths.append(depth)\n\n    def to_list(self) -> List[int]:\n        \"\"\"Returns the collected depths as a List[int].\"\"\"\n        return self.depths\nclass Parser:\n    \"\"\"Splits input, creates ParenthesisGroup instances, and collects results.\"\"\"\n    def __init__(self) -> None:\n        pass\n\n    def parse(self, paren_string: str) -> List[int]:\n        \"\"\"Parses the input string and computes max depths for each group.\"\"\"\n        result_list = ResultList()\n        group_tokens = paren_string.split(\" \")\n\n        for token in group_tokens:\n            parenthesis_group = ParenthesisGroup(token)\n            max_depth = parenthesis_group.compute_max_depth()\n            result_list.append(max_depth)\n            \n        return result_list.to_list()\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    parser = Parser()\n    return parser.parse(paren_string)", "base_status": "pass", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": [[""]]}], "HumanEval/1": [{"task_id": "HumanEval/1", "solution": "from typing import List\nfrom dataclasses import dataclass\nclass Parser:\n    @staticmethod\n    def separate_paren_groups(paren_string: str) -> List[str]:\n        \"\"\"Parses a string of nested parentheses, separating top-level balanced groups.\"\"\"\n        normalized_string = paren_string.replace(' ', '')\n        groups: List[str] = []\n        balance = 0\n        current_group_start = -1\n\n        for i, char in enumerate(normalized_string):\n            if char == '(':\n                if balance == 0:\n                    current_group_start = i\n                balance += 1\n            elif char == ')':\n                balance -= 1\n\n            if balance == 0 and current_group_start != -1:\n                group_content = normalized_string[current_group_start : i + 1]\n                groups.append(group_content)\n                current_group_start = -1\n        return groups\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Input to this function is a string containing multiple groups of nested parentheses. Your goal is to\n    separate those group into separate strings and return the list of those.\n    Separate groups are balanced (each open brace is properly closed) and not nested within each other\n    Ignore any spaces in the input string.\n    >>> separate_paren_groups('( ) (( )) (( )( ))')\n    ['()', '(())', '(()())']\n    \"\"\"\n    return Parser.separate_paren_groups(paren_string)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/8": [{"task_id": "HumanEval/8", "solution": "def sum_product(numbers: List[int]) -> Tuple[int, int]:\n    \"\"\" For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.\n    Empty sum should be equal to 0 and empty product should be equal to 1.\n    >>> sum_product([])\n    (0, 1)\n    >>> sum_product([1, 2, 3, 4])\n    (10, 24)\n    \"\"\"\n    total_sum = 0\n    total_product = 1\n    for num in numbers:\n        total_sum += num\n        total_product *= num\n    return (total_sum, total_product)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/13": [{"task_id": "HumanEval/13", "solution": "def greatest_common_divisor(a: int, b: int) -> int:\n    \"\"\" Return a greatest common divisor of two integers a and b\n    >>> greatest_common_divisor(3, 5)\n    1\n    >>> greatest_common_divisor(25, 15)\n    5\n    \"\"\"\n    # Use the Euclidean algorithm to compute the greatest common divisor.\n    # Take absolute values to ensure a non-negative result.\n    a = abs(a)\n    b = abs(b)\n\n    while b:\n        a, b = b, a % b\n    return a", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/14": [{"task_id": "HumanEval/14", "solution": "def all_prefixes(string: str) -> List[str]:\n    \"\"\" Return list of all prefixes from shortest to longest of the input string\n    >>> all_prefixes('abc')\n    ['a', 'ab', 'abc']\n    \"\"\"\n    prefixes = []\n    for i in range(1, len(string) + 1):\n        prefixes.append(string[:i])\n    return prefixes", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/9": [{"task_id": "HumanEval/9", "solution": "def rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    result = []\n    current_max = None\n\n    for number in numbers:\n        if current_max is None:\n            current_max = number\n        else:\n            current_max = max(current_max, number)\n        result.append(current_max)\n\n    return result", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/17": [{"task_id": "HumanEval/17", "solution": "def parse_music(music_string: str) -> List[int]:\n    \"\"\" Input to this function is a string representing musical notes in a special ASCII format.\n    Your task is to parse this string and return list of integers corresponding to how many beats does each\n    not last.\n\n    Here is a legend:\n    'o' - whole note, lasts four beats\n    'o|' - half note, lasts two beats\n    '.|' - quater note, lasts one beat\n\n    >>> parse_music('o o| .| o| o| .| .| .| .| o o')\n    [4, 2, 1, 2, 2, 1, 1, 1, 1, 4, 4]\n    \"\"\"\n\n    class Tokenizer:\n        \"\"\"Handles splitting the music string into tokens.\n        It splits by whitespace and filters out any empty tokens.\n        \"\"\"\n        def tokenize(self, music_string: str) -> List[str]:\n            if music_string is None:\n                return []\n            return [tok for tok in music_string.split() if tok]\n\n    class TokenMapper:\n        \"\"\"Maps a musical token string to its corresponding beat integer.\"\"\"\n        _mapping: dict[str, int] = {'o': 4, 'o|': 2, '.|': 1}\n\n        def map(self, token: str) -> int:\n            # Raises KeyError for unrecognized tokens, as per design specification.\n            return self._mapping[token]\n\n    class ParseMusicFunction:\n        \"\"\"Orchestrates the parsing process, delegating to Tokenizer and TokenMapper.\"\"\"\n        _tokenizer: Tokenizer\n        _mapper: TokenMapper\n\n        def __init__(self, tokenizer: Tokenizer, mapper: TokenMapper) -> None:\n            self._tokenizer = tokenizer\n            self._mapper = mapper\n\n        def parse(self, music_string: str) -> List[int]:\n            \"\"\"Tokenizes the input string and maps each token to its beat count.\"\"\"\n            tokens = self._tokenizer.tokenize(music_string)\n            beats = [self._mapper.map(t) for t in tokens]\n            return beats\n\n    # Instantiate the core components and run the parsing process.\n    parser = ParseMusicFunction(Tokenizer(), TokenMapper())\n    return parser.parse(music_string)", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/11": [{"task_id": "HumanEval/11", "solution": "from typing import List\nclass ValidationError(Exception):\n    \"\"\"Domain-level error carrying descriptive message.\"\"\"\n    def __init__(self, message: str) -> None:\n        super().__init__(message)\n        self.message = message\nclass BinaryString:\n    \"\"\"Immutable binary string value object with inspectors.\"\"\"\n    def __init__(self, value: str) -> None:\n        self.value = value\n\n    def length(self) -> int:\n        return len(self.value)\n\n    def is_valid(self) -> bool:\n        # This is an inspector; authoritative validation with error raising is done by ValidationService.\n        return all(c in '01' for c in self.value)\nclass ValidationService:\n    \"\"\"Encapsulates business rules for character set and equal length.\"\"\"\n    def validate_chars(self, s: BinaryString) -> bool:\n        for char in s.value:\n            if char not in ('0', '1'):\n                raise ValidationError(\"Input string must consist only of '0's and '1's.\")\n        return True\n\n    def validate_equal_length(self, a: BinaryString, b: BinaryString) -> bool:\n        if a.length() != b.length():\n            raise ValidationError(\"Input strings must be of equal length.\")\n        return True\nclass XORService:\n    \"\"\"Computes per-bit XOR of two validated BinaryString instances.\"\"\"\n    def compute(self, a: BinaryString, b: BinaryString) -> str:\n        # Assumes inputs have already been validated for characters and equal length.\n        result_chars = []\n        for i in range(a.length()):\n            bit_a = int(a.value[i])\n            bit_b = int(b.value[i])\n            xor_result = bit_a ^ bit_b\n            result_chars.append(str(xor_result))\n        return \"\".join(result_chars)\ndef string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    a_obj = BinaryString(a)\n    b_obj = BinaryString(b)\n\n    validation_service = ValidationService()\n    xor_service = XORService()\n\n    try:\n        validation_service.validate_chars(a_obj)\n        validation_service.validate_chars(b_obj)\n        validation_service.validate_equal_length(a_obj, b_obj)\n    except ValidationError as ve:\n        raise ValueError(str(ve))\n\n    return xor_service.compute(a_obj, b_obj)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/12": [{"task_id": "HumanEval/12", "solution": "from typing import List, Optional\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\" Out of list of strings, return the longest one. Return the first one in case of multiple\n    strings of the same length. Return None in case the input list is empty.\n    >>> longest([])\n    None\n\n    >>> longest(['a', 'b', 'c'])\n    'a'\n    >>> longest(['a', 'bb', 'ccc'])\n    'ccc'\n    \"\"\"\n    if not strings:\n        return None\n\n    current_longest = None\n    max_length = -1\n\n    for s in strings:\n        if len(s) > max_length:\n            max_length = len(s)\n            current_longest = s\n    return current_longest", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/18": [{"task_id": "HumanEval/18", "solution": "def how_many_times(string: str, substring: str) -> int:\n    \"\"\" Find how many times a given substring can be found in the original string. Count overlaping cases.\n    >>> how_many_times('', 'a')\n    0\n    >>> how_many_times('aaa', 'a')\n    3\n    >>> how_many_times('aaaa', 'aa')\n    3\n    \"\"\"\n    count = 0\n    start_index = 0\n    \n    # Handle the specific case where the substring is empty.\n    # The default str.find behavior would return len(string) + 1 occurrences.\n    # If a specific behavior for empty substring is required (e.g., 0), it should be handled here.\n    # Per design, unspecified behavior for empty substring: follow str.find.\n    if not substring:\n        return len(string) + 1 # An empty string is found before each character and after the last character.\n\n    while True:\n        idx = string.find(substring, start_index)\n        if idx == -1:\n            break\n        count += 1\n        # Advance the search by only 1 position to count overlapping occurrences.\n        start_index = idx + 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/16": [{"task_id": "HumanEval/16", "solution": "def count_distinct_characters(string: str) -> int:\n    \"\"\" Given a string, find out how many distinct characters (regardless of case) does it consist of.\n    \"\"\"\n    seen_characters = set()\n    folded_string = string.casefold()\n    for char in folded_string:\n        seen_characters.add(char)\n    return len(seen_characters)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/10": [{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string