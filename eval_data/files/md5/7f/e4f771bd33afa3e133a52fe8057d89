 = 1\n    base = 2 % p\n    exponent = n\n\n    while exponent > 0:\n        if exponent & 1:  # If the current bit of exponent is 1\n            result = (result * base) % p\n        base = (base * base) % p  # Square the base and reduce modulo p\n        exponent >>= 1  # Right shift exponent by 1 (equivalent to exponent //= 2)\n\n    return result", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/47": [{"task_id": "HumanEval/47", "solution": "class MedianCalculator:\n    def computeMedian(self, l: list) -> float:\n        \"\"\"Computes the median of a list of numeric values using the standard rule.\"\"\"\n        n = len(l)\n        sorted_l = sorted(l)\n        mid_idx = n // 2\n\n        if n % 2 == 1:\n            return float(sorted_l[mid_idx])\n        else:\n            return (sorted_l[mid_idx - 1] + sorted_l[mid_idx]) / 2.0\ndef median(l: list):\n    \"\"\"Return median of elements in the list l.\n    >>> median([3, 1, 2, 4, 5])\n    3\n    >>> median([-10, 4, 6, 1000, 10, 20])\n    15.0\n    \"\"\"\n    calculator = MedianCalculator()\n    return calculator.computeMedian(l)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/59": [{"task_id": "HumanEval/59", "solution": "class IntegerValue:\n    def __init__(self, value: int) -> None:\n        self.value = value\n\n    def is_prime(self) -> bool:\n        if self.value < 2:\n            return False\n        if self.value == 2:\n            return True\n        if self.value % 2 == 0:\n            return False\n        i = 3\n        while i * i <= self.value:\n            if self.value % i == 0:\n                return False\n            i += 2\n        return True\nclass PrimeFactor:\n    def __init__(self, value: int, multiplicity: int = 1) -> None:\n        self.value = value\n        self.multiplicity = multiplicity\nclass Factorization:\n    def __init__(self, subject: IntegerValue) -> None:\n        self.subject = subject\n        self.factors: list[PrimeFactor] = []\n\n    def factorize(self) -> 'Factorization':\n        n = self.subject.value\n        temp_n = n\n        \n        # Factor out 2s\n        if temp_n % 2 == 0:\n            count = 0\n            while temp_n % 2 == 0:\n                count += 1\n                temp_n //= 2\n            self.factors.append(PrimeFactor(2, count))\n\n        # Factor out odd numbers\n        d = 3\n        while d * d <= temp_n:\n            if temp_n % d == 0:\n                count = 0\n                while temp_n % d == 0:\n                    count += 1\n                    temp_n //= d\n                self.factors.append(PrimeFactor(d, count))\n            d += 2\n        \n        # If temp_n is still greater than 1, it's a prime factor itself\n        if temp_n > 1:\n            self.factors.append(PrimeFactor(temp_n, 1))\n        \n        return self\n\n    def max_prime(self) -> int:\n        # Returns the largest prime value from the computed factors.\n        if not self.factors:\n            return 0 # Should not happen given precondition n > 1 and is not prime.\n        return max(pf.value for pf in self.factors)\nclass LargestPrimeFactorFunction:\n    def __init__(self) -> None:\n        pass\n\n    def compute(self, n: int) -> int:\n        # Orchestrates the factorization process using domain objects.\n        integer_value = IntegerValue(n)\n        factorization = Factorization(subject=integer_value)\n        factorization.factorize()\n        return factorization.max_prime()\ndef largest_prime_factor(n: int):\n    \"\"\"Return the largest prime factor of n. Assume n > 1 and is not a prime.\n    >>> largest_prime_factor(13195)\n    29\n    >>> largest_prime_factor(2048)\n    2\n    \"\"\"\n    # Delegates the computation to the LargestPrimeFactorFunction.\n    calculator = LargestPrimeFactorFunction()\n    return calculator.compute(n)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/58": [{"task_id": "HumanEval/58", "solution": "def common(l1: list, l2: list):\n    \"\"\"Return sorted unique common elements for two lists.\n    >>> common([1, 4, 3, 34, 653, 2, 5], [5, 7, 1, 5, 9, 653, 121])\n    [1, 5, 653]\n    >>> common([5, 3, 2, 8], [3, 2])\n    [2, 3]\n\n    \"\"\"\n    if not isinstance(l1, list) or not isinstance(l2, list):\n        raise TypeError(\"l1 and l2 must be lists\")\n\n    l2_hashables = set()\n    l2_unhashables = []\n    for item_l2 in l2:\n        try:\n            hash(item_l2)\n            l2_hashables.add(item_l2)\n        except TypeError:\n            l2_unhashables.append(item_l2)\n\n    result_list = []\n    seen_hashable = set()\n    seen_unhashable = []\n\n    for e_l1 in l1:\n        is_common = False\n        is_e_l1_hashable = False\n        try:\n            hash(e_l1)\n            is_e_l1_hashable = True\n        except TypeError:\n            pass\n\n        if is_e_l1_hashable:\n            if e_l1 in l2_hashables:\n                if e_l1 not in seen_hashable:\n                    is_common = True\n                    seen_hashable.add(e_l1)\n        else: # e_l1 is unhashable\n            found_in_l2_unhashables = False\n            for item_l2_unhashable in l2_unhashables:\n                if e_l1 == item_l2_unhashable:\n                    found_in_l2_unhashables = True\n                    break\n            \n            if found_in_l2_unhashables:\n                already_seen_unhashable = False\n                for seen_item in seen_unhashable:\n                    if e_l1 == seen_item:\n                        already_seen_unhashable = True\n                        break\n                \n                if not already_seen_unhashable:\n                    is_common = True\n                    seen_unhashable.append(e_l1)\n\n        if is_common:\n            result_list.append(e_l1)\n            \n    return sorted(result_list)", "base