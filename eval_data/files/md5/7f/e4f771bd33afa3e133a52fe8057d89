n            open_count -= 1\n        else:\n            raise ValueError(\"invalid character in brackets: expected '(' or ')'\")\n        if open_count < 0:\n            return False\n    return open_count == 0", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/63": [{"task_id": "HumanEval/63", "solution": "def fibfib(n: int):\n    \"\"\"The FibFib number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:\n    fibfib(0) == 0\n    fibfib(1) == 0\n    fibfib(2) == 1\n    fibfib(n) == fibfib(n-1) + fibfib(n-2) + fibfib(n-3).\n    Please write a function to efficiently compute the n-th element of the fibfib number sequence.\n    \"\"\"\n\n    # Handle base cases as defined for the FibFib sequence.\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 1\n\n    # Define an inline Matrix class for 3x3 integer matrix operations (multiplication and exponentiation).\n    class Matrix:\n        def __init__(self, data: list[list[int]]):\n            self.data = data\n\n        def multiply(self, other: 'Matrix') -> 'Matrix':\n            result_data = [[0, 0, 0] for _ in range(3)]\n            for i in range(3):\n                for j in range(3):\n                    for k in range(3):\n                        result_data[i][j] += self.data[i][k] * other.data[k][j]\n            return Matrix(result_data)\n\n        def pow(self, exponent: int) -> 'Matrix':\n            # Identity matrix for 3x3.\n            identity = Matrix([[1, 0, 0], [0, 1, 0], [0, 0, 1]])\n            if exponent == 0:\n                return identity\n            if exponent == 1:\n                return self\n\n            res = identity\n            base = self\n            # Use exponentiation by squaring (binary exponentiation).\n            while exponent > 0:\n                if exponent % 2 == 1:\n                    res = res.multiply(base)\n                base = base.multiply(base)\n                exponent //= 2\n            return res\n\n    # The companion matrix for the FibFib recurrence relation:\n    # [f(k+2)]   [[1,1,1]]   [f(k+1)]\n    # [f(k+1)] = [[1,0,0]] * [f(k)]\n    # [f(k)]     [[0,1,0]]   [f(k-1)]\n    # Initial state vector for n=0 is [f(2), f(1), f(0)] = [1, 0, 0].\n    # We want [f(n+2), f(n+1), f(n)] = M^n * [f(2), f(1), f(0)]\n    companion_matrix = Matrix([[1, 1, 1],\n                               [1, 0, 0],\n                               [0, 1, 0]])\n\n    # Compute M^n using the efficient matrix exponentiation method.\n    powered_matrix = companion_matrix.pow(n)\n\n    # The fibfib(n) value is the third component (index 2) of the resulting\n    # column vector [f(n+2), f(n+1), f(n)] after multiplying M^n by the initial vector [1,0,0].\n    # This corresponds to the element at data[2][0] of the powered matrix.\n    return powered_matrix.data[2][0]", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/57": [{"task_id": "HumanEval/57", "solution": "class ListInput:\n    def __init__(self, elements: list):\n        self.elements: list = elements\n    def length(self) -> int:\n        return len(self.elements)\nclass Result:\n    def __init__(self, is_monotonic: bool):\n        self.is_monotonic: bool = is_monotonic\nclass MonotonicChecker:\n    def check(self, l: list) -> bool:\n        \"\"\"Return True if list is monotonic (non-decreasing OR non-increasing).\"\"\"\n        return self.is_non_decreasing(l) or self.is_non_increasing(l)\n\n    def is_non_decreasing(self, l: list) -> bool:\n        \"\"\"Return True if sequence is non-decreasing (prev <= curr for all adjacent pairs).\"\"\"\n        for i in range(1, len(l)):\n            if l[i-1] > l[i]:\n                return False\n        return True\n\n    def is_non_increasing(self, l: list) -> bool:\n        \"\"\"Return True if sequence is non-increasing (prev >= curr for all adjacent pairs).\"\"\"\n        for i in range(1, len(l)):\n            if l[i-1] < l[i]:\n                return False\n        return True\ndef monotonic(l: list):\n    \"\"\"Return True is list elements are monotonically increasing or decreasing.\n    >>> monotonic([1, 2, 4, 20])\n    True\n    >>> monotonic([1, 20, 4, 10])\n    False\n    >>> monotonic([4, 1, 0, -10])\n    True\n    \"\"\"\n    li = ListInput(l)\n    checker = MonotonicChecker()\n    res_bool = checker.check(li.elements)\n    return Result(res_bool).is_monotonic", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/54": [{"task_id": "HumanEval/54", "solution": "from typing import Set\ndef same_chars(s0: str, s1: str):\n    \"\"\"\n    Check if two words have the same characters.\n    >>> same_chars('eabcdzzzz', 'dddzzzzzzzddeddabc')\n    True\n    >>> same_chars('abcd', 'dddddddabc')\n    True\n    >>> same_chars('dddddddabc', 'abcd')\n    True\n    >>> same_chars('eabcd', 'dddddddabc')\n    False\n    >>> same_chars('abcd', 'dddddddabce')\n    False\n    >>> same_chars('eabcdzzzz', 'dddzzzzzzzddddabc')\n    False\n    \"\"\"\n\n    class CharacterSet:\n        \"\"\"Represents a set of unique characters extracted from a string.\n        It provides functionality to compare character sets for equality.\"\"\"\n        def __init__(self, chars: Set[str]) -> None:\n            self.chars = chars\n\n        def equals(self, other: 'CharacterSet') -> bool:\n            \"\"\"Compares this character set with another for equality.\"\"\"\n            return self.chars == other.chars\n\n    class StringInput:\n        \"\"\"Processes an input string to obtain its unique character set.\n        It encapsulates the conversion of a string into a CharacterSet.\"\"\"\n        def __init__(self, value: str) -> None:\n            self.value = value\n\n        def get_unique_chars(self) -> CharacterSet:\n            \"\"\"Extracts unique characters from the string and returns a CharacterSet.\"\"\"\n            return CharacterSet(set(self.value))\n\n    class SameCharsFunction:\n        \"\"\"Orchestrates the comparison process for two input strings.\n        This static method provides the core logic as per design.\"\"\"\n        @staticmethod\n        def _compare_strings(s0_arg: str, s1_arg: str) -> bool:\n            \"\"\"Compares the unique character sets of two input strings.\"\"\"\n            s_in0 = StringInput(s0_arg)\n            s_in1 = StringInput(s1_arg)\n            cs0 = s_in0.get_unique_chars()\n            cs1 = s_in1.get_unique_chars()\n            return cs0.equals(cs1)\n\n    return SameCharsFunction._compare_strings(s0, s1)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/66": [{"task_id": "HumanEval/66", "solution": "def digitSum(s):\n    \"\"\"Calculates the sum of ASCII values of only the uppercase ASCII characters in the input string.\"\"\"\n    total_sum = 0\n    for char in s:\n        # Check if the character is an uppercase ASCII letter ('A' through 'Z').\n        if 'A' <= char <= 'Z':\n            total_sum += ord(char)\n    return total_sum", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/64": [{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Counts the number of vowels in a string, where 'a', 'e', 'i', 'o', 'u' are always vowels (case-insensitive)\n    and 'y' is a vowel only if it is the last character of the word.\n    >>> vowels_count(\"abcde\")\n    2\n    >>> vowels_count(\"ACEDY\")\n    3\n    >>> vowels_count(\"day\")\n    2\n    >>> vowels_count(\"yellow\")\n    2\n    >>> vowels_count(\"rhythm\")\n    0\n    >>> vowels_count(\"aeiou\")\n    5\n    >>> vowels_count(\"a\")\n    1\n    >>> vowels_count(\"b\")\n    0\n    >>> vowels_count(\"\")\n    0\n    \"\"\"\n    VOWELS_BASE = {'a', 'e', 'i', 'o', 'u'}\n\n    def _is_vowel(char, is_last_char):\n        \"\"\"Determines if a character is a vowel based on the defined rules.\"\"\"\n        char_lower = char.lower()\n        if char_lower in VOWELS_BASE:\n            return True\n        if char_lower == 'y' and is_last_char:\n            return True\n        return False\n\n    if not s:\n        return 0\n\n    count = 0\n    word_length = len(s)\n    for i in range(word_length):\n        is_last = (i == word_length - 1)\n        if _is_vowel(s[i], is_last):\n            count += 1\n    return count", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/56": [{"task_id": "HumanEval/56", "solution": "def correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n    \"\"\"\n\n    class BracketSequence:\n        \"\"\"Encapsulates input bracket string.\"\"\"\n        def __init__(self, value: str) -> None:\n            self.value = value\n\n        def length(self) -> int:\n            \"\"\"Returns the length of the bracket sequence.\"\"\"\n            return len(self.value)\n\n    class ValidationResult:\n        \"\"\"Represents validation outcome and optional reason.\"\"\"\n        def __init__(self, is_valid: bool, reason: str = \"\") -> None:\n            self.is_valid = is_valid\n            self.reason = reason\n\n    class BracketingValidator:\n        \"\"\"Validates a BracketSequence according to bracketing rules.\"\"\"\n        def validate(self, seq: BracketSequence) -> ValidationResult:\n            \"\"\"Runs a sequence of validation checks.\"\"\"\n            valid_chars = {'<', '>'}\n            for char in seq.value:\n                if char not in valid_chars:\n                    return ValidationResult(False, \"invalid character\")\n\n            if not self.hasBalancedCounts(seq):\n                return ValidationResult(False, \"counts unequal\")\n            \n            if not self.hasProperNesting(seq):\n                return ValidationResult(False, \"premature closing or nesting error\")\n\n            return ValidationResult(True, \"\")\n\n        def hasBalancedCounts(self, seq: BracketSequence) -> bool:\n            \"\"\"Checks if the counts of opening and closing brackets are equal.\"\"\"\n            return seq.value.count('<') == seq.value.count('>')\n\n        def hasProperNesting(self, seq: BracketSequence) -> bool:\n            \"\"\"Checks for correct nesting and absence of premature closing brackets.\"\"\"\n            balance = 0\n            for char in seq.value:\n                if char == '<':\n                    balance += 1\n                elif char == '>':\n                    if balance == 0:\n                        return False  # Premature closing bracket\n                    balance -= 1\n            return True # Final balance check is handled by hasBalancedCounts\n\n    seq = BracketSequence(brackets)\n    validator = BracketingValidator()\n    result = validator.validate(seq)\n    return result.is_valid", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/67": [{"task_id": "HumanEval/67", "solution": "import re\nfrom typing import Optional\nclass FruitCounts:\n    \"\"\"A data class to hold counts of different fruit types.\"\"\"\n    def __init__(self, apples: int, oranges: int, mangoes: Optional[int] = None):\n        self.apples = apples\n        self.oranges = oranges\n        self.mangoes = mangoes\nclass Parser:\n    \"\"\"Parses a string to extract apple and orange counts.\"\"\"\n    @staticmethod\n    def parse(s: str) -> FruitCounts:\n        \"\"\"Parse s and return FruitCounts(apples:int, oranges:int) or raise ValueError on invalid input.\"\"\"\n        match = re.search(r\"(\\d+)\\s+apples\\s+and\\s+(\\d+)\\s+oranges\", s)\n        if not match:\n            raise ValueError(\"Input string format is invalid. Expected 'X apples and Y oranges'.\")\n        \n        # The regex ensures digits, so int() conversion should succeed.\n        apples = int(match.group(1))\n        oranges = int(match.group(2))\n        \n        return FruitCounts(apples, oranges)\nclass Validator:\n    \"\"\"Validates fruit counts and total fruit in the basket.\"\"\"\n    @staticmethod\n    def validateCounts(counts: FruitCounts, total: int) -> bool:\n        \"\"\"Return True when counts and total are valid; raise ValueError on invalid input per SRS.\"\"\"\n        # The Parser ensures counts.apples and counts.oranges are non-negative integers.\n        # This checks for any potential external manipulation or unexpected states.\n        if counts.apples < 0:\n            raise ValueError(\"Apple count must be non-negative.\")\n        if counts.oranges < 0:\n            raise ValueError(\"Orange count must be non-negative.\")\n        \n        # Validate the total fruit count 'n'.\n        if not isinstance(total, int):\n            raise ValueError(\"Total fruit count (n) must be an integer.\")\n        if total < 0:\n            raise ValueError(\"Total fruit count (n) must be non-negative.\")\n        \n        return True\ndef fruit_distribution(s,n):\n    \"\"\"\n    In this task, you will be given a string that represents a number of apples and oranges \n    that are distributed in a basket of fruit this basket contains \n    apples, oranges, and mango fruits. Given the string that represents the total number of \n    the oranges and apples and an integer that represent the total number of the fruits \n    in the basket return the number of the mango fruits in the basket.\n    for examble:\n    fruit_distribution(\"5 apples and 6 oranges\", 19) ->19 - 5 - 6 = 8\n    fruit_distribution(\"0 apples and 1 oranges\",3) -> 3 - 0 - 1 = 2\n    fruit_distribution(\"2 apples and 3 oranges\", 100) -> 100 - 2 - 3 = 95\n    fruit_distribution(\"100 apples and 1 oranges\",120) -> 120 - 100 - 1 = 19\n    \"\"\"\n    counts = Parser.parse(s)  # Parse the string 's' to get apple and orange counts.\n    Validator.validateCounts(counts, n)  # Validate the parsed counts and the total 'n'.\n    \n    # Calculate the number of mangoes. The design allows for negative mango counts.\n    mangoes = int(n) - int(counts.apples) - int(counts.oranges)\n    \n    counts.mangoes = mangoes # Store the calculated mangoes in the FruitCounts object.\n    return mangoes", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/68": [{"task_id": "HumanEval/68", "solution": "class PluckedNode:\n    \"\"\"Immutable container for a selected smallest even element and its index.\"\"\"\n    def __init__(self, value: int, index: int):\n        self.value = value\n        self.index = index\nclass Validator:\n    \"\"\"Validates input array length and non-negativity constraints.\"\"\"\n    @staticmethod\n    def validateLength(arr) -> bool:\n        \"\"\"Returns True if arr is list-like and 0 <= len(arr) <= 10000.\"\"\"\n        if not isinstance(arr, list):\n            return False\n        length = len(arr)\n        return 0 <= length <= 10000\n\n    @staticmethod\n    def validateNonNegative(arr) -> bool:\n        \"\"\"Returns True if every element of arr is an integer and >= 0.\"\"\"\n        for val in arr:\n            if not isinstance(val, int) or val < 0:\n                return False\n        return True\nclass Plucker:\n    \"\"\"Implements the core logic for plucking the smallest even node.\"\"\"\n\n    def findSmallestEven(self, arr: list) -> PluckedNode | None:\n        \"\"\"Scans arr once to find the smallest even value and its first index.\"\"\"\n        smallest_even_value = float('inf')\n        smallest_even_index = -1\n\n        for i, value in enumerate(arr):\n            if value % 2 == 0:  # Check if the value is even\n                if value < smallest_even_value:\n                    smallest_even_value = value\n                    smallest_even_index = i\n        \n        if smallest_even_index != -1:\n            return PluckedNode(smallest_even_value, smallest_even_index)\n        return None\n\n    def pluck(self, arr: list) -> list:\n        \"\"\"Validates arr, finds the smallest even node, and returns it as [value, index] or [].\"\"\"\n        if not Validator.validateLength(arr) or not Validator.validateNonNegative(arr):\n            return []\n        \n        plucked_node = self.findSmallestEven(arr)\n\n        if plucked_node:\n            return [plucked_node.value, plucked_node.index]\n        return []\ndef pluck(arr) -> list:\n    \"\"\"\n    \"Given an array representing a branch of a tree that has non-negative integer nodes\n    your task is to pluck one of the nodes and return it.\n    The plucked node should be the node with the smallest even value.\n    If multiple nodes with the same smallest even value are found return the node that has smallest index.\n\n    The plucked node should be returned in a list, [ smalest_value, its index ],\n    If there are no even values or the given array is empty, return [].\n    \"\"\"\n    return Plucker().pluck(arr)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/65": [{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    >>> circular_shift(12, 1)\n    \"21\"\n    >>> circular_shift(12, 2)\n    \"12\"\n    \"\"\"\n\n    # Domain classes as specified in the design context (src/domain.py)\n    class Number:\n        def __init__(self, value: int):\n            self.value = value\n\n        def digits(self) -> str:\n            # Extracts the string representation of digits, handling sign.\n            return str(abs(self.value))\n\n        def numDigits(self) -> int:\n            return len(self.digits())\n\n    class Shift:\n        def __init__(self, amount: int):\n            self.amount = amount\n\n    # Result class, primarily for design consistency; output is directly string.\n    class Result:\n        def __init__(self, value: str):\n            self.value = value\n\n    # Service class encapsulating business logic (src/shifter.py)\n    class CircularShifter:\n        def validateInputs(self, x_number: 'Number', s_shift: 'Shift') -> bool:\n            # As per design, inputs are guaranteed to be integers, so this is a no-op.\n            return True\n\n        def rotateRight(self, digits: str, k: int) -> str:\n            # Performs a circular right shift on the given digits string.\n            if not digits:\n                return \"\"\n            effective_k = k % len(digits)\n            return digits[-effective_k:] + digits[:-effective_k]\n\n        def reverse(self, digits: str) -> str:\n            # Reverses the given digits string.\n            return digits[::-1]\n\n        def circular_shift(self, x_number: 'Number', s_shift: 'Shift') -> str:\n            # Applies the shifting rules based on the provided Number and Shift objects.\n            self.validateInputs(x_number, s_shift)\n\n            digits_str = x_number.digits()\n            num_digits = x_number.numDigits()\n            shift_amount = s_shift.amount\n\n            if shift_amount == num_digits:\n                return digits_str\n            elif shift_amount > num_digits:\n                return self.reverse(digits_str)\n            elif 0 <= shift_amount < num_digits:\n                return self.rotateRight(digits_str, shift_amount)\n            else:\n                # For unspecified shift values (e.g., negative shifts), return original digits.\n                return digits_str\n\n    # Public API wiring as specified in the design.\n    num = Number(x)\n    sh = Shift(shift)\n    shifter = CircularShifter()\n    result_str = shifter.circular_shift(num, sh)\n    # Ensure no leading/trailing whitespace in the final result.\n    return result_str.strip()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/74": [{"task_id": "HumanEval/74", "solution": "from typing import List\nclass InputList:\n    \"\"\"Encapsulates a list of strings and computes their total character count.\"\"\"\n    def __init__(self, strings: List[str]):\n        self.strings = strings\n\n    def totalChars(self) -> int:\n        \"\"\"Calculates the sum of lengths of all strings in the list.\"\"\"\n        return sum(len(s) for s in self.strings)\nclass Comparator:\n    \"\"\"Compares two InputList instances and selects one based on total characters.\"\"\"\n    def selectSmaller(self, listA: InputList, listB: InputList) -> InputList:\n        \"\"\"Returns the list with fewer total characters, or the first list on a tie.\"\"\"\n        totalA = listA.totalChars()\n        totalB = listB.totalChars()\n\n        if totalA <= totalB:\n            return listA\n        else:\n            return listB\ndef total_match(lst1, lst2):\n    '''\n    Write a function that accepts two lists of strings and returns the list that has \n    total number of chars in the all strings of the list less than the other list.\n\n    if the two lists have the same number of chars, return the first list.\n\n    Examples\n    total_match([], []) \u279e []\n    total_match(['hi', 'admin'], ['hI', 'Hi']) \u279e ['hI', 'Hi']\n    total_match(['hi', 'admin'], ['hi', 'hi', 'admin', 'project']) \u279e ['hi', 'admin']\n    total_match(['hi', 'admin'], ['hI', 'hi', 'hi']) \u279e ['hI', 'hi', 'hi']\n    total_match(['4'], ['1', '2', '3', '4', '5']) \u279e ['4']\n    '''\n    a_wrapped = InputList(lst1)\n    b_wrapped = InputList(lst2)\n\n    comparator = Comparator()\n    selected_wrapped = comparator.selectSmaller(a_wrapped, b_wrapped)\n\n    return selected_wrapped.strings", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/70": [{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n\n    Examples:\n    strange_sort_list([1, 2, 3, 4]) == [1, 4, 2, 3]\n    strange_sort_list([5, 5, 5, 5]) == [5, 5, 5, 5]\n    strange_sort_list([]) == []\n    '''\n\n    class IntegerElement:\n        \"\"\"Lightweight domain value object representing a single integer.\"\"\"\n        def __init__(self, value):\n            self.value = value\n\n    class IntegerList:\n        \"\"\"Domain wrapper for a sequence of IntegerElement.\"\"\"\n        def __init__(self, elements):\n            self.elements = elements\n\n        def length(self):\n            return len(self.elements)\n\n        def get(self, index):\n            return self.elements[index]\n\n        def to_list(self):\n            return [element.value for element in self.elements]\n\n        @staticmethod\n        def from_list(values):\n            return IntegerList([IntegerElement(v) for v in values])\n\n    class StrangeSorter:\n        \"\"\"Implements the strange-sort algorithm by alternating min/max selection.\"\"\"\n        def _pop_min(self, working):\n            \"\"\"Removes and returns the first occurrence of the minimum element.\"\"\"\n            min_val = float('inf')\n            min_idx = -1\n            for i, element in enumerate(working):\n                if element.value < min_val:\n                    min_val = element.value\n                    min_idx = i\n            return working.pop(min_idx)\n\n        def _pop_max(self, working):\n            \"\"\"Removes and returns the first occurrence of the maximum element.\"\"\"\n            max_val = float('-inf')\n            max_idx = -1\n            for i, element in enumerate(working):\n                if element.value > max_val:\n                    max_val = element.value\n                    max_idx = i\n            return working.pop(max_idx)\n\n        def strange_sort_list(self, input_list):\n            # Creates a working mutable copy of elements.\n            working_elements = list(input_list.elements)\n            output_elements = []\n            is_min_turn = True\n\n            while working_elements:\n                if is_min_turn:\n                    selected_element = self._pop_min(working_elements)\n                else:\n                    selected_element = self._pop_max(working_elements)\n                output_elements.append(selected_element)\n                is_min_turn = not is_min_turn\n            \n            return IntegerList(output_elements)\n\n    # Public API implementation: converts input, delegates to sorter, converts output.\n    domain_input = IntegerList.from_list(lst)\n    sorter = StrangeSorter()\n    domain_output = sorter.strange_sort_list(domain_input)\n    return domain_output.to_list()", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/72": [{"task_id": "HumanEval/72", "solution": "class ObjectList:\n    def __init__(self, elements: list) -> None:\n        self._elements = elements\n\n    def isPalindromic(self) -> bool:\n        return self._elements == self._elements[::-1]\n\n    def sum(self) -> float:\n        return float(sum(self._elements))\nclass Weight:\n    def __init__(self, maxWeight: float) -> None:\n        self._maxWeight = maxWeight\n\n    def maxWeight(self) -> float:\n        return self._maxWeight\nclass FlightResult:\n    def __init__(self, willFly: bool, evaluated_sum: float) -> None:\n        self._willFly = willFly\n        self._evaluated_sum = evaluated_sum\n\n    def willFly(self) -> bool:\n        return self._willFly\n\n    def evaluated_sum(self) -> float:\n        return self._evaluated_sum\nclass FlightEvaluator:\n    def evaluate(self, q: 