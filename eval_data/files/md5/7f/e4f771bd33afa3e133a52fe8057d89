lements[i].index, elements[j].index, 0)\n        return None\nclass PairsSumToZero:\n    \"\"\"Coordinates validation and pair-finding for the use case.\"\"\"\n    def execute(self, input_list_obj: InputList) -> bool:\n        finder = PairFinder()\n        pair = finder.findPair(input_list_obj.elements)\n        return pair is not None\ndef pairs_sum_to_zero(l):\n    \"\"\"\n    pairs_sum_to_zero takes a list of integers as an input.\n    it returns True if there are two distinct elements in the list that\n    sum to zero, and False otherwise.\n    \"\"\"\n    validator = Validator()\n    if not validator.validate(l):\n        return False\n\n    input_obj = InputList(l)\n    coordinator = PairsSumToZero()\n    return coordinator.execute(input_obj)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/44": [{"task_id": "HumanEval/44", "solution": "def change_base(x: int, base: int):\n    \"\"\"Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    \"\"\"\n    if x == 0:\n        return '0'\n\n    digits = []\n    while x > 0:\n        remainder = x % base\n        digits.append(str(remainder))\n        x //= base\n\n    digits.reverse()\n    return \"\".join(digits)", "base_status": "pass", "plus_status": "pass", "base_fail_tests": [], "plus_fail_tests": []}], "HumanEval/45": [{"task_id": "HumanEval/45", "solution": "class InputValidator:\n    @staticmethod\n    def is_numeric(value) -> bool:\n        \"\"\"Checks if a value is an int or float, explicitly treating bool as non-numeric.\"\"\"\n        return isinstance(value, (int, float)) and not isinstance(value, bool)\nclass Triangle:\n    def __init__(self, base, height):\n        \"\"\"Initializes Triangle with base and height, stored as floats.\"\"\"\n      