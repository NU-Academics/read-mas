    \n        mid_point = (low + high) / 2.0\n        p_mid = poly(coeffs, mid_point)\n\n    return mid_point", "base_status": "fail", "plus_status": "fail", "base_fail_tests": [[[-10, -2]]], "plus_fail_tests": [[[5, 10, -3, 1]]]}], "HumanEval/25": [{"task_id": "HumanEval/25", "solution": "import math\nfrom typing import List\nclass IntegrityError(Exception):\n    \"\"\"Raised when an internal data integrity check fails during factorization.\"\"\"\n    pass\nclass IntegerInput:\n    \"\"\"Encapsulates an input integer and performs validation checks.\"\"\"\n    def __init__(self, value: int):\n        self.value = value\n\n    def validate(self) -> bool:\n        \"\"\"Validates the input value, raising TypeError or ValueError on failure.\"\"\"\n        if not isinstance(self.value, int):\n            raise TypeError(\"Input must be an integer.\")\n        if self.value <= 0:\n            raise ValueError(\"Input must be a positive integer.\")\n        return True\nclass PrimeFactor:\n    \"\"\"Represents a prime factor and its associated multiplicity.\"\"\"\n    def __init__(self, value: int, multiplicity: int = 1):\n        self.value = value\n        self.multiplicity = multiplicity\n\n    def as_list(self) -> List[int]:\n        \"\"\"Returns the prime factor repeated by its multiplicity in a list.\"\"\"\n        return [self.value] * self.multiplicity\nclass FactorList:\n    \"\"\"Holds a flattened list of prime factors and provides utility methods.\"\"\"\n    def __init__(self, factors: List[int]):\n        self.factors = factors\n\n    def product(self) -> int:\n        \"\"\"Calculates the product of all factors. Returns 1 for an empty list.\"\"\"\n        if not self.factors:\n            return 1\n        return math.prod(self.factors)\n\n    def isSorted(self) -> bool:\n        \"\"\"Checks if the list of factors is sorted in non-decreasing order.\"\"\"\n        return self.factors == sorted(self.factors)\nclass FactorizerService:\n    \"\"\"Orchestrates prime factorization, including input validation, computation, and result verification.\"\"\"\n    def factorize(self, n: int) -> List[int]:\n        \"\"\"Returns the list of prime factors for a given integer n, with full validation and verification.\"\"\"\n        original_n = n\n\n        input_validator = IntegerInput(n)\n        input_validator.validate()\n\n        if n == 1:\n            return []\n\n        prime_factors_with_multiplicity: List[PrimeFactor] = []\n        temp_n = n\n        d = 2\n\n        while d * d <= temp_n:\n            count = 0\n            while temp_n % d == 0:\n                count += 1\n                temp_n //= d\n            if count > 0:\n                prime_factors_with_multiplicity.append(PrimeFactor(d, count))\n            d += 1\n\n        if temp_n > 1:\n            prime_factors_with_multiplicity.append(PrimeFactor(temp_n, 1))\n\n        flat_factors: List[int] = []\n        for pf in prime_factors_with_multiplicity:\n            flat_factors.extend(pf.as_list())\n\n        factor_list = FactorList(flat_factors)\n\n        if not factor_list.isSorted():\n            raise IntegrityError(\"Computed factors are not sorted, indicating an internal error.\")\n\n        if factor_list.product() != original_n:\n            raise IntegrityError(f\"Product of factors ({factor_list.product()}) does not match original number ({original_n}).\")\n\n        return factor_list.factors\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    service = FactorizerService()\n    return service.factorize(n)", "base_status": "pass", "plus_status": "pass", "ba