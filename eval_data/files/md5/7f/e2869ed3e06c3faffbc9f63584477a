{"task_id": "HumanEval/63", "solution": "```python\ndef fibfib(n: int) -> int:\n    \"\"\"Computes the n-th element of the FibFib sequence efficiently using dynamic programming.\n    Handles base cases and the three-term recurrence relation for non-negative integers.\n    \"\"\"\n    if n == 0:\n        return 0\n    elif n == 1:\n        return 0\n    elif n == 2:\n        return 1\n\n    fibs = [0] * (n + 1)\n    fibs[0] = 0\n    fibs[1] = 0\n    fibs[2] = 1\n\n    for i in range(3, n + 1):\n        fibs[i] = fibs[i-1] + fibs[i-2] + fibs[i-3]\n\n    return fibs[n]\n```"}
{"task_id": "HumanEval/63", "solution": "def fibfib(n: int):\n    \"\"\"Computes the n-th element of the FibFib number sequence using an iterative approach.\n    This method provides optimal O(n) time and O(1) space complexity.\"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 0\n    if n == 2:\n        return 1\n\n    a, b, c = 0, 0, 1  # Represents fibfib(i-3), fibfib(i-2), fibfib(i-1) respectively\n    for _ in range(3, n + 1):\n        next_fib = a + b + c\n        a = b\n        b = c\n        c = next_fib\n    return c"}
{"task_id": "HumanEval/65", "solution": "def circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string.\n    If shift > number of digits, return digits reversed.\n    >>> circular_shift(12, 1)\n    \"21\"\n    >>> circular_shift(12, 2)\n    \"12\"\n    \"\"\"\n    # Convert integer to list of digits\n    digits = [int(d) for d in str(abs(x))]\n    digit_count = len(digits)\n\n    if shift > digit_count:\n        # Return digits reversed\n        result_digits = digits[::-1]\n    else:\n        # Perform circular right shift\n        effective_shift = shift % digit_count if digit_count > 0 else 0\n        result_digits = digits[-effective_shift:] + digits[:-effective_shift]\n\n    return ''.join(map(str, result_digits))"}
{"task_id": "HumanEval/66", "solution": "```python\ndef digitSum(s):\n    \"\"\"Calculates the sum of ASCII codes for uppercase characters in a string.\"\"\"\n\n    def _isUppercase(char: str) -> bool:\n        \"\"\"Checks if a character is an uppercase letter (A-Z, ASCII 65-90).\"\"\"\n        return 'A' <= char <= 'Z'\n\n    def _getAsciiValue(char: str) -> int:\n        \"\"\"Returns the ASCII integer code for a given character.\"\"\"\n        return ord(char)\n\n    def _filterUppercase(chars: list[str]) -> list[str]:\n        \"\"\"Filters a list of characters, returning only uppercase characters.\"\"\"\n        filtered = []\n        for char in chars:\n            if _isUppercase(char):\n                filtered.append(char)\n        return filtered\n\n    def _calculateSum(chars: list[str]) -> int:\n        \"\"\"Calculates the sum of ASCII values for a list of characters.\"\"\"\n        total = 0\n        for char_item in chars:\n            total += _getAsciiValue(char_item)\n        return total\n\n    # Handle empty string case as per requirement.\n    if not s:\n        return 0\n\n    # StringProcessor: processCharacters is implicitly handled by list(s) or direct iteration\n    # StringProcessor: filterUppercase\n    uppercase_chars = _filterUppercase(list(s))\n\n    # AsciiCalculator: calculateSum\n    result_sum = _calculateSum(uppercase_chars)\n\n    return result_sum\n```"}
{"task_id": "HumanEval/64", "solution": "```python\ndef vowels_count(s):\n    \"\"\"Write a function vowels_count which takes a string representing\n    a word as input and returns the number of vowels in the string.\n    Vowels in this case are 'a', 'e', 'i', 'o', 'u'. Here, 'y' is also a\n    vowel, but only when it is at the end of the given word.\n\n    Example:\n    >>> vowels_count(\"abcde\")\n    2\n    >>> vowels_count(\"ACEDY\")\n    3\n    \"\"\"\n    count = 0\n    word_length = len(s)\n\n    for i, char in enumerate(s):\n        normalized_char = char.lower()\n\n        # Check if it's a standard vowel (a, e, i, o, u)\n        if normalized_char in 'aeiou':\n            count += 1\n        # Check if it's 'y' at the end of the word\n        elif normalized_char == 'y' and i == word_length - 1:\n            count += 1\n\n    return count\n```"}
{"task_id": "HumanEval/66", "solution": "```python\ndef digitSum(s):\n    \"\"\"Calculates the sum of ASCII codes for uppercase characters in a string.\n    Ignores lowercase and non-alphabetic characters, returning 0 if none are found.\n    \"\"\"\n    total_sum = 0\n    for char in s:\n        if char.isupper():\n            total_sum += ord(char)\n    return total_sum\n```"}
{"task_id": "HumanEval/64", "solution": "def vowels_count(s):\n    \"\"\"Counts vowels in a string, including 'y' if it's at the end of the word.\n    Standard vowels (a, e, i, o, u) are counted case-insensitively.\n    \"\"\"\n    count = 0\n    word_length = len(s)\n    standard_vowels = {'a', 'e', 'i', 'o', 'u'}\n\n    for i, char in enumerate(s):\n        normalized_char = char.lower()\n        if normalized_char in standard_vowels or \\\n           (normalized_char == 'y' and i == word_length - 1):\n            count += 1\n    return count"}
{"task_id": "HumanEval/65", "solution": "```python\ndef circular_shift(x, shift):\n    \"\"\"Circular shift the digits of the integer x, shift the digits right by shift\n    and return the result as a string. If shift > number of digits, return digits reversed.\n    \"\"\"\n\n    def _get_digit_count(number):\n        \"\"\"Counts the number of digits in an integer, handling absolute value.\"\"\"\n        if number == 0:\n            return 1\n        return len(str(abs(number)))\n\n    def _extract_digits(number):\n        \"\"\"Extracts digits of a number as a string, ignoring its sign for manipulation.\"\"\"\n        return str(abs(number))\n\n    def _perform_circular_shift(digits_str, shift_amount):\n        \"\"\"Performs a circular right shift on a digit string.\"\"\"\n        length = len(digits_str)\n        effective_shift = shift_amount % length\n        return digits_str[-effective_shift:] + digits_str[:-effective_shift]\n\n    def _reverse_digits(digits_str):\n        \"\"\"Reverses a digit string by slicing.\"\"\"\n        return digits_str[::-1]\n\n    def _format_result(digits_str, is_negative):\n        \"\"\"Formats the final result string, preserving the original sign.\"\"\"\n        if is_negative:\n            return \"-\" + digits_str\n        return digits_str\n\n    is_negative = x < 0\n\n    # Handle zero input as a special base case.\n    if x == 0:\n        return \"0\"\n\n    digits_str = _extract_digits(x)\n    digit_count = _get_digit_count(x)\n\n    if shift > digit_count:\n        manipulated_digits = _reverse_digits(digits_str)\n    else:\n        manipulated_digits = _perform_circular_shift(digits_str, shift)\n\n    return _format_result(manipulated_digits, is_negative)\n```"}
{"task_id": "HumanEval/67", "solution": "```python\nimport re\n\ndef fruit_distribution(s, n):\n    \"\"\"\n    In this task, you will be given a string that represents a number of apples and oranges\n    that are distributed in a basket of fruit this basket contains\n    apples, oranges, and mango fruits. Given the string that represents the total number of\n    the oranges and apples and an integer that represent the total number of the fruits\n    in the basket return the number of the mango fruits in the basket.\n    for examble:\n    fruit_distribution(\"5 apples and 6 oranges\", 19) ->19 - 5 - 6 = 8\n    fruit_distribution(\"0 apples and 1 oranges\",3) -> 3 - 0 - 1 = 2\n    fruit_distribution(\"2 apples and 3 oranges\", 100) -> 100 - 2 - 3 = 95\n    fruit_distribution(\"100 apples and 1 oranges\",120) -> 120 - 100 - 1 = 19\n    \"\"\"\n    # Extract numbers from the string using regex\n    numbers = re.findall(r'\\d+', s)\n\n    # Convert to integers - first number is apples, second is oranges\n    apples = int(numbers[0])\n    oranges = int(numbers[1])\n\n    # Calculate mangoes by subtracting apples and oranges from total\n    mangoes = n - apples - oranges\n\n    return mangoes\n```"}
{"task_id": "HumanEval/67", "solution": "```python\nimport re\n\ndef fruit_distribution(s, n):\n    \"\"\"\n    In this task, you will be given a string that represents a number of apples and oranges\n    that are distributed in a basket of fruit this basket contains\n    apples, oranges, and mango fruits. Given the string that represents the total number of\n    the oranges and apples and an integer that represent the total number of the fruits\n    in the basket return the number of the mango fruits in the basket.\n    for examble:\n    fruit_distribution(\"5 apples and 6 oranges\", 19) ->19 - 5 - 6 = 8\n    fruit_distribution(\"0 apples and 1 oranges\",3) -> 3 - 0 - 1 = 2\n    fruit_distribution(\"2 apples and 3 oranges\", 100) -> 100 - 2 - 3 = 95\n    fruit_distribution(\"100 apples and 1 oranges\",120) -> 120 - 100 - 1 = 19\n    \"\"\"\n    # Extract numbers from the string\n    numbers = re.findall(r'\\d+', s)\n\n    # Convert to integers\n    apples = int(numbers[0])\n    oranges = int(numbers[1])\n\n    # Calculate mangoes\n    mangoes = n - apples - oranges\n\n    return mangoes\n```"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Finds the smallest even non-negative integer and its first index in an array.\n    Returns [value, index] or an empty list if no even values are found or the array is empty.\n    \"\"\"\n\n    if not arr:\n        return []\n\n    smallest_even_value = float('inf')\n    smallest_even_index = -1\n\n    for index, value in enumerate(arr):\n        # Check if the current value is even. 0 is considered an even number.\n        if value % 2 == 0:\n            # Update if a smaller even value is found.\n            if value < smallest_even_value:\n                smallest_even_value = value\n                smallest_even_index = index\n\n    if smallest_even_index == -1:\n        return []\n    else:\n        return [smallest_even_value, smallest_even_index]"}
{"task_id": "HumanEval/69", "solution": "def search(lst):\n    '''\n    You are given a non-empty list of positive integers. Return the greatest integer that is greater than\n    zero, and has a frequency greater than or equal to the value of the integer itself.\n    The frequency of an integer is the number of times it appears in the list.\n    If no such a value exist, return -1.\n    Examples:\n        search([4, 1, 2, 2, 3, 1]) == 2\n        search([1, 2, 2, 3, 3, 3, 4, 4, 4]) == 3\n        search([5, 5, 4, 4, 4]) == -1\n    '''\n    # Count frequency of each number\n    frequency_map = {}\n    for num in lst:\n        frequency_map[num] = frequency_map.get(num, 0) + 1\n\n    # Find all numbers where frequency >= value\n    candidates = []\n    for num, freq in frequency_map.items():\n        if freq >= num:\n            candidates.append(num)\n\n    # Return the maximum qualifying number or -1 if none exist\n    if not candidates:\n        return -1\n    return max(candidates)"}
{"task_id": "HumanEval/69", "solution": "```python\nfrom typing import List, Dict\n\ndef count_frequencies(lst: List[int]) -> Dict[int, int]:\n    \"\"\"Counts the frequency of each integer in the list.\n    This uses a single-pass iteration with dictionary updates.\"\"\"\n    freq_map = {}\n    for num in lst:\n        freq_map[num] = freq_map.get(num, 0) + 1\n    return freq_map\n\ndef find_valid_candidates(freq_map: Dict[int, int]) -> List[int]:\n    \"\"\"Identifies integers where frequency is greater than or equal to their value.\n    It filters dictionary entries based on this frequency condition.\"\"\"\n    candidates = []\n    for value, count in freq_map.items():\n        if count >= value:\n            candidates.append(value)\n    return candidates\n\ndef get_maximum_candidate(candidates: List[int]) -> int:\n    \"\"\"Returns the maximum value from a list of qualifying integers.\n    If the list is empty, it returns -1.\"\"\"\n    if not candidates:\n        return -1\n    return max(candidates)\n\ndef search(lst: List[int]) -> int:\n    \"\"\"Finds the greatest integer that has a frequency greater than or equal to its value.\n    It orchestrates calls to helper functions for frequency counting and candidate selection.\"\"\"\n    freq_map = count_frequencies(lst)\n    valid_candidates = find_valid_candidates(freq_map)\n    result = get_maximum_candidate(valid_candidates)\n    return result\n```"}
{"task_id": "HumanEval/68", "solution": "def pluck(arr):\n    \"\"\"\n    Given an array representing a branch of a tree that has non-negative integer nodes\n    your task is to pluck one of the nodes and return it.\n    The plucked node should be the node with the smallest even value.\n    If multiple nodes with the same smallest even value are found return the node that has smallest index.\n\n    The plucked node should be returned in a list, [ smalest_value, its index ],\n    If there are no even values or the given array is empty, return [].\n    \"\"\"\n    if not arr:\n        return []\n\n    smallest_even = None\n    smallest_index = -1\n\n    for index, value in enumerate(arr):\n        if value % 2 == 0:  # Check if the value is even\n            if smallest_even is None or value < smallest_even:\n                smallest_even = value\n                smallest_index = index\n            elif value == smallest_even and index < smallest_index:\n                smallest_index = index\n\n    if smallest_even is not None:\n        return [smallest_even, smallest_index]\n    else:\n        return []"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n\n    Examples:\n    strange_sort_list([1, 2, 3, 4]) == [1, 4, 2, 3]\n    strange_sort_list([5, 5, 5, 5]) == [5, 5, 5, 5]\n    strange_sort_list([]) == []\n    '''\n    if not lst:\n        return []\n\n    working_list = list(lst)\n    result = []\n    is_min_turn = True\n\n    while working_list:\n        if is_min_turn:\n            min_val = min(working_list)\n            min_idx = working_list.index(min_val)\n            result.append(working_list.pop(min_idx))\n        else:\n            max_val = max(working_list)\n            max_idx = working_list.index(max_val)\n            result.append(working_list.pop(max_idx))\n\n        is_min_turn = not is_min_turn\n\n    return result"}
{"task_id": "HumanEval/70", "solution": "def strange_sort_list(lst):\n    '''\n    Given list of integers, return list in strange order.\n    Strange sorting, is when you start with the minimum value,\n    then maximum of the remaining integers, then minimum and so on.\n\n    Examples:\n    strange_sort_list([1, 2, 3, 4]) == [1, 4, 2, 3]\n    strange_sort_list([5, 5, 5, 5]) == [5, 5, 5, 5]\n    strange_sort_list([]) == []\n    '''\n    if not lst:\n        return []\n\n    result = []\n    remaining_elements = list(lst)  # Create a mutable copy to process\n    is_min_turn = True\n\n    while remaining_elements:\n        if is_min_turn:\n            current_val = min(remaining_elements)\n            result.append(current_val)\n            remaining_elements.remove(current_val)\n            is_min_turn = False\n        else:\n            current_val = max(remaining_elements)\n            result.append(current_val)\n            remaining_elements.remove(current_val)\n            is_min_turn = True\n\n    return result"}
{"task_id": "HumanEval/71", "solution": "```python\nimport math\n\ndef triangle_area(a, b, c):\n    \"\"\"\n    Calculates the area of a triangle using Heron's formula.\n    Returns the area rounded to 2 decimal places, or -1 for invalid triangles.\n    \"\"\"\n    # Check if the three sides form a valid triangle using the triangle inequality theorem.\n    if not (a + b > c and a + c > b and b + c > a):\n        return -1\n\n    # Calculate the semi-perimeter.\n    s = (a + b + c) / 2\n\n    # Apply Heron's formula to find the area.\n    # Note: For degenerate triangles (area ~0), s * (s - a) * (s - b) * (s - c) could be slightly negative due to floating point inaccuracies.\n    # We should ensure the value inside sqrt is non-negative, but for valid triangles, it should be positive.\n    # As per constraints, we trust inputs and avoid extra checks.\n    area = math.sqrt(s * (s - a) * (s - b) * (s - c))\n\n    # Round the area to 2 decimal places.\n    return round(area, 2)\n```"}
{"task_id": "HumanEval/71", "solution": "```python\nimport math\n\ndef triangle_area(a, b, c):\n    '''\n    Given the lengths of the three sides of a triangle. Return the area of\n    the triangle rounded to 2 decimal points if the three sides form a valid triangle.\n    Otherwise return -1\n    Three sides make a valid triangle when the sum of any two sides is greater\n    than the third side.\n    Example:\n    triangle_area(3, 4, 5) == 6.00\n    triangle_area(1, 2, 10) == -1\n    '''\n    # Validate triangle inequality theorem and positive side lengths\n    if a <= 0 or b <= 0 or c <= 0:\n        return -1\n\n    if not ((a + b > c) and (a + c > b) and (b + c > a)):\n        return -1\n\n    # Calculate semi-perimeter\n    s = (a + b + c) / 2.0\n\n    # Apply Heron's formula\n    area_squared = s * (s - a) * (s - b) * (s - c)\n\n    # Handle potential floating point inaccuracies\n    if area_squared < 0:\n        return -1\n\n    area = math.sqrt(area_squared)\n\n    # Round to 2 decimal places\n    return round(area, 2)\n```"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q, w):\n    \"\"\"\n    Determine if object q will fly based on palindromic balance and weight constraints.\n    Returns True if object can fly, False otherwise.\n    \"\"\"\n    def is_palindrome(lst):\n        \"\"\"\n        Check if list is palindromic.\n        Returns True if palindromic, False otherwise.\n        \"\"\"\n        return lst == lst[::-1]\n\n    def calculate_sum(lst):\n        \"\"\"\n        Calculate sum of all elements in list.\n        Returns the sum of all elements.\n        \"\"\"\n        return sum(lst)\n\n    is_balanced = is_palindrome(q)\n    total_weight = calculate_sum(q)\n\n    return is_balanced and (total_weight <= w)"}
{"task_id": "HumanEval/72", "solution": "def will_it_fly(q,w):\n    \"\"\"Determines if an object q will fly based on palindromic balance and weight constraints.\n    Returns True only if both conditions are met.\"\"\"\n    # Check if the list is palindromic\n    left, right = 0, len(q) - 1\n    while left < right:\n        if q[left] != q[right]:\n            return False\n        left += 1\n        right -= 1\n\n    # Check if sum is within weight limit\n    return sum(q) <= w"}
