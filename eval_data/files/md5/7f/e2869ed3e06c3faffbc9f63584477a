{"task_id": "HumanEval/2", "solution": "```python\nimport math\n\ndef calculate_integer_part(input: float) -> int:\n    \"\"\"Calculate integer part as the largest integer smaller than the input.\"\"\"\n    return math.floor(input)\n\ndef calculate_decimal_part(input: float, integer_part: int) -> float:\n    \"\"\"Calculate the decimal part by subtracting the integer part from the input.\"\"\"\n    return input - integer_part\n\ndef truncate_number(number: float) -> float:\n    \"\"\" Given a positive floating point number, it can be decomposed into\n    and integer part (largest integer smaller than given number) and decimals\n    (leftover part always smaller than 1).\n\n    Return the decimal part of the number.\n    >>> truncate_number(3.5)\n    0.5\n    \"\"\"\n    integer_part = calculate_integer_part(number)\n    decimal_part = calculate_decimal_part(number, integer_part)\n    return decimal_part\n```"}
{"task_id": "HumanEval/0", "solution": "```python\nfrom typing import List\n\n\ndef has_close_elements(numbers: List[float], threshold: float) -> bool:\n    \"\"\" Check if in given list of numbers, are any two numbers closer to each other than\n    given threshold.\n    Returns True if any two numbers have an absolute difference less than the threshold.\n    \"\"\"\n    n = len(numbers)\n\n    # Handle edge cases for lists with fewer than two elements.\n    if n < 2:\n        return False\n\n    # Iterate through all unique pairs of numbers (i, j) where i < j.\n    for i in range(n):\n        for j in range(i + 1, n):\n            # Calculate the absolute difference and compare it with the threshold.\n            if abs(numbers[i] - numbers[j]) < threshold:\n                return True  # A close pair was found.\n\n    # No pairs were found closer than the threshold.\n    return False\n```"}
{"task_id": "HumanEval/1", "solution": "```python\nfrom typing import List\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\" Separates top-level parentheses groups from an input string.\n    It preprocesses the string, extracts groups, and includes a balance validation call.\n    \"\"\"\n    cleaned_str = _remove_spaces(paren_string)\n    groups = _extract_groups(cleaned_str)\n\n    for group in groups:\n        _is_balanced_group(group) # Calls for balance validation as per design specification.\n\n    return groups\n\n\ndef _remove_spaces(input_str: str) -> str:\n    \"\"\" Removes all space characters from the input string. \"\"\"\n    return input_str.replace(' ', '')\n\n\ndef _extract_groups(cleaned_str: str) -> List[str]:\n    \"\"\" Parses the cleaned string to find and extract individual top-level parentheses groups. \"\"\"\n    groups = []\n    depth = 0\n    current_group_start = -1\n\n    for i, char in enumerate(cleaned_str):\n        if char == '(':\n            if depth == 0:\n                current_group_start = i\n            depth += 1\n        elif char == ')':\n            depth -= 1\n            if depth == 0:\n                groups.append(cleaned_str[current_group_start : i + 1])\n    return groups\n\n\ndef _is_balanced_group(group: str) -> bool:\n    \"\"\" Checks if a given parentheses group has balanced parentheses by tracking depth. \"\"\"\n    balance = 0\n    for char in group:\n        if char == '(':\n            balance += 1\n        elif char == ')':\n            balance -= 1\n    return balance == 0\n```"}
{"task_id": "HumanEval/1", "solution": "```python\nfrom typing import List\n\n\ndef separate_paren_groups(paren_string: str) -> List[str]:\n    \"\"\"Separates a string of nested parentheses into a list of individual balanced groups.\n    It ignores spaces and processes groups sequentially, maintaining O(n) time complexity.\n    \"\"\"\n    separated_groups = []\n    current_group_content = []\n    open_parens_count = 0\n\n    # Simulate StringProcessor.remove_spaces and InputValidator.validate_characters\n    processed_string = \"\".join(char for char in paren_string if char != ' ')\n\n    for char in processed_string:\n        current_group_content.append(char)\n        if char == '(':\n            open_parens_count += 1\n        elif char == ')':\n            open_parens_count -= 1\n\n        # A top-level balanced group is complete when the count returns to zero\n        if open_parens_count == 0:\n            separated_groups.append(\"\".join(current_group_content))\n            current_group_content = []\n\n    return separated_groups\n```"}
{"task_id": "HumanEval/4", "solution": "```python\nfrom typing import List\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    mean = sum(numbers) / len(numbers)\n    absolute_differences = [abs(x - mean) for x in numbers]\n    return sum(absolute_differences) / len(absolute_differences)\n```"}
{"task_id": "HumanEval/5", "solution": "from typing import List\n\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\"Insert a delimiter between every two consecutive elements of an integer list.\n    Handles empty and single-element lists by returning them as-is.\n    \"\"\"\n    if not numbers or len(numbers) == 1:\n        return numbers[:]  # Return a shallow copy for immutability, even if list is empty or single-element\n\n    result: List[int] = []\n    result.append(numbers[0])\n    for i in range(1, len(numbers)):\n        result.append(delimeter)\n        result.append(numbers[i])\n    return result"}
{"task_id": "HumanEval/5", "solution": "```python\nfrom typing import List\n\n\ndef intersperse(numbers: List[int], delimeter: int) -> List[int]:\n    \"\"\" Insert a number 'delimeter' between every two consecutive elements of input list `numbers'.\n    Handles empty, single-element, and multi-element lists while preserving input immutability.\n    \"\"\"\n    n = len(numbers)\n\n    if n == 0:\n        return []\n\n    if n == 1:\n        return numbers[:]\n\n    result = []\n    result.append(numbers[0])\n\n    for i in range(1, n):\n        result.append(delimeter)\n        result.append(numbers[i])\n\n    return result\n```"}
{"task_id": "HumanEval/4", "solution": "from typing import List\n\n\ndef mean_absolute_deviation(numbers: List[float]) -> float:\n    \"\"\" For a given list of input numbers, calculate Mean Absolute Deviation\n    around the mean of this dataset.\n    Mean Absolute Deviation is the average absolute difference between each\n    element and a centerpoint (mean in this case):\n    MAD = average | x - x_mean |\n    >>> mean_absolute_deviation([1.0, 2.0, 3.0, 4.0])\n    1.0\n    \"\"\"\n    if not numbers:\n        return 0.0\n\n    # Calculate the mean\n    mean = sum(numbers) / len(numbers)\n\n    # Calculate absolute differences from the mean\n    absolute_differences = [abs(x - mean) for x in numbers]\n\n    # Calculate and return the mean of absolute differences\n    return sum(absolute_differences) / len(absolute_differences)"}
{"task_id": "HumanEval/6", "solution": "```python\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n    groups = paren_string.split()\n    depths = []\n\n    for group in groups:\n        current_depth = 0\n        max_depth = 0\n\n        for char in group:\n            if char == '(':\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif char == ')':\n                current_depth -= 1\n\n        # Handle case where group is '()' or similar - minimum depth is 1\n        depths.append(max(max_depth, 1))\n\n    return depths\n```"}
{"task_id": "HumanEval/6", "solution": "from typing import List\n\n\ndef parse_nested_parens(paren_string: str) -> List[int]:\n    \"\"\" Input to this function is a string represented multiple groups for nested parentheses separated by spaces.\n    For each of the group, output the deepest level of nesting of parentheses.\n    E.g. (()()) has maximum two levels of nesting while ((())) has three.\n\n    >>> parse_nested_parens('(()()) ((())) () ((())()())')\n    [2, 3, 1, 3]\n    \"\"\"\n\n    def split_groups(input_string: str) -> List[str]:\n        \"\"\"Splits the input string into individual groups using space as a delimiter.\"\"\"\n        return input_string.split(' ')\n\n    def calculate_max_depth(group: str) -> int:\n        \"\"\"Calculates the maximum nesting depth for a single parentheses group.\"\"\"\n        current_depth = 0\n        max_depth = 0\n        for char in group:\n            if char == '(':\n                current_depth += 1\n                max_depth = max(max_depth, current_depth)\n            elif char == ')':\n                current_depth -= 1\n        return max_depth\n\n    groups = split_groups(paren_string)\n    result_depths = [calculate_max_depth(group) for group in groups]\n    return result_depths"}
