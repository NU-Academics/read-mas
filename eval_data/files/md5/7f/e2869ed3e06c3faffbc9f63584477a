{"task_id": "HumanEval/37", "solution": "```python\ndef sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    if not l:\n        return []\n\n    # Extract values at even indices\n    even_values = [l[i] for i in range(0, len(l), 2)]\n\n    # Sort the even values\n    even_values.sort()\n\n    # Create result list by copying original\n    result = l[:]\n\n    # Place sorted even values back at even indices\n    even_idx = 0\n    for i in range(0, len(result), 2):\n        result[i] = even_values[even_idx]\n        even_idx += 1\n\n    return result\n```"}
{"task_id": "HumanEval/36", "solution": "```python\nfrom typing import List\n\ndef is_divisible_by(number: int, divisor: int) -> bool:\n    \"\"\"Checks if a number is perfectly divisible by a given divisor.\"\"\"\n    return number % divisor == 0\n\ndef find_divisible_numbers(n: int) -> List[int]:\n    \"\"\"Finds numbers less than n that are divisible by 11 or 13.\"\"\"\n    qualifying_numbers = []\n    for num in range(1, n):\n        if is_divisible_by(num, 11) or is_divisible_by(num, 13):\n            qualifying_numbers.append(num)\n    return qualifying_numbers\n\ndef count_digit_in_number(number: int) -> int:\n    \"\"\"Counts occurrences of the digit 7 in a single integer.\"\"\"\n    return str(number).count('7')\n\ndef count_digit_occurrences(numbers: List[int]) -> int:\n    \"\"\"Sums the occurrences of digit 7 across a list of numbers.\"\"\"\n    total_sevens = 0\n    for num in numbers:\n        total_sevens += count_digit_in_number(num)\n    return total_sevens\n\ndef fizz_buzz(n: int) -> int:\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\"\"\"\n    qualifying_numbers = find_divisible_numbers(n)\n    total_sevens = count_digit_occurrences(qualifying_numbers)\n    return total_sevens\n```"}
{"task_id": "HumanEval/36", "solution": "def fizz_buzz(n: int):\n    \"\"\"Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.\n    >>> fizz_buzz(50)\n    0\n    >>> fizz_buzz(78)\n    2\n    >>> fizz_buzz(79)\n    3\n    \"\"\"\n    if n <= 0:\n        return 0\n\n    count = 0\n    for i in range(1, n):\n        if i % 11 == 0 or i % 13 == 0:\n            count += str(i).count('7')\n\n    return count"}
{"task_id": "HumanEval/38", "solution": "```python\ndef decode_cyclic(s: str):\n    \"\"\"\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    \"\"\"\n    # Split the string into groups of 3 characters.\n    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n\n    # Reverse cycling for 3-character groups; groups with fewer than 3 characters are unchanged.\n    processed_groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]\n\n    # Join all processed groups back into a single string.\n    return \"\".join(processed_groups)\n```"}
{"task_id": "HumanEval/39", "solution": "```python\ndef is_prime(num: int) -> bool:\n    \"\"\"\n    Checks if a given number is prime using an optimized algorithm.\n    Handles small numbers and iterates up to the square root.\n    \"\"\"\n    if num <= 1:\n        return False\n    if num <= 3:\n        return True\n    if num % 2 == 0 or num % 3 == 0:\n        return False\n    i = 5\n    while i * i <= num:\n        if num % i == 0 or num % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n\ndef generate_fibonacci():\n    \"\"\"\n    Generates an infinite sequence of Fibonacci numbers.\n    Uses a generator for memory efficiency.\n    \"\"\"\n    a, b = 0, 1\n    yield a\n    yield b\n    while True:\n        next_fib = a + b\n        a = b\n        b = next_fib\n        yield next_fib\n\ndef prime_fib(n: int) -> int:\n    \"\"\"\n    Finds the n-th number that is both a Fibonacci number and prime.\n    Orchestrates Fibonacci generation and primality testing.\n    \"\"\"\n    found_primes_count = 0\n    fib_gen = generate_fibonacci()\n\n    # Consume initial Fibonacci numbers that are not prime (0, 1, 1).\n    # The first prime Fibonacci is 2.\n    next(fib_gen) # 0\n    next(fib_gen) # 1\n    next(fib_gen) # 1\n\n    while True:\n        current_fib = next(fib_gen)\n        if is_prime(current_fib):\n            found_primes_count += 1\n            if found_primes_count == n:\n                return current_fib\n```"}
{"task_id": "HumanEval/38", "solution": "```python\ndef decode_cyclic(s: str):\n    \"\"\"\n    Decodes a string that was cyclically encoded by the encode_cyclic function.\n    It reverses the 3-character cyclic shift for full groups, preserving partial groups.\n    \"\"\"\n\n    def _split_into_groups(s: str) -> list[str]:\n        \"\"\"Splits the input string into consecutive groups of up to 3 characters.\"\"\"\n        return [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]\n\n    def _reverse_cycle_group(group: str) -> str:\n        \"\"\"Reverses the cyclic shift for a 3-character group; preserves shorter groups unchanged.\"\"\"\n        if len(group) == 3:\n            # The encoding moved group[0] to the end: `abc` -> `bca`.\n            # To decode `bca` back to `abc`, move the last character `a` to the beginning.\n            return group[-1] + group[:-1]\n        return group\n\n    def _join_groups(groups: list[str]) -> str:\n        \"\"\"Concatenates a list of string groups into a single string.\"\"\"\n        return \"\".join(groups)\n\n    # Main decoding logic orchestrating helper functions\n    groups = _split_into_groups(s)\n\n    processed_groups = []\n    for group in groups:\n        processed_groups.append(_reverse_cycle_group(group))\n\n    return _join_groups(processed_groups)\n```"}
{"task_id": "HumanEval/37", "solution": "```python\ndef sort_even(l: list):\n    \"\"\"This function takes a list l and returns a list l' such that\n    l' is identical to l in the odd indicies, while its values at the even indicies are equal\n    to the values of the even indicies of l, but sorted.\n    >>> sort_even([1, 2, 3])\n    [1, 2, 3]\n    >>> sort_even([5, 6, 3, 4])\n    [3, 6, 5, 4]\n    \"\"\"\n    if not l:\n        return []\n\n    # Extract values from even indices for sorting\n    even_indexed_values = []\n    for i in range(0, len(l), 2):\n        even_indexed_values.append(l[i])\n\n    # Sort the extracted even-indexed values\n    even_indexed_values.sort()\n\n    # Reconstruct the list, placing sorted even values and original odd values\n    result = [None] * len(l)\n    sorted_even_idx = 0\n    for i in range(len(l)):\n        if i % 2 == 0:\n            result[i] = even_indexed_values[sorted_even_idx]\n            sorted_even_idx += 1\n        else:\n            result[i] = l[i]\n\n    return result\n```"}
{"task_id": "HumanEval/39", "solution": "```python\nimport math\nfrom typing import Iterator\n\ndef generate_fibonacci() -> Iterator[int]:\n    \"\"\"Generate Fibonacci sequence starting from 0, 1, 1, 2, 3, 5...\"\"\"\n    a, b = 0, 1\n    yield a\n    yield b\n    while True:\n        a, b = b, a + b\n        yield b\n\ndef is_prime(number: int) -> bool:\n    \"\"\"Check if a number is prime using an optimized trial division method.\"\"\"\n    if number <= 1:\n        return False\n    if number <= 3: # 2 and 3 are prime\n        return True\n    if number % 2 == 0 or number % 3 == 0: # Multiples of 2 or 3 are not prime\n        return False\n    # Check for factors from 5 onwards with a step of 6\n    i = 5\n    while i * i <= number:\n        if number % i == 0 or number % (i + 2) == 0:\n            return False\n        i += 6\n    return True\n\ndef prime_fib(n: int):\n    \"\"\"\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    \"\"\"\n    count_prime_fib = 0\n    fib_gen = generate_fibonacci()\n\n    while True:\n        fib_num = next(fib_gen)\n        if is_prime(fib_num):\n            count_prime_fib += 1\n            if count_prime_fib == n:\n                return fib_num\n```"}
{"task_id": "HumanEval/40", "solution": "```python\ndef triples_sum_to_zero(l: list):\n    \"\"\"\n    triples_sum_to_zero takes a list of integers as an input.\n    It returns True if there are three distinct elements in the list that\n    sum to zero, and False otherwise, using an optimized O(n^2) approach.\n    \"\"\"\n    n = len(l)\n\n    # Handle edge cases for lists with fewer than 3 elements.\n    if n < 3:\n        return False\n\n    # Sort the list to efficiently use the two-pointer technique.\n    l.sort()\n\n    for i in range(n - 2):\n        # Skip duplicate elements for the first number to avoid redundant triplets.\n        if i > 0 and l[i] == l[i-1]:\n            continue\n\n        left, right = i + 1, n - 1\n\n        while left < right:\n            current_sum = l[i] + l[left] + l[right]\n\n            if current_sum == 0:\n                return True\n            elif current_sum < 0:\n                left += 1\n                # Skip duplicate elements for the second number.\n                while left < right and l[left] == l[left-1]:\n                    left += 1\n            else: # current_sum > 0\n                right -= 1\n                # Skip duplicate elements for the third number.\n                while left < right and l[right] == l[right+1]:\n                    right -= 1\n\n    return False\n```"}
