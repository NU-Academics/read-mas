{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Takes a string and returns an ordered version where characters within words are sorted by ASCII.\n    Word order and blank spaces are preserved in the output.\n    \"\"\"\n\n    class Character:\n        \"\"\"Represents a character with its ASCII value for comparison.\"\"\"\n        def __init__(self, value: str):\n            self.value = value\n            self.ascii_value = ord(value)\n\n        def compare(self, other: 'Character') -> int:\n            \"\"\"Compares this character to another based on ASCII values.\"\"\"\n            if self.ascii_value < other.ascii_value:\n                return -1\n            elif self.ascii_value > other.ascii_value:\n                return 1\n            else: # Tie-break by value if ASCII values are the same\n                if self.value < other.value:\n                    return -1\n                elif self.value > other.value:\n                    return 1\n                return 0\n\n        def __lt__(self, other: 'Character') -> bool:\n            \"\"\"Enables direct comparison for sorting.\"\"\"\n            return self.compare(other) < 0\n\n    class Word:\n        \"\"\"Manages individual word processing and character sorting.\"\"\"\n        def __init__(self, original_content: str, position: int):\n            self.original_content = original_content\n            self.position = position\n            self.sorted_content = None # Stores the result after sorting\n\n        def sort_characters(self) -> str:\n            \"\"\"Sorts characters within the word by ASCII values.\"\"\"\n            if not self.original_content:\n                self.sorted_content = \"\"\n                return self.sorted_content\n\n            characters = [Character(c) for c in self.original_content]\n            characters.sort() # Uses Character's __lt__ for sorting\n            self.sorted_content = \"\".join([c.value for c in characters])\n         