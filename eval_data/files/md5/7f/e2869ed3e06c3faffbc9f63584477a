{"task_id": "HumanEval/74", "solution": "def total_match(lst1, lst2):\n    '''\n    Write a function that accepts two lists of strings and returns the list that has\n    total number of chars in the all strings of the list less than the other list.\n\n    if the two lists have the same number of chars, return the first list.\n\n    Examples\n    total_match([], []) \u279e []\n    total_match(['hi', 'admin'], ['hI', 'Hi']) \u279e ['hI', 'Hi']\n    total_match(['hi', 'admin'], ['hi', 'hi', 'admin', 'project']) \u279e ['hi', 'admin']\n    total_match(['hi', 'admin'], ['hI', 'hi', 'hi']) \u279e ['hI', 'hi', 'hi']\n    total_match(['4'], ['1', '2', '3', '4', '5']) \u279e ['4']\n    '''\n    # Calculate total character count for each list\n    count1 = sum(len(s) for s in lst1)\n    count2 = sum(len(s) for s in lst2)\n\n    # Return the list with fewer characters\n    # If counts are equal, return the first list\n    if count1 <= count2:\n        return lst1\n    else:\n        return lst2"}
{"task_id": "HumanEval/75", "solution": "def is_multiply_prime(a):\n    \"\"\"Checks if 'a' is the product of exactly three prime numbers, counting multiplicities.\n    Handles inputs less than 100, returning False for edge cases like a <= 1 or a >= 100.\"\"\"\n\n    # Input validation and edge case handling as per design\n    if a < 1 or a >= 100:\n        return False\n\n    prime_factor_count = 0\n    temp_a = a\n    d = 2\n\n    # Perform prime factorization using trial division\n    while d * d <= temp_a:\n        while temp_a % d == 0:\n            prime_factor_count += 1\n            temp_a //= d\n        d += 1\n\n    # If temp_a is still greater than 1, it is a prime factor itself\n    if temp_a > 1:\n        prime_factor_count += 1\n\n    # Check if exactly 3 prime factors were found\n    return prime_factor_count == 3"}
{"task_id": "HumanEval/75", "solution": "```python\ndef is_multiply_prime(a):\n    \"\"\"Checks if the given number 'a' is a product of exactly three prime numbers.\n    'a' is assumed to be less than 100 as per problem constraints.\n    \"\"\"\n\n    def _validate_input(number):\n        # Validates if the input number is within the allowed range (1 < number < 100).\n        return 1 < number < 100\n\n    def _factorize(number):\n        # Returns a list of prime factors for the given number, including repetitions.\n        factors = []\n        d = 2\n        temp_number = number\n        while d * d <= temp_number:\n            while temp_number % d == 0:\n                factors.append(d)\n                temp_number //= d\n            d += 1\n        if temp_number > 1:\n            factors.append(temp_number)\n        return factors\n\n    # 1. Validation Layer: Handle numbers outside the specified range.\n    if not _validate_input(a):\n        return False\n\n    # 2. Core Logic Layer: Perform prime factorization.\n    prime_factors = _factorize(a)\n\n    # 3. Result Determination: Check if there are exactly three prime factors.\n    return len(prime_factors) == 3\n```"}
{"task_id": "HumanEval/77", "solution": "def iscube(a):\n    if a == 0:\n        return True\n\n    sign = 1 if a >= 0 else -1\n    abs_a = abs(a)\n\n    # Calculate cube root and round to nearest integer\n    cube_root = round(abs_a ** (1/3))\n\n    # Apply original sign\n    signed_root = sign * cube_root\n\n    # Check if cubing the root gives back the original number\n    return signed_root ** 3 == a"}
{"task_id": "HumanEval/77", "solution": "```python\ndef iscube(a):\n    '''\n    Write a function that takes an integer a and returns True\n    if this ingeger is a cube of some integer number.\n    Note: you may assume the input is always valid.\n    Examples:\n    iscube(1) ==> True\n    iscube(2) ==> False\n    iscube(-1) ==> True\n    iscube(64) ==> True\n    iscube(0) ==> True\n    iscube(180) ==> False\n    '''\n    if a == 0:\n        return True\n\n    # Handle negative numbers by taking cube root of absolute value\n    if a < 0:\n        cube_root = round((-a) ** (1/3))\n        return (-cube_root) ** 3 == a\n\n    # Handle positive numbers\n    cube_root = round(a ** (1/3))\n    return cube_root ** 3 == a\n```"}
{"task_id": "HumanEval/76", "solution": "```python\nimport math\n\n_EPSILON = 1e-9\n_MAX_POWER_ITERATIONS = 60 # Maximum iterations for power calculation to prevent infinite loops.\n\ndef _is_close(a, b, rel_tol=_EPSILON, abs_tol=_EPSILON):\n    \"\"\"Checks if two floating-point numbers are approximately equal.\"\"\"\n    return math.isclose(a, b, rel_tol=rel_tol, abs_tol=abs_tol)\n\ndef _handle_edge_cases(x, n):\n    \"\"\"Handles specific edge cases for x and n, returning a boolean or None.\"\"\"\n    if _is_close(x, 1):\n        # x is 1. Any non-zero n raised to the power of 0 is 1.\n        # Python's 0**0 is also 1, so this covers all cases where x is 1.\n        return True\n\n    if _is_close(n, 1):\n        # If n is 1, and x is not 1 (handled above), then 1^i will never be x.\n        return False\n\n    if _is_close(n, 0):\n        # If n is 0, and x is not 1 (handled above), then x must be 0 for it to be a power of 0 (e.g., 0^1).\n        return _is_close(x, 0)\n\n    # If x is negative and n is positive (and not 0 or 1), n^i will always be positive.\n    if x < 0 and n > 0:\n        return False\n\n    # If x is 0 and n is positive (and not 0 or 1), n^i will never be 0.\n    if _is_close(x, 0) and n > 0:\n        return False\n\n    return None # Indicates that normal power calculation is required.\n\ndef _check_positive_powers(x, n):\n    \"\"\"Checks if x can be expressed as n to a non-negative integer power (i >= 0).\"\"\"\n    current_power = 1.0 # Represents n^0\n    if _is_close(current_power, x):\n        return True\n\n    # If n is 0, we've already checked 0^0=1. For i > 0, 0^i=0.\n    if _is_close(n, 0):\n        return _is_close(x, 0)\n\n    # Iterate through positive integer exponents.\n    for i in range(1, _MAX_POWER_ITERATIONS):\n        current_power *= n # Calculate n^i\n        if _is_close(current_power, x):\n            return True\n\n        # Heuristic to stop early if magnitudes diverge significantly.\n        # If n is much larg