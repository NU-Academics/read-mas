target_for_positive_exponent) > 0:\n            return False\n\n        current_power *= n\n\n    return False\n\ndef _calculate_power_relationship(x, n):\n    \"\"\"Orchestrates checking if x is a power of n for integer exponents.\"\"\"\n    if _check_positive_powers(x, n):\n        return True\n\n    if _check_negative_powers(x, n):\n        return True\n\n    return False\n\ndef is_simple_power(x, n):\n    \"\"\"\n    Checks if x is a simple integer power of n (n^i = x for integer i).\n    Handles various numeric inputs and edge cases efficiently.\n    \"\"\"\n    edge_result = _handle_edge_cases(x, n)\n    if edge_result is not None:\n        return edge_result\n\n    return _calculate_power_relationship(x, n)\n```"}
{"task_id": "HumanEval/76", "solution": "```python\nimport math\n\ndef is_simple_power(x, n):\n    \"\"\"Your task is to write a function that returns true if a number x is a simple\n    power of n and false in other cases.\n    x is a simple power of n if n**int=x\n    For example:\n    is_simple_power(1, 4) => true\n    is_simple_power(2, 2) => true\n    is_simple_power(8, 2) => true\n    is_simple_power(3, 2) => false\n    is_simple_power(3, 1) => false\n    is_simple_power(5, 3) => false\n    \"\"\"\n    # Handle edge case: x = 1\n    if abs(x - 1) < 1e-9:\n        return True  # Any non-zero number to power 0 equals 1\n\n    # Handle edge case: n = 0\n    if abs(n) < 1e-9:\n        return abs(x) < 1e-9  # 0^k = 0 for positive k\n\n    # Handle edge case: n = 1\n    if abs(n - 1) < 1e-9:\n        return abs(x - 1) < 1e-9  # 1^k = 1 for any k\n\n    # Handle edge case: n = -1\n    if abs(n + 1) < 1e-9:\n        return abs(x - 1) < 1e-9 or abs(x + 1) < 1e-9  # (-1)^k = 1 or -1\n\n    # Handle impossible cases\n    if x < 0 and n > 0:\n        return False  # Positive base can't produce negative result with integer exponent\n\n    if x == 0:\n        return False  # Only 0^k = 0 for positive k, but n != 0 here\n\n    # For normal cases, try different integer exponents\n    max_exp = 50  # Reasonable limit to prevent overflow\n\n    # Try positive exponents\n    for exp in range(1, max_exp + 1):\n        try:\n            result = n ** exp\n            if abs(result - x) < 1e-9:\n                return True\n            # Early termination for efficiency\n            if abs(n) > 1 and result > abs(x) * 10:\n                break\n        except OverflowError:\n            break\n\n    # Try negative exponents\n    for exp in range(1, max_exp + 1):\n        try:\n            result = n ** (-exp)\n            if abs(result - x) < 1e-9:\n                return True\n            # Early termination for efficiency\n            if abs(n) > 1 and result < abs(x) / 10:\n                break\n        except (OverflowError, ZeroDivisionError):\n            break\n\n    return False\n```"}
