{"task_id": "HumanEval/88", "solution": "```python\ndef sort_array(array):\n    \"\"\"\n    Sorts an array based on the parity of the sum of its first and last elements.\n    Returns a sorted copy, leaving the original array unchanged.\n    \"\"\"\n\n    def _copy_array(arr: list[int]) -> list[int]:\n        \"\"\"Returns a shallow copy of the input list.\"\"\"\n        return list(arr)\n\n    def _calculate_sum(first: int, last: int) -> int:\n        \"\"\"Calculates the sum of two integers.\"\"\"\n        return first + last\n\n    def _is_odd(s: int) -> bool:\n        \"\"\"Determines if a number is odd.\"\"\"\n        return s % 2 != 0\n\n    def _sort_ascending(arr: list[int]) -> list[int]:\n        \"\"\"Sorts the given array in ascending order.\"\"\"\n        return sorted(arr)\n\n    def _sort_descending(arr: list[int]) -> list[int]:\n        \"\"\"Sorts the given array in descending order.\"\"\"\n        return sorted(arr, reverse=True)\n\n    # Handle edge cases for empty or single-element arrays\n    if not array:\n        return []\n    if len(array) == 1:\n        return _copy_array(array)\n\n    first_element = array[0]\n    last_element = array[-1]\n\n    elements_sum = _calculate_sum(first_element, last_element)\n\n    array_copy = _copy_array(array)\n\n    if _is_odd(elements_sum):\n        return _sort_ascending(array_copy)\n    else:\n        return _sort_descending(array_copy)\n```"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    Searches a 2D nested list for a target integer and returns its coordinates.\n    Coordinates are sorted by row ascending, then column descending.\n    \"\"\"\n    results = []\n    for row_idx, row in enumerate(lst):\n        for col_idx, element in enumerate(row):\n            if element == x:\n                results.append((row_idx, col_idx))\n\n    # Sort results by row ascending, then column descending.\n    results.sort(key=lambda coord: (coord[0], -coord[1]))\n    return results"}
{"task_id": "HumanEval/88", "solution": "def sort_array(array):\n    \"\"\"\n    Given an array of non-negative integers, return a copy of the given array after sorting,\n    you will sort the given array in ascending order if the sum( first index value, last index value) is odd,\n    or sort it in descending order if the sum( first index value, last index value) is even.\n\n    Note:\n    * don't change the given array.\n\n    Examples:\n    * sort_array([]) => []\n    * sort_array([5]) => [5]\n    * sort_array([2, 4, 3, 0, 1, 5]) => [0, 1, 2, 3, 4, 5]\n    * sort_array([2, 4, 3, 0, 1, 5, 6]) => [6, 5, 4, 3, 2, 1, 0]\n    \"\"\"\n    # Handle edge cases: empty or single-element arrays\n    if len(array) <= 1:\n        return array.copy()\n\n    # Calculate sum of first and last elements\n    sum_first_last = array[0] + array[-1]\n\n    # Create a copy to avoid modifying the original array\n    array_copy = array.copy()\n\n    # Sort based on whether the sum is odd or even\n    if sum_first_last % 2 == 1:  # odd sum - ascending order\n        return sorted(array_copy)\n    else:  # even sum - descending order\n        return sorted(array_copy, reverse=True)"}
{"task_id": "HumanEval/86", "solution": "def anti_shuffle(s):\n    \"\"\"\n    Write a function that takes a string and returns an ordered version of it.\n    Ordered version of string, is a string where all words (separated by space)\n    are replaced by a new word where all the characters arranged in\n    ascending order based on ascii value.\n    Note: You should keep the order of words and blank spaces in the sentence.\n\n    For example:\n    anti_shuffle('Hi') returns 'Hi'\n    anti_shuffle('hello') returns 'ehllo'\n    anti_shuffle('Hello World!!!') returns 'Hello !!!Wdlor'\n    \"\"\"\n    if not s:\n        return s\n\n    words = s.split(' ')\n    result = []\n\n    for word in words:\n        sorted_word = ''.join(sorted(word))\n        result.append(sorted_word)\n\n    return ' '.join(result)"}
{"task_id": "HumanEval/89", "solution": "```python\ndef encrypt(s):\n    \"\"\"Encrypts a string by shifting each lowercase letter 4 positions forward with wraparound.\n    Handles 'a'-'z' characters only.\"\"\"\n    SHIFT_VALUE = 4\n    ALPHABET_SIZE = 26\n\n    encrypted_chars = []\n    for char in s:\n        # Calculate the 0-25 index of the character\n        char_index = ord(char) - ord('a')\n        # Apply the shift and handle wraparound using modulo\n        shifted_index = (char_index + SHIFT_VALUE) % ALPHABET_SIZE\n        # Convert the shifted index back to a character\n        encrypted_char = chr(shifted_index + ord('a'))\n        encrypted_chars.append(encrypted_char)\n\n    return \"\".join(encrypted_chars)\n```"}
{"task_id": "HumanEval/89", "solution": "```python\ndef encrypt(s):\n    \"\"\"Create a function encrypt that takes a string as an argument and\n    returns a string encrypted with the alphabet being rotated.\n    The alphabet should be rotated in a manner such that the letters\n    shift down by two multiplied to two places.\n    \"\"\"\n    encrypted_chars = []\n    shift_amount = 4\n\n    for char in s:\n        if 'a' <= char <= 'z':\n            start_ord = ord('a')\n            current_pos = ord(char) - start_ord\n            new_pos = (current_pos + shift_amount) % 26\n            encrypted_chars.append(chr(start_ord + new_pos))\n        elif 'A' <= char <= 'Z':\n            start_ord = ord('A')\n            current_pos = ord(char) - start_ord\n            new_pos = (current_pos + shift_amount) % 26\n            encrypted_chars.append(chr(start_ord + new_pos))\n        else:\n            encrypted_chars.append(char)\n\n    return \"\".join(encrypted_chars)\n```"}
{"task_id": "HumanEval/87", "solution": "def get_row(lst, x):\n    \"\"\"\n    You are given a 2 dimensional data, as a nested lists,\n    which is similar to matrix, however, unlike matrices,\n    each row may contain a different number of columns.\n    Given lst, and integer x, find integers x in the list,\n    and return list of tuples, [(x1, y1), (x2, y2) ...] such that\n    each tuple is a coordinate - (row, columns), starting with 0.\n    Sort coordinates initially by rows in ascending order.\n    Also, sort coordinates of the row by columns in descending order.\n\n    Examples:\n    get_row([\n      [1,2,3,4,5,6],\n      [1,2,3,4,1,6],\n      [1,2,3,4,5,1]\n    ], 1) == [(0, 0), (1, 4), (1, 0), (2, 5), (2, 0)]\n    get_row([], 1) == []\n    get_row([[], [1], [1, 2, 3]], 3) == [(2, 2)]\n    \"\"\"\n    if not lst:\n        return []\n\n    coordinates = []\n\n    for row_index, row in enumerate(lst):\n        for col_index, element in enumerate(row):\n            if element == x:\n                coordinates.append((row_index, col_index))\n\n    # Sort by row ascending (first element), then by column descending (second element)\n    coordinates.sort(key=lambda coord: (coord[0], -coord[1]))\n\n    return coordinates"}
{"task_id": "HumanEval/90", "solution": "```python\ndef next_smallest(lst):\n    \"\"\"\n    Finds the second smallest unique element in a list of integers.\n    Returns None if no such element exists due to various edge cases.\n    \"\"\"\n\n    def _validate_input(lst_param):\n        \"\"\"\n        Validates if the input list is not empty.\n        Returns True if not empty, False otherwise.\n        \"\"\"\n        return len(lst_param) > 0\n\n    def _get_unique_sorted(lst_param):\n        \"\"\"\n        Extracts unique elements from the list and returns them sorted.\n        Uses a set for uniqueness and then sorts the resulting list.\n        \"\"\"\n        return sorted(list(set(lst_param)))\n\n    def _find_second_smallest(unique_list_param):\n        \"\"\"\n        Returns the second element if the list has at least two elements.\n        Otherwise, returns None, indicating insufficient unique values.\n        \"\"\"\n        if len(unique_list_param) >= 2:\n            return unique_list_param[1]\n        return None\n\n    if not _validate_input(lst):\n        return None\n\n    unique_sorted_list = _get_unique_sorted(lst)\n\n    return _find_second_smallest(unique_sorted_list)\n```"}
{"task_id": "HumanEval/91", "solution": "```python\nimport re\n\ndef is_bored(S):\n    \"\"\"\n    Counts sentences starting with \"I\" delimited by '.', '?', or '!'.\n    Handles empty strings by returning 0 and processes text efficiently.\n    \"\"\"\n    if not S:\n        return 0\n\n    # Split the string into potential sentences using delimiters.\n    # The delimiters themselves are not part of the resulting sentence fragments.\n    sentences_raw = re.split(r'[.?!]', S)\n\n    bored_count = 0\n    for sentence_fragment in sentences_raw:\n        # Clean leading/trailing whitespace from each fragment.\n        clean_sentence = sentence_fragment.strip()\n\n        # A sentence is considered \"bored\" if it's not empty and\n        # starts with the exact word \"I\" (case-sensitive),\n        # either followed by a space or being \"I\" itself.\n        if clean_sentence and (clean_sentence.startswith(\"I \") or clean_sentence == \"I\"):\n            bored_count += 1\n\n    return bored_count\n```"}
{"task_id": "HumanEval/90", "solution": "```python\ndef validate_input(lst):\n    \"\"\"Checks if the input list is not empty for processing.\n    Returns True if the list has elements, False otherwise.\n    \"\"\"\n    return len(lst) > 0\n\ndef extract_unique(lst):\n    \"\"\"Extracts unique elements from a list of integers.\n    Returns a set containing only the unique elements.\n    \"\"\"\n    return set(lst)\n\ndef find_second_smallest(unique_elements):\n    \"\"\"Finds the second smallest element from a set of unique integers.\n    Returns the second smallest element or None if fewer than two unique elements exist.\n    \"\"\"\n    if len(unique_elements) < 2:\n        return None\n    sorted_unique = sorted(list(unique_elements))\n    return sorted_unique[1]\n\ndef next_smallest(lst):\n    \"\"\"Returns the second smallest unique element in a list of integers.\n    Returns None for empty lists, or lists with insufficient unique elements.\n    \"\"\"\n    if not validate_input(lst):\n        return None\n\n    unique_elements = extract_unique(lst)\n    return find_second_smallest(unique_elements)\n```"}
{"task_id": "HumanEval/92", "solution": "```python\ndef any_int(x, y, z):\n    \"\"\"\n    Checks if three numbers are all integers and one equals the sum of the other two.\n    Returns True for integer sums, False otherwise, including for floating-point inputs.\n    \"\"\"\n    def is_integer(value: float) -> bool:\n        \"\"\"\n        Determines if a numeric value represents an integer.\n        It returns True if the value has no fractional part, False otherwise.\n        \"\"\"\n        return value == int(value)\n\n    def check_sum_condition(a: int, b: int, c: int) -> bool:\n        \"\"\"\n        Verifies if one of the given integers equals the sum of the other two.\n        This function handles positive, negative, and zero values.\n        \"\"\"\n        return (a + b == c) or (a + c == b) or (b + c == a)\n\n    # Validate that all inputs are integers.\n    if not (is_integer(x) and is_integer(y) and is_integer(z)):\n        return False\n\n    # Check the sum condition with the validated integer values.\n    return check_sum_condition(int(x), int(y), int(z))\n```"}
{"task_id": "HumanEval/91", "solution": "Looking at the generated code, I need to provide a cleaner implementation that directly addresses the problem without the helper functions (since the original task just asks for the function). Let me provide the optimized version:\n\n```python\ndef is_bored(S):\n    \"\"\"\n    You'll be given a string of words, and your task is to count the number\n    of boredoms. A boredom is a sentence that starts with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n\n    For example:\n    >>> is_bored(\"Hello world\")\n    0\n    >>> is_bored(\"The sky is blue. The sun is shining. I love this weather\")\n    1\n    \"\"\"\n    import re\n\n    # Split the string into sentences using delimiters '.', '?', '!'\n    sentences = re.split(r'[.?!]', S)\n\n    boredom_count = 0\n    for sentence in sentences:\n        # Strip whitespace and check if sentence starts with \"I\"\n        trimmed = sentence.strip()\n        if trimmed.startswith('I ') or trimmed == 'I':\n            boredom_count += 1\n\n    return boredom_count\n```"}
{"task_id": "HumanEval/92", "solution": "```python\ndef any_int(x, y, z):\n    '''\n    Create a function that takes 3 numbers.\n    Returns true if one of the numbers is equal to the sum of the other two, and all numbers are integers.\n    Returns false in any other cases.\n\n    Examples\n    any_int(5, 2, 7) \u279e True\n\n    any_int(3, 2, 2) \u279e False\n\n    any_int(3, -2, 1) \u279e True\n\n    any_int(3.6, -2.2, 2) \u279e False\n    '''\n    # Check if all parameters are integers\n    if not (isinstance(x, int) and isinstance(y, int) and isinstance(z, int)):\n        return False\n\n    # Check if any parameter equals the sum of the other two\n    return (x == y + z) or (y == x + z) or (z == x + y)\n```"}
{"task_id": "HumanEval/93", "solution": "```python\ndef encode(message):\n    \"\"\"\n    Transforms input text by applying case swapping and vowel replacement.\n    The function swaps case of all letters and replaces specific vowels with letters 2 positions ahead.\n    \"\"\"\n    VOWEL_MAP = {\n        'a': 'c', 'A': 'C',\n        'e': 'g', 'E': 'G',\n        'i': 'k', 'I': 'K',\n        'o': 'q', 'O': 'Q',\n        'u': 'w', 'U': 'W'\n    }\n\n    result_chars = []\n    for char in message:\n        if char.isalpha():\n            swapped_char = char.swapcase()\n            if swapped_char in VOWEL_MAP:\n                result_chars.append(VOWEL_MAP[swapped_char])\n            else:\n                result_chars.append(swapped_char)\n        else:\n            result_chars.append(char)\n\n    return \"\".join(result_chars)\n```"}
{"task_id": "HumanEval/93", "solution": "def encode(message):\n    \"\"\"\n    Write a function that takes a message, and encodes in such a\n    way that it swaps case of all letters, replaces all vowels in\n    the message with the letter that appears 2 places ahead of that\n    vowel in the english alphabet.\n    Assume only letters.\n\n    Examples:\n    >>> encode('test')\n    'TGST'\n    >>> encode('This is a message')\n    'tHKS KS C MGSSCGG'\n    \"\"\"\n    vowel_map = {'a': 'c', 'e': 'g', 'i': 'k', 'o': 'q', 'u': 'w'}\n    result = []\n\n    for char in message:\n        if char.isalpha():\n            # Swap case first\n            swapped_char = char.swapcase()\n            # Check if the swapped character is a vowel\n            if swapped_char.lower() in vowel_map:\n                # Replace vowel with letter 2 positions ahead, preserve case\n                replacement = vowel_map[swapped_char.lower()]\n                if swapped_char.isupper():\n                    replacement = replacement.upper()\n                result.append(replacement)\n            else:\n                result.append(swapped_char)\n        else:\n            result.append(char)\n\n    return ''.join(result)"}
{"task_id": "HumanEval/94", "solution": "def is_prime(n: int) -> bool:\n    \"\"\"Checks if a number is prime using optimized trial division.\"\"\"\n    if n <= 1:\n        return False\n    if n == 2:\n        return True\n    if n % 2 == 0:\n        return False\n    i = 3\n    while i * i <= n:\n        if n % i == 0:\n            return False\n        i += 2\n    return True\n\ndef find_primes(numbers: list[int]) -> list[int]:\n    \"\"\"Filters a list of integers, returning only the prime numbers.\"\"\"\n    prime_numbers = []\n    for num in numbers:\n        if is_prime(num):\n            prime_numbers.append(num)\n    return prime_numbers\n\ndef find_largest_prime(primes: list[int]) -> int:\n    \"\"\"Finds the largest prime number from a list of primes.\"\"\"\n    return max(primes)\n\ndef calculate_digit_sum(number: int) -> int:\n    \"\"\"Calculates the sum of all digits in a given integer.\"\"\"\n    digit_sum = 0\n    for digit_char in str(number):\n        digit_sum += int(digit_char)\n    return digit_sum\n\ndef skjkasdkd(lst: list[int]) -> int:\n    \"\"\"Processes a list of integers to find the largest prime's digit sum.\"\"\"\n    primes = find_primes(lst)\n    largest_prime = find_largest_prime(primes)\n    return calculate_digit_sum(largest_prime)"}
{"task_id": "HumanEval/95", "solution": "```python\ndef check_dict_case(dict):\n    \"\"\"\n    Validates if all dictionary keys are strings and follow consistent casing.\n    Returns False for empty dictionaries, non-string keys, or mixed case.\n    \"\"\"\n    if not dict:\n        return False\n\n    # First, ensure all keys are strings.\n    for key in dict.keys():\n        if not isinstance(key, str):\n            return False\n\n    # Check if all keys are consistently lowercase.\n    all_lower = True\n    for key in dict.keys():\n        if not key.islower():\n            all_lower = False\n            break\n\n    # If not all lowercase, check if all keys are consistently uppercase.\n    if not all_lower:\n        all_upper = True\n        for key in dict.keys():\n            if not key.isupper():\n                all_upper = False\n                break\n        return all_upper\n    else:\n        return True\n```"}
{"task_id": "HumanEval/94", "solution": "```python\nimport math\nfrom typing import List\n\ndef skjkasdkd(lst: List[int]) -> int:\n    \"\"\"\n    Find largest prime in list and return sum of its digits.\n    Returns 0 for empty lists or lists with no primes.\n    \"\"\"\n    def is_prime(n: int) -> bool:\n        \"\"\"Check if n is a prime number.\"\"\"\n        if n <= 1:\n            return False\n        if n <= 3:\n            return True\n        if n % 2 == 0 or n % 3 == 0:\n            return False\n        i = 5\n        while i * i <= n:\n            if n % i == 0 or n % (i + 2) == 0:\n                return False\n            i += 6\n        return True\n\n    def find_largest_prime(lst_internal: List[int]) -> int:\n        \"\"\"Find largest prime in list. Returns 0 if no primes found.\"\"\"\n        largest_prime = 0\n        for num in lst_internal:\n            if is_prime(num):\n                if num > largest_prime:\n                    largest_prime = num\n        return largest_prime\n\n    def sum_digits(n: int) -> int:\n        \"\"\"Calculate sum of all digits in number n.\"\"\"\n        s = 0\n        while n > 0:\n            s += n % 10\n            n //= 10\n        return s\n\n    if not lst:\n        return 0\n\n    largest_prime_val = find_largest_prime(lst)\n\n    if largest_prime_val == 0:\n        return 0\n    else:\n        return sum_digits(largest_prime_val)\n```"}
{"task_id": "HumanEval/95", "solution": "def check_dict_case(dict):\n    \"\"\"\n    Given a dictionary, return True if all keys are strings in lower\n    case or all keys are strings in upper case, else return False.\n    The function should return False is the given dictionary is empty.\n    Examples:\n    check_dict_case({\"a\":\"apple\", \"b\":\"banana\"}) should return True.\n    check_dict_case({\"a\":\"apple\", \"A\":\"banana\", \"B\":\"banana\"}) should return False.\n    check_dict_case({\"a\":\"apple\", 8:\"banana\", \"a\":\"apple\"}) should return False.\n    check_dict_case({\"Name\":\"John\", \"Age\":\"36\", \"City\":\"Houston\"}) should return False.\n    check_dict_case({\"STATE\":\"NC\", \"ZIP\":\"12345\" }) should return True.\n    \"\"\"\n    # Return False for empty dictionary\n    if len(dict) == 0:\n        return False\n\n    # Check if all keys are strings\n    keys_list = list(dict.keys())\n    for key in keys_list:\n        if not isinstance(key, str):\n            return False\n\n    # Check if all keys are lowercase or all uppercase\n    all_lower = True\n    all_upper = True\n\n    for key in keys_list:\n        if not key.islower():\n            all_lower = False\n        if not key.isupper():\n            all_upper = False\n        # Early exit optimization\n        if not all_lower and not all_upper:\n            return False\n\n    return all_lower or all_upper"}
{"task_id": "HumanEval/96", "solution": "```python\ndef count_up_to(n):\n    \"\"\"Implement a function that takes an non-negative integer and returns an array of the first n\n    integers that are prime numbers and less than n.\n    for example:\n    count_up_to(5) => [2,3]\n    count_up_to(11) => [2,3,5,7]\n    count_up_to(0) => []\n    count_up_to(20) => [2,3,5,7,11,13,17,19]\n    count_up_to(1) => []\n    count_up_to(18) => [2,3,5,7,11,13,17]\n    \"\"\"\n    if n <= 1:\n        return []\n\n    # Initialize sieve array\n    is_prime = [True] * n\n    is_prime[0] = is_prime[1] = False\n\n    # Sieve of Eratosthenes\n    for p in range(2, int(n**0.5) + 1):\n        if is_prime[p]:\n            # Mark multiples of p as not prime\n            for multiple in range(p * p, n, p):\n                is_prime[multiple] = False\n\n    # Collect all prime numbers\n    primes = []\n    for i in range(2, n):\n        if is_prime[i]:\n            primes.append(i)\n\n    return primes\n```"}
{"task_id": "HumanEval/97", "solution": "```python\ndef multiply(a, b):\n    \"\"\"\n    Calculates the product of the unit digits of two integers.\n    Handles negative numbers by using their absolute values for extraction.\n    \"\"\"\n    unit_digit_a = abs(a) % 10\n    unit_digit_b = abs(b) % 10\n    return unit_digit_a * unit_digit_b\n```"}
{"task_id": "HumanEval/97", "solution": "```python\ndef extractUnitDigit(number):\n    \"\"\"Extracts the unit digit from an integer, handling negative numbers by using the absolute value.\"\"\"\n    return abs(number) % 10\n\ndef multiply(a, b):\n    \"\"\"Returns the product of the unit digits of two integers, extracting unit digits from their absolute values.\"\"\"\n    unit_digit_a = extractUnitDigit(a)\n    unit_digit_b = extractUnitDigit(b)\n    return unit_digit_a * unit_digit_b\n```"}
{"task_id": "HumanEval/96", "solution": "def _handle_edge_cases(n):\n    \"\"\"Handles edge cases for n <= 1, returning an empty list.\"\"\"\n    if n <= 1:\n        return []\n    return None\n\ndef _create_sieve(limit):\n    \"\"\"Generates a boolean sieve array up to limit (exclusive).\"\"\"\n    # is_prime[i] is True if i is prime. Sieve covers numbers from 0 to limit-1.\n    is_prime = [True] * limit\n    is_prime[0] = False  # 0 is not prime\n    is_prime[1] = False  # 1 is not prime\n\n    p = 2\n    while p * p < limit:\n        if is_prime[p]:\n            # Mark multiples of p as not prime, starting from p*p.\n            for multiple in range(p * p, limit, p):\n                is_prime[multiple] = False\n        p += 1\n    return is_prime\n\ndef _extract_primes_from_sieve(is_prime_sieve):\n    \"\"\"Extracts prime numbers from a boolean sieve array.\"\"\"\n    primes = []\n    # Primes start from 2. Iterate from 2 up to the last index of the sieve.\n    for num in range(2, len(is_prime_sieve)):\n        if is_prime_sieve[num]:\n            primes.append(num)\n    return primes\n\ndef count_up_to(n):\n    \"\"\"Generates all prime numbers less than n using the Sieve of Eratosthenes.\"\"\"\n    result_from_edge_case = _handle_edge_cases(n)\n    if result_from_edge_case is not None:\n        return result_from_edge_case\n\n    # Create the sieve for numbers up to n-1 (inclusive), so the array size is n.\n    sieve_array = _create_sieve(n)\n    prime_list = _extract_primes_from_sieve(sieve_array)\n\n    return prime_list"}
