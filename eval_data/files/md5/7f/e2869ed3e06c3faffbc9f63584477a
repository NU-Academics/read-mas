{"task_id": "HumanEval/9", "solution": "```python\nfrom typing import List\n\n\ndef rolling_max(numbers: List[int]) -> List[int]:\n    \"\"\" From a given list of integers, generate a list of rolling maximum element found until given moment\n    in the sequence.\n    >>> rolling_max([1, 2, 3, 2, 3, 4, 2])\n    [1, 2, 3, 3, 3, 4, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    rolling_maxes = []\n    current_max = numbers[0]\n    rolling_maxes.append(current_max)\n\n    for i in range(1, len(numbers)):\n        current_max = max(current_max, numbers[i])\n        rolling_maxes.append(current_max)\n\n    return rolling_maxes\n```"}
{"task_id": "HumanEval/11", "solution": "def string_xor(a: str, b: str) -> str:\n    \"\"\" Input are two strings a and b consisting only of 1s and 0s.\n    Perform binary XOR on these inputs and return result also as a string.\n    >>> string_xor('010', '110')\n    '100'\n    \"\"\"\n    # Handle empty strings\n    if not a and not b:\n        return \"0\"\n    if not a:\n        return b.lstrip('0') or \"0\"\n    if not b:\n        return a.lstrip('0') or \"0\"\n\n    # Pad strings to equal length\n    max_len = max(len(a), len(b))\n    a = a.zfill(max_len)\n    b = b.zfill(max_len)\n\n    # Perform XOR operation\n    result = \"\"\n    for i in range(len(a)):\n        bit_xor = str(int(a[i]) ^ int(b[i]))\n        result += bit_xor\n\n    # Remove leading zeros, but keep at least one digit\n    result = result.lstrip('0') or \"0\"\n\n    return result"}
{"task_id": "HumanEval/10", "solution": "def is_palindrome(string: str) -> bool:\n    \"\"\" Test if given string is a palindrome. \"\"\"\n    return string == string[::-1]\n\n\ndef _find_longest_palindromic_postfix(string: str) -> int:\n    \"\"\" Finds the starting index of the longest palindromic postfix. \"\"\"\n    n = len(string)\n    for i in range(n):\n        if is_palindrome(string[i:]):\n            return i\n    return n # Should not be reached for non-empty string, as a single character is a palindrome.\n\n\ndef _get_prefix_before_postfix(string: str, postfix_start: int) -> str:\n    \"\"\" Extracts the prefix portion before the palindromic postfix. \"\"\"\n    return string[:postfix_start]\n\n\ndef make_palindrome(string: str) -> str:\n    \"\"\" Find the shortest palindrome that begins with a supplied string. \"\"\"\n    if not string:\n        return \"\"\n\n    postfix_start = _find_longest_palindromic_postfix(string)\n    prefix_to_reverse = _get_prefix_before_postfix(string, postfix_start)\n\n    reversed_prefix = prefix_to_reverse[::-1]\n\n    return string + reversed_prefix"}
{"task_id": "HumanEval/12", "solution": "```python\nfrom typing import List, Optional\n\n\ndef longest(strings: List[str]) -> Optional[str]:\n    \"\"\"Out of list of strings, return the longest one.\n    Returns None if the list is empty, otherwise the first longest string.\n    \"\"\"\n    if not strings:\n        return None\n\n    # Initialize max_length to 0 and result to None.\n    # The first string encountered will set these values, correctly handling\n    # lists containing only empty strings or short strings.\n    max_length = -1  # Initialize to -1 to ensure even an empty string \"\" (length 0) can be picked up.\n    result = None\n\n    for s in strings:\n        current_length = len(s)\n        # If the current string is longer than the previously found longest,\n        # update the longest string and its length. This implicitly handles\n        # returning the first occurrence for strings of equal maximum length\n        # because the update only happens if strictly greater.\n        if current_length > max_length:\n            max_length = current_length\n            result = s\n\n    return result\n```"}
