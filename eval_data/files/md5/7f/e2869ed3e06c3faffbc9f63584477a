{"task_id": "HumanEval/25", "solution": "```python\nfrom typing import List\n\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    Input number should be equal to the product of all factors\n    >>> factorize(8)\n    [2, 2, 2]\n    >>> factorize(25)\n    [5, 5]\n    >>> factorize(70)\n    [2, 5, 7]\n    \"\"\"\n    if n == 1:\n        return []\n\n    factors = []\n    d = 2\n\n    # Find all factors of 2\n    while n % 2 == 0:\n        factors.append(2)\n        n //= 2\n\n    # Find odd factors from 3 onwards\n    d = 3\n    while d * d <= n:\n        while n % d == 0:\n            factors.append(d)\n            n //= d\n        d += 2\n\n    # If n is still greater than 1, it's a prime factor\n    if n > 1:\n        factors.append(n)\n\n    return factors\n```"}
{"task_id": "HumanEval/26", "solution": "```python\nfrom typing import List, Dict\n\n\ndef _count_occurrences(numbers: List[int]) -> Dict[int, int]:\n    \"\"\"Counts occurrences of each element in a list.\n    Returns a dictionary mapping elements to their counts.\n    \"\"\"\n    counts: Dict[int, int] = {}\n    for number in numbers:\n        counts[number] = counts.get(number, 0) + 1\n    return counts\n\n\ndef _filter_unique_elements(numbers: List[int], counts: Dict[int, int]) -> List[int]:\n    \"\"\"Filters elements that appear exactly once, preserving original order.\n    Iterates through the original list and appends only truly unique elements.\n    \"\"\"\n    result: List[int] = []\n    for number in numbers:\n        if counts[number] == 1:\n            result.append(number)\n    return result\n\n\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\"From a list of integers, remove all elements that occur more than once.\n    Keep order of elements left the same as in the input.\n    >>> remove_duplicates([1, 2, 3, 2, 4])\n    [1, 3, 4]\n    \"\"\"\n    if not numbers:\n        return []\n\n    occurrences = _count_occurrences(numbers)\n    return _filter_unique_elements(numbers, occurrences)\n```"}
{"task_id": "HumanEval/25", "solution": "from typing import List\n\n\ndef factorize(n: int) -> List[int]:\n    \"\"\" Return list of prime factors of given integer in the order from smallest to largest.\n    Each of the factors should be listed number of times corresponding to how many times it appeares in factorization.\n    \"\"\"\n    factors = []\n\n    if n == 1:\n        return []\n\n    factor = 2\n    while factor * factor <= n:\n        if n % factor == 0:\n            factors.append(factor)\n            n //= factor\n        else:\n            factor += 1\n\n    if n > 1:\n        factors.append(n)\n\n    return factors"}
{"task_id": "HumanEval/26", "solution": "```python\nfrom typing import List, Dict\n\n\ndef _count_occurrences(numbers: List[int]) -> Dict[int, int]:\n    \"\"\"Counts the frequency of each element in a list.\n    Returns a dictionary mapping elements to their counts.\"\"\"\n    counts = {}\n    for num in numbers:\n        counts[num] = counts.get(num, 0) + 1\n    return counts\n\n\ndef _filter_unique_elements(numbers: List[int], counts: Dict[int, int]) -> List[int]:\n    \"\"\"Filters a list to include only elements that appear exactly once, preserving order.\n    Uses the provided counts dictionary to determine uniqueness.\"\"\"\n    result = []\n    for num in numbers:\n        if counts[num] == 1:\n            result.append(num)\n    return result\n\n\ndef remove_duplicates(numbers: List[int]) -> List[int]:\n    \"\"\"Removes all elements that occur more than once from a list of integers.\n    Preserves the order of unique elements.\"\"\"\n    if not numbers:\n        return []\n\n    counts = _count_occurrences(numbers)\n    result = _filter_unique_elements(numbers, counts)\n    return result\n```"}
{"task_id": "HumanEval/27", "solution": "```python\ndef is_alphabetic(char: str) -> bool:\n    \"\"\"Checks if a character is an alphabetic character.\"\"\"\n    return char.isalpha()\n\ndef flip_character_case(char: str) -> str:\n    \"\"\"Flips the case of a single alphabetic character.\"\"\"\n    if char.islower():\n        return char.upper()\n    elif char.isupper():\n        return char.lower()\n    return char\n\ndef flip_case(string: str) -> str:\n    \"\"\"For a given string, flip lowercase characters to uppercase and uppercase to lowercase.\"\"\"\n    processed_chars = []\n    for char in string:\n        if is_alphabetic(char):\n            processed_chars.append(flip_character_case(char))\n        else:\n            processed_chars.append(char)\n    return \"\".join(processed_chars)\n```"}
