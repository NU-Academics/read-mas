{"task_id": "Mbpp/556", "solution": "```python\ndef find_Odd_Pair(input_list: list[int], list_length: int) -> int:\n    \"\"\"\n    Counts pairs in a list whose bitwise XOR sum is odd.\n    Iterates through unique pairs and checks the parity of their XOR sum.\n    \"\"\"\n    odd_pair_count = 0\n\n    for i in range(list_length):\n        for j in range(i + 1, list_length):\n            num1 = input_list[i]\n            num2 = input_list[j]\n            xor_sum = num1 ^ num2\n            if xor_sum % 2 != 0:\n                odd_pair_count += 1\n    return odd_pair_count\n```"}
{"task_id": "Mbpp/555", "solution": "```python\ndef difference(n: int) -> int:\n    \"\"\"\n    Calculates the difference between the sum of cubes of the first n natural numbers\n    and the sum of the first n natural numbers using optimized formulas.\n    \"\"\"\n    sum_natural = n * (n + 1) // 2\n    sum_cubes = sum_natural ** 2\n    result = sum_cubes - sum_natural\n    return result\n```"}
{"task_id": "Mbpp/557", "solution": "```python\ndef _is_alphabetic(char: str) -> bool:\n    \"\"\"Checks if a character is an alphabetic letter (ASCII a-z, A-Z).\"\"\"\n    char_code = ord(char)\n    return (ord('a') <= char_code <= ord('z')) or \\\n           (ord('A') <= char_code <= ord('Z'))\n\ndef _is_uppercase(char: str) -> bool:\n    \"\"\"Checks if an alphabetic character is uppercase (ASCII A-Z).\"\"\"\n    char_code = ord(char)\n    return ord('A') <= char_code <= ord('Z')\n\ndef _to_lowercase(char: str) -> str:\n    \"\"\"Converts an uppercase ASCII character to its lowercase equivalent.\"\"\"\n    return chr(ord(char) + 32)\n\ndef _to_uppercase(char: str) -> str:\n    \"\"\"Converts a lowercase ASCII character to its uppercase equivalent.\"\"\"\n    return chr(ord(char) - 32)\n\ndef toggle_string(input_string: str) -> str:\n    \"\"\"\n    Toggles the case of alphabetic characters in a string, preserving non-alphabetic characters.\n    Handles empty input strings by returning an empty string.\n    \"\"\"\n    if not input_string:\n        return \"\"\n\n    result_chars = []\n    for char in input_string:\n        if _is_alphabetic(char):\n            if _is_uppercase(char):\n                result_chars.append(_to_lowercase(char))\n            else:  # If alphabetic and not uppercase, it must be lowercase\n                result_chars.append(_to_uppercase(char))\n        else:\n            result_chars.append(char) # Non-alphabetic characters are preserved\n    return \"\".join(result_chars)\n```"}
{"task_id": "Mbpp/556", "solution": "```python\ndef _is_odd(number: int) -> bool:\n    \"\"\"\n    Determines if an integer is odd using a bitwise check.\n    This is a helper function used internally.\n    \"\"\"\n    return (number & 1) == 1\n\ndef find_Odd_Pair(input_list: list[int], list_size: int) -> int:\n    \"\"\"\n    Counts the total number of unique pairs in a list whose bitwise XOR value is odd.\n    It iterates through all unique pairs and checks their parity using a helper function.\n    \"\"\"\n    odd_pair_count = 0\n    for i in range(list_size):\n        for j in range(i + 1, list_size):\n            num1 = input_list[i]\n            num2 = input_list[j]\n\n            is_num1_odd = _is_odd(num1)\n            is_num2_odd = _is_odd(num2)\n\n            # The bitwise XOR of two integers is odd if and only if one is even and the other is odd.\n            # This is equivalent to (is_num1_odd XOR is_num2_odd).\n            if is_num1_odd != is_num2_odd:\n                odd_pair_count += 1\n    return odd_pair_count\n```\n"}
{"task_id": "Mbpp/558", "solution": "```python\ndef digit_distance_nums(num1: int, num2: int) -> int:\n    \"\"\"\n    Calculates the sum of absolute per-digit differences between two integers.\n    The shorter number is implicitly padded with leading zeros for comparison.\n    \"\"\"\n    str_num1 = str(num1)\n    str_num2 = str(num2)\n\n    max_len = max(len(str_num1), len(str_num2))\n\n    # Pad shorter string with leading zeros\n    padded_str_num1 = str_num1.zfill(max_len)\n    padded_str_num2 = str_num2.zfill(max_len)\n\n    total_diff = 0\n    for i in range(max_len):\n        digit1 = int(padded_str_num1[i])\n        digit2 = int(padded_str_num2[i])\n        total_diff += abs(digit1 - digit2)\n\n    return total_diff\n```"}
{"task_id": "Mbpp/557", "solution": "```python\ndef toggle_string(input_string: str) -> str:\n    \"\"\"Toggles the case of alphabetic characters in a string, preserving non-alphabetic ones.\n    Uppercase letters become lowercase, and lowercase letters become uppercase.\"\"\"\n\n    modified_chars = []\n    for char in input_string:\n        if char.isalpha():\n            if char.isupper():\n                modified_chars.append(char.lower())\n            else:  # char.islower()\n                modified_chars.append(char.upper())\n        else:\n            modified_chars.append(char)\n\n    return \"\".join(modified_chars)\n```\n"}
{"task_id": "Mbpp/558", "solution": "```python\ndef digit_distance_nums(num1: int, num2: int) -> int:\n    \"\"\"Calculates the sum of per-digit absolute differences between two integers.\n    Shorter numbers are implicitly padded with leading zeros.\"\"\"\n    s_num1 = str(num1)\n    s_num2 = str(num2)\n\n    max_len = max(len(s_num1), len(s_num2))\n\n    # Pad shorter string with leading zeros to match length\n    s_num1 = s_num1.zfill(max_len)\n    s_num2 = s_num2.zfill(max_len)\n\n    total_sum = 0\n    for i in range(max_len):\n        digit1 = int(s_num1[i])\n        digit2 = int(s_num2[i])\n        total_sum += abs(digit1 - digit2)\n\n    return total_sum\n```"}
{"task_id": "Mbpp/559", "solution": "```python\nimport math\nfrom typing import List\n\ndef max_sub_array_sum(numbers: List[float], length: int) -> float:\n    \"\"\"\n    Calculates the maximum sum of any contiguous sublist within the input list.\n    Handles empty lists, all-negative lists, and general cases using Kadane's algorithm logic.\n    \"\"\"\n    if length == 0:\n        return 0.0\n\n    # Check if all numbers are negative, and find the largest single negative if so.\n    all_negative = True\n    max_single_negative = -math.inf\n    for num in numbers:\n        if num >= 0:\n            all_negative = False\n            break\n        if num > max_single_negative:\n            max_single_negative = num\n\n    if all_negative:\n        return max_single_negative\n\n    # Apply Kadane's algorithm for general cases (at least one non-negative number exists).\n    max_so_far = -math.inf\n    current_max = 0.0\n\n    for num in numbers:\n        current_max = current_max + num\n        if current_max < 0:\n            current_max = 0.0\n        if current_max > max_so_far:\n            max_so_far = current_max\n\n    return max_so_far\n```"}
{"task_id": "Mbpp/560", "solution": "```python\ndef union_elements(tuple1, tuple2):\n    \"\"\"Calculates the union of elements from two tuples and returns them sorted.\n    This function leverages sets for efficient union and lists for sorting.\n    \"\"\"\n    # Convert input tuples to sets to handle unique elements efficiently.\n    set1 = set(tuple1)\n    set2 = set(tuple2)\n\n    # Perform the union operation on the two sets.\n    unique_elements_set = set1 | set2\n\n    # Convert the resulting set to a list for sorting.\n    unique_elements_list = list(unique_elements_set)\n\n    # Sort the list of unique elements in ascending order.\n    sorted_elements_list = sorted(unique_elements_list)\n\n    # Convert the sorted list back into a tuple for the final output.\n    result_tuple = tuple(sorted_elements_list)\n\n    return result_tuple\n```"}
{"task_id": "Mbpp/559", "solution": "```python\ndef max_sub_array_sum(arr: list[int], n: int) -> int:\n    \"\"\"\n    Finds the sum of the largest contiguous sublist in the given list.\n\n    Args:\n        arr: The input list of integers.\n        n: The length of the input list (ignored in Python, but kept for signature).\n\n    Returns:\n        The maximum sum of a contiguous sublist.\n    \"\"\"\n    if not arr:\n        return 0\n\n    max_so_far = arr[0]\n    current_max = arr[0]\n\n    for i in range(1, len(arr)):\n        current_max = max(arr[i], current_max + arr[i])\n        max_so_far = max(max_so_far, current_max)\n\n    return max_so_far\n```"}
