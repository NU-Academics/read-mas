{"task_id": "Mbpp/245", "solution": "def _calculate_msis_sums(arr: list[int]) -> list[int]:\n    \"\"\"Calculates maximum sum increasing subsequence ending at each position.\"\"\"\n    n = len(arr)\n    msis_sums = list(arr)\n\n    for i in range(1, n):\n        for j in range(i):\n            if arr[i] > arr[j]:\n                msis_sums[i] = max(msis_sums[i], msis_sums[j] + arr[i])\n    return msis_sums\n\ndef _calculate_msds_sums(arr: list[int]) -> list[int]:\n    \"\"\"Calculates maximum sum decreasing subsequence starting at each position.\"\"\"\n    n = len(arr)\n    msds_sums = list(arr)\n\n    for i in range(n - 2, -1, -1):\n        for j in range(n - 1, i, -1):\n            if arr[i] > arr[j]:\n                msds_sums[i] = max(msds_sums[i], msds_sums[j] + arr[i])\n    return msds_sums\n\ndef max_sum(arr: list[int]) -> int:\n    \"\"\"Finds the maximum sum of a bitonic subsequence within the input array.\"\"\"\n    n = len(arr)\n    if n < 2:\n        return 0\n\n    msis_sums = _calculate_msis_sums(arr)\n    msds_sums = _calculate_msds_sums(arr)\n\n    max_bitonic_sum = 0\n    for i in range(n):\n        current_bitonic_sum = msis_sums[i] + msds_sums[i] - arr[i]\n        max_bitonic_sum = max(max_bitonic_sum, current_bitonic_sum)\n\n    return max_bitonic_sum"}
