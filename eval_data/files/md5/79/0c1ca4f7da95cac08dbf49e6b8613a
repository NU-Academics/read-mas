{"task_id": "Mbpp/68", "solution": "def _is_non_decreasing(array):\n    \"\"\"Checks if the array is monotonically non-decreasing.\n    It returns False if any element is greater than the next one.\"\"\"\n    for i in range(len(array) - 1):\n        if array[i] > array[i+1]:\n            return False\n    return True\n\ndef _is_non_increasing(array):\n    \"\"\"Checks if the array is monotonically non-increasing.\n    It returns False if any element is less than the next one.\"\"\"\n    for i in range(len(array) - 1):\n        if array[i] < array[i+1]:\n            return False\n    return True\n\ndef is_Monotonic(array):\n    \"\"\"Determines if the given array is monotonic.\n    An array is monotonic if it is either non-decreasing or non-increasing.\"\"\"\n    return _is_non_decreasing(array) or _is_non_increasing(array)"}
{"task_id": "Mbpp/67", "solution": "```python\ndef bell_number(n: int) -> int:\n    \"\"\"Calculates the Bell number B(n) for a non-negative integer n.\n    It uses dynamic programming to compute Stirling numbers of the second kind as an intermediate step.\n    \"\"\"\n    if n == 0:\n        return 1\n\n    stirling_numbers = [[0] * (n + 1) for _ in range(n + 1)]\n    stirling_numbers[0][0] = 1\n\n    for i in range(1, n + 1):\n        stirling_numbers[i][0] = 0\n        stirling_numbers[i][1] = 1\n        stirling_numbers[i][i] = 1\n        for j in range(2, i):\n            stirling_numbers[i][j] = stirling_numbers[i-1][j-1] + j * stirling_numbers[i-1][j]\n\n    bell_n = 0\n    for k in range(n + 1):\n        bell_n += stirling_numbers[n][k]\n\n    return bell_n\n```\n"}
{"task_id": "Mbpp/69", "solution": "```python\ndef is_sublist(main_list: list, sub_list: list) -> bool:\n    \"\"\"Checks if a sub_list exists as a contiguous sequence within a main_list.\"\"\"\n    if not sub_list:\n        return True\n    if len(main_list) < len(sub_list):\n        return False\n\n    for i in range(len(main_list) - len(sub_list) + 1):\n        if main_list[i:i + len(sub_list)] == sub_list:\n            return True\n    return False\n```"}
{"task_id": "Mbpp/61", "solution": "```python\ndef _calculate_sum_of_digits(substring_value: str) -> int:\n    \"\"\"Calculates the sum of digits in a given string.\n    Each character is converted to an integer and added to the total sum.\"\"\"\n    total_sum = 0\n    for char_digit in substring_value:\n        total_sum += int(char_digit)\n    return total_sum\n\ndef count_Substrings(s: str) -> int:\n    \"\"\"Counts substrings where the sum of digits equals the substring's length.\n    It iterates through all substrings and uses a helper to sum digits.\"\"\"\n    count = 0\n    n = len(s)\n    for i in range(n):\n        for j in range(i, n):\n            substring = s[i:j+1]\n            length = len(substring)\n            sum_digits = _calculate_sum_of_digits(substring)\n            if sum_digits == length:\n                count += 1\n    return count\n```"}
{"task_id": "Mbpp/69", "solution": "def is_sublist(mainlist, sublist):\n    # If sublist is empty, it's always considered a sublist.\n    if not sublist:\n        return True\n\n    # If mainlist is empty and sublist is not, it cannot be a sublist.\n    if not mainlist:\n        return False\n\n    len_main = len(mainlist)\n    len_sub = len(sublist)\n\n    # Optimization: If sublist is longer than mainlist, it cannot be found.\n    if len_sub > len_main:\n        return False\n\n    # Iterate through mainlist using a sliding window to find a match.\n    for i in range(len_main - len_sub + 1):\n        if mainlist[i : i + len_sub] == sublist:\n            return True\n\n    # No match found after checking all possible positions.\n    return False"}
