{"task_id": "Mbpp/751", "solution": "```python\ndef check_min_heap(array: list[int]) -> bool:\n    \"\"\"\n    Validates if the given array represents a min heap.\n    It checks if every non-leaf node's value is less than or equal to its children's values.\n    \"\"\"\n    n = len(array)\n\n    if n <= 1:\n        return True\n\n    # Iterate through non-leaf nodes. The last non-leaf node is at index (n // 2) - 1.\n    for i in range(n // 2):\n        left_child_index = 2 * i + 1\n        right_child_index = 2 * i + 2\n\n        # Check if the left child exists and violates the min heap property.\n        if left_child_index < n:\n            if array[i] > array[left_child_index]:\n                return False\n\n        # Check if the right child exists and violates the min heap property.\n        if right_child_index < n:\n            if array[i] > array[right_child_index]:\n                return False\n\n    return True\n```\n"}
{"task_id": "Mbpp/730", "solution": "```python\ndef consecutive_duplicates(input_list: list) -> list:\n    \"\"\"Removes consecutive duplicate elements from a list, preserving order.\n    Handles empty lists and lists with no duplicates correctly.\"\"\"\n    result_list = []\n\n    # Handle the edge case of an empty input list.\n    if not input_list:\n        return result_list\n\n    # Add the first element, as it has no preceding element to be a duplicate of.\n    result_list.append(input_list[0])\n\n    # Iterate from the second element, comparing each with the last element added to the result list.\n    for i in range(1, len(input_list)):\n        current_element = input_list[i]\n        # If the current element is not a consecutive duplicate, add it to the result list.\n        if current_element != result_list[-1]:\n            result_list.append(current_element)\n\n    return result_list\n```"}
{"task_id": "Mbpp/751", "solution": "```python\ndef check_min_heap(arr: list[float | int]) -> bool:\n    \"\"\"\n    Checks if the given array represents a min-heap.\n    A min-heap's parent node value is less than or equal to its children's values.\n    \"\"\"\n    if len(arr) <= 1:\n        return True\n\n    n = len(arr)\n    for i in range(n // 2):  # Iterate up to the last parent node.\n        left_child_idx = 2 * i + 1\n        right_child_idx = 2 * i + 2\n\n        if left_child_idx < n and arr[i] > arr[left_child_idx]:\n            return False  # Parent is greater than left child.\n\n        if right_child_idx < n and arr[i] > arr[right_child_idx]:\n            return False  # Parent is greater than right child.\n    return True\n```"}
{"task_id": "Mbpp/752", "solution": "```python\ndef jacobsthal_num(n: int) -> int:\n    \"\"\"\n    Calculates the nth Jacobsthal number using its recurrence relation.\n    Handles base cases for n=0 and n=1 directly.\n    \"\"\"\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n\n    # For n > 1, use J(n) = J(n-1) + 2 * J(n-2)\n    # Initialize with J(0) and J(1)\n    j_n_minus_2 = 0  # Represents J(i-2)\n    j_n_minus_1 = 1  # Represents J(i-1)\n\n    for _ in range(2, n + 1):\n        current_jacobsthal = j_n_minus_1 + 2 * j_n_minus_2\n        j_n_minus_2 = j_n_minus_1\n        j_n_minus_1 = current_jacobsthal\n\n    return j_n_minus_1\n```"}
