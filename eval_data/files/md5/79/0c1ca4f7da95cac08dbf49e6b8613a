{"task_id": "Mbpp/103", "solution": "import math\n\ndef _binomial_coefficient(n: int, k: int) -> int:\n    \"\"\"Calculates the binomial coefficient C(n, k).\"\"\"\n    if k < 0 or k > n:\n        return 0\n    if k == 0 or k == n:\n        return 1\n    if k > n // 2:\n        k = n - k\n\n    res = 1\n    for i in range(k):\n        res = res * (n - i) // (i + 1)\n    return res\n\ndef _power(base: int, exp: int) -> int:\n    \"\"\"Calculates base raised to the power of exp.\"\"\"\n    if exp < 0:\n        raise ValueError(\"Exponent cannot be negative for integer power calculation.\")\n    return base ** exp\n\ndef eulerian_num(n: int, m: int) -> int:\n    \"\"\"\n    Calculates the Eulerian number A(n, m).\n    Raises ValueError for non-integer or negative inputs.\n    \"\"\"\n    if not isinstance(n, int) or not isinstance(m, int):\n        raise ValueError(\"Inputs n and m must be integers.\")\n\n    if n < 0 or m < 0:\n        raise ValueError(\"Inputs n and m must be non-negative.\")\n\n    if m >= n:\n        return 0\n\n    if m == 0:\n        return 1\n\n    eulerian_sum = 0\n    for k in range(m + 1):\n        term = _binomial_coefficient(n + 1, k) * _power(m + 1 - k, n)\n        if k % 2 == 1:\n            eulerian_sum -= term\n        else:\n            eulerian_sum += term\n\n    return eulerian_sum"}
