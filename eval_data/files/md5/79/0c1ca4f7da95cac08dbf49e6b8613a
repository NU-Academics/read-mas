{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(decimal_number: int) -> str:\n    \"\"\"Converts a decimal number to its binary equivalent string.\n    The output has no leading zeros, except for input 0 which returns '0'.\n    \"\"\"\n    if decimal_number == 0:\n        return '0'\n\n    binary_string = []\n    temp_number = decimal_number\n\n    while temp_number > 0:\n        remainder = temp_number % 2\n        binary_string.append(str(remainder))\n        temp_number //= 2\n\n    return \"\".join(binary_string[::-1])"}
{"task_id": "Mbpp/99", "solution": "def decimal_to_binary(decimal_number: int) -> str:\n    \"\"\"Converts a decimal integer to its binary string equivalent.\n    Ensures no leading zeros, except for the input 0 which returns '0'.\n    \"\"\"\n    if decimal_number == 0:\n        return '0'\n\n    binary_digits = []\n    current_number = decimal_number\n    while current_number > 0:\n        remainder = current_number % 2\n        binary_digits.append(str(remainder))\n        current_number //= 2\n\n    return \"\".join(binary_digits[::-1])"}
