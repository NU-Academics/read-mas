{"task_id": "Mbpp/721", "solution": "class Cell:\n    \"\"\"Represents an individual cell within the matrix.\"\"\"\n    def __init__(self, row: int, col: int, cost: float):\n        self.row = row\n        self.col = col\n        self.cost = cost\n\nclass Matrix:\n    \"\"\"Represents the input square matrix.\"\"\"\n    def __init__(self, matrix_data: list[list]):\n        self.N = len(matrix_data)\n        self.cells: list[list[Cell]] = []\n        for r in range(self.N):\n            row_cells = []\n            for c in range(self.N):\n                row_cells.append(Cell(r, c, float(matrix_data[r][c])))\n            self.cells.append(row_cells)\n\n    def get_cell(self, row: int, col: int) -> Cell:\n        \"\"\"Retrieves a cell at the given coordinates.\"\"\"\n        return self.cells[row][col]\n\n    def is_valid_coordinate(self, row: int, col: int) -> bool:\n        \"\"\"Checks if the given coordinates are within matrix bounds.\"\"\"\n        return 0 <= row < self.N and 0 <= col < self.N\n\nclass Path:\n    \"\"\"Represents a single valid path found in the matrix.\"\"\"\n    def __init__(self, sequence: list[Cell]):\n        self.sequence = sequence\n        self.total_cost = sum(cell.cost for cell in sequence)\n        self.number_of_cells = len(sequence)\n        self.average_cost = self.total_cost / self.number_of_cells\n\n    def get_average_cost(self) -> float:\n        \"\"\"Returns the average cost of the path.\"\"\"\n        return self.average_cost\n\nclass PathFinderService:\n    \"\"\"Implements core logic for finding paths and calculating maximum average.\"\"\"\n    def find_max_average_path(self, matrix: Matrix) -> float:\n        \"\"\"Finds all valid paths and returns the maximum average cost.\"\"\"\n        all_paths: list[Path] = []\n        self._find_all_paths_recursive(matrix, 0, 0, [], all_paths)\n\n        max_avg = -1.0\n        for path_obj in all_paths:\n            if path_obj.get_average_cost() > max_avg:\n                max_avg = path_obj.get_average_cost()\n        return max_avg\n\n    def _find_all_paths_recursive(self,\n                                  matrix: Matrix,\n                                  current_row: int,\n                                  current_col: int,\n                                  current_path_cells: list[Cell],\n                                  all_paths: list[Path]):\n        \"\"\"Recursively explores paths from top-left to bottom-right.\"\"\"\n        cell = matrix.get_cell(current_row, current_col)\n        new_path_cells = current_path_cells + [cell]\n\n        if current_row == matrix.N - 1 and current_col == matrix.N - 1:\n            all_paths.append(Path(new_path_cells))\n            return\n\n        if matrix.is_valid_coordinate(current_row, current_col + 1):\n            self._find_all_paths_recursive(matrix, current_row, current_col + 1, new_path_cells, all_paths)\n\n        if matrix.is_valid_coordinate(current_row + 1, current_col):\n            self._find_all_paths_recursive(matrix, current_row + 1, current_col, new_path_cells, all_paths)\n\ndef maxAverageOfPath(matrix_data) -> float:\n    \"\"\"Calculates the maximum average cost among all valid paths in a matrix.\"\"\"\n    matrix_obj = Matrix(matrix_data)\n    path_finder = PathFinderService()\n    return path_finder.find_max_average_path(matrix_obj)"}
