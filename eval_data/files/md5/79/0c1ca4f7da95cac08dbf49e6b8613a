{"task_id": "Mbpp/311", "solution": "```python\ndef set_left_most_unset_bit(n: int) -> int:\n    \"\"\"\n    Sets the leftmost unset bit in the binary representation of n.\n    If n has no unset bits, it sets the next bit to the left.\n    \"\"\"\n    msb_pos = n.bit_length() - 1\n\n    for i in range(msb_pos, -1, -1):\n        if not (n & (1 << i)):  # Check if the i-th bit is unset.\n            return n | (1 << i)  # Set this bit and return.\n\n    return n | (1 << (msb_pos + 1))  # No unset bit found; set the next bit to the left.\n```"}
{"task_id": "Mbpp/286", "solution": "def max_sub_array_sum_repeated(arr: list[int], k: int) -> int:\n    \"\"\"\n    Calculates the maximum contiguous subarray sum in a conceptual array formed by\n    repeating `arr` `k` times.\n    \"\"\"\n\n    def kadane(arr_input: list[int]) -> int:\n        \"\"\"\n        Calculates the maximum contiguous subarray sum using Kadane's algorithm.\n        Correctly handles arrays with all negative numbers, returning the largest single element.\n        \"\"\"\n        current_max = 0\n        global_max = float('-inf')\n\n        for element in arr_input:\n            current_max = max(element, current_max + element)\n            global_max = max(global_max, current_max)\n\n        return global_max\n\n    def max_prefix_sum(arr_input: list[int]) -> int:\n        \"\"\"\n        Calculates the maximum prefix sum of the given array.\n        Initializes max_pref to negative infinity to handle arrays with all negative numbers.\n        \"\"\"\n        current_sum = 0\n        max_pref = float('-inf')\n\n        for element in arr_input:\n            current_sum += element\n            max_pref = max(max_pref, current_sum)\n        return max_pref\n\n    def max_suffix_sum(arr_input: list[int]) -> int:\n        \"\"\"\n        Calculates the maximum suffix sum of the given array.\n        Initializes max_suff to negative infinity and iterates in reverse.\n        \"\"\"\n        current_sum = 0\n        max_suff = float('-inf')\n\n        for element in reversed(arr_input):\n            current_sum += element\n            max_suff = max(max_suff, current_sum)\n        return max_suff\n\n    # Handle the specific case of an empty input array first.\n    if not arr:\n        return 0\n\n    # Handle k = 1 as a special case.\n    if k == 1:\n        return kadane(arr)\n\n    # For k > 1, consider sums within two array blocks or spanning multiple blocks.\n    max_sum_double_arr = kadane(arr + arr)\n    total_sum_arr = sum(arr)\n\n    if total_sum_arr > 0:\n        # If total sum is positive, repeating the middle part can increase the max sum.\n        pref_sum = max_prefix_sum(arr)\n        suff_sum = max_suffix_sum(arr)\n        sum_across_middle = suff_sum + (k - 2) * total_sum_arr + pref_sum\n        return max(max_sum_double_arr, sum_across_middle)\n    else:\n        # If total sum is non-positive, additional repetitions won't improve the sum beyond two blocks.\n        return max_sum_double_arr"}
