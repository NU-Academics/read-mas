{"task_id": "Mbpp/71", "solution": "```python\ndef comb_sort(input_list):\n    \"\"\"\n    Sorts a list of elements using the Comb Sort algorithm.\n    Returns a new list with elements in ascending order.\n    \"\"\"\n    arr = list(input_list)\n    n = len(arr)\n    gap = n\n    shrink_factor = 1.3\n    swapped = True\n\n    while gap > 1 or swapped:\n        gap = max(1, int(gap / shrink_factor))\n        swapped = False\n\n        for i in range(n - gap):\n            if arr[i] > arr[i + gap]:\n                arr[i], arr[i + gap] = arr[i + gap], arr[i]\n                swapped = True\n    return arr\n```"}
{"task_id": "Mbpp/70", "solution": "def get_equal(list_of_tuples: list[tuple]) -> bool:\n    \"\"\"\n    Checks if all tuples within a list of tuples have the same length.\n    Returns True for empty lists or lists with a single tuple.\n    \"\"\"\n    if not list_of_tuples:\n        return True\n\n    if len(list_of_tuples) == 1:\n        return True\n\n    first_tuple_length = len(list_of_tuples[0])\n\n    for i in range(1, len(list_of_tuples)):\n        if len(list_of_tuples[i]) != first_tuple_length:\n            return False\n\n    return True"}
{"task_id": "Mbpp/70", "solution": "```python\ndef get_equal(list_of_tuples):\n    \"\"\"\n    Determines if all tuples in the input list have the same length.\n    Returns True if all tuple lengths are equal, False otherwise.\n    \"\"\"\n    if not list_of_tuples:\n        return True\n\n    # Use the length of the first tuple as the reference for comparison.\n    reference_length = len(list_of_tuples[0])\n\n    # Compare the length of each subsequent tuple to the reference length.\n    for current_tuple in list_of_tuples[1:]:\n        if len(current_tuple) != reference_length:\n            return False\n\n    return True\n```"}
{"task_id": "Mbpp/71", "solution": "```python\ndef comb_sort(numbers: list) -> list:\n    \"\"\"\n    Sorts a list of numbers using the comb sort algorithm.\n    Modifies the input list in-place and returns it.\n    \"\"\"\n    n = len(numbers)\n    gap = n\n    shrink_factor = 1.3\n    sorted_flag = False\n\n    while not sorted_flag or gap != 1:\n        gap = int(gap / shrink_factor)\n        if gap < 1:\n            gap = 1\n\n        sorted_flag = True\n        for i in range(n - gap):\n            if numbers[i] > numbers[i + gap]:\n                numbers[i], numbers[i + gap] = numbers[i + gap], numbers[i]\n                sorted_flag = False\n    return numbers\n```"}
{"task_id": "Mbpp/74", "solution": "```python\ndef is_samepatterns(strings: list[str], patterns: list[str]) -> bool:\n    \"\"\"\n    Checks if a list of strings follows a given pattern sequence.\n    Establishes and validates a consistent one-to-one mapping between elements.\n    \"\"\"\n    if len(strings) != len(patterns):\n        return False\n\n    string_to_pattern_map = {}\n    pattern_to_string_map = {}\n\n    for i in range(len(strings)):\n        current_string = strings[i]\n        current_pattern = patterns[i]\n\n        # Validate and update string_to_pattern mapping\n        if current_string in string_to_pattern_map:\n            if string_to_pattern_map[current_string] != current_pattern:\n                return False\n        else:\n            string_to_pattern_map[current_string] = current_pattern\n\n        # Validate and update pattern_to_string mapping\n        if current_pattern in pattern_to_string_map:\n            if pattern_to_string_map[current_pattern] != current_string:\n                return False\n        else:\n            pattern_to_string_map[current_pattern] = current_string\n\n    return True\n```"}
{"task_id": "Mbpp/74", "solution": "```python\ndef is_samepatterns(arr: list, patterns: list) -> bool:\n    \"\"\"\n    Checks if a list of elements follows the structural pattern defined by a list of characters.\n    Maintains consistent bidirectional mappings between elements and characters.\n    \"\"\"\n    if len(arr) != len(patterns):\n        return False\n\n    arr_to_patterns_map = {}\n    patterns_to_arr_map = {}\n\n    for element, char in zip(arr, patterns):\n        # Check mapping from arr to patterns\n        if element in arr_to_patterns_map:\n            if arr_to_patterns_map[element] != char:\n                return False\n        else:\n            arr_to_patterns_map[element] = char\n\n        # Check mapping from patterns to arr\n        if char in patterns_to_arr_map:\n            if patterns_to_arr_map[char] != element:\n                return False\n        else:\n            patterns_to_arr_map[char] = element\n\n    return True\n```"}
{"task_id": "Mbpp/72", "solution": "```python\ndef dif_Square(n: int) -> bool:\n    \"\"\"Checks if n can be represented as the difference of two squares (a^2 - b^2).\n    This is true for all integers except those of the form 4k + 2.\"\"\"\n    if n == 0:\n        return True\n\n    # For negative n, it can be represented as a^2 - b^2 if and only if |n|\n    # can be represented as b^2 - a^2. Thus, we can check abs(n).\n    val = abs(n)\n\n    # An integer can be represented as a^2 - b^2 if and only if it is\n    # odd, or a multiple of 4. Numbers of the form 4k + 2 cannot.\n    return val % 4 != 2\n```"}
{"task_id": "Mbpp/77", "solution": "```python\ndef is_Diff(number: int) -> bool:\n    \"\"\"\n    Checks if a number is divisible by 11 using the alternating sum of digits rule.\n    The rule states a number is divisible by 11 if its alternating sum of digits is divisible by 11.\n    \"\"\"\n    num_str = str(abs(number))\n    alternating_sum = 0\n    sign = 1\n    for digit_char in reversed(num_str):\n        digit = int(digit_char)\n        alternating_sum += digit * sign\n        sign *= -1\n    return alternating_sum % 11 == 0\n```"}
