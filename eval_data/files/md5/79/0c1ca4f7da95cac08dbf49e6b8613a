{"task_id": "Mbpp/733", "solution": "```python\ndef find_first_occurrence(array, target):\n    \"\"\"\n    Finds the 0-based index of the first occurrence of a target number in a sorted array.\n    Returns -1 if the target is not found.\n    \"\"\"\n    low = 0\n    high = len(array) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n        if array[mid] == target:\n            result = mid  # Store this potential first occurrence\n            high = mid - 1  # Continue searching in the left half for an even earlier occurrence\n        elif array[mid] < target:\n            low = mid + 1\n        else:  # array[mid] > target\n            high = mid - 1\n    return result\n```\n"}
{"task_id": "Mbpp/733", "solution": "```python\nfrom typing import List\n\ndef find_first_occurrence(arr: List[int], target: int) -> int:\n    \"\"\"Finds the index of the first occurrence of a target number in a sorted array.\n    Returns -1 if the target is not found.\n    \"\"\"\n    low = 0\n    high = len(arr) - 1\n    result = -1\n\n    while low <= high:\n        mid = low + (high - low) // 2\n\n        if arr[mid] == target:\n            result = mid  # Target found, store its index\n            high = mid - 1  # Continue searching in the left half for the first occurrence\n        elif arr[mid] < target:\n            low = mid + 1  # Target must be in the right half\n        else: # arr[mid] > target\n            high = mid - 1  # Target must be in the left half\n\n    return result\n```"}
{"task_id": "Mbpp/734", "solution": "```python\ndef sum_Of_Subarray_Prod(numbers: list) -> (int | float):\n    \"\"\"Calculates the sum of products of all possible contiguous sublists from a given list.\n    It iterates through all sublists, computes their product, and sums them up.\n    \"\"\"\n    total_sum_of_products = 0\n    n = len(numbers)\n\n    for i in range(n):  # Iterate through all possible start indices\n        current_product = 1\n        for j in range(i, n):  # Iterate through all possible end indices from the current start\n            current_product *= numbers[j]\n            total_sum_of_products += current_product\n\n    return total_sum_of_products\n```"}
{"task_id": "Mbpp/735", "solution": "```python\ndef toggle_middle_bits(n: int) -> int:\n    \"\"\"Toggles bits of the number n except the first and the last bit.\n    For numbers with fewer than 3 bits, no bits are toggled as there are no 'middle' bits.\n    \"\"\"\n    length = n.bit_length()\n\n    if length < 3:\n        # If there are fewer than 3 bits, there are no \"middle\" bits to toggle.\n        return n\n\n    # Create a mask with 1s for bits from position 1 to length-2 (inclusive).\n    # (1 << (length - 1)) - 1 creates a mask of (length-1) ones; then & ~1 clears the 0th bit.\n    middle_mask = ((1 << (length - 1)) - 1) & ~1\n\n    # XOR the number with the middle_mask to toggle only the specified bits.\n    return n ^ middle_mask\n```"}
{"task_id": "Mbpp/735", "solution": "```python\ndef toggle_middle_bits(number):\n    \"\"\"Toggles bits of the number except the first and the last bit.\n    Handles cases where there are two or fewer bits by not toggling any.\n    \"\"\"\n    n_bits = number.bit_length()\n\n    if n_bits <= 2:\n        # If 2 or fewer bits, there are no \"middle\" bits to toggle.\n        mask = 0\n    else:\n        # Create a mask with n_bits-2 ones, shifted by 1 to skip the LSB.\n        mask = ((1 << (n_bits - 2)) - 1) << 1\n\n    return number ^ mask\n```"}
{"task_id": "Mbpp/736", "solution": "```python\ndef left_insertion(arr: list[int], x: int) -> int:\n    \"\"\"\n    Calculates the leftmost insertion index for value x in a sorted list arr.\n    This function uses a binary search algorithm to find the correct insertion point in O(log n) time.\n    \"\"\"\n    low = 0\n    high = len(arr)\n\n    while low < high:\n        mid = (low + high) // 2\n        if arr[mid] < x:\n            low = mid + 1\n        else:\n            high = mid\n    return low\n```"}
