{"task_id": "Mbpp/603", "solution": "def _sieve(numbers: list[int], n: int) -> list[int]:\n    \"\"\"\n    Removes every n-th element from the list, resetting count after each removal.\n    If n is 1, the list is returned unchanged (a copy).\n    \"\"\"\n    if n == 1:\n        return list(numbers)\n\n    new_numbers = []\n    count = 0\n    for number in numbers:\n        count += 1\n        if count % n != 0:\n            new_numbers.append(number)\n        else:\n            count = 0\n    return new_numbers\n\ndef get_ludic(max_value: int) -> list[int]:\n    \"\"\"\n    Computes and returns a list of lucid numbers up to max_value using a sieve-like process.\n    \"\"\"\n    numbers = list(range(1, max_value + 1))\n    lucid_numbers = []\n\n    while numbers:\n        current_lucid = numbers[0]\n        lucid_numbers.append(current_lucid)\n        numbers.pop(0)\n\n        numbers = _sieve(numbers, current_lucid)\n\n    return lucid_numbers"}
{"task_id": "Mbpp/603", "solution": "```python\ndef get_ludic(n: int) -> list[int]:\n    \"\"\"\n    Calculates Ludic numbers up to n using a sieving process.\n    Returns a list of integers representing the Ludic numbers up to n.\n    \"\"\"\n    numbers = list(range(1, n + 1))\n    ludic_numbers = []\n\n    while numbers and numbers[0] <= n:\n        l = numbers.pop(0)\n        ludic_numbers.append(l)\n\n        if l == 1:\n            continue\n\n        next_numbers = []\n        count = 0\n        for number in numbers:\n            count += 1\n            if count % l != 0:\n                next_numbers.append(number)\n        numbers = next_numbers\n\n    return ludic_numbers\n```"}
{"task_id": "Mbpp/598", "solution": "```python\ndef armstrong_number(number: int) -> bool:\n    \"\"\"\n    Checks if an integer is an Armstrong number.\n    An n-digit number is Armstrong if it equals the sum of the nth powers of its digits.\n    \"\"\"\n\n    def _determine_number_of_digits(n_val: int) -> int:\n        \"\"\"Determines the number of digits in an integer's absolute value.\"\"\"\n        if n_val == 0:\n            return 1\n        return len(str(abs(n_val)))\n\n    def _extract_digits(n_val: int) -> list[int]:\n        \"\"\"Extracts individual digits from an integer's absolute value.\"\"\"\n        s_val = str(abs(n_val))\n        return [int(d) for d in s_val]\n\n    def _calculate_sum_of_powers(digits_list: list[int], power: int) -> int:\n        \"\"\"Calculates the sum of each digit raised to the specified power.\"\"\"\n        total_sum = 0\n        for digit in digits_list:\n            total_sum += digit ** power\n        return total_sum\n\n    original_value = number\n    abs_value = abs(number)\n\n    num_digits = _determine_number_of_digits(abs_value)\n    digits = _extract_digits(abs_value)\n\n    calculated_sum = _calculate_sum_of_powers(digits, num_digits)\n\n    return calculated_sum == original_value\n```\n"}
